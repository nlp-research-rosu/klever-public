# K build output (generated by kompile)
*-kompiled/
semantics/humaneval-python-llvm/
semantics/humaneval-python-haskell/
*.actual
*.kore
kore-exec.tar.gz
.kompile-*
.krun-*
.kprove-*

# Python bytecode
__pycache__/
*.pyc
venv/

# test harness scratch dir (temp .mpy files for Docker-visible krun)
_test_scratch/

# pytest
.pytest_cache/

# Python venv (if created locally for running pytest)
.venv/

# machine-local: Claude worktrees + ephemeral run output
.claude/worktrees/

# verigen per-problem run workspaces (curated artifacts committed explicitly)
verigen/runs/

# HumanEval per-problem folders generated by scripts/dissect_humaneval.py
# (reproducible from data/humaneval/HumanEval.jsonl; regenerate, don't commit)
first-pass/data/humaneval/problems/

# regenerable problem inventory (scripts/populate_verification.py)
first-pass/data/humaneval/inventory.json

# human-only kill switch for autonomous/overnight agent loops (agent reads, never writes)
.agent-continue

# credential blocks — a sync must never re-add these (July-24 purge lesson)
**/secrets/
**/auth.json
**/auth.*.json
**/.credentials.json
**/api_key.json
**/codex-home/
runner-state/
