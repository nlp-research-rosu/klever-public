# Copy to .env and edit as needed:  cp .env.example .env
# (run_task.sh / run_matrix.sh set MODEL from the config name, so these mostly
# matter for direct `docker compose run` invocations.)
MODEL=gpt-5.6-sol     # codex model id (host-verified default)
EFFORT=xhigh          # model_reasoning_effort: low | medium | high | xhigh
TIMEOUT_S=3600        # per-task wall-clock limit (seconds)
