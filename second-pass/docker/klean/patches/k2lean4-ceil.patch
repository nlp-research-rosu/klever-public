+def _opt_symbol_ident(symbol: str) -> str:
+    r"""Name the Option-valued counterpart of a partial function symbol.
+
+    Used by the ``\ceil`` translation: ``f?`` (guillemet-quoted when the base
+    identifier requires quoting) denotes ``f`` rendered with return type
+    ``Option S`` instead of ``S``.
+    """
+    if symbol in _SYMBOL_OVERRIDES:
+        ident = _SYMBOL_OVERRIDES[symbol] + '?'
+    else:
+        if symbol.startswith('Lbl'):
+            symbol = symbol[3:]
+        ident = unmunge(symbol) + '?'
+    if not _VALID_LEAN_IDENT.fullmatch(ident):
+        ident = f'«{ident}»'
+    return ident
+
