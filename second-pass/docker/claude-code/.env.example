# Copy to .env and edit as needed:  cp .env.example .env
# (run_task.sh / run_matrix.sh set MODEL and EFFORT from the config name, so
# these mostly matter for direct `docker compose run` invocations.)
MODEL=opus            # opus (=4.8), fable (=5), or a full id like claude-opus-4-8 / claude-fable-5
EFFORT=xhigh          # low | medium | high | xhigh | max
OUTPUT_FORMAT=json    # text | json | stream-json (json records cost/usage)
TIMEOUT_S=3600        # per-task wall-clock limit (seconds)

# Only needed for API-key auth (auth option B). Leave unset to use the mounted
# OAuth token (auth option A).
# ANTHROPIC_API_KEY=sk-ant-...
