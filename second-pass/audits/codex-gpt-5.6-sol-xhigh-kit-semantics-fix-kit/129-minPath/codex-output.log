+    n = rng.randint(3, 7)
+    values = list(range(1, n * n + 1))
+    rng.shuffle(values)
+    grid = [values[offset : offset + n] for offset in range(0, n * n, n)]
+    for k in (1, 2, 3, 6, 11):
+        add(f"generated-{sample}-n{n}", grid, k, True, False)
+
