+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+}
+
+run test -d /reference/reference-semantics
+run find /candidate -maxdepth 1 -printf '%y %f -> %l\n'
+run find /reference -maxdepth 1 -printf '%y %f -> %l\n'
+run find /candidate -type l -printf '%p -> %l\n'
