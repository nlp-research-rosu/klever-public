requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Mathematical suffix produced by the final range loop. The equations are
  // total and disjoint: I >= K, or I < K split by parity.
  syntax ValSeq ::= altSuffix(Int, Int, Int) [function, total]
  rule altSuffix(I:Int, K:Int, _M:Int) => .ValSeq
    requires I >=Int K
  rule altSuffix(I:Int, K:Int, M:Int)
    => vCons(1, altSuffix(I +Int 1, K, M))
    requires I <Int K andBool pyMod(I, 2) ==Int 0
  rule altSuffix(I:Int, K:Int, M:Int)
    => vCons(M, altSuffix(I +Int 1, K, M))
    requires I <Int K andBool pyMod(I, 2) =/=Int 0

  // Small-grid mathematical oracle used by the symbolic 2x2 theorem.
  // Cases are ordered as a disjoint, total partition over all Int inputs.
  syntax Int ::= neighbor2(Int, Int, Int, Int) [function, total]
  rule neighbor2(A:Int, B:Int, C:Int, _D:Int) => minInt(B, C)
    requires A ==Int 1
  rule neighbor2(A:Int, B:Int, _C:Int, D:Int) => minInt(A, D)
    requires A =/=Int 1 andBool B ==Int 1
  rule neighbor2(A:Int, B:Int, C:Int, D:Int) => minInt(A, D)
    requires A =/=Int 1 andBool B =/=Int 1 andBool C ==Int 1
  rule neighbor2(A:Int, B:Int, C:Int, _D:Int) => minInt(B, C)
    requires A =/=Int 1 andBool B =/=Int 1 andBool C =/=Int 1

  // Derived algebraic lemma over the reference semantics' ValSeq datatype.
  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
    => valSeqConcat(A, valSeqConcat(B, C))
    [simplification]
  rule valSeqConcat(A:ValSeq, .ValSeq) => A [simplification]

  // Syntactic abbreviation for the exact constructor tree in solution.mpy.
  // This macro expands before execution; all function behavior is handled by MPY.
  syntax Module ::= "MINPATH-PROGRAM" [macro]
  rule MINPATH-PROGRAM
    => Module(
         FuncDef("minPath", Params("grid", "k"),
           Assign(Name("n"), Call(Name("len"), Name("grid")))
           Assign(Name("row"), Int(0))
           Assign(Name("col"), Int(0))
           For(Name("i"), Call(Name("range"), Name("n")),
             For(Name("j"), Call(Name("range"), Name("n")),
               If(Compare(
                    Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
                    CmpOp("==", Int(1))),
                  Assign(Name("row"), Name("i"))
                  Assign(Name("col"), Name("j")),
                  .Stmts)))
           Assign(Name("neighbor"),
             BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
           If(BoolOp("and",
                Compare(Name("row"), CmpOp(">", Int(0))),
                Compare(
                  Subscript(
                    Subscript(Name("grid"), BinOp("-", Name("row"), Int(1))),
                    Name("col")),
                  CmpOp("<", Name("neighbor")))),
              Assign(Name("neighbor"),
                Subscript(
                  Subscript(Name("grid"), BinOp("-", Name("row"), Int(1))),
                  Name("col"))),
              .Stmts)
           If(BoolOp("and",
                Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
                Compare(
                  Subscript(
                    Subscript(Name("grid"), BinOp("+", Name("row"), Int(1))),
                    Name("col")),
                  CmpOp("<", Name("neighbor")))),
              Assign(Name("neighbor"),
                Subscript(
                  Subscript(Name("grid"), BinOp("+", Name("row"), Int(1))),
                  Name("col"))),
              .Stmts)
           If(BoolOp("and",
                Compare(Name("col"), CmpOp(">", Int(0))),
                Compare(
                  Subscript(
                    Subscript(Name("grid"), Name("row")),
                    BinOp("-", Name("col"), Int(1))),
                  CmpOp("<", Name("neighbor")))),
              Assign(Name("neighbor"),
                Subscript(
                  Subscript(Name("grid"), Name("row")),
                  BinOp("-", Name("col"), Int(1)))),
              .Stmts)
           If(BoolOp("and",
                Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
                Compare(
                  Subscript(
                    Subscript(Name("grid"), Name("row")),
                    BinOp("+", Name("col"), Int(1))),
                  CmpOp("<", Name("neighbor")))),
              Assign(Name("neighbor"),
                Subscript(
                  Subscript(Name("grid"), Name("row")),
                  BinOp("+", Name("col"), Int(1)))),
              .Stmts)
           Assign(Name("answer"), ListExpr(.Exprs))
           For(Name("i"), Call(Name("range"), Name("k")),
             If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
               Expr(Call(Attribute(Name("answer"), "append"), Int(1))),
               Expr(Call(Attribute(Name("answer"), "append"), Name("neighbor")))))
           Return(Name("answer"))))
endmodule

