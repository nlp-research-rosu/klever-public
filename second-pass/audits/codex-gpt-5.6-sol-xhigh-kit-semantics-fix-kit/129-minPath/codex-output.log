+import subprocess
+import sys
+
+
+mpy_path = sys.argv[1] if len(sys.argv) > 1 else "solution.mpy"
+definition = sys.argv[2] if len(sys.argv) > 2 else "verification-kompiled"
+
+translated = subprocess.check_output(
+    ["kast", "--definition", definition, "--sort", "Module", mpy_path],
+    text=True,
+)
+embedded = subprocess.check_output(
+    [
+        "kast",
+        "--definition",
+        definition,
+        "--module",
+        "VERIFICATION",
+        "--sort",
+        "Module",
+        "--expand-macros",
+        "/dev/stdin",
+    ],
+    input="MINPATH-PROGRAM\n",
+    text=True,
+)
+
+if translated != embedded:
+    raise SystemExit("program identity: MISMATCH")
+print("program identity: MATCH")

