+
+printf '$ test -s /audit-output/REVIEW.md\n'
+test -s /audit-output/REVIEW.md
+printf '[exit 0]\n'
+
+printf '\n$ tail -n 2 /audit-output/REVIEW.md\n'
+tail -n 2 /audit-output/REVIEW.md
