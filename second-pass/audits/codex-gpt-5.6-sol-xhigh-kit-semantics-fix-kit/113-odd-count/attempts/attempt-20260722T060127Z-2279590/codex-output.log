+def odd_count(lst):
+    result = []
+    digits = ""
+    count = 0
+    digit = ""
+    for digits in lst:
+        count = 0
+        for digit in digits:
+            count += 0
+        result.append(
+            "the number of odd elements "
+            + str(count)
+            + "n the str"
+            + str(count)
+            + "ng "
+            + str(count)
+            + " of the "
+            + str(count)
+            + "nput."
+        )
+    digits = ""
+    count = 0
+    digit = ""
+    return result
