ec.k --definition verification-kompiled --spec-module SPEC\n\nif kprove spec-vacuity.k --definition verification-kompiled \\\n  --spec-module SPEC-VACUITY; then\n  echo \"unexpected success: false postcondition\"\n  exit 1\nelse\n  echo \"EXPECTED FAILURE: false postcondition\"\nfi\n\nkompile --backend haskell mutation-verification.k \\\n  --main-module VERIFICATION-MUTATION --syntax-module MPY-SYNTAX \\\n  --output-definition mutation-verification-kompiled\nif kprove spec-mutation.k --definition mutation-verification-kompiled \\\n  --spec-module SPEC-MUTATION; then\n  echo \"unexpected success: changed implementation body\"\n  exit 1\nelse\n  echo \"EXPECTED FAILURE: changed implementation body\"\nfi\n"}},"status":"completed"}}
