/reference/reference-semantics/semantics/subscript.k-22-  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
/reference/reference-semantics/semantics/subscript.k-23-  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0
/reference/reference-semantics/semantics/subscript.k-24-
/reference/reference-semantics/semantics/subscript.k:25:  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================
/reference/reference-semantics/semantics/subscript.k-26-  // contexts (not strict attrs): the Index slot's Slice alternative must never heat
/reference/reference-semantics/semantics/subscript.k:27:  context Subscript(HOLE, _)
/reference/reference-semantics/semantics/subscript.k:28:  context Subscript(_:Val, HOLE:Expr)
/reference/reference-semantics/semantics/subscript.k-29-
/reference/reference-semantics/semantics/subscript.k-30-  // heap-object deref (covers both the index and slice forms via the Index slot)
/reference/reference-semantics/semantics/subscript.k:31:  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
/reference/reference-semantics/semantics/subscript.k-32-       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/subscript.k-33-       [priority(40)]
/reference/reference-semantics/semantics/subscript.k-34-
/reference/reference-semantics/semantics/subscript.k:35:  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>
/reference/reference-semantics/semantics/subscript.k-36-
/reference/reference-semantics/semantics/subscript.k:37:  syntax Val ::= applyIndex(Val, Int) [function]
/reference/reference-semantics/semantics/subscript.k:38:  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
/reference/reference-semantics/semantics/subscript.k:39:  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
/reference/reference-semantics/semantics/subscript.k:40:  rule applyIndex(str(IS:IntSeq),   I:Int)
/reference/reference-semantics/semantics/subscript.k-41-    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))
/reference/reference-semantics/semantics/subscript.k-42-
/reference/reference-semantics/semantics/subscript.k-43-  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
/reference/reference-semantics/semantics/subscript.k-44-  syntax KItem ::= #evalB(Bound) | "#toSome"
--
/reference/reference-semantics/semantics/subscript.k-50-  rule <k> #evalB(NoBound)  => noB ... </k>
/reference/reference-semantics/semantics/subscript.k-51-  rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>
/reference/reference-semantics/semantics/subscript.k-52-  rule <k> I:Int ~> #toSome => someB(I) ... </k>
/reference/reference-semantics/semantics/subscript.k-53-
/reference/reference-semantics/semantics/subscript.k:54:  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>
/reference/reference-semantics/semantics/subscript.k-55-  rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>
/reference/reference-semantics/semantics/subscript.k-56-  rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>
/reference/reference-semantics/semantics/subscript.k-57-  // a list slice constructs a NEW object; a str slice stays a value
/reference/reference-semantics/semantics/subscript.k-58-  rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)
