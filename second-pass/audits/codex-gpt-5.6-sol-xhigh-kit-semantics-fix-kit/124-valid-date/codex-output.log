+  claim [false-last-branch-result]:
+    <k>
+      #loadAll(validDateProgram)
+      ~> Call(Name("valid_date"), (Str("12-31-9999"), .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope((.Map => "valid_date" |-> validDateClosure), parent(-1))
+      -1 |-> builtinsScope
