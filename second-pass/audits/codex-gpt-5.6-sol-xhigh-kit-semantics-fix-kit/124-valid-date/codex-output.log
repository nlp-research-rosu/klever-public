/reference/reference-semantics/semantics/operators.k-9-
/reference/reference-semantics/semantics/operators.k-10-  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
/reference/reference-semantics/semantics/operators.k-11-
/reference/reference-semantics/semantics/operators.k:12:  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
/reference/reference-semantics/semantics/operators.k-13-
/reference/reference-semantics/semantics/operators.k-14-  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
/reference/reference-semantics/semantics/operators.k-15-  context Compare(HOLE, _)
/reference/reference-semantics/semantics/operators.k-16-  context Compare(_:Val, CmpOp(_, HOLE))
/reference/reference-semantics/semantics/operators.k:17:  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
/reference/reference-semantics/semantics/operators.k-18-
/reference/reference-semantics/semantics/operators.k:19:  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
/reference/reference-semantics/semantics/operators.k:20:  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
/reference/reference-semantics/semantics/operators.k-21-
/reference/reference-semantics/semantics/operators.k-22-  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
/reference/reference-semantics/semantics/operators.k-23-  // (Python: list == is structural; identity only via `is`.) priority(40)
/reference/reference-semantics/semantics/operators.k:24:  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
/reference/reference-semantics/semantics/operators.k-25-  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
/reference/reference-semantics/semantics/operators.k-26-       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/operators.k-27-       [priority(40)]
/reference/reference-semantics/semantics/operators.k-28-  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
