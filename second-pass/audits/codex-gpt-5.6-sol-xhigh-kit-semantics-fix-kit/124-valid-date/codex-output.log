/reference/reference-semantics/semantics/int.k-5-  imports MPY-CORE
/reference/reference-semantics/semantics/int.k-6-
/reference/reference-semantics/semantics/int.k-7-  rule applyUn("-", I:Int) => 0 -Int I
/reference/reference-semantics/semantics/int.k-8-
/reference/reference-semantics/semantics/int.k:9:  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
/reference/reference-semantics/semantics/int.k-10-  // Bool participates in int arithmetic (x += (a == b))
/reference/reference-semantics/semantics/int.k:11:  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
/reference/reference-semantics/semantics/int.k:12:  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
/reference/reference-semantics/semantics/int.k:13:  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
/reference/reference-semantics/semantics/int.k:14:  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
/reference/reference-semantics/semantics/int.k:15:  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
/reference/reference-semantics/semantics/int.k:16:  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
/reference/reference-semantics/semantics/int.k:17:  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
/reference/reference-semantics/semantics/int.k-18-
/reference/reference-semantics/semantics/int.k-19-  syntax Int ::= pyMod(Int, Int) [function]
/reference/reference-semantics/semantics/int.k-20-  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
/reference/reference-semantics/semantics/int.k-21-
/reference/reference-semantics/semantics/int.k:22:  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
/reference/reference-semantics/semantics/int.k:23:  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
/reference/reference-semantics/semantics/int.k:24:  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
/reference/reference-semantics/semantics/int.k:25:  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
/reference/reference-semantics/semantics/int.k:26:  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
/reference/reference-semantics/semantics/int.k:27:  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
/reference/reference-semantics/semantics/int.k-28-endmodule
