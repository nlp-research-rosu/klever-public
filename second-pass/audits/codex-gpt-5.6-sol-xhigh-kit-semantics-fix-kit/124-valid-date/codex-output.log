+        return False
+    if not all(value[i] in "0123456789" for i in (0, 1, 3, 4, 6, 7, 8, 9)):
+        return False
+    month = int(value[:2])
+    day = int(value[3:5])
+    if month < 1 or month > 12 or day < 1:
