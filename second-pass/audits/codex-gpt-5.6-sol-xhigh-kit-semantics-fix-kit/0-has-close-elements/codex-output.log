+++ b/evidence/stage4-ground.k
@@ -0,0 +1,47 @@
+requires "spec.k"
+
+module AUDIT-GROUND
+  imports SPEC
+
+  claim [close-witness]:
+    <k> #loadAll(Module(
+          ImportFrom("typing", "List")
+          FuncDef("has_close_elements", Params("numbers", "threshold"),
+                  HC-FUNCTION-BODY)))
+         ~> Call(Name("has_close_elements"),
+                 list(vCons(1.0, vCons(1.125, .ValSeq))), 0.25)
+        => true </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map => ?MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [strict-boundary-witness]:
+    <k> #loadAll(Module(
+          ImportFrom("typing", "List")
+          FuncDef("has_close_elements", Params("numbers", "threshold"),
+                  HC-FUNCTION-BODY)))
+         ~> Call(Name("has_close_elements"),
+                 list(vCons(1.0, vCons(1.5, .ValSeq))), 0.5)
+        => false </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map => ?MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/stage4_concrete.sh b/evidence/stage4_concrete.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ca556bb01d6707ed98346af47ea5ac7e800b1bbc
--- /dev/null
+++ b/evidence/stage4_concrete.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set -euo pipefail
+set -x
+
+scratch=/tmp/audit-work/reconstruction
+
+cp /audit-output/evidence/stage4-ground.k "$scratch/stage4-ground.k"
+
+/audit-output/evidence/stage4_generate_concrete.py \
+  --solution "$scratch/solution.py" \
+  --output "$scratch/stage4-concrete.py"
+
+python3 "$scratch/py2mpy.py" "$scratch/stage4-concrete.py" \
