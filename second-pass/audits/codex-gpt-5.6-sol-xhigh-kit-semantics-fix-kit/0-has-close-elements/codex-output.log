+        => false </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map => ?MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
