module VERIFICATION
  imports MPY
  imports BOOL
  imports INT
  imports FLOAT

  // Exact AST abbreviations.  These are expanded before execution; they do
  // not replace or summarize any operational step.
  syntax Stmts ::= "HC-INNER-BODY"    [macro]
                 | "HC-OUTER-BODY"    [macro]
                 | "HC-FUNCTION-BODY" [macro]

  rule HC-INNER-BODY
    => If(Compare(Name("i"), CmpOp("!=", Name("j"))),
          If(Compare(Call(Name("abs"), BinOp("-", Name("x"), Name("y"))),
                     CmpOp("<", Name("threshold"))),
             Assign(Name("result"), Bool(true)),
             .Stmts),
          .Stmts)
       AugAssign(Name("j"), "+", Int(1))

  rule HC-OUTER-BODY
    => Assign(Name("j"), Int(0))
       For(Name("y"), Name("numbers"), HC-INNER-BODY)
       AugAssign(Name("i"), "+", Int(1))

  rule HC-FUNCTION-BODY
    => Assign(Name("result"), Bool(false))
       Assign(Name("i"), Int(0))
       Assign(Name("j"), Int(0))
       Assign(Name("x"), Float(0.0))
       Assign(Name("y"), Float(0.0))
       For(Name("x"), Name("numbers"), HC-OUTER-BODY)
       Return(Name("result"))

  // Input-domain predicate corresponding to List[float].
  syntax Bool ::= allFloatVS(ValSeq) [function, total]
  rule allFloatVS(.ValSeq) => true
  rule allFloatVS(vCons(V:Val, VS:ValSeq))
    => isFloat(V) andBool allFloatVS(VS)

  // Counter value after one increment for every remaining sequence element.
  syntax Int ::= advanceIndex(Int, ValSeq) [function, total]
  rule advanceIndex(I:Int, .ValSeq) => I
  rule advanceIndex(I:Int, vCons(_:Val, VS:ValSeq))
    => advanceIndex(I +Int 1, VS)

  // A close pair for the exact fixed-semantics float operations used by the
  // program: subtraction, absolute value, and strict comparison.
  // Total projection used by the logical summary.  The non-float branch is a
  // harmless definitional default; the theorem's allFloatVS/Float domain never
  // selects it.
  syntax Float ::= asFloat(Val) [function, total]
  rule asFloat(F:Float) => F
  rule asFloat(V:Val)   => 0.0 requires notBool isFloat(V)

  // Derived dispatch equations for abstract Val variables known to be floats.
  // Their right-hand sides are exactly the existing MPY-FLOAT cases after the
  // sort projection; they do not bypass lookup, calls, or control.
  rule applyBin("-", X:Val, Y:Val)
    => subF(asFloat(X), asFloat(Y))
    requires isFloat(X) andBool isFloat(Y)
  rule applyBuiltin("abs", X:Val, .Vals)
    => absF(asFloat(X))
    requires isFloat(X)
  rule applyCmp("<", X:Val, Y:Val)
    => floatLt(asFloat(X), asFloat(Y))
    requires isFloat(X) andBool isFloat(Y)

  syntax Bool ::= closeV(Val, Val, Val) [function, total]
  rule closeV(X:Val, Y:Val, T:Val)
    => floatLt(absF(subF(asFloat(X), asFloat(Y))), asFloat(T))

  // Search YS starting at index J for an element whose index differs from I.
  // These equations are used only under allFloatVS(YS).
  syntax Bool ::= closeInner(Val, Val, Int, Int, ValSeq) [function, total]
  rule closeInner(_:Val, _:Val, _:Int, _:Int, .ValSeq) => false
  rule closeInner(X:Val, T:Val, I:Int, J:Int,
                  vCons(Y:Val, YS:ValSeq))
    => ((I =/=Int J andBool closeV(X, Y, T))
        orBool closeInner(X, T, I, J +Int 1, YS))

  // Search every element of XS (whose first index is I) against ALL.
  // These equations are used only under allFloatVS(XS) and allFloatVS(ALL).
  syntax Bool ::= closeOuter(Val, Int, ValSeq, ValSeq) [function, total]
  rule closeOuter(_:Val, _:Int, .ValSeq, _:ValSeq) => false
  rule closeOuter(T:Val, I:Int, vCons(X:Val, XS:ValSeq), ALL:ValSeq)
    => (closeInner(X, T, I, 0, ALL)
        orBool closeOuter(T, I +Int 1, XS, ALL))

  syntax Bool ::= hasClose(ValSeq, Val) [function, total]
  rule hasClose(VS:ValSeq, T:Val) => closeOuter(T, 0, VS, VS)
endmodule
