+#!/usr/bin/env bash
+set -euo pipefail
+set -x
+
+scratch=/tmp/audit-work/reconstruction
+
+cp /audit-output/evidence/stage4-ground.k "$scratch/stage4-ground.k"
+
+/audit-output/evidence/stage4_generate_concrete.py \
