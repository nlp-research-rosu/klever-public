+    j = 0
+    x = 0.0
+    y = 0.0
+    for x in numbers:
+        j = 0
+        for y in numbers:
+            if i != j:
+                if abs(x - y) < threshold:
+                    result = True
+            j += 1
+        i += 1
+    return result
