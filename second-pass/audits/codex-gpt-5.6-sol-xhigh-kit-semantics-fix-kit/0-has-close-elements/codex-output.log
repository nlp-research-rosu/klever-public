printf '"'witness_status=%d concrete_status=%d\\n' \""'$witness_status" "$concrete_status"
cat /audit-output/evidence/stage4-witness.log
cat /audit-output/evidence/stage4-concrete.log' in /tmp/audit-work/reconstruction
