+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner-loop circularity.  Only j, y, and result may change.
+  claim [inner-loop]:
+    <k> #loop(list(YS:ValSeq), Name("y"), HC-INNER-BODY)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+            "numbers"  |-> list(ALL:ValSeq)
+            "threshold" |-> T:Float
+            "result"   |-> (R:Bool => R orBool closeInner(X, T, I, J, YS))
+            "i"        |-> I:Int
+            "j"        |-> (J:Int => advanceIndex(J, YS))
+            "x"        |-> X:Val
+            "y"        |-> (_Y0:Val => ?Y:Val),
+            parent(0))
+          0 |-> scope(M0:Map, parent(-1))
+          -1 |-> builtinsScope ...
+    </scopes>
+    requires isFloat(X) andBool allFloatVS(YS)
+     andBool notBool ("abs" in_keys(M0))
+
+  // Outer-loop circularity.  Locals irrelevant after the loop are existential;
+  // i and result carry the invariant needed by the caller.
+  claim [outer-loop]:
+    <k> #loop(list(XS:ValSeq), Name("x"), HC-OUTER-BODY)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+            "numbers"  |-> list(ALL:ValSeq)
+            "threshold" |-> T:Float
+            "result"   |-> (R:Bool => R orBool closeOuter(T, I, XS, ALL))
+            "i"        |-> (I:Int => advanceIndex(I, XS))
+            "j"        |-> (_J0:Int => ?J:Int)
+            "x"        |-> (_X0:Val => ?X:Val)
+            "y"        |-> (_Y0:Val => ?Y:Val),
+            parent(0))
+          0 |-> scope(M0:Map, parent(-1))
+          -1 |-> builtinsScope ...
+    </scopes>
+    requires allFloatVS(XS) andBool allFloatVS(ALL)
+     andBool notBool ("abs" in_keys(M0))
+
+  // Exact translated module load, name binding, argument binding, function
+  // body, and return path.  The module scope change is explicitly retained.
+  claim [has-close-elements]:
+    <k> #loadAll(Module(
+          ImportFrom("typing", "List")
+          FuncDef("has_close_elements", Params("numbers", "threshold"),
+                  HC-FUNCTION-BODY)))
+         ~> Call(Name("has_close_elements"), list(VS:ValSeq), T:Float)
+        => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes>
