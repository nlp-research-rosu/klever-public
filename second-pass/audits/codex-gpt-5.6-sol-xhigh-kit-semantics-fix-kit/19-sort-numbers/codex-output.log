+       orBool CS ==K strToCodes("seven")
+       orBool CS ==K strToCodes("eight")
+       orBool CS ==K strToCodes("nine")
+
+  syntax Bool ::= validNumeralTokens(ValSeq) [function, total]
+  rule validNumeralTokens(.ValSeq) => true
+  rule validNumeralTokens(vCons(str(CS:IntSeq), REST:ValSeq))
+    => isNumeralCodes(CS) andBool validNumeralTokens(REST)
+  rule validNumeralTokens(vCons(_:Val, _:ValSeq)) => false [owise]
