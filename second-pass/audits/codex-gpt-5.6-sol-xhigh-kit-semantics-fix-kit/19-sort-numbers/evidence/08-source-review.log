     6	  // Definitional summary: the ground tuple used as the numeric-order key.
     7	  // This names a value only; the program still constructs its own tuple.
     8	  syntax Val ::= "numberOrder" [function, total]
     9	  rule numberOrder
    10	    => tuple(
    11	         vCons(str(strToCodes("zero")),
    12	         vCons(str(strToCodes("one")),
    13	         vCons(str(strToCodes("two")),
    14	         vCons(str(strToCodes("three")),
    15	         vCons(str(strToCodes("four")),
    16	         vCons(str(strToCodes("five")),
    17	         vCons(str(strToCodes("six")),
    18	         vCons(str(strToCodes("seven")),
    19	         vCons(str(strToCodes("eight")),
    20	         vCons(str(strToCodes("nine")), .ValSeq)))))))))))
    21	
    22	  // Definitional input-domain predicates matching prompt.py's ten words.
    23	  syntax Bool ::= isNumeralCodes(IntSeq) [function, total]
    24	  rule isNumeralCodes(CS:IntSeq)
    25	    => CS ==K strToCodes("zero")
    26	       orBool CS ==K strToCodes("one")
    27	       orBool CS ==K strToCodes("two")
    28	       orBool CS ==K strToCodes("three")
    29	       orBool CS ==K strToCodes("four")
    30	       orBool CS ==K strToCodes("five")
    31	       orBool CS ==K strToCodes("six")
    32	       orBool CS ==K strToCodes("seven")
    33	       orBool CS ==K strToCodes("eight")
    34	       orBool CS ==K strToCodes("nine")
    35	
    36	  syntax Bool ::= validNumeralTokens(ValSeq) [function, total]
    37	  rule validNumeralTokens(.ValSeq) => true
    38	  rule validNumeralTokens(vCons(str(CS:IntSeq), REST:ValSeq))
    39	    => isNumeralCodes(CS) andBool validNumeralTokens(REST)
    40	  rule validNumeralTokens(vCons(_:Val, _:ValSeq)) => false [owise]
    41	endmodule
