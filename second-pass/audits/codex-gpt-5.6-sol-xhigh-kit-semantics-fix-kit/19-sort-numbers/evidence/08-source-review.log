     4	
     5	from typing import List
     6	
     7	
     8	def sort_numbers(numbers: str) -> str:
     9	    """ Input is a space-delimited string of numberals from 'zero' to 'nine'.
    10	    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.
    11	    Return the string with numbers sorted from smallest to largest
    12	    >>> sort_numbers('three one five')
    13	    'one three five'
    14	    """
    15	    value_map = {
    16	        'zero': 0,
    17	        'one': 1,
    18	        'two': 2,
    19	        'three': 3,
    20	        'four': 4,
    21	        'five': 5,
    22	        'six': 6,
    23	        'seven': 7,
    24	        'eight': 8,
    25	        'nine': 9
    26	    }
    27	    return ' '.join(sorted([x for x in numbers.split(' ') if x], key=lambda x: value_map[x]))
