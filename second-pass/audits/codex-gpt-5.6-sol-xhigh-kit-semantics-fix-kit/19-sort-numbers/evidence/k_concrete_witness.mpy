Module(
  FuncDef("sort_numbers", Params("numbers"),
    Assign(
      Name("order"),
      TupleExpr(
        Str("zero"),
        Str("one"),
        Str("two"),
        Str("three"),
        Str("four"),
        Str("five"),
        Str("six"),
        Str("seven"),
        Str("eight"),
        Str("nine")))
    Return(
      Call(
        Attribute(Str(" "), "join"),
        Call(
          Name("sorted"),
          Call(Attribute(Name("numbers"), "split"), ),
          KwArg("key", Attribute(Name("order"), "index"))))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("three one five")),
      CmpOp("==", Str("one three five"))))
  Assert(
    Compare(Call(Name("sort_numbers"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(
        Name("sort_numbers"),
        Str("nine eight seven six five four three two one zero")),
      CmpOp(
        "==",
        Str("zero one two three four five six seven eight nine"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("nine zero nine zero five five")),
      CmpOp("==", Str("zero zero five five nine nine")))))
