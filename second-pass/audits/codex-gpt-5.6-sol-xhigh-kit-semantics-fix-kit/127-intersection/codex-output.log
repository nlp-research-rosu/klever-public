+requires "verification.k"
+
+module REVIEWER-FALSE-RESULT
+  imports VERIFICATION
+
+  // Fresh reviewer mutation: this satisfying branch-2 input has intersection
+  // length min(5,5)-max(0,2) = 3, so the submitted program returns YES.
+  // The destination is deliberately mutated to the false result NO.
+  claim [false-prime-result]:
+    <k> #loadAll(SOLUTION-MODULE)
+         ~> Call(Name("intersection"),
+                 (tuple(vCons(0, vCons(5, .ValSeq))),
+                  tuple(vCons(2, vCons(5, .ValSeq))),
+                  .Exprs))
+      => str(iCons(78, iCons(79, .IntSeq))) </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0  |-> scope(
+               "intersection" |->
+                 closureVal(("interval1", "interval2", .ParamNames),
+                            INTERSECTION-BODY, 0),
+               parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..4d9a78eaf2bc7cc1b756662fe098fb7cedb0f967
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee -a "$log"
+
+set +e
+"$@" 2>&1 | tee -a "$log"
+status=${PIPESTATUS[0]}
+set -e
+
+printf '[exit status: %d]\n' "$status" | tee -a "$log"
+exit "$status"
diff --git a/evidence/validate_review.py b/evidence/validate_review.py
new file mode 100644
index 0000000000000000000000000000000000000000..c1aa818c79746a67a1b77dcc92569bce6b1239a2
--- /dev/null
+++ b/evidence/validate_review.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Final structural validation of REVIEW.md and its cited local evidence."""
+
+from __future__ import annotations
+
