#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy

python3 - <<'PY'
import ast
from pathlib import Path

solution_tree = ast.parse(Path("solution.py").read_text())
test_tree = ast.parse(Path("concrete-tests.py").read_text())
assert ast.dump(solution_tree.body[0], include_attributes=False) == ast.dump(
    test_tree.body[0], include_attributes=False
)
print("concrete harness function AST matches solution.py: yes")
PY

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun concrete-tests.mpy --definition runtime-kompiled --output none
echo "krun concrete assertions: passed"

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

proof_tmp="$(mktemp -d)"
trap 'rm -rf -- "$proof_tmp"' EXIT

kast solution.mpy \
  --definition verification-kompiled \
  --module MPY-SYNTAX \
  --sort Module \
  --output json > "$proof_tmp/solution.json"
kast --expression 'SOLUTION-MODULE' \
  --definition verification-kompiled \
  --module VERIFICATION \
  --sort Module \
  --expand-macros \
  --output json > "$proof_tmp/proof-program.json"
diff -u "$proof_tmp/solution.json" "$proof_tmp/proof-program.json"
echo "proof program AST matches solution.mpy: yes"

python3 py2mpy.py solution-body-mutant.py > "$proof_tmp/solution-body-mutant.mpy"
kast "$proof_tmp/solution-body-mutant.mpy" \
  --definition verification-kompiled \
  --module MPY-SYNTAX \
  --sort Module \
  --output json > "$proof_tmp/mutant.json"
if diff -q "$proof_tmp/mutant.json" "$proof_tmp/proof-program.json" >/dev/null; then
  echo "ERROR: body mutation did not invalidate program identity" >&2
  exit 1
else
  echo "EXPECTED FAILURE: body mutation invalidated program identity"
fi

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

set +e
mutation_output="$(kprove spec-vacuity.k \
  --definition verification-kompiled \
  --spec-module SPEC-VACUITY 2>&1)"
mutation_status=$?
set -e
printf '%s\n' "$mutation_output"
if [[ $mutation_status -eq 0 ]]; then
  echo "ERROR: false-postcondition mutation unexpectedly proved" >&2
  exit 1
fi
echo "EXPECTED FAILURE: false-postcondition mutation exited $mutation_status"

python3 differential_test.py
