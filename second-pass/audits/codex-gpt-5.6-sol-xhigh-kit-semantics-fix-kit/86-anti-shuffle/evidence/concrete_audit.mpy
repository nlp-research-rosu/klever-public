Module(
  FuncDef("insert_char", Params("word", "char"),
    Assign(Name("prefix"), Str(""))
    Assign(Name("suffix"), Name("word"))
    Assign(Name("current"), Str(""))
    For(Name("current"), Name("word"),
      If(Compare(Name("char"), CmpOp("<", Name("current"))),
        Return(
          BinOp(
            "+",
            BinOp("+", Name("prefix"), Name("char")),
            Name("suffix"))),
        Assign(
          Name("prefix"),
          BinOp("+", Name("prefix"), Name("current")))
        Assign(
          Name("suffix"),
          Subscript(Name("suffix"), Slice(Int(1), NoBound, NoBound)))))
    Return(BinOp("+", Name("prefix"), Name("char"))))
  FuncDef("anti_shuffle", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("word"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("s"),
      If(Compare(Name("char"), CmpOp("==", Str(" "))),
        Assign(
          Name("result"),
          BinOp("+", BinOp("+", Name("result"), Name("word")), Str(" ")))
        Assign(Name("word"), Str("")),
        Assign(
          Name("word"),
          Call(Name("insert_char"), Name("word"), Name("char")))))
    Return(BinOp("+", Name("result"), Name("word"))))
  Assert(
    Compare(Call(Name("anti_shuffle"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(Call(Name("anti_shuffle"), Str(" ")), CmpOp("==", Str(" "))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("Hi")),
      CmpOp("==", Str("Hi"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("hello")),
      CmpOp("==", Str("ehllo"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("Hello World!!!")),
      CmpOp("==", Str("Hello !!!Wdlor"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("ba ab")),
      CmpOp("==", Str("ab ab"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("a  cb")),
      CmpOp("==", Str("a  bc"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("\u007f\u0000 ~!")),
      CmpOp("==", Str("\u0000\u007f !~")))))
