    14	def anti_shuffle(s):
    15	    result = ""
    16	    word = ""
    17	    char = ""
    18	    for char in s:
    19	        if char == " ":
    20	            result = result + word + " "
    21	            word = ""
    22	        else:
    23	            word = insert_char(word, char)
    24	    return result + word
