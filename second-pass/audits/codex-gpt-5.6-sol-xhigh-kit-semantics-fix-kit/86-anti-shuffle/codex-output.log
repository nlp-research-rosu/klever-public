     1	def insert_char(word, char):
     2	    prefix = ""
     3	    suffix = word
     4	    current = ""
     5	    for current in word:
     6	        if char < current:
     7	            return prefix + char + suffix
     8	        else:
     9	            prefix = prefix + current
    10	            suffix = suffix[1:]
    11	    return prefix + char
