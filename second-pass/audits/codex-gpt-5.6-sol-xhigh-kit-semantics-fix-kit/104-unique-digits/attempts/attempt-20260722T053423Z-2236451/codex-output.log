module VERIFICATION
  imports MPY

  // A total symbolic projection whose Int-injection equation is exact.
  syntax Int ::= intProj(Val)
    [function, total, symbol(intProj), no-evaluators]
  rule intProj(I:Int) => I

  // Total symbolic name for the fixed semantics' positive-Int decimal codes.
  syntax IntSeq ::= decimalCodes(Int)
    [function, total, symbol(decimalCodes), no-evaluators]
  rule decimalCodes(N:Int) => strToCodes(Int2String(N)) [concrete]

  // True exactly when every element is a positive integer.
  syntax Bool ::= positiveInts(ValSeq) [function, total]
  rule positiveInts(.ValSeq) => true
  rule positiveInts(vCons(V:Val, REST:ValSeq))
    => isInt(V) andBool intProj(V) >Int 0 andBool positiveInts(REST)

  // Exact positive-Int str call, with its code sequence kept symbolic.
  rule <k> #applyK(toCall(typeV("str")), (I:Int, .Vals))
        => str(decimalCodes(I)) ... </k>
    requires I >Int 0
    [priority(40)]

  // Symbolic-subsort bridge for the fixed list iterator rule.
  rule <k> #iterNext(list(vCons(V:Val, REST:ValSeq)))
        => #iterYield(intProj(V), list(REST)) ... </k>
    requires isInt(V)
    [priority(40)]

  // Stable filtering in input order; sorted() is applied by the program later.
  syntax ValSeq ::= filterOdd(ValSeq) [function, total]
  rule filterOdd(.ValSeq) => .ValSeq
  rule filterOdd(vCons(V:Val, REST:ValSeq))
    => filterOdd(REST)
    requires strContains(iCons(48, .IntSeq), decimalCodes(intProj(V)))
    [simplification]
  rule filterOdd(vCons(V:Val, REST:ValSeq))
    => filterOdd(REST)
    requires strContains(iCons(50, .IntSeq), decimalCodes(intProj(V)))
    [simplification]
  rule filterOdd(vCons(V:Val, REST:ValSeq))
    => filterOdd(REST)
    requires strContains(iCons(52, .IntSeq), decimalCodes(intProj(V)))
    [simplification]
  rule filterOdd(vCons(V:Val, REST:ValSeq))
    => filterOdd(REST)
    requires strContains(iCons(54, .IntSeq), decimalCodes(intProj(V)))
    [simplification]
  rule filterOdd(vCons(V:Val, REST:ValSeq))
    => filterOdd(REST)
    requires strContains(iCons(56, .IntSeq), decimalCodes(intProj(V)))
    [simplification]
  rule filterOdd(vCons(V:Val, REST:ValSeq))
    => vCons(intProj(V), filterOdd(REST))
    requires notBool strContains(iCons(48, .IntSeq), decimalCodes(intProj(V)))
     andBool notBool strContains(iCons(50, .IntSeq), decimalCodes(intProj(V)))
     andBool notBool strContains(iCons(52, .IntSeq), decimalCodes(intProj(V)))
     andBool notBool strContains(iCons(54, .IntSeq), decimalCodes(intProj(V)))
     andBool notBool strContains(iCons(56, .IntSeq), decimalCodes(intProj(V)))
    [simplification]

  // Derived associativity lemma for the list accumulator.
  rule valSeqConcat(A:ValSeq, .ValSeq) => A
    [simplification]
  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
    => valSeqConcat(A, valSeqConcat(B, C))
    [simplification]
endmodule

