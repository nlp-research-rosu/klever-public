@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG_NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log_name=$1
+shift
+audit_log_path="/audit-output/evidence/${audit_log_name}.log"
+audit_tmp_log=$(mktemp /tmp/audit-work/audit-command.XXXXXX)
+
+"$@" >"$audit_tmp_log" 2>&1
+audit_status=$?
+audit_line_count=$(wc -l <"$audit_tmp_log")
+audit_byte_count=$(wc -c <"$audit_tmp_log")
+
+{
+  printf 'cwd: %q\n' "$PWD"
+  printf 'command:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'captured_lines: %s\n' "$audit_line_count"
+  printf 'captured_bytes: %s\n' "$audit_byte_count"
+  printf '%s\n' '--- output ---'
+  if (( audit_line_count <= 600 )); then
+    sed -n '1,600p' "$audit_tmp_log"
+  else
+    sed -n '1,300p' "$audit_tmp_log"
+    printf '%s\n' "--- omitted $((audit_line_count - 600)) middle lines ---"
+    tail -n 300 "$audit_tmp_log"
+  fi
+  printf '%s\n' '--- status ---'
+  printf 'exit_status: %s\n' "$audit_status"
+} >"$audit_log_path"
+
+rm -f "$audit_tmp_log"
+exit "$audit_status"

exec
/bin/bash -lc "chmod +x evidence/run_logged.sh evidence/provenance_check.py evidence/differential_test.py evidence/k_rule_inventory.py evidence/generation_claims_scan.py
./evidence/run_logged.sh 01-provenance ./evidence/provenance_check.py
./evidence/run_logged.sh 01-generation-claims ./evidence/generation_claims_scan.py
cp /candidate/solution.py /tmp/audit-work/solution.py
cp /candidate/solution.mpy /tmp/audit-work/solution.mpy
cp /candidate/verification.k /tmp/audit-work/verification.k
cp /candidate/spec.k /tmp/audit-work/spec.k
cp /reference/py2mpy.py /tmp/audit-work/py2mpy.py
cp /reference/prompt.py /tmp/audit-work/prompt.py
cp /reference/canonical.py /tmp/audit-work/canonical.py
cp -a /reference/reference-semantics /tmp/audit-work/reference-semantics
./evidence/run_logged.sh 05-k-rule-inventory ./evidence/k_rule_inventory.py /tmp/audit-work/reference-semantics /tmp/audit-work/verification.k /tmp/audit-work/spec.k
find /tmp/audit-work -maxdepth 2 -printf '%y %p -> %l\\n' | sort
sed -n '1,220p' evidence/01-provenance.log
sed -n '1,220p' evidence/01-generation-claims.log
tail -20 evidence/05-k-rule-inventory.log" in /audit-output
