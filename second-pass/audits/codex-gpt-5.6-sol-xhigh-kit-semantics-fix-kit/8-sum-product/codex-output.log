+    tail -n 300 "$audit_tmp_log"
+  fi
+  printf '%s\n' '--- status ---'
+  printf 'exit_status: %s\n' "$audit_status"
+} >"$audit_log_path"
+
+rm -f "$audit_tmp_log"
+exit "$audit_status"

