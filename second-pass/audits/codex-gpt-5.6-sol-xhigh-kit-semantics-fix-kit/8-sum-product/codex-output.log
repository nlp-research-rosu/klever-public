module VERIFICATION
  imports MPY

  // A proof-side inductive presentation of exactly the finite integer lists
  // admitted by the HumanEval type contract, plus its constructor-preserving
  // embedding into the semantics' ValSeq representation.
  syntax IntList ::= ".IntList"
                   | iList(Int, IntList)
  syntax ValSeq ::= intVals(IntList)
  rule intVals(.IntList) => .ValSeq
  rule intVals(iList(I:Int, REST:IntList))
    => vCons(I, intVals(REST))

  // Exact symbolic accelerators: intVals equation followed by the matching
  // supplied MPY-LIST #iterNext equation.  They alter only the <k> redex.
  rule <k> #iterNext(list(intVals(.IntList)))
        => #iterDone ... </k>
       [priority(40)]
  rule <k> #iterNext(list(intVals(iList(I:Int, REST:IntList))))
        => #iterYield(I, list(intVals(REST))) ... </k>
       [priority(40)]

  // The Haskell backend does not cool a symbolic tuple(Int, Int) out of the
  // generated Return strictness freezer.  This exact bridge is the composition
  // of the two pure local Name lookups, TupleExpr construction, and MPY's
  // Return rule.  The real #pop rule still performs all frame/state cleanup.
  rule <k> Return(TupleExpr(Name("total"), Name("product"), .Exprs)) ~> _
        => #pop </k>
       <env> LOCAL:Int </env>
       <scopes>
         ... LOCAL |-> scope("numbers" |-> NUMBERS:Val
                             "total" |-> SUM:Int
                             "product" |-> PRODUCT:Int
                             "number" |-> LAST:Val,
                             parent(0)) ...
       </scopes>
       <ret> noRet => retV(tuple(vCons(SUM,
                                      vCons(PRODUCT, .ValSeq)))) </ret>
       [priority(40)]

  // Likewise, symbolic list values do not cool out of For's generated
  // strictness freezer.  This bridge composes the pure local lookup of
  // numbers with MPY-CONTROLS' For-to-#loop rule.
  rule <k> For(Name("number"), Name("numbers"),
               Assign(Name("total"),
                 BinOp("+", Name("total"), Name("number")))
               Assign(Name("product"),
                 BinOp("*", Name("product"), Name("number")))
               .Stmts)
        => #loop(list(intVals(XS:IntList)), Name("number"),
                  Assign(Name("total"),
                    BinOp("+", Name("total"), Name("number")))
                  Assign(Name("product"),
                    BinOp("*", Name("product"), Name("number")))
                  .Stmts) ... </k>
       <env> LOCAL:Int </env>
       <scopes>
         ... LOCAL |-> scope("numbers" |-> list(intVals(XS))
                             "total" |-> SUM:Int
                             "product" |-> PRODUCT:Int
                             "number" |-> LAST:Val,
                             parent(0)) ...
       </scopes>
       [priority(40)]

  // Left folds matching the two accumulator assignments in solution.py.
  syntax Int ::= sumFrom(Int, IntList) [function, total]
               | productFrom(Int, IntList) [function, total]

  rule sumFrom(ACC:Int, .IntList) => ACC
  rule sumFrom(ACC:Int, iList(I:Int, REST:IntList))
    => sumFrom(ACC +Int I, REST)

  rule productFrom(ACC:Int, .IntList) => ACC
  rule productFrom(ACC:Int, iList(I:Int, REST:IntList))
    => productFrom(ACC *Int I, REST)
endmodule
