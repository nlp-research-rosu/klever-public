import ast
import itertools
import math

import solution


def oracle(numbers):
    return (sum(numbers), math.prod(numbers))


def function_ast(path):
    tree = ast.parse(path.read_text(encoding="utf-8"))
    return next(node for node in tree.body
                if isinstance(node, ast.FunctionDef)
                and node.name == "sum_product")


def main():
    from pathlib import Path

    # The K smoke module must exercise the same function body as solution.py.
    assert ast.dump(function_ast(Path("solution.py")), include_attributes=False) == \
        ast.dump(function_ast(Path("smoke.py")), include_attributes=False)

    explicit = [
        [],
        [1, 2, 3, 4],
        [-2, 3, 0],
        [-2, -3],
        [7],
    ]
    exhaustive = (
        list(values)
        for length in range(6)
        for values in itertools.product(range(-3, 4), repeat=length)
    )

    checked = 0
    mismatches = []
    for numbers in itertools.chain(explicit, exhaustive):
        actual = solution.sum_product(numbers)
        expected = oracle(numbers)
        checked += 1
        if actual != expected:
            mismatches.append((numbers, actual, expected))

    print(f"checked={checked} mismatches={len(mismatches)}")
    if mismatches:
        for mismatch in mismatches[:10]:
            print(mismatch)
