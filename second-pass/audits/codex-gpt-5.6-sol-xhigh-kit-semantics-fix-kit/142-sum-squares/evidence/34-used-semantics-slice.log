     3	module BRIDGE-SPEC
     4	  imports VERIFICATION-BASE
     5	
     6	  // These claims use only the fixed MPY iterator semantics. Together with
     7	  // valsOf's two structural equations, they justify verification.k's two
     8	  // corresponding acceleration rules.
     9	  claim [iterator-empty]:
    10	    <k> #iterNext(list(.ValSeq)) => #iterDone ... </k>
    11	
    12	  claim [iterator-cons]:
    13	    <k> #iterNext(list(vCons(I:Int, VS:ValSeq)))
    14	        => #iterYield(I, list(VS)) ... </k>
    15	endmodule
