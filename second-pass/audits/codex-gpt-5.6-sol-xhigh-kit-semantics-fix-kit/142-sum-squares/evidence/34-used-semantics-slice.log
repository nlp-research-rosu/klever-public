     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // The macros below were audited against solution.mpy SHA-256
     7	  // 7e38e83fd449b6b33fccfd881ed3076db7bf09bbdd894b3c34e7c86743a2092a.
     8	
     9	  // A ghost representation whose inhabitants correspond exactly to finite
    10	  // Python lists containing only integers.
    11	  syntax IntList ::= ".IntList"
    12	                   | intCons(Int, IntList)
    13	
    14	  syntax ValSeq ::= valsOf(IntList)
    15	  rule valsOf(.IntList) => .ValSeq
    16	  rule valsOf(intCons(I:Int, IS:IntList)) => vCons(I, valsOf(IS))
    17	
    18	  syntax Int ::= intListLength(IntList) [function, total]
    19	  rule intListLength(.IntList) => 0
    20	  rule intListLength(intCons(_:Int, IS:IntList))
    21	    => 1 +Int intListLength(IS)
    22	
    23	  // The contribution made by the value at a given zero-based index.
    24	  syntax Int ::= squareContribution(Int, Int) [function, total]
    25	  rule squareContribution(V:Int, I:Int) => V *Int V
    26	    requires pyMod(I, 3) ==Int 0
    27	  rule squareContribution(V:Int, I:Int) => V *Int V *Int V
    28	    requires pyMod(I, 3) =/=Int 0 andBool pyMod(I, 4) ==Int 0
    29	  rule squareContribution(V:Int, I:Int) => V
    30	    requires pyMod(I, 3) =/=Int 0 andBool pyMod(I, 4) =/=Int 0
    31	
    32	  // Mathematical result for a suffix, parameterized by its absolute index.
    33	  syntax Int ::= sumSquaresFrom(IntList, Int) [function, total]
    34	  rule sumSquaresFrom(.IntList, _:Int) => 0
    35	  rule sumSquaresFrom(intCons(V:Int, IS:IntList), I:Int)
    36	    => squareContribution(V, I) +Int sumSquaresFrom(IS, I +Int 1)
    37	
    38	  // Right-associated addition gives the recursive invariant one canonical
    39	  // shape even when its suffix summary remains symbolic.
    40	  rule (A:Int +Int B:Int) +Int C:Int => A +Int (B +Int C)
    41	    [simplification]
    42	
    43	  // Exact AST fragments emitted by py2mpy.py for solution.py. These are only
    44	  // macros: after expansion, the supplied MPY rules execute every operation.
    45	  syntax Stmts ::= "sumSquaresLoopBody" [macro]
    46	  rule sumSquaresLoopBody
    47	    => If(
    48	         Compare(BinOp("%", Name("index"), Int(3)), CmpOp("==", Int(0))),
    49	         AugAssign(
    50	           Name("total"),
    51	           "+",
    52	           BinOp("*", Name("value"), Name("value"))),
    53	         If(
    54	           Compare(BinOp("%", Name("index"), Int(4)), CmpOp("==", Int(0))),
    55	           AugAssign(
    56	             Name("total"),
    57	             "+",
    58	             BinOp(
    59	               "*",
    60	               BinOp("*", Name("value"), Name("value")),
    61	               Name("value"))),
    62	           AugAssign(Name("total"), "+", Name("value"))))
    63	       AugAssign(Name("index"), "+", Int(1))
    64	
    65	  syntax Stmts ::= "sumSquaresBody" [macro]
    66	  rule sumSquaresBody
    67	    => Assign(Name("total"), Int(0))
    68	       Assign(Name("index"), Int(0))
    69	       Assign(Name("value"), Int(0))
    70	       For(Name("value"), Name("lst"), sumSquaresLoopBody)
    71	       Return(Name("total"))
    72	
    73	  syntax Stmt ::= "sumSquaresDef" [macro]
    74	  rule sumSquaresDef
    75	    => FuncDef("sum_squares", Params("lst"), sumSquaresBody)
    76	endmodule
     1	requires "verification-base.k"
     2	
     3	module VERIFICATION
     4	  imports VERIFICATION-BASE
     5	
     6	  // Symbolic iterator bridge. bridge-spec.k proves both exhaustive IntList
     7	  // cases against VERIFICATION-BASE, where these acceleration rules are absent.
     8	  rule <k> #iterNext(list(valsOf(.IntList))) => #iterDone ... </k>
     9	  rule <k> #iterNext(list(valsOf(intCons(I:Int, IS:IntList))))
    10	        => #iterYield(I, list(valsOf(IS))) ... </k>
    11	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Circularity for the exact for-loop. The source list stays unchanged;
     7	  // total and index characterize the processed suffix. The loop variable is
     8	  // local and intentionally existential in the final state.
     9	  claim [loop-invariant]:
    10	    <k> #loop(list(valsOf(IS:IntList)), Name("value"), sumSquaresLoopBody)
    11	        => .K ... </k>
    12	    <env> L:Int </env>
    13	    <scopes>
    14	      ... L |-> scope(
    15	            "lst"   |-> list(valsOf(ALL:IntList))
    16	            "total" |-> (ACC:Int => ACC +Int sumSquaresFrom(IS, INDEX))
    17	            "index" |-> (INDEX:Int => INDEX +Int intListLength(IS))
    18	            "value" |-> (_OLD:Val => ?LAST:Val),
    19	            parent(0)) ...
    20	    </scopes>
    21	
    22	  // Whole-program base case: install the exact translated definition, resolve
    23	  // its name, bind an empty list, execute, and return zero.
    24	  claim [sum-squares-empty]:
    25	    <k> sumSquaresDef ~> Call(Name("sum_squares"), list(valsOf(.IntList)))
    26	        => 0 </k>
    27	    <env> 0 </env>
    28	    <scopes>
    29	      0  |-> scope(
    30	              .Map => "sum_squares" |-> closureVal("lst", sumSquaresBody, 0),
    31	              parent(-1))
    32	      -1 |-> builtinsScope
    33	    </scopes>
    34	    <scopeLoc> 1 </scopeLoc>
    35	    <heap> .Map </heap>
    36	    <heapLoc> 0 </heapLoc>
    37	    <stack> .List </stack>
    38	    <ret> noRet </ret>
    39	    <exc> NoExc </exc>
    40	
    41	  // Whole-program inductive case. With the base claim, this covers every
    42	  // finite integer list represented by IntList.
    43	  claim [sum-squares-nonempty]:
    44	    <k> sumSquaresDef
    45	         ~> Call(
    46	              Name("sum_squares"),
    47	              list(valsOf(intCons(HEAD:Int, REST:IntList))))
    48	        => sumSquaresFrom(intCons(HEAD, REST), 0) </k>
    49	    <env> 0 </env>
    50	    <scopes>
    51	      0  |-> scope(
    52	              .Map => "sum_squares" |-> closureVal("lst", sumSquaresBody, 0),
    53	              parent(-1))
    54	      -1 |-> builtinsScope
    55	    </scopes>
    56	    <scopeLoc> 1 </scopeLoc>
    57	    <heap> .Map </heap>
    58	    <heapLoc> 0 </heapLoc>
    59	    <stack> .List </stack>
    60	    <ret> noRet </ret>
    61	    <exc> NoExc </exc>
    62	endmodule
