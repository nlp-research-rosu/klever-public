+  printf '%s\n' '-- SEMANTIC ATTRIBUTES AND OPAQUE MARKERS --'
+  rg -n '\[(function|functional|total|concrete|priority|simplification|owise|macro)(\(|,|\]|\s)|\bopaque\b' "$file" || true
