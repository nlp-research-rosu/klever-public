Module(
  FuncDef("is_sorted", Params("lst"),
    Assign(Name("prev"), UnaryOp("-", Int(1)))
    Assign(Name("duplicates"), Int(0))
    Assign(Name("result"), Bool(true))
    For(Name("value"), Name("lst"),
      If(Call(Name("isinstance"), Name("value"), Name("int")),
        If(Compare(Name("value"), CmpOp("<", Name("prev"))),
          Assign(Name("result"), Bool(false)),
          )
        If(Compare(Name("value"), CmpOp("==", Name("prev"))),
          AugAssign(Name("duplicates"), "+", Int(1)),
          Assign(Name("duplicates"), Int(0)))
        If(Compare(Name("duplicates"), CmpOp(">", Int(1))),
          Assign(Name("result"), Bool(false)),
          )
        Assign(Name("prev"), Name("value")),
        Return(Bool(false))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr()),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(0))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(0), Int(0))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(0), Int(0), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(0), Int(1), Int(2))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(1), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(0), Int(1), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(0), Int(0), Int(1), Int(1))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("is_sorted"),
        ListExpr(Int(0), Int(0), Int(1), Int(1), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(9223372036854775807))),
      CmpOp("==", Bool(true)))))
