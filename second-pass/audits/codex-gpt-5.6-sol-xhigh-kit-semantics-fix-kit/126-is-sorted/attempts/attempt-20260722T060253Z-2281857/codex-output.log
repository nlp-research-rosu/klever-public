/bin/bash -lc "/audit-output/evidence/run_logged.sh /audit-output/evidence/stage3-build-entry.log bash -lc 'export PATH=\""'$HOME/.nix-profile/bin:$PATH"; kompile --backend haskell verification.k --main-module VERIFICATION-ENTRY --syntax-module MPY-SYNTAX --output-definition audit-verification-entry-kompiled'"'; build_status="'$?; if [[ $build_status -ne 0 ]]; then exit "$build_status"; fi; /audit-output/evidence/run_logged.sh /audit-output/evidence/stage3-prove-entry.log bash -lc '"'export PATH=\""'$HOME/.nix-profile/bin:$PATH"; kprove spec.k --definition audit-verification-entry-kompiled --spec-module SPEC --claims SPEC.is-sorted'"'" in /tmp/audit-work/126-is-sorted
