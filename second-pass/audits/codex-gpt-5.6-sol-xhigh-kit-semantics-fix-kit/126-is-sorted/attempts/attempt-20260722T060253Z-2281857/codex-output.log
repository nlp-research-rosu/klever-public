index 0000000000000000000000000000000000000000..55dffc00174d273e9075c1fc499b3138bcd255be
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set +e
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+} > "$log"
+
+"$@" >> "$log" 2>&1
+status=$?
+
+printf 'EXIT_STATUS: %d\n' "$status" >> "$log"
+exit "$status"
diff --git a/evidence/spec-fresh-false-audit.k b/evidence/spec-fresh-false-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..48fbf264fcab455925f1d9a1f613633b7dc74573
--- /dev/null
+++ b/evidence/spec-fresh-false-audit.k
@@ -0,0 +1,67 @@
+requires "verification.k"
+
+module AUDIT-FRESH-FALSE
+  imports VERIFICATION-ENTRY
+
+  // Deliberately false on the satisfying intended-domain input [0,0,0].
+  // The real program and scanSorted both return false; this mutation demands true.
+  claim [triple-duplicate-is-true]:
+    <k>
+      #loadAll(Module(
+        FuncDef("is_sorted", Params("lst"),
+          Assign(Name("prev"), UnaryOp("-", Int(1)))
+          Assign(Name("duplicates"), Int(0))
+          Assign(Name("result"), Bool(true))
+          For(Name("value"), Name("lst"),
+            If(Call(Name("isinstance"), Name("value"), Name("int")),
+              If(Compare(Name("value"), CmpOp("<", Name("prev"))),
+                Assign(Name("result"), Bool(false)),
+                .Stmts)
+              If(Compare(Name("value"), CmpOp("==", Name("prev"))),
+                AugAssign(Name("duplicates"), "+", Int(1)),
+                Assign(Name("duplicates"), Int(0)))
+              If(Compare(Name("duplicates"), CmpOp(">", Int(1))),
