/bin/bash -lc "sed -n '68,86p' spec.k | sed '1s/"'^[[:space:]]*#loadAll(//'"' | sed '"'$s/)[[:space:]]*$//'"' > entry-loaded-audit.mpy; /audit-output/evidence/run_logged.sh /audit-output/evidence/stage4-kast-pinning.log bash -lc 'export PATH=\""'$HOME/.nix-profile/bin:$PATH"; kast solution.mpy --definition audit-verification-kompiled --output json > solution-audit.kast.json; kast entry-loaded-audit.mpy --definition audit-verification-kompiled --output json > entry-loaded-audit.kast.json; cmp solution-audit.kast.json entry-loaded-audit.kast.json; sha256sum solution-audit.kast.json entry-loaded-audit.kast.json'"'; kast_status="'$?; /audit-output/evidence/run_logged.sh /audit-output/evidence/stage4-pinning.log python3 /audit-output/evidence/pinning_check.py; pin_status=$?; sed -n '"'1,120p' /audit-output/evidence/stage4-kast-pinning.log; sed -n '1,120p' /audit-output/evidence/stage4-pinning.log; if [[ "'$kast_status -ne 0 ]]; then exit "$kast_status"; fi; exit "$pin_status"' in /tmp/audit-work/126-is-sorted
diff --git a//tmp/audit-work/126-is-sorted/concrete-audit.py b//tmp/audit-work/126-is-sorted/concrete-audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..28359d95742ed8e6eb1855fc86b05450f34c3399
--- /dev/null
+++ b//tmp/audit-work/126-is-sorted/concrete-audit.py
@@ -0,0 +1,30 @@
+def is_sorted(lst):
+    prev = -1
+    duplicates = 0
+    result = True
+    for value in lst:
+        if isinstance(value, int):
+            if value < prev:
+                result = False
+            if value == prev:
+                duplicates += 1
+            else:
+                duplicates = 0
+            if duplicates > 1:
+                result = False
+            prev = value
+        else:
+            return False
+    return result
+
+
+assert is_sorted([]) == True
+assert is_sorted([0]) == True
+assert is_sorted([0, 0]) == True
+assert is_sorted([0, 0, 0]) == False
+assert is_sorted([0, 1, 2]) == True
+assert is_sorted([1, 0]) == False
+assert is_sorted([0, 1, 0]) == False
+assert is_sorted([0, 0, 1, 1]) == True
+assert is_sorted([0, 0, 1, 1, 1]) == False
+assert is_sorted([9223372036854775807]) == True
