+def is_sorted(lst):
+    prev = -1
+    duplicates = 0
+    result = True
+    for value in lst:
+        if isinstance(value, int):
+            if value < prev:
+                result = False
+            if value == prev:
+                duplicates += 1
+            else:
+                duplicates = 0
+            if duplicates > 1:
+                result = False
+            prev = value
+        else:
+            return False
+    return result
+
+
