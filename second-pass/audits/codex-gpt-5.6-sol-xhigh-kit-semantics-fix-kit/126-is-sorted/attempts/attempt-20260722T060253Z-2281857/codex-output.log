     1	// reference/src/semantics/range.k — MPY-RANGE
     2	// rangeObj: the range helpers (inRange / rangeLen) + its #iterNext case. rangeObj itself is
     3	// declared in MPY-CORE's Iterable union; this module owns its behavior.
     4	
     5	module MPY-RANGE
     6	  imports MPY-CORE
     7	  imports MPY-ITER
     8	
     9	  syntax Bool ::= inRange(Int, Int, Int) [function, total]
    10	  rule inRange(I:Int, HI:Int, ST:Int) => (ST >Int 0 andBool I <Int HI) orBool (ST <Int 0 andBool I >Int HI)
    11	
    12	  syntax Int ::= rangeLen(Int, Int, Int) [function]
    13	  rule rangeLen(LO:Int, HI:Int, ST:Int) => (HI -Int LO +Int ST -Int 1) /Int ST
    14	       requires ST >Int 0 andBool HI >Int LO
    15	  rule rangeLen(LO:Int, HI:Int, ST:Int) => (LO -Int HI -Int ST -Int 1) /Int (0 -Int ST)
    16	       requires ST <Int 0 andBool HI <Int LO
    17	  rule rangeLen(LO:Int, HI:Int, ST:Int) => 0
    18	       requires (ST >Int 0 andBool HI <=Int LO) orBool (ST <Int 0 andBool HI >=Int LO)
    19	
    20	  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int))
    21	        => #iterYield(I, rangeObj(I +Int ST, HI, ST)) ... </k>
    22	       requires inRange(I, HI, ST)
    23	  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int)) => #iterDone ... </k>
    24	       requires notBool inRange(I, HI, ST)
    25	endmodule
     1	// reference/src/semantics/set.k — MPY-SET
     2	
     3	module MPY-SET
     4	  imports MPY-CORE
     5	
     6	  // a set value, carried as its distinct codes in first-seen order (order is irrelevant
     7	  // to membership/cardinality — the two observations sets support here).
     8	  syntax Val ::= setV(IntSeq)
     9	
    10	  // membership of a code in the accumulated distinct-code sequence
    11	  syntax Bool ::= codeIn(Int, IntSeq) [function, total]
    12	  rule codeIn(_:Int, .IntSeq)                => false
    13	  rule codeIn(C:Int, iCons(H:Int, T:IntSeq)) => C ==Int H orBool codeIn(C, T)
    14	
    15	  // the distinct codes of CS (insert-if-absent fold, first-seen order)
    16	  syntax IntSeq ::= dedupCodes(IntSeq)         [function, total]
    17	                  | dedupFrom(IntSeq, IntSeq)  [function, total]
    18	  rule dedupCodes(CS:IntSeq) => dedupFrom(CS, .IntSeq)
    19	  rule dedupFrom(.IntSeq, ACC:IntSeq) => ACC
    20	  rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, ACC)
    21	       requires codeIn(C, ACC)
    22	  rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, snocCode(ACC, C))
    23	       requires notBool codeIn(C, ACC)
    24	
    25	  syntax IntSeq ::= snocCode(IntSeq, Int) [function, total]
    26	  rule snocCode(.IntSeq, C:Int)                => iCons(C, .IntSeq)
    27	  rule snocCode(iCons(H:Int, T:IntSeq), C:Int) => iCons(H, snocCode(T, C))
    28	
    29	  // ==== set equality: two sets are equal iff mutually subsuming ==============
    30	  // subsetCodes(A, B) — every code of A occurs in B (duplicates in A are harmless).
    31	  syntax Bool ::= subsetCodes(IntSeq, IntSeq) [function, total]
    32	  rule subsetCodes(.IntSeq, _:IntSeq)                => true
    33	  rule subsetCodes(iCons(C:Int, S:IntSeq), B:IntSeq) => codeIn(C, B) andBool subsetCodes(S, B)
    34	
    35	  syntax Bool ::= sameSet(IntSeq, IntSeq) [function, total]
    36	  rule sameSet(A:IntSeq, B:IntSeq) => subsetCodes(A, B) andBool subsetCodes(B, A)
    37	
    38	  // set == set  (the only comparison sets support here)
    39	  rule applyCmp("==", setV(A:IntSeq), setV(B:IntSeq)) => sameSet(A, B)
    40	endmodule

diff --git a//tmp/audit-work/126-is-sorted/concrete-audit.py b//tmp/audit-work/126-is-sorted/concrete-audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..28359d95742ed8e6eb1855fc86b05450f34c3399
--- /dev/null
+++ b//tmp/audit-work/126-is-sorted/concrete-audit.py
@@ -0,0 +1,30 @@
+def is_sorted(lst):
+    prev = -1
+    duplicates = 0
+    result = True
+    for value in lst:
+        if isinstance(value, int):
+            if value < prev:
+                result = False
+            if value == prev:
+                duplicates += 1
+            else:
+                duplicates = 0
+            if duplicates > 1:
+                result = False
+            prev = value
+        else:
+            return False
+    return result
+
+
+assert is_sorted([]) == True
+assert is_sorted([0]) == True
+assert is_sorted([0, 0]) == True
+assert is_sorted([0, 0, 0]) == False
+assert is_sorted([0, 1, 2]) == True
+assert is_sorted([1, 0]) == False
+assert is_sorted([0, 1, 0]) == False
+assert is_sorted([0, 0, 1, 1]) == True
+assert is_sorted([0, 0, 1, 1, 1]) == False
+assert is_sorted([9223372036854775807]) == True
diff --git a/evidence/differential_audit.py b/evidence/differential_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..a28efe089199d734a34fe7d3dcc01d912998a9d4
--- /dev/null
+++ b/evidence/differential_audit.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Independent differential audit for HumanEval 126.
+
+Inputs are finite lists of non-negative Python ints.  The exhaustive and
+pseudorandom scopes below are deterministic and part of the evidence.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import random
+from pathlib import Path
+
+
+SCRATCH = Path("/tmp/audit-work/126-is-sorted")
+
+
+def load_entry(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.is_sorted
+
+
+canonical = load_entry("audit_canonical", SCRATCH / "canonical.py")
+generated = load_entry("audit_generated", SCRATCH / "solution.py")
+
+
+DOCUMENTED = [
+    [5],
+    [1, 2, 3, 4, 5],
+    [1, 3, 2, 4, 5],
+    [1, 2, 3, 4, 5, 6],
+    [1, 2, 3, 4, 5, 6, 7],
+    [1, 3, 2, 4, 5, 6, 7],
+    [1, 2, 2, 3, 3, 4],
+    [1, 2, 2, 2, 3, 4],
+]
+
+BOUNDARY_AND_BRANCH = [
+    [],                    # zero loop iterations
+    [0],                   # sentinel lower boundary, comparison/equality false
+    [0, 0],                # equality and increment, duplicate threshold false
+    [0, 0, 0],             # duplicate threshold true
+    [0, 1],                # strict increase
+    [1, 0],                # descent
+    [0, 1, 0],             # late descent
+    [0, 0, 1, 1],          # reset then exactly two of a new value
+    [0, 0, 1, 1, 1],       # reset then triple of a new value
+    [10**100],             # unbounded-integer representative
+    [0, 10**100],
+    [10**100, 0],
+]
+
+
+def compare(case: list[int], label: str, mismatches: list[tuple]):
+    left = canonical(case.copy())
+    right = generated(case.copy())
+    if type(left) is not bool or type(right) is not bool or left != right:
+        mismatches.append((label, case, left, right))
+
+
+def main() -> None:
+    mismatches: list[tuple] = []
+    counts = {"documented": 0, "boundary_branch": 0, "exhaustive": 0, "random": 0}
+
+    for case in DOCUMENTED:
+        compare(case, "documented", mismatches)
+        counts["documented"] += 1
+
+    for case in BOUNDARY_AND_BRANCH:
+        compare(case, "boundary_branch", mismatches)
+        counts["boundary_branch"] += 1
+
+    for length in range(7):
+        for values in itertools.product(range(5), repeat=length):
+            compare(list(values), "exhaustive", mismatches)
+            counts["exhaustive"] += 1
+
+    rng = random.Random(126)
+    atoms = [0, 1, 2, 3, 10, 2**63 - 1, 10**100]
+    for _ in range(5000):
+        case = [rng.choice(atoms) for _ in range(rng.randrange(0, 51))]
+        compare(case, "random", mismatches)
+        counts["random"] += 1
+
+    print("domain=finite lists of non-negative Python ints")
+    print("documented_cases=8")
+    print("boundary_branch_cases=12")
+    print("exhaustive_scope=all lengths 0..6 over values 0..4")
+    print("random_scope=5000 lists; seed=126; lengths 0..50; atoms=0,1,2,3,10,2**63-1,10**100")
+    print(f"counts={counts}")
+    print(f"total_comparisons={sum(counts.values())}")
+    print(f"mismatches={len(mismatches)}")
+    if mismatches:
+        print(f"first_mismatch={mismatches[0]!r}")
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
