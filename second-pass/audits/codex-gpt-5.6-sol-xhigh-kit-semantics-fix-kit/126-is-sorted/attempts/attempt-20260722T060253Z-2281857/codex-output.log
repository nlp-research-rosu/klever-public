requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Number of equal predecessors after consuming VALUE.  The two guards are
  // disjoint and cover all Int triples.
  syntax Int ::= nextDuplicates(Int, Int, Int) [function, total]
  rule nextDuplicates(VALUE, PREV, DUPLICATES) => DUPLICATES +Int 1
    requires VALUE ==Int PREV
  rule nextDuplicates(VALUE, PREV, _DUPLICATES) => 0
    requires VALUE =/=Int PREV

  // Homogeneous symbolic input.  Every concrete IntSeq reduces to the exact
  // ValSeq consumed by the supplied list semantics.
  syntax ValSeq ::= intVals(IntSeq)
  rule intVals(.IntSeq) => .ValSeq
  rule intVals(iCons(I, REST)) => vCons(I, intVals(REST))

  // Expose one symbolic IntSeq constructor to the fixed iterator protocol.
  // This is exactly #iterNext after one intVals equation.
  syntax KItem ::= #intValsNext(IntSeq)
  rule <k> #iterNext(list(intVals(IS))) => #intValsNext(IS) ... </k>
  rule <k> #intValsNext(.IntSeq) => #iterDone ... </k>
  rule <k> #intValsNext(iCons(I, REST))
        => #iterYield(I, list(intVals(REST))) ... </k>

  // Exact result of running the remaining loop from its current locals.
  syntax Bool ::= scanSorted(Bool, Int, Int, IntSeq) [function, total]
  rule scanSorted(RESULT, _PREV, _DUPLICATES, .IntSeq) => RESULT
  rule scanSorted(RESULT, PREV, DUPLICATES, iCons(VALUE, REST))
    => scanSorted(
         RESULT
           andBool notBool (VALUE <Int PREV)
           andBool notBool (nextDuplicates(VALUE, PREV, DUPLICATES) >Int 1),
         VALUE,
         nextDuplicates(VALUE, PREV, DUPLICATES),
         REST)

  // The source contract's formal domain: every list element is a
  // non-negative integer.
  syntax Bool ::= nonNegativeInts(IntSeq) [function, total]
  rule nonNegativeInts(.IntSeq) => true
  rule nonNegativeInts(iCons(I, REST))
    => I >=Int 0 andBool nonNegativeInts(REST)
endmodule

// Entry-proof layer.  The rule below is byte-for-byte the loop claim proved
// against VERIFICATION alone; it is unavailable while that connection theorem
// is established.
module VERIFICATION-ENTRY
  imports VERIFICATION

  rule
    <k>
      #loop(list(intVals(IS)), Name("value"),
        If(Call(Name("isinstance"), Name("value"), Name("int")),
          If(Compare(Name("value"), CmpOp("<", Name("prev"))),
            Assign(Name("result"), Bool(false)),
            .Stmts)
          If(Compare(Name("value"), CmpOp("==", Name("prev"))),
            AugAssign(Name("duplicates"), "+", Int(1)),
            Assign(Name("duplicates"), Int(0)))
          If(Compare(Name("duplicates"), CmpOp(">", Int(1))),
            Assign(Name("result"), Bool(false)),
            .Stmts)
          Assign(Name("prev"), Name("value")),
          Return(Bool(false))))
      ~> (Return(Name("result")) .Stmts) ~> #endcall
      => scanSorted(RESULT, PREV, DUPLICATES, IS)
    </k>
    <env> 1 => 0 </env>
    <scopes>
      0  |-> scope(
        "is_sorted" |-> closureVal(
          "lst", .ParamNames,
          Assign(Name("prev"), UnaryOp("-", Int(1)))
          Assign(Name("duplicates"), Int(0))
          Assign(Name("result"), Bool(true))
          For(Name("value"), Name("lst"),
            If(Call(Name("isinstance"), Name("value"), Name("int")),
              If(Compare(Name("value"), CmpOp("<", Name("prev"))),
                Assign(Name("result"), Bool(false)),
                .Stmts)
              If(Compare(Name("value"), CmpOp("==", Name("prev"))),
                AugAssign(Name("duplicates"), "+", Int(1)),
                Assign(Name("duplicates"), Int(0)))
              If(Compare(Name("duplicates"), CmpOp(">", Int(1))),
                Assign(Name("result"), Bool(false)),
                .Stmts)
              Assign(Name("prev"), Name("value")),
              Return(Bool(false))))
          Return(Name("result")),
          0),
        parent(-1))
      -1 |-> scope(
        "isinstance" |-> builtinV("isinstance")
        "int"        |-> typeV("int")
        BUILTINREST,
        root)
      (1 |-> scope(
        ("lst"        |-> list(intVals(ORIGINAL))
         "value"      |-> OLDVALUE
         "prev"       |-> PREV
         "duplicates" |-> DUPLICATES
         "result"     |-> RESULT),
        parent(0)) => .Map)
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires DUPLICATES >=Int 0
    [priority(40)]
endmodule

