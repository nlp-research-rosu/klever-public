from collections import Counter
from itertools import product

from solution import is_sorted


def oracle(values):
    counts = Counter(values)
    return values == sorted(values) and all(count <= 2 for count in counts.values())


def main():
    checked = 0
    mismatches = []
    for length in range(7):
        for values in product(range(5), repeat=length):
            case = list(values)
            expected = oracle(case)
            actual = is_sorted(case)
            checked += 1
            if actual != expected:
                mismatches.append((case, expected, actual))

    print(f"scope=all lists of length 0..6 over integers 0..4")
    print(f"checked={checked}")
    print(f"mismatches={len(mismatches)}")
    if mismatches:
        print(f"first_mismatch={mismatches[0]}")
        raise SystemExit(1)


if __name__ == "__main__":
    main()
def is_sorted(lst):
    prev = -1
    duplicates = 0
    result = True
    for value in lst:
        if isinstance(value, int):
            if value < prev:
                result = False
            if value == prev:
                duplicates += 1
            else:
                duplicates = 0
            if duplicates > 1:
                result = False
            prev = value
        else:
            return False
    return result


