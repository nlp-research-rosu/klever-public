Module(
  FuncDef("has_close_elements", Params("numbers", "threshold"),
    Assign(Name("i"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("n"), Call(Name("len"), Name("numbers")))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
      While(Compare(Name("j"), CmpOp("<", Name("n"))),
        If(Compare(
          Call(
            Name("abs"),
            BinOp(
              "-",
              Subscript(Name("numbers"), Name("i")),
              Subscript(Name("numbers"), Name("j")))),
          CmpOp("<", Name("threshold"))),
          Return(Bool(true)),
          )
        AugAssign(Name("j"), "+", Int(1)))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Bool(false)))
  Assert(
    Compare(
      Call(Name("abs"), BinOp("-", Float(1.0), Float(1.25))),
      CmpOp("<", Float(0.5))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(1.0), Float(1.25)),
        Float(0.5)),
      CmpOp("==", Bool(true)))))
