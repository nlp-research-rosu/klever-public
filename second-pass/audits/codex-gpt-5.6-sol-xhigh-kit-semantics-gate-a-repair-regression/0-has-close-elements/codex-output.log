     8	def has_close_elements(numbers: List[float], threshold: float) -> bool:
     9	    """ Check if in given list of numbers, are any two numbers closer to each other than
    10	    given threshold.
    11	    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)
    12	    False
    13	    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)
    14	    True
    15	    """
    16	    for idx, elem in enumerate(numbers):
    17	        for idx2, elem2 in enumerate(numbers):
    18	            if idx != idx2:
    19	                distance = abs(elem - elem2)
    20	                if distance < threshold:
    21	                    return True
    22	
    23	    return False
