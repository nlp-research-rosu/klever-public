+assert minPath([[4, 3], [2, 1]], 5) == [1, 2, 1, 2, 1]
+assert minPath([[2, 1], [4, 3]], 6) == [1, 2, 1, 2, 1, 2]
+assert minPath([[3, 4], [1, 2]], 2) == [1, 2]
+assert minPath([[2, 3, 4], [5, 1, 6], [7, 8, 9]], 7) == [1, 3, 1, 3, 1, 3, 1]
