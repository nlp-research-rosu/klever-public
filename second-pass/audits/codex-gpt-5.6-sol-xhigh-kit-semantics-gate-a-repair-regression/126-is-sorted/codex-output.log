+    <k> IS-SORTED-CALL => ?RESULT:Bool </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope("input" |->
+                     list(vCons(0, vCons(1, vCons(2,
+                       vCons(3, .ValSeq))))),
+                   parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("input" |->
+                     list(vCons(0, vCons(1, vCons(2,
+                       vCons(3, .ValSeq)))))
+                   "is_sorted" |-> IS-SORTED-CLOSURE,
+                   parent(-1))
