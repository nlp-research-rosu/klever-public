     1	def is_sorted(lst):
     2	    previous = -1
     3	    repeated = 0
     4	    for number in lst:
     5	        if number < previous:
     6	            return False
     7	        if number == previous:
     8	            repeated += 1
     9	            if repeated > 1:
    10	                return False
    11	        else:
    12	            repeated = 0
    13	        previous = number
    14	    return True
