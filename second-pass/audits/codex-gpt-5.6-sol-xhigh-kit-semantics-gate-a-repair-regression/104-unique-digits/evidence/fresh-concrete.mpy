Module(
  FuncDef("unique_digits", Params("x"),
    Assign(Name("result"), ListExpr())
    Assign(Name("value"), Int(0))
    Assign(Name("number"), Int(0))
    Assign(Name("valid"), Bool(true))
    For(Name("value"), Name("x"),
      Assign(Name("number"), Name("value"))
      Assign(Name("valid"), Bool(true))
      While(Compare(Name("number"), CmpOp(">", Int(0))),
        Assign(
          Name("valid"),
          BoolOp(
            "and",
            Name("valid"),
            Compare(
              BinOp("%", Name("number"), Int(2)),
              CmpOp("==", Int(1)))))
        Assign(Name("number"), BinOp("//", Name("number"), Int(10))))
      If(Name("valid"),
        Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
        ))
    Expr(Call(Attribute(Name("result"), "sort"), ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("unique_digits"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(15), Int(33), Int(1422), Int(1))),
      CmpOp("==", ListExpr(Int(1), Int(15), Int(33)))))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(152), Int(323), Int(1422), Int(10))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(
          Int(2),
          Int(1),
          Int(9),
          Int(12),
          Int(21),
          Int(101),
          Int(135))),
      CmpOp("==", ListExpr(Int(1), Int(9), Int(135)))))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(33), Int(1), Int(33), Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(1), Int(1), Int(33), Int(33)))))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(
          Int(999999999999999999999999999999999999999),
          Int(299999999999999999999999999999999999999),
          Int(999999999999999999999999999999999999998))),
      CmpOp(
        "==",
        ListExpr(Int(999999999999999999999999999999999999999))))))
