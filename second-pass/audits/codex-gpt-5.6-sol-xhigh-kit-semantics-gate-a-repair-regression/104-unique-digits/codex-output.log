+          Name("number"),
+          BinOp("//", Name("number"), Int(10))))
+      => .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+            "x"      |-> list(XS:ValSeq)
+            "result" |-> ref(RH:Int)
+            "value"  |-> W:Val
+            "number" |-> (1 => 0)
+            "valid"  |-> (true => allOddResult(1)),
+            parent(0))
+      ...
+    </scopes>
+endmodule
