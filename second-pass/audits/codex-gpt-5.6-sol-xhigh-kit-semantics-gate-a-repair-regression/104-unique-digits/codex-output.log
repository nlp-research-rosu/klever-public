+                      BinOp("%", Name("number"), Int(2)),
+                      CmpOp("==", Int(1)))))
+                Assign(
+                  Name("number"),
+                  BinOp("//", Name("number"), Int(10))))
+              If(
+                Name("valid"),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("value"))),
+                ))
+            Expr(Call(Attribute(Name("result"), "sort"), ))
+            Return(Name("result")))))
+      => .K
