+    <k>
+      #while(
+        udDigitCondition,
+        Assign(
+          Name("valid"),
+          BoolOp(
+            "and",
+            (Name("valid"),
+             Compare(
+               BinOp("%", Name("number"), Int(2)),
+               CmpOp("==", Int(0))))))
