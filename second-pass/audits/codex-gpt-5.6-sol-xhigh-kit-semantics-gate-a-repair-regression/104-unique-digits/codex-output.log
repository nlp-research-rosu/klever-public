+
+module VERIFICATION
+  imports INT-PROJECTION
+  imports UNIQUE-DIGITS-FRAGMENTS
+
+  // Operational bridge with an exact bridge-free connection theorem:
+  // CONNECTION-SPEC.assign-number-projection.  It performs the same local
+  // assignment after changing only the proof representation of an equal value
+  // from Val to Int; all other state and the continuation are framed.
+  rule <k> Assign(Name("number"), V:Val) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+               "x"      |-> list(XS:ValSeq)
+               "result" |-> ref(H:Int)
+               "value"  |-> W:Val
+               "number" |-> (_OLD:Val => projectIntTotal(V))
+               "valid"  |-> B:Bool,
+               parent(0))
+         ...
+       </scopes>
+       requires V ==K projectIntTotal(V)
+       [priority(40)]
+
+  // Operational bridge justified by the bridge-free universal connection
+  // CONNECTION-SPEC.digit-loop-positive-connection.  The exact positive-input
+  // loop frame, continuation, local writes, and result value are identical.
+  rule <k> #while(udDigitCondition, udDigitBody) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+               "x"      |-> list(XS:ValSeq)
+               "result" |-> ref(RH:Int)
+               "value"  |-> W:Val
+               "number" |-> (N:Int => 0)
+               "valid"  |-> (true => allOddResult(N)),
+               parent(0))
+         ...
+       </scopes>
+       requires N >Int 0
+       [priority(40)]
+
+  // A total projection used only to state that every heterogeneous ValSeq
+  // element is in fact a positive Int.  The equality in positiveIntSeq
+  // excludes every non-Int constructor.
+  syntax Bool ::= positiveIntSeq(ValSeq) [function, total]
+  rule positiveIntSeq(.ValSeq) => true
+  rule positiveIntSeq(vCons(V:Val, REST:ValSeq))
+    => (V ==K projectIntTotal(V))
+       andBool projectIntTotal(V) >Int 0
+       andBool positiveIntSeq(REST)
+
+  // Human-facing predicate and stable filter summary.  The projection equality
+  // rejects every non-Int value; positivity matches the source contract.
+  syntax Bool ::= hasOnlyOddDigits(Val) [function, total]
+  rule hasOnlyOddDigits(V:Val)
+    => (V ==K projectIntTotal(V))
+       andBool projectIntTotal(V) >Int 0
+       andBool allOddResult(projectIntTotal(V))
+
+  syntax ValSeq ::= addIfOdd(ValSeq, Val) [function, total]
+  rule addIfOdd(ACC:ValSeq, V:Val)
+    => valSeqConcat(ACC, vCons(V, .ValSeq))
+    requires hasOnlyOddDigits(V)
+  rule addIfOdd(ACC:ValSeq, V:Val) => ACC
+    requires notBool hasOnlyOddDigits(V)
+
+  syntax ValSeq ::= appendOddDigits(ValSeq, ValSeq) [function, total]
+  rule appendOddDigits(ACC:ValSeq, .ValSeq) => ACC
+  rule appendOddDigits(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => appendOddDigits(addIfOdd(ACC, V), REST)
+
+  syntax ValSeq ::= oddDigitFilter(ValSeq) [function, total]
+  rule oddDigitFilter(VS:ValSeq) => appendOddDigits(.ValSeq, VS)
+endmodule

