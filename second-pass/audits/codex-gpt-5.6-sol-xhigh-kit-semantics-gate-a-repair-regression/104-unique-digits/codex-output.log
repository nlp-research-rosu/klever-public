     1	def unique_digits(x):
     2	    result = []
     3	    value = 0
     4	    number = 0
     5	    valid = True
     6	    for value in x:
     7	        number = value
     8	        valid = True
     9	        while number > 0:
    10	            valid = valid and number % 2 == 1
    11	            number = number // 10
    12	        if valid:
    13	            result.append(value)
    14	    result.sort()
    15	    return result
