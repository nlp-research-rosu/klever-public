+printf 'GROUND_BRIDGE_SUITE_STATUS: %d\n' "$ground_status"
+printf 'ALL_SUITES_STATUS: %d\n' "$overall_status"
+exit "$overall_status"

exec
/bin/bash -lc "/audit-output/evidence/run_logged.sh /audit-output/evidence/toolchain_versions.log bash -lc 'kompile --version; kprove --version; krun --version; python3 --version'" in /audit-output
