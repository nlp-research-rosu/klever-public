+
+  claim [two-false-continuation]:
+    <k>
+      #while(udDigitCondition, udDigitBody)
+      ~> Assign(Name("value"), Int(7))
+      => .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+            "x"      |-> list(XS:ValSeq)
+            "result" |-> ref(RH:Int)
+            "value"  |-> (_W:Val => 7)
+            "number" |-> (2 => 0)
+            "valid"  |-> (true => false),
+            parent(0))
+      ...
