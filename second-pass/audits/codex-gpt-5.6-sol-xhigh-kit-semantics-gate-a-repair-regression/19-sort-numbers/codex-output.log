+              Name("sort_numbers"),
+              str(strToCodes("three one five")))
+      => str(strToCodes("five three one"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    =>
