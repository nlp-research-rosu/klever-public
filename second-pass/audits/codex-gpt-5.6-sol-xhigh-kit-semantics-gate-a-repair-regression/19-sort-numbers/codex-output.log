   142	  syntax Bool ::= eqF(Float, Float) [function, total, symbol(eqF), no-evaluators]
   143	  rule eqF(F1:Float, F2:Float) => F1 ==Float F2 [concrete]
   144	  rule applyCmp("==", I:Int, F:Float) => eqF(intToF(I), F)
   145	  rule applyCmp("==", F:Float, I:Int) => eqF(F, intToF(I))
   146	  rule applyCmp("!=", I:Int, F:Float) => notBool eqF(intToF(I), F)
   147	  rule applyCmp("!=", F:Float, I:Int) => notBool eqF(F, intToF(I))
   148	  rule applyCmp("<",  I:Int, F:Float) => floatLt(intToF(I), F)
   149	  rule applyCmp("<",  F:Float, I:Int) => floatLt(F, intToF(I))
   150	  rule applyCmp(">",  I:Int, F:Float) => gtF(intToF(I), F)
   151	  rule applyCmp(">",  F:Float, I:Int) => gtF(F, intToF(I))
   152	
   153	  // ---- x == None (promoted from 137; `is` cases live in operators.k) ----
   154	  rule applyCmp("==", V:Val, noneV) => V ==K noneV
   155	  rule applyCmp("!=", V:Val, noneV) => notBool (V ==K noneV)
   156	
   157	  // ---- float(str): decimal parse (promoted from 137's defined chain) ----
   158	  // digits '.' digits, optional leading '-'; concrete evaluation only (the
   159	  // symbolic side stays an opaque decStrToF term a proof case-splits on).
   160	  syntax Float ::= decStrToF(IntSeq) [function, total, symbol(decStrToF), no-evaluators]
   161	  rule decStrToF(iCons(45, CS:IntSeq)) => 0.0 -Float decStrToF(CS) [concrete]
   162	  rule decStrToF(CS:IntSeq)
   163	    => intToF(intPart(CS)) +Float (intToF(fracPart(CS)) /Float intToF(fracScale(CS)))
   164	       requires isLen(CS) >Int 0 andBool headIS(CS) =/=Int 45 [concrete]
   165	  syntax Int ::= headIS(IntSeq) [function]
   166	  rule headIS(iCons(C:Int, _:IntSeq)) => C
   167	  syntax Int ::= intPart(IntSeq) [function, total] | intPartAcc(IntSeq, Int) [function, total]
   168	  rule intPart(CS:IntSeq) => intPartAcc(CS, 0)
   169	  rule intPartAcc(.IntSeq, A:Int) => A
   170	  rule intPartAcc(iCons(46, _:IntSeq), A:Int) => A
   171	  rule intPartAcc(iCons(C:Int, R:IntSeq), A:Int) => intPartAcc(R, A *Int 10 +Int (C -Int 48))
   172	       requires C =/=Int 46
   173	  syntax Int ::= fracPart(IntSeq) [function, total] | fracAcc(IntSeq, Int) [function, total]
   174	  rule fracPart(.IntSeq) => 0
   175	  rule fracPart(iCons(46, R:IntSeq)) => fracAcc(R, 0)
   176	  rule fracPart(iCons(C:Int, R:IntSeq)) => fracPart(R) requires C =/=Int 46
   177	  rule fracAcc(.IntSeq, A:Int) => A
   178	  rule fracAcc(iCons(C:Int, R:IntSeq), A:Int) => fracAcc(R, A *Int 10 +Int (C -Int 48))
   179	  syntax Int ::= fracScale(IntSeq) [function, total] | fscAcc(IntSeq, Int) [function, total]
   180	  rule fracScale(.IntSeq) => 1
   181	  rule fracScale(iCons(46, R:IntSeq)) => fscAcc(R, 1)
   182	  rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46
   183	  rule fscAcc(.IntSeq, A:Int) => A
   184	  rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)
   185	  rule applyBuiltin("float", str(CS:IntSeq), .Vals) => decStrToF(CS)
   186	  rule applyBuiltin("float", I:Int, .Vals)          => intToF(I)
   187	  rule applyBuiltin("float", F:Float, .Vals)        => F
   188	
   189	  // ---- float / int division (promoted from mean_absolute_deviation) ----
   190	  syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]
   191	  rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]
   192	  rule applyBin("/", F:Float, I:Int) => divFloatIntV(F, I)
   193	
   194	  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----
   195	  syntax Float ::= intToF(Int) [function, total, symbol(intToF), no-evaluators]
   196	  rule intToF(I:Int) => Int2Float(I, 53, 11) [concrete]
   197	  rule applyBin("+", I:Int, F:Float) => addF(intToF(I), F)
   198	  rule applyBin("+", F:Float, I:Int) => addF(F, intToF(I))
   199	  rule applyBin("-", I:Int, F:Float) => subF(intToF(I), F)
   200	  rule applyBin("-", F:Float, I:Int) => subF(F, intToF(I))
   201	  rule applyBin("*", I:Int, F:Float) => mulF(intToF(I), F)
   202	  rule applyBin("*", F:Float, I:Int) => mulF(F, intToF(I))
   203	  rule applyCmp("<", I:Int, F:Float) => floatLt(intToF(I), F)
   204	  rule applyCmp("<", F:Float, I:Int) => floatLt(F, intToF(I))
   205	  rule applyCmp(">", I:Int, F:Float) => gtF(intToF(I), F)
   206	  rule applyCmp(">", F:Float, I:Int) => gtF(F, intToF(I))
   207	
   208	  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----
   209	  syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]
   210	  rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]
   211	  rule applyBuiltin("int", F:Float, .Vals) => truncF(F)
   212	
   213	  rule applyBuiltin("float", I:Int, .Vals)   => intToF(I)
   214	  rule applyBuiltin("float", F:Float, .Vals) => F
   215	
   216	  // round: Python half-even (banker's); round(F, N) scales by 10^N
   217	  syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]
   218	  rule roundF(F:Float)
   219	    => #if (F -Float floorFloat(F)) ==Float 0.5
   220	       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
   221	              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
   222	       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
   223	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   224	  rule roundFN(F:Float, N:Int)
   225	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   226	       /Float Int2Float(10 ^Int N, 53, 11) [concrete]
   227	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   228	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   229	
   230	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   231	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   232	  syntax KItem ::= "#mathSqrt"
   233	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   234	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   235	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   236	
   237	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   238	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   239	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   240	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   241	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   242	  // the isFloat guard is disjoint from the existing isInt one.
   243	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   244	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   245	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   246	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   247	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   248	       requires isFloat(V)
   249	
   250	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   251	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   252	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   253	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   254	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   255	       requires isFloat(V)
   256	
   257	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   258	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   259	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   260	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   261	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   262	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   263	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   264	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   265	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   266	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   267	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   268	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   269	       requires isFloat(V)
   270	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   271	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   272	       requires isInt(V) orBool isBool(V)
   273	endmodule

diff --git a/evidence/audit-pinning-spec.k b/evidence/audit-pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7c6482be0aecf9102e9ff7baaa9657b198a004f0
--- /dev/null
+++ b/evidence/audit-pinning-spec.k
@@ -0,0 +1,53 @@
+requires "verification.k"
+
+module AUDIT-PINNING-SPEC
+  imports VERIFICATION
+
+  // The RHS is the trusted-translator output in regenerated-solution.mpy.
+  // This auxiliary claim checks that the term used by the entry claim unfolds
+  // to that exact submitted program AST.
+  claim [exact-module]:
+    <k>
+      solutionModule()
+      =>
+      Module(
+      FuncDef("_number_value", Params("number"),
+        If(Compare(Name("number"), CmpOp("==", Str("zero"))),
+          Return(Int(0)),
+          .Stmts)
+        If(Compare(Name("number"), CmpOp("==", Str("one"))),
+          Return(Int(1)),
+          .Stmts)
+        If(Compare(Name("number"), CmpOp("==", Str("two"))),
+          Return(Int(2)),
+          .Stmts)
+        If(Compare(Name("number"), CmpOp("==", Str("three"))),
+          Return(Int(3)),
+          .Stmts)
+        If(Compare(Name("number"), CmpOp("==", Str("four"))),
+          Return(Int(4)),
+          .Stmts)
+        If(Compare(Name("number"), CmpOp("==", Str("five"))),
+          Return(Int(5)),
+          .Stmts)
+        If(Compare(Name("number"), CmpOp("==", Str("six"))),
+          Return(Int(6)),
+          .Stmts)
+        If(Compare(Name("number"), CmpOp("==", Str("seven"))),
+          Return(Int(7)),
+          .Stmts)
+        If(Compare(Name("number"), CmpOp("==", Str("eight"))),
+          Return(Int(8)),
+          .Stmts)
+        Return(Int(9)) .Stmts)
+      FuncDef("sort_numbers", Params("numbers"),
+        Return(
+          Call(
+            Attribute(Str(" "), "join"),
+            Call(
+              Name("sorted"),
+              Call(Attribute(Name("numbers"), "split"), .Exprs),
+              KwArg("key", Name("_number_value")))))
+        .Stmts))
+    </k>
+endmodule
diff --git a/evidence/audit-vacuity-spec.k b/evidence/audit-vacuity-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..942f72ae4ce11bf72e8ca4870ad448faa2a5bd61
--- /dev/null
+++ b/evidence/audit-vacuity-spec.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module AUDIT-VACUITY-SPEC
+  imports VERIFICATION
+
+  // Fresh false result mutation.  "three one five" satisfies the original
+  // domain, while both Python implementations and concrete K return
+  // "one three five", not the reversed string below.
+  claim [wrong-ground-result]:
+    <k> #loadAll(solutionModule())
+         ~> Call(
+              Name("sort_numbers"),
+              str(strToCodes("three one five")))
+      => str(strToCodes("five three one"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    =>
+      solutionScopes()
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      (0 |-> list(
+                splitWS(
+                  strToCodes("three one five"),
+                  .IntSeq,
+                  .ValSeq))
+       1 |-> list(
+                sortKeyVS(
+                  splitWS(
+                    strToCodes("three one five"),
+                    .IntSeq,
+                    .ValSeq),
+                  numberValueClosure())))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validNumberInput(strToCodes("three one five"))
+endmodule
diff --git a/evidence/build_rule_inventory.sh b/evidence/build_rule_inventory.sh
new file mode 100644
index 0000000000000000000000000000000000000000..acca879540ac4604005533ca041e181dd2e31eb2
--- /dev/null
+++ b/evidence/build_rule_inventory.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+root=${1:-/tmp/audit-work/reconstruction}
+mapfile -t files < <(
+  {
+    printf '%s\n' "$root/reference-semantics/semantics.k"
+    find "$root/reference-semantics/semantics" -maxdepth 1 -type f -name '*.k' -print
+    printf '%s\n' "$root/verification.k" "$root/spec.k"
+  } | sort
+)
+
+printf 'INVENTORY_ROOT %s\n' "$root"
+printf 'SOURCE_FILE_COUNT %d\n' "${#files[@]}"
+for file in "${files[@]}"; do
+  rel=${file#"$root/"}
+  printf '\nSOURCE %s\n' "$rel"
+  sha256sum "$file"
+  awk '
+    /^[[:space:]]*(configuration|syntax|context|rule|claim|alias)([[:space:]]|$)/ {
+      kind=$1
+      count[kind]++
+      line=$0
+      sub(/^[[:space:]]+/, "", line)
+      printf "DECL\t%d\t%s\n", NR, line
+    }
+    END {
+      printf "COUNTS"
+      printf "\tconfiguration=%d", count["configuration"] + 0
+      printf "\tsyntax=%d", count["syntax"] + 0
+      printf "\tcontext=%d", count["context"] + 0
+      printf "\trule=%d", count["rule"] + 0
+      printf "\tclaim=%d", count["claim"] + 0
+      printf "\talias=%d\n", count["alias"] + 0
+    }
+  ' "$file"
+  rg -n \
+    'function|functional|total|symbol|no-evaluators|priority\(|simplification|concrete|owise|strict|macro' \
+    "$file" | sed 's/^/ATTRIBUTE\t/' || true
+done
diff --git a/evidence/differential_check.py b/evidence/differential_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..d1cce0bee722a0cdc4834097f5749c696f847772
--- /dev/null
+++ b/evidence/differential_check.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Independent differential audit for HumanEval 19.
+
+The trusted canonical module and candidate solution are loaded from explicit
+paths under distinct module names.  Inputs contain only the ten documented
+number words and ASCII space delimiters, including empty and repeated-space
+boundaries.  The generated sample uses a fixed seed.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import json
+import random
+import sys
+from pathlib import Path
+from types import ModuleType
+
+WORDS = (
+    "zero",
+    "one",
+    "two",
+    "three",
+    "four",
+    "five",
+    "six",
+    "seven",
+    "eight",
+    "nine",
+)
+
+
+def load_module(name: str, path: Path) -> ModuleType:
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def outcome(module: ModuleType, value: str) -> dict[str, str]:
+    try:
+        return {"kind": "return", "value": module.sort_numbers(value)}
+    except Exception as exc:  # Included so any behavioral divergence is visible.
+        return {"kind": "exception", "value": f"{type(exc).__name__}: {exc}"}
+
+
+def main() -> int:
+    if len(sys.argv) != 3:
+        print("usage: differential_check.py TRUSTED_CANONICAL CANDIDATE_SOLUTION")
+        return 64
+
+    canonical = load_module("trusted_canonical", Path(sys.argv[1]))
+    candidate = load_module("candidate_solution", Path(sys.argv[2]))
+
+    labeled: list[tuple[str, str]] = [
+        ("documented-example", "three one five"),
+        ("empty", ""),
+        ("one-space", " "),
+        ("many-spaces", "     "),
+        ("leading-trailing", "  three one five  "),
+        ("repeated-delimiters", "nine  zero   five"),
+        ("ascending-all", " ".join(WORDS)),
+        ("descending-all", " ".join(reversed(WORDS))),
+        ("duplicate-low", "zero zero zero"),
+        ("duplicate-high", "nine nine nine"),
+        ("alternating-extremes", "nine zero nine zero nine zero"),
+        ("every-helper-branch", " ".join(reversed(WORDS + WORDS))),
+    ]
+
+    # Exhaustive token tuples of lengths 0, 1, and 2 cover every helper branch
+    # alone and in every ordered pair.
+    for length in range(3):
+        for index, tokens in enumerate(itertools.product(WORDS, repeat=length)):
+            labeled.append((f"exhaustive-len-{length}-{index}", " ".join(tokens)))
+
+    rng = random.Random(190019)
+    for index in range(256):
+        length = rng.randint(3, 16)
+        tokens = [rng.choice(WORDS) for _ in range(length)]
+        # Generated inputs remain in the intended space-delimited domain, with
+        # occasional extra ASCII spaces that the canonical implementation
+        # explicitly removes.
+        delimiter = " " * rng.randint(1, 4)
+        prefix = " " * rng.randint(0, 2)
+        suffix = " " * rng.randint(0, 2)
+        labeled.append((f"generated-{index}", prefix + delimiter.join(tokens) + suffix))
+
+    seen: set[str] = set()
+    cases: list[tuple[str, str]] = []
+    for label, value in labeled:
+        if value not in seen:
+            seen.add(value)
+            cases.append((label, value))
+
+    mismatches = 0
+    print(
+        json.dumps(
+            {
+                "oracle": str(Path(sys.argv[1]).resolve()),
+                "candidate": str(Path(sys.argv[2]).resolve()),
+                "seed": 190019,
+                "case_count": len(cases),
+                "domain": "ten documented words separated by zero or more ASCII spaces",
+            },
+            sort_keys=True,
+        )
+    )
+    for index, (label, value) in enumerate(cases):
+        expected = outcome(canonical, value)
+        actual = outcome(candidate, value)
+        matched = expected == actual
+        mismatches += int(not matched)
+        print(
+            json.dumps(
+                {
+                    "actual": actual,
+                    "expected": expected,
+                    "index": index,
+                    "input": value,
+                    "label": label,
+                    "match": matched,
+                },
+                ensure_ascii=True,
+                sort_keys=True,
+            )
+        )
+
+    print(json.dumps({"mismatches": mismatches, "tested": len(cases)}, sort_keys=True))
+    return int(mismatches != 0)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/make_k_concrete_tests.py b/evidence/make_k_concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..b5813b45bf040f365b79b7c546fb4b0b7291c769
--- /dev/null
+++ b/evidence/make_k_concrete_tests.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Append concrete assertions to an exact copy of solution.py on stdout."""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+TESTS = (
+    ("three one five", "one three five"),
+    ("", ""),
+    (" ", ""),
+    ("  three one five  ", "one three five"),
+    ("nine  zero   five", "zero five nine"),
+    (
+        "nine eight seven six five four three two one zero",
+        "zero one two three four five six seven eight nine",
+    ),
+    ("nine zero nine zero nine zero", "zero zero zero nine nine nine"),
+)
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        print("usage: make_k_concrete_tests.py SOLUTION.py", file=sys.stderr)
+        return 64
+    source = Path(sys.argv[1]).read_text(encoding="utf-8")
+    sys.stdout.write(source)
+    if not source.endswith("\n"):
+        sys.stdout.write("\n")
+    sys.stdout.write("\n")
+    for value, expected in TESTS:
+        sys.stdout.write(f"assert sort_numbers({value!r}) == {expected!r}\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/record-command.sh b/evidence/record-command.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b20d61b29f8440fec1f255d2bf9b9d230122b85f
--- /dev/null
+++ b/evidence/record-command.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG_PATH COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
