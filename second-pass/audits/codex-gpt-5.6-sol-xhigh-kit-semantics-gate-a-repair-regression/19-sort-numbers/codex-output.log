+module VERIFICATION-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: return the input unchanged instead of sorting it.
+  syntax Stmts ::= mutantSortNumbersBody() [function, total]
+  rule mutantSortNumbersBody()
+    => Return(Name("numbers")) .Stmts
+
+  syntax Val ::= mutantSortNumbersClosure() [function, total]
+  rule mutantSortNumbersClosure()
+    => closureVal(
+         ("numbers", .ParamNames),
+         mutantSortNumbersBody(),
+         0)
+
+  syntax Module ::= mutantSolutionModule() [function, total]
+  rule mutantSolutionModule()
+    => Module(
+         FuncDef("_number_value", Params("number"), numberValueBody())
+         FuncDef(
+           "sort_numbers",
+           Params("numbers"),
+           mutantSortNumbersBody()))
+
+  syntax Map ::= mutantSolutionScopes() [function, total]
+  rule mutantSolutionScopes()
+    => (0 |-> scope(
+              .Map
+                [ "_number_value" <- numberValueClosure() ]
+                [ "sort_numbers" <- mutantSortNumbersClosure() ],
+              parent(-1))
+        -1 |-> builtinsScope)
+endmodule
