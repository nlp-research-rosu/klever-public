     1	def valid_date(date):
     2	    if len(date) != 10:
     3	        return False
     4	    if date[2] != "-" or date[5] != "-":
     5	        return False
     6	
     7	    c0 = ord(date[0])
     8	    c1 = ord(date[1])
     9	    c3 = ord(date[3])
    10	    c4 = ord(date[4])
    11	    c6 = ord(date[6])
    12	    c7 = ord(date[7])
    13	    c8 = ord(date[8])
    14	    c9 = ord(date[9])
    15	
    16	    if (
    17	        c0 < 48 or c0 > 57 or c1 < 48 or c1 > 57
    18	        or c3 < 48 or c3 > 57 or c4 < 48 or c4 > 57
    19	        or c6 < 48 or c6 > 57 or c7 < 48 or c7 > 57
    20	        or c8 < 48 or c8 > 57 or c9 < 48 or c9 > 57
    21	    ):
    22	        return False
    23	
    24	    month = (c0 - 48) * 10 + c1 - 48
    25	    day = (c3 - 48) * 10 + c4 - 48
    26	
    27	    if month < 1 or month > 12 or day < 1:
    28	        return False
    29	    if month == 2:
    30	        return day <= 29
    31	    if month == 4 or month == 6 or month == 9 or month == 11:
    32	        return day <= 30
    33	    return day <= 31
