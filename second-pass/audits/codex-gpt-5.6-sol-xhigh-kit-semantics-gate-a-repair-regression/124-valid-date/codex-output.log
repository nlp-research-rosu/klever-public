    18	       [priority(40)]
    19	
    20	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
    21	       <env> L:Int </env>
    22	       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
    23	       requires X in_keys(M)
    24	  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
    25	  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
    26	  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
    27	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
    28	       <env> L:Int </env>
    29	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    30	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    31	       [priority(40)]
    32	
    33	  // ==== import trivia: `from math import floor, ceil` binds the supported
    34	  // names as builtins in the current scope; every other import is a no-op
    35	  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
    36	  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
    37	  syntax KItem ::= #bindImports(ParamNames)
    38	  rule <k> #bindImports(.ParamNames) => .K ... </k>
    39	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    40	       <env> L:Int </env>
    41	       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
    42	       requires N ==String "floor" orBool N ==String "ceil"
    43	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    44	       requires notBool (N ==String "floor" orBool N ==String "ceil")
    45	
    46	  // ==== Expr statement: evaluate for effect, discard the value ===============
    47	  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
    48	  rule <k> Expr(_:Val) => .K ... </k>
    49	
    50	  // ==== If (condition evaluated by strictness) ==============================
    51	  syntax KItem ::= #branch(Bool, Stmts, Stmts)
    52	  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
    53	  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
    54	  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
    55	
    56	  // ==== IfExp: ternary T if C else E ========================================
    57	  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
    58	       requires truthy(V)
    59	  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
    60	       requires notBool truthy(V)
    61	
    62	  // ==== For: one loop, in-cell continuation, over #iterNext =================
    63	  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
    64	  // circularities anchor on #loop and narrowing substitutes the structure)
    65	  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
    66	                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
    67	                 | #loopLbl(K) | "#cont" | "#brk"
    68	
    69	  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
    70	
    71	  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
    72	  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
    73	  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
    74	        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
    75	
    76	  // ==== While ==============================================================
    77	  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
    78	  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
    79	  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
    80	       requires truthy(V)
    81	  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
    82	       requires notBool truthy(V)
    83	
    84	  // ==== loop control (break / continue) =====================================
    85	  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
    86	  rule <k> Continue => #cont ... </k>
    87	  rule <k> Break => #brk ... </k>
    88	  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
    89	  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
    90	  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
    91	  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
    92	
    93	  // ==== heap-object deref at the truthiness/iteration consumers ==============
    94	  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
    95	  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
    96	       <heap> ... H |-> V:Val ... </heap>
    97	       [priority(40)]
    98	  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
    99	       <heap> ... H |-> V:Val ... </heap>
   100	       [priority(40)]
   101	  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
   102	       <heap> ... H |-> V:Val ... </heap>
   103	       [priority(40)]
   104	  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
   105	  // mutating the iterated list inside its own loop is outside the subset)
   106	  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
   107	       <heap> ... H |-> V:Val ... </heap>
   108	       [priority(40)]
   109	endmodule

BOOL
     1	// reference/src/semantics/bool.k — MPY-BOOL
     2	// Bool operator cases + the truthy boolean operations (not / and / or; and-or are
     3	// value-returning short-circuit over any Vals, per Python).
     4	
     5	module MPY-BOOL
     6	  imports MPY-CORE
     7	
     8	  rule applyUn("not", V:Val) => notBool truthy(V)
     9	
    10	  rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
    11	  rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2
    12	
    13	  // ==== BoolOp: short-circuit, value-returning and / or =====================
    14	  // the node is its own accumulator: heat the HEAD element only, then either return it
    15	  // (short-circuit) or drop it and continue
    16	  context BoolOp(_, (HOLE:Expr, _:Exprs))
    17	  rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
    18	  rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    19	       requires truthy(V)
    20	  rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
    21	       requires notBool truthy(V)
    22	  rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
    23	       requires truthy(V)
    24	  rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    25	       requires notBool truthy(V)
    26	
    27	  // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
    28	  // operand — and/or return the OBJECT itself (Python identity), not its structure
    29	  rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
    30	       [priority(40)]
    31	  rule <k> BoolOp("and", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       requires truthy(V)
    34	       [priority(40)]
    35	  rule <k> BoolOp("and", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    36	       <heap> ... H |-> V:Val ... </heap>
    37	       requires notBool truthy(V)
    38	       [priority(40)]
    39	  rule <k> BoolOp("or", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    40	       <heap> ... H |-> V:Val ... </heap>
    41	       requires truthy(V)
    42	       [priority(40)]
    43	  rule <k> BoolOp("or", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    44	       <heap> ... H |-> V:Val ... </heap>
    45	       requires notBool truthy(V)
    46	       [priority(40)]
    47	endmodule

OPERATORS
     1	// reference/src/semantics/operators.k — MPY-OPERATORS
     2	// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
     3	// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
     4	// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
     5	
     6	module MPY-OPERATORS
     7	  imports MPY-CORE
     8	  imports MPY-ITER
     9	
    10	  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
    11	
    12	  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
    13	
    14	  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
    15	  context Compare(HOLE, _)
    16	  context Compare(_:Val, CmpOp(_, HOLE))
    17	  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
    18	
    19	  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
    20	  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
    21	
    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule

BUILTINS 1-190
     1	// reference/src/semantics/builtins.k — MPY-BUILTINS
     2	
     3	module MPY-BUILTINS
     4	  imports MPY-CORE
     5	  imports MPY-STR
     6	  imports MPY-SET
     7	  imports MPY-ITER
     8	  imports MPY-RANGE
     9	  imports MPY-INT
    10	  imports MPY-METHODS
    11	
    12	  // the builtins REGISTRY is core.k's builtinsScope (the -1 frame); names resolve by lookup
    13	
    14	  // Call routing + argument evaluation live in call.k, which also routes the fold
    15	  // builtins (sum/all/any/max/min) to the #_Acc folds below and everything else to
    16	  // applyBuiltin. This module owns applyBuiltin + the fold implementations.
    17	  syntax Val ::= applyBuiltin(String, Vals) [function]
    18	
    19	  // ==== len(obj) — O(1) per kind ============================================
    20	  syntax Int ::= seqLen(Val) [function]
    21	  rule applyBuiltin("len", OBJ:Val, .Vals) => seqLen(OBJ)
    22	  rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
    23	  rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
    24	  rule seqLen(str(IS:IntSeq))                   => isLen(IS)
    25	  rule seqLen(setV(DS:IntSeq))                  => isLen(DS)
    26	  rule seqLen(rangeObj(LO:Int, HI:Int, ST:Int)) => rangeLen(LO, HI, ST)
    27	
    28	  // ==== list(seq) — materialize a list/tuple into a list (e.g. list(d.keys())) ==
    29	  // Minimal: the "copy a sequence" case (list of a list is itself; list of a tuple keeps order).
    30	  // list() of other iterables (str/range/set/zip) is added via the iterator fold when needed.
    31	  // (k-cell — list() constructs a NEW object)
    32	  rule <k> #applyK(toCall(builtinV("list")), (list(VS:ValSeq),  .Vals)) => #alloc(list(VS)) ... </k>
    33	  rule <k> #applyK(toCall(builtinV("list")), (tuple(VS:ValSeq), .Vals)) => #alloc(list(VS)) ... </k>
    34	  rule <k> #applyK(toCall(builtinV("list")), .Vals)                     => #alloc(list(.ValSeq)) ... </k>
    35	  rule <k> #applyK(toCall(builtinV("list")), (str(CS:IntSeq), .Vals))   => #alloc(list(charsOf(CS))) ... </k>
    36	  syntax ValSeq ::= charsOf(IntSeq) [function, total]
    37	  rule charsOf(.IntSeq)                => .ValSeq
    38	  rule charsOf(iCons(C:Int, R:IntSeq)) => vCons(str(iCons(C, .IntSeq)), charsOf(R))
    39	
    40	  // ==== set(str) — distinct character codes =================================
    41	  rule applyBuiltin("set", str(CS:IntSeq), .Vals) => setV(dedupCodes(CS))
    42	
    43	  // ==== abs(int) ============================================================
    44	  rule applyBuiltin("abs", I:Int, .Vals) => absInt(I)
    45	
    46	  // ==== sum(iterable) — one #iterNext fold; intOf = int value of an int/bool ==
    47	  syntax KItem ::= #sumAcc(Iterable, Int) | #sumCont(Int)
    48	  rule <k> #sumAcc(IT:Iterable, ACC:Int) => #iterNext(IT) ~> #sumCont(ACC) ... </k>
    49	  rule <k> #iterDone ~> #sumCont(ACC:Int) => ACC ... </k>
    50	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
    51	        => #sumAcc(R, ACC +Int intOf(V)) ... </k>
    52	       requires isInt(V) orBool isBool(V)
    53	
    54	  syntax Int ::= intOf(Val) [function]
    55	  rule intOf(I:Int)  => I
    56	  rule intOf(B:Bool) => #if B #then 1 #else 0 #fi
    57	
    58	  // ==== all / any (short-circuiting #iterNext folds) ========================
    59	  syntax KItem ::= #allAcc(Iterable) | "#allCont"
    60	  rule <k> #allAcc(IT:Iterable) => #iterNext(IT) ~> #allCont ... </k>
    61	  rule <k> #iterDone ~> #allCont => true ... </k>
    62	  rule <k> #iterYield(V:Val, R:Iterable) ~> #allCont => #allAcc(R) ... </k>
    63	       requires truthy(V)
    64	  rule <k> #iterYield(V:Val, _:Iterable) ~> #allCont => false ... </k>
    65	       requires notBool truthy(V)
    66	
    67	  syntax KItem ::= #anyAcc(Iterable) | "#anyCont"
    68	  rule <k> #anyAcc(IT:Iterable) => #iterNext(IT) ~> #anyCont ... </k>
    69	  rule <k> #iterDone ~> #anyCont => false ... </k>
    70	  rule <k> #iterYield(V:Val, _:Iterable) ~> #anyCont => true ... </k>
    71	       requires truthy(V)
    72	  rule <k> #iterYield(V:Val, R:Iterable) ~> #anyCont => #anyAcc(R) ... </k>
    73	       requires notBool truthy(V)
    74	
    75	  // ==== max / min over an iterable (#iterNext folds; first element seeds) ====
    76	  syntax KItem ::= #maxAcc0(Iterable) | "#maxCont0" | #maxAcc(Iterable, Int) | #maxCont(Int)
    77	  rule <k> #maxAcc0(IT:Iterable) => #iterNext(IT) ~> #maxCont0 ... </k>
    78	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAcc(R, {V}:>Int) ... </k>
    79	       requires isInt(V)
    80	  rule <k> #maxAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #maxCont(M) ... </k>
    81	  rule <k> #iterDone ~> #maxCont(M:Int) => M ... </k>
    82	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)
    83	        => #maxAcc(R, maxInt(M, {V}:>Int)) ... </k>
    84	       requires isInt(V)
    85	
    86	  syntax KItem ::= #minAcc0(Iterable) | "#minCont0" | #minAcc(Iterable, Int) | #minCont(Int)
    87	  rule <k> #minAcc0(IT:Iterable) => #iterNext(IT) ~> #minCont0 ... </k>
    88	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAcc(R, {V}:>Int) ... </k>
    89	       requires isInt(V)
    90	  rule <k> #minAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #minCont(M) ... </k>
    91	  rule <k> #iterDone ~> #minCont(M:Int) => M ... </k>
    92	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)
    93	        => #minAcc(R, minInt(M, {V}:>Int)) ... </k>
    94	       requires isInt(V)
    95	
    96	  // ==== variadic max / min (a Vals fold) ====================================
    97	  syntax Int ::= maxVals(Int, Vals) [function]
    98	  rule applyBuiltin("max", I:Int, REST:Vals) => maxVals(I, REST)
    99	  rule maxVals(M:Int, .Vals)           => M
   100	  rule maxVals(M:Int, (I:Int, R:Vals)) => maxVals(maxInt(M, I), R)
   101	
   102	  syntax Int ::= minVals(Int, Vals) [function]
   103	  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
   104	  rule minVals(M:Int, .Vals)           => M
   105	  rule minVals(M:Int, (I:Int, R:Vals)) => minVals(minInt(M, I), R)
   106	
   107	  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
   108	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   109	       requires N >=Int 0
   110	  // negative operand: the '-' sign prefixes the magnitude's digits
   111	  rule applyBuiltin("bin", N:Int, .Vals)
   112	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   113	       requires N <Int 0
   114	  syntax IntSeq ::= binCodes(Int) [function, total]
   115	  rule binCodes(0) => iCons(48, .IntSeq)
   116	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   117	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   118	  rule binAcc(0, ACC:IntSeq) => ACC
   119	  rule binAcc(N:Int, ACC:IntSeq)
   120	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   121	       requires N >Int 0
   122	
   123	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   124	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   125	        => #alloc(list(enumVS(VS, 0))) ... </k>
   126	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   127	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   128	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   129	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   130	
   131	  // ==== map(str, xs) — eager (only the str case is in the subset) =============
   132	  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
   133	        => #alloc(list(mapStrVS(VS))) ... </k>
   134	  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
   135	  rule mapStrVS(.ValSeq) => .ValSeq
   136	  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
   137	  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
   138	
   139	  // ==== int(x) identities (int(round(x)) composes through) ====================
   140	  rule applyBuiltin("int", I:Int, .Vals) => I
   141	
   142	  // ==== ord / chr ===========================================================
   143	  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
   144	  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
   145	       requires 0 <=Int I andBool I <Int 128
   146	
   147	  // ==== str(int) / str(str) =================================================
   148	  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
   149	  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
   150	
   151	  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
   152	  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
   153	       requires 48 <=Int C andBool C <=Int 57
   154	
   155	  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
   156	  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
   157	       requires isLen(CS) >=Int 2
   158	  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
   159	  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
   160	  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
   161	
   162	  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
   163	  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
   164	  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
   165	
   166	  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
   167	  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
   168	        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
   169	  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
   170	  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
   171	  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
   172	        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
   173	  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
   174	  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>
   175	
   176	  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
   177	  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
   178	  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
   179	  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
   180	       requires S =/=Int 0
   181	
   182	  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
   183	  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
   184	  // trusted pass evaluator, now DEFINED in the reference and driven by a
   185	  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
   186	  // argument leaves the call unevaluated for problem-level folds.
   187	  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
   188	  syntax Int ::= evalArith(IntSeq) [function]
   189	  rule evalArith(CS:IntSeq)
   190	    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))

SUBSCRIPT 1-75
     1	// reference/src/semantics/subscript.k — MPY-SUBSCRIPT
     2	
     3	module MPY-SUBSCRIPT
     4	  imports MPY-CORE
     5	
     6	  // ==== positional access + negative-index normalization (used only here) ===
     7	  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
     8	  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
     9	  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
    10	  // atK. K trusts the [total] annotation; valid programs index in-bounds.
    11	  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
    12	  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
    13	  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
    14	       requires I >Int 0
    15	
    16	  syntax Int ::= intSeqAt(IntSeq, Int) [function]
    17	  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C
    18	  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
    19	       requires I >Int 0
    20	
    21	  syntax Int ::= normIdx(Int, Int) [function, total]
    22	  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
    23	  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0
    24	
    25	  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================
    26	  // contexts (not strict attrs): the Index slot's Slice alternative must never heat
    27	  context Subscript(HOLE, _)
    28	  context Subscript(_:Val, HOLE:Expr)
    29	
    30	  // heap-object deref (covers both the index and slice forms via the Index slot)
    31	  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       [priority(40)]
    34	
    35	  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>
    36	
    37	  syntax Val ::= applyIndex(Val, Int) [function]
    38	  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    39	  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    40	  rule applyIndex(str(IS:IntSeq),   I:Int)
    41	    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))
    42	
    43	  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
    44	  syntax KItem ::= #evalB(Bound) | "#toSome"
    45	                 | #slLo(Val, Bound, Bound)
    46	                 | #slHi(Val, OptInt, Bound)
    47	                 | #slStep(Val, OptInt, OptInt)
    48	
    49	  syntax OptInt ::= "noB" | someB(Int)
    50	  rule <k> #evalB(NoBound)  => noB ... </k>
    51	  rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>
    52	  rule <k> I:Int ~> #toSome => someB(I) ... </k>
    53	
    54	  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>
    55	  rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>
    56	  rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>
    57	  // a list slice constructs a NEW object; a str slice stays a value
    58	  rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)
    59	        => #alloc(doSlice(list(VS), LO, HI, ST)) ... </k>
    60	       [priority(45)]
    61	  rule <k> ST:OptInt ~> #slStep(OBJ:Val, LO:OptInt, HI:OptInt) => doSlice(OBJ, LO, HI, ST) ... </k>
    62	
    63	  syntax Val ::= doSlice(Val, OptInt, OptInt, OptInt) [function]
    64	  rule doSlice(list(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    65	    => list(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
    66	  rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    67	    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
    68	  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    69	    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))
    70	
    71	  // ==== slice.indices: step / start / stop / clamp ==========================
    72	  syntax Int ::= slStep(OptInt) [function, total]
    73	  rule slStep(noB)          => 1
    74	  rule slStep(someB(S:Int)) => S
    75	

diff --git a/evidence/compare_program_surface.py b/evidence/compare_program_surface.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd6f96623dc2f03587a5b6711913ef088a1dafbf
--- /dev/null
+++ b/evidence/compare_program_surface.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Compare submitted MPY text with the embedded K RHS at token level.
+
+The program parser permits omitted empty list tails, while K rules spell those
+tails as `.Stmts` or `.Exprs`. This comparator removes only those two explicit
+empty-tail tokens and requires all remaining tokens to be identical.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+from pathlib import Path
+
+
+TOKEN = re.compile(
+    r'"(?:\\.|[^"\\])*"'          # quoted K string token
+    r"|(?:\.Stmts|\.Exprs)"       # only explicit empty tails we may erase
+    r"|(?:[A-Za-z_][A-Za-z_0-9]*)"
+    r"|(?:-?[0-9]+)"
+    r"|(?:\S)"
+)
+
+
+def tokens(text: str) -> list[str]:
+    return TOKEN.findall(text)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("submitted", type=Path)
+    parser.add_argument("embedded", type=Path)
+    args = parser.parse_args()
+
+    submitted_tokens = tokens(args.submitted.read_text(encoding="utf-8"))
+    embedded_tokens_raw = tokens(args.embedded.read_text(encoding="utf-8"))
+    erased = [token for token in embedded_tokens_raw if token in (".Stmts", ".Exprs")]
+    embedded_tokens = [
+        token for token in embedded_tokens_raw if token not in (".Stmts", ".Exprs")
+    ]
+
+    equal = submitted_tokens == embedded_tokens
+    print(f"submitted_tokens={len(submitted_tokens)}")
+    print(f"embedded_tokens_before_empty_tail_erasure={len(embedded_tokens_raw)}")
+    print(f"erased_explicit_empty_tails={len(erased)}")
+    print(f"erased_Stmts={erased.count('.Stmts')}")
+    print(f"erased_Exprs={erased.count('.Exprs')}")
+    print(f"remaining_tokens_identical={str(equal).lower()}")
+    if not equal:
+        mismatch = next(
+            (
+                index
+                for index, pair in enumerate(zip(submitted_tokens, embedded_tokens))
+                if pair[0] != pair[1]
+            ),
+            min(len(submitted_tokens), len(embedded_tokens)),
+        )
+        print(f"first_mismatch_index={mismatch}")
+        print(f"submitted_context={submitted_tokens[max(0, mismatch-12):mismatch+12]}")
+        print(f"embedded_context={embedded_tokens[max(0, mismatch-12):mismatch+12]}")
+    return 0 if equal else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..d4d52259a1b7895718dfb147a59b4eadf4b82703
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,61 @@
+def valid_date(date):
+    if len(date) != 10:
+        return False
+    if date[2] != "-" or date[5] != "-":
+        return False
+
+    c0 = ord(date[0])
+    c1 = ord(date[1])
+    c3 = ord(date[3])
+    c4 = ord(date[4])
+    c6 = ord(date[6])
+    c7 = ord(date[7])
+    c8 = ord(date[8])
+    c9 = ord(date[9])
+
+    if (
+        c0 < 48 or c0 > 57 or c1 < 48 or c1 > 57
+        or c3 < 48 or c3 > 57 or c4 < 48 or c4 > 57
+        or c6 < 48 or c6 > 57 or c7 < 48 or c7 > 57
+        or c8 < 48 or c8 > 57 or c9 < 48 or c9 > 57
+    ):
+        return False
+
+    month = (c0 - 48) * 10 + c1 - 48
+    day = (c3 - 48) * 10 + c4 - 48
+
+    if month < 1 or month > 12 or day < 1:
+        return False
+    if month == 2:
+        return day <= 29
+    if month == 4 or month == 6 or month == 9 or month == 11:
+        return day <= 30
+    return day <= 31
+
+
+# Prompt examples.
+assert valid_date("03-11-2000")
+assert not valid_date("15-01-2012")
+assert not valid_date("04-0-2040")
+assert valid_date("06-04-2020")
+assert not valid_date("06/04/2020")
+
+# Every material return branch and boundary.
+assert not valid_date("")
+assert not valid_date("03/11-2000")
+assert not valid_date("03-11/2000")
+assert not valid_date("a3-11-2000")
+assert not valid_date("03-a1-2000")
+assert not valid_date("03-11-200a")
+assert not valid_date("00-01-2000")
+assert not valid_date("13-01-2000")
+assert not valid_date("01-00-2000")
+assert valid_date("02-29-2000")
+assert not valid_date("02-30-2000")
+assert valid_date("04-30-2000")
+assert not valid_date("04-31-2000")
+assert valid_date("01-31-2000")
+assert not valid_date("01-32-2000")
+
+# Canonical.py rejects these last two valid boundaries due to its Boolean
+# grouping, while the prompt contract and generated program accept them.
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..8991fd3c4bc439a0b5105d3ad28bc7fa73decca2
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Independent canonical/generated/prompt-contract differential audit."""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import random
+import re
+from pathlib import Path
+
+
+def load_entry(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.valid_date
+
+
+def prompt_contract(value: str) -> bool:
+    """Literal mm-dd-yyyy reading of the natural-language contract."""
+    match = re.fullmatch(r"([0-9]{2})-([0-9]{2})-([0-9]{4})", value)
+    if match is None:
+        return False
+    month = int(match.group(1))
+    day = int(match.group(2))
+    if not 1 <= month <= 12 or day < 1:
+        return False
+    upper = 29 if month == 2 else 30 if month in (4, 6, 9, 11) else 31
+    return day <= upper
+
+
+def generate_cases() -> tuple[list[str], dict[str, int]]:
+    cases: list[str] = []
+    sections: dict[str, int] = {}
+
+    def add(section: str, values):
+        before = len(cases)
+        cases.extend(values)
+        sections[section] = len(cases) - before
+
+    add(
+        "documented_examples",
+        (
+            "03-11-2000",
+            "15-01-2012",
+            "04-0-2040",
+            "06-04-2020",
+            "06/04/2020",
+        ),
+    )
+    add(
+        "empty_and_branch_boundaries",
+        (
+            "",
+            "-",
+            "0",
+            "00-00-000",
+            "00-00-0000",
+            "01-01-0000",
+            "12-31-9999",
+            "13-01-2000",
+            "01-00-2000",
+            "02-28-2000",
+            "02-29-2000",
+            "02-30-2000",
+            "04-30-2000",
+            "04-31-2000",
+            "01-31-2000",
+            "01-32-2000",
+            "03/11-2000",
+            "03-11/2000",
+            "03-11-200a",
+            "a3-11-2000",
+            "03-a1-2000",
+        ),
+    )
+    add(
+        "canonical_format_sensitivity",
+        (
+            "3-11-2000",
+            "03-1-2000",
+            "03-11-20",
+            "03-11-20000",
+            " 03-11-2000",
+            "03-11-2000 ",
+            " 03-11-2000 ",
+            "03-11-+200",
+            "03-11- 2000",
+            "０３-１１-２０００",
+            "٠٣-١١-٢٠٠٠",
+            "03-11-²000",
+        ),
+    )
+    add(
+        "calendar_grid",
+        (
+            f"{month:02d}-{day:02d}-{year}"
+            for month in range(0, 14)
+            for day in range(0, 34)
+            for year in ("0000", "2000", "9999")
+        ),
+    )
+    near_digit = ("/", "0", "9", ":", "a", "０", "٠")
+    digit_positions = (0, 1, 3, 4, 6, 7, 8, 9)
+    digit_mutants = []
+    baseline = list("03-11-2000")
+    for position in digit_positions:
+        for char in near_digit:
+            mutant = baseline.copy()
+            mutant[position] = char
+            digit_mutants.append("".join(mutant))
+    add("every_digit_guard_boundary", digit_mutants)
+
+    separator_mutants = []
+    for position in (2, 5):
+        for char in (",", "-", ".", "/", "—"):
+            mutant = baseline.copy()
+            mutant[position] = char
+            separator_mutants.append("".join(mutant))
+    add("separator_guard_boundaries", separator_mutants)
+
+    rng = random.Random(124_2026_07_23)
+    alphabet = "0123456789-/+ abcXYZ０١"
+    random_cases = []
+    for _ in range(3000):
+        length = rng.randrange(0, 15)
+        random_cases.append("".join(rng.choice(alphabet) for _ in range(length)))
+    add("deterministic_generated_strings", random_cases)
+
+    unique = list(dict.fromkeys(cases))
+    sections["duplicates_removed"] = len(cases) - len(unique)
+    sections["unique_total"] = len(unique)
+    return unique, sections
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--canonical", type=Path, required=True)
+    parser.add_argument("--generated", type=Path, required=True)
+    parser.add_argument("--cases-out", type=Path, required=True)
+    args = parser.parse_args()
+
+    canonical = load_entry("audit_canonical", args.canonical)
+    generated = load_entry("audit_generated", args.generated)
+    cases, sections = generate_cases()
+
+    canonical_mismatches = []
+    prompt_mismatches = []
+    args.cases_out.parent.mkdir(parents=True, exist_ok=True)
+    with args.cases_out.open("w", encoding="utf-8") as stream:
+        for index, value in enumerate(cases):
+            canonical_result = canonical(value)
+            generated_result = generated(value)
+            prompt_result = prompt_contract(value)
+            record = {
+                "index": index,
+                "input": value,
+                "canonical": canonical_result,
+                "generated": generated_result,
+                "prompt_contract": prompt_result,
+            }
+            stream.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n")
+            if canonical_result != generated_result:
+                canonical_mismatches.append(record)
+            if prompt_result != generated_result:
+                prompt_mismatches.append(record)
+
+    print("sections=" + json.dumps(sections, sort_keys=True))
+    print(f"tested={len(cases)}")
+    print(f"canonical_generated_mismatches={len(canonical_mismatches)}")
+    print(f"prompt_generated_mismatches={len(prompt_mismatches)}")
+    print("canonical_generated_mismatch_examples")
+    for record in canonical_mismatches[:40]:
+        print(json.dumps(record, ensure_ascii=False, sort_keys=True))
+    print("prompt_generated_mismatch_examples")
+    for record in prompt_mismatches[:40]:
+        print(json.dumps(record, ensure_ascii=False, sort_keys=True))
+
+    # A canonical divergence is deliberately a nonzero audit signal. The
+    # separate prompt mismatch count lets the review judge a reference/contract
+    # conflict instead of silently treating either oracle as authoritative.
+    return 1 if canonical_mismatches or prompt_mismatches else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/extract_embedded_program.py b/evidence/extract_embedded_program.py
new file mode 100644
index 0000000000000000000000000000000000000000..b1165688bc93ad237feb67aa1dd2f9ddd4731036
--- /dev/null
+++ b/evidence/extract_embedded_program.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Extract only the RHS term of verification.k's solutionProgram equation."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("verification", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    text = args.verification.read_text(encoding="utf-8")
+    begin_marker = "// BEGIN_SOLUTION_MPY"
+    end_marker = "// END_SOLUTION_MPY"
+    if text.count(begin_marker) != 1 or text.count(end_marker) != 1:
+        raise SystemExit("expected exactly one pair of solution markers")
+    block = text.split(begin_marker, 1)[1].split(end_marker, 1)[0].strip()
+    prefix = "rule solutionProgram =>"
+    if not block.startswith(prefix):
+        raise SystemExit("marked block does not begin with solutionProgram equation")
+    term = block[len(prefix) :].strip()
+    if not term.startswith("Module("):
+        raise SystemExit("solutionProgram RHS is not a Module term")
+    args.output.write_text(term + "\n", encoding="utf-8")
+    print(f"extracted_bytes={len((term + chr(10)).encode('utf-8'))}")
+    print(f"output={args.output}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/ground_witnesses.py b/evidence/ground_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..365bdcf8e5e9c81d58bc78bce9d58d5b9230bc94
--- /dev/null
+++ b/evidence/ground_witnesses.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""Ground instances of both entry preconditions and the claimed result."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.valid_date
+
+
+def claimed_ten_result(value: str) -> bool:
+    assert len(value) == 10
+    codes = list(map(ord, value))
+    digits = all(48 <= codes[index] <= 57 for index in (0, 1, 3, 4, 6, 7, 8, 9))
+    if not digits or codes[2] != 45 or codes[5] != 45:
+        return False
+    month = (codes[0] - 48) * 10 + codes[1] - 48
+    day = (codes[3] - 48) * 10 + codes[4] - 48
+    month_day_ok = (
+        1 <= month <= 12
+        and day >= 1
+        and (
+            (month == 2 and day <= 29)
+            or (month in (4, 6, 9, 11) and day <= 30)
+            or (month not in (2, 4, 6, 9, 11) and day <= 31)
+        )
+    )
+    return month_day_ok
+
+
+canonical = load(Path("/tmp/audit-work/trusted/canonical.py"), "witness_canonical")
+generated = load(Path("/tmp/audit-work/src/solution.py"), "witness_generated")
+
+witnesses = (
+    ("non-ten", "", False),
+    ("ten", "03-11-2000", claimed_ten_result("03-11-2000")),
+    ("ten", "15-01-2012", claimed_ten_result("15-01-2012")),
+    ("ten", "04-30-2000", claimed_ten_result("04-30-2000")),
+)
+
+generated_disagreements = 0
+canonical_disagreements = 0
+for claim, value, claimed_result in witnesses:
+    precondition = len(value) != 10 if claim == "non-ten" else len(value) == 10
+    generated_result = generated(value)
+    canonical_result = canonical(value)
+    generated_disagreements += generated_result != claimed_result
+    canonical_disagreements += canonical_result != claimed_result
+    print(
+        json.dumps(
+            {
+                "claim": claim,
+                "input": value,
+                "precondition_satisfied": precondition,
+                "claimed_result": claimed_result,
+                "generated_python": generated_result,
+                "canonical_python": canonical_result,
+            },
+            sort_keys=True,
+        )
+    )
+
+print(f"generated_claim_disagreements={generated_disagreements}")
+print(f"canonical_claim_disagreements={canonical_disagreements}")
+raise SystemExit(1 if generated_disagreements else 0)
