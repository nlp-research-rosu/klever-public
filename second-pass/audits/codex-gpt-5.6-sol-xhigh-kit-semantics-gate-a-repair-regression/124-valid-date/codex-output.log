+        return False
+
+    c0 = ord(date[0])
+    c1 = ord(date[1])
+    c3 = ord(date[3])
+    c4 = ord(date[4])
+    c6 = ord(date[6])
+    c7 = ord(date[7])
+    c8 = ord(date[8])
+    c9 = ord(date[9])
+
+    if (
