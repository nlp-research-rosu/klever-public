  // [I, N).  The I < 2 equation totalizes the function without evaluating
  // modulo at zero.
  syntax Bool ::= noDivisors(Int, Int) [function, total]
  rule noDivisors(N, I) => noDivisors(N, 2)
    requires I <Int 2
  rule noDivisors(N, I) => true
    requires I >=Int 2 andBool I >=Int N
  rule noDivisors(N, I)
    => (pyMod(N, I) =/=Int 0 andBool noDivisors(N, I +Int 1))
    requires I >=Int 2 andBool I <Int N

