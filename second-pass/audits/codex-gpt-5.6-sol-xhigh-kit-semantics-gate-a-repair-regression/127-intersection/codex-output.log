def intersection(interval1, interval2):
    left = max(interval1[0], interval2[0])
    right = min(interval1[1], interval2[1])
    length = right - left

    if length < 2:
        return "NO"

    divisor = 2
    is_prime = True
    while divisor < length:
        if length % divisor == 0:
            is_prime = False
        divisor = divisor + 1

    if is_prime:
        return "YES"
    return "NO"


