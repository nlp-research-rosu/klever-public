+    [[0, 20], [3, 14], "second interval strictly inside"],
+    [[3, 14], [0, 20], "first interval strictly inside"],
+    [[0, 5], [2, 10], "left=max(second), right=min(first)"],
+    [[2, 10], [0, 5], "left=max(first), right=min(second)"],
+    [[1000000000000000000, 1000000000000000005], [1000000000000000001, 1000000000000000004], "large integers"],
+    [[-1000000000000000005, -1000000000000000000], [-1000000000000000004, -1000000000000000001], "large negatives"]
+  ],
+  "exhaustive_generator": {
+    "endpoints": "all integers from -8 through 8 inclusive",
+    "intervals": "every ordered pair (start,end) satisfying start <= end",
+    "pairing": "Cartesian square of the 153 generated intervals",
