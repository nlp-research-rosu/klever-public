        (list(vCons(A:Int,
              vCons(B:Int,
              vCons(C:Int,
              vCons(D:Int, .ValSeq))))), .Vals)
      )
      =>
      tuple(vCons(
        sumFrom(vCons(A,
                vCons(B,
                vCons(C,
                vCons(D, .ValSeq)))), 0),
        vCons(
          productFrom(vCons(A,
                      vCons(B,
                      vCons(C,
                      vCons(D, .ValSeq)))), 1),
          .ValSeq)))
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        "sum_product" |->
          closureVal(
            ("numbers", .ParamNames),
            Assign(Name("total"), Int(0))
            Assign(Name("product"), Int(1))
            Assign(Name("number"), Int(0))
            For(
              Name("number"),
              Name("numbers"),
              AugAssign(Name("total"), "+", Name("number"))
              AugAssign(Name("product"), "*", Name("number"))
            )
            Return(TupleExpr(Name("total"), Name("product"))),
            0
          ),
        parent(-1)
      )
      -1 |-> _BUILTINS:Scope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
requires "reference-semantics/semantics.k"

module VERIFICATION-BASE
  imports MPY

  // The HumanEval input domain: every element of the finite value sequence is
  // an integer. isInt is K's generated subsort predicate for Int < Val.
  syntax Bool ::= allIntVals(ValSeq) [function, total]
  rule allIntVals(.ValSeq) => true
  rule allIntVals(vCons(V:Val, VS:ValSeq))
    => isInt(V) andBool allIntVals(VS)

  // Mathematical summaries used by the postcondition and loop invariant.
  // They are deliberately partial outside allIntVals' domain.
  syntax Int ::= sumFrom(ValSeq, Int) [function]
  rule sumFrom(.ValSeq, ACC:Int) => ACC
  rule sumFrom(vCons(V:Val, VS:ValSeq), ACC:Int)
    => sumFrom(VS, ACC +Int {V}:>Int)
    requires isInt(V)

  syntax Int ::= productFrom(ValSeq, Int) [function]
  rule productFrom(.ValSeq, ACC:Int) => ACC
  rule productFrom(vCons(V:Val, VS:ValSeq), ACC:Int)
    => productFrom(VS, ACC *Int {V}:>Int)
    requires isInt(V)

  // Sort-refined restatements of the fixed MPY-INT dispatch equations. K's
  // symbolic backend does not otherwise project a Val from an isInt path fact.
  rule applyBin("+", ACC:Int, V:Val) => ACC +Int {V}:>Int
    requires isInt(V)
    [simplification]
  rule applyBin("*", ACC:Int, V:Val) => ACC *Int {V}:>Int
    requires isInt(V)
    [simplification]

  // Symbolic normalization of the scope-map deletion performed by #pop.
  rule (1 |-> LOCAL:Scope OUTER:Map) [1 <- undef] => OUTER
    requires notBool 1 in_keys(OUTER)
    [simplification]
endmodule

module VERIFICATION
  imports VERIFICATION-BASE

  // Exact operational bridge for modular use of the independently proved
  // LOOP-SPEC.sum-product-loop reachability theorem. It is deliberately
  // unframed: continuation, stack, bindings, heap, exception state, and every
  // other operational cell are identical to that theorem's complete domain.
  rule
    <k>
      #loop(
        list(VS:ValSeq),
        Name("number"),
        AugAssign(Name("total"), "+", Name("number"))
        AugAssign(Name("product"), "*", Name("number"))
      )
      ~> Return(TupleExpr(Name("total"), Name("product")))
      ~> #endcall
      =>
      tuple(vCons(sumFrom(VS, SUM),
            vCons(productFrom(VS, PRODUCT), .ValSeq)))
    </k>
    <env> 1 => 0 </env>
    <scopes>
      -1 |-> BUILTINS:Scope
      0 |-> MODULE:Scope
      1 |-> scope(
        "numbers" |-> list(_INPUT:ValSeq)
        "total" |-> SUM:Int
        "product" |-> PRODUCT:Int
        "number" |-> _LAST:Val,
        _PARENT:Parent
      )
      =>
      -1 |-> BUILTINS
      0 |-> MODULE
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allIntVals(VS)
    [priority(40)]
endmodule
