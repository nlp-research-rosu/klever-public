+printf '%s\n' '$ python3 py2mpy.py k_concrete_audit.py > k_concrete_audit.mpy' > "$LOG"
+(
+  cd "$SCRATCH" || exit 1
+  python3 py2mpy.py k_concrete_audit.py > k_concrete_audit.mpy
+)
+status=$?
+printf '[exit %d]\n' "$status" >> "$LOG"
+if [ "$status" -ne 0 ]; then
+  sed -n '1,200p' "$LOG"
