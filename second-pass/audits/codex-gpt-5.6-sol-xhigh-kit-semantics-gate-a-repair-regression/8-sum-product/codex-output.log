     5	from typing import List, Tuple
     6	
     7	
     8	def sum_product(numbers: List[int]) -> Tuple[int, int]:
     9	    """ For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.
    10	    Empty sum should be equal to 0 and empty product should be equal to 1.
    11	    >>> sum_product([])
    12	    (0, 1)
    13	    >>> sum_product([1, 2, 3, 4])
    14	    (10, 24)
    15	    """
    16	    sum_value = 0
    17	    prod_value = 1
    18	
    19	    for n in numbers:
    20	        sum_value += n
    21	        prod_value *= n
    22	    return sum_value, prod_value

