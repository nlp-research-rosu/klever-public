@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Concrete realizability and result substitutions for the three claims."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import math
+from pathlib import Path
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.sum_product
+
+
+canonical = load(Path("/reference/canonical.py"), "canonical_ground")
+candidate = load(
+    Path("/tmp/audit-work/reconstruction/solution.py"), "candidate_ground"
+)
+
+witnesses = [
+    {
+        "claim": "SPEC.sum-product",
+        "input": [1, 2, 3, 4],
+        "reason": "exactly four K Int values satisfy the entry pattern",
+    },
+    {
+        "claim": "LOOP-SPEC.sum-product-loop",
+        "input": [],
+        "reason": "allIntVals(.ValSeq) is true; accumulators are 0 and 1",
+    },
+    {
+        "claim": "FOR-SPEC.sum-product-for",
+        "input": [2, 3],
+        "reason": "allIntVals([2,3]) is true; accumulators are 0 and 1",
+    },
+]
+
+for witness in witnesses:
+    values = witness["input"]
+    expected = (sum(values), math.prod(values))
+    witness["fold_summary"] = list(expected)
+    witness["trusted_canonical"] = list(canonical(list(values)))
+    witness["candidate_python"] = list(candidate(list(values)))
+    witness["all_equal"] = (
+        tuple(witness["trusted_canonical"])
+        == tuple(witness["candidate_python"])
+        == expected
+    )
+
+print(json.dumps(witnesses, indent=2, sort_keys=True))
+raise SystemExit(0 if all(item["all_equal"] for item in witnesses) else 1)
diff --git a/evidence/inventory_k.py b/evidence/inventory_k.py
new file mode 100644
index 0000000000000000000000000000000000000000..e99e0808cee1efbd9847b1d064da5de6bbdd485a
--- /dev/null
+++ b/evidence/inventory_k.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""Inventory every local K declaration/rule in the audited source tree."""
+
+from __future__ import annotations
+
+import collections
+import re
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work/reconstruction")
+files = (
+    [ROOT / "reference-semantics" / "semantics.k"]
+    + sorted((ROOT / "reference-semantics" / "semantics").glob("*.k"))
+    + [ROOT / "verification.k", ROOT / "spec.k"]
+)
+
+start_re = re.compile(
+    r"^\s*(configuration|syntax(?:\s+priority|\s+associativity)?|"
+    r"rule|claim|context|alias)\b"
+)
+boundary_re = re.compile(
+    r"^\s*(module|endmodule|imports|configuration|"
+    r"syntax(?:\s+priority|\s+associativity)?|rule|claim|context|alias)\b"
+)
+flags = (
+    "function",
+    "total",
+    "functional",
+    "simplification",
+    "priority",
+    "concrete",
+    "owise",
+    "macro",
+    "strict",
+    "seqstrict",
+    "symbol",
+    "hook",
+    "opaque",
+)
+
+records: list[dict[str, object]] = []
+for path in files:
+    lines = path.read_text(encoding="utf-8").splitlines()
+    starts = [i for i, line in enumerate(lines) if start_re.match(line)]
+    for pos, start in enumerate(starts):
+        kind_match = start_re.match(lines[start])
+        assert kind_match is not None
+        kind = kind_match.group(1)
+        end = len(lines)
+        for i in range(start + 1, len(lines)):
+            if boundary_re.match(lines[i]):
+                end = i
+                break
+        text = " ".join(
+            part.strip()
+            for part in lines[start:end]
+            if part.strip() and not part.lstrip().startswith("//")
+        )
+        # K attributes occur in square brackets. Restrict flag detection to
+        # those blocks so source string literals such as Name("total") do not
+        # masquerade as a [total] declaration.
+        attribute_text = " ".join(re.findall(r"\[([^\]]*)\]", text))
+        found_flags = [
+            flag for flag in flags if re.search(rf"\b{flag}\b", attribute_text)
+        ]
+        if kind == "rule":
+            classification = (
+                "simplification-rule"
+                if "simplification" in found_flags
+                else "ordinary-rule"
+            )
+        else:
+            classification = kind
+        records.append(
+            {
+                "file": str(path.relative_to(ROOT)),
+                "line": start + 1,
+                "kind": kind,
+                "classification": classification,
+                "flags": found_flags,
+                "text": text,
+            }
+        )
+
+print("# Exhaustive source declaration/rule inventory")
+print("# Generated by evidence/inventory_k.py from the clean scratch source copy.")
+print("# One record appears for every configuration, syntax declaration, rule,")
+print("# claim, context, or alias whose declaration begins in the selected sources.")
+print()
+
+by_file: dict[str, collections.Counter[str]] = collections.defaultdict(
+    collections.Counter
+)
+overall: collections.Counter[str] = collections.Counter()
+attribute_counts: collections.Counter[str] = collections.Counter()
+for record in records:
+    by_file[record["file"]][record["classification"]] += 1
+    overall[record["classification"]] += 1
+    attribute_counts.update(record["flags"])
+
+print("SUMMARY")
+print(f"files={len(files)} records={len(records)}")
+print("overall=" + ", ".join(f"{key}:{overall[key]}" for key in sorted(overall)))
+print(
+    "attribute_flags="
+    + ", ".join(f"{flag}:{attribute_counts[flag]}" for flag in flags)
+)
+for file in sorted(by_file):
+    counts = ", ".join(
+        f"{key}:{by_file[file][key]}" for key in sorted(by_file[file])
+    )
+    print(f"{file}: {counts}")
+print()
+
+for index, record in enumerate(records, 1):
+    flag_text = ",".join(record["flags"]) if record["flags"] else "-"
+    if str(record["file"]).startswith("reference-semantics/"):
+        status = "TRUSTED_SUPPLIED_BASELINE"
+    elif record["file"] == "verification.k":
+        status = "PROOF_LOCAL_REVIEWED_IN_REVIEW_MD"
+    else:
+        status = "CLAIM_REVIEWED_IN_REVIEW_MD"
+    print(
+        f"{index:04d} {record['file']}:{record['line']} "
+        f"{record['classification']} flags={flag_text} status={status}"
+    )
+    print(f"     {record['text']}")
diff --git a/evidence/k_concrete_audit.py b/evidence/k_concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e12d4e988188c7ce9b18e1a5077c767efa4f32e
--- /dev/null
+++ b/evidence/k_concrete_audit.py
@@ -0,0 +1,19 @@
+"""Reviewer-authored concrete checks for the supplied MPY semantics."""
+
+from typing import List, Tuple
+
+
+def sum_product(numbers: List[int]) -> Tuple[int, int]:
+    total = 0
+    product = 1
+    number = 0
+    for number in numbers:
+        total += number
+        product *= number
+    return (total, product)
+
+
+# Empty-loop boundary, documented nonempty example, and negative/zero behavior.
+assert sum_product([]) == (0, 1)
+assert sum_product([1, 2, 3, 4]) == (10, 24)
+assert sum_product([-2, 3, 0, 5]) == (6, 0)
