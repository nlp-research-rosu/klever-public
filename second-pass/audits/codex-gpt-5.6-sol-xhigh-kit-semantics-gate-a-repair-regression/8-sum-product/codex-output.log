+(
+  cd "$SCRATCH" || exit 1
+  krun k_concrete_audit.mpy --definition audit-runtime-kompiled
+) > "$FULL" 2>&1
+status=$?
+lines=$(wc -l < "$FULL")
+{
+  printf '[exit %d; output lines %d]\n' "$status" "$lines"
+  if [ "$lines" -le 200 ]; then
+    sed -n '1,200p' "$FULL"
+  else
+    sed -n '1,100p' "$FULL"
+    printf '[... %d middle lines omitted ...]\n' "$((lines - 200))"
+    tail -n 100 "$FULL"
+  fi
+} >> "$LOG"
+sed -n '1,220p' "$LOG"
+exit "$status"
