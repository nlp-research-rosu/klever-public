+#!/usr/bin/env bash
+set -u
+
+SCRATCH=/tmp/audit-work/reconstruction
+EVIDENCE=/audit-output/evidence/logs
+export PATH="/home/agent/.nix-profile/bin:$PATH"
+
+run_bounded() {
+  name=$1
+  shift
+  full="$SCRATCH/$name.full.log"
+  bounded="$EVIDENCE/$name.log"
+  {
+    printf '$'
+    printf ' %q' "$@"
+    printf '\n'
+  } > "$bounded"
+  "$@" > "$full" 2>&1
+  status=$?
+  lines=$(wc -l < "$full")
+  {
+    printf '[exit %d; output lines %d]\n' "$status" "$lines"
+    if [ "$lines" -le 240 ]; then
+      sed -n '1,240p' "$full"
+    else
+      sed -n '1,120p' "$full"
+      printf '[... %d middle lines omitted ...]\n' "$((lines - 240))"
+      tail -n 120 "$full"
+    fi
+  } >> "$bounded"
+  sed -n '1,260p' "$bounded"
+  return "$status"
+}
+
+cp /audit-output/evidence/spec-audit-vacuity.k \
+  "$SCRATCH/spec-audit-vacuity.k"
+cd "$SCRATCH" || exit 1
+
+run_bounded vacuity_dry_run \
+  kprove spec-audit-vacuity.k \
+  --definition audit-verification-base-kompiled \
+  --spec-module SPEC-AUDIT-VACUITY --dry-run
+dry_status=$?
+if [ "$dry_status" -ne 0 ]; then
+  exit "$dry_status"
+fi
+
+run_bounded vacuity_proof \
+  kprove spec-audit-vacuity.k \
+  --definition audit-verification-base-kompiled \
+  --spec-module SPEC-AUDIT-VACUITY
+proof_status=$?
+if [ "$proof_status" -eq 0 ]; then
+  printf '%s\n' 'UNEXPECTED: false mutation proved' >&2
+  exit 1
+fi
+
+if ! rg -q 'WarnStuckClaimState' "$EVIDENCE/vacuity_proof.log"; then
+  printf '%s\n' 'UNEXPECTED: mutation failed without a stuck claim' >&2
+  exit 1
+fi
+
+printf 'expected_false_mutation_exit=%d; stuck_claim=yes\n' "$proof_status"
+exit 0
diff --git a/evidence/spec-audit-vacuity.k b/evidence/spec-audit-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d56c5b9b013d9a9c29bb150b23b58571402a2bd
--- /dev/null
+++ b/evidence/spec-audit-vacuity.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module SPEC-AUDIT-VACUITY
+  imports VERIFICATION-BASE
+
+  // Fresh reviewer mutation. The exact body returns (6, 0) on
+  // [-2, 3, 0, 5], so requiring (6, 1) changes a reachable result obligation.
+  claim [wrong-product-ground]:
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
+            ("numbers", .ParamNames),
+            Assign(Name("total"), Int(0))
+            Assign(Name("product"), Int(1))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("numbers"),
+              AugAssign(Name("total"), "+", Name("number"))
+              AugAssign(Name("product"), "*", Name("number"))
+            )
+            Return(TupleExpr(Name("total"), Name("product"))),
+            0
+          )
+        ),
+        (list(vCons(-2,
+              vCons(3,
+              vCons(0,
+              vCons(5, .ValSeq))))), .Vals)
+      )
+      =>
+      tuple(vCons(6, vCons(1, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "sum_product" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Assign(Name("total"), Int(0))
+            Assign(Name("product"), Int(1))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("numbers"),
+              AugAssign(Name("total"), "+", Name("number"))
+              AugAssign(Name("product"), "*", Name("number"))
+            )
+            Return(TupleExpr(Name("total"), Name("product"))),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> _BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-bridge-audit.k b/evidence/spec-bridge-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..5b395300aabc50bf2eb1a24c324aef77eba20cb9
--- /dev/null
+++ b/evidence/spec-bridge-audit.k
@@ -0,0 +1,161 @@
+requires "verification.k"
+
+// Ground execution of the exact bridge domain under the bridge-free theory.
+module BRIDGE-WITNESS-BASE
+  imports VERIFICATION-BASE
+
+  claim [ground-exact-loop-base]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(3, .ValSeq))),
+        Name("number"),
+        AugAssign(Name("total"), "+", Name("number"))
+        AugAssign(Name("product"), "*", Name("number"))
+      )
+      ~> Return(TupleExpr(Name("total"), Name("product")))
+      ~> #endcall
+      => tuple(vCons(5, vCons(6, .ValSeq)))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> BUILTINS:Scope
+      0 |-> MODULE:Scope
+      1 |-> scope(
+        "numbers" |-> list(vCons(2, vCons(3, .ValSeq)))
+        "total" |-> 0
+        "product" |-> 1
+        "number" |-> 0,
+        parent(0)
+      )
+      =>
+      -1 |-> BUILTINS
+      0 |-> MODULE
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+// The same complete state under the bridge-bearing theory.
+module BRIDGE-WITNESS-EXTENDED
+  imports VERIFICATION
+
+  claim [ground-exact-loop-extended]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(3, .ValSeq))),
+        Name("number"),
+        AugAssign(Name("total"), "+", Name("number"))
+        AugAssign(Name("product"), "*", Name("number"))
+      )
+      ~> Return(TupleExpr(Name("total"), Name("product")))
+      ~> #endcall
+      => tuple(vCons(5, vCons(6, .ValSeq)))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> BUILTINS:Scope
+      0 |-> MODULE:Scope
+      1 |-> scope(
+        "numbers" |-> list(vCons(2, vCons(3, .ValSeq)))
+        "total" |-> 0
+        "product" |-> 1
+        "number" |-> 0,
+        parent(0)
+      )
+      =>
+      -1 |-> BUILTINS
+      0 |-> MODULE
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+// The bridge must not match when the continuation is changed.
+module BRIDGE-CONTEXT-WITNESS
+  imports VERIFICATION
+
+  claim [changed-continuation]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(3, .ValSeq))),
+        Name("number"),
+        AugAssign(Name("total"), "+", Name("number"))
+        AugAssign(Name("product"), "*", Name("number"))
+      )
+      ~> Return(TupleExpr(Int(99), Int(100)))
+      ~> #endcall
+      => tuple(vCons(99, vCons(100, .ValSeq)))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> BUILTINS:Scope
+      0 |-> MODULE:Scope
+      1 |-> scope(
+        "numbers" |-> list(vCons(2, vCons(3, .ValSeq)))
+        "total" |-> 0
+        "product" |-> 1
+        "number" |-> 0,
+        parent(0)
+      )
+      =>
+      -1 |-> BUILTINS
+      0 |-> MODULE
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+// A changed body falls outside the exact bridge and computes product -4.
+module BRIDGE-BODY-MUTATION
+  imports VERIFICATION
+
+  claim [changed-body-old-result]:
+    <k>
+      #loop(
