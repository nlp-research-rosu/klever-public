Module(
  Expr(
    Str(
      "Reviewer-authored concrete checks for the supplied MPY semantics."))
  ImportFrom("typing", "List", "Tuple")
  FuncDef("sum_product", Params("numbers"),
    Assign(Name("total"), Int(0))
    Assign(Name("product"), Int(1))
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("numbers"),
      AugAssign(Name("total"), "+", Name("number"))
      AugAssign(Name("product"), "*", Name("number")))
    Return(TupleExpr(Name("total"), Name("product"))))
  Assert(
    Compare(
      Call(Name("sum_product"), ListExpr()),
      CmpOp("==", TupleExpr(Int(0), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("sum_product"),
        ListExpr(Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", TupleExpr(Int(10), Int(24)))))
  Assert(
    Compare(
      Call(
        Name("sum_product"),
        ListExpr(UnaryOp("-", Int(2)), Int(3), Int(0), Int(5))),
      CmpOp("==", TupleExpr(Int(6), Int(0))))))
