+fi
+
+sha256sum regenerated-solution.mpy solution.mpy
+printf 'translator_exit=%d\n' "$translator_status"
+printf 'byte_identity_cmp_exit=%d\n' "$identity_status"
+
+python3 "$evidence/stage2_differential.py" \
+  --inputs-json "$evidence/stage2-inputs.json"
+differential_status=$?
+if (( differential_status != 0 )); then
+  overall=1
+fi
+printf 'differential_exit=%d\n' "$differential_status"
+
+exit "$overall"

exec
/bin/bash -lc 'chmod +x /audit-output/evidence/stage2_fidelity.sh /audit-output/evidence/stage2_differential.py && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage2-fidelity.log /audit-output/evidence/stage2_fidelity.sh; status=$?; sed -n '"'1,220p' /audit-output/evidence/stage2-fidelity.log; exit "'$status' in /audit-output
