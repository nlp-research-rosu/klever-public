     1	def minPath(grid, k):
     2	    n = len(grid)
     3	    one_row = 0
     4	    one_col = 0
     5	
     6	    row = 0
     7	    while row < n:
     8	        col = 0
     9	        while col < n:
    10	            if grid[row][col] == 1:
    11	                one_row = row
    12	                one_col = col
    13	            col = col + 1
    14	        row = row + 1
    15	
    16	    neighbor = n * n + 1
    17	    if one_row > 0:
    18	        neighbor = min(neighbor, grid[one_row - 1][one_col])
    19	    if one_row + 1 < n:
    20	        neighbor = min(neighbor, grid[one_row + 1][one_col])
    21	    if one_col > 0:
    22	        neighbor = min(neighbor, grid[one_row][one_col - 1])
    23	    if one_col + 1 < n:
    24	        neighbor = min(neighbor, grid[one_row][one_col + 1])
    25	
    26	    result = []
    27	    step = 0
    28	    while step < k:
    29	        if step % 2 == 0:
    30	            result.append(1)
    31	        else:
    32	            result.append(neighbor)
    33	        step = step + 1
    34	
    35	    return result
    36	
    37	
    38	assert minPath([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3) == [1, 2, 1]
    39	assert minPath([[5, 9, 3], [4, 1, 6], [7, 8, 2]], 1) == [1]
    40	assert minPath([[5, 9, 3], [4, 1, 6], [7, 8, 2]], 6) == [1, 4, 1, 4, 1, 4]
    41	assert minPath([[4, 3], [2, 1]], 5) == [1, 2, 1, 2, 1]

