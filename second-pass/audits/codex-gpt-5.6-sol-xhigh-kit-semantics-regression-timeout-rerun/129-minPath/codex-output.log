tics/semantics/builtins.k:103:  rule applyBuiltin(\"min\", I:Int, REST:Vals) => minVals(I, REST)\nreference-semantics/semantics/builtins.k:104:  rule minVals(M:Int, .Vals)           => M\nreference-semantics/semantics/builtins.k:105:  rule minVals(M:Int, (I:Int, R:Vals)) => minVals(minInt(M, I), R)\nreference-semantics/semantics/builtins.k:124:  rule <k> #applyK(toCall(builtinV(\"enumerate\")), (list(VS:ValSeq), .Vals))\nreference-semantics/semantics/builtins.k:132:  rule <k> #applyK(toCall(builtinV(\"map\")), (typeV(\"str\"), list(VS:ValSeq), .Vals))\nreference-semantics/semantics/builtins.k:155:  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)\nreference-semantics/semantics/builtins.k:176:  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========\nreference-semantics/semantics/builtins.k:177:  rule applyBuiltin(\"range\", I:Int, .Vals)               => rangeObj(0, I, 1)\nreference-semantics/semantics/builtins.k:178:  rule applyBuiltin(\"range\", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)\nreference-semantics/semantics/builtins.k:179:  rule applyBuiltin(\"range\", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)\nreference-semantics/semantics/builtins.k:256:  rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))\nreference-semantics/semantics/builtins.k:261:    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))\nreference-semantics/semantics/builtins.k:264:    => evp(OO, appendIE(ON, CUR)) [owise]\nreference-semantics/semantics/builtins.k:269:  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]\nreference-semantics/semantics/builtins.k:270:  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)\nreference-semantics/semantics/builtins.k:271:  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))\nreference-semantics/semantics/builtins.k:272:  syntax IntSeq ::= appendIE(IntSeq, Int) [function