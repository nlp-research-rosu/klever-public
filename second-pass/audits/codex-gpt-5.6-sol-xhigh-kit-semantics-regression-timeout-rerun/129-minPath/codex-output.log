     1	#!/usr/bin/env python3
     2	"""Check that verification.k embeds exactly the translated solution term."""
     3	
     4	import argparse
     5	import json
     6	import subprocess
     7	import tempfile
     8	from pathlib import Path
     9	
    10	
    11	def embedded_definition(path):
    12	    text = Path(path).read_text(encoding="utf-8")
    13	    marker = "rule MinPathDefinition"
    14	    start = text.index(marker)
    15	    start = text.index("=>", start) + 2
    16	    start = text.index("FuncDef", start)
    17	
    18	    depth = 0
    19	    quoted = False
    20	    escaped = False
    21	    for end in range(start, len(text)):
    22	        char = text[end]
    23	        if quoted:
    24	            if escaped:
    25	                escaped = False
    26	            elif char == "\\":
    27	                escaped = True
    28	            elif char == '"':
    29	                quoted = False
    30	        elif char == '"':
    31	            quoted = True
    32	        elif char == "(":
    33	            depth += 1
    34	        elif char == ")":
    35	            depth -= 1
    36	            if depth == 0:
    37	                return text[start : end + 1]
    38	    raise ValueError("unterminated FuncDef term")
    39	
    40	
    41	def kast(term_path, definition):
    42	    completed = subprocess.run(
    43	        [
    44	            "kast",
    45	            "--definition",
    46	            definition,
    47	            "--input",
    48	            "program",
    49	            "--output",
    50	            "json",
    51	            term_path,
    52	        ],
    53	        capture_output=True,
    54	        text=True,
    55	    )
    56	    if completed.returncode != 0:
    57	        raise RuntimeError(completed.stderr.strip())
    58	    return json.loads(completed.stdout)["term"]
    59	
    60	
    61	def main():
    62	    parser = argparse.ArgumentParser()
    63	    parser.add_argument("--definition", default="verification-kompiled")
    64	    parser.add_argument("--verification", default="verification.k")
    65	    parser.add_argument("--solution", default="solution.mpy")
    66	    parser.add_argument("--mutation-probe", action="store_true")
    67	    args = parser.parse_args()
    68	
    69	    solution = Path(args.solution).read_text(encoding="utf-8")
    70	    expected_equal = True
    71	    if args.mutation_probe:
    72	        old = 'Attribute(Name("result"), "append"), Int(1)'
    73	        new = 'Attribute(Name("result"), "append"), Int(9)'
    74	        if solution.count(old) != 1:
    75	            raise ValueError("mutation target was not unique")
    76	        solution = solution.replace(old, new)
    77	        expected_equal = False
    78	
    79	    embedded = "Module(" + embedded_definition(args.verification) + ")\n"
    80	    # K source accepts explicit empty-list units; external .mpy syntax writes
    81	    # the corresponding argument position empty.
    82	    embedded = embedded.replace(".Stmts", "").replace(".Exprs", "")
    83	    with tempfile.TemporaryDirectory() as tmp:
    84	        embedded_path = Path(tmp) / "embedded.mpy"
    85	        solution_path = Path(tmp) / "solution.mpy"
    86	        embedded_path.write_text(embedded, encoding="utf-8")
    87	        solution_path.write_text(solution, encoding="utf-8")
    88	        equal = kast(str(embedded_path), args.definition) == kast(
    89	            str(solution_path), args.definition
    90	        )
    91	
    92	    if equal != expected_equal:
    93	        result = "equal" if equal else "different"
    94	        expectation = "equal" if expected_equal else "different"
    95	        raise SystemExit(f"program-term check failed: got {result}, expected {expectation}")
    96	
    97	    if args.mutation_probe:
    98	        print("program-term mutation probe: EXPECTED MISMATCH")
    99	    else:
   100	        print("program-term identity: MATCH")
   101	
   102	
   103	if __name__ == "__main__":
   104	    main()
     1	#!/usr/bin/env python3
     2	"""Finite differential tests against an independent path enumerator."""
     3	
     4	from itertools import permutations
     5	from random import Random
     6	
     7	from solution import minPath
     8	
     9	
    10	def brute_force_min_path(grid, k):
    11	    n = len(grid)
    12	    paths = [((grid[row][col],), row, col) for row in range(n) for col in range(n)]
    13	    for _ in range(1, k):
    14	        extended = []
    15	        for values, row, col in paths:
    16	            for row_step, col_step in ((-1, 0), (1, 0), (0, -1), (0, 1)):
    17	                next_row = row + row_step
    18	                next_col = col + col_step
    19	                if 0 <= next_row < n and 0 <= next_col < n:
    20	                    extended.append(
    21	                        (
    22	                            values + (grid[next_row][next_col],),
    23	                            next_row,
    24	                            next_col,
    25	                        )
    26	                    )
    27	        paths = extended
    28	    return list(min(values for values, _, _ in paths))
    29	
    30	
    31	def check(grid, k):
    32	    expected = brute_force_min_path(grid, k)
    33	    actual = minPath(grid, k)
    34	    if actual != expected:
    35	        raise AssertionError((grid, k, expected, actual))
    36	
    37	
    38	def main():
    39	    count = 0
    40	
    41	    for values in permutations(range(1, 5)):
    42	        grid = [list(values[:2]), list(values[2:])]
    43	        for k in range(1, 7):
    44	            check(grid, k)
    45	            count += 1
    46	
    47	    random = Random(129)
    48	    for _ in range(100):
    49	        values = list(range(1, 10))
    50	        random.shuffle(values)
    51	        grid = [values[:3], values[3:6], values[6:]]
    52	        for k in range(1, 7):
    53	            check(grid, k)
    54	            count += 1
    55	
    56	    for _ in range(25):
    57	        values = list(range(1, 17))
    58	        random.shuffle(values)
    59	        grid = [values[:4], values[4:8], values[8:12], values[12:]]
    60	        for k in range(1, 6):
    61	            check(grid, k)
    62	            count += 1
    63	
    64	    print(f"differential tests: {count} passed; mismatches: 0")
