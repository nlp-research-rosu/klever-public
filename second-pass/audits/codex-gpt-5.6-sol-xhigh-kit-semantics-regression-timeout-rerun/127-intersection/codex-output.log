+++ b/evidence/proof-local-judgments.tsv
@@ -0,0 +1,15 @@
+inventory_ids	extension	class	domain_and_overlap_judgment	result
+K0929	scanPrime declaration	definitional-summary/allocation of a total Bool function	Declared total over all Int,Int,Bool, but equations do not cover ground non-divisor terms at I=2; e.g. scanPrime(5,2,true) is irreducible. This leaves the result-controlling entry split underconstrained.	UNSOUND_TOTALITY_ORACLE
+K0930	overlapLength declaration	definitional-summary	One unconditional equation covers all four-Int uses.	SOUND
+K0931	intersectionClosure declaration	definitional-literal	One unconditional rule covers the nullary value.	SOUND
+K0932	intersectionClosure rule	definitional-literal	Reviewer KAST comparison proves exact params/body and defining scope 0; no execution is skipped.	SOUND
+K0933	scanPrime false-absorbing equation	definitional-summary	Agrees with every overlap: once prime is false, later scanning remains false.	SOUND_BUT_DEPENDS_ON_BROKEN_TOTAL_DEFINITION
+K0934	scanPrime I<2 totalization	definitional-summary	Returns false only off the theorem/loop domain I>=2; it does not overlap a conflicting true rule.	SOUND_ARBITRARY_OFF_DOMAIN_TOTALIZATION
+K0935	scanPrime I>=N equation	definitional-summary	No remaining divisors, so the accumulated Boolean P is the result.	SOUND
+K0936	scanPrime divisor equation	definitional-summary	For 2<=I<N and pyMod(N,I)=0, remaining scan is false; overlaps with P=false agree.	SOUND
+K0937	scanPrime reverse simplification	derived mathematical equality	The equality scan(N,I+1,P)=scan(N,I,P) is true when I is a non-divisor, but its reverse-only orientation does not cover entry term I=2; use with K0929 leaves an oracle.	TRUE_RULE_IN_INADEQUATE_DEFINITION
+K0938	overlapLength equation	definitional-summary	Exactly min(B,D)-max(A,C); unconditional and overlap-free.	SOUND
+K0939	maxInt simplification	derived arithmetic lemma	Integer discreteness makes I+1<=N under I<N, so both maxima equal N.	SOUND
+K0940	divisor-loop claim	auxiliary reachability/circularity	Exact real loop and full state footprint, but its postcondition is expressed through underconstrained scanPrime; it can support the composite-9 false-result probe.	NOT_SOUND_AS_USED
+K0941	intersection-prime claim	entry reachability	Exact program and exact YES result, but precondition delegates task classification to underconstrained scanPrime.	NOT_ADEQUATE_OR_SOUND_FOR_REAL_INPUT_DOMAIN
+K0942	intersection-not-prime claim	entry reachability	Exact program and exact NO result, but complementary precondition delegates task classification to underconstrained scanPrime.	NOT_ADEQUATE_OR_SOUND_FOR_REAL_INPUT_DOMAIN
diff --git a/evidence/record-command.sh b/evidence/record-command.sh
new file mode 100644
index 0000000000000000000000000000000000000000..403aa460283f4f3dab12d7e4ff54738f5b388990
--- /dev/null
+++ b/evidence/record-command.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+tmp_output=$(mktemp /tmp/audit-command-output.XXXXXX)
+
+set +e
+"$@" >"$tmp_output" 2>&1
+command_status=$?
+set -e
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'EXIT_STATUS: %s\n' "$command_status"
+  output_lines=$(wc -l <"$tmp_output")
+  printf 'OUTPUT_LINES: %s\n' "$output_lines"
+  if [ "$output_lines" -le 400 ]; then
+    cat "$tmp_output"
+  else
+    printf '%s\n' '--- FIRST 200 LINES ---'
+    head -n 200 "$tmp_output"
+    printf '%s\n' '--- LAST 200 LINES ---'
+    tail -n 200 "$tmp_output"
+  fi
+} >"$log_path"
+
+rm -f "$tmp_output"
+exit "$command_status"
