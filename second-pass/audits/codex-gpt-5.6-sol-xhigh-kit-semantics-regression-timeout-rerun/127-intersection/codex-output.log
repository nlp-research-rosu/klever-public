+from solution import intersection
+
+
+def oracle(interval1, interval2):
+    left = interval1[0] if interval1[0] >= interval2[0] else interval2[0]
+    right = interval1[1] if interval1[1] <= interval2[1] else interval2[1]
+    length = right - left
+    if length < 2:
+        return "NO"
+    for candidate in range(2, length):
+        if length % candidate == 0:
+            return "NO"
+    return "YES"
+
+
+def main():
+    intervals = [
+        (start, end)
+        for start in range(-8, 9)
+        for end in range(start, 9)
+    ]
+    mismatches = []
+    checked = 0
+    for interval1 in intervals:
+        for interval2 in intervals:
+            checked += 1
+            actual = intersection(interval1, interval2)
+            expected = oracle(interval1, interval2)
+            if actual != expected:
+                mismatches.append((interval1, interval2, actual, expected))
+
+    print(f"intervals={len(intervals)} pairs={checked} mismatches={len(mismatches)}")
+    if mismatches:
+        for mismatch in mismatches[:10]:
+            print(mismatch)
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
