+program_construct	declaration_or_semantic_route	auditor_judgment
+Module/FuncDef	syntax.k:62; functions.k:13; core.k:125-127	Module loader installs the exact closure in scope 0; structurally pinned.
+Call/arguments	syntax.k:25; call.k:16-17,20,69-74; core.k:183-190	Callee is looked up first, arguments then evaluate left-to-right, exact closure frame is pushed.
+tuple/vCons exact inputs	core.k:17-18,24; tuple.k values	Claims supply exact two-element tuple values; no constructor allocation or malformed indexing path.
+Name lookup	core.k:128-154	Current function frame wins; parent chain reaches module/builtins. Exact maps in claims pin bindings.
+Subscript 0/1	syntax.k:19; subscript.k:29-42; core.k:223-225	Object then index evaluation; exact two-element tuples make valSeqAt rules in-bounds.
+Int/Bool literals	syntax.k:9,11; core.k:194-196	Direct values; Python/K unbounded integer model aligns on the used domain.
+Str YES/NO	syntax.k:13; str.k:13-17	ASCII literal conversion covers Y/E/S/N/O and returns exact code sequences.
+Assign	syntax.k:37; controls.k:8-18	RHS evaluates before current-frame map update; only named locals are mutated.
+If/truthiness	syntax.k:44; controls.k:51-54; core.k:199-205	Condition evaluates first; Int/Bool truthiness and branches match the used program.
+BinOp +,-,%	syntax.k:14; operators.k:10; int.k:9,13-14	Integer dispatch matches Python for +,- and positive-divisor modulo.
+Compare >,<,==	syntax.k:26-27; operators.k:13-17; int.k:22-26	Left-to-right comparison evaluation and integer predicates match used comparisons.
+While	syntax.k:41; controls.k:68-75	The condition is re-evaluated before each iteration; body sequencing, divisor increment, and exit are preserved.
+Return	syntax.k:45; functions.k:78-90	Expression evaluates, return discards remaining body, then exact saved continuation/environment are restored.
+Configuration	core.k:50-62	Entry and loop claims pin all active cells; only loop-local divisor/prime updates are abstracted.

diff --git a/evidence/adequacy_witnesses.py b/evidence/adequacy_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..b161894f8c22db71a82fe16f00fb2c25e1cd46aa
--- /dev/null
+++ b/evidence/adequacy_witnesses.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Concrete witnesses for every candidate claim precondition."""
+
+import importlib.util
+import json
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def overlap_length(a, b, c, d):
+    return min(b, d) - max(a, c)
+
+
+def scan_prime_by_loop(length, divisor, prime):
+    while divisor < length:
+        if length % divisor == 0:
+            prime = False
+        divisor += 1
+    return divisor, prime
+
+
+def entry_witness(label, first, second, expected_summary):
+    a, b = first
+    c, d = second
+    length = overlap_length(a, b, c, d)
+    final_divisor, summary = scan_prime_by_loop(length, 2, length > 1)
+    return {
+        "claim": label,
+        "interval1": first,
+        "interval2": second,
+        "A_le_B": a <= b,
+        "C_le_D": c <= d,
+        "overlapLength": length,
+        "scanPrime": summary,
+        "expected_scanPrime": expected_summary,
+        "loop_final_divisor": final_divisor,
+    }
+
+
+def main():
+    canonical = load_module("trusted_canonical", "/reference/canonical.py")
+    candidate = load_module(
+        "scratch_generated_solution", "/tmp/audit-work/scratch/solution.py"
+    )
+
+    loop_divisor, loop_prime = scan_prime_by_loop(4, 2, True)
+    loop_witness = {
+        "claim": "divisor-loop",
+        "N": 4,
+        "I": 2,
+        "P": True,
+        "requires_I_ge_2": True,
+        "post_divisor": loop_divisor,
+        "expected_maxInt_I_N": max(2, 4),
+        "post_prime": loop_prime,
+        "expected_scanPrime": False,
+        "realized_by": [[0, 4], [0, 4]],
+    }
+
+    entry_witnesses = [
+        entry_witness(
+            "intersection-prime",
+            (-3, -1),
+            (-5, 5),
+            True,
+        ),
+        entry_witness(
+            "intersection-not-prime",
+            (0, 4),
+            (0, 4),
+            False,
+        ),
+    ]
+    for witness in entry_witnesses:
+        first = tuple(witness["interval1"])
+        second = tuple(witness["interval2"])
+        witness["canonical_result"] = canonical.intersection(first, second)
+        witness["candidate_result"] = candidate.intersection(first, second)
+        witness["formal_postcondition"] = (
+            "YES" if witness["scanPrime"] else "NO"
+        )
+
+    if (
+        loop_witness["post_divisor"] != loop_witness["expected_maxInt_I_N"]
+        or loop_witness["post_prime"] != loop_witness["expected_scanPrime"]
+    ):
+        raise SystemExit("loop witness failed")
+
+    for witness in entry_witnesses:
+        if not (witness["A_le_B"] and witness["C_le_D"]):
+            raise SystemExit("entry domain witness is malformed")
+        if witness["scanPrime"] != witness["expected_scanPrime"]:
+            raise SystemExit("entry summary precondition mismatch")
+        if witness["canonical_result"] != witness["formal_postcondition"]:
+            raise SystemExit("canonical/postcondition mismatch")
+        if witness["candidate_result"] != witness["formal_postcondition"]:
+            raise SystemExit("candidate/postcondition mismatch")
+
+    print(json.dumps(loop_witness, sort_keys=True))
+    for witness in entry_witnesses:
+        print(json.dumps(witness, sort_keys=True))
+    print("ADEQUACY_WITNESSES=PASS")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/concrete_harness.py b/evidence/concrete_harness.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea3cba4c57f1abd9df9a6b9e54cb085643ef0759
--- /dev/null
+++ b/evidence/concrete_harness.py
@@ -0,0 +1,30 @@
+def intersection(interval1, interval2):
+    left = interval1[0]
+    if interval2[0] > left:
+        left = interval2[0]
+
+    right = interval1[1]
+    if interval2[1] < right:
+        right = interval2[1]
+
+    length = right - left
+    divisor = 2
+    prime = length > 1
+
+    while divisor < length:
+        if length % divisor == 0:
+            prime = False
+        divisor = divisor + 1
+
+    if prime:
+        return "YES"
+    return "NO"
+
+
+assert intersection((1, 2), (2, 3)) == "NO"
+assert intersection((-1, 1), (0, 4)) == "NO"
+assert intersection((-3, -1), (-5, 5)) == "YES"
+assert intersection((0, 0), (0, 0)) == "NO"
+assert intersection((0, 2), (0, 2)) == "YES"
+assert intersection((0, 4), (0, 4)) == "NO"
+assert intersection((2, 3), (-5, -4)) == "NO"
