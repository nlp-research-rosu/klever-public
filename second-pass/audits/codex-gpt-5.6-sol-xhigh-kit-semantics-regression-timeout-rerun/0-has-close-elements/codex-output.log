+if (( LAST_STATUS != 0 )) ||
+   ! grep -Fxq '#Top' "$evidence/stage5-outer-context-extended.log"; then
+  failures=$((failures + 1))
+fi
+
+run_bounded stage5-body-mutation-dry-run \
