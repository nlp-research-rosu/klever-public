new file mode 100644
index 0000000000000000000000000000000000000000..66f09cef198db346467fc6404629132643baacc5
--- /dev/null
+++ b/evidence/bridge-body-mutation.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module AUDIT-BRIDGE-BODY-MUTATION
+  imports VERIFICATION-BASE
+
+  // Reachable one-element Float loop. The real body would increment j by one;
+  // this mutation increments it by two while retaining the real-body poststate.
+  claim [changed-increment]:
+    <k> #loop(
+          list(vCons(F:Float, .ValSeq)),
+          Name("other"),
+          If(Compare(Name("i"), CmpOp("<", Name("j"))),
+             If(Compare(Call(Name("abs"),
+                             BinOp("-", Name("number"), Name("other"))),
+                        CmpOp("<", Name("threshold"))),
+                Assign(Name("result"), Bool(true)),
+                .Stmts),
+             .Stmts)
+          Assign(Name("j"), BinOp("+", Name("j"), Int(2))))
+        => .K </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(
+             "has_close_elements" |->
+               closureVal(("numbers", "threshold"),
+                          HC-FUNCTION-BODY, 0),
+             parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+             "numbers"   |-> list(vCons(F, .ValSeq))
+             "threshold" |-> T:Float
+             "result"    |-> false
+             "i"         |-> 0
+             "number"    |-> F
+             "j"         |-> (0 => 1)
+             "other"     |-> (0.0 => F),
+             parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..bbe3e2c2add787e9a1af0fa62fa407f66614083e
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,29 @@
+from typing import List
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    result = False
+    i = 0
+    number = 0.0
+    j = 0
+    other = 0.0
+    for number in numbers:
+        j = 0
+        for other in numbers:
+            if i < j:
+                if abs(number - other) < threshold:
+                    result = True
+            j = j + 1
+        i = i + 1
+    return result
+
+
+assert has_close_elements([1.0, 2.0, 3.0], 0.5) == False
+assert has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3) == True
+assert has_close_elements([], 1.0) == False
+assert has_close_elements([1.0], 1.0) == False
+assert has_close_elements([0.0, 1.0], 1.0) == False
+assert has_close_elements([0.0, 0.999], 1.0) == True
+assert has_close_elements([1.0, 1.0], 0.0) == False
+assert has_close_elements([1.0, 1.0], 0.01) == True
+assert has_close_elements([-2.0, -1.9], -0.1) == False
diff --git a/evidence/differential_audit.py b/evidence/differential_audit.py
