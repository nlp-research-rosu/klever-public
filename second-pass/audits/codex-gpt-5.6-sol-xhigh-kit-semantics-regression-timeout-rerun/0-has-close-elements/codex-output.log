--- syntax.k ---
     1	// reference/src/semantics/syntax.k — MPY-SYNTAX
     2	
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports FLOAT-SYNTAX
     6	  imports BOOL-SYNTAX
     7	  imports STRING-SYNTAX
     8	
     9	  syntax Expr ::= "Int"      "(" Int ")"
    10	                | "Float"    "(" Float ")"
    11	                | "Bool"     "(" Bool ")"
    12	                | "Name"     "(" String ")"
    13	                | "Str"      "(" String ")"
    14	                | "UnaryOp"  "(" String "," Expr ")" [strict(2)]
    15	                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
    16	                | "BoolOp"    "(" String "," Exprs ")"
    17	                | "ListExpr"  "(" Exprs ")"
    18	                | "DictExpr"  "(" Entries ")"
    19	                | "ListComp"  "(" Expr "," CompFors ")" [macro]
    20	                | "GenExp"    "(" Expr "," CompFors ")" [macro]
    21	                | "TupleExpr" "(" Exprs ")"
    22	                | "Subscript" "(" Expr "," Index ")"
    23	                | "IfExp"     "(" Expr "," Expr "," Expr ")" [strict(1)]
    24	                | "Lambda"    "(" Params "," Expr ")"
    25	                | "KwArg"     "(" String "," Expr ")"
    26	                | "Lambda"    "(" Params "," CellVars "," FreeVars "," Expr ")"
    27	                | "NoneVal"
    28	                | "Call"      "(" Expr "," Exprs ")"
    29	                | "Attribute" "(" Expr "," String ")" [strict(1)]
    30	                | "Compare"   "(" Expr "," CmpOp ")"
    31	
    32	  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"
    33	  syntax Entry    ::= "Entry" "(" Expr "," Expr ")"
    34	  syntax Entries  ::= List{Entry, ","}
    35	  syntax CompFor  ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
    36	  syntax CompFors ::= List{CompFor, ""}
    37	  syntax Exprs    ::= List{Expr, ","}
    38	  syntax Index    ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
    39	  syntax Bound    ::= Expr | "NoBound"
    40	
    41	  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
    42	                | "Import"    "(" String ")"
    43	                | "ImportFrom" "(" String "," ParamNames ")"
    44	                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
    45	                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
    46	                | "While"     "(" Expr "," Stmts ")"
    47	                | "Break"
    48	                | "Continue"
    49	                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
    50	                | "Return"    "(" Expr ")" [strict]
    51	                | "Assert"    "(" Expr ")" [strict]
    52	                | "Expr"      "(" Expr ")" [strict]
    53	                | "FuncDef"   "(" String "," Params "," Stmts ")"
    54	                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
    55	
    56	  syntax Stmts      ::= List{Stmt, ""}
    57	  syntax Params     ::= "Params" "(" ParamNames ")"
    58	  syntax CellVars   ::= "CellVars" "(" ParamNames ")"
    59	  syntax FreeVars   ::= "FreeVars" "(" ParamNames ")"
    60	  syntax ParamNames ::= List{String, ","}
    61	  syntax Module     ::= "Module" "(" Stmts ")"
    62	endmodule
--- core.k ---
     1	// reference/src/semantics/core.k — MPY-CORE
     2	
     3	module MPY-CORE
     4	  imports MPY-SYNTAX
     5	  imports INT
     6	  imports BOOL
     7	  imports STRING
     8	  imports MAP
     9	  imports LIST
    10	  imports K-EQUAL
    11	
    12	  // ==== values, the algebraic lists, and the scope heap =====================
    13	  syntax IntSeq ::= ".IntSeq" | iCons(Int, IntSeq)
    14	  syntax ValSeq ::= ".ValSeq" | vCons(Val, ValSeq)
    15	  syntax Str    ::= str(IntSeq)
    16	
    17	  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)
    18	  syntax Iterable ::= list(ValSeq)
    19	                    | tuple(ValSeq)
    20	                    | Str
    21	                    | rangeObj(Int, Int, Int)
    22	                    | zipObj(ValSeq, ValSeq)
    23	                    | zipObjS(IntSeq, IntSeq)
    24	
    25	  syntax Val      ::= Int
    26	                    | Bool
    27	                    | "noneV"
    28	                    | Iterable
    29	                    | ref(Int)          // a heap object: <heap> holds its list(VS)
    30	                    | cellRef(Int)      // a closure cell: <heap> holds cellV(V)
    31	                    | closureVal(ParamNames, Stmts, Int)
    32	                    | typeV(String)     // a type object (int/str), resolved from the builtins frame
    33	                    | builtinV(String)  // a builtin function, resolved like any name (LEGB fallthrough)
    34	                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method
    35	
    36	  syntax Parent   ::= "root" | parent(Int)
    37	  syntax Scope    ::= scope(Map, Parent)
    38	  syntax KResult  ::= Val
    39	  syntax Expr     ::= Val   // cooling puts results back into expression holes
    40	  syntax Vals     ::= List{Val, ","}
    41	  syntax Exc      ::= "NoExc" | "AssertionError"
    42	  syntax RetState ::= "noRet" | retV(Val)
    43	
    44	  // ==== configuration =======================================================
    45	  // The builtins namespace is a real scope at reserved location -1 (the bottom of every
    46	  // chain; scopeLoc only allocates >=1, so -1 never collides). The module scope (loc 0)
    47	  // has it as parent, so an unbound name resolves there last — exactly LEGB. `int`/`str`
    48	  // resolve to their type objects; any local/global binding shadows them via normal lookup.
    49	  configuration
    50	    <k>       #loadAll($PGM:Module) </k>
    51	    <env>     0 </env>
    52	    <scopes>   0     |-> scope(.Map, parent(-1))
    53	              -1    |-> builtinsScope </scopes>
    54	    <scopeLoc> 1 </scopeLoc>
    55	    <heap>    .Map </heap>
    56	    <heapLoc> 0 </heapLoc>
    57	    <stack>   .List </stack>
    58	    <ret>     noRet </ret>
    59	    <exc>     NoExc </exc>
    60	    <exit-code exit=""> 0 </exit-code>
    61	
    62	  // ==== heap allocation (constructed lists become objects) ==================
    63	  // Cons-form emission with a freshness guard (the heap-list-probe discipline:
    64	  // an update-form H[N <- _] never re-normalizes symbolically). heapLoc is
    65	  // monotonic — it does NOT wind back at #pop: returned lists escape by ref.
    66	  // A bare list(VS) Val stays legal (read-only inputs in claims flow unboxed);
    67	  // only CONSTRUCTORS in program syntax allocate.
    68	  syntax Bool ::= isRefV(Val) [function, total]
    69	  rule isRefV(ref(_:Int)) => true
    70	  rule isRefV(_:Val)      => false [owise]
    71	
    72	  // closure cells (Python-faithful capture): the heap holds cellV(V); a
    73	  // cellRef surfacing as the k-redex reads through (lookup is the only use —
    74	  // cellRefs never escape to user-visible values)
    75	  syntax HeapVal ::= cellV(Val)
    76	  syntax Bool ::= isCellRef(Val) [function, total]
    77	  rule isCellRef(cellRef(_:Int)) => true
    78	  rule isCellRef(_:Val)          => false [owise]
    79	  // k-top deref for cell-bound reads surfacing INSIDE the annotated frame
    80	  // (AugAssign's in-place read and friends). The "$cells" guard keeps this
    81	  // DECIDABLY inapplicable in plain frames — an unguarded rule lets the
    82	  // prover narrow abstract k-top values into cellRef junk (probed on
    83	  // 26-remove-duplicates). Cross-frame reads (a comprehension closure
    84	  // reading the enclosing function's cellvar) deref inside #look instead.
    85	  rule <k> cellRef(H:Int) => V ... </k>
    86	       <env> L:Int </env>
    87	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    88	       <heap> ... H |-> cellV(V:Val) ... </heap>
    89	       requires "$cells" in_keys(M)
    90	       [priority(40)]
    91	
    92	  // write through a cell (Assign / #bindP / #bindTgt dispatch here on
    93	  // cell-bound names)
    94	  // a keyword argument cools to a TAGGED value (consumed by kw-aware builtins)
    95	  syntax Val ::= kwV(String, Val)
    96	  syntax KItem ::= #kwTag(String)
    97	  rule <k> KwArg(N:String, E:Expr) => E ~> #kwTag(N) ... </k>
    98	  rule <k> V:Val ~> #kwTag(N:String) => kwV(N, V) ... </k>
    99	       requires notBool isKwV(V)
   100	  syntax Bool ::= isKwV(Val) [function, total]
   101	  rule isKwV(kwV(_:String, _:Val)) => true
   102	  rule isKwV(_:Val)                => false [owise]
   103	
   104	  // the frame marker carries the CONCRETE cellvar list, so cell-write dispatch
   105	  // decides by pnMember even over an abstract frame rest (no prover branching)
   106	  syntax Val ::= cellsMark(ParamNames)
   107	  syntax ParamNames ::= cellsOf(Val) [function]
   108	  rule cellsOf(cellsMark(CVS:ParamNames)) => CVS
   109	  syntax Bool ::= pnMember(String, ParamNames) [function, total]
   110	  rule pnMember(_:String, .ParamNames) => false
   111	  rule pnMember(X:String, (P:String, R:ParamNames)) => X ==String P orBool pnMember(X, R)
   112	
   113	  syntax KItem ::= #cellW(Val, Val)
   114	  rule <k> #cellW(cellRef(H:Int), V:Val) => .K ... </k>
   115	       <heap> ... H |-> cellV(_:Val => V) ... </heap>
   116	
   117	  syntax KItem ::= #alloc(Val)
   118	  rule <k> #alloc(V:Val) => ref(N) ... </k>
   119	       <heap>    H:Map => (N |-> V) H </heap>
   120	       <heapLoc> N:Int => N +Int 1 </heapLoc>
   121	       requires notBool N in_keys(H)
   122	
   123	  // ==== module load + statement sequencing ==================================
   124	  syntax KItem ::= #loadAll(Module)
   125	  rule <k> #loadAll(Module(SS:Stmts)) => SS ... </k>
   126	  rule <k> (S:Stmt SS:Stmts):Stmts => S ~> SS ... </k>
   127	  rule <k> .Stmts => .K ... </k>
   128	
   129	  // ==== Name lookup (walk the scope chain; builtins live in the -1 scope) ====
   130	  syntax KItem ::= #look(String, Int)
   131	  rule <k> Name(X:String) => #look(X, L) ... </k> <env> L:Int </env>
   132	  rule <k> #look(X:String, L:Int) => {M[X]}:>Val ... </k>
   133	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   134	       requires X in_keys(M)
   135	  // a SYNTACTICALLY cell-bound name reads through the heap cell AT THE
   136	  // LOOKUP (higher priority beats the plain return above on concrete cell
   137	  // bindings; abstract claim values take the plain rule unchanged) — this
   138	  // covers cross-frame cell reads (a comprehension closure reading the
   139	  // enclosing function's cellvar) without a narrowing-prone k-top redex
   140	  // guarded on the FOUND frame's DECLARED cellvars (pnMember over the
   141	  // cellsMark): decidable for every concrete frame pin — plain frames and
   142	  // non-cell names prune outright, so an abstract looked-up value never
   143	  // drags a narrowing cellV heap match along (probed on 5-intersperse and
   144	  // Q4's abstract `numbers` in the annotated frame)
   145	  rule <k> #look(X:String, L:Int) => V ... </k>
   146	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   147	       <heap> ... H |-> cellV(V:Val) ... </heap>
   148	       requires X in_keys(M) andBool "$cells" in_keys(M)
   149	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
   150	        andBool {M[X]}:>Val ==K cellRef(H)
   151	       [priority(40)]
   152	  rule <k> #look(X:String, L:Int) => #look(X, P) ... </k>
   153	       <scopes> ... L |-> scope(M:Map, parent(P:Int)) ... </scopes>
   154	       requires notBool (X in_keys(M))
   155	
   156	  // the ONE predefined builtins scope (the -1 frame; claims write `-1 |-> builtinsScope`)
   157	  syntax Scope ::= "builtinsScope" [function, total]
   158	  rule builtinsScope
   159	    => scope(.Map [ "len"    <- builtinV("len")    ]
   160	                  [ "set"    <- builtinV("set")    ]
   161	                  [ "sum"    <- builtinV("sum")    ]
   162	                  [ "abs"    <- builtinV("abs")    ]
   163	                  [ "min"    <- builtinV("min")    ]
   164	                  [ "max"    <- builtinV("max")    ]
   165	                  [ "ord"    <- builtinV("ord")    ]
   166	                  [ "chr"    <- builtinV("chr")    ]
   167	                  [ "range"  <- builtinV("range")  ]
   168	                  [ "all"    <- builtinV("all")    ]
   169	                  [ "any"    <- builtinV("any")    ]
   170	                  [ "zip"    <- builtinV("zip")    ]
   171	                  [ "isinstance" <- builtinV("isinstance") ]
   172	                  [ "sorted" <- builtinV("sorted") ]
   173	                  [ "list"   <- builtinV("list")   ]
   174	                  [ "round"  <- builtinV("round")  ]
   175	                  [ "bin"    <- builtinV("bin")    ]
   176	                  [ "enumerate" <- builtinV("enumerate") ]
   177	                  [ "map"    <- builtinV("map")    ]
   178	                  [ "eval"   <- builtinV("eval")   ]
   179	                  [ "int"    <- typeV("int")       ]
   180	                  [ "str"    <- typeV("str")       ]
   181	                  [ "float"  <- typeV("float")     ], root)
   182	
   183	  // ==== argument/element evaluation: ONE left-to-right loop, tagged by destination ==
   184	  // (list/tuple literals and calls all use it; modules extend ApplyK with their tags)
   185	  syntax ApplyK ::= toCall(Val)
   186	  syntax KItem  ::= #evalArgs(Exprs, Vals, ApplyK)
   187	                  | #evalArgCont(Exprs, Vals, ApplyK)
   188	                  | #applyK(ApplyK, Vals)
   189	  rule <k> #evalArgs((A:Expr, REST:Exprs), ACC:Vals, K:ApplyK) => A ~> #evalArgCont(REST, ACC, K) ... </k>
   190	  rule <k> V:Val ~> #evalArgCont(REST:Exprs, ACC:Vals, K:ApplyK) => #evalArgs(REST, appendVal(ACC, V), K) ... </k>
   191	  rule <k> #evalArgs(.Exprs, ACC:Vals, K:ApplyK) => #applyK(K, ACC) ... </k>
   192	
   193	  // ==== Int / Bool / None literals ==========================================
   194	  rule <k> Int(I:Int)   => I ... </k>
   195	  rule <k> Bool(B:Bool) => B ... </k>
   196	  rule <k> NoneVal      => noneV ... </k>
   197	
   198	  // ==== truthy (If, Assert, BoolOp, IfExp, not, While) ======================
   199	  syntax Bool ::= truthy(Val) [function]
   200	  rule truthy(B:Bool)          => B
   201	  rule truthy(noneV)           => false
   202	  rule truthy(I:Int)           => I =/=Int 0
   203	  rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)
   204	  rule truthy(list(V:ValSeq))  => notBool (V ==K .ValSeq)
   205	  rule truthy(tuple(V:ValSeq)) => notBool (V ==K .ValSeq)
   206	
   207	  // ==== extensible operator dispatch (cases added by the construct modules) ==
   208	  syntax Val  ::= applyUn(String, Val) [function]
   209	  syntax Val  ::= applyBin(String, Val, Val) [function]
   210	  syntax Bool ::= applyCmp(String, Val, Val) [function]
   211	
   212	  // ==== shared list helpers =================================================
   213	  syntax Vals ::= appendVal(Vals, Val) [function, total]
   214	  rule appendVal(.Vals, V:Val)              => V , .Vals
   215	  rule appendVal((V0:Val, VS:Vals), V:Val)  => V0 , appendVal(VS, V)
   216	
   217	  syntax ValSeq ::= vals2valSeq(Vals) [function, total]
   218	  rule vals2valSeq(.Vals)            => .ValSeq
   219	  rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))
   220	
   221	  // ==== shared sequence length (len / summaries across many modules) ========
   222	  // (positional access valSeqAt/intSeqAt + normIdx live in subscript.k)
   223	  syntax Int ::= vsLen(ValSeq) [function, total]
   224	  rule vsLen(.ValSeq)                => 0
   225	  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
   226	
   227	  syntax Int ::= isLen(IntSeq) [function, total]
   228	  rule isLen(.IntSeq)                => 0
   229	  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
   230	
   231	  // in-bounds positional write (list subscript-assign); OOB leaves the seq unchanged
   232	  // (valid programs write in-bounds — mirrors valSeqAt's total-but-underspecified stance)
   233	  syntax ValSeq ::= setVSAt(ValSeq, Int, Val) [function, total]
   234	  rule setVSAt(.ValSeq, _:Int, _:Val)               => .ValSeq
   235	  rule setVSAt(vCons(_:Val, S:ValSeq), 0, V:Val)    => vCons(V, S)
   236	  rule setVSAt(vCons(W:Val, S:ValSeq), I:Int, V:Val) => vCons(W, setVSAt(S, I -Int 1, V))
   237	       requires I >Int 0
   238	  rule setVSAt(VS:ValSeq, I:Int, _:Val)             => VS
   239	       requires I <Int 0
   240	endmodule
--- iter.k ---
     1	// reference/src/semantics/iter.k — MPY-ITER
     2	// The iterator protocol, DECLARATION ONLY. Each iterable's #iterNext case lives in that
     3	// iterable's own module (list/tuple/str in their modules, rangeObj in range.k, zip in
     4	// builtins.k). Consumers (the for-loop, `x in _`, sum/all/any/max/min) import this.
     5	
     6	module MPY-ITER
     7	  imports MPY-CORE
     8	  syntax KItem ::= #iterNext(Iterable) | "#iterDone" | #iterYield(Val, Iterable)
     9	endmodule
--- operators.k ---
     1	// reference/src/semantics/operators.k — MPY-OPERATORS
     2	// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
     3	// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
     4	// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
     5	
     6	module MPY-OPERATORS
     7	  imports MPY-CORE
     8	  imports MPY-ITER
     9	
    10	  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
    11	
    12	  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
    13	
    14	  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
    15	  context Compare(HOLE, _)
    16	  context Compare(_:Val, CmpOp(_, HOLE))
    17	  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
    18	
    19	  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
    20	  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
    21	
    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule
--- float.k ---
     1	// reference/src/semantics/float.k — MPY-FLOAT
     2	//
     3	// Minimal, TRUSTED float support. K/Haskell (kprove) has no usable symbolic IEEE-754 theory and
     4	// no Int2Float hook, so a float value stays an OPAQUE proof-domain primitive: `intFloatDiv(I, F)`
     5	// (the Python true division I / F) is `[no-evaluators]` for kprove — it never reduces on symbolic
     6	// input, and the proof verifies only the STRUCTURE (the result is the exact term the program
     7	// builds). The `[concrete]` rule evaluates it for krun (llvm HAS the Int2Float / /Float hooks), so
     8	// smoke tests run the real float value.
     9	//
    10	// Only the pieces needed so far: Float as a Val, the float literal, and Int / float true division
    11	// (the `a * h / 2.0` idiom). More float ops (float +/-/*, comparison) are added as float problems
    12	// need them — kept minimal + sound.
    13	
    14	module MPY-FLOAT
    15	  imports MPY-OPERATORS
    16	  imports MPY-BUILTINS
    17	  imports FLOAT
    18	
    19	  // Float is a value; the float literal evaluates to the K Float.
    20	  syntax Val ::= Float
    21	  rule <k> Float(F:Float) => F ... </k>
    22	
    23	  // Int / float true division. OPAQUE for kprove (no-evaluators); concrete for krun.
    24	  syntax Float ::= intFloatDiv(Int, Float) [function, total, symbol(intFloatDiv), no-evaluators]
    25	  rule intFloatDiv(I:Int, F:Float) => Int2Float(I, 53, 11) /Float F [concrete]
    26	
    27	  rule applyBin("/", I:Int, F:Float) => intFloatDiv(I, F)
    28	
    29	  // Int / Int true division (Python: always a float). OPAQUE for kprove; concrete for krun.
    30	  syntax Float ::= divII(Int, Int) [function, total, symbol(divII), no-evaluators]
    31	  rule divII(I1:Int, I2:Int) => Int2Float(I1, 53, 11) /Float Int2Float(I2, 53, 11) [concrete]
    32	  rule applyBin("/", I1:Int, I2:Int) => divII(I1, I2)
    33	
    34	  // float % float (e.g. `number % 1.0` = the fractional part). OPAQUE for kprove, concrete for
    35	  // krun. Python's float `%` is floor-based: a % b = a - floor(a/b)*b (K's %Float is IEEE
    36	  // remainder, which differs — 3.5 %Float 1.0 = -0.5 vs Python 0.5 — so it is NOT used).
    37	  syntax Float ::= floatMod(Float, Float) [function, total, symbol(floatMod), no-evaluators]
    38	  rule floatMod(F1:Float, F2:Float) => F1 -Float (floorFloat(F1 /Float F2) *Float F2) [concrete]
    39	  rule applyBin("%", F1:Float, F2:Float) => floatMod(F1, F2)
    40	
    41	  // float equality — for concrete krun asserts (e.g. `area == 7.5`); the FLOAT.eq hook is fine on
    42	  // concrete floats. kprove proofs return floats structurally and do not compare them.
    43	  rule applyCmp("==", F1:Float, F2:Float) => F1 ==Float F2
    44	  rule applyCmp("!=", F1:Float, F2:Float) => notBool (F1 ==Float F2)
    45	
    46	  // float `<` and abs — OPAQUE for kprove ([no-evaluators], so a SYMBOLIC float compare stays an
    47	  // uninterpreted Bool a proof case-splits on — a SINGLE compare per branch, not a nonlinear cascade),
    48	  // [concrete] for krun. Additive, sort-disjoint from the Int rules. (has_close_elements: the pairwise
    49	  // `abs(a-b) < t` proximity test.)
    50	  syntax Bool ::= floatLt(Float, Float) [function, total, symbol(floatLt), no-evaluators]
    51	  rule floatLt(F1:Float, F2:Float) => F1 <Float F2 [concrete]
    52	  rule applyCmp("<", F1:Float, F2:Float) => floatLt(F1, F2)
    53	
    54	  syntax Float ::= absF(Float) [function, total, symbol(absF), no-evaluators]
    55	  rule absF(F:Float) => absFloat(F) [concrete]
    56	  rule applyBuiltin("abs", F:Float, .Vals) => absF(F)
    57	
    58	  // ==== math.ceil ===========================================================
    59	  // `import X` is a no-op (we intercept the specific math functions syntactically; `math` itself is
    60	  // never bound as a value).
    61	  rule <k> Import(_:String) => .K ... </k>
    62	
    63	  // math.ceil(x): ceiling to an int. Intercepted at the Call BEFORE `math` is looked up (higher
    64	  // priority than the generic Attribute/method dispatch in call.k).
    65	  syntax KItem ::= "#mathCeil"
    66	  rule <k> Call(Attribute(Name("math"), "ceil"), (E:Expr, .Exprs)) => E ~> #mathCeil ... </k> [priority(40)]
    67	  rule <k> V:Val ~> #mathCeil => ceilF(V) ... </k>
    68	
    69	  // math.floor(x) — same interception shape as math.ceil
    70	  syntax KItem ::= "#mathFloor"
    71	  rule <k> Call(Attribute(Name("math"), "floor"), (E:Expr, .Exprs)) => E ~> #mathFloor ... </k> [priority(40)]
    72	  rule <k> V:Val ~> #mathFloor => floorFI(V) ... </k>
    73	  syntax Int ::= floorFI(Val) [function, total, symbol(floorFI)]
    74	  rule floorFI(I:Int)   => I                        [concrete]
    75	  rule floorFI(F:Float) => Float2Int(floorFloat(F)) [concrete]
    76	
    77	  // bare floor/ceil (bound by `from math import floor, ceil`)
    78	  rule applyBuiltin("floor", V:Val, .Vals) => floorFI(V)
    79	  rule applyBuiltin("ceil",  V:Val, .Vals) => ceilF(V)
    80	
    81	  // math.pow(x, y) — a two-arg interception onto powF (ints promote)
    82	  syntax KItem ::= #mathPow1(Expr) | #mathPow2(Val)
    83	  rule <k> Call(Attribute(Name("math"), "pow"), (E1:Expr, E2:Expr, .Exprs)) => E1 ~> #mathPow1(E2) ... </k> [priority(40)]
    84	  rule <k> V1:Val ~> #mathPow1(E2:Expr) => E2 ~> #mathPow2(V1) ... </k>
    85	  rule <k> V2:Val ~> #mathPow2(V1:Val) => powF(toF(V1), toF(V2)) ... </k>
    86	  syntax Float ::= toF(Val) [function, total, symbol(toF)]
    87	  rule toF(F:Float) => F        [concrete]
    88	  rule toF(I:Int)   => intToF(I) [concrete]
    89	
    90	  // ceilF: math.ceil as an Int. TOTAL (K trusts it; a symbolic list element stays opaque for
    91	  // kprove — structural). [concrete] so the Int2Float/ceilFloat hooks only run for krun (llvm).
    92	  // Matches Python incl. negatives: ceil(-2.4) = -2 = Float2Int(ceilFloat(-2.4)).
    93	  syntax Int ::= ceilF(Val) [function, total, symbol(ceilF)]
    94	  rule ceilF(I:Int)   => I                       [concrete]
    95	  rule ceilF(F:Float) => Float2Int(ceilFloat(F)) [concrete]
    96	
    97	  // unary minus on a float (e.g. the literal -2.4 = UnaryOp("-", Float(2.4))). Concrete for krun;
    98	  // proofs use symbolic elements, never a float literal.
    99	  rule applyUn("-", F:Float) => 0.0 -Float F
   100	
   101	  // ---- float - / / / + (OPAQUE for kprove [no-evaluators], concrete for krun) — for float-list
   102	  // element maps (x - lo) / (hi - lo). Mirror intFloatDiv: additive, sort-disjoint from the Int rules.
   103	  syntax Float ::= subF(Float, Float) [function, total, symbol(subF), no-evaluators]
   104	  rule subF(F1:Float, F2:Float) => F1 -Float F2 [concrete]
   105	  rule applyBin("-", F1:Float, F2:Float) => subF(F1, F2)
   106	
   107	  syntax Float ::= divF(Float, Float) [function, total, symbol(divF), no-evaluators]
   108	  rule divF(F1:Float, F2:Float) => F1 /Float F2 [concrete]
   109	  rule applyBin("/", F1:Float, F2:Float) => divF(F1, F2)
   110	
   111	  syntax Float ::= addF(Float, Float) [function, total, symbol(addF), no-evaluators]
   112	  rule addF(F1:Float, F2:Float) => F1 +Float F2 [concrete]
   113	  rule applyBin("+", F1:Float, F2:Float) => addF(F1, F2)
   114	
   115	  syntax Float ::= mulF(Float, Float) [function, total, symbol(mulF), no-evaluators]
   116	  rule mulF(F1:Float, F2:Float) => F1 *Float F2 [concrete]
   117	  rule applyBin("*", F1:Float, F2:Float) => mulF(F1, F2)
   118	
   119	  syntax Float ::= powF(Float, Float) [function, total, symbol(powF), no-evaluators]
   120	  rule powF(F1:Float, F2:Float) => F1 ^Float F2 [concrete]
   121	  rule applyBin("**", F1:Float, F2:Float) => powF(F1, F2)
   122	
   123	  // ---- the remaining comparisons (gtF promoted from find_zero — its summaries
   124	  //      case-split on the atom; >= / <= derive from the two opaque compares) ----
   125	  syntax Bool ::= gtF(Float, Float) [function, total, symbol(gtF), no-evaluators]
   126	  rule gtF(F1:Float, F2:Float) => F1 >Float F2 [concrete]
   127	  rule applyCmp(">",  F1:Float, F2:Float) => gtF(F1, F2)
   128	  rule applyCmp(">=", F1:Float, F2:Float) => notBool floatLt(F1, F2)
   129	  rule applyCmp("<=", F1:Float, F2:Float) => notBool gtF(F1, F2)
   130	
   131	  // ---- mixed Int/Float operators promote the Int side (n ** 0.5 etc.) ----
   132	  rule applyBin("**", I:Int, F:Float) => powF(intToF(I), F)
   133	  rule applyBin("**", F:Float, I:Int) => powF(F, intToF(I))
   134	  rule applyBin("-",  I:Int, F:Float) => subF(intToF(I), F)
   135	  rule applyBin("-",  F:Float, I:Int) => subF(F, intToF(I))
   136	  rule applyBin("+",  I:Int, F:Float) => addF(intToF(I), F)
   137	  rule applyBin("+",  F:Float, I:Int) => addF(F, intToF(I))
   138	  rule applyBin("*",  I:Int, F:Float) => mulF(intToF(I), F)
   139	  rule applyBin("*",  F:Float, I:Int) => mulF(F, intToF(I))
   140	
   141	  // ---- mixed Int == Float (shared eqF; opaque symbolic / concrete twin) ----
   142	  syntax Bool ::= eqF(Float, Float) [function, total, symbol(eqF), no-evaluators]
   143	  rule eqF(F1:Float, F2:Float) => F1 ==Float F2 [concrete]
   144	  rule applyCmp("==", I:Int, F:Float) => eqF(intToF(I), F)
   145	  rule applyCmp("==", F:Float, I:Int) => eqF(F, intToF(I))
   146	  rule applyCmp("!=", I:Int, F:Float) => notBool eqF(intToF(I), F)
   147	  rule applyCmp("!=", F:Float, I:Int) => notBool eqF(F, intToF(I))
   148	  rule applyCmp("<",  I:Int, F:Float) => floatLt(intToF(I), F)
   149	  rule applyCmp("<",  F:Float, I:Int) => floatLt(F, intToF(I))
   150	  rule applyCmp(">",  I:Int, F:Float) => gtF(intToF(I), F)
   151	  rule applyCmp(">",  F:Float, I:Int) => gtF(F, intToF(I))
   152	
   153	  // ---- x == None (promoted from 137; `is` cases live in operators.k) ----
   154	  rule applyCmp("==", V:Val, noneV) => V ==K noneV
   155	  rule applyCmp("!=", V:Val, noneV) => notBool (V ==K noneV)
   156	
   157	  // ---- float(str): decimal parse (promoted from 137's defined chain) ----
   158	  // digits '.' digits, optional leading '-'; concrete evaluation only (the
   159	  // symbolic side stays an opaque decStrToF term a proof case-splits on).
   160	  syntax Float ::= decStrToF(IntSeq) [function, total, symbol(decStrToF), no-evaluators]
   161	  rule decStrToF(iCons(45, CS:IntSeq)) => 0.0 -Float decStrToF(CS) [concrete]
   162	  rule decStrToF(CS:IntSeq)
   163	    => intToF(intPart(CS)) +Float (intToF(fracPart(CS)) /Float intToF(fracScale(CS)))
   164	       requires isLen(CS) >Int 0 andBool headIS(CS) =/=Int 45 [concrete]
   165	  syntax Int ::= headIS(IntSeq) [function]
   166	  rule headIS(iCons(C:Int, _:IntSeq)) => C
   167	  syntax Int ::= intPart(IntSeq) [function, total] | intPartAcc(IntSeq, Int) [function, total]
   168	  rule intPart(CS:IntSeq) => intPartAcc(CS, 0)
   169	  rule intPartAcc(.IntSeq, A:Int) => A
   170	  rule intPartAcc(iCons(46, _:IntSeq), A:Int) => A
   171	  rule intPartAcc(iCons(C:Int, R:IntSeq), A:Int) => intPartAcc(R, A *Int 10 +Int (C -Int 48))
   172	       requires C =/=Int 46
   173	  syntax Int ::= fracPart(IntSeq) [function, total] | fracAcc(IntSeq, Int) [function, total]
   174	  rule fracPart(.IntSeq) => 0
   175	  rule fracPart(iCons(46, R:IntSeq)) => fracAcc(R, 0)
   176	  rule fracPart(iCons(C:Int, R:IntSeq)) => fracPart(R) requires C =/=Int 46
   177	  rule fracAcc(.IntSeq, A:Int) => A
   178	  rule fracAcc(iCons(C:Int, R:IntSeq), A:Int) => fracAcc(R, A *Int 10 +Int (C -Int 48))
   179	  syntax Int ::= fracScale(IntSeq) [function, total] | fscAcc(IntSeq, Int) [function, total]
   180	  rule fracScale(.IntSeq) => 1
   181	  rule fracScale(iCons(46, R:IntSeq)) => fscAcc(R, 1)
   182	  rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46
   183	  rule fscAcc(.IntSeq, A:Int) => A
   184	  rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)
   185	  rule applyBuiltin("float", str(CS:IntSeq), .Vals) => decStrToF(CS)
   186	  rule applyBuiltin("float", I:Int, .Vals)          => intToF(I)
   187	  rule applyBuiltin("float", F:Float, .Vals)        => F
   188	
   189	  // ---- float / int division (promoted from mean_absolute_deviation) ----
   190	  syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]
   191	  rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]
   192	  rule applyBin("/", F:Float, I:Int) => divFloatIntV(F, I)
   193	
   194	  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----
   195	  syntax Float ::= intToF(Int) [function, total, symbol(intToF), no-evaluators]
   196	  rule intToF(I:Int) => Int2Float(I, 53, 11) [concrete]
   197	  rule applyBin("+", I:Int, F:Float) => addF(intToF(I), F)
   198	  rule applyBin("+", F:Float, I:Int) => addF(F, intToF(I))
   199	  rule applyBin("-", I:Int, F:Float) => subF(intToF(I), F)
   200	  rule applyBin("-", F:Float, I:Int) => subF(F, intToF(I))
   201	  rule applyBin("*", I:Int, F:Float) => mulF(intToF(I), F)
   202	  rule applyBin("*", F:Float, I:Int) => mulF(F, intToF(I))
   203	  rule applyCmp("<", I:Int, F:Float) => floatLt(intToF(I), F)
   204	  rule applyCmp("<", F:Float, I:Int) => floatLt(F, intToF(I))
   205	  rule applyCmp(">", I:Int, F:Float) => gtF(intToF(I), F)
   206	  rule applyCmp(">", F:Float, I:Int) => gtF(F, intToF(I))
   207	
   208	  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----
   209	  syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]
   210	  rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]
   211	  rule applyBuiltin("int", F:Float, .Vals) => truncF(F)
   212	
   213	  rule applyBuiltin("float", I:Int, .Vals)   => intToF(I)
   214	  rule applyBuiltin("float", F:Float, .Vals) => F
   215	
   216	  // round: Python half-even (banker's); round(F, N) scales by 10^N
   217	  syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]
   218	  rule roundF(F:Float)
   219	    => #if (F -Float floorFloat(F)) ==Float 0.5
   220	       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
   221	              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
   222	       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
   223	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   224	  rule roundFN(F:Float, N:Int)
   225	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   226	       /Float Int2Float(10 ^Int N, 53, 11) [concrete]
   227	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   228	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   229	
   230	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   231	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   232	  syntax KItem ::= "#mathSqrt"
   233	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   234	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   235	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   236	
   237	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   238	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   239	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   240	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   241	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   242	  // the isFloat guard is disjoint from the existing isInt one.
   243	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   244	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   245	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   246	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   247	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   248	       requires isFloat(V)
   249	
   250	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   251	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   252	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   253	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   254	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   255	       requires isFloat(V)
   256	
   257	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   258	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   259	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   260	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   261	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   262	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   263	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   264	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   265	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   266	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   267	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   268	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   269	       requires isFloat(V)
   270	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   271	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   272	       requires isInt(V) orBool isBool(V)
   273	endmodule

diff --git a/evidence/differential_audit.py b/evidence/differential_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..92f598bef17ec63c37fcc9778e29606e6cef58d3
--- /dev/null
+++ b/evidence/differential_audit.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Independent canonical-vs-candidate differential audit.
+
+The input corpus is deterministically written to the path supplied as argv[1].
+It imports the trusted canonical entry point and the scratch-copied candidate
+entry point as distinct modules.
+"""
+
+import importlib.util
+import itertools
+import json
+import math
+import random
+import sys
+from pathlib import Path
+
+
+def import_function(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.has_close_elements
+
+
+def encoded(value):
+    if isinstance(value, float):
+        if math.isnan(value):
+            return "NaN"
+        if value == math.inf:
+            return "+Infinity"
+        if value == -math.inf:
+            return "-Infinity"
+        if value == 0.0 and math.copysign(1.0, value) < 0:
+            return "-0.0"
+    return value
+
+
+def record_case(label, numbers, threshold):
+    return {
+        "label": label,
+        "numbers": list(numbers),
+        "threshold": threshold,
+    }
+
+
+def outcome(function, numbers, threshold):
+    try:
+        return ("return", function(list(numbers), threshold))
+    except Exception as error:  # compare exceptions without hiding them
+        return ("exception", type(error).__name__, str(error))
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: differential_audit.py INPUTS_JSON")
+
+    canonical = import_function(
+        "trusted_canonical_audit", Path("/tmp/audit-work/0-has-close-elements/canonical.py")
+    )
+    candidate = import_function(
+        "candidate_solution_audit", Path("/tmp/audit-work/0-has-close-elements/solution.py")
+    )
+
+    cases = [
+        record_case("prompt-false", [1.0, 2.0, 3.0], 0.5),
+        record_case("prompt-true", [1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3),
+        record_case("empty", [], 1.0),
+        record_case("singleton", [1.0], 1.0),
+        record_case("i-less-j-false-only", [7.0], 10.0),
+        record_case("distance-equals-threshold", [0.0, 1.0], 1.0),
+        record_case("distance-just-inside", [0.0, math.nextafter(1.0, 0.0)], 1.0),
+        record_case("distance-just-outside", [0.0, math.nextafter(1.0, math.inf)], 1.0),
+        record_case("duplicate-zero-threshold", [1.0, 1.0], 0.0),
+        record_case("duplicate-positive-threshold", [1.0, 1.0], 0.01),
+        record_case("negative-threshold", [-2.0, -1.9], -0.1),
+        record_case("negative-and-positive", [-2.0, 2.0, -1.9], 0.2),
+        record_case("negative-zero", [-0.0, 0.0], 0.0),
+        record_case("negative-zero-positive-threshold", [-0.0, 0.0], 5e-324),
+        record_case("positive-infinities", [math.inf, math.inf], 1.0),
+        record_case("opposite-infinities", [-math.inf, math.inf], math.inf),
+        record_case("nan-list", [math.nan, 0.0, math.nan], math.inf),
+        record_case("nan-threshold", [0.0, 0.0], math.nan),
+    ]
+
+    values = [-2.0, -0.5, -0.0, 0.0, 0.5, 2.0]
+    thresholds = [-1.0, 0.0, 5e-324, 0.1, 0.5, 1.0, 2.5]
+    for length in range(5):
+        for numbers in itertools.product(values, repeat=length):
+            for threshold in thresholds:
+                cases.append(record_case(f"exhaustive-len-{length}", numbers, threshold))
+
+    rng = random.Random(23071983)
+    for index in range(2000):
+        length = rng.randrange(0, 10)
+        numbers = [rng.uniform(-1e6, 1e6) for _ in range(length)]
+        threshold = rng.uniform(-100.0, 1e6)
+        cases.append(record_case(f"seeded-random-{index}", numbers, threshold))
+
+    serializable_cases = [
+        {
+            "label": case["label"],
+            "numbers": [encoded(value) for value in case["numbers"]],
+            "threshold": encoded(case["threshold"]),
+        }
+        for case in cases
+    ]
+    Path(sys.argv[1]).write_text(
+        json.dumps(serializable_cases, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+
+    mismatches = []
+    branch_results = {"canonical_true": 0, "canonical_false": 0}
+    for index, case in enumerate(cases):
+        expected = outcome(canonical, case["numbers"], case["threshold"])
+        actual = outcome(candidate, case["numbers"], case["threshold"])
+        if expected == ("return", True):
+            branch_results["canonical_true"] += 1
+        if expected == ("return", False):
+            branch_results["canonical_false"] += 1
+        if expected != actual:
+            mismatches.append(
+                {
+                    "index": index,
+                    "case": serializable_cases[index],
+                    "canonical": expected,
+                    "candidate": actual,
+                }
+            )
+
+    print("canonical_path=/tmp/audit-work/0-has-close-elements/canonical.py")
+    print("candidate_path=/tmp/audit-work/0-has-close-elements/solution.py")
+    print(f"documented_and_boundary_cases=18")
+    print(f"total_cases={len(cases)}")
+    print(f"branch_results={json.dumps(branch_results, sort_keys=True)}")
+    print(f"mismatches={len(mismatches)}")
+    if mismatches:
+        print(json.dumps(mismatches[:10], indent=2, default=encoded))
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a600ca3f468e057535905882cc0102b063737321
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+candidate=/candidate
+reference=/reference
+
+printf '%s\n' '$ stat -c "%F %a %s %n" <trusted and required candidate artifacts>'
+stat -c '%F %a %s %n' \
+  "$reference/canonical.py" \
+  "$reference/prompt.py" \
+  "$reference/py2mpy.py" \
+  "$reference/reference-semantics" \
+  "$candidate/run-input.json" \
+  "$candidate/metrics.json" \
+  "$candidate/codex-last.txt" \
+  "$candidate/codex-output.log" \
+  "$candidate/prompt.py" \
+  "$candidate/py2mpy.py" \
+  "$candidate/solution.py" \
+  "$candidate/solution.mpy" \
+  "$candidate/verification.k" \
+  "$candidate/spec.k" \
+  "$candidate/prove.sh" \
+  "$candidate/PROOF.md"
+printf 'stat_exit=%s\n' "$?"
+
+printf '%s\n' '$ find -P /candidate -type l -printf ...'
+find -P "$candidate" -type l -printf '%p -> %l\n'
+printf 'candidate_symlink_find_exit=%s\n' "$?"
+
+printf '%s\n' '$ find -P <semantics trees> ! -type d ! -type f -printf ...'
+find -P "$candidate/reference-semantics" ! -type d ! -type f \
+  -printf 'candidate-special: %y %p -> %l\n'
+candidate_special_status=$?
+find -P "$reference/reference-semantics" ! -type d ! -type f \
+  -printf 'reference-special: %y %p -> %l\n'
+reference_special_status=$?
+printf 'candidate_special_find_exit=%s reference_special_find_exit=%s\n' \
+  "$candidate_special_status" "$reference_special_status"
+
+printf '%s\n' '$ diff --no-dereference -rqs /reference/reference-semantics /candidate/reference-semantics'
+diff --no-dereference -rqs \
+  "$reference/reference-semantics" "$candidate/reference-semantics"
+printf 'semantics_diff_exit=%s\n' "$?"
+
+printf '%s\n' '$ cmp -s trusted candidate prompt/translator'
+cmp -s "$reference/prompt.py" "$candidate/prompt.py"
+printf 'prompt_cmp_exit=%s\n' "$?"
+cmp -s "$reference/py2mpy.py" "$candidate/py2mpy.py"
+printf 'translator_cmp_exit=%s\n' "$?"
+sha256sum \
+  "$reference/prompt.py" "$candidate/prompt.py" \
+  "$reference/py2mpy.py" "$candidate/py2mpy.py"
+
+printf '%s\n' '$ python3 - <parse run-input, metrics, and trace JSON>'
+python3 - <<'PY'
+import json
+from collections import Counter
+from pathlib import Path
+
+for name in ("run-input.json", "metrics.json"):
+    path = Path("/candidate") / name
+    with path.open(encoding="utf-8") as stream:
+        data = json.load(stream)
+    print(f"{name}: {json.dumps(data, sort_keys=True)}")
+
+trace_paths = sorted(Path("/candidate/codex-trace").rglob("*.jsonl"))
+print("trace_paths:", [str(path) for path in trace_paths])
+for path in trace_paths:
+    counts = Counter()
+    first = None
+    last = None
+    rows = 0
+    parse_errors = 0
+    with path.open(encoding="utf-8") as stream:
+        for line in stream:
+            rows += 1
+            try:
+                obj = json.loads(line)
+            except json.JSONDecodeError:
+                parse_errors += 1
+                continue
+            if first is None:
+                first = obj
+            last = obj
+            counts[obj.get("type", "<missing>")] += 1
+    print("trace_summary:", path, "rows=", rows, "parse_errors=", parse_errors)
+    print("trace_types:", dict(sorted(counts.items())))
+    print("trace_first_type:", None if first is None else first.get("type"))
+    print("trace_last_type:", None if last is None else last.get("type"))
+PY
+printf 'json_parse_exit=%s\n' "$?"
+
+printf '%s\n' '$ wc -lc and sha256sum generation logs'
+mapfile -t trace_logs < <(
+  find -P "$candidate/codex-trace" -type f -name '*.jsonl' -print | sort
+)
+wc -lc "$candidate/codex-output.log" "${trace_logs[@]}"
+printf 'wc_exit=%s\n' "$?"
+sha256sum "$candidate/codex-output.log"
+sha256sum "${trace_logs[@]}"
+printf 'log_hash_exit=%s\n' "$?"
+
+printf '%s\n' '$ grep bounded generation claims from codex-output.log'
+grep -nE '^(RESULT:|VALIDATED$|#Top$|differential cases:|mismatches:|EXPECTED FAILURE:)|Four positive claims|KPROVE_PASSED' \
+  "$candidate/codex-output.log" | tail -n 80
+printf 'bounded_claim_grep_exit=%s\n' "$?"
+
+printf '%s\n' 'stage1_script_exit=0'
diff --git a/evidence/stage2_fidelity.sh b/evidence/stage2_fidelity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f66ad402c91447a9b06c81faa695b346ded5501d
--- /dev/null
+++ b/evidence/stage2_fidelity.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/0-has-close-elements
+evidence=/audit-output/evidence
+
+printf '%s\n' '$ python3 /reference/py2mpy.py scratch/solution.py > scratch/regenerated-solution.mpy'
+python3 /reference/py2mpy.py "$scratch/solution.py" \
+  > "$scratch/regenerated-solution.mpy"
+translate_status=$?
+printf 'translator_exit=%s\n' "$translate_status"
+
+printf '%s\n' '$ cmp -s scratch/regenerated-solution.mpy scratch/solution.mpy'
+cmp -s "$scratch/regenerated-solution.mpy" "$scratch/solution.mpy"
+cmp_status=$?
+printf 'solution_mpy_cmp_exit=%s\n' "$cmp_status"
+sha256sum "$scratch/regenerated-solution.mpy" "$scratch/solution.mpy"
+
+printf '%s\n' '$ python3 -m py_compile scratch/canonical.py scratch/solution.py evidence/differential_audit.py'
+PYTHONPYCACHEPREFIX="$scratch/pycache" \
+  python3 -m py_compile \
+    "$scratch/canonical.py" \
+    "$scratch/solution.py" \
+    "$evidence/differential_audit.py"
+compile_status=$?
+printf 'python_compile_exit=%s\n' "$compile_status"
+
+printf '%s\n' '$ python3 evidence/differential_audit.py evidence/differential-inputs.json'
+python3 "$evidence/differential_audit.py" \
+  "$evidence/differential-inputs.json"
+differential_status=$?
+printf 'differential_exit=%s\n' "$differential_status"
+wc -lc "$evidence/differential-inputs.json"
+sha256sum "$evidence/differential-inputs.json"
+
+if (( translate_status != 0 || cmp_status != 0 ||
+      compile_status != 0 || differential_status != 0 )); then
+  printf '%s\n' 'stage2_script_exit=1'
+  exit 1
+fi
+printf '%s\n' 'stage2_script_exit=0'
diff --git a/evidence/stage3_reconstruct.sh b/evidence/stage3_reconstruct.sh
new file mode 100644
index 0000000000000000000000000000000000000000..91c785edacdce4bc64916fe7305deb4eea41afa6
--- /dev/null
+++ b/evidence/stage3_reconstruct.sh
@@ -0,0 +1,133 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/0-has-close-elements
+evidence=/audit-output/evidence
+failures=0
+
+run_bounded() {
+  local label=$1
+  shift
+  local raw="$scratch/${label}.raw.log"
+  local log="$evidence/${label}.log"
+
+  {
+    printf '$'
+    printf ' %q' "$@"
+    printf '\n'
+  } > "$log"
+
+  "$@" > "$raw" 2>&1
+  local status=$?
+  local lines bytes
+  lines=$(wc -l < "$raw")
+  bytes=$(wc -c < "$raw")
+  {
+    printf 'exit_status=%s\n' "$status"
+    printf 'raw_output_lines=%s raw_output_bytes=%s\n' "$lines" "$bytes"
+    if (( lines <= 320 )); then
+      cat "$raw"
+    else
+      printf '%s\n' '--- first 140 lines ---'
+      head -n 140 "$raw"
+      printf '%s\n' '--- middle omitted from bounded reviewer log ---'
+      printf '%s\n' '--- last 160 lines ---'
+      tail -n 160 "$raw"
+    fi
+  } >> "$log"
+  rm -f "$raw"
+  printf '%s exit=%s lines=%s bytes=%s\n' "$label" "$status" "$lines" "$bytes"
+  return "$status"
+}
+
+printf '%s\n' '$ find scratch for preexisting compiled definitions/caches'
+find -P "$scratch" -maxdepth 2 \
+  \( -iname '*kompiled*' -o -iname '*cache*' \) -print | sort
+printf 'prebuild_find_exit=%s\n' "$?"
+
+cd "$scratch" || exit 1
+export PATH="$HOME/.nix-profile/bin:$PATH"
+
+run_bounded stage3-build-llvm \
+  kompile reference-semantics/semantics.k \
+    --backend llvm \
+    --main-module MPY-KRUN \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-runtime-kompiled ||
+  failures=$((failures + 1))
+
+run_bounded stage3-build-verification-base \
+  kompile --backend haskell verification.k \
+    --main-module VERIFICATION-BASE \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-verification-base-kompiled ||
+  failures=$((failures + 1))
+
+run_bounded stage3-prove-inner \
+  kprove spec.k \
+    --definition audit-verification-base-kompiled \
+    --spec-module SPEC-INNER ||
+  failures=$((failures + 1))
+if ! grep -Fxq '#Top' "$evidence/stage3-prove-inner.log"; then
+  printf '%s\n' 'missing_exact_top=1' >> "$evidence/stage3-prove-inner.log"
+  failures=$((failures + 1))
+else
+  printf '%s\n' 'exact_top=1' >> "$evidence/stage3-prove-inner.log"
+fi
+
+run_bounded stage3-build-verification-inner \
+  kompile --backend haskell verification.k \
+    --main-module VERIFICATION-INNER \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-verification-inner-kompiled ||
+  failures=$((failures + 1))
+
+run_bounded stage3-prove-outer-state \
+  kprove spec.k \
+    --definition audit-verification-inner-kompiled \
+    --spec-module SPEC-OUTER-STATE ||
+  failures=$((failures + 1))
+if ! grep -Fxq '#Top' "$evidence/stage3-prove-outer-state.log"; then
+  printf '%s\n' 'missing_exact_top=1' >> "$evidence/stage3-prove-outer-state.log"
+  failures=$((failures + 1))
+else
+  printf '%s\n' 'exact_top=1' >> "$evidence/stage3-prove-outer-state.log"
+fi
+
+run_bounded stage3-prove-outer-control \
+  kprove spec.k \
+    --definition audit-verification-inner-kompiled \
+    --spec-module SPEC-OUTER ||
+  failures=$((failures + 1))
+if ! grep -Fxq '#Top' "$evidence/stage3-prove-outer-control.log"; then
+  printf '%s\n' 'missing_exact_top=1' >> "$evidence/stage3-prove-outer-control.log"
+  failures=$((failures + 1))
+else
+  printf '%s\n' 'exact_top=1' >> "$evidence/stage3-prove-outer-control.log"
+fi
+
+run_bounded stage3-build-verification \
+  kompile --backend haskell verification.k \
+    --main-module VERIFICATION \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-verification-kompiled ||
+  failures=$((failures + 1))
+
+run_bounded stage3-prove-target \
+  kprove spec.k \
+    --definition audit-verification-kompiled \
+    --spec-module SPEC ||
+  failures=$((failures + 1))
+if ! grep -Fxq '#Top' "$evidence/stage3-prove-target.log"; then
+  printf '%s\n' 'missing_exact_top=1' >> "$evidence/stage3-prove-target.log"
+  failures=$((failures + 1))
+else
+  printf '%s\n' 'exact_top=1' >> "$evidence/stage3-prove-target.log"
+fi
+
+printf 'reconstruction_failures=%s\n' "$failures"
+if (( failures != 0 )); then
+  printf '%s\n' 'stage3_script_exit=1'
+  exit 1
+fi
+printf '%s\n' 'stage3_script_exit=0'

exec
/bin/bash -lc 'export PATH="$HOME/.nix-profile/bin:$PATH"
krun solution.mpy --definition audit-runtime-kompiled' in /tmp/audit-work/0-has-close-elements
