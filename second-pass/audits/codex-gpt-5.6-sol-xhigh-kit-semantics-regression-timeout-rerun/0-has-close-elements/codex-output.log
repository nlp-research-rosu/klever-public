     1	from itertools import combinations, product
     2	from random import Random
     3	
     4	from solution import has_close_elements
     5	
     6	
     7	def oracle(numbers, threshold):
     8	    return any(abs(left - right) < threshold
     9	               for left, right in combinations(numbers, 2))
    10	
    11	
    12	cases = [
    13	    ([1.0, 2.0, 3.0], 0.5),
    14	    ([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3),
    15	    ([], 1.0),
    16	    ([1.0], 1.0),
    17	    ([1.0, 1.0], 0.0),
    18	    ([1.0, 1.0], 0.01),
    19	    ([-2.0, 2.0, -1.9], 0.2),
    20	]
    21	
    22	values = [-2.0, -0.5, 0.0, 0.5, 2.0]
    23	thresholds = [-1.0, 0.0, 0.1, 0.5, 1.0, 2.5]
    24	for length in range(5):
    25	    for numbers in product(values, repeat=length):
    26	        for threshold in thresholds:
    27	            cases.append((list(numbers), threshold))
    28	
    29	rng = Random(20260723)
    30	for _ in range(1000):
    31	    length = rng.randrange(9)
    32	    numbers = [rng.uniform(-100.0, 100.0) for _ in range(length)]
    33	    threshold = rng.uniform(-2.0, 30.0)
    34	    cases.append((numbers, threshold))
    35	
    36	mismatches = []
    37	for numbers, threshold in cases:
    38	    expected = oracle(numbers, threshold)
    39	    actual = has_close_elements(numbers, threshold)
    40	    if actual != expected:
    41	        mismatches.append((numbers, threshold, expected, actual))
    42	
    43	print("differential cases:", len(cases))
    44	print("mismatches:", len(mismatches))
    45	if mismatches:
    46	    raise AssertionError(mismatches[:5])
