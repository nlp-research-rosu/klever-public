+    --spec-module AUDIT-INNER-CONTEXT-EXTENDED
+if (( LAST_STATUS != 0 )) ||
+   ! grep -Fxq '#Top' "$evidence/stage5-inner-context-extended.log"; then
+  failures=$((failures + 1))
+fi
+
+run_bounded stage5-outer-context-base \
+  kprove operational-context.k \
