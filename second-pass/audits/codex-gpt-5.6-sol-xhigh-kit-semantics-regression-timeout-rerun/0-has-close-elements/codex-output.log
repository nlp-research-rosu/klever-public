+
+printf '%s\n' '$ cmp -s trusted candidate prompt/translator'
+cmp -s "$reference/prompt.py" "$candidate/prompt.py"
+printf 'prompt_cmp_exit=%s\n' "$?"
+cmp -s "$reference/py2mpy.py" "$candidate/py2mpy.py"
+printf 'translator_cmp_exit=%s\n' "$?"
+sha256sum \
