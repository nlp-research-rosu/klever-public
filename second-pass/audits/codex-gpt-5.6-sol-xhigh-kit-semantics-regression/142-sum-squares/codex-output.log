0026:   // parent is the module scope (0) — sound after the defining frame dies.
0027:   syntax Val ::= closureValC(ParamNames, ParamNames, Stmts, Map)
0028: 
0029:   // capture: resolve each freevar to the enclosing frame's cellRef, then bind
