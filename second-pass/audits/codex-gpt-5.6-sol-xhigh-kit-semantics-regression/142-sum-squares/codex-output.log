#!/bin/sh
set -eu

expect_stuck() {
  label=$1
  shift
  log="${label}.log"
  set +e
  "$@" >"$log" 2>&1
  status=$?
  set -e
  if [ "$status" -eq 0 ]; then
    echo "$label unexpectedly passed"
    cat "$log"
    exit 1
  fi
  if ! grep -q "WarnStuckClaimState" "$log"; then
    echo "$label failed without a stuck-claim residual"
    cat "$log"
    exit 1
  fi
  echo "$label expected failure: exit $status, WarnStuckClaimState"
}

