+  exit 2
+fi
+
+log=$1
+shift
+
+exec > >(tee "$log") 2>&1
+printf 'WORKDIR: %q\n' "$PWD"
+printf 'COMMAND:'
+printf ' %q' "$@"
+printf '\n'
+printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
