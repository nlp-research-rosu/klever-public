0001: // reference/src/semantics/float.k — MPY-FLOAT
0002: //
0003: // Minimal, TRUSTED float support. K/Haskell (kprove) has no usable symbolic IEEE-754 theory and
0004: // no Int2Float hook, so a float value stays an OPAQUE proof-domain primitive: `intFloatDiv(I, F)`
0005: // (the Python true division I / F) is `[no-evaluators]` for kprove — it never reduces on symbolic
0006: // input, and the proof verifies only the STRUCTURE (the result is the exact term the program
0007: // builds). The `[concrete]` rule evaluates it for krun (llvm HAS the Int2Float / /Float hooks), so
0008: // smoke tests run the real float value.
0009: //
0010: // Only the pieces needed so far: Float as a Val, the float literal, and Int / float true division
0011: // (the `a * h / 2.0` idiom). More float ops (float +/-/*, comparison) are added as float problems
0012: // need them — kept minimal + sound.
0013: 
0014: module MPY-FLOAT
0015:   imports MPY-OPERATORS
0016:   imports MPY-BUILTINS
0017:   imports FLOAT
0018: 
0019:   // Float is a value; the float literal evaluates to the K Float.
0020:   syntax Val ::= Float
0021:   rule <k> Float(F:Float) => F ... </k>
0022: 
0023:   // Int / float true division. OPAQUE for kprove (no-evaluators); concrete for krun.
0024:   syntax Float ::= intFloatDiv(Int, Float) [function, total, symbol(intFloatDiv), no-evaluators]
0025:   rule intFloatDiv(I:Int, F:Float) => Int2Float(I, 53, 11) /Float F [concrete]
0026: 
0027:   rule applyBin("/", I:Int, F:Float) => intFloatDiv(I, F)
0028: 
0029:   // Int / Int true division (Python: always a float). OPAQUE for kprove; concrete for krun.
0030:   syntax Float ::= divII(Int, Int) [function, total, symbol(divII), no-evaluators]
0031:   rule divII(I1:Int, I2:Int) => Int2Float(I1, 53, 11) /Float Int2Float(I2, 53, 11) [concrete]
0032:   rule applyBin("/", I1:Int, I2:Int) => divII(I1, I2)
0033: 
0034:   // float % float (e.g. `number % 1.0` = the fractional part). OPAQUE for kprove, concrete for
0035:   // krun. Python's float `%` is floor-based: a % b = a - floor(a/b)*b (K's %Float is IEEE
0036:   // remainder, which differs — 3.5 %Float 1.0 = -0.5 vs Python 0.5 — so it is NOT used).
0037:   syntax Float ::= floatMod(Float, Float) [function, total, symbol(floatMod), no-evaluators]
0038:   rule floatMod(F1:Float, F2:Float) => F1 -Float (floorFloat(F1 /Float F2) *Float F2) [concrete]
0039:   rule applyBin("%", F1:Float, F2:Float) => floatMod(F1, F2)
0040: 
0041:   // float equality — for concrete krun asserts (e.g. `area == 7.5`); the FLOAT.eq hook is fine on
0042:   // concrete floats. kprove proofs return floats structurally and do not compare them.
0043:   rule applyCmp("==", F1:Float, F2:Float) => F1 ==Float F2
0044:   rule applyCmp("!=", F1:Float, F2:Float) => notBool (F1 ==Float F2)
0045: 
0046:   // float `<` and abs — OPAQUE for kprove ([no-evaluators], so a SYMBOLIC float compare stays an
0047:   // uninterpreted Bool a proof case-splits on — a SINGLE compare per branch, not a nonlinear cascade),
0048:   // [concrete] for krun. Additive, sort-disjoint from the Int rules. (has_close_elements: the pairwise
0049:   // `abs(a-b) < t` proximity test.)
0050:   syntax Bool ::= floatLt(Float, Float) [function, total, symbol(floatLt), no-evaluators]
0051:   rule floatLt(F1:Float, F2:Float) => F1 <Float F2 [concrete]
0052:   rule applyCmp("<", F1:Float, F2:Float) => floatLt(F1, F2)
0053: 
0054:   syntax Float ::= absF(Float) [function, total, symbol(absF), no-evaluators]
0055:   rule absF(F:Float) => absFloat(F) [concrete]
0056:   rule applyBuiltin("abs", F:Float, .Vals) => absF(F)
0057: 
0058:   // ==== math.ceil ===========================================================
0059:   // `import X` is a no-op (we intercept the specific math functions syntactically; `math` itself is
0060:   // never bound as a value).
0061:   rule <k> Import(_:String) => .K ... </k>
0062: 
0063:   // math.ceil(x): ceiling to an int. Intercepted at the Call BEFORE `math` is looked up (higher
0064:   // priority than the generic Attribute/method dispatch in call.k).
0065:   syntax KItem ::= "#mathCeil"
0066:   rule <k> Call(Attribute(Name("math"), "ceil"), (E:Expr, .Exprs)) => E ~> #mathCeil ... </k> [priority(40)]
0067:   rule <k> V:Val ~> #mathCeil => ceilF(V) ... </k>
0068: 
0069:   // math.floor(x) — same interception shape as math.ceil
0070:   syntax KItem ::= "#mathFloor"
0071:   rule <k> Call(Attribute(Name("math"), "floor"), (E:Expr, .Exprs)) => E ~> #mathFloor ... </k> [priority(40)]
0072:   rule <k> V:Val ~> #mathFloor => floorFI(V) ... </k>
0073:   syntax Int ::= floorFI(Val) [function, total, symbol(floorFI)]
0074:   rule floorFI(I:Int)   => I                        [concrete]
0075:   rule floorFI(F:Float) => Float2Int(floorFloat(F)) [concrete]
0076: 
0077:   // bare floor/ceil (bound by `from math import floor, ceil`)
0078:   rule applyBuiltin("floor", V:Val, .Vals) => floorFI(V)
0079:   rule applyBuiltin("ceil",  V:Val, .Vals) => ceilF(V)
0080: 
0081:   // math.pow(x, y) — a two-arg interception onto powF (ints promote)
0082:   syntax KItem ::= #mathPow1(Expr) | #mathPow2(Val)
0083:   rule <k> Call(Attribute(Name("math"), "pow"), (E1:Expr, E2:Expr, .Exprs)) => E1 ~> #mathPow1(E2) ... </k> [priority(40)]
0084:   rule <k> V1:Val ~> #mathPow1(E2:Expr) => E2 ~> #mathPow2(V1) ... </k>
0085:   rule <k> V2:Val ~> #mathPow2(V1:Val) => powF(toF(V1), toF(V2)) ... </k>
0086:   syntax Float ::= toF(Val) [function, total, symbol(toF)]
0087:   rule toF(F:Float) => F        [concrete]
0088:   rule toF(I:Int)   => intToF(I) [concrete]
0089: 
0090:   // ceilF: math.ceil as an Int. TOTAL (K trusts it; a symbolic list element stays opaque for
0091:   // kprove — structural). [concrete] so the Int2Float/ceilFloat hooks only run for krun (llvm).
0092:   // Matches Python incl. negatives: ceil(-2.4) = -2 = Float2Int(ceilFloat(-2.4)).
0093:   syntax Int ::= ceilF(Val) [function, total, symbol(ceilF)]
0094:   rule ceilF(I:Int)   => I                       [concrete]
0095:   rule ceilF(F:Float) => Float2Int(ceilFloat(F)) [concrete]
0096: 
0097:   // unary minus on a float (e.g. the literal -2.4 = UnaryOp("-", Float(2.4))). Concrete for krun;
0098:   // proofs use symbolic elements, never a float literal.
0099:   rule applyUn("-", F:Float) => 0.0 -Float F
0100: 
0101:   // ---- float - / / / + (OPAQUE for kprove [no-evaluators], concrete for krun) — for float-list
0102:   // element maps (x - lo) / (hi - lo). Mirror intFloatDiv: additive, sort-disjoint from the Int rules.
0103:   syntax Float ::= subF(Float, Float) [function, total, symbol(subF), no-evaluators]
0104:   rule subF(F1:Float, F2:Float) => F1 -Float F2 [concrete]
0105:   rule applyBin("-", F1:Float, F2:Float) => subF(F1, F2)
0106: 
0107:   syntax Float ::= divF(Float, Float) [function, total, symbol(divF), no-evaluators]
0108:   rule divF(F1:Float, F2:Float) => F1 /Float F2 [concrete]
0109:   rule applyBin("/", F1:Float, F2:Float) => divF(F1, F2)
0110: 
0111:   syntax Float ::= addF(Float, Float) [function, total, symbol(addF), no-evaluators]
0112:   rule addF(F1:Float, F2:Float) => F1 +Float F2 [concrete]
