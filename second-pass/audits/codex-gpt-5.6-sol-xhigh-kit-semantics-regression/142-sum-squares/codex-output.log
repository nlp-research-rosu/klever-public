def sum_squares(lst):
    total = 0
    index = 0
    value = 0
    for value in lst:
        if index % 3 == 0:
            total = total + value * value
        elif index % 4 == 0:
            total = total + value * value * value
        else:
            total = total + value
        index = index + 1
    return total
