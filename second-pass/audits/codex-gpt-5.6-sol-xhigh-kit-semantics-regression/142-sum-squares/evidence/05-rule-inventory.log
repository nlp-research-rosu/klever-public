0022:   rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
0023:   rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
0024:   rule seqLen(str(IS:IntSeq))                   => isLen(IS)
