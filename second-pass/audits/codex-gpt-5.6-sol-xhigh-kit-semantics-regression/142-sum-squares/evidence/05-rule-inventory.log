0001: // reference/src/semantics.k — the supplied `.mpy` semantics, ASSEMBLED.
0002: //
0003: //   kompile reference-semantics/semantics.k --backend llvm \
0004: //     --main-module MPY-KRUN --syntax-module MPY-SYNTAX \
0005: //     --output-definition runtime-kompiled
0006: //
0007: // Concrete-only legs are included through MPY-KRUN. Proof definitions import
0008: // MPY and any explicit proof extensions supplied by the task author.
0009: //
0010: // Files (dependency order — everything imports MPY-CORE):
0011: //   semantics/syntax.k         MPY-SYNTAX       AST productions
0012: //   semantics/core.k           MPY-CORE         values, config, load, lookup, shared helpers   [required]
0013: //   semantics/iter.k           MPY-ITER         the iterator protocol (#iterNext/#iterYield/#iterDone) decl
0014: //   semantics/range.k          MPY-RANGE        rangeObj: inRange / rangeLen / its #iterNext
0015: //   semantics/operators.k      MPY-OPERATORS    operator DISPATCH (UnaryOp/BinOp/Compare/BoolOp) — domain files own the cases
0016: //   semantics/int.k            MPY-INT          Int operator cases; floored // and % (pyMod)
0017: //   semantics/bool.k           MPY-BOOL         Bool operator cases + truthy not/and/or (BoolOp)
0018: //   semantics/float.k          MPY-FLOAT        Float Val: literal + opaque float ops ([concrete] for krun)
0019: //   semantics/str.k            MPY-STR          str(IntSeq): literal, +, ==, in
0020: //   semantics/set.k            MPY-SET          set(str): distinct char codes (len / membership)
0021: //   semantics/list.k           MPY-LIST         ListExpr, list(ValSeq): +, ==, in
0022: //   semantics/tuple.k          MPY-TUPLE        TupleExpr, tuple ==, target-binding + unpacking
0023: //   semantics/subscript.k      MPY-SUBSCRIPT    Subscript indexing + Slice
0024: //   semantics/comprehension.k  MPY-COMPREHENSION  list comprehensions [ELT for T in ITER if COND]
0025: //   semantics/methods.k        MPY-METHODS      pure str methods: is*/lower/upper/swapcase/startswith
0026: //   semantics/controls.k       MPY-CONTROLS     Assign/AugAssign, If, IfExp, For, While, break/continue
0027: //   semantics/functions.k      MPY-FUNCTIONS    def / call / return (frame stack)
0028: //   semantics/builtins.k       MPY-BUILTINS     builtins as calls: len/sum/abs/min/max/ord/chr/str
0029: //   semantics/call.k           MPY-CALL         ALL Call routing + argument evaluation
0030: //   semantics/sort.k           MPY-SORT         trusted sorted(): opaque sortVS + concrete insertion sort
0031: //   semantics/assert.k         MPY-ASSERT       Assert oracle (smoke programs only)
0032: //   semantics/dict.k           MPY-DICT         order-preserving dictV(KS,VS) + .keys() + list()
0033: 
