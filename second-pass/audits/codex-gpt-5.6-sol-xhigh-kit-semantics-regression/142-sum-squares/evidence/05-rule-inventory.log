0001: // reference/src/semantics/float.k — MPY-FLOAT
0002: //
0003: // Minimal, TRUSTED float support. K/Haskell (kprove) has no usable symbolic IEEE-754 theory and
0004: // no Int2Float hook, so a float value stays an OPAQUE proof-domain primitive: `intFloatDiv(I, F)`
0005: // (the Python true division I / F) is `[no-evaluators]` for kprove — it never reduces on symbolic
0006: // input, and the proof verifies only the STRUCTURE (the result is the exact term the program
0007: // builds). The `[concrete]` rule evaluates it for krun (llvm HAS the Int2Float / /Float hooks), so
0008: // smoke tests run the real float value.
0009: //
0010: // Only the pieces needed so far: Float as a Val, the float literal, and Int / float true division
0011: // (the `a * h / 2.0` idiom). More float ops (float +/-/*, comparison) are added as float problems
0012: // need them — kept minimal + sound.
0013: 
0014: module MPY-FLOAT
0015:   imports MPY-OPERATORS
0016:   imports MPY-BUILTINS
0017:   imports FLOAT
0018: 
0019:   // Float is a value; the float literal evaluates to the K Float.
0020:   syntax Val ::= Float
0021:   rule <k> Float(F:Float) => F ... </k>
0022: 
0023:   // Int / float true division. OPAQUE for kprove (no-evaluators); concrete for krun.
0024:   syntax Float ::= intFloatDiv(Int, Float) [function, total, symbol(intFloatDiv), no-evaluators]
0025:   rule intFloatDiv(I:Int, F:Float) => Int2Float(I, 53, 11) /Float F [concrete]
0026: 
0027:   rule applyBin("/", I:Int, F:Float) => intFloatDiv(I, F)
0028: 
0029:   // Int / Int true division (Python: always a float). OPAQUE for kprove; concrete for krun.
0030:   syntax Float ::= divII(Int, Int) [function, total, symbol(divII), no-evaluators]
0031:   rule divII(I1:Int, I2:Int) => Int2Float(I1, 53, 11) /Float Int2Float(I2, 53, 11) [concrete]
0032:   rule applyBin("/", I1:Int, I2:Int) => divII(I1, I2)
0033: 
0034:   // float % float (e.g. `number % 1.0` = the fractional part). OPAQUE for kprove, concrete for
