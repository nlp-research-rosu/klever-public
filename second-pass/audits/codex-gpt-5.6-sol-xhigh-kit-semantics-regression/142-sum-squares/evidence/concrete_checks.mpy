Module(
  FuncDef("sum_squares", Params("lst"),
    Assign(Name("total"), Int(0))
    Assign(Name("index"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Compare(BinOp("%", Name("index"), Int(3)), CmpOp("==", Int(0))),
        Assign(
          Name("total"),
          BinOp(
            "+",
            Name("total"),
            BinOp("*", Name("value"), Name("value")))),
        If(Compare(BinOp("%", Name("index"), Int(4)), CmpOp("==", Int(0))),
          Assign(
            Name("total"),
            BinOp(
              "+",
              Name("total"),
              BinOp(
                "*",
                BinOp("*", Name("value"), Name("value")),
                Name("value")))),
          Assign(
            Name("total"),
            BinOp("+", Name("total"), Name("value")))))
      Assign(Name("index"), BinOp("+", Name("index"), Int(1))))
    Return(Name("total")))
  Assert(
    Compare(Call(Name("sum_squares"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(5)))),
      CmpOp("==", UnaryOp("-", Int(126)))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          Int(2),
          UnaryOp("-", Int(3)),
          Int(5),
          UnaryOp("-", Int(7)),
          Int(11))),
      CmpOp("==", Int(1386))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          Int(2),
          UnaryOp("-", Int(3)),
          Int(5),
          UnaryOp("-", Int(7)),
          Int(11),
          UnaryOp("-", Int(13)),
          Int(17),
          UnaryOp("-", Int(19)),
          Int(23),
          UnaryOp("-", Int(29)),
          Int(31),
          UnaryOp("-", Int(37)),
          Int(41))),
      CmpOp("==", Int(16326)))))
