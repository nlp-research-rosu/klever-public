+
+record python3 - /candidate/codex-output.log <<'PY'
+import collections
+import pathlib
+import sys
+
+path = pathlib.Path(sys.argv[1])
+terms = (
+    "#Top",
+    "WarnStuckClaimState",
+    "VALIDATED",
+    "KPROVE_PASSED",
+    "MISMATCHES=0",
+    "BODY_MUTATION_PROBE_EXPECTED_FAILURE",
+    "VACUITY_PROBE_EXPECTED_FAILURE",
