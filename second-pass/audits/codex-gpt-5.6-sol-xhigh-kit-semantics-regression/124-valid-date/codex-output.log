diff --git a/evidence/07_trust_inventory.sh b/evidence/07_trust_inventory.sh
new file mode 100644
index 0000000000000000000000000000000000000000..069c134ae6596aea7f5dc35d94fa34127acbc19d
--- /dev/null
+++ b/evidence/07_trust_inventory.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -u
+
+record() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT_STATUS: %d\n\n' "$status"
+  return "$status"
+}
+
+root=/tmp/audit-work/124-valid-date
+
+record rg -n \
+  'syntax .*\[(?:[^]]*(?:symbol\(|no-evaluators))' \
