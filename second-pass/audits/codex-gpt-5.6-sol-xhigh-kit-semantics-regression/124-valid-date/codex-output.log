+printf 'EXIT_STATUS: %d\n\n' "$proof_status"
+if (( proof_status == 0 )); then
+  overall=1
+fi
+
+record rg -q WarnStuckClaimState \
+  /audit-output/evidence/06_false_proof_output.log \
+  || overall=1
