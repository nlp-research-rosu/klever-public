+  "$work/embedded-solution.concrete.kast.json" \
+  || overall=1
+record sha256sum \
+  "$work/solution.kast.json" \
+  "$work/embedded-solution.concrete.kast.json" \
+  || overall=1
+
+printf 'OVERALL_STATUS: %d\n' "$overall"
+exit "$overall"
