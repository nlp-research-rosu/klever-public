+status=$?
+printf 'EXIT_STATUS: %d\n\n' "$status"
+if (( status != 0 )); then overall=1; fi
+
+record kompile "$work/reference-semantics/semantics.k" \
+  --backend llvm \
+  --main-module MPY-KRUN \
