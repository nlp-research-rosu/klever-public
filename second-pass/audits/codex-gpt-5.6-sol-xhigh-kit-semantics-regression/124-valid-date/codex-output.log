+++ b/evidence/02_program_fidelity.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -u
+
+record() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT_STATUS: %d\n\n' "$status"
+  return "$status"
+}
