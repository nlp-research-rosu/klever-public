+#!/usr/bin/env bash
+set -u
+
+record() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT_STATUS: %d\n\n' "$status"
+  return "$status"
+}
+
+root=/tmp/audit-work/124-valid-date
+
+record rg -n \
+  'syntax .*\[(?:[^]]*(?:symbol\(|no-evaluators))' \
