Module(
  FuncDef("odd_count", Params("lst"),
    Assign(Name("result"), ListExpr())
    For(Name("digits"), Name("lst"),
      Assign(
        Name("count"),
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                Call(Attribute(Name("digits"), "count"), Str("1")),
                Call(Attribute(Name("digits"), "count"), Str("3"))),
              Call(Attribute(Name("digits"), "count"), Str("5"))),
            Call(Attribute(Name("digits"), "count"), Str("7"))),
          Call(Attribute(Name("digits"), "count"), Str("9"))))
      Assign(Name("count_text"), Call(Name("str"), Name("count")))
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      BinOp(
                        "+",
                        BinOp(
                          "+",
                          Str("the number of odd elements "),
                          Name("count_text")),
                        Str("n the str")),
                      Name("count_text")),
                    Str("ng ")),
                  Name("count_text")),
                Str(" of the ")),
              Name("count_text")),
            Str("nput.")))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr(Str("1234567"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 4n the str4ng 4 of the 4nput.")))))
  Assert(
    Compare(
      Call(
        Name("odd_count"),
        ListExpr(Str(""), Str("02468"), Str("13579"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 0n the str0ng 0 of the 0nput."),
          Str(
            "the number of odd elements 0n the str0ng 0 of the 0nput."),
          Str(
            "the number of odd elements 5n the str5ng 5 of the 5nput."))))))
