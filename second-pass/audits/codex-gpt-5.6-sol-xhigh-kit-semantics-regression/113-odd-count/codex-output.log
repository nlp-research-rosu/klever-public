  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module VERIFICATION-SYNTAX \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

# Gate A3: the observable suffix works both with and without the bridges.
kprove continuation-spec.k \
  --definition verification-kompiled \
  --spec-module CONTINUATION-SPEC
kprove continuation-base.k \
  --definition connection-kompiled \
