+        timeout=600,
+        check=False,
+    )
+    raw = completed.stdout
+    if len(raw) > args.limit:
+        head = raw[: args.limit // 2]
+        tail = raw[-args.limit // 2 :]
+        raw = (
+            head
+            + b"\n... AUDITOR LOG TRUNCATED IN MIDDLE ...\n"
