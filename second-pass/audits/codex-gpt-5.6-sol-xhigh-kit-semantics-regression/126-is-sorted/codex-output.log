+
+  // A total projection used only under isIntV guards.  The owise case makes
+  // the symbol total; no theorem relies on its off-domain value.
+  syntax Int ::= asInt(Val) [function, total]
+  rule asInt(I:Int) => I
+  rule asInt(_V:Val) => 0 [owise]
+
+  // Structural statement of the prompt's list domain.
+  syntax Bool ::= nonNegativeInts(ValSeq) [function, total]
+  rule nonNegativeInts(.ValSeq) => true
+  rule nonNegativeInts(vCons(V:Val, REST:ValSeq))
+    => isIntV(V)
+       andBool asInt(V) >=Int 0
+       andBool nonNegativeInts(REST)
+
+  // Derived, guarded instances of MPY-INT's applyCmp equations.  They expose
+  // the Int values of Val-sorted symbolic variables without changing the
+  // comparison or touching operational state.
+  rule applyCmp("<", LEFT:Val, RIGHT:Val)
+    => asInt(LEFT) <Int asInt(RIGHT)
+    requires isIntV(LEFT) andBool isIntV(RIGHT)
+    [simplification]
+  rule applyCmp("==", LEFT:Val, RIGHT:Val)
+    => asInt(LEFT) ==Int asInt(RIGHT)
+    requires isIntV(LEFT) andBool isIntV(RIGHT)
+    [simplification]
+  rule applyCmp(">", LEFT:Val, RIGHT:Val)
+    => asInt(LEFT) >Int asInt(RIGHT)
+    requires isIntV(LEFT) andBool isIntV(RIGHT)
+    [simplification]
+
+  // Mathematical result of scanning REST after PREVIOUS has already been
