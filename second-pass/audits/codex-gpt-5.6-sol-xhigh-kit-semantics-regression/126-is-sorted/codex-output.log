def is_sorted(lst):
    '''
    Given a list of numbers, return whether or not they are sorted
    in ascending order. If list has more than 1 duplicate of the same
    number, return False. Assume no negative numbers and only integers.

    Examples
    is_sorted([5]) ➞ True
    is_sorted([1, 2, 3, 4, 5]) ➞ True
    is_sorted([1, 3, 2, 4, 5]) ➞ False
    is_sorted([1, 2, 3, 4, 5, 6]) ➞ True
    is_sorted([1, 2, 3, 4, 5, 6, 7]) ➞ True
    is_sorted([1, 3, 2, 4, 5, 6, 7]) ➞ False
    is_sorted([1, 2, 2, 3, 3, 4]) ➞ True
    is_sorted([1, 2, 2, 2, 3, 4]) ➞ False
    '''
# canonical.py — the UNMODIFIED HumanEval/126 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: is_sorted


def is_sorted(lst):
    '''
    Given a list of numbers, return whether or not they are sorted
    in ascending order. If list has more than 1 duplicate of the same
    number, return False. Assume no negative numbers and only integers.

    Examples
    is_sorted([5]) ➞ True
    is_sorted([1, 2, 3, 4, 5]) ➞ True
    is_sorted([1, 3, 2, 4, 5]) ➞ False
    is_sorted([1, 2, 3, 4, 5, 6]) ➞ True
    is_sorted([1, 2, 3, 4, 5, 6, 7]) ➞ True
    is_sorted([1, 3, 2, 4, 5, 6, 7]) ➞ False
    is_sorted([1, 2, 2, 3, 3, 4]) ➞ True
    is_sorted([1, 2, 2, 2, 3, 4]) ➞ False
    '''
    count_digit = dict([(i, 0) for i in lst])
    for i in lst:
        count_digit[i]+=1 
    if any(count_digit[i] > 2 for i in lst):
        return False
    if all(lst[i-1] <= lst[i] for i in range(1, len(lst))):
        return True
    else:
        return False
    
    
def is_sorted(lst):
    previous = -1
    duplicates = 0
    value = 0

    for value in lst:
        if value < previous:
            return False

        if value == previous:
            if duplicates == 1:
                return False
            duplicates = 1
        else:
            duplicates = 0

        previous = value

    return True
Module(
  FuncDef("is_sorted", Params("lst"),
    Assign(Name("previous"), UnaryOp("-", Int(1)))
    Assign(Name("duplicates"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Compare(Name("value"), CmpOp("<", Name("previous"))),
        Return(Bool(false)),
        )
      If(Compare(Name("value"), CmpOp("==", Name("previous"))),
        If(Compare(Name("duplicates"), CmpOp("==", Int(1))),
          Return(Bool(false)),
          )
        Assign(Name("duplicates"), Int(1)),
        Assign(Name("duplicates"), Int(0)))
      Assign(Name("previous"), Name("value")))
    Return(Bool(true))))
