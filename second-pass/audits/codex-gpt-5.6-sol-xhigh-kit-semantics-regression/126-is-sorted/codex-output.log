  imports MAP
  imports LIST

  // Exact constructor terms emitted from solution.py.  These are syntax-only
  // abbreviations; they do not rewrite an executing program.
  syntax Stmts ::= "isSortedLoopBody" [macro]
  rule isSortedLoopBody
    => If(Compare(Name("value"), CmpOp("<", Name("previous"))),
          Return(Bool(false)) .Stmts,
          .Stmts)
       If(Compare(Name("value"), CmpOp("==", Name("previous"))),
          If(Compare(Name("duplicates"), CmpOp("==", Int(1))),
             Return(Bool(false)) .Stmts,
             .Stmts)
          Assign(Name("duplicates"), Int(1))
          .Stmts,
          Assign(Name("duplicates"), Int(0)) .Stmts)
       Assign(Name("previous"), Name("value"))
       .Stmts

  syntax Stmts ::= "isSortedBody" [macro]
  rule isSortedBody
    => Assign(Name("previous"), UnaryOp("-", Int(1)))
       Assign(Name("duplicates"), Int(0))
       Assign(Name("value"), Int(0))
       For(Name("value"), Name("lst"), isSortedLoopBody)
       Return(Bool(true))
       .Stmts

  syntax Stmts ::= "isSortedTail" [macro]
  rule isSortedTail => Return(Bool(true)) .Stmts

  syntax Module ::= "isSortedModule" [macro]
  rule isSortedModule
    => Module(
         FuncDef("is_sorted", Params("lst", .ParamNames), isSortedBody)
         .Stmts)

  // A total projection used only under isIntV guards.  The owise case makes
  // the symbol total; no theorem relies on its off-domain value.
  syntax Int ::= asInt(Val) [function, total]
  rule asInt(I:Int) => I
  rule asInt(_V:Val) => 0 [owise]

  // Structural statement of the prompt's list domain.
  syntax Bool ::= nonNegativeInts(ValSeq) [function, total]
  rule nonNegativeInts(.ValSeq) => true
  rule nonNegativeInts(vCons(V:Val, REST:ValSeq))
    => isIntV(V)
       andBool asInt(V) >=Int 0
       andBool nonNegativeInts(REST)

  // Derived, guarded instances of MPY-INT's applyCmp equations.  They expose
  // the Int values of Val-sorted symbolic variables without changing the
  // comparison or touching operational state.
  rule applyCmp("<", LEFT:Val, RIGHT:Val)
    => asInt(LEFT) <Int asInt(RIGHT)
    requires isIntV(LEFT) andBool isIntV(RIGHT)
    [simplification]
  rule applyCmp("==", LEFT:Val, RIGHT:Val)
    => asInt(LEFT) ==Int asInt(RIGHT)
    requires isIntV(LEFT) andBool isIntV(RIGHT)
    [simplification]
  rule applyCmp(">", LEFT:Val, RIGHT:Val)
    => asInt(LEFT) >Int asInt(RIGHT)
    requires isIntV(LEFT) andBool isIntV(RIGHT)
    [simplification]

  // Mathematical result of scanning REST after PREVIOUS has already been
  // seen, where DUPLICATES is 0 for one occurrence and 1 for two.
  // The equations are disjoint and cover the domain used by the claims:
  // non-negative integer sequences, PREVIOUS >= -1, DUPLICATES in {0, 1}.
  syntax Bool ::= sortedScan(ValSeq, Val, Int) [function, total]
  rule sortedScan(.ValSeq, _PREVIOUS:Val, _DUPLICATES:Int) => true
    [simplification]
  rule sortedScan(vCons(VALUE:Val, _REST:ValSeq), PREVIOUS:Val, _DUPLICATES:Int)
    => false
    requires asInt(VALUE) <Int asInt(PREVIOUS)
    [simplification]
  rule sortedScan(vCons(VALUE:Val, _REST:ValSeq), PREVIOUS:Val, DUPLICATES:Int)
    => false
    requires asInt(VALUE) ==Int asInt(PREVIOUS)
     andBool DUPLICATES >=Int 1
    [simplification]
  rule sortedScan(vCons(VALUE:Val, REST:ValSeq), PREVIOUS:Val, _DUPLICATES:Int)
    => sortedScan(REST, VALUE, 0)
    requires asInt(VALUE) >Int asInt(PREVIOUS)
    [simplification]
  rule sortedScan(vCons(VALUE:Val, REST:ValSeq), PREVIOUS:Val, DUPLICATES:Int)
    => sortedScan(REST, VALUE, 1)
    requires asInt(VALUE) ==Int asInt(PREVIOUS)
     andBool DUPLICATES ==Int 0
    [simplification]
  rule sortedScan(vCons(VALUE:Val, _REST:ValSeq), PREVIOUS:Val, DUPLICATES:Int)
    => false
    requires asInt(VALUE) ==Int asInt(PREVIOUS)
     andBool DUPLICATES <Int 0
    [simplification]
endmodule

module VERIFICATION
  imports VERIFICATION-BASE

  // Exact operational bridge justified by LOOP-SPEC.loop-invariant, which is
  // proved separately against VERIFICATION-BASE (where this rule is absent).
  // Its matched continuation, frame, bindings, cells, and guard are identical
  // to an initialized instance of that theorem.
  rule
    <k> #loop(list(VALUES:ValSeq), Name("value"), isSortedLoopBody)
        ~> isSortedTail
        ~> #endcall
        => sortedScan(VALUES, -1, 0)
    </k>
    <env> 1 => 0 </env>
    <scopes>
      (0 |-> scope(
              "is_sorted" |->
                closureVal(
                  ("lst", .ParamNames),
                  isSortedBody,
                  0),
              parent(-1))
       -1 |-> BUILTINS:Scope
       1 |-> scope(
             "lst" |-> list(VALUES)
             "previous" |-> -1
             "duplicates" |-> 0
             "value" |-> 0,
             parent(0)))
      =>
      (0 |-> scope(
              "is_sorted" |->
                closureVal(
                  ("lst", .ParamNames),
                  isSortedBody,
                  0),
              parent(-1))
       -1 |-> BUILTINS)
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires nonNegativeInts(VALUES)
    [priority(40)]
endmodule

