+    [0, 0, 1, 1],
+    [0, 0, 1, 1, 1]
+  ],
+  "generated_product": {
+    "values": [0, 1, 2, 3, 4],
+    "lengths": [0, 1, 2, 3, 4, 5, 6],
+    "order": "length-major, then itertools.product lexicographic order"
