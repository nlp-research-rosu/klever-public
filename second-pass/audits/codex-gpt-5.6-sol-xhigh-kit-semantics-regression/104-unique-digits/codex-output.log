+proof_status=${PIPESTATUS[0]}
+echo "EXIT_STATUS=$proof_status" | tee -a "$proof_log"
+
+echo "EXPECTED dry_run=0 proof_nonzero OBSERVED dry_run=$dry_status proof=$proof_status"
+if [[ "$dry_status" -ne 0 || "$proof_status" -eq 0 ]]; then
+  exit 1
+fi
+exit 0
