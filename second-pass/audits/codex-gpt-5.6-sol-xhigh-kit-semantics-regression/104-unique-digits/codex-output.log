     1	#!/usr/bin/env python3
     2	"""Reproducible differential evidence for solution.py and the LLVM MPY run."""
     3	
     4	from __future__ import annotations
     5	
     6	import random
     7	import subprocess
     8	import tempfile
     9	from pathlib import Path
    10	
    11	from solution import unique_digits
    12	
    13	
    14	ROOT = Path(__file__).resolve().parent
    15	
    16	
    17	def oracle(values):
    18	    """Independent contract oracle: inspect each decimal digit numerically."""
    19	    accepted = []
    20	    for value in values:
    21	        if all((ord(char) - ord("0")) % 2 == 1 for char in f"{value:d}"):
    22	            accepted.append(value)
    23	    accepted.sort()
    24	    return accepted
    25	
    26	
    27	def make_cases():
    28	    rng = random.Random(20260722)
    29	    prompt_and_boundaries = [
    30	        [15, 33, 1422, 1],
    31	        [152, 323, 1422, 10],
    32	        [],
    33	        [1],
    34	        [2],
    35	        [9, 11, 101, 777, 97531],
    36	        [97531, 11, 9, 246, 101, 777],
    37	        [99999, 11111, 13579, 8642, 20],
    38	    ]
    39	    exhaustive_singletons = [[value] for value in range(1, 5001)]
    40	    random_lists = [
    41	        [rng.randint(1, 99999) for _ in range(rng.randint(0, 15))]
    42	        for _ in range(500)
    43	    ]
    44	    return prompt_and_boundaries + exhaustive_singletons + random_lists
    45	
    46	
    47	def main():
    48	    cases = make_cases()
    49	    mismatches = [
    50	        (values, unique_digits(values), oracle(values))
    51	        for values in cases
    52	        if unique_digits(values) != oracle(values)
    53	    ]
    54	    print(f"CPYTHON_ORACLE_CASES={len(cases)} MISMATCHES={len(mismatches)}")
    55	    if mismatches:
    56	        print(mismatches[0])
    57	        raise SystemExit(1)
    58	
    59	    # Keep the K batch representative but bounded: both prompt examples,
    60	    # boundaries, selected singletons, and seeded mixed lists.
    61	    k_cases = cases[:8] + cases[8:108] + cases[-40:]
    62	    source = (ROOT / "solution.py").read_text(encoding="utf-8")
    63	    assertions = "".join(
    64	        f"\nassert unique_digits({values!r}) == {oracle(values)!r}"
    65	        for values in k_cases
    66	    )
    67	
    68	    with tempfile.TemporaryDirectory(prefix="unique-digits-") as tmp:
    69	        tmp_path = Path(tmp)
    70	        harness_py = tmp_path / "harness.py"
    71	        harness_mpy = tmp_path / "harness.mpy"
    72	        harness_py.write_text(source + assertions + "\n", encoding="utf-8")
    73	
    74	        translated = subprocess.run(
    75	            ["python3", str(ROOT / "py2mpy.py"), str(harness_py)],
    76	            check=True,
    77	            text=True,
    78	            capture_output=True,
    79	        )
    80	        harness_mpy.write_text(translated.stdout, encoding="utf-8")
    81	        run = subprocess.run(
    82	            ["krun", str(harness_mpy), "--definition", str(ROOT / "runtime-kompiled")],
    83	            text=True,
    84	            capture_output=True,
    85	        )
    86	
    87	    good_configuration = (
    88	        run.returncode == 0
    89	        and "<k>\n    .K\n  </k>" in run.stdout
    90	        and "<exc>\n    NoExc\n  </exc>" in run.stdout
    91	        and "<exit-code>\n    0\n  </exit-code>" in run.stdout
    92	    )
    93	    print(
    94	        f"K_ASSERTIONS={len(k_cases)} KRUN_EXIT={run.returncode} "
    95	        f"FINAL_OK={int(good_configuration)}"
    96	    )
    97	    if not good_configuration:
    98	        print(run.stdout[-4000:])
    99	        print(run.stderr[-4000:])
   100	        raise SystemExit(1)
   101	
   102	
   103	if __name__ == "__main__":
   104	    main()
