+      => (0 |-> list(vCons(1, .ValSeq))
+          1 |-> list(sortVS(vCons(1, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
