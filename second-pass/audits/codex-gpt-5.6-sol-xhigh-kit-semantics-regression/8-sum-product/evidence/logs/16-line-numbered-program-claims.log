     3	module VERIFICATION
     4	  imports MPY
     5	  imports BOOL
     6	
     7	  // The HumanEval domain is a list whose elements are all Python integers.
     8	  syntax Bool ::= intsVS(ValSeq) [function, total]
     9	  rule intsVS(.ValSeq)                => true
    10	  rule intsVS(vCons(V:Val, R:ValSeq)) => isInt(V) andBool intsVS(R)
    11	
    12	  // Mathematical left folds.  The non-integer equations totalize these
    13	  // proof-local functions outside the theorem's all-integer input domain.
    14	  syntax Int ::= sumFrom(Int, ValSeq) [function, total]
    15	  rule sumFrom(A:Int, .ValSeq)                => A
    16	  rule sumFrom(A:Int, vCons(V:Val, R:ValSeq)) => sumFrom(A +Int {V}:>Int, R)
    17	    requires isInt(V)
    18	  rule sumFrom(A:Int, vCons(V:Val, R:ValSeq)) => sumFrom(A, R)
    19	    requires notBool isInt(V)
    20	
    21	  syntax Int ::= productFrom(Int, ValSeq) [function, total]
    22	  rule productFrom(A:Int, .ValSeq)                => A
    23	  rule productFrom(A:Int, vCons(V:Val, R:ValSeq)) => productFrom(A *Int {V}:>Int, R)
    24	    requires isInt(V)
    25	  rule productFrom(A:Int, vCons(V:Val, R:ValSeq)) => productFrom(A, R)
    26	    requires notBool isInt(V)
    27	
    28	  // The Haskell backend retains isInt(V) as a constraint but does not refine
    29	  // V:Val to the Int subsort.  These equations expose the two supplied MPY-INT
    30	  // cases under that equivalent guard; they agree on concrete Int overlap.
    31	  rule applyBin("+", A:Int, V:Val) => A +Int {V}:>Int
    32	    requires isInt(V)
    33	  rule applyBin("*", A:Int, V:Val) => A *Int {V}:>Int
    34	    requires isInt(V)
    35	endmodule
