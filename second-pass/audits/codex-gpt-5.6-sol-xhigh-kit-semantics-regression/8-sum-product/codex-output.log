+CANDIDATE = Path("/candidate")
+REFERENCE = Path("/reference")
+
+REQUIRED = (
+    "run-input.json",
+    "metrics.json",
+    "codex-last.txt",
+    "codex-output.log",
+    "prompt.py",
+    "py2mpy.py",
+    "solution.py",
+    "solution.mpy",
+    "spec.k",
+    "verification.k",
+)
+
+
+def kind(path: Path) -> str:
+    try:
+        mode = path.lstat().st_mode
+    except FileNotFoundError:
+        return "missing"
