module VERIFICATION
  imports MPY
  imports BOOL

  // The HumanEval domain is a list whose elements are all Python integers.
  syntax Bool ::= intsVS(ValSeq) [function, total]
  rule intsVS(.ValSeq)                => true
  rule intsVS(vCons(V:Val, R:ValSeq)) => isInt(V) andBool intsVS(R)

  // Mathematical left folds.  The non-integer equations totalize these
  // proof-local functions outside the theorem's all-integer input domain.
  syntax Int ::= sumFrom(Int, ValSeq) [function, total]
  rule sumFrom(A:Int, .ValSeq)                => A
  rule sumFrom(A:Int, vCons(V:Val, R:ValSeq)) => sumFrom(A +Int {V}:>Int, R)
    requires isInt(V)
  rule sumFrom(A:Int, vCons(V:Val, R:ValSeq)) => sumFrom(A, R)
    requires notBool isInt(V)

  syntax Int ::= productFrom(Int, ValSeq) [function, total]
  rule productFrom(A:Int, .ValSeq)                => A
  rule productFrom(A:Int, vCons(V:Val, R:ValSeq)) => productFrom(A *Int {V}:>Int, R)
    requires isInt(V)
  rule productFrom(A:Int, vCons(V:Val, R:ValSeq)) => productFrom(A, R)
    requires notBool isInt(V)

  // The Haskell backend retains isInt(V) as a constraint but does not refine
  // V:Val to the Int subsort.  These equations expose the two supplied MPY-INT
  // cases under that equivalent guard; they agree on concrete Int overlap.
  rule applyBin("+", A:Int, V:Val) => A +Int {V}:>Int
    requires isInt(V)
  rule applyBin("*", A:Int, V:Val) => A *Int {V}:>Int
    requires isInt(V)
endmodule
