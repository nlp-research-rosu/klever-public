+    <heap> .Map => 0 |-> list(VS)
+                    1 |-> list(sortKeyVS(VS, numberKeyFunction)) </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validNumberWords(VS)
+endmodule

