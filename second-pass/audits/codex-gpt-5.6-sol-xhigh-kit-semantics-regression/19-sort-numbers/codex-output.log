index 0000000000000000000000000000000000000000..ec342fd9a9b924f43eb841455e5b8dd33b992e7c
--- /dev/null
+++ b/evidence/stage6-false-result.k
@@ -0,0 +1,25 @@
+requires "/tmp/audit-work/19-sort-numbers/source/verification.k"
+
+module AUDIT-FALSE-RESULT
+  imports VERIFICATION
+
+  // Fresh auditor mutation: the real function always returns a string on the
+  // formal domain, so replacing the entry claim's exact string result by noneV
+  // is false. VS=.ValSeq is a concrete satisfying witness; Python returns "".
+  claim [returns-none]:
+    <k> Call(Name("sort_numbers"),
+             (str(joinCodes(iCons(32, .IntSeq), VS:ValSeq)), .Exprs))
+      => noneV </k>
+    <env> 0 </env>
+    <scopes> 0  |-> scope("sort_numbers" |-> sortNumbersFunction, parent(-1))
+             -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(VS)
+                    1 |-> list(sortKeyVS(VS, numberKeyFunction)) </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validNumberWords(VS)
+endmodule

diff --git a//tmp/audit-work/19-sort-numbers/concrete-witness.py b//tmp/audit-work/19-sort-numbers/concrete-witness.py
index cd2e5a0952cc3cbbb50a5db6c9ce7ccbd746b114..55016e590321bc61528f2afe86f9ffefa1095533
--- a//tmp/audit-work/19-sort-numbers/concrete-witness.py
+++ b//tmp/audit-work/19-sort-numbers/concrete-witness.py
@@ -16,3 +16,12 @@
             }[word],
         )
     )
+
+
+assert sort_numbers("") == ""
+assert sort_numbers("three one five") == "one three five"
+assert sort_numbers("nine zero five one one") == "zero one one five nine"
+assert sort_numbers(
+    "nine eight seven six five four three two one zero"
+) == "zero one two three four five six seven eight nine"
+assert sort_numbers("  three   one five  ") == "one three five"
diff --git a//tmp/audit-work/19-sort-numbers/source/audit-adequacy-probe.k b//tmp/audit-work/19-sort-numbers/source/audit-adequacy-probe.k
new file mode 100644
index 0000000000000000000000000000000000000000..1e7c3ed7977122e53ea07b1b49780d95f7a65486
--- /dev/null
+++ b//tmp/audit-work/19-sort-numbers/source/audit-adequacy-probe.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module AUDIT-ADEQUACY-PROBE
+  imports VERIFICATION
+
+  // This is true of Python and of MPY-CONCRETE, but intentionally asks whether
+  // the Haskell proof theory itself can derive the concrete HumanEval result
+  // instead of retaining the supplied opaque sortKeyVS term.
+  claim [concrete-example-result]:
+    <k> Call(
+          Name("sort_numbers"),
+          (str(joinCodes(
+                 iCons(32, .IntSeq),
+                 vCons(str(strToCodes("three")),
+                   vCons(str(strToCodes("one")),
+                     vCons(str(strToCodes("five")), .ValSeq))))),
+           .Exprs))
+      => str(strToCodes("one three five")) </k>
+    <env> 0 </env>
+    <scopes> 0  |-> scope("sort_numbers" |-> sortNumbersFunction, parent(-1))
+             -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map
+      => 0 |-> list(
+           vCons(str(strToCodes("three")),
+             vCons(str(strToCodes("one")),
+               vCons(str(strToCodes("five")), .ValSeq))))
+         1 |-> list(
+           vCons(str(strToCodes("one")),
+             vCons(str(strToCodes("three")),
+               vCons(str(strToCodes("five")), .ValSeq)))) </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
