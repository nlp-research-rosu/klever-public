Module(
  FuncDef("sort_numbers", Params("numbers"),
    Return(
      Call(
        Attribute(Str(" "), "join"),
        Call(
          Name("sorted"),
          Call(Attribute(Name("numbers"), "split"), ),
          KwArg(
            "key",
            Lambda(
              Params("word"),
              CellVars(),
              FreeVars(),
              Subscript(
                DictExpr(
                  Entry(Str("zero"), Int(0)),
                  Entry(Str("one"), Int(1)),
                  Entry(Str("two"), Int(2)),
                  Entry(Str("three"), Int(3)),
                  Entry(Str("four"), Int(4)),
                  Entry(Str("five"), Int(5)),
                  Entry(Str("six"), Int(6)),
                  Entry(Str("seven"), Int(7)),
                  Entry(Str("eight"), Int(8)),
                  Entry(Str("nine"), Int(9))),
                Name("word"))))))))
  Assert(
    Compare(Call(Name("sort_numbers"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("three one five")),
      CmpOp("==", Str("one three five"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("nine zero five one one")),
      CmpOp("==", Str("zero one one five nine"))))
  Assert(
    Compare(
      Call(
        Name("sort_numbers"),
        Str("nine eight seven six five four three two one zero")),
      CmpOp(
        "==",
        Str("zero one two three four five six seven eight nine"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("  three   one five  ")),
      CmpOp("==", Str("one three five")))))
