requires "verification.k"

module VERIFICATION-MUTANT-SYNTAX
  imports VERIFICATION-SYNTAX
  syntax Stmt  ::= "antiMutantLoopBody" [macro]
  syntax Stmts ::= "antiMutantBody" [macro]
endmodule

module VERIFICATION-MUTANT
  imports VERIFICATION
  imports VERIFICATION-MUTANT-SYNTAX

  // Deliberate body mutation: non-space characters are discarded.
  rule antiMutantLoopBody
    => If(Compare(Name("char"), CmpOp("==", Str(" "))),
          Assign(Name("result"),
            BinOp("+",
              BinOp("+",
                Name("result"),
                Call(Attribute(Str(""), "join"),
                  Call(Name("sorted"), Call(Name("list"), Name("word"))))),
              Str(" ")))
          Assign(Name("word"), Str("")),
          Assign(Name("word"), Name("word")))

  rule antiMutantBody
    => Assign(Name("result"), Str(""))
       Assign(Name("word"), Str(""))
       Assign(Name("char"), Str(""))
       For(Name("char"), Name("s"), antiMutantLoopBody .Stmts)
       Return(antiFinalExpr)
       .Stmts
endmodule

