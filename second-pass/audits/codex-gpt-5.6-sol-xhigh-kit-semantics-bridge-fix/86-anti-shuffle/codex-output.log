module SPEC-BODY-MUTANT
  imports VERIFICATION-MUTANT

  // Concrete witness "ba": the original returns "ab"; the mutant returns "".
  claim [body-sensitive]:
    <k> FuncDef("anti_shuffle", Params("s"), antiMutantBody)
        ~> Call(Name("anti_shuffle"),
             str(iCons(98, iCons(97, .IntSeq))))
        => str(iCons(97, iCons(98, .IntSeq))) </k>
    <env> 0 </env>
    <scopes>
