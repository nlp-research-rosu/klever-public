+def anti_shuffle(s):
+    result = ''
+    word = ''
+    char = ''
+    for char in s:
+        if char == ' ':
+            result = result + ''.join(sorted(list(word))) + ' '
+            word = ''
+        else:
+            word = word + char
+    return result + ''.join(sorted(list(word)))
+
+
