def anti_shuffle(s):
    """
    Write a function that takes a string and returns an ordered version of it.
    Ordered version of string, is a string where all words (separated by space)
    are replaced by a new word where all the characters arranged in
    ascending order based on ascii value.
    Note: You should keep the order of words and blank spaces in the sentence.

    For example:
    anti_shuffle('Hi') returns 'Hi'
    anti_shuffle('hello') returns 'ehllo'
    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'
    """
# canonical.py — the UNMODIFIED HumanEval/86 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: anti_shuffle


def anti_shuffle(s):
    """
    Write a function that takes a string and returns an ordered version of it.
    Ordered version of string, is a string where all words (separated by space)
    are replaced by a new word where all the characters arranged in
    ascending order based on ascii value.
    Note: You should keep the order of words and blank spaces in the sentence.

    For example:
    anti_shuffle('Hi') returns 'Hi'
    anti_shuffle('hello') returns 'ehllo'
    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'
    """
    return ' '.join([''.join(sorted(list(i))) for i in s.split(' ')])
def anti_shuffle(s):
    result = ''
    word = ''
    char = ''
    for char in s:
        if char == ' ':
            result = result + ''.join(sorted(list(word))) + ' '
            word = ''
        else:
            word = word + char
    return result + ''.join(sorted(list(word)))
Module(
  FuncDef("anti_shuffle", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("word"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("s"),
      If(Compare(Name("char"), CmpOp("==", Str(" "))),
        Assign(
          Name("result"),
          BinOp(
            "+",
            BinOp(
              "+",
              Name("result"),
              Call(
                Attribute(Str(""), "join"),
                Call(Name("sorted"), Call(Name("list"), Name("word"))))),
            Str(" ")))
        Assign(Name("word"), Str("")),
        Assign(Name("word"), BinOp("+", Name("word"), Name("char")))))
    Return(
      BinOp(
        "+",
        Name("result"),
        Call(
          Attribute(Str(""), "join"),
          Call(Name("sorted"), Call(Name("list"), Name("word"))))))))
requires "reference-semantics/semantics.k"

module VERIFICATION-SYNTAX
  imports MPY-SYNTAX
  imports INT-SYNTAX
  imports BOOL-SYNTAX
  imports MAP

  syntax Stmt  ::= "antiLoopBody" [macro]
  syntax Expr  ::= "antiFinalExpr" [macro]
  syntax Stmts ::= "antiBody" [macro]

  syntax IntSeq ::= sortedWord(IntSeq) [function, total]
                  | emittedAfter(IntSeq, IntSeq, IntSeq) [function, total]
                  | wordAfter(IntSeq, IntSeq) [function, total]
                  | antiShuffleCodes(IntSeq) [function, total]
  syntax Bool ::= keysBelow(Map, Int) [function]
endmodule

module VERIFICATION
  imports MPY
  imports VERIFICATION-SYNTAX

  rule antiLoopBody
    => If(Compare(Name("char"), CmpOp("==", Str(" "))),
          Assign(Name("result"),
            BinOp("+",
              BinOp("+",
                Name("result"),
                Call(Attribute(Str(""), "join"),
                  Call(Name("sorted"), Call(Name("list"), Name("word"))))),
              Str(" ")))
          Assign(Name("word"), Str("")),
          Assign(Name("word"), BinOp("+", Name("word"), Name("char"))))

  rule antiFinalExpr
    => BinOp("+",
         Name("result"),
         Call(Attribute(Str(""), "join"),
           Call(Name("sorted"), Call(Name("list"), Name("word")))))

  rule antiBody
    => Assign(Name("result"), Str(""))
       Assign(Name("word"), Str(""))
       Assign(Name("char"), Str(""))
       For(Name("char"), Name("s"), antiLoopBody .Stmts)
       Return(antiFinalExpr)
       .Stmts

  // The exact value returned by ''.join(sorted(list(word))) in MPY.
  rule sortedWord(CS:IntSeq)
    => joinCodes(.IntSeq, sortVS(charsOf(CS))) [simplification]

  // State summaries at the end of a scan of the remaining character codes.
  rule emittedAfter(.IntSeq, _WORD:IntSeq, OUT:IntSeq) => OUT [simplification]
  rule emittedAfter(iCons(32, REST:IntSeq), WORD:IntSeq, OUT:IntSeq)
    => emittedAfter(REST, .IntSeq,
         seqConcat(seqConcat(OUT, sortedWord(WORD)), iCons(32, .IntSeq)))
    [simplification]
  rule emittedAfter(iCons(C:Int, REST:IntSeq), WORD:IntSeq, OUT:IntSeq)
    => emittedAfter(REST, seqConcat(WORD, iCons(C, .IntSeq)), OUT)
    requires C =/=Int 32
    [simplification]

  rule wordAfter(.IntSeq, WORD:IntSeq) => WORD [simplification]
  rule wordAfter(iCons(32, REST:IntSeq), _WORD:IntSeq)
    => wordAfter(REST, .IntSeq) [simplification]
  rule wordAfter(iCons(C:Int, REST:IntSeq), WORD:IntSeq)
    => wordAfter(REST, seqConcat(WORD, iCons(C, .IntSeq)))
    requires C =/=Int 32
    [simplification]

  rule antiShuffleCodes(CS:IntSeq)
    => seqConcat(emittedAfter(CS, .IntSeq, .IntSeq),
                 sortedWord(wordAfter(CS, .IntSeq))) [simplification]

  // Allocator invariant: all integer heap keys precede the next location.
  rule keysBelow(.Map, _NEXT:Int) => true [simplification]
  rule keysBelow((I:Int |-> _VALUE:KItem) REST:Map, NEXT:Int)
    => (I <Int NEXT) andBool keysBelow(REST, NEXT)
    requires notBool (I in_keys(REST))
    [simplification]

  rule NEXT:Int in_keys(HEAP:Map) => false
    requires keysBelow(HEAP, NEXT)
    [simplification]
  rule keysBelow(HEAP:Map, NEXT:Int +Int 1) => true
    requires keysBelow(HEAP, NEXT)
    [simplification]
  rule keysBelow(HEAP:Map, NEXT:Int +Int 2) => true
    requires keysBelow(HEAP, NEXT)
    [simplification]
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [loop-invariant]:
    <k> #loop(str(CS:IntSeq), Name("char"), antiLoopBody .Stmts)
        => .K ... </k>
    <env> L:Int </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope("anti_shuffle" |-> FUNCTION:Val, parent(-1))
      L:Int |-> scope(
        "char"   |-> (str(OLDCHAR:IntSeq) => str(?FINALCHAR:IntSeq))
        "result" |-> (str(OUT:IntSeq) => str(emittedAfter(CS, WORD, OUT)))
        "s"      |-> str(INPUT:IntSeq)
        "word"   |-> (str(WORD:IntSeq) => str(wordAfter(CS, WORD))),
        parent(0))
    </scopes>
    <heap> HEAP:Map => ?FINALHEAP:Map </heap>
    <heapLoc> NEXT:Int => ?FINALNEXT:Int </heapLoc>
    requires keysBelow(HEAP, NEXT)
    ensures keysBelow(?FINALHEAP, ?FINALNEXT)

  claim [anti-shuffle]:
    <k> FuncDef("anti_shuffle", Params("s"), antiBody)
        ~> Call(Name("anti_shuffle"), str(CS:IntSeq))
        => str(antiShuffleCodes(CS)) </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
      => ?FINALSCOPES:Map
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => ?FINALHEAP:Map </heap>
    <heapLoc> 0 => ?FINALNEXT:Int </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
#!/usr/bin/env bash
set -eu

cd "$(dirname "$0")"

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy
python3 py2mpy.py differential.py > differential.mpy

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun smoke.mpy --definition runtime-kompiled > /dev/null
printf 'K_SMOKE: 5/5\n'

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module VERIFICATION-SYNTAX \
  --output-definition verification-kompiled

krun solution.mpy --definition verification-kompiled > solution.final
krun proof-program.mpy --definition verification-kompiled > proof-program.final
diff -u solution.final proof-program.final
printf 'PROGRAM_IDENTITY: translated body equals expanded proof body\n'

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.loop-invariant

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY; then
  printf 'UNEXPECTED SUCCESS: false-result mutation proved\n' >&2
  exit 1
else
  printf 'EXPECTED FAILURE: false-result mutation rejected\n'
fi

kompile --backend haskell verification-mutant.k \
  --main-module VERIFICATION-MUTANT \
  --syntax-module VERIFICATION-MUTANT-SYNTAX \
  --output-definition verification-mutant-kompiled

if kprove spec-body-mutant.k \
     --definition verification-mutant-kompiled \
     --spec-module SPEC-BODY-MUTANT; then
  printf 'UNEXPECTED SUCCESS: body mutation proved\n' >&2
  exit 1
else
  printf 'EXPECTED FAILURE: body mutation rejected\n'
fi

python3 oracle_test.py
krun differential.mpy --definition runtime-kompiled > /dev/null
printf 'K_DIFFERENTIAL: 20/20; mismatches=0\n'
VALIDATED

## What is proven

Under the supplied MPY semantics, for every modeled string value `str(CS:IntSeq)`, executing the exact translated definition of `anti_shuffle` from a fresh module configuration returns

```k
str(antiShuffleCodes(CS))
```

with normal function return (`env = 0`, empty stack, `noRet`, `NoExc`, and exit code 0). `antiShuffleCodes` scans left to right, retains every code other than space (`32`) in its current word, emits every space in its original position, and applies the supplied `sortVS` primitive to the characters of each word. This is a partial-correctness theorem. The value-level conclusion that each emitted word is the ASCII-ascending permutation of its input word is conditional on the supplied semantics' documented `sortVS` contract.

Both claims in `spec.k` were proved. The focused loop proof and the combined proof each printed `#Top` and exited 0.

## Formal claim and validation scope

- Program boundary: the exact `FuncDef("anti_shuffle", Params("s"), antiBody)`, its definition binding, name lookup, argument binding, body, loop, `list`, `sorted`, `join`, string operations, allocations, return, and frame pop.
- Input domain: every MPY string `str(CS:IntSeq)`. Non-string values are excluded. Code `32` is the only word separator, matching the prompt's literal-space wording.
- Observable final state: the returned string plus normal control state. Local scopes, garbage list objects created by `list`/`sorted`, and their numeric heap locations are internal and intentionally unobserved.
- Intended property: preserve word order and every blank space, while sorting the characters within each word in ascending ASCII/code order.

The entry claim is:

```k
<k> FuncDef("anti_shuffle", Params("s"), antiBody)
    ~> Call(Name("anti_shuffle"), str(CS:IntSeq))
    => str(antiShuffleCodes(CS)) </k>
```

It starts with the exact MPY module and builtins scopes, an empty heap, `heapLoc = 0`, empty stack, `noRet`, `NoExc`, and exit code 0. The loop claim is a circularity over arbitrary remaining `CS`, current `WORD`, and emitted `OUT`, with exact local bindings and the allocator invariant `keysBelow(HEAP, NEXT)`.

## Proof-extension inventory

### `antiLoopBody`, `antiFinalExpr`, and `antiBody`

- Class: definitional macro abbreviations.
- Semantic role: name exact AST constructor terms; they do not add an operational case.
- Domain and matched context: only their displayed syntax occurrences.
- Justification scope and containment: `krun solution.mpy` and `krun proof-program.mpy` under the proof definition produced byte-identical complete final configurations; `diff` exited 0.
- State footprint: none beyond the expanded program's fixed-semantics footprint.
- Dependents: both claims.
- Validation: the body mutation in `verification-mutant.k` is rejected on witness `"ba"`.

### `sortedWord(IntSeq)`

- Class: definitional summary.
- Semantic role: names, without replacing execution, the exact MPY value of `''.join(sorted(list(word)))`:

  ```k
  joinCodes(.IntSeq, sortVS(charsOf(CS)))
  ```

- Domain: all `IntSeq`; the single equation is total, unguarded, terminating, and has no overlap.
- Matched context: value terms only; no continuation, binding, control, or state cells.
- State footprint: none.
- Justification: direct composition of the imported `charsOf`, `sortVS`, and `joinCodes` definitions.
- Dependents: scan summaries and both proof claims.
- Validation: fixed semantics executes the actual three calls; the 20-case K differential suite exercises the concrete `sortVS` leg.

### `emittedAfter`, `wordAfter`, and `antiShuffleCodes`

- Class: definitional summaries.
- Semantic role: characterize the scan result; they never rewrite a program term.
- Domain: all `IntSeq` inputs. Empty, space-head, and non-space-head equations are exhaustive. The head guards `C == 32` and `C =/= 32` are disjoint. Recursive calls strictly consume `REST`.
- Matched context: value terms only.
- State footprint: none.
- Justification: structural definition of the source loop. The space equation uses the source expression's exact left association, `(OUT + sortedWord(WORD)) + " "`.
- Dependents: loop and entry claims.
- Validation: base and both step branches close in the focused loop proof; false-result and body mutations fail.

### `keysBelow(Map, Int)` and allocator lemmas

- Class: `keysBelow` is a definitional invariant summary; the `in_keys` freshness rule and the `+1`/`+2` monotonic rules are derived lemmas.
- Semantic role: reason about fixed allocation guards; they do not allocate, mutate, or replace a program operation.
- Domain: the reachable heaps, whose keys are integers. `.Map` is true; each unique integer map entry contributes `I < NEXT`. Recursion removes one finite map entry. The claim starts from `.Map, 0` and fixed semantics adds only integer keys.
- Matched context: Boolean/property terms only; no control context.
- Justification: if every key is below `NEXT`, `NEXT` is absent; the same keys are below `NEXT + 1` and `NEXT + 2`. Overlapping applications all produce `true` under their guards.
- Dependents: loop allocation and the final `list`/`sorted` allocations.
- State footprint: reads the abstract heap keys and `heapLoc`; writes nothing. The loop claim permits fresh garbage to be added and preserves `keysBelow` in its `ensures` clause.
- Validation: the proof reaches the real `#alloc` rules at spaces and after the loop; removing the invariant previously left exactly the freshness guard stuck.

### `SPEC.loop-invariant`

- Class: derived auxiliary reachability claim/circularity.
- Semantic role: summarizes repeated execution only after proving one complete fixed-semantics iteration and the empty case; it is not an ordinary rewrite in `verification.k`.
- Domain: exact `#loop(str(CS), Name("char"), antiLoopBody)`; active `env = L`; exact builtins, module, and local scopes; string locals; and `keysBelow(HEAP, NEXT)`.
- Matched context: its `<k>` suffix is framed. The body contains no `return`, `break`, `continue`, exception, cleanup, or other abrupt control, and the theorem itself is quantified over that preserved suffix. Other control cells are framed and unchanged.
- Justification scope and containment: the claim proves exactly the context it later matches in the entry proof. The entry's module map, parent chain, local map, heap, and allocator invariant are a substitution instance of the claim.
- State footprint: reads and writes local `char`, `result`, and `word`; reads `s`; reads/extends heap and increments `heapLoc` through the imported allocation rules; preserves existing heap entries and all framed control cells. Fresh temporary lists do not escape into any scope.
- Dependents: `SPEC.anti-shuffle`.
- Control validation: fixed execution reaches the loop head; the focused claim prints `#Top`; the body mutation is rejected and the exact final continuation in the entry proof completes normally.

### Imported `sortVS(ValSeq)`

- Class: supplied trusted primitive, not a proof-local extension.
- Semantic role: represents ascending sorting. It is opaque on symbolic lists and uses the supplied concrete insertion-sort equations for ground execution.
- Domain: lists of one-character MPY strings produced by `charsOf`.
- State/control footprint: value only; `sorted` allocation itself still executes under fixed semantics.
- Justification: the reference semantics explicitly declares this trust boundary. No proof-local rule strengthens or bypasses it.
- Dependents: `sortedWord`, both claims, and the human-facing “ascending order” conclusion.
- Validation: 20 independent concrete K cases, including empty words, repeated spaces, mixed case, digits, and punctuation, all match CPython's oracle; this is finite evidence, not a universal K proof of sorting.

There are no proof-local operational bridges and no rules that intercept `Call`, `#applyK`, `#loop`, `Return`, frame operations, or exception behavior.

