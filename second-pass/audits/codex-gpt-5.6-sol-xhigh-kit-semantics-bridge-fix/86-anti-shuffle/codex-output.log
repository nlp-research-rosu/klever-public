{"timestamp":"2026-07-23T00:51:52.912Z","type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_dbd7HMUtfTW7fuc5k6lNAYiM","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"reference-semantics/semantics/concrete.k:20:  // ==== keyed sort, concrete leg ============================================\nreference-semantics/semantics/concrete.k:23:  // allocates the result. priority(40) beats sort.k's opaque rules, so krun\nreference-semantics/semantics/concrete.k:24:  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.\nreference-semantics/semantics/concrete.k:26:  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)\nreference-semantics/semantics/concrete.k:28:  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), .Vals))\nreference-semantics/semantics/concrete.k:29:        => #ksort(VS, KV, .ValSeq, false) ... </k>\nreference-semantics/semantics/concrete.k:31:  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), kwV(\"reverse\", RB:Bool), .Vals))\nreference-semantics/semantics/concrete.k:32:        => #ksort(VS, KV, .ValSeq, RB) ... </k>\nreference-semantics/semantics/concrete.k:34:  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)\nreference-semantics/semantics/concrete.k:36:  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)\nreference-semantics/semantics/concrete.k:39:        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>\nreference-semantics/semantics/concrete.k:54:  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)\nreference-semantics/semantics/core.k:15:  syntax Str    ::= str(IntSeq)\nreference-semantics/semantics/core.k:17:  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)\nreference-semantics/semantics/core.k:34:                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method\nreference-semantics/semantics/core.k:172:                  [ \"sorted\" <- builtinV(\"sorted\") ]\nreference-semantics/semantics/core.k:188:                  | #applyK(ApplyK, Vals)\nreference-semantics/semantics/core.k:191:  rule <k> #evalArgs(.Exprs, ACC:Vals, K:ApplyK) => #applyK(K, ACC) ... </k>\nreference-semantics/semantics/core.k:203:  rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)\nreference-semantics/semantics/str.k:8:  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>\nreference-semantics/semantics/str.k:9:  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))\nreference-semantics/semantics/str.k:10:        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>\nreference-semantics/semantics/str.k:14:  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>\nreference-semantics/semantics/str.k:24:  rule applyBin(\"+\",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))\nreference-semantics/semantics/str.k:25:  rule applyCmp(\"==\", str(A:IntSeq), str(B:IntSeq)) => A ==K B\nreference-semantics/semantics/str.k:26:  rule applyCmp(\"!=\", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)\nreference-semantics/semantics/str.k:29:  rule applyCmp(\"in\",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)\nreference-semantics/semantics/str.k:30:  rule applyCmp(\"not in\", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)\nreference-semantics/semantics/str.k:46:  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on\nreference-semantics/semantics/str.k:56:  rule applyCmp(\"<\",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)\nreference-semantics/semantics/str.k:57:  rule applyCmp(\">\",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)\nreference-semantics/semantics/str.k:58:  rule applyCmp(\"<=\", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)\nreference-semantics/semantics/str.k:59:  rule applyCmp(\">=\", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)\nreference-semantics/semantics/methods.k:13:  rule applyMethod(str(CS:IntSeq), \"isupper\", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)\nreference-semantics/semantics/methods.k:14:  rule applyMethod(str(CS:IntSeq), \"islower\", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)\nreference-semantics/semantics/methods.k:15:  rule applyMethod(str(CS:IntSeq), \"isalpha\", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)\nreference-semantics/semantics/methods.k:16:  rule applyMethod(str(CS:IntSeq), \"isdigit\", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)\nreference-semantics/semantics/methods.k:19:  rule applyMethod(str(CS:IntSeq), \"lower\",    .Vals) => str(mapLower(CS))\nreference-semantics/semantics/methods.k:20:  rule applyMethod(str(CS:IntSeq), \"upper\",    .Vals) => str(mapUpper(CS))\nreference-semantics/semantics/methods.k:21:  rule applyMethod(str(CS:IntSeq), \"swapcase\", .Vals) => str(mapSwap(CS))\nreference-semantics/semantics/methods.k:23:  // ==== join / count / strip / encode ========================================\nreference-semantics/semantics/methods.k:24:  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by\nreference-semantics/semantics/methods.k:26:  rule applyMethod(str(SEP:IntSeq), \"join\", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))\nreference-semantics/semantics/methods.k:27:  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]\nreference-semantics/semantics/methods.k:28:  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq\nreference-semantics/semantics/methods.k:29:  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS\nreference-semantics/semantics/methods.k:30:  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))\nreference-semantics/semantics/methods.k:31:    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))\nreference-semantics/semantics/methods.k:34:  rule applyMethod(str(CS:IntSeq), \"count\", str(PC:IntSeq), .Vals) => cntSub(CS, PC)\nreference-semantics/semantics/methods.k:47:  rule applyMethod(str(CS:IntSeq), \"strip\", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))\nreference-semantics/semantics/methods.k:58:  rule applyMethod(str(CS:IntSeq), \"encode\", str(_:IntSeq), .Vals) => str(CS)\nreference-semantics/semantics/methods.k:61:  rule applyMethod(str(XC:IntSeq), \"startswith\", str(PC:IntSeq), .Vals) => startsWith(PC, XC)\nreference-semantics/semantics/methods.k:70:  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========\nreference-semantics/semantics/methods.k:71:  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.\nreference-semantics/semantics/methods.k:72:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), .Vals)\nreference-semantics/semantics/methods.k:73:        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>\nreference-semantics/semantics/methods.k:75:  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result\nreference-semantics/semantics/methods.k:76:  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)\nreference-semantics/semantics/methods.k:77:  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))\nreference-semantics/semantics/methods.k:79:  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)\nreference-semantics/semantics/methods.k:84:  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))\nreference-semantics/semantics/methods.k:88:  // split(sep='x') keyword form delegates to the positional k-cell rule\nreference-semantics/semantics/methods.k:89:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), (kwV(\"sep\", str(S:IntSeq)), .Vals))\nreference-semantics/semantics/methods.k:90:        => #applyK(toCall(boundMethodV(str(CS), \"split\")), (str(S), .Vals)) ... </k>\nreference-semantics/semantics/methods.k:93:  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).\nreference-semantics/semantics/methods.k:94:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), (str(iCons(SEP:Int, .IntSeq)), .Vals))\nreference-semantics/semantics/methods.k:95:        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>\nreference-semantics/semantics/methods.k:97:  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token\nreference-semantics/semantics/methods.k:98:  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)\nreference-semantics/semantics/methods.k:99:  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))\nreference-semantics/semantics/methods.k:101:  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))\nreference-semantics/semantics/methods.k:104:  rule applyMethod(str(CS:IntSeq), \"replace\", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)\nreference-semantics/semantics/methods.k:105:    => str(replaceC(CS, A, B))\nreference-semantics/semantics/call.k:3:// builtins at the root; a cooled Attribute is a bound method), evaluate the args (the shared\nreference-semantics/semantics/call.k:8://   typeV         -> callable type objects: int(...) / str(...)\nreference-semantics/semantics/call.k:16:  rule <k> Attribute(V:Val, M:String) => boundMethodV(V, M) ... </k>\nreference-semantics/semantics/call.k:24:  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), ACC:Vals) => applyMethod(OBJ, M, ACC) ... </k>\nreference-semantics/semantics/call.k:26:  rule <k> #applyK(toCall(builtinV(\"sum\")), (OBJ:Iterable, .Vals)) => #sumAcc(OBJ, 0) ... </k>\nreference-semantics/semantics/call.k:27:  rule <k> #applyK(toCall(builtinV(\"all\")), (OBJ:Iterable, .Vals)) => #allAcc(OBJ)    ... </k>\nreference-semantics/semantics/call.k:28:  rule <k> #applyK(toCall(builtinV(\"any\")), (OBJ:Iterable, .Vals)) => #anyAcc(OBJ)    ... </k>\nreference-semantics/semantics/call.k:29:  rule <k> #applyK(toCall(builtinV(\"max\")), (OBJ:Iterable, .Vals)) => #maxAcc0(OBJ)   ... </k>\nreference-semantics/semantics/call.k:30:  rule <k> #applyK(toCall(builtinV(\"min\")), (OBJ:Iterable, .Vals)) => #minAcc0(OBJ)   ... </k>\nreference-semantics/semantics/call.k:31:  rule <k> #applyK(toCall(builtinV(BN:String)), ACC:Vals) => applyBuiltin(BN, ACC) ... </k> [owise]\nreference-semantics/semantics/call.k:32:  rule <k> #applyK(toCall(typeV(T:String)),     ACC:Vals) => applyBuiltin(T, ACC)  ... </k>\nreference-semantics/semantics/call.k:36:  // (covers len/sum/all/any/max/min/sorted/list/set + zip's pair). Mutating list\nreference-semantics/semantics/call.k:38:  rule <k> #applyK(toCall(builtinV(BN:String)), (ref(H:Int), REST:Vals))\nreference-semantics/semantics/call.k:39:        => #applyK(toCall(builtinV(BN)), (V, REST)) ... </k>\nreference-semantics/semantics/call.k:42:  rule <k> #applyK(toCall(builtinV(BN:String)), (A:Val, ref(H:Int), REST:Vals))\nreference-semantics/semantics/call.k:43:        => #applyK(toCall(builtinV(BN)), (A, V, REST)) ... </k>\nreference-semantics/semantics/call.k:47:  rule <k> #applyK(toCall(typeV(T:String)), (ref(H:Int), REST:Vals))\nreference-semantics/semantics/call.k:48:        => #applyK(toCall(typeV(T)), (V, REST)) ... </k>\nreference-semantics/semantics/call.k:54:    => M ==String \"append\" orBool M ==String \"sort\" orBool M ==String \"extend\"\nreference-semantics/semantics/call.k:56:  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), M:String)), ACC:Vals)\nreference-semantics/semantics/call.k:57:        => #applyK(toCall(boundMethodV(V, M)), ACC) ... </k>\nreference-semantics/semantics/call.k:61:  // non-mutating methods READ their heap-object arguments too (join's list);\nreference-semantics/semantics/call.k:63:  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), (ref(H:Int), REST:Vals))\nreference-semantics/semantics/call.k:64:        => #applyK(toCall(boundMethodV(OBJ, M)), (V, REST)) ... </k>\nreference-semantics/semantics/call.k:69:  rule <k> #applyK(toCall(closureVal(PNS:ParamNames, BODY:Stmts, DEFL:Int)), ACC:Vals) ~> CONT\nreference-semantics/semantics/call.k:80:  rule <k> #applyK(toCall(closureValC(PNS:ParamNames, CVS:ParamNames, BODY:Stmts, CM:Map)), ACC:Vals) ~> CONT\nreference-semantics/semantics/sort.k:1:// reference/src/semantics/sort.k — MPY-SORT\nreference-semantics/semantics/sort.k:2:// Trusted sorted(): sorted(list) as an opaque ascending permutation `sortVS` — opaque symbolic\nreference-semantics/semantics/sort.k:3:// for kprove (a trusted primitive, correctness/ordering proved in Lean / notes/sort-probe),\nreference-semantics/semantics/sort.k:4:// and a concrete insertion sort for krun. Wrappers verify the logic AROUND the sort (index /\nreference-semantics/semantics/sort.k:5:// slice / filter / dedup); indexing an opaque sortVS(VS) carries through as an opaque term, so\nreference-semantics/semantics/sort.k:6:// no ordering lemma is needed in K — the trust (sortVS = real sorted) is discharged by each\nreference-semantics/semantics/sort.k:8:// sorts are separate. Fires only via the \"sorted\" builtin, so inert for non-sorting programs.\nreference-semantics/semantics/sort.k:14:  // sortVS(VS): the ascending sort of the Val list VS. Opaque for symbolic VS (no-evaluators);\nreference-semantics/semantics/sort.k:15:  // concrete insertion sort for krun.\nreference-semantics/semantics/sort.k:16:  // Concrete sort matches Int-sorted elements directly (an int Val IS an Int); projectIntTotal\nreference-semantics/semantics/sort.k:18:  syntax ValSeq ::= sortVS(ValSeq) [function, total, symbol(sortVS), no-evaluators]\nreference-semantics/semantics/sort.k:20:  rule sortVS(.ValSeq)                => .ValSeq          [concrete]\nreference-semantics/semantics/sort.k:21:  rule sortVS(vCons(X:Int, R:ValSeq)) => insVS(X, sortVS(R)) [concrete]\nreference-semantics/semantics/sort.k:27:  rule sortVS(vCons(str(CS:IntSeq), R:ValSeq)) => insVSs(CS, sortVS(R)) [concrete]\nreference-semantics/semantics/sort.k:28:  rule insVSs(A:IntSeq, .ValSeq) => vCons(str(A), .ValSeq) [concrete]\nreference-semantics/semantics/sort.k:29:  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(A), vCons(str(B), R))\nreference-semantics/semantics/sort.k:31:  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))\nreference-semantics/semantics/sort.k:34:  // sorted(list) constructs a NEW object: k-cell pre-dispatch (beats the [owise]\nreference-semantics/semantics/sort.k:36:  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), .Vals))\nreference-semantics/semantics/sort.k:37:        => #alloc(list(sortVS(VS))) ... </k>\nreference-semantics/semantics/sort.k:39:  // mutator: xs.sort() — the in-place heap write over the same trusted sortVS\nreference-semantics/semantics/sort.k:40:  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), \"sort\")), .Vals) => noneV ... </k>\nreference-semantics/semantics/sort.k:41:       <heap> ... H |-> list(VS:ValSeq => sortVS(VS)) ... </heap>\nreference-semantics/semantics/sort.k:44:  // ==== keyed / reversed sorted() (WP2) =====================================\nreference-semantics/semantics/sort.k:45:  // sortKeyVS(VS, KV): the stable ascending sort of VS by the key value KV\nreference-semantics/semantics/sort.k:49:  syntax ValSeq ::= sortKeyVS(ValSeq, Val) [function, total, symbol(sortKeyVS), no-evaluators]\nreference-semantics/semantics/sort.k:61:  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), .Vals))\nreference-semantics/semantics/sort.k:62:        => #alloc(list(sortKeyVS(VS, KV))) ... </k>\nreference-semantics/semantics/sort.k:63:  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), kwV(\"reverse\", RB:Bool), .Vals))\nreference-semantics/semantics/sort.k:64:        => #alloc(list(condRev(sortKeyVS(VS, KV), RB))) ... </k>\nreference-semantics/semantics/sort.k:65:  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"reverse\", RB:Bool), .Vals))\nreference-semantics/semantics/sort.k:66:        => #alloc(list(condRev(sortVS(VS), RB))) ... </k>\nreference-semantics/semantics/sort.k:68:  // Indexing the opaque sorted list: `valSeqAt(sortVS(VS), I)` is DEFINED because valSeqAt is\nreference-semantics/semantics/sort.k:69:  // [total] (subscript.k) — it stays an abstract total value for a symbolic sort and reduces\nreference-semantics/semantics/sort.k:70:  // over the concrete sort for krun. No separate sortedAt indirection is needed; wrappers write\nreference-semantics/semantics/sort.k:71:  // their postcondition directly as valSeqAt(sortVS(VS), …).\n// reference/src/semantics/sort.k — MPY-SORT\n// Trusted sorted(): sorted(list) as an opaque ascending permutation `sortVS` — opaque symbolic\n// for kprove (a trusted primitive, correctness/ordering proved in Lean / notes/sort-probe),\n// and a concrete insertion sort for krun. Wrappers verify the logic AROUND the sort (index /\n// slice / filter / dedup); indexing an opaque sortVS(VS) carries through as an opaque term, so\n// no ordering lemma is needed in K — the trust (sortVS = real sorted) is discharged by each\n// problem's differential test. Only int lists (compared by projectIntTotal); keyed / string\n// sorts are separate. Fires only via the \"sorted\" builtin, so inert for non-sorting programs.\n\nmodule MPY-SORT\n  imports MPY-BUILTINS\n  imports MPY-SUBSCRIPT\n\n  // sortVS(VS): the ascending sort of the Val list VS. Opaque for symbolic VS (no-evaluators);\n  // concrete insertion sort for krun.\n  // Concrete sort matches Int-sorted elements directly (an int Val IS an Int); projectIntTotal\n  // (lemmas-only) is not available in the semantics. Int and str lists.\n  syntax ValSeq ::= sortVS(ValSeq) [function, total, symbol(sortVS), no-evaluators]\n  syntax ValSeq ::= insVS(Int, ValSeq) [function]\n  rule sortVS(.ValSeq)                => .ValSeq          [concrete]\n  rule sortVS(vCons(X:Int, R:ValSeq)) => insVS(X, sortVS(R)) [concrete]\n  rule insVS(X:Int, .ValSeq)                => vCons(X, .ValSeq) [concrete]\n  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(X, vCons(Y, R)) requires X <=Int Y [concrete]\n  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(Y, insVS(X, R)) requires X  >Int Y [concrete]\n  // str elements insert by the shared lexicographic strLt (methods.k)\n  syntax ValSeq ::= insVSs(IntSeq, ValSeq) [function]\n  rule sortVS(vCons(str(CS:IntSeq), R:ValSeq)) => insVSs(CS, sortVS(R)) [concrete]\n  rule insVSs(A:IntSeq, .ValSeq) => vCons(str(A), .ValSeq) [concrete]\n  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(A), vCons(str(B), R))\n       requires strLt(A, B) orBool A ==K B [concrete]\n  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))\n       requires notBool (strLt(A, B) orBool A ==K B) [concrete]\n\n  // sorted(list) constructs a NEW object: k-cell pre-dispatch (beats the [owise]\n  // applyBuiltin routing in call.k) so the result allocates.\n  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), .Vals))\n        => #alloc(list(sortVS(VS))) ... </k>\n\n  // mutator: xs.sort() — the in-place heap write over the same trusted sortVS\n  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), \"sort\")), .Vals) => noneV ... </k>\n       <heap> ... H |-> list(VS:ValSeq => sortVS(VS)) ... </heap>\n       [priority(40)]\n\n  // ==== keyed / reversed sorted() (WP2) =====================================\n  // sortKeyVS(VS, KV): the stable ascending sort of VS by the key value KV\n  // (a closure/builtin/type — anything callable). OPAQUE here; the concrete\n  // leg (MPY-CONCRETE, llvm only) computes keys by REAL calls and stable-\n  // inserts, at priority(40) over these.\n  syntax ValSeq ::= sortKeyVS(ValSeq, Val) [function, total, symbol(sortKeyVS), no-evaluators]\n\n  syntax ValSeq ::= revVS(ValSeq) [function, total]\n                  | revVSAcc(ValSeq, ValSeq) [function, total]\n  rule revVS(S:ValSeq) => revVSAcc(S, .ValSeq)\n  rule revVSAcc(.ValSeq, A:ValSeq) => A\n  rule revVSAcc(vCons(V:Val, R:ValSeq), A:ValSeq) => revVSAcc(R, vCons(V, A))\n\n  syntax ValSeq ::= condRev(ValSeq, Bool) [function, total]\n  rule condRev(S:ValSeq, false) => S\n  rule condRev(S:ValSeq, true)  => revVS(S)\n\n  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), .Vals))\n        => #alloc(list(sortKeyVS(VS, KV))) ... </k>\n  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), kwV(\"reverse\", RB:Bool), .Vals))\n        => #alloc(list(condRev(sortKeyVS(VS, KV), RB))) ... </k>\n  rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"reverse\", RB:Bool), .Vals))\n        => #alloc(list(condRev(sortVS(VS), RB))) ... </k>\n\n  // Indexing the opaque sorted list: `valSeqAt(sortVS(VS), I)` is DEFINED because valSeqAt is\n  // [total] (subscript.k) — it stays an abstract total value for a symbolic sort and reduces\n  // over the concrete sort for krun. No separate sortedAt indirection is needed; wrappers write\n  // their postcondition directly as valSeqAt(sortVS(VS), …).\nendmodule\n// reference/src/semantics/methods.k — MPY-METHODS\n\nmodule MPY-METHODS\n  imports MPY-CORE\n  imports K-EQUAL\n  imports MPY-STR\n  imports MPY-LIST\n\n  // method-call routing + arg-eval live in call.k; this module owns applyMethod.\n  syntax Val ::= applyMethod(Val, String, Vals) [function]\n\n  // ==== string predicates (Python semantics) =================================\n  rule applyMethod(str(CS:IntSeq), \"isupper\", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)\n  rule applyMethod(str(CS:IntSeq), \"islower\", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)\n  rule applyMethod(str(CS:IntSeq), \"isalpha\", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)\n  rule applyMethod(str(CS:IntSeq), \"isdigit\", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)\n\n  // ==== case maps ============================================================\n  rule applyMethod(str(CS:IntSeq), \"lower\",    .Vals) => str(mapLower(CS))\n  rule applyMethod(str(CS:IntSeq), \"upper\",    .Vals) => str(mapUpper(CS))\n  rule applyMethod(str(CS:IntSeq), \"swapcase\", .Vals) => str(mapSwap(CS))\n\n  // ==== join / count / strip / encode ========================================\n  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by\n  // the call layer; the result str is a value)\n  rule applyMethod(str(SEP:IntSeq), \"join\", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))\n  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]\n  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq\n  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS\n  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))\n    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))\n\n  // S.count(sub): non-overlapping window scan (Python str.count)\n  rule applyMethod(str(CS:IntSeq), \"count\", str(PC:IntSeq), .Vals) => cntSub(CS, PC)\n  syntax Int ::= cntSub(IntSeq, IntSeq) [function]\n  rule cntSub(.IntSeq, _:IntSeq) => 0\n  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)\n       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0\n  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)\n       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0\n  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]\n  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0\n  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]\n  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0\n\n  // S.strip(): trim whitespace runs from both ends\n  rule applyMethod(str(CS:IntSeq), \"strip\", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))\n  syntax IntSeq ::= trimWS(IntSeq) [function, total]\n  rule trimWS(.IntSeq) => .IntSeq\n  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)\n  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)\n  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]\n  rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)\n  rule revISAcc(.IntSeq, A:IntSeq) => A\n  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))\n\n  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)\n  rule applyMethod(str(CS:IntSeq), \"encode\", str(_:IntSeq), .Vals) => str(CS)\n\n  // ==== prefix ===============================================================\n  rule applyMethod(str(XC:IntSeq), \"startswith\", str(PC:IntSeq), .Vals) => startsWith(PC, XC)\n\n  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========\n  rule applyMethod(list(VS:ValSeq), \"count\", V:Val, .Vals) => cntOccVS(VS, V)\n  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]\n  rule cntOccVS(.ValSeq, _:Val)                => 0\n  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V\n  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)\n\n  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========\n  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.\n  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), .Vals)\n        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>\n       [priority(40)]\n  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result\n  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)\n  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))\n       requires isWSC(C)\n  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)\n       requires notBool isWSC(C)\n  // flush the current token to the result list iff non-empty.\n  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]\n  rule flushTok(ACC:ValSeq, .IntSeq)            => ACC\n  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))\n  syntax Bool ::= isWSC(Int) [function, total]\n  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13\n\n  // split(sep='x') keyword form delegates to the positional k-cell rule\n  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), (kwV(\"sep\", str(S:IntSeq)), .Vals))\n        => #applyK(toCall(boundMethodV(str(CS), \"split\")), (str(S), .Vals)) ... </k>\n       [priority(39)]\n\n  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).\n  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), (str(iCons(SEP:Int, .IntSeq)), .Vals))\n        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>\n       [priority(40)]\n  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token\n  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)\n  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))\n       requires C ==Int SEP\n  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))\n       requires notBool (C ==Int SEP)\n\n  rule applyMethod(str(CS:IntSeq), \"replace\", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)\n    => str(replaceC(CS, A, B))\n  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]\n  rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq\n  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A\n  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(C, replaceC(R, A, B)) requires notBool (C ==Int A)\n\n  // ==== char helpers =========================================================\n  syntax Bool ::= isUpperC(Int) [function, total]\n  rule isUpperC(C:Int) => C >=Int 65 andBool C <=Int 90\n\n  syntax Bool ::= isLowerC(Int) [function, total]\n  rule isLowerC(C:Int) => C >=Int 97 andBool C <=Int 122\n\n  syntax Bool ::= isAlphaC(Int) [function, total]\n  rule isAlphaC(C:Int) => isUpperC(C) orBool isLowerC(C)\n\n  syntax Bool ::= isDigitC(Int) [function, total]\n  rule isDigitC(C:Int) => C >=Int 48 andBool C <=Int 57\n\n  syntax Bool ::= hasUpper(IntSeq) [function, total]\n  rule hasUpper(.IntSeq) => false\n  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)\n\n  syntax Bool ::= hasLower(IntSeq) [function, total]\n  rule hasLower(.IntSeq) => false\n  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)\n\n  syntax Bool ::= allAlpha(IntSeq) [function, total]\n  rule allAlpha(.IntSeq) => true\n  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)\n\n  syntax Bool ::= allDigit(IntSeq) [function, total]\n  rule allDigit(.IntSeq) => true\n  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)\n\n  syntax Int ::= lowerC(Int) [function, total]\n\n  rule lowerC(C:Int) => C +Int 32 requires isUpperC(C)\n  rule lowerC(C:Int) => C         [owise]\n\n  syntax Int ::= upperC(Int) [function, total]\n  rule upperC(C:Int) => C -Int 32 requires isLowerC(C)\n  rule upperC(C:Int) => C         [owise]\n\n  syntax Int ::= swapC(Int) [function, total]\n  rule swapC(C:Int) => C +Int 32 requires isUpperC(C)\n  rule swapC(C:Int) => C -Int 32 requires isLowerC(C)\n  rule swapC(C:Int) => C         [owise]\n\n  syntax IntSeq ::= mapLower(IntSeq) [function, total]\n  rule mapLower(.IntSeq) => .IntSeq\n  rule mapLower(iCons(C:Int, S:IntSeq)) => iCons(lowerC(C), mapLower(S))\n\n  syntax IntSeq ::= mapUpper(IntSeq) [function, total]\n  rule mapUpper(.IntSeq) => .IntSeq\n  rule mapUpper(iCons(C:Int, S:IntSeq)) => iCons(upperC(C), mapUpper(S))\n\n  syntax IntSeq ::= mapSwap(IntSeq) [function, total]\n  rule mapSwap(.IntSeq) => .IntSeq\n  rule mapSwap(iCons(C:Int, S:IntSeq)) => iCons(swapC(C), mapSwap(S))\n\n  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]\n  rule startsWith(.IntSeq, _:IntSeq)               => true\n  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false\n  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)\nendmodule\n// reference/src/semantics/str.k — MPY-STR\n\nmodule MPY-STR\n  imports MPY-CORE\n  imports MPY-ITER\n\n  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==\n  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>\n  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))\n        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>\n\n  // ==== str literal (ASCII-only) ============================================\n  syntax IntSeq ::= strToCodes(String) [function]\n  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>\n  rule strToCodes(\"\") => .IntSeq\n  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))\n    requires S =/=String \"\" andBool ordChar(substrString(S, 0, 1)) <Int 128\n\n  // ==== operators: + / == / != / in =========================================\n  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]\n  rule seqConcat(.IntSeq, T:IntSeq)                => T\n  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))\n\n  rule applyBin(\"+\",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))\n  rule applyCmp(\"==\", str(A:IntSeq), str(B:IntSeq)) => A ==K B\n  rule applyCmp(\"!=\", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)\n\n  // substring membership: `P in X` iff the code-seq P occurs contiguously in X\n  rule applyCmp(\"in\",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)\n  rule applyCmp(\"not in\", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)\n\n  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]\n  rule strPrefix(.IntSeq, _:IntSeq)               => true\n  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false\n  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)\n\n  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]\n  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)\n  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)\n  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)\n       requires notBool strPrefix(P, iCons(C, Xs))\n\n  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code\n  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones\n  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic\n  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on\n  // str </<=/>/>= comparisons.\n  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]\n  rule strLt(.IntSeq, .IntSeq)                => false\n  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true\n  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false\n  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B\n  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B\n  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B\n\n  rule applyCmp(\"<\",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)\n  rule applyCmp(\">\",  str(A:IntSeq), str(B:IntSeq