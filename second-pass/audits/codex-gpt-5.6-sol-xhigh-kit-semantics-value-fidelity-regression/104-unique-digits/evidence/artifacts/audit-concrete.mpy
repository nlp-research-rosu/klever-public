Module(
  FuncDef("unique_digits", Params("x"),
    Assign(Name("result"), ListExpr())
    Assign(Name("n"), Int(1))
    Assign(Name("odd"), Bool(true))
    Assign(Name("y"), Int(0))
    For(Name("n"), Name("x"),
      Assign(Name("odd"), Bool(true))
      Assign(Name("y"), Name("n"))
      While(Compare(Name("y"), CmpOp(">", Int(0))),
        If(Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
          Assign(Name("odd"), Bool(false)),
          )
        Assign(Name("y"), BinOp("//", Name("y"), Int(10))))
      If(Name("odd"),
        Expr(Call(Attribute(Name("result"), "append"), Name("n"))),
        ))
    Expr(Call(Attribute(Name("result"), "sort"), ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(15), Int(33), Int(1422), Int(1))),
      CmpOp("==", ListExpr(Int(1), Int(15), Int(33)))))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(152), Int(323), Int(1422), Int(10))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("unique_digits"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("unique_digits"), ListExpr(Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("unique_digits"), ListExpr(Int(2))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(99), Int(15), Int(15), Int(1))),
      CmpOp("==", ListExpr(Int(1), Int(15), Int(15), Int(99)))))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(101), Int(111), Int(13579), Int(20))),
      CmpOp("==", ListExpr(Int(111), Int(13579))))))
