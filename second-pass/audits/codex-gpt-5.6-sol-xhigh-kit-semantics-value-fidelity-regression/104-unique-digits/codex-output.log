     1	def unique_digits(x):
     2	    result = []
     3	    n = 1
     4	    odd = True
     5	    y = 0
     6	    for n in x:
     7	        odd = True
     8	        y = n
     9	        while y > 0:
    10	            if y % 2 == 0:
    11	                odd = False
    12	            y = y // 10
    13	        if odd:
    14	            result.append(n)
    15	    result.sort()
    16	    return result

