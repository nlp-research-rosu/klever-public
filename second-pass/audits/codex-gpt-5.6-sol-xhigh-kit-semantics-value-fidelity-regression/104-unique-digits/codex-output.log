@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module AUDIT-BRIDGE-CONTEXT
+  imports VERIFICATION-BASE
+
+  // The fixed supplied rule must preserve an immediate observable continuation.
+  claim [fixed-yield-with-continuation]:
+    <k>
+      #iterYield(1, list(.ValSeq))
+      ~> #loopStep(Name("n"), .Stmts)
+      ~> Assign(Name("marker"), Int(7))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ... 0 |-> scope(
+            .Map
+            => ("n" |-> 1
+                "marker" |-> 7),
+            parent(-1))
+      ...
+    </scopes>
+
+  // This opposite interpretation is false: yielding 1 cannot bind n to 2.
+  claim [wrong-yield-value]:
+    <k>
+      #iterYield(1, list(.ValSeq))
+      ~> #loopStep(Name("n"), .Stmts)
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ... 0 |-> scope(.Map => ("n" |-> 2), parent(-1)) ...
+    </scopes>
+endmodule
diff --git a//tmp/audit-work/104-unique-digits/audit-concrete.py b//tmp/audit-work/104-unique-digits/audit-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..a20dd3051604230c0d1b6a7b8440440aea19d491
--- /dev/null
+++ b//tmp/audit-work/104-unique-digits/audit-concrete.py
@@ -0,0 +1,25 @@
+def unique_digits(x):
+    result = []
+    n = 1
+    odd = True
+    y = 0
+    for n in x:
+        odd = True
+        y = n
+        while y > 0:
+            if y % 2 == 0:
+                odd = False
+            y = y // 10
+        if odd:
+            result.append(n)
+    result.sort()
+    return result
+
+
+assert unique_digits([15, 33, 1422, 1]) == [1, 15, 33]
+assert unique_digits([152, 323, 1422, 10]) == []
+assert unique_digits([]) == []
+assert unique_digits([1]) == [1]
+assert unique_digits([2]) == []
+assert unique_digits([99, 15, 15, 1]) == [1, 15, 15, 99]
+assert unique_digits([101, 111, 13579, 20]) == [111, 13579]
