+sha256sum \
+  "$reference/prompt.py" \
+  "$candidate/prompt.py" \
+  "$reference/py2mpy.py" \
+  "$candidate/py2mpy.py" \
+  "$reference/canonical.py" \
+  "$candidate/solution.py" \
+  "$candidate/solution.mpy"
