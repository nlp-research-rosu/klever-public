     3	module VERIFICATION-SYNTAX
     4	  imports MPY-SYNTAX
     5	
     6	  syntax Bool ::= oddDigits(Int) [function, total, no-evaluators]
     7	                | positiveInts(ValSeq) [function, total]
     8	  syntax ValSeq ::= filterOddDigits(ValSeq) [function, total]
     9	                  | filterOddAcc(ValSeq, ValSeq)
    10	                    [function, total, no-evaluators]
    11	
    12	  syntax Expr ::= "#digitCondition" [function, total]
    13	  syntax Stmts ::= "#digitBody" [function, total]
    14	                   | "#outerBody" [function, total]
    15	                   | "#uniqueDigitsBody" [function, total]
    16	endmodule
    17	
    18	module VERIFICATION-BASE
    19	  imports MPY
    20	  imports VERIFICATION-SYNTAX
    21	
    22	  syntax Int ::= projectIntTotal(Val) [function, total]
    23	
    24	  // Mathematical predicate: every decimal digit of a non-negative integer is
    25	  // odd.  The N == 0 equation is the empty suffix reached after all digits
    26	  // have been consumed; source inputs themselves are required to be positive.
    27	  rule oddDigits(N:Int) => true
    28	    requires N ==Int 0
    29	    [simplification]
    30	  rule oddDigits(N:Int) => false
    31	    requires N >Int 0 andBool pyMod(N, 2) ==Int 0
    32	    [simplification]
    33	  rule oddDigits(N:Int)
    34	    => oddDigits((N -Int pyMod(N, 10)) /Int 10)
    35	    requires N >Int 0 andBool pyMod(N, 2) =/=Int 0
    36	    [simplification]
    37	  rule oddDigits(N:Int) => false
    38	    requires N <Int 0
    39	    [simplification]
    40	
    41	  // The source contract's input domain, and the stable filter computed before
    42	  // the reference semantics' supplied ascending-sort primitive is invoked.
    43	  rule projectIntTotal(I:Int) => I
    44	  rule projectIntTotal(_:Val) => 0 [owise]
    45	
    46	  rule positiveInts(.ValSeq) => true
    47	  rule positiveInts(vCons(V:Val, REST:ValSeq))
    48	    => isInt(V)
    49	       andBool (projectIntTotal(V) >Int 0)
    50	       andBool positiveInts(REST)
    51	
    52	  rule filterOddDigits(VS:ValSeq) => filterOddAcc(.ValSeq, VS)
    53	
    54	  rule filterOddAcc(ACC:ValSeq, .ValSeq) => ACC
    55	    [simplification]
    56	  rule filterOddAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
    57	    => filterOddAcc(
    58	         valSeqConcat(ACC, vCons(projectIntTotal(V), .ValSeq)),
    59	         REST)
    60	    requires oddDigits(projectIntTotal(V))
    61	    [simplification]
    62	  rule filterOddAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
    63	    => filterOddAcc(ACC, REST)
    64	    requires notBool oddDigits(projectIntTotal(V))
    65	    [simplification]
    66	
    67	  // Exact AST aliases, used only to keep the invariant claims readable.
    68	  rule #digitCondition
    69	    => Compare(Name("y"), CmpOp(">", Int(0)))
    70	
    71	  rule #digitBody
    72	    => If(Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
    73	          Assign(Name("odd"), Bool(false)),
    74	          .Stmts)
    75	       Assign(Name("y"), BinOp("//", Name("y"), Int(10)))
    76	
    77	  rule #outerBody
    78	    => Assign(Name("odd"), Bool(true))
    79	       Assign(Name("y"), Name("n"))
    80	       While(#digitCondition, #digitBody)
    81	       If(Name("odd"),
    82	          Expr(Call(Attribute(Name("result"), "append"), Name("n"))),
    83	          .Stmts)
    84	
    85	  rule #uniqueDigitsBody
    86	    => Assign(Name("result"), ListExpr(.Exprs))
    87	       Assign(Name("n"), Int(1))
    88	       Assign(Name("odd"), Bool(true))
    89	       Assign(Name("y"), Int(0))
    90	       For(Name("n"), Name("x"), #outerBody)
    91	       Expr(Call(Attribute(Name("result"), "sort"), .Exprs))
    92	       Return(Name("result"))
    93	endmodule
    94	
    95	module VERIFICATION
    96	  imports VERIFICATION-BASE
    97	
    98	  // The fixed #loopStep rule binds the yielded Val directly.  Under isInt(V),
    99	  // projectIntTotal(V) is definitionally the identical Int value.  This
   100	  // normalization exposes that sort to symbolic execution, then preserves the
   101	  // fixed binding, body, loop continuation, and arbitrary trailing context.
   102	  rule <k>
   103	         #iterYield(V:Val, REST:Iterable)
   104	         ~> #loopStep(Name(X:String), B:Stmts)
   105	       =>
   106	         #bindTgt(Name(X), projectIntTotal(V))
   107	         ~> B
   108	         ~> #loopLbl(#loop(REST, Name(X), B))
   109	       ...
   110	       </k>
   111	    requires isInt(V)
   112	    [priority(40)]
   113	endmodule

