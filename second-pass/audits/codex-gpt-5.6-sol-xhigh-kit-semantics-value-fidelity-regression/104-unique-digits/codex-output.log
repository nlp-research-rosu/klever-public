+  status=1
+fi
+
+printf '%s\n' 'SHA256'
+sha256sum \
+  "$reference/prompt.py" \
+  "$candidate/prompt.py" \
+  "$reference/py2mpy.py" \
+  "$candidate/py2mpy.py" \
+  "$reference/canonical.py" \
+  "$candidate/solution.py" \
+  "$candidate/solution.mpy"
+
+rm -f "$candidate_manifest" "$reference_manifest"
+exit "$status"
