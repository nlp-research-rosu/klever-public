/bin/bash -lc 'chmod +x /audit-output/evidence/stage4_translate_concrete.sh /audit-output/evidence/stage4_ground_checks.py && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage4-translate-concrete.log /audit-output/evidence/stage4_translate_concrete.sh && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage4-ground-python.log /audit-output/evidence/stage4_ground_checks.py && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage4-ground-krun.log krun /audit-output/evidence/stage4_concrete.mpy --definition runtime-fresh-kompiled' in /tmp/audit-work/scratch
