+echo "translator_exit_status=$translator_status"
+
+cmp -s /tmp/audit-work/scratch/regenerated-solution.mpy \
+       /tmp/audit-work/scratch/solution.mpy
+identity_status=$?
+echo "solution_mpy_cmp_status=$identity_status"
