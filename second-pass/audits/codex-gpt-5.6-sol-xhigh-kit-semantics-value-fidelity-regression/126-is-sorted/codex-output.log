+requires "verification.k"
+
+module AUDIT-NONVACUITY
+  imports VERIFICATION
+
+  // [0, 0] satisfies nonNegativeInts. Both the real program and the claimed
+  // intendedSorted summary return true, so demanding false is meaningful.
+  claim [pair-must-not-be-false]:
+    <k>
+      #loadAll(Module(
+        FuncDef("is_sorted", Params("lst"), isSortedFunctionBody)
+        .Stmts))
+      ~> Call(
+           Name("is_sorted"),
+           list(vCons(0, vCons(0, .ValSeq))),
+           .Exprs)
+      =>
+      false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(.Map, parent(-1))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_sorted" |-> closureVal("lst", isSortedFunctionBody, 0),
+          parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(vCons(0, vCons(0, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..1e675b93a5d8a5525eaeee03eb2b8da99967d78e
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+exec > >(tee "$log_file") 2>&1
+
+printf 'CWD: %q\n' "$PWD"
+printf 'COMMAND:'
+printf ' %q' "$@"
+printf '\n'
+printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+
+set +e
+"$@"
+command_status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$command_status"
+printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+exit "$command_status"
