#!/usr/bin/env python3
import ast
import itertools
import subprocess
import tempfile
from collections import Counter
from pathlib import Path

from solution import is_sorted


ROOT = Path(__file__).resolve().parent


def oracle(values):
    ordered = all(a <= b for a, b in zip(values, values[1:]))
    multiplicities = Counter(values)
    at_most_two = all(count <= 2 for count in multiplicities.values())
    return ordered and at_most_two


def function_ast(path):
    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    return ast.dump(tree.body[0], include_attributes=False)


def main():
    assert function_ast(ROOT / "solution.py") == function_ast(ROOT / "smoke.py")

    examples = [
        [5],
        [1, 2, 3, 4, 5],
        [1, 3, 2, 4, 5],
        [1, 2, 3, 4, 5, 6],
        [1, 2, 3, 4, 5, 6, 7],
        [1, 3, 2, 4, 5, 6, 7],
        [1, 2, 2, 3, 3, 4],
        [1, 2, 2, 2, 3, 4],
    ]
    exhaustive = [
        list(values)
        for length in range(7)
        for values in itertools.product(range(5), repeat=length)
    ]
    python_cases = examples + exhaustive
    mismatches = [
        values
        for values in python_cases
        if is_sorted(values) is not oracle(values)
    ]
    assert not mismatches, mismatches[:10]
    print(f"CPYTHON_CASES={len(python_cases)} MISMATCHES=0")

    k_cases = examples + [
        list(values)
        for length in range(4)
        for values in itertools.product(range(3), repeat=length)
    ]
    source = (ROOT / "solution.py").read_text(encoding="utf-8")
    assertions = "\n".join(
        f"assert is_sorted({values!r}) == {oracle(values)!r}"
        for values in k_cases
    )
    with tempfile.TemporaryDirectory(prefix="is-sorted-validation-") as tmp:
        tmp_path = Path(tmp)
        program_py = tmp_path / "program.py"
        program_mpy = tmp_path / "program.mpy"
        program_py.write_text(source + "\n\n" + assertions + "\n", encoding="utf-8")
        translated = subprocess.run(
            ["python3", str(ROOT / "py2mpy.py"), str(program_py)],
            check=True,
            text=True,
            capture_output=True,
        )
        program_mpy.write_text(translated.stdout, encoding="utf-8")
        executed = subprocess.run(
            [
                "krun",
                str(program_mpy),
                "--definition",
                str(ROOT / "runtime-kompiled"),
            ],
            check=True,
            text=True,
            capture_output=True,
        )
    compact = "".join(executed.stdout.split())
    assert "<exc>NoExc</exc>" in compact, executed.stdout
    assert "<exit-code>0</exit-code>" in compact, executed.stdout
    print(f"K_LLVM_CASES={len(k_cases)} ASSERTION_FAILURES=0")


if __name__ == "__main__":
    main()

