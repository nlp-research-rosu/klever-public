+           .Exprs)
+      =>
+      false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(.Map, parent(-1))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_sorted" |-> closureVal("lst", isSortedFunctionBody, 0),
+          parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
