+      ~> Call(Name("is_sorted"), list(.ValSeq), .Exprs)
+      =>
+      true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(.Map, parent(-1))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_sorted" |->
+            closureVal(
+              "lst",
+              Assign(Name("result"), Bool(false))
+              Return(Name("result"))
+              .Stmts,
+              0),
+          parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
