/bin/bash -lc 'cp /tmp/audit-work/scratch/audit-body-sensitivity.k /audit-output/evidence/audit-body-sensitivity.k && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage4-body-sensitivity-dry-run.log kprove audit-body-sensitivity.k --definition verification-fresh-kompiled --spec-module AUDIT-BODY-SENSITIVITY --dry-run' in /tmp/audit-work/scratch
diff --git a//tmp/audit-work/scratch/audit-body-sensitivity.k b//tmp/audit-work/scratch/audit-body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..e503f3755aeb74b5f342d183e9294c156f8dee8c
--- /dev/null
+++ b//tmp/audit-work/scratch/audit-body-sensitivity.k
@@ -0,0 +1,48 @@
+requires "verification.k"
+
+module AUDIT-BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // This is deliberately not isSortedFunctionBody. It returns false without
+  // sorting. If the entry proof bypassed the loaded body, this true target
+  // could incorrectly inherit the original empty-list result.
+  claim [changed-body-must-not-inherit-summary]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "is_sorted",
+          Params("lst"),
+          Assign(Name("result"), Bool(false))
+          Return(Name("result"))
+          .Stmts)
+        .Stmts))
+      ~> Call(Name("is_sorted"), list(.ValSeq), .Exprs)
+      =>
+      true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(.Map, parent(-1))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_sorted" |->
+            closureVal(
+              "lst",
+              Assign(Name("result"), Bool(false))
+              Return(Name("result"))
+              .Stmts,
+              0),
+          parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/scratch/audit-nonvacuity.k b//tmp/audit-work/scratch/audit-nonvacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..29676283b663b0cd8ca1babdb8da5d4990cd8893
--- /dev/null
+++ b//tmp/audit-work/scratch/audit-nonvacuity.k
@@ -0,0 +1,43 @@
+requires "verification.k"
+
+module AUDIT-NONVACUITY
+  imports VERIFICATION
+
+  // [0, 0] satisfies nonNegativeInts. Both the real program and the claimed
+  // intendedSorted summary return true, so demanding false is meaningful.
+  claim [pair-must-not-be-false]:
+    <k>
+      #loadAll(Module(
+        FuncDef("is_sorted", Params("lst"), isSortedFunctionBody)
+        .Stmts))
+      ~> Call(
+           Name("is_sorted"),
+           list(vCons(0, vCons(0, .ValSeq))),
+           .Exprs)
+      =>
+      false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(.Map, parent(-1))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_sorted" |-> closureVal("lst", isSortedFunctionBody, 0),
+          parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(vCons(0, vCons(0, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..1e675b93a5d8a5525eaeee03eb2b8da99967d78e
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+exec > >(tee "$log_file") 2>&1
+
+printf 'CWD: %q\n' "$PWD"
+printf 'COMMAND:'
+printf ' %q' "$@"
+printf '\n'
+printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+
+set +e
+"$@"
+command_status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$command_status"
+printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+exit "$command_status"
