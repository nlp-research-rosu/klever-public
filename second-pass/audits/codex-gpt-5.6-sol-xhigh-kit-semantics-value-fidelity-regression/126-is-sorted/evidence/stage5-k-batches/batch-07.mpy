Module(
  FuncDef("is_sorted", Params("lst"),
    Assign(
      Name("result"),
      Compare(
        Name("lst"),
        CmpOp("==", Call(Name("sorted"), Name("lst")))))
    Assign(Name("current"), Int(0))
    For(Name("current"), Name("lst"),
      If(Compare(
        Call(Attribute(Name("lst"), "count"), Name("current")),
        CmpOp(">", Int(2))),
        Assign(Name("result"), Bool(false)),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(1), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(1), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(1), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(1), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(2), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(2), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(2), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(2), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(3), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(3), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(3), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(1), Int(3), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(0), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(0), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(0), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(0), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(1), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(1), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(1), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(1), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(2), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(2), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(2), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(2), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(3), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(3), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(3), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(2), Int(3), Int(3))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(0), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(0), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(0), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(0), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(1), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(1), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(1), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(1), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(2), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(2), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(2), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(2), Int(3), Int(2), Int(3))),
      CmpOp("==", Bool(false)))))
