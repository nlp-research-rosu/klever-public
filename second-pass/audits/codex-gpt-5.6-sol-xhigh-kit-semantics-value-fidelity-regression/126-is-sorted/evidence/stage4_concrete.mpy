Module(
  FuncDef("is_sorted", Params("lst"),
    Assign(
      Name("result"),
      Compare(
        Name("lst"),
        CmpOp("==", Call(Name("sorted"), Name("lst")))))
    Assign(Name("current"), Int(0))
    For(Name("current"), Name("lst"),
      If(Compare(
        Call(Attribute(Name("lst"), "count"), Name("current")),
        CmpOp(">", Int(2))),
        Assign(Name("result"), Bool(false)),
        ))
    Return(Name("result")))
  Assign(Name("result_empty"), Call(Name("is_sorted"), ListExpr()))
  Assign(
    Name("result_two_duplicates"),
    Call(Name("is_sorted"), ListExpr(Int(0), Int(0))))
  Assign(
    Name("result_three_duplicates"),
    Call(Name("is_sorted"), ListExpr(Int(0), Int(0), Int(0))))
  Assign(
    Name("result_unsorted"),
    Call(Name("is_sorted"), ListExpr(Int(1), Int(0))))
  Assign(
    Name("result_large"),
    Call(
      Name("is_sorted"),
      ListExpr(Int(0), Int(10000000000000000000000000000000000000000)))))
