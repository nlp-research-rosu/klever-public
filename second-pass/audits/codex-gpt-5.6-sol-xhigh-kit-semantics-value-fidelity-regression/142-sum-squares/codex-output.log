     4	  imports MPY
     5	
     6	  // Formal input-domain predicate: every list element is an integer.
     7	  syntax Bool ::= allInts(ValSeq) [function, total]
     8	  rule allInts(.ValSeq) => true
     9	  rule allInts(vCons(V:Val, VS:ValSeq))
    10	    => isInt(V) andBool allInts(VS)
    11	
    12	  // The contribution selected by the source program at a given zero-based index.
    13	  syntax Int ::= contribution(Int, Int) [function, total]
    14	  rule contribution(I:Int, X:Int) => X *Int X
    15	    requires pyMod(I, 3) ==Int 0
    16	  rule contribution(I:Int, X:Int) => X *Int X *Int X
    17	    requires pyMod(I, 3) =/=Int 0 andBool pyMod(I, 4) ==Int 0
    18	  rule contribution(I:Int, X:Int) => X
    19	    requires pyMod(I, 3) =/=Int 0 andBool pyMod(I, 4) =/=Int 0
    20	
    21	  // Total value projection. The non-Int case is outside allInts and is defined
    22	  // as zero solely to keep the helper total.
    23	  syntax Int ::= intVal(Val) [function, total]
    24	  rule intVal(X:Int) => X
    25	  rule intVal(_V:Val) => 0 [owise]
    26	
    27	  // Symbolic sort recovery for Val heads constrained by allInts. Universal
    28	  // typed connection claims against unextended MPY are in
    29	  // bridge-connection-spec.k.
    30	  rule applyBin("+", A:Val, B:Val)
    31	    => intVal(A) +Int intVal(B)
    32	    requires isInt(A) andBool isInt(B)
    33	  rule applyBin("*", A:Val, B:Val)
    34	    => intVal(A) *Int intVal(B)
    35	    requires isInt(A) andBool isInt(B)
    36	
    37	  // Accumulator-form mathematical result for a suffix beginning at index I.
    38	  syntax Int ::= sumSquares(ValSeq, Int, Int) [function, total]
    39	  rule sumSquares(.ValSeq, _I:Int, ACC:Int) => ACC
    40	  rule sumSquares(vCons(V:Val, XS:ValSeq), I:Int, ACC:Int)
    41	    => sumSquares(
    42	         XS,
    43	         I +Int 1,
    44	         ACC +Int contribution(I, intVal(V)))
    45	    requires isInt(V)
    46	  rule sumSquares(vCons(V:Val, XS:ValSeq), I:Int, ACC:Int)
    47	    => sumSquares(XS, I +Int 1, ACC)
    48	    requires notBool isInt(V)
    49	
    50	  // Final index after consuming a suffix; also kept in accumulator form.
    51	  syntax Int ::= advanceIndex(ValSeq, Int) [function, total]
    52	  rule advanceIndex(.ValSeq, I:Int) => I
    53	  rule advanceIndex(vCons(_V:Val, XS:ValSeq), I:Int)
    54	    => advanceIndex(XS, I +Int 1)
    55	endmodule
