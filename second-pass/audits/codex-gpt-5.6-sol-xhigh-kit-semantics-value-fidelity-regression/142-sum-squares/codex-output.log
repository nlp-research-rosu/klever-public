+      sumSquares(
+        vCons(-1, vCons(-5, vCons(2, vCons(-1, vCons(-5, .ValSeq))))),
+        0,
+        0)
+      => -126
+    </k>
+
+  claim [index-12-overlap]:
+    <k>
+      sumSquares(
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
