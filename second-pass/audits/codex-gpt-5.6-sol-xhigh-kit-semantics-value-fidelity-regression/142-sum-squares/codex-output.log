+            contribution = value * value
+        elif index % 4 == 0:
+            contribution = value * value * value
+        else:
+            contribution = value
+        accumulator += contribution
+    return accumulator
+
+
+curated: list[tuple[str, list[int]]] = [
+    ("prompt-example-1", [1, 2, 3]),
+    ("prompt-example-empty", []),
+    ("prompt-example-negative", [-1, -5, 2, -1, -5]),
+    ("index-0-square", [-3]),
