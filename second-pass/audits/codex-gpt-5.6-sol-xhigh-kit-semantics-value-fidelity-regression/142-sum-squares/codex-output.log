+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(1,
+        vCons(-3, .ValSeq))))))))))))),
+        0,
+        0)
+      => 21
