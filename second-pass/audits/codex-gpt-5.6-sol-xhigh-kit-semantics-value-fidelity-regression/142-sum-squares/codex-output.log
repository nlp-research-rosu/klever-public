+assert sum_squares([-3]) == 9
+assert sum_squares([2, -2, 3, -4]) == 21
+assert sum_squares([2, -2, 3, -4, -5]) == -104
+assert sum_squares([1, 1, 1, 1, 1, 1, 1, 1, -2]) == 0
+assert sum_squares([1] * 12 + [-3]) == 21
