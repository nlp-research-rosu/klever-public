+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Formal input-domain predicate: every list element is an integer.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, VS:ValSeq))
+    => isInt(V) andBool allInts(VS)
+
+  // The contribution selected by the source program at a given zero-based index.
+  syntax Int ::= contribution(Int, Int) [function, total]
+  rule contribution(I:Int, X:Int) => X *Int X
+    requires pyMod(I, 3) ==Int 0
+  rule contribution(I:Int, X:Int) => X *Int X *Int X
+    requires pyMod(I, 3) =/=Int 0 andBool pyMod(I, 4) ==Int 0
+  rule contribution(I:Int, X:Int) => X
+    requires pyMod(I, 3) =/=Int 0 andBool pyMod(I, 4) =/=Int 0
+
+  // Total value projection. The non-Int case is outside allInts and is defined
+  // as zero solely to keep the helper total.
+  syntax Int ::= intVal(Val) [function, total]
+  rule intVal(X:Int) => X
+  rule intVal(_V:Val) => 0 [owise]
+
+  // Symbolic sort recovery for Val heads constrained by allInts. Universal
+  // typed connection claims against unextended MPY are in
+  // bridge-connection-spec.k.
+  rule applyBin("+", A:Val, B:Val)
+    => intVal(A) +Int intVal(B)
+    requires isInt(A) andBool isInt(B)
+  rule applyBin("*", A:Val, B:Val)
+    => intVal(A) *Int intVal(B)
+    requires isInt(A) andBool isInt(B)
+
+  // Accumulator-form mathematical result for a suffix beginning at index I.
+  syntax Int ::= sumSquares(ValSeq, Int, Int) [function, total]
+  rule sumSquares(.ValSeq, _I:Int, ACC:Int) => ACC
+  rule sumSquares(vCons(V:Val, XS:ValSeq), I:Int, ACC:Int)
+    => sumSquares(
+         XS,
+         I +Int 1,
+         ACC +Int contribution(I, intVal(V)))
+    requires isInt(V)
+  rule sumSquares(vCons(V:Val, XS:ValSeq), I:Int, ACC:Int)
+    => sumSquares(XS, I +Int 1, ACC)
+    requires notBool isInt(V)
+
+  // Final index after consuming a suffix; also kept in accumulator form.
+  syntax Int ::= advanceIndex(ValSeq, Int) [function, total]
+  rule advanceIndex(.ValSeq, I:Int) => I
+  rule advanceIndex(vCons(_V:Val, XS:ValSeq), I:Int)
+    => advanceIndex(XS, I +Int 1)
+endmodule

