    if isinstance(node, ast.Break):
        return "Break"
    if isinstance(node, ast.Continue):
        return "Continue"
    if isinstance(node, ast.Pass):
        return "Pass"

    if isinstance(node, ast.Assert):
        if node.msg is not None:
            return Ctor("Assert", emit_expr(node.test), emit_expr(node.msg))
        return Ctor("Assert", emit_expr(node.test))

    if isinstance(node, ast.Expr):
        return Ctor("Expr", emit_expr(node.value))

    if isinstance(node, ast.Import):
        return Ctor("Import", *(q(n.name) for n in node.names))
    if isinstance(node, ast.ImportFrom):
        mod = node.module if node.module is not None else ""
        return Ctor("ImportFrom", q(mod), *(q(n.name) for n in node.names))

    raise Unsupported(f"Stmt {type(node).__name__}")


def emit_stmts(stmts) -> Seq:
    return Seq([emit_stmt(s) for s in stmts])


def emit_module(tree: ast.Module) -> Ctor:
    return Ctor("Module", emit_stmts(tree.body))


# ---------------------------------------------------------------------------
# Lisp-style pretty printer
# ---------------------------------------------------------------------------
WIDTH = 72  # an expression constructor wider than this breaks onto its own lines


def render(node, ind: int = 0) -> str:
    if isinstance(node, str):
        return node

    if isinstance(node, Seq):
        if not node.items:
            return ""
        pad = "  " * ind
        return ("\n" + pad).join(render(it, ind) for it in node.items)

    # Ctor
    cind = ind + 1
    cpad = "  " * cind
    has_block = any(isinstance(a, Seq) for a in node.args)

    if not has_block:
        inline = node.name + "(" + ", ".join(render(a, ind) for a in node.args) + ")"
        if "\n" not in inline and len("  " * ind) + len(inline) <= WIDTH:
            return inline
        parts = [render(a, cind) for a in node.args]
        return node.name + "(\n" + cpad + (",\n" + cpad).join(parts) + ")"

    # Has a statement block: inline the args before the first block, then put
    # each remaining arg (blocks included) on its own indented line.
    first = next(i for i, a in enumerate(node.args) if isinstance(a, Seq))
    head = node.args[:first]
    rest = node.args[first:]
    open_line = node.name + "(" + ", ".join(render(a, ind) for a in head) + ("," if head else "")
    lines = []
    for k, a in enumerate(rest):
        comma = "," if k < len(rest) - 1 else ""
        lines.append(cpad + render(a, cind) + comma)
    return open_line + "\n" + "\n".join(lines) + ")"


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="py2mpy",
        description="Pure CPython-AST -> K-constructor transliterator.",
    )
    ap.add_argument("file", help="Python source file")
    ap.add_argument("--ast", action="store_true",
                    help="print the Python AST (ast.dump) instead of the .mpy term")
    args = ap.parse_args(argv)

    with open(args.file, "r", encoding="utf-8") as fh:
        src = fh.read()
    tree = ast.parse(src, filename=args.file)
    _walk_symtable(symtable.symtable(src, args.file, "exec"))

    if args.ast:
        print(ast.dump(tree, indent=2))
    else:
        print(render(emit_module(tree)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Differential evidence for solution.py against CPython and LLVM K execution."""

from __future__ import annotations

import itertools
import subprocess
import sys
from pathlib import Path

from solution import sort_numbers


ROOT = Path(__file__).resolve().parent
WORDS = (
    "zero",
    "one",
    "two",
    "three",
    "four",
    "five",
    "six",
    "seven",
    "eight",
    "nine",
)


def oracle(source: str) -> str:
    """Independent counting oracle, not a keyed-sort implementation."""
    tokens = source.split()
    ordered = []
    for word in WORDS:
        ordered.extend([word] * tokens.count(word))
    return " ".join(ordered)


def cases() -> list[str]:
    result = []
    for length in range(4):
        result.extend(
            " ".join(items)
            for items in itertools.product(WORDS, repeat=length)
        )
    result.extend(
        [
            " ".join(WORDS),
            " ".join(reversed(WORDS)),
            "nine nine zero zero five five one",
            "three\tone\nfive",
            "  eight   two zero  ",
        ]
    )
    return result


def k_cases() -> list[str]:
    result = []
    for length in range(3):
        result.extend(
            " ".join(items)
            for items in itertools.product(WORDS, repeat=length)
        )
    result.extend(cases()[-5:])
    return result


def main() -> int:
    test_cases = cases()
    mismatches = [
        (source, sort_numbers(source), oracle(source))
        for source in test_cases
        if sort_numbers(source) != oracle(source)
    ]
    print(f"CPYTHON_CASES={len(test_cases)} MISMATCHES={len(mismatches)}")
    if mismatches:
        print(mismatches[0])
        return 1

    translated = subprocess.run(
        [sys.executable, "py2mpy.py", "solution.py"],
        cwd=ROOT,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    ).stdout
    checked_in = (ROOT / "solution.mpy").read_text(encoding="utf-8")
    translation_match = translated == checked_in
    print(f"TRANSLATION_MATCH={str(translation_match).lower()}")
    if not translation_match:
        return 1

    llvm_cases = k_cases()
    assertions = "".join(
        f"\nassert sort_numbers({source!r}) == {oracle(source)!r}\n"
        for source in llvm_cases
    )
    smoke_python = ROOT / "_differential-smoke.py"
    smoke_mpy = ROOT / "_differential-smoke.mpy"
    smoke_python.write_text(
        (ROOT / "solution.py").read_text(encoding="utf-8") + assertions,
        encoding="utf-8",
    )
    with smoke_mpy.open("w", encoding="utf-8") as output:
        subprocess.run(
            [sys.executable, "py2mpy.py", smoke_python.name],
            cwd=ROOT,
            check=True,
            text=True,
            stdout=output,
        )

    completed = subprocess.run(
        [
            "krun",
            smoke_mpy.name,
            "--definition",
            "runtime-kompiled",
            "--output",
            "none",
        ],
        cwd=ROOT,
        check=False,
    )
    print(f"K_LLVM_CASES={len(llvm_cases)} EXIT={completed.returncode}")
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
#!/usr/bin/env bash
set -eu

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun smoke.mpy \
  --definition runtime-kompiled \
  --output none

python3 differential_test.py

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.number-rank-connection

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.sort-numbers

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY; then
  echo "ERROR: false-postcondition mutation unexpectedly proved"
  exit 1
else
  echo "EXPECTED_FAILURE: false-postcondition mutation was rejected"
fi

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION; then
  echo "ERROR: helper-body mutation unexpectedly proved"
  exit 1
else
  echo "EXPECTED_FAILURE: helper-body mutation was rejected"
fi
VALIDATED

## What is proven

This is a machine-checked partial-correctness proof for the exact constructor
program represented by `solutionProgram` in `verification.k`, which is the
`py2mpy.py` translation of `solution.py`.

For every `CS:IntSeq` satisfying `validNumberInput(CS)`, executing module load
and then `sort_numbers(str(CS))` under the supplied `MPY` semantics reaches

```k
str(sortNumbersResult(CS))
```

with the exact final scopes, heap allocations, heap counter, empty call stack,
`noRet`, `NoExc`, and exit code 0 stated by `SPEC.sort-numbers`.

The result summary expands definitionally to:

```k
joinCodes(
  iCons(32, .IntSeq),
  sortKeyVS(
    splitWS(CS, .IntSeq, .ValSeq),
    numberRankClosure))
```

The separate universal claim `SPEC.number-rank-connection` executes the exact
program-defined helper through lookup, argument binding, its body, return, and
frame cleanup, and proves that it returns `numberRank(CS)` for every string
`CS`. Thus `_number_rank` is not an oracle or an assumed program summary.

Under the supplied semantics' named contract that `sortKeyVS(VS, KV)` is the
stable ascending sort of `VS` by real calls to `KV`, the formal result is the
input numeral tokens sorted in numeric order. That primitive contract is an
explicit trust boundary; its sorting correctness is not proved in K here.

The K claims establish partial correctness, not termination as a separate
liveness theorem.

## Formal claims

`SPEC.number-rank-connection`:

- Program boundary: `Call(Name("_number_rank"), (str(CS), .Exprs))` in a module
  environment whose binding is the exact `numberRankClosure`.
- Domain: all `IntSeq` strings.
- Result: `numberRank(CS)`.
- Observable state: result plus unchanged environment, scopes, heap, allocation
  counters, stack, return state, exception state, and exit code.

`SPEC.sort-numbers`:

- Program boundary: `#loadAll(solutionProgram)` followed by the exact
  `sort_numbers` call.
- Domain: `validNumberInput(CS)`, meaning that whitespace splitting produces
  only `zero` through `nine`; empty input is valid vacuously.
- Result: `str(sortNumbersResult(CS))`.
- Observable state: result, both function bindings, the two list allocations,
  counters, empty stack, return state, exception state, and exit code.

## Rebuilt proof-extension inventory

There are no proof-local operational bridges, priority rules, simplification
rules, or result-bearing fresh symbols. Every program-defined body executes
under the fixed semantics. The imported `sortKeyVS` primitive is listed
separately in the trust ledger.

### `numberRankBody` and `sortNumbersBody`

- Extension/class: two definitional summaries.
- Semantic role: nullary constructor abbreviations for the exact translated
  `Stmts`; they construct syntax and do not replace program execution.
- Domain: their only, unguarded equation; `[total]` is exhaustive.
- Matched context: any occurrence of the nullary abbreviation; no continuation,
  control stack, binding, or state cell is matched.
- Justification scope/context containment: the right sides were audited against
  `solution.mpy`; every occurrence expands to that exact constructor body.
- State footprint: none. The resulting syntax later executes using `MPY`.
- Value influence: the helper body determines sort keys; the entry body
  determines the returned string.
- Value justification: `SPEC.number-rank-connection` for the helper and
  `SPEC.sort-numbers` for the entry body.
- Dependents: the closure abbreviations, `solutionProgram`, and both claims.
- Control/value validation: the LLVM executions and the rejected helper-body
  mutation in `spec-body-mutation.k`.

### `numberRankClosure`, `sortNumbersClosure`, and `solutionProgram`

- Extension/class: definitional summaries.
- Semantic role: exact closure and module constructors; no invocation is
  skipped.
- Domain: one unguarded equation per nullary function, with exhaustive
  `[total]`.
- Matched context: only the exact abbreviation term; no cells or continuation
  are framed.
- Justification scope/context containment: each expands to the exact parameters,
  body, defining environment 0, names, and module order used by the claims.
- State footprint: none while expanding. Module load and calls subsequently
  update the cells through fixed semantics.
- Value influence: fixes lookup bindings and the callable passed to
  `sortKeyVS`.
- Value justification: the claims execute the expanded constructors.
- Dependents: both claims and `sortNumbersResult`.
- Validation: `solution.mpy` regeneration matched byte-for-byte, all concrete
  executions passed, and the mutation probe showed body sensitivity.

### `numberRank`

- Extension/class: definitional summary.
- Semantic role: mathematical name for the helper's returned integer; it never
  rewrites or replaces a program call.
- Domain: every `IntSeq`. Nine distinct guarded cases cover `zero` through
  `eight`; the `[owise]` case covers `nine` and every other string.
- Matched context: only `numberRank(CS)`; no configuration cells.
- Justification scope/context containment: the universal connection claim has
  the same complete `IntSeq` domain.
- State footprint: none.
- Value influence: states the callable's sort key and supports the
  human-facing numeric-order interpretation.
- Value justification: `SPEC.number-rank-connection` printed `#Top`.
- Dependents: validation of the callable contract used by
  `SPEC.sort-numbers`.
- Control/value validation: the connection claim fixes every return value and
  all observable cells. Changing the final helper return from 9 to 8 produced
  a stuck state containing `8` against expected `9`.

The nine guarded equations are pairwise disjoint because their ground code
sequences are distinct. The `[owise]` guard is disjoint from all nine.

### `validNumberWord`, `validNumberWords`, and `validNumberInput`

- Extension/class: definitional predicates.
- Semantic role: state the source contract's input domain; they do not replace
  execution.
- Domain: every `IntSeq`/`ValSeq`. `validNumberWords` has an empty case, a
  recursive string-head case, and an `[owise]` non-string-head case.
- Matched context: only predicate terms; no configuration cells.
- Justification scope/context containment: `validNumberInput` uses the supplied
  `splitWS` definition, exactly as the program's no-argument `split()` does.
- State footprint/value influence: no state; the predicates restrict the main
  claim but do not determine its result.
- Value justification: exhaustive literal membership and structurally
  decreasing recursion.
- Dependents: `SPEC.sort-numbers`.
- Validation: the prompt witness and all concrete differential inputs satisfy
  the intended token condition.

The cases are exhaustive, pairwise consistent, and recursive descent removes
one `ValSeq` constructor.

### `sortNumbersResult`

- Extension/class: definitional summary.
- Semantic role: names the final expression produced by fixed execution; it
  does not rewrite a program term or bypass lookup, calls, allocation, or
  return control.
- Domain: every `IntSeq`, covered by one unguarded `[total]` equation.
- Matched context: only `sortNumbersResult(CS)`; no continuation or state cells.
- Justification scope/context containment: `SPEC.sort-numbers` starts from the
  complete module-load/call configuration and establishes exactly this result
  and every relevant final cell.
- State footprint: none in the equation. The claim separately states both heap
  allocations and preserves/updates every operational cell.
- Value influence: it is the entire returned string.
- Value justification: fixed execution for split and join, the exact helper
  closure, the universal helper connection theorem, and the conditional
  `sortKeyVS` contract.
- Dependents: `SPEC.sort-numbers`.
- Validation: positive proof, false-postcondition rejection, CPython
  differential testing, and concrete LLVM execution.

### `SPEC.number-rank-connection`

- Extension/class: derived auxiliary reachability claim.
- Semantic role: connects a program-derived, result-bearing callable to its
  exact value without serving as an operational rewrite in `verification.k`.
- Domain: all `CS:IntSeq`.
- Matched context: exact call, module binding, builtins parent, empty heap and
  stack, counters, return/exception/exit cells, and no framed continuation.
- Justification scope/context containment: the claim's complete invocation
  configuration is exactly the scope in which its result is used to justify the
  key callable. It does not justify a broader control context.
- State footprint: reads the module and builtins scopes; creates and removes
  one call frame; preserves heap, counters, exception, and exit state.
- Value influence: fixes every helper return value used as a sort key.
- Value justification: symbolic execution of the exact body.
- Dependents: the conditional numeric-order interpretation of
  `SPEC.sort-numbers`.
