+  "$reference/canonical.py" \
+  "$reference/prompt.py" \
+  "$reference/py2mpy.py" \
+  "$candidate/prompt.py" \
+  "$candidate/py2mpy.py" \
+  "$candidate/solution.py" \
+  "$candidate/solution.mpy" \
