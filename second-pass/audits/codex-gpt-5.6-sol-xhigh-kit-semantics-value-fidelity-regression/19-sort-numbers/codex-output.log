+    <heap>
+      .Map
+      => 0 |-> list(
+                  splitWS(
+                    strToCodes("three one five"),
+                    .IntSeq,
+                    .ValSeq))
+         1 |-> list(
+                  sortKeyVS(
+                    splitWS(
+                      strToCodes("three one five"),
