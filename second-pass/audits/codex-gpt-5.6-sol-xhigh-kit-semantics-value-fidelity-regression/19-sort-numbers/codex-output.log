+#!/usr/bin/env ruby
+require "digest"
+require "json"
+
+abort("usage: #{$PROGRAM_NAME} TRACE.jsonl") unless ARGV.length == 1
+
+top_counts = Hash.new(0)
+payload_counts = Hash.new(0)
+response_counts = Hash.new(0)
+assistant_messages = []
+keyword_hits = []
+keywords = /#Top|WarnStuckClaimState|EXPECTED_FAILURE|kprove|sortKeyVS|oracle|mutation/i
+
+File.foreach(ARGV[0]).with_index(1) do |line, line_number|
+  record = JSON.parse(line)
+  top_counts[record["type"] || "NONE"] += 1
+  payload = record["payload"]
+  payload_counts[payload["type"] || "NONE"] += 1 if payload.is_a?(Hash)
+
+  if record["type"] == "response_item" && payload.is_a?(Hash)
+    response_counts[payload["type"] || "NONE"] += 1
+    if payload["type"] == "message" && payload["role"] == "assistant"
+      text = Array(payload["content"]).filter_map { |item| item["text"] }.join("\n")
+      assistant_messages << [
+        line_number,
+        text.bytesize,
+        Digest::SHA256.hexdigest(text),
+        text.gsub(/\s+/, " ")[0, 300]
+      ]
+    end
+  end
+
+  if (match = keywords.match(line))
+    left = [match.begin(0) - 100, 0].max
+    keyword_hits << [
+      line_number,
+      match[0],
+      line[left, 400].gsub(/\s+/, " ")
+    ]
+  end
+end
+
+puts "TOP_LEVEL_TYPES"
+top_counts.sort.each { |name, count| puts "#{name}=#{count}" }
+puts "PAYLOAD_TYPES"
+payload_counts.sort.each { |name, count| puts "#{name}=#{count}" }
+puts "RESPONSE_ITEM_TYPES"
+response_counts.sort.each { |name, count| puts "#{name}=#{count}" }
+puts "ASSISTANT_MESSAGES line bytes sha256 preview"
+assistant_messages.each { |row| puts row.join("\t") }
+puts "KEYWORD_HITS first_80 line keyword context"
+keyword_hits.first(80).each { |row| puts row.join("\t") }
+puts "KEYWORD_HIT_COUNT=#{keyword_hits.length}"

