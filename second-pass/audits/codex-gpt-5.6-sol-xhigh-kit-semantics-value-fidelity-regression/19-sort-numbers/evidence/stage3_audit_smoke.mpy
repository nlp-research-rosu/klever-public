Module(
  FuncDef("_number_rank", Params("number"),
    If(Compare(Name("number"), CmpOp("==", Str("zero"))),
      Return(Int(0)),
      )
    If(Compare(Name("number"), CmpOp("==", Str("one"))),
      Return(Int(1)),
      )
    If(Compare(Name("number"), CmpOp("==", Str("two"))),
      Return(Int(2)),
      )
    If(Compare(Name("number"), CmpOp("==", Str("three"))),
      Return(Int(3)),
      )
    If(Compare(Name("number"), CmpOp("==", Str("four"))),
      Return(Int(4)),
      )
    If(Compare(Name("number"), CmpOp("==", Str("five"))),
      Return(Int(5)),
      )
    If(Compare(Name("number"), CmpOp("==", Str("six"))),
      Return(Int(6)),
      )
    If(Compare(Name("number"), CmpOp("==", Str("seven"))),
      Return(Int(7)),
      )
    If(Compare(Name("number"), CmpOp("==", Str("eight"))),
      Return(Int(8)),
      )
    Return(Int(9)))
  FuncDef("sort_numbers", Params("numbers"),
    Return(
      Call(
        Attribute(Str(" "), "join"),
        Call(
          Name("sorted"),
          Call(Attribute(Name("numbers"), "split"), ),
          KwArg("key", Name("_number_rank"))))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("three one five")),
      CmpOp("==", Str("one three five"))))
  Assert(
    Compare(Call(Name("sort_numbers"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("   ")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("zero")),
      CmpOp("==", Str("zero"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("nine")),
      CmpOp("==", Str("nine"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("nine zero eight one")),
      CmpOp("==", Str("zero one eight nine"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("nine nine zero zero five")),
      CmpOp("==", Str("zero zero five nine nine"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("  eight   two zero  ")),
      CmpOp("==", Str("zero two eight"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("three\tone\nfive")),
      CmpOp("==", Str("one three five")))))
