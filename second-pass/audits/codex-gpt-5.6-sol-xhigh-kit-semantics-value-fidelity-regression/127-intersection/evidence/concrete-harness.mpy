Module(
  FuncDef("intersection", Params("interval1", "interval2"),
    Assign(Name("start"), Subscript(Name("interval1"), Int(0)))
    If(Compare(
      Subscript(Name("interval2"), Int(0)),
      CmpOp(">", Name("start"))),
      Assign(Name("start"), Subscript(Name("interval2"), Int(0))),
      )
    Assign(Name("end"), Subscript(Name("interval1"), Int(1)))
    If(Compare(
      Subscript(Name("interval2"), Int(1)),
      CmpOp("<", Name("end"))),
      Assign(Name("end"), Subscript(Name("interval2"), Int(1))),
      )
    Assign(Name("length"), BinOp("-", Name("end"), Name("start")))
    If(Compare(Name("length"), CmpOp("<", Int(2))),
      Return(Str("NO")),
      )
    Assign(Name("factorial"), Int(1))
    Assign(Name("i"), Int(1))
    While(Compare(Name("i"), CmpOp("<", Name("length"))),
      Assign(
        Name("factorial"),
        BinOp("*", Name("factorial"), Name("i")))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    If(Compare(
      BinOp("%", Name("factorial"), Name("length")),
      CmpOp("==", BinOp("-", Name("length"), Int(1)))),
      Return(Str("YES")),
      )
    Return(Str("NO")))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(1), Int(2)),
        TupleExpr(Int(2), Int(3))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(UnaryOp("-", Int(1)), Int(1)),
        TupleExpr(Int(0), Int(4))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(1))),
        TupleExpr(UnaryOp("-", Int(5)), Int(5))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(1)),
        TupleExpr(Int(3), Int(4))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(2)),
        TupleExpr(Int(2), Int(5))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(4), Int(4)),
        TupleExpr(Int(4), Int(4))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(2)),
        TupleExpr(UnaryOp("-", Int(1)), Int(4))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(4)),
        TupleExpr(UnaryOp("-", Int(1)), Int(5))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(UnaryOp("-", Int(3)), Int(4)),
        TupleExpr(UnaryOp("-", Int(3)), Int(4))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(10), Int(16)),
        TupleExpr(Int(0), Int(20))),
      CmpOp("==", Str("NO")))))
