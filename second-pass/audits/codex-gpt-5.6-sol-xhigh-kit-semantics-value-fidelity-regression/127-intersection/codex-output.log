@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Starting at the loop head with factorial = (i-1)!, the fixed MPY while
+  // execution finishes at i = length with factorial = (length-1)!.
+  claim [factorial-loop]:
+    <k>
+      #while(Compare(Name("i"), CmpOp("<", Name("length"))),
+             Assign(Name("factorial"),
+                    BinOp("*", Name("factorial"), Name("i")))
+             Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ("interval1" |-> IV1:Val)
+        ("interval2" |-> IV2:Val)
+        ("start" |-> START:Int)
+        ("end" |-> END:Int)
+        ("length" |-> N:Int)
+        ("factorial" |-> (F:Int => fact(N -Int 1)))
+        ("i" |-> (I:Int => N)),
+        P:Parent)
+    </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EC:Int </exit-code>
+    requires 1 <=Int I
+     andBool I <=Int N
+     andBool F ==Int fact(I -Int 1)
+
+  // Whole-function partial correctness for every pair of well-formed integer
+  // intervals.  The exact closure body is selected by ordinary MPY lookup.
+  claim [intersection]:
+    <k>
+      Call(Name("intersection"),
+           TupleExpr(Int(A:Int), Int(B:Int)),
+           TupleExpr(Int(C:Int), Int(D:Int)))
+      => intersectionResult(overlapLength(A, B, C, D))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("intersection" |-> intersectionClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A <=Int B
+     andBool C <=Int D
+endmodule
