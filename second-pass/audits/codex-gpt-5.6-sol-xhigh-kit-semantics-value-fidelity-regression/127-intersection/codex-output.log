+                category = "opaque-symbol-declaration"
+            elif "function" in attrs:
+                category = "function-declaration"
+            else:
+                category = "syntax-declaration"
+        else:
+            category = kind
+        counts[f"kind:{kind}"] += 1
+        counts[f"category:{category}"] += 1
