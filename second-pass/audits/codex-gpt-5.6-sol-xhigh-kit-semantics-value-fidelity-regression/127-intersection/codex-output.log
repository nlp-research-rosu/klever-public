+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: these intervals only touch, so the program returns
+  // "NO".  A proof of "YES" would expose a vacuous or unconstrained result.
+  claim [false-result]:
+    <k>
+      Call(Name("intersection"),
+           TupleExpr(Int(1), Int(2)),
+           TupleExpr(Int(2), Int(3)))
+      => str(iCons(89, iCons(69, iCons(83, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("intersection" |-> intersectionClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
