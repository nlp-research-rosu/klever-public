+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A total mathematical factorial.  Only the positive branch is used by the
+  // loop invariant; the non-positive branch makes the symbol total on Int.
+  syntax Int ::= fact(Int) [function, total]
+  rule fact(N:Int) => 1
+    requires N <=Int 0
+  rule fact(N:Int) => N *Int fact(N -Int 1)
+    requires N >Int 0
+
+  // Exact piecewise summaries of the two endpoint selections in solution.py.
+  syntax Int ::= overlapStart(Int, Int) [function, total]
+  rule overlapStart(A:Int, C:Int) => C
+    requires C >Int A
+  rule overlapStart(A:Int, C:Int) => A
+    requires C <=Int A
+
+  syntax Int ::= overlapEnd(Int, Int) [function, total]
+  rule overlapEnd(B:Int, D:Int) => D
+    requires D <Int B
+  rule overlapEnd(B:Int, D:Int) => B
+    requires D >=Int B
+
+  syntax Int ::= overlapLength(Int, Int, Int, Int) [function, total]
+  rule overlapLength(A:Int, B:Int, C:Int, D:Int)
+    => overlapEnd(B, D) -Int overlapStart(A, C)
+
+  // The observable result, expressed using Wilson's criterion.
+  syntax Val ::= intersectionResult(Int) [function, total]
+  rule intersectionResult(N:Int)
+    => str(iCons(89, iCons(69, iCons(83, .IntSeq))))
+    requires N >=Int 2
+     andBool pyMod(fact(N -Int 1), N) ==Int N -Int 1
+  rule intersectionResult(N:Int)
+    => str(iCons(78, iCons(79, .IntSeq)))
+    requires N <Int 2
+  rule intersectionResult(N:Int)
+    => str(iCons(78, iCons(79, .IntSeq)))
+    requires N >=Int 2
+     andBool notBool (pyMod(fact(N -Int 1), N) ==Int N -Int 1)
+
+  // Exact closure installed by the FuncDef in solution.mpy.  This is only an
+  // AST abbreviation: calls still use MPY's lookup, argument, frame, body,
+  // return, and frame-pop rules.
+  syntax Val ::= "intersectionClosure" [function, total]
+  rule intersectionClosure
+    => closureVal(
+         ("interval1", "interval2"),
+         Assign(Name("start"), Subscript(Name("interval1"), Int(0)))
+         If(Compare(Subscript(Name("interval2"), Int(0)),
+                    CmpOp(">", Name("start"))),
+            Assign(Name("start"), Subscript(Name("interval2"), Int(0))),
+            .Stmts)
+         Assign(Name("end"), Subscript(Name("interval1"), Int(1)))
+         If(Compare(Subscript(Name("interval2"), Int(1)),
+                    CmpOp("<", Name("end"))),
+            Assign(Name("end"), Subscript(Name("interval2"), Int(1))),
+            .Stmts)
+         Assign(Name("length"), BinOp("-", Name("end"), Name("start")))
+         If(Compare(Name("length"), CmpOp("<", Int(2))),
+            Return(Str("NO")),
+            .Stmts)
+         Assign(Name("factorial"), Int(1))
+         Assign(Name("i"), Int(1))
+         While(Compare(Name("i"), CmpOp("<", Name("length"))),
+               Assign(Name("factorial"),
+                      BinOp("*", Name("factorial"), Name("i")))
+               Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+         If(Compare(BinOp("%", Name("factorial"), Name("length")),
+                    CmpOp("==", BinOp("-", Name("length"), Int(1)))),
+            Return(Str("YES")),
+            .Stmts)
+         Return(Str("NO")),
+         0)
+endmodule

