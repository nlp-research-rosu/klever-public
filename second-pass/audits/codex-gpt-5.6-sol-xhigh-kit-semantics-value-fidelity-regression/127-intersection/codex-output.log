+print(f"candidate semantics entries: {len(candidate_manifest)}")
+print(f"trusted semantics entries: {len(trusted_manifest)}")
+for rel in all_names:
+    c = candidate_manifest.get(rel)
+    r = trusted_manifest.get(rel)
