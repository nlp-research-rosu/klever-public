Module(
  ImportFrom("typing", "List")
  FuncDef("has_close_elements", Params("numbers", "threshold"),
    Assign(Name("result"), Bool(false))
    Assign(Name("i"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("elem"), Float(0.0))
    Assign(Name("elem2"), Float(0.0))
    For(Name("elem"), Name("numbers"),
      Assign(Name("j"), Int(0))
      For(Name("elem2"), Name("numbers"),
        If(Compare(Name("i"), CmpOp("!=", Name("j"))),
          If(Compare(
            Call(Name("abs"), BinOp("-", Name("elem"), Name("elem2"))),
            CmpOp("<", Name("threshold"))),
            Assign(Name("result"), Bool(true)),
            ),
          )
        Assign(Name("j"), BinOp("+", Name("j"), Int(1)))
        Assign(Name("elem2"), Float(0.0)))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
      Assign(Name("j"), Int(0))
      Assign(Name("elem"), Float(0.0)))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(1.0), Float(2.0), Float(3.0)),
        Float(0.5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(
          Float(1.0),
          Float(2.8),
          Float(3.0),
          Float(4.0),
          Float(5.0),
          Float(2.0)),
        Float(0.3)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("has_close_elements"), ListExpr(), Float(0.5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("has_close_elements"), ListExpr(Float(4.0)), Float(1.0)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(0.0), Float(1.0)),
        Float(1.0)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(0.0), Float(1.0)),
        Float(1.1)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(2.0), Float(2.0)),
        Float(0.0)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(2.0), Float(2.0)),
        Float(0.0001)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(0.0), Float(0.1), Float(100.0), Float(200.0)),
        Float(0.2)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(0.0), Float(0.0)),
        UnaryOp("-", Float(1.0))),
      CmpOp("==", Bool(false)))))
