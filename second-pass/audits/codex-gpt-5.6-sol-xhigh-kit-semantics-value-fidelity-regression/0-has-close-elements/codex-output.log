    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
--- verification.k ---
requires "reference-semantics/semantics.k"

module VERIFICATION-SYNTAX
  imports MPY

  // Proof-side structural encoding of exactly the finite Float lists.
  syntax FloatSeq ::= ".FloatSeq"
                    | fCons(Float, FloatSeq)
  syntax ValSeq ::= floatVals(FloatSeq)

  syntax Int ::= floatLen(FloatSeq) [function, total]
  syntax Bool ::= innerAcc(
                    Bool, Float, Int, Int, FloatSeq, Float
                  ) [function, total]
                | outerAcc(
                    Bool, Int, FloatSeq, FloatSeq, Float
                  ) [function, total]
endmodule

module VERIFICATION-BASE
  imports VERIFICATION-SYNTAX

  rule floatVals(.FloatSeq) => .ValSeq
  rule floatVals(fCons(F:Float, FS:FloatSeq))
    => vCons(F, floatVals(FS))

  rule (.ValSeq ==K floatVals(FS:FloatSeq))
    => (FS ==K .FloatSeq)
    [simplification]
  rule (floatVals(FS:FloatSeq) ==K .ValSeq)
    => (FS ==K .FloatSeq)
    [simplification]
  rule (floatVals(FS1:FloatSeq) ==K floatVals(FS2:FloatSeq))
    => (FS1 ==K FS2)
    [simplification]

  rule floatLen(FS:FloatSeq) => 0
    requires floatVals(FS) ==K .ValSeq
    [simplification]

  rule innerAcc(
         R:Bool, _X:Float, _I:Int, _J:Int, FS:FloatSeq, _T:Float
       )
    => R
    requires floatVals(FS) ==K .ValSeq
    [simplification]

  rule outerAcc(
         R:Bool, _I:Int, FS:FloatSeq, _ALL:FloatSeq, _T:Float
       )
    => R
    requires floatVals(FS) ==K .ValSeq
    [simplification]

  rule floatLen(.FloatSeq) => 0
  rule floatLen(fCons(_:Float, FS:FloatSeq))
    => 1 +Int floatLen(FS)

  rule innerAcc(
         R:Bool, _X:Float, _I:Int, _J:Int, .FloatSeq, _T:Float
       )
    => R

  rule innerAcc(
         R:Bool, X:Float, I:Int, J:Int,
         fCons(_Y:Float, YS:FloatSeq), T:Float
       )
    => innerAcc(R, X, I, J +Int 1, YS, T)
    requires I ==Int J

  rule innerAcc(
         R:Bool, X:Float, I:Int, J:Int,
         fCons(Y:Float, YS:FloatSeq), T:Float
       )
    => innerAcc(
         R orBool floatLt(absF(subF(X, Y)), T),
         X, I, J +Int 1, YS, T
       )
    requires I =/=Int J

  rule outerAcc(
         R:Bool, _I:Int, .FloatSeq, _ALL:FloatSeq, _T:Float
       )
    => R

  rule outerAcc(
         R:Bool, I:Int, fCons(X:Float, XS:FloatSeq),
         ALL:FloatSeq, T:Float
       )
    => outerAcc(
         innerAcc(R, X, I, 0, ALL, T),
         I +Int 1, XS, ALL, T
       )
endmodule

module VERIFICATION
  imports VERIFICATION-BASE

  // Proof-representation iterator bridges.  Their RHSs are exactly the
  // floatVals constructor equation followed by MPY-LIST's iterator rule.
  rule <k> #iterNext(list(floatVals(.FloatSeq)))
        => #iterDone ... </k>
       [priority(40)]

  rule <k> #iterNext(list(floatVals(fCons(F:Float, FS:FloatSeq))))
        => #iterYield(F, list(floatVals(FS))) ... </k>
       [priority(40)]
endmodule
--- prove.sh ---
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 differential_test.py

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

python3 py2mpy.py smoke.py > smoke.mpy
krun smoke.mpy --definition runtime-kompiled | tee krun.log
grep -A1 '<exc>' krun.log | grep -q 'NoExc'
grep -A1 '<exit-code>' krun.log | grep -q '0'

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.inner-loop,SPEC.outer-loop,SPEC.target

kompile --backend haskell verification.k \
  --main-module VERIFICATION-BASE \
  --syntax-module MPY-SYNTAX \
  --output-definition bridge-kompiled

kprove bridge-spec.k \
  --definition bridge-kompiled \
  --spec-module BRIDGE-FIXED

if kprove bridge-spec.k \
     --definition bridge-kompiled \
     --spec-module BRIDGE-EXACT-CHECK 2>&1 | tee bridge-exact.log; then
  echo "ERROR: bridge-free exact-LHS check unexpectedly proved" >&2
  exit 1
else
  grep -q 'WarnStuckClaimState' bridge-exact.log
  echo "EXPECTED FAILURE: exact bridge LHS is stuck without the extension"
fi

kprove bridge-spec.k \
  --definition verification-kompiled \
  --spec-module BRIDGE-EXTENDED

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY 2>&1 | tee vacuity.log; then
  echo "ERROR: false-postcondition mutation unexpectedly proved" >&2
  exit 1
else
  grep -q 'WarnStuckClaimState' vacuity.log
  echo "EXPECTED FAILURE: false-postcondition mutation rejected"
fi

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION 2>&1 | tee body-mutation.log; then
  echo "ERROR: body mutation unexpectedly proved" >&2
  exit 1
else
  grep -q 'WarnStuckClaimState' body-mutation.log
  echo "EXPECTED FAILURE: body mutation rejected"
fi

exec
/bin/bash -lc "find /tmp/audit-work -maxdepth 3 -printf '%y %p -> %l\\n' | sort | sed -n '1,240p'
find /audit-output/evidence -maxdepth 3 -printf '%y %p -> %l\\n' | sort | sed -n '1,240p'" in /audit-output
