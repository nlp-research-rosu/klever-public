+             )
+             ==Bool true
+     andBool outerAcc(
+               false, 0,
+               fCons(0.0, fCons(0.0, .FloatSeq)),
+               fCons(0.0, fCons(0.0, .FloatSeq)),
+               0.0 -Float 1.0
