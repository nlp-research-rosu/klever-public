requires "reference-semantics/semantics.k"

module VERIFICATION-SYNTAX
  imports MPY-SYNTAX

  syntax Val ::= "antiClosure" [function, total]
  syntax IntSeq ::= innerWord(IntSeq, Bool, Int, IntSeq) [function, total]
                  | finishWord(IntSeq, Bool, Int) [function, total]
                  | insertCode(IntSeq, Int) [function, total]
                  | scanResult(IntSeq, IntSeq, IntSeq) [function, total]
                  | scanWord(IntSeq, IntSeq) [function, total]
                  | antiShuffle(IntSeq) [function, total]
  syntax Bool ::= innerFlag(Bool, Int, IntSeq) [function, total]
endmodule

module VERIFICATION
  imports MPY
  imports VERIFICATION-SYNTAX

  // Derived from the exhaustive strLt equations: comparison of one-code
  // strings is comparison of their codes.
  rule strLt(iCons(A, .IntSeq), iCons(B, .IntSeq))
    => A <Int B
    [simplification]

  // The fixed semantics reduces #branch only after its Boolean is literal.
  // These two exhaustive rules are the same transition lifted over a symbolic
  // Boolean; they preserve the complete continuation and every other cell.
  rule <k> #branch(B:Bool, T:Stmts, _E:Stmts) => T ... </k>
    requires B
    [priority(60)]
  rule <k> #branch(B:Bool, _T:Stmts, E:Stmts) => E ... </k>
    requires notBool B
    [priority(60)]

  // Definitional alias for the exact translated source body.  It names the
  // closure value but does not replace lookup, binding, execution, or return.
  rule antiClosure
    => closureVal(
         "s", .ParamNames,
         Assign(Name("result"), Str(""))
         Assign(Name("word"), Str(""))
         Assign(Name("character"), Str(""))
         Assign(Name("existing"), Str(""))
         Assign(Name("new_word"), Str(""))
         Assign(Name("inserted"), Bool(false))
         For(
           Name("character"),
           Name("s"),
           If(
             Compare(Name("character"), CmpOp("==", Str(" "))),
             AugAssign(Name("result"), "+", Name("word"))
             AugAssign(Name("result"), "+", Str(" "))
             Assign(Name("word"), Str("")),
             Assign(Name("new_word"), Str(""))
             Assign(Name("inserted"), Bool(false))
             For(
               Name("existing"),
               Name("word"),
               If(
                 Name("inserted"),
                 AugAssign(Name("new_word"), "+", Name("existing")),
                 If(
                   Compare(Name("character"), CmpOp("<", Name("existing"))),
                   AugAssign(Name("new_word"), "+", Name("character"))
                   Assign(Name("inserted"), Bool(true)),
                   .Stmts)
                 AugAssign(Name("new_word"), "+", Name("existing"))))
             If(
               Name("inserted"),
               Assign(Name("word"), Name("new_word")),
               Assign(
                 Name("word"),
                 BinOp("+", Name("new_word"), Name("character"))))))
         AugAssign(Name("result"), "+", Name("word"))
         Return(Name("result")),
         0)

  // Exact state summaries for the nested insertion loop.
  rule innerWord(NW, _B, _C, .IntSeq) => NW [simplification]
  rule innerWord(NW, true, C, iCons(E, R))
    => innerWord(
         seqConcat(NW, iCons(E, .IntSeq)),
         true,
         C,
         R)
    [simplification]
  rule innerWord(NW, false, C, iCons(E, R))
    => innerWord(
         seqConcat(
           seqConcat(NW, iCons(C, .IntSeq)),
           iCons(E, .IntSeq)),
         true,
         C,
         R)
    requires C <Int E
    [simplification]
  rule innerWord(NW, false, C, iCons(E, R))
    => innerWord(
         seqConcat(NW, iCons(E, .IntSeq)),
         false,
         C,
         R)
    requires notBool (C <Int E)
    [simplification]

  rule innerFlag(B, _C, .IntSeq) => B [simplification]
  rule innerFlag(true, C, iCons(_E, R))
    => innerFlag(true, C, R)
    [simplification]
  rule innerFlag(false, C, iCons(E, R))
    => innerFlag(true, C, R)
    requires C <Int E
    [simplification]
  rule innerFlag(false, C, iCons(E, R))
    => innerFlag(false, C, R)
    requires notBool (C <Int E)
    [simplification]

  rule finishWord(NW, true, _C) => NW
  rule finishWord(NW, false, C)
    => seqConcat(NW, iCons(C, .IntSeq))

  rule insertCode(W, C)
    => finishWord(
         innerWord(.IntSeq, false, C, W),
         innerFlag(false, C, W),
         C)

  // Exact state summaries for the outer character loop.
  rule scanResult(A, _W, .IntSeq) => A [simplification]
  rule scanResult(A, W, iCons(C, R))
    => scanResult(
         seqConcat(seqConcat(A, W), iCons(32, .IntSeq)),
         .IntSeq,
         R)
    requires C ==Int 32
    [simplification]
  rule scanResult(A, W, iCons(C, R))
    => scanResult(A, insertCode(W, C), R)
    requires notBool (C ==Int 32)
    [simplification]

  rule scanWord(W, .IntSeq) => W [simplification]
  rule scanWord(_W, iCons(C, R))
    => scanWord(.IntSeq, R)
    requires C ==Int 32
    [simplification]
  rule scanWord(W, iCons(C, R))
    => scanWord(insertCode(W, C), R)
    requires notBool (C ==Int 32)
    [simplification]

  rule antiShuffle(S)
    => seqConcat(
         scanResult(.IntSeq, .IntSeq, S),
         scanWord(.IntSeq, S))
endmodule

===== prove.sh =====
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy
python3 py2mpy.py solution-mutant.py > solution-mutant.mpy
python3 py2mpy.py branch-smoke.py > branch-smoke.mpy
python3 smoke.py

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled \
  2>&1 | tee kompile-runtime.log

krun smoke.mpy --definition runtime-kompiled \
  2>&1 | tee krun-smoke.log

krun branch-smoke.mpy --definition runtime-kompiled \
  2>&1 | tee branch-fixed.log

kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module VERIFICATION-SYNTAX \
  --output-definition verification-kompiled \
  2>&1 | tee kompile-proof.log

# Positive target proofs.  Each trusted auxiliary below is first discharged
# independently by the preceding command.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.insertion-loop \
  2>&1 | tee kprove-insertion-loop.log

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.insertion-loop,SPEC.character-loop \
  --trusted SPEC.insertion-loop \
  2>&1 | tee kprove-character-loop.log

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.insertion-loop,SPEC.character-loop,SPEC.anti-shuffle \
  --trusted SPEC.insertion-loop,SPEC.character-loop \
  2>&1 | tee kprove-entry.log

# Operational-bridge validation: both symbolic branch directions preserve the
# selected continuation and state; ground fixed/extended executions coincide.
kprove spec-branch-validation.k \
  --definition verification-kompiled \
  --spec-module SPEC-BRANCH-VALIDATION \
  2>&1 | tee kprove-branch-validation.log

krun branch-smoke.mpy --definition verification-kompiled \
  2>&1 | tee branch-extended.log
cmp branch-fixed.log branch-extended.log

set +e
kprove spec-branch-mutant.k \
  --definition verification-kompiled \
  --spec-module SPEC-BRANCH-MUTANT \
  2>&1 | tee kprove-branch-mutant.log
branch_mutant_status=${PIPESTATUS[0]}
set -e
if [[ $branch_mutant_status -eq 0 ]]; then
  echo "ERROR: wrong symbolic branch unexpectedly proved"
  exit 1
fi
echo "EXPECTED FAILURE: branch mutation exited $branch_mutant_status"

# Gate A5: a false result for the realizable empty-string input must fail.
set +e
kprove spec-vacuity.k \
  --definition verification-kompiled \
  --spec-module SPEC-VACUITY \
  --claims SPEC.insertion-loop,SPEC.character-loop,SPEC-VACUITY.false-result \
  --trusted SPEC.insertion-loop,SPEC.character-loop \
  2>&1 | tee kprove-vacuity.log
vacuity_status=${PIPESTATUS[0]}
set -e
if [[ $vacuity_status -eq 0 ]]; then
  echo "ERROR: false-result mutation unexpectedly proved"
  exit 1
fi
echo "EXPECTED FAILURE: false-result mutation exited $vacuity_status"

# Gate A1: a material source-body mutation must lose the original result.
set +e
kprove spec-body-mutant.k \
  --definition verification-kompiled \
  --spec-module SPEC-BODY-MUTANT \
  2>&1 | tee kprove-body-mutant.log
body_mutant_status=${PIPESTATUS[0]}
set -e
if [[ $body_mutant_status -eq 0 ]]; then
  echo "ERROR: body mutation unexpectedly proved"
  exit 1
fi
echo "EXPECTED FAILURE: body mutation exited $body_mutant_status"

python3 differential.py 2>&1 | tee differential.log

===== PROOF.md =====
VALIDATED

## What is proven

Under the supplied `MPY` semantics, for every symbolic input code sequence
`S:IntSeq`, loading the exact translated `anti_shuffle` definition and calling
`anti_shuffle(str(S))` reaches a normal return
`str(antiShuffle(S))`.  The entry claim also restores the module environment,
scope allocator, empty heap, heap allocator, empty call stack, `noRet`,
`NoExc`, and exit code 0.

This is a partial-correctness theorem: it proves the stated result for every
normally terminating execution.  It does not separately prove termination.

Program boundary:

- Entry computation: exact `#loadAll(Module(FuncDef(...)))` from
  `solution.mpy`, followed by `Call(Name("anti_shuffle"), str(S))`.
- Program-defined operations: the complete `anti_shuffle` body and both of its
  source-level loops.
- Input domain: every semantic `str(S)` for `S:IntSeq`; real ASCII strings are
  the intended subset from the prompt.
- Observable final state: returned string, module binding, scope/heap
  allocators, heap, stack, return cell, exception cell, and exit code.

The generated-source identity is recorded in `artifact-sha256.txt`.  In
particular, `solution.py` has SHA-256
`97132b21b6530718dbbbce97f3062f4816ef93e3e6f538301528f9233f102097`
and its generated `solution.mpy` has SHA-256
`17b8273aa387c21ba0d812a8212dc8a12abdb6538cc50686a8d9e7ffc4e39366`.

## Formal claim

The main claim is `SPEC.anti-shuffle` in `spec.k`:

```text
#loadAll(exact translated module) ~> Call(Name("anti_shuffle"), str(S))
  => str(antiShuffle(S))
```

`antiShuffle` is a recursive mathematical characterization:

- code 32 flushes the current ordered word and emits exactly one code-32
  separator;
- any other code is inserted into the current word before its first greater
  code;
- the final word is appended without adding or removing a separator.

`SPEC.insertion-loop` proves the nested insertion loop.  After it is proved
independently, `SPEC.character-loop` uses it as an auxiliary theorem.
`SPEC.anti-shuffle` then uses both independently proved loop theorems.

## Proof-extension inventory

The inventory below was rebuilt from `verification.k` and `spec.k`.

### Definitional summaries

| Extension | Domain and equations | Context/state/value justification | Dependents and validation |
|---|---|---|---|
| `antiClosure` | One exhaustive equation over the nullary symbol. | Names the exact `closureVal` generated from `solution.mpy`; it does not rewrite a call or skip lookup, binding, body execution, control, or state. | All three claims. Exact source comparison plus the failing body mutation. |
| `innerWord`, `innerFlag` | Empty sequence; inserted `true`; inserted `false` split by `C <Int E` and its negation. Cases are exhaustive and disjoint. Recursion strictly consumes the remaining `IntSeq`. | Mathematical state summaries only. They name the nested loop's final `new_word` and `inserted`; no operational term is replaced. | `SPEC.insertion-loop`, then `insertCode`. Independently proved by `kprove`. |
| `finishWord`, `insertCode` | `finishWord` has disjoint `true`/`false` equations; `insertCode` has one exhaustive equation. | `finishWord` appends the new code iff the loop never inserted it. `insertCode` composes the independently proved nested-loop summaries. | Outer loop and entry claim; differential validation against CPython `sorted`. |
| `scanResult`, `scanWord` | Empty sequence plus code-32/non-code-32 cases. Guards are exhaustive and disjoint; recursion strictly consumes input. | Exact outer-loop state summaries. A space flushes the word and is preserved; a non-space updates only the current word with `insertCode`. | `SPEC.character-loop` and `antiShuffle`; independently proved by `kprove`. |
| `antiShuffle` | One exhaustive equation. | Concatenates the flushed result and final current word. No execution is replaced. | Main entry claim and the false-result probe. |

All functions marked `[total]` above have complete constructor/Boolean/guard
