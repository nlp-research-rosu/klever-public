+      #branch(
+        B:Bool,
+        Assign(Name("x"), Int(4)),
+        Assign(Name("x"), Int(5)))
+      ~> Assign(Name("y"), Int(6))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> (scope("x" |-> 0 "y" |-> 0, parent(-1))
+             => scope("x" |-> 5 "y" |-> 6, parent(-1)))
+    </scopes>
