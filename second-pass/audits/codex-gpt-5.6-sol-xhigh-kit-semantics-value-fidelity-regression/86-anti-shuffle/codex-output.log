index 0000000000000000000000000000000000000000..59aedffccadaf4dd9986619b480e1444d80dacaf
--- /dev/null
+++ b/evidence/08_concrete_harness.py
@@ -0,0 +1,46 @@
+def anti_shuffle(s):
+    result = ""
+    word = ""
+    character = ""
+    existing = ""
+    new_word = ""
+    inserted = False
+    for character in s:
+        if character == " ":
+            result += word
+            result += " "
+            word = ""
+        else:
+            new_word = ""
+            inserted = False
+            for existing in word:
+                if inserted:
+                    new_word += existing
+                else:
+                    if character < existing:
+                        new_word += character
+                        inserted = True
+                    new_word += existing
+            if inserted:
+                word = new_word
+            else:
+                word = new_word + character
+    result += word
+    return result
+
+
+assert anti_shuffle("") == ""
+assert anti_shuffle("Hi") == "Hi"
+assert anti_shuffle("hello") == "ehllo"
