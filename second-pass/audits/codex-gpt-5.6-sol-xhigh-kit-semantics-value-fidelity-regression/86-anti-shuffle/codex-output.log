{"satisfying_claim_states": {"anti-shuffle-entry": {"S": "ba  dc", "initial_env": 0, "initial_heap": {}, "initial_scope_loc": 1, "initial_stack": [], "post_result": "ab  cd"}, "character-loop": {"A": "", "S": "b a", "W": "", "post_result": "b ", "post_word": "a"}, "insertion-loop": {"B": false, "C": 97, "NW": "", "S": "b", "post_inserted": true, "post_new_word": "ab"}}}
