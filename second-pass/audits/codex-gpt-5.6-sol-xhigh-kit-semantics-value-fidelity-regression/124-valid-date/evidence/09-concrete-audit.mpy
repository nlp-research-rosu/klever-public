Module(
  FuncDef("valid_date", Params("date"),
    If(Compare(Call(Name("len"), Name("date")), CmpOp("!=", Int(10))),
      Return(Bool(false)),
      )
    If(Compare(Subscript(Name("date"), Int(2)), CmpOp("!=", Str("-"))),
      Return(Bool(false)),
      )
    If(Compare(Subscript(Name("date"), Int(5)), CmpOp("!=", Str("-"))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      Compare(Subscript(Name("date"), Int(0)), CmpOp("<", Str("0"))),
      Compare(Subscript(Name("date"), Int(0)), CmpOp(">", Str("9")))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      Compare(Subscript(Name("date"), Int(1)), CmpOp("<", Str("0"))),
      Compare(Subscript(Name("date"), Int(1)), CmpOp(">", Str("9")))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      Compare(Subscript(Name("date"), Int(3)), CmpOp("<", Str("0"))),
      Compare(Subscript(Name("date"), Int(3)), CmpOp(">", Str("9")))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      Compare(Subscript(Name("date"), Int(4)), CmpOp("<", Str("0"))),
      Compare(Subscript(Name("date"), Int(4)), CmpOp(">", Str("9")))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      Compare(Subscript(Name("date"), Int(6)), CmpOp("<", Str("0"))),
      Compare(Subscript(Name("date"), Int(6)), CmpOp(">", Str("9")))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      Compare(Subscript(Name("date"), Int(7)), CmpOp("<", Str("0"))),
      Compare(Subscript(Name("date"), Int(7)), CmpOp(">", Str("9")))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      Compare(Subscript(Name("date"), Int(8)), CmpOp("<", Str("0"))),
      Compare(Subscript(Name("date"), Int(8)), CmpOp(">", Str("9")))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      Compare(Subscript(Name("date"), Int(9)), CmpOp("<", Str("0"))),
      Compare(Subscript(Name("date"), Int(9)), CmpOp(">", Str("9")))),
      Return(Bool(false)),
      )
    Assign(
      Name("month_text"),
      Subscript(Name("date"), Slice(NoBound, Int(2), NoBound)))
    Assign(
      Name("day_text"),
      Subscript(Name("date"), Slice(Int(3), Int(5), NoBound)))
    Assign(Name("month"), Call(Name("int"), Name("month_text")))
    Assign(Name("day"), Call(Name("int"), Name("day_text")))
    If(BoolOp(
      "or",
      Compare(Name("month"), CmpOp("<", Int(1))),
      Compare(Name("month"), CmpOp(">", Int(12)))),
      Return(Bool(false)),
      )
    If(Compare(Name("day"), CmpOp("<", Int(1))),
      Return(Bool(false)),
      )
    If(Compare(Name("month"), CmpOp("==", Int(2))),
      Return(Compare(Name("day"), CmpOp("<=", Int(29)))),
      )
    If(BoolOp(
      "or",
      Compare(Name("month"), CmpOp("==", Int(4))),
      Compare(Name("month"), CmpOp("==", Int(6))),
      Compare(Name("month"), CmpOp("==", Int(9))),
      Compare(Name("month"), CmpOp("==", Int(11)))),
      Return(Compare(Name("day"), CmpOp("<=", Int(30)))),
      )
    Return(Compare(Name("day"), CmpOp("<=", Int(31)))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("03-11-2000")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("15-01-2012")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("04-0-2040")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("06-04-2020")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("06/04/2020")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(Call(Name("valid_date"), Str("")), CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("01-01-0000")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("00-01-2000")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("13-01-2000")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("02-00-2000")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("02-29-2000")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("02-30-2000")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("04-30-2000")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("04-31-2000")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("01-31-2000")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("01-32-2000")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("03-11-20A0")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("valid_date"), Str("03-11-20000")),
      CmpOp("==", Bool(false)))))
