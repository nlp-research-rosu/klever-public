from itertools import permutations
from random import Random

from solution import minPath


def brute_min_path(grid, length):
    size = len(grid)
    best = None

    def walk(row, col, path):
        nonlocal best
        if len(path) == length:
            if best is None or path < best:
                best = path
            return
        for row_step, col_step in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            next_row = row + row_step
            next_col = col + col_step
            if 0 <= next_row < size and 0 <= next_col < size:
                walk(
                    next_row,
                    next_col,
                    path + [grid[next_row][next_col]],
                )

    for row in range(size):
        for col in range(size):
            walk(row, col, [grid[row][col]])
    return best


def check(grid, length):
    actual = minPath(grid, length)
    expected = brute_min_path(grid, length)
    if actual != expected:
        raise AssertionError((grid, length, actual, expected))


case_count = 0
for ordering in permutations(range(1, 5)):
    grid = [list(ordering[:2]), list(ordering[2:])]
    for length in range(1, 7):
        check(grid, length)
        case_count += 1

