+def locate_one(grid):
+    row_index = 0
+    row = 0
+    one_row = 0
+    one_col = 0
+    found_col = -1
+    for row in grid:
+        found_col = find_one(row)
+        if found_col >= 0:
+            one_row = row_index
+            one_col = found_col
+        row_index = row_index + 1
+    return (one_row, one_col)
+
+
