+
+def build_path(k, neighbor):
+    result = []
+    step = 0
+    for step in range(k):
+        if step % 2 == 0:
+            result.append(1)
+        else:
+            result.append(neighbor)
+    return result
+
+
+def minPath(grid, k):
+    one_row, one_col = locate_one(grid)
