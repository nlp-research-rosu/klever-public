+            "odd_count",
+            Params(("lst", .ParamNames)),
+            oddBody)))
+      ~> Call(
+           Name("odd_count"),
+           (list(INPUT:ValSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "odd_count" |-> closureVal(
+                 ("lst", .ParamNames),
+                 oddBody,
+                 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
