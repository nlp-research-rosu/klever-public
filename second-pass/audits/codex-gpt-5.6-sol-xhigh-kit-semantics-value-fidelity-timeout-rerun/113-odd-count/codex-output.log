+tail -180 "$EVIDENCE/stage5-body-mutation-kprove.log"
+if (( prove_rc == 0 )); then status=1; fi
+if ! rg -q 'WarnStuckClaimState' "$EVIDENCE/stage5-body-mutation-kprove.log"; then
+  status=1
+fi
