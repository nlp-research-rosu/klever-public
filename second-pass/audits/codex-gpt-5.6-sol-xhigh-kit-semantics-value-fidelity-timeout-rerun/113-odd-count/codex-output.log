+  printf ' %q' "$@"
+  printf '\n'
+  "$@" > "$log" 2>&1
+  local rc=$?
+  printf '[exit %d]\n' "$rc" >> "$log"
+  printf '[exit %d; log %s]\n' "$rc" "$log"
+  tail -100 "$log"
+  if (( rc != 0 )); then
