+  status=1
+fi
+if ! rg -Fq 'vCons ( noneV' /audit-output/evidence/stage6-false-kprove.log; then
+  status=1
+fi
+
+printf 'Final nonvacuity_status=%d\n' "$status"
+exit "$status"

