+      #loadAll(
+        Module(
+          FuncDef(
+            "odd_count",
+            Params(("lst", .ParamNames)),
+            oddBody)))
+      ~> Call(
+           Name("odd_count"),
+           (list(INPUT:ValSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "odd_count" |-> closureVal(
+                 ("lst", .ParamNames),
+                 oddBody,
+                 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               str(strToCodes(
+                 "the number of odd elements 10n the str10ng 10 of the 10nput.")),
+               .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
