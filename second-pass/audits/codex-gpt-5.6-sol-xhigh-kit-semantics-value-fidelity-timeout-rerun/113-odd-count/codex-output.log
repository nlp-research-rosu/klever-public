  > concrete.out
rg -U '<k>[[:space:]]+\.K[[:space:]]+</k>' concrete.out
rg -U '<exc>[[:space:]]+NoExc[[:space:]]+</exc>' concrete.out
rg -U '<exit-code>[[:space:]]+0[[:space:]]+</exit-code>' concrete.out

kompile --backend llvm verification.k \
  --main-module VERIFICATION-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-runtime-kompiled
