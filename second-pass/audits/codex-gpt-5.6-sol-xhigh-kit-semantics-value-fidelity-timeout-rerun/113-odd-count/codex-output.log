+      0 |-> list(
+             valSeqConcat(
+               oddRun(emptyOutput, INPUT),
+               vCons(noneV, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStringValues(INPUT)
+endmodule
