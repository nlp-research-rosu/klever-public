/bin/bash -lc 'bash /audit-output/evidence/stage5-body-sensitivity.sh > /audit-output/evidence/stage5-body-sensitivity.log 2>&1; rc=$?; printf '"'body_sensitivity_script_exit=%s\\n' \""'$rc"; tail -300 /audit-output/evidence/stage5-body-sensitivity.log; exit "$rc"' in /audit-output
