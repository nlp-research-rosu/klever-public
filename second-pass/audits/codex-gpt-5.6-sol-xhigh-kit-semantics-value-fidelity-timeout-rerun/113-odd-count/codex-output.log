+            oddBody)))
+      ~> Call(
+           Name("odd_count"),
+           (list(INPUT:ValSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "odd_count" |-> closureVal(
+                 ("lst", .ParamNames),
+                 oddBody,
+                 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               str(strToCodes(
+                 "the number of odd elements 1n the str1ng 1 of the 1nput.")),
+               vCons(
+                 str(strToCodes(
+                   "the number of odd elements 8n the str8ng 8 of the 8nput.")),
+                 .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires INPUT
+             ==K vCons(
+                   str(strToCodes("3")),
+                   vCons(str(strToCodes("11111111")), .ValSeq))
+
