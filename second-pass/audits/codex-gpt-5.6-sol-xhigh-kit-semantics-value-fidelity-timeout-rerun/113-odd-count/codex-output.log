+    <exit-code> 0 </exit-code>
+    requires INPUT
+             ==K vCons(
+                   str(strToCodes("3")),
+                   vCons(str(strToCodes("11111111")), .ValSeq))
+
+  claim [ten-odd]:
+    <k>
