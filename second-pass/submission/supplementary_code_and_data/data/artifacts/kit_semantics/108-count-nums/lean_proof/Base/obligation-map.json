      "normalized_sha256": "f0bc44c15424da687bfa0aeb3e970f71a2cc9dbd9a38c4ac04629f27cea4ac69",
      "rationale": "Adds a simplification bridge from dynamically sorted integer comparison to projected Int comparison; its exact statement is not separately proved before the rule is imported.",
      "source_rule_id": "rule-f0bc44c15424da687bfa0aeb3e970f71a2cc9dbd9a38c4ac04629f27cea4ac69",
      "start_line": 41,
      "text": "  rule applyCmp(\"<\", V:Val, J:Int)\n    => projectIntTotal(V) <Int J\n    requires isInt(V)\n    [simplification]"
    },
