requires "semantic.k"

module VERIFICATION
  imports SEMANTIC

  syntax Module ::= "simplifyProgram"
  rule simplifyProgram =>
    Module(
      FuncDef("simplify", Params("x", "n"),
        Assign(
          Name("x_parts"),
          Call(Attribute(Name("x"), "split"), Str("/")))
        Assign(
          Name("n_parts"),
          Call(Attribute(Name("n"), "split"), Str("/")))
        Assign(
          Name("numerator"),
          BinOp(
            "*",
            Call(Name("int"), Subscript(Name("x_parts"), Int(0))),
            Call(Name("int"), Subscript(Name("n_parts"), Int(0)))))
        Assign(
          Name("denominator"),
          BinOp(
            "*",
            Call(Name("int"), Subscript(Name("x_parts"), Int(1))),
            Call(Name("int"), Subscript(Name("n_parts"), Int(1)))))
        Return(
          Compare(
            BinOp("%", Name("numerator"), Name("denominator")),
            CmpOp("==", Int(0))))))

  // Sound symbolic instances of split and int for the canonical decimal
  // strings generated by Int2String.  The concrete semantics above handles
  // arbitrary literal valid fractions with findString/substrString/String2Int.
  rule slashSplit(Int2String(A) +String "/" +String Int2String(B))
        => pairList(strVal(Int2String(A)), strVal(Int2String(B)))
       [simplification]
  rule decimalValue(Int2String(I)) => I [simplification]
  rule String2Int(Int2String(I)) => I [simplification]
endmodule
