+                     .Exprs)),
+                  Name("result")))
+              Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+              .Stmts)
+            Return(BinOp("+", Name("sign"), Name("result")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
