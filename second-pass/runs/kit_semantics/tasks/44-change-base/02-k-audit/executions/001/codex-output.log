diff --git a//tmp/audit-work/44-change-base/concrete_actual.py b//tmp/audit-work/44-change-base/concrete_actual.py
new file mode 100644
index 0000000000000000000000000000000000000000..173415946359592d58c89ca65ad94d4f4194bb1f
--- /dev/null
+++ b//tmp/audit-work/44-change-base/concrete_actual.py
@@ -0,0 +1,20 @@
+def change_base(x: int, base: int):
+    if x == 0:
+        return "0"
+    sign = ""
+    if x < 0:
+        sign = "-"
+        x = -x
+    result = ""
+    while x > 0:
+        result = chr(48 + x % base) + result
+        x = x // base
+    return sign + result
+
+
+assert change_base(8, 3) == "22"
+assert change_base(8, 2) == "1000"
+assert change_base(7, 2) == "111"
+assert change_base(0, 2) == "0"
+assert change_base(-8, 3) == "-22"
+assert change_base(9, 9) == "10"
diff --git a//tmp/audit-work/44-change-base/fresh-body-mutation-spec.k b//tmp/audit-work/44-change-base/fresh-body-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2494eda091956a8bd306ac2be12b4073a2fb56d8
--- /dev/null
+++ b//tmp/audit-work/44-change-base/fresh-body-mutation-spec.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module FRESH-BODY-MUTATION-SPEC
+  imports VERIFICATION
+
+  // Reviewer-authored body mutation: 48 becomes 49 in the executed closure.
+  // The original expected result "22" is deliberately retained.
+  claim [changed-executed-body]:
+    <k>
+      Call(Name("change_base"), (8, 3, .Exprs))
+      =>
+      str(iCons(50, iCons(50, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "change_base" |->
+          closureVal(
+            ("x", "base", .ParamNames),
+            If(
+              Compare(Name("x"), CmpOp("==", Int(0))),
+              Return(Str("0")) .Stmts,
+              .Stmts)
+            Assign(Name("sign"), Str(""))
+            If(
+              Compare(Name("x"), CmpOp("<", Int(0))),
+              Assign(Name("sign"), Str("-"))
+              Assign(Name("x"), UnaryOp("-", Name("x")))
+              .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str(""))
+            While(
+              Compare(Name("x"), CmpOp(">", Int(0))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    (BinOp(
+                       "+",
+                       Int(49),
+                       BinOp("%", Name("x"), Name("base"))),
+                     .Exprs)),
+                  Name("result")))
+              Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+              .Stmts)
+            Return(BinOp("+", Name("sign"), Name("result")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/44-change-base/fresh-false-spec.k b//tmp/audit-work/44-change-base/fresh-false-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..86d651015209e87dd17080ecba42ca793f9be0f9
--- /dev/null
+++ b//tmp/audit-work/44-change-base/fresh-false-spec.k
@@ -0,0 +1,60 @@
+requires "verification.k"
+
+module FRESH-FALSE-SPEC
+  imports VERIFICATION
+
+  // Reviewer-authored false result: 8 in base 3 is "22", not "23".
+  claim [wrong-ground-result]:
+    <k>
+      Call(Name("change_base"), (8, 3, .Exprs))
+      =>
+      str(iCons(50, iCons(51, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "change_base" |->
+          closureVal(
+            ("x", "base", .ParamNames),
+            If(
+              Compare(Name("x"), CmpOp("==", Int(0))),
+              Return(Str("0")) .Stmts,
+              .Stmts)
+            Assign(Name("sign"), Str(""))
+            If(
+              Compare(Name("x"), CmpOp("<", Int(0))),
+              Assign(Name("sign"), Str("-"))
+              Assign(Name("x"), UnaryOp("-", Name("x")))
+              .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str(""))
+            While(
+              Compare(Name("x"), CmpOp(">", Int(0))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    (BinOp(
+                       "+",
+                       Int(48),
+                       BinOp("%", Name("x"), Name("base"))),
+                     .Exprs)),
+                  Name("result")))
+              Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+              .Stmts)
+            Return(BinOp("+", Name("sign"), Name("result")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
