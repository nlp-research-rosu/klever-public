    42	              Assign(Name("x"), UnaryOp("-", Name("x")))
    43	              .Stmts,
    44	              .Stmts)
    45	            Assign(Name("result"), Str(""))
    46	            While(
    47	              Compare(Name("x"), CmpOp(">", Int(0))),
    48	              Assign(
    49	                Name("result"),
    50	                BinOp(
    51	                  "+",
    52	                  Call(
    53	                    Name("chr"),
    54	                    (BinOp(
    55	                       "+",
    56	                       Int(48),
    57	                       BinOp("%", Name("x"), Name("base"))),
    58	                     .Exprs)),
    59	                  Name("result")))
    60	              Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
    61	              .Stmts)
    62	            Return(BinOp("+", Name("sign"), Name("result")))
    63	            .Stmts,
    64	            0),
    65	        parent(-1))
    66	      1 |-> scope(
    67	        "x"      |-> (X:Int => 0)
    68	        "base"   |-> B:Int
    69	        "sign"   |-> str(_SIGN:IntSeq)
    70	        "result" |-> (str(ACC:IntSeq) => str(baseAcc(X, B, ACC))),
    71	        parent(0))
    72	    </scopes>
    73	    <scopeLoc> 2 </scopeLoc>
    74	    <heap> .Map </heap>
    75	    <heapLoc> 0 </heapLoc>
    76	    <stack> ListItem(frame(.K, 0, 1)) </stack>
    77	    <ret> noRet </ret>
    78	    <exc> NoExc </exc>
    79	    <exit-code> 0 </exit-code>
    80	    requires X >=Int 0
    81	     andBool B >=Int 2
    82	     andBool B <Int 10
    83	
    84	  claim [change-base]:
