@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+import collections
+import glob
+import hashlib
+import json
+from pathlib import Path
+
+
+paths = sorted(glob.glob("/generation-evidence/codex-trace/**/*.jsonl", recursive=True))
+print(f"trace_files={len(paths)}")
+all_calls = {}
+all_outputs = set()
+failures = []
