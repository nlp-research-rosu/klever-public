diff --git a//tmp/audit-work/44-change-base/summary-ground-spec.k b//tmp/audit-work/44-change-base/summary-ground-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d30933b495925c457c3d72218ec19dd7a79cffc3
--- /dev/null
+++ b//tmp/audit-work/44-change-base/summary-ground-spec.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module SUMMARY-GROUND-SPEC
+  imports VERIFICATION
+
+  claim [positive]:
