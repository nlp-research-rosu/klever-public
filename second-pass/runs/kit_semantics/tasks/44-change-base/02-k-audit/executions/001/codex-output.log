     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  claim [loop-invariant]:
     7	    <k>
     8	      #while(
     9	        Compare(Name("x"), CmpOp(">", Int(0))),
    10	        Assign(
    11	          Name("result"),
    12	          BinOp(
    13	            "+",
    14	            Call(
    15	              Name("chr"),
    16	              (BinOp("+", Int(48), BinOp("%", Name("x"), Name("base"))),
    17	               .Exprs)),
    18	            Name("result")))
    19	        Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
    20	        .Stmts)
    21	      ~> (Return(BinOp("+", Name("sign"), Name("result"))) .Stmts)
    22	      ~> #endcall
    23	      =>
    24	      (Return(BinOp("+", Name("sign"), Name("result"))) .Stmts)
    25	      ~> #endcall
    26	    </k>
    27	    <env> 1 </env>
    28	    <scopes>
    29	      -1 |-> builtinsScope
    30	      0 |-> scope(
    31	        "change_base" |->
    32	          closureVal(
    33	            ("x", "base", .ParamNames),
    34	            If(
    35	              Compare(Name("x"), CmpOp("==", Int(0))),
    36	              Return(Str("0")) .Stmts,
    37	              .Stmts)
    38	            Assign(Name("sign"), Str(""))
    39	            If(
    40	              Compare(Name("x"), CmpOp("<", Int(0))),
