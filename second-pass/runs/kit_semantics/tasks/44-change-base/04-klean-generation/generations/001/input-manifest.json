      "normalized_sha256": "a83520c2dd7e4dd9d917bbb76d25675cd45efb14625dd3c04c89bea96b55f994",
      "rationale": "This guarded base case defines baseAcc to return its accumulator whenever the remaining magnitude is nonpositive; it is an equation for the mathematical summary, not an execution rule or an additional arithmetic fact.",
      "source_rule_id": "rule-a83520c2dd7e4dd9d917bbb76d25675cd45efb14625dd3c04c89bea96b55f994",
      "start_line": 11,
      "text": "  rule baseAcc(N:Int, _B:Int, ACC:IntSeq) => ACC\n    requires N <=Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "efae065e614915ce96e387b26c2b7d560fb4b333fdbf8df6c5449cfcc506f474",
      "rationale": "This off-target totalization case defines baseAcc for positive magnitudes with bases below 2 by returning the accumulator, completing the named function's cases without asserting a separate theorem.",
      "source_rule_id": "rule-efae065e614915ce96e387b26c2b7d560fb4b333fdbf8df6c5449cfcc506f474",
      "start_line": 15,
      "text": "  rule baseAcc(N:Int, B:Int, ACC:IntSeq) => ACC\n    requires N >Int 0 andBool B <Int 2\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "ecc726b19ca39761f0f286a8792a1c0d075bb725e0d8eb2538c8383ea095d39a",
      "rationale": "This is the recursive defining equation for baseAcc on positive magnitudes and valid bases, naming one quotient-and-remainder conversion step and the prepended digit code.",
      "source_rule_id": "rule-ecc726b19ca39761f0f286a8792a1c0d075bb725e0d8eb2538c8383ea095d39a",
      "start_line": 19,
      "text": "  rule baseAcc(N:Int, B:Int, ACC:IntSeq)\n    => baseAcc(\n         (N -Int pyMod(N, B)) /Int B,\n         B,\n         iCons(48 +Int pyMod(N, B), ACC))\n    requires N >Int 0 andBool B >=Int 2\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "fdf7755e024660316168d967838e2f08fc43b0714316aea144f9262274ca8118",
      "rationale": "This equation defines the zero case of changeBaseCodes as the one-character code sequence for 0.",
      "source_rule_id": "rule-fdf7755e024660316168d967838e2f08fc43b0714316aea144f9262274ca8118",
      "start_line": 30,
      "text": "  rule changeBaseCodes(0, _B:Int) => iCons(48, .IntSeq)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "245f4d2054d650ca1be786d19cae2a4a19ab245f30f7fcbfe5c1941337011d41",
      "rationale": "This equation defines positive changeBaseCodes values by initializing the previously defined baseAcc summary with an empty accumulator.",
      "source_rule_id": "rule-245f4d2054d650ca1be786d19cae2a4a19ab245f30f7fcbfe5c1941337011d41",
      "start_line": 33,
      "text": "  rule changeBaseCodes(N:Int, B:Int) => baseAcc(N, B, .IntSeq)\n    requires N >Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 40,
      "module": "VERIFICATION",
      "normalized_sha256": "6eaa184d7af4006c64c04aece2ef1ec1819bca91e287204a99a56c1d22546abd",
      "rationale": "This equation defines negative changeBaseCodes values by prefixing the minus-sign code and converting the positive magnitude through baseAcc.",
      "source_rule_id": "rule-6eaa184d7af4006c64c04aece2ef1ec1819bca91e287204a99a56c1d22546abd",
      "start_line": 37,
      "text": "  rule changeBaseCodes(N:Int, B:Int)\n    => iCons(45, baseAcc(0 -Int N, B, .IntSeq))\n    requires N <Int 0\n    [simplification]"
    }
  ],
