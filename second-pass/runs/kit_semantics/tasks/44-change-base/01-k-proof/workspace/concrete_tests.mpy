Module(
  FuncDef("change_base", Params("x", "base"),
    If(Compare(Name("x"), CmpOp("==", Int(0))),
      Return(Str("0")),
      )
    Assign(Name("sign"), Str(""))
    If(Compare(Name("x"), CmpOp("<", Int(0))),
      Assign(Name("sign"), Str("-"))
      Assign(Name("x"), UnaryOp("-", Name("x"))),
      )
    Assign(Name("result"), Str(""))
    While(Compare(Name("x"), CmpOp(">", Int(0))),
      Assign(
        Name("result"),
        BinOp(
          "+",
          Call(
            Name("chr"),
            BinOp("+", Int(48), BinOp("%", Name("x"), Name("base")))),
          Name("result")))
      Assign(Name("x"), BinOp("//", Name("x"), Name("base"))))
    Return(BinOp("+", Name("sign"), Name("result"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(8), Int(3)),
      CmpOp("==", Str("22"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(8), Int(2)),
      CmpOp("==", Str("1000"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(7), Int(2)),
      CmpOp("==", Str("111"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(0), Int(2)),
      CmpOp("==", Str("0"))))
  Assert(
    Compare(
      Call(Name("change_base"), UnaryOp("-", Int(8)), Int(3)),
      CmpOp("==", Str("-22"))))
  Assert(
    Compare(
      Call(Name("change_base"), UnaryOp("-", Int(7)), Int(2)),
      CmpOp("==", Str("-111"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(12345), Int(9)),
      CmpOp("==", Str("17836")))))
