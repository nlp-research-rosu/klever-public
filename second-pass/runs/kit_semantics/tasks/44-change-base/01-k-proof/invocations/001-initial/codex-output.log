+def change_base(x: int, base: int):
+    if x == 0:
+        return "0"
+    sign = ""
+    if x < 0:
+        sign = "-"
+        x = -x
+    result = ""
+    while x > 0:
+        result = chr(48 + x % base) + result
+        x = x // base
+    return sign + result
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..95466fedf23fd9d040a671d9ec4d9a8c8c105af9
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Ground body-sensitivity probe. The digit offset is changed from 48 to 49,
+  // while the expected result for change_base(8, 3) remains "22".
+  claim [mutated-body]:
+    <k>
+      Call(Name("change_base"), (8, 3, .Exprs))
+      =>
+      str(iCons(50, iCons(50, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "change_base" |->
+          closureVal(
+            ("x", "base", .ParamNames),
+            If(
+              Compare(Name("x"), CmpOp("==", Int(0))),
+              Return(Str("0")) .Stmts,
+              .Stmts)
+            Assign(Name("sign"), Str(""))
+            If(
+              Compare(Name("x"), CmpOp("<", Int(0))),
+              Assign(Name("sign"), Str("-"))
+              Assign(Name("x"), UnaryOp("-", Name("x")))
+              .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str(""))
+            While(
+              Compare(Name("x"), CmpOp(">", Int(0))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    (BinOp(
+                       "+",
+                       Int(49),
+                       BinOp("%", Name("x"), Name("base"))),
+                     .Exprs)),
+                  Name("result")))
+              Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+              .Stmts)
+            Return(BinOp("+", Name("sign"), Name("result")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..b3646fe4cffea79a4c0fe44e6dcbe4cb50b9ceed
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,142 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // The genuine invariant is present so the mutation tests only the requested
+  // final result, not bounded loop execution.
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("x"), CmpOp(">", Int(0))),
+        Assign(
+          Name("result"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              (BinOp("+", Int(48), BinOp("%", Name("x"), Name("base"))),
+               .Exprs)),
+            Name("result")))
+        Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+        .Stmts)
+      ~> (Return(BinOp("+", Name("sign"), Name("result"))) .Stmts)
+      ~> #endcall
+      =>
+      (Return(BinOp("+", Name("sign"), Name("result"))) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "change_base" |->
+          closureVal(
+            ("x", "base", .ParamNames),
+            If(
+              Compare(Name("x"), CmpOp("==", Int(0))),
+              Return(Str("0")) .Stmts,
+              .Stmts)
+            Assign(Name("sign"), Str(""))
+            If(
+              Compare(Name("x"), CmpOp("<", Int(0))),
+              Assign(Name("sign"), Str("-"))
+              Assign(Name("x"), UnaryOp("-", Name("x")))
+              .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str(""))
+            While(
+              Compare(Name("x"), CmpOp(">", Int(0))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    (BinOp(
+                       "+",
+                       Int(48),
+                       BinOp("%", Name("x"), Name("base"))),
+                     .Exprs)),
+                  Name("result")))
+              Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+              .Stmts)
+            Return(BinOp("+", Name("sign"), Name("result")))
+            .Stmts,
+            0),
+        parent(-1))
+      1 |-> scope(
+        "x"      |-> (X:Int => 0)
+        "base"   |-> B:Int
+        "sign"   |-> str(_SIGN:IntSeq)
+        "result" |-> (str(ACC:IntSeq) => str(baseAcc(X, B, ACC))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires X >=Int 0
+     andBool B >=Int 2
+     andBool B <Int 10
+
+  // Deliberately false: prefix every correct result with '!'.
+  claim [wrong-result]:
+    <k>
+      Call(Name("change_base"), (X:Int, B:Int, .Exprs))
+      =>
+      str(iCons(33, changeBaseCodes(X, B)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "change_base" |->
+          closureVal(
+            ("x", "base", .ParamNames),
+            If(
+              Compare(Name("x"), CmpOp("==", Int(0))),
+              Return(Str("0")) .Stmts,
+              .Stmts)
+            Assign(Name("sign"), Str(""))
+            If(
+              Compare(Name("x"), CmpOp("<", Int(0))),
+              Assign(Name("sign"), Str("-"))
+              Assign(Name("x"), UnaryOp("-", Name("x")))
+              .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str(""))
+            While(
+              Compare(Name("x"), CmpOp(">", Int(0))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    (BinOp(
+                       "+",
+                       Int(48),
+                       BinOp("%", Name("x"), Name("base"))),
+                     .Exprs)),
+                  Name("result")))
+              Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+              .Stmts)
+            Return(BinOp("+", Name("sign"), Name("result")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires B >=Int 2
+     andBool B <Int 10
+endmodule
