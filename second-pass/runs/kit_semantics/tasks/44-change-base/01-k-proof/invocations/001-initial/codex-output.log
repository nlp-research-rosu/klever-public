+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires X >=Int 0
+     andBool B >=Int 2
+     andBool B <Int 10
+
+  claim [change-base]:
+    <k>
+      Call(Name("change_base"), (X:Int, B:Int, .Exprs))
+      =>
+      str(changeBaseCodes(X, B))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "change_base" |->
+          closureVal(
+            ("x", "base", .ParamNames),
+            If(
+              Compare(Name("x"), CmpOp("==", Int(0))),
+              Return(Str("0")) .Stmts,
