+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("x"), CmpOp(">", Int(0))),
+        Assign(
+          Name("result"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              (BinOp("+", Int(48), BinOp("%", Name("x"), Name("base"))),
+               .Exprs)),
+            Name("result")))
+        Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+        .Stmts)
+      ~> (Return(BinOp("+", Name("sign"), Name("result"))) .Stmts)
+      ~> #endcall
+      =>
+      (Return(BinOp("+", Name("sign"), Name("result"))) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "change_base" |->
+          closureVal(
+            ("x", "base", .ParamNames),
+            If(
+              Compare(Name("x"), CmpOp("==", Int(0))),
+              Return(Str("0")) .Stmts,
+              .Stmts)
+            Assign(Name("sign"), Str(""))
+            If(
+              Compare(Name("x"), CmpOp("<", Int(0))),
+              Assign(Name("sign"), Str("-"))
+              Assign(Name("x"), UnaryOp("-", Name("x")))
+              .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str(""))
+            While(
+              Compare(Name("x"), CmpOp(">", Int(0))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    (BinOp(
+                       "+",
+                       Int(48),
+                       BinOp("%", Name("x"), Name("base"))),
+                     .Exprs)),
+                  Name("result")))
+              Assign(Name("x"), BinOp("//", Name("x"), Name("base")))
+              .Stmts)
+            Return(BinOp("+", Name("sign"), Name("result")))
+            .Stmts,
+            0),
+        parent(-1))
+      1 |-> scope(
+        "x"      |-> (X:Int => 0)
+        "base"   |-> B:Int
+        "sign"   |-> str(SIGN:IntSeq)
+        "result" |-> (str(ACC:IntSeq) => str(baseAcc(X, B, ACC))),
+        parent(0))
+    </scopes>
