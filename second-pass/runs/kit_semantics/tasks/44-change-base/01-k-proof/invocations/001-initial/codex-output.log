/bin/bash -lc 'head -n 1 PROOF.md
for f in solution.py solution.mpy verification.k spec.k prove.sh PROOF.md; do test -s "$f" && echo "present: $f"; done
python3 py2mpy.py solution.py | cmp -s - solution.mpy && echo "translation: solution.mpy is current"
git status --short 2>/dev/null || true' in /workspace
