+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical accumulator semantics for the repeated-division loop.
+  // On the verified domain N >= 0 and B >= 2, the recursive argument strictly
+  // decreases whenever N > 0.
+  syntax IntSeq ::= baseAcc(Int, Int, IntSeq) [function, total]
+
+  rule baseAcc(N:Int, _B:Int, ACC:IntSeq) => ACC
+    requires N <=Int 0
+    [simplification]
+
+  rule baseAcc(N:Int, B:Int, ACC:IntSeq) => ACC
+    requires N >Int 0 andBool B <Int 2
+    [simplification]
+
+  rule baseAcc(N:Int, B:Int, ACC:IntSeq)
+    => baseAcc(
+         (N -Int pyMod(N, B)) /Int B,
+         B,
+         iCons(48 +Int pyMod(N, B), ACC))
+    requires N >Int 0 andBool B >=Int 2
+    [simplification]
+
+  // Complete signed-integer representation used by the entry claim.
+  syntax IntSeq ::= changeBaseCodes(Int, Int) [function, total]
+
+  rule changeBaseCodes(0, _B:Int) => iCons(48, .IntSeq)
+    [simplification]
+
+  rule changeBaseCodes(N:Int, B:Int) => baseAcc(N, B, .IntSeq)
+    requires N >Int 0
+    [simplification]
+
+  rule changeBaseCodes(N:Int, B:Int)
+    => iCons(45, baseAcc(0 -Int N, B, .IntSeq))
+    requires N <Int 0
+    [simplification]
+endmodule

codex
Both Gate A probes reject as required: the false-result theorem fails on the realizable `x = 0` branch, and the body mutation `48 → 49` computes `"33"` for `(8, 3)` instead of `"22"`. The independent oracle also reports 0 mismatches across 4,008 signed/base cases. I’m packaging these exact commands into the reproducible runner before the final clean rerun.
apply patch
patch: completed
/workspace/prove.sh
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..69523da297b74b0a6afb8847fb3d6d7902fb635e
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,21 @@
+def change_base(x: int, base: int):
+    if x == 0:
+        return "0"
+    sign = ""
+    if x < 0:
+        sign = "-"
+        x = -x
+    result = ""
+    while x > 0:
+        result = chr(48 + x % base) + result
+        x = x // base
+    return sign + result
+
+
+assert change_base(8, 3) == "22"
+assert change_base(8, 2) == "1000"
+assert change_base(7, 2) == "111"
+assert change_base(0, 2) == "0"
+assert change_base(-8, 3) == "-22"
+assert change_base(-7, 2) == "-111"
+assert change_base(12345, 9) == "17836"
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..5cc19a8b1e3ea9f3716d87c5fb5b828bc7d3bad1
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,37 @@
+from solution import change_base
+
+
+def oracle_change_base(x: int, base: int) -> str:
+    """Independent most-significant-place conversion oracle."""
+    if x == 0:
+        return "0"
+
+    sign = "-" if x < 0 else ""
+    magnitude = abs(x)
+    place = 1
+    while place * base <= magnitude:
+        place *= base
+
+    digits = []
+    while place > 0:
+        digit = magnitude // place
+        digits.append(chr(48 + digit))
+        magnitude %= place
+        place //= base
+    return sign + "".join(digits)
+
+
+mismatches = []
+for base in range(2, 10):
+    for x in range(-250, 251):
+        actual = change_base(x, base)
+        expected = oracle_change_base(x, base)
+        if actual != expected:
+            mismatches.append((x, base, actual, expected))
+
+print("domain: x=-250..250, base=2..9")
+print(f"cases: {8 * 501}")
+print(f"mismatches: {len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..196e9162be38838ee757a5df9d54bccb68d41cb7
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+python3 concrete_tests.py
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-invariant
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+if kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY
+then
+  echo "ERROR: false-result mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-result mutation was rejected"
+fi
+
+if kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION
+then
+  echo "ERROR: body mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: body mutation was rejected"
+fi
+
+python3 differential_test.py
