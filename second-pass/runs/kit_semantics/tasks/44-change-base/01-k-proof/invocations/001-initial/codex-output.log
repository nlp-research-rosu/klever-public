+        .Stmts)
+      ~> (Return(BinOp("+", Name("sign"), Name("result"))) .Stmts)
+      ~> #endcall
+      =>
+      (Return(BinOp("+", Name("sign"), Name("result"))) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "change_base" |->
+          closureVal(
+            ("x", "base", .ParamNames),
+            If(
+              Compare(Name("x"), CmpOp("==", Int(0))),
+              Return(Str("0")) .Stmts,
+              .Stmts)
+            Assign(Name("sign"), Str(""))
+            If(
+              Compare(Name("x"), CmpOp("<", Int(0))),
