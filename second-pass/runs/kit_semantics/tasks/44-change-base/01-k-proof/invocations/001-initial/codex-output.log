diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4153b731ded1b0f61363c6afe223420bf1deebf2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical accumulator semantics for the repeated-division loop.
+  // On the verified domain N >= 0 and B >= 2, the recursive argument strictly
+  // decreases whenever N > 0.
+  syntax IntSeq ::= baseAcc(Int, Int, IntSeq) [function, total]
+
+  rule baseAcc(N:Int, _B:Int, ACC:IntSeq) => ACC
+    requires N <=Int 0
+    [simplification]
+
+  rule baseAcc(N:Int, B:Int, ACC:IntSeq) => ACC
+    requires N >Int 0 andBool B <Int 2
+    [simplification]
+
+  rule baseAcc(N:Int, B:Int, ACC:IntSeq)
+    => baseAcc(
+         (N -Int pyMod(N, B)) /Int B,
+         B,
+         iCons(48 +Int pyMod(N, B), ACC))
+    requires N >Int 0 andBool B >=Int 2
+    [simplification]
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..7c2f4793de35d33241d5644ed2c2cd1a75363de2
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,13 @@
+def change_base(x: int, base: int):
+    result = ""
+    while x > 0:
+        result = chr(48 + x % base) + result
+        x = x // base
+    return result
+
+
+assert change_base(8, 3) == "22"
+assert change_base(8, 2) == "1000"
+assert change_base(7, 2) == "111"
+assert change_base(0, 2) == ""
+assert change_base(12345, 9) == "17836"
