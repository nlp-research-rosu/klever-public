new file mode 100644
index 0000000000000000000000000000000000000000..9e146d6b2d25d004975e7bd9e13f8fc001599268
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def change_base(x: int, base: int):
+    if x == 0:
+        return "0"
+    sign = ""
+    if x < 0:
+        sign = "-"
+        x = -x
+    result = ""
+    while x > 0:
+        result = chr(48 + x % base) + result
+        x = x // base
+    return sign + result
