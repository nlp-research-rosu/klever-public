printf 'DRY_RUN_EXIT=%s\\nPROOF_EXIT=%s\\nSTUCK_WARNINGS=%s\\nTOP_LINES=%s\\n' \""'$dry_status" "$prove_status" "$warn_count" "$top_count" | tee -a /audit-output/evidence/12-non-vacuity.log
if [ "$dry_status" -ne 0 ] || [ "$prove_status" -eq 0 ] || [ "$warn_count" -lt 1 ] || [ "$top_count" -ne 0 ]; then exit 1; fi
exit 0' in /tmp/audit-work/proof
