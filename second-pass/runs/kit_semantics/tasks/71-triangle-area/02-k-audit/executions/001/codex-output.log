kprove auditor-false-result.k --definition fresh-verification-kompiled --spec-module AUDITOR-FALSE-RESULT --dry-run 2>&1 | tee -a /audit-output/evidence/12-non-vacuity.log
dry_status="'${PIPESTATUS[0]}
kprove auditor-false-result.k --definition fresh-verification-kompiled --spec-module AUDITOR-FALSE-RESULT 2>&1 | tee -a /audit-output/evidence/12-non-vacuity.log
