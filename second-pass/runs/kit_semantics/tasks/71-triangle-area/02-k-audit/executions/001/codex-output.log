printf '%s\\n' 'WITNESS: A=1, B=2, C=3 satisfies A+B<=C; both Python implementations return -1; mutation demands 0' 'COMMAND: kprove auditor-false-result-v2.k --definition fresh-verification-kompiled --spec-module AUDITOR-FALSE-RESULT-V2 --dry-run' 'COMMAND: kprove auditor-false-result-v2.k --definition fresh-verification-kompiled --spec-module AUDITOR-FALSE-RESULT-V2' | tee /audit-output/evidence/12b-non-vacuity-final.log
kprove auditor-false-result-v2.k --definition fresh-verification-kompiled --spec-module AUDITOR-FALSE-RESULT-V2 --dry-run 2>&1 | tee -a /audit-output/evidence/12b-non-vacuity-final.log
dry_status="'${PIPESTATUS[0]}
kprove auditor-false-result-v2.k --definition fresh-verification-kompiled --spec-module AUDITOR-FALSE-RESULT-V2 2>&1 | tee -a /audit-output/evidence/12b-non-vacuity-final.log
prove_status=${PIPESTATUS[0]}
warn_count=$(rg -n '"'WarnStuckClaimState' /audit-output/evidence/12b-non-vacuity-final.log | wc -l)
missing_hook_count="'$(rg -n '"'missing hook' /audit-output/evidence/12b-non-vacuity-final.log | wc -l)
top_count="'$(awk '"'"'$0 == "#Top" {n += 1} END {print n+0}'"' /audit-output/evidence/12b-non-vacuity-final.log)
printf 'DRY_RUN_EXIT=%s\\nPROOF_EXIT=%s\\nSTUCK_WARNINGS=%s\\nMISSING_HOOK_LINES=%s\\nTOP_LINES=%s\\n' \""'$dry_status" "$prove_status" "$warn_count" "$missing_hook_count" "$top_count" | tee -a /audit-output/evidence/12b-non-vacuity-final.log
if [ "$dry_status" -ne 0 ] || [ "$prove_status" -eq 0 ] || [ "$warn_count" -lt 1 ] || [ "$missing_hook_count" -ne 0 ] || [ "$top_count" -ne 0 ]; then exit 1; fi
exit 0' in /tmp/audit-work/proof
