kprove program-pinning.k --definition fresh-verification-kompiled --spec-module PROGRAM-PINNING 2>&1 | tee -a /audit-output/evidence/09-program-pinning.log
status="'${PIPESTATUS[0]}
top_count=$(awk '"'"'$0 == "#Top" {n += 1} END {print n+0}'"' /audit-output/evidence/09-program-pinning.log)
printf 'EXIT_STATUS=%s\\nTOP_LINES=%s\\n' \""'$status" "$top_count" | tee -a /audit-output/evidence/09-program-pinning.log
if [ "$status" -ne 0 ] || [ "$top_count" -lt 1 ]; then exit 1; fi' in /tmp/audit-work/proof
