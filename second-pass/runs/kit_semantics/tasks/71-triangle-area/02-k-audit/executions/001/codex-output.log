diff --git a//tmp/audit-work/proof/auditor-false-result.k b//tmp/audit-work/proof/auditor-false-result.k
new file mode 100644
index 0000000000000000000000000000000000000000..dbfe1a49cd7fc1ad07a8362c74316935d04b88e2
