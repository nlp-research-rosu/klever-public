--- /dev/null
+++ b/evidence/huge_integer_boundary.py
@@ -0,0 +1,19 @@
+import math
+
+
+def triangle_area(a, b, c):
+    if a + b <= c or a + c <= b or b + c <= a:
+        return -1
+
+    semi_perimeter = (a + b + c) / 2
+    area = math.sqrt(
+        semi_perimeter
+        * (semi_perimeter - a)
+        * (semi_perimeter - b)
+        * (semi_perimeter - c)
+    )
+    return round(area, 2)
+
+
+huge = 10 ** 309
+triangle_area(huge, huge, huge)
