+triangleProgram()

exec
/bin/bash -lc "cp -a auditor-body-sensitivity.k /audit-output/evidence/auditor-body-sensitivity.k
printf '%s\\n' 'MUTATION: constructor-level executed body changes invalid Return(-1) to Return(7); unchanged postcondition must reject it' 'COMMAND: kprove auditor-body-sensitivity.k --definition fresh-verification-kompiled --spec-module AUDITOR-BODY-SENSITIVITY --dry-run' 'COMMAND: kprove auditor-body-sensitivity.k --definition fresh-verification-kompiled --spec-module AUDITOR-BODY-SENSITIVITY' | tee /audit-output/evidence/13-body-sensitivity.log
kprove auditor-body-sensitivity.k --definition fresh-verification-kompiled --spec-module AUDITOR-BODY-SENSITIVITY --dry-run 2>&1 | tee -a /audit-output/evidence/13-body-sensitivity.log
dry_status="'${PIPESTATUS[0]}
kprove auditor-body-sensitivity.k --definition fresh-verification-kompiled --spec-module AUDITOR-BODY-SENSITIVITY 2>&1 | tee -a /audit-output/evidence/13-body-sensitivity.log
prove_status=${PIPESTATUS[0]}
warn_count=$(rg -n '"'WarnStuckClaimState' /audit-output/evidence/13-body-sensitivity.log | wc -l)
missing_hook_count="'$(rg -n '"'missing hook' /audit-output/evidence/13-body-sensitivity.log | wc -l)
top_count="'$(awk '"'"'$0 == "#Top" {n += 1} END {print n+0}'"' /audit-output/evidence/13-body-sensitivity.log)
printf 'DRY_RUN_EXIT=%s\\nPROOF_EXIT=%s\\nSTUCK_WARNINGS=%s\\nMISSING_HOOK_LINES=%s\\nTOP_LINES=%s\\n' \""'$dry_status" "$prove_status" "$warn_count" "$missing_hook_count" "$top_count" | tee -a /audit-output/evidence/13-body-sensitivity.log
if [ "$dry_status" -ne 0 ] || [ "$prove_status" -eq 0 ] || [ "$warn_count" -lt 1 ] || [ "$missing_hook_count" -ne 0 ] || [ "$top_count" -ne 0 ]; then exit 1; fi
exit 0' in /tmp/audit-work/proof
diff --git a//tmp/audit-work/proof/auditor-body-sensitivity.k b//tmp/audit-work/proof/auditor-body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..68cbb8ffd69600a8efebf4dbf291ce93a3df2925
--- /dev/null
+++ b//tmp/audit-work/proof/auditor-body-sensitivity.k
@@ -0,0 +1,59 @@
+requires "verification.k"
+
+module AUDITOR-BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // The executed constructor term itself is mutated: invalid return -1 -> 7.
+  claim [mutated-executed-body]:
+    <k>
+      #loadAll(
+        Module(
+          Import("math")
+          FuncDef("triangle_area", Params("a", "b", "c"),
+            If(BoolOp(
+              "or",
+              Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
+              Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
+              Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
+              Return(Int(7)),
+              .Stmts)
+            Assign(
+              Name("semi_perimeter"),
+              BinOp(
+                "/",
+                BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+                Int(2)))
+            Assign(
+              Name("area"),
+              Call(
+                Attribute(Name("math"), "sqrt"),
+                BinOp(
+                  "*",
+                  BinOp(
+                    "*",
+                    BinOp(
+                      "*",
+                      Name("semi_perimeter"),
+                      BinOp("-", Name("semi_perimeter"), Name("a"))),
+                    BinOp("-", Name("semi_perimeter"), Name("b"))),
+                  BinOp("-", Name("semi_perimeter"), Name("c")))))
+            Return(Call(Name("round"), Name("area"), Int(2)))))
+        )
+        ~> Call(Name("triangle_area"), (A:Int, B:Int, C:Int, .Exprs))
+      => triangleAreaSpec(A, B, C)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A +Int B <=Int C
+endmodule
