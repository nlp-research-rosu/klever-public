printf '%s\\n' 'PRECONDITION: trusted translator output was parsed by kast; its pretty form expands the trailing empty Stmts list to .Stmts' 'COMMAND: kprove program-pinning.k --definition fresh-verification-kompiled --spec-module PROGRAM-PINNING' | tee /audit-output/evidence/09b-program-pinning-final.log
