/bin/bash -lc 'krun nan-token-test.mpy --definition runtime-kompiled > nan-token-test.log 2>&1; status=$?; printf '"'EXIT %s\\n' \""'$status"; sed -n '"'1,30p' nan-token-test.log" in /workspace
