+    if a + b <= c or a + c <= b or b + c <= a:
+        return -1
+
+    semi_perimeter = (a + b + c) / 2
+    area = math.sqrt(
+        semi_perimeter
+        * (semi_perimeter - a)
+        * (semi_perimeter - b)
+        * (semi_perimeter - c)
+    )
+    return round(area, 2)
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..aa247d4316183105648e6eafd1ebcc58cdbeb429
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,59 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated invalid-triangle branch: return -2 instead of -1.
+  // The unchanged contract summary must reject this body.
+  claim [mutated-body]:
+    <k>
+      #loadAll(
+        Module(
+          Import("math")
+          FuncDef("triangle_area", Params("a", "b", "c"),
+            If(BoolOp(
+              "or",
+              Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
+              Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
+              Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
+              Return(UnaryOp("-", Int(2))),
+              .Stmts)
+            Assign(
+              Name("semi_perimeter"),
+              BinOp(
+                "/",
+                BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+                Int(2)))
+            Assign(
+              Name("area"),
+              Call(
+                Attribute(Name("math"), "sqrt"),
+                BinOp(
+                  "*",
+                  BinOp(
+                    "*",
+                    BinOp(
+                      "*",
+                      Name("semi_perimeter"),
+                      BinOp("-", Name("semi_perimeter"), Name("a"))),
+                    BinOp("-", Name("semi_perimeter"), Name("b"))),
+                  BinOp("-", Name("semi_perimeter"), Name("c")))))
+            Return(Call(Name("round"), Name("area"), Int(2)))))
+        )
+        ~> Call(Name("triangle_area"), (1, 2, 10, .Exprs))
+      => triangleAreaSpec(1, 2, 10)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
