+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated invalid-triangle branch: return -2 instead of -1.
+  // The unchanged contract summary must reject this body.
+  claim [mutated-body]:
+    <k>
+      #loadAll(
+        Module(
+          Import("math")
+          FuncDef("triangle_area", Params("a", "b", "c"),
+            If(BoolOp(
+              "or",
+              Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
+              Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
+              Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
+              Return(UnaryOp("-", Int(2))),
+              .Stmts)
+            Assign(
+              Name("semi_perimeter"),
+              BinOp(
+                "/",
+                BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+                Int(2)))
+            Assign(
+              Name("area"),
+              Call(
+                Attribute(Name("math"), "sqrt"),
+                BinOp(
+                  "*",
+                  BinOp(
+                    "*",
+                    BinOp(
+                      "*",
+                      Name("semi_perimeter"),
+                      BinOp("-", Name("semi_perimeter"), Name("a"))),
+                    BinOp("-", Name("semi_perimeter"), Name("b"))),
+                  BinOp("-", Name("semi_perimeter"), Name("c")))))
+            Return(Call(Name("round"), Name("area"), Int(2)))))
+        )
+        ~> Call(Name("triangle_area"), (A:Int, B:Int, C:Int, .Exprs))
+      => triangleAreaSpec(A, B, C)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A +Int B <=Int C
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..78f1abe46b513c5a2a9c2a567ba7bdf4e3bac4e6
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false on the satisfiable invalid-triangle domain
+  // A + B <= C (for example A=1, B=2, C=10): the result is -1, not -2.
+  claim [false-result]:
+    <k>
+      #loadAll(triangleProgram())
+        ~> Call(Name("triangle_area"), (A:Int, B:Int, C:Int, .Exprs))
+      => -2
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A +Int B <=Int C
+endmodule
