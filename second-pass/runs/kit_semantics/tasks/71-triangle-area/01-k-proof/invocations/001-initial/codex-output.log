diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..ff21d7d25fb2e4cfcbea3a8758a1bcf58a6515a6
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,22 @@
+import math
+
+
+def triangle_area(a, b, c):
+    if a + b <= c or a + c <= b or b + c <= a:
+        return -1
+
+    semi_perimeter = (a + b + c) / 2
+    area = math.sqrt(
+        semi_perimeter
+        * (semi_perimeter - a)
+        * (semi_perimeter - b)
+        * (semi_perimeter - c)
+    )
+    return round(area, 2)
+
+
+assert triangle_area(3, 4, 5) == 6.0
+assert triangle_area(1, 2, 10) == -1
+assert triangle_area(2, 2, 3) == 1.98
+assert triangle_area(2.5, 3, 4.0) == 3.75
+assert triangle_area(True, True, True) == 0.43
