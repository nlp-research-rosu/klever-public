The aggregate proof is still running normally; the command has not produced a failure or residual. The individual claims take several seconds each, so this duration is consistent with 27 symbolic domains rather than a divergence.
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..35554910fde50a6b3d3ba00e75e7f357e866f9d2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,15 @@
+import math
+
+
+def triangle_area(a, b, c):
+    if a + b <= c or a + c <= b or b + c <= a:
+        return -1
+
+    semi_perimeter = (a + b + c) / 2
+    area = math.sqrt(
+        semi_perimeter
+        * (semi_perimeter - a)
+        * (semi_perimeter - b)
+        * (semi_perimeter - c)
+    )
+    return round(area, 2)
