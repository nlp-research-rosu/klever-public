+    if a + b <= c or a + c <= b or b + c <= a:
+        return -1
+
+    semi_perimeter = (a + b + c) / 2
+    area = math.sqrt(
+        semi_perimeter
+        * (semi_perimeter - a)
+        * (semi_perimeter - b)
+        * (semi_perimeter - c)
+    )
+    return round(area, 2)
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
