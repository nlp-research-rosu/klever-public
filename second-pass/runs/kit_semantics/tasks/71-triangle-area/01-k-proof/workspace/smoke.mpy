Module(
  Import("math")
  FuncDef("triangle_area", Params("a", "b", "c"),
    If(BoolOp(
      "or",
      Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
      Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
      Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
      Return(UnaryOp("-", Int(1))),
      )
    Assign(
      Name("semi_perimeter"),
      BinOp(
        "/",
        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
        Int(2)))
    Assign(
      Name("area"),
      Call(
        Attribute(Name("math"), "sqrt"),
        BinOp(
          "*",
          BinOp(
            "*",
            BinOp(
              "*",
              Name("semi_perimeter"),
              BinOp("-", Name("semi_perimeter"), Name("a"))),
            BinOp("-", Name("semi_perimeter"), Name("b"))),
          BinOp("-", Name("semi_perimeter"), Name("c")))))
    Return(Call(Name("round"), Name("area"), Int(2))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(3), Int(4), Int(5)),
      CmpOp("==", Float(6.0))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(1), Int(2), Int(10)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(2), Int(2), Int(3)),
      CmpOp("==", Float(1.98))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Float(2.5), Int(3), Float(4.0)),
      CmpOp("==", Float(3.75))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Bool(true), Bool(true), Bool(true)),
      CmpOp("==", Float(0.43)))))
