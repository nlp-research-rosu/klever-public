     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Haskell kprove has no FLOAT.int2float hook.  MPY intentionally treats
     7	  // intToF as an opaque proof-domain primitive, but its [concrete] twin is
     8	  // nevertheless selected by the backend for mixed symbolic arithmetic.
     9	  // Reify that existing trust boundary as a constructor in proof definitions.
    10	  // The input remains visible, so claims are parametric in the conversion.
    11	  syntax Float ::= proofIntToF(Int)
    12	    [function, total, symbol(proofIntToF), no-evaluators]
    13	  rule intToF(I:Int) => proofIntToF(I) [simplification]
    14	
    15	  // Exact quotation of solution.mpy.  This is data consumed by the fixed
    16	  // #loadAll/definition/call semantics; it does not summarize execution.
    17	  syntax Module ::= triangleProgram() [function, total]
    18	  rule triangleProgram() =>
    19	    Module(
    20	      Import("math")
    21	      FuncDef("triangle_area", Params("a", "b", "c"),
    22	        If(BoolOp(
    23	          "or",
    24	          Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
    25	          Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
    26	          Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
    27	          Return(UnaryOp("-", Int(1))),
    28	          .Stmts)
    29	        Assign(
    30	          Name("semi_perimeter"),
    31	          BinOp(
    32	            "/",
    33	            BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
    34	            Int(2)))
    35	        Assign(
    36	          Name("area"),
    37	          Call(
    38	            Attribute(Name("math"), "sqrt"),
    39	            BinOp(
    40	              "*",
    41	              BinOp(
    42	                "*",
    43	                BinOp(
    44	                  "*",
    45	                  Name("semi_perimeter"),
    46	                  BinOp("-", Name("semi_perimeter"), Name("a"))),
    47	                BinOp("-", Name("semi_perimeter"), Name("b"))),
    48	              BinOp("-", Name("semi_perimeter"), Name("c")))))
    49	        Return(Call(Name("round"), Name("area"), Int(2)))))
    50	
    51	  // Contract-level summaries.  Each equation merely names the value of the
    52	  // validity predicate or Heron expression using fixed MPY operators.
    53	  syntax Bool ::= invalidTriangle(Val, Val, Val) [function, total]
    54	  rule invalidTriangle(A, B, C) =>
    55	       applyCmp("<=", applyBin("+", A, B), C)
    56	    orBool applyCmp("<=", applyBin("+", A, C), B)
    57	    orBool applyCmp("<=", applyBin("+", B, C), A)
    58	
    59	  syntax Val ::= semiPerimeter(Val, Val, Val) [function, total]
    60	  rule semiPerimeter(A, B, C) =>
    61	    applyBin("/", applyBin("+", applyBin("+", A, B), C), 2)
    62	
    63	  syntax Val ::= heronProduct(Val, Val, Val) [function, total]
    64	  rule heronProduct(A, B, C) =>
    65	    applyBin(
    66	      "*",
    67	      applyBin(
    68	        "*",
    69	        applyBin(
    70	          "*",
    71	          semiPerimeter(A, B, C),
    72	          applyBin("-", semiPerimeter(A, B, C), A)),
    73	        applyBin("-", semiPerimeter(A, B, C), B)),
    74	      applyBin("-", semiPerimeter(A, B, C), C))
    75	
    76	  syntax Val ::= triangleAreaSpec(Val, Val, Val) [function, total]
    77	  rule triangleAreaSpec(A, B, C) =>
    78	    #if invalidTriangle(A, B, C)
    79	    #then -1
    80	    #else applyBuiltin(
    81	            "round",
    82	            sqrtF({heronProduct(A, B, C)}:>Float),
    83	            (2, .Vals))
    84	    #fi
    85	endmodule
