/reference/k-proof/reference-semantics/semantics/tuple.k-24-  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]
/reference/k-proof/reference-semantics/semantics/tuple.k-25-  rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V
/reference/k-proof/reference-semantics/semantics/tuple.k-26-  rule idxOfVS(vCons(A:Val, R:ValSeq), V:Val, I:Int) => idxOfVS(R, V, I +Int 1)
/reference/k-proof/reference-semantics/semantics/tuple.k-27-       requires notBool (A ==K V)
/reference/k-proof/reference-semantics/semantics/tuple.k:28:  rule applyCmp("!=", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)
/reference/k-proof/reference-semantics/semantics/tuple.k-29-
/reference/k-proof/reference-semantics/semantics/tuple.k-30-  // ==== target binding: bind a Name or a TupleExpr target to a value ========
/reference/k-proof/reference-semantics/semantics/tuple.k-31-  syntax KItem ::= #bindTgt(Expr, Val)
/reference/k-proof/reference-semantics/semantics/tuple.k-32-  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
