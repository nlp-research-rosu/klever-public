/reference/k-proof/reference-semantics/semantics/tuple.k-14-  syntax ApplyK ::= "toTuple"
/reference/k-proof/reference-semantics/semantics/tuple.k-15-  rule <k> TupleExpr(ES:Exprs) => #evalArgs(ES, .Vals, toTuple) ... </k>
/reference/k-proof/reference-semantics/semantics/tuple.k-16-  rule <k> #applyK(toTuple, ACC:Vals) => tuple(vals2valSeq(ACC)) ... </k>
/reference/k-proof/reference-semantics/semantics/tuple.k-17-
/reference/k-proof/reference-semantics/semantics/tuple.k:18:  rule applyCmp("==", tuple(A:ValSeq), tuple(B:ValSeq)) => A ==K B
/reference/k-proof/reference-semantics/semantics/tuple.k-19-  // membership routes through the same k-cell fold as lists (list.k)
/reference/k-proof/reference-semantics/semantics/tuple.k-20-  rule <k> Compare(LV:Val, CmpOp("in",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>
/reference/k-proof/reference-semantics/semantics/tuple.k-21-  rule <k> Compare(LV:Val, CmpOp("not in", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>
/reference/k-proof/reference-semantics/semantics/tuple.k-22-  // t.index(v): first index of v (ValueError out of subset)
