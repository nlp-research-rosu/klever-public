     7	
     8	/*
     9	 * Lean 4.22 resolves its installation via /proc/<own-pid>/exe.  The benchmark
    10	 * sandbox permits the equivalent /proc/self/exe path but denies the numeric
    11	 * spelling, so translate only that spelling before issuing the same readlink
    12	 * system call.
    13	 */
    14	ssize_t readlink(const char *path, char *buffer, size_t size) {
    15	  const char *cursor = path;
    16	
    17	  if (strncmp(cursor, "/proc/", 6) == 0) {
    18	    cursor += 6;
    19	    while (isdigit((unsigned char)*cursor)) {
    20	      ++cursor;
    21	    }
    22	    if (cursor != path + 6 && strcmp(cursor, "/exe") == 0) {
    23	      path = "/proc/self/exe";
    24	    }
    25	  }
    26	
    27	  return syscall(SYS_readlink, path, buffer, size);
    28	}
