MPY_SMOKE
     1	Module(
     2	  Import("math")
     3	  FuncDef("triangle_area", Params("a", "b", "c"),
     4	    If(BoolOp(
     5	      "or",
     6	      Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
     7	      Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
     8	      Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
     9	      Return(UnaryOp("-", Int(1))),
    10	      )
    11	    Assign(
    12	      Name("semi_perimeter"),
    13	      BinOp(
    14	        "/",
    15	        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
    16	        Int(2)))
    17	    Assign(
    18	      Name("area"),
    19	      Call(
    20	        Attribute(Name("math"), "sqrt"),
    21	        BinOp(
    22	          "*",
    23	          BinOp(
    24	            "*",
    25	            BinOp(
    26	              "*",
    27	              Name("semi_perimeter"),
    28	              BinOp("-", Name("semi_perimeter"), Name("a"))),
    29	            BinOp("-", Name("semi_perimeter"), Name("b"))),
    30	          BinOp("-", Name("semi_perimeter"), Name("c")))))
    31	    Return(Call(Name("round"), Name("area"), Int(2))))
    32	  Assert(
    33	    Compare(
    34	      Call(Name("triangle_area"), Int(3), Int(4), Int(5)),
    35	      CmpOp("==", Float(6.0))))
    36	  Assert(
    37	    Compare(
    38	      Call(Name("triangle_area"), Int(1), Int(2), Int(10)),
    39	      CmpOp("==", UnaryOp("-", Int(1)))))
    40	  Assert(
    41	    Compare(
    42	      Call(Name("triangle_area"), Int(2), Int(2), Int(3)),
    43	      CmpOp("==", Float(1.98))))
    44	  Assert(
    45	    Compare(
    46	      Call(Name("triangle_area"), Float(2.5), Int(3), Float(4.0)),
    47	      CmpOp("==", Float(3.75))))
    48	  Assert(
    49	    Compare(
    50	      Call(Name("triangle_area"), Bool(true), Bool(true), Bool(true)),
    51	      CmpOp("==", Float(0.43)))))
MPY_PY_TRANSLATION
     1	import math
     2	
     3	
     4	def triangle_area(a, b, c):
     5	    if a + b <= c or a + c <= b or b + c <= a:
     6	        return -1
     7	
     8	    semi_perimeter = (a + b + c) / 2
     9	    area = math.sqrt(
    10	        semi_perimeter
    11	        * (semi_perimeter - a)
    12	        * (semi_perimeter - b)
    13	        * (semi_perimeter - c)
    14	    )
    15	    return round(area, 2)
    16	
    17	
    18	assert triangle_area(3, 4, 5) == 6.0
    19	assert triangle_area(1, 2, 10) == -1
    20	assert triangle_area(2, 2, 3) == 1.98
    21	assert triangle_area(2.5, 3, 4.0) == 3.75
    22	assert triangle_area(True, True, True) == 0.43
