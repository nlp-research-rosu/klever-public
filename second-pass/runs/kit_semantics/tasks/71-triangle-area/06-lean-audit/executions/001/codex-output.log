SOLUTION_PY
     1	import math
     2	
     3	
     4	def triangle_area(a, b, c):
     5	    if a + b <= c or a + c <= b or b + c <= a:
     6	        return -1
     7	
     8	    semi_perimeter = (a + b + c) / 2
     9	    area = math.sqrt(
    10	        semi_perimeter
    11	        * (semi_perimeter - a)
    12	        * (semi_perimeter - b)
    13	        * (semi_perimeter - c)
    14	    )
    15	    return round(area, 2)
SOLUTION_MPY
     1	Module(
     2	  Import("math")
     3	  FuncDef("triangle_area", Params("a", "b", "c"),
     4	    If(BoolOp(
     5	      "or",
     6	      Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
     7	      Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
     8	      Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
     9	      Return(UnaryOp("-", Int(1))),
    10	      )
    11	    Assign(
    12	      Name("semi_perimeter"),
    13	      BinOp(
    14	        "/",
    15	        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
    16	        Int(2)))
    17	    Assign(
    18	      Name("area"),
    19	      Call(
    20	        Attribute(Name("math"), "sqrt"),
    21	        BinOp(
    22	          "*",
    23	          BinOp(
    24	            "*",
    25	            BinOp(
    26	              "*",
    27	              Name("semi_perimeter"),
    28	              BinOp("-", Name("semi_perimeter"), Name("a"))),
    29	            BinOp("-", Name("semi_perimeter"), Name("b"))),
    30	          BinOp("-", Name("semi_perimeter"), Name("c")))))
    31	    Return(Call(Name("round"), Name("area"), Int(2)))))
PROVE_SH
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 -m py_compile solution.py
     6	python3 test_solution.py
     7	python3 check_artifacts.py
     8	
     9	kompile reference-semantics/semantics.k \
    10	  --backend llvm \
    11	  --main-module MPY-KRUN \
    12	  --syntax-module MPY-SYNTAX \
    13	  --output-definition runtime-kompiled
    14	
    15	python3 py2mpy.py smoke.py > smoke.mpy
    16	krun smoke.mpy --definition runtime-kompiled | tee krun-smoke.log
    17	
    18	python3 model-boundary.py | tee model-boundary-python.log
    19	krun model-boundary.mpy --definition runtime-kompiled \
    20	  | tee model-boundary-krun.log
    21	
    22	kompile --backend haskell verification.k \
    23	  --main-module VERIFICATION \
    24	  --syntax-module MPY-SYNTAX \
    25	  --output-definition verification-kompiled
    26	
    27	kprove spec.k \
    28	  --definition verification-kompiled \
    29	  --spec-module SPEC \
    30	  2>&1 | tee kprove-all.log
    31	grep -q '^#Top$' kprove-all.log
    32	
    33	if kprove spec-vacuity.k \
    34	     --definition verification-kompiled \
    35	     --spec-module SPEC-VACUITY \
    36	     > kprove-vacuity.log 2>&1; then
    37	  echo "ERROR: false-postcondition mutation unexpectedly proved" >&2
    38	  exit 1
    39	fi
    40	grep -q 'WarnStuckClaimState' kprove-vacuity.log
    41	! grep -q 'missing hook' kprove-vacuity.log
    42	echo "EXPECTED FAILURE: false-postcondition mutation"
    43	
    44	if kprove spec-body-mutation.k \
    45	     --definition verification-kompiled \
    46	     --spec-module SPEC-BODY-MUTATION \
    47	     > kprove-body-mutation.log 2>&1; then
    48	  echo "ERROR: mutated body unexpectedly proved" >&2
    49	  exit 1
    50	fi
    51	grep -q 'WarnStuckClaimState' kprove-body-mutation.log
    52	! grep -q 'missing hook' kprove-body-mutation.log
    53	echo "EXPECTED FAILURE: body mutation"
