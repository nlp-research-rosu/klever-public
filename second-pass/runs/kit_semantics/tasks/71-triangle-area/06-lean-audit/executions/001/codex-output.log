/reference/k-proof/reference-semantics/semantics/builtins.k-95-
/reference/k-proof/reference-semantics/semantics/builtins.k-96-  // ---- general Val branch of the max/min folds (v3) ------------------------
/reference/k-proof/reference-semantics/semantics/builtins.k-97-  // The Int fold above and the Float fold (float.k) cover homogeneous lists; the
/reference/k-proof/reference-semantics/semantics/builtins.k-98-  // remaining CPython-orderable seeds (Bool, str) and every cross-sort step land
/reference/k-proof/reference-semantics/semantics/builtins.k:99:  // here. Ordering reuses the semantics' OWN applyCmp dispatch (int.k; float.k's
/reference/k-proof/reference-semantics/semantics/builtins.k-100-  // exact ltIF/ltFI bridges; bool.k's bool->int promotion; str.k's strLt), so
/reference/k-proof/reference-semantics/semantics/builtins.k:101:  // mixed comparisons stay bit-exact with CPython; a pair applyCmp does not
/reference/k-proof/reference-semantics/semantics/builtins.k-102-  // order (e.g. int vs str) leaves the fold stuck (unmodeled TypeError).
/reference/k-proof/reference-semantics/semantics/builtins.k-103-  // Strict > (resp. <) replacement keeps the FIRST maximal (minimal) element —
/reference/k-proof/reference-semantics/semantics/builtins.k-104-  // CPython's tie rule.
/reference/k-proof/reference-semantics/semantics/builtins.k-105-  syntax KItem ::= #maxAccV(Iterable, Val) | #maxContV(Val)
--
/reference/k-proof/reference-semantics/semantics/builtins.k-110-       requires isFloat(V) orBool isBool(V)
/reference/k-proof/reference-semantics/semantics/builtins.k-111-  rule <k> #maxAccV(IT:Iterable, M:Val) => #iterNext(IT) ~> #maxContV(M) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k-112-  rule <k> #iterDone ~> #maxContV(M:Val) => M ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k-113-  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContV(M:Val) => #maxAccV(R, V) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:114:       requires applyCmp(">", V, M)
/reference/k-proof/reference-semantics/semantics/builtins.k-115-  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContV(M:Val) => #maxAccV(R, M) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:116:       requires notBool applyCmp(">", V, M)
/reference/k-proof/reference-semantics/semantics/builtins.k-117-
