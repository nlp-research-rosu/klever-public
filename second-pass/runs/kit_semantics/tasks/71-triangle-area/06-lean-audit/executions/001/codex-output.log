   193	  // ---- float(str): decimal parse (promoted from 137's defined chain) ----
   194	  // digits '.' digits, optional leading '-'; concrete evaluation only (the
   195	  // symbolic side stays an opaque decStrToF term a proof case-splits on).
   196	  syntax Float ::= decStrToF(IntSeq) [function, total, symbol(decStrToF), no-evaluators]
   197	  rule decStrToF(iCons(45, CS:IntSeq)) => 0.0 -Float decStrToF(CS) [concrete]
   198	  rule decStrToF(CS:IntSeq)
   199	    => intToF(intPart(CS)) +Float (intToF(fracPart(CS)) /Float intToF(fracScale(CS)))
   200	       requires isLen(CS) >Int 0 andBool headIS(CS) =/=Int 45 [concrete]
   201	  syntax Int ::= headIS(IntSeq) [function]
   202	  rule headIS(iCons(C:Int, _:IntSeq)) => C
   203	  syntax Int ::= intPart(IntSeq) [function, total] | intPartAcc(IntSeq, Int) [function, total]
   204	  rule intPart(CS:IntSeq) => intPartAcc(CS, 0)
   205	  rule intPartAcc(.IntSeq, A:Int) => A
   206	  rule intPartAcc(iCons(46, _:IntSeq), A:Int) => A
   207	  rule intPartAcc(iCons(C:Int, R:IntSeq), A:Int) => intPartAcc(R, A *Int 10 +Int (C -Int 48))
   208	       requires C =/=Int 46
   209	  syntax Int ::= fracPart(IntSeq) [function, total] | fracAcc(IntSeq, Int) [function, total]
   210	  rule fracPart(.IntSeq) => 0
   211	  rule fracPart(iCons(46, R:IntSeq)) => fracAcc(R, 0)
   212	  rule fracPart(iCons(C:Int, R:IntSeq)) => fracPart(R) requires C =/=Int 46
   213	  rule fracAcc(.IntSeq, A:Int) => A
   214	  rule fracAcc(iCons(C:Int, R:IntSeq), A:Int) => fracAcc(R, A *Int 10 +Int (C -Int 48))
   215	  syntax Int ::= fracScale(IntSeq) [function, total] | fscAcc(IntSeq, Int) [function, total]
   216	  rule fracScale(.IntSeq) => 1
   217	  rule fracScale(iCons(46, R:IntSeq)) => fscAcc(R, 1)
   218	  rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46
   219	  rule fscAcc(.IntSeq, A:Int) => A
   220	  rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)
   221	  rule applyBuiltin("float", str(CS:IntSeq), .Vals) => decStrToF(CS)
   222	  rule applyBuiltin("float", I:Int, .Vals)          => intToF(I)
   223	  rule applyBuiltin("float", F:Float, .Vals)        => F
   224	
   225	  // ---- float / int division (promoted from mean_absolute_deviation) ----
   226	  syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]
   227	  rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]
   228	  rule applyBin("/", F:Float, I:Int) => divFloatIntV(F, I)
   229	
   230	  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----
   231	  syntax Float ::= intToF(Int) [function, total, symbol(intToF), no-evaluators]
   232	  rule intToF(I:Int) => Int2Float(I, 53, 11) [concrete]
   233	  rule applyBin("+", I:Int, F:Float) => addF(intToF(I), F)
   234	  rule applyBin("+", F:Float, I:Int) => addF(F, intToF(I))
   235	  rule applyBin("-", I:Int, F:Float) => subF(intToF(I), F)
   236	  rule applyBin("-", F:Float, I:Int) => subF(F, intToF(I))
   237	  rule applyBin("*", I:Int, F:Float) => mulF(intToF(I), F)
   238	  rule applyBin("*", F:Float, I:Int) => mulF(F, intToF(I))
   239	  // (mixed Int/Float comparison is defined exactly above via ltIF/ltFI/eqIF;
   240	  //  the former floatLt(intToF(...)) duplicates were removed for exactness.)
   241	
   242	  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----
   243	  syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]
   244	  rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]
   245	  rule applyBuiltin("int", F:Float, .Vals) => truncF(F)
   246	
   247	  rule applyBuiltin("float", I:Int, .Vals)   => intToF(I)
   248	  rule applyBuiltin("float", F:Float, .Vals) => F
   249	
   250	  // round: Python half-even (banker's); round(F, N) scales by 10^N
   251	  syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]
   252	  rule roundF(F:Float)
   253	    => #if (F -Float floorFloat(F)) ==Float 0.5
   254	       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
   255	              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
   256	       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
   257	  // round(F, N): CPython rounds the EXACT binary value of F at the Nth decimal
   258	  // place, half-to-even, then converts to the nearest double. The old code did
   259	  // Int2Float(roundF(F *Float 10^N)) / 10^N — the float multiply F *Float 10^N
   260	  // misrounds the half-way decision (witness: a Heron triangle area that must
   261	  // round to 2.69 came out 2.68). Exact version, via arbitrary-precision integers:
   262	  //     F = numer / 2^k      numer = Float2Int(F * 2^(52-e)),  k = 52 - exponentFloat(F)
   263	  //     q = round-half-even( numer * 10^N , 2^k )        (exact big-integer round)
   264	  //     result = nearest double to q / 10^N
   265	  //   IEEE division is correctly rounded, so (double)q /Float (double)10^N equals
   266	  //   the nearest double to q/10^N whenever q and 10^N are exactly representable.
   267	  // Guarded to finite F with |F| < 1e12 and |F|*10^N < 2^52 (keeps numer and q
   268	  // exactly representable) and a non-subnormal exponent (avoids 2^k overflowing a
   269	  // double); the exotic tail keeps the old path, so nothing regresses.
   270	  // Opaque for kprove, [concrete] for krun.
   271	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   272	  rule roundFN(F:Float, N:Int) => roundExactFN(F, N)
   273	       requires notBool isNaN(F) andBool notBool isInfinite(F) andBool N >=Int 0
   274	        andBool absFloat(F) <Float 1000000000000.0
   275	        andBool (absFloat(F) *Float Int2Float(10 ^Int N, 53, 11)) <Float 4500000000000000.0
   276	        andBool exponentFloat(F) >Int -900 [concrete]
   277	  rule roundFN(F:Float, N:Int)
   278	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   279	       /Float Int2Float(10 ^Int N, 53, 11) [owise, concrete]
   280	
   281	  syntax Float ::= roundExactFN(Float, Int) [function]
   282	  rule roundExactFN(F:Float, N:Int)
   283	    => rheToFloat(rndHalfEven(rExNumer(F) *Int (10 ^Int N), rExDenom(F)), 10 ^Int N, F) [concrete]
   284	
   285	  // exact fraction of a finite in-range float:  F = rExNumer(F) / rExDenom(F),
   286	  // rExDenom(F) = 2^k, k = 52 - exponentFloat(F) >= 0 within the guard above.
   287	  syntax Int ::= rExK(Float) [function]
   288	  rule rExK(F:Float) => 52 -Int exponentFloat(F) [concrete]
   289	  syntax Int ::= rExNumer(Float) [function]
   290	  rule rExNumer(F:Float) => Float2Int(F *Float Int2Float(2 ^Int rExK(F), 53, 11)) [concrete]
   291	  syntax Int ::= rExDenom(Float) [function]
   292	  rule rExDenom(F:Float) => 2 ^Int rExK(F) [concrete]
   293	
   294	  // round-half-even of A/B (B > 0), to the nearest integer, ties to even.
   295	  // divInt/modInt are Euclidean (B>0 => remainder in [0,B)) — i.e. floored here.
   296	  syntax Int ::= rndHalfEven(Int, Int) [function]
   297	  rule rndHalfEven(A:Int, B:Int) => rndHE(A divInt B, A modInt B, B) [concrete]
   298	  syntax Int ::= rndHE(Int, Int, Int) [function]
   299	  rule rndHE(Q:Int, R:Int, B:Int) => Q        requires 2 *Int R <Int B [concrete]
   300	  rule rndHE(Q:Int, R:Int, B:Int) => Q +Int 1 requires 2 *Int R >Int B [concrete]
   301	  rule rndHE(Q:Int, R:Int, B:Int) => Q        requires 2 *Int R ==Int B andBool Q modInt 2 ==Int 0 [concrete]
   302	  rule rndHE(Q:Int, R:Int, B:Int) => Q +Int 1 requires 2 *Int R ==Int B andBool Q modInt 2 =/=Int 0 [concrete]
   303	
   304	  // q / 10^N as the nearest double; preserve Python's signed zero when q == 0.
   305	  syntax Float ::= rheToFloat(Int, Int, Float) [function]
   306	  rule rheToFloat(0, _:Int, F:Float) => #if signFloat(F) #then --Float 0.0 #else 0.0 #fi [concrete]
   307	  rule rheToFloat(Q:Int, SCALE:Int, _:Float)
   308	    => Int2Float(Q, 53, 11) /Float Int2Float(SCALE, 53, 11) requires Q =/=Int 0 [concrete]
   309	
   310	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   311	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   312	
   313	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   314	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   315	  syntax KItem ::= "#mathSqrt"
   316	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   317	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   318	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   319	
   320	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   321	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   322	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   323	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   324	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   325	  // the isFloat guard is disjoint from the existing isInt one.
   326	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   327	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   328	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   329	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   330	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   331	       requires isFloat(V)
   332	
   333	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   334	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   335	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   336	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   337	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   338	       requires isFloat(V)
   339	
   340	  // cross-sort steps (v3): an Int/Bool yield hands the Float-seeded fold to the
   341	  // general Val fold (builtins.k), which compares through the same applyCmp
   342	  // dispatch (the exact ltIF/ltFI bridges + the bool promotion above) — mixed
   343	  // lists like [2.5, 1]. Guards are disjoint from the isFloat steps above.
   344	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float)
   345	        => #iterYield(V, R) ~> #maxContV(M) ... </k>
   346	       requires isInt(V) orBool isBool(V)
   347	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float)
   348	        => #iterYield(V, R) ~> #minContV(M) ... </k>
   349	       requires isInt(V) orBool isBool(V)
   350	
   351	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   352	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   353	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   354	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   355	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   356	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   357	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   358	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   359	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   360	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   361	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   362	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   363	       requires isFloat(V)
   364	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   365	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   366	       requires isInt(V) orBool isBool(V)
   367	endmodule
CONCRETE_RELEVANT
     1	// reference/src/semantics/concrete.k — MPY-CONCRETE
     2	// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
     3	// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
     4	// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
     5	// backend ([concrete] is not respected on rewrite rules) — probed on
     6	// 26-remove-duplicates, where element compares branched into deepEqVS.
     7	
     8	module MPY-CONCRETE
     9	  imports MPY
    10	
    11	  // deep equality for list compares whose elements are heap objects
    12	  // (list-of-lists): Python == is structural at every depth.
    13	  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
    14	       <heap> HP:Map </heap>
    15	       requires hasRefVS(A) orBool hasRefVS(B)
    16	  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
    17	       <heap> HP:Map </heap>
    18	       requires hasRefVS(A) orBool hasRefVS(B)
    19	
    20	  // ==== keyed sort, concrete leg ============================================
    21	  // Computes each key by a REAL call through the uniform #callee machinery
    22	  // (closures, len, type objects all work), stable-inserts on the key, and
    23	  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
    24	  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
    25	  syntax Val ::= kvP(Val, Val)
    26	  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
    27	                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
    28	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    29	        => #ksort(VS, KV, .ValSeq, false) ... </k>
    30	       [priority(40)]
    31	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    32	        => #ksort(VS, KV, .ValSeq, RB) ... </k>
    33	       [priority(40)]
    34	  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
    35	        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
    36	  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
    37	        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
    38	  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
    39	        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
    40	       requires notBool isKwV(K)
    41	
    42	  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
    43	  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
    44	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    45	    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
    46	       requires kLt(K, K2)
    47	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    48	    => vCons(kvP(K2, V2), insPair(R, K, V))
    49	       requires notBool kLt(K, K2)
    50	
    51	  syntax Bool ::= kLt(Val, Val) [function]
    52	  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
    53	  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
    54	  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    55	  // v3: mixed Int/Float keys via the exact v2 bridges (float.k), bool keys by
    56	  // the bool->int promotion (True==1, False==0). Unordered pairs (int vs str)
    57	  // stay without a leg — stuck, like CPython's TypeError.
    58	  rule kLt(I:Int, F:Float)   => ltIF(I, F)
    59	  rule kLt(F:Float, I:Int)   => ltFI(F, I)
    60	  rule kLt(B:Bool, V:Val)    => kLt(boolAsInt(B), V) requires isInt(V) orBool isFloat(V)
    61	  rule kLt(V:Val, B:Bool)    => kLt(V, boolAsInt(B)) requires isInt(V) orBool isFloat(V)
    62	  rule kLt(B1:Bool, B2:Bool) => boolAsInt(B1) <Int boolAsInt(B2)
    63	
    64	  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
    65	  rule unpairVS(.ValSeq) => .ValSeq
    66	  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
    67	  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
    68	
    69	  // ==== non-keyed reverse sorted(), concrete leg (v3) =======================
    70	  // sort.k's condRev(sortVS(VS), true) reverses equal-key runs — invisible on
    71	  // the all-Int / all-str lists sortVS used to accept, visible once sortVS
    72	  // orders mixed numerics (CPython keeps FIRST-seen order among equal keys
    73	  // under reverse=True). rev-in/rev-out over the same stable ascending sortVS
    74	  // is exactly CPython's stable descending sort, and is output-identical on the
    75	  // old homogeneous domains. krun-only (priority 40; proofs keep sort.k's
    76	  // condRev(sortVS(VS), RB) term unchanged).
    77	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("reverse", true), .Vals))
    78	        => #alloc(list(revVS(sortVS(revVS(VS))))) ... </k>
    79	       [priority(40)]
    80	
    81	  // ==== numeric cross-type membership (Python: 1 == True == 1.0) =============
    82	  // `x in list` / `x not in list` compare elements with ==K in list.k, which does
    83	  // NOT collapse across the numeric types (true =/=K 1, 1 =/=K 1.0). Under krun,
    84	  // override the membership fold with a numeric-aware equality so `in` and
    85	  // unique()-style dedup behave like CPython for mixed int/bool/float elements.
    86	  // (set.k needs no change: setV holds int char codes, compared with ==Int, so a
    87	  // cross-type ==K collapse never arises there.)
    88	  // krun-only (priority 40 beats list.k's default rules); kprove uses the
    89	  // structural ==K rules in list.k unchanged.
    90	  syntax Bool ::= numOrKEq(Val, Val) [function]
    91	  rule numOrKEq(A:Val, B:Val) => applyCmp("==", A, B)
    92	       requires (isInt(A) orBool isBool(A) orBool isFloat(A))
    93	        andBool (isInt(B) orBool isBool(B) orBool isFloat(B))
    94	  rule numOrKEq(A:Val, B:Val) => A ==K B [owise]
    95	
    96	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    97	       requires numOrKEq(E, V) [priority(40)]
    98	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    99	       requires notBool numOrKEq(E, V) [priority(40)]
   100	endmodule
