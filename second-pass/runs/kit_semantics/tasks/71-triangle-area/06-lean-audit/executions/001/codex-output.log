+import Proof
+
+open Proof
+
+def showConversion (label : String) (value : Int) : IO Unit := do
+  let fromInt := intToF value
+  let fromProof := proofIntToF value
+  IO.println s!"{label}: intToF={fromInt.toBits} proofIntToF={fromProof.toBits} equal={fromInt == fromProof}"
+
+def main : IO Unit := do
+  showConversion "zero" 0
+  showConversion "one" 1
+  showConversion "minus-one" (-1)
+  showConversion "2^53-1" 9007199254740991
+  showConversion "2^53" 9007199254740992
+  showConversion "2^53+1" 9007199254740993
+  showConversion "2^53+3" 9007199254740995
+  showConversion "-(2^53+1)" (-9007199254740993)
+  showConversion "2^1023" ((2 : Int) ^ 1023)
+  showConversion "2^1024" ((2 : Int) ^ 1024)
