index 0000000000000000000000000000000000000000..dde36ae53914c542df99045fe049d60c8dfd7cfb
--- /dev/null
+++ b//tmp/audit-work/lean-readlink-shim.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox permits /proc/self/exe but denies /proc/<pid>/exe.
+ * Lean 4.22 uses the numeric spelling to locate its installation.
+ * Translate only the current-process executable link spelling.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  const char *cursor = path;
+
+  if (strncmp(cursor, "/proc/", 6) == 0) {
+    cursor += 6;
+    while (isdigit((unsigned char)*cursor)) {
+      ++cursor;
+    }
+    if (cursor != path + 6 && strcmp(cursor, "/exe") == 0) {
+      path = "/proc/self/exe";
+    }
+  }
+
+  return syscall(SYS_readlink, path, buffer, size);
+}

