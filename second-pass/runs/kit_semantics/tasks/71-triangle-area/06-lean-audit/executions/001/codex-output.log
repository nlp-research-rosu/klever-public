/reference/k-proof/reference-semantics/semantics/builtins.k-123-       requires isFloat(V) orBool isBool(V)
/reference/k-proof/reference-semantics/semantics/builtins.k-124-  rule <k> #minAccV(IT:Iterable, M:Val) => #iterNext(IT) ~> #minContV(M) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k-125-  rule <k> #iterDone ~> #minContV(M:Val) => M ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k-126-  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContV(M:Val) => #minAccV(R, V) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:127:       requires applyCmp("<", V, M)
/reference/k-proof/reference-semantics/semantics/builtins.k-128-  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContV(M:Val) => #minAccV(R, M) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:129:       requires notBool applyCmp("<", V, M)
/reference/k-proof/reference-semantics/semantics/builtins.k-130-
/reference/k-proof/reference-semantics/semantics/builtins.k-131-  // ==== variadic max / min (a Vals fold) ====================================
/reference/k-proof/reference-semantics/semantics/builtins.k:132:  // v3: Val operands (mixed int/float/bool, str) via the same applyCmp
/reference/k-proof/reference-semantics/semantics/builtins.k-133-  // dispatch; strict > / < keeps the FIRST maximal/minimal operand (CPython's
/reference/k-proof/reference-semantics/semantics/builtins.k-134-  // tie rule — and exactly the old maxInt/minInt fold on the all-Int domain).
/reference/k-proof/reference-semantics/semantics/builtins.k-135-  syntax Val ::= maxVals(Val, Vals) [function]
/reference/k-proof/reference-semantics/semantics/builtins.k-136-  rule applyBuiltin("max", I:Int, REST:Vals) => maxVals(I, REST)
/reference/k-proof/reference-semantics/semantics/builtins.k-137-  rule applyBuiltin("max", V:Val, (V2:Val, REST:Vals)) => maxVals(V, (V2, REST))
/reference/k-proof/reference-semantics/semantics/builtins.k-138-       requires isFloat(V) orBool isBool(V) orBool isStr(V)
/reference/k-proof/reference-semantics/semantics/builtins.k-139-  rule maxVals(M:Val, .Vals)           => M
/reference/k-proof/reference-semantics/semantics/builtins.k:140:  rule maxVals(M:Val, (V:Val, R:Vals)) => maxVals(V, R) requires applyCmp(">", V, M)
/reference/k-proof/reference-semantics/semantics/builtins.k:141:  rule maxVals(M:Val, (V:Val, R:Vals)) => maxVals(M, R) requires notBool applyCmp(">", V, M)
/reference/k-proof/reference-semantics/semantics/builtins.k-142-
/reference/k-proof/reference-semantics/semantics/builtins.k-143-  syntax Val ::= minVals(Val, Vals) [function]
/reference/k-proof/reference-semantics/semantics/builtins.k-144-  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
/reference/k-proof/reference-semantics/semantics/builtins.k-145-  rule applyBuiltin("min", V:Val, (V2:Val, REST:Vals)) => minVals(V, (V2, REST))
/reference/k-proof/reference-semantics/semantics/builtins.k-146-       requires isFloat(V) orBool isBool(V) orBool isStr(V)
/reference/k-proof/reference-semantics/semantics/builtins.k-147-  rule minVals(M:Val, .Vals)           => M
/reference/k-proof/reference-semantics/semantics/builtins.k:148:  rule minVals(M:Val, (V:Val, R:Vals)) => minVals(V, R) requires applyCmp("<", V, M)
/reference/k-proof/reference-semantics/semantics/builtins.k:149:  rule minVals(M:Val, (V:Val, R:Vals)) => minVals(M, R) requires notBool applyCmp("<", V, M)
/reference/k-proof/reference-semantics/semantics/builtins.k-150-
