/reference/k-proof/reference-semantics/semantics/float.k-348-        => #iterYield(V, R) ~> #minContV(M) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-349-       requires isInt(V) orBool isBool(V)
/reference/k-proof/reference-semantics/semantics/float.k-350-
/reference/k-proof/reference-semantics/semantics/float.k-351-  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
/reference/k-proof/reference-semantics/semantics/float.k:352:  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
/reference/k-proof/reference-semantics/semantics/float.k-353-  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
/reference/k-proof/reference-semantics/semantics/float.k-354-  // with isInt(V) in its path condition refutes this branch without sort reasoning.
/reference/k-proof/reference-semantics/semantics/float.k-355-  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
/reference/k-proof/reference-semantics/semantics/float.k-356-  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
/reference/k-proof/reference-semantics/semantics/float.k:357:        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-358-       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
/reference/k-proof/reference-semantics/semantics/float.k-359-  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-360-  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-361-  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
/reference/k-proof/reference-semantics/semantics/float.k:362:        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-363-       requires isFloat(V)
/reference/k-proof/reference-semantics/semantics/float.k-364-  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
/reference/k-proof/reference-semantics/semantics/float.k:365:        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-366-       requires isInt(V) orBool isBool(V)
/reference/k-proof/reference-semantics/semantics/float.k-367-endmodule
