Module(
  FuncDef("x_or_y", Params("n", "x", "y"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Name("y")),
      )
    Assign(Name("i"), Int(2))
    Assign(Name("result"), Name("x"))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      If(Compare(BinOp("%", Name("n"), Name("i")), CmpOp("==", Int(0))),
        Assign(Name("result"), Name("y")),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("x_or_y"), UnaryOp("-", Int(5)), Int(10), Int(20)),
      CmpOp("==", Int(20))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(0), Int(10), Int(20)),
      CmpOp("==", Int(20))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(1), Int(10), Int(20)),
      CmpOp("==", Int(20))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(2), Int(10), Int(20)),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(3), Int(10), Int(20)),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(4), Int(10), Int(20)),
      CmpOp("==", Int(20))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(7), Int(34), Int(12)),
      CmpOp("==", Int(34))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(15), Int(8), Int(5)),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(25), Int(10), Int(20)),
      CmpOp("==", Int(20)))))
