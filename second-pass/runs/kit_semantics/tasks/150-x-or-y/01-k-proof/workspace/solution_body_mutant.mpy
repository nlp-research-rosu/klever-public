Module(
  FuncDef("x_or_y", Params("n", "x", "y"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Name("y")),
      )
    Assign(Name("i"), Int(2))
    Assign(Name("result"), Name("y"))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      If(Compare(BinOp("%", Name("n"), Name("i")), CmpOp("==", Int(0))),
        Assign(Name("result"), Name("y")),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result"))))
