     6	def x_or_y(n, x, y):
     7	    """A simple program which should return the value of x if n is 
     8	    a prime number and should return the value of y otherwise.
     9	
    10	    Examples:
    11	    for x_or_y(7, 34, 12) == 34
    12	    for x_or_y(15, 8, 5) == 5
    13	    
    14	    """
    15	    if n == 1:
    16	        return y
    17	    for i in range(2, n):
    18	        if n % i == 0:
    19	            return y
    20	            break
    21	    else:
    22	        return x
FILE:solution.py
     1	def x_or_y(n, x, y):
     2	    if n < 2:
     3	        return y
     4	
     5	    i = 2
     6	    result = x
     7	    while i < n:
     8	        if n % i == 0:
     9	            result = y
    10	        i = i + 1
    11	
    12	    return result
