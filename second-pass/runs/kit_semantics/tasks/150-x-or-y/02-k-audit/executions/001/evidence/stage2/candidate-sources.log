     5	      )
     6	    Assign(Name("i"), Int(2))
     7	    Assign(Name("result"), Name("x"))
     8	    While(Compare(Name("i"), CmpOp("<", Name("n"))),
     9	      If(Compare(BinOp("%", Name("n"), Name("i")), CmpOp("==", Int(0))),
    10	        Assign(Name("result"), Name("y")),
    11	        )
