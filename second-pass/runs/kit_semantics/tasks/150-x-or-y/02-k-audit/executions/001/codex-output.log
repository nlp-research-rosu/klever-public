+#!/usr/bin/env python3
+"""Try common deterministic directory-digest encodings against a known hash."""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+
+ROOT = Path("/reference/reference-semantics")
+EXPECTED = "1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de"
+
+entries = sorted(ROOT.rglob("*"), key=lambda p: p.relative_to(ROOT).as_posix())
+
+
+def content(path: Path, form: str) -> bytes:
+    if not path.is_file():
+        return b""
+    data = path.read_bytes()
+    if form == "raw":
+        return data
+    if form == "hex":
+        return hashlib.sha256(data).hexdigest().encode()
+    if form == "digest":
+        return hashlib.sha256(data).digest()
+    if form == "size":
+        return str(len(data)).encode() + data
+    if form == "size8":
+        return len(data).to_bytes(8, "big") + data
+    raise AssertionError(form)
+
+
+for include_dirs in [False, True]:
+    selected = entries if include_dirs else [p for p in entries if p.is_file()]
+    for path_form in ["rel", "dotrel", "name"]:
+        for path_sep in [b"", b"\0", b"\n", b"  "]:
+            for kind_form in ["none", "word", "letter"]:
+                for kind_sep in [b"", b"\0", b"\n"]:
+                    for data_form in ["raw", "hex", "digest", "size", "size8"]:
+                        digest = hashlib.sha256()
+                        for path in selected:
+                            rel = path.relative_to(ROOT).as_posix()
+                            if path_form == "dotrel":
+                                rel = "./" + rel
+                            elif path_form == "name":
+                                rel = path.name
+                            digest.update(rel.encode())
+                            digest.update(path_sep)
+                            if kind_form == "word":
+                                digest.update(b"file" if path.is_file() else b"directory")
+                            elif kind_form == "letter":
+                                digest.update(b"f" if path.is_file() else b"d")
+                            digest.update(kind_sep)
+                            digest.update(content(path, data_form))
+                        if digest.hexdigest() == EXPECTED:
+                            print(
+                                "MATCH",
+                                include_dirs,
+                                path_form,
+                                path_sep,
+                                kind_form,
+                                kind_sep,
+                                data_form,
+                            )
