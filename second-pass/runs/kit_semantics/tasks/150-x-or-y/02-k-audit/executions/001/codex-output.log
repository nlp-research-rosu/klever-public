FILE:solution.py
     1	def x_or_y(n, x, y):
     2	    if n < 2:
     3	        return y
     4	
     5	    i = 2
     6	    result = x
     7	    while i < n:
     8	        if n % i == 0:
     9	            result = y
    10	        i = i + 1
    11	
    12	    return result
