+          closureVal(
+            "n", "x", "y", .ParamNames,
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Name("y")) .Stmts,
+              .Stmts)
+            Assign(Name("i"), Int(2))
+            Assign(Name("result"), Name("x"))
+            While(
+              Compare(Name("i"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("i")),
+                  CmpOp("==", Int(0))),
+                Assign(Name("result"), Name("y")) .Stmts,
+                .Stmts)
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))) .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
