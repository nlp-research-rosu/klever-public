+++ b/evidence/stage6/spec-audit-vacuity.k
@@ -0,0 +1,69 @@
+requires "verification.k"
+
+module SPEC-AUDIT-VACUITY
+  imports VERIFICATION
+
+  // Fresh audit mutation: the unchanged program at n=2, x=10, y=20 really
+  // returns 10, but this claim deliberately demands 20.
+  claim [false-prime-result]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("x_or_y", Params("n", "x", "y"),
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Name("y")) .Stmts,
+              .Stmts)
+            Assign(Name("i"), Int(2))
+            Assign(Name("result"), Name("x"))
+            While(
+              Compare(Name("i"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("i")),
+                  CmpOp("==", Int(0))),
+                Assign(Name("result"), Name("y")) .Stmts,
+                .Stmts)
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))) .Stmts)
+            Return(Name("result")) .Stmts)))
+      ~> Call(Name("x_or_y"), 2, 10, 20)
+      => ?V:Val
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "x_or_y" |->
+          closureVal(
+            "n", "x", "y", .ParamNames,
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Name("y")) .Stmts,
+              .Stmts)
+            Assign(Name("i"), Int(2))
+            Assign(Name("result"), Name("x"))
+            While(
+              Compare(Name("i"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("i")),
+                  CmpOp("==", Int(0))),
+                Assign(Name("result"), Name("y")) .Stmts,
+                .Stmts)
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))) .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?V ==K 20
+endmodule
diff --git a/evidence/stage7/trust-ledger.md b/evidence/stage7/trust-ledger.md
