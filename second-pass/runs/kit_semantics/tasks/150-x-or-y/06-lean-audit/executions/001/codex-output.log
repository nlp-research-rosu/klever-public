codex
The root cause is now concrete: processes see an inner PID namespace, but `/proc` is mounted from the outer namespace; Lean 4.22 resolves `/proc/<getpid()>/exe`, so application-path detection fails. I’m applying a narrowly scoped local preload shim that redirects only `/proc/<number>/exe` readlink calls to `/proc/self/exe`; this repairs executable-path discovery without changing the generated sources, proof terms, or trusted checker logic. I’ll preserve both the failed and repaired runs as evidence.
apply patch
patch: completed
/tmp/audit-work/proc_exe_readlink_shim.c
diff --git a//tmp/audit-work/proc_exe_readlink_shim.c b//tmp/audit-work/proc_exe_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..dd6b317fa86f140f14b1f69dc6d46a7cdbcf6658
--- /dev/null
+++ b//tmp/audit-work/proc_exe_readlink_shim.c
@@ -0,0 +1,37 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_numeric_proc_exe(const char *path) {
+    const char *cursor;
+
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor = path + 6;
+    if (*cursor < '0' || *cursor > '9') {
+        return 0;
+    }
+    while (*cursor >= '0' && *cursor <= '9') {
+        ++cursor;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_numeric_proc_exe(path)) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
