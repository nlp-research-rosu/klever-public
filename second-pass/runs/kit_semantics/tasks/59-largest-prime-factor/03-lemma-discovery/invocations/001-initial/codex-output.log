import json
from pathlib import Path
inv_path = Path('/reference/rule-inventory.json')
out_path = Path('/workspace/trust-boundary.json')
inv = json.loads(inv_path.read_text(encoding='utf-8'))
out = json.loads(out_path.read_text(encoding='utf-8'))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
inv_ids = [r['source_rule_id'] for r in inv['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert len(out_ids) == len(set(out_ids)) == len(inv_ids)
for item in out['rules']:
    assert list(item) == ['source_rule_id', 'classification', 'rationale'], item
    assert item['classification'] in allowed
    assert isinstance(item['rationale'], str) and item['rationale'].strip()
by_id = {r['source_rule_id']: r for r in out['rules']}
for source in inv['rules']:
    if 'simplification' in source.get('attributes', []):
        assert by_id[source['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
for forbidden in ('theorem', 'statement', 'lean', 'replacement'):
    assert forbidden not in out, forbidden
print(f\"validated_rules={len(out_ids)}\")
print('inventory_order=exact')
print('inventory_sha256=exact')
print('schema_and_entry_keys=exact')
print('classifications=', {c: sum(r['classification'] == c for r in out['rules']) for c in sorted(allowed)})
