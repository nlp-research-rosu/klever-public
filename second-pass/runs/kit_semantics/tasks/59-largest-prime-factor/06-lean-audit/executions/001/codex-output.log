 'stage1_export_sha256': Path('/reference/k-proof'),
 'generated_tree_sha256': Path('/reference/klean-generation/generated'),
 'generation_producer_sources_sha256': Path('/reference/generation-tools'),
 'k_audit_sha256': Path('/reference/k-audit'),
 'klean_generation_sha256': Path('/reference/klean-generation'),
}
print('=== tree digest comparisons ===')
for key,root in roots.items():
    try:
        actual=tree_digest(root)
    except Exception as e:
        actual=f'ERROR: {type(e).__name__}: {e}'
    print(json.dumps({'field':key,'root':str(root),'expected':expected[key],'actual':actual,'match':actual==expected[key]},sort_keys=True))

print('=== discovery manifest file hash ===')
a=hashlib.sha256(Path('/reference/lemma-discovery.json').read_bytes()).hexdigest()
print(json.dumps({'expected':expected['discovery_manifest_sha256'],'actual':a,'match':a==expected['discovery_manifest_sha256']},sort_keys=True))

print('=== producer/trusted source file hashes ===')
for name in ['klean_export.py','klean.py']:
    gen=hashlib.sha256((Path('/reference/generation-tools')/name).read_bytes()).hexdigest()
    trusted=hashlib.sha256((Path('/reference/tools')/name).read_bytes()).hexdigest()
    print(json.dumps({'file':name,'generation_source':gen,'trusted_tool_copy':trusted,'copies_equal':gen==trusted},sort_keys=True))

print('=== Stage 1 per-file source hash comparison ===')
exp=p['stage1_source_hashes']
root=Path('/reference/k-proof')
actual={}
nonregular=[]
for path in root.rglob('*'):
    rel=path.relative_to(root).as_posix()
    mode=path.lstat().st_mode
    if stat.S_ISREG(mode):
        actual[rel]=hashlib.sha256(path.read_bytes()).hexdigest()
    elif not stat.S_ISDIR(mode):
        nonregular.append((rel,oct(mode)))
missing=sorted(set(exp)-set(actual))
extra=sorted(set(actual)-set(exp))
mismatch=sorted(k for k in set(exp)&set(actual) if exp[k]"'!=actual[k])
print(json.dumps({'"'expected_count':len(exp),'actual_regular_count':len(actual),'missing_count':len(missing),'extra_count':len(extra),'mismatch_count':len(mismatch),'nonregular_count':len(nonregular),'missing_first':missing[:10],'extra_first':extra[:10],'mismatch_first':[{k:{'expected':exp[k],'actual':actual[k]}} for k in mismatch[:10]],'nonregular_first':nonregular[:10]},indent=2,sort_keys=True))

print('=== image ID cross-record comparison ===')
source=json.load(open('/reference/generation-tools/source-manifest.json'))
generator=json.load(open('/reference/klean-generation/generator-manifest.json'))
recorded_dir=Path(p['generation_producer_sources']).name
print(json.dumps({'source_manifest':source.get('generator_image_id'),'generator_manifest':generator.get('provenance',{}).get('generator_image_id'),'audit_input_producer_path_basename':recorded_dir,'expected_prefixed_from_audit_path':'sha256:'+recorded_dir,'all_equal':source.get('generator_image_id')==generator.get('provenance',{}).get('generator_image_id')=='sha256:'+recorded_dir},indent=2,sort_keys=True))
