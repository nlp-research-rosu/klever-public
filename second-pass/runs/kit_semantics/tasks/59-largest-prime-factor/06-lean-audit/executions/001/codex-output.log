+from tools.klean_preflight import check_generation
+check_generation(Path('/reference/k-proof'),
+                 Path('/reference/lemma-discovery.json'),
+                 Path('/reference/klean-generation'),
+                 toolchain_lock=Path('/reference/klean-toolchain.lock.json'))
+PY
+
+RESULT
+tools.klean_preflight.KleanPreflightError: lake clean failed (1): error: could not detect the configuration of the Lake installation
+
+SECOND ATTEMPT AFTER SETTING LEAN_SYSROOT, LEAN, LEAN_AR, LAKE_HOME
+RESULT
+tools.klean_preflight.KleanPreflightError: lake build failed (1):
+info: stderr:
+error: failed to locate application
+error: Lean exited with code 1
+Some required builds logged failures:
+- Klean59LargestPrimeFactor.Prelude
+error: build failed
+
+ENVIRONMENT DIAGNOSIS COMMAND
+echo shell_pid=$$
+ls -l /proc/$$/exe
+readlink /proc/self
+python3 - <<'PY'
+import os
+print(os.getpid())
+print(os.readlink(f'/proc/{os.getpid()}/exe'))
+PY
+
+RESULT
+shell_pid=2
+ls: cannot access '/proc/2/exe': No such file or directory
+/proc/self resolved to a host-namespace PID (for example 1274)
+Python getpid() returned the nested PID and /proc/<nested-pid>/exe raised FileNotFoundError.
+
+Lean 4.22's lean_io_app_path disassembly showed it formats
+/proc/<getpid()>/exe and calls readlink. The failure was therefore the audit
+sandbox's PID/proc namespace mismatch, not generated source or theorem content.
diff --git a/evidence/06-lean-proc-self-shim.c b/evidence/06-lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..65ee841a681c8e920d72372e4e3e9ef93d33f6ce
--- /dev/null
+++ b/evidence/06-lean-proc-self-shim.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/* Audit-local workaround for the sandbox's PID/proc namespace mismatch. */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static const char prefix[] = "/proc/";
+    static const char suffix[] = "/exe";
+    const char *cursor;
+
+    if (path != NULL && strncmp(path, prefix, sizeof(prefix) - 1) == 0) {
+        cursor = path + sizeof(prefix) - 1;
+        if (isdigit((unsigned char)*cursor)) {
+            while (isdigit((unsigned char)*cursor)) {
+                cursor++;
+            }
+            if (strcmp(cursor, suffix) == 0) {
+                path = "/proc/self/exe";
+            }
+        }
+    }
+    return syscall(SYS_readlink, path, buffer, size);
+}
