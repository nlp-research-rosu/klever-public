+    ),
+    "expected_target_definition": expected_definition,
+    "actual_target": actual_target,
+    "manifest_target": generator["target"],
+    "audit_input_target": audit["target"],
+    "preflight_target": audit["stage4_preflight"]["target"],
+    "all_targets_absent": (
