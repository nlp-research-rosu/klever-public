diff --git a/evidence/03-classification-semantics.txt b/evidence/03-classification-semantics.txt
new file mode 100644
index 0000000000000000000000000000000000000000..f39e213a5ceed301f859cb6162ad42405ec940b8
--- /dev/null
+++ b/evidence/03-classification-semantics.txt
@@ -0,0 +1,83 @@
+COMMAND
+nl -ba /reference/k-proof/verification.k
+sed -n '1,130p' /reference/k-proof/reference-semantics/semantics/int.k
+sed -n '1,125p' /reference/k-proof/reference-semantics/semantics/controls.k
+sed -n '1,180p' /reference/k-proof/reference-semantics/semantics/operators.k
+nl -ba /reference/k-proof/solution.py
+nl -ba /reference/k-proof/spec.k
+
+RELEVANT RESULT
+verification.k:7:
+  syntax Int ::= lpfFrom(Int, Int) [function]
+
+verification.k:14-22:
+  rule lpfFrom(N:Int, F:Int) => N
+    requires F >=Int 2 andBool N <=Int F
+
+  rule lpfFrom(N:Int, F:Int)
+    => lpfFrom((N -Int pyMod(N, F)) /Int F, F)
+    requires F >=Int 2 andBool N >Int F andBool pyMod(N, F) ==Int 0
+
+  rule lpfFrom(N:Int, F:Int) => lpfFrom(N, F +Int 1)
+    requires F >=Int 2 andBool N >Int F andBool pyMod(N, F) =/=Int 0
+
+semantics/int.k:15-20:
+  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
+  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
+  syntax Int ::= pyMod(Int, Int) [function]
+  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
+
+semantics/int.k:24-26 (comparison dispatch):
+  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int I2
+  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
+
+semantics/controls.k:9-11 (assignment):
+  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
+       <env> L:Int </env>
+       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
+
+semantics/controls.k:52-54 (if):
+  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
+  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
+  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
+
+semantics/controls.k:77-82 (while):
+  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
+  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
+  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
+       requires truthy(V)
+  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
+       requires notBool truthy(V)
+
+source solution.py:1-8:
+  def largest_prime_factor(n: int):
+      factor = 2
+      while n > factor:
+          if n % factor == 0:
+              n = n // factor
+          else:
+              factor = factor + 1
+      return n
+
+spec.k postconditions:
+  loop claim requires F >=Int 2 and ensures ?RESULT ==Int lpfFrom(N, F)
+  entry claim requires N0 >=Int 2 and ensures ?RESULT ==Int lpfFrom(N0, 2)
+
+INDEPENDENT CLASSIFICATION
+1. rule-c09d... is DEFINITION: the base equation defines the fresh named
+   summary at loop exit. It is not a configuration rewrite and states no
+   primality, divisibility, maximality, or other independent domain fact.
+2. rule-4c377... is DEFINITION: the divisible recurrence uses exactly the
+   supplied operational meaning of Python //, with the same n update and
+   unchanged factor. Under its guard pyMod(N,F)=0, the displayed expression is
+   N/F. It is not an execution bridge because its LHS is lpfFrom, not program K.
+3. rule-de352... is DEFINITION: the nondivisible recurrence preserves n and
+   increments factor exactly as the else branch. It also rewrites only lpfFrom.
+
+The guards are mutually exclusive and exhaustive for the proved F>=2 domain:
+N<=F, or N>F split by pyMod(N,F)=0 versus pyMod(N,F)!=0. With F>=2 there is no
+division-by-zero branch. The divisible recurrence strictly decreases positive
+N; the nondivisible recurrence increases F toward N. No inventory rule has a
+simplification attribute. There are no claimed operational rules, proved
+derived lemmas, or domain lemmas, so their extra category-specific obligations
+are vacuous.
