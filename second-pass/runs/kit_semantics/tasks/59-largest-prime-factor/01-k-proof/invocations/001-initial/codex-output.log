index 0000000000000000000000000000000000000000..e48ced290160ffb4e25cf041b00fc2f9dba0f18c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def largest_prime_factor(n: int):
+    factor = 2
+    while n > factor:
+        if n % factor == 0:
+            n = n // factor
+        else:
+            factor = factor + 1
+    return n
