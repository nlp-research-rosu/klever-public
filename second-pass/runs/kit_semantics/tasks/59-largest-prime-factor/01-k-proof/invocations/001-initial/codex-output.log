+            )
+            Return(Name("n"))
+            .Stmts
+          )
+          .Stmts
+        )
+      )
+      ~> Call(Name("largest_prime_factor"), Int(4) , .Exprs)
+      => ?RESULT:Int
+    </k>
+    <env> 0 </env>
