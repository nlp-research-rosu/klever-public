from solution import largest_prime_factor

def is_prime(n):
    if n < 2:
        return False
    d = 2
    while d * d <= n:
        if n % d == 0:
            return False
        d += 1
    return True

def oracle(n):
    return max(d for d in range(2, n + 1) if n % d == 0 and is_prime(d))

cases = [4, 6, 8, 9, 12, 25, 49, 2048, 13195]
for n in cases:
    got = largest_prime_factor(n)
    want = oracle(n)
    print(f\"n={n} got={got} oracle={want}\")
    assert got == want
