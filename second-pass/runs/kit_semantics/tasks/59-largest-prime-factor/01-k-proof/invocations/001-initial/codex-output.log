new file mode 100644
index 0000000000000000000000000000000000000000..3a5a9c3d10b9ffa87e5240853ca98ba42fa0168c
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,13 @@
+def largest_prime_factor(n: int):
+    factor = 2
+    while n > factor:
+        if n % factor == 0:
+            n = n // factor
+        else:
+            factor = factor + 1
+    return n
+
+
+example_13195 = largest_prime_factor(13195)
+example_2048 = largest_prime_factor(2048)
+boundary_4 = largest_prime_factor(4)
