+            Params("n"),
+            Assign(Name("factor"), Int(2))
+            While(
+              Compare(Name("n"), CmpOp(">", Name("factor"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("factor")),
+                  CmpOp("==", Int(0))
+                ),
+                Assign(Name("n"), BinOp("//", Name("n"), Name("factor"))) .Stmts,
+                Assign(Name("factor"), BinOp("+", Name("factor"), Int(1))) .Stmts
