      "normalized_sha256": "c09d86f09f196dc6bfd7245139d77da63a26829d9dcf6ed5b3c1e876b4204f34",
      "rationale": "This guarded equation is the base case of the recursive lpfFrom mathematical summary: when N is no greater than F, it defines the named summary to be N and does not add an independent mathematical fact or replace program execution.",
      "source_rule_id": "rule-c09d86f09f196dc6bfd7245139d77da63a26829d9dcf6ed5b3c1e876b4204f34",
      "start_line": 14,
      "text": "  rule lpfFrom(N:Int, F:Int) => N\n    requires F >=Int 2 andBool N <=Int F"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "4c37787b8b69deb1e9173a83d853af7a8fe0ee7441fddb5263a9d691cadc23ac",
      "rationale": "This guarded recurrence defines lpfFrom on the divisible-loop case by reducing N with the same pyMod-based quotient used by the model; it is part of the summary's definition, not a separately proved reusable rule.",
      "source_rule_id": "rule-4c37787b8b69deb1e9173a83d853af7a8fe0ee7441fddb5263a9d691cadc23ac",
      "start_line": 17,
      "text": "  rule lpfFrom(N:Int, F:Int)\n    => lpfFrom((N -Int pyMod(N, F)) /Int F, F)\n    requires F >=Int 2 andBool N >Int F andBool pyMod(N, F) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "de3529b439b11f78acab7501799690277d17c9e760bf812468bba7d69d04efd4",
      "rationale": "This guarded recurrence defines lpfFrom on the non-divisible-loop case by advancing F, completing the recursive summary's case split without asserting an additional domain fact or operational shortcut.",
      "source_rule_id": "rule-de3529b439b11f78acab7501799690277d17c9e760bf812468bba7d69d04efd4",
      "start_line": 21,
      "text": "  rule lpfFrom(N:Int, F:Int) => lpfFrom(N, F +Int 1)\n    requires F >=Int 2 andBool N >Int F andBool pyMod(N, F) =/=Int 0"
    }
  ],
