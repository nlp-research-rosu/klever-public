cmp -s solution-module.kore entry-module-normalized.kore
printf \"constructor_kore_cmp_exit=0 identical=yes\\n\"
sha256sum solution-module.kore entry-module-normalized.kore
wc -c solution.mpy entry-module-normalized.mpy solution-module.kore entry-module-normalized.kore'" in /audit-output
