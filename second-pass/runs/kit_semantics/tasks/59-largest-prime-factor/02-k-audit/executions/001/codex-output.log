@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+mkdir -p "$(dirname "$log_path")"
+set +e
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+pipeline_status=${PIPESTATUS[0]}
+exit "$pipeline_status"

exec
/bin/bash -lc "kprove --help | rg -n -- '-I|include|dry-run|claims|spec-module'" in /audit-output
