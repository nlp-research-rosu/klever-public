+                raise RuntimeError(f"non-regular file in source tree: {path}")
+            observed[path.relative_to(root).as_posix()] = sha256_file(path)
+    return observed
+
+
+def check(name: str, observed: object, expected: object) -> None:
+    ok = observed == expected
