+                    Name("char"),
+                    Name("text"),
+                    If(
+                      Compare(
+                        Name("char"),
+                        CmpOp("not in", Str("aeiouAEIOU"))),
+                      AugAssign(
+                        Name("result"), "+", Name("char")) .Stmts,
+                      .Stmts) .Stmts)
+                  Return(Name("result")) .Stmts,
+                  0)
+           ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
