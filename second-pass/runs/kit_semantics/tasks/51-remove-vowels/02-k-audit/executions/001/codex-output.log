+```text
+python3 /reference/py2mpy.py \
+  /tmp/audit-work/reconstruction/solution.py \
+  > /tmp/audit-work/reconstruction/solution.regenerated.mpy
+cmp /tmp/audit-work/reconstruction/solution.mpy \
+    /tmp/audit-work/reconstruction/solution.regenerated.mpy
