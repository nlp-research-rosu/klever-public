===== /candidate/solution.py =====
     1	def remove_vowels(text):
     2	    result = ""
     3	    char = ""
     4	    for char in text:
     5	        if char not in "aeiouAEIOU":
     6	            result += char
     7	    return result
===== /candidate/solution.mpy =====
     1	Module(
     2	  FuncDef("remove_vowels", Params("text"),
     3	    Assign(Name("result"), Str(""))
     4	    Assign(Name("char"), Str(""))
     5	    For(Name("char"), Name("text"),
     6	      If(Compare(Name("char"), CmpOp("not in", Str("aeiouAEIOU"))),
     7	        AugAssign(Name("result"), "+", Name("char")),
     8	        ))
     9	    Return(Name("result"))))
