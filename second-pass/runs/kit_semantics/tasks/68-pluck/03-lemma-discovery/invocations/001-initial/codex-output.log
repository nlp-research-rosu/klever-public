     6	  claim [pluck-loop]:
     7	    <k>
     8	      #loop(
     9	        list(vCons(HEAD:Val, REST:ValSeq)),
    10	        Name("value"),
    11	        Assign(Name("value"), BinOp("+", Name("value"), Int(0)))
    12	        If(
