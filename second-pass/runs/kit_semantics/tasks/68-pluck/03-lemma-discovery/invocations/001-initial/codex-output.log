    14	            BinOp("%", Name("value"), Int(2)),
    15	            CmpOp("==", Int(0))),
    16	          If(
    17	            Compare(Name("smallest"), CmpOp("<", Int(0))),
    18	            Assign(Name("smallest"), Name("value"))
    19	            Assign(Name("smallest_index"), Name("index")),
    20	            If(
    21	              Compare(Name("value"), CmpOp("<", Name("smallest"))),
    22	              Assign(Name("smallest"), Name("value"))
    23	              Assign(Name("smallest_index"), Name("index")),
    24	              .Stmts)),
    25	          .Stmts)
    26	        AugAssign(Name("index"), "+", Int(1)))
    27	      => .K
    28	      ...
    29	    </k>
    30	    <env> L:Int </env>
    31	    <scopes>
    32	      ...
    33	      L |-> scope(
    34	        "arr"            |-> list(ORIGINAL:ValSeq)
    35	        "smallest"       |-> (BEST:Int
    36	                              => scanBest(
    37	                                   vCons(HEAD, REST), POS, BEST))
    38	        "smallest_index" |-> (BEST_INDEX:Int
    39	                              => scanBestIndex(
    40	                                   vCons(HEAD, REST),
    41	                                   POS,
    42	                                   BEST,
    43	                                   BEST_INDEX))
    44	        "index"          |-> (POS:Int
    45	                              => afterIndex(vCons(HEAD, REST), POS))
    46	        "value"          |-> (_OLD:Val => ?FINAL_VALUE:Val),
    47	        parent(0))
    48	      ...
    49	    </scopes>
    50	    requires POS >=Int 0
    51	      andBool definedProjectInt(HEAD)
    52	      andBool projectIntTotal(HEAD) >=Int 0
    53	      andBool allNonNegative(REST)
    54	
    55	  claim [pluck-entry]:
    56	    <k>
    57	      Call(Name("pluck"), list(INPUT:ValSeq))
    58	      => ref(0)
    59	    </k>
    60	    <env> 0 </env>
    61	    <scopes>
    62	      -1 |-> builtinsScope
    63	      0  |-> scope(
    64	        "pluck" |-> closureVal(
    65	          "arr",
    66	          Assign(Name("smallest"), UnaryOp("-", Int(1)))
    67	          Assign(Name("smallest_index"), Int(0))
    68	          Assign(Name("index"), Int(0))
    69	          Assign(Name("value"), Int(0))
    70	          For(
    71	            Name("value"),
    72	            Name("arr"),
    73	            Assign(Name("value"), BinOp("+", Name("value"), Int(0)))
    74	            If(
    75	              Compare(
    76	                BinOp("%", Name("value"), Int(2)),
    77	                CmpOp("==", Int(0))),
    78	              If(
    79	                Compare(Name("smallest"), CmpOp("<", Int(0))),
    80	                Assign(Name("smallest"), Name("value"))
    81	                Assign(Name("smallest_index"), Name("index")),
    82	                If(
    83	                  Compare(Name("value"), CmpOp("<", Name("smallest"))),
    84	                  Assign(Name("smallest"), Name("value"))
    85	                  Assign(Name("smallest_index"), Name("index")),
    86	                  .Stmts)),
    87	              .Stmts)
    88	            AugAssign(Name("index"), "+", Int(1)))
    89	          If(
    90	            Compare(Name("smallest"), CmpOp("<", Int(0))),
    91	            Return(ListExpr(.Exprs)),
    92	            .Stmts)
    93	          Return(ListExpr(Name("smallest"), Name("smallest_index"))),
    94	          0),
    95	        parent(-1))
    96	    </scopes>
    97	    <scopeLoc> 1 </scopeLoc>
    98	    <heap>
    99	      .Map
   100	      => 0 |-> resultList(
