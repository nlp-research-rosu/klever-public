     4	  imports MPY
     5	
     6	  // Guarded total projection from the dynamic Val sort to Int.  This is the
     7	  // standard total twin of K's partial subsort cast; it is used only under
     8	  // definedProjectInt and collapses on every statically known Int.
     9	  syntax Bool ::= definedProjectInt(Val) [function, total]
    10	  rule definedProjectInt(V:Val) => isInt(V)
    11	
    12	  syntax Int ::= projectIntTotal(Val)
    13	    [function, total, symbol(projectIntTotal), no-evaluators]
    14	
    15	  rule #Ceil({@V:Val}:>Int)
    16	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    17	    [simplification]
    18	
    19	  rule projectIntTotal(V:Val) => {V}:>Int
    20	    requires definedProjectInt(V)
    21	    [concrete, simplification(10), preserves-definedness]
    22	
    23	  rule {V:Val}:>Int => projectIntTotal(V)
    24	    requires definedProjectInt(V)
    25	    [symbolic(V), simplification, preserves-definedness]
    26	
    27	  rule projectIntTotal(I:Int) => I [simplification]
    28	  rule projectIntTotal(projectIntTotal(V:Val))
    29	    => projectIntTotal(V)
    30	    [simplification]
    31	
    32	  // Guarded dispatch twin for the exact fixed rule
    33	  // applyBin("+", I1:Int, I2:Int) => I1 +Int I2.  It lets the source's
    34	  // value + 0 normalization refine a dynamically sorted list head.
    35	  rule applyBin("+", V:Val, I:Int)
    36	    => projectIntTotal(V) +Int I
    37	    requires definedProjectInt(V)
    38	    [simplification]
    39	
    40	  // Exact contract domain: finite list payloads containing only non-negative
    41	  // Python integers.
    42	  syntax Bool ::= allNonNegative(ValSeq) [function, total]
    43	  rule allNonNegative(.ValSeq) => true
    44	  rule allNonNegative(vCons(V:Val, R:ValSeq))
    45	    => definedProjectInt(V)
    46	       andBool projectIntTotal(V) >=Int 0
    47	       andBool allNonNegative(R)
    48	
    49	  // shouldTake exactly mirrors the nested source condition.  A negative
    50	  // current best is the source sentinel; otherwise only a strictly smaller
    51	  // even value replaces it.
    52	  syntax Bool ::= shouldTake(Int, Int) [function, total]
    53	  rule shouldTake(B:Int, V:Int)
    54	    => pyMod(V, 2) ==Int 0
    55	       andBool (B <Int 0 orBool V <Int B)
    56	
    57	  syntax Int ::= nextBest(Int, Int) [function, total]
    58	  rule nextBest(B:Int, V:Int) => V
    59	    requires shouldTake(B, V)
    60	  rule nextBest(B:Int, V:Int) => B
    61	    requires notBool shouldTake(B, V)
    62	
    63	  syntax Int ::= nextBestIndex(Int, Int, Int, Int) [function, total]
    64	  rule nextBestIndex(B:Int, _J:Int, V:Int, I:Int) => I
    65	    requires shouldTake(B, V)
    66	  rule nextBestIndex(B:Int, J:Int, V:Int, _I:Int) => J
    67	    requires notBool shouldTake(B, V)
    68	
    69	  syntax Int ::= scanBest(ValSeq, Int, Int) [function, total]
    70	  rule scanBest(.ValSeq, _I:Int, B:Int) => B
    71	  rule scanBest(vCons(V:Val, R:ValSeq), I:Int, B:Int)
    72	    => scanBest(R, I +Int 1, nextBest(B, projectIntTotal(V)))
    73	
    74	  syntax Int ::= scanBestIndex(ValSeq, Int, Int, Int)
    75	    [function, total]
    76	  rule scanBestIndex(.ValSeq, _I:Int, _B:Int, J:Int) => J
    77	  rule scanBestIndex(
    78	         vCons(V:Val, R:ValSeq), I:Int, B:Int, J:Int)
    79	    => scanBestIndex(
    80	         R,
    81	         I +Int 1,
    82	         nextBest(B, projectIntTotal(V)),
    83	         nextBestIndex(B, J, projectIntTotal(V), I))
    84	
    85	  syntax Int ::= afterIndex(ValSeq, Int) [function, total]
    86	  rule afterIndex(.ValSeq, I:Int) => I
    87	  rule afterIndex(vCons(_V:Val, R:ValSeq), I:Int)
    88	    => afterIndex(R, I +Int 1)
    89	
    90	  syntax Val ::= resultList(Int, Int) [function, total]
    91	  rule resultList(B:Int, _J:Int) => list(.ValSeq)
    92	    requires B <Int 0
    93	  rule resultList(B:Int, J:Int)
    94	    => list(vCons(B, vCons(J, .ValSeq)))
    95	    requires B >=Int 0
    96	endmodule
