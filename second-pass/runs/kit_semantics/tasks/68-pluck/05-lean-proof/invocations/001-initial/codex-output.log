+import Proof
+
+private def showOperationalValue : SortVal → String
+  | .inj_SortInt value => s!"int:{value}"
+  | .inj_SortFloat value => s!"float:{value}"
+  | .inj_SortBool value => s!"bool:{value}"
+  | .«noneV_MPY-CORE_Val» => "undefined"
+  | _ => "other"
+
+private def runBin (operator : String) (left right : SortVal) : String :=
+  showOperationalValue
+    (Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» operator left right)
+
+#eval runBin "%" (.inj_SortInt (-3)) (.inj_SortInt 2)
+#eval runBin "%" (.inj_SortInt 3) (.inj_SortInt (-2))
+#eval runBin "//" (.inj_SortInt (-3)) (.inj_SortInt 2)
+#eval runBin "//" (.inj_SortInt 3) (.inj_SortInt (-2))
+#eval runBin "+" (.inj_SortInt 4) (.inj_SortBool true)
+#eval runBin "+" (.inj_SortBool false) (.inj_SortInt 4)
+#eval runBin "**" (.inj_SortInt 3) (.inj_SortInt 4)
+#eval runBin "**" (.inj_SortInt 3) (.inj_SortInt (-1))
+#eval runBin "/" (.inj_SortInt 3) (.inj_SortInt 2)
+#eval runBin "%" (.inj_SortFloat 3.5) (.inj_SortFloat 1.0)
+#eval runBin "+" (.inj_SortInt 2) (.inj_SortFloat 1.5)
+#eval runBin "**" (.inj_SortFloat 9.0) (.inj_SortFloat 0.5)
