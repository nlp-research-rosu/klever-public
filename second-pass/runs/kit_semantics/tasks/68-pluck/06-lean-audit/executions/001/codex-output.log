diff --git a//tmp/audit-work/app_path_probe.c b//tmp/audit-work/app_path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..10a3add1d97575e51c6efa4284119e3f15097801
--- /dev/null
+++ b//tmp/audit-work/app_path_probe.c
@@ -0,0 +1,16 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+    char path[4096];
+    ssize_t length = readlink("/proc/self/exe", path, sizeof(path) - 1);
+    if (length < 0) {
+        fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+        return 1;
+    }
+    path[length] = '\0';
+    puts(path);
+    return 0;
+}
diff --git a//tmp/audit-work/independent_checks.py b//tmp/audit-work/independent_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..0292ac8b21f755325125079284c14bde34cbd5e9
--- /dev/null
+++ b//tmp/audit-work/independent_checks.py
@@ -0,0 +1,244 @@
+#!/usr/bin/env python3
+"""Independent structural and provenance checks for the 68-pluck audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import klean_export, lemma_discovery_contract, pipeline_contract
+from tools.k_rule_inventory import inventory_verification
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+WORKSPACE = Path("/reference/k-proof")
+DISCOVERY = Path("/reference/lemma-discovery.json")
+GENERATION = Path("/reference/klean-generation")
+GENERATED = GENERATION / "generated"
+PRODUCERS = Path("/reference/generation-tools")
+CANDIDATE = Path("/candidate")
+
+
+def file_sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def check(label: str, observed: object, expected: object) -> dict[str, object]:
+    return {
+        "label": label,
+        "ok": observed == expected,
+        "observed": observed,
+        "expected": expected,
+    }
+
+
+def main() -> None:
+    audit = json.loads(AUDIT_INPUT.read_text())["resolution"]
+    hashes = audit["hashes"]
+    discovery = json.loads(DISCOVERY.read_text())
+    generator = json.loads((GENERATION / "generator-manifest.json").read_text())
+    source_manifest = json.loads((PRODUCERS / "source-manifest.json").read_text())
+    inventory = inventory_verification(WORKSPACE)
+    validated = lemma_discovery_contract.validate_trust_boundary(
+        WORKSPACE, DISCOVERY
+    )
+
+    canonical_ids = [rule["source_rule_id"] for rule in inventory["rules"]]
+    classified_ids = [rule["source_rule_id"] for rule in discovery["rules"]]
+    canonical_rule_projection = [
+        {
+            key: rule[key]
+            for key in (
+                "source_rule_id",
+                "module",
+                "start_line",
+                "end_line",
+                "normalized_sha256",
+                "attributes",
+            )
+        }
+        for rule in inventory["rules"]
+    ]
+    validation_rule_projection = [
+        {
+            key: rule[key]
+            for key in (
+                "source_rule_id",
+                "module",
+                "start_line",
+                "end_line",
+                "normalized_sha256",
+                "attributes",
+            )
+        }
+        for category in (
+            "definitions",
+            "operational_rules",
+            "proved_derived_lemmas",
+            "domain_lemmas",
+        )
+        for rule in validated[category]
+    ]
+
+    producer_files = sorted(
+        path.name for path in PRODUCERS.iterdir() if path.is_file()
+    )
+    exporter_hash = file_sha256(PRODUCERS / "klean_export.py")
+    klean_hash = file_sha256(PRODUCERS / "klean.py")
+    generator_image_id = generator["provenance"]["generator_image_id"]
+    image_key = generator_image_id.removeprefix("sha256:")
+
+    observed_stage1_source_hashes = {
+        path.relative_to(WORKSPACE).as_posix(): file_sha256(path)
+        for path in pipeline_contract._walk_regular_files(
+            WORKSPACE, "Stage 1 workspace"
+        )
+    }
+
+    results = [
+        check("audit mode env/input", audit["mode"], "CLASSIFICATION_AND_PROOF"),
+        check("inventory schema", inventory["schema_version"], 2),
+        check("inventory module closure", inventory["verification_modules"], ["VERIFICATION"]),
+        check("inventory hash vs discovery", inventory["inventory_sha256"], discovery["inventory_sha256"]),
+        check("inventory IDs ordered exactly", classified_ids, canonical_ids),
+        check("inventory IDs unique", len(set(classified_ids)), len(classified_ids)),
+        check("inventory entry count", len(classified_ids), len(canonical_ids)),
+        check(
+            "trusted contract canonical fields",
+            sorted(
+                canonical_rule_projection,
+                key=lambda item: canonical_ids.index(item["source_rule_id"]),
+            ),
+            sorted(
+                validation_rule_projection,
+                key=lambda item: canonical_ids.index(item["source_rule_id"]),
+            ),
+        ),
+        check(
+            "verification.k SHA-256",
+            inventory["verification_sha256"],
+            file_sha256(WORKSPACE / "verification.k"),
+        ),
+        check(
+            "discovery file SHA-256",
+            file_sha256(DISCOVERY),
+            hashes["discovery_manifest_sha256"],
+        ),
+        check(
+            "Stage 1 export tree digest",
+            klean_export.tree_digest(WORKSPACE),
+            hashes["stage1_export_sha256"],
+        ),
+        check(
+            "Stage 1 export vs input manifest",
+            klean_export.tree_digest(WORKSPACE),
+            json.loads((GENERATION / "input-manifest.json").read_text())[
+                "stage1_workspace_sha256"
+            ],
+        ),
+        check(
+            "Stage 1 pipeline tree hash",
+            pipeline_contract.sha256_tree(WORKSPACE),
+            hashes["k_workspace_sha256"],
+        ),
+        check(
+            "Stage 1 complete source hash map",
+            observed_stage1_source_hashes,
+            audit["stage1_source_hashes"],
+        ),
+        check(
+            "Stage 2 selected audit tree hash",
+            pipeline_contract.sha256_tree(Path("/reference/k-audit")),
+            hashes["k_audit_sha256"],
+        ),
+        check(
+            "Stage 4 selected generation tree hash",
+            pipeline_contract.sha256_tree(GENERATION),
+            hashes["klean_generation_sha256"],
+        ),
+        check(
+            "generated project tree digest vs generator manifest",
+            klean_export.tree_digest(GENERATED),
+            generator["generated_tree_sha256"],
+        ),
+        check(
+            "generated project tree digest vs audit input",
+            klean_export.tree_digest(GENERATED),
+            hashes["generated_tree_sha256"],
+        ),
+        check(
+            "producer exact file set",
+            producer_files,
+            ["klean.py", "klean_export.py", "source-manifest.json"],
+        ),
+        check(
+            "klean_export.py hash vs source manifest",
+            exporter_hash,
+            source_manifest["files"]["klean_export.py"],
+        ),
+        check(
+            "klean_export.py hash vs generator manifest",
+            exporter_hash,
+            generator["exporter_sha256"],
+        ),
+        check(
+            "klean.py hash vs source manifest",
+            klean_hash,
+            source_manifest["files"]["klean.py"],
+        ),
+        check(
+            "klean.py hash vs generator manifest",
+            klean_hash,
+            generator["klean_py_sha256"],
+        ),
+        check(
+            "producer image source/generator manifests",
+            source_manifest["generator_image_id"],
+            generator_image_id,
+        ),
+        check(
+            "producer image ID recorded by audit bundle path",
+            Path(audit["generation_producer_sources"]).name,
+            image_key,
+        ),
+        check(
+            "producer bundle pipeline tree hash",
+            pipeline_contract.sha256_tree(PRODUCERS),
+            hashes["generation_producer_sources_sha256"],
+        ),
+        check(
+            "candidate Stage 5 workspace tree hash",
+            pipeline_contract.sha256_tree(CANDIDATE),
+            hashes["lean_workspace_sha256"],
+        ),
+    ]
+
+    failed = [result["label"] for result in results if not result["ok"]]
+    output = {
+        "status": "PASS" if not failed else "FAIL",
+        "failed": failed,
+        "inventory": {
+            "verification_module": inventory["verification_module"],
+            "verification_modules": inventory["verification_modules"],
+            "verification_sha256": inventory["verification_sha256"],
+            "inventory_sha256": inventory["inventory_sha256"],
+            "rule_count": len(inventory["rules"]),
+            "ordered_source_rule_ids": canonical_ids,
+            "domain_rule_ids": [
+                rule["source_rule_id"] for rule in validated["domain_lemmas"]
+            ],
+        },
+        "producer": {
+            "generator_image_id": generator_image_id,
+            "klean_export_sha256": exporter_hash,
+            "klean_py_sha256": klean_hash,
+            "bundle_tree_sha256": pipeline_contract.sha256_tree(PRODUCERS),
+        },
+        "checks": results,
+    }
+    print(json.dumps(output, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
diff --git a//tmp/audit-work/proc_self_exe_fix.c b//tmp/audit-work/proc_self_exe_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..7fd0775d2c15f93503279c466b9368631d848070
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_fix.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+/*
+ * The managed audit sandbox exposes /proc/self/exe but not the numerical PID
+ * path reported inside its PID namespace. Lean 4.22 uses /proc/<pid>/exe.
+ * Retry only that failed lookup through the equivalent /proc/self/exe link.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    int saved_errno = errno;
+    size_t length = strlen(path);
+    if (result < 0 && saved_errno == ENOENT &&
+        length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+        strcmp(path + length - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    errno = saved_errno;
+    return result;
+}
diff --git a//tmp/audit-work/readlink_trace.c b//tmp/audit-work/readlink_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..5315015e803b337c69189240ecb9682f71ad0e70
--- /dev/null
+++ b//tmp/audit-work/readlink_trace.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    int saved_errno = errno;
+    fprintf(stderr, "TRACE readlink(%s) = %zd errno=%d\n", path, result, saved_errno);
+    errno = saved_errno;
+    return result;
+}
diff --git a//tmp/audit-work/stage4_target_checks.py b//tmp/audit-work/stage4_target_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..3e4345caeb48f4633b2a4ce224050453aa51b6cc
--- /dev/null
+++ b//tmp/audit-work/stage4_target_checks.py
@@ -0,0 +1,225 @@
+#!/usr/bin/env python3
+"""Independent Stage 4 obligation and target-identity checks."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from pathlib import Path
+
+from tools.klean_export import tree_digest
+
+
+GENERATION = Path("/reference/klean-generation")
+GENERATED = GENERATION / "generated"
+DISCOVERY = Path("/reference/lemma-discovery.json")
+AUDIT_INPUT = Path("/audit-input.json")
+FRESH = Path("/tmp/audit-work/68-pluck-proof.WmVtXE")
+
+
+def sha256_text(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def result(label: str, observed: object, expected: object) -> dict[str, object]:
+    return {
+        "label": label,
+        "ok": observed == expected,
+        "observed": observed,
+        "expected": expected,
+    }
+
+
+def main() -> None:
+    audit = json.loads(AUDIT_INPUT.read_text())["resolution"]
+    generator = json.loads((GENERATION / "generator-manifest.json").read_text())
+    obligation_map = json.loads(
+        (GENERATED / "obligation-map.json").read_text()
+    )
+    discovery = json.loads(DISCOVERY.read_text())
+    input_manifest = json.loads((GENERATION / "input-manifest.json").read_text())
+
+    independently_classified_domain_ids = [
+        "rule-0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
+        "rule-5a57a342f46c274d8d94d5f1c7eda4683981fbe24087e787e4a8ce7782c03167",
+    ]
+    source_rules = obligation_map["source_rules"]
+    obligations = obligation_map["obligations"]
+    source_ids = [entry["source_rule_id"] for entry in source_rules]
+    obligation_ids = [entry["source_rule_id"] for entry in obligations]
+
+    lines = ["def targetStatement"]
+    for parameter in obligation_map["trust_parameters"]:
+        lines.append(f'    ({parameter["name"]} : {parameter["type"]})')
+    lines.extend(
+        (
+            "    : Prop :=",
+            "    "
+            + "\n    ∧ ".join(
+                f'({obligation["lean_conjunct"]})'
+                for obligation in obligations
+            ),
+        )
+    )
+    independently_expected_definition = "\n".join(lines)
+
+    lemmas_text = (GENERATED / "Klean68Pluck/Lemmas.lean").read_text()
+    definitions = [
+        match.group(0).strip()
+        for match in re.finditer(
+            r"(?ms)^\s*def\s+targetStatement\b.*?"
+            r"(?=^\s*end\s+\S+\s*$)",
+            lemmas_text,
+        )
+    ]
+    extracted_definition = definitions[0] if len(definitions) == 1 else None
+    parameter_names = [
+        parameter["name"] for parameter in obligation_map["trust_parameters"]
+    ]
+    independently_expected_statement = " ".join(
+        [
+            "Klean68Pluck.Lemmas.targetStatement",
+            *parameter_names,
+        ]
+    )
+
+    proof_text = (FRESH / "Proof.lean").read_text()
+    theorem = re.search(
+        r"(?ms)^\s*theorem\s+final\s*:\s*(.*?)\s*:=\s*by\b",
+        proof_text,
+    )
+    final_statement = (
+        " ".join(theorem.group(1).split()) if theorem is not None else None
+    )
+
+    binding_hash_checks = []
+    for parameter in obligation_map["trust_parameters"]:
+        binding = {
+            key: parameter[key]
+            for key in ("kore_symbol", "name", "type", "source_rule_ids")
+        }
+        binding_hash_checks.append(
+            parameter["binding_sha256"]
+            == sha256_text(
+                json.dumps(binding, sort_keys=True, separators=(",", ":"))
+            )
+        )
+
+    source_by_id = {entry["source_rule_id"]: entry for entry in source_rules}
+    obligation_provenance_checks = []
+    for obligation in obligations:
+        source = source_by_id[obligation["source_rule_id"]]
+        obligation_provenance_checks.append(
+            {
+                "source_rule_id": obligation["source_rule_id"],
+                "span_ok": obligation["source_span"]
+                == {
+                    "start_line": source["start_line"],
+                    "end_line": source["end_line"],
+                },
+                "normalized_hash_ok": obligation["normalized_sha256"]
+                == source["normalized_sha256"],
+                "inventory_hash_ok": obligation["inventory_sha256"]
+                == source["inventory_sha256"]
+                == input_manifest["inventory_sha256"],
+                "discovery_hash_ok": obligation[
+                    "discovery_manifest_sha256"
+                ]
+                == source["discovery_manifest_sha256"]
+                == input_manifest["stage3_discovery_manifest_sha256"],
+                "conjunct_hash_ok": obligation["lean_conjunct_sha256"]
+                == sha256_text(obligation["lean_conjunct"]),
+            }
+        )
+
+    checks = [
+        result(
+            "source-rule IDs equal independent domain classification",
+            source_ids,
+            independently_classified_domain_ids,
+        ),
+        result(
+            "obligation IDs form exact ordered bijection",
+            obligation_ids,
+            source_ids,
+        ),
+        result(
+            "obligation IDs unique",
+            len(set(obligation_ids)),
+            len(obligation_ids),
+        ),
+        result(
+            "obligation count vs generator manifest",
+            len(obligations),
+            generator["obligation_count"],
+        ),
+        result(
+            "all obligation provenance and hashes",
+            all(
+                all(value for key, value in item.items() if key != "source_rule_id")
+                for item in obligation_provenance_checks
+            ),
+            True,
+        ),
+        result("all parameter binding hashes", all(binding_hash_checks), True),
+        result("single generated target definition", len(definitions), 1),
+        result(
+            "generated target is exact obligation conjunction",
+            extracted_definition,
+            independently_expected_definition,
+        ),
+        result(
+            "generated target definition hash",
+            sha256_text(extracted_definition or ""),
+            generator["target"]["definition_sha256"],
+        ),
+        result(
+            "generated target statement",
+            independently_expected_statement,
+            generator["target"]["statement"],
+        ),
+        result(
+            "generated target statement hash",
+            sha256_text(independently_expected_statement),
+            generator["target"]["statement_sha256"],
+        ),
+        result(
+            "generator target vs launcher target",
+            generator["target"],
+            audit["target"],
+        ),
+        result(
+            "fresh Base tree remains immutable",
+            tree_digest(FRESH / "Base"),
+            generator["generated_tree_sha256"],
+        ),
+        result(
+            "candidate final has exact fixed target application",
+            final_statement,
+            generator["target"]["statement"],
+        ),
+    ]
+
+    vacuous = [
+        {
+            "source_rule_id": obligation["source_rule_id"],
+            "lean_conjunct": obligation["lean_conjunct"],
+        }
+        for obligation in obligations
+        if re.search(r"(?:\(\s*True\s*\)|\bTrue\b)", obligation["lean_conjunct"])
+    ]
+    failed = [check["label"] for check in checks if not check["ok"]]
+    output = {
+        "structural_status": "PASS" if not failed else "FAIL",
+        "structural_failures": failed,
+        "checks": checks,
+        "obligation_provenance": obligation_provenance_checks,
+        "vacuous_conjunct_status": "FAIL" if vacuous else "PASS",
+        "vacuous_conjuncts": vacuous,
+    }
+    print(json.dumps(output, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()

exec
/bin/bash -lc 'set +e
proof_audit_dir=$(cat /audit-output/evidence/14-fresh-proof-workspace-path.txt)
lean_root=/opt/elan/toolchains/leanprover--lean4---v4.22.0
cd "$proof_audit_dir"
{
  echo '"'"'$ LD_PRELOAD=proc_self_exe_fix.so LEAN_SYSROOT=<pinned> LAKE_HOME=<pinned> lake lean Adversarial.lean'"'
  LD_PRELOAD=/tmp/audit-work/proc_self_exe_fix.so LEAN_SYSROOT=\""'$lean_root" LAKE_HOME="$lean_root" lake lean Adversarial.lean
  adversarial_code=$?
  echo "EXIT: $adversarial_code"
} > /audit-output/evidence/23-lean-adversarial-and-counterfactual.log 2>&1
cat /audit-output/evidence/23-lean-adversarial-and-counterfactual.log
exit "$adversarial_code"' in /tmp/audit-work
diff --git a//tmp/audit-work/68-pluck-proof.WmVtXE/Adversarial.lean b//tmp/audit-work/68-pluck-proof.WmVtXE/Adversarial.lean
new file mode 100644
index 0000000000000000000000000000000000000000..6e12d46485fcaa18d5d03a1292c18221672b083c
--- /dev/null
+++ b//tmp/audit-work/68-pluck-proof.WmVtXE/Adversarial.lean
@@ -0,0 +1,79 @@
+import Proof
+
+namespace Adversarial
+
+-- Ground checks of the candidate definitions.
+example : Proof.«_+Int_» (-3) 5 = 2 := by rfl
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (.inj_SortInt 7) (.inj_SortInt 2) = .inj_SortInt 9 := by
+  rfl
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "-" (.inj_SortInt 7) (.inj_SortInt 2) =
+        .«noneV_MPY-CORE_Val» := by
+  rfl
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (.inj_SortBool true) (.inj_SortInt 2) =
+        .«noneV_MPY-CORE_Val» := by
+  rfl
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      (.inj_SortInt 37) = true := by
+  rfl
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      (.inj_SortBool true) = false := by
+  rfl
+example : Proof.projectIntTotal (.inj_SortInt 37) = 37 := by rfl
+example :
+    Proof.projectIntTotal (.inj_SortBool true) = 0 := by
+  rfl
+example :
+    Proof.«project:Int?»
+      (.kseq ((@inj SortVal SortKItem) (.inj_SortInt 37)) .dotk) =
+        some 37 := by
+  rfl
+example :
+    Proof.«project:Int?»
+      (.kseq ((@inj SortVal SortKItem) (.inj_SortBool true)) .dotk) =
+        none := by
+  rfl
+
+-- Counterfactual definitions: they erase all integer values but still satisfy
+-- the exact generated target. This checks how much is left to the operational
+-- bridge audit rather than established by targetStatement itself.
+def badPlus (_left _right : SortInt) : SortInt := 0
+
+def badApplyBin
+    (operator : SortString) (left right : SortVal) : SortVal :=
+  match operator, left, right with
+  | "+", .inj_SortInt _, .inj_SortInt _ => .inj_SortInt 0
+  | _, _, _ => .«noneV_MPY-CORE_Val»
+
+def badDefined : SortVal → SortBool
+  | .inj_SortInt _ => true
+  | _ => false
+
+def badProjectTotal (_value : SortVal) : SortInt := 0
+
+def badProject : SortK → Option SortInt
+  | .kseq (.inj_SortInt _) .dotk => some 0
+  | _ => none
+
+theorem degenerateTarget :
+    Klean68Pluck.Lemmas.targetStatement
+      badPlus badApplyBin badDefined badProjectTotal badProject := by
+  constructor
+  · intro value
+    cases value <;>
+      exact
+        ⟨(fun isSome => ⟨isSome, True.intro⟩),
+         (fun isDefined => isDefined.1)⟩
+  · intro integer value isDefined
+    cases value <;> cases isDefined <;> rfl
+
+#print axioms Adversarial.degenerateTarget
+
+end Adversarial
