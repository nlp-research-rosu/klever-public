new file mode 100644
index 0000000000000000000000000000000000000000..6e12d46485fcaa18d5d03a1292c18221672b083c
--- /dev/null
+++ b//tmp/audit-work/68-pluck-proof.WmVtXE/Adversarial.lean
@@ -0,0 +1,79 @@
+import Proof
+
+namespace Adversarial
+
+-- Ground checks of the candidate definitions.
+example : Proof.«_+Int_» (-3) 5 = 2 := by rfl
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (.inj_SortInt 7) (.inj_SortInt 2) = .inj_SortInt 9 := by
+  rfl
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "-" (.inj_SortInt 7) (.inj_SortInt 2) =
+        .«noneV_MPY-CORE_Val» := by
+  rfl
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (.inj_SortBool true) (.inj_SortInt 2) =
+        .«noneV_MPY-CORE_Val» := by
+  rfl
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      (.inj_SortInt 37) = true := by
+  rfl
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      (.inj_SortBool true) = false := by
+  rfl
+example : Proof.projectIntTotal (.inj_SortInt 37) = 37 := by rfl
+example :
+    Proof.projectIntTotal (.inj_SortBool true) = 0 := by
+  rfl
+example :
+    Proof.«project:Int?»
+      (.kseq ((@inj SortVal SortKItem) (.inj_SortInt 37)) .dotk) =
+        some 37 := by
+  rfl
+example :
+    Proof.«project:Int?»
+      (.kseq ((@inj SortVal SortKItem) (.inj_SortBool true)) .dotk) =
+        none := by
+  rfl
+
+-- Counterfactual definitions: they erase all integer values but still satisfy
+-- the exact generated target. This checks how much is left to the operational
+-- bridge audit rather than established by targetStatement itself.
+def badPlus (_left _right : SortInt) : SortInt := 0
+
+def badApplyBin
+    (operator : SortString) (left right : SortVal) : SortVal :=
+  match operator, left, right with
+  | "+", .inj_SortInt _, .inj_SortInt _ => .inj_SortInt 0
+  | _, _, _ => .«noneV_MPY-CORE_Val»
+
+def badDefined : SortVal → SortBool
+  | .inj_SortInt _ => true
+  | _ => false
+
+def badProjectTotal (_value : SortVal) : SortInt := 0
+
+def badProject : SortK → Option SortInt
+  | .kseq (.inj_SortInt _) .dotk => some 0
+  | _ => none
+
+theorem degenerateTarget :
+    Klean68Pluck.Lemmas.targetStatement
+      badPlus badApplyBin badDefined badProjectTotal badProject := by
+  constructor
+  · intro value
+    cases value <;>
+      exact
+        ⟨(fun isSome => ⟨isSome, True.intro⟩),
+         (fun isDefined => isDefined.1)⟩
+  · intro integer value isDefined
+    cases value <;> cases isDefined <;> rfl
+
+#print axioms Adversarial.degenerateTarget
+
+end Adversarial
