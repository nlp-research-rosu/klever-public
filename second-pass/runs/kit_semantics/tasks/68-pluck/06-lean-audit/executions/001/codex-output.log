+            "klean_py_sha256": klean_hash,
+            "bundle_tree_sha256": pipeline_contract.sha256_tree(PRODUCERS),
+        },
+        "checks": results,
+    }
+    print(json.dumps(output, indent=2, sort_keys=True))
+
+
