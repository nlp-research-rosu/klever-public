+++ b//tmp/audit-work/independent_checks.py
@@ -0,0 +1,244 @@
+#!/usr/bin/env python3
+"""Independent structural and provenance checks for the 68-pluck audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import klean_export, lemma_discovery_contract, pipeline_contract
+from tools.k_rule_inventory import inventory_verification
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+WORKSPACE = Path("/reference/k-proof")
+DISCOVERY = Path("/reference/lemma-discovery.json")
+GENERATION = Path("/reference/klean-generation")
+GENERATED = GENERATION / "generated"
+PRODUCERS = Path("/reference/generation-tools")
+CANDIDATE = Path("/candidate")
+
+
+def file_sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def check(label: str, observed: object, expected: object) -> dict[str, object]:
+    return {
+        "label": label,
+        "ok": observed == expected,
+        "observed": observed,
+        "expected": expected,
+    }
+
+
+def main() -> None:
+    audit = json.loads(AUDIT_INPUT.read_text())["resolution"]
+    hashes = audit["hashes"]
+    discovery = json.loads(DISCOVERY.read_text())
+    generator = json.loads((GENERATION / "generator-manifest.json").read_text())
+    source_manifest = json.loads((PRODUCERS / "source-manifest.json").read_text())
+    inventory = inventory_verification(WORKSPACE)
+    validated = lemma_discovery_contract.validate_trust_boundary(
+        WORKSPACE, DISCOVERY
+    )
+
+    canonical_ids = [rule["source_rule_id"] for rule in inventory["rules"]]
+    classified_ids = [rule["source_rule_id"] for rule in discovery["rules"]]
+    canonical_rule_projection = [
+        {
+            key: rule[key]
+            for key in (
+                "source_rule_id",
+                "module",
+                "start_line",
+                "end_line",
+                "normalized_sha256",
+                "attributes",
+            )
+        }
+        for rule in inventory["rules"]
+    ]
+    validation_rule_projection = [
+        {
+            key: rule[key]
+            for key in (
+                "source_rule_id",
+                "module",
+                "start_line",
+                "end_line",
+                "normalized_sha256",
+                "attributes",
+            )
+        }
+        for category in (
+            "definitions",
+            "operational_rules",
+            "proved_derived_lemmas",
+            "domain_lemmas",
+        )
+        for rule in validated[category]
+    ]
+
+    producer_files = sorted(
+        path.name for path in PRODUCERS.iterdir() if path.is_file()
+    )
+    exporter_hash = file_sha256(PRODUCERS / "klean_export.py")
+    klean_hash = file_sha256(PRODUCERS / "klean.py")
+    generator_image_id = generator["provenance"]["generator_image_id"]
+    image_key = generator_image_id.removeprefix("sha256:")
+
+    observed_stage1_source_hashes = {
+        path.relative_to(WORKSPACE).as_posix(): file_sha256(path)
+        for path in pipeline_contract._walk_regular_files(
+            WORKSPACE, "Stage 1 workspace"
+        )
+    }
+
+    results = [
+        check("audit mode env/input", audit["mode"], "CLASSIFICATION_AND_PROOF"),
+        check("inventory schema", inventory["schema_version"], 2),
+        check("inventory module closure", inventory["verification_modules"], ["VERIFICATION"]),
+        check("inventory hash vs discovery", inventory["inventory_sha256"], discovery["inventory_sha256"]),
+        check("inventory IDs ordered exactly", classified_ids, canonical_ids),
+        check("inventory IDs unique", len(set(classified_ids)), len(classified_ids)),
+        check("inventory entry count", len(classified_ids), len(canonical_ids)),
+        check(
+            "trusted contract canonical fields",
+            sorted(
+                canonical_rule_projection,
+                key=lambda item: canonical_ids.index(item["source_rule_id"]),
+            ),
+            sorted(
+                validation_rule_projection,
+                key=lambda item: canonical_ids.index(item["source_rule_id"]),
+            ),
+        ),
+        check(
+            "verification.k SHA-256",
+            inventory["verification_sha256"],
+            file_sha256(WORKSPACE / "verification.k"),
+        ),
+        check(
+            "discovery file SHA-256",
+            file_sha256(DISCOVERY),
+            hashes["discovery_manifest_sha256"],
+        ),
+        check(
+            "Stage 1 export tree digest",
+            klean_export.tree_digest(WORKSPACE),
+            hashes["stage1_export_sha256"],
+        ),
+        check(
+            "Stage 1 export vs input manifest",
+            klean_export.tree_digest(WORKSPACE),
+            json.loads((GENERATION / "input-manifest.json").read_text())[
+                "stage1_workspace_sha256"
+            ],
+        ),
+        check(
+            "Stage 1 pipeline tree hash",
+            pipeline_contract.sha256_tree(WORKSPACE),
+            hashes["k_workspace_sha256"],
+        ),
+        check(
+            "Stage 1 complete source hash map",
+            observed_stage1_source_hashes,
+            audit["stage1_source_hashes"],
+        ),
+        check(
+            "Stage 2 selected audit tree hash",
+            pipeline_contract.sha256_tree(Path("/reference/k-audit")),
+            hashes["k_audit_sha256"],
+        ),
+        check(
+            "Stage 4 selected generation tree hash",
+            pipeline_contract.sha256_tree(GENERATION),
+            hashes["klean_generation_sha256"],
+        ),
+        check(
+            "generated project tree digest vs generator manifest",
+            klean_export.tree_digest(GENERATED),
+            generator["generated_tree_sha256"],
+        ),
+        check(
+            "generated project tree digest vs audit input",
+            klean_export.tree_digest(GENERATED),
+            hashes["generated_tree_sha256"],
+        ),
+        check(
+            "producer exact file set",
+            producer_files,
+            ["klean.py", "klean_export.py", "source-manifest.json"],
+        ),
+        check(
+            "klean_export.py hash vs source manifest",
+            exporter_hash,
+            source_manifest["files"]["klean_export.py"],
+        ),
+        check(
+            "klean_export.py hash vs generator manifest",
+            exporter_hash,
+            generator["exporter_sha256"],
+        ),
+        check(
+            "klean.py hash vs source manifest",
+            klean_hash,
+            source_manifest["files"]["klean.py"],
+        ),
+        check(
+            "klean.py hash vs generator manifest",
+            klean_hash,
+            generator["klean_py_sha256"],
+        ),
+        check(
+            "producer image source/generator manifests",
+            source_manifest["generator_image_id"],
+            generator_image_id,
+        ),
+        check(
+            "producer image ID recorded by audit bundle path",
+            Path(audit["generation_producer_sources"]).name,
+            image_key,
+        ),
+        check(
+            "producer bundle pipeline tree hash",
+            pipeline_contract.sha256_tree(PRODUCERS),
+            hashes["generation_producer_sources_sha256"],
+        ),
+        check(
+            "candidate Stage 5 workspace tree hash",
+            pipeline_contract.sha256_tree(CANDIDATE),
+            hashes["lean_workspace_sha256"],
+        ),
+    ]
+
+    failed = [result["label"] for result in results if not result["ok"]]
+    output = {
+        "status": "PASS" if not failed else "FAIL",
+        "failed": failed,
+        "inventory": {
+            "verification_module": inventory["verification_module"],
+            "verification_modules": inventory["verification_modules"],
+            "verification_sha256": inventory["verification_sha256"],
+            "inventory_sha256": inventory["inventory_sha256"],
+            "rule_count": len(inventory["rules"]),
+            "ordered_source_rule_ids": canonical_ids,
+            "domain_rule_ids": [
+                rule["source_rule_id"] for rule in validated["domain_lemmas"]
+            ],
+        },
+        "producer": {
+            "generator_image_id": generator_image_id,
+            "klean_export_sha256": exporter_hash,
+            "klean_py_sha256": klean_hash,
+            "bundle_tree_sha256": pipeline_contract.sha256_tree(PRODUCERS),
+        },
+        "checks": results,
+    }
+    print(json.dumps(output, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
