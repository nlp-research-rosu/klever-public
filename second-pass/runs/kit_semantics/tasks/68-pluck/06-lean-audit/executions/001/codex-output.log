@@ -0,0 +1,225 @@
+#!/usr/bin/env python3
+"""Independent Stage 4 obligation and target-identity checks."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from pathlib import Path
+
+from tools.klean_export import tree_digest
+
+
+GENERATION = Path("/reference/klean-generation")
+GENERATED = GENERATION / "generated"
+DISCOVERY = Path("/reference/lemma-discovery.json")
+AUDIT_INPUT = Path("/audit-input.json")
+FRESH = Path("/tmp/audit-work/68-pluck-proof.WmVtXE")
+
+
+def sha256_text(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def result(label: str, observed: object, expected: object) -> dict[str, object]:
+    return {
+        "label": label,
+        "ok": observed == expected,
+        "observed": observed,
+        "expected": expected,
+    }
+
+
+def main() -> None:
+    audit = json.loads(AUDIT_INPUT.read_text())["resolution"]
+    generator = json.loads((GENERATION / "generator-manifest.json").read_text())
+    obligation_map = json.loads(
+        (GENERATED / "obligation-map.json").read_text()
+    )
+    discovery = json.loads(DISCOVERY.read_text())
+    input_manifest = json.loads((GENERATION / "input-manifest.json").read_text())
+
+    independently_classified_domain_ids = [
+        "rule-0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
+        "rule-5a57a342f46c274d8d94d5f1c7eda4683981fbe24087e787e4a8ce7782c03167",
+    ]
+    source_rules = obligation_map["source_rules"]
+    obligations = obligation_map["obligations"]
+    source_ids = [entry["source_rule_id"] for entry in source_rules]
+    obligation_ids = [entry["source_rule_id"] for entry in obligations]
+
+    lines = ["def targetStatement"]
+    for parameter in obligation_map["trust_parameters"]:
+        lines.append(f'    ({parameter["name"]} : {parameter["type"]})')
+    lines.extend(
+        (
+            "    : Prop :=",
+            "    "
+            + "\n    ∧ ".join(
+                f'({obligation["lean_conjunct"]})'
+                for obligation in obligations
+            ),
+        )
+    )
+    independently_expected_definition = "\n".join(lines)
+
+    lemmas_text = (GENERATED / "Klean68Pluck/Lemmas.lean").read_text()
+    definitions = [
+        match.group(0).strip()
+        for match in re.finditer(
+            r"(?ms)^\s*def\s+targetStatement\b.*?"
+            r"(?=^\s*end\s+\S+\s*$)",
+            lemmas_text,
+        )
+    ]
+    extracted_definition = definitions[0] if len(definitions) == 1 else None
+    parameter_names = [
+        parameter["name"] for parameter in obligation_map["trust_parameters"]
+    ]
+    independently_expected_statement = " ".join(
+        [
+            "Klean68Pluck.Lemmas.targetStatement",
+            *parameter_names,
+        ]
+    )
+
+    proof_text = (FRESH / "Proof.lean").read_text()
+    theorem = re.search(
+        r"(?ms)^\s*theorem\s+final\s*:\s*(.*?)\s*:=\s*by\b",
+        proof_text,
+    )
+    final_statement = (
+        " ".join(theorem.group(1).split()) if theorem is not None else None
+    )
+
+    binding_hash_checks = []
+    for parameter in obligation_map["trust_parameters"]:
+        binding = {
+            key: parameter[key]
+            for key in ("kore_symbol", "name", "type", "source_rule_ids")
+        }
+        binding_hash_checks.append(
+            parameter["binding_sha256"]
+            == sha256_text(
+                json.dumps(binding, sort_keys=True, separators=(",", ":"))
+            )
+        )
+
+    source_by_id = {entry["source_rule_id"]: entry for entry in source_rules}
+    obligation_provenance_checks = []
+    for obligation in obligations:
+        source = source_by_id[obligation["source_rule_id"]]
+        obligation_provenance_checks.append(
+            {
+                "source_rule_id": obligation["source_rule_id"],
+                "span_ok": obligation["source_span"]
+                == {
+                    "start_line": source["start_line"],
+                    "end_line": source["end_line"],
+                },
+                "normalized_hash_ok": obligation["normalized_sha256"]
+                == source["normalized_sha256"],
+                "inventory_hash_ok": obligation["inventory_sha256"]
+                == source["inventory_sha256"]
+                == input_manifest["inventory_sha256"],
+                "discovery_hash_ok": obligation[
+                    "discovery_manifest_sha256"
+                ]
+                == source["discovery_manifest_sha256"]
+                == input_manifest["stage3_discovery_manifest_sha256"],
+                "conjunct_hash_ok": obligation["lean_conjunct_sha256"]
+                == sha256_text(obligation["lean_conjunct"]),
+            }
+        )
+
+    checks = [
+        result(
+            "source-rule IDs equal independent domain classification",
+            source_ids,
+            independently_classified_domain_ids,
+        ),
+        result(
+            "obligation IDs form exact ordered bijection",
+            obligation_ids,
+            source_ids,
+        ),
+        result(
+            "obligation IDs unique",
+            len(set(obligation_ids)),
+            len(obligation_ids),
+        ),
+        result(
+            "obligation count vs generator manifest",
+            len(obligations),
+            generator["obligation_count"],
+        ),
+        result(
+            "all obligation provenance and hashes",
+            all(
+                all(value for key, value in item.items() if key != "source_rule_id")
+                for item in obligation_provenance_checks
+            ),
+            True,
+        ),
+        result("all parameter binding hashes", all(binding_hash_checks), True),
+        result("single generated target definition", len(definitions), 1),
+        result(
+            "generated target is exact obligation conjunction",
+            extracted_definition,
+            independently_expected_definition,
+        ),
+        result(
+            "generated target definition hash",
+            sha256_text(extracted_definition or ""),
+            generator["target"]["definition_sha256"],
+        ),
+        result(
+            "generated target statement",
+            independently_expected_statement,
+            generator["target"]["statement"],
+        ),
+        result(
+            "generated target statement hash",
+            sha256_text(independently_expected_statement),
+            generator["target"]["statement_sha256"],
+        ),
+        result(
+            "generator target vs launcher target",
+            generator["target"],
+            audit["target"],
+        ),
+        result(
+            "fresh Base tree remains immutable",
+            tree_digest(FRESH / "Base"),
+            generator["generated_tree_sha256"],
+        ),
+        result(
+            "candidate final has exact fixed target application",
+            final_statement,
+            generator["target"]["statement"],
+        ),
+    ]
+
+    vacuous = [
+        {
+            "source_rule_id": obligation["source_rule_id"],
+            "lean_conjunct": obligation["lean_conjunct"],
+        }
+        for obligation in obligations
+        if re.search(r"(?:\(\s*True\s*\)|\bTrue\b)", obligation["lean_conjunct"])
+    ]
+    failed = [check["label"] for check in checks if not check["ok"]]
+    output = {
+        "structural_status": "PASS" if not failed else "FAIL",
+        "structural_failures": failed,
+        "checks": checks,
+        "obligation_provenance": obligation_provenance_checks,
+        "vacuous_conjunct_status": "FAIL" if vacuous else "PASS",
+        "vacuous_conjuncts": vacuous,
+    }
+    print(json.dumps(output, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()

