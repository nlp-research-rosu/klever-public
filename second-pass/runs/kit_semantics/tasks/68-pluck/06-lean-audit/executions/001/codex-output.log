+    audit = json.loads(AUDIT_INPUT.read_text())["resolution"]
+    hashes = audit["hashes"]
+    discovery = json.loads(DISCOVERY.read_text())
+    generator = json.loads((GENERATION / "generator-manifest.json").read_text())
+    source_manifest = json.loads((PRODUCERS / "source-manifest.json").read_text())
+    inventory = inventory_verification(WORKSPACE)
+    validated = lemma_discovery_contract.validate_trust_boundary(
+        WORKSPACE, DISCOVERY
+    )
+
+    canonical_ids = [rule["source_rule_id"] for rule in inventory["rules"]]
+    classified_ids = [rule["source_rule_id"] for rule in discovery["rules"]]
+    canonical_rule_projection = [
+        {
+            key: rule[key]
+            for key in (
+                "source_rule_id",
+                "module",
+                "start_line",
+                "end_line",
+                "normalized_sha256",
+                "attributes",
+            )
+        }
+        for rule in inventory["rules"]
+    ]
+    validation_rule_projection = [
+        {
+            key: rule[key]
+            for key in (
+                "source_rule_id",
+                "module",
+                "start_line",
+                "end_line",
+                "normalized_sha256",
+                "attributes",
+            )
+        }
+        for category in (
+            "definitions",
+            "operational_rules",
+            "proved_derived_lemmas",
+            "domain_lemmas",
+        )
+        for rule in validated[category]
+    ]
+
+    producer_files = sorted(
+        path.name for path in PRODUCERS.iterdir() if path.is_file()
+    )
+    exporter_hash = file_sha256(PRODUCERS / "klean_export.py")
+    klean_hash = file_sha256(PRODUCERS / "klean.py")
+    generator_image_id = generator["provenance"]["generator_image_id"]
+    image_key = generator_image_id.removeprefix("sha256:")
+
+    observed_stage1_source_hashes = {
+        path.relative_to(WORKSPACE).as_posix(): file_sha256(path)
+        for path in pipeline_contract._walk_regular_files(
+            WORKSPACE, "Stage 1 workspace"
+        )
+    }
+
+    results = [
+        check("audit mode env/input", audit["mode"], "CLASSIFICATION_AND_PROOF"),
