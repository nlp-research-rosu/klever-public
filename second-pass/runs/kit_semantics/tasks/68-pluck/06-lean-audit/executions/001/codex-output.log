diff --git a//tmp/audit-work/proc_self_exe_fix.c b//tmp/audit-work/proc_self_exe_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..7fd0775d2c15f93503279c466b9368631d848070
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_fix.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+/*
+ * The managed audit sandbox exposes /proc/self/exe but not the numerical PID
+ * path reported inside its PID namespace. Lean 4.22 uses /proc/<pid>/exe.
+ * Retry only that failed lookup through the equivalent /proc/self/exe link.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    int saved_errno = errno;
+    size_t length = strlen(path);
+    if (result < 0 && saved_errno == ENOENT &&
+        length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+        strcmp(path + length - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    errno = saved_errno;
+    return result;
+}
diff --git a//tmp/audit-work/readlink_trace.c b//tmp/audit-work/readlink_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..5315015e803b337c69189240ecb9682f71ad0e70
--- /dev/null
+++ b//tmp/audit-work/readlink_trace.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    int saved_errno = errno;
+    fprintf(stderr, "TRACE readlink(%s) = %zd errno=%d\n", path, result, saved_errno);
+    errno = saved_errno;
+    return result;
+}

