cat /audit-output/evidence/17-lake-clean-pinned.log
cat /audit-output/evidence/18-lake-build-pinned.log
printf '"'CLEAN_EXIT=%s BUILD_EXIT=%s\\n' \""'$clean_status" "$build_status"
