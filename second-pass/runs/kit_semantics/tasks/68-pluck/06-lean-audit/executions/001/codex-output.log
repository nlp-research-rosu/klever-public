+            audit["stage1_source_hashes"],
+        ),
+        check(
+            "Stage 2 selected audit tree hash",
+            pipeline_contract.sha256_tree(Path("/reference/k-audit")),
+            hashes["k_audit_sha256"],
+        ),
+        check(
+            "Stage 4 selected generation tree hash",
+            pipeline_contract.sha256_tree(GENERATION),
+            hashes["klean_generation_sha256"],
+        ),
+        check(
+            "generated project tree digest vs generator manifest",
+            klean_export.tree_digest(GENERATED),
+            generator["generated_tree_sha256"],
+        ),
+        check(
+            "generated project tree digest vs audit input",
+            klean_export.tree_digest(GENERATED),
+            hashes["generated_tree_sha256"],
+        ),
+        check(
+            "producer exact file set",
+            producer_files,
+            ["klean.py", "klean_export.py", "source-manifest.json"],
+        ),
+        check(
+            "klean_export.py hash vs source manifest",
+            exporter_hash,
+            source_manifest["files"]["klean_export.py"],
+        ),
+        check(
+            "klean_export.py hash vs generator manifest",
+            exporter_hash,
+            generator["exporter_sha256"],
+        ),
+        check(
+            "klean.py hash vs source manifest",
+            klean_hash,
+            source_manifest["files"]["klean.py"],
+        ),
+        check(
+            "klean.py hash vs generator manifest",
+            klean_hash,
+            generator["klean_py_sha256"],
+        ),
+        check(
+            "producer image source/generator manifests",
+            source_manifest["generator_image_id"],
+            generator_image_id,
+        ),
+        check(
+            "producer image ID recorded by audit bundle path",
+            Path(audit["generation_producer_sources"]).name,
+            image_key,
+        ),
+        check(
+            "producer bundle pipeline tree hash",
+            pipeline_contract.sha256_tree(PRODUCERS),
+            hashes["generation_producer_sources_sha256"],
+        ),
+        check(
+            "candidate Stage 5 workspace tree hash",
+            pipeline_contract.sha256_tree(CANDIDATE),
+            hashes["lean_workspace_sha256"],
+        ),
+    ]
+
+    failed = [result["label"] for result in results if not result["ok"]]
+    output = {
+        "status": "PASS" if not failed else "FAIL",
+        "failed": failed,
+        "inventory": {
+            "verification_module": inventory["verification_module"],
+            "verification_modules": inventory["verification_modules"],
+            "verification_sha256": inventory["verification_sha256"],
+            "inventory_sha256": inventory["inventory_sha256"],
+            "rule_count": len(inventory["rules"]),
+            "ordered_source_rule_ids": canonical_ids,
+            "domain_rule_ids": [
