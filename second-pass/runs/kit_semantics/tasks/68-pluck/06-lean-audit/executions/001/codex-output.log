/bin/bash -lc 'set +e
proof_audit_dir=$(cat /audit-output/evidence/14-fresh-proof-workspace-path.txt)
lean_root=/opt/elan/toolchains/leanprover--lean4---v4.22.0
cd "$proof_audit_dir"
{
