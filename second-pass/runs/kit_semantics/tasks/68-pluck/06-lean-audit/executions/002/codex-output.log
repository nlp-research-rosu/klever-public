diff --git a//tmp/audit-work/68-pluck-proof-audit-001/OperationalBridgeAudit.lean b//tmp/audit-work/68-pluck-proof-audit-001/OperationalBridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..a7940357cb113740e02fc3f66317aa2f2fc39275
--- /dev/null
+++ b//tmp/audit-work/68-pluck-proof-audit-001/OperationalBridgeAudit.lean
@@ -0,0 +1,145 @@
+import Proof
+
+namespace OperationalBridgeAudit
+
+set_option maxHeartbeats 2000000
+
+/- Ground checks on the exact operational domain used by 68-pluck. -/
+example : Proof.«_+Int_» (-7) 10 = 3 := by
+  rfl
+
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      (.inj_SortInt (-7)) = true := by
+  rfl
+
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      (.inj_SortBool true) = false := by
+  rfl
+
+example : Proof.projectIntTotal (.inj_SortInt (-7)) = -7 := by
+  rfl
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (.inj_SortInt (-7)) (.inj_SortInt 10)
+      = .inj_SortInt 3 := by
+  rfl
+
+example :
+    Proof.«project:Int?»
+      (.kseq ((@inj SortVal SortKItem) (.inj_SortInt (-7))) .dotk)
+      = some (-7) := by
+  rfl
+
+example :
+    Proof.«project:Int?»
+      (.kseq ((@inj SortVal SortKItem) (.inj_SortBool true)) .dotk)
+      = none := by
+  rfl
+
+/- Deliberately bad individual replacements are rejected by the target when
+   all other bindings retain their candidate definitions. -/
+def badAdd (_left _right : SortInt) : SortInt := 0
+
+example :
+    ¬ Klean68Pluck.Lemmas.targetStatement
+      badAdd
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      Proof.projectIntTotal
+      Proof.«project:Int?» := by
+  intro target
+  have bad := target.2 (1 : SortInt) (.inj_SortInt 2) (by rfl)
+  simp [
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»,
+    Proof.projectIntTotal,
+    badAdd
+  ] at bad
+
+def badApply (_operator : SortString) (_left _right : SortVal) : SortVal :=
+  .«noneV_MPY-CORE_Val»
+
+example :
+    ¬ Klean68Pluck.Lemmas.targetStatement
+      Proof.«_+Int_»
+      badApply
+      Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      Proof.projectIntTotal
+      Proof.«project:Int?» := by
+  intro target
+  have bad := target.2 (1 : SortInt) (.inj_SortInt 2) (by rfl)
+  simp [badApply, Proof.«_+Int_», Proof.projectIntTotal] at bad
+
+def badDefined (_value : SortVal) : SortBool := true
+
+example :
+    ¬ Klean68Pluck.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      badDefined
+      Proof.projectIntTotal
+      Proof.«project:Int?» := by
+  intro target
+  have bad := target.1 (.inj_SortBool true)
+  simp [badDefined, Proof.«project:Int?»] at bad
+
+def badProjectIntTotal (_value : SortVal) : SortInt := 0
+
+example :
+    ¬ Klean68Pluck.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      badProjectIntTotal
+      Proof.«project:Int?» := by
+  intro target
+  have bad := target.2 (1 : SortInt) (.inj_SortInt 2) (by rfl)
+  simp [
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»,
+    Proof.«_+Int_»,
+    badProjectIntTotal
+  ] at bad
+
+def badProject (_term : SortK) : Option SortInt := some 0
+
+example :
+    ¬ Klean68Pluck.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      Proof.projectIntTotal
+      badProject := by
+  intro target
+  have bad := target.1 (.inj_SortBool true)
+  simp [
+    badProject,
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+  ] at bad
+
+/- This wrong value projection preserves only the definedness property.  The
+   first Stage 4 obligation intentionally checks `isSome`, so the exact target
+   accepts this counterfactual.  The candidate itself does not use it: its
+   project:Int? returns the injected integer value exactly. -/
+def valueLosingProject : SortK → Option SortInt
+  | .kseq (.inj_SortInt _) .dotk => some 0
+  | _ => none
+
+example :
+    Klean68Pluck.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
+      Proof.projectIntTotal
+      valueLosingProject := by
+  constructor
+  · intro value
+    cases value <;>
+      exact
+        ⟨(fun isSome => ⟨isSome, True.intro⟩),
+         (fun isDefined => isDefined.1)⟩
+  · intro integer value isDefined
+    cases value <;> cases isDefined <;> rfl
+
+end OperationalBridgeAudit
