+    "all_checks_pass": (
+        all(producer_checks.values())
+        and all(
+            value
+            for key, value in inventory_checks.items()
+            if key
+            not in {
+                "verification_module",
+                "verification_modules",
+                "verification_sha256",
+                "inventory_sha256",
+                "manifest_inventory_sha256",
+                "inventory_id_count",
+                "manifest_id_count",
