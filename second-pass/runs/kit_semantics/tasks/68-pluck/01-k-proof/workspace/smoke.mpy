Module(
  FuncDef("pluck", Params("arr"),
    Assign(Name("smallest"), UnaryOp("-", Int(1)))
    Assign(Name("smallest_index"), Int(0))
    Assign(Name("index"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("arr"),
      Assign(Name("value"), BinOp("+", Name("value"), Int(0)))
      If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
        If(Compare(Name("smallest"), CmpOp("<", Int(0))),
          Assign(Name("smallest"), Name("value"))
          Assign(Name("smallest_index"), Name("index")),
          If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
            Assign(Name("smallest"), Name("value"))
            Assign(Name("smallest_index"), Name("index")),
            )),
        )
      AugAssign(Name("index"), "+", Int(1)))
    If(Compare(Name("smallest"), CmpOp("<", Int(0))),
      Return(ListExpr()),
      )
    Return(ListExpr(Name("smallest"), Name("smallest_index"))))
  Assert(
    Compare(
      Call(Name("pluck"), ListExpr(Int(4), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(2), Int(1)))))
  Assert(
    Compare(
      Call(Name("pluck"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(2), Int(1)))))
  Assert(
    Compare(Call(Name("pluck"), ListExpr()), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("pluck"),
        ListExpr(Int(5), Int(0), Int(3), Int(0), Int(4), Int(2))),
      CmpOp("==", ListExpr(Int(0), Int(1)))))
  Assert(
    Compare(
      Call(Name("pluck"), ListExpr(Int(2), Int(2))),
      CmpOp("==", ListExpr(Int(2), Int(0)))))
  Assert(
    Compare(
      Call(Name("pluck"), ListExpr(Int(1), Int(3), Int(5))),
      CmpOp("==", ListExpr()))))
