+                                   vCons(HEAD, REST), POS, P)))
+        "smallest_index" |-> (pickIndex(P)
+                              => pickIndex(scanPick(
+                                   vCons(HEAD, REST), POS, P)))
+        "index"          |-> (POS:Int
+                              => POS +Int vsLen(vCons(HEAD, REST)))
+        "value"          |-> (_OLD:Val => ?FINAL_VALUE:Val),
+        parent(0))
+      ...
+    </scopes>
+    requires POS >=Int 0
+      andBool HEAD >=Int 0
+      andBool allNonNegative(REST)
+      andBool validPick(P, POS)
+
+  claim [pluck-entry]:
+    <k>
+      Call(Name("pluck"), list(INPUT:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "pluck" |-> closureVal(
+          "arr",
+          Assign(Name("smallest"), UnaryOp("-", Int(1)))
+          Assign(Name("smallest_index"), Int(0))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(
+            Name("value"),
+            Name("arr"),
+            If(
+              Compare(
+                BinOp("%", Name("value"), Int(2)),
+                CmpOp("==", Int(0))),
+              If(
+                Compare(Name("smallest"), CmpOp("<", Int(0))),
+                Assign(Name("smallest"), Name("value"))
+                Assign(Name("smallest_index"), Name("index")),
+                If(
+                  Compare(Name("value"), CmpOp("<", Name("smallest"))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  .Stmts)),
+              .Stmts)
+            AugAssign(Name("index"), "+", Int(1)))
+          If(
+            Compare(Name("smallest"), CmpOp("<", Int(0))),
+            Return(ListExpr(.Exprs)),
+            .Stmts)
+          Return(ListExpr(Name("smallest"), Name("smallest_index"))),
+          0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> resultList(scanPick(INPUT, 0, noPick)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNonNegative(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..7b98b97f0c0e94246aea65626f9e94f1c218171c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,57 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact contract domain: finite list payloads containing only non-negative
+  // Python integers.  The owise case makes the predicate total on ValSeq.
+  syntax Bool ::= allNonNegative(ValSeq) [function, total]
+  rule allNonNegative(.ValSeq)                => true
+  rule allNonNegative(vCons(I:Int, R:ValSeq))
+    => I >=Int 0 andBool allNonNegative(R)
+  rule allNonNegative(vCons(_V:Val, _R:ValSeq)) => false [owise]
+
+  // A Pick is the mathematical state of the scan.  updatePick exactly mirrors
+  // the source loop: select the first even value, then replace it only with a
+  // strictly smaller even value.
+  syntax Pick ::= "noPick" | pick(Int, Int)
+
+  syntax Pick ::= updatePick(Pick, Int, Int) [function, total]
+  rule updatePick(noPick, V:Int, I:Int) => pick(V, I)
+    requires pyMod(V, 2) ==Int 0
+  rule updatePick(noPick, V:Int, _I:Int) => noPick
+    requires pyMod(V, 2) =/=Int 0
+  rule updatePick(pick(B:Int, _J:Int), V:Int, I:Int) => pick(V, I)
+    requires pyMod(V, 2) ==Int 0 andBool V <Int B
+  rule updatePick(pick(B:Int, J:Int), V:Int, _I:Int) => pick(B, J)
+    requires notBool (pyMod(V, 2) ==Int 0 andBool V <Int B)
+
+  syntax Pick ::= scanPick(ValSeq, Int, Pick) [function, total]
+  rule scanPick(.ValSeq, _I:Int, P:Pick) => P
+  rule scanPick(vCons(V:Int, R:ValSeq), I:Int, P:Pick)
+    => scanPick(R, I +Int 1, updatePick(P, V, I))
+  rule scanPick(vCons(_V:Val, R:ValSeq), I:Int, P:Pick)
+    => scanPick(R, I +Int 1, P)
+    [owise]
+
+  syntax Int ::= pickValue(Pick) [function, total]
+  rule pickValue(noPick)          => -1
+  rule pickValue(pick(V:Int, _))  => V
+
+  syntax Int ::= pickIndex(Pick) [function, total]
+  rule pickIndex(noPick)          => 0
+  rule pickIndex(pick(_V:Int, I:Int)) => I
+
+  syntax Bool ::= validPick(Pick, Int) [function, total]
+  rule validPick(noPick, _I:Int) => true
+  rule validPick(pick(V:Int, J:Int), I:Int)
+    => V >=Int 0
+       andBool pyMod(V, 2) ==Int 0
+       andBool J >=Int 0
+       andBool J <Int I
+
+  syntax Val ::= resultList(Pick) [function, total]
+  rule resultList(noPick) => list(.ValSeq)
+  rule resultList(pick(V:Int, I:Int))
+    => list(vCons(V, vCons(I, .ValSeq)))
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..544dc83d8454a90d430979cf4bf33a203e6a408d
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,28 @@
+def pluck(arr):
+    smallest = -1
+    smallest_index = 0
+    index = 0
+    value = 0
+
+    for value in arr:
+        if value % 2 == 0:
+            if smallest < 0:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+
+    if smallest < 0:
+        return []
+    return [smallest, smallest_index]
+
+
+assert pluck([4, 2, 3]) == [2, 1]
+assert pluck([1, 2, 3]) == [2, 1]
+assert pluck([]) == []
+assert pluck([5, 0, 3, 0, 4, 2]) == [0, 1]
+assert pluck([2, 2]) == [2, 0]
+assert pluck([1, 3, 5]) == []
