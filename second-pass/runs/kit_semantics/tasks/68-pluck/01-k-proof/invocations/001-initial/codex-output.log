+
+  claim [pluck-loop]:
+    <k>
+      #loop(
+        list(valsOf(REST:IntSeq)),
+        Name("value"),
+        If(
+          Compare(
+            BinOp("%", Name("value"), Int(2)),
+            CmpOp("==", Int(0))),
+          If(
+            Compare(Name("smallest"), CmpOp("<", Int(0))),
+            Assign(Name("smallest"), Name("value"))
+            Assign(Name("smallest_index"), Name("index")),
+            If(
+              Compare(Name("value"), CmpOp("<", Name("smallest"))),
+              Assign(Name("smallest"), Name("value"))
+              Assign(Name("smallest_index"), Name("index")),
+              .Stmts)),
+          .Stmts)
+        AugAssign(Name("index"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "arr"            |-> list(valsOf(ORIGINAL:IntSeq))
+        "smallest"       |-> (pickValue(P:Pick)
+                              => pickValue(scanPick(REST, POS, P)))
+        "smallest_index" |-> (pickIndex(P)
+                              => pickIndex(scanPick(REST, POS, P)))
+        "index"          |-> (POS:Int => POS +Int isLen(REST))
+        "value"          |-> (_OLD:Val => ?FINAL_VALUE:Val),
+        parent(0))
+      ...
+    </scopes>
+    requires POS >=Int 0
+      andBool allNonNegative(REST)
+      andBool validPick(P, POS)
+
+  claim [pluck-entry]:
+    <k>
+      Call(Name("pluck"), list(valsOf(INPUT:IntSeq)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "pluck" |-> closureVal(
+          "arr",
+          Assign(Name("smallest"), UnaryOp("-", Int(1)))
+          Assign(Name("smallest_index"), Int(0))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(
