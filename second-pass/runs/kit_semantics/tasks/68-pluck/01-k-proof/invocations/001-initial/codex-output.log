+        "smallest_index" |-> (pickIndex(P)
+                              => pickIndex(scanPick(REST, POS, P)))
+        "index"          |-> (POS:Int => POS +Int isLen(REST))
+        "value"          |-> (_OLD:Val => ?FINAL_VALUE:Val),
+        parent(0))
