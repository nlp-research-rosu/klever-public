diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..503d0d5b9ae53e4ea3fb0d86fd0c23743ea3dd04
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,57 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical input embedding: every finite IntSeq is represented by the
+  // corresponding Python list payload.
+  syntax ValSeq ::= valsOf(IntSeq) [function, total]
+  rule valsOf(.IntSeq)                => .ValSeq
+  rule valsOf(iCons(I:Int, R:IntSeq)) => vCons(I, valsOf(R))
+
+  syntax Bool ::= allNonNegative(IntSeq) [function, total]
+  rule allNonNegative(.IntSeq)                => true
+  rule allNonNegative(iCons(I:Int, R:IntSeq))
+    => I >=Int 0 andBool allNonNegative(R)
+
+  // A Pick is the mathematical state of the scan.  updatePick exactly mirrors
+  // the source loop: select the first even value, then replace it only with a
+  // strictly smaller even value.
+  syntax Pick ::= noPick | pick(Int, Int)
+
+  syntax Pick ::= updatePick(Pick, Int, Int) [function, total]
+  rule updatePick(noPick, V:Int, I:Int) => pick(V, I)
+    requires pyMod(V, 2) ==Int 0
+  rule updatePick(noPick, V:Int, _I:Int) => noPick
+    requires pyMod(V, 2) =/=Int 0
+  rule updatePick(pick(B:Int, _J:Int), V:Int, I:Int) => pick(V, I)
+    requires pyMod(V, 2) ==Int 0 andBool V <Int B
+  rule updatePick(pick(B:Int, J:Int), V:Int, _I:Int) => pick(B, J)
+    requires notBool (pyMod(V, 2) ==Int 0 andBool V <Int B)
+
+  syntax Pick ::= scanPick(IntSeq, Int, Pick) [function, total]
+  rule scanPick(.IntSeq, _I:Int, P:Pick) => P
+  rule scanPick(iCons(V:Int, R:IntSeq), I:Int, P:Pick)
+    => scanPick(R, I +Int 1, updatePick(P, V, I))
+
+  syntax Int ::= pickValue(Pick) [function, total]
+  rule pickValue(noPick)          => -1
+  rule pickValue(pick(V:Int, _))  => V
+
+  syntax Int ::= pickIndex(Pick) [function, total]
+  rule pickIndex(noPick)          => 0
+  rule pickIndex(pick(_V:Int, I:Int)) => I
+
+  syntax Bool ::= validPick(Pick, Int) [function, total]
+  rule validPick(noPick, _I:Int) => true
+  rule validPick(pick(V:Int, J:Int), I:Int)
+    => V >=Int 0
+       andBool pyMod(V, 2) ==Int 0
+       andBool J >=Int 0
+       andBool J <Int I
+
+  syntax Val ::= resultList(Pick) [function, total]
+  rule resultList(noPick) => list(.ValSeq)
+  rule resultList(pick(V:Int, I:Int))
+    => list(vCons(V, vCons(I, .ValSeq)))
+endmodule

