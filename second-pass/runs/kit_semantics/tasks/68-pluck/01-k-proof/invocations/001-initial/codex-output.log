index 0000000000000000000000000000000000000000..2d5dedf1958601d8267428aeb743e4d659b5fc84
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,21 @@
+def pluck(arr):
+    smallest = -1
+    smallest_index = 0
+    index = 0
+    value = 0
+
+    for value in arr:
+        value = value + 0
+        if value % 2 == 0:
+            if smallest < 0:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+
+    if smallest < 0:
+        return []
+    return [smallest, smallest_index]
