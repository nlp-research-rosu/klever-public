+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Deliberately false: when an even value exists, demand an index one larger
+  // than the index computed by the target theorem.
+  claim [pluck-entry-wrong-index]:
+    <k>
+      Call(Name("pluck"), list(INPUT:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "pluck" |-> closureVal(
+          "arr",
+          Assign(Name("smallest"), UnaryOp("-", Int(1)))
+          Assign(Name("smallest_index"), Int(0))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(
+            Name("value"),
+            Name("arr"),
+            Assign(Name("value"), BinOp("+", Name("value"), Int(0)))
+            If(
+              Compare(
+                BinOp("%", Name("value"), Int(2)),
+                CmpOp("==", Int(0))),
+              If(
+                Compare(Name("smallest"), CmpOp("<", Int(0))),
+                Assign(Name("smallest"), Name("value"))
+                Assign(Name("smallest_index"), Name("index")),
+                If(
+                  Compare(Name("value"), CmpOp("<", Name("smallest"))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  .Stmts)),
+              .Stmts)
+            AugAssign(Name("index"), "+", Int(1)))
+          If(
+            Compare(Name("smallest"), CmpOp("<", Int(0))),
+            Return(ListExpr(.Exprs)),
+            .Stmts)
+          Return(ListExpr(Name("smallest"), Name("smallest_index"))),
+          0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> resultList(
+                  scanBest(INPUT, 0, -1),
+                  scanBestIndex(INPUT, 0, -1, 0) +Int 1)
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNonNegative(INPUT)
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..32402af68d0d8b75aed1484fe6fcc512e95f91ab
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,110 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [pluck-loop]:
+    <k>
+      #loop(
+        list(vCons(HEAD:Val, REST:ValSeq)),
+        Name("value"),
+        Assign(Name("value"), BinOp("+", Name("value"), Int(0)))
+        If(
+          Compare(
+            BinOp("%", Name("value"), Int(2)),
+            CmpOp("==", Int(0))),
+          If(
+            Compare(Name("smallest"), CmpOp("<", Int(0))),
+            Assign(Name("smallest"), Name("value"))
+            Assign(Name("smallest_index"), Name("index")),
+            If(
+              Compare(Name("value"), CmpOp("<", Name("smallest"))),
+              Assign(Name("smallest"), Name("value"))
+              Assign(Name("smallest_index"), Name("index")),
+              .Stmts)),
+          .Stmts)
+        AugAssign(Name("index"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "arr"            |-> list(ORIGINAL:ValSeq)
+        "smallest"       |-> (BEST:Int
+                              => scanBest(
+                                   vCons(HEAD, REST), POS, BEST))
+        "smallest_index" |-> (BEST_INDEX:Int
+                              => scanBestIndex(
+                                   vCons(HEAD, REST),
+                                   POS,
+                                   BEST,
+                                   BEST_INDEX))
+        "index"          |-> (POS:Int
+                              => afterIndex(vCons(HEAD, REST), POS))
+        "value"          |-> (_OLD:Val => ?FINAL_VALUE:Val),
+        parent(0))
+      ...
+    </scopes>
+    requires POS >=Int 0
+      andBool definedProjectInt(HEAD)
+      andBool projectIntTotal(HEAD) >=Int 0
+      andBool allNonNegative(REST)
+
+  claim [pluck-entry]:
+    <k>
+      Call(Name("pluck"), list(INPUT:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "pluck" |-> closureVal(
+          "arr",
+          Assign(Name("smallest"), UnaryOp("-", Int(1)))
+          Assign(Name("smallest_index"), Int(0))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(
+            Name("value"),
+            Name("arr"),
+            Assign(Name("value"), BinOp("+", Name("value"), Int(0)))
+            If(
+              Compare(
+                BinOp("%", Name("value"), Int(2)),
+                CmpOp("==", Int(0))),
+              If(
+                Compare(Name("smallest"), CmpOp("<", Int(0))),
+                Assign(Name("smallest"), Name("value"))
+                Assign(Name("smallest_index"), Name("index")),
+                If(
+                  Compare(Name("value"), CmpOp("<", Name("smallest"))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  .Stmts)),
+              .Stmts)
+            AugAssign(Name("index"), "+", Int(1)))
+          If(
+            Compare(Name("smallest"), CmpOp("<", Int(0))),
+            Return(ListExpr(.Exprs)),
+            .Stmts)
+          Return(ListExpr(Name("smallest"), Name("smallest_index"))),
+          0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> resultList(
+                  scanBest(INPUT, 0, -1),
+                  scanBestIndex(INPUT, 0, -1, 0))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNonNegative(INPUT)
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea36e154d93ce4e5f981e4afab48b316c95f30cc
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,40 @@
+from itertools import product
+from random import Random
+
+from solution import pluck
+
+
+def oracle(arr):
+    candidates = [(value, index) for index, value in enumerate(arr)
+                  if value % 2 == 0]
+    if not candidates:
+        return []
+    value, index = min(candidates)
+    return [value, index]
+
+
+checked = 0
+
+for length in range(7):
+    for values in product(range(6), repeat=length):
+        arr = list(values)
+        assert pluck(arr) == oracle(arr), arr
+        checked += 1
+
+rng = Random(20260729)
+for _ in range(500):
+    length = rng.randrange(0, 201)
+    arr = [rng.randrange(0, 10001) for _ in range(length)]
+    assert pluck(arr) == oracle(arr), arr
+    checked += 1
+
+for arr in (
+    [1] * 10000,
+    [2] * 10000,
+    list(range(10000)),
+    list(reversed(range(10000))),
+):
+    assert pluck(arr) == oracle(arr)
+    checked += 1
+
+print(f"differential-tests: {checked} cases, 0 mismatches")
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1b4e25fd7517bead7fdae307e5a892bd1b9f6c1
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,96 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Guarded total projection from the dynamic Val sort to Int.  This is the
+  // standard total twin of K's partial subsort cast; it is used only under
+  // definedProjectInt and collapses on every statically known Int.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val))
+    => projectIntTotal(V)
+    [simplification]
+
+  // Guarded dispatch twin for the exact fixed rule
+  // applyBin("+", I1:Int, I2:Int) => I1 +Int I2.  It lets the source's
+  // value + 0 normalization refine a dynamically sorted list head.
+  rule applyBin("+", V:Val, I:Int)
+    => projectIntTotal(V) +Int I
+    requires definedProjectInt(V)
+    [simplification]
+
+  // Exact contract domain: finite list payloads containing only non-negative
+  // Python integers.
+  syntax Bool ::= allNonNegative(ValSeq) [function, total]
+  rule allNonNegative(.ValSeq) => true
+  rule allNonNegative(vCons(V:Val, R:ValSeq))
+    => definedProjectInt(V)
+       andBool projectIntTotal(V) >=Int 0
+       andBool allNonNegative(R)
+
+  // shouldTake exactly mirrors the nested source condition.  A negative
+  // current best is the source sentinel; otherwise only a strictly smaller
+  // even value replaces it.
+  syntax Bool ::= shouldTake(Int, Int) [function, total]
+  rule shouldTake(B:Int, V:Int)
+    => pyMod(V, 2) ==Int 0
+       andBool (B <Int 0 orBool V <Int B)
+
+  syntax Int ::= nextBest(Int, Int) [function, total]
+  rule nextBest(B:Int, V:Int) => V
+    requires shouldTake(B, V)
+  rule nextBest(B:Int, V:Int) => B
+    requires notBool shouldTake(B, V)
+
+  syntax Int ::= nextBestIndex(Int, Int, Int, Int) [function, total]
+  rule nextBestIndex(B:Int, _J:Int, V:Int, I:Int) => I
+    requires shouldTake(B, V)
+  rule nextBestIndex(B:Int, J:Int, V:Int, _I:Int) => J
+    requires notBool shouldTake(B, V)
+
+  syntax Int ::= scanBest(ValSeq, Int, Int) [function, total]
+  rule scanBest(.ValSeq, _I:Int, B:Int) => B
+  rule scanBest(vCons(V:Val, R:ValSeq), I:Int, B:Int)
+    => scanBest(R, I +Int 1, nextBest(B, projectIntTotal(V)))
+
+  syntax Int ::= scanBestIndex(ValSeq, Int, Int, Int)
+    [function, total]
+  rule scanBestIndex(.ValSeq, _I:Int, _B:Int, J:Int) => J
+  rule scanBestIndex(
+         vCons(V:Val, R:ValSeq), I:Int, B:Int, J:Int)
+    => scanBestIndex(
+         R,
+         I +Int 1,
+         nextBest(B, projectIntTotal(V)),
+         nextBestIndex(B, J, projectIntTotal(V), I))
+
+  syntax Int ::= afterIndex(ValSeq, Int) [function, total]
+  rule afterIndex(.ValSeq, I:Int) => I
+  rule afterIndex(vCons(_V:Val, R:ValSeq), I:Int)
+    => afterIndex(R, I +Int 1)
+
+  syntax Val ::= resultList(Int, Int) [function, total]
+  rule resultList(B:Int, _J:Int) => list(.ValSeq)
+    requires B <Int 0
+  rule resultList(B:Int, J:Int)
+    => list(vCons(B, vCons(J, .ValSeq)))
+    requires B >=Int 0
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2dc9524f1e95714a5a3790ed458c4cf93d79c1ea
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun smoke.mpy --definition runtime-kompiled
+python3 test_solution.py
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.pluck-loop
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY
+then
+  echo "ERROR: false-postcondition mutation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-postcondition mutation was rejected"
+fi
+
+if kprove spec-body-mutation.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-BODY-MUTATION
+then
+  echo "ERROR: mutated implementation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: mutated implementation was rejected"
+fi
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e0b1c5856e1fbaa6877d0026b358aa55d67a37e
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,29 @@
+def pluck(arr):
+    smallest = -1
+    smallest_index = 0
+    index = 0
+    value = 0
+
+    for value in arr:
+        value = value + 0
+        if value % 2 == 0:
+            if smallest < 0:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+
+    if smallest < 0:
+        return []
+    return [smallest, smallest_index]
+
+
+assert pluck([4, 2, 3]) == [2, 1]
+assert pluck([1, 2, 3]) == [2, 1]
+assert pluck([]) == []
+assert pluck([5, 0, 3, 0, 4, 2]) == [0, 1]
+assert pluck([2, 2]) == [2, 0]
+assert pluck([1, 3, 5]) == []
