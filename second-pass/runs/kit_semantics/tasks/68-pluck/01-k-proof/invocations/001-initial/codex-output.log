+    for value in arr:
+        value = value + 0
+        if value % 2 == 0:
+            if smallest < 0:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+
+    if smallest < 0:
+        return []
+    return [smallest, smallest_index]
+
