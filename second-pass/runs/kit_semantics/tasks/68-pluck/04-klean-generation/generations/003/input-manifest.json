{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
      "rationale": "Defines the local cast-domain predicate definedProjectInt directly as the imported Int sort predicate isInt.",
      "source_rule_id": "rule-9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
      "start_line": 10,
      "text": "  rule definedProjectInt(V:Val) => isInt(V)"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "rationale": "Guardedly defines the local named proof term projectIntTotal by the existing partial Int projection on its declared domain.",
      "source_rule_id": "rule-ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "start_line": 19,
      "text": "  rule projectIntTotal(V:Val) => {V}:>Int\n    requires definedProjectInt(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
      "rationale": "Provides the symbolic normalization orientation of the same guarded projectIntTotal definition, naming a defined partial cast with the local proof term.",
      "source_rule_id": "rule-22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
      "start_line": 23,
      "text": "  rule {V:Val}:>Int => projectIntTotal(V)\n    requires definedProjectInt(V)\n    [symbolic(V), simplification, preserves-definedness]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
      "rationale": "Defines the projection helper on an already statically typed Int by collapsing it to that Int.",
      "source_rule_id": "rule-7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
      "start_line": 27,
      "text": "  rule projectIntTotal(I:Int) => I [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "9e1486b6d25b62bd0949213fd58d7aac97ed89cc3e87b8c5063f915d1d6b7081",
      "rationale": "Supplies a structural normalization equation for the local projection helper, making nested projection applications idempotent.",
      "source_rule_id": "rule-9e1486b6d25b62bd0949213fd58d7aac97ed89cc3e87b8c5063f915d1d6b7081",
      "start_line": 28,
      "text": "  rule projectIntTotal(projectIntTotal(V:Val))\n    => projectIntTotal(V)\n    [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "cf4138b8c8c76302d40452525511bd8b4e31a4b3346bb98e6e73d97d1e6c2974",
      "rationale": "Defines the empty-sequence base case of the recursive allNonNegative input-domain predicate.",
      "source_rule_id": "rule-cf4138b8c8c76302d40452525511bd8b4e31a4b3346bb98e6e73d97d1e6c2974",
      "start_line": 43,
      "text": "  rule allNonNegative(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION",
      "normalized_sha256": "83288e0b3172aab26d1ec54ec969884572eed5ce44f6238f19681d654d51ef2e",
      "rationale": "Defines the nonempty recursive case of allNonNegative by checking the head and recurring on the tail.",
      "source_rule_id": "rule-83288e0b3172aab26d1ec54ec969884572eed5ce44f6238f19681d654d51ef2e",
      "start_line": 44,
      "text": "  rule allNonNegative(vCons(V:Val, R:ValSeq))\n    => definedProjectInt(V)\n       andBool projectIntTotal(V) >=Int 0\n       andBool allNonNegative(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 55,
      "module": "VERIFICATION",
      "normalized_sha256": "7e939de20504830e917b8d5d873c3bb58561f3855213d88b9d59b50ef33c4bd5",
      "rationale": "Defines the mathematical shouldTake condition that mirrors the source loop's evenness, sentinel, and strict-minimum test.",
      "source_rule_id": "rule-7e939de20504830e917b8d5d873c3bb58561f3855213d88b9d59b50ef33c4bd5",
      "start_line": 53,
      "text": "  rule shouldTake(B:Int, V:Int)\n    => pyMod(V, 2) ==Int 0\n       andBool (B <Int 0 orBool V <Int B)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 59,
      "module": "VERIFICATION",
      "normalized_sha256": "5252890cd97149023a2a416ba7c01b694a8ff30898028588da15ee87b14a256c",
      "rationale": "Defines nextBest in the selecting branch by returning the current candidate value.",
      "source_rule_id": "rule-5252890cd97149023a2a416ba7c01b694a8ff30898028588da15ee87b14a256c",
      "start_line": 58,
      "text": "  rule nextBest(B:Int, V:Int) => V\n    requires shouldTake(B, V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 61,
      "module": "VERIFICATION",
      "normalized_sha256": "a50201bce4854fcc39ac7fff337c62431472104dcb3835fba7f50ce031f797bc",
      "rationale": "Defines nextBest in the complementary nonselecting branch by preserving the previous best value.",
      "source_rule_id": "rule-a50201bce4854fcc39ac7fff337c62431472104dcb3835fba7f50ce031f797bc",
      "start_line": 60,
      "text": "  rule nextBest(B:Int, V:Int) => B\n    requires notBool shouldTake(B, V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 65,
      "module": "VERIFICATION",
      "normalized_sha256": "c92176e0f4b06badc71e64610b3f95be15c41c7b6a9f7ffc01c22e0063ad9616",
      "rationale": "Defines nextBestIndex in the selecting branch by returning the current scan index.",
      "source_rule_id": "rule-c92176e0f4b06badc71e64610b3f95be15c41c7b6a9f7ffc01c22e0063ad9616",
      "start_line": 64,
      "text": "  rule nextBestIndex(B:Int, _J:Int, V:Int, I:Int) => I\n    requires shouldTake(B, V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 67,
      "module": "VERIFICATION",
      "normalized_sha256": "8f2ab2609b1cc09149865009919218835e409941c760e0cd32d7cd314e854fd4",
      "rationale": "Defines nextBestIndex in the complementary nonselecting branch by preserving the previous index.",
      "source_rule_id": "rule-8f2ab2609b1cc09149865009919218835e409941c760e0cd32d7cd314e854fd4",
      "start_line": 66,
      "text": "  rule nextBestIndex(B:Int, J:Int, V:Int, _I:Int) => J\n    requires notBool shouldTake(B, V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 70,
      "module": "VERIFICATION",
      "normalized_sha256": "9e8ff4eeadc760fef596dec38dede08f7dc277396d3bf2a83be796e4bea29ae9",
      "rationale": "Defines the empty-sequence base case of the scanBest recurrence.",
      "source_rule_id": "rule-9e8ff4eeadc760fef596dec38dede08f7dc277396d3bf2a83be796e4bea29ae9",
      "start_line": 70,
      "text": "  rule scanBest(.ValSeq, _I:Int, B:Int) => B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 72,
      "module": "VERIFICATION",
      "normalized_sha256": "17aa23fd17bc416e79da19dd2b02377da50a1a774104a3df16adb8cb3f6f753c",
      "rationale": "Defines the nonempty scanBest recurrence by consuming one element, advancing the index, and updating the accumulator.",
      "source_rule_id": "rule-17aa23fd17bc416e79da19dd2b02377da50a1a774104a3df16adb8cb3f6f753c",
      "start_line": 71,
      "text": "  rule scanBest(vCons(V:Val, R:ValSeq), I:Int, B:Int)\n    => scanBest(R, I +Int 1, nextBest(B, projectIntTotal(V)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 76,
      "module": "VERIFICATION",
      "normalized_sha256": "a0a97ed4baae5f006d554885ce763a55d1f90f4dab1c6758f4f16e425d1fdf7e",
      "rationale": "Defines the empty-sequence base case of the scanBestIndex recurrence.",
      "source_rule_id": "rule-a0a97ed4baae5f006d554885ce763a55d1f90f4dab1c6758f4f16e425d1fdf7e",
      "start_line": 76,
      "text": "  rule scanBestIndex(.ValSeq, _I:Int, _B:Int, J:Int) => J"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 83,
      "module": "VERIFICATION",
      "normalized_sha256": "7b59a9d33a341d5cac01e67da9523b88afc82daf3321b530741d506a69c5837d",
      "rationale": "Defines the nonempty scanBestIndex recurrence while threading the updated best value, best index, and next position.",
      "source_rule_id": "rule-7b59a9d33a341d5cac01e67da9523b88afc82daf3321b530741d506a69c5837d",
      "start_line": 77,
      "text": "  rule scanBestIndex(\n         vCons(V:Val, R:ValSeq), I:Int, B:Int, J:Int)\n    => scanBestIndex(\n         R,\n         I +Int 1,\n         nextBest(B, projectIntTotal(V)),\n         nextBestIndex(B, J, projectIntTotal(V), I))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 86,
      "module": "VERIFICATION",
      "normalized_sha256": "c38110c90d754cdfc7a715c9dae55a5663f8de024b1fb80fce7a0c7835cf4e4b",
      "rationale": "Defines afterIndex on an empty remaining sequence as the current index.",
      "source_rule_id": "rule-c38110c90d754cdfc7a715c9dae55a5663f8de024b1fb80fce7a0c7835cf4e4b",
      "start_line": 86,
      "text": "  rule afterIndex(.ValSeq, I:Int) => I"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 88,
      "module": "VERIFICATION",
      "normalized_sha256": "60bf2bc0542914c544a3f677f13fe17eda968f8750e2064ce8b7c3e8d0999339",
      "rationale": "Defines the recursive afterIndex case by consuming one sequence element and incrementing the index.",
      "source_rule_id": "rule-60bf2bc0542914c544a3f677f13fe17eda968f8750e2064ce8b7c3e8d0999339",
      "start_line": 87,
      "text": "  rule afterIndex(vCons(_V:Val, R:ValSeq), I:Int)\n    => afterIndex(R, I +Int 1)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 92,
      "module": "VERIFICATION",
      "normalized_sha256": "be6c5e486b28b9205e812b1977ae6d9af5349c88576c0eff80505fee2716790c",
      "rationale": "Defines resultList for the negative no-selection sentinel as the empty Python-list value.",
      "source_rule_id": "rule-be6c5e486b28b9205e812b1977ae6d9af5349c88576c0eff80505fee2716790c",
      "start_line": 91,
      "text": "  rule resultList(B:Int, _J:Int) => list(.ValSeq)\n    requires B <Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 95,
      "module": "VERIFICATION",
      "normalized_sha256": "615dd6754d1e5de3108d82927712a0b9350d18eb111423ada2109218959edb7d",
      "rationale": "Defines resultList for a selected nonnegative best value as the two-element value-and-index list.",
      "source_rule_id": "rule-615dd6754d1e5de3108d82927712a0b9350d18eb111423ada2109218959edb7d",
      "start_line": 93,
      "text": "  rule resultList(B:Int, J:Int)\n    => list(vCons(B, vCons(J, .ValSeq)))\n    requires B >=Int 0"
    }
  ],
