      "module": "VERIFICATION",
      "normalized_sha256": "0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
      "rationale": "Adds an unproved simplification characterizing the definedness of the imported partial Val-to-Int cast; Stage 1 supplies no prior rule-free proof of this exact rule.",
      "source_rule_id": "rule-0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
      "start_line": 15,
      "text": "  rule #Ceil({@V:Val}:>Int)\n    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "c914614b6c9e5bfe5500400cb24ad341982748ddd4a9bef857a2e2d423f6d63b",
      "end_line": 38,
      "inventory_sha256": "db923cb4995eb9590d6a8f9ef245d3fdf66930a46476128f1053a8d3903bf90a",
      "module": "VERIFICATION",
      "normalized_sha256": "5a57a342f46c274d8d94d5f1c7eda4683981fbe24087e787e4a8ce7782c03167",
      "rationale": "Extends the imported applyBin operation with an unproved guarded simplification over dynamically sorted Val operands; prove.sh never proves this exact correspondence in a module excluding the rule.",
      "source_rule_id": "rule-5a57a342f46c274d8d94d5f1c7eda4683981fbe24087e787e4a8ce7782c03167",
      "start_line": 35,
      "text": "  rule applyBin(\"+\", V:Val, I:Int)\n    => projectIntTotal(V) +Int I\n    requires definedProjectInt(V)\n    [simplification]"
    }
