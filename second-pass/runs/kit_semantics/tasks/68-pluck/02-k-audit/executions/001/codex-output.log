    35	    """

--- /reference/canonical.py ---
     1	# canonical.py — the UNMODIFIED HumanEval/68 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: pluck
     4	
     5	
     6	def pluck(arr):
     7	    """
     8	    "Given an array representing a branch of a tree that has non-negative integer nodes
     9	    your task is to pluck one of the nodes and return it.
    10	    The plucked node should be the node with the smallest even value.
    11	    If multiple nodes with the same smallest even value are found return the node that has smallest index.
    12	
    13	    The plucked node should be returned in a list, [ smalest_value, its index ],
    14	    If there are no even values or the given array is empty, return [].
    15	
    16	    Example 1:
    17	        Input: [4,2,3]
    18	        Output: [2, 1]
    19	        Explanation: 2 has the smallest even value, and 2 has the smallest index.
    20	
    21	    Example 2:
    22	        Input: [1,2,3]
    23	        Output: [2, 1]
    24	        Explanation: 2 has the smallest even value, and 2 has the smallest index. 
    25	
    26	    Example 3:
    27	        Input: []
    28	        Output: []
    29	    
    30	    Example 4:
    31	        Input: [5, 0, 3, 0, 4, 2]
    32	        Output: [0, 1]
    33	        Explanation: 0 is the smallest value, but  there are two zeros,
    34	                     so we will choose the first zero, which has the smallest index.
    35	
    36	    Constraints:
    37	        * 1 <= nodes.length <= 10000
    38	        * 0 <= node.value
    39	    """
    40	    if(len(arr) == 0): return []
    41	    evens = list(filter(lambda x: x%2 == 0, arr))
    42	    if(evens == []): return []
    43	    return [min(evens), arr.index(min(evens))]

