    24	assert pluck([4, 2, 3]) == [2, 1]
    25	assert pluck([1, 2, 3]) == [2, 1]
    26	assert pluck([]) == []
    27	assert pluck([5, 0, 3, 0, 4, 2]) == [0, 1]
    28	assert pluck([2, 2]) == [2, 0]
    29	assert pluck([1, 3, 5]) == []
     1	Module(
     2	  FuncDef("pluck", Params("arr"),
     3	    Assign(Name("smallest"), UnaryOp("-", Int(1)))
     4	    Assign(Name("smallest_index"), Int(0))
