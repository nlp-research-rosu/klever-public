new file mode 100644
index 0000000000000000000000000000000000000000..517878f6b391aca17f9519f7ede5154448c389e5
--- /dev/null
+++ b//tmp/audit-work/68-pluck/audit-witness.py
@@ -0,0 +1,29 @@
+def pluck(arr):
+    smallest = -1
+    smallest_index = 0
+    index = 0
+    value = 0
+
+    for value in arr:
+        value = value + 0
+        if value % 2 == 0:
+            if smallest < 0:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+
+    if smallest < 0:
+        return []
+    return [smallest, smallest_index]
+
+
+assert pluck([]) == []
+assert pluck([0]) == [0, 0]
+assert pluck([1]) == []
+assert pluck([4, 2, 3]) == [2, 1]
+assert pluck([2, 2]) == [2, 0]
+assert pluck([5, 0, 3, 0, 4, 2]) == [0, 1]
