+  claim [guarded-projection-connection]:
+    <k> projectIntTotal(V:Val) => {V}:>Int </k>
+    requires definedProjectInt(V)
+
+  // The candidate's applyBin("+", Val, Int) simplifier is intentionally absent
+  // from PROJECTION-BASE. This claim must close using fixed MPY integer addition
+  // plus the guarded projection laws only.
+  claim [guarded-addition-connection]:
+    <k>
+      applyBin("+", V:Val, I:Int)
+      => projectIntTotal(V) +Int I
+    </k>
+    requires definedProjectInt(V)
+
+  claim [ground-projection-seven]:
+    <k> projectIntTotal(7) => 7 </k>
+endmodule
