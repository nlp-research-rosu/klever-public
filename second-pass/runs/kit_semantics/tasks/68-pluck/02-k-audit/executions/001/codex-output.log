+#!/usr/bin/env bash
+set -u
+
+run_logged() {
+  local label="$1"
+  shift
+  local log="/audit-output/evidence/${label}.log"
+  {
+    printf 'CWD: %s\n' "$PWD"
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+    "$@"
+    local status=$?
+    printf 'EXIT_STATUS: %d\n' "$status"
+    return "$status"
+  } >"$log" 2>&1
+}
+
+cd /audit-output || exit 90
+run_logged 01-provenance python3 /audit-output/evidence/provenance_check.py
+provenance_status=$?
+
+cd /tmp/audit-work/68-pluck || exit 91
+run_logged 02-translate bash -c \
+  'python3 py2mpy.py solution.py > regenerated-solution.mpy && cmp -s regenerated-solution.mpy solution.mpy && sha256sum regenerated-solution.mpy solution.mpy'
+translation_status=$?
+run_logged 03-differential python3 /audit-output/evidence/differential_test.py
+differential_status=$?
+
+printf 'provenance=%d translation=%d differential=%d\n' \
+  "$provenance_status" "$translation_status" "$differential_status"
+if (( provenance_status != 0 || translation_status != 0 || differential_status != 0 )); then
+  exit 1
+fi
diff --git a/evidence/run_stage3.sh b/evidence/run_stage3.sh
new file mode 100644
index 0000000000000000000000000000000000000000..709980051ca6f046c9acc359ca419d36fc8e1819
--- /dev/null
+++ b/evidence/run_stage3.sh
@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+set -u
+
+run_logged() {
+  local label="$1"
+  shift
+  local log="/audit-output/evidence/${label}.log"
+  {
+    printf 'CWD: %s\n' "$PWD"
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+    "$@"
+    local status=$?
+    printf 'EXIT_STATUS: %d\n' "$status"
+    return "$status"
+  } >"$log" 2>&1
+}
+
+cd /tmp/audit-work/68-pluck || exit 90
+
+if [[ -e audit-verification-kompiled ]]; then
+  printf 'Refusing to reuse pre-existing audit-verification-kompiled\n' >&2
+  exit 91
+fi
+
+run_logged 04-kompile-proof \
+  kompile verification.k \
+    --backend haskell \
+    --main-module VERIFICATION \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-verification-kompiled
+build_status=$?
+
+if (( build_status != 0 )); then
+  printf 'build=%d\n' "$build_status"
+  exit 1
+fi
+
+run_logged 05-kprove-loop \
+  kprove spec.k \
+    --definition audit-verification-kompiled \
+    --spec-module SPEC \
+    --claims SPEC.pluck-loop
+loop_status=$?
+
+run_logged 06-kprove-entry \
+  kprove spec.k \
+    --definition audit-verification-kompiled \
+    --spec-module SPEC \
+    --claims SPEC.pluck-entry
+entry_status=$?
+
+run_logged 07-kprove-all \
+  kprove spec.k \
+    --definition audit-verification-kompiled \
+    --spec-module SPEC
+all_status=$?
+
+printf 'build=%d loop=%d entry=%d all=%d\n' \
+  "$build_status" "$loop_status" "$entry_status" "$all_status"
+
+if (( loop_status != 0 || entry_status != 0 || all_status != 0 )); then
+  exit 1
+fi

diff --git a//tmp/audit-work/68-pluck/audit-witness.py b//tmp/audit-work/68-pluck/audit-witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..517878f6b391aca17f9519f7ede5154448c389e5
--- /dev/null
+++ b//tmp/audit-work/68-pluck/audit-witness.py
@@ -0,0 +1,29 @@
+def pluck(arr):
+    smallest = -1
+    smallest_index = 0
+    index = 0
+    value = 0
+
+    for value in arr:
+        value = value + 0
+        if value % 2 == 0:
+            if smallest < 0:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+
+    if smallest < 0:
+        return []
+    return [smallest, smallest_index]
+
+
+assert pluck([]) == []
+assert pluck([0]) == [0, 0]
+assert pluck([1]) == []
+assert pluck([4, 2, 3]) == [2, 1]
+assert pluck([2, 2]) == [2, 0]
+assert pluck([5, 0, 3, 0, 4, 2]) == [0, 1]
diff --git a//tmp/audit-work/68-pluck/spec-ground-summaries.k b//tmp/audit-work/68-pluck/spec-ground-summaries.k
new file mode 100644
index 0000000000000000000000000000000000000000..33520c561d9efa7d6847c317b2228b51fba10fa8
--- /dev/null
+++ b//tmp/audit-work/68-pluck/spec-ground-summaries.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module SPEC-GROUND-SUMMARIES
+  imports VERIFICATION
+
+  claim [summary-empty]:
+    <k>
+      resultList(
+        scanBest(.ValSeq, 0, -1),
+        scanBestIndex(.ValSeq, 0, -1, 0))
+      => list(.ValSeq)
+    </k>
+    requires allNonNegative(.ValSeq)
+
+  claim [summary-zero]:
+    <k>
+      resultList(
+        scanBest(vCons(0, .ValSeq), 0, -1),
+        scanBestIndex(vCons(0, .ValSeq), 0, -1, 0))
+      => list(vCons(0, vCons(0, .ValSeq)))
+    </k>
+    requires allNonNegative(vCons(0, .ValSeq))
+
+  claim [summary-no-even]:
+    <k>
+      resultList(
+        scanBest(vCons(1, vCons(3, .ValSeq)), 0, -1),
+        scanBestIndex(vCons(1, vCons(3, .ValSeq)), 0, -1, 0))
+      => list(.ValSeq)
+    </k>
+    requires allNonNegative(vCons(1, vCons(3, .ValSeq)))
+
+  claim [summary-smaller-replaces]:
+    <k>
+      resultList(
+        scanBest(vCons(4, vCons(2, vCons(3, .ValSeq))), 0, -1),
+        scanBestIndex(
+          vCons(4, vCons(2, vCons(3, .ValSeq))), 0, -1, 0))
+      => list(vCons(2, vCons(1, .ValSeq)))
+    </k>
+    requires allNonNegative(vCons(4, vCons(2, vCons(3, .ValSeq))))
+
+  claim [summary-equal-preserves-first]:
+    <k>
+      resultList(
+        scanBest(vCons(2, vCons(2, .ValSeq)), 0, -1),
+        scanBestIndex(vCons(2, vCons(2, .ValSeq)), 0, -1, 0))
+      => list(vCons(2, vCons(0, .ValSeq)))
+    </k>
+    requires allNonNegative(vCons(2, vCons(2, .ValSeq)))
+endmodule
