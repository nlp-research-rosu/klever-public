+module SPEC-PROJECTION-CONNECTION-TYPED
+  imports PROJECTION-BASE
+
+  // Guarded Val-to-Int projection identity.
+  claim [guarded-projection-connection]:
+    <k> projectIntTotal(V:Val) => {V}:>Int </k>
+    requires definedProjectInt(V)
+
+  // Universal fixed-semantics domain: both operands are statically Int.
+  // The candidate applyBin simplifier is absent from PROJECTION-BASE.
+  claim [typed-addition-connection]:
+    <k>
+      applyBin("+", J:Int, I:Int)
+      => projectIntTotal(J) +Int I
+    </k>
