set +e
run_one() {
  label="$1"; shift
  log="/audit-output/evidence/${label}.log"
  { printf '"'CWD: %s\\n' \""'$PWD"; printf '"'COMMAND:'; printf ' %q' \""'$@"; printf '"'\\n'; \""'$@"; status=$?; printf '"'EXIT_STATUS: %d\\n' \""'$status"; return "$status"; } >"$log" 2>&1
}
run_one 09-pinning-extract python3 /audit-output/evidence/pinning_extract.py; s9=$?
run_one 11-kast-claim-program kast --definition audit-verification-kompiled --input program --output kore --output-file claim-program-parsed.kore claim-extracted-program.mpy; s11=$?
run_one 12-constructor-compare bash -c '"'cmp -s solution-parsed.kore claim-program-parsed.kore && sha256sum solution-parsed.kore claim-program-parsed.kore'; s12="'$?
run_one 19-projection-typed-connection-proof kprove spec-projection-connection-typed.k --definition audit-projection-kompiled --spec-module SPEC-PROJECTION-CONNECTION-TYPED; s19=$?
printf '"'extract=%d claim_kast=%d constructor=%d projection_typed=%d\\n' \""'$s9" "$s11" "$s12" "$s19"
for f in /audit-output/evidence/09-pinning-extract.log /audit-output/evidence/11-kast-claim-program.log /audit-output/evidence/12-constructor-compare.log /audit-output/evidence/19-projection-typed-connection-proof.log; do printf '"'\\n--- %s ---\\n' \""'$f"; sed -n '"'1,260p' \""'$f"; done
if (( s9 != 0 || s11 != 0 || s12 != 0 || s19 != 0 )); then exit 1; fi' in /audit-output
