+        arr = [rng.randrange(0, 10**12 + 1) for _ in range(length)]
+        oracle_result = expected(arr)
+        assert canonical(arr) == oracle_result, arr
+        assert generated(arr) == oracle_result, arr
+        random_checked += 1
