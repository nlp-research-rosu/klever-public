/bin/bash -lc 'bash /audit-output/evidence/run_stage56.sh' in /tmp/audit-work/68-pluck
diff --git a//tmp/audit-work/68-pluck/audit-witness.py b//tmp/audit-work/68-pluck/audit-witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..517878f6b391aca17f9519f7ede5154448c389e5
--- /dev/null
+++ b//tmp/audit-work/68-pluck/audit-witness.py
@@ -0,0 +1,29 @@
+def pluck(arr):
+    smallest = -1
+    smallest_index = 0
+    index = 0
+    value = 0
+
+    for value in arr:
+        value = value + 0
+        if value % 2 == 0:
+            if smallest < 0:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+
+    if smallest < 0:
+        return []
+    return [smallest, smallest_index]
+
+
+assert pluck([]) == []
+assert pluck([0]) == [0, 0]
+assert pluck([1]) == []
+assert pluck([4, 2, 3]) == [2, 1]
+assert pluck([2, 2]) == [2, 0]
+assert pluck([5, 0, 3, 0, 4, 2]) == [0, 1]
diff --git a//tmp/audit-work/68-pluck/spec-audit-false-value.k b//tmp/audit-work/68-pluck/spec-audit-false-value.k
new file mode 100644
index 0000000000000000000000000000000000000000..b37c99a900d6063670ed5e0854782ac236f0e35d
--- /dev/null
+++ b//tmp/audit-work/68-pluck/spec-audit-false-value.k
@@ -0,0 +1,59 @@
+requires "spec.k"
+
+module SPEC-AUDIT-FALSE-VALUE
+  imports SPEC
+
+  // Fresh reviewer mutation. The satisfying input [4,2,3] actually returns
+  // [2,1]; this changes only the result value obligation to the false [4,1].
+  claim [fresh-wrong-smallest-value]:
+    <k>
+      Call(Name("pluck"), list(vCons(4, vCons(2, vCons(3, .ValSeq)))))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "pluck" |-> closureVal(
+          "arr",
+          Assign(Name("smallest"), UnaryOp("-", Int(1)))
+          Assign(Name("smallest_index"), Int(0))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(
+            Name("value"),
+            Name("arr"),
+            Assign(Name("value"), BinOp("+", Name("value"), Int(0)))
+            If(
+              Compare(
+                BinOp("%", Name("value"), Int(2)),
+                CmpOp("==", Int(0))),
+              If(
+                Compare(Name("smallest"), CmpOp("<", Int(0))),
+                Assign(Name("smallest"), Name("value"))
+                Assign(Name("smallest_index"), Name("index")),
+                If(
+                  Compare(Name("value"), CmpOp("<", Name("smallest"))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  .Stmts)),
+              .Stmts)
+            AugAssign(Name("index"), "+", Int(1)))
+          If(
+            Compare(Name("smallest"), CmpOp("<", Int(0))),
+            Return(ListExpr(.Exprs)),
+            .Stmts)
+          Return(ListExpr(Name("smallest"), Name("smallest_index"))),
+          0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(vCons(4, vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/68-pluck/spec-ground-summaries.k b//tmp/audit-work/68-pluck/spec-ground-summaries.k
new file mode 100644
index 0000000000000000000000000000000000000000..33520c561d9efa7d6847c317b2228b51fba10fa8
--- /dev/null
+++ b//tmp/audit-work/68-pluck/spec-ground-summaries.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module SPEC-GROUND-SUMMARIES
+  imports VERIFICATION
+
+  claim [summary-empty]:
+    <k>
+      resultList(
+        scanBest(.ValSeq, 0, -1),
+        scanBestIndex(.ValSeq, 0, -1, 0))
+      => list(.ValSeq)
+    </k>
+    requires allNonNegative(.ValSeq)
+
+  claim [summary-zero]:
+    <k>
+      resultList(
+        scanBest(vCons(0, .ValSeq), 0, -1),
+        scanBestIndex(vCons(0, .ValSeq), 0, -1, 0))
+      => list(vCons(0, vCons(0, .ValSeq)))
+    </k>
+    requires allNonNegative(vCons(0, .ValSeq))
+
+  claim [summary-no-even]:
+    <k>
+      resultList(
+        scanBest(vCons(1, vCons(3, .ValSeq)), 0, -1),
+        scanBestIndex(vCons(1, vCons(3, .ValSeq)), 0, -1, 0))
+      => list(.ValSeq)
+    </k>
+    requires allNonNegative(vCons(1, vCons(3, .ValSeq)))
+
+  claim [summary-smaller-replaces]:
+    <k>
+      resultList(
+        scanBest(vCons(4, vCons(2, vCons(3, .ValSeq))), 0, -1),
+        scanBestIndex(
+          vCons(4, vCons(2, vCons(3, .ValSeq))), 0, -1, 0))
+      => list(vCons(2, vCons(1, .ValSeq)))
+    </k>
+    requires allNonNegative(vCons(4, vCons(2, vCons(3, .ValSeq))))
+
+  claim [summary-equal-preserves-first]:
+    <k>
+      resultList(
+        scanBest(vCons(2, vCons(2, .ValSeq)), 0, -1),
+        scanBestIndex(vCons(2, vCons(2, .ValSeq)), 0, -1, 0))
+      => list(vCons(2, vCons(0, .ValSeq)))
+    </k>
+    requires allNonNegative(vCons(2, vCons(2, .ValSeq)))
+endmodule
