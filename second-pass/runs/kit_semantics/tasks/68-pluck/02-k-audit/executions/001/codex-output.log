+#!/usr/bin/env bash
+set -u
+
+run_logged() {
+  local label="$1"
+  shift
+  local log="/audit-output/evidence/${label}.log"
+  {
+    printf 'CWD: %s\n' "$PWD"
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+    "$@"
+    local status=$?
+    printf 'EXIT_STATUS: %d\n' "$status"
+    return "$status"
+  } >"$log" 2>&1
+}
+
+cd /tmp/audit-work/68-pluck || exit 90
+
