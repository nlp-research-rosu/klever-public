+  // Same connection with the candidate's dynamic Val made explicit through
+  // the guarded partial downcast.
+  claim [casted-addition-connection]:
+    <k>
+      applyBin("+", {V:Val}:>Int, I:Int)
+      => projectIntTotal(V) +Int I
+    </k>
+    requires definedProjectInt(V)
+
+  claim [ground-projection-seven]:
+    <k> projectIntTotal(7) => 7 </k>
