     1	def pluck(arr):
     2	    smallest = -1
     3	    smallest_index = 0
     4	    index = 0
     5	    value = 0
     6	
     7	    for value in arr:
     8	        value = value + 0
     9	        if value % 2 == 0:
    10	            if smallest < 0:
    11	                smallest = value
    12	                smallest_index = index
    13	            else:
    14	                if value < smallest:
    15	                    smallest = value
    16	                    smallest_index = index
    17	        index += 1
    18	
    19	    if smallest < 0:
    20	        return []
    21	    return [smallest, smallest_index]

