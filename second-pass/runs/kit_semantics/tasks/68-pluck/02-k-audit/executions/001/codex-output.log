    10	        If(Compare(Name("smallest"), CmpOp("<", Int(0))),
    11	          Assign(Name("smallest"), Name("value"))
    12	          Assign(Name("smallest_index"), Name("index")),
    13	          If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
    14	            Assign(Name("smallest"), Name("value"))
    15	            Assign(Name("smallest_index"), Name("index")),
    16	            )),
    17	        )
    18	      AugAssign(Name("index"), "+", Int(1)))
    19	    If(Compare(Name("smallest"), CmpOp("<", Int(0))),
    20	      Return(ListExpr()),
