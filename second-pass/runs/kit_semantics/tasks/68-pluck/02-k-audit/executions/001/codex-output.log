+        "example-2": [1, 2, 3],
+        "example-3-empty": [],
+        "example-4-zero-tie": [5, 0, 3, 0, 4, 2],
+        "one-odd": [1],
+        "one-zero": [0],
+        "one-even": [2],
+        "first-even-remains": [2, 4],
