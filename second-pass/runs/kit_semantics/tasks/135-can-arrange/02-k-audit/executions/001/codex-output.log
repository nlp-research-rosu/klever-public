+  --definition "$scratch/verification-audit-kompiled" \
+  --spec-module REVIEWER-EXTENDED-CONTEXT \
+  -I "$scratch" \
+  2>&1 | tee /audit-output/evidence/stage5_extended_context.log
+status=${PIPESTATUS[0]}
+set -e
