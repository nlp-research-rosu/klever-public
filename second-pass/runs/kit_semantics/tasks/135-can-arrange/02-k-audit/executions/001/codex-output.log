+#!/usr/bin/env bash
+set -u
+
+scratch=/tmp/audit-work/135-can-arrange
+overall=0
+
+echo 'COMMAND: exhaustive source-level declaration and rule inventory'
+python3 /audit-output/evidence/rule_inventory.py |
+  tee /audit-output/evidence/rule_inventory.txt
+status=${PIPESTATUS[0]}
