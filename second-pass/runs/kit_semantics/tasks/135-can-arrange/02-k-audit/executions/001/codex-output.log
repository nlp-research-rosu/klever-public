+CONNECTION-SPEC.ge-int-int
+CONNECTION-SPEC.ge-bool-bool
+CONNECTION-SPEC.ge-bool-int
+CONNECTION-SPEC.ge-int-bool
+CONNECTION-SPEC.ge-float-float
