+      !(operationalStrLt left right)
+  | .inj_SortStr _, _ => false
+  | _, .inj_SortStr _ => false
+  | _, _ => false
+
+def operationalCodeIn (code : SortInt) : SortIntSeq → SortBool
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
