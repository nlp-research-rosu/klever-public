+def operationalEqIF (integer : SortInt) (value : SortFloat) : SortBool :=
+  if value.isFinite then
+    decide (
+      operationalFloorFiniteFloat value = operationalCeilFiniteFloat value ∧
+      operationalFloorFiniteFloat value = integer)
+  else
+    false
