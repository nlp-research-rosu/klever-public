+    (significand : Nat) (binaryExponent : SortInt) : Nat × Nat :=
+  if binaryExponent ≥ 0 then
+    (significand * (2 ^ binaryExponent.toNat), 0)
+  else
+    let denominator := 2 ^ (-binaryExponent).toNat
+    (significand / denominator, significand % denominator)
