+def operationalCodeIn (code : SortInt) : SortIntSeq → SortBool
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail =>
+      decide (code = head) || operationalCodeIn code tail
