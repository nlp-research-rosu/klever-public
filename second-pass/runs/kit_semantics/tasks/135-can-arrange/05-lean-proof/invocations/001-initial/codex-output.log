+  let negative := decide (bits / (2 ^ 63) = 1)
+  let storedExponent := (bits / (2 ^ 52)) % (2 ^ 11)
+  let fraction := bits % (2 ^ 52)
+  if storedExponent = 0 then
+    (negative, fraction, -1074)
+  else
