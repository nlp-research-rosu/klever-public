+  let (negative, significand, binaryExponent) := operationalFiniteFloatParts value
+  let (quotient, remainder) :=
+    operationalSplitFloatMagnitude significand binaryExponent
+  if negative then
+    -Int.ofNat (quotient + if remainder = 0 then 0 else 1)
+  else
+    Int.ofNat quotient
