--- /dev/null
+++ b/lean-pid-shim.c
@@ -0,0 +1,13 @@
+#define _GNU_SOURCE
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  char target[PATH_MAX];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length <= 0) return 1;
+  target[length] = '\0';
+  return (pid_t)strtol(target, NULL, 10);
+}

