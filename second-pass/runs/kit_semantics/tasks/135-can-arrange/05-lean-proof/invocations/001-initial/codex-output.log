+  | "<=" => !(operationalLtIF integer value)
+  | ">" => operationalLtIF integer value
+  | ">=" => !(operationalLtFI value integer)
+  | "==" => operationalEqIF integer value
+  | "!=" => !(operationalEqIF integer value)
