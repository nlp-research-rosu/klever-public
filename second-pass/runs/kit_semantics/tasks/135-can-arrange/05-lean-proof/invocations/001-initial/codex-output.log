+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» candidate keyTail,
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value valueTail =>
+      if candidate == key then some value
