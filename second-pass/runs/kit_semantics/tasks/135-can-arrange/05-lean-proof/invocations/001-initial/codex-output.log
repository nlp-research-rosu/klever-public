+def operationalCompareStrings
+    (operator : SortString) (left right : SortIntSeq) : SortBool :=
+  match operator with
+  | "==" => left == right
+  | "!=" => !(left == right)
+  | "in" => operationalStrContains left right
+  | "not in" => !(operationalStrContains left right)
+  | "<" => operationalStrLt left right
