+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», _ => true
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _,
+      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» leftHead leftTail,
