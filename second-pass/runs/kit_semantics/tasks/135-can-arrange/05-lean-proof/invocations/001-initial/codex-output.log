+   Base's binary64 SortFloat representation. -/
+def operationalFloatLt (left right : SortFloat) : SortBool :=
+  decide (left < right)
+
+def operationalFloatGt (left right : SortFloat) : SortBool :=
+  decide (right < left)
+
