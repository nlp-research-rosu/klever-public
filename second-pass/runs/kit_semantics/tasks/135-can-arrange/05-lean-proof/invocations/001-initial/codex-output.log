+    | op, .inj_SortBool leftBool, .inj_SortFloat rightFloat =>
+        operationalCompareIntFloat op (operationalBoolAsInt leftBool) rightFloat
+    | op, .inj_SortFloat leftFloat, .inj_SortBool rightBool =>
