+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => false
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» head tail =>
+      (head == key) || operationalHasDictKey key tail
