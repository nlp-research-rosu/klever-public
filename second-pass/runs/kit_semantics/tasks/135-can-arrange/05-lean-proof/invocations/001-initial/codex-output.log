new file mode 100644
index 0000000000000000000000000000000000000000..ea4b7acb973cbb2cbf53763f848c1aee26eb9ca7
--- /dev/null
+++ b/lean-pid-shim.c
@@ -0,0 +1,13 @@
+#define _GNU_SOURCE
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  char target[PATH_MAX];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length <= 0) return 1;
+  target[length] = '\0';
+  return (pid_t)strtol(target, NULL, 10);
+}

