+++ b/SemanticChecks.lean
@@ -0,0 +1,57 @@
+import Proof
+
+open Proof
+
+abbrev emptyIS : SortIntSeq := SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+def consIS (head : SortInt) (tail : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail
+def oneIS (head : SortInt) : SortIntSeq := consIS head emptyIS
+def twoIS (first second : SortInt) : SortIntSeq := consIS first (oneIS second)
+def stringV (codes : SortIntSeq) : SortVal :=
+  .inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» codes)
+
+abbrev emptyVS : SortValSeq := SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+def consVS (head : SortVal) (tail : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» head tail
+def oneVS (head : SortVal) : SortValSeq := consVS head emptyVS
+def twoVS (first second : SortVal) : SortValSeq := consVS first (oneVS second)
+def listV (items : SortValSeq) : SortVal :=
+  .inj_SortIterable (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» items)
+def tupleV (items : SortValSeq) : SortVal :=
+  .inj_SortIterable (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» items)
+def setV (items : SortIntSeq) : SortVal :=
+  SortVal.«setV(_)_MPY-SET_Val_IntSeq» items
+def dictV (keys values : SortValSeq) : SortVal :=
+  SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» keys values
+
+def cmp := Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+
+-- Exact large Int/Float comparison, Bool numeric coercion, and Float hooks.
+#eval cmp ">" (.inj_SortInt 9007199254740993)
+  (.inj_SortFloat 9007199254740992.0)
+#eval cmp "==" (.inj_SortBool true) (.inj_SortInt 1)
+#eval cmp "==" (.inj_SortFloat 0.0) (.inj_SortFloat (-0.0))
+#eval cmp "==" (listV (oneVS (.inj_SortFloat 0.0)))
+  (listV (oneVS (.inj_SortFloat (-0.0))))
+
+-- Lexicographic strings and substring membership.
+#eval cmp "<" (stringV (oneIS 97)) (stringV (oneIS 98))
+#eval cmp ">=" (stringV (oneIS 98)) (stringV (oneIS 97))
+#eval cmp "in" (stringV (oneIS 97)) (stringV (twoIS 98 97))
+#eval cmp "not in" (stringV (oneIS 97)) (stringV (twoIS 98 99))
+
+-- Structural sequences, order-insensitive set/dict equality, and None.
+#eval cmp "==" (tupleV (twoVS (.inj_SortInt 1) (.inj_SortBool true)))
+  (tupleV (twoVS (.inj_SortInt 1) (.inj_SortBool true)))
+#eval cmp "==" (setV (twoIS 2 1)) (setV (twoIS 1 2))
+#eval cmp "=="
+  (dictV (twoVS (.inj_SortInt 1) (.inj_SortInt 2))
+    (twoVS (.inj_SortBool false) (.inj_SortBool true)))
+  (dictV (twoVS (.inj_SortInt 2) (.inj_SortInt 1))
+    (twoVS (.inj_SortBool true) (.inj_SortBool false)))
+#eval cmp "is" SortVal.«noneV_MPY-CORE_Val» SortVal.«noneV_MPY-CORE_Val»
+
+#print axioms Proof.final
+#print axioms Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+#print axioms Proof.«orderGe(_,_)_VERIFICATION-BASE_Bool_Val_Val»
+#print axioms Proof.«orderablePair(_,_)_VERIFICATION-BASE_Bool_Val_Val»
diff --git a/lean-pid-shim.c b/lean-pid-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..ea4b7acb973cbb2cbf53763f848c1aee26eb9ca7
--- /dev/null
+++ b/lean-pid-shim.c
@@ -0,0 +1,13 @@
+#define _GNU_SOURCE
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  char target[PATH_MAX];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length <= 0) return 1;
+  target[length] = '\0';
+  return (pid_t)strtol(target, NULL, 10);
+}

