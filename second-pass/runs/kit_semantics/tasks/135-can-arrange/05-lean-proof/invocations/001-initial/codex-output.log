+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq»,
+      SortValSeq.«.ValSeq_MPY-CORE_ValSeq», _, _ => true
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» key keyTail,
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value valueTail,
