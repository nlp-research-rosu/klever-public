+    (operator : SortString) (integer : SortInt) (value : SortFloat) : SortBool :=
+  match operator with
+  | "<" => operationalLtIF integer value
+  | "<=" => !(operationalLtFI value integer)
+  | ">" => operationalLtFI value integer
+  | ">=" => !(operationalLtIF integer value)
+  | "==" => operationalEqIF integer value
+  | "!=" => !(operationalEqIF integer value)
+  | _ => false
+
+def operationalCompareFloatInt
