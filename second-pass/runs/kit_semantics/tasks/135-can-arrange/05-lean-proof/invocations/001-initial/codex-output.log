+  | .inj_SortInt left, .inj_SortFloat right => !(operationalLtIF left right)
+  | .inj_SortFloat left, .inj_SortInt right => !(operationalLtFI left right)
+  | .inj_SortBool left, .inj_SortFloat right =>
