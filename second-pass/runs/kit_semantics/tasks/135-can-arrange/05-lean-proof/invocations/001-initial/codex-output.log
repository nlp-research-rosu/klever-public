+def operationalIsNumericVal : SortVal → SortBool
+  | .inj_SortBool _ => true
+  | .inj_SortFloat _ => true
+  | .inj_SortInt _ => true
+  | _ => false
+
+def operationalIsStrVal : SortVal → SortBool
+  | .inj_SortStr _ => true
+  | _ => false
