+    (operator : SortString) (left right : SortInt) : SortBool :=
+  match operator with
+  | "<" => decide (left < right)
+  | "<=" => decide (left ≤ right)
+  | ">" => decide (left > right)
+  | ">=" => decide (left ≥ right)
+  | "==" => decide (left = right)
+  | "!=" => decide (left ≠ right)
+  | _ => false
+
+def operationalCompareFloats
