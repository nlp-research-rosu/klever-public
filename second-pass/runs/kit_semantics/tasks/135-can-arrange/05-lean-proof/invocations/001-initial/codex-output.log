+    (leftKeys leftValues rightKeys rightValues : SortValSeq) : SortBool :=
+  decide (operationalValSeqLength leftKeys = operationalValSeqLength rightKeys) &&
+    operationalDictSubset leftKeys leftValues rightKeys rightValues
