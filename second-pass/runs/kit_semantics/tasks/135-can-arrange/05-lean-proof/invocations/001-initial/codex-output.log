+def operationalIntRoundsToPositiveInfinity (integer : SortInt) : SortBool :=
+  decide (integer ≥ operationalIntFloatOverflowBoundary)
+
+def operationalIntRoundsToNegativeInfinity (integer : SortInt) : SortBool :=
+  decide (integer ≤ -operationalIntFloatOverflowBoundary)
+
