+    | "==", .inj_SortIterable
+          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» leftValues),
+        .inj_SortIterable
+          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
+        leftValues == rightValues
+    | "!=", .inj_SortIterable
+          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» leftValues),
