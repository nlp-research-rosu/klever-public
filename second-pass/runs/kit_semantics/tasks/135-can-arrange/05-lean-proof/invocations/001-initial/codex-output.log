+    | "!=", value, SortVal.«noneV_MPY-CORE_Val» => !(operationalIsNone value)
+    | "is", value, SortVal.«noneV_MPY-CORE_Val» => operationalIsNone value
+    | "is not", value, SortVal.«noneV_MPY-CORE_Val» => !(operationalIsNone value)
