+          (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» leftValues),
+        .inj_SortIterable
+          (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
+        !(leftValues == rightValues)
+    | "==", SortVal.«setV(_)_MPY-SET_Val_IntSeq» leftCodes,
