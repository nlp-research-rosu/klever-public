print('candidate_lean_files',[p.relative_to(root).as_posix() for p in writable])
for p in writable:
    text=p.read_text()
    print(p.relative_to(root).as_posix(),
          'sorry',len(re.findall(r'\bsorry\b',text)),
          'admit',len(re.findall(r'\badmit\b',text)),
          'unsafe',len(re.findall(r'\bunsafe\b',text)),
          'targetStatement_defs',len(re.findall(r'(?m)^\s*def\s+targetStatement\b',text)))
    print('trust_declarations',lean_trust_declarations(p))
