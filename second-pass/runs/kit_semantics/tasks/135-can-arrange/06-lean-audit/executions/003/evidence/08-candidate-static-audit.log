print('base_target_sha256',hashlib.sha256(base_target.read_bytes()).hexdigest())
print('reference_target_sha256',hashlib.sha256(reference_target.read_bytes()).hexdigest())
print('base_tree_sha256',tree_digest(root/'Base'))
print('generated_tree_sha256',tree_digest(Path('/reference/klean-generation/generated')))
print('parameter_def_lines')
for n,line in enumerate((root/'Proof.lean').read_text().splitlines(),1):
    if (line.startswith('def «applyCmp') or line.startswith('def «orderGe')
        or line.startswith('def «orderablePair') or line.startswith('theorem final')):
        print(n,line)
