PYTHONPATH=/reference python - <<'PY'
import hashlib,re
from pathlib import Path
from tools.klean_export import lean_trust_declarations, tree_digest
root=Path('/tmp/audit-work/135-can-arrange-proof-audit')
writable=[p for p in root.rglob('*.lean')
