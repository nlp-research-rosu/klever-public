audit = json.loads(Path('/audit-input.json').read_text())['resolution']
actual = {name: hashlib.sha256((sources/name).read_bytes()).hexdigest()
          for name in ('klean_export.py','klean.py')}
print('actual_file_hashes', json.dumps(actual, sort_keys=True))
print('source_manifest_files', json.dumps(source_manifest['files'], sort_keys=True))
print('generator_manifest_file_hashes', json.dumps({
  'klean_export.py':generator['exporter_sha256'],
  'klean.py':generator['klean_py_sha256']}, sort_keys=True))
print('file_hashes_all_match', actual == source_manifest['files'] == {
  'klean_export.py':generator['exporter_sha256'],
  'klean.py':generator['klean_py_sha256']})
actual_tree = sha256_tree(sources)
print('actual_producer_tree_sha256', actual_tree)
print('audit_producer_tree_sha256', audit['hashes']['generation_producer_sources_sha256'])
print('producer_tree_matches_audit', actual_tree == audit['hashes']['generation_producer_sources_sha256'])
ids = {
 'source_manifest': source_manifest['generator_image_id'],
 'generator_manifest': generator['provenance']['generator_image_id'],
 'audit_path_basename': 'sha256:' + Path(audit['generation_producer_sources']).name,
}
print('generator_image_ids', json.dumps(ids, sort_keys=True))
print('generator_image_ids_all_match', len(set(ids.values())) == 1)
