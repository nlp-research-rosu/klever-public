{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 8,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "f447e6c13f34b3bf342ffc13a8beccd212dd6040c6a56e3d8b2eb78c7716d5b6",
      "rationale": "Defines the proof-local predicate isNumericVal by enumerating the Int, Bool, and Float sort tests.",
      "source_rule_id": "rule-f447e6c13f34b3bf342ffc13a8beccd212dd6040c6a56e3d8b2eb78c7716d5b6",
      "start_line": 7,
      "text": "  rule isNumericVal(V:Val)\n    => isInt(V) orBool isBool(V) orBool isFloat(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "c196375d9e44aeee16d88ca49c71d68f247fcae3a7e2de40167a03e71c340fb0",
      "rationale": "Defines orderablePair as the named proof-domain predicate for numeric pairs or string pairs.",
      "source_rule_id": "rule-c196375d9e44aeee16d88ca49c71d68f247fcae3a7e2de40167a03e71c340fb0",
      "start_line": 11,
      "text": "  rule orderablePair(V:Val, W:Val)\n    => (isNumericVal(V) andBool isNumericVal(W))\n       orBool (isStr(V) andBool isStr(W))"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "8bbe4232c62b83e16762a1292ff2d9b8ffe3de09375f0636c6259642438e65be",
      "rationale": "Base equation of the structural scanDefined recurrence: an empty suffix performs no comparison.",
      "source_rule_id": "rule-8bbe4232c62b83e16762a1292ff2d9b8ffe3de09375f0636c6259642438e65be",
      "start_line": 20,
      "text": "  rule scanDefined(.ValSeq, _I:Int, _P:Val) => true\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "e853c61fa2694d2f4450ba34ad86c1e9871386f89fc67b30ff41a3d3eea08782",
      "rationale": "Defines the first-element case of scanDefined by consuming one constructor without requiring a predecessor comparison.",
      "source_rule_id": "rule-e853c61fa2694d2f4450ba34ad86c1e9871386f89fc67b30ff41a3d3eea08782",
      "start_line": 22,
      "text": "  rule scanDefined(vCons(V:Val, R:ValSeq), I:Int, _P:Val)\n    => scanDefined(R, I +Int 1, V)\n    requires I ==Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "aff0eb37d04d73306c87e3ee8e89c15a4136b6965c4e4e464ec54d14450d630c",
      "rationale": "Defines the positive-index recurrence of scanDefined using orderablePair and structural descent.",
      "source_rule_id": "rule-aff0eb37d04d73306c87e3ee8e89c15a4136b6965c4e4e464ec54d14450d630c",
      "start_line": 26,
      "text": "  rule scanDefined(vCons(V:Val, R:ValSeq), I:Int, P:Val)\n    => orderablePair(V, P) andBool scanDefined(R, I +Int 1, V)\n    requires I >Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "213846a9aab587edfe354566ab077f3430a975ec93b740e18e23d86e532106b2",
      "rationale": "Totalizes the named scanDefined predicate for a nonempty suffix at a negative index.",
      "source_rule_id": "rule-213846a9aab587edfe354566ab077f3430a975ec93b740e18e23d86e532106b2",
      "start_line": 30,
      "text": "  rule scanDefined(vCons(_V:Val, _R:ValSeq), I:Int, _P:Val) => false\n    requires I <Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 38,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "fa5cd7c4178fe2e1133972423cafc6ad21eaccbc22aabfcd5d14fe03f1716938",
      "rationale": "Defines the Int-Int case of the proof-local mathematical summary orderGe.",
      "source_rule_id": "rule-fa5cd7c4178fe2e1133972423cafc6ad21eaccbc22aabfcd5d14fe03f1716938",
      "start_line": 38,
      "text": "  rule orderGe(I:Int, J:Int) => I >=Int J [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 41,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "40c2c4ba502a5254546cf66a91b276de42514f4d59db51fd4e5d89eb4df940a2",
      "rationale": "Defines the Bool-Bool case of orderGe through the existing boolAsInt coercion.",
      "source_rule_id": "rule-40c2c4ba502a5254546cf66a91b276de42514f4d59db51fd4e5d89eb4df940a2",
      "start_line": 39,
      "text": "  rule orderGe(B:Bool, C:Bool)\n    => boolAsInt(B) >=Int boolAsInt(C)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "b4535bb0257e0ce0856d94c0df6fed5ef8de909f4d0af66710e2ac103fb2d8e9",
      "rationale": "Defines the Bool-Int case of the named orderGe summary.",
      "source_rule_id": "rule-b4535bb0257e0ce0856d94c0df6fed5ef8de909f4d0af66710e2ac103fb2d8e9",
      "start_line": 42,
      "text": "  rule orderGe(B:Bool, I:Int)\n    => boolAsInt(B) >=Int I\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "a4635f5fd875c0b951751a4776ab775437924f32ddc6e2e47de8ad338941117b",
      "rationale": "Defines the Int-Bool case of the named orderGe summary.",
      "source_rule_id": "rule-a4635f5fd875c0b951751a4776ab775437924f32ddc6e2e47de8ad338941117b",
      "start_line": 45,
      "text": "  rule orderGe(I:Int, B:Bool)\n    => I >=Int boolAsInt(B)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "0f84f0ef72097d8939857523c3899403bbdafd481e88f90430fe5e024c5e1d9b",
      "rationale": "Defines the Float-Float case of orderGe in terms of the supplied floatLt primitive.",
