      "classification": "DEFINITION",
      "end_line": 56,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "374dd39e34b9d6cf47d08024751dba1fad3dcf167eb3b703ee503bd3241df234",
      "rationale": "Defines the Float-Int case of orderGe in terms of the supplied ltFI primitive.",
      "source_rule_id": "rule-374dd39e34b9d6cf47d08024751dba1fad3dcf167eb3b703ee503bd3241df234",
      "start_line": 54,
      "text": "  rule orderGe(F:Float, I:Int)\n    => notBool ltFI(F, I)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 59,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "cfe48f98a26926712eb2b738b2e9f155125920f954c04031057edf8047c10073",
      "rationale": "Defines the Bool-Float case of orderGe using boolAsInt and the supplied ltIF primitive.",
      "source_rule_id": "rule-cfe48f98a26926712eb2b738b2e9f155125920f954c04031057edf8047c10073",
      "start_line": 57,
      "text": "  rule orderGe(B:Bool, F:Float)\n    => notBool ltIF(boolAsInt(B), F)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 62,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "9629b5e3fb5e0a2ddaceee9add9f83a778d8c1bbaf4d522126e9921ff15a96c4",
      "rationale": "Defines the Float-Bool case of orderGe using boolAsInt and the supplied ltFI primitive.",
      "source_rule_id": "rule-9629b5e3fb5e0a2ddaceee9add9f83a778d8c1bbaf4d522126e9921ff15a96c4",
      "start_line": 60,
      "text": "  rule orderGe(F:Float, B:Bool)\n    => notBool ltFI(F, boolAsInt(B))\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 65,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "29e2cbda76015fd4dbda41cdb369f5087acb7072d2a4ca194c95de94d5bb570b",
      "rationale": "Defines the Str-Str case of orderGe in terms of the supplied lexicographic strLt helper.",
      "source_rule_id": "rule-29e2cbda76015fd4dbda41cdb369f5087acb7072d2a4ca194c95de94d5bb570b",
      "start_line": 63,
      "text": "  rule orderGe(str(A:IntSeq), str(B:IntSeq))\n    => notBool strLt(A, B)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
