def can_arrange(arr):
    """Create a function which returns the largest index of an element which
    is not greater than or equal to the element immediately preceding it. If
    no such element exists then return -1. The given array will not contain
    duplicate values.

    Examples:
    can_arrange([1,2,4,3,5]) = 3
    can_arrange([1,2,3]) = -1
    """
requires "verification.k"

module CONNECTION-SPEC
  imports VERIFICATION-BASE

  claim [ge-int-int]:
    <k> applyCmp(">=", I:Int, J:Int) => orderGe(I, J) </k>

  claim [ge-bool-bool]:
    <k> applyCmp(">=", B:Bool, C:Bool) => orderGe(B, C) </k>

  claim [ge-bool-int]:
    <k> applyCmp(">=", B:Bool, I:Int) => orderGe(B, I) </k>

  claim [ge-int-bool]:
    <k> applyCmp(">=", I:Int, B:Bool) => orderGe(I, B) </k>

  claim [ge-float-float]:
    <k> applyCmp(">=", F:Float, G:Float) => orderGe(F, G) </k>

  claim [ge-int-float]:
    <k> applyCmp(">=", I:Int, F:Float) => orderGe(I, F) </k>

  claim [ge-float-int]:
    <k> applyCmp(">=", F:Float, I:Int) => orderGe(F, I) </k>

  claim [ge-bool-float]:
    <k> applyCmp(">=", B:Bool, F:Float) => orderGe(B, F) </k>

  claim [ge-float-bool]:
    <k> applyCmp(">=", F:Float, B:Bool) => orderGe(F, B) </k>

  claim [ge-str-str]:
    <k>
      applyCmp(">=", str(A:IntSeq), str(B:IntSeq))
      => orderGe(str(A), str(B))
    </k>
endmodule
requires "verification.k"

module BODY-MUTATION-SPEC
  imports VERIFICATION

  // A1 probe: replacing the implementation by `return 0` must not establish
  // the real empty-list result (-1).
  claim [mutated-body]:
    <k> Call(Name("can_arrange"), list(.ValSeq)) => -1 </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope(
        "can_arrange" |->
          closureVal(
            "arr", .ParamNames,
            Return(Int(0))
            .Stmts,
            0),
        parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
requires "verification.k"

module SPEC-VACUITY
  imports VERIFICATION

  // A5 probe: the real body on a realizable empty input returns -1, not 0.
  claim [wrong-result]:
    <k> Call(Name("can_arrange"), list(.ValSeq)) => 0 </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope(
        "can_arrange" |->
          closureVal(
            "arr", .ParamNames,
            Assign(Name("index"), UnaryOp("-", Int(1)))
            Assign(Name("i"), Int(0))
            Assign(Name("previous"), Int(0))
            Assign(Name("value"), Int(0))
            For(
              Name("value"), Name("arr"),
              If(
                Compare(Name("i"), CmpOp(">", Int(0))),
                If(
                  UnaryOp(
                    "not",
                    Compare(
                      Name("value"),
                      CmpOp(">=", Name("previous")))),
                  Assign(Name("index"), Name("i")),
                  .Stmts),
                .Stmts)
              Assign(Name("previous"), Name("value"))
              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
              .Stmts)
            Return(Name("index"))
            .Stmts,
            0),
        parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule

