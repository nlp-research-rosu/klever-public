      "module": "VERIFICATION-BASE",
      "normalized_sha256": "fe239a336649044fba8ba44d2b27602f10bcc32e4ea4c0e7b547cf95803be8a5",
      "rationale": "Provides the guarded complement case that totalizes the named orderGe function outside orderablePair.",
      "source_rule_id": "rule-fe239a336649044fba8ba44d2b27602f10bcc32e4ea4c0e7b547cf95803be8a5",
      "start_line": 66,
      "text": "  rule orderGe(V:Val, W:Val) => false\n    requires notBool orderablePair(V, W)\n    [simplification]"
    },
    {
