--- /dev/null
+++ b//tmp/audit-work/135-can-arrange-proof-audit/AuditOperational.lean
@@ -0,0 +1,56 @@
+import Proof
+
+open Proof
+
+def intVal (value : Int) : SortVal := .inj_SortInt value
+def boolVal (value : Bool) : SortVal := .inj_SortBool value
+def floatVal (bits : UInt64) : SortVal :=
+  .inj_SortFloat (Float.ofBits bits)
+
+def candidateGe (left right : SortVal) : Bool :=
+  «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">=" left right
+
+#eval ("int 2 >= 1", candidateGe (intVal 2) (intVal 1))
+#eval ("int -1 >= 0", candidateGe (intVal (-1)) (intVal 0))
+#eval ("true >= 1", candidateGe (boolVal true) (intVal 1))
+#eval ("0 >= true", candidateGe (intVal 0) (boolVal true))
+#eval ("2^53+1 >= 2^53-float",
+  candidateGe (intVal 9007199254740993) (floatVal 0x4340000000000000))
+#eval ("2^53-float >= 2^53+1",
+  candidateGe (floatVal 0x4340000000000000) (intVal 9007199254740993))
+#eval ("positive infinity >= 0",
+  candidateGe (floatVal 0x7ff0000000000000) (intVal 0))
+#eval ("negative infinity >= 0",
+  candidateGe (floatVal 0xfff0000000000000) (intVal 0))
+#eval ("NaN >= 0 under supplied K not(<) rule",
+  candidateGe (floatVal 0x7ff8000000000000) (intVal 0))
+#eval ("minimum positive subnormal >= 0",
+  candidateGe (floatVal 0x0000000000000001) (intVal 0))
+#eval ("non-orderable noneV is totalized to false by candidate",
+  candidateGe SortVal.«noneV_MPY-CORE_Val» (intVal 0))
+
+theorem generatedStringSortIsEmpty : SortStr → False := by
+  intro value
+  nomatch value
+
+def falseOrderGe (_left _right : SortVal) : SortBool := false
+
+def falseApplyCmp
+    (operator : SortString) (left right : SortVal) : SortBool :=
+  if operator = ">=" then
+    if operationalOrderablePair left right then
+      falseOrderGe left right
+    else
+      false
+  else
+    false
+
+theorem counterfactualStillProvesFixedTarget :
+    Klean135CanArrange.Lemmas.targetStatement
+      falseApplyCmp falseOrderGe operationalOrderablePair := by
+  unfold Klean135CanArrange.Lemmas.targetStatement
+  intro W V h
+  unfold falseApplyCmp
+  rw [if_pos rfl]
+  rw [if_pos h]
+
diff --git a//tmp/audit-work/proc-self-readlink-shim.c b//tmp/audit-work/proc-self-readlink-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..c457a652a29411ea385b92f337eb097455d64b8d
--- /dev/null
+++ b//tmp/audit-work/proc-self-readlink-shim.c
@@ -0,0 +1,45 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_numeric_proc_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t length;
+    size_t index;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    length = strlen(path);
+    if (length <= (sizeof(prefix) - 1) + (sizeof(suffix) - 1) ||
+        strcmp(path + length - (sizeof(suffix) - 1), suffix) != 0) {
+        return 0;
+    }
+    for (index = sizeof(prefix) - 1;
+         index < length - (sizeof(suffix) - 1);
+         ++index) {
+        if (!isdigit((unsigned char)path[index])) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_numeric_proc_exe(path)) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
