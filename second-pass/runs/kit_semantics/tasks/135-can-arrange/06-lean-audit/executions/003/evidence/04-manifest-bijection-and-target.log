COMMAND
PYTHONPATH=/reference python - <<'PY'
import hashlib,json
from pathlib import Path
from tools import klean_export
G=Path('/reference/klean-generation')
gen=G/'generated'
audit=json.loads(Path('/audit-input.json').read_text())['resolution']
manifest=json.loads((G/'generator-manifest.json').read_text())
inputm=json.loads((G/'input-manifest.json').read_text())
obmap=json.loads((gen/'obligation-map.json').read_text())
disc=json.loads(Path('/reference/lemma-discovery.json').read_text())
target=klean_export.target_statement(gen)
expected=klean_export.expected_target_definition(obmap)
print('actual_stage1_tree',klean_export.tree_digest(Path('/reference/k-proof')))
print('manifest_stage1_tree',manifest['provenance']['stage1_workspace_sha256'])
print('input_stage1_tree',inputm['stage1_workspace_sha256'])
print('audit_stage1_export',audit['hashes']['stage1_export_sha256'])
print('actual_discovery_sha256',hashlib.sha256(Path('/reference/lemma-discovery.json').read_bytes()).hexdigest())
print('manifest_discovery_sha256',manifest['provenance']['stage3_discovery_manifest_sha256'])
print('audit_discovery_sha256',audit['hashes']['discovery_manifest_sha256'])
print('actual_generated_tree',klean_export.tree_digest(gen))
print('manifest_generated_tree',manifest['generated_tree_sha256'])
print('audit_generated_tree',audit['hashes']['generated_tree_sha256'])
print('actual_obligation_map_sha256',hashlib.sha256((gen/'obligation-map.json').read_bytes()).hexdigest())
print('manifest_obligation_map_sha256',manifest['obligation_map_sha256'])
print('domain_rule_ids',[r['source_rule_id'] for r in disc['rules'] if r['classification']=='DOMAIN_LEMMA'])
print('mapped_rule_ids',[r['source_rule_id'] for r in obmap['source_rules']])
print('obligation_rule_ids',[r['source_rule_id'] for r in obmap['obligations']])
print('obligation_count',len(obmap['obligations']),manifest['obligation_count'])
print('target_equal',target==manifest['target'])
print('expected_definition_sha256',klean_export.sha256_text(expected))
print('actual_definition_sha256',target['definition_sha256'])
print('fixed_statement_sha256',target['statement_sha256'])
print('target_equals_audit',target==audit['stage4_preflight']['target'])
fresh=Path('/tmp/audit-work/135-can-arrange-proof-audit/Base')
print('fresh_base_tree',klean_export.tree_digest(fresh))
print('fresh_base_matches_generated',klean_export.tree_digest(fresh)==klean_export.tree_digest(gen))
PY

