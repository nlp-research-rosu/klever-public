COMMAND
PYTHONPATH=/reference python - <<'PY'
import json
from pathlib import Path
from tools.k_rule_inventory import inventory_verification
inv=inventory_verification(Path('/reference/k-proof'))
disc=json.loads(Path('/reference/lemma-discovery.json').read_text())
cls={x['source_rule_id']:x['classification'] for x in disc['rules']}
print('schema',inv['schema_version'])
print('verification_file',inv['verification_file'])
print('verification_sha256',inv['verification_sha256'])
print('verification_module',inv['verification_module'])
print('verification_modules',' -> '.join(inv['verification_modules']))
print('inventory_sha256',inv['inventory_sha256'])
print('count',len(inv['rules']))
for i,r in enumerate(inv['rules'],1):
 print(f"{i:02d} {r['module']} {r['start_line']}-{r['end_line']} "
       f"{r['normalized_sha256']} {r['source_rule_id']} "
       f"attrs={','.join(r['attributes']) or '-'} "
       f"classified={cls.get(r['source_rule_id'])}")
ids=[r['source_rule_id'] for r in inv['rules']]
dids=[r['source_rule_id'] for r in disc['rules']]
print('reconstructed_unique',len(ids)==len(set(ids)))
print('classified_unique',len(dids)==len(set(dids)))
print('ordered_identity_equal',ids==dids)
print('omitted',sorted(set(ids)-set(dids)))
print('extra',sorted(set(dids)-set(ids)))
print('inventory_hash_equal',inv['inventory_sha256']==disc['inventory_sha256'])
PY

