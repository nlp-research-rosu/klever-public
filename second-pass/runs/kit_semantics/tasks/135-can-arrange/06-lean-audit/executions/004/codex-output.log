@@ -0,0 +1,27 @@
+Module(
+  FuncDef("can_arrange", Params("arr"),
+    Assign(Name("index"), UnaryOp("-", Int(1)))
+    Assign(Name("i"), Int(0))
+    Assign(Name("previous"), Int(0))
+    Assign(Name("value"), Int(0))
+    For(Name("value"), Name("arr"),
+      If(Compare(Name("i"), CmpOp(">", Int(0))),
+        If(UnaryOp("not", Compare(Name("value"), CmpOp(">=", Name("previous")))),
+          Assign(Name("index"), Name("i")),
+          ),
+        )
+      Assign(Name("previous"), Name("value"))
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+    Return(Name("index")))
+  Assert(Compare(
+    Call(Name("can_arrange"), ListExpr(Int(1), Int(2), Int(4), Int(3), Int(5))),
+    CmpOp("==", Int(3))))
+  Assert(Compare(
+    Call(Name("can_arrange"), ListExpr(Bool(true), Int(2), Float(1.5))),
+    CmpOp("==", Int(2))))
+  Assert(Compare(
+    Call(Name("can_arrange"), ListExpr(Str("b"), Str("a"), Str("c"))),
+    CmpOp("==", Int(1))))
+  Assert(Compare(
+    Call(Name("can_arrange"), ListExpr(Float(2.5), Int(2), Int(3))),
+    CmpOp("==", Int(1)))))
