SOLUTION.PY
     1	def can_arrange(arr):
     2	    index = -1
     3	    i = 0
     4	    previous = 0
     5	    value = 0
     6	    for value in arr:
     7	        if i > 0:
     8	            if not value >= previous:
     9	                index = i
    10	        previous = value
    11	        i = i + 1
    12	    return index

PROMPT.PY
     1	
     2	def can_arrange(arr):
     3	    """Create a function which returns the largest index of an element which
     4	    is not greater than or equal to the element immediately preceding it. If
     5	    no such element exists then return -1. The given array will not contain
     6	    duplicate values.
     7	
     8	    Examples:
     9	    can_arrange([1,2,4,3,5]) = 3
    10	    can_arrange([1,2,3]) = -1
    11	    """

