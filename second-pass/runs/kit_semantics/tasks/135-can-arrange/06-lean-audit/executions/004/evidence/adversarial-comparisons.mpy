Module(
  Assert(Compare(Int(2), CmpOp(">=", Int(1))))
  Assert(UnaryOp("not", Compare(Int(1), CmpOp(">=", Int(2)))))
  Assert(UnaryOp("not", Compare(Bool(true), CmpOp(">=", Int(2)))))
  Assert(Compare(Bool(false), CmpOp(">=", UnaryOp("-", Int(1)))))
  Assert(Compare(Float(2.5), CmpOp(">=", Int(2))))
  Assert(UnaryOp("not", Compare(Int(2), CmpOp(">=", Float(2.5)))))
  Assert(Compare(Str("b"), CmpOp(">=", Str("a"))))
  Assert(UnaryOp("not", Compare(Str("a"), CmpOp(">=", Str("b"))))))
