+import Proof
+
+open Proof
+
+def intVal (value : SortInt) : SortVal := .inj_SortInt value
+def boolVal (value : SortBool) : SortVal := .inj_SortBool value
+
+#eval operationalOrderablePair (intVal 2) (intVal 1)
+#eval operationalOrderGe (intVal 2) (intVal 1)
+#eval operationalApplyCmp ">=" (intVal 2) (intVal 1)
+#eval operationalOrderablePair (intVal 1) (intVal 2)
+#eval operationalOrderGe (intVal 1) (intVal 2)
+#eval operationalApplyCmp ">=" (intVal 1) (intVal 2)
+#eval operationalOrderGe (boolVal true) (boolVal false)
+#eval operationalApplyCmp ">=" (boolVal true) (boolVal false)
+
+def generatedSortStrIsEmpty (value : SortStr) : False := nomatch value
+#check generatedSortStrIsEmpty
