     3	module CONNECTION-SPEC
     4	  imports VERIFICATION-BASE
     5	
     6	  claim [ge-int-int]:
     7	    <k> applyCmp(">=", I:Int, J:Int) => orderGe(I, J) </k>
     8	
     9	  claim [ge-bool-bool]:
    10	    <k> applyCmp(">=", B:Bool, C:Bool) => orderGe(B, C) </k>
    11	
    12	  claim [ge-bool-int]:
    13	    <k> applyCmp(">=", B:Bool, I:Int) => orderGe(B, I) </k>
    14	
    15	  claim [ge-int-bool]:
    16	    <k> applyCmp(">=", I:Int, B:Bool) => orderGe(I, B) </k>
    17	
    18	  claim [ge-float-float]:
    19	    <k> applyCmp(">=", F:Float, G:Float) => orderGe(F, G) </k>
    20	
    21	  claim [ge-int-float]:
    22	    <k> applyCmp(">=", I:Int, F:Float) => orderGe(I, F) </k>
    23	
    24	  claim [ge-float-int]:
    25	    <k> applyCmp(">=", F:Float, I:Int) => orderGe(F, I) </k>
    26	
    27	  claim [ge-bool-float]:
    28	    <k> applyCmp(">=", B:Bool, F:Float) => orderGe(B, F) </k>
    29	
    30	  claim [ge-float-bool]:
    31	    <k> applyCmp(">=", F:Float, B:Bool) => orderGe(F, B) </k>
    32	
    33	  claim [ge-str-str]:
    34	    <k>
    35	      applyCmp(">=", str(A:IntSeq), str(B:IntSeq))
    36	      => orderGe(str(A), str(B))
    37	    </k>
    38	endmodule
     1	def can_arrange(arr):
     2	    index = -1
     3	    i = 0
     4	    previous = 0
     5	    value = 0
     6	    for value in arr:
     7	        if i > 0:
     8	            if not value >= previous:
     9	                index = i
    10	        previous = value
    11	        i = i + 1
    12	    return index
     1	Module(
     2	  FuncDef("can_arrange", Params("arr"),
     3	    Assign(Name("index"), UnaryOp("-", Int(1)))
     4	    Assign(Name("i"), Int(0))
     5	    Assign(Name("previous"), Int(0))
     6	    Assign(Name("value"), Int(0))
     7	    For(Name("value"), Name("arr"),
     8	      If(Compare(Name("i"), CmpOp(">", Int(0))),
     9	        If(UnaryOp(
    10	          "not",
    11	          Compare(Name("value"), CmpOp(">=", Name("previous")))),
    12	          Assign(Name("index"), Name("i")),
    13	          ),
    14	        )
    15	      Assign(Name("previous"), Name("value"))
    16	      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    17	    Return(Name("index"))))

