     5	
     6	  claim [can-arrange-loop]:
     7	    <k>
     8	      (#loop(
     9	        list(VS),
    10	        Name("value"),
    11	        If(
    12	          Compare(Name("i"), CmpOp(">", Int(0))),
    13	          If(
    14	            UnaryOp(
    15	              "not",
    16	              Compare(
    17	                Name("value"),
    18	                CmpOp(">=", Name("previous")))),
    19	            Assign(Name("index"), Name("i")),
    20	            .Stmts),
    21	          .Stmts)
    22	        Assign(Name("previous"), Name("value"))
    23	        Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
    24	        .Stmts)
    25	      => .K)
    26	      ~> (Return(Name("index")) .Stmts)
    27	      ~> #endcall
    28	    </k>
    29	    <env> 1 </env>
    30	    <scopes>
    31	      -1 |-> builtinsScope
    32	      0  |-> scope(
    33	        "can_arrange" |->
    34	          closureVal(
    35	            "arr", .ParamNames,
    36	            Assign(Name("index"), UnaryOp("-", Int(1)))
    37	            Assign(Name("i"), Int(0))
    38	            Assign(Name("previous"), Int(0))
    39	            Assign(Name("value"), Int(0))
    40	            For(
    41	              Name("value"), Name("arr"),
    42	              If(
    43	                Compare(Name("i"), CmpOp(">", Int(0))),
    44	                If(
    45	                  UnaryOp(
    46	                    "not",
    47	                    Compare(
    48	                      Name("value"),
    49	                      CmpOp(">=", Name("previous")))),
    50	                  Assign(Name("index"), Name("i")),
    51	                  .Stmts),
    52	                .Stmts)
    53	              Assign(Name("previous"), Name("value"))
    54	              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
    55	              .Stmts)
    56	            Return(Name("index"))
    57	            .Stmts,
    58	            0),
    59	        parent(-1))
    60	      1  |-> scope(
    61	        "arr"      |-> list(ORIG)
    62	        "i"        |-> (I => ?FINAL_I:Int)
    63	        "index"    |-> (A => arrangeSeq(VS, I, P, A))
    64	        "previous" |-> (P => ?FINAL_PREVIOUS:Val)
    65	        "value"    |-> (P => ?FINAL_VALUE:Val),
    66	        parent(0))
    67	    </scopes>
    68	    <scopeLoc> 2 </scopeLoc>
    69	    <heap> .Map </heap>
    70	    <heapLoc> 0 </heapLoc>
    71	    <stack> ListItem(frame(.K, 0, 1)) </stack>
    72	    <ret> noRet </ret>
    73	    <exc> NoExc </exc>
    74	    <exit-code> 0 </exit-code>
    75	    requires I >=Int 0
    76	     andBool scanDefined(VS, I, P)
