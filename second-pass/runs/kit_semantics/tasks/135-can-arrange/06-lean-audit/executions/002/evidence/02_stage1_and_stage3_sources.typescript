     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  syntax Bool ::= isNumericVal(Val) [function, total]
     7	  rule isNumericVal(V:Val)
     8	    => isInt(V) orBool isBool(V) orBool isFloat(V)
     9	
    10	  syntax Bool ::= orderablePair(Val, Val) [function, total]
    11	  rule orderablePair(V:Val, W:Val)
    12	    => (isNumericVal(V) andBool isNumericVal(W))
    13	       orBool (isStr(V) andBool isStr(W))
    14	
    15	  // This recursive predicate exactly characterizes the list inputs for which
    16	  // every comparison performed by the scan is defined in MPY.  The first
    17	  // element is unrestricted because the program does not compare it.
    18	  syntax Bool ::= scanDefined(ValSeq, Int, Val)
    19	    [function, total, no-evaluators]
    20	  rule scanDefined(.ValSeq, _I:Int, _P:Val) => true
    21	    [simplification]
    22	  rule scanDefined(vCons(V:Val, R:ValSeq), I:Int, _P:Val)
    23	    => scanDefined(R, I +Int 1, V)
    24	    requires I ==Int 0
    25	    [simplification]
    26	  rule scanDefined(vCons(V:Val, R:ValSeq), I:Int, P:Val)
    27	    => orderablePair(V, P) andBool scanDefined(R, I +Int 1, V)
    28	    requires I >Int 0
    29	    [simplification]
    30	  rule scanDefined(vCons(_V:Val, _R:ValSeq), I:Int, _P:Val) => false
    31	    requires I <Int 0
    32	    [simplification]
    33	
    34	  // A total mathematical presentation of the fixed semantics' >= dispatch.
    35	  // The ten orderable cases are disjoint and cover orderablePair exactly.
    36	  syntax Bool ::= orderGe(Val, Val)
    37	    [function, total, no-evaluators]
    38	  rule orderGe(I:Int, J:Int) => I >=Int J [simplification]
    39	  rule orderGe(B:Bool, C:Bool)
    40	    => boolAsInt(B) >=Int boolAsInt(C)
    41	    [simplification]
    42	  rule orderGe(B:Bool, I:Int)
    43	    => boolAsInt(B) >=Int I
    44	    [simplification]
    45	  rule orderGe(I:Int, B:Bool)
    46	    => I >=Int boolAsInt(B)
    47	    [simplification]
    48	  rule orderGe(F:Float, G:Float)
    49	    => notBool floatLt(F, G)
    50	    [simplification]
    51	  rule orderGe(I:Int, F:Float)
    52	    => notBool ltIF(I, F)
    53	    [simplification]
    54	  rule orderGe(F:Float, I:Int)
    55	    => notBool ltFI(F, I)
    56	    [simplification]
    57	  rule orderGe(B:Bool, F:Float)
    58	    => notBool ltIF(boolAsInt(B), F)
    59	    [simplification]
    60	  rule orderGe(F:Float, B:Bool)
    61	    => notBool ltFI(F, boolAsInt(B))
    62	    [simplification]
    63	  rule orderGe(str(A:IntSeq), str(B:IntSeq))
    64	    => notBool strLt(A, B)
    65	    [simplification]
    66	  rule orderGe(V:Val, W:Val) => false
    67	    requires notBool orderablePair(V, W)
    68	    [simplification]
    69	
    70	  // Mathematical left-to-right scan of the unvisited suffix.  I is the
    71	  // current absolute index, P is the preceding value (ignored when I == 0),
    72	  // and A is the largest matching index already seen.
    73	  syntax Int ::= arrangeSeq(ValSeq, Int, Val, Int)
    74	    [function, total, no-evaluators]
    75	
    76	  rule arrangeSeq(.ValSeq, _I:Int, _P:Val, A:Int) => A
    77	    [simplification]
    78	
    79	  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, _P:Val, A:Int)
    80	    => arrangeSeq(R, I +Int 1, V, A)
    81	    requires I ==Int 0
    82	    [simplification]
    83	
    84	  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, P:Val, _A:Int)
    85	    => arrangeSeq(R, I +Int 1, V, I)
    86	    requires I >Int 0
    87	     andBool notBool orderGe(V, P)
    88	    [simplification]
    89	
    90	  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, P:Val, A:Int)
    91	    => arrangeSeq(R, I +Int 1, V, A)
    92	    requires I >Int 0
    93	     andBool orderGe(V, P)
    94	    [simplification]
    95	
    96	  rule arrangeSeq(vCons(_V:Val, _R:ValSeq), I:Int, _P:Val, A:Int) => A
    97	    requires I <Int 0
    98	    [simplification]
    99	endmodule
   100	
   101	module VERIFICATION
   102	  imports VERIFICATION-BASE
   103	
   104	  // Guarded dynamic-dispatch bridge.  connection-spec.k proves, without this
   105	  // module, that each of its ten static cases is the corresponding MPY rule.
   106	  rule applyCmp(">=", V:Val, W:Val) => orderGe(V, W)
   107	    requires orderablePair(V, W)
   108	    [simplification]
   109	endmodule
     1	requires "verification.k"
