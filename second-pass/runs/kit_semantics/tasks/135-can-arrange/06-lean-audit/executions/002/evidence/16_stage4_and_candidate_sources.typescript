   191	def operationalValSeqLength : SortValSeq → Nat
   192	  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => 0
   193	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ tail =>
