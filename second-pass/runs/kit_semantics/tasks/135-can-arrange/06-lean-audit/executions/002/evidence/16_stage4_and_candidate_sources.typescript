   183	def operationalSubsetCodes : SortIntSeq → SortIntSeq → SortBool
   184	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», _ => true
   185	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail, right =>
   186	      operationalCodeIn head right && operationalSubsetCodes tail right
