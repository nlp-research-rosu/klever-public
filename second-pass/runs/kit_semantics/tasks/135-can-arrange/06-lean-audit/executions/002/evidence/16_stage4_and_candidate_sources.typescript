   178	def operationalCodeIn (code : SortInt) : SortIntSeq → SortBool
   179	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
   180	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail =>
   181	      decide (code = head) || operationalCodeIn code tail
