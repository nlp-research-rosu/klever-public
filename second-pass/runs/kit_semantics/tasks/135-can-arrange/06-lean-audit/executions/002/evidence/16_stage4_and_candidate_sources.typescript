   235	/- Complete frozen applyCmp table relative to the immutable Base value universe.
   236	   MPY-STR rules are unrepresentable because SortStr has no constructors. -/
   237	def operationalApplyCmp
   238	    (operator : SortString) (left right : SortVal) : SortBool :=
   239	  if operator = ">=" then
   240	    if operationalOrderablePair left right then
   241	      operationalOrderGe left right
   242	    else
   243	      false
   244	  else
   245	    match operator, left, right with
   246	    | "==", value, SortVal.«noneV_MPY-CORE_Val» => operationalIsNone value
   247	    | "!=", value, SortVal.«noneV_MPY-CORE_Val» => !(operationalIsNone value)
   248	    | "is", value, SortVal.«noneV_MPY-CORE_Val» => operationalIsNone value
   249	    | "is not", value, SortVal.«noneV_MPY-CORE_Val» => !(operationalIsNone value)
   250	    | op, .inj_SortInt leftInt, .inj_SortInt rightInt =>
   251	        operationalCompareInts op leftInt rightInt
   252	    | op, .inj_SortBool leftBool, .inj_SortBool rightBool =>
   253	        operationalCompareInts op
   254	          (operationalBoolAsInt leftBool) (operationalBoolAsInt rightBool)
   255	    | op, .inj_SortBool leftBool, .inj_SortInt rightInt =>
   256	        operationalCompareInts op (operationalBoolAsInt leftBool) rightInt
   257	    | op, .inj_SortInt leftInt, .inj_SortBool rightBool =>
   258	        operationalCompareInts op leftInt (operationalBoolAsInt rightBool)
   259	    | op, .inj_SortFloat leftFloat, .inj_SortFloat rightFloat =>
   260	        operationalCompareFloats op leftFloat rightFloat
   261	    | op, .inj_SortInt leftInt, .inj_SortFloat rightFloat =>
   262	        operationalCompareIntFloat op leftInt rightFloat
   263	    | op, .inj_SortFloat leftFloat, .inj_SortInt rightInt =>
   264	        operationalCompareFloatInt op leftFloat rightInt
   265	    | op, .inj_SortBool leftBool, .inj_SortFloat rightFloat =>
   266	        operationalCompareIntFloat op (operationalBoolAsInt leftBool) rightFloat
   267	    | op, .inj_SortFloat leftFloat, .inj_SortBool rightBool =>
   268	        operationalCompareFloatInt op leftFloat (operationalBoolAsInt rightBool)
   269	    | "==",
   270	        .inj_SortIterable
   271	          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» leftValues),
   272	        .inj_SortIterable
   273	          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
   274	        leftValues == rightValues
   275	    | "!=",
   276	        .inj_SortIterable
   277	          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» leftValues),
   278	        .inj_SortIterable
   279	          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
   280	        !(leftValues == rightValues)
   281	    | "==",
   282	        .inj_SortIterable
   283	          (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» leftValues),
   284	        .inj_SortIterable
   285	          (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
   286	        leftValues == rightValues
   287	    | "!=",
   288	        .inj_SortIterable
   289	          (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» leftValues),
   290	        .inj_SortIterable
   291	          (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
   292	        !(leftValues == rightValues)
   293	    | "==",
   294	        SortVal.«setV(_)_MPY-SET_Val_IntSeq» leftCodes,
   295	        SortVal.«setV(_)_MPY-SET_Val_IntSeq» rightCodes =>
   296	        operationalSameSet leftCodes rightCodes
   297	    | "==",
   298	        SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» leftKeys leftValues,
   299	        SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» rightKeys rightValues =>
   300	        operationalDictEq leftKeys leftValues rightKeys rightValues
   301	    | _, .inj_SortStr string, _ => nomatch string
   302	    | _, _, .inj_SortStr string => nomatch string
   303	    | _, _, _ => false
