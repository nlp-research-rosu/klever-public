    21	def operationalIsNumericVal : SortVal → SortBool
    22	  | .inj_SortBool _ => true
    23	  | .inj_SortFloat _ => true
    24	  | .inj_SortInt _ => true
    25	  | _ => false
    26	
    27	def operationalIsStrVal : SortVal → SortBool
    28	  | .inj_SortStr _ => true
    29	  | _ => false
    30	
    31	def operationalOrderablePair (left right : SortVal) : SortBool :=
    32	  (operationalIsNumericVal left && operationalIsNumericVal right) ||
    33	    (operationalIsStrVal left && operationalIsStrVal right)
    34	
    35	def operationalBoolAsInt : SortBool → SortInt
    36	  | false => 0
    37	  | true => 1
    38	
    39	def operationalFloatLt (left right : SortFloat) : SortBool :=
    40	  decide (left < right)
    41	
    42	def operationalFloatGt (left right : SortFloat) : SortBool :=
    43	  decide (right < left)
    44	
    45	/- Exact binary64 decomposition for MPY-FLOAT's unbounded Int/Float bridge. -/
    46	def operationalFiniteFloatParts
    47	    (value : SortFloat) : SortBool × Nat × SortInt :=
    48	  let bits := value.toBits.toNat
    49	  let negative := decide (bits / (2 ^ 63) = 1)
    50	  let storedExponent := (bits / (2 ^ 52)) % (2 ^ 11)
    51	  let fraction := bits % (2 ^ 52)
    52	  if storedExponent = 0 then
    53	    (negative, fraction, -1074)
    54	  else
    55	    (negative, (2 ^ 52) + fraction, Int.ofNat storedExponent - 1075)
    56	
    57	def operationalSplitFloatMagnitude
    58	    (significand : Nat) (binaryExponent : SortInt) : Nat × Nat :=
    59	  if binaryExponent ≥ 0 then
    60	    (significand * (2 ^ binaryExponent.toNat), 0)
    61	  else
    62	    let denominator := 2 ^ (-binaryExponent).toNat
    63	    (significand / denominator, significand % denominator)
    64	
    65	def operationalFloorFiniteFloat (value : SortFloat) : SortInt :=
    66	  let (negative, significand, binaryExponent) :=
    67	    operationalFiniteFloatParts value
    68	  let (quotient, remainder) :=
    69	    operationalSplitFloatMagnitude significand binaryExponent
    70	  if negative then
    71	    -Int.ofNat (quotient + if remainder = 0 then 0 else 1)
    72	  else
    73	    Int.ofNat quotient
    74	
    75	def operationalCeilFiniteFloat (value : SortFloat) : SortInt :=
    76	  let (negative, significand, binaryExponent) :=
    77	    operationalFiniteFloatParts value
    78	  let (quotient, remainder) :=
    79	    operationalSplitFloatMagnitude significand binaryExponent
    80	  if negative then
    81	    -Int.ofNat quotient
    82	  else
    83	    Int.ofNat (quotient + if remainder = 0 then 0 else 1)
    84	
    85	def operationalNegativeFloat (value : SortFloat) : SortBool :=
    86	  decide (value.toBits.toNat / (2 ^ 63) = 1)
    87	
    88	def operationalLtFI (value : SortFloat) (integer : SortInt) : SortBool :=
    89	  if value.isFinite then
    90	    decide (operationalFloorFiniteFloat value < integer)
    91	  else if value.isNaN then
    92	    false
    93	  else
    94	    operationalNegativeFloat value
    95	
    96	def operationalLtIF (integer : SortInt) (value : SortFloat) : SortBool :=
    97	  if value.isFinite then
    98	    decide (integer < operationalCeilFiniteFloat value)
    99	  else if value.isNaN then
   100	    false
   101	  else
   102	    !(operationalNegativeFloat value)
   103	
   104	def operationalEqIF (integer : SortInt) (value : SortFloat) : SortBool :=
   105	  if value.isFinite then
   106	    decide (
   107	      operationalFloorFiniteFloat value = operationalCeilFiniteFloat value ∧
   108	      operationalFloorFiniteFloat value = integer)
   109	  else
   110	    false
