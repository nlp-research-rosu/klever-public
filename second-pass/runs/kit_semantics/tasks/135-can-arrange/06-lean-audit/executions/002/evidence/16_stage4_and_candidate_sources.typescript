   196	def operationalHasDictKey (key : SortVal) : SortValSeq → SortBool
   197	  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => false
   198	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» head tail =>
   199	      (head == key) || operationalHasDictKey key tail
