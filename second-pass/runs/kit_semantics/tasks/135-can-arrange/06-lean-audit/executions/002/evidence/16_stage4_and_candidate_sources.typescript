   112	def operationalCompareInts
   113	    (operator : SortString) (left right : SortInt) : SortBool :=
   114	  match operator with
   115	  | "<" => decide (left < right)
   116	  | "<=" => decide (left ≤ right)
   117	  | ">" => decide (left > right)
   118	  | ">=" => decide (left ≥ right)
   119	  | "==" => decide (left = right)
   120	  | "!=" => decide (left ≠ right)
   121	  | _ => false
   122	
   123	def operationalCompareFloats
   124	    (operator : SortString) (left right : SortFloat) : SortBool :=
   125	  match operator with
   126	  | "<" => operationalFloatLt left right
   127	  | "<=" => !(operationalFloatGt left right)
   128	  | ">" => operationalFloatGt left right
   129	  | ">=" => !(operationalFloatLt left right)
   130	  | "==" => Float.beq left right
   131	  | "!=" => !(Float.beq left right)
   132	  | _ => false
   133	
   134	def operationalCompareIntFloat
   135	    (operator : SortString) (integer : SortInt) (value : SortFloat) : SortBool :=
   136	  match operator with
   137	  | "<" => operationalLtIF integer value
   138	  | "<=" => !(operationalLtFI value integer)
   139	  | ">" => operationalLtFI value integer
   140	  | ">=" => !(operationalLtIF integer value)
   141	  | "==" => operationalEqIF integer value
   142	  | "!=" => !(operationalEqIF integer value)
   143	  | _ => false
   144	
   145	def operationalCompareFloatInt
   146	    (operator : SortString) (value : SortFloat) (integer : SortInt) : SortBool :=
   147	  match operator with
   148	  | "<" => operationalLtFI value integer
   149	  | "<=" => !(operationalLtIF integer value)
   150	  | ">" => operationalLtIF integer value
   151	  | ">=" => !(operationalLtFI value integer)
   152	  | "==" => operationalEqIF integer value
   153	  | "!=" => !(operationalEqIF integer value)
   154	  | _ => false
