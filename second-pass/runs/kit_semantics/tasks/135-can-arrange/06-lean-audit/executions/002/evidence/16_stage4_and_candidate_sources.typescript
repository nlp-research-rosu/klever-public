     5	/- Structural equality used by frozen `==K` rules.  Direct float comparison
     6	   below deliberately uses IEEE equality instead. -/
     7	local instance operationalStructuralFloatBEq : BEq SortFloat where
     8	  beq left right := left.toBits == right.toBits
