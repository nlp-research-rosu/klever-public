   201	def operationalGetDictValue
   202	    (key : SortVal) : SortValSeq → SortValSeq → Option SortVal
   203	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» candidate keyTail,
   204	      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value valueTail =>
   205	      if candidate == key then
   206	        some value
   207	      else
   208	        operationalGetDictValue key keyTail valueTail
   209	  | _, _ => none
