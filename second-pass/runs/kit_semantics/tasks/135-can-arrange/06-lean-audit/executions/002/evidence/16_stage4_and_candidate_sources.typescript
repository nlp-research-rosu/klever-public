   156	def operationalOrderGe : SortVal → SortVal → SortBool
   157	  | .inj_SortInt left, .inj_SortInt right => decide (left ≥ right)
   158	  | .inj_SortBool left, .inj_SortBool right =>
   159	      decide (operationalBoolAsInt left ≥ operationalBoolAsInt right)
   160	  | .inj_SortBool left, .inj_SortInt right =>
   161	      decide (operationalBoolAsInt left ≥ right)
   162	  | .inj_SortInt left, .inj_SortBool right =>
   163	      decide (left ≥ operationalBoolAsInt right)
   164	  | .inj_SortFloat left, .inj_SortFloat right =>
   165	      !(operationalFloatLt left right)
   166	  | .inj_SortInt left, .inj_SortFloat right =>
   167	      !(operationalLtIF left right)
   168	  | .inj_SortFloat left, .inj_SortInt right =>
   169	      !(operationalLtFI left right)
   170	  | .inj_SortBool left, .inj_SortFloat right =>
   171	      !(operationalLtIF (operationalBoolAsInt left) right)
   172	  | .inj_SortFloat left, .inj_SortBool right =>
   173	      !(operationalLtFI left (operationalBoolAsInt right))
   174	  | .inj_SortStr string, _ => nomatch string
   175	  | _, .inj_SortStr string => nomatch string
   176	  | _, _ => false
