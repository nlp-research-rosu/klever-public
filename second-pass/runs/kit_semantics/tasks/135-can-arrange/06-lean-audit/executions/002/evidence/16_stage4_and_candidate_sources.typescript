   226	def operationalDictEq
   227	    (leftKeys leftValues rightKeys rightValues : SortValSeq) : SortBool :=
   228	  decide (operationalValSeqLength leftKeys = operationalValSeqLength rightKeys) &&
   229	    operationalDictSubset leftKeys leftValues rightKeys rightValues
