   211	def operationalDictSubset :
   212	    SortValSeq → SortValSeq → SortValSeq → SortValSeq → SortBool
   213	  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq»,
   214	      SortValSeq.«.ValSeq_MPY-CORE_ValSeq», _, _ => true
   215	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» key keyTail,
   216	      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value valueTail,
   217	      rightKeys, rightValues =>
   218	      operationalHasDictKey key rightKeys &&
   219	        match operationalGetDictValue key rightKeys rightValues with
   220	        | some found =>
   221	            (found == value) &&
   222	              operationalDictSubset keyTail valueTail rightKeys rightValues
   223	        | none => false
   224	  | _, _, _, _ => false
