     1	Module(
     2	  FuncDef("can_arrange", Params("arr"),
     3	    Assign(Name("index"), UnaryOp("-", Int(1)))
     4	    Assign(Name("i"), Int(0))
     5	    Assign(Name("previous"), Int(0))
     6	    Assign(Name("value"), Int(0))
     7	    For(Name("value"), Name("arr"),
     8	      If(Compare(Name("i"), CmpOp(">", Int(0))),
     9	        If(UnaryOp(
    10	          "not",
    11	          Compare(Name("value"), CmpOp(">=", Name("previous")))),
    12	          Assign(Name("index"), Name("i")),
    13	          ),
    14	        )
    15	      Assign(Name("previous"), Name("value"))
    16	      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    17	    Return(Name("index"))))

