+    <k> applyCmp(">=", I:Int, F:Float) => orderGe(I, F) </k>
+
+  claim [ge-float-int]:
+    <k> applyCmp(">=", F:Float, I:Int) => orderGe(F, I) </k>
+
+  claim [ge-bool-float]:
+    <k> applyCmp(">=", B:Bool, F:Float) => orderGe(B, F) </k>
+
+  claim [ge-float-bool]:
+    <k> applyCmp(">=", F:Float, B:Bool) => orderGe(F, B) </k>
+
+  claim [ge-str-str]:
+    <k>
+      applyCmp(">=", str(A:IntSeq), str(B:IntSeq))
+      => orderGe(str(A), str(B))
+    </k>
+endmodule
