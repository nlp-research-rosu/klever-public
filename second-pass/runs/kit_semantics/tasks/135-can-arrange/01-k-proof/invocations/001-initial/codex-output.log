@@ -0,0 +1,38 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical left-to-right scan of the unvisited suffix.  I is the
+  // current absolute index, P is the preceding value (ignored when I == 0),
+  // and A is the largest matching index already seen.
+  syntax Int ::= arrangeSeq(ValSeq, Int, Val, Int)
+    [function, total, no-evaluators]
+
+  rule arrangeSeq(.ValSeq, _I:Int, _P:Val, A:Int) => A
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), 0, _P:Val, A:Int)
+    => arrangeSeq(R, 1, V, A)
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, P:Val, _A:Int)
+    => arrangeSeq(R, I +Int 1, V, I)
+    requires I >Int 0
+     andBool notBool applyCmp(">=", V, P)
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, P:Val, A:Int)
+    => arrangeSeq(R, I +Int 1, V, A)
+    requires I >Int 0
+     andBool applyCmp(">=", V, P)
+    [simplification]
+
+  // The final value of both `previous` and `value`.
+  syntax Val ::= lastVal(Val, ValSeq)
+    [function, total, no-evaluators]
+  rule lastVal(P:Val, .ValSeq) => P [simplification]
+  rule lastVal(_P:Val, vCons(V:Val, R:ValSeq))
+    => lastVal(V, R)
+    [simplification]
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..580900d31ffc2aa5dd9194d5a564351afad9acf0
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,20 @@
+def can_arrange(arr):
+    index = -1
+    i = 0
+    previous = 0
+    value = 0
+    for value in arr:
+        if i > 0:
+            if not value >= previous:
+                index = i
+        previous = value
+        i = i + 1
+    return index
+
+
+assert can_arrange([]) == -1
+assert can_arrange([1]) == -1
+assert can_arrange([1, 2, 4, 3, 5]) == 3
+assert can_arrange([1, 2, 3]) == -1
+assert can_arrange([5, 4, 3]) == 2
+assert can_arrange(["b", "a", "c"]) == 1
