index 0000000000000000000000000000000000000000..818bfd713ce07784c6d06756339276d08ecc3c6f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,144 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [can-arrange-loop]:
+    <k>
+      #while(
+        Compare(Name("i"),
+                CmpOp("<", Call(Name("len"), Name("arr")))),
+        If(
+          UnaryOp(
+            "not",
+            Compare(
+              Subscript(Name("arr"), Name("i")),
+              CmpOp(
+                ">=",
+                Subscript(
+                  Name("arr"),
+                  BinOp("-", Name("i"), Int(1)))))),
+          Assign(Name("index"), Name("i")),
+          .Stmts)
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+        .Stmts)
+      => .K
+      ~> Return(Name("index"))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "can_arrange" |->
+          closureVal(
+            "arr", .ParamNames,
+            Assign(Name("index"), UnaryOp("-", Int(1)))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"),
+                      CmpOp("<", Call(Name("len"), Name("arr")))),
+              If(
+                UnaryOp(
+                  "not",
+                  Compare(
+                    Subscript(Name("arr"), Name("i")),
+                    CmpOp(
+                      ">=",
+                      Subscript(
+                        Name("arr"),
+                        BinOp("-", Name("i"), Int(1)))))),
+                Assign(Name("index"), Name("i")),
+                .Stmts)
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("index"))
+            .Stmts,
+            0),
+        parent(-1))
+      1  |-> scope(
+        "arr"   |-> list(VS)
+        "i"     |-> (I => loopExitIndex(I, vsLen(VS)))
+        "index" |-> (A => arrangeFrom(VS, I, A)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 1
+
+  claim [can-arrange]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "can_arrange", Params("arr"),
+            Assign(Name("index"), UnaryOp("-", Int(1)))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"),
+                      CmpOp("<", Call(Name("len"), Name("arr")))),
+              If(
+                UnaryOp(
+                  "not",
+                  Compare(
+                    Subscript(Name("arr"), Name("i")),
+                    CmpOp(
+                      ">=",
+                      Subscript(
+                        Name("arr"),
+                        BinOp("-", Name("i"), Int(1)))))),
+                Assign(Name("index"), Name("i")),
+                .Stmts)
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("index"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("can_arrange"), list(VS))
+      => arrangeFrom(VS, 1, -1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        => "can_arrange" |->
+             closureVal(
+               "arr", .ParamNames,
+               Assign(Name("index"), UnaryOp("-", Int(1)))
+               Assign(Name("i"), Int(1))
+               While(
+                 Compare(Name("i"),
+                         CmpOp("<", Call(Name("len"), Name("arr")))),
+                 If(
+                   UnaryOp(
+                     "not",
+                     Compare(
+                       Subscript(Name("arr"), Name("i")),
+                       CmpOp(
+                         ">=",
+                         Subscript(
+                           Name("arr"),
+                           BinOp("-", Name("i"), Int(1)))))),
+                   Assign(Name("index"), Name("i")),
+                   .Stmts)
+                 Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+                 .Stmts)
+               Return(Name("index"))
+               .Stmts,
+               0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..60d3471c580ce38a3791e92e019560e083879e29
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical scan of indices [I, vsLen(VS)).  This is a definitional
+  // summary: it does not rewrite or bypass any program computation.
+  syntax Int ::= arrangeFrom(ValSeq, Int, Int)
+    [function, total, no-evaluators]
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int) => A
+    requires I >=Int vsLen(VS)
+    [simplification]
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int)
+    => arrangeFrom(VS, I +Int 1, I)
+    requires I <Int vsLen(VS)
+     andBool notBool applyCmp(">=",
+                              valSeqAt(VS, I),
+                              valSeqAt(VS, I -Int 1))
+    [simplification]
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int)
+    => arrangeFrom(VS, I +Int 1, A)
+    requires I <Int vsLen(VS)
+     andBool applyCmp(">=",
+                      valSeqAt(VS, I),
+                      valSeqAt(VS, I -Int 1))
+    [simplification]
+
+  // The loop increments i until it reaches the length, unless it starts past
+  // the end (the empty-list entry case starts at 1).
+  syntax Int ::= loopExitIndex(Int, Int) [function, total]
+  rule loopExitIndex(I:Int, L:Int) => L requires I <Int L
+  rule loopExitIndex(I:Int, L:Int) => I requires I >=Int L
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed8f602e89b8ad9c483634543aabc33e8fda916f
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def can_arrange(arr):
+    index = -1
+    i = 1
+    while i < len(arr):
+        if not arr[i] >= arr[i - 1]:
+            index = i
+        i = i + 1
+    return index
+
+
+assert can_arrange([]) == -1
+assert can_arrange([1]) == -1
+assert can_arrange([1, 2, 4, 3, 5]) == 3
+assert can_arrange([1, 2, 3]) == -1
+assert can_arrange([5, 4, 3]) == 2
+assert can_arrange(["b", "a", "c"]) == 1
