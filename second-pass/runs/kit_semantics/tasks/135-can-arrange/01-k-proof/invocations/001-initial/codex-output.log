diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..60d3471c580ce38a3791e92e019560e083879e29
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical scan of indices [I, vsLen(VS)).  This is a definitional
+  // summary: it does not rewrite or bypass any program computation.
+  syntax Int ::= arrangeFrom(ValSeq, Int, Int)
+    [function, total, no-evaluators]
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int) => A
+    requires I >=Int vsLen(VS)
+    [simplification]
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int)
+    => arrangeFrom(VS, I +Int 1, I)
+    requires I <Int vsLen(VS)
+     andBool notBool applyCmp(">=",
+                              valSeqAt(VS, I),
+                              valSeqAt(VS, I -Int 1))
+    [simplification]
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int)
+    => arrangeFrom(VS, I +Int 1, A)
+    requires I <Int vsLen(VS)
+     andBool applyCmp(">=",
+                      valSeqAt(VS, I),
+                      valSeqAt(VS, I -Int 1))
+    [simplification]
+
+  // The loop increments i until it reaches the length, unless it starts past
+  // the end (the empty-list entry case starts at 1).
+  syntax Int ::= loopExitIndex(Int, Int) [function, total]
+  rule loopExitIndex(I:Int, L:Int) => L requires I <Int L
+  rule loopExitIndex(I:Int, L:Int) => I requires I >=Int L
+endmodule

