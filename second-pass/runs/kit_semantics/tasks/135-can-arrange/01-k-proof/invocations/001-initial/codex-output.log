+                     Assign(Name("index"), Name("i")),
+                     .Stmts),
+                   .Stmts)
+                 Assign(Name("previous"), Name("value"))
+                 Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+                 .Stmts)
+               Return(Name("index"))
+               .Stmts,
+               0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
