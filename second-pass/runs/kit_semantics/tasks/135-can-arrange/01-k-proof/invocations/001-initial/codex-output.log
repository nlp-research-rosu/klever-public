diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ba23fe0044bb9e7cc35d7e1e634cb7ed4e803b21
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,136 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [can-arrange-loop]:
+    <k>
+      #while(
+        Compare(Name("i"),
+                CmpOp("<", Call(Name("len"), Name("arr")))),
+        If(
+          UnaryOp(
+            "not",
+            Compare(
+              Subscript(Name("arr"), Name("i")),
+              CmpOp(
+                ">=",
+                Subscript(
+                  Name("arr"),
+                  BinOp("-", Name("i"), Int(1)))))),
+          Assign(Name("index"), Name("i")),
+          .Stmts)
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "can_arrange" |->
+          closureVal(
+            "arr", .ParamNames,
+            Assign(Name("index"), UnaryOp("-", Int(1)))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"),
+                      CmpOp("<", Call(Name("len"), Name("arr")))),
+              If(
+                UnaryOp(
+                  "not",
+                  Compare(
+                    Subscript(Name("arr"), Name("i")),
+                    CmpOp(
+                      ">=",
+                      Subscript(
+                        Name("arr"),
+                        BinOp("-", Name("i"), Int(1)))))),
+                Assign(Name("index"), Name("i")),
+                .Stmts)
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("index"))
+            .Stmts,
+            0),
+        parent(-1))
+      1  |-> scope(
+        "arr"   |-> list(VS)
+        "i"     |-> (I => loopExitIndex(I, vsLen(VS)))
+        "index" |-> (A => arrangeFrom(VS, I, A)),
+        parent(0))
+    </scopes>
+    requires I >=Int 1
+
+  claim [can-arrange]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "can_arrange", Params("arr"),
+            Assign(Name("index"), UnaryOp("-", Int(1)))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"),
+                      CmpOp("<", Call(Name("len"), Name("arr")))),
+              If(
+                UnaryOp(
+                  "not",
+                  Compare(
+                    Subscript(Name("arr"), Name("i")),
+                    CmpOp(
+                      ">=",
+                      Subscript(
+                        Name("arr"),
+                        BinOp("-", Name("i"), Int(1)))))),
+                Assign(Name("index"), Name("i")),
+                .Stmts)
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("index"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("can_arrange"), list(VS))
+      => arrangeFrom(VS, 1, -1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        => "can_arrange" |->
+             closureVal(
+               "arr", .ParamNames,
+               Assign(Name("index"), UnaryOp("-", Int(1)))
+               Assign(Name("i"), Int(1))
+               While(
+                 Compare(Name("i"),
+                         CmpOp("<", Call(Name("len"), Name("arr")))),
+                 If(
+                   UnaryOp(
+                     "not",
+                     Compare(
+                       Subscript(Name("arr"), Name("i")),
+                       CmpOp(
+                         ">=",
+                         Subscript(
+                           Name("arr"),
+                           BinOp("-", Name("i"), Int(1)))))),
+                   Assign(Name("index"), Name("i")),
+                   .Stmts)
+                 Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+                 .Stmts)
+               Return(Name("index"))
+               .Stmts,
+               0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0ebdad81a5b07c77ae9037b6bef7879001445a4f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical scan of indices [I, vsLen(VS)).  This is a definitional
+  // summary: it does not rewrite or bypass any program computation.
+  syntax Int ::= arrangeFrom(ValSeq, Int, Int) [function]
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int) => A
+    requires I >=Int vsLen(VS)
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int)
+    => arrangeFrom(VS, I +Int 1, I)
+    requires I <Int vsLen(VS)
+     andBool notBool applyCmp(">=",
+                              valSeqAt(VS, I),
+                              valSeqAt(VS, I -Int 1))
+
+  rule arrangeFrom(VS:ValSeq, I:Int, A:Int)
+    => arrangeFrom(VS, I +Int 1, A)
+    requires I <Int vsLen(VS)
+     andBool applyCmp(">=",
