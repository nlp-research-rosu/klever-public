+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // One-constructor-at-a-time input-domain predicate.  Its guarded
+  // simplification equations avoid eager unfolding on an abstract sequence.
+  syntax Bool ::= allInts(ValSeq)
+    [function, total, no-evaluators]
+  rule allInts(.ValSeq) => true [simplification]
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+    [simplification]
+
+  // Total twin of the partial Val-to-Int subsort projection.  Every use is
+  // guarded by isInt; the orientation pair connects it to K's built-in cast.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
+    [simplification]
+
+  // Guarded dispatch twin of MPY-INT's existing >= equation.
+  rule applyCmp(">=", V:Val, W:Val)
+    => projectIntTotal(V) >=Int projectIntTotal(W)
+    requires isInt(V) andBool isInt(W)
+    [simplification]
+
+  // Mathematical left-to-right scan of the unvisited suffix.  I is the
+  // current absolute index, P is the preceding value (ignored when I == 0),
+  // and A is the largest matching index already seen.
+  syntax Int ::= arrangeSeq(ValSeq, Int, Val, Int)
+    [function, total, no-evaluators]
+
+  rule arrangeSeq(.ValSeq, _I:Int, _P:Val, A:Int) => A
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, _P:Val, A:Int)
+    => arrangeSeq(R, I +Int 1, V, A)
+    requires I ==Int 0
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, P:Val, _A:Int)
+    => arrangeSeq(R, I +Int 1, V, I)
+    requires I >Int 0
+     andBool notBool applyCmp(">=", V, P)
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, P:Val, A:Int)
+    => arrangeSeq(R, I +Int 1, V, A)
+    requires I >Int 0
+     andBool applyCmp(">=", V, P)
+    [simplification]
+endmodule

