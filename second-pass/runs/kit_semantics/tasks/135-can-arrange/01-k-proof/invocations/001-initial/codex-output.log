diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..612a7b1320f00e7d643718b77b26b77bf9ad17ab
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,152 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [can-arrange-loop]:
+    <k>
+      (#loop(
+        list(VS),
+        Name("value"),
+        If(
+          Compare(Name("i"), CmpOp(">", Int(0))),
+          If(
+            UnaryOp(
+              "not",
+              Compare(
+                Name("value"),
+                CmpOp(">=", Name("previous")))),
+            Assign(Name("index"), Name("i")),
+            .Stmts),
+          .Stmts)
+        Assign(Name("previous"), Name("value"))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+        .Stmts)
+      => .K)
+      ~> (Return(Name("index")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "can_arrange" |->
+          closureVal(
+            "arr", .ParamNames,
+            Assign(Name("index"), UnaryOp("-", Int(1)))
+            Assign(Name("i"), Int(0))
+            Assign(Name("previous"), Int(0))
+            Assign(Name("value"), Int(0))
+            For(
+              Name("value"), Name("arr"),
+              If(
+                Compare(Name("i"), CmpOp(">", Int(0))),
+                If(
+                  UnaryOp(
+                    "not",
+                    Compare(
+                      Name("value"),
+                      CmpOp(">=", Name("previous")))),
+                  Assign(Name("index"), Name("i")),
+                  .Stmts),
+                .Stmts)
+              Assign(Name("previous"), Name("value"))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("index"))
+            .Stmts,
+            0),
+        parent(-1))
+      1  |-> scope(
+        "arr"      |-> list(ORIG)
+        "i"        |-> (I => ?FINAL_I:Int)
+        "index"    |-> (A => arrangeSeq(VS, I, P, A))
+        "previous" |-> (P => ?FINAL_PREVIOUS:Val)
+        "value"    |-> (P => ?FINAL_VALUE:Val),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool (I ==Int 0 orBool isInt(P))
+     andBool allInts(VS)
+
+  claim [can-arrange]:
+    <k>
+      (#loadAll(
+        Module(
+          FuncDef(
+            "can_arrange", Params("arr"),
+            Assign(Name("index"), UnaryOp("-", Int(1)))
+            Assign(Name("i"), Int(0))
+            Assign(Name("previous"), Int(0))
+            Assign(Name("value"), Int(0))
+            For(
+              Name("value"), Name("arr"),
+              If(
+                Compare(Name("i"), CmpOp(">", Int(0))),
+                If(
+                  UnaryOp(
+                    "not",
+                    Compare(
+                      Name("value"),
+                      CmpOp(">=", Name("previous")))),
+                  Assign(Name("index"), Name("i")),
+                  .Stmts),
+                .Stmts)
+              Assign(Name("previous"), Name("value"))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("index"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("can_arrange"), list(VS))
+      => arrangeSeq(VS, 0, 0, -1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        => "can_arrange" |->
+             closureVal(
+               "arr", .ParamNames,
+               Assign(Name("index"), UnaryOp("-", Int(1)))
+               Assign(Name("i"), Int(0))
+               Assign(Name("previous"), Int(0))
+               Assign(Name("value"), Int(0))
+               For(
+                 Name("value"), Name("arr"),
+                 If(
+                   Compare(Name("i"), CmpOp(">", Int(0))),
+                   If(
+                     UnaryOp(
+                       "not",
+                       Compare(
+                         Name("value"),
+                         CmpOp(">=", Name("previous")))),
+                     Assign(Name("index"), Name("i")),
+                     .Stmts),
+                   .Stmts)
+                 Assign(Name("previous"), Name("value"))
+                 Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+                 .Stmts)
+               Return(Name("index"))
+               .Stmts,
+               0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5eb19aece5e9fc98ce35b7b801dc4b4ebeed2752
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // One-constructor-at-a-time input-domain predicate.  Its guarded
+  // simplification equations avoid eager unfolding on an abstract sequence.
+  syntax Bool ::= allInts(ValSeq)
+    [function, total, no-evaluators]
+  rule allInts(.ValSeq) => true [simplification]
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+    [simplification]
+
+  // Total twin of the partial Val-to-Int subsort projection.  Every use is
+  // guarded by isInt; the orientation pair connects it to K's built-in cast.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
+    [simplification]
+
+  // Guarded dispatch twin of MPY-INT's existing >= equation.
+  rule applyCmp(">=", V:Val, W:Val)
+    => projectIntTotal(V) >=Int projectIntTotal(W)
+    requires isInt(V) andBool isInt(W)
+    [simplification]
+
+  // Mathematical left-to-right scan of the unvisited suffix.  I is the
+  // current absolute index, P is the preceding value (ignored when I == 0),
+  // and A is the largest matching index already seen.
+  syntax Int ::= arrangeSeq(ValSeq, Int, Val, Int)
+    [function, total, no-evaluators]
+
+  rule arrangeSeq(.ValSeq, _I:Int, _P:Val, A:Int) => A
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, _P:Val, A:Int)
+    => arrangeSeq(R, I +Int 1, V, A)
+    requires I ==Int 0
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, P:Val, _A:Int)
+    => arrangeSeq(R, I +Int 1, V, I)
+    requires I >Int 0
+     andBool notBool applyCmp(">=", V, P)
+    [simplification]
+
+  rule arrangeSeq(vCons(V:Val, R:ValSeq), I:Int, P:Val, A:Int)
+    => arrangeSeq(R, I +Int 1, V, A)
+    requires I >Int 0
+     andBool applyCmp(">=", V, P)
+    [simplification]
+endmodule

