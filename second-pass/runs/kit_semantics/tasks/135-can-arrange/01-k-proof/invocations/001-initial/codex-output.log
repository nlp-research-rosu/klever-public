+                         CmpOp(">=", Name("previous")))),
+                     Assign(Name("index"), Name("i")),
+                     .Stmts),
+                   .Stmts)
+                 Assign(Name("previous"), Name("value"))
+                 Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+                 .Stmts)
+               Return(Name("index"))
+               .Stmts,
+               0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires scanDefined(VS, 0, 0)
