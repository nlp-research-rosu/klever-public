index 0000000000000000000000000000000000000000..d7322423ba04660606c9e7b6cf5dc0661b8e978c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def can_arrange(arr):
+    index = -1
+    i = 1
+    while i < len(arr):
+        if not arr[i] >= arr[i - 1]:
+            index = i
+        i = i + 1
+    return index
