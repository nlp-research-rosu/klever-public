+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool scanDefined(VS, I, P)
+
+  claim [can-arrange]:
+    <k>
+      (#loadAll(
+        Module(
+          FuncDef(
+            "can_arrange", Params("arr"),
+            Assign(Name("index"), UnaryOp("-", Int(1)))
+            Assign(Name("i"), Int(0))
+            Assign(Name("previous"), Int(0))
+            Assign(Name("value"), Int(0))
+            For(
+              Name("value"), Name("arr"),
+              If(
+                Compare(Name("i"), CmpOp(">", Int(0))),
+                If(
+                  UnaryOp(
+                    "not",
+                    Compare(
+                      Name("value"),
+                      CmpOp(">=", Name("previous")))),
+                  Assign(Name("index"), Name("i")),
+                  .Stmts),
+                .Stmts)
+              Assign(Name("previous"), Name("value"))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("index"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("can_arrange"), list(VS))
+      => arrangeSeq(VS, 0, 0, -1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        => "can_arrange" |->
+             closureVal(
