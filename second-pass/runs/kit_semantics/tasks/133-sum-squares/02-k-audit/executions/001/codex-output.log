+  ! -name '99-final-check.log' \
+  -print0 \
+  | sort -z \
+  | xargs -0 sha256sum \
+  > /audit-output/evidence/99-evidence-sha256.txt
+
+tail -n 2 /audit-output/REVIEW.md
+printf 'FINAL_AUDIT_CHECKS_OK\n'

