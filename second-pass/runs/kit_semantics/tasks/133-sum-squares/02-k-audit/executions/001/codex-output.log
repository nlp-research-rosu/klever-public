+def sum_squares(lst):
+    total = 0
+    number = 0
+    rounded = 0
+    for number in lst:
+        rounded = math.ceil(number)
+        total += rounded * rounded
+    return total
+
+
+assert sum_squares([]) == 0
+assert sum_squares([1, 2, 3]) == 14
+assert sum_squares([1.4, 4.2, 0]) == 29
+assert sum_squares([-2.4, 1, 1]) == 6
+assert sum_squares([2.0000000000000004, -2.4]) == 13
