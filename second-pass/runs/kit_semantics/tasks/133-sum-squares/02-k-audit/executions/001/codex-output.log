+
+trace_line_count = 0
+trace_top_types: Counter[str | None] = Counter()
+trace_payload_types: Counter[tuple[str | None, str | None]] = Counter()
+trace_calls: list[tuple[int, str, str]] = []
+for path in trace_non_dirs:
+    with path.open(encoding="utf-8") as stream:
