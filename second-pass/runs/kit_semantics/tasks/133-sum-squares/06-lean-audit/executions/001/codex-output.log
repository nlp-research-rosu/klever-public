+    generator_manifest = read_json(GENERATION / "generator-manifest.json")
+    export_result = read_json(GENERATION / "export-result.json")
+    recorded_preflight = read_json(GENERATION / "preflight.json")
+
+    print("== launcher and resolution ==")
