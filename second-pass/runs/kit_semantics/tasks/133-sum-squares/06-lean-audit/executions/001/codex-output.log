+    discovery_hash = file_hash(DISCOVERY)
+    generated_hash = exporter_tree_hash(GENERATED)
+    trust_hash = file_hash(GENERATION / "trust-inventory.json")
+    verification_hash = file_hash(K_PROOF / "verification.k")
