+    rendered = repr(actual)
+    if len(rendered) > 500:
+        encoded = json.dumps(
+            actual, sort_keys=True, separators=(",", ":")
+        ).encode()
+        rendered = (
+            f"<{type(actual).__name__} size={len(actual)} "
+            f"canonical_sha256={hashlib.sha256(encoded).hexdigest()}>"
+        )
+    print(f"PASS {label}: {rendered}")
