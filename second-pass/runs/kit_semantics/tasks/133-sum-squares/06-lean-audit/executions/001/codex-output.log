+        digest.update(encoded)
+        digest.update(kind.encode() + b"\0")
+        if kind == "file":
+            payload = path.read_bytes()
+            digest.update(len(payload).to_bytes(8, "big"))
+            digest.update(payload)
+    return digest.hexdigest()
