@@ -0,0 +1,68 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // The implementation is materially mutated to start at 1.  The correct
+  // empty-list result claim (0) must therefore fail.
+  claim [changed-initializer]:
+    <k>
+      #loadAll(
+        Module(
+          Import("math")
+          FuncDef(
+            "sum_squares",
+            Params("lst"),
+            Assign(Name("total"), Int(1))
+            Assign(Name("number"), Int(0))
+            Assign(Name("rounded"), Int(0))
+            For(
+              Name("number"),
+              Name("lst"),
+              Assign(
+                Name("rounded"),
+                Call(Attribute(Name("math"), "ceil"), Name("number")))
+              AugAssign(
+                Name("total"),
+                "+",
+                BinOp("*", Name("rounded"), Name("rounded"))))
+            Return(Name("total")))))
+      ~> Call(Name("sum_squares"), list(.ValSeq))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "sum_squares" |->
+           closureVal(
+             ("lst", .ParamNames),
+             Assign(Name("total"), Int(1))
+             Assign(Name("number"), Int(0))
+             Assign(Name("rounded"), Int(0))
+             For(
+               Name("number"),
+               Name("lst"),
+               Assign(
+                 Name("rounded"),
+                 Call(Attribute(Name("math"), "ceil"), Name("number")))
+               AugAssign(
+                 Name("total"),
+                 "+",
+                 BinOp("*", Name("rounded"), Name("rounded"))))
+             Return(Name("total"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
