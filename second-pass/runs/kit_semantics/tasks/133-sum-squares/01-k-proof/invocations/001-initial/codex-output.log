+      #loadAll(solutionProgram)
+      ~> Call(Name("sum_squares"), list(VS:ValSeq))
+      => sumCeilSquares(VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(?GLOBALS:Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
