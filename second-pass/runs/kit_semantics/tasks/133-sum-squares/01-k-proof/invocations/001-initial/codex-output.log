diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..bff26cb1d9bbaba1c8973d725fd01a6c2d24d67c
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // The implementation is materially mutated to add the ceiling instead of
+  // its square.  On [2] it returns 2, so the correct result claim (4) fails.
+  claim [changed-loop-update]:
+    <k>
+      #loadAll(
+        Module(
+          Import("math")
+          FuncDef(
+            "sum_squares",
+            Params("lst"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("number"), Int(0))
+            Assign(Name("rounded"), Int(0))
+            For(
+              Name("number"),
+              Name("lst"),
+              Assign(
+                Name("rounded"),
+                Call(Attribute(Name("math"), "ceil"), Name("number")))
+              AugAssign(
+                Name("total"),
+                "+",
+                Name("rounded")))
+            Return(Name("total")))))
+      ~> Call(
+           Name("sum_squares"),
+           list(vCons(2, .ValSeq)))
+      => 4
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "sum_squares" |->
+           closureVal(
+             ("lst", .ParamNames),
+             Assign(Name("total"), Int(0))
+             Assign(Name("number"), Int(0))
+             Assign(Name("rounded"), Int(0))
+             For(
+               Name("number"),
+               Name("lst"),
+               Assign(
+                 Name("rounded"),
+                 Call(Attribute(Name("math"), "ceil"), Name("number")))
+               AugAssign(
+                 Name("total"),
+                 "+",
+                 Name("rounded")))
+             Return(Name("total"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..5fe9e7db4ad791cfd07ead4a4f1a0ffd68760593
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,68 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false for the realizable empty-list input: the real result is
+  // 0, while this claim demands 1.
+  claim [false-result]:
+    <k>
+      #loadAll(
+        Module(
+          Import("math")
+          FuncDef(
+            "sum_squares",
+            Params("lst"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("number"), Int(0))
+            Assign(Name("rounded"), Int(0))
+            For(
+              Name("number"),
+              Name("lst"),
+              Assign(
+                Name("rounded"),
+                Call(Attribute(Name("math"), "ceil"), Name("number")))
+              AugAssign(
+                Name("total"),
+                "+",
+                BinOp("*", Name("rounded"), Name("rounded"))))
+            Return(Name("total")))))
+      ~> Call(Name("sum_squares"), list(.ValSeq))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "sum_squares" |->
+           closureVal(
+             ("lst", .ParamNames),
+             Assign(Name("total"), Int(0))
+             Assign(Name("number"), Int(0))
+             Assign(Name("rounded"), Int(0))
+             For(
+               Name("number"),
+               Name("lst"),
+               Assign(
+                 Name("rounded"),
+                 Call(Attribute(Name("math"), "ceil"), Name("number")))
+               AugAssign(
+                 Name("total"),
+                 "+",
+                 BinOp("*", Name("rounded"), Name("rounded"))))
+             Return(Name("total"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cebdd8b262fa25693dc6b9119648bc84a9c6fc29
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,59 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        Assign(
+          Name("rounded"),
+          Call(Attribute(Name("math"), "ceil"), Name("number")))
+        AugAssign(
+          Name("total"),
+          "+",
+          BinOp("*", Name("rounded"), Name("rounded"))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("lst" |-> INPUT:Val
+         "number" |-> OLDNUMBER:Val
+         "rounded" |-> OLDROUNDED:Int
+         "total" |-> ACC:Int)
+        =>
+        ("lst" |-> INPUT
+         "number" |-> ?NUMBER:Val
+         "rounded" |-> ?ROUNDED:Int
+         "total" |-> (ACC +Int sumCeilSquares(VS))),
+        parent(0))
+      ...
+    </scopes>
+
+  claim [sum-squares]:
+    <k>
+      #loadAll(solutionProgram)
+      ~> Call(Name("sum_squares"), list(VS:ValSeq))
+      => sumCeilSquares(VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(?GLOBALS:Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
