+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false for the realizable empty-list input: the real result is
+  // 0, while this claim demands 1.
+  claim [false-result]:
+    <k>
+      #loadAll(
+        Module(
+          Import("math")
+          FuncDef(
+            "sum_squares",
+            Params("lst"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("number"), Int(0))
+            Assign(Name("rounded"), Int(0))
+            For(
+              Name("number"),
+              Name("lst"),
+              Assign(
+                Name("rounded"),
+                Call(Attribute(Name("math"), "ceil"), Name("number")))
+              AugAssign(
+                Name("total"),
+                "+",
+                BinOp("*", Name("rounded"), Name("rounded"))))
+            Return(Name("total")))))
+      ~> Call(Name("sum_squares"), list(.ValSeq))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "sum_squares" |->
+           closureVal(
+             ("lst", .ParamNames),
+             Assign(Name("total"), Int(0))
+             Assign(Name("number"), Int(0))
+             Assign(Name("rounded"), Int(0))
+             For(
+               Name("number"),
+               Name("lst"),
+               Assign(
+                 Name("rounded"),
+                 Call(Attribute(Name("math"), "ceil"), Name("number")))
+               AugAssign(
+                 Name("total"),
+                 "+",
+                 BinOp("*", Name("rounded"), Name("rounded"))))
+             Return(Name("total"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cebdd8b262fa25693dc6b9119648bc84a9c6fc29
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,59 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        Assign(
+          Name("rounded"),
+          Call(Attribute(Name("math"), "ceil"), Name("number")))
+        AugAssign(
+          Name("total"),
+          "+",
+          BinOp("*", Name("rounded"), Name("rounded"))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("lst" |-> INPUT:Val
+         "number" |-> OLDNUMBER:Val
+         "rounded" |-> OLDROUNDED:Int
+         "total" |-> ACC:Int)
+        =>
+        ("lst" |-> INPUT
+         "number" |-> ?NUMBER:Val
+         "rounded" |-> ?ROUNDED:Int
+         "total" |-> (ACC +Int sumCeilSquares(VS))),
+        parent(0))
+      ...
+    </scopes>
+
+  claim [sum-squares]:
+    <k>
+      #loadAll(solutionProgram)
+      ~> Call(Name("sum_squares"), list(VS:ValSeq))
+      => sumCeilSquares(VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(?GLOBALS:Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d8d680c33b1a7605965d9fd9eb0cfff7c5dbf8e5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,15 @@
+requires "reference-semantics/semantics.k"
+requires "program.k"
+
+module VERIFICATION
+  imports MPY
+  imports SOLUTION-PROGRAM
+  imports INT
+
+  // Mathematical fold used only in postconditions.  It does not rewrite any
+  // program computation; the Python loop continues to execute under MPY.
+  syntax Int ::= sumCeilSquares(ValSeq) [function, total]
+  rule sumCeilSquares(.ValSeq) => 0
+  rule sumCeilSquares(vCons(V:Val, VS:ValSeq))
+    => (ceilF(V) *Int ceilF(V)) +Int sumCeilSquares(VS)
+endmodule

diff --git a/check_program_identity.py b/check_program_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..acdaf2913ec33277a19d07b1bdbd02823dd218e2
--- /dev/null
+++ b/check_program_identity.py
@@ -0,0 +1,28 @@
+from pathlib import Path
+import re
+
+
+program_k = Path("program.k").read_text(encoding="utf-8")
+solution_mpy = Path("solution.mpy").read_text(encoding="utf-8").strip()
+
+match = re.search(
+    r"rule solutionProgram =>\n(?P<term>.*?)\nendmodule\n?\Z",
+    program_k,
+    flags=re.DOTALL,
+)
+if match is None:
+    raise AssertionError("program.k does not contain the solutionProgram rule")
+
+embedded = "\n".join(
+    line[4:] if line.startswith("    ") else line
+    for line in match.group("term").splitlines()
+).strip()
+
+if embedded != solution_mpy:
+    raise AssertionError(
+        "solutionProgram differs from solution.mpy\n"
+        f"--- embedded ---\n{embedded}\n"
+        f"--- generated ---\n{solution_mpy}\n"
+    )
+
+print("program identity: solutionProgram == solution.mpy")
