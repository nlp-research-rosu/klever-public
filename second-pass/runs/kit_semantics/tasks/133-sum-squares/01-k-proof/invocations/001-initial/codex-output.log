+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        Assign(
+          Name("rounded"),
+          Call(Attribute(Name("math"), "ceil"), Name("number")))
+        AugAssign(
+          Name("total"),
+          "+",
+          BinOp("*", Name("rounded"), Name("rounded"))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("lst" |-> INPUT:Val
+         "number" |-> OLDNUMBER:Val
+         "rounded" |-> OLDROUNDED:Int
+         "total" |-> ACC:Int)
+        =>
+        ("lst" |-> INPUT
+         "number" |-> ?NUMBER:Val
+         "rounded" |-> ?ROUNDED:Int
+         "total" |-> (ACC +Int sumCeilSquares(VS))),
+        parent(0))
+      ...
+    </scopes>
