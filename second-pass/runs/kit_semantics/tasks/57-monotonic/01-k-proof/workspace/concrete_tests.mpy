Module(
  FuncDef("monotonic", Params("l"),
    Return(
      BoolOp(
        "or",
        Compare(Name("l"), CmpOp("==", Call(Name("sorted"), Name("l")))),
        Compare(
          Name("l"),
          CmpOp(
            "==",
            Call(
              Name("sorted"),
              Name("l"),
              KwArg("reverse", Bool(true))))))))
  Assert(
    Compare(
      Call(Name("monotonic"), ListExpr()),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("monotonic"), ListExpr(Int(7))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("monotonic"), ListExpr(Int(1), Int(2), Int(4), Int(20))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("monotonic"),
        ListExpr(Int(1), Int(20), Int(4), Int(10))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("monotonic"),
        ListExpr(Int(4), Int(1), Int(0), UnaryOp("-", Int(10)))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("monotonic"), ListExpr(Int(1), Int(1), Int(2), Int(2))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("monotonic"), ListExpr(Int(2), Int(2), Int(1), Int(1))),
      CmpOp("==", Bool(true)))))
