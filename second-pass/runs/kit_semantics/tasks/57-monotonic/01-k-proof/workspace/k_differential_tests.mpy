Module(
  FuncDef("monotonic", Params("l"),
    Return(
      BoolOp(
        "or",
        Compare(Name("l"), CmpOp("==", Call(Name("sorted"), Name("l")))),
        Compare(
          Name("l"),
          CmpOp(
            "==",
            Call(
              Name("sorted"),
              Name("l"),
              KwArg("reverse", Bool(true))))))))
  Assert(
    Compare(
      Call(Name("monotonic"), ListExpr()),
      CmpOp("==", Bool(true))))
