+
+def report(label: str, actual: object, expected: object) -> bool:
+    matched = actual == expected
+    print(
+        json.dumps(
+            {
+                "check": label,
+                "actual": actual,
+                "expected": expected,
+                "match": matched,
+            },
+            ensure_ascii=False,
+            sort_keys=True,
+        )
+    )
+    return matched
+
+
