+        input_manifest["verification_sha256"],
+    )
+
+    print(f"STATIC_CHECKS_OVERALL={'PASS' if overall else 'FAIL'}")
+    return 0 if overall else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

