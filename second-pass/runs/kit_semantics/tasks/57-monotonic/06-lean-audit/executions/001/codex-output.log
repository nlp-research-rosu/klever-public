+                "expected": expected,
+                "match": matched,
+            },
+            ensure_ascii=False,
+            sort_keys=True,
+        )
+    )
+    return matched
+
+
+def main() -> int:
+    overall = True
+    envelope = json.loads(AUDIT_INPUT.read_text())
+    resolution, resolved_digest = stage6_resolution_contract.verify_audit_input(
+        envelope
