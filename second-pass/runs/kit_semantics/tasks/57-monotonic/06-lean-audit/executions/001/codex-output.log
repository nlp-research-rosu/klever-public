+
+cd /tmp/audit-work/57-monotonic-proof.bNlsvL
+PATH=/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin:$PATH \
+LD_PRELOAD=/tmp/audit-work/proc-exe-readlink-shim.so \
