index 0000000000000000000000000000000000000000..1304e5e37247520c95f4ae41a1a08bdbcb5f9501
--- /dev/null
+++ b//tmp/audit-work/57-monotonic-proof.bNlsvL/CounterfactualAccepted.lean
@@ -0,0 +1,34 @@
+import Klean57Monotonic.Lemmas
+
+namespace CounterfactualAccepted
+
+def honestOr : SortBool → SortBool → SortBool := fun a b => a || b
+def honestEq : SortBool → SortBool → SortBool := fun a b => a == b
+def honestNot : SortBool → SortBool := fun a => !a
+
+def constantEq : SortBool → SortBool → SortBool := fun _ _ => true
+def constantFalseNot : SortBool → SortBool := fun _ => false
+
+-- These deliberately dishonest bridges show why theorem closure alone is not
+-- enough; the actual candidate definitions must be checked operationally.
+example :
+    Klean57Monotonic.Lemmas.targetStatement
+      honestOr constantEq honestNot := by
+  simp [
+    Klean57Monotonic.Lemmas.targetStatement,
+    honestOr,
+    constantEq,
+    honestNot
+  ]
+
+example :
+    Klean57Monotonic.Lemmas.targetStatement
+      honestOr honestEq constantFalseNot := by
+  simp [
+    Klean57Monotonic.Lemmas.targetStatement,
+    honestOr,
+    honestEq,
+    constantFalseNot
+  ]
+
+end CounterfactualAccepted
diff --git a//tmp/audit-work/57-monotonic-proof.bNlsvL/CounterfactualRejected.lean b//tmp/audit-work/57-monotonic-proof.bNlsvL/CounterfactualRejected.lean
new file mode 100644
index 0000000000000000000000000000000000000000..23e15643be000dad1bb9f3a76564e73810951280
--- /dev/null
+++ b//tmp/audit-work/57-monotonic-proof.bNlsvL/CounterfactualRejected.lean
@@ -0,0 +1,20 @@
+import Klean57Monotonic.Lemmas
+
+namespace CounterfactualRejected
+
+def leftProjectionOr : SortBool → SortBool → SortBool := fun a _ => a
+def honestEq : SortBool → SortBool → SortBool := fun a b => a == b
+def honestNot : SortBool → SortBool := fun a => !a
+
+-- This must fail at (A = false, B = true): left projection is not Boolean OR.
+example :
+    Klean57Monotonic.Lemmas.targetStatement
+      leftProjectionOr honestEq honestNot := by
+  simp [
+    Klean57Monotonic.Lemmas.targetStatement,
+    leftProjectionOr,
+    honestEq,
+    honestNot
+  ]
+
+end CounterfactualRejected
