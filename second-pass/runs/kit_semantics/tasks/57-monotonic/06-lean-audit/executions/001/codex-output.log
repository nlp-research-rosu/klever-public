+  Proof._orBool_ false false,
+  Proof._orBool_ false true,
+  Proof._orBool_ true false,
+  Proof._orBool_ true true
+]
+
+#eval [
+  Proof.«_==Bool_» false false,
+  Proof.«_==Bool_» false true,
+  Proof.«_==Bool_» true false,
+  Proof.«_==Bool_» true true
+]
+
+#eval [Proof.notBool_ false, Proof.notBool_ true]
+
+example :
+    [
+      Proof._orBool_ false false,
+      Proof._orBool_ false true,
+      Proof._orBool_ true false,
+      Proof._orBool_ true true
+    ] = [false, true, true, true] := by
+  decide
+
+example :
+    [
+      Proof.«_==Bool_» false false,
+      Proof.«_==Bool_» false true,
+      Proof.«_==Bool_» true false,
+      Proof.«_==Bool_» true true
+    ] = [true, false, false, true] := by
+  decide
+
+example :
+    [Proof.notBool_ false, Proof.notBool_ true] = [true, false] := by
+  decide
diff --git a//tmp/audit-work/57-monotonic-proof.bNlsvL/CounterfactualAccepted.lean b//tmp/audit-work/57-monotonic-proof.bNlsvL/CounterfactualAccepted.lean
