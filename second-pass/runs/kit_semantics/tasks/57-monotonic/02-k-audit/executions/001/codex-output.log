variants['path0bytes']=dig([q for p in files for q in [(p.relative_to(root).as_posix()).encode()+b'\\0',p.read_bytes()]])
variants['pathnlbytes']=dig([q for p in files for q in [(p.relative_to(root).as_posix()).encode()+b'\\n',p.read_bytes()]])
variants['path0hashbytes']=dig([q for p in files for q in [(p.relative_to(root).as_posix()).encode()+b'\\0',hashlib.sha256(p.read_bytes()).digest()]])
variants['path0hashhex']=dig([q for p in files for q in [(p.relative_to(root).as_posix()).encode()+b'\\0',hashlib.sha256(p.read_bytes()).hexdigest().encode()]])
variants['sha256sumlines']=dig([f'{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.relative_to(root).as_posix()}\\n'.encode() for p in files])
for k,v in variants.items():print(k,v,'MATCH' if v==target else '')
