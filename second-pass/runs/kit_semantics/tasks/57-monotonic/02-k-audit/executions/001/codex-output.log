+        Module(
+          FuncDef(
+            "monotonic",
+            Params("l"),
+            Return(
+              BoolOp(
+                "or",
+                Compare(
+                  Name("l"),
+                  CmpOp("==", Call(Name("sorted"), Name("l")))),
+                Compare(
