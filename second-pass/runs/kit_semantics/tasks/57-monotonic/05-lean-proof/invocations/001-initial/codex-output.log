diff --git a/readlink_trace.c b/readlink_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..199030b1e22592aef6a3051e4b73ae0ebcd8d356
--- /dev/null
+++ b/readlink_trace.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink)
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = real_readlink(path, buf, size);
+  int saved_errno = errno;
+  fprintf(stderr, "TRACE readlink(%s, %zu) = %zd errno=%d", path, size,
+          result, saved_errno);
+  if (result >= 0)
+    fprintf(stderr, " value=%.*s", (int)result, buf);
+  fputc('\n', stderr);
+  errno = saved_errno;
+  return result;
+}

