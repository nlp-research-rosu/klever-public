Module(
  ImportFrom("typing", "List")
  FuncDef("separate_paren_groups", Params("paren_string"),
    Assign(Name("groups"), ListExpr())
    Assign(Name("current"), Str(""))
    Assign(Name("depth"), Int(0))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("paren_string"),
      If(Compare(Name("char"), CmpOp("!=", Str(" "))),
        AugAssign(Name("current"), "+", Name("char"))
        If(Compare(Name("char"), CmpOp("==", Str("("))),
          AugAssign(Name("depth"), "+", Int(1)),
          AugAssign(Name("depth"), "-", Int(1)))
        If(Compare(Name("depth"), CmpOp("==", Int(0))),
          Expr(
            Call(Attribute(Name("groups"), "append"), Name("current")))
          Assign(Name("current"), Str("")),
          ),
        ))
    Return(Name("groups"))))
