COMMAND
python3 -c 'import hashlib,json; from pathlib import Path; a=json.load(open("/audit-input.json"))["resolution"]["stage1_source_hashes"]; root=Path("/reference/k-proof"); files={p.relative_to(root).as_posix():p for p in root.rglob("*") if p.is_file() and not p.is_symlink()}; observed={k:hashlib.sha256(p.read_bytes()).hexdigest() for k,p in files.items()}; print(json.dumps({"recorded_count":len(a),"observed_regular_file_count":len(observed),"missing_recorded_files":sorted(set(a)-set(observed)),"unrecorded_files":sorted(set(observed)-set(a)),"hash_mismatches":[{"path":k,"expected":a[k],"observed":observed.get(k)} for k in sorted(set(a)&set(observed)) if a[k]!=observed[k]],"all_match":a==observed},indent=2,sort_keys=True))'

