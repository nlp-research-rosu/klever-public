{
    "definitions": [
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 12,
            "module": "VERIFICATION",
            "normalized_sha256": "fb20023f3ba749b6a41948fafafdc7905c1e57b1259087a8c997c632a8bd73f2",
            "rationale": "Base equation for the mathematical scanner: with no remaining input, scanParenGroups is defined to return the accumulated output.",
            "source_rule_id": "rule-fb20023f3ba749b6a41948fafafdc7905c1e57b1259087a8c997c632a8bd73f2",
            "start_line": 11,
            "text": "  rule scanParenGroups(.IntSeq, _:Int, _:IntSeq, OUT:ValSeq)\n    => OUT"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 59,
            "module": "VERIFICATION",
            "normalized_sha256": "f583a745ad66ed7a6e6edb157fb92dfc7e453138bc5a043f0dbf0e242b8b1744",
            "rationale": "Structurally recursive defining equation for scanParenGroups on a nonempty IntSeq; its conditionals define the accumulator, depth, and group updates while recursion consumes REST.",
            "source_rule_id": "rule-f583a745ad66ed7a6e6edb157fb92dfc7e453138bc5a043f0dbf0e242b8b1744",
            "start_line": 14,
            "text": "  rule scanParenGroups(iCons(C:Int, REST:IntSeq), D:Int,\n                       CUR:IntSeq, OUT:ValSeq)\n    => #if C ==Int 32\n       #then scanParenGroups(REST, D, CUR, OUT)\n       #else\n         #if C ==Int 40\n         #then\n           #if (D +Int 1) ==Int 0\n           #then\n             scanParenGroups(\n               REST,\n               0,\n               .IntSeq,\n               valSeqConcat(\n                 OUT,\n                 vCons(\n                   str(seqConcat(CUR, iCons(C, .IntSeq))),\n                   .ValSeq)))\n           #else\n             scanParenGroups(\n               REST,\n               D +Int 1,\n               seqConcat(CUR, iCons(C, .IntSeq)),\n               OUT)\n           #fi\n         #else\n           #if (D -Int 1) ==Int 0\n           #then\n             scanParenGroups(\n               REST,\n               0,\n               .IntSeq,\n               valSeqConcat(\n                 OUT,\n                 vCons(\n                   str(seqConcat(CUR, iCons(C, .IntSeq))),\n                   .ValSeq)))\n           #else\n             scanParenGroups(\n               REST,\n               D -Int 1,\n               seqConcat(CUR, iCons(C, .IntSeq)),\n               OUT)\n           #fi\n         #fi\n       #fi"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 63,
            "module": "VERIFICATION",
            "normalized_sha256": "266caab93c8c959eb43fe3fde11de8216d1c60cd5431406325b896207f56d732",
            "rationale": "Wrapper equation defining separateParenGroupsSpec by initializing scanParenGroups with depth zero and empty current-group and output accumulators.",
            "source_rule_id": "rule-266caab93c8c959eb43fe3fde11de8216d1c60cd5431406325b896207f56d732",
            "start_line": 62,
            "text": "  rule separateParenGroupsSpec(S:IntSeq)\n    => scanParenGroups(S, 0, .IntSeq, .ValSeq)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 70,
            "module": "VERIFICATION",
            "normalized_sha256": "5fa22cb1d66dafd2b9bada586c05b79c0cfe0cec65e7a2a55e378bb073ccb99d",
            "rationale": "Wrapper equation defining the valid-input predicate as validParenSuffix started at nesting depth zero.",
            "source_rule_id": "rule-5fa22cb1d66dafd2b9bada586c05b79c0cfe0cec65e7a2a55e378bb073ccb99d",
            "start_line": 69,
            "text": "  rule validParenInput(S:IntSeq)\n    => validParenSuffix(S, 0)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 73,
            "module": "VERIFICATION",
            "normalized_sha256": "9297847690746ec6b7a953f8ec6199c0cc1ca947667b52a9a763ada9a8a90526",
            "rationale": "Base equation for validParenSuffix, defining an exhausted input as valid exactly when the tracked nesting depth is zero.",
            "source_rule_id": "rule-9297847690746ec6b7a953f8ec6199c0cc1ca947667b52a9a763ada9a8a90526",
            "start_line": 72,
            "text": "  rule validParenSuffix(.IntSeq, D:Int)\n    => D ==Int 0"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 76,
            "module": "VERIFICATION",
            "normalized_sha256": "faaebe512f2fb221e1c01b55fc337a2320d72bde4bf95cc458f645a1f22a570e",
            "rationale": "Recursive predicate equation defining ASCII space as ignored while checking the remaining suffix at the unchanged depth.",
            "source_rule_id": "rule-faaebe512f2fb221e1c01b55fc337a2320d72bde4bf95cc458f645a1f22a570e",
            "start_line": 75,
            "text": "  rule validParenSuffix(iCons(32, REST:IntSeq), D:Int)\n    => validParenSuffix(REST, D)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 79,
            "module": "VERIFICATION",
            "normalized_sha256": "ef55521d20d979a944b03b4a5c2b520ede0470c003e497a95cb3a64e4368cebd",
            "rationale": "Recursive predicate equation defining an opening parenthesis to increase nesting depth before checking the remaining suffix.",
            "source_rule_id": "rule-ef55521d20d979a944b03b4a5c2b520ede0470c003e497a95cb3a64e4368cebd",
            "start_line": 78,
            "text": "  rule validParenSuffix(iCons(40, REST:IntSeq), D:Int)\n    => validParenSuffix(REST, D +Int 1)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 83,
            "module": "VERIFICATION",
            "normalized_sha256": "0d136db51cb932ee0db51ebee82648fe6326c816b2b001c977a27e11a6dd3536",
            "rationale": "Guarded recursive predicate equation defining a closing parenthesis at positive depth to decrease depth and continue checking the suffix.",
            "source_rule_id": "rule-0d136db51cb932ee0db51ebee82648fe6326c816b2b001c977a27e11a6dd3536",
            "start_line": 81,
            "text": "  rule validParenSuffix(iCons(41, REST:IntSeq), D:Int)\n    => validParenSuffix(REST, D -Int 1)\n    requires D >Int 0"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 87,
            "module": "VERIFICATION",
            "normalized_sha256": "19f01337879b20309edbcbec89745dccd80d15204bdafa01537236676ea0902b",
            "rationale": "Guarded defining equation making a closing parenthesis at nonpositive depth invalid, completing the close-parenthesis cases.",
            "source_rule_id": "rule-19f01337879b20309edbcbec89745dccd80d15204bdafa01537236676ea0902b",
            "start_line": 85,
            "text": "  rule validParenSuffix(iCons(41, _:IntSeq), D:Int)\n    => false\n    requires D <=Int 0"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 91,
            "module": "VERIFICATION",
            "normalized_sha256": "f18ac752ae9a55086836d401b1f975ed7ba1dc1a1dfe6020469ec40361b27db8",
            "rationale": "Guarded catch-all defining equation making every code other than ASCII space, opening parenthesis, or closing parenthesis invalid.",
            "source_rule_id": "rule-f18ac752ae9a55086836d401b1f975ed7ba1dc1a1dfe6020469ec40361b27db8",
            "start_line": 89,
            "text": "  rule validParenSuffix(iCons(C:Int, _:IntSeq), _:Int)\n    => false\n    requires C =/=Int 32 andBool C =/=Int 40 andBool C =/=Int 41"
        }
    ],
