new file mode 100644
index 0000000000000000000000000000000000000000..b9757d8ae2396b70f16923415f70c6e0a04b2323
--- /dev/null
+++ b/evidence/semantic_oracle.py
@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+
+from itertools import product
+
+
+SPACE = 32
+OPEN = 40
+CLOSE = 41
+
+
+def source_program(codes):
+    groups = []
+    current = []
+    depth = 0
+    for char in codes:
+        if char != SPACE:
+            current.append(char)
+            if char == OPEN:
+                depth += 1
+            else:
+                depth -= 1
+            if depth == 0:
+                groups.append(tuple(current))
+                current = []
+    return tuple(groups)
+
+
+def k_summary(codes, depth=0, current=(), output=()):
+    if not codes:
+        return output
+    char, *rest = codes
+    rest = tuple(rest)
+    if char == SPACE:
+        return k_summary(rest, depth, current, output)
+    if char == OPEN:
+        next_depth = depth + 1
+    else:
+        next_depth = depth - 1
+    next_current = current + (char,)
+    if next_depth == 0:
+        return k_summary(rest, 0, (), output + (next_current,))
+    return k_summary(rest, next_depth, next_current, output)
+
+
+def independent_validity(codes):
+    depth = 0
+    for char in codes:
+        if char == SPACE:
+            continue
+        if char == OPEN:
+            depth += 1
+        elif char == CLOSE and depth > 0:
+            depth -= 1
+        else:
+            return False
+    return depth == 0
+
+
+def k_valid_suffix(codes, depth=0):
+    if not codes:
+        return depth == 0
+    char, *rest = codes
