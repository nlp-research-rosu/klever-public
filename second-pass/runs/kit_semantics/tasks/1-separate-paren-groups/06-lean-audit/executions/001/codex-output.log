+rg -n 'targetStatement|Proof\.final' /reference/klean-generation/generated || true
+python3 -c 'import json; a=json.load(open("/audit-input.json"))["resolution"]; g=json.load(open("/reference/klean-generation/generator-manifest.json")); o=json.load(open("/reference/klean-generation/generated/obligation-map.json")); print({"mode":a["mode"],"audit_target":a.get("target"),"generator_target":g.get("target"),"source_rules":len(o["source_rules"]),"obligations":len(o["obligations"]),"trust_parameters":len(o["trust_parameters"])})'
