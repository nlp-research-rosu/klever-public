new file mode 100644
index 0000000000000000000000000000000000000000..3add4a0030a14d27a58a62e77d3bc71798fe4adf
--- /dev/null
+++ b/evidence/preflight-initial-failure.txt
@@ -0,0 +1,20 @@
+COMMAND
+PYTHONPATH=/reference python3 -c 'import json; from pathlib import Path; from tools.klean_preflight import check_generation; result=check_generation(Path("/reference/k-proof"),Path("/reference/lemma-discovery.json"),Path("/reference/klean-generation"),toolchain_lock=Path("/reference/klean-toolchain.lock.json")); print(json.dumps(result,indent=2,sort_keys=True))'
+
+EXIT CODE
+1
+
+OUTPUT
+Traceback (most recent call last):
+  File "<string>", line 1, in <module>
+  File "/reference/tools/klean_preflight.py", line 582, in check_generation
+    raise KleanPreflightError(
+tools.klean_preflight.KleanPreflightError: lake clean failed (1): error: could not detect the configuration of the Lake installation
+
+DIAGNOSIS
+Lean 4.22 calls readlink("/proc/<getpid()>/exe"). The audit sandbox denies
+that link, although /proc/self/exe is readable. This was confirmed by the
+launcher error, disassembly of lean_io_app_path, and a direct readlink probe.
+The rerun used the narrowly scoped LD_PRELOAD shim whose source is
+/tmp/audit-work/lean_app_path_shim.c. It substitutes Linux AT_EXECFN only for
+that exact denied readlink request and delegates all other readlink calls.
