     4	
     5	from typing import List
     6	
     7	
     8	def separate_paren_groups(paren_string: str) -> List[str]:
     9	    """ Input to this function is a string containing multiple groups of nested parentheses. Your goal is to
    10	    separate those group into separate strings and return the list of those.
    11	    Separate groups are balanced (each open brace is properly closed) and not nested within each other
    12	    Ignore any spaces in the input string.
    13	    >>> separate_paren_groups('( ) (( )) (( )( ))')
    14	    ['()', '(())', '(()())']
    15	    """
    16	    result = []
    17	    current_string = []
    18	    current_depth = 0
    19	
    20	    for c in paren_string:
    21	        if c == '(':
    22	            current_depth += 1
    23	            current_string.append(c)
    24	        elif c == ')':
    25	            current_depth -= 1
    26	            current_string.append(c)
    27	
    28	            if current_depth == 0:
    29	                result.append(''.join(current_string))
    30	                current_string.clear()
    31	
    32	    return result
===== /candidate/solution.py
     1	from typing import List
     2	
     3	
     4	def separate_paren_groups(paren_string: str) -> List[str]:
     5	    groups = []
     6	    current = ""
     7	    depth = 0
     8	    char = ""
     9	    for char in paren_string:
    10	        if char != " ":
    11	            current += char
    12	            if char == "(":
    13	                depth += 1
    14	            else:
    15	                depth -= 1
    16	            if depth == 0:
    17	                groups.append(current)
    18	                current = ""
    19	    return groups
