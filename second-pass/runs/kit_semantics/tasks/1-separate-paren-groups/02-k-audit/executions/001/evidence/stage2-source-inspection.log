     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical output of the source scanner.  The arguments are:
     7	  // remaining input, current depth, current group, groups emitted so far.
     8	  syntax ValSeq ::= scanParenGroups(IntSeq, Int, IntSeq, ValSeq)
     9	                    [function, total]
    10	
    11	  rule scanParenGroups(.IntSeq, _:Int, _:IntSeq, OUT:ValSeq)
    12	    => OUT
    13	
    14	  rule scanParenGroups(iCons(C:Int, REST:IntSeq), D:Int,
    15	                       CUR:IntSeq, OUT:ValSeq)
    16	    => #if C ==Int 32
    17	       #then scanParenGroups(REST, D, CUR, OUT)
    18	       #else
    19	         #if C ==Int 40
    20	         #then
    21	           #if (D +Int 1) ==Int 0
    22	           #then
    23	             scanParenGroups(
    24	               REST,
    25	               0,
    26	               .IntSeq,
    27	               valSeqConcat(
    28	                 OUT,
    29	                 vCons(
    30	                   str(seqConcat(CUR, iCons(C, .IntSeq))),
    31	                   .ValSeq)))
    32	           #else
    33	             scanParenGroups(
    34	               REST,
    35	               D +Int 1,
    36	               seqConcat(CUR, iCons(C, .IntSeq)),
    37	               OUT)
    38	           #fi
    39	         #else
    40	           #if (D -Int 1) ==Int 0
    41	           #then
    42	             scanParenGroups(
    43	               REST,
    44	               0,
    45	               .IntSeq,
    46	               valSeqConcat(
    47	                 OUT,
    48	                 vCons(
    49	                   str(seqConcat(CUR, iCons(C, .IntSeq))),
    50	                   .ValSeq)))
    51	           #else
    52	             scanParenGroups(
    53	               REST,
    54	               D -Int 1,
    55	               seqConcat(CUR, iCons(C, .IntSeq)),
    56	               OUT)
    57	           #fi
    58	         #fi
    59	       #fi
    60	
    61	  syntax ValSeq ::= separateParenGroupsSpec(IntSeq) [function, total]
    62	  rule separateParenGroupsSpec(S:IntSeq)
    63	    => scanParenGroups(S, 0, .IntSeq, .ValSeq)
    64	
    65	  // The HumanEval input domain: ASCII spaces and balanced parentheses.
    66	  syntax Bool ::= validParenInput(IntSeq) [function, total]
    67	                | validParenSuffix(IntSeq, Int) [function, total]
    68	
    69	  rule validParenInput(S:IntSeq)
    70	    => validParenSuffix(S, 0)
    71	
    72	  rule validParenSuffix(.IntSeq, D:Int)
    73	    => D ==Int 0
    74	
    75	  rule validParenSuffix(iCons(32, REST:IntSeq), D:Int)
    76	    => validParenSuffix(REST, D)
    77	
    78	  rule validParenSuffix(iCons(40, REST:IntSeq), D:Int)
    79	    => validParenSuffix(REST, D +Int 1)
    80	
    81	  rule validParenSuffix(iCons(41, REST:IntSeq), D:Int)
    82	    => validParenSuffix(REST, D -Int 1)
    83	    requires D >Int 0
    84	
    85	  rule validParenSuffix(iCons(41, _:IntSeq), D:Int)
    86	    => false
    87	    requires D <=Int 0
    88	
    89	  rule validParenSuffix(iCons(C:Int, _:IntSeq), _:Int)
    90	    => false
    91	    requires C =/=Int 32 andBool C =/=Int 40 andBool C =/=Int 41
    92	endmodule
