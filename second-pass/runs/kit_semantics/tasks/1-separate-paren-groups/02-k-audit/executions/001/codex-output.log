+    char = ""
+    for char in paren_string:
+        if char != " ":
+            current += char
+            if char == "(":
+                depth += 1
+            else:
+                depth -= 1
+            if depth == 0:
+                groups.append(current)
+                current = ""
+    return groups
+
+
