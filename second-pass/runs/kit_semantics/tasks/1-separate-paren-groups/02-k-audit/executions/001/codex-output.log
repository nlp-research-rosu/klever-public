+                        Attribute(Name("groups"), "append"),
+                        Name("current")))
+                    Assign(Name("current"), Str("")) .Stmts,
+                    .Stmts)
+                  .Stmts,
+                  .Stmts)
+                .Stmts)
+              Return(Name("groups"))
+              .Stmts,
+              0),
+          parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |->
+           list(
+             vCons(
+               str(
+                 iCons(
+                   40,
+                   iCons(40, iCons(41, iCons(41, .IntSeq))))),
+               .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      validParenInput(iCons(40, iCons(41, .IntSeq)))
+endmodule
