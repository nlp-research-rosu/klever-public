     1	from typing import List
     2	
     3	
     4	def separate_paren_groups(paren_string: str) -> List[str]:
     5	    groups = []
     6	    current = ""
     7	    depth = 0
     8	    char = ""
     9	    for char in paren_string:
    10	        if char != " ":
    11	            current += char
    12	            if char == "(":
    13	                depth += 1
    14	            else:
    15	                depth -= 1
    16	            if depth == 0:
    17	                groups.append(current)
    18	                current = ""
    19	    return groups
