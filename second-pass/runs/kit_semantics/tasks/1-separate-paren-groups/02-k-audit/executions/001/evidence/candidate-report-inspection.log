     1	"""Independent finite oracle for the HumanEval contract.
     2	
     3	The oracle constructs balanced groups from the grammar
     4	    group := "(" group* ")"
     5	and therefore knows the expected top-level partition before rendering the
     6	input or injecting spaces.
     7	"""
     8	
     9	import ast
    10	from itertools import product
    11	from pathlib import Path
    12	
    13	from solution import separate_paren_groups
    14	
    15	
    16	def translated_function_source_matches():
    17	    def target_function(path):
    18	        tree = ast.parse(Path(path).read_text(encoding="utf-8"))
    19	        return next(node for node in tree.body
    20	                    if isinstance(node, ast.FunctionDef)
    21	                    and node.name == "separate_paren_groups")
    22	
    23	    return ast.dump(target_function("solution.py"), include_attributes=False) == (
    24	        ast.dump(target_function("concrete-tests.py"), include_attributes=False)
    25	    )
    26	
    27	
    28	def groups_with_pairs(pairs):
    29	    if pairs == 1:
    30	        return {"()"}
    31	
    32	    result = set()
    33	
    34	    def inner_sequences(remaining):
    35	        if remaining == 0:
    36	            return {()}
    37	        sequences = set()
    38	        for first_size in range(1, remaining + 1):
    39	            for first in groups_with_pairs(first_size):
    40	                for rest in inner_sequences(remaining - first_size):
    41	                    sequences.add((first,) + rest)
    42	        return sequences
    43	
    44	    for children in inner_sequences(pairs - 1):
    45	        result.add("(" + "".join(children) + ")")
    46	    return result
    47	
    48	
    49	def top_level_sequences(max_pairs):
    50	    yield ()
    51	    for total_pairs in range(1, max_pairs + 1):
    52	        for sizes_length in range(1, total_pairs + 1):
    53	            for sizes in product(range(1, total_pairs + 1), repeat=sizes_length):
    54	                if sum(sizes) != total_pairs:
    55	                    continue
    56	                choices = [sorted(groups_with_pairs(size)) for size in sizes]
    57	                yield from product(*choices)
    58	
    59	
    60	def spaced_variants(text):
    61	    yield text
    62	    yield " ".join(text)
    63	    yield "  " + text + "   "
    64	    yield "".join((" " if index % 2 == 0 else "") + char
    65	                  for index, char in enumerate(text))
    66	    yield "".join(char + ("  " if index % 3 == 0 else "")
    67	                  for index, char in enumerate(text))
    68	
    69	
    70	checked = 0
    71	mismatches = []
    72	for expected_tuple in top_level_sequences(5):
    73	    expected = list(expected_tuple)
    74	    compact = "".join(expected)
    75	    for source in spaced_variants(compact):
    76	        checked += 1
    77	        actual = separate_paren_groups(source)
    78	        if actual != expected:
    79	            mismatches.append((source, expected, actual))
    80	
    81	print(f"DIFFERENTIAL_CASES={checked}")
    82	print(f"MISMATCHES={len(mismatches)}")
    83	print(f"CONCRETE_SOURCE_BODY_MATCH={translated_function_source_matches()}")
    84	if mismatches:
    85	    raise AssertionError(mismatches[:5])
    86	if not translated_function_source_matches():
    87	    raise AssertionError("concrete-tests.py drifted from solution.py")
