+  bash -o pipefail -c "$command_text" > "$temporary" 2>&1
+  local status=$?
+  local lines
+  lines="$(wc -l < "$temporary")"
+  local bytes
+  bytes="$(wc -c < "$temporary")"
+  printf '[captured output: %s lines, %s bytes]\n' "$lines" "$bytes" >> "$EVIDENCE/${label}.log"
