+  fi
+  printf '[exit %d]\n' "$status" >> "$EVIDENCE/${label}.log"
+  rm -f "$temporary"
+  printf '%s exit=%d\n' "$label" "$status"
+  if [ "$status" -ne 0 ]; then
+    overall=1
+  fi
+}
+
+run_bounded stage4_pinning \
+  "python3 '$EVIDENCE/pinning_check.py'"
