+run_cmd "python3 -c 'import json; a=json.load(open(\"/audit-input.json\")); b=json.load(open(\"/audit-campaign-lock.json\")); assert a[\"audit_campaign\"] == b; print(\"campaign block equals lock: yes\")'"
