+endmodule
diff --git a/evidence/spec-witnesses.k b/evidence/spec-witnesses.k
new file mode 100644
index 0000000000000000000000000000000000000000..23122d33e08c97c83cd88ffa2b6678f078324731
--- /dev/null
+++ b/evidence/spec-witnesses.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module SPEC-WITNESSES
+  imports VERIFICATION
+
+  claim [empty-valid]:
+    <k> validParenInput(strToCodes("")) => true </k>
+
+  claim [empty-result]:
+    <k> separateParenGroupsSpec(strToCodes("")) => .ValSeq </k>
+
+  claim [single-valid]:
+    <k> validParenInput(strToCodes("()")) => true </k>
+
+  claim [single-result]:
+    <k>
+      separateParenGroupsSpec(strToCodes("()"))
+      => vCons(str(strToCodes("()")), .ValSeq)
+    </k>
+
+  claim [prompt-valid]:
+    <k>
+      validParenInput(strToCodes("( ) (( )) (( )( ))")) => true
+    </k>
+
+  claim [prompt-result]:
+    <k>
+      separateParenGroupsSpec(strToCodes("( ) (( )) (( )( ))"))
+      => vCons(
+           str(strToCodes("()")),
+           vCons(
+             str(strToCodes("(())")),
+             vCons(str(strToCodes("(()())")), .ValSeq)))
+    </k>
+endmodule
