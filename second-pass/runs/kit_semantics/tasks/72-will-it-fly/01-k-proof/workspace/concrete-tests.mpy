Module(
  FuncDef("will_it_fly", Params("q", "w"),
    Return(
      BoolOp(
        "and",
        Compare(
          Name("q"),
          CmpOp(
            "==",
            Subscript(
              Name("q"),
              Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
        Compare(Call(Name("sum"), Name("q")), CmpOp("<=", Name("w"))))))
  Assert(
    Compare(
      Call(Name("will_it_fly"), ListExpr(Int(1), Int(2)), Int(5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Int(3), Int(2), Int(3)),
        Int(1)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Int(3), Int(2), Int(3)),
        Int(9)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("will_it_fly"), ListExpr(Int(3)), Int(5)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("will_it_fly"), ListExpr(), Int(0)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(UnaryOp("-", Int(2)), Int(7), UnaryOp("-", Int(2))),
        Int(3)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Bool(true), Bool(false), Bool(true)),
        Int(2)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Float(1.5), Float(2.0), Float(1.5)),
        Float(5.0)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Float(1.5), Float(2.0)),
        Float(10.0)),
      CmpOp("==", Bool(false)))))
