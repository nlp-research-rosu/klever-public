Module(
  FuncDef("will_it_fly", Params("q", "w"),
    Return(
      BoolOp(
        "and",
        Compare(
          Name("q"),
          CmpOp(
            "==",
            Subscript(
              Name("q"),
              Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
        Compare(Call(Name("sum"), Name("q")), CmpOp("<=", Name("w"))))))
  Assert(
    Compare(
      Call(Name("will_it_fly"), ListExpr(Int(1)), Float(1.0)),
      CmpOp("==", Bool(true)))))
