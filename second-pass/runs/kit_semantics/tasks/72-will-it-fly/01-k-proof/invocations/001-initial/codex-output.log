        "will_it_fly" |-> willItFlyClosure(),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      =>
      0 |-> list(reverseSlice(VS))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires
      allInts(VS)
      andBool
      (VS ==K reverseSlice(VS))

  claim [will-it-fly-unbalanced]:
    <k>
      Call(
        Name("will_it_fly"),
        (list(VS:ValSeq), W:Int, .Exprs))
      => false
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        "will_it_fly" |-> willItFlyClosure(),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      =>
      0 |-> list(reverseSlice(VS))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires
      allInts(VS)
      andBool
      notBool
        (VS ==K reverseSlice(VS))
endmodule

