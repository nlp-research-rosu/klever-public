+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Fixed-semantics connection theorem for the builtin sum fold.
+  claim [sum-fold]:
+    <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+      => sumInts(ACC, VS) ... </k>
+    requires allInts(VS)
+
+  // Together the two target claims partition all finite integer lists.
+  claim [will-it-fly-balanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        buildVS(
+          VS,
+          vsLen(VS) -Int 1,
+          -1,
+          -1))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      (VS ==K buildVS(VS, vsLen(VS) -Int 1, -1, -1))
+    ensures ?R ==Bool (sumInts(0, VS) <=Int W)
+
+  claim [will-it-fly-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        buildVS(
+          VS,
+          vsLen(VS) -Int 1,
+          -1,
+          -1))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      notBool
+        (VS ==K buildVS(VS, vsLen(VS) -Int 1, -1, -1))
+    ensures ?R ==Bool false
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..32dbf7927b4734ce255e65ee46ae335301257c41
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,72 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+  imports BOOL
+  imports INT
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+  syntax Int ::= sumInts(Int, ValSeq) [function]
+  syntax Val ::= willItFlyClosure() [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // The source contract's list domain: every element is an integer.
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // A guarded total projection supplies the static Int view justified by
+  // allInts; it cannot manufacture an Int outside the isInt guard.
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires isInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires isInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule #Ceil({V:Val}:>Int)
+    => ({ isInt(V) #Equals true } #And #Ceil(V))
+    [simplification]
+
+  // Exact mathematical sum on the integer-list domain.
+  rule sumInts(ACC:Int, .ValSeq) => ACC
+  rule sumInts(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumInts(ACC +Int projectIntTotal(V), R)
+    requires allInts(vCons(V, R))
+
+  // Guarded dispatch twin of the fixed rule intOf(I:Int) => I.
+  rule intOf(V:Val) => projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  // Exact translated body of solution.py, named only to keep the two target
+  // claims textually identical. It is still executed by MPY-FUNCTIONS.
+  rule willItFlyClosure()
+    => closureVal(
+         ("q", "w", .ParamNames),
+         Return(
+           BoolOp(
+             "and",
+             ( Compare(
+                 Name("q"),
+                 CmpOp(
+                   "==",
+                   Subscript(
+                     Name("q"),
+                     Slice(
+                       NoBound,
+                       NoBound,
+                       UnaryOp("-", Int(1))))))
+             , Compare(
+                 Call(Name("sum"), (Name("q"), .Exprs)),
+                 CmpOp("<=", Name("w")))
+             , .Exprs)))
+           .Stmts,
+         0)
+endmodule

codex
The focused fold theorem proves, but K does not automatically use a separately proved claim inside another claim. Under the shared proof-extension contract, I can now add an operational acceleration only if it is backed by a separate bridge-free universal connection proof. I’m isolating that proof in a base module/definition, then using an exactly matching bridge in the target definition.
