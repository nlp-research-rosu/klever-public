+++ b/spec.k
@@ -0,0 +1,67 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Together the two target claims partition all finite integer lists.
+  claim [will-it-fly-balanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => sumInts(0, VS) <=Int W
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      notBool
+        (VS ==K reverseSlice(VS))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a92671221681e36599d73dc327e1a570cf7daf64
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,98 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+  imports BOOL
+  imports INT
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+  syntax Int ::= sumInts(Int, ValSeq) [function]
+  syntax ValSeq ::= reverseSlice(ValSeq)
+    [function, total, symbol(reverseSlice), no-evaluators]
+  syntax Val ::= willItFlyClosure() [function, total]
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // The source contract's list domain: every element is an integer.
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // A guarded total projection supplies the static Int view justified by
+  // allInts; it cannot manufacture an Int outside the isInt guard.
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires isInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires isInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule #Ceil({V:Val}:>Int)
+    => ({ isInt(V) #Equals true } #And #Ceil(V))
+    [simplification]
+
+  // Exact mathematical sum on the integer-list domain.
+  rule sumInts(ACC:Int, .ValSeq) => ACC
+  rule sumInts(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumInts(ACC +Int projectIntTotal(V), R)
+    requires allInts(vCons(V, R))
+
+  // Guarded dispatch twin of the fixed rule intOf(I:Int) => I.
+  rule intOf(V:Val) => projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  // Exact translated body of solution.py, named only to keep the two target
+  // claims textually identical. It is still executed by MPY-FUNCTIONS.
+  rule willItFlyClosure()
+    => closureVal(
+         ("q", "w", .ParamNames),
+         Return(
+           BoolOp(
+             "and",
+             ( Compare(
+                 Name("q"),
+                 CmpOp(
+                   "==",
+                   Subscript(
+                     Name("q"),
+                     Slice(
+                       NoBound,
+                       NoBound,
+                       UnaryOp("-", Int(1))))))
+             , Compare(
+                 Call(Name("sum"), (Name("q"), .Exprs)),
+                 CmpOp("<=", Name("w")))
+             , .Exprs)))
+           .Stmts,
+         0)
+endmodule
+
+module REVERSE-DEFINITION
+  imports VERIFICATION-BASE
+
+  // Defining equation used only by the bridge-free connection definition.
+  rule reverseSlice(VS:ValSeq)
+    => buildVS(VS, vsLen(VS) +Int -1, -1, -1)
+    [simplification]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Inverse orientation of REVERSE-DEFINITION's exhaustive equation.
+  rule buildVS(VS:ValSeq, vsLen(VS) +Int -1, -1, -1)
+    => reverseSlice(VS)
+    [simplification]
+
+  // Operational bridge whose complete match domain is proved, without this
+  // rule, by SUM-CONNECTION.sum-fold under VERIFICATION-BASE.
+  rule <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+        => sumInts(ACC, VS) ... </k>
+    requires allInts(VS)
+endmodule

