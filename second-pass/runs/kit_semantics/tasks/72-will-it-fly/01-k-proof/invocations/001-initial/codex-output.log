diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6b0628c731240cca06525e474de64fb423a59768
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,97 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Fixed-semantics connection theorem for the builtin sum fold.
+  claim [sum-fold]:
+    <k> #sumAcc(list(VS:ValSeq), ACC:Int)
+      => ACC +Int sumInts(VS) ... </k>
+    requires allInts(VS)
+
+  // Exact call, binding, body, and full unbounded finite integer-list domain.
+  claim [will-it-fly]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |->
+          closureVal(
+            ("q", "w", .ParamNames),
+            Return(
+              BoolOp(
+                "and",
+                ( Compare(
+                    Name("q"),
+                    CmpOp(
+                      "==",
+                      Subscript(
+                        Name("q"),
+                        Slice(
+                          NoBound,
+                          NoBound,
+                          UnaryOp("-", Int(1))))))
+                , Compare(
+                    Call(Name("sum"), (Name("q"), .Exprs)),
+                    CmpOp("<=", Name("w")))
+                , .Exprs)))
+              .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "will_it_fly" |->
+          closureVal(
+            ("q", "w", .ParamNames),
+            Return(
+              BoolOp(
+                "and",
+                ( Compare(
+                    Name("q"),
+                    CmpOp(
+                      "==",
+                      Subscript(
+                        Name("q"),
+                        Slice(
+                          NoBound,
+                          NoBound,
+                          UnaryOp("-", Int(1))))))
+                , Compare(
+                    Call(Name("sum"), (Name("q"), .Exprs)),
+                    CmpOp("<=", Name("w")))
+                , .Exprs)))
+              .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        buildVS(
+          VS,
+          vsLen(VS) -Int 1,
+          -1,
+          -1))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+    ensures
+      ?R
+      ==Bool
+      ( (VS ==K buildVS(VS, vsLen(VS) -Int 1, -1, -1))
+        andBool
+        (sumInts(VS) <=Int W))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..77ddcf90c4a5a0d7448ae8e4d1e1499dac5fcbd6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+  syntax Int ::= sumInts(ValSeq) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // The source contract's list domain: every element is an integer.
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // A guarded total projection supplies the static Int view justified by
+  // allInts; it cannot manufacture an Int outside the isInt guard.
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires isInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires isInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule #Ceil({V:Val}:>Int)
+    => ({ isInt(V) #Equals true } #And #Ceil(V))
+    [simplification]
+
+  // Exact mathematical sum on the integer-list domain.
+  rule sumInts(.ValSeq) => 0
+  rule sumInts(vCons(V:Val, R:ValSeq))
+    => projectIntTotal(V) +Int sumInts(R)
+    requires allInts(vCons(V, R))
+
+  // Guarded dispatch twin of the fixed rule intOf(I:Int) => I.
+  rule intOf(V:Val) => projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+endmodule

