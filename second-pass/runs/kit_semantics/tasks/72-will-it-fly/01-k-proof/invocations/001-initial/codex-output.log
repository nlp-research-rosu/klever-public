+++ b/spec-vacuity.k
@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false for q = [3], w = 5.
+  claim [false-result]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(vCons(3, .ValSeq)), 5, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(vCons(3, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allIntegral(vCons(3, .ValSeq))
+      andBool
+      notBool hasFloat(vCons(3, .ValSeq))
+      andBool
+      (reverseSlice(vCons(3, .ValSeq)) ==K vCons(3, .ValSeq))
+      andBool
+      (sumInts(0, vCons(3, .ValSeq)) ==Int 3)
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d35e7fa5bc2f5d250962c5d50d33a0603a9b1bdb
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,133 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Together the two target claims partition all finite integer lists.
+  claim [will-it-fly-balanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => sumInts(0, VS) <=Int W
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allIntegral(VS)
+      andBool
+      notBool hasFloat(VS)
+      andBool
+      (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allIntegral(VS)
+      andBool
+      notBool hasFloat(VS)
+      andBool
+      notBool
+        (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-float-balanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Float, .Exprs))
+      => notBool gtF(sumToFloat(0, VS), W)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allNumeric(VS)
+      andBool
+      hasFloat(VS)
+      andBool
+      notBool allIntegral(VS)
+      andBool
+      (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-any-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Val, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      notBool (VS ==K reverseSlice(VS))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..03b5191f196b088155c5323778f95f0a697b23f5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,283 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+  imports BOOL
+  imports INT
+
+  syntax Bool ::= allIntegral(ValSeq)
+    [function, total, symbol(allIntegral), no-evaluators]
+  syntax Bool ::= allNumeric(ValSeq)
+    [function, total, symbol(allNumeric), no-evaluators]
+  syntax Bool ::= hasFloat(ValSeq)
+    [function, total, symbol(hasFloat), no-evaluators]
+  syntax Bool ::= integralV(Val) [function, total]
+  syntax Bool ::= floatV(Val) [function, total]
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+  syntax Bool ::= projectBoolTotal(Val)
+    [function, total, symbol(projectBoolTotal), no-evaluators]
+  syntax Float ::= projectFloatTotal(Val)
+    [function, total, symbol(projectFloatTotal), no-evaluators]
+  syntax Int ::= intLikeTotal(Val)
+    [function, total, symbol(intLikeTotal), no-evaluators]
+  syntax Int ::= sumInts(Int, ValSeq)
+    [function, total, symbol(sumInts), no-evaluators]
+  syntax Float ::= sumFloatRest(Float, ValSeq)
+    [function, total, symbol(sumFloatRest), no-evaluators]
+  syntax Float ::= sumToFloat(Int, ValSeq)
+    [function, total, symbol(sumToFloat), no-evaluators]
+  syntax Float ::= noFloatSum(Int)
+    [function, total, symbol(noFloatSum), no-evaluators]
+  syntax ValSeq ::= reverseSlice(ValSeq)
+    [function, total, symbol(reverseSlice), no-evaluators]
+  syntax Val ::= willItFlyClosure() [function, total]
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Mutually exclusive classifiers for the disjoint K Val alternatives.
+  rule integralV(V:Val)
+    => ( (isInt(V) andBool notBool isBool(V))
+         orBool
+         (isBool(V) andBool notBool isInt(V)) )
+       andBool notBool isFloat(V)
+  rule floatV(V:Val)
+    => isFloat(V)
+       andBool notBool isInt(V)
+       andBool notBool isBool(V)
+
+  // Ground equations fix the summaries' interpretation in the target theory
+  // without forcing unbounded symbolic evaluator unfolding.
+  rule allIntegral(.ValSeq) => true [concrete, simplification]
+  rule allIntegral(vCons(V:Val, R:ValSeq))
+    => integralV(V) andBool allIntegral(R)
+    [concrete, simplification]
+
+  rule sumInts(ACC:Int, .ValSeq) => ACC [concrete, simplification]
+  rule sumInts(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumInts(ACC +Int intLikeTotal(V), R)
+    [concrete, simplification]
+
+  rule allNumeric(.ValSeq) => true [concrete, simplification]
+  rule allNumeric(vCons(V:Val, R:ValSeq))
+    => (integralV(V) orBool floatV(V))
+       andBool allNumeric(R)
+    [concrete, simplification]
+
+  rule hasFloat(.ValSeq) => false [concrete, simplification]
+  rule hasFloat(vCons(V:Val, R:ValSeq))
+    => floatV(V) orBool hasFloat(R)
+    [concrete, simplification]
+
+  rule sumFloatRest(ACC:Float, .ValSeq) => ACC
+    [concrete, simplification]
+  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
+    => sumFloatRest(addF(ACC, projectFloatTotal(V)), R)
+    requires floatV(V)
+    [concrete, simplification]
+  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
+    => sumFloatRest(addF(ACC, intToF(intLikeTotal(V))), R)
+    requires integralV(V)
+    [concrete, simplification]
+  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
+    => sumFloatRest(ACC, R)
+    requires
+      notBool (floatV(V) orBool integralV(V))
+    [concrete, simplification]
+
+  rule sumToFloat(ACC:Int, .ValSeq) => noFloatSum(ACC)
+    [concrete, simplification]
+  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumFloatRest(addF(intToF(ACC), projectFloatTotal(V)), R)
+    requires floatV(V)
+    [concrete, simplification]
+  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumToFloat(ACC +Int intLikeTotal(V), R)
+    requires integralV(V)
+    [concrete, simplification]
+  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumToFloat(ACC, R)
+    requires
+      notBool (floatV(V) orBool integralV(V))
+    [concrete, simplification]
+
+  rule reverseSlice(VS:ValSeq)
+    => buildVS(VS, vsLen(VS) +Int -1, -1, -1)
+    [concrete]
+
+  // A guarded total projection supplies the static Int view justified by
+  // allIntegral; they cannot manufacture a projected value outside its guard.
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires
+      isInt(V) andBool notBool isBool(V) andBool notBool isFloat(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires
+      isInt(V) andBool notBool isBool(V) andBool notBool isFloat(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule #Ceil({V:Val}:>Int)
+    => ({ isInt(V) #Equals true } #And #Ceil(V))
+    [simplification]
+
+  rule projectBoolTotal(B:Bool) => B [simplification]
+  rule projectBoolTotal(V:Val) => {V}:>Bool
+    requires
+      isBool(V) andBool notBool isInt(V) andBool notBool isFloat(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Bool => projectBoolTotal(V)
+    requires
+      isBool(V) andBool notBool isInt(V) andBool notBool isFloat(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule #Ceil({V:Val}:>Bool)
+    => ({ isBool(V) #Equals true } #And #Ceil(V))
+    [simplification]
+
+  rule projectFloatTotal(F:Float) => F [simplification]
+  rule projectFloatTotal(V:Val) => {V}:>Float
+    requires floatV(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Float => projectFloatTotal(V)
+    requires floatV(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule #Ceil({V:Val}:>Float)
+    => ({ isFloat(V) #Equals true } #And #Ceil(V))
+    [simplification]
+
+  rule intLikeTotal(V:Val) => projectIntTotal(V)
+    requires
+      isInt(V) andBool notBool isBool(V) andBool notBool isFloat(V)
+    [simplification]
+  rule intLikeTotal(V:Val)
+    => #if projectBoolTotal(V) #then 1 #else 0 #fi
+    requires
+      isBool(V) andBool notBool isInt(V) andBool notBool isFloat(V)
+    [simplification]
+
+  // Guarded dispatch twin of the two fixed intOf rules.
+  rule intOf(V:Val) => intLikeTotal(V)
+    requires integralV(V)
+    [simplification]
+
+  // Exact translated body of solution.py, named only to keep the two target
+  // claims textually identical. It is still executed by MPY-FUNCTIONS.
+  rule willItFlyClosure()
+    => closureVal(
+         ("q", "w", .ParamNames),
+         Return(
+           BoolOp(
+             "and",
+             ( Compare(
+                 Name("q"),
+                 CmpOp(
+                   "==",
+                   Subscript(
+                     Name("q"),
+                     Slice(
+                       NoBound,
+                       NoBound,
+                       UnaryOp("-", Int(1))))))
+             , Compare(
+                 Call(Name("sum"), (Name("q"), .Exprs)),
+                 CmpOp("<=", Name("w")))
+             , .Exprs)))
+           .Stmts,
+         0)
+endmodule
+
+module SUMMARY-DEFINITION
+  imports VERIFICATION-BASE
+
+  // Exhaustive definitions used only by the bridge-free connection build.
+  rule allIntegral(.ValSeq) => true
+  rule allIntegral(vCons(V:Val, R:ValSeq))
+    => integralV(V) andBool allIntegral(R)
+
+  rule sumInts(ACC:Int, .ValSeq) => ACC
+  rule sumInts(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumInts(ACC +Int intLikeTotal(V), R)
+
+  rule allNumeric(.ValSeq) => true
+  rule allNumeric(vCons(V:Val, R:ValSeq))
+    => (integralV(V) orBool floatV(V))
+       andBool allNumeric(R)
+
+  rule hasFloat(.ValSeq) => false
+  rule hasFloat(vCons(V:Val, R:ValSeq))
+    => floatV(V) orBool hasFloat(R)
+
+  rule sumFloatRest(ACC:Float, .ValSeq) => ACC
+    [simplification]
+  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
+    => sumFloatRest(addF(ACC, projectFloatTotal(V)), R)
+    requires floatV(V)
+    [simplification]
+  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
+    => sumFloatRest(addF(ACC, intToF(intLikeTotal(V))), R)
+    requires integralV(V)
+    [simplification]
+  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
+    => sumFloatRest(ACC, R)
+    requires
+      notBool (floatV(V) orBool integralV(V))
+    [simplification]
+
+  rule sumToFloat(ACC:Int, .ValSeq) => noFloatSum(ACC)
+    [simplification]
+  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumFloatRest(addF(intToF(ACC), projectFloatTotal(V)), R)
+    requires floatV(V)
+    [simplification]
+  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumToFloat(ACC +Int intLikeTotal(V), R)
+    requires integralV(V)
+    [simplification]
+  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumToFloat(ACC, R)
+    requires
+      notBool (floatV(V) orBool integralV(V))
+    [simplification]
+
+  rule reverseSlice(VS:ValSeq)
+    => buildVS(VS, vsLen(VS) +Int -1, -1, -1)
+    [simplification]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Exact slice continuation bridge; allocation remains a fixed-semantics
+  // step. SUM-CONNECTION.reverse-slice proves this complete context.
+  rule <k> someB(-1) ~> #slStep(list(VS:ValSeq), noB, noB)
+        => #alloc(list(reverseSlice(VS))) ... </k>
+    [priority(40)]
+
+  // Operational bridge whose complete match domain is proved, without this
+  // rule, by SUM-CONNECTION.sum-fold under VERIFICATION-BASE.
+  rule <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+        => sumInts(ACC, VS) ... </k>
+    requires allIntegral(VS) andBool notBool hasFloat(VS)
+    [priority(40)]
+
+  // Float-containing fold bridge, proved in FLOAT-SUM-CONNECTION after the
+  // independently connected float-rest bridge is installed.
+  rule <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+        => sumToFloat(ACC, VS) ... </k>
+    requires
+      allNumeric(VS)
+      andBool hasFloat(VS)
+      andBool notBool allIntegral(VS)
+    [priority(39)]
+endmodule
+
+module FLOAT-REST-VERIFICATION
+  imports SUMMARY-DEFINITION
+
+  rule <k> #iterNext(list(VS:ValSeq)) ~> #sumContF(ACC:Float)
+        => sumFloatRest(ACC, VS) ... </k>
+    requires allNumeric(VS)
+    [priority(40)]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..87350d05ab6e60feadf3d823ce0065e7000ed0e4
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,13 @@
+def will_it_fly(q, w):
+    return q == q[::-1] and sum(q) <= w
+
+
+assert will_it_fly([1, 2], 5) == False
+assert will_it_fly([3, 2, 3], 1) == False
+assert will_it_fly([3, 2, 3], 9) == True
+assert will_it_fly([3], 5) == True
+assert will_it_fly([], 0) == True
+assert will_it_fly([-2, 7, -2], 3) == True
+assert will_it_fly([True, False, True], 2) == True
+assert will_it_fly([1.5, 2.0, 1.5], 5.0) == True
+assert will_it_fly([1.5, 2.0], 10.0) == False
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2896f2587ccb00c7426cd04c5e724d6de75457ce
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SUM-CONNECTION
+  imports SUMMARY-DEFINITION
+
+  // Bridge-free universal theorem for the exact sum-fold configuration used
+  // by VERIFICATION's operational bridge.
+  claim [sum-fold]:
+    <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+      => sumInts(ACC, VS) ... </k>
+    requires allIntegral(VS)
+
+  // Bridge-free connection for the float-accumulator phase.
+  claim [float-rest-fold]:
+    <k> #iterNext(list(VS:ValSeq)) ~> #sumContF(ACC:Float)
+      => sumFloatRest(ACC, VS) ... </k>
+    requires allNumeric(VS)
+
+  // The target orientation is absent from this definition. The RHS reduces
+  // solely by reverseSlice's exhaustive defining equation.
+  claim [reverse-summary]:
+    <k> buildVS(VS:ValSeq, vsLen(VS) +Int -1, -1, -1)
+      => reverseSlice(VS) </k>
+
+  // Exact fixed-semantics slice continuation, with an arbitrary k suffix.
+  claim [reverse-slice]:
+    <k> someB(-1) ~> #slStep(list(VS:ValSeq), noB, noB)
+      => #alloc(list(reverseSlice(VS))) ... </k>
+endmodule
diff --git a/connection-witness.k b/connection-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..78f8f515b2bb36b175e15e8d7601d3ca28d612ec
--- /dev/null
+++ b/connection-witness.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module CONNECTION-WITNESS
+  imports SUMMARY-DEFINITION
+
+  claim [sum-three]:
+    <k>
+      #iterNext(list(vCons(1, vCons(2, .ValSeq)))) ~> #sumCont(0)
+      => 3
+    </k>
+
+  claim [sum-negative]:
+    <k>
+      #iterNext(list(vCons(-2, vCons(1, .ValSeq)))) ~> #sumCont(0)
+      => -1
+    </k>
+
+  claim [reverse-two]:
+    <k>
+      someB(-1)
+      ~> #slStep(
+           list(vCons(1, vCons(2, .ValSeq))),
+           noB,
+           noB)
+      =>
+      #alloc(list(vCons(2, vCons(1, .ValSeq))))
+    </k>
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..10c47c91a713f52a5b1395bbe47236daf37c445c
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,31 @@
+from itertools import product
+
+from solution import will_it_fly
+
+
+def oracle(q, w):
+    balanced = all(q[i] == q[-i - 1] for i in range(len(q)))
+    total = 0
+    for value in q:
+        total += value
+    return balanced and total <= w
+
+
+checked = 0
+for length in range(6):
+    for values in product(range(-2, 3), repeat=length):
+        q = list(values)
+        for w in range(-5, 6):
+            assert will_it_fly(q, w) is oracle(q, w), (q, w)
+            checked += 1
+
+numeric_values = [False, True, -1, 0, 1, -0.5, 0.5]
+numeric_weights = [-2, -0.5, 0, 0.5, 2]
+for length in range(5):
+    for values in product(numeric_values, repeat=length):
+        q = list(values)
+        for w in numeric_weights:
+            assert will_it_fly(q, w) is oracle(q, w), (q, w)
+            checked += 1
+
+print(f"differential: {checked} cases, 0 mismatches")
diff --git a/float-connection-spec.k b/float-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5331fae572865043ee8ed3ec9c6cd7f9fc548269
--- /dev/null
+++ b/float-connection-spec.k
@@ -0,0 +1,12 @@
+requires "verification.k"
+
+module FLOAT-SUM-CONNECTION
+  imports FLOAT-REST-VERIFICATION
+
+  // The initial Int accumulator crosses to the float phase at the first
+  // float. FLOAT-REST-VERIFICATION is justified independently.
+  claim [float-sum-fold]:
+    <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+      => sumToFloat(ACC, VS) ... </k>
+    requires allNumeric(VS) andBool hasFloat(VS)
+endmodule
diff --git a/model-boundary-comparison.py b/model-boundary-comparison.py
new file mode 100644
index 0000000000000000000000000000000000000000..1cf230832e805f97cd3c3968cf798f30c431065f
--- /dev/null
+++ b/model-boundary-comparison.py
@@ -0,0 +1,7 @@
+def will_it_fly(q, w):
+    return q == q[::-1] and sum(q) <= w
+
+
+# CPython promotes the integer sum for comparison with a float capacity.
+# The supplied MPY semantics has no Int <= Float dispatch rule.
+assert will_it_fly([1], 1.0) == True
diff --git a/model-boundary.py b/model-boundary.py
new file mode 100644
index 0000000000000000000000000000000000000000..87a2c9058a559fa8e667326af732bcce1592768f
--- /dev/null
+++ b/model-boundary.py
@@ -0,0 +1,7 @@
+def will_it_fly(q, w):
+    return q == q[::-1] and sum(q) <= w
+
+
+# CPython identifies 1 and True numerically, while the supplied MPY list
+# equality compares the distinct Int and Bool constructors structurally.
+assert will_it_fly([1, True], 2) == True
diff --git a/mutation-verification.k b/mutation-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0ce396b19323faf0ec3267ecf525a98867a750d5
--- /dev/null
+++ b/mutation-verification.k
@@ -0,0 +1,13 @@
+requires "verification.k"
+
+module SUMMARY-MUTATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Deliberately wrong interpretations used only by negative probes.
+  rule sumInts(_:Int, _:ValSeq) => 0
+  rule sumToFloat(_:Int, vCons(V:Val, _:ValSeq))
+    => projectFloatTotal(V)
+    requires isFloat(V)
+  rule reverseSlice(_:ValSeq) => .ValSeq
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c6d4dec1ee9d92344eadcaab28d52e4b0a0a3880
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,116 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+python3 py2mpy.py model-boundary.py > model-boundary.mpy
+python3 py2mpy.py model-boundary-comparison.py \
+  > model-boundary-comparison.mpy
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete-tests.mpy --definition runtime-kompiled
+python3 differential_test.py
+
+kompile --backend haskell verification.k \
+  --main-module SUMMARY-DEFINITION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition connection-kompiled
+kprove connection-spec.k \
+  --definition connection-kompiled \
+  --spec-module SUM-CONNECTION
+kprove connection-witness.k \
+  --definition connection-kompiled \
+  --spec-module CONNECTION-WITNESS
+
+kompile --backend haskell verification.k \
+  --main-module FLOAT-REST-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition float-connection-kompiled
+kprove float-connection-spec.k \
+  --definition float-connection-kompiled \
+  --spec-module FLOAT-SUM-CONNECTION
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+kompile --backend haskell mutation-verification.k \
+  --main-module SUMMARY-MUTATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition mutation-kompiled
+
+if kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY
+then
+  echo "ERROR: false-postcondition mutation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-postcondition mutation"
+fi
+
+if kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION
+then
+  echo "ERROR: changed-body mutation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: changed-body mutation"
+fi
+
+if kprove spec-summary-mutation.k \
+  --definition mutation-kompiled \
+  --spec-module SPEC-SUMMARY-MUTATION \
+  --claims SPEC-SUMMARY-MUTATION.wrong-sum
+then
+  echo "ERROR: wrong integer-sum interpretation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: wrong integer-sum interpretation"
+fi
+
+if kprove spec-summary-mutation.k \
+  --definition mutation-kompiled \
+  --spec-module SPEC-SUMMARY-MUTATION \
+  --claims SPEC-SUMMARY-MUTATION.wrong-float-sum
+then
+  echo "ERROR: wrong float-sum interpretation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: wrong float-sum interpretation"
+fi
+
+if kprove spec-summary-mutation.k \
+  --definition mutation-kompiled \
+  --spec-module SPEC-SUMMARY-MUTATION \
+  --claims SPEC-SUMMARY-MUTATION.wrong-reverse
+then
+  echo "ERROR: wrong reverse interpretation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: wrong reverse interpretation"
+fi
+
+if krun model-boundary.mpy --definition runtime-kompiled
+then
+  echo "ERROR: numeric-identification boundary probe unexpectedly passed"
+  exit 1
+else
+  echo "EXPECTED FAILURE: Int/Bool equality model boundary"
+fi
+
+if krun model-boundary-comparison.mpy --definition runtime-kompiled
+then
+  echo "ERROR: mixed-comparison boundary probe unexpectedly passed"
+  exit 1
+else
+  echo "EXPECTED FAILURE: mixed numeric <= model boundary"
+fi
