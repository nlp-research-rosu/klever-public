+      someB(-1)
+      ~> #slStep(
+           list(vCons(1, vCons(2, .ValSeq))),
+           noB,
+           noB)
+      =>
+      #alloc(
+        list(
+          reverseSlice(
+            vCons(1, vCons(2, .ValSeq)))))
+    </k>
+endmodule
