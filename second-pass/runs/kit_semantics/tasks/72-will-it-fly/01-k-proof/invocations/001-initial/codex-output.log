@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false for q = [3], w = 5.
+  claim [false-result]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(vCons(3, .ValSeq)), 5, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(vCons(3, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allIntegral(vCons(3, .ValSeq))
+      andBool
+      notBool hasFloat(vCons(3, .ValSeq))
+      andBool
+      (reverseSlice(vCons(3, .ValSeq)) ==K vCons(3, .ValSeq))
+      andBool
+      (sumInts(0, vCons(3, .ValSeq)) ==Int 3)
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d35e7fa5bc2f5d250962c5d50d33a0603a9b1bdb
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,133 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Together the two target claims partition all finite integer lists.
+  claim [will-it-fly-balanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => sumInts(0, VS) <=Int W
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allIntegral(VS)
+      andBool
+      notBool hasFloat(VS)
+      andBool
+      (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allIntegral(VS)
+      andBool
+      notBool hasFloat(VS)
+      andBool
+      notBool
+        (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-float-balanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Float, .Exprs))
+      => notBool gtF(sumToFloat(0, VS), W)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allNumeric(VS)
+      andBool
+      hasFloat(VS)
+      andBool
+      notBool allIntegral(VS)
+      andBool
+      (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-any-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Val, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      notBool (VS ==K reverseSlice(VS))
