+      =>
+      0 |-> list(
+        buildVS(
+          VS,
+          vsLen(VS) -Int 1,
+          -1,
+          -1))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
