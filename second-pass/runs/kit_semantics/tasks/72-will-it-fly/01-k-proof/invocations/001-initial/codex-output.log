@@ -0,0 +1,2 @@
+def will_it_fly(q, w):
+    return q == q[::-1] and sum(q) <= w
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f3f552c574b8b1c9aadb7131f83e104ff439c259
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,67 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Together the two target claims partition all finite integer lists.
+  claim [will-it-fly-balanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => sumInts(0, VS) <=Int W
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      notBool
+        (VS ==K reverseSlice(VS))
+endmodule
