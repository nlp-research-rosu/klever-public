+                   "==",
+                   Subscript(
+                     Name("q"),
+                     Slice(
+                       NoBound,
+                       NoBound,
+                       UnaryOp("-", Int(1))))))
+             , Compare(
+                 Call(Name("sum"), (Name("q"), .Exprs)),
+                 CmpOp("<=", Name("w")))
+             , .Exprs)))
+           .Stmts,
+         0)
+endmodule
+
