+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      notBool
+        (VS ==K reverseSlice(VS))
+endmodule
