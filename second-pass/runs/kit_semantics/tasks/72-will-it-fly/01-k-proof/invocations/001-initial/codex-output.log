+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Fixed-semantics connection theorem for the builtin sum fold.
+  claim [sum-fold]:
+    <k> #sumAcc(list(VS:ValSeq), ACC:Int)
+      => ACC +Int sumInts(VS) ... </k>
+    requires allInts(VS)
+
+  // Exact call, binding, body, and full unbounded finite integer-list domain.
+  claim [will-it-fly]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |->
+          closureVal(
+            ("q", "w", .ParamNames),
+            Return(
+              BoolOp(
+                "and",
+                ( Compare(
+                    Name("q"),
+                    CmpOp(
+                      "==",
+                      Subscript(
+                        Name("q"),
+                        Slice(
+                          NoBound,
+                          NoBound,
+                          UnaryOp("-", Int(1))))))
+                , Compare(
+                    Call(Name("sum"), (Name("q"), .Exprs)),
+                    CmpOp("<=", Name("w")))
+                , .Exprs)))
+              .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "will_it_fly" |->
+          closureVal(
+            ("q", "w", .ParamNames),
+            Return(
+              BoolOp(
+                "and",
+                ( Compare(
+                    Name("q"),
+                    CmpOp(
+                      "==",
+                      Subscript(
+                        Name("q"),
+                        Slice(
+                          NoBound,
+                          NoBound,
+                          UnaryOp("-", Int(1))))))
+                , Compare(
+                    Call(Name("sum"), (Name("q"), .Exprs)),
+                    CmpOp("<=", Name("w")))
+                , .Exprs)))
+              .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        buildVS(
+          VS,
+          vsLen(VS) -Int 1,
+          -1,
+          -1))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+    ensures
+      ?R
+      ==Bool
+      ( (VS ==K buildVS(VS, vsLen(VS) -Int 1, -1, -1))
+        andBool
+        (sumInts(VS) <=Int W))
+endmodule
