index 0000000000000000000000000000000000000000..e89dfaf781de4b8f45fe72456ced825ac978d5da
--- /dev/null
+++ b/bridge-test.k
@@ -0,0 +1,9 @@
+requires "verification.k"
+
+module BRIDGE-TEST
+  imports VERIFICATION
+
+  claim [bridge-fires]:
+    <k> buildVS(VS:ValSeq, vsLen(VS) +Int -1, -1, -1)
+      => reverseSlice(VS) </k>
+endmodule
diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..1a1846a5b37a23b230b9d497d47a3b246440fcbe
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,10 @@
+def will_it_fly(q, w):
+    return q == q[::-1] and sum(q) <= w
+
+
+assert will_it_fly([1, 2], 5) == False
+assert will_it_fly([3, 2, 3], 1) == False
+assert will_it_fly([3, 2, 3], 9) == True
+assert will_it_fly([3], 5) == True
+assert will_it_fly([], 0) == True
+assert will_it_fly([-2, 7, -2], 3) == True
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1b7a411a5f3438d29330c6ec3019a4567b05d04c
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,18 @@
+requires "verification.k"
+
+module SUM-CONNECTION
+  imports REVERSE-DEFINITION
+
+  // Bridge-free universal theorem for the exact sum-fold configuration used
+  // by VERIFICATION's operational bridge.
+  claim [sum-fold]:
+    <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+      => sumInts(ACC, VS) ... </k>
+    requires allInts(VS)
+
+  // The target orientation is absent from this definition. The RHS reduces
+  // solely by reverseSlice's exhaustive defining equation.
+  claim [reverse-summary]:
+    <k> buildVS(VS:ValSeq, vsLen(VS) +Int -1, -1, -1)
+      => reverseSlice(VS) </k>
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..c76645dfab6f64852885dfb0d704e84294923f71
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,22 @@
+from itertools import product
+
+from solution import will_it_fly
+
+
+def oracle(q, w):
+    balanced = all(q[i] == q[-i - 1] for i in range(len(q)))
+    total = 0
+    for value in q:
+        total += value
+    return balanced and total <= w
+
+
+checked = 0
+for length in range(6):
+    for values in product(range(-2, 3), repeat=length):
+        q = list(values)
+        for w in range(-5, 6):
+            assert will_it_fly(q, w) is oracle(q, w), (q, w)
+            checked += 1
+
+print(f"differential: {checked} cases, 0 mismatches")
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..416244127b10ce6dad3787e6659c29faaff3d23c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def will_it_fly(q, w):
+    return q == q[::-1] and sum(q) <= w
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f3f552c574b8b1c9aadb7131f83e104ff439c259
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,67 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Together the two target claims partition all finite integer lists.
+  claim [will-it-fly-balanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => sumInts(0, VS) <=Int W
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Int, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "will_it_fly" |-> willItFlyClosure(),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(reverseSlice(VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allInts(VS)
+      andBool
+      notBool
+        (VS ==K reverseSlice(VS))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a92671221681e36599d73dc327e1a570cf7daf64
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,98 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+  imports BOOL
+  imports INT
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+  syntax Int ::= sumInts(Int, ValSeq) [function]
+  syntax ValSeq ::= reverseSlice(ValSeq)
+    [function, total, symbol(reverseSlice), no-evaluators]
+  syntax Val ::= willItFlyClosure() [function, total]
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // The source contract's list domain: every element is an integer.
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // A guarded total projection supplies the static Int view justified by
+  // allInts; it cannot manufacture an Int outside the isInt guard.
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires isInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires isInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule #Ceil({V:Val}:>Int)
+    => ({ isInt(V) #Equals true } #And #Ceil(V))
+    [simplification]
+
+  // Exact mathematical sum on the integer-list domain.
+  rule sumInts(ACC:Int, .ValSeq) => ACC
+  rule sumInts(ACC:Int, vCons(V:Val, R:ValSeq))
+    => sumInts(ACC +Int projectIntTotal(V), R)
+    requires allInts(vCons(V, R))
+
+  // Guarded dispatch twin of the fixed rule intOf(I:Int) => I.
+  rule intOf(V:Val) => projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  // Exact translated body of solution.py, named only to keep the two target
+  // claims textually identical. It is still executed by MPY-FUNCTIONS.
+  rule willItFlyClosure()
+    => closureVal(
+         ("q", "w", .ParamNames),
+         Return(
+           BoolOp(
+             "and",
+             ( Compare(
+                 Name("q"),
+                 CmpOp(
+                   "==",
+                   Subscript(
+                     Name("q"),
+                     Slice(
+                       NoBound,
+                       NoBound,
+                       UnaryOp("-", Int(1))))))
+             , Compare(
+                 Call(Name("sum"), (Name("q"), .Exprs)),
+                 CmpOp("<=", Name("w")))
+             , .Exprs)))
+           .Stmts,
+         0)
+endmodule
+
+module REVERSE-DEFINITION
+  imports VERIFICATION-BASE
+
+  // Defining equation used only by the bridge-free connection definition.
+  rule reverseSlice(VS:ValSeq)
+    => buildVS(VS, vsLen(VS) +Int -1, -1, -1)
+    [simplification]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Inverse orientation of REVERSE-DEFINITION's exhaustive equation.
+  rule buildVS(VS:ValSeq, vsLen(VS) +Int -1, -1, -1)
+    => reverseSlice(VS)
+    [simplification]
+
+  // Operational bridge whose complete match domain is proved, without this
+  // rule, by SUM-CONNECTION.sum-fold under VERIFICATION-BASE.
+  rule <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+        => sumInts(ACC, VS) ... </k>
+    requires allInts(VS)
+endmodule

exec
/bin/bash -lc 'kprove bridge-test.k --definition verification-kompiled --spec-module BRIDGE-TEST' in /workspace
