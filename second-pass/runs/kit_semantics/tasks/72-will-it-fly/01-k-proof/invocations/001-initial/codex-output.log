+  // Bridge-free universal theorem for the exact sum-fold configuration used
+  // by VERIFICATION's operational bridge.
+  claim [sum-fold]:
+    <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
+      => sumInts(ACC, VS) ... </k>
+    requires allInts(VS)
+
+  // The target orientation is absent from this definition. The RHS reduces
+  // solely by reverseSlice's exhaustive defining equation.
+  claim [reverse-summary]:
+    <k> buildVS(VS:ValSeq, vsLen(VS) +Int -1, -1, -1)
+      => reverseSlice(VS) </k>
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..c76645dfab6f64852885dfb0d704e84294923f71
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,22 @@
+from itertools import product
+
+from solution import will_it_fly
+
+
+def oracle(q, w):
+    balanced = all(q[i] == q[-i - 1] for i in range(len(q)))
+    total = 0
+    for value in q:
+        total += value
+    return balanced and total <= w
+
+
+checked = 0
+for length in range(6):
+    for values in product(range(-2, 3), repeat=length):
+        q = list(values)
+        for w in range(-5, 6):
+            assert will_it_fly(q, w) is oracle(q, w), (q, w)
+            checked += 1
+
+print(f"differential: {checked} cases, 0 mismatches")
