+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      allNumeric(VS)
+      andBool
+      hasFloat(VS)
+      andBool
+      notBool allIntegral(VS)
+      andBool
+      (VS ==K reverseSlice(VS))
+
+  claim [will-it-fly-any-unbalanced]:
+    <k>
+      Call(
+        Name("will_it_fly"),
+        (list(VS:ValSeq), W:Val, .Exprs))
+      => false
+    </k>
