  rc=${PIPESTATUS[0]}
  echo "EXIT_STATUS=$rc (expected nonzero)" | tee -a "$log"
  if [ "$rc" -eq 0 ]; then exit 90; fi
done
exit 0' in /tmp/audit-work/72-will-it-fly
