@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Mechanical constructor-level comparison of solution.mpy and the claim closure."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+
