    37	module VERIFICATION-BASE
    38	  imports MPY
    39	  imports VERIFICATION-SYNTAX
    40	
    41	  // Mutually exclusive classifiers for the disjoint K Val alternatives.
    42	  rule integralV(V:Val)
    43	    => ( (isInt(V) andBool notBool isBool(V))
    44	         orBool
    45	         (isBool(V) andBool notBool isInt(V)) )
    46	       andBool notBool isFloat(V)
    47	  rule floatV(V:Val)
    48	    => isFloat(V)
    49	       andBool notBool isInt(V)
    50	       andBool notBool isBool(V)
    51	
    52	  // Ground equations fix the summaries' interpretation in the target theory
    53	  // without forcing unbounded symbolic evaluator unfolding.
    54	  rule allIntegral(.ValSeq) => true [concrete, simplification]
    55	  rule allIntegral(vCons(V:Val, R:ValSeq))
    56	    => integralV(V) andBool allIntegral(R)
    57	    [concrete, simplification]
    58	
    59	  rule sumInts(ACC:Int, .ValSeq) => ACC [concrete, simplification]
    60	  rule sumInts(ACC:Int, vCons(V:Val, R:ValSeq))
    61	    => sumInts(ACC +Int intLikeTotal(V), R)
    62	    [concrete, simplification]
    63	
    64	  rule allNumeric(.ValSeq) => true [concrete, simplification]
    65	  rule allNumeric(vCons(V:Val, R:ValSeq))
    66	    => (integralV(V) orBool floatV(V))
    67	       andBool allNumeric(R)
    68	    [concrete, simplification]
    69	
    70	  rule hasFloat(.ValSeq) => false [concrete, simplification]
    71	  rule hasFloat(vCons(V:Val, R:ValSeq))
    72	    => floatV(V) orBool hasFloat(R)
    73	    [concrete, simplification]
    74	
    75	  rule sumFloatRest(ACC:Float, .ValSeq) => ACC
    76	    [concrete, simplification]
    77	  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
    78	    => sumFloatRest(addF(ACC, projectFloatTotal(V)), R)
