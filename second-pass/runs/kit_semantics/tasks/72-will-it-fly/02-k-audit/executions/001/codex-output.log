diff --git a/evidence/reviewer-wrong-summary-spec.k b/evidence/reviewer-wrong-summary-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1e3d230c726f8b11d5e0d62cbe9f4d95b9de88e3
--- /dev/null
+++ b/evidence/reviewer-wrong-summary-spec.k
@@ -0,0 +1,24 @@
+requires "reviewer-wrong-summary-verification.k"
+
+module REVIEWER-WRONG-SUMMARY-SPEC
+  imports REVIEWER-WRONG-SUMMARY
+
