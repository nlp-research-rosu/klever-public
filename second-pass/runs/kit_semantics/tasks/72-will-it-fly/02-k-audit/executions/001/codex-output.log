diff --git a/evidence/reviewer-spec-vacuity.k b/evidence/reviewer-spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..612dfbb299b0f5b128535263c718ecf409b2e552
--- /dev/null
+++ b/evidence/reviewer-spec-vacuity.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module REVIEWER-SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh false obligation: the real program returns true for q=[3], w=5.
+  claim [false-boolean-result]:
+    <k>
+      Call(Name("will_it_fly"), (list(vCons(3, .ValSeq)), 5, .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("will_it_fly" |-> willItFlyClosure(), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(3, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
