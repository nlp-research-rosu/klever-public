kompile --backend haskell reviewer-wrong-summary-verification.k --main-module REVIEWER-WRONG-SUMMARY --syntax-module MPY-SYNTAX --output-definition reviewer-wrong-summary-kompiled 2>&1 | tee -a "$log"
rc=${PIPESTATUS[0]}
echo "EXIT_STATUS=$rc" | tee -a "$log"
if [ "$rc" -ne 0 ]; then exit "$rc"; fi
for label in wrong-integer-sum wrong-reverse wrong-float-sum; do
  echo "$ kprove reviewer-wrong-summary-spec.k --definition reviewer-wrong-summary-kompiled --spec-module REVIEWER-WRONG-SUMMARY-SPEC --claims REVIEWER-WRONG-SUMMARY-SPEC.$label" | tee -a "$log"
