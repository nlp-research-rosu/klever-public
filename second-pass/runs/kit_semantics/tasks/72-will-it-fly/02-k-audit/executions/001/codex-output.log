    89	    [concrete, simplification]
    90	
    91	  rule sumToFloat(ACC:Int, .ValSeq) => noFloatSum(ACC)
    92	    [concrete, simplification]
    93	  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
    94	    => sumFloatRest(addF(intToF(ACC), projectFloatTotal(V)), R)
    95	    requires floatV(V)
    96	    [concrete, simplification]
    97	  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
    98	    => sumToFloat(ACC +Int intLikeTotal(V), R)
    99	    requires integralV(V)
   100	    [concrete, simplification]
   101	  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
   102	    => sumToFloat(ACC, R)
   103	    requires
   104	      notBool (floatV(V) orBool integralV(V))
   105	    [concrete, simplification]
   106	
   107	  rule reverseSlice(VS:ValSeq)
   108	    => buildVS(VS, vsLen(VS) +Int -1, -1, -1)
   109	    [concrete]
   110	
   111	  // A guarded total projection supplies the static Int view justified by
   112	  // allIntegral; they cannot manufacture a projected value outside its guard.
   113	  rule projectIntTotal(I:Int) => I [simplification]
   114	  rule projectIntTotal(V:Val) => {V}:>Int
   115	    requires
   116	      isInt(V) andBool notBool isBool(V) andBool notBool isFloat(V)
   117	    [concrete, simplification(10), preserves-definedness]
   118	  rule {V:Val}:>Int => projectIntTotal(V)
   119	    requires
   120	      isInt(V) andBool notBool isBool(V) andBool notBool isFloat(V)
   121	    [symbolic(V), simplification, preserves-definedness]
   122	  rule #Ceil({V:Val}:>Int)
   123	    => ({ isInt(V) #Equals true } #And #Ceil(V))
   124	    [simplification]
   125	
   126	  rule projectBoolTotal(B:Bool) => B [simplification]
   127	  rule projectBoolTotal(V:Val) => {V}:>Bool
   128	    requires
   129	      isBool(V) andBool notBool isInt(V) andBool notBool isFloat(V)
   130	    [concrete, simplification(10), preserves-definedness]
   131	  rule {V:Val}:>Bool => projectBoolTotal(V)
   132	    requires
   133	      isBool(V) andBool notBool isInt(V) andBool notBool isFloat(V)
   134	    [symbolic(V), simplification, preserves-definedness]
   135	  rule #Ceil({V:Val}:>Bool)
   136	    => ({ isBool(V) #Equals true } #And #Ceil(V))
   137	    [simplification]
   138	
   139	  rule projectFloatTotal(F:Float) => F [simplification]
   140	  rule projectFloatTotal(V:Val) => {V}:>Float
   141	    requires floatV(V)
   142	    [concrete, simplification(10), preserves-definedness]
   143	  rule {V:Val}:>Float => projectFloatTotal(V)
   144	    requires floatV(V)
   145	    [symbolic(V), simplification, preserves-definedness]
   146	  rule #Ceil({V:Val}:>Float)
   147	    => ({ isFloat(V) #Equals true } #And #Ceil(V))
   148	    [simplification]
   149	
   150	  rule intLikeTotal(V:Val) => projectIntTotal(V)
   151	    requires
   152	      isInt(V) andBool notBool isBool(V) andBool notBool isFloat(V)
   153	    [simplification]
   154	  rule intLikeTotal(V:Val)
   155	    => #if projectBoolTotal(V) #then 1 #else 0 #fi
   156	    requires
   157	      isBool(V) andBool notBool isInt(V) andBool notBool isFloat(V)
   158	    [simplification]
   159	
   160	  // Guarded dispatch twin of the two fixed intOf rules.
   161	  rule intOf(V:Val) => intLikeTotal(V)
   162	    requires integralV(V)
   163	    [simplification]
   164	
   165	  // Exact translated body of solution.py, named only to keep the two target
   166	  // claims textually identical. It is still executed by MPY-FUNCTIONS.
   167	  rule willItFlyClosure()
   168	    => closureVal(
   169	         ("q", "w", .ParamNames),
   170	         Return(
   171	           BoolOp(
   172	             "and",
   173	             ( Compare(
   174	                 Name("q"),
   175	                 CmpOp(
   176	                   "==",
   177	                   Subscript(
   178	                     Name("q"),
   179	                     Slice(
   180	                       NoBound,
   181	                       NoBound,
   182	                       UnaryOp("-", Int(1))))))
   183	             , Compare(
   184	                 Call(Name("sum"), (Name("q"), .Exprs)),
   185	                 CmpOp("<=", Name("w")))
   186	             , .Exprs)))
   187	           .Stmts,
   188	         0)
   189	endmodule
   190	
   191	module SUMMARY-DEFINITION
   192	  imports VERIFICATION-BASE
   193	
   194	  // Exhaustive definitions used only by the bridge-free connection build.
   195	  rule allIntegral(.ValSeq) => true
   196	  rule allIntegral(vCons(V:Val, R:ValSeq))
   197	    => integralV(V) andBool allIntegral(R)
   198	
   199	  rule sumInts(ACC:Int, .ValSeq) => ACC
   200	  rule sumInts(ACC:Int, vCons(V:Val, R:ValSeq))
   201	    => sumInts(ACC +Int intLikeTotal(V), R)
   202	
   203	  rule allNumeric(.ValSeq) => true
