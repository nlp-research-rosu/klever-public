   206	       andBool allNumeric(R)
   207	
   208	  rule hasFloat(.ValSeq) => false
   209	  rule hasFloat(vCons(V:Val, R:ValSeq))
   210	    => floatV(V) orBool hasFloat(R)
   211	
   212	  rule sumFloatRest(ACC:Float, .ValSeq) => ACC
   213	    [simplification]
   214	  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
   215	    => sumFloatRest(addF(ACC, projectFloatTotal(V)), R)
   216	    requires floatV(V)
