   218	  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
   219	    => sumFloatRest(addF(ACC, intToF(intLikeTotal(V))), R)
   220	    requires integralV(V)
   221	    [simplification]
   222	  rule sumFloatRest(ACC:Float, vCons(V:Val, R:ValSeq))
   223	    => sumFloatRest(ACC, R)
   224	    requires
   225	      notBool (floatV(V) orBool integralV(V))
   226	    [simplification]
   227	
   228	  rule sumToFloat(ACC:Int, .ValSeq) => noFloatSum(ACC)
   229	    [simplification]
   230	  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
   231	    => sumFloatRest(addF(intToF(ACC), projectFloatTotal(V)), R)
   232	    requires floatV(V)
   233	    [simplification]
   234	  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
   235	    => sumToFloat(ACC +Int intLikeTotal(V), R)
   236	    requires integralV(V)
   237	    [simplification]
   238	  rule sumToFloat(ACC:Int, vCons(V:Val, R:ValSeq))
   239	    => sumToFloat(ACC, R)
   240	    requires
   241	      notBool (floatV(V) orBool integralV(V))
