   243	
   244	  rule reverseSlice(VS:ValSeq)
   245	    => buildVS(VS, vsLen(VS) +Int -1, -1, -1)
   246	    [simplification]
   247	endmodule
   248	
   249	module VERIFICATION
   250	  imports VERIFICATION-BASE
   251	
   252	  // Exact slice continuation bridge; allocation remains a fixed-semantics
   253	  // step. SUM-CONNECTION.reverse-slice proves this complete context.
   254	  rule <k> someB(-1) ~> #slStep(list(VS:ValSeq), noB, noB)
   255	        => #alloc(list(reverseSlice(VS))) ... </k>
   256	    [priority(40)]
   257	
   258	  // Operational bridge whose complete match domain is proved, without this
   259	  // rule, by SUM-CONNECTION.sum-fold under SUMMARY-DEFINITION.
   260	  rule <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
   261	        => sumInts(ACC, VS) ... </k>
   262	    requires allIntegral(VS) andBool notBool hasFloat(VS)
   263	    [priority(40)]
   264	
   265	  // Float-containing fold bridge, proved in FLOAT-SUM-CONNECTION after the
   266	  // independently connected float-rest bridge is installed.
   267	  rule <k> #iterNext(list(VS:ValSeq)) ~> #sumCont(ACC:Int)
   268	        => sumToFloat(ACC, VS) ... </k>
   269	    requires
   270	      allNumeric(VS)
   271	      andBool hasFloat(VS)
   272	      andBool notBool allIntegral(VS)
   273	    [priority(39)]
   274	endmodule
   275	
   276	module FLOAT-REST-VERIFICATION
   277	  imports SUMMARY-DEFINITION
   278	
   279	  rule <k> #iterNext(list(VS:ValSeq)) ~> #sumContF(ACC:Float)
   280	        => sumFloatRest(ACC, VS) ... </k>
   281	    requires allNumeric(VS)
   282	    [priority(40)]
   283	endmodule

