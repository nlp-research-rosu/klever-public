    23	  // ==== join / count / strip / encode ========================================
    24	  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by
    25	  // the call layer; the result str is a value)
    26	  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))
    27	  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]
    28	  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq
    29	  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS
    30	  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
    31	    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))
    32	
    33	  // S.count(sub): non-overlapping window scan (Python str.count)
    34	  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
    35	  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
    36	  rule cntSub(.IntSeq, _:IntSeq) => 0
    37	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
    38	       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0
    39	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
    40	       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0
    41	  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]
    42	  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0
    43	  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]
    44	  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
    45	
    46	  // S.strip(): trim whitespace runs from both ends
    47	  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
    48	  syntax IntSeq ::= trimWS(IntSeq) [function, total]
    49	  rule trimWS(.IntSeq) => .IntSeq
    50	  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)
    51	  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)
    52	  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]
    53	  rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)
    54	  rule revISAcc(.IntSeq, A:IntSeq) => A
    55	  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))
    56	
    57	  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)
    58	  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)
    59	
    60	  // ==== prefix ===============================================================
    61	  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)
    62	
    63	  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========
    64	  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)
    65	  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]
    66	  rule cntOccVS(.ValSeq, _:Val)                => 0
    67	  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V
    68	  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)
    69	
    70	  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========
    71	  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
    72	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
    73	        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
    74	       [priority(40)]
    75	  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result
    76	  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)
    77	  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))
    78	       requires isWSC(C)
    79	  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)
    80	       requires notBool isWSC(C)
    81	  // flush the current token to the result list iff non-empty.
    82	  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]
    83	  rule flushTok(ACC:ValSeq, .IntSeq)            => ACC
    84	  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))
    85	  syntax Bool ::= isWSC(Int) [function, total]
    86	  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13
    87	
    88	  // split(sep='x') keyword form delegates to the positional k-cell rule
    89	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (kwV("sep", str(S:IntSeq)), .Vals))
    90	        => #applyK(toCall(boundMethodV(str(CS), "split")), (str(S), .Vals)) ... </k>
    91	       [priority(39)]
    92	
    93	  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).
    94	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (str(iCons(SEP:Int, .IntSeq)), .Vals))
    95	        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>
    96	       [priority(40)]
    97	  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token
    98	  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)
    99	  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))
   100	       requires C ==Int SEP
   101	  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))
   102	       requires notBool (C ==Int SEP)
   103	
   104	  rule applyMethod(str(CS:IntSeq), "replace", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)
   105	    => str(replaceC(CS, A, B))
   106	  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]
   107	  rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq
   108	  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A
   109	  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(C, replaceC(R, A, B)) requires notBool (C ==Int A)
   110	
   111	  // ==== char helpers =========================================================
   112	  syntax Bool ::= isUpperC(Int) [function, total]
   113	  rule isUpperC(C:Int) => C >=Int 65 andBool C <=Int 90
   114	
   115	  syntax Bool ::= isLowerC(Int) [function, total]
   116	  rule isLowerC(C:Int) => C >=Int 97 andBool C <=Int 122
   117	
   118	  syntax Bool ::= isAlphaC(Int) [function, total]
   119	  rule isAlphaC(C:Int) => isUpperC(C) orBool isLowerC(C)
   120	
   121	  syntax Bool ::= isDigitC(Int) [function, total]
   122	  rule isDigitC(C:Int) => C >=Int 48 andBool C <=Int 57
   123	
   124	  syntax Bool ::= hasUpper(IntSeq) [function, total]
   125	  rule hasUpper(.IntSeq) => false
   126	  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)
   127	
   128	  syntax Bool ::= hasLower(IntSeq) [function, total]
   129	  rule hasLower(.IntSeq) => false
   130	  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)
   131	
   132	  syntax Bool ::= allAlpha(IntSeq) [function, total]
   133	  rule allAlpha(.IntSeq) => true
   134	  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)
   135	
   136	  syntax Bool ::= allDigit(IntSeq) [function, total]
   137	  rule allDigit(.IntSeq) => true
   138	  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)
   139	
   140	  syntax Int ::= lowerC(Int) [function, total]
   141	
   142	  rule lowerC(C:Int) => C +Int 32 requires isUpperC(C)
   143	  rule lowerC(C:Int) => C         [owise]
   144	
   145	  syntax Int ::= upperC(Int) [function, total]
   146	  rule upperC(C:Int) => C -Int 32 requires isLowerC(C)
   147	  rule upperC(C:Int) => C         [owise]
   148	
   149	  syntax Int ::= swapC(Int) [function, total]
   150	  rule swapC(C:Int) => C +Int 32 requires isUpperC(C)
   151	  rule swapC(C:Int) => C -Int 32 requires isLowerC(C)
   152	  rule swapC(C:Int) => C         [owise]
   153	
   154	  syntax IntSeq ::= mapLower(IntSeq) [function, total]
   155	  rule mapLower(.IntSeq) => .IntSeq
   156	  rule mapLower(iCons(C:Int, S:IntSeq)) => iCons(lowerC(C), mapLower(S))
   157	
   158	  syntax IntSeq ::= mapUpper(IntSeq) [function, total]
   159	  rule mapUpper(.IntSeq) => .IntSeq
   160	  rule mapUpper(iCons(C:Int, S:IntSeq)) => iCons(upperC(C), mapUpper(S))
   161	
   162	  syntax IntSeq ::= mapSwap(IntSeq) [function, total]
   163	  rule mapSwap(.IntSeq) => .IntSeq
   164	  rule mapSwap(iCons(C:Int, S:IntSeq)) => iCons(swapC(C), mapSwap(S))
   165	
   166	  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]
   167	  rule startsWith(.IntSeq, _:IntSeq)               => true
   168	  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false
   169	  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)
   170	endmodule
--- FLOAT 1-180 ---
     1	// reference/src/semantics/float.k — MPY-FLOAT
     2	//
     3	// Minimal, TRUSTED float support. K/Haskell (kprove) has no usable symbolic IEEE-754 theory and
     4	// no Int2Float hook, so a float value stays an OPAQUE proof-domain primitive: `intFloatDiv(I, F)`
     5	// (the Python true division I / F) is `[no-evaluators]` for kprove — it never reduces on symbolic
     6	// input, and the proof verifies only the STRUCTURE (the result is the exact term the program
     7	// builds). The `[concrete]` rule evaluates it for krun (llvm HAS the Int2Float / /Float hooks), so
     8	// smoke tests run the real float value.
     9	//
    10	// Only the pieces needed so far: Float as a Val, the float literal, and Int / float true division
    11	// (the `a * h / 2.0` idiom). More float ops (float +/-/*, comparison) are added as float problems
    12	// need them — kept minimal + sound.
    13	
    14	module MPY-FLOAT
    15	  imports MPY-OPERATORS
    16	  imports MPY-BUILTINS
    17	  imports FLOAT
    18	
    19	  // Float is a value; the float literal evaluates to the K Float.
    20	  syntax Val ::= Float
    21	  rule <k> Float(F:Float) => F ... </k>
    22	
    23	  // Int / float true division. OPAQUE for kprove (no-evaluators); concrete for krun.
    24	  syntax Float ::= intFloatDiv(Int, Float) [function, total, symbol(intFloatDiv), no-evaluators]
    25	  rule intFloatDiv(I:Int, F:Float) => Int2Float(I, 53, 11) /Float F [concrete]
    26	
    27	  rule applyBin("/", I:Int, F:Float) => intFloatDiv(I, F)
    28	
    29	  // Int / Int true division (Python: always a float). OPAQUE for kprove; concrete for krun.
    30	  syntax Float ::= divII(Int, Int) [function, total, symbol(divII), no-evaluators]
    31	  rule divII(I1:Int, I2:Int) => Int2Float(I1, 53, 11) /Float Int2Float(I2, 53, 11) [concrete]
    32	  rule applyBin("/", I1:Int, I2:Int) => divII(I1, I2)
    33	
    34	  // float % float (e.g. `number % 1.0` = the fractional part). OPAQUE for kprove, concrete for
    35	  // krun. Python's float `%` is floor-based: a % b = a - floor(a/b)*b (K's %Float is IEEE
    36	  // remainder, which differs — 3.5 %Float 1.0 = -0.5 vs Python 0.5 — so it is NOT used).
    37	  syntax Float ::= floatMod(Float, Float) [function, total, symbol(floatMod), no-evaluators]
    38	  rule floatMod(F1:Float, F2:Float) => F1 -Float (floorFloat(F1 /Float F2) *Float F2) [concrete]
    39	  rule applyBin("%", F1:Float, F2:Float) => floatMod(F1, F2)
    40	
    41	  // float equality — for concrete krun asserts (e.g. `area == 7.5`); the FLOAT.eq hook is fine on
    42	  // concrete floats. kprove proofs return floats structurally and do not compare them.
    43	  rule applyCmp("==", F1:Float, F2:Float) => F1 ==Float F2
    44	  rule applyCmp("!=", F1:Float, F2:Float) => notBool (F1 ==Float F2)
    45	
    46	  // float `<` and abs — OPAQUE for kprove ([no-evaluators], so a SYMBOLIC float compare stays an
    47	  // uninterpreted Bool a proof case-splits on — a SINGLE compare per branch, not a nonlinear cascade),
    48	  // [concrete] for krun. Additive, sort-disjoint from the Int rules. (has_close_elements: the pairwise
    49	  // `abs(a-b) < t` proximity test.)
    50	  syntax Bool ::= floatLt(Float, Float) [function, total, symbol(floatLt), no-evaluators]
    51	  rule floatLt(F1:Float, F2:Float) => F1 <Float F2 [concrete]
    52	  rule applyCmp("<", F1:Float, F2:Float) => floatLt(F1, F2)
    53	
    54	  syntax Float ::= absF(Float) [function, total, symbol(absF), no-evaluators]
    55	  rule absF(F:Float) => absFloat(F) [concrete]
    56	  rule applyBuiltin("abs", F:Float, .Vals) => absF(F)
    57	
    58	  // ==== math.ceil ===========================================================
    59	  // `import X` is a no-op (we intercept the specific math functions syntactically; `math` itself is
    60	  // never bound as a value).
    61	  rule <k> Import(_:String) => .K ... </k>
    62	
    63	  // math.ceil(x): ceiling to an int. Intercepted at the Call BEFORE `math` is looked up (higher
    64	  // priority than the generic Attribute/method dispatch in call.k).
    65	  syntax KItem ::= "#mathCeil"
    66	  rule <k> Call(Attribute(Name("math"), "ceil"), (E:Expr, .Exprs)) => E ~> #mathCeil ... </k> [priority(40)]
    67	  rule <k> V:Val ~> #mathCeil => ceilF(V) ... </k>
    68	
    69	  // math.floor(x) — same interception shape as math.ceil
    70	  syntax KItem ::= "#mathFloor"
    71	  rule <k> Call(Attribute(Name("math"), "floor"), (E:Expr, .Exprs)) => E ~> #mathFloor ... </k> [priority(40)]
    72	  rule <k> V:Val ~> #mathFloor => floorFI(V) ... </k>
    73	  syntax Int ::= floorFI(Val) [function, total, symbol(floorFI)]
    74	  rule floorFI(I:Int)   => I                        [concrete]
    75	  rule floorFI(F:Float) => Float2Int(floorFloat(F)) [concrete]
    76	
    77	  // bare floor/ceil (bound by `from math import floor, ceil`)
    78	  rule applyBuiltin("floor", V:Val, .Vals) => floorFI(V)
    79	  rule applyBuiltin("ceil",  V:Val, .Vals) => ceilF(V)
    80	
    81	  // math.pow(x, y) — a two-arg interception onto powF (ints promote)
    82	  syntax KItem ::= #mathPow1(Expr) | #mathPow2(Val)
    83	  rule <k> Call(Attribute(Name("math"), "pow"), (E1:Expr, E2:Expr, .Exprs)) => E1 ~> #mathPow1(E2) ... </k> [priority(40)]
    84	  rule <k> V1:Val ~> #mathPow1(E2:Expr) => E2 ~> #mathPow2(V1) ... </k>
    85	  rule <k> V2:Val ~> #mathPow2(V1:Val) => powF(toF(V1), toF(V2)) ... </k>
    86	  syntax Float ::= toF(Val) [function, total, symbol(toF)]
    87	  rule toF(F:Float) => F        [concrete]
    88	  rule toF(I:Int)   => intToF(I) [concrete]
    89	
    90	  // ceilF: math.ceil as an Int. TOTAL (K trusts it; a symbolic list element stays opaque for
    91	  // kprove — structural). [concrete] so the Int2Float/ceilFloat hooks only run for krun (llvm).
    92	  // Matches Python incl. negatives: ceil(-2.4) = -2 = Float2Int(ceilFloat(-2.4)).
    93	  syntax Int ::= ceilF(Val) [function, total, symbol(ceilF)]
    94	  rule ceilF(I:Int)   => I                       [concrete]
    95	  rule ceilF(F:Float) => Float2Int(ceilFloat(F)) [concrete]
    96	
    97	  // unary minus on a float (e.g. the literal -2.4 = UnaryOp("-", Float(2.4))). Concrete for krun;
    98	  // proofs use symbolic elements, never a float literal.
    99	  rule applyUn("-", F:Float) => 0.0 -Float F
   100	
   101	  // ---- float - / / / + (OPAQUE for kprove [no-evaluators], concrete for krun) — for float-list
   102	  // element maps (x - lo) / (hi - lo). Mirror intFloatDiv: additive, sort-disjoint from the Int rules.
   103	  syntax Float ::= subF(Float, Float) [function, total, symbol(subF), no-evaluators]
   104	  rule subF(F1:Float, F2:Float) => F1 -Float F2 [concrete]
   105	  rule applyBin("-", F1:Float, F2:Float) => subF(F1, F2)
   106	
   107	  syntax Float ::= divF(Float, Float) [function, total, symbol(divF), no-evaluators]
   108	  rule divF(F1:Float, F2:Float) => F1 /Float F2 [concrete]
   109	  rule applyBin("/", F1:Float, F2:Float) => divF(F1, F2)
   110	
   111	  syntax Float ::= addF(Float, Float) [function, total, symbol(addF), no-evaluators]
   112	  rule addF(F1:Float, F2:Float) => F1 +Float F2 [concrete]
   113	  rule applyBin("+", F1:Float, F2:Float) => addF(F1, F2)
   114	
   115	  syntax Float ::= mulF(Float, Float) [function, total, symbol(mulF), no-evaluators]
   116	  rule mulF(F1:Float, F2:Float) => F1 *Float F2 [concrete]
   117	  rule applyBin("*", F1:Float, F2:Float) => mulF(F1, F2)
   118	
   119	  syntax Float ::= powF(Float, Float) [function, total, symbol(powF), no-evaluators]
   120	  rule powF(F1:Float, F2:Float) => F1 ^Float F2 [concrete]
   121	  rule applyBin("**", F1:Float, F2:Float) => powF(F1, F2)
   122	
   123	  // ---- the remaining comparisons (gtF promoted from find_zero — its summaries
   124	  //      case-split on the atom; >= / <= derive from the two opaque compares) ----
   125	  syntax Bool ::= gtF(Float, Float) [function, total, symbol(gtF), no-evaluators]
   126	  rule gtF(F1:Float, F2:Float) => F1 >Float F2 [concrete]
   127	  rule applyCmp(">",  F1:Float, F2:Float) => gtF(F1, F2)
   128	  rule applyCmp(">=", F1:Float, F2:Float) => notBool floatLt(F1, F2)
   129	  rule applyCmp("<=", F1:Float, F2:Float) => notBool gtF(F1, F2)
   130	
   131	  // ---- mixed Int/Float operators promote the Int side (n ** 0.5 etc.) ----
   132	  rule applyBin("**", I:Int, F:Float) => powF(intToF(I), F)
   133	  rule applyBin("**", F:Float, I:Int) => powF(F, intToF(I))
   134	  rule applyBin("-",  I:Int, F:Float) => subF(intToF(I), F)
   135	  rule applyBin("-",  F:Float, I:Int) => subF(F, intToF(I))
   136	  rule applyBin("+",  I:Int, F:Float) => addF(intToF(I), F)
   137	  rule applyBin("+",  F:Float, I:Int) => addF(F, intToF(I))
   138	  rule applyBin("*",  I:Int, F:Float) => mulF(intToF(I), F)
   139	  rule applyBin("*",  F:Float, I:Int) => mulF(F, intToF(I))
   140	
   141	  // ---- mixed Int == Float (shared eqF; opaque symbolic / concrete twin) ----
   142	  syntax Bool ::= eqF(Float, Float) [function, total, symbol(eqF), no-evaluators]
   143	  rule eqF(F1:Float, F2:Float) => F1 ==Float F2 [concrete]
   144	  rule applyCmp("==", I:Int, F:Float) => eqF(intToF(I), F)
   145	  rule applyCmp("==", F:Float, I:Int) => eqF(F, intToF(I))
   146	  rule applyCmp("!=", I:Int, F:Float) => notBool eqF(intToF(I), F)
   147	  rule applyCmp("!=", F:Float, I:Int) => notBool eqF(F, intToF(I))
   148	  rule applyCmp("<",  I:Int, F:Float) => floatLt(intToF(I), F)
   149	  rule applyCmp("<",  F:Float, I:Int) => floatLt(F, intToF(I))
   150	  rule applyCmp(">",  I:Int, F:Float) => gtF(intToF(I), F)
   151	  rule applyCmp(">",  F:Float, I:Int) => gtF(F, intToF(I))
   152	
   153	  // ---- x == None (promoted from 137; `is` cases live in operators.k) ----
   154	  rule applyCmp("==", V:Val, noneV) => V ==K noneV
   155	  rule applyCmp("!=", V:Val, noneV) => notBool (V ==K noneV)
   156	
   157	  // ---- float(str): decimal parse (promoted from 137's defined chain) ----
   158	  // digits '.' digits, optional leading '-'; concrete evaluation only (the
   159	  // symbolic side stays an opaque decStrToF term a proof case-splits on).
   160	  syntax Float ::= decStrToF(IntSeq) [function, total, symbol(decStrToF), no-evaluators]
   161	  rule decStrToF(iCons(45, CS:IntSeq)) => 0.0 -Float decStrToF(CS) [concrete]
   162	  rule decStrToF(CS:IntSeq)
   163	    => intToF(intPart(CS)) +Float (intToF(fracPart(CS)) /Float intToF(fracScale(CS)))
   164	       requires isLen(CS) >Int 0 andBool headIS(CS) =/=Int 45 [concrete]
   165	  syntax Int ::= headIS(IntSeq) [function]
   166	  rule headIS(iCons(C:Int, _:IntSeq)) => C
   167	  syntax Int ::= intPart(IntSeq) [function, total] | intPartAcc(IntSeq, Int) [function, total]
   168	  rule intPart(CS:IntSeq) => intPartAcc(CS, 0)
   169	  rule intPartAcc(.IntSeq, A:Int) => A
   170	  rule intPartAcc(iCons(46, _:IntSeq), A:Int) => A
   171	  rule intPartAcc(iCons(C:Int, R:IntSeq), A:Int) => intPartAcc(R, A *Int 10 +Int (C -Int 48))
   172	       requires C =/=Int 46
   173	  syntax Int ::= fracPart(IntSeq) [function, total] | fracAcc(IntSeq, Int) [function, total]
   174	  rule fracPart(.IntSeq) => 0
   175	  rule fracPart(iCons(46, R:IntSeq)) => fracAcc(R, 0)
   176	  rule fracPart(iCons(C:Int, R:IntSeq)) => fracPart(R) requires C =/=Int 46
   177	  rule fracAcc(.IntSeq, A:Int) => A
   178	  rule fracAcc(iCons(C:Int, R:IntSeq), A:Int) => fracAcc(R, A *Int 10 +Int (C -Int 48))
   179	  syntax Int ::= fracScale(IntSeq) [function, total] | fscAcc(IntSeq, Int) [function, total]
   180	  rule fracScale(.IntSeq) => 1
--- FLOAT 181-320 ---
   181	  rule fracScale(iCons(46, R:IntSeq)) => fscAcc(R, 1)
   182	  rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46
   183	  rule fscAcc(.IntSeq, A:Int) => A
   184	  rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)
   185	  rule applyBuiltin("float", str(CS:IntSeq), .Vals) => decStrToF(CS)
   186	  rule applyBuiltin("float", I:Int, .Vals)          => intToF(I)
   187	  rule applyBuiltin("float", F:Float, .Vals)        => F
   188	
   189	  // ---- float / int division (promoted from mean_absolute_deviation) ----
   190	  syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]
   191	  rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]
   192	  rule applyBin("/", F:Float, I:Int) => divFloatIntV(F, I)
   193	
   194	  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----
   195	  syntax Float ::= intToF(Int) [function, total, symbol(intToF), no-evaluators]
   196	  rule intToF(I:Int) => Int2Float(I, 53, 11) [concrete]
   197	  rule applyBin("+", I:Int, F:Float) => addF(intToF(I), F)
   198	  rule applyBin("+", F:Float, I:Int) => addF(F, intToF(I))
   199	  rule applyBin("-", I:Int, F:Float) => subF(intToF(I), F)
   200	  rule applyBin("-", F:Float, I:Int) => subF(F, intToF(I))
   201	  rule applyBin("*", I:Int, F:Float) => mulF(intToF(I), F)
   202	  rule applyBin("*", F:Float, I:Int) => mulF(F, intToF(I))
   203	  rule applyCmp("<", I:Int, F:Float) => floatLt(intToF(I), F)
   204	  rule applyCmp("<", F:Float, I:Int) => floatLt(F, intToF(I))
   205	  rule applyCmp(">", I:Int, F:Float) => gtF(intToF(I), F)
   206	  rule applyCmp(">", F:Float, I:Int) => gtF(F, intToF(I))
   207	
   208	  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----
   209	  syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]
   210	  rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]
   211	  rule applyBuiltin("int", F:Float, .Vals) => truncF(F)
   212	
   213	  rule applyBuiltin("float", I:Int, .Vals)   => intToF(I)
   214	  rule applyBuiltin("float", F:Float, .Vals) => F
   215	
   216	  // round: Python half-even (banker's); round(F, N) scales by 10^N
   217	  syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]
   218	  rule roundF(F:Float)
   219	    => #if (F -Float floorFloat(F)) ==Float 0.5
   220	       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
   221	              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
   222	       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
   223	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   224	  rule roundFN(F:Float, N:Int)
   225	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   226	       /Float Int2Float(10 ^Int N, 53, 11) [concrete]
   227	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   228	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   229	
   230	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   231	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   232	  syntax KItem ::= "#mathSqrt"
   233	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   234	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   235	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   236	
   237	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   238	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   239	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   240	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   241	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   242	  // the isFloat guard is disjoint from the existing isInt one.
   243	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   244	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   245	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   246	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   247	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   248	       requires isFloat(V)
   249	
   250	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   251	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   252	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   253	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   254	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   255	       requires isFloat(V)
   256	
   257	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   258	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   259	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   260	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   261	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   262	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   263	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   264	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   265	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   266	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   267	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   268	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   269	       requires isFloat(V)
   270	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   271	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   272	       requires isInt(V) orBool isBool(V)
   273	endmodule

diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..09a0ed8f384afde033e98647bc9a95c2ebd9a913
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Independent canonical-vs-candidate differential test for HumanEval/72."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import random
+from pathlib import Path
+from typing import Any, Callable
+
+
+def load_entry(module_name: str, path: Path) -> Callable[[list[Any], Any], bool]:
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.will_it_fly
+
+
+canonical = load_entry("trusted_canonical", Path("/reference/canonical.py"))
+candidate = load_entry("generated_candidate", Path("/candidate/solution.py"))
+
+
+documented_and_boundary_cases: list[tuple[list[Any], Any, bool]] = [
+    ([1, 2], 5, False),       # documented, light but unbalanced
+    ([3, 2, 3], 1, False),    # documented, balanced but overweight
+    ([3, 2, 3], 9, True),     # documented, exactly at capacity
+    ([3], 5, True),           # documented singleton
+    ([], -1, False),          # empty sum just above capacity
+    ([], 0, True),            # empty and exact boundary
+    ([0], -1, False),         # singleton overweight by one
+    ([0], 0, True),           # singleton exact boundary
+    ([1, 1], 1, False),       # balanced length two, overweight
+    ([1, 1], 2, True),        # balanced length two, exact boundary
+    ([1, 2], 3, False),       # unbalanced, exact sum boundary
+    ([-4, 1, -4], -7, True), # negative exact sum boundary
+    ([-4, 1, -4], -8, False),
+    ([10**100, 0, 10**100], 2 * 10**100, True),
+    ([False, True, False], 1, True),
+    ([1.5, -0.5, 1.5], 2.5, True),
+    ([1, 0.5, 1], 2.4, False),
+    ([1, True], 2, True),     # CPython's numeric equality boundary
+]
+
+
+def check(q: list[Any], w: Any, expected: bool | None = None) -> None:
+    global checked
+    canonical_result = canonical(q, w)
+    candidate_result = candidate(q, w)
+    assert type(canonical_result) is bool
+    assert type(candidate_result) is bool
+    assert canonical_result == candidate_result, (q, w, canonical_result, candidate_result)
+    if expected is not None:
+        assert canonical_result == expected, (q, w, canonical_result, expected)
+    checked += 1
+
+
+checked = 0
+for case_q, case_w, case_expected in documented_and_boundary_cases:
+    check(case_q, case_w, case_expected)
+fixed_count = checked
+
+# Exhaustively cross every integer-list branch boundary for modest sizes.
+for length in range(6):
+    for values in itertools.product(range(-3, 4), repeat=length):
+        q = list(values)
+        for w in range(-9, 10):
+            check(q, w)
+integer_exhaustive_count = checked - fixed_count
+
+# Representative Python numeric combinations, including Bool/Int/Float mixing.
+numeric_values = [False, True, -2, 0, 3, -0.5, 1.5]
+numeric_weights = [-4, -0.5, 0, 1, 3.5, 8]
+before_numeric = checked
+for length in range(5):
+    for values in itertools.product(numeric_values, repeat=length):
+        for w in numeric_weights:
+            check(list(values), w)
+numeric_exhaustive_count = checked - before_numeric
+
+# Deterministic longer generated cases exercise unbounded-shape representatives.
+rng = random.Random(720072)
+before_random = checked
+for _ in range(10_000):
+    length = rng.randrange(0, 41)
+    q = [rng.randrange(-10_000, 10_001) for _ in range(length)]
+    if rng.random() < 0.5:
+        q = q[: (length + 1) // 2] + q[: length // 2][::-1]
+    w = rng.randrange(-100_000, 100_001)
+    check(q, w)
+random_count = checked - before_random
+
+print(f"fixed_documented_boundary_cases={fixed_count}")
+print(f"exhaustive_integer_cases={integer_exhaustive_count}")
+print(f"exhaustive_mixed_numeric_cases={numeric_exhaustive_count}")
+print(f"deterministic_random_long_cases={random_count}")
+print(f"total_cases={checked}")
+print("mismatches=0")
diff --git a/evidence/infra_check.py b/evidence/infra_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..ebbcc41aa3178ad26433b2d9a3d7103ba68dc2d5
--- /dev/null
+++ b/evidence/infra_check.py
@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""Independent, read-only integrity checks for the mounted audit inputs."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+from collections import Counter
+from pathlib import Path
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def require_direct_regular(path: Path) -> None:
+    status = os.lstat(path)
+    assert stat.S_ISREG(status.st_mode), f"not a direct regular file: {path}"
+
+
+def compare_trees(candidate: Path, trusted: Path) -> tuple[int, int]:
+    def inventory(root: Path) -> dict[str, tuple[str, str | None]]:
+        result: dict[str, tuple[str, str | None]] = {}
+        for path in sorted(root.rglob("*")):
+            relative = path.relative_to(root).as_posix()
+            status = os.lstat(path)
+            if stat.S_ISLNK(status.st_mode):
+                result[relative] = ("symlink", os.readlink(path))
+            elif stat.S_ISDIR(status.st_mode):
+                result[relative] = ("directory", None)
+            elif stat.S_ISREG(status.st_mode):
+                result[relative] = ("file", sha256(path))
+            else:
+                result[relative] = (f"special:{stat.S_IFMT(status.st_mode)}", None)
+        return result
+
+    candidate_inventory = inventory(candidate)
+    trusted_inventory = inventory(trusted)
+    assert candidate_inventory == trusted_inventory, "supplied-semantics tree mismatch"
+    assert all(kind != "symlink" for kind, _ in candidate_inventory.values())
+    file_count = sum(kind == "file" for kind, _ in candidate_inventory.values())
+    directory_count = sum(kind == "directory" for kind, _ in candidate_inventory.values())
+    return file_count, directory_count
+
+
+def main() -> None:
+    audit_input = json.loads(AUDIT_INPUT.read_text())
+    lock_path = Path(audit_input["container_paths"]["audit_campaign_lock"])
+    lock = json.loads(lock_path.read_text())
+
+    assert audit_input["record_layout"] == "pipeline-v3"
+    assert audit_input["semantics_mode"] == "SUPPLIED_SEMANTICS"
+    assert lock == audit_input["audit_campaign"]
+    assert sha256(lock_path) == audit_input["hashes"]["audit_campaign_lock_sha256"]
+    print("campaign_block_equal=true")
+    print(f"audit_campaign_lock_sha256={sha256(lock_path)}")
+
+    paths = audit_input["container_paths"]
+    declared_mounts = {
+        key: Path(value)
+        for key, value in paths.items()
+        if key not in {"generation_root", "generation_trace", "candidate"}
+    }
+    for key, path in sorted(declared_mounts.items()):
+        require_direct_regular(path)
+        print(f"direct_regular_mount[{key}]={path}")
+    for key in ("generation_root", "generation_trace", "candidate"):
+        path = Path(paths[key])
+        status = os.lstat(path)
+        assert stat.S_ISDIR(status.st_mode) and not stat.S_ISLNK(status.st_mode)
+        print(f"direct_directory_mount[{key}]={path}")
+
+    required_records = [
+        Path("/run.json"),
+        Path("/task.json"),
+        Path("/generation-result.json"),
+        Path("/generation-evidence/invocation.json"),
+        Path("/generation-evidence/metrics.json"),
+        Path("/generation-evidence/runtime-metrics.json"),
+        Path("/generation-evidence/usage.json"),
+        Path("/generation-evidence/codex-last.txt"),
+        Path("/generation-evidence/codex-output.log"),
+        Path("/generation-evidence/prompt.txt"),
+    ]
+    for path in required_records:
+        require_direct_regular(path)
+        print(f"required_record={path} bytes={path.stat().st_size}")
+
+    expected_hashes = {
+        Path("/reference/canonical.py"): "canonical_sha256",
+        Path("/reference/prompt.py"): "trusted_prompt_sha256",
+        Path("/reference/py2mpy.py"): "trusted_translator_sha256",
+        Path("/candidate/prompt.py"): "candidate_prompt_sha256",
+        Path("/candidate/py2mpy.py"): "candidate_translator_sha256",
+        Path("/run.json"): "run_manifest_sha256",
+        Path("/task.json"): "task_manifest_sha256",
+        Path("/generation-result.json"): "stage1_result_sha256",
+        Path("/generation-evidence/invocation.json"): "stage1_invocation_sha256",
+        Path("/generation-evidence/metrics.json"): "generation_metrics_sha256",
+        Path("/generation-evidence/runtime-metrics.json"): "generation_runtime_metrics_sha256",
+        Path("/generation-evidence/usage.json"): "generation_usage_sha256",
+        Path("/generation-evidence/codex-last.txt"): "generation_codex_last_sha256",
+        Path("/generation-evidence/codex-output.log"): "generation_codex_output_sha256",
+        Path("/generation-evidence/prompt.txt"): "generation_prompt_sha256",
+    }
+    for path, key in expected_hashes.items():
+        actual = sha256(path)
+        expected = audit_input["hashes"][key]
+        assert actual == expected, f"hash mismatch for {path}: {actual} != {expected}"
+        print(f"recorded_hash_match[{key}]={actual}")
+
+    assert Path("/candidate/prompt.py").read_bytes() == Path("/reference/prompt.py").read_bytes()
+    assert Path("/candidate/py2mpy.py").read_bytes() == Path("/reference/py2mpy.py").read_bytes()
+    print("candidate_prompt_byte_equal=true")
+    print("candidate_translator_byte_equal=true")
+
+    assert Path("/reference/reference-semantics").is_dir()
+    files, directories = compare_trees(
+        Path("/candidate/reference-semantics"),
+        Path("/reference/reference-semantics"),
+    )
+    print(f"supplied_semantics_tree_equal=true files={files} directories={directories}")
+
+    json_records = [
+        AUDIT_INPUT,
+        lock_path,
+        Path("/run.json"),
+        Path("/task.json"),
+        Path("/generation-result.json"),
+        Path("/generation-evidence/invocation.json"),
+        Path("/generation-evidence/metrics.json"),
+        Path("/generation-evidence/runtime-metrics.json"),
+        Path("/generation-evidence/usage.json"),
+    ]
+    for path in json_records:
+        json.loads(path.read_text())
+        print(f"valid_json={path}")
+
+    result = json.loads(Path("/generation-result.json").read_text())
+    trace_outputs = {
+        relative: expected
+        for relative, expected in result["outputs"]["evidence"].items()
+        if relative.startswith("codex-trace/")
+    }
+    actual_trace_files = {
+        path.relative_to("/generation-evidence").as_posix(): path
+        for path in Path("/generation-evidence/codex-trace").rglob("*")
+        if path.is_file()
+    }
+    assert set(actual_trace_files) == set(trace_outputs)
+    for relative, path in sorted(actual_trace_files.items()):
+        require_direct_regular(path)
+        actual = sha256(path)
+        assert actual == trace_outputs[relative]
+        print(f"trace_hash_match[{relative}]={actual}")
+
+        event_types: Counter[str] = Counter()
+        payload_types: Counter[str] = Counter()
+        line_count = 0
+        with path.open() as stream:
+            for line_count, line in enumerate(stream, start=1):
+                event = json.loads(line)
+                event_types[str(event.get("type", "<missing>"))] += 1
+                payload = event.get("payload")
+                if isinstance(payload, dict):
+                    payload_types[str(payload.get("type", "<missing>"))] += 1
+        print(f"trace_jsonl_valid=true lines={line_count}")
+        print(f"trace_event_types={dict(sorted(event_types.items()))}")
+        print(f"trace_payload_types={dict(sorted(payload_types.items()))}")
+
+    output = Path("/generation-evidence/codex-output.log").read_text(errors="replace")
+    print(f"codex_output_fully_read=true chars={len(output)} lines={output.count(chr(10))}")
+    for marker in (
+        "#Top",
+        "WarnStuckClaimState",
+        "RESULT: KPROVE_PASSED",
+        "VALIDATED",
+        "[Error]",
+    ):
+        print(f"codex_output_marker[{marker}]={output.count(marker)}")
+
+    required_candidate_artifacts = [
+        "solution.py",
+        "solution.mpy",
+        "verification.k",
+        "spec.k",
+        "prove.sh",
+        "PROOF.md",
+    ]
+    for name in required_candidate_artifacts:
+        path = Path("/candidate") / name
+        require_direct_regular(path)
+        print(f"required_candidate_artifact={path} bytes={path.stat().st_size}")
+
+    print("INFRASTRUCTURE_GATE=PASS")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/k_concrete_tests.py b/evidence/k_concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..e06657660c568dcd7b9858c35d2112f4d69f7be9
--- /dev/null
+++ b/evidence/k_concrete_tests.py
@@ -0,0 +1,22 @@
+def will_it_fly(q, w):
+    return q == q[::-1] and sum(q) <= w
+
+
+# Prompt examples.
+assert will_it_fly([1, 2], 5) == False
+assert will_it_fly([3, 2, 3], 1) == False
+assert will_it_fly([3, 2, 3], 9) == True
+assert will_it_fly([3], 5) == True
+
+# Empty, sum threshold, palindrome boundary, and negative values.
+assert will_it_fly([], -1) == False
+assert will_it_fly([], 0) == True
+assert will_it_fly([1, 1], 1) == False
+assert will_it_fly([1, 1], 2) == True
+assert will_it_fly([1, 2], 3) == False
+assert will_it_fly([-4, 1, -4], -7) == True
+assert will_it_fly([-4, 1, -4], -8) == False
+
+# The supplied model's homogeneous-float branch and unbalanced short circuit.
+assert will_it_fly([1.5], 2.0) == True
+assert will_it_fly([1.0, 2.0], 5) == False
diff --git a/evidence/k_inventory.py b/evidence/k_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..6ae293d958675bfad13f130835530e0a1a272b3c
--- /dev/null
+++ b/evidence/k_inventory.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Emit a source-location inventory of every candidate and supplied K declaration."""
+
+from __future__ import annotations
+
+import csv
+import re
+from collections import Counter, defaultdict
+from pathlib import Path
+
+
+ROOTS = [
+    Path("/candidate/reference-semantics"),
+    Path("/candidate"),
+]
+TOP_LEVEL_K = set(Path("/candidate").glob("*.k"))
+FILES = sorted(Path("/candidate/reference-semantics").rglob("*.k")) + sorted(TOP_LEVEL_K)
+OUT = Path("/audit-output/evidence/rule-inventory.tsv")
+SUMMARY = Path("/audit-output/evidence/rule-inventory-summary.md")
+
+START = re.compile(r"^\s*(module|endmodule|configuration|syntax|context|rule|claim)\b")
+ATTRIBUTES = (
+    "function",
+    "total",
+    "functional",
+    "simplification",
+    "concrete",
+    "priority",
+    "owise",
+    "macro",
+    "strict",
+    "seqstrict",
+    "symbol",
+    "no-evaluators",
+    "preserves-definedness",
+)
+
+
+def without_line_comment(line: str) -> str:
+    return line.split("//", 1)[0]
+
+
+records: list[dict[str, str | int]] = []
+for path in FILES:
+    assert not path.is_symlink()
+    lines = path.read_text().splitlines()
+    starts: list[tuple[int, str]] = []
+    for index, line in enumerate(lines):
+        match = START.match(without_line_comment(line))
+        if match:
+            starts.append((index, match.group(1)))
+
+    for position, (index, kind) in enumerate(starts):
+        if kind == "endmodule":
+            continue
+        next_index = starts[position + 1][0] if position + 1 < len(starts) else len(lines)
+        block_lines = []
+        for line in lines[index:next_index]:
+            uncommented = without_line_comment(line).strip()
+            if uncommented:
+                block_lines.append(uncommented)
+        text = " ".join(block_lines)
+        flags = [attribute for attribute in ATTRIBUTES if re.search(rf"\b{re.escape(attribute)}\b", text)]
+        if kind == "rule":
+            if "simplification" in flags:
+                classification = "simplification-rule"
+            elif "<k>" in text or any(f"<{cell}>" in text for cell in (
+                "env", "scopes", "heap", "heapLoc", "stack", "ret", "exc", "exit-code"
+            )):
+                classification = "operational-rule"
+            else:
+                classification = "function-or-equational-rule"
+        elif kind == "syntax":
+            classification = "syntax-declaration"
+            if "no-evaluators" in flags:
+                classification += "+opaque-symbol"
+        elif kind == "claim":
+            classification = "reachability-claim"
+        else:
+            classification = kind
+        records.append(
+            {
+                "file": str(path),
+                "line": index + 1,
+                "kind": kind,
+                "classification": classification,
+                "attributes": ",".join(flags),
+                "declaration": text,
+            }
+        )
+
+with OUT.open("w", newline="") as stream:
+    writer = csv.DictWriter(
+        stream,
+        fieldnames=("file", "line", "kind", "classification", "attributes", "declaration"),
+        delimiter="\t",
+    )
+    writer.writeheader()
+    writer.writerows(records)
+
+by_file: dict[str, Counter[str]] = defaultdict(Counter)
+for record in records:
+    by_file[str(record["file"])][str(record["classification"])] += 1
+
+lines = [
+    "# Exhaustive K declaration inventory summary",
+    "",
+    f"Inventoried files: {len(FILES)}",
+    f"Inventoried declarations: {len(records)}",
+    "",
+    "| File | Syntax | Opaque syntax | Operational rules | Equational rules | Simplifications | Contexts | Claims |",
+    "|---|---:|---:|---:|---:|---:|---:|---:|",
+]
+for file_name in sorted(by_file):
+    counts = by_file[file_name]
+    lines.append(
+        "| "
+        + " | ".join(
+            [
+                file_name,
+                str(counts["syntax-declaration"] + counts["syntax-declaration+opaque-symbol"]),
+                str(counts["syntax-declaration+opaque-symbol"]),
+                str(counts["operational-rule"]),
+                str(counts["function-or-equational-rule"]),
+                str(counts["simplification-rule"]),
+                str(counts["context"]),
+                str(counts["reachability-claim"]),
+            ]
+        )
+        + " |"
+    )
+
+lines.extend(["", "## Global classification totals", ""])
+totals = Counter(str(record["classification"]) for record in records)
+for key, value in sorted(totals.items()):
+    lines.append(f"- {key}: {value}")
+SUMMARY.write_text("\n".join(lines) + "\n")
+
+print(f"files={len(FILES)}")
+print(f"declarations={len(records)}")
+for key, value in sorted(totals.items()):
+    print(f"{key}={value}")
+print(f"inventory={OUT}")
+print(f"summary={SUMMARY}")
