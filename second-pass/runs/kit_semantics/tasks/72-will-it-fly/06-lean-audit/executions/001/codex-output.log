+#eval (Proof.isInt (kOf otherVal), Proof.isBool (kOf otherVal),
+  Proof.isFloat (kOf otherVal))
+
+#eval (Proof.«integralV(_)_VERIFICATION-SYNTAX_Bool_Val» intNeg,
