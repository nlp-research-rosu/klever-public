+#eval (Proof.«project:Bool» (kOf boolFalse), Proof.projectBoolTotal boolFalse,
+  Proof.«project:Bool?» (kOf boolFalse))
+#eval (Proof.«project:Float» (kOf floatVal), Proof.projectFloatTotal floatVal,
