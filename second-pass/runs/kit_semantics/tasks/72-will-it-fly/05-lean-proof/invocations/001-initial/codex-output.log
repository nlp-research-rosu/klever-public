+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <sys/auxv.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn original = NULL;
+  if (original == NULL) {
+    original = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    const char *executable = (const char *)getauxval(AT_EXECFN);
+    if (executable != NULL) {
+      size_t executable_length = strlen(executable);
+      size_t copied = executable_length < size ? executable_length : size;
+      memcpy(buffer, executable, copied);
+      return (ssize_t)copied;
+    }
+  }
+
+  return original(path, buffer, size);
+}
