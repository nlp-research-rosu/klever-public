import json
inv_path='/reference/rule-inventory.json'
out_path='/workspace/trust-boundary.json'
with open(inv_path) as f: inv=json.load(f)
with open(out_path) as f: out=json.load(f)
assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
inv_ids=[r['source_rule_id'] for r in inv['rules']]
out_ids=[]
for i,r in enumerate(out['rules']):
    assert list(r.keys()) == ['source_rule_id','classification','rationale'], (i,list(r.keys()))
    assert r['classification'] in allowed, (i,r['classification'])
    assert isinstance(r['rationale'],str) and r['rationale'].strip(), i
    out_ids.append(r['source_rule_id'])
assert out_ids == inv_ids
assert len(set(out_ids)) == len(out_ids)
print('schema=valid')
print('inventory_sha256=' + out['inventory_sha256'])
print('rules=' + str(len(out_ids)))
for c in sorted(allowed):
    print(c + '=' + str(sum(r['classification']==c for r in out['rules'])))
