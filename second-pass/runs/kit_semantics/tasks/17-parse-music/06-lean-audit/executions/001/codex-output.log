/bin/bash -lc "PYTHONPATH=/reference python3 - <<'PY' | tee /audit-output/evidence/hash-reconciliation.json
import hashlib, json
from pathlib import Path
from tools import pipeline_contract
from tools.klean_export import tree_digest
from tools.stage6_resolution_contract import verify_audit_input
ai_path = Path('/audit-input.json')
ai = json.loads(ai_path.read_text())
resolution, resolved_digest = verify_audit_input(ai)
h = resolution['hashes']
actual_source_hashes = {
 p.relative_to(Path('/reference/k-proof')).as_posix(): pipeline_contract.sha256_file(p)
 for p in pipeline_contract._walk_regular_files(Path('/reference/k-proof'), 'Stage 1 source workspace')
}
expected_source_hashes = resolution['stage1_source_hashes']
checks = {
 'resolved_input_sha256': {'expected': ai['resolved_input_sha256'], 'actual': resolved_digest},
 'discovery_manifest_sha256': {'expected': h['discovery_manifest_sha256'], 'actual': pipeline_contract.sha256_file(Path('/reference/lemma-discovery.json'))},
 'generated_tree_sha256': {'expected': h['generated_tree_sha256'], 'actual': tree_digest(Path('/reference/klean-generation/generated'))},
 'generation_producer_sources_sha256': {'expected': h['generation_producer_sources_sha256'], 'actual': pipeline_contract.sha256_tree(Path('/reference/generation-tools'))},
 'k_audit_sha256': {'expected': h['k_audit_sha256'], 'actual': pipeline_contract.sha256_tree(Path('/reference/k-audit'))},
 'k_workspace_sha256': {'expected': h['k_workspace_sha256'], 'actual': pipeline_contract.sha256_tree(Path('/reference/k-proof'))},
 'klean_generation_sha256': {'expected': h['klean_generation_sha256'], 'actual': pipeline_contract.sha256_tree(Path('/reference/klean-generation'))},
 'stage1_export_sha256': {'expected': h['stage1_export_sha256'], 'actual': tree_digest(Path('/reference/k-proof'))},
 'lean_invocation_sha256': {'expected': h['lean_invocation_sha256'], 'actual': None},
 'lean_workspace_sha256': {'expected': h['lean_workspace_sha256'], 'actual': None},
}
for item in checks.values(): item['match'] = item['expected'] == item['actual']
result = {
 'audit_mode_file': resolution['mode'],
 'audit_mode_env': __import__('os').environ.get('AUDIT_MODE'),
 'audit_mode_match': resolution['mode'] == __import__('os').environ.get('AUDIT_MODE'),
 'checks': checks,
 'all_recorded_tree_and_file_hashes_match': all(x['match'] for x in checks.values()),
 'stage1_source_hash_count_expected': len(expected_source_hashes),
 'stage1_source_hash_count_actual': len(actual_source_hashes),
 'stage1_source_hashes_exact_match': expected_source_hashes == actual_source_hashes,
 'stage1_source_missing': sorted(set(expected_source_hashes) - set(actual_source_hashes)),
 'stage1_source_extra': sorted(set(actual_source_hashes) - set(expected_source_hashes)),
 'stage1_source_mismatched': sorted(k for k in set(expected_source_hashes) & set(actual_source_hashes) if expected_source_hashes[k] "'!= actual_source_hashes[k]),
}
print(json.dumps(result, indent=2, sort_keys=True))
