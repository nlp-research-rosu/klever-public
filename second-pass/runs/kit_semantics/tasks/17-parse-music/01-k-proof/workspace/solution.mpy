Module(
  ImportFrom("typing", "List")
  FuncDef("parse_music", Params("music_string"),
    Assign(Name("result"), ListExpr())
    Assign(Name("current"), Int(0))
    For(Name("char"), Name("music_string"),
      If(Compare(Name("char"), CmpOp("==", Str("o"))),
        Assign(Name("current"), Int(4)),
        If(Compare(Name("char"), CmpOp("==", Str("."))),
          Assign(Name("current"), Int(1)),
          If(Compare(Name("char"), CmpOp("==", Str("|"))),
            If(Compare(Name("current"), CmpOp("==", Int(4))),
              Assign(Name("current"), Int(2)),
              )
            Expr(
              Call(Attribute(Name("result"), "append"), Name("current")))
            Assign(Name("current"), Int(0)),
            If(Compare(Name("current"), CmpOp("==", Int(4))),
              Expr(
                Call(
                  Attribute(Name("result"), "append"),
                  Name("current"))),
              )
            Assign(Name("current"), Int(0))))))
    If(Compare(Name("current"), CmpOp("==", Int(4))),
      Expr(Call(Attribute(Name("result"), "append"), Name("current"))),
      )
    Return(Name("result"))))
