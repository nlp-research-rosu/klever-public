+    line_count = 0
+    type_counts: dict[str, int] = {}
+    for trace in trace_files:
+        with trace.open() as stream:
+            for line_number, line in enumerate(stream, 1):
+                record = json.loads(line)
+                assert isinstance(record, dict) and "type" in record
