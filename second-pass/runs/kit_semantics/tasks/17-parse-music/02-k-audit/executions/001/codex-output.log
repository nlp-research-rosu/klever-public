+    <heap> .Map => 0 |-> list(
+      vCons(4, vCons(2, vCons(2, .ValSeq)))) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
