+      => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        "parse_music" |-> closureVal(
+          "music_string" , .ParamNames,
+          parseMusicBody,
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
