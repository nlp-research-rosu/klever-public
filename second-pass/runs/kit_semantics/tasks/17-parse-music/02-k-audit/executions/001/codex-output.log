+        ("music_string" |-> str(.IntSeq)
+         "result"       |-> ref(2)
+         "current"      |-> 0
+         "char"         |-> str(.IntSeq))
+        =>
+        ("music_string" |-> str(.IntSeq)
+         "result"       |-> ref(2)
+         "current"      |-> 0
+         "char"         |-> ?FINALCHAR:Str),
+        parent(-1)) ... </scopes>
+    <heap> ... 2 |-> list(.ValSeq => .ValSeq) ... </heap>
+endmodule
