+++ b/evidence/concrete-substitution.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module CONCRETE-SUBSTITUTION
+  imports VERIFICATION
+
+  // Satisfying entry state with CS = [65] ("A"); mapSwap([65]) = [97] ("a").
+  claim [capital-a]:
+    <k>
+      #loadAll(Module(
+        FuncDef("flip_case", Params("string"),
+          Return(Call(Attribute(Name("string"), "swapcase"), .Exprs))
+      ))) ~> Call(Name("flip_case"), str(iCons(65, .IntSeq)))
+      =>
+      str(iCons(97, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "flip_case" |->
+                closureVal(
+                  ("string", .ParamNames),
+                  Return(Call(Attribute(Name("string"), "swapcase"), .Exprs)) .Stmts,
+                  0
+                ),
+              parent(-1)
+            )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
