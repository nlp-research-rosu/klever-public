+      0  |-> scope(
+              "flip_case" |->
+                closureVal(
+                  ("string", .ParamNames),
+                  Return(Call(Attribute(Name("string"), "swapcase"), .Exprs)) .Stmts,
+                  0
+                ),
+              parent(-1)
+            )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
