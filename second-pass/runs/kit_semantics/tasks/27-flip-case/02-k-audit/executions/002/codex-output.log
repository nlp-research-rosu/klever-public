+print(f"trace_manifest_tree_sha256={trace_manifest_hash}")
+print(
+    "trace_matches_usage_source="
+    f"{trace_manifest_hash == json.loads(Path('/generation-evidence/usage.json').read_text())['source_trace_sha256']}"
