from pathlib import Path
import hashlib,itertools,os,stat
cases=[(Path('/reference/reference-semantics'),'1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de'),(Path('/generation-evidence/codex-trace'),'5fcb822d1dc0341d75aea8bb9ad108041e8f66ba6b7bf9263b6bfeaa2710aa38')]

def ents(root,incdirs):
 out=[]
 for p in sorted(root.rglob('*')):
  if p.is_dir():
   if incdirs: out.append((p.relative_to(root).as_posix(),'dir',b''))
  elif p.is_file():out.append((p.relative_to(root).as_posix(),'file',p.read_bytes()))
 return out
seps=[b'',b'\\0',b'\\n',b' ',b':',b'\\t']
relstyles=lambda r:[r.encode(),('./'+r).encode(),('/'+r).encode()]
kindstyles={'file':[b'',b'file',b'f',b'F',b'100644'], 'dir':[b'',b'directory',b'dir',b'd',b'D',b'040755']}
datastyles=lambda b:[b,hashlib.sha256(b).digest(),hashlib.sha256(b).hexdigest().encode(),str(len(b)).encode()+b, len(b).to_bytes(8,'big')+b]
# forms: rel s1 kind s2 data s3, kind s1 rel s2 data s3, rel s1 data s2 kind s3
