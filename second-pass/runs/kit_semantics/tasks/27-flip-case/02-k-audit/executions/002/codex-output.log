--- /dev/null
+++ b/evidence/model-gap-witness.k
@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module MODEL-GAP-WITNESS
+  imports VERIFICATION
+
+  // The fixed model can hold code point 233 in its internal IntSeq string
+  // representation, but its supplied ASCII-only swapC leaves that value intact.
+  claim [modeled-u00e9]:
+    <k>
+      #loadAll(Module(
+        FuncDef("flip_case", Params("string"),
+          Return(Call(Attribute(Name("string"), "swapcase"), .Exprs))
+      ))) ~> Call(Name("flip_case"), str(iCons(233, .IntSeq)))
+      =>
+      str(iCons(233, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "flip_case" |->
+                closureVal(
+                  ("string", .ParamNames),
+                  Return(Call(Attribute(Name("string"), "swapcase"), .Exprs)) .Stmts,
+                  0
+                ),
+              parent(-1)
+            )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/runtime_cases.py b/evidence/runtime_cases.py
new file mode 100644
index 0000000000000000000000000000000000000000..0861cb46a77773ea5247c35cb96f52cf371d5a79
--- /dev/null
+++ b/evidence/runtime_cases.py
@@ -0,0 +1,8 @@
+def flip_case(string: str) -> str:
+    return string.swapcase()
+
+
+assert flip_case("") == ""
+assert flip_case("Hello") == "hELLO"
+assert flip_case("@AZ[`az{") == "@az[`AZ{"
+assert flip_case("aZ 123!?") == "Az 123!?"

exec
/bin/bash -lc "cp -a /audit-output/evidence/runtime_cases.py /tmp/audit-work/rebuild/runtime_cases.py
cp -a /audit-output/evidence/model-gap-witness.k /tmp/audit-work/rebuild/model-gap-witness.k
python3 py2mpy.py runtime_cases.py > runtime_cases.mpy
sha256sum runtime_cases.py runtime_cases.mpy
bash -c '
printf \"%s\\n\" \"COMMAND: kompile --backend llvm reference-semantics/semantics.k --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition runtime-kompiled-fresh\"
kompile --backend llvm reference-semantics/semantics.k --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition runtime-kompiled-fresh
build_status="'$?
printf "COMMAND_EXIT_STATUS=%s'"\\n\" \""'$build_status"
exit "$build_status"
'"' > /audit-output/evidence/llvm-build.log 2>&1" in /tmp/audit-work/rebuild
