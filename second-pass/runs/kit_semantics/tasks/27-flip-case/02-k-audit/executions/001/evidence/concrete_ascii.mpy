Module(
  FuncDef("flip_case", Params("string"),
    Return(Call(Attribute(Name("string"), "swapcase"), )))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("Hello")),
      CmpOp("==", Str("hELLO"))))
  Assert(
    Compare(Call(Name("flip_case"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("@AZ[`az{")),
      CmpOp("==", Str("@az[`AZ{"))))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("aZ 123!?")),
      CmpOp("==", Str("Az 123!?")))))
