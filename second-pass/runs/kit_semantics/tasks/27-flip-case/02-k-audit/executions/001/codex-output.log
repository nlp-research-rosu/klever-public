/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/03-krun-solution.log krun solution.mpy --definition audit-runtime-kompiled; s1=$?; /audit-output/evidence/run_logged.sh /audit-output/evidence/03-krun-ascii.log krun concrete_ascii.mpy --definition audit-runtime-kompiled; s2=$?; tail -n 30 /audit-output/evidence/03-krun-solution.log; tail -n 30 /audit-output/evidence/03-krun-ascii.log; if [[ $s1 -ne 0 || $s2 -ne 0 ]]; then exit 1; fi' in /tmp/audit-work/27-flip-case
