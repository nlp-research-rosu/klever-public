index 0000000000000000000000000000000000000000..f5f483f626e4a07f1e260d4bf46fe686b0fe80bb
--- /dev/null
+++ b//tmp/audit-work/27-flip-case/concrete_ascii.py
@@ -0,0 +1,8 @@
+def flip_case(string: str) -> str:
+    return string.swapcase()
+
+
+assert flip_case("Hello") == "hELLO"
+assert flip_case("") == ""
+assert flip_case("@AZ[`az{") == "@az[`AZ{"
+assert flip_case("aZ 123!?") == "Az 123!?"
