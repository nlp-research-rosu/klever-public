index 0000000000000000000000000000000000000000..25959ab39fcdcc70f172320e24966678d0e14b02
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,7 @@
+def flip_case(string: str) -> str:
+    return string.swapcase()
+
+
+assert flip_case("Hello") == "hELLO"
+assert flip_case("") == ""
+assert flip_case("aZ 123!?") == "Az 123!?"
