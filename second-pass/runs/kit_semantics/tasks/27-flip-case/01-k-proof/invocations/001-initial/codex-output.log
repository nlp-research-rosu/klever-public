diff --git a/model_boundary.py b/model_boundary.py
new file mode 100644
index 0000000000000000000000000000000000000000..e65ac08d91e76aed024e1e155373a22096353e57
--- /dev/null
+++ b/model_boundary.py
@@ -0,0 +1,7 @@
+def flip_case(string: str) -> str:
+    return string.swapcase()
+
+
+# The supplied K semantics models case conversion as ASCII-only, so U+00E9 is
+# left unchanged there. CPython instead maps it to U+00C9.
+assert flip_case(chr(233)) == chr(233)
