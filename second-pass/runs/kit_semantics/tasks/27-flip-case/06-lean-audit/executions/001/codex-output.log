+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  ssize_t length = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (length < 0) {
+    fprintf(stderr, "readlink failed: errno=%d %s\n", errno, strerror(errno));
+    return 1;
+  }
+  path[length] = '\0';
+  printf("%s\n", path);
+  return 0;
+}
