     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py smoke.py > smoke.mpy
     6	python3 py2mpy.py model_boundary.py > model_boundary.mpy
     7	python3 -m py_compile solution.py test_solution.py
     8	
     9	kompile --backend llvm reference-semantics/semantics.k \
    10	  --main-module MPY-KRUN \
    11	  --syntax-module MPY-SYNTAX \
    12	  --output-definition runtime-kompiled
    13	
    14	krun solution.mpy --definition runtime-kompiled
    15	krun smoke.mpy --definition runtime-kompiled
    16	python3 test_solution.py
    17	
    18	# Expected model-boundary failure: the supplied semantics only constructs
    19	# ASCII characters, whereas CPython strings and swapcase are Unicode-aware.
    20	set +e
    21	krun model_boundary.mpy --definition runtime-kompiled
    22	boundary_status=$?
    23	set -e
    24	printf 'MODEL_BOUNDARY_EXIT=%s (expected non-zero)\n' "$boundary_status"
    25	if [[ "$boundary_status" -eq 0 ]]; then
    26	  echo "ERROR: the non-ASCII model-boundary probe unexpectedly succeeded" >&2
    27	  exit 1
    28	fi
    29	python3 -c 'print("CPython boundary:", "é".swapcase(), [ord(c) for c in "é".swapcase()])'
    30	
    31	kompile --backend haskell verification.k \
    32	  --main-module VERIFICATION \
    33	  --syntax-module MPY-SYNTAX \
    34	  --output-definition verification-kompiled
    35	
    36	# Required positive, full-domain target proof.
    37	kprove spec.k \
    38	  --definition verification-kompiled \
    39	  --spec-module SPEC
    40	
    41	# Expected Gate A failures: the proof must reject a false result and a
    42	# materially changed function body.
    43	set +e
    44	kprove spec-vacuity.k \
    45	  --definition verification-kompiled \
    46	  --spec-module SPEC-VACUITY
    47	vacuity_status=$?
    48	kprove spec-body-mutation.k \
    49	  --definition verification-kompiled \
    50	  --spec-module SPEC-BODY-MUTATION
    51	body_status=$?
    52	set -e
    53	
    54	printf 'VACUITY_EXIT=%s (expected non-zero)\n' "$vacuity_status"
    55	printf 'BODY_MUTATION_EXIT=%s (expected non-zero)\n' "$body_status"
    56	if [[ "$vacuity_status" -eq 0 || "$body_status" -eq 0 ]]; then
    57	  echo "ERROR: a negative proof probe unexpectedly succeeded" >&2
    58	  exit 1
    59	fi

