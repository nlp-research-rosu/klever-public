+  "stage1_workspace_sha256": "82d7cf8eaaa88f794130c35824c0c1c6e7cebb8cd3574bf0098d4415a4f50c26",
+  "stage3_discovery_manifest_sha256": "e13c01259eb807dd465c4db3e29a0727d9ce0eb8df88d145e8977e70f5b7fcf3",
+  "status": "KLEAN_NO_OBLIGATIONS",
+  "target": null,
+  "trust_declaration_count": 41
+}
