diff --git a//tmp/audit-work/proc_self_compat.c b//tmp/audit-work/proc_self_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..483a538b83a903381ae312856644e904d4a2e654
--- /dev/null
+++ b//tmp/audit-work/proc_self_compat.c
@@ -0,0 +1,35 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox exposes a host-mounted /proc while getpid() reports the
+ * inner namespace PID. Lean/libuv therefore asks for /proc/<inner-pid>/exe,
+ * which does not exist. Preserve readlink semantics and redirect only that
+ * exact Linux executable-self lookup to the namespace-safe /proc/self/exe.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+
+  const char *cursor = path;
+  if (strncmp(cursor, "/proc/", 6) == 0) {
+    cursor += 6;
+    const char *digits = cursor;
+    while (isdigit((unsigned char)*cursor)) {
+      ++cursor;
+    }
+    if (
+      cursor > digits
+      && strcmp(cursor, "/exe") == 0
+    ) {
+      path = "/proc/self/exe";
+    }
+  }
+  return real_readlink(path, buffer, size);
+}
diff --git a//tmp/audit-work/readlink_probe.c b//tmp/audit-work/readlink_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..9a406e8e0e38908401f5c1445e00e813628c6764
--- /dev/null
+++ b//tmp/audit-work/readlink_probe.c
@@ -0,0 +1,16 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  ssize_t length = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (length < 0) {
+    fprintf(stderr, "readlink failed: errno=%d %s\n", errno, strerror(errno));
+    return 1;
+  }
+  path[length] = '\0';
+  printf("%s\n", path);
+  return 0;
+}
diff --git a//tmp/audit-work/readlink_trace.c b//tmp/audit-work/readlink_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..c512749bc892bfca99b632c8c43c95b73dcf850a
--- /dev/null
+++ b//tmp/audit-work/readlink_trace.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  ssize_t result = real_readlink(path, buffer, size);
+  dprintf(
+    STDERR_FILENO,
+    "TRACE readlink path=%s size=%zu result=%zd\n",
+    path,
+    size,
+    result
+  );
+  return result;
+}
diff --git a//tmp/audit-work/uv_exepath_probe.c b//tmp/audit-work/uv_exepath_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..3052c971953916ac4c6b3f768f1d77696b5a3455
--- /dev/null
+++ b//tmp/audit-work/uv_exepath_probe.c
@@ -0,0 +1,25 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <stddef.h>
+
+extern int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+  char path[4096];
+  size_t length = sizeof(path);
+  int result = uv_exepath(path, &length);
+  if (result != 0) {
+    fprintf(
+      stderr,
+      "uv_exepath failed: result=%d errno=%d %s size=%zu\n",
+      result,
+      errno,
+      strerror(errno),
+      length
+    );
+    return 1;
+  }
+  printf("path=%s size=%zu\n", path, length);
+  return 0;
+}
