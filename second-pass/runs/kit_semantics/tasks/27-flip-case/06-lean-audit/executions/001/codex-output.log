+                "lean_invocation": audit["lean_invocation"],
+                "candidate_exists": candidate_exists,
+            },
+        )
+    )
+
+    print("OVERALL=" + ("PASS" if all(results) else "FAIL"))
+    return 0 if all(results) else 1
+
