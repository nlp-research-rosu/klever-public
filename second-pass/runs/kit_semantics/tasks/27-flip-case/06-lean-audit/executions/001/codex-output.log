index 0000000000000000000000000000000000000000..fd60ad02774a11c21e1968373a230a0e86d96ce6
--- /dev/null
+++ b/evidence/05-preflight-initial-failure.log
@@ -0,0 +1,17 @@
+COMMAND
+PYTHONPATH=/reference python3 -c 'import json; from pathlib import Path; from tools.klean_preflight import check_generation; result=check_generation(Path("/reference/k-proof"), Path("/reference/lemma-discovery.json"), Path("/reference/klean-generation"), toolchain_lock=Path("/reference/klean-toolchain.lock.json")); print(json.dumps(result, indent=2, sort_keys=True))'
+
+OUTPUT
+Traceback (most recent call last):
+  File "<string>", line 1, in <module>
+  File "/reference/tools/klean_preflight.py", line 582, in check_generation
+    raise KleanPreflightError(
+tools.klean_preflight.KleanPreflightError: lake clean failed (1): error: could not detect the configuration of the Lake installation
+
+DIAGNOSIS
+The sandbox's getpid() reports an inner namespace PID, while its /proc mount
+does not expose /proc/<inner-pid>/exe. Lean/libuv therefore failed its
+executable-self lookup. A readlink interposition trace returned:
+
+TRACE readlink path=/proc/8/exe size=4096 result=-1
+error: failed to locate application
diff --git a/evidence/06-lean-environment-repair.log b/evidence/06-lean-environment-repair.log
new file mode 100644
index 0000000000000000000000000000000000000000..3005a55f001e7fbfb1d9d2adcc34c3b0ccaffcc2
--- /dev/null
+++ b/evidence/06-lean-environment-repair.log
@@ -0,0 +1,13 @@
+COMMAND
+gcc -shared -fPIC /tmp/audit-work/proc_self_compat.c -ldl -o /tmp/audit-work/proc_self_compat.so
+LD_PRELOAD=/tmp/audit-work/proc_self_compat.so lean --version
+LD_PRELOAD=/tmp/audit-work/proc_self_compat.so lake --version
+
+OUTPUT
+Lean (version 4.22.0, x86_64-unknown-linux-gnu, commit ba2cbbf09d4978f416e0ebd1fceeebc2c4138c05, Release)
+Lake version 5.0.0-src+ba2cbbf (Lean version 4.22.0)
+
+The compatibility source is /tmp/audit-work/proc_self_compat.c. It redirects
+only readlink("/proc/<numeric-pid>/exe", ...) to
+readlink("/proc/self/exe", ...); it does not alter Lean source, proof terms,
+or generated project content.
