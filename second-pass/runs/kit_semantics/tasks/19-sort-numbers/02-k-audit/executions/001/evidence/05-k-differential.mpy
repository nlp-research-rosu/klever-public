Module(
  FuncDef("_number_key", Params("number"),
    Return(
      Call(
        Attribute(
          TupleExpr(
            Str("zero"),
            Str("one"),
            Str("two"),
            Str("three"),
            Str("four"),
            Str("five"),
            Str("six"),
            Str("seven"),
            Str("eight"),
            Str("nine")),
          "index"),
        Name("number"))))
  FuncDef("sort_numbers", Params("numbers"),
    Return(
      Call(
        Attribute(Str(" "), "join"),
        Call(
          Name("sorted"),
          Call(Attribute(Name("numbers"), "split"), ),
          KwArg("key", Name("_number_key"))))))
