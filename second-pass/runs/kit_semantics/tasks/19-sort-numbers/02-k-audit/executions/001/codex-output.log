+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(splitWS(CS, .IntSeq, .ValSeq))
+      1 |-> list(sortKeyVS(
+                    splitWS(CS, .IntSeq, .ValSeq),
+                    numberKeyClosure))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumberWords(splitWS(CS, .IntSeq, .ValSeq))
+endmodule
