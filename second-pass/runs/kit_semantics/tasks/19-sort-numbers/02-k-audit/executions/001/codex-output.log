      "expected_closure_term": "closureVal((\"numbers\",.ParamNames),(Return(Call(Attribute(Str(\"\"),\"join\"),Call(Name(\"sorted\"),Call(Attribute(Name(\"numbers\"),\"split\"),.Exprs),KwArg(\"key\",Name(\"_number_key\"))))).Stmts),0)",
      "actual_closure_term": "closureVal((\"numbers\",.ParamNames),(Return(Call(Attribute(Str(\"\"),\"join\"),Call(Name(\"sorted\"),Call(Attribute(Name(\"numbers\"),\"split\"),.Exprs),KwArg(\"key\",Name(\"_number_key\"))))).Stmts),0)",
      "constructor_match": true
