      "actual_closure_term": "closureVal((\"number\",.ParamNames),(Return(Call(Attribute(TupleExpr(Str(\"zero\"),Str(\"one\"),Str(\"two\"),Str(\"three\"),Str(\"four\"),Str(\"five\"),Str(\"six\"),Str(\"seven\"),Str(\"eight\"),Str(\"nine\")),\"index\"),Name(\"number\"))).Stmts),0)",
      "constructor_match": true
