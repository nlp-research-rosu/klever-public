+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "_number_key" |-> closureVal(
+                                    ("number", .ParamNames),
+                                    (Return(Int(9)) .Stmts),
+                                    0)
+             "sort_numbers" |-> sortNumbersClosure,
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(splitWS(CS, .IntSeq, .ValSeq))
+      1 |-> list(sortKeyVS(
