@@ -0,0 +1,59 @@
+def _number_key(number: str) -> int:
+    return (
+        "zero",
+        "one",
+        "two",
+        "three",
+        "four",
+        "five",
+        "six",
+        "seven",
+        "eight",
+        "nine",
+    ).index(number)
+
+
+def sort_numbers(numbers: str) -> str:
+    return " ".join(sorted(numbers.split(), key=_number_key))
+
+
+def counting_oracle(numbers: str) -> str:
+    result = []
+    for word in (
+        "zero",
+        "one",
+        "two",
+        "three",
+        "four",
+        "five",
+        "six",
+        "seven",
+        "eight",
+        "nine",
+    ):
+        for item in numbers.split():
+            if item == word:
+                result.append(item)
+    return " ".join(result)
