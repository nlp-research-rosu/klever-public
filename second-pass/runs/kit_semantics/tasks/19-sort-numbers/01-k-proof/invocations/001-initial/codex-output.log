/bin/bash -lc "sed -n '150,280p' py2mpy.py && sed -n '280,380p' py2mpy.py && rg -n \"split|join|applyMethod|boundMethodV\" reference-semantics/semantics/*.k && sed -n '1,320p' reference-semantics/semantics/methods.k && sed -n '1,140p' reference-semantics/semantics/call.k && sed -n '1,130p' reference-semantics/semantics/dict.k" in /workspace
