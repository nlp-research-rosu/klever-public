+  rule numberKeyClosure
+    => closureVal(
+         ("number", .ParamNames),
+         (Return(
+            Call(
+              Attribute(
+                TupleExpr(
+                  Str("zero"),
+                  Str("one"),
+                  Str("two"),
+                  Str("three"),
+                  Str("four"),
+                  Str("five"),
+                  Str("six"),
+                  Str("seven"),
+                  Str("eight"),
+                  Str("nine")),
+                "index"),
+              Name("number"))) .Stmts),
+         0)
+
+  syntax Val ::= "sortNumbersClosure" [macro]
+  rule sortNumbersClosure
+    => closureVal(
+         ("numbers", .ParamNames),
+         (Return(
+            Call(
+              Attribute(Str(" "), "join"),
+              Call(
+                Name("sorted"),
+                Call(Attribute(Name("numbers"), "split"), .Exprs),
+                KwArg("key", Name("_number_key"))))) .Stmts),
