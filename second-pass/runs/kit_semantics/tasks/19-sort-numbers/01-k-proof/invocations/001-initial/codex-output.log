+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(splitWS(CS, .IntSeq, .ValSeq))
+      1 |-> list(sortKeyVS(
+                    splitWS(CS, .IntSeq, .ValSeq),
