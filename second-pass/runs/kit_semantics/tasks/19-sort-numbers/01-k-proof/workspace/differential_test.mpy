Module(
  FuncDef("_number_key", Params("number"),
    Return(
      Call(
        Attribute(
          TupleExpr(
            Str("zero"),
            Str("one"),
            Str("two"),
            Str("three"),
            Str("four"),
            Str("five"),
            Str("six"),
            Str("seven"),
            Str("eight"),
            Str("nine")),
          "index"),
        Name("number"))))
  FuncDef("sort_numbers", Params("numbers"),
    Return(
      Call(
        Attribute(Str(" "), "join"),
        Call(
          Name("sorted"),
          Call(Attribute(Name("numbers"), "split"), ),
          KwArg("key", Name("_number_key"))))))
  FuncDef("counting_oracle", Params("numbers"),
    Assign(Name("result"), ListExpr())
    For(Name("word"), TupleExpr(
      Str("zero"),
      Str("one"),
      Str("two"),
      Str("three"),
      Str("four"),
      Str("five"),
      Str("six"),
      Str("seven"),
      Str("eight"),
      Str("nine")),
      For(Name("item"), Call(Attribute(Name("numbers"), "split"), ),
        If(Compare(Name("item"), CmpOp("==", Name("word"))),
          Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
          )))
    Return(Call(Attribute(Str(" "), "join"), Name("result"))))
  Assign(
    Name("cases"),
    ListExpr(
      Str(""),
      Str("zero"),
      Str("nine"),
      Str("three one five"),
      Str("nine zero nine"),
      Str("one one one"),
      Str("nine eight seven six five four three two one zero"),
      Str("zero one two three four five six seven eight nine"),
      Str("five zero four one three two"),
      Str("eight two eight two zero"),
      Str("  three   one five  "),
      Str("zero nine one eight two seven three six four five"),
      Str(
        "six six five five four four three three two two one one zero zero"),
      Str("nine zero eight one seven two six three five four"),
      Str("two seven one eight zero nine three six four five two seven")))
  For(Name("case"), Name("cases"),
    Assert(
      Compare(
        Call(Name("sort_numbers"), Name("case")),
        CmpOp("==", Call(Name("counting_oracle"), Name("case")))))))
