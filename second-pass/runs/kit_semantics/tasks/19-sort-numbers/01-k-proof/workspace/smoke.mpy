Module(
  FuncDef("_number_key", Params("number"),
    Return(
      Call(
        Attribute(
          TupleExpr(
            Str("zero"),
            Str("one"),
            Str("two"),
            Str("three"),
            Str("four"),
            Str("five"),
            Str("six"),
            Str("seven"),
            Str("eight"),
            Str("nine")),
          "index"),
        Name("number"))))
  FuncDef("sort_numbers", Params("numbers"),
    Return(
      Call(
        Attribute(Str(" "), "join"),
        Call(
          Name("sorted"),
          Call(Attribute(Name("numbers"), "split"), ),
          KwArg("key", Name("_number_key"))))))
  Assert(
    Compare(Call(Name("sort_numbers"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("three one five")),
      CmpOp("==", Str("one three five"))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("nine zero nine")),
      CmpOp("==", Str("zero nine nine"))))
  Assert(
    Compare(
      Call(
        Name("sort_numbers"),
        Str("nine eight seven six five four three two one zero")),
      CmpOp(
        "==",
        Str("zero one two three four five six seven eight nine")))))
