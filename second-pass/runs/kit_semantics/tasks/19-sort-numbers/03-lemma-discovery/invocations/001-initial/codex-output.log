requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Exact values installed by loading solution.mpy.
  syntax Val ::= "numberKeyClosure" [macro]
  rule numberKeyClosure
    => closureVal(
         ("number", .ParamNames),
         (Return(
            Call(
              Attribute(
                TupleExpr(
                  Str("zero"),
                  Str("one"),
                  Str("two"),
                  Str("three"),
                  Str("four"),
                  Str("five"),
                  Str("six"),
                  Str("seven"),
                  Str("eight"),
                  Str("nine")),
                "index"),
              Name("number"))) .Stmts),
         0)

  syntax Val ::= "sortNumbersClosure" [macro]
  rule sortNumbersClosure
    => closureVal(
         ("numbers", .ParamNames),
         (Return(
            Call(
              Attribute(Str(" "), "join"),
              Call(
                Name("sorted"),
                Call(Attribute(Name("numbers"), "split"), .Exprs),
                KwArg("key", Name("_number_key"))))) .Stmts),
         0)

  // The source contract's input predicate: every token produced by Python's
  // whitespace split is one of the ten allowed numeral words.
  syntax Bool ::= isNumberWord(Val) [function, total]
  rule isNumberWord(V)
    => V ==K str(strToCodes("zero"))
       orBool V ==K str(strToCodes("one"))
       orBool V ==K str(strToCodes("two"))
       orBool V ==K str(strToCodes("three"))
       orBool V ==K str(strToCodes("four"))
       orBool V ==K str(strToCodes("five"))
       orBool V ==K str(strToCodes("six"))
       orBool V ==K str(strToCodes("seven"))
       orBool V ==K str(strToCodes("eight"))
       orBool V ==K str(strToCodes("nine"))

  syntax Bool ::= allNumberWords(ValSeq) [function, total]
  rule allNumberWords(.ValSeq) => true
  rule allNumberWords(vCons(V:Val, REST:ValSeq))
    => isNumberWord(V) andBool allNumberWords(REST)

  // Exact symbolic result under MPY's named sortKeyVS primitive.
  syntax Str ::= expectedSortNumbers(IntSeq) [function, total]
  rule expectedSortNumbers(CS)
    => str(
         joinCodes(
           strToCodes(" "),
           sortKeyVS(
             splitWS(CS, .IntSeq, .ValSeq),
             numberKeyClosure)))
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 -m py_compile solution.py

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

python3 py2mpy.py smoke.py > smoke.mpy
krun smoke.mpy --definition runtime-kompiled --output none

python3 differential_test.py
python3 py2mpy.py differential_test.py > differential_test.mpy
krun differential_test.mpy --definition runtime-kompiled --output none

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.sort-numbers

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY > vacuity.out 2>&1; then
  echo "ERROR: the deliberately false result mutation unexpectedly proved" >&2
  exit 1
else
  status=$?
  rg -q "WarnStuckClaimState" vacuity.out
  echo "expected vacuity-probe failure: exit ${status}"
fi

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION > body-mutation.out 2>&1; then
  echo "ERROR: the mutated helper body unexpectedly proved" >&2
  exit 1
else
  status=$?
  rg -q "WarnStuckClaimState" body-mutation.out
  echo "expected body-mutation failure: exit ${status}"
fi
