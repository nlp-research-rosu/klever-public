     1	def _number_key(number: str) -> int:
     2	    return (
     3	        "zero",
     4	        "one",
     5	        "two",
     6	        "three",
     7	        "four",
     8	        "five",
     9	        "six",
    10	        "seven",
    11	        "eight",
    12	        "nine",
    13	    ).index(number)
    14	
    15	
    16	def sort_numbers(numbers: str) -> str:
    17	    return " ".join(sorted(numbers.split(), key=_number_key))
