+)
+record(
+    "selected Stage 4 artifact hash",
+    resolution["selections"]["klean_generation"]["artifact_sha256"],
+    resolution_hashes["klean_generation_sha256"],
+)
+record(
+    "generated project tree hash",
+    klean_export.tree_digest(GENERATED),
