+stage1_export_hash = klean_export.tree_digest(WORKSPACE)
+generated_tree_hash = klean_export.tree_digest(GENERATED)
+discovery_hash = sha256_file(DISCOVERY)
+domain_ids = [
+    item["source_rule_id"]
+    for item in independent_classifications
