diff --git a/evidence/spec-body-sensitivity.k b/evidence/spec-body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..6709a1d92d4c4666768722e72f504e2c0a76eea2
--- /dev/null
+++ b/evidence/spec-body-sensitivity.k
@@ -0,0 +1,21 @@
+requires "/audit-output/evidence/verification-body-mutation.k"
+
+module SPEC-BODY-SENSITIVITY
+  imports VERIFICATION-BODY-MUTATION
+
