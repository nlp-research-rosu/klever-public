diff --git a/evidence/spec-fresh-vacuity.k b/evidence/spec-fresh-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..b254817fd2a9d5e8326624de085a70a10f9c9c39
--- /dev/null
+++ b/evidence/spec-fresh-vacuity.k
@@ -0,0 +1,22 @@
+requires "/tmp/audit-work/reconstruction/verification.k"
+
+module SPEC-FRESH-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false result constraint. The unchanged real program returns
