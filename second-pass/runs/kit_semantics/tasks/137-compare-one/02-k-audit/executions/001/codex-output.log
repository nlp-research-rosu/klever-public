    27	  // Mathematical reading of each permitted argument under the fixed MPY model.
    28	  // String normalization is exactly the program's replace(",", ".") then float().
    29	  syntax Val ::= numericValue(Val) [function]
    30	  rule numericValue(I:Int)         => I
    31	  rule numericValue(F:Float)       => F
    32	  rule numericValue(str(C:IntSeq)) => decStrToF(replaceC(C, 44, 46))
    33	
    34	  // The contract over real numbers: return the original larger argument;
    35	  // if neither is larger, they are equal and None is returned.
    36	  syntax Val ::= expectedCompare(Val, Val) [function]
    37	  rule expectedCompare(A:Val, B:Val) => A
    38	    requires applyCmp(">", numericValue(A), numericValue(B))
    39	  rule expectedCompare(A:Val, B:Val) => B
    40	    requires notBool applyCmp(">", numericValue(A), numericValue(B))
    41	     andBool applyCmp(">", numericValue(B), numericValue(A))
    42	  rule expectedCompare(A:Val, B:Val) => noneV
    43	    requires notBool applyCmp(">", numericValue(A), numericValue(B))
    44	     andBool notBool applyCmp(">", numericValue(B), numericValue(A))
