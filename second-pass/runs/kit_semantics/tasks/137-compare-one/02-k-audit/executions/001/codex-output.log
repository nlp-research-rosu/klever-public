    14	                 Call(Attribute(Name("a"), "replace"), Str(","), Str(".")))) .Stmts,
    15	             Assign(Name("a_value"), Name("a")) .Stmts)
    16	           If(Call(Name("isinstance"), Name("b"), Name("str")),
    17	             Assign(Name("b_value"),
    18	               Call(Name("float"),
    19	                 Call(Attribute(Name("b"), "replace"), Str(","), Str(".")))) .Stmts,
    20	             Assign(Name("b_value"), Name("b")) .Stmts)
    21	           If(Compare(Name("a_value"), CmpOp(">", Name("b_value"))),
    22	             Return(Name("a")) .Stmts, .Stmts)
    23	           If(Compare(Name("b_value"), CmpOp(">", Name("a_value"))),
    24	             Return(Name("b")) .Stmts, .Stmts)
    25	           Return(NoneVal) .Stmts))
