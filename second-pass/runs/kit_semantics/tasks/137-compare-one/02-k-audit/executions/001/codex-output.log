diff --git a/evidence/spec-ground-witness.k b/evidence/spec-ground-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..65693afb317c8e0eee1b7cab2bcbca07da21beaa
--- /dev/null
+++ b/evidence/spec-ground-witness.k
@@ -0,0 +1,21 @@
+requires "/tmp/audit-work/reconstruction/verification.k"
+
+module SPEC-GROUND-WITNESS
+  imports VERIFICATION
+
