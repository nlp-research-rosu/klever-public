/bin/bash -lc 'cp /candidate/verification.k /tmp/audit-work/reconstruction/verification.k
cp /candidate/spec.k /tmp/audit-work/reconstruction/spec.k
set -o pipefail
kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled 2>&1 | tee /audit-output/evidence/clean_kompile.log
