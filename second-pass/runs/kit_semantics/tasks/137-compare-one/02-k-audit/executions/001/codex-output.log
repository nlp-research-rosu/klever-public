   259	  // Int2Float(roundF(F *Float 10^N)) / 10^N — the float multiply F *Float 10^N
   260	  // misrounds the half-way decision (witness: a Heron triangle area that must
   261	  // round to 2.69 came out 2.68). Exact version, via arbitrary-precision integers:
   262	  //     F = numer / 2^k      numer = Float2Int(F * 2^(52-e)),  k = 52 - exponentFloat(F)
   263	  //     q = round-half-even( numer * 10^N , 2^k )        (exact big-integer round)
   264	  //     result = nearest double to q / 10^N
   265	  //   IEEE division is correctly rounded, so (double)q /Float (double)10^N equals
   266	  //   the nearest double to q/10^N whenever q and 10^N are exactly representable.
   267	  // Guarded to finite F with |F| < 1e12 and |F|*10^N < 2^52 (keeps numer and q
   268	  // exactly representable) and a non-subnormal exponent (avoids 2^k overflowing a
   269	  // double); the exotic tail keeps the old path, so nothing regresses.
   270	  // Opaque for kprove, [concrete] for krun.
   271	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   272	  rule roundFN(F:Float, N:Int) => roundExactFN(F, N)
   273	       requires notBool isNaN(F) andBool notBool isInfinite(F) andBool N >=Int 0
   274	        andBool absFloat(F) <Float 1000000000000.0
   275	        andBool (absFloat(F) *Float Int2Float(10 ^Int N, 53, 11)) <Float 4500000000000000.0
   276	        andBool exponentFloat(F) >Int -900 [concrete]
   277	  rule roundFN(F:Float, N:Int)
   278	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   279	       /Float Int2Float(10 ^Int N, 53, 11) [owise, concrete]
   280	
   281	  syntax Float ::= roundExactFN(Float, Int) [function]
   282	  rule roundExactFN(F:Float, N:Int)
   283	    => rheToFloat(rndHalfEven(rExNumer(F) *Int (10 ^Int N), rExDenom(F)), 10 ^Int N, F) [concrete]
   284	
   285	  // exact fraction of a finite in-range float:  F = rExNumer(F) / rExDenom(F),
   286	  // rExDenom(F) = 2^k, k = 52 - exponentFloat(F) >= 0 within the guard above.
   287	  syntax Int ::= rExK(Float) [function]
   288	  rule rExK(F:Float) => 52 -Int exponentFloat(F) [concrete]
   289	  syntax Int ::= rExNumer(Float) [function]
   290	  rule rExNumer(F:Float) => Float2Int(F *Float Int2Float(2 ^Int rExK(F), 53, 11)) [concrete]
   291	  syntax Int ::= rExDenom(Float) [function]
   292	  rule rExDenom(F:Float) => 2 ^Int rExK(F) [concrete]
   293	
   294	  // round-half-even of A/B (B > 0), to the nearest integer, ties to even.
   295	  // divInt/modInt are Euclidean (B>0 => remainder in [0,B)) — i.e. floored here.
   296	  syntax Int ::= rndHalfEven(Int, Int) [function]
   297	  rule rndHalfEven(A:Int, B:Int) => rndHE(A divInt B, A modInt B, B) [concrete]
   298	  syntax Int ::= rndHE(Int, Int, Int) [function]
   299	  rule rndHE(Q:Int, R:Int, B:Int) => Q        requires 2 *Int R <Int B [concrete]
   300	  rule rndHE(Q:Int, R:Int, B:Int) => Q +Int 1 requires 2 *Int R >Int B [concrete]
   301	  rule rndHE(Q:Int, R:Int, B:Int) => Q        requires 2 *Int R ==Int B andBool Q modInt 2 ==Int 0 [concrete]
   302	  rule rndHE(Q:Int, R:Int, B:Int) => Q +Int 1 requires 2 *Int R ==Int B andBool Q modInt 2 =/=Int 0 [concrete]
   303	
   304	  // q / 10^N as the nearest double; preserve Python's signed zero when q == 0.
   305	  syntax Float ::= rheToFloat(Int, Int, Float) [function]
   306	  rule rheToFloat(0, _:Int, F:Float) => #if signFloat(F) #then --Float 0.0 #else 0.0 #fi [concrete]
   307	  rule rheToFloat(Q:Int, SCALE:Int, _:Float)
   308	    => Int2Float(Q, 53, 11) /Float Int2Float(SCALE, 53, 11) requires Q =/=Int 0 [concrete]
   309	
   310	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   311	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   312	
   313	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   314	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   315	  syntax KItem ::= "#mathSqrt"
   316	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   317	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   318	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   319	
   320	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   321	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   322	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   323	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   324	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   325	  // the isFloat guard is disjoint from the existing isInt one.
   326	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   327	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   328	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   329	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   330	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   331	       requires isFloat(V)
   332	
   333	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   334	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   335	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   336	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   337	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   338	       requires isFloat(V)
   339	
   340	  // cross-sort steps (v3): an Int/Bool yield hands the Float-seeded fold to the
   341	  // general Val fold (builtins.k), which compares through the same applyCmp
   342	  // dispatch (the exact ltIF/ltFI bridges + the bool promotion above) — mixed
   343	  // lists like [2.5, 1]. Guards are disjoint from the isFloat steps above.
   344	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float)
   345	        => #iterYield(V, R) ~> #maxContV(M) ... </k>
   346	       requires isInt(V) orBool isBool(V)
   347	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float)
   348	        => #iterYield(V, R) ~> #minContV(M) ... </k>
   349	       requires isInt(V) orBool isBool(V)
   350	
   351	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   352	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   353	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   354	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   355	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   356	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   357	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   358	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   359	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   360	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   361	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   362	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   363	       requires isFloat(V)
   364	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   365	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   366	       requires isInt(V) orBool isBool(V)
   367	endmodule

STR
     1	// reference/src/semantics/str.k — MPY-STR
     2	
     3	module MPY-STR
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	
     7	  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
     8	  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
     9	  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
    10	        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
    11	
    12	  // ==== str literal (ASCII-only) ============================================
    13	  syntax IntSeq ::= strToCodes(String) [function]
    14	  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
    15	  rule strToCodes("") => .IntSeq
    16	  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    17	    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
    18	
    19	  // ==== operators: + / == / != / in =========================================
    20	  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
    21	  rule seqConcat(.IntSeq, T:IntSeq)                => T
    22	  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
    23	
    24	  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
    26	  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
    27	
    28	  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
    29	  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
    30	  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
    31	
    32	  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
    33	  rule strPrefix(.IntSeq, _:IntSeq)               => true
    34	  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
    35	  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
    36	
    37	  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
    38	  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
    39	  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
    40	  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
    41	       requires notBool strPrefix(P, iCons(C, Xs))
    42	
    43	  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
    44	  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
    45	  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
    46	  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
    47	  // str </<=/>/>= comparisons.
    48	  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
    49	  rule strLt(.IntSeq, .IntSeq)                => false
    50	  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
    51	  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
    52	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
    53	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
    54	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
    55	
    56	  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    57	  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
    58	  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
    59	  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
    60	endmodule

METHODS
     1	// reference/src/semantics/methods.k — MPY-METHODS
     2	
     3	module MPY-METHODS
     4	  imports MPY-CORE
     5	  imports K-EQUAL
     6	  imports MPY-STR
     7	  imports MPY-LIST
     8	
     9	  // method-call routing + arg-eval live in call.k; this module owns applyMethod.
    10	  syntax Val ::= applyMethod(Val, String, Vals) [function]
    11	
    12	  // ==== string predicates (Python semantics) =================================
    13	  rule applyMethod(str(CS:IntSeq), "isupper", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)
    14	  rule applyMethod(str(CS:IntSeq), "islower", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)
    15	  rule applyMethod(str(CS:IntSeq), "isalpha", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)
    16	  rule applyMethod(str(CS:IntSeq), "isdigit", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)
    17	
    18	  // ==== case maps ============================================================
    19	  rule applyMethod(str(CS:IntSeq), "lower",    .Vals) => str(mapLower(CS))
    20	  rule applyMethod(str(CS:IntSeq), "upper",    .Vals) => str(mapUpper(CS))
    21	  rule applyMethod(str(CS:IntSeq), "swapcase", .Vals) => str(mapSwap(CS))
    22	
    23	  // ==== join / count / strip / encode ========================================
    24	  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by
    25	  // the call layer; the result str is a value)
    26	  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))
    27	  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]
    28	  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq
    29	  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS
    30	  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
    31	    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))
    32	
    33	  // S.count(sub): non-overlapping window scan (Python str.count)
    34	  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
    35	  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
    36	  rule cntSub(.IntSeq, _:IntSeq) => 0
    37	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
    38	       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0
    39	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
    40	       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0
    41	  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]
    42	  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0
    43	  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]
    44	  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
    45	
    46	  // S.strip(): trim whitespace runs from both ends
    47	  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
    48	  syntax IntSeq ::= trimWS(IntSeq) [function, total]
    49	  rule trimWS(.IntSeq) => .IntSeq
    50	  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)
    51	  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)
    52	  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]
    53	  rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)
    54	  rule revISAcc(.IntSeq, A:IntSeq) => A
    55	  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))
    56	
    57	  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)
    58	  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)
    59	
    60	  // ==== prefix ===============================================================
    61	  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)
    62	
    63	  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========
    64	  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)
    65	  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]
    66	  rule cntOccVS(.ValSeq, _:Val)                => 0
    67	  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V
    68	  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)
    69	
    70	  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========
    71	  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
    72	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
    73	        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
    74	       [priority(40)]
    75	  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result
    76	  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)
    77	  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))
    78	       requires isWSC(C)
    79	  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)
    80	       requires notBool isWSC(C)
    81	  // flush the current token to the result list iff non-empty.
    82	  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]
    83	  rule flushTok(ACC:ValSeq, .IntSeq)            => ACC
    84	  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))
    85	  syntax Bool ::= isWSC(Int) [function, total]
    86	  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13
    87	
    88	  // split(sep='x') keyword form delegates to the positional k-cell rule
    89	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (kwV("sep", str(S:IntSeq)), .Vals))
    90	        => #applyK(toCall(boundMethodV(str(CS), "split")), (str(S), .Vals)) ... </k>
    91	       [priority(39)]
    92	
    93	  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).
    94	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (str(iCons(SEP:Int, .IntSeq)), .Vals))
    95	        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>
    96	       [priority(40)]
    97	  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token
    98	  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)
    99	  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))
   100	       requires C ==Int SEP
   101	  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))
   102	       requires notBool (C ==Int SEP)
   103	
   104	  rule applyMethod(str(CS:IntSeq), "replace", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)
   105	    => str(replaceC(CS, A, B))
   106	  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]
   107	  rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq
   108	  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A
   109	  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(C, replaceC(R, A, B)) requires notBool (C ==Int A)
   110	
   111	  // ==== char helpers =========================================================
   112	  syntax Bool ::= isUpperC(Int) [function, total]
   113	  rule isUpperC(C:Int) => C >=Int 65 andBool C <=Int 90
   114	
   115	  syntax Bool ::= isLowerC(Int) [function, total]
   116	  rule isLowerC(C:Int) => C >=Int 97 andBool C <=Int 122
   117	
   118	  syntax Bool ::= isAlphaC(Int) [function, total]
   119	  rule isAlphaC(C:Int) => isUpperC(C) orBool isLowerC(C)
   120	
   121	  syntax Bool ::= isDigitC(Int) [function, total]
   122	  rule isDigitC(C:Int) => C >=Int 48 andBool C <=Int 57
   123	
   124	  syntax Bool ::= hasUpper(IntSeq) [function, total]
   125	  rule hasUpper(.IntSeq) => false
   126	  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)
   127	
   128	  syntax Bool ::= hasLower(IntSeq) [function, total]
   129	  rule hasLower(.IntSeq) => false
   130	  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)
   131	
   132	  syntax Bool ::= allAlpha(IntSeq) [function, total]
   133	  rule allAlpha(.IntSeq) => true
   134	  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)
   135	
   136	  syntax Bool ::= allDigit(IntSeq) [function, total]
   137	  rule allDigit(.IntSeq) => true
   138	  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)
   139	
   140	  syntax Int ::= lowerC(Int) [function, total]
   141	
   142	  rule lowerC(C:Int) => C +Int 32 requires isUpperC(C)
   143	  rule lowerC(C:Int) => C         [owise]
   144	
   145	  syntax Int ::= upperC(Int) [function, total]
   146	  rule upperC(C:Int) => C -Int 32 requires isLowerC(C)
   147	  rule upperC(C:Int) => C         [owise]
   148	
   149	  syntax Int ::= swapC(Int) [function, total]
   150	  rule swapC(C:Int) => C +Int 32 requires isUpperC(C)
   151	  rule swapC(C:Int) => C -Int 32 requires isLowerC(C)
   152	  rule swapC(C:Int) => C         [owise]
   153	
   154	  syntax IntSeq ::= mapLower(IntSeq) [function, total]
   155	  rule mapLower(.IntSeq) => .IntSeq
   156	  rule mapLower(iCons(C:Int, S:IntSeq)) => iCons(lowerC(C), mapLower(S))
   157	
   158	  syntax IntSeq ::= mapUpper(IntSeq) [function, total]
   159	  rule mapUpper(.IntSeq) => .IntSeq
   160	  rule mapUpper(iCons(C:Int, S:IntSeq)) => iCons(upperC(C), mapUpper(S))
   161	
   162	  syntax IntSeq ::= mapSwap(IntSeq) [function, total]
   163	  rule mapSwap(.IntSeq) => .IntSeq
   164	  rule mapSwap(iCons(C:Int, S:IntSeq)) => iCons(swapC(C), mapSwap(S))
   165	
   166	  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]
   167	  rule startsWith(.IntSeq, _:IntSeq)               => true
   168	  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false
   169	  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)
   170	endmodule

CONCRETE
     1	// reference/src/semantics/concrete.k — MPY-CONCRETE
     2	// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
     3	// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
     4	// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
     5	// backend ([concrete] is not respected on rewrite rules) — probed on
     6	// 26-remove-duplicates, where element compares branched into deepEqVS.
     7	
     8	module MPY-CONCRETE
     9	  imports MPY
    10	
    11	  // deep equality for list compares whose elements are heap objects
    12	  // (list-of-lists): Python == is structural at every depth.
    13	  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
    14	       <heap> HP:Map </heap>
    15	       requires hasRefVS(A) orBool hasRefVS(B)
    16	  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
    17	       <heap> HP:Map </heap>
    18	       requires hasRefVS(A) orBool hasRefVS(B)
    19	
    20	  // ==== keyed sort, concrete leg ============================================
    21	  // Computes each key by a REAL call through the uniform #callee machinery
    22	  // (closures, len, type objects all work), stable-inserts on the key, and
    23	  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
    24	  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
    25	  syntax Val ::= kvP(Val, Val)
    26	  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
    27	                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
    28	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    29	        => #ksort(VS, KV, .ValSeq, false) ... </k>
    30	       [priority(40)]
    31	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    32	        => #ksort(VS, KV, .ValSeq, RB) ... </k>
    33	       [priority(40)]
    34	  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
    35	        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
    36	  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
    37	        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
    38	  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
    39	        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
    40	       requires notBool isKwV(K)
    41	
    42	  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
    43	  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
    44	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    45	    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
    46	       requires kLt(K, K2)
    47	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    48	    => vCons(kvP(K2, V2), insPair(R, K, V))
    49	       requires notBool kLt(K, K2)
    50	
    51	  syntax Bool ::= kLt(Val, Val) [function]
    52	  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
    53	  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
    54	  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    55	  // v3: mixed Int/Float keys via the exact v2 bridges (float.k), bool keys by
    56	  // the bool->int promotion (True==1, False==0). Unordered pairs (int vs str)
    57	  // stay without a leg — stuck, like CPython's TypeError.
    58	  rule kLt(I:Int, F:Float)   => ltIF(I, F)
    59	  rule kLt(F:Float, I:Int)   => ltFI(F, I)
    60	  rule kLt(B:Bool, V:Val)    => kLt(boolAsInt(B), V) requires isInt(V) orBool isFloat(V)
    61	  rule kLt(V:Val, B:Bool)    => kLt(V, boolAsInt(B)) requires isInt(V) orBool isFloat(V)
    62	  rule kLt(B1:Bool, B2:Bool) => boolAsInt(B1) <Int boolAsInt(B2)
    63	
    64	  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
    65	  rule unpairVS(.ValSeq) => .ValSeq
    66	  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
    67	  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
    68	
    69	  // ==== non-keyed reverse sorted(), concrete leg (v3) =======================
    70	  // sort.k's condRev(sortVS(VS), true) reverses equal-key runs — invisible on
    71	  // the all-Int / all-str lists sortVS used to accept, visible once sortVS
    72	  // orders mixed numerics (CPython keeps FIRST-seen order among equal keys
    73	  // under reverse=True). rev-in/rev-out over the same stable ascending sortVS
    74	  // is exactly CPython's stable descending sort, and is output-identical on the
    75	  // old homogeneous domains. krun-only (priority 40; proofs keep sort.k's
    76	  // condRev(sortVS(VS), RB) term unchanged).
    77	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("reverse", true), .Vals))
    78	        => #alloc(list(revVS(sortVS(revVS(VS))))) ... </k>
    79	       [priority(40)]
    80	
    81	  // ==== numeric cross-type membership (Python: 1 == True == 1.0) =============
    82	  // `x in list` / `x not in list` compare elements with ==K in list.k, which does
    83	  // NOT collapse across the numeric types (true =/=K 1, 1 =/=K 1.0). Under krun,
    84	  // override the membership fold with a numeric-aware equality so `in` and
    85	  // unique()-style dedup behave like CPython for mixed int/bool/float elements.
    86	  // (set.k needs no change: setV holds int char codes, compared with ==Int, so a
    87	  // cross-type ==K collapse never arises there.)
    88	  // krun-only (priority 40 beats list.k's default rules); kprove uses the
    89	  // structural ==K rules in list.k unchanged.
    90	  syntax Bool ::= numOrKEq(Val, Val) [function]
    91	  rule numOrKEq(A:Val, B:Val) => applyCmp("==", A, B)
    92	       requires (isInt(A) orBool isBool(A) orBool isFloat(A))
    93	        andBool (isInt(B) orBool isBool(B) orBool isFloat(B))
    94	  rule numOrKEq(A:Val, B:Val) => A ==K B [owise]
    95	
    96	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    97	       requires numOrKEq(E, V) [priority(40)]
    98	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    99	       requires notBool numOrKEq(E, V) [priority(40)]
   100	endmodule

diff --git a/evidence/independent_differential.py b/evidence/independent_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..a6b71fc6e2e53a1db09c8a08499f8016daf320a7
--- /dev/null
+++ b/evidence/independent_differential.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Docstring-first differential for HumanEval 137.
+
+The generated cases are deterministic and fully specified by VALUES and
+RANDOM_SEED below. The oracle follows a defensible reading of the docstring:
+strings are converted after comma-to-dot normalization, ordinary int/float
+values are compared without first coercing integers to floats, and the exact
+original argument is returned.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import math
+import random
+from pathlib import Path
+
+
+GENERATED_PATH = Path("/tmp/audit-work/reconstruction/solution.py")
+CANONICAL_PATH = Path("/reference/canonical.py")
+RANDOM_SEED = 13720260730
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.compare_one
+
+
+generated = load(GENERATED_PATH, "generated_solution")
+canonical = load(CANONICAL_PATH, "trusted_canonical")
+
+
+def numeric_value(value):
+    if isinstance(value, str):
+        return float(value.replace(",", "."))
+    return value
+
+
+def oracle(a, b):
+    av = numeric_value(a)
+    bv = numeric_value(b)
+    if av > bv:
+        return a
+    if bv > av:
+        return b
+    return None
+
+
+def outcome(function, a, b):
+    try:
+        result = function(a, b)
+    except Exception as err:  # Edge observations include exception type.
+        return ("raises", type(err).__name__, str(err))
+    if result is None:
+        return ("return", "None")
+    if result is a:
+        return ("return-original", "a", type(result).__name__, repr(result))
+    if result is b:
+        return ("return-original", "b", type(result).__name__, repr(result))
+    return ("return-other", type(result).__name__, repr(result))
+
+
+DOCUMENTED = [
+    (1, 2.5),
+    (1, "2,3"),
+    ("5,1", "6"),
+    ("1", 1),
+]
+
+# Crosses every Int/Float/str pairing and both greater branches plus equality.
+VALUES = [
+    -7,
+    0,
+    3,
+    2**53,
+    2**53 + 1,
+    -3.5,
+    -0.0,
+    0.5,
+    float(2**53),
+    "-7",
+    "-3,5",
+    "0",
+    "-0.0",
+    "0,5",
+    "3.000",
+    "1e2",
+]
+
+EXPLICIT_BOUNDARIES = [
+    (-1, -2),
+    (-2, -1),
+    (-1, -1),
+    (2.0, 1),
+    (1, 2.0),
+    (2, 2.0),
+    ("2,5", 2),
+    (2, "2.5"),
+    ("2.50", "2,5"),
+    (2**53 + 1, float(2**53)),
+    (10**400, 0.0),
+]
+
+EDGE_OBSERVATIONS = [
+    ("", 0),
+    (" ", 0),
+    (",", 0),
+    ("1,2,3", 0),
+    ("nan", 1.0),
+    (float("nan"), 1.0),
+    (float("inf"), 1.0),
+    ("inf", 1.0),
+    ("١٢", 11),  # Unicode Arabic-Indic digits accepted by CPython float().
+    ("1e400", 1e308),
+]
+
+
+def random_value(rng: random.Random):
+    choice = rng.randrange(3)
+    if choice == 0:
+        return rng.randint(-10**18, 10**18)
+    if choice == 1:
+        numerator = rng.randint(-10**8, 10**8)
+        denominator = rng.choice([1, 2, 4, 5, 8, 10, 100])
+        return numerator / denominator
+    numerator = rng.randint(-10**8, 10**8)
+    scale = rng.randrange(0, 7)
+    text = f"{numerator / (10**scale):.{scale}f}"
+    return text.replace(".", ",") if rng.randrange(2) else text
+
+
+cases = []
+cases.extend(("documented", a, b) for a, b in DOCUMENTED)
+cases.extend(("boundary", a, b) for a, b in EXPLICIT_BOUNDARIES)
+cases.extend(("cartesian", a, b) for a in VALUES for b in VALUES)
+rng = random.Random(RANDOM_SEED)
+cases.extend(("random", random_value(rng), random_value(rng)) for _ in range(600))
+
+generated_mismatches = []
+canonical_mismatches = []
+generated_canonical_divergences = []
+by_group: dict[str, int] = {}
+for index, (group, a, b) in enumerate(cases):
+    by_group[group] = by_group.get(group, 0) + 1
+    expected = outcome(oracle, a, b)
+    actual = outcome(generated, a, b)
+    witness = outcome(canonical, a, b)
+    record = (index, group, repr(a), repr(b), expected, actual, witness)
+    if actual != expected:
+        generated_mismatches.append(record)
+    if witness != expected:
+        canonical_mismatches.append(record)
+    if actual != witness:
+        generated_canonical_divergences.append(record)
+
+print(f"COMMAND: python3 {Path(__file__)}")
+print(f"generated={GENERATED_PATH}")
+print(f"canonical={CANONICAL_PATH}")
+print(f"random_seed={RANDOM_SEED}")
+print(f"case_groups={by_group}")
+print(f"total_contract_cases={len(cases)}")
+print(f"generated_vs_oracle_mismatches={len(generated_mismatches)}")
+print(f"canonical_vs_oracle_mismatches={len(canonical_mismatches)}")
+print(f"generated_vs_canonical_divergences={len(generated_canonical_divergences)}")
+for label, records in [
+    ("GENERATED_MISMATCH", generated_mismatches),
+    ("CANONICAL_MISMATCH", canonical_mismatches),
+    ("GENERATED_CANONICAL_DIVERGENCE", generated_canonical_divergences),
+]:
+    for record in records[:30]:
+        print(label, record)
+    if len(records) > 30:
+        print(f"{label} ... {len(records) - 30} additional records omitted")
+
+print("EDGE_OBSERVATIONS_BEGIN")
+for a, b in EDGE_OBSERVATIONS:
+    print(
+        repr(a),
+        repr(b),
+        "generated=", outcome(generated, a, b),
+        "canonical=", outcome(canonical, a, b),
+    )
+print("EDGE_OBSERVATIONS_END")
+
+# Every documented example and all ordinary finite generated cases must satisfy
+# the independent oracle. Canonical differences are observations, not failures.
+raise SystemExit(1 if generated_mismatches else 0)
diff --git a/evidence/k_concrete_smoke.py b/evidence/k_concrete_smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..220bd53de767a30d2cfe961f7e8c95d9ddf89b91
--- /dev/null
+++ b/evidence/k_concrete_smoke.py
@@ -0,0 +1,27 @@
+def compare_one(a, b):
+    if isinstance(a, str):
+        a_value = float(a.replace(",", "."))
+    else:
+        a_value = a
+
+    if isinstance(b, str):
+        b_value = float(b.replace(",", "."))
+    else:
+        b_value = b
+
+    if a_value > b_value:
+        return a
+    if b_value > a_value:
+        return b
+    return None
+
+
+# Docstring examples, all comparison outcomes, and representative type pairs.
+assert compare_one(1, 2.5) == 2.5
+assert compare_one(1, "2,3") == "2,3"
+assert compare_one("5,1", "6") == "6"
+assert compare_one("1", 1) is None
+assert compare_one(-1, -2) == -1
+assert compare_one(-2.5, -1) == -1
+assert compare_one("2.50", "2,5") is None
+assert compare_one(2.5, "2") == 2.5
diff --git a/evidence/run_positive_claims.sh b/evidence/run_positive_claims.sh
new file mode 100644
index 0000000000000000000000000000000000000000..25cc1d425e163be177f4638e593bd753e66b968c
--- /dev/null
+++ b/evidence/run_positive_claims.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/reconstruction
+evidence=/audit-output/evidence
+claims=(
+  int-int
+  int-float
+  float-int
+  float-float
+  int-str
+  str-int
+  float-str
+  str-float
+  str-str
+)
+
+overall=0
+for claim in "${claims[@]}"; do
+  log="$evidence/positive-${claim}.log"
+  command=(kprove spec.k --definition verification-kompiled --spec-module SPEC --claims "SPEC.${claim}")
+  printf 'COMMAND:' | tee "$log"
+  printf ' %q' "${command[@]}" | tee -a "$log"
+  printf '\n' | tee -a "$log"
+  (
+    cd "$work" || exit 125
+    "${command[@]}"
+  ) 2>&1 | tee -a "$log"
+  status=${PIPESTATUS[0]}
+  printf 'EXIT_STATUS: %s\n' "$status" | tee -a "$log"
+  top_count=$(grep -c '^#Top$' "$log" || true)
+  printf 'TOP_COUNT: %s\n' "$top_count" | tee -a "$log"
+  if [[ $status -ne 0 || $top_count -ne 1 ]]; then
+    overall=1
+  fi
+done
+printf 'OVERALL_EXIT_STATUS: %s\n' "$overall" | tee "$evidence/positive-claims-summary.log"
+exit "$overall"
diff --git a/evidence/stage1_integrity.py b/evidence/stage1_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..cce93f2a06e0d916324cc8f16102e664d34333ac
--- /dev/null
+++ b/evidence/stage1_integrity.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""Independent pipeline-v3 mount and supplied-semantics integrity checks."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+from collections import Counter
+from pathlib import Path
+
+
+AUDIT = Path("/audit-input.json")
+LOCK = Path("/audit-campaign-lock.json")
+GEN_RESULT = Path("/generation-result.json")
+
+
+def sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def kind(path: Path) -> str:
+    mode = path.lstat().st_mode
+    if stat.S_ISREG(mode):
+        return "file"
+    if stat.S_ISDIR(mode):
+        return "dir"
+    if stat.S_ISLNK(mode):
+        return "symlink"
+    return f"other({stat.S_IFMT(mode):o})"
+
+
+def tree_entries(root: Path) -> dict[str, tuple[str, str | None]]:
+    result: dict[str, tuple[str, str | None]] = {}
+    for base, dirs, files in os.walk(root, followlinks=False):
+        base_path = Path(base)
+        for name in sorted(dirs + files):
+            path = base_path / name
+            rel = path.relative_to(root).as_posix()
+            entry_kind = kind(path)
+            digest = sha256(path) if entry_kind == "file" else None
+            result[rel] = (entry_kind, digest)
+    return result
+
+
+def report_hash(label: str, path: Path, expected: str | None) -> bool:
+    actual = sha256(path)
+    ok = expected == actual if expected is not None else True
+    print(f"HASH {label}: expected={expected or '(none)'} actual={actual} ok={ok}")
+    return ok
+
+
+audit = json.loads(AUDIT.read_text())
+lock = json.loads(LOCK.read_text())
+result = json.loads(GEN_RESULT.read_text())
+hashes = audit["hashes"]
+
+print("COMMAND: python3 /audit-output/evidence/stage1_integrity.py")
+print(f"record_layout={audit.get('record_layout')}")
+print(f"semantics_mode={audit.get('semantics_mode')}")
+print(f"campaign_block_equals_lock={audit.get('audit_campaign') == lock}")
+
+required = [
+    AUDIT,
+    LOCK,
+    Path("/run.json"),
+    Path("/task.json"),
+    GEN_RESULT,
+    Path("/generation-evidence/invocation.json"),
+    Path("/generation-evidence/metrics.json"),
+    Path("/generation-evidence/runtime-metrics.json"),
+    Path("/generation-evidence/usage.json"),
+    Path("/generation-evidence/codex-last.txt"),
+    Path("/generation-evidence/codex-output.log"),
+    Path("/generation-evidence/prompt.txt"),
+    Path("/generation-evidence/codex-trace"),
+    Path("/candidate"),
+    Path("/reference/canonical.py"),
+    Path("/reference/prompt.py"),
+    Path("/reference/py2mpy.py"),
+    Path("/reference/reference-semantics"),
+]
+for path in required:
+    readable = os.access(path, os.R_OK)
+    print(f"REQUIRED {path}: exists={path.exists()} kind={kind(path) if path.exists() else 'missing'} readable={readable}")
+
+checks = [
+    ("audit_campaign_lock", LOCK, hashes["audit_campaign_lock_sha256"]),
+    ("run_manifest", Path("/run.json"), hashes["run_manifest_sha256"]),
+    ("task_manifest", Path("/task.json"), hashes["task_manifest_sha256"]),
+    ("stage1_result", GEN_RESULT, hashes["stage1_result_sha256"]),
+    ("generation_invocation", Path("/generation-evidence/invocation.json"), hashes["stage1_invocation_sha256"]),
+    ("generation_metrics", Path("/generation-evidence/metrics.json"), hashes["generation_metrics_sha256"]),
+    ("generation_runtime_metrics", Path("/generation-evidence/runtime-metrics.json"), hashes["generation_runtime_metrics_sha256"]),
+    ("generation_usage", Path("/generation-evidence/usage.json"), hashes["generation_usage_sha256"]),
+    ("generation_last", Path("/generation-evidence/codex-last.txt"), hashes["generation_codex_last_sha256"]),
+    ("generation_output", Path("/generation-evidence/codex-output.log"), hashes["generation_codex_output_sha256"]),
+    ("generation_prompt", Path("/generation-evidence/prompt.txt"), hashes["generation_prompt_sha256"]),
+    ("canonical", Path("/reference/canonical.py"), hashes["canonical_sha256"]),
+    ("trusted_prompt", Path("/reference/prompt.py"), hashes["trusted_prompt_sha256"]),
+    ("candidate_prompt", Path("/candidate/prompt.py"), hashes["candidate_prompt_sha256"]),
+    ("trusted_translator", Path("/reference/py2mpy.py"), hashes["trusted_translator_sha256"]),
+    ("candidate_translator", Path("/candidate/py2mpy.py"), hashes["candidate_translator_sha256"]),
+]
+hash_ok = all(report_hash(*item) for item in checks)
