codex
The failure is caused by this sandbox’s PID namespace: Lean 4.22 resolves its executable through `/proc/<getpid()>/exe`, while only `/proc/self/exe` is valid here. I’m applying a narrow audit-only compatibility shim that redirects only that readlink pattern to `/proc/self/exe`; it does not alter Lean source, generated files, theorem statements, or elaboration. I’ll record both the failed run and the shim source/usage in evidence.
apply patch
patch: completed
/tmp/audit-work/proc-self-readlink.c
diff --git a//tmp/audit-work/proc-self-readlink.c b//tmp/audit-work/proc-self-readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..3b63c3a792abef2ce9092c70a476fbf51bf5a279
--- /dev/null
+++ b//tmp/audit-work/proc-self-readlink.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    const char *suffix = path + strlen(path);
+    if (strncmp(path, "/proc/", 6) == 0 &&
+        suffix >= path + 10 &&
+        strcmp(suffix - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

