requires "semantics/concrete.k"

module MPY
  imports MPY-CORE
  imports MPY-ITER
  imports MPY-RANGE
  imports MPY-OPERATORS
  imports MPY-INT
  imports MPY-BOOL
  imports MPY-FLOAT
  imports MPY-STR
  imports MPY-SET
  imports MPY-LIST
  imports MPY-TUPLE
  imports MPY-SUBSCRIPT
  imports MPY-COMPREHENSION
  imports MPY-METHODS
  imports MPY-CONTROLS
  imports MPY-FUNCTIONS
  imports MPY-BUILTINS
  imports MPY-CALL
  imports MPY-SORT
  imports MPY-ASSERT
  imports MPY-DICT
endmodule

// The krun (llvm) main module: MPY plus the concrete-only legs (keyed sort's
// real key calls, deep list equality). Verification builds import MPY and
// never see MPY-CONCRETE. The llvm kompile MUST use --main-module MPY-KRUN —
// with plain MPY the concrete legs are silently absent (this was live for a
// while: sorted-key stuck and comprehension asserted wrong under krun).
module MPY-KRUN
  imports MPY
  imports MPY-CONCRETE
endmodule
  syntax Float ::= mulF(Float, Float) [function, total, symbol(mulF), no-evaluators]
  rule mulF(F1:Float, F2:Float) => F1 *Float F2 [concrete]
  rule applyBin("*", F1:Float, F2:Float) => mulF(F1, F2)

  syntax Float ::= powF(Float, Float) [function, total, symbol(powF), no-evaluators]
  rule powF(F1:Float, F2:Float) => F1 ^Float F2 [concrete]
  rule applyBin("**", F1:Float, F2:Float) => powF(F1, F2)

  // ---- the remaining comparisons (gtF promoted from find_zero — its summaries
  //      case-split on the atom; >= / <= derive from the two opaque compares) ----
  syntax Bool ::= gtF(Float, Float) [function, total, symbol(gtF), no-evaluators]
  rule gtF(F1:Float, F2:Float) => F1 >Float F2 [concrete]
  rule applyCmp(">",  F1:Float, F2:Float) => gtF(F1, F2)
  rule applyCmp(">=", F1:Float, F2:Float) => notBool floatLt(F1, F2)
  rule applyCmp("<=", F1:Float, F2:Float) => notBool gtF(F1, F2)

  // ---- mixed Int/Float operators promote the Int side (n ** 0.5 etc.) ----
  rule applyBin("**", I:Int, F:Float) => powF(intToF(I), F)
  rule applyBin("**", F:Float, I:Int) => powF(F, intToF(I))
  rule applyBin("-",  I:Int, F:Float) => subF(intToF(I), F)
  rule applyBin("-",  F:Float, I:Int) => subF(F, intToF(I))
  rule applyBin("+",  I:Int, F:Float) => addF(intToF(I), F)
  rule applyBin("+",  F:Float, I:Int) => addF(F, intToF(I))
  rule applyBin("*",  I:Int, F:Float) => mulF(intToF(I), F)
  rule applyBin("*",  F:Float, I:Int) => mulF(F, intToF(I))

  // ---- exact mixed Int/Float comparison ------------------------------------
  // The old rules compared via intToF(I), which ROUNDS ints >= 2^53 to a nearby
  // double (so e.g. 9007199254740993 > 9007199254740992.0 came out false). Compare
  // the REAL values instead: for a finite float F and an integer I,
  //     F <  I   <=>   floor(F) <  I
  //     F >  I   <=>   ceil(F)  >  I
  //     F == I   <=>   F is integral  AND  floor(F) == I
  // floorFloat/ceilFloat are exact and Float2Int yields the EXACT integer of an
  // integral float (no rounding), so this is exact for every finite F. Non-finite
  // F keeps the old intToF path (rounding is irrelevant to +/-inf and NaN, and
  // inf/NaN have no integer floor). Opaque for kprove, [concrete] for krun.
  syntax Bool ::= eqF(Float, Float) [function, total, symbol(eqF), no-evaluators]
  rule eqF(F1:Float, F2:Float) => F1 ==Float F2 [concrete]

  syntax Bool ::= floatFinite(Float) [function, total, symbol(floatFinite), no-evaluators]
  rule floatFinite(F:Float) => notBool isNaN(F) andBool notBool isInfinite(F) [concrete]

  syntax Bool ::= ltFI(Float, Int) [function, total, symbol(ltFI), no-evaluators]   // F <  I
                | ltIF(Int, Float) [function, total, symbol(ltIF), no-evaluators]   // I <  F
                | eqIF(Int, Float) [function, total, symbol(eqIF), no-evaluators]   // I == F
  rule ltFI(F:Float, I:Int) => Float2Int(floorFloat(F)) <Int I  requires floatFinite(F)          [concrete]
  rule ltFI(F:Float, I:Int) => floatLt(F, intToF(I))            requires notBool floatFinite(F)   [concrete]
  rule ltIF(I:Int, F:Float) => Float2Int(ceilFloat(F))  >Int I  requires floatFinite(F)          [concrete]
  rule ltIF(I:Int, F:Float) => floatLt(intToF(I), F)            requires notBool floatFinite(F)   [concrete]
  rule eqIF(I:Int, F:Float)
    => (floorFloat(F) ==Float ceilFloat(F)) andBool (Float2Int(floorFloat(F)) ==Int I)
       requires floatFinite(F) [concrete]
  rule eqIF(I:Int, F:Float) => eqF(intToF(I), F) requires notBool floatFinite(F) [concrete]

  rule applyCmp("==", I:Int, F:Float) => eqIF(I, F)
  rule applyCmp("==", F:Float, I:Int) => eqIF(I, F)
  rule applyCmp("!=", I:Int, F:Float) => notBool eqIF(I, F)
  rule applyCmp("!=", F:Float, I:Int) => notBool eqIF(I, F)
  rule applyCmp("<",  I:Int, F:Float) => ltIF(I, F)
  rule applyCmp("<",  F:Float, I:Int) => ltFI(F, I)
  rule applyCmp(">",  I:Int, F:Float) => ltFI(F, I)          // I >  F  <=>  F <  I
  rule applyCmp(">",  F:Float, I:Int) => ltIF(I, F)          // F >  I  <=>  I <  F
  rule applyCmp("<=", I:Int, F:Float) => notBool ltFI(F, I)  // I <= F  <=>  not (F < I)
  rule applyCmp("<=", F:Float, I:Int) => notBool ltIF(I, F)  // F <= I  <=>  not (I < F)
  rule applyCmp(">=", I:Int, F:Float) => notBool ltIF(I, F)  // I >= F  <=>  not (I < F)
  rule applyCmp(">=", F:Float, I:Int) => notBool ltFI(F, I)  // F >= I  <=>  not (F < I)

  // ---- bool is a subtype of int: a Bool operand with a Float promotes to 0/1 --
  rule applyBin(OP:String, B:Bool, F:Float) => applyBin(OP, boolAsInt(B), F) requires isArithOp(OP)
  rule applyBin(OP:String, F:Float, B:Bool) => applyBin(OP, F, boolAsInt(B)) requires isArithOp(OP)
  rule applyCmp(OP:String, B:Bool, F:Float) => applyCmp(OP, boolAsInt(B), F) requires isEqOrdOp(OP)
  rule applyCmp(OP:String, F:Float, B:Bool) => applyCmp(OP, F, boolAsInt(B)) requires isEqOrdOp(OP)

