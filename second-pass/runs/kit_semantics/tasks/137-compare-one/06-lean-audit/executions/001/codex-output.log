+FIRST COMMAND
+PYTHONPATH=/reference python3 - <<'PY'
+from pathlib import Path
+from tools.klean_preflight import check_generation
+check_generation(Path('/reference/k-proof'),
+                 Path('/reference/lemma-discovery.json'),
+                 Path('/reference/klean-generation'),
+                 toolchain_lock=Path('/reference/klean-toolchain.lock.json'))
+PY
+
+FIRST RESULT
+tools.klean_preflight.KleanPreflightError: lake clean failed (1): error: could not detect the configuration of the Lake installation
+
+ENVIRONMENT DIAGNOSIS
+Lean 4.22 uses /proc/<getpid()>/exe to locate its installation. In the audit
+PID namespace that path is absent while /proc/self/exe is valid. The narrow
+LD_PRELOAD source used to redirect only /proc/<pid>/exe readlink calls is saved
+as proc-self-readlink.c. It does not modify any source or generated artifact.
+
+RERUN COMMAND
+cc -shared -fPIC -O2 -Wall -Wextra \
+  -o /tmp/audit-work/proc-self-readlink.so \
+  /tmp/audit-work/proc-self-readlink.c -ldl
+PYTHONUNBUFFERED=1 PYTHONPATH=/reference python3 - <<'PY'
+import json, os, subprocess
+from pathlib import Path
+from tools.klean_preflight import check_generation
+def run(command, *, cwd, timeout):
+    env = os.environ.copy()
+    env['LD_PRELOAD'] = '/tmp/audit-work/proc-self-readlink.so'
+    result = subprocess.run(command, cwd=cwd, timeout=timeout, text=True,
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)
+    return result.returncode, result.stdout
+result = check_generation(
+    Path('/reference/k-proof'),
+    Path('/reference/lemma-discovery.json'),
+    Path('/reference/klean-generation'),
+    toolchain_lock=Path('/reference/klean-toolchain.lock.json'),
+    run_command=run)
+print(json.dumps(result, indent=2, sort_keys=True))
+PY
+
+RERUN RESULT
+{
+  "designated_sorry_count": 0,
+  "diagnostics": [
+    {
+      "command": ["lake", "clean"],
