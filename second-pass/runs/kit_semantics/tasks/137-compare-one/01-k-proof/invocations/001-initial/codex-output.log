+assert compare_one("2,5", 2.0) == "2,5"
+assert compare_one(2.5, "2,0") == 2.5
+assert compare_one("2,5", "2.4") == "2,5"
+assert compare_one("1.0", "1,00") is None
+assert compare_one(-3.5, "-3,5") is None
