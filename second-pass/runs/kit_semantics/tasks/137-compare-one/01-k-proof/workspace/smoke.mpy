Module(
  FuncDef("compare_one", Params("a", "b"),
    If(Call(Name("isinstance"), Name("a"), Name("str")),
      Assign(
        Name("a_value"),
        Call(
          Name("float"),
          Call(Attribute(Name("a"), "replace"), Str(","), Str(".")))),
      Assign(Name("a_value"), Name("a")))
    If(Call(Name("isinstance"), Name("b"), Name("str")),
      Assign(
        Name("b_value"),
        Call(
          Name("float"),
          Call(Attribute(Name("b"), "replace"), Str(","), Str(".")))),
      Assign(Name("b_value"), Name("b")))
    If(Compare(Name("a_value"), CmpOp(">", Name("b_value"))),
      Return(Name("a")),
      )
    If(Compare(Name("b_value"), CmpOp(">", Name("a_value"))),
      Return(Name("b")),
      )
    Return(NoneVal))
  Assert(
    Compare(
      Call(Name("compare_one"), Int(1), Float(2.5)),
      CmpOp("==", Float(2.5))))
  Assert(
    Compare(
      Call(Name("compare_one"), Int(1), Str("2,3")),
      CmpOp("==", Str("2,3"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Str("5,1"), Str("6")),
      CmpOp("==", Str("6"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Str("1"), Int(1)),
      CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("compare_one"), UnaryOp("-", Int(2)), Str("-2.5")),
      CmpOp("==", UnaryOp("-", Int(2)))))
  Assert(
    Compare(
      Call(Name("compare_one"), Int(2), Int(1)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("compare_one"), Float(2.5), Int(1)),
      CmpOp("==", Float(2.5))))
  Assert(
    Compare(
      Call(Name("compare_one"), Int(2), Float(2.5)),
      CmpOp("==", Float(2.5))))
  Assert(
    Compare(
      Call(Name("compare_one"), Float(2.5), Float(3.5)),
      CmpOp("==", Float(3.5))))
  Assert(
    Compare(
      Call(Name("compare_one"), Str("2.5"), Int(2)),
      CmpOp("==", Str("2.5"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Int(2), Str("2.5")),
      CmpOp("==", Str("2.5"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Str("2,5"), Float(2.0)),
      CmpOp("==", Str("2,5"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Float(2.5), Str("2,0")),
      CmpOp("==", Float(2.5))))
  Assert(
    Compare(
      Call(Name("compare_one"), Str("2,5"), Str("2.4")),
      CmpOp("==", Str("2,5"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Str("1.0"), Str("1,00")),
      CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("compare_one"), UnaryOp("-", Float(3.5)), Str("-3,5")),
      CmpOp("is", NoneVal))))
