+                              Attribute(
+                                Call(Name("bin"), Name("value"), .Exprs),
+                                "count"),
+                              Str("1"),
+                              .Exprs))),
+                        .Exprs))
+                    .Stmts,
+                    0)],
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(3, .ValSeq))
+      =>
+      0 |-> list(vCons(3, .ValSeq))
+      1 |-> list(sortVS(vCons(3, .ValSeq)))
+      2 |-> list(
