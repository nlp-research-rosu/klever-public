+        .Exprs)
+      => popcountAbs(I)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+
+  claim [key-negative]:
+    <k>
+      Call(
+        Lambda(
+          Params("value", .ParamNames),
+          CellVars(.ParamNames),
+          FreeVars(.ParamNames),
+          Call(
