+                    Call(
+                      Attribute(
+                        Call(Name("bin"), Name("value"), .Exprs),
+                        "count"),
+                      Str("1"),
+                      .Exprs))),
+                .Exprs))
+            .Stmts)))
+      ~> Call(Name("sort_array"), ref(0), .Exprs)
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              .Map[
+                "sort_array" <-
+                  closureVal(
