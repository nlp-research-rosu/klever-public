+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+
+  claim [key-negative]:
+    <k>
+      Call(
+        Lambda(
+          Params("value", .ParamNames),
+          CellVars(.ParamNames),
+          FreeVars(.ParamNames),
+          Call(
+            Attribute(
+              Call(Name("bin"), Name("value"), .Exprs),
+              "count"),
+            Str("1"),
+            .Exprs)),
+        Int(I:Int),
+        .Exprs)
+      => popcountAbs(I)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I <Int 0
+
+  // Whole-program partial correctness over an arbitrary finite integer list.
+  // Heap location 0 is the caller-owned input; locations 1 and 2 are the two
+  // new lists allocated by the two stable sorted() calls.
+  claim [sort-array]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "sort_array",
+            Params("arr", .ParamNames),
+            Return(
