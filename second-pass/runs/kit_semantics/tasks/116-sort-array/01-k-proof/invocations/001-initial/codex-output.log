+                          Name("arr"),
+                          .Exprs),
+                        KwArg(
+                          "key",
+                          Lambda(
+                            Params("value", .ParamNames),
+                            CellVars(.ParamNames),
+                            FreeVars(.ParamNames),
+                            Call(
+                              Attribute(
+                                Call(Name("bin"), Name("value"), .Exprs),
+                                "count"),
+                              Str("1"),
+                              .Exprs))),
