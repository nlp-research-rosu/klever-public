diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..981ffac186a4d04ed8d8fa2b05b31f654053a5f2
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: returning arr removes both sorted() calls.
+  // The original target postcondition must therefore be rejected.
+  claim [return-input-mutant]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "sort_array",
+            Params("arr", .ParamNames),
+            Return(Name("arr"))
+            .Stmts)))
+      ~> Call(Name("sort_array"), ref(0), .Exprs)
+      =>
+      ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?SCOPELOC:Int </scopeLoc>
+    <heap>
+      0 |-> list(vCons(3, vCons(4, .ValSeq)))
+      =>
+      ?HEAP:Map
+    </heap>
+    <heapLoc> 1 => ?HEAPLOC:Int </heapLoc>
+    <stack> .List => ?STACK:List </stack>
+    <ret> noRet => ?RET:RetState </ret>
+    <exc> NoExc => ?EXC:Exc </exc>
+    <exit-code> 0 => ?EXIT:Int </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..91631ed917cfa50a42e4f694e60cfae8767c7266
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the exact program returns the second newly allocated
+  // list at ref(2), not the intermediate numeric sort at ref(1).
+  claim [wrong-result]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "sort_array",
+            Params("arr", .ParamNames),
+            Return(
+              Call(
+                Name("sorted"),
+                Call(
+                  Name("sorted"),
+                  Name("arr"),
+                  .Exprs),
+                KwArg(
+                  "key",
+                  Lambda(
+                    Params("value", .ParamNames),
+                    CellVars(.ParamNames),
+                    FreeVars(.ParamNames),
+                    Call(
+                      Attribute(
+                        Call(Name("bin"), Name("value"), .Exprs),
+                        "count"),
+                      Str("1"),
+                      .Exprs))),
+                .Exprs))
+            .Stmts)))
+      ~> Call(Name("sort_array"), ref(0), .Exprs)
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              .Map[
+                "sort_array" <-
+                  closureVal(
+                    ("arr", .ParamNames),
+                    Return(
+                      Call(
+                        Name("sorted"),
+                        Call(
+                          Name("sorted"),
+                          Name("arr"),
+                          .Exprs),
+                        KwArg(
+                          "key",
+                          Lambda(
+                            Params("value", .ParamNames),
+                            CellVars(.ParamNames),
+                            FreeVars(.ParamNames),
+                            Call(
+                              Attribute(
+                                Call(Name("bin"), Name("value"), .Exprs),
+                                "count"),
+                              Str("1"),
+                              .Exprs))),
+                        .Exprs))
+                    .Stmts,
+                    0)],
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(3, .ValSeq))
+      =>
+      0 |-> list(vCons(3, .ValSeq))
+      1 |-> list(sortVS(vCons(3, .ValSeq)))
+      2 |-> list(
+             sortKeyVS(
+               sortVS(vCons(3, .ValSeq)),
+               closureValC(
+                 ("value", .ParamNames),
+                 .ParamNames,
+                 Return(
+                   Call(
+                     Attribute(
+                       Call(Name("bin"), Name("value"), .Exprs),
+                       "count"),
+                     Str("1"),
+                     .Exprs))
+                 .Stmts,
+                 .Map)))
+    </heap>
+    <heapLoc> 1 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..bea28b41f212abfd41f73f1db9e1e865f74e83a8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,168 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The exact program-defined key lambda.  These exhaustive sign cases cover
+  // every integer while making the fixed semantics' guarded bin rules usable.
+  claim [key-nonnegative]:
+    <k>
+      Call(
+        Lambda(
+          Params("value", .ParamNames),
+          CellVars(.ParamNames),
+          FreeVars(.ParamNames),
+          Call(
+            Attribute(
+              Call(Name("bin"), Name("value"), .Exprs),
+              "count"),
+            Str("1"),
+            .Exprs)),
+        Int(I:Int),
+        .Exprs)
+      => popcountAbs(I)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+
+  claim [key-negative]:
+    <k>
+      Call(
+        Lambda(
+          Params("value", .ParamNames),
+          CellVars(.ParamNames),
+          FreeVars(.ParamNames),
+          Call(
+            Attribute(
+              Call(Name("bin"), Name("value"), .Exprs),
+              "count"),
+            Str("1"),
+            .Exprs)),
+        Int(I:Int),
+        .Exprs)
+      => popcountAbs(I)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I <Int 0
+
+  // Whole-program partial correctness over an arbitrary finite integer list.
+  // Heap location 0 is the caller-owned input; locations 1 and 2 are the two
+  // new lists allocated by the two stable sorted() calls.
+  claim [sort-array]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "sort_array",
+            Params("arr", .ParamNames),
+            Return(
+              Call(
+                Name("sorted"),
+                Call(
+                  Name("sorted"),
+                  Name("arr"),
+                  .Exprs),
+                KwArg(
+                  "key",
+                  Lambda(
+                    Params("value", .ParamNames),
+                    CellVars(.ParamNames),
+                    FreeVars(.ParamNames),
+                    Call(
+                      Attribute(
+                        Call(Name("bin"), Name("value"), .Exprs),
+                        "count"),
+                      Str("1"),
+                      .Exprs))),
+                .Exprs))
+            .Stmts)))
+      ~> Call(Name("sort_array"), ref(0), .Exprs)
+      =>
+      ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              .Map[
+                "sort_array" <-
+                  closureVal(
+                    ("arr", .ParamNames),
+                    Return(
+                      Call(
+                        Name("sorted"),
+                        Call(
+                          Name("sorted"),
+                          Name("arr"),
+                          .Exprs),
+                        KwArg(
+                          "key",
+                          Lambda(
+                            Params("value", .ParamNames),
+                            CellVars(.ParamNames),
+                            FreeVars(.ParamNames),
+                            Call(
+                              Attribute(
+                                Call(Name("bin"), Name("value"), .Exprs),
+                                "count"),
+                              Str("1"),
+                              .Exprs))),
+                        .Exprs))
+                    .Stmts,
+                    0)],
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(VS:ValSeq)
+      =>
+      0 |-> list(VS)
+      1 |-> list(sortVS(VS))
+      2 |-> list(
+             sortKeyVS(
+               sortVS(VS),
+               closureValC(
+                 ("value", .ParamNames),
+                 .ParamNames,
+                 Return(
+                   Call(
+                     Attribute(
+                       Call(Name("bin"), Name("value"), .Exprs),
+                       "count"),
+                     Str("1"),
+                     .Exprs))
+                 .Stmts,
+                 .Map)))
+    </heap>
+    <heapLoc> 1 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allIntVS(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..39a2d0c05c569f5555e6693a2c5c44f6afdfe8c9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,21 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The source contract is over arbitrary finite lists of integers.
+  syntax Bool ::= allIntVS(ValSeq) [function, total]
+  rule allIntVS(.ValSeq) => true
+  rule allIntVS(vCons(V:Val, VS:ValSeq))
+    => isInt(V) andBool allIntVS(VS)
+
+  // Mathematical name for the value computed by
+  // bin(value).count("1").  The fixed semantics defines binCodes and cntSub.
+  syntax Int ::= popcountAbs(Int) [function, total]
+  rule popcountAbs(I:Int)
+    => cntSub(binCodes(I), iCons(49, .IntSeq))
+    requires I >=Int 0
+  rule popcountAbs(I:Int)
+    => cntSub(binCodes(0 -Int I), iCons(49, .IntSeq))
+    requires I <Int 0
+endmodule

apply patch
patch: completed
/workspace/smoke.py
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..21da2a86e01ed0b3ffb0678d780c4e9262724871
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,67 @@
+import itertools
+import random
+
+from solution import sort_array
+
+
+def arithmetic_popcount(value):
+    value = abs(value)
+    count = 0
+    while value:
+        value, bit = divmod(value, 2)
+        count += bit
+    return count
+
+
+def independent_oracle(values):
+    result = []
+    for value in values:
+        position = 0
+        value_key = (arithmetic_popcount(value), value)
+        while position < len(result):
+            other = result[position]
+            if value_key < (arithmetic_popcount(other), other):
+                break
+            position += 1
+        result.insert(position, value)
+    return result
+
+
+def main():
+    cases = [
+        [],
+        [0],
+        [1, 5, 2, 3, 4],
+        [-2, -3, -4, -5, -6],
+        [1, 0, 2, 3, 4],
+        [2, 5, 77, 4, 5, 3, 5, 7, 2, 3, 4],
+        [3, 6, 44, 12, 32, 5],
+        [2, 4, 8, 16, 32],
+    ]
+
+    alphabet = (-4, -3, -2, -1, 0, 1, 2, 3, 4)
+    for length in range(5):
+        cases.extend(list(values) for values in itertools.product(alphabet, repeat=length))
+
+    rng = random.Random(116)
+    for _ in range(2000):
+        length = rng.randrange(0, 21)
+        cases.append([rng.randrange(-(10**12), 10**12 + 1) for _ in range(length)])
+
+    mismatches = 0
+    for values in cases:
+        expected = independent_oracle(values)
+        actual = sort_array(values)
+        if actual != expected:
+            mismatches += 1
+            print("MISMATCH", values, expected, actual)
+            break
+
+    print(f"DIFFERENTIAL_CASES={len(cases)}")
+    print(f"MISMATCHES={mismatches}")
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
