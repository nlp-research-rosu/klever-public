Module(
  FuncDef("sort_array", Params("arr"),
    Return(
      Call(
        Name("sorted"),
        Call(Name("sorted"), Name("arr")),
        KwArg(
          "key",
          Lambda(
            Params("value"),
            CellVars(),
            FreeVars(),
            Call(
              Attribute(Call(Name("bin"), Name("value")), "count"),
              Str("1")))))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(1), Int(5), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(4), Int(3), Int(5)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(6)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(6)),
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(3))))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(1), Int(0), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(2), Int(4), Int(3)))))
  Assert(
    Compare(
      Call(Name("sort_array"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(2),
          Int(5),
          Int(77),
          Int(4),
          Int(5),
          Int(3),
          Int(5),
          Int(7),
          Int(2),
          Int(3),
          Int(4))),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(2),
          Int(4),
          Int(4),
          Int(3),
          Int(3),
          Int(5),
          Int(5),
          Int(5),
          Int(7),
          Int(77)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(3), Int(6), Int(44), Int(12), Int(32), Int(5))),
      CmpOp(
        "==",
        ListExpr(Int(32), Int(3), Int(5), Int(6), Int(12), Int(44)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(2), Int(4), Int(8), Int(16), Int(32))),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(8), Int(16), Int(32)))))
  Assert(
    Compare(
      Call(Name("sort_array"), ListExpr(Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(4), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(0),
          UnaryOp("-", Int(1)),
          Int(1),
          UnaryOp("-", Int(2)),
          Int(2),
          UnaryOp("-", Int(3)),
          Int(3),
          UnaryOp("-", Int(4)),
          Int(4))),
      CmpOp(
        "==",
        ListExpr(
          Int(0),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(1)),
          Int(1),
          Int(2),
          Int(4),
          UnaryOp("-", Int(3)),
          Int(3)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(7), Int(7), Int(3), Int(3), Int(1), Int(1), Int(0))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(1), Int(1), Int(3), Int(3), Int(7), Int(7)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(15),
          Int(8),
          Int(7),
          Int(16),
          UnaryOp("-", Int(15)),
          UnaryOp("-", Int(8)),
          UnaryOp("-", Int(7)),
          UnaryOp("-", Int(16)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(16)),
          UnaryOp("-", Int(8)),
          Int(8),
          Int(16),
          UnaryOp("-", Int(7)),
          Int(7),
          UnaryOp("-", Int(15)),
          Int(15)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(1023),
          Int(1024),
          Int(511),
          Int(512),
          Int(255),
          Int(256))),
      CmpOp(
        "==",
        ListExpr(
          Int(256),
          Int(512),
          Int(1024),
          Int(255),
          Int(511),
          Int(1023)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          UnaryOp("-", Int(1023)),
          UnaryOp("-", Int(1024)),
          UnaryOp("-", Int(511)),
          UnaryOp("-", Int(512)),
          UnaryOp("-", Int(255)),
          UnaryOp("-", Int(256)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(1024)),
          UnaryOp("-", Int(512)),
          UnaryOp("-", Int(256)),
          UnaryOp("-", Int(255)),
          UnaryOp("-", Int(511)),
          UnaryOp("-", Int(1023))))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(9),
          Int(10),
          Int(11),
          Int(12),
          Int(13),
          Int(14),
          Int(15),
          Int(16))),
      CmpOp(
        "==",
        ListExpr(
          Int(16),
          Int(9),
          Int(10),
          Int(12),
          Int(11),
          Int(13),
          Int(14),
          Int(15)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          UnaryOp("-", Int(9)),
          UnaryOp("-", Int(10)),
          UnaryOp("-", Int(11)),
          UnaryOp("-", Int(12)),
          UnaryOp("-", Int(13)),
          UnaryOp("-", Int(14)),
          UnaryOp("-", Int(15)),
          UnaryOp("-", Int(16)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(16)),
          UnaryOp("-", Int(12)),
          UnaryOp("-", Int(10)),
          UnaryOp("-", Int(9)),
          UnaryOp("-", Int(14)),
          UnaryOp("-", Int(13)),
          UnaryOp("-", Int(11)),
          UnaryOp("-", Int(15))))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(42),
          UnaryOp("-", Int(42)),
          Int(0),
          Int(1),
          UnaryOp("-", Int(1)),
          Int(2),
          UnaryOp("-", Int(2)))),
      CmpOp(
        "==",
        ListExpr(
          Int(0),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(1)),
          Int(1),
          Int(2),
          UnaryOp("-", Int(42)),
          Int(42)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(31),
          Int(3),
          Int(5),
          Int(6),
          Int(9),
          Int(10),
          Int(12),
          Int(17),
          Int(18),
          Int(20),
          Int(24))),
      CmpOp(
        "==",
        ListExpr(
          Int(3),
          Int(5),
          Int(6),
          Int(9),
          Int(10),
          Int(12),
          Int(17),
          Int(18),
          Int(20),
          Int(24),
          Int(31)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(64),
          Int(32),
          Int(16),
          Int(8),
          Int(4),
          Int(2),
          Int(1),
          Int(0))),
      CmpOp(
        "==",
        ListExpr(
          Int(0),
          Int(1),
          Int(2),
          Int(4),
          Int(8),
          Int(16),
          Int(32),
          Int(64)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          UnaryOp("-", Int(64)),
          UnaryOp("-", Int(32)),
          UnaryOp("-", Int(16)),
          UnaryOp("-", Int(8)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(1)),
          Int(0))),
      CmpOp(
        "==",
        ListExpr(
          Int(0),
          UnaryOp("-", Int(64)),
          UnaryOp("-", Int(32)),
          UnaryOp("-", Int(16)),
          UnaryOp("-", Int(8)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(1))))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(1000000000000),
          UnaryOp("-", Int(1000000000000)),
          Int(999999999999),
          UnaryOp("-", Int(999999999999)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(1000000000000)),
          Int(1000000000000),
          UnaryOp("-", Int(999999999999)),
          Int(999999999999))))))
