Module(
          FuncDef(
            "sort_array",
            Params("arr", .ParamNames),
            Return(
              Call(
                Name("sorted"),
                Call(
                  Name("sorted"),
                  Name("arr"),
                  .Exprs),
                KwArg(
                  "key",
                  Lambda(
                    Params("value", .ParamNames),
                    CellVars(.ParamNames),
                    FreeVars(.ParamNames),
                    Call(
                      Attribute(
                        Call(Name("bin"), Name("value"), .Exprs),
                        "count"),
                      Str("1"),
                      .Exprs))),
                .Exprs))
            .Stmts))
