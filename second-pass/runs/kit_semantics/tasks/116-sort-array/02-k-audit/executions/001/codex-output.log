+                    Return(
+                      Call(
+                        Name("sorted"),
+                        Call(
+                          Name("sorted"),
+                          Name("arr"),
+                          .Exprs),
+                        KwArg(
+                          "key",
+                          Lambda(
+                            Params("value", .ParamNames),
+                            CellVars(.ParamNames),
