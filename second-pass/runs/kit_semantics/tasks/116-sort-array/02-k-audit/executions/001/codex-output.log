+def sort_array(arr):
+    return sorted(
+        sorted(arr),
+        key=lambda value: bin(value).count("1"),
+    )
+
+
+assert sort_array([]) == []
+assert sort_array([0]) == [0]
+assert sort_array([3, 4]) == [4, 3]
+assert sort_array([1, 5, 2, 3, 4]) == [1, 2, 4, 3, 5]
+assert sort_array([-2, -3, -4, -5, -6]) == [-4, -2, -6, -5, -3]
+assert sort_array([1, 0, 2, 3, 4]) == [0, 1, 2, 4, 3]
+assert sort_array([0, -1, 1, -2, 2, -3, 3, -4, 4]) == [
+    0,
+    -4,
+    -2,
+    -1,
+    1,
+    2,
+    4,
+    -3,
+    3,
+]
+assert sort_array([7, 7, 3, 3, 1, 1, 0]) == [0, 1, 1, 3, 3, 7, 7]
+assert sort_array([1024, 1023, -1024, -1023]) == [-1024, 1024, -1023, 1023]
+assert sort_array([1000000000000, -1000000000000]) == [
+    -1000000000000,
+    1000000000000,
+]
