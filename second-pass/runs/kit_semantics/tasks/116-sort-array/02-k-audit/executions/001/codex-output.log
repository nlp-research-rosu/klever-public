+                              Str("1"),
+                              .Exprs))),
+                        .Exprs))
+                    .Stmts,
+                    0)],
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(3, vCons(4, vCons(-2, vCons(0, .ValSeq)))))
+      =>
+      0 |-> list(vCons(3, vCons(4, vCons(-2, vCons(0, .ValSeq)))))
+      1 |-> list(vCons(-2, vCons(0, vCons(3, vCons(4, .ValSeq)))))
+      2 |-> list(
+             sortKeyVS(
+               vCons(-2, vCons(0, vCons(3, vCons(4, .ValSeq)))),
+               closureValC(
+                 ("value", .ParamNames),
+                 .ParamNames,
+                 Return(
+                   Call(
+                     Attribute(
+                       Call(Name("bin"), Name("value"), .Exprs),
+                       "count"),
+                     Str("1"),
+                     .Exprs))
+                 .Stmts,
+                 .Map)))
+    </heap>
+    <heapLoc> 1 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
