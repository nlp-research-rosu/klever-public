   166	  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]
   167	  rule startsWith(.IntSeq, _:IntSeq)               => true
   168	  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false
   169	  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)
   170	endmodule

diff --git a//tmp/audit-work/116-sort-array/reviewer-smoke.py b//tmp/audit-work/116-sort-array/reviewer-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..aba4c19545ae4dde0154051e373ecfd95ac19a39
--- /dev/null
+++ b//tmp/audit-work/116-sort-array/reviewer-smoke.py
@@ -0,0 +1,30 @@
+def sort_array(arr):
+    return sorted(
+        sorted(arr),
+        key=lambda value: bin(value).count("1"),
+    )
+
+
+assert sort_array([]) == []
+assert sort_array([0]) == [0]
+assert sort_array([3, 4]) == [4, 3]
+assert sort_array([1, 5, 2, 3, 4]) == [1, 2, 4, 3, 5]
+assert sort_array([-2, -3, -4, -5, -6]) == [-4, -2, -6, -5, -3]
+assert sort_array([1, 0, 2, 3, 4]) == [0, 1, 2, 4, 3]
+assert sort_array([0, -1, 1, -2, 2, -3, 3, -4, 4]) == [
+    0,
+    -4,
+    -2,
+    -1,
+    1,
+    2,
+    4,
+    -3,
+    3,
+]
+assert sort_array([7, 7, 3, 3, 1, 1, 0]) == [0, 1, 1, 3, 3, 7, 7]
+assert sort_array([1024, 1023, -1024, -1023]) == [-1024, 1024, -1023, 1023]
+assert sort_array([1000000000000, -1000000000000]) == [
+    -1000000000000,
+    1000000000000,
+]
