     4	from solution import sort_array
     5	
     6	
     7	def arithmetic_popcount(value):
     8	    value = abs(value)
     9	    count = 0
    10	    while value:
    11	        value, bit = divmod(value, 2)
    12	        count += bit
    13	    return count
    14	
    15	
    16	def independent_oracle(values):
    17	    result = []
    18	    for value in values:
    19	        position = 0
    20	        value_key = (arithmetic_popcount(value), value)
    21	        while position < len(result):
    22	            other = result[position]
    23	            if value_key < (arithmetic_popcount(other), other):
    24	                break
    25	            position += 1
    26	        result.insert(position, value)
    27	    return result
    28	
    29	
    30	def main():
    31	    cases = [
    32	        [],
    33	        [0],
    34	        [1, 5, 2, 3, 4],
    35	        [-2, -3, -4, -5, -6],
    36	        [1, 0, 2, 3, 4],
    37	        [2, 5, 77, 4, 5, 3, 5, 7, 2, 3, 4],
    38	        [3, 6, 44, 12, 32, 5],
    39	        [2, 4, 8, 16, 32],
    40	    ]
    41	
    42	    alphabet = (-4, -3, -2, -1, 0, 1, 2, 3, 4)
    43	    for length in range(5):
    44	        cases.extend(list(values) for values in itertools.product(alphabet, repeat=length))
    45	
    46	    rng = random.Random(116)
    47	    for _ in range(2000):
    48	        length = rng.randrange(0, 21)
    49	        cases.append([rng.randrange(-(10**12), 10**12 + 1) for _ in range(length)])
    50	
    51	    mismatches = 0
    52	    for values in cases:
    53	        expected = independent_oracle(values)
    54	        actual = sort_array(values)
    55	        if actual != expected:
    56	            mismatches += 1
    57	            print("MISMATCH", values, expected, actual)
    58	            break
    59	
    60	    print(f"DIFFERENTIAL_CASES={len(cases)}")
    61	    print(f"MISMATCHES={mismatches}")
    62	    if mismatches:
    63	        raise SystemExit(1)
    64	
