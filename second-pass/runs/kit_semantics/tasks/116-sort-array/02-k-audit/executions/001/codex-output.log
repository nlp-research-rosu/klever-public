+      ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              .Map[
+                "sort_array" <-
+                  closureVal(
