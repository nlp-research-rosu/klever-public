+    "stage1_source_hash_count": len(audit["stage1_source_hashes"]),
+    "stage1_source_hash_mismatches": source_hash_mismatches,
+    "producer_hashes": producer_hashes,
+    "producer_checks": producer_checks,
+    "sidecar_checks": sidecar_checks,
+}
+report["overall"] = (
