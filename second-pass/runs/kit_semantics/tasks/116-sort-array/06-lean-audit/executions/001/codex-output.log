diff --git a//tmp/audit-work/hostpid_preload.c b//tmp/audit-work/hostpid_preload.c
new file mode 100644
index 0000000000000000000000000000000000000000..59398d7b342b2e27579e897fac665e4022cf1e60
--- /dev/null
+++ b//tmp/audit-work/hostpid_preload.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox exposes a /proc mount from outside its PID namespace.
+ * Lean 4.22 resolves /proc/<getpid()>/exe instead of /proc/self/exe. Return
+ * the host-visible PID encoded by /proc/self so Lean can locate its sysroot.
+ */
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length > 0) {
+    target[length] = '\0';
+    char *end = NULL;
+    errno = 0;
+    long value = strtol(target, &end, 10);
+    if (errno == 0 && end != target && *end == '\0' && value > 0 && value <= INT_MAX) {
+      return (pid_t)value;
+    }
+  }
+  return (pid_t)syscall(SYS_getpid);
+}
diff --git a//tmp/audit-work/test_pid_exe.c b//tmp/audit-work/test_pid_exe.c
new file mode 100644
index 0000000000000000000000000000000000000000..93505da798eb19be3f2da2b362db9f91f1dff27d
--- /dev/null
+++ b//tmp/audit-work/test_pid_exe.c
@@ -0,0 +1,17 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char link[128], path[4096];
+  snprintf(link, sizeof(link), "/proc/%d/exe", getpid());
+  ssize_t n = readlink(link, path, sizeof(path) - 1);
+  if (n < 0) {
+    printf("link=%s rc=%zd errno=%d message=%s\n", link, n, errno, strerror(errno));
+    return 1;
+  }
+  path[n] = 0;
+  printf("link=%s rc=%zd path=%s\n", link, n, path);
+  return 0;
+}
diff --git a//tmp/audit-work/test_uv_exepath.c b//tmp/audit-work/test_uv_exepath.c
new file mode 100644
index 0000000000000000000000000000000000000000..3638f313ae47266aa492b1ef97be109453e67025
--- /dev/null
+++ b//tmp/audit-work/test_uv_exepath.c
@@ -0,0 +1,13 @@
+#include <stdio.h>
+#include <stddef.h>
+
+int uv_exepath(char *buffer, size_t *size);
+const char *uv_err_name(int err);
+
+int main(void) {
+  char path[4096];
+  size_t size = sizeof(path);
+  int rc = uv_exepath(path, &size);
+  printf("rc=%d name=%s size=%zu path=%.*s\n", rc, uv_err_name(rc), size, (int)size, path);
+  return rc != 0;
+}
