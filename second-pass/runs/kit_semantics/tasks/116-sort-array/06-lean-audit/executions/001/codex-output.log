+}
+report["overall"] = (
+    all(item["match"] for item in top_level_checks.values())
+    and not source_hash_mismatches
+    and all(producer_checks.values())
+    and all(sidecar_checks.values())
+)
+print(json.dumps(report, indent=2, sort_keys=True))

