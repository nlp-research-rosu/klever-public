/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
expected_ids = [r['source_rule_id'] for r in inventory['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids)) == len(expected_ids)
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for entry in out['rules']:
    assert list(entry.keys()) == ['source_rule_id', 'classification', 'rationale'], entry
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
by_id = {e['source_rule_id']: e for e in out['rules']}
for rule in inventory['rules']:
    if 'simplification' in rule.get('attributes', []):
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print(f\"schema=2 hash=match rules={len(actual_ids)} unique={len(set(actual_ids))} order=match\")
from collections import Counter
print('classifications=' + json.dumps(Counter(e['classification'] for e in out['rules']), sort_keys=True))
