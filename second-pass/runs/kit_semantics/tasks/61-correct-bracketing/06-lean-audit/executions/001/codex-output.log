+    Lemmas.targetStatement constantFalse honestNe := by
+  intro Y _X C _h
+  simp [constantFalse, Lemmas.kite]
+
+-- A false disequality makes the obligation vacuous.
+theorem vacuousConstantDisequality :
+    Lemmas.targetStatement honestEq constantFalse := by
+  intro Y _X C h
+  simp [constantFalse] at h
+
+-- The opposite constant equality is rejected by a concrete non-vacuous case.
+theorem rejectsConstantTrueEquality :
+    ¬ Lemmas.targetStatement constantTrue honestNe := by
+  intro h
+  have bad := h 1 0 41 (by decide)
+  simp [constantTrue, Lemmas.kite] at bad
+
+-- An always-true disequality is rejected at C = 40 with unequal branches.
+theorem rejectsConstantTrueDisequality :
+    ¬ Lemmas.targetStatement honestEq constantTrue := by
+  intro h
+  have bad := h 1 0 40 (by decide)
+  simp [honestEq, constantTrue, Lemmas.kite] at bad
+
+end Counterfactual
