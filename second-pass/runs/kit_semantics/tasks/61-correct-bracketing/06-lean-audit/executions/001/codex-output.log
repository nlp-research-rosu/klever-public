every prefix processed so far had nonnegative balance.\n    10\t  syntax Bool ::= scanBrackets(IntSeq, Int, Bool) [function, total]\n    11\t  rule scanBrackets(.IntSeq, B:Int, V:Bool)\n    12\t    => V andBool B ==Int 0\n    13\t  rule scanBrackets(iCons(C:Int, REST:IntSeq), B:Int, V:Bool)\n    14\t    => scanBrackets(\n    15\t         REST,\n    16\t         #if C ==Int 40 #then B +Int 1 #else B -Int 1 #fi,\n    17\t         keepValid(\n    18\t           #if C ==Int 40 #then B +Int 1 #else B -Int 1 #fi,\n    19\t           V))\n    20\t\n    21\t  // This is the source-level `if balance < 0: valid = False`.\n    22\t  syntax Bool ::= keepValid(Int, Bool) [function, total]\n    23\t  rule keepValid(B:Int, _:Bool) => false requires B <Int 0\n    24\t  rule keepValid(B:Int, V:Bool) => V     requires B >=Int 0\n    25\t\n    26\t  // The backend does not otherwise simplify this polymorphic conditional from\n    27\t  // the symbolic disequality emitted by the source-level `else` branch.\n    28\t  rule (#if C ==Int 40 #then _X:Int #else Y:Int #fi) => Y\n    29\t    requires C =/=Int 40\n    30\t    [simplification]\n    31\t\n    32\t  // Exact formalization of prompt.py's input domain.\n    33\t  syntax Bool ::= bracketInput(IntSeq) [function, total]\n    34\t  rule bracketInput(.IntSeq) => true\n    35\t  rule bracketInput(iCons(C:Int, REST:IntSeq))\n    36\t    => (C ==Int 40 orBool C ==Int 41) andBool bracketInput(REST)\n    37\tendmodule\nFILE /candidate/verification-with-loop.k\n     1\trequires \"verification.k\"\n     2\t\n     3\tmodule VERIFICATION-WITH-LOOP\n     4\t  imports VERIFICATION\n     5\t\n     6\t  // Auxiliary execution theorem.  prove.sh first proves the identical\n     7\t  // SPEC.loop claim against VERIFICATION, before this module is compiled.\n     8\t  rule [loop-lemma]:\n     9\t    <k>\n    10\t      #loop(\n    11\t        str(CS:IntSeq),\n    12\t        Name(\"bracket\"),\n    13\t        If(\n    14\t          Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n    15\t          AugAssign(Name(\"balance\"), \"+\", Int(1)),\n    16\t          AugAssign(Name(\"balance\"), \"-\", Int(1)))\n    17\t        If(\n    18\t          Compare(Name(\"balance\"), CmpOp(\"<\", Int(0))),\n    19\t          Assign(Name(\"valid\"), Bool(false)),\n    20\t          .Stmts))\n    21\t      ~> (Return(\n    22\t            BoolOp(\n    23\t              \"and\",\n    24\t              Name(\"valid\"),\n    25\t              Compare(Name(\"balance\"), CmpOp(\"==\", Int(0)))))\n    26\t          .Stmts)\n    27\t      ~> #endcall\n    28\t      =>\n    29\t      scanBrackets(CS, B:Int, V:Bool)\n    30\t    </k>\n    31\t    <env> 1 => 0 </env>\n    32\t    <scopes>\n    33\t      ( -1 |-> BUILTINS:Scope\n    34\t         0 |-> scope(MODULE:Map, parent(-1))\n    35\t         1 |-> scope(\n    36\t                \"bracket\" |-> _OLD:Val\n    37\t                \"brackets\" |-> str(_INPUT:IntSeq)\n    38\t                \"balance\" |-> B\n    39\t                \"valid\" |-> V,\n    40\t                parent(0)) )\n    41\t      =>\n    42\t      ( -1 |-> BUILTINS\n    43\t         0 |-> scope(MODULE, parent(-1)) )\n    44\t    </scopes>\n    45\t    <scopeLoc> 2 => 1 </scopeLoc>\n    46\t    <heap> .Map </heap>\n    47\t    <heapLoc> 0 </heapLoc>\n    48\t    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n    49\t    <ret> noRet </ret>\n    50\t    <exc> NoExc </exc>\n    51\t    <exit-code> 0 </exit-code>\n    52\t    requires bracketInput(CS)\n    53\t    [priority(40)]\n    54\tendmodule\nFILE /candidate/spec.k\n     1\trequires \"verification.k\"\n     2\t\n     3\tmodule SPEC\n     4\t  imports VERIFICATION\n     5\t\n     6\t  claim [loop]:\n     7\t    <k>\n     8\t      #loop(\n     9\t        str(CS:IntSeq),\n    10\t        Name(\"bracket\"),\n    11\t        If(\n    12\t          Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n    13\t          AugAssign(Name(\"balance\"), \"+\", Int(1)),\n    14\t          AugAssign(Name(\"balance\"), \"-\", Int(1)))\n    15\t        If(\n    16\t          Compare(Name(\"balance\"), CmpOp(\"<\", Int(0))),\n    17\t          Assign(Name(\"valid\"), Bool(false)),\n    18\t          .Stmts))\n    19\t      ~> (Return(\n    20\t            BoolOp(\n    21\t              \"and\",\n    22\t              Name(\"valid\"),\n    23\t              Compare(Name(\"balance\"), CmpOp(\"==\", Int(0)))))\n    24\t          .Stmts)\n    25\t      ~> #endcall\n    26\t      =>\n    27\t      scanBrackets(CS, B:Int, V:Bool)\n    28\t    </k>\n    29\t    <env> 1 => 0 </env>\n    30\t    <scopes>\n    31\t      ( -1 |-> BUILTINS:Scope\n    32\t         0 |-> scope(MODULE:Map, parent(-1))\n    33\t         1 |-> scope(\n    34\t                \"bracket\" |-> _OLD:Val\n    35\t                \"brackets\" |-> str(_INPUT:IntSeq)\n    36\t                \"balance\" |-> B\n    37\t                \"valid\" |-> V,\n    38\t                parent(0)) )\n    39\t      =>\n    40\t      ( -1 |-> BUILTINS\n    41\t         0 |-> scope(MODULE, parent(-1)) )\n    42\t    </scopes>\n    43\t    <scopeLoc> 2 => 1 </scopeLoc>\n    44\t    <heap> .Map </heap>\n    45\t    <heapLoc> 0 </heapLoc>\n    46\t    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n    47\t    <ret> noRet </ret>\n    48\t    <exc> NoExc </exc>\n    49\t    <exit-code> 0 </exit-code>\n    50\t    requires bracketInput(CS)\n    51\t\n    52\t  claim [correct-bracketing]:\n    53\t    <k>\n    54\t      #loadAll(\n    55\t        Module(\n    56\t          FuncDef(\n    57\t            \"correct_bracketing\",\n    58\t            Params(\"brackets\"),\n    59\t            Assign(Name(\"balance\"), Int(0))\n    60\t            Assign(Name(\"valid\"), Bool(true))\n    61\t            For(\n    62\t              Name(\"bracket\"),\n    63\t              Name(\"brackets\"),\n    64\t              If(\n    65\t                Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n    66\t                AugAssign(Name(\"balance\"), \"+\", Int(1)),\n    67\t                AugAssign(Name(\"balance\"), \"-\", Int(1)))\n    68\t              If(\n    69\t                Compare(Name(\"balance\"), CmpOp(\"<\", Int(0))),\n    70\t                Assign(Name(\"valid\"), Bool(false)),\n    71\t                .Stmts))\n    72\t            Return(\n    73\t              BoolOp(\n    74\t                \"and\",\n    75\t                Name(\"valid\"),\n    76\t                Compare(Name(\"balance\"), CmpOp(\"==\", Int(0))))))))\n    77\t      ~> Call(Name(\"correct_bracketing\"), str(CS:IntSeq))\n    78\t      =>\n    79\t      scanBrackets(CS, 0, true)\n    80\t    </k>\n    81\t    <env> 0 </env>\n    82\t    <scopes>\n    83\t      -1 |-> builtinsScope\n    84\t      0 |-> scope(\n    85\t        .Map\n    86\t        =>\n    87\t        \"correct_bracketing\" |->\n    88\t          closureVal(\n    89\t            \"brackets\",\n    90\t            Assign(Name(\"balance\"), Int(0))\n    91\t            Assign(Name(\"valid\"), Bool(true))\n    92\t            For(\n    93\t              Name(\"bracket\"),\n    94\t              Name(\"brackets\"),\n    95\t              If(\n    96\t                Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n    97\t                AugAssign(Name(\"balance\"), \"+\", Int(1)),\n    98\t                AugAssign(Name(\"balance\"), \"-\", Int(1)))\n    99\t              If(\n   100\t                Compare(Name(\"balance\"), CmpOp(\"<\", Int(0))),\n   101\t                Assign(Name(\"valid\"), Bool(false)),\n   102\t                .Stmts))\n   103\t            Return(\n   104\t              BoolOp(\n   105\t                \"and\",\n   106\t                Name(\"valid\"),\n   107\t                Compare(Name(\"balance\"), CmpOp(\"==\", Int(0))))),\n   108\t            0),\n   109\t        parent(-1))\n   110\t    </scopes>\n   111\t    <scopeLoc> 1 </scopeLoc>\n   112\t    <heap> .Map </heap>\n   113\t    <heapLoc> 0 </heapLoc>\n   114\t    <stack> .List </stack>\n   115\t    <ret> noRet </ret>\n   116\t    <exc> NoExc </exc>\n   117\t    <exit-code> 0 </exit-code>\n   118\t    requires bracketInput(CS)\n   119\tendmodule\nFILE /candidate/spec-vacuity.k\n     1\trequires \"verification.k\"\n     2\t\n     3\tmodule SPEC-VACUITY\n     4\t  imports VERIFICATION\n     5\t\n     6\t  // Gate A non-vacuity probe: \"()\" is realizable and returns true.  This\n     7\t  // deliberately false result also exercises the installed loop bridge.\n     8\t  claim [pair-is-false]:\n     9\t    <k>\n    10\t      #loadAll(\n    11\t        Module(\n    12\t          FuncDef(\n    13\t            \"correct_bracketing\",\n    14\t            Params(\"brackets\"),\n    15\t            Assign(Name(\"balance\"), Int(0))\n    16\t            Assign(Name(\"valid\"), Bool(true))\n    17\t            For(\n    18\t              Name(\"bracket\"),\n    19\t              Name(\"brackets\"),\n    20\t              If(\n    21\t                Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n    22\t                AugAssign(Name(\"balance\"), \"+\", Int(1)),\n    23\t                AugAssign(Name(\"balance\"), \"-\", Int(1)))\n    24\t              If(\n    25\t                Compare(Name(\"balance\"), CmpOp(\"<\", Int(0))),\n    26\t                Assign(Name(\"valid\"), Bool(false)),\n    27\t                .Stmts))\n    28\t            Return(\n    29\t              BoolOp(\n    30\t                \"and\",\n    31\t                Name(\"valid\"),\n    32\t                Compare(Name(\"balance\"), CmpOp(\"==\", Int(0))))))))\n    33\t      ~> Call(\n    34\t           Name(\"correct_bracketing\"),\n    35\t           str(iCons(40, iCons(41, .IntSeq))))\n    36\t      =>\n    37\t      false\n    38\t    </k>\n    39\t    <env> 0 </env>\n    40\t    <scopes>\n    41\t      -1 |-> builtinsScope\n    42\t      0 |-> scope(\n    43\t        .Map\n    44\t        =>\n    45\t        \"correct_bracketing\" |->\n    46\t          closureVal(\n    47\t            \"brackets\",\n    48\t            Assign(Name(\"balance\"), Int(0))\n    49\t            Assign(Name(\"valid\"), Bool(true))\n    50\t            For(\n    51\t              Name(\"bracket\"),\n    52\t              Name(\"brackets\"),\n    53\t              If(\n    54\t                Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n    55\t                AugAssign(Name(\"balance\"), \"+\", Int(1)),\n    56\t                AugAssign(Name(\"balance\"), \"-\", Int(1)))\n    57\t              If(\n    58\t                Compare(Name(\"balance\"), CmpOp(\"<\", Int(0))),\n    59\t                Assign(Name(\"valid\"), Bool(false)),\n    60\t                .Stmts))\n    61\t            Return(\n    62\t              BoolOp(\n    63\t                \"and\",\n    64\t                Name(\"valid\"),\n    65\t                Compare(Name(\"balance\"), CmpOp(\"==\", Int(0))))),\n    66\t            0),\n    67\t        parent(-1))\n    68\t    </scopes>\n    69\t    <scopeLoc> 1 </scopeLoc>\n    70\t    <heap> .Map </heap>\n    71\t    <heapLoc> 0 </heapLoc>\n    72\t    <stack> .List </stack>\n    73\t    <ret> noRet </ret>\n    74\t    <exc> NoExc </exc>\n    75\t    <exit-code> 0 </exit-code>\n    76\tendmodule\nFILE /candidate/spec-value-mutation.k\n     1\trequires \"verification-with-loop.k\"\n     2\t\n     3\tmodule SPEC-VALUE-MUTATION\n     4\t  imports VERIFICATION-WITH-LOOP\n     5\t\n     6\t  // Opposite-value probe for a false-producing bridge state: one unmatched\n     7\t  // opening bracket remains in the balance, so the actual result is false.\n     8\t  claim [unmatched-open-is-true]:\n     9\t    <k>\n    10\t      #loop(\n    11\t        str(.IntSeq),\n    12\t        Name(\"bracket\"),\n    13\t        If(\n    14\t          Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n    15\t          AugAssign(Name(\"balance\"), \"+\", Int(1)),\n    16\t          AugAssign(Name(\"balance\"), \"-\", Int(1)))\n    17\t        If(\n    18\t          Compare(Name(\"balance\"), CmpOp(\"<\", Int(0))),\n    19\t          Assign(Name(\"valid\"), Bool(false)),\n    20\t          .Stmts))\n    21\t      ~> (Return(\n    22\t            BoolOp(\n    23\t              \"and\",\n    24\t              Name(\"valid\"),\n    25\t              Compare(Name(\"balance\"), CmpOp(\"==\", Int(0)))))\n    26\t          .Stmts)\n    27\t      ~> #endcall\n    28\t      =>\n    29\t      true\n    30\t    </k>\n    31\t    <env> 1 => 0 </env>\n    32\t    <scopes>\n    33\t      ( -1 |-> BUILTINS:Scope\n    34\t         0 |-> scope(MODULE:Map, parent(-1))\n    35\t         1 |-> scope(\n    36\t                \"bracket\" |-> str(iCons(40, .IntSeq))\n    37\t                \"brackets\" |-> str(iCons(40, .IntSeq))\n    38\t                \"balance\" |-> 1\n    39\t                \"valid\" |-> true,\n    40\t                parent(0)) )\n    41\t      =>\n    42\t      ( -1 |-> BUILTINS\n    43\t         0 |-> scope(MODULE, parent(-1)) )\n    44\t    </scopes>\n    45\t    <scopeLoc> 2 => 1 </scopeLoc>\n    46\t    <heap> .Map </heap>\n    47\t    <heapLoc> 0 </heapLoc>\n    48\t    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n    49\t    <ret> noRet </ret>\n    50\t    <exc> NoExc </exc>\n    51\t    <exit-code> 0 </exit-code>\n    52\tendmodule\nFILE /candidate/spec-body-mutation.k\n     1\trequires \"verification.k\"\n     2\t\n     3\tmodule SPEC-BODY-MUTATION\n     4\t  imports VERIFICATION\n     5\t\n     6\t  // Gate A body-sensitivity probe: changing the opening-bracket increment\n     7\t  // from 1 to 2 must invalidate the fixed-semantics connection theorem.\n     8\t  claim [mutated-loop]:\n     9\t    <k>\n    10\t      #loop(\n    11\t        str(CS:IntSeq),\n    12\t        Name(\"bracket\"),\n    13\t        If(\n    14\t          Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n    15\t          AugAssign(Name(\"balance\"), \"+\", Int(2)),\n    16\t          AugAssign(Name(\"balance\"), \"-\", Int(1)))\n    17\t        If(\n    18\t          Compare(Name(\"balance\"), CmpOp(\"<\", Int(0))),\n    19\t          Assign(Name(\"valid\"), Bool(false)),\n    20\t          .Stmts))\n    21\t      ~> (Return(\n    22\t            BoolOp(\n    23\t              \"and\",\n    24\t              Name(\"valid\"),\n    25\t              Compare(Name(\"balance\"), CmpOp(\"==\", Int(0)))))\n    26\t          .Stmts)\n    27\t      ~> #endcall\n    28\t      =>\n    29\t      scanBrackets(CS, B:Int, V:Bool)\n    30\t    </k>\n    31\t    <env> 1 => 0 </env>\n    32\t    <scopes>\n    33\t      ( -1 |-> BUILTINS:Scope\n    34\t         0 |-> scope(MODULE:Map, parent(-1))\n    35\t         1 |-> scope(\n    36\t                \"bracket\" |-> _OLD:Val\n    37\t                \"brackets\" |-> str(_INPUT:IntSeq)\n    38\t                \"balance\" |-> B\n    39\t                \"valid\" |-> V,\n    40\t                parent(0)) )\n    41\t      =>\n    42\t      ( -1 |-> BUILTINS\n    43\t         0 |-> scope(MODULE, parent(-1)) )\n    44\t    </scopes>\n    45\t    <scopeLoc> 2 => 1 </scopeLoc>\n    46\t    <heap> .Map </heap>\n    47\t    <heapLoc> 0 </heapLoc>\n    48\t    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n    49\t    <ret> noRet </ret>\n    50\t    <exc> NoExc </exc>\n    51\t    <exit-code> 0 </exit-code>\n    52\t    requires bracketInput(CS)\n    53\tendmodule\nFILE /candidate/prove.sh\n     1\t#!/usr/bin/env bash\n     2\tset -euo pipefail\n     3\t\n     4\techo \"== Translate and check the exact solution ==\"\n     5\tcmp solution.mpy <(python3 py2mpy.py solution.py)\n     6\tpython3 py2mpy.py concrete_tests.py > concrete_tests.mpy\n     7\tpython3 py2mpy.py bridge_context_tests.py > bridge_context_tests.mpy\n     8\tpython3 differential_test.py\n     9\t\n    10\techo \"== Compile the supplied semantics for concrete LLVM execution ==\"\n    11\tkompile reference-semantics/semantics.k \\\n    12\t  --backend llvm \\\n    13\t  --main-module MPY-KRUN \\\n    14\t  --syntax-module MPY-SYNTAX \\\n    15\t  --output-definition runtime-kompiled\n    16\t\n    17\techo \"== Exercise the exact implementation concretely ==\"\n    18\tCONCRETE_RESULT=\"$(krun concrete_tests.mpy --definition runtime-kompiled)\"\n    19\tgrep -F '\"case_empty\" |-> true' <<<\"$CONCRETE_RESULT\"\n    20\tgrep -F '\"case_open\" |-> false' <<<\"$CONCRETE_RESULT\"\n    21\tgrep -F '\"case_pair\" |-> true' <<<\"$CONCRETE_RESULT\"\n    22\tgrep -F '\"case_nested\" |-> true' <<<\"$CONCRETE_RESULT\"\n    23\tgrep -F '\"case_bad_prefix\" |-> false' <<<\"$CONCRETE_RESULT\"\n    24\t\n    25\techo \"== Compile the bridge-free symbolic definition ==\"\n    26\tkompile verification.k \\\n    27\t  --backend haskell \\\n    28\t  --main-module VERIFICATION \\\n    29\t  --syntax-module MPY-SYNTAX \\\n    30\t  --output-definition verification-kompiled\n    31\t\n    32\techo \"== Positive proof 1: universal loop theorem, bridge-free ==\"\n    33\tkprove spec.k \\\n    34\t  --definition verification-kompiled \\\n    35\t  --spec-module SPEC \\\n    36\t  --claims SPEC.loop\n    37\t\n    38\techo \"== Compile the proved loop theorem as an exact operational lemma ==\"\n    39\tkompile verification-with-loop.k \\\n    40\t  --backend haskell \\\n    41\t  --main-module VERIFICATION-WITH-LOOP \\\n    42\t  --syntax-module MPY-SYNTAX \\\n    43\t  --output-definition verification-with-loop-kompiled\n    44\t\n    45\techo \"== Positive proof 2: exact whole-program entry theorem ==\"\n    46\tkprove spec.k \\\n    47\t  --definition verification-with-loop-kompiled \\\n    48\t  --spec-module SPEC \\\n    49\t  --claims SPEC.correct-bracketing\n    50\t\n    51\techo \"== Fixed-versus-bridge complete-state and context-containment checks ==\"\n    52\tFIXED_CONTEXT=\"$(krun bridge_context_tests.mpy --definition runtime-kompiled)\"\n    53\tBRIDGE_CONTEXT=\"$(\n    54\t  krun bridge_context_tests.mpy --definition verification-with-loop-kompiled\n    55\t)\"\n    56\ttest \"$FIXED_CONTEXT\" = \"$BRIDGE_CONTEXT\"\n    57\tgrep -F '\"context_result\" |-> false' <<<\"$FIXED_CONTEXT\"\n    58\t\n    59\techo \"== Expected failure: false whole-program result ==\"\n    60\tif kprove spec-vacuity.k \\\n    61\t  --definition verification-with-loop-kompiled \\\n    62\t  --spec-module SPEC-VACUITY\n    63\tthen\n    64\t  echo \"ERROR: false postcondition unexpectedly proved\"\n    65\t  exit 1\n    66\telse\n    67\t  VACUITY_STATUS=$?\n    68\t  echo \"EXPECTED FAILURE exit=$VACUITY_STATUS\"\n    69\tfi\n    70\t\n    71\techo \"== Expected failure: opposite bridge value ==\"\n    72\tif kprove spec-value-mutation.k \\\n    73\t  --definition verification-with-loop-kompiled \\\n    74\t  --spec-module SPEC-VALUE-MUTATION\n    75\tthen\n    76\t  echo \"ERROR: opposite bridge value unexpectedly proved\"\n    77\t  exit 1\n    78\telse\n    79\t  VALUE_STATUS=$?\n    80\t  echo \"EXPECTED FAILURE exit=$VALUE_STATUS\"\n    81\tfi\n    82\t\n    83\techo \"== Expected failure: mutated source body breaks the connection theorem ==\"\n    84\tif kprove spec-body-mutation.k \\\n    85\t  --definition verification-kompiled \\\n    86\t  --spec-module SPEC-BODY-MUTATION\n    87\tthen\n    88\t  echo \"ERROR: mutated body unexpectedly proved\"\n    89\t  exit 1\n    90\telse\n    91\t  BODY_STATUS=$?\n    92\t  echo \"EXPECTED FAILURE exit=$BODY_STATUS\"\n    93\tfi\nFILE /candidate/PROOF.md\n     1\tVALIDATED\n     2\t\n     3\t## What is proven\n     4\t\n     5\tThis is a machine-checked partial-correctness proof under the supplied MPY\n     6\tsemantics.  For every finite MPY string whose character codes are only 40\n     7\t(`(`) or 41 (`)`), the exact `correct_bracketing` definition translated from\n     8\t`solution.py`, when loaded into the initial MPY configuration and called with\n     9\tthat string, returns…4199 tokens truncated…(future) K semantics will parse. The design rule is strict:\n     6\t\n     7\t    PURE TRANSLITERATION. Every Python AST node maps to exactly one K\n     8\t    constructor with the same structure. The front-end makes NO semantic\n     9\t    decisions — it does not desugar, simplify, normalize, or \"interpret\"\n    10\t    anything. All meaning lives in the K semantics that consumes the term.\n    11\t\n    12\tConsequences of that rule (vs. a \"helpful\" front-end):\n    13\t\n    14\t  * `is` / `is not` transliterate to `CmpOp(\"is\", ...)` / `CmpOp(\"is not\", ...)`\n    15\t    — NOT to `==` / `!=`. K decides what identity means.\n    16\t  * a chained comparison `a < b < c` stays a single `Compare` carrying the\n    17\t    chain (`Compare(a, CmpOp(\"<\", b), CmpOp(\"<\", c))`) — it is NOT pre-expanded\n    18\t    into `a < b and b < c`.\n    19\t  * a method call `x.append(v)` stays `Call(Attribute(Name(\"x\"), \"append\"), v)`\n    20\t    — there is no special `MethodCall` constructor folding the receiver in.\n    21\t  * `a[i] = v` stays `Assign(Subscript(Name(\"a\"), Name(\"i\")), v)` — the target\n    22\t    is just an expression in store position; no special `SubscriptAssign`.\n    23\t\n    24\tThe only choices the transliterator makes are unavoidably *syntactic* — e.g. a\n    25\t`bool` literal becomes `Bool(...)` not `Int(...)`, because that is the literal's\n    26\tactual Python type as read off the AST, not a semantic judgement.\n    27\t\n    28\tAnything outside the covered subset raises `Unsupported`, naming the node, so\n    29\tcoverage gaps fail loudly instead of being silently dropped.\n    30\t\n    31\tUsage:\n    32\t    python scripts/py2mpy.py FILE.py          # print the .mpy term (default)\n    33\t    python scripts/py2mpy.py FILE.py --ast    # print the Python AST (ast.dump)\n    34\t\"\"\"\n    35\tfrom __future__ import annotations\n    36\t\n    37\timport argparse\n    38\timport symtable\n    39\timport ast\n    40\timport json\n    41\timport sys\n    42\t\n    43\t\n    44\tclass Unsupported(Exception):\n    45\t    \"\"\"Raised for any AST node the transliterator does not cover.\"\"\"\n    46\t\n    47\t\n    48\t# ---------------------------------------------------------------------------\n    49\t# Term model: a .mpy term is a tree of these three node kinds.\n    50\t#   Ctor(name, *args)  -> `name(arg, arg, ...)`  (comma-separated args)\n    51\t#   Seq([item, ...])   -> a statement list: juxtaposed, no parens, no commas\n    52\t#   str                -> a leaf token already in K surface form\n    53\t#                         (a quoted string `\"op\"`, a number `0`, `true`, `Break`)\n    54\t# ---------------------------------------------------------------------------\n    55\tclass Ctor:\n    56\t    __slots__ = (\"name\", \"args\")\n    57\t\n    58\t    def __init__(self, name: str, *args):\n    59\t        self.name = name\n    60\t        self.args = list(args)\n    61\t\n    62\t\n    63\tclass Seq:\n    64\t    __slots__ = (\"items\",)\n    65\t\n    66\t    def __init__(self, items):\n    67\t        self.items = list(items)\n    68\t\n    69\t\n    70\tdef q(s: str) -> str:\n    71\t    \"\"\"A Python string as a K String token (double-quoted, escaped).\"\"\"\n    72\t    return json.dumps(s)\n    73\t\n    74\t\n    75\t# --- Operator spellings (string tokens carried inside constructors) ----------\n    76\t# These are transliterations of the operator *symbol*, not its meaning.\n    77\t_BINOP = {\n    78\t    ast.Add: \"+\", ast.Sub: \"-\", ast.Mult: \"*\", ast.Div: \"/\",\n    79\t    ast.FloorDiv: \"//\", ast.Mod: \"%\", ast.Pow: \"**\",\n    80\t    ast.BitOr: \"|\", ast.BitAnd: \"&\", ast.BitXor: \"^\",\n    81\t    ast.LShift: \"<<\", ast.RShift: \">>\", ast.MatMult: \"@\",\n    82\t}\n    83\t_UNARY = {ast.USub: \"-\", ast.UAdd: \"+\", ast.Not: \"not\", ast.Invert: \"~\"}\n    84\t_BOOLOP = {ast.And: \"and\", ast.Or: \"or\"}\n    85\t_CMPOP = {\n    86\t    ast.Eq: \"==\", ast.NotEq: \"!=\", ast.Lt: \"<\", ast.LtE: \"<=\",\n    87\t    ast.Gt: \">\", ast.GtE: \">=\", ast.Is: \"is\", ast.IsNot: \"is not\",\n    88\t    ast.In: \"in\", ast.NotIn: \"not in\",\n    89\t}\n    90\t\n    91\t\n    92\t# ---------------------------------------------------------------------------\n    93\t# Closure scopes (Python's own symtable, faithfully exposed)\n    94\t# ---------------------------------------------------------------------------\n    95\t# (name, lineno) -> (cellvars, freevars, nested). A def/lambda gets the\n    96\t# ANNOTATED node form iff it is nested inside a function or has cells/frees;\n    97\t# module-level capture-free defs keep the old shape (zero churn).\n    98\tSCOPES: dict = {}\n    99\t\n   100\t\n   101\tdef _frees(table):\n   102\t    return set(table.get_frees()) if isinstance(table, symtable.Function) else set()\n   103\t\n   104\t\n   105\tdef _deep_frees(table):\n   106\t    out = _frees(table)\n   107\t    for g in table.get_children():\n   108\t        out |= _deep_frees(g) - set(table.get_locals())\n   109\t    return out\n   110\t\n   111\t\n   112\tdef _walk_symtable(table, depth=0):\n   113\t    for child in table.get_children():\n   114\t        if child.get_type() in (\"function\", \"lambda\"):\n   115\t            frees = sorted(_frees(child))\n   116\t            cells = sorted(\n   117\t                s for s in child.get_locals()\n   118\t                if any(s in _deep_frees(g) for g in child.get_children())\n   119\t            )\n   120\t            SCOPES[(child.get_name(), child.get_lineno())] = (\n   121\t                cells, frees, depth > 0 or table.get_type() != \"module\")\n   122\t        _walk_symtable(child, depth + (1 if child.get_type() in (\"function\", \"lambda\") else 0))\n   123\t\n   124\t\n   125\tdef scope_info(name, lineno):\n   126\t    return SCOPES.get((name, lineno))\n   127\t\n   128\t\n   129\t# ---------------------------------------------------------------------------\n   130\t# Expressions\n   131\t# ---------------------------------------------------------------------------\n   132\tdef emit_expr(node: ast.expr):\n   133\t    if isinstance(node, ast.Constant):\n   134\t        v = node.value\n   135\t        if v is None:\n   136\t            return \"NoneVal\"\n   137\t        if isinstance(v, bool):                 # MUST precede int (bool ⊂ int)\n   138\t            return Ctor(\"Bool\", \"true\" if v else \"false\")\n   139\t        if isinstance(v, int):\n   140\t            return Ctor(\"Int\", str(v))\n   141\t        if isinstance(v, float):\n   142\t            return Ctor(\"Float\", repr(v))\n   143\t        if isinstance(v, str):\n   144\t            return Ctor(\"Str\", q(v))\n   145\t        raise Unsupported(f\"Constant {type(v).__name__}\")\n   146\t\n   147\t    if isinstance(node, ast.Name):\n   148\t        return Ctor(\"Name\", q(node.id))\n   149\t\n   150\t    if isinstance(node, ast.Lambda):\n   151\t        a = node.args\n   152\t        if a.vararg or a.kwarg or a.kwonlyargs or a.defaults or a.kw_defaults:\n   153\t            raise Unsupported(\"complex lambda signature\")\n   154\t        names = [p.arg for p in (a.posonlyargs + a.args)]\n   155\t        params = Ctor(\"Params\", *(q(n) for n in names))\n   156\t        info = scope_info(\"lambda\", node.lineno)\n   157\t        if info and (info[0] or info[1] or info[2]):\n   158\t            cells, frees, _ = info\n   159\t            return Ctor(\"Lambda\", params,\n   160\t                        Ctor(\"CellVars\", *(q(n) for n in cells)),\n   161\t                        Ctor(\"FreeVars\", *(q(n) for n in frees)),\n   162\t                        emit_expr(node.body))\n   163\t        return Ctor(\"Lambda\", params, emit_expr(node.body))\n   164\t\n   165\t    if isinstance(node, ast.BinOp):\n   166\t        op = _BINOP.get(type(node.op))\n   167\t        if op is None:\n   168\t            raise Unsupported(f\"BinOp {type(node.op).__name__}\")\n   169\t        return Ctor(\"BinOp\", q(op), emit_expr(node.left), emit_expr(node.right))\n   170\t\n   171\t    if isinstance(node, ast.UnaryOp):\n   172\t        op = _UNARY.get(type(node.op))\n   173\t        if op is None:\n   174\t            raise Unsupported(f\"UnaryOp {type(node.op).__name__}\")\n   175\t        return Ctor(\"UnaryOp\", q(op), emit_expr(node.operand))\n   176\t\n   177\t    if isinstance(node, ast.BoolOp):\n   178\t        op = _BOOLOP[type(node.op)]\n   179\t        return Ctor(\"BoolOp\", q(op), *(emit_expr(v) for v in node.values))\n   180\t\n   181\t    if isinstance(node, ast.Compare):\n   182\t        # Faithful, non-desugared: left operand + a chain of (op, comparator).\n   183\t        # Single comparison => one CmpOp; `a < b < c` => two CmpOps.\n   184\t        chain = [\n   185\t            Ctor(\"CmpOp\", q(_op_or_raise(_CMPOP, op, \"Compare\")), emit_expr(c))\n   186\t            for op, c in zip(node.ops, node.comparators)\n   187\t        ]\n   188\t        return Ctor(\"Compare\", emit_expr(node.left), *chain)\n   189\t\n   190\t    if isinstance(node, ast.List):\n   191\t        return Ctor(\"ListExpr\", *(emit_expr(e) for e in node.elts))\n   192\t\n   193\t    if isinstance(node, ast.Tuple):\n   194\t        return Ctor(\"TupleExpr\", *(emit_expr(e) for e in node.elts))\n   195\t\n   196\t    if isinstance(node, ast.Set):\n   197\t        return Ctor(\"SetExpr\", *(emit_expr(e) for e in node.elts))\n   198\t\n   199\t    if isinstance(node, ast.Dict):\n   200\t        entries = []\n   201\t        for k, v in zip(node.keys, node.values):\n   202\t            if k is None:\n   203\t                raise Unsupported(\"dict unpacking {**x}\")\n   204\t            entries.append(Ctor(\"Entry\", emit_expr(k), emit_expr(v)))\n   205\t        return Ctor(\"DictExpr\", *entries)\n   206\t\n   207\t    if isinstance(node, ast.Subscript):\n   208\t        return Ctor(\"Subscript\", emit_expr(node.value), emit_index(node.slice))\n   209\t\n   210\t    if isinstance(node, ast.Attribute):\n   211\t        return Ctor(\"Attribute\", emit_expr(node.value), q(node.attr))\n   212\t\n   213\t    if isinstance(node, ast.Call):\n   214\t        if any(isinstance(a, ast.Starred) for a in node.args):\n   215\t            raise Unsupported(\"*args unpacking\")\n   216\t        if any(kw.arg is None for kw in node.keywords):\n   217\t            raise Unsupported(\"**kwargs unpacking\")\n   218\t        # Call grammar is `Call(Expr, Exprs)` — the comma is mandatory, so a zero-arg\n   219\t        # call must render as `Call(f, )` (empty Exprs), NOT `Call(f)` (which won't parse).\n   220\t        args = [emit_expr(a) for a in node.args]\n   221\t        args += [Ctor(\"KwArg\", q(kw.arg), emit_expr(kw.value)) for kw in node.keywords]\n   222\t        args = args or [\"\"]\n   223\t        return Ctor(\"Call\", emit_expr(node.func), *args)\n   224\t\n   225\t    if isinstance(node, ast.IfExp):\n   226\t        # AST field order: test, body, orelse — kept verbatim.\n   227\t        return Ctor(\"IfExp\", emit_expr(node.test),\n   228\t                    emit_expr(node.body), emit_expr(node.orelse))\n   229\t\n   230\t    if isinstance(node, ast.ListComp):\n   231\t        return Ctor(\"ListComp\", emit_expr(node.elt), _gens(node.generators))\n   232\t    if isinstance(node, ast.SetComp):\n   233\t        return Ctor(\"SetComp\", emit_expr(node.elt), _gens(node.generators))\n   234\t    if isinstance(node, ast.GeneratorExp):\n   235\t        return Ctor(\"GenExp\", emit_expr(node.elt), _gens(node.generators))\n   236\t    if isinstance(node, ast.DictComp):\n   237\t        return Ctor(\"DictComp\", emit_expr(node.key), emit_expr(node.value),\n   238\t                    _gens(node.generators))\n   239\t\n   240\t    raise Unsupported(f\"Expr {type(node).__name__}\")\n   241\t\n   242\t\n   243\tdef _op_or_raise(table, op, label):\n   244\t    spelled = table.get(type(op))\n   245\t    if spelled is None:\n   246\t        raise Unsupported(f\"{label} {type(op).__name__}\")\n   247\t    return spelled\n   248\t\n   249\t\n   250\tdef _compfor(g):\n   251\t    \"\"\"A single generator -> CompFor(target, iter, <ifs as Exprs; .Exprs if none>).\"\"\"\n   252\t    if getattr(g, \"is_async\", 0):\n   253\t        raise Unsupported(\"async comprehension\")\n   254\t    ifs = [emit_expr(c) for c in g.ifs] or [Ctor(\"Bool\", \"true\")]\n   255\t    return Ctor(\"CompFor\", emit_expr(g.target), emit_expr(g.iter), *ifs)\n   256\t\n   257\t\n   258\tdef _gens(generators):\n   259\t    \"\"\"The generator list -> a juxtaposed CompFors (a Seq of CompFor).\"\"\"\n   260\t    return Seq([_compfor(g) for g in generators])\n   261\t\n   262\t\n   263\tdef emit_index(node: ast.expr):\n   264\t    \"\"\"Subscript index position: an `ast.Slice` -> `Slice(...)`, else the expr.\"\"\"\n   265\t    # Python <3.9 wrapped the index in ast.Index; unwrap if present.\n   266\t    inner = getattr(ast, \"Index\", None)\n   267\t    if inner is not None and isinstance(node, inner):\n   268\t        node = node.value\n   269\t    if isinstance(node, ast.Slice):\n   270\t        def bound(b):\n   271\t            # omitted bound (absent field) OR an explicit None constant -> NoBound.\n   272\t            # Python treats `a[None:5]` exactly like `a[:5]`; only a *value* None\n   273\t            # (Constant(None) outside a slice) becomes NoneVal. Keeping the two\n   274\t            # distinct lets NoneVal be a real value without perturbing slices.\n   275\t            if b is None or (isinstance(b, ast.Constant) and b.value is None):\n   276\t                return \"NoBound\"\n   277\t            return emit_expr(b)\n   278\t        return Ctor(\"Slice\", bound(node.lower), bound(node.upper), bound(node.step))\n   279\t    return emit_expr(node)\n   280\t\n   281\t\n   282\t# ---------------------------------------------------------------------------\n   283\t# Statements\n   284\t# ---------------------------------------------------------------------------\n   285\tdef emit_stmt(node: ast.stmt):\n   286\t    if isinstance(node, ast.FunctionDef):\n   287\t        a = node.args\n   288\t        if a.vararg or a.kwarg or a.kwonlyargs or a.defaults or a.kw_defaults:\n   289\t            raise Unsupported(\"complex function signature (defaults/varargs/kwonly)\")\n   290\t        if node.decorator_list:\n   291\t            raise Unsupported(\"decorators\")\n   292\t        names = [p.arg for p in (a.posonlyargs + a.args)]  # type annotations ignored\n   293\t        params = Ctor(\"Params\", *(q(n) for n in names))\n   294\t        info = scope_info(node.name, node.lineno)\n   295\t        if info and (info[0] or info[1] or info[2]):\n   296\t            cells, frees, _ = info\n   297\t            return Ctor(\"FuncDef\", q(node.name), params,\n   298\t                        Ctor(\"CellVars\", *(q(n) for n in cells)),\n   299\t                        Ctor(\"FreeVars\", *(q(n) for n in frees)),\n   300\t                        emit_stmts(node.body))\n   301\t        return Ctor(\"FuncDef\", q(node.name), params, emit_stmts(node.body))\n   302\t\n   303\t    if isinstance(node, ast.Return):\n   304\t        if node.value is None:\n   305\t            return Ctor(\"Return\")\n   306\t        return Ctor(\"Return\", emit_expr(node.value))\n   307\t\n   308\t    if isinstance(node, ast.Assign):\n   309\t        if len(node.targets) != 1:\n   310\t            raise Unsupported(\"chained assignment (a = b = ...)\")\n   311\t        # Target is just an expression in store position (Name / Tuple / Subscript / Attribute).\n   312\t        return Ctor(\"Assign\", emit_expr(node.targets[0]), emit_expr(node.value))\n   313\t\n   314\t    if isinstance(node, ast.AugAssign):\n   315\t        op = _BINOP.get(type(node.op))\n   316\t        if op is None:\n   317\t            raise Unsupported(f\"AugAssign {type(node.op).__name__}\")\n   318\t        return Ctor(\"AugAssign\", emit_expr(node.target), q(op), emit_expr(node.value))\n   319\t\n   320\t    if isinstance(node, ast.If):\n   321\t        return Ctor(\"If\", emit_expr(node.test),\n   322\t                    emit_stmts(node.body), emit_stmts(node.orelse))\n   323\t\n   324\t    if isinstance(node, ast.For):\n   325\t        if node.orelse:\n   326\t            raise Unsupported(\"for-else\")\n   327\t        return Ctor(\"For\", emit_expr(node.target), emit_expr(node.iter),\n   328\t                    emit_stmts(node.body))\n   329\t\n   330\t    if isinstance(node, ast.While):\n   331\t        if node.orelse:\n   332\t            raise Unsupported(\"while-else\")\n   333\t        return Ctor(\"While\", emit_expr(node.test), emit_stmts(node.body))\n   334\t\n   335\t    if isinstance(node, ast.Break):\n   336\t        return \"Break\"\n   337\t    if isinstance(node, ast.Continue):\n   338\t        return \"Continue\"\n   339\t    if isinstance(node, ast.Pass):\n   340\t        return \"Pass\"\n   341\t\n   342\t    if isinstance(node, ast.Assert):\n   343\t        if node.msg is not None:\n   344\t            return Ctor(\"Assert\", emit_expr(node.test), emit_expr(node.msg))\n   345\t        return Ctor(\"Assert\", emit_expr(node.test))\n   346\t\n   347\t    if isinstance(node, ast.Expr):\n   348\t        return Ctor(\"Expr\", emit_expr(node.value))\n   349\t\n   350\t    if isinstance(node, ast.Import):\n   351\t        return Ctor(\"Import\", *(q(n.name) for n in node.names))\n   352\t    if isinstance(node, ast.ImportFrom):\n   353\t        mod = node.module if node.module is not None else \"\"\n   354\t        return Ctor(\"ImportFrom\", q(mod), *(q(n.name) for n in node.names))\n   355\t\n   356\t    raise Unsupported(f\"Stmt {type(node).__name__}\")\n   357\t\n   358\t\n   359\tdef emit_stmts(stmts) -> Seq:\n   360\t    return Seq([emit_stmt(s) for s in stmts])\n   361\t\n   362\t\n   363\tdef emit_module(tree: ast.Module) -> Ctor:\n   364\t    return Ctor(\"Module\", emit_stmts(tree.body))\n   365\t\n   366\t\n   367\t# ---------------------------------------------------------------------------\n   368\t# Lisp-style pretty printer\n   369\t# ---------------------------------------------------------------------------\n   370\tWIDTH = 72  # an expression constructor wider than this breaks onto its own lines\n   371\t\n   372\t\n   373\tdef render(node, ind: int = 0) -> str:\n   374\t    if isinstance(node, str):\n   375\t        return node\n   376\t\n   377\t    if isinstance(node, Seq):\n   378\t        if not node.items:\n   379\t            return \"\"\n   380\t        pad = \"  \" * ind\n   381\t        return (\"\\n\" + pad).join(render(it, ind) for it in node.items)\n   382\t\n   383\t    # Ctor\n   384\t    cind = ind + 1\n   385\t    cpad = \"  \" * cind\n   386\t    has_block = any(isinstance(a, Seq) for a in node.args)\n   387\t\n   388\t    if not has_block:\n   389\t        inline = node.name + \"(\" + \", \".join(render(a, ind) for a in node.args) + \")\"\n   390\t        if \"\\n\" not in inline and len(\"  \" * ind) + len(inline) <= WIDTH:\n   391\t            return inline\n   392\t        parts = [render(a, cind) for a in node.args]\n   393\t        return node.name + \"(\\n\" + cpad + (\",\\n\" + cpad).join(parts) + \")\"\n   394\t\n   395\t    # Has a statement block: inline the args before the first block, then put\n   396\t    # each remaining arg (blocks included) on its own indented line.\n   397\t    first = next(i for i, a in enumerate(node.args) if isinstance(a, Seq))\n   398\t    head = node.args[:first]\n   399\t    rest = node.args[first:]\n   400\t    open_line = node.name + \"(\" + \", \".join(render(a, ind) for a in head) + (\",\" if head else \"\")\n   401\t    lines = []\n   402\t    for k, a in enumerate(rest):\n   403\t        comma = \",\" if k < len(rest) - 1 else \"\"\n   404\t        lines.append(cpad + render(a, cind) + comma)\n   405\t    return open_line + \"\\n\" + \"\\n\".join(lines) + \")\"\n   406\t\n   407\t\n   408\t# ---------------------------------------------------------------------------\n   409\t# CLI\n   410\t# ---------------------------------------------------------------------------\n   411\tdef main(argv=None) -> int:\n   412\t    ap = argparse.ArgumentParser(\n   413\t        prog=\"py2mpy\",\n   414\t        description=\"Pure CPython-AST -> K-constructor transliterator.\",\n   415\t    )\n   416\t    ap.add_argument(\"file\", help=\"Python source file\")\n   417\t    ap.add_argument(\"--ast\", action=\"store_true\",\n   418\t                    help=\"print the Python AST (ast.dump) instead of the .mpy term\")\n   419\t    args = ap.parse_args(argv)\n   420\t\n   421\t    with open(args.file, \"r\", encoding=\"utf-8\") as fh:\n   422\t        src = fh.read()\n   423\t    tree = ast.parse(src, filename=args.file)\n   424\t    _walk_symtable(symtable.symtable(src, args.file, \"exec\"))\n   425\t\n   426\t    if args.ast:\n   427\t        print(ast.dump(tree, indent=2))\n   428\t    else:\n   429\t        print(render(emit_module(tree)))\n   430\t    return 0\n   431\t\n   432\t\n   433\tif __name__ == \"__main__\":\n   434\t    sys.exit(main())\n","internal_chat_message_metadata_passthrough":{"turn_id":"019fad82-6e0f-7e71-a279-f849d0688e76"}}}
