    33	  syntax Bool ::= bracketInput(IntSeq) [function, total]
    34	  rule bracketInput(.IntSeq) => true
    35	  rule bracketInput(iCons(C:Int, REST:IntSeq))
    36	    => (C ==Int 40 orBool C ==Int 41) andBool bracketInput(REST)
