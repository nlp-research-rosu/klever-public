    14	    => scanBrackets(
    15	         REST,
    16	         #if C ==Int 40 #then B +Int 1 #else B -Int 1 #fi,
    17	         keepValid(
    18	           #if C ==Int 40 #then B +Int 1 #else B -Int 1 #fi,
    19	           V))
    20	
    21	  // This is the source-level `if balance < 0: valid = False`.
    22	  syntax Bool ::= keepValid(Int, Bool) [function, total]
    23	  rule keepValid(B:Int, _:Bool) => false requires B <Int 0
    24	  rule keepValid(B:Int, V:Bool) => V     requires B >=Int 0
    25	
