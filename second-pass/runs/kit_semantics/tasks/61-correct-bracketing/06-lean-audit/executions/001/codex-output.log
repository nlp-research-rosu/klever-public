"""Dependency-light signed-resolution contract for Stage 6 audit inputs."""

from __future__ import annotations

import hashlib
import json
import re
from typing import Any


SCHEMA_VERSION = 4
RESOLUTION_KEYS = frozenset(
    {
        "schema_version",
        "run_id",
        "problem_id",
        "condition",
        "mode",
        "semantics_mode",
        "k_workspace",
        "k_audit",
