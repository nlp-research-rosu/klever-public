d `bracketInput`.\n   307\t- The theorem is about the supplied MPY semantics, not arbitrary CPython\n   308\t  features, Unicode behavior outside this ASCII domain, or changed global\n   309\t  bindings.\n   310\t- Following the Kit contract, the formal report is partial correctness; a\n   311\t  separate liveness theorem is not claimed.  The concrete implementation and\n   312\t  recursive summary both structurally consume finite input, but that observation\n   313\t  is not reported as a K termination proof.\n     1\t\n     2\t\n     3\tdef correct_bracketing(brackets: str):\n     4\t    \"\"\" brackets is a string of \"(\" and \")\".\n     5\t    return True if every opening bracket has a corresponding closing bracket.\n     6\t\n     7\t    >>> correct_bracketing(\"(\")\n     8\t    False\n     9\t    >>> correct_bracketing(\"()\")\n    10\t    True\n    11\t    >>> correct_bracketing(\"(()())\")\n    12\t    True\n    13\t    >>> correct_bracketing(\")(()\")\n    14\t    False\n    15\t    \"\"\"\n     1\t# canonical.py — the UNMODIFIED HumanEval/61 reference solution (from the dataset).\n     2\t# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link\n     3\t# explicit & auditable.  entry point: correct_bracketing\n     4\t\n     5\t\n     6\t\n     7\tdef correct_bracketing(brackets: str):\n     8\t    \"\"\" brackets is a string of \"(\" and \")\".\n     9\t    return True if every opening bracket has a corresponding closing bracket.\n    10\t\n    11\t    >>> correct_bracketing(\"(\")\n    12\t    False\n    13\t    >>> correct_bracketing(\"()\")\n    14\t    True\n    15\t    >>> correct_bracketing(\"(()())\")\n    16\t    True\n    17\t    >>> correct_bracketing(\")(()\")\n    18\t    False\n    19\t    \"\"\"\n    20\t    depth = 0\n    21\t    for b in brackets:\n    22\t        if b == \"(\":\n    23\t            depth += 1\n    24\t        else:\n    25\t            depth -= 1\n    26\t        if depth < 0:\n    27\t            return False\n    28\t    return depth == 0\n     1\tdef correct_bracketing(brackets: str):\n     2\t    balance = 0\n     3\t    valid = True\n     4\t    for bracket in brackets:\n     5\t        if bracket == \"(\":\n     6\t            balance += 1\n     7\t        else:\n     8\t            balance -= 1\n     9\t        if balance < 0:\n    10\t            valid = False\n    11\t    return valid and balance == 0\n    12\t\n    13\t\n    14\tcase_empty = correct_bracketing(\"\")\n    15\tcase_open = correct_bracketing(\"(\")\n    16\tcase_pair = correct_bracketing(\"()\")\n    17\tcase_nested = correct_bracketing(\"(()())\")\n    18\tcase_bad_prefix = correct_bracketing(\")(()\")\n     1\tdef correct_bracketing(brackets: str):\n     2\t    balance = 0\n     3\t    valid = True\n     4\t    for bracket in brackets:\n     5\t        if bracket == \"(\":\n     6\t            balance += 1\n     7\t        else:\n     8\t            balance -= 1\n     9\t        if balance < 0:\n    10\t            valid = False\n    11\t    valid = False\n    12\t    return valid and balance == 0\n    13\t\n    14\t\n    15\tcontext_result = correct_bracketing(\"()\")\n     1\timport ast\n     2\timport itertools\n     3\t\n     4\tfrom solution import correct_bracketing\n     5\t\n     6\t\n     7\tdef stack_oracle(brackets):\n     8\t    stack = []\n     9\t    for bracket in brackets:\n    10\t        if bracket == \"(\":\n    11\t            stack.append(bracket)\n    12\t        elif stack:\n    13\t            stack.pop()\n    14\t        else:\n    15\t            return False\n    16\t    return not stack\n    17\t\n    18\t\n    19\tdef target_body(path):\n    20\t    tree = ast.parse(path.read_text())\n    21\t    function = next(\n    22\t        node\n    23\t        for node in tree.body\n    24\t        if isinstance(node, ast.FunctionDef)\n    25\t        and node.name == \"correct_bracketing\"\n    26\t    )\n    27\t    return ast.dump(function, include_attr