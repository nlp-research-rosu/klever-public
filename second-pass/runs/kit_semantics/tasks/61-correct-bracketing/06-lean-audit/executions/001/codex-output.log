diff --git a//tmp/audit-work/lean-proc-self-shim.c b//tmp/audit-work/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..c5f6a3ce902b0d48f2c374efc9fce6e5a11ca748
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+    static readlink_fn real_readlink = NULL;
+    char numeric_self[64];
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    snprintf(numeric_self, sizeof(numeric_self), "/proc/%ld/exe",
+             (long)getpid());
+    if (strcmp(path, numeric_self) == 0) {
+        path = "/proc/self/exe";
+    }
+    return real_readlink(path, buf, bufsiz);
+}
