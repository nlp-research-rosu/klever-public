+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <execinfo.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <lean/lean.h>
+
+extern void lean_initialize(void);
+extern char **lean_setup_args(int argc, char **argv);
+extern lean_object *initialize_Lean(uint8_t builtin);
+extern lean_object *l_Lean_Options_empty;
+extern lean_object *l_Array_empty;
+
+extern lean_object *lean_shell_main(
+    lean_object *args,
+    uint8_t use_stdin,
+    uint8_t only_deps,
+    uint8_t only_src_deps,
+    uint8_t deps_json,
+    lean_object *options,
+    uint32_t trust_level,
+    lean_object *root_dir,
+    lean_object *setup_file,
+    lean_object *olean_file,
+    lean_object *ilean_file,
+    lean_object *c_file,
+    lean_object *bc_file,
+    uint8_t json_output,
+    lean_object *error_on_kinds,
+    uint8_t print_stats,
+    uint8_t run,
+    lean_object *world);
+
+static void on_signal(int signal_number) {
+    void *frames[40];
+    int count = backtrace(frames, 40);
+    backtrace_symbols_fd(frames, count, 2);
+    _Exit(128 + signal_number);
+}
+
+static lean_object *mk_args(int argc, char **argv) {
+    lean_object *result = lean_box(0);
+    for (int i = argc - 1; i >= 1; --i) {
+        lean_object *cell = lean_alloc_ctor(1, 2, 0);
+        lean_ctor_set(cell, 0, lean_mk_string(argv[i]));
+        lean_ctor_set(cell, 1, result);
+        result = cell;
+    }
+    return result;
+}
+
+int main(int argc, char **argv) {
+    signal(SIGSEGV, on_signal);
+    fprintf(stderr, "launcher: setup\n");
+    argv = lean_setup_args(argc, argv);
+    fprintf(stderr, "launcher: initialize runtime\n");
+    lean_initialize();
+    lean_set_panic_messages(false);
+    fprintf(stderr, "launcher: initialize Lean\n");
+    lean_object *init = initialize_Lean(1);
+    fprintf(stderr, "launcher: initialized Lean\n");
+    lean_set_panic_messages(true);
+    lean_io_mark_end_initialization();
+    if (lean_io_result_is_error(init)) {
+        lean_io_result_show_error(init);
+        lean_dec(init);
+        return 1;
+    }
+    lean_dec(init);
+
+    fprintf(stderr, "launcher: task manager\n");
+    lean_init_task_manager();
+    lean_object *none = lean_box(0);
+    fprintf(stderr, "launcher: shell\n");
+    lean_object *result = lean_shell_main(
+        mk_args(argc, argv),
+        false,
+        false,
+        false,
+        false,
+        l_Lean_Options_empty,
+        0,
+        none,
+        none,
+        none,
+        none,
+        none,
+        none,
+        false,
+        l_Array_empty,
+        false,
+        false,
+        lean_box(0));
+    fprintf(stderr, "launcher: shell returned\n");
+    lean_finalize_task_manager();
+
+    if (lean_io_result_is_error(result)) {
+        lean_io_result_show_error(result);
+        lean_dec(result);
+        return 1;
+    }
+    int exit_code = (int)lean_unbox(lean_io_result_get_value(result));
+    lean_dec(result);
+    return exit_code;
+}
diff --git a/ProcExeShim.c b/ProcExeShim.c
new file mode 100644
index 0000000000000000000000000000000000000000..5bdec1a2b93061e72435f878193946bb3396f4db
--- /dev/null
+++ b/ProcExeShim.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    if (strncmp(path, "/proc/", 6) == 0) {
+        const char *suffix = strrchr(path, '/');
+        if (suffix != NULL && strcmp(suffix, "/exe") == 0) {
+            size_t length = strlen(program_invocation_name);
+            if (length > size)
+                length = size;
+            memcpy(buffer, program_invocation_name, length);
+            return (ssize_t)length;
+        }
+    }
+
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL)
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    if (real_readlink == NULL) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return real_readlink(path, buffer, size);
+}
