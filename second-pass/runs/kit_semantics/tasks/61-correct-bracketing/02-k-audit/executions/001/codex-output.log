     3	def correct_bracketing(brackets: str):
     4	    """ brackets is a string of "(" and ")".
     5	    return True if every opening bracket has a corresponding closing bracket.
     6	
     7	    >>> correct_bracketing("(")
     8	    False
     9	    >>> correct_bracketing("()")
    10	    True
    11	    >>> correct_bracketing("(()())")
    12	    True
    13	    >>> correct_bracketing(")(()")
    14	    False
    15	    """
