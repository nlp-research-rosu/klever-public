+
+source = Path("/audit-output/evidence/audit-spec-vacuity.k").read_text(
+    encoding="utf-8"
+)
+source = source.replace(
+    "module AUDIT-SPEC-VACUITY",
+    "module AUDIT-OPEN-OPPOSITE",
+).replace(
+    "claim [pair-falsely-returns-false]:",
+    "claim [open-falsely-returns-true]:",
