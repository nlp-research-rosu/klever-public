+                Compare(Name("bracket"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(
+                Compare(Name("balance"), CmpOp("<", Int(0))),
+                Assign(Name("valid"), Bool(false)),
+                .Stmts))
+            Return(
+              BoolOp(
+                "and",
+                Name("valid"),
+                Compare(Name("balance"), CmpOp("==", Int(0))))),
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
