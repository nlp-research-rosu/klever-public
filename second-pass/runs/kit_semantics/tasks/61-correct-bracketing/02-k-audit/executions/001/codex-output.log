    18	CONCRETE_RESULT="$(krun concrete_tests.mpy --definition runtime-kompiled)"
    19	grep -F '"case_empty" |-> true' <<<"$CONCRETE_RESULT"
    20	grep -F '"case_open" |-> false' <<<"$CONCRETE_RESULT"
    21	grep -F '"case_pair" |-> true' <<<"$CONCRETE_RESULT"
    22	grep -F '"case_nested" |-> true' <<<"$CONCRETE_RESULT"
    23	grep -F '"case_bad_prefix" |-> false' <<<"$CONCRETE_RESULT"
    24	
    25	echo "== Compile the bridge-free symbolic definition =="
    26	kompile verification.k \
