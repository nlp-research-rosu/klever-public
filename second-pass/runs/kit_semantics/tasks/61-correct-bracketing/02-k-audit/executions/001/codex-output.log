+         1 |-> scope(
+                "bracket" |-> OLD:Val
+                "brackets" |-> str(iCons(40, iCons(41, .IntSeq)))
+                "balance" |-> 0
+                "valid" |-> true,
+                parent(0)) )
+      =>
