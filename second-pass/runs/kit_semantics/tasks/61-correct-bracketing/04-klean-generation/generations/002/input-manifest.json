      "normalized_sha256": "b9c21f71f007e14b87428fc39b47b152444b900cfb5ae90c093a6a0adbe3bac0",
      "rationale": "Base equation for the proof-local mathematical summary scanBrackets on the empty sequence.",
      "source_rule_id": "rule-b9c21f71f007e14b87428fc39b47b152444b900cfb5ae90c093a6a0adbe3bac0",
      "start_line": 11,
      "text": "  rule scanBrackets(.IntSeq, B:Int, V:Bool)\n    => V andBool B ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "a39e2d4a34fe8d3daf6e7a14ed9cd1f1efc7f40036ee34e406b4a1f8e0ec5a74",
      "rationale": "Recursive equation defining scanBrackets on a nonempty sequence by consuming its head and updating the balance and validity arguments.",
      "source_rule_id": "rule-a39e2d4a34fe8d3daf6e7a14ed9cd1f1efc7f40036ee34e406b4a1f8e0ec5a74",
      "start_line": 13,
      "text": "  rule scanBrackets(iCons(C:Int, REST:IntSeq), B:Int, V:Bool)\n    => scanBrackets(\n         REST,\n         #if C ==Int 40 #then B +Int 1 #else B -Int 1 #fi,\n         keepValid(\n           #if C ==Int 40 #then B +Int 1 #else B -Int 1 #fi,\n           V))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "90116861827fe29b6190d60f2c7fa45d68a9e1d53c40cb018cb4bdfd97122478",
      "rationale": "Guarded defining equation for keepValid when the updated balance is negative.",
      "source_rule_id": "rule-90116861827fe29b6190d60f2c7fa45d68a9e1d53c40cb018cb4bdfd97122478",
      "start_line": 23,
      "text": "  rule keepValid(B:Int, _:Bool) => false requires B <Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "952eaa451e2e2dafbf07e4b2853104ca12d32a5798a18fd07e34328e033d4dc4",
      "rationale": "Guarded defining equation for keepValid when the updated balance is nonnegative.",
      "source_rule_id": "rule-952eaa451e2e2dafbf07e4b2853104ca12d32a5798a18fd07e34328e033d4dc4",
      "start_line": 24,
      "text": "  rule keepValid(B:Int, V:Bool) => V     requires B >=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "86c81c4e83f334a250f0f7cd6a3d696ef3dd176482dc7252a0d002fb835aa66c",
      "rationale": "Base equation defining the bracketInput domain predicate on the empty sequence.",
      "source_rule_id": "rule-86c81c4e83f334a250f0f7cd6a3d696ef3dd176482dc7252a0d002fb835aa66c",
      "start_line": 34,
      "text": "  rule bracketInput(.IntSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "VERIFICATION",
      "normalized_sha256": "1e22fa424b19594ef171e00ed16730ba4f24c804316660a9f0a4eeaee1779942",
      "rationale": "Recursive equation defining bracketInput by requiring each head code to be an opening or closing parenthesis and recursing on the tail.",
      "source_rule_id": "rule-1e22fa424b19594ef171e00ed16730ba4f24c804316660a9f0a4eeaee1779942",
      "start_line": 35,
      "text": "  rule bracketInput(iCons(C:Int, REST:IntSeq))\n    => (C ==Int 40 orBool C ==Int 41) andBool bracketInput(REST)"
    }
  ],
