Module(
  Assert(
    Compare(
      BinOp("-", Float(5.5), Float(2.0)),
      CmpOp("==", Float(3.5))))
  Assert(
    Compare(
      BinOp("-", UnaryOp("-", Float(1.25)), Float(2.75)),
      CmpOp("==", UnaryOp("-", Float(4.0)))))
  Assert(
    Compare(
      BinOp("-", Float(0.0), Float(0.0)),
      CmpOp("==", Float(0.0)))))
