diff --git a/evidence/10_k_operational_witnesses.mpy b/evidence/10_k_operational_witnesses.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..3de4864568bf528af671775fcd18c7ddd829d63a
--- /dev/null
+++ b/evidence/10_k_operational_witnesses.mpy
@@ -0,0 +1,13 @@
+Module(
+  Assert(
+    Compare(
+      BinOp("-", Float(5.5), Float(2.0)),
+      CmpOp("==", Float(3.5))))
+  Assert(
+    Compare(
+      BinOp("-", UnaryOp("-", Float(1.25)), Float(2.75)),
+      CmpOp("==", UnaryOp("-", Float(4.0)))))
+  Assert(
+    Compare(
