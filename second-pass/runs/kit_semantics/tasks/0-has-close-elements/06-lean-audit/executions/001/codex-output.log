@@ -0,0 +1,112 @@
+import Proof
+
+namespace BridgeAudit
+
+open Proof
+
+def floatVal (value : Float) : SortVal :=
+  SortVal.inj_SortFloat value
+
+def intVal (value : Int) : SortVal :=
+  SortVal.inj_SortInt value
+
+def asK (value : SortVal) : SortK :=
+  SortK.kseq ((@inj SortVal SortKItem) value) SortK.dotk
+
+def extractFloat (value : SortVal) : Float :=
+  match value with
+  | SortVal.inj_SortFloat result => result
+  | _ => 999.0
+
+-- Truth table for the K BOOL.and hook.
+#eval Proof._andBool_ false false
+#eval Proof._andBool_ false true
+#eval Proof._andBool_ true false
+#eval Proof._andBool_ true true
+
+-- Sort predicate and projection boundary witnesses.
+#eval Proof.isFloat (asK (floatVal 5.5))
+#eval Proof.isFloat (asK (intVal 5))
+#eval Proof.isFloat
+  (SortK.kseq (SortKItem.inj_SortFloat 5.5)
+    (SortK.kseq (SortKItem.inj_SortFloat 2.0) SortK.dotk))
+#eval Proof.«asFloat(_)_VERIFICATION_Float_Val» (floatVal 5.5)
+#eval Proof.«asFloat(_)_VERIFICATION_Float_Val» (intVal 5)
+
+-- Float subtraction bridge witnesses, including negative operands and zero.
+#eval Proof.subF 5.5 2.0
+#eval Proof.subF (-1.25) 2.75
+#eval Proof.subF 0.0 0.0
+#eval extractFloat
+  (Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "-" (floatVal 5.5) (floatVal 2.0))
+#eval extractFloat
+  (Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "-" (floatVal (-1.25)) (floatVal 2.75))
+
+example :
+    Proof._andBool_
+        (Proof.isFloat (asK (floatVal 5.5)))
+        (Proof.isFloat (asK (floatVal 2.0))) = true := by
+  rfl
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+        "-" (floatVal 5.5) (floatVal 2.0) =
+      SortVal.inj_SortFloat
+        (Proof.subF
+          (Proof.«asFloat(_)_VERIFICATION_Float_Val» (floatVal 5.5))
+          (Proof.«asFloat(_)_VERIFICATION_Float_Val» (floatVal 2.0))) := by
+  rfl
+
+-- Counterfactual 1: a constant-false sort predicate makes the immutable
+-- implication vacuous. This compiles, so operational validation of isFloat
+-- is essential; the actual definition above has satisfiable Float witnesses.
+def falseIsFloat (_ : SortK) : SortBool := false
+
+theorem falseGuardStillProves :
+    Klean0HasCloseElements.Lemmas.targetStatement
+      Proof._andBool_
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«asFloat(_)_VERIFICATION_Float_Val»
+      falseIsFloat
+      Proof.subF := by
+  unfold Klean0HasCloseElements.Lemmas.targetStatement
+  intro B A h
+  simp [Proof._andBool_, falseIsFloat] at h
+
+-- Counterfactual 2: coordinated addition definitions also satisfy the
+-- relational target, even though K says subtraction. The actual definitions
+-- must therefore be checked independently against K, not merely each other.
+def plusSubF (lhs rhs : SortFloat) : SortFloat := lhs + rhs
+
+def plusApplyBin : SortString → SortVal → SortVal → SortVal
+  | "-", SortVal.inj_SortFloat lhs, SortVal.inj_SortFloat rhs =>
+      SortVal.inj_SortFloat (lhs + rhs)
+  | _, _, _ => SortVal.«noneV_MPY-CORE_Val»
+
+theorem isFloatInjectedIff (value : SortVal) :
+    Proof.isFloat (asK value) = true ↔
+      ∃ floatValue, value = SortVal.inj_SortFloat floatValue := by
+  cases value <;> simp [Proof.isFloat, asK, inj]
+
+theorem coordinatedAdditionStillProves :
+    Klean0HasCloseElements.Lemmas.targetStatement
+      Proof._andBool_
+      plusApplyBin
+      Proof.«asFloat(_)_VERIFICATION_Float_Val»
+      Proof.isFloat
+      plusSubF := by
+  unfold Klean0HasCloseElements.Lemmas.targetStatement
+  intro B A h
+  simp only [Proof._andBool_, Bool.and_eq_true] at h
+  rcases (isFloatInjectedIff A).mp h.1 with ⟨lhs, rfl⟩
+  rcases (isFloatInjectedIff B).mp h.2 with ⟨rhs, rfl⟩
+  rfl
+
+#eval extractFloat (plusApplyBin "-" (floatVal 5.5) (floatVal 2.0))
+#eval Proof.subF 5.5 2.0
+#eval extractFloat (plusApplyBin "-" (floatVal 5.5) (floatVal 2.0)) ==
+  Proof.subF 5.5 2.0
+
+end BridgeAudit
