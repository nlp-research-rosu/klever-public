     3	
     4	def has_close_elements(numbers: List[float], threshold: float) -> bool:
     5	    """ Check if in given list of numbers, are any two numbers closer to each other than
     6	    given threshold.
     7	    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)
     8	    False
     9	    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)
    10	    True
    11	    """
     1	from itertools import combinations, product
     2	
     3	from solution import has_close_elements
     4	
     5	
     6	def oracle(numbers, threshold):
     7	    return any(abs(left - right) < threshold
     8	               for left, right in combinations(numbers, 2))
     9	
