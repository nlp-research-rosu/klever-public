    12	    values = [-2.0, -0.5, 0.0, 0.5, 2.0]
    13	    thresholds = [-1.0, 0.0, 0.25, 0.5, 1.0, 3.0]
    14	    checked = 0
    15	    mismatches = 0
    16	    for size in range(5):
    17	        for numbers in product(values, repeat=size):
    18	            for threshold in thresholds:
    19	                expected = oracle(numbers, threshold)
    20	                actual = has_close_elements(list(numbers), threshold)
    21	                checked += 1
    22	                if actual != expected:
    23	                    mismatches += 1
    24	                    print("MISMATCH", numbers, threshold, expected, actual)
    25	    print("checked:", checked)
