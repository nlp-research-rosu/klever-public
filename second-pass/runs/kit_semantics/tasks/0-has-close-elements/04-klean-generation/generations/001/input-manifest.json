{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 8,
      "module": "VERIFICATION",
      "normalized_sha256": "dc6da0bab4bb59bc7bc1f84e094e20bfb08eaabdfb63f4029d3dcd8d203f8b96",
      "rationale": "This is the empty-sequence base equation defining the proof-local allFloats predicate.",
      "source_rule_id": "rule-dc6da0bab4bb59bc7bc1f84e094e20bfb08eaabdfb63f4029d3dcd8d203f8b96",
      "start_line": 8,
      "text": "  rule allFloats(.ValSeq)           => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "VERIFICATION",
      "normalized_sha256": "9e498a0552e6771e74565791899fe40f49d034087ac6ccb7f8bd852cdd51a7d5",
      "rationale": "This is the constructor recurrence defining allFloats by the head sort test and the predicate on the tail.",
      "source_rule_id": "rule-9e498a0552e6771e74565791899fe40f49d034087ac6ccb7f8bd852cdd51a7d5",
      "start_line": 9,
      "text": "  rule allFloats(vCons(V:Val, R))   => isFloat(V) andBool allFloats(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "1ccd7704e0d880500af6b7bbc2f25393776cecf9972be7883d55005af75dba48",
      "rationale": "This equation defines the named pairNear proof term as the composed subtraction, absolute-value, and strict-comparison summary.",
      "source_rule_id": "rule-1ccd7704e0d880500af6b7bbc2f25393776cecf9972be7883d55005af75dba48",
      "start_line": 13,
      "text": "  rule pairNear(A, B, T) => floatLt(absF(subF(A, B)), T)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "3b93d4976b7182c91d2a2f37ff4a4b4aeb87b2cae0b70e16583b7653e50137f0",
      "rationale": "This is the Float identity branch in the total definition of the proof-local asFloat projection.",
      "source_rule_id": "rule-3b93d4976b7182c91d2a2f37ff4a4b4aeb87b2cae0b70e16583b7653e50137f0",
      "start_line": 16,
      "text": "  rule asFloat(F:Float) => F"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "67ea2306e1ec02d05f832f6fc3d1c1df7b074395565220a88d327b4244b3dfd5",
      "rationale": "This guarded equation supplies the non-Float totalization branch of the proof-local asFloat definition.",
      "source_rule_id": "rule-67ea2306e1ec02d05f832f6fc3d1c1df7b074395565220a88d327b4244b3dfd5",
      "start_line": 17,
      "text": "  rule asFloat(V:Val)   => 0.0\n    requires notBool isFloat(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "906f23375bc3037477bb4865bd82b1acd088f6c92c84fba22886fbcdb4f2e980",
      "rationale": "This is the empty-sequence base equation defining the inner rowAcc fold.",
      "source_rule_id": "rule-906f23375bc3037477bb4865bd82b1acd088f6c92c84fba22886fbcdb4f2e980",
      "start_line": 28,
      "text": "  rule rowAcc(B, _, _, _, _, .ValSeq) => B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "4e163f4813de9404688e2d18f89122e640ce937ff1c79d5b2ab228fe5b081efb",
      "rationale": "This is the structurally descending constructor recurrence defining rowAcc, including its position guard and Boolean accumulation.",
      "source_rule_id": "rule-4e163f4813de9404688e2d18f89122e640ce937ff1c79d5b2ab228fe5b081efb",
      "start_line": 29,
      "text": "  rule rowAcc(B, A, T, I, J, vCons(V:Val, R))\n    => rowAcc(\n         #if I <Int J\n         #then B orBool pairNear(A, asFloat(V), T)\n         #else B\n         #fi,\n         A, T, I, J +Int 1, R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 40,
      "module": "VERIFICATION",
      "normalized_sha256": "9f5405faf27ef5ff3d4f3497a2b19c0aae403765801d6da99715fd17f685269c",
      "rationale": "This is the empty-sequence base equation defining the outerAcc fold.",
      "source_rule_id": "rule-9f5405faf27ef5ff3d4f3497a2b19c0aae403765801d6da99715fd17f685269c",
      "start_line": 40,
      "text": "  rule outerAcc(B, _, _, _, .ValSeq) => B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "69dccad157e90642e223828bfe9d6780f595e93cc0d6e5f205e123d520ccb3da",
      "rationale": "This is the structurally descending constructor recurrence defining outerAcc in terms of the rowAcc fold.",
      "source_rule_id": "rule-69dccad157e90642e223828bfe9d6780f595e93cc0d6e5f205e123d520ccb3da",
      "start_line": 41,
      "text": "  rule outerAcc(B, VS, T, I, vCons(A:Val, R))\n    => outerAcc(rowAcc(B, asFloat(A), T, I, 0, VS),\n                VS, T, I +Int 1, R)"
    }
  ],
