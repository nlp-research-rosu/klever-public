diff --git a/lean_app_path_fix.c b/lean_app_path_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..2c94fd44a92b767efd72af0aef822665ecfac9e9
--- /dev/null
+++ b/lean_app_path_fix.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next_readlink;
+  if (!next_readlink) {
+    next_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (strncmp(path, "/proc/", 6) == 0) {
+    size_t length = strlen(path);
+    if (length >= 10 && strcmp(path + length - 4, "/exe") == 0) {
+      return next_readlink("/proc/self/exe", buf, size);
+    }
+  }
+  return next_readlink(path, buf, size);
+}

