    64	  // priority than the generic Attribute/method dispatch in call.k).
    65	  syntax KItem ::= "#mathCeil"
    66	  rule <k> Call(Attribute(Name("math"), "ceil"), (E:Expr, .Exprs)) => E ~> #mathCeil ... </k> [priority(40)]
    67	  rule <k> V:Val ~> #mathCeil => ceilF(V) ... </k>
    68	
    69	  // math.floor(x) — same interception shape as math.ceil
    70	  syntax KItem ::= "#mathFloor"
    71	  rule <k> Call(Attribute(Name("math"), "floor"), (E:Expr, .Exprs)) => E ~> #mathFloor ... </k> [priority(40)]
    72	  rule <k> V:Val ~> #mathFloor => floorFI(V) ... </k>
    73	  syntax Int ::= floorFI(Val) [function, total, symbol(floorFI)]
    74	  rule floorFI(I:Int)   => I                        [concrete]
    75	  rule floorFI(F:Float) => Float2Int(floorFloat(F)) [concrete]
    76	
    77	  // bare floor/ceil (bound by `from math import floor, ceil`)
    78	  rule applyBuiltin("floor", V:Val, .Vals) => floorFI(V)
    79	  rule applyBuiltin("ceil",  V:Val, .Vals) => ceilF(V)
    80	
    81	  // math.pow(x, y) — a two-arg interception onto powF (ints promote)
    82	  syntax KItem ::= #mathPow1(Expr) | #mathPow2(Val)
    83	  rule <k> Call(Attribute(Name("math"), "pow"), (E1:Expr, E2:Expr, .Exprs)) => E1 ~> #mathPow1(E2) ... </k> [priority(40)]
    84	  rule <k> V1:Val ~> #mathPow1(E2:Expr) => E2 ~> #mathPow2(V1) ... </k>
    85	  rule <k> V2:Val ~> #mathPow2(V1:Val) => powF(toF(V1), toF(V2)) ... </k>
    86	  syntax Float ::= toF(Val) [function, total, symbol(toF)]
    87	  rule toF(F:Float) => F        [concrete]
    88	  rule toF(I:Int)   => intToF(I) [concrete]
    89	
    90	  // ceilF: math.ceil as an Int. TOTAL (K trusts it; a symbolic list element stays opaque for
    91	  // kprove — structural). [concrete] so the Int2Float/ceilFloat hooks only run for krun (llvm).
    92	  // Matches Python incl. negatives: ceil(-2.4) = -2 = Float2Int(ceilFloat(-2.4)).
    93	  syntax Int ::= ceilF(Val) [function, total, symbol(ceilF)]
    94	  rule ceilF(I:Int)   => I                       [concrete]
    95	  rule ceilF(F:Float) => Float2Int(ceilFloat(F)) [concrete]
    96	
    97	  // unary minus on a float (e.g. the literal -2.4 = UnaryOp("-", Float(2.4))). Concrete for krun;
    98	  // proofs use symbolic elements, never a float literal.
    99	  rule applyUn("-", F:Float) => 0.0 -Float F
   100	
   101	  // ---- float - / / / + (OPAQUE for kprove [no-evaluators], concrete for krun) — for float-list
   102	  // element maps (x - lo) / (hi - lo). Mirror intFloatDiv: additive, sort-disjoint from the Int rules.
   103	  syntax Float ::= subF(Float, Float) [function, total, symbol(subF), no-evaluators]
   104	  rule subF(F1:Float, F2:Float) => F1 -Float F2 [concrete]
   105	  rule applyBin("-", F1:Float, F2:Float) => subF(F1, F2)
   106	
   107	  syntax Float ::= divF(Float, Float) [function, total, symbol(divF), no-evaluators]
   108	  rule divF(F1:Float, F2:Float) => F1 /Float F2 [concrete]
   109	  rule applyBin("/", F1:Float, F2:Float) => divF(F1, F2)
   110	
   111	  syntax Float ::= addF(Float, Float) [function, total, symbol(addF), no-evaluators]
   112	  rule addF(F1:Float, F2:Float) => F1 +Float F2 [concrete]
   113	  rule applyBin("+", F1:Float, F2:Float) => addF(F1, F2)
   114	
   115	  syntax Float ::= mulF(Float, Float) [function, total, symbol(mulF), no-evaluators]
   116	  rule mulF(F1:Float, F2:Float) => F1 *Float F2 [concrete]
   117	  rule applyBin("*", F1:Float, F2:Float) => mulF(F1, F2)
   118	
   119	  syntax Float ::= powF(Float, Float) [function, total, symbol(powF), no-evaluators]
   120	  rule powF(F1:Float, F2:Float) => F1 ^Float F2 [concrete]
   121	  rule applyBin("**", F1:Float, F2:Float) => powF(F1, F2)
   122	
   123	  // ---- the remaining comparisons (gtF promoted from find_zero — its summaries
   124	  //      case-split on the atom; >= / <= derive from the two opaque compares) ----
   125	  syntax Bool ::= gtF(Float, Float) [function, total, symbol(gtF), no-evaluators]
   126	  rule gtF(F1:Float, F2:Float) => F1 >Float F2 [concrete]
   127	  rule applyCmp(">",  F1:Float, F2:Float) => gtF(F1, F2)
   128	  rule applyCmp(">=", F1:Float, F2:Float) => notBool floatLt(F1, F2)
   129	  rule applyCmp("<=", F1:Float, F2:Float) => notBool gtF(F1, F2)
   130	
   131	  // ---- mixed Int/Float operators promote the Int side (n ** 0.5 etc.) ----
   132	  rule applyBin("**", I:Int, F:Float) => powF(intToF(I), F)
   133	  rule applyBin("**", F:Float, I:Int) => powF(F, intToF(I))
   134	  rule applyBin("-",  I:Int, F:Float) => subF(intToF(I), F)
   135	  rule applyBin("-",  F:Float, I:Int) => subF(F, intToF(I))
   136	  rule applyBin("+",  I:Int, F:Float) => addF(intToF(I), F)
   137	  rule applyBin("+",  F:Float, I:Int) => addF(F, intToF(I))
   138	  rule applyBin("*",  I:Int, F:Float) => mulF(intToF(I), F)
   139	  rule applyBin("*",  F:Float, I:Int) => mulF(F, intToF(I))
   140	
   141	  // ---- mixed Int == Float (shared eqF; opaque symbolic / concrete twin) ----
   142	  syntax Bool ::= eqF(Float, Float) [function, total, symbol(eqF), no-evaluators]
   143	  rule eqF(F1:Float, F2:Float) => F1 ==Float F2 [concrete]
   144	  rule applyCmp("==", I:Int, F:Float) => eqF(intToF(I), F)
   145	  rule applyCmp("==", F:Float, I:Int) => eqF(F, intToF(I))
   146	  rule applyCmp("!=", I:Int, F:Float) => notBool eqF(intToF(I), F)
   147	  rule applyCmp("!=", F:Float, I:Int) => notBool eqF(F, intToF(I))
   148	  rule applyCmp("<",  I:Int, F:Float) => floatLt(intToF(I), F)
   149	  rule applyCmp("<",  F:Float, I:Int) => floatLt(F, intToF(I))
   150	  rule applyCmp(">",  I:Int, F:Float) => gtF(intToF(I), F)
   151	  rule applyCmp(">",  F:Float, I:Int) => gtF(F, intToF(I))
   152	
   153	  // ---- x == None (promoted from 137; `is` cases live in operators.k) ----
   154	  rule applyCmp("==", V:Val, noneV) => V ==K noneV
   155	  rule applyCmp("!=", V:Val, noneV) => notBool (V ==K noneV)
   156	
   157	  // ---- float(str): decimal parse (promoted from 137's defined chain) ----
   158	  // digits '.' digits, optional leading '-'; concrete evaluation only (the
   159	  // symbolic side stays an opaque decStrToF term a proof case-splits on).
   160	  syntax Float ::= decStrToF(IntSeq) [function, total, symbol(decStrToF), no-evaluators]
   161	  rule decStrToF(iCons(45, CS:IntSeq)) => 0.0 -Float decStrToF(CS) [concrete]
   162	  rule decStrToF(CS:IntSeq)
   163	    => intToF(intPart(CS)) +Float (intToF(fracPart(CS)) /Float intToF(fracScale(CS)))
   164	       requires isLen(CS) >Int 0 andBool headIS(CS) =/=Int 45 [concrete]
   165	  syntax Int ::= headIS(IntSeq) [function]
   166	  rule headIS(iCons(C:Int, _:IntSeq)) => C
   167	  syntax Int ::= intPart(IntSeq) [function, total] | intPartAcc(IntSeq, Int) [function, total]
   168	  rule intPart(CS:IntSeq) => intPartAcc(CS, 0)
   169	  rule intPartAcc(.IntSeq, A:Int) => A
   170	  rule intPartAcc(iCons(46, _:IntSeq), A:Int) => A
   171	  rule intPartAcc(iCons(C:Int, R:IntSeq), A:Int) => intPartAcc(R, A *Int 10 +Int (C -Int 48))
   172	       requires C =/=Int 46
   173	  syntax Int ::= fracPart(IntSeq) [function, total] | fracAcc(IntSeq, Int) [function, total]
   174	  rule fracPart(.IntSeq) => 0
   175	  rule fracPart(iCons(46, R:IntSeq)) => fracAcc(R, 0)
   176	  rule fracPart(iCons(C:Int, R:IntSeq)) => fracPart(R) requires C =/=Int 46
   177	  rule fracAcc(.IntSeq, A:Int) => A
   178	  rule fracAcc(iCons(C:Int, R:IntSeq), A:Int) => fracAcc(R, A *Int 10 +Int (C -Int 48))
   179	  syntax Int ::= fracScale(IntSeq) [function, total] | fscAcc(IntSeq, Int) [function, total]
   180	  rule fracScale(.IntSeq) => 1
   181	  rule fracScale(iCons(46, R:IntSeq)) => fscAcc(R, 1)
   182	  rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46
   183	  rule fscAcc(.IntSeq, A:Int) => A
   184	  rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)
   185	  rule applyBuiltin("float", str(CS:IntSeq), .Vals) => decStrToF(CS)
   186	  rule applyBuiltin("float", I:Int, .Vals)          => intToF(I)
   187	  rule applyBuiltin("float", F:Float, .Vals)        => F
   188	
   189	  // ---- float / int division (promoted from mean_absolute_deviation) ----
   190	  syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]
   191	  rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]
   192	  rule applyBin("/", F:Float, I:Int) => divFloatIntV(F, I)
   193	
   194	  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----
   195	  syntax Float ::= intToF(Int) [function, total, symbol(intToF), no-evaluators]
   196	  rule intToF(I:Int) => Int2Float(I, 53, 11) [concrete]
   197	  rule applyBin("+", I:Int, F:Float) => addF(intToF(I), F)
   198	  rule applyBin("+", F:Float, I:Int) => addF(F, intToF(I))
   199	  rule applyBin("-", I:Int, F:Float) => subF(intToF(I), F)
   200	  rule applyBin("-", F:Float, I:Int) => subF(F, intToF(I))
   201	  rule applyBin("*", I:Int, F:Float) => mulF(intToF(I), F)
   202	  rule applyBin("*", F:Float, I:Int) => mulF(F, intToF(I))
   203	  rule applyCmp("<", I:Int, F:Float) => floatLt(intToF(I), F)
   204	  rule applyCmp("<", F:Float, I:Int) => floatLt(F, intToF(I))
   205	  rule applyCmp(">", I:Int, F:Float) => gtF(intToF(I), F)
   206	  rule applyCmp(">", F:Float, I:Int) => gtF(F, intToF(I))
   207	
   208	  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----
   209	  syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]
   210	  rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]
   211	  rule applyBuiltin("int", F:Float, .Vals) => truncF(F)
   212	
   213	  rule applyBuiltin("float", I:Int, .Vals)   => intToF(I)
   214	  rule applyBuiltin("float", F:Float, .Vals) => F
   215	
   216	  // round: Python half-even (banker's); round(F, N) scales by 10^N
   217	  syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]
   218	  rule roundF(F:Float)
   219	    => #if (F -Float floorFloat(F)) ==Float 0.5
   220	       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
   221	              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
   222	       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
   223	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   224	  rule roundFN(F:Float, N:Int)
   225	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   226	       /Float Int2Float(10 ^Int N, 53, 11) [concrete]
   227	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   228	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   229	
   230	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   231	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   232	  syntax KItem ::= "#mathSqrt"
   233	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   234	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   235	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   236	
   237	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   238	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   239	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   240	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   241	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   242	  // the isFloat guard is disjoint from the existing isInt one.
   243	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   244	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   245	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   246	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   247	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   248	       requires isFloat(V)
   249	
   250	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   251	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   252	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   253	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   254	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   255	       requires isFloat(V)
   256	
   257	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   258	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   259	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   260	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   261	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   262	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   263	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   264	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   265	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   266	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   267	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   268	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   269	       requires isFloat(V)
   270	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   271	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   272	       requires isInt(V) orBool isBool(V)
   273	endmodule
     1	// reference/src/semantics/list.k — MPY-LIST
     2	
     3	module MPY-LIST
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-OPERATORS
     7	
     8	  // ==== iteration (the iterator protocol's list case) =======================
     9	  rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>
    10	  rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>
    11	
    12	  // ==== ListExpr: [...] literal -> a fresh heap object =======================
    13	  syntax ApplyK ::= "toList"
    14	  rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>
    15	  rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>
    16	
    17	  // ==== list ops: + / == / != ===============================================
    18	  syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]
    19	  rule valSeqConcat(.ValSeq, T:ValSeq)                => T
    20	  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))
    21	
    22	  // list + list constructs a NEW object (k-cell — it allocates; operands land here
    23	  // already deref'd). priority(45) beats the generic BinOp dispatch.
    24	  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
    25	       [priority(45)]
    26	
    27	  rule applyCmp("==", list(A:ValSeq), list(B:ValSeq)) => A ==K B
    28	  rule applyCmp("!=", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== deep equality when elements are heap objects (list-of-lists) ========
    31	  // Python == is structural at every depth. Fires ONLY when a ref is present
    32	  // (the guard decides on concrete seqs); the plain ==K path above is unchanged.
    33	  syntax Bool ::= hasRefVS(ValSeq) [function, total]
    34	  rule hasRefVS(.ValSeq)                => false
    35	  rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)
    36	
    37	  syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]
    38	                | deepEqV(Val, Val, Map)        [function]
    39	  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true
    40	  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false
    41	  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false
    42	  rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)
    43	    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)
    44	
    45	  rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)
    46	       requires H in_keys(HP)
    47	  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
    48	       requires notBool isRefV(A) andBool H in_keys(HP)
    49	  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)
    50	  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]
    51	
    52	  // ==== mutator: xs.append(v) — an in-place heap write ======================
    53	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
    54	       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
    55	       [priority(40)]
    56	
    57	  // ==== `x in list` — a <k>-cell fold over #iterNext ========================
    58	  syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | "#notB"
    59	  rule <k> Compare(LV:Val, CmpOp("in",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>
    60	  rule <k> Compare(LV:Val, CmpOp("not in", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>
    61	  rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>
    62	  rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>
    63	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    64	       requires E ==K V
    65	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    66	       requires notBool (E ==K V)
    67	  rule <k> B:Bool ~> #notB => notBool B ... </k>
    68	endmodule
     1	// reference/src/semantics/controls.k — MPY-CONTROLS
     2	
     3	module MPY-CONTROLS
     4	  imports MPY-CORE
     5	  imports MPY-TUPLE
     6	  imports MPY-ITER
     7	
     8	  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
     9	  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
    10	       <env> L:Int </env>
    11	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
    12	  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
    13	       <env> L:Int </env>
    14	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    15	       requires "$cells" in_keys(M)
    16	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
    17	        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
    18	       [priority(40)]
    19	
    20	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
    21	       <env> L:Int </env>
    22	       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
    23	       requires X in_keys(M)
    24	  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
    25	  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
    26	  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
    27	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
    28	       <env> L:Int </env>
    29	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    30	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    31	       [priority(40)]
    32	
    33	  // ==== import trivia: `from math import floor, ceil` binds the supported
    34	  // names as builtins in the current scope; every other import is a no-op
    35	  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
    36	  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
    37	  syntax KItem ::= #bindImports(ParamNames)
    38	  rule <k> #bindImports(.ParamNames) => .K ... </k>
    39	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    40	       <env> L:Int </env>
    41	       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
    42	       requires N ==String "floor" orBool N ==String "ceil"
    43	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    44	       requires notBool (N ==String "floor" orBool N ==String "ceil")
    45	
    46	  // ==== Expr statement: evaluate for effect, discard the value ===============
    47	  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
    48	  rule <k> Expr(_:Val) => .K ... </k>
    49	
    50	  // ==== If (condition evaluated by strictness) ==============================
    51	  syntax KItem ::= #branch(Bool, Stmts, Stmts)
    52	  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
    53	  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
    54	  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
    55	
    56	  // ==== IfExp: ternary T if C else E ========================================
    57	  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
    58	       requires truthy(V)
    59	  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
    60	       requires notBool truthy(V)
    61	
    62	  // ==== For: one loop, in-cell continuation, over #iterNext =================
    63	  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
    64	  // circularities anchor on #loop and narrowing substitutes the structure)
    65	  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
    66	                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
    67	                 | #loopLbl(K) | "#cont" | "#brk"
    68	
    69	  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
    70	
    71	  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
    72	  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
    73	  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
    74	        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
    75	
    76	  // ==== While ==============================================================
    77	  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
    78	  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
    79	  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
    80	       requires truthy(V)
    81	  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
    82	       requires notBool truthy(V)
    83	
    84	  // ==== loop control (break / continue) =====================================
    85	  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
    86	  rule <k> Continue => #cont ... </k>
    87	  rule <k> Break => #brk ... </k>
    88	  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
    89	  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
    90	  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
    91	  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
    92	
    93	  // ==== heap-object deref at the truthiness/iteration consumers ==============
    94	  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
    95	  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
    96	       <heap> ... H |-> V:Val ... </heap>
    97	       [priority(40)]
    98	  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
    99	       <heap> ... H |-> V:Val ... </heap>
   100	       [priority(40)]
   101	  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
   102	       <heap> ... H |-> V:Val ... </heap>
   103	       [priority(40)]
   104	  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
   105	  // mutating the iterated list inside its own loop is outside the subset)
   106	  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
   107	       <heap> ... H |-> V:Val ... </heap>
   108	       [priority(40)]
   109	endmodule

diff --git a/evidence/01_generation_records.py b/evidence/01_generation_records.py
new file mode 100644
index 0000000000000000000000000000000000000000..d80802527f83e779d9af8ab447bef291e6737c9f
--- /dev/null
+++ b/evidence/01_generation_records.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Parse every pipeline-v3 generation record without trusting its claims."""
+
+from __future__ import annotations
+
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+
+
+TRACE = Path(
+    "/generation/codex-trace/2026/07/26/"
+    "rollout-2026-07-26T00-57-01-019f9cff-8c9c-76e3-8d3b-1ccd3a1400fc.jsonl"
+)
+
+
+def digest(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def clipped(value: object, limit: int = 360) -> str:
+    text = value if isinstance(value, str) else json.dumps(value, sort_keys=True)
+    text = " ".join(text.split())
+    return text if len(text) <= limit else text[:limit] + "...[clipped]"
+
+
+print("COMMAND: python3 /audit-output/evidence/01_generation_records.py")
+for raw_path in (
+    "/run.json",
+    "/task.json",
+    "/generation-result.json",
+    "/generation/invocation.json",
+    "/generation/metrics.json",
+    "/generation/runtime-metrics.json",
+    "/generation/usage.json",
+):
+    path = Path(raw_path)
+    value = json.loads(path.read_text())
+    print(
+        "VALID_JSON",
+        raw_path,
+        "sha256=" + digest(path),
+        "top_keys=" + ",".join(sorted(value)),
+    )
+
+type_counts: Counter[str] = Counter()
+payload_counts: Counter[str] = Counter()
+function_counts: Counter[str] = Counter()
+commands: list[str] = []
+messages: list[tuple[str, str]] = []
+line_count = 0
+with TRACE.open() as stream:
+    for line_count, line in enumerate(stream, 1):
+        event = json.loads(line)
+        event_type = event.get("type", "<missing>")
+        type_counts[event_type] += 1
+        payload = event.get("payload", {})
+        payload_type = payload.get("type", "<missing>")
+        payload_counts[f"{event_type}/{payload_type}"] += 1
+        if event_type == "response_item" and payload_type == "function_call":
+            name = payload.get("name", "<missing>")
+            function_counts[name] += 1
+            args = payload.get("arguments", "")
+            commands.append(f"{name}: {clipped(args)}")
+        if event_type == "response_item" and payload_type == "message":
+            role = payload.get("role", "<missing>")
+            for content in payload.get("content", []):
+                if content.get("type") in {"input_text", "output_text"}:
+                    messages.append((role, clipped(content.get("text", ""), 500)))
+        if event_type == "event_msg" and payload_type == "agent_message":
+            messages.append(("agent_message", clipped(payload.get("message", ""), 500)))
+
+print("TRACE_VALID_JSONL", f"lines={line_count}", "sha256=" + digest(TRACE))
+print("TRACE_EVENT_COUNTS", dict(sorted(type_counts.items())))
+print("TRACE_PAYLOAD_COUNTS", dict(sorted(payload_counts.items())))
+print("TRACE_FUNCTION_COUNTS", dict(sorted(function_counts.items())))
+print("TRACE_TOOL_CALLS_BEGIN")
+for index, command in enumerate(commands, 1):
+    print(f"{index:03d}", command)
+print("TRACE_TOOL_CALLS_END")
+print("TRACE_MESSAGES_BEGIN")
+for role, message in messages:
+    print(role + ":", message)
+print("TRACE_MESSAGES_END")
+
+output_path = Path("/generation/codex-output.log")
+output_text = output_path.read_text(errors="strict")
+print(
+    "CODEX_OUTPUT_FULL_READ",
+    f"chars={len(output_text)}",
+    f"lines={output_text.count(chr(10))}",
+    "sha256=" + digest(output_path),
+    f"kprove_mentions={output_text.count('kprove')}",
+    f"Top_mentions={output_text.count('#Top')}",
+    f"RESULT_mentions={output_text.count('RESULT:')}",
+)
+print("CODEX_OUTPUT_PREFIX", clipped(output_text[:1000], 1000))
+print("CODEX_OUTPUT_SUFFIX", clipped(output_text[-1600:], 1600))
+
+last_path = Path("/generation/codex-last.txt")
+last_text = last_path.read_text(errors="strict")
+print("CODEX_LAST_FULL_READ", "sha256=" + digest(last_path), clipped(last_text, 1000))
+print("SCRIPT_EXIT=0")
diff --git a/evidence/01_integrity.sh b/evidence/01_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f77fa1619037b8ec38245483983499a299ded393
--- /dev/null
+++ b/evidence/01_integrity.sh
@@ -0,0 +1,137 @@
+#!/usr/bin/env bash
+set -u
+
+status=0
+finish() {
+  local rc=$?
+  echo "SCRIPT_EXIT=$rc"
+}
+trap finish EXIT
+
+required=(
+  /audit-input.json
+  /run.json
+  /task.json
+  /generation-result.json
+  /generation/invocation.json
+  /generation/metrics.json
+  /generation/runtime-metrics.json
+  /generation/usage.json
+  /generation/codex-last.txt
+  /generation/codex-output.log
+  /generation/prompt.txt
+  /reference/canonical.py
+  /reference/prompt.py
+  /reference/py2mpy.py
+)
+
+echo "COMMAND: bash /audit-output/evidence/01_integrity.sh"
+echo "REQUIRED_ARTIFACT_TYPES"
+for path in "${required[@]}"; do
+  if [[ -f "$path" && ! -L "$path" && -r "$path" ]]; then
+    stat -c '%F %a %s %n' "$path"
+  else
+    echo "INVALID_REQUIRED_ARTIFACT $path"
+    status=1
+  fi
+done
+
+echo "TRACE_ENTRIES"
+find /generation/codex-trace -printf '%y %P -> %l\n' | LC_ALL=C sort
+if find /generation/codex-trace -type l -print -quit | grep -q .; then
+  echo "INVALID_TRACE_SYMLINK"
+  status=1
+fi
+if ! find /generation/codex-trace -type f -name '*.jsonl' -print -quit | grep -q .; then
+  echo "MISSING_TRACE_JSONL"
+  status=1
+fi
+
+echo "DECLARED_INDIVIDUAL_HASH_CHECKS"
+check_hash() {
+  local expected=$1
+  local path=$2
+  local actual
+  actual=$(sha256sum "$path" | awk '{print $1}')
+  if [[ "$actual" == "$expected" ]]; then
+    echo "MATCH $actual $path"
+  else
+    echo "MISMATCH expected=$expected actual=$actual path=$path"
+    status=1
+  fi
+}
+
+check_hash b19fa4b9ec23ba3f2deb06e3228d77cef75127023b2ef10b386b54df9da9c9d6 /reference/canonical.py
+check_hash 00b2e074e127a6a9d1376278bef732933760ab706057ec755a8c2642217b557a /reference/prompt.py
+check_hash 406485eac118431c08ef59f30f79dfa6aa9d5825408917fc5ce7c806e664db16 /reference/py2mpy.py
+check_hash 6081e7000c8636ede4cc88b731a31c76b1addb4060846e784e1559c0d59a5835 /run.json
+check_hash 95bc32a8e5e760474590ee9868474992ab8c0568a115471c8744785b7f4d4046 /task.json
+check_hash 6a135dc6169282dddb167d79b37692d06db062c9264f6650850859725da415e6 /generation-result.json
+check_hash 1dc8b670dd8081937eb66b256a9d9301b8f69c9ca35c2059aa06d223ee58da78 /generation/invocation.json
+check_hash 4b1cbc23a10b3a48fa2481b1bec6a2f5adab73127690f78637c9506657a81a1e /generation/metrics.json
+check_hash 799420963df0d0fb0d4de9671d7bedd7e2959b71c31f562bcba81dae837420b1 /generation/runtime-metrics.json
+check_hash cba0aa6feccd360dc376c930bba3b68d97b38aa8fb51a56af59eca09823a4066 /generation/usage.json
+check_hash 5ae68978fcf419d9e04292450e771a6734983c902e0b0d1d47694a2f38c4a7df /generation/codex-last.txt
+check_hash 280762517078d34ca0ee68665fbde1e7ff1221ea9a3840b20b14c6a77d3fe1d0 /generation/codex-output.log
+check_hash b6a26e02e06727577af0efab0b2bd22c3eb20fe397b069271f4eb05184d671cd /generation/prompt.txt
+check_hash 223987e90c3b178c05e5ac3910f085c082e15b5bf54d28956c9cf5a4f6b72519 /generation/codex-trace/2026/07/26/rollout-2026-07-26T00-57-01-019f9cff-8c9c-76e3-8d3b-1ccd3a1400fc.jsonl
+
+echo "CANDIDATE_TRUSTED_FILE_COMPARISONS"
+for pair in \
+  "/candidate/prompt.py /reference/prompt.py" \
+  "/candidate/py2mpy.py /reference/py2mpy.py"
+do
+  set -- $pair
+  if [[ -f "$1" && ! -L "$1" ]] && cmp -s "$1" "$2"; then
+    echo "IDENTICAL $1 $2"
+  else
+    echo "NOT_IDENTICAL_OR_INVALID $1 $2"
+    status=1
+  fi
+done
+
+echo "SUPPLIED_SEMANTICS_TYPE_MANIFESTS"
+find /reference/reference-semantics -printf '%y\t%P\t%l\n' | LC_ALL=C sort
+find /candidate/reference-semantics -printf '%y\t%P\t%l\n' | LC_ALL=C sort
+find /reference/reference-semantics -printf '%y\t%P\t%l\n' | LC_ALL=C sort > /tmp/audit-work/reference-semantics.types
+find /candidate/reference-semantics -printf '%y\t%P\t%l\n' | LC_ALL=C sort > /tmp/audit-work/candidate-semantics.types
+if cmp -s /tmp/audit-work/reference-semantics.types /tmp/audit-work/candidate-semantics.types; then
+  echo "SEMANTICS_TYPES_IDENTICAL"
+else
+  echo "SEMANTICS_TYPE_MISMATCH"
+  diff -u /tmp/audit-work/reference-semantics.types /tmp/audit-work/candidate-semantics.types || true
+  status=1
+fi
+if diff -qr --no-dereference /reference/reference-semantics /candidate/reference-semantics; then
+  echo "SEMANTICS_CONTENT_IDENTICAL"
+else
+  echo "SEMANTICS_CONTENT_MISMATCH"
+  status=1
+fi
+
+echo "INDEPENDENT_SOURCE_HASHES"
+find /candidate -maxdepth 1 -type f -print0 |
+  LC_ALL=C sort -z |
+  xargs -0 sha256sum
+find /reference/reference-semantics -type f -print0 |
+  LC_ALL=C sort -z |
+  xargs -0 sha256sum
+
+echo "REQUIRED_CANDIDATE_PROOF_ARTIFACTS"
+for path in \
+  /candidate/solution.py \
+  /candidate/solution.mpy \
+  /candidate/verification.k \
+  /candidate/spec.k \
+  /candidate/prove.sh \
+  /candidate/PROOF.md
+do
+  if [[ -f "$path" && ! -L "$path" && -r "$path" ]]; then
+    stat -c '%F %a %s %n' "$path"
+  else
+    echo "INVALID_CANDIDATE_ARTIFACT $path"
+    status=1
+  fi
+done
+
+exit "$status"
diff --git a/evidence/02_differential.py b/evidence/02_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e46037ef863cb6f5ba45fa23b05c536173c53d0
--- /dev/null
+++ b/evidence/02_differential.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""Independent canonical-vs-generated differential for HumanEval/0."""
+
+from __future__ import annotations
+
+from itertools import combinations, product
+import importlib.util
+import math
+from pathlib import Path
+import random
+import sys
+
+
+def load_function(module_name: str, path: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.has_close_elements
+
+
+canonical = load_function("trusted_canonical", "/reference/canonical.py")
+generated = load_function("submitted_generated", "/candidate/solution.py")
+
+
+def independent_oracle(numbers: list[float], threshold: float) -> bool:
+    return any(abs(left - right) < threshold for left, right in combinations(numbers, 2))
+
+
+explicit_cases = [
+    # Documented examples.
+    ([1.0, 2.0, 3.0], 0.5),
+    ([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3),
+    # Empty/singleton and loop-entry boundaries.
+    ([], 0.5),
+    ([1.0], 0.5),
+    # i < j false/true paths, distance false/true paths, and sticky `found`.
+    ([0.0, 2.0], 1.0),
+    ([0.0, 0.25], 1.0),
+    ([0.0, 10.0, 10.25], 0.5),
+    ([0.0, 0.25, 10.0], 0.5),
+    # Strict-comparison boundary and its immediate neighbors.
+    ([1.0, 1.5], 0.5),
+    ([1.0, 1.5], math.nextafter(0.5, math.inf)),
+    ([1.0, 1.5], math.nextafter(0.5, -math.inf)),
+    # Zero, negative thresholds, duplicates, signed zero, and ordering.
+    ([1.0, 1.0], 0.0),
+    ([1.0, 1.0], math.nextafter(0.0, math.inf)),
+    ([1.0, 1.0], -1.0),
+    ([-0.0, 0.0], math.nextafter(0.0, math.inf)),
+    ([2.0, 0.0, 1.0], 1.5),
+    # Representative IEEE special values accepted by CPython's float type.
+    ([math.inf, math.inf], 1.0),
+    ([-math.inf, math.inf], math.inf),
+    ([math.nan, 0.0], 1.0),
+    ([sys.float_info.max, math.nextafter(sys.float_info.max, 0.0)], math.inf),
+]
+
+grid_values = [-2.0, -0.5, -0.0, 0.5, 2.0]
+grid_thresholds = [-1.0, 0.0, 0.25, 0.5, 1.0, 3.0]
+grid_cases = [
+    (list(numbers), threshold)
+    for size in range(5)
+    for numbers in product(grid_values, repeat=size)
+    for threshold in grid_thresholds
+]
+
+rng = random.Random(0x0C105E)
+sample_values = [
+    -1e300,
+    -100.0,
+    -1.0,
+    -1e-300,
+    -0.0,
+    0.0,
+    1e-300,
+    0.125,
+    1.0,
+    100.0,
+    1e300,
+]
+sample_thresholds = [
+    -1e300,
+    -1.0,
+    -0.0,
+    0.0,
+    math.nextafter(0.0, math.inf),
+    1e-300,
+    0.125,
+    1.0,
+    1e300,
+    math.inf,
+]
+random_cases = [
+    (
+        [rng.choice(sample_values) for _ in range(rng.randrange(0, 13))],
+        rng.choice(sample_thresholds),
+    )
+    for _ in range(2000)
+]
+
+all_cases = explicit_cases + grid_cases + random_cases
+mismatches = []
+for index, (numbers, threshold) in enumerate(all_cases):
+    original = list(numbers)
+    expected = canonical(list(numbers), threshold)
+    actual = generated(list(numbers), threshold)
+    oracle = independent_oracle(list(numbers), threshold)
+    if expected is not oracle or actual is not expected:
+        mismatches.append((index, numbers, threshold, expected, actual, oracle))
+    unchanged = len(numbers) == len(original) and all(
+        left is right or left == right for left, right in zip(numbers, original)
+    )
+    if not unchanged:
+        mismatches.append((index, "INPUT_MUTATED", original, numbers))
+
+print("COMMAND: python3 /audit-output/evidence/02_differential.py")
+print("ORACLES: trusted /reference/canonical.py and independent itertools.combinations")
+print("EXPLICIT_CASES:", len(explicit_cases))
+print(
+    "GRID:",
+    "sizes=0..4",
+    f"values={grid_values!r}",
+    f"thresholds={grid_thresholds!r}",
+    f"cases={len(grid_cases)}",
+)
+print(
+    "RANDOM:",
+    "seed=0x0C105E",
+    "sizes=0..12",
+    f"values={sample_values!r}",
+    f"thresholds={sample_thresholds!r}",
+    f"cases={len(random_cases)}",
+)
+print("TOTAL_CASES:", len(all_cases))
+print("MISMATCHES:", len(mismatches))
+for mismatch in mismatches[:20]:
+    print("MISMATCH", repr(mismatch))
+print("SCRIPT_EXIT=" + ("1" if mismatches else "0"))
+raise SystemExit(1 if mismatches else 0)
diff --git a/evidence/02_translation.sh b/evidence/02_translation.sh
new file mode 100644
index 0000000000000000000000000000000000000000..06da100c4beb4f42c865ad1b2e24f8d2e69648c2
--- /dev/null
+++ b/evidence/02_translation.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -u
+finish() {
+  local rc=$?
+  echo "SCRIPT_EXIT=$rc"
+}
+trap finish EXIT
+
+echo "COMMAND: python3 /tmp/audit-work/reconstruction/py2mpy.py /tmp/audit-work/reconstruction/solution.py > /tmp/audit-work/reconstruction/solution.mpy"
+python3 /tmp/audit-work/reconstruction/py2mpy.py \
+  /tmp/audit-work/reconstruction/solution.py \
+  > /tmp/audit-work/reconstruction/solution.mpy
+
+echo "HASHES"
+sha256sum \
+  /tmp/audit-work/reconstruction/solution.py \
+  /tmp/audit-work/reconstruction/solution.mpy \
+  /candidate/solution.py \
+  /candidate/solution.mpy
+
+echo "BYTE_COMPARISON"
+cmp -l /tmp/audit-work/reconstruction/solution.mpy /candidate/solution.mpy
+rc=$?
+if [[ "$rc" -eq 0 ]]; then
+  echo "REGENERATED_SOLUTION_MPY_BYTE_IDENTICAL"
+else
+  echo "REGENERATED_SOLUTION_MPY_DIFFERS cmp_exit=$rc"
+fi
+exit "$rc"
diff --git a/evidence/03_rebuild_and_prove.sh b/evidence/03_rebuild_and_prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..509aa7669437234f63daae263ffd02952ed4938d
--- /dev/null
+++ b/evidence/03_rebuild_and_prove.sh
@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/reconstruction || exit 90
+overall=0
+
+run() {
+  echo "COMMAND: $*"
+  "$@"
+  local rc=$?
+  echo "EXIT_STATUS: $rc"
+  if [[ "$rc" -ne 0 ]]; then
+    overall=1
+  fi
+  return 0
+}
+
+echo "SOURCE_DEFINITION_CHECK"
+find . -maxdepth 2 -printf '%y %P -> %l\n' | LC_ALL=C sort
+if find . -type l -print -quit | grep -q .; then
+  echo "UNEXPECTED_SCRATCH_SYMLINK"
+  overall=1
+fi
+
+echo "COMMAND: python3 py2mpy.py smoke.py > smoke.mpy"
+python3 py2mpy.py smoke.py > smoke.mpy
+translation_rc=$?
+echo "EXIT_STATUS: $translation_rc"
+if [[ "$translation_rc" -ne 0 ]]; then
+  overall=1
+fi
+
+run kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition fresh-runtime-kompiled
+run krun smoke.mpy --definition fresh-runtime-kompiled
+
+run kompile --backend haskell connection-verification.k \
+  --main-module CONNECTION-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition fresh-connection-kompiled
+run kprove connection-spec.k \
+  --definition fresh-connection-kompiled \
+  --spec-module CONNECTION-SPEC
+
+run kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition fresh-verification-kompiled
+run kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.inner-loop
+run kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.inner-loop,SPEC.outer-loop
+run kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC
+
+echo "SCRIPT_EXIT=$overall"
+exit "$overall"
