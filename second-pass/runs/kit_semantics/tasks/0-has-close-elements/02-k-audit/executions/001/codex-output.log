+requires "spec.k"
+
+module AUDIT-FALSE-RESULT
+  imports SPEC
+
+  // Fresh reviewer mutation: keep the submitted outer-loop program term
+  // unchanged but demand final found=false whenever the two elements are close.
+  // Satisfying witness: A=1.0, B=1.0, T=0.1 (also in the LLVM smoke run).
+  claim [close-pair-cannot-return-false]:
+    <k>
+      #loop(
+        list(vCons(A:Float, vCons(B:Float, .ValSeq))),
+        Name("number1"),
+        Assign(Name("j"), Int(0))
+        For(Name("number2"), Name("numbers"),
+          If(Compare(Name("i"), CmpOp("<", Name("j"))),
+            If(
+              Compare(
+                Call(Name("abs"),
+                  BinOp("-", Name("number1"), Name("number2"))),
+                CmpOp("<", Name("threshold"))),
+              Assign(Name("found"), Bool(true)),
+              .Stmts),
+            .Stmts)
+          Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("has_close_elements" |-> _CLOSURE:Val, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "numbers"  |-> list(vCons(A, vCons(B, .ValSeq)))
+        "threshold"|-> T:Float
+        "found"    |-> (false => false)
+        "i"        |-> (0 => 2)
+        "j"        |-> (0 => ?JFinal:Int)
+        "number1"  |-> (0.0 => ?N1Final:Val)
+        "number2"  |-> (0.0 => ?N2Final:Val),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires pairNear(A, B, T)
+endmodule
diff --git a/evidence/06_false_result.sh b/evidence/06_false_result.sh
new file mode 100644
index 0000000000000000000000000000000000000000..91e1b281b27b31a2ca6fc917d39a40cc6df84f56
--- /dev/null
+++ b/evidence/06_false_result.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/reconstruction || exit 90
+cp /audit-output/evidence/06_false_result.k ./06_false_result.k
+
+echo "COMMAND: kprove 06_false_result.k --definition fresh-verification-kompiled --spec-module AUDIT-FALSE-RESULT --dry-run"
+kprove 06_false_result.k \
+  --definition fresh-verification-kompiled \
+  --spec-module AUDIT-FALSE-RESULT \
+  --dry-run
+dry_rc=$?
+echo "DRY_RUN_EXIT_STATUS: $dry_rc"
+
+echo "COMMAND: kprove 06_false_result.k --definition fresh-verification-kompiled --spec-module AUDIT-FALSE-RESULT"
+kprove 06_false_result.k \
+  --definition fresh-verification-kompiled \
+  --spec-module AUDIT-FALSE-RESULT
+proof_rc=$?
+echo "PROOF_EXIT_STATUS: $proof_rc"
+
+if [[ "$dry_rc" -eq 0 && "$proof_rc" -ne 0 ]]; then
+  echo "EXPECTED_FALSE_RESULT_REJECTION"
+  echo "SCRIPT_EXIT=0"
+  exit 0
+fi
+echo "UNEXPECTED_FALSE_RESULT_OUTCOME"
+echo "SCRIPT_EXIT=1"
+exit 1

