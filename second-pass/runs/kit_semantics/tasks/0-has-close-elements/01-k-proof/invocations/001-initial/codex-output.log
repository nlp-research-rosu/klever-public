+        "j"        |-> (J:Int => ?JFinal:Int)
+        "number1"  |-> A:Float
+        "number2"  |-> (_OLD:Val => ?LAST:Val),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires allFloats(VS)
+     andBool allFloats(REM)
+     andBool 0 <=Int I
+     andBool 0 <=Int J
