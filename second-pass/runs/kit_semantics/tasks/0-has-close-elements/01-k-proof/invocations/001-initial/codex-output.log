@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module CONNECTION-VERIFICATION
+  imports MPY
+
+  // Deliberately separate copies used only to prove the indexing connection.
+  // This module does not import verification.k or its simplification lemma.
+  syntax Bool ::= allFloatsC(ValSeq) [function, total]
+  rule allFloatsC(.ValSeq)           => true
+  rule allFloatsC(vCons(_:Float, R)) => allFloatsC(R)
+  rule allFloatsC(vCons(V:Val, _))   => false
+    requires notBool isFloat(V)
+
+  syntax Float ::= floatAtC(ValSeq, Int) [function, total]
+  rule floatAtC(vCons(F:Float, _), 0) => F
+  rule floatAtC(vCons(_:Float, R), I) => floatAtC(R, I -Int 1)
+    requires I >Int 0
+  rule floatAtC(.ValSeq, _)           => 0.0
+  rule floatAtC(vCons(_:Float, _), I) => 0.0
+    requires I <Int 0
+  rule floatAtC(vCons(V:Val, _), _)   => 0.0
+    requires notBool isFloat(V)
+endmodule
