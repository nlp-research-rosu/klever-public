diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c800832c32cdbb9ed309a048a85e1287ae40cb27
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports FLOAT-SYNTAX
+
+  // An inductive presentation of every finite sequence of Python floats.
+  syntax FloatSeq ::= ".FloatSeq"
+                    | fCons(Float, FloatSeq)
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Exact embedding of FloatSeq into the reference semantics' ValSeq.
+  syntax ValSeq ::= floats(FloatSeq) [function, total]
+  rule floats(.FloatSeq)            => .ValSeq
+  rule floats(fCons(F, FS))         => vCons(F, floats(FS))
+
+  syntax Int ::= fLen(FloatSeq) [function, total]
+  rule fLen(.FloatSeq)              => 0
+  rule fLen(fCons(_, FS))           => 1 +Int fLen(FS)
+
+  // Totalized indexing.  The proof only uses the in-bounds branch.
+  syntax Float ::= fAt(FloatSeq, Int) [function, total]
+  rule fAt(fCons(F, _), 0)          => F
+  rule fAt(fCons(_, FS), I)         => fAt(FS, I -Int 1)
+    requires I >Int 0
+  rule fAt(.FloatSeq, _)            => 0.0
+  rule fAt(fCons(_, _), I)          => 0.0
+    requires I <Int 0
+
+  // Derived, structure-preserving equations for len and valid indexing.
+  rule vsLen(floats(FS))            => fLen(FS) [simplification]
+  rule valSeqAt(floats(FS), I)      => fAt(FS, I)
+    requires 0 <=Int I andBool I <Int fLen(FS)
+    [simplification]
+
+  // The exact Boolean atom evaluated by the Python loop for pair (I,J).
+  syntax Bool ::= pairNear(FloatSeq, Float, Int, Int) [function, total]
+  rule pairNear(FS, T, I, J)
+    => floatLt(absF(subF(fAt(FS, I), fAt(FS, J))), T)
+
+  // rowAcc is the final accumulator after testing J .. N-1 against I.
+  syntax Bool ::= rowAcc(Bool, FloatSeq, Float, Int, Int, Int)
+                  [function, total, no-evaluators]
+  rule rowAcc(B, _, _, _, J, N) => B
+    requires J >=Int N
+  rule rowAcc(B, FS, T, I, J, N)
+    => rowAcc(B orBool pairNear(FS, T, I, J), FS, T, I, J +Int 1, N)
+    requires J <Int N
+
+  // outerAcc is the final accumulator after rows I .. N-1.
+  syntax Bool ::= outerAcc(Bool, FloatSeq, Float, Int, Int)
+                  [function, total, no-evaluators]
+  rule outerAcc(B, _, _, I, N) => B
+    requires I >=Int N
+  rule outerAcc(B, FS, T, I, N)
+    => outerAcc(rowAcc(B, FS, T, I, I +Int 1, N),
+                FS, T, I +Int 1, N)
+    requires I <Int N
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..db70be2c7ff9757dc067babd95eb219636462376
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+from typing import List
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    found = False
+    i = 0
+    while i < len(numbers):
+        j = i + 1
+        while j < len(numbers):
+            if abs(numbers[i] - numbers[j]) < threshold:
+                found = True
+            j = j + 1
+        i = i + 1
+    return found
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a4d7fc3598d02e1dc325e25c7cc40694838701b3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,156 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k>
+      #while(
+        Compare(Name("j"),
+          CmpOp("<", Call(Name("len"), Name("numbers")))),
+        If(
+          Compare(
+            Call(Name("abs"),
+              BinOp("-",
+                Subscript(Name("numbers"), Name("i")),
+                Subscript(Name("numbers"), Name("j")))),
+            CmpOp("<", Name("threshold"))),
+          Assign(Name("found"), Bool(true)),
+          .Stmts)
+        Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "numbers"  |-> list(floats(FS:FloatSeq))
+        "threshold"|-> T:Float
+        "found"    |-> (B:Bool => rowAcc(B, FS, T, I, J, N))
+        "i"        |-> I:Int
+        "j"        |-> (J:Int => N:Int)
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    requires N ==Int fLen(FS)
+     andBool 0 <=Int I
+     andBool I <Int N
+     andBool I +Int 1 <=Int J
+     andBool J <=Int N
+
+  claim [outer-loop]:
+    <k>
+      #while(
+        Compare(Name("i"),
+          CmpOp("<", Call(Name("len"), Name("numbers")))),
+        Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+        While(
+          Compare(Name("j"),
+            CmpOp("<", Call(Name("len"), Name("numbers")))),
+          If(
+            Compare(
+              Call(Name("abs"),
+                BinOp("-",
+                  Subscript(Name("numbers"), Name("i")),
+                  Subscript(Name("numbers"), Name("j")))),
+              CmpOp("<", Name("threshold"))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts)
+          Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "numbers"  |-> list(floats(FS:FloatSeq))
+        "threshold"|-> T:Float
+        "found"    |-> (B:Bool => outerAcc(B, FS, T, I, N))
+        "i"        |-> (I:Int => N:Int)
+        "j"        |-> (_J:Int => ?JFinal:Int)
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    requires N ==Int fLen(FS)
+     andBool 0 <=Int I
+     andBool I <=Int N
+
+  claim [has-close-elements]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef("has_close_elements", Params("numbers", "threshold"),
+            Assign(Name("found"), Bool(false))
+            Assign(Name("i"), Int(0))
+            While(
+              Compare(Name("i"),
+                CmpOp("<", Call(Name("len"), Name("numbers")))),
+              Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+              While(
+                Compare(Name("j"),
+                  CmpOp("<", Call(Name("len"), Name("numbers")))),
+                If(
+                  Compare(
+                    Call(Name("abs"),
+                      BinOp("-",
+                        Subscript(Name("numbers"), Name("i")),
+                        Subscript(Name("numbers"), Name("j")))),
+                    CmpOp("<", Name("threshold"))),
+                  Assign(Name("found"), Bool(true)),
+                  .Stmts)
+                Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+            Return(Name("found")))))
+      ~> Call(Name("has_close_elements"),
+              list(floats(FS:FloatSeq)), T:Float)
+      => outerAcc(false, FS, T, 0, fLen(FS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "has_close_elements" |->
+                closureVal(
+                  ("numbers", "threshold"),
+                  Assign(Name("found"), Bool(false))
+                  Assign(Name("i"), Int(0))
+                  While(
+                    Compare(Name("i"),
+                      CmpOp("<", Call(Name("len"), Name("numbers")))),
+                    Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+                    While(
+                      Compare(Name("j"),
+                        CmpOp("<", Call(Name("len"), Name("numbers")))),
+                      If(
+                        Compare(
+                          Call(Name("abs"),
+                            BinOp("-",
+                              Subscript(Name("numbers"), Name("i")),
+                              Subscript(Name("numbers"), Name("j")))),
+                          CmpOp("<", Name("threshold"))),
+                        Assign(Name("found"), Bool(true)),
+                        .Stmts)
+                      Assign(Name("j"),
+                        BinOp("+", Name("j"), Int(1))))
+                    Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+                  Return(Name("found")),
+                  0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
