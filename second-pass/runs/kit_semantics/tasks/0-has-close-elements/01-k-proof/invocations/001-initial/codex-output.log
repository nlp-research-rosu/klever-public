+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k>
+      #while(
+        Compare(Name("j"),
+          CmpOp("<", Call(Name("len"), Name("numbers")))),
+        If(
+          Compare(
+            Call(Name("abs"),
+              BinOp("-",
+                Subscript(Name("numbers"), Name("i")),
+                Subscript(Name("numbers"), Name("j")))),
+            CmpOp("<", Name("threshold"))),
+          Assign(Name("found"), Bool(true)),
+          .Stmts)
+        Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "numbers"  |-> list(floats(FS:FloatSeq))
+        "threshold"|-> T:Float
+        "found"    |-> (B:Bool => rowAcc(B, FS, T, I, J, N))
+        "i"        |-> I:Int
+        "j"        |-> (J:Int => N:Int)
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    requires N ==Int fLen(FS)
+     andBool 0 <=Int I
+     andBool I <Int N
+     andBool I +Int 1 <=Int J
+     andBool J <=Int N
+
+  claim [outer-loop]:
+    <k>
+      #while(
+        Compare(Name("i"),
+          CmpOp("<", Call(Name("len"), Name("numbers")))),
+        Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
