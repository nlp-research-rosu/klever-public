+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloats(VS)
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..27ea0805c315808b21fb234eda4f728aebf0df53
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,32 @@
+from itertools import combinations, product
+
+from solution import has_close_elements
+
+
+def oracle(numbers, threshold):
+    return any(abs(left - right) < threshold
+               for left, right in combinations(numbers, 2))
+
+
+def main():
+    values = [-2.0, -0.5, 0.0, 0.5, 2.0]
+    thresholds = [-1.0, 0.0, 0.25, 0.5, 1.0, 3.0]
+    checked = 0
+    mismatches = 0
+    for size in range(5):
+        for numbers in product(values, repeat=size):
+            for threshold in thresholds:
+                expected = oracle(numbers, threshold)
+                actual = has_close_elements(list(numbers), threshold)
+                checked += 1
+                if actual != expected:
+                    mismatches += 1
+                    print("MISMATCH", numbers, threshold, expected, actual)
+    print("checked:", checked)
+    print("mismatches:", mismatches)
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5947d58f7f01ca5518e5d1277a29a41a9b2741bb
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly when every member of the native ValSeq is a Float.
+  syntax Bool ::= allFloats(ValSeq) [function, total]
+  rule allFloats(.ValSeq)           => true
+  rule allFloats(vCons(V:Val, R))   => isFloat(V) andBool allFloats(R)
+
+  // The exact opaque float atom evaluated by the Python program.
+  syntax Bool ::= pairNear(Float, Float, Float) [function, total]
+  rule pairNear(A, B, T) => floatLt(absF(subF(A, B)), T)
+
+  syntax Float ::= asFloat(Val) [function, total]
+  rule asFloat(F:Float) => F
+  rule asFloat(V:Val)   => 0.0
+    requires notBool isFloat(V)
+
+  // Final accumulator after scanning REM with positions J, J+1, ...
+  syntax Bool ::= rowAcc(Bool, Float, Float, Int, Int, ValSeq)
+                  [function, total]
+  rule rowAcc(B, _, _, _, _, .ValSeq) => B
+  rule rowAcc(B, A, T, I, J, vCons(V:Val, R))
+    => rowAcc(
+         #if I <Int J
+         #then B orBool pairNear(A, asFloat(V), T)
+         #else B
+         #fi,
+         A, T, I, J +Int 1, R)
+
+  // Final accumulator after scanning outer REM with positions I, I+1, ...
+  syntax Bool ::= outerAcc(Bool, ValSeq, Float, Int, ValSeq)
+                  [function, total]
+  rule outerAcc(B, _, _, _, .ValSeq) => B
+  rule outerAcc(B, VS, T, I, vCons(A:Val, R))
+    => outerAcc(rowAcc(B, asFloat(A), T, I, 0, VS),
+                VS, T, I +Int 1, R)
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.inner-loop' in /workspace
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..99bff006ba989176278988c61e3f368342343293
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,26 @@
+from typing import List
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    found = False
+    i = 0
+    j = 0
+    number1 = 0.0
+    number2 = 0.0
+    for number1 in numbers:
+        j = 0
+        for number2 in numbers:
+            if i < j:
+                if abs(number1 - number2) < threshold:
+                    found = True
+            j = j + 1
+        i = i + 1
+    return found
+
+
+assert has_close_elements([], 0.5) == False
+assert has_close_elements([1.0], 1.0) == False
+assert has_close_elements([1.0, 2.0, 3.0], 0.5) == False
+assert has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3) == True
+assert has_close_elements([1.0, 1.0], 0.0) == False
+assert has_close_elements([1.0, 1.0], 0.1) == True
