diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..657c03bb045f6e38c8b2c3ad685b0f9ca793e335
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,48 @@
+requires "spec.k"
+
+module SPEC-BODY-MUTATION
+  imports SPEC
+
+  // Material mutation: the close-pair branch writes false instead of true.
+  // The original summary must no longer be provable.
+  claim [changed-body]:
+    <k>
+      #loop(
+        list(vCons(A:Float, vCons(B:Float, .ValSeq))),
+        Name("number1"),
+        Assign(Name("j"), Int(0))
+        For(Name("number2"), Name("numbers"),
+          If(Compare(Name("i"), CmpOp("<", Name("j"))),
+            If(
+              Compare(
+                Call(Name("abs"),
+                  BinOp("-", Name("number1"), Name("number2"))),
+                CmpOp("<", Name("threshold"))),
+              Assign(Name("found"), Bool(false)),
+              .Stmts),
+            .Stmts)
+          Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("has_close_elements" |-> _CLOSURE:Val, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "numbers"  |-> list(vCons(A, vCons(B, .ValSeq)))
+        "threshold"|-> T:Float
+        "found"    |-> (false =>
+                         outerAcc(false,
+                           vCons(A, vCons(B, .ValSeq)),
+                           T, 0,
+                           vCons(A, vCons(B, .ValSeq))))
+        "i"        |-> (0 => 2)
+        "j"        |-> (0 => ?JFinal:Int)
+        "number1"  |-> (0.0 => ?N1Final:Val)
+        "number2"  |-> (0.0 => ?N2Final:Val),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires pairNear(A, B, T)
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..0291ee99b4e114593a1b1141281e039168e2ec0a
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,44 @@
+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Deliberately false: for the realizable two-element witness constrained
+  // by pairNear(A,B,T), the loop must finish with found == true, not false.
+  claim [false-result]:
+    <k>
+      #loop(
+        list(vCons(A:Float, vCons(B:Float, .ValSeq))),
+        Name("number1"),
+        Assign(Name("j"), Int(0))
+        For(Name("number2"), Name("numbers"),
+          If(Compare(Name("i"), CmpOp("<", Name("j"))),
+            If(
+              Compare(
+                Call(Name("abs"),
+                  BinOp("-", Name("number1"), Name("number2"))),
+                CmpOp("<", Name("threshold"))),
+              Assign(Name("found"), Bool(true)),
+              .Stmts),
+            .Stmts)
+          Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("has_close_elements" |-> _CLOSURE:Val, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "numbers"  |-> list(vCons(A, vCons(B, .ValSeq)))
+        "threshold"|-> T:Float
+        "found"    |-> (false => false)
+        "i"        |-> (0 => 2)
+        "j"        |-> (0 => ?JFinal:Int)
+        "number1"  |-> (0.0 => ?N1Final:Val)
+        "number2"  |-> (0.0 => ?N2Final:Val),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires pairNear(A, B, T)
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..757f468dab1a5b036e914abdb0d48919e4b15c9a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,154 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k>
+      #loop(list(REM:ValSeq), Name("number2"),
+        If(Compare(Name("i"), CmpOp("<", Name("j"))),
+          If(
+            Compare(
+              Call(Name("abs"),
+                BinOp("-", Name("number1"), Name("number2"))),
+              CmpOp("<", Name("threshold"))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          .Stmts)
+        Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("has_close_elements" |-> _CLOSURE:Val, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "numbers"  |-> list(VS:ValSeq)
+        "threshold"|-> T:Float
+        "found"    |-> (B:Bool =>
+                         rowAcc(B, asFloat(A), T, I, J, REM))
+        "i"        |-> I:Int
+        "j"        |-> (J:Int => ?JFinal:Int)
+        "number1"  |-> A:Val
+        "number2"  |-> (_OLD:Val => ?LAST:Val),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires allFloats(VS)
+     andBool allFloats(REM)
+     andBool isFloat(A)
+     andBool 0 <=Int I
+     andBool 0 <=Int J
+
+  claim [outer-loop]:
+    <k>
+      #loop(list(REM:ValSeq), Name("number1"),
+        Assign(Name("j"), Int(0))
+        For(Name("number2"), Name("numbers"),
+          If(Compare(Name("i"), CmpOp("<", Name("j"))),
+            If(
+              Compare(
+                Call(Name("abs"),
+                  BinOp("-", Name("number1"), Name("number2"))),
+                CmpOp("<", Name("threshold"))),
+              Assign(Name("found"), Bool(true)),
+              .Stmts),
+            .Stmts)
+          Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("has_close_elements" |-> _CLOSURE:Val, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "numbers"  |-> list(VS:ValSeq)
+        "threshold"|-> T:Float
+        "found"    |-> (B:Bool => outerAcc(B, VS, T, I, REM))
+        "i"        |-> (I:Int => I +Int vsLen(REM))
+        "j"        |-> (_J:Int => ?JFinal:Int)
+        "number1"  |-> (_N1:Val => ?N1Final:Val)
+        "number2"  |-> (_N2:Val => ?N2Final:Val),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires allFloats(VS)
+     andBool allFloats(REM)
+     andBool 0 <=Int I
+
+  claim [has-close-elements]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef("has_close_elements", Params("numbers", "threshold"),
+            Assign(Name("found"), Bool(false))
+            Assign(Name("i"), Int(0))
+            Assign(Name("j"), Int(0))
+            Assign(Name("number1"), Float(0.0))
+            Assign(Name("number2"), Float(0.0))
+            For(Name("number1"), Name("numbers"),
+              Assign(Name("j"), Int(0))
+              For(Name("number2"), Name("numbers"),
+                If(Compare(Name("i"), CmpOp("<", Name("j"))),
+                  If(
+                    Compare(
+                      Call(Name("abs"),
+                        BinOp("-", Name("number1"), Name("number2"))),
+                      CmpOp("<", Name("threshold"))),
+                    Assign(Name("found"), Bool(true)),
+                    .Stmts),
+                  .Stmts)
+                Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+            Return(Name("found")))))
+      ~> Call(Name("has_close_elements"), list(VS:ValSeq), T:Float)
+      => outerAcc(false, VS, T, 0, VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "has_close_elements" |->
+                closureVal(
+                  ("numbers", "threshold"),
+                  Assign(Name("found"), Bool(false))
+                  Assign(Name("i"), Int(0))
+                  Assign(Name("j"), Int(0))
+                  Assign(Name("number1"), Float(0.0))
+                  Assign(Name("number2"), Float(0.0))
+                  For(Name("number1"), Name("numbers"),
+                    Assign(Name("j"), Int(0))
+                    For(Name("number2"), Name("numbers"),
+                      If(Compare(Name("i"), CmpOp("<", Name("j"))),
+                        If(
+                          Compare(
+                            Call(Name("abs"),
+                              BinOp("-",
+                                Name("number1"), Name("number2"))),
+                            CmpOp("<", Name("threshold"))),
+                          Assign(Name("found"), Bool(true)),
+                          .Stmts),
+                        .Stmts)
+                      Assign(Name("j"),
+                        BinOp("+", Name("j"), Int(1))))
+                    Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+                  Return(Name("found")),
+                  0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloats(VS)
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..27ea0805c315808b21fb234eda4f728aebf0df53
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,32 @@
+from itertools import combinations, product
+
+from solution import has_close_elements
+
+
+def oracle(numbers, threshold):
+    return any(abs(left - right) < threshold
+               for left, right in combinations(numbers, 2))
+
+
+def main():
+    values = [-2.0, -0.5, 0.0, 0.5, 2.0]
+    thresholds = [-1.0, 0.0, 0.25, 0.5, 1.0, 3.0]
+    checked = 0
+    mismatches = 0
+    for size in range(5):
+        for numbers in product(values, repeat=size):
+            for threshold in thresholds:
+                expected = oracle(numbers, threshold)
+                actual = has_close_elements(list(numbers), threshold)
+                checked += 1
+                if actual != expected:
+                    mismatches += 1
+                    print("MISMATCH", numbers, threshold, expected, actual)
+    print("checked:", checked)
+    print("mismatches:", mismatches)
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c926344168d37f029dd5af7c675cdae971d21f28
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,44 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly when every member of the native ValSeq is a Float.
+  syntax Bool ::= allFloats(ValSeq) [function, total]
+  rule allFloats(.ValSeq)           => true
+  rule allFloats(vCons(V:Val, R))   => isFloat(V) andBool allFloats(R)
+
+  // The exact opaque float atom evaluated by the Python program.
+  syntax Bool ::= pairNear(Float, Float, Float) [function, total]
+  rule pairNear(A, B, T) => floatLt(absF(subF(A, B)), T)
+
+  syntax Float ::= asFloat(Val) [function, total]
+  rule asFloat(F:Float) => F
+  rule asFloat(V:Val)   => 0.0
+    requires notBool isFloat(V)
+
+  // Derived sort-elimination lemma for the fixed Float subtraction dispatch.
+  rule applyBin("-", A:Val, B:Val) => subF(asFloat(A), asFloat(B))
+    requires isFloat(A) andBool isFloat(B)
+    [simplification]
+
+  // Final accumulator after scanning REM with positions J, J+1, ...
+  syntax Bool ::= rowAcc(Bool, Float, Float, Int, Int, ValSeq)
+                  [function, total]
+  rule rowAcc(B, _, _, _, _, .ValSeq) => B
+  rule rowAcc(B, A, T, I, J, vCons(V:Val, R))
+    => rowAcc(
+         #if I <Int J
+         #then B orBool pairNear(A, asFloat(V), T)
+         #else B
+         #fi,
+         A, T, I, J +Int 1, R)
+
+  // Final accumulator after scanning outer REM with positions I, I+1, ...
+  syntax Bool ::= outerAcc(Bool, ValSeq, Float, Int, ValSeq)
+                  [function, total]
+  rule outerAcc(B, _, _, _, .ValSeq) => B
+  rule outerAcc(B, VS, T, I, vCons(A:Val, R))
+    => outerAcc(rowAcc(B, asFloat(A), T, I, 0, VS),
+                VS, T, I +Int 1, R)
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh && ./prove.sh' in /workspace
