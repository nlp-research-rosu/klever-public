+from typing import List
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    found = False
+    i = 0
+    while i < len(numbers):
+        j = i + 1
+        while j < len(numbers):
+            if abs(numbers[i] - numbers[j]) < threshold:
+                found = True
+            j = j + 1
+        i = i + 1
+    return found
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..67c2d07a0deaedece6cd1716a2ca2ac322267e37
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,159 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k>
+      #while(
+        Compare(Name("j"),
+          CmpOp("<", Call(Name("len"), Name("numbers")))),
+        If(
+          Compare(
+            Call(Name("abs"),
+              BinOp("-",
+                Subscript(Name("numbers"), Name("i")),
+                Subscript(Name("numbers"), Name("j")))),
+            CmpOp("<", Name("threshold"))),
+          Assign(Name("found"), Bool(true)),
+          .Stmts)
+        Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("has_close_elements" |-> CLOSURE:Val, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "numbers"  |-> list(VS:ValSeq)
+        "threshold"|-> T:Float
+        "found"    |-> (B:Bool => rowAcc(B, VS, T, I, J, N))
+        "i"        |-> I:Int
+        "j"        |-> (J:Int => N:Int),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires allFloats(VS)
+     andBool N ==Int vsLen(VS)
+     andBool 0 <=Int I
+     andBool I <Int N
+     andBool I +Int 1 <=Int J
+     andBool J <=Int N
+
+  claim [outer-loop]:
+    <k>
+      #while(
+        Compare(Name("i"),
+          CmpOp("<", Call(Name("len"), Name("numbers")))),
+        Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+        While(
+          Compare(Name("j"),
+            CmpOp("<", Call(Name("len"), Name("numbers")))),
+          If(
+            Compare(
+              Call(Name("abs"),
+                BinOp("-",
+                  Subscript(Name("numbers"), Name("i")),
+                  Subscript(Name("numbers"), Name("j")))),
+              CmpOp("<", Name("threshold"))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts)
+          Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("has_close_elements" |-> CLOSURE:Val, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "numbers"  |-> list(VS:ValSeq)
+        "threshold"|-> T:Float
+        "found"    |-> (B:Bool => outerAcc(B, VS, T, I, N))
+        "i"        |-> (I:Int => N:Int)
+        "j"        |-> (_J:Int => ?JFinal:Int),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires allFloats(VS)
+     andBool N ==Int vsLen(VS)
+     andBool 0 <=Int I
+     andBool I <=Int N
+
+  claim [has-close-elements]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef("has_close_elements", Params("numbers", "threshold"),
+            Assign(Name("found"), Bool(false))
+            Assign(Name("i"), Int(0))
+            While(
+              Compare(Name("i"),
+                CmpOp("<", Call(Name("len"), Name("numbers")))),
+              Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+              While(
+                Compare(Name("j"),
+                  CmpOp("<", Call(Name("len"), Name("numbers")))),
+                If(
+                  Compare(
+                    Call(Name("abs"),
+                      BinOp("-",
+                        Subscript(Name("numbers"), Name("i")),
+                        Subscript(Name("numbers"), Name("j")))),
+                    CmpOp("<", Name("threshold"))),
+                  Assign(Name("found"), Bool(true)),
+                  .Stmts)
+                Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+            Return(Name("found")))))
+      ~> Call(Name("has_close_elements"),
+              list(VS:ValSeq), T:Float)
+      => outerAcc(false, VS, T, 0, vsLen(VS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "has_close_elements" |->
+                closureVal(
+                  ("numbers", "threshold"),
+                  Assign(Name("found"), Bool(false))
+                  Assign(Name("i"), Int(0))
+                  While(
+                    Compare(Name("i"),
+                      CmpOp("<", Call(Name("len"), Name("numbers")))),
+                    Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+                    While(
+                      Compare(Name("j"),
+                        CmpOp("<", Call(Name("len"), Name("numbers")))),
+                      If(
+                        Compare(
+                          Call(Name("abs"),
+                            BinOp("-",
+                              Subscript(Name("numbers"), Name("i")),
+                              Subscript(Name("numbers"), Name("j")))),
+                          CmpOp("<", Name("threshold"))),
+                        Assign(Name("found"), Bool(true)),
+                        .Stmts)
+                      Assign(Name("j"),
+                        BinOp("+", Name("j"), Int(1))))
+                    Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+                  Return(Name("found")),
+                  0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloats(VS)
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..27ea0805c315808b21fb234eda4f728aebf0df53
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,32 @@
+from itertools import combinations, product
+
+from solution import has_close_elements
+
+
+def oracle(numbers, threshold):
+    return any(abs(left - right) < threshold
+               for left, right in combinations(numbers, 2))
+
+
+def main():
+    values = [-2.0, -0.5, 0.0, 0.5, 2.0]
+    thresholds = [-1.0, 0.0, 0.25, 0.5, 1.0, 3.0]
+    checked = 0
+    mismatches = 0
+    for size in range(5):
+        for numbers in product(values, repeat=size):
+            for threshold in thresholds:
+                expected = oracle(numbers, threshold)
+                actual = has_close_elements(list(numbers), threshold)
+                checked += 1
+                if actual != expected:
+                    mismatches += 1
+                    print("MISMATCH", numbers, threshold, expected, actual)
+    print("checked:", checked)
+    print("mismatches:", mismatches)
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a9747b2f541709fadb2d88b5afef299384dc3f48
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,60 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports FLOAT-SYNTAX
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // True exactly when every member of the native ValSeq is a Float.
+  syntax Bool ::= allFloats(ValSeq) [function, total]
+  rule allFloats(.ValSeq)           => true
+  rule allFloats(vCons(_:Float, R)) => allFloats(R)
+  rule allFloats(vCons(V:Val, _))   => false
+    requires notBool isFloat(V)
+
+  // Totalized indexing.  The proof only uses the in-bounds branch.
+  syntax Float ::= floatAt(ValSeq, Int) [function, total]
+  rule floatAt(vCons(F:Float, _), 0) => F
+  rule floatAt(vCons(_:Float, R), I) => floatAt(R, I -Int 1)
+    requires I >Int 0
+  rule floatAt(.ValSeq, _)           => 0.0
+  rule floatAt(vCons(_:Float, _), I) => 0.0
+    requires I <Int 0
+  rule floatAt(vCons(V:Val, _), _)   => 0.0
+    requires notBool isFloat(V)
+
+  // Derived equation: valid indexing into an all-float sequence has Float sort.
+  rule valSeqAt(VS, I)              => floatAt(VS, I)
+    requires allFloats(VS)
+     andBool 0 <=Int I
+     andBool I <Int vsLen(VS)
+    [simplification]
+
+  // The exact Boolean atom evaluated by the Python loop for pair (I,J).
+  syntax Bool ::= pairNear(ValSeq, Float, Int, Int) [function, total]
+  rule pairNear(VS, T, I, J)
+    => floatLt(absF(subF(floatAt(VS, I), floatAt(VS, J))), T)
+
+  // rowAcc is the final accumulator after testing J .. N-1 against I.
+  syntax Bool ::= rowAcc(Bool, ValSeq, Float, Int, Int, Int)
+                  [function, total, no-evaluators]
+  rule rowAcc(B, _, _, _, J, N) => B
+    requires J >=Int N
+  rule rowAcc(B, VS, T, I, J, N)
+    => rowAcc(B orBool pairNear(VS, T, I, J), VS, T, I, J +Int 1, N)
+    requires J <Int N
+
+  // outerAcc is the final accumulator after rows I .. N-1.
+  syntax Bool ::= outerAcc(Bool, ValSeq, Float, Int, Int)
+                  [function, total, no-evaluators]
+  rule outerAcc(B, _, _, I, N) => B
+    requires I >=Int N
+  rule outerAcc(B, VS, T, I, N)
+    => outerAcc(rowAcc(B, VS, T, I, I +Int 1, N),
+                VS, T, I +Int 1, N)
+    requires I <Int N
+endmodule

exec
/bin/bash -lc 'kprove connection-spec.k --definition connection-kompiled --spec-module CONNECTION-SPEC' in /workspace
