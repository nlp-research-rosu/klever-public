diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..27ea0805c315808b21fb234eda4f728aebf0df53
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,32 @@
+from itertools import combinations, product
+
+from solution import has_close_elements
+
+
+def oracle(numbers, threshold):
+    return any(abs(left - right) < threshold
+               for left, right in combinations(numbers, 2))
+
+
+def main():
+    values = [-2.0, -0.5, 0.0, 0.5, 2.0]
+    thresholds = [-1.0, 0.0, 0.25, 0.5, 1.0, 3.0]
+    checked = 0
+    mismatches = 0
+    for size in range(5):
+        for numbers in product(values, repeat=size):
+            for threshold in thresholds:
+                expected = oracle(numbers, threshold)
+                actual = has_close_elements(list(numbers), threshold)
+                checked += 1
+                if actual != expected:
+                    mismatches += 1
+                    print("MISMATCH", numbers, threshold, expected, actual)
+    print("checked:", checked)
+    print("mismatches:", mismatches)
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2b0b8c848ee85e09f3bc15f56a7678ec4fc6eb05
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,41 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly when every member of the native ValSeq is a Float.
+  syntax Bool ::= allFloats(ValSeq) [function, total]
+  rule allFloats(.ValSeq)           => true
+  rule allFloats(vCons(V:Val, R))   => isFloat(V) andBool allFloats(R)
+
+  // The exact opaque float atom evaluated by the Python program.
+  syntax Bool ::= pairNear(Float, Float, Float) [function, total]
+  rule pairNear(A, B, T) => floatLt(absF(subF(A, B)), T)
+
+  // Final accumulator after scanning REM with positions J, J+1, ...
+  syntax Bool ::= rowAcc(Bool, Float, Float, Int, Int, ValSeq)
+                  [function, total]
+  rule rowAcc(B, _, _, _, _, .ValSeq) => B
+  rule rowAcc(B, A, T, I, J, vCons(V:Val, R))
+    => rowAcc(B orBool pairNear(A, {V}:>Float, T),
+              A, T, I, J +Int 1, R)
+    requires I <Int J andBool isFloat(V)
+  rule rowAcc(B, A, T, I, J, vCons(_:Val, R))
+    => rowAcc(B, A, T, I, J +Int 1, R)
+    requires notBool I <Int J
+  rule rowAcc(B, A, T, I, J, vCons(V:Val, R))
+    => rowAcc(B, A, T, I, J +Int 1, R)
+    requires I <Int J andBool notBool isFloat(V)
+
+  // Final accumulator after scanning outer REM with positions I, I+1, ...
+  syntax Bool ::= outerAcc(Bool, ValSeq, Float, Int, ValSeq)
+                  [function, total]
+  rule outerAcc(B, _, _, _, .ValSeq) => B
+  rule outerAcc(B, VS, T, I, vCons(A:Val, R))
+    => outerAcc(rowAcc(B, {A}:>Float, T, I, 0, VS),
+                VS, T, I +Int 1, R)
+    requires isFloat(A)
+  rule outerAcc(B, VS, T, I, vCons(A:Val, R))
+    => outerAcc(B, VS, T, I +Int 1, R)
+    requires notBool isFloat(A)
+endmodule

