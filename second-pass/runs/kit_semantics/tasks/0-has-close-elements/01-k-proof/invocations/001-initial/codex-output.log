+                        Assign(Name("found"), Bool(true)),
+                        .Stmts)
+                      Assign(Name("j"),
+                        BinOp("+", Name("j"), Int(1))))
+                    Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+                  Return(Name("found")),
+                  0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
