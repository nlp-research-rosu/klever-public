+    found = False
+    i = 0
+    while i < len(numbers):
+        j = i + 1
+        while j < len(numbers):
+            if abs(numbers[i] - numbers[j]) < threshold:
+                found = True
+            j = j + 1
+        i = i + 1
+    return found
