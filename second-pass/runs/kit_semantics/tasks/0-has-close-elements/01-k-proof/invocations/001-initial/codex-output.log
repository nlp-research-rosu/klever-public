+                  .Stmts)
+                Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+            Return(Name("found")))))
+      ~> Call(Name("has_close_elements"), list(VS:ValSeq), T:Float)
+      => outerAcc(false, VS, T, 0, VS)
