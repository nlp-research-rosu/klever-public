+        "j"        |-> (J:Int => N:Int),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires allFloats(VS)
+     andBool N ==Int vsLen(VS)
+     andBool 0 <=Int I
+     andBool I <Int N
+     andBool I +Int 1 <=Int J
+     andBool J <=Int N
