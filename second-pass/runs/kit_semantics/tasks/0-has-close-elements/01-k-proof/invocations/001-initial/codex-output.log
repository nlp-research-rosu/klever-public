+def main():
+    values = [-2.0, -0.5, 0.0, 0.5, 2.0]
+    thresholds = [-1.0, 0.0, 0.25, 0.5, 1.0, 3.0]
+    checked = 0
+    mismatches = 0
+    for size in range(5):
+        for numbers in product(values, repeat=size):
+            for threshold in thresholds:
+                expected = oracle(numbers, threshold)
+                actual = has_close_elements(list(numbers), threshold)
+                checked += 1
+                if actual != expected:
+                    mismatches += 1
+                    print("MISMATCH", numbers, threshold, expected, actual)
+    print("checked:", checked)
+    print("mismatches:", mismatches)
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c926344168d37f029dd5af7c675cdae971d21f28
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,44 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly when every member of the native ValSeq is a Float.
+  syntax Bool ::= allFloats(ValSeq) [function, total]
+  rule allFloats(.ValSeq)           => true
+  rule allFloats(vCons(V:Val, R))   => isFloat(V) andBool allFloats(R)
+
+  // The exact opaque float atom evaluated by the Python program.
+  syntax Bool ::= pairNear(Float, Float, Float) [function, total]
+  rule pairNear(A, B, T) => floatLt(absF(subF(A, B)), T)
+
+  syntax Float ::= asFloat(Val) [function, total]
+  rule asFloat(F:Float) => F
+  rule asFloat(V:Val)   => 0.0
+    requires notBool isFloat(V)
+
+  // Derived sort-elimination lemma for the fixed Float subtraction dispatch.
+  rule applyBin("-", A:Val, B:Val) => subF(asFloat(A), asFloat(B))
+    requires isFloat(A) andBool isFloat(B)
+    [simplification]
+
+  // Final accumulator after scanning REM with positions J, J+1, ...
+  syntax Bool ::= rowAcc(Bool, Float, Float, Int, Int, ValSeq)
+                  [function, total]
+  rule rowAcc(B, _, _, _, _, .ValSeq) => B
+  rule rowAcc(B, A, T, I, J, vCons(V:Val, R))
+    => rowAcc(
+         #if I <Int J
+         #then B orBool pairNear(A, asFloat(V), T)
+         #else B
+         #fi,
+         A, T, I, J +Int 1, R)
+
+  // Final accumulator after scanning outer REM with positions I, I+1, ...
+  syntax Bool ::= outerAcc(Bool, ValSeq, Float, Int, ValSeq)
+                  [function, total]
+  rule outerAcc(B, _, _, _, .ValSeq) => B
+  rule outerAcc(B, VS, T, I, vCons(A:Val, R))
+    => outerAcc(rowAcc(B, asFloat(A), T, I, 0, VS),
+                VS, T, I +Int 1, R)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC' in /workspace
diff --git a/check_artifacts.py b/check_artifacts.py
new file mode 100644
index 0000000000000000000000000000000000000000..655575859c324ecea3a75ceba20d8dc3c47867da
--- /dev/null
+++ b/check_artifacts.py
@@ -0,0 +1,41 @@
+import ast
+import subprocess
+
+
+def normalized(text):
+    return "".join(text.split())
+
+
+def target_function(path):
+    tree = ast.parse(open(path, encoding="utf-8").read(), filename=path)
+    functions = [node for node in tree.body
+                 if isinstance(node, ast.FunctionDef)
+                 and node.name == "has_close_elements"]
+    assert len(functions) == 1
+    return functions[0]
+
+
+def main():
+    generated = subprocess.check_output(
+        ["python3", "py2mpy.py", "solution.py"], text=True)
+    recorded = open("solution.mpy", encoding="utf-8").read()
+    spec = open("spec.k", encoding="utf-8").read()
+
+    assert generated == recorded, "solution.mpy is stale"
+    assert normalized(generated).rstrip() in normalized(spec), (
+        "spec.k does not contain the exact translated program module")
+
+    prompt_function = target_function("prompt.py")
+    solution_function = target_function("solution.py")
+    smoke_function = target_function("smoke.py")
+
+    assert [arg.arg for arg in prompt_function.args.args] == [
+        arg.arg for arg in solution_function.args.args
+    ], "entry-point parameters changed"
+    assert ast.dump(solution_function) == ast.dump(smoke_function), (
+        "smoke.py implementation drifted from solution.py")
+    print("artifact identity checks: passed")
+
+
+if __name__ == "__main__":
+    main()
