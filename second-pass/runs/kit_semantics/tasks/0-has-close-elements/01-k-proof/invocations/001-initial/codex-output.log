@@ -0,0 +1,18 @@
+from typing import List
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    found = False
+    i = 0
+    j = 0
+    number1 = 0.0
+    number2 = 0.0
+    for number1 in numbers:
+        j = 0
+        for number2 in numbers:
+            if i < j:
+                if abs(number1 - number2) < threshold:
+                    found = True
+            j = j + 1
+        i = i + 1
+    return found
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..657c03bb045f6e38c8b2c3ad685b0f9ca793e335
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,48 @@
+requires "spec.k"
+
+module SPEC-BODY-MUTATION
+  imports SPEC
+
+  // Material mutation: the close-pair branch writes false instead of true.
+  // The original summary must no longer be provable.
+  claim [changed-body]:
+    <k>
+      #loop(
+        list(vCons(A:Float, vCons(B:Float, .ValSeq))),
+        Name("number1"),
+        Assign(Name("j"), Int(0))
+        For(Name("number2"), Name("numbers"),
+          If(Compare(Name("i"), CmpOp("<", Name("j"))),
+            If(
+              Compare(
+                Call(Name("abs"),
+                  BinOp("-", Name("number1"), Name("number2"))),
+                CmpOp("<", Name("threshold"))),
+              Assign(Name("found"), Bool(false)),
+              .Stmts),
+            .Stmts)
+          Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("has_close_elements" |-> _CLOSURE:Val, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "numbers"  |-> list(vCons(A, vCons(B, .ValSeq)))
+        "threshold"|-> T:Float
+        "found"    |-> (false =>
+                         outerAcc(false,
+                           vCons(A, vCons(B, .ValSeq)),
+                           T, 0,
+                           vCons(A, vCons(B, .ValSeq))))
+        "i"        |-> (0 => 2)
+        "j"        |-> (0 => ?JFinal:Int)
+        "number1"  |-> (0.0 => ?N1Final:Val)
+        "number2"  |-> (0.0 => ?N2Final:Val),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires pairNear(A, B, T)
+endmodule
