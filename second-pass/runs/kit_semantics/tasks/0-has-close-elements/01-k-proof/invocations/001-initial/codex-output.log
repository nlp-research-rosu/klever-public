+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "has_close_elements" |->
+                closureVal(
+                  ("numbers", "threshold"),
+                  Assign(Name("found"), Bool(false))
+                  Assign(Name("i"), Int(0))
