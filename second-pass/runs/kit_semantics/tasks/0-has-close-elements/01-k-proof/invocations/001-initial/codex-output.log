+        "threshold"|-> T:Float
+        "found"    |-> (B:Bool => outerAcc(B, VS, T, I, N))
+        "i"        |-> (I:Int => N:Int)
+        "j"        |-> (_J:Int => ?JFinal:Int),
+        parent(0))
+    </scopes>
+    <heap> .Map </heap>
+    requires allFloats(VS)
+     andBool N ==Int vsLen(VS)
+     andBool 0 <=Int I
+     andBool I <=Int N
+
+  claim [has-close-elements]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef("has_close_elements", Params("numbers", "threshold"),
+            Assign(Name("found"), Bool(false))
+            Assign(Name("i"), Int(0))
+            While(
+              Compare(Name("i"),
+                CmpOp("<", Call(Name("len"), Name("numbers")))),
+              Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+              While(
+                Compare(Name("j"),
+                  CmpOp("<", Call(Name("len"), Name("numbers")))),
+                If(
+                  Compare(
+                    Call(Name("abs"),
+                      BinOp("-",
+                        Subscript(Name("numbers"), Name("i")),
+                        Subscript(Name("numbers"), Name("j")))),
+                    CmpOp("<", Name("threshold"))),
+                  Assign(Name("found"), Bool(true)),
+                  .Stmts)
+                Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+            Return(Name("found")))))
+      ~> Call(Name("has_close_elements"),
+              list(VS:ValSeq), T:Float)
+      => outerAcc(false, VS, T, 0, vsLen(VS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "has_close_elements" |->
+                closureVal(
+                  ("numbers", "threshold"),
+                  Assign(Name("found"), Bool(false))
+                  Assign(Name("i"), Int(0))
+                  While(
+                    Compare(Name("i"),
+                      CmpOp("<", Call(Name("len"), Name("numbers")))),
+                    Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+                    While(
+                      Compare(Name("j"),
+                        CmpOp("<", Call(Name("len"), Name("numbers")))),
+                      If(
+                        Compare(
+                          Call(Name("abs"),
+                            BinOp("-",
+                              Subscript(Name("numbers"), Name("i")),
+                              Subscript(Name("numbers"), Name("j")))),
+                          CmpOp("<", Name("threshold"))),
+                        Assign(Name("found"), Bool(true)),
+                        .Stmts)
+                      Assign(Name("j"),
+                        BinOp("+", Name("j"), Int(1))))
+                    Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+                  Return(Name("found")),
+                  0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloats(VS)
