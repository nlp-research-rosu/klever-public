diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..27ea0805c315808b21fb234eda4f728aebf0df53
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,32 @@
+from itertools import combinations, product
+
+from solution import has_close_elements
+
+
+def oracle(numbers, threshold):
+    return any(abs(left - right) < threshold
+               for left, right in combinations(numbers, 2))
+
+
+def main():
+    values = [-2.0, -0.5, 0.0, 0.5, 2.0]
+    thresholds = [-1.0, 0.0, 0.25, 0.5, 1.0, 3.0]
+    checked = 0
+    mismatches = 0
+    for size in range(5):
+        for numbers in product(values, repeat=size):
+            for threshold in thresholds:
+                expected = oracle(numbers, threshold)
+                actual = has_close_elements(list(numbers), threshold)
+                checked += 1
+                if actual != expected:
+                    mismatches += 1
+                    print("MISMATCH", numbers, threshold, expected, actual)
+    print("checked:", checked)
+    print("mismatches:", mismatches)
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a9747b2f541709fadb2d88b5afef299384dc3f48
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,60 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports FLOAT-SYNTAX
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // True exactly when every member of the native ValSeq is a Float.
+  syntax Bool ::= allFloats(ValSeq) [function, total]
+  rule allFloats(.ValSeq)           => true
+  rule allFloats(vCons(_:Float, R)) => allFloats(R)
+  rule allFloats(vCons(V:Val, _))   => false
+    requires notBool isFloat(V)
+
+  // Totalized indexing.  The proof only uses the in-bounds branch.
+  syntax Float ::= floatAt(ValSeq, Int) [function, total]
+  rule floatAt(vCons(F:Float, _), 0) => F
+  rule floatAt(vCons(_:Float, R), I) => floatAt(R, I -Int 1)
+    requires I >Int 0
+  rule floatAt(.ValSeq, _)           => 0.0
+  rule floatAt(vCons(_:Float, _), I) => 0.0
+    requires I <Int 0
+  rule floatAt(vCons(V:Val, _), _)   => 0.0
+    requires notBool isFloat(V)
+
+  // Derived equation: valid indexing into an all-float sequence has Float sort.
+  rule valSeqAt(VS, I)              => floatAt(VS, I)
+    requires allFloats(VS)
+     andBool 0 <=Int I
+     andBool I <Int vsLen(VS)
+    [simplification]
+
+  // The exact Boolean atom evaluated by the Python loop for pair (I,J).
+  syntax Bool ::= pairNear(ValSeq, Float, Int, Int) [function, total]
+  rule pairNear(VS, T, I, J)
+    => floatLt(absF(subF(floatAt(VS, I), floatAt(VS, J))), T)
+
+  // rowAcc is the final accumulator after testing J .. N-1 against I.
+  syntax Bool ::= rowAcc(Bool, ValSeq, Float, Int, Int, Int)
+                  [function, total, no-evaluators]
+  rule rowAcc(B, _, _, _, J, N) => B
+    requires J >=Int N
+  rule rowAcc(B, VS, T, I, J, N)
+    => rowAcc(B orBool pairNear(VS, T, I, J), VS, T, I, J +Int 1, N)
+    requires J <Int N
+
+  // outerAcc is the final accumulator after rows I .. N-1.
+  syntax Bool ::= outerAcc(Bool, ValSeq, Float, Int, Int)
+                  [function, total, no-evaluators]
+  rule outerAcc(B, _, _, I, N) => B
+    requires I >=Int N
+  rule outerAcc(B, VS, T, I, N)
+    => outerAcc(rowAcc(B, VS, T, I, I +Int 1, N),
+                VS, T, I +Int 1, N)
+    requires I <Int N
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..f3145360cb90f5461c3f4c42ada53364e9b070fd
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,22 @@
+from typing import List
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    found = False
+    i = 0
+    while i < len(numbers):
+        j = i + 1
+        while j < len(numbers):
+            if abs(numbers[i] - numbers[j]) < threshold:
+                found = True
+            j = j + 1
+        i = i + 1
+    return found
+
+
+assert has_close_elements([], 0.5) == False
+assert has_close_elements([1.0], 1.0) == False
+assert has_close_elements([1.0, 2.0, 3.0], 0.5) == False
+assert has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3) == True
+assert has_close_elements([1.0, 1.0], 0.0) == False
+assert has_close_elements([1.0, 1.0], 0.1) == True
