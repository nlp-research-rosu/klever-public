+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Exact embedding of FloatSeq into the reference semantics' ValSeq.
+  syntax ValSeq ::= floats(FloatSeq) [function, total]
+  rule floats(.FloatSeq)            => .ValSeq
+  rule floats(fCons(F, FS))         => vCons(F, floats(FS))
+
+  syntax Int ::= fLen(FloatSeq) [function, total]
+  rule fLen(.FloatSeq)              => 0
+  rule fLen(fCons(_, FS))           => 1 +Int fLen(FS)
+
+  // Totalized indexing.  The proof only uses the in-bounds branch.
+  syntax Float ::= fAt(FloatSeq, Int) [function, total]
+  rule fAt(fCons(F, _), 0)          => F
+  rule fAt(fCons(_, FS), I)         => fAt(FS, I -Int 1)
+    requires I >Int 0
+  rule fAt(.FloatSeq, _)            => 0.0
+  rule fAt(fCons(_, _), I)          => 0.0
+    requires I <Int 0
