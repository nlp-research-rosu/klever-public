Module(
  ImportFrom("typing", "List")
  FuncDef("has_close_elements", Params("numbers", "threshold"),
    Assign(Name("found"), Bool(false))
    Assign(Name("i"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("number1"), Float(0.0))
    Assign(Name("number2"), Float(0.0))
    For(Name("number1"), Name("numbers"),
      Assign(Name("j"), Int(0))
      For(Name("number2"), Name("numbers"),
        If(Compare(Name("i"), CmpOp("<", Name("j"))),
          If(Compare(
            Call(
              Name("abs"),
              BinOp("-", Name("number1"), Name("number2"))),
            CmpOp("<", Name("threshold"))),
            Assign(Name("found"), Bool(true)),
            ),
          )
        Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("found")))
  Assert(
    Compare(
      Call(Name("has_close_elements"), ListExpr(), Float(0.5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("has_close_elements"), ListExpr(Float(1.0)), Float(1.0)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(1.0), Float(2.0), Float(3.0)),
        Float(0.5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(
          Float(1.0),
          Float(2.8),
          Float(3.0),
          Float(4.0),
          Float(5.0),
          Float(2.0)),
        Float(0.3)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(1.0), Float(1.0)),
        Float(0.0)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(1.0), Float(1.0)),
        Float(0.1)),
      CmpOp("==", Bool(true)))))
