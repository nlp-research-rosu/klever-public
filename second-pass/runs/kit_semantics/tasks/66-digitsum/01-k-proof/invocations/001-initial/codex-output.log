diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ab07a0badbdd6f514ef5a050e5b090919a8c025e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical summary of the fixed semantics' ASCII string model.
+  // The condition is exactly the one computed by one-character str.isupper().
+  syntax Int ::= digitSumIS(IntSeq) [function, total]
+
+  rule digitSumIS(.IntSeq) => 0
+  rule digitSumIS(iCons(C:Int, REST:IntSeq))
+    => (#if isUpperC(C) andBool notBool isLowerC(C)
+        #then C
+        #else 0
+        #fi)
+       +Int digitSumIS(REST)
+endmodule

Implementation, concrete execution, unbounded symbolic proof, negative validation probes, and Gate A/B/C audit all completed successfully.
  ✓ Read Kit contracts, prompt, translator, and reference semantics
  ✓ Implement and translate solution; compile/run concrete tests
  ✓ Write verification support and full-domain K specification
  ✓ Run kprove and iterate until target proof closes or hard blocker is established
  ✓ Audit Gates A/B/C and write exact scripts and reports
