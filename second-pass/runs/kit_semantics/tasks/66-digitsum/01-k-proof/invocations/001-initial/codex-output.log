diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ab07a0badbdd6f514ef5a050e5b090919a8c025e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical summary of the fixed semantics' ASCII string model.
+  // The condition is exactly the one computed by one-character str.isupper().
+  syntax Int ::= digitSumIS(IntSeq) [function, total]
+
+  rule digitSumIS(.IntSeq) => 0
+  rule digitSumIS(iCons(C:Int, REST:IntSeq))
+    => (#if isUpperC(C) andBool notBool isLowerC(C)
+        #then C
+        #else 0
+        #fi)
+       +Int digitSumIS(REST)
+endmodule

exec
/bin/bash -lc 'kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY' in /workspace
