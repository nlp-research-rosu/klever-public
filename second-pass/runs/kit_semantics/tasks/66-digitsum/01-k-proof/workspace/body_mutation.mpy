Module(
  FuncDef("digitSum", Params("s"),
    Assign(Name("total"), Int(0))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("s"),
      If(Call(Attribute(Name("char"), "isupper"), ),
        AugAssign(Name("total"), "+", Int(0)),
        ))
    Return(Name("total")))
  Assert(Compare(Call(Name("digitSum"), Str("A")), CmpOp("==", Int(0)))))
