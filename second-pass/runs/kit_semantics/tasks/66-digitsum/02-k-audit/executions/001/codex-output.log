+                Call(Name("ord"), Name("char"), .Exprs)
+              ) .Stmts,
+              .Stmts
+            ) .Stmts
+          )
+          Return(Name("total"))
+          .Stmts,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
