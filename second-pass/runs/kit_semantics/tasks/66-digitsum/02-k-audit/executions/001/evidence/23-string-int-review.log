COMMAND: bash -lc rg\ -n\ \'\^\'\ reference-semantics/semantics/str.k\ reference-semantics/semantics/methods.k\ reference-semantics/semantics/operators.k\ reference-semantics/semantics/int.k
EXIT_STATUS: 0
OUTPUT:
reference-semantics/semantics/int.k:1:// reference/src/semantics/int.k — MPY-INT
reference-semantics/semantics/int.k:2:// Int cases of the operator dispatch; Python // and % are floored (pyMod).
reference-semantics/semantics/int.k:3:
reference-semantics/semantics/int.k:4:module MPY-INT
reference-semantics/semantics/int.k:5:  imports MPY-CORE
reference-semantics/semantics/int.k:6:
reference-semantics/semantics/int.k:7:  rule applyUn("-", I:Int) => 0 -Int I
reference-semantics/semantics/int.k:8:
reference-semantics/semantics/int.k:9:  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
reference-semantics/semantics/int.k:10:  // Bool participates in int arithmetic (x += (a == b))
reference-semantics/semantics/int.k:11:  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
reference-semantics/semantics/int.k:12:  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
reference-semantics/semantics/int.k:13:  // bool is a subtype of int: any Bool operand promotes to 0/1 and re-dispatches
reference-semantics/semantics/int.k:14:  // to the Int cases (the "+" mixed cases above are kept, so "+" is excluded here
reference-semantics/semantics/int.k:15:  // to avoid a duplicate rule — Bool + Bool still promotes via the Bool x Bool rule).
reference-semantics/semantics/int.k:16:  rule applyBin(OP:String, B1:Bool, B2:Bool) => applyBin(OP, boolAsInt(B1), boolAsInt(B2))
reference-semantics/semantics/int.k:17:       requires isArithOp(OP)
reference-semantics/semantics/int.k:18:  rule applyBin(OP:String, B:Bool, I:Int)    => applyBin(OP, boolAsInt(B), I)
reference-semantics/semantics/int.k:19:       requires isArithOp(OP) andBool OP =/=String "+"
reference-semantics/semantics/int.k:20:  rule applyBin(OP:String, I:Int, B:Bool)    => applyBin(OP, I, boolAsInt(B))
reference-semantics/semantics/int.k:21:       requires isArithOp(OP) andBool OP =/=String "+"
reference-semantics/semantics/int.k:22:  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
reference-semantics/semantics/int.k:23:  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
reference-semantics/semantics/int.k:24:  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
reference-semantics/semantics/int.k:25:  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
reference-semantics/semantics/int.k:26:  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
reference-semantics/semantics/int.k:27:
reference-semantics/semantics/int.k:28:  syntax Int ::= pyMod(Int, Int) [function]
reference-semantics/semantics/int.k:29:  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
reference-semantics/semantics/int.k:30:
reference-semantics/semantics/int.k:31:  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
reference-semantics/semantics/int.k:32:  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
reference-semantics/semantics/int.k:33:  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
reference-semantics/semantics/int.k:34:  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
reference-semantics/semantics/int.k:35:  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
reference-semantics/semantics/int.k:36:  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
reference-semantics/semantics/int.k:37:endmodule
reference-semantics/semantics/operators.k:1:// reference/src/semantics/operators.k — MPY-OPERATORS
reference-semantics/semantics/operators.k:2:// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
reference-semantics/semantics/operators.k:3:// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
reference-semantics/semantics/operators.k:4:// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
reference-semantics/semantics/operators.k:5:
reference-semantics/semantics/operators.k:6:module MPY-OPERATORS
reference-semantics/semantics/operators.k:7:  imports MPY-CORE
reference-semantics/semantics/operators.k:8:  imports MPY-ITER
reference-semantics/semantics/operators.k:9:
reference-semantics/semantics/operators.k:10:  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
reference-semantics/semantics/operators.k:11:
reference-semantics/semantics/operators.k:12:  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
reference-semantics/semantics/operators.k:13:
reference-semantics/semantics/operators.k:14:  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
reference-semantics/semantics/operators.k:15:  context Compare(HOLE, _)
reference-semantics/semantics/operators.k:16:  context Compare(_:Val, CmpOp(_, HOLE))
reference-semantics/semantics/operators.k:17:  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
reference-semantics/semantics/operators.k:18:
reference-semantics/semantics/operators.k:19:  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
reference-semantics/semantics/operators.k:20:  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
reference-semantics/semantics/operators.k:21:
reference-semantics/semantics/operators.k:22:  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
reference-semantics/semantics/operators.k:23:  // (Python: list == is structural; identity only via `is`.) priority(40)
reference-semantics/semantics/operators.k:24:  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
reference-semantics/semantics/operators.k:25:  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
reference-semantics/semantics/operators.k:26:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/operators.k:27:       [priority(40)]
reference-semantics/semantics/operators.k:28:  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
reference-semantics/semantics/operators.k:29:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/operators.k:30:       requires notBool isRefV(L)
reference-semantics/semantics/operators.k:31:       [priority(40)]
reference-semantics/semantics/operators.k:32:
reference-semantics/semantics/operators.k:33:  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
reference-semantics/semantics/operators.k:34:  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
reference-semantics/semantics/operators.k:35:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/operators.k:36:       requires OP =/=String "in" andBool OP =/=String "not in"
reference-semantics/semantics/operators.k:37:       [priority(40)]
reference-semantics/semantics/operators.k:38:  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
reference-semantics/semantics/operators.k:39:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/operators.k:40:       requires notBool isRefV(L)
reference-semantics/semantics/operators.k:41:        orBool OP ==String "in" orBool OP ==String "not in"
reference-semantics/semantics/operators.k:42:       [priority(40)]
reference-semantics/semantics/operators.k:43:
reference-semantics/semantics/operators.k:44:  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
reference-semantics/semantics/operators.k:45:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/operators.k:46:       [priority(40)]
reference-semantics/semantics/operators.k:47:endmodule
reference-semantics/semantics/str.k:1:// reference/src/semantics/str.k — MPY-STR
reference-semantics/semantics/str.k:2:
reference-semantics/semantics/str.k:3:module MPY-STR
reference-semantics/semantics/str.k:4:  imports MPY-CORE
reference-semantics/semantics/str.k:5:  imports MPY-ITER
reference-semantics/semantics/str.k:6:
reference-semantics/semantics/str.k:7:  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
reference-semantics/semantics/str.k:8:  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
reference-semantics/semantics/str.k:9:  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
reference-semantics/semantics/str.k:10:        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
reference-semantics/semantics/str.k:11:
reference-semantics/semantics/str.k:12:  // ==== str literal (ASCII-only) ============================================
reference-semantics/semantics/str.k:13:  syntax IntSeq ::= strToCodes(String) [function]
reference-semantics/semantics/str.k:14:  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
reference-semantics/semantics/str.k:15:  rule strToCodes("") => .IntSeq
reference-semantics/semantics/str.k:16:  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
reference-semantics/semantics/str.k:17:    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
reference-semantics/semantics/str.k:18:
reference-semantics/semantics/str.k:19:  // ==== operators: + / == / != / in =========================================
reference-semantics/semantics/str.k:20:  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
reference-semantics/semantics/str.k:21:  rule seqConcat(.IntSeq, T:IntSeq)                => T
reference-semantics/semantics/str.k:22:  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
reference-semantics/semantics/str.k:23:
reference-semantics/semantics/str.k:24:  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
reference-semantics/semantics/str.k:25:  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
reference-semantics/semantics/str.k:26:  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
reference-semantics/semantics/str.k:27:
reference-semantics/semantics/str.k:28:  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
reference-semantics/semantics/str.k:29:  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
reference-semantics/semantics/str.k:30:  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
reference-semantics/semantics/str.k:31:
reference-semantics/semantics/str.k:32:  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
reference-semantics/semantics/str.k:33:  rule strPrefix(.IntSeq, _:IntSeq)               => true
reference-semantics/semantics/str.k:34:  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
reference-semantics/semantics/str.k:35:  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
reference-semantics/semantics/str.k:36:
reference-semantics/semantics/str.k:37:  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
reference-semantics/semantics/str.k:38:  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
reference-semantics/semantics/str.k:39:  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
reference-semantics/semantics/str.k:40:  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
reference-semantics/semantics/str.k:41:       requires notBool strPrefix(P, iCons(C, Xs))
reference-semantics/semantics/str.k:42:
reference-semantics/semantics/str.k:43:  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
reference-semantics/semantics/str.k:44:  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
reference-semantics/semantics/str.k:45:  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
reference-semantics/semantics/str.k:46:  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
reference-semantics/semantics/str.k:47:  // str </<=/>/>= comparisons.
reference-semantics/semantics/str.k:48:  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
reference-semantics/semantics/str.k:49:  rule strLt(.IntSeq, .IntSeq)                => false
reference-semantics/semantics/str.k:50:  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
reference-semantics/semantics/str.k:51:  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
reference-semantics/semantics/str.k:52:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
reference-semantics/semantics/str.k:53:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
reference-semantics/semantics/str.k:54:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
reference-semantics/semantics/str.k:55:
reference-semantics/semantics/str.k:56:  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
reference-semantics/semantics/str.k:57:  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
reference-semantics/semantics/str.k:58:  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
reference-semantics/semantics/str.k:59:  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
reference-semantics/semantics/str.k:60:endmodule
reference-semantics/semantics/methods.k:1:// reference/src/semantics/methods.k — MPY-METHODS
reference-semantics/semantics/methods.k:2:
reference-semantics/semantics/methods.k:3:module MPY-METHODS
reference-semantics/semantics/methods.k:4:  imports MPY-CORE
reference-semantics/semantics/methods.k:5:  imports K-EQUAL
reference-semantics/semantics/methods.k:6:  imports MPY-STR
reference-semantics/semantics/methods.k:7:  imports MPY-LIST
reference-semantics/semantics/methods.k:8:
reference-semantics/semantics/methods.k:9:  // method-call routing + arg-eval live in call.k; this module owns applyMethod.
reference-semantics/semantics/methods.k:10:  syntax Val ::= applyMethod(Val, String, Vals) [function]
reference-semantics/semantics/methods.k:11:
reference-semantics/semantics/methods.k:12:  // ==== string predicates (Python semantics) =================================
reference-semantics/semantics/methods.k:13:  rule applyMethod(str(CS:IntSeq), "isupper", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)
reference-semantics/semantics/methods.k:14:  rule applyMethod(str(CS:IntSeq), "islower", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)
reference-semantics/semantics/methods.k:15:  rule applyMethod(str(CS:IntSeq), "isalpha", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)
reference-semantics/semantics/methods.k:16:  rule applyMethod(str(CS:IntSeq), "isdigit", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)
reference-semantics/semantics/methods.k:17:
reference-semantics/semantics/methods.k:18:  // ==== case maps ============================================================
reference-semantics/semantics/methods.k:19:  rule applyMethod(str(CS:IntSeq), "lower",    .Vals) => str(mapLower(CS))
reference-semantics/semantics/methods.k:20:  rule applyMethod(str(CS:IntSeq), "upper",    .Vals) => str(mapUpper(CS))
reference-semantics/semantics/methods.k:21:  rule applyMethod(str(CS:IntSeq), "swapcase", .Vals) => str(mapSwap(CS))
reference-semantics/semantics/methods.k:22:
reference-semantics/semantics/methods.k:23:  // ==== join / count / strip / encode ========================================
reference-semantics/semantics/methods.k:24:  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by
reference-semantics/semantics/methods.k:25:  // the call layer; the result str is a value)
reference-semantics/semantics/methods.k:26:  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))
reference-semantics/semantics/methods.k:27:  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]
reference-semantics/semantics/methods.k:28:  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq
reference-semantics/semantics/methods.k:29:  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS
reference-semantics/semantics/methods.k:30:  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
reference-semantics/semantics/methods.k:31:    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))
reference-semantics/semantics/methods.k:32:
reference-semantics/semantics/methods.k:33:  // S.count(sub): non-overlapping window scan (Python str.count)
reference-semantics/semantics/methods.k:34:  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
reference-semantics/semantics/methods.k:35:  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
reference-semantics/semantics/methods.k:36:  rule cntSub(.IntSeq, _:IntSeq) => 0
reference-semantics/semantics/methods.k:37:  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
reference-semantics/semantics/methods.k:38:       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0
reference-semantics/semantics/methods.k:39:  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
reference-semantics/semantics/methods.k:40:       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0
reference-semantics/semantics/methods.k:41:  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]
reference-semantics/semantics/methods.k:42:  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0
reference-semantics/semantics/methods.k:43:  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]
reference-semantics/semantics/methods.k:44:  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
reference-semantics/semantics/methods.k:45:
reference-semantics/semantics/methods.k:46:  // S.strip(): trim whitespace runs from both ends
reference-semantics/semantics/methods.k:47:  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
reference-semantics/semantics/methods.k:48:  syntax IntSeq ::= trimWS(IntSeq) [function, total]
reference-semantics/semantics/methods.k:49:  rule trimWS(.IntSeq) => .IntSeq
reference-semantics/semantics/methods.k:50:  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)
reference-semantics/semantics/methods.k:51:  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)
reference-semantics/semantics/methods.k:52:  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]
reference-semantics/semantics/methods.k:53:  rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)
reference-semantics/semantics/methods.k:54:  rule revISAcc(.IntSeq, A:IntSeq) => A
reference-semantics/semantics/methods.k:55:  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))
reference-semantics/semantics/methods.k:56:
reference-semantics/semantics/methods.k:57:  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)
reference-semantics/semantics/methods.k:58:  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)
reference-semantics/semantics/methods.k:59:
reference-semantics/semantics/methods.k:60:  // ==== prefix ===============================================================
reference-semantics/semantics/methods.k:61:  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)
reference-semantics/semantics/methods.k:62:
reference-semantics/semantics/methods.k:63:  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========
reference-semantics/semantics/methods.k:64:  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)
reference-semantics/semantics/methods.k:65:  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]
reference-semantics/semantics/methods.k:66:  rule cntOccVS(.ValSeq, _:Val)                => 0
reference-semantics/semantics/methods.k:67:  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V
reference-semantics/semantics/methods.k:68:  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)
reference-semantics/semantics/methods.k:69:
reference-semantics/semantics/methods.k:70:  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========
reference-semantics/semantics/methods.k:71:  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
reference-semantics/semantics/methods.k:72:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
reference-semantics/semantics/methods.k:73:        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
reference-semantics/semantics/methods.k:74:       [priority(40)]
reference-semantics/semantics/methods.k:75:  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result
reference-semantics/semantics/methods.k:76:  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)
reference-semantics/semantics/methods.k:77:  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))
reference-semantics/semantics/methods.k:78:       requires isWSC(C)
reference-semantics/semantics/methods.k:79:  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)
reference-semantics/semantics/methods.k:80:       requires notBool isWSC(C)
reference-semantics/semantics/methods.k:81:  // flush the current token to the result list iff non-empty.
reference-semantics/semantics/methods.k:82:  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]
