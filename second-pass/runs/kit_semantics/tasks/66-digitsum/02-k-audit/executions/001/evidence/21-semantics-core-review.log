reference-semantics/semantics/core.k:212:  // ==== bool-is-a-subtype-of-int: numeric promotion helpers =================
reference-semantics/semantics/core.k:213:  // Python: `bool` derives from `int`; True/False act as 1/0 in arithmetic and
reference-semantics/semantics/core.k:214:  // comparison. boolAsInt is the total 0/1 coercion; the op-class predicates gate
reference-semantics/semantics/core.k:215:  // the generic Bool-operand promotion rules in int.k / bool.k / float.k (they
reference-semantics/semantics/core.k:216:  // re-dispatch to the existing Int / Float cases after coercion, so no numeric
reference-semantics/semantics/core.k:217:  // logic is duplicated). == and != over Bool x Bool stay in bool.k unchanged.
reference-semantics/semantics/core.k:218:  syntax Int ::= boolAsInt(Bool) [function, total]
reference-semantics/semantics/core.k:219:  rule boolAsInt(true)  => 1
reference-semantics/semantics/core.k:220:  rule boolAsInt(false) => 0
reference-semantics/semantics/core.k:221:
reference-semantics/semantics/core.k:222:  syntax Bool ::= isArithOp(String) [function, total]
reference-semantics/semantics/core.k:223:  rule isArithOp(OP:String)
reference-semantics/semantics/core.k:224:    => OP ==String "+"  orBool OP ==String "-"  orBool OP ==String "*"
reference-semantics/semantics/core.k:225:       orBool OP ==String "/" orBool OP ==String "//" orBool OP ==String "%"
reference-semantics/semantics/core.k:226:       orBool OP ==String "**"
reference-semantics/semantics/core.k:227:  // the six comparison operators (== != < <= > >=)
