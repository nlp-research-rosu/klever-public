reference-semantics/semantics/syntax.k:8:
reference-semantics/semantics/syntax.k:9:  syntax Expr ::= "Int"      "(" Int ")"
reference-semantics/semantics/syntax.k:10:                | "Float"    "(" Float ")"
reference-semantics/semantics/syntax.k:11:                | "Bool"     "(" Bool ")"
reference-semantics/semantics/syntax.k:12:                | "Name"     "(" String ")"
reference-semantics/semantics/syntax.k:13:                | "Str"      "(" String ")"
reference-semantics/semantics/syntax.k:14:                | "UnaryOp"  "(" String "," Expr ")" [strict(2)]
reference-semantics/semantics/syntax.k:15:                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
reference-semantics/semantics/syntax.k:16:                | "BoolOp"    "(" String "," Exprs ")"
reference-semantics/semantics/syntax.k:17:                | "ListExpr"  "(" Exprs ")"
reference-semantics/semantics/syntax.k:18:                | "DictExpr"  "(" Entries ")"
reference-semantics/semantics/syntax.k:19:                | "ListComp"  "(" Expr "," CompFors ")" [macro]
reference-semantics/semantics/syntax.k:20:                | "GenExp"    "(" Expr "," CompFors ")" [macro]
reference-semantics/semantics/syntax.k:21:                | "TupleExpr" "(" Exprs ")"
reference-semantics/semantics/syntax.k:22:                | "Subscript" "(" Expr "," Index ")"
reference-semantics/semantics/syntax.k:23:                | "IfExp"     "(" Expr "," Expr "," Expr ")" [strict(1)]
reference-semantics/semantics/syntax.k:24:                | "Lambda"    "(" Params "," Expr ")"
reference-semantics/semantics/syntax.k:25:                | "KwArg"     "(" String "," Expr ")"
reference-semantics/semantics/syntax.k:26:                | "Lambda"    "(" Params "," CellVars "," FreeVars "," Expr ")"
reference-semantics/semantics/syntax.k:27:                | "NoneVal"
reference-semantics/semantics/syntax.k:28:                | "Call"      "(" Expr "," Exprs ")"
reference-semantics/semantics/syntax.k:29:                | "Attribute" "(" Expr "," String ")" [strict(1)]
reference-semantics/semantics/syntax.k:30:                | "Compare"   "(" Expr "," CmpOp ")"
reference-semantics/semantics/syntax.k:31:
reference-semantics/semantics/syntax.k:32:  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"
reference-semantics/semantics/syntax.k:33:  syntax Entry    ::= "Entry" "(" Expr "," Expr ")"
reference-semantics/semantics/syntax.k:34:  syntax Entries  ::= List{Entry, ","}
reference-semantics/semantics/syntax.k:35:  syntax CompFor  ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
reference-semantics/semantics/syntax.k:36:  syntax CompFors ::= List{CompFor, ""}
reference-semantics/semantics/syntax.k:37:  syntax Exprs    ::= List{Expr, ","}
reference-semantics/semantics/syntax.k:38:  syntax Index    ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
reference-semantics/semantics/syntax.k:39:  syntax Bound    ::= Expr | "NoBound"
reference-semantics/semantics/syntax.k:40:
reference-semantics/semantics/syntax.k:41:  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
reference-semantics/semantics/syntax.k:42:                | "Import"    "(" String ")"
reference-semantics/semantics/syntax.k:43:                | "ImportFrom" "(" String "," ParamNames ")"
reference-semantics/semantics/syntax.k:44:                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
reference-semantics/semantics/syntax.k:45:                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
reference-semantics/semantics/syntax.k:46:                | "While"     "(" Expr "," Stmts ")"
reference-semantics/semantics/syntax.k:47:                | "Break"
reference-semantics/semantics/syntax.k:48:                | "Continue"
reference-semantics/semantics/syntax.k:49:                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
reference-semantics/semantics/syntax.k:50:                | "Return"    "(" Expr ")" [strict]
reference-semantics/semantics/syntax.k:51:                | "Assert"    "(" Expr ")" [strict]
reference-semantics/semantics/syntax.k:52:                | "Expr"      "(" Expr ")" [strict]
reference-semantics/semantics/syntax.k:53:                | "FuncDef"   "(" String "," Params "," Stmts ")"
reference-semantics/semantics/syntax.k:54:                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
reference-semantics/semantics/syntax.k:55:
reference-semantics/semantics/syntax.k:56:  syntax Stmts      ::= List{Stmt, ""}
reference-semantics/semantics/syntax.k:57:  syntax Params     ::= "Params" "(" ParamNames ")"
reference-semantics/semantics/syntax.k:58:  syntax CellVars   ::= "CellVars" "(" ParamNames ")"
reference-semantics/semantics/syntax.k:59:  syntax FreeVars   ::= "FreeVars" "(" ParamNames ")"
reference-semantics/semantics/syntax.k:60:  syntax ParamNames ::= List{String, ","}
reference-semantics/semantics/syntax.k:61:  syntax Module     ::= "Module" "(" Stmts ")"
