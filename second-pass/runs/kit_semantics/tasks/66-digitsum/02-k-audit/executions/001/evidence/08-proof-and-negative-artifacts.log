    10	def ascii_contract_oracle(text):
    11	    codes = map(ord, text)
    12	    return sum(code for code in codes if 65 <= code <= 90)
    13	
    14	
    15	def cases():
    16	    fixed = [
    17	        "",
    18	        "abAB",
    19	        "abcCd",
    20	        "helloE",
    21	        "woArBld",
    22	        "aAaaaXa",
    23	        "".join(chr(code) for code in range(32, 127)),
    24	        "AZ@[`az",
    25	    ]
    26	    rng = random.Random(108)
    27	    alphabet = [chr(code) for code in range(32, 127)]
    28	    random_cases = [
    29	        "".join(rng.choice(alphabet) for _ in range(rng.randrange(0, 65)))
    30	        for _ in range(200)
    31	    ]
    32	    return fixed + random_cases
    33	
    34	
    35	def main():
    36	    samples = cases()
    37	    mismatches = [
