reference-semantics/semantics/builtins.k-290-  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
reference-semantics/semantics/builtins.k:291:  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
reference-semantics/semantics/builtins.k:292:  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
reference-semantics/semantics/builtins.k-293-  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
reference-semantics/semantics/builtins.k-294-  rule isIntV(_:Int)         => true
reference-semantics/semantics/builtins.k-295-  // bool is a subtype of int in Python: isinstance(True, int) is True
reference-semantics/semantics/builtins.k-296-  rule isIntV(_:Bool)        => true
reference-semantics/semantics/builtins.k-297-  rule isIntV(_:Val)         => false [owise]
