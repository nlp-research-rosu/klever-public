    19	    if s == "": return 0
    20	    return sum(ord(char) if char.isupper() else 0 for char in s)
FILE:/candidate/solution.py
     1	def digitSum(s):
     2	    total = 0
     3	    char = ""
     4	    for char in s:
     5	        if char.isupper():
     6	            total += ord(char)
     7	    return total
