     2	  FuncDef("digitSum", Params("s"),
     3	    Assign(Name("total"), Int(0))
     4	    Assign(Name("char"), Str(""))
     5	    For(Name("char"), Name("s"),
     6	      If(Call(Attribute(Name("char"), "isupper"), ),
     7	        AugAssign(Name("total"), "+", Call(Name("ord"), Name("char"))),
     8	        ))
     9	    Return(Name("total"))))
