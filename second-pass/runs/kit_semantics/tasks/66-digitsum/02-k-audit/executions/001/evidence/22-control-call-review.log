reference-semantics/semantics/call.k:1:// reference/src/semantics/call.k — MPY-CALL
reference-semantics/semantics/call.k:2:// ONE call route for every callable: evaluate the callee to a VALUE (name lookup reaches
reference-semantics/semantics/call.k:3:// builtins at the root; a cooled Attribute is a bound method), evaluate the args (the shared
reference-semantics/semantics/call.k:4:// #evalArgs loop in core.k), then dispatch on the callee value:
reference-semantics/semantics/call.k:5://   closureVal    -> bind params, push a frame (user function)
reference-semantics/semantics/call.k:6://   boundMethodV  -> applyMethod
reference-semantics/semantics/call.k:7://   builtinV      -> the #iterNext folds (sum/all/any/max/min) or applyBuiltin
reference-semantics/semantics/call.k:8://   typeV         -> callable type objects: int(...) / str(...)
reference-semantics/semantics/call.k:9:
reference-semantics/semantics/call.k:10:module MPY-CALL
reference-semantics/semantics/call.k:11:  imports MPY-METHODS
reference-semantics/semantics/call.k:12:  imports MPY-BUILTINS
reference-semantics/semantics/call.k:13:  imports MPY-FUNCTIONS
reference-semantics/semantics/call.k:14:
reference-semantics/semantics/call.k:15:  // a cooled attribute is a bound method value
reference-semantics/semantics/call.k:16:  rule <k> Attribute(V:Val, M:String) => boundMethodV(V, M) ... </k>
reference-semantics/semantics/call.k:17:
reference-semantics/semantics/call.k:18:  // evaluate callee, then args ([owise]: problem-local Call interceptions beat this)
reference-semantics/semantics/call.k:19:  syntax KItem ::= #callee(Exprs)
reference-semantics/semantics/call.k:20:  rule <k> Call(Fe:Expr, ARGS:Exprs) => Fe ~> #callee(ARGS) ... </k> [owise]
reference-semantics/semantics/call.k:21:  rule <k> CV:Val ~> #callee(ARGS:Exprs) => #evalArgs(ARGS, .Vals, toCall(CV)) ... </k>
reference-semantics/semantics/call.k:22:
reference-semantics/semantics/call.k:23:  // ==== dispatch on the callee value ========================================
reference-semantics/semantics/call.k:24:  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), ACC:Vals) => applyMethod(OBJ, M, ACC) ... </k>
reference-semantics/semantics/call.k:25:
reference-semantics/semantics/call.k:26:  rule <k> #applyK(toCall(builtinV("sum")), (OBJ:Iterable, .Vals)) => #sumAcc(OBJ, 0) ... </k>
reference-semantics/semantics/call.k:27:  rule <k> #applyK(toCall(builtinV("all")), (OBJ:Iterable, .Vals)) => #allAcc(OBJ)    ... </k>
reference-semantics/semantics/call.k:28:  rule <k> #applyK(toCall(builtinV("any")), (OBJ:Iterable, .Vals)) => #anyAcc(OBJ)    ... </k>
reference-semantics/semantics/call.k:29:  rule <k> #applyK(toCall(builtinV("max")), (OBJ:Iterable, .Vals)) => #maxAcc0(OBJ)   ... </k>
reference-semantics/semantics/call.k:30:  rule <k> #applyK(toCall(builtinV("min")), (OBJ:Iterable, .Vals)) => #minAcc0(OBJ)   ... </k>
reference-semantics/semantics/call.k:31:  rule <k> #applyK(toCall(builtinV(BN:String)), ACC:Vals) => applyBuiltin(BN, ACC) ... </k> [owise]
reference-semantics/semantics/call.k:32:  rule <k> #applyK(toCall(typeV(T:String)),     ACC:Vals) => applyBuiltin(T, ACC)  ... </k>
reference-semantics/semantics/call.k:33:
reference-semantics/semantics/call.k:34:  // ==== heap-object arguments/receivers =====================================
reference-semantics/semantics/call.k:35:  // Builtins and type calls READ structure — deref the first two arg positions
reference-semantics/semantics/call.k:36:  // (covers len/sum/all/any/max/min/sorted/list/set + zip's pair). Mutating list
reference-semantics/semantics/call.k:37:  // methods take the ref itself; every other method receiver is deref'd.
reference-semantics/semantics/call.k:38:  rule <k> #applyK(toCall(builtinV(BN:String)), (ref(H:Int), REST:Vals))
reference-semantics/semantics/call.k:39:        => #applyK(toCall(builtinV(BN)), (V, REST)) ... </k>
reference-semantics/semantics/call.k:40:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/call.k:41:       [priority(40)]
reference-semantics/semantics/call.k:42:  rule <k> #applyK(toCall(builtinV(BN:String)), (A:Val, ref(H:Int), REST:Vals))
reference-semantics/semantics/call.k:43:        => #applyK(toCall(builtinV(BN)), (A, V, REST)) ... </k>
reference-semantics/semantics/call.k:44:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/call.k:45:       requires notBool isRefV(A)
reference-semantics/semantics/call.k:46:       [priority(40)]
reference-semantics/semantics/call.k:47:  rule <k> #applyK(toCall(typeV(T:String)), (ref(H:Int), REST:Vals))
reference-semantics/semantics/call.k:48:        => #applyK(toCall(typeV(T)), (V, REST)) ... </k>
reference-semantics/semantics/call.k:49:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/call.k:50:       [priority(40)]
reference-semantics/semantics/call.k:51:
reference-semantics/semantics/call.k:52:  syntax Bool ::= isMutMethod(String) [function, total]
reference-semantics/semantics/call.k:53:  rule isMutMethod(M:String)
reference-semantics/semantics/call.k:54:    => M ==String "append" orBool M ==String "sort" orBool M ==String "extend"
reference-semantics/semantics/call.k:55:       orBool M ==String "insert" orBool M ==String "pop" orBool M ==String "remove"
reference-semantics/semantics/call.k:56:  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), M:String)), ACC:Vals)
reference-semantics/semantics/call.k:57:        => #applyK(toCall(boundMethodV(V, M)), ACC) ... </k>
reference-semantics/semantics/call.k:58:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/call.k:59:       requires notBool isMutMethod(M)
reference-semantics/semantics/call.k:60:       [priority(40)]
reference-semantics/semantics/call.k:61:  // non-mutating methods READ their heap-object arguments too (join's list);
reference-semantics/semantics/call.k:62:  // mutators keep refs (append of a list into a list-of-lists stays aliased)
reference-semantics/semantics/call.k:63:  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), (ref(H:Int), REST:Vals))
reference-semantics/semantics/call.k:64:        => #applyK(toCall(boundMethodV(OBJ, M)), (V, REST)) ... </k>
reference-semantics/semantics/call.k:65:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/call.k:66:       requires notBool isMutMethod(M) andBool notBool isRefV(OBJ)
reference-semantics/semantics/call.k:67:       [priority(40)]
reference-semantics/semantics/call.k:68:
reference-semantics/semantics/call.k:69:  rule <k> #applyK(toCall(closureVal(PNS:ParamNames, BODY:Stmts, DEFL:Int)), ACC:Vals) ~> CONT
reference-semantics/semantics/call.k:70:        => #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
reference-semantics/semantics/call.k:71:       <env>     CALLERL:Int => NEWL </env>
reference-semantics/semantics/call.k:72:       <scopes>   STORE:Map => STORE [ NEWL <- scope(.Map, parent(DEFL)) ] </scopes>
reference-semantics/semantics/call.k:73:       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
reference-semantics/semantics/call.k:74:       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
reference-semantics/semantics/call.k:75:
reference-semantics/semantics/call.k:76:  // annotated closure: the frame starts with the captured freevar cells, its
reference-semantics/semantics/call.k:77:  // parent is the module scope (all enclosing-local reads go through cells),
reference-semantics/semantics/call.k:78:  // and the cellvars' fresh cells allocate before params bind (a cellvar param
reference-semantics/semantics/call.k:79:  // then writes through its cell in #bindP).
reference-semantics/semantics/call.k:80:  rule <k> #applyK(toCall(closureValC(PNS:ParamNames, CVS:ParamNames, BODY:Stmts, CM:Map)), ACC:Vals) ~> CONT
reference-semantics/semantics/call.k:81:        => #allocCells(CVS) ~> #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
reference-semantics/semantics/call.k:82:       <env>     CALLERL:Int => NEWL </env>
reference-semantics/semantics/call.k:83:       <scopes>   STORE:Map => STORE [ NEWL <- scope(CM [ "$cells" <- cellsMark(CVS) ], parent(0)) ] </scopes>
reference-semantics/semantics/call.k:84:       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
reference-semantics/semantics/call.k:85:       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
reference-semantics/semantics/call.k:86:
reference-semantics/semantics/call.k:87:  syntax KItem ::= #allocCells(ParamNames)
reference-semantics/semantics/call.k:88:  rule <k> #allocCells(.ParamNames) => .K ... </k>
reference-semantics/semantics/call.k:89:  rule <k> #allocCells((CV:String, R:ParamNames)) => #allocCells(R) ... </k>
reference-semantics/semantics/call.k:90:       <env> L:Int </env>
reference-semantics/semantics/call.k:91:       <scopes> ... L |-> scope(M:Map => M [ CV <- cellRef(N) ], _) ... </scopes>
reference-semantics/semantics/call.k:92:       <heap>    H:Map => (N |-> cellV(noneV)) H </heap>
reference-semantics/semantics/call.k:93:       <heapLoc> N:Int => N +Int 1 </heapLoc>
reference-semantics/semantics/call.k:94:       requires notBool N in_keys(H)
reference-semantics/semantics/call.k:95:endmodule
reference-semantics/semantics/controls.k:1:// reference/src/semantics/controls.k — MPY-CONTROLS
reference-semantics/semantics/controls.k:2:
reference-semantics/semantics/controls.k:3:module MPY-CONTROLS
reference-semantics/semantics/controls.k:4:  imports MPY-CORE
reference-semantics/semantics/controls.k:5:  imports MPY-TUPLE
reference-semantics/semantics/controls.k:6:  imports MPY-ITER
reference-semantics/semantics/controls.k:7:
reference-semantics/semantics/controls.k:8:  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
reference-semantics/semantics/controls.k:9:  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
reference-semantics/semantics/controls.k:10:       <env> L:Int </env>
reference-semantics/semantics/controls.k:11:       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
reference-semantics/semantics/controls.k:12:  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
reference-semantics/semantics/controls.k:13:       <env> L:Int </env>
reference-semantics/semantics/controls.k:14:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
reference-semantics/semantics/controls.k:15:       requires "$cells" in_keys(M)
reference-semantics/semantics/controls.k:16:        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
reference-semantics/semantics/controls.k:17:        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
reference-semantics/semantics/controls.k:18:       [priority(40)]
reference-semantics/semantics/controls.k:19:
reference-semantics/semantics/controls.k:20:  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
reference-semantics/semantics/controls.k:21:       <env> L:Int </env>
reference-semantics/semantics/controls.k:22:       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
reference-semantics/semantics/controls.k:23:       requires X in_keys(M)
reference-semantics/semantics/controls.k:24:  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
reference-semantics/semantics/controls.k:25:  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
reference-semantics/semantics/controls.k:26:  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
reference-semantics/semantics/controls.k:27:  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
reference-semantics/semantics/controls.k:28:       <env> L:Int </env>
reference-semantics/semantics/controls.k:29:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
reference-semantics/semantics/controls.k:30:       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
reference-semantics/semantics/controls.k:31:       [priority(40)]
reference-semantics/semantics/controls.k:32:
reference-semantics/semantics/controls.k:33:  // ==== import trivia: `from math import floor, ceil` binds the supported
reference-semantics/semantics/controls.k:34:  // names as builtins in the current scope; every other import is a no-op
reference-semantics/semantics/controls.k:35:  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
reference-semantics/semantics/controls.k:36:  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
reference-semantics/semantics/controls.k:37:  syntax KItem ::= #bindImports(ParamNames)
reference-semantics/semantics/controls.k:38:  rule <k> #bindImports(.ParamNames) => .K ... </k>
reference-semantics/semantics/controls.k:39:  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
reference-semantics/semantics/controls.k:40:       <env> L:Int </env>
reference-semantics/semantics/controls.k:41:       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
reference-semantics/semantics/controls.k:42:       requires N ==String "floor" orBool N ==String "ceil"
reference-semantics/semantics/controls.k:43:  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
reference-semantics/semantics/controls.k:44:       requires notBool (N ==String "floor" orBool N ==String "ceil")
reference-semantics/semantics/controls.k:45:
reference-semantics/semantics/controls.k:46:  // ==== Expr statement: evaluate for effect, discard the value ===============
reference-semantics/semantics/controls.k:47:  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
reference-semantics/semantics/controls.k:48:  rule <k> Expr(_:Val) => .K ... </k>
reference-semantics/semantics/controls.k:49:
reference-semantics/semantics/controls.k:50:  // ==== If (condition evaluated by strictness) ==============================
reference-semantics/semantics/controls.k:51:  syntax KItem ::= #branch(Bool, Stmts, Stmts)
reference-semantics/semantics/controls.k:52:  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
reference-semantics/semantics/controls.k:53:  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
reference-semantics/semantics/controls.k:54:  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
reference-semantics/semantics/controls.k:55:
reference-semantics/semantics/controls.k:56:  // ==== IfExp: ternary T if C else E ========================================
reference-semantics/semantics/controls.k:57:  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
reference-semantics/semantics/controls.k:58:       requires truthy(V)
reference-semantics/semantics/controls.k:59:  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
reference-semantics/semantics/controls.k:60:       requires notBool truthy(V)
reference-semantics/semantics/controls.k:61:
reference-semantics/semantics/controls.k:62:  // ==== For: one loop, in-cell continuation, over #iterNext =================
reference-semantics/semantics/controls.k:63:  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
reference-semantics/semantics/controls.k:64:  // circularities anchor on #loop and narrowing substitutes the structure)
reference-semantics/semantics/controls.k:65:  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
reference-semantics/semantics/controls.k:66:                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
reference-semantics/semantics/controls.k:67:                 | #loopLbl(K) | "#cont" | "#brk"
reference-semantics/semantics/controls.k:68:
reference-semantics/semantics/controls.k:69:  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
reference-semantics/semantics/controls.k:70:
reference-semantics/semantics/controls.k:71:  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
reference-semantics/semantics/controls.k:72:  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
reference-semantics/semantics/controls.k:73:  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
reference-semantics/semantics/controls.k:74:        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
reference-semantics/semantics/controls.k:75:
reference-semantics/semantics/controls.k:76:  // ==== While ==============================================================
reference-semantics/semantics/controls.k:77:  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
reference-semantics/semantics/controls.k:78:  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
reference-semantics/semantics/controls.k:79:  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
reference-semantics/semantics/controls.k:80:       requires truthy(V)
reference-semantics/semantics/controls.k:81:  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
reference-semantics/semantics/controls.k:82:       requires notBool truthy(V)
reference-semantics/semantics/controls.k:83:
reference-semantics/semantics/controls.k:84:  // ==== loop control (break / continue) =====================================
reference-semantics/semantics/controls.k:85:  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
reference-semantics/semantics/controls.k:86:  rule <k> Continue => #cont ... </k>
reference-semantics/semantics/controls.k:87:  rule <k> Break => #brk ... </k>
reference-semantics/semantics/controls.k:88:  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
reference-semantics/semantics/controls.k:89:  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
reference-semantics/semantics/controls.k:90:  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
reference-semantics/semantics/controls.k:91:  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
reference-semantics/semantics/controls.k:92:
reference-semantics/semantics/controls.k:93:  // ==== heap-object deref at the truthiness/iteration consumers ==============
reference-semantics/semantics/controls.k:94:  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
reference-semantics/semantics/controls.k:95:  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
reference-semantics/semantics/controls.k:96:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/controls.k:97:       [priority(40)]
reference-semantics/semantics/controls.k:98:  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
reference-semantics/semantics/controls.k:99:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/controls.k:100:       [priority(40)]
reference-semantics/semantics/controls.k:101:  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
reference-semantics/semantics/controls.k:102:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/controls.k:103:       [priority(40)]
reference-semantics/semantics/controls.k:104:  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
reference-semantics/semantics/controls.k:105:  // mutating the iterated list inside its own loop is outside the subset)
reference-semantics/semantics/controls.k:106:  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
reference-semantics/semantics/controls.k:107:       <heap> ... H |-> V:Val ... </heap>
reference-semantics/semantics/controls.k:108:       [priority(40)]
reference-semantics/semantics/controls.k:109:endmodule
reference-semantics/semantics/functions.k:1:// reference/src/semantics/functions.k — MPY-FUNCTIONS
reference-semantics/semantics/functions.k:2:
reference-semantics/semantics/functions.k:3:module MPY-FUNCTIONS
reference-semantics/semantics/functions.k:4:  imports MPY-CORE
reference-semantics/semantics/functions.k:5:
reference-semantics/semantics/functions.k:6:  // call routing + callee/arg evaluation (#callee/#args/#argCont) live in call.k;
reference-semantics/semantics/functions.k:7:  // this module owns the frame lifecycle (bind params, return, pop).
reference-semantics/semantics/functions.k:8:  syntax KItem ::= frame(continuation: K, callerEnv: Int, savedLoc: Int)
reference-semantics/semantics/functions.k:9:                 | #bindP(ParamNames, Vals)
reference-semantics/semantics/functions.k:10:                 | "#pop"
reference-semantics/semantics/functions.k:11:                 | "#endcall"
reference-semantics/semantics/functions.k:12:
reference-semantics/semantics/functions.k:13:  // ==== def / anonymous closure =============================================
reference-semantics/semantics/functions.k:14:  rule <k> FuncDef(F:String, Params(PNS:ParamNames), BODY:Stmts) => .K ... </k>
reference-semantics/semantics/functions.k:15:       <env> L:Int </env>
reference-semantics/semantics/functions.k:16:       <scopes> ... L |-> scope(M:Map => M [ F <- closureVal(PNS, BODY, L) ], _) ... </scopes>
reference-semantics/semantics/functions.k:17:
reference-semantics/semantics/functions.k:18:  syntax Expr ::= closureExpr(ParamNames, Stmts)
reference-semantics/semantics/functions.k:19:  rule <k> closureExpr(PNS:ParamNames, BODY:Stmts) => closureVal(PNS, BODY, L) ... </k>
reference-semantics/semantics/functions.k:20:       <env> L:Int </env>
reference-semantics/semantics/functions.k:21:
reference-semantics/semantics/functions.k:22:  // ==== annotated def/lambda (closure cells; spec 2.3) ======================
reference-semantics/semantics/functions.k:23:  // closureValC(params, cellvars, body, captured-cells). No frame anchor: all
reference-semantics/semantics/functions.k:24:  // enclosing-local reads are freevars (symtable-complete) and go through the
reference-semantics/semantics/functions.k:25:  // captured cells; everything else is global/builtin, so the callee frame's
reference-semantics/semantics/functions.k:26:  // parent is the module scope (0) — sound after the defining frame dies.
reference-semantics/semantics/functions.k:27:  syntax Val ::= closureValC(ParamNames, ParamNames, Stmts, Map)
reference-semantics/semantics/functions.k:28:
reference-semantics/semantics/functions.k:29:  // capture: resolve each freevar to the enclosing frame's cellRef, then bind
reference-semantics/semantics/functions.k:30:  // (FuncDef) or yield (Lambda) the closure value.
reference-semantics/semantics/functions.k:31:  syntax KItem ::= #mkClosure(String, ParamNames, ParamNames, ParamNames, Stmts, Map)
reference-semantics/semantics/functions.k:32:                 | #mkLambda(ParamNames, ParamNames, ParamNames, Stmts, Map)
reference-semantics/semantics/functions.k:33:  rule <k> FuncDef(F:String, Params(PNS:ParamNames), CellVars(CVS:ParamNames),
