reference-semantics/semantics/functions.k:62:  // ==== bind params ========================================================
reference-semantics/semantics/functions.k:63:  rule <k> #bindP(.ParamNames, .Vals) => .K ... </k>
reference-semantics/semantics/functions.k:64:  rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals)) => #bindP(PS, VS) ... </k>
reference-semantics/semantics/functions.k:65:       <env> L:Int </env>
reference-semantics/semantics/functions.k:66:       <scopes> ... L |-> scope(M:Map => M [ P <- V ], _) ... </scopes>
reference-semantics/semantics/functions.k:67:  // a param that is a cellvar was pre-bound to its cell at frame entry
reference-semantics/semantics/functions.k:68:  rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals))
reference-semantics/semantics/functions.k:69:        => #cellW({M[P]}:>Val, V) ~> #bindP(PS, VS) ... </k>
reference-semantics/semantics/functions.k:70:       <env> L:Int </env>
reference-semantics/semantics/functions.k:71:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
reference-semantics/semantics/functions.k:72:       requires "$cells" in_keys(M)
reference-semantics/semantics/functions.k:73:        andBool pnMember(P, cellsOf({M["$cells"]}:>Val))
reference-semantics/semantics/functions.k:74:        andBool P in_keys(M) andBool isCellRef({M[P]}:>Val)
reference-semantics/semantics/functions.k:75:       [priority(40)]
