reference-semantics/semantics/functions.k:37:                      (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)
reference-semantics/semantics/functions.k:38:        => #mkClosure(F, PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>
