reference-semantics/semantics/functions.k:40:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
reference-semantics/semantics/functions.k:41:       requires FV in_keys(M)
reference-semantics/semantics/functions.k:42:  rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,
reference-semantics/semantics/functions.k:43:                      .ParamNames, BODY:Stmts, CM:Map) => .K ... </k>
reference-semantics/semantics/functions.k:44:       <env> L:Int </env>
reference-semantics/semantics/functions.k:45:       <scopes> ... L |-> scope(M:Map => M [ F <- closureValC(PNS, CVS, BODY, CM) ], _) ... </scopes>
reference-semantics/semantics/functions.k:46:
reference-semantics/semantics/functions.k:47:  rule <k> Lambda(Params(PNS:ParamNames), E:Expr)
reference-semantics/semantics/functions.k:48:        => closureVal(PNS, Return(E) .Stmts, L) ... </k>
reference-semantics/semantics/functions.k:49:       <env> L:Int </env>
reference-semantics/semantics/functions.k:50:  rule <k> Lambda(Params(PNS:ParamNames), CellVars(CVS:ParamNames),
reference-semantics/semantics/functions.k:51:                  FreeVars(FVS:ParamNames), E:Expr)
reference-semantics/semantics/functions.k:52:        => #mkLambda(PNS, CVS, FVS, Return(E) .Stmts, .Map) ... </k>
reference-semantics/semantics/functions.k:53:  rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames,
reference-semantics/semantics/functions.k:54:                     (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)
reference-semantics/semantics/functions.k:55:        => #mkLambda(PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>
reference-semantics/semantics/functions.k:56:       <env> L:Int </env>
reference-semantics/semantics/functions.k:57:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
reference-semantics/semantics/functions.k:58:       requires FV in_keys(M)
