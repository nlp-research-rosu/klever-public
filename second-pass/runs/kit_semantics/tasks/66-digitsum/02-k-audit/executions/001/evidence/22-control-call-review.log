reference-semantics/semantics/functions.k:77:  // ==== return / pop the frame (the returned expr evaluates by strictness) ==
reference-semantics/semantics/functions.k:78:  rule <k> Return(V:Val) ~> _ => #pop </k>
reference-semantics/semantics/functions.k:79:       <ret> noRet => retV(V) </ret>
reference-semantics/semantics/functions.k:80:  rule <k> #endcall => #pop ... </k>
reference-semantics/semantics/functions.k:81:       <ret> noRet => retV(noneV) </ret>
reference-semantics/semantics/functions.k:82:  // pop: restore env, DEALLOCATE the callee frame, and wind scopeLoc back (LIFO allocation
reference-semantics/semantics/functions.k:83:  // makes the saved loc the callee frame's own loc). Sound because no closureVal outlives its
reference-semantics/semantics/functions.k:84:  // defining frame (frontend subset: no returned/stored closures; module defs live in loc 0).
reference-semantics/semantics/functions.k:85:  rule <k> #pop => V ~> CONT </k>
reference-semantics/semantics/functions.k:86:       <ret>   retV(V) => noRet </ret>
reference-semantics/semantics/functions.k:87:       <stack> ListItem(frame(CONT:K, CALLERL:Int, SAVEDL:Int)) => .List ... </stack>
reference-semantics/semantics/functions.k:88:       <env>   L:Int => CALLERL </env>
reference-semantics/semantics/functions.k:89:       <scopes> SC:Map => SC [ L <- undef ] </scopes>
reference-semantics/semantics/functions.k:90:       <scopeLoc> _ => SAVEDL </scopeLoc>
