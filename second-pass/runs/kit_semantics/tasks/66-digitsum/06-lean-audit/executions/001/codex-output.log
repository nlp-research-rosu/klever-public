+127 0 0 True True False True True
+128 0 0 True True False True True
+1000 0 0 True True False True True
+all_exact_matches True
+counterfactual_constant_zero_rejected_at_65 True
+counterfactual_identity_rejected_at_64 True
+counterfactual_lt90_rejected_at_90 True
+counterfactual_lowercase_rejected_at_97 True
