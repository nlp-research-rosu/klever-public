VERIFICATION.K
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical summary of the fixed semantics' ASCII string model.
     7	  // The condition is exactly the one computed by one-character str.isupper().
     8	  syntax Int ::= digitSumIS(IntSeq) [function, total]
     9	
    10	  rule digitSumIS(.IntSeq) => 0
    11	  rule digitSumIS(iCons(C:Int, REST:IntSeq))
    12	    => (#if isUpperC(C) andBool notBool isLowerC(C)
    13	        #then C
    14	        #else 0
    15	        #fi)
    16	       +Int digitSumIS(REST)
    17	endmodule

