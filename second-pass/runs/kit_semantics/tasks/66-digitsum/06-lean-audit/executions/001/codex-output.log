+COMMAND
+wc -l /reference/klean-generation/generated/*.lean /reference/klean-generation/generated/Klean66Digitsum/*.lean
+rg -n '^\s*(?:noncomputable\s+)?(?:theorem|lemma|example|axiom|opaque|def|inductive|structure|class)\b' /reference/klean-generation/generated --glob '*.lean'
+rg -n '\b(?:theorem|lemma|example|final|sorry|admit|unsafe|source_rule_id|obligation)\b' /reference/klean-generation/generated --glob '*.lean'
+
+RESULT SUMMARY
+Seven generated Lean files, 1310 lines total. The proof/target-token scan had
+no matches. There are no theorem, lemma, example, final, sorry, admit, unsafe,
+source_rule_id, or obligation tokens. The declarations consist of generated
+sorts/functions/rewrite constructors and exactly 41 generic collection-hook
+axioms recorded by trust-inventory.json. Klean66Digitsum/Lemmas.lean contains
+only imports, a comment, and an empty namespace. Klean66Digitsum.lean only
+imports Rewrite and Lemmas.
+
+RELEVANT GENERATED DEFINITIONS
+Klean66Digitsum/Func.lean:88-90 defines the empty IntSeq case as some 0.
+Klean66Digitsum/Func.lean:96-118 defines isLowerC/isUpperC using the frozen
+integer ranges 97..122 and 65..90.
+Klean66Digitsum/Func.lean:122-135 structurally recurses on iCons, computes the
+same upper-and-not-lower branch, adds the code, and recurses on REST.
+Klean66Digitsum/Rewrite.lean:3-5 contains the generic Rewrites relation and the
+generated execution constructor for digitSumIS, but declares no proposition
+or proof target.
+
+EXIT CODES
+wc: 0
+declaration scan: 0
+proof/target-token scan: 0 because the command used `|| true`; actual rg had
+no matches.

diff --git a//tmp/audit-work/proc-self-fix.c b//tmp/audit-work/proc-self-fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..94ed3737b725c2c7817c24f167bcb4f8f1b1603a
--- /dev/null
+++ b//tmp/audit-work/proc-self-fix.c
@@ -0,0 +1,63 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef char *(*realpath_fn)(const char *, char *);
+typedef char *(*realpath_chk_fn)(const char *, char *, size_t);
+
+pid_t getpid(void) {
+    char buffer[4096];
+    ssize_t count;
+    int fd = open("/proc/self/status", O_RDONLY);
+    if (fd >= 0) {
+        count = read(fd, buffer, sizeof(buffer) - 1);
+        close(fd);
+        if (count > 0) {
+            char *line;
+            buffer[count] = '\0';
+            line = strstr(buffer, "Pid:\t");
+            if (line != NULL) {
+                long value = strtol(line + 5, NULL, 10);
+                if (value > 0) {
+                    return (pid_t)value;
+                }
+            }
+        }
+    }
+    return (pid_t)1;
+}
+
+static const char *proc_self_path(const char *path) {
+    size_t length;
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+        return path;
+    }
+    length = strlen(path);
+    if (length > 10 && strcmp(path + length - 4, "/exe") == 0 &&
+        strcmp(path, "/proc/self/exe") != 0) {
+        return "/proc/self/exe";
+    }
+    return path;
+}
+
+char *realpath(const char *path, char *resolved_path) {
+    static realpath_fn original;
+    if (original == NULL) {
+        original = (realpath_fn)dlsym(RTLD_NEXT, "realpath");
+    }
+    return original(proc_self_path(path), resolved_path);
+}
+
+char *__realpath_chk(const char *path, char *resolved_path, size_t length) {
+    static realpath_chk_fn original;
+    if (original == NULL) {
+        original = (realpath_chk_fn)dlsym(RTLD_NEXT, "__realpath_chk");
+    }
+    return original(proc_self_path(path), resolved_path, length);
+}
