+
+namespace Proof.FibfibModel
+
+/-- The frozen `fibfibSpec` recurrence on natural-number indices. -/
+def fibfibNat : Nat → Int
+  | 0 => 0
+  | 1 => 0
+  | 2 => 1
+  | n + 3 => fibfibNat n + fibfibNat (n + 1) + fibfibNat (n + 2)
