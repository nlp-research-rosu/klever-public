codex
The cause is confirmed: Lean’s libuv asks for `/proc/2/exe`, but this sandbox exposes the executable only through `/proc/self/exe`, so the launcher fails before elaboration. I’ll use a temporary `LD_PRELOAD` shim that redirects only that executable-path read; it leaves the pinned Lean binaries, dependencies, project files, and proof semantics unchanged.
apply patch
patch: completed
/tmp/lean_app_path_fix.c
diff --git a//tmp/lean_app_path_fix.c b//tmp/lean_app_path_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..8f242901afe17ac064cf61abfb58620462260c48
--- /dev/null
+++ b//tmp/lean_app_path_fix.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_proc_exe_path(const char *path) {
+  size_t length = strlen(path);
+  return strncmp(path, "/proc/", 6) == 0
+      && length >= 10
+      && strcmp(path + length - 4, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink)
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  return real_readlink(
+      is_proc_exe_path(path) ? "/proc/self/exe" : path, buf, size);
+}
