exec
/bin/bash -lc "python3 - <<'PY'
import hashlib
import json
from collections import Counter
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
assert len(out['rules']) == len(inventory['rules'])

canonical_ids = [r['source_rule_id'] for r in inventory['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == canonical_ids
assert len(out_ids) == len(set(out_ids))

allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for canonical, classified in zip(inventory['rules'], out['rules']):
    assert list(classified) == ['source_rule_id', 'classification', 'rationale']
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if 'simplification' in canonical.get('attributes', []):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

verification_sha = hashlib.sha256(Path('/reference/k-proof/verification.k').read_bytes()).hexdigest()
assert verification_sha == inventory['verification_sha256']

print('schema_version:', out['schema_version'])
print('inventory_sha256:', out['inventory_sha256'])
print('canonical_order_match: yes')
print('unique_rule_ids:', len(set(out_ids)))
print('classification_counts:', dict(Counter(r['classification'] for r in out['rules'])))
print('simplification_constraint: satisfied')
print('stage1_verification_sha256_match: yes')
