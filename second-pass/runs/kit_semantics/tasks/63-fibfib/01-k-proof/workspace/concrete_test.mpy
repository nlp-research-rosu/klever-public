Module(
  FuncDef("fibfib", Params("n"),
    Assign(Name("a"), Int(0))
    Assign(Name("b"), Int(0))
    Assign(Name("c"), Int(1))
    Assign(Name("i"), Int(0))
    Assign(Name("next_value"), Int(1))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      Assign(
        Name("next_value"),
        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
      Assign(Name("a"), Name("b"))
      Assign(Name("b"), Name("c"))
      Assign(Name("c"), Name("next_value"))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("a")))
  Assert(Compare(Call(Name("fibfib"), Int(0)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("fibfib"), Int(1)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("fibfib"), Int(2)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("fibfib"), Int(3)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("fibfib"), Int(5)), CmpOp("==", Int(4))))
  Assert(Compare(Call(Name("fibfib"), Int(8)), CmpOp("==", Int(24))))
  Assert(Compare(Call(Name("fibfib"), Int(10)), CmpOp("==", Int(81)))))
