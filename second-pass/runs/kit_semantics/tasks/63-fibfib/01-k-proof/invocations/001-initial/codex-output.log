diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a3d1ebf9322f06c8bd6950f612bd021e400e2dca
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports INT
+
+  syntax Int ::= fibfibSpec(Int) [function, total, no-evaluators]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Mathematical FibFib sequence.  Concrete equations give the three bases
+  // and the recurrence on every integer in its intended (nonnegative) domain.
+  rule fibfibSpec(0) => 0 [concrete]
+  rule fibfibSpec(1) => 0 [concrete]
+  rule fibfibSpec(2) => 1 [concrete]
+  rule fibfibSpec(N:Int)
+    => fibfibSpec(N -Int 1) +Int fibfibSpec(N -Int 2) +Int fibfibSpec(N -Int 3)
+    requires N >=Int 3
+    [concrete]
+  rule fibfibSpec(N:Int) => 0
+    requires N <Int 0
+    [concrete]
+
+  // The loop advances the consecutive triple F(i), F(i+1), F(i+2).
+  // This is the recurrence above with N = I + 3, oriented for the invariant.
+  rule fibfibSpec(I:Int) +Int fibfibSpec(I +Int 1)
+         +Int fibfibSpec(I +Int 2)
+    => fibfibSpec(I +Int 3)
+    requires I >=Int 0
+    [simplification]
+endmodule

diff --git a/artifact_checks.py b/artifact_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..ae576e0cd3c27703dac29f376b6cb07ccc0b0699
--- /dev/null
+++ b/artifact_checks.py
@@ -0,0 +1,28 @@
+import ast
+import re
+from pathlib import Path
+
+
+def normalized_k(path: str) -> str:
+    text = re.sub(r"\s+", "", Path(path).read_text())
+    # K's Stmts list terminator is optional in parsed surface syntax.  The
+    # translator omits it while the hand-written claim spells it explicitly.
+    return text.replace(".Stmts", "")
+
+
+solution_tree = ast.parse(Path("solution.py").read_text())
+harness_tree = ast.parse(Path("concrete_test.py").read_text())
+solution_function = solution_tree.body[0]
+harness_function = harness_tree.body[0]
+
+assert isinstance(solution_function, ast.FunctionDef)
+assert solution_function.name == "fibfib"
+assert [arg.arg for arg in solution_function.args.args] == ["n"]
+assert ast.dump(solution_function, include_attributes=False) == ast.dump(
+    harness_function, include_attributes=False
+)
+assert normalized_k("solution.mpy") in normalized_k("spec.k")
+
+print("entry-point: fibfib(n)")
+print("concrete-harness-body: identical")
+print("solution.mpy-in-entry-claim: yes")
diff --git a/concrete_test.py b/concrete_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..17df61f3188be713341f8d3f2c9d72a2eb9b5b47
--- /dev/null
+++ b/concrete_test.py
@@ -0,0 +1,22 @@
+def fibfib(n: int):
+    a = 0
+    b = 0
+    c = 1
+    i = 0
+    next_value = 1
+    while i < n:
+        next_value = a + b + c
+        a = b
+        b = c
+        c = next_value
+        i = i + 1
+    return a
+
+
+assert fibfib(0) == 0
+assert fibfib(1) == 0
+assert fibfib(2) == 1
+assert fibfib(3) == 1
+assert fibfib(5) == 4
+assert fibfib(8) == 24
+assert fibfib(10) == 81
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..a6db1819297f197383da147e3c6b57eaa28d46e2
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,31 @@
+from functools import lru_cache
+
+from solution import fibfib
+
+
+@lru_cache(maxsize=None)
+def recursive_oracle(n: int) -> int:
+    if n == 0 or n == 1:
+        return 0
+    if n == 2:
+        return 1
+    return (
+        recursive_oracle(n - 1)
+        + recursive_oracle(n - 2)
+        + recursive_oracle(n - 3)
+    )
+
+
+inputs = list(range(31))
+mismatches = [
+    (n, fibfib(n), recursive_oracle(n))
+    for n in inputs
+    if fibfib(n) != recursive_oracle(n)
+]
+
+print(f"inputs: 0..{inputs[-1]}")
+print(f"cases: {len(inputs)}")
+print(f"mismatches: {len(mismatches)}")
+if mismatches:
+    print(mismatches)
+    raise SystemExit(1)
