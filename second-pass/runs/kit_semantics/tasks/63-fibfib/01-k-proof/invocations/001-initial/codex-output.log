+              BinOp(
+                "+",
+                BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+                Int(1)))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("next_value"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+            .Stmts)
+          Return(Name("a"))
+          .Stmts,
