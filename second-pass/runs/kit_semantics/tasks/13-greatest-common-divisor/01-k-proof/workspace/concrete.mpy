Module(
  FuncDef("greatest_common_divisor", Params("a", "b"),
    Assign(Name("remainder"), Int(0))
    While(Compare(Name("b"), CmpOp("!=", Int(0))),
      Assign(Name("remainder"), BinOp("%", Name("a"), Name("b")))
      Assign(Name("a"), Name("b"))
      Assign(Name("b"), Name("remainder")))
    Return(Call(Name("abs"), Name("a"))))
  Assign(
    Name("result_3_5"),
    Call(Name("greatest_common_divisor"), Int(3), Int(5)))
  Assign(
    Name("result_25_15"),
    Call(Name("greatest_common_divisor"), Int(25), Int(15)))
  Assign(
    Name("result_zero_neg"),
    Call(Name("greatest_common_divisor"), Int(0), UnaryOp("-", Int(7))))
  Assign(
    Name("result_both_zero"),
    Call(Name("greatest_common_divisor"), Int(0), Int(0)))
  Assert(Compare(Name("result_3_5"), CmpOp("==", Int(1))))
  Assert(Compare(Name("result_25_15"), CmpOp("==", Int(5))))
  Assert(Compare(Name("result_zero_neg"), CmpOp("==", Int(7))))
  Assert(Compare(Name("result_both_zero"), CmpOp("==", Int(0)))))
