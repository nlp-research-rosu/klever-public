SOURCE_SOLUTION.PY
     1	def greatest_common_divisor(a: int, b: int) -> int:
     2	    """Return the non-negative greatest common divisor of a and b."""
     3	    remainder = 0
     4	    while b != 0:
     5	        remainder = a % b
     6	        a = b
     7	        b = remainder
     8	    return abs(a)
