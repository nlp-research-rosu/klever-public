+++ b//tmp/audit-work/lean-pid-compat/lake
@@ -0,0 +1,5 @@
+#!/bin/sh
+set -eu
+
+export LD_PRELOAD=/tmp/audit-work/lean-pid-compat/getpid_compat.so
+exec /opt/elan/bin/lake "$@"
