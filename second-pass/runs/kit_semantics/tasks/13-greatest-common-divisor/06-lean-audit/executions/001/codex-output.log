+#!/bin/sh
+set -eu
+
+printf '%s\n' 'AUDIT_MODE'
+printenv AUDIT_MODE
+printf '%s\n' 'CANDIDATE_PATH_STATUS'
+if [ -e /candidate ]; then
+  printf '%s\n' 'present'
+else
+  printf '%s\n' 'absent'
+fi
+printf '%s\n' 'VERIFICATION.K'
