+sed -n '76,88p' /reference/k-proof/reference-semantics/semantics/controls.k
+printf '%s\n' 'ABS_SEMANTICS'
+sed -n '40,47p' /reference/k-proof/reference-semantics/semantics/builtins.k
+printf '%s\n' 'PROOF_COMMANDS'
