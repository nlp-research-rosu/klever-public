codex
I found the concrete infrastructure defect: processes report namespace PIDs (for example `getpid() = 3`), while `/proc` exposes different host PIDs. Lean 4.22 resolves its executable via `/proc/<getpid()>/exe`, so both `lean` and Lake’s installation discovery fail. I’m applying a narrow, local compatibility shim under `/tmp/audit-work` that only makes `getpid()` agree with `/proc/self`; it does not alter any input or generated source. The failed attempts remain preserved as evidence.
apply patch
patch: completed
/tmp/audit-work/lean-pid-compat/getpid_compat.c
/tmp/audit-work/lean-pid-compat/lake
diff --git a//tmp/audit-work/lean-pid-compat/getpid_compat.c b//tmp/audit-work/lean-pid-compat/getpid_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..b7ed38938a4d56701c38b72af28ee5663b585638
--- /dev/null
+++ b//tmp/audit-work/lean-pid-compat/getpid_compat.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox exposes host-PID /proc while getpid() reports a PID from
+ * another namespace. Lean 4.22 reads /proc/<getpid()>/exe. Return the PID that
+ * /proc/self names so Lean observes a consistent procfs view.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        errno = ESRCH;
+        return (pid_t)-1;
+    }
+    target[length] = '\0';
+    char *end = NULL;
+    long value = strtol(target, &end, 10);
+    if (end == target || *end != '\0' || value <= 0 || value > INT_MAX) {
+        errno = ESRCH;
+        return (pid_t)-1;
+    }
+    return (pid_t)value;
+}
