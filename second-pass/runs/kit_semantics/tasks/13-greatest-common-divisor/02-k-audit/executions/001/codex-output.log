def validate_safe_component(value: object, label: str) -> str:
    if not isinstance(value, str):
        raise PipelineContractError(f"{label} must be a string path component")
    path = Path(value)
    if (
        not value
        or value in {".", ".."}
        or value.startswith(".")
        or path.is_absolute()
        or len(path.parts) != 1
