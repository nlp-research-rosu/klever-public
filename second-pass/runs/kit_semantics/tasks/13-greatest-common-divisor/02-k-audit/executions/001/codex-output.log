+          "b" |-> B
+          "remainder" |-> _R,
+          parent(0)
+        )
+       -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(GLOBALS, parent(-1))
+       -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
