+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(GLOBALS, parent(-1))
+        1 |-> scope(
+          "a" |-> A
+          "b" |-> B
+          "remainder" |-> _R,
+          parent(0)
+        )
+       -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(GLOBALS, parent(-1))
