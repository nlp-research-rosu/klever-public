codex
I found the concrete cause: Lean asks for `/proc/<its namespace PID>/exe`, but this audit sandbox’s mounted `/proc` is from a different PID namespace, so the path is absent. I’m applying a narrowly scoped runtime shim that only redirects a failed `/proc/<digits>/exe` read to `/proc/self/exe`; this restores executable self-location without changing Lean sources, generated code, or theorem checking. The diagnosis and shim source are being retained as evidence.
apply patch
patch: completed
/tmp/audit-work/trace_readlink.c
diff --git a//tmp/audit-work/trace_readlink.c b//tmp/audit-work/trace_readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..9253e39bd51fff1ab862e8c16bfbf3800e2c7e9c
--- /dev/null
+++ b//tmp/audit-work/trace_readlink.c
@@ -0,0 +1,43 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+  const char *cursor = path;
+  if (strncmp(cursor, "/proc/", 6) != 0) return 0;
+  cursor += 6;
+  if (*cursor < '0' || *cursor > '9') return 0;
+  while (*cursor >= '0' && *cursor <= '9') cursor++;
+  return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = real_readlink(path, buf, bufsiz);
+  int saved = errno;
+  if (result < 0 && saved == ENOENT && is_proc_pid_exe(path)) {
+    result = real_readlink("/proc/self/exe", buf, bufsiz);
+    saved = errno;
+    fprintf(stderr, "SHIM readlink %s -> /proc/self/exe result=%zd errno=%d\n",
+            path, result, saved);
+  }
+  fprintf(stderr, "TRACE readlink path=%s result=%zd errno=%d value=%.*s\n",
+          path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (!real_readlinkat) real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  ssize_t result = real_readlinkat(dirfd, path, buf, bufsiz);
+  int saved = errno;
+  fprintf(stderr, "TRACE readlinkat path=%s result=%zd errno=%d value=%.*s\n",
+          path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}

