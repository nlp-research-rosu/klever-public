actual={p.relative_to('/reference/k-proof').as_posix(): hfile(p) for p in pipeline_contract._walk_regular_files(Path('/reference/k-proof'),'mounted Stage 1 workspace')}
missing=sorted(set(recorded)-set(actual)); extra=sorted(set(actual)-set(recorded)); mismatched=sorted(k for k in set(recorded)&set(actual) if recorded[k]"'!=actual[k])
print('"'stage1_source_hash_count_recorded',len(recorded)); print('stage1_source_hash_count_actual',len(actual))
print('stage1_source_missing',missing); print('stage1_source_extra',extra); print('stage1_source_mismatched',mismatched)
checks.append(not missing and not extra and not mismatched)

gen=Path('/reference/klean-generation')
gm=json.loads((gen/'generator-manifest.json').read_text()); im=json.loads((gen/'input-manifest.json').read_text()); om=json.loads((gen/'generated/obligation-map.json').read_text()); er=json.loads((gen/'export-result.json').read_text()); lock=json.loads(Path('/reference/klean-toolchain.lock.json').read_text())
target=klean_export.target_statement(gen/'generated')
checks.append(report('generator.generated_tree_sha256', klean_export.tree_digest(gen/'generated'), gm['generated_tree_sha256']))
