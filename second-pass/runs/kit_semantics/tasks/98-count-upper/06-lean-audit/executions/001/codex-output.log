print('generated_conjunct',repr(om['obligations'][0]['lean_conjunct']))
print('mathematical_judgment=The source and target universally quantify three K/Lean integers and assert the same left-to-right associativity equation. Variable ordering is immaterial; there are no guards to omit, no weakened conclusion, and SortInt is Lean Int.')
if not all(checks.values()): raise SystemExit(1)
