checks['source_hash_exact']=om['obligations'][0]['normalized_sha256']==source['normalized_sha256']
checks['source_inventory_hash_exact']=om['obligations'][0]['inventory_sha256']==inv['inventory_sha256']
for k,v in checks.items(): print(f'{k}={\"PASS\" if v else \"FAIL\"}')
print('independent_domain_ids',ids)
