checks.append(report('generator.target_vs_extracted', target, gm['target']))
checks.append(report('audit.target_vs_extracted', target, audit['target']))
checks.append(report('generator.toolchain_vs_lock', gm['toolchain'], lock))
checks.append(report('input.verification_sha256', hfile('/reference/k-proof/verification.k'), im['verification_sha256']))
checks.append(report('input.stage1_workspace_sha256', klean_export.tree_digest(Path('/reference/k-proof')), im['stage1_workspace_sha256']))
checks.append(report('input.frozen_input_sha256', klean_export.tree_digest(Path('/reference/k-proof')), im['frozen_input_sha256']))
checks.append(report('input.discovery_manifest_sha256', hfile('/reference/lemma-discovery.json'), im['stage3_discovery_manifest_sha256']))
checks.append(report('export.trust_inventory_sha256', hfile(gen/'trust-inventory.json'), er['trust_inventory_sha256']))
checks.append(report('export.generated_tree_sha256', klean_export.tree_digest(gen/'generated'), er['generated_tree_sha256']))
checks.append(report('export.frozen_input_sha256', klean_export.tree_digest(Path('/reference/k-proof')), er['frozen_input_sha256']))
checks.append(report('export.discovery_manifest_sha256', hfile('/reference/lemma-discovery.json'), er['stage3_discovery_manifest_sha256']))
for i,o in enumerate(om['obligations'],1):
 checks.append(report(f'obligation[{i}].lean_conjunct_sha256', hashlib.sha256(o['lean_conjunct'].encode()).hexdigest(), o['lean_conjunct_sha256']))
for i,p in enumerate(om['trust_parameters'],1):
 binding={k:p[k] for k in ('kore_symbol','name','type','source_rule_ids')}
 digest=hashlib.sha256(json.dumps(binding,sort_keys=True,separators=(',',':')).encode()).hexdigest()
 checks.append(report(f'parameter[{i}].binding_sha256',digest,p['binding_sha256']))
