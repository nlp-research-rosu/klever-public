 'input_rule_records_exact': im['source_rules']==om['source_rules'],
 'generator_count_exact': gm['obligation_count']==len(ids),
 'export_count_exact': er['obligation_count']==len(ids),
 'target_parameter_covers_exact_rule': om['trust_parameters'][0]['source_rule_ids']==ids,
 'no_operational_or_derived_export': not im['operational_rules'] and not im['proved_derived_lemmas'],
}
expected='∀ (C : SortInt) (B : SortInt) (A : SortInt), («_+Int_» («_+Int_» A B) C : SortInt) = («_+Int_» A («_+Int_» B C) : SortInt)'
checks['lean_conjunct_exact_associativity']=om['obligations'][0]['lean_conjunct']==expected
source=domain[0]
