+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_upper" |->
+          closureVal(
+            ("s", .ParamNames),
+            Assign(Name("count"), Int(0))
+            Assign(Name("remaining"), Name("s"))
+            While(
+              Name("remaining"),
+              AugAssign(
+                Name("count"),
