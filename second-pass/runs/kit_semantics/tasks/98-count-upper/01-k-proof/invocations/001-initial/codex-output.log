+                  Subscript(Name("remaining"), Int(0)),
+                  CmpOp("in", Str("AEIOU"))))
+              Assign(
+                Name("remaining"),
+                Subscript(
+                  Name("remaining"),
+                  Slice(Int(2), NoBound, NoBound))))
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
