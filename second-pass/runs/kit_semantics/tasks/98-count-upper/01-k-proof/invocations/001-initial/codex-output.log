+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The suffix after removing the character immediately following the head.
+  syntax IntSeq ::= dropNext(IntSeq) [function, total]
+  rule dropNext(.IntSeq)                 => .IntSeq
+  rule dropNext(iCons(_:Int, R:IntSeq))  => R
+
+  // Number of uppercase vowels at offsets 0, 2, 4, ... in a code sequence.
+  syntax Int ::= countUpperEven(IntSeq) [function, total]
+  rule countUpperEven(.IntSeq) => 0
+  rule countUpperEven(iCons(C:Int, R:IntSeq))
+    => (#if strContains(iCons(C, .IntSeq), strToCodes("AEIOU"))
+        #then 1 #else 0 #fi)
+       +Int countUpperEven(dropNext(R))
+endmodule

