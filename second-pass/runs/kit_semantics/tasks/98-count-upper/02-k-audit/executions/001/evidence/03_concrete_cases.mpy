Module(
  FuncDef("count_upper", Params("s"),
    Assign(Name("count"), Int(0))
    Assign(Name("remaining"), Name("s"))
    While(Name("remaining"),
      AugAssign(
        Name("count"),
        "+",
        Compare(
          Subscript(Name("remaining"), Int(0)),
          CmpOp("in", Str("AEIOU"))))
      Assign(
        Name("remaining"),
        Subscript(Name("remaining"), Slice(Int(2), NoBound, NoBound))))
    Return(Name("count")))
  Assert(
    Compare(Call(Name("count_upper"), Str("")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("A")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("count_upper"), Str("B")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("AA")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("count_upper"), Str("BA")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("AB")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("count_upper"), Str("AAB")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("count_upper"), Str("BAA")), CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("aBCdEf")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("abcdefg")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("dBBE")), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("AEIOU")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("AaEeIiOoUu")),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("BBBBBBBBB")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")),
      CmpOp("==", Int(16)))))
