diff --git a/evidence/03_concrete_cases.py b/evidence/03_concrete_cases.py
new file mode 100644
index 0000000000000000000000000000000000000000..742c8aab53e5c62c2ab462f9be19f4c1cbfec45a
--- /dev/null
+++ b/evidence/03_concrete_cases.py
@@ -0,0 +1,24 @@
+def count_upper(s):
+    count = 0
+    remaining = s
+    while remaining:
+        count += remaining[0] in "AEIOU"
+        remaining = remaining[2:]
+    return count
+
+
+assert count_upper("") == 0
+assert count_upper("A") == 1
+assert count_upper("B") == 0
+assert count_upper("AA") == 1
