+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_upper" |->
+          closureVal(
+            ("s", .ParamNames),
+            Assign(Name("count"), Int(0))
+            Assign(Name("remaining"), Name("s"))
+            While(
+              Name("remaining"),
+              AugAssign(
+                Name("count"),
+                "+",
+                Compare(
+                  Subscript(Name("remaining"), Int(0)),
+                  CmpOp("in", Str("AEIOU"))))
+              Assign(
+                Name("remaining"),
+                Subscript(
+                  Name("remaining"),
+                  Slice(Int(2), NoBound, NoBound))))
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
