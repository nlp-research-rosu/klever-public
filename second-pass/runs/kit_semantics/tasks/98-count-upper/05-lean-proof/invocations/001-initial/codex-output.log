codex
The failure is environmental, not a Lean error: this container’s PID namespace exposes `/proc/self/exe` but not `/proc/<getpid()>/exe`, while Lean 4.22’s launcher queries the latter. I’ll use a temporary preload shim that redirects only that executable-path lookup to `/proc/self/exe`; it does not alter the project, target, toolchain, dependencies, or proof.
apply patch
patch: completed
/tmp/lean-proc-self.c
diff --git a//tmp/lean-proc-self.c b//tmp/lean-proc-self.c
new file mode 100644
index 0000000000000000000000000000000000000000..cceff9152bf808db428ab96408e4bc52fd8f2580
--- /dev/null
+++ b//tmp/lean-proc-self.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    size_t length = strlen(path);
+    if (length > 10
+        && strncmp(path, "/proc/", 6) == 0
+        && strcmp(path + length - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+
+    return real_readlink(path, buffer, size);
+}
