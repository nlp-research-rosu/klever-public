     6	def int_to_mini_roman(number):
     7	    """
     8	    Given a positive integer, obtain its roman numeral equivalent as a string,
     9	    and return it in lowercase.
    10	    Restrictions: 1 <= num <= 1000
    11	
    12	    Examples:
    13	    >>> int_to_mini_roman(19) == 'xix'
    14	    >>> int_to_mini_roman(152) == 'clii'
    15	    >>> int_to_mini_roman(426) == 'cdxxvi'
    16	    """
    17	    num = [1, 4, 5, 9, 10, 40, 50, 90,  
    18	           100, 400, 500, 900, 1000] 
    19	    sym = ["I", "IV", "V", "IX", "X", "XL",  
    20	           "L", "XC", "C", "CD", "D", "CM", "M"] 
    21	    i = 12
    22	    res = ''
    23	    while number: 
    24	        div = number // num[i] 
    25	        number %= num[i] 
    26	        while div: 
    27	            res += sym[i] 
    28	            div -= 1
    29	        i -= 1
    30	    return res.lower()

