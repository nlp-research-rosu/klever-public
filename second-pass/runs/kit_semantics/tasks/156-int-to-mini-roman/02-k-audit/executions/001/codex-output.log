+#!/usr/bin/env bash
+set -o pipefail
+
+if [ "$#" -lt 2 ]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 2
+fi
+
+audit_log=$1
+shift
+
+: > "$audit_log"
+printf 'COMMAND:' | tee -a "$audit_log"
