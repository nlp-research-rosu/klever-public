python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
python3 - <<'PY'
from solution import int_to_mini_roman

def oracle(n):
    values = (1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1)
    digits = ('m', 'cm', 'd', 'cd', 'c', 'xc', 'l', 'xl', 'x', 'ix', 'v', 'iv', 'i')
    out = ''
    for value, digit in zip(values, digits):
        count, n = divmod(n, value)
        out += digit * count
    return out

assert all(int_to_mini_roman(n) == oracle(n) for n in range(1, 1001))
print('CPython exhaustive differential: PASS (1..1000)')
PY
kompile --backend llvm reference-semantics/semantics.k --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition runtime-kompiled" in /workspace
