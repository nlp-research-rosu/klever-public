new file mode 100644
index 0000000000000000000000000000000000000000..95da19665a5da564c0df5797fc7dd8f1a9f214d5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,111 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
