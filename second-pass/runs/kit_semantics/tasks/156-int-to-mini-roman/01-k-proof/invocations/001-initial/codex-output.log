+++ b/verification.k
@@ -0,0 +1,111 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Canonical positional Roman-digit tables.  These functions describe the
+  // expected value; none of them rewrites or replaces program execution.
+  syntax IntSeq ::= hundredsCodes(Int) [function, total]
+                  | tensCodes(Int) [function, total]
+                  | onesCodes(Int) [function, total]
+                  | miniRomanCodes(Int) [function, total]
+
+  rule hundredsCodes(0) => strToCodes("")
+  rule hundredsCodes(1) => strToCodes("c")
+  rule hundredsCodes(2) => strToCodes("cc")
+  rule hundredsCodes(3) => strToCodes("ccc")
+  rule hundredsCodes(4) => strToCodes("cd")
+  rule hundredsCodes(5) => strToCodes("d")
+  rule hundredsCodes(6) => strToCodes("dc")
+  rule hundredsCodes(7) => strToCodes("dcc")
+  rule hundredsCodes(8) => strToCodes("dccc")
+  rule hundredsCodes(9) => strToCodes("cm")
+  rule hundredsCodes(D) => .IntSeq
+    requires D <Int 0 orBool D >Int 9
+
+  rule tensCodes(0) => strToCodes("")
+  rule tensCodes(1) => strToCodes("x")
+  rule tensCodes(2) => strToCodes("xx")
+  rule tensCodes(3) => strToCodes("xxx")
+  rule tensCodes(4) => strToCodes("xl")
+  rule tensCodes(5) => strToCodes("l")
+  rule tensCodes(6) => strToCodes("lx")
+  rule tensCodes(7) => strToCodes("lxx")
+  rule tensCodes(8) => strToCodes("lxxx")
+  rule tensCodes(9) => strToCodes("xc")
+  rule tensCodes(D) => .IntSeq
+    requires D <Int 0 orBool D >Int 9
+
+  rule onesCodes(0) => strToCodes("")
+  rule onesCodes(1) => strToCodes("i")
+  rule onesCodes(2) => strToCodes("ii")
+  rule onesCodes(3) => strToCodes("iii")
+  rule onesCodes(4) => strToCodes("iv")
+  rule onesCodes(5) => strToCodes("v")
+  rule onesCodes(6) => strToCodes("vi")
+  rule onesCodes(7) => strToCodes("vii")
+  rule onesCodes(8) => strToCodes("viii")
+  rule onesCodes(9) => strToCodes("ix")
+  rule onesCodes(D) => .IntSeq
+    requires D <Int 0 orBool D >Int 9
+
+  rule miniRomanCodes(1000) => strToCodes("m")
+  rule miniRomanCodes(N)
+    => seqConcat(
+         hundredsCodes(
+           (pyMod(N, 1000) -Int pyMod(pyMod(N, 1000), 100)) /Int 100),
+         seqConcat(
+           tensCodes(
+             (pyMod(N, 100) -Int pyMod(pyMod(N, 100), 10)) /Int 10),
+           onesCodes(pyMod(N, 10))))
+    requires N =/=Int 1000
+
+  // Parse-time aliases for the exact py2mpy translation and a call harness.
+  // Macro expansion happens before execution; it adds no operational rule.
+  syntax Stmts ::= "intToMiniRomanBody" [macro]
+  syntax Module ::= "solutionModule" [macro]
+                  | "solutionCall" "(" Int ")" [macro]
+
+  rule intToMiniRomanBody
+    => Assign(
+         Name("hundreds"),
+         Subscript(
+           TupleExpr(
+             Str(""), Str("c"), Str("cc"), Str("ccc"), Str("cd"),
+             Str("d"), Str("dc"), Str("dcc"), Str("dccc"), Str("cm")),
+           BinOp("//", BinOp("%", Name("number"), Int(1000)), Int(100))))
+       Assign(
+         Name("tens"),
+         Subscript(
+           TupleExpr(
+             Str(""), Str("x"), Str("xx"), Str("xxx"), Str("xl"),
+             Str("l"), Str("lx"), Str("lxx"), Str("lxxx"), Str("xc")),
+           BinOp("//", BinOp("%", Name("number"), Int(100)), Int(10))))
+       Assign(
+         Name("ones"),
+         Subscript(
+           TupleExpr(
+             Str(""), Str("i"), Str("ii"), Str("iii"), Str("iv"),
+             Str("v"), Str("vi"), Str("vii"), Str("viii"), Str("ix")),
+           BinOp("%", Name("number"), Int(10))))
+       If(Compare(Name("number"), CmpOp("==", Int(1000))),
+         Return(Str("m")),
+         .Stmts)
+       Return(
+         BinOp(
+           "+",
+           BinOp("+", Name("hundreds"), Name("tens")),
+           Name("ones")))
+
