diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..75e03fe1078b169777514ed173b787061abb3239
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal entry claim over the prompt's complete finite input domain.
+  claim [roman-domain]:
+    <k> #loadAll(solutionCall(N:Int)) => .K </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "__result" |-> str(miniRomanCodes(N))
+        "int_to_mini_roman" |->
+          closureVal("number", .ParamNames, intToMiniRomanBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1 andBool N <=Int 1000
+endmodule
