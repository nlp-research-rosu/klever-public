index 0000000000000000000000000000000000000000..2b65002ac09f8c8887a062f799f925adefbf7206
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,35 @@
+def int_to_mini_roman(number):
+    if number >= 1000:
+        return "m"
+    if number >= 900:
+        return "cm" + int_to_mini_roman(number - 900)
+    if number >= 500:
+        return "d" + int_to_mini_roman(number - 500)
+    if number >= 400:
+        return "cd" + int_to_mini_roman(number - 400)
+    if number >= 100:
+        return "c" + int_to_mini_roman(number - 100)
+    if number >= 90:
+        return "xc" + int_to_mini_roman(number - 90)
+    if number >= 50:
+        return "l" + int_to_mini_roman(number - 50)
+    if number >= 40:
+        return "xl" + int_to_mini_roman(number - 40)
+    if number >= 10:
+        return "x" + int_to_mini_roman(number - 10)
+    if number >= 9:
+        return "ix" + int_to_mini_roman(number - 9)
+    if number >= 5:
+        return "v" + int_to_mini_roman(number - 5)
+    if number >= 4:
+        return "iv" + int_to_mini_roman(number - 4)
+    if number >= 1:
+        return "i" + int_to_mini_roman(number - 1)
+    return ""
+
+
+sample_19 = int_to_mini_roman(19)
+sample_152 = int_to_mini_roman(152)
+sample_426 = int_to_mini_roman(426)
+boundary_1 = int_to_mini_roman(1)
+boundary_1000 = int_to_mini_roman(1000)
