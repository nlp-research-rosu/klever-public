+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Recursive frame invariant / exact auxiliary execution theorem.  It starts
+  // after parameter binding and ends after the ordinary #pop rule restores the
+  // caller.  The continuation and all older frames/scopes are preserved.
+  claim [roman-body]:
+    <k>
+      intToMiniRomanBody ~> #endcall
+      =>
+      str(romanCodes(N)) ~> CONT
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "int_to_mini_roman" |->
+          closureVal("number", .ParamNames, intToMiniRomanBody, 0)
+        MOD:Map,
+        parent(-1))
+      L |-> scope("number" |-> N, parent(0))
+      REST:Map
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "int_to_mini_roman" |->
+          closureVal("number", .ParamNames, intToMiniRomanBody, 0)
+        MOD,
+        parent(-1))
+      REST
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(CONT:K, CALLER, L)) STACK:List
+      =>
+      STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0 andBool N <=Int 1000
+
+  // Universal entry claim over the prompt's complete finite input domain.
+  claim [roman-domain]:
+    <k> #loadAll(solutionCall(N:Int)) => .K </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "__result" |-> str(romanCodes(N))
+        "int_to_mini_roman" |->
+          closureVal("number", .ParamNames, intToMiniRomanBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1 andBool N <=Int 1000
+endmodule
