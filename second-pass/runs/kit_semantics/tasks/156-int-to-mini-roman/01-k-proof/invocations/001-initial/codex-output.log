index 0000000000000000000000000000000000000000..d3cdc26f9eea0249b124b2dceb7a3f5ddb88336d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def int_to_mini_roman(number):
+    hundreds = (
+        "", "c", "cc", "ccc", "cd", "d", "dc", "dcc", "dccc", "cm"
+    )[(number % 1000) // 100]
+    tens = (
+        "", "x", "xx", "xxx", "xl", "l", "lx", "lxx", "lxxx", "xc"
+    )[(number % 100) // 10]
+    ones = (
+        "", "i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix"
+    )[number % 10]
+    if number == 1000:
+        return "m"
+    return hundreds + tens + ones
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..75e03fe1078b169777514ed173b787061abb3239
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal entry claim over the prompt's complete finite input domain.
+  claim [roman-domain]:
+    <k> #loadAll(solutionCall(N:Int)) => .K </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "__result" |-> str(miniRomanCodes(N))
+        "int_to_mini_roman" |->
+          closureVal("number", .ParamNames, intToMiniRomanBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1 andBool N <=Int 1000
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..054338e2ad9e022e239411f6e30c6c1878823cad
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,54 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Parse-time aliases for the exact py2mpy translation and a call harness.
+  // Macro expansion happens before execution; it adds no operational rule.
+  syntax Stmts ::= "intToMiniRomanBody" [macro]
+  syntax Module ::= "solutionModule" [macro]
+                  | "solutionCall" "(" Int ")" [macro]
+
+  rule intToMiniRomanBody
+    => Assign(
+         Name("hundreds"),
+         Subscript(
+           TupleExpr(
+             Str(""), Str("c"), Str("cc"), Str("ccc"), Str("cd"),
+             Str("d"), Str("dc"), Str("dcc"), Str("dccc"), Str("cm")),
+           BinOp("//", BinOp("%", Name("number"), Int(1000)), Int(100))))
+       Assign(
+         Name("tens"),
+         Subscript(
+           TupleExpr(
+             Str(""), Str("x"), Str("xx"), Str("xxx"), Str("xl"),
+             Str("l"), Str("lx"), Str("lxx"), Str("lxxx"), Str("xc")),
+           BinOp("//", BinOp("%", Name("number"), Int(100)), Int(10))))
+       Assign(
+         Name("ones"),
+         Subscript(
+           TupleExpr(
+             Str(""), Str("i"), Str("ii"), Str("iii"), Str("iv"),
+             Str("v"), Str("vi"), Str("vii"), Str("viii"), Str("ix")),
+           BinOp("%", Name("number"), Int(10))))
+       If(Compare(Name("number"), CmpOp("==", Int(1000))),
+         Return(Str("m")),
+         .Stmts)
+       Return(
+         BinOp(
+           "+",
+           BinOp("+", Name("hundreds"), Name("tens")),
+           Name("ones")))
+
+  rule solutionModule
+    => Module(
+         FuncDef("int_to_mini_roman", Params("number"),
+           intToMiniRomanBody))
+
+  rule solutionCall(N:Int)
+    => Module(
+         FuncDef("int_to_mini_roman", Params("number"),
+           intToMiniRomanBody)
+         Assign(Name("__result"),
+           Call(Name("int_to_mini_roman"), Int(N))))
+endmodule

