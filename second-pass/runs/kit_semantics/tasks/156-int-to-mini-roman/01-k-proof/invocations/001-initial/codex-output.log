diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a1349aaa1602192be597c7ee98070f7448dd0f2b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,120 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax IntSeq ::= romanCodes(Int) [function, total]
+
+  rule romanCodes(N) => strToCodes("m")
+    requires N >=Int 1000
+  rule romanCodes(N) => seqConcat(strToCodes("cm"), romanCodes(N -Int 900))
+    requires N >=Int 900 andBool N <Int 1000
+  rule romanCodes(N) => seqConcat(strToCodes("d"), romanCodes(N -Int 500))
+    requires N >=Int 500 andBool N <Int 900
+  rule romanCodes(N) => seqConcat(strToCodes("cd"), romanCodes(N -Int 400))
+    requires N >=Int 400 andBool N <Int 500
+  rule romanCodes(N) => seqConcat(strToCodes("c"), romanCodes(N -Int 100))
+    requires N >=Int 100 andBool N <Int 400
+  rule romanCodes(N) => seqConcat(strToCodes("xc"), romanCodes(N -Int 90))
+    requires N >=Int 90 andBool N <Int 100
+  rule romanCodes(N) => seqConcat(strToCodes("l"), romanCodes(N -Int 50))
+    requires N >=Int 50 andBool N <Int 90
+  rule romanCodes(N) => seqConcat(strToCodes("xl"), romanCodes(N -Int 40))
+    requires N >=Int 40 andBool N <Int 50
+  rule romanCodes(N) => seqConcat(strToCodes("x"), romanCodes(N -Int 10))
+    requires N >=Int 10 andBool N <Int 40
+  rule romanCodes(N) => seqConcat(strToCodes("ix"), romanCodes(N -Int 9))
+    requires N >=Int 9 andBool N <Int 10
+  rule romanCodes(N) => seqConcat(strToCodes("v"), romanCodes(N -Int 5))
+    requires N >=Int 5 andBool N <Int 9
+  rule romanCodes(N) => seqConcat(strToCodes("iv"), romanCodes(N -Int 4))
+    requires N >=Int 4 andBool N <Int 5
+  rule romanCodes(N) => seqConcat(strToCodes("i"), romanCodes(N -Int 1))
+    requires N >=Int 1 andBool N <Int 4
+  rule romanCodes(N) => .IntSeq
+    requires N <Int 1
+
+  // These are parse-time abbreviations only.  After macro expansion, the
+  // supplied semantics executes the exact translated function body.
+  syntax Stmts ::= "intToMiniRomanBody" [macro]
+  syntax Module ::= "solutionModule" [macro]
+                  | "solutionCall" "(" Int ")" [macro]
+
+  rule intToMiniRomanBody
+    => If(Compare(Name("number"), CmpOp(">=", Int(1000))),
+         Return(Str("m")),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(900))),
+         Return(BinOp("+", Str("cm"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(900))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(500))),
+         Return(BinOp("+", Str("d"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(500))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(400))),
+         Return(BinOp("+", Str("cd"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(400))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(100))),
+         Return(BinOp("+", Str("c"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(100))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(90))),
+         Return(BinOp("+", Str("xc"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(90))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(50))),
+         Return(BinOp("+", Str("l"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(50))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(40))),
+         Return(BinOp("+", Str("xl"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(40))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(10))),
+         Return(BinOp("+", Str("x"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(10))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(9))),
+         Return(BinOp("+", Str("ix"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(9))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(5))),
+         Return(BinOp("+", Str("v"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(5))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(4))),
+         Return(BinOp("+", Str("iv"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(4))))),
+         .Stmts)
+       If(Compare(Name("number"), CmpOp(">=", Int(1))),
+         Return(BinOp("+", Str("i"),
+           Call(Name("int_to_mini_roman"),
+             BinOp("-", Name("number"), Int(1))))),
+         .Stmts)
+       Return(Str(""))
+
+  rule solutionModule
+    => Module(
+         FuncDef("int_to_mini_roman", Params("number"),
+           intToMiniRomanBody))
+
+  rule solutionCall(N:Int)
+    => Module(
+         FuncDef("int_to_mini_roman", Params("number"),
+           intToMiniRomanBody)
+         Assign(Name("__result"),
+           Call(Name("int_to_mini_roman"), Int(N))))
+endmodule

