+def int_to_mini_roman(number):
+    result = ""
+
+    thousands = number // 1000
+    hundreds = (number % 1000) // 100
+    tens = (number % 100) // 10
+    ones = number % 10
+
+    if thousands == 1:
+        result = result + "m"
+
+    if hundreds == 9:
+        result = result + "cm"
+    elif hundreds >= 5:
+        result = result + "d"
+        if hundreds >= 6:
+            result = result + "c"
+        if hundreds >= 7:
+            result = result + "c"
+        if hundreds >= 8:
+            result = result + "c"
+    elif hundreds == 4:
+        result = result + "cd"
+    else:
+        if hundreds >= 1:
+            result = result + "c"
+        if hundreds >= 2:
+            result = result + "c"
+        if hundreds >= 3:
+            result = result + "c"
+
+    if tens == 9:
+        result = result + "xc"
+    elif tens >= 5:
+        result = result + "l"
+        if tens >= 6:
+            result = result + "x"
+        if tens >= 7:
+            result = result + "x"
+        if tens >= 8:
+            result = result + "x"
+    elif tens == 4:
+        result = result + "xl"
+    else:
+        if tens >= 1:
+            result = result + "x"
+        if tens >= 2:
+            result = result + "x"
+        if tens >= 3:
+            result = result + "x"
+
+    if ones == 9:
+        result = result + "ix"
+    elif ones >= 5:
+        result = result + "v"
+        if ones >= 6:
+            result = result + "i"
+        if ones >= 7:
+            result = result + "i"
+        if ones >= 8:
+            result = result + "i"
+    elif ones == 4:
+        result = result + "iv"
+    else:
+        if ones >= 1:
+            result = result + "i"
+        if ones >= 2:
+            result = result + "i"
+        if ones >= 3:
+            result = result + "i"
+
+    return result
+
+
+sample_19 = int_to_mini_roman(19)
+sample_152 = int_to_mini_roman(152)
+sample_426 = int_to_mini_roman(426)
+boundary_1 = int_to_mini_roman(1)
+boundary_1000 = int_to_mini_roman(1000)
