from pathlib import Path

values = (1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1)
digits = ('m', 'cm', 'd', 'cd', 'c', 'xc', 'l', 'xl', 'x', 'ix', 'v', 'iv', 'i')

def oracle(number):
    out = ''
    for value, digit in zip(values, digits):
        count, number = divmod(number, value)
        out += digit * count
    return out

parts = [
    'requires \"verification.k\"\\n\\n',
    'module SPEC\\n',
    '  imports VERIFICATION\\n\\n',
    '  // Exhaustive finite-domain proof: one ground claim for every permitted input.\\n',
]
for n in range(1, 1001):
    expected = oracle(n)
    parts.append(f'''  claim [roman-{n:04d}]:
    <k> #loadAll(solutionCall({n})) => .K </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
      =>
      0 |-> scope(
        \"__result\" |-> str(strToCodes(\"{expected}\"))
        \"int_to_mini_roman\" |->
          closureVal(\"number\", .ParamNames, intToMiniRomanBody, 0),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

''')
parts.append('endmodule\\n')
Path('spec.k').write_text(''.join(parts), encoding='utf-8')
