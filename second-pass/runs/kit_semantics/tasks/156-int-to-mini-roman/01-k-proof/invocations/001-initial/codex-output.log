diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..c509f312a0d1587d23f353ac69d0f4b8866d6277
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,20 @@
+def int_to_mini_roman(number):
+    hundreds = (
+        "", "c", "cc", "ccc", "cd", "d", "dc", "dcc", "dccc", "cm"
+    )[(number % 1000) // 100]
+    tens = (
+        "", "x", "xx", "xxx", "xl", "l", "lx", "lxx", "lxxx", "xc"
+    )[(number % 100) // 10]
+    ones = (
+        "", "i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix"
+    )[number % 10]
+    if number == 1000:
+        return "m"
+    return hundreds + tens + ones
+
+
+sample_19 = int_to_mini_roman(19)
+sample_152 = int_to_mini_roman(152)
+sample_426 = int_to_mini_roman(426)
+boundary_1 = int_to_mini_roman(1)
+boundary_1000 = int_to_mini_roman(1000)
