+        (ROOT / "concrete_tests.py").read_text(encoding="utf-8")
+    ).body[0]
+    if ast.dump(solution_ast) != ast.dump(concrete_ast):
+        fail("concrete_tests.py does not contain the exact solution function")
+
+    claim_re = re.compile(
+        r"claim \[roman-(\d{4})\]:"
