+    if [ -z "$labels" ]; then
+      labels="$label"
+    else
+      labels="$labels,$label"
+    fi
+  done
+
+  kprove spec.k \
+    --definition verification-kompiled \
+    --spec-module SPEC \
+    --claims "$labels" \
