--- /dev/null
+++ b/solution_mutant.py
@@ -0,0 +1,13 @@
+def int_to_mini_roman(number):
+    hundreds = (
+        "", "c", "cc", "ccc", "cd", "d", "dc", "dcc", "dccc", "cm"
+    )[(number % 1000) // 100]
+    tens = (
+        "", "x", "xx", "xxx", "xl", "l", "lx", "lxx", "lxxx", "xc"
+    )[(number % 100) // 10]
+    ones = (
+        "", "i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix"
+    )[number % 10]
+    if number == 1000:
+        return "x"
+    return hundreds + tens + ones
