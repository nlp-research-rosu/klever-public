/bin/bash -lc "cp /tmp/audit-work/verify_stage3_classification.py /audit-output/evidence/verify_stage3_classification.py
cp /tmp/audit-work/verify_recorded_hashes.py /audit-output/evidence/verify_recorded_hashes.py
