diff --git a//tmp/audit-work/work/auditor-concrete.py b//tmp/audit-work/work/auditor-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..612b7bd8a58e695730ad1a77f6ed55a32ba6bd8e
--- /dev/null
+++ b//tmp/audit-work/work/auditor-concrete.py
@@ -0,0 +1,18 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
+
+
+assert filter_by_prefix([], "a") == []
+assert filter_by_prefix(["abc", "bcd", "cde", "array"], "a") == ["abc", "array"]
+assert filter_by_prefix(["", "x", "xy"], "") == ["", "x", "xy"]
+assert filter_by_prefix(["abc", "ab", "abcd"], "abc") == ["abc", "abcd"]
+assert filter_by_prefix(["abc"], "abcd") == []
+assert filter_by_prefix(["a0", "a\n", "b", "\x00a"], "a") == ["a0", "a\n"]
