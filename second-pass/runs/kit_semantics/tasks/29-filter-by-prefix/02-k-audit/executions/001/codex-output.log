+                  Name("string"))))
+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(
+             vCons(
+               str(strToCodes("abc")),
+               vCons(
+                 str(strToCodes("bcd")),
+                 .ValSeq))),
+           str(strToCodes("a")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    Assign(Name("result"), ListExpr(.Exprs))
+                    Assign(Name("string"), Str(""))
+                    For(
+                      Name("string"),
+                      Name("strings"),
+                      Expr(
+                        Call(
+                          Attribute(Name("result"), "append"),
+                          Name("string"))))
+                    Return(Name("result")),
+                    0),
