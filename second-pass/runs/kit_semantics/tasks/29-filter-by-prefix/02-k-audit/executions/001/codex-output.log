diff --git a//tmp/audit-work/work/auditor-body-sensitivity.k b//tmp/audit-work/work/auditor-body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..c87fe4206056a1b4e9eadac9c23972dc07ceffee
--- /dev/null
+++ b//tmp/audit-work/work/auditor-body-sensitivity.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module AUDITOR-BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // The actual loaded and closure-bound body appends unconditionally.
+  // The original filtered postcondition must therefore fail.
+  claim [unconditional-append]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "filter_by_prefix",
+            Params("strings", "prefix"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              Expr(
+                Call(
+                  Attribute(Name("result"), "append"),
+                  Name("string"))))
+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(
+             vCons(
+               str(strToCodes("abc")),
+               vCons(
+                 str(strToCodes("bcd")),
+                 .ValSeq))),
+           str(strToCodes("a")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    Assign(Name("result"), ListExpr(.Exprs))
+                    Assign(Name("string"), Str(""))
+                    For(
+                      Name("string"),
+                      Name("strings"),
+                      Expr(
+                        Call(
+                          Attribute(Name("result"), "append"),
+                          Name("string"))))
+                    Return(Name("result")),
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           vCons(
+             str(strToCodes("abc")),
+             .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/work/auditor-concrete.py b//tmp/audit-work/work/auditor-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..612b7bd8a58e695730ad1a77f6ed55a32ba6bd8e
--- /dev/null
+++ b//tmp/audit-work/work/auditor-concrete.py
@@ -0,0 +1,18 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
+
+
+assert filter_by_prefix([], "a") == []
+assert filter_by_prefix(["abc", "bcd", "cde", "array"], "a") == ["abc", "array"]
+assert filter_by_prefix(["", "x", "xy"], "") == ["", "x", "xy"]
+assert filter_by_prefix(["abc", "ab", "abcd"], "abc") == ["abc", "abcd"]
+assert filter_by_prefix(["abc"], "abcd") == []
+assert filter_by_prefix(["a0", "a\n", "b", "\x00a"], "a") == ["a0", "a\n"]
diff --git a//tmp/audit-work/work/auditor-false-result.k b//tmp/audit-work/work/auditor-false-result.k
new file mode 100644
index 0000000000000000000000000000000000000000..e2767cd95feb244f19bd8471f945cf7d2046520f
--- /dev/null
+++ b//tmp/audit-work/work/auditor-false-result.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module AUDITOR-FALSE-RESULT
+  imports VERIFICATION
+
+  // Fresh auditor mutation: ["abc", "bcd"] filtered by "a" cannot be empty.
+  claim [wrong-empty-result]:
+    <k>
+      #loadAll(filterByPrefixProgram)
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(
+             vCons(
+               str(strToCodes("abc")),
+               vCons(
+                 str(strToCodes("bcd")),
+                 .ValSeq))),
+           str(strToCodes("a")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    filterFunctionBody,
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/work/auditor-ground-witness.k b//tmp/audit-work/work/auditor-ground-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..4fe39f85e373b7a8fe8a18671645cbfbea3c23bd
--- /dev/null
+++ b//tmp/audit-work/work/auditor-ground-witness.k
@@ -0,0 +1,100 @@
+requires "verification.k"
+
+module AUDITOR-GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [loop-satisfiable]:
+    <k>
+      #loop(
+        list(
+          vCons(
+            str(strToCodes("abc")),
+            vCons(
+              str(strToCodes("bcd")),
+              .ValSeq))),
+        Name("string"),
+        filterLoopBody)
+      ~> (Return(Name("result")) .Stmts):Stmts
+      ~> #endcall
+      => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (.Map
+       1 |-> scope(
+              "strings" |->
+                list(
+                  vCons(
+                    str(strToCodes("abc")),
+                    vCons(
+                      str(strToCodes("bcd")),
+                      .ValSeq)))
+              "prefix" |-> str(strToCodes("a"))
+              "result" |-> ref(0)
+              "string" |-> str(.IntSeq),
+              parent(0)))
+      => .Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(
+             vCons(
+               str(strToCodes("seed")),
+               .ValSeq)
+             =>
+             vCons(
+               str(strToCodes("seed")),
+               vCons(
+                 str(strToCodes("abc")),
+                 .ValSeq)))
