+                      str(strToCodes("bcd")),
+                      .ValSeq)))
+              "prefix" |-> str(strToCodes("a"))
+              "result" |-> ref(0)
+              "string" |-> str(.IntSeq),
+              parent(0)))
+      => .Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(
+             vCons(
+               str(strToCodes("seed")),
+               .ValSeq)
+             =>
+             vCons(
+               str(strToCodes("seed")),
+               vCons(
+                 str(strToCodes("abc")),
+                 .ValSeq)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
