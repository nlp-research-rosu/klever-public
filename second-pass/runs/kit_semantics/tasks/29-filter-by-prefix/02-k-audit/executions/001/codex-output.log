+                  closureVal(
+                    ("strings", "prefix"),
+                    Assign(Name("result"), ListExpr(.Exprs))
+                    Assign(Name("string"), Str(""))
+                    For(
+                      Name("string"),
+                      Name("strings"),
+                      Expr(
+                        Call(
+                          Attribute(Name("result"), "append"),
+                          Name("string"))))
+                    Return(Name("result")),
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
