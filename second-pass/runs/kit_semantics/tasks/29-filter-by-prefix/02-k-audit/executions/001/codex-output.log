+find \
+  /candidate \
+  /reference \
+  /generation-evidence \
+  /audit-input.json \
+  /audit-campaign-lock.json \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  -type l -printf 'SYMLINK %p -> %l\n'
+
+echo
+echo 'SCRIPT_EXIT: 0'
