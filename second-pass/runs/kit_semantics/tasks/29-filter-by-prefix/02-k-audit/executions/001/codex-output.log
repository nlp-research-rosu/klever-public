+requires "verification.k"
+
+module AUDITOR-BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // The actual loaded and closure-bound body appends unconditionally.
+  // The original filtered postcondition must therefore fail.
+  claim [unconditional-append]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "filter_by_prefix",
+            Params("strings", "prefix"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              Expr(
+                Call(
+                  Attribute(Name("result"), "append"),
+                  Name("string"))))
+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(
+             vCons(
+               str(strToCodes("abc")),
+               vCons(
+                 str(strToCodes("bcd")),
+                 .ValSeq))),
+           str(strToCodes("a")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    Assign(Name("result"), ListExpr(.Exprs))
+                    Assign(Name("string"), Str(""))
+                    For(
+                      Name("string"),
+                      Name("strings"),
+                      Expr(
+                        Call(
+                          Attribute(Name("result"), "append"),
+                          Name("string"))))
+                    Return(Name("result")),
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           vCons(
+             str(strToCodes("abc")),
+             .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/work/auditor-concrete.py b//tmp/audit-work/work/auditor-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..612b7bd8a58e695730ad1a77f6ed55a32ba6bd8e
--- /dev/null
+++ b//tmp/audit-work/work/auditor-concrete.py
@@ -0,0 +1,18 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
+
+
+assert filter_by_prefix([], "a") == []
+assert filter_by_prefix(["abc", "bcd", "cde", "array"], "a") == ["abc", "array"]
+assert filter_by_prefix(["", "x", "xy"], "") == ["", "x", "xy"]
+assert filter_by_prefix(["abc", "ab", "abcd"], "abc") == ["abc", "abcd"]
+assert filter_by_prefix(["abc"], "abcd") == []
+assert filter_by_prefix(["a0", "a\n", "b", "\x00a"], "a") == ["a0", "a\n"]
