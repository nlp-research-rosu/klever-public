diff --git a/domain.k b/domain.k
new file mode 100644
index 0000000000000000000000000000000000000000..1b96cb79b7212232ec967f5ae66a5ce2a56743b3
--- /dev/null
+++ b/domain.k
@@ -0,0 +1,19 @@
+requires "reference-semantics/semantics.k"
+
+module STRING-SEQUENCE-DOMAIN
+  imports MPY
+
+  // Total projection used only to expose the unique code sequence of a string
+  // value.  The default makes every non-string unequal to str(stringCodes(V)).
+  syntax IntSeq ::= stringCodes(Val) [function, total]
+  rule stringCodes(str(S:IntSeq)) => S
+  rule stringCodes(_:Val) => .IntSeq [owise]
+
+  syntax Bool ::= isStringVal(Val) [function, total]
+  rule isStringVal(V:Val) => V ==K str(stringCodes(V))
+
+  syntax Bool ::= allStrings(ValSeq) [function, total]
+  rule allStrings(.ValSeq) => true
+  rule allStrings(vCons(V:Val, REST:ValSeq))
+    => isStringVal(V) andBool allStrings(REST)
+endmodule
diff --git a/loop-connection-spec.k b/loop-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6c1bd888ade95b27dd59216deee1e6daa746827
--- /dev/null
+++ b/loop-connection-spec.k
@@ -0,0 +1,39 @@
+requires "verification-core.k"
+
+module LOOP-CONNECTION-SPEC
+  imports VERIFICATION-CORE
+
+  claim [filter-loop-connection]:
+    <k>
+      #loop(
+        list(INPUT:ValSeq),
+        Name("string"),
+        filterLoopBody)
+      ~> (Return(Name("result")) .Stmts):Stmts
+      ~> #endcall
+      => ref(H:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(
+              "strings" |-> list(ORIGINAL:ValSeq)
+              "prefix" |-> str(P:IntSeq)
+              "result" |-> ref(H)
+              "string" |-> str(OLD:IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      HP:Map
+      H |-> list(
+             ACC:ValSeq
+             => filterPrefixAcc(ACC, INPUT, P))
+    </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allStrings(INPUT)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..401cfb8284d04d1d94275a4a33cd0f469c5a0f77
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
