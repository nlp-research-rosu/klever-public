diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..910cd06f00d78564505c497b9077539f94c418ff
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,18 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
+
+
+assert filter_by_prefix([], "a") == []
+assert filter_by_prefix(["abc", "bcd", "cde", "array"], "a") == [
+    "abc",
+    "array",
+]
+assert filter_by_prefix(["x", "", "xy"], "") == ["x", "", "xy"]
