diff --git a//tmp/overload-test.k b//tmp/overload-test.k
new file mode 100644
index 0000000000000000000000000000000000000000..bbef76119e7df36b93d567222d9334f286a1afd2
--- /dev/null
+++ b//tmp/overload-test.k
@@ -0,0 +1,18 @@
+requires "/workspace/reference-semantics/semantics.k"
+
+module OVERLOAD-TEST
+  imports MPY
+
+  syntax StrValSeq
+  syntax ValSeq ::= StrValSeq
+
+  syntax StrValSeq ::= ".ValSeq" [overload(str-list-unit)]
+  syntax ValSeq    ::= ".ValSeq" [overload(str-list-unit)]
+
+  syntax StrValSeq ::= vCons(Str, StrValSeq) [overload(str-list-cons)]
+  syntax ValSeq    ::= vCons(Val, ValSeq)     [overload(str-list-cons)]
+
+  syntax Bool ::= typed(StrValSeq) [function, total]
+  rule typed(.ValSeq) => true
+  rule typed(vCons(str(_:IntSeq), R:StrValSeq)) => typed(R)
+endmodule
diff --git a/body-mutant.k b/body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..e44a82c54eb0dca054ac7aff03c001fb5c9c45ca
--- /dev/null
+++ b/body-mutant.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module BODY-MUTANT
+  imports VERIFICATION
+
+  syntax Stmts ::= "mutantLoopBody" [macro]
+  rule mutantLoopBody
+    => Expr(
+         Call(
+           Attribute(Name("result"), "append"),
+           Name("string")))
+
+  syntax Stmts ::= "mutantFunctionBody" [macro]
+  rule mutantFunctionBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("string"), Str(""))
+       For(Name("string"), Name("strings"), mutantLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterByPrefixMutantProgram" [macro]
+  rule filterByPrefixMutantProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef(
+           "filter_by_prefix",
+           Params("strings", "prefix"),
+           mutantFunctionBody))
+endmodule
