+    <scopes>
+      (SC:Map
+       1 |-> scope(
+              "strings" |-> list(ORIGINAL:ValSeq)
+              "prefix" |-> str(P:IntSeq)
+              "result" |-> ref(H)
+              "string" |-> str(OLD:IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
