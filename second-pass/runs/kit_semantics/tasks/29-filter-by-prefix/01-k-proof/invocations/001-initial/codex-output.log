+requires "/workspace/reference-semantics/semantics.k"
+
+module OVERLOAD-TEST
+  imports MPY
+
+  syntax StrValSeq
+  syntax ValSeq ::= StrValSeq
+
+  syntax StrValSeq ::= ".ValSeq" [overload(str-list-unit)]
+  syntax ValSeq    ::= ".ValSeq" [overload(str-list-unit)]
+
+  syntax StrValSeq ::= vCons(Str, StrValSeq) [overload(str-list-cons)]
+  syntax ValSeq    ::= vCons(Val, ValSeq)     [overload(str-list-cons)]
+
+  syntax Bool ::= typed(StrValSeq) [function, total]
+  rule typed(.ValSeq) => true
+  rule typed(vCons(str(_:IntSeq), R:StrValSeq)) => typed(R)
+endmodule
