+requires "reference-semantics/semantics.k"
+
+module STRING-SEQUENCE-DOMAIN
+  imports MPY
+
+  // A constructor-level representation of exactly the finite semantic lists
+  // whose elements are strings.
+  syntax StrSeq ::= ".StrSeq" | sCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strSeqVals(StrSeq) [function, total]
+  rule strSeqVals(.StrSeq) => .ValSeq
