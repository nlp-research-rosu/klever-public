+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    filterFunctionBody,
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           filterPrefixAcc(.ValSeq, INPUT, PREFIX))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allStrings(INPUT)
