diff --git a//tmp/overload-test.k b//tmp/overload-test.k
new file mode 100644
index 0000000000000000000000000000000000000000..bbef76119e7df36b93d567222d9334f286a1afd2
--- /dev/null
+++ b//tmp/overload-test.k
@@ -0,0 +1,18 @@
+requires "/workspace/reference-semantics/semantics.k"
+
+module OVERLOAD-TEST
+  imports MPY
+
+  syntax StrValSeq
+  syntax ValSeq ::= StrValSeq
+
+  syntax StrValSeq ::= ".ValSeq" [overload(str-list-unit)]
+  syntax ValSeq    ::= ".ValSeq" [overload(str-list-unit)]
+
+  syntax StrValSeq ::= vCons(Str, StrValSeq) [overload(str-list-cons)]
+  syntax ValSeq    ::= vCons(Val, ValSeq)     [overload(str-list-cons)]
+
+  syntax Bool ::= typed(StrValSeq) [function, total]
+  rule typed(.ValSeq) => true
+  rule typed(vCons(str(_:IntSeq), R:StrValSeq)) => typed(R)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..401cfb8284d04d1d94275a4a33cd0f469c5a0f77
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..47b3e0ed96b495810202348cac86be2e1cfc1356
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(INPUT:ValSeq),
+        Name("string"),
+        filterLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => ref(H:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(
+              "strings" |-> list(ORIGINAL:ValSeq)
+              "prefix" |-> str(P:IntSeq)
+              "result" |-> ref(H)
+              "string" |-> str(OLD:IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      HP:Map
+      H |-> list(
+             ACC:ValSeq
+             => filterPrefixAcc(
+                  ACC,
+                  INPUT,
+                  P))
+    </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allStrings(INPUT)
+
+  claim [filter-program]:
+    <k>
+      #loadAll(filterByPrefixProgram)
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(INPUT:ValSeq),
+           str(PREFIX:IntSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    filterFunctionBody,
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           filterPrefixAcc(.ValSeq, INPUT, PREFIX))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allStrings(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b754a3b41ff8611b69748948cc593745c21e7709
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact AST fragments shared by the entry and loop claims.
+  syntax Stmts ::= "filterLoopBody" [macro]
+  rule filterLoopBody
+    => If(
+         Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+         Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+         .Stmts)
+
+  syntax Stmts ::= "filterFunctionBody" [macro]
+  rule filterFunctionBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("string"), Str(""))
+       For(Name("string"), Name("strings"), filterLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterByPrefixProgram" [macro]
+  rule filterByPrefixProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef(
+           "filter_by_prefix",
+           Params("strings", "prefix"),
+           filterFunctionBody))
+
+  // A total projection makes the string-domain fact visible as constructor
+  // equality.  The default is irrelevant for strings and makes non-strings
+  // compare unequal to the `str(...)` constructor.
+  syntax IntSeq ::= stringCodes(Val) [function, total]
+  rule stringCodes(str(S:IntSeq)) => S
+  rule stringCodes(_:Val) => .IntSeq [owise]
+
+  syntax Bool ::= isStringVal(Val) [function, total]
+  rule isStringVal(V:Val) => V ==K str(stringCodes(V))
+
+  syntax Bool ::= allStrings(ValSeq) [function, total]
+  rule allStrings(.ValSeq) => true
+  rule allStrings(vCons(V:Val, REST:ValSeq))
+    => isStringVal(V) andBool allStrings(REST)
+
+  // Stable prefix filter with an explicit accumulator.  The second argument
+  // strictly shrinks, and the two startsWith guards are complementary.
+  syntax ValSeq ::= filterPrefixAcc(ValSeq, ValSeq, IntSeq) [function]
+  rule filterPrefixAcc(ACC:ValSeq, .ValSeq, _:IntSeq) => ACC
+  rule filterPrefixAcc(
+         ACC:ValSeq,
+         vCons(str(S:IntSeq), REST:ValSeq),
+         P:IntSeq)
+    => filterPrefixAcc(
+         valSeqConcat(ACC, vCons(str(S), .ValSeq)),
+         REST,
+         P)
+    requires startsWith(P, S)
+  rule filterPrefixAcc(
+         ACC:ValSeq,
+         vCons(str(S:IntSeq), REST:ValSeq),
+         P:IntSeq)
+    => filterPrefixAcc(ACC, REST, P)
+    requires notBool startsWith(P, S)
+
+  // The function-call semantics has already performed this deletion.  This
+  // derived map identity exposes its normal form to the symbolic simplifier.
+  rule ((1 |-> _:Scope) SC:Map)[1 <- undef] => SC
+    requires notBool (1 in_keys(SC))
+    [simplification]
+endmodule

codex
K’s overload experiment compiled but produced distinct constructors, so I’m discarding it—it would not be the reference semantics’ list representation. A sound path remains: keep the explicit string-sequence encoding, but split the single logical invariant into its empty and nonempty constructor cases. Each case’s conversion unfolds before fixed execution, and the nonempty claim recurs after real loop progress; no iterator rule or program term is intercepted.
apply patch
patch: completed
