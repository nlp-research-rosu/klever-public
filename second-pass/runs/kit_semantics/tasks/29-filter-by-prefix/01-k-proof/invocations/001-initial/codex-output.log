+       1 |-> scope(
+              "strings" |->
+                list(
+                  vCons(
+                    str(strToCodes("bcd")),
+                    .ValSeq))
+              "prefix" |-> str(strToCodes("a"))
+              "result" |-> ref(0)
+              "string" |-> str(.IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
