diff --git a/spec-body-mutant.k b/spec-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..cf4d63f0fa434cbea3e388f237c4d7c5e881ad70
--- /dev/null
+++ b/spec-body-mutant.k
@@ -0,0 +1,69 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTANT
+  imports VERIFICATION
+
+  syntax Stmts ::= "mutantLoopBody" [macro]
+  rule mutantLoopBody
+    => Expr(
+         Call(
+           Attribute(Name("result"), "append"),
+           Name("string")))
+
+  syntax Stmts ::= "mutantFunctionBody" [macro]
+  rule mutantFunctionBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("string"), Str(""))
+       For(Name("string"), Name("strings"), mutantLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterByPrefixMutantProgram" [macro]
+  rule filterByPrefixMutantProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef(
+           "filter_by_prefix",
+           Params("strings", "prefix"),
+           mutantFunctionBody))
+
+  // The mutant appends "bcd" unconditionally, so the original filtered
+  // postcondition must be rejected.
+  claim [unconditional-append-mutant]:
+    <k>
+      #loadAll(filterByPrefixMutantProgram)
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(
+             vCons(
+               str(strToCodes("abc")),
+               vCons(
+                 str(strToCodes("bcd")),
+                 .ValSeq))),
+           str(strToCodes("a")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    mutantFunctionBody,
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           vCons(
+             str(strToCodes("abc")),
+             .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
