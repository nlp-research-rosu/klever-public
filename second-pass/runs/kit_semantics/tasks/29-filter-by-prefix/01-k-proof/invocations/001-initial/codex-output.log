diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..910cd06f00d78564505c497b9077539f94c418ff
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,18 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
+
+
+assert filter_by_prefix([], "a") == []
+assert filter_by_prefix(["abc", "bcd", "cde", "array"], "a") == [
+    "abc",
+    "array",
+]
+assert filter_by_prefix(["x", "", "xy"], "") == ["x", "", "xy"]
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..97e4d8d10562b62f2fd2078c5f653a34e6066118
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,16 @@
+requires "domain.k"
+
+module CONNECTION-SPEC
+  imports STRING-SEQUENCE-DOMAIN
+
+  claim [string-iterator-normalization]:
+    <k>
+      #iterNext(list(vCons(V:Val, REST:ValSeq))) ~> CONT:K
+      =>
+      #iterYield(
+        str(stringCodes(V)),
+        list(REST))
+      ~> CONT
+    </k>
+    requires isStringVal(V)
+endmodule
diff --git a/domain.k b/domain.k
new file mode 100644
index 0000000000000000000000000000000000000000..1b96cb79b7212232ec967f5ae66a5ce2a56743b3
--- /dev/null
+++ b/domain.k
@@ -0,0 +1,19 @@
+requires "reference-semantics/semantics.k"
+
+module STRING-SEQUENCE-DOMAIN
+  imports MPY
+
+  // Total projection used only to expose the unique code sequence of a string
+  // value.  The default makes every non-string unequal to str(stringCodes(V)).
+  syntax IntSeq ::= stringCodes(Val) [function, total]
+  rule stringCodes(str(S:IntSeq)) => S
+  rule stringCodes(_:Val) => .IntSeq [owise]
+
+  syntax Bool ::= isStringVal(Val) [function, total]
+  rule isStringVal(V:Val) => V ==K str(stringCodes(V))
+
+  syntax Bool ::= allStrings(ValSeq) [function, total]
+  rule allStrings(.ValSeq) => true
+  rule allStrings(vCons(V:Val, REST:ValSeq))
+    => isStringVal(V) andBool allStrings(REST)
+endmodule
diff --git a/loop-connection-spec.k b/loop-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6c1bd888ade95b27dd59216deee1e6daa746827
--- /dev/null
+++ b/loop-connection-spec.k
@@ -0,0 +1,39 @@
+requires "verification-core.k"
+
+module LOOP-CONNECTION-SPEC
+  imports VERIFICATION-CORE
+
+  claim [filter-loop-connection]:
+    <k>
+      #loop(
+        list(INPUT:ValSeq),
+        Name("string"),
+        filterLoopBody)
+      ~> (Return(Name("result")) .Stmts):Stmts
+      ~> #endcall
+      => ref(H:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(
+              "strings" |-> list(ORIGINAL:ValSeq)
+              "prefix" |-> str(P:IntSeq)
+              "result" |-> ref(H)
+              "string" |-> str(OLD:IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      HP:Map
+      H |-> list(
+             ACC:ValSeq
+             => filterPrefixAcc(ACC, INPUT, P))
+    </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allStrings(INPUT)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..401cfb8284d04d1d94275a4a33cd0f469c5a0f77
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
diff --git a/spec-body-mutant.k b/spec-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..cf4d63f0fa434cbea3e388f237c4d7c5e881ad70
--- /dev/null
+++ b/spec-body-mutant.k
@@ -0,0 +1,69 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTANT
+  imports VERIFICATION
+
+  syntax Stmts ::= "mutantLoopBody" [macro]
+  rule mutantLoopBody
+    => Expr(
+         Call(
+           Attribute(Name("result"), "append"),
+           Name("string")))
+
+  syntax Stmts ::= "mutantFunctionBody" [macro]
+  rule mutantFunctionBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("string"), Str(""))
+       For(Name("string"), Name("strings"), mutantLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterByPrefixMutantProgram" [macro]
+  rule filterByPrefixMutantProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef(
+           "filter_by_prefix",
+           Params("strings", "prefix"),
+           mutantFunctionBody))
+
+  // The mutant appends "bcd" unconditionally, so the original filtered
+  // postcondition must be rejected.
+  claim [unconditional-append-mutant]:
+    <k>
+      #loadAll(filterByPrefixMutantProgram)
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(
+             vCons(
+               str(strToCodes("abc")),
+               vCons(
+                 str(strToCodes("bcd")),
+                 .ValSeq))),
+           str(strToCodes("a")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    mutantFunctionBody,
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           vCons(
+             str(strToCodes("abc")),
+             .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
