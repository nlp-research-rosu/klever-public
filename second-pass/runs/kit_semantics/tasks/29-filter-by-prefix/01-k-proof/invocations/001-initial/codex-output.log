+      ~> Return(Name("result"))
+      ~> #endcall
+      => ref(H:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(
+              "strings" |-> list(ORIGINAL:ValSeq)
+              "prefix" |-> str(P:IntSeq)
+              "result" |-> ref(H)
+              "string" |-> str(OLD:IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
