diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..97e4d8d10562b62f2fd2078c5f653a34e6066118
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,16 @@
+requires "domain.k"
+
+module CONNECTION-SPEC
+  imports STRING-SEQUENCE-DOMAIN
+
+  claim [string-iterator-normalization]:
+    <k>
+      #iterNext(list(vCons(V:Val, REST:ValSeq))) ~> CONT:K
+      =>
+      #iterYield(
+        str(stringCodes(V)),
+        list(REST))
+      ~> CONT
+    </k>
+    requires isStringVal(V)
+endmodule
diff --git a/domain.k b/domain.k
new file mode 100644
index 0000000000000000000000000000000000000000..1b96cb79b7212232ec967f5ae66a5ce2a56743b3
--- /dev/null
+++ b/domain.k
@@ -0,0 +1,19 @@
+requires "reference-semantics/semantics.k"
+
+module STRING-SEQUENCE-DOMAIN
+  imports MPY
+
+  // Total projection used only to expose the unique code sequence of a string
+  // value.  The default makes every non-string unequal to str(stringCodes(V)).
+  syntax IntSeq ::= stringCodes(Val) [function, total]
+  rule stringCodes(str(S:IntSeq)) => S
+  rule stringCodes(_:Val) => .IntSeq [owise]
+
+  syntax Bool ::= isStringVal(Val) [function, total]
+  rule isStringVal(V:Val) => V ==K str(stringCodes(V))
+
+  syntax Bool ::= allStrings(ValSeq) [function, total]
+  rule allStrings(.ValSeq) => true
+  rule allStrings(vCons(V:Val, REST:ValSeq))
+    => isStringVal(V) andBool allStrings(REST)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..401cfb8284d04d1d94275a4a33cd0f469c5a0f77
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..69ef862b2d3be1928a0c361f1b21fde79342dd31
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,72 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(INPUT:ValSeq),
+        Name("string"),
+        filterLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => ref(H:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(
+              "strings" |-> list(ORIGINAL:ValSeq)
+              "prefix" |-> str(P:IntSeq)
+              "result" |-> ref(H)
+              "string" |-> str(OLD:IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      HP:Map
+      H |-> list(
+             ACC:ValSeq
+             => filterPrefixAcc(ACC, INPUT, P))
+    </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allStrings(INPUT)
+
+  claim [filter-program]:
+    <k>
+      #loadAll(filterByPrefixProgram)
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(INPUT:ValSeq),
+           str(PREFIX:IntSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    filterFunctionBody,
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           filterPrefixAcc(.ValSeq, INPUT, PREFIX))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allStrings(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f54b7cd1580f6f9e1d9f34fe9e1dea5a565b1ea8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,73 @@
+requires "domain.k"
+
+module VERIFICATION
+  imports STRING-SEQUENCE-DOMAIN
+
+  // Exact AST fragments shared by the entry and loop claims.
+  syntax Stmts ::= "filterLoopBody" [macro]
+  rule filterLoopBody
+    => If(
+         Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+         Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+         .Stmts)
+
+  syntax Stmts ::= "filterFunctionBody" [macro]
+  rule filterFunctionBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("string"), Str(""))
+       For(Name("string"), Name("strings"), filterLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterByPrefixProgram" [macro]
+  rule filterByPrefixProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef(
+           "filter_by_prefix",
+           Params("strings", "prefix"),
+           filterFunctionBody))
+
+  // Stable prefix filter with an explicit accumulator.  It is totalized by
+  // projecting arbitrary off-domain values through stringCodes; on the
+  // theorem's allStrings domain that projection is the value's exact codes.
+  // The second argument strictly shrinks and the guards are complementary.
+  syntax ValSeq ::= filterPrefixAcc(ValSeq, ValSeq, IntSeq)
+                    [function, total]
+  rule filterPrefixAcc(ACC:ValSeq, .ValSeq, _:IntSeq) => ACC
+  rule filterPrefixAcc(
+         ACC:ValSeq,
+         vCons(V:Val, REST:ValSeq),
+         P:IntSeq)
+    => filterPrefixAcc(
+         valSeqConcat(
+           ACC,
+           vCons(str(stringCodes(V)), .ValSeq)),
+         REST,
+         P)
+    requires startsWith(P, stringCodes(V))
+    [simplification]
+  rule filterPrefixAcc(
+         ACC:ValSeq,
+         vCons(V:Val, REST:ValSeq),
+         P:IntSeq)
+    => filterPrefixAcc(ACC, REST, P)
+    requires notBool startsWith(P, stringCodes(V))
+    [simplification]
+
+  // Operational bridge justified by the bridge-free universal claim
+  // CONNECTION-SPEC.string-iterator-normalization.  It preserves the
+  // arbitrary continuation and touches no state cell.
+  rule <k>
+         #iterNext(list(vCons(V:Val, REST:ValSeq)))
+         => #iterYield(str(stringCodes(V)), list(REST))
+         ...
+       </k>
+    requires isStringVal(V)
+    [priority(40)]
+
+  // The function-call semantics has already performed this deletion.  This
+  // derived map identity exposes its normal form to the symbolic simplifier.
+  rule ((1 |-> _:Scope) SC:Map)[1 <- undef] => SC
+    requires notBool (1 in_keys(SC))
+    [simplification]
+endmodule

