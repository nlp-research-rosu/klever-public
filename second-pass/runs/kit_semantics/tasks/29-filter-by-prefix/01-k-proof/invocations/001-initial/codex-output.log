diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..401cfb8284d04d1d94275a4a33cd0f469c5a0f77
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8d28cc0a054324c6ff96c99d74823ac01d4fa03d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,112 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop-empty]:
+    <k>
+      #loop(
+        list(strSeqVals(.StrSeq)),
+        Name("string"),
+        filterLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => ref(H:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(
+              "strings" |-> list(strSeqVals(ORIGINAL:StrSeq))
+              "prefix" |-> str(P:IntSeq)
+              "result" |-> ref(H)
+              "string" |-> str(OLD:IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      HP:Map
+      H |-> list(
+             ACC:ValSeq
+             => filterPrefixAcc(
+                  ACC,
+                  strSeqVals(.StrSeq),
+                  P))
+    </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [filter-loop-step]:
+    <k>
+      #loop(
+        list(strSeqVals(sCons(S:IntSeq, REST:StrSeq))),
+        Name("string"),
+        filterLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => ref(H:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(
+              "strings" |-> list(strSeqVals(ORIGINAL:StrSeq))
+              "prefix" |-> str(P:IntSeq)
+              "result" |-> ref(H)
+              "string" |-> str(OLD:IntSeq),
+              parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      HP:Map
+      H |-> list(
+             ACC:ValSeq
+             => filterPrefixAcc(
+                  ACC,
+                  strSeqVals(sCons(S, REST)),
+                  P))
+    </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [filter-program]:
+    <k>
+      #loadAll(filterByPrefixProgram)
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(strSeqVals(INPUT:StrSeq)),
+           str(PREFIX:IntSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    filterFunctionBody,
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           filterPrefixAcc(
+             .ValSeq,
+             strSeqVals(INPUT),
+             PREFIX))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..724cd3dab047e739f7e1ecd8bcc4b58638f288f4
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,64 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact AST fragments shared by the entry and loop claims.
+  syntax Stmts ::= "filterLoopBody" [macro]
+  rule filterLoopBody
+    => If(
+         Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+         Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+         .Stmts)
+
+  syntax Stmts ::= "filterFunctionBody" [macro]
+  rule filterFunctionBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("string"), Str(""))
+       For(Name("string"), Name("strings"), filterLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterByPrefixProgram" [macro]
+  rule filterByPrefixProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef(
+           "filter_by_prefix",
+           Params("strings", "prefix"),
+           filterFunctionBody))
+
+  // A constructor-level representation of exactly the finite semantic lists
+  // whose elements are strings.
+  syntax StrSeq ::= ".StrSeq" | sCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strSeqVals(StrSeq) [function, total]
+  rule strSeqVals(.StrSeq) => .ValSeq
+  rule strSeqVals(sCons(S:IntSeq, REST:StrSeq))
+    => vCons(str(S), strSeqVals(REST))
+
+  // Stable prefix filter with an explicit accumulator.  The second argument
+  // strictly shrinks, and the two startsWith guards are complementary.
+  syntax ValSeq ::= filterPrefixAcc(ValSeq, ValSeq, IntSeq) [function]
+  rule filterPrefixAcc(ACC:ValSeq, .ValSeq, _:IntSeq) => ACC
+  rule filterPrefixAcc(
+         ACC:ValSeq,
+         vCons(str(S:IntSeq), REST:ValSeq),
+         P:IntSeq)
+    => filterPrefixAcc(
+         valSeqConcat(ACC, vCons(str(S), .ValSeq)),
+         REST,
+         P)
+    requires startsWith(P, S)
+  rule filterPrefixAcc(
+         ACC:ValSeq,
+         vCons(str(S:IntSeq), REST:ValSeq),
+         P:IntSeq)
+    => filterPrefixAcc(ACC, REST, P)
+    requires notBool startsWith(P, S)
+
+  // The function-call semantics has already performed this deletion.  This
+  // derived map identity exposes its normal form to the symbolic simplifier.
+  rule ((1 |-> _:Scope) SC:Map)[1 <- undef] => SC
+    requires notBool (1 in_keys(SC))
+    [simplification]
+endmodule

