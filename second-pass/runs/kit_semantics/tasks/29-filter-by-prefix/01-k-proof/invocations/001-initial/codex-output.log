+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allStrings(INPUT)
+
+  claim [filter-program]:
+    <k>
+      #loadAll(filterByPrefixProgram)
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(INPUT:ValSeq),
+           str(PREFIX:IntSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             .Map
+             => "filter_by_prefix" |->
+                  closureVal(
+                    ("strings", "prefix"),
+                    filterFunctionBody,
+                    0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           filterPrefixAcc(.ValSeq, INPUT, PREFIX))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
