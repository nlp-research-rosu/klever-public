+stage3_bindings= {"export": true, "generator": true, "input": true}
+inventory_bindings= {"generator": "769426b2163a87c782102e56a3bed0a12ffc57f4f5045ad2ec51f22e842de036", "input": "769426b2163a87c782102e56a3bed0a12ffc57f4f5045ad2ec51f22e842de036", "stage3": "769426b2163a87c782102e56a3bed0a12ffc57f4f5045ad2ec51f22e842de036"}
