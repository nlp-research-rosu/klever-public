+print('ID_SET_IDENTICAL=' + str({r['source_rule_id'] for r in inv['rules']} == {r['source_rule_id'] for r in stage3['rules']}))
+print('RECONSTRUCTED_UNIQUE=' + str(len({r['source_rule_id'] for r in inv['rules']}) == len(inv['rules'])))
+print('STAGE3_UNIQUE=' + str(len({r['source_rule_id'] for r in stage3['rules']}) == len(stage3['rules'])))
+print('CONTRACT_VALIDATED_COUNTS=' + json.dumps({k:len(validated[k]) for k in ['rules','definitions','operational_rules','proved_derived_lemmas','domain_lemmas']}, sort_keys=True))
