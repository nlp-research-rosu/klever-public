+root=Path('/reference/k-proof')
+pending=[root/'verification.k']; closure=set()
+while pending:
+ p=pending.pop()
+ if p in closure: continue
+ closure.add(p)
+ for req in re.findall(r'(?m)^requires\s+"([^"]+)"',p.read_text()): pending.append((p.parent/req).resolve())
+expected_required=['/frozen-k/'+p.relative_to(root).as_posix() for p in sorted(closure,key=str)]
