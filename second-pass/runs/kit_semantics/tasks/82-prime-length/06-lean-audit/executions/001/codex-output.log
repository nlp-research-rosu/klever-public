+def k_py_mod(n,d):
+    return ((n % d) + d) % d
+
+def operational(n):
+    d=2
+    p=n >= 2
+    while d < n:
+        if k_py_mod(n,d) == 0:
+            p=False
+        d += 1
+    return p
+
+def summary(n,d,p):
+    steps=0
+    while True:
+        assert d >= 2
+        if d >= n:
+            return p,steps
+        p = False if k_py_mod(n,d) == 0 else p
+        d += 1
+        steps += 1
+
