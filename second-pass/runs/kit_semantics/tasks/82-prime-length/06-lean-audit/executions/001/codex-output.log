--- /dev/null
+++ b/evidence/01-producer-integrity.txt
@@ -0,0 +1,52 @@
+COMMAND
+PYTHONPATH=/reference python - <<'PY'
+import hashlib, json
+from pathlib import Path
+from tools.pipeline_contract import sha256_tree
+ai = json.loads(Path('/audit-input.json').read_text())
+sm = json.loads(Path('/reference/generation-tools/source-manifest.json').read_text())
+gm = json.loads(Path('/reference/klean-generation/generator-manifest.json').read_text())
+observed = {
+ 'klean_export.py': hashlib.sha256(Path('/reference/generation-tools/klean_export.py').read_bytes()).hexdigest(),
