+COMMAND
+PYTHONPATH=/reference python - <<'PY'
+import hashlib, json
+from pathlib import Path
+from tools.pipeline_contract import sha256_tree
+ai = json.loads(Path('/audit-input.json').read_text())
+sm = json.loads(Path('/reference/generation-tools/source-manifest.json').read_text())
+gm = json.loads(Path('/reference/klean-generation/generator-manifest.json').read_text())
+observed = {
+ 'klean_export.py': hashlib.sha256(Path('/reference/generation-tools/klean_export.py').read_bytes()).hexdigest(),
+ 'klean.py': hashlib.sha256(Path('/reference/generation-tools/klean.py').read_bytes()).hexdigest(),
+}
+image_from_audit_path = 'sha256:' + Path(ai['resolution']['generation_producer_sources']).name
+bundle_sha = sha256_tree(Path('/reference/generation-tools'))
+print('observed_files=' + json.dumps(observed, sort_keys=True))
+print('source_manifest_files=' + json.dumps(sm['files'], sort_keys=True))
+print('generator_manifest_exporter_sha256=' + gm['exporter_sha256'])
+print('generator_manifest_klean_py_sha256=' + gm['klean_py_sha256'])
+print('source_manifest_generator_image_id=' + sm['generator_image_id'])
+print('generator_manifest_generator_image_id=' + gm['provenance']['generator_image_id'])
+print('audit_input_generator_image_id_from_path=' + image_from_audit_path)
+print('observed_bundle_sha256=' + bundle_sha)
+print('audit_input_bundle_sha256=' + ai['resolution']['hashes']['generation_producer_sources_sha256'])
+print('exact_bundle_names=' + json.dumps(sorted(p.relative_to('/reference/generation-tools').as_posix() for p in Path('/reference/generation-tools').iterdir())))
+print('PRODUCER_GATE=' + str(
+ observed == sm['files'] and
+ observed['klean_export.py'] == gm['exporter_sha256'] and
+ observed['klean.py'] == gm['klean_py_sha256'] and
+ sm['generator_image_id'] == gm['provenance']['generator_image_id'] == image_from_audit_path and
+ bundle_sha == ai['resolution']['hashes']['generation_producer_sources_sha256'] and
+ set(p.name for p in Path('/reference/generation-tools').iterdir()) == {'klean_export.py','klean.py','source-manifest.json'}
+))
+PY
+
+WORKDIR
+/audit-output
+
