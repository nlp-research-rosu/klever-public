+ {'name':'trialPrime','argument_sorts':['Int','Int','Bool'],'return_sort':'Bool'},
+ {'name':'primeNat','argument_sorts':['Int'],'return_sort':'Bool'}])
+print('module_bindings=',json.dumps({'syntax_module':im['syntax_module'],'verification_module':im['verification_module']},sort_keys=True))
+print('verification_hash_match=',im['verification_sha256']==hashlib.sha256(Path('/reference/k-proof/verification.k').read_bytes()).hexdigest())
+print('toolchain_lock_exact=',gm['toolchain']==lock)
+print('modeled_collection_hooks_exact=',gm['modeled_collection_hooks']==im['modeled_collection_hooks'])
+print('modeled_operational_hooks_exact=',gm['modeled_operational_hooks']==im['modeled_operational_hooks'])
+print('modeled_recursive_functions_exact=',gm['modeled_recursive_functions']==im['modeled_recursive_functions'])
