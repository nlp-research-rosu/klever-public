+20 False False 18
+21 False False 19
+22 False False 20
+23 True True 21
+24 False False 22
+25 False False 23
+26 False False 24
+27 False False 25
+28 False False 26
+29 True True 27
+30 False False 28
+all_equal= True
+guard_overlap_count= 0
+guard_gap_count= 0
+recursive_measure_strictly_decreases= True
+mutation_divisible_preserves_P: n=4 expected= False mutated=True
+mutation_nondivisible_sets_false: n=3 expected= True mutated=False
+mutation_base_returns_true: n=4,d=4,P=false expected= False mutated=True
+mutation_wrapper_initial_true: n=0 expected= False mutated=True
