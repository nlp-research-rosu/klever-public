diff --git a/evidence/02-rule-inventory.txt b/evidence/02-rule-inventory.txt
new file mode 100644
index 0000000000000000000000000000000000000000..5838228f78ab21e1c5f05533bd23e476e1e2c269
--- /dev/null
+++ b/evidence/02-rule-inventory.txt
@@ -0,0 +1,129 @@
+COMMAND
+PYTHONPATH=/reference python - <<'PY'
+import json
+from pathlib import Path
+from tools.k_rule_inventory import inventory_verification
+from tools.lemma_discovery_contract import validate_trust_boundary
+workspace=Path('/reference/k-proof')
+manifest_path=Path('/reference/lemma-discovery.json')
+inv=inventory_verification(workspace)
+stage3=json.loads(manifest_path.read_text())
+validated=validate_trust_boundary(workspace, manifest_path)
+print('RECONSTRUCTED_INVENTORY')
+print(json.dumps(inv, indent=2, sort_keys=True))
+print('STAGE3_MANIFEST')
+print(json.dumps(stage3, indent=2, sort_keys=True))
+print('ORDERED_RECONSTRUCTED_IDS')
+print(json.dumps([r['source_rule_id'] for r in inv['rules']], indent=2))
+print('ORDERED_STAGE3_IDS')
+print(json.dumps([r['source_rule_id'] for r in stage3['rules']], indent=2))
+print('ORDER_IDENTICAL=' + str([r['source_rule_id'] for r in inv['rules']] == [r['source_rule_id'] for r in stage3['rules']]))
