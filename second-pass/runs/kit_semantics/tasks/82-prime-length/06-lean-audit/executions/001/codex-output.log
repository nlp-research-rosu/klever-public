+COMMAND
+printf '%s\n' 'FROZEN SOURCE AND SUMMARY RULES'
+sed -n '1,10p' /reference/k-proof/solution.py
+sed -n '8,32p' /reference/k-proof/verification.k
+printf '%s\n' '' 'RELEVANT SUPPLIED OPERATIONAL SEMANTICS'
+sed -n '7,17p' /reference/k-proof/reference-semantics/semantics/int.k
+sed -n '19,27p' /reference/k-proof/reference-semantics/semantics/int.k
+sed -n '8,18p' /reference/k-proof/reference-semantics/semantics/controls.k
+sed -n '50,82p' /reference/k-proof/reference-semantics/semantics/controls.k
+sed -n '10,18p' /reference/k-proof/reference-semantics/semantics/operators.k
+sed -n '19,26p' /reference/k-proof/reference-semantics/semantics/builtins.k
+sed -n '221,230p' /reference/k-proof/reference-semantics/semantics/core.k
+printf '%s\n' '' 'INDEPENDENT FINITE SENSITIVITY CHECKS'
+python - <<'PY'
+def k_py_mod(n,d):
+    return ((n % d) + d) % d
+
+def operational(n):
+    d=2
+    p=n >= 2
+    while d < n:
+        if k_py_mod(n,d) == 0:
+            p=False
+        d += 1
+    return p
+
+def summary(n,d,p):
+    steps=0
+    while True:
+        assert d >= 2
+        if d >= n:
+            return p,steps
+        p = False if k_py_mod(n,d) == 0 else p
+        d += 1
+        steps += 1
+
+rows=[]
+for n in range(0,31):
+    s,steps=summary(n,2,n>=2)
+    rows.append((n,operational(n),s,steps))
+print('n operational summary recurrence_steps')
+for row in rows: print(*row)
+print('all_equal=', all(a==b for _,a,b,_ in rows))
+overlap=gap=0
+for n in range(0,41):
+  for d in range(2,43):
+    guards=[d>=n, d<n and k_py_mod(n,d)==0, d<n and k_py_mod(n,d)!=0]
+    overlap += sum(guards)>1
+    gap += sum(guards)==0
+print('guard_overlap_count=',overlap)
+print('guard_gap_count=',gap)
+print('recursive_measure_strictly_decreases=', all((n-(d+1)) < (n-d) for n in range(3,41) for d in range(2,n)))
+print('mutation_divisible_preserves_P: n=4 expected=',operational(4),'mutated=True')
+print('mutation_nondivisible_sets_false: n=3 expected=',operational(3),'mutated=False')
+print('mutation_base_returns_true: n=4,d=4,P=false expected=',summary(4,4,False)[0],'mutated=True')
+print('mutation_wrapper_initial_true: n=0 expected=',operational(0),'mutated=True')
+PY
+
+WORKDIR
+/audit-output
+
+EXIT
+0
+
+OUTPUT
+FROZEN SOURCE AND SUMMARY RULES
+def prime_length(string):
+    """Return whether the length of string is a prime number."""
+    n = len(string)
+    divisor = 2
+    prime = n >= 2
+    while divisor < n:
+        if n % divisor == 0:
+            prime = False
+        divisor = divisor + 1
+    return prime
+  // Mathematical result of testing the candidate divisors D, D+1, ..., N-1.
+  // The function is intentionally defined only on the proof domain D >= 2.
+  syntax Bool ::= trialPrime(Int, Int, Bool) [function]
+  syntax Bool ::= primeNat(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports BOOL
+  imports INT
+
+  rule trialPrime(N, D, P) => P
+    requires D >=Int N andBool D >=Int 2
+
+  rule trialPrime(N, D, P) => trialPrime(N, D +Int 1, false)
+    requires D <Int N andBool D >=Int 2
+     andBool pyMod(N, D) ==Int 0
+
+  rule trialPrime(N, D, P) => trialPrime(N, D +Int 1, P)
+    requires D <Int N andBool D >=Int 2
+     andBool pyMod(N, D) =/=Int 0
+
+  rule primeNat(N) => trialPrime(N, 2, N >=Int 2)
+endmodule
+
+RELEVANT SUPPLIED OPERATIONAL SEMANTICS
+  rule applyUn("-", I:Int) => 0 -Int I
+
+  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
+  // Bool participates in int arithmetic (x += (a == b))
+  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
+  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
+  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
+  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
+  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
+  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
+  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
+  syntax Int ::= pyMod(Int, Int) [function]
+  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
+
+  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
+  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
+  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
+  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
+  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
+  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
+  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
+  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
+       <env> L:Int </env>
+       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
+  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
+       <env> L:Int </env>
+       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
+       requires "$cells" in_keys(M)
+        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
+        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
+       [priority(40)]
+  // ==== If (condition evaluated by strictness) ==============================
+  syntax KItem ::= #branch(Bool, Stmts, Stmts)
+  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
+  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
+  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
+
+  // ==== While ==============================================================
+  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
+  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
+  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
+       requires truthy(V)
+  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
+       requires notBool truthy(V)
+  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
+
+  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
+
+  context Compare(HOLE, _)
+  context Compare(_:Val, CmpOp(_, HOLE))
+  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
+
+  // ==== len(obj) — O(1) per kind ============================================
+  syntax Int ::= seqLen(Val) [function]
+  rule applyBuiltin("len", OBJ:Val, .Vals) => seqLen(OBJ)
+  rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
+  rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
+  rule seqLen(str(IS:IntSeq))                   => isLen(IS)
+  rule seqLen(setV(DS:IntSeq))                  => isLen(DS)
+  rule seqLen(rangeObj(LO:Int, HI:Int, ST:Int)) => rangeLen(LO, HI, ST)
+  // ==== shared sequence length (len / summaries across many modules) ========
+  syntax Int ::= vsLen(ValSeq) [function, total]
+  rule vsLen(.ValSeq)                => 0
+  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
+
+  syntax Int ::= isLen(IntSeq) [function, total]
+  rule isLen(.IntSeq)                => 0
+  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
+
