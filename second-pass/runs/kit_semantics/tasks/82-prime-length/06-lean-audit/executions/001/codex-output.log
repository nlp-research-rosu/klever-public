+COMMAND
+PYTHONPATH=/reference python - <<'PY'
+import hashlib, json, re
+from pathlib import Path
+from tools.pipeline_contract import sha256_tree
+from tools.klean_export import tree_digest, target_statement
+
+def fh(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+def canon(x): return hashlib.sha256(json.dumps(x,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
+def files_under(root):
+  root=Path(root)
+  return sorted(p for p in root.rglob('*') if p.is_file() and not p.is_symlink())
+
+ai=json.loads(Path('/audit-input.json').read_text())
+res=ai['resolution']; h=res['hashes']
+gen=Path('/reference/klean-generation'); generated=gen/'generated'
+gm=json.loads((gen/'generator-manifest.json').read_text())
+im=json.loads((gen/'input-manifest.json').read_text())
+er=json.loads((gen/'export-result.json').read_text())
+om=json.loads((generated/'obligation-map.json').read_text())
+ld=json.loads(Path('/reference/lemma-discovery.json').read_text())
+observed={
+ 'resolved_input_sha256': canon(res),
+ 'k_workspace_sha256': sha256_tree(Path('/reference/k-proof')),
+ 'stage1_export_sha256': tree_digest(Path('/reference/k-proof')),
+ 'discovery_manifest_sha256': fh('/reference/lemma-discovery.json'),
+ 'k_audit_sha256': sha256_tree(Path('/reference/k-audit')),
+ 'klean_generation_sha256': sha256_tree(gen),
+ 'generation_producer_sources_sha256': sha256_tree(Path('/reference/generation-tools')),
+ 'generated_tree_sha256': tree_digest(generated),
+}
+expected={'resolved_input_sha256':ai['resolved_input_sha256'], **h}
+for k,v in observed.items():
+  print(f'{k}: observed={v} expected={expected[k]} match={v==expected[k]}')
+print('lean_workspace_absent=',not Path('/candidate').exists())
+print('lean_hashes_null=',h['lean_workspace_sha256'] is None and h['lean_invocation_sha256'] is None)
+source_expected=res['stage1_source_hashes']
+source_actual={p.relative_to('/reference/k-proof').as_posix():fh(p) for p in files_under('/reference/k-proof')}
+print('stage1_source_hash_count_expected=',len(source_expected))
+print('stage1_source_hash_count_actual=',len(source_actual))
+print('stage1_source_missing=',sorted(set(source_expected)-set(source_actual))[:10])
+print('stage1_source_extra=',sorted(set(source_actual)-set(source_expected))[:10])
+print('stage1_source_mismatches=',[k for k in sorted(set(source_expected)&set(source_actual)) if source_expected[k]!=source_actual[k]][:10])
+sidecar_hashes={name:fh(gen/name) for name in ['input-manifest.json','generator-manifest.json','trust-inventory.json','export-result.json']}
+print('sidecar_hashes=',json.dumps(sidecar_hashes,sort_keys=True))
+print('obligation_map_sha256_observed=',fh(generated/'obligation-map.json'))
+print('obligation_map_sha256_manifest=',gm['obligation_map_sha256'])
+print('trust_inventory_sha256_export=',er['trust_inventory_sha256'])
+print('trust_inventory_sha256_observed=',sidecar_hashes['trust-inventory.json'])
+print('stage1_bindings=',json.dumps({
+ 'input_frozen':im['frozen_input_sha256']==observed['stage1_export_sha256'],
+ 'input_stage1':im['stage1_workspace_sha256']==observed['stage1_export_sha256'],
+ 'generator_stage1':gm['provenance']['stage1_workspace_sha256']==observed['stage1_export_sha256'],
+ 'export_stage1':er['frozen_input_sha256']==observed['stage1_export_sha256'],
+},sort_keys=True))
+print('stage3_bindings=',json.dumps({
+ 'input':im['stage3_discovery_manifest_sha256']==observed['discovery_manifest_sha256'],
+ 'generator':gm['provenance']['stage3_discovery_manifest_sha256']==observed['discovery_manifest_sha256'],
+ 'export':er['stage3_discovery_manifest_sha256']==observed['discovery_manifest_sha256'],
+},sort_keys=True))
+print('inventory_bindings=',json.dumps({
+ 'stage3':ld['inventory_sha256'],
+ 'input':im['inventory_sha256'],
+ 'generator':gm['provenance']['inventory_sha256'],
+},sort_keys=True))
+true_domain_ids=[x['source_rule_id'] for x in ld['rules'] if x['classification']=='DOMAIN_LEMMA']
+input_ids=[x['source_rule_id'] for x in im['source_rules']]
+map_source_ids=[x['source_rule_id'] for x in om['source_rules']]
+obligation_ids=[x['source_rule_id'] for x in om['obligations']]
+print('ordered_domain_ids=',json.dumps(true_domain_ids))
+print('ordered_input_source_ids=',json.dumps(input_ids))
+print('ordered_map_source_ids=',json.dumps(map_source_ids))
+print('ordered_obligation_ids=',json.dumps(obligation_ids))
+print('source_obligation_bijection=',true_domain_ids==input_ids==map_source_ids==obligation_ids and len(obligation_ids)==len(set(obligation_ids)))
+print('trust_parameters=',json.dumps(om['trust_parameters']))
+print('obligation_count_bindings=',json.dumps({
+ 'generator':gm['obligation_count'], 'export':er['obligation_count'], 'audit_preflight':res['stage4_preflight']['obligation_count'], 'actual':len(om['obligations'])
+},sort_keys=True))
+lean_sources=files_under(generated)
+raw_targets=[]
+for p in lean_sources:
+  if p.suffix=='.lean':
+    for m in re.finditer(r'(?m)^\s*def\s+targetStatement\b',p.read_text()): raw_targets.append(p.relative_to(generated).as_posix())
+print('raw_target_declarations=',json.dumps(raw_targets))
+print('producer_target_statement=',json.dumps(target_statement(generated),sort_keys=True))
+print('target_bindings=',json.dumps({
+ 'generator':gm['target'], 'audit':res['target'], 'audit_preflight':res['stage4_preflight']['target']
+},sort_keys=True))
+print('statuses=',json.dumps({
+ 'selected':res['selections']['klean_generation']['status'], 'export':er['status'], 'audit_preflight':res['stage4_preflight']['status']
+},sort_keys=True))
+print('ALL_RECORDED_HASHES_MATCH=',all(observed[k]==expected[k] for k in observed) and source_expected==source_actual and fh(generated/'obligation-map.json')==gm['obligation_map_sha256'] and er['trust_inventory_sha256']==sidecar_hashes['trust-inventory.json'])
+PY
+
+WORKDIR
+/audit-output
+
+EXIT
+0
+
+OUTPUT
+resolved_input_sha256: observed=ab8617645e61b9f88729c034153ef6691251ec6a88edcedba0bc5ccd822f65fd expected=ab8617645e61b9f88729c034153ef6691251ec6a88edcedba0bc5ccd822f65fd match=True
+k_workspace_sha256: observed=ee1dc44f34b5a93af3f36c176363a63c7d2409102f45ee7606ff112f20320685 expected=ee1dc44f34b5a93af3f36c176363a63c7d2409102f45ee7606ff112f20320685 match=True
