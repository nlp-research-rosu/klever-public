--- solution.py ---
     1	def prime_length(string):
     2	    """Return whether the length of string is a prime number."""
     3	    n = len(string)
     4	    divisor = 2
     5	    prime = n >= 2
     6	    while divisor < n:
     7	        if n % divisor == 0:
     8	            prime = False
     9	        divisor = divisor + 1
    10	    return prime

