diff --git a//tmp/audit-work/lean-proc-self.c b//tmp/audit-work/lean-proc-self.c
new file mode 100644
index 0000000000000000000000000000000000000000..e82d5bec8c46172e4dc693b61e837856827642eb
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    char expected[64];
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+        if (real_readlink == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+
+    snprintf(expected, sizeof(expected), "/proc/%ld/exe", (long)getpid());
+    if (path != NULL && strcmp(path, expected) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
