Module(
  FuncDef("prime_length", Params("string"),
    Expr(Str("Return whether the length of string is a prime number."))
    Assign(Name("n"), Call(Name("len"), Name("string")))
    Assign(Name("divisor"), Int(2))
    Assign(Name("prime"), Compare(Name("n"), CmpOp(">=", Int(2))))
    While(Compare(Name("divisor"), CmpOp("<", Name("n"))),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Assign(Name("prime"), Bool(false)),
        )
      Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    Return(Name("prime")))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("a")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("ab")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("abc")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("Hello")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("orange")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("abcdcba")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("kittens")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("abcdefghijk")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("abcdefghijkl")),
      CmpOp("==", Bool(false)))))
