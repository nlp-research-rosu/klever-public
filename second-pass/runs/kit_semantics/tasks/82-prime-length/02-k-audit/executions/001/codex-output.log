+                   BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+                 Assign(Name("prime"), Bool(false)),
+                 .Stmts)
+               Assign(
+                 Name("divisor"),
+                 BinOp("+", Name("divisor"), Int(1))))
+             Return(Name("prime"))
+             .Stmts),
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
