/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib
for root in [Path('/candidate'),Path('/candidate/reference-semantics'),Path('/reference/reference-semantics')]:
  files=sorted(p for p in root.rglob('*') if p.is_file())
  for mode in range(4):
    h=hashlib.sha256()
    for p in files:
      rel=p.relative_to(root).as_posix().encode()
      data=p.read_bytes()
      if mode==0: h.update(rel+b'\\0'+data+b'\\0')
      elif mode==1: h.update(rel+b'\\n'+data)
      elif mode==2: h.update(rel); h.update(data)
      else: h.update(data)
    print(root,mode,h.hexdigest())
PY" in /audit-output
