{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "0d84adc0fbe6fe3c0ad834b7cabaec34b6f1a14a37b1d97e6309a591d770d73e",
      "rationale": "This is the guarded base equation of the trialPrime mathematical summary: once D has reached or passed N on the defined proof domain D >= 2, it defines the summary result to be the accumulated Boolean P.",
      "source_rule_id": "rule-0d84adc0fbe6fe3c0ad834b7cabaec34b6f1a14a37b1d97e6309a591d770d73e",
      "start_line": 20,
      "text": "  rule trialPrime(N, D, P) => P\n    requires D >=Int N andBool D >=Int 2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "f7636d5013012b53a727f7a69e19eee33049f6844171d011930dcbc50544e7b5",
      "rationale": "This is the divisible-case recurrence defining trialPrime: for a candidate D in the remaining range that divides N, it advances to D + 1 with the accumulated summary value set to false.",
      "source_rule_id": "rule-f7636d5013012b53a727f7a69e19eee33049f6844171d011930dcbc50544e7b5",
      "start_line": 23,
      "text": "  rule trialPrime(N, D, P) => trialPrime(N, D +Int 1, false)\n    requires D <Int N andBool D >=Int 2\n     andBool pyMod(N, D) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "c788496123caab512e57df64b2dd0261154d3d075835223008964c8feddfab13",
      "rationale": "This is the nondivisible-case recurrence defining trialPrime: for a candidate D in the remaining range that does not divide N, it advances to D + 1 while preserving the accumulated Boolean P.",
      "source_rule_id": "rule-c788496123caab512e57df64b2dd0261154d3d075835223008964c8feddfab13",
      "start_line": 27,
      "text": "  rule trialPrime(N, D, P) => trialPrime(N, D +Int 1, P)\n    requires D <Int N andBool D >=Int 2\n     andBool pyMod(N, D) =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "835478f853e5b3aed5797027e0534f3648fdf19cc84cf0cc5b7ef40a0675b715",
      "rationale": "This unguarded wrapper equation defines primeNat(N) as the initial trialPrime state with divisor 2 and initial Boolean N >= 2; it names the proof's primality summary rather than adding an independent fact.",
      "source_rule_id": "rule-835478f853e5b3aed5797027e0534f3648fdf19cc84cf0cc5b7ef40a0675b715",
      "start_line": 31,
      "text": "  rule primeNat(N) => trialPrime(N, 2, N >=Int 2)"
    }
  ],
