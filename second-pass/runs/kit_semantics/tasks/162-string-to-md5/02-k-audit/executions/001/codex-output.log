+requires "verification.k"
+
+module SPEC-AUDIT-VACUITY
+  imports VERIFICATION
+
+  // Fresh reviewer mutation. The exact real body on the satisfying input "a"
+  // returns a string value, so the postcondition noneV is deliberately false.
+  claim [false-nonempty-none]:
+    <k>
+      #loadAll(Module(
+        Import("hashlib")
+        FuncDef("string_to_md5", Params("text"),
+          If(Compare(Name("text"), CmpOp("==", Str(""))),
+            Return(NoneVal),
+            .Stmts)
+          Return(
+            Call(
+              Attribute(
+                Call(
+                  Attribute(Name("hashlib"), "md5"),
+                  Call(Attribute(Name("text"), "encode"), Str("utf-8"))),
+                "hexdigest"),
+              .Exprs)))
+        Assign(
+          Name("result"),
+          Call(
+            Name("string_to_md5"),
+            str(iCons(97, .IntSeq))))
+      )) => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map =>
+          "string_to_md5" |->
+            closureVal(
+              "text",
+              If(Compare(Name("text"), CmpOp("==", Str(""))),
+                Return(NoneVal),
+                .Stmts)
+              Return(
+                Call(
+                  Attribute(
+                    Call(
+                      Attribute(Name("hashlib"), "md5"),
+                      Call(Attribute(Name("text"), "encode"), Str("utf-8"))),
+                    "hexdigest"),
+                  .Exprs)),
+              0)
+          "result" |-> noneV,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
