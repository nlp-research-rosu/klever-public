  ARGUMENT=*** Begin Patch\n*** Add File: /workspace/prove.sh\n+#!/usr/bin/env bash\n+set -euo pipefail\n+\n+python3 py2mpy.py solution.py > solution.mpy\n+python3 py2mpy.py smoke-empty.py > smoke-empty.mpy\n+python3 py2mpy.py smoke.py > smoke.mpy\n+\n+kompile --backend llvm reference-semantics/semantics.k \\n+  --main-module MPY-KRUN \\n+  --syntax-module MPY-SYNTAX \\n+  --output-definition runtime-kompiled\n+\n+krun smoke-empty.mpy --definition runtime-kompiled\n+\n+if krun smoke.mpy --definition runtime-kompiled; then\n+  echo "UNEXPECTED: opaque nonempty MD5 execution succeeded under LLVM"\n+  exit 1\n+else\n+  llvm_probe_rc=$?\n+  echo "EXPECTED_OPAQUE_LLVM_FAILURE exit=$llvm_probe_rc"\n+fi\n+\n+kompile --backend haskell verification.k \\n+  --main-module VERIFICATION \\n+  --syntax-module MPY-SYNTAX \\n+  --output-definition verification-kompiled\n+\n+kprove spec.k \\n+  --definition verification-kompiled \\n+  --spec-module SPEC \\n+  --claims SPEC.empty-input\n+\n+kprove spec.k \\n+  --definition verification-kompiled \\n+  --spec-module SPEC \\n+  --claims SPEC.nonempty-input\n+\n+kprove spec.k \\n+  --definition verification-kompiled \\n+  --spec-module SPEC\n+\n+if kprove spec-vacuity.k \\n+  --definition verification-kompiled \\n+  --spec-module SPEC-VACUITY\n+then\n+  echo "UNEXPECTED: false postcondition was proved"\n+  exit 1\n+else\n+  vacuity_probe_rc=$?\n+  echo "EXPECTED_VACUITY_FAILURE exit=$vacuity_probe_rc"\n+fi\n+\n+if kprove spec-body-mutation.k \\n+  --definition verification-kompiled \\n+  --spec-module SPEC-BODY-MUTATION\n+then\n+  echo "UNEXPECTED: mutated function body satisfied the original result"\n+  exit 1\n+else\n+  body_probe_rc=$?\n+  echo "EXPECTED_BODY_MUTATION_FAILURE exit=$body_probe_rc"\n+fi\n+\n+python3 test_solution.py\n*** End Patch\n
