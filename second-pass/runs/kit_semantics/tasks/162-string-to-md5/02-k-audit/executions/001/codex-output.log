/bin/bash -lc "script -q -e -c 'python3 /audit-output/evidence/stage5_inventory.py' /audit-output/evidence/stage5-rule-inventory-final3.log >/tmp/stage5-inventory-console3.txt 2>&1; sed -n '1,38p' /tmp/stage5-inventory-console3.txt; rg -n 'SUPPLIED_(IMPORT|ENCODING|MD5)_BOUNDARY|CANDIDATE_WRAPPER_NO_EXTENSION|TARGET_CLAIM' /audit-output/evidence/stage5-rule-inventory-final3.log; tail -n 18 /tmp/stage5-inventory-console3.txt" in /tmp/audit-work/162-string-to-md5
