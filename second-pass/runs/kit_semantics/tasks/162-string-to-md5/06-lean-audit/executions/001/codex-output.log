diff --git a/evidence/probe_app_path.c b/evidence/probe_app_path.c
new file mode 100644
index 0000000000000000000000000000000000000000..07b4f4358bc9d49d689d53c56b6bf1b7dc59ddaa
--- /dev/null
+++ b/evidence/probe_app_path.c
@@ -0,0 +1,15 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+  char link[4096];
+  char target[4096] = {0};
+  snprintf(link, sizeof(link), "/proc/%d/exe", getpid());
+  ssize_t n = readlink(link, target, sizeof(target) - 1);
+  printf("path=%s n=%zd errno=%d (%s) target=%s\n",
+         link, n, errno, strerror(errno), target);
+  return n < 0;
+}
diff --git a/evidence/proc_exe_readlink_shim.c b/evidence/proc_exe_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..407d18fb733991f045662f26384471ccff1f3042
--- /dev/null
+++ b/evidence/proc_exe_readlink_shim.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL)
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+    const char *suffix = strrchr(path, '/');
+    if (suffix != NULL && strcmp(suffix, "/exe") == 0)
+      return real_readlink("/proc/self/exe", buf, bufsiz);
+  }
+  return real_readlink(path, buf, bufsiz);
+}

