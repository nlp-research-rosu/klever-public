#!/usr/bin/env python3
"""py2mpy — a *pure* CPython-AST -> K-constructor transliterator.

Reads a .py file and prints the matching `.mpy` term: a Lisp-indented tree of K
constructors that a (future) K semantics will parse. The design rule is strict:

    PURE TRANSLITERATION. Every Python AST node maps to exactly one K
    constructor with the same structure. The front-end makes NO semantic
    decisions — it does not desugar, simplify, normalize, or "interpret"
    anything. All meaning lives in the K semantics that consumes the term.

Consequences of that rule (vs. a "helpful" front-end):

  * `is` / `is not` transliterate to `CmpOp("is", ...)` / `CmpOp("is not", ...)`
    — NOT to `==` / `!=`. K decides what identity means.
  * a chained comparison `a < b < c` stays a single `Compare` carrying the
    chain (`Compare(a, CmpOp("<", b), CmpOp("<", c))`) — it is NOT pre-expanded
    into `a < b and b < c`.
  * a method call `x.append(v)` stays `Call(Attribute(Name("x"), "append"), v)`
    — there is no special `MethodCall` constructor folding the receiver in.
  * `a[i] = v` stays `Assign(Subscript(Name("a"), Name("i")), v)` — the target
    is just an expression in store position; no special `SubscriptAssign`.

The only choices the transliterator makes are unavoidably *syntactic* — e.g. a
`bool` literal becomes `Bool(...)` not `Int(...)`, because that is the literal's
actual Python type as read off the AST, not a semantic judgement.

Anything outside the covered subset raises `Unsupported`, naming the node, so
coverage gaps fail loudly instead of being silently dropped.

Usage:
    python scripts/py2mpy.py FILE.py          # print the .mpy term (default)
    python scripts/py2mpy.py FILE.py --ast    # print the Python AST (ast.dump)
"""
from __future__ import annotations

import argparse
import symtable
import ast
import json
import sys


class Unsupported(Exception):
    """Raised for any AST node the transliterator does not cover."""


# ---------------------------------------------------------------------------
# Term model: a .mpy term is a tree of these three node kinds.
#   Ctor(name, *args)  -> `name(arg, arg, ...)`  (comma-separated args)
#   Seq([item, ...])   -> a statement list: juxtaposed, no parens, no commas
#   str                -> a leaf token already in K surface form
#                         (a quoted string `"op"`, a number `0`, `true`, `Break`)
# ---------------------------------------------------------------------------
class Ctor:
    __slots__ = ("name", "args")

    def __init__(self, name: str, *args):
        self.name = name
        self.args = list(args)


class Seq:
    __slots__ = ("items",)

    def __init__(self, items):
        self.items = list(items)


def q(s: str) -> str:
    """A Python string as a K String token (double-quoted, escaped)."""
    return json.dumps(s)


# --- Operator spellings (string tokens carried inside constructors) ----------
# These are transliterations of the operator *symbol*, not its meaning.
_BINOP = {
    ast.Add: "+", ast.Sub: "-", ast.Mult: "*", ast.Div: "/",
    ast.FloorDiv: "//", ast.Mod: "%", ast.Pow: "**",
    ast.BitOr: "|", ast.BitAnd: "&", ast.BitXor: "^",
    ast.LShift: "<<", ast.RShift: ">>", ast.MatMult: "@",
}
_UNARY = {ast.USub: "-", ast.UAdd: "+", ast.Not: "not", ast.Invert: "~"}
_BOOLOP = {ast.And: "and", ast.Or: "or"}
_CMPOP = {
    ast.Eq: "==", ast.NotEq: "!=", ast.Lt: "<", ast.LtE: "<=",
    ast.Gt: ">", ast.GtE: ">=", ast.Is: "is", ast.IsNot: "is not",
    ast.In: "in", ast.NotIn: "not in",
}


# ---------------------------------------------------------------------------
# Closure scopes (Python's own symtable, faithfully exposed)
# ---------------------------------------------------------------------------
# (name, lineno) -> (cellvars, freevars, nested). A def/lambda gets the
# ANNOTATED node form iff it is nested inside a function or has cells/frees;
# module-level capture-free defs keep the old shape (zero churn).
SCOPES: dict = {}


def _frees(table):
    return set(table.get_frees()) if isinstance(table, symtable.Function) else set()


def _deep_frees(table):
    out = _frees(table)
    for g in table.get_children():
        out |= _deep_frees(g) - set(table.get_locals())
    return out


def _walk_symtable(table, depth=0):
    for child in table.get_children():
        if child.get_type() in ("function", "lambda"):
            frees = sorted(_frees(child))
            cells = sorted(
                s for s in child.get_locals()
                if any(s in _deep_frees(g) for g in child.get_children())
            )
            SCOPES[(child.get_name(), child.get_lineno())] = (
                cells, frees, depth > 0 or table.get_type() != "module")
        _walk_symtable(child, depth + (1 if child.get_type() in ("function", "lambda") else 0))


def scope_info(name, lineno):
    return SCOPES.get((name, lineno))


# ---------------------------------------------------------------------------
# Expressions
# ---------------------------------------------------------------------------
def emit_expr(node: ast.expr):
    if isinstance(node, ast.Constant):
        v = node.value
        if v is None:
            return "NoneVal"
        if isinstance(v, bool):                 # MUST precede int (bool ⊂ int)
            return Ctor("Bool", "true" if v else "false")
        if isinstance(v, int):
            return Ctor("Int", str(v))
        if isinstance(v, float):
            return Ctor("Float", repr(v))
        if isinstance(v, str):
            return Ctor("Str", q(v))
        raise Unsupported(f"Constant {type(v).__name__}")

    if isinstance(node, ast.Name):
        return Ctor("Name", q(node.id))

    if isinstance(node, ast.Lambda):
        a = node.args
        if a.vararg or a.kwarg or a.kwonlyargs or a.defaults or a.kw_defaults:
            raise Unsupported("complex lambda signature")
        names = [p.arg for p in (a.posonlyargs + a.args)]
        params = Ctor("Params", *(q(n) for n in names))
        info = scope_info("lambda", node.lineno)
        if info and (info[0] or info[1] or info[2]):
            cells, frees, _ = info
            return Ctor("Lambda", params,
                        Ctor("CellVars", *(q(n) for n in cells)),
                        Ctor("FreeVars", *(q(n) for n in frees)),
                        emit_expr(node.body))
        return Ctor("Lambda", params, emit_expr(node.body))

    if isinstance(node, ast.BinOp):
        op = _BINOP.get(type(node.op))
        if op is None:
            raise Unsupported(f"BinOp {type(node.op).__name__}")
        return Ctor("BinOp", q(op), emit_expr(node.left), emit_expr(node.right))

    if isinstance(node, ast.UnaryOp):
        op = _UNARY.get(type(node.op))
        if op is None:
            raise Unsupported(f"UnaryOp {type(node.op).__name__}")
        return Ctor("UnaryOp", q(op), emit_expr(node.operand))

    if isinstance(node, ast.BoolOp):
        op = _BOOLOP[type(node.op)]
        return Ctor("BoolOp", q(op), *(emit_expr(v) for v in node.values))

    if isinstance(node, ast.Compare):
        # Faithful, non-desugared: left operand + a chain of (op, comparator).
        # Single comparison => one CmpOp; `a < b < c` => two CmpOps.
        chain = [
            Ctor("CmpOp", q(_op_or_raise(_CMPOP, op, "Compare")), emit_expr(c))
            for op, c in zip(node.ops, node.comparators)
        ]
        return Ctor("Compare", emit_expr(node.left), *chain)

    if isinstance(node, ast.List):
        return Ctor("ListExpr", *(emit_expr(e) for e in node.elts))

    if isinstance(node, ast.Tuple):
        return Ctor("TupleExpr", *(emit_expr(e) for e in node.elts))

    if isinstance(node, ast.Set):
        return Ctor("SetExpr", *(emit_expr(e) for e in node.elts))

    if isinstance(node, ast.Dict):
        entries = []
        for k, v in zip(node.keys, node.values):
            if k is None:
                raise Unsupported("dict unpacking {**x}")
            entries.append(Ctor("Entry", emit_expr(k), emit_expr(v)))
        return Ctor("DictExpr", *entries)

    if isinstance(node, ast.Subscript):
        return Ctor("Subscript", emit_expr(node.value), emit_index(node.slice))

    if isinstance(node, ast.Attribute):
        return Ctor("Attribute", emit_expr(node.value), q(node.attr))

    if isinstance(node, ast.Call):
        if any(isinstance(a, ast.Starred) for a in node.args):
            raise Unsupported("*args unpacking")
        if any(kw.arg is None for kw in node.keywords):
            raise Unsupported("**kwargs unpacking")
        # Call grammar is `Call(Expr, Exprs)` — the comma is mandatory, so a zero-arg
        # call must render as `Call(f, )` (empty Exprs), NOT `Call(f)` (which won't parse).
        args = [emit_expr(a) for a in node.args]
        args += [Ctor("KwArg", q(kw.arg), emit_expr(kw.value)) for kw in node.keywords]
        args = args or [""]
        return Ctor("Call", emit_expr(node.func), *args)

    if isinstance(node, ast.IfExp):
        # AST field order: test, body, orelse — kept verbatim.
        return Ctor("IfExp", emit_expr(node.test),
                    emit_expr(node.body), emit_expr(node.orelse))

    if isinstance(node, ast.ListComp):
        return Ctor("ListComp", emit_expr(node.elt), _gens(node.generators))
    if isinstance(node, ast.SetComp):
        return Ctor("SetComp", emit_expr(node.elt), _gens(node.generators))
    if isinstance(node, ast.GeneratorExp):
        return Ctor("GenExp", emit_expr(node.elt), _gens(node.generators))
    if isinstance(node, ast.DictComp):
        return Ctor("DictComp", emit_expr(node.key), emit_expr(node.value),
                    _gens(node.generators))

    raise Unsupported(f"Expr {type(node).__name__}")


def _op_or_raise(table, op, label):
    spelled = table.get(type(op))
    if spelled is None:
        raise Unsupported(f"{label} {type(op).__name__}")
    return spelled


def _compfor(g):
    """A single generator -> CompFor(target, iter, <ifs as Exprs; .Exprs if none>)."""
    if getattr(g, "is_async", 0):
        raise Unsupported("async comprehension")
    ifs = [emit_expr(c) for c in g.ifs] or [Ctor("Bool", "true")]
    return Ctor("CompFor", emit_expr(g.target), emit_expr(g.iter), *ifs)


def _gens(generators):
    """The generator list -> a juxtaposed CompFors (a Seq of CompFor)."""
    return Seq([_compfor(g) for g in generators])


def emit_index(node: ast.expr):
    """Subscript index position: an `ast.Slice` -> `Slice(...)`, else the expr."""
    # Python <3.9 wrapped the index in ast.Index; unwrap if present.
    inner = getattr(ast, "Index", None)
    if inner is not None and isinstance(node, inner):
        node = node.value
    if isinstance(node, ast.Slice):
        def bound(b):
            # omitted bound (absent field) OR an explicit None constant -> NoBound.
            # Python treats `a[None:5]` exactly like `a[:5]`; only a *value* None
            # (Constant(None) outside a slice) becomes NoneVal. Keeping the two
            # distinct lets NoneVal be a real value without perturbing slices.
            if b is None or (isinstance(b, ast.Constant) and b.value is None):
                return "NoBound"
            return emit_expr(b)
        return Ctor("Slice", bound(node.lower), bound(node.upper), bound(node.step))
    return emit_expr(node)


# ---------------------------------------------------------------------------
# Statements
# ---------------------------------------------------------------------------
def emit_stmt(node: ast.stmt):
    if isinstance(node, ast.FunctionDef):
        a = node.args
        if a.vararg or a.kwarg or a.kwonlyargs or a.defaults or a.kw_defaults:
            raise Unsupported("complex function signature (defaults/varargs/kwonly)")
        if node.decorator_list:
            raise Unsupported("decorators")
        names = [p.arg for p in (a.posonlyargs + a.args)]  # type annotations ignored
        params = Ctor("Params", *(q(n) for n in names))
        info = scope_info(node.name, node.lineno)
        if info and (info[0] or info[1] or info[2]):
            cells, frees, _ = info
            return Ctor("FuncDef", q(node.name), params,
                        Ctor("CellVars", *(q(n) for n in cells)),
                        Ctor("FreeVars", *(q(n) for n in frees)),
                        emit_stmts(node.body))
        return Ctor("FuncDef", q(node.name), params, emit_stmts(node.body))

    if isinstance(node, ast.Return):
        if node.value is None:
            return Ctor("Return")
        return Ctor("Return", emit_expr(node.value))

    if isinstance(node, ast.Assign):
        if len(node.targets) != 1:
            raise Unsupported("chained assignment (a = b = ...)")
        # Target is just an expression in store position (Name / Tuple / Subscript / Attribute).
        return Ctor("Assign", emit_expr(node.targets[0]), emit_expr(node.value))

    if isinstance(node, ast.AugAssign):
        op = _BINOP.get(type(node.op))
        if op is None:
            raise Unsupported(f"AugAssign {type(node.op).__name__}")
        return Ctor("AugAssign", emit_expr(node.target), q(op), emit_expr(node.value))

    if isinstance(node, ast.If):
// reference/src/semantics.k — the supplied `.mpy` semantics, ASSEMBLED.
//
//   kompile reference-semantics/semantics.k --backend llvm \
//     --main-module MPY-KRUN --syntax-module MPY-SYNTAX \
//     --output-definition runtime-kompiled
//
// Concrete-only legs are included through MPY-KRUN. Proof definitions import
// MPY and any explicit proof extensions supplied by the task author.
//
// Files (dependency order — everything imports MPY-CORE):
//   semantics/syntax.k         MPY-SYNTAX       AST productions
//   semantics/core.k           MPY-CORE         values, config, load, lookup, shared helpers   [required]
//   semantics/iter.k           MPY-ITER         the iterator protocol (#iterNext/#iterYield/#iterDone) decl
//   semantics/range.k          MPY-RANGE        rangeObj: inRange / rangeLen / its #iterNext
//   semantics/operators.k      MPY-OPERATORS    operator DISPATCH (UnaryOp/BinOp/Compare/BoolOp) — domain files own the cases
//   semantics/int.k            MPY-INT          Int operator cases; floored // and % (pyMod)
//   semantics/bool.k           MPY-BOOL         Bool operator cases + truthy not/and/or (BoolOp)
//   semantics/float.k          MPY-FLOAT        Float Val: literal + opaque float ops ([concrete] for krun)
//   semantics/str.k            MPY-STR          str(IntSeq): literal, +, ==, in
//   semantics/set.k            MPY-SET          set(str): distinct char codes (len / membership)
//   semantics/list.k           MPY-LIST         ListExpr, list(ValSeq): +, ==, in
//   semantics/tuple.k          MPY-TUPLE        TupleExpr, tuple ==, target-binding + unpacking
//   semantics/subscript.k      MPY-SUBSCRIPT    Subscript indexing + Slice
//   semantics/comprehension.k  MPY-COMPREHENSION  list comprehensions [ELT for T in ITER if COND]
//   semantics/methods.k        MPY-METHODS      pure str methods: is*/lower/upper/swapcase/startswith
//   semantics/controls.k       MPY-CONTROLS     Assign/AugAssign, If, IfExp, For, While, break/continue
//   semantics/functions.k      MPY-FUNCTIONS    def / call / return (frame stack)
//   semantics/builtins.k       MPY-BUILTINS     builtins as calls: len/sum/abs/min/max/ord/chr/str
//   semantics/call.k           MPY-CALL         ALL Call routing + argument evaluation
//   semantics/sort.k           MPY-SORT         trusted sorted(): opaque sortVS + concrete insertion sort
//   semantics/assert.k         MPY-ASSERT       Assert oracle (smoke programs only)
//   semantics/dict.k           MPY-DICT         order-preserving dictV(KS,VS) + .keys() + list()

requires "semantics/syntax.k"
requires "semantics/core.k"
requires "semantics/iter.k"
requires "semantics/range.k"
requires "semantics/operators.k"
requires "semantics/int.k"
requires "semantics/bool.k"
requires "semantics/float.k"
requires "semantics/str.k"
requires "semantics/set.k"
requires "semantics/list.k"
requires "semantics/tuple.k"
requires "semantics/subscript.k"
requires "semantics/comprehension.k"
requires "semantics/methods.k"
requires "semantics/controls.k"
requires "semantics/functions.k"
requires "semantics/builtins.k"
requires "semantics/call.k"
requires "semantics/sort.k"
requires "semantics/assert.k"
requires "semantics/dict.k"
requires "semantics/concrete.k"

module MPY
  imports MPY-CORE
  imports MPY-ITER
  imports MPY-RANGE
  imports MPY-OPERATORS
  imports MPY-INT
  imports MPY-BOOL
  imports MPY-FLOAT
  imports MPY-STR
  imports MPY-SET
  imports MPY-LIST
  imports MPY-TUPLE
  imports MPY-SUBSCRIPT
  imports MPY-COMPREHENSION
  imports MPY-METHODS
  imports MPY-CONTROLS
  imports MPY-FUNCTIONS
  imports MPY-BUILTINS
  imports MPY-CALL
  imports MPY-SORT
  imports MPY-ASSERT
  imports MPY-DICT
endmodule

// The krun (llvm) main module: MPY plus the concrete-only legs (keyed sort's
// real key calls, deep list equality). Verification builds import MPY and
// never see MPY-CONCRETE. The llvm kompile MUST use --main-module MPY-KRUN —
// with plain MPY the concrete legs are silently absent (this was live for a
// while: sorted-key stuck and comprehension asserted wrong under krun).
module MPY-KRUN
  imports MPY
  imports MPY-CONCRETE
endmodule
// reference/src/semantics/syntax.k — MPY-SYNTAX

module MPY-SYNTAX
  imports INT-SYNTAX
  imports FLOAT-SYNTAX
  imports BOOL-SYNTAX
  imports STRING-SYNTAX

  syntax Expr ::= "Int"      "(" Int ")"
                | "Float"    "(" Float ")"
                | "Bool"     "(" Bool ")"
                | "Name"     "(" String ")"
                | "Str"      "(" String ")"
                | "UnaryOp"  "(" String "," Expr ")" [strict(2)]
                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
                | "BoolOp"    "(" String "," Exprs ")"
                | "ListExpr"  "(" Exprs ")"
                | "DictExpr"  "(" Entries ")"
                | "ListComp"  "(" Expr "," CompFors ")" [macro]
                | "GenExp"    "(" Expr "," CompFors ")" [macro]
                | "TupleExpr" "(" Exprs ")"
                | "Subscript" "(" Expr "," Index ")"
                | "IfExp"     "(" Expr "," Expr "," Expr ")" [strict(1)]
                | "Lambda"    "(" Params "," Expr ")"
                | "KwArg"     "(" String "," Expr ")"
                | "Lambda"    "(" Params "," CellVars "," FreeVars "," Expr ")"
                | "NoneVal"
                | "Call"      "(" Expr "," Exprs ")"
                | "Attribute" "(" Expr "," String ")" [strict(1)]
                | "Compare"   "(" Expr "," CmpOp ")"

  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"
  syntax Entry    ::= "Entry" "(" Expr "," Expr ")"
  syntax Entries  ::= List{Entry, ","}
  syntax CompFor  ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
  syntax CompFors ::= List{CompFor, ""}
  syntax Exprs    ::= List{Expr, ","}
  syntax Index    ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
  syntax Bound    ::= Expr | "NoBound"

  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
                | "Import"    "(" String ")"
                | "ImportFrom" "(" String "," ParamNames ")"
                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
                | "While"     "(" Expr "," Stmts ")"
                | "Break"
                | "Continue"
                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
                | "Return"    "(" Expr ")" [strict]
                | "Assert"    "(" Expr ")" [strict]
                | "Expr"      "(" Expr ")" [strict]
                | "FuncDef"   "(" String "," Params "," Stmts ")"
                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"

  syntax Stmts      ::= List{Stmt, ""}
  syntax Params     ::= "Params" "(" ParamNames ")"
  syntax CellVars   ::= "CellVars" "(" ParamNames ")"
  syntax FreeVars   ::= "FreeVars" "(" ParamNames ")"
  syntax ParamNames ::= List{String, ","}
  syntax Module     ::= "Module" "(" Stmts ")"
endmodule
// reference/src/semantics/operators.k — MPY-OPERATORS
// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).

module MPY-OPERATORS
  imports MPY-CORE
  imports MPY-ITER

  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>

  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>

  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
  context Compare(HOLE, _)
  context Compare(_:Val, CmpOp(_, HOLE))
  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]

  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)

  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
  // (Python: list == is structural; identity only via `is`.) priority(40)
  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       requires notBool isRefV(L)
       [priority(40)]

  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       requires OP =/=String "in" andBool OP =/=String "not in"
       [priority(40)]
  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       requires notBool isRefV(L)
        orBool OP ==String "in" orBool OP ==String "not in"
       [priority(40)]

  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
endmodule
// reference/src/semantics/int.k — MPY-INT
// Int cases of the operator dispatch; Python // and % are floored (pyMod).

module MPY-INT
  imports MPY-CORE

  rule applyUn("-", I:Int) => 0 -Int I

  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
  // Bool participates in int arithmetic (x += (a == b))
  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
  // bool is a subtype of int: any Bool operand promotes to 0/1 and re-dispatches
  // to the Int cases (the "+" mixed cases above are kept, so "+" is excluded here
  // to avoid a duplicate rule — Bool + Bool still promotes via the Bool x Bool rule).
  rule applyBin(OP:String, B1:Bool, B2:Bool) => applyBin(OP, boolAsInt(B1), boolAsInt(B2))
       requires isArithOp(OP)
  rule applyBin(OP:String, B:Bool, I:Int)    => applyBin(OP, boolAsInt(B), I)
       requires isArithOp(OP) andBool OP =/=String "+"
  rule applyBin(OP:String, I:Int, B:Bool)    => applyBin(OP, I, boolAsInt(B))
       requires isArithOp(OP) andBool OP =/=String "+"
  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0

  syntax Int ::= pyMod(Int, Int) [function]
  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2

  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
endmodule
// reference/src/semantics/str.k — MPY-STR

module MPY-STR
  imports MPY-CORE
  imports MPY-ITER

  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>

  // ==== str literal (ASCII-only) ============================================
  syntax IntSeq ::= strToCodes(String) [function]
  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
  rule strToCodes("") => .IntSeq
  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128

  // ==== operators: + / == / != / in =========================================
  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
  rule seqConcat(.IntSeq, T:IntSeq)                => T
  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))

  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)

  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)

  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
  rule strPrefix(.IntSeq, _:IntSeq)               => true
  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)

  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
       requires notBool strPrefix(P, iCons(C, Xs))

  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
  // str </<=/>/>= comparisons.
  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
  rule strLt(.IntSeq, .IntSeq)                => false
  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B

  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
endmodule
// reference/src/semantics/builtins.k — MPY-BUILTINS

module MPY-BUILTINS
  imports MPY-CORE
  imports MPY-STR
  imports MPY-SET
  imports MPY-ITER
  imports MPY-RANGE
  imports MPY-INT
  imports MPY-METHODS

  // the builtins REGISTRY is core.k's builtinsScope (the -1 frame); names resolve by lookup

  // Call routing + argument evaluation live in call.k, which also routes the fold
  // builtins (sum/all/any/max/min) to the #_Acc folds below and everything else to
  // applyBuiltin. This module owns applyBuiltin + the fold implementations.
  syntax Val ::= applyBuiltin(String, Vals) [function]

  // ==== len(obj) — O(1) per kind ============================================
  syntax Int ::= seqLen(Val) [function]
  rule applyBuiltin("len", OBJ:Val, .Vals) => seqLen(OBJ)
  rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
  rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
  rule seqLen(str(IS:IntSeq))                   => isLen(IS)
  rule seqLen(setV(DS:IntSeq))                  => isLen(DS)
  rule seqLen(rangeObj(LO:Int, HI:Int, ST:Int)) => rangeLen(LO, HI, ST)

  // ==== list(seq) — materialize a list/tuple into a list (e.g. list(d.keys())) ==
  // Minimal: the "copy a sequence" case (list of a list is itself; list of a tuple keeps order).
  // list() of other iterables (str/range/set/zip) is added via the iterator fold when needed.
  // (k-cell — list() constructs a NEW object)
  rule <k> #applyK(toCall(builtinV("list")), (list(VS:ValSeq),  .Vals)) => #alloc(list(VS)) ... </k>
  rule <k> #applyK(toCall(builtinV("list")), (tuple(VS:ValSeq), .Vals)) => #alloc(list(VS)) ... </k>
  rule <k> #applyK(toCall(builtinV("list")), .Vals)                     => #alloc(list(.ValSeq)) ... </k>
  rule <k> #applyK(toCall(builtinV("list")), (str(CS:IntSeq), .Vals))   => #alloc(list(charsOf(CS))) ... </k>
  syntax ValSeq ::= charsOf(IntSeq) [function, total]
  rule charsOf(.IntSeq)                => .ValSeq
  rule charsOf(iCons(C:Int, R:IntSeq)) => vCons(str(iCons(C, .IntSeq)), charsOf(R))

  // ==== set(str) — distinct character codes =================================
  rule applyBuiltin("set", str(CS:IntSeq), .Vals) => setV(dedupCodes(CS))

  // ==== abs(int) ============================================================
  rule applyBuiltin("abs", I:Int, .Vals) => absInt(I)

  // ==== sum(iterable) — one #iterNext fold; intOf = int value of an int/bool ==
  syntax KItem ::= #sumAcc(Iterable, Int) | #sumCont(Int)
  rule <k> #sumAcc(IT:Iterable, ACC:Int) => #iterNext(IT) ~> #sumCont(ACC) ... </k>
  rule <k> #iterDone ~> #sumCont(ACC:Int) => ACC ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
        => #sumAcc(R, ACC +Int intOf(V)) ... </k>
       requires isInt(V) orBool isBool(V)

  syntax Int ::= intOf(Val) [function]
  rule intOf(I:Int)  => I
  rule intOf(B:Bool) => #if B #then 1 #else 0 #fi

  // ==== all / any (short-circuiting #iterNext folds) ========================
  syntax KItem ::= #allAcc(Iterable) | "#allCont"
  rule <k> #allAcc(IT:Iterable) => #iterNext(IT) ~> #allCont ... </k>
  rule <k> #iterDone ~> #allCont => true ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #allCont => #allAcc(R) ... </k>
       requires truthy(V)
  rule <k> #iterYield(V:Val, _:Iterable) ~> #allCont => false ... </k>
       requires notBool truthy(V)

  syntax KItem ::= #anyAcc(Iterable) | "#anyCont"
  rule <k> #anyAcc(IT:Iterable) => #iterNext(IT) ~> #anyCont ... </k>
  rule <k> #iterDone ~> #anyCont => false ... </k>
  rule <k> #iterYield(V:Val, _:Iterable) ~> #anyCont => true ... </k>
       requires truthy(V)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #anyCont => #anyAcc(R) ... </k>
       requires notBool truthy(V)

  // ==== max / min over an iterable (#iterNext folds; first element seeds) ====
  syntax KItem ::= #maxAcc0(Iterable) | "#maxCont0" | #maxAcc(Iterable, Int) | #maxCont(Int)
  rule <k> #maxAcc0(IT:Iterable) => #iterNext(IT) ~> #maxCont0 ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAcc(R, {V}:>Int) ... </k>
       requires isInt(V)
  rule <k> #maxAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #maxCont(M) ... </k>
  rule <k> #iterDone ~> #maxCont(M:Int) => M ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)
        => #maxAcc(R, maxInt(M, {V}:>Int)) ... </k>
       requires isInt(V)

  syntax KItem ::= #minAcc0(Iterable) | "#minCont0" | #minAcc(Iterable, Int) | #minCont(Int)
  rule <k> #minAcc0(IT:Iterable) => #iterNext(IT) ~> #minCont0 ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAcc(R, {V}:>Int) ... </k>
       requires isInt(V)
  rule <k> #minAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #minCont(M) ... </k>
  rule <k> #iterDone ~> #minCont(M:Int) => M ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)
        => #minAcc(R, minInt(M, {V}:>Int)) ... </k>
       requires isInt(V)

  // ---- general Val branch of the max/min folds (v3) ------------------------
  // The Int fold above and the Float fold (float.k) cover homogeneous lists; the
  // remaining CPython-orderable seeds (Bool, str) and every cross-sort step land
  // here. Ordering reuses the semantics' OWN applyCmp dispatch (int.k; float.k's
  // exact ltIF/ltFI bridges; bool.k's bool->int promotion; str.k's strLt), so
  // mixed comparisons stay bit-exact with CPython; a pair applyCmp does not
  // order (e.g. int vs str) leaves the fold stuck (unmodeled TypeError).
  // Strict > (resp. <) replacement keeps the FIRST maximal (minimal) element —
  // CPython's tie rule.
  syntax KItem ::= #maxAccV(Iterable, Val) | #maxContV(Val)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccV(R, V) ... </k>
       requires isBool(V) orBool isStr(V)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)
        => #iterYield(V, R) ~> #maxContV(M) ... </k>
       requires isFloat(V) orBool isBool(V)
  rule <k> #maxAccV(IT:Iterable, M:Val) => #iterNext(IT) ~> #maxContV(M) ... </k>
  rule <k> #iterDone ~> #maxContV(M:Val) => M ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContV(M:Val) => #maxAccV(R, V) ... </k>
       requires applyCmp(">", V, M)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContV(M:Val) => #maxAccV(R, M) ... </k>
       requires notBool applyCmp(">", V, M)

  syntax KItem ::= #minAccV(Iterable, Val) | #minContV(Val)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccV(R, V) ... </k>
       requires isBool(V) orBool isStr(V)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)
        => #iterYield(V, R) ~> #minContV(M) ... </k>
       requires isFloat(V) orBool isBool(V)
  rule <k> #minAccV(IT:Iterable, M:Val) => #iterNext(IT) ~> #minContV(M) ... </k>
  rule <k> #iterDone ~> #minContV(M:Val) => M ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContV(M:Val) => #minAccV(R, V) ... </k>
       requires applyCmp("<", V, M)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContV(M:Val) => #minAccV(R, M) ... </k>
       requires notBool applyCmp("<", V, M)

  // ==== variadic max / min (a Vals fold) ====================================
  // v3: Val operands (mixed int/float/bool, str) via the same applyCmp
  // dispatch; strict > / < keeps the FIRST maximal/minimal operand (CPython's
  // tie rule — and exactly the old maxInt/minInt fold on the all-Int domain).
  syntax Val ::= maxVals(Val, Vals) [function]
  rule applyBuiltin("max", I:Int, REST:Vals) => maxVals(I, REST)
  rule applyBuiltin("max", V:Val, (V2:Val, REST:Vals)) => maxVals(V, (V2, REST))
       requires isFloat(V) orBool isBool(V) orBool isStr(V)
  rule maxVals(M:Val, .Vals)           => M
  rule maxVals(M:Val, (V:Val, R:Vals)) => maxVals(V, R) requires applyCmp(">", V, M)
  rule maxVals(M:Val, (V:Val, R:Vals)) => maxVals(M, R) requires notBool applyCmp(">", V, M)

  syntax Val ::= minVals(Val, Vals) [function]
  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
  rule applyBuiltin("min", V:Val, (V2:Val, REST:Vals)) => minVals(V, (V2, REST))
       requires isFloat(V) orBool isBool(V) orBool isStr(V)
  rule minVals(M:Val, .Vals)           => M
  rule minVals(M:Val, (V:Val, R:Vals)) => minVals(V, R) requires applyCmp("<", V, M)
  rule minVals(M:Val, (V:Val, R:Vals)) => minVals(M, R) requires notBool applyCmp("<", V, M)

  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
       requires N >=Int 0
  // negative operand: the '-' sign prefixes the magnitude's digits
  rule applyBuiltin("bin", N:Int, .Vals)
    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
       requires N <Int 0
  syntax IntSeq ::= binCodes(Int) [function, total]
  rule binCodes(0) => iCons(48, .IntSeq)
  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
  rule binAcc(0, ACC:IntSeq) => ACC
  rule binAcc(N:Int, ACC:IntSeq)
    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
       requires N >Int 0

  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
        => #alloc(list(enumVS(VS, 0))) ... </k>
  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
  rule enumVS(.ValSeq, _:Int) => .ValSeq
  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))

  // ==== map(str, xs) — eager (only the str case is in the subset) =============
  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
        => #alloc(list(mapStrVS(VS))) ... </k>
  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
  rule mapStrVS(.ValSeq) => .ValSeq
  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))

  // ==== int(x) identities (int(round(x)) composes through) ====================
  rule applyBuiltin("int", I:Int, .Vals) => I

  // ==== ord / chr ===========================================================
  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
       requires 0 <=Int I andBool I <Int 128

  // ==== str(int) / str(str) =================================================
  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)

  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
       requires 48 <=Int C andBool C <=Int 57

  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
       requires isLen(CS) >=Int 2
  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))

  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)

  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>

  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
       requires S =/=Int 0

  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
  // trusted pass evaluator, now DEFINED in the reference and driven by a
  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
  // argument leaves the call unevaluated for problem-level folds.
  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
  syntax Int ::= evalArith(IntSeq) [function]
  rule evalArith(CS:IntSeq)
    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))

  syntax OpSeq ::= ".OpSeq" | oCons(String, OpSeq)

  syntax Bool ::= evDigit(Int) [function, total]
  rule evDigit(C:Int) => C >=Int 48 andBool C <=Int 57
  syntax Bool ::= evHead42(IntSeq) [function, total]
  rule evHead42(iCons(42, _:IntSeq)) => true
  rule evHead42(_:IntSeq)            => false [owise]
  syntax Bool ::= evHead47(IntSeq) [function, total]
  rule evHead47(iCons(47, _:IntSeq)) => true
  rule evHead47(_:IntSeq)            => false [owise]

  syntax OpSeq ::= tokOps(IntSeq) [function, total]
  rule tokOps(.IntSeq)                 => .OpSeq
  rule tokOps(iCons(32, R:IntSeq))     => tokOps(R)
  rule tokOps(iCons(C:Int, R:IntSeq))  => tokOps(R) requires evDigit(C)
  rule tokOps(iCons(42, iCons(42, R:IntSeq))) => oCons("**", tokOps(R))
  rule tokOps(iCons(42, R:IntSeq))     => oCons("*", tokOps(R)) requires notBool evHead42(R)
  rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons("//", tokOps(R))
  rule tokOps(iCons(47, R:IntSeq))     => oCons("/", tokOps(R)) requires notBool evHead47(R)
  rule tokOps(iCons(43, R:IntSeq))     => oCons("+", tokOps(R))
  rule tokOps(iCons(45, R:IntSeq))     => oCons("-", tokOps(R))

  syntax IntSeq ::= tokNds(IntSeq) [function, total]
                  | tokNdAcc(Int, IntSeq) [function, total]
  rule tokNds(.IntSeq)                => .IntSeq

