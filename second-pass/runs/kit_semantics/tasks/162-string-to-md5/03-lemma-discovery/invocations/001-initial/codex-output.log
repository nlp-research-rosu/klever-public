import json
from pathlib import Path

allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inv['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == len(out['rules'])
for r in out['rules']:
    assert list(r.keys()) == ['source_rule_id', 'classification', 'rationale']
    assert r['classification'] in allowed
    assert isinstance(r['rationale'], str) and r['rationale'].strip()

for source, classified in zip(inv['rules'], out['rules']):
    attrs = source.get('attributes', [])
    if isinstance(attrs, str):
        has_simplification = 'simplification' in attrs
    else:
        has_simplification = any('simplification' in str(a) for a in attrs)
    if has_simplification:
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

text = Path('/workspace/DISCOVERY.md').read_text()
assert 'There are no separately proved derived lemmas.' in text
assert 'The domain-lemma set is empty.' in text
print('schema_keys=PASS')
print('inventory_sha256=PASS', out['inventory_sha256'])
print('canonical_rule_count=', len(inv['rules']))
print('classified_rule_count=', len(out['rules']))
print('order_and_uniqueness=PASS')
print('classification_and_rationale_constraints=PASS')
print('simplification_constraint=PASS')
print('discovery_required_statements=PASS')
