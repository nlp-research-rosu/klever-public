+}
+checks["obligation_map_hash"] = generator_manifest.get(
+    "obligation_map_sha256"
+) == hashlib.sha256((generated / "obligation-map.json").read_bytes()).hexdigest()
+checks["manifest_obligation_count_zero"] = (
