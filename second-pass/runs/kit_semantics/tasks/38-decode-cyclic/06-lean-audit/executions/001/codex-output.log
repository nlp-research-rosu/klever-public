+        "return_sort": "IntSeq",
+    },
+    {
+        "name": "finalLoopChar",
+        "argument_sorts": ["IntSeq", "Val"],
+        "return_sort": "Val",
+    },
+]
+checks["summary_signature_identity"] = (
