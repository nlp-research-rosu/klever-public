+print(f"obligation_count={len(obligation_map['obligations'])}")
+print(f"expected_target={expected_target!r}")
+print(f"observed_target={observed_target!r}")
+ok = all(checks.values())
+print(f"OVERALL={'PASS' if ok else 'FAIL'}")
