+      "source_rule_id": "rule-b75007273ddfec4a9357ba26cdca2d47ef06a615dbb678c59ff81151a6f259b4",
+      "classification": "DEFINITION",
+      "rationale": "This is the empty-iterator base equation defining finalLoopChar to preserve the loop target's prior value."
+    },
+    {
+      "source_rule_id": "rule-9d892364275b939a50532c29aa15281c55ccadc0974c27de6d7718ff2195ff25",
