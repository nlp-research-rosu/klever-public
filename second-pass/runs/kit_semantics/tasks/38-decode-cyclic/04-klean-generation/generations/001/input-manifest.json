{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "5fadedd1d4c059e5d87c1e443849dc7c59bbb473b8aaa92234cfd709eb0715b6",
      "rationale": "This macro equation defines decodeLoopBody by expanding the named proof term to the exact translated loop-body AST; it is a parse-time abbreviation and not an execution rule or an additional mathematical fact.",
      "source_rule_id": "rule-5fadedd1d4c059e5d87c1e443849dc7c59bbb473b8aaa92234cfd709eb0715b6",
      "start_line": 8,
      "text": "  rule decodeLoopBody\n    => Assign(Name(\"group\"), BinOp(\"+\", Name(\"group\"), Name(\"char\")))\n       If(\n         Compare(Call(Name(\"len\"), Name(\"group\")), CmpOp(\"==\", Int(3))),\n         Assign(\n           Name(\"result\"),\n           BinOp(\n             \"+\",\n             Name(\"result\"),\n             BinOp(\n               \"+\",\n               Subscript(Name(\"group\"), Int(2)),\n               Subscript(\n                 Name(\"group\"),\n                 Slice(NoBound, Int(2), NoBound)))))\n         Assign(Name(\"group\"), Str(\"\")),\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "5367ffff4eaecfb0f84c53b77dc54d061b07006110880a94d6e194146a40ce02",
      "rationale": "This macro equation defines decodeFunctionBody as the exact translated function-body AST, using decodeLoopBody as an abbreviation; it names source syntax rather than adding operational behavior or a reusable lemma.",
      "source_rule_id": "rule-5367ffff4eaecfb0f84c53b77dc54d061b07006110880a94d6e194146a40ce02",
      "start_line": 27,
      "text": "  rule decodeFunctionBody\n    => Expr(\n         Str(\n           \"\\n    Takes a string encoded by rotating each complete three-character group\\n    left once, and restores the original string.\\n    \"))\n       Assign(Name(\"result\"), Str(\"\"))\n       Assign(Name(\"group\"), Str(\"\"))\n       Assign(Name(\"char\"), Str(\"\"))\n       For(Name(\"char\"), Name(\"s\"), decodeLoopBody)\n       Return(BinOp(\"+\", Name(\"result\"), Name(\"group\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "c4174d53c8a3154eebdb9e22c2b92a55e58050b2e3bff8ae7f82b3e27c28ffd1",
      "rationale": "This is the empty-input base equation of the total decodedResult accumulator recurrence, defining that no remaining codes leave the accumulator unchanged.",
      "source_rule_id": "rule-c4174d53c8a3154eebdb9e22c2b92a55e58050b2e3bff8ae7f82b3e27c28ffd1",
      "start_line": 39,
      "text": "  rule decodedResult(ACC:IntSeq, .IntSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 40,
      "module": "VERIFICATION",
      "normalized_sha256": "ffb0732d27afbf362e5e9e9fc010a57098d520ce352d603a3a975a24f8ed22de",
      "rationale": "This is the one-code base equation of decodedResult, defining that an incomplete final group contributes no complete decoded chunk to the accumulator.",
      "source_rule_id": "rule-ffb0732d27afbf362e5e9e9fc010a57098d520ce352d603a3a975a24f8ed22de",
      "start_line": 40,
      "text": "  rule decodedResult(ACC:IntSeq, iCons(_:Int, .IntSeq)) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "1843eb0bcc3ef5cefdf6645c4f7f131e4c0a1a17c02878b5b5b7d1b5bae0eb4c",
      "rationale": "This is the two-code base equation of decodedResult, defining that an incomplete two-code final group contributes no complete decoded chunk to the accumulator.",
      "source_rule_id": "rule-1843eb0bcc3ef5cefdf6645c4f7f131e4c0a1a17c02878b5b5b7d1b5bae0eb4c",
      "start_line": 41,
      "text": "  rule decodedResult(\n         ACC:IntSeq,\n         iCons(_:Int, iCons(_:Int, .IntSeq)))\n    => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 52,
      "module": "VERIFICATION",
      "normalized_sha256": "58ccf33b1f5982228861b7117175665717d215e2db7474767affb4f2e1a99294",
      "rationale": "This is the recursive decodedResult equation: it defines one complete triple's right rotation in the accumulator and recurs on the structurally smaller remainder.",
      "source_rule_id": "rule-58ccf33b1f5982228861b7117175665717d215e2db7474767affb4f2e1a99294",
      "start_line": 45,
      "text": "  rule decodedResult(\n         ACC:IntSeq,\n         iCons(A:Int, iCons(B:Int, iCons(C:Int, R:IntSeq))))\n    => decodedResult(\n         seqConcat(\n           ACC,\n           iCons(C, iCons(A, iCons(B, .IntSeq)))),\n         R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "48f99ba4e9cf5b2f361e19b875ced9ff0a79d3e558b60b093674a0264a84ab08",
      "rationale": "This is the empty-sequence base equation defining decodedTail for a final group of length zero.",
      "source_rule_id": "rule-48f99ba4e9cf5b2f361e19b875ced9ff0a79d3e558b60b093674a0264a84ab08",
      "start_line": 56,
      "text": "  rule decodedTail(.IntSeq) => .IntSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 57,
      "module": "VERIFICATION",
      "normalized_sha256": "0048c482596ccb952ad0ec9470e8ee307fe5f9d342a83640df98cd2ef84f0d54",
      "rationale": "This equation defines decodedTail for a one-code incomplete group by returning that code unchanged.",
      "source_rule_id": "rule-0048c482596ccb952ad0ec9470e8ee307fe5f9d342a83640df98cd2ef84f0d54",
      "start_line": 57,
      "text": "  rule decodedTail(iCons(A:Int, .IntSeq)) => iCons(A, .IntSeq)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 59,
      "module": "VERIFICATION",
      "normalized_sha256": "405f2fc1f12cf0c83faacc269a24d82e70b4f1fee61206e5ef7273f5f73a983c",
      "rationale": "This equation defines decodedTail for a two-code incomplete group by returning both codes unchanged.",
      "source_rule_id": "rule-405f2fc1f12cf0c83faacc269a24d82e70b4f1fee61206e5ef7273f5f73a983c",
      "start_line": 58,
      "text": "  rule decodedTail(iCons(A:Int, iCons(B:Int, .IntSeq)))\n    => iCons(A, iCons(B, .IntSeq))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 61,
      "module": "VERIFICATION",
      "normalized_sha256": "f70ecf73c4b2aeaeb9064d85808f3afd9764972e7dfef3aeb0fc5bc32d56f84b",
      "rationale": "This recursive equation defines decodedTail by discarding each complete three-code group and continuing on the structurally smaller remainder.",
      "source_rule_id": "rule-f70ecf73c4b2aeaeb9064d85808f3afd9764972e7dfef3aeb0fc5bc32d56f84b",
      "start_line": 60,
      "text": "  rule decodedTail(iCons(_:Int, iCons(_:Int, iCons(_:Int, R:IntSeq))))\n    => decodedTail(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 65,
      "module": "VERIFICATION",
      "normalized_sha256": "813dfdbb1d8c4c8262f557071f5ddb487fa764c1744a74ef71ad94e9bc4e44d5",
      "rationale": "This equation defines decodeCodes as the composition of the complete-group accumulator summary and the unchanged incomplete tail.",
      "source_rule_id": "rule-813dfdbb1d8c4c8262f557071f5ddb487fa764c1744a74ef71ad94e9bc4e44d5",
      "start_line": 64,
      "text": "  rule decodeCodes(IS:IntSeq)\n    => seqConcat(decodedResult(.IntSeq, IS), decodedTail(IS))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 70,
      "module": "VERIFICATION",
      "normalized_sha256": "b75007273ddfec4a9357ba26cdca2d47ef06a615dbb678c59ff81151a6f259b4",
      "rationale": "This is the empty-iterator base equation defining finalLoopChar to preserve the loop target's prior value.",
      "source_rule_id": "rule-b75007273ddfec4a9357ba26cdca2d47ef06a615dbb678c59ff81151a6f259b4",
      "start_line": 70,
      "text": "  rule finalLoopChar(.IntSeq, OLD:Val) => OLD"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 72,
      "module": "VERIFICATION",
      "normalized_sha256": "9d892364275b939a50532c29aa15281c55ccadc0974c27de6d7718ff2195ff25",
      "rationale": "This recursive equation defines finalLoopChar by recording the current one-character string and continuing over the structurally smaller iterator remainder.",
      "source_rule_id": "rule-9d892364275b939a50532c29aa15281c55ccadc0974c27de6d7718ff2195ff25",
      "start_line": 71,
      "text": "  rule finalLoopChar(iCons(C:Int, R:IntSeq), _:Val)\n    => finalLoopChar(R, str(iCons(C, .IntSeq)))"
    }
  ],
