+                .Stmts) .Stmts,
+              .Stmts)
+            Assign(Name("odd"), Bool(false)) .Stmts)
+          Return(Name("result")) .Stmts)
+        Assign(
+          Name("$result"),
+          Call(
+            Name("add"),
+            list(vCons(4, vCons(2, vCons(6, vCons(7, .ValSeq)))))))
+          .Stmts))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "add"     |-> ?ADD:Val
+        "$result" |-> 2,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
