+              .Stmts)
+            Assign(Name("odd"), UnaryOp("not", Name("odd"))) .Stmts)
+          Return(Name("result")) .Stmts)
+        Assign(
+          Name("$result"),
+          Call(
+            Name("add"),
+            list(vCons(1, vCons(-2, vCons(3, vCons(-4, .ValSeq)))))))
+          .Stmts))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "add"     |-> ?ADD:Val
+        "$result" |-> -5,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
