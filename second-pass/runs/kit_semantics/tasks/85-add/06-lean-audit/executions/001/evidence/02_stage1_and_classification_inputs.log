     3	module VERIFICATION-SYNTAX
     4	  imports MPY
     5	
     6	  // Recursive domain predicate for arbitrary finite semantic integer lists.
     7	  syntax Bool ::= allInts(ValSeq) [function, total]
     8	
     9	  // A guarded total twin of the partial Val-to-Int subsort projection.  It has
    10	  // no evaluator and can only collapse to a value already known to be an Int.
    11	  syntax Bool ::= definedProjectInt(Val) [function, total]
    12	  syntax Int ::= projectIntTotal(Val)
    13	    [function, total, symbol(projectIntTotal), no-evaluators]
    14	
    15	  // addSummary(VS, ODD) is the mathematical sum still to be accumulated
    16	  // while traversing VS, where ODD is the parity of the next index.
    17	  syntax Int ::= addSummary(ValSeq, Bool) [function, total]
    18	endmodule
    19	
    20	module VERIFICATION
    21	  imports VERIFICATION-SYNTAX
    22	
    23	  rule allInts(.ValSeq) => true
    24	  rule allInts(vCons(V:Val, VS:ValSeq))
    25	    => isInt(V) andBool allInts(VS)
    26	
    27	  rule definedProjectInt(V:Val) => isInt(V)
    28	
    29	  // Standard guarded-total-projection characterization (the ceils.k idiom).
    30	  rule #Ceil({@V:Val}:>Int)
    31	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    32	    [simplification]
    33	  rule projectIntTotal(V:Val) => {V}:>Int
    34	    requires definedProjectInt(V)
    35	    [concrete, simplification(10), preserves-definedness]
    36	  rule {V:Val}:>Int => projectIntTotal(V)
    37	    requires definedProjectInt(V)
    38	    [symbolic(V), simplification, preserves-definedness]
    39	  rule projectIntTotal(I:Int) => I [simplification]
    40	  rule projectIntTotal(projectIntTotal(V:Val))
    41	    => projectIntTotal(V) [simplification]
    42	
    43	  // Guarded dispatch twins of the exact MPY-INT equations.  These compensate
    44	  // only for the backend's lack of path-condition-based static sort refinement.
    45	  rule applyBin("%", V:Val, I:Int)
    46	    => pyMod(projectIntTotal(V), I)
    47	    requires isInt(V)
    48	    [simplification]
    49	  rule applyBin("+", I:Int, V:Val)
    50	    => I +Int projectIntTotal(V)
    51	    requires isInt(V)
    52	    [simplification]
    53	
    54	  // Definitional postcondition summary.  It does not rewrite program syntax or
    55	  // operational K items: the supplied MPY rules execute the complete body.
    56	  rule addSummary(.ValSeq, _:Bool) => 0
    57	  rule addSummary(vCons(_:Val, VS:ValSeq), false)
    58	    => addSummary(VS, true)
    59	  rule addSummary(vCons(V:Val, VS:ValSeq), true)
    60	    => (#if pyMod(projectIntTotal(V), 2) ==Int 0
    61	        #then projectIntTotal(V)
    62	        #else 0
    63	        #fi)
    64	       +Int addSummary(VS, false)
    65	endmodule
