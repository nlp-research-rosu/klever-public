@@ -0,0 +1,163 @@
+import Proof
+
+namespace BridgeAudit
+
+-- Adversarial ground witnesses for every generated target parameter.
+example : Proof.«_+Int_» (-7) 12 = 5 := by decide
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "%" (SortVal.inj_SortInt (-5)) (SortVal.inj_SortInt 2)
+      = SortVal.inj_SortInt 1 := by
+  rfl
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt (-7)) (SortVal.inj_SortInt 12)
+      = SortVal.inj_SortInt 5 := by
+  rfl
+
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+      (SortVal.inj_SortInt (-13)) = true := by
+  rfl
+
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+      (SortVal.inj_SortBool true) = false := by
+  rfl
+
+example :
+    Proof.isInt
+      (SortK.kseq (SortKItem.inj_SortInt (-13)) SortK.dotk) = true := by
+  rfl
+
+example :
+    Proof.isInt
+      (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = false := by
+  rfl
+
+example :
+    Proof.isInt
+      (SortK.kseq
+        (SortKItem.inj_SortInt 4)
+        (SortK.kseq (SortKItem.inj_SortInt 5) SortK.dotk)) = false := by
+  rfl
+
+example :
+    Proof.projectIntTotal (SortVal.inj_SortInt (-13)) = -13 := by
+  rfl
+
+example :
+    Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-5) 2 = 1 := by
+  decide
+
+example :
+    Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» 5 (-2) = -1 := by
+  decide
+
+example :
+    Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» 7 0 = 0 := by
+  rfl
+
+example :
+    Proof.«project:Int?»
+      (SortK.kseq (SortKItem.inj_SortInt (-13)) SortK.dotk)
+      = some (-13) := by
+  rfl
+
+example :
+    Proof.«project:Int?»
+      (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk)
+      = none := by
+  rfl
+
+-- Counterfactual mutations are rejected by concrete witnesses.
+def badPlus (_ _ : SortInt) : SortInt := 0
+def badApply (_ : SortString) (_ _ : SortVal) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+def badDefined (_ : SortVal) : SortBool := true
+def badProjectTotal (_ : SortVal) : SortInt := 0
+def badPyMod (_ _ : SortInt) : SortInt := 0
+def badProject (_ : SortK) : Option SortInt := none
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 2)
+      ≠ SortVal.inj_SortInt
+          (badPlus 1 (Proof.projectIntTotal (SortVal.inj_SortInt 2))) := by
+  intro h
+  cases h
+
+example :
+    badApply "%" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 2)
+      ≠ SortVal.inj_SortInt
+          (Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+            (Proof.projectIntTotal (SortVal.inj_SortInt 1)) 2) := by
+  intro h
+  cases h
+
+example :
+    (((Proof.«project:Int?»
+        (SortK.kseq
+          (SortKItem.inj_SortBool true)
+          SortK.dotk)).isSome = true)
+      ↔ ((badDefined (SortVal.inj_SortBool true) = true) ∧ True)) = False := by
+  decide
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 2)
+      ≠ SortVal.inj_SortInt
+          (Proof.«_+Int_» 1
+            (badProjectTotal (SortVal.inj_SortInt 2))) := by
+  intro h
+  cases h
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "%" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 2)
+      ≠ SortVal.inj_SortInt
+          (badPyMod
+            (Proof.projectIntTotal (SortVal.inj_SortInt 1)) 2) := by
+  intro h
+  cases h
+
+example :
+    (((badProject
+        (SortK.kseq
+          (SortKItem.inj_SortInt 3)
+          SortK.dotk)).isSome = true)
+      ↔
+      ((Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+          (SortVal.inj_SortInt 3) = true) ∧ True)) = False := by
+  decide
+
+-- This dishonest guard makes the two guarded rules vacuous.  It is why the
+-- operational audit of the actual candidate definition is indispensable.
+def badIsInt (_ : SortK) : SortBool := false
+
+theorem badIsIntStillSatisfiesTarget :
+    Klean85Add.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+      badIsInt
+      Proof.projectIntTotal
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«project:Int?» := by
+  constructor
+  · intro V
+    cases V <;>
+      simp [
+        Proof.«project:Int?»,
+        Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»,
+        inj
+      ]
+  constructor
+  · intro I V h
+    simp [badIsInt] at h
+  · intro V I h
+    simp [badIsInt] at h
+
+end BridgeAudit
diff --git a/evidence/proc_exe_readlink_shim.c b/evidence/proc_exe_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..4cb5903b39165ca3700ee8f62c5d9f76c3f72b57
--- /dev/null
+++ b/evidence/proc_exe_readlink_shim.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t length;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    length = strlen(path);
+    if (strncmp(path, prefix, sizeof(prefix) - 1) == 0
+        && length >= sizeof(suffix) - 1
+        && strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+
+    return real_readlink(path, buffer, size);
+}

codex
The fresh candidate build and exact `#print axioms` check pass. The seven bridge definitions also pass ground adversarial checks (negative modulo/divisor, non-Int values, and nontrivial K continuations). Counterfactual constant implementations fail concrete witnesses; a deliberately false `isInt` can make guarded obligations vacuous, confirming why the required semantic bridge audit—not the Lean theorem alone—is load-bearing. The actual `isInt` definition matches the frozen sort predicate and has satisfiable Int witnesses.
apply patch
