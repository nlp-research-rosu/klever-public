+        Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»,
+        inj
+      ]
+  constructor
+  · intro I V h
+    simp [badIsInt] at h
+  · intro V I h
+    simp [badIsInt] at h
+
+end BridgeAudit
