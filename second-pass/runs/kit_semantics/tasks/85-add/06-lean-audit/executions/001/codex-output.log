+      = SortVal.inj_SortInt 1 := by
+  rfl
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt (-7)) (SortVal.inj_SortInt 12)
+      = SortVal.inj_SortInt 5 := by
+  rfl
+
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+      (SortVal.inj_SortInt (-13)) = true := by
+  rfl
+
+example :
+    Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+      (SortVal.inj_SortBool true) = false := by
+  rfl
+
+example :
+    Proof.isInt
+      (SortK.kseq (SortKItem.inj_SortInt (-13)) SortK.dotk) = true := by
+  rfl
+
+example :
+    Proof.isInt
+      (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = false := by
+  rfl
+
+example :
+    Proof.isInt
+      (SortK.kseq
+        (SortKItem.inj_SortInt 4)
+        (SortK.kseq (SortKItem.inj_SortInt 5) SortK.dotk)) = false := by
+  rfl
+
+example :
+    Proof.projectIntTotal (SortVal.inj_SortInt (-13)) = -13 := by
+  rfl
+
+example :
+    Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-5) 2 = 1 := by
+  decide
+
+example :
+    Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» 5 (-2) = -1 := by
+  decide
+
+example :
+    Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» 7 0 = 0 := by
+  rfl
+
+example :
+    Proof.«project:Int?»
+      (SortK.kseq (SortKItem.inj_SortInt (-13)) SortK.dotk)
+      = some (-13) := by
+  rfl
+
+example :
+    Proof.«project:Int?»
+      (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk)
+      = none := by
+  rfl
+
+-- Counterfactual mutations are rejected by concrete witnesses.
+def badPlus (_ _ : SortInt) : SortInt := 0
+def badApply (_ : SortString) (_ _ : SortVal) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+def badDefined (_ : SortVal) : SortBool := true
+def badProjectTotal (_ : SortVal) : SortInt := 0
+def badPyMod (_ _ : SortInt) : SortInt := 0
+def badProject (_ : SortK) : Option SortInt := none
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 2)
+      ≠ SortVal.inj_SortInt
+          (badPlus 1 (Proof.projectIntTotal (SortVal.inj_SortInt 2))) := by
+  intro h
+  cases h
+
+example :
+    badApply "%" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 2)
+      ≠ SortVal.inj_SortInt
+          (Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+            (Proof.projectIntTotal (SortVal.inj_SortInt 1)) 2) := by
+  intro h
+  cases h
+
+example :
+    (((Proof.«project:Int?»
+        (SortK.kseq
+          (SortKItem.inj_SortBool true)
+          SortK.dotk)).isSome = true)
+      ↔ ((badDefined (SortVal.inj_SortBool true) = true) ∧ True)) = False := by
+  decide
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 2)
+      ≠ SortVal.inj_SortInt
+          (Proof.«_+Int_» 1
+            (badProjectTotal (SortVal.inj_SortInt 2))) := by
+  intro h
+  cases h
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "%" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 2)
+      ≠ SortVal.inj_SortInt
+          (badPyMod
+            (Proof.projectIntTotal (SortVal.inj_SortInt 1)) 2) := by
+  intro h
+  cases h
+
+example :
+    (((badProject
+        (SortK.kseq
+          (SortKItem.inj_SortInt 3)
+          SortK.dotk)).isSome = true)
+      ↔
+      ((Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+          (SortVal.inj_SortInt 3) = true) ∧ True)) = False := by
+  decide
+
+-- This dishonest guard makes the two guarded rules vacuous.  It is why the
+-- operational audit of the actual candidate definition is indispensable.
+def badIsInt (_ : SortK) : SortBool := false
+
+theorem badIsIntStillSatisfiesTarget :
+    Klean85Add.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+      badIsInt
