+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«project:Int?» := by
+  constructor
+  · intro V
+    cases V <;>
+      simp [
+        Proof.«project:Int?»,
+        Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»,
+        inj
+      ]
+  constructor
+  · intro I V h
+    simp [badIsInt] at h
+  · intro V I h
+    simp [badIsInt] at h
+
+end BridgeAudit
