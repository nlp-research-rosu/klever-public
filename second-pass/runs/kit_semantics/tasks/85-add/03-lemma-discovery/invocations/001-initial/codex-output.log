canonical_ids = [r['source_rule_id'] for r in canonical['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == canonical_ids
assert len(out_ids) == len(set(out_ids)) == len(canonical_ids)
