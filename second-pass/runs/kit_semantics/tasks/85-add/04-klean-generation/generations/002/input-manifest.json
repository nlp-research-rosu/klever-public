      "start_line": 24,
      "text": "  rule allInts(vCons(V:Val, VS:ValSeq))\n    => isInt(V) andBool allInts(VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
