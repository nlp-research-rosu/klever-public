      "start_line": 33,
      "text": "  rule projectIntTotal(V:Val) => {V}:>Int\n    requires definedProjectInt(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
