      "module": "VERIFICATION",
      "normalized_sha256": "9e1486b6d25b62bd0949213fd58d7aac97ed89cc3e87b8c5063f915d1d6b7081",
      "rationale": "Canonicalization equation fixing the idempotent normal form of the named projectIntTotal proof term.",
