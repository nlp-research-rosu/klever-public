      "start_line": 27,
      "text": "  rule definedProjectInt(V:Val) => isInt(V)"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "rationale": "Guarded defining equation for the new named proof term projectIntTotal in terms of the partial Int cast.",
