/bin/bash -lc 'chmod +x prove.sh
bash -n prove.sh
python3 py2mpy.py solution.py | cmp - solution.mpy
python3 py2mpy.py smoke.py | cmp - smoke.mpy
ls -l solution.py solution.mpy verification.k spec.k prove.sh' in /workspace
