+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("value"),
+        If(
+          Name("odd"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(0))),
+            AugAssign(Name("result"), "+", Name("value")) .Stmts,
+            .Stmts) .Stmts,
+          .Stmts)
+        Assign(Name("odd"), UnaryOp("not", Name("odd"))) .Stmts)
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "lst"    |-> INPUT:Val
+        "result" |-> (ACC:Int => ACC +Int addSummary(VS, ODD))
+        "odd"    |-> (ODD:Bool => ?FINALODD:Bool)
+        "value"  |-> (_CURRENT:Val => ?FINALVALUE:Val),
+        P:Parent)
+      ...
+    </scopes>
+    requires allInts(VS)
+
+  // Whole-entry theorem.  The exact translated body is defined, looked up,
+  // called, and executed under MPY.  The precondition is precisely the
+  // contract's non-empty, otherwise-unbounded finite integer-list domain.
+  claim [add-entry]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "add",
+          Params("lst"),
+          Assign(Name("result"), Int(0))
+          Assign(Name("odd"), Bool(false))
+          Assign(Name("value"), Int(0))
+          For(
+            Name("value"),
+            Name("lst"),
+            If(
+              Name("odd"),
+              If(
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))),
+                AugAssign(Name("result"), "+", Name("value")) .Stmts,
+                .Stmts) .Stmts,
+              .Stmts)
+            Assign(Name("odd"), UnaryOp("not", Name("odd"))) .Stmts)
+          Return(Name("result")) .Stmts)
+        Assign(
+          Name("$result"),
+          Call(
+            Name("add"),
+            list(VS:ValSeq))) .Stmts))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "add"     |-> ?ADD:Val
+        "$result" |-> addSummary(VS, false),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS) andBool VS =/=K .ValSeq
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ea08b507a31bc4194e36df833822bfd2042d953e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,65 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  // Recursive domain predicate for arbitrary finite semantic integer lists.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+
+  // A guarded total twin of the partial Val-to-Int subsort projection.  It has
+  // no evaluator and can only collapse to a value already known to be an Int.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  // addSummary(VS, ODD) is the mathematical sum still to be accumulated
+  // while traversing VS, where ODD is the parity of the next index.
+  syntax Int ::= addSummary(ValSeq, Bool) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, VS:ValSeq))
+    => isInt(V) andBool allInts(VS)
+
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  // Standard guarded-total-projection characterization (the ceils.k idiom).
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val))
+    => projectIntTotal(V) [simplification]
+
+  // Guarded dispatch twins of the exact MPY-INT equations.  These compensate
+  // only for the backend's lack of path-condition-based static sort refinement.
+  rule applyBin("%", V:Val, I:Int)
+    => pyMod(projectIntTotal(V), I)
+    requires isInt(V)
+    [simplification]
+  rule applyBin("+", I:Int, V:Val)
+    => I +Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  // Definitional postcondition summary.  It does not rewrite program syntax or
+  // operational K items: the supplied MPY rules execute the complete body.
+  rule addSummary(.ValSeq, _:Bool) => 0
+  rule addSummary(vCons(_:Val, VS:ValSeq), false)
+    => addSummary(VS, true)
+  rule addSummary(vCons(V:Val, VS:ValSeq), true)
+    => (#if pyMod(projectIntTotal(V), 2) ==Int 0
+        #then projectIntTotal(V)
+        #else 0
+        #fi)
+       +Int addSummary(VS, false)
+endmodule

diff --git a/smoke.mpy b/smoke.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..a5079def3c3fb51dec50beeb370a9e138fa0b9fa
--- /dev/null
+++ b/smoke.mpy
@@ -0,0 +1,28 @@
+Module(
+  FuncDef("add", Params("lst"),
+    Assign(Name("result"), Int(0))
+    Assign(Name("odd"), Bool(false))
+    Assign(Name("value"), Int(0))
+    For(Name("value"), Name("lst"),
+      If(Name("odd"),
+        If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+          AugAssign(Name("result"), "+", Name("value")),
+          ),
+        )
+      Assign(Name("odd"), UnaryOp("not", Name("odd"))))
+    Return(Name("result")))
+  Assign(
+    Name("example"),
+    Call(Name("add"), ListExpr(Int(4), Int(2), Int(6), Int(7))))
+  Assign(Name("singleton"), Call(Name("add"), ListExpr(Int(10))))
+  Assign(
+    Name("mixed_sign"),
+    Call(
+      Name("add"),
+      ListExpr(
+        Int(1),
+        UnaryOp("-", Int(2)),
+        Int(3),
+        UnaryOp("-", Int(4)),
+        Int(5),
+        Int(8)))))
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..aba48c33a2b374674f2763d371da92cff2eb6346
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,15 @@
+def add(lst):
+    result = 0
+    odd = False
+    value = 0
+    for value in lst:
+        if odd:
+            if value % 2 == 0:
+                result += value
+        odd = not odd
+    return result
+
+
+example = add([4, 2, 6, 7])
+singleton = add([10])
+mixed_sign = add([1, -2, 3, -4, 5, 8])
