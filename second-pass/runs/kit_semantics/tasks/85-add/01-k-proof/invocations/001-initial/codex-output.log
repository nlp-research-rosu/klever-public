@@ -0,0 +1,87 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Circularity for the exact source loop.  IS is an arbitrary finite suffix,
+  // so this is an unbounded structural theorem, not a bounded unrolling.
+  claim [add-loop]:
+    <k>
+      #loop(
+        list(intVals(IS:IntSeq)),
+        Name("value"),
+        If(
+          Name("odd"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(0))),
+            AugAssign(Name("result"), "+", Name("value")) .Stmts,
+            .Stmts) .Stmts,
+          .Stmts)
+        Assign(Name("odd"), UnaryOp("not", Name("odd"))) .Stmts)
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "lst"    |-> INPUT:Val
+        "result" |-> (ACC:Int => ACC +Int addSummary(IS, ODD))
+        "odd"    |-> (ODD:Bool => ?FINALODD:Bool)
+        "value"  |-> (_CURRENT:Int => ?FINALVALUE:Int),
+        P:Parent)
+      ...
+    </scopes>
+
+  // Whole-entry theorem.  The exact translated body is defined, looked up,
+  // called, and executed under MPY.  iCons(HEAD, TAIL) is precisely the
+  // contract's non-empty, otherwise-unbounded finite integer-list domain.
+  claim [add-entry]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "add",
+          Params("lst"),
+          Assign(Name("result"), Int(0))
+          Assign(Name("odd"), Bool(false))
+          Assign(Name("value"), Int(0))
+          For(
+            Name("value"),
+            Name("lst"),
+            If(
+              Name("odd"),
+              If(
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))),
+                AugAssign(Name("result"), "+", Name("value")) .Stmts,
+                .Stmts) .Stmts,
+              .Stmts)
+            Assign(Name("odd"), UnaryOp("not", Name("odd"))) .Stmts)
+          Return(Name("result")) .Stmts)
+        Assign(
+          Name("$result"),
+          Call(
+            Name("add"),
+            list(intVals(iCons(HEAD:Int, TAIL:IntSeq))))) .Stmts))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "add"     |-> ?ADD:Val
+        "$result" |-> addSummary(iCons(HEAD, TAIL), false),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d20ffe0d1745f0d710b56b57927861737703e5e1
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,30 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  // Every finite list of semantic integers is represented by intVals(IS).
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+
+  // addSummary(IS, ODD) is the mathematical sum still to be accumulated
+  // while traversing IS, where ODD is the parity of the next index.
+  syntax Int ::= addSummary(IntSeq, Bool) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+
+  // Definitional representation; these exhaustive, disjoint equations merely
+  // embed an arbitrary finite IntSeq into the reference semantics' ValSeq.
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS))
+
+  // Definitional postcondition summary.  It does not rewrite program syntax or
+  // operational K items: the supplied MPY rules execute the complete body.
+  rule addSummary(.IntSeq, _:Bool) => 0
+  rule addSummary(iCons(_:Int, IS:IntSeq), false)
+    => addSummary(IS, true)
