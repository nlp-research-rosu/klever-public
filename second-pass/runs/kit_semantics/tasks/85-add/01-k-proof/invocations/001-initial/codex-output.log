+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // The real program returns 2 for [4, 2, 6, 7]; requiring 3 must be rejected.
+  claim [wrong-result]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "add",
+          Params("lst"),
+          Assign(Name("result"), Int(0))
+          Assign(Name("odd"), Bool(false))
+          Assign(Name("value"), Int(0))
+          For(
+            Name("value"),
+            Name("lst"),
+            If(
+              Name("odd"),
+              If(
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))),
+                AugAssign(Name("result"), "+", Name("value")) .Stmts,
+                .Stmts) .Stmts,
+              .Stmts)
+            Assign(Name("odd"), UnaryOp("not", Name("odd"))) .Stmts)
+          Return(Name("result")) .Stmts)
+        Assign(
+          Name("$result"),
+          Call(
+            Name("add"),
+            list(vCons(4, vCons(2, vCons(6, vCons(7, .ValSeq)))))))
+          .Stmts))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "add"     |-> ?ADD:Val
+        "$result" |-> 3,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..eabf08e154020fedaa65bc0e94f1e3872e0539e0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,89 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Circularity for the exact source loop.  IS is an arbitrary finite suffix,
+  // so this is an unbounded structural theorem, not a bounded unrolling.
+  claim [add-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("value"),
+        If(
+          Name("odd"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(0))),
+            AugAssign(Name("result"), "+", Name("value")) .Stmts,
+            .Stmts) .Stmts,
+          .Stmts)
+        Assign(Name("odd"), UnaryOp("not", Name("odd"))) .Stmts)
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "lst"    |-> INPUT:Val
+        "result" |-> (ACC:Int => ACC +Int addSummary(VS, ODD))
+        "odd"    |-> (ODD:Bool => ?FINALODD:Bool)
+        "value"  |-> (_CURRENT:Val => ?FINALVALUE:Val),
+        P:Parent)
+      ...
+    </scopes>
+    requires allInts(VS)
+
+  // Whole-entry theorem.  The exact translated body is defined, looked up,
+  // called, and executed under MPY.  The precondition is precisely the
+  // contract's non-empty, otherwise-unbounded finite integer-list domain.
+  claim [add-entry]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "add",
+          Params("lst"),
+          Assign(Name("result"), Int(0))
+          Assign(Name("odd"), Bool(false))
+          Assign(Name("value"), Int(0))
+          For(
+            Name("value"),
+            Name("lst"),
+            If(
+              Name("odd"),
+              If(
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))),
+                AugAssign(Name("result"), "+", Name("value")) .Stmts,
+                .Stmts) .Stmts,
+              .Stmts)
+            Assign(Name("odd"), UnaryOp("not", Name("odd"))) .Stmts)
+          Return(Name("result")) .Stmts)
+        Assign(
+          Name("$result"),
+          Call(
+            Name("add"),
+            list(VS:ValSeq))) .Stmts))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "add"     |-> ?ADD:Val
+        "$result" |-> addSummary(VS, false),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS) andBool VS =/=K .ValSeq
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..45a7864e39de42705ad70ad4021ee68fcc984ad6
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,49 @@
+from itertools import product
+from random import Random
+
+from solution import add
+
+
+def oracle(values):
+    total = 0
+    for index, value in enumerate(values):
+        if index % 2 == 1 and value % 2 == 0:
+            total += value
+    return total
+
+
+def main():
+    checked = 0
+    mismatches = 0
+
+    examples = [
+        [4, 2, 6, 7],
+        [10],
+        [1, -2, 3, -4, 5, 8],
+        [0, 0],
+        [-8, -6, -4, -2],
+    ]
+    for values in examples:
+        checked += 1
+        mismatches += add(values) != oracle(values)
+
+    alphabet = range(-3, 4)
+    for length in range(1, 6):
+        for values in product(alphabet, repeat=length):
+            checked += 1
+            mismatches += add(list(values)) != oracle(values)
+
+    random = Random(20260729)
+    for _ in range(1000):
+        length = random.randint(1, 40)
+        values = [random.randint(-1000, 1000) for _ in range(length)]
+        checked += 1
+        mismatches += add(values) != oracle(values)
+
+    print(f"checked={checked} mismatches={mismatches}")
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ea08b507a31bc4194e36df833822bfd2042d953e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,65 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  // Recursive domain predicate for arbitrary finite semantic integer lists.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+
+  // A guarded total twin of the partial Val-to-Int subsort projection.  It has
+  // no evaluator and can only collapse to a value already known to be an Int.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  // addSummary(VS, ODD) is the mathematical sum still to be accumulated
+  // while traversing VS, where ODD is the parity of the next index.
+  syntax Int ::= addSummary(ValSeq, Bool) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, VS:ValSeq))
+    => isInt(V) andBool allInts(VS)
+
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  // Standard guarded-total-projection characterization (the ceils.k idiom).
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val))
+    => projectIntTotal(V) [simplification]
+
+  // Guarded dispatch twins of the exact MPY-INT equations.  These compensate
+  // only for the backend's lack of path-condition-based static sort refinement.
+  rule applyBin("%", V:Val, I:Int)
+    => pyMod(projectIntTotal(V), I)
+    requires isInt(V)
+    [simplification]
+  rule applyBin("+", I:Int, V:Val)
+    => I +Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  // Definitional postcondition summary.  It does not rewrite program syntax or
+  // operational K items: the supplied MPY rules execute the complete body.
+  rule addSummary(.ValSeq, _:Bool) => 0
+  rule addSummary(vCons(_:Val, VS:ValSeq), false)
+    => addSummary(VS, true)
+  rule addSummary(vCons(V:Val, VS:ValSeq), true)
+    => (#if pyMod(projectIntTotal(V), 2) ==Int 0
+        #then projectIntTotal(V)
+        #else 0
+        #fi)
+       +Int addSummary(VS, false)
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..4a6a2c6a1022b1899f65f2f03fb3a961c6f270d4
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,72 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+export PATH="$HOME/.nix-profile/bin:$PATH"
+
+# Reproduce the fixed AST-to-MPY translations.
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+
+# Independent CPython differential evidence.
+python3 test_solution.py
+
+# Gate A concrete baseline: untouched reference semantics, LLVM backend.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+SMOKE_RESULT_FILE="$(mktemp)"
+VACUITY_RESULT_FILE="$(mktemp)"
+MUTANT_RESULT_FILE="$(mktemp)"
+trap 'rm -f "$SMOKE_RESULT_FILE" "$VACUITY_RESULT_FILE" "$MUTANT_RESULT_FILE"' EXIT
+
+krun smoke.mpy --definition runtime-kompiled | tee "$SMOKE_RESULT_FILE"
+grep -F '"example" |-> 2' "$SMOKE_RESULT_FILE"
+grep -F '"singleton" |-> 0' "$SMOKE_RESULT_FILE"
+grep -F '"mixed_sign" |-> 2' "$SMOKE_RESULT_FILE"
+
+# Symbolic definition and the positive, full-domain target proof.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.add-loop
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+# Gate A5: a false result must not prove.
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY 2>&1 | tee "$VACUITY_RESULT_FILE"
+VACUITY_STATUS="${PIPESTATUS[0]}"
+set -e
+if [[ "$VACUITY_STATUS" -eq 0 ]]; then
+  echo "ERROR: false-postcondition probe unexpectedly proved" >&2
+  exit 1
+fi
+grep -F '"$result" |-> 2' "$VACUITY_RESULT_FILE"
+echo "EXPECTED FAILURE: false-postcondition probe exited $VACUITY_STATUS"
+
+# Gate A1: a material body mutation must invalidate the connection.
+set +e
+kprove spec-body-mutant.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTANT 2>&1 | tee "$MUTANT_RESULT_FILE"
+MUTANT_STATUS="${PIPESTATUS[0]}"
+set -e
+if [[ "$MUTANT_STATUS" -eq 0 ]]; then
+  echo "ERROR: body-mutation probe unexpectedly proved" >&2
+  exit 1
+fi
+grep -F '"$result" |-> 1' "$MUTANT_RESULT_FILE"
+echo "EXPECTED FAILURE: body-mutation probe exited $MUTANT_STATUS"
