+    Assign(Name("odd"), Bool(false))
+    Assign(Name("value"), Int(0))
+    For(Name("value"), Name("lst"),
+      If(Name("odd"),
+        If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+          AugAssign(Name("result"), "+", Name("value")),
+          ),
+        )
+      Assign(Name("odd"), UnaryOp("not", Name("odd"))))
+    Return(Name("result"))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..22253f1de7fb33ae0c02f761131393edc241f2dd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def add(lst):
+    result = 0
+    odd = False
+    value = 0
+    for value in lst:
+        if odd:
+            if value % 2 == 0:
+                result += value
+        odd = not odd
+    return result
diff --git a/spec-body-mutant.k b/spec-body-mutant.k
