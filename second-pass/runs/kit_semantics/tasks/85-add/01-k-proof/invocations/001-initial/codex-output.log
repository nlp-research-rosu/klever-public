+        Int(8)))))
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..aba48c33a2b374674f2763d371da92cff2eb6346
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,15 @@
+def add(lst):
+    result = 0
+    odd = False
+    value = 0
+    for value in lst:
+        if odd:
+            if value % 2 == 0:
+                result += value
+        odd = not odd
+    return result
+
+
+example = add([4, 2, 6, 7])
+singleton = add([10])
+mixed_sign = add([1, -2, 3, -4, 5, 8])
