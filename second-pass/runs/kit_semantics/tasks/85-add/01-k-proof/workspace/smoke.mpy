Module(
  FuncDef("add", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("odd"), Bool(false))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Name("odd"),
        If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
          AugAssign(Name("result"), "+", Name("value")),
          ),
        )
      Assign(Name("odd"), UnaryOp("not", Name("odd"))))
    Return(Name("result")))
  Assign(
    Name("example"),
    Call(Name("add"), ListExpr(Int(4), Int(2), Int(6), Int(7))))
  Assign(Name("singleton"), Call(Name("add"), ListExpr(Int(10))))
  Assign(
    Name("mixed_sign"),
    Call(
      Name("add"),
      ListExpr(
        Int(1),
        UnaryOp("-", Int(2)),
        Int(3),
        UnaryOp("-", Int(4)),
        Int(5),
        Int(8)))))
