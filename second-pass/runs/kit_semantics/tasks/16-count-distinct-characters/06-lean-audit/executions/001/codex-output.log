+        "export_result_frozen_hash": comparison(
+            export_result["frozen_input_sha256"],
+            resolution["hashes"]["stage1_export_sha256"],
+        ),
+        "export_result_discovery_hash": comparison(
+            export_result["stage3_discovery_manifest_sha256"],
