new file mode 100644
index 0000000000000000000000000000000000000000..0a844240b112eb295bc692abd9a7f970c28a9f32
--- /dev/null
+++ b/evidence/run_and_capture.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set +e
+
+output=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_CODE: %d\n' "$status"
+  exit "$status"
+} 2>&1 | tee "$output"
+
+exit "${PIPESTATUS[0]}"
