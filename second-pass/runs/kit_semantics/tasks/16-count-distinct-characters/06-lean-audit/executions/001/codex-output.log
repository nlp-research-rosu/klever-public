+                "status"
+            ],
+            "export_status": export_result["status"],
+            "obligation_count": len(obligation_map["obligations"]),
+            "candidate_absent": not Path("/candidate").exists(),
+        },
+    }
+    print(json.dumps(output, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
