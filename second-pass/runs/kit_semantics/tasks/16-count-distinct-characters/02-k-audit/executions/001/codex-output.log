+tail -n 1 /audit-output/evidence/differential-results.jsonl
+tail_status=$?
+printf 'differential_summary_read_exit=%d\n' "$tail_status"
+
+if [[ "$translation_status" -ne 0 ]] ||
+   [[ "$identity_status" -ne 0 ]] ||
+   [[ "$differential_status" -ne 0 ]]; then
+  exit 1
+fi

