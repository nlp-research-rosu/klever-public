@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set -u
+set -o pipefail
+
+exec > >(tee /audit-output/evidence/stage3-build-proof.log) 2>&1
+set -x
+
+cd /tmp/audit-work/reconstruction || exit 90
+
+kompile --backend haskell verification.k \
