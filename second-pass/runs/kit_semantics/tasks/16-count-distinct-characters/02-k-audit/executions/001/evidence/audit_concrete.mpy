Module(
  FuncDef("count_distinct_characters", Params("string"),
    Return(
      Call(
        Name("len"),
        Call(Name("set"), Call(Attribute(Name("string"), "lower"), )))))
  Assign(
    Name("result_empty"),
    Call(Name("count_distinct_characters"), Str("")))
  Assign(
    Name("result_xyz"),
    Call(Name("count_distinct_characters"), Str("xyzXYZ")))
  Assign(
    Name("result_jerry"),
    Call(Name("count_distinct_characters"), Str("Jerry")))
  Assign(
    Name("result_case_pair"),
    Call(Name("count_distinct_characters"), Str("aA")))
  Assign(
    Name("result_punctuation"),
    Call(Name("count_distinct_characters"), Str("a-A_a!A?"))))
