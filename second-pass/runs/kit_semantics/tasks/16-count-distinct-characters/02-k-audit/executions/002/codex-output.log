/audit-output/evidence/run_logged.sh /audit-output/evidence/stage6-mutation-build.log bash -lc '
set -o pipefail
kprove audit-false-postcondition.k --definition audit-verification-kompiled --spec-module AUDIT-FALSE-POSTCONDITION --dry-run | sha256sum
