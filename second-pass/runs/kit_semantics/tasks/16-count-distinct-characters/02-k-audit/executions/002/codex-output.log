diff --git a/evidence/audit-concrete.mpy b/evidence/audit-concrete.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..237fc917bced99bc815a30f4126b5bc6f5c9224d
--- /dev/null
+++ b/evidence/audit-concrete.mpy
@@ -0,0 +1,23 @@
+Module(
+  FuncDef("count_distinct_characters", Params("string"),
+    Return(
+      Call(
+        Name("len"),
+        Call(Name("set"), Call(Attribute(Name("string"), "lower"), )))))
+  Assign(
+    Name("empty_result"),
+    Call(Name("count_distinct_characters"), Str("")))
+  Assign(
+    Name("documented_one"),
+    Call(Name("count_distinct_characters"), Str("xyzXYZ")))
+  Assign(
