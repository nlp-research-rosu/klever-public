import hashlib,json,os
from pathlib import Path
for root in [Path('/reference/reference-semantics'),Path('/candidate')]:
 files=sorted(p for p in root.rglob('*') if p.is_file() and not p.is_symlink())
 rel=[p.relative_to(root).as_posix() for p in files]
 hs=[hashlib.sha256(p.read_bytes()).hexdigest() for p in files]
 sizes=[p.stat().st_size for p in files]
 candidates={}
 docs={
  'dict_sha':dict(zip(rel,hs)),
  'list_dict_sha':[{'path':r,'sha256':h} for r,h in zip(rel,hs)],
  'list_tuple_sha':list(zip(rel,hs)),
  'dict_size_sha':{r:{'size':s,'sha256':h} for r,s,h in zip(rel,sizes,hs)},
  'list_dict_size_sha':[{'path':r,'size':s,'sha256':h} for r,s,h in zip(rel,sizes,hs)],
 }
 for name,doc in docs.items():
  for compact in [True,False]:
   b=json.dumps(doc,sort_keys=True,separators=(',',':') if compact else None).encode()
   candidates[name+('_compact' if compact else '_default')]=hashlib.sha256(b).hexdigest()
 candidates['paths_null_bytes']=hashlib.sha256(b''.join(r.encode()+b'\\0'+p.read_bytes() for r,p in zip(rel,files))).hexdigest()
 candidates['paths_newline_bytes']=hashlib.sha256(b''.join(r.encode()+b'\\n'+p.read_bytes() for r,p in zip(rel,files))).hexdigest()
 candidates['sha_path_lines']=hashlib.sha256(''.join(f'{h}  {r}\\n' for r,h in zip(rel,hs)).encode()).hexdigest()
 candidates['path_sha_lines']=hashlib.sha256(''.join(f'{r}\\t{h}\\n' for r,h in zip(rel,hs)).encode()).hexdigest()
 print(root)
 for k,v in candidates.items(): print(k,v)
PY" in /audit-output
