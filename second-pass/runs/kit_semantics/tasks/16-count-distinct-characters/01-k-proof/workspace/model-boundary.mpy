Module(
  FuncDef("count_distinct_characters", Params("string"),
    Return(
      Call(
        Name("len"),
        Call(Name("set"), Call(Attribute(Name("string"), "lower"), )))))
  Assign(
    Name("model_boundary_result"),
    Call(
      Name("count_distinct_characters"),
      str(iCons(304, .IntSeq)))))
