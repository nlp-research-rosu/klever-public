solution.py
     1	def fix_spaces(text):
     2	    result = ""
     3	    spaces = ""
     4	    char = ""
     5	    for char in text:
     6	        if char == " ":
     7	            if spaces == "__":
     8	                spaces = "-"
     9	            elif spaces != "-":
    10	                spaces += "_"
    11	        else:
    12	            result += spaces + char
    13	            spaces = ""
    14	    return result + spaces
