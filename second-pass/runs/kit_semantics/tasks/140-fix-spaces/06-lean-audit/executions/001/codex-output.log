     9	    => If(
    10	         Compare(Name("char"), CmpOp("==", Str(" "))),
    11	         If(
    12	           Compare(Name("spaces"), CmpOp("==", Str("__"))),
    13	           Assign(Name("spaces"), Str("-")),
    14	           If(
    15	             Compare(Name("spaces"), CmpOp("!=", Str("-"))),
    16	             AugAssign(Name("spaces"), "+", Str("_")),
    17	             .Stmts)),
    18	         AugAssign(
    19	           Name("result"),
    20	           "+",
    21	           BinOp("+", Name("spaces"), Name("char")))
    22	         Assign(Name("spaces"), Str("")))
    23	
    24	  syntax Stmts ::= "#fixSpacesBody" [function, total]
    25	  rule #fixSpacesBody
    26	    => Assign(Name("result"), Str(""))
    27	       Assign(Name("spaces"), Str(""))
    28	       Assign(Name("char"), Str(""))
    29	       For(Name("char"), Name("text"), #fixSpacesLoopBody)
    30	       Return(BinOp("+", Name("result"), Name("spaces")))
    31	
    32	  // The pending-space encoding after reading one additional space.
    33	  syntax IntSeq ::= pendingSpace(IntSeq) [function, total]
    34	  rule pendingSpace(P:IntSeq)
    35	    => iCons(45, .IntSeq)
    36	    requires P ==K iCons(95, iCons(95, .IntSeq))
    37	  rule pendingSpace(P:IntSeq)
    38	    => P
    39	    requires P ==K iCons(45, .IntSeq)
    40	     andBool notBool (P ==K iCons(95, iCons(95, .IntSeq)))
    41	  rule pendingSpace(P:IntSeq)
    42	    => seqConcat(P, iCons(95, .IntSeq))
    43	    requires notBool (P ==K iCons(95, iCons(95, .IntSeq)))
    44	     andBool notBool (P ==K iCons(45, .IntSeq))
    45	
    46	  // Exact final local-state summaries for the remaining character sequence.
    47	  syntax IntSeq ::= resultAfter(IntSeq, IntSeq, IntSeq) [function, total]
    48	  rule resultAfter(.IntSeq, R:IntSeq, _P:IntSeq) => R
    49	  rule resultAfter(iCons(32, CS:IntSeq), R:IntSeq, P:IntSeq)
    50	    => resultAfter(CS, R, pendingSpace(P))
    51	  rule resultAfter(iCons(C:Int, CS:IntSeq), R:IntSeq, P:IntSeq)
    52	    => resultAfter(
    53	         CS,
    54	         seqConcat(R, seqConcat(P, iCons(C, .IntSeq))),
    55	         .IntSeq)
    56	    requires C =/=Int 32
    57	    [simplification]
    58	
    59	  syntax IntSeq ::= pendingAfter(IntSeq, IntSeq) [function, total]
    60	  rule pendingAfter(.IntSeq, P:IntSeq) => P
    61	  rule pendingAfter(iCons(32, CS:IntSeq), P:IntSeq)
    62	    => pendingAfter(CS, pendingSpace(P))
    63	  rule pendingAfter(iCons(C:Int, CS:IntSeq), _P:IntSeq)
    64	    => pendingAfter(CS, .IntSeq)
    65	    requires C =/=Int 32
    66	    [simplification]
    67	
    68	  syntax Val ::= charAfter(IntSeq, Val) [function, total]
    69	  rule charAfter(.IntSeq, CH:Val) => CH
    70	  rule charAfter(iCons(C:Int, CS:IntSeq), _CH:Val)
    71	    => charAfter(CS, str(iCons(C, .IntSeq)))
    72	
    73	  syntax IntSeq ::= fixedSpaces(IntSeq) [function, total]
    74	  rule fixedSpaces(CS:IntSeq)
    75	    => seqConcat(
    76	         resultAfter(CS, .IntSeq, .IntSeq),
    77	         pendingAfter(CS, .IntSeq))
    78	endmodule

--- prove.sh ---
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy
python3 test_solution.py

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun smoke.mpy --definition runtime-kompiled

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.loop-invariant

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY; then
  echo "ERROR: false-result mutation unexpectedly proved" >&2
  exit 1
else
  echo "EXPECTED FAILURE: false-result mutation was rejected"
fi

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION; then
  echo "ERROR: mutated body unexpectedly proved the original result" >&2
  exit 1
else
  echo "EXPECTED FAILURE: material body mutation was rejected"
fi

--- spec.k ---
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  claim [loop-invariant]:
     7	    <k>
     8	      #loop(str(CS:IntSeq), Name("char"), #fixSpacesLoopBody)
     9	      => .K
    10	      ...
    11	    </k>
    12	    <env> L:Int </env>
    13	    <scopes>
    14	      ...
    15	      L:Int |-> scope(
    16	        "char"   |-> (CH:Val      => charAfter(CS, CH))
    17	        "result" |-> (str(R:IntSeq) => str(resultAfter(CS, R, P)))
    18	        "spaces" |-> (str(P:IntSeq) => str(pendingAfter(CS, P)))
    19	        "text"   |-> str(T:IntSeq),
    20	        PAR:Parent)
    21	      ...
    22	    </scopes>
    23	
    24	  claim [target]:
    25	    <k>
    26	      Call(Name("fix_spaces"), str(CS:IntSeq))
    27	      => str(fixedSpaces(CS))
    28	    </k>
    29	    <env> 0 </env>
    30	    <scopes>
    31	      0  |-> scope(
    32	               "fix_spaces" |->
    33	                 closureVal(("text", .ParamNames), #fixSpacesBody, 0),
    34	               parent(-1))
    35	      -1 |-> builtinsScope
    36	    </scopes>
    37	    <scopeLoc> 1 </scopeLoc>
    38	    <heap> .Map </heap>
    39	    <heapLoc> 0 </heapLoc>
    40	    <stack> .List </stack>
    41	    <ret> noRet </ret>
    42	    <exc> NoExc </exc>
    43	    <exit-code> 0 </exit-code>
    44	endmodule

--- solution.py ---
     1	def fix_spaces(text):
     2	    result = ""
     3	    spaces = ""
     4	    char = ""
     5	    for char in text:
     6	        if char == " ":
     7	            if spaces == "__":
     8	                spaces = "-"
     9	            elif spaces != "-":
    10	                spaces += "_"
    11	        else:
    12	            result += spaces + char
    13	            spaces = ""
    14	    return result + spaces

--- prompt.py ---
     1	
     2	def fix_spaces(text):
     3	    """
     4	    Given a string text, replace all spaces in it with underscores, 
     5	    and if a string has more than 2 consecutive spaces, 
     6	    then replace all consecutive spaces with - 
     7	    
     8	    fix_spaces("Example") == "Example"
     9	    fix_spaces("Example 1") == "Example_1"
    10	    fix_spaces(" Example 2") == "_Example_2"
    11	    fix_spaces(" Example   3") == "_Example-3"
    12	    """

--- solution.mpy ---
     1	Module(
     2	  FuncDef("fix_spaces", Params("text"),
     3	    Assign(Name("result"), Str(""))
     4	    Assign(Name("spaces"), Str(""))
     5	    Assign(Name("char"), Str(""))
     6	    For(Name("char"), Name("text"),
     7	      If(Compare(Name("char"), CmpOp("==", Str(" "))),
     8	        If(Compare(Name("spaces"), CmpOp("==", Str("__"))),
     9	          Assign(Name("spaces"), Str("-")),
    10	          If(Compare(Name("spaces"), CmpOp("!=", Str("-"))),
    11	            AugAssign(Name("spaces"), "+", Str("_")),
    12	            )),
    13	        AugAssign(
    14	          Name("result"),
    15	          "+",
    16	          BinOp("+", Name("spaces"), Name("char")))
    17	        Assign(Name("spaces"), Str(""))))
    18	    Return(BinOp("+", Name("result"), Name("spaces")))))

