+  ssize_t result = real_readlinkat(fd, effective, buf, size);
+  int saved = errno;
+  fprintf(stderr, "TRACE readlinkat(%d,%s as %s) -> %zd errno=%d", fd, path, effective, result, saved);
+  if (result >= 0) fprintf(stderr, " value=%.*s", (int)result, buf);
+  fputc('\n', stderr);
+  errno = saved;
+  return result;
+}
