+
+import hashlib
+import json
+import os
+import stat
+from pathlib import Path
+
+
+AUDIT = Path("/audit-input.json")
+LOCK = Path("/audit-campaign-lock.json")
+CANDIDATE = Path("/candidate")
+REFERENCE = Path("/reference")
