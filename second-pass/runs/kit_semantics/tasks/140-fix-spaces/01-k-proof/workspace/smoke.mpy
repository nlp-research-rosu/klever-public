Module(
  FuncDef("fix_spaces", Params("text"),
    Assign(Name("result"), Str(""))
    Assign(Name("spaces"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("text"),
      If(Compare(Name("char"), CmpOp("==", Str(" "))),
        If(Compare(Name("spaces"), CmpOp("==", Str("__"))),
          Assign(Name("spaces"), Str("-")),
          If(Compare(Name("spaces"), CmpOp("!=", Str("-"))),
            AugAssign(Name("spaces"), "+", Str("_")),
            )),
        AugAssign(
          Name("result"),
          "+",
          BinOp("+", Name("spaces"), Name("char")))
        Assign(Name("spaces"), Str(""))))
    Return(BinOp("+", Name("result"), Name("spaces"))))
  Assert(
    Compare(Call(Name("fix_spaces"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("Example")),
      CmpOp("==", Str("Example"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("Example 1")),
      CmpOp("==", Str("Example_1"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str(" Example 2")),
      CmpOp("==", Str("_Example_2"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str(" Example   3")),
      CmpOp("==", Str("_Example-3"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("a  b    c ")),
      CmpOp("==", Str("a__b-c_")))))
