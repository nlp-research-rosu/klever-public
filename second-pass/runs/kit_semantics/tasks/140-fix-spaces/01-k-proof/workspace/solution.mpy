Module(
  FuncDef("fix_spaces", Params("text"),
    Assign(Name("result"), Str(""))
    Assign(Name("spaces"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("text"),
      If(Compare(Name("char"), CmpOp("==", Str(" "))),
        If(Compare(Name("spaces"), CmpOp("==", Str("__"))),
          Assign(Name("spaces"), Str("-")),
          If(Compare(Name("spaces"), CmpOp("!=", Str("-"))),
            AugAssign(Name("spaces"), "+", Str("_")),
            )),
        AugAssign(
          Name("result"),
          "+",
          BinOp("+", Name("spaces"), Name("char")))
        Assign(Name("spaces"), Str(""))))
    Return(BinOp("+", Name("result"), Name("spaces")))))
