source solution.py
     1	from typing import List, Tuple
     2	
     3	
     4	def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:
     5	    if numbers[0] < numbers[1]:
     6	        closest = (numbers[0], numbers[1])
     7	    else:
     8	        closest = (numbers[1], numbers[0])
     9	    items = list(enumerate(numbers))
    10	    item1 = items[0]
    11	    item2 = items[0]
    12	    for item1 in items:
    13	        for item2 in items:
    14	            if item1[0] < item2[0]:
    15	                if abs(item2[1] - item1[1]) < abs(closest[1] - closest[0]):
    16	                    if item1[1] < item2[1]:
    17	                        closest = (item1[1], item2[1])
    18	                    else:
    19	                        closest = (item2[1], item1[1])
    20	    return closest

