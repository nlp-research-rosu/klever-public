+      (item 8 2.0) empty)
+
+def malformedItems : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» malformedItem empty
+
+def listValue : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» twoFloats)
+
+def tupleValue : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» twoFloats)
+
+theorem allFloatEmpty :
+    «allFloatVS(_)_VERIFICATION-BASE_Bool_ValSeq» empty = true := rfl
+theorem allFloatPositive :
+    «allFloatVS(_)_VERIFICATION-BASE_Bool_ValSeq» twoFloats = true := rfl
+theorem allFloatRejectsInt :
+    «allFloatVS(_)_VERIFICATION-BASE_Bool_ValSeq» oneInt = false := rfl
+
+theorem allItemsPositive :
+    «allFloatItems(_)_VERIFICATION-BASE_Bool_ValSeq» items = true := rfl
+theorem allItemsRejectsMalformed :
+    «allFloatItems(_)_VERIFICATION-BASE_Bool_ValSeq» malformedItems = false := rfl
+
+theorem indexSeven :
+    «itemIndex(_)_VERIFICATION-BASE_Int_Val» (item 7 1.0) = 7 := rfl
+theorem indexEight :
+    «itemIndex(_)_VERIFICATION-BASE_Int_Val» (item 8 2.0) = 8 := rfl
+theorem floatOne :
+    «itemFloat(_)_VERIFICATION-BASE_Float_Val» (item 7 1.0) = 1.0 := rfl
+theorem floatTwo :
+    «itemFloat(_)_VERIFICATION-BASE_Float_Val» (item 8 2.0) = 2.0 := rfl
+
+theorem listIndexZero :
+    «applyIndex(_,_)_MPY-SUBSCRIPT_Val_Val_Int» listValue 0 =
+      SortVal.inj_SortFloat 1.0 := rfl
+theorem listIndexOne :
+    «applyIndex(_,_)_MPY-SUBSCRIPT_Val_Val_Int» listValue 1 =
+      SortVal.inj_SortFloat 2.0 := rfl
+theorem listNegativeOne :
+    «applyIndex(_,_)_MPY-SUBSCRIPT_Val_Val_Int» listValue (-1) =
+      SortVal.inj_SortFloat 2.0 := rfl
+theorem listNegativeTwo :
+    «applyIndex(_,_)_MPY-SUBSCRIPT_Val_Val_Int» listValue (-2) =
+      SortVal.inj_SortFloat 1.0 := rfl
+theorem tupleIndexOne :
+    «applyIndex(_,_)_MPY-SUBSCRIPT_Val_Val_Int» tupleValue 1 =
+      SortVal.inj_SortFloat 2.0 := rfl
+
+theorem enumerateFromSeven :
+    «enumVS(_,_)_MPY-BUILTINS_ValSeq_ValSeq_Int» twoFloats 7 = items := rfl
+
+#check allFloatEmpty
+#check allFloatPositive
+#check allFloatRejectsInt
+#check allItemsPositive
+#check allItemsRejectsMalformed
+#check indexSeven
+#check indexEight
+#check floatOne
+#check floatTwo
+#check listIndexZero
+#check listIndexOne
+#check listNegativeOne
+#check listNegativeTwo
+#check tupleIndexOne
+#check enumerateFromSeven
+
+end BridgeTests
