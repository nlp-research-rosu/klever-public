{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 76,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "10715be101106e1d4c1855c816002072e4e7e405642209decd8f76f795f2e9a1",
      "rationale": "Macro equation expanding the named innerBody proof term to the translated inner-loop statement sequence.",
      "source_rule_id": "rule-10715be101106e1d4c1855c816002072e4e7e405642209decd8f76f795f2e9a1",
      "start_line": 34,
      "text": "  rule innerBody\n    => If(\n         Compare(\n           Subscript(Name(\"item1\"), Int(0)),\n           CmpOp(\"<\", Subscript(Name(\"item2\"), Int(0)))),\n         If(\n           Compare(\n             Call(\n               Name(\"abs\"),\n               (BinOp(\n                 \"-\",\n                 Subscript(Name(\"item2\"), Int(1)),\n                 Subscript(Name(\"item1\"), Int(1))),\n                .Exprs)),\n             CmpOp(\n               \"<\",\n               Call(\n                 Name(\"abs\"),\n                 (BinOp(\n                   \"-\",\n                   Subscript(Name(\"closest\"), Int(1)),\n                   Subscript(Name(\"closest\"), Int(0))),\n                  .Exprs)))),\n           If(\n             Compare(\n               Subscript(Name(\"item1\"), Int(1)),\n               CmpOp(\"<\", Subscript(Name(\"item2\"), Int(1)))),\n             (Assign(\n                Name(\"closest\"),\n                TupleExpr(\n                  (Subscript(Name(\"item1\"), Int(1)),\n                   Subscript(Name(\"item2\"), Int(1)),\n                   .Exprs)))\n              .Stmts),\n             (Assign(\n                Name(\"closest\"),\n                TupleExpr(\n                  (Subscript(Name(\"item2\"), Int(1)),\n                   Subscript(Name(\"item1\"), Int(1)),\n                   .Exprs)))\n              .Stmts)),\n           .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 79,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "d1671d47347899ec9552b5ecaa1c27bd5dec53a7d11baefe85e3bcaf5e77fe9f",
      "rationale": "Macro equation expanding outerBody to the nested for-loop statement used by the translated program.",
      "source_rule_id": "rule-d1671d47347899ec9552b5ecaa1c27bd5dec53a7d11baefe85e3bcaf5e77fe9f",
      "start_line": 78,
      "text": "  rule outerBody\n    => (For(Name(\"item2\"), Name(\"items\"), innerBody) .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 109,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "94db369578fd7e009eef892bb26ffe80f412b84eb2471a0dfb3a3bccb8aa3219",
      "rationale": "Macro equation defining the named findBody term as the exact translated function body.",
      "source_rule_id": "rule-94db369578fd7e009eef892bb26ffe80f412b84eb2471a0dfb3a3bccb8aa3219",
      "start_line": 81,
      "text": "  rule findBody\n    => If(\n         Compare(\n           Subscript(Name(\"numbers\"), Int(0)),\n           CmpOp(\"<\", Subscript(Name(\"numbers\"), Int(1)))),\n         (Assign(\n            Name(\"closest\"),\n            TupleExpr(\n              (Subscript(Name(\"numbers\"), Int(0)),\n               Subscript(Name(\"numbers\"), Int(1)),\n               .Exprs)))\n          .Stmts),\n         (Assign(\n            Name(\"closest\"),\n            TupleExpr(\n              (Subscript(Name(\"numbers\"), Int(1)),\n               Subscript(Name(\"numbers\"), Int(0)),\n               .Exprs)))\n          .Stmts))\n       Assign(\n         Name(\"items\"),\n         Call(\n           Name(\"list\"),\n           (Call(Name(\"enumerate\"), (Name(\"numbers\"), .Exprs)), .Exprs)))\n       Assign(Name(\"item1\"), Subscript(Name(\"items\"), Int(0)))\n       Assign(Name(\"item2\"), Subscript(Name(\"items\"), Int(0)))\n       For(Name(\"item1\"), Name(\"items\"), outerBody)\n       Return(Name(\"closest\"))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 118,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "587e648e43a3246e72365f12ca4a2c57b1af505ea47fc82795f6c50377b88646",
      "rationale": "Macro equation defining solutionModule as the translated import and function declaration.",
      "source_rule_id": "rule-587e648e43a3246e72365f12ca4a2c57b1af505ea47fc82795f6c50377b88646",
      "start_line": 111,
      "text": "  rule solutionModule\n    => Module(\n         ImportFrom(\"typing\", (\"List\", \"Tuple\", .ParamNames))\n         FuncDef(\n           \"find_closest_elements\",\n           Params((\"numbers\", .ParamNames)),\n           findBody)\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 120,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "78f2a049ece805815d21e9063a74aff75f3d53f22a84a77fea64ffc91042a363",
      "rationale": "Base equation for the allFloatVS structural recognizer on an empty value sequence.",
      "source_rule_id": "rule-78f2a049ece805815d21e9063a74aff75f3d53f22a84a77fea64ffc91042a363",
      "start_line": 120,
      "text": "  rule allFloatVS(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 122,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "721ad2f860d8fd7dcfedd6c8f8ad784911648921aa4620c34a3d47b63caafb68",
      "rationale": "Recursive equation defining allFloatVS on a nonempty sequence, with strict descent on the tail.",
      "source_rule_id": "rule-721ad2f860d8fd7dcfedd6c8f8ad784911648921aa4620c34a3d47b63caafb68",
      "start_line": 121,
      "text": "  rule allFloatVS(vCons(V:Val, REST:ValSeq))\n    => (V ==K floatProjection(V)) andBool allFloatVS(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 123,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "abee4f96e3c95bcff243de93b0fea7b7914e9e0c3c4c45819a70195ec1c0b129",
      "rationale": "Projection equation defining floatProjection on values of sort Float.",
      "source_rule_id": "rule-abee4f96e3c95bcff243de93b0fea7b7914e9e0c3c4c45819a70195ec1c0b129",
      "start_line": 123,
      "text": "  rule floatProjection(F:Float) => F"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 125,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "ca372d3450d64055729fbc8ab4c2816d09d7d1bf059c4480456b62dc23485bea",
      "rationale": "Base equation for the allFloatItems structural recognizer on an empty value sequence.",
      "source_rule_id": "rule-ca372d3450d64055729fbc8ab4c2816d09d7d1bf059c4480456b62dc23485bea",
      "start_line": 125,
      "text": "  rule allFloatItems(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 133,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "cf1330988dbb6dda1f82c4f4f9f023e45bcf05ecde12e384f3d54226610880ed",
      "rationale": "Recursive equation defining canonical enumerated float items, descending on the sequence tail.",
      "source_rule_id": "rule-cf1330988dbb6dda1f82c4f4f9f023e45bcf05ecde12e384f3d54226610880ed",
      "start_line": 126,
      "text": "  rule allFloatItems(vCons(V:Val, REST:ValSeq))\n    => ( V\n         ==K\n         tuple(\n           vCons(\n             itemIndex(V),\n             vCons(itemFloat(V), .ValSeq))) )\n       andBool allFloatItems(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 136,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "851b10e46e6efe28264ba80849ea5821e3e0c02e8fb932a3aa06cbba531a308b",
      "rationale": "Structural projection equation defining itemIndex for canonical Int-Float tuple values.",
      "source_rule_id": "rule-851b10e46e6efe28264ba80849ea5821e3e0c02e8fb932a3aa06cbba531a308b",
      "start_line": 134,
      "text": "  rule itemIndex(\n         tuple(vCons(I:Int, vCons(_:Float, .ValSeq))))\n    => I"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 139,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "862c889ad2a79505e59d5314c60ce1ca6896ff31aaff480063371b209b30f412",
      "rationale": "Structural projection equation defining itemFloat for canonical Int-Float tuple values.",
      "source_rule_id": "rule-862c889ad2a79505e59d5314c60ce1ca6896ff31aaff480063371b209b30f412",
      "start_line": 137,
      "text": "  rule itemFloat(\n         tuple(vCons(_:Int, vCons(F:Float, .ValSeq))))\n    => F"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 162,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "266ff54cc51677e3db6e466ae790c6d36012c1691a3d72563de9ced78b701da7",
      "rationale": "True-branch equation defining orderedFirst under floatLt.",
      "source_rule_id": "rule-266ff54cc51677e3db6e466ae790c6d36012c1691a3d72563de9ced78b701da7",
      "start_line": 161,
      "text": "  rule orderedFirst(X:Float, Y:Float) => X\n    requires floatLt(X, Y)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 164,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "8e44446174ac13940665fbd0dc8d9b157830bb20439a10272e087482aef1ad06",
      "rationale": "Complementary false-branch equation completing the definition of orderedFirst.",
      "source_rule_id": "rule-8e44446174ac13940665fbd0dc8d9b157830bb20439a10272e087482aef1ad06",
      "start_line": 163,
      "text": "  rule orderedFirst(X:Float, Y:Float) => Y\n    requires notBool floatLt(X, Y)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 166,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "564dca85307ced0f4df082a023682f88eb12dc3d48514ea7f3eb5a23b4b57f98",
      "rationale": "True-branch equation defining orderedSecond under floatLt.",
      "source_rule_id": "rule-564dca85307ced0f4df082a023682f88eb12dc3d48514ea7f3eb5a23b4b57f98",
      "start_line": 165,
      "text": "  rule orderedSecond(X:Float, Y:Float) => Y\n    requires floatLt(X, Y)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 168,
      "module": "VERIFICATION-BASE",
