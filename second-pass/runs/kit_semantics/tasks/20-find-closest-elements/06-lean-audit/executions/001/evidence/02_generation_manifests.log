      "start_line": 111,
      "text": "  rule solutionModule\n    => Module(\n         ImportFrom(\"typing\", (\"List\", \"Tuple\", .ParamNames))\n         FuncDef(\n           \"find_closest_elements\",\n           Params((\"numbers\", .ParamNames)),\n           findBody)\n         .Stmts)"
