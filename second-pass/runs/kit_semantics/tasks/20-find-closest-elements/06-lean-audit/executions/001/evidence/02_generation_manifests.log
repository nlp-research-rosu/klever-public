      "source_rule_id": "rule-10715be101106e1d4c1855c816002072e4e7e405642209decd8f76f795f2e9a1",
      "start_line": 34,
      "text": "  rule innerBody\n    => If(\n         Compare(\n           Subscript(Name(\"item1\"), Int(0)),\n           CmpOp(\"<\", Subscript(Name(\"item2\"), Int(0)))),\n         If(\n           Compare(\n             Call(\n               Name(\"abs\"),\n               (BinOp(\n                 \"-\",\n                 Subscript(Name(\"item2\"), Int(1)),\n                 Subscript(Name(\"item1\"), Int(1))),\n                .Exprs)),\n             CmpOp(\n               \"<\",\n               Call(\n                 Name(\"abs\"),\n                 (BinOp(\n                   \"-\",\n                   Subscript(Name(\"closest\"), Int(1)),\n                   Subscript(Name(\"closest\"), Int(0))),\n                  .Exprs)))),\n           If(\n             Compare(\n               Subscript(Name(\"item1\"), Int(1)),\n               CmpOp(\"<\", Subscript(Name(\"item2\"), Int(1)))),\n             (Assign(\n                Name(\"closest\"),\n                TupleExpr(\n                  (Subscript(Name(\"item1\"), Int(1)),\n                   Subscript(Name(\"item2\"), Int(1)),\n                   .Exprs)))\n              .Stmts),\n             (Assign(\n                Name(\"closest\"),\n                TupleExpr(\n                  (Subscript(Name(\"item2\"), Int(1)),\n                   Subscript(Name(\"item1\"), Int(1)),\n                   .Exprs)))\n              .Stmts)),\n           .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
