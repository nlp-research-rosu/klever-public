/bin/bash -lc "nl -ba /tmp/audit-work/20-find-closest-elements/reference-semantics/semantics/float.k | sed -n '1,320p'; nl -ba /tmp/audit-work/20-find-closest-elements/smoke.py | sed -n '1,220p'; nl -ba /tmp/audit-work/20-find-closest-elements/smoke.mpy | sed -n '1,180p'" in /audit-output
