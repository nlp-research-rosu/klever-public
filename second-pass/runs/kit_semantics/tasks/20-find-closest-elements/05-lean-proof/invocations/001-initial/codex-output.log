diff --git a/lean-app-path-shim.c b/lean-app-path-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..078af4fa3bae2897593c56944a0406a04c438bde
--- /dev/null
+++ b/lean-app-path-shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  if (strncmp(path, "/proc/", 6) == 0) {
+    const char *suffix = strrchr(path, '/');
+    if (suffix != NULL && strcmp(suffix, "/exe") == 0) {
+      return real_readlink("/proc/self/exe", buffer, size);
+    }
+  }
+
+  return real_readlink(path, buffer, size);
+}

