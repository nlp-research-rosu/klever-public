def findLakeInstall? : BaseIO (Option LakeInstall) := do
  if let Except.ok lake ← IO.appPath.toBaseIO then
    if let some lake ← getLakeInstall? lake then
      return lake
  if let some home ← IO.getEnv "LAKE_HOME" then
    return some {home}
  return none

