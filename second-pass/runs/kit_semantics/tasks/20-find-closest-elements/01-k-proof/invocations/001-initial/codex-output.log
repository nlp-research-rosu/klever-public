+        vCons(
+          outerFirst(
+            enumVS(vCons(F0, vCons(F1, REST)), 0),
+            enumVS(vCons(F0, vCons(F1, REST)), 0),
+            orderedFirst(F0, F1),
+            orderedSecond(F0, F1)),
+          vCons(
