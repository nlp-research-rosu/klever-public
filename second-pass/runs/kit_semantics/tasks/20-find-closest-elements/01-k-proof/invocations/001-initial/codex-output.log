+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> _NUMBERS:Val
+             "items"   |-> _ITEMSREF:Val
+             "item1"   |-> ITEM1:Val
+             "item2"   |-> (OLD2:Val => lastItem(REST, OLD2))
