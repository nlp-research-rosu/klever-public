+    for item1 in items:
+        for item2 in items:
+            if item1[0] < item2[0]:
+                if abs(item2[1] - item1[1]) < abs(closest[1] - closest[0]):
+                    if item1[1] < item2[1]:
+                        closest = (item1[1], item2[1])
+                    else:
