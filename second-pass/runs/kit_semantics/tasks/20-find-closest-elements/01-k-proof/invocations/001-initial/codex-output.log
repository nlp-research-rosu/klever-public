+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ITEMSREF:Val
+             "item1"   |-> ITEM1:Val
+             "item2"   |-> (OLD2:Val => lastItem(REST, OLD2))
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 innerBest(
+                   ITEM1,
+                   REST,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    requires ITEM1
+       ==K tuple(
+             vCons(
+               itemIndex(ITEM1),
+               vCons(itemFloat(ITEM1), .ValSeq)))
+     andBool allFloatItems(REST)
+
+  claim [outer-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("item1"), outerBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ref(H:Int)
+             "item1"   |-> (OLD1:Val => ?FINAL1:Val)
+             "item2"   |-> (OLD2:Val => ?FINAL2:Val)
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 outerBest(
+                   REST,
+                   ALL:ValSeq,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    <heap> H |-> list(ALL) ... </heap>
+    requires allFloatItems(REST)
+     andBool allFloatItems(ALL)
+
+  claim [find-closest]:
