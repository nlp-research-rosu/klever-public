+
+  claim [outer-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("item1"), outerBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
