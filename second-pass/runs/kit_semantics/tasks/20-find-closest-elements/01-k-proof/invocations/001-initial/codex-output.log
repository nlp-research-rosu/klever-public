+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ITEMSREF:Val
+             "item1"   |-> ITEM1:Val
+             "item2"   |-> (OLD2:Val => lastItem(REST, OLD2))
+             "closest" |->
