@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC-SMALL
+  imports VERIFICATION
+
+  claim [find-closest-two]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("find_closest_elements"),
+           (list(vCons(F0:Float, vCons(F1:Float, .ValSeq))), .Exprs))
+      =>
+      orderedPair(F0, F1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        =>
+        0 |-> scope(
+               "find_closest_elements"
+                 |-> closureVal(
+                       ("numbers", .ParamNames),
+                       findBody,
+                       0),
+               parent(-1)) )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               tuple(vCons(0, vCons(F0, .ValSeq))),
+               vCons(
+                 tuple(vCons(1, vCons(F1, .ValSeq))),
+                 .ValSeq)))
+      1 |-> list(
+             vCons(
+               tuple(vCons(0, vCons(F0, .ValSeq))),
+               vCons(
+                 tuple(vCons(1, vCons(F1, .ValSeq))),
+                 .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6c47c34073be60cf6f6130517a52c12a96243449
--- /dev/null
+++ b/spec.k
