+                "bin"        |-> builtinV("bin")
+                "enumerate"  |-> builtinV("enumerate")
+                "map"        |-> builtinV("map")
+                "eval"       |-> builtinV("eval")
+                "int"        |-> typeV("int")
+                "str"        |-> typeV("str")
+                "float"      |-> typeV("float"),
+                root)
+         0 |-> scope(
+                "find_closest_elements"
+                  |-> closureVal(
