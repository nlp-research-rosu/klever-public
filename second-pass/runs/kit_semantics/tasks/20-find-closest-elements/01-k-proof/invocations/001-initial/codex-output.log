+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("item2"), innerBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ITEMSREF:Val
+             "item1"   |-> tuple(vCons(I:Int, vCons(X:Float, .ValSeq)))
+             "item2"   |-> (OLD2:Val => lastItem(REST, OLD2))
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 innerBest(
+                   tuple(vCons(I, vCons(X, .ValSeq))),
+                   REST,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    requires allFloatItems(REST)
+
+  claim [outer-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("item1"), outerBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ref(H:Int)
+             "item1"   |-> (OLD1:Val => ?FINAL1:Val)
+             "item2"   |-> (OLD2:Val => ?FINAL2:Val)
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 outerBest(
+                   REST,
+                   ALL:ValSeq,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    <heap> H |-> list(ALL) ... </heap>
+    requires allFloatItems(REST)
+     andBool allFloatItems(ALL)
+
+  claim [find-closest]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("find_closest_elements"),
+           (list(vCons(F0:Float, vCons(F1:Float, REST:ValSeq))), .Exprs))
+      =>
+      outerBest(
+        enumVS(vCons(F0, vCons(F1, REST)), 0),
+        enumVS(vCons(F0, vCons(F1, REST)), 0),
+        orderedPair(F0, F1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        =>
+        0 |-> scope(
+               "find_closest_elements"
+                 |-> closureVal(
+                       ("numbers", .ParamNames),
+                       findBody,
+                       0),
+               parent(-1)) )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
