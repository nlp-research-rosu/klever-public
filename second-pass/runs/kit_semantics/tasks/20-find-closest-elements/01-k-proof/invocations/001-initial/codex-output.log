+requires "verification.k"
+
+module SPEC-SMALL
+  imports VERIFICATION
+
+  claim [find-closest-two]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("find_closest_elements"),
+           (list(vCons(F0:Float, vCons(F1:Float, .ValSeq))), .Exprs))
+      =>
+      orderedPair(F0, F1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        =>
+        0 |-> scope(
+               "find_closest_elements"
+                 |-> closureVal(
+                       ("numbers", .ParamNames),
+                       findBody,
+                       0),
+               parent(-1)) )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               tuple(vCons(0, vCons(F0, .ValSeq))),
+               vCons(
+                 tuple(vCons(1, vCons(F1, .ValSeq))),
+                 .ValSeq)))
+      1 |-> list(
+             vCons(
+               tuple(vCons(0, vCons(F0, .ValSeq))),
+               vCons(
+                 tuple(vCons(1, vCons(F1, .ValSeq))),
+                 .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9a0d31e7ede5849575f32ac1dfdd8dd096c0a37c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,117 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("item2"), innerBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ITEMSREF:Val
+             "item1"   |-> ITEM1:Val
+             "item2"   |-> (OLD2:Val => lastItem(REST, OLD2))
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 innerBest(
+                   ITEM1,
+                   REST,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    requires ITEM1
+       ==K tuple(
+             vCons(
+               itemIndex(ITEM1),
+               vCons(itemFloat(ITEM1), .ValSeq)))
+     andBool allFloatItems(REST)
+
+  claim [outer-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("item1"), outerBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ref(H:Int)
+             "item1"   |-> (OLD1:Val => ?FINAL1:Val)
+             "item2"   |-> (OLD2:Val => ?FINAL2:Val)
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 outerBest(
+                   REST,
+                   ALL:ValSeq,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    <heap> H |-> list(ALL) ... </heap>
+    requires allFloatItems(REST)
+     andBool allFloatItems(ALL)
+
+  claim [find-closest]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("find_closest_elements"),
+           (list(vCons(F0:Float, vCons(F1:Float, REST:ValSeq))), .Exprs))
+      =>
+      outerBest(
+        enumVS(vCons(F0, vCons(F1, REST)), 0),
+        enumVS(vCons(F0, vCons(F1, REST)), 0),
+        orderedPair(F0, F1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        =>
+        0 |-> scope(
+               "find_closest_elements"
+                 |-> closureVal(
+                       ("numbers", .ParamNames),
+                       findBody,
+                       0),
+               parent(-1)) )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(enumVS(vCons(F0, vCons(F1, REST)), 0))
+      1 |-> list(enumVS(vCons(F0, vCons(F1, REST)), 0))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloatVS(REST)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fee38eb02d6186526ec8545877bc23e43ef5736b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,246 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports FLOAT-SYNTAX
+
+  syntax Stmts ::= "innerBody" [macro]
+                 | "outerBody" [macro]
+                 | "findBody"  [macro]
+  syntax Module ::= "solutionModule" [macro]
+
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  syntax Bool ::= allFloatVS(ValSeq)    [function, total]
+                | allFloatItems(ValSeq) [function, total]
+  syntax Float ::= floatProjection(Val) [function, total, no-evaluators]
+                 | itemFloat(Val)       [function, total, no-evaluators]
+  syntax Int ::= itemIndex(Val) [function, total, no-evaluators]
+  syntax Val ::= orderedPair(Float, Float)      [function, total]
+               | stepClosest(Val, Val, Val)     [function, total]
+               | innerBest(Val, ValSeq, Val)    [function, total]
+               | outerBest(ValSeq, ValSeq, Val) [function, total]
+               | lastItem(ValSeq, Val)          [function, total]
+
+  rule innerBody
+    => If(
+         Compare(
+           Subscript(Name("item1"), Int(0)),
+           CmpOp("<", Subscript(Name("item2"), Int(0)))),
+         If(
+           Compare(
+             Call(
+               Name("abs"),
+               (BinOp(
+                 "-",
+                 Subscript(Name("item2"), Int(1)),
+                 Subscript(Name("item1"), Int(1))),
+                .Exprs)),
+             CmpOp(
+               "<",
+               Call(
+                 Name("abs"),
+                 (BinOp(
+                   "-",
+                   Subscript(Name("closest"), Int(1)),
+                   Subscript(Name("closest"), Int(0))),
+                  .Exprs)))),
+           If(
+             Compare(
+               Subscript(Name("item1"), Int(1)),
+               CmpOp("<", Subscript(Name("item2"), Int(1)))),
+             (Assign(
+                Name("closest"),
+                TupleExpr(
+                  (Subscript(Name("item1"), Int(1)),
+                   Subscript(Name("item2"), Int(1)),
+                   .Exprs)))
+              .Stmts),
+             (Assign(
+                Name("closest"),
+                TupleExpr(
+                  (Subscript(Name("item2"), Int(1)),
+                   Subscript(Name("item1"), Int(1)),
+                   .Exprs)))
+              .Stmts)),
+           .Stmts),
+         .Stmts)
+
+  rule outerBody
+    => (For(Name("item2"), Name("items"), innerBody) .Stmts)
+
+  rule findBody
+    => If(
+         Compare(
+           Subscript(Name("numbers"), Int(0)),
+           CmpOp("<", Subscript(Name("numbers"), Int(1)))),
+         (Assign(
+            Name("closest"),
+            TupleExpr(
+              (Subscript(Name("numbers"), Int(0)),
+               Subscript(Name("numbers"), Int(1)),
+               .Exprs)))
+          .Stmts),
+         (Assign(
+            Name("closest"),
+            TupleExpr(
+              (Subscript(Name("numbers"), Int(1)),
+               Subscript(Name("numbers"), Int(0)),
+               .Exprs)))
+          .Stmts))
+       Assign(
+         Name("items"),
+         Call(
+           Name("list"),
+           (Call(Name("enumerate"), (Name("numbers"), .Exprs)), .Exprs)))
+       Assign(Name("item1"), Subscript(Name("items"), Int(0)))
+       Assign(Name("item2"), Subscript(Name("items"), Int(0)))
+       For(Name("item1"), Name("items"), outerBody)
+       Return(Name("closest"))
+       .Stmts
+
+  rule solutionModule
+    => Module(
+         ImportFrom("typing", ("List", "Tuple", .ParamNames))
+         FuncDef(
+           "find_closest_elements",
+           Params(("numbers", .ParamNames)),
+           findBody)
+         .Stmts)
+
+  rule allFloatVS(.ValSeq) => true
+  rule allFloatVS(vCons(V:Val, REST:ValSeq))
+    => (V ==K floatProjection(V)) andBool allFloatVS(REST)
+  rule floatProjection(F:Float) => F
+
+  rule allFloatItems(.ValSeq) => true
+  rule allFloatItems(vCons(V:Val, REST:ValSeq))
+    => ( V
+         ==K
+         tuple(
+           vCons(
+             itemIndex(V),
+             vCons(itemFloat(V), .ValSeq))) )
+       andBool allFloatItems(REST)
+  rule itemIndex(
+         tuple(vCons(I:Int, vCons(_:Float, .ValSeq))))
+    => I
+  rule itemFloat(
+         tuple(vCons(_:Int, vCons(F:Float, .ValSeq))))
+    => F
+
+  rule applyIndex(V:Val, 0) => itemIndex(V)
+    requires V
+      ==K tuple(
+            vCons(
+              itemIndex(V),
+              vCons(itemFloat(V), .ValSeq)))
+    [simplification]
+  rule applyIndex(V:Val, 1) => itemFloat(V)
+    requires V
+      ==K tuple(
+            vCons(
+              itemIndex(V),
+              vCons(itemFloat(V), .ValSeq)))
+    [simplification]
+
+  rule allFloatItems(enumVS(VS:ValSeq, _:Int))
+    => allFloatVS(VS)
+    [simplification]
+
+  rule orderedPair(X:Float, Y:Float)
+    => tuple(vCons(X, vCons(Y, .ValSeq)))
+    requires floatLt(X, Y)
+  rule orderedPair(X:Float, Y:Float)
+    => tuple(vCons(Y, vCons(X, .ValSeq)))
+    requires notBool floatLt(X, Y)
+
+  rule stepClosest(
+         ITEM1:Val,
+         ITEM2:Val,
+         tuple(vCons(A:Float, vCons(B:Float, .ValSeq))))
+    => orderedPair(itemFloat(ITEM1), itemFloat(ITEM2))
+    requires itemIndex(ITEM1) <Int itemIndex(ITEM2)
+     andBool floatLt(
+               absF(subF(itemFloat(ITEM2), itemFloat(ITEM1))),
+               absF(subF(B, A)))
+  rule stepClosest(
+         ITEM1:Val,
+         ITEM2:Val,
+         P:Val)
+    => P
+    requires itemIndex(ITEM1) >=Int itemIndex(ITEM2)
+  rule stepClosest(
+         ITEM1:Val,
+         ITEM2:Val,
+         tuple(vCons(A:Float, vCons(B:Float, .ValSeq))))
+    => tuple(vCons(A, vCons(B, .ValSeq)))
+    requires itemIndex(ITEM1) <Int itemIndex(ITEM2)
+     andBool notBool floatLt(
+                          absF(subF(itemFloat(ITEM2), itemFloat(ITEM1))),
+                          absF(subF(B, A)))
+  rule stepClosest(_ITEM1:Val, _ITEM2:Val, P:Val) => P [owise]
+
+  rule innerBest(_ITEM1:Val, .ValSeq, P:Val) => P
+  rule innerBest(
+         ITEM1:Val,
+         vCons(ITEM2:Val, REST:ValSeq),
+         P:Val)
+    => innerBest(ITEM1, REST, stepClosest(ITEM1, ITEM2, P))
+
+  rule outerBest(.ValSeq, _ALL:ValSeq, P:Val) => P
+  rule outerBest(
+         vCons(ITEM1:Val, REST:ValSeq),
+         ALL:ValSeq,
+         P:Val)
+    => outerBest(REST, ALL, innerBest(ITEM1, ALL, P))
+
+  rule lastItem(.ValSeq, OLD:Val) => OLD
+  rule lastItem(vCons(V:Val, REST:ValSeq), _OLD:Val)
+    => lastItem(REST, V)
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  rule <k>
+         #loop(list(REST:ValSeq), Name("item2"), innerBody)
+         => .K
+         ...
+       </k>
+       <env> 1 </env>
+       <scopes>
+         -1 |-> BS:Scope
+         0 |-> scope(
+                "find_closest_elements"
+                  |-> closureVal(
+                        ("numbers", .ParamNames),
+                        findBody,
+                        0),
+                parent(-1))
+         1 |-> scope(
+                "numbers" |-> _NUMBERS:Val
+                "items"   |-> _ITEMSREF:Val
+                "item1"   |-> ITEM1:Val
+                "item2"   |-> (OLD2:Val => lastItem(REST, OLD2))
+                "closest" |->
+                  ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                    =>
+                    innerBest(
+                      ITEM1,
+                      REST,
+                      tuple(vCons(A, vCons(B, .ValSeq)))) ),
+                parent(0))
+       </scopes>
+    requires BS ==K builtinsScope
+     andBool ITEM1
+       ==K tuple(
+             vCons(
+               itemIndex(ITEM1),
+               vCons(itemFloat(ITEM1), .ValSeq)))
+     andBool allFloatItems(REST)
+endmodule

