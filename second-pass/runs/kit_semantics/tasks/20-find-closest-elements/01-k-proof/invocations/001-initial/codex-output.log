+from typing import List, Tuple
+
+
+def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:
+    if numbers[0] < numbers[1]:
+        closest = (numbers[0], numbers[1])
+    else:
+        closest = (numbers[1], numbers[0])
+    items = list(enumerate(numbers))
+    item1 = items[0]
+    item2 = items[0]
+    for item1 in items:
+        for item2 in items:
+            if item1[0] < item2[0]:
+                if abs(item2[1] - item1[1]) < abs(closest[1] - closest[0]):
+                    if item1[1] < item2[1]:
+                        closest = (item1[1], item2[1])
+                    else:
+                        closest = (item2[1], item1[1])
+    return closest
diff --git a/spec-small.k b/spec-small.k
new file mode 100644
index 0000000000000000000000000000000000000000..79cdb9627d28430015b65fcf1bb953d045e44e64
--- /dev/null
+++ b/spec-small.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC-SMALL
+  imports VERIFICATION
+
+  claim [find-closest-two]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("find_closest_elements"),
+           (list(vCons(F0:Float, vCons(F1:Float, .ValSeq))), .Exprs))
+      =>
+      orderedPair(F0, F1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        =>
+        0 |-> scope(
+               "find_closest_elements"
+                 |-> closureVal(
+                       ("numbers", .ParamNames),
+                       findBody,
+                       0),
+               parent(-1)) )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               tuple(vCons(0, vCons(F0, .ValSeq))),
+               vCons(
+                 tuple(vCons(1, vCons(F1, .ValSeq))),
+                 .ValSeq)))
+      1 |-> list(
+             vCons(
+               tuple(vCons(0, vCons(F0, .ValSeq))),
+               vCons(
+                 tuple(vCons(1, vCons(F1, .ValSeq))),
+                 .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..73525c01e4eca36d4e566079d1bb1264e52701b0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,112 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("item2"), innerBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ITEMSREF:Val
+             "item1"   |-> tuple(vCons(I:Int, vCons(X:Float, .ValSeq)))
+             "item2"   |-> (OLD2:Val => ?FINAL2:Val)
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 innerBest(
+                   tuple(vCons(I, vCons(X, .ValSeq))),
+                   REST,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    requires allFloatItems(REST)
+
+  claim [outer-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("item1"), outerBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "find_closest_elements"
+               |-> closureVal(
+                     ("numbers", .ParamNames),
+                     findBody,
+                     0),
+             parent(-1))
+      1 |-> scope(
+             "numbers" |-> NUMBERS:Val
+             "items"   |-> ref(H:Int)
+             "item1"   |-> (OLD1:Val => ?FINAL1:Val)
+             "item2"   |-> (OLD2:Val => ?FINAL2:Val)
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 outerBest(
+                   REST,
+                   ALL:ValSeq,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    <heap> H |-> list(ALL) ... </heap>
+    requires allFloatItems(REST)
+     andBool allFloatItems(ALL)
+
+  claim [find-closest]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("find_closest_elements"),
+           (list(vCons(F0:Float, vCons(F1:Float, REST:ValSeq))), .Exprs))
+      =>
+      outerBest(
+        enumVS(vCons(F0, vCons(F1, REST)), 0),
+        enumVS(vCons(F0, vCons(F1, REST)), 0),
+        orderedPair(F0, F1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        =>
+        0 |-> scope(
+               "find_closest_elements"
+                 |-> closureVal(
+                       ("numbers", .ParamNames),
+                       findBody,
+                       0),
+               parent(-1)) )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(enumVS(vCons(F0, vCons(F1, REST)), 0))
+      1 |-> list(enumVS(vCons(F0, vCons(F1, REST)), 0))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloatVS(REST)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8517de97a192fc5eff3b94dc855201fca83e3dbd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,181 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports FLOAT-SYNTAX
+
+  syntax Stmts ::= "innerBody" [macro]
+                 | "outerBody" [macro]
+                 | "findBody"  [macro]
+  syntax Module ::= "solutionModule" [macro]
+
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  syntax Bool ::= allFloatVS(ValSeq)    [function, total]
+                | allFloatItems(ValSeq) [function, total]
+  syntax Float ::= floatProjection(Val) [function, total, no-evaluators]
+                 | itemFloat(Val)       [function, total, no-evaluators]
+  syntax Int ::= itemIndex(Val) [function, total, no-evaluators]
+  syntax Val ::= orderedPair(Float, Float)      [function, total]
+               | stepClosest(Val, Val, Val)     [function, total]
+               | innerBest(Val, ValSeq, Val)    [function, total]
+               | outerBest(ValSeq, ValSeq, Val) [function, total]
+
+  rule innerBody
+    => If(
+         Compare(
+           Subscript(Name("item1"), Int(0)),
+           CmpOp("<", Subscript(Name("item2"), Int(0)))),
+         If(
+           Compare(
+             Call(
+               Name("abs"),
+               (BinOp(
+                 "-",
+                 Subscript(Name("item2"), Int(1)),
+                 Subscript(Name("item1"), Int(1))),
+                .Exprs)),
+             CmpOp(
+               "<",
+               Call(
+                 Name("abs"),
+                 (BinOp(
+                   "-",
+                   Subscript(Name("closest"), Int(1)),
+                   Subscript(Name("closest"), Int(0))),
+                  .Exprs)))),
+           If(
+             Compare(
+               Subscript(Name("item1"), Int(1)),
+               CmpOp("<", Subscript(Name("item2"), Int(1)))),
+             (Assign(
+                Name("closest"),
+                TupleExpr(
+                  (Subscript(Name("item1"), Int(1)),
+                   Subscript(Name("item2"), Int(1)),
+                   .Exprs)))
+              .Stmts),
+             (Assign(
+                Name("closest"),
+                TupleExpr(
+                  (Subscript(Name("item2"), Int(1)),
+                   Subscript(Name("item1"), Int(1)),
+                   .Exprs)))
+              .Stmts)),
+           .Stmts),
+         .Stmts)
+
+  rule outerBody
+    => (For(Name("item2"), Name("items"), innerBody) .Stmts)
+
+  rule findBody
+    => If(
+         Compare(
+           Subscript(Name("numbers"), Int(0)),
+           CmpOp("<", Subscript(Name("numbers"), Int(1)))),
+         (Assign(
+            Name("closest"),
+            TupleExpr(
+              (Subscript(Name("numbers"), Int(0)),
+               Subscript(Name("numbers"), Int(1)),
+               .Exprs)))
+          .Stmts),
+         (Assign(
+            Name("closest"),
+            TupleExpr(
+              (Subscript(Name("numbers"), Int(1)),
+               Subscript(Name("numbers"), Int(0)),
+               .Exprs)))
+          .Stmts))
+       Assign(
+         Name("items"),
+         Call(
+           Name("list"),
+           (Call(Name("enumerate"), (Name("numbers"), .Exprs)), .Exprs)))
+       Assign(Name("item1"), Subscript(Name("items"), Int(0)))
+       Assign(Name("item2"), Subscript(Name("items"), Int(0)))
+       For(Name("item1"), Name("items"), outerBody)
+       Return(Name("closest"))
+       .Stmts
+
+  rule solutionModule
+    => Module(
+         ImportFrom("typing", ("List", "Tuple", .ParamNames))
+         FuncDef(
+           "find_closest_elements",
+           Params(("numbers", .ParamNames)),
+           findBody)
+         .Stmts)
+
+  rule allFloatVS(.ValSeq) => true
+  rule allFloatVS(vCons(V:Val, REST:ValSeq))
+    => (V ==K floatProjection(V)) andBool allFloatVS(REST)
+  rule floatProjection(F:Float) => F
+
+  rule allFloatItems(.ValSeq) => true
+  rule allFloatItems(vCons(V:Val, REST:ValSeq))
+    => ( V
+         ==K
+         tuple(
+           vCons(
+             itemIndex(V),
+             vCons(itemFloat(V), .ValSeq))) )
+       andBool allFloatItems(REST)
+  rule itemIndex(
+         tuple(vCons(I:Int, vCons(_:Float, .ValSeq))))
+    => I
+  rule itemFloat(
+         tuple(vCons(_:Int, vCons(F:Float, .ValSeq))))
+    => F
+
+  rule allFloatItems(enumVS(VS:ValSeq, _:Int))
+    => allFloatVS(VS)
+    [simplification]
+
+  rule orderedPair(X:Float, Y:Float)
+    => tuple(vCons(X, vCons(Y, .ValSeq)))
+    requires floatLt(X, Y)
+  rule orderedPair(X:Float, Y:Float)
+    => tuple(vCons(Y, vCons(X, .ValSeq)))
+    requires notBool floatLt(X, Y)
+
+  rule stepClosest(
+         tuple(vCons(I:Int, vCons(X:Float, .ValSeq))),
+         tuple(vCons(J:Int, vCons(Y:Float, .ValSeq))),
+         tuple(vCons(A:Float, vCons(B:Float, .ValSeq))))
+    => orderedPair(X, Y)
+    requires I <Int J
+     andBool floatLt(absF(subF(Y, X)), absF(subF(B, A)))
+  rule stepClosest(
+         tuple(vCons(I:Int, vCons(_X:Float, .ValSeq))),
+         tuple(vCons(J:Int, vCons(_Y:Float, .ValSeq))),
+         P:Val)
+    => P
+    requires I >=Int J
+  rule stepClosest(
+         tuple(vCons(I:Int, vCons(X:Float, .ValSeq))),
+         tuple(vCons(J:Int, vCons(Y:Float, .ValSeq))),
+         tuple(vCons(A:Float, vCons(B:Float, .ValSeq))))
+    => tuple(vCons(A, vCons(B, .ValSeq)))
+    requires I <Int J
+     andBool notBool floatLt(absF(subF(Y, X)), absF(subF(B, A)))
+  rule stepClosest(_ITEM1:Val, _ITEM2:Val, P:Val) => P [owise]
+
+  rule innerBest(_ITEM1:Val, .ValSeq, P:Val) => P
+  rule innerBest(
+         ITEM1:Val,
+         vCons(ITEM2:Val, REST:ValSeq),
+         P:Val)
+    => innerBest(ITEM1, REST, stepClosest(ITEM1, ITEM2, P))
+
+  rule outerBest(.ValSeq, _ALL:ValSeq, P:Val) => P
+  rule outerBest(
+         vCons(ITEM1:Val, REST:ValSeq),
+         ALL:ValSeq,
+         P:Val)
+    => outerBest(REST, ALL, innerBest(ITEM1, ALL, P))
+endmodule

