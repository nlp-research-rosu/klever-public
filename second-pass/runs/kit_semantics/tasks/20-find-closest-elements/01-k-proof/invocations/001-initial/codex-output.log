+             "item2"   |-> (OLD2:Val => lastItem(REST, OLD2))
+             "closest" |->
+               ( tuple(vCons(A:Float, vCons(B:Float, .ValSeq)))
+                 =>
+                 innerBest(
+                   ITEM1,
+                   REST,
+                   tuple(vCons(A, vCons(B, .ValSeq)))) ),
+             parent(0))
+    </scopes>
+    requires ITEM1
