Module(
  ImportFrom("typing", "List", "Tuple")
  FuncDef("find_closest_elements", Params("numbers"),
    If(Compare(
      Subscript(Name("numbers"), Int(0)),
      CmpOp("<", Subscript(Name("numbers"), Int(1)))),
      Assign(
        Name("closest"),
        TupleExpr(
          Subscript(Name("numbers"), Int(0)),
          Subscript(Name("numbers"), Int(1)))),
      Assign(
        Name("closest"),
        TupleExpr(
          Subscript(Name("numbers"), Int(1)),
          Subscript(Name("numbers"), Int(0)))))
    Assign(
      Name("items"),
      Call(Name("list"), Call(Name("enumerate"), Name("numbers"))))
    Assign(Name("item1"), Subscript(Name("items"), Int(0)))
    Assign(Name("item2"), Subscript(Name("items"), Int(0)))
    For(Name("item1"), Name("items"),
      For(Name("item2"), Name("items"),
        If(Compare(
          Subscript(Name("item1"), Int(0)),
          CmpOp("<", Subscript(Name("item2"), Int(0)))),
          If(Compare(
            Call(
              Name("abs"),
              BinOp(
                "-",
                Subscript(Name("item2"), Int(1)),
                Subscript(Name("item1"), Int(1)))),
            CmpOp(
              "<",
              Call(
                Name("abs"),
                BinOp(
                  "-",
                  Subscript(Name("closest"), Int(1)),
                  Subscript(Name("closest"), Int(0)))))),
            If(Compare(
              Subscript(Name("item1"), Int(1)),
              CmpOp("<", Subscript(Name("item2"), Int(1)))),
              Assign(
                Name("closest"),
                TupleExpr(
                  Subscript(Name("item1"), Int(1)),
                  Subscript(Name("item2"), Int(1)))),
              Assign(
                Name("closest"),
                TupleExpr(
                  Subscript(Name("item2"), Int(1)),
                  Subscript(Name("item1"), Int(1))))),
            ),
          )))
    Return(Name("closest")))
  Assert(
    Compare(
      Call(
        Name("find_closest_elements"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(3.0),
          Float(4.0),
          Float(5.0),
          Float(2.2))),
      CmpOp("==", TupleExpr(Float(2.0), Float(2.2)))))
  Assert(
    Compare(
      Call(
        Name("find_closest_elements"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(3.0),
          Float(4.0),
          Float(5.0),
          Float(2.0))),
      CmpOp("==", TupleExpr(Float(2.0), Float(2.0)))))
  Assert(
    Compare(
      Call(
        Name("find_closest_elements"),
        ListExpr(
          Float(4.0),
          UnaryOp("-", Float(1.0)),
          Float(10.0),
          Float(4.25))),
      CmpOp("==", TupleExpr(Float(4.0), Float(4.25)))))
  Assert(
    Compare(
      Call(
        Name("find_closest_elements"),
        ListExpr(Float(2.0), Float(1.0))),
      CmpOp("==", TupleExpr(Float(1.0), Float(2.0))))))
