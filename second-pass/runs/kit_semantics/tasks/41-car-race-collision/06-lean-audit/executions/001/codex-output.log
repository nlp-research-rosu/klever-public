+COMMAND
+PYTHONPATH=/reference python3 -c '<the following inline program>'
+
+INLINE PROGRAM
+import hashlib,json,re
+from pathlib import Path
+from tools.pipeline_contract import sha256_tree
+gm=json.loads(Path("/reference/klean-generation/generator-manifest.json").read_text())
+sm=json.loads(Path("/reference/generation-tools/source-manifest.json").read_text())
+ai=json.loads(Path("/audit-input.json").read_text())["resolution"]
+observed={n:hashlib.sha256((Path("/reference/generation-tools")/n).read_bytes()).hexdigest() for n in ("klean_export.py","klean.py")}
+expected={"klean_export.py":gm["exporter_sha256"],"klean.py":gm["klean_py_sha256"]}
+audit_image="sha256:"+Path(ai["generation_producer_sources"]).name
+print("observed_files",observed)
+print("generator_expected_files",expected)
+print("source_manifest_files",sm["files"])
+print("generator_image_id",gm["provenance"]["generator_image_id"])
+print("source_manifest_image_id",sm["generator_image_id"])
+print("audit_input_path_image_id",audit_image)
+print("observed_bundle_sha256",sha256_tree(Path("/reference/generation-tools")))
+print("audit_input_bundle_sha256",ai["hashes"]["generation_producer_sources_sha256"])
+print("all_file_hashes_match",observed==expected==sm["files"])
+print("all_image_ids_match",gm["provenance"]["generator_image_id"]==sm["generator_image_id"]==audit_image)
+
