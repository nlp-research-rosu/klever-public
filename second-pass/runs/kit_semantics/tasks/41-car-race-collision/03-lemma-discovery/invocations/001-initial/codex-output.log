assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert isinstance(out['rules'], list)
canonical_ids = [r['source_rule_id'] for r in inv['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == canonical_ids
assert len(out_ids) == len(set(out_ids))
for entry in out['rules']:
    assert set(entry) == {'source_rule_id', 'classification', 'rationale'}
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
for src, entry in zip(inv['rules'], out['rules']):
    attrs = src.get('attributes', [])
    if isinstance(attrs, str): attrs = [attrs]
    if 'simplification' in attrs:
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print('schema_exact: True')
print('inventory_hash_exact: True')
