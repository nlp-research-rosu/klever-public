+      #loadAll(
+        Module(
+          FuncDef(
+            "car_race_collision",
+            Params("n"),
+            Return(BinOp("*", Name("n"), Name("n")))
+          )
+        )
+      )
+      ~> Call(Name("car_race_collision"), Int(N:Int))
+      => (N *Int N) +Int 2
+    </k>
+    <env> 0 </env>
+    <scopes>
