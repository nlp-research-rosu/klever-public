+test "$hash_status" -eq 0 || exit "$hash_status"
+
+echo '$ python3 /audit-output/evidence/02-program-fidelity/differential_test.py'
+python3 /audit-output/evidence/02-program-fidelity/differential_test.py
+diff_status=$?
