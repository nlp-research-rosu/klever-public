+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "car_race_collision"
+                 |-> closureVal(
+                       ("n", .ParamNames),
+                       (Return(BinOp("*", Name("n"), Name("n"))) .Stmts),
+                       0
+                     ),
+               parent(-1)
+             )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
