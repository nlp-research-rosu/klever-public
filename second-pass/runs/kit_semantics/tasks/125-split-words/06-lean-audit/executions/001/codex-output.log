+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[PATH_MAX + 1];
+  ssize_t length = readlink("/proc/self/exe", buffer, PATH_MAX);
+  if (length < 0) {
+    printf("readlink failed: errno=%d %s\n", errno, strerror(errno));
+    return 1;
+  }
+  buffer[length] = '\0';
+  printf("%s\n", buffer);
+  return 0;
+}
