+    print(f"theorem_declarations={theorem_declarations}")
+    print(f"target_statement={target_statement(GENERATED)!r}")
+    print(f"OVERALL={'PASS' if all_ok else 'FAIL'}")
+    if not all_ok:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
