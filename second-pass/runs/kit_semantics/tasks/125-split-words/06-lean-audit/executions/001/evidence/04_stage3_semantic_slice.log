    77	  // Direct mathematical restatement of the requested odd zero-based
    78	  // lowercase alphabet positions: b, d, ..., z.
    79	  syntax Int ::= oddAlphabetCount(IntSeq) [function, total]
    80	  rule oddAlphabetCount(CS) =>
    81	    cntSub(CS, iCons(98,  .IntSeq))
    82	      +Int cntSub(CS, iCons(100, .IntSeq))
    83	      +Int cntSub(CS, iCons(102, .IntSeq))
    84	      +Int cntSub(CS, iCons(104, .IntSeq))
    85	      +Int cntSub(CS, iCons(106, .IntSeq))
    86	      +Int cntSub(CS, iCons(108, .IntSeq))
    87	      +Int cntSub(CS, iCons(110, .IntSeq))
    88	      +Int cntSub(CS, iCons(112, .IntSeq))
    89	      +Int cntSub(CS, iCons(114, .IntSeq))
    90	      +Int cntSub(CS, iCons(116, .IntSeq))
    91	      +Int cntSub(CS, iCons(118, .IntSeq))
    92	      +Int cntSub(CS, iCons(120, .IntSeq))
    93	      +Int cntSub(CS, iCons(122, .IntSeq))
    94	endmodule
     1	def split_words(txt):
     2	    parts = txt.split()
     3	    if txt and parts != [txt]:
     4	        return parts
     5	    if "," in txt:
     6	        return txt.split(",")
     7	    return (
     8	        txt.count("b")
     9	        + txt.count("d")
    10	        + txt.count("f")
    11	        + txt.count("h")
    12	        + txt.count("j")
    13	        + txt.count("l")
    14	        + txt.count("n")
    15	        + txt.count("p")
    16	        + txt.count("r")
    17	        + txt.count("t")
    18	        + txt.count("v")
    19	        + txt.count("x")
    20	        + txt.count("z")
    21	    )
