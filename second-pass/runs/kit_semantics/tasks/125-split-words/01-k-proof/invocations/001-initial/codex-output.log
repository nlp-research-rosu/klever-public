+               "split_words" |-> closureVal(("txt", .ParamNames), splitWordsBody, 0),
+               parent(-1)
+             )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           vCons(
