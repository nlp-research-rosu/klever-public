+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [split-words-whitespace]:
+    <k>
+      Call(Name("split_words"), str(CS:IntSeq), .Exprs)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+               "split_words" |-> closureVal(("txt", .ParamNames), splitWordsBody, 0),
+               parent(-1)
+             )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(splitWS(CS, .IntSeq, .ValSeq))
+         1 |-> list(vCons(str(CS), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires notBool (CS ==K .IntSeq)
+      andBool notBool (
