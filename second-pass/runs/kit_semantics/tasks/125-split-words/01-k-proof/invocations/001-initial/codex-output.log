diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3ffde5563194d6880119e0957b630407b163c91f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,94 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact constructor body emitted for split_words by py2mpy.py.
+  syntax Stmts ::= "splitWordsBody" [function, total]
+  rule splitWordsBody =>
+    Assign(Name("parts"), Call(Attribute(Name("txt"), "split"), .Exprs))
+    If(
+      BoolOp(
+        "and",
+        Name("txt"),
+        Compare(Name("parts"), CmpOp("!=", ListExpr(Name("txt"), .Exprs))),
+        .Exprs
+      ),
+      Return(Name("parts")) .Stmts,
+      .Stmts
+    )
+    If(
+      Compare(Str(","), CmpOp("in", Name("txt"))),
+      Return(Call(Attribute(Name("txt"), "split"), Str(","), .Exprs)) .Stmts,
+      .Stmts
+    )
+    Return(
+      BinOp(
+        "+",
+        BinOp(
+          "+",
+          BinOp(
+            "+",
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          BinOp(
+                            "+",
+                            BinOp(
+                              "+",
+                              Call(Attribute(Name("txt"), "count"), Str("b"), .Exprs),
+                              Call(Attribute(Name("txt"), "count"), Str("d"), .Exprs)
+                            ),
+                            Call(Attribute(Name("txt"), "count"), Str("f"), .Exprs)
+                          ),
+                          Call(Attribute(Name("txt"), "count"), Str("h"), .Exprs)
+                        ),
+                        Call(Attribute(Name("txt"), "count"), Str("j"), .Exprs)
+                      ),
+                      Call(Attribute(Name("txt"), "count"), Str("l"), .Exprs)
+                    ),
+                    Call(Attribute(Name("txt"), "count"), Str("n"), .Exprs)
+                  ),
+                  Call(Attribute(Name("txt"), "count"), Str("p"), .Exprs)
+                ),
+                Call(Attribute(Name("txt"), "count"), Str("r"), .Exprs)
+              ),
+              Call(Attribute(Name("txt"), "count"), Str("t"), .Exprs)
+            ),
+            Call(Attribute(Name("txt"), "count"), Str("v"), .Exprs)
+          ),
+          Call(Attribute(Name("txt"), "count"), Str("x"), .Exprs)
+        ),
+        Call(Attribute(Name("txt"), "count"), Str("z"), .Exprs)
+      )
+    ) .Stmts
+
+  // Direct mathematical restatement of the requested odd zero-based
+  // lowercase alphabet positions: b, d, ..., z.
+  syntax Int ::= oddAlphabetCount(IntSeq) [function, total]
+  rule oddAlphabetCount(CS) =>
+    cntSub(CS, iCons(98,  .IntSeq))
+      +Int cntSub(CS, iCons(100, .IntSeq))
+      +Int cntSub(CS, iCons(102, .IntSeq))
+      +Int cntSub(CS, iCons(104, .IntSeq))
+      +Int cntSub(CS, iCons(106, .IntSeq))
+      +Int cntSub(CS, iCons(108, .IntSeq))
+      +Int cntSub(CS, iCons(110, .IntSeq))
+      +Int cntSub(CS, iCons(112, .IntSeq))
+      +Int cntSub(CS, iCons(114, .IntSeq))
+      +Int cntSub(CS, iCons(116, .IntSeq))
+      +Int cntSub(CS, iCons(118, .IntSeq))
+      +Int cntSub(CS, iCons(120, .IntSeq))
+      +Int cntSub(CS, iCons(122, .IntSeq))
+endmodule

diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..62b4e68f274d6ff540213e20d17afe65d558522a
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,41 @@
+from itertools import product
+
+from solution import split_words
+
+
+def oracle(txt):
+    if any(char.isspace() for char in txt):
+        return txt.split()
+    if "," in txt:
+        return txt.split(",")
+    odd_letters = "bdfhjlnprtvxz"
+    return sum(1 for char in txt if char in odd_letters)
+
+
+alphabet = ["a", "b", "z", ",", " ", "\t", "\v", "é", "β"]
+cases = [
+    "",
+    "Hello world!",
+    "Hello,world!",
+    "abcdef",
+    ",",
+    "a,,b",
+    " \t ",
+    "\v",
+    "β,é",
+]
+for size in range(1, 4):
+    cases.extend("".join(chars) for chars in product(alphabet, repeat=size))
+
+mismatches = []
+for text in cases:
+    actual = split_words(text)
+    expected = oracle(text)
+    if actual != expected:
+        mismatches.append((text, actual, expected))
+
+print(f"cases={len(cases)} mismatches={len(mismatches)}")
+if mismatches:
+    for mismatch in mismatches[:10]:
+        print(repr(mismatch))
+    raise SystemExit(1)
diff --git a/mutation-verification.k b/mutation-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..54e73341176a1ff0b4219d7b33d8ba145517114e
--- /dev/null
+++ b/mutation-verification.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module MUTATION-VERIFICATION
+  imports VERIFICATION
+
+  // Material body mutation: preserve delimiter handling, but replace the
+  // no-delimiter count computation by the constant zero.
+  syntax Stmts ::= "mutatedSplitWordsBody" [function, total]
+  rule mutatedSplitWordsBody =>
+    Assign(Name("parts"), Call(Attribute(Name("txt"), "split"), .Exprs))
+    If(
+      BoolOp(
+        "and",
+        Name("txt"),
+        Compare(Name("parts"), CmpOp("!=", ListExpr(Name("txt"), .Exprs))),
+        .Exprs
+      ),
+      Return(Name("parts")) .Stmts,
+      .Stmts
+    )
+    If(
+      Compare(Str(","), CmpOp("in", Name("txt"))),
+      Return(Call(Attribute(Name("txt"), "split"), Str(","), .Exprs)) .Stmts,
+      .Stmts
+    )
+    Return(Int(0)) .Stmts
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..68c5fd1ccd8cf637bf87c829e15ff374900f91ef
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,30 @@
+def split_words(txt):
+    parts = txt.split()
+    if txt and parts != [txt]:
+        return parts
+    if "," in txt:
+        return txt.split(",")
+    return (
+        txt.count("b")
+        + txt.count("d")
+        + txt.count("f")
+        + txt.count("h")
+        + txt.count("j")
+        + txt.count("l")
+        + txt.count("n")
+        + txt.count("p")
+        + txt.count("r")
+        + txt.count("t")
+        + txt.count("v")
+        + txt.count("x")
+        + txt.count("z")
+    )
+
+
+assert split_words("Hello world!") == ["Hello", "world!"]
+assert split_words("Hello,world!") == ["Hello", "world!"]
+assert split_words("abcdef") == 3
+assert split_words("") == 0
+assert split_words(",") == ["", ""]
+# Reference-model boundary witness: its isWSC table omits vertical tab.
+assert split_words("\v") == 0
