  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
  rule inLevelE(_:String, _:String) => false [owise]
  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
