/bin/bash -lc 'set -o pipefail
export PATH="$HOME/.nix-profile/bin:$PATH"
{
  echo '"'COMMAND: python3 /audit-output/evidence/stage4_pinning.py'
  python3 /audit-output/evidence/stage4_pinning.py
  pin_status="'$?
  echo "PINNING_EXIT_STATUS: ${pin_status}"
  echo '"'COMMAND: python3 /audit-output/evidence/stage4_ground_witnesses.py'
  python3 /audit-output/evidence/stage4_ground_witnesses.py
  witness_status="'$?
  echo "WITNESS_EXIT_STATUS: ${witness_status}"
  test "${pin_status}" -eq 0 -a "${witness_status}" -eq 0
} 2>&1 | tee /audit-output/evidence/stage4_pinning_and_witnesses.log
stage4_status=${PIPESTATUS[0]}
echo "OVERALL_EXIT_STATUS: ${stage4_status}" | tee -a /audit-output/evidence/stage4_pinning_and_witnesses.log
exit "${stage4_status}"' in /tmp/audit-work/125-split-words
