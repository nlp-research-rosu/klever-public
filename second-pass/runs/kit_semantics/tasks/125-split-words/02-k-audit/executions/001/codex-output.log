+      )
+      => 4
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "split_words" |-> closureVal(
+          ("txt", .ParamNames),
+          splitWordsBody,
+          0
+        ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
