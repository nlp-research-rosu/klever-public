  echo 'COMMAND: kprove auditor-vacuity.k --definition auditor-verification-kompiled --spec-module AUDITOR-VACUITY --dry-run'
  kprove auditor-vacuity.k --definition auditor-verification-kompiled --spec-module AUDITOR-VACUITY --dry-run
  dry_status="'$?
  echo "DRY_RUN_EXIT_STATUS: ${dry_status}"
  echo '"'COMMAND: kprove auditor-vacuity.k --definition auditor-verification-kompiled --spec-module AUDITOR-VACUITY'
  kprove auditor-vacuity.k --definition auditor-verification-kompiled --spec-module AUDITOR-VACUITY
  proof_status="'$?
  echo "PROOF_EXIT_STATUS: ${proof_status}"
  test "${dry_status}" -eq 0 -a "${proof_status}" -ne 0
} 2>&1 | tee /audit-output/evidence/stage6_false_mutation.log
probe_status=${PIPESTATUS[0]}
residual_status=0
rg -q '"'WarnStuckClaimState' /audit-output/evidence/stage6_false_mutation.log || residual_status=1
rg -q '<k> 3 ~> \\.K </k>' /audit-output/evidence/stage6_false_mutation.log || residual_status=1
echo \"EXPECTED_RESIDUAL_CHECK_STATUS: "'${residual_status}" | tee -a /audit-output/evidence/stage6_false_mutation.log
overall_status=$(( probe_status != 0 || residual_status != 0 ))
echo "OVERALL_EXIT_STATUS: ${overall_status}" | tee -a /audit-output/evidence/stage6_false_mutation.log
exit "${overall_status}"' in /tmp/audit-work/125-split-words
diff --git a//tmp/audit-work/125-split-words/auditor-smoke.py b//tmp/audit-work/125-split-words/auditor-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..9a246f6962da9ff2216cc9a6f51d3a02b1fdd709
--- /dev/null
+++ b//tmp/audit-work/125-split-words/auditor-smoke.py
@@ -0,0 +1,32 @@
+def split_words(txt):
+    parts = txt.split()
+    if txt and parts != [txt]:
+        return parts
+    if "," in txt:
+        return txt.split(",")
+    return (
+        txt.count("b")
+        + txt.count("d")
+        + txt.count("f")
+        + txt.count("h")
+        + txt.count("j")
+        + txt.count("l")
+        + txt.count("n")
+        + txt.count("p")
+        + txt.count("r")
+        + txt.count("t")
+        + txt.count("v")
+        + txt.count("x")
+        + txt.count("z")
+    )
+
+
+assert split_words("Hello world!") == ["Hello", "world!"]
+assert split_words("Hello,world!") == ["Hello", "world!"]
+assert split_words("abcdef") == 3
+assert split_words("") == 0
+assert split_words(",") == ["", ""]
+assert split_words("a,,b") == ["a", "", "b"]
+assert split_words("\talpha  beta\n") == ["alpha", "beta"]
+# Concrete witness for the supplied model's documented vertical-tab gap.
+assert split_words("\v") == 0
