+      .Map
+      => 0 |-> list(
+           vCons(
+             str(
+               iCons(97,
+                 iCons(98,
+                   iCons(99,
+                     iCons(100,
+                       iCons(101,
+                         iCons(102, .IntSeq))))))
+             ),
+             .ValSeq
+           )
+         )
+         1 |-> list(
+           vCons(
+             str(
+               iCons(97,
+                 iCons(98,
+                   iCons(99,
+                     iCons(100,
+                       iCons(101,
+                         iCons(102, .IntSeq))))))
+             ),
+             .ValSeq
+           )
+         )
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
