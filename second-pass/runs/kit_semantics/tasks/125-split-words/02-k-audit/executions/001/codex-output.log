@@ -0,0 +1,9 @@
+requires "verification.k"
+
+module AUDITOR-BODY-MUTATION
+  imports VERIFICATION
+
+  // Materially replace the actual function body term by a constant return.
+  syntax Stmts ::= "auditorMutatedBody" [function, total]
+  rule auditorMutatedBody => Return(Int(0)) .Stmts
+endmodule
diff --git a//tmp/audit-work/125-split-words/auditor-smoke.py b//tmp/audit-work/125-split-words/auditor-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..9a246f6962da9ff2216cc9a6f51d3a02b1fdd709
--- /dev/null
+++ b//tmp/audit-work/125-split-words/auditor-smoke.py
@@ -0,0 +1,32 @@
+def split_words(txt):
+    parts = txt.split()
+    if txt and parts != [txt]:
+        return parts
+    if "," in txt:
+        return txt.split(",")
+    return (
+        txt.count("b")
+        + txt.count("d")
+        + txt.count("f")
+        + txt.count("h")
+        + txt.count("j")
+        + txt.count("l")
+        + txt.count("n")
+        + txt.count("p")
+        + txt.count("r")
+        + txt.count("t")
+        + txt.count("v")
+        + txt.count("x")
+        + txt.count("z")
+    )
+
+
+assert split_words("Hello world!") == ["Hello", "world!"]
+assert split_words("Hello,world!") == ["Hello", "world!"]
+assert split_words("abcdef") == 3
+assert split_words("") == 0
+assert split_words(",") == ["", ""]
+assert split_words("a,,b") == ["a", "", "b"]
+assert split_words("\talpha  beta\n") == ["alpha", "beta"]
+# Concrete witness for the supplied model's documented vertical-tab gap.
+assert split_words("\v") == 0
