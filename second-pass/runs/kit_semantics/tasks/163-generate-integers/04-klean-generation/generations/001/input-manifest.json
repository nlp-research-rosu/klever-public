{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "VERIFICATION",
      "normalized_sha256": "e485812b492df1e2d627d73dd057ca7d00d04af511b2dc7bdd89e5e026812d48",
      "rationale": "This unconditional equation defines the total mathematical summary inClosedSpan by expanding it to the inclusive endpoint-order-independent Boolean predicate; it does not execute or observe a program configuration.",
      "source_rule_id": "rule-e485812b492df1e2d627d73dd057ca7d00d04af511b2dc7bdd89e5e026812d48",
      "start_line": 9,
      "text": "  rule inClosedSpan(A, B, D)\n    => ((A <=Int D andBool D <=Int B)\n        orBool (B <=Int D andBool D <=Int A))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 14,
      "module": "VERIFICATION",
      "normalized_sha256": "8e0942964d5eb30f25988841f3b2b7d776f3c0a617ec8af6602e2863e4e471e1",
      "rationale": "This constructor case defines keepDigit for a true selector by prepending the named digit to the remaining mathematical value sequence; it is one branch of an exhaustive structural helper.",
      "source_rule_id": "rule-8e0942964d5eb30f25988841f3b2b7d776f3c0a617ec8af6602e2863e4e471e1",
      "start_line": 14,
      "text": "  rule keepDigit(true,  D, REST) => vCons(D, REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "1ca5229dc152dfa3dcd21aa4974e7959fd9ec785342863588027006c39579132",
      "rationale": "This constructor case defines keepDigit for a false selector by returning the remaining mathematical value sequence unchanged; together with the true case it completes the structural helper definition.",
      "source_rule_id": "rule-1ca5229dc152dfa3dcd21aa4974e7959fd9ec785342863588027006c39579132",
      "start_line": 15,
      "text": "  rule keepDigit(false, _, REST) => REST"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "1d4a13583c5d0924f771db5d1584f01d12bfcbce0077644a396fa7bf3d6fa6e8",
      "rationale": "This unconditional finite equation defines expectedDigits as the ordered composition of the inClosedSpan and keepDigit summaries for 2, 4, 6, and 8; it names the postcondition value without replacing program execution.",
      "source_rule_id": "rule-1d4a13583c5d0924f771db5d1584f01d12bfcbce0077644a396fa7bf3d6fa6e8",
      "start_line": 18,
      "text": "  rule expectedDigits(A, B)\n    => keepDigit(inClosedSpan(A, B, 2), 2,\n         keepDigit(inClosedSpan(A, B, 4), 4,\n           keepDigit(inClosedSpan(A, B, 6), 6,\n             keepDigit(inClosedSpan(A, B, 8), 8, .ValSeq))))"
    }
  ],
