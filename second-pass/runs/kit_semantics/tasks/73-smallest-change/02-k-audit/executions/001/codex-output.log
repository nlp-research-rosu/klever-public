+
+  // Concrete state satisfying the loop claim: VS=[1,2], C=0, I=0.
+  claim [loop-witness]:
+    <k>
+      #while(
+        Compare(
+          Name("i"),
+          CmpOp(
+            "<",
+            BinOp(
+              "//",
+              Call(Name("len"), Name("arr")),
+              Int(2)))),
+        smallestLoopBody)
+      ~> (Return(Name("changes")) .Stmts):Stmts
+      ~> #endcall
+      =>
+      1
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "smallest_change"
+               |-> closureVal("arr", smallestBody, 0),
+             parent(-1))
+      1 |-> scope(
+             "arr" |-> list(vCons(1, vCons(2, .ValSeq)))
+             "changes" |-> 0
+             "i" |-> 0,
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "smallest_change"
