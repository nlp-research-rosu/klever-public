+      1 |-> scope(
+             "arr" |-> list(vCons(1, vCons(2, .ValSeq)))
+             "changes" |-> 0
+             "i" |-> 0,
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "smallest_change"
+               |-> closureVal("arr", smallestBody, 0),
+             parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
