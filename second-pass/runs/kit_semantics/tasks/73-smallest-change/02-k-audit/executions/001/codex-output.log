+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "smallest_change"
+               |-> closureVal("arr", smallestBody, 0),
+             parent(-1))
+      1 |-> scope(
+             "arr" |-> list(vCons(1, vCons(2, .ValSeq)))
+             "changes" |-> 0
+             "i" |-> 0,
+             parent(0))
+      =>
