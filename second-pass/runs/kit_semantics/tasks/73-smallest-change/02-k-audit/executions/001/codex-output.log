     7	def exhaustive_palindrome_oracle(arr, alphabet):
     8	    """Search every palindromic target over the input alphabet."""
     9	    if not arr:
    10	        return 0
    11	
    12	    half_len = (len(arr) + 1) // 2
    13	    best = len(arr)
    14	    for half in product(alphabet, repeat=half_len):
    15	        if len(arr) % 2:
    16	            target = half + half[-2::-1]
