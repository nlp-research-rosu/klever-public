+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This simplification rule asserts definedness of an applyCmp expression under integer-list and index bounds. Both #Ceil and applyCmp are defined outside the verification module, so the rule is a fact about existing operations, and prove.sh contains no earlier proof of this exact statement."
+    },
+    {
+      "source_rule_id": "rule-7d0900f779a5b5fd1f61ee250c8e2dec97c72e7f7d36ba256901d98e05be5c81",
+      "classification": "OPERATIONAL_RULE",
+      "rationale": "This rule performs an ordinary local execution step for the already-selected branch and its fixed counter AugAssign, updating the scopes cell while preserving the continuation and residual scope map. The earlier branch claims prove two separately guarded paths rather than this identical unguarded conditional rule, so it is not classified as a proved derived lemma."
+    },
+    {
+      "source_rule_id": "rule-68e408c289d4dbcc9f6a2c850e6d7132dc6fe6a9de89a43eee283509f814b917",
+      "classification": "DEFINITION",
+      "rationale": "This equation defines the fresh mathematical summary pairDiff using the supplied comparison at mirrored sequence positions."
+    },
+    {
+      "source_rule_id": "rule-d9a3ffcad89958373eb85a2441eba3dc368b162c2fc0f6811d095c2a9ea2bff4",
+      "classification": "DEFINITION",
+      "rationale": "This is the guarded base defining equation for the fresh recursive summary mismatchCount."
+    },
+    {
+      "source_rule_id": "rule-b924d8f7beb0f729244204ebe54a8e6f2a8a9adde16a047876615878fb00f505",
+      "classification": "DEFINITION",
+      "rationale": "This is the guarded recursive defining equation for the fresh summary mismatchCount, advancing the index and adding the current pair contribution."
+    },
+    {
+      "source_rule_id": "rule-53698f5d4516a68cfad0b5d035a1d78bc9b46c118a3c2e541a4a6ef1be0683a4",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This simplification rule states associativity about the pre-existing hooked integer-addition operation rather than defining a fresh verification symbol. No command in prove.sh first proves this exact equation in a module that omits it, so it is a trusted domain lemma."
+    }
+  ]
+}

