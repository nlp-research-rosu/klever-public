Module(
  FuncDef("smallest_change", Params("arr"),
    Assign(Name("changes"), Int(0))
    Assign(Name("i"), Int(0))
    While(Compare(
      Name("i"),
      CmpOp("<", BinOp("//", Call(Name("len"), Name("arr")), Int(2)))),
      If(Compare(
        Subscript(Name("arr"), Name("i")),
        CmpOp(
          "!=",
          Subscript(
            Name("arr"),
            BinOp(
              "-",
              BinOp("-", Call(Name("len"), Name("arr")), Name("i")),
              Int(1))))),
        AugAssign(Name("changes"), "+", Int(1)),
        )
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("changes")))
  Assert(
    Compare(
      Call(
        Name("smallest_change"),
        ListExpr(
          Int(1),
          Int(2),
          Int(3),
          Int(5),
          Int(4),
          Int(7),
          Int(9),
          Int(6))),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(
        Name("smallest_change"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(3), Int(2), Int(2))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("smallest_change"),
        ListExpr(Int(1), Int(2), Int(3), Int(2), Int(1))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("smallest_change"), ListExpr()),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("smallest_change"), ListExpr(Int(9))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("smallest_change"), ListExpr(Int(1), Int(2))),
      CmpOp("==", Int(1)))))
