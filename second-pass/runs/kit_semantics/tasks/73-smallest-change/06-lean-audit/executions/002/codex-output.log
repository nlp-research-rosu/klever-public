  "schema_version": 3,
  "source_rules": [
    {
      "attributes": [
        "priority(40)"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "e3d57a815d35a133fdf2ad33c9e09d6497aff7f27b698c83c66d8bfe04fcbb3a",
      "end_line": 56,
      "inventory_sha256": "3f2d6f96e2fde04bddd98fb0e5cc6357e5f39a29c219ed0264215d821bec45b9",
      "module": "VERIFICATION",
      "normalized_sha256": "80907d170695ac0e50e240d5c49a8b32450d664965ed274c57fd0644ebdbd791",
      "rationale": "This rule replaces the complete initialized loop and return configuration with the mismatch-count summary. The bridge-free loop claim proved by prove.sh is strictly more general, with arbitrary accumulator and index variables, an extra index guard, and a generalized result; it is not the identical installed statement. The installed algorithmic summary therefore remains a trusted domain lemma rather than a proved derived lemma.",
      "source_rule_id": "rule-80907d170695ac0e50e240d5c49a8b32450d664965ed274c57fd0644ebdbd791",
      "start_line": 9,
      "text": "  rule\n    <k>\n      #while(\n        Compare(\n          Name(\"i\"),\n          CmpOp(\n            \"<\",\n            BinOp(\n              \"//\",\n              Call(Name(\"len\"), Name(\"arr\")),\n              Int(2)))),\n        smallestLoopBody)\n      ~> (Return(Name(\"changes\")) .Stmts):Stmts\n      ~> #endcall\n      => mismatchCount(VS, 0, halfLen(VS))\n    </k>\n    <env> 1 => 0 </env>\n    <scopes>\n      -1 |-> fixedBuiltins\n      0 |-> scope(\n             \"smallest_change\"\n               |-> closureVal(\"arr\", smallestBody, 0),\n             parent(-1))\n      1 |-> scope(\n             \"arr\" |-> list(VS:ValSeq)\n             \"changes\" |-> 0\n             \"i\" |-> 0,\n             parent(0))\n      =>\n      -1 |-> fixedBuiltins\n      0 |-> scope(\n             \"smallest_change\"\n               |-> closureVal(\"arr\", smallestBody, 0),\n             parent(-1))\n    </scopes>\n    <scopeLoc> 2 => 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack>\n      ListItem(frame(.K, 0, 1))\n      =>\n      .List\n    </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    requires allInts(VS)\n    [priority(40)]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "e3d57a815d35a133fdf2ad33c9e09d6497aff7f27b698c83c66d8bfe04fcbb3a",
      "end_line": 103,
      "file": "verification-base.k",
      "inventory_sha256": "3f2d6f96e2fde04bddd98fb0e5cc6357e5f39a29c219ed0264215d821bec45b9",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "0a4fd72c46b3149583834f42a226e0e1c0adf4fda67461b4a052f6c7a887a526",
      "rationale": "This simplification rule asserts definedness of an applyCmp expression under integer-list and index bounds. Both #Ceil and applyCmp are defined outside the verification module, so the rule is a fact about existing operations, and prove.sh contains no earlier proof of this exact statement.",
      "source_rule_id": "rule-0a4fd72c46b3149583834f42a226e0e1c0adf4fda67461b4a052f6c7a887a526",
      "start_line": 94,
      "text": "  rule #Ceil(\n         applyCmp(\n           \"!=\",\n           valSeqAt(VS:ValSeq, I:Int),\n           valSeqAt(VS, vsLen(VS) -Int I +Int -1)))\n    => #Top\n    requires allInts(VS)\n      andBool 0 <=Int I\n      andBool I <Int halfLen(VS)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "e3d57a815d35a133fdf2ad33c9e09d6497aff7f27b698c83c66d8bfe04fcbb3a",
      "end_line": 151,
      "file": "verification-base.k",
      "inventory_sha256": "3f2d6f96e2fde04bddd98fb0e5cc6357e5f39a29c219ed0264215d821bec45b9",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "53698f5d4516a68cfad0b5d035a1d78bc9b46c118a3c2e541a4a6ef1be0683a4",
      "rationale": "This simplification rule states associativity about the pre-existing hooked integer-addition operation rather than defining a fresh verification symbol. No command in prove.sh first proves this exact equation in a module that omits it, so it is a trusted domain lemma.",
      "source_rule_id": "rule-53698f5d4516a68cfad0b5d035a1d78bc9b46c118a3c2e541a4a6ef1be0683a4",
      "start_line": 149,
      "text": "  rule (A:Int +Int B:Int) +Int C:Int\n    => A +Int (B +Int C)\n    [simplification]"
    }
  ],
