+)
+rendered = json.dumps(result, indent=2, sort_keys=True) + "\n"
+Path("/audit-output/evidence/stage4-preflight-returned.json").write_text(
+    rendered,
+    encoding="utf-8",
+)
+print(rendered, end="")

