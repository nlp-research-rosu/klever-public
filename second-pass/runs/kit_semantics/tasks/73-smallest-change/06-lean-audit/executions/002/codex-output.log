+    "recorded_generated_axioms": [entries[name] for name in sorted(entries)],
+    "lean_builtin_trust": sorted(used & builtins),
+    "all_reconciled": "sorryAx" not in used and not (used - allowed),
+}, indent=2, sort_keys=True))
