+entries = {
+    entry["name"]: entry
+    for entry in inventory["allowlist"]
+    if entry.get("name") in used
+}
+builtins = {"Classical.choice", "propext", "Quot.sound"}
+
+print(json.dumps({
+    "used_axioms": sorted(used),
+    "used_count": len(used),
+    "sorryAx_present": "sorryAx" in used,
+    "unrecorded": sorted(used - allowed),
