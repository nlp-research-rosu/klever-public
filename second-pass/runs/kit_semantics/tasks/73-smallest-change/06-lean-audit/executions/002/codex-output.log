noncomputable def «mismatchCount(_,_,_)_VERIFICATION-BASE_Int_ValSeq_Int_Int»
    (values : SortValSeq) (index stop : SortInt) : SortInt :=
  if index ≥ stop then 0
  else mismatchCountFuelModel values index (stop - index).toNat
