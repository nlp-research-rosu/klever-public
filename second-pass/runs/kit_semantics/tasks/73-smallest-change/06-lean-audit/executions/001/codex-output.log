+      ~> (Return(Name("changes")) .Stmts):Stmts
+      ~> #endcall
+      => mismatchCount(VS, 0, halfLen(VS))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> fixedBuiltins
+      0 |-> scope(
+             "smallest_change"
+               |-> closureVal("arr", smallestBody, 0),
+             parent(-1))
+      1 |-> scope(
+             "arr" |-> list(VS:ValSeq)
+             "changes" |-> 0
+             "i" |-> 0,
+             parent(0))
+      =>
+      -1 |-> fixedBuiltins
+      0 |-> scope(
+             "smallest_change"
+               |-> closureVal("arr", smallestBody, 0),
+             parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
