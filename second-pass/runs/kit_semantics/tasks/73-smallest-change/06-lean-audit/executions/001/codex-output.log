diff --git a//tmp/audit-work/hostpid_shim.c b//tmp/audit-work/hostpid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..8f64cd4ab1f290a214a0ba071c826ae2b984e287
--- /dev/null
+++ b//tmp/audit-work/hostpid_shim.c
@@ -0,0 +1,26 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The managed sandbox creates a PID namespace but exposes the host /proc.
+ * Lean 4.22's IO.appPath builds /proc/<getpid()>/exe, so its namespace PID
+ * is absent from that procfs. Return the host PID exposed by /proc/self.
+ */
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+    return (pid_t)1;
+  }
+  target[length] = '\0';
+  char *end = NULL;
+  long value = strtol(target, &end, 10);
+  if (end == target || *end != '\0' || value <= 0 || value > INT_MAX) {
+    return (pid_t)1;
+  }
+  return (pid_t)value;
+}
diff --git a//tmp/audit-work/readlink_probe.c b//tmp/audit-work/readlink_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..0e19aa01662ce2483c5da013d34df2991d814cfe
--- /dev/null
+++ b//tmp/audit-work/readlink_probe.c
@@ -0,0 +1,16 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  ssize_t n = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (n < 0) {
+    fprintf(stderr, "readlink failed: errno=%d (%s)\n", errno, strerror(errno));
+    return 1;
+  }
+  path[n] = '\0';
+  printf("readlink bytes=%zd path=%s\n", n, path);
+  return 0;
+}
diff --git a//tmp/audit-work/stage1-recheck/exact-loop-spec.k b//tmp/audit-work/stage1-recheck/exact-loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..470a8e938abed1f624f099eb62726165495e7f28
--- /dev/null
+++ b//tmp/audit-work/stage1-recheck/exact-loop-spec.k
@@ -0,0 +1,55 @@
+requires "loop-connection.k"
+
+module EXACT-LOOP-SPEC
+  imports LOOP-CONNECTION
+
+  // Reviewer-authored claim matching verification.k:9-56 exactly in its
+  // operational configuration, guard, and final value.
+  claim [audit-exact-loop-connection]:
+    <k>
+      #while(
+        Compare(
+          Name("i"),
+          CmpOp(
+            "<",
+            BinOp(
+              "//",
+              Call(Name("len"), Name("arr")),
+              Int(2)))),
+        smallestLoopBody)
+      ~> (Return(Name("changes")) .Stmts):Stmts
+      ~> #endcall
+      => mismatchCount(VS, 0, halfLen(VS))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> fixedBuiltins
+      0 |-> scope(
+             "smallest_change"
+               |-> closureVal("arr", smallestBody, 0),
+             parent(-1))
+      1 |-> scope(
+             "arr" |-> list(VS:ValSeq)
+             "changes" |-> 0
+             "i" |-> 0,
+             parent(0))
+      =>
+      -1 |-> fixedBuiltins
+      0 |-> scope(
+             "smallest_change"
+               |-> closureVal("arr", smallestBody, 0),
+             parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
