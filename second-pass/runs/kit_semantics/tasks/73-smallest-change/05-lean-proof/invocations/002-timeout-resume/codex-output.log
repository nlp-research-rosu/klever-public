+    mapContainsModel entries key = false := by
+  induction entries with
+  | nil => rfl
+  | cons entry rest ih =>
+      rw [mapContainsModel, if_neg (hAbsent entry (by simp))]
+      exact ih (fun candidate membership =>
+        hAbsent candidate (by simp [membership]))
