@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+static int is_proc_exe(const char *path) {
+  size_t n = strlen(path);
+  return strcmp(path, "/proc/self/exe") == 0 ||
+    (n > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + n - 4, "/exe") == 0);
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*next_readlink)(const char *, char *, size_t) = NULL;
+  if (is_proc_exe(path) && program_invocation_name != NULL &&
+      program_invocation_name[0] == '/') {
+    size_t n = strlen(program_invocation_name);
+    if (n > size) n = size;
+    memcpy(buf, program_invocation_name, n);
+    return (ssize_t)n;
+  }
+  if (next_readlink == NULL)
+    next_readlink = dlsym(RTLD_NEXT, "readlink");
+  if (next_readlink == NULL) { errno = ENOSYS; return -1; }
+  return next_readlink(path, buf, size);
+}
