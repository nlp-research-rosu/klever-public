+  let goal ← goal.deltaTarget fun name =>
+    name.toString.endsWith "kleanMapLookupModel" ||
+      name.toString.endsWith "kleanMapContainsModel" ||
+      name.toString.endsWith "kleanMapDisjointModel" ||
