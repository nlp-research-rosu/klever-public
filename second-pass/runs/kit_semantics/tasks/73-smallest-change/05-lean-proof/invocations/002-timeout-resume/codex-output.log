diff --git a//tmp/klean_app_path_shim.c b//tmp/klean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..811bcfa77552e0180fd71c28794b65400f9518aa
--- /dev/null
+++ b//tmp/klean_app_path_shim.c
@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+static int is_proc_exe(const char *path) {
+  size_t n = strlen(path);
+  return strcmp(path, "/proc/self/exe") == 0 ||
+    (n > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + n - 4, "/exe") == 0);
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*next_readlink)(const char *, char *, size_t) = NULL;
+  if (is_proc_exe(path) && program_invocation_name != NULL &&
+      program_invocation_name[0] == '/') {
+    size_t n = strlen(program_invocation_name);
+    if (n > size) n = size;
+    memcpy(buf, program_invocation_name, n);
+    return (ssize_t)n;
+  }
+  if (next_readlink == NULL)
+    next_readlink = dlsym(RTLD_NEXT, "readlink");
+  if (next_readlink == NULL) { errno = ENOSYS; return -1; }
+  return next_readlink(path, buf, size);
+}
diff --git a/NameProbe.lean b/NameProbe.lean
new file mode 100644
index 0000000000000000000000000000000000000000..2b94dfa355cccfcdeab027f19e89c22093e6da31
--- /dev/null
+++ b/NameProbe.lean
@@ -0,0 +1,4 @@
+import Klean73SmallestChange.Func
+
+set_option pp.privateNames true in
+#print _root_.«Map:update»
diff --git a/OmegaTest.lean b/OmegaTest.lean
index 28c1fbb2e962ac25f84a419314708a5beb50d16d..3017c07e9cc783f77ca4d2080b02d8c5953ee292
--- a/OmegaTest.lean
+++ b/OmegaTest.lean
@@ -8,3 +8,22 @@
   change (0 : Int) ≤ i at h
   change i < (0 : Int) at hb
   omega
+example (n : Nat) :
+    Int.tdiv ((n : Int) - Int.tmod (Int.tmod (n : Int) 2 + 2) 2) 2 =
+      (n / 2 : Nat) := by
+  have hn : 0 ≤ (n : Int) := Int.ofNat_zero_le n
+  rw [Int.tmod_eq_emod_of_nonneg hn]
+  have hr : 0 ≤ (n : Int) % 2 + 2 := by
+    have := Int.emod_nonneg (n : Int) (by decide : (2 : Int) ≠ 0)
+    omega
+  rw [Int.tmod_eq_emod_of_nonneg hr]
