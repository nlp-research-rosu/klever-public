+      (fun entry accumulated =>
+        mapInsertModel entry.1 entry.2 accumulated)
+      right.coll = result.coll) :
+    _Map_ left right = result := by
+  simp [Proof._Map_, hDisjoint, hMerge]
+  cases result
+  rfl
