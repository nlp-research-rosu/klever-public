+    Int.tdiv ((n : Int) - Int.tmod (Int.tmod (n : Int) 2 + 2) 2) 2 =
+      (n / 2 : Nat) := by
+  have hn : 0 ≤ (n : Int) := Int.ofNat_zero_le n
