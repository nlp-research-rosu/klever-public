+theorem mapDisjointModel_singleton
+    (entries : List (SortKItem × SortKItem))
+    (key value : SortKItem)
+    (hAbsent : mapContainsModel entries key = false) :
+    mapDisjointModel entries [(key, value)] = true := by
+  simp [mapDisjointModel, hAbsent]
