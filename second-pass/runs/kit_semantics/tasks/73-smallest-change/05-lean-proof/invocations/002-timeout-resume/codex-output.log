diff --git a/OmegaTest.lean b/OmegaTest.lean
index 28c1fbb2e962ac25f84a419314708a5beb50d16d..3017c07e9cc783f77ca4d2080b02d8c5953ee292
--- a/OmegaTest.lean
+++ b/OmegaTest.lean
@@ -8,3 +8,22 @@
   change (0 : Int) ≤ i at h
   change i < (0 : Int) at hb
   omega
+example (n : Nat) :
+    Int.tdiv ((n : Int) - Int.tmod (Int.tmod (n : Int) 2 + 2) 2) 2 =
