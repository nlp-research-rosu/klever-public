+  have hmod : n % 2 ≤ n := Nat.mod_le n 2
+  change ((n : Int) - ((n % 2 : Nat) : Int)).tdiv 2 = (n / 2 : Nat)
+  rw [← Int.ofNat_sub hmod]
+  rw [Int.natCast_tdiv_eq_ediv]
+  change (((n - n % 2) / 2 : Nat) : Int) = ((n / 2 : Nat) : Int)
