+  · change
+      _root_.«_in_keys(_)_MAP_Bool_KItem_Map»
+        (SortKItem.inj_SortString "i") (localVars values changes index) = some true
+    simp only [_root_.«_in_keys(_)_MAP_Bool_KItem_Map», localVars,
