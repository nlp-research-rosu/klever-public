+  letI : DecidableEq SortKItem := Classical.typeDecidableEq SortKItem
+  simp only [_root_._Map_, localScopeSingleton, Proof.outerScopes]
+  change
+    (if
+      (if
+        (if SortKItem.inj_SortInt 1 = SortKItem.inj_SortInt (-1)
+          then true else false)
+        then false
+        else if
+          (if SortKItem.inj_SortInt 1 = SortKItem.inj_SortInt 0
+            then true else false)
+          then false else true)
+     then
+       some ⟨
+         if decide ((-1 : Int) < 1) then
+           Proof.outerMinusEntry ::
+             (if decide ((0 : Int) < 1) then
+               Proof.outerZeroEntry ::
+                 [(SortKItem.inj_SortInt 1,
+                   SortKItem.inj_SortScope
+                     (SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent»
+                       (Proof.localBindings values changes index)
+                       (SortParent.«parent(_)_MPY-CORE_Parent_Int» 0)))]
+              else [])
+          else []⟩
+     else none) = some (Proof.activeScopes values changes index)
+  simp [Proof.outerScopes, Proof.activeScopes]
+
