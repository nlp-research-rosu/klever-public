+}
diff --git a//tmp/klean_app_path_shim.c b//tmp/klean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..1c68367fb7c2ca1134d8979a482066e5d3c6d8e5
--- /dev/null
+++ b//tmp/klean_app_path_shim.c
@@ -0,0 +1,34 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+int uv_exepath(char *buffer, size_t *size) {
+  const char *lean =
+    "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+  size_t length = strlen(lean);
+  if (*size <= length) return -105;
+  memcpy(buffer, lean, length);
+  buffer[length] = '\0';
+  *size = length;
+  return 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  if (strcmp(path, "/proc/self/exe") == 0 ||
+      (strncmp(path, "/proc/", 6) == 0 &&
+       strlen(path) >= 10 &&
+       strcmp(path + strlen(path) - 4, "/exe") == 0)) {
+    const char *lean =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    size_t length = strlen(lean);
+    if (length > size) length = size;
+    memcpy(buffer, lean, length);
+    return (ssize_t)length;
+  }
+  readlink_fn original = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  return original(path, buffer, size);
+}
