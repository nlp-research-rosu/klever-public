+    (_Val4 := SortVal.inj_SortInt index)
+    (_Val5 := localOnlyScopes values changes index)
+    (_Val6 := localOnlyScopes values changes index) ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
+  · change
