+++ b//tmp/check_uv_exepath.c
@@ -0,0 +1,13 @@
+#include <stdio.h>
+#include <stddef.h>
+
+int uv_exepath(char *, size_t *);
+
+int main(void) {
+  char path[4096];
+  size_t size = sizeof(path);
+  int result = uv_exepath(path, &size);
+  printf("result=%d size=%zu path=%s\n", result, size,
+         result == 0 ? path : "");
+  return result != 0;
+}
diff --git a//tmp/klean_app_path_shim.c b//tmp/klean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..1c68367fb7c2ca1134d8979a482066e5d3c6d8e5
--- /dev/null
+++ b//tmp/klean_app_path_shim.c
@@ -0,0 +1,34 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+int uv_exepath(char *buffer, size_t *size) {
+  const char *lean =
+    "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+  size_t length = strlen(lean);
+  if (*size <= length) return -105;
+  memcpy(buffer, lean, length);
+  buffer[length] = '\0';
+  *size = length;
+  return 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  if (strcmp(path, "/proc/self/exe") == 0 ||
+      (strncmp(path, "/proc/", 6) == 0 &&
+       strlen(path) >= 10 &&
+       strcmp(path + strlen(path) - 4, "/exe") == 0)) {
+    const char *lean =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    size_t length = strlen(lean);
+    if (length > size) length = size;
+    memcpy(buffer, lean, length);
+    return (ssize_t)length;
+  }
+  readlink_fn original = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  return original(path, buffer, size);
+}
diff --git a/OmegaTest.lean b/OmegaTest.lean
new file mode 100644
index 0000000000000000000000000000000000000000..28c1fbb2e962ac25f84a419314708a5beb50d16d
--- /dev/null
+++ b/OmegaTest.lean
@@ -0,0 +1,10 @@
+import Lean.Elab.Tactic.Omega
+import Klean73SmallestChange.Lemmas
+
+example (i : Int) (h : 0 ≤ i) (hn : i ≠ 0) : 0 < i := by omega
+example (i n : Int) (h : i < 1 + n) : i - 1 < n := by omega
+example (i : SortInt) (h : 0 ≤ i) (hb : i < 0) : False := by
+  change Int at i
+  change (0 : Int) ≤ i at h
+  change i < (0 : Int) at hb
+  omega
