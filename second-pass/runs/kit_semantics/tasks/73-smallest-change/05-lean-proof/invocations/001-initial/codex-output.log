diff --git a//tmp/check_exepath.c b//tmp/check_exepath.c
new file mode 100644
index 0000000000000000000000000000000000000000..87c7f01b633cb82320645c0e7074ea00a0c435f0
--- /dev/null
+++ b//tmp/check_exepath.c
@@ -0,0 +1,11 @@
+#include <stdio.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  ssize_t n = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (n < 0) { perror("readlink"); return 1; }
+  path[n] = 0;
+  puts(path);
+  return 0;
+}
diff --git a//tmp/check_uv_exepath.c b//tmp/check_uv_exepath.c
