+import Proof
+
+namespace Scratch
+
+def localVars (values : SortValSeq) (changes index : SortInt) : SortMap :=
+  ⟨[
+    (SortKItem.inj_SortString "arr",
+      SortKItem.inj_SortIterable (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» values)),
+    (SortKItem.inj_SortString "changes", SortKItem.inj_SortInt changes),
+    (SortKItem.inj_SortString "i", SortKItem.inj_SortInt index)
+  ]⟩
+
+def localOnlyScopes (values : SortValSeq) (changes index : SortInt) : SortMap :=
+  ⟨[(SortKItem.inj_SortInt 1,
+    SortKItem.inj_SortScope
+      (SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent»
+        (localVars values changes index)
+        (SortParent.«parent(_)_MPY-CORE_Parent_Int» 0)))]⟩
+
+-- Deliberately tests only the generated operational lookup table.
+theorem evalNameI
+    (values : SortValSeq) (changes index : SortInt) (tail : SortK)
+    (scopeLoc : SortScopeLocCell) (heap : SortHeapCell)
+    (heapLoc : SortHeapLocCell) (stack : SortStackCell)
+    (ret : SortRetCell) (exc : SortExcCell) (exitCode : SortExitCodeCell)
+    (counter : SortGeneratedCounterCell) :
+    Rewrites
+      { k := { val := SortK.kseq
+                    ((@inj SortExpr SortKItem)
+                      (SortExpr.«Name(_)_MPY-SYNTAX_Expr_String» "i")) tail },
+        env := { val := 1 }, scopes := { val := localOnlyScopes values changes index },
+        scopeLoc := scopeLoc, heap := heap, heapLoc := heapLoc, stack := stack,
+        ret := ret, exc := exc, exitCode := exitCode, generatedCounter := counter }
+      { k := { val := SortK.kseq (SortKItem.inj_SortInt index) tail },
+        env := { val := 1 }, scopes := { val := localOnlyScopes values changes index },
+        scopeLoc := scopeLoc, heap := heap, heapLoc := heapLoc, stack := stack,
+        ret := ret, exc := exc, exitCode := exitCode, generatedCounter := counter } := by
+  apply Rewrites.tran Rewrites._6d39855
+  apply Rewrites._db779c6 <;>
+    simp [localOnlyScopes, localVars, _root_.«_|->_», _root_._Map_,
+      _root_.«_in_keys(_)_MAP_Bool_KItem_Map», _root_.«Map:lookup»,
+      _root_.«project:Val»]
+
+end Scratch

diff --git a//tmp/check_exepath.c b//tmp/check_exepath.c
new file mode 100644
index 0000000000000000000000000000000000000000..87c7f01b633cb82320645c0e7074ea00a0c435f0
--- /dev/null
+++ b//tmp/check_exepath.c
@@ -0,0 +1,11 @@
+#include <stdio.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  ssize_t n = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (n < 0) { perror("readlink"); return 1; }
+  path[n] = 0;
+  puts(path);
+  return 0;
+}
diff --git a//tmp/check_uv_exepath.c b//tmp/check_uv_exepath.c
new file mode 100644
index 0000000000000000000000000000000000000000..2c7d6c089153c19122680fc23118772794ebdc58
--- /dev/null
+++ b//tmp/check_uv_exepath.c
@@ -0,0 +1,13 @@
+#include <stdio.h>
+#include <stddef.h>
+
+int uv_exepath(char *, size_t *);
+
+int main(void) {
+  char path[4096];
+  size_t size = sizeof(path);
+  int result = uv_exepath(path, &size);
+  printf("result=%d size=%zu path=%s\n", result, size,
+         result == 0 ? path : "");
+  return result != 0;
+}
diff --git a//tmp/klean_app_path_shim.c b//tmp/klean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..1c68367fb7c2ca1134d8979a482066e5d3c6d8e5
--- /dev/null
+++ b//tmp/klean_app_path_shim.c
@@ -0,0 +1,34 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+int uv_exepath(char *buffer, size_t *size) {
+  const char *lean =
+    "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+  size_t length = strlen(lean);
+  if (*size <= length) return -105;
+  memcpy(buffer, lean, length);
+  buffer[length] = '\0';
+  *size = length;
+  return 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  if (strcmp(path, "/proc/self/exe") == 0 ||
+      (strncmp(path, "/proc/", 6) == 0 &&
+       strlen(path) >= 10 &&
+       strcmp(path + strlen(path) - 4, "/exe") == 0)) {
+    const char *lean =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    size_t length = strlen(lean);
+    if (length > size) length = size;
+    memcpy(buffer, lean, length);
+    return (ssize_t)length;
+  }
+  readlink_fn original = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  return original(path, buffer, size);
+}
