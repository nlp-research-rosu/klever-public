+                   SortKItem.inj_SortScope
+                     (SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent»
+                       (Proof.localBindings values changes index)
+                       (SortParent.«parent(_)_MPY-CORE_Parent_Int» 0)))]
+              else [])
+          else []⟩
+     else none) = some (Proof.activeScopes values changes index)
+  simp [Proof.outerScopes, Proof.activeScopes]
