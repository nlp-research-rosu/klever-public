     8	
     9	  syntax Expr ::= "Int"      "(" Int ")"
    10	                | "Float"    "(" Float ")"
    11	                | "Bool"     "(" Bool ")"
    12	                | "Name"     "(" String ")"
    13	                | "Str"      "(" String ")"
