+        print(f"{path}: parsed_json_lines={line_count}")
+
+    print(f"TOTAL_FAILURES={len(failures)}")
+    for message in failures:
+        print(f"FAILURE_SUMMARY: {message}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

