fi

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY; then
  echo "ERROR: false postcondition unexpectedly proved"
  exit 1
else
  echo "EXPECTED FAILURE: false postcondition was rejected"
fi
