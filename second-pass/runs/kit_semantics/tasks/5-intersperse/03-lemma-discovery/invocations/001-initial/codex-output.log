requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // The exact statement list translated from the body of solution.py.
  syntax Stmts ::= "INTERSPERSE-BODY" [macro]
  rule INTERSPERSE-BODY
    => If(Name("result"),
          Expr(Call(Attribute(Name("result"), "append"),
                    Name("delimeter"))) .Stmts,
          .Stmts)
       Expr(Call(Attribute(Name("result"), "append"), Name("number")))
       .Stmts

  // Mathematical fold: ACC is the output already produced and REST is the
  // unprocessed input.  Every recursive equation removes one item from REST.
  syntax ValSeq ::= intersperseAcc(ValSeq, ValSeq, Val) [function, total]

  rule intersperseAcc(ACC:ValSeq, .ValSeq, _:Val) => ACC

  rule intersperseAcc(.ValSeq, vCons(X:Val, REST:ValSeq), D:Val)
    => intersperseAcc(vCons(X, .ValSeq), REST, D)

  rule intersperseAcc(vCons(A:Val, AS:ValSeq),
                      vCons(X:Val, REST:ValSeq), D:Val)
    => intersperseAcc(
         valSeqConcat(
           valSeqConcat(vCons(A, AS), vCons(D, .ValSeq)),
           vCons(X, .ValSeq)),
         REST,
         D)
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [loop-invariant]:
    <k> #loop(list(REST:ValSeq), Name("number"), INTERSPERSE-BODY)
        => .K ... </k>
    <env> L:Int </env>
    <scopes>
      ... L |-> scope(
            "delimeter" |-> D:Int
            "number"    |-> (OLD:Val => ?LAST:Val)
            "numbers"   |-> list(ORIGINAL:ValSeq)
            "result"    |-> ref(H:Int),
            parent(0))
      ...
    </scopes>
    <heap>
      ... H |-> list(
            vCons(A:Val, AS:ValSeq)
            => intersperseAcc(vCons(A, AS), REST, D))
      ...
    </heap>
  claim [intersperse-correct]:
    <k> Call(Name("intersperse"), list(INPUT:ValSeq), D:Int)
        => ref(0) </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
       0 |-> scope(
              "intersperse" |->
                closureVal("numbers", "delimeter", .ParamNames,
                  Assign(Name("result"), ListExpr(.Exprs))
                  For(Name("number"), Name("numbers"), INTERSPERSE-BODY)
                  Return(Name("result"))
                  .Stmts,
                  0),
              parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map => 0 |-> list(intersperseAcc(.ValSeq, INPUT, D))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
python3 differential_test.py

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun concrete-tests.mpy --definition runtime-kompiled

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

if kprove spec-body-mutation.k \
