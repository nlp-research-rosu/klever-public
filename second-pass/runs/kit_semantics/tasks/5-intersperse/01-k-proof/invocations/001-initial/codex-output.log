+    <k> #loop(list(REST:ValSeq), Name("number"), INTERSPERSE-BODY)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+            "delimeter" |-> D:Int
+            "number"    |-> (OLD:Val => ?LAST:Val)
+            "numbers"   |-> list(ORIGINAL:ValSeq)
+            "result"    |-> ref(H:Int),
+            parent(0))
+      ...
+    </scopes>
+    <heap>
+      ... H |-> list(
