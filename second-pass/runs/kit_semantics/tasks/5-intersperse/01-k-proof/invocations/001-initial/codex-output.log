+from typing import List
+
+
+def intersperse(numbers: List[int], delimeter: int) -> List[int]:
+    result = []
+    for number in numbers:
+        if result:
+            result.append(delimeter)
+        result.append(number)
+    return result
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..b54ac3f01353252e8d36d2f39002b18fa1e364cf
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Mutation: the second append uses delimeter instead of number.
+  // For input [1] and delimiter 4, the mutated body returns [4], not [1].
+  claim [wrong-body-rejected]:
+    <k> Call(Name("intersperse"), list(vCons(1, .ValSeq)), 4)
+        => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "intersperse" |->
+                closureVal("numbers", "delimeter", .ParamNames,
+                  Assign(Name("result"), ListExpr(.Exprs))
+                  For(Name("number"), Name("numbers"),
+                    If(Name("result"),
+                      Expr(Call(Attribute(Name("result"), "append"),
+                                Name("delimeter"))) .Stmts,
+                      .Stmts)
+                    Expr(Call(Attribute(Name("result"), "append"),
+                              Name("delimeter")))
+                    .Stmts)
+                  Return(Name("result"))
+                  .Stmts,
+                  0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(1, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
