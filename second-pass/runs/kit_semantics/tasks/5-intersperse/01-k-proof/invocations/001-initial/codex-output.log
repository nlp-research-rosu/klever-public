diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f0328f1733206f4078deb3ad3b9144356c82935c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k> #loop(list(REST:ValSeq), Name("number"), INTERSPERSE-BODY)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+            ("delimeter" |-> D:Int
+             "number"    |-> (OLD:Val => ?LAST:Val)
+             "result"    |-> ref(H:Int)) FRAME:Map,
+            P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ... H |-> list(ACC:ValSeq => intersperseAcc(ACC, REST, D)) ...
+    </heap>
+
+  claim [intersperse-correct]:
+    <k> Call(Name("intersperse"), list(INPUT:ValSeq), D:Int)
+        => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "intersperse" |->
+                closureVal("numbers", "delimeter", .ParamNames,
+                  Assign(Name("result"), ListExpr(.Exprs))
+                  For(Name("number"), Name("numbers"), INTERSPERSE-BODY)
+                  Return(Name("result"))
+                  .Stmts,
+                  0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(intersperseAcc(.ValSeq, INPUT, D))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5a5e90406ba661afa1169bddc980630173e0e165
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact statement list translated from the body of solution.py.
+  syntax Stmts ::= "INTERSPERSE-BODY" [macro]
+  rule INTERSPERSE-BODY
+    => If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"),
+                    Name("delimeter"))) .Stmts,
+          .Stmts)
+       Expr(Call(Attribute(Name("result"), "append"), Name("number")))
+       .Stmts
+
+  // Mathematical fold: ACC is the output already produced and REST is the
+  // unprocessed input.  Every recursive equation removes one item from REST.
+  syntax ValSeq ::= intersperseAcc(ValSeq, ValSeq, Val) [function, total]
+
+  rule intersperseAcc(ACC:ValSeq, .ValSeq, _:Val) => ACC
+
+  rule intersperseAcc(.ValSeq, vCons(X:Val, REST:ValSeq), D:Val)
+    => intersperseAcc(vCons(X, .ValSeq), REST, D)
+
+  rule intersperseAcc(vCons(A:Val, AS:ValSeq),
+                      vCons(X:Val, REST:ValSeq), D:Val)
+    => intersperseAcc(
+         valSeqConcat(vCons(A, AS),
+                      vCons(D, vCons(X, .ValSeq))),
+         REST,
+         D)
+endmodule

