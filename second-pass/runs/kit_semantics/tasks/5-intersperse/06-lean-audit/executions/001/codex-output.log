exec
/bin/bash -lc "{
  echo '"'$ cc -shared -fPIC -O2 -Wall -Wextra -Werror -o /tmp/audit-work/lean_app_path_shim.so /audit-output/evidence/lean_app_path_shim.c -ldl'"'
  cc -shared -fPIC -O2 -Wall -Wextra -Werror -o /tmp/audit-work/lean_app_path_shim.so /audit-output/evidence/lean_app_path_shim.c -ldl
  echo '"'$ sha256sum shim source and binary'"'
  sha256sum /audit-output/evidence/lean_app_path_shim.c /tmp/audit-work/lean_app_path_shim.so
  echo '"'$ LD_PRELOAD shim direct lean --version'"'
  LD_PRELOAD=/tmp/audit-work/lean_app_path_shim.so /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean --version
  echo '"'$ LD_PRELOAD shim with explicit install environment lake clean/build on generated project'"'
  export PATH=/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin:/opt/elan/bin:"'$PATH
  export LEAN_SYSROOT=/opt/elan/toolchains/leanprover--lean4---v4.22.0
  export LAKE_HOME=/opt/elan/toolchains/leanprover--lean4---v4.22.0
  export LD_PRELOAD=/tmp/audit-work/lean_app_path_shim.so
  cd /reference/klean-generation/generated
  lake clean
  echo "[lake_clean_exit=$?]"
  lake build
  echo "[lake_build_exit=$?]"
} 2>&1 | tee /audit-output/evidence/33_lean_shim_validation.txt' in /audit-output
