+import json
+from pathlib import Path
+
+from tools import klean_preflight
+
+
+def logged_run(command, *, cwd, timeout):
+    print(f"$ (cd {cwd} && {' '.join(command)})", flush=True)
+    code, output = klean_preflight._run(
+        command, cwd=cwd, timeout=timeout
+    )
