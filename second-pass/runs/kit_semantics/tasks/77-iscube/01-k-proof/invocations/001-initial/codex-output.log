index 0000000000000000000000000000000000000000..26184494a60a82fc77b8530c633535d6596cfe82
--- /dev/null
+++ b/connection-rule.k
@@ -0,0 +1,48 @@
+requires "verification-base.k"
+
+module CONNECTION-RULE
+  imports VERIFICATION-BASE
+
+  // Exact executable form of the separately proved
+  // CONNECTION.search-loop reachability theorem.
+  rule
+    <k>
+      #while(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a"))))
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( SC:Map
+        1 |-> scope(
+               "a"         |-> A:Int
+               "candidate" |-> C:Int,
+               parent(0))
+      =>
+        SC
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule
