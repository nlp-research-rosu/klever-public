+++ b/verification.k
@@ -0,0 +1,55 @@
+requires "connection-rule.k"
+
+module VERIFICATION
+  imports CONNECTION-RULE
+
+  // This bridge has exactly the match domain and state transition proved by
+  // CONNECTION.search-loop using verification-base.k, which does not import
+  // this module.  In particular, it accepts only the empty continuation and
+  // the single concrete call frame used by SPEC.iscube-entry.
+  rule
+    <k>
+      While(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a"))))
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( SC:Map
+        1 |-> scope(
+               "a"         |-> A:Int
+               "candidate" |-> C:Int,
+               parent(0))
+      =>
+        ( SC
+          1 |-> scope(
+                 "a"         |-> A
+                 "candidate" |-> C,
+                 parent(0))
+        ) [ 1 <- undef ]
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule

codex
The generalized theorem now reaches the right value and frame state, but induction changes the local candidate before deletion, and K does not normalize the two equivalent symbolic map updates. I’m adding a narrow, guarded simplification lemma for deleting scope key `1`: when the remainder lacks key `1`, deleting the explicit `1 |-> Scope` entry yields exactly that remainder. This is a true map identity and does not replace Python execution.
apply patch
