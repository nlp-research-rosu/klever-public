diff --git a/verification-base.k b/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..037456824cf3dace95daaa23ad6a9b8d7ba4d368
--- /dev/null
+++ b/verification-base.k
@@ -0,0 +1,73 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  syntax Int  ::= cubeOf(Int)              [function, total]
+  syntax Bool ::= cubeSearch(Int, Int)     [function, total]
+                | isCubeInt(Int)           [function, total]
+  syntax Val  ::= "iscubeClosure"          [function, total]
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // The mathematical cube used by the specification predicate.
+  rule cubeOf(I) => (I *Int I) *Int I
+
+  // Search nonnegative candidates in increasing order.  The three guards are
+  // disjoint and exhaustive for mathematical integers.
+  rule cubeSearch(A, I) => true
+    requires cubeOf(I) ==Int A
+  rule cubeSearch(A, I) => false
+    requires cubeOf(I) >Int A
+  rule cubeSearch(A, I) => cubeSearch(A, I +Int 1)
+    requires cubeOf(I) <Int A
+
+  // At loop exit, the Python equality is exactly the search result: if the
+  // cube is not below A, it is either equal (both true) or above (both false).
+  rule ((I *Int I) *Int I ==Int A) => cubeSearch(A, I)
+    requires notBool ((I *Int I) *Int I <Int A)
+    [simplification]
+
+  // The function-frame pop in the fixed semantics deletes scope key 1.
+  // Normalize that exact symbolic Map update after proving the key is absent
+  // from the preserved remainder.
+  rule ((1 |-> S:Scope) REST:Map) [ 1 <- undef ] => REST
+    requires notBool 1 in_keys(REST)
+    [simplification]
+
+  // Cubeness is invariant under sign, so search the nonnegative magnitude.
+  rule isCubeInt(A) => cubeSearch(0 -Int A, 0)
+    requires A <Int 0
+  rule isCubeInt(A) => cubeSearch(A, 0)
+    requires A >=Int 0
+
+  // Exact closure produced when solution.mpy is loaded in module scope 0.
+  // This is a definitional abbreviation, not an execution shortcut.
+  rule iscubeClosure
+    => closureVal(
+         "a",
+         If(
+           Compare(Name("a"), CmpOp("<", Int(0))),
+           Assign(Name("a"), UnaryOp("-", Name("a"))),
+           .Stmts)
+         Assign(Name("candidate"), Int(0))
+         While(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("<", Name("a"))),
+           AugAssign(Name("candidate"), "+", Int(1)))
+         Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a")))),
+         0)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..59cced5528bac4c64177e2c65cffa5244dfd04d3
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,50 @@
+requires "connection-rule.k"
+
+module VERIFICATION
+  imports CONNECTION-RULE
+
+  // This bridge has exactly the match domain and state transition proved by
+  // CONNECTION.search-loop using verification-base.k, which does not import
+  // this module.  In particular, it accepts only the empty continuation and
+  // the single concrete call frame used by SPEC.iscube-entry.
+  rule
+    <k>
+      While(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> (Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a")))) .Stmts)
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( SC:Map
+        1 |-> scope(
+               "a"         |-> A:Int
+               "candidate" |-> C:Int,
+               parent(0))
+      =>
+        SC
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule

diff --git a/bridge-context-probe.k b/bridge-context-probe.k
new file mode 100644
index 0000000000000000000000000000000000000000..51a38137fa36ae93f04fa632c0a9fde6db09aeaa
--- /dev/null
+++ b/bridge-context-probe.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module BRIDGE-CONTEXT-PROBE
+  imports VERIFICATION
+
+  // The source bridge only accepts a singleton Return continuation.  This
+  // deliberately adds another statement; a depth-1 run must not use either
+  // operational bridge to jump to the target.
+  claim [broader-suffix-does-not-match]:
+    <k>
+      While(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> (Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a"))))
+          Assign(Name("probe"), Int(7))
+          .Stmts)
+      ~> #endcall
+      =>
+      cubeSearch(8, 0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        1 |-> scope(
+               "a"         |-> 8
+               "candidate" |-> 0,
+               parent(0))
+      =>
+        0 |-> scope(.Map, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..1dceebd00011f6e8e9c094b8b8a70e0683e48633
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,21 @@
+def iscube(a):
+    if a < 0:
+        a = -a
+
+    candidate = 0
+    while candidate * candidate * candidate < a:
+        candidate += 1
+
+    return candidate * candidate * candidate == a
+
+
+assert iscube(1) == True
+assert iscube(2) == False
+assert iscube(-1) == True
+assert iscube(64) == True
+assert iscube(0) == True
+assert iscube(180) == False
+assert iscube(-64) == True
+assert iscube(-2) == False
+assert iscube(8) == True
+assert iscube(27) == True
