+requires "connection-rule.k"
+
+module SOURCE-CONNECTION
+  imports CONNECTION-RULE
+
+  // Universal connection theorem for the source-While bridge in
+  // verification.k.  It does not import that proposed bridge.  Its only
+  // proof extension affecting execution is CONNECTION-RULE, whose identical
+  // #while behavior is proved bridge-free by CONNECTION.search-loop.
+  claim [search-loop-source]:
+    <k>
+      While(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a"))))
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> B:Scope
+         0 |-> scope(M:Map, parent(-1))
+         1 |-> scope(
+                "a"         |-> A:Int
+                "candidate" |-> C:Int,
+                parent(0))
+      =>
+        -1 |-> B
+         0 |-> scope(M, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1b417d28b9c58b745c34b65045ead5e0bc6043ba
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,25 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Call the exact solution closure through ordinary Python name lookup.
+  claim [iscube-entry]:
+    <k>
+      Call(Name("iscube"), Int(INPUT:Int))
+      =>
+      isCubeInt(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope("iscube" |-> iscubeClosure, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
