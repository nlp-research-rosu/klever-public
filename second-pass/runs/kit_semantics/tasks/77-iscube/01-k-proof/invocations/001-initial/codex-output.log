@@ -0,0 +1,48 @@
+requires "verification-base.k"
+
+module CONNECTION-RULE
+  imports VERIFICATION-BASE
+
+  // Exact executable form of the separately proved
+  // CONNECTION.search-loop reachability theorem.
+  rule
+    <k>
+      #while(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> (Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a")))) .Stmts)
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( SC:Map
+        1 |-> scope(
+               "a"         |-> A:Int
+               "candidate" |-> C:Int,
+               parent(0))
+      =>
+        SC
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ce981a532c086b5f7da692e60de81051ce95f86b
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,48 @@
+requires "verification-base.k"
+
+module CONNECTION
+  imports VERIFICATION-BASE
+
+  // Bridge-free universal connection theorem for the operational rule in
+  // verification.k.  Its LHS, guard, continuation, stack, bindings, and every
+  // state cell are identical to that rule's complete match domain.
+  claim [search-loop]:
+    <k>
+      #while(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> (Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a")))) .Stmts)
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( SC:Map
+        1 |-> scope(
+               "a"         |-> A:Int
+               "candidate" |-> C:Int,
+               parent(0))
+      =>
+        SC
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..87006de9bb84aa8a95ab62c254cabc682a439a7c
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,21 @@
+from solution import iscube
+
+
+def independent_oracle(a):
+    cubes = {n * n * n for n in range(-10, 11)}
+    return a in cubes
+
+
+inputs = list(range(-1000, 1001))
+mismatches = [
+    (a, iscube(a), independent_oracle(a))
+    for a in inputs
+    if iscube(a) != independent_oracle(a)
+]
+
+print(f"inputs: {len(inputs)}")
+print(f"range: {inputs[0]}..{inputs[-1]}")
+print(f"mismatches: {len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
