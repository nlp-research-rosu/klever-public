diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..1dceebd00011f6e8e9c094b8b8a70e0683e48633
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,21 @@
+def iscube(a):
+    if a < 0:
+        a = -a
+
+    candidate = 0
+    while candidate * candidate * candidate < a:
+        candidate += 1
+
+    return candidate * candidate * candidate == a
+
+
+assert iscube(1) == True
+assert iscube(2) == False
+assert iscube(-1) == True
+assert iscube(64) == True
+assert iscube(0) == True
+assert iscube(180) == False
+assert iscube(-64) == True
+assert iscube(-2) == False
+assert iscube(8) == True
+assert iscube(27) == True
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..33e3d20d2fed3a19c5f2dfa315f21ca41ab520da
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,51 @@
+requires "verification-base.k"
+
+module CONNECTION
+  imports VERIFICATION-BASE
+
+  // Bridge-free universal connection theorem for the operational rule in
+  // verification.k.  Its LHS, guard, continuation, stack, bindings, and every
+  // state cell are identical to that rule's complete match domain.
+  claim [search-loop]:
+    <k>
+      #while(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a"))))
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> B:Scope
+         0 |-> scope(M:Map, parent(-1))
+         1 |-> scope(
+                "a"         |-> A:Int
+                "candidate" |-> C:Int,
+                parent(0))
+      =>
+        -1 |-> B
+         0 |-> scope(M, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A >=Int 0 andBool C >=Int 0
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..515d14cd55c50f75e14364cead8cafa090e44b1a
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification-base.k \
+  --main-module VERIFICATION-BASE \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition verification-base-kompiled
+
+kprove connection-spec.k \
+  --definition verification-base-kompiled \
+  --spec-module CONNECTION
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1b6fa1cba519def2b02ebde9041c277caa61a56
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def iscube(a):
+    if a < 0:
+        a = -a
+
+    candidate = 0
+    while candidate * candidate * candidate < a:
+        candidate += 1
+
+    return candidate * candidate * candidate == a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1b417d28b9c58b745c34b65045ead5e0bc6043ba
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,25 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Call the exact solution closure through ordinary Python name lookup.
+  claim [iscube-entry]:
+    <k>
+      Call(Name("iscube"), Int(INPUT:Int))
+      =>
+      isCubeInt(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope("iscube" |-> iscubeClosure, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification-base.k b/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..d815982e5c8535ff56cbb5f09831523d92850d07
--- /dev/null
+++ b/verification-base.k
@@ -0,0 +1,66 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  syntax Int  ::= cubeOf(Int)              [function, total]
+  syntax Bool ::= cubeSearch(Int, Int)     [function, total]
+                | isCubeInt(Int)           [function, total]
+  syntax Val  ::= "iscubeClosure"          [function, total]
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // The mathematical cube used by the specification predicate.
+  rule cubeOf(I) => (I *Int I) *Int I
+
+  // Search nonnegative candidates in increasing order.  The three guards are
+  // disjoint and exhaustive for mathematical integers.
+  rule cubeSearch(A, I) => true
+    requires cubeOf(I) ==Int A
+  rule cubeSearch(A, I) => false
+    requires cubeOf(I) >Int A
+  rule cubeSearch(A, I) => cubeSearch(A, I +Int 1)
+    requires cubeOf(I) <Int A
+
+  // At loop exit, the Python equality is exactly the search result: if the
+  // cube is not below A, it is either equal (both true) or above (both false).
+  rule ((I *Int I) *Int I ==Int A) => cubeSearch(A, I)
+    requires notBool ((I *Int I) *Int I <Int A)
+    [simplification]
+
+  // Cubeness is invariant under sign, so search the nonnegative magnitude.
+  rule isCubeInt(A) => cubeSearch(0 -Int A, 0)
+    requires A <Int 0
+  rule isCubeInt(A) => cubeSearch(A, 0)
+    requires A >=Int 0
+
+  // Exact closure produced when solution.mpy is loaded in module scope 0.
+  // This is a definitional abbreviation, not an execution shortcut.
+  rule iscubeClosure
+    => closureVal(
+         "a",
+         If(
+           Compare(Name("a"), CmpOp("<", Int(0))),
+           Assign(Name("a"), UnaryOp("-", Name("a"))),
+           .Stmts)
+         Assign(Name("candidate"), Int(0))
+         While(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("<", Name("a"))),
+           AugAssign(Name("candidate"), "+", Int(1)))
+         Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a")))),
+         0)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..aae2e17f3f16f57571989770c337bde896efeb7a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+requires "verification-base.k"
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // This bridge has exactly the match domain and state transition proved by
+  // CONNECTION.search-loop using verification-base.k, which does not import
+  // this module.  In particular, it accepts only the empty continuation and
+  // the single concrete call frame used by SPEC.iscube-entry.
+  rule
+    <k>
+      #while(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a"))))
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> B:Scope
+         0 |-> scope(M:Map, parent(-1))
+         1 |-> scope(
+                "a"         |-> A:Int
+                "candidate" |-> C:Int,
+                parent(0))
+      =>
+        -1 |-> B
+         0 |-> scope(M, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A >=Int 0 andBool C >=Int 0
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'kprove connection-spec.k --definition verification-kompiled --spec-module CONNECTION --depth 1' in /workspace
