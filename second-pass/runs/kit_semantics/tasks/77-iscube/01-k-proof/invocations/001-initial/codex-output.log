new file mode 100644
index 0000000000000000000000000000000000000000..1dceebd00011f6e8e9c094b8b8a70e0683e48633
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,21 @@
+def iscube(a):
+    if a < 0:
+        a = -a
+
+    candidate = 0
+    while candidate * candidate * candidate < a:
+        candidate += 1
+
+    return candidate * candidate * candidate == a
+
+
+assert iscube(1) == True
+assert iscube(2) == False
+assert iscube(-1) == True
+assert iscube(64) == True
+assert iscube(0) == True
+assert iscube(180) == False
+assert iscube(-64) == True
+assert iscube(-2) == False
+assert iscube(8) == True
+assert iscube(27) == True
diff --git a/connection-rule.k b/connection-rule.k
new file mode 100644
index 0000000000000000000000000000000000000000..c82b10f6650ca62df91b377699851df49ed6d59b
--- /dev/null
+++ b/connection-rule.k
@@ -0,0 +1,48 @@
+requires "verification-base.k"
+
+module CONNECTION-RULE
+  imports VERIFICATION-BASE
+
+  // Exact executable form of the separately proved
+  // CONNECTION.search-loop reachability theorem.
+  rule
+    <k>
+      #while(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> (Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a")))) .Stmts)
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( SC:Map
+        1 |-> scope(
+               "a"         |-> A:Int
+               "candidate" |-> C:Int,
+               parent(0))
+      =>
+        SC
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule
