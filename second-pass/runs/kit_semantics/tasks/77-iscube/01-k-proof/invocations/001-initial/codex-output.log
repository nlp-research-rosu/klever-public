new file mode 100644
index 0000000000000000000000000000000000000000..b56124070813ba4474d1fb7963bacfabd30b798d
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,50 @@
+requires "verification-base.k"
+
+module CONNECTION
+  imports VERIFICATION-BASE
+
+  // Bridge-free universal connection theorem for the operational rule in
+  // verification.k.  Its LHS, guard, continuation, stack, bindings, and every
+  // state cell are identical to that rule's complete match domain.
+  claim [search-loop]:
+    <k>
+      #while(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a"))))
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> B:Scope
+         0 |-> scope(M:Map, parent(-1))
+         1 |-> scope(
+                "a"         |-> A:Int
+                "candidate" |-> C:Int,
+                parent(0))
+      =>
+        -1 |-> B
+         0 |-> scope(M, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
