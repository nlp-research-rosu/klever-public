+              AugAssign(Name("candidate"), "+", Int(2)))
+            Return(
+              Compare(
+                BinOp(
+                  "*",
+                  BinOp("*", Name("candidate"), Name("candidate")),
+                  Name("candidate")),
+                CmpOp("==", Name("a")))))))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+         0 |-> scope(.Map, parent(-1))
+      =>
+        -1 |-> builtinsScope
+         0 |-> scope("iscube" |-> iscubeClosure, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
