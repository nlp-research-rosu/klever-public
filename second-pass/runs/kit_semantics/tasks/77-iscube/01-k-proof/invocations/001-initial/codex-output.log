+      #while(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> (Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a")))) .Stmts)
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( SC:Map
+        1 |-> scope(
+               "a"         |-> A:Int
+               "candidate" |-> C:Int,
+               parent(0))
+      =>
