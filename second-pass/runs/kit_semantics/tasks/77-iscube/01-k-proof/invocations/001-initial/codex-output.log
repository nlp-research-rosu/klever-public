+          Assign(Name("probe"), Int(7))
+          .Stmts)
+      ~> #endcall
+      =>
+      cubeSearch(8, 0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        1 |-> scope(
+               "a"         |-> 8
+               "candidate" |-> 0,
+               parent(0))
+      =>
+        0 |-> scope(.Map, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
