--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification-base.k \
+  --main-module VERIFICATION-BASE \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition verification-base-kompiled
+
+kprove connection-spec.k \
+  --definition verification-base-kompiled \
+  --spec-module CONNECTION
+
+kompile --backend haskell connection-rule.k \
+  --main-module CONNECTION-RULE \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition connection-rule-kompiled
+
+kprove source-connection-spec.k \
+  --definition connection-rule-kompiled \
+  --spec-module SOURCE-CONNECTION
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1b6fa1cba519def2b02ebde9041c277caa61a56
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def iscube(a):
+    if a < 0:
+        a = -a
+
+    candidate = 0
+    while candidate * candidate * candidate < a:
+        candidate += 1
+
+    return candidate * candidate * candidate == a
diff --git a/source-connection-spec.k b/source-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e2ca0476ceb049221ed18c4147f625911243f424
--- /dev/null
+++ b/source-connection-spec.k
@@ -0,0 +1,49 @@
+requires "connection-rule.k"
+
+module SOURCE-CONNECTION
+  imports CONNECTION-RULE
+
+  // Universal connection theorem for the source-While bridge in
+  // verification.k.  It does not import that proposed bridge.  Its only
+  // proof extension affecting execution is CONNECTION-RULE, whose identical
+  // #while behavior is proved bridge-free by CONNECTION.search-loop.
+  claim [search-loop-source]:
+    <k>
+      While(
+        Compare(
+          BinOp(
+            "*",
+            BinOp("*", Name("candidate"), Name("candidate")),
+            Name("candidate")),
+          CmpOp("<", Name("a"))),
+        AugAssign(Name("candidate"), "+", Int(1)))
+      ~> (Return(
+           Compare(
+             BinOp(
+               "*",
+               BinOp("*", Name("candidate"), Name("candidate")),
+               Name("candidate")),
+             CmpOp("==", Name("a")))) .Stmts)
+      ~> #endcall
+      =>
+      cubeSearch(A, C)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( SC:Map
+        1 |-> scope(
+               "a"         |-> A:Int
+               "candidate" |-> C:Int,
+               parent(0))
+      =>
+        SC
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
