+                  Name("candidate")),
+                CmpOp("<", Name("a"))),
+              AugAssign(Name("candidate"), "+", Int(2)))
+            Return(
+              Compare(
+                BinOp(
+                  "*",
+                  BinOp("*", Name("candidate"), Name("candidate")),
+                  Name("candidate")),
+                CmpOp("==", Name("a")))))))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
