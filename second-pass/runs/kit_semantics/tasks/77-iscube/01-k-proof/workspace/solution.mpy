Module(
  FuncDef("iscube", Params("a"),
    If(Compare(Name("a"), CmpOp("<", Int(0))),
      Assign(Name("a"), UnaryOp("-", Name("a"))),
      )
    Assign(Name("candidate"), Int(0))
    While(Compare(
      BinOp(
        "*",
        BinOp("*", Name("candidate"), Name("candidate")),
        Name("candidate")),
      CmpOp("<", Name("a"))),
      AugAssign(Name("candidate"), "+", Int(1)))
    Return(
      Compare(
        BinOp(
          "*",
          BinOp("*", Name("candidate"), Name("candidate")),
          Name("candidate")),
        CmpOp("==", Name("a"))))))
