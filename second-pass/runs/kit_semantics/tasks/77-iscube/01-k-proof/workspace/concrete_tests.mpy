Module(
  FuncDef("iscube", Params("a"),
    If(Compare(Name("a"), CmpOp("<", Int(0))),
      Assign(Name("a"), UnaryOp("-", Name("a"))),
      )
    Assign(Name("candidate"), Int(0))
    While(Compare(
      BinOp(
        "*",
        BinOp("*", Name("candidate"), Name("candidate")),
        Name("candidate")),
      CmpOp("<", Name("a"))),
      AugAssign(Name("candidate"), "+", Int(1)))
    Return(
      Compare(
        BinOp(
          "*",
          BinOp("*", Name("candidate"), Name("candidate")),
          Name("candidate")),
        CmpOp("==", Name("a")))))
  Assert(Compare(Call(Name("iscube"), Int(1)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(2)), CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("iscube"), UnaryOp("-", Int(1))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(64)), CmpOp("==", Bool(true))))
  Assert(Compare(Call(Name("iscube"), Int(0)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(180)), CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("iscube"), UnaryOp("-", Int(64))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("iscube"), UnaryOp("-", Int(2))),
      CmpOp("==", Bool(false))))
  Assert(Compare(Call(Name("iscube"), Int(8)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(27)), CmpOp("==", Bool(true)))))
