requires "verification-base.k"

module IDENTITY
  imports VERIFICATION-BASE

  // Loading the translated source creates exactly the closure used by SPEC.
  claim [solution-loads-exact-closure]:
    <k>
      #loadAll(
        Module(
          FuncDef(
            "iscube",
            Params("a"),
            If(
              Compare(Name("a"), CmpOp("<", Int(0))),
              Assign(Name("a"), UnaryOp("-", Name("a"))),
              .Stmts)
            Assign(Name("candidate"), Int(0))
            While(
              Compare(
                BinOp(
                  "*",
                  BinOp("*", Name("candidate"), Name("candidate")),
                  Name("candidate")),
                CmpOp("<", Name("a"))),
              AugAssign(Name("candidate"), "+", Int(1)))
            Return(
              Compare(
                BinOp(
                  "*",
                  BinOp("*", Name("candidate"), Name("candidate")),
                  Name("candidate")),
                CmpOp("==", Name("a")))))))
      =>
      .K
    </k>
    <env> 0 </env>
    <scopes>
      ( -1 |-> builtinsScope
         0 |-> scope(.Map, parent(-1))
      =>
        -1 |-> builtinsScope
         0 |-> scope("iscube" |-> iscubeClosure, parent(-1))
      )
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
requires "verification-base.k"

module CONNECTION
  imports VERIFICATION-BASE

  // Bridge-free universal connection theorem for the operational rule in
  // verification.k.  Its LHS, guard, continuation, stack, bindings, and every
  // state cell are identical to that rule's complete match domain.
  claim [search-loop]:
    <k>
      #while(
        Compare(
          BinOp(
            "*",
            BinOp("*", Name("candidate"), Name("candidate")),
            Name("candidate")),
          CmpOp("<", Name("a"))),
        AugAssign(Name("candidate"), "+", Int(1)))
      ~> (Return(
           Compare(
             BinOp(
               "*",
               BinOp("*", Name("candidate"), Name("candidate")),
               Name("candidate")),
             CmpOp("==", Name("a")))) .Stmts)
      ~> #endcall
      =>
      cubeSearch(A, C)
    </k>
    <env> 1 => 0 </env>
    <scopes>
      ( SC:Map
        1 |-> scope(
               "a"         |-> A:Int
               "candidate" |-> C:Int,
               parent(0))
      =>
        SC
      )
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
requires "connection-rule.k"

module SOURCE-CONNECTION
  imports CONNECTION-RULE

  // Universal connection theorem for the source-While bridge in
  // verification.k.  It does not import that proposed bridge.  Its only
  // proof extension affecting execution is CONNECTION-RULE, whose identical
  // #while behavior is proved bridge-free by CONNECTION.search-loop.
  claim [search-loop-source]:
    <k>
      While(
        Compare(
          BinOp(
            "*",
            BinOp("*", Name("candidate"), Name("candidate")),
            Name("candidate")),
          CmpOp("<", Name("a"))),
        AugAssign(Name("candidate"), "+", Int(1)))
      ~> (Return(
           Compare(
             BinOp(
               "*",
               BinOp("*", Name("candidate"), Name("candidate")),
               Name("candidate")),
             CmpOp("==", Name("a")))) .Stmts)
      ~> #endcall
      =>
      cubeSearch(A, C)
    </k>
    <env> 1 => 0 </env>
    <scopes>
      ( SC:Map
        1 |-> scope(
               "a"         |-> A:Int
               "candidate" |-> C:Int,
               parent(0))
      =>
        SC
      )
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
