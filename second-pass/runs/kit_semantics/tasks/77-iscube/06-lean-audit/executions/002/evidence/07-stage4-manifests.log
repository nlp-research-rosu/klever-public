      "normalized_sha256": "7053976245560ebde1f9c329f37f168cf403550b3226be6fd87bc25c9c187bda",
      "rationale": "The installed bridge has the identical reachability statement previously proved as CONNECTION.search-loop against verification-base-kompiled, before connection-rule.k is compiled; the variable set, guards, continuation, and complete cell transition are unchanged.",
      "source_rule_id": "rule-7053976245560ebde1f9c329f37f168cf403550b3226be6fd87bc25c9c187bda",
      "start_line": 8,
      "text": "  rule\n    <k>\n      #while(\n        Compare(\n          BinOp(\n            \"*\",\n            BinOp(\"*\", Name(\"candidate\"), Name(\"candidate\")),\n            Name(\"candidate\")),\n          CmpOp(\"<\", Name(\"a\"))),\n        AugAssign(Name(\"candidate\"), \"+\", Int(1)))\n      ~> (Return(\n           Compare(\n             BinOp(\n               \"*\",\n               BinOp(\"*\", Name(\"candidate\"), Name(\"candidate\")),\n               Name(\"candidate\")),\n             CmpOp(\"==\", Name(\"a\")))) .Stmts)\n      ~> #endcall\n      =>\n      cubeSearch(A, C)\n    </k>\n    <env> 1 => 0 </env>\n    <scopes>\n      ( SC:Map\n        1 |-> scope(\n               \"a\"         |-> A:Int\n               \"candidate\" |-> C:Int,\n               parent(0))\n      =>\n        SC\n      )\n    </scopes>\n    <scopeLoc> 2 => 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    [priority(40)]"
    }
