{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "file": "verification-base.k",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "a125d094d70188da5ff77c740e52261fd69a2a3784be6928238fb15df19a7a19",
      "rationale": "This equation defines the fresh verification symbol cubeOf introduced by VERIFICATION-SYNTAX as integer cubing.",
      "source_rule_id": "rule-a125d094d70188da5ff77c740e52261fd69a2a3784be6928238fb15df19a7a19",
      "start_line": 17,
      "text": "  rule cubeOf(I) => (I *Int I) *Int I"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "file": "verification-base.k",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "19e8781342762c8c476b4eea71d343b12d1e66bc89b2d271905518e733ed4682",
      "rationale": "This is the equality-guarded base equation defining the fresh verification summary cubeSearch.",
      "source_rule_id": "rule-19e8781342762c8c476b4eea71d343b12d1e66bc89b2d271905518e733ed4682",
      "start_line": 21,
      "text": "  rule cubeSearch(A, I) => true\n    requires cubeOf(I) ==Int A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "file": "verification-base.k",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "fb3d10bf0eb9e4f62aad18017f1ab7c5f7a7a5f5c590593e8b83ec2d9834028b",
      "rationale": "This is the greater-than-guarded base equation defining the fresh verification summary cubeSearch.",
      "source_rule_id": "rule-fb3d10bf0eb9e4f62aad18017f1ab7c5f7a7a5f5c590593e8b83ec2d9834028b",
      "start_line": 23,
      "text": "  rule cubeSearch(A, I) => false\n    requires cubeOf(I) >Int A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "file": "verification-base.k",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "bf30e24b24687c20941ecb863886dc67a9049d65bf68ca325559188ec68de3ae",
      "rationale": "This is the less-than-guarded recurrence defining the fresh verification summary cubeSearch at the next candidate.",
      "source_rule_id": "rule-bf30e24b24687c20941ecb863886dc67a9049d65bf68ca325559188ec68de3ae",
      "start_line": 25,
      "text": "  rule cubeSearch(A, I) => cubeSearch(A, I +Int 1)\n    requires cubeOf(I) <Int A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "file": "verification-base.k",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "79867a7dea47e4e5f98e59d1cdcebad2e7a31d021c387d2ab8c5714ceac988b0",
      "rationale": "This is the negative-input guarded equation defining the fresh verification summary isCubeInt by sign normalization and cubeSearch.",
      "source_rule_id": "rule-79867a7dea47e4e5f98e59d1cdcebad2e7a31d021c387d2ab8c5714ceac988b0",
      "start_line": 42,
      "text": "  rule isCubeInt(A) => cubeSearch(0 -Int A, 0)\n    requires A <Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 45,
      "file": "verification-base.k",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "9371ae3bb178a5f2d69f2338883aa1878c94170ae90c5b52f939214871d333d5",
      "rationale": "This is the nonnegative-input guarded equation defining the fresh verification summary isCubeInt by cubeSearch.",
      "source_rule_id": "rule-9371ae3bb178a5f2d69f2338883aa1878c94170ae90c5b52f939214871d333d5",
      "start_line": 44,
      "text": "  rule isCubeInt(A) => cubeSearch(A, 0)\n    requires A >=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 72,
      "file": "verification-base.k",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "e0a6a1010506cb6e1e4dcfbfaacc8a9fcb910826e3cf03e90b3a2d2fd022089d",
      "rationale": "This equation defines the fresh nullary verification symbol iscubeClosure as the named closure proof term.",
      "source_rule_id": "rule-e0a6a1010506cb6e1e4dcfbfaacc8a9fcb910826e3cf03e90b3a2d2fd022089d",
      "start_line": 49,
      "text": "  rule iscubeClosure\n    => closureVal(\n         \"a\",\n         If(\n           Compare(Name(\"a\"), CmpOp(\"<\", Int(0))),\n           Assign(Name(\"a\"), UnaryOp(\"-\", Name(\"a\"))),\n           .Stmts)\n         Assign(Name(\"candidate\"), Int(0))\n         While(\n           Compare(\n             BinOp(\n               \"*\",\n               BinOp(\"*\", Name(\"candidate\"), Name(\"candidate\")),\n               Name(\"candidate\")),\n             CmpOp(\"<\", Name(\"a\"))),\n           AugAssign(Name(\"candidate\"), \"+\", Int(1)))\n         Return(\n           Compare(\n             BinOp(\n               \"*\",\n               BinOp(\"*\", Name(\"candidate\"), Name(\"candidate\")),\n               Name(\"candidate\")),\n             CmpOp(\"==\", Name(\"a\")))),\n         0)"
    }
  ],
