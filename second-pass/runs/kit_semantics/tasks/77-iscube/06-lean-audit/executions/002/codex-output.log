+import Proof
+
+open Proof
+
+-- Candidate cube-summary checks across exact, overshoot, negative, and distant-start cases.
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 8 0
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 9 0
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» (-8) (-100)
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» (-9) (-100)
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 8 3
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 0 (-100)
+
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 8 0 = true := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 9 0 = false := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» (-8) (-100) = true := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» (-9) (-100) = false := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 8 3 = false := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 0 (-100) = true := by native_decide
+
+-- Total arithmetic/Boolean hook witnesses.
+example : Proof.«_*Int_» (-3) 4 = -12 := rfl
+example : Proof.«_<Int_» (-3) 4 = true := by native_decide
+example : Proof.«_==Int_» (-3) (-3) = true := by native_decide
+example : Proof.notBool_ true = false := rfl
+
+-- Map constructors are observably sensitive to both inputs.
+private def key1 : SortKItem := SortKItem.inj_SortInt 1
+private def key2 : SortKItem := SortKItem.inj_SortInt 2
+private def value3 : SortKItem := SortKItem.inj_SortInt 3
+private def mapLeft : SortMap := Proof.«_|->_» key1 value3
+private def mapRight : SortMap := Proof.«_|->_» key2 value3
+
+#eval (Proof._Map_ mapLeft mapRight).coll.length
+example : (Proof._Map_ mapLeft mapRight).coll = mapLeft.coll ++ mapRight.coll := rfl
+example : (Proof._Map_ mapLeft mapRight).coll.length = 2 := rfl
