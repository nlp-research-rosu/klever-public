diff --git a//tmp/audit-work/lean-proof-audit-77-001/AuditBridgeExamples.lean b//tmp/audit-work/lean-proof-audit-77-001/AuditBridgeExamples.lean
new file mode 100644
index 0000000000000000000000000000000000000000..95059e3557e6c0a17ce4eea9b1a713c56db5cb1c
--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit-77-001/AuditBridgeExamples.lean
@@ -0,0 +1,35 @@
+import Proof
+
+open Proof
+
+-- Candidate cube-summary checks across exact, overshoot, negative, and distant-start cases.
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 8 0
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 9 0
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» (-8) (-100)
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» (-9) (-100)
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 8 3
+#eval Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 0 (-100)
+
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 8 0 = true := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 9 0 = false := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» (-8) (-100) = true := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» (-9) (-100) = false := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 8 3 = false := by native_decide
+example : Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» 0 (-100) = true := by native_decide
+
+-- Total arithmetic/Boolean hook witnesses.
+example : Proof.«_*Int_» (-3) 4 = -12 := rfl
+example : Proof.«_<Int_» (-3) 4 = true := by native_decide
+example : Proof.«_==Int_» (-3) (-3) = true := by native_decide
+example : Proof.notBool_ true = false := rfl
+
+-- Map constructors are observably sensitive to both inputs.
+private def key1 : SortKItem := SortKItem.inj_SortInt 1
+private def key2 : SortKItem := SortKItem.inj_SortInt 2
+private def value3 : SortKItem := SortKItem.inj_SortInt 3
+private def mapLeft : SortMap := Proof.«_|->_» key1 value3
+private def mapRight : SortMap := Proof.«_|->_» key2 value3
+
+#eval (Proof._Map_ mapLeft mapRight).coll.length
+example : (Proof._Map_ mapLeft mapRight).coll = mapLeft.coll ++ mapRight.coll := rfl
+example : (Proof._Map_ mapLeft mapRight).coll.length = 2 := rfl
diff --git a//tmp/audit-work/lean-proof-audit-77-001/AuditBridgeUniversal.lean b//tmp/audit-work/lean-proof-audit-77-001/AuditBridgeUniversal.lean
new file mode 100644
index 0000000000000000000000000000000000000000..36413a7a994e829d5da62df57446cb730ef18658
--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit-77-001/AuditBridgeUniversal.lean
@@ -0,0 +1,10 @@
+import Proof
+
+example (left right : SortMap) :
+    (Proof._Map_ left right).coll = left.coll ++ right.coll := rfl
+
+example (key value : SortKItem) :
+    (Proof.«_|->_» key value).coll = [(key, value)] := rfl
+
+example (key : SortKItem) :
+    Proof.«_in_keys(_)_MAP_Bool_KItem_Map» key ⟨[]⟩ = false := rfl
diff --git a//tmp/audit-work/lean-proof-audit-77-001/AuditCubeDifferential.lean b//tmp/audit-work/lean-proof-audit-77-001/AuditCubeDifferential.lean
new file mode 100644
index 0000000000000000000000000000000000000000..fa40aab350e857473f504830963164f81d80f29b
--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit-77-001/AuditCubeDifferential.lean
@@ -0,0 +1,42 @@
+import Proof
+
+def auditIntRange (lo : Int) (count : Nat) : List Int :=
+  (List.range count).map fun offset => lo + Int.ofNat offset
+
+def auditCube (value : Int) : Int :=
+  (value * value) * value
+
+-- Independent finite existential oracle.  For |a| ≤ 100 every integral cube
+-- root lies in [-5, 5], well inside this deliberately wider search interval.
+def auditCubeOracle (a start : Int) : Bool :=
+  (auditIntRange (-60) 121).any fun candidate =>
+    decide (start ≤ candidate ∧ auditCube candidate = a)
+
+def auditPoints : List (Int × Int) :=
+  (auditIntRange (-100) 201).flatMap fun a =>
+    (auditIntRange (-20) 41).map fun start => (a, start)
+
+def auditSemanticMismatches : List (Int × Int) :=
+  auditPoints.filter fun point =>
+    let actual :=
+      Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» point.1 point.2
+    actual != auditCubeOracle point.1 point.2
+
+def auditRecurrenceMismatches : List (Int × Int) :=
+  auditPoints.filter fun point =>
+    let a := point.1
+    let candidate := point.2
+    let cube := auditCube candidate
+    let current :=
+      Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» a candidate
+    if cube = a then current != true
+    else if cube > a then current != false
+    else
+      current !=
+        Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» a (candidate + 1)
+
