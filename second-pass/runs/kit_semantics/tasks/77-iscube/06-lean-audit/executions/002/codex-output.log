+#include <limits.h>
+#include <stdio.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[PATH_MAX];
+  ssize_t count = readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+  if (count < 0) {
+    perror("readlink");
+    return 1;
+  }
+  buffer[count] = '\0';
+  puts(buffer);
+  return 0;
+}
