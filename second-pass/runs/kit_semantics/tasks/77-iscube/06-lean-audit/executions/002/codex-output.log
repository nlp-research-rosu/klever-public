@@ -0,0 +1,10 @@
+import Proof
+
+example (left right : SortMap) :
+    (Proof._Map_ left right).coll = left.coll ++ right.coll := rfl
+
+example (key value : SortKItem) :
+    (Proof.«_|->_» key value).coll = [(key, value)] := rfl
+
+example (key : SortKItem) :
+    Proof.«_in_keys(_)_MAP_Bool_KItem_Map» key ⟨[]⟩ = false := rfl
diff --git a//tmp/audit-work/lean-proof-audit-77-001/AuditCubeDifferential.lean b//tmp/audit-work/lean-proof-audit-77-001/AuditCubeDifferential.lean
new file mode 100644
index 0000000000000000000000000000000000000000..fa40aab350e857473f504830963164f81d80f29b
--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit-77-001/AuditCubeDifferential.lean
@@ -0,0 +1,42 @@
+import Proof
+
+def auditIntRange (lo : Int) (count : Nat) : List Int :=
+  (List.range count).map fun offset => lo + Int.ofNat offset
+
+def auditCube (value : Int) : Int :=
+  (value * value) * value
+
+-- Independent finite existential oracle.  For |a| ≤ 100 every integral cube
+-- root lies in [-5, 5], well inside this deliberately wider search interval.
+def auditCubeOracle (a start : Int) : Bool :=
+  (auditIntRange (-60) 121).any fun candidate =>
+    decide (start ≤ candidate ∧ auditCube candidate = a)
+
+def auditPoints : List (Int × Int) :=
+  (auditIntRange (-100) 201).flatMap fun a =>
+    (auditIntRange (-20) 41).map fun start => (a, start)
+
+def auditSemanticMismatches : List (Int × Int) :=
+  auditPoints.filter fun point =>
+    let actual :=
+      Proof.«cubeSearch(_,_)_VERIFICATION-SYNTAX_Bool_Int_Int» point.1 point.2
+    actual != auditCubeOracle point.1 point.2
+
+def auditRecurrenceMismatches : List (Int × Int) :=
+  auditPoints.filter fun point =>
+    let a := point.1
+    let candidate := point.2
+    let cube := auditCube candidate
+    let current :=
