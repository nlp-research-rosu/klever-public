+
+extern int uv_exepath(char *buffer, size_t *size);
+extern const char *uv_strerror(int err);
+
+int main(void) {
+  char buffer[4096];
+  size_t size = sizeof(buffer);
+  int code = uv_exepath(buffer, &size);
+  printf("code=%d size=%zu error=%s\n", code, size, uv_strerror(code));
+  if (code == 0) {
+    buffer[size] = '\0';
+    puts(buffer);
+  }
+  return code != 0;
+}
