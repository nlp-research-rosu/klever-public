diff --git a//tmp/audit-work/procself_readlink_shim.c b//tmp/audit-work/procself_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..2c1037de4e6218442cedd12ed87c8dbbe0770a81
--- /dev/null
+++ b//tmp/audit-work/procself_readlink_shim.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  char blocked[64];
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  snprintf(blocked, sizeof(blocked), "/proc/%ld/exe", (long)getpid());
+  if (strcmp(path, blocked) == 0) {
+    path = "/proc/self/exe";
+  }
+  return real_readlink(path, buffer, size);
+}
