@@ -0,0 +1,15 @@
+#include <limits.h>
+#include <stdio.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[PATH_MAX];
+  ssize_t count = readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+  if (count < 0) {
+    perror("readlink");
+    return 1;
+  }
+  buffer[count] = '\0';
+  puts(buffer);
+  return 0;
+}
diff --git a//tmp/audit-work/check_uv_exepath.c b//tmp/audit-work/check_uv_exepath.c
new file mode 100644
index 0000000000000000000000000000000000000000..30a6bacf50c3f3e45635410598a8c4a0ba5d18b5
--- /dev/null
+++ b//tmp/audit-work/check_uv_exepath.c
@@ -0,0 +1,17 @@
+#include <stddef.h>
+#include <stdio.h>
+
+extern int uv_exepath(char *buffer, size_t *size);
+extern const char *uv_strerror(int err);
+
+int main(void) {
+  char buffer[4096];
+  size_t size = sizeof(buffer);
+  int code = uv_exepath(buffer, &size);
+  printf("code=%d size=%zu error=%s\n", code, size, uv_strerror(code));
+  if (code == 0) {
+    buffer[size] = '\0';
+    puts(buffer);
+  }
+  return code != 0;
+}
