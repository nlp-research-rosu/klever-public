new file mode 100644
index 0000000000000000000000000000000000000000..8be9022151663ace67cc943f4b34cb4139509a5b
--- /dev/null
+++ b//tmp/audit-work/app_path_trace.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    int saved_errno = errno;
+    fprintf(stderr, "TRACE readlink path=%s result=%zd errno=%d", path, result,
+            saved_errno);
+    if (result >= 0) {
+        fprintf(stderr, " target=%.*s", (int)result, buffer);
+    }
+    fputc('\n', stderr);
+    errno = saved_errno;
+    return result;
+}
