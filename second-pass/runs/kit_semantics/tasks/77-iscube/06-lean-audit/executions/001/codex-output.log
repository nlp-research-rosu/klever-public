diff --git a//tmp/audit-work/app_path_trace.c b//tmp/audit-work/app_path_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..8be9022151663ace67cc943f4b34cb4139509a5b
--- /dev/null
+++ b//tmp/audit-work/app_path_trace.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    int saved_errno = errno;
+    fprintf(stderr, "TRACE readlink path=%s result=%zd errno=%d", path, result,
+            saved_errno);
+    if (result >= 0) {
+        fprintf(stderr, " target=%.*s", (int)result, buffer);
+    }
+    fputc('\n', stderr);
+    errno = saved_errno;
+    return result;
+}
diff --git a//tmp/audit-work/proc_self_exe_shim.c b//tmp/audit-work/proc_self_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..e894a286ef1411b89160557a8f86eb6ad6a8148b
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_shim.c
@@ -0,0 +1,36 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    const char *cursor = path;
+    if (strncmp(cursor, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor += 6;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    return real_readlink(
+        is_proc_pid_exe(path) ? "/proc/self/exe" : path,
+        buffer,
+        size
+    );
+}
