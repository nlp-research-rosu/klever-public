  imports STRING-SYNTAX
END_ITEM
ITEM 0990 /reference/reference-semantics/semantics/syntax.k:9 kind=syntax attrs=['strict', 'seqstrict', 'macro']
  syntax Expr ::= "Int"      "(" Int ")"
                | "Float"    "(" Float ")"
                | "Bool"     "(" Bool ")"
                | "Name"     "(" String ")"
                | "Str"      "(" String ")"
                | "UnaryOp"  "(" String "," Expr ")" [strict(2)]
                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
                | "BoolOp"    "(" String "," Exprs ")"
                | "ListExpr"  "(" Exprs ")"
                | "DictExpr"  "(" Entries ")"
                | "ListComp"  "(" Expr "," CompFors ")" [macro]
                | "GenExp"    "(" Expr "," CompFors ")" [macro]
                | "TupleExpr" "(" Exprs ")"
                | "Subscript" "(" Expr "," Index ")"
                | "IfExp"     "(" Expr "," Expr "," Expr ")" [strict(1)]
                | "Lambda"    "(" Params "," Expr ")"
                | "KwArg"     "(" String "," Expr ")"
                | "Lambda"    "(" Params "," CellVars "," FreeVars "," Expr ")"
                | "NoneVal"
                | "Call"      "(" Expr "," Exprs ")"
                | "Attribute" "(" Expr "," String ")" [strict(1)]
                | "Compare"   "(" Expr "," CmpOp ")"
END_ITEM
ITEM 0991 /reference/reference-semantics/semantics/syntax.k:32 kind=syntax attrs=[]
  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"
END_ITEM
ITEM 0992 /reference/reference-semantics/semantics/syntax.k:33 kind=syntax attrs=[]
  syntax Entry    ::= "Entry" "(" Expr "," Expr ")"
END_ITEM
ITEM 0993 /reference/reference-semantics/semantics/syntax.k:34 kind=syntax attrs=[]
  syntax Entries  ::= List{Entry, ","}
END_ITEM
ITEM 0994 /reference/reference-semantics/semantics/syntax.k:35 kind=syntax attrs=[]
  syntax CompFor  ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
END_ITEM
ITEM 0995 /reference/reference-semantics/semantics/syntax.k:36 kind=syntax attrs=[]
  syntax CompFors ::= List{CompFor, ""}
END_ITEM
ITEM 0996 /reference/reference-semantics/semantics/syntax.k:37 kind=syntax attrs=[]
  syntax Exprs    ::= List{Expr, ","}
END_ITEM
ITEM 0997 /reference/reference-semantics/semantics/syntax.k:38 kind=syntax attrs=[]
  syntax Index    ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
END_ITEM
ITEM 0998 /reference/reference-semantics/semantics/syntax.k:39 kind=syntax attrs=[]
  syntax Bound    ::= Expr | "NoBound"
END_ITEM
ITEM 0999 /reference/reference-semantics/semantics/syntax.k:41 kind=syntax attrs=['strict']
  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
                | "Import"    "(" String ")"
                | "ImportFrom" "(" String "," ParamNames ")"
                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
                | "While"     "(" Expr "," Stmts ")"
                | "Break"
                | "Continue"
                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
                | "Return"    "(" Expr ")" [strict]
                | "Assert"    "(" Expr ")" [strict]
                | "Expr"      "(" Expr ")" [strict]
                | "FuncDef"   "(" String "," Params "," Stmts ")"
                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
END_ITEM
ITEM 1000 /reference/reference-semantics/semantics/syntax.k:56 kind=syntax attrs=[]
  syntax Stmts      ::= List{Stmt, ""}
END_ITEM
ITEM 1001 /reference/reference-semantics/semantics/syntax.k:57 kind=syntax attrs=[]
  syntax Params     ::= "Params" "(" ParamNames ")"
END_ITEM
ITEM 1002 /reference/reference-semantics/semantics/syntax.k:58 kind=syntax attrs=[]
  syntax CellVars   ::= "CellVars" "(" ParamNames ")"
END_ITEM
ITEM 1003 /reference/reference-semantics/semantics/syntax.k:59 kind=syntax attrs=[]
  syntax FreeVars   ::= "FreeVars" "(" ParamNames ")"
END_ITEM
ITEM 1004 /reference/reference-semantics/semantics/syntax.k:60 kind=syntax attrs=[]
  syntax ParamNames ::= List{String, ","}
END_ITEM
ITEM 1005 /reference/reference-semantics/semantics/syntax.k:61 kind=syntax attrs=[]
  syntax Module     ::= "Module" "(" Stmts ")"
END_ITEM
ITEM 1006 /reference/reference-semantics/semantics/syntax.k:62 kind=endmodule attrs=[]
endmodule
END_ITEM
