ITEM 0490 /reference/reference-semantics/semantics/float.k:74 kind=rule attrs=[]
  rule floorFI(I:Int)   => I                        [concrete]
END_ITEM
ITEM 0491 /reference/reference-semantics/semantics/float.k:75 kind=rule attrs=[]
  rule floorFI(F:Float) => Float2Int(floorFloat(F)) [concrete]

