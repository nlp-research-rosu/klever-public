ITEM 1012 /reference/reference-semantics/semantics/tuple.k:10 kind=rule attrs=[]
  rule <k> #iterNext(tuple(.ValSeq))                => #iterDone ... </k>
END_ITEM
ITEM 1013 /reference/reference-semantics/semantics/tuple.k:11 kind=rule attrs=[]
  rule <k> #iterNext(tuple(vCons(V:Val, R:ValSeq))) => #iterYield(V, tuple(R)) ... </k>

  // ==== TupleExpr: tuple(ValSeq) literal + == != ===========================
END_ITEM
ITEM 1014 /reference/reference-semantics/semantics/tuple.k:14 kind=syntax attrs=[]
  syntax ApplyK ::= "toTuple"
END_ITEM
ITEM 1015 /reference/reference-semantics/semantics/tuple.k:15 kind=rule attrs=[]
  rule <k> TupleExpr(ES:Exprs) => #evalArgs(ES, .Vals, toTuple) ... </k>
END_ITEM
ITEM 1016 /reference/reference-semantics/semantics/tuple.k:16 kind=rule attrs=[]
  rule <k> #applyK(toTuple, ACC:Vals) => tuple(vals2valSeq(ACC)) ... </k>
END_ITEM
ITEM 1017 /reference/reference-semantics/semantics/tuple.k:18 kind=rule attrs=[]
  rule applyCmp("==", tuple(A:ValSeq), tuple(B:ValSeq)) => A ==K B
  // membership routes through the same k-cell fold as lists (list.k)
END_ITEM
ITEM 1018 /reference/reference-semantics/semantics/tuple.k:20 kind=rule attrs=[]
  rule <k> Compare(LV:Val, CmpOp("in",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>
END_ITEM
ITEM 1019 /reference/reference-semantics/semantics/tuple.k:21 kind=rule attrs=[]
  rule <k> Compare(LV:Val, CmpOp("not in", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>
  // t.index(v): first index of v (ValueError out of subset)
END_ITEM
ITEM 1020 /reference/reference-semantics/semantics/tuple.k:23 kind=rule attrs=[]
  rule applyMethod(tuple(VS:ValSeq), "index", V:Val, .Vals) => idxOfVS(VS, V, 0)
END_ITEM
ITEM 1021 /reference/reference-semantics/semantics/tuple.k:24 kind=syntax attrs=['function']
  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]
END_ITEM
ITEM 1022 /reference/reference-semantics/semantics/tuple.k:25 kind=rule attrs=[]
  rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V
END_ITEM
ITEM 1023 /reference/reference-semantics/semantics/tuple.k:26 kind=rule attrs=[]
  rule idxOfVS(vCons(A:Val, R:ValSeq), V:Val, I:Int) => idxOfVS(R, V, I +Int 1)
       requires notBool (A ==K V)
END_ITEM
ITEM 1024 /reference/reference-semantics/semantics/tuple.k:28 kind=rule attrs=[]
  rule applyCmp("!=", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)

  // ==== target binding: bind a Name or a TupleExpr target to a value ========
END_ITEM
ITEM 1025 /reference/reference-semantics/semantics/tuple.k:31 kind=syntax attrs=[]
  syntax KItem ::= #bindTgt(Expr, Val)
END_ITEM
ITEM 1026 /reference/reference-semantics/semantics/tuple.k:32 kind=rule attrs=[]
  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
END_ITEM
ITEM 1027 /reference/reference-semantics/semantics/tuple.k:35 kind=rule attrs=['priority']
  rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
       requires "$cells" in_keys(M)
        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
       [priority(40)]
END_ITEM
ITEM 1028 /reference/reference-semantics/semantics/tuple.k:42 kind=rule attrs=[]
  rule <k> #bindTgt(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
END_ITEM
ITEM 1029 /reference/reference-semantics/semantics/tuple.k:43 kind=rule attrs=[]
  rule <k> #bindTgt(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
END_ITEM
ITEM 1030 /reference/reference-semantics/semantics/tuple.k:44 kind=rule attrs=['priority']
  rule <k> #bindTgt(TupleExpr(TS:Exprs), ref(H:Int)) => #bindTgt(TupleExpr(TS), V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]

  // ==== unpacking: a, b = <tuple|list> (RHS evaluated by strictness) ========
END_ITEM
ITEM 1031 /reference/reference-semantics/semantics/tuple.k:49 kind=syntax attrs=[]
  syntax KItem ::= #unpackSeq(Exprs, ValSeq)
END_ITEM
ITEM 1032 /reference/reference-semantics/semantics/tuple.k:50 kind=rule attrs=[]
  rule <k> Assign(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
END_ITEM
ITEM 1033 /reference/reference-semantics/semantics/tuple.k:51 kind=rule attrs=[]
  rule <k> Assign(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
END_ITEM
ITEM 1034 /reference/reference-semantics/semantics/tuple.k:52 kind=rule attrs=['priority']
  rule <k> Assign(TupleExpr(TS:Exprs), ref(H:Int)) => Assign(TupleExpr(TS), V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
END_ITEM
ITEM 1035 /reference/reference-semantics/semantics/tuple.k:55 kind=rule attrs=[]
  rule <k> #unpackSeq((T:Expr, TS:Exprs), vCons(V:Val, VS:ValSeq))
        => #bindTgt(T, V) ~> #unpackSeq(TS, VS) ... </k>
END_ITEM
ITEM 1036 /reference/reference-semantics/semantics/tuple.k:57 kind=rule attrs=[]
  rule <k> #unpackSeq(.Exprs, .ValSeq) => .K ... </k>
END_ITEM
