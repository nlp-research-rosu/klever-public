  context Compare(HOLE, _)
END_ITEM
ITEM 0816 /reference/reference-semantics/semantics/operators.k:16 kind=context attrs=[]
  context Compare(_:Val, CmpOp(_, HOLE))
END_ITEM
ITEM 0817 /reference/reference-semantics/semantics/operators.k:17 kind=rule attrs=['owise']
  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
END_ITEM
ITEM 0818 /reference/reference-semantics/semantics/operators.k:19 kind=rule attrs=[]
  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
END_ITEM
ITEM 0819 /reference/reference-semantics/semantics/operators.k:20 kind=rule attrs=['priority']
  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)

  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
  // (Python: list == is structural; identity only via `is`.) priority(40)
  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
END_ITEM
ITEM 0820 /reference/reference-semantics/semantics/operators.k:25 kind=rule attrs=['priority']
  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
END_ITEM
ITEM 0821 /reference/reference-semantics/semantics/operators.k:28 kind=rule attrs=['priority']
  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       requires notBool isRefV(L)
       [priority(40)]

  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
END_ITEM
ITEM 0822 /reference/reference-semantics/semantics/operators.k:34 kind=rule attrs=['priority']
  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       requires OP =/=String "in" andBool OP =/=String "not in"
       [priority(40)]
END_ITEM
ITEM 0823 /reference/reference-semantics/semantics/operators.k:38 kind=rule attrs=['priority']
  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       requires notBool isRefV(L)
        orBool OP ==String "in" orBool OP ==String "not in"
       [priority(40)]
END_ITEM
ITEM 0824 /reference/reference-semantics/semantics/operators.k:44 kind=rule attrs=['priority']
  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
END_ITEM
ITEM 0825 /reference/reference-semantics/semantics/operators.k:47 kind=endmodule attrs=[]
endmodule
END_ITEM
