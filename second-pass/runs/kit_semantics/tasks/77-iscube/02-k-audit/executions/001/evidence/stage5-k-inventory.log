END_ITEM
ITEM 0604 /reference/reference-semantics/semantics/float.k:245 kind=rule attrs=[]
  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
END_ITEM
ITEM 0605 /reference/reference-semantics/semantics/float.k:246 kind=rule attrs=[]
  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
END_ITEM
ITEM 0606 /reference/reference-semantics/semantics/float.k:247 kind=rule attrs=[]
  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
       requires isFloat(V)
