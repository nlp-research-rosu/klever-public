  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
END_ITEM
ITEM 0944 /reference/reference-semantics/semantics/subscript.k:44 kind=syntax attrs=[]
  syntax KItem ::= #evalB(Bound) | "#toSome"
                 | #slLo(Val, Bound, Bound)
                 | #slHi(Val, OptInt, Bound)
                 | #slStep(Val, OptInt, OptInt)
END_ITEM
ITEM 0945 /reference/reference-semantics/semantics/subscript.k:49 kind=syntax attrs=[]
  syntax OptInt ::= "noB" | someB(Int)
END_ITEM
ITEM 0946 /reference/reference-semantics/semantics/subscript.k:50 kind=rule attrs=[]
  rule <k> #evalB(NoBound)  => noB ... </k>
END_ITEM
ITEM 0947 /reference/reference-semantics/semantics/subscript.k:51 kind=rule attrs=[]
  rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>
END_ITEM
ITEM 0948 /reference/reference-semantics/semantics/subscript.k:52 kind=rule attrs=[]
  rule <k> I:Int ~> #toSome => someB(I) ... </k>
END_ITEM
ITEM 0949 /reference/reference-semantics/semantics/subscript.k:54 kind=rule attrs=[]
  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>
END_ITEM
ITEM 0950 /reference/reference-semantics/semantics/subscript.k:55 kind=rule attrs=[]
  rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>
END_ITEM
ITEM 0951 /reference/reference-semantics/semantics/subscript.k:56 kind=rule attrs=[]
  rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>
  // a list slice constructs a NEW object; a str slice stays a value
END_ITEM
ITEM 0952 /reference/reference-semantics/semantics/subscript.k:58 kind=rule attrs=['priority']
  rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)
        => #alloc(doSlice(list(VS), LO, HI, ST)) ... </k>
       [priority(45)]
END_ITEM
ITEM 0953 /reference/reference-semantics/semantics/subscript.k:61 kind=rule attrs=[]
  rule <k> ST:OptInt ~> #slStep(OBJ:Val, LO:OptInt, HI:OptInt) => doSlice(OBJ, LO, HI, ST) ... </k>
END_ITEM
ITEM 0954 /reference/reference-semantics/semantics/subscript.k:63 kind=syntax attrs=['function']
  syntax Val ::= doSlice(Val, OptInt, OptInt, OptInt) [function]
END_ITEM
ITEM 0955 /reference/reference-semantics/semantics/subscript.k:64 kind=rule attrs=[]
  rule doSlice(list(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => list(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
END_ITEM
ITEM 0956 /reference/reference-semantics/semantics/subscript.k:66 kind=rule attrs=[]
  rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
END_ITEM
ITEM 0957 /reference/reference-semantics/semantics/subscript.k:68 kind=rule attrs=[]
  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))

  // ==== slice.indices: step / start / stop / clamp ==========================
END_ITEM
ITEM 0958 /reference/reference-semantics/semantics/subscript.k:72 kind=syntax attrs=['function', 'total']
  syntax Int ::= slStep(OptInt) [function, total]
END_ITEM
ITEM 0959 /reference/reference-semantics/semantics/subscript.k:73 kind=rule attrs=[]
  rule slStep(noB)          => 1
END_ITEM
ITEM 0960 /reference/reference-semantics/semantics/subscript.k:74 kind=rule attrs=[]
  rule slStep(someB(S:Int)) => S
END_ITEM
ITEM 0961 /reference/reference-semantics/semantics/subscript.k:76 kind=syntax attrs=['function']
  syntax Int ::= slStart(OptInt, OptInt, Int) [function]
END_ITEM
ITEM 0962 /reference/reference-semantics/semantics/subscript.k:77 kind=rule attrs=[]
  rule slStart(noB,          ST:OptInt, _LEN:Int) => 0
       requires slStep(ST) >Int 0
END_ITEM
ITEM 0963 /reference/reference-semantics/semantics/subscript.k:79 kind=rule attrs=[]
  rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1
       requires slStep(ST) <Int 0
END_ITEM
ITEM 0964 /reference/reference-semantics/semantics/subscript.k:81 kind=rule attrs=[]
  rule slStart(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
END_ITEM
ITEM 0965 /reference/reference-semantics/semantics/subscript.k:83 kind=syntax attrs=['function']
  syntax Int ::= slStop(OptInt, OptInt, Int) [function]
END_ITEM
ITEM 0966 /reference/reference-semantics/semantics/subscript.k:84 kind=rule attrs=[]
  rule slStop(noB,          ST:OptInt, LEN:Int)  => LEN
       requires slStep(ST) >Int 0
END_ITEM
ITEM 0967 /reference/reference-semantics/semantics/subscript.k:86 kind=rule attrs=[]
  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
       requires slStep(ST) <Int 0
END_ITEM
ITEM 0968 /reference/reference-semantics/semantics/subscript.k:88 kind=rule attrs=[]
  rule slStop(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
END_ITEM
ITEM 0969 /reference/reference-semantics/semantics/subscript.k:90 kind=syntax attrs=['function', 'total']
  syntax Int ::= slAdjust(Int, Int, Int) [function, total]
END_ITEM
ITEM 0970 /reference/reference-semantics/semantics/subscript.k:91 kind=rule attrs=[]
  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampLo(I +Int LEN, STEP)
       requires I  <Int 0
END_ITEM
ITEM 0971 /reference/reference-semantics/semantics/subscript.k:93 kind=rule attrs=[]
  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampHi(I, LEN, STEP)
       requires I >=Int 0
END_ITEM
ITEM 0972 /reference/reference-semantics/semantics/subscript.k:96 kind=syntax attrs=['function', 'total']
  syntax Int ::= clampLo(Int, Int) [function, total]
END_ITEM
ITEM 0973 /reference/reference-semantics/semantics/subscript.k:97 kind=rule attrs=[]
  rule clampLo(J:Int, _STEP:Int) => J
       requires J >=Int 0
END_ITEM
ITEM 0974 /reference/reference-semantics/semantics/subscript.k:99 kind=rule attrs=[]
  rule clampLo(J:Int, STEP:Int)  => #if STEP <Int 0 #then -1 #else 0 #fi
       requires J <Int 0
END_ITEM
ITEM 0975 /reference/reference-semantics/semantics/subscript.k:102 kind=syntax attrs=['function', 'total']
  syntax Int ::= clampHi(Int, Int, Int) [function, total]
END_ITEM
ITEM 0976 /reference/reference-semantics/semantics/subscript.k:103 kind=rule attrs=[]
  rule clampHi(I:Int, LEN:Int, _STEP:Int) => I
       requires I  <Int LEN
END_ITEM
ITEM 0977 /reference/reference-semantics/semantics/subscript.k:105 kind=rule attrs=[]
  rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi
       requires I >=Int LEN

  // ==== build the strided sub-sequence (indices in range by construction) ====
END_ITEM
ITEM 0978 /reference/reference-semantics/semantics/subscript.k:109 kind=syntax attrs=['function']
  syntax ValSeq ::= buildVS(ValSeq, Int, Int, Int) [function]
END_ITEM
ITEM 0979 /reference/reference-semantics/semantics/subscript.k:110 kind=rule attrs=[]
  rule buildVS(VS:ValSeq, I:Int, STOP:Int, STEP:Int)
    => vCons(valSeqAt(VS, I), buildVS(VS, I +Int STEP, STOP, STEP))
       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
END_ITEM
ITEM 0980 /reference/reference-semantics/semantics/subscript.k:113 kind=rule attrs=[]
  rule buildVS(_:ValSeq, I:Int, STOP:Int, STEP:Int) => .ValSeq
       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
END_ITEM
ITEM 0981 /reference/reference-semantics/semantics/subscript.k:116 kind=syntax attrs=['function']
  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]
END_ITEM
ITEM 0982 /reference/reference-semantics/semantics/subscript.k:117 kind=rule attrs=[]
  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
END_ITEM
ITEM 0983 /reference/reference-semantics/semantics/subscript.k:120 kind=rule attrs=[]
  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
END_ITEM
ITEM 0984 /reference/reference-semantics/semantics/subscript.k:122 kind=endmodule attrs=[]
endmodule
END_ITEM
ITEM 0985 /reference/reference-semantics/semantics/syntax.k:3 kind=module attrs=[]
module MPY-SYNTAX
END_ITEM
ITEM 0986 /reference/reference-semantics/semantics/syntax.k:4 kind=imports attrs=[]
  imports INT-SYNTAX
END_ITEM
ITEM 0987 /reference/reference-semantics/semantics/syntax.k:5 kind=imports attrs=[]
  imports FLOAT-SYNTAX
END_ITEM
ITEM 0988 /reference/reference-semantics/semantics/syntax.k:6 kind=imports attrs=[]
