+cc -shared -fPIC -O2 -Wall -Wextra -o /tmp/audit-work/lean_proc_exe_shim.so /audit-output/evidence/lean_proc_exe_shim.c
+LD_PRELOAD=/tmp/audit-work/lean_proc_exe_shim.so lean --version
+LD_PRELOAD=/tmp/audit-work/lean_proc_exe_shim.so PYTHONPATH=/reference python3 /audit-output/evidence/preflight_check.py
+
+# Independent Stage 4 manifest, obligation-bijection, and target checks
+PYTHONPATH=/reference python3 /audit-output/evidence/stage4_check.py
+sed -n '1,200p' /reference/klean-generation/generated/obligation-map.json
+nl -ba /reference/klean-generation/generated/Klean54SameChars/Lemmas.lean
+nl -ba /reference/klean-generation/generated/Klean54SameChars.lean
+
+# Source/postcondition/frozen operational meaning
+nl -ba /reference/k-proof/solution.py
+nl -ba /reference/k-proof/spec.k
+nl -ba /reference/k-proof/reference-semantics/semantics/builtins.k | sed -n '35,45p'
+nl -ba /reference/k-proof/reference-semantics/semantics/set.k
+nl -ba /reference/k-proof/reference-semantics/semantics/operators.k | sed -n '10,20p'
