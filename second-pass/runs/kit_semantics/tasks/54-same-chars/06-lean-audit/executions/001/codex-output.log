+print("OMITTED_IDS:", sorted(set(canonical_ids) - set(classified_ids)))
+print("VALIDATE_TRUST_BOUNDARY: PASS")
+for name in ("definitions", "operational_rules", "proved_derived_lemmas", "domain_lemmas"):
