from pathlib import Path
import hashlib, json
from tools.k_rule_inventory import inventory_verification, canonical_json_sha256
from tools.lemma_discovery_contract import validate_trust_boundary
workspace=Path('/reference/k-proof')
manifest=Path('/reference/lemma-discovery.json')
verification=(workspace/'verification.k').read_bytes()
inv=inventory_verification(workspace)
doc=json.loads(manifest.read_text())
validated=validate_trust_boundary(workspace,manifest)
print('COMMAND: inventory_verification(/reference/k-proof)')
print(json.dumps(inv,indent=2,sort_keys=True))
print('VERIFICATION_SHA256_RECOMPUTED:',hashlib.sha256(verification).hexdigest())
print('CANONICAL_RULE_LIST_JSON:',json.dumps(inv['rules'],sort_keys=True,separators=(',',':'),ensure_ascii=False))
print('INVENTORY_SHA256_RECOMPUTED:',canonical_json_sha256(inv['rules']))
print('MANIFEST_INVENTORY_SHA256:',doc['inventory_sha256'])
print('INVENTORY_HASH_MATCH:',canonical_json_sha256(inv['rules'])==doc['inventory_sha256'])
print('CANONICAL_IDS_IN_ORDER:',[r['source_rule_id'] for r in inv['rules']])
print('CLASSIFIED_IDS_IN_ORDER:',[r['source_rule_id'] for r in doc['rules']])
print('ORDERED_IDENTITY_MATCH:',[r['source_rule_id'] for r in inv['rules']]==[r['source_rule_id'] for r in doc['rules']])
print('UNIQUE_CANONICAL_IDS:',len({r['source_rule_id'] for r in inv['rules']})==len(inv['rules']))
print('UNIQUE_CLASSIFIED_IDS:',len({r['source_rule_id'] for r in doc['rules']})==len(doc['rules']))
print('EXTRA_IDS:',sorted({r['source_rule_id'] for r in doc['rules']}-{r['source_rule_id'] for r in inv['rules']}))
print('OMITTED_IDS:',sorted({r['source_rule_id'] for r in inv['rules']}-{r['source_rule_id'] for r in doc['rules']}))
print('VALIDATE_TRUST_BOUNDARY: PASS')
for name in ('definitions','operational_rules','proved_derived_lemmas','domain_lemmas'):
 print(name.upper()+'_COUNT:',len(validated[name]))
PY
