+    actual = same_chars(s0, s1)
+    if actual != expected:
+        mismatches.append((s0, s1, expected, actual))
+
+print(
+    "prompt_examples={0} exhaustive_pairs={1} mismatches={2}".format(
+        len(prompt_examples),
+        len(strings) * len(strings),
+        len(mismatches),
+    )
+)
+if mismatches:
+    raise AssertionError(mismatches[:10])
