pax=[False,True]
entries=[['.'],['2026'],['2026/07/25/rollout-2026-07-25T00-32-18-019f97c2-9199-79e1-9629-9a1021ffd1bc.jsonl'],['2026','2026/07','2026/07/25','2026/07/25/rollout-2026-07-25T00-32-18-019f97c2-9199-79e1-9629-9a1021ffd1bc.jsonl']]
for fmt,mt,owner,num,mode,px,ents in itertools.product(formats,mtimes,owners,numeric,modes,pax,entries):
