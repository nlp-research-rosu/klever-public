+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        .Map
+          [ "same_chars" <-
+              closureVal(
+                ("s0", "s1", .ParamNames),
+                (Return(
+                  Compare(
+                    Call(Name("set"), Name("s0")),
+                    CmpOp("==", Call(Name("set"), Name("s1")))))
+                 .Stmts),
+                0) ]
+          [ "result" <- false ],
+        parent(-1))
