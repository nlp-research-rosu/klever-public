import subprocess,hashlib,itertools,os
root='/generation-evidence/codex-trace'; target='cb6580214bd4d5beeafb17ae48f0d53db911476dddf4a400777167035823a137'
formats=[None,'gnu','posix','ustar','v7']
mtimes=[None,'@0','@1']
owners=[False,True]
numeric=[False,True]
