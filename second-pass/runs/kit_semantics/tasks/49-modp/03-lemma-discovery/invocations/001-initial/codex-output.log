/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
canonical_path = Path('/reference/rule-inventory.json')
output_path = Path('/workspace/trust-boundary.json')
canonical = json.loads(canonical_path.read_text())
output = json.loads(output_path.read_text())
assert set(output) == {'schema_version', 'inventory_sha256', 'rules'}
assert output['schema_version'] == 2
assert output['inventory_sha256'] == canonical['inventory_sha256']
assert isinstance(output['rules'], list)
canonical_ids = [rule['source_rule_id'] for rule in canonical['rules']]
output_ids = [rule['source_rule_id'] for rule in output['rules']]
assert output_ids == canonical_ids
assert len(output_ids) == len(set(output_ids))
for rule in output['rules']:
    assert set(rule) == {'source_rule_id', 'classification', 'rationale'}
    assert rule['classification'] in {
        'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'
    }
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()
assert Path('/workspace/DISCOVERY.md').stat().st_size > 0
print(f\"SCHEMA_OK rules={len(output_ids)} inventory_sha256={output['inventory_sha256']}\")
PY
