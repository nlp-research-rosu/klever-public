+  imports VERIFICATION
+
+  claim [modp-mutated-base]:
+    <k>
+      Call(Name("modp"), Int(N:Int), Int(P:Int))
+      =>
+      pyMod(2 ^Int N, P)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "modp" |->
+          closureVal(
+            ("n", "p"),
+            Return(BinOp("%", BinOp("**", Int(3), Name("n")), Name("p"))),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0 andBool P =/=Int 0
+endmodule
