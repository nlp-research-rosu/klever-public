codex
The off-by-one theorem was rejected with `WarnStuckClaimState` and exit 1, showing the result is genuinely constrained. Following the validation skill, I’m adding two reproducible checks: a body-sensitivity mutation (`2` changed to `3`, expected proof failure) and a differential test against Python’s independent three-argument `pow` across the symbolic domain’s boundaries and a broad finite sample.
apply patch
patch: completed
/workspace/differential_test.py
/workspace/spec-body-mutation.k
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..b217a0e01b762ea014886b8e02f84f3271a153c3
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,38 @@
+from solution import modp
+
+
+def main():
+    cases = set()
+    for n in range(257):
+        for p in range(-64, 65):
+            if p != 0:
+                cases.add((n, p))
+
+    cases.update(
+        {
+            (0, 1),
+            (0, 101),
+            (3, 5),
+            (3, 11),
+            (100, 101),
+            (1101, 101),
+            (10000, 65537),
+            (10000, -65537),
+        }
+    )
+
+    mismatches = []
+    for n, p in sorted(cases):
+        actual = modp(n, p)
+        expected = pow(2, n, p)
+        if actual != expected:
+            mismatches.append((n, p, actual, expected))
+
+    print(f"cases={len(cases)} mismatches={len(mismatches)}")
+    if mismatches:
+        print(mismatches[:10])
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..a6bbdd0e9c1e257e7548b436767bf069cef1d2f1
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,9 @@
+def modp(n: int, p: int):
+    return 2 ** n % p
+
+
+assert modp(3, 5) == 3
+assert modp(1101, 101) == 2
+assert modp(0, 101) == 1
+assert modp(3, 11) == 8
+assert modp(100, 101) == 1
