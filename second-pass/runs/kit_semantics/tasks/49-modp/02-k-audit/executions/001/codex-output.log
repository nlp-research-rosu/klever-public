/audit-output/evidence/run_logged.sh /audit-output/evidence/stage1-candidate-file-manifest.log bash -lc 'cd /candidate; find . -type f -printf \"%P\\0\" | sort -z | while IFS= read -r -d \"\" f; do sha256sum \""'$f"; done'"'
