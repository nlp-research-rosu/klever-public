    11	    >>> modp(3, 11)
    12	    8
    13	    >>> modp(100, 101)
    14	    1
    15	    """
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py smoke.py > smoke.mpy
     6	
     7	kompile --backend llvm reference-semantics/semantics.k \
     8	  --main-module MPY-KRUN \
     9	  --syntax-module MPY-SYNTAX \
    10	  --output-definition runtime-kompiled
    11	
    12	krun smoke.mpy --definition runtime-kompiled
    13	
    14	kompile --backend haskell verification.k \
    15	  --main-module VERIFICATION \
    16	  --syntax-module MPY-SYNTAX \
    17	  --output-definition verification-kompiled
    18	
    19	kprove spec.k \
    20	  --definition verification-kompiled \
    21	  --spec-module SPEC
    22	
    23	set +e
    24	kprove spec-vacuity.k \
    25	  --definition verification-kompiled \
    26	  --spec-module SPEC-VACUITY
    27	vacuity_probe_status=$?
    28	set -e
    29	if [[ ${vacuity_probe_status} -eq 0 ]]; then
    30	  echo "ERROR: off-by-one mutation unexpectedly proved" >&2
    31	  exit 1
    32	fi
    33	echo "EXPECTED FAILURE: off-by-one mutation exited ${vacuity_probe_status}"
    34	
    35	set +e
    36	kprove spec-body-mutation.k \
    37	  --definition verification-kompiled \
    38	  --spec-module SPEC-BODY-MUTATION
    39	body_probe_status=$?
    40	set -e
    41	if [[ ${body_probe_status} -eq 0 ]]; then
    42	  echo "ERROR: mutated implementation unexpectedly proved" >&2
    43	  exit 1
    44	fi
    45	echo "EXPECTED FAILURE: body mutation exited ${body_probe_status}"
    46	
    47	python3 differential_test.py
    48	
    49	python3 -c 'from solution import modp; print("negative-exponent-witness:", modp(-1, 5), type(modp(-1, 5)).__name__)'
    50	python3 -c 'from solution import modp
    51	try:
    52	    modp(3, 0)
    53	except Exception as err:
    54	    print("zero-modulus-witness:", type(err).__name__, str(err))'

