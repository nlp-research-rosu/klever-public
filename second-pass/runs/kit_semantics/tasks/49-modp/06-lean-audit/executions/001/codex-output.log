e_id\"] for r in O[\"source_rules\"]],\"obligation_rule_ids\":[r[\"source_rule_id\"] for r in O[\"obligations\"]]},\"toolchain_lock_matches\":G[\"toolchain\"]==L}; print(json.dumps(out,indent=2,sort_keys=True))'" in /audit-output
