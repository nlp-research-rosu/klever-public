diff --git a/evidence/spec-fresh-vacuity.k b/evidence/spec-fresh-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..2c8271dbef0fdb1cdec27efabb114750bd35d185
--- /dev/null
+++ b/evidence/spec-fresh-vacuity.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC-FRESH-VACUITY
+  imports VERIFICATION
+
+  // Reviewer-authored false mutation.  The satisfying bit-string inputs
+  // "010" and "110" produce "100"; this changes the last output bit to "1".
+  claim [wrong-documented-example]:
+    <k>
+      Call(
+        Name("string_xor"),
+        str(iCons(48, iCons(49, iCons(48, .IntSeq)))),
+        str(iCons(49, iCons(49, iCons(48, .IntSeq))))
+      )
+      =>
+      str(iCons(49, iCons(48, iCons(49, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result")),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-ground.k b/evidence/spec-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..dd8806669b09a291f2ce229534c67e7b7759d445
--- /dev/null
+++ b/evidence/spec-ground.k
@@ -0,0 +1,87 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  claim [documented-example]:
+    <k>
+      Call(
+        Name("string_xor"),
+        str(iCons(48, iCons(49, iCons(48, .IntSeq)))),
+        str(iCons(49, iCons(49, iCons(48, .IntSeq))))
+      )
+      =>
+      str(iCons(49, iCons(48, iCons(48, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result")),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [empty-witness]:
