+requires "verification.k"
+
+module CONTINUATION-SPEC-BASE
+  imports VERIFICATION-BASE
+
+  claim [one-step-with-observable-suffix]:
+    <k>
+      #loop(
+        zipObjS(iCons(48, .IntSeq), iCons(49, .IntSeq)),
+        TupleExpr(Name("x"), Name("y")),
+        If(
+          Compare(Name("x"), CmpOp("==", Name("y"))),
+          AugAssign(Name("result"), "+", Str("0")),
+          AugAssign(Name("result"), "+", Str("1"))
+        )
+      )
+      ~> Assign(Name("marker"), Str("M"))
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |->
+        ( scope(
+            "a"      |-> str(iCons(48, .IntSeq))
+            "b"      |-> str(iCons(49, .IntSeq))
+            "result" |-> str(.IntSeq)
+            "x"      |-> str(.IntSeq)
+            "y"      |-> str(.IntSeq),
+            parent(0)
+          )
+          =>
+          scope(
+            "a"      |-> str(iCons(48, .IntSeq))
+            "b"      |-> str(iCons(49, .IntSeq))
+            "result" |-> str(iCons(49, .IntSeq))
+            "x"      |-> str(iCons(48, .IntSeq))
+            "y"      |-> str(iCons(49, .IntSeq))
+            "marker" |-> str(iCons(77, .IntSeq)),
+            parent(0)
+          )
+        )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module CONTINUATION-SPEC-BRIDGE
+  imports VERIFICATION
+
+  claim [one-step-with-observable-suffix]:
+    <k>
+      #loop(
+        zipObjS(iCons(48, .IntSeq), iCons(49, .IntSeq)),
+        TupleExpr(Name("x"), Name("y")),
+        If(
+          Compare(Name("x"), CmpOp("==", Name("y"))),
+          AugAssign(Name("result"), "+", Str("0")),
+          AugAssign(Name("result"), "+", Str("1"))
+        )
+      )
+      ~> Assign(Name("marker"), Str("M"))
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |->
+        ( scope(
+            "a"      |-> str(iCons(48, .IntSeq))
+            "b"      |-> str(iCons(49, .IntSeq))
+            "result" |-> str(.IntSeq)
+            "x"      |-> str(.IntSeq)
+            "y"      |-> str(.IntSeq),
+            parent(0)
+          )
+          =>
+          scope(
+            "a"      |-> str(iCons(48, .IntSeq))
+            "b"      |-> str(iCons(49, .IntSeq))
+            "result" |-> str(iCons(49, .IntSeq))
+            "x"      |-> str(iCons(48, .IntSeq))
+            "y"      |-> str(iCons(49, .IntSeq))
+            "marker" |-> str(iCons(77, .IntSeq)),
+            parent(0)
+          )
+        )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-fresh-vacuity.k b/evidence/spec-fresh-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..2c8271dbef0fdb1cdec27efabb114750bd35d185
--- /dev/null
+++ b/evidence/spec-fresh-vacuity.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC-FRESH-VACUITY
+  imports VERIFICATION
+
+  // Reviewer-authored false mutation.  The satisfying bit-string inputs
+  // "010" and "110" produce "100"; this changes the last output bit to "1".
+  claim [wrong-documented-example]:
+    <k>
+      Call(
+        Name("string_xor"),
+        str(iCons(48, iCons(49, iCons(48, .IntSeq)))),
+        str(iCons(49, iCons(49, iCons(48, .IntSeq))))
