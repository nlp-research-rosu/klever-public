--- /dev/null
+++ b/spec.k
@@ -0,0 +1,106 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-BASE
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        zipObjS(A:IntSeq, B:IntSeq),
+        TupleExpr(Name("x"), Name("y")),
+        If(
+          Compare(Name("x"), CmpOp("==", Name("y"))),
+          AugAssign(Name("result"), "+", Str("0")),
+          AugAssign(Name("result"), "+", Str("1"))
+        )
+      ) ~> Return(Name("result")) ~> #endcall
+      =>
+      Return(Name("result")) ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> BI:Scope
+      0  |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result")),
+            0
+          ),
+        parent(-1)
+      )
+      1  |-> scope(
+        "a"      |-> str(A0:IntSeq)
+        "b"      |-> str(B0:IntSeq)
+        "result" |-> (str(R:IntSeq) => str(xorAcc(R, A, B)))
+        "x"      |-> (X0:Val => lastX(X0, A, B))
+        "y"      |-> (Y0:Val => lastY(Y0, A, B)),
+        parent(0)
+      )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bitString(A) andBool bitString(B)
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  claim [string-xor]:
+    <k>
+      Call(Name("string_xor"), str(A:IntSeq), str(B:IntSeq))
+      =>
+      str(?OUT:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result")),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bitString(A) andBool bitString(B)
+    ensures ?OUT ==K xorAcc(.IntSeq, A, B)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6c7ecfb04b9a3bca5971489cad1b34a26fd57eb
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,122 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // Mathematical summary of the result accumulated by the source loop.
+  // zip truncates at the shorter sequence; equal bits append '0', unequal
+  // bits append '1'.
+  syntax IntSeq ::= xorAcc(IntSeq, IntSeq, IntSeq) [function, total]
+  rule xorAcc(ACC:IntSeq, .IntSeq, _:IntSeq) => ACC
+    [simplification]
+  rule xorAcc(ACC:IntSeq, iCons(_:Int, _:IntSeq), .IntSeq) => ACC
+    [simplification]
+  rule xorAcc(ACC:IntSeq,
+              iCons(A:Int, AS:IntSeq),
+              iCons(B:Int, BS:IntSeq))
+    => xorAcc(seqConcat(ACC, iCons(48, .IntSeq)), AS, BS)
+    requires A ==Int B
+    [simplification]
+  rule xorAcc(ACC:IntSeq,
+              iCons(A:Int, AS:IntSeq),
+              iCons(B:Int, BS:IntSeq))
+    => xorAcc(seqConcat(ACC, iCons(49, .IntSeq)), AS, BS)
+    requires A =/=Int B
+    [simplification]
+
+  // The HumanEval contract restricts inputs to strings of '0' and '1'.
+  syntax Bool ::= bitString(IntSeq) [function, total]
+  rule bitString(.IntSeq) => true
+    [simplification]
+  rule bitString(iCons(C:Int, CS:IntSeq))
+    => (C ==Int 48 orBool C ==Int 49) andBool bitString(CS)
+    [simplification]
+
+  // Exact final values of the source loop targets.  They remain unchanged
+  // when zip is empty and otherwise hold the last pair yielded by zip.
+  syntax Val ::= lastX(Val, IntSeq, IntSeq) [function, total]
+  rule lastX(X:Val, .IntSeq, _:IntSeq) => X
+    [simplification]
+  rule lastX(X:Val, iCons(_:Int, _:IntSeq), .IntSeq) => X
+    [simplification]
+  rule lastX(_:Val,
+             iCons(A:Int, AS:IntSeq),
+             iCons(_:Int, BS:IntSeq))
+    => lastX(str(iCons(A, .IntSeq)), AS, BS)
+    [simplification]
+
+  syntax Val ::= lastY(Val, IntSeq, IntSeq) [function, total]
+  rule lastY(Y:Val, .IntSeq, _:IntSeq) => Y
+    [simplification]
+  rule lastY(Y:Val, iCons(_:Int, _:IntSeq), .IntSeq) => Y
+    [simplification]
+  rule lastY(_:Val,
+             iCons(_:Int, AS:IntSeq),
+             iCons(B:Int, BS:IntSeq))
+    => lastY(str(iCons(B, .IntSeq)), AS, BS)
+    [simplification]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Operational use of the independently proved LOOP-SPEC.loop-invariant
+  // theorem.  The rule's complete match domain is identical to that claim:
+  // exact loop, continuation, binding, frames, cells, and bit-string guard.
+  rule
+    <k>
+      #loop(
+        zipObjS(A:IntSeq, B:IntSeq),
+        TupleExpr(Name("x"), Name("y")),
+        If(
+          Compare(Name("x"), CmpOp("==", Name("y"))),
+          AugAssign(Name("result"), "+", Str("0")),
+          AugAssign(Name("result"), "+", Str("1"))
+        )
+      ) ~> Return(Name("result")) ~> #endcall
+      =>
+      Return(Name("result")) ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> BI:Scope
+      0  |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result")),
+            0
+          ),
+        parent(-1)
+      )
+      1  |-> scope(
+        "a"      |-> str(A0:IntSeq)
+        "b"      |-> str(B0:IntSeq)
+        "result" |-> (str(R:IntSeq) => str(xorAcc(R, A, B)))
+        "x"      |-> (X0:Val => lastX(X0, A, B))
+        "y"      |-> (Y0:Val => lastY(Y0, A, B)),
+        parent(0)
+      )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bitString(A) andBool bitString(B)
+    [priority(40)]
+endmodule

codex
The compiled bridge is present and its configuration matches; the remaining applicability obstacle is its symbolic `bitString` guard. The loop theorem’s behavior actually holds for all `IntSeq` strings (equality emits `0`, inequality emits `1`), so I’m removing that unnecessary guard from both theorem and bridge. The entry claim keeps the HumanEval bit-string precondition.
apply patch
