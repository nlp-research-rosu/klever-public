@@ -0,0 +1,10 @@
+def string_xor(a: str, b: str) -> str:
+    result = ""
+    x = ""
+    y = ""
+    for x, y in zip(a, b):
+        if x == y:
+            result += "0"
+        else:
+            result += "1"
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
