+++ b/spec-body-mutation.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module LOOP-SPEC-BODY-MUTATION
+  imports VERIFICATION-BASE
+
+  // Deliberately wrong connection claim: the source body has its "0" and
+  // "1" appends exchanged while the original xorAcc postcondition is kept.
+  claim [swapped-branches]:
+    <k>
+      #loop(
+        zipObjS(A:IntSeq, B:IntSeq),
+        TupleExpr(Name("x"), Name("y")),
+        If(
+          Compare(Name("x"), CmpOp("==", Name("y"))),
+          AugAssign(Name("result"), "+", Str("1")),
+          AugAssign(Name("result"), "+", Str("0"))
+        )
+      )
+      =>
+      .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "a"      |-> str(A0:IntSeq)
+        "b"      |-> str(B0:IntSeq)
+        "result" |-> (str(R:IntSeq) => str(xorAcc(R, A, B)))
+        "x"      |-> (X0:Val => lastX(X0, A, B))
+        "y"      |-> (Y0:Val => lastY(Y0, A, B)),
+        P:Parent
+      )
+      ...
+    </scopes>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..d150900af5e998da176e51141f3113827c6ab65b
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: string_xor("", "") returns "", not "0".
+  claim [false-result]:
+    <k>
+      Call(Name("string_xor"), str(.IntSeq), str(.IntSeq))
+      =>
+      str(iCons(48, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result")),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f89f076d921ef0406478806eadb9c42cb37d2299
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-BASE
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        zipObjS(A:IntSeq, B:IntSeq),
+        TupleExpr(Name("x"), Name("y")),
+        If(
+          Compare(Name("x"), CmpOp("==", Name("y"))),
+          AugAssign(Name("result"), "+", Str("0")),
+          AugAssign(Name("result"), "+", Str("1"))
+        )
+      )
+      =>
+      .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "a"      |-> str(A0:IntSeq)
+        "b"      |-> str(B0:IntSeq)
+        "result" |-> (str(R:IntSeq) => str(xorAcc(R, A, B)))
+        "x"      |-> (X0:Val => lastX(X0, A, B))
+        "y"      |-> (Y0:Val => lastY(Y0, A, B)),
+        P:Parent
+      )
+      ...
+    </scopes>
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  claim [string-xor]:
+    <k>
+      Call(Name("string_xor"), str(A:IntSeq), str(B:IntSeq))
+      =>
+      str(?OUT:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result")),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bitString(A) andBool bitString(B)
+    ensures ?OUT ==K xorAcc(.IntSeq, A, B)
+endmodule
diff --git a/validation_test.py b/validation_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..26b45312b15bbac639101de8e81470dbd245db87
--- /dev/null
+++ b/validation_test.py
@@ -0,0 +1,29 @@
+from itertools import product
+
+from solution import string_xor
+
+
+def oracle(a: str, b: str) -> str:
+    return "".join(str(int(x) ^ int(y)) for x, y in zip(a, b))
+
+
+def bit_strings(max_length: int):
+    for length in range(max_length + 1):
+        for bits in product("01", repeat=length):
+            yield "".join(bits)
+
+
+inputs = list(bit_strings(5))
+mismatches = []
+for a in inputs:
+    for b in inputs:
+        actual = string_xor(a, b)
+        expected = oracle(a, b)
+        if actual != expected:
+            mismatches.append((a, b, actual, expected))
+
+print(f"pairs={len(inputs) ** 2} mismatches={len(mismatches)}")
+if mismatches:
+    for mismatch in mismatches[:10]:
+        print(mismatch)
+    raise SystemExit(1)
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b870b5bc3c5f7aecec66468f6aa6d3130986d746
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,95 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // Mathematical summary of the result accumulated by the source loop.
+  // zip truncates at the shorter sequence; equal bits append '0', unequal
+  // bits append '1'.
+  syntax IntSeq ::= xorAcc(IntSeq, IntSeq, IntSeq) [function, total]
+  rule xorAcc(ACC:IntSeq, .IntSeq, _:IntSeq) => ACC
+    [simplification]
+  rule xorAcc(ACC:IntSeq, iCons(_:Int, _:IntSeq), .IntSeq) => ACC
+    [simplification]
+  rule xorAcc(ACC:IntSeq,
+              iCons(A:Int, AS:IntSeq),
+              iCons(B:Int, BS:IntSeq))
+    => xorAcc(seqConcat(ACC, iCons(48, .IntSeq)), AS, BS)
+    requires A ==Int B
+    [simplification]
+  rule xorAcc(ACC:IntSeq,
+              iCons(A:Int, AS:IntSeq),
+              iCons(B:Int, BS:IntSeq))
+    => xorAcc(seqConcat(ACC, iCons(49, .IntSeq)), AS, BS)
+    requires A =/=Int B
+    [simplification]
+
+  // The HumanEval contract restricts inputs to strings of '0' and '1'.
+  syntax Bool ::= bitString(IntSeq) [function, total]
+  rule bitString(.IntSeq) => true
+    [simplification]
+  rule bitString(iCons(C:Int, CS:IntSeq))
+    => (C ==Int 48 orBool C ==Int 49) andBool bitString(CS)
+    [simplification]
+
+  // Exact final values of the source loop targets.  They remain unchanged
+  // when zip is empty and otherwise hold the last pair yielded by zip.
+  syntax Val ::= lastX(Val, IntSeq, IntSeq) [function, total]
+  rule lastX(X:Val, .IntSeq, _:IntSeq) => X
+    [simplification]
+  rule lastX(X:Val, iCons(_:Int, _:IntSeq), .IntSeq) => X
+    [simplification]
+  rule lastX(_:Val,
+             iCons(A:Int, AS:IntSeq),
+             iCons(_:Int, BS:IntSeq))
+    => lastX(str(iCons(A, .IntSeq)), AS, BS)
+    [simplification]
+
+  syntax Val ::= lastY(Val, IntSeq, IntSeq) [function, total]
+  rule lastY(Y:Val, .IntSeq, _:IntSeq) => Y
+    [simplification]
+  rule lastY(Y:Val, iCons(_:Int, _:IntSeq), .IntSeq) => Y
+    [simplification]
+  rule lastY(_:Val,
+             iCons(_:Int, AS:IntSeq),
+             iCons(B:Int, BS:IntSeq))
+    => lastY(str(iCons(B, .IntSeq)), AS, BS)
+    [simplification]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Operational use of the independently proved LOOP-SPEC.loop-invariant
+  // theorem.  The rule's complete match domain is identical to that claim:
+  // exact loop, continuation, binding, frames, and cells.
+  rule
+    <k>
+      #loop(
+        zipObjS(A:IntSeq, B:IntSeq),
+        TupleExpr(Name("x"), Name("y")),
+        If(
+          Compare(Name("x"), CmpOp("==", Name("y"))),
+          AugAssign(Name("result"), "+", Str("0")),
+          AugAssign(Name("result"), "+", Str("1"))
+        )
+      )
+      =>
+      .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "a"      |-> str(A0:IntSeq)
+        "b"      |-> str(B0:IntSeq)
+        "result" |-> (str(R:IntSeq) => str(xorAcc(R, A, B)))
+        "x"      |-> (X0:Val => lastX(X0, A, B))
+        "y"      |-> (Y0:Val => lastY(Y0, A, B)),
+        P:Parent
+      )
+      ...
+    </scopes>
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'krun concrete_tests.mpy --definition verification-kompiled --output none
echo "bridge_krun_exit=$?"' in /workspace
diff --git a/check_artifacts.py b/check_artifacts.py
new file mode 100644
index 0000000000000000000000000000000000000000..87daef6aba9dccc0ffa78b0412f2993a16878b5e
--- /dev/null
+++ b/check_artifacts.py
@@ -0,0 +1,45 @@
+import ast
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+def normalized(text: str) -> str:
+    return re.sub(r"\s+", "", text)
+
+
+solution_source = Path("solution.py").read_text()
+solution_mpy = Path("solution.mpy").read_text()
+regenerated = subprocess.check_output(
+    [sys.executable, "py2mpy.py", "solution.py"],
+    text=True,
+)
+assert regenerated == solution_mpy
+
+solution_function = ast.parse(solution_source).body[0]
+concrete_function = ast.parse(Path("concrete_tests.py").read_text()).body[0]
+assert ast.dump(solution_function) == ast.dump(concrete_function)
+
+term = normalized(solution_mpy)
+prefix = 'Module(FuncDef("string_xor",Params("a","b"),'
+assert term.startswith(prefix) and term.endswith("))")
+body = term[len(prefix):-2]
+expected_closure = 'closureVal(("a","b"),' + body + ",0)"
+assert expected_closure in normalized(Path("spec.k").read_text())
+assert expected_closure in normalized(Path("spec-vacuity.k").read_text())
+
+verification_text = Path("verification.k").read_text()
+spec_text = Path("spec.k").read_text()
+bridge = verification_text.split("  rule\n", 1)[1].split(
+    "    [priority(40)]", 1
+)[0]
+connection_claim = spec_text.split(
+    "  claim [loop-invariant]:\n", 1
+)[1].split("endmodule", 1)[0]
+assert normalized(bridge) == normalized(connection_claim)
+
+print("translation_matches=true")
+print("concrete_function_matches=true")
+print("entry_closure_matches=true")
+print("bridge_matches_connection_claim=true")
