+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  claim [string-xor]:
+    <k>
+      Call(Name("string_xor"), str(A:IntSeq), str(B:IntSeq))
+      =>
+      str(?OUT:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
