diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..59de69866c8767431f9094946854feabf7765592
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,101 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        zipObjS(A:IntSeq, B:IntSeq),
+        TupleExpr(Name("x"), Name("y")),
+        If(
+          Compare(Name("x"), CmpOp("==", Name("y"))),
+          AugAssign(Name("result"), "+", Str("0")),
+          AugAssign(Name("result"), "+", Str("1"))
+        )
+      ) ~> Return(Name("result")) ~> #endcall
+      =>
+      Return(Name("result")) ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "string_xor" |->
+          closureVal(
+            ("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result")),
+            0
+          ),
+        parent(-1)
+      )
+      1  |-> scope(
+        "a"      |-> str(A0:IntSeq)
+        "b"      |-> str(B0:IntSeq)
+        "result" |-> (str(R:IntSeq) => str(xorAcc(R, A, B)))
+        "x"      |-> (X0:Val => ?X:Val)
+        "y"      |-> (Y0:Val => ?Y:Val),
+        parent(0)
+      )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bitString(A) andBool bitString(B)
+
+  claim [string-xor]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "string_xor",
+            Params("a", "b"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("x"), Str(""))
+            Assign(Name("y"), Str(""))
+            For(
+              TupleExpr(Name("x"), Name("y")),
+              Call(Name("zip"), Name("a"), Name("b")),
+              If(
+                Compare(Name("x"), CmpOp("==", Name("y"))),
+                AugAssign(Name("result"), "+", Str("0")),
+                AugAssign(Name("result"), "+", Str("1"))
+              )
+            )
+            Return(Name("result"))
+          )
+        )
+      ) ~> Call(Name("string_xor"), str(A:IntSeq), str(B:IntSeq))
+      =>
+      str(xorAcc(.IntSeq, A, B))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bitString(A) andBool bitString(B)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..95951639ed4f0e1b1eaab1006a6be1569b0985a4
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,28 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical summary of the result accumulated by the source loop.
+  // zip truncates at the shorter sequence; equal bits append '0', unequal
+  // bits append '1'.
+  syntax IntSeq ::= xorAcc(IntSeq, IntSeq, IntSeq) [function, total]
+  rule xorAcc(ACC:IntSeq, .IntSeq, _:IntSeq) => ACC
+  rule xorAcc(ACC:IntSeq, iCons(_:Int, _:IntSeq), .IntSeq) => ACC
+  rule xorAcc(ACC:IntSeq,
+              iCons(A:Int, AS:IntSeq),
+              iCons(B:Int, BS:IntSeq))
+    => xorAcc(seqConcat(ACC, iCons(48, .IntSeq)), AS, BS)
+    requires A ==Int B
+  rule xorAcc(ACC:IntSeq,
+              iCons(A:Int, AS:IntSeq),
+              iCons(B:Int, BS:IntSeq))
+    => xorAcc(seqConcat(ACC, iCons(49, .IntSeq)), AS, BS)
+    requires A =/=Int B
+
+  // The HumanEval contract restricts inputs to strings of '0' and '1'.
+  syntax Bool ::= bitString(IntSeq) [function, total]
+  rule bitString(.IntSeq) => true
+  rule bitString(iCons(C:Int, CS:IntSeq))
+    => (C ==Int 48 orBool C ==Int 49) andBool bitString(CS)
+endmodule

