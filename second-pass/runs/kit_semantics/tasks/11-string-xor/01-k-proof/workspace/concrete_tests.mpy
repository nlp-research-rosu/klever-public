Module(
  FuncDef("string_xor", Params("a", "b"),
    Assign(Name("result"), Str(""))
    Assign(Name("x"), Str(""))
    Assign(Name("y"), Str(""))
    For(TupleExpr(Name("x"), Name("y")), Call(Name("zip"), Name("a"), Name("b")),
      If(Compare(Name("x"), CmpOp("==", Name("y"))),
        AugAssign(Name("result"), "+", Str("0")),
        AugAssign(Name("result"), "+", Str("1"))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("010"), Str("110")),
      CmpOp("==", Str("100"))))
  Assert(
    Compare(
      Call(Name("string_xor"), Str(""), Str("")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("1"), Str("0")),
      CmpOp("==", Str("1"))))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("1011"), Str("01")),
      CmpOp("==", Str("11")))))
