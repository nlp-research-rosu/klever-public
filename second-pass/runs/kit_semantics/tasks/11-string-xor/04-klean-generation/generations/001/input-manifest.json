      "end_line": 94,
      "module": "VERIFICATION",
      "normalized_sha256": "26fc544a3a34446e7dde0573f648e03f5ed33bc32ff9f6826cbd2730d9208ef4",
      "rationale": "Its exact normalized statement is LOOP-SPEC.loop-invariant; prove.sh proves that claim with bridge-free verification-base-kompiled before proving the dependent entry claim with verification-kompiled, and check_artifacts.py enforces exact rule/claim correspondence.",
      "source_rule_id": "rule-26fc544a3a34446e7dde0573f648e03f5ed33bc32ff9f6826cbd2730d9208ef4",
      "start_line": 66,
      "text": "  rule\n    <k>\n      #loop(\n        zipObjS(A:IntSeq, B:IntSeq),\n        TupleExpr(Name(\"x\"), Name(\"y\")),\n        If(\n          Compare(Name(\"x\"), CmpOp(\"==\", Name(\"y\"))),\n          AugAssign(Name(\"result\"), \"+\", Str(\"0\")),\n          AugAssign(Name(\"result\"), \"+\", Str(\"1\"))\n        )\n      )\n      =>\n      .K\n      ...\n    </k>\n    <env> L:Int </env>\n    <scopes>\n      ...\n      L |-> scope(\n        \"a\"      |-> str(A0:IntSeq)\n        \"b\"      |-> str(B0:IntSeq)\n        \"result\" |-> (str(R:IntSeq) => str(xorAcc(R, A, B)))\n        \"x\"      |-> (X0:Val => lastX(X0, A, B))\n        \"y\"      |-> (Y0:Val => lastY(Y0, A, B)),\n        P:Parent\n      )\n      ...\n    </scopes>\n    [priority(40)]"
    }
  ],
