{
  "definitions": [
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "4538d6857ba52cff8cae6b2e278d286d492b01573dd8d706da0da3935257ae55",
      "rationale": "Base equation for xorAcc when the first zipped input is empty; it defines the accumulator result and adds no independent mathematical fact.",
      "source_rule_id": "rule-4538d6857ba52cff8cae6b2e278d286d492b01573dd8d706da0da3935257ae55",
      "start_line": 10,
      "text": "  rule xorAcc(ACC:IntSeq, .IntSeq, _:IntSeq) => ACC\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "21882032133cb4faaa1b53cf472247ffaca30b4ae987d2593f882090d4f99481",
      "rationale": "Base equation for xorAcc when the second zipped input is empty; it defines truncation at the shorter input.",
      "source_rule_id": "rule-21882032133cb4faaa1b53cf472247ffaca30b4ae987d2593f882090d4f99481",
      "start_line": 12,
      "text": "  rule xorAcc(ACC:IntSeq, iCons(_:Int, _:IntSeq), .IntSeq) => ACC\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "4aebdd6812ac9010d20f560b9d10799a11b7f633715366d5677cb05718f36635",
      "rationale": "Recursive xorAcc equation for equal heads; it defines appending code 48 and structurally recursing on both tails.",
      "source_rule_id": "rule-4aebdd6812ac9010d20f560b9d10799a11b7f633715366d5677cb05718f36635",
      "start_line": 14,
      "text": "  rule xorAcc(ACC:IntSeq,\n              iCons(A:Int, AS:IntSeq),\n              iCons(B:Int, BS:IntSeq))\n    => xorAcc(seqConcat(ACC, iCons(48, .IntSeq)), AS, BS)\n    requires A ==Int B\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "8252ab65315e868d5ecd0744ff49153573a6f162ecfdb9cc009289116b48f8a0",
      "rationale": "Recursive xorAcc equation for unequal heads; it defines appending code 49 and structurally recursing on both tails.",
      "source_rule_id": "rule-8252ab65315e868d5ecd0744ff49153573a6f162ecfdb9cc009289116b48f8a0",
      "start_line": 20,
      "text": "  rule xorAcc(ACC:IntSeq,\n              iCons(A:Int, AS:IntSeq),\n              iCons(B:Int, BS:IntSeq))\n    => xorAcc(seqConcat(ACC, iCons(49, .IntSeq)), AS, BS)\n    requires A =/=Int B\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "c5b80d5cddaf8560e0c97ce4ee0569156df290323257b2e7a88f6aed2b045736",
      "rationale": "Base equation defining the empty IntSeq as a valid bitString.",
      "source_rule_id": "rule-c5b80d5cddaf8560e0c97ce4ee0569156df290323257b2e7a88f6aed2b045736",
      "start_line": 29,
      "text": "  rule bitString(.IntSeq) => true\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "9bfddc4002c6cf1d546624d22bf4e4d0545cd6ce2634192b6b863fed85e46cc3",
      "rationale": "Structural recurrence defining bitString by checking that the head is code 48 or 49 and recursing on the tail.",
      "source_rule_id": "rule-9bfddc4002c6cf1d546624d22bf4e4d0545cd6ce2634192b6b863fed85e46cc3",
      "start_line": 31,
      "text": "  rule bitString(iCons(C:Int, CS:IntSeq))\n    => (C ==Int 48 orBool C ==Int 49) andBool bitString(CS)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "c2c382043eb8357e342d0d7f63c3918c98085483bf65f80ec57f2705b82b8e1d",
      "rationale": "Base equation defining lastX to preserve its prior value when the first zipped input is empty.",
      "source_rule_id": "rule-c2c382043eb8357e342d0d7f63c3918c98085483bf65f80ec57f2705b82b8e1d",
      "start_line": 38,
      "text": "  rule lastX(X:Val, .IntSeq, _:IntSeq) => X\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 41,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "cdf8b296f852901897f478149d8cc0e2369f5565f852d2245f671e3c988e15fc",
      "rationale": "Base equation defining lastX to preserve its prior value when only the second zipped input is empty.",
      "source_rule_id": "rule-cdf8b296f852901897f478149d8cc0e2369f5565f852d2245f671e3c988e15fc",
      "start_line": 40,
      "text": "  rule lastX(X:Val, iCons(_:Int, _:IntSeq), .IntSeq) => X\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 46,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "80cc1ed716ed43cab86c9e9426481924274d8925a9f8feb6463f566ed47baba0",
      "rationale": "Recursive lastX equation defining the latest left-hand loop target and descending through both zipped tails.",
      "source_rule_id": "rule-80cc1ed716ed43cab86c9e9426481924274d8925a9f8feb6463f566ed47baba0",
      "start_line": 42,
      "text": "  rule lastX(_:Val,\n             iCons(A:Int, AS:IntSeq),\n             iCons(_:Int, BS:IntSeq))\n    => lastX(str(iCons(A, .IntSeq)), AS, BS)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "4519e840f3abb9bc879fb9110ce9c189fdc58ee2a775aa03d25ed7ed89f9d224",
      "rationale": "Base equation defining lastY to preserve its prior value when the first zipped input is empty.",
      "source_rule_id": "rule-4519e840f3abb9bc879fb9110ce9c189fdc58ee2a775aa03d25ed7ed89f9d224",
      "start_line": 49,
      "text": "  rule lastY(Y:Val, .IntSeq, _:IntSeq) => Y\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 52,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "7904cb1a8bab042d3971f29ecc9168123382fe576dc0a2a5c47b80c78d036171",
      "rationale": "Base equation defining lastY to preserve its prior value when only the second zipped input is empty.",
      "source_rule_id": "rule-7904cb1a8bab042d3971f29ecc9168123382fe576dc0a2a5c47b80c78d036171",
      "start_line": 51,
      "text": "  rule lastY(Y:Val, iCons(_:Int, _:IntSeq), .IntSeq) => Y\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 57,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "5cceb78b618b0ccae42a64fb078067b800b9cc947d58a6f82b1cdab2b9aeff39",
      "rationale": "Recursive lastY equation defining the latest right-hand loop target and descending through both zipped tails.",
      "source_rule_id": "rule-5cceb78b618b0ccae42a64fb078067b800b9cc947d58a6f82b1cdab2b9aeff39",
      "start_line": 53,
      "text": "  rule lastY(_:Val,\n             iCons(_:Int, AS:IntSeq),\n             iCons(B:Int, BS:IntSeq))\n    => lastY(str(iCons(B, .IntSeq)), AS, BS)\n    [simplification]"
    }
  ],
