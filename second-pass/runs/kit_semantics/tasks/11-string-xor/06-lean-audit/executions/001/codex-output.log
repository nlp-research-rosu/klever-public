+        AugAssign(Name("result"), "+", Str("0")),
+        AugAssign(Name("result"), "+", Str("1"))))
+    Return(Name("result")))
+  Assert(Compare(Call(Name("string_xor"), Str(""), Str("101")),
+    CmpOp("==", Str(""))))
+  Assert(Compare(Call(Name("string_xor"), Str("101"), Str("")),
+    CmpOp("==", Str(""))))
+  Assert(Compare(Call(Name("string_xor"), Str("0"), Str("0")),
+    CmpOp("==", Str("0"))))
+  Assert(Compare(Call(Name("string_xor"), Str("1"), Str("0")),
+    CmpOp("==", Str("1"))))
+  Assert(Compare(Call(Name("string_xor"), Str("0101"), Str("1100")),
+    CmpOp("==", Str("1001"))))
+  Assert(Compare(Call(Name("string_xor"), Str("1011"), Str("01")),
+    CmpOp("==", Str("11"))))
+  Assert(Compare(Call(Name("string_xor"), Str("01"), Str("1011")),
+    CmpOp("==", Str("11"))))
+  Assert(Compare(Call(Name("string_xor"), Str("101"), Str("101")),
+    CmpOp("==", Str("000"))))
+  Assert(Compare(Call(Name("string_xor"), Str("ab"), Str("ac")),
+    CmpOp("==", Str("01")))))
