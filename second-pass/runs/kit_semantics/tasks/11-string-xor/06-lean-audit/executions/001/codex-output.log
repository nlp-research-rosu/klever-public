+  Assert(Compare(Call(Name("string_xor"), Str("0"), Str("0")),
+    CmpOp("==", Str("0"))))
+  Assert(Compare(Call(Name("string_xor"), Str("1"), Str("0")),
+    CmpOp("==", Str("1"))))
+  Assert(Compare(Call(Name("string_xor"), Str("0101"), Str("1100")),
