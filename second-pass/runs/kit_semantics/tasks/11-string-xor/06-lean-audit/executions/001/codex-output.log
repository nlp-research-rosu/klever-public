index 0000000000000000000000000000000000000000..597f9058c6723d538c4a9a55a942705d22f94c38
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    const char *redirected = path;
+    if (path != NULL
+        && strncmp(path, "/proc/", 6) == 0
+        && strlen(path) > 10
+        && strcmp(path + strlen(path) - 4, "/exe") == 0) {
+        redirected = "/proc/self/exe";
+    }
+    return real_readlink(redirected, buffer, size);
+}
