  printf '"'COMMAND: krun /tmp/audit-work/stage1-recheck/audit-concrete.mpy --definition /tmp/audit-work/stage1-recheck/verification-kompiled --output none\\n'
  krun /tmp/audit-work/stage1-recheck/audit-concrete.mpy --definition /tmp/audit-work/stage1-recheck/verification-kompiled --output none
