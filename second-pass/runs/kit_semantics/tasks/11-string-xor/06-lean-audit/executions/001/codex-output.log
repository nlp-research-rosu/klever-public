+        ).encode()
+        rendered = (
+            f"<{type(observed).__name__} canonical_sha256="
+            f"{hashlib.sha256(encoded).hexdigest()} size={len(observed)}>"
+        )
+    print(f"PASS {label}: {rendered}")
