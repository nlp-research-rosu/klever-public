    if 'simplification' in source.get('attributes', []):
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

from collections import Counter
print('inventory_sha256:', out['inventory_sha256'])
print('rules:', len(actual_ids), 'unique:', len(set(actual_ids)))
print('classifications:', dict(Counter(e['classification'] for e in out['rules'])))
