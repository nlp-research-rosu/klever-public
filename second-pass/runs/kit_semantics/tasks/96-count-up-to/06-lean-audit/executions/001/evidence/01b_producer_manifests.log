      "end_line": 30,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "8f1a14b0902a879bc6ead4dfee122e5e1265e10b0cbb88132187719ffbc45e74",
      "rationale": "Macro expansion defining the exact inner-loop body AST; it introduces a named proof term rather than an additional mathematical fact or execution rule.",
      "source_rule_id": "rule-8f1a14b0902a879bc6ead4dfee122e5e1265e10b0cbb88132187719ffbc45e74",
      "start_line": 24,
      "text": "  rule innerBody =>\n    If(Compare(BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n               CmpOp(\"==\", Int(0))),\n       Assign(Name(\"prime\"), Bool(false)) .Stmts,\n       .Stmts)\n    Assign(Name(\"divisor\"),\n           BinOp(\"+\", Name(\"divisor\"), Int(1))) .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 42,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "bdfc23acf9cf70adc41bad986933ed7277937929904f1669b00568437b1c3459",
      "rationale": "Macro expansion defining the exact outer-loop body AST from assignments, the inner loop, append, and candidate increment.",
      "source_rule_id": "rule-bdfc23acf9cf70adc41bad986933ed7277937929904f1669b00568437b1c3459",
      "start_line": 32,
      "text": "  rule outerBody =>\n    Assign(Name(\"divisor\"), Int(2))\n    Assign(Name(\"prime\"), Bool(true))\n    While(Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n          innerBody)\n    If(Name(\"prime\"),\n       Expr(Call(Attribute(Name(\"primes\"), \"append\"),\n                 Name(\"candidate\"))) .Stmts,\n       .Stmts)\n    Assign(Name(\"candidate\"),\n           BinOp(\"+\", Name(\"candidate\"), Int(1))) .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 54,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "83bcb3b74f0192957018f8be60acc9a6942a2a28da5d31b585070f5c00c88a41",
      "rationale": "Macro expansion defining the exact count_up_to function-body proof term used by the target claim.",
      "source_rule_id": "rule-83bcb3b74f0192957018f8be60acc9a6942a2a28da5d31b585070f5c00c88a41",
      "start_line": 44,
      "text": "  rule countBody =>\n    If(Compare(Name(\"n\"), CmpOp(\"<=\", Int(2))),\n       Return(ListExpr(.Exprs)) .Stmts,\n       .Stmts)\n    Assign(Name(\"primes\"), ListExpr(.Exprs))\n    Assign(Name(\"candidate\"), Int(2))\n    Assign(Name(\"divisor\"), Int(2))\n    Assign(Name(\"prime\"), Bool(true))\n    While(Compare(Name(\"candidate\"), CmpOp(\"<\", Name(\"n\"))),\n          outerBody)\n    Return(Name(\"primes\")) .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 67,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "e9dfcbb6e535df394027c53af10293b33882b5f5e9ba1c1f3ac059558bf60073",
      "rationale": "Validation-only macro expansion defining the start-at-3 mutated function body; it is still a named AST definition, not an operational model rule.",
      "source_rule_id": "rule-e9dfcbb6e535df394027c53af10293b33882b5f5e9ba1c1f3ac059558bf60073",
      "start_line": 57,
      "text": "  rule countBodyStart3 =>\n    If(Compare(Name(\"n\"), CmpOp(\"<=\", Int(2))),\n       Return(ListExpr(.Exprs)) .Stmts,\n       .Stmts)\n    Assign(Name(\"primes\"), ListExpr(.Exprs))\n    Assign(Name(\"candidate\"), Int(3))\n    Assign(Name(\"divisor\"), Int(2))\n    Assign(Name(\"prime\"), Bool(true))\n    While(Compare(Name(\"candidate\"), CmpOp(\"<\", Name(\"n\"))),\n          outerBody)\n    Return(Name(\"primes\")) .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 77,
      "module": "VERIFICATION",
      "normalized_sha256": "6c150dee4919f33b527576715d69f373b0c71d0bcdb234e310a360df2fec8cdb",
      "rationale": "Totalization equation for the noDivisors summary, normalizing divisor starts below 2 to the summary's lower bound.",
      "source_rule_id": "rule-6c150dee4919f33b527576715d69f373b0c71d0bcdb234e310a360df2fec8cdb",
      "start_line": 76,
      "text": "  rule noDivisors(N, D) => noDivisors(N, 2)\n    requires D <Int 2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 79,
      "module": "VERIFICATION",
      "normalized_sha256": "98cb7ce294f915ee8d7bd2cd06fc8ff072483b0e31e80bffd97c5cc1666119e2",
      "rationale": "Base equation of noDivisors: the divisor-search interval is empty once D is at least N.",
      "source_rule_id": "rule-98cb7ce294f915ee8d7bd2cd06fc8ff072483b0e31e80bffd97c5cc1666119e2",
      "start_line": 78,
      "text": "  rule noDivisors(N, D) => true\n    requires D >=Int 2 andBool D >=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 82,
      "module": "VERIFICATION",
      "normalized_sha256": "74f701962b96b34421e1e61caa390bd6effa656a436d73db49594f470a395d73",
      "rationale": "Defining false case of noDivisors when the current in-range divisor divides N.",
      "source_rule_id": "rule-74f701962b96b34421e1e61caa390bd6effa656a436d73db49594f470a395d73",
      "start_line": 80,
      "text": "  rule noDivisors(N, D) => false\n    requires D >=Int 2 andBool D <Int N\n     andBool pyMod(N, D) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 85,
      "module": "VERIFICATION",
      "normalized_sha256": "5ab72e98282a264da379bdd15a4b73e006eafa86706e62409af11679a1b2fc90",
      "rationale": "Recursive defining equation of noDivisors that advances past a non-dividing candidate.",
      "source_rule_id": "rule-5ab72e98282a264da379bdd15a4b73e006eafa86706e62409af11679a1b2fc90",
      "start_line": 83,
      "text": "  rule noDivisors(N, D) => noDivisors(N, D +Int 1)\n    requires D >=Int 2 andBool D <Int N\n     andBool pyMod(N, D) =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 88,
      "module": "VERIFICATION",
      "normalized_sha256": "7500a60cba5226d47db935faa305d04b568de603e6bcbbe4fb50cdb3e6fe5a5e",
      "rationale": "Base equation defining primesBetween as empty when the candidate has reached or passed the upper bound.",
      "source_rule_id": "rule-7500a60cba5226d47db935faa305d04b568de603e6bcbbe4fb50cdb3e6fe5a5e",
      "start_line": 87,
      "text": "  rule primesBetween(C, N) => .ValSeq\n    requires C >=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 91,
      "module": "VERIFICATION",
      "normalized_sha256": "7753d3ae7b9815bc5b6c497d902a9ef19ee9b4bcbef0e6265b813d6323a65fc4",
      "rationale": "Recursive defining equation that skips candidates below the minimum prime value 2.",
      "source_rule_id": "rule-7753d3ae7b9815bc5b6c497d902a9ef19ee9b4bcbef0e6265b813d6323a65fc4",
      "start_line": 89,
      "text": "  rule primesBetween(C, N)\n    => primesBetween(C +Int 1, N)\n    requires C <Int N andBool C <Int 2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 95,
      "module": "VERIFICATION",
      "normalized_sha256": "b48ae093ba4642f6355f72e334eb9498d3e367e9de1b7fe145c19823245aab0d",
      "rationale": "Recursive defining equation that includes an in-range candidate when the noDivisors summary classifies it as prime.",
      "source_rule_id": "rule-b48ae093ba4642f6355f72e334eb9498d3e367e9de1b7fe145c19823245aab0d",
      "start_line": 92,
      "text": "  rule primesBetween(C, N)\n    => vCons(C, primesBetween(C +Int 1, N))\n    requires C <Int N andBool C >=Int 2\n     andBool noDivisors(C, 2)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 99,
      "module": "VERIFICATION",
      "normalized_sha256": "5b03c31debf612c50d63a30dc6f22a243c0a65d1667904ed96c9ddf73fe77841",
      "rationale": "Recursive defining equation that skips an in-range candidate when noDivisors is false.",
      "source_rule_id": "rule-5b03c31debf612c50d63a30dc6f22a243c0a65d1667904ed96c9ddf73fe77841",
      "start_line": 96,
      "text": "  rule primesBetween(C, N)\n    => primesBetween(C +Int 1, N)\n    requires C <Int N andBool C >=Int 2\n     andBool notBool noDivisors(C, 2)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 102,
      "module": "VERIFICATION",
      "normalized_sha256": "d54ce4e171447b38c5db2843b98b90e45c2f0a13e8fa12a42a40543b9884e338",
      "rationale": "Base equation defining primesBelow as the empty sequence for upper bounds at most 2.",
      "source_rule_id": "rule-d54ce4e171447b38c5db2843b98b90e45c2f0a13e8fa12a42a40543b9884e338",
      "start_line": 101,
      "text": "  rule primesBelow(N) => .ValSeq\n    requires N <=Int 2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 104,
      "module": "VERIFICATION",
      "normalized_sha256": "1b022e4a8f2e4e270dcaafb81be7e8e8817e2b746fa792867025fdcc7280935f",
      "rationale": "Defining equation reducing primesBelow above 2 to the primesBetween summary beginning at 2.",
      "source_rule_id": "rule-1b022e4a8f2e4e270dcaafb81be7e8e8817e2b746fa792867025fdcc7280935f",
      "start_line": 103,
      "text": "  rule primesBelow(N) => primesBetween(2, N)\n    requires N >Int 2"
    }
