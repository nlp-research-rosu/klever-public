requires "reference-semantics/semantics.k"

module VERIFICATION-SYNTAX
  imports MPY-SYNTAX
  imports BOOL
  imports INT

  // noDivisors(N, D) is true exactly when no integer in [max(2,D), N)
  // divides N.  The D < 2 equation totalizes the mathematical function.
  syntax Bool ::= noDivisors(Int, Int) [function, total]

  // The ascending sequence of prime integers in [C, N), and its [2, N)
  // specialization used by count_up_to.
  syntax ValSeq ::= primesBetween(Int, Int) [function, total]
                  | primesBelow(Int)        [function, total]

  // Exact AST abbreviations copied from solution.mpy.  These are macros only:
  // they neither replace nor accelerate operational execution.
  syntax Stmts ::= "innerBody" [macro]
                 | "outerBody" [macro]
                 | "countBody" [macro]
                 | "countBodyStart3" [macro]

  rule innerBody =>
    If(Compare(BinOp("%", Name("candidate"), Name("divisor")),
               CmpOp("==", Int(0))),
       Assign(Name("prime"), Bool(false)) .Stmts,
       .Stmts)
    Assign(Name("divisor"),
           BinOp("+", Name("divisor"), Int(1))) .Stmts

  rule outerBody =>
    Assign(Name("divisor"), Int(2))
    Assign(Name("prime"), Bool(true))
    While(Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
          innerBody)
    If(Name("prime"),
       Expr(Call(Attribute(Name("primes"), "append"),
                 Name("candidate"))) .Stmts,
       .Stmts)
    Assign(Name("candidate"),
           BinOp("+", Name("candidate"), Int(1))) .Stmts

  rule countBody =>
    If(Compare(Name("n"), CmpOp("<=", Int(2))),
       Return(ListExpr(.Exprs)) .Stmts,
       .Stmts)
    Assign(Name("primes"), ListExpr(.Exprs))
    Assign(Name("candidate"), Int(2))
    Assign(Name("divisor"), Int(2))
    Assign(Name("prime"), Bool(true))
    While(Compare(Name("candidate"), CmpOp("<", Name("n"))),
          outerBody)
    Return(Name("primes")) .Stmts

  // Validation-only material mutation: skips candidate 2.
  rule countBodyStart3 =>
    If(Compare(Name("n"), CmpOp("<=", Int(2))),
       Return(ListExpr(.Exprs)) .Stmts,
       .Stmts)
    Assign(Name("primes"), ListExpr(.Exprs))
    Assign(Name("candidate"), Int(3))
    Assign(Name("divisor"), Int(2))
    Assign(Name("prime"), Bool(true))
    While(Compare(Name("candidate"), CmpOp("<", Name("n"))),
          outerBody)
    Return(Name("primes")) .Stmts
endmodule

module VERIFICATION
  imports MPY
  imports VERIFICATION-SYNTAX
  imports BOOL
  imports INT

  rule noDivisors(N, D) => noDivisors(N, 2)
    requires D <Int 2
  rule noDivisors(N, D) => true
    requires D >=Int 2 andBool D >=Int N
  rule noDivisors(N, D) => false
    requires D >=Int 2 andBool D <Int N
     andBool pyMod(N, D) ==Int 0
  rule noDivisors(N, D) => noDivisors(N, D +Int 1)
    requires D >=Int 2 andBool D <Int N
     andBool pyMod(N, D) =/=Int 0

  rule primesBetween(C, N) => .ValSeq
    requires C >=Int N
  rule primesBetween(C, N)
    => primesBetween(C +Int 1, N)
    requires C <Int N andBool C <Int 2
  rule primesBetween(C, N)
    => vCons(C, primesBetween(C +Int 1, N))
    requires C <Int N andBool C >=Int 2
     andBool noDivisors(C, 2)
  rule primesBetween(C, N)
    => primesBetween(C +Int 1, N)
    requires C <Int N andBool C >=Int 2
     andBool notBool noDivisors(C, 2)

  rule primesBelow(N) => .ValSeq
    requires N <=Int 2
  rule primesBelow(N) => primesBetween(2, N)
    requires N >Int 2

  // Derived by structural induction on A from MPY-LIST's two defining
  // equations for valSeqConcat.  Right association makes the outer-loop
  // accumulator obligation syntactically canonical.
  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
    => valSeqConcat(A, valSeqConcat(B, C))
    [simplification]
  rule valSeqConcat(A:ValSeq, .ValSeq) => A
    [simplification]
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Inner-loop invariant.  B records whether all already-visited divisors
  // preserved primality; the loop checks the remaining interval [D, C).
  claim [inner-loop]:
    <k>
      #while(Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
             innerBody)
      =>
      .K
      ...
    </k>
    <env> 1 </env>
    <scopes>
      -1 |-> builtinsScope
       0 |-> scope(M0:Map, parent(-1))
       1 |-> scope(
              "candidate" |-> C:Int
              "divisor"   |-> (D:Int => C)
              "n"         |-> N:Int
              "prime"     |-> (B:Bool => ?PB:Bool)
              "primes"    |-> ref(H:Int),
              parent(0))
    </scopes>
    <scopeLoc> 2 </scopeLoc>
    <heap> H |-> list(P:ValSeq) </heap>
    <heapLoc> HL:Int </heapLoc>
    <stack> STACK:List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires C >=Int 2 andBool D >=Int 2 andBool D <=Int C
    ensures  ?PB ==Bool (B andBool noDivisors(C, D))

  // Outer-loop invariant.  P is the already accumulated prefix; each
  // candidate contributes exactly when the inner invariant returns true.
  claim [outer-loop]:
    <k>
      #while(Compare(Name("candidate"), CmpOp("<", Name("n"))),
             outerBody)
      =>
      .K
      ...
    </k>
    <env> 1 </env>
    <scopes>
      -1 |-> builtinsScope
       0 |-> scope(M0:Map, parent(-1))
       1 |-> scope(
              "candidate" |-> (C:Int => N:Int)
              "divisor"   |-> (D:Int => N -Int 1)
              "n"         |-> N
              "prime"     |-> (B:Bool => ?PF:Bool)
              "primes"    |-> ref(H:Int),
              parent(0))
    </scopes>
    <scopeLoc> 2 </scopeLoc>
    <heap>
      H |-> list(P:ValSeq => valSeqConcat(P, primesBetween(C, N)))
    </heap>
    <heapLoc> HL:Int </heapLoc>
    <stack> STACK:List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires C >=Int 2 andBool C <Int N

  // Whole entry-point claim.  It executes the exact function definition and
  // binding, then invokes count_up_to from a fresh module configuration.
  claim [count-up-to]:
    <k>
      FuncDef("count_up_to", Params("n"), countBody)
      ~> Call(Name("count_up_to"), (N:Int, .Exprs))
      =>
      ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
       0 |-> scope(.Map => "count_up_to" |->
                    closureVal(("n", .ParamNames), countBody, 0),
                    parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => 0 |-> list(primesBelow(N)) </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 0
endmodule
def count_up_to(n):
    if n <= 2:
        return []

    primes = []
    candidate = 2
    divisor = 2
    prime = True

    while candidate < n:
        divisor = 2
        prime = True

        while divisor < candidate:
            if candidate % divisor == 0:
                prime = False
            divisor = divisor + 1

        if prime:
            primes.append(candidate)
        candidate = candidate + 1

    return primes

def count_up_to(n):
    """Implement a function that takes an non-negative integer and returns an array of the first n
    integers that are prime numbers and less than n.
    for example:
    count_up_to(5) => [2,3]
    count_up_to(11) => [2,3,5,7]
    count_up_to(0) => []
    count_up_to(20) => [2,3,5,7,11,13,17,19]
    count_up_to(1) => []
    count_up_to(18) => [2,3,5,7,11,13,17]
    """
