+    recorded_hashes["discovery_manifest_sha256"],
+)
+check(
+    "generator inventory provenance",
+    generator["provenance"]["inventory_sha256"],
+    inventory["inventory_sha256"],
+)
+check(
+    "input manifest Stage 1",
+    input_manifest["stage1_workspace_sha256"],
