+for label, passed, observed in checks:
+    print(f"{'PASS' if passed else 'FAIL'}: {label}")
+    if not passed:
+        failed = True
+        print(f"  observed={observed!r}")
+
+print(f"RESULT: {'FAIL' if failed else 'PASS'}")
+raise SystemExit(1 if failed else 0)

