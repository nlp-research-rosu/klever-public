index 0000000000000000000000000000000000000000..b19348c3ae7bf8fa382658dc550c67267404cb51
--- /dev/null
+++ b//tmp/audit-work/probe_exe.c
@@ -0,0 +1,20 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+    char proc_path[64];
+    char target[PATH_MAX];
+    snprintf(proc_path, sizeof(proc_path), "/proc/%d/exe", (int)getpid());
+    ssize_t size = readlink(proc_path, target, sizeof(target) - 1);
+    if (size < 0) {
+        fprintf(stderr, "readlink(%s): errno=%d %s\n", proc_path, errno, strerror(errno));
+        return 1;
+    }
+    target[size] = '\0';
+    printf("%s -> %s\n", proc_path, target);
+    return 0;
+}
diff --git a//tmp/audit-work/proc-self-readlink.c b//tmp/audit-work/proc-self-readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..3d2248385a0d7688ef758e541a2247218cda62e1
--- /dev/null
+++ b//tmp/audit-work/proc-self-readlink.c
@@ -0,0 +1,22 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    size_t length = strlen(path);
+    if (length > 10
+        && strncmp(path, "/proc/", 6) == 0
+        && strcmp(path + length - 4, "/exe") == 0
+        && strcmp(path, "/proc/self/exe") != 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
