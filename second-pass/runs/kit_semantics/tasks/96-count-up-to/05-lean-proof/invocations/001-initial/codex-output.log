+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  size_t path_length = strlen(path);
+  if (strncmp(path, "/proc/", 6) == 0
+      && path_length >= 10
+      && strcmp(path + path_length - 4, "/exe") == 0) {
+    const char *application = getenv("LEAN_APP_PATH");
