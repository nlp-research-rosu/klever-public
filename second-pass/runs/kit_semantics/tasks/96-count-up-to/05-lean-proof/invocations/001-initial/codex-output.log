diff --git a//tmp/lean_app_path_shim.c b//tmp/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..2b9a3f2ba35306a63e841a49b928a71d2a35a892
--- /dev/null
+++ b//tmp/lean_app_path_shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  size_t path_length = strlen(path);
+  if (strncmp(path, "/proc/", 6) == 0
+      && path_length >= 10
+      && strcmp(path + path_length - 4, "/exe") == 0) {
+    const char *application = getenv("LEAN_APP_PATH");
+    if (application != NULL) {
+      size_t length = strlen(application);
+      if (length > size) {
+        length = size;
+      }
+      memcpy(buffer, application, length);
+      return (ssize_t)length;
+    }
+  }
+  return syscall(SYS_readlink, path, buffer, size);
+}
