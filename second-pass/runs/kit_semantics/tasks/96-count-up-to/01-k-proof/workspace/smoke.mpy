Module(
  FuncDef("count_up_to", Params("n"),
    If(Compare(Name("n"), CmpOp("<=", Int(2))),
      Return(ListExpr()),
      )
    Assign(Name("primes"), ListExpr())
    Assign(Name("candidate"), Int(2))
    Assign(Name("divisor"), Int(2))
    Assign(Name("prime"), Bool(true))
    While(Compare(Name("candidate"), CmpOp("<", Name("n"))),
      Assign(Name("divisor"), Int(2))
      Assign(Name("prime"), Bool(true))
      While(Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
        If(Compare(
          BinOp("%", Name("candidate"), Name("divisor")),
          CmpOp("==", Int(0))),
          Assign(Name("prime"), Bool(false)),
          )
        Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
      If(Name("prime"),
        Expr(
          Call(Attribute(Name("primes"), "append"), Name("candidate"))),
        )
      Assign(Name("candidate"), BinOp("+", Name("candidate"), Int(1))))
    Return(Name("primes")))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(5)),
      CmpOp("==", ListExpr(Int(2), Int(3)))))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(11)),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(5), Int(7)))))
  Assert(
    Compare(Call(Name("count_up_to"), Int(0)), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(20)),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(3),
          Int(5),
          Int(7),
          Int(11),
          Int(13),
          Int(17),
          Int(19)))))
  Assert(
    Compare(Call(Name("count_up_to"), Int(1)), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(18)),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(3),
          Int(5),
          Int(7),
          Int(11),
          Int(13),
          Int(17))))))
