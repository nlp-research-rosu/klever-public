+              "n"         |-> N:Int
+              "prime"     |-> (B:Bool => B andBool noDivisors(C, D))
+              "primes"    |-> ref(H:Int),
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
