+              "divisor"   |-> (2 => 4)
+              "n"         |-> 5
+              "prime"     |-> (true => true)
+              "primes"    |-> ref(0),
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
