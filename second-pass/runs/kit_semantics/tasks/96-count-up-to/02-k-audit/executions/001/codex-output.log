+#!/usr/bin/env bash
+set -u
+set -o pipefail
+export PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '
+set -x
+
+sha256sum \
+  /audit-campaign-lock.json \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /reference/canonical.py \
+  /run.json \
+  /task.json \
