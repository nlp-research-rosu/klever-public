+timeout 300 krun reviewer-smoke.mpy \
+  --definition reviewer-runtime-kompiled
+echo "REVIEWER_SMOKE_KRUN_EXIT=$?"
+
+timeout 1200 kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
