+echo "MUTATED_PROGRAM_KAST_EXIT=$?"
+
+sha256sum reviewer-mutated-program.kore reviewer-solution-program.kore
+
+set +e
+cmp reviewer-mutated-program.kore reviewer-solution-program.kore
+mutated_cmp_rc=$?
