+            "runtime": run["runtime"],
+            "kit": run["kit"],
+        },
+        "task": task,
+        "generation_result": result,
+        "invocation": invocation,
+        "metrics": metrics,
+        "runtime_metrics": runtime,
+        "usage": usage,
