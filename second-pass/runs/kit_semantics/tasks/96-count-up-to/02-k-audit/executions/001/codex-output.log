+
+kast --definition reviewer-verification-kompiled \
+  --module VERIFICATION-SYNTAX \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  --expression 'Module(FuncDef("count_up_to", Params("n"), countBodyStart3))' \
