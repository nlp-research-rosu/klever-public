+  h.update(len(rel).to_bytes(8,"big")); h.update(rel)
+  h.update(len(body).to_bytes(8,"big")); h.update(body)
+ print(root, "reviewer_tree_sha256="+h.hexdigest(), "files="+str(len(files)))'
