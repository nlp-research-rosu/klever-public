root=Path('/generation-evidence/codex-trace'); entries=sorted(root.rglob('*'), key=lambda p:p.relative_to(root).as_posix()); exp='f2fbbca1277908d9d98fa493359d0567b7eb37e984aa87d83385cb251de7c312'
