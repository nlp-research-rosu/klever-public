index 0000000000000000000000000000000000000000..4e906a4eeada1ed7187b5cf6a79b88a4e02493a2
--- /dev/null
+++ b/evidence/rule_inventory.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -u
+
+roots=(
+  /reference/reference-semantics/semantics.k
+  /reference/reference-semantics/semantics
+  /candidate/verification.k
+  /candidate/spec.k
+)
+
+printf 'SOURCE FILES\n'
+find "${roots[@]}" -type f -name '*.k' -print | sort
+
+printf '\nDECLARATION COUNTS BY FILE\n'
+for file in $(find "${roots[@]}" -type f -name '*.k' -print | sort); do
+  modules="$(rg -c '^[[:space:]]*module[[:space:]]' "$file" || true)"
+  syntax="$(rg -c '^[[:space:]]*syntax([[:space:]]|$)' "$file" || true)"
+  rules="$(rg -c '^[[:space:]]*rule([[:space:]]|$)' "$file" || true)"
+  claims="$(rg -c '^[[:space:]]*claim([[:space:]]|$)' "$file" || true)"
+  configurations="$(rg -c '^[[:space:]]*configuration([[:space:]]|$)' "$file" || true)"
+  contexts="$(rg -c '^[[:space:]]*context([[:space:]]|$)' "$file" || true)"
+  printf '%s modules=%s syntax=%s rules=%s claims=%s configurations=%s contexts=%s\n' \
+    "$file" "${modules:-0}" "${syntax:-0}" "${rules:-0}" "${claims:-0}" \
+    "${configurations:-0}" "${contexts:-0}"
+done
+
+printf '\nEXHAUSTIVE DECLARATION STARTS\n'
+rg -n \
+  '^[[:space:]]*(module|endmodule|imports|requires|configuration|syntax|rule|claim|context|context alias|macro|alias)([[:space:]]|$)' \
+  "${roots[@]}" | sort
+
+printf '\nATTRIBUTES AND SPECIAL DECLARATIONS\n'
+rg -n \
+  '\[(function|total|functional|simplification|concrete|priority|priorities|owise|macro|alias|symbol|hook|anywhere|trusted)[^]]*\]|syntax priorities|syntax left|syntax right' \
+  "${roots[@]}" | sort
+
+printf '\nCANDIDATE PROOF-LOCAL INVENTORY\n'
+rg -n \
+  '^[[:space:]]*(syntax|rule|claim|configuration|context|macro|alias)([[:space:]]|$)|\[(function|total|functional|simplification|priority|owise|anywhere)[^]]*\]' \
+  /candidate/verification.k /candidate/spec.k | sort
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2ce07aaf2e9b58ab0a6cdf5802b2e6b818faf80d
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log="$1"
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+} | tee "$log"
+
+"$@" 2>&1 | tee -a "$log"
+command_status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %s\n' "$command_status" | tee -a "$log"
+exit "$command_status"
diff --git a/evidence/spec-audit-body-mutation.k b/evidence/spec-audit-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..c351efff1cd7831913cf85ffc3c2cfb455f63171
--- /dev/null
+++ b/evidence/spec-audit-body-mutation.k
@@ -0,0 +1,47 @@
+requires "spec.k"
+
+module SPEC-AUDIT-BODY-MUTATION
+  imports SPEC
+
+  // Fresh body-sensitivity probe: this changes the Return term actually bound
+  // in the closure from balance == 0 to balance == 1, while retaining the
+  // original empty-input obligation bracketCorrect(.IntSeq) == true.
+  claim [changed-return-comparison]:
+    <k>
+      Call(Name("correct_bracketing"), str(.IntSeq))
+      => ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(
+            ("brackets", .ParamNames),
+            Assign(Name("balance"), Int(0))
+            Assign(Name("valid"), Bool(true))
+            Assign(Name("bracket"), Str(""))
+            For(Name("bracket"), Name("brackets"),
+              If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Int(0))),
+                Assign(Name("valid"), Bool(false)),
+                .Stmts))
+            Return(
+              BoolOp(
+                "and",
+                Name("valid"),
+                Compare(Name("balance"), CmpOp("==", Int(1))))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?RESULT ==Bool bracketCorrect(.IntSeq)
+endmodule
diff --git a/evidence/spec-audit-vacuity.k b/evidence/spec-audit-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..33244f34429eff2a065f9e72223c96292efd3360
--- /dev/null
+++ b/evidence/spec-audit-vacuity.k
@@ -0,0 +1,46 @@
+requires "spec.k"
+
+module SPEC-AUDIT-VACUITY
+  imports SPEC
+
+  // Fresh reviewer mutation: "<>" satisfies bracketChars and the submitted
+  // function returns true, while this changed obligation requires false.
+  claim [false-result-balanced-pair]:
+    <k>
+      Call(Name("correct_bracketing"), str(iCons(60, iCons(62, .IntSeq))))
+      => ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(
+            ("brackets", .ParamNames),
+            Assign(Name("balance"), Int(0))
+            Assign(Name("valid"), Bool(true))
+            Assign(Name("bracket"), Str(""))
+            For(Name("bracket"), Name("brackets"),
+              If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Int(0))),
+                Assign(Name("valid"), Bool(false)),
+                .Stmts))
+            Return(
+              BoolOp(
+                "and",
+                Name("valid"),
