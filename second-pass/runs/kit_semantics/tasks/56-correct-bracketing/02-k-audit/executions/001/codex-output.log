    17	  syntax Bool ::= bracketPrefixOK(IntSeq, Int) [function, total]
    18	  rule bracketPrefixOK(.IntSeq, _BAL:Int) => true
    19	  rule bracketPrefixOK(iCons(C:Int, REST:IntSeq), BAL:Int)
    20	    => #if C ==Int 60
