Module(
  FuncDef("correct_bracketing", Params("brackets"),
    Assign(Name("balance"), Int(0))
    Assign(Name("valid"), Bool(true))
    Assign(Name("bracket"), Str(""))
    For(Name("bracket"), Name("brackets"),
      If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
        AugAssign(Name("balance"), "+", Int(1)),
        AugAssign(Name("balance"), "-", Int(1)))
      If(Compare(Name("balance"), CmpOp("<", Int(0))),
        Assign(Name("valid"), Bool(false)),
        ))
    Return(
      BoolOp(
        "and",
        Name("valid"),
        Compare(Name("balance"), CmpOp("==", Int(0))))))
  Assert(
    Compare(
      Call(Name("correct_bracketing"), Str("<")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("correct_bracketing"), Str("<>")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("correct_bracketing"), Str("<<><>>")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("correct_bracketing"), Str("><<>")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("correct_bracketing"), Str("")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("correct_bracketing"), Str("<<>>")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("correct_bracketing"), Str("<><>")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("correct_bracketing"), Str(">>")),
      CmpOp("==", Bool(false)))))
