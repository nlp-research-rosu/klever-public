{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "d41a7c26910af38bb78f1217c17a05fb4908c3fed5fa4ee9cf52a907efe9076e",
      "rationale": "Base equation defining the net bracket-balance delta of the empty IntSeq as zero.",
      "source_rule_id": "rule-d41a7c26910af38bb78f1217c17a05fb4908c3fed5fa4ee9cf52a907efe9076e",
      "start_line": 10,
      "text": "  rule bracketDelta(.IntSeq) => 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "6e139480c6d3c873164275a75006bf2c7de6128ebe1831dff691b7356d458245",
      "rationale": "Structural recurrence defining bracketDelta on iCons by adding +1 for code 60 and -1 otherwise, then recursing on the tail.",
      "source_rule_id": "rule-6e139480c6d3c873164275a75006bf2c7de6128ebe1831dff691b7356d458245",
      "start_line": 11,
      "text": "  rule bracketDelta(iCons(C:Int, REST:IntSeq))\n    => (#if C ==Int 60 #then 1 #else 0 -Int 1 #fi)\n       +Int bracketDelta(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "72a7f3bf2662beedba9a1783574ce1abf92a90c271d4654d1e77593de0e3a595",
      "rationale": "Base equation defining prefix safety of an empty suffix as true for any starting balance.",
      "source_rule_id": "rule-72a7f3bf2662beedba9a1783574ce1abf92a90c271d4654d1e77593de0e3a595",
      "start_line": 18,
      "text": "  rule bracketPrefixOK(.IntSeq, _BAL:Int) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "629a5508eaace33c393adaba948a78672ca9cab6968f8af11b634b57692c1d5d",
      "rationale": "Structural recurrence defining bracketPrefixOK by updating the balance, checking its nonnegativity, and recursing on the remaining codes.",
      "source_rule_id": "rule-629a5508eaace33c393adaba948a78672ca9cab6968f8af11b634b57692c1d5d",
      "start_line": 19,
      "text": "  rule bracketPrefixOK(iCons(C:Int, REST:IntSeq), BAL:Int)\n    => #if C ==Int 60\n       #then (BAL +Int 1 >=Int 0)\n             andBool bracketPrefixOK(REST, BAL +Int 1)\n       #else (BAL -Int 1 >=Int 0)\n             andBool bracketPrefixOK(REST, BAL -Int 1)\n       #fi"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "cf490f8754fe92929eaab0735f4ff5a17b4e27ba2daa08db685d19b50b42f655",
      "rationale": "Base equation defining the empty IntSeq as belonging to the bracket-character input domain.",
      "source_rule_id": "rule-cf490f8754fe92929eaab0735f4ff5a17b4e27ba2daa08db685d19b50b42f655",
      "start_line": 29,
      "text": "  rule bracketChars(.IntSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "c8a4addc9644eed5b1facf23847f2fc64e34e209298c664aa662eba0aed1237b",
      "rationale": "Structural recurrence defining bracketChars as membership of every code in the set containing 60 and 62.",
      "source_rule_id": "rule-c8a4addc9644eed5b1facf23847f2fc64e34e209298c664aa662eba0aed1237b",
      "start_line": 30,
      "text": "  rule bracketChars(iCons(C:Int, REST:IntSeq))\n    => (C ==Int 60 orBool C ==Int 62) andBool bracketChars(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "VERIFICATION",
      "normalized_sha256": "2a2831baeb8891ff1e832a3bbe0d70c052055c870fd80fa066e571f5296ae2af",
      "rationale": "Compositional equation defining bracketCorrect as prefix safety from balance zero together with zero final delta.",
      "source_rule_id": "rule-2a2831baeb8891ff1e832a3bbe0d70c052055c870fd80fa066e571f5296ae2af",
      "start_line": 34,
      "text": "  rule bracketCorrect(CODES:IntSeq)\n    => bracketPrefixOK(CODES, 0)\n       andBool bracketDelta(CODES) ==Int 0"
    }
  ],
