inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert set(out) == {'schema_version', 'inventory_sha256', 'rules'}
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
expected_ids = [r['source_rule_id'] for r in inv['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids))
by_id = {r['source_rule_id']: r for r in inv['rules']}
for entry in out['rules']:
    assert set(entry) == {'source_rule_id', 'classification', 'rationale'}
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
    if 'simplification' in by_id[entry['source_rule_id']].get('attributes', []):
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
from collections import Counter
print('rules', len(actual_ids))
print('classifications', dict(Counter(r['classification'] for r in out['rules'])))
print('inventory_order', actual_ids == expected_ids)
print('unique_ids', len(actual_ids) == len(set(actual_ids)))
print('schema_keys_exact', set(out) == {'schema_version', 'inventory_sha256', 'rules'})
print('entry_keys_exact', all(set(r) == {'source_rule_id', 'classification', 'rationale'} for r in out['rules']))
print('inventory_sha256', out['inventory_sha256'])
print('validation', 'PASS')
