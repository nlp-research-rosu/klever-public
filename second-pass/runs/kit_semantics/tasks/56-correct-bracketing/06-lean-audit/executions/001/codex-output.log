+    Path('/reference/klean-generation/generated'),
+):
+    print(f'pipeline_contract.sha256_tree({path}) = {sha256_tree(path)}')
+for path in (
+    Path('/reference/k-proof'),
+    Path('/reference/klean-generation/generated'),
