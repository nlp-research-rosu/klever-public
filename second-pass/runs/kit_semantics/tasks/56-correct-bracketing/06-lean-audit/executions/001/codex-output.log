+#!/usr/bin/env bash
+set -o errexit -o nounset -o pipefail
+
+printf 'COMMAND: printf AUDIT_MODE from environment\n'
+printf 'AUDIT_MODE=%s\n' "${AUDIT_MODE-<unset>}"
+
