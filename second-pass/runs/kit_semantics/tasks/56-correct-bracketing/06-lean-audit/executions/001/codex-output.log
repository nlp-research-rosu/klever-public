diff --git a/evidence/00_launcher_producer_and_hashes.sh b/evidence/00_launcher_producer_and_hashes.sh
new file mode 100644
index 0000000000000000000000000000000000000000..14744dd3dcdd2abf1be8aa6f1d3520e31c88da48
--- /dev/null
+++ b/evidence/00_launcher_producer_and_hashes.sh
@@ -0,0 +1,103 @@
+#!/usr/bin/env bash
+set -o errexit -o nounset -o pipefail
+
+printf 'COMMAND: printf AUDIT_MODE from environment\n'
+printf 'AUDIT_MODE=%s\n' "${AUDIT_MODE-<unset>}"
+
+printf '\nCOMMAND: test candidate presence and type\n'
+if [[ -e /candidate || -L /candidate ]]; then
+  stat -c 'candidate exists: type=%F mode=%a path=%n' /candidate
