+printf '\nCOMMAND: display Stage 4 generator manifest\n'
+python -m json.tool /reference/klean-generation/generator-manifest.json
+
+printf '\nCOMMAND: extract launcher producer/image/hash bindings\n'
+python - <<'PY'
+import json
