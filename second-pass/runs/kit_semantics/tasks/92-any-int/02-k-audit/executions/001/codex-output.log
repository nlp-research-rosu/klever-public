+if grep -q 'Constant complex' "$evidence/05_complex_gap_translator.log"; then
+  printf 'REPRESENTATION_GAP_RESULT: CONFIRMED_COMPLEX_UNREPRESENTABLE\n'
+  exit 0
+fi
+printf 'REPRESENTATION_GAP_RESULT: WRONG_FAILURE_MODE\n'
+exit 1

