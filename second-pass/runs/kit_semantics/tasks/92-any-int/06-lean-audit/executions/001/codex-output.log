codex
I found the precise container fault: processes receive namespace PIDs such as `5`, while `/proc/5/exe` is absent; Lean 4.22 resolves its executable through `/proc/<getpid()>/exe`, so both Lean and Lake fail despite `/proc/self/exe` being available. I’ll use a narrowly scoped, auditable preload shim only for these build commands that redirects that self-executable lookup to `/proc/self/exe`; no candidate or provenance file is changed.
apply patch
patch: completed
/tmp/audit-work/proc_self_readlink.c
diff --git a//tmp/audit-work/proc_self_readlink.c b//tmp/audit-work/proc_self_readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..55ae5068299afc340eeb35b69a0930cfc6751974
--- /dev/null
+++ b//tmp/audit-work/proc_self_readlink.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_pid_exe_path(const char *path) {
+    const char *cursor;
+
+    if (strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor = path + 6;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    const char *resolved = is_pid_exe_path(path) ? "/proc/self/exe" : path;
+    return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}

