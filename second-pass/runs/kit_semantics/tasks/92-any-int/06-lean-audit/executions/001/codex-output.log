@@ -0,0 +1,36 @@
+import Proof
+
+namespace BridgeAudit
+
+open Klean92AnyInt.Lemmas
+
+#eval (
+  Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» true,
+  Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» false
+)
+
+example :
+    Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» true = 1 := by
+  rfl
+
+example :
+    Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» false = 0 := by
+  rfl
+
+def constantZero : SortBool → SortInt := fun _ => 0
+def constantOne : SortBool → SortInt := fun _ => 1
+
+def swapped : SortBool → SortInt
+  | true => 0
+  | false => 1
+
+example : ¬ targetStatement constantZero := by
+  simp [targetStatement, constantZero, kite]
+
+example : ¬ targetStatement constantOne := by
+  simp [targetStatement, constantOne, kite]
+
+example : ¬ targetStatement swapped := by
+  simp [targetStatement, swapped, kite]
+
+end BridgeAudit
diff --git a//tmp/audit-work/proc_self_readlink.c b//tmp/audit-work/proc_self_readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..6b390ef25d23cf493026c64726b1f8f4b318c79b
--- /dev/null
+++ b//tmp/audit-work/proc_self_readlink.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_pid_exe_path(const char *path) {
+    const char *cursor;
+
+    if (strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor = path + 6;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    const char *resolved = is_pid_exe_path(path) ? "/proc/self/exe" : path;
+    return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}

