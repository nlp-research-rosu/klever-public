--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit.rXzvVA/BridgeAudit.lean
@@ -0,0 +1,36 @@
+import Proof
+
+namespace BridgeAudit
+
+open Klean92AnyInt.Lemmas
+
+#eval (
+  Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» true,
+  Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» false
+)
+
+example :
+    Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» true = 1 := by
+  rfl
+
+example :
+    Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» false = 0 := by
+  rfl
+
+def constantZero : SortBool → SortInt := fun _ => 0
+def constantOne : SortBool → SortInt := fun _ => 1
+
+def swapped : SortBool → SortInt
+  | true => 0
+  | false => 1
+
+example : ¬ targetStatement constantZero := by
+  simp [targetStatement, constantZero, kite]
+
+example : ¬ targetStatement constantOne := by
+  simp [targetStatement, constantOne, kite]
+
+example : ¬ targetStatement swapped := by
+  simp [targetStatement, swapped, kite]
+
+end BridgeAudit
