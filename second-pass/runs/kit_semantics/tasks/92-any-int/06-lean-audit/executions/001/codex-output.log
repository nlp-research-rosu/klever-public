--- /dev/null
+++ b//tmp/audit-work/bridge-witnesses.mpy
@@ -0,0 +1,27 @@
+Module(
+  FuncDef("any_int", Params("x", "y", "z"),
+    Return(
+      BoolOp(
+        "and",
+        Call(Name("isinstance"), Name("x"), Name("int")),
+        Call(Name("isinstance"), Name("y"), Name("int")),
+        Call(Name("isinstance"), Name("z"), Name("int")),
+        BoolOp(
+          "or",
+          Compare(
+            BinOp("+", Name("x"), Name("y")),
+            CmpOp("==", Name("z"))),
+          Compare(
+            BinOp("+", Name("x"), Name("z")),
+            CmpOp("==", Name("y"))),
+          Compare(
+            BinOp("+", Name("y"), Name("z")),
+            CmpOp("==", Name("x")))))))
+  Assert(
+    Compare(
+      Call(Name("any_int"), Bool(true), Int(2), Int(2)),
+      CmpOp("==", Bool(false))))
+  Assert(
+    Compare(
+      Call(Name("any_int"), Bool(false), Int(1), Int(1)),
+      CmpOp("==", Bool(true)))))
