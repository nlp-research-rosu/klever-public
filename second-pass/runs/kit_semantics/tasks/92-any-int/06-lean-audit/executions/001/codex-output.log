+import Proof
+
+namespace BridgeAudit
+
+open Klean92AnyInt.Lemmas
+
+#eval (
+  Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» true,
+  Proof.«boolAsInt(_)_MPY-CORE_Int_Bool» false
