+            BinOp("+", Name("y"), Name("z")),
+            CmpOp("==", Name("x")))))))
+  Assert(
+    Compare(
+      Call(Name("any_int"), Bool(true), Int(2), Int(2)),
+      CmpOp("==", Bool(false))))
+  Assert(
+    Compare(
+      Call(Name("any_int"), Bool(false), Int(1), Int(1)),
+      CmpOp("==", Bool(true)))))
