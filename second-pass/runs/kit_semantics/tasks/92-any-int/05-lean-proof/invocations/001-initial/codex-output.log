+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+
+extern char *program_invocation_name;
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    size_t path_len = strlen(path);
+    if (strncmp(path, "/proc/", 6) == 0
+        && path_len >= 4
+        && strcmp(path + path_len - 4, "/exe") == 0) {
+        const char *app = program_invocation_name;
+        char absolute_app[4096];
+        if (strchr(app, '/') == NULL) {
+            const char *sysroot = getenv("LEAN_SYSROOT");
+            if (sysroot != NULL) {
+                snprintf(absolute_app, sizeof absolute_app, "%s/bin/%s",
+                         sysroot, app);
+                app = absolute_app;
+            }
+        }
+        size_t app_len = strlen(app);
+        size_t copied = app_len < size ? app_len : size;
+        memcpy(buffer, app, copied);
+        return (ssize_t)copied;
+    }
+
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    return real_readlink(path, buffer, size);
+}
