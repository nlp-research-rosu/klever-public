+  claim [int-bool-float]:
+    <k> AnyIntCall(X:Int, Y:Bool, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [bool-int-float]:
+    <k> AnyIntCall(X:Bool, Y:Int, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [bool-bool-float]:
+    <k> AnyIntCall(X:Bool, Y:Bool, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..de50afdf5e263b24dc4ae5583560ce82de4e84a2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,50 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+  imports BOOL
+  imports INT
+
+  // A parse-time abbreviation for the exact translated function invocation.
+  // It expands before the executable K definition is generated.
+  syntax Expr ::= "AnyIntCall" "(" Val "," Val "," Val ")" [macro]
+  rule AnyIntCall(X:Val, Y:Val, Z:Val)
+    => Call(
+         closureVal(
+           ("x", "y", "z"),
+           Return(
+             BoolOp(
+               "and",
+               ( Call(Name("isinstance"), (Name("x"), Name("int")))
+               , Call(Name("isinstance"), (Name("y"), Name("int")))
+               , Call(Name("isinstance"), (Name("z"), Name("int")))
+               , BoolOp(
+                   "or",
+                   ( Compare(BinOp("+", Name("x"), Name("y")), CmpOp("==", Name("z")))
+                   , Compare(BinOp("+", Name("x"), Name("z")), CmpOp("==", Name("y")))
+                   , Compare(BinOp("+", Name("y"), Name("z")), CmpOp("==", Name("x")))
+                   )
+                 )
+               )
+             )
+           ) .Stmts,
+           0
+         ),
+         (X, Y, Z)
+       )
+    [macro]
+
+  // The mathematical predicate named by the HumanEval contract.
+  syntax Bool ::= anySum(Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule anySum(X:Int, Y:Int, Z:Int)
+    => ((X +Int Y) ==Int Z)
+       orBool ((X +Int Z) ==Int Y)
+       orBool ((Y +Int Z) ==Int X)
+endmodule

