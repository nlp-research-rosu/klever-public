+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [int-bool-float]:
+    <k> AnyIntCall(X:Int, Y:Bool, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> anyIntModuleScope
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [bool-int-float]:
+    <k> AnyIntCall(X:Bool, Y:Int, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> anyIntModuleScope
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [bool-bool-float]:
+    <k> AnyIntCall(X:Bool, Y:Bool, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> anyIntModuleScope
