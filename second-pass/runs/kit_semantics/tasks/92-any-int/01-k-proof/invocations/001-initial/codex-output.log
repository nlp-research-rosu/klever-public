diff --git a/verification-mutant.k b/verification-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..d7d3df846fcb19cf421529ee73eb415eaba68559
--- /dev/null
+++ b/verification-mutant.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-MUTANT-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+
+  // Deliberate body mutation: the final disjunct is always false instead of
+  // checking y + z == x.
+  syntax Expr ::= "AnyIntCallMutant" "(" Val "," Val "," Val ")" [macro]
+  rule AnyIntCallMutant(X:Val, Y:Val, Z:Val)
+    => Call(
+         closureVal(
+           ("x", "y", "z"),
+           Return(
+             BoolOp(
+               "and",
+               ( Call(Name("isinstance"), (Name("x"), Name("int")))
+               , Call(Name("isinstance"), (Name("y"), Name("int")))
+               , Call(Name("isinstance"), (Name("z"), Name("int")))
+               , BoolOp(
+                   "or",
+                   ( Compare(BinOp("+", Name("x"), Name("y")), CmpOp("==", Name("z")))
+                   , Compare(BinOp("+", Name("x"), Name("z")), CmpOp("==", Name("y")))
+                   , Bool(false)
+                   )
+                 )
+               )
+             )
+           ) .Stmts,
+           0
+         ),
+         (X, Y, Z)
+       )
+endmodule
+
+module VERIFICATION-MUTANT
+  imports MPY
+  imports VERIFICATION-MUTANT-SYNTAX
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bb9b0115f5366cf8cef0b7dc065c0cbabbdb59f1
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,55 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+  imports BOOL
+  imports INT
+
+  // A parse-time abbreviation for the exact translated function invocation.
+  // It expands before the executable K definition is generated.
+  syntax Expr ::= "AnyIntCall" "(" Val "," Val "," Val ")" [macro]
+  rule AnyIntCall(X:Val, Y:Val, Z:Val)
+    => Call(
+         closureVal(
+           ("x", "y", "z"),
+           Return(
+             BoolOp(
+               "and",
+               ( Call(Name("isinstance"), (Name("x"), Name("int")))
+               , Call(Name("isinstance"), (Name("y"), Name("int")))
+               , Call(Name("isinstance"), (Name("z"), Name("int")))
+               , BoolOp(
+                   "or",
+                   ( Compare(BinOp("+", Name("x"), Name("y")), CmpOp("==", Name("z")))
+                   , Compare(BinOp("+", Name("x"), Name("z")), CmpOp("==", Name("y")))
+                   , Compare(BinOp("+", Name("y"), Name("z")), CmpOp("==", Name("x")))
+                   )
+                 )
+               )
+             )
+           ) .Stmts,
+           0
+         ),
+         (X, Y, Z)
+       )
+
+  // The mathematical predicate named by the HumanEval contract.
+  syntax Bool ::= anySum(Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Derived from the two exhaustive fixed-semantics equations
+  // boolAsInt(true) = 1 and boolAsInt(false) = 0.
+  rule boolAsInt(B:Bool)
+    => #if B #then 1 #else 0 #fi
+    [simplification]
+
+  rule anySum(X:Int, Y:Int, Z:Int)
+    => ((X +Int Y) ==Int Z)
+       orBool ((X +Int Z) ==Int Y)
+       orBool ((Y +Int Z) ==Int X)
+endmodule

codex
The extension audit found one fidelity improvement worth making before final validation: the symbolic call should resolve the actual `any_int` binding, not begin from an already-selected closure. I’m tightening the claim configuration so it starts after module loading with `any_int` bound to the exact translated body, then executes `Call(Name("any_int"), ...)` through ordinary lookup. This is the Gate A repair path; I’ll discard the earlier `#Top` and rerun all checks.
apply patch
