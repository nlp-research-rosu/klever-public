diff --git a/verification-mutant.k b/verification-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..d7d3df846fcb19cf421529ee73eb415eaba68559
--- /dev/null
+++ b/verification-mutant.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-MUTANT-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+
+  // Deliberate body mutation: the final disjunct is always false instead of
+  // checking y + z == x.
+  syntax Expr ::= "AnyIntCallMutant" "(" Val "," Val "," Val ")" [macro]
+  rule AnyIntCallMutant(X:Val, Y:Val, Z:Val)
+    => Call(
+         closureVal(
+           ("x", "y", "z"),
+           Return(
+             BoolOp(
+               "and",
+               ( Call(Name("isinstance"), (Name("x"), Name("int")))
+               , Call(Name("isinstance"), (Name("y"), Name("int")))
+               , Call(Name("isinstance"), (Name("z"), Name("int")))
+               , BoolOp(
+                   "or",
+                   ( Compare(BinOp("+", Name("x"), Name("y")), CmpOp("==", Name("z")))
+                   , Compare(BinOp("+", Name("x"), Name("z")), CmpOp("==", Name("y")))
+                   , Bool(false)
+                   )
+                 )
+               )
+             )
+           ) .Stmts,
+           0
+         ),
+         (X, Y, Z)
+       )
+endmodule
+
+module VERIFICATION-MUTANT
+  imports MPY
+  imports VERIFICATION-MUTANT-SYNTAX
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..69bfbfa8409ebd97d03d2c6b8cb71a5ee119d710
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,60 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+  imports BOOL
+  imports INT
+
+  // Parse-time abbreviations for the loaded module binding and invocation.
+  // They expand before the executable K definition is generated.
+  syntax Expr ::= "AnyIntCall" "(" Val "," Val "," Val ")" [macro]
+  rule AnyIntCall(X:Val, Y:Val, Z:Val)
+    => Call(Name("any_int"), (X, Y, Z))
+
+  syntax Scope ::= "anyIntModuleScope" [macro]
+  rule anyIntModuleScope
+    => scope(
+         "any_int" |->
+           closureVal(
+             ("x", "y", "z"),
+             Return(
+               BoolOp(
+                 "and",
+                 ( Call(Name("isinstance"), (Name("x"), Name("int")))
+                 , Call(Name("isinstance"), (Name("y"), Name("int")))
+                 , Call(Name("isinstance"), (Name("z"), Name("int")))
+                 , BoolOp(
+                     "or",
+                     ( Compare(BinOp("+", Name("x"), Name("y")), CmpOp("==", Name("z")))
+                     , Compare(BinOp("+", Name("x"), Name("z")), CmpOp("==", Name("y")))
+                     , Compare(BinOp("+", Name("y"), Name("z")), CmpOp("==", Name("x")))
+                     )
+                   )
+                 )
+               )
+             ) .Stmts,
+             0
+           ),
+         parent(-1)
+       )
+
+  // The mathematical predicate named by the HumanEval contract.
+  syntax Bool ::= anySum(Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Derived from the two exhaustive fixed-semantics equations
+  // boolAsInt(true) = 1 and boolAsInt(false) = 0.
+  rule boolAsInt(B:Bool)
+    => #if B #then 1 #else 0 #fi
+    [simplification]
+
+  rule anySum(X:Int, Y:Int, Z:Int)
+    => ((X +Int Y) ==Int Z)
+       orBool ((X +Int Z) ==Int Y)
+       orBool ((Y +Int Z) ==Int X)
+endmodule

apply patch
patch: completed
/workspace/spec-mutant.k
/workspace/verification-mutant.k
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..4834e75b6fb94c7e1029dff5cb7d5034383c61df
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,15 @@
+def any_int(x, y, z):
+    return (
+        isinstance(x, int)
+        and isinstance(y, int)
+        and isinstance(z, int)
+        and (x + y == z or x + z == y or y + z == x)
+    )
+
+
+assert any_int(5, 2, 7) == True
+assert any_int(3, 2, 2) == False
+assert any_int(3, -2, 1) == True
+assert any_int(3.6, -2.2, 2) == False
+assert any_int(True, 2, 3) == True
+assert any_int(False, 0, 0) == True
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..3b7a0d710b207206fdefb0bccdd4075e1d5bcd29
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,46 @@
+from itertools import product
+
+from solution import any_int
+
+
+def oracle(x, y, z):
+    if not all(isinstance(value, int) for value in (x, y, z)):
+        return False
+
+    values = (x, y, z)
+    for target_index in range(3):
+        target = values[target_index]
+        other_total = sum(
+            value
+            for index, value in enumerate(values)
+            if index != target_index
+        )
+        if target == other_total:
+            return True
+    return False
+
+
+integer_cases = list(product(range(-5, 6), repeat=3))
+boolean_cases = list(product((False, True), repeat=3))
+
+float_values = (-3.5, -2.0, -0.0, 0.5, 2.0, 3.5)
+float_cases = []
+for position in range(3):
+    for floating in float_values:
+        for left, right in product(range(-2, 3), repeat=2):
+            args = [left, right]
+            args.insert(position, floating)
+            float_cases.append(tuple(args))
+
+cases = integer_cases + boolean_cases + float_cases
+mismatches = [
+    (args, any_int(*args), oracle(*args))
+    for args in cases
+    if any_int(*args) != oracle(*args)
+]
+
+print(f"cases={len(cases)} mismatches={len(mismatches)}")
+if mismatches:
+    for mismatch in mismatches[:10]:
+        print(mismatch)
+    raise SystemExit(1)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..cbc38494f20788456a78be3a44f8f12cd10ca134
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -eu
+
+# Recreate the translated deliverable from the submitted implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Concrete execution under the required LLVM main module.
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete_tests.mpy --definition runtime-kompiled
+
+# Required symbolic target proof: every claim in SPEC is selected.
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+# Independent finite differential evidence.
+python3 differential_test.py
+
+# Gate A5: the deliberately false postcondition must be rejected.
+if kprove spec-vacuity.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY; then
+  echo "ERROR: false-postcondition probe unexpectedly proved"
+  exit 1
+else
+  status=$?
+  echo "EXPECTED FAILURE: false-postcondition probe exited ${status}"
+fi
+
+# Gate A1: a material body mutation must invalidate its witness.
+kompile --backend haskell verification-mutant.k \
+  --main-module VERIFICATION-MUTANT \
+  --syntax-module MPY-SYNTAX \
+  --output-definition mutant-kompiled
+if kprove spec-mutant.k \
+    --definition mutant-kompiled \
+    --spec-module SPEC-MUTANT; then
+  echo "ERROR: body-mutation probe unexpectedly proved"
+  exit 1
+else
+  status=$?
+  echo "EXPECTED FAILURE: body-mutation probe exited ${status}"
+fi
