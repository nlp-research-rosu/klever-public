@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: any_int(5, 2, 7) returns true.
+  claim [false-postcondition]:
+    <k> AnyIntCall(5, 2, 7) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..be0662e3abca9fc12ea9b736391ddfcee3c7e89a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,212 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // These eight claims cover every combination accepted by isinstance(_, int)
+  // in the supplied semantics: unbounded Int values and both Bool values.
+  claim [int-int-int]:
+    <k> AnyIntCall(X:Int, Y:Int, Z:Int) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(X, Y, Z)
+
+  claim [int-int-bool]:
+    <k> AnyIntCall(X:Int, Y:Int, Z:Bool) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(X, Y, boolAsInt(Z))
+
+  claim [int-bool-int]:
+    <k> AnyIntCall(X:Int, Y:Bool, Z:Int) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(X, boolAsInt(Y), Z)
+
+  claim [int-bool-bool]:
+    <k> AnyIntCall(X:Int, Y:Bool, Z:Bool) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(X, boolAsInt(Y), boolAsInt(Z))
+
+  claim [bool-int-int]:
+    <k> AnyIntCall(X:Bool, Y:Int, Z:Int) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(boolAsInt(X), Y, Z)
+
+  claim [bool-int-bool]:
+    <k> AnyIntCall(X:Bool, Y:Int, Z:Bool) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(boolAsInt(X), Y, boolAsInt(Z))
+
+  claim [bool-bool-int]:
+    <k> AnyIntCall(X:Bool, Y:Bool, Z:Int) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(boolAsInt(X), boolAsInt(Y), Z)
+
+  claim [bool-bool-bool]:
+    <k> AnyIntCall(X:Bool, Y:Bool, Z:Bool) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(boolAsInt(X), boolAsInt(Y), boolAsInt(Z))
+
+  // A Float is not an int.  Short-circuiting means later arguments remain
+  // arbitrary values once the first failing isinstance check is reached.
+  claim [float-any-any]:
+    <k> AnyIntCall(X:Float, Y:Val, Z:Val) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [int-float-any]:
+    <k> AnyIntCall(X:Int, Y:Float, Z:Val) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [bool-float-any]:
+    <k> AnyIntCall(X:Bool, Y:Float, Z:Val) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [int-int-float]:
+    <k> AnyIntCall(X:Int, Y:Int, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [int-bool-float]:
+    <k> AnyIntCall(X:Int, Y:Bool, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [bool-int-float]:
+    <k> AnyIntCall(X:Bool, Y:Int, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [bool-bool-float]:
+    <k> AnyIntCall(X:Bool, Y:Bool, Z:Float) => false </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
