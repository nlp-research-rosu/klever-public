+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [int-int-float]:
+    <k> AnyIntCall(X:Int, Y:Int, Z:Float) => false </k>
