+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(boolAsInt(X), Y, Z)
+
+  claim [bool-int-bool]:
+    <k> AnyIntCall(X:Bool, Y:Int, Z:Bool) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(boolAsInt(X), Y, boolAsInt(Z))
+
+  claim [bool-bool-int]:
+    <k> AnyIntCall(X:Bool, Y:Bool, Z:Int) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(boolAsInt(X), boolAsInt(Y), Z)
+
+  claim [bool-bool-bool]:
+    <k> AnyIntCall(X:Bool, Y:Bool, Z:Bool) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(boolAsInt(X), boolAsInt(Y), boolAsInt(Z))
