diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..09f6663505d1a95b34beac8771fad5a27af2117f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,49 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+  imports BOOL
+  imports INT
+
+  // A parse-time abbreviation for the exact translated function invocation.
+  // It expands before the executable K definition is generated.
+  syntax Expr ::= "AnyIntCall" "(" Val "," Val "," Val ")" [macro]
+  rule AnyIntCall(X:Val, Y:Val, Z:Val)
+    => Call(
+         closureVal(
+           ("x", "y", "z"),
+           Return(
+             BoolOp(
+               "and",
+               ( Call(Name("isinstance"), (Name("x"), Name("int")))
+               , Call(Name("isinstance"), (Name("y"), Name("int")))
+               , Call(Name("isinstance"), (Name("z"), Name("int")))
+               , BoolOp(
+                   "or",
+                   ( Compare(BinOp("+", Name("x"), Name("y")), CmpOp("==", Name("z")))
+                   , Compare(BinOp("+", Name("x"), Name("z")), CmpOp("==", Name("y")))
+                   , Compare(BinOp("+", Name("y"), Name("z")), CmpOp("==", Name("x")))
+                   )
+                 )
+               )
+             )
+           ) .Stmts,
+           0
+         ),
+         (X, Y, Z)
+       )
+
+  // The mathematical predicate named by the HumanEval contract.
+  syntax Bool ::= anySum(Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule anySum(X:Int, Y:Int, Z:Int)
+    => ((X +Int Y) ==Int Z)
+       orBool ((X +Int Z) ==Int Y)
+       orBool ((Y +Int Z) ==Int X)
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..4834e75b6fb94c7e1029dff5cb7d5034383c61df
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,15 @@
+def any_int(x, y, z):
+    return (
+        isinstance(x, int)
+        and isinstance(y, int)
+        and isinstance(z, int)
+        and (x + y == z or x + z == y or y + z == x)
+    )
+
+
+assert any_int(5, 2, 7) == True
+assert any_int(3, 2, 2) == False
+assert any_int(3, -2, 1) == True
+assert any_int(3.6, -2.2, 2) == False
+assert any_int(True, 2, 3) == True
+assert any_int(False, 0, 0) == True
