+    <scopes> 0 |-> anyIntModuleScope
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(X, Y, boolAsInt(Z))
+
+  claim [int-bool-int]:
+    <k> AnyIntCall(X:Int, Y:Bool, Z:Int) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> anyIntModuleScope
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool anySum(X, boolAsInt(Y), Z)
+
+  claim [int-bool-bool]:
+    <k> AnyIntCall(X:Int, Y:Bool, Z:Bool) => ?R:Bool </k>
+    <env> 0 </env>
+    <scopes> 0 |-> anyIntModuleScope
+              -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
