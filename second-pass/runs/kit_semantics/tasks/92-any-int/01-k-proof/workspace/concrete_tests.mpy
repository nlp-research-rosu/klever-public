Module(
  FuncDef("any_int", Params("x", "y", "z"),
    Return(
      BoolOp(
        "and",
        Call(Name("isinstance"), Name("x"), Name("int")),
        Call(Name("isinstance"), Name("y"), Name("int")),
        Call(Name("isinstance"), Name("z"), Name("int")),
        BoolOp(
          "or",
          Compare(
            BinOp("+", Name("x"), Name("y")),
            CmpOp("==", Name("z"))),
          Compare(
            BinOp("+", Name("x"), Name("z")),
            CmpOp("==", Name("y"))),
          Compare(
            BinOp("+", Name("y"), Name("z")),
            CmpOp("==", Name("x")))))))
  Assert(
    Compare(
      Call(Name("any_int"), Int(5), Int(2), Int(7)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("any_int"), Int(3), Int(2), Int(2)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("any_int"), Int(3), UnaryOp("-", Int(2)), Int(1)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("any_int"),
        Float(3.6),
        UnaryOp("-", Float(2.2)),
        Int(2)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("any_int"), Bool(true), Int(2), Int(3)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("any_int"), Bool(false), Int(0), Int(0)),
      CmpOp("==", Bool(true)))))
