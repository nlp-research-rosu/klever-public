OUTPUT_DIR="${AUDIT_OUTPUT_DIR:-/audit-output}"
WORK_DIR="${AUDIT_WORK_DIR:-/tmp/audit-work}"
SUPERVISOR_PARENT="${AUDIT_SUPERVISOR_PARENT:-$HOME}"
