+              Compare(
+                Call(Name("len"), Name("string")),
+                CmpOp("<", Call(Name("len"), Name("result")))
+              ),
+              Assign(Name("result"), Name("string")),
+              .Stmts
+            )
+          )
+          Return(Name("result"))
+        )
+      ))
+      ~> Call(
+           Name("longest"),
+           list(
+             vCons(
+               str(iCons(97, .IntSeq)),
+               vCons(str(iCons(98, iCons(98, .IntSeq))), .ValSeq)
+             )
+           )
+         )
+      => str(iCons(98, iCons(98, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?_FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
