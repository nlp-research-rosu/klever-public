      "start_line": 10,
      "text": "  rule isStringValue(_:Val) => false [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "3b8505c6c0b4c58fd103639c3144a8b121ca1f368bc7d48a365acfc91ef3978f",
      "rationale": "Base equation defining the allStrings structural predicate on the empty sequence.",
      "source_rule_id": "rule-3b8505c6c0b4c58fd103639c3144a8b121ca1f368bc7d48a365acfc91ef3978f",
      "start_line": 13,
      "text": "  rule allStrings(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "8fb391a89f4488d7792eaec4bbb3f24fb97e84cc29f9b339c2673393e3e6b042",
      "rationale": "Recursive equation defining allStrings by the head predicate and structurally smaller tail.",
      "source_rule_id": "rule-8fb391a89f4488d7792eaec4bbb3f24fb97e84cc29f9b339c2673393e3e6b042",
      "start_line": 14,
      "text": "  rule allStrings(vCons(V:Val, REST:ValSeq))\n    => isStringValue(V) andBool allStrings(REST)"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 29,
