      "end_line": 66,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "696f55b6c3717ef7832d3d737d92ef93689d3588d5c128f147ad3c6bdfd93188",
      "rationale": "Guarded equation defining longestValue on a nonempty sequence whose head is a string value.",
      "source_rule_id": "rule-696f55b6c3717ef7832d3d737d92ef93689d3588d5c128f147ad3c6bdfd93188",
      "start_line": 64,
      "text": "  rule longestValue(vCons(V:Val, REST:ValSeq))\n    => scanLongest(vCons(V, REST), V)\n    requires isStringValue(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 68,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "289d6332aec828df48f4c6f5bcd74e9df758222de0f8304e3653d5b77ed7c4cd",
      "rationale": "Complementary totalization equation defining longestValue outside the intended string-head domain.",
      "source_rule_id": "rule-289d6332aec828df48f4c6f5bcd74e9df758222de0f8304e3653d5b77ed7c4cd",
      "start_line": 67,
      "text": "  rule longestValue(vCons(V:Val, _:ValSeq)) => noneV\n    requires notBool isStringValue(V)"
    }
