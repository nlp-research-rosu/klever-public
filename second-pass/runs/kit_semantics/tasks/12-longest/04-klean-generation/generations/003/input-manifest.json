      "rationale": "Base equation defining the scanLongest fold on an empty remaining sequence.",
      "source_rule_id": "rule-3783aed79e6a454808b976f94f414483ca2a665ea07ea25eee932fc1db5ae128",
      "start_line": 47,
      "text": "  rule scanLongest(.ValSeq, ACC:Val) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 58,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "44c0c947625abeed0cd52c32a5723248d6af8d87a045521b9b038aac270596ab",
      "rationale": "Structurally recursive equation defining one strict-update step of the scanLongest mathematical fold.",
      "source_rule_id": "rule-44c0c947625abeed0cd52c32a5723248d6af8d87a045521b9b038aac270596ab",
      "start_line": 48,
      "text": "  rule scanLongest(vCons(V:Val, REST:ValSeq), ACC:Val)\n    => scanLongest(\n         REST,\n         #if isStringValue(V)\n               andBool isStringValue(ACC)\n               andBool seqLenString(projectString(V))\n                 >Int seqLenString(projectString(ACC))\n          #then V\n          #else ACC\n          #fi\n       )"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 63,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "67beb2eea342b3e5d17150407c10000f420d50633c7a9d73d28c790c8e83f636",
      "rationale": "Base equation defining the contract summary longestValue for empty input.",
      "source_rule_id": "rule-67beb2eea342b3e5d17150407c10000f420d50633c7a9d73d28c790c8e83f636",
      "start_line": 63,
      "text": "  rule longestValue(.ValSeq) => noneV"
    },
    {
      "attributes": [],
