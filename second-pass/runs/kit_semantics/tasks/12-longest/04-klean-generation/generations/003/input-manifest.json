      "normalized_sha256": "1d2c2a4845fdfb196412c7de137e7a793a97b4792dde88bc3ea17b1e6317ba72",
      "rationale": "Guarded defining equation for the named total projection projectString in terms of the built-in Str cast.",
      "source_rule_id": "rule-1d2c2a4845fdfb196412c7de137e7a793a97b4792dde88bc3ea17b1e6317ba72",
      "start_line": 27,
      "text": "  rule projectString(V:Val) => {V}:>Str\n    requires isStringValue(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "d20d0967ec516e4d1ef2dab852bec32ca6fda5f36314de73844d6de2fcb0f3b7",
      "rationale": "Reverse simplification orientation of the same projectString definitional equality, used to normalize symbolic casts to the named proof term.",
      "source_rule_id": "rule-d20d0967ec516e4d1ef2dab852bec32ca6fda5f36314de73844d6de2fcb0f3b7",
      "start_line": 30,
      "text": "  rule {V:Val}:>Str => projectString(V)\n    requires isStringValue(V)\n    [symbolic(V), simplification, preserves-definedness]"
    },
