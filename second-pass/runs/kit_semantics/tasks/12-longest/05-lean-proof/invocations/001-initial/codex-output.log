-- `SortInt`

-- Operations
def «_+Int_» (x0 x1 : SortInt) : Option SortInt := some (x0 + x1)
def «_-Int_» (x0 x1 : SortInt) : Option SortInt := some (x0 - x1)
def «_*Int_» (x0 x1 : SortInt) : Option SortInt := some (x0 * x1)
def «_/Int_» (x0 x1 : SortInt) : Option SortInt :=
  ite (x1 == 0) none (Int.tdiv x0 x1)
def _modInt_ (x0 x1 : SortInt) : Option SortInt :=
  ite (x1 == 0) none (Int.emod x0 x1)
