def «log2Int(_)_INT-COMMON_Int_Int» (x0 : SortInt) : Option SortInt :=
  ite (0 < x0) ((Nat.log2 x0.toNat) : Int) none
def «~Int_» (x0 : SortInt) : Option SortInt := some (.not x0)

-- Comparisons
def «_<=Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 <= x1)
def «_>=Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 >= x1)
def «_<Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 < x1)
def «_>Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 > x1)
def «_==Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 == x1)

