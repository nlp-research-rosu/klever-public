patch: completed
/tmp/lean-hostpid.c
diff --git a//tmp/lean-hostpid.c b//tmp/lean-hostpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..a19b85c712dc38556508c9bbea4c3f3fea547c8d
--- /dev/null
+++ b//tmp/lean-hostpid.c
@@ -0,0 +1,65 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dirent.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static pid_t namespace_pid(void) {
+    return (pid_t)syscall(SYS_getpid);
+}
+
+pid_t getpid(void) {
+    pid_t inner = namespace_pid();
+    DIR *proc = opendir("/proc");
+    if (proc == NULL) {
+        return inner;
+    }
+
+    struct dirent *entry;
+    while ((entry = readdir(proc)) != NULL) {
+        if (!isdigit((unsigned char)entry->d_name[0])) {
+            continue;
+        }
+        char status_path[320];
+        snprintf(status_path, sizeof(status_path), "/proc/%s/status", entry->d_name);
+        FILE *status = fopen(status_path, "r");
+        if (status == NULL) {
+            continue;
+        }
+
+        char *line = NULL;
+        size_t capacity = 0;
+        while (getline(&line, &capacity, status) >= 0) {
+            if (strncmp(line, "NSpid:", 6) != 0) {
+                continue;
+            }
+            char *cursor = line + 6;
+            long last = -1;
+            while (*cursor != '\0') {
+                while (isspace((unsigned char)*cursor)) {
+                    ++cursor;
+                }
+                if (!isdigit((unsigned char)*cursor)) {
+                    break;
+                }
+                last = strtol(cursor, &cursor, 10);
+            }
+            if (last == inner) {
+                pid_t outer = (pid_t)strtol(entry->d_name, NULL, 10);
+                free(line);
+                fclose(status);
+                closedir(proc);
+                return outer;
+            }
+            break;
+        }
+        free(line);
+        fclose(status);
+    }
+    closedir(proc);
+    return inner;
+}
