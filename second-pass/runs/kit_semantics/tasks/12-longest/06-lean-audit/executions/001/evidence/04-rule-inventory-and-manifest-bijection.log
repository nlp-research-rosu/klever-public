COMMAND: env PYTHONPATH=/reference python3 -c $'\nimport hashlib, json\nfrom pathlib import Path\nfrom tools.k_rule_inventory import inventory_verification, canonical_json_sha256\nfrom tools.lemma_discovery_contract import validate_trust_boundary\nworkspace=Path("/reference/k-proof")\nmanifest_path=Path("/reference/lemma-discovery.json")\ninv=inventory_verification(workspace)\nman=json.loads(manifest_path.read_text())\nclassified=validate_trust_boundary(workspace, manifest_path)\nids=[r["source_rule_id"] for r in inv["rules"]]\nmanifest_ids=[r["source_rule_id"] for r in man["rules"]]\nper_rule=[]\nfor idx, rule in enumerate(inv["rules"]):\n    normalized=" ".join(rule["text"].split())\n    digest=hashlib.sha256(normalized.encode()).hexdigest()\n    entry=man["rules"][idx] if idx < len(man["rules"]) else None\n    per_rule.append({\n      "index": idx,\n      "source_rule_id": rule["source_rule_id"],\n      "module": rule["module"],\n      "span": [rule["start_line"], rule["end_line"]],\n      "attributes": rule["attributes"],\n      "normalized_sha256": rule["normalized_sha256"],\n      "normalized_hash_recomputed": digest,\n      "id_is_hash": rule["source_rule_id"]=="rule-"+digest,\n      "ordered_manifest_id_match": entry is not None and entry["source_rule_id"]==rule["source_rule_id"],\n      "manifest_classification": None if entry is None else entry["classification"],\n      "manifest_rationale": None if entry is None else entry["rationale"],\n      "text": rule["text"],\n    })\nchecks={\n "schema_version": inv["schema_version"]==2 and man["schema_version"]==2,\n "verification_file_hash": inv["verification_sha256"]==hashlib.sha256((workspace/"verification.k").read_bytes()).hexdigest(),\n "inventory_hash_recomputed": inv["inventory_sha256"]==canonical_json_sha256(inv["rules"]),\n "inventory_hash_manifest": inv["inventory_sha256"]==man["inventory_sha256"],\n "rule_count_equal": len(inv["rules"])==len(man["rules"]),\n "inventory_ids_unique": len(ids)==len(set(ids)),\n "manifest_ids_unique": len(manifest_ids)==len(set(manifest_ids)),\n "id_sets_bijective": set(ids)==set(manifest_ids),\n "ordered_ids_identical": ids==manifest_ids,\n "all_rule_hashes_self_consistent": all(x["id_is_hash"] and x["normalized_sha256"]==x["normalized_hash_recomputed"] for x in per_rule),\n}\nprint(json.dumps({\n "inventory_header": {k:v for k,v in inv.items() if k!="rules"},\n "manifest_header": {k:v for k,v in man.items() if k!="rules"},\n "classification_counts": {k:len(classified[k]) for k in ("definitions","operational_rules","proved_derived_lemmas","domain_lemmas")},\n "checks":checks,\n "all_checks":all(checks.values()),\n "rules":per_rule,\n}, indent=2, sort_keys=False))\nraise SystemExit(0 if all(checks.values()) else 1)\n'
