COMMAND: env PYTHONPATH=/reference python3 -c $'\nimport hashlib, json, re\nfrom pathlib import Path\nfrom tools.k_rule_inventory import inventory_verification, canonical_json_sha256\nfrom tools.lemma_discovery_contract import validate_trust_boundary\nfrom tools import klean_export\n\ndef read(path): return json.loads(Path(path).read_text())\ndef sha_file(path): return hashlib.sha256(Path(path).read_bytes()).hexdigest()\ndef sha_text(text): return hashlib.sha256(text.encode()).hexdigest()\nworkspace=Path("/reference/k-proof")\ndiscovery_path=Path("/reference/lemma-discovery.json")\ngeneration=Path("/reference/klean-generation")\ngenerated=generation/"generated"\naudit=read("/audit-input.json")["resolution"]\ngenerator=read(generation/"generator-manifest.json")\ninput_manifest=read(generation/"input-manifest.json")\nobmap=read(generated/"obligation-map.json")\nvalidated=validate_trust_boundary(workspace, discovery_path)\ndomain=validated["domain_lemmas"]\ndiscovery_hash=sha_file(discovery_path)\nindependent_source_rules=[{**rule,"inventory_sha256":validated["inventory_sha256"],"discovery_manifest_sha256":discovery_hash} for rule in domain]\nids=[r["source_rule_id"] for r in independent_source_rules]\nobs=obmap["obligations"]\nobs_ids=[o["source_rule_id"] for o in obs]\nexpected_def=klean_export.expected_target_definition(obmap)\nparsed_target=klean_export.target_statement(generated)\nfresh_target=klean_export.target_statement(Path("/tmp/audit-work/stage5-proof-fresh/Base"))\nlemmas=(generated/"Klean12Longest/Lemmas.lean").read_text()\nmatch=re.search(r"(?ms)^\\s*def\\s+targetStatement\\b.*?(?=^\\s*end\\s+\\S+\\s*$)",lemmas)\nactual_def=match.group(0).strip() if match else None\nbindings_ok=[]\nfor p in obmap["trust_parameters"]:\n    binding={k:p[k] for k in ("kore_symbol","name","type","source_rule_ids")}\n    bindings_ok.append(p["binding_sha256"]==sha_text(json.dumps(binding,sort_keys=True,separators=(",",":"))))\nchecks={\n "inventory_hash": validated["inventory_sha256"]==canonical_json_sha256(validated["rules"]),\n "source_rules_exact_ordered": obmap["source_rules"]==independent_source_rules,\n "input_manifest_source_rules_exact_ordered": input_manifest["source_rules"]==independent_source_rules,\n "two_true_domain_rules": len(domain)==2,\n "obligation_count_matches_domain": len(obs)==len(domain)==generator["obligation_count"],\n "obligation_ids_exact_ordered": obs_ids==ids,\n "obligation_ids_unique": len(obs_ids)==len(set(obs_ids)),\n "obligation_provenance_and_spans": all(o["normalized_sha256"]==r["normalized_sha256"] and o["inventory_sha256"]==validated["inventory_sha256"] and o["discovery_manifest_sha256"]==discovery_hash and o["source_span"]=={"start_line":r["start_line"],"end_line":r["end_line"]} for o,r in zip(obs,independent_source_rules)),\n "conjunct_hashes": all(o["lean_conjunct_sha256"]==sha_text(o["lean_conjunct"]) and bool(o["lean_conjunct"]) for o in obs),\n "obligation_map_hash": sha_file(generated/"obligation-map.json")==generator["obligation_map_sha256"],\n "parameter_binding_hashes": all(bindings_ok),\n "target_definition_exact_conjunction": actual_def==expected_def,\n "target_definition_hash": sha_text(actual_def)==generator["target"]["definition_sha256"],\n "target_statement_hash": sha_text(parsed_target["statement"])==generator["target"]["statement_sha256"],\n "parsed_target_vs_generator": parsed_target==generator["target"],\n "target_vs_launcher": parsed_target==audit["target"],\n "fresh_base_target_unchanged": fresh_target==parsed_target,\n "candidate_no_target_shadow": re.search(r"(?m)^\\s*(?:def|theorem|lemma|axiom|opaque)\\s+targetStatement\\b",Path("/candidate/Proof.lean").read_text()) is None,\n "generated_tree_launcher": klean_export.tree_digest(generated)==audit["hashes"]["generated_tree_sha256"],\n}\nprint(json.dumps({"checks":checks,"all_checks":all(checks.values()),"independently_classified_domain_ids":ids,"obligation_ids":obs_ids,"expected_target_definition":expected_def,"parsed_target":parsed_target,"fresh_base_target":fresh_target},indent=2,sort_keys=True))\nraise SystemExit(0 if all(checks.values()) else 1)\n'
