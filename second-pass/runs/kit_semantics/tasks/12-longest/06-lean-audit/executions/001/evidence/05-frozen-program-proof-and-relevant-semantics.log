     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // The material input domain: every element of the finite ValSeq is a string.
     7	  // Writing the recursion over V:Val exposes the head guard to the prover.
     8	  syntax Bool ::= isStringValue(Val) [function, total]
     9	  rule isStringValue(_:Str) => true
    10	  rule isStringValue(_:Val) => false [owise]
    11	
    12	  syntax Bool ::= allStrings(ValSeq) [function, total]
    13	  rule allStrings(.ValSeq) => true
    14	  rule allStrings(vCons(V:Val, REST:ValSeq))
    15	    => isStringValue(V) andBool allStrings(REST)
    16	
    17	  // Guarded total projection (the upstream ceils.k pattern). This only
    18	  // restores the static Str sort already guaranteed by isStringValue; it does
    19	  // not manufacture a concrete string or alter execution state.
    20	  syntax Str ::= projectString(Val)
    21	    [function, total, symbol(projectString), no-evaluators]
    22	
    23	  rule #Ceil({@V:Val}:>Str)
    24	    => ({ isStringValue(@V) #Equals true } #And #Ceil(@V))
    25	    [simplification]
    26	
    27	  rule projectString(V:Val) => {V}:>Str
    28	    requires isStringValue(V)
    29	    [concrete, simplification(10), preserves-definedness]
    30	  rule {V:Val}:>Str => projectString(V)
    31	    requires isStringValue(V)
    32	    [symbolic(V), simplification, preserves-definedness]
    33	  rule projectString(S:Str) => S [simplification]
    34	  rule projectString(projectString(V:Val)) => projectString(V)
    35	    [simplification]
    36	
    37	  // Total static-sort twin of the fixed partial Val operation. Its constructor
    38	  // equation is exactly seqLen(str(CS)) => isLen(CS).
    39	  syntax Int ::= seqLenString(Str)
    40	    [function, total, symbol(seqLenString), no-evaluators]
    41	  rule seqLenString(str(CS:IntSeq)) => isLen(CS) [simplification]
    42	
    43	  // A left fold with a strict update: equality keeps the earlier accumulator.
    44	  // The fallback equation only totalizes the function outside the allStrings
    45	  // domain and is unreachable from the target claims.
    46	  syntax Val ::= scanLongest(ValSeq, Val) [function, total]
    47	  rule scanLongest(.ValSeq, ACC:Val) => ACC
    48	  rule scanLongest(vCons(V:Val, REST:ValSeq), ACC:Val)
    49	    => scanLongest(
    50	         REST,
    51	         #if isStringValue(V)
    52	               andBool isStringValue(ACC)
    53	               andBool seqLenString(projectString(V))
    54	                 >Int seqLenString(projectString(ACC))
    55	          #then V
    56	          #else ACC
    57	          #fi
    58	       )
    59	
    60	  // Contract value: noneV exactly for empty input; otherwise the fold starts
    61	  // at the first element and therefore keeps that element on a length tie.
    62	  syntax Val ::= longestValue(ValSeq) [function, total]
    63	  rule longestValue(.ValSeq) => noneV
    64	  rule longestValue(vCons(V:Val, REST:ValSeq))
    65	    => scanLongest(vCons(V, REST), V)
    66	    requires isStringValue(V)
    67	  rule longestValue(vCons(V:Val, _:ValSeq)) => noneV
    68	    requires notBool isStringValue(V)
    69	endmodule
    70	
    71	module VERIFICATION
    72	  imports VERIFICATION-BASE
    73	
    74	  // Guarded dynamic-sort dispatch twin. It restates the fixed string-length
    75	  // equation over precisely the values for which the total projection exists.
    76	  rule seqLen(V:Val) => seqLenString(projectString(V))
    77	    requires isStringValue(V)
    78	    [simplification]
    79	endmodule
