FROZEN source solution.py
     1	from typing import List, Optional
     2	
     3	
     4	def longest(strings: List[str]) -> Optional[str]:
     5	    if not strings:
     6	        return None
     7	
     8	    result = strings[0]
     9	    string = result
    10	    for string in strings:
    11	        if len(string) > len(result):
    12	            result = string
    13	
    14	    return result
