+import Klean12Longest.Lemmas
+
+namespace CoordinatedVacuity
+
+def emptyStr : SortStr :=
+  SortStr.«str(_)_MPY-CORE_Str_IntSeq» SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def falseIsString (_ : SortVal) : SortBool := false
+def emptyProjectString (_ : SortVal) : SortStr := emptyStr
+def zeroSeqLen (_ : SortVal) : SortInt := 0
+def zeroSeqLenString (_ : SortStr) : SortInt := 0
+def noneProject (_ : SortK) : Option SortStr := none
+
+theorem coordinatedWrongDefinitionsStillSatisfyBareTarget :
+    Klean12Longest.Lemmas.targetStatement
+      falseIsString
+      emptyProjectString
+      zeroSeqLen
+      zeroSeqLenString
+      noneProject := by
+  constructor
+  · intro V
+    simp [falseIsString, noneProject]
+  · intro V h
+    simp [falseIsString] at h
+
+end CoordinatedVacuity
