codex
The launcher records proof mode (`CLASSIFICATION_AND_PROOF`). I’m setting up a bounded transcript helper so every substantive command, exit status, and complete result is preserved under `evidence/`, while keeping the read-only mounts untouched.
apply patch
patch: completed
/audit-output/evidence/run_logged.sh
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e3079c9e52bd2b249cb2ab8b11d9949fffb0154e
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -o pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"

diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
