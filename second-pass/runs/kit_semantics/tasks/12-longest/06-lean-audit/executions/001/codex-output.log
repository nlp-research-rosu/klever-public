exec
/bin/bash -lc "chmod +x /audit-output/evidence/run_logged.sh
/audit-output/evidence/run_logged.sh /audit-output/evidence/01-launcher-and-producer-provenance.log bash -lc '
set -u
printf \"AUDIT_MODE=%s\\n\" \""'$AUDIT_MODE"
printf "audit-input path and digest'"\\n\"
stat -c \"%A %U:%G %s %n\" /audit-input.json /reference/generation-tools/klean_export.py /reference/generation-tools/klean.py /reference/generation-tools/source-manifest.json /reference/klean-generation/generator-manifest.json
sha256sum /audit-input.json /reference/generation-tools/klean_export.py /reference/generation-tools/klean.py /reference/generation-tools/source-manifest.json /reference/klean-generation/generator-manifest.json
printf \"launcher resolution subset\\n\"
jq \"{resolution: {schema_version: .resolution.schema_version, problem_id: .resolution.problem_id, condition: .resolution.condition, semantics_mode: .resolution.semantics_mode, mode: .resolution.mode, hashes: .resolution.hashes, generation_producer_sources: .resolution.generation_producer_sources}}\" /audit-input.json
printf \"generator manifest\\n\"
