+import Proof
+
+namespace AuditBridgeWitnesses
+
+open Proof
+
+def nilIS : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def twoChars : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 65
+    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 66 nilIS)
+
+def str2 : SortStr :=
+  SortStr.«str(_)_MPY-CORE_Str_IntSeq» twoChars
+
+def directString : SortVal :=
+  SortVal.inj_SortStr str2
+
+def canonicalViaIterable : SortVal :=
+  (@inj SortIterable SortVal) (SortIterable.inj_SortStr str2)
+
+def rawNestedString : SortVal :=
+  SortVal.inj_SortIterable (SortIterable.inj_SortStr str2)
+
+def twoVals : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+    (SortVal.inj_SortInt 7)
+    (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+      (SortVal.inj_SortBool true)
+      SortValSeq.«.ValSeq_MPY-CORE_ValSeq»)
+
+def list2 : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» twoVals)
+
+def tuple2 : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» twoVals)
+
+def set2 : SortVal :=
+  SortVal.«setV(_)_MPY-SET_Val_IntSeq» twoChars
+
+def rangeUp : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 1 8 3)
+
+def rangeDown : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 8 1 (-3))
+
+#eval «isStringValue(_)_VERIFICATION-BASE_Bool_Val» directString
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» directString
+#eval seqLenString str2
+#eval («project:Str?» (SortK.kseq ((@inj SortVal SortKItem) directString) SortK.dotk)).isSome
+
+#eval «isStringValue(_)_VERIFICATION-BASE_Bool_Val» canonicalViaIterable
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» canonicalViaIterable
+#eval («project:Str?» (SortK.kseq ((@inj SortVal SortKItem) canonicalViaIterable) SortK.dotk)).isSome
+
+#eval «isStringValue(_)_VERIFICATION-BASE_Bool_Val» rawNestedString
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» rawNestedString
+#eval («project:Str?» (SortK.kseq ((@inj SortVal SortKItem) rawNestedString) SortK.dotk)).isSome
+
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» list2
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» tuple2
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» set2
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» rangeUp
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» rangeDown
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» (SortVal.inj_SortInt 99)
+
+example : canonicalViaIterable = directString := rfl
+example : «isStringValue(_)_VERIFICATION-BASE_Bool_Val» directString = true := rfl
+example : «seqLen(_)_MPY-BUILTINS_Int_Val» directString = 2 := rfl
+example : seqLenString str2 = 2 := rfl
+example : projectString directString = str2 := rfl
+example :
+    «project:Str?» (SortK.kseq ((@inj SortVal SortKItem) directString) SortK.dotk)
+      = some str2 := rfl
+
+end AuditBridgeWitnesses
