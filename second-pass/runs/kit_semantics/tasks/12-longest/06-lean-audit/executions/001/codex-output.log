index 0000000000000000000000000000000000000000..6ba3ce65a93f4899ebdf2dfc1c938114b7ddf1ab
--- /dev/null
+++ b//tmp/audit-work/stage5-proof-fresh/BadSeqLenCheck.lean
@@ -0,0 +1,25 @@
+import Proof
+
+namespace BadSeqLenCheck
+
+def zeroSeqLen (_ : SortVal) : SortInt := 0
+
+example :
+    Klean12Longest.Lemmas.targetStatement
+      Proof.«isStringValue(_)_VERIFICATION-BASE_Bool_Val»
+      Proof.projectString
+      zeroSeqLen
+      Proof.seqLenString
+      Proof.«project:Str?» := by
+  constructor
+  · exact Proof.final.1
+  · intro V h
+    cases V <;>
+      simp_all [
+        Proof.«isStringValue(_)_VERIFICATION-BASE_Bool_Val»,
+        zeroSeqLen,
+        Proof.projectString,
+        Proof.seqLenString
+      ]
+
+end BadSeqLenCheck
diff --git a//tmp/audit-work/stage5-proof-fresh/BridgeWitnesses.lean b//tmp/audit-work/stage5-proof-fresh/BridgeWitnesses.lean
new file mode 100644
index 0000000000000000000000000000000000000000..62e9a7119fc361c5314ae89738efaa10c202cb29
--- /dev/null
+++ b//tmp/audit-work/stage5-proof-fresh/BridgeWitnesses.lean
@@ -0,0 +1,81 @@
+import Proof
+
+namespace AuditBridgeWitnesses
+
+open Proof
+
+def nilIS : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def twoChars : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 65
+    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 66 nilIS)
+
+def str2 : SortStr :=
+  SortStr.«str(_)_MPY-CORE_Str_IntSeq» twoChars
+
+def directString : SortVal :=
+  SortVal.inj_SortStr str2
+
+def canonicalViaIterable : SortVal :=
+  (@inj SortIterable SortVal) (SortIterable.inj_SortStr str2)
+
+def rawNestedString : SortVal :=
+  SortVal.inj_SortIterable (SortIterable.inj_SortStr str2)
+
+def twoVals : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+    (SortVal.inj_SortInt 7)
+    (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+      (SortVal.inj_SortBool true)
+      SortValSeq.«.ValSeq_MPY-CORE_ValSeq»)
+
+def list2 : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» twoVals)
+
+def tuple2 : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» twoVals)
+
+def set2 : SortVal :=
+  SortVal.«setV(_)_MPY-SET_Val_IntSeq» twoChars
+
+def rangeUp : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 1 8 3)
+
+def rangeDown : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 8 1 (-3))
+
+#eval «isStringValue(_)_VERIFICATION-BASE_Bool_Val» directString
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» directString
+#eval seqLenString str2
+#eval («project:Str?» (SortK.kseq ((@inj SortVal SortKItem) directString) SortK.dotk)).isSome
+
+#eval «isStringValue(_)_VERIFICATION-BASE_Bool_Val» canonicalViaIterable
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» canonicalViaIterable
+#eval («project:Str?» (SortK.kseq ((@inj SortVal SortKItem) canonicalViaIterable) SortK.dotk)).isSome
+
+#eval «isStringValue(_)_VERIFICATION-BASE_Bool_Val» rawNestedString
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» rawNestedString
+#eval («project:Str?» (SortK.kseq ((@inj SortVal SortKItem) rawNestedString) SortK.dotk)).isSome
+
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» list2
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» tuple2
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» set2
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» rangeUp
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» rangeDown
+#eval «seqLen(_)_MPY-BUILTINS_Int_Val» (SortVal.inj_SortInt 99)
+
+example : canonicalViaIterable = directString := rfl
+example : «isStringValue(_)_VERIFICATION-BASE_Bool_Val» directString = true := rfl
+example : «seqLen(_)_MPY-BUILTINS_Int_Val» directString = 2 := rfl
+example : seqLenString str2 = 2 := rfl
+example : projectString directString = str2 := rfl
+example :
+    «project:Str?» (SortK.kseq ((@inj SortVal SortKItem) directString) SortK.dotk)
+      = some str2 := rfl
+
+end AuditBridgeWitnesses
diff --git a//tmp/audit-work/stage5-proof-fresh/CoordinatedVacuity.lean b//tmp/audit-work/stage5-proof-fresh/CoordinatedVacuity.lean
new file mode 100644
index 0000000000000000000000000000000000000000..f3a1d4e1a765e641533f3a68a9729c2ebdd88ae9
--- /dev/null
+++ b//tmp/audit-work/stage5-proof-fresh/CoordinatedVacuity.lean
@@ -0,0 +1,27 @@
+import Klean12Longest.Lemmas
+
+namespace CoordinatedVacuity
+
+def emptyStr : SortStr :=
+  SortStr.«str(_)_MPY-CORE_Str_IntSeq» SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def falseIsString (_ : SortVal) : SortBool := false
+def emptyProjectString (_ : SortVal) : SortStr := emptyStr
+def zeroSeqLen (_ : SortVal) : SortInt := 0
+def zeroSeqLenString (_ : SortStr) : SortInt := 0
+def noneProject (_ : SortK) : Option SortStr := none
+
+theorem coordinatedWrongDefinitionsStillSatisfyBareTarget :
+    Klean12Longest.Lemmas.targetStatement
+      falseIsString
+      emptyProjectString
+      zeroSeqLen
+      zeroSeqLenString
+      noneProject := by
+  constructor
+  · intro V
+    simp [falseIsString, noneProject]
+  · intro V h
+    simp [falseIsString] at h
+
+end CoordinatedVacuity
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e3079c9e52bd2b249cb2ab8b11d9949fffb0154e
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -o pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"

diff --git a//tmp/audit-work/lean_proc_compat.c b//tmp/audit-work/lean_proc_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..643ecfee2b8d7aa498cb8f863edecd2bd5384728
--- /dev/null
+++ b//tmp/audit-work/lean_proc_compat.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    if (
+        result < 0
+        && strncmp(path, "/proc/", 6) == 0
+        && strcmp(path + strlen(path) - 4, "/exe") == 0
+    ) {
+        result = real_readlink("/proc/self/exe", buffer, size);
+    }
+    return result;
+}
diff --git a//tmp/audit-work/readlink_probe.c b//tmp/audit-work/readlink_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..e5d3fd98daf354c9e9770d1d2e1577547c76875a
--- /dev/null
+++ b//tmp/audit-work/readlink_probe.c
@@ -0,0 +1,26 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    errno = 0;
+    ssize_t result = real_readlink(path, buffer, size);
+    int saved_errno = errno;
+    dprintf(
+        STDERR_FILENO,
+        "READLINK_PROBE path=%s result=%zd errno=%d\n",
+        path,
+        result,
+        saved_errno
+    );
+    errno = saved_errno;
+    return result;
+}
