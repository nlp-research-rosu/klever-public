/reference/k-proof/reference-semantics/semantics/operators.k-1-// reference/src/semantics/operators.k — MPY-OPERATORS
/reference/k-proof/reference-semantics/semantics/operators.k-2-// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
/reference/k-proof/reference-semantics/semantics/operators.k:3:// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
/reference/k-proof/reference-semantics/semantics/operators.k-4-// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
/reference/k-proof/reference-semantics/semantics/operators.k-5-
/reference/k-proof/reference-semantics/semantics/operators.k-6-module MPY-OPERATORS
/reference/k-proof/reference-semantics/semantics/operators.k-7-  imports MPY-CORE
--
/reference/k-proof/reference-semantics/semantics/operators.k-11-
/reference/k-proof/reference-semantics/semantics/operators.k-12-  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
/reference/k-proof/reference-semantics/semantics/operators.k-13-
/reference/k-proof/reference-semantics/semantics/operators.k-14-  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
/reference/k-proof/reference-semantics/semantics/operators.k:15:  context Compare(HOLE, _)
/reference/k-proof/reference-semantics/semantics/operators.k:16:  context Compare(_:Val, CmpOp(_, HOLE))
/reference/k-proof/reference-semantics/semantics/operators.k:17:  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
/reference/k-proof/reference-semantics/semantics/operators.k-18-
/reference/k-proof/reference-semantics/semantics/operators.k:19:  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
/reference/k-proof/reference-semantics/semantics/operators.k:20:  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
/reference/k-proof/reference-semantics/semantics/operators.k-21-
/reference/k-proof/reference-semantics/semantics/operators.k-22-  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
/reference/k-proof/reference-semantics/semantics/operators.k-23-  // (Python: list == is structural; identity only via `is`.) priority(40)
/reference/k-proof/reference-semantics/semantics/operators.k:24:  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
/reference/k-proof/reference-semantics/semantics/operators.k-25-  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
/reference/k-proof/reference-semantics/semantics/operators.k-26-       <heap> ... H |-> V:Val ... </heap>
/reference/k-proof/reference-semantics/semantics/operators.k-27-       [priority(40)]
/reference/k-proof/reference-semantics/semantics/operators.k-28-  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
--
/reference/k-proof/reference-semantics/semantics/operators.k-30-       requires notBool isRefV(L)
/reference/k-proof/reference-semantics/semantics/operators.k-31-       [priority(40)]
/reference/k-proof/reference-semantics/semantics/operators.k-32-
/reference/k-proof/reference-semantics/semantics/operators.k-33-  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
/reference/k-proof/reference-semantics/semantics/operators.k:34:  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
/reference/k-proof/reference-semantics/semantics/operators.k-35-       <heap> ... H |-> V:Val ... </heap>
/reference/k-proof/reference-semantics/semantics/operators.k-36-       requires OP =/=String "in" andBool OP =/=String "not in"
/reference/k-proof/reference-semantics/semantics/operators.k-37-       [priority(40)]
/reference/k-proof/reference-semantics/semantics/operators.k:38:  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
/reference/k-proof/reference-semantics/semantics/operators.k-39-       <heap> ... H |-> V:Val ... </heap>
/reference/k-proof/reference-semantics/semantics/operators.k-40-       requires notBool isRefV(L)
/reference/k-proof/reference-semantics/semantics/operators.k-41-        orBool OP ==String "in" orBool OP ==String "not in"
/reference/k-proof/reference-semantics/semantics/operators.k-42-       [priority(40)]
