/reference/k-proof/reference-semantics/semantics/builtins.k-283-  syntax Val ::= md5Obj(IntSeq)
/reference/k-proof/reference-semantics/semantics/builtins.k-284-  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
