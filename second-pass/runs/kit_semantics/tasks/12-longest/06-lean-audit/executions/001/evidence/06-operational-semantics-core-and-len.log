/reference/k-proof/reference-semantics/semantics/builtins.k-287-  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
/reference/k-proof/reference-semantics/semantics/builtins.k-288-  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
/reference/k-proof/reference-semantics/semantics/builtins.k-289-  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
/reference/k-proof/reference-semantics/semantics/builtins.k-290-  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
/reference/k-proof/reference-semantics/semantics/builtins.k:291:  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
/reference/k-proof/reference-semantics/semantics/builtins.k:292:  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
/reference/k-proof/reference-semantics/semantics/builtins.k-293-  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
/reference/k-proof/reference-semantics/semantics/builtins.k-294-  rule isIntV(_:Int)         => true
/reference/k-proof/reference-semantics/semantics/builtins.k-295-  rule isIntV(_:Val)         => false [owise]
/reference/k-proof/reference-semantics/semantics/builtins.k-296-  rule isStrV(str(_:IntSeq)) => true
