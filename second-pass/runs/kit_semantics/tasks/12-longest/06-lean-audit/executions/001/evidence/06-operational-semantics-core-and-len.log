/reference/k-proof/reference-semantics/semantics/builtins.k-115-  rule binCodes(0) => iCons(48, .IntSeq)
--
/reference/k-proof/reference-semantics/semantics/builtins.k-120-    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
/reference/k-proof/reference-semantics/semantics/builtins.k-121-       requires N >Int 0
/reference/k-proof/reference-semantics/semantics/builtins.k-122-
/reference/k-proof/reference-semantics/semantics/builtins.k-123-  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
/reference/k-proof/reference-semantics/semantics/builtins.k:124:  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
/reference/k-proof/reference-semantics/semantics/builtins.k-125-        => #alloc(list(enumVS(VS, 0))) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k-126-  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
/reference/k-proof/reference-semantics/semantics/builtins.k-127-  rule enumVS(.ValSeq, _:Int) => .ValSeq
/reference/k-proof/reference-semantics/semantics/builtins.k-128-  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
/reference/k-proof/reference-semantics/semantics/builtins.k-129-    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
/reference/k-proof/reference-semantics/semantics/builtins.k-130-
/reference/k-proof/reference-semantics/semantics/builtins.k-131-  // ==== map(str, xs) — eager (only the str case is in the subset) =============
/reference/k-proof/reference-semantics/semantics/builtins.k:132:  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
