/reference/k-proof/reference-semantics/semantics/builtins.k-135-  rule mapStrVS(.ValSeq) => .ValSeq
/reference/k-proof/reference-semantics/semantics/builtins.k-136-  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
/reference/k-proof/reference-semantics/semantics/builtins.k-137-  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
/reference/k-proof/reference-semantics/semantics/builtins.k-138-
/reference/k-proof/reference-semantics/semantics/builtins.k-139-  // ==== int(x) identities (int(round(x)) composes through) ====================
/reference/k-proof/reference-semantics/semantics/builtins.k:140:  rule applyBuiltin("int", I:Int, .Vals) => I
/reference/k-proof/reference-semantics/semantics/builtins.k-141-
/reference/k-proof/reference-semantics/semantics/builtins.k-142-  // ==== ord / chr ===========================================================
/reference/k-proof/reference-semantics/semantics/builtins.k:143:  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
/reference/k-proof/reference-semantics/semantics/builtins.k:144:  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
/reference/k-proof/reference-semantics/semantics/builtins.k-145-       requires 0 <=Int I andBool I <Int 128
/reference/k-proof/reference-semantics/semantics/builtins.k-146-
/reference/k-proof/reference-semantics/semantics/builtins.k-147-  // ==== str(int) / str(str) =================================================
/reference/k-proof/reference-semantics/semantics/builtins.k:148:  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
/reference/k-proof/reference-semantics/semantics/builtins.k:149:  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
/reference/k-proof/reference-semantics/semantics/builtins.k-150-
/reference/k-proof/reference-semantics/semantics/builtins.k-151-  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
/reference/k-proof/reference-semantics/semantics/builtins.k:152:  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
/reference/k-proof/reference-semantics/semantics/builtins.k-153-       requires 48 <=Int C andBool C <=Int 57
/reference/k-proof/reference-semantics/semantics/builtins.k-154-
/reference/k-proof/reference-semantics/semantics/builtins.k-155-  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
/reference/k-proof/reference-semantics/semantics/builtins.k:156:  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
/reference/k-proof/reference-semantics/semantics/builtins.k-157-       requires isLen(CS) >=Int 2
/reference/k-proof/reference-semantics/semantics/builtins.k-158-  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
/reference/k-proof/reference-semantics/semantics/builtins.k-159-  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
/reference/k-proof/reference-semantics/semantics/builtins.k-160-  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
/reference/k-proof/reference-semantics/semantics/builtins.k-161-
/reference/k-proof/reference-semantics/semantics/builtins.k-162-  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
/reference/k-proof/reference-semantics/semantics/builtins.k:163:  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
/reference/k-proof/reference-semantics/semantics/builtins.k:164:  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
/reference/k-proof/reference-semantics/semantics/builtins.k-165-
/reference/k-proof/reference-semantics/semantics/builtins.k:166:  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
/reference/k-proof/reference-semantics/semantics/builtins.k:167:  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
/reference/k-proof/reference-semantics/semantics/builtins.k:168:        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:169:  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:170:  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:171:  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
/reference/k-proof/reference-semantics/semantics/builtins.k:172:        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:173:  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k:174:  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>
/reference/k-proof/reference-semantics/semantics/builtins.k-175-
/reference/k-proof/reference-semantics/semantics/builtins.k-176-  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
/reference/k-proof/reference-semantics/semantics/builtins.k:177:  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
/reference/k-proof/reference-semantics/semantics/builtins.k:178:  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
/reference/k-proof/reference-semantics/semantics/builtins.k:179:  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
/reference/k-proof/reference-semantics/semantics/builtins.k-180-       requires S =/=Int 0
/reference/k-proof/reference-semantics/semantics/builtins.k-181-
/reference/k-proof/reference-semantics/semantics/builtins.k-182-  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
/reference/k-proof/reference-semantics/semantics/builtins.k-183-  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
/reference/k-proof/reference-semantics/semantics/builtins.k-184-  // trusted pass evaluator, now DEFINED in the reference and driven by a
/reference/k-proof/reference-semantics/semantics/builtins.k-185-  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
/reference/k-proof/reference-semantics/semantics/builtins.k-186-  // argument leaves the call unevaluated for problem-level folds.
/reference/k-proof/reference-semantics/semantics/builtins.k:187:  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
/reference/k-proof/reference-semantics/semantics/builtins.k-188-  syntax Int ::= evalArith(IntSeq) [function]
/reference/k-proof/reference-semantics/semantics/builtins.k-189-  rule evalArith(CS:IntSeq)
/reference/k-proof/reference-semantics/semantics/builtins.k-190-    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))
/reference/k-proof/reference-semantics/semantics/builtins.k-191-
