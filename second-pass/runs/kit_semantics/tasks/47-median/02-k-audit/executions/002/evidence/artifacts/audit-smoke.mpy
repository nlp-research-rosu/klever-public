Module(
  FuncDef("median", Params("l"),
    Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
    Assign(Name("size"), Call(Name("len"), Name("ordered")))
    If(Compare(BinOp("%", Name("size"), Int(2)), CmpOp("==", Int(1))),
      Return(
        Subscript(Name("ordered"), BinOp("//", Name("size"), Int(2)))),
      Return(
        BinOp(
          "/",
          BinOp(
            "+",
            Subscript(
              Name("ordered"),
              BinOp("-", BinOp("//", Name("size"), Int(2)), Int(1))),
            Subscript(
              Name("ordered"),
              BinOp("//", Name("size"), Int(2)))),
          Int(2)))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(Int(3), Int(1), Int(2), Int(4), Int(5))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(
          UnaryOp("-", Int(10)),
          Int(4),
          Int(6),
          Int(1000),
          Int(10),
          Int(20))),
      CmpOp("==", Float(8.0))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Int(1), Int(3))),
      CmpOp("==", Float(2.0))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Int(0), Bool(true))),
      CmpOp("==", Float(0.5))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Bool(false), Int(2))),
      CmpOp("==", Float(1.0))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Bool(false), Bool(true))),
      CmpOp("==", Float(0.5))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Float(1.0), Float(3.0))),
      CmpOp("==", Float(2.0))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Int(1), Float(2.0))),
      CmpOp("==", Float(1.5))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Float(1.5), Int(2))),
      CmpOp("==", Float(1.75))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Bool(false), Float(2.0))),
      CmpOp("==", Float(1.0))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Float(0.5), Bool(true))),
      CmpOp("==", Float(0.75))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Str("c"), Str("a"), Str("b"))),
      CmpOp("==", Str("b")))))
