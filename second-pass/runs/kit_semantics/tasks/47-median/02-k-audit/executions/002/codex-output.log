+      .Map
+      =>
+      0 |-> list(sortVS(vCons(9, vCons(1, vCons(5, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
