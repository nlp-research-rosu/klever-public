diff --git a//tmp/audit-work/median47/audit-program-mutated.k b//tmp/audit-work/median47/audit-program-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..11c850272f2436e86eae6f538a802973b64f1916
--- /dev/null
+++ b//tmp/audit-work/median47/audit-program-mutated.k
@@ -0,0 +1,30 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-MEDIAN-MUTATED
+  imports MPY
+
+  syntax Val ::= "solutionMedianClosureMutated" [function, total]
+  rule solutionMedianClosureMutated
+    => closureVal(
+      "l",
+      Expr(
+            Str(
+              "Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    "))
+          Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
+          Assign(Name("size"), Call(Name("len"), Name("ordered")))
+          If(Compare(BinOp("%", Name("size"), Int(2)), CmpOp("==", Int(1))),
+            Return(Int(0)),
+            Return(
+              BinOp(
+                "/",
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("ordered"),
+                    BinOp("-", BinOp("//", Name("size"), Int(2)), Int(1))),
+                  Subscript(
+                    Name("ordered"),
+                    BinOp("//", Name("size"), Int(2)))),
+                Int(2)))),
+      0)
+endmodule
diff --git a//tmp/audit-work/median47/audit-smoke.py b//tmp/audit-work/median47/audit-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..754b2d476eb8daf3b4bc4dd4aa4b8c110ba845b5
--- /dev/null
+++ b//tmp/audit-work/median47/audit-smoke.py
@@ -0,0 +1,21 @@
+def median(l: list):
+    ordered = sorted(l)
+    size = len(ordered)
+    if size % 2 == 1:
+        return ordered[size // 2]
+    else:
+        return (ordered[size // 2 - 1] + ordered[size // 2]) / 2
+
+
+assert median([3, 1, 2, 4, 5]) == 3
+assert median([-10, 4, 6, 1000, 10, 20]) == 8.0
+assert median([1, 3]) == 2.0
+assert median([0, True]) == 0.5
+assert median([False, 2]) == 1.0
+assert median([False, True]) == 0.5
+assert median([1.0, 3.0]) == 2.0
+assert median([1, 2.0]) == 1.5
+assert median([1.5, 2]) == 1.75
+assert median([False, 2.0]) == 1.0
+assert median([0.5, True]) == 0.75
+assert median(["c", "a", "b"]) == "b"
