+++ b//tmp/audit-work/median47/audit-body-sensitivity-spec.k
@@ -0,0 +1,31 @@
+requires "audit-verification-mutated.k"
+
+module AUDIT-BODY-SENSITIVITY-SPEC
+  imports AUDIT-VERIFICATION-MUTATED
+
+  // The original body returns 5 here; the executed mutant body returns 0.
+  claim [audit-mutated-body-rejected]:
+    <k>
+      Call(
+        Name("median"),
+        list(vCons(9, vCons(1, vCons(5, .ValSeq)))))
+      =>
+      5
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosureMutated, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(vCons(9, vCons(1, vCons(5, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/median47/audit-false-spec.k b//tmp/audit-work/median47/audit-false-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a8ef8d73d878817c776e9f34441bbcc27c399064
--- /dev/null
+++ b//tmp/audit-work/median47/audit-false-spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module AUDIT-FALSE-SPEC
+  imports VERIFICATION
+
+  // [9, 1, 5] has median 5.  Requiring 6 is deliberately false.
+  claim [audit-false-odd-result]:
+    <k>
+      Call(
+        Name("median"),
+        list(vCons(9, vCons(1, vCons(5, .ValSeq)))))
+      =>
+      6
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(vCons(9, vCons(1, vCons(5, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
