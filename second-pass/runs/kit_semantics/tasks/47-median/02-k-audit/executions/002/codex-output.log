+Module(
+  FuncDef("median", Params("l"),
+    Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
+    Assign(Name("size"), Call(Name("len"), Name("ordered")))
+    If(Compare(BinOp("%", Name("size"), Int(2)), CmpOp("==", Int(1))),
+      Return(
+        Subscript(Name("ordered"), BinOp("//", Name("size"), Int(2)))),
+      Return(
+        BinOp(
+          "/",
+          BinOp(
+            "+",
+            Subscript(
+              Name("ordered"),
+              BinOp("-", BinOp("//", Name("size"), Int(2)), Int(1))),
+            Subscript(
+              Name("ordered"),
+              BinOp("//", Name("size"), Int(2)))),
+          Int(2)))))
+  Assert(
+    Compare(
+      Call(
+        Name("median"),
+        ListExpr(Int(3), Int(1), Int(2), Int(4), Int(5))),
+      CmpOp("==", Int(3))))
+  Assert(
+    Compare(
+      Call(
+        Name("median"),
+        ListExpr(
+          UnaryOp("-", Int(10)),
+          Int(4),
+          Int(6),
+          Int(1000),
+          Int(10),
+          Int(20))),
+      CmpOp("==", Float(8.0))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Int(1), Int(3))),
+      CmpOp("==", Float(2.0))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Int(0), Bool(true))),
+      CmpOp("==", Float(0.5))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Bool(false), Int(2))),
+      CmpOp("==", Float(1.0))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Bool(false), Bool(true))),
+      CmpOp("==", Float(0.5))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Float(1.0), Float(3.0))),
+      CmpOp("==", Float(2.0))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Int(1), Float(2.0))),
+      CmpOp("==", Float(1.5))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Float(1.5), Int(2))),
+      CmpOp("==", Float(1.75))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Bool(false), Float(2.0))),
+      CmpOp("==", Float(1.0))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Float(0.5), Bool(true))),
+      CmpOp("==", Float(0.75))))
+  Assert(
+    Compare(
+      Call(Name("median"), ListExpr(Str("c"), Str("a"), Str("b"))),
+      CmpOp("==", Str("b")))))
diff --git a/evidence/artifacts/audit-smoke.py b/evidence/artifacts/audit-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..754b2d476eb8daf3b4bc4dd4aa4b8c110ba845b5
--- /dev/null
+++ b/evidence/artifacts/audit-smoke.py
@@ -0,0 +1,21 @@
+def median(l: list):
+    ordered = sorted(l)
+    size = len(ordered)
+    if size % 2 == 1:
+        return ordered[size // 2]
+    else:
+        return (ordered[size // 2 - 1] + ordered[size // 2]) / 2
+
+
+assert median([3, 1, 2, 4, 5]) == 3
+assert median([-10, 4, 6, 1000, 10, 20]) == 8.0
+assert median([1, 3]) == 2.0
+assert median([0, True]) == 0.5
+assert median([False, 2]) == 1.0
+assert median([False, True]) == 0.5
+assert median([1.0, 3.0]) == 2.0
+assert median([1, 2.0]) == 1.5
+assert median([1.5, 2]) == 1.75
+assert median([False, 2.0]) == 1.0
+assert median([0.5, True]) == 0.75
+assert median(["c", "a", "b"]) == "b"
