+            Return(
+              BinOp(
+                "/",
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("ordered"),
+                    BinOp("-", BinOp("//", Name("size"), Int(2)), Int(1))),
+                  Subscript(
+                    Name("ordered"),
+                    BinOp("//", Name("size"), Int(2)))),
+                Int(2)))),
+      0)
