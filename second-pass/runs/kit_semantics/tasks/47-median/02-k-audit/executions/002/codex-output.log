+requires "verification.k"
+
+module AUDIT-FALSE-SPEC
+  imports VERIFICATION
+
+  // [9, 1, 5] has median 5.  Requiring 6 is deliberately false.
+  claim [audit-false-odd-result]:
+    <k>
+      Call(
+        Name("median"),
+        list(vCons(9, vCons(1, vCons(5, .ValSeq)))))
+      =>
+      6
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(vCons(9, vCons(1, vCons(5, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/median47/audit-smoke.py b//tmp/audit-work/median47/audit-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..754b2d476eb8daf3b4bc4dd4aa4b8c110ba845b5
--- /dev/null
+++ b//tmp/audit-work/median47/audit-smoke.py
@@ -0,0 +1,21 @@
+def median(l: list):
+    ordered = sorted(l)
+    size = len(ordered)
+    if size % 2 == 1:
+        return ordered[size // 2]
+    else:
+        return (ordered[size // 2 - 1] + ordered[size // 2]) / 2
+
+
+assert median([3, 1, 2, 4, 5]) == 3
+assert median([-10, 4, 6, 1000, 10, 20]) == 8.0
+assert median([1, 3]) == 2.0
+assert median([0, True]) == 0.5
+assert median([False, 2]) == 1.0
+assert median([False, True]) == 0.5
+assert median([1.0, 3.0]) == 2.0
+assert median([1, 2.0]) == 1.5
+assert median([1.5, 2]) == 1.75
+assert median([False, 2.0]) == 1.0
+assert median([0.5, True]) == 0.75
+assert median(["c", "a", "b"]) == "b"
diff --git a//tmp/audit-work/median47/stage2_translate.sh b//tmp/audit-work/median47/stage2_translate.sh
new file mode 100644
index 0000000000000000000000000000000000000000..32f8dc68deb9fc5f502a29e305ea140d1d4b6b29
--- /dev/null
+++ b//tmp/audit-work/median47/stage2_translate.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+set -u
+
+python3 py2mpy.py solution.py > regenerated-solution.mpy
+translate_status=$?
+printf 'translate_exit=%s\n' "$translate_status"
+
+cmp -s regenerated-solution.mpy solution.mpy
+cmp_status=$?
+printf 'byte_identity_exit=%s\n' "$cmp_status"
+
+sha256sum solution.py solution.mpy regenerated-solution.mpy py2mpy.py
+
+if [[ "$translate_status" -ne 0 || "$cmp_status" -ne 0 ]]; then
+  exit 1
+fi
diff --git a//tmp/audit-work/median47/stage5_unicode_gap.sh b//tmp/audit-work/median47/stage5_unicode_gap.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0676ad7419c01407d67ca3d7cfb3eb400c3204c7
--- /dev/null
+++ b//tmp/audit-work/median47/stage5_unicode_gap.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -u
+
+python3 unicode-gap.py
+python_status=$?
+printf 'cpython_script_exit=%s\n' "$python_status"
+python3 -c 'import solution; print("cpython_result=" + repr(solution.median(["é", "a", "b"])))'
+
+python3 py2mpy.py unicode-gap.py > unicode-gap.mpy
+translate_status=$?
+printf 'translate_exit=%s\n' "$translate_status"
+
+krun unicode-gap.mpy --definition audit-runtime-kompiled
+krun_status=$?
+printf 'krun_exit=%s\n' "$krun_status"
+
+if [[ "$python_status" -ne 0 || "$translate_status" -ne 0 ]]; then
+  exit 1
+fi
