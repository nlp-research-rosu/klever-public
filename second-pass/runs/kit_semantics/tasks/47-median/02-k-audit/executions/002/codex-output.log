     9	import sys
    10	from pathlib import Path
    11	
    12	import py2mpy
    13	
    14	
    15	def main() -> int:
    16	    if not 2 <= len(sys.argv) <= 4:
    17	        raise SystemExit(
    18	            "usage: generate_program_k.py SOLUTION.py [MODULE [SYMBOL]]"
    19	        )
    20	
    21	    source_path = Path(sys.argv[1])
    22	    module_name = sys.argv[2] if len(sys.argv) >= 3 else "MEDIAN-PROGRAM"
    23	    symbol_name = (
    24	        sys.argv[3] if len(sys.argv) >= 4 else "solutionMedianClosure"
    25	    )
    26	    if not re.fullmatch(r"[A-Z][A-Z0-9-]*", module_name):
    27	        raise SystemExit("invalid K module name")
    28	    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9-]*", symbol_name):
    29	        raise SystemExit("invalid K symbol name")
    30	
    31	    source = source_path.read_text(encoding="utf-8")
    32	    tree = ast.parse(source, filename=str(source_path))
    33	
    34	    if len(tree.body) != 1 or not isinstance(tree.body[0], ast.FunctionDef):
    35	        raise SystemExit("solution.py must contain exactly one function definition")
    36	    function = tree.body[0]
    37	    if function.name != "median":
    38	        raise SystemExit("solution.py must define median")
    39	
    40	    py2mpy.SCOPES.clear()
    41	    py2mpy._walk_symtable(symtable.symtable(source, str(source_path), "exec"))
    42	    term = py2mpy.emit_stmt(function)
    43	    if term.name != "FuncDef" or len(term.args) != 3:
    44	        raise SystemExit("median must remain a capture-free function")
    45	
    46	    params = term.args[1]
    47	    body = term.args[2]
    48	    if params.name != "Params" or len(params.args) != 1:
    49	        raise SystemExit("median must retain its one-argument signature")
    50	
    51	    param_text = py2mpy.render(params.args[0])
    52	    body_text = py2mpy.render(body, 2)
    53	    indented_body = "\n".join("      " + line for line in body_text.splitlines())
    54	
    55	    print('requires "reference-semantics/semantics.k"')
    56	    print()
    57	    print(f"module {module_name}")
    58	    print("  imports MPY")
    59	    print()
    60	    print(f'  syntax Val ::= "{symbol_name}" [function, total]')
    61	    print(f"  rule {symbol_name}")
    62	    print("    => closureVal(")
    63	    print(f"      {param_text},")
    64	    print(indented_body + ",")
    65	    print("      0)")
    66	    print("endmodule")
