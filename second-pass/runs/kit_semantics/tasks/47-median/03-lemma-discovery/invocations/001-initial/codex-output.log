import json
from pathlib import Path

canonical = json.loads(Path('/reference/rule-inventory.json').read_text())
result = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert set(result) == {'schema_version', 'inventory_sha256', 'rules'}
assert result['schema_version'] == 2
assert result['inventory_sha256'] == canonical['inventory_sha256']
assert [r['source_rule_id'] for r in result['rules']] == [r['source_rule_id'] for r in canonical['rules']]
assert len({r['source_rule_id'] for r in result['rules']}) == len(result['rules'])
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for entry in result['rules']:
    assert set(entry) == {'source_rule_id', 'classification', 'rationale'}
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()

print('schema_ok=true')
print('inventory_hash_match=true')
print(f\"canonical_rule_count={len(canonical['rules'])}\")
print(f\"classified_rule_count={len(result['rules'])}\")
print('source_rule_id_order_and_uniqueness_ok=true')
