diff --git a/evidence/04-stage1-file-hash-map.txt b/evidence/04-stage1-file-hash-map.txt
new file mode 100644
index 0000000000000000000000000000000000000000..c38fe8df90cf9ea471021ce6155a6868832d1da3
--- /dev/null
+++ b/evidence/04-stage1-file-hash-map.txt
@@ -0,0 +1,36 @@
+COMMAND
+python3 - <<'PY'
+import hashlib, json
+from pathlib import Path
+ai = json.loads(Path('/audit-input.json').read_text())
+recorded = ai['resolution']['stage1_source_hashes']
+missing = []; mismatch = []; matched = 0
+for rel, expected in recorded.items():
+    path = Path('/reference/k-proof') / rel
+    if not path.is_file() or path.is_symlink():
+        missing.append(rel); continue
+    observed = hashlib.sha256(path.read_bytes()).hexdigest()
+    if observed == expected: matched += 1
+    else: mismatch.append({'path': rel, 'expected': expected, 'observed': observed})
+actual = sorted(p.relative_to('/reference/k-proof').as_posix()
+                for p in Path('/reference/k-proof').rglob('*')
+                if p.is_file() and not p.is_symlink())
+print(json.dumps({
+  'recorded_count': len(recorded),
+  'actual_regular_file_count': len(actual),
+  'matched_count': matched,
+  'missing': missing,
+  'mismatches': mismatch,
+  'unrecorded_actual_files': sorted(set(actual) - set(recorded)),
+}, indent=2, sort_keys=True))
+PY
+
+RESULT (exit 0)
+{
+  "actual_regular_file_count": 840,
+  "matched_count": 840,
+  "mismatches": [],
+  "missing": [],
+  "recorded_count": 840,
+  "unrecorded_actual_files": []
+}
