+    const char *path = getenv("PATH");
+    if (path == NULL) {
+        return NULL;
+    }
+    char *copy = strdup(path);
+    if (copy == NULL) {
+        return NULL;
+    }
+    char *cursor = copy;
+    char *directory;
+    char *resolved = NULL;
+    while ((directory = strsep(&cursor, ":")) != NULL) {
+        if (directory[0] == '\0') {
+            directory = ".";
+        }
