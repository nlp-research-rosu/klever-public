program.k:
     1	requires "reference-semantics/semantics.k"
     2	
     3	module MEDIAN-PROGRAM
     4	  imports MPY
     5	
     6	  syntax Val ::= "solutionMedianClosure" [function, total]
     7	  rule solutionMedianClosure
     8	    => closureVal(
     9	      "l",
    10	      Expr(
    11	            Str(
    12	              "Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    "))
    13	          Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
    14	          Assign(Name("size"), Call(Name("len"), Name("ordered")))
    15	          If(Compare(BinOp("%", Name("size"), Int(2)), CmpOp("==", Int(1))),
    16	            Return(
    17	              Subscript(Name("ordered"), BinOp("//", Name("size"), Int(2)))),
    18	            Return(
    19	              BinOp(
    20	                "/",
    21	                BinOp(
    22	                  "+",
    23	                  Subscript(
    24	                    Name("ordered"),
    25	                    BinOp("-", BinOp("//", Name("size"), Int(2)), Int(1))),
    26	                  Subscript(
    27	                    Name("ordered"),
    28	                    BinOp("//", Name("size"), Int(2)))),
    29	                Int(2)))),
    30	      0)
    31	endmodule
source solution:
     1	def median(l: list):
     2	    """Return median of elements in the list l.
     3	    >>> median([3, 1, 2, 4, 5])
     4	    3
     5	    >>> median([-10, 4, 6, 1000, 10, 20])
     6	    15.0
     7	    """
     8	    ordered = sorted(l)
     9	    size = len(ordered)
    10	    if size % 2 == 1:
    11	        return ordered[size // 2]
    12	    else:
    13	        return (ordered[size // 2 - 1] + ordered[size // 2]) / 2
