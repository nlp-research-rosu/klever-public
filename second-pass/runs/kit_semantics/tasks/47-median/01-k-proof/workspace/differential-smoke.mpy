Module(
  FuncDef("median", Params("l"),
    Expr(
      Str(
        "Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    "))
    Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
    Assign(Name("size"), Call(Name("len"), Name("ordered")))
    If(Compare(BinOp("%", Name("size"), Int(2)), CmpOp("==", Int(1))),
      Return(
        Subscript(Name("ordered"), BinOp("//", Name("size"), Int(2)))),
      Return(
        BinOp(
          "/",
          BinOp(
            "+",
            Subscript(
              Name("ordered"),
              BinOp("-", BinOp("//", Name("size"), Int(2)), Int(1))),
            Subscript(
              Name("ordered"),
              BinOp("//", Name("size"), Int(2)))),
          Int(2)))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(Int(3), Int(1), Int(2), Int(4), Int(5))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(
          UnaryOp("-", Int(10)),
          Int(4),
          Int(6),
          Int(1000),
          Int(10),
          Int(20))),
      CmpOp("==", Float(8.0))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(
          UnaryOp("-", Int(1152921504606846976)),
          Int(1152921504606846976))),
      CmpOp("==", Float(0.0))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(
          UnaryOp("-", Int(9007199254740993)),
          Int(9007199254740993),
          Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(UnaryOp("-", Int(2)))),
      CmpOp("==", UnaryOp("-", Int(2)))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(UnaryOp("-", Int(1)))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(Call(Name("median"), ListExpr(Int(0))), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("median"), ListExpr(Int(1))), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("median"), ListExpr(Int(2))), CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(UnaryOp("-", Int(2)), UnaryOp("-", Int(2)))),
      CmpOp("==", UnaryOp("-", Float(2.0)))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(UnaryOp("-", Int(2)), UnaryOp("-", Int(1)))),
      CmpOp("==", UnaryOp("-", Float(1.5)))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(UnaryOp("-", Int(2)), Int(0))),
      CmpOp("==", UnaryOp("-", Float(1.0)))))
  Assert(
