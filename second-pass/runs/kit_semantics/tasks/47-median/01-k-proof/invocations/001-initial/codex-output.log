+def median(l: list):
+    """Return median of elements in the list l.
+    >>> median([3, 1, 2, 4, 5])
+    3
+    >>> median([-10, 4, 6, 1000, 10, 20])
+    15.0
+    """
+    ordered = sorted(l)
+    size = len(ordered)
+    if size % 2 == 1:
+        return ordered[size // 2]
+    else:
+        return (ordered[size // 2 - 1] + ordered[size // 2]) / 2
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..26d8cbab24d15ae66e563ed02088d3be2e6e1b48
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,39 @@
+requires "verification-mutant.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION-MUTANT
+
+  claim [mutated-body-must-not-prove]:
+    <k>
+      Call(
+        Name("median"),
+        list(
+          vCons(
+            3,
+            vCons(1, vCons(2, vCons(4, vCons(5, .ValSeq)))))))
+      =>
+      3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        "median" |-> solutionMedianClosureMutant,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        sortVS(
+          vCons(
+            3,
+            vCons(1, vCons(2, vCons(4, vCons(5, .ValSeq)))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
