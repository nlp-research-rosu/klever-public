index 0000000000000000000000000000000000000000..26d8cbab24d15ae66e563ed02088d3be2e6e1b48
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,39 @@
+requires "verification-mutant.k"
+
+module SPEC-BODY-MUTATION
