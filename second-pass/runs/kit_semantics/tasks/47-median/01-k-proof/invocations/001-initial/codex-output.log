+       vsLen(sortVS(VS)) /Int 2 -Int 1) ==K B1
+     andBool valSeqAt(
+       sortVS(VS),
+       vsLen(sortVS(VS)) /Int 2) ==K B2
+     andBool notBool (HL in_keys(HP))
+
+  claim [median-even-float-float]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      divFloatIntV(addF(F1:Float, F2:Float), 2)
+    </k>
