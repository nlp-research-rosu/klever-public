+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        sortVS(
+          vCons(
+            3,
+            vCons(1, vCons(2, vCons(4, vCons(5, .ValSeq)))))))
