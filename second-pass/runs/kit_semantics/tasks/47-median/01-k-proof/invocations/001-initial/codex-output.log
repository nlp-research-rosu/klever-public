+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Odd-sized inputs: the result is the middle value of the sorted sequence.
+  claim [median-odd]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      valSeqAt(sortVS(VS), N:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      HP:Map
+      =>
+      (HL:Int |-> list(sortVS(VS))) HP
+    </heap>
+    <heapLoc> HL => HL +Int 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+     andBool vsLen(sortVS(VS)) ==Int 2 *Int N +Int 1
+     andBool notBool (HL in_keys(HP))
+
+  // Even-sized integer inputs: the two center integers are averaged.
+  claim [median-even-int-int]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      divII(I1:Int +Int I2:Int, 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      HP:Map
+      =>
+      (HL:Int |-> list(sortVS(VS))) HP
+    </heap>
+    <heapLoc> HL => HL +Int 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N:Int >=Int 1
+     andBool vsLen(sortVS(VS)) ==Int 2 *Int N
+     andBool valSeqAt(sortVS(VS), N -Int 1) ==K I1
+     andBool valSeqAt(sortVS(VS), N) ==K I2
+     andBool notBool (HL in_keys(HP))
+endmodule
