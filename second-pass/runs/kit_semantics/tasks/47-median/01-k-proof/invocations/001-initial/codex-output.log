+#!/usr/bin/env python3
+"""Generate the proof's exact closure value from solution.py."""
+
+from __future__ import annotations
+
+import ast
+import symtable
+import sys
+from pathlib import Path
+
+import py2mpy
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: generate_program_k.py SOLUTION.py")
+
+    source_path = Path(sys.argv[1])
+    source = source_path.read_text(encoding="utf-8")
+    tree = ast.parse(source, filename=str(source_path))
+
+    if len(tree.body) != 1 or not isinstance(tree.body[0], ast.FunctionDef):
+        raise SystemExit("solution.py must contain exactly one function definition")
+    function = tree.body[0]
+    if function.name != "median":
+        raise SystemExit("solution.py must define median")
+
+    py2mpy.SCOPES.clear()
+    py2mpy._walk_symtable(symtable.symtable(source, str(source_path), "exec"))
+    term = py2mpy.emit_stmt(function)
+    if term.name != "FuncDef" or len(term.args) != 3:
+        raise SystemExit("median must remain a capture-free function")
+
+    params = term.args[1]
+    body = term.args[2]
+    if params.name != "Params" or len(params.args) != 1:
+        raise SystemExit("median must retain its one-argument signature")
+
+    param_text = py2mpy.render(params.args[0])
+    body_text = py2mpy.render(body, 2)
+    indented_body = "\n".join("      " + line for line in body_text.splitlines())
+
+    print('requires "reference-semantics/semantics.k"')
+    print()
+    print("module MEDIAN-PROGRAM")
+    print("  imports MPY")
+    print()
+    print('  syntax Val ::= "solutionMedianClosure" [function, total]')
+    print("  rule solutionMedianClosure")
+    print("    => closureVal(")
+    print(f"      {param_text},")
+    print(indented_body + ",")
+    print("      0)")
+    print("endmodule")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f371f5bdb7a9fa5ad6a049629e3338a9727d2f4d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def median(l: list):
+    """Return median of elements in the list l.
+    >>> median([3, 1, 2, 4, 5])
+    3
+    >>> median([-10, 4, 6, 1000, 10, 20])
+    15.0
+    """
+    ordered = sorted(l)
+    size = len(ordered)
+    if size % 2 == 1:
+        return ordered[size // 2]
+    else:
+        return (ordered[size // 2 - 1] + ordered[size // 2]) / 2
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1043e10076c5ee485de21aa223c3350dab939b23
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,107 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Odd-sized inputs: the result is the middle value of the sorted sequence.
+  claim [median-odd]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      valSeqAt(
+        sortVS(VS),
+        (vsLen(sortVS(VS)) -Int 1) /Int 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      HP:Map
+      =>
+      (HL:Int |-> list(sortVS(VS))) HP
+    </heap>
+    <heapLoc> HL => HL +Int 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires vsLen(sortVS(VS)) >Int 0
+     andBool pyMod(vsLen(sortVS(VS)), 2) ==Int 1
+     andBool notBool (HL in_keys(HP))
+
+  // Even-sized inputs: exact fixed-semantics addition and true-division of
+  // the two center values. Numeric instances reduce through the supplied
+  // Int/Bool/Float rules; undefined Python operand classes are a model
+  // boundary recorded in PROOF.md.
+  claim [median-even]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      applyBin(
+        "/",
+        applyBin(
+          "+",
+          valSeqAt(
+            sortVS(VS),
+            vsLen(sortVS(VS)) /Int 2 -Int 1),
+          valSeqAt(
+            sortVS(VS),
+            vsLen(sortVS(VS)) /Int 2)),
+        2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      HP:Map
+      =>
+      (HL:Int |-> list(sortVS(VS))) HP
+    </heap>
+    <heapLoc> HL => HL +Int 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires vsLen(sortVS(VS)) >Int 0
+     andBool pyMod(vsLen(sortVS(VS)), 2) ==Int 0
+     andBool notBool (HL in_keys(HP))
+
+  // Even-sized integer inputs: the two center integers are averaged.
+  claim [median-even-int-int]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      divII(I1:Int +Int I2:Int, 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      HP:Map
+      =>
+      (HL:Int |-> list(sortVS(VS))) HP
+    </heap>
+    <heapLoc> HL => HL +Int 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires vsLen(sortVS(VS)) >Int 0
+     andBool pyMod(vsLen(sortVS(VS)), 2) ==Int 0
+     andBool valSeqAt(
+       sortVS(VS),
+       vsLen(sortVS(VS)) /Int 2 -Int 1) ==K I1
+     andBool valSeqAt(
+       sortVS(VS),
+       vsLen(sortVS(VS)) /Int 2) ==K I2
+     andBool notBool (HL in_keys(HP))
+endmodule
