+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Odd-sized inputs: the result is the middle value of the sorted sequence.
+  claim [median-odd]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      valSeqAt(
+        sortVS(VS),
+        (vsLen(sortVS(VS)) -Int 1) /Int 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      HP:Map
+      =>
+      (HL:Int |-> list(sortVS(VS))) HP
+    </heap>
+    <heapLoc> HL => HL +Int 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires vsLen(sortVS(VS)) >Int 0
+     andBool pyMod(vsLen(sortVS(VS)), 2) ==Int 1
+     andBool notBool (HL in_keys(HP))
+
+  // Even-sized inputs: exact fixed-semantics addition and true-division of
+  // the two center values. Numeric instances reduce through the supplied
+  // Int/Bool/Float rules; undefined Python operand classes are a model
+  // boundary recorded in PROOF.md.
+  claim [median-even]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      applyBin(
+        "/",
+        applyBin(
+          "+",
+          valSeqAt(
+            sortVS(VS),
+            vsLen(sortVS(VS)) /Int 2 -Int 1),
+          valSeqAt(
+            sortVS(VS),
+            vsLen(sortVS(VS)) /Int 2)),
+        2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      HP:Map
+      =>
+      (HL:Int |-> list(sortVS(VS))) HP
+    </heap>
+    <heapLoc> HL => HL +Int 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires vsLen(sortVS(VS)) >Int 0
+     andBool pyMod(vsLen(sortVS(VS)), 2) ==Int 0
+     andBool notBool (HL in_keys(HP))
+
+  // Even-sized integer inputs: the two center integers are averaged.
+  claim [median-even-int-int]:
+    <k>
+      Call(Name("median"), list(VS:ValSeq))
+      =>
+      divII(I1:Int +Int I2:Int, 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("median" |-> solutionMedianClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      HP:Map
+      =>
+      (HL:Int |-> list(sortVS(VS))) HP
+    </heap>
+    <heapLoc> HL => HL +Int 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires vsLen(sortVS(VS)) >Int 0
+     andBool pyMod(vsLen(sortVS(VS)), 2) ==Int 0
+     andBool valSeqAt(
+       sortVS(VS),
+       vsLen(sortVS(VS)) /Int 2 -Int 1) ==K I1
+     andBool valSeqAt(
+       sortVS(VS),
+       vsLen(sortVS(VS)) /Int 2) ==K I2
+     andBool notBool (HL in_keys(HP))
+endmodule
