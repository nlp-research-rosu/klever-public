diff --git a/evidence/procself_readlink.c b/evidence/procself_readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..456ba0f7957bfea713dfe66581aff18decabaa2b
--- /dev/null
+++ b/evidence/procself_readlink.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn next_readlink = NULL;
+  if (next_readlink == NULL) {
+    next_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  const size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return next_readlink("/proc/self/exe", buffer, size);
+  }
+  return next_readlink(path, buffer, size);
+}
