+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "+"
+        (stringVal (oneCode 97)) (stringVal (oneCode 98)) =
+      stringVal
+        (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 98 (oneCode 97)) := by
+  rfl
