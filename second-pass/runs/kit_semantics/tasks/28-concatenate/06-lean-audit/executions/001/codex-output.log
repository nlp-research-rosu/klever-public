+    "missing": sorted(
+        set(resolution["stage1_source_hashes"]) - set(observed_stage1_files)
+    ),
+    "extra": sorted(
+        set(observed_stage1_files) - set(resolution["stage1_source_hashes"])
+    ),
+    "mismatches": sorted(
+        name
+        for name in set(resolution["stage1_source_hashes"])
+        & set(observed_stage1_files)
