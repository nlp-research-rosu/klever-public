{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "d67f74749887fbf3e482ab3b5e009e306d6afabeb7e2bc1483cdcc5bc5d801aa",
      "rationale": "This is the defining projection equation for stringCodes on a semantic string, returning the string's IntSeq payload.",
      "source_rule_id": "rule-d67f74749887fbf3e482ab3b5e009e306d6afabeb7e2bc1483cdcc5bc5d801aa",
      "start_line": 10,
      "text": "  rule stringCodes(str(S:IntSeq)) => S"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "VERIFICATION",
      "normalized_sha256": "fd0940a4d6054e1358229d8416d82d1fdbd9fc9b81a95171ac29cc004419b996",
      "rationale": "This owise equation completes the total definition of the proof-local stringCodes projection on non-string Val constructors with its designated fallback.",
      "source_rule_id": "rule-fd0940a4d6054e1358229d8416d82d1fdbd9fc9b81a95171ac29cc004419b996",
      "start_line": 11,
      "text": "  rule stringCodes(_:Val) => .IntSeq [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "dcec90ae81b6468389e91083acc95d81ead6981ccababa579f6172a0a877a7e3",
      "rationale": "This is the base equation defining the proof-local isStringSeq predicate on the empty ValSeq.",
      "source_rule_id": "rule-dcec90ae81b6468389e91083acc95d81ead6981ccababa579f6172a0a877a7e3",
      "start_line": 15,
      "text": "  rule isStringSeq(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "7a72869f4d1d964b627bb3b06d70211a5e2d1d60583ce2a867ccbb8d7b284747",
      "rationale": "This is the structural recursive equation defining isStringSeq for a cons cell from the head string test and the predicate on the tail.",
      "source_rule_id": "rule-7a72869f4d1d964b627bb3b06d70211a5e2d1d60583ce2a867ccbb8d7b284747",
      "start_line": 16,
      "text": "  rule isStringSeq(vCons(V:Val, REST:ValSeq))\n    => (V ==K str(stringCodes(V))) andBool isStringSeq(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "caaa68653c6b00f190e89bd450eb4b1da239abda96d0efd431698e876453410d",
      "rationale": "This is the empty-sequence base equation for concatFrom, the proof-local mathematical left-fold summary.",
      "source_rule_id": "rule-caaa68653c6b00f190e89bd450eb4b1da239abda96d0efd431698e876453410d",
      "start_line": 23,
      "text": "  rule concatFrom(ACC:IntSeq, .ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "164607b7d03894ef15a07854149cb03c9b9031a6e6187bd89611899d0aaac54e",
      "rationale": "This is the guarded structural recurrence defining concatFrom by appending the current string payload and recurring on REST.",
      "source_rule_id": "rule-164607b7d03894ef15a07854149cb03c9b9031a6e6187bd89611899d0aaac54e",
      "start_line": 24,
      "text": "  rule concatFrom(ACC:IntSeq, vCons(V:Val, REST:ValSeq))\n    => concatFrom(seqConcat(ACC, stringCodes(V)), REST)\n    requires V ==K str(stringCodes(V))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "2bc2a66c772aae97380ca3ab3abdcf702833b825027b9f8fc0da1fe4878d02ac",
      "rationale": "This is the empty-sequence base equation for lastFrom, the named summary of the final loop-target value.",
      "source_rule_id": "rule-2bc2a66c772aae97380ca3ab3abdcf702833b825027b9f8fc0da1fe4878d02ac",
      "start_line": 31,
      "text": "  rule lastFrom(CURRENT:Val, .ValSeq) => CURRENT"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "8d075e2e7a462abce866779cfe5fc6c30b077acc04bc848e0e0bb58c1da430da",
      "rationale": "This is the guarded structural recurrence defining lastFrom by making the current head the loop-target value and recurring on REST.",
      "source_rule_id": "rule-8d075e2e7a462abce866779cfe5fc6c30b077acc04bc848e0e0bb58c1da430da",
      "start_line": 32,
      "text": "  rule lastFrom(_:Val, vCons(V:Val, REST:ValSeq))\n    => lastFrom(V, REST)\n    requires V ==K str(stringCodes(V))"
    }
  ],
