+    <heap> .Map => .Map </heap>
+    <heapLoc> 0 => 0 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+    <exit-code> 0 => 0 </exit-code>
+endmodule
diff --git a/evidence/spec-ground-witnesses.k b/evidence/spec-ground-witnesses.k
