+      =>
+      ?EMPTYSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap> .Map => .Map </heap>
+    <heapLoc> 0 => 0 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+    <exit-code> 0 => 0 </exit-code>
+
