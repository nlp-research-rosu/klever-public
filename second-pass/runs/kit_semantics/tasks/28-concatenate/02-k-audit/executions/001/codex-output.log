     7	  // equality that the symbolic backend can invert. The fallback is arbitrary
     8	  // but harmless: a non-string Val can never equal str(...).
     9	  syntax IntSeq ::= stringCodes(Val) [function, total]
    10	  rule stringCodes(str(S:IntSeq)) => S
    11	  rule stringCodes(_:Val) => .IntSeq [owise]
    12	
    13	  // True exactly for the ValSeq values that represent lists of strings.
    14	  syntax Bool ::= isStringSeq(ValSeq) [function, total]
    15	  rule isStringSeq(.ValSeq) => true
    16	  rule isStringSeq(vCons(V:Val, REST:ValSeq))
    17	    => (V ==K str(stringCodes(V))) andBool isStringSeq(REST)
    18	
    19	  // Mathematical left fold performed by concatenate's accumulator.
    20	  // It is intentionally partial outside isStringSeq(VS), which is the
    21	  // source-level List[str] domain used by every claim.
    22	  syntax IntSeq ::= concatFrom(IntSeq, ValSeq) [function]
    23	  rule concatFrom(ACC:IntSeq, .ValSeq) => ACC
    24	  rule concatFrom(ACC:IntSeq, vCons(V:Val, REST:ValSeq))
    25	    => concatFrom(seqConcat(ACC, stringCodes(V)), REST)
    26	    requires V ==K str(stringCodes(V))
    27	
    28	  // Exact final value of Python's loop target (the prior value for an empty
    29	  // remainder, otherwise the last element visited).
    30	  syntax Val ::= lastFrom(Val, ValSeq) [function]
    31	  rule lastFrom(CURRENT:Val, .ValSeq) => CURRENT
    32	  rule lastFrom(_:Val, vCons(V:Val, REST:ValSeq))
    33	    => lastFrom(V, REST)
    34	    requires V ==K str(stringCodes(V))
    35	
    36	  // Derived symbolic normalization of MPY-STR's concrete-string "+" case.
    37	  // Its guard is the exact equality needed to instantiate V as a string, so
    38	  // the RHS is identical to applyBin("+", str(A), str(B)).
    39	  rule applyBin("+", str(A:IntSeq), V:Val)
    40	    => str(seqConcat(A, stringCodes(V)))
    41	    requires V ==K str(stringCodes(V))
    42	    [simplification]
    43	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Base member of the loop-invariant family.
     7	  claim [concat-loop-empty]:
     8	    <k>
     9	      #loop(
    10	        list(.ValSeq),
    11	        Name("string"),
    12	        AugAssign(Name("result"), "+", Name("string"))
    13	      )
    14	      => .K
    15	      ...
    16	    </k>
    17	    <env> 1 </env>
    18	    <scopes>
    19	      -1 |-> builtinsScope
    20	      0 |-> scope(GLOBALS:Map, parent(-1))
    21	      1 |-> scope(
    22	        "result"  |-> str(ACC:IntSeq)
    23	        "string"  |-> CURRENT:Val
    24	        "strings" |-> list(ALL:ValSeq),
    25	        parent(0)
    26	      )
    27	      =>
    28	      -1 |-> builtinsScope
    29	      0 |-> scope(GLOBALS, parent(-1))
    30	      1 |-> scope(
    31	        "result"  |-> str(ACC)
    32	        "string"  |-> CURRENT
    33	        "strings" |-> list(ALL),
    34	        parent(0)
    35	      )
    36	    </scopes>
    37	
    38	  // Inductive member: one real MPY iteration executes, then the invariant
    39	  // applies to REST. The equality guard is exactly the List[str] head test.
    40	  claim [concat-loop-step]:
    41	    <k>
    42	      #loop(
    43	        list(vCons(HEAD:Val, REST:ValSeq)),
    44	        Name("string"),
    45	        AugAssign(Name("result"), "+", Name("string"))
    46	      )
    47	      => .K
    48	      ...
    49	    </k>
    50	    <env> 1 </env>
    51	    <scopes>
    52	      -1 |-> builtinsScope
    53	      0 |-> scope(GLOBALS:Map, parent(-1))
    54	      1 |-> scope(
    55	        "result"  |-> str(ACC:IntSeq)
    56	        "string"  |-> CURRENT:Val
    57	        "strings" |-> list(ALL:ValSeq),
    58	        parent(0)
    59	      )
    60	      =>
    61	      -1 |-> builtinsScope
    62	      0 |-> scope(GLOBALS, parent(-1))
    63	      1 |-> scope(
    64	        "result"  |-> str(concatFrom(ACC, vCons(HEAD, REST)))
    65	        "string"  |-> lastFrom(CURRENT, vCons(HEAD, REST))
    66	        "strings" |-> list(ALL),
    67	        parent(0)
    68	      )
    69	    </scopes>
    70	    requires HEAD ==K str(stringCodes(HEAD))
    71	     andBool isStringSeq(REST)
    72	
    73	  // Exact translated module load, binding, function body, call, and return.
    74	  claim [concatenate]:
    75	    <k>
    76	      #loadAll(
    77	        Module(
    78	          ImportFrom("typing", "List")
    79	          FuncDef(
    80	            "concatenate",
    81	            Params("strings"),
    82	            Assign(Name("result"), Str(""))
    83	            Assign(Name("string"), Str(""))
    84	            For(
    85	              Name("string"),
    86	              Name("strings"),
    87	              AugAssign(Name("result"), "+", Name("string"))
    88	            )
    89	            Return(Name("result"))
    90	          )
    91	        )
    92	      )
    93	      ~> Call(Name("concatenate"), list(VS:ValSeq))
    94	      => str(concatFrom(.IntSeq, VS))
    95	    </k>
    96	    <env> 0 </env>
    97	    <scopes>
    98	      0 |-> scope(.Map, parent(-1))
    99	      -1 |-> builtinsScope
   100	      =>
   101	      ?FINALSCOPES:Map
   102	    </scopes>
   103	    <scopeLoc> 1 => 1 </scopeLoc>
   104	    <heap> .Map => .Map </heap>
   105	    <heapLoc> 0 => 0 </heapLoc>
   106	    <stack> .List => .List </stack>
   107	    <ret> noRet => noRet </ret>
   108	    <exc> NoExc => NoExc </exc>
   109	    <exit-code> 0 => 0 </exit-code>
   110	    requires isStringSeq(VS)
