k=[]
for p in Path('/reference/k-proof/reference-semantics/semantics').glob('*.k'):
 for line in p.read_text().splitlines():
  m=re.search(r'rule applyBin\\(\"(["'^"]+)",'"\\s*(.*?),\\s*(.*?)\\)\\s*=>',line)
  if not m: continue
  op,a,b=m.groups()
  def sort(x):
   if ':Int' in x: return 'Int'
   if ':Float' in x: return 'Float'
   if ':Bool' in x: return 'Bool'
   if 'str(' in x: return 'Str'
   return '?'
  k.append((op,sort(a),sort(b)))
k_unique=list(dict.fromkeys(k))
print('frozen unique cases:',len(k_unique))
for x in k_unique: print(x)

s=Path('Proof.lean').read_text()
# Parse the intentionally uniform constructor arms in the applyBin definition.
pat=re.compile(r'"'^'"\\s*\\|\\s*\"(["'^"]+)"(?:,|'"\\s*"'$)'"',re.M)
ops=pat.findall(s[s.index('def «applyBin'):s.index('/- KORE symbol: LblseqConcat')])
print('Lean applyBin arms:',len(ops),ops)
