+import random
+
+from solution import concatenate
+
+
+def main() -> None:
+    rng = random.Random(20260724)
+    alphabet = ["", "a", "Z", " ", "\n", "é", "λ", "🙂"]
+    cases = [
+        [],
+        [""],
+        ["a", "b", "c"],
+        ["", "xy", "", "z"],
+        ["é", "λ", "🙂"],
+    ]
