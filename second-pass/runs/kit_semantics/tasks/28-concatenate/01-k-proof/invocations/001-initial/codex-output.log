+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // One loop head summarizes precisely the remaining list and accumulator.
+  // The arbitrary continuation is preserved by the reachability-claim frame;
+  // fixed MPY rules execute target binding and the AugAssign body.
+  claim [concat-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("string"),
+        AugAssign(Name("result"), "+", Name("string"))
+      )
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(M:Map, P:Parent)
+      => L |-> scope(?M:Map, P)
+      ...
+    </scopes>
+    requires isStringSeq(VS)
+     andBool "result" in_keys(M)
+     andBool notBool ("$cells" in_keys(M))
+     andBool {M["result"]}:>Val ==K str(ACC:IntSeq)
+    ensures "result" in_keys(?M)
+     andBool {?M["result"]}:>Val ==K str(concatFrom(ACC, VS))
+
+  // Exact translated module load, binding, function body, call, and return.
+  claim [concatenate]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "concatenate",
+            Params("strings"),
+            Assign(Name("result"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              AugAssign(Name("result"), "+", Name("string"))
+            )
+            Return(Name("result"))
+          )
+        )
+      )
+      ~> Call(Name("concatenate"), list(VS:ValSeq))
+      => str(concatFrom(.IntSeq, VS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap> .Map => .Map </heap>
+    <heapLoc> 0 => 0 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+    <exit-code> 0 => 0 </exit-code>
+    requires isStringSeq(VS)
+endmodule
