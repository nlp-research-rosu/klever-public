diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9e6ee92a0bb8b7dd83a1b00ae13516588dd780b3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,111 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Base member of the loop-invariant family.
+  claim [concat-loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("string"),
+        AugAssign(Name("result"), "+", Name("string"))
+      )
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      1 |-> scope(
+        "result"  |-> str(ACC:IntSeq)
+        "string"  |-> CURRENT:Val
+        "strings" |-> list(ALL:ValSeq),
+        parent(0)
+      )
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS, parent(-1))
+      1 |-> scope(
+        "result"  |-> str(ACC)
+        "string"  |-> CURRENT
+        "strings" |-> list(ALL),
+        parent(0)
+      )
+    </scopes>
+
+  // Inductive member: one real MPY iteration executes, then the invariant
+  // applies to REST. The equality guard is exactly the List[str] head test.
+  claim [concat-loop-step]:
+    <k>
+      #loop(
+        list(vCons(HEAD:Val, REST:ValSeq)),
+        Name("string"),
+        AugAssign(Name("result"), "+", Name("string"))
+      )
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      1 |-> scope(
+        "result"  |-> str(ACC:IntSeq)
+        "string"  |-> CURRENT:Val
+        "strings" |-> list(ALL:ValSeq),
+        parent(0)
+      )
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS, parent(-1))
+      1 |-> scope(
+        "result"  |-> str(concatFrom(ACC, vCons(HEAD, REST)))
+        "string"  |-> lastFrom(CURRENT, vCons(HEAD, REST))
+        "strings" |-> list(ALL),
+        parent(0)
+      )
+    </scopes>
+    requires HEAD ==K str(stringCodes(HEAD))
+     andBool isStringSeq(REST)
+
+  // Exact translated module load, binding, function body, call, and return.
+  claim [concatenate]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "concatenate",
+            Params("strings"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              AugAssign(Name("result"), "+", Name("string"))
+            )
+            Return(Name("result"))
+          )
+        )
+      )
+      ~> Call(Name("concatenate"), list(VS:ValSeq))
+      => str(concatFrom(.IntSeq, VS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap> .Map => .Map </heap>
+    <heapLoc> 0 => 0 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+    <exit-code> 0 => 0 </exit-code>
+    requires isStringSeq(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d21cb3ad61c0256817cb512f84488272c869b04b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A total projection used only to express the string-sort recognizer as an
+  // equality that the symbolic backend can invert. The fallback is arbitrary
+  // but harmless: a non-string Val can never equal str(...).
+  syntax IntSeq ::= stringCodes(Val) [function, total]
+  rule stringCodes(str(S:IntSeq)) => S
+  rule stringCodes(_:Val) => .IntSeq [owise]
+
+  // True exactly for the ValSeq values that represent lists of strings.
+  syntax Bool ::= isStringSeq(ValSeq) [function, total]
+  rule isStringSeq(.ValSeq) => true
+  rule isStringSeq(vCons(V:Val, REST:ValSeq))
+    => (V ==K str(stringCodes(V))) andBool isStringSeq(REST)
+
+  // Mathematical left fold performed by concatenate's accumulator.
+  // It is intentionally partial outside isStringSeq(VS), which is the
+  // source-level List[str] domain used by every claim.
+  syntax IntSeq ::= concatFrom(IntSeq, ValSeq) [function]
+  rule concatFrom(ACC:IntSeq, .ValSeq) => ACC
+  rule concatFrom(ACC:IntSeq, vCons(V:Val, REST:ValSeq))
+    => concatFrom(seqConcat(ACC, stringCodes(V)), REST)
+    requires V ==K str(stringCodes(V))
+
+  // Exact final value of Python's loop target (the prior value for an empty
+  // remainder, otherwise the last element visited).
+  syntax Val ::= lastFrom(Val, ValSeq) [function]
+  rule lastFrom(CURRENT:Val, .ValSeq) => CURRENT
+  rule lastFrom(_:Val, vCons(V:Val, REST:ValSeq))
+    => lastFrom(V, REST)
+    requires V ==K str(stringCodes(V))
+
+  // Derived symbolic normalization of MPY-STR's concrete-string "+" case.
+  // Its guard is the exact equality needed to instantiate V as a string, so
+  // the RHS is identical to applyBin("+", str(A), str(B)).
+  rule applyBin("+", str(A:IntSeq), V:Val)
+    => str(seqConcat(A, stringCodes(V)))
+    requires V ==K str(stringCodes(V))
+    [simplification]
+endmodule

