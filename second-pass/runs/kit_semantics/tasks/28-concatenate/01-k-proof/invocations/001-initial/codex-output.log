+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("string"),
+        AugAssign(Name("result"), "+", Name("string"))
+      )
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(M:Map, P:Parent)
+      => L |-> scope(?M:Map, P)
+      ...
