diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..f15c96c3bd5cf55c941c96120778df69387033f4
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,14 @@
+from typing import List
+
+
+def concatenate(strings: List[str]) -> str:
+    result = ""
+    string = ""
+    for string in strings:
+        result += string
+    return result
+
+
+empty = concatenate([])
+example = concatenate(["a", "b", "c"])
+mixed = concatenate(["", "xy", "", "z"])
diff --git a/differential_tests.py b/differential_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..d9e0b472f9dcfd629709bec70d0de2f8c2223894
--- /dev/null
+++ b/differential_tests.py
@@ -0,0 +1,38 @@
+import random
+
+from solution import concatenate
+
+
+def main() -> None:
+    rng = random.Random(20260724)
+    alphabet = ["", "a", "Z", " ", "\n", "é", "λ", "🙂"]
+    cases = [
+        [],
+        [""],
+        ["a", "b", "c"],
+        ["", "xy", "", "z"],
+        ["é", "λ", "🙂"],
+    ]
+    for _ in range(250):
+        cases.append(
+            [
+                "".join(rng.choice(alphabet) for _ in range(rng.randrange(5)))
+                for _ in range(rng.randrange(9))
+            ]
+        )
+
+    mismatches = 0
+    for strings in cases:
+        expected = "".join(strings)
+        actual = concatenate(strings)
+        if actual != expected:
+            mismatches += 1
+            print("MISMATCH", repr(strings), repr(actual), repr(expected))
+
+    print(f"cases={len(cases)} mismatches={mismatches}")
+    if mismatches:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
