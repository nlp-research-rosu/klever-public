Module(
  FuncDef("compare", Params("game", "guess"),
    Assign(Name("result"), ListExpr())
    For(TupleExpr(Name("score"), Name("predicted")), Call(Name("zip"), Name("game"), Name("guess")),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Call(
            Name("abs"),
            BinOp("-", Name("score"), Name("predicted"))))))
    Return(Name("result"))))
