/bin/bash -lc "/audit-output/evidence/run-evidence.sh 01f-independent-and-pipeline-tree-hashes.log /audit-output/evidence/verify_tree_hashes.py && sed -n '1,180p' /audit-output/evidence/01f-independent-and-pipeline-tree-hashes.log" in /audit-output
