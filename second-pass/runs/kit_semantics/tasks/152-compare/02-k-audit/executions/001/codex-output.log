+def compare(game, guess):
+    result = []
+    for score, predicted in zip(game, guess):
+        result.append(abs(score - predicted))
+    return result
+
+
+assert compare([], []) == []
+assert compare([0], [0]) == [0]
+assert compare([5], [2]) == [3]
+assert compare([2], [5]) == [3]
