+                  BinOp(
+                    "+",
+                    Call(
+                      Name("abs"),
+                      BinOp("-", Name("score"), Name("predicted"))),
+                    Int(1))))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)
