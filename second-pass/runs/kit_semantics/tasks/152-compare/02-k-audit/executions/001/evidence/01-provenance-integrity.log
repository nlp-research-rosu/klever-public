COMMAND: bash -o pipefail -c $'\nset -u\nprintf "== campaign block canonical comparison ==\\n"\njq -S .audit_campaign /audit-input.json > /tmp/audit-work/audit-campaign-block.json\njq -S . /audit-campaign-lock.json > /tmp/audit-work/audit-campaign-lock-normalized.json\ncmp /tmp/audit-work/audit-campaign-block.json /tmp/audit-work/audit-campaign-lock-normalized.json\nprintf "campaign_block_cmp=%d\\n" "$?"\nprintf "== declared direct hashes and actual hashes ==\\n"\nfor item in \\\n  audit_campaign_lock:/audit-campaign-lock.json:.hashes.audit_campaign_lock_sha256 \\\n  canonical:/reference/canonical.py:.hashes.canonical_sha256 \\\n  candidate_prompt:/candidate/prompt.py:.hashes.candidate_prompt_sha256 \\\n  trusted_prompt:/reference/prompt.py:.hashes.trusted_prompt_sha256 \\\n  candidate_translator:/candidate/py2mpy.py:.hashes.candidate_translator_sha256 \\\n  trusted_translator:/reference/py2mpy.py:.hashes.trusted_translator_sha256 \\\n  run_manifest:/run.json:.hashes.run_manifest_sha256 \\\n  task_manifest:/task.json:.hashes.task_manifest_sha256 \\\n  stage1_result:/generation-result.json:.hashes.stage1_result_sha256 \\\n  stage1_invocation:/generation-evidence/invocation.json:.hashes.stage1_invocation_sha256 \\\n  generation_metrics:/generation-evidence/metrics.json:.hashes.generation_metrics_sha256 \\\n  generation_runtime_metrics:/generation-evidence/runtime-metrics.json:.hashes.generation_runtime_metrics_sha256 \\\n  generation_usage:/generation-evidence/usage.json:.hashes.generation_usage_sha256 \\\n  generation_last:/generation-evidence/codex-last.txt:.hashes.generation_codex_last_sha256 \\\n  generation_output:/generation-evidence/codex-output.log:.hashes.generation_codex_output_sha256 \\\n  generation_prompt:/generation-evidence/prompt.txt:.hashes.generation_prompt_sha256; do\n  IFS=: read -r label path jqpath <<< "$item"\n  actual=$(sha256sum "$path" | cut -d" " -f1)\n  expected=$(jq -r "$jqpath" /audit-input.json)\n  printf "%s actual=%s expected=%s match=%s\\n" "$label" "$actual" "$expected" "$([[ "$actual" == "$expected" ]] && echo yes || echo NO)"\ndone\nprintf "== required paths and file types ==\\n"\nfor path in /candidate /reference/canonical.py /reference/prompt.py /reference/py2mpy.py /reference/reference-semantics /audit-campaign-lock.json /run.json /task.json /generation-result.json /generation-evidence/invocation.json /generation-evidence/metrics.json /generation-evidence/runtime-metrics.json /generation-evidence/usage.json /generation-evidence/codex-last.txt /generation-evidence/codex-output.log /generation-evidence/prompt.txt /generation-evidence/codex-trace; do\n  stat -c "%F|%a|%s|%n" "$path"\ndone\nprintf "== symlinks in required mounts ==\\n"\nfind /candidate /reference /generation-evidence -type l -printf "%p -> %l\\n"\nprintf "== candidate/trusted prompt translator comparisons ==\\n"\ncmp /candidate/prompt.py /reference/prompt.py; printf "prompt_cmp=%d\\n" "$?"\ncmp /candidate/py2mpy.py /reference/py2mpy.py; printf "translator_cmp=%d\\n" "$?"\nprintf "== supplied semantics recursive comparison ==\\n"\ndiff -r --no-dereference /candidate/reference-semantics /reference/reference-semantics\nprintf "semantics_diff=%d\\n" "$?"\nprintf "== supplied semantics manifests ==\\n"\nfind /candidate/reference-semantics -printf "%y|%P\\n" | LC_ALL=C sort\nfind /reference/reference-semantics -printf "%y|%P\\n" | LC_ALL=C sort\n'
