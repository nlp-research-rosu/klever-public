{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 8,
      "module": "VERIFICATION",
      "normalized_sha256": "29a9419a5013224a8657110320f5222d8360897d1c1ad05d5b21b9a8a070d15a",
      "rationale": "This is the left-empty defining equation for the newly introduced structural predicate sameIntLists; it defines the result by requiring the right sequence to be empty and does not assert a separate mathematical fact or execute the program.",
      "source_rule_id": "rule-29a9419a5013224a8657110320f5222d8360897d1c1ad05d5b21b9a8a070d15a",
      "start_line": 7,
      "text": "  rule sameIntLists(.ValSeq, PREDICTIONS:ValSeq)\n    => PREDICTIONS ==K .ValSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "VERIFICATION",
      "normalized_sha256": "4c226b697298ea8f665e9c7a275c999f5ca1704cf1bffeda3ab4c575a950d681",
      "rationale": "This is the structural mismatch equation of the newly introduced sameIntLists predicate, defining a nonempty left sequence paired with an empty right sequence as false.",
      "source_rule_id": "rule-4c226b697298ea8f665e9c7a275c999f5ca1704cf1bffeda3ab4c575a950d681",
      "start_line": 9,
      "text": "  rule sameIntLists(vCons(_:Val, _:ValSeq), .ValSeq) => false"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "23a1b598b8aca7e64fdbbbdf6c2eba606e3434ffea5d8b33eb5ff9c67a39d82f",
      "rationale": "This is the recursive constructor equation defining sameIntLists on two nonempty sequences; its head constraints and recursive tail call constitute the predicate's definition, and recursion descends on both tails.",
      "source_rule_id": "rule-23a1b598b8aca7e64fdbbbdf6c2eba606e3434ffea5d8b33eb5ff9c67a39d82f",
      "start_line": 10,
      "text": "  rule sameIntLists(\n         vCons(SCORE:Val, SCORES:ValSeq),\n         vCons(PREDICTED:Val, PREDICTIONS:ValSeq))\n    => isInt(SCORE)\n       andBool isInt(PREDICTED)\n       andBool notBool isRefV(SCORE)\n       andBool notBool isRefV(PREDICTED)\n       andBool notBool isRefV(applyBin(\"-\", SCORE, PREDICTED))\n       andBool sameIntLists(SCORES, PREDICTIONS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "35d6b10b3b07c6654b6990fa450ff659514b515f9afb5c4ddcd292c7a52a4d4e",
      "rationale": "This is the base equation for the newly introduced accumulator summary compareAcc, defining two exhausted input tails to return the accumulated sequence.",
      "source_rule_id": "rule-35d6b10b3b07c6654b6990fa450ff659514b515f9afb5c4ddcd292c7a52a4d4e",
      "start_line": 21,
      "text": "  rule compareAcc(ACC:ValSeq, .ValSeq, .ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "b6a35c28b2d565d80431890d82ed0b37f41b8e521dd15d430123581b67f0d014",
      "rationale": "This is the recursive equation defining compareAcc: it appends the fixed-semantics term for the current absolute difference and recurs on both tails, thereby defining the named output summary rather than adding an independent lemma.",
      "source_rule_id": "rule-b6a35c28b2d565d80431890d82ed0b37f41b8e521dd15d430123581b67f0d014",
      "start_line": 22,
      "text": "  rule compareAcc(ACC:ValSeq,\n                  vCons(SCORE:Val, SCORES:ValSeq),\n                  vCons(PREDICTED:Val, PREDICTIONS:ValSeq))\n    => compareAcc(\n         valSeqConcat(\n           ACC,\n           vCons(\n             applyBuiltin(\n               \"abs\",\n               applyBin(\"-\", SCORE, PREDICTED),\n               .Vals),\n             .ValSeq)),\n         SCORES,\n         PREDICTIONS)"
    }
  ],
