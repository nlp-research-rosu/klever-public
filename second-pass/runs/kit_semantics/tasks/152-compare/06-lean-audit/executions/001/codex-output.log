codex
The root cause is now concrete: Lean 4.22 resolves its executable as `/proc/<getpid>/exe`, but this sandbox reports namespace PID `2` while `/proc` exposes host PIDs; `/proc/2/exe` does not exist. I’m applying a narrowly scoped preload shim that only makes `getpid()` return the host PID obtained from `/proc/self`, then retesting the unchanged pinned binaries. This is an audit-environment repair, not a candidate or provenance modification.
apply patch
patch: completed
/tmp/audit-work/hostpid_shim.c
diff --git a//tmp/audit-work/hostpid_shim.c b//tmp/audit-work/hostpid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..8a533deddfa758988e94309d4f4b036d5996f849
--- /dev/null
+++ b//tmp/audit-work/hostpid_shim.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * Lean 4.22's IO.appPath asks readlink("/proc/<getpid>/exe").  The audit
+ * sandbox's PID namespace and procfs mount are not aligned: getpid() returns
+ * the namespace PID, while /proc exposes the host PID.  /proc/self remains
+ * correct, so return that host PID.  Scope this shim only to Lean/Lake audit
+ * commands via LD_PRELOAD.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        return (pid_t)-1;
+    }
+    target[length] = '\0';
+    errno = 0;
+    char *end = NULL;
+    long value = strtol(target, &end, 10);
+    if (errno != 0 || end == target || *end != '\0' || value <= 0 || value > INT_MAX) {
+        return (pid_t)-1;
+    }
+    return (pid_t)value;
+}
