+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        return (pid_t)-1;
+    }
+    target[length] = '\0';
+    errno = 0;
