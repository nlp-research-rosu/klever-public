--- verification.k ---
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // True exactly when every element of the modeled Python list is an integer.
     7	  syntax Bool ::= allInts(ValSeq) [function, total]
     8	  rule allInts(.ValSeq)                => true
     9	  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)
    10	
    11	  // Append the alternating leftmost/rightmost elements from S[L..R] to A.
    12	  // The three guards partition all integer bounds, and recursive calls shrink
    13	  // R - L by two.
    14	  syntax ValSeq ::= strangeAcc(ValSeq, ValSeq, Int, Int) [function, total]
    15	  rule strangeAcc(A:ValSeq, _:ValSeq, L:Int, R:Int) => A
    16	    requires L >Int R
    17	  rule strangeAcc(A:ValSeq, S:ValSeq, L:Int, R:Int)
    18	    => valSeqConcat(A, vCons(valSeqAt(S, L), .ValSeq))
    19	    requires L ==Int R
    20	  rule strangeAcc(A:ValSeq, S:ValSeq, L:Int, R:Int)
    21	    => strangeAcc(
    22	         valSeqConcat(
    23	           valSeqConcat(A, vCons(valSeqAt(S, L), .ValSeq)),
    24	           vCons(valSeqAt(S, R), .ValSeq)),
    25	         S, L +Int 1, R -Int 1)
    26	    requires L <Int R
    27	
    28	  // Removing a known-present integer key from a disjoint Map fragment leaves
    29	  // exactly that fragment. This only canonicalizes the Map update emitted by
    30	  // the fixed #pop rule.
    31	  rule (M:Map K:Int |-> _V:Scope) [K <- undef] => M
    32	    requires notBool K in_keys(M)
    33	    [simplification]
    34	endmodule
