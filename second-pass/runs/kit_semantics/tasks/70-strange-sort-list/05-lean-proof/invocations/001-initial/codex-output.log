diff --git a/lean_pidshim.c b/lean_pidshim.c
new file mode 100644
index 0000000000000000000000000000000000000000..f2f33c3375e04a964137f5712e54c96f313be2e9
--- /dev/null
+++ b/lean_pidshim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length > 0) {
+        target[length] = '\0';
+        pid_t pid = 0;
+        for (ssize_t index = 0; index < length; ++index) {
+            if (target[index] < '0' || target[index] > '9') {
+                pid = 0;
+                break;
+            }
+            pid = (pid_t)(pid * 10 + (target[index] - '0'));
+        }
+        if (pid > 0) {
+            return pid;
+        }
+    }
+    return (pid_t)syscall(SYS_getpid);
+}

