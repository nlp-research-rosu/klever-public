      "module": "VERIFICATION",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "Base equation of the total structural predicate allInts; it defines the predicate on the empty ValSeq and adds no independent mathematical fact.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 8,
      "text": "  rule allInts(.ValSeq)                => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "VERIFICATION",
      "normalized_sha256": "bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "rationale": "Recursive equation defining allInts on a nonempty ValSeq by testing the head and recurring on the strict tail.",
      "source_rule_id": "rule-bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "start_line": 9,
      "text": "  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "7e05d593a11ac1688b57228d1e3402caa7bde6bf8a21122047627bf83e3662d2",
      "rationale": "Guarded base case of the strangeAcc mathematical summary: once the left bound has crossed the right bound, the named accumulator result is A.",
      "source_rule_id": "rule-7e05d593a11ac1688b57228d1e3402caa7bde6bf8a21122047627bf83e3662d2",
      "start_line": 15,
      "text": "  rule strangeAcc(A:ValSeq, _:ValSeq, L:Int, R:Int) => A\n    requires L >Int R"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "e5cf5fe356747eca4563d29d41d439e5617c1c39a5f5f46120ed36322a8c30f3",
      "rationale": "Guarded singleton case defining strangeAcc when the bounds coincide by appending the sole remaining indexed value.",
      "source_rule_id": "rule-e5cf5fe356747eca4563d29d41d439e5617c1c39a5f5f46120ed36322a8c30f3",
      "start_line": 17,
      "text": "  rule strangeAcc(A:ValSeq, S:ValSeq, L:Int, R:Int)\n    => valSeqConcat(A, vCons(valSeqAt(S, L), .ValSeq))\n    requires L ==Int R"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "ec00b8b164e1c0f6d16eef935ec05c2166e772018597863b95e7d0f0326eada7",
      "rationale": "Guarded recursive case defining strangeAcc by appending the left and right values and recurring on the strictly smaller interval.",
      "source_rule_id": "rule-ec00b8b164e1c0f6d16eef935ec05c2166e772018597863b95e7d0f0326eada7",
      "start_line": 20,
      "text": "  rule strangeAcc(A:ValSeq, S:ValSeq, L:Int, R:Int)\n    => strangeAcc(\n         valSeqConcat(\n           valSeqConcat(A, vCons(valSeqAt(S, L), .ValSeq)),\n           vCons(valSeqAt(S, R), .ValSeq)),\n         S, L +Int 1, R -Int 1)\n    requires L <Int R"
    }
  ],
