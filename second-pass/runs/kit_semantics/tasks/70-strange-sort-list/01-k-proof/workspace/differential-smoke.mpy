Module(
  FuncDef("strange_sort_list", Params("lst"),
    Assign(Name("ordered"), Call(Name("sorted"), Name("lst")))
    Assign(Name("result"), ListExpr())
    Assign(Name("left"), Int(0))
    Assign(
      Name("right"),
      BinOp("-", Call(Name("len"), Name("ordered")), Int(1)))
    While(Compare(Name("left"), CmpOp("<", Name("right"))),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Subscript(Name("ordered"), Name("left"))))
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Subscript(Name("ordered"), Name("right"))))
      AugAssign(Name("left"), "+", Int(1))
      AugAssign(Name("right"), "-", Int(1)))
    If(Compare(Name("left"), CmpOp("==", Name("right"))),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Subscript(Name("ordered"), Name("left")))),
      )
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("strange_sort_list"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("strange_sort_list"), ListExpr(UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr(UnaryOp("-", Int(1))))))
  Assert(
    Compare(
      Call(Name("strange_sort_list"), ListExpr(Int(0))),
      CmpOp("==", ListExpr(Int(0)))))
  Assert(
    Compare(
      Call(Name("strange_sort_list"), ListExpr(Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("strange_sort_list"),
        ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(1))))))
  Assert(
