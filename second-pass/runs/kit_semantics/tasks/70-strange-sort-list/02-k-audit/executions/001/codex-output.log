+  /generation-evidence/codex-trace \
+  /candidate \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /reference/reference-semantics
+do
+  if [[ -L "$path" ]]; then
+    kind=symlink
+  elif [[ -f "$path" ]]; then
+    kind=file
+  elif [[ -d "$path" ]]; then
+    kind=directory
+  else
