+  /reference/py2mpy.py \
+  /reference/reference-semantics
+do
+  if [[ -L "$path" ]]; then
+    kind=symlink
+  elif [[ -f "$path" ]]; then
+    kind=file
+  elif [[ -d "$path" ]]; then
+    kind=directory
+  else
+    kind=missing-or-other
+  fi
+  if [[ -r "$path" ]]; then readable=yes; else readable=no; fi
