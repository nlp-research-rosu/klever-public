@@ -0,0 +1,20 @@
+def strange_sort_list(lst):
+    ordered = sorted(lst)
+    result = []
+    left = 0
+    right = len(ordered) - 1
+    while left < right:
+        result.append(ordered[left])
+        result.append(ordered[right])
+        left += 1
+        right -= 1
+    if left == right:
+        result.append(ordered[left])
+    return result
+
+
+case_empty = strange_sort_list([])
+case_singleton = strange_sort_list([9])
+case_even = strange_sort_list([1, 2, 3, 4])
+case_duplicates = strange_sort_list([5, 5, 5, 5])
+case_odd_negative = strange_sort_list([4, -1, 3, 2, 0])

exec
/bin/bash -lc 'cp /audit-output/evidence/03_concrete.py /tmp/audit-work/reconstruction.tZYoqF/03_concrete.py
python3 /reference/py2mpy.py /tmp/audit-work/reconstruction.tZYoqF/03_concrete.py > /tmp/audit-work/reconstruction.tZYoqF/03_concrete.mpy
test ! -e runtime-fresh-kompiled
printf '"'fresh_runtime_output_absent_exit=%s\\n' \""'$?"
kompile --backend llvm reference-semantics/semantics.k --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition runtime-fresh-kompiled
printf '"'llvm_kompile_exit=%s\\n' \""'$?"
krun 03_concrete.mpy --definition runtime-fresh-kompiled
status=$?
printf '"'concrete_krun_exit=%s\\n' \""'$status"
exit "$status"' in /tmp/audit-work/reconstruction.tZYoqF
