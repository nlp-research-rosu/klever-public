+        "generator_manifest": generator["target"],
+        "audit_input": audit["target"],
+        "expected_definition_sha256": (
+            sha256_text(expected_definition)
+            if expected_definition is not None
+            else None
+        ),
+        "all_equal": target == generator["target"] == audit["target"],
