codex
The root cause is now concrete: this sandbox reports a process PID that is absent from its mounted `/proc`, while Lean 4.22 resolves its own executable through `/proc/<getpid()>/exe`. A direct witness produced `getpid() = 9` and `ENOENT` for `/proc/9/exe`; `/proc/self/exe` remains valid. I’ll use a narrowly scoped `LD_PRELOAD` shim in `/tmp/audit-work` that redirects only `/proc/<digits>/exe` readlinks to `/proc/self/exe`, then rerun the unchanged trusted preflight and all required fresh builds.
apply patch
patch: completed
/tmp/audit-work/proc_readlink_shim.c
diff --git a//tmp/audit-work/proc_readlink_shim.c b//tmp/audit-work/proc_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..dad3f9730bc726ffb84df8dec2ee93818c70a513
--- /dev/null
+++ b//tmp/audit-work/proc_readlink_shim.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    const char *cursor;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+        cursor = path + 6;
+        if (*cursor >= '0' && *cursor <= '9') {
+            while (*cursor >= '0' && *cursor <= '9') {
+                cursor++;
+            }
+            if (strcmp(cursor, "/exe") == 0) {
+                path = "/proc/self/exe";
+            }
+        }
+    }
+
+    return real_readlink(path, buffer, size);
+}

