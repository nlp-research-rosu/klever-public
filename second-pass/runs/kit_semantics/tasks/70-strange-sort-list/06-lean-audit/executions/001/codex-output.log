+import Proof
+
+namespace BridgeAudit
+
+noncomputable local instance : DecidableEq SortKItem :=
+  Classical.typeDecidableEq SortKItem
+
+private def k0 : SortKItem := SortKItem.inj_SortInt 0
+private def k1 : SortKItem := SortKItem.inj_SortInt 1
+private def v0 : SortKItem := SortKItem.inj_SortBool false
+private def v1 : SortKItem := SortKItem.inj_SortBool true
+
+example :
+    (Proof._Map_ ⟨[(k0, v0)]⟩ ⟨[(k1, v1)]⟩).coll =
+      [(k0, v0), (k1, v1)] := by
+  rfl
+
+example :
+    (Proof.«_|->_» k0 v0).coll = [(k0, v0)] := by
+  rfl
+
+example :
+    Proof.«_in_keys(_)_MAP_Bool_KItem_Map» k0
+      ⟨[(k0, v0), (k1, v1)]⟩ = true := by
+  change (if k0 = k0 then true else _) = true
+  simp
+
+example :
+    Proof.«_in_keys(_)_MAP_Bool_KItem_Map» k1
+      ⟨[(k0, v0)]⟩ = false := by
+  change (if k0 = k1 then true else false) = false
+  simp [k0, k1]
+
+example :
+    (Proof.«_[_<-undef]» ⟨[(k0, v0), (k1, v1)]⟩ k0).coll =
+      [(k1, v1)] := by
+  change
+    (if k0 = k0 then
+      (if k1 = k0 then [] else [(k1, v1)])
+    else _) = [(k1, v1)]
+  simp [k0, k1]
+
+example : Proof.notBool_ true = false := by
+  rfl
+
+example : Proof.notBool_ false = true := by
+  rfl
+
+def identityMap (left _right : SortMap) : SortMap := left
+def identityDelete (map : SortMap) (_key : SortKItem) : SortMap := map
+
+theorem counterfactualIdentitiesAlsoProveTarget :
+    Klean70StrangeSortList.Lemmas.targetStatement
+      identityMap
+      Proof.«_in_keys(_)_MAP_Bool_KItem_Map»
+      identityDelete
+      Proof.«_|->_»
+      Proof.notBool_ := by
+  intro _K _V M _h
+  rfl
+
+def constantContains (_key : SortKItem) (_map : SortMap) : SortBool := true
+def constantNot (_value : SortBool) : SortBool := false
+
+theorem counterfactualVacuityAlsoProvesTarget :
+    Klean70StrangeSortList.Lemmas.targetStatement
+      Proof._Map_
+      constantContains
+      Proof.«_[_<-undef]»
+      Proof.«_|->_»
+      constantNot := by
+  intro _K _V _M h
+  simp [constantNot] at h
+
+end BridgeAudit
