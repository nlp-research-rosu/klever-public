diff --git a//tmp/audit-work/proc_readlink_shim.c b//tmp/audit-work/proc_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..5838457d8af61e8f3ee3abc0fc48ff9da1e5b581
--- /dev/null
+++ b//tmp/audit-work/proc_readlink_shim.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    const char *cursor;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    if (strncmp(path, "/proc/", 6) == 0) {
+        cursor = path + 6;
+        if (*cursor >= '0' && *cursor <= '9') {
+            while (*cursor >= '0' && *cursor <= '9') {
+                cursor++;
+            }
+            if (strcmp(cursor, "/exe") == 0) {
+                path = "/proc/self/exe";
+            }
+        }
+    }
+
+    return real_readlink(path, buffer, size);
+}

