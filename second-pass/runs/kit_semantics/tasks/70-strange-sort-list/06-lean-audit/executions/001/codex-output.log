    10	def main (args : List String) : IO UInt32 := do
    11	  let root ← match (← IO.getEnv "LEAN_SYSROOT") with
    12	    | some root => pure <| System.FilePath.mk root
    13	    | none      => pure <| (← IO.appDir).parent.get!
    14	  let mut cc := "@LEANC_CC@".replace "ROOT" root.toString
    15	
    16	  if args.isEmpty then
    17	    IO.println s!"Lean C compiler
    18	
    19	A simple wrapper around a C compiler. Defaults to `{cc}`,
    20	which can be overridden with the environment variable `LEAN_CC`. All parameters are passed
    21	as-is to the wrapped compiler.
    22	
    23	Interesting options:
    24	* `--print-cflags`: print C compiler flags necessary for building against the Lean runtime and exit
    25	* `--print-ldflags`: print C compiler flags necessary for statically linking against the Lean library and exit"
    26	    return 1
    27	
    28	  -- It is difficult to identify the correct minor version here, leading to linking warnings like:
    29	  -- `ld64.lld: warning: /usr/lib/system/libsystem_kernel.dylib has version 13.5.0, which is newer than target minimum of 13.0.0`
    30	  -- In order to suppress these we set the MACOSX_DEPLOYMENT_TARGET variable into the far future.
    31	  let env := match (← IO.getEnv "MACOSX_DEPLOYMENT_TARGET") with
    32	    | some _ => #[]
    33	    | none   => #[("MACOSX_DEPLOYMENT_TARGET", "99.0")]
    34	
    35	  -- let compileOnly := args.contains "-c"
    36	  let linkStatic := !(args.contains "-shared" || args.contains "-leanshared")
    37	  let args := args.erase "-leanshared"
    38	
    39	  -- We assume that the CMake variables do not contain escaped spaces
    40	  let cflags := getCFlags root
    41	  let mut cflagsInternal := getInternalCFlags root
    42	  let mut ldflagsInternal := getInternalLinkerFlags root
    43	  let ldflags := getLinkerFlags root linkStatic
    44	
    45	  for arg in args do
    46	    match arg with
    47	    | "--print-cflags" =>
    48	      IO.println <| " ".intercalate cflags.toList
    49	      return 0
    50	    | "--print-ldflags" =>
    51	      IO.println <| " ".intercalate (cflags ++ ldflags).toList
    52	      return 0
    53	    | _ => pure ()
    54	
    55	  if let some cc' ← IO.getEnv "LEAN_CC" then
    56	    cc := cc'
    57	    -- these are intended for the bundled compiler only
    58	    cflagsInternal := #[]
    59	    ldflagsInternal := #[]
    60	  let args := cflags ++ cflagsInternal ++ args ++ ldflagsInternal ++ ldflags ++ ["-Wno-unused-command-line-argument"]
