+assert remove_duplicates([1, 2, 3, 2, 4]) == [1, 3, 4]
+assert remove_duplicates([-2, 0, -2, 3, 0, 4]) == [3, 4]
+assert remove_duplicates([100000000000000000000, -100000000000000000000, 5]) == [
+    100000000000000000000,
+    -100000000000000000000,
+    5,
+]
