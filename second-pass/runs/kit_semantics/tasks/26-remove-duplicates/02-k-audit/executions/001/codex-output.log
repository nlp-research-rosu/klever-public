     4	
     5	from typing import List
     6	
     7	
     8	def remove_duplicates(numbers: List[int]) -> List[int]:
     9	    """ From a list of integers, remove all elements that occur more than once.
    10	    Keep order of elements left the same as in the input.
    11	    >>> remove_duplicates([1, 2, 3, 2, 4])
    12	    [1, 3, 4]
    13	    """
    14	    import collections
    15	    c = collections.Counter(numbers)
    16	    return [n for n in numbers if c[n] <= 1]

===== /candidate/solution.py =====
     1	from typing import List
     2	
     3	
     4	def remove_duplicates(numbers: List[int]) -> List[int]:
     5	    result = []
     6	    number = 0
     7	    for number in numbers:
     8	        if numbers.count(number) == 1:
     9	            result.append(number)
    10	    return result

