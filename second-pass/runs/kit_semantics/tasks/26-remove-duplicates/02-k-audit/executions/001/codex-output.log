+          FuncDef(
+            "remove_duplicates",
+            Params("numbers"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("numbers"),
+              If(
+                Compare(
+                  Call(
+                    Attribute(Name("numbers"), "count"),
+                    (Name("number"), .Exprs)),
