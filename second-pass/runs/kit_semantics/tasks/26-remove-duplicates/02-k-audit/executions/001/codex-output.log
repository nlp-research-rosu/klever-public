+requires "verification.k"
+
+module SPEC-BODY-SENSITIVITY-AUDIT
+  imports VERIFICATION
+
+  // Change the executed loop guard from count == 1 to count == 2 while
+  // retaining the original count-one destination.
+  claim [count-two-body-is-not-count-one]:
+    <k>
+      #loop(
+        list(REST:ValSeq),
+        Name("number"),
+        If(
+          Compare(
+            Call(
+              Attribute(Name("numbers"), "count"),
+              (Name("number"), .Exprs)),
+            CmpOp("==", Int(2))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              (Name("number"), .Exprs))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "numbers" |-> list(ALL:ValSeq)
+        "result" |-> ref(H:Int)
+        "number" |-> (N:Val => ?N:Val),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(ACC:ValSeq => rdAcc(ACC, REST, ALL))
+      ...
+    </heap>
+    requires allInts(REST) andBool allInts(ALL)
+endmodule
diff --git a/evidence/spec-false-result-audit.k b/evidence/spec-false-result-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..9182acdcdcd83a4dc927d392f4f459460efb7583
--- /dev/null
+++ b/evidence/spec-false-result-audit.k
@@ -0,0 +1,72 @@
+requires "verification.k"
+
+module SPEC-FALSE-RESULT-AUDIT
+  imports VERIFICATION
+
+  // Fresh audit mutation: the real singleton result [1] is replaced by [99].
+  claim [false-singleton-value]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "remove_duplicates",
+            Params("numbers"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("numbers"),
+              If(
+                Compare(
+                  Call(
+                    Attribute(Name("numbers"), "count"),
+                    (Name("number"), .Exprs)),
+                  CmpOp("==", Int(1))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    (Name("number"), .Exprs))),
+                .Stmts))
+            Return(Name("result")))))
+      ~> Call(
+           Name("remove_duplicates"),
+           (list(vCons(1, .ValSeq)), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "remove_duplicates" |->
+                    closureVal(
+                      ("numbers", .ParamNames),
+                      Assign(Name("result"), ListExpr(.Exprs))
+                      Assign(Name("number"), Int(0))
+                      For(
+                        Name("number"),
+                        Name("numbers"),
+                        If(
+                          Compare(
+                            Call(
+                              Attribute(Name("numbers"), "count"),
+                              (Name("number"), .Exprs)),
+                            CmpOp("==", Int(1))),
+                          Expr(
+                            Call(
+                              Attribute(Name("result"), "append"),
+                              (Name("number"), .Exprs))),
+                          .Stmts))
+                      Return(Name("result")),
+                      0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(99, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
