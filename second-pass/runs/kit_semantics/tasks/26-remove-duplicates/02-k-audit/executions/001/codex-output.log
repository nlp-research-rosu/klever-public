+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(99, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
