/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
assert len(out['rules']) == len(inventory['rules'])

expected_ids = [r['source_rule_id'] for r in inventory['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert all(v == 1 for v in Counter(actual_ids).values())
assert set(actual_ids) == set(expected_ids)

allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for canonical, classified in zip(inventory['rules'], out['rules']):
    assert list(classified.keys()) == ['source_rule_id', 'classification', 'rationale']
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if 'simplification' in canonical.get('attributes', []):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

counts = Counter(r['classification'] for r in out['rules'])
print('inventory_sha256:', out['inventory_sha256'])
print('rules:', len(out['rules']))
print('classification_counts:', dict(sorted(counts.items())))
print('order_and_exact_coverage: PASS')
print('schema_shape: PASS')
print('rationales_nonempty: PASS')
PY
python3 -m json.tool trust-boundary.json >/dev/null
rg -n 'PROVED_DERIVED_LEMMA|domain-lemma set is empty|There are no separately proved derived lemmas' DISCOVERY.md
