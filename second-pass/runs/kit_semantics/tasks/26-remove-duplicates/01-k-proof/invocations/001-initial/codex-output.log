@@ -0,0 +1,10 @@
+from typing import List
+
+
+def remove_duplicates(numbers: List[int]) -> List[int]:
+    result = []
+    number = 0
+    for number in numbers:
+        if numbers.count(number) == 1:
+            result.append(number)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..34a37e821255d87668bf1de4d53295b0f8bb9660
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,108 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [remove-duplicates-loop]:
+    <k>
+      #loop(
+        list(intVals(REST:IntSeq)),
+        Name("number"),
+        If(
+          Compare(
+            Call(
+              Attribute(Name("numbers"), "count"),
+              (Name("number"), .Exprs)),
+            CmpOp("==", Int(1))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              (Name("number"), .Exprs))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "numbers" |-> list(intVals(ALL:IntSeq))
+        "result"  |-> ref(H:Int)
+        "number"  |-> (N:Int => ?N:Int),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(ACC:ValSeq => rdAcc(ACC, REST, ALL))
+      ...
+    </heap>
+
+  claim [remove-duplicates]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "remove_duplicates",
+            Params("numbers"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("numbers"),
+              If(
+                Compare(
+                  Call(
+                    Attribute(Name("numbers"), "count"),
+                    (Name("number"), .Exprs)),
+                  CmpOp("==", Int(1))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    (Name("number"), .Exprs))),
+                .Stmts))
+            Return(Name("result")))))
+      ~> Call(
+           Name("remove_duplicates"),
+           (list(intVals(INPUT:IntSeq)), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> (scope(.Map, parent(-1))
+              => scope(
+                   "remove_duplicates" |->
+                     closureVal(
+                       ("numbers", .ParamNames),
+                       Assign(Name("result"), ListExpr(.Exprs))
+                       Assign(Name("number"), Int(0))
+                       For(
+                         Name("number"),
+                         Name("numbers"),
+                         If(
+                           Compare(
+                             Call(
+                               Attribute(Name("numbers"), "count"),
+                               (Name("number"), .Exprs)),
+                             CmpOp("==", Int(1))),
+                           Expr(
+                             Call(
+                               Attribute(Name("result"), "append"),
+                               (Name("number"), .Exprs))),
+                           .Stmts))
+                       Return(Name("result")),
+                       0),
+                   parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(rdAcc(.ValSeq, INPUT, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d6855994ca148e03f90eb897046f52b4c3c76a7a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,21 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Embed an integer sequence into the semantics' sequence of Python values.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq)                => .ValSeq
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
+
+  // Mathematical result of processing REST while preserving the already-built
+  // prefix ACC.  ALL is the complete original input used by list.count.
+  syntax ValSeq ::= rdAcc(ValSeq, IntSeq, IntSeq) [function, total]
+  rule rdAcc(ACC:ValSeq, .IntSeq, _ALL:IntSeq) => ACC
+  rule rdAcc(ACC:ValSeq, iCons(I:Int, R:IntSeq), ALL:IntSeq)
+    => rdAcc(valSeqConcat(ACC, vCons(I, .ValSeq)), R, ALL)
+    requires cntOccVS(intVals(ALL), I) ==Int 1
+  rule rdAcc(ACC:ValSeq, iCons(I:Int, R:IntSeq), ALL:IntSeq)
+    => rdAcc(ACC, R, ALL)
+    requires cntOccVS(intVals(ALL), I) =/=Int 1
+endmodule

