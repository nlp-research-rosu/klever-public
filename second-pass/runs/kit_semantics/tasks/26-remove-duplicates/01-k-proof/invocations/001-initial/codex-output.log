+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [remove-duplicates-loop]:
+    <k>
+      #loop(
+        list(REST:ValSeq),
+        Name("number"),
+        If(
+          Compare(
+            Call(
+              Attribute(Name("numbers"), "count"),
+              (Name("number"), .Exprs)),
+            CmpOp("==", Int(1))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              (Name("number"), .Exprs))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "numbers" |-> list(ALL:ValSeq)
+        "result"  |-> ref(H:Int)
+        "number"  |-> (N:Int => ?N:Int),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(ACC:ValSeq => rdAcc(ACC, REST, ALL))
+      ...
+    </heap>
+
+  claim [remove-duplicates]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "remove_duplicates",
+            Params("numbers"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("numbers"),
+              If(
+                Compare(
+                  Call(
+                    Attribute(Name("numbers"), "count"),
+                    (Name("number"), .Exprs)),
+                  CmpOp("==", Int(1))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    (Name("number"), .Exprs))),
+                .Stmts))
+            Return(Name("result")))))
+      ~> Call(
+           Name("remove_duplicates"),
+           (list(INPUT:ValSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> (scope(.Map, parent(-1))
+              => scope(
+                   "remove_duplicates" |->
+                     closureVal(
+                       ("numbers", .ParamNames),
+                       Assign(Name("result"), ListExpr(.Exprs))
+                       Assign(Name("number"), Int(0))
+                       For(
+                         Name("number"),
+                         Name("numbers"),
+                         If(
+                           Compare(
+                             Call(
+                               Attribute(Name("numbers"), "count"),
+                               (Name("number"), .Exprs)),
+                             CmpOp("==", Int(1))),
+                           Expr(
+                             Call(
+                               Attribute(Name("result"), "append"),
+                               (Name("number"), .Exprs))),
+                           .Stmts))
+                       Return(Name("result")),
+                       0),
+                   parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(rdAcc(.ValSeq, INPUT, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c2bb5f55c0779be798f81acbe320e17512035c88
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,21 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The HumanEval type annotation restricts the input elements to integers.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq)                => true
+  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)
+
+  // Mathematical result of processing REST while preserving the already-built
+  // prefix ACC.  ALL is the complete original input used by list.count.
+  syntax ValSeq ::= rdAcc(ValSeq, ValSeq, ValSeq) [function, total]
+  rule rdAcc(ACC:ValSeq, .ValSeq, _ALL:ValSeq) => ACC
+  rule rdAcc(ACC:ValSeq, vCons(V:Val, R:ValSeq), ALL:ValSeq)
+    => rdAcc(valSeqConcat(ACC, vCons(V, .ValSeq)), R, ALL)
+    requires cntOccVS(ALL, V) ==Int 1
+  rule rdAcc(ACC:ValSeq, vCons(_V:Val, R:ValSeq), ALL:ValSeq)
+    => rdAcc(ACC, R, ALL)
+    requires cntOccVS(ALL, _V) =/=Int 1
+endmodule

exec
