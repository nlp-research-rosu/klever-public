+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(rdAcc(.ValSeq, INPUT, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
