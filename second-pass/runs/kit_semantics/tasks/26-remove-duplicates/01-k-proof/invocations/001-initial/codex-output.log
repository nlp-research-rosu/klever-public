codex
The validation probes are behaving correctly: 21,531 independent Python differential cases had zero mismatches; the singleton false-result claim exited 1 with an actual `[1]` heap; and changing the body to keep count-two values made the loop theorem exit 1. I’ve assembled `prove.sh` and am running it end-to-end once to confirm the deliverables reproduce those outcomes from a clean command sequence.
exec
/bin/bash -lc 'set +e
./prove.sh > prove-run.out 2>&1
status=$?
set -e
printf '"'prove.sh exit: %s\\n' \""'$status"
rg -n '"'differential cases|mismatches:|#Top|EXPECTED FAILURE|ERROR:|WarnStuckClaimState|<exit-code>|"'^    0$'"' prove-run.out | tail -n 80
printf 'prove.sh output lines: '
wc -l < prove-run.out
exit \""'$status"' in /workspace
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..40f7da4ecac6d819ae0b767eef37186daa6d67b0
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,38 @@
+from collections import Counter
+from itertools import product
+import random
+
+from solution import remove_duplicates
+
+
+def oracle(values):
+    counts = Counter(values)
+    return [value for value in values if counts[value] == 1]
+
+
+checked = 0
+mismatches = []
+
+for length in range(7):
+    for values in product(range(-2, 3), repeat=length):
+        sample = list(values)
+        actual = remove_duplicates(sample)
+        expected = oracle(sample)
+        checked += 1
+        if actual != expected:
+            mismatches.append((sample, actual, expected))
+
+rng = random.Random(20260724)
+for _ in range(2000):
+    sample = [rng.randint(-100, 100) for _ in range(rng.randint(0, 40))]
+    actual = remove_duplicates(sample)
+    expected = oracle(sample)
+    checked += 1
+    if actual != expected:
+        mismatches.append((sample, actual, expected))
+
+print(f"differential cases: {checked}")
+print(f"mismatches: {len(mismatches)}")
+if mismatches:
+    print(f"first mismatch: {mismatches[0]}")
+    raise SystemExit(1)
