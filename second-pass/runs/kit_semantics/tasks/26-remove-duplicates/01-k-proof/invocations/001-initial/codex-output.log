diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d6855994ca148e03f90eb897046f52b4c3c76a7a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,21 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Embed an integer sequence into the semantics' sequence of Python values.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq)                => .ValSeq
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
+
+  // Mathematical result of processing REST while preserving the already-built
+  // prefix ACC.  ALL is the complete original input used by list.count.
+  syntax ValSeq ::= rdAcc(ValSeq, IntSeq, IntSeq) [function, total]
+  rule rdAcc(ACC:ValSeq, .IntSeq, _ALL:IntSeq) => ACC
+  rule rdAcc(ACC:ValSeq, iCons(I:Int, R:IntSeq), ALL:IntSeq)
+    => rdAcc(valSeqConcat(ACC, vCons(I, .ValSeq)), R, ALL)
+    requires cntOccVS(intVals(ALL), I) ==Int 1
+  rule rdAcc(ACC:ValSeq, iCons(I:Int, R:IntSeq), ALL:IntSeq)
+    => rdAcc(ACC, R, ALL)
+    requires cntOccVS(intVals(ALL), I) =/=Int 1
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..c3a8c3cf8f8468a471ffe8c261bf818737f4e974
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,17 @@
+from typing import List
+
+
+def remove_duplicates(numbers: List[int]) -> List[int]:
+    result = []
+    number = 0
+    for number in numbers:
+        if numbers.count(number) == 1:
+            result.append(number)
+    return result
+
+
+assert remove_duplicates([]) == []
+assert remove_duplicates([1]) == [1]
+assert remove_duplicates([1, 2, 3, 2, 4]) == [1, 3, 4]
+assert remove_duplicates([1, 1]) == []
+assert remove_duplicates([-2, 0, -2, 3, 0, 4]) == [3, 4]
