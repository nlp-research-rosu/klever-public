@@ -0,0 +1,20 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The HumanEval type annotation restricts the input elements to integers.
+  syntax Bool ::= allInts(ValSeq) [function, total]
