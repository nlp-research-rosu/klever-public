+        Name("number"),
+        If(
+          Compare(
+            Call(
+              Attribute(Name("numbers"), "count"),
+              (Name("number"), .Exprs)),
+            CmpOp("==", Int(1))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              (Name("number"), .Exprs))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "numbers" |-> list(ALL:ValSeq)
+        "result"  |-> ref(H:Int)
+        "number"  |-> (N:Val => ?N:Val),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(ACC:ValSeq => rdAcc(ACC, REST, ALL))
+      ...
+    </heap>
