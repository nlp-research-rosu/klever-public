Module(
  ImportFrom("typing", "List")
  FuncDef("remove_duplicates", Params("numbers"),
    Assign(Name("result"), ListExpr())
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("numbers"),
      If(Compare(
        Call(Attribute(Name("numbers"), "count"), Name("number")),
        CmpOp("==", Int(1))),
        Expr(Call(Attribute(Name("result"), "append"), Name("number"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("remove_duplicates"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("remove_duplicates"), ListExpr(Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("remove_duplicates"),
        ListExpr(Int(1), Int(2), Int(3), Int(2), Int(4))),
      CmpOp("==", ListExpr(Int(1), Int(3), Int(4)))))
  Assert(
    Compare(
      Call(Name("remove_duplicates"), ListExpr(Int(1), Int(1))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("remove_duplicates"),
        ListExpr(
          UnaryOp("-", Int(2)),
          Int(0),
          UnaryOp("-", Int(2)),
          Int(3),
          Int(0),
          Int(4))),
      CmpOp("==", ListExpr(Int(3), Int(4))))))
