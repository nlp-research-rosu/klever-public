Module(
  ImportFrom("typing", "List")
  FuncDef("remove_duplicates", Params("numbers"),
    Assign(Name("result"), ListExpr())
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("numbers"),
      If(Compare(
        Call(Attribute(Name("numbers"), "count"), Name("number")),
        CmpOp("==", Int(1))),
        Expr(Call(Attribute(Name("result"), "append"), Name("number"))),
        ))
    Return(Name("result"))))
