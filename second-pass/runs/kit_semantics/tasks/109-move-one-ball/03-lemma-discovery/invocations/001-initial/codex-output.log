import json
from collections import Counter
canonical = json.load(open('/reference/rule-inventory.json'))
out = json.load(open('/workspace/trust-boundary.json'))
allowed = {'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == canonical['inventory_sha256']
canon_ids = [r['source_rule_id'] for r in canonical['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == canon_ids
assert len(out_ids) == len(set(out_ids)) == len(canon_ids)
for entry in out['rules']:
    assert list(entry.keys()) == ['source_rule_id','classification','rationale'], entry
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
by_id = {e['source_rule_id']: e for e in out['rules']}
for rule in canonical['rules']:
    if 'simplification' in rule['attributes']:
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
counts = Counter(e['classification'] for e in out['rules'])
print('schema_keys=exact')
print('inventory_sha256=exact')
print(f'rules={len(out_ids)} order=exact unique=yes missing=0 extra=0')
print('counts=' + ','.join(f'{k}:{counts[k]}' for k in ['DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA']))
print('simplification_rules=' + str(sum('simplification' in r['attributes'] for r in canonical['rules'])) + ' constraint=passed')
