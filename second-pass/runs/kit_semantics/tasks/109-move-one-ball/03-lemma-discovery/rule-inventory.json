      "start_line": 11,
      "text": "  rule scanBody\n    => Assign(Name(\"drops\"),\n         BinOp(\"+\", Name(\"drops\"),\n           Compare(Name(\"current\"), CmpOp(\"<\", Name(\"previous\")))))\n       Assign(Name(\"previous\"), Name(\"current\"))"
    },
    {
      "attributes": [],
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "a954c7fce79d3cc622c51dd0a87db8553231b26de3aaa807968ebbf55e3e4381",
      "source_rule_id": "rule-a954c7fce79d3cc622c51dd0a87db8553231b26de3aaa807968ebbf55e3e4381",
      "start_line": 18,
      "text": "  rule moveOneBallBody\n    => If(UnaryOp(\"not\", Name(\"arr\")),\n          Return(Bool(true)),\n          .Stmts)\n       Assign(Name(\"first\"), Subscript(Name(\"arr\"), Int(0)))\n       Assign(Name(\"previous\"), Name(\"first\"))\n       Assign(Name(\"current\"), Name(\"first\"))\n       Assign(Name(\"drops\"), Int(0))\n       For(Name(\"current\"), Name(\"arr\"), scanBody)\n       Assign(Name(\"drops\"),\n         BinOp(\"+\", Name(\"drops\"),\n           Compare(Name(\"first\"), CmpOp(\"<\", Name(\"previous\")))))\n       Return(Compare(Name(\"drops\"), CmpOp(\"<=\", Int(1))))"
    },
    {
      "attributes": [],
