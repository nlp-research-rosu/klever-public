diff --git a//tmp/audit-work/fresh-proof-2/OperationalAudit.lean b//tmp/audit-work/fresh-proof-2/OperationalAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..1fa7909c504ddc24a9dc1706422261c5a199db5e
--- /dev/null
+++ b//tmp/audit-work/fresh-proof-2/OperationalAudit.lean
@@ -0,0 +1,93 @@
+import Proof
+
+open Proof
+
+namespace OperationalAudit
+
+abbrev nilVS : SortValSeq :=
+  SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+abbrev consVS (value : SortVal) (rest : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest
+
+abbrev intVal (value : Int) : SortVal :=
+  SortVal.inj_SortInt value
+
+abbrev boolVal (value : Bool) : SortVal :=
+  SortVal.inj_SortBool value
+
+abbrev asK (value : SortVal) : SortK :=
+  SortK.kseq ((@inj SortVal SortKItem) value) SortK.dotk
+
+abbrev ints : SortValSeq :=
+  consVS (intVal 4) (consVS (intVal (-2)) nilVS)
+
+abbrev mixed : SortValSeq :=
+  consVS (intVal 4) (consVS (boolVal true) nilVS)
+
+-- Direct semantic witnesses, including boundary and negative integer cases.
+example : _andBool_ true true = true := rfl
+example : _andBool_ true false = false := rfl
+example : Proof.«_<Int_» (-3) 2 = true := by decide
+example : Proof.«_<Int_» 2 2 = false := by decide
+example : isInt (asK (intVal 7)) = true := rfl
+example : isInt (asK (boolVal true)) = false := rfl
+example : «allInts(_)_VERIFICATION_Bool_ValSeq» nilVS = true := rfl
+example : «allInts(_)_VERIFICATION_Bool_ValSeq» ints = true := rfl
+example : «allInts(_)_VERIFICATION_Bool_ValSeq» mixed = false := rfl
+example :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intVal (-2)) (intVal 9) =
+      true := by decide
+example :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intVal 9) (intVal (-2)) =
+      false := by decide
+example :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "==" (intVal 5) (intVal 5) =
+      true := by decide
+example :
+    «lastAfter(_,_)_VERIFICATION_Val_Val_ValSeq» (intVal 99) nilVS =
+      intVal 99 := rfl
+example :
+    «lastAfter(_,_)_VERIFICATION_Val_Val_ValSeq» (intVal 99) ints =
+      intVal (-2) := rfl
+example : «project:Int» (asK (intVal 7)) = 7 := rfl
+
+-- Counterfactual implementations that would make the bridge convenient,
+-- but disagree with concrete operational witnesses.
+def constantAnd (_ _ : SortBool) : SortBool := false
+def constantLt (_ _ : SortInt) : SortBool := false
+def constantIsInt (_ : SortK) : SortBool := false
+def constantAllInts (_ : SortValSeq) : SortBool := false
+def constantApplyCmp (_ : SortString) (_ _ : SortVal) : SortBool := false
+def identityLastAfter (previous : SortVal) (_ : SortValSeq) : SortVal := previous
+def constantProject (_ : SortK) : SortInt := 0
+
+example : constantAnd true true ≠ _andBool_ true true := by decide
+example : constantLt 0 1 ≠ Proof.«_<Int_» 0 1 := by decide
+example : constantIsInt (asK (intVal 7)) ≠ isInt (asK (intVal 7)) := by decide
+example :
+    constantAllInts nilVS ≠ «allInts(_)_VERIFICATION_Bool_ValSeq» nilVS := by
+  decide
+example :
+    constantApplyCmp "<" (intVal 0) (intVal 1) ≠
+      «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intVal 0) (intVal 1) := by
+  decide
+example :
+    «project:Int» (asK (identityLastAfter (intVal 99) ints)) ≠
+      «project:Int»
+        (asK («lastAfter(_,_)_VERIFICATION_Val_Val_ValSeq» (intVal 99) ints)) := by
+  decide
+example : constantProject (asK (intVal 7)) ≠ «project:Int» (asK (intVal 7)) := by
+  decide
+
+#eval _andBool_ true true
+#eval Proof.«_<Int_» (-3) 2
+#eval «allInts(_)_VERIFICATION_Bool_ValSeq» ints
+#eval «allInts(_)_VERIFICATION_Bool_ValSeq» mixed
+#eval «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intVal (-2)) (intVal 9)
+#eval
+  «project:Int»
+    (asK («lastAfter(_,_)_VERIFICATION_Val_Val_ValSeq» (intVal 99) ints))
+#eval «project:Int» (asK (intVal 7))
+
+end OperationalAudit
diff --git a//tmp/audit-work/lean_app_path.c b//tmp/audit-work/lean_app_path.c
new file mode 100644
index 0000000000000000000000000000000000000000..17d97da55046c4542619db6f44932aef53928ce6
--- /dev/null
+++ b//tmp/audit-work/lean_app_path.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/*
+ * Audit-container compatibility shim.
+ *
+ * Lean 4.22's bundled libuv resolves the current executable with
+ * readlink("/proc/self/exe").  That specific in-process lookup fails in this
+ * sandbox even though the same path is readable by ordinary processes.  For
+ * that one pathname, supply the pinned toolchain executable recorded in
+ * AUDIT_LEAN_EXEC_PATH.  Delegate every other readlink call directly to the
+ * kernel.
+ */
+ssize_t readlink(const char *pathname, char *buffer, size_t size) {
+    const char *forced = getenv("AUDIT_LEAN_EXEC_PATH");
+    if (forced != NULL && strcmp(pathname, "/proc/self/exe") == 0) {
+        size_t length = strlen(forced);
+        size_t copied = length < size ? length : size;
+        memcpy(buffer, forced, copied);
+        return (ssize_t)copied;
+    }
+    return syscall(SYS_readlink, pathname, buffer, size);
+}
