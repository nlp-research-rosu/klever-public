{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "2113f0fdc2009228980618182d1e8b1e9cbb2b4e997089fa8e3b9265644d811b",
      "rationale": "This rule is the compile-time scanBody macro expansion naming the exact loop-body AST; it defines a proof term and adds no independent execution or mathematical fact.",
      "source_rule_id": "rule-2113f0fdc2009228980618182d1e8b1e9cbb2b4e997089fa8e3b9265644d811b",
      "start_line": 11,
      "text": "  rule scanBody\n    => Assign(Name(\"drops\"),\n         BinOp(\"+\", Name(\"drops\"),\n           Compare(Name(\"current\"), CmpOp(\"<\", Name(\"previous\")))))\n       Assign(Name(\"previous\"), Name(\"current\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "a954c7fce79d3cc622c51dd0a87db8553231b26de3aaa807968ebbf55e3e4381",
      "rationale": "This rule is the compile-time moveOneBallBody macro expansion for the exact translated function body, so it is a named structural definition rather than an operational extension.",
      "source_rule_id": "rule-a954c7fce79d3cc622c51dd0a87db8553231b26de3aaa807968ebbf55e3e4381",
      "start_line": 18,
      "text": "  rule moveOneBallBody\n    => If(UnaryOp(\"not\", Name(\"arr\")),\n          Return(Bool(true)),\n          .Stmts)\n       Assign(Name(\"first\"), Subscript(Name(\"arr\"), Int(0)))\n       Assign(Name(\"previous\"), Name(\"first\"))\n       Assign(Name(\"current\"), Name(\"first\"))\n       Assign(Name(\"drops\"), Int(0))\n       For(Name(\"current\"), Name(\"arr\"), scanBody)\n       Assign(Name(\"drops\"),\n         BinOp(\"+\", Name(\"drops\"),\n           Compare(Name(\"first\"), CmpOp(\"<\", Name(\"previous\")))))\n       Return(Compare(Name(\"drops\"), CmpOp(\"<=\", Int(1))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "This is the empty-sequence base equation defining the allInts domain predicate.",
