      "start_line": 34,
      "text": "  rule allInts(.ValSeq)                => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "rationale": "This is the constructor recurrence defining allInts by checking the head and recursively checking the tail.",
