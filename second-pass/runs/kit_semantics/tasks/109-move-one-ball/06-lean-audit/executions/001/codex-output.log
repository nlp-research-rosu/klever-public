     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Loop invariant.  Starting with previous=current=P and drops=D, scanning
     7	  // VS leaves both value locals at lastAfter(P, VS) and transforms D by the
     8	  // exact strict-descent accumulator fold scanDrops.
     9	  claim [scan-loop]:
    10	    <k> #loop(list(VS:ValSeq), Name("current"), scanBody)
    11	        => .K ... </k>
    12	    <env> L:Int </env>
    13	    <scopes>
    14	      SC:Map
    15	      L |-> scope(
    16	        "arr"      |-> ARR:Val
    17	        "first"    |-> F:Val
    18	        "previous" |-> (P:Val => lastAfter(P, VS))
    19	        "current"  |-> (P => lastAfter(P, VS))
    20	        "drops"    |-> (D:Int => scanDrops(D, P, VS)),
    21	        parent(0))
    22	    </scopes>
    23	    requires isInt(P) andBool allInts(VS)
    24	
    25	  // Whole-program partial correctness from the exact function binding and
    26	  // body.  The theorem covers every finite list of mathematical integers.
    27	  claim [move-one-ball]:
    28	    <k> Call(Name("move_one_ball"), (list(VS:ValSeq), .Exprs))
    29	        => moveSpec(VS) </k>
    30	    <env> 0 </env>
    31	    <scopes>
    32	      -1 |-> builtinsScope
    33	       0 |-> scope(
    34	         "move_one_ball" |-> closureVal("arr", moveOneBallBody, 0),
    35	         parent(-1))
    36	    </scopes>
    37	    <scopeLoc> 1 </scopeLoc>
    38	    <heap> .Map </heap>
    39	    <heapLoc> 0 </heapLoc>
    40	    <stack> .List </stack>
    41	    <ret> noRet </ret>
    42	    <exc> NoExc </exc>
    43	    <exit-code> 0 </exit-code>
    44	    requires allInts(VS)
    45	endmodule
$ sed -n 1,220p /reference/k-proof/solution.py
     1	def move_one_ball(arr):
     2	    if not arr:
     3	        return True
     4	
     5	    first = arr[0]
     6	    previous = first
     7	    current = first
     8	    drops = 0
     9	
    10	    for current in arr:
    11	        drops = drops + (current < previous)
    12	        previous = current
    13	
    14	    drops = drops + (first < previous)
    15	
    16	    return drops <= 1

