+  env PATH=/tmp/audit-work/lean-patched-root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin lake env lean OperationalAudit.lean
+
+Exit code: 0
+
+Complete stdout:
+true
+true
+true
+false
+true
+-2
+7
+
+Complete stderr: empty
+
+The seven #eval results respectively witness:
+  true && true = true
+  -3 < 2 = true
+  allInts [4, -2] = true
+  allInts [4, true] = false
+  applyCmp("<", -2, 9) = true
+  lastAfter(99, [4, -2]) projected to Int = -2
