+      "output_tail": "final : Klean109MoveOneBall.Lemmas.targetStatement _andBool_ «_<Int_» «allInts(_)_VERIFICATION_Bool_ValSeq»\n  «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» isInt «lastAfter(_,_)_VERIFICATION_Val_Val_ValSeq» «project:Int»\n'Proof.final' depends on axioms: [propext]\n"
+    }
+  ]
+}
