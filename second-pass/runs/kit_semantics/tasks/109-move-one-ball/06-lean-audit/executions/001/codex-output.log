+import Proof
+
+open Proof
+
+namespace OperationalAudit
+
+abbrev nilVS : SortValSeq :=
+  SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+abbrev consVS (value : SortVal) (rest : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest
