+$ nl -ba /reference/k-proof/prove.sh
+     1	#!/usr/bin/env bash
+     2	set -euo pipefail
+     3	
+     4	python3 py2mpy.py solution.py > solution.mpy
+     5	python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+     6	python3 py2mpy.py solution.py | cmp - solution.mpy
+     7	
+     8	kompile reference-semantics/semantics.k \
+     9	  --backend llvm \
+    10	  --main-module MPY-KRUN \
+    11	  --syntax-module MPY-SYNTAX \
+    12	  --output-definition runtime-kompiled
+    13	
+    14	krun concrete_tests.mpy --definition runtime-kompiled
+    15	
+    16	kompile --backend haskell verification.k \
+    17	  --main-module VERIFICATION \
+    18	  --syntax-module MPY-SYNTAX \
+    19	  --output-definition verification-kompiled
+    20	
+    21	kprove spec.k \
+    22	  --definition verification-kompiled \
+    23	  --spec-module SPEC \
+    24	  --claims SPEC.scan-loop
+    25	
+    26	kprove spec.k \
+    27	  --definition verification-kompiled \
+    28	  --spec-module SPEC
+    29	
+    30	set +e
+    31	kprove spec-vacuity.k \
+    32	  --definition verification-kompiled \
+    33	  --spec-module SPEC-VACUITY
+    34	vacuity_status=$?
+    35	set -e
+    36	if [[ "$vacuity_status" -eq 0 ]]; then
+    37	  echo "ERROR: false-postcondition mutation unexpectedly proved"
+    38	  exit 1
+    39	fi
+    40	echo "EXPECTED FAILURE: false-postcondition mutation exit $vacuity_status"
+    41	
+    42	set +e
+    43	kprove spec-body-mutation.k \
+    44	  --definition verification-kompiled \
+    45	  --spec-module SPEC-BODY-MUTATION
+    46	body_status=$?
+    47	set -e
+    48	if [[ "$body_status" -eq 0 ]]; then
+    49	  echo "ERROR: body mutation unexpectedly proved"
+    50	  exit 1
+    51	fi
+    52	echo "EXPECTED FAILURE: body mutation exit $body_status"
+    53	
+    54	python3 differential_tests.py
+
+This sequence compiles verification.k, including both simplification rules,
+before either successful kprove invocation. There is no earlier proof of either
+exact rule against a module that omits it, so neither is a
+PROVED_DERIVED_LEMMA.
