    {
      "source_rule_id": "rule-1790939123173b0e0d0436b3ebbcacdb5e49ed4a87ef17f2f877dc7b6d6e1fd1",
      "classification": "DOMAIN_LEMMA",
      "rationale": "This simplification rule adds a guarded mathematical fact permitting comparison with lastAfter. Stage 1 uses it in the compiled proof theory and provides no earlier exact proof in a module from which this rule is absent."
    },
    {
      "source_rule_id": "rule-5c07cca7fdc014be55b52c0e209519d4b57df23c2b7d0323cd179fcd59f76d32",
      "classification": "DEFINITION",
      "rationale": "This guarded equation defines moveSpec on the empty sequence."
    },
    {
      "source_rule_id": "rule-5277cf06d6a112559474beb63e50a1eced34870a71610af9bc1b31a081414e17",
      "classification": "DEFINITION",
      "rationale": "This guarded equation defines moveSpec on the nonempty all-integer domain in terms of the scanDrops and lastAfter summaries."
    }
  ]
}
$ sed -n 1,240p /reference/k-proof/verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	  imports INT
     6	  imports BOOL
     7	
     8	  // Exact AST aliases for solution.mpy.  These are compile-time macros: the
     9	  // fixed MPY rules still execute every statement in the function and loop.
    10	  syntax Stmts ::= "scanBody" [macro]
    11	  rule scanBody
    12	    => Assign(Name("drops"),
    13	         BinOp("+", Name("drops"),
    14	           Compare(Name("current"), CmpOp("<", Name("previous")))))
    15	       Assign(Name("previous"), Name("current"))
    16	
    17	  syntax Stmts ::= "moveOneBallBody" [macro]
    18	  rule moveOneBallBody
    19	    => If(UnaryOp("not", Name("arr")),
    20	          Return(Bool(true)),
    21	          .Stmts)
    22	       Assign(Name("first"), Subscript(Name("arr"), Int(0)))
    23	       Assign(Name("previous"), Name("first"))
    24	       Assign(Name("current"), Name("first"))
    25	       Assign(Name("drops"), Int(0))
    26	       For(Name("current"), Name("arr"), scanBody)
    27	       Assign(Name("drops"),
    28	         BinOp("+", Name("drops"),
    29	           Compare(Name("first"), CmpOp("<", Name("previous")))))
    30	       Return(Compare(Name("drops"), CmpOp("<=", Int(1))))
    31	
    32	  // The formal input-domain predicate: every MPY list element is an Int.
    33	  syntax Bool ::= allInts(ValSeq) [function, total]
    34	  rule allInts(.ValSeq)                => true
    35	  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)
    36	
    37	  // Sort-refinement lemma for the fixed MPY-INT comparison equation.  The
    38	  // guard states exactly when both Val-sorted operands are Int injections.
    39	  rule applyCmp("<", A:Val, B:Val)
    40	    => {A}:>Int <Int {B}:>Int
    41	    requires isInt(A) andBool isInt(B)
    42	    [simplification]
    43	
    44	  // The exact left fold performed by the loop.  These equations are
    45	  // intentionally defined only on the allInts domain.
    46	  syntax Int ::= scanDrops(Int, Val, ValSeq) [function]
    47	  rule scanDrops(D:Int, _:Val, .ValSeq) => D
    48	  rule scanDrops(D:Int, P:Val, vCons(V:Val, R:ValSeq))
    49	    => scanDrops(
    50	         D +Int (#if {V}:>Int <Int {P}:>Int #then 1 #else 0 #fi),
    51	         V,
    52	         R)
    53	    requires isInt(P) andBool isInt(V)
    54	
    55	  // The final integer after scanning VS, or P if VS is empty.
    56	  syntax Val ::= lastAfter(Val, ValSeq) [function, total]
    57	  rule lastAfter(P:Val, .ValSeq)                => P
    58	  rule lastAfter(_:Val, vCons(V:Val, R:ValSeq)) => lastAfter(V, R)
    59	
    60	  rule applyCmp("<", A:Val, lastAfter(P:Val, VS:ValSeq))
    61	    => {A}:>Int <Int {lastAfter(P, VS)}:>Int
    62	    requires isInt(A) andBool isInt(P) andBool allInts(VS)
    63	    [simplification]
    64	
    65	  // Exact result property: empty is accepted; a nonempty circular sequence is
    66	  // accepted iff it has at most one strict circular descent.
    67	  syntax Bool ::= moveSpec(ValSeq) [function]
    68	  rule moveSpec(VS:ValSeq) => true
    69	    requires VS ==K .ValSeq
    70	  rule moveSpec(VS:ValSeq)
    71	    => scanDrops(0, valSeqAt(VS, 0), VS)
    72	       +Int (#if {valSeqAt(VS, 0)}:>Int
    73	                   <Int {lastAfter(valSeqAt(VS, 0), VS)}:>Int
    74	             #then 1 #else 0 #fi)
    75	       <=Int 1
    76	    requires notBool (VS ==K .ValSeq) andBool allInts(VS)
    77	endmodule
