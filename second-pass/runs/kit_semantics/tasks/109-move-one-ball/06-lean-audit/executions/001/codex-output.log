{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "2113f0fdc2009228980618182d1e8b1e9cbb2b4e997089fa8e3b9265644d811b",
      "rationale": "This rule is the compile-time scanBody macro expansion naming the exact loop-body AST; it defines a proof term and adds no independent execution or mathematical fact.",
      "source_rule_id": "rule-2113f0fdc2009228980618182d1e8b1e9cbb2b4e997089fa8e3b9265644d811b",
      "start_line": 11,
      "text": "  rule scanBody\n    => Assign(Name(\"drops\"),\n         BinOp(\"+\", Name(\"drops\"),\n           Compare(Name(\"current\"), CmpOp(\"<\", Name(\"previous\")))))\n       Assign(Name(\"previous\"), Name(\"current\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "a954c7fce79d3cc622c51dd0a87db8553231b26de3aaa807968ebbf55e3e4381",
      "rationale": "This rule is the compile-time moveOneBallBody macro expansion for the exact translated function body, so it is a named structural definition rather than an operational extension.",
      "source_rule_id": "rule-a954c7fce79d3cc622c51dd0a87db8553231b26de3aaa807968ebbf55e3e4381",
      "start_line": 18,
      "text": "  rule moveOneBallBody\n    => If(UnaryOp(\"not\", Name(\"arr\")),\n          Return(Bool(true)),\n          .Stmts)\n       Assign(Name(\"first\"), Subscript(Name(\"arr\"), Int(0)))\n       Assign(Name(\"previous\"), Name(\"first\"))\n       Assign(Name(\"current\"), Name(\"first\"))\n       Assign(Name(\"drops\"), Int(0))\n       For(Name(\"current\"), Name(\"arr\"), scanBody)\n       Assign(Name(\"drops\"),\n         BinOp(\"+\", Name(\"drops\"),\n           Compare(Name(\"first\"), CmpOp(\"<\", Name(\"previous\")))))\n       Return(Compare(Name(\"drops\"), CmpOp(\"<=\", Int(1))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "This is the empty-sequence base equation defining the allInts domain predicate.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 34,
      "text": "  rule allInts(.ValSeq)                => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "rationale": "This is the constructor recurrence defining allInts by checking the head and recursively checking the tail.",
      "source_rule_id": "rule-bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "start_line": 35,
      "text": "  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION",
      "normalized_sha256": "4e59619ad0d5e4c817fce319f536d37391f7c43783f89757495c9ed16530e409",
      "rationale": "This is the empty-input base equation for the scanDrops accumulator summary.",
      "source_rule_id": "rule-4e59619ad0d5e4c817fce319f536d37391f7c43783f89757495c9ed16530e409",
      "start_line": 47,
      "text": "  rule scanDrops(D:Int, _:Val, .ValSeq) => D"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 53,
      "module": "VERIFICATION",
      "normalized_sha256": "bd22b95ff27fa507ace8a55b23e07960d0ba7af1765c6c5a6c75faeb33a2aeee",
      "rationale": "This is the guarded tail-recursive step equation defining the scanDrops mathematical fold.",
      "source_rule_id": "rule-bd22b95ff27fa507ace8a55b23e07960d0ba7af1765c6c5a6c75faeb33a2aeee",
      "start_line": 48,
      "text": "  rule scanDrops(D:Int, P:Val, vCons(V:Val, R:ValSeq))\n    => scanDrops(\n         D +Int (#if {V}:>Int <Int {P}:>Int #then 1 #else 0 #fi),\n         V,\n         R)\n    requires isInt(P) andBool isInt(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 57,
      "module": "VERIFICATION",
      "normalized_sha256": "2fcb91a07fe018ada596c62b5c013251f64fc0c3817612c4f480cbc51f49374f",
      "rationale": "This is the empty-sequence base equation defining the lastAfter structural summary.",
      "source_rule_id": "rule-2fcb91a07fe018ada596c62b5c013251f64fc0c3817612c4f480cbc51f49374f",
      "start_line": 57,
      "text": "  rule lastAfter(P:Val, .ValSeq)                => P"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "f7986d4c0e6a22445baeea69ebcde91b805f9c0d364d6d60d917b74a2ab2005f",
      "rationale": "This is the constructor recurrence defining lastAfter by advancing to the head and consuming the tail.",
      "source_rule_id": "rule-f7986d4c0e6a22445baeea69ebcde91b805f9c0d364d6d60d917b74a2ab2005f",
      "start_line": 58,
      "text": "  rule lastAfter(_:Val, vCons(V:Val, R:ValSeq)) => lastAfter(V, R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 69,
      "module": "VERIFICATION",
      "normalized_sha256": "5c07cca7fdc014be55b52c0e209519d4b57df23c2b7d0323cd179fcd59f76d32",
      "rationale": "This guarded equation defines moveSpec on the empty sequence.",
      "source_rule_id": "rule-5c07cca7fdc014be55b52c0e209519d4b57df23c2b7d0323cd179fcd59f76d32",
      "start_line": 68,
      "text": "  rule moveSpec(VS:ValSeq) => true\n    requires VS ==K .ValSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 76,
      "module": "VERIFICATION",
      "normalized_sha256": "5277cf06d6a112559474beb63e50a1eced34870a71610af9bc1b31a081414e17",
      "rationale": "This guarded equation defines moveSpec on the nonempty all-integer domain in terms of the scanDrops and lastAfter summaries.",
      "source_rule_id": "rule-5277cf06d6a112559474beb63e50a1eced34870a71610af9bc1b31a081414e17",
      "start_line": 70,
      "text": "  rule moveSpec(VS:ValSeq)\n    => scanDrops(0, valSeqAt(VS, 0), VS)\n       +Int (#if {valSeqAt(VS, 0)}:>Int\n                   <Int {lastAfter(valSeqAt(VS, 0), VS)}:>Int\n             #then 1 #else 0 #fi)\n       <=Int 1\n    requires notBool (VS ==K .ValSeq) andBool allInts(VS)"
    }
