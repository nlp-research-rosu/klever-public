+            "module",
+            "start_line",
+            "end_line",
+            "normalized_sha256",
+            "attributes",
+            "text",
+        )
+    }
+    for entry in manifest_entries
+]
+check(
+    "Stage 4 input manifest is exact ordered inventory",
+    stripped_manifest_entries == rules,
+    len(manifest_entries),
+)
+check(
+    "Stage 4 input classifications",
