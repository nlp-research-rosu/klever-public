+Command:
+  PYTHONPATH=/reference python3 - <<'PY'
+  import json
+  from pathlib import Path
+  from tools.klean_final_gate import _allowed_axioms
+  inventory=json.loads(Path('/reference/klean-generation/trust-inventory.json').read_text())
+  used={'propext'}
+  recorded=set(inventory['axioms'])
+  allowed=_allowed_axioms(inventory)
+  print('used_axioms:', sorted(used))
+  print('standard_core_allowance:', sorted(allowed-recorded))
+  print('recorded_generated_axiom_count:', len(recorded))
+  print('used_recorded_generated_axioms:', sorted(used & recorded))
+  print('unexpected_axioms:', sorted(used-allowed))
+  print('sorryAx_present:', 'sorryAx' in used)
+  PY
+
