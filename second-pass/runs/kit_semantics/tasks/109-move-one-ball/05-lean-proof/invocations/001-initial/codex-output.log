diff --git a//tmp/lean-proc-shim.c b//tmp/lean-proc-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..e9ef473cc0a3d32d3aec479312a8bc0ef49689aa
--- /dev/null
+++ b//tmp/lean-proc-shim.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *program_invocation_short_name;
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  static const char toolchain_bin[] =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/";
+
+  if (!real_readlink) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  if (path && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + strlen(path) - 4, "/exe") == 0) {
+    const char *name = program_invocation_short_name;
+    if (name && (strcmp(name, "lean") == 0 || strcmp(name, "lake") == 0 ||
+                 strcmp(name, "leanc") == 0)) {
+      const size_t prefix_len = sizeof(toolchain_bin) - 1;
+      const size_t name_len = strlen(name);
+      if (prefix_len + name_len > size) {
+        errno = ENAMETOOLONG;
+        return -1;
+      }
+      memcpy(buffer, toolchain_bin, prefix_len);
+      memcpy(buffer + prefix_len, name, name_len);
+      return (ssize_t)(prefix_len + name_len);
+    }
+  }
+
+  return real_readlink(path, buffer, size);
+}
