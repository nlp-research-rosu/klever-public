diff --git a//tmp/audit-work/problem-109-independent/concrete_audit.py b//tmp/audit-work/problem-109-independent/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..b207d79048cb7b109a8c15142886511afc9b4851
--- /dev/null
+++ b//tmp/audit-work/problem-109-independent/concrete_audit.py
@@ -0,0 +1,25 @@
+def move_one_ball(arr):
+    if not arr:
+        return True
+
+    first = arr[0]
+    previous = first
+    current = first
+    drops = 0
+
+    for current in arr:
+        drops = drops + (current < previous)
+        previous = current
+
+    drops = drops + (first < previous)
+
+    return drops <= 1
+
+
+assert move_one_ball([]) == True
+assert move_one_ball([7]) == True
+assert move_one_ball([3, 4, 5, 1, 2]) == True
+assert move_one_ball([3, 5, 4, 1, 2]) == False
+assert move_one_ball([-1, 5]) == True
+assert move_one_ball([5, -1]) == True
+assert move_one_ball([2, 1, 3]) == False
diff --git a//tmp/audit-work/problem-109-independent/spec-body-sensitivity-audit.k b//tmp/audit-work/problem-109-independent/spec-body-sensitivity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..8aaf055b953898afe257845eaacc21f2201569f1
--- /dev/null
+++ b//tmp/audit-work/problem-109-independent/spec-body-sensitivity-audit.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module SPEC-BODY-SENSITIVITY-AUDIT
+  imports VERIFICATION
+
+  // Fresh operational-sensitivity probe: the executed closure differs from the
+  // submitted body at the final statement and always returns false there.
+  // The selected nonempty input reaches that changed statement, while the
+  // submitted body and moveSpec both return true.
+  claim [mutated-nonempty-final-return]:
+    <k> Call(
+          Name("move_one_ball"),
+          (list(vCons(3, vCons(4, vCons(5, vCons(1, vCons(2, .ValSeq)))))), .Exprs))
+        => true </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+         "move_one_ball" |->
+           closureVal(
+             "arr",
+             If(UnaryOp("not", Name("arr")),
+                Return(Bool(true)),
+                .Stmts)
+             Assign(Name("first"), Subscript(Name("arr"), Int(0)))
+             Assign(Name("previous"), Name("first"))
+             Assign(Name("current"), Name("first"))
+             Assign(Name("drops"), Int(0))
+             For(Name("current"), Name("arr"), scanBody)
+             Assign(Name("drops"),
+               BinOp("+", Name("drops"),
+                 Compare(Name("first"), CmpOp("<", Name("previous")))))
+             Return(Bool(false)),
+             0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
