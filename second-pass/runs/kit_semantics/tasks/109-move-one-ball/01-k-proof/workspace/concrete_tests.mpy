Module(
  FuncDef("move_one_ball", Params("arr"),
    If(UnaryOp("not", Name("arr")),
      Return(Bool(true)),
      )
    Assign(Name("first"), Subscript(Name("arr"), Int(0)))
    Assign(Name("previous"), Name("first"))
    Assign(Name("current"), Name("first"))
    Assign(Name("drops"), Int(0))
    For(Name("current"), Name("arr"),
      Assign(
        Name("drops"),
        BinOp(
          "+",
          Name("drops"),
          Compare(Name("current"), CmpOp("<", Name("previous")))))
      Assign(Name("previous"), Name("current")))
    Assign(
      Name("drops"),
      BinOp(
        "+",
        Name("drops"),
        Compare(Name("first"), CmpOp("<", Name("previous")))))
    Return(Compare(Name("drops"), CmpOp("<=", Int(1)))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr()),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr(Int(7))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("move_one_ball"),
        ListExpr(Int(3), Int(4), Int(5), Int(1), Int(2))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("move_one_ball"),
        ListExpr(Int(3), Int(5), Int(4), Int(1), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr(Int(2), Int(1), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("move_one_ball"),
        ListExpr(Int(5), Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", Bool(true)))))
