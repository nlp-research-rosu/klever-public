+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  Starting with previous=current=P and drops=D, scanning
+  // VS leaves both value locals at lastAfter(P, VS) and transforms D by the
+  // exact strict-descent accumulator fold scanDrops.
+  claim [scan-loop]:
+    <k> #loop(list(VS:ValSeq), Name("current"), scanBody)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "arr"      |-> ARR:Val
+        "first"    |-> F:Val
+        "previous" |-> (P:Val => lastAfter(P, VS))
+        "current"  |-> (P => lastAfter(P, VS))
+        "drops"    |-> (D:Int => scanDrops(D, P, VS)),
+        parent(0))
+    </scopes>
+    requires isInt(P) andBool allInts(VS)
+
+  // Whole-program partial correctness from the exact function binding and
+  // body.  The theorem covers every finite list of mathematical integers.
+  claim [move-one-ball]:
+    <k> Call(Name("move_one_ball"), (list(VS:ValSeq), .Exprs))
+        => moveSpec(VS) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+         "move_one_ball" |-> closureVal("arr", moveOneBallBody, 0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1eb4e087d4e33c894632ef385972576240012df
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,77 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Exact AST aliases for solution.mpy.  These are compile-time macros: the
+  // fixed MPY rules still execute every statement in the function and loop.
+  syntax Stmts ::= "scanBody" [macro]
+  rule scanBody
+    => Assign(Name("drops"),
+         BinOp("+", Name("drops"),
+           Compare(Name("current"), CmpOp("<", Name("previous")))))
+       Assign(Name("previous"), Name("current"))
+
+  syntax Stmts ::= "moveOneBallBody" [macro]
+  rule moveOneBallBody
+    => If(UnaryOp("not", Name("arr")),
+          Return(Bool(true)),
+          .Stmts)
+       Assign(Name("first"), Subscript(Name("arr"), Int(0)))
+       Assign(Name("previous"), Name("first"))
+       Assign(Name("current"), Name("first"))
+       Assign(Name("drops"), Int(0))
+       For(Name("current"), Name("arr"), scanBody)
+       Assign(Name("drops"),
+         BinOp("+", Name("drops"),
+           Compare(Name("first"), CmpOp("<", Name("previous")))))
+       Return(Compare(Name("drops"), CmpOp("<=", Int(1))))
+
+  // The formal input-domain predicate: every MPY list element is an Int.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq)                => true
+  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)
+
+  // Sort-refinement lemma for the fixed MPY-INT comparison equation.  The
+  // guard states exactly when both Val-sorted operands are Int injections.
+  rule applyCmp("<", A:Val, B:Val)
+    => {A}:>Int <Int {B}:>Int
+    requires isInt(A) andBool isInt(B)
+    [simplification]
+
+  // The exact left fold performed by the loop.  These equations are
+  // intentionally defined only on the allInts domain.
+  syntax Int ::= scanDrops(Int, Val, ValSeq) [function]
+  rule scanDrops(D:Int, _:Val, .ValSeq) => D
+  rule scanDrops(D:Int, P:Val, vCons(V:Val, R:ValSeq))
+    => scanDrops(
+         D +Int (#if {V}:>Int <Int {P}:>Int #then 1 #else 0 #fi),
+         V,
+         R)
+    requires isInt(P) andBool isInt(V)
+
+  // The final integer after scanning VS, or P if VS is empty.
+  syntax Val ::= lastAfter(Val, ValSeq) [function, total]
+  rule lastAfter(P:Val, .ValSeq)                => P
+  rule lastAfter(_:Val, vCons(V:Val, R:ValSeq)) => lastAfter(V, R)
+
+  rule applyCmp("<", A:Val, lastAfter(P:Val, VS:ValSeq))
+    => {A}:>Int <Int {lastAfter(P, VS)}:>Int
+    requires isInt(A) andBool isInt(P) andBool allInts(VS)
+    [simplification]
+
+  // Exact result property: empty is accepted; a nonempty circular sequence is
+  // accepted iff it has at most one strict circular descent.
+  syntax Bool ::= moveSpec(ValSeq) [function]
+  rule moveSpec(VS:ValSeq) => true
+    requires VS ==K .ValSeq
+  rule moveSpec(VS:ValSeq)
+    => scanDrops(0, valSeqAt(VS, 0), VS)
+       +Int (#if {valSeqAt(VS, 0)}:>Int
+                   <Int {lastAfter(valSeqAt(VS, 0), VS)}:>Int
+             #then 1 #else 0 #fi)
+       <=Int 1
+    requires notBool (VS ==K .ValSeq) andBool allInts(VS)
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..2e24ccba2eca35653075af9912121805e5151b70
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,25 @@
+def move_one_ball(arr):
+    if not arr:
+        return True
+
+    first = arr[0]
+    previous = first
+    current = first
+    drops = 0
+
+    for current in arr:
+        drops = drops + (current < previous)
+        previous = current
+
+    drops = drops + (first < previous)
+
+    return drops <= 1
+
+
+assert move_one_ball([]) == True
+assert move_one_ball([7]) == True
+assert move_one_ball([1, 2, 3]) == True
+assert move_one_ball([3, 4, 5, 1, 2]) == True
+assert move_one_ball([3, 5, 4, 1, 2]) == False
+assert move_one_ball([2, 1, 3]) == False
+assert move_one_ball([5, 1, 2, 3, 4]) == True
diff --git a/differential_tests.py b/differential_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..b847f515f95e570dae1780c88384db77b7a9b6fd
--- /dev/null
+++ b/differential_tests.py
@@ -0,0 +1,48 @@
+import itertools
+
+from solution import move_one_ball
+
+
+def rotation_oracle(arr):
+    if not arr:
+        return True
+    target = sorted(arr)
+    for shifts in range(len(arr)):
+        candidate = arr[-shifts:] + arr[:-shifts]
+        if candidate == target:
+            return True
+    return False
+
+
+prompt_cases = [
+    ([3, 4, 5, 1, 2], True),
+    ([3, 5, 4, 1, 2], False),
+    ([], True),
+    ([7], True),
+    ([2, 1, 3], False),
+]
+
+for values, expected in prompt_cases:
+    assert move_one_ball(values) == expected
+    assert rotation_oracle(values) == expected
+
+unique_cases = 0
+for size in range(8):
+    for values in itertools.permutations(range(size)):
+        values = list(values)
+        assert move_one_ball(values) == rotation_oracle(values)
+        unique_cases += 1
+
+duplicate_cases = 0
+for size in range(7):
+    for values in itertools.product((-1, 0, 1), repeat=size):
+        values = list(values)
+        assert move_one_ball(values) == rotation_oracle(values)
+        duplicate_cases += 1
+
+print(
+    f"prompt_cases={len(prompt_cases)} "
+    f"unique_cases={unique_cases} "
+    f"duplicate_cases={duplicate_cases} "
+    "mismatches=0"
+)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..315c20a294acee27bace73b8ab1d2fb5378e5a08
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+python3 py2mpy.py solution.py | cmp - solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.scan-loop
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY
+vacuity_status=$?
+set -e
+if [[ "$vacuity_status" -eq 0 ]]; then
+  echo "ERROR: false-postcondition mutation unexpectedly proved"
+  exit 1
+fi
+echo "EXPECTED FAILURE: false-postcondition mutation exit $vacuity_status"
+
+set +e
+kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION
+body_status=$?
+set -e
+if [[ "$body_status" -eq 0 ]]; then
+  echo "ERROR: body mutation unexpectedly proved"
+  exit 1
+fi
+echo "EXPECTED FAILURE: body mutation exit $body_status"
+
+python3 differential_tests.py
