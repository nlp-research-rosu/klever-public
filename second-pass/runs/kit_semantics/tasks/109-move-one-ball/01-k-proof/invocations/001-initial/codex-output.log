+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  Starting with previous=current=P and drops=D, scanning
+  // intVals(IS) leaves both value locals at lastAfter(P, IS) and adds exactly
+  // dropCount(P, IS) strict descents.
+  claim [scan-loop]:
+    <k> #loop(list(intVals(IS:IntSeq)), Name("current"), scanBody)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
