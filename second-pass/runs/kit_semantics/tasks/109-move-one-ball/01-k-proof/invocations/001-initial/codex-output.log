+    if not arr:
+        return True
+
+    first = arr[0]
+    previous = first
+    current = first
+    drops = 0
+
+    for current in arr:
+        if current < previous:
+            drops = drops + 1
+        previous = current
+
+    if first < previous:
+        drops = drops + 1
+
+    return drops <= 1
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..85d99a8bfca0e2ca1772695080600b2aca923f82
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  Starting with previous=current=P and drops=D, scanning
+  // VS leaves both value locals at lastAfter(P, VS) and adds exactly
+  // dropCount(P, VS) strict descents.
+  claim [scan-loop]:
+    <k> #loop(list(VS:ValSeq), Name("current"), scanBody)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "arr"      |-> ARR:Val
+        "first"    |-> F:Val
+        "previous" |-> (P:Val => lastAfter(P, VS))
+        "current"  |-> (P => lastAfter(P, VS))
+        "drops"    |-> (D:Int => D +Int dropCount(P, VS)),
+        parent(0))
+    </scopes>
+    requires isInt(P) andBool allInts(VS)
+
+  // Whole-program partial correctness from the exact function binding and
+  // body.  The theorem covers every finite list of mathematical integers.
+  claim [move-one-ball]:
+    <k> Call(Name("move_one_ball"), (list(VS:ValSeq), .Exprs))
+        => moveSpec(VS) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+         "move_one_ball" |-> closureVal("arr", moveOneBallBody, 0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
