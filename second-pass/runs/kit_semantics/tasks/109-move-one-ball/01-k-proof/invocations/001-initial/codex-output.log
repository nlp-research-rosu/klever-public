diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..37eef4b4625fd910ee58cf66f47fee999b74aedf
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  Starting with previous=current=P and drops=D, scanning
+  // VS leaves both value locals at lastAfter(P, VS) and adds exactly
+  // dropCount(P, VS) strict descents.
+  claim [scan-loop]:
+    <k> #loop(list(VS:ValSeq), Name("current"), scanBody)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "arr"      |-> ARR:Val
+        "first"    |-> F:Val
+        "previous" |-> (P:Val => lastInt(P, VS))
+        "current"  |-> (P => lastAfter(P, VS))
+        "drops"    |-> (D:Int => D +Int dropCount(P, VS)),
+        parent(0))
+    </scopes>
+    requires isInt(P) andBool allInts(VS)
+
+  // Whole-program partial correctness from the exact function binding and
+  // body.  The theorem covers every finite list of mathematical integers.
+  claim [move-one-ball]:
+    <k> Call(Name("move_one_ball"), (list(VS:ValSeq), .Exprs))
+        => moveSpec(VS) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+         "move_one_ball" |-> closureVal("arr", moveOneBallBody, 0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..cdef4f125a35f8d9656973c4d6e60fb3aeae028b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,78 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Exact AST aliases for solution.mpy.  These are compile-time macros: the
+  // fixed MPY rules still execute every statement in the function and loop.
+  syntax Stmts ::= "scanBody" [macro]
+  rule scanBody
+    => If(Compare(Name("current"), CmpOp("<", Name("previous"))),
+          Assign(Name("drops"), BinOp("+", Name("drops"), Int(1))),
+          .Stmts)
+       Assign(Name("previous"), Name("current"))
+
+  syntax Stmts ::= "moveOneBallBody" [macro]
+  rule moveOneBallBody
+    => If(UnaryOp("not", Name("arr")),
+          Return(Bool(true)),
+          .Stmts)
+       Assign(Name("first"), Subscript(Name("arr"), Int(0)))
+       Assign(Name("previous"), Name("first"))
+       Assign(Name("current"), Name("first"))
+       Assign(Name("drops"), Int(0))
+       For(Name("current"), Name("arr"), scanBody)
+       If(Compare(Name("first"), CmpOp("<", Name("previous"))),
+          Assign(Name("drops"), BinOp("+", Name("drops"), Int(1))),
+          .Stmts)
+       Return(Compare(Name("drops"), CmpOp("<=", Int(1))))
+
+  // The formal input-domain predicate: every MPY list element is an Int.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq)                => true
+  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)
+
+  // Sort-refinement lemma for the fixed MPY-INT comparison equation.  The
+  // guard states exactly when both Val-sorted operands are Int injections.
+  rule applyCmp("<", A:Val, B:Val)
+    => {A}:>Int <Int {B}:>Int
+    requires isInt(A) andBool isInt(B)
+    [simplification]
+
+  // The number of strict descents encountered while scanning VS after P.
+  // These equations are intentionally defined only on the allInts domain.
+  syntax Int ::= dropCount(Val, ValSeq) [function]
+  rule dropCount(_:Val, .ValSeq) => 0
+  rule dropCount(P:Val, vCons(V:Val, R:ValSeq))
+    => 1 +Int dropCount(V, R)
+    requires isInt(P) andBool isInt(V)
+     andBool {V}:>Int <Int {P}:>Int
+  rule dropCount(P:Val, vCons(V:Val, R:ValSeq))
+    => dropCount(V, R)
+    requires isInt(P) andBool isInt(V)
+     andBool {V}:>Int >=Int {P}:>Int
+
+  // The final integer after scanning VS, or P if VS is empty.
+  syntax Val ::= lastAfter(Val, ValSeq) [function, total]
+  rule lastAfter(P:Val, .ValSeq)                => P
+  rule lastAfter(_:Val, vCons(V:Val, R:ValSeq)) => lastAfter(V, R)
+
+  syntax Int ::= lastInt(Val, ValSeq) [function]
+  rule lastInt(P:Val, .ValSeq) => {P}:>Int
+    requires isInt(P)
+  rule lastInt(_:Val, vCons(V:Val, R:ValSeq)) => lastInt(V, R)
+    requires isInt(V)
+
+  // Exact result property: empty is accepted; a nonempty circular sequence is
+  // accepted iff it has at most one strict circular descent.
+  syntax Bool ::= moveSpec(ValSeq) [function]
+  rule moveSpec(.ValSeq) => true
+  rule moveSpec(vCons(F:Val, R:ValSeq))
+    => dropCount(F, R)
+       +Int (#if {F}:>Int <Int lastInt(F, R)
+             #then 1 #else 0 #fi)
+       <=Int 1
+    requires isInt(F) andBool allInts(R)
+endmodule

exec
/bin/bash -lc 'set +e
kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.scan-loop > kprove-loop.out 2> kprove-loop.err
status=$?
printf '"'kprove_loop_exit=%s\\n' \""'$status"
sed -n '"'1,420p' kprove-loop.out
sed -n '1,340p' kprove-loop.err
exit \""'$status"' in /workspace
