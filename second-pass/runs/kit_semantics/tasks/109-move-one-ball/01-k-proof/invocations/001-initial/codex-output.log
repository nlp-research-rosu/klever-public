diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..450adde83c9675440ae6f52fc704afe9815c723c
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,27 @@
+def move_one_ball(arr):
+    if not arr:
+        return True
+
+    first = arr[0]
+    previous = first
+    current = first
+    drops = 0
+
+    for current in arr:
+        if current < previous:
+            drops = drops + 1
+        previous = current
+
+    if first < previous:
+        drops = drops + 1
+
+    return drops <= 1
+
+
+assert move_one_ball([]) == True
+assert move_one_ball([7]) == True
+assert move_one_ball([1, 2, 3]) == True
+assert move_one_ball([3, 4, 5, 1, 2]) == True
+assert move_one_ball([3, 5, 4, 1, 2]) == False
+assert move_one_ball([2, 1, 3]) == False
+assert move_one_ball([5, 1, 2, 3, 4]) == True
