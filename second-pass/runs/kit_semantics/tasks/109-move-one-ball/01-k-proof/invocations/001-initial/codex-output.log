+++ b/verification.k
@@ -0,0 +1,60 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Exact AST aliases for solution.mpy.  These are compile-time macros: the
+  // fixed MPY rules still execute every statement in the function and loop.
+  syntax Stmts ::= "scanBody" [macro]
+  rule scanBody
+    => If(Compare(Name("current"), CmpOp("<", Name("previous"))),
+          Assign(Name("drops"), BinOp("+", Name("drops"), Int(1))),
+          .Stmts)
+       Assign(Name("previous"), Name("current"))
+
+  syntax Stmts ::= "moveOneBallBody" [macro]
+  rule moveOneBallBody
+    => If(UnaryOp("not", Name("arr")),
+          Return(Bool(true)),
+          .Stmts)
+       Assign(Name("first"), Subscript(Name("arr"), Int(0)))
+       Assign(Name("previous"), Name("first"))
+       Assign(Name("current"), Name("first"))
+       Assign(Name("drops"), Int(0))
+       For(Name("current"), Name("arr"), scanBody)
+       If(Compare(Name("first"), CmpOp("<", Name("previous"))),
+          Assign(Name("drops"), BinOp("+", Name("drops"), Int(1))),
+          .Stmts)
+       Return(Compare(Name("drops"), CmpOp("<=", Int(1))))
+
+  // Embed a finite sequence of mathematical integers as an MPY list value.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq)                => .ValSeq
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
+
+  // The number of strict descents encountered while scanning IS after P.
+  syntax Int ::= dropCount(Int, IntSeq) [function, total]
+  rule dropCount(_:Int, .IntSeq) => 0
+  rule dropCount(P:Int, iCons(I:Int, R:IntSeq))
+    => 1 +Int dropCount(I, R)
+    requires I <Int P
+  rule dropCount(P:Int, iCons(I:Int, R:IntSeq))
+    => dropCount(I, R)
+    requires I >=Int P
+
+  // The final value after scanning IS, or P if IS is empty.
+  syntax Int ::= lastAfter(Int, IntSeq) [function, total]
+  rule lastAfter(P:Int, .IntSeq)                => P
+  rule lastAfter(_:Int, iCons(I:Int, R:IntSeq)) => lastAfter(I, R)
+
