+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  Starting with previous=current=P and drops=D, scanning
+  // intVals(IS) leaves both value locals at lastAfter(P, IS) and adds exactly
+  // dropCount(P, IS) strict descents.
+  claim [scan-loop]:
+    <k> #loop(list(intVals(IS:IntSeq)), Name("current"), scanBody)
+        => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        M:Map
+        "previous" |-> (P:Int => lastAfter(P, IS))
+        "current"  |-> (P => lastAfter(P, IS))
+        "drops"    |-> (D:Int => D +Int dropCount(P, IS)),
+        PAR:Parent)
+    </scopes>
+
+  // Whole-program partial correctness from the exact function binding and
+  // body.  The theorem covers every finite list of mathematical integers.
+  claim [move-one-ball]:
+    <k> Call(Name("move_one_ball"), (list(intVals(IS:IntSeq)), .Exprs))
+        => moveSpec(IS) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+         "move_one_ball" |-> closureVal("arr", moveOneBallBody, 0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1cc82f102b90d0c06bd0c6e7afdd64308fd407ec
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,60 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Exact AST aliases for solution.mpy.  These are compile-time macros: the
+  // fixed MPY rules still execute every statement in the function and loop.
+  syntax Stmts ::= "scanBody" [macro]
+  rule scanBody
+    => If(Compare(Name("current"), CmpOp("<", Name("previous"))),
+          Assign(Name("drops"), BinOp("+", Name("drops"), Int(1))),
+          .Stmts)
+       Assign(Name("previous"), Name("current"))
+
+  syntax Stmts ::= "moveOneBallBody" [macro]
+  rule moveOneBallBody
+    => If(UnaryOp("not", Name("arr")),
+          Return(Bool(true)),
+          .Stmts)
+       Assign(Name("first"), Subscript(Name("arr"), Int(0)))
+       Assign(Name("previous"), Name("first"))
+       Assign(Name("current"), Name("first"))
+       Assign(Name("drops"), Int(0))
+       For(Name("current"), Name("arr"), scanBody)
+       If(Compare(Name("first"), CmpOp("<", Name("previous"))),
+          Assign(Name("drops"), BinOp("+", Name("drops"), Int(1))),
+          .Stmts)
+       Return(Compare(Name("drops"), CmpOp("<=", Int(1))))
+
+  // Embed a finite sequence of mathematical integers as an MPY list value.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq)                => .ValSeq
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
+
+  // The number of strict descents encountered while scanning IS after P.
+  syntax Int ::= dropCount(Int, IntSeq) [function, total]
+  rule dropCount(_:Int, .IntSeq) => 0
+  rule dropCount(P:Int, iCons(I:Int, R:IntSeq))
+    => 1 +Int dropCount(I, R)
+    requires I <Int P
+  rule dropCount(P:Int, iCons(I:Int, R:IntSeq))
+    => dropCount(I, R)
+    requires I >=Int P
+
+  // The final value after scanning IS, or P if IS is empty.
+  syntax Int ::= lastAfter(Int, IntSeq) [function, total]
+  rule lastAfter(P:Int, .IntSeq)                => P
+  rule lastAfter(_:Int, iCons(I:Int, R:IntSeq)) => lastAfter(I, R)
+
+  // Exact result property: empty is accepted; a nonempty circular sequence is
+  // accepted iff it has at most one strict circular descent.
+  syntax Bool ::= moveSpec(IntSeq) [function, total]
+  rule moveSpec(.IntSeq) => true
+  rule moveSpec(iCons(F:Int, R:IntSeq))
+    => dropCount(F, R)
+       +Int (#if F <Int lastAfter(F, R) #then 1 #else 0 #fi)
+       <=Int 1
+endmodule

