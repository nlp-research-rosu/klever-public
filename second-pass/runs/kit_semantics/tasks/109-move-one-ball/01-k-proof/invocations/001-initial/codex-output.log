+  // accepted iff it has at most one strict circular descent.
+  syntax Bool ::= moveSpec(IntSeq) [function, total]
+  rule moveSpec(.IntSeq) => true
+  rule moveSpec(iCons(F:Int, R:IntSeq))
+    => dropCount(F, R)
+       +Int (#if F <Int lastAfter(F, R) #then 1 #else 0 #fi)
+       <=Int 1
+endmodule

