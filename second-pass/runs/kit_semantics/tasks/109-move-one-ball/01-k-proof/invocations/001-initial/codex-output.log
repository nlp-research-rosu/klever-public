+    => scanDrops(0, F, vCons(F, R))
+       +Int (#if {F}:>Int <Int {lastAfter(F, R)}:>Int
+             #then 1 #else 0 #fi)
+       <=Int 1
+    requires isInt(F) andBool allInts(R)
+endmodule

