import itertools
from solution import move_one_ball

def oracle(xs):
    return any(xs[-k:] + xs[:-k] == sorted(xs) for k in range(len(xs) + 1))

checked = 0
for n in range(8):
    for xs in itertools.permutations(range(n)):
        got = move_one_ball(list(xs))
        want = oracle(list(xs))
        assert got == want, (xs, got, want)
        checked += 1
print(f\"python_exhaustive_unique_cases={checked} mismatches=0\")
