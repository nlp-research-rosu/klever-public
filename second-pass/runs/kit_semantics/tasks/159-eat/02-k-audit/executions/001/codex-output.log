   122	
   123	  // ---- the remaining comparisons (gtF promoted from find_zero — its summaries
   124	  //      case-split on the atom; >= / <= derive from the two opaque compares) ----
   125	  syntax Bool ::= gtF(Float, Float) [function, total, symbol(gtF), no-evaluators]
   126	  rule gtF(F1:Float, F2:Float) => F1 >Float F2 [concrete]
   127	  rule applyCmp(">",  F1:Float, F2:Float) => gtF(F1, F2)
   128	  rule applyCmp(">=", F1:Float, F2:Float) => notBool floatLt(F1, F2)
   129	  rule applyCmp("<=", F1:Float, F2:Float) => notBool gtF(F1, F2)
   130	
   131	  // ---- mixed Int/Float operators promote the Int side (n ** 0.5 etc.) ----
   132	  rule applyBin("**", I:Int, F:Float) => powF(intToF(I), F)
   133	  rule applyBin("**", F:Float, I:Int) => powF(F, intToF(I))
   134	  rule applyBin("-",  I:Int, F:Float) => subF(intToF(I), F)
   135	  rule applyBin("-",  F:Float, I:Int) => subF(F, intToF(I))
   136	  rule applyBin("+",  I:Int, F:Float) => addF(intToF(I), F)
   137	  rule applyBin("+",  F:Float, I:Int) => addF(F, intToF(I))
   138	  rule applyBin("*",  I:Int, F:Float) => mulF(intToF(I), F)
   139	  rule applyBin("*",  F:Float, I:Int) => mulF(F, intToF(I))
   140	
   141	  // ---- mixed Int == Float (shared eqF; opaque symbolic / concrete twin) ----
   142	  syntax Bool ::= eqF(Float, Float) [function, total, symbol(eqF), no-evaluators]
   143	  rule eqF(F1:Float, F2:Float) => F1 ==Float F2 [concrete]
   144	  rule applyCmp("==", I:Int, F:Float) => eqF(intToF(I), F)
   145	  rule applyCmp("==", F:Float, I:Int) => eqF(F, intToF(I))
   146	  rule applyCmp("!=", I:Int, F:Float) => notBool eqF(intToF(I), F)
   147	  rule applyCmp("!=", F:Float, I:Int) => notBool eqF(F, intToF(I))
   148	  rule applyCmp("<",  I:Int, F:Float) => floatLt(intToF(I), F)
   149	  rule applyCmp("<",  F:Float, I:Int) => floatLt(F, intToF(I))
   150	  rule applyCmp(">",  I:Int, F:Float) => gtF(intToF(I), F)
   151	  rule applyCmp(">",  F:Float, I:Int) => gtF(F, intToF(I))
   152	
   153	  // ---- x == None (promoted from 137; `is` cases live in operators.k) ----
   154	  rule applyCmp("==", V:Val, noneV) => V ==K noneV
   155	  rule applyCmp("!=", V:Val, noneV) => notBool (V ==K noneV)
   156	
   157	  // ---- float(str): decimal parse (promoted from 137's defined chain) ----
   158	  // digits '.' digits, optional leading '-'; concrete evaluation only (the
   159	  // symbolic side stays an opaque decStrToF term a proof case-splits on).
   160	  syntax Float ::= decStrToF(IntSeq) [function, total, symbol(decStrToF), no-evaluators]
   161	  rule decStrToF(iCons(45, CS:IntSeq)) => 0.0 -Float decStrToF(CS) [concrete]
   162	  rule decStrToF(CS:IntSeq)
   163	    => intToF(intPart(CS)) +Float (intToF(fracPart(CS)) /Float intToF(fracScale(CS)))
   164	       requires isLen(CS) >Int 0 andBool headIS(CS) =/=Int 45 [concrete]
   165	  syntax Int ::= headIS(IntSeq) [function]
   166	  rule headIS(iCons(C:Int, _:IntSeq)) => C
   167	  syntax Int ::= intPart(IntSeq) [function, total] | intPartAcc(IntSeq, Int) [function, total]
   168	  rule intPart(CS:IntSeq) => intPartAcc(CS, 0)
   169	  rule intPartAcc(.IntSeq, A:Int) => A
   170	  rule intPartAcc(iCons(46, _:IntSeq), A:Int) => A
   171	  rule intPartAcc(iCons(C:Int, R:IntSeq), A:Int) => intPartAcc(R, A *Int 10 +Int (C -Int 48))
   172	       requires C =/=Int 46
   173	  syntax Int ::= fracPart(IntSeq) [function, total] | fracAcc(IntSeq, Int) [function, total]
   174	  rule fracPart(.IntSeq) => 0
   175	  rule fracPart(iCons(46, R:IntSeq)) => fracAcc(R, 0)
   176	  rule fracPart(iCons(C:Int, R:IntSeq)) => fracPart(R) requires C =/=Int 46
   177	  rule fracAcc(.IntSeq, A:Int) => A
   178	  rule fracAcc(iCons(C:Int, R:IntSeq), A:Int) => fracAcc(R, A *Int 10 +Int (C -Int 48))
   179	  syntax Int ::= fracScale(IntSeq) [function, total] | fscAcc(IntSeq, Int) [function, total]
   180	  rule fracScale(.IntSeq) => 1
   181	  rule fracScale(iCons(46, R:IntSeq)) => fscAcc(R, 1)
   182	  rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46
   183	  rule fscAcc(.IntSeq, A:Int) => A
   184	  rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)
   185	  rule applyBuiltin("float", str(CS:IntSeq), .Vals) => decStrToF(CS)
   186	  rule applyBuiltin("float", I:Int, .Vals)          => intToF(I)
   187	  rule applyBuiltin("float", F:Float, .Vals)        => F
   188	
   189	  // ---- float / int division (promoted from mean_absolute_deviation) ----
   190	  syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]
   191	  rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]
   192	  rule applyBin("/", F:Float, I:Int) => divFloatIntV(F, I)
   193	
   194	  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----
   195	  syntax Float ::= intToF(Int) [function, total, symbol(intToF), no-evaluators]
   196	  rule intToF(I:Int) => Int2Float(I, 53, 11) [concrete]
   197	  rule applyBin("+", I:Int, F:Float) => addF(intToF(I), F)
   198	  rule applyBin("+", F:Float, I:Int) => addF(F, intToF(I))
   199	  rule applyBin("-", I:Int, F:Float) => subF(intToF(I), F)
   200	  rule applyBin("-", F:Float, I:Int) => subF(F, intToF(I))
   201	  rule applyBin("*", I:Int, F:Float) => mulF(intToF(I), F)
   202	  rule applyBin("*", F:Float, I:Int) => mulF(F, intToF(I))
   203	  rule applyCmp("<", I:Int, F:Float) => floatLt(intToF(I), F)
   204	  rule applyCmp("<", F:Float, I:Int) => floatLt(F, intToF(I))
   205	  rule applyCmp(">", I:Int, F:Float) => gtF(intToF(I), F)
   206	  rule applyCmp(">", F:Float, I:Int) => gtF(F, intToF(I))
   207	
   208	  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----
   209	  syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]
   210	  rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]
   211	  rule applyBuiltin("int", F:Float, .Vals) => truncF(F)
   212	
   213	  rule applyBuiltin("float", I:Int, .Vals)   => intToF(I)
   214	  rule applyBuiltin("float", F:Float, .Vals) => F
   215	
   216	  // round: Python half-even (banker's); round(F, N) scales by 10^N
   217	  syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]
   218	  rule roundF(F:Float)
   219	    => #if (F -Float floorFloat(F)) ==Float 0.5
   220	       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
   221	              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
   222	       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
   223	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   224	  rule roundFN(F:Float, N:Int)
   225	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   226	       /Float Int2Float(10 ^Int N, 53, 11) [concrete]
   227	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   228	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   229	
   230	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   231	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   232	  syntax KItem ::= "#mathSqrt"
   233	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   234	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   235	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   236	
   237	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   238	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   239	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   240	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   241	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   242	  // the isFloat guard is disjoint from the existing isInt one.
   243	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   244	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   245	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   246	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   247	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   248	       requires isFloat(V)
   249	
   250	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   251	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   252	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   253	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   254	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   255	       requires isFloat(V)
   256	
   257	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   258	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   259	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   260	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   261	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   262	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   263	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   264	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   265	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   266	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   267	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   268	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   269	       requires isFloat(V)
   270	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   271	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   272	       requires isInt(V) orBool isBool(V)
   273	endmodule

diff --git a/evidence/02-fidelity.sh b/evidence/02-fidelity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..636248458fbd84fe30128c76579c08431be0797f
--- /dev/null
+++ b/evidence/02-fidelity.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/159-eat
+
+python3 /reference/py2mpy.py solution.py > regenerated-solution.mpy
+translation_status=$?
+echo "translation_exit=${translation_status}"
+
+cmp -s solution.mpy regenerated-solution.mpy
+identity_status=$?
+echo "translation_byte_identity_exit=${identity_status}"
+
+sha256sum solution.py solution.mpy regenerated-solution.mpy \
+  /reference/prompt.py /reference/canonical.py /reference/py2mpy.py
+hash_status=$?
+echo "sha256sum_exit=${hash_status}"
+
+python3 /audit-output/evidence/differential_test.py
+differential_status=$?
+echo "differential_exit=${differential_status}"
+
+if (( translation_status != 0 || identity_status != 0 || hash_status != 0 ||
+      differential_status != 0 )); then
+  exit 1
+fi
diff --git a/evidence/03-concrete-tests.py b/evidence/03-concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..089fc2daf5d9e86efed14e253b517b3f4a4a1823
--- /dev/null
+++ b/evidence/03-concrete-tests.py
@@ -0,0 +1,13 @@
+def eat(number, need, remaining):
+    if need <= remaining:
+        return [number + need, remaining - need]
+    return [number + remaining, 0]
+
+
+example_enough = eat(5, 6, 10)
+example_equal = eat(1, 10, 10)
+example_insufficient = eat(2, 11, 5)
+all_zero = eat(0, 0, 0)
+zero_need = eat(1000, 0, 1000)
+zero_remaining = eat(1000, 1000, 0)
+maximum_equal = eat(1000, 1000, 1000)
diff --git a/evidence/03-reconstruction.sh b/evidence/03-reconstruction.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a89aff4f2c3fcf3f80e69e6e246f1c33e03c5766
--- /dev/null
+++ b/evidence/03-reconstruction.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/159-eat
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition fresh-runtime-kompiled
+runtime_build_status=$?
+echo "runtime_kompile_exit=${runtime_build_status}"
+
+python3 /reference/py2mpy.py \
+  /audit-output/evidence/03-concrete-tests.py > fresh-concrete-tests.mpy
+concrete_translation_status=$?
+echo "concrete_translation_exit=${concrete_translation_status}"
+
+krun fresh-concrete-tests.mpy --definition fresh-runtime-kompiled
+concrete_run_status=$?
+echo "concrete_krun_exit=${concrete_run_status}"
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition fresh-verification-kompiled
+proof_build_status=$?
+echo "proof_kompile_exit=${proof_build_status}"
+
+kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC
+combined_status=$?
+echo "combined_kprove_exit=${combined_status}"
+
+kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.eat-enough
+enough_status=$?
+echo "eat_enough_kprove_exit=${enough_status}"
+
+kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.eat-insufficient
+insufficient_status=$?
+echo "eat_insufficient_kprove_exit=${insufficient_status}"
+
+if (( runtime_build_status != 0 || concrete_translation_status != 0 ||
+      concrete_run_status != 0 || proof_build_status != 0 ||
+      combined_status != 0 || enough_status != 0 ||
+      insufficient_status != 0 )); then
+  exit 1
+fi
diff --git a/evidence/04-body-mutation.k b/evidence/04-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..a2fc05f1ee94ed38cb275be1f27a4922bf2f145c
--- /dev/null
+++ b/evidence/04-body-mutation.k
@@ -0,0 +1,52 @@
+requires "verification.k"
+
+module AUDIT-BODY-MUTATION
+  imports VERIFICATION
+
+  // Reachable witness: this changed body adds one extra carrot in the taken
+  // enough-stock branch, but the destination retains the real program result.
+  claim [changed-executed-body]:
+    <k> Call(Name("eat"), Int(5), Int(6), Int(10)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "eat" |-> closureVal(
+          "number", "need", "remaining", .ParamNames,
+          If(
+            Compare(Name("need"), CmpOp("<=", Name("remaining"))),
+            Return(
+              ListExpr(
+                BinOp(
+                  "+",
+                  BinOp("+", Name("number"), Name("need")),
+                  Int(1)
+                ),
+                BinOp("-", Name("remaining"), Name("need"))
+              )
+            ),
+            .Stmts
+          )
+          Return(
+            ListExpr(
+              BinOp("+", Name("number"), Name("remaining")),
+              Int(0)
+            )
+          ),
+          0
+        ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(11, vCons(4, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/04-pinning.sh b/evidence/04-pinning.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5310e7cfd78b271f18b04cf85c26f9866d9e6f28
--- /dev/null
+++ b/evidence/04-pinning.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/159-eat
+
+python3 /audit-output/evidence/pinning_check.py
+pinning_status=$?
+echo "constructor_pinning_exit=${pinning_status}"
+
+cp /audit-output/evidence/04-body-mutation.k audit-body-mutation.k
+copy_status=$?
+echo "body_mutation_copy_exit=${copy_status}"
+
+kprove audit-body-mutation.k \
+  --definition fresh-verification-kompiled \
+  --spec-module AUDIT-BODY-MUTATION
+body_mutation_status=$?
+echo "body_mutation_kprove_exit=${body_mutation_status}"
+
+if (( pinning_status != 0 || copy_status != 0 )); then
+  exit 1
+fi
+
+# The mutation must parse/build and reach a stuck result obligation.
+if (( body_mutation_status == 0 )); then
+  exit 1
+fi
+
+exit 0
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..b63522865421e1e5cc964fc2338922747aed0106
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Independent differential test for trusted canonical.py vs scratch solution.py."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import random
+from pathlib import Path
+
+
+def load_entry(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.eat
+
+
+canonical_eat = load_entry("trusted_canonical_159", Path("/reference/canonical.py"))
+generated_eat = load_entry(
+    "scratch_generated_159", Path("/tmp/audit-work/159-eat/solution.py")
+)
+
+examples = [
+    (5, 6, 10),
+    (4, 8, 9),
+    (1, 10, 10),
+    (2, 11, 5),
+]
+
+# Includes all-zero, each coordinate boundary, and all eight 0/1000 corners.
+boundary_values = (0, 1, 999, 1000)
+boundaries = [
+    (number, need, remaining)
+    for number in boundary_values
+    for need in boundary_values
+    for remaining in boundary_values
+]
+
+# Exercise the exact branch edge need == remaining and its neighbors where valid.
+branch_edges = []
+for number in boundary_values:
+    for remaining in range(0, 1001):
+        for need in (remaining - 1, remaining, remaining + 1):
+            if 0 <= need <= 1000:
+                branch_edges.append((number, need, remaining))
+
+# Exhaustive small cube covers every combination in [0, 20]^3.
+small_exhaustive = [
+    (number, need, remaining)
+    for number in range(21)
+    for need in range(21)
+    for remaining in range(21)
+]
+
+generator = random.Random(159_20260729)
+generated = [
+    (
+        generator.randint(0, 1000),
+        generator.randint(0, 1000),
+        generator.randint(0, 1000),
+    )
+    for _ in range(20_000)
+]
+
+cases = examples + boundaries + branch_edges + small_exhaustive + generated
+serialized = json.dumps(cases, separators=(",", ":")).encode()
+Path("/audit-output/evidence/differential-inputs.json").write_bytes(serialized)
+
+mismatches = []
+shape_failures = []
+formula_failures = []
+branch_counts = {"need<=remaining": 0, "need>remaining": 0}
+for args in cases:
+    expected = canonical_eat(*args)
+    actual = generated_eat(*args)
+    if args[1] <= args[2]:
+        branch_counts["need<=remaining"] += 1
+        formula = [args[0] + args[1], args[2] - args[1]]
+    else:
+        branch_counts["need>remaining"] += 1
+        formula = [args[0] + args[2], 0]
+    if actual != expected:
+        mismatches.append((args, actual, expected))
+    if type(actual) is not list or len(actual) != 2:
+        shape_failures.append((args, type(actual).__name__, actual))
+    if actual != formula or expected != formula:
+        formula_failures.append((args, actual, expected, formula))
+
+print("contract_domain=integer triples with each coordinate in [0,1000]")
+print(f"examples={len(examples)}")
+print(f"boundaries={len(boundaries)}")
+print(f"branch_edges={len(branch_edges)}")
+print(f"small_exhaustive={len(small_exhaustive)}")
+print("random_seed=15920260729")
+print(f"generated={len(generated)}")
+print(f"total_cases={len(cases)}")
+print(f"branch_counts={branch_counts}")
+print(f"inputs_sha256={hashlib.sha256(serialized).hexdigest()}")
+print(f"mismatches={len(mismatches)}")
