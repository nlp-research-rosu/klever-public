   108	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   109	       requires N >=Int 0
   110	  // negative operand: the '-' sign prefixes the magnitude's digits
   111	  rule applyBuiltin("bin", N:Int, .Vals)
   112	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   113	       requires N <Int 0
   114	  syntax IntSeq ::= binCodes(Int) [function, total]
   115	  rule binCodes(0) => iCons(48, .IntSeq)
   116	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   117	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   118	  rule binAcc(0, ACC:IntSeq) => ACC
   119	  rule binAcc(N:Int, ACC:IntSeq)
   120	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   121	       requires N >Int 0
   122	
   123	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   124	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   125	        => #alloc(list(enumVS(VS, 0))) ... </k>
   126	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   127	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   128	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   129	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   130	
   131	  // ==== map(str, xs) — eager (only the str case is in the subset) =============
   132	  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
   133	        => #alloc(list(mapStrVS(VS))) ... </k>
   134	  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
   135	  rule mapStrVS(.ValSeq) => .ValSeq
   136	  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
   137	  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
   138	
   139	  // ==== int(x) identities (int(round(x)) composes through) ====================
   140	  rule applyBuiltin("int", I:Int, .Vals) => I
   141	
   142	  // ==== ord / chr ===========================================================
   143	  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
   144	  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
   145	       requires 0 <=Int I andBool I <Int 128
   146	
   147	  // ==== str(int) / str(str) =================================================
   148	  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
   149	  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
   150	
   151	  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
   152	  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
   153	       requires 48 <=Int C andBool C <=Int 57
   154	
   155	  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
   156	  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
   157	       requires isLen(CS) >=Int 2
   158	  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
   159	  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
   160	  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
   161	
   162	  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
   163	  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
   164	  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
   165	
   166	  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
   167	  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
   168	        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
   169	  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
   170	  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
   171	  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
   172	        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
   173	  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
   174	  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>
   175	
   176	  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
   177	  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
   178	  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
   179	  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
   180	       requires S =/=Int 0
   181	
   182	  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
   183	  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
   184	  // trusted pass evaluator, now DEFINED in the reference and driven by a
   185	  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
   186	  // argument leaves the call unevaluated for problem-level folds.
   187	  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
   188	  syntax Int ::= evalArith(IntSeq) [function]
   189	  rule evalArith(CS:IntSeq)
   190	    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))
   191	
   192	  syntax OpSeq ::= ".OpSeq" | oCons(String, OpSeq)
   193	
   194	  syntax Bool ::= evDigit(Int) [function, total]
   195	  rule evDigit(C:Int) => C >=Int 48 andBool C <=Int 57
   196	  syntax Bool ::= evHead42(IntSeq) [function, total]
   197	  rule evHead42(iCons(42, _:IntSeq)) => true
   198	  rule evHead42(_:IntSeq)            => false [owise]
   199	  syntax Bool ::= evHead47(IntSeq) [function, total]
   200	  rule evHead47(iCons(47, _:IntSeq)) => true
   201	  rule evHead47(_:IntSeq)            => false [owise]
   202	
   203	  syntax OpSeq ::= tokOps(IntSeq) [function, total]
   204	  rule tokOps(.IntSeq)                 => .OpSeq
   205	  rule tokOps(iCons(32, R:IntSeq))     => tokOps(R)
   206	  rule tokOps(iCons(C:Int, R:IntSeq))  => tokOps(R) requires evDigit(C)
   207	  rule tokOps(iCons(42, iCons(42, R:IntSeq))) => oCons("**", tokOps(R))
   208	  rule tokOps(iCons(42, R:IntSeq))     => oCons("*", tokOps(R)) requires notBool evHead42(R)
   209	  rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons("//", tokOps(R))
   210	  rule tokOps(iCons(47, R:IntSeq))     => oCons("/", tokOps(R)) requires notBool evHead47(R)
   211	  rule tokOps(iCons(43, R:IntSeq))     => oCons("+", tokOps(R))
   212	  rule tokOps(iCons(45, R:IntSeq))     => oCons("-", tokOps(R))
   213	
   214	  syntax IntSeq ::= tokNds(IntSeq) [function, total]
   215	                  | tokNdAcc(Int, IntSeq) [function, total]
   216	  rule tokNds(.IntSeq)                => .IntSeq
   217	  rule tokNds(iCons(32, R:IntSeq))    => tokNds(R)
   218	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNdAcc(C -Int 48, R) requires evDigit(C)
   219	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNds(R)
   220	       requires notBool evDigit(C) andBool C =/=Int 32
   221	  rule tokNdAcc(A:Int, iCons(C:Int, R:IntSeq)) => tokNdAcc(A *Int 10 +Int (C -Int 48), R)
   222	       requires evDigit(C)
   223	  rule tokNdAcc(A:Int, S:IntSeq) => iCons(A, tokNds(S)) [owise]
   224	
   225	  syntax EvPair ::= evp(OpSeq, IntSeq)
   226	  syntax Int ::= firstNdE(EvPair) [function, total]
   227	  rule firstNdE(evp(_:OpSeq, iCons(N:Int, _:IntSeq))) => N
   228	  rule firstNdE(_:EvPair) => 0 [owise]
   229	
   230	  syntax Int ::= applyOpE(String, Int, Int) [function, total]
   231	  rule applyOpE("+",  A:Int, B:Int) => A +Int B
   232	  rule applyOpE("-",  A:Int, B:Int) => A -Int B
   233	  rule applyOpE("*",  A:Int, B:Int) => A *Int B
   234	  rule applyOpE("//", A:Int, B:Int) => A divInt B
   235	  rule applyOpE("**", A:Int, B:Int) => A ^Int B
   236	  rule applyOpE(_:String, A:Int, _:Int) => A [owise]
   237	
   238	  syntax EvPair ::= passPowE(OpSeq, IntSeq) [function, total]
   239	  rule passPowE(.OpSeq, NDS:IntSeq) => evp(.OpSeq, NDS)
   240	  rule passPowE(oCons("**", OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCombE(N, passPowE(OPS, NDS))
   241	  rule passPowE(oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCarryE(O, N, passPowE(OPS, NDS))
   242	       requires O =/=String "**"
   243	  rule passPowE(_:OpSeq, .IntSeq) => evp(.OpSeq, .IntSeq) [owise]
   244	  syntax EvPair ::= powCombE(Int, EvPair) [function, total]
   245	  rule powCombE(N:Int, evp(OPS:OpSeq, iCons(M:Int, REST:IntSeq))) => evp(OPS, iCons(N ^Int M, REST))
   246	  rule powCombE(N:Int, evp(OPS:OpSeq, .IntSeq)) => evp(OPS, iCons(N, .IntSeq))
   247	  syntax EvPair ::= powCarryE(String, Int, EvPair) [function, total]
   248	  rule powCarryE(O:String, N:Int, evp(OPS:OpSeq, NDS:IntSeq)) => evp(oCons(O, OPS), iCons(N, NDS))
   249	
   250	  syntax EvPair ::= passMulE(EvPair) [function, total] | passAddE(EvPair) [function, total]
   251	  rule passMulE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("mul", N0, OPS, NDS, .OpSeq, .IntSeq)
   252	  rule passMulE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   253	  rule passAddE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("add", N0, OPS, NDS, .OpSeq, .IntSeq)
   254	  rule passAddE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   255	  syntax EvPair ::= passLGoE(String, Int, OpSeq, IntSeq, OpSeq, IntSeq) [function, total]
   256	  rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))
   257	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   258	    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)
   259	       requires inLevelE(L, O)
   260	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   261	    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))
   262	       requires notBool inLevelE(L, O)
   263	  rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)
   264	    => evp(OO, appendIE(ON, CUR)) [owise]
   265	  syntax Bool ::= inLevelE(String, String) [function, total]
   266	  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
   267	  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
   268	  rule inLevelE(_:String, _:String) => false [owise]
   269	  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
   270	  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
   271	  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))
   272	  syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]
   273	  rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)
   274	  rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))
   275	
   276	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   277	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   278	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   279	  syntax KItem ::= "#md5"
   280	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   281	       [priority(40)]
   282	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   283	  syntax Val ::= md5Obj(IntSeq)
   284	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   285	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   286	
   287	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   288	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   289	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   290	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   291	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   292	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   293	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   294	  rule isIntV(_:Int)         => true
   295	  rule isIntV(_:Val)         => false [owise]
   296	  rule isStrV(str(_:IntSeq)) => true
   297	  rule isStrV(_:Val)         => false [owise]
   298	endmodule

diff --git a/evidence/02-fidelity.sh b/evidence/02-fidelity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..636248458fbd84fe30128c76579c08431be0797f
--- /dev/null
+++ b/evidence/02-fidelity.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/159-eat
+
+python3 /reference/py2mpy.py solution.py > regenerated-solution.mpy
+translation_status=$?
+echo "translation_exit=${translation_status}"
+
+cmp -s solution.mpy regenerated-solution.mpy
+identity_status=$?
+echo "translation_byte_identity_exit=${identity_status}"
+
+sha256sum solution.py solution.mpy regenerated-solution.mpy \
+  /reference/prompt.py /reference/canonical.py /reference/py2mpy.py
+hash_status=$?
+echo "sha256sum_exit=${hash_status}"
+
+python3 /audit-output/evidence/differential_test.py
+differential_status=$?
+echo "differential_exit=${differential_status}"
+
+if (( translation_status != 0 || identity_status != 0 || hash_status != 0 ||
+      differential_status != 0 )); then
+  exit 1
+fi
diff --git a/evidence/03-concrete-tests.py b/evidence/03-concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..089fc2daf5d9e86efed14e253b517b3f4a4a1823
--- /dev/null
+++ b/evidence/03-concrete-tests.py
@@ -0,0 +1,13 @@
+def eat(number, need, remaining):
+    if need <= remaining:
+        return [number + need, remaining - need]
+    return [number + remaining, 0]
+
+
+example_enough = eat(5, 6, 10)
+example_equal = eat(1, 10, 10)
+example_insufficient = eat(2, 11, 5)
+all_zero = eat(0, 0, 0)
+zero_need = eat(1000, 0, 1000)
+zero_remaining = eat(1000, 1000, 0)
+maximum_equal = eat(1000, 1000, 1000)
diff --git a/evidence/03-reconstruction.sh b/evidence/03-reconstruction.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a89aff4f2c3fcf3f80e69e6e246f1c33e03c5766
--- /dev/null
+++ b/evidence/03-reconstruction.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/159-eat
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition fresh-runtime-kompiled
+runtime_build_status=$?
+echo "runtime_kompile_exit=${runtime_build_status}"
+
+python3 /reference/py2mpy.py \
+  /audit-output/evidence/03-concrete-tests.py > fresh-concrete-tests.mpy
+concrete_translation_status=$?
+echo "concrete_translation_exit=${concrete_translation_status}"
+
+krun fresh-concrete-tests.mpy --definition fresh-runtime-kompiled
+concrete_run_status=$?
+echo "concrete_krun_exit=${concrete_run_status}"
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition fresh-verification-kompiled
+proof_build_status=$?
+echo "proof_kompile_exit=${proof_build_status}"
+
+kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC
+combined_status=$?
+echo "combined_kprove_exit=${combined_status}"
+
+kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.eat-enough
+enough_status=$?
+echo "eat_enough_kprove_exit=${enough_status}"
+
+kprove spec.k \
+  --definition fresh-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.eat-insufficient
+insufficient_status=$?
+echo "eat_insufficient_kprove_exit=${insufficient_status}"
+
+if (( runtime_build_status != 0 || concrete_translation_status != 0 ||
+      concrete_run_status != 0 || proof_build_status != 0 ||
+      combined_status != 0 || enough_status != 0 ||
+      insufficient_status != 0 )); then
+  exit 1
+fi
diff --git a/evidence/04-body-mutation.k b/evidence/04-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..a2fc05f1ee94ed38cb275be1f27a4922bf2f145c
--- /dev/null
+++ b/evidence/04-body-mutation.k
@@ -0,0 +1,52 @@
+requires "verification.k"
+
+module AUDIT-BODY-MUTATION
+  imports VERIFICATION
+
+  // Reachable witness: this changed body adds one extra carrot in the taken
+  // enough-stock branch, but the destination retains the real program result.
+  claim [changed-executed-body]:
+    <k> Call(Name("eat"), Int(5), Int(6), Int(10)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "eat" |-> closureVal(
+          "number", "need", "remaining", .ParamNames,
+          If(
+            Compare(Name("need"), CmpOp("<=", Name("remaining"))),
+            Return(
+              ListExpr(
+                BinOp(
+                  "+",
+                  BinOp("+", Name("number"), Name("need")),
+                  Int(1)
+                ),
+                BinOp("-", Name("remaining"), Name("need"))
+              )
+            ),
+            .Stmts
+          )
+          Return(
+            ListExpr(
+              BinOp("+", Name("number"), Name("remaining")),
+              Int(0)
+            )
+          ),
+          0
+        ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(11, vCons(4, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/04-pinning.sh b/evidence/04-pinning.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5310e7cfd78b271f18b04cf85c26f9866d9e6f28
--- /dev/null
+++ b/evidence/04-pinning.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/159-eat
+
+python3 /audit-output/evidence/pinning_check.py
+pinning_status=$?
+echo "constructor_pinning_exit=${pinning_status}"
+
+cp /audit-output/evidence/04-body-mutation.k audit-body-mutation.k
+copy_status=$?
+echo "body_mutation_copy_exit=${copy_status}"
+
+kprove audit-body-mutation.k \
+  --definition fresh-verification-kompiled \
+  --spec-module AUDIT-BODY-MUTATION
+body_mutation_status=$?
+echo "body_mutation_kprove_exit=${body_mutation_status}"
+
+if (( pinning_status != 0 || copy_status != 0 )); then
+  exit 1
+fi
+
+# The mutation must parse/build and reach a stuck result obligation.
+if (( body_mutation_status == 0 )); then
+  exit 1
+fi
+
+exit 0
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..b63522865421e1e5cc964fc2338922747aed0106
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Independent differential test for trusted canonical.py vs scratch solution.py."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import random
+from pathlib import Path
+
+
+def load_entry(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.eat
+
+
+canonical_eat = load_entry("trusted_canonical_159", Path("/reference/canonical.py"))
+generated_eat = load_entry(
+    "scratch_generated_159", Path("/tmp/audit-work/159-eat/solution.py")
+)
+
+examples = [
+    (5, 6, 10),
+    (4, 8, 9),
+    (1, 10, 10),
+    (2, 11, 5),
+]
+
+# Includes all-zero, each coordinate boundary, and all eight 0/1000 corners.
+boundary_values = (0, 1, 999, 1000)
+boundaries = [
+    (number, need, remaining)
+    for number in boundary_values
+    for need in boundary_values
+    for remaining in boundary_values
+]
+
+# Exercise the exact branch edge need == remaining and its neighbors where valid.
+branch_edges = []
+for number in boundary_values:
+    for remaining in range(0, 1001):
+        for need in (remaining - 1, remaining, remaining + 1):
+            if 0 <= need <= 1000:
+                branch_edges.append((number, need, remaining))
+
+# Exhaustive small cube covers every combination in [0, 20]^3.
+small_exhaustive = [
+    (number, need, remaining)
+    for number in range(21)
+    for need in range(21)
+    for remaining in range(21)
+]
+
+generator = random.Random(159_20260729)
+generated = [
+    (
+        generator.randint(0, 1000),
+        generator.randint(0, 1000),
+        generator.randint(0, 1000),
+    )
+    for _ in range(20_000)
+]
+
+cases = examples + boundaries + branch_edges + small_exhaustive + generated
+serialized = json.dumps(cases, separators=(",", ":")).encode()
+Path("/audit-output/evidence/differential-inputs.json").write_bytes(serialized)
+
+mismatches = []
+shape_failures = []
+formula_failures = []
+branch_counts = {"need<=remaining": 0, "need>remaining": 0}
+for args in cases:
+    expected = canonical_eat(*args)
+    actual = generated_eat(*args)
+    if args[1] <= args[2]:
+        branch_counts["need<=remaining"] += 1
+        formula = [args[0] + args[1], args[2] - args[1]]
+    else:
+        branch_counts["need>remaining"] += 1
+        formula = [args[0] + args[2], 0]
+    if actual != expected:
+        mismatches.append((args, actual, expected))
+    if type(actual) is not list or len(actual) != 2:
+        shape_failures.append((args, type(actual).__name__, actual))
+    if actual != formula or expected != formula:
+        formula_failures.append((args, actual, expected, formula))
+
+print("contract_domain=integer triples with each coordinate in [0,1000]")
+print(f"examples={len(examples)}")
+print(f"boundaries={len(boundaries)}")
+print(f"branch_edges={len(branch_edges)}")
+print(f"small_exhaustive={len(small_exhaustive)}")
+print("random_seed=15920260729")
+print(f"generated={len(generated)}")
+print(f"total_cases={len(cases)}")
+print(f"branch_counts={branch_counts}")
+print(f"inputs_sha256={hashlib.sha256(serialized).hexdigest()}")
+print(f"mismatches={len(mismatches)}")
+print(f"shape_failures={len(shape_failures)}")
+print(f"formula_failures={len(formula_failures)}")
+if mismatches or shape_failures or formula_failures:
+    print(f"first_mismatch={mismatches[:1]}")
+    print(f"first_shape_failure={shape_failures[:1]}")
+    print(f"first_formula_failure={formula_failures[:1]}")
+    raise SystemExit(1)
