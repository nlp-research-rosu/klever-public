+echo "constructor_pinning_exit=${pinning_status}"
+
+cp /audit-output/evidence/04-body-mutation.k audit-body-mutation.k
+copy_status=$?
+echo "body_mutation_copy_exit=${copy_status}"
+
+kprove audit-body-mutation.k \
+  --definition fresh-verification-kompiled \
+  --spec-module AUDIT-BODY-MUTATION
+body_mutation_status=$?
+echo "body_mutation_kprove_exit=${body_mutation_status}"
+
+if (( pinning_status != 0 || copy_status != 0 )); then
+  exit 1
+fi
+
+# The mutation must parse/build and reach a stuck result obligation.
+if (( body_mutation_status == 0 )); then
+  exit 1
+fi
+
+exit 0
diff --git a/evidence/06-nonvacuity.k b/evidence/06-nonvacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..b8c6a97f8784ab71cfb99e653216c82883b6da90
--- /dev/null
+++ b/evidence/06-nonvacuity.k
@@ -0,0 +1,62 @@
+requires "verification.k"
+
+module AUDIT-NONVACUITY
+  imports VERIFICATION
+
+  // Deliberately false on the satisfiable enough-stock branch. The real first
+  // element is NUMBER + NEED, while this destination demands one more.
+  claim [false-off-by-one-result]:
+    <k>
+      Call(Name("eat"), Int(NUMBER:Int), Int(NEED:Int), Int(REMAINING:Int))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "eat" |-> closureVal(
+          "number", "need", "remaining", .ParamNames,
+          If(
+            Compare(Name("need"), CmpOp("<=", Name("remaining"))),
+            Return(
+              ListExpr(
+                BinOp("+", Name("number"), Name("need")),
+                BinOp("-", Name("remaining"), Name("need"))
+              )
+            ),
+            .Stmts
+          )
+          Return(
+            ListExpr(
+              BinOp("+", Name("number"), Name("remaining")),
+              Int(0)
+            )
+          ),
+          0
+        ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(
+          NUMBER +Int NEED +Int 1,
+          vCons(REMAINING -Int NEED, .ValSeq)
+        )
+      )
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      0 <=Int NUMBER andBool NUMBER <=Int 1000
+      andBool 0 <=Int NEED andBool NEED <=Int 1000
+      andBool 0 <=Int REMAINING andBool REMAINING <=Int 1000
+      andBool NEED <=Int REMAINING
+endmodule
