+#include <stdio.h>
+#include <stddef.h>
+
+int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+  char path[4096];
+  size_t size = sizeof(path);
+  int code = uv_exepath(path, &size);
+  printf("uv_exepath code=%d size=%zu path=%.*s\n", code, size, (int)size, path);
+  return code != 0;
+}

