+        int numeric = cursor < end;
+        while (cursor < end) {
+            if (*cursor < '0' || *cursor > '9') {
+                numeric = 0;
+                break;
+            }
+            ++cursor;
+        }
+        if (numeric) {
+            path = "/proc/self/exe";
+        }
+    }
+    return real_readlink(path, buffer, size);
+}
