+import Proof
+
+namespace Counterfactual
+
+def fakeSub (_x _y : SortInt) : SortInt := 1
+def fakeAdd (x _y : SortInt) : SortInt := x
+def fakeMul (x y : SortInt) : SortInt := x + y - 1
+
+theorem fakeStillProvesTarget :
+    Klean131Digits.Lemmas.targetStatement fakeSub fakeAdd fakeMul := by
+  unfold Klean131Digits.Lemmas.targetStatement
+  refine ⟨?_, ?_, ?_, ?_⟩
+  · intro X
+    simp only [fakeMul]
+    simpa [Int.add_comm] using Int.add_sub_cancel X 1
+  · intro X
+    simp only [fakeMul]
+    exact Int.add_sub_cancel X 1
+  · intro X
+    rfl
+  · intro Z Y X
+    simp only [fakeMul, Int.sub_eq_add_neg]
+    ac_rfl
+
+example : fakeSub 5 8 ≠ Proof.«_-Int_» 5 8 := by decide
+example : fakeAdd (-7) 4 ≠ Proof.«_+Int_» (-7) 4 := by decide
+example : fakeMul (-7) 4 ≠ Proof.«_*Int_» (-7) 4 := by decide
+
+#check fakeStillProvesTarget
+#print axioms fakeStillProvesTarget
+#eval fakeSub 5 8
+#eval fakeAdd (-7) 4
+#eval fakeMul (-7) 4
+
+end Counterfactual

