+import Proof
+
+namespace Counterfactual
+
+def fakeSub (_x _y : SortInt) : SortInt := 1
+def fakeAdd (x _y : SortInt) : SortInt := x
+def fakeMul (x y : SortInt) : SortInt := x + y - 1
+
