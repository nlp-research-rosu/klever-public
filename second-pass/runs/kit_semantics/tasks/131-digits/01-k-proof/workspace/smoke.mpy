Module(
  FuncDef("digits", Params("n"),
    Assign(Name("product"), Int(1))
    Assign(Name("found"), Int(0))
    While(Compare(Name("n"), CmpOp(">", Int(0))),
      If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
        Assign(
          Name("product"),
          BinOp("*", Name("product"), BinOp("%", Name("n"), Int(10))))
        Assign(Name("found"), Int(1)),
        )
      Assign(Name("n"), BinOp("//", Name("n"), Int(10))))
    Return(BinOp("*", Name("product"), Name("found"))))
  Assign(Name("result_1"), Call(Name("digits"), Int(1)))
  Assign(Name("result_4"), Call(Name("digits"), Int(4)))
  Assign(Name("result_235"), Call(Name("digits"), Int(235)))
  Assign(Name("result_2468"), Call(Name("digits"), Int(2468)))
  Assign(Name("result_97531"), Call(Name("digits"), Int(97531)))
  Assert(Compare(Name("result_1"), CmpOp("==", Int(1))))
  Assert(Compare(Name("result_4"), CmpOp("==", Int(0))))
  Assert(Compare(Name("result_235"), CmpOp("==", Int(15))))
  Assert(Compare(Name("result_2468"), CmpOp("==", Int(0))))
  Assert(Compare(Name("result_97531"), CmpOp("==", Int(945)))))
