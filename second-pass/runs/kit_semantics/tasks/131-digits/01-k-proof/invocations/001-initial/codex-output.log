+            Assign(Name("product"), Int(1))
+            Assign(Name("found"), Int(0))
+            While(Compare(Name("n"), CmpOp(">", Int(0))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Int(2)),
+                  CmpOp("==", Int(1))),
+                Assign(
+                  Name("product"),
+                  BinOp(
+                    "*",
+                    Name("product"),
+                    BinOp("%", Name("n"), Int(10))))
+                Assign(Name("found"), Int(0)),
+                .Stmts)
+              Assign(
+                Name("n"),
+                BinOp("//", Name("n"), Int(10)))
+              .Stmts)
+            Return(
+              BinOp("*", Name("product"), Name("found")))
+            .Stmts)
