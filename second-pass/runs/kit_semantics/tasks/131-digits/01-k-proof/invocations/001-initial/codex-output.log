+  FuncDef("digits", Params("n"),
+    Assign(Name("product"), Int(1))
+    Assign(Name("found"), Int(0))
+    Assign(Name("digit"), Int(0))
+    While(Compare(Name("n"), CmpOp(">", Int(0))),
+      Assign(Name("digit"), BinOp("%", Name("n"), Int(10)))
+      If(Compare(BinOp("%", Name("digit"), Int(2)), CmpOp("==", Int(1))),
+        Assign(
+          Name("product"),
+          BinOp("*", Name("product"), Name("digit")))
+        Assign(Name("found"), Int(1)),
+        )
+      Assign(Name("n"), BinOp("//", Name("n"), Int(10))))
+    Return(BinOp("*", Name("product"), Name("found")))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1367683fb3f58c072e54c8d815b6eaa2f99aac1f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def digits(n):
+    product = 1
+    found = 0
+    digit = 0
+    while n > 0:
+        digit = n % 10
+        if digit % 2 == 1:
+            product = product * digit
+            found = 1
+        n = n // 10
+    return product * found
