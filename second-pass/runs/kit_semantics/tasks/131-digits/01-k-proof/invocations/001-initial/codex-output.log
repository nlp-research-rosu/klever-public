--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,27 @@
+from solution import digits
+
+
+def oracle(n):
+    product = 1
+    found = False
+    for character in str(n):
+        digit = int(character)
+        if digit % 2 == 1:
+            product *= digit
+            found = True
+    return product if found else 0
+
+
+def main():
+    inputs = list(range(1, 10001)) + [111111, 246802468, 975319753]
+    mismatches = [
+        (n, digits(n), oracle(n))
+        for n in inputs
+        if digits(n) != oracle(n)
+    ]
+    assert not mismatches, mismatches[:10]
+    print(f"checked={len(inputs)} mismatches=0")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test_summary.py b/test_summary.py
new file mode 100644
index 0000000000000000000000000000000000000000..b983b747bca26310fab3fcbee2f0f93ab7a97662
--- /dev/null
+++ b/test_summary.py
@@ -0,0 +1,46 @@
+def odd_digits_product(n):
+    if n <= 0:
+        return 1
+    quotient = (n - (n % 10)) // 10
+    if n % 2 == 1:
+        return (n % 10) * odd_digits_product(quotient)
+    return odd_digits_product(quotient)
+
+
+def odd_digit_seen(n):
+    if n <= 0:
+        return 0
+    quotient = (n - (n % 10)) // 10
+    if n % 2 == 1:
+        return 1
+    return odd_digit_seen(quotient)
+
+
+def proof_summary(n):
+    return odd_digits_product(n) * odd_digit_seen(n)
+
+
+def oracle(n):
+    odd_digits = [int(character) for character in str(n)
+                  if int(character) % 2 == 1]
+    if not odd_digits:
+        return 0
+    result = 1
+    for digit in odd_digits:
+        result *= digit
+    return result
+
+
+def main():
+    inputs = list(range(1, 10001)) + [111111, 246802468, 975319753]
+    mismatches = [
+        (n, proof_summary(n), oracle(n))
+        for n in inputs
+        if proof_summary(n) != oracle(n)
+    ]
+    assert not mismatches, mismatches[:10]
+    print(f"checked={len(inputs)} mismatches=0")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4fd8baa1271dc3716c7bff2407a96d93c7392d5a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,47 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+
+  // Empty product is 1.  The entry claim multiplies this by oddDigitSeen,
+  // which changes the all-even result to the contract's required 0.
+  syntax Int ::= oddDigitsProduct(Int) [function, total]
+  syntax Int ::= oddDigitSeen(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Definitional summaries.  Their positive cases follow exactly one decimal
+  // digit-removal step from MPY-INT's Python // and % rules.
+  rule oddDigitsProduct(N) => 1
+    requires N <=Int 0
+  rule oddDigitsProduct(N)
+    => pyMod(N, 10) *Int
+       oddDigitsProduct((N -Int pyMod(N, 10)) /Int 10)
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 1
+  rule oddDigitsProduct(N)
+    => oddDigitsProduct((N -Int pyMod(N, 10)) /Int 10)
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 0
+
+  rule oddDigitSeen(N) => 0
+    requires N <=Int 0
+  rule oddDigitSeen(N) => 1
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 1
+  rule oddDigitSeen(N)
+    => oddDigitSeen((N -Int pyMod(N, 10)) /Int 10)
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 0
+
+  // Derived integer identities used only to normalize the inductive
+  // post-state after the circularity has executed the remaining loop.
+  rule 1 *Int X => X [simplification]
+  rule X *Int 1 => X [simplification]
+  rule X +Int 1 -Int X => 1 [simplification]
+  rule (X *Int Y) *Int Z => X *Int (Y *Int Z) [simplification]
+endmodule

