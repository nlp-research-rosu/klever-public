@@ -0,0 +1,11 @@
+def digits(n):
+    product = 1
+    found = 0
+    digit = 0
+    while n > 0:
+        digit = n % 10
+        if digit % 2 == 1:
+            product = product * digit
+            found = 1
+        n = n // 10
+    return product * found
