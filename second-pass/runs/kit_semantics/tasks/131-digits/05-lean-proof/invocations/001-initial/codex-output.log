new file mode 100644
index 0000000000000000000000000000000000000000..22e2e445e948a24de4a85dbea88744a73e7ee1cd
--- /dev/null
+++ b//tmp/lean-path-shim.c
@@ -0,0 +1,20 @@
+#include <lean/lean.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+lean_obj_res lean_init_search_path(uint8_t world) {
+  (void)world;
+  return lean_io_result_mk_ok(lean_box(0));
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  const char *resolved = path;
+  size_t len = strlen(path);
+  if (strncmp(path, "/proc/", 6) == 0 &&
+      len >= 4 && strcmp(path + len - 4, "/exe") == 0) {
+    resolved = "/proc/self/exe";
+  }
+  return syscall(SYS_readlinkat, AT_FDCWD, resolved, buf, size);
+}
