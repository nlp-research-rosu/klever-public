assert len(output['rules']) == len(inventory['rules'])
expected_ids = [rule['source_rule_id'] for rule in inventory['rules']]
actual_ids = [rule['source_rule_id'] for rule in output['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for canonical, classified in zip(inventory['rules'], output['rules']):
    assert set(classified) == {'source_rule_id', 'classification', 'rationale'}
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if 'simplification' in canonical.get('attributes', []):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print('rules=', len(actual_ids), sep='')
print('inventory_order_match=true')
print('inventory_sha256_match=true')
print('classification_counts=', dict(Counter(rule['classification'] for rule in output['rules'])), sep='')
