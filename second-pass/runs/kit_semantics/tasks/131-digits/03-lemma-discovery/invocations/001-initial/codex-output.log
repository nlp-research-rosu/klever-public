+    },
+    {
+      "source_rule_id": "rule-b09bdfe5e2bc74b215bed27c498fc03e78a4929071d23d07a626110c519fed02",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This simplification rule adds an integer cancellation identity used to normalize the presence bit; Stage 1 supplies no separate prior proof of the exact rule."
+    },
+    {
+      "source_rule_id": "rule-6c033d38e2e8c948160d245d94624fb6c578d69ea99fc1c15c896b557eaa1ee3",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This simplification rule adds integer multiplication associativity in a chosen normalization direction; Stage 1 supplies no separate prior proof of the exact rule."
+    }
+  ]
