     1	def odd_digits_product(n):
     2	    if n <= 0:
     3	        return 1
     4	    quotient = (n - (n % 10)) // 10
     5	    if n % 2 == 1:
     6	        return (n % 10) * odd_digits_product(quotient)
     7	    return odd_digits_product(quotient)
     8	
     9	
    10	def odd_digit_seen(n):
    11	    if n <= 0:
    12	        return 0
    13	    quotient = (n - (n % 10)) // 10
    14	    if n % 2 == 1:
    15	        return 1
    16	    return odd_digit_seen(quotient)
    17	
    18	
    19	def proof_summary(n):
