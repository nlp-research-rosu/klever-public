+echo "EXIT_STATUS=$diff_status"
+
+test "$inputs_status" -eq 0 \
+  && test "$translate_status" -eq 0 \
+  && test "$cmp_status" -eq 0 \
+  && test "$hash_status" -eq 0 \
+  && test "$diff_status" -eq 0
