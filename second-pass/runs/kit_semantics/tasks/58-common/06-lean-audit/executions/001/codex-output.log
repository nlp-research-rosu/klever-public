+
+The sandbox returned inner PID 3 from getpid(), but /proc exposed outer PID
+1259. Lean 4.22 resolves its prefix with /proc/<getpid>/exe, so the mismatch
+caused the pre-project failure. The narrowly scoped shim in
+00-lean-proc-pid-shim.c returns the outer Pid field only.
+
+$ gcc -shared -fPIC -O2 /tmp/audit-work/lean-proc-pid-shim.c -o /tmp/audit-work/lean-proc-pid-shim.so
+$ LD_PRELOAD=/tmp/audit-work/lean-proc-pid-shim.so lean --version
+Lean (version 4.22.0, x86_64-unknown-linux-gnu, commit ba2cbbf09d4978f416e0ebd1fceeebc2c4138c05, Release)
+
+$ kompile --version
+K version:    v7.1.293
+Build date:   Fri Oct 03 13:32:35 CDT 2025
+
+$ kprove --version
+K version:    v7.1.293
+Build date:   Fri Oct 03 13:32:35 CDT 2025
diff --git a/evidence/00-lean-proc-pid-shim.c b/evidence/00-lean-proc-pid-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..5c5db0c55b3a3637d3fda5560e0d27659cac0afd
--- /dev/null
+++ b/evidence/00-lean-proc-pid-shim.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  char buffer[4096];
+  int fd = (int)syscall(SYS_openat, AT_FDCWD, "/proc/self/status",
+                        O_RDONLY | O_CLOEXEC, 0);
+  if (fd >= 0) {
+    ssize_t count = (ssize_t)syscall(SYS_read, fd, buffer,
+                                     sizeof(buffer) - 1);
+    syscall(SYS_close, fd);
+    if (count > 0) {
+      buffer[count] = '\0';
+      const char *prefix = "Pid:";
+      for (ssize_t index = 0; index + 4 < count; ++index) {
+        if ((index == 0 || buffer[index - 1] == '\n') &&
+            buffer[index] == prefix[0] &&
+            buffer[index + 1] == prefix[1] &&
+            buffer[index + 2] == prefix[2] &&
+            buffer[index + 3] == prefix[3]) {
+          return (pid_t)strtol(buffer + index + 4, NULL, 10);
+        }
+      }
+    }
+  }
+  return (pid_t)syscall(SYS_getpid);
+}
