+  size_t size = sizeof(path);
+  int rc = uv_exepath(path, &size);
+  printf("rc=%d name=%s size=%zu path=%s\n",
+         rc, uv_err_name(rc), size, rc == 0 ? path : "");
+  return rc == 0 ? 0 : 1;
+}
