+  rule B:Bool xorBool false => B:Bool [simplification]
+  rule B:Bool xorBool B:Bool => false
+
+  rule true orBool _:Bool => true
+  rule _:Bool orBool true => true [simplification]
+  rule false orBool B:Bool => B
