+#include <stdio.h>
+#include <uv.h>
+
+int main(void) {
+  char path[4096];
+  size_t size = sizeof(path);
+  int rc = uv_exepath(path, &size);
+  printf("rc=%d name=%s size=%zu path=%s\n",
+         rc, uv_err_name(rc), size, rc == 0 ? path : "");
+  return rc == 0 ? 0 : 1;
+}
diff --git a/evidence/00-environment.txt b/evidence/00-environment.txt
