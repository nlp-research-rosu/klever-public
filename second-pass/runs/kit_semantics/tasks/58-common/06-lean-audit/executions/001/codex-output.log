diff --git a/evidence/07-print-candidate-output.txt b/evidence/07-print-candidate-output.txt
new file mode 100644
index 0000000000000000000000000000000000000000..66735a6d5d3b972d600e49941e8212f74b44afde
--- /dev/null
+++ b/evidence/07-print-candidate-output.txt
@@ -0,0 +1,48 @@
+$ LD_PRELOAD=/tmp/audit-work/lean-proc-pid-shim.so lake env lean /audit-output/evidence/07-print-candidate-declarations.lean
+def Proof._orBool_ : SortBool → SortBool → SortBool :=
+fun left right => left || right
+def Proof.«_==K_» : SortK → SortK → SortBool :=
+fun left right => decide (left = right)
+def Proof.notBool_ : SortBool → SortBool :=
+fun value => !value
+theorem Proof.final : Klean58Common.Lemmas.targetStatement Proof._orBool_ Proof.«_==K_» Proof.notBool_ :=
+of_eq_true
+  (Eq.trans
+    (forall_congr fun B =>
+      Eq.trans
+        (forall_congr fun V =>
+          Eq.trans
+            (forall_congr fun E =>
+              Eq.trans
+                (implies_congr_ctx
+                  (Eq.trans Bool.not_eq_eq_eq_not._simp_1
+                    (Eq.trans
+                      (Eq.trans
+                        (congrArg (Eq (decide (SortK.kseq (inj E) SortK.dotk = SortK.kseq (inj V) SortK.dotk)))
+                          Bool.not_true)
+                        decide_eq_false_iff_not._simp_1)
+                      (congrArg Not
+                        (Eq.trans (SortK.kseq.injEq (inj E) SortK.dotk (inj V) SortK.dotk)
+                          (Eq.trans (congrArg (And (inj E = inj V)) (eq_self SortK.dotk))
+                            (and_true (inj E = inj V)))))))
+                  fun h =>
+                  Eq.trans
+                    (congrArg (fun x => x = B)
+                      (Eq.trans
+                        (congrArg (fun x => x || B)
+                          (Eq.trans
+                            ((fun p p_1 e_p =>
+                                @Eq.rec Prop p
+                                  (fun p_2 e_p => ∀ {h : Decidable p} [h_1 : Decidable p_2], decide p = decide p_2)
+                                  (fun {h} [h_1 : Decidable p] => Subsingleton.elim h h_1 ▸ Eq.refl (decide p)) p_1 e_p)
+                              (SortK.kseq (inj E) SortK.dotk = SortK.kseq (inj V) SortK.dotk) False
+                              (Eq.trans (SortK.kseq.injEq (inj E) SortK.dotk (inj V) SortK.dotk)
+                                (Eq.trans (congr (congrArg And (eq_false h)) (eq_self SortK.dotk)) (and_true False))))
+                            (decide_false instDecidableFalse)))
+                        (Bool.false_or B)))
+                    (eq_self B))
