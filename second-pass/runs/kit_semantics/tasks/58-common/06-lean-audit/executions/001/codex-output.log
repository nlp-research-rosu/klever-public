+import hashlib
+import json
+import re
+from pathlib import Path
+
+from tools import (
+    klean_export,
+    pipeline_contract,
+    stage6_resolution_contract,
+)
+
+
+def file_hash(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
