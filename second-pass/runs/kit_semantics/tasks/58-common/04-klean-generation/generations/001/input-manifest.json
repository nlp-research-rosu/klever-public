      "module": "VERIFICATION",
      "normalized_sha256": "b851270341fa427d7c6b86536424da72948b62f5f47bf7a5debfcf72c73e19af",
      "rationale": "This is the empty-sequence base equation defining the total commonMember summary.",
      "source_rule_id": "rule-b851270341fa427d7c6b86536424da72948b62f5f47bf7a5debfcf72c73e19af",
      "start_line": 8,
      "text": "  rule commonMember(_:Val, .ValSeq) => false"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "2bbf2fca970e20e1ac591ef3fdfe348b299c5160141f4fefbc8f4d1e683815b0",
      "rationale": "This is the cons-case recurrence defining commonMember by head equality and recursive membership of the strict tail.",
      "source_rule_id": "rule-2bbf2fca970e20e1ac591ef3fdfe348b299c5160141f4fefbc8f4d1e683815b0",
      "start_line": 9,
      "text": "  rule commonMember(V:Val, vCons(E:Val, R:ValSeq))\n    => (E ==K V) orBool commonMember(V, R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 20,
      "module": "VERIFICATION",
      "normalized_sha256": "10e71d2ccb6e618e545b5c344fbd49a07fb245480c0dc10b2f8ce274d73e655c",
      "rationale": "This is the empty-input base equation defining the total commonAcc accumulator summary.",
      "source_rule_id": "rule-10e71d2ccb6e618e545b5c344fbd49a07fb245480c0dc10b2f8ce274d73e655c",
      "start_line": 20,
      "text": "  rule commonAcc(.ValSeq, _:ValSeq, ACC:ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "b1d407f48ea5db85651bab85e4931a62e916cc0c29c463d62deb4e093d66c5cf",
      "rationale": "This is the cons-case recurrence defining commonAcc by a membership-based accumulator update followed by recursion on the strict tail.",
      "source_rule_id": "rule-b1d407f48ea5db85651bab85e4931a62e916cc0c29c463d62deb4e093d66c5cf",
      "start_line": 21,
      "text": "  rule commonAcc(vCons(V:Val, R:ValSeq), B:ValSeq, ACC:ValSeq)\n    => commonAcc(\n         R,\n         B,\n         #if commonMember(V, B) andBool notBool commonMember(V, ACC)\n         #then valSeqConcat(ACC, vCons(V, .ValSeq))\n         #else ACC\n         #fi)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 41,
      "module": "VERIFICATION",
      "normalized_sha256": "24fa2be80e9ed0bfffd6b7a91d6b534370f30c8d0074bdfc6680eda1e7b5f16c",
      "rationale": "This macro expansion defines the named commonLoopBody proof term as the exact translated conditional loop body.",
      "source_rule_id": "rule-24fa2be80e9ed0bfffd6b7a91d6b534370f30c8d0074bdfc6680eda1e7b5f16c",
      "start_line": 32,
      "text": "  rule commonLoopBody()\n    => If(\n         BoolOp(\n           \"and\",\n           Compare(Name(\"item\"), CmpOp(\"in\", Name(\"l2\"))),\n           Compare(Name(\"item\"), CmpOp(\"not in\", Name(\"result\")))\n         ),\n         Expr(Call(Attribute(Name(\"result\"), \"append\"), Name(\"item\"))),\n         .Stmts\n       )"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 48,
      "module": "VERIFICATION",
      "normalized_sha256": "345d1c0eced89af20c67c30dcca439dc5c455af03b30199f56c132eeb1dc141f",
      "rationale": "This macro expansion defines the named commonBody proof term as the exact translated function body.",
      "source_rule_id": "rule-345d1c0eced89af20c67c30dcca439dc5c455af03b30199f56c132eeb1dc141f",
      "start_line": 44,
      "text": "  rule commonBody()\n    => Assign(Name(\"result\"), ListExpr(.Exprs))\n       Assign(Name(\"item\"), Int(0))\n       For(Name(\"item\"), Name(\"l1\"), commonLoopBody())\n       Return(Call(Name(\"sorted\"), Name(\"result\")))"
    }
  ],
