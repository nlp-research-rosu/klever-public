+  claim [common-loop]:
+    <k>
+      #loop(list(A:ValSeq), Name("item"), commonLoopBody())
+      ~> Return(Call(Name("sorted"), Name("result")))
+      ~> #endcall
+    =>
+      Return(Call(Name("sorted"), Name("result")))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(.Map, parent(-1))
+       1 |-> scope(
+         "l1"     |-> list(ORIG:ValSeq)
+         "l2"     |-> list(B:ValSeq)
+         "result" |-> ref(0)
+         "item"   |-> (ITEM:Val => ?FINALITEM:Val),
