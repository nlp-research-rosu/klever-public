diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..e20e4771e67ca753084638ad4c3d05529437a5aa
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def common(l1: list, l2: list):
+    result = []
+    item = 0
+    for item in l1:
+        if item in l2 and item not in result:
+            result.append(item)
+    return sorted(result)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8acc14d3b29419db5f1aa4494d00eb6972f2323a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact execution theorem for the fixed list-membership fold.
+  claim [member-fold]:
+    <k> #memberAcc(V:Val, list(S:ValSeq))
+      => commonMember(V, S) ... </k>
+
+  // Loop invariant: A is the unprocessed suffix and ACC is the result so far.
+  claim [common-loop]:
+    <k>
+      #loop(list(A:ValSeq), Name("item"), commonLoopBody())
+      ~> Return(Call(Name("sorted"), Name("result")))
+      ~> #endcall
+    =>
+      Return(Call(Name("sorted"), Name("result")))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(.Map, parent(-1))
+       1 |-> scope(
+         "l1"     |-> list(ORIG:ValSeq)
+         "l2"     |-> list(B:ValSeq)
+         "result" |-> ref(0)
+         "item"   |-> (ITEM:Val => ?FINALITEM:Val),
+         parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> 0 |-> list(ACC:ValSeq => commonAcc(A, B, ACC)) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Whole program, including loading and executing the exact function body.
+  claim [common-program]:
+    <k>
+      #loadAll(Module(
+        FuncDef("common", Params("l1", "l2"), commonBody())
+      ))
+      ~> Call(Name("common"), list(A:ValSeq), list(B:ValSeq))
+    =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope(
+        "common" |-> closureVal(
+          ("l1", "l2", .ParamNames),
+          commonBody(),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(commonAcc(A, B, .ValSeq))
+      1 |-> list(sortVS(commonAcc(A, B, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..292c842163a7c75f8a5b57927db5dc0b3fb6b70e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,41 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical membership for the fixed semantics' flat ValSeq equality.
+  syntax Bool ::= commonMember(Val, ValSeq) [function, total]
+  rule commonMember(_:Val, .ValSeq) => false
+  rule commonMember(V:Val, vCons(E:Val, R:ValSeq))
+    => (E ==K V) orBool commonMember(V, R)
+
+  // The encounter-order, duplicate-free intersection accumulated by the loop.
+  syntax ValSeq ::= commonAcc(ValSeq, ValSeq, ValSeq) [function, total]
+  rule commonAcc(.ValSeq, _:ValSeq, ACC:ValSeq) => ACC
+  rule commonAcc(vCons(V:Val, R:ValSeq), B:ValSeq, ACC:ValSeq)
+    => commonAcc(R, B, valSeqConcat(ACC, vCons(V, .ValSeq)))
+    requires commonMember(V, B) andBool notBool commonMember(V, ACC)
+  rule commonAcc(vCons(V:Val, R:ValSeq), B:ValSeq, ACC:ValSeq)
+    => commonAcc(R, B, ACC)
+    requires notBool (commonMember(V, B) andBool notBool commonMember(V, ACC))
+
+  // Syntactic abbreviations for the exact translated program fragments.
+  syntax Stmts ::= "commonLoopBody" "(" ")" [macro]
+  rule commonLoopBody()
+    => If(
+         BoolOp(
+           "and",
+           Compare(Name("item"), CmpOp("in", Name("l2"))),
+           Compare(Name("item"), CmpOp("not in", Name("result")))
+         ),
+         Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
+         .Stmts
+       )
+
+  syntax Stmts ::= "commonBody" "(" ")" [macro]
+  rule commonBody()
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("item"), Int(0))
+       For(Name("item"), Name("l1"), commonLoopBody())
+       Return(Call(Name("sorted"), Name("result")))
+endmodule

