@@ -0,0 +1,7 @@
+def common(l1: list, l2: list):
+    result = []
+    item = 0
+    for item in l1:
+        if item in l2 and item not in result:
+            result.append(item)
+    return sorted(result)
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..89c33828448b57ce3f0ecfe61d48e43a7944b3bb
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: it omits `item not in result`, so [1, 1]
+  // intersected with [1] returns [1, 1], not the original theorem's [1].
+  claim [duplicate-mutant]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "common",
+          Params("l1", "l2"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("item"), Int(0))
+          For(
+            Name("item"),
+            Name("l1"),
+            If(
+              Compare(Name("item"), CmpOp("in", Name("l2"))),
+              Expr(Call(
+                Attribute(Name("result"), "append"),
+                Name("item"))),
+              .Stmts))
+          Return(Call(Name("sorted"), Name("result"))))
+      ))
+      ~> Call(
+           Name("common"),
+           list(vCons(1, vCons(1, .ValSeq))),
+           list(vCons(1, .ValSeq)))
+    =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope(
+        "common" |-> closureVal(
+          ("l1", "l2", .ParamNames),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("item"), Int(0))
+          For(
+            Name("item"),
+            Name("l1"),
+            If(
+              Compare(Name("item"), CmpOp("in", Name("l2"))),
+              Expr(Call(
+                Attribute(Name("result"), "append"),
+                Name("item"))),
+              .Stmts))
+          Return(Call(Name("sorted"), Name("result"))),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(sortVS(vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
