diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6aecc0b314cb0f1feaacf2fa53ca8abbf3382124
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact execution theorem for the fixed list-membership fold.
+  claim [member-fold]:
+    <k> #memberAcc(V:Val, list(S:ValSeq))
+      => commonMember(V, S) ... </k>
+
+  // Loop invariant: A is the unprocessed suffix and ACC is the result so far.
+  claim [common-loop]:
+    <k>
+      #loop(list(A:ValSeq), Name("item"), commonLoopBody())
+      ~> (Return(Call(Name("sorted"), Name("result"))) .Stmts)
+      ~> #endcall
+    =>
+      (Return(Call(Name("sorted"), Name("result"))) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(GLOBALS:Map, parent(-1))
+       1 |-> scope(
+         "l1"     |-> list(ORIG:ValSeq)
+         "l2"     |-> list(B:ValSeq)
+         "result" |-> ref(0)
+         "item"   |-> (ITEM:Val => ?FINALITEM:Val),
+         parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> 0 |-> list(ACC:ValSeq => commonAcc(A, B, ACC)) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Whole program, including loading and executing the exact function body.
+  claim [common-program]:
+    <k>
+      #loadAll(Module(
+        FuncDef("common", Params("l1", "l2"), commonBody())
+      ))
+      ~> Call(Name("common"), list(A:ValSeq), list(B:ValSeq))
+    =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope(
+        "common" |-> closureVal(
+          ("l1", "l2", .ParamNames),
+          commonBody(),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(commonAcc(A, B, .ValSeq))
+      1 |-> list(sortVS(commonAcc(A, B, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..d7104716d445ae71e6d92b28139e9d58c2462dc8
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,28 @@
+from itertools import product
+
+from solution import common
+
+
+def oracle(left, right):
+    return sorted(set(left).intersection(set(right)))
+
+
+values = (-1, 0, 1)
+lists = [list(items) for size in range(4) for items in product(values, repeat=size)]
+mismatches = []
+
+for left in lists:
+    for right in lists:
+        actual = common(left, right)
+        expected = oracle(left, right)
+        if actual != expected:
+            mismatches.append((left, right, actual, expected))
+
+print(
+    "CPython differential:",
+    f"{len(lists) * len(lists)} pairs,",
+    f"{len(mismatches)} mismatches",
+)
+
+if mismatches:
+    raise AssertionError(mismatches[:5])
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..47ff61f111ea5220580fccb60936e4649cd7ecac
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,49 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical membership for the fixed semantics' flat ValSeq equality.
+  syntax Bool ::= commonMember(Val, ValSeq) [function, total]
+  rule commonMember(_:Val, .ValSeq) => false
+  rule commonMember(V:Val, vCons(E:Val, R:ValSeq))
+    => (E ==K V) orBool commonMember(V, R)
+
+  // Boolean normalization needed by the Haskell backend on the unequal path
+  // produced by the fixed semantics' list-membership rule.
+  rule ((E:Val ==K V:Val) orBool B:Bool) => B
+    requires notBool (E ==K V)
+    [simplification]
+
+  // The encounter-order, duplicate-free intersection accumulated by the loop.
+  syntax ValSeq ::= commonAcc(ValSeq, ValSeq, ValSeq) [function, total]
+  rule commonAcc(.ValSeq, _:ValSeq, ACC:ValSeq) => ACC
+  rule commonAcc(vCons(V:Val, R:ValSeq), B:ValSeq, ACC:ValSeq)
+    => commonAcc(
+         R,
+         B,
+         #if commonMember(V, B) andBool notBool commonMember(V, ACC)
+         #then valSeqConcat(ACC, vCons(V, .ValSeq))
+         #else ACC
+         #fi)
+
+  // Syntactic abbreviations for the exact translated program fragments.
+  syntax Stmts ::= "commonLoopBody" "(" ")" [macro]
+  rule commonLoopBody()
+    => If(
+         BoolOp(
+           "and",
+           Compare(Name("item"), CmpOp("in", Name("l2"))),
+           Compare(Name("item"), CmpOp("not in", Name("result")))
+         ),
+         Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
+         .Stmts
+       )
+
+  syntax Stmts ::= "commonBody" "(" ")" [macro]
+  rule commonBody()
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("item"), Int(0))
+       For(Name("item"), Name("l1"), commonLoopBody())
+       Return(Call(Name("sorted"), Name("result")))
+endmodule

diff --git a/concrete-smoke.py b/concrete-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..099ae17c19e189a46bf67db992de0fb898b90a04
--- /dev/null
+++ b/concrete-smoke.py
@@ -0,0 +1,15 @@
+def common(l1: list, l2: list):
+    result = []
+    item = 0
+    for item in l1:
+        if item in l2 and item not in result:
+            result.append(item)
+    return sorted(result)
+
+
+assert common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121]) == [1, 5, 653]
+assert common([5, 3, 2, 8], [3, 2]) == [2, 3]
+assert common([2, 2, 1, 1], [1, 2, 2]) == [1, 2]
+assert common([], [1]) == []
+assert common([3, -1, 0, 3], [0, -1, -1]) == [-1, 0]
+assert common([9], []) == []
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..075261e7d0407078fbbe9cf1da0e43671ff4b3db
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+python3 py2mpy.py concrete-smoke.py > concrete-smoke.mpy
+krun concrete-smoke.mpy --definition runtime-kompiled
+python3 validate.py
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+if kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY
+then
+  echo "ERROR: false-result mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-result mutation"
+fi
+
+if kprove spec-value-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VALUE-MUTATION
+then
+  echo "ERROR: false-summary-value mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-summary-value mutation"
+fi
+
+if kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION
+then
+  echo "ERROR: duplicate-body mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: duplicate-body mutation"
+fi
