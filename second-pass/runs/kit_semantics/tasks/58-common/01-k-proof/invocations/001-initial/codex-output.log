+    =>
+      0 |-> list(commonAcc(A, B, .ValSeq))
+      1 |-> list(sortVS(commonAcc(A, B, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
