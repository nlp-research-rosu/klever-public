+    =>
+      0 |-> list(.ValSeq)
+      1 |-> list(sortVS(.ValSeq))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
