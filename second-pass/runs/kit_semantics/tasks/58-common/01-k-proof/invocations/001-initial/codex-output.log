diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..89c33828448b57ce3f0ecfe61d48e43a7944b3bb
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: it omits `item not in result`, so [1, 1]
+  // intersected with [1] returns [1, 1], not the original theorem's [1].
+  claim [duplicate-mutant]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "common",
+          Params("l1", "l2"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("item"), Int(0))
+          For(
+            Name("item"),
+            Name("l1"),
+            If(
+              Compare(Name("item"), CmpOp("in", Name("l2"))),
+              Expr(Call(
+                Attribute(Name("result"), "append"),
+                Name("item"))),
+              .Stmts))
+          Return(Call(Name("sorted"), Name("result"))))
+      ))
+      ~> Call(
+           Name("common"),
+           list(vCons(1, vCons(1, .ValSeq))),
+           list(vCons(1, .ValSeq)))
+    =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope(
+        "common" |-> closureVal(
+          ("l1", "l2", .ParamNames),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("item"), Int(0))
+          For(
+            Name("item"),
+            Name("l1"),
+            If(
+              Compare(Name("item"), CmpOp("in", Name("l2"))),
+              Expr(Call(
+                Attribute(Name("result"), "append"),
+                Name("item"))),
+              .Stmts))
+          Return(Call(Name("sorted"), Name("result"))),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(sortVS(vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..832377e82885143ea3cb1e6bc9fcf42c08483ce1
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: this ground call returns the separately allocated
+  // sorted list at ref(1), not the accumulator list at ref(0).
+  claim [false-result]:
+    <k>
+      #loadAll(Module(
+        FuncDef("common", Params("l1", "l2"), commonBody())
+      ))
+      ~> Call(
+           Name("common"),
+           list(vCons(1, .ValSeq)),
+           list(vCons(1, .ValSeq)))
+    =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope(
+        "common" |-> closureVal(
+          ("l1", "l2", .ParamNames),
+          commonBody(),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(sortVS(vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
