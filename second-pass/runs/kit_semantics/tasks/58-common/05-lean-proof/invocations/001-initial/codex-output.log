/tmp/lean-app-path-shim.c
diff --git a//tmp/lean-app-path-shim.c b//tmp/lean-app-path-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..26f733a793c005828a65ee271c5a622cf86f48b9
--- /dev/null
+++ b//tmp/lean-app-path-shim.c
@@ -0,0 +1,41 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static const char *normalized_proc_exe(const char *path) {
+  size_t length = strlen(path);
+  if (length > 10 &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return "/proc/self/exe";
+  }
+  return path;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (real_readlink == NULL) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  return real_readlink(normalized_proc_exe(path), buffer, size);
+}
+
+ssize_t readlinkat(
+    int directory,
+    const char *path,
+    char *buffer,
+    size_t size) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (real_readlinkat == NULL) {
+    real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  }
+  return real_readlinkat(
+      directory,
+      normalized_proc_exe(path),
+      buffer,
+      size);
+}
