/bin/bash -lc "chmod +x /audit-output/evidence/03b_dependency_proofs.sh && script -qec '/audit-output/evidence/03b_dependency_proofs.sh' /audit-output/evidence/03b-dependency-proofs.log; rc="'$?; echo "AUDIT_COMMAND_EXIT=$rc"; exit "$rc"' in /audit-output
