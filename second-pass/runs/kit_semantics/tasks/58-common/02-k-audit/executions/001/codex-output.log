   221	  rule tokNdAcc(A:Int, iCons(C:Int, R:IntSeq)) => tokNdAcc(A *Int 10 +Int (C -Int 48), R)
   222	       requires evDigit(C)
   223	  rule tokNdAcc(A:Int, S:IntSeq) => iCons(A, tokNds(S)) [owise]
   224	
   225	  syntax EvPair ::= evp(OpSeq, IntSeq)
   226	  syntax Int ::= firstNdE(EvPair) [function, total]
   227	  rule firstNdE(evp(_:OpSeq, iCons(N:Int, _:IntSeq))) => N
   228	  rule firstNdE(_:EvPair) => 0 [owise]
   229	
   230	  syntax Int ::= applyOpE(String, Int, Int) [function, total]
   231	  rule applyOpE("+",  A:Int, B:Int) => A +Int B
   232	  rule applyOpE("-",  A:Int, B:Int) => A -Int B
   233	  rule applyOpE("*",  A:Int, B:Int) => A *Int B
   234	  rule applyOpE("//", A:Int, B:Int) => A divInt B
   235	  rule applyOpE("**", A:Int, B:Int) => A ^Int B
   236	  rule applyOpE(_:String, A:Int, _:Int) => A [owise]
   237	
   238	  syntax EvPair ::= passPowE(OpSeq, IntSeq) [function, total]
   239	  rule passPowE(.OpSeq, NDS:IntSeq) => evp(.OpSeq, NDS)
   240	  rule passPowE(oCons("**", OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCombE(N, passPowE(OPS, NDS))
   241	  rule passPowE(oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCarryE(O, N, passPowE(OPS, NDS))
   242	       requires O =/=String "**"
   243	  rule passPowE(_:OpSeq, .IntSeq) => evp(.OpSeq, .IntSeq) [owise]
   244	  syntax EvPair ::= powCombE(Int, EvPair) [function, total]
   245	  rule powCombE(N:Int, evp(OPS:OpSeq, iCons(M:Int, REST:IntSeq))) => evp(OPS, iCons(N ^Int M, REST))
   246	  rule powCombE(N:Int, evp(OPS:OpSeq, .IntSeq)) => evp(OPS, iCons(N, .IntSeq))
   247	  syntax EvPair ::= powCarryE(String, Int, EvPair) [function, total]
   248	  rule powCarryE(O:String, N:Int, evp(OPS:OpSeq, NDS:IntSeq)) => evp(oCons(O, OPS), iCons(N, NDS))
   249	
   250	  syntax EvPair ::= passMulE(EvPair) [function, total] | passAddE(EvPair) [function, total]
   251	  rule passMulE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("mul", N0, OPS, NDS, .OpSeq, .IntSeq)
   252	  rule passMulE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   253	  rule passAddE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("add", N0, OPS, NDS, .OpSeq, .IntSeq)
   254	  rule passAddE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   255	  syntax EvPair ::= passLGoE(String, Int, OpSeq, IntSeq, OpSeq, IntSeq) [function, total]
   256	  rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))
   257	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   258	    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)
   259	       requires inLevelE(L, O)
   260	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   261	    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))
   262	       requires notBool inLevelE(L, O)
   263	  rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)
   264	    => evp(OO, appendIE(ON, CUR)) [owise]
   265	  syntax Bool ::= inLevelE(String, String) [function, total]
   266	  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
   267	  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
   268	  rule inLevelE(_:String, _:String) => false [owise]
   269	  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
   270	  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
   271	  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))
   272	  syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]
   273	  rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)
   274	  rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))
   275	
   276	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   277	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   278	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   279	  syntax KItem ::= "#md5"
   280	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   281	       [priority(40)]
   282	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   283	  syntax Val ::= md5Obj(IntSeq)
   284	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   285	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   286	
   287	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   288	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   289	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   290	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   291	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   292	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   293	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   294	  rule isIntV(_:Int)         => true
   295	  rule isIntV(_:Val)         => false [owise]
   296	  rule isStrV(str(_:IntSeq)) => true
   297	  rule isStrV(_:Val)         => false [owise]
   298	endmodule
FILE reference-semantics/semantics/sort.k
     1	// reference/src/semantics/sort.k — MPY-SORT
     2	// Trusted sorted(): sorted(list) as an opaque ascending permutation `sortVS` — opaque symbolic
     3	// for kprove (a trusted primitive, correctness/ordering proved in Lean / notes/sort-probe),
     4	// and a concrete insertion sort for krun. Wrappers verify the logic AROUND the sort (index /
     5	// slice / filter / dedup); indexing an opaque sortVS(VS) carries through as an opaque term, so
     6	// no ordering lemma is needed in K — the trust (sortVS = real sorted) is discharged by each
     7	// problem's differential test. Only int lists (compared by projectIntTotal); keyed / string
     8	// sorts are separate. Fires only via the "sorted" builtin, so inert for non-sorting programs.
     9	
    10	module MPY-SORT
    11	  imports MPY-BUILTINS
    12	  imports MPY-SUBSCRIPT
    13	
    14	  // sortVS(VS): the ascending sort of the Val list VS. Opaque for symbolic VS (no-evaluators);
    15	  // concrete insertion sort for krun.
    16	  // Concrete sort matches Int-sorted elements directly (an int Val IS an Int); projectIntTotal
    17	  // (lemmas-only) is not available in the semantics. Int and str lists.
    18	  syntax ValSeq ::= sortVS(ValSeq) [function, total, symbol(sortVS), no-evaluators]
    19	  syntax ValSeq ::= insVS(Int, ValSeq) [function]
    20	  rule sortVS(.ValSeq)                => .ValSeq          [concrete]
    21	  rule sortVS(vCons(X:Int, R:ValSeq)) => insVS(X, sortVS(R)) [concrete]
    22	  rule insVS(X:Int, .ValSeq)                => vCons(X, .ValSeq) [concrete]
    23	  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(X, vCons(Y, R)) requires X <=Int Y [concrete]
    24	  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(Y, insVS(X, R)) requires X  >Int Y [concrete]
    25	  // str elements insert by the shared lexicographic strLt (methods.k)
    26	  syntax ValSeq ::= insVSs(IntSeq, ValSeq) [function]
    27	  rule sortVS(vCons(str(CS:IntSeq), R:ValSeq)) => insVSs(CS, sortVS(R)) [concrete]
    28	  rule insVSs(A:IntSeq, .ValSeq) => vCons(str(A), .ValSeq) [concrete]
    29	  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(A), vCons(str(B), R))
    30	       requires strLt(A, B) orBool A ==K B [concrete]
    31	  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))
    32	       requires notBool (strLt(A, B) orBool A ==K B) [concrete]
    33	
    34	  // sorted(list) constructs a NEW object: k-cell pre-dispatch (beats the [owise]
    35	  // applyBuiltin routing in call.k) so the result allocates.
    36	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), .Vals))
    37	        => #alloc(list(sortVS(VS))) ... </k>
    38	
    39	  // mutator: xs.sort() — the in-place heap write over the same trusted sortVS
    40	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "sort")), .Vals) => noneV ... </k>
    41	       <heap> ... H |-> list(VS:ValSeq => sortVS(VS)) ... </heap>
    42	       [priority(40)]
    43	
    44	  // ==== keyed / reversed sorted() (WP2) =====================================
    45	  // sortKeyVS(VS, KV): the stable ascending sort of VS by the key value KV
    46	  // (a closure/builtin/type — anything callable). OPAQUE here; the concrete
    47	  // leg (MPY-CONCRETE, llvm only) computes keys by REAL calls and stable-
    48	  // inserts, at priority(40) over these.
    49	  syntax ValSeq ::= sortKeyVS(ValSeq, Val) [function, total, symbol(sortKeyVS), no-evaluators]
    50	
    51	  syntax ValSeq ::= revVS(ValSeq) [function, total]
    52	                  | revVSAcc(ValSeq, ValSeq) [function, total]
    53	  rule revVS(S:ValSeq) => revVSAcc(S, .ValSeq)
    54	  rule revVSAcc(.ValSeq, A:ValSeq) => A
    55	  rule revVSAcc(vCons(V:Val, R:ValSeq), A:ValSeq) => revVSAcc(R, vCons(V, A))
    56	
    57	  syntax ValSeq ::= condRev(ValSeq, Bool) [function, total]
    58	  rule condRev(S:ValSeq, false) => S
    59	  rule condRev(S:ValSeq, true)  => revVS(S)
    60	
    61	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    62	        => #alloc(list(sortKeyVS(VS, KV))) ... </k>
    63	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    64	        => #alloc(list(condRev(sortKeyVS(VS, KV), RB))) ... </k>
    65	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("reverse", RB:Bool), .Vals))
    66	        => #alloc(list(condRev(sortVS(VS), RB))) ... </k>
    67	
    68	  // Indexing the opaque sorted list: `valSeqAt(sortVS(VS), I)` is DEFINED because valSeqAt is
    69	  // [total] (subscript.k) — it stays an abstract total value for a symbolic sort and reduces
    70	  // over the concrete sort for krun. No separate sortedAt indirection is needed; wrappers write
    71	  // their postcondition directly as valSeqAt(sortVS(VS), …).
    72	endmodule
FILE reference-semantics/semantics/assert.k
     1	// reference/src/semantics/assert.k — MPY-ASSERT
     2	
     3	module MPY-ASSERT
     4	  imports MPY-CORE
     5	
     6	  rule <k> Assert(V:Val) => .K ... </k>
     7	       requires truthy(V)
     8	  rule <k> Assert(V:Val) ~> _ => .K </k>
     9	       <exc> NoExc => AssertionError </exc>
    10	       <exit-code> _ => 1 </exit-code>
    11	       requires notBool truthy(V)
    12	
    13	  rule <k> Assert(ref(H:Int)) => Assert(V) ... </k>
    14	       <heap> ... H |-> V:Val ... </heap>
    15	       [priority(40)]
    16	endmodule

diff --git a/evidence/02_fidelity.sh b/evidence/02_fidelity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a5ae7dfefdadf44091aad0d7c855286648c6d534
--- /dev/null
+++ b/evidence/02_fidelity.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/58-common
+
+echo 'COMMAND: python3 py2mpy.py solution.py > regenerated-solution.mpy'
+python3 py2mpy.py solution.py > regenerated-solution.mpy
+translate_status=$?
+echo "EXIT: ${translate_status}"
+sha256sum solution.mpy regenerated-solution.mpy
+
+echo 'COMMAND: cmp -s solution.mpy regenerated-solution.mpy'
+cmp -s solution.mpy regenerated-solution.mpy
+cmp_status=$?
+echo "EXIT: ${cmp_status}"
+if [[ ${cmp_status} -eq 0 ]]; then
+  echo 'BYTE_IDENTITY: yes'
+else
+  echo 'BYTE_IDENTITY: no'
+  diff -u solution.mpy regenerated-solution.mpy
+fi
+
+echo 'COMMAND: python3 /audit-output/evidence/differential_test.py'
+python3 /audit-output/evidence/differential_test.py
+differential_status=$?
+echo "EXIT: ${differential_status}"
+
+if [[ ${translate_status} -ne 0 || ${cmp_status} -ne 0 || ${differential_status} -ne 0 ]]; then
+  exit 1
+fi
diff --git a/evidence/03_reconstruct.sh b/evidence/03_reconstruct.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8a7caa15c4d0ea8469e47b37e86be09cc5d6217a
--- /dev/null
+++ b/evidence/03_reconstruct.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/58-common
+
+echo 'COMMAND: kompile --version; kprove --version; krun --version'
+kompile --version
+kprove --version
+krun --version
+version_status=$?
+echo "EXIT: ${version_status}"
+
+echo 'COMMAND: python3 py2mpy.py /audit-output/evidence/concrete_audit.py > concrete-audit.mpy'
+python3 py2mpy.py /audit-output/evidence/concrete_audit.py > concrete-audit.mpy
+translate_status=$?
+echo "EXIT: ${translate_status}"
+
+echo 'COMMAND: kompile --backend llvm reference-semantics/semantics.k --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition runtime-audit-kompiled'
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-audit-kompiled
+llvm_build_status=$?
+echo "EXIT: ${llvm_build_status}"
+
+echo 'COMMAND: krun concrete-audit.mpy --definition runtime-audit-kompiled'
+krun concrete-audit.mpy --definition runtime-audit-kompiled
+krun_status=$?
+echo "EXIT: ${krun_status}"
+
+echo 'COMMAND: kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-audit-kompiled'
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-audit-kompiled
+haskell_build_status=$?
+echo "EXIT: ${haskell_build_status}"
+
+claims=(member-fold common-loop common-program)
+proof_failure=0
+for claim in "${claims[@]}"; do
+  echo "COMMAND: kprove spec.k --definition verification-audit-kompiled --spec-module SPEC --claims SPEC.${claim}"
+  kprove spec.k \
+    --definition verification-audit-kompiled \
+    --spec-module SPEC \
+    --claims "SPEC.${claim}"
+  claim_status=$?
+  echo "CLAIM ${claim} EXIT: ${claim_status}"
+  if [[ ${claim_status} -ne 0 ]]; then
+    proof_failure=1
+  fi
+done
+
+echo "SUMMARY version=${version_status} translate=${translate_status} llvm_build=${llvm_build_status} krun=${krun_status} haskell_build=${haskell_build_status} proof_failure=${proof_failure}"
+if [[ ${version_status} -ne 0 || ${translate_status} -ne 0 || ${llvm_build_status} -ne 0 || ${krun_status} -ne 0 || ${haskell_build_status} -ne 0 || ${proof_failure} -ne 0 ]]; then
+  exit 1
+fi
diff --git a/evidence/03b_dependency_proofs.sh b/evidence/03b_dependency_proofs.sh
new file mode 100644
index 0000000000000000000000000000000000000000..36e775f6c85cb8ceb5c81e72e3a0425f687e280c
--- /dev/null
+++ b/evidence/03b_dependency_proofs.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/58-common
+
+echo 'NOTE: common-loop depends on member-fold; common-program depends on both auxiliary claims.'
+
+echo 'COMMAND: kprove spec.k --definition verification-audit-kompiled --spec-module SPEC --claims SPEC.member-fold'
+kprove spec.k \
+  --definition verification-audit-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.member-fold
+member_status=$?
+echo "TARGET member-fold EXIT: ${member_status}"
+
+echo 'COMMAND: kprove spec.k --definition verification-audit-kompiled --spec-module SPEC --exclude SPEC.common-program'
+kprove spec.k \
+  --definition verification-audit-kompiled \
+  --spec-module SPEC \
+  --exclude SPEC.common-program
+loop_closure_status=$?
+echo "TARGET common-loop WITH member-fold DEPENDENCY EXIT: ${loop_closure_status}"
+
+echo 'COMMAND: kprove spec.k --definition verification-audit-kompiled --spec-module SPEC'
+kprove spec.k \
+  --definition verification-audit-kompiled \
+  --spec-module SPEC
+program_closure_status=$?
+echo "TARGET common-program WITH BOTH DEPENDENCIES EXIT: ${program_closure_status}"
+
+echo "SUMMARY member=${member_status} loop_dependency_closure=${loop_closure_status} program_dependency_closure=${program_closure_status}"
+if [[ ${member_status} -ne 0 || ${loop_closure_status} -ne 0 || ${program_closure_status} -ne 0 ]]; then
+  exit 1
+fi
