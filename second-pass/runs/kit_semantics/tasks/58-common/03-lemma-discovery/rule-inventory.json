      "start_line": 14,
      "text": "  rule ((E:Val ==K V:Val) orBool B:Bool) => B\n    requires notBool (E ==K V)\n    [simplification]"
    },
    {
      "attributes": [],
      "end_line": 20,
      "module": "VERIFICATION",
      "normalized_sha256": "10e71d2ccb6e618e545b5c344fbd49a07fb245480c0dc10b2f8ce274d73e655c",
