      "start_line": 20,
      "text": "  rule commonAcc(.ValSeq, _:ValSeq, ACC:ValSeq) => ACC"
    },
    {
      "attributes": [],
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "b1d407f48ea5db85651bab85e4931a62e916cc0c29c463d62deb4e093d66c5cf",
      "source_rule_id": "rule-b1d407f48ea5db85651bab85e4931a62e916cc0c29c463d62deb4e093d66c5cf",
      "start_line": 21,
      "text": "  rule commonAcc(vCons(V:Val, R:ValSeq), B:ValSeq, ACC:ValSeq)\n    => commonAcc(\n         R,\n         B,\n         #if commonMember(V, B) andBool notBool commonMember(V, ACC)\n         #then valSeqConcat(ACC, vCons(V, .ValSeq))\n         #else ACC\n         #fi)"
    },
    {
      "attributes": [],
      "end_line": 41,
      "module": "VERIFICATION",
      "normalized_sha256": "24fa2be80e9ed0bfffd6b7a91d6b534370f30c8d0074bdfc6680eda1e7b5f16c",
      "source_rule_id": "rule-24fa2be80e9ed0bfffd6b7a91d6b534370f30c8d0074bdfc6680eda1e7b5f16c",
      "start_line": 32,
      "text": "  rule commonLoopBody()\n    => If(\n         BoolOp(\n           \"and\",\n           Compare(Name(\"item\"), CmpOp(\"in\", Name(\"l2\"))),\n           Compare(Name(\"item\"), CmpOp(\"not in\", Name(\"result\")))\n         ),\n         Expr(Call(Attribute(Name(\"result\"), \"append\"), Name(\"item\"))),\n         .Stmts\n       )"
    },
    {
      "attributes": [],
      "end_line": 48,
      "module": "VERIFICATION",
      "normalized_sha256": "345d1c0eced89af20c67c30dcca439dc5c455af03b30199f56c132eeb1dc141f",
      "source_rule_id": "rule-345d1c0eced89af20c67c30dcca439dc5c455af03b30199f56c132eeb1dc141f",
      "start_line": 44,
      "text": "  rule commonBody()\n    => Assign(Name(\"result\"), ListExpr(.Exprs))\n       Assign(Name(\"item\"), Int(0))\n       For(Name(\"item\"), Name(\"l1\"), commonLoopBody())\n       Return(Call(Name(\"sorted\"), Name(\"result\")))"
    }
  ],
