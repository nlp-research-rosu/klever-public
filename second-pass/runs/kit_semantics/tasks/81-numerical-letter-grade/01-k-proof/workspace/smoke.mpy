Module(
  FuncDef("numerical_letter_grade", Params("grades"),
    Assign(Name("letter_grades"), ListExpr())
    Assign(Name("grade"), Float(0.0))
    For(Name("grade"), Name("grades"),
      If(Compare(Name("grade"), CmpOp("==", Float(4.0))),
        Expr(
          Call(Attribute(Name("letter_grades"), "append"), Str("A+"))),
        If(Compare(Name("grade"), CmpOp(">", Float(3.7))),
          Expr(
            Call(Attribute(Name("letter_grades"), "append"), Str("A"))),
          If(Compare(Name("grade"), CmpOp(">", Float(3.3))),
            Expr(
              Call(
                Attribute(Name("letter_grades"), "append"),
                Str("A-"))),
            If(Compare(Name("grade"), CmpOp(">", Float(3.0))),
              Expr(
                Call(
                  Attribute(Name("letter_grades"), "append"),
                  Str("B+"))),
              If(Compare(Name("grade"), CmpOp(">", Float(2.7))),
                Expr(
                  Call(
                    Attribute(Name("letter_grades"), "append"),
                    Str("B"))),
                If(Compare(Name("grade"), CmpOp(">", Float(2.3))),
                  Expr(
                    Call(
                      Attribute(Name("letter_grades"), "append"),
                      Str("B-"))),
                  If(Compare(Name("grade"), CmpOp(">", Float(2.0))),
                    Expr(
                      Call(
                        Attribute(Name("letter_grades"), "append"),
                        Str("C+"))),
                    If(Compare(Name("grade"), CmpOp(">", Float(1.7))),
                      Expr(
                        Call(
                          Attribute(Name("letter_grades"), "append"),
                          Str("C"))),
                      If(Compare(Name("grade"), CmpOp(">", Float(1.3))),
                        Expr(
                          Call(
                            Attribute(Name("letter_grades"), "append"),
                            Str("C-"))),
                        If(Compare(Name("grade"), CmpOp(">", Float(1.0))),
                          Expr(
                            Call(
                              Attribute(Name("letter_grades"), "append"),
                              Str("D+"))),
                          If(Compare(Name("grade"), CmpOp(">", Float(0.7))),
                            Expr(
                              Call(
                                Attribute(
                                  Name("letter_grades"),
                                  "append"),
                                Str("D"))),
                            If(Compare(
                              Name("grade"),
                              CmpOp(">", Float(0.0))),
                              Expr(
                                Call(
                                  Attribute(
                                    Name("letter_grades"),
                                    "append"),
                                  Str("D-"))),
                              Expr(
                                Call(
                                  Attribute(
                                    Name("letter_grades"),
                                    "append"),
                                  Str("E"))))))))))))))))
    Return(Name("letter_grades")))
  Assert(
    Compare(
      Call(
        Name("numerical_letter_grade"),
        ListExpr(
          Float(4.0),
          Float(3.8),
          Float(3.7),
          Float(3.4),
          Float(3.3),
          Float(3.1),
          Float(3.0),
          Float(2.8),
          Float(2.7),
          Float(2.4),
          Float(2.3),
          Float(2.1),
          Float(2.0),
          Float(1.8),
          Float(1.7),
          Float(1.4),
          Float(1.3),
          Float(1.1),
          Float(1.0),
          Float(0.8),
          Float(0.7),
          Float(0.1),
          Float(0.0))),
      CmpOp(
        "==",
        ListExpr(
          Str("A+"),
          Str("A"),
          Str("A-"),
          Str("A-"),
          Str("B+"),
          Str("B+"),
          Str("B"),
          Str("B"),
          Str("B-"),
          Str("B-"),
          Str("C+"),
          Str("C+"),
          Str("C"),
          Str("C"),
          Str("C-"),
          Str("C-"),
          Str("D+"),
          Str("D+"),
          Str("D"),
          Str("D"),
          Str("D-"),
          Str("D-"),
          Str("E")))))
  Assert(
    Compare(
      Call(
        Name("numerical_letter_grade"),
        ListExpr(Float(4.0), Int(3), Float(1.7), Int(2), Float(3.5))),
      CmpOp(
        "==",
        ListExpr(Str("A+"), Str("B"), Str("C-"), Str("C"), Str("A-")))))
  Assert(
    Compare(
      Call(Name("numerical_letter_grade"), ListExpr()),
      CmpOp("==", ListExpr()))))
