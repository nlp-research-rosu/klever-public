                              Str("D+"))),
                          If(Compare(Name("grade"), CmpOp(">", Float(0.7))),
                            Expr(
                              Call(
                                Attribute(
                                  Name("letter_grades"),
                                  "append"),
                                Str("D"))),
                            If(Compare(
                              Name("grade"),
                              CmpOp(">", Float(0.0))),
                              Expr(
