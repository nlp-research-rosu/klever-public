+
+  claim [loop-invariant]:
+    <k> #loop(list(VS:ValSeq), Name("grade"), GRADE-STEP) => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> (
+        scope(
+          ("letter_grades" |-> ref(H:Int)) M:Map,
+          P:Parent
+        )
+        =>
+        scope(?FINALMAP:Map, P)
+      ) ...
+    </scopes>
+    <heap>
+      ... H |-> list(ACC:ValSeq => gradeAcc(ACC, VS)) ...
+    </heap>
+    requires allGradeNumbers(VS)
+     andBool notBool ("letter_grades" in_keys(M))
+     andBool notBool ("$cells" in_keys(M))
+
+  claim [entry]:
+    <k>
+      #loadAll(GRADE-PROGRAM)
+      ~> Call(
+           Name("numerical_letter_grade"),
+           (list(VS:ValSeq), .Exprs)
+         )
+      => ref(0)
+    </k>
+    <env> 0 => 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(gradeAcc(.ValSeq, VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+    <exit-code> 0 => 0 </exit-code>
+    requires allGradeNumbers(VS)
+endmodule
