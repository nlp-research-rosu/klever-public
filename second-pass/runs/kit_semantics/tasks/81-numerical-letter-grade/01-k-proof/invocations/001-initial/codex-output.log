+    requires isInt(V)
+    [simplification]
+  rule applyCmp("==", V:Val, F:Float)
+    => gradeFloat(V) ==Float F
+    requires isFloat(V)
+    [simplification]
+  rule applyCmp(">", V:Val, F:Float)
+    => gtF(gradeFloat(V), F)
+    requires isGradeNumber(V)
+    [simplification]
