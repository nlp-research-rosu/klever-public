@@ -0,0 +1,48 @@
+def numerical_letter_grade(grades):
+    letter_grades = []
+    grade = 0.0
+    for grade in grades:
+        if grade == 4.0:
+            letter_grades.append("A+")
+        elif grade > 3.7:
+            letter_grades.append("A")
+        elif grade > 3.3:
+            letter_grades.append("A-")
+        elif grade > 3.0:
+            letter_grades.append("B+")
+        elif grade > 2.7:
+            letter_grades.append("B")
+        elif grade > 2.3:
+            letter_grades.append("B-")
+        elif grade > 2.0:
+            letter_grades.append("C+")
+        elif grade > 1.7:
+            letter_grades.append("C")
+        elif grade > 1.3:
+            letter_grades.append("C-")
+        elif grade > 1.0:
+            letter_grades.append("D+")
+        elif grade > 0.7:
+            letter_grades.append("D")
+        elif grade > 0.0:
+            letter_grades.append("D-")
+        else:
+            letter_grades.append("E")
+    return letter_grades
+
+
+assert numerical_letter_grade(
+    [4.0, 3.8, 3.7, 3.4, 3.3, 3.1, 3.0, 2.8, 2.7,
+     2.4, 2.3, 2.1, 2.0, 1.8, 1.7, 1.4, 1.3, 1.1,
+     1.0, 0.8, 0.7, 0.1, 0.0]
+) == [
+    "A+", "A", "A-", "A-", "B+", "B+", "B", "B", "B-",
+    "B-", "C+", "C+", "C", "C", "C-", "C-", "D+",
+    "D+", "D", "D", "D-", "D-", "E"
+]
+
+assert numerical_letter_grade([4.0, 3, 1.7, 2, 3.5]) == [
+    "A+", "B", "C-", "C", "A-"
+]
+
+assert numerical_letter_grade([]) == []
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7c2e0e59f7aaef637b756492e8bf5438415d6a68
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,31 @@
+def numerical_letter_grade(grades):
+    letter_grades = []
+    grade = 0.0
+    for grade in grades:
+        if grade == 4.0:
+            letter_grades.append("A+")
+        elif grade > 3.7:
+            letter_grades.append("A")
+        elif grade > 3.3:
+            letter_grades.append("A-")
+        elif grade > 3.0:
+            letter_grades.append("B+")
+        elif grade > 2.7:
+            letter_grades.append("B")
+        elif grade > 2.3:
+            letter_grades.append("B-")
+        elif grade > 2.0:
+            letter_grades.append("C+")
+        elif grade > 1.7:
+            letter_grades.append("C")
+        elif grade > 1.3:
+            letter_grades.append("C-")
+        elif grade > 1.0:
+            letter_grades.append("D+")
+        elif grade > 0.7:
+            letter_grades.append("D")
+        elif grade > 0.0:
+            letter_grades.append("D-")
+        else:
+            letter_grades.append("E")
+    return letter_grades
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec57423255013b589df194fea9c30ed27a7917cd
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,32 @@
+requires "mutation.k"
+
+module SPEC-BODY-MUTATION
+  imports MUTATION
+
+  // This is the real loop machinery with a materially wrong body but the
+  // original result summary. A sound, body-sensitive theory must reject it.
+  claim [wrong-loop-body]:
+    <k> #loop(list(VS:ValSeq), Name("grade"), MUTANT-STEP) => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> (
+        scope(
+          "grades"        |-> INPUT:Val
+          "letter_grades" |-> ref(H:Int)
+          "grade"         |-> OLDGRADE:Val,
+          parent(0)
+        )
+        =>
+        scope(
+          "grades"        |-> INPUT
+          "letter_grades" |-> ref(H)
+          "grade"         |-> ?FINALGRADE:Val,
+          parent(0)
+        )
+      ) ...
+    </scopes>
+    <heap>
+      ... H |-> list(ACC:ValSeq => gradeAcc(ACC, VS)) ...
+    </heap>
+    requires allGradeNumbers(VS)
+endmodule
