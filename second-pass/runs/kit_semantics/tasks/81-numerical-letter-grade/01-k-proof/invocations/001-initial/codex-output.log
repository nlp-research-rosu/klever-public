+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(str(strToCodes("E")), .ValSeq)
+      )
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
