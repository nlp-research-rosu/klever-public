+        elif grade > 2.7:
+            letter_grades.append("B")
+        elif grade > 2.3:
+            letter_grades.append("B-")
+        elif grade > 2.0:
+            letter_grades.append("C+")
+        elif grade > 1.7:
+            letter_grades.append("C")
+        elif grade > 1.3:
+            letter_grades.append("C-")
