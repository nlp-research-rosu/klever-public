diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec57423255013b589df194fea9c30ed27a7917cd
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,32 @@
+requires "mutation.k"
+
+module SPEC-BODY-MUTATION
+  imports MUTATION
+
+  // This is the real loop machinery with a materially wrong body but the
+  // original result summary. A sound, body-sensitive theory must reject it.
+  claim [wrong-loop-body]:
+    <k> #loop(list(VS:ValSeq), Name("grade"), MUTANT-STEP) => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> (
+        scope(
+          "grades"        |-> INPUT:Val
+          "letter_grades" |-> ref(H:Int)
+          "grade"         |-> OLDGRADE:Val,
+          parent(0)
+        )
+        =>
+        scope(
+          "grades"        |-> INPUT
+          "letter_grades" |-> ref(H)
+          "grade"         |-> ?FINALGRADE:Val,
+          parent(0)
+        )
+      ) ...
+    </scopes>
+    <heap>
+      ... H |-> list(ACC:ValSeq => gradeAcc(ACC, VS)) ...
+    </heap>
+    requires allGradeNumbers(VS)
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..a231e7989ca422b6a7b5868880b559d14306f421
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the empty input returns [], not ["E"].
+  claim [false-empty-result]:
+    <k>
+      #loadAll(GRADE-PROGRAM)
+      ~> Call(
+           Name("numerical_letter_grade"),
+           (list(.ValSeq), .Exprs)
+         )
+      => ref(0)
+    </k>
+    <env> 0 => 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(str(strToCodes("E")), .ValSeq)
+      )
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+    <exit-code> 0 => 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..86a097854951f80ec6a1c2682673290bb3151d25
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k> #loop(list(VS:ValSeq), Name("grade"), GRADE-STEP) => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> (
+        scope(
+          "grades"        |-> INPUT:Val
+          "letter_grades" |-> ref(H:Int)
+          "grade"         |-> OLDGRADE:Val,
+          parent(0)
+        )
+        =>
+        scope(
+          "grades"        |-> INPUT
+          "letter_grades" |-> ref(H)
+          "grade"         |-> ?FINALGRADE:Val,
+          parent(0)
+        )
+      ) ...
+    </scopes>
+    <heap>
+      ... H |-> list(ACC:ValSeq => gradeAcc(ACC, VS)) ...
+    </heap>
+    requires allGradeNumbers(VS)
+
+  claim [entry]:
+    <k>
+      #loadAll(GRADE-PROGRAM)
+      ~> Call(
+           Name("numerical_letter_grade"),
+           (list(VS:ValSeq), .Exprs)
+         )
+      => ref(0)
+    </k>
+    <env> 0 => 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(gradeAcc(.ValSeq, VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+    <exit-code> 0 => 0 </exit-code>
+    requires allGradeNumbers(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9c92c9b9b1c01146aa2fa7f4e0ef43b42d73ceec
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,144 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact AST abbreviations for solution.mpy. These are compile-time macros;
+  // no program step is replaced at runtime.
+  syntax Stmts ::= "GRADE-STEP" [macro]
+  rule GRADE-STEP
+    => If(Compare(Name("grade"), CmpOp("==", Float(4.0))),
+          Expr(Call(Attribute(Name("letter_grades"), "append"), Str("A+"))),
+          If(Compare(Name("grade"), CmpOp(">", Float(3.7))),
+            Expr(Call(Attribute(Name("letter_grades"), "append"), Str("A"))),
+            If(Compare(Name("grade"), CmpOp(">", Float(3.3))),
+              Expr(Call(Attribute(Name("letter_grades"), "append"), Str("A-"))),
+              If(Compare(Name("grade"), CmpOp(">", Float(3.0))),
+                Expr(Call(Attribute(Name("letter_grades"), "append"), Str("B+"))),
+                If(Compare(Name("grade"), CmpOp(">", Float(2.7))),
+                  Expr(Call(Attribute(Name("letter_grades"), "append"), Str("B"))),
+                  If(Compare(Name("grade"), CmpOp(">", Float(2.3))),
+                    Expr(Call(Attribute(Name("letter_grades"), "append"), Str("B-"))),
+                    If(Compare(Name("grade"), CmpOp(">", Float(2.0))),
+                      Expr(Call(Attribute(Name("letter_grades"), "append"), Str("C+"))),
+                      If(Compare(Name("grade"), CmpOp(">", Float(1.7))),
+                        Expr(Call(Attribute(Name("letter_grades"), "append"), Str("C"))),
+                        If(Compare(Name("grade"), CmpOp(">", Float(1.3))),
+                          Expr(Call(Attribute(Name("letter_grades"), "append"), Str("C-"))),
+                          If(Compare(Name("grade"), CmpOp(">", Float(1.0))),
+                            Expr(Call(Attribute(Name("letter_grades"), "append"), Str("D+"))),
+                            If(Compare(Name("grade"), CmpOp(">", Float(0.7))),
+                              Expr(Call(Attribute(Name("letter_grades"), "append"), Str("D"))),
+                              If(Compare(Name("grade"), CmpOp(">", Float(0.0))),
+                                Expr(Call(Attribute(Name("letter_grades"), "append"), Str("D-"))),
+                                Expr(Call(Attribute(Name("letter_grades"), "append"), Str("E")))
+                              )
+                            )
+                          )
+                        )
+                      )
+                    )
+                  )
+                )
+              )
+            )
+          )
+        )
+
+  syntax Module ::= "GRADE-PROGRAM" [macro]
+  rule GRADE-PROGRAM
+    => Module(
+         FuncDef("numerical_letter_grade", Params("grades"),
+           Assign(Name("letter_grades"), ListExpr(.Exprs))
+           Assign(Name("grade"), Float(0.0))
+           For(Name("grade"), Name("grades"), GRADE-STEP)
+           Return(Name("letter_grades"))
+         )
+       )
+
+  // Dynamic-domain predicate used by the claims.
+  syntax Bool ::= isGradeNumber(Val) [function, total]
+  rule isGradeNumber(V:Val) => isInt(V) orBool isFloat(V)
+
+  syntax Bool ::= allGradeNumbers(ValSeq) [function, total]
+  rule allGradeNumbers(.ValSeq) => true
+  rule allGradeNumbers(vCons(V:Val, REST:ValSeq))
+    => isGradeNumber(V) andBool allGradeNumbers(REST)
+
+  // Total dynamic twins of MPY-FLOAT's Int/Float-vs-Float comparison cases.
+  // Their constructor equations are exhaustive and disjoint. The nonnumeric
+  // case totalizes the helper but is excluded by every dispatch use.
+  syntax Bool ::= gradeEq(Val, Float) [function, total]
+  rule gradeEq(I:Int, F:Float) => eqF(intToF(I), F)
+  rule gradeEq(G:Float, F:Float) => G ==Float F
+  rule gradeEq(V:Val, _:Float) => false
+    requires notBool isGradeNumber(V)
+
+  syntax Bool ::= gradeGt(Val, Float) [function, total]
+  rule gradeGt(I:Int, F:Float) => gtF(intToF(I), F)
+  rule gradeGt(G:Float, F:Float) => gtF(G, F)
+  rule gradeGt(V:Val, _:Float) => false
+    requires notBool isGradeNumber(V)
+
+  // Guarded dynamic-dispatch restatements of the fixed MPY equations.
+  rule applyCmp("==", V:Val, F:Float)
+    => gradeEq(V, F)
+    requires isGradeNumber(V)
+    [simplification]
+  rule applyCmp(">", V:Val, F:Float)
+    => gradeGt(V, F)
+    requires isGradeNumber(V)
+    [simplification]
+
+  // The single-element grading table, expressed with the same comparison
+  // atoms that fixed MPY execution produces.
+  syntax Val ::= gradeValue(Val) [function, total]
+  rule gradeValue(V:Val)
+    => #if gradeEq(V, 4.0)
+       #then str(strToCodes("A+"))
+       #else #if gradeGt(V, 3.7)
+             #then str(strToCodes("A"))
+             #else #if gradeGt(V, 3.3)
+                   #then str(strToCodes("A-"))
+                   #else #if gradeGt(V, 3.0)
+                         #then str(strToCodes("B+"))
+                         #else #if gradeGt(V, 2.7)
+                               #then str(strToCodes("B"))
+                               #else #if gradeGt(V, 2.3)
+                                     #then str(strToCodes("B-"))
+                                     #else #if gradeGt(V, 2.0)
+                                           #then str(strToCodes("C+"))
+                                           #else #if gradeGt(V, 1.7)
+                                                 #then str(strToCodes("C"))
+                                                 #else #if gradeGt(V, 1.3)
+                                                       #then str(strToCodes("C-"))
+                                                       #else #if gradeGt(V, 1.0)
+                                                             #then str(strToCodes("D+"))
+                                                             #else #if gradeGt(V, 0.7)
+                                                                   #then str(strToCodes("D"))
+                                                                   #else #if gradeGt(V, 0.0)
+                                                                         #then str(strToCodes("D-"))
+                                                                         #else str(strToCodes("E"))
+                                                                         #fi
+                                                                   #fi
+                                                             #fi
+                                                       #fi
+                                                 #fi
+                                           #fi
+                                     #fi
+                               #fi
+                         #fi
+                   #fi
+             #fi
+       #fi
+
+  // Tail-recursive result summary. Its step is exactly one list append
+  // followed by grading the remaining finite suffix.
+  syntax ValSeq ::= gradeAcc(ValSeq, ValSeq) [function, total]
+  rule gradeAcc(ACC:ValSeq, .ValSeq) => ACC
+  rule gradeAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => gradeAcc(
+         valSeqConcat(ACC, vCons(gradeValue(V), .ValSeq)),
+         REST
+       )
+endmodule

diff --git a/check_artifacts.py b/check_artifacts.py
new file mode 100644
index 0000000000000000000000000000000000000000..e223132523b7015365a93d5cfe6f407bc5422858
--- /dev/null
+++ b/check_artifacts.py
@@ -0,0 +1,30 @@
+import ast
+import subprocess
+from pathlib import Path
+
+
+workspace = Path(__file__).resolve().parent
+
+generated = subprocess.run(
+    ["python3", "py2mpy.py", "solution.py"],
+    cwd=workspace,
+    check=True,
+    capture_output=True,
+    text=True,
+).stdout
+recorded = (workspace / "solution.mpy").read_text(encoding="utf-8")
+if generated != recorded:
+    raise SystemExit("solution.mpy is stale")
+
+solution_tree = ast.parse(
+    (workspace / "solution.py").read_text(encoding="utf-8")
+)
+smoke_tree = ast.parse(
+    (workspace / "smoke.py").read_text(encoding="utf-8")
+)
+solution_function = solution_tree.body[0]
+smoke_function = smoke_tree.body[0]
+if ast.dump(solution_function) != ast.dump(smoke_function):
+    raise SystemExit("smoke.py does not contain the exact solution function")
+
+print("artifact checks: PASS")
diff --git a/differential.py b/differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..a98f305862f2d2d97259120328f8f75f86eb0aca
--- /dev/null
+++ b/differential.py
@@ -0,0 +1,62 @@
+import random
+
+from solution import numerical_letter_grade
+
+
+def table_oracle(grades):
+    cutoffs = [
+        (4.0, "A+", "equal"),
+        (3.7, "A", "greater"),
+        (3.3, "A-", "greater"),
+        (3.0, "B+", "greater"),
+        (2.7, "B", "greater"),
+        (2.3, "B-", "greater"),
+        (2.0, "C+", "greater"),
+        (1.7, "C", "greater"),
+        (1.3, "C-", "greater"),
+        (1.0, "D+", "greater"),
+        (0.7, "D", "greater"),
+        (0.0, "D-", "greater"),
+    ]
+    result = []
+    for grade in grades:
+        chosen = "E"
+        for cutoff, letter, relation in cutoffs:
+            if relation == "equal" and grade == cutoff:
+                chosen = letter
+                break
+            if relation == "greater" and grade > cutoff:
+                chosen = letter
+                break
+        result.append(chosen)
+    return result
+
+
+boundary_values = [
+    0.0, 0.1, 0.7, 0.8, 1.0, 1.1, 1.3, 1.4, 1.7, 1.8,
+    2.0, 2.1, 2.3, 2.4, 2.7, 2.8, 3.0, 3.1, 3.3, 3.4,
+    3.7, 3.8, 4.0, 0, 1, 2, 3, 4,
+]
+
+rng = random.Random(20260729)
+cases = [[], boundary_values, [4.0, 3, 1.7, 2, 3.5]]
+for _ in range(1000):
+    length = rng.randrange(0, 25)
+    case = []
+    for _ in range(length):
+        if rng.randrange(4) == 0:
+            case.append(rng.randrange(0, 5))
+        else:
+            case.append(rng.randrange(0, 401) / 100.0)
+    cases.append(case)
+
+mismatches = 0
+for case in cases:
+    expected = table_oracle(case)
+    actual = numerical_letter_grade(case)
+    if actual != expected:
+        mismatches += 1
+        print("mismatch", case, expected, actual)
+
+print(f"cases={len(cases)} mismatches={mismatches}")
+raise SystemExit(1 if mismatches else 0)
diff --git a/mutation.k b/mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..4d1f6eebe336ccebb12510191511efb61e253c65
--- /dev/null
+++ b/mutation.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module MUTATION
+  imports VERIFICATION
+
+  // Materially wrong loop body used only by the body-sensitivity probe.
+  syntax Stmts ::= "MUTANT-STEP" [macro]
+  rule MUTANT-STEP
+    => Expr(
+         Call(
+           Attribute(Name("letter_grades"), "append"),
+           Str("Z")
+         )
+       )
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..988cf004802c5e50b6f2e81fe2fca902267ba483
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+python3 check_artifacts.py
+python3 differential.py
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled \
+  2>&1 | tee llvm-compile.out
+
+krun smoke.mpy --definition runtime-kompiled | tee concrete.out
+python3 - <<'PY'
+from pathlib import Path
+
+result = Path("concrete.out").read_text(encoding="utf-8")
+if "<k>\n    .K\n  </k>" not in result:
+    raise SystemExit("concrete execution did not finish with .K")
+if "<exc>\n    NoExc\n  </exc>" not in result:
+    raise SystemExit("concrete execution raised an exception")
+if "<exit-code>\n    0\n  </exit-code>" not in result:
+    raise SystemExit("concrete execution did not report exit code 0")
+print("LLVM smoke checks: PASS")
+PY
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  2>&1 | tee haskell-compile.out
+
+# Confirm that the proof macro expands to the exact translated solution term.
+kast --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  solution.mpy > solution-term.kore
+kast --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  --expression 'GRADE-PROGRAM' > proof-term.kore
+cmp solution-term.kore proof-term.kore
+echo "KAST macro identity: PASS"
+
+# Required positive target proof: both the loop invariant and entry claim.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  2>&1 | tee target-proof.out
+grep -qx '#Top' target-proof.out
+
+# A5: a false postcondition for the realizable empty input must be rejected.
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY \
+  > vacuity.out 2>&1
+vacuity_status=$?
+set -e
+if [[ "$vacuity_status" -eq 0 ]]; then
+  echo "ERROR: false-postcondition probe unexpectedly proved" >&2
+  exit 1
+fi
+grep -q 'WarnStuckClaimState' vacuity.out
+echo "false-postcondition probe: EXPECTED FAILURE (exit $vacuity_status)"
+
+# A1: a materially wrong real loop body must invalidate the invariant.
+kompile mutation.k \
+  --backend haskell \
+  --main-module MUTATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition mutation-kompiled \
+  2>&1 | tee mutation-compile.out
+
+set +e
+kprove spec-body-mutation.k \
+  --definition mutation-kompiled \
+  --spec-module SPEC-BODY-MUTATION \
+  > body-mutation.out 2>&1
+body_mutation_status=$?
+set -e
+if [[ "$body_mutation_status" -eq 0 ]]; then
+  echo "ERROR: body-mutation probe unexpectedly proved" >&2
+  exit 1
+fi
