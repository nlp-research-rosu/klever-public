    66	    => isGradeNumber(V) andBool allGradeNumbers(REST)
    67	
    68	  // Total dynamic twins of MPY-FLOAT's Int/Float-vs-Float comparison cases.
    69	  // Their constructor equations are exhaustive and disjoint. The nonnumeric
    70	  // case totalizes the helper but is excluded by every dispatch use.
    71	  syntax Bool ::= gradeEq(Val, Float) [function, total]
    72	  rule gradeEq(I:Int, F:Float) => eqF(intToF(I), F)
    73	  rule gradeEq(G:Float, F:Float) => G ==Float F
    74	  rule gradeEq(V:Val, _:Float) => false
    75	    requires notBool isGradeNumber(V)
    76	
    77	  syntax Bool ::= gradeGt(Val, Float) [function, total]
    78	  rule gradeGt(I:Int, F:Float) => gtF(intToF(I), F)
    79	  rule gradeGt(G:Float, F:Float) => gtF(G, F)
    80	  rule gradeGt(V:Val, _:Float) => false
    81	    requires notBool isGradeNumber(V)
    82	
    83	  // Guarded dynamic-dispatch restatements of the fixed MPY equations.
    84	  rule applyCmp("==", V:Val, F:Float)
    85	    => gradeEq(V, F)
    86	    requires isGradeNumber(V)
    87	    [simplification]
    88	  rule applyCmp(">", V:Val, F:Float)
    89	    => gradeGt(V, F)
    90	    requires isGradeNumber(V)
    91	    [simplification]
    92	
    93	  // The single-element grading table, expressed with the same comparison
    94	  // atoms that fixed MPY execution produces.
    95	  syntax Val ::= gradeValue(Val) [function, total]
    96	  rule gradeValue(V:Val)
    97	    => #if gradeEq(V, 4.0)
    98	       #then str(strToCodes("A+"))
    99	       #else #if gradeGt(V, 3.7)
   100	             #then str(strToCodes("A"))
   101	             #else #if gradeGt(V, 3.3)
   102	                   #then str(strToCodes("A-"))
   103	                   #else #if gradeGt(V, 3.0)
   104	                         #then str(strToCodes("B+"))
   105	                         #else #if gradeGt(V, 2.7)
   106	                               #then str(strToCodes("B"))
   107	                               #else #if gradeGt(V, 2.3)
   108	                                     #then str(strToCodes("B-"))
   109	                                     #else #if gradeGt(V, 2.0)
   110	                                           #then str(strToCodes("C+"))
   111	                                           #else #if gradeGt(V, 1.7)
   112	                                                 #then str(strToCodes("C"))
   113	                                                 #else #if gradeGt(V, 1.3)
   114	                                                       #then str(strToCodes("C-"))
   115	                                                       #else #if gradeGt(V, 1.0)
   116	                                                             #then str(strToCodes("D+"))
   117	                                                             #else #if gradeGt(V, 0.7)
   118	                                                                   #then str(strToCodes("D"))
   119	                                                                   #else #if gradeGt(V, 0.0)
   120	                                                                         #then str(strToCodes("D-"))
   121	                                                                         #else str(strToCodes("E"))
   122	                                                                         #fi
   123	                                                                   #fi
   124	                                                             #fi
   125	                                                       #fi
   126	                                                 #fi
   127	                                           #fi
   128	                                     #fi
   129	                               #fi
   130	                         #fi
   131	                   #fi
   132	             #fi
   133	       #fi
   134	
   135	  // Tail-recursive result summary. Its step is exactly one list append
   136	  // followed by grading the remaining finite suffix.
   137	  syntax ValSeq ::= gradeAcc(ValSeq, ValSeq) [function, total]
   138	  rule gradeAcc(ACC:ValSeq, .ValSeq) => ACC
   139	  rule gradeAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
   140	    => gradeAcc(
   141	         valSeqConcat(ACC, vCons(gradeValue(V), .ValSeq)),
   142	         REST
   143	       )
   144	endmodule

codex
