import json
from collections import Counter
from pathlib import Path

inv = json.loads(Path('/reference/rule-inventory.json').read_text(encoding='utf-8'))
out = json.loads(Path('/workspace/trust-boundary.json').read_text(encoding='utf-8'))

assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert isinstance(out['rules'], list)
assert len(out['rules']) == len(inv['rules'])
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
expected_ids = [r['source_rule_id'] for r in inv['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids))
for entry in out['rules']:
    assert list(entry.keys()) == ['source_rule_id', 'classification', 'rationale'], entry
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
by_id = {r['source_rule_id']: r for r in out['rules']}
for rule in inv['rules']:
    if 'simplification' in rule.get('attributes', []):
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(r['classification'] for r in out['rules'])
assert counts == Counter({'DEFINITION': 14, 'DOMAIN_LEMMA': 2}), counts
text = Path('/workspace/DISCOVERY.md').read_text(encoding='utf-8')
assert 'There are no separately proved derived lemmas.' in text
assert 'The domain-lemma set is not empty.' in text
for rid in expected_ids:
    assert text.count(rid) >= (1 if by_id[rid]['classification'] == 'DOMAIN_LEMMA' else 0)
print('schema/order/coverage: PASS')
print('inventory_sha256:', out['inventory_sha256'])
print('rule_count:', len(actual_ids))
print('classification_counts:', dict(counts))
PY
