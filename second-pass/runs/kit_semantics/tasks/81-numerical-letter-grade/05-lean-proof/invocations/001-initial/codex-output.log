+      else if op = "!=" then !(a == b)
+      else false
+  | SortVal.inj_SortInt a, SortVal.inj_SortInt b =>
+      if op = "<" then decide (a < b)
+      else if op = "<=" then decide (a ≤ b)
+      else if op = ">" then decide (a > b)
+      else if op = ">=" then decide (a ≥ b)
+      else if op = "==" then a == b
+      else if op = "!=" then !(a == b)
+      else false
