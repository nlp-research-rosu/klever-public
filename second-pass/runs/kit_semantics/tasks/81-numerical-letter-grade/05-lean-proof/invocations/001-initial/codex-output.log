+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
+      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _ => true
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _,
+      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
