diff --git a/.lean-proc-shim.c b/.lean-proc-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..f523a1f3e77550ccdca99ff1d48d18da38af5a9d
--- /dev/null
+++ b/.lean-proc-shim.c
@@ -0,0 +1,18 @@
+#define _GNU_SOURCE
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static const char *lean_proc_exe_path(const char *path) {
+  size_t n = strlen(path);
+  if (n > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + n - 4, "/exe") == 0) {
+    return "/proc/self/exe";
+  }
+  return path;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  return syscall(SYS_readlink, lean_proc_exe_path(path), buf, size);
+}
