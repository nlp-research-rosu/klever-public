    48	  syntax Module ::= "GRADE-PROGRAM" [macro]
    49	  rule GRADE-PROGRAM
    50	    => Module(
    51	         FuncDef("numerical_letter_grade", Params("grades"),
    52	           Assign(Name("letter_grades"), ListExpr(.Exprs))
