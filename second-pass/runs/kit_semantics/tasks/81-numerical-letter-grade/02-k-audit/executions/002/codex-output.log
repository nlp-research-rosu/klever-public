// The krun (llvm) main module: MPY plus the concrete-only legs (keyed sort's
// real key calls, deep list equality). Verification builds import MPY and
// never see MPY-CONCRETE. The llvm kompile MUST use --main-module MPY-KRUN —
// with plain MPY the concrete legs are silently absent (this was live for a
// while: sorted-key stuck and comprehension asserted wrong under krun).
module MPY-KRUN
  imports MPY
  imports MPY-CONCRETE
endmodule
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Exact AST abbreviations for solution.mpy. These are compile-time macros;
  // no program step is replaced at runtime.
  syntax Stmts ::= "GRADE-STEP" [macro]
  rule GRADE-STEP
    => If(Compare(Name("grade"), CmpOp("==", Float(4.0))),
          Expr(Call(Attribute(Name("letter_grades"), "append"), Str("A+"))),
          If(Compare(Name("grade"), CmpOp(">", Float(3.7))),
            Expr(Call(Attribute(Name("letter_grades"), "append"), Str("A"))),
            If(Compare(Name("grade"), CmpOp(">", Float(3.3))),
              Expr(Call(Attribute(Name("letter_grades"), "append"), Str("A-"))),
              If(Compare(Name("grade"), CmpOp(">", Float(3.0))),
                Expr(Call(Attribute(Name("letter_grades"), "append"), Str("B+"))),
                If(Compare(Name("grade"), CmpOp(">", Float(2.7))),
                  Expr(Call(Attribute(Name("letter_grades"), "append"), Str("B"))),
                  If(Compare(Name("grade"), CmpOp(">", Float(2.3))),
                    Expr(Call(Attribute(Name("letter_grades"), "append"), Str("B-"))),
                    If(Compare(Name("grade"), CmpOp(">", Float(2.0))),
                      Expr(Call(Attribute(Name("letter_grades"), "append"), Str("C+"))),
                      If(Compare(Name("grade"), CmpOp(">", Float(1.7))),
                        Expr(Call(Attribute(Name("letter_grades"), "append"), Str("C"))),
                        If(Compare(Name("grade"), CmpOp(">", Float(1.3))),
                          Expr(Call(Attribute(Name("letter_grades"), "append"), Str("C-"))),
                          If(Compare(Name("grade"), CmpOp(">", Float(1.0))),
                            Expr(Call(Attribute(Name("letter_grades"), "append"), Str("D+"))),
                            If(Compare(Name("grade"), CmpOp(">", Float(0.7))),
                              Expr(Call(Attribute(Name("letter_grades"), "append"), Str("D"))),
                              If(Compare(Name("grade"), CmpOp(">", Float(0.0))),
                                Expr(Call(Attribute(Name("letter_grades"), "append"), Str("D-"))),
                                Expr(Call(Attribute(Name("letter_grades"), "append"), Str("E")))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )

  syntax Module ::= "GRADE-PROGRAM" [macro]
  rule GRADE-PROGRAM
    => Module(
         FuncDef("numerical_letter_grade", Params("grades"),
           Assign(Name("letter_grades"), ListExpr(.Exprs))
           Assign(Name("grade"), Float(0.0))
           For(Name("grade"), Name("grades"), GRADE-STEP)
           Return(Name("letter_grades"))
         )
       )

  // Dynamic-domain predicate used by the claims.
  syntax Bool ::= isGradeNumber(Val) [function, total]
  rule isGradeNumber(V:Val) => isInt(V) orBool isFloat(V)

  syntax Bool ::= allGradeNumbers(ValSeq) [function, total]
  rule allGradeNumbers(.ValSeq) => true
  rule allGradeNumbers(vCons(V:Val, REST:ValSeq))
    => isGradeNumber(V) andBool allGradeNumbers(REST)

  // Total dynamic twins of MPY-FLOAT's Int/Float-vs-Float comparison cases.
  // Their constructor equations are exhaustive and disjoint. The nonnumeric
  // case totalizes the helper but is excluded by every dispatch use.
  syntax Bool ::= gradeEq(Val, Float) [function, total]
  rule gradeEq(I:Int, F:Float) => eqF(intToF(I), F)
  rule gradeEq(G:Float, F:Float) => G ==Float F
  rule gradeEq(V:Val, _:Float) => false
    requires notBool isGradeNumber(V)

  syntax Bool ::= gradeGt(Val, Float) [function, total]
  rule gradeGt(I:Int, F:Float) => gtF(intToF(I), F)
  rule gradeGt(G:Float, F:Float) => gtF(G, F)
  rule gradeGt(V:Val, _:Float) => false
    requires notBool isGradeNumber(V)

  // Guarded dynamic-dispatch restatements of the fixed MPY equations.
  rule applyCmp("==", V:Val, F:Float)
    => gradeEq(V, F)
    requires isGradeNumber(V)
    [simplification]
  rule applyCmp(">", V:Val, F:Float)
    => gradeGt(V, F)
    requires isGradeNumber(V)
    [simplification]

  // The single-element grading table, expressed with the same comparison
  // atoms that fixed MPY execution produces.
  syntax Val ::= gradeValue(Val) [function, total]
  rule gradeValue(V:Val)
    => #if gradeEq(V, 4.0)
       #then str(strToCodes("A+"))
       #else #if gradeGt(V, 3.7)
             #then str(strToCodes("A"))
             #else #if gradeGt(V, 3.3)
                   #then str(strToCodes("A-"))
                   #else #if gradeGt(V, 3.0)
                         #then str(strToCodes("B+"))
                         #else #if gradeGt(V, 2.7)
                               #then str(strToCodes("B"))
                               #else #if gradeGt(V, 2.3)
                                     #then str(strToCodes("B-"))
                                     #else #if gradeGt(V, 2.0)
                                           #then str(strToCodes("C+"))
                                           #else #if gradeGt(V, 1.7)
                                                 #then str(strToCodes("C"))
                                                 #else #if gradeGt(V, 1.3)
                                                       #then str(strToCodes("C-"))
                                                       #else #if gradeGt(V, 1.0)
                                                             #then str(strToCodes("D+"))
                                                             #else #if gradeGt(V, 0.7)
                                                                   #then str(strToCodes("D"))
                                                                   #else #if gradeGt(V, 0.0)
                                                                         #then str(strToCodes("D-"))
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [loop-invariant]:
    <k> #loop(list(VS:ValSeq), Name("grade"), GRADE-STEP) => .K ... </k>
    <env> L:Int </env>
    <scopes>
      ... L |-> (
        scope(
          "grades"        |-> INPUT:Val
          "letter_grades" |-> ref(H:Int)
          "grade"         |-> OLDGRADE:Val,
          parent(0)
        )
        =>
        scope(
          "grades"        |-> INPUT
          "letter_grades" |-> ref(H)
          "grade"         |-> ?FINALGRADE:Val,
          parent(0)
        )
      ) ...
    </scopes>
    <heap>
      ... H |-> list(ACC:ValSeq => gradeAcc(ACC, VS)) ...
    </heap>
    requires allGradeNumbers(VS)

  claim [entry]:
    <k>
      #loadAll(GRADE-PROGRAM)
      ~> Call(
           Name("numerical_letter_grade"),
           (list(VS:ValSeq), .Exprs)
         )
      => ref(0)
    </k>
    <env> 0 => 0 </env>
    <scopes>
      (0  |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      => ?FINALSCOPES:Map
    </scopes>
    <scopeLoc> 1 => 1 </scopeLoc>
    <heap>
      .Map => 0 |-> list(gradeAcc(.ValSeq, VS))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List => .List </stack>
    <ret> noRet => noRet </ret>
    <exc> NoExc => NoExc </exc>
    <exit-code> 0 => 0 </exit-code>
    requires allGradeNumbers(VS)
endmodule

diff --git a/evidence/stage1/hash_formula_search.py b/evidence/stage1/hash_formula_search.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e7fbfe3fafd65a012916fdab606e8bb03369d3d
--- /dev/null
+++ b/evidence/stage1/hash_formula_search.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Search a bounded family of conventional tree-hash serializations."""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import os
+import stat
+import sys
+from pathlib import Path
+
+
+def tree_entries(root: Path) -> list[tuple[str, str, bytes]]:
+    entries: list[tuple[str, str, bytes]] = []
+    for current, directories, files in os.walk(root):
+        directories.sort()
+        files.sort()
+        base = Path(current)
+        for name in directories:
+            path = base / name
+            mode = path.stat(follow_symlinks=False).st_mode
+            if not stat.S_ISDIR(mode):
+                raise RuntimeError(path)
+            entries.append((path.relative_to(root).as_posix(), "directory", b""))
+        for name in files:
+            path = base / name
+            mode = path.stat(follow_symlinks=False).st_mode
+            if not stat.S_ISREG(mode):
+                raise RuntimeError(path)
+            entries.append((path.relative_to(root).as_posix(), "file", path.read_bytes()))
+    return sorted(entries)
+
+
+def field_bytes(kind: str, content: bytes, mode: str) -> bytes:
+    if kind == "directory":
+        return b""
+    if mode == "raw":
+        return content
+    binary = hashlib.sha256(content).digest()
+    if mode == "sha-bin":
+        return binary
+    if mode == "sha-hex":
+        return binary.hex().encode()
+    raise AssertionError(mode)
+
+
+def main() -> None:
+    root = Path(sys.argv[1])
+    target = sys.argv[2]
+    entries = tree_entries(root)
+    separators = [b"", b"\0", b"\n", b" ", b":", b"\t"]
+    prefixes = ["", "./"]
+    kinds = {
+        "none": {"file": b"", "directory": b""},
+        "word": {"file": b"file", "directory": b"directory"},
+        "letter": {"file": b"F", "directory": b"D"},
+    }
+    found = 0
+    for include_dirs, prefix, kind_name, content_mode, sep1, sep2, sep3 in itertools.product(
+        [False, True],
+        prefixes,
+        kinds,
+        ["raw", "sha-bin", "sha-hex"],
+        separators,
+        separators,
+        separators,
+    ):
+        digest = hashlib.sha256()
+        for rel, kind, content in entries:
+            if kind == "directory" and not include_dirs:
+                continue
+            digest.update((prefix + rel).encode())
+            digest.update(sep1)
+            digest.update(kinds[kind_name][kind])
+            digest.update(sep2)
+            digest.update(field_bytes(kind, content, content_mode))
+            digest.update(sep3)
+        if digest.hexdigest() == target:
+            found += 1
+            print(
+                "MATCH",
+                f"include_dirs={include_dirs}",
+                f"prefix={prefix!r}",
+                f"kind={kind_name}",
+                f"content={content_mode}",
+                f"sep1={sep1!r}",
+                f"sep2={sep2!r}",
+                f"sep3={sep3!r}",
+            )
+    print(f"SEARCHED root={root} target={target} matches={found}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/stage1/hash_probe.py b/evidence/stage1/hash_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..d9532a37252c70e44924b6bf10063657331ceaf9
--- /dev/null
+++ b/evidence/stage1/hash_probe.py
@@ -0,0 +1,108 @@
+#!/usr/bin/env python3
+"""Probe common deterministic directory-digest encodings.
+
+This is reviewer-authored diagnostic evidence.  It does not trust candidate
+hashes or candidate code.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+import sys
+from pathlib import Path
+
+
+def entries(root: Path) -> list[tuple[str, str, Path]]:
+    result: list[tuple[str, str, Path]] = []
+    pending = [root]
+    while pending:
+        directory = pending.pop()
+        for item in os.scandir(directory):
+            mode = item.stat(follow_symlinks=False).st_mode
+            path = Path(item.path)
+            rel = path.relative_to(root).as_posix()
+            if stat.S_ISDIR(mode):
+                result.append((rel, "directory", path))
+                pending.append(path)
+            elif stat.S_ISREG(mode):
+                result.append((rel, "file", path))
+            else:
+                raise RuntimeError(f"unsupported entry: {path}")
+    return sorted(result)
+
+
+def digest_stream(parts: list[bytes]) -> str:
+    digest = hashlib.sha256()
+    for part in parts:
+        digest.update(part)
+    return digest.hexdigest()
+
+
+def probe(root: Path) -> None:
+    tree = entries(root)
+    files = [(rel, path) for rel, kind, path in tree if kind == "file"]
+    file_hashes = [(rel, hashlib.sha256(path.read_bytes()).hexdigest()) for rel, path in files]
+    outputs: dict[str, str] = {}
+    outputs["concat-content"] = digest_stream([path.read_bytes() for _, path in files])
+    outputs["rel-nul-content"] = digest_stream(
+        [part for rel, path in files for part in (rel.encode(), b"\0", path.read_bytes())]
+    )
+    outputs["rel-newline-content"] = digest_stream(
+        [part for rel, path in files for part in (rel.encode(), b"\n", path.read_bytes())]
+    )
+    outputs["rel-nul-hex-nul"] = digest_stream(
+        [
+            part
+            for rel, hexdigest in file_hashes
+            for part in (rel.encode(), b"\0", hexdigest.encode(), b"\0")
+        ]
+    )
+    outputs["hex-space-rel-newline"] = digest_stream(
+        [
+            f"{hexdigest}  {rel}\n".encode()
+            for rel, hexdigest in file_hashes
+        ]
+    )
+    outputs["json-map-compact"] = hashlib.sha256(
+        json.dumps(dict(file_hashes), sort_keys=True, separators=(",", ":")).encode()
+    ).hexdigest()
+    outputs["json-map-default"] = hashlib.sha256(
+        json.dumps(dict(file_hashes), sort_keys=True).encode()
+    ).hexdigest()
+
+    pipeline_parts: list[bytes] = []
+    lean_parts: list[bytes] = []
+    for rel, kind, path in tree:
+        encoded = rel.encode()
+        pipeline_parts.extend(
+            [
+                len(encoded).to_bytes(4, "big"),
+                encoded,
+                kind.encode(),
+                b"\0",
+            ]
+        )
+        lean_parts.extend([encoded, b"\0", kind.encode(), b"\0"])
+        if kind == "file":
+            content = path.read_bytes()
+            pipeline_parts.extend([len(content).to_bytes(8, "big"), content])
+            lean_parts.append(content)
+    outputs["pipeline-sha256-tree"] = digest_stream(pipeline_parts)
+    outputs["relative-nul-kind-nul-content"] = digest_stream(lean_parts)
+
+    print(f"ROOT {root}")
+    print(f"ENTRY_COUNT {len(tree)} FILE_COUNT {len(files)}")
+    for name, value in outputs.items():
+        print(f"{name} {value}")
+
+
+def main() -> None:
+    for argument in sys.argv[1:]:
+        probe(Path(argument))
+
+
+if __name__ == "__main__":
+    main()
