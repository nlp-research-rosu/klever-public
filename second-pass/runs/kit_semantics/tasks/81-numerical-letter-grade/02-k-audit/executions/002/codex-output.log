+            found += 1
+            print(
+                "MATCH",
+                f"include_dirs={include_dirs}",
+                f"prefix={prefix!r}",
+                f"kind={kind_name}",
+                f"content={content_mode}",
+                f"sep1={sep1!r}",
+                f"sep2={sep2!r}",
+                f"sep3={sep3!r}",
+            )
