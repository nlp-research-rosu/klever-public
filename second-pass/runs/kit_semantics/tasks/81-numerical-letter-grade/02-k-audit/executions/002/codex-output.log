+  --definition audit-verification-kompiled \
+  --spec-module SPEC-FRESH-VACUITY \
+  --claims SPEC-FRESH-VACUITY.false-empty-return
+false_rc=$?
+printf 'EXIT false_mutation=%s expected_nonzero=1\n' "$false_rc"
+
+if (( false_rc == 0 )); then
+  exit 1
+fi
+exit 0
