index 0000000000000000000000000000000000000000..8c97eeed29a29a1f3528ef7081cf8ab35616a476
--- /dev/null
+++ b/evidence/stage6/run_fresh_vacuity.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/candidate-src || exit 90
+
