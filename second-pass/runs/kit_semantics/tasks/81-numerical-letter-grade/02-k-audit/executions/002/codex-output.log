+
+printf '$ sha256sum audit-solution-term.kore audit-proof-term.kore\n'
+sha256sum audit-solution-term.kore audit-proof-term.kore
+sha_rc=$?
+printf 'EXIT sha256sum=%s\n' "$sha_rc"
