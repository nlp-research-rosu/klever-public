     6	def table_oracle(grades):
     7	    cutoffs = [
     8	        (4.0, "A+", "equal"),
     9	        (3.7, "A", "greater"),
    10	        (3.3, "A-", "greater"),
    11	        (3.0, "B+", "greater"),
    12	        (2.7, "B", "greater"),
    13	        (2.3, "B-", "greater"),
    14	        (2.0, "C+", "greater"),
    15	        (1.7, "C", "greater"),
    16	        (1.3, "C-", "greater"),
    17	        (1.0, "D+", "greater"),
    18	        (0.7, "D", "greater"),
    19	        (0.0, "D-", "greater"),
    20	    ]
    21	    result = []
    22	    for grade in grades:
    23	        chosen = "E"
    24	        for cutoff, letter, relation in cutoffs:
    25	            if relation == "equal" and grade == cutoff:
    26	                chosen = letter
    27	                break
    28	            if relation == "greater" and grade > cutoff:
    29	                chosen = letter
    30	                break
    31	        result.append(chosen)
    32	    return result
