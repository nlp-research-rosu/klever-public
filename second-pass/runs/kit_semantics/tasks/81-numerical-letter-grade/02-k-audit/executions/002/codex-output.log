+
+printf '$ kprove /audit-output/evidence/stage6/spec-fresh-vacuity.k --definition audit-verification-kompiled --spec-module SPEC-FRESH-VACUITY --claims SPEC-FRESH-VACUITY.false-empty-return\n'
