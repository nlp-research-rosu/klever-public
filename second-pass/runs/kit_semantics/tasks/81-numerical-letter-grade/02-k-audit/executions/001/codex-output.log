+
+    result = {
+        "oracle": str(CANONICAL_PATH),
+        "generated": str(GENERATED_PATH),
+        "case_count": len(records),
+        "element_count": sum(len(record["input"]) for record in records),
+        "mismatch_count": len(mismatches),
