@@ -0,0 +1,36 @@
+requires "verification-body-mutant.k"
+
+module SPEC-BODY-SENSITIVITY
+  imports AUDIT-BODY-MUTANT
+
+  // The actual k-cell executes AUDIT-MUTANT-STEP while the destination retains
+  // the original gradeAcc summary. A body-insensitive proof would accept this.
+  claim [mutated-loop-body]:
+    <k>
+      #loop(list(VS:ValSeq), Name("grade"), AUDIT-MUTANT-STEP)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> (
+        scope(
+          "grades"        |-> INPUT:Val
+          "letter_grades" |-> ref(H:Int)
+          "grade"         |-> OLDGRADE:Val,
+          parent(0)
+        )
+        =>
+        scope(
+          "grades"        |-> INPUT
+          "letter_grades" |-> ref(H)
+          "grade"         |-> ?FINALGRADE:Val,
+          parent(0)
+        )
+      ) ...
+    </scopes>
+    <heap>
+      ... H |-> list(ACC:ValSeq => gradeAcc(ACC, VS)) ...
+    </heap>
+    requires allGradeNumbers(VS)
+endmodule
diff --git a/evidence/spec-fresh-false.k b/evidence/spec-fresh-false.k
new file mode 100644
index 0000000000000000000000000000000000000000..aa587d1f87557676ce344393d7bfde56d3e70a3e
--- /dev/null
+++ b/evidence/spec-fresh-false.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SPEC-FRESH-FALSE
+  imports VERIFICATION
+
+  // Fresh audit mutation. Empty input satisfies the numeric precondition, but
+  // the real program returns [], while this postcondition requires ["A+"].
+  claim [wrong-empty-result]:
+    <k>
+      #loadAll(GRADE-PROGRAM)
+      ~> Call(
+           Name("numerical_letter_grade"),
+           (list(.ValSeq), .Exprs)
+         )
+      => ref(0)
+    </k>
+    <env> 0 => 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(str(strToCodes("A+")), .ValSeq)
+      )
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+    <exit-code> 0 => 0 </exit-code>
+endmodule
diff --git a/evidence/stage1_integrity.py b/evidence/stage1_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..a2b17ffbf994680ed1e88fedc67428f5a2f7e3d5
