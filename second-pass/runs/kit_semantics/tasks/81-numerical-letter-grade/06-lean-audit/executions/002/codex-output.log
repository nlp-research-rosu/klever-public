     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py smoke.py > smoke.mpy
     6	python3 check_artifacts.py | tee artifact-check.out
     7	python3 differential.py | tee differential.out
     8	
     9	kompile reference-semantics/semantics.k \
    10	  --backend llvm \
    11	  --main-module MPY-KRUN \
    12	  --syntax-module MPY-SYNTAX \
    13	  --output-definition runtime-kompiled \
    14	  2>&1 | tee llvm-compile.out
    15	
    16	krun smoke.mpy --definition runtime-kompiled | tee concrete.out
    17	python3 - <<'PY'
    18	from pathlib import Path
    19	
    20	result = Path("concrete.out").read_text(encoding="utf-8")
    21	if "<k>\n    .K\n  </k>" not in result:
    22	    raise SystemExit("concrete execution did not finish with .K")
    23	if "<exc>\n    NoExc\n  </exc>" not in result:
    24	    raise SystemExit("concrete execution raised an exception")
    25	if "<exit-code>\n    0\n  </exit-code>" not in result:
    26	    raise SystemExit("concrete execution did not report exit code 0")
    27	print("LLVM smoke checks: PASS")
    28	PY
    29	
    30	kompile verification.k \
    31	  --backend haskell \
    32	  --main-module VERIFICATION \
    33	  --syntax-module MPY-SYNTAX \
