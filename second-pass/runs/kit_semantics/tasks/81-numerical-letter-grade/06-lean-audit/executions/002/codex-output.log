+        ">" (SortVal.inj_SortFloat g) (SortVal.inj_SortFloat f) =
+      Proof.«gradeGt(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortFloat g) f := rfl
+
+example (v : SortVal) :
