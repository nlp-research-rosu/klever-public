@@ -0,0 +1,62 @@
+import Proof
+
+namespace AuditBridgeChecks
+
+open Proof
+
+example (i : SortInt) :
+    «isGradeNumber(_)_VERIFICATION_Bool_Val» (SortVal.inj_SortInt i) = true := rfl
+
+example (f : SortFloat) :
+    «isGradeNumber(_)_VERIFICATION_Bool_Val» (SortVal.inj_SortFloat f) = true := rfl
+
+example :
+    «isGradeNumber(_)_VERIFICATION_Bool_Val» SortVal.«noneV_MPY-CORE_Val» = false := rfl
+
+example (i : SortInt) (f : SortFloat) :
+    «gradeEq(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortInt i) f =
+      match _root_.«Int2Float(_,_,_)_FLOAT_Float_Int_Int_Int» i 53 11 with
+      | some promoted => (_root_.«_==Float_» promoted f).getD false
+      | none => false := rfl
+
+example (g f : SortFloat) :
+    «gradeEq(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortFloat g) f =
+      (_root_.«_==Float_» g f).getD false := rfl
+
+example :
+    «gradeEq(_,_)_VERIFICATION_Bool_Val_Float» SortVal.«noneV_MPY-CORE_Val» 4.0 = false := rfl
+
+example (i : SortInt) (f : SortFloat) :
+    «gradeGt(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortInt i) f =
+      match _root_.«Int2Float(_,_,_)_FLOAT_Float_Int_Int_Int» i 53 11 with
+      | some promoted => (_root_.«_>Float__FLOAT_Bool_Float_Float» promoted f).getD false
+      | none => false := rfl
+
+example (g f : SortFloat) :
+    «gradeGt(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortFloat g) f =
+      (_root_.«_>Float__FLOAT_Bool_Float_Float» g f).getD false := rfl
+
+example :
+    «gradeGt(_,_)_VERIFICATION_Bool_Val_Float» SortVal.«noneV_MPY-CORE_Val» 0.0 = false := rfl
+
+example (i : SortInt) (f : SortFloat) :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+        "==" (SortVal.inj_SortInt i) (SortVal.inj_SortFloat f) =
+      «gradeEq(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortInt i) f := rfl
+
+example (g f : SortFloat) :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+        "==" (SortVal.inj_SortFloat g) (SortVal.inj_SortFloat f) =
+      «gradeEq(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortFloat g) f := rfl
+
+example (i : SortInt) (f : SortFloat) :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+        ">" (SortVal.inj_SortInt i) (SortVal.inj_SortFloat f) =
+      «gradeGt(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortInt i) f := rfl
+
+example (g f : SortFloat) :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+        ">" (SortVal.inj_SortFloat g) (SortVal.inj_SortFloat f) =
+      «gradeGt(_,_)_VERIFICATION_Bool_Val_Float» (SortVal.inj_SortFloat g) f := rfl
+
+end AuditBridgeChecks
