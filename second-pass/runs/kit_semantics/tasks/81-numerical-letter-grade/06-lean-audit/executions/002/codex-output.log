+  if (flags & O_CREAT) { va_list ap; va_start(ap, flags); mode = va_arg(ap, int); va_end(ap); }
+  log_path("open", path);
+  return (flags & O_CREAT) ? real_open(path, flags, mode) : real_open(path, flags);
+}
