+    "obligation_count": (
+        len(observed_ids)
+        == generator_manifest["obligation_count"]
+        == export_result["obligation_count"]
+        == 2
+    ),
+}
+
+print(json.dumps(checks, indent=2, sort_keys=True))
+print("all_checks", all(checks.values()))
+print("observed_ids", observed_ids)
