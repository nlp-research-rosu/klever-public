diff --git a/evidence/getpid_procfs_compat.c b/evidence/getpid_procfs_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..f41214791909f2c69b5719f1f760e5253422da83
--- /dev/null
+++ b/evidence/getpid_procfs_compat.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/*
+ * The audit sandbox uses a PID namespace while exposing a procfs mounted from
+ * its parent namespace. Lean 4.22 resolves its executable through
+ * /proc/<getpid()>/exe, so provide the procfs-visible PID from
+ * /proc/self/status.
+ */
+pid_t getpid(void) {
+    FILE *status = fopen("/proc/self/status", "r");
+    char *line = NULL;
+    size_t capacity = 0;
+    pid_t visible_pid = -1;
+    if (status != NULL) {
+        while (getline(&line, &capacity, status) != -1) {
+            if (sscanf(line, "Pid:\t%d", &visible_pid) == 1) {
+                break;
+            }
+        }
+        fclose(status);
+    }
+    free(line);
+    if (visible_pid <= 0) {
+        abort();
+    }
+    return visible_pid;
+}
diff --git a/evidence/uv_exepath_test.c b/evidence/uv_exepath_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..6a5094ac559055ddd4f7fa1df8639e7d82356f7c
--- /dev/null
+++ b/evidence/uv_exepath_test.c
@@ -0,0 +1,12 @@
+#include <stdio.h>
+int uv_exepath(char *buffer, size_t *size);
+const char *uv_err_name(int error);
+
+int main(void) {
+    char path[4096];
+    size_t size = sizeof(path);
+    int status = uv_exepath(path, &size);
+    printf("status=%d name=%s size=%zu path=%.*s\n",
+           status, uv_err_name(status), size, (int)size, path);
+    return status == 0 ? 0 : 1;
+}

