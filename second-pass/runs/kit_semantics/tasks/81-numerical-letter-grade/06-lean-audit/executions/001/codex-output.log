@@ -0,0 +1,12 @@
+#include <stdio.h>
+int uv_exepath(char *buffer, size_t *size);
+const char *uv_err_name(int error);
+
+int main(void) {
+    char path[4096];
+    size_t size = sizeof(path);
+    int status = uv_exepath(path, &size);
+    printf("status=%d name=%s size=%zu path=%.*s\n",
+           status, uv_err_name(status), size, (int)size, path);
+    return status == 0 ? 0 : 1;
+}

