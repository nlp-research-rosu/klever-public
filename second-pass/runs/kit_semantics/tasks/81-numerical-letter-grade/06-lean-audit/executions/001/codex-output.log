+  else if op = ">" then
+    match rhs with
+    | SortVal.inj_SortFloat f =>
+        if Proof.«isGradeNumber(_)_VERIFICATION_Bool_Val» lhs = true then
+          Proof.«gradeGt(_,_)_VERIFICATION_Bool_Val_Float» lhs f
+        else true
+    | _ => true
+  else true
+
+theorem counterfactualStillProvesTarget :
