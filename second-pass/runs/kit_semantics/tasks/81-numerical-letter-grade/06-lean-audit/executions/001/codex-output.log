+lean_conjunct_sha256 e8f43f073c4ce05e98c47b27ffc50c389706d120a1def9bc125eb661ea3a9f8b
+∀ (F : SortFloat) (V : SortVal)
+  (h : («isGradeNumber(_)_VERIFICATION_Bool_Val» V) = true),
