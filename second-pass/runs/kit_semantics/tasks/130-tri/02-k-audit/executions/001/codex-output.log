+++ b/evidence/ground-witness.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module AUDIT-GROUND-WITNESS
+  imports VERIFICATION
+
+  // N = 0 satisfies the entry precondition N >= 0.
+  claim [result-n0]:
+    <k> triResult(0)
+      => vCons(1, .ValSeq)
+    </k>
