/bin/bash -lc "script -q -e -c 'python3 py2mpy.py /audit-output/evidence/k_smoke.py > audit-smoke.mpy; translate_status="'$?; echo TRANSLATE_EXIT=$translate_status; kompile reference-semantics/semantics.k --backend llvm --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition fresh-runtime-kompiled; build_status=$?; echo KOMPile_EXIT=$build_status; exit $build_status'"' /audit-output/evidence/stage3-concrete-build.log" in /tmp/audit-work/reconstruction
