+  syntax Int ::= triValue(Int) [function, total]
+  syntax ValSeq ::= triPrefix(Int) [function, total]
+
+  // Parse-time aliases for the exact translated implementation.
+  syntax Expr ::= "triLoopCondition" [macro]
+  rule triLoopCondition
