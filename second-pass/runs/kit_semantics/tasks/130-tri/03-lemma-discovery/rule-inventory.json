{
  "inventory_sha256": "d86e2617188d6ba4a76b8b0d18613904c9a2b3607d2af2956cac4ffc88f494f9",
  "rules": [
    {
      "attributes": [],
      "end_line": 14,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "3016862ec9f61c9f8e250b0f2b7bfb49c3be042189fa800969cb468d8436433e",
      "source_rule_id": "rule-3016862ec9f61c9f8e250b0f2b7bfb49c3be042189fa800969cb468d8436433e",
      "start_line": 13,
      "text": "  rule triLoopCondition\n    => Compare(Name(\"i\"), CmpOp(\"<=\", Name(\"n\")))"
    },
    {
      "attributes": [],
      "end_line": 31,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "9f9771176866dbd5612151eba842e91827d249160c68380a843c6aef1508988c",
      "source_rule_id": "rule-9f9771176866dbd5612151eba842e91827d249160c68380a843c6aef1508988c",
      "start_line": 17,
      "text": "  rule triLoopBody\n    => If(Compare(Name(\"i\"), CmpOp(\"==\", Int(0))),\n          Expr(Call(Attribute(Name(\"values\"), \"append\"), Int(1))),\n          If(Compare(Name(\"i\"), CmpOp(\"==\", Int(1))),\n            Expr(Call(Attribute(Name(\"values\"), \"append\"), Int(3))),\n            If(Compare(BinOp(\"%\", Name(\"i\"), Int(2)),\n                       CmpOp(\"==\", Int(0))),\n              Expr(Call(Attribute(Name(\"values\"), \"append\"),\n                        BinOp(\"+\", Int(1),\n                                   BinOp(\"//\", Name(\"i\"), Int(2))))),\n              Expr(Call(Attribute(Name(\"values\"), \"append\"),\n                        BinOp(\"*\",\n                          BinOp(\"+\", BinOp(\"//\", Name(\"i\"), Int(2)), Int(1)),\n                          BinOp(\"+\", BinOp(\"//\", Name(\"i\"), Int(2)), Int(3))))))))\n       AugAssign(Name(\"i\"), \"+\", Int(1))"
    },
    {
      "attributes": [],
      "end_line": 38,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "f6885500f92955d6c73100a99413425dd4bb229d455cecb55bc5b5957d6a5009",
      "source_rule_id": "rule-f6885500f92955d6c73100a99413425dd4bb229d455cecb55bc5b5957d6a5009",
      "start_line": 34,
      "text": "  rule triFunctionBody\n    => Assign(Name(\"values\"), ListExpr(.Exprs))\n       Assign(Name(\"i\"), Int(0))\n       While(triLoopCondition, triLoopBody)\n       Return(Name(\"values\"))"
    },
    {
      "attributes": [],
      "end_line": 42,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "9a61ae4856ca86244da25be7fff91c03fa54438494390be30ea850d2307ae715",
      "source_rule_id": "rule-9a61ae4856ca86244da25be7fff91c03fa54438494390be30ea850d2307ae715",
      "start_line": 41,
      "text": "  rule triDefinition\n    => FuncDef(\"tri\", Params(\"n\"), triFunctionBody)"
    },
    {
      "attributes": [],
      "end_line": 52,
      "module": "VERIFICATION",
      "normalized_sha256": "c4c4c3e5c9e80b377717622978dc67aff4c417b51927335af87970b773fd0588",
      "source_rule_id": "rule-c4c4c3e5c9e80b377717622978dc67aff4c417b51927335af87970b773fd0588",
      "start_line": 51,
      "text": "  rule triValue(I:Int) => 0\n    requires I <Int 0"
    },
    {
      "attributes": [],
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "5a5bbd9741b0fac3ee8556335743164019d885260d97be6e705886321e30353f",
      "source_rule_id": "rule-5a5bbd9741b0fac3ee8556335743164019d885260d97be6e705886321e30353f",
      "start_line": 53,
      "text": "  rule triValue(I:Int)\n    => ((I -Int pyMod(I, 2)) /Int 2 +Int 1)\n       *Int ((I -Int pyMod(I, 2)) /Int 2 +Int 3)\n    requires I >=Int 0 andBool pyMod(I, 2) ==Int 1"
    },
    {
      "attributes": [],
      "end_line": 59,
      "module": "VERIFICATION",
      "normalized_sha256": "ffc8510abe57a4241fd78ba80136c4f8f98f5f04c940923109fa48e78b15dd90",
      "source_rule_id": "rule-ffc8510abe57a4241fd78ba80136c4f8f98f5f04c940923109fa48e78b15dd90",
      "start_line": 57,
      "text": "  rule triValue(I:Int)\n    => 1 +Int (I -Int pyMod(I, 2)) /Int 2\n    requires I >=Int 0 andBool pyMod(I, 2) ==Int 0"
    },
    {
      "attributes": [],
      "end_line": 65,
      "module": "VERIFICATION",
      "normalized_sha256": "c64282d33978054e893889af080d36475bf71e7dd522f6044c6888ceae6f0de2",
      "source_rule_id": "rule-c64282d33978054e893889af080d36475bf71e7dd522f6044c6888ceae6f0de2",
      "start_line": 64,
      "text": "  rule triComplete(P:ValSeq, I:Int, N:Int) => P\n    requires I >Int N"
    },
    {
      "attributes": [],
      "end_line": 71,
      "module": "VERIFICATION",
      "normalized_sha256": "503acfd8fb63e70b1dd9d242cfc57fab3e83dfb81eb352be0fec1c511cd7a37f",
      "source_rule_id": "rule-503acfd8fb63e70b1dd9d242cfc57fab3e83dfb81eb352be0fec1c511cd7a37f",
      "start_line": 66,
      "text": "  rule triComplete(P:ValSeq, I:Int, N:Int)\n    => triComplete(\n         valSeqConcat(P, vCons(triValue(I), .ValSeq)),\n         I +Int 1,\n         N)\n    requires I <=Int N"
    },
    {
      "attributes": [],
      "end_line": 73,
      "module": "VERIFICATION",
      "normalized_sha256": "a3d3f0cc205af87ab1b9b8415eeda1875352c75017b437d1ffa13cc85b1def54",
      "source_rule_id": "rule-a3d3f0cc205af87ab1b9b8415eeda1875352c75017b437d1ffa13cc85b1def54",
      "start_line": 73,
      "text": "  rule triResult(N:Int) => triComplete(.ValSeq, 0, N)"
    }
  ],
