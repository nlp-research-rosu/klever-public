     1	def tri(n):
     2	    values = []
     3	    i = 0
     4	    while i <= n:
     5	        if i == 0:
     6	            values.append(1)
     7	        elif i == 1:
     8	            values.append(3)
     9	        elif i % 2 == 0:
    10	            values.append(1 + i // 2)
    11	        else:
    12	            values.append((i // 2 + 1) * (i // 2 + 3))
    13	        i += 1
    14	    return values
