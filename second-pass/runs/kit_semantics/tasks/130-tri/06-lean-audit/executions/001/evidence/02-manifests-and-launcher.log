      "normalized_sha256": "3016862ec9f61c9f8e250b0f2b7bfb49c3be042189fa800969cb468d8436433e",
      "rationale": "Macro expansion defining the named triLoopCondition proof term as the exact comparison AST; it adds no mathematical fact or execution behavior.",
      "source_rule_id": "rule-3016862ec9f61c9f8e250b0f2b7bfb49c3be042189fa800969cb468d8436433e",
      "start_line": 13,
      "text": "  rule triLoopCondition\n    => Compare(Name(\"i\"), CmpOp(\"<=\", Name(\"n\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "9f9771176866dbd5612151eba842e91827d249160c68380a843c6aef1508988c",
      "rationale": "Macro expansion defining the named triLoopBody proof term as the exact nested branch, append, and increment AST.",
      "source_rule_id": "rule-9f9771176866dbd5612151eba842e91827d249160c68380a843c6aef1508988c",
      "start_line": 17,
      "text": "  rule triLoopBody\n    => If(Compare(Name(\"i\"), CmpOp(\"==\", Int(0))),\n          Expr(Call(Attribute(Name(\"values\"), \"append\"), Int(1))),\n          If(Compare(Name(\"i\"), CmpOp(\"==\", Int(1))),\n            Expr(Call(Attribute(Name(\"values\"), \"append\"), Int(3))),\n            If(Compare(BinOp(\"%\", Name(\"i\"), Int(2)),\n                       CmpOp(\"==\", Int(0))),\n              Expr(Call(Attribute(Name(\"values\"), \"append\"),\n                        BinOp(\"+\", Int(1),\n                                   BinOp(\"//\", Name(\"i\"), Int(2))))),\n              Expr(Call(Attribute(Name(\"values\"), \"append\"),\n                        BinOp(\"*\",\n                          BinOp(\"+\", BinOp(\"//\", Name(\"i\"), Int(2)), Int(1)),\n                          BinOp(\"+\", BinOp(\"//\", Name(\"i\"), Int(2)), Int(3))))))))\n       AugAssign(Name(\"i\"), \"+\", Int(1))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 38,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "f6885500f92955d6c73100a99413425dd4bb229d455cecb55bc5b5957d6a5009",
      "rationale": "Macro expansion defining triFunctionBody by composing initialization, the named loop syntax, and return into the exact function-body AST.",
      "source_rule_id": "rule-f6885500f92955d6c73100a99413425dd4bb229d455cecb55bc5b5957d6a5009",
      "start_line": 34,
      "text": "  rule triFunctionBody\n    => Assign(Name(\"values\"), ListExpr(.Exprs))\n       Assign(Name(\"i\"), Int(0))\n       While(triLoopCondition, triLoopBody)\n       Return(Name(\"values\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 42,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "9a61ae4856ca86244da25be7fff91c03fa54438494390be30ea850d2307ae715",
      "rationale": "Macro expansion defining triDefinition as the named function-definition AST with the required tri signature and triFunctionBody.",
      "source_rule_id": "rule-9a61ae4856ca86244da25be7fff91c03fa54438494390be30ea850d2307ae715",
      "start_line": 41,
      "text": "  rule triDefinition\n    => FuncDef(\"tri\", Params(\"n\"), triFunctionBody)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 52,
