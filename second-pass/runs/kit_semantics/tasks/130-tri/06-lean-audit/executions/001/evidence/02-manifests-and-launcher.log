      "start_line": 51,
      "text": "  rule triValue(I:Int) => 0\n    requires I <Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "5a5bbd9741b0fac3ee8556335743164019d885260d97be6e705886321e30353f",
      "rationale": "Guarded defining equation for triValue at nonnegative odd indices, using the closed-form value constructed by the program.",
      "source_rule_id": "rule-5a5bbd9741b0fac3ee8556335743164019d885260d97be6e705886321e30353f",
      "start_line": 53,
      "text": "  rule triValue(I:Int)\n    => ((I -Int pyMod(I, 2)) /Int 2 +Int 1)\n       *Int ((I -Int pyMod(I, 2)) /Int 2 +Int 3)\n    requires I >=Int 0 andBool pyMod(I, 2) ==Int 1"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 59,
      "module": "VERIFICATION",
      "normalized_sha256": "ffc8510abe57a4241fd78ba80136c4f8f98f5f04c940923109fa48e78b15dd90",
      "rationale": "Guarded defining equation for triValue at nonnegative even indices, including index zero.",
      "source_rule_id": "rule-ffc8510abe57a4241fd78ba80136c4f8f98f5f04c940923109fa48e78b15dd90",
      "start_line": 57,
      "text": "  rule triValue(I:Int)\n    => 1 +Int (I -Int pyMod(I, 2)) /Int 2\n    requires I >=Int 0 andBool pyMod(I, 2) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 65,
      "module": "VERIFICATION",
      "normalized_sha256": "c64282d33978054e893889af080d36475bf71e7dd522f6044c6888ceae6f0de2",
      "rationale": "Base equation defining triComplete to return its accumulated prefix once the current index is past the bound.",
      "source_rule_id": "rule-c64282d33978054e893889af080d36475bf71e7dd522f6044c6888ceae6f0de2",
      "start_line": 64,
      "text": "  rule triComplete(P:ValSeq, I:Int, N:Int) => P\n    requires I >Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 71,
      "module": "VERIFICATION",
      "normalized_sha256": "503acfd8fb63e70b1dd9d242cfc57fab3e83dfb81eb352be0fec1c511cd7a37f",
      "rationale": "Recursive defining equation for triComplete that appends the current triValue and advances the index while it remains within the bound.",
      "source_rule_id": "rule-503acfd8fb63e70b1dd9d242cfc57fab3e83dfb81eb352be0fec1c511cd7a37f",
      "start_line": 66,
      "text": "  rule triComplete(P:ValSeq, I:Int, N:Int)\n    => triComplete(\n         valSeqConcat(P, vCons(triValue(I), .ValSeq)),\n         I +Int 1,\n         N)\n    requires I <=Int N"
