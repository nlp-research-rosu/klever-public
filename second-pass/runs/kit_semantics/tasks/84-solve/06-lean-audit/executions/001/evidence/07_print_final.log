theorem Proof.final : Klean84Solve.Lemmas.targetStatement Proof.«_-Int_» Proof._andBool_ Proof.«_<Int_» Proof.«_<=Int_»
  Proof.«_%Int_» Proof.«_+Int_» Proof.«_/Int_» Proof.«_*Int_» :=
id
  ⟨fun Q D h =>
    have hmod :=
      Int.emod_eq_of_lt
        (Eq.mp
            (Eq.trans (Bool.and_eq_true (decide (0 ≤ D)) (decide (D < 10)))
              (congr (congrArg And decide_eq_true_eq) decide_eq_true_eq))
            h).left
        (Eq.mp
            (Eq.trans (Bool.and_eq_true (decide (0 ≤ D)) (decide (D < 10)))
              (congr (congrArg And decide_eq_true_eq) decide_eq_true_eq))
            h).right;
    have hD10 :=
      Int.add_nonneg
        (Eq.mp
            (Eq.trans (Bool.and_eq_true (decide (0 ≤ D)) (decide (D < 10)))
              (congr (congrArg And decide_eq_true_eq) decide_eq_true_eq))
            h).left
        (of_decide_eq_true (id (Eq.refl true)));
    if hc : 0 ≤ D + 10 * Q ∨ 10 ∣ D then
      of_eq_true
        (Eq.trans
          (congrArg (fun x => x = D)
            (Eq.trans
              (Eq.trans
                (congrArg (fun x => Int.tmod (x + 10) 10)
                  (Eq.trans Int.tmod_eq_emod
                    (Eq.trans
                      (congr (congrArg HSub.hSub (Eq.trans (Int.add_mul_emod_self_left D 10 Q) hmod))
                        (congrArg Nat.cast
                          (ite_cond_eq_true 0 (Int.natAbs 10)
                            (Eq.trans (congrArg (Or (0 ≤ D + 10 * Q)) Int.dvd_add_self_mul._simp_1) (eq_true hc)))))
                      (Int.sub_zero D))))
                Int.tmod_eq_emod)
              (Eq.trans
                (congr (congrArg HSub.hSub (Eq.trans (Int.add_emod_right D 10) hmod))
                  (congrArg Nat.cast
                    (ite_cond_eq_true 0 (Int.natAbs 10)
                      (Eq.trans (congrArg (fun x => x ∨ 10 ∣ D + 10) (eq_true hD10)) (true_or (10 ∣ D + 10))))))
                (Int.sub_zero D))))
          (eq_self D))
    else
      of_eq_true
        (Eq.trans
          (congrArg (fun x => x = D)
            (Eq.trans
              (Eq.trans
                (congrArg (fun x => x.tmod 10)
                  (Eq.trans
                    (congrArg (fun x => x + 10)
                      (Eq.trans Int.tmod_eq_emod
                        (congr (congrArg HSub.hSub (Eq.trans (Int.add_mul_emod_self_left D 10 Q) hmod))
                          (congrArg Nat.cast
                            (ite_cond_eq_false 0 (Int.natAbs 10)
                              (Eq.trans (congrArg (Or (0 ≤ D + 10 * Q)) Int.dvd_add_self_mul._simp_1)
                                (eq_false hc)))))))
                    (Int.sub_add_cancel D 10)))
                Int.tmod_eq_emod)
              (Eq.trans
                (congr (congrArg HSub.hSub hmod)
                  (congrArg Nat.cast
                    (ite_cond_eq_true 0 (Int.natAbs 10)
                      (Eq.trans
                        (congrArg (fun x => x ∨ 10 ∣ D)
                          (eq_true
                            (Eq.mp
                                (Eq.trans (Bool.and_eq_true (decide (0 ≤ D)) (decide (D < 10)))
                                  (congr (congrArg And decide_eq_true_eq) decide_eq_true_eq))
                                h).left))
                        (true_or (10 ∣ D))))))
                (Int.sub_zero D))))
          (eq_self D)),
    fun D Q h =>
    id
      (Eq.mpr (id (congrArg (fun _a => Int.tdiv (_a - D) 10 = Q) (Int.add_comm D (10 * Q))))
        (Eq.mpr (id (congrArg (fun _a => _a.tdiv 10 = Q) (Int.add_sub_cancel (10 * Q) D)))
          (Int.mul_tdiv_cancel_left Q (of_decide_eq_true (id (Eq.refl true))))))⟩
