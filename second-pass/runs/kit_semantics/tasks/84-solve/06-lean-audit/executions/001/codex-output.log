+  "Lbl'Unds'-Int'Unds'"
+  "Lbl'Unds'andBool'Unds'"
+  "Lbl'Unds-LT-'Int'Unds'"
+  "Lbl'Unds-LT-Eqls'Int'Unds'"
+  "Lbl'UndsPerc'Int'Unds'"
+  "Lbl'UndsPlus'Int'Unds'"
