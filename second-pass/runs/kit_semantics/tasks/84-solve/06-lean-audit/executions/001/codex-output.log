+import Proof
+
+def firstObligationAt (q d : Int) : Bool :=
+  decide (
+    Proof.«_%Int_»
+      (Proof.«_+Int_»
+        (Proof.«_%Int_» (Proof.«_+Int_» d (Proof.«_*Int_» 10 q)) 10)
+        10)
+      10 = d)
+
+def secondObligationAt (d q : Int) : Bool :=
+  decide (
+    Proof.«_/Int_»
+      (Proof.«_-Int_» (Proof.«_+Int_» d (Proof.«_*Int_» 10 q)) d)
+      10 = q)
+
+-- Boundary and negative-tail witnesses within 0 ≤ d < 10.
+#eval firstObligationAt (-100) 0
+#eval firstObligationAt (-100) 9
+#eval firstObligationAt (-1) 0
+#eval firstObligationAt (-1) 9
+#eval firstObligationAt 0 0
+#eval firstObligationAt 0 9
+#eval firstObligationAt 100 0
+#eval firstObligationAt 100 9
+
+#eval secondObligationAt 0 (-100)
+#eval secondObligationAt 9 (-100)
+#eval secondObligationAt 0 (-1)
+#eval secondObligationAt 9 (-1)
+#eval secondObligationAt 0 0
+#eval secondObligationAt 9 0
+#eval secondObligationAt 0 100
+#eval secondObligationAt 9 100
+
+-- Convenient counterfactuals are observable even when the fixed target does
+-- not always distinguish them.
+def constantFalseAnd (_ _ : Bool) : Bool := false
+def identitySub (x _ : Int) : Int := x
+
+#eval constantFalseAnd true true
+#eval decide (
+  Proof.«_/Int_»
+    (identitySub (Proof.«_+Int_» 9 (Proof.«_*Int_» 10 (-1))) 9)
+    10 = (-1))
