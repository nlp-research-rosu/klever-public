+#eval Proof._andBool_ true false
+#eval Proof._andBool_ true true
+
+#eval Proof.«_<Int_» (-7) (-6)
+#eval Proof.«_<Int_» (-7) (-7)
+#eval Proof.«_<=Int_» (-7) (-7)
+
+#eval Proof.«_%Int_» (-7) 10
+#eval Proof.«_%Int_» (-13) 10
+#eval Proof.«_%Int_» 13 10
+
+#eval Proof.«_/Int_» (-7) 10
+#eval Proof.«_/Int_» (-13) 10
+#eval Proof.«_/Int_» 13 10
+
+-- Counterfactual definitions. Euclidean remainder/division differ from K's
+-- tmod/tdiv on negative, non-divisible operands.
+def counterfactualMod (x y : Int) : Int := x % y
+def counterfactualDiv (x y : Int) : Int := x / y
+
+#eval counterfactualMod (-7) 10
+#eval counterfactualDiv (-7) 10
diff --git a//tmp/audit-work/84-solve-proof-audit-2/ObligationChecks.lean b//tmp/audit-work/84-solve-proof-audit-2/ObligationChecks.lean
