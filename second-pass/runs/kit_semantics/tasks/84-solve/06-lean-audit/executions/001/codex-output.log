+requires "domains.md"
+
+module INT-ORACLE
+  imports INT
+  imports BOOL
+
+  syntax Exp ::= "evalInt" "(" Int ")"
+               | "evalBool" "(" Bool ")"
+  configuration <k> $PGM:Exp </k>
+  rule <k> evalInt(I:Int) => I </k>
+  rule <k> evalBool(B:Bool) => B </k>
+endmodule
diff --git a/evidence/01_inventory_audit.py b/evidence/01_inventory_audit.py
