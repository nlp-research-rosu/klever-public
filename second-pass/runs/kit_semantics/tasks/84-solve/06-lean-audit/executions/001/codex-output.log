index 0000000000000000000000000000000000000000..59a135a22c4f879d4d05cdf423a118a0e02bf9ea
--- /dev/null
+++ b//tmp/audit-work/int-oracle.k
@@ -0,0 +1,12 @@
+requires "domains.md"
+
+module INT-ORACLE
+  imports INT
+  imports BOOL
+
+  syntax Exp ::= "evalInt" "(" Int ")"
+               | "evalBool" "(" Bool ")"
+  configuration <k> $PGM:Exp </k>
+  rule <k> evalInt(I:Int) => I </k>
+  rule <k> evalBool(B:Bool) => B </k>
+endmodule
