diff --git a/app_path_trace.c b/app_path_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..8b1681d8278ec4574951b54137db678f29b49a83
--- /dev/null
+++ b/app_path_trace.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  ssize_t result = real_readlink(path, buf, size);
+  fprintf(stderr, "TRACE readlink(%s, %zu) = %zd\n", path, size, result);
+  return result;
+}
+
+ssize_t readlinkat(int fd, const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (!real_readlinkat) {
+    real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  }
+  ssize_t result = real_readlinkat(fd, path, buf, size);
+  fprintf(stderr, "TRACE readlinkat(%d, %s, %zu) = %zd\n",
+          fd, path, size, result);
+  return result;
+}

