+mkdir -p "$raw"
+
+run_bounded() {
+  local name=$1
+  shift
+  local raw_log="$raw/$name.raw.log"
+  local evidence_log="$evidence/$name.log"
+  {
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+  } > "$evidence_log"
+  set +e
+  "$@" > "$raw_log" 2>&1
+  local status=$?
+  set -e
+  {
+    printf 'EXIT_STATUS=%s\n' "$status"
