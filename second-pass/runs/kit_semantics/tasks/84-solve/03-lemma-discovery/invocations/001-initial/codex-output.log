actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(set(actual_ids)) == len(actual_ids)
for src, dst in zip(inv['rules'], out['rules']):
    assert set(dst) == {'source_rule_id', 'classification', 'rationale'}
    assert dst['classification'] in allowed
    assert isinstance(dst['rationale'], str) and dst['rationale'].strip()
    if 'simplification' in src['attributes']:
        assert dst['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(r['classification'] for r in out['rules'])
