+  --spec-module BRIDGE-NEGATIVE-SPEC \
+  --claims BRIDGE-NEGATIVE-SPEC.wrong-mod \
+  > bridge-wrong-mod.log 2>&1
+wrong_mod_rc=$?
+kprove bridge-negative-spec.k \
+  --definition bridge-verification-kompiled \
+  --spec-module BRIDGE-NEGATIVE-SPEC \
