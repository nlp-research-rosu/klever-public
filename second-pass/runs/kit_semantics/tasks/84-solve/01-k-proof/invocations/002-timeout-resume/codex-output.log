+assert solve(150) == "110"\
+assert solve(147) == "1100"\
+assert solve(0) == "0"\
+assert solve(9999) == "100100"' solution.py \
+    | python3 py2mpy.py /dev/stdin) \
+  --definition runtime-kompiled
