diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..82fe983c53a28820583992af3a0c01bea84bef35
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,90 @@
+def solve(N):
+    digit_sum = N % 10
+    N = N // 10
+    digit_sum += N % 10
+    N = N // 10
+    digit_sum += N % 10
+    N = N // 10
+    digit_sum += N % 10
+    N = N // 10
+    digit_sum += N % 10
+
+    if digit_sum < 8:
+        if digit_sum == 0:
+            return "0"
+        elif digit_sum == 1:
+            return "1"
+        elif digit_sum == 2:
+            return "10"
+        elif digit_sum == 3:
+            return "11"
+        elif digit_sum == 4:
+            return "100"
+        elif digit_sum == 5:
+            return "101"
+        elif digit_sum == 6:
+            return "110"
+        else:
+            return "111"
+    elif digit_sum < 16:
+        if digit_sum == 8:
+            return "1000"
+        elif digit_sum == 9:
+            return "1001"
