+                Str("1000"),
+                Str("1001"),
+                Str("1010"),
+                Str("1011"),
+                Str("1100"),
+                Str("1101"),
+                Str("1110"),
+                Str("1111")),
+              BinOp("-", Name("digit_sum"), Int(8)))),
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(24))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("10000"),
+                Str("10001"),
+                Str("10010"),
+                Str("10011"),
+                Str("10100"),
+                Str("10101"),
+                Str("10110"),
+                Str("10111")),
