+              ListExpr(
+                Str("0"),
+                Str("1"),
+                Str("10"),
+                Str("11"),
+                Str("100"),
+                Str("101"),
+                Str("110"),
+                Str("111")),
+              Name("digit_sum"))),
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(16))),
+          Return(
+            Subscript(
