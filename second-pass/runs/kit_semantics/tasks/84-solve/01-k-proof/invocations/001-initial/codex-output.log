diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..998be90ec5da261c826481f5a81954444875e067
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,148 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Exact K AST produced from solution.py by py2mpy.py.
+  syntax Module ::= "solutionModule" [function, total]
+  rule solutionModule =>
+    // BEGIN SOLUTION MPY
+    Module(
+      FuncDef("solve", Params("N"),
+        Assign(Name("digit_sum"), BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(8))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("0"),
+                Str("1"),
+                Str("10"),
+                Str("11"),
+                Str("100"),
+                Str("101"),
+                Str("110"),
+                Str("111")),
+              Name("digit_sum"))),
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(16))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("1000"),
+                Str("1001"),
+                Str("1010"),
+                Str("1011"),
+                Str("1100"),
+                Str("1101"),
+                Str("1110"),
+                Str("1111")),
+              BinOp("-", Name("digit_sum"), Int(8)))),
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(24))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("10000"),
+                Str("10001"),
+                Str("10010"),
+                Str("10011"),
+                Str("10100"),
+                Str("10101"),
+                Str("10110"),
+                Str("10111")),
+              BinOp("-", Name("digit_sum"), Int(16)))),
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(32))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("11000"),
+                Str("11001"),
+                Str("11010"),
+                Str("11011"),
+                Str("11100"),
+                Str("11101"),
+                Str("11110"),
+                Str("11111")),
+              BinOp("-", Name("digit_sum"), Int(24)))),
+          .Stmts)
+        Return(
+          Subscript(
+            ListExpr(
+              Str("100000"),
+              Str("100001"),
+              Str("100010"),
+              Str("100011"),
+              Str("100100")),
+            BinOp("-", Name("digit_sum"), Int(32))))))
+    // END SOLUTION MPY
+
+  // Decode an ASCII code sequence as a base-two positional numeral.
+  syntax Int ::= decodeBin(IntSeq) [function, total]
+  rule decodeBin(.IntSeq) => 0
+  rule decodeBin(iCons(C, R)) =>
+    (C -Int 48) *Int (2 ^Int isLen(R)) +Int decodeBin(R)
+
+  syntax Bool ::= allBinDigits(IntSeq) [function, total]
+  rule allBinDigits(.IntSeq) => true
+  rule allBinDigits(iCons(C, R)) =>
+    (C ==Int 48 orBool C ==Int 49) andBool allBinDigits(R)
+
+  // "0", or a nonempty sequence beginning with "1" and containing only bits.
+  syntax Bool ::= canonicalBin(IntSeq) [function, total]
+  rule canonicalBin(iCons(48, .IntSeq)) => true
+  rule canonicalBin(iCons(49, R)) => allBinDigits(R)
+  rule canonicalBin(_:IntSeq) => false [owise]
+
+  // Symbolic decimal decomposition used to parameterize exactly 0..10000.
+  syntax Bool ::= digitDomain(Int, Int, Int, Int, Int) [function, total]
+  rule digitDomain(D0, D1, D2, D3, D4) =>
+       0 <=Int D0 andBool D0 <Int 10
+    andBool 0 <=Int D1 andBool D1 <Int 10
+    andBool 0 <=Int D2 andBool D2 <Int 10
+    andBool 0 <=Int D3 andBool D3 <Int 10
+    andBool 0 <=Int D4 andBool D4 <=Int 1
+    andBool
+      (D4 ==Int 0
+       orBool
+       (D4 ==Int 1
+        andBool D0 ==Int 0
+        andBool D1 ==Int 0
+        andBool D2 ==Int 0
+        andBool D3 ==Int 0))
+
+  syntax Bool ::= decimalLayout(
+    Int, Int, Int, Int, Int, Int, Int, Int, Int, Int
+  ) [function, total]
+  rule decimalLayout(N, Q1, Q2, Q3, Q4, D0, D1, D2, D3, D4) =>
+       N  ==Int D0 +Int 10 *Int D1 +Int 100 *Int D2
+                    +Int 1000 *Int D3 +Int 10000 *Int D4
+    andBool Q1 ==Int D1 +Int 10 *Int D2 +Int 100 *Int D3 +Int 1000 *Int D4
+    andBool Q2 ==Int D2 +Int 10 *Int D3 +Int 100 *Int D4
+    andBool Q3 ==Int D3 +Int 10 *Int D4
+    andBool Q4 ==Int D4
+
+  syntax Bool ::= decimalStepFacts(
+    Int, Int, Int, Int, Int, Int, Int, Int, Int, Int
+  ) [function, total]
+  rule decimalStepFacts(N, Q1, Q2, Q3, Q4, D0, D1, D2, D3, D4) =>
+       pyMod(N, 10) ==Int D0
+    andBool (N -Int pyMod(N, 10)) /Int 10 ==Int Q1
+    andBool pyMod(Q1, 10) ==Int D1
+    andBool (Q1 -Int pyMod(Q1, 10)) /Int 10 ==Int Q2
+    andBool pyMod(Q2, 10) ==Int D2
+    andBool (Q2 -Int pyMod(Q2, 10)) /Int 10 ==Int Q3
+    andBool pyMod(Q3, 10) ==Int D3
+    andBool (Q3 -Int pyMod(Q3, 10)) /Int 10 ==Int Q4
+    andBool pyMod(Q4, 10) ==Int D4
+endmodule

