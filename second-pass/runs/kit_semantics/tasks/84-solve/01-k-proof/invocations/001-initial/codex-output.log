+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(8))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("0"),
+                Str("1"),
+                Str("10"),
+                Str("11"),
+                Str("100"),
+                Str("101"),
+                Str("110"),
+                Str("111")),
+              Name("digit_sum"))),
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(16))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("1000"),
+                Str("1001"),
+                Str("1010"),
+                Str("1011"),
+                Str("1100"),
+                Str("1101"),
+                Str("1110"),
+                Str("1111")),
+              BinOp("-", Name("digit_sum"), Int(8)))),
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(24))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("10000"),
+                Str("10001"),
+                Str("10010"),
+                Str("10011"),
+                Str("10100"),
+                Str("10101"),
+                Str("10110"),
+                Str("10111")),
+              BinOp("-", Name("digit_sum"), Int(16)))),
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp("<", Int(32))),
+          Return(
+            Subscript(
+              ListExpr(
+                Str("11000"),
+                Str("11001"),
+                Str("11010"),
+                Str("11011"),
+                Str("11100"),
+                Str("11101"),
+                Str("11110"),
+                Str("11111")),
