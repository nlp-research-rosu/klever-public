+             D0:Int +Int 10 *Int
+               (D1:Int +Int 10 *Int
+                 (D2:Int +Int 10 *Int
+                   (D3:Int +Int 10 *Int D4:Int))))
+      =>
+      str(?CODES:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?SCOPELOC:Int </scopeLoc>
