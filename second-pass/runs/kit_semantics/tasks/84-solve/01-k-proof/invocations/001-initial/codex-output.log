+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(
+          Name("binary"),
+          ListExpr(
+            Str("0"),
+            Str("1"),
+            Str("10"),
+            Str("11"),
+            Str("100"),
+            Str("101"),
+            Str("110"),
+            Str("111"),
+            Str("1000"),
+            Str("1001"),
+            Str("1010"),
+            Str("1011"),
