+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [solve-full-domain]:
+    <k>
+      #loadAll(solutionModule)
+        ~> Call(
+             Name("solve"),
+             D0:Int
+               +Int 10 *Int D1:Int
+               +Int 100 *Int D2:Int
+               +Int 1000 *Int D3:Int
+               +Int 10000 *Int D4:Int)
+      =>
+      str(?CODES:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?SCOPELOC:Int </scopeLoc>
+    <heap> .Map => ?HEAP:Map </heap>
+    <heapLoc> 0 => ?HEAPLOC:Int </heapLoc>
+    <stack> .List => ?STACK:List </stack>
+    <ret> noRet => ?RET:RetState </ret>
+    <exc> NoExc => ?EXC:Exc </exc>
+    <exit-code> 0 => ?EXIT:Int </exit-code>
+    requires 0 <=Int D0 andBool D0 <Int 10
+        andBool 0 <=Int D1 andBool D1 <Int 10
+        andBool 0 <=Int D2 andBool D2 <Int 10
+        andBool 0 <=Int D3 andBool D3 <Int 10
+        andBool 0 <=Int D4 andBool D4 <=Int 1
+        andBool
+          (D4 ==Int 0
+           orBool
+           (D4 ==Int 1
+            andBool D0 ==Int 0
+            andBool D1 ==Int 0
+            andBool D2 ==Int 0
+            andBool D3 ==Int 0))
+    ensures canonicalBin(?CODES)
+        andBool decodeBin(?CODES)
+          ==Int D0 +Int D1 +Int D2 +Int D3 +Int D4
+endmodule
