index 0000000000000000000000000000000000000000..19b6f9e463c1ab37092778d833447e826a3e1952
--- /dev/null
+++ b/bridge-spec.k
@@ -0,0 +1,21 @@
+requires "bridge-verification.k"
+
+module BRIDGE-SPEC
