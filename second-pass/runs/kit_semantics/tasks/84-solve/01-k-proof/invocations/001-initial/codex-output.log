+    <k>
+      #loadAll(solutionModule)
+        ~> Call(
+             Name("solve"),
+             D0:Int
+               +Int 10 *Int D1:Int
+               +Int 100 *Int D2:Int
+               +Int 1000 *Int D3:Int
+               +Int 10000 *Int D4:Int)
+      =>
+      str(?CODES:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?SCOPES:Map
+    </scopes>
