+def solve(N):
+    digit_sum = N % 10
+    N = N // 10
+    digit_sum += N % 10
+    N = N // 10
+    digit_sum += N % 10
+    N = N // 10
+    digit_sum += N % 10
+    N = N // 10
+    digit_sum += N % 10
+
+    if digit_sum < 8:
+        return [
