+++ b/spec.k
@@ -0,0 +1,174 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [digit-sum-bound]:
+    <k> .K => .K </k>
+    requires digitDomain(D0, D1, D2, D3, D4)
+    ensures 0 <=Int D0 +Int D1 +Int D2 +Int D3 +Int D4
+        andBool D0 +Int D1 +Int D2 +Int D3 +Int D4 <=Int 36
+
+  claim [solve-sum-00-07]:
+    <k>
+      #loadAll(solutionModule)
+        ~> Call(
+             Name("solve"),
+             D0:Int +Int 10 *Int
+               (D1:Int +Int 10 *Int
+                 (D2:Int +Int 10 *Int
+                   (D3:Int +Int 10 *Int D4:Int))))
+      =>
+      str(?CODES:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?SCOPELOC:Int </scopeLoc>
+    <heap> .Map => ?HEAP:Map </heap>
+    <heapLoc> 0 => ?HEAPLOC:Int </heapLoc>
+    <stack> .List => ?STACK:List </stack>
+    <ret> noRet => ?RET:RetState </ret>
