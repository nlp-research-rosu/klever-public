diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..757c64c0b88ba6af04f58d071f55448de38500e5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,95 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Exact K AST produced from solution.py by py2mpy.py.
+  syntax Module ::= "solutionModule" [function, total]
+  rule solutionModule =>
+    // BEGIN SOLUTION MPY
+    Module(
+      FuncDef("solve", Params("N"),
+        Assign(Name("digit_sum"), BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(Name("N"), BinOp("//", Name("N"), Int(10)))
+        AugAssign(Name("digit_sum"), "+", BinOp("%", Name("N"), Int(10)))
+        Assign(
+          Name("binary"),
+          ListExpr(
+            Str("0"),
+            Str("1"),
+            Str("10"),
+            Str("11"),
+            Str("100"),
+            Str("101"),
+            Str("110"),
+            Str("111"),
+            Str("1000"),
+            Str("1001"),
+            Str("1010"),
+            Str("1011"),
+            Str("1100"),
+            Str("1101"),
+            Str("1110"),
+            Str("1111"),
+            Str("10000"),
+            Str("10001"),
+            Str("10010"),
+            Str("10011"),
+            Str("10100"),
+            Str("10101"),
+            Str("10110"),
+            Str("10111"),
+            Str("11000"),
+            Str("11001"),
+            Str("11010"),
+            Str("11011"),
+            Str("11100"),
+            Str("11101"),
+            Str("11110"),
+            Str("11111"),
+            Str("100000"),
+            Str("100001"),
+            Str("100010"),
+            Str("100011"),
+            Str("100100")))
+        Return(Subscript(Name("binary"), Name("digit_sum")))))
+    // END SOLUTION MPY
+
+  // Python's floor quotient by ten, expressed exactly as MPY-INT defines //.
+  syntax Int ::= q10(Int) [function, total]
+  rule q10(N) => (N -Int pyMod(N, 10)) /Int 10
+
+  // Five decimal positions suffice on the complete contract domain 0..10000.
+  syntax Int ::= digitSum5(Int) [function, total]
+  rule digitSum5(N) =>
+      pyMod(N, 10)
+    +Int pyMod(q10(N), 10)
+    +Int pyMod(q10(q10(N)), 10)
+    +Int pyMod(q10(q10(q10(N))), 10)
+    +Int pyMod(q10(q10(q10(q10(N)))), 10)
+
+  // Decode an ASCII code sequence as a base-two positional numeral.
+  syntax Int ::= decodeBin(IntSeq) [function, total]
+  rule decodeBin(.IntSeq) => 0
+  rule decodeBin(iCons(C, R)) =>
+    (C -Int 48) *Int (2 ^Int isLen(R)) +Int decodeBin(R)
+
+  syntax Bool ::= allBinDigits(IntSeq) [function, total]
+  rule allBinDigits(.IntSeq) => true
+  rule allBinDigits(iCons(C, R)) =>
+    (C ==Int 48 orBool C ==Int 49) andBool allBinDigits(R)
+
+  // "0", or a nonempty sequence beginning with "1" and containing only bits.
+  syntax Bool ::= canonicalBin(IntSeq) [function, total]
+  rule canonicalBin(iCons(48, .IntSeq)) => true
+  rule canonicalBin(iCons(49, R)) => allBinDigits(R)
+  rule canonicalBin(_:IntSeq) => false [owise]
+endmodule

