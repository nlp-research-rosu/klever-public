+                Str("11000"),
+                Str("11001"),
+                Str("11010"),
+                Str("11011"),
+                Str("11100"),
+                Str("11101"),
+                Str("11110"),
+                Str("11111")),
+              BinOp("-", Name("digit_sum"), Int(24)))),
+          .Stmts)
+        Return(
