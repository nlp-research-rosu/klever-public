--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,49 @@
+requires "connection.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  claim [strip-char-ws]:
+    <k>
+      applyCmp(
+        "==",
+        str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq)))))),
+        str(.IntSeq))
+      =>
+      true
+    </k>
+    requires isWSC(C)
+
+  claim [strip-char-nonws]:
+    <k>
+      applyCmp(
+        "==",
+        str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq)))))),
+        str(.IntSeq))
+      =>
+      false
+    </k>
+    requires notBool isWSC(C)
+
+  claim [strip-char-ne-ws]:
+    <k>
+      applyCmp(
+        "!=",
+        str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq)))))),
+        str(.IntSeq))
+      =>
+      false
+    </k>
+    requires isWSC(C)
+
+  claim [strip-char-ne-nonws]:
+    <k>
+      applyCmp(
+        "!=",
+        str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq)))))),
+        str(.IntSeq))
+      =>
+      true
+    </k>
+    requires notBool isWSC(C)
+endmodule
