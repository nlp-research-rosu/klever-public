+    <exit-code> 0 </exit-code>
+
+  // Exact public binding, body, argument, caller environment, and state.
+  claim [is-bored]:
+    <k>
+      Call(Name("is_bored"), (str(IS:IntSeq), .Exprs))
+      => boredoms(IS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "is_bored" |-> closureVal(
+          ("S", .ParamNames),
+          BORED-FUNCTION-BODY,
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
