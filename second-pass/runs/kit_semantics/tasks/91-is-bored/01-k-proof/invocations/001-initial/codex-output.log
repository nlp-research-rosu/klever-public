+requires "connection.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  claim [strip-eq-ws]:
+    <k>
+      Compare(
+        Call(Attribute(Name("c"), "strip"), .Exprs),
+        CmpOp("==", Str("")))
+      =>
+      true
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ("c" |-> str(iCons(C:Int, .IntSeq))) M:Map,
+        PARENT:Parent)
+      ...
+    </scopes>
+    requires notBool ("c" in_keys(M))
+     andBool isWSC(C)
+
+  claim [strip-eq-nonws]:
+    <k>
+      Compare(
+        Call(Attribute(Name("c"), "strip"), .Exprs),
+        CmpOp("==", Str("")))
+      =>
+      false
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ("c" |-> str(iCons(C:Int, .IntSeq))) M:Map,
+        PARENT:Parent)
+      ...
+    </scopes>
+    requires notBool ("c" in_keys(M))
+     andBool notBool isWSC(C)
+
+  claim [strip-ne-ws]:
+    <k>
+      Compare(
+        Call(Attribute(Name("c"), "strip"), .Exprs),
+        CmpOp("!=", Str("")))
+      =>
+      false
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ("c" |-> str(iCons(C:Int, .IntSeq))) M:Map,
+        PARENT:Parent)
+      ...
+    </scopes>
+    requires notBool ("c" in_keys(M))
+     andBool isWSC(C)
+
+  claim [strip-ne-nonws]:
+    <k>
+      Compare(
+        Call(Attribute(Name("c"), "strip"), .Exprs),
+        CmpOp("!=", Str("")))
+      =>
+      true
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ("c" |-> str(iCons(C:Int, .IntSeq))) M:Map,
+        PARENT:Parent)
+      ...
+    </scopes>
+    requires notBool ("c" in_keys(M))
+     andBool notBool isWSC(C)
+endmodule
