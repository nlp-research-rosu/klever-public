+          "count"     |-> N:Int
+          "at_start"  |-> A:Bool
+          "pending_i" |-> P:Bool
+          "c"         |-> str(iCons(32, .IntSeq)) ),
+        parent(0))
+      ...
+    </scopes>
+endmodule
