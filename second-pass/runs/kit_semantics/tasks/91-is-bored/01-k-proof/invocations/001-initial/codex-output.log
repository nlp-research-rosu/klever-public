+        ( "S"         |-> str(ORIG:IntSeq)
+          "count"     |-> N:Int
+          "at_start"  |-> A:Bool
+          "pending_i" |-> P:Bool
+          "c"         |-> str(iCons(C:Int, .IntSeq)) ),
