+  claim [loop]:
+    <k>
+      #loop(str(IS:IntSeq), Name("c"), BORED-LOOP-BODY)
+      ~> If(
+           Name("pending_i"),
+           AugAssign(Name("count"), "+", Int(1)) .Stmts,
+           .Stmts)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => scanResult(IS, N:Int, A:Bool, P:Bool)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            BORED-FUNCTION-BODY,
+            0),
+          parent(-1))
+        -1 |-> builtinsScope
+        1 |-> scope(
+          ( "S"         |-> str(ORIG:IntSeq)
+            "count"     |-> N
+            "at_start"  |-> A
+            "pending_i" |-> P
+            "c"         |-> str(CUR:IntSeq) ),
+          parent(0)) )
+      =>
