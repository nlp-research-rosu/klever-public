+            "at_start"  |-> A
+            "pending_i" |-> P
+            "c"         |-> str(CUR:IntSeq) ),
+          parent(0)) )
+      =>
+      ( 0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            BORED-FUNCTION-BODY,
+            0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
