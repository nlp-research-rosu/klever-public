+      =>
+      str(.IntSeq)
+      ...
+    </k>
+    requires isWSC(C)
+
+  claim [strip-value-nonws]:
+    <k>
+      str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq))))))
+      =>
+      str(iCons(C, .IntSeq))
+      ...
+    </k>
+    requires notBool isWSC(C)
+
+  claim [strip-char-ws]:
+    <k>
+      Compare(
+        str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq)))))),
+        CmpOp("==", str(.IntSeq)))
+      =>
+      true
+      ...
+    </k>
+    requires isWSC(C)
+
+  claim [strip-char-nonws]:
+    <k>
+      Compare(
+        str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq)))))),
+        CmpOp("==", str(.IntSeq)))
+      =>
+      false
+      ...
+    </k>
+    requires notBool isWSC(C)
+
+  claim [strip-char-ne-ws]:
+    <k>
+      Compare(
+        str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq)))))),
+        CmpOp("!=", str(.IntSeq)))
+      =>
+      false
+      ...
+    </k>
+    requires isWSC(C)
+
+  claim [strip-char-ne-nonws]:
+    <k>
+      Compare(
+        str(revIS(trimWS(revIS(trimWS(iCons(C:Int, .IntSeq)))))),
+        CmpOp("!=", str(.IntSeq)))
+      =>
+      true
+      ...
+    </k>
+    requires notBool isWSC(C)
+endmodule
