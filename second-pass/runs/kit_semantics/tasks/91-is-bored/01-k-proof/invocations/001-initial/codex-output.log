@@ -0,0 +1,52 @@
+requires "verification-base.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-BASE
+
+  // Bridge-free universal connection theorem for the exact loop bridge in
+  // verification.k.  This is the genuine coinductive loop proof.
+  claim [loop]:
+    <k>
+      #loop(str(IS:IntSeq), Name("c"), BORED-LOOP-BODY)
+      ~> ( If(
+             Name("pending_i"),
+             AugAssign(Name("count"), "+", Int(1)) .Stmts,
+             .Stmts)
+           Return(Name("count"))
+           .Stmts )
+      ~> #endcall
+      => scanResult(IS, N:Int, A:Bool, P:Bool)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            BORED-FUNCTION-BODY,
+            0),
+          parent(-1))
+        -1 |-> B:Scope
+        1 |-> scope(
+          ( "S"         |-> str(ORIG:IntSeq)
+            "count"     |-> N
+            "at_start"  |-> A
+            "pending_i" |-> P
+            "c"         |-> str(CUR:IntSeq) ),
+          parent(0)) )
+      =>
+      ( 0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            BORED-FUNCTION-BODY,
+            0),
+          parent(-1))
+        -1 |-> B )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/model-boundary.py b/model-boundary.py
new file mode 100644
index 0000000000000000000000000000000000000000..1392adc612ff8ea5ba856f9257baf5e8e7c61489
--- /dev/null
+++ b/model-boundary.py
@@ -0,0 +1,32 @@
+def is_bored(S):
+    count = 0
+    at_start = True
+    pending_i = False
+    c = ""
+
+    for c in S:
+        if c == "." or c == "?" or c == "!":
+            if pending_i:
+                count += 1
+            at_start = True
+            pending_i = False
+        elif at_start:
+            if c.strip() != "":
+                if c == "I":
+                    at_start = False
+                    pending_i = True
+                else:
+                    at_start = False
+        elif pending_i:
+            if c.strip() == "":
+                count += 1
+            pending_i = False
+
+    if pending_i:
+        count += 1
+
+    return count
+
+
+# MPY's isWSC omits vertical tab, so the supplied semantics returns zero here.
+assert is_bored("I\vwork") == 0
diff --git a/mutation-spec.k b/mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e2705d6a1235a45f1ae109c3e40e031cf910ac31
--- /dev/null
+++ b/mutation-spec.k
@@ -0,0 +1,51 @@
+requires "mutation.k"
+
+module MUTATION-SPEC
+  imports MUTATION
+
+  // The original summary must not prove for the mutated empty body.
+  claim [mutated-loop]:
+    <k>
+      #loop(str(IS:IntSeq), Name("c"), MUTATED-LOOP-BODY)
+      ~> ( If(
+             Name("pending_i"),
+             AugAssign(Name("count"), "+", Int(1)) .Stmts,
+             .Stmts)
+           Return(Name("count"))
+           .Stmts )
+      ~> #endcall
+      => scanResult(IS, N:Int, A:Bool, P:Bool)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            BORED-FUNCTION-BODY,
+            0),
+          parent(-1))
+        -1 |-> B:Scope
+        1 |-> scope(
+          ( "S"         |-> str(ORIG:IntSeq)
+            "count"     |-> N
+            "at_start"  |-> A
+            "pending_i" |-> P
+            "c"         |-> str(CUR:IntSeq) ),
+          parent(0)) )
+      =>
+      ( 0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            BORED-FUNCTION-BODY,
+            0),
+          parent(-1))
+        -1 |-> B )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/mutation.k b/mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..ca6899a1808a230795f19dd4f6b75bf8ff0e807d
--- /dev/null
+++ b/mutation.k
@@ -0,0 +1,9 @@
+requires "verification-base.k"
+
+module MUTATION
+  imports VERIFICATION-BASE
+
+  // Material body mutation: the loop deliberately does nothing.
+  syntax Stmts ::= "MUTATED-LOOP-BODY" [macro]
+  rule MUTATED-LOOP-BODY => .Stmts
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a50a34265dd6a76f947eafd525c2e974d6dcf88
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,35 @@
+def is_bored(S):
+    count = 0
+    at_start = True
+    pending_i = False
+    c = ""
+
+    for c in S:
+        if c == "." or c == "?" or c == "!":
+            if pending_i:
+                count += 1
+            at_start = True
+            pending_i = False
+        elif at_start:
+            if c.strip() != "":
+                if c == "I":
+                    at_start = False
+                    pending_i = True
+                else:
+                    at_start = False
+        elif pending_i:
+            if c.strip() == "":
+                count += 1
+            pending_i = False
+
+    if pending_i:
+        count += 1
+
+    return count
+
+
+assert is_bored("Hello world") == 0
+assert is_bored("The sky is blue. The sun is shining. I love this weather") == 1
+assert is_bored("I am. You are! I? Idea. \tI\nagree") == 3
+assert is_bored("You and I are going for a walk") == 0
+assert is_bored("I") == 1
