diff --git a/connection.k b/connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..884ea6be258e5799d1e02be97753442065bd43f8
--- /dev/null
+++ b/connection.k
@@ -0,0 +1,6 @@
+requires "reference-semantics/semantics.k"
+
+// Bridge-free definition used only to prove the strip-comparison connection.
+module CONNECTION
+  imports MPY
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a50a34265dd6a76f947eafd525c2e974d6dcf88
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,35 @@
+def is_bored(S):
+    count = 0
+    at_start = True
+    pending_i = False
+    c = ""
+
+    for c in S:
+        if c == "." or c == "?" or c == "!":
+            if pending_i:
+                count += 1
+            at_start = True
+            pending_i = False
+        elif at_start:
+            if c.strip() != "":
+                if c == "I":
+                    at_start = False
+                    pending_i = True
+                else:
+                    at_start = False
+        elif pending_i:
+            if c.strip() == "":
+                count += 1
+            pending_i = False
+
+    if pending_i:
+        count += 1
+
+    return count
+
+
+assert is_bored("Hello world") == 0
+assert is_bored("The sky is blue. The sun is shining. I love this weather") == 1
+assert is_bored("I am. You are! I? Idea. \tI\nagree") == 3
+assert is_bored("You and I are going for a walk") == 0
+assert is_bored("I") == 1
