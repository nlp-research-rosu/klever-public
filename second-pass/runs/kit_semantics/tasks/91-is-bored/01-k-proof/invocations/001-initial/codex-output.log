+      Compare(
+        Call(Attribute(Name("c"), "upper"), .Exprs),
+        CmpOp("==", Str("")))
+      =>
+      true
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ... 1 |-> scope(
+        ( "S"         |-> str(ORIG:IntSeq)
+          "count"     |-> N:Int
+          "at_start"  |-> A:Bool
+          "pending_i" |-> P:Bool
+          "c"         |-> str(iCons(32, .IntSeq)) ),
+        parent(0))
+      ...
+    </scopes>
+endmodule
