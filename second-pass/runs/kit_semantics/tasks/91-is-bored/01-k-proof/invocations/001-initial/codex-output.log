+    => Assign(Name("count"), Int(0))
+       Assign(Name("at_start"), Bool(true))
+       Assign(Name("pending_i"), Bool(false))
+       Assign(Name("c"), Str(""))
+       For(Name("c"), Name("S"), BORED-LOOP-BODY)
+       If(
+         Name("pending_i"),
+         AugAssign(Name("count"), "+", Int(1)) .Stmts,
+         .Stmts)
+       Return(Name("count"))
+       .Stmts
+
+  // Mathematical scanner state: accumulated count, still at sentence start,
+  // and "the first non-whitespace character was I, awaiting its boundary".
+  syntax ScanState ::= scanState(Int, Bool, Bool)
+
+  syntax Bool ::= isDelimiter(Int) [function, total]
+  rule isDelimiter(C)
+    => C ==Int 46 orBool C ==Int 63 orBool C ==Int 33
+
+  syntax Int ::= flag(Bool) [function, total]
+  rule flag(true)  => 1
+  rule flag(false) => 0
+
+  // Exact fixed-semantics characterization of `c.strip() == ""` for the
+  // one-code-point strings produced by MPY string iteration.
+  syntax Bool ::= charIsWhitespace(Int) [macro]
+  rule charIsWhitespace(C)
+    => .IntSeq ==K revIS(trimWS(revIS(trimWS(iCons(C, .IntSeq)))))
+
+  // One input-character transition.  The guards are disjoint and exhaustive.
+  syntax ScanState ::= scanStep(Int, ScanState) [function, total]
+
+  rule scanStep(C, scanState(N, A, P))
+    => scanState(N +Int flag(P), true, false)
+    requires isDelimiter(C)
+
+  rule scanStep(C, scanState(N, true, P))
+    => scanState(N, true, P)
+    requires notBool isDelimiter(C)
+     andBool charIsWhitespace(C)
+
+  rule scanStep(C, scanState(N, true, P))
+    => scanState(N, false, true)
+    requires notBool isDelimiter(C)
+     andBool notBool charIsWhitespace(C)
+     andBool C ==Int 73
+
+  rule scanStep(C, scanState(N, true, P))
+    => scanState(N, false, P)
+    requires notBool isDelimiter(C)
+     andBool notBool charIsWhitespace(C)
+     andBool C =/=Int 73
+
+  rule scanStep(C, scanState(N, false, true))
+    => scanState(N +Int 1, false, false)
+    requires notBool isDelimiter(C)
+     andBool charIsWhitespace(C)
+
+  rule scanStep(C, scanState(N, false, true))
+    => scanState(N, false, false)
+    requires notBool isDelimiter(C)
+     andBool notBool charIsWhitespace(C)
+
+  rule scanStep(C, scanState(N, false, false))
+    => scanState(N, false, false)
+    requires notBool isDelimiter(C)
+
+  // Structurally recursive fold over every finite IntSeq represented by MPY.
+  syntax ScanState ::= scan(IntSeq, ScanState) [function, total]
+  rule scan(.IntSeq, ST) => ST
+  rule scan(iCons(C, REST), ST) => scan(REST, scanStep(C, ST))
+
+  // The post-loop if-statement counts an I that reaches end-of-input.
+  syntax Int ::= finishScan(ScanState) [function, total]
+  rule finishScan(scanState(N, A, P)) => N +Int flag(P)
+
+  syntax Int ::= scanResult(IntSeq, Int, Bool, Bool) [function, total]
+  rule scanResult(IS, N, A, P)
+    => finishScan(scan(IS, scanState(N, A, P)))
+
+  syntax Int ::= boredoms(IntSeq) [function, total]
+  rule boredoms(IS) => scanResult(IS, 0, true, false)
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled >/tmp/is-bored-kompile.log 2>&1 && kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop' in /workspace
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a50a34265dd6a76f947eafd525c2e974d6dcf88
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,35 @@
+def is_bored(S):
+    count = 0
+    at_start = True
+    pending_i = False
+    c = ""
+
+    for c in S:
+        if c == "." or c == "?" or c == "!":
+            if pending_i:
+                count += 1
+            at_start = True
+            pending_i = False
+        elif at_start:
+            if c.strip() != "":
+                if c == "I":
+                    at_start = False
+                    pending_i = True
+                else:
+                    at_start = False
+        elif pending_i:
+            if c.strip() == "":
+                count += 1
+            pending_i = False
+
+    if pending_i:
+        count += 1
+
+    return count
+
+
+assert is_bored("Hello world") == 0
+assert is_bored("The sky is blue. The sun is shining. I love this weather") == 1
+assert is_bored("I am. You are! I? Idea. \tI\nagree") == 3
+assert is_bored("You and I are going for a walk") == 0
+assert is_bored("I") == 1
