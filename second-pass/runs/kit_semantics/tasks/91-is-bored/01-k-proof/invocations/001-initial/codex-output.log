+    <env> 1 </env>
+    <scopes>
+      ... 1 |-> scope(
+        ( "S"         |-> str(ORIG:IntSeq)
+          "count"     |-> N:Int
+          "at_start"  |-> A:Bool
+          "pending_i" |-> P:Bool
+          "c"         |-> str(iCons(32, .IntSeq)) ),
+        parent(0))
+      ...
+    </scopes>
+endmodule
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..292de5e53378b1418ab5fde4c8c734ca1033a4e6
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,93 @@
+requires "connection.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  claim [strip-eq-ws]:
