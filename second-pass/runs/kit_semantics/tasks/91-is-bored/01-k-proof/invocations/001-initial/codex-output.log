diff --git a/model-boundary.py b/model-boundary.py
new file mode 100644
index 0000000000000000000000000000000000000000..1392adc612ff8ea5ba856f9257baf5e8e7c61489
--- /dev/null
+++ b/model-boundary.py
@@ -0,0 +1,32 @@
+def is_bored(S):
+    count = 0
+    at_start = True
+    pending_i = False
+    c = ""
+
+    for c in S:
+        if c == "." or c == "?" or c == "!":
+            if pending_i:
+                count += 1
+            at_start = True
+            pending_i = False
+        elif at_start:
+            if c.strip() != "":
+                if c == "I":
+                    at_start = False
+                    pending_i = True
+                else:
+                    at_start = False
+        elif pending_i:
+            if c.strip() == "":
+                count += 1
+            pending_i = False
+
+    if pending_i:
+        count += 1
+
+    return count
+
+
+# MPY's isWSC omits vertical tab, so the supplied semantics returns zero here.
+assert is_bored("I\vwork") == 0
