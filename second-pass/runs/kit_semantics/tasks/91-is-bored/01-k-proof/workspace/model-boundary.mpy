Module(
  FuncDef("is_bored", Params("S"),
    Assign(Name("count"), Int(0))
    Assign(Name("at_start"), Bool(true))
    Assign(Name("pending_i"), Bool(false))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("S"),
      If(BoolOp(
        "or",
        Compare(Name("c"), CmpOp("==", Str("."))),
        Compare(Name("c"), CmpOp("==", Str("?"))),
        Compare(Name("c"), CmpOp("==", Str("!")))),
        If(Name("pending_i"),
          AugAssign(Name("count"), "+", Int(1)),
          )
        Assign(Name("at_start"), Bool(true))
        Assign(Name("pending_i"), Bool(false)),
        If(Name("at_start"),
          If(Compare(
            Call(Attribute(Name("c"), "strip"), ),
            CmpOp("!=", Str(""))),
            If(Compare(Name("c"), CmpOp("==", Str("I"))),
              Assign(Name("at_start"), Bool(false))
              Assign(Name("pending_i"), Bool(true)),
              Assign(Name("at_start"), Bool(false))),
            ),
          If(Name("pending_i"),
            If(Compare(
              Call(Attribute(Name("c"), "strip"), ),
              CmpOp("==", Str(""))),
              AugAssign(Name("count"), "+", Int(1)),
              )
            Assign(Name("pending_i"), Bool(false)),
            ))))
    If(Name("pending_i"),
      AugAssign(Name("count"), "+", Int(1)),
      )
    Return(Name("count")))
  Assert(
    Compare(
      Call(Name("is_bored"), Str("I\u000bwork")),
      CmpOp("==", Int(0)))))
