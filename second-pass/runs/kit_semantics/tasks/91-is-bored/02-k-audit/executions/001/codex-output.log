     5	
     6	def is_bored(S):
     7	    """
     8	    You'll be given a string of words, and your task is to count the number
     9	    of boredoms. A boredom is a sentence that starts with the word "I".
    10	    Sentences are delimited by '.', '?' or '!'.
    11	   
    12	    For example:
    13	    >>> is_bored("Hello world")
    14	    0
    15	    >>> is_bored("The sky is blue. The sun is shining. I love this weather")
    16	    1
    17	    """
    18	    import re
    19	    sentences = re.split(r'[.?!]\s*', S)
    20	    return sum(sentence[0:2] == 'I ' for sentence in sentences)

