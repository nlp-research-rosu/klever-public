+    diff -u "$scratch/audit-solution.kore" "$scratch/audit-proof-program.kore"
+  fi
+  exit "$ec"
+) > /audit-output/evidence/stage4_kore_identity.log 2>&1
+ec=$?
+if [[ $ec -ne 0 ]]; then overall=1; fi
+
+printf 'FINAL_STATUS=%d\n' "$overall"
+exit "$overall"
