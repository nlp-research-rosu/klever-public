+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/case91
+overall=0
+
+printf 'COMMAND: cp /audit-output/evidence/stage4-witness-spec.k %s/stage4-witness-spec.k\n' "$scratch"
+cp /audit-output/evidence/stage4-witness-spec.k "$scratch/stage4-witness-spec.k"
+copy_ec=$?
+printf 'COPY_EXIT=%d\n' "$copy_ec"
+if [[ $copy_ec -ne 0 ]]; then overall=1; fi
+
+printf 'COMMAND: cd %s && kprove stage4-witness-spec.k --definition audit-verification-kompiled --spec-module STAGE4-WITNESS-SPEC\n' "$scratch"
+(
+  cd "$scratch"
+  kprove stage4-witness-spec.k \
+    --definition audit-verification-kompiled \
+    --spec-module STAGE4-WITNESS-SPEC
+)
+kprove_ec=$?
+printf 'KPROVE_EXIT=%d\n' "$kprove_ec"
+if [[ $kprove_ec -ne 0 ]]; then overall=1; fi
+
+printf 'COMMAND: python3 - (load candidate and canonical; evaluate empty string and \"I work\")\n'
+python3 - <<'PY'
+import importlib.util
+from pathlib import Path
+
+root = Path("/tmp/audit-work/case91")
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.is_bored
+
+candidate = load(root / "solution.py", "stage4_candidate")
+canonical = load(root / "canonical.py", "stage4_canonical")
+for value in ("", "I work"):
+    print(
+        f"input={value!r} candidate={candidate(value)} "
+        f"canonical={canonical(value)}"
+    )
+PY
+python_ec=$?
+printf 'PYTHON_EXIT=%d\n' "$python_ec"
+if [[ $python_ec -ne 0 ]]; then overall=1; fi
+
+printf 'FINAL_STATUS=%d\n' "$overall"
+exit "$overall"

exec
/bin/bash -lc 'chmod +x /audit-output/evidence/stage4_witness.sh; set +e; /audit-output/evidence/stage4_witness.sh > /audit-output/evidence/stage4_witness.log 2>&1; ec=$?; printf '"'%s\\n' \""'$ec" > /audit-output/evidence/stage4_witness.exit; sed -n '"'1,240p' /audit-output/evidence/stage4_witness.log; printf 'EXIT_STATUS=%s\\n' \""'$ec"' in /audit-output
diff --git a//tmp/audit-work/case91/audit-concrete.py b//tmp/audit-work/case91/audit-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..a63015304ed803791b877e035453e63b8c955cab
--- /dev/null
+++ b//tmp/audit-work/case91/audit-concrete.py
@@ -0,0 +1,42 @@
+def is_bored(S):
+    count = 0
+    at_start = True
+    pending_i = False
+    c = ""
+
+    for c in S:
+        if c == "." or c == "?" or c == "!":
+            if pending_i:
+                count += 1
+            at_start = True
+            pending_i = False
+        elif at_start:
+            if c.strip() != "":
+                if c == "I":
+                    at_start = False
+                    pending_i = True
+                else:
+                    at_start = False
+        elif pending_i:
+            if c.strip() == "":
+                count += 1
+            pending_i = False
+
+    if pending_i:
+        count += 1
+
+    return count
+
+
+assert is_bored("") == 0
+assert is_bored("Hello world") == 0
+assert is_bored("The sky is blue. The sun is shining. I love this weather") == 1
+assert is_bored("I") == 1
+assert is_bored("I.") == 1
+assert is_bored("I?I!I") == 3
+assert is_bored("Idea. Ix. I work") == 1
+assert is_bored(" I work") == 1
+assert is_bored("I\twork") == 1
+assert is_bored("x I work") == 0
+assert is_bored("x.I work") == 1
+assert is_bored("I, too") == 0
