@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/case91
+definition="$scratch/audit-verification-kompiled"
+overall=0
+
+run_kast() {
+  local source=$1
+  local output=$2
+  local log=$3
+  (
