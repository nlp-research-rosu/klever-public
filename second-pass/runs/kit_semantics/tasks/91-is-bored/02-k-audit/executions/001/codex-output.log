@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/case91
+overall=0
+
+printf 'COMMAND: cp /audit-output/evidence/stage4-witness-spec.k %s/stage4-witness-spec.k\n' "$scratch"
+cp /audit-output/evidence/stage4-witness-spec.k "$scratch/stage4-witness-spec.k"
+copy_ec=$?
+printf 'COPY_EXIT=%d\n' "$copy_ec"
+if [[ $copy_ec -ne 0 ]]; then overall=1; fi
+
+printf 'COMMAND: cd %s && kprove stage4-witness-spec.k --definition audit-verification-kompiled --spec-module STAGE4-WITNESS-SPEC\n' "$scratch"
+(
+  cd "$scratch"
+  kprove stage4-witness-spec.k \
+    --definition audit-verification-kompiled \
+    --spec-module STAGE4-WITNESS-SPEC
+)
+kprove_ec=$?
+printf 'KPROVE_EXIT=%d\n' "$kprove_ec"
+if [[ $kprove_ec -ne 0 ]]; then overall=1; fi
+
+printf 'COMMAND: python3 - (load candidate and canonical; evaluate empty string and \"I work\")\n'
+python3 - <<'PY'
+import importlib.util
+from pathlib import Path
+
+root = Path("/tmp/audit-work/case91")
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.is_bored
+
+candidate = load(root / "solution.py", "stage4_candidate")
+canonical = load(root / "canonical.py", "stage4_canonical")
+for value in ("", "I work"):
+    print(
+        f"input={value!r} candidate={candidate(value)} "
+        f"canonical={canonical(value)}"
+    )
+PY
+python_ec=$?
+printf 'PYTHON_EXIT=%d\n' "$python_ec"
+if [[ $python_ec -ne 0 ]]; then overall=1; fi
+
+printf 'FINAL_STATUS=%d\n' "$overall"
+exit "$overall"
diff --git a/evidence/stage5-body-mutation-spec.k b/evidence/stage5-body-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2cb73a4c286afd54582eafff0a74066cb9d52465
--- /dev/null
+++ b/evidence/stage5-body-mutation-spec.k
@@ -0,0 +1,55 @@
+requires "stage5-body-mutation.k"
+
+module STAGE5-BODY-MUTATION-SPEC
+  imports STAGE5-BODY-MUTATION
+
+  // For input "I", the real body returns 1. The mutated empty loop body
+  // returns 0, so the original result obligation must be rejected.
+  claim [mutated-body-is-sensitive]:
+    <k>
+      #loop(
+        str(iCons(73, .IntSeq)),
+        Name("c"),
+        AUDIT-MUTATED-LOOP-BODY)
+      ~> ( If(
+             Name("pending_i"),
+             AugAssign(Name("count"), "+", Int(1)) .Stmts,
+             .Stmts)
+           Return(Name("count"))
+           .Stmts )
+      ~> #endcall
+      => 1
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            AUDIT-MUTATED-FUNCTION-BODY,
+            0),
+          parent(-1))
+        -1 |-> builtinsScope
+        1 |-> scope(
+          ( "S"         |-> str(iCons(73, .IntSeq))
+            "count"     |-> 0
+            "at_start"  |-> true
+            "pending_i" |-> false
+            "c"         |-> str(.IntSeq) ),
+          parent(0)) )
+      =>
+      ( 0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            AUDIT-MUTATED-FUNCTION-BODY,
+            0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
