+def is_bored(S):
+    count = 0
+    at_start = True
+    pending_i = False
+    c = ""
+
+    for c in S:
+        if c == "." or c == "?" or c == "!":
+            if pending_i:
+                count += 1
+            at_start = True
+            pending_i = False
+        elif at_start:
+            if c.strip() != "":
+                if c == "I":
+                    at_start = False
+                    pending_i = True
+                else:
+                    at_start = False
+        elif pending_i:
+            if c.strip() == "":
+                count += 1
+            pending_i = False
+
+    if pending_i:
+        count += 1
+
+    return count
+
+
+assert is_bored("") == 0
+assert is_bored("Hello world") == 0
+assert is_bored("The sky is blue. The sun is shining. I love this weather") == 1
+assert is_bored("I") == 1
+assert is_bored("I.") == 1
+assert is_bored("I?I!I") == 3
+assert is_bored("Idea. Ix. I work") == 1
+assert is_bored(" I work") == 1
+assert is_bored("I\twork") == 1
+assert is_bored("x I work") == 0
+assert is_bored("x.I work") == 1
+assert is_bored("I, too") == 0
