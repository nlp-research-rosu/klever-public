diff --git a/evidence/stage6_nonvacuity.sh b/evidence/stage6_nonvacuity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3c5483aad41fae711ff25097b2bf1178c12c0322
--- /dev/null
+++ b/evidence/stage6_nonvacuity.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/case91
+spec=stage6-false-result-spec.k
+overall=0
+
+printf 'COMMAND: cp /audit-output/evidence/%s %s/%s\n' "$spec" "$scratch" "$spec"
+cp "/audit-output/evidence/$spec" "$scratch/$spec"
+copy_ec=$?
+printf 'COPY_EXIT=%d\n' "$copy_ec"
+if [[ $copy_ec -ne 0 ]]; then overall=1; fi
+
+printf 'SATISFYING_WITNESS: input=\"I work\"; candidate=1; canonical=1; positive ground K claim=1 (#Top)\n'
+printf 'MUTATION: same exact entry state and body, postcondition changed from 1 to 2\n'
+printf 'COMMAND: cd %s && kprove %s --definition audit-verification-kompiled --spec-module STAGE6-FALSE-RESULT-SPEC\n' \
+  "$scratch" "$spec"
+(
+  cd "$scratch"
+  kprove "$spec" \
+    --definition audit-verification-kompiled \
+    --spec-module STAGE6-FALSE-RESULT-SPEC
+)
+kprove_ec=$?
+printf 'KPROVE_EXIT=%d (expected nonzero)\n' "$kprove_ec"
+if [[ $kprove_ec -eq 0 ]]; then
+  overall=1
+elif ! rg -q 'WarnStuckClaimState' /audit-output/evidence/stage6_nonvacuity.raw.log; then
+  printf 'EXPECTED_RESIDUAL_MARKER_MISSING\n'
+  overall=1
+fi
+
+printf 'FINAL_STATUS=%d\n' "$overall"
+exit "$overall"

exec
/bin/bash -lc 'chmod +x /audit-output/evidence/stage6_nonvacuity.sh; set +e; /audit-output/evidence/stage6_nonvacuity.sh > /audit-output/evidence/stage6_nonvacuity.raw.log 2>&1; ec=$?; printf '"'%s\\n' \""'$ec" > /audit-output/evidence/stage6_nonvacuity.exit; sed -n '"'1,300p' /audit-output/evidence/stage6_nonvacuity.raw.log; printf 'EXIT_STATUS=%s\\n' \""'$ec"' in /audit-output
diff --git a//tmp/audit-work/case91/audit-concrete.py b//tmp/audit-work/case91/audit-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..a63015304ed803791b877e035453e63b8c955cab
--- /dev/null
+++ b//tmp/audit-work/case91/audit-concrete.py
@@ -0,0 +1,42 @@
+def is_bored(S):
+    count = 0
+    at_start = True
+    pending_i = False
+    c = ""
+
+    for c in S:
+        if c == "." or c == "?" or c == "!":
+            if pending_i:
+                count += 1
+            at_start = True
+            pending_i = False
+        elif at_start:
+            if c.strip() != "":
+                if c == "I":
+                    at_start = False
+                    pending_i = True
+                else:
+                    at_start = False
+        elif pending_i:
+            if c.strip() == "":
+                count += 1
+            pending_i = False
+
+    if pending_i:
+        count += 1
+
+    return count
+
+
+assert is_bored("") == 0
+assert is_bored("Hello world") == 0
+assert is_bored("The sky is blue. The sun is shining. I love this weather") == 1
+assert is_bored("I") == 1
+assert is_bored("I.") == 1
+assert is_bored("I?I!I") == 3
+assert is_bored("Idea. Ix. I work") == 1
+assert is_bored(" I work") == 1
+assert is_bored("I\twork") == 1
+assert is_bored("x I work") == 0
+assert is_bored("x.I work") == 1
+assert is_bored("I, too") == 0
