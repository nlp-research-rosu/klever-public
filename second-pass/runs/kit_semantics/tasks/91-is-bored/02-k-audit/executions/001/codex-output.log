     1	def is_bored(S):
     2	    count = 0
     3	    at_start = True
     4	    pending_i = False
     5	    c = ""
     6	
     7	    for c in S:
     8	        if c == "." or c == "?" or c == "!":
     9	            if pending_i:
    10	                count += 1
    11	            at_start = True
    12	            pending_i = False
    13	        elif at_start:
    14	            if c.strip() != "":
    15	                if c == "I":
    16	                    at_start = False
    17	                    pending_i = True
    18	                else:
    19	                    at_start = False
    20	        elif pending_i:
    21	            if c.strip() == "":
    22	                count += 1
    23	            pending_i = False
    24	
    25	    if pending_i:
    26	        count += 1
    27	
    28	    return count

