   107	    [simplification]
   108	
   109	  // Operational bridges for the two pure comparisons left opaque by symbolic
   110	  // evaluation of the supplied trim/reverse functions.  The exact binding,
   111	  // expression, arbitrary continuation, and complete all-Int domain are covered
   112	  // by the bridge-free claims in connection-spec.k.
   113	  rule <k>
   114	         Compare(
   115	           Call(Attribute(Name("c"), "strip"), .Exprs),
   116	           CmpOp("==", Str("")))
   117	         => isWSC(C)
   118	         ...
   119	       </k>
   120	       <env> 1 </env>
   121	       <scopes>
   122	         ... 1 |-> scope(
   123	           ( "S"         |-> str(ORIG:IntSeq)
   124	             "count"     |-> N:Int
   125	             "at_start"  |-> A:Bool
   126	             "pending_i" |-> P:Bool
   127	             "c"         |-> str(iCons(C, .IntSeq)) ),
   128	           parent(0))
   129	         ...
   130	       </scopes>
   131	       [priority(40)]
   132	
   133	  rule <k>
   134	         Compare(
   135	           Call(Attribute(Name("c"), "strip"), .Exprs),
   136	           CmpOp("!=", Str("")))
   137	         => notBool isWSC(C)
   138	         ...
   139	       </k>
   140	       <env> 1 </env>
   141	       <scopes>
   142	         ... 1 |-> scope(
   143	           ( "S"         |-> str(ORIG:IntSeq)
   144	             "count"     |-> N:Int
   145	             "at_start"  |-> A:Bool
   146	             "pending_i" |-> P:Bool
   147	             "c"         |-> str(iCons(C, .IntSeq)) ),
   148	           parent(0))
   149	         ...
   150	       </scopes>
   151	       [priority(40)]
   152	
   153	  // One input-character transition.  The guards are disjoint and exhaustive.
   154	  syntax ScanState ::= scanStep(Int, ScanState) [function, total]
   155	
   156	  rule scanStep(C, scanState(N, A, P))
   157	    => #if isDelimiter(C)
   158	       #then scanState(N +Int flag(P), true, false)
   159	       #else
   160	         #if A
   161	         #then
   162	           #if charIsWhitespace(C)
   163	           #then scanState(N, true, P)
   164	           #else
   165	             #if charIsI(C)
   166	             #then scanState(N, false, true)
   167	             #else scanState(N, false, P)
   168	             #fi
   169	           #fi
   170	         #else
   171	           #if P
   172	           #then
   173	             #if charIsWhitespace(C)
   174	             #then scanState(N +Int 1, false, false)
   175	             #else scanState(N, false, false)
   176	             #fi
   177	           #else scanState(N, false, false)
   178	           #fi
   179	         #fi
   180	       #fi
   181	
   182	  // Structurally recursive fold over every finite IntSeq represented by MPY.
   183	  syntax ScanState ::= scan(IntSeq, ScanState) [function, total]
   184	  rule scan(.IntSeq, ST) => ST
   185	  rule scan(iCons(C, REST), ST) => scan(REST, scanStep(C, ST))
   186	
   187	  // The post-loop if-statement counts an I that reaches end-of-input.
   188	  syntax Int ::= finishScan(ScanState) [function, total]
   189	  rule finishScan(scanState(N, A, P)) => N +Int flag(P)
   190	
   191	  syntax Int ::= scanResult(IntSeq, Int, Bool, Bool) [function, total]
   192	  rule scanResult(IS, N, A, P)
   193	    => finishScan(scan(IS, scanState(N, A, P)))
   194	
   195	  syntax Int ::= boredoms(IntSeq) [function, total]
   196	  rule boredoms(IS) => scanResult(IS, 0, true, false)
   197	endmodule

