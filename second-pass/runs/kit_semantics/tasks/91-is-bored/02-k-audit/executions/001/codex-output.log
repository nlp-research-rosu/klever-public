+            iCons(73,
+              iCons(32,
+                iCons(119,
+                  iCons(111,
+                    iCons(114,
+                      iCons(107, .IntSeq))))))
+          ),
+          .Exprs )
+      )
+      => 2
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "is_bored" |-> closureVal(
+          ("S", .ParamNames),
+          BORED-FUNCTION-BODY,
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
