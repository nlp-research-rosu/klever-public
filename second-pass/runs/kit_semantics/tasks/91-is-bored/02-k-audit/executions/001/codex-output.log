@@ -0,0 +1,45 @@
+requires "verification-base.k"
+
+module STAGE5-STRIP-BRIDGE-SPEC
+  imports VERIFICATION-BASE
+
+  claim [space-with-observable-suffix]:
+    <k>
+      Compare(
+        Call(Attribute(Name("c"), "strip"), .Exprs),
+        CmpOp("==", Str("")))
+      ~> #notB
+      => false
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ... 1 |-> scope(
+        ( "S"         |-> str(.IntSeq)
