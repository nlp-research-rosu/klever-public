+                  iCons(111,
+                    iCons(114,
+                      iCons(107, .IntSeq))))))
+          ),
+          .Exprs )
+      )
+      => 2
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "is_bored" |-> closureVal(
+          ("S", .ParamNames),
+          BORED-FUNCTION-BODY,
