+      ],
+      "end_line": 52,
+      "module": "VERIFICATION",
+      "normalized_sha256": "202b06d05541325e5aaf0e76d47ae510afce49eaa2aabb95863e7e1250b712ef",
+      "source_rule_id": "rule-202b06d05541325e5aaf0e76d47ae510afce49eaa2aabb95863e7e1250b712ef",
+      "start_line": 8,
+      "text": "  rule\n    <k>\n      #loop(str(IS:IntSeq), Name(\"c\"), BORED-LOOP-BODY)\n      ~> ( If(\n             Name(\"pending_i\"),\n             AugAssign(Name(\"count\"), \"+\", Int(1)) .Stmts,\n             .Stmts)\n           Return(Name(\"count\"))\n           .Stmts )\n      ~> #endcall\n      => scanResult(IS, N:Int, A:Bool, P:Bool)\n    </k>\n    <env> 1 => 0 </env>\n    <scopes>\n      ( 0 |-> scope(\n          \"is_bored\" |-> closureVal(\n            (\"S\", .ParamNames),\n            BORED-FUNCTION-BODY,\n            0),\n          parent(-1))\n        -1 |-> B:Scope\n        1 |-> scope(\n          ( \"S\"         |-> str(ORIG:IntSeq)\n            \"count\"     |-> N\n            \"at_start\"  |-> A\n            \"pending_i\" |-> P\n            \"c\"         |-> str(CUR:IntSeq) ),\n          parent(0)) )\n      =>\n      ( 0 |-> scope(\n          \"is_bored\" |-> closureVal(\n            (\"S\", .ParamNames),\n            BORED-FUNCTION-BODY,\n            0),\n          parent(-1))\n        -1 |-> B )\n    </scopes>\n    <scopeLoc> 2 => 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    [priority(40)]"
+    }
+  ],
+  "schema_version": 2,
+  "verification_file": "verification.k",
