+        mode = path.lstat().st_mode
+        if stat.S_ISLNK(mode):
+            entries.append({"path": rel, "type": "symlink", "target": os.readlink(path)})
+        elif stat.S_ISDIR(mode):
+            entries.append({"path": rel, "type": "directory"})
+        elif stat.S_ISREG(mode):
+            entries.append(
