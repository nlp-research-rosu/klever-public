+                except json.JSONDecodeError:
+                    invalid.append(lines)
+        print(
+            f"trace {trace.relative_to(trace_root)} lines={lines} "
+            f"invalid_json_lines={invalid} sha256={sha256(trace)}"
+        )
+        if invalid:
+            failures.append(f"invalid JSONL in {trace}: {invalid}")
+
+    expected_direct = {
