+    print(f"trace_files={len(trace_files)}")
+    if not trace_files:
+        failures.append("structured trace is absent")
+    for trace in trace_files:
+        invalid: list[int] = []
+        lines = 0
+        with trace.open() as stream:
+            for lines, line in enumerate(stream, 1):
+                try:
