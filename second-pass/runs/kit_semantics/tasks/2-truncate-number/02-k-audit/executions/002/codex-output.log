diff --git a//tmp/audit-work/fresh/spec-witnesses.k b//tmp/audit-work/fresh/spec-witnesses.k
new file mode 100644
index 0000000000000000000000000000000000000000..a8346aadde91003a938e2539ccc137845f9ac225
--- /dev/null
+++ b//tmp/audit-work/fresh/spec-witnesses.k
@@ -0,0 +1,106 @@
+requires "verification.k"
+
+module SPEC-WITNESSES
+  imports VERIFICATION
+
+  claim [witness-half]:
+    <k> Call(Name("truncate_number"), (0.5, .Exprs)) => 0.5 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map [
+          "truncate_number" <-
+            closureVal(
+              ("number", .ParamNames),
+              (Return(BinOp("%", Name("number"), Float(1.0))) .Stmts),
+              0
+            )
+        ],
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [witness-integer]:
+    <k> Call(Name("truncate_number"), (1.0, .Exprs)) => 0.0 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map [
+          "truncate_number" <-
+            closureVal(
+              ("number", .ParamNames),
+              (Return(BinOp("%", Name("number"), Float(1.0))) .Stmts),
+              0
+            )
+        ],
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
