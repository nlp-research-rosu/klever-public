+
+  claim [witness-large]:
+    <k> Call(Name("truncate_number"), (123.875, .Exprs)) => 0.875 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map [
+          "truncate_number" <-
+            closureVal(
+              ("number", .ParamNames),
+              (Return(BinOp("%", Name("number"), Float(1.0))) .Stmts),
+              0
+            )
+        ],
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
