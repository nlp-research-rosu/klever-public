@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY
+  imports VERIFICATION
+
+  // Reviewer-authored false postcondition. At F = 3.5, the program returns
+  // 0.5 under both Python implementations and the concrete supplied semantics,
+  // not F itself.
+  claim [audit-false-result]:
+    <k> Call(Name("truncate_number"), (F:Float, .Exprs))
+        => F
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map [
+          "truncate_number" <-
+            closureVal(
+              ("number", .ParamNames),
+              (Return(BinOp("%", Name("number"), Float(1.0))) .Stmts),
+              0
+            )
+        ],
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
