+    <k> Call(Name("truncate_number"), (F:Float, .Exprs))
+        => F
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map [
+          "truncate_number" <-
+            closureVal(
+              ("number", .ParamNames),
