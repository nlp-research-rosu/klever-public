/reference/k-proof/reference-semantics/semantics/float.k-259-  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
/reference/k-proof/reference-semantics/semantics/float.k-260-  // with isInt(V) in its path condition refutes this branch without sort reasoning.
/reference/k-proof/reference-semantics/semantics/float.k-261-  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
/reference/k-proof/reference-semantics/semantics/float.k-262-  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
/reference/k-proof/reference-semantics/semantics/float.k-263-        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k:264:       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
/reference/k-proof/reference-semantics/semantics/float.k-265-  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-266-  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-267-  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
/reference/k-proof/reference-semantics/semantics/float.k-268-        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k:269:       requires isFloat(V)
/reference/k-proof/reference-semantics/semantics/float.k-270-  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
/reference/k-proof/reference-semantics/semantics/float.k-271-        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
/reference/k-proof/reference-semantics/semantics/float.k-272-       requires isInt(V) orBool isBool(V)
