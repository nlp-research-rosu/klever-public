codex
The failure was a sandbox PID/proc inconsistency: Lean queried `/proc/2/exe`, while the mounted proc view only supports `/proc/self/exe`. A narrowly scoped preload shim that rewrites only numbered `/proc/<pid>/exe` readlinks restores the pinned Lean 4.22.0 binary and exact commit. I’m rerunning the unchanged trusted preflight now, with that workaround recorded as infrastructure evidence.
exec
/bin/bash -lc "script -q -e -c 'set -e; export LD_PRELOAD=/tmp/audit-work/fix_proc_exe.so; unset LEAN_SYSROOT LAKE_HOME LEAN_PATH; PYTHONPATH=/reference python3 -c \"import json; from pathlib import Path; from tools.klean_preflight import check_generation; result = check_generation(Path(\\\"/reference/k-proof\\\"), Path(\\\"/reference/lemma-discovery.json\\\"), Path(\\\"/reference/klean-generation\\\"), toolchain_lock=Path(\\\"/reference/klean-toolchain.lock.json\\\")); print(json.dumps(result, indent=2, sort_keys=True))\"' /audit-output/evidence/11_rerun_check_generation_with_proc_fix.txt" in /audit-output
diff --git a//tmp/audit-work/fix_proc_exe.c b//tmp/audit-work/fix_proc_exe.c
new file mode 100644
index 0000000000000000000000000000000000000000..f8bca0021c123e9453dd344a8311fc14c5274f44
--- /dev/null
+++ b//tmp/audit-work/fix_proc_exe.c
@@ -0,0 +1,45 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_numbered_proc_exe(const char *path) {
+    const char *cursor;
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor = path + 6;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static ssize_t (*next_readlink)(const char *, char *, size_t);
+    if (next_readlink == NULL) {
+        next_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_numbered_proc_exe(path)) {
+        path = "/proc/self/exe";
+    }
+    return next_readlink(path, buf, size);
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+    static ssize_t (*next_readlinkat)(int, const char *, char *, size_t);
+    if (next_readlinkat == NULL) {
+        next_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+    }
+    if (is_numbered_proc_exe(path)) {
+        dirfd = AT_FDCWD;
+        path = "/proc/self/exe";
+    }
+    return next_readlinkat(dirfd, path, buf, size);
+}
diff --git a//tmp/audit-work/trace_path.c b//tmp/audit-work/trace_path.c
new file mode 100644
index 0000000000000000000000000000000000000000..ca5987970f0047eae999e3a03cf24bf5fc105c78
--- /dev/null
+++ b//tmp/audit-work/trace_path.c
@@ -0,0 +1,51 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static ssize_t (*next_readlink)(const char *, char *, size_t);
+    if (next_readlink == NULL) {
+        next_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = next_readlink(path, buf, size);
+    int saved = errno;
+    dprintf(
+        STDERR_FILENO,
+        "TRACE readlink path=%s size=%zu result=%zd errno=%d value=%.*s\n",
+        path,
+        size,
+        result,
+        saved,
+        result > 0 ? (int)result : 0,
+        result > 0 ? buf : ""
+    );
+    errno = saved;
+    return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+    static ssize_t (*next_readlinkat)(int, const char *, char *, size_t);
+    if (next_readlinkat == NULL) {
+        next_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+    }
+    ssize_t result = next_readlinkat(dirfd, path, buf, size);
+    int saved = errno;
+    dprintf(
+        STDERR_FILENO,
+        "TRACE readlinkat dirfd=%d path=%s size=%zu result=%zd errno=%d value=%.*s\n",
+        dirfd,
+        path,
+        size,
+        result,
+        saved,
+        result > 0 ? (int)result : 0,
+        result > 0 ? buf : ""
+    );
+    errno = saved;
+    return result;
+}
