+
+example : Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» boolVal = true := rfl
+example : Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» intVal = true := rfl
+example : Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» noneVal = false := rfl
+example : Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» refVal = false := rfl
+
+def badIsIntVFalse (_ : SortVal) : SortBool := false
+def badIsIntVTrue (_ : SortVal) : SortBool := true
+def badOrFalse (_ _ : SortBool) : SortBool := false
+def badIsBoolFalse (_ : SortK) : SortBool := false
+def badIsIntFalse (_ : SortK) : SortBool := false
+
+example :
+    ¬ targetStatement
+      Proof._orBool_ Proof.isBool Proof.isInt badIsIntVFalse := by
+  intro h
+  have witness := h boolVal
+  change false = true at witness
+  cases witness
+
+example :
+    ¬ targetStatement
+      Proof._orBool_ Proof.isBool Proof.isInt badIsIntVTrue := by
+  intro h
+  have witness := h noneVal
+  change true = false at witness
+  cases witness
+
+example :
+    ¬ targetStatement
+      badOrFalse Proof.isBool Proof.isInt
+        Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» := by
+  intro h
+  have witness := h boolVal
+  change true = false at witness
+  cases witness
+
+example :
+    ¬ targetStatement
+      Proof._orBool_ badIsBoolFalse Proof.isInt
+        Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» := by
+  intro h
+  have witness := h boolVal
+  change true = false at witness
+  cases witness
+
+example :
+    ¬ targetStatement
+      Proof._orBool_ Proof.isBool badIsIntFalse
+        Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» := by
+  intro h
+  have witness := h intVal
+  change true = false at witness
+  cases witness
+
+/- The equation alone is underconstrained: mutually convenient constant
+   implementations prove it. This is deliberately not the candidate bridge. -/
+def flatOr (_ _ : SortBool) : SortBool := false
+def flatSortPred (_ : SortK) : SortBool := false
+def flatIsIntV (_ : SortVal) : SortBool := false
+
+example :
+    targetStatement flatOr flatSortPred flatSortPred flatIsIntV := by
