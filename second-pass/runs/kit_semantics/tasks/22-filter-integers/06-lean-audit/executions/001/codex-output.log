solution.py:
     1	from typing import List, Any
     2	
     3	
     4	def filter_integers(values: List[Any]) -> List[int]:
     5	    """Filter a list to the values that are instances of ``int``."""
     6	    result = []
     7	    for value in values:
     8	        if isinstance(value, int):
     9	            result.append(value)
    10	    return result
solution.mpy:
     1	Module(
     2	  ImportFrom("typing", "List", "Any")
     3	  FuncDef("filter_integers", Params("values"),
     4	    Expr(
     5	      Str("Filter a list to the values that are instances of ``int``."))
     6	    Assign(Name("result"), ListExpr())
     7	    For(Name("value"), Name("values"),
     8	      If(Call(Name("isinstance"), Name("value"), Name("int")),
     9	        Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
    10	        ))
    11	    Return(Name("result"))))
