@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}"
+
+{
+  printf 'cwd: %q\n' "$PWD"
+  printf 'command:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'started_utc: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$log_path"
+
+"$@" > >(tee -a "$log_path") 2> >(tee -a "$log_path" >&2)
+status=$?
+
+{
+  printf '\nexit_status: %d\n' "$status"
+  printf 'finished_utc: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} >> "$log_path"
+
+exit "$status"
diff --git a/evidence/spec-ground-witnesses.k b/evidence/spec-ground-witnesses.k
new file mode 100644
index 0000000000000000000000000000000000000000..1c93a89242a9bed2592245c87d3b5f860de8e7f4
--- /dev/null
+++ b/evidence/spec-ground-witnesses.k
@@ -0,0 +1,73 @@
+requires "verification.k"
+
+module SPEC-GROUND-WITNESSES
+  imports VERIFICATION
+
+  claim [ground-empty]:
+    <k>
+      Call(
+        Name("filter_integers"),
+        (list(.ValSeq), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "filter_integers" |->
+          closureVal(("values", .ParamNames), filterBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-mixed]:
+    <k>
+      Call(
+        Name("filter_integers"),
+        (list(
+          vCons(
+            1,
+            vCons(
+              noneV,
+              vCons(
+                true,
+                vCons(-2, .ValSeq))))), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "filter_integers" |->
+          closureVal(("values", .ParamNames), filterBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(
+          1,
+          vCons(
+            true,
+            vCons(-2, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

