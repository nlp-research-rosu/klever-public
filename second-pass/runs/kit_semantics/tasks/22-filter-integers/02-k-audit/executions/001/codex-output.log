+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-auditor-false.k b/evidence/spec-auditor-false.k
new file mode 100644
index 0000000000000000000000000000000000000000..10bddde55e106e4348979598b261904c69b6421c
