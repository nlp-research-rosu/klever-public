+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "filter_integers" |->
+          closureVal(
+            ("values", .ParamNames),
+            (Expr(
+               Str("Filter a list to the values that are instances of ``int``."))
+             Assign(Name("result"), ListExpr(.Exprs))
+             Return(Name("result"))
+             .Stmts),
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, .ValSeq))
