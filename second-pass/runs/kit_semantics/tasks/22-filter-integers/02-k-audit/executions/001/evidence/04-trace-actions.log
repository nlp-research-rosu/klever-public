+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  syntax Stmts ::= "filterLoopBody" [macro]
+  syntax Stmts ::= "filterBody" [macro]
+
+  syntax Bool ::= mpyIsInteger(Val) [function, total]
+  syntax ValSeq ::= filterAcc(ValSeq, ValSeq) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule filterLoopBody
+    => If(
+         Call(
+           Name("isinstance"),
+           (Name("value"), Name("int"), .Exprs)),
+         (Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              (Name("value"), .Exprs)))
+          .Stmts),
+         .Stmts)
+
+  rule filterBody
+    => (Expr(
+          Str("Filter a list to the values that are instances of ``int``."))
+        Assign(Name("result"), ListExpr(.Exprs))
+        For(Name("value"), Name("values"), filterLoopBody)
+        Return(Name("result"))
+        .Stmts)
+
+  // The fixed semantics defines isinstance(V, int) by these same two positive
+  // cases (Int and Bool) and an otherwise-false case.
+  rule mpyIsInteger(V:Val) => isInt(V) orBool isBool(V)
+  rule isIntV(V:Val) => mpyIsInteger(V) [simplification]
+
+  // Tail-recursive mathematical filter with an explicit running accumulator.
+  rule filterAcc(.ValSeq, ACC:ValSeq) => ACC
+  rule filterAcc(vCons(V:Val, REST:ValSeq), ACC:ValSeq)
+    => filterAcc(
+         REST,
+         valSeqConcat(ACC, vCons(V, .ValSeq)))
+    requires mpyIsInteger(V)
+  rule filterAcc(vCons(V:Val, REST:ValSeq), ACC:ValSeq)
+    => filterAcc(REST, ACC)
+    requires notBool mpyIsInteger(V)
+endmodule
