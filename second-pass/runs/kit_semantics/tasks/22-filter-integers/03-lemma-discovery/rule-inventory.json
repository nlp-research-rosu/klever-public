      "module": "VERIFICATION",
      "normalized_sha256": "7a8aefa8550c8a06b16a409b5174a955c92023c5c954b847bc146b10750b669d",
      "source_rule_id": "rule-7a8aefa8550c8a06b16a409b5174a955c92023c5c954b847bc146b10750b669d",
      "start_line": 17,
      "text": "  rule filterLoopBody\n    => If(\n         Call(\n           Name(\"isinstance\"),\n           (Name(\"value\"), Name(\"int\"), .Exprs)),\n         (Expr(\n            Call(\n              Attribute(Name(\"result\"), \"append\"),\n              (Name(\"value\"), .Exprs)))\n          .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "8e8f01b5e0fd33ceb875a3d4d5eaaabb18bf343c33360eb7a965dd98e22a8685",
      "source_rule_id": "rule-8e8f01b5e0fd33ceb875a3d4d5eaaabb18bf343c33360eb7a965dd98e22a8685",
      "start_line": 29,
      "text": "  rule filterBody\n    => (Expr(\n          Str(\"Filter a list to the values that are instances of ``int``.\"))\n        Assign(Name(\"result\"), ListExpr(.Exprs))\n        For(Name(\"value\"), Name(\"values\"), filterLoopBody)\n        Return(Name(\"result\"))\n        .Stmts)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "55b672e7a2348769766678767d4f1ec37801c590e4687ecb281112debaebe350",
      "source_rule_id": "rule-55b672e7a2348769766678767d4f1ec37801c590e4687ecb281112debaebe350",
      "start_line": 39,
      "text": "  rule isIntV(V:Val) => isInt(V) orBool isBool(V) [simplification]"
    },
    {
      "attributes": [],
      "end_line": 42,
      "module": "VERIFICATION",
      "normalized_sha256": "577aa383be88832d9bea1ce3fa32e88bef61a50c8c009c29dd02cc4ee6b8dec4",
      "source_rule_id": "rule-577aa383be88832d9bea1ce3fa32e88bef61a50c8c009c29dd02cc4ee6b8dec4",
      "start_line": 42,
      "text": "  rule filterAcc(.ValSeq, ACC:ValSeq) => ACC"
    },
    {
      "attributes": [],
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "f78e3bc6b47e926e3c06b48a1fe9acb3eb68fda26c3b17ee0c8eb4ad23dfcd03",
      "source_rule_id": "rule-f78e3bc6b47e926e3c06b48a1fe9acb3eb68fda26c3b17ee0c8eb4ad23dfcd03",
      "start_line": 43,
      "text": "  rule filterAcc(vCons(V:Val, REST:ValSeq), ACC:ValSeq)\n    => #if isIntV(V)\n       #then filterAcc(\n               REST,\n               valSeqConcat(ACC, vCons(V, .ValSeq)))\n       #else filterAcc(REST, ACC)\n       #fi"
    }
