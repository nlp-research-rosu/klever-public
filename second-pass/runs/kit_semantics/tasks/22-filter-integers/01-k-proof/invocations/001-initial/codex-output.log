+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("value"), filterLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
