+      0 |-> scope(
+        "filter_integers" |->
+          closureVal(
+            ("values", .ParamNames),
+            (Assign(Name("result"), ListExpr(.Exprs))
+             Return(Name("result"))
+             .Stmts),
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
