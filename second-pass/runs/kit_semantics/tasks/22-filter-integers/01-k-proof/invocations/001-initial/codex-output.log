--- /dev/null
+++ b/spec.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(list(REST:ValSeq), Name("value"), filterLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "filter_integers" |->
+          closureVal(("values", .ParamNames), filterBody, 0),
+        parent(-1))
+      1 |-> scope(
+        "values" |-> list(ORIGINAL:ValSeq)
+        "result" |-> ref(0)
+        "value" |-> OLD:Val,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "filter_integers" |->
+          closureVal(("values", .ParamNames), filterBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(ACC:ValSeq)
+      =>
+      0 |-> list(filterAcc(REST, ACC))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [filter-entry]:
+    <k>
+      Call(
+        Name("filter_integers"),
+        (list(INPUT:ValSeq), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "filter_integers" |->
+          closureVal(("values", .ParamNames), filterBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(filterAcc(INPUT, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1a7342850617fc138fd851a86b67d02788a1214b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,50 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  syntax Stmts ::= "filterLoopBody" [macro]
+  syntax Stmts ::= "filterBody" [macro]
+
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  syntax ValSeq ::= filterAcc(ValSeq, ValSeq) [function, total]
+
+  rule filterLoopBody
+    => If(
+         Call(
+           Name("isinstance"),
+           (Name("value"), Name("int"), .Exprs)),
+         (Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              (Name("value"), .Exprs)))
+          .Stmts),
+         .Stmts)
+
+  rule filterBody
+    => (Expr(
+          Str("Filter a list to the values that are instances of ``int``."))
+        Assign(Name("result"), ListExpr(.Exprs))
+        For(Name("value"), Name("values"), filterLoopBody)
+        Return(Name("result"))
+        .Stmts)
+
+  // Dynamic-sort dispatch twin for the fixed isIntV equations:
+  // Int -> true, Bool -> true, and every other Val constructor -> false.
+  rule isIntV(V:Val) => isInt(V) orBool isBool(V) [simplification]
+
+  // Tail-recursive mathematical filter with an explicit running accumulator.
+  rule filterAcc(.ValSeq, ACC:ValSeq) => ACC
+  rule filterAcc(vCons(V:Val, REST:ValSeq), ACC:ValSeq)
+    => #if isIntV(V)
+       #then filterAcc(
+               REST,
+               valSeqConcat(ACC, vCons(V, .ValSeq)))
+       #else filterAcc(REST, ACC)
+       #fi
+endmodule

exec
/bin/bash -lc 'test "$(head -n 1 PROOF.md)" = VALIDATED
for artifact in solution.py solution.mpy verification.k spec.k prove.sh PROOF.md; do test -s "$artifact"; done
python3 py2mpy.py solution.py | cmp -s - solution.mpy
rg -n '"'"'^def filter_integers|''^module VERIFICATION$|claim '"\\[filter-loop\\]|claim \\[filter-entry\\]|"'^VALIDATED$|''^kprove spec.k'"' solution.py verification.k spec.k PROOF.md prove.sh
