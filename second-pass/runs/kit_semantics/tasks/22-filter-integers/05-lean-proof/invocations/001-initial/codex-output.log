diff --git a/AppPath.c b/AppPath.c
new file mode 100644
index 0000000000000000000000000000000000000000..6a2f982ff8d84bee6c4e06d17b3c7a823d8dbc02
--- /dev/null
+++ b/AppPath.c
@@ -0,0 +1,18 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  char proc[4096];
+  snprintf(proc, sizeof(proc), "/proc/%d/exe", getpid());
+  ssize_t size = readlink(proc, path, sizeof(path) - 1);
+  if (size < 0) {
+    fprintf(stderr, "readlink: %s\n", strerror(errno));
+    return 1;
+  }
+  path[size] = '\0';
+  puts(path);
+  return 0;
+}
