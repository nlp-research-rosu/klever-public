patch: completed
/workspace/AppPath.c
/workspace/LeanAppPathFix.c
diff --git a/LeanAppPathFix.c b/LeanAppPathFix.c
new file mode 100644
index 0000000000000000000000000000000000000000..94cd7732daeec741d01399135d7ca5db4264581a
--- /dev/null
+++ b/LeanAppPathFix.c
@@ -0,0 +1,15 @@
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *restrict path, char *restrict buffer, size_t size) {
+  size_t length = strlen(path);
+  if (length >= 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    path = "/proc/self/exe";
+  }
+  return syscall(SYS_readlinkat, AT_FDCWD, path, buffer, size);
+}
