diff --git a//tmp/audit-work/reconstruction/spec-audit-false.k b//tmp/audit-work/reconstruction/spec-audit-false.k
new file mode 100644
index 0000000000000000000000000000000000000000..4aa20571e0025ccd48dab9b90b6615a477668d7b
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-audit-false.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-AUDIT-FALSE
