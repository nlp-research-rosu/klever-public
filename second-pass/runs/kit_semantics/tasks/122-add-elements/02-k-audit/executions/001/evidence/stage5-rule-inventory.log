reference-semantics/semantics/tuple.k:27:       requires notBool (A ==K V)
reference-semantics/semantics/tuple.k:28:  rule applyCmp("!=", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)
reference-semantics/semantics/tuple.k:31:  syntax KItem ::= #bindTgt(Expr, Val)
reference-semantics/semantics/tuple.k:32:  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
reference-semantics/semantics/tuple.k:35:  rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
reference-semantics/semantics/tuple.k:38:       requires "$cells" in_keys(M)
reference-semantics/semantics/tuple.k:42:  rule <k> #bindTgt(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
reference-semantics/semantics/tuple.k:43:  rule <k> #bindTgt(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
reference-semantics/semantics/tuple.k:44:  rule <k> #bindTgt(TupleExpr(TS:Exprs), ref(H:Int)) => #bindTgt(TupleExpr(TS), V) ... </k>
