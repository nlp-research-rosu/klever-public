+                .Stmts
+              )
+              If(
+                BoolOp(
+                  "and",
+                  Compare(Name("element"), CmpOp(">=", UnaryOp("-", Int(99)))),
+                  Compare(Name("element"), CmpOp("<=", Int(99)))
+                ),
+                AugAssign(Name("total"), "+", Name("element")) .Stmts,
+                .Stmts
+              )
+              AugAssign(Name("remaining"), "-", Int(1))
+            )
+            Return(Name("total")),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
