+printf 'TRANSLATE_EXIT_STATUS: %d\n' "$translate_status"
+if [[ "$translate_status" -ne 0 ]]; then
+  exit "$translate_status"
+fi
+
+printf '%s\n' 'COMMAND: cmp -s solution.regenerated.mpy solution.mpy'
