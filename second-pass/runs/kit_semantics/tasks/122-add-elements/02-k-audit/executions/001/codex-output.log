FILE /candidate/verification-base.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // The source contract restricts every list element to Python integers.
     7	  syntax Bool ::= allInts(ValSeq) [function, total]
     8	  rule allInts(.ValSeq) => true
     9	  rule allInts(vCons(V:Val, REST:ValSeq))
    10	    => isInt(V) andBool allInts(REST)
    11	
    12	  // A totalized projection lets the Haskell backend use the information
    13	  // isInt(V) without changing the represented value.  Every operational use
    14	  // below is guarded by isInt.
    15	  syntax Bool ::= definedProjectInt(Val) [function, total]
    16	  rule definedProjectInt(V:Val) => isInt(V)
    17	
    18	  syntax Int ::= projectIntTotal(Val)
    19	    [function, total, symbol(projectIntTotal), no-evaluators]
    20	
    21	  rule #Ceil({@V:Val}:>Int)
    22	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    23	    [simplification]
    24	
    25	  rule projectIntTotal(V:Val) => {V}:>Int
    26	    requires definedProjectInt(V)
    27	    [concrete, simplification(10), preserves-definedness]
    28	
    29	  rule {V:Val}:>Int => projectIntTotal(V)
    30	    requires definedProjectInt(V)
    31	    [symbolic(V), simplification, preserves-definedness]
    32	
    33	  rule projectIntTotal(I:Int) => I [simplification]
    34	  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
    35	    [simplification]
    36	
    37	  // Guarded dispatch twins of the supplied MPY-INT equations.  These do not
    38	  // skip a program construct; they expose the existing Int behavior after
    39	  // the dynamic Val-to-Int sort fact has been established.
    40	  rule applyCmp(OP:String, V:Val, I:Int)
    41	    => applyCmp(OP, projectIntTotal(V), I)
    42	    requires isInt(V) andBool isEqOrdOp(OP)
    43	    [simplification]
    44	
    45	  rule applyBin("+", I:Int, V:Val)
    46	    => I +Int projectIntTotal(V)
    47	    requires isInt(V)
    48	    [simplification]
    49	
    50	  // Mathematical specification: retain an integer exactly when its absolute
    51	  // decimal representation has at most two digits, i.e. -99 <= I <= 99.
    52	  syntax Int ::= qualifyingValue(Int) [function, total]
    53	  rule qualifyingValue(I:Int)
    54	    => #if I >=Int -99 andBool I <=Int 99 #then I #else 0 #fi
    55	    [simplification]
    56	
    57	  syntax Int ::= qualifyingVal(Val) [function, total]
    58	  rule qualifyingVal(V:Val) => qualifyingValue(projectIntTotal(V))
    59	    requires isInt(V)
    60	    [simplification]
    61	  rule qualifyingVal(V:Val) => 0
    62	    requires notBool isInt(V)
    63	    [simplification]
    64	
    65	  // Sum the qualifying values in the first N positions.  The equations are
    66	  // total: nonpositive N and an exhausted sequence both contribute zero.
    67	  syntax Int ::= qualifyingPrefix(ValSeq, Int) [function, total]
    68	  rule qualifyingPrefix(_:ValSeq, N:Int) => 0
    69	    requires N <=Int 0
    70	    [simplification]
    71	  rule qualifyingPrefix(.ValSeq, N:Int) => 0
    72	    requires N >Int 0
    73	    [simplification]
    74	  rule qualifyingPrefix(vCons(V:Val, REST:ValSeq), N:Int)
    75	    => qualifyingVal(V) +Int qualifyingPrefix(REST, N -Int 1)
    76	    requires N >Int 0
    77	    [simplification]
    78	endmodule
