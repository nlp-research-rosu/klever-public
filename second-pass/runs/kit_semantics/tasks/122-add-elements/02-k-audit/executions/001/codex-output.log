+#!/usr/bin/env bash
+set -o pipefail
+
+cd /tmp/audit-work/122-add-elements || exit 70
+
+printf '%s\n' \
+  'COMMAND: python3 /reference/py2mpy.py audit_boundary.py > audit_boundary.mpy'
