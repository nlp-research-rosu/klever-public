Module(
  FuncDef("add_elements", Params("arr", "k"),
    Assign(Name("total"), Int(0))
    Assign(Name("element"), Int(0))
    Assign(Name("remaining"), Name("k"))
    For(Name("element"), Name("arr"),
      If(Compare(Name("remaining"), CmpOp("==", Int(0))),
        Break,
        )
      If(BoolOp(
        "and",
        Compare(Name("element"), CmpOp(">=", UnaryOp("-", Int(99)))),
        Compare(Name("element"), CmpOp("<=", Int(99)))),
        AugAssign(Name("total"), "+", Name("element")),
        )
      AugAssign(Name("remaining"), "-", Int(1)))
    Return(Name("total"))))
