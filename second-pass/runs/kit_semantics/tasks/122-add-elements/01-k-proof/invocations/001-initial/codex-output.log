diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..5deac6e0421caf19919436aa4c807de024967c6c
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,10 @@
+def add_elements(arr, k):
+    total = 0
+    element = 0
+    for element in arr[:k]:
+        if element >= -99 and element <= 99:
+            total += element
+    return total
+
+
+result = add_elements([111, 21, 3, 4000, 5, 6, 7, 8, 9], 4)
