+      -1 |-> BUILTINS:Scope
+      1 |-> scope(
+        "arr" |-> ARRAY:Val
+        "k" |-> KVALUE:Int
+        "total" |-> S
+        "element" |-> OLD:Val
+        "remaining" |-> N:Int,
+        parent(0)
+      )
+      =>
+      0 |-> scope(GLOBALS, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
