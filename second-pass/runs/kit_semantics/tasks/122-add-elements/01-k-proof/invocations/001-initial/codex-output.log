+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+      1 |-> scope(
+        "arr" |-> ARRAY:Val
+        "k" |-> KVALUE:Int
+        "total" |-> S
+        "element" |-> OLD:Val
+        "remaining" |-> N:Int,
+        parent(0)
+      )
+      =>
+      0 |-> scope(GLOBALS, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
