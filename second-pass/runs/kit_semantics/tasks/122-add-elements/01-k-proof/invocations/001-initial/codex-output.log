diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..aa32f892fc57b371873acf7e2b6e65ab42502718
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,62 @@
+requires "verification-base.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-BASE
+
+  // Bridge-free universal connection theorem for verification.k's exact
+  // operational summary.
+  claim [loop-connection]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("element"),
+        If(
+          Compare(Name("remaining"), CmpOp("==", Int(0))),
+          Break .Stmts,
+          .Stmts
+        )
+        If(
+          BoolOp(
+            "and",
+            Compare(Name("element"), CmpOp(">=", UnaryOp("-", Int(99)))),
+            Compare(Name("element"), CmpOp("<=", Int(99)))
+          ),
+          AugAssign(Name("total"), "+", Name("element")) .Stmts,
+          .Stmts
+        )
+        AugAssign(Name("remaining"), "-", Int(1))
+      )
+      ~> Return(Name("total"))
+      ~> #endcall
+      =>
+      S:Int +Int qualifyingPrefix(VS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+      1 |-> scope(
+        "arr" |-> ARRAY:Val
+        "k" |-> KVALUE:Int
+        "total" |-> S
+        "element" |-> OLD:Val
+        "remaining" |-> N:Int,
+        parent(0)
+      )
+      =>
+      0 |-> scope(GLOBALS, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool 0 <=Int N
+     andBool N <=Int vsLen(VS)
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..fe7e36bb277d5409be106cabdb5ea1ae753c6996
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,14 @@
+def add_elements(arr, k):
+    total = 0
+    element = 0
+    remaining = k
+    for element in arr:
+        if remaining == 0:
+            break
+        if element >= -99 and element <= 99:
+            total += element
+        remaining -= 1
+    return total
+
+
+result = add_elements([111, 21, 3, 4000, 5, 6, 7, 8, 9], 4)
