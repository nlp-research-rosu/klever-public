+  // Slicing an all-integer sequence preserves the element domain.  This is a
+  // structural consequence of buildVS selecting only valSeqAt elements.
+  rule allInts(buildVS(VS:ValSeq, START:Int, STOP:Int, 1)) => true
+    requires allInts(VS)
+     andBool 0 <=Int START
+     andBool START <=Int STOP
+     andBool STOP <=Int vsLen(VS)
+    [simplification]
+
+  // The supplied clampHi equations reduce to I on both I < L and I == L
+  // when the step is nonnegative.  Exposing the joined case avoids a symbolic
+  // split at the valid slice boundary K == len(arr).
+  rule clampHi(I:Int, L:Int, STEP:Int) => I
+    requires I <=Int L andBool STEP >=Int 0
+    [simplification]
+endmodule
