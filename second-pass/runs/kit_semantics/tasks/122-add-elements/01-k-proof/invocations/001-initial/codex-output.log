+        "k" |-> KVALUE:Int
+        "total" |-> S
+        "element" |-> OLD:Val,
+        parent(0)
+      )
+      =>
+      0 |-> scope(GLOBALS, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+    [priority(30)]
+endmodule

