+      -1 |-> BUILTINS:Scope
+      1 |-> scope(
+        "arr" |-> ARRAY:Val
+        "k" |-> KVALUE:Int
+        "total" |-> S
+        "element" |-> OLD:Val
+        "remaining" |-> N:Int,
+        parent(0)
+      )
+      =>
