diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7b9780c60d4677b180932f6a76b93a8b592dcd77
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,81 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Full entry theorem.  VS and K are symbolic; the constraints are exactly
+  // the HumanEval material domain, including every length from 1 through 100.
+  claim [add-elements]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "add_elements",
+            Params("arr", "k"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("element"), Int(0))
+            For(
+              Name("element"),
+              Subscript(Name("arr"), Slice(NoBound, Name("k"), NoBound)),
+              If(
+                BoolOp(
+                  "and",
+                  Compare(Name("element"), CmpOp(">=", UnaryOp("-", Int(99)))),
+                  Compare(Name("element"), CmpOp("<=", Int(99)))
+                ),
+                AugAssign(Name("total"), "+", Name("element")) .Stmts,
+                .Stmts
+              ) .Stmts
+            )
+            Return(Name("total"))
+          )
+        )
+      )
+      ~> Call(Name("add_elements"), list(INPUT:ValSeq), Int(K:Int))
+      =>
+      qualifyingSum(buildVS(INPUT, 0, K, 1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "add_elements" |->
+          closureVal(
+            ("arr", "k"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("element"), Int(0))
+            For(
+              Name("element"),
+              Subscript(Name("arr"), Slice(NoBound, Name("k"), NoBound)),
+              If(
+                BoolOp(
+                  "and",
+                  Compare(Name("element"), CmpOp(">=", UnaryOp("-", Int(99)))),
+                  Compare(Name("element"), CmpOp("<=", Int(99)))
+                ),
+                AugAssign(Name("total"), "+", Name("element")) .Stmts,
+                .Stmts
+              ) .Stmts
+            )
+            Return(Name("total")),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+     andBool 1 <=Int vsLen(INPUT)
+     andBool vsLen(INPUT) <=Int 100
+     andBool 1 <=Int K
+     andBool K <=Int vsLen(INPUT)
+endmodule
