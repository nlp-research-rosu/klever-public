diff --git a/verification-base.k b/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..59a97f711434c0499b66f829f51481fb421121f0
--- /dev/null
+++ b/verification-base.k
@@ -0,0 +1,78 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // The source contract restricts every list element to Python integers.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+
+  // A totalized projection lets the Haskell backend use the information
+  // isInt(V) without changing the represented value.  Every operational use
+  // below is guarded by isInt.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
+    [simplification]
+
+  // Guarded dispatch twins of the supplied MPY-INT equations.  These do not
+  // skip a program construct; they expose the existing Int behavior after
+  // the dynamic Val-to-Int sort fact has been established.
+  rule applyCmp(OP:String, V:Val, I:Int)
+    => applyCmp(OP, projectIntTotal(V), I)
+    requires isInt(V) andBool isEqOrdOp(OP)
+    [simplification]
+
+  rule applyBin("+", I:Int, V:Val)
+    => I +Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  // Mathematical specification: retain an integer exactly when its absolute
+  // decimal representation has at most two digits, i.e. -99 <= I <= 99.
+  syntax Int ::= qualifyingValue(Int) [function, total]
+  rule qualifyingValue(I:Int)
+    => #if I >=Int -99 andBool I <=Int 99 #then I #else 0 #fi
+    [simplification]
+
+  syntax Int ::= qualifyingVal(Val) [function, total]
+  rule qualifyingVal(V:Val) => qualifyingValue(projectIntTotal(V))
+    requires isInt(V)
+    [simplification]
+  rule qualifyingVal(V:Val) => 0
+    requires notBool isInt(V)
+    [simplification]
+
+  // Sum the qualifying values in the first N positions.  The equations are
+  // total: nonpositive N and an exhausted sequence both contribute zero.
+  syntax Int ::= qualifyingPrefix(ValSeq, Int) [function, total]
+  rule qualifyingPrefix(_:ValSeq, N:Int) => 0
+    requires N <=Int 0
+    [simplification]
+  rule qualifyingPrefix(.ValSeq, N:Int) => 0
+    requires N >Int 0
+    [simplification]
+  rule qualifyingPrefix(vCons(V:Val, REST:ValSeq), N:Int)
+    => qualifyingVal(V) +Int qualifyingPrefix(REST, N -Int 1)
+    requires N >Int 0
+    [simplification]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1fdf22291993fa6991c2810e4aa1bb12c700a643
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,65 @@
+requires "verification-base.k"
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Exact operational summary justified by loop-spec.k, which is proved
+  // against VERIFICATION-BASE and therefore cannot use this rule.  Its match
+  // domain, continuation, frame, bindings, and cells are identical to that
+  // bridge-free universal connection theorem.
+  rule
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("element"),
+        If(
+          Compare(Name("remaining"), CmpOp("==", Int(0))),
+          Break .Stmts,
+          .Stmts
+        )
+        If(
+          BoolOp(
+            "and",
+            Compare(Name("element"), CmpOp(">=", UnaryOp("-", Int(99)))),
+            Compare(Name("element"), CmpOp("<=", Int(99)))
+          ),
+          AugAssign(Name("total"), "+", Name("element")) .Stmts,
+          .Stmts
+        )
+        AugAssign(Name("remaining"), "-", Int(1))
+      )
+      ~> (Return(Name("total")) .Stmts)
+      ~> #endcall
+      =>
+      S:Int +Int qualifyingPrefix(VS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+      1 |-> scope(
+        "arr" |-> ARRAY:Val
+        "k" |-> KVALUE:Int
+        "total" |-> S
+        "element" |-> OLD:Val
+        "remaining" |-> N:Int,
+        parent(0)
+      )
+      =>
+      0 |-> scope(GLOBALS, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool 0 <=Int N
+     andBool N <=Int vsLen(VS)
+    [priority(30)]
+endmodule

diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..76fd0f13b4f37acdce44db4aa79e96057055ae6e
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,59 @@
+from solution import add_elements
+
+
+def oracle(arr, k):
+    # Independent direct transcription of the contract.
+    return sum(value for value in arr[:k] if -99 <= value <= 99)
+
+
+BOUNDARIES = [
+    -1000,
+    -101,
+    -100,
+    -99,
+    -98,
+    -10,
+    -1,
+    0,
+    1,
+    9,
+    10,
+    98,
+    99,
+    100,
+    101,
+    1000,
+]
+
+
+def main():
+    cases = 0
+    mismatches = []
+
+    example = [111, 21, 3, 4000, 5, 6, 7, 8, 9]
+    got = add_elements(example, 4)
+    expected = oracle(example, 4)
+    cases += 1
+    if got != expected:
+        mismatches.append((example, 4, got, expected))
+
+    for length in range(1, 101):
+        arr = [
+            BOUNDARIES[(index * 7 + length * 3) % len(BOUNDARIES)]
+            for index in range(length)
+        ]
+        for k in range(1, length + 1):
+            got = add_elements(arr, k)
+            expected = oracle(arr, k)
+            cases += 1
+            if got != expected:
+                mismatches.append((arr, k, got, expected))
+
+    print(f"cases={cases} mismatches={len(mismatches)}")
+    if mismatches:
+        print(mismatches[:3])
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
