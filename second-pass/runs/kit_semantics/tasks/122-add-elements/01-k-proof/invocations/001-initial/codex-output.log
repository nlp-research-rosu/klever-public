+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool 0 <=Int N
+     andBool N <=Int vsLen(VS)
+endmodule
