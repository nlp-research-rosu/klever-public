import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
assert len(out['rules']) == len(inventory['rules'])
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inventory['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == len(out['rules'])
for source, classified in zip(inventory['rules'], out['rules']):
    assert list(classified) == ['source_rule_id', 'classification', 'rationale']
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if any(a == 'simplification' or a.startswith('simplification(') for a in source['attributes']):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

rule_lines = inventory['rules'][0]['text'].splitlines()
rule_statement = [line.strip() for line in rule_lines[1:-1] if line.strip()]
loop_lines = Path('/reference/k-proof/loop-spec.k').read_text().splitlines()
claim_start = next(i for i, line in enumerate(loop_lines) if 'claim [loop-connection]:' in line)
claim_end = next(i for i in range(claim_start + 1, len(loop_lines)) if loop_lines[i].strip() == 'endmodule')
claim_statement = [line.strip() for line in loop_lines[claim_start + 1:claim_end] if line.strip()]
assert rule_statement == claim_statement

discovery = Path('/workspace/DISCOVERY.md').read_text()
assert 'domain-lemma set is explicitly empty' in discovery
print(f\"schema=ok rules={len(out['rules'])} unique={len(set(r['source_rule_id'] for r in out['rules']))}\")
print(f\"inventory_sha256={out['inventory_sha256']}\")
print('exact_rule_claim_statement_match=true')
print('domain_lemma_set=empty')
