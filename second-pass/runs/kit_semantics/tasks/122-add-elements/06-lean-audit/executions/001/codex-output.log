                bundle, "Stage 4 producer source bundle"
            )
        }
        if observed_names != {
            "source-manifest.json",
            "klean_export.py",
            "klean.py",
        }:
            raise KleanAuditContractError(
                "Stage 4 producer source bundle has unexpected files"
            )
        for name, expected in expected_files.items():
