codex
The root cause is specific and reproducible: this sandbox’s PID namespace makes `/proc/<getpid>/exe` absent, while Lean 4.22’s runtime uses that exact path to locate its executable. I’m applying a narrow audit-local preload shim that redirects only `/proc/<pid>/exe` readlink calls to `/proc/self/exe`; this does not touch any mounted evidence or alter Lean semantics. Then I’ll rerun the trusted checker unchanged.
apply patch
patch: completed
/audit-output/evidence/lean_app_path_shim.c
diff --git a/evidence/lean_app_path_shim.c b/evidence/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..c816a1eec711158005d7446aa860be8ab13a88ad
--- /dev/null
+++ b/evidence/lean_app_path_shim.c
@@ -0,0 +1,22 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+        size_t length = strlen(path);
+        if (length >= 4 && strcmp(path + length - 4, "/exe") == 0) {
+            return real_readlink("/proc/self/exe", buffer, size);
+        }
+    }
+    return real_readlink(path, buffer, size);
+}

