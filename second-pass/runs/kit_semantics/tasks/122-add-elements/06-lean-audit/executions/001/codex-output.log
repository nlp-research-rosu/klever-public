     2	def add_elements(arr, k):
     3	    """
     4	    Given a non-empty array of integers arr and an integer k, return
     5	    the sum of the elements with at most two digits from the first k elements of arr.
     6	
     7	    Example:
     8	
     9	        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4
    10	        Output: 24 # sum of 21 + 3
    11	
    12	    Constraints:
    13	        1. 1 <= len(arr) <= 100
    14	        2. 1 <= k <= len(arr)
    15	    """
--- solution.py ---
     1	def add_elements(arr, k):
     2	    total = 0
     3	    element = 0
     4	    remaining = k
     5	    for element in arr:
     6	        if remaining == 0:
     7	            break
     8	        if element >= -99 and element <= 99:
     9	            total += element
    10	        remaining -= 1
    11	    return total
