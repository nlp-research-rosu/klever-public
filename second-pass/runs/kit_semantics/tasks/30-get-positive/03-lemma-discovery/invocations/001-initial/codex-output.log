+      "classification": "DEFINITION",
+      "rationale": "This simplification equation is the base case of the filterPositive recurrence: filtering no remaining elements returns the accumulator unchanged."
+    },
+    {
+      "source_rule_id": "rule-88784a48ac7e5083100f357cdc7fcd5856f28ba2c5b93d4a5efd4a85eb3dfae2",
+      "classification": "DEFINITION",
+      "rationale": "This simplification equation is the positive-head case of the filterPositive recurrence, defining the summary by appending the head and recurring on the structurally smaller tail."
+    },
+    {
+      "source_rule_id": "rule-6f46b6b7356839cbf0b867220b1e1216ff7a93fb8ba127ad7cd2a420f744ecf2",
+      "classification": "DEFINITION",
+      "rationale": "This simplification equation is the nonpositive-head case of the filterPositive recurrence, defining the summary by skipping the head and recurring on the structurally smaller tail."
+    },
+    {
+      "source_rule_id": "rule-34f56aec2aa3edbac282cf16b737d75ec1da43edea47cc5bccecc9d81dad9db0",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This simplification rewrites the pre-existing operational applyCmp symbol to the proof summary positiveNumeric over a guarded dynamic Val domain, so it is an additional cross-symbol fact rather than a defining clause. Stage 1 proves related Int- and Float-specialized connection claims, but it does not first prove this exact generic V:Val rule with its numericVal guard; the rule therefore remains in the trusted domain-lemma boundary."
+    }
+  ]
