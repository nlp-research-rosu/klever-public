index 0000000000000000000000000000000000000000..b431b6982cc0e907fb56f452e4a8f156fdf0a6d9
--- /dev/null
+++ b/evidence/01-rule-inventory-and-classification.txt
@@ -0,0 +1,100 @@
+Trusted reconstruction command
+  PYTHONPATH=/reference python3 -c 'import json; from pathlib import Path; from tools.k_rule_inventory import inventory_verification; print(json.dumps(inventory_verification(Path("/reference/k-proof")), indent=2, sort_keys=True, ensure_ascii=False))'
+
+Reconstructed inventory summary
+  verification_file: verification.k
+  verification_module: VERIFICATION
+  local closure, in source order: VERIFICATION-BASE, VERIFICATION
+  verification_sha256: b8451601fa2aaa078d50afaba6a9deea095b64e08feb21fc1ceda6e3bdc6c386
+  inventory_sha256: 22a541b7d4934594e95b3772f125d9c1872b0d6b37d91b7d26eb5f7bcb7908fa
+  rule count: 10
+
+Trusted contract and independent exact-order comparison command
+  PYTHONPATH=/reference python3 - <<'PY'
+  import json
+  from pathlib import Path
+  from tools.k_rule_inventory import inventory_verification
+  from tools.lemma_discovery_contract import validate_trust_boundary
+  workspace=Path('/reference/k-proof')
+  manifest_path=Path('/reference/lemma-discovery.json')
+  inv=inventory_verification(workspace)
+  man=json.loads(manifest_path.read_text())
+  validated=validate_trust_boundary(workspace, manifest_path)
+  ids=[r['source_rule_id'] for r in inv['rules']]
+  mids=[r['source_rule_id'] for r in man['rules']]
+  print('verification_module',inv['verification_module'])
+  print('verification_modules',inv['verification_modules'])
+  print('verification_sha256',inv['verification_sha256'])
+  print('inventory_sha256',inv['inventory_sha256'])
+  print('manifest_inventory_sha256',man['inventory_sha256'])
+  print('inventory_count',len(ids))
+  print('manifest_count',len(mids))
+  print('ids_in_exact_order',ids==mids)
+  print('ids_unique_inventory',len(ids)==len(set(ids)))
+  print('ids_unique_manifest',len(mids)==len(set(mids)))
+  print('id_sets_equal',set(ids)==set(mids))
+  print('validated_definition_count',len(validated['definitions']))
+  print('validated_operational_count',len(validated['operational_rules']))
+  print('validated_proved_derived_count',len(validated['proved_derived_lemmas']))
+  print('validated_domain_count',len(validated['domain_lemmas']))
+  for i,(r,c) in enumerate(zip(inv['rules'],man['rules']),1):
+      print(f"{i:02d} {r['module']}:{r['start_line']}-{r['end_line']} {r['source_rule_id']} {c['classification']} attrs={r['attributes']}")
+  PY
+
+Exact output
+  verification_module VERIFICATION
+  verification_modules ['VERIFICATION-BASE', 'VERIFICATION']
+  verification_sha256 b8451601fa2aaa078d50afaba6a9deea095b64e08feb21fc1ceda6e3bdc6c386
+  inventory_sha256 22a541b7d4934594e95b3772f125d9c1872b0d6b37d91b7d26eb5f7bcb7908fa
+  manifest_inventory_sha256 22a541b7d4934594e95b3772f125d9c1872b0d6b37d91b7d26eb5f7bcb7908fa
+  inventory_count 10
+  manifest_count 10
+  ids_in_exact_order True
+  ids_unique_inventory True
+  ids_unique_manifest True
+  id_sets_equal True
+  validated_definition_count 9
+  validated_operational_count 0
+  validated_proved_derived_count 0
+  validated_domain_count 1
+  01 VERIFICATION-BASE:9-9 rule-b241ce9f2bd7347fcfdf85ef6584e8b5bd3d4cbf1d60172dbccd972353a6263b DEFINITION attrs=[]
+  02 VERIFICATION-BASE:12-12 rule-66cf82d7237685a06ca264938d829ef692b6502a47052bc8b2f6955fe66a6b93 DEFINITION attrs=[]
+  03 VERIFICATION-BASE:13-14 rule-17c621b67d0aacf118bb323f41413fea744bb561265d52ff628c37ad78cc2cd9 DEFINITION attrs=[]
+  04 VERIFICATION-BASE:19-19 rule-6617447b31c170258fdc23f4b1ca0dc4b3f7c945e50c08d4e290381d3e24508f DEFINITION attrs=[]
+  05 VERIFICATION-BASE:20-20 rule-b7d6ce82ec2a2ac7221e232a8762ec40e0c5f8a33688ec923438f1197c35a783 DEFINITION attrs=[]
+  06 VERIFICATION-BASE:21-22 rule-569442f388c8214bce6f506695671575b195c7d000bcc61c81f57507abc8eeae DEFINITION attrs=[]
+  07 VERIFICATION-BASE:27-27 rule-f59962ae3cbf101799667bef7e71cd44e7fc5067b67f94493ee34bff8c007791 DEFINITION attrs=['simplification']
+  08 VERIFICATION-BASE:28-31 rule-88784a48ac7e5083100f357cdc7fcd5856f28ba2c5b93d4a5efd4a85eb3dfae2 DEFINITION attrs=['simplification']
+  09 VERIFICATION-BASE:32-35 rule-6f46b6b7356839cbf0b867220b1e1216ff7a93fb8ba127ad7cd2a420f744ecf2 DEFINITION attrs=['simplification']
+  10 VERIFICATION:43-45 rule-34f56aec2aa3edbac282cf16b737d75ec1da43edea47cc5bccecc9d81dad9db0 DOMAIN_LEMMA attrs=['simplification']
+
+Independent classification judgment from the frozen source and supplied
+operational semantics
+
+  1. numericVal(V) = isInt(V) orBool isFloat(V): DEFINITION. It names the
+     Int-or-Float source-domain predicate.
+  2. numericVals(.ValSeq) = true: DEFINITION. Empty recurrence clause.
+  3. numericVals(vCons(V,REST)) = numericVal(V) andBool numericVals(REST):
+     DEFINITION. Structurally decreasing recurrence clause.
+  4. positiveNumeric(I:Int) = gtF(intToF(I),0.0): DEFINITION. Sort-specific
+     defining equation.
+  5. positiveNumeric(F:Float) = gtF(F,0.0): DEFINITION. Sort-specific
+     defining equation.
+  6. positiveNumeric(V:Val) = false outside numericVal: DEFINITION. Guarded
+     totalizing equation, disjoint from the two numeric cases.
+  7. filterPositive(ACC,.ValSeq) = ACC: DEFINITION. Empty recurrence clause.
+  8. positive-head filterPositive clause: DEFINITION. It appends the head and
+     recurs on REST.
+  9. nonpositive-head filterPositive clause: DEFINITION. It skips the head and
+     recurs on REST. The two guarded recursive clauses are complementary.
+ 10. applyCmp(">",V:Val,0.0) = positiveNumeric(V) when numericVal(V):
+     DOMAIN_LEMMA. It equates the supplied operational comparison symbol with
+     a proof-local summary. Supplied float.k defines the exact Int/Float
+     applyCmp cases; spec-connection.k proves specialized Int and Float
+     claims against VERIFICATION-BASE, but Stage 1 does not first prove this
+     exact generic rule and guard. It is therefore not PROVED_DERIVED_LEMMA,
+     not a definition of applyCmp, and not an ordinary operational rule. It is
+     directly relevant to the source branch `x > 0.0` and the result filter.
+
+All four simplification rules are therefore either DEFINITION (rules 7-9) or
+DOMAIN_LEMMA (rule 10), as required.
