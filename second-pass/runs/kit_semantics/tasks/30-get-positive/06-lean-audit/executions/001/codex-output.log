index 0000000000000000000000000000000000000000..19eab1f8b781377c8a91420bbc751c48332281fe
--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit.tMzybb/project/BridgeAudit.lean
@@ -0,0 +1,45 @@
+import Proof
+
+open Proof
+
+-- The frozen numericVal definition recognizes exactly Int and Float values.
+example : «numericVal(_)_VERIFICATION-BASE_Bool_Val»
+    (SortVal.inj_SortInt 7) = true := rfl
+example : «numericVal(_)_VERIFICATION-BASE_Bool_Val»
+    (SortVal.inj_SortFloat (2.5 : Float)) = true := rfl
+example : «numericVal(_)_VERIFICATION-BASE_Bool_Val»
+    (SortVal.inj_SortBool true) = false := rfl
+example : «numericVal(_)_VERIFICATION-BASE_Bool_Val»
+    SortVal.noneV_MPY-CORE_Val = false := rfl
+
+-- On the exact rule domain, applyCmp and positiveNumeric reduce to the same
+-- frozen primitive terms, independently for the Int and Float constructors.
+example (i : SortInt) :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+      ">" (SortVal.inj_SortInt i)
+      (SortVal.inj_SortFloat (0.0 : Float))
+    =
+    «positiveNumeric(_)_VERIFICATION-BASE_Bool_Val»
+      (SortVal.inj_SortInt i) := rfl
+
+example (f : SortFloat) :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+      ">" (SortVal.inj_SortFloat f)
+      (SortVal.inj_SortFloat (0.0 : Float))
+    =
+    «positiveNumeric(_)_VERIFICATION-BASE_Bool_Val»
+      (SortVal.inj_SortFloat f) := rfl
+
+-- Additional ground witnesses for the implemented numeric `>` dispatch.
+example :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+      ">" (SortVal.inj_SortInt 2) (SortVal.inj_SortInt 1) = true := rfl
+example :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+      ">" (SortVal.inj_SortInt (-2)) (SortVal.inj_SortInt 1) = false := rfl
+
+-- This counterexample documents that the candidate only claims the
+-- source-bound numeric `>` slice, not all unrelated applyCmp operators.
+example :
+    «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+      "==" (SortVal.inj_SortInt 1) (SortVal.inj_SortInt 1) = false := rfl
diff --git a//tmp/audit-work/lean_pid_namespace_shim.c b//tmp/audit-work/lean_pid_namespace_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..a443c04568ea3a4ef3ab336b2f1c430e519e4ba4
--- /dev/null
+++ b//tmp/audit-work/lean_pid_namespace_shim.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit runner exposes /proc from an outer PID namespace while getpid()
+ * returns the inner namespace PID. Lean 4.22 resolves its executable through
+ * /proc/<getpid()>/exe, so return the outer PID reported by /proc/self.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    pid_t value = 0;
+    ssize_t index;
+
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        return 1;
+    }
+    target[length] = '\0';
+    for (index = 0; index < length; ++index) {
+        if (target[index] < '0' || target[index] > '9') {
+            return 1;
+        }
+        value = (pid_t)(value * 10 + (target[index] - '0'));
+    }
+    return value;
+}
