+  print('inventory_count',len(ids))
+  print('manifest_count',len(mids))
+  print('ids_in_exact_order',ids==mids)
+  print('ids_unique_inventory',len(ids)==len(set(ids)))
+  print('ids_unique_manifest',len(mids)==len(set(mids)))
