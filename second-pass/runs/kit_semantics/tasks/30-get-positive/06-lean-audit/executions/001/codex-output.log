diff --git a//tmp/audit-work/lean_pid_namespace_shim.c b//tmp/audit-work/lean_pid_namespace_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..a443c04568ea3a4ef3ab336b2f1c430e519e4ba4
--- /dev/null
+++ b//tmp/audit-work/lean_pid_namespace_shim.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit runner exposes /proc from an outer PID namespace while getpid()
+ * returns the inner namespace PID. Lean 4.22 resolves its executable through
+ * /proc/<getpid()>/exe, so return the outer PID reported by /proc/self.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    pid_t value = 0;
+    ssize_t index;
+
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        return 1;
+    }
+    target[length] = '\0';
+    for (index = 0; index < length; ++index) {
+        if (target[index] < '0' || target[index] > '9') {
+            return 1;
+        }
+        value = (pid_t)(value * 10 + (target[index] - '0'));
+    }
+    return value;
+}
