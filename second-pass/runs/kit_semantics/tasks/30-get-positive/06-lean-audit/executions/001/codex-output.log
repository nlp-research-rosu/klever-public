@@ -0,0 +1,100 @@
+Trusted reconstruction command
+  PYTHONPATH=/reference python3 -c 'import json; from pathlib import Path; from tools.k_rule_inventory import inventory_verification; print(json.dumps(inventory_verification(Path("/reference/k-proof")), indent=2, sort_keys=True, ensure_ascii=False))'
