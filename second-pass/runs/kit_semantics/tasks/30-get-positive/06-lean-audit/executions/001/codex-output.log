+  print('validated_definition_count',len(validated['definitions']))
+  print('validated_operational_count',len(validated['operational_rules']))
+  print('validated_proved_derived_count',len(validated['proved_derived_lemmas']))
+  print('validated_domain_count',len(validated['domain_lemmas']))
+  for i,(r,c) in enumerate(zip(inv['rules'],man['rules']),1):
+      print(f"{i:02d} {r['module']}:{r['start_line']}-{r['end_line']} {r['source_rule_id']} {c['classification']} attrs={r['attributes']}")
+  PY
+
+Exact output
+  verification_module VERIFICATION
+  verification_modules ['VERIFICATION-BASE', 'VERIFICATION']
+  verification_sha256 b8451601fa2aaa078d50afaba6a9deea095b64e08feb21fc1ceda6e3bdc6c386
+  inventory_sha256 22a541b7d4934594e95b3772f125d9c1872b0d6b37d91b7d26eb5f7bcb7908fa
