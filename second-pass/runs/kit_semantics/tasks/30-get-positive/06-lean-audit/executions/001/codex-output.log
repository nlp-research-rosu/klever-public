    45	noncomputable local instance : DecidableEq SortKItem :=
    46	  Classical.typeDecidableEq SortKItem
    47	
    48	private noncomputable def kleanMapLookupModel
    49	    (entries : List (SortKItem × SortKItem))
    50	    (key : SortKItem) : Option SortKItem :=
    51	  match entries with
    52	  | [] => none
    53	  | (candidate, value) :: rest =>
    54	      if candidate = key then some value
    55	      else kleanMapLookupModel rest key
    56	
    57	private noncomputable def kleanMapContainsModel
    58	    (entries : List (SortKItem × SortKItem))
    59	    (key : SortKItem) : Bool :=
    60	  match entries with
    61	  | [] => false
    62	  | (candidate, _) :: rest =>
    63	      if candidate = key then true
    64	      else kleanMapContainsModel rest key
    65	
    66	private noncomputable def kleanMapDisjointModel
    67	    (left right : List (SortKItem × SortKItem)) : Bool :=
    68	  match right with
    69	  | [] => true
    70	  | (key, _) :: rest =>
    71	      if kleanMapContainsModel left key then false
    72	      else kleanMapDisjointModel left rest
    73	
    74	private noncomputable def kleanMapDeleteModel
    75	    (entries : List (SortKItem × SortKItem))
    76	    (key : SortKItem) : List (SortKItem × SortKItem) :=
    77	  match entries with
    78	  | [] => []
    79	  | (candidate, value) :: rest =>
    80	      if candidate = key then kleanMapDeleteModel rest key
    81	      else (candidate, value) :: kleanMapDeleteModel rest key
    82	
    83	private noncomputable def kleanMapUpdateModel
    84	    (entries : List (SortKItem × SortKItem))
    85	    (key value : SortKItem) : List (SortKItem × SortKItem) :=
    86	  match entries with
    87	  | [] => [(key, value)]
    88	  | (candidate, oldValue) :: rest =>
    89	      if candidate = key then (key, value) :: rest
    90	      else (candidate, oldValue) :: kleanMapUpdateModel rest key value
