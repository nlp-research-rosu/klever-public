+  workspace=Path('/reference/k-proof')
+  manifest_path=Path('/reference/lemma-discovery.json')
+  inv=inventory_verification(workspace)
+  man=json.loads(manifest_path.read_text())
+  validated=validate_trust_boundary(workspace, manifest_path)
+  ids=[r['source_rule_id'] for r in inv['rules']]
+  mids=[r['source_rule_id'] for r in man['rules']]
+  print('verification_module',inv['verification_module'])
+  print('verification_modules',inv['verification_modules'])
+  print('verification_sha256',inv['verification_sha256'])
+  print('inventory_sha256',inv['inventory_sha256'])
+  print('manifest_inventory_sha256',man['inventory_sha256'])
+  print('inventory_count',len(ids))
+  print('manifest_count',len(mids))
+  print('ids_in_exact_order',ids==mids)
+  print('ids_unique_inventory',len(ids)==len(set(ids)))
+  print('ids_unique_manifest',len(mids)==len(set(mids)))
+  print('id_sets_equal',set(ids)==set(mids))
+  print('validated_definition_count',len(validated['definitions']))
+  print('validated_operational_count',len(validated['operational_rules']))
+  print('validated_proved_derived_count',len(validated['proved_derived_lemmas']))
+  print('validated_domain_count',len(validated['domain_lemmas']))
+  for i,(r,c) in enumerate(zip(inv['rules'],man['rules']),1):
+      print(f"{i:02d} {r['module']}:{r['start_line']}-{r['end_line']} {r['source_rule_id']} {c['classification']} attrs={r['attributes']}")
+  PY
