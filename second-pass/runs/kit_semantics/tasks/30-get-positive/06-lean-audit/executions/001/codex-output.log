+  inv=inventory_verification(workspace)
+  man=json.loads(manifest_path.read_text())
+  validated=validate_trust_boundary(workspace, manifest_path)
+  ids=[r['source_rule_id'] for r in inv['rules']]
+  mids=[r['source_rule_id'] for r in man['rules']]
+  print('verification_module',inv['verification_module'])
+  print('verification_modules',inv['verification_modules'])
+  print('verification_sha256',inv['verification_sha256'])
