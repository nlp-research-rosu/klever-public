+Lean's exact elaborated target-parameter definitions
+  def Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» : SortString → SortVal → SortVal → SortBool :=
+  fun x x_1 x_2 =>
+    match x, x_1, x_2 with
+    | ">", SortVal.inj_SortInt left, SortVal.inj_SortInt right => decide (left > right)
+    | ">", SortVal.inj_SortInt left, SortVal.inj_SortFloat right =>
+      Proof.totalFloatGreater✝ (Proof.totalIntToFloat✝ left) right
+    | ">", SortVal.inj_SortFloat left, SortVal.inj_SortInt right =>
+      Proof.totalFloatGreater✝ left (Proof.totalIntToFloat✝ right)
+    | ">", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right => Proof.totalFloatGreater✝ left right
+    | x, x_3, x_4 => false
+  def Proof.«numericVal(_)_VERIFICATION-BASE_Bool_Val» : SortVal → SortBool :=
+  fun x =>
+    match x with
+    | SortVal.inj_SortInt x => true
+    | SortVal.inj_SortFloat x => true
+    | x => false
+  def Proof.«positiveNumeric(_)_VERIFICATION-BASE_Bool_Val» : SortVal → SortBool :=
+  fun x =>
+    match x with
+    | SortVal.inj_SortInt value => Proof.totalFloatGreater✝ (Proof.totalIntToFloat✝ value) 0.0
+    | SortVal.inj_SortFloat value => Proof.totalFloatGreater✝ value 0.0
+    | x => false
