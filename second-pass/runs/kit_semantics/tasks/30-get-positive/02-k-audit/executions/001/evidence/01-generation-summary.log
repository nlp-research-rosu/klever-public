+  syntax NumSeq ::= ".NumSeq"
+                  | numI(Int, NumSeq)
+                  | numF(Float, NumSeq)
+
+  syntax ValSeq ::= numVals(NumSeq) [function, total]
+  rule numVals(.NumSeq)       => .ValSeq
+  rule numVals(numI(I, REST)) => vCons(I, numVals(REST))
+  rule numVals(numF(F, REST)) => vCons(F, numVals(REST))
+
+  // Exact accumulator-style filtering summary.  Its guards are the same
+  // positivity atoms reached by MPY execution of `x > 0`.
+  syntax ValSeq ::= filterPositive(ValSeq, NumSeq) [function, total]
+  rule filterPositive(ACC, .NumSeq) => ACC
+
+  rule filterPositive(ACC, numI(I, REST))
+    => filterPositive(valSeqConcat(ACC, vCons(I, .ValSeq)), REST)
+    requires I >Int 0
+  rule filterPositive(ACC, numI(I, REST))
+    => filterPositive(ACC, REST)
+    requires I <=Int 0
+
+  rule filterPositive(ACC, numF(F, REST))
+    => filterPositive(valSeqConcat(ACC, vCons(F, .ValSeq)), REST)
+    requires gtF(F, intToF(0))
+  rule filterPositive(ACC, numF(F, REST))
+    => filterPositive(ACC, REST)
+    requires notBool gtF(F, intToF(0))
+endmodule
