     1	#!/usr/bin/env python3
     2	"""Finite CPython-oracle versus MPY/LLVM differential evidence."""
     3	
     4	from __future__ import annotations
     5	
     6	import random
     7	import subprocess
     8	from pathlib import Path
     9	
    10	from solution import get_positive
    11	
    12	
    13	ROOT = Path(__file__).resolve().parent
    14	
    15	
    16	def cases() -> list[list[int | float]]:
    17	    fixed: list[list[int | float]] = [
    18	        [],
    19	        [0],
    20	        [-1],
    21	        [1],
    22	        [-1, 0, 1],
    23	        [-0.0, 0.0, 0.25, -0.25],
    24	        [-2.5, 0.0, 1.25, 7],
    25	        [-1, 2, -4, 5, 6],
    26	        [5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10],
    27	        [-(10**30), 10**30, -1.0e200, 1.0e200],
    28	    ]
    29	    rng = random.Random(20260729)
    30	    pool: list[int | float] = [
    31	        -1000,
    32	        -7,
    33	        -1,
    34	        0,
    35	        1,
    36	        7,
    37	        1000,
    38	        -99.75,
    39	        -0.5,
    40	        -0.0,
    41	        0.0,
    42	        0.5,
    43	        99.75,
    44	    ]
    45	    sampled = [
    46	        [rng.choice(pool) for _ in range(rng.randrange(0, 9))]
    47	        for _ in range(50)
    48	    ]
    49	    return fixed + sampled
    50	
    51	
    52	def oracle(values: list[int | float]) -> list[int | float]:
    53	    # Independent implementation form: this does not call get_positive and
    54	    # shares none of the K summary equations.
    55	    return [value for value in values if value > 0]
    56	
    57	
    58	def main() -> int:
    59	    test_cases = cases()
    60	    mismatches = [
    61	        (values, get_positive(values), oracle(values))
    62	        for values in test_cases
    63	        if get_positive(values) != oracle(values)
    64	    ]
    65	    if mismatches:
    66	        raise AssertionError(f"CPython mismatches: {mismatches!r}")
    67	
    68	    solution_source = (ROOT / "solution.py").read_text(encoding="utf-8")
    69	    assertions = "\n".join(
    70	        f"assert get_positive({values!r}) == {oracle(values)!r}"
    71	        for values in test_cases
    72	    )
    73	    smoke_source = solution_source + "\n\n" + assertions + "\n"
    74	    smoke_py = ROOT / "differential-smoke.py"
    75	    smoke_mpy = ROOT / "differential-smoke.mpy"
    76	    smoke_py.write_text(smoke_source, encoding="utf-8")
    77	
    78	    translated = subprocess.run(
    79	        ["python3", "py2mpy.py", smoke_py.name],
    80	        cwd=ROOT,
    81	        check=True,
    82	        text=True,
    83	        stdout=subprocess.PIPE,
    84	    )
    85	    smoke_mpy.write_text(translated.stdout, encoding="utf-8")
    86	
    87	    executed = subprocess.run(
    88	        ["krun", smoke_mpy.name, "--definition", "runtime-kompiled"],
    89	        cwd=ROOT,
    90	        check=True,
    91	        text=True,
    92	        stdout=subprocess.PIPE,
    93	        stderr=subprocess.PIPE,
    94	    )
    95	    if "<exit-code>\n    0\n  </exit-code>" not in executed.stdout:
    96	        raise AssertionError(
    97	            "MPY/LLVM assertion failure:\n"
    98	            + executed.stdout[-4000:]
    99	            + executed.stderr[-4000:]
   100	        )
   101	
   102	    print(
   103	        f"cases={len(test_cases)} "
   104	        "cpython_mismatches=0 mpy_llvm_mismatches=0"
   105	    )
   106	    return 0
   107	
   108	
   109	if __name__ == "__main__":
   110	    raise SystemExit(main())
END /candidate/differential_test.py
