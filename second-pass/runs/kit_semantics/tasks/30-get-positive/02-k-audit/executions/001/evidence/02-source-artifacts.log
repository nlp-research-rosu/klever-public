    34	             closureVal(
    35	               "l",
    36	               Expr(Str("Return only positive numbers in the list."))
    37	               Assign(Name("positive"), ListExpr(.Exprs))
    38	               Assign(Name("x"), Int(0))
    39	               For(
    40	                 Name("x"),
