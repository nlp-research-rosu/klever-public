     2	
     3	module SPEC-BODY-MUTATION
     4	  imports VERIFICATION
     5	
     6	  // Deliberately mutated body: the positive branch evaluates None instead
     7	  // of appending x, while the claim still demands the original singleton.
     8	  claim [removed-append]:
     9	    <k>
    10	      FuncDef(
    11	        "get_positive",
