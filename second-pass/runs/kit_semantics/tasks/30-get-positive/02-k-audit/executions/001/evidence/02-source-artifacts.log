    44	                   Expr(NoneVal),
    45	                   .Stmts))
    46	               Return(Name("positive")),
    47	               0),
    48	        parent(-1))
    49	      -1 |-> builtinsScope
    50	    </scopes>
    51	    <scopeLoc> 1 </scopeLoc>
    52	    <heap>
    53	      .Map => 0 |-> list(vCons(I, .ValSeq))
    54	    </heap>
    55	    <heapLoc> 0 => 1 </heapLoc>
    56	    <stack> .List </stack>
    57	    <ret> noRet </ret>
    58	    <exc> NoExc </exc>
    59	    <exit-code> 0 </exit-code>
