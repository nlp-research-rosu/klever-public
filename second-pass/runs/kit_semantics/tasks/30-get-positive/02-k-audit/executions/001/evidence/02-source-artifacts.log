BEGIN /reference/canonical.py
     1	# canonical.py — the UNMODIFIED HumanEval/30 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: get_positive
     4	
     5	
     6	
     7	def get_positive(l: list):
     8	    """Return only positive numbers in the list.
     9	    >>> get_positive([-1, 2, -4, 5, 6])
    10	    [2, 5, 6]
    11	    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])
    12	    [5, 3, 2, 3, 9, 123, 1]
    13	    """
    14	    return [e for e in l if e > 0]
END /reference/canonical.py
BEGIN /candidate/solution.py
     1	def get_positive(l: list):
     2	    """Return only positive numbers in the list."""
     3	    positive = []
     4	    x = 0
     5	    for x in l:
     6	        if x > 0.0:
     7	            positive.append(x)
     8	    return positive
END /candidate/solution.py
BEGIN /candidate/solution.mpy
     1	Module(
     2	  FuncDef("get_positive", Params("l"),
     3	    Expr(Str("Return only positive numbers in the list."))
     4	    Assign(Name("positive"), ListExpr())
     5	    Assign(Name("x"), Int(0))
     6	    For(Name("x"), Name("l"),
     7	      If(Compare(Name("x"), CmpOp(">", Float(0.0))),
     8	        Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
     9	        ))
    10	    Return(Name("positive"))))
END /candidate/solution.mpy
BEGIN /candidate/verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // The source contract's material domain: arbitrary finite lists whose
     7	  // elements are Python integers or floats.
     8	  syntax Bool ::= numericVal(Val) [function, total]
     9	  rule numericVal(V) => isInt(V) orBool isFloat(V)
    10	
    11	  syntax Bool ::= numericVals(ValSeq) [function, total]
    12	  rule numericVals(.ValSeq) => true
    13	  rule numericVals(vCons(V, REST))
    14	    => numericVal(V) andBool numericVals(REST)
    15	
    16	  // A total mathematical predicate.  On the numeric domain its two
    17	  // sort-disjoint equations are exactly MPY's `applyCmp(">", _, 0.0)` cases.
    18	  syntax Bool ::= positiveNumeric(Val) [function, total]
    19	  rule positiveNumeric(I:Int) => gtF(intToF(I), 0.0)
    20	  rule positiveNumeric(F:Float) => gtF(F, 0.0)
    21	  rule positiveNumeric(V:Val) => false
    22	    requires notBool numericVal(V)
    23	
    24	  // Exact accumulator-style filtering summary.  Its guards are the same
    25	  // positivity atoms reached by MPY execution of `x > 0`.
    26	  syntax ValSeq ::= filterPositive(ValSeq, ValSeq) [function, total]
    27	  rule filterPositive(ACC, .ValSeq) => ACC [simplification]
    28	  rule filterPositive(ACC, vCons(V, REST))
    29	    => filterPositive(valSeqConcat(ACC, vCons(V, .ValSeq)), REST)
    30	    requires positiveNumeric(V)
    31	    [simplification]
    32	  rule filterPositive(ACC, vCons(V, REST))
    33	    => filterPositive(ACC, REST)
    34	    requires notBool positiveNumeric(V)
    35	    [simplification]
    36	endmodule
    37	
    38	module VERIFICATION
    39	  imports VERIFICATION-BASE
    40	
    41	  // Guarded dynamic-sort dispatch twin.  Its complete domain is numeric
    42	  // values compared with the float literal zero.
    43	  rule applyCmp(">", V:Val, 0.0) => positiveNumeric(V)
    44	    requires numericVal(V)
    45	    [simplification]
    46	endmodule
END /candidate/verification.k
