END /candidate/spec-connection.k
BEGIN /candidate/prove.sh
     1	#!/bin/sh
     2	set -eu
     3	
     4	# Recreate the translated program.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Concrete execution under the required LLVM main and syntax modules.
     8	kompile reference-semantics/semantics.k \
     9	  --backend llvm \
    10	  --main-module MPY-KRUN \
    11	  --syntax-module MPY-SYNTAX \
    12	  --output-definition runtime-kompiled
    13	python3 py2mpy.py smoke.py > smoke.mpy
    14	krun smoke.mpy --definition runtime-kompiled
    15	python3 differential_test.py
    16	
    17	# Bridge-free connection proof: VERIFICATION-BASE does not import the guarded
    18	# dynamic-dispatch simplification rule in module VERIFICATION.
    19	kompile --backend haskell verification.k \
    20	  --main-module VERIFICATION-BASE \
    21	  --syntax-module MPY-SYNTAX \
    22	  --output-definition connection-kompiled
    23	kprove spec-connection.k \
    24	  --definition connection-kompiled \
    25	  --spec-module SPEC-CONNECTION
    26	
    27	# Required unbounded target proof.
    28	kompile --backend haskell verification.k \
    29	  --main-module VERIFICATION \
    30	  --syntax-module MPY-SYNTAX \
    31	  --output-definition verification-kompiled
    32	kprove spec.k \
    33	  --definition verification-kompiled \
    34	  --spec-module SPEC \
    35	  --claims SPEC.filter-loop
    36	kprove spec.k \
    37	  --definition verification-kompiled \
    38	  --spec-module SPEC
    39	
    40	# Gate A5: the deliberately false result must not prove.
    41	if kprove spec-vacuity.k \
    42	    --definition verification-kompiled \
    43	    --spec-module SPEC-VACUITY
    44	then
    45	  echo "ERROR: false-result mutation unexpectedly proved" >&2
    46	  exit 1
    47	else
    48	  echo "EXPECTED FAILURE: false-result mutation rejected"
    49	fi
    50	
    51	# Gate A1: removing append from the body must invalidate the result claim.
    52	if kprove spec-body-mutation.k \
    53	    --definition verification-kompiled \
    54	    --spec-module SPEC-BODY-MUTATION
    55	then
    56	  echo "ERROR: body mutation unexpectedly proved" >&2
    57	  exit 1
    58	else
    59	  echo "EXPECTED FAILURE: removed-append mutation rejected"
    60	fi
END /candidate/prove.sh
