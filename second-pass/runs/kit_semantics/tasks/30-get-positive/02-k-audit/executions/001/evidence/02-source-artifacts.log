BEGIN /candidate/spec-connection.k
     1	requires "verification.k"
     2	
     3	module SPEC-CONNECTION
     4	  imports VERIFICATION-BASE
     5	
     6	  // Together these two claims cover exactly numericVal(V): Int or Float.
     7	  // They are proved with a definition that does not import VERIFICATION's
     8	  // guarded dynamic-dispatch simplification rule.
     9	  claim [compare-int-connection]:
    10	    <k>
    11	      Compare(I:Int, CmpOp(">", Float(0.0)))
    12	      => positiveNumeric(I)
    13	      ...
    14	    </k>
    15	
    16	  claim [compare-float-connection]:
    17	    <k>
    18	      Compare(F:Float, CmpOp(">", Float(0.0)))
    19	      => positiveNumeric(F)
    20	      ...
    21	    </k>
    22	
    23	  claim [applycmp-int-connection]:
    24	    <k>
    25	      applyCmp(">", I:Int, 0.0)
