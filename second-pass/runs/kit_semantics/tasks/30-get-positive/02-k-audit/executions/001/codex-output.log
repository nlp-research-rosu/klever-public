+    candidate_prompt_equal = Path("/candidate/prompt.py").read_bytes() == Path("/reference/prompt.py").read_bytes()
+    candidate_translator_equal = Path("/candidate/py2mpy.py").read_bytes() == Path("/reference/py2mpy.py").read_bytes()
