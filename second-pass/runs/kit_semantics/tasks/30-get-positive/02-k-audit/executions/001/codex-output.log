@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG_FILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$log_file"
+
+"$@" >>"$log_file" 2>&1
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status" >>"$log_file"
+exit "$status"
