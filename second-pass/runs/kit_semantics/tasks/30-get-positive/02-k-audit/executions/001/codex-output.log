+        [0],
+        [0.0],
+        [-0.0],
+        [-1],
+        [1],
+        [-1.0],
+        [1.0],
+        [-(2**63), 2**63 - 1],
+        [-(10**100), 10**100],
+        [float("-inf"), -5e-324, -0.0, 0, 0.0, 5e-324, float("inf")],
+        [float("nan"), -1, 0, 1],
