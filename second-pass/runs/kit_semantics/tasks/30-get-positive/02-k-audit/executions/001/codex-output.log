/bin/bash -lc 'chmod +x /audit-output/evidence/check_integrity.py /audit-output/evidence/summarize_generation.py && /audit-output/evidence/run_logged.sh /audit-output/evidence/01-integrity-check.log python3 /audit-output/evidence/check_integrity.py && /audit-output/evidence/run_logged.sh /audit-output/evidence/01-generation-summary.log python3 /audit-output/evidence/summarize_generation.py' in /audit-output
