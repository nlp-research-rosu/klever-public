{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "b241ce9f2bd7347fcfdf85ef6584e8b5bd3d4cbf1d60172dbccd972353a6263b",
      "rationale": "This equation defines the proof-local numericVal predicate as the disjunction of the existing Int and Float sort predicates; it introduces a named domain summary and does not add a separate mathematical fact.",
      "source_rule_id": "rule-b241ce9f2bd7347fcfdf85ef6584e8b5bd3d4cbf1d60172dbccd972353a6263b",
      "start_line": 9,
      "text": "  rule numericVal(V) => isInt(V) orBool isFloat(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "66cf82d7237685a06ca264938d829ef692b6502a47052bc8b2f6955fe66a6b93",
      "rationale": "This is the base equation of the structural numericVals recurrence, defining the empty value sequence to satisfy the numeric-domain predicate.",
      "source_rule_id": "rule-66cf82d7237685a06ca264938d829ef692b6502a47052bc8b2f6955fe66a6b93",
      "start_line": 12,
      "text": "  rule numericVals(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 14,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "17c621b67d0aacf118bb323f41413fea744bb561265d52ff628c37ad78cc2cd9",
      "rationale": "This is the cons equation of the structural numericVals recurrence, defining a sequence to be numeric from its head predicate and recursively defined tail predicate.",
      "source_rule_id": "rule-17c621b67d0aacf118bb323f41413fea744bb561265d52ff628c37ad78cc2cd9",
      "start_line": 13,
      "text": "  rule numericVals(vCons(V, REST))\n    => numericVal(V) andBool numericVals(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "6617447b31c170258fdc23f4b1ca0dc4b3f7c945e50c08d4e290381d3e24508f",
      "rationale": "This sort-specific equation defines positiveNumeric on Int values using the supplied comparison-domain terms gtF and intToF.",
      "source_rule_id": "rule-6617447b31c170258fdc23f4b1ca0dc4b3f7c945e50c08d4e290381d3e24508f",
      "start_line": 19,
      "text": "  rule positiveNumeric(I:Int) => gtF(intToF(I), 0.0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 20,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "b7d6ce82ec2a2ac7221e232a8762ec40e0c5f8a33688ec923438f1197c35a783",
      "rationale": "This sort-specific equation defines positiveNumeric on Float values using the supplied gtF comparison term.",
      "source_rule_id": "rule-b7d6ce82ec2a2ac7221e232a8762ec40e0c5f8a33688ec923438f1197c35a783",
      "start_line": 20,
      "text": "  rule positiveNumeric(F:Float) => gtF(F, 0.0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "569442f388c8214bce6f506695671575b195c7d000bcc61c81f57507abc8eeae",
      "rationale": "This guarded default equation completes the total definition of positiveNumeric by assigning false exactly outside the Int-or-Float domain.",
      "source_rule_id": "rule-569442f388c8214bce6f506695671575b195c7d000bcc61c81f57507abc8eeae",
      "start_line": 21,
      "text": "  rule positiveNumeric(V:Val) => false\n    requires notBool numericVal(V)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "f59962ae3cbf101799667bef7e71cd44e7fc5067b67f94493ee34bff8c007791",
      "rationale": "This simplification equation is the base case of the filterPositive recurrence: filtering no remaining elements returns the accumulator unchanged.",
      "source_rule_id": "rule-f59962ae3cbf101799667bef7e71cd44e7fc5067b67f94493ee34bff8c007791",
      "start_line": 27,
      "text": "  rule filterPositive(ACC, .ValSeq) => ACC [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "88784a48ac7e5083100f357cdc7fcd5856f28ba2c5b93d4a5efd4a85eb3dfae2",
      "rationale": "This simplification equation is the positive-head case of the filterPositive recurrence, defining the summary by appending the head and recurring on the structurally smaller tail.",
      "source_rule_id": "rule-88784a48ac7e5083100f357cdc7fcd5856f28ba2c5b93d4a5efd4a85eb3dfae2",
      "start_line": 28,
      "text": "  rule filterPositive(ACC, vCons(V, REST))\n    => filterPositive(valSeqConcat(ACC, vCons(V, .ValSeq)), REST)\n    requires positiveNumeric(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "6f46b6b7356839cbf0b867220b1e1216ff7a93fb8ba127ad7cd2a420f744ecf2",
      "rationale": "This simplification equation is the nonpositive-head case of the filterPositive recurrence, defining the summary by skipping the head and recurring on the structurally smaller tail.",
      "source_rule_id": "rule-6f46b6b7356839cbf0b867220b1e1216ff7a93fb8ba127ad7cd2a420f744ecf2",
      "start_line": 32,
      "text": "  rule filterPositive(ACC, vCons(V, REST))\n    => filterPositive(ACC, REST)\n    requires notBool positiveNumeric(V)\n    [simplification]"
    }
  ],
