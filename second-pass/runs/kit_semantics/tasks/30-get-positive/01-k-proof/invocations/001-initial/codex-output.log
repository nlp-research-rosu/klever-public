+        Return(Name("positive")))
+      ~> Call(
+           Name("get_positive"),
+           list(vCons(I:Int, .ValSeq)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "get_positive" |->
