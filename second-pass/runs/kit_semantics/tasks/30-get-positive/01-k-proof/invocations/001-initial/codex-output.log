diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..4558a85c212d74eaf760c901c2b209ab60ed519d
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: the positive branch evaluates None instead
+  // of appending x, while the claim still demands the original singleton.
+  claim [removed-append]:
+    <k>
+      FuncDef(
+        "get_positive",
+        Params("l"),
+        Expr(Str("Return only positive numbers in the list."))
+        Assign(Name("positive"), ListExpr(.Exprs))
+        Assign(Name("x"), Int(0))
+        For(
+          Name("x"),
+          Name("l"),
+          If(
+            Compare(Name("x"), CmpOp(">", Float(0.0))),
+            Expr(NoneVal),
+            .Stmts))
+        Return(Name("positive")))
+      ~> Call(
+           Name("get_positive"),
+           list(vCons(I:Int, .ValSeq)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "get_positive" |->
+             closureVal(
+               "l",
+               Expr(Str("Return only positive numbers in the list."))
+               Assign(Name("positive"), ListExpr(.Exprs))
+               Assign(Name("x"), Int(0))
+               For(
+                 Name("x"),
+                 Name("l"),
+                 If(
+                   Compare(Name("x"), CmpOp(">", Float(0.0))),
+                   Expr(NoneVal),
+                   .Stmts))
+               Return(Name("positive")),
+               0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(vCons(I, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires positiveNumeric(I)
+endmodule
diff --git a/spec-connection.k b/spec-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..94421d3046c151223ed1abae75b6f92e7caf70a3
--- /dev/null
+++ b/spec-connection.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SPEC-CONNECTION
+  imports VERIFICATION-BASE
+
+  // Together these two claims cover exactly numericVal(V): Int or Float.
+  // They are proved with a definition that does not import VERIFICATION's
+  // guarded dynamic-dispatch simplification rule.
+  claim [compare-int-connection]:
+    <k>
+      Compare(I:Int, CmpOp(">", Float(0.0)))
+      => positiveNumeric(I)
+      ...
+    </k>
+
+  claim [compare-float-connection]:
+    <k>
+      Compare(F:Float, CmpOp(">", Float(0.0)))
+      => positiveNumeric(F)
+      ...
+    </k>
+
+  claim [applycmp-int-connection]:
+    <k>
+      applyCmp(">", I:Int, 0.0)
+      => positiveNumeric(I)
+      ...
+    </k>
+
+  claim [applycmp-float-connection]:
+    <k>
+      applyCmp(">", F:Float, 0.0)
+      => positiveNumeric(F)
+      ...
+    </k>
+endmodule
