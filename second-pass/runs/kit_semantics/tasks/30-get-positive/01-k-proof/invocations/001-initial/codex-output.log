index 0000000000000000000000000000000000000000..7bd6cd2d940950d2f0e95c10c398835d4f9b6ef4
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,85 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp(">", Int(0))),
+          Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(M:Map => ?M:Map, P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ...
+      H:Int |-> list(ACC:ValSeq => filterPositive(ACC, VS))
+      ...
+    </heap>
+    requires numericVals(VS)
+      andBool notBool ("$cells" in_keys(M))
+      andBool "positive" in_keys(M)
+      andBool {M["positive"]}:>Val ==K ref(H)
+    ensures "positive" in_keys(?M)
+      andBool {?M["positive"]}:>Val ==K ref(H)
+
+  claim [get-positive]:
+    <k>
+      FuncDef(
+        "get_positive",
+        Params("l"),
+        Expr(Str("Return only positive numbers in the list."))
+        Assign(Name("positive"), ListExpr(.Exprs))
+        For(
+          Name("x"),
+          Name("l"),
+          If(
+            Compare(Name("x"), CmpOp(">", Int(0))),
+            Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
+            .Stmts))
+        Return(Name("positive")))
+      ~> Call(Name("get_positive"), list(VS:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "get_positive" |->
+             closureVal(
+               "l",
+               Expr(Str("Return only positive numbers in the list."))
+               Assign(Name("positive"), ListExpr(.Exprs))
+               For(
+                 Name("x"),
+                 Name("l"),
+                 If(
+                   Compare(Name("x"), CmpOp(">", Int(0))),
+                   Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
+                   .Stmts))
+               Return(Name("positive")),
+               0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(filterPositive(.ValSeq, VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVals(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4d9111006363d2e147fc1e94cf6413f918ffd84c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The source contract's material domain: arbitrary finite lists whose
+  // elements are Python integers or floats.
+  syntax Bool ::= numericVals(ValSeq) [function, total]
+  rule numericVals(.ValSeq) => true
+  rule numericVals(vCons(V, REST))
+    => (isInt(V) orBool isFloat(V)) andBool numericVals(REST)
+
+  // Exact accumulator-style filtering summary.  Its guards are the same
+  // positivity atoms reached by MPY execution of `x > 0`.
+  syntax ValSeq ::= filterPositive(ValSeq, ValSeq) [function]
+  rule filterPositive(ACC, .ValSeq) => ACC
+  rule filterPositive(ACC, vCons(V, REST))
+    => filterPositive(valSeqConcat(ACC, vCons(V, .ValSeq)), REST)
+    requires (isInt(V) orBool isFloat(V))
+      andBool applyCmp(">", V, 0)
+  rule filterPositive(ACC, vCons(V, REST))
+    => filterPositive(ACC, REST)
+    requires (isInt(V) orBool isFloat(V))
+      andBool notBool applyCmp(">", V, 0)
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..0038f053a5f936b95f47c627a4bbc36d4264359d
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,20 @@
+def get_positive(l: list):
+    """Return only positive numbers in the list."""
+    positive = []
+    for x in l:
+        if x > 0:
+            positive.append(x)
+    return positive
+
+
+assert get_positive([-1, 2, -4, 5, 6]) == [2, 5, 6]
+assert get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]) == [
+    5,
+    3,
+    2,
+    3,
+    9,
+    123,
+    1,
+]
+assert get_positive([-2.5, 0.0, 1.25, 7]) == [1.25, 7]
