diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3e5f2f188fe5372fbb3953b516d6361a217dd70e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,87 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp(">", Int(0))),
+          Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |->
+        scope(
+          "l" |-> INPUT:Val
+          "positive" |-> ref(H)
+          "x" |-> (X:Val => ?X:Val),
+          parent(0))
+      ...
+    </scopes>
+    <heap>
+      ...
+      H:Int |-> list(ACC:ValSeq => filterPositive(ACC, VS))
+      ...
+    </heap>
+    requires numericVals(VS)
+
+  claim [get-positive]:
+    <k>
+      FuncDef(
+        "get_positive",
+        Params("l"),
+        Expr(Str("Return only positive numbers in the list."))
+        Assign(Name("positive"), ListExpr(.Exprs))
+        Assign(Name("x"), Int(0))
+        For(
+          Name("x"),
+          Name("l"),
+          If(
+            Compare(Name("x"), CmpOp(">", Int(0))),
+            Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
+            .Stmts))
+        Return(Name("positive")))
+      ~> Call(Name("get_positive"), list(VS:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "get_positive" |->
+             closureVal(
+               "l",
+               Expr(Str("Return only positive numbers in the list."))
+               Assign(Name("positive"), ListExpr(.Exprs))
+               Assign(Name("x"), Int(0))
+               For(
+                 Name("x"),
+                 Name("l"),
+                 If(
+                   Compare(Name("x"), CmpOp(">", Int(0))),
+                   Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
+                   .Stmts))
+               Return(Name("positive")),
+               0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(filterPositive(.ValSeq, VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVals(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8a7ed8d56ef2251b82773d401c81a951e5d1ac38
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,50 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // Haskell has no Int2Float hook.  IEEE-754 conversion of integer zero is
+  // exact; this ground simplification avoids evaluating the missing hook.
+  rule intToF(0) => 0.0 [simplification]
+
+  // The source contract's material domain: arbitrary finite lists whose
+  // elements are Python integers or floats.
+  syntax Bool ::= numericVal(Val) [function, total]
+  rule numericVal(V) => isInt(V) orBool isFloat(V)
+
+  syntax Bool ::= numericVals(ValSeq) [function, total]
+  rule numericVals(.ValSeq) => true
+  rule numericVals(vCons(V, REST))
+    => numericVal(V) andBool numericVals(REST)
+
+  // A total mathematical predicate.  On the numeric domain its two
+  // sort-disjoint equations are exactly MPY's `applyCmp(">", _, 0)` cases.
+  syntax Bool ::= positiveNumeric(Val) [function, total]
+  rule positiveNumeric(I:Int) => I >Int 0
+  rule positiveNumeric(F:Float) => gtF(F, intToF(0))
+  rule positiveNumeric(V:Val) => false
+    requires notBool numericVal(V)
+
+  // Exact accumulator-style filtering summary.  Its guards are the same
+  // positivity atoms reached by MPY execution of `x > 0`.
+  syntax ValSeq ::= filterPositive(ValSeq, ValSeq) [function, total]
+  rule filterPositive(ACC, .ValSeq) => ACC [simplification]
+  rule filterPositive(ACC, vCons(V, REST))
+    => filterPositive(valSeqConcat(ACC, vCons(V, .ValSeq)), REST)
+    requires positiveNumeric(V)
+    [simplification]
+  rule filterPositive(ACC, vCons(V, REST))
+    => filterPositive(ACC, REST)
+    requires notBool positiveNumeric(V)
+    [simplification]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Guarded dynamic-sort dispatch twin.  Its complete domain is numeric
+  // values compared with the integer literal zero.
+  rule applyCmp(">", V:Val, 0) => positiveNumeric(V)
+    requires numericVal(V)
+    [simplification]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION-BASE --syntax-module MPY-SYNTAX --output-definition connection-kompiled' in /workspace
exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
