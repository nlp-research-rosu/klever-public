diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..0038f053a5f936b95f47c627a4bbc36d4264359d
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,20 @@
+def get_positive(l: list):
+    """Return only positive numbers in the list."""
+    positive = []
+    for x in l:
+        if x > 0:
+            positive.append(x)
+    return positive
+
+
+assert get_positive([-1, 2, -4, 5, 6]) == [2, 5, 6]
+assert get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]) == [
+    5,
+    3,
+    2,
+    3,
+    9,
+    123,
+    1,
+]
+assert get_positive([-2.5, 0.0, 1.25, 7]) == [1.25, 7]
