Module(
  FuncDef("get_positive", Params("l"),
    Expr(Str("Return only positive numbers in the list."))
    Assign(Name("positive"), ListExpr())
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp(">", Float(0.0))),
        Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
        ))
    Return(Name("positive")))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(Int(0))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(UnaryOp("-", Int(1)), Int(0), Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.0)),
          Float(0.0),
          Float(0.25),
          UnaryOp("-", Float(0.25)))),
      CmpOp("==", ListExpr(Float(0.25)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(2.5)),
          Float(0.0),
          Float(1.25),
          Int(7))),
      CmpOp("==", ListExpr(Float(1.25), Int(7)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1)),
          Int(2),
          UnaryOp("-", Int(4)),
          Int(5),
          Int(6))),
      CmpOp("==", ListExpr(Int(2), Int(5), Int(6)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(5),
          Int(3),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(3)),
          Int(3),
          Int(9),
          Int(0),
          Int(123),
          Int(1),
          UnaryOp("-", Int(10)))),
      CmpOp(
        "==",
        ListExpr(
          Int(5),
          Int(3),
          Int(2),
          Int(3),
          Int(9),
          Int(123),
          Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1000000000000000000000000000000)),
          Int(1000000000000000000000000000000),
          UnaryOp("-", Float(1e+200)),
          Float(1e+200))),
      CmpOp(
        "==",
        ListExpr(Int(1000000000000000000000000000000), Float(1e+200)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Float(0.0),
          UnaryOp("-", Float(99.75)),
          Int(1000),
          Float(0.5),
          Int(0),
          Int(1))),
      CmpOp("==", ListExpr(Int(1000), Float(0.5), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(1)), Int(0))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Float(99.75),
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Float(99.75)))),
      CmpOp("==", ListExpr(Float(99.75)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.0)),
          Int(7),
          Float(0.5),
          Float(0.5),
          Int(7))),
      CmpOp("==", ListExpr(Int(7), Float(0.5), Float(0.5), Int(7)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(Float(0.5), Int(1), Float(0.0))),
      CmpOp("==", ListExpr(Float(0.5), Int(1)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(Int(1000))),
      CmpOp("==", ListExpr(Int(1000)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(99.75)),
          Int(1),
          Float(99.75),
          Float(0.5),
          UnaryOp("-", Float(0.5)),
          Float(99.75),
          Float(99.75),
          Int(7))),
      CmpOp(
        "==",
        ListExpr(
          Int(1),
          Float(99.75),
          Float(0.5),
          Float(99.75),
          Float(99.75),
          Int(7)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(0),
          UnaryOp("-", Float(99.75)),
          UnaryOp("-", Float(0.0)),
          UnaryOp("-", Float(0.0)),
          Float(0.0),
          UnaryOp("-", Float(0.5)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.5)),
          Int(1),
          UnaryOp("-", Int(7)),
          UnaryOp("-", Float(0.0)),
          UnaryOp("-", Float(99.75)),
          UnaryOp("-", Int(1000)),
          UnaryOp("-", Int(1000)))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(UnaryOp("-", Float(99.75)), Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(Int(1), Float(0.0))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Float(0.5)),
          Int(7),
          UnaryOp("-", Int(1000)),
          Float(99.75),
          Float(0.5),
          Int(1000))),
      CmpOp("==", ListExpr(Int(7), Float(99.75), Float(0.5), Int(1000)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.0)),
          Int(1000),
          Float(0.0),
          Float(99.75))),
      CmpOp("==", ListExpr(Int(1000), Float(99.75)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.0)),
          Int(7),
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Int(1000)))),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(7),
          Float(99.75),
          Int(1),
          UnaryOp("-", Int(7)),
          Int(1000),
          Float(0.0),
          Float(0.5),
          Float(0.5))),
      CmpOp(
        "==",
        ListExpr(
          Int(7),
          Float(99.75),
          Int(1),
          Int(1000),
          Float(0.5),
          Float(0.5)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Float(0.0),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1000)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Float(99.75)),
          UnaryOp("-", Float(0.0)),
          UnaryOp("-", Int(7)),
          UnaryOp("-", Float(0.5)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(7)),
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Float(0.5)),
          Int(0),
          UnaryOp("-", Float(0.0)),
          UnaryOp("-", Float(0.0)),
          UnaryOp("-", Float(99.75)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(1),
          UnaryOp("-", Float(99.75)),
          Int(1),
          Float(0.0),
          Float(0.5),
          Float(0.0),
          Float(0.5),
          UnaryOp("-", Float(0.5)))),
      CmpOp("==", ListExpr(Int(1), Int(1), Float(0.5), Float(0.5)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(0),
          Int(7),
          UnaryOp("-", Int(1000)),
          Float(0.5),
          UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr(Int(7), Float(0.5)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(UnaryOp("-", Float(0.5)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Float(0.0),
          Int(1),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Float(0.0)),
          Int(7),
          Float(0.5),
          Int(1000))),
      CmpOp("==", ListExpr(Int(1), Int(7), Float(0.5), Int(1000)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(1000),
          Int(1),
          UnaryOp("-", Int(1000)),
          Int(7),
          UnaryOp("-", Int(1000)),
          Float(0.5))),
      CmpOp("==", ListExpr(Int(1000), Int(1), Int(7), Float(0.5)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(0),
          Int(1000),
          Int(1000),
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Float(0.5)),
          Int(0),
          Int(1000))),
      CmpOp("==", ListExpr(Int(1000), Int(1000), Int(1000)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(0),
          Float(99.75),
          UnaryOp("-", Float(0.5)),
          Int(1),
          UnaryOp("-", Float(0.5)))),
      CmpOp("==", ListExpr(Float(99.75), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          Float(0.5),
          Float(99.75),
          Float(0.0),
          UnaryOp("-", Float(0.5)),
          Int(1))),
      CmpOp("==", ListExpr(Float(0.5), Float(99.75), Int(1)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(Int(7), UnaryOp("-", Int(7)))),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(Int(0), UnaryOp("-", Int(1)), Float(0.0))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Float(0.5),
          Int(0),
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Float(0.0)),
          Int(0),
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Int(7)))),
      CmpOp("==", ListExpr(Float(0.5)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(0),
          Int(7),
          Int(0),
          UnaryOp("-", Int(1)),
          Int(1),
          Int(1),
          Float(0.0),
          Float(99.75))),
      CmpOp("==", ListExpr(Int(7), Int(1), Int(1), Float(99.75)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(1000),
          UnaryOp("-", Float(0.5)),
          Int(7),
          UnaryOp("-", Float(99.75)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Float(99.75)))),
      CmpOp("==", ListExpr(Int(1000), Int(7)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1)),
          Int(1000),
          Int(1000),
          Int(7),
          UnaryOp("-", Int(1000)))),
      CmpOp("==", ListExpr(Int(1000), Int(1000), Int(7)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Int(7)),
          UnaryOp("-", Int(7)),
          Int(7),
          UnaryOp("-", Int(1000)),
          Float(99.75))),
      CmpOp("==", ListExpr(Int(7), Float(99.75)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(UnaryOp("-", Float(99.75)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.0)),
          Float(99.75),
          Float(0.0),
          Int(0))),
      CmpOp("==", ListExpr(Float(99.75)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(0),
          Float(0.0),
          Int(0),
          UnaryOp("-", Int(1)),
          Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(0.5)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1000)),
          Float(0.5),
          Int(0),
          Float(99.75))),
      CmpOp("==", ListExpr(Float(0.5), Float(99.75)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(1),
          UnaryOp("-", Float(99.75)),
          Int(1000),
          UnaryOp("-", Int(1000)),
          UnaryOp("-", Float(0.0)),
          Int(0),
          Int(0),
          UnaryOp("-", Float(0.5)))),
      CmpOp("==", ListExpr(Int(1), Int(1000)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1000)),
          UnaryOp("-", Int(7)),
          UnaryOp("-", Int(1)),
          Float(99.75),
          UnaryOp("-", Float(0.5)),
          Int(1),
          Int(0))),
      CmpOp("==", ListExpr(Float(99.75), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Float(0.0),
          Int(7),
          Int(1),
          Int(1),
          UnaryOp("-", Int(1)),
          Int(7),
          UnaryOp("-", Float(99.75)),
          UnaryOp("-", Float(0.0)))),
      CmpOp("==", ListExpr(Int(7), Int(1), Int(1), Int(7)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1000)),
          UnaryOp("-", Int(1000)),
          UnaryOp("-", Float(99.75)),
          UnaryOp("-", Int(1000)),
          UnaryOp("-", Float(99.75)),
          Float(0.5),
          UnaryOp("-", Float(0.5)))),
      CmpOp("==", ListExpr(Float(0.5)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr(Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(UnaryOp("-", Float(0.0)), Int(1000))),
      CmpOp("==", ListExpr(Int(1000)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(Float(0.0), Float(99.75), UnaryOp("-", Int(7)), Int(1))),
      CmpOp("==", ListExpr(Float(99.75), Int(1))))))
