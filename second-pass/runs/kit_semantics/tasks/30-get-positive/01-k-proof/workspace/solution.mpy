Module(
  FuncDef("get_positive", Params("l"),
    Expr(Str("Return only positive numbers in the list."))
    Assign(Name("positive"), ListExpr())
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp(">", Float(0.0))),
        Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
        ))
    Return(Name("positive"))))
