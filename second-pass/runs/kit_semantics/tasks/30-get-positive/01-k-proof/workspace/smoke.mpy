Module(
  FuncDef("get_positive", Params("l"),
    Expr(Str("Return only positive numbers in the list."))
    Assign(Name("positive"), ListExpr())
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp(">", Float(0.0))),
        Expr(Call(Attribute(Name("positive"), "append"), Name("x"))),
        ))
    Return(Name("positive")))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1)),
          Int(2),
          UnaryOp("-", Int(4)),
          Int(5),
          Int(6))),
      CmpOp("==", ListExpr(Int(2), Int(5), Int(6)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(5),
          Int(3),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(3)),
          Int(3),
          Int(9),
          Int(0),
          Int(123),
          Int(1),
          UnaryOp("-", Int(10)))),
      CmpOp(
        "==",
        ListExpr(
          Int(5),
          Int(3),
          Int(2),
          Int(3),
          Int(9),
          Int(123),
          Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Float(2.5)),
          Float(0.0),
          Float(1.25),
          Int(7))),
      CmpOp("==", ListExpr(Float(1.25), Int(7))))))
