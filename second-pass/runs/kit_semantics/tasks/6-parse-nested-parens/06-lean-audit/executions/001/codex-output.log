index 0000000000000000000000000000000000000000..5636c3ac196d50be7d9d06d6af0497d92584f23e
--- /dev/null
+++ b//tmp/audit-work/lean-env-probe/readlink_probe.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn real_readlink;
+  if (!real_readlink) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  ssize_t result = real_readlink(path, buf, size);
+  int saved_errno = errno;
+  fprintf(stderr, "READLINK path=%s result=%zd errno=%d", path, result, saved_errno);
+  if (result >= 0) {
+    fprintf(stderr, " target=%.*s", (int)result, buf);
+  }
+  fputc('\n', stderr);
+  errno = saved_errno;
+  return result;
+}
