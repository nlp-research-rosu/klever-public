/bin/bash -lc "{ printf '%s\\n' '"'$ python - <<PY  # independent finite operational/summary comparison; no mounted code executed'"'; python - <<'PY'
from itertools import product

def operational(s):
    depths=[]; depth=0; deepest=0; char=''
    for char in s:
        if char=='(':
            depth += 1
            if depth > deepest: deepest=depth
        elif char==')':
            depth -= 1
        elif deepest > 0:
            depths.append(deepest); deepest=0
    if deepest > 0: depths.append(deepest)
    return depths, depth, deepest, char

def definitions(s):
    d=0; m=0; out=[]; ch=''
    for char in s:
        c=ord(char)
        nd=d+1 if c==40 else d-1 if c==41 else d
        nm=max(d+1,m) if c==40 else m if c==41 else (0 if m>0 else m)
        no=out if c in (40,41) or m<=0 else out+[m]
        d,m,out,ch=nd,nm,no,char
    finish=out+[m] if m>0 else out
    return finish,d,m,ch

def valid_definition(s):
    d=0
    for c in map(ord,s):
        if c==40: d+=1
        elif c==41:
            if d<=0: return False
            d-=1
        elif c==32:
            if d"'!=0: return False
        else: return False
    return d==0

def direct_contract(s):
    d=0
    for c in s:
        if c=='"'(': d+=1
        elif c==')':
            if d==0: return False
            d-=1
        elif c==' ':
            if d"'!=0: return False
        else: return False
    return d==0

cases=0; operational_mismatches=[]; contract_mismatches=[]
for n in range(8):
  for chars in product('"'() x', repeat=n):
    s=''.join(chars); cases+=1
    if operational(s)"'!=definitions(s): operational_mismatches.append((s,operational(s),definitions(s)))
    if valid_definition(s)!=direct_contract(s): contract_mismatches.append((s,valid_definition(s),direct_contract(s)))
print('"'alphabet=\"() x\" lengths=0..7 cases=',cases)
print('operational_summary_mismatches=',len(operational_mismatches))
print('contract_predicate_mismatches=',len(contract_mismatches))
print('adversarial_examples:')
for s in ('', '()', '(())', '() (())', '(() )', ')(', '((x))', '((())) '):
 print(repr(s), 'operational=',operational(s), 'definitions=',definitions(s), 'valid=',valid_definition(s))
print('counterfactual_checks:')
print('mutate_open_increment_to_identity on \"(())\" -> depth/max differ: expected',operational('(())')[0],'mutated []')
print('mutate_delimiter_append_to_noop on \"() (())\" -> output differs: expected',operational('() (())')[0],'mutated [2]')
print('mutate_finish_append_to_noop on \"((()))\" -> output differs: expected',operational('((()))')[0],'mutated []')
PY
} 2>&1 | tee /audit-output/evidence/14_independent_semantic_examples.txt" in /audit-output
