new file mode 100644
index 0000000000000000000000000000000000000000..985f8bc0684239e8495194eeac0451ce150d3055
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,29 @@
+from typing import List
+
+
+def parse_nested_parens(paren_string: str) -> List[int]:
+    depths = []
+    depth = 0
+    deepest = 0
+    char = ""
+
+    for char in paren_string:
+        if char == "(":
+            depth += 1
+            if depth > deepest:
+                deepest = depth
+        elif char == ")":
+            depth -= 1
+        elif deepest > 0:
+            depths.append(deepest)
+            deepest = 0
+
+    if deepest > 0:
+        depths.append(deepest)
+
+    return depths
+
+
+assert parse_nested_parens("(()()) ((())) () ((())()())") == [2, 3, 1, 3]
+assert parse_nested_parens("()() ((())())") == [1, 3]
+assert parse_nested_parens("  (())   ()  ") == [2, 1]
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7232083653d710bc747465f8826fd2d3d081a9b2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,24 @@
+from typing import List
+
+
+def parse_nested_parens(paren_string: str) -> List[int]:
+    depths = []
+    depth = 0
+    deepest = 0
+    char = ""
+
+    for char in paren_string:
+        if char == "(":
+            depth += 1
+            if depth > deepest:
+                deepest = depth
+        elif char == ")":
+            depth -= 1
+        elif deepest > 0:
+            depths.append(deepest)
+            deepest = 0
+
+    if deepest > 0:
+        depths.append(deepest)
+
+    return depths
