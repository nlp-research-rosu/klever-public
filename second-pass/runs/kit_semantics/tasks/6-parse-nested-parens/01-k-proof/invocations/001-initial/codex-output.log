+        -1 |-> builtinsScope )
+      =>
+      ( 0  |-> scope(
+          "parse_nested_parens"
+            |-> closureVal(
+              "paren_string",
+              Assign(Name("depths"), ListExpr(.Exprs))
+              Assign(Name("depth"), Int(1))
+              Assign(Name("deepest"), Int(0))
+              Assign(Name("char"), Str(""))
+              For(Name("char"), Name("paren_string"), loopBody)
+              afterLoop,
+              0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(1, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
