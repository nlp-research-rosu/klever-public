+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(2, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
