+             iCons(41, .IntSeq)))))))))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0  |-> scope(
+          "parse_nested_parens"
+            |-> closureVal("paren_string", solutionBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
