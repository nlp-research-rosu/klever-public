+module PINNING
+  imports VERIFICATION
+
+  // Reviewer-authored constructor-level identity check: the proof shorthand
+  // must reduce to the complete submitted solution.mpy module term.
+  claim
+    <k> solutionModule =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("parse_nested_parens", Params("paren_string"),
+        Assign(Name("depths"), ListExpr(.Exprs))
+        Assign(Name("depth"), Int(0))
+        Assign(Name("deepest"), Int(0))
+        Assign(Name("char"), Str(""))
+        For(Name("char"), Name("paren_string"),
+          If(Compare(Name("char"), CmpOp("==", Str("("))),
+            AugAssign(Name("depth"), "+", Int(1))
+            If(Compare(Name("depth"), CmpOp(">", Name("deepest"))),
+              Assign(Name("deepest"), Name("depth")),
+              .Stmts),
+            If(Compare(Name("char"), CmpOp("==", Str(")"))),
+              AugAssign(Name("depth"), "-", Int(1)),
+              If(Compare(Name("deepest"), CmpOp(">", Int(0))),
+                Expr(
+                  Call(Attribute(Name("depths"), "append"), Name("deepest")))
+                Assign(Name("deepest"), Int(0)),
+                .Stmts))))
+        If(Compare(Name("deepest"), CmpOp(">", Int(0))),
+          Expr(Call(Attribute(Name("depths"), "append"), Name("deepest"))),
+          .Stmts)
+        Return(Name("depths")))) </k>
+endmodule
diff --git a/evidence/run-and-log.sh b/evidence/run-and-log.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0c2ab094506aed288e0154d8a71879946d6e9b8a
--- /dev/null
+++ b/evidence/run-and-log.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run-and-log.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf 'EXIT STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_file"
+
+exit "${PIPESTATUS[0]}"
diff --git a/evidence/runtime_cases.py b/evidence/runtime_cases.py
new file mode 100644
index 0000000000000000000000000000000000000000..4e447306b9e316fc8da85040d0362657fa30fb8b
--- /dev/null
+++ b/evidence/runtime_cases.py
@@ -0,0 +1,32 @@
+from typing import List
+
+
+def parse_nested_parens(paren_string: str) -> List[int]:
+    depths = []
+    depth = 0
+    deepest = 0
+    char = ""
+
+    for char in paren_string:
+        if char == "(":
+            depth += 1
+            if depth > deepest:
+                deepest = depth
+        elif char == ")":
+            depth -= 1
+        elif deepest > 0:
+            depths.append(deepest)
+            deepest = 0
+
+    if deepest > 0:
+        depths.append(deepest)
+
+    return depths
+
+
+assert parse_nested_parens("") == []
+assert parse_nested_parens("   ") == []
+assert parse_nested_parens("()") == [1]
+assert parse_nested_parens("()()") == [1]
+assert parse_nested_parens("(()()) ((())) () ((())()())") == [2, 3, 1, 3]
+assert parse_nested_parens("  (())   ()  ") == [2, 1]

exec
/bin/bash -lc 'bash /audit-output/evidence/run-and-log.sh /audit-output/evidence/stage6-false-result-proof.log kprove false-result.k --definition verification-kompiled --spec-module FALSE-RESULT' in /tmp/audit-work/6-parse-nested-parens
