index 0000000000000000000000000000000000000000..b1584f1fec1c3dc7e5512324c961c1b51a131d45
--- /dev/null
+++ b/evidence/ground.k
@@ -0,0 +1,67 @@
+requires "spec.k"
+
+module GROUND
+  imports SPEC
+
+  claim [empty-input]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("parse_nested_parens"), str(.IntSeq))
+      => ref(0)
