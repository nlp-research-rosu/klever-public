krun smoke.mpy --definition runtime-kompiled | tee concrete-run.log
grep -q '<k>' concrete-run.log
grep -q '    .K' concrete-run.log
grep -q '    NoExc' concrete-run.log

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
