/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path
canonical = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == canonical['inventory_sha256']
assert len(out['rules']) == len(canonical['rules'])
expected_ids = [r['source_rule_id'] for r in canonical['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids))
for entry in out['rules']:
    assert list(entry.keys()) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
for source, entry in zip(canonical['rules'], out['rules']):
    if 'simplification' in source['attributes']:
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(e['classification'] for e in out['rules'])
print('schema/order/uniqueness: PASS')
print('inventory_sha256:', out['inventory_sha256'])
print('rules:', len(out['rules']))
print('counts:', dict(counts))
print('simplification rules:', sum('simplification' in r['attributes'] for r in canonical['rules']))
PY
printf '%s\\n' '--- output files ---'
ls -l trust-boundary.json DISCOVERY.md
printf '%s\\n' '--- discovery assertions ---'
rg -n 'Separately proved|There are no separately proved|domain-lemma set is empty|PROVED_DERIVED_LEMMA|DOMAIN_LEMMA' DISCOVERY.md
printf '%s\\n' '--- prohibited formulation check ---'
if rg -ni 'lean theorem|theorem statement|replacement formulation|alternative formulation' trust-boundary.json DISCOVERY.md; then exit 1; else echo 'none'; fi" in /workspace
