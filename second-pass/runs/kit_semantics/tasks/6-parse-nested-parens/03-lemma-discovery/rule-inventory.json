      "start_line": 29,
      "text": "  rule solutionBody =>\n    Assign(Name(\"depths\"), ListExpr(.Exprs))\n    Assign(Name(\"depth\"), Int(0))\n    Assign(Name(\"deepest\"), Int(0))\n    Assign(Name(\"char\"), Str(\"\"))\n    For(Name(\"char\"), Name(\"paren_string\"), loopBody)\n    afterLoop"
    },
