      "start_line": 8,
      "text": "  rule loopBody =>\n    If(Compare(Name(\"char\"), CmpOp(\"==\", Str(\"(\"))),\n      AugAssign(Name(\"depth\"), \"+\", Int(1))\n      If(Compare(Name(\"depth\"), CmpOp(\">\", Name(\"deepest\"))),\n        Assign(Name(\"deepest\"), Name(\"depth\")),\n        .Stmts),\n      If(Compare(Name(\"char\"), CmpOp(\"==\", Str(\")\"))),\n        AugAssign(Name(\"depth\"), \"-\", Int(1)),\n        If(Compare(Name(\"deepest\"), CmpOp(\">\", Int(0))),\n          Expr(Call(Attribute(Name(\"depths\"), \"append\"), Name(\"deepest\")))\n          Assign(Name(\"deepest\"), Int(0)),\n          .Stmts)))"
    },
    {
      "attributes": [],
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "a8c8a92bbe087be04a1b87bd4672ecf4e852861eb514c5861fc6c421da89ecb0",
      "source_rule_id": "rule-a8c8a92bbe087be04a1b87bd4672ecf4e852861eb514c5861fc6c421da89ecb0",
      "start_line": 22,
      "text": "  rule afterLoop =>\n    If(Compare(Name(\"deepest\"), CmpOp(\">\", Int(0))),\n      Expr(Call(Attribute(Name(\"depths\"), \"append\"), Name(\"deepest\"))),\n      .Stmts)\n    Return(Name(\"depths\"))"
    },
    {
      "attributes": [],
      "end_line": 35,
