    18	                | "DictExpr"  "(" Entries ")"
    19	                | "ListComp"  "(" Expr "," CompFors ")" [macro]
    20	                | "GenExp"    "(" Expr "," CompFors ")" [macro]
    21	                | "TupleExpr" "(" Exprs ")"
    22	                | "Subscript" "(" Expr "," Index ")"
