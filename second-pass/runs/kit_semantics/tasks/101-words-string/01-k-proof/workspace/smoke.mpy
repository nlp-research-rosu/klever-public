Module(
  FuncDef("words_string", Params("s"),
    Return(
      Call(
        Attribute(
          Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
          "split"),
        )))
  Assert(
    Compare(
      Call(Name("words_string"), Str("Hi, my name is John")),
      CmpOp(
        "==",
        ListExpr(
          Str("Hi"),
          Str("my"),
          Str("name"),
          Str("is"),
          Str("John")))))
  Assert(
    Compare(
      Call(
        Name("words_string"),
        Str("One, two, three, four, five, six")),
      CmpOp(
        "==",
        ListExpr(
          Str("One"),
          Str("two"),
          Str("three"),
          Str("four"),
          Str("five"),
          Str("six")))))
  Assert(
    Compare(
      Call(Name("words_string"), Str("  alpha,,\tbeta\n")),
      CmpOp("==", ListExpr(Str("alpha"), Str("beta")))))
  Assert(
    Compare(
      Call(Name("words_string"), Str("")),
      CmpOp("==", ListExpr()))))
