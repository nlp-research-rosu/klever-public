diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..048774f7a9a6eabaeae1670f97dae435bc17aecd
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,42 @@
+from itertools import product
+
+from solution import words_string
+
+
+def oracle(source):
+    words = []
+    current = []
+    for character in source:
+        if character == "," or character.isspace():
+            if current:
+                words.append("".join(current))
+                current = []
+        else:
+            current.append(character)
+    if current:
+        words.append("".join(current))
+    return words
+
+
+explicit = [
+    "Hi, my name is John",
+    "One, two, three, four, five, six",
+    "",
+    ",",
+    "  alpha,,\tbeta\n",
+    "one\v\f\u00a0two",
+]
+alphabet = "aB0, \t\n"
+cases = list(explicit)
+for length in range(6):
