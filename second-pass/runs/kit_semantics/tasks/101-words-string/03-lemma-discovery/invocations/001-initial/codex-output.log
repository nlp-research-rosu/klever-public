allowed = {
    'DEFINITION',
    'OPERATIONAL_RULE',
    'PROVED_DERIVED_LEMMA',
    'DOMAIN_LEMMA',
}
assert set(result) == {'schema_version', 'inventory_sha256', 'rules'}
