assert result['inventory_sha256'] == canonical['inventory_sha256']
canonical_ids = [rule['source_rule_id'] for rule in canonical['rules']]
result_ids = [rule['source_rule_id'] for rule in result['rules']]
assert result_ids == canonical_ids
assert len(result_ids) == len(set(result_ids))
for rule in result['rules']:
    assert set(rule) == {'source_rule_id', 'classification', 'rationale'}
    assert rule['classification'] in allowed
