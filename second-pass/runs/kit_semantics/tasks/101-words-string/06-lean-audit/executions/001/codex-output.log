index 0000000000000000000000000000000000000000..ce2b7f197286ff71c2da396ab318cdfb405a26b4
--- /dev/null
+++ b/evidence/pidns_readlink_shim.c
@@ -0,0 +1,22 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    const size_t length = strlen(path);
+    if (length > 10 && strncmp(path, "/proc/", 6) == 0
+        && strcmp(path + length - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
