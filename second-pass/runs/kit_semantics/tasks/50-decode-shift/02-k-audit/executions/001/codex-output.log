/bin/bash -lc 'for p in reference-semantics/semantics.k reference-semantics/semantics/syntax.k reference-semantics/semantics/core.k reference-semantics/semantics/functions.k reference-semantics/semantics/call.k reference-semantics/semantics/controls.k reference-semantics/semantics/iter.k reference-semantics/semantics/int.k reference-semantics/semantics/str.k reference-semantics/semantics/bool.k reference-semantics/semantics/operators.k reference-semantics/semantics/assert.k; do echo "===== $p"; nl -ba "$p"; done' in /tmp/audit-work/50-decode-shift
