+  // primeScan(N, D, A) is A conjoined with the absence of a divisor of N
+  // in the integer interval [D, N).  The D < 2 case totalizes the helper
+  // outside the proof's D >= 2 domain.
+  syntax Bool ::= primeScan(Int, Int, Bool) [function, total]
+                | primeResult(Int)          [function, total]
+
+  rule primeScan(_N, D, _A) => false
+    requires D <Int 2
+
+  rule primeScan(N, D, A) => A
+    requires D >=Int 2 andBool D >=Int N
+
+  rule primeScan(N, D, _A) => false
+    requires D >=Int 2 andBool D <Int N
