new file mode 100644
index 0000000000000000000000000000000000000000..891947c3b6694480152a7e276f117769da4bfa89
--- /dev/null
+++ b/evidence/03_concrete_driver.py
@@ -0,0 +1,28 @@
+def is_prime(n):
+    if n < 2:
+        return False
+    divisor = 2
+    result = True
+    while divisor < n:
+        if n % divisor == 0:
+            result = False
+        divisor = divisor + 1
+    return result
+
+
+results = [
+    is_prime(-7),
+    is_prime(0),
+    is_prime(1),
+    is_prime(2),
+    is_prime(3),
+    is_prime(4),
+    is_prime(6),
+    is_prime(9),
+    is_prime(11),
+    is_prime(25),
+    is_prime(31),
+    is_prime(61),
+    is_prime(101),
+    is_prime(997),
+]

