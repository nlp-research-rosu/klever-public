+  /generation-evidence/codex-trace
+)
+
+echo '$ stat -c "%F|%n|%s" <pipeline-v3 required paths>'
+for path in "${required[@]}"; do
+  if [[ -e "$path" || -L "$path" ]]; then
+    stat -c '%F|%n|%s' "$path"
