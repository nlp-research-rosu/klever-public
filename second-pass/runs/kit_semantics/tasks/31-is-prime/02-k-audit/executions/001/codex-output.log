+    cd "$root" &&
+    find . -printf '%y|%P\n' | LC_ALL=C sort
+  ) | sha256sum
+done
+echo "EXIT: $?"
+
+echo '$ find /candidate -type l -print'
+find /candidate -type l -print
+echo "EXIT: $?"
