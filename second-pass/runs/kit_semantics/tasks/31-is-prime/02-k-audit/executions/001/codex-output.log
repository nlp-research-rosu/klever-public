+cp -a /reference/prompt.py "$scratch/prompt.py"
+cp -a /reference/py2mpy.py "$scratch/py2mpy.py"
+cp -a /candidate/solution.py "$scratch/solution.py"
+cp -a /candidate/solution.mpy "$scratch/submitted-solution.mpy"
