Module(
  FuncDef("is_prime", Params("n"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Bool(false)),
      )
    Assign(Name("divisor"), Int(2))
    Assign(Name("result"), Bool(true))
    While(Compare(Name("divisor"), CmpOp("<", Name("n"))),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Assign(Name("result"), Bool(false)),
        )
      Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    Return(Name("result")))
  Assign(Name("results"), ListExpr(
    Call(Name("is_prime"), UnaryOp("-", Int(7))),
    Call(Name("is_prime"), Int(0)),
    Call(Name("is_prime"), Int(1)),
    Call(Name("is_prime"), Int(2)),
    Call(Name("is_prime"), Int(3)),
    Call(Name("is_prime"), Int(4)),
    Call(Name("is_prime"), Int(5)),
    Call(Name("is_prime"), Int(9)),
    Call(Name("is_prime"), Int(25)),
    Call(Name("is_prime"), Int(49)),
    Call(Name("is_prime"), Int(97)))))
