Module(
  FuncDef("is_prime", Params("n"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Bool(false)),
      )
    Assign(Name("divisor"), Int(2))
    Assign(Name("result"), Bool(true))
    While(Compare(Name("divisor"), CmpOp("<", Name("n"))),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Assign(Name("result"), Bool(false)),
        )
      Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    Return(Name("result"))))
