diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..41bdc0215db8ff40af80b413a99d8fdf7fa32fca
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // primeScan(N, D, A) is A conjoined with the absence of a divisor of N
+  // in the integer interval [D, N).  The D < 2 case totalizes the helper
+  // outside the proof's D >= 2 domain.
+  syntax Bool ::= primeScan(Int, Int, Bool) [function, total]
+                | primeResult(Int)          [function, total]
+
+  rule primeScan(_N, D, _A) => false
+    requires D <Int 2
+
+  rule primeScan(N, D, A) => A
+    requires D >=Int 2 andBool D >=Int N
+
+  rule primeScan(N, D, _A) => false
+    requires D >=Int 2 andBool D <Int N
+      andBool pyMod(N, D) ==Int 0
+
+  rule primeScan(N, D, A) => primeScan(N, D +Int 1, A)
+    requires D >=Int 2 andBool D <Int N
+      andBool pyMod(N, D) =/=Int 0
+
+  rule primeResult(N) => false
+    requires N <Int 2
+
+  rule primeResult(N) => primeScan(N, 2, true)
+    requires N >=Int 2
+endmodule

