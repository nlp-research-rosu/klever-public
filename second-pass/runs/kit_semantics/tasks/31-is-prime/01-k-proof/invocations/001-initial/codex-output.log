exec
/bin/bash -lc 'kprove spec-body-mutation.k --definition verification-kompiled --spec-module SPEC-BODY-MUTATION > body-mutation.kprove.out 2>&1; body_status=$?
kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY > vacuity.kprove.out 2>&1; vacuity_status=$?
printf '"'body_mutation_exit=%s\\n' \""'$body_status"
tail -n 70 body-mutation.kprove.out
printf '"'\\nvacuity_exit=%s\\n' \""'$vacuity_status"
tail -n 70 vacuity.kprove.out
if [ "$body_status" -eq 0 ] || [ "$vacuity_status" -eq 0 ]; then exit 1; fi' in /workspace
