diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..0c6d351e42d44fd0a8581a0eea21a904f3222316
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: initialize result to false instead of true.
+  // The witness N = 2 skips the loop and must expose the changed result.
+  claim [mutated-is-prime-two]:
+    <k>
+      Call(Name("is_prime"), (Int(2), .Exprs))
+      => ?R:Bool ~> .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "is_prime" |->
+          closureVal(
+            ("n", .ParamNames),
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(Name("divisor"), Int(2))
+            Assign(Name("result"), Bool(false))
+            While(
+              Compare(Name("divisor"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Assign(Name("result"), Bool(false)),
+                .Stmts)
+              Assign(
+                Name("divisor"),
+                BinOp("+", Name("divisor"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool primeResult(2)
+endmodule
