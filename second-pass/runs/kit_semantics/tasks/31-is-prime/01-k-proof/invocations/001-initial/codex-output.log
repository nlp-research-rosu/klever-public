+            result = False
+        divisor = divisor + 1
+    return result
+
+
+results = [
+    is_prime(-7),
+    is_prime(0),
+    is_prime(1),
+    is_prime(2),
+    is_prime(3),
+    is_prime(4),
+    is_prime(6),
+    is_prime(9),
+    is_prime(11),
