+def is_prime(n):
+    if n < 2:
+        return False
+    divisor = 2
+    result = True
+    while divisor < n:
+        if n % divisor == 0:
+            result = False
+        divisor = divisor + 1
+    return result
+
+
+results = [
+    is_prime(-7),
+    is_prime(0),
+    is_prime(1),
+    is_prime(2),
+    is_prime(3),
