index 0000000000000000000000000000000000000000..1dad13bceb0bf0d417c866f3e46e44f0f6e6751d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,83 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [prime-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Assign(Name("result"), Bool(false)),
+          .Stmts)
+        Assign(
+          Name("divisor"),
+          BinOp("+", Name("divisor"), Int(1)))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(M:Map, parent(-1))
+      1 |-> scope(
+        "n"       |-> N
+        "divisor" |-> (D => N)
+        "result"  |-> (A => A andBool primeScan(N, D)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(FRAME:KItem) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  claim [is-prime]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("is_prime", Params("n"),
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(Name("divisor"), Int(2))
+            Assign(Name("result"), Bool(true))
+            While(
+              Compare(Name("divisor"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Assign(Name("result"), Bool(false)),
+                .Stmts)
+              Assign(
+                Name("divisor"),
+                BinOp("+", Name("divisor"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)))
+      ~> Call(Name("is_prime"), (Int(N), .Exprs))
+      => ?R:Bool ~> .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool primeResult(N)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8a692984d1977f943a309ad28cae99502b92eb2c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // primeScan(N, D) states that N has no divisor in the integer interval
+  // [D, N).  The D < 2 case totalizes the helper outside the proof's
+  // D >= 2 domain.
+  syntax Bool ::= primeScan(Int, Int) [function, total]
+                | primeResult(Int)    [function, total]
+
+  rule primeScan(_N, D) => false
+    requires D <Int 2
+
+  rule primeScan(N, D) => true
+    requires D >=Int 2 andBool D >=Int N
+
+  rule primeScan(N, D) => false
+    requires D >=Int 2 andBool D <Int N
+      andBool pyMod(N, D) ==Int 0
+
+  rule primeScan(N, D) => primeScan(N, D +Int 1)
+    requires D >=Int 2 andBool D <Int N
+      andBool pyMod(N, D) =/=Int 0
+
+  rule primeResult(N) => false
+    requires N <Int 2
+
+  rule primeResult(N) => primeScan(N, 2)
+    requires N >=Int 2
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..4ee6d733b4015679544272dc4a14f3459099d356
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,27 @@
+def is_prime(n):
+    if n < 2:
+        return False
+    divisor = 2
+    result = True
+    while divisor < n:
+        if n % divisor == 0:
+            result = False
+        divisor = divisor + 1
+    return result
+
+
+results = [
+    is_prime(-7),
+    is_prime(0),
+    is_prime(1),
+    is_prime(2),
+    is_prime(3),
+    is_prime(4),
+    is_prime(6),
+    is_prime(9),
+    is_prime(11),
+    is_prime(25),
+    is_prime(61),
+    is_prime(101),
+    is_prime(13441),
+]
