@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the original implementation returns true for 2.
+  claim [false-result-for-two]:
+    <k>
+      Call(Name("is_prime"), (Int(2), .Exprs))
+      => ?R:Bool ~> .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "is_prime" |->
+          closureVal(
+            ("n", .ParamNames),
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(Name("divisor"), Int(2))
+            Assign(Name("result"), Bool(true))
+            While(
+              Compare(Name("divisor"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Assign(Name("result"), Bool(false)),
+                .Stmts)
+              Assign(
+                Name("divisor"),
+                BinOp("+", Name("divisor"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool false
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..729b625a0090166c2e48094e4ca240cc28d828b4
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,85 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [prime-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Assign(Name("result"), Bool(false)),
+          .Stmts)
+        Assign(
+          Name("divisor"),
+          BinOp("+", Name("divisor"), Int(1)))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(M:Map, parent(-1))
+      1 |-> scope(
+        "n"       |-> N
+        "divisor" |-> (D => N)
+        "result"  |-> (A => A andBool primeScan(N, D)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(FRAME:KItem) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  claim [is-prime]:
+    <k>
+      Call(Name("is_prime"), (Int(N), .Exprs))
+      => ?R:Bool ~> .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "is_prime" |->
+          closureVal(
+            ("n", .ParamNames),
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(Name("divisor"), Int(2))
+            Assign(Name("result"), Bool(true))
+            While(
+              Compare(Name("divisor"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Assign(Name("result"), Bool(false)),
+                .Stmts)
+              Assign(
+                Name("divisor"),
+                BinOp("+", Name("divisor"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool primeResult(N)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8a692984d1977f943a309ad28cae99502b92eb2c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // primeScan(N, D) states that N has no divisor in the integer interval
+  // [D, N).  The D < 2 case totalizes the helper outside the proof's
+  // D >= 2 domain.
+  syntax Bool ::= primeScan(Int, Int) [function, total]
+                | primeResult(Int)    [function, total]
+
+  rule primeScan(_N, D) => false
+    requires D <Int 2
+
+  rule primeScan(N, D) => true
+    requires D >=Int 2 andBool D >=Int N
+
+  rule primeScan(N, D) => false
+    requires D >=Int 2 andBool D <Int N
+      andBool pyMod(N, D) ==Int 0
+
+  rule primeScan(N, D) => primeScan(N, D +Int 1)
+    requires D >=Int 2 andBool D <Int N
+      andBool pyMod(N, D) =/=Int 0
+
+  rule primeResult(N) => false
+    requires N <Int 2
+
+  rule primeResult(N) => primeScan(N, 2)
+    requires N >=Int 2
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh
./prove.sh > prove-sh.out 2>&1; status=$?; printf '"'prove.sh exit=%s\\n' \""'$status"; tail -n 140 prove-sh.out; exit $status' in /workspace
