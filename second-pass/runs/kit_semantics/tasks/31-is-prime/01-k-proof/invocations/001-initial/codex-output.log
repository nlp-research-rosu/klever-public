diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b9856f8e95fbbf84cf2480fea73989de7541aa8d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [prime-loop]:
+    <k>
+      While(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Assign(Name("result"), Bool(false)),
+          .Stmts)
+        Assign(
+          Name("divisor"),
+          BinOp("+", Name("divisor"), Int(1)))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(M:Map, parent(-1))
+      1 |-> scope(
+        "n"       |-> N
+        "divisor" |-> (D => N)
+        "result"  |-> (A => primeScan(N, D, A)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(FRAME:KItem) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  claim [is-prime]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("is_prime", Params("n"),
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(Name("divisor"), Int(2))
+            Assign(Name("result"), Bool(true))
+            While(
+              Compare(Name("divisor"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Assign(Name("result"), Bool(false)),
+                .Stmts)
+              Assign(
+                Name("divisor"),
+                BinOp("+", Name("divisor"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)))
+      ~> Call(Name("is_prime"), (Int(N), .Exprs))
+      => primeResult(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..41bdc0215db8ff40af80b413a99d8fdf7fa32fca
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // primeScan(N, D, A) is A conjoined with the absence of a divisor of N
+  // in the integer interval [D, N).  The D < 2 case totalizes the helper
+  // outside the proof's D >= 2 domain.
+  syntax Bool ::= primeScan(Int, Int, Bool) [function, total]
+                | primeResult(Int)          [function, total]
+
+  rule primeScan(_N, D, _A) => false
+    requires D <Int 2
+
+  rule primeScan(N, D, A) => A
+    requires D >=Int 2 andBool D >=Int N
+
+  rule primeScan(N, D, _A) => false
+    requires D >=Int 2 andBool D <Int N
+      andBool pyMod(N, D) ==Int 0
+
+  rule primeScan(N, D, A) => primeScan(N, D +Int 1, A)
+    requires D >=Int 2 andBool D <Int N
+      andBool pyMod(N, D) =/=Int 0
+
+  rule primeResult(N) => false
+    requires N <Int 2
+
+  rule primeResult(N) => primeScan(N, 2, true)
+    requires N >=Int 2
+endmodule

