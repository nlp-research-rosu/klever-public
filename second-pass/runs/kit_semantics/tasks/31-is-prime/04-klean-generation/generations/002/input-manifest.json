{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "56a2e70b2b9a6897534484145ed3c22f2e76bcf2e474dc68eef9f37172a8d12a",
      "rationale": "This guarded equation totalizes the named primeScan summary below its proof-relevant lower-bound domain; it defines the summary value and does not execute or observe the Python program.",
      "source_rule_id": "rule-56a2e70b2b9a6897534484145ed3c22f2e76bcf2e474dc68eef9f37172a8d12a",
      "start_line": 12,
      "text": "  rule primeScan(_N, D) => false\n    requires D <Int 2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "c9098f115d5ab2018046eb5b7aa8258fc144eaf87ed620450558b6738876fc2a",
      "rationale": "This is the base equation for primeScan when the candidate-divisor interval is empty, so it defines the mathematical summary rather than adding an independent fact or operational behavior.",
      "source_rule_id": "rule-c9098f115d5ab2018046eb5b7aa8258fc144eaf87ed620450558b6738876fc2a",
      "start_line": 15,
      "text": "  rule primeScan(N, D) => true\n    requires D >=Int 2 andBool D >=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 20,
      "module": "VERIFICATION",
      "normalized_sha256": "f25721ae7af46a0d407f68b99044bcc092e0886933e95e182b7f354dd372cc6f",
      "rationale": "This guarded defining case assigns false to primeScan when the current candidate divides N; it is one branch of the exhaustive summary definition and matches no execution configuration.",
      "source_rule_id": "rule-f25721ae7af46a0d407f68b99044bcc092e0886933e95e182b7f354dd372cc6f",
      "start_line": 18,
      "text": "  rule primeScan(N, D) => false\n    requires D >=Int 2 andBool D <Int N\n      andBool pyMod(N, D) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "9dfa4d77d4e72a22bb3e22d40e29debbf97d343991879dc70b5d3d14769f44b6",
      "rationale": "This recurrence defines primeScan after a non-dividing candidate by advancing the lower bound; it is a terminating proof-relevant summary recurrence, not a separately proved or operational rule.",
      "source_rule_id": "rule-9dfa4d77d4e72a22bb3e22d40e29debbf97d343991879dc70b5d3d14769f44b6",
      "start_line": 22,
      "text": "  rule primeScan(N, D) => primeScan(N, D +Int 1)\n    requires D >=Int 2 andBool D <Int N\n      andBool pyMod(N, D) =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "2feaa748adba85dc4184b9bd769705f17045eecdf978f110190f1bf45f6d0c6d",
      "rationale": "This equation defines the primeResult summary for integers below two and neither replaces program execution nor asserts an additional reusable mathematical lemma.",
      "source_rule_id": "rule-2feaa748adba85dc4184b9bd769705f17045eecdf978f110190f1bf45f6d0c6d",
      "start_line": 26,
      "text": "  rule primeResult(N) => false\n    requires N <Int 2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "85efba1c2354ec176471d3fd15fe706012a5e3145f8eedc205b93748cdddfdff",
      "rationale": "This equation defines primeResult on integers at least two in terms of the already named primeScan summary; it is definitional composition rather than an independently proved derived fact.",
      "source_rule_id": "rule-85efba1c2354ec176471d3fd15fe706012a5e3145f8eedc205b93748cdddfdff",
      "start_line": 29,
      "text": "  rule primeResult(N) => primeScan(N, 2)\n    requires N >=Int 2"
    }
  ],
