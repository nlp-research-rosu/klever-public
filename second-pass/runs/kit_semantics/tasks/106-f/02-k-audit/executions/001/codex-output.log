+                    Name("total"))))
+              AugAssign(Name("i"), "+", Int(1)))
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(vCons(42, resultRun(.ValSeq, 1, N, 1, 0)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
