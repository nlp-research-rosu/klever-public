     1	def f(n):
     2	    result = []
     3	    fact = 1
     4	    total = 0
     5	    i = 1
     6	    while i <= n:
     7	        fact *= i
     8	        total += i
     9	        if i % 2 == 0:
    10	            result.append(fact)
    11	        else:
    12	            result.append(total)
    13	        i += 1
    14	    return result
