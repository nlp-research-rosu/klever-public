+++ b/solution.py
@@ -0,0 +1,12 @@
+def f(n):
+    result = []
+    fact = 1
+    i = 1
+    while i <= n:
+        fact *= i
+        if i % 2 == 0:
+            result.append(fact)
+        else:
+            result.append(i * (i + 1) // 2)
+        i += 1
+    return result
