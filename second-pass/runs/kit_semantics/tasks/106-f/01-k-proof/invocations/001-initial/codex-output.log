index 0000000000000000000000000000000000000000..546c9976edb36420ec07337c3ad07f9d6360be47
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    fact = 1
+    total = 0
+    i = 1
+    while i <= n:
+        fact *= i
+        total += i
+        if i % 2 == 0:
+            result.append(fact)
+        else:
+            result.append(total)
+        i += 1
+    return result
