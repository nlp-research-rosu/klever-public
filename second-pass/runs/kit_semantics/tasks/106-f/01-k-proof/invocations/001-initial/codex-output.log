+    => resultRun(
+         valSeqConcat(VS, vCons(F *Int I, .ValSeq)),
+         I +Int 1,
+         N,
+         F *Int I)
+    requires I <=Int N andBool pyMod(I, 2) ==Int 0
+  rule resultRun(VS, I, N, F)
+    => resultRun(
+         valSeqConcat(
+           VS,
+           vCons((I *Int (I +Int 1)) /Int 2, .ValSeq)),
+         I +Int 1,
+         N,
+         F *Int I)
+    requires I <=Int N andBool pyMod(I, 2) =/=Int 0
+  rule resultRun(VS, I, N, F) => VS
+    requires I >Int N
+endmodule

