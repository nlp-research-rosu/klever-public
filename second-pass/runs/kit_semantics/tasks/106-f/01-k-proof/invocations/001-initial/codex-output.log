diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..546c9976edb36420ec07337c3ad07f9d6360be47
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    fact = 1
+    total = 0
+    i = 1
+    while i <= n:
+        fact *= i
+        total += i
+        if i % 2 == 0:
+            result.append(fact)
+        else:
+            result.append(total)
+        i += 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c5524e8c3cabc040962f8d83eedd563cc50199e3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,96 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp("<=", Name("n"))),
+        AugAssign(Name("fact"), "*", Name("i"))
+        AugAssign(Name("total"), "+", Name("i"))
+        If(
+          Compare(
+            BinOp("%", Name("i"), Int(2)),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("fact"))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("total"))))
+        AugAssign(Name("i"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "n"      |-> N:Int
+        "result" |-> ref(H:Int)
+        "fact"   |-> (F:Int => factRun(I, N, F))
+        "total"  |-> (T:Int => totalRun(I, N, T))
+        "i"      |-> (I:Int => N +Int 1),
+        P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(VS:ValSeq => resultRun(VS, I, N, F, T))
+      ...
+    </heap>
+    requires I >=Int 1 andBool N >=Int I -Int 1
+
+  claim [f-correct]:
+    <k>
+      Call(Name("f"), Int(N:Int))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |->
+          closureVal(
+            ("n", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("fact"), Int(1))
+            Assign(Name("total"), Int(0))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"), CmpOp("<=", Name("n"))),
+              AugAssign(Name("fact"), "*", Name("i"))
+              AugAssign(Name("total"), "+", Name("i"))
+              If(
+                Compare(
+                  BinOp("%", Name("i"), Int(2)),
+                  CmpOp("==", Int(0))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("fact"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("total"))))
+              AugAssign(Name("i"), "+", Int(1)))
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(resultRun(.ValSeq, 1, N, 1, 0))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4eb0904ec7992823907ad46cb1dc9d1891774c08
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,89 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Definitional summary of the final factorial accumulator after the source
+  // loop processes indices I through N, starting with accumulator F.
+  syntax Int ::= factRun(Int, Int, Int)
+    [function, total, no-evaluators]
+  rule factRun(I, N, F) => factRun(I +Int 1, N, F *Int I)
+    requires I <=Int N
+    [concrete]
+  rule factRun(I, N, F) => F
+    requires I >Int N
+    [concrete]
+  rule factRun(I +Int 1, N, F *Int I) => factRun(I, N, F)
+    requires I <=Int N
+    [simplification]
+  rule factRun(I, N, F) => F
+    requires I >Int N
+    [simplification]
+
+  // The analogous summary for the running triangular-number accumulator.
+  syntax Int ::= totalRun(Int, Int, Int)
+    [function, total, no-evaluators]
+  rule totalRun(I, N, T) => totalRun(I +Int 1, N, T +Int I)
+    requires I <=Int N
+    [concrete]
+  rule totalRun(I, N, T) => T
+    requires I >Int N
+    [concrete]
+  rule totalRun(I +Int 1, N, T +Int I) => totalRun(I, N, T)
+    requires I <=Int N
+    [simplification]
+  rule totalRun(I, N, T) => T
+    requires I >Int N
+    [simplification]
+
+  // Definitional summary of the final list after the same source iterations.
+  // Its equations are exhaustive and disjoint: the loop is finished, the
+  // current index is even, or the current index is odd.
+  syntax ValSeq ::= resultRun(ValSeq, Int, Int, Int, Int)
+    [function, total, no-evaluators]
+  rule resultRun(VS, I, N, F, T)
+    => resultRun(
+         valSeqConcat(VS, vCons(F *Int I, .ValSeq)),
+         I +Int 1,
+         N,
+         F *Int I,
+         T +Int I)
+    requires I <=Int N andBool pyMod(I, 2) ==Int 0
+    [concrete]
+  rule resultRun(VS, I, N, F, T)
+    => resultRun(
+         valSeqConcat(
+           VS,
+           vCons(T +Int I, .ValSeq)),
+         I +Int 1,
+         N,
+         F *Int I,
+         T +Int I)
+    requires I <=Int N andBool pyMod(I, 2) =/=Int 0
+    [concrete]
+  rule resultRun(VS, I, N, F, T) => VS
+    requires I >Int N
+    [concrete]
+
+  rule resultRun(
+         valSeqConcat(VS, vCons(F *Int I, .ValSeq)),
+         I +Int 1,
+         N,
+         F *Int I,
+         T +Int I)
+    => resultRun(VS, I, N, F, T)
+    requires I <=Int N andBool pyMod(I, 2) ==Int 0
+    [simplification]
+  rule resultRun(
+         valSeqConcat(VS, vCons(T +Int I, .ValSeq)),
+         I +Int 1,
+         N,
+         F *Int I,
+         T +Int I)
+    => resultRun(VS, I, N, F, T)
+    requires I <=Int N andBool pyMod(I, 2) =/=Int 0
+    [simplification]
+  rule resultRun(VS, I, N, F, T) => VS
+    requires I >Int N
+    [simplification]
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-invariant' in /workspace
