Module(
  FuncDef("f", Params("n"),
    Assign(Name("result"), ListExpr())
    Assign(Name("fact"), Int(1))
    Assign(Name("total"), Int(0))
    Assign(Name("i"), Int(1))
    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
      AugAssign(Name("fact"), "*", Name("i"))
      AugAssign(Name("total"), "+", Name("i"))
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Expr(Call(Attribute(Name("result"), "append"), Name("fact"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("result")))
  Assign(Name("answer"), Call(Name("f"), Int(-3))))
