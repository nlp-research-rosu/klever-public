diff --git a//tmp/audit-work/lean_proc_compat.c b//tmp/audit-work/lean_proc_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..37039da18679e63c70ea52208efd442f046df038
--- /dev/null
+++ b//tmp/audit-work/lean_proc_compat.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+  if (strncmp(path, "/proc/", 6) != 0) return 0;
+  path += 6;
+  if (!isdigit((unsigned char)*path)) return 0;
+  while (isdigit((unsigned char)*path)) ++path;
+  return strcmp(path, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*original)(const char *, char *, size_t);
+  if (!original) original = dlsym(RTLD_NEXT, "readlink");
+  if (is_proc_pid_exe(path)) path = "/proc/self/exe";
+  return original(path, buffer, size);
+}
