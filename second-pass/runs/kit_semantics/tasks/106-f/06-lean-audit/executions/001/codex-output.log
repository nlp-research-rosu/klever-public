diff --git a/evidence/summarize_k_operational_smokes.sh b/evidence/summarize_k_operational_smokes.sh
new file mode 100644
index 0000000000000000000000000000000000000000..391b7173799044ae1df93685d4fc7285af9ad0f6
--- /dev/null
+++ b/evidence/summarize_k_operational_smokes.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+set -u
+
+raw=/audit-output/evidence/17_fresh_k_operational_smokes.txt
