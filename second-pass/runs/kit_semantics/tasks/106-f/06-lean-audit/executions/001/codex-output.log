new file mode 100644
index 0000000000000000000000000000000000000000..756e51b94dc20465135403fefa234b9f7e53357a
--- /dev/null
+++ b/evidence/k-smoke-negative-3.mpy
@@ -0,0 +1,15 @@
+Module(
