    11	      "rationale": "Concrete recursive equation defining factRun for the I <= N step; it advances the index and multiplies the accumulator without matching operational configuration cells.",
    12	      "source_rule_id": "rule-f6a44ca73f98b73343ed781fb0f5923f0dc5c4c49fe58cfd6e068a218cdac844",
    13	      "start_line": 10,
    14	      "text": "  rule factRun(I, N, F) => factRun(I +Int 1, N, F *Int I)\n    requires I <=Int N\n    [concrete]"
    15	    },
    16	    {
    17	      "attributes": [
    18	        "concrete"
    19	      ],
    20	      "classification": "DEFINITION",
    21	      "end_line": 15,
    22	      "module": "VERIFICATION",
    23	      "normalized_sha256": "bfbc5495b691995b569b051b9e1bcfc76d084f272d918a037d39536101cac940",
    24	      "rationale": "Concrete base equation defining factRun when I > N by returning the accumulated product.",
    25	      "source_rule_id": "rule-bfbc5495b691995b569b051b9e1bcfc76d084f272d918a037d39536101cac940",
    26	      "start_line": 13,
    27	      "text": "  rule factRun(I, N, F) => F\n    requires I >Int N\n    [concrete]"
