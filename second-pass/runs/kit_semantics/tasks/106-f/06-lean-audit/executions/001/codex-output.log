index 0000000000000000000000000000000000000000..ba78b70fe9909d210b40ef95abe3716787653d59
--- /dev/null
+++ b/evidence/run_stage4_bijection.sh
@@ -0,0 +1,7 @@
+#!/usr/bin/env bash
+set -o errexit
+set -o nounset
+set -o pipefail
