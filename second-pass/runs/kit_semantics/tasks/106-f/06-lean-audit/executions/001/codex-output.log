+export LEAN_SYSROOT="$toolchain/"
+export LAKE_HOME="$toolchain/"
+export LAKE_OVERRIDE_LEAN=1
+
+echo '$ cp /audit-output/evidence/OperationalTests.lean /tmp/audit-work/stage5-audit.VpzibW/OperationalTests.lean'
+cp /audit-output/evidence/OperationalTests.lean "$project/OperationalTests.lean"
+echo '$ lake env lean OperationalTests.lean'
+(cd "$project" && lake env lean OperationalTests.lean)
+status=$?
+echo "lean_operational_tests_exit=$status"
+exit "$status"
diff --git a/evidence/run_provenance_checks.sh b/evidence/run_provenance_checks.sh
new file mode 100644
index 0000000000000000000000000000000000000000..934496826321269d6720c3e5dcb0d1972fc0dbb8
--- /dev/null
+++ b/evidence/run_provenance_checks.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -o errexit
+set -o nounset
+set -o pipefail
+
+export PYTHONPATH=/reference
+printf 'All image/source provenance fields in audit input\n'
+rg -n 'image_id|image|producer|stage4' /audit-input.json
