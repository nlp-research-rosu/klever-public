diff --git a/evidence/run_lean_operational_tests.sh b/evidence/run_lean_operational_tests.sh
new file mode 100644
index 0000000000000000000000000000000000000000..039eb2bff8ecff9bd9b1e573c9a163e57f643695
--- /dev/null
+++ b/evidence/run_lean_operational_tests.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -u
+
