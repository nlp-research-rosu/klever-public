{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "8831e8f4818678473b23bcf22b257b1cb3f98ed59cf4b9ff570601d417f4b12e",
      "rationale": "Macro expansion defining the named proof term sumSquaresLoopBody as the exact translated loop body; it introduces no independent mathematical fact.",
      "source_rule_id": "rule-8831e8f4818678473b23bcf22b257b1cb3f98ed59cf4b9ff570601d417f4b12e",
      "start_line": 8,
      "text": "  rule sumSquaresLoopBody\n    => If(\n         Compare(BinOp(\"%\", Name(\"index\"), Int(3)), CmpOp(\"==\", Int(0))),\n         AugAssign(\n           Name(\"result\"),\n           \"+\",\n           BinOp(\"*\", Name(\"value\"), Name(\"value\")))\n         .Stmts,\n         If(\n           Compare(BinOp(\"%\", Name(\"index\"), Int(4)), CmpOp(\"==\", Int(0))),\n           AugAssign(\n             Name(\"result\"),\n             \"+\",\n             BinOp(\n               \"*\",\n               BinOp(\"*\", Name(\"value\"), Name(\"value\")),\n               Name(\"value\")))\n           .Stmts,\n           AugAssign(Name(\"result\"), \"+\", Name(\"value\"))\n           .Stmts)\n         .Stmts)\n       AugAssign(Name(\"index\"), \"+\", Int(1))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "299db94c0b24fbb3c1c5a1bd5b108c1855ad4ccb07c18bf0cb0b9ff9a362f19d",
      "rationale": "Macro expansion defining sumSquaresFunctionBody from assignments, the named loop body, and return syntax.",
      "source_rule_id": "rule-299db94c0b24fbb3c1c5a1bd5b108c1855ad4ccb07c18bf0cb0b9ff9a362f19d",
      "start_line": 33,
      "text": "  rule sumSquaresFunctionBody\n    => Assign(Name(\"result\"), Int(0))\n       Assign(Name(\"index\"), Int(0))\n       Assign(Name(\"value\"), Int(0))\n       For(Name(\"value\"), Name(\"lst\"), sumSquaresLoopBody)\n       Return(Name(\"result\"))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "c095f8d66c7ac2bfd6f9932e883ffaa49c70939603c8a63d70c20bb57b6b2cd8",
      "rationale": "Macro expansion defining sumSquaresDef as the translated function definition using the already defined function body.",
      "source_rule_id": "rule-c095f8d66c7ac2bfd6f9932e883ffaa49c70939603c8a63d70c20bb57b6b2cd8",
      "start_line": 42,
      "text": "  rule sumSquaresDef\n    => FuncDef(\"sum_squares\", Params(\"lst\"), sumSquaresFunctionBody)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "Base equation defining the allInts domain predicate on the empty value sequence.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 47,
      "text": "  rule allInts(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "0eaeb5b17c648b0a8ad8a966a29b8ffda8ae72e57c6340b236bb5d08457693f7",
      "rationale": "Recursive equation defining the allInts domain predicate on a cons sequence and descending to its tail.",
      "source_rule_id": "rule-0eaeb5b17c648b0a8ad8a966a29b8ffda8ae72e57c6340b236bb5d08457693f7",
      "start_line": 48,
      "text": "  rule allInts(vCons(V:Val, REST:ValSeq))\n    => isInt(V) andBool notBool isRefV(V) andBool allInts(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 54,
      "module": "VERIFICATION",
      "normalized_sha256": "9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
      "rationale": "Equation defining the named helper definedProjectInt to be the existing Int sort predicate.",
      "source_rule_id": "rule-9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
      "start_line": 54,
      "text": "  rule definedProjectInt(V:Val) => isInt(V)"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 65,
      "module": "VERIFICATION",
      "normalized_sha256": "ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "rationale": "Guarded defining equation for the newly named total projection projectIntTotal in terms of the existing partial cast.",
      "source_rule_id": "rule-ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "start_line": 63,
      "text": "  rule projectIntTotal(V:Val) => {V}:>Int\n    requires definedProjectInt(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 72,
      "module": "VERIFICATION",
      "normalized_sha256": "7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
      "rationale": "Defining collapse equation for the newly named projectIntTotal helper when its argument is already statically an Int.",
      "source_rule_id": "rule-7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
      "start_line": 71,
      "text": "  rule projectIntTotal(I:Int) => I\n    [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 94,
      "module": "VERIFICATION",
      "normalized_sha256": "a2c356f833dbe5d8656c0510541d708f2415524e2d39084edb89f3f3b6a309be",
      "rationale": "Guarded equation defining squareContribution for indices divisible by three.",
      "source_rule_id": "rule-a2c356f833dbe5d8656c0510541d708f2415524e2d39084edb89f3f3b6a309be",
      "start_line": 92,
      "text": "  rule squareContribution(V:Int, I:Int)\n    => V *Int V\n    requires pyMod(I, 3) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 98,
      "module": "VERIFICATION",
      "normalized_sha256": "06b7d0f99ecc9b2ebe9afe7995c4b5fb2b945138bf184e87f679ca3527a05156",
      "rationale": "Guarded equation defining squareContribution for the cube branch, where divisibility by four holds after excluding divisibility by three.",
      "source_rule_id": "rule-06b7d0f99ecc9b2ebe9afe7995c4b5fb2b945138bf184e87f679ca3527a05156",
      "start_line": 95,
      "text": "  rule squareContribution(V:Int, I:Int)\n    => (V *Int V) *Int V\n    requires pyMod(I, 3) =/=Int 0\n      andBool pyMod(I, 4) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 102,
      "module": "VERIFICATION",
      "normalized_sha256": "a9946087b5edf468fb762998a4f64a2cecc26ce525d053c7e561b659483433d8",
      "rationale": "Guarded equation defining squareContribution for the unchanged-value branch.",
      "source_rule_id": "rule-a9946087b5edf468fb762998a4f64a2cecc26ce525d053c7e561b659483433d8",
      "start_line": 99,
      "text": "  rule squareContribution(V:Int, I:Int)\n    => V\n    requires pyMod(I, 3) =/=Int 0\n      andBool pyMod(I, 4) =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 108,
      "module": "VERIFICATION",
      "normalized_sha256": "b174e6129224d9f5ad68539ce9af85243bb457a88d7612df488400b36a0c2c34",
      "rationale": "Base equation defining the tail-recursive sumSquaresAcc summary on the empty sequence.",
      "source_rule_id": "rule-b174e6129224d9f5ad68539ce9af85243bb457a88d7612df488400b36a0c2c34",
      "start_line": 108,
      "text": "  rule sumSquaresAcc(.ValSeq, _I:Int, ACC:Int) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 114,
      "module": "VERIFICATION",
      "normalized_sha256": "b6e5d20a07b42f93baef310baa2cab4a41a2bc5bc6c57b5ebc3aa3cc659fbca9",
      "rationale": "Recursive equation defining sumSquaresAcc on an Int-valued head by advancing the index, accumulator, and tail.",
      "source_rule_id": "rule-b6e5d20a07b42f93baef310baa2cab4a41a2bc5bc6c57b5ebc3aa3cc659fbca9",
      "start_line": 109,
      "text": "  rule sumSquaresAcc(vCons(V:Val, REST:ValSeq), I:Int, ACC:Int)\n    => sumSquaresAcc(\n         REST,\n         I +Int 1,\n         ACC +Int squareContribution(projectIntTotal(V), I))\n    requires isInt(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 117,
      "module": "VERIFICATION",
      "normalized_sha256": "306ca907699b20bf461d70c10001a7e2db6bb4ff6180b37d644182b5802eb42c",
      "rationale": "Complementary off-domain equation totalizing the proof-local sumSquaresAcc summary for a non-Int head.",
      "source_rule_id": "rule-306ca907699b20bf461d70c10001a7e2db6bb4ff6180b37d644182b5802eb42c",
      "start_line": 115,
      "text": "  rule sumSquaresAcc(vCons(V:Val, _REST:ValSeq), _I:Int, _ACC:Int)\n    => 0\n    requires notBool isInt(V)"
    }
