/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv_path='/reference/rule-inventory.json'
out_path='/workspace/trust-boundary.json'
with open(inv_path) as f: inv=json.load(f)
with open(out_path) as f: out=json.load(f)
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
expected=[r['source_rule_id'] for r in inv['rules']]
actual=[r['source_rule_id'] for r in out['rules']]
assert actual == expected
assert len(actual) == len(set(actual)) == len(expected)
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
for src, dst in zip(inv['rules'], out['rules']):
    assert list(dst.keys()) == ['source_rule_id','classification','rationale'], dst
    assert dst['classification'] in allowed
    assert isinstance(dst['rationale'], str) and dst['rationale'].strip()
    if any(a.startswith('simplification') for a in src.get('attributes', [])):
        assert dst['classification'] in {'DEFINITION','DOMAIN_LEMMA'}, (src['source_rule_id'], dst['classification'])
counts=Counter(r['classification'] for r in out['rules'])
print('inventory_sha256='+out['inventory_sha256'])
print('rules='+str(len(actual)))
for k in ['DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA']:
    print(f'{k}={counts[k]}')
print('canonical_order=yes unique=yes exact_keys=yes simplification_constraint=yes')
