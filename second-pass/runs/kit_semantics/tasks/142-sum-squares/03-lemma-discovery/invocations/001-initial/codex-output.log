--- verification.k ---
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Exact syntactic abbreviations for the translated solution.py body.
  syntax Stmts ::= "sumSquaresLoopBody" [macro]
  rule sumSquaresLoopBody
    => If(
         Compare(BinOp("%", Name("index"), Int(3)), CmpOp("==", Int(0))),
         AugAssign(
           Name("result"),
           "+",
           BinOp("*", Name("value"), Name("value")))
         .Stmts,
         If(
           Compare(BinOp("%", Name("index"), Int(4)), CmpOp("==", Int(0))),
           AugAssign(
             Name("result"),
             "+",
             BinOp(
               "*",
               BinOp("*", Name("value"), Name("value")),
               Name("value")))
           .Stmts,
           AugAssign(Name("result"), "+", Name("value"))
           .Stmts)
         .Stmts)
       AugAssign(Name("index"), "+", Int(1))
       .Stmts

  syntax Stmts ::= "sumSquaresFunctionBody" [macro]
  rule sumSquaresFunctionBody
    => Assign(Name("result"), Int(0))
       Assign(Name("index"), Int(0))
       Assign(Name("value"), Int(0))
       For(Name("value"), Name("lst"), sumSquaresLoopBody)
       Return(Name("result"))
       .Stmts

  syntax Stmt ::= "sumSquaresDef" [macro]
  rule sumSquaresDef
    => FuncDef("sum_squares", Params("lst"), sumSquaresFunctionBody)

  // Domain predicate: exactly the finite ValSeq values whose elements are Int.
  syntax Bool ::= allInts(ValSeq) [function, total]
  rule allInts(.ValSeq) => true
  rule allInts(vCons(V:Val, REST:ValSeq))
    => isInt(V) andBool notBool isRefV(V) andBool allInts(REST)

  // A guarded total projection following K's total-projection idiom.  It
  // exposes the Int subsort only on paths where isInt has been established.
  syntax Bool ::= definedProjectInt(Val) [function, total]
  rule definedProjectInt(V:Val) => isInt(V)

  syntax Int ::= projectIntTotal(Val)
    [function, total, symbol(projectIntTotal), no-evaluators]

  rule #Ceil({@V:Val}:>Int)
    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    [simplification]

  rule projectIntTotal(V:Val) => {V}:>Int
    requires definedProjectInt(V)
    [concrete, simplification(10), preserves-definedness]

  rule {V:Val}:>Int => projectIntTotal(V)
    requires definedProjectInt(V)
    [symbolic(V), simplification, preserves-definedness]

  rule projectIntTotal(I:Int) => I
    [simplification]

  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
    [simplification]

  // Guarded dispatch twins of MPY-INT's Int multiplication and addition.
  // They do not change either operation; they expose the static Int operands
  // carried by symbolic Val variables after allInts has supplied the guards.
  rule applyBin("*", V:Val, W:Val)
    => projectIntTotal(V) *Int projectIntTotal(W)
    requires isInt(V) andBool isInt(W)
    [simplification]

  rule applyBin("+", I:Int, V:Val)
    => I +Int projectIntTotal(V)
    requires isInt(V)
    [simplification]

  // Mathematical contribution of the element at index I.
  syntax Int ::= squareContribution(Int, Int) [function, total]
  rule squareContribution(V:Int, I:Int)
    => V *Int V
    requires pyMod(I, 3) ==Int 0
  rule squareContribution(V:Int, I:Int)
    => (V *Int V) *Int V
    requires pyMod(I, 3) =/=Int 0
      andBool pyMod(I, 4) ==Int 0
  rule squareContribution(V:Int, I:Int)
    => V
    requires pyMod(I, 3) =/=Int 0
      andBool pyMod(I, 4) =/=Int 0

  // Exact tail-recursive fold over the remaining integer-valued sequence.
  // The complementary non-Int case totalizes the mathematical helper outside
  // the theorem's allInts domain; it is never used by either positive claim.
  syntax Int ::= sumSquaresAcc(ValSeq, Int, Int) [function, total]
  rule sumSquaresAcc(.ValSeq, _I:Int, ACC:Int) => ACC
  rule sumSquaresAcc(vCons(V:Val, REST:ValSeq), I:Int, ACC:Int)
    => sumSquaresAcc(
         REST,
         I +Int 1,
         ACC +Int squareContribution(projectIntTotal(V), I))
    requires isInt(V)
  rule sumSquaresAcc(vCons(V:Val, _REST:ValSeq), _I:Int, _ACC:Int)
    => 0
    requires notBool isInt(V)
endmodule

--- prove.sh ---
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete-smoke.py > concrete-smoke.mpy
python3 differential_test.py

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun solution.mpy --definition runtime-kompiled | tee krun-solution.out
krun concrete-smoke.mpy --definition runtime-kompiled | tee krun-smoke.out

kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kast solution.mpy \
  --definition verification-kompiled \
  --module VERIFICATION \
  --sort Module \
  --expand-macros \
  --output kore > solution-term.kore

kast \
  --expression 'Module(sumSquaresDef)' \
  --definition verification-kompiled \
  --module VERIFICATION \
  --sort Module \
  --expand-macros \
  --output kore > verification-term.kore

cmp solution-term.kore verification-term.kore
echo "translated program and verification term are identical"

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.loop-invariant | tee kprove-loop.out

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --trusted SPEC.loop-invariant | tee kprove-target.out

krun concrete-smoke.mpy \
  --definition verification-kompiled | tee krun-smoke-verification.out
cmp krun-smoke.out krun-smoke-verification.out
echo "fixed and proof-extended concrete outputs are identical"

set +e
kprove spec-vacuity.k \
  --definition verification-kompiled \
  --spec-module SPEC-VACUITY 2>&1 | tee vacuity.out
vacuity_status=${PIPESTATUS[0]}

kprove spec-body-mutation.k \
  --definition verification-kompiled \
  --spec-module SPEC-BODY-MUTATION 2>&1 | tee body-mutation.out
body_mutation_status=${PIPESTATUS[0]}

kprove spec-projection-vacuity.k \
  --definition verification-kompiled \
  --spec-module SPEC-PROJECTION-VACUITY 2>&1 | tee projection-mutation.out
projection_mutation_status=${PIPESTATUS[0]}
set -e

test "$vacuity_status" -ne 0
test "$body_mutation_status" -ne 0
test "$projection_mutation_status" -ne 0
rg -q 'WarnStuckClaimState' vacuity.out
rg -q 'WarnStuckClaimState' body-mutation.out
rg -q 'WarnStuckClaimState' projection-mutation.out

echo "EXPECTED FAILURE: false result (exit $vacuity_status)"
echo "EXPECTED FAILURE: mutated body (exit $body_mutation_status)"
echo "EXPECTED FAILURE: wrong projection (exit $projection_mutation_status)"

--- spec.k ---
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Loop circularity.  The exact return and #endcall continuation remains in
  // place, so the claim covers the loop, Return, and the fixed frame pop.
  claim [loop-invariant]:
    <k>
      #loop(list(VS:ValSeq), Name("value"), sumSquaresLoopBody)
      ~> (Return(Name("result")) .Stmts)
      ~> #endcall
      =>
      sumSquaresAcc(VS, INDEX, ACC)
    </k>
    <env> 1 => 0 </env>
    <scopes>
      (SC:Map
       1 |-> scope(
         "lst" |-> INPUT:Val
         "result" |-> ACC:Int
         "index" |-> INDEX:Int
         "value" |-> CURRENT:Val,
         parent(0)))
      =>
      ?FINALSC:Map
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> HEAP:Map </heap>
    <heapLoc> NEXT:Int </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(VS)
      andBool INDEX >=Int 0
      andBool notBool (1 in_keys(SC))

  // Primary whole-program entry for a Python list object in the supplied heap
  // model.  The heap cell is unchanged, proving that the input is not mutated.
  claim [sum-squares]:
    <k>
      #loadAll(Module(sumSquaresDef))
      ~> Call(Name("sum_squares"), ref(H))
      =>
      sumSquaresAcc(VS, 0, 0)
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      =>
      ?GLOBALS:Map
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> H:Int |-> list(VS) HEAP:Map </heap>
    <heapLoc> NEXT:Int </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(VS)
      andBool notBool (H in_keys(HEAP))

  // Equivalent read-only claim-input representation explicitly supported by
  // MPY-CORE for proofs.
  claim [sum-squares-bare]:
    <k>
      #loadAll(Module(sumSquaresDef))
      ~> Call(Name("sum_squares"), list(VS:ValSeq))
      =>
      sumSquaresAcc(VS, 0, 0)
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      =>
      ?GLOBALS:Map
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(VS)
endmodule

