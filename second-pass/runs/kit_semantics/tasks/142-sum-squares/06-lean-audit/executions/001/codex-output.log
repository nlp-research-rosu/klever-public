FileNotFoundError: [Errno 2] No such file or directory: '/proc/5/exe'

codex
The failure is caused by the audit container’s PID namespace: `/proc/<getpid()>/exe` does not exist, while Lean 4.22 hard-codes that path to locate itself. I confirmed this independently. I’m applying a local, read-only-environment shim under `/tmp/audit-work` that redirects only that self-executable lookup to `/proc/self/exe`; it does not modify or bypass any project, proof, or checker behavior.
apply patch
patch: completed
/tmp/audit-work/proc_self_readlink.c
diff --git a//tmp/audit-work/proc_self_readlink.c b//tmp/audit-work/proc_self_readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..fbd84813dd15b23bdc7a836c1203d2223cde614a
--- /dev/null
+++ b//tmp/audit-work/proc_self_readlink.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    char expected[64];
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+        if (real_readlink == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+
+    snprintf(expected, sizeof(expected), "/proc/%ld/exe", (long)getpid());
+    if (strcmp(path, expected) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

