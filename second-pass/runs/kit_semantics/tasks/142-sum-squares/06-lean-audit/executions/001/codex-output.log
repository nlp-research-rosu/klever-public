+import Proof
+
+namespace BridgeMutationAudit
+
+def constantPlus (_left _right : SortInt) : SortInt := 0
+def constantProject (_value : SortVal) : SortInt := 0
+def constantApplyBin
+    (_operator : SortString) (_left _right : SortVal) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+
+-- Each assertion is intentionally false.  A successful elaboration would
+-- show that the operational witness failed to distinguish a bad mutation.
+example : constantPlus (-7) 11 = 4 := by rfl
+example : constantProject (SortVal.inj_SortInt 37) = 37 := by rfl
+example :
+    constantApplyBin
+      "+" (SortVal.inj_SortInt (-7)) (SortVal.inj_SortInt 11) =
+        SortVal.inj_SortInt 4 := by rfl
+
+end BridgeMutationAudit
