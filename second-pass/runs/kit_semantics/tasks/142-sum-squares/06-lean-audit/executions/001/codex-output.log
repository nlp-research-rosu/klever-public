    obtain ⟨VInt, rfl⟩ := exists_int_of_defined V h.1
    obtain ⟨WInt, rfl⟩ := exists_int_of_defined W h.2
    rfl
  · intro V I h
    simp only [isInt_injected] at h
    obtain ⟨VInt, rfl⟩ := exists_int_of_defined V h
