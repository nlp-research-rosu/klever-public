--- /dev/null
+++ b//tmp/audit-work/lean-audit.wOaxmy/BridgeAudit.lean
@@ -0,0 +1,55 @@
+import Proof
+
+open Proof
+
+example : _andBool_ true true = true := rfl
+example : _andBool_ true false = false := rfl
+example : Proof.«_+Int_» (-7) 11 = 4 := rfl
+example : Proof.«_*Int_» (-4) 5 = -20 := rfl
+
+example :
+    «definedProjectInt(_)_VERIFICATION_Bool_Val»
+      (SortVal.inj_SortInt 37) = true := rfl
+example :
+    «definedProjectInt(_)_VERIFICATION_Bool_Val»
+      SortVal.«noneV_MPY-CORE_Val» = false := rfl
+
+example :
+    isInt
+      (SortK.kseq (SortKItem.inj_SortInt (-9)) SortK.dotk) = true := rfl
+example :
+    isInt
+      (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = false := rfl
+
+example :
+    «project:Int»
+      (SortK.kseq (SortKItem.inj_SortInt (-9)) SortK.dotk) = -9 := rfl
+example :
+    projectIntTotal (SortVal.inj_SortInt 37) = 37 := rfl
+example :
+    «project:Int?»
+      (SortK.kseq (SortKItem.inj_SortInt (-9)) SortK.dotk) = some (-9) := rfl
+example :
+    «project:Int?»
+      (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = none := rfl
+
+example :
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "*" (SortVal.inj_SortInt (-4)) (SortVal.inj_SortInt 5) =
+        SortVal.inj_SortInt (-20) := rfl
+example :
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt (-7)) (SortVal.inj_SortInt 11) =
+        SortVal.inj_SortInt 4 := rfl
+example :
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt 8) (SortVal.inj_SortBool true) =
+        SortVal.inj_SortInt 9 := rfl
+
+-- These distinct witnesses reject constant, identity, and zeroed mutations
+-- of the load-bearing arithmetic and projection implementations.
+example : Proof.«_+Int_» 2 3 ≠ Proof.«_+Int_» 2 4 := by decide
+example : Proof.«_*Int_» 2 3 ≠ Proof.«_*Int_» 2 4 := by decide
+example :
+    projectIntTotal (SortVal.inj_SortInt 2) ≠
+      projectIntTotal (SortVal.inj_SortInt 3) := by decide
diff --git a//tmp/audit-work/lean-audit.wOaxmy/BridgeMutationAudit.lean b//tmp/audit-work/lean-audit.wOaxmy/BridgeMutationAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..21d1269888dc1697db8c12aba843a64b2baddc87
--- /dev/null
+++ b//tmp/audit-work/lean-audit.wOaxmy/BridgeMutationAudit.lean
@@ -0,0 +1,20 @@
+import Proof
+
+namespace BridgeMutationAudit
+
+def constantPlus (_left _right : SortInt) : SortInt := 0
+def constantProject (_value : SortVal) : SortInt := 0
+def constantApplyBin
+    (_operator : SortString) (_left _right : SortVal) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+
+-- Each assertion is intentionally false.  A successful elaboration would
+-- show that the operational witness failed to distinguish a bad mutation.
+example : constantPlus (-7) 11 = 4 := by rfl
+example : constantProject (SortVal.inj_SortInt 37) = 37 := by rfl
+example :
+    constantApplyBin
+      "+" (SortVal.inj_SortInt (-7)) (SortVal.inj_SortInt 11) =
+        SortVal.inj_SortInt 4 := by rfl
+
+end BridgeMutationAudit
