diff --git a/concrete-smoke.py b/concrete-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..0c651130c7949c9563533be266dcf7db427ef55b
--- /dev/null
+++ b/concrete-smoke.py
@@ -0,0 +1,17 @@
+def sum_squares(lst):
+    result = 0
+    index = 0
+    for value in lst:
+        if index % 3 == 0:
+            result += value * value
+        elif index % 4 == 0:
+            result += value * value * value
+        else:
+            result += value
+        index += 1
+    return result
+
+
+assert sum_squares([1, 2, 3]) == 6
+assert sum_squares([]) == 0
+assert sum_squares([-1, -5, 2, -1, -5]) == -126
