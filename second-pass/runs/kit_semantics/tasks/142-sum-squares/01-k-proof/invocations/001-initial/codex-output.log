diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..5c25dfdbdf899226e9515e05f86cee3e7b29214d
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: initialize result to 1.  The correct empty-list
+  // postcondition must no longer be provable.
+  claim [mutated-body]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "sum_squares",
+          Params("lst"),
+          Assign(Name("result"), Int(1))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(Name("value"), Name("lst"), sumSquaresLoopBody)
+          Return(Name("result"))
+          .Stmts)))
+      ~> Call(Name("sum_squares"), ref(0))
+      =>
+      sumSquaresAcc(.ValSeq, 0, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?GLOBALS:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-projection-vacuity.k b/spec-projection-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..fe56cfe85dc0d9bd97b904adcc5b54877bb80cd7
--- /dev/null
+++ b/spec-projection-vacuity.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module SPEC-PROJECTION-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false opposite interpretation of the guarded projection.
+  claim [wrong-projection]:
+    <k> projectIntTotal(2) => 3 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
