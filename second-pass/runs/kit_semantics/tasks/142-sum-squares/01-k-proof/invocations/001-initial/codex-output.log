--- /dev/null
+++ b/concrete-smoke.py
@@ -0,0 +1,18 @@
+def sum_squares(lst):
+    result = 0
+    index = 0
+    value = 0
+    for value in lst:
+        if index % 3 == 0:
+            result += value * value
+        elif index % 4 == 0:
+            result += value * value * value
+        else:
+            result += value
+        index += 1
+    return result
+
+
+assert sum_squares([1, 2, 3]) == 6
+assert sum_squares([]) == 0
+assert sum_squares([-1, -5, 2, -1, -5]) == -126
