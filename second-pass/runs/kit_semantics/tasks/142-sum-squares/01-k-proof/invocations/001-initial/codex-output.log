+mismatches = 0
+for length in range(6):
+    for values in itertools.product(range(-3, 4), repeat=length):
+        checked += 1
+        if sum_squares(list(values)) != oracle(values):
+            mismatches += 1
+
+print(f"cases={checked} mismatches={mismatches} smoke_body_matches_solution=yes")
+assert mismatches == 0
