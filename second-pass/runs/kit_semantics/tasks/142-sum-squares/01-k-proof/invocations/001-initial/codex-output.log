+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      sumSquaresAcc(VS, INDEX, ACC)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(
+         "lst" |-> INPUT:Val
+         "result" |-> ACC:Int
