@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: initialize result to 1.  The correct empty-list
+  // postcondition must no longer be provable.
+  claim [mutated-body]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "sum_squares",
+          Params("lst"),
+          Assign(Name("result"), Int(1))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(Name("value"), Name("lst"), sumSquaresLoopBody)
+          Return(Name("result"))
+          .Stmts)))
+      ~> Call(Name("sum_squares"), list(.ValSeq))
+      =>
+      sumSquaresAcc(.ValSeq, 0, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?GLOBALS:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
