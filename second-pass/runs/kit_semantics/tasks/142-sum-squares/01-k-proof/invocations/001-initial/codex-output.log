@@ -0,0 +1,18 @@
+def sum_squares(lst):
+    result = 0
+    index = 0
+    value = 0
+    for value in lst:
+        if index % 3 == 0:
+            result += value * value
+        elif index % 4 == 0:
+            result += value * value * value
