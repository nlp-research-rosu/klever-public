Module(
  FuncDef("sum_squares", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("index"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Compare(BinOp("%", Name("index"), Int(3)), CmpOp("==", Int(0))),
        AugAssign(
          Name("result"),
          "+",
          BinOp("*", Name("value"), Name("value"))),
        If(Compare(BinOp("%", Name("index"), Int(4)), CmpOp("==", Int(0))),
          AugAssign(
            Name("result"),
            "+",
            BinOp(
              "*",
              BinOp("*", Name("value"), Name("value")),
              Name("value"))),
          AugAssign(Name("result"), "+", Name("value"))))
      AugAssign(Name("index"), "+", Int(1)))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(Call(Name("sum_squares"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(5)))),
      CmpOp("==", UnaryOp("-", Int(126)))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(Int(2), Int(3), Int(4), Int(5), Int(2))),
      CmpOp("==", Int(44))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(Int(0), Int(0), Int(0), Int(0), UnaryOp("-", Int(2)))),
      CmpOp("==", UnaryOp("-", Int(8)))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(2))),
      CmpOp("==", Int(4)))))
