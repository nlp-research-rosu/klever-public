+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(2, vCons(3, vCons(4, vCons(5, vCons(2, .ValSeq))))))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
