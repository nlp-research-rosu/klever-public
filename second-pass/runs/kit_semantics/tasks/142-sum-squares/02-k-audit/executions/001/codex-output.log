+    <heap> H3:Map </heap>
+    <heapLoc> N3:Int </heapLoc>
+    <stack> ST3:List </stack>
+    <ret> R3:RetState </ret>
+    <exc> X3:Exc </exc>
+    <exit-code> C3:Int </exit-code>
+
+  claim [summary-common-multiple]:
+    <k>
+      sumSquaresAcc(
+        vCons(
+          0,
+          vCons(
+            0,
+            vCons(
+              0,
+              vCons(
+                0,
+                vCons(
+                  0,
+                  vCons(
