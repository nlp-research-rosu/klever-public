expected='a989755915f844600f9b1dcd8e6dfac68f054eaae6f8627488f8c6eb643ed614'
vals={'rel':rel.encode(),'dotrel':('./'+rel).encode(),'slashrel':('/'+rel).encode(),'hash':h.encode(),'data':data,'size':size.encode(),'file':b'file','f':b'f'}
seps=[b'',b'\\0',b'\\n',b' ',b'  ',b':']
found=[]
