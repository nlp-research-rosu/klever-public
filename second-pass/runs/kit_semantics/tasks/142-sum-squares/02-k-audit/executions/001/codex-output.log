+- loop: `VS=.ValSeq`, `INDEX=0`, `ACC=0`, `SC=.Map`,
+  `INPUT=list(.ValSeq)`, `CURRENT=0`, empty heap;
+- primary: `VS=.ValSeq`, `H=0`, `HEAP=.Map`, `NEXT=1`;
+- bare: `VS=.ValSeq`.
