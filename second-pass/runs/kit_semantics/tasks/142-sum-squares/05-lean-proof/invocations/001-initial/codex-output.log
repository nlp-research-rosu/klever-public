+#eval showDispatch (applyBinResult "%" (.inj_SortFloat 3.5) (.inj_SortFloat 1.0))
+#eval showDispatch (applyBinResult "**" (.inj_SortFloat 4.0) (.inj_SortFloat 0.5))
