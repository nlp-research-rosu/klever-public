diff --git a//tmp/lean-pid-shim.c b//tmp/lean-pid-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..37ec1558b53c41c592ec61a41f4a21de555604d1
--- /dev/null
+++ b//tmp/lean-pid-shim.c
@@ -0,0 +1,28 @@
+#include <sys/types.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char buffer[4096];
+    int fd = open("/proc/self/status", O_RDONLY);
+    if (fd < 0) return 1;
+    ssize_t length = read(fd, buffer, sizeof buffer - 1);
+    close(fd);
+    if (length <= 0) return 1;
+    buffer[length] = '\0';
+    for (ssize_t i = 0; i + 4 < length; ++i) {
+        if ((i == 0 || buffer[i - 1] == '\n') &&
+            buffer[i] == 'P' && buffer[i + 1] == 'i' &&
+            buffer[i + 2] == 'd' && buffer[i + 3] == ':') {
+            ssize_t j = i + 4;
+            while (j < length && (buffer[j] == ' ' || buffer[j] == '\t')) ++j;
+            pid_t pid = 0;
+            while (j < length && buffer[j] >= '0' && buffer[j] <= '9') {
+                pid = pid * 10 + (buffer[j] - '0');
+                ++j;
+            }
+            if (pid > 0) return pid;
+        }
+    }
+    return 1;
+}
