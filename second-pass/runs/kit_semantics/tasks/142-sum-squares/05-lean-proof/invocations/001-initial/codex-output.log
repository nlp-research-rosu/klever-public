+import Proof
+
+open Proof
+
+def showDispatch : Option SortVal → String
+  | some (SortVal.inj_SortInt value) => s!"Int({value})"
+  | some (SortVal.inj_SortFloat value) => s!"Float({value})"
+  | some (SortVal.inj_SortBool value) => s!"Bool({value})"
+  | some _ => "Other"
+  | none => "NoRule"
+
+#eval showDispatch (applyBinResult "//" (.inj_SortInt (-5)) (.inj_SortInt 3))
+#eval showDispatch (applyBinResult "%" (.inj_SortInt (-5)) (.inj_SortInt 3))
+#eval showDispatch (applyBinResult "+" (.inj_SortInt 7) (.inj_SortBool true))
+#eval showDispatch (applyBinResult "**" (.inj_SortInt 2) (.inj_SortInt 5))
+#eval showDispatch (applyBinResult "/" (.inj_SortInt 7) (.inj_SortInt 2))
+#eval showDispatch (applyBinResult "+" (.inj_SortInt 2) (.inj_SortFloat 0.5))
+#eval showDispatch (applyBinResult "%" (.inj_SortFloat 3.5) (.inj_SortFloat 1.0))
+#eval showDispatch (applyBinResult "**" (.inj_SortFloat 4.0) (.inj_SortFloat 0.5))
+#eval showDispatch (applyBinResult "**" (.inj_SortInt 2) (.inj_SortInt (-1)))
