+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+      "==" (SortVal.inj_SortInt 13) (SortVal.inj_SortInt (-13)) = false := by
+  rfl
+example :
+    Proof.«applyUn(_,_)_MPY-CORE_Val_String_Val»
+      "-" (SortVal.inj_SortInt 13) = SortVal.inj_SortInt (-13) := by
+  rfl
+example :
+    Proof.«applyUn(_,_)_MPY-CORE_Val_String_Val»
+      "-" (SortVal.inj_SortInt (-13)) = SortVal.inj_SortInt 13 := by
+  rfl
+
