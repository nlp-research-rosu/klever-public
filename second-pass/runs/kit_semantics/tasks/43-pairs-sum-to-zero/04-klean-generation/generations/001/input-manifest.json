{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "VERIFICATION",
      "normalized_sha256": "8348557acb9f13893399c872ddae569bc70937b7abc79fbe39494743b080aa93",
      "rationale": "This unconditional equation defines the total hasInverse occurrence-count summary, including the distinct-position two-zero case.",
      "source_rule_id": "rule-8348557acb9f13893399c872ddae569bc70937b7abc79fbe39494743b080aa93",
      "start_line": 8,
      "text": "  rule hasInverse(X, FULL)\n    => ((X ==Int 0) andBool (cntOccVS(FULL, 0) >Int 1))\n       orBool\n       ((X =/=Int 0) andBool\n         (cntOccVS(FULL, 0 -Int X) >Int 0))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "2ebe172a962d634da4247333469c7c769941308cbaa1ffb0733ad2c17efc3b87",
      "rationale": "This is the empty-sequence base equation for the recursively defined anyInverse mathematical summary.",
      "source_rule_id": "rule-2ebe172a962d634da4247333469c7c769941308cbaa1ffb0733ad2c17efc3b87",
      "start_line": 18,
      "text": "  rule anyInverse(.ValSeq, _FULL) => false"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "f0f2741daac7483fe012897d489038765088adda53a780fb059bfe91cd605192",
      "rationale": "This structural cons recurrence defines anyInverse by combining the current element's summary with the recursively processed remainder.",
      "source_rule_id": "rule-f0f2741daac7483fe012897d489038765088adda53a780fb059bfe91cd605192",
      "start_line": 19,
      "text": "  rule anyInverse(vCons(X:Val, REM), FULL)\n    => (isInt(X) andBool hasInverse(intProj(X), FULL))\n       orBool anyInverse(REM, FULL)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "This equation defines the empty-sequence base case of the allInts domain predicate.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 24,
      "text": "  rule allInts(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "d25e64ac0656cbce08dd6ef3cd864d49a4614f3e415d6533ea1c726c4a025b1a",
      "rationale": "This structural recurrence defines allInts on a cons sequence using the head sort test and the recursively defined tail predicate.",
      "source_rule_id": "rule-d25e64ac0656cbce08dd6ef3cd864d49a4614f3e415d6533ea1c726c4a025b1a",
      "start_line": 25,
      "text": "  rule allInts(vCons(X:Val, REM)) => isInt(X) andBool allInts(REM)"
    }
  ],
