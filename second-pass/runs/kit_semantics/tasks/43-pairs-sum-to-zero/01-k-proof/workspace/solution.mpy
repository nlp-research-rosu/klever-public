Module(
  FuncDef("pairs_sum_to_zero", Params("l"),
    Assign(Name("found"), Bool(false))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp("==", Int(0))),
        If(Compare(
          Call(Attribute(Name("l"), "count"), Int(0)),
          CmpOp(">", Int(1))),
          Assign(Name("found"), Bool(true)),
          ),
        If(Compare(
          Call(Attribute(Name("l"), "count"), UnaryOp("-", Name("x"))),
          CmpOp(">", Int(0))),
          Assign(Name("found"), Bool(true)),
          )))
    Return(Name("found"))))
