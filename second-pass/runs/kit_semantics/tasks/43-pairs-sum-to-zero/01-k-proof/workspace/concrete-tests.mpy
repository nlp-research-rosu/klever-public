Module(
  FuncDef("pairs_sum_to_zero", Params("l"),
    Assign(Name("found"), Bool(false))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp("==", Int(0))),
        If(Compare(
          Call(Attribute(Name("l"), "count"), Int(0)),
          CmpOp(">", Int(1))),
          Assign(Name("found"), Bool(true)),
          ),
        If(Compare(
          Call(Attribute(Name("l"), "count"), UnaryOp("-", Name("x"))),
          CmpOp(">", Int(0))),
          Assign(Name("found"), Bool(true)),
          )))
    Return(Name("found")))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(Int(1), Int(3), Int(5), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(Int(1), Int(3), UnaryOp("-", Int(2)), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(Int(1), Int(2), Int(3), Int(7))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(
          Int(2),
          Int(4),
          UnaryOp("-", Int(5)),
          Int(3),
          Int(5),
          Int(7))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("pairs_sum_to_zero"), ListExpr(Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("pairs_sum_to_zero"), ListExpr()),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("pairs_sum_to_zero"), ListExpr(Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("pairs_sum_to_zero"), ListExpr(Int(0), Int(0))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(UnaryOp("-", Int(4)), Int(4))),
      CmpOp("==", Bool(true)))))
