diff --git a/projection.k b/projection.k
new file mode 100644
index 0000000000000000000000000000000000000000..c7659379b462d1bb06f68b5597ac8d6844a67684
--- /dev/null
+++ b/projection.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module INT-PROJECTION
+  imports MPY
+
+  // A total, guarded sort projection.  The non-Int value is irrelevant to the
+  // proof bridges, whose domain requires isInt(V), but makes totality explicit.
+  syntax Int ::= intProj(Val) [function, total]
+  rule intProj(I:Int) => I
+  rule intProj(V:Val) => 0
+    requires notBool isInt(V)
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8ee0a2d01056498693e82a57f8df3cadacc558c8
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+run_expected_failure() {
+  local log_file="$1"
+  shift
+
+  set +e
+  "$@" >"$log_file" 2>&1
+  local command_exit=$?
+  set -e
+
+  cat "$log_file"
+  if [[ $command_exit -eq 0 ]]; then
+    echo "UNEXPECTED_SUCCESS: $*"
+    return 1
+  fi
+  if rg -q 'missing hook|ErrorException' "$log_file"; then
+    echo "INVALID_FAILURE_MODE: $*"
+    return 1
+  fi
+  echo "EXPECTED_FAILURE_EXIT=$command_exit: $*"
+}
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py concrete-tests.py differential_test.py
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+krun concrete-tests.mpy --definition runtime-kompiled \
+  | tee concrete-tests.krun.out
+
+kompile --backend haskell connection-definition.k \
+  --main-module CONNECTION-DEFINITION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition connection-kompiled
+
+kprove connection-spec.k \
+  --definition connection-kompiled \
+  --spec-module CONNECTION-SPEC
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+run_expected_failure spec-vacuity.out \
+  kprove spec-vacuity.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY
+
+run_expected_failure spec-body-mutation.out \
+  kprove spec-body-mutation.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-BODY-MUTATION
+
+run_expected_failure connection-bad-int-equality.out \
+  kprove connection-mutation-spec.k \
+    --definition connection-kompiled \
+    --spec-module CONNECTION-MUTATION-SPEC \
+    --claims CONNECTION-MUTATION-SPEC.bad-int-equality
+
+run_expected_failure connection-bad-int-unary-minus.out \
+  kprove connection-mutation-spec.k \
+    --definition connection-kompiled \
+    --spec-module CONNECTION-MUTATION-SPEC \
+    --claims CONNECTION-MUTATION-SPEC.bad-int-unary-minus
+
+python3 differential_test.py | tee differential_test.out
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..66535c883a3f0a0befab4f6b17d32b5d93ffd6f0
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def pairs_sum_to_zero(l):
+    found = False
+    x = 0
+    for x in l:
+        if x == 0:
+            if l.count(0) > 1:
+                found = True
+        else:
+            if l.count(-x) > 0:
+                found = True
+    return found
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..2ec582f9e2d10d1186afada14e3cfeb7d30a9a6d
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: the nonzero branch incorrectly requires two inverse
+  // occurrences.  For [1, -1] the correct result is true, so this must fail.
+  claim [mutated-body]:
+    <k>
+      #loop(
+        list(vCons(1, vCons(-1, .ValSeq))),
+        Name("x"),
+        If(Compare(Name("x"), CmpOp("==", Int(0))),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"), Int(0)),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> (false => true)
+        "l"     |-> list(vCons(1, vCons(-1, .ValSeq)))
+        "x"     |-> (0 => -1),
+        parent(0))
+      ...
+    </scopes>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..7e904d0e7a565478e3527b5fd81faf04da8a878d
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: on the realizable empty-list input, the loop leaves
+  // found false. Claiming true must be rejected.
+  claim [false-result]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("x"),
+        If(Compare(Name("x"), CmpOp("==", Int(0))),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"), Int(0)),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(0))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> (false => true)
+        "l"     |-> list(.ValSeq)
+        "x"     |-> 0,
+        parent(0))
+      ...
+    </scopes>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8d99d20f386bf30e981c125a23168d824e62c95b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Program boundary: the exact translated function definition is loaded and
+  // called with an unboxed semantic list.  Input domain: every element is Int.
+  // Observable result: the returned Bool.  Other cells are unchanged.
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(REM:ValSeq),
+        Name("x"),
+        If(Compare(Name("x"), CmpOp("==", Int(0))),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"), Int(0)),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(0))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> (FOUND:Bool => FOUND orBool anyInverse(REM, FULL))
+        "l"     |-> list(FULL:ValSeq)
+        "x"     |-> (_X0:Val => ?XF:Val),
+        parent(0))
+      ...
+    </scopes>
+    requires allInts(FULL) andBool allInts(REM)
+
+  claim [pairs-sum-to-zero]:
+    <k>
+      #loadAll(Module(
+        FuncDef("pairs_sum_to_zero", Params("l"),
+          Assign(Name("found"), Bool(false))
+          Assign(Name("x"), Int(0))
+          For(Name("x"), Name("l"),
+            If(Compare(Name("x"), CmpOp("==", Int(0))),
+              If(Compare(
+                Call(Attribute(Name("l"), "count"), Int(0)),
+                CmpOp(">", Int(1))),
+                Assign(Name("found"), Bool(true)),
+                .Stmts),
+              If(Compare(
+                Call(Attribute(Name("l"), "count"),
+                     UnaryOp("-", Name("x"))),
+                CmpOp(">", Int(0))),
+                Assign(Name("found"), Bool(true)),
+                .Stmts)))
+          Return(Name("found"))
+        )
+        Assign(
+          Name("$result"),
+          Call(Name("pairs_sum_to_zero"), list(FULL:ValSeq)))
+      ))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope((.Map => ?MODULE:Map), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(FULL)
+    ensures {?MODULE["$result"]}:>Bool ==Bool anyInverse(FULL, FULL)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..aeb86449a539068b6861daadf2300c882c0b383f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,37 @@
+requires "projection.k"
+
+module VERIFICATION
+  imports INT-PROJECTION
+
+  // True exactly when X has a distinct-position additive inverse in FULL.
+  syntax Bool ::= hasInverse(Int, ValSeq) [function, total]
+  rule hasInverse(X, FULL)
+    => ((X ==Int 0) andBool (cntOccVS(FULL, 0) >Int 1))
+       orBool
+       ((X =/=Int 0) andBool
+         (cntOccVS(FULL, 0 -Int X) >Int 0))
+
+  // True exactly when some integer in REM has an inverse partner in FULL.
+  // Non-Int elements are ignored, making the definition total; the theorem's
+  // allInts precondition excludes that branch.
+  syntax Bool ::= anyInverse(ValSeq, ValSeq) [function, total]
+  rule anyInverse(.ValSeq, _FULL) => false
+  rule anyInverse(vCons(X:Val, REM), FULL)
+    => (isInt(X) andBool hasInverse(intProj(X), FULL))
+       orBool anyInverse(REM, FULL)
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(X:Val, REM)) => isInt(X) andBool allInts(REM)
+
+  // Sort-recovery bridges. Their guards say that the Val is an injected Int;
+  // connection-spec.k proves the corresponding fixed-semantics equalities
+  // without importing this module.
+  rule applyCmp("==", V:Val, I:Int) => intProj(V) ==Int I
+    requires isInt(V)
+    [simplification]
+
+  rule applyUn("-", V:Val) => 0 -Int intProj(V)
+    requires isInt(V)
+    [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..6361e9d4e8d45d25cafd51840289fca40757dec4
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,22 @@
+def pairs_sum_to_zero(l):
+    found = False
+    x = 0
+    for x in l:
+        if x == 0:
+            if l.count(0) > 1:
+                found = True
+        else:
+            if l.count(-x) > 0:
+                found = True
+    return found
+
+
+assert pairs_sum_to_zero([1, 3, 5, 0]) == False
+assert pairs_sum_to_zero([1, 3, -2, 1]) == False
+assert pairs_sum_to_zero([1, 2, 3, 7]) == False
+assert pairs_sum_to_zero([2, 4, -5, 3, 5, 7]) == True
+assert pairs_sum_to_zero([1]) == False
+assert pairs_sum_to_zero([]) == False
+assert pairs_sum_to_zero([0]) == False
+assert pairs_sum_to_zero([0, 0]) == True
+assert pairs_sum_to_zero([-4, 4]) == True
