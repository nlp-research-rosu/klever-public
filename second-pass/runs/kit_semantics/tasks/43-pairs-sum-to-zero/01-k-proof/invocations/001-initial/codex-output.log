diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..e52d9b731a8c34b4786da2b6dcc9bd7efda189e5
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,29 @@
+from itertools import product
+
+from solution import pairs_sum_to_zero
+
+
+def oracle(values):
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            if values[i] + values[j] == 0:
+                return True
+    return False
+
+
+tested = 0
+mismatches = []
+for length in range(6):
+    for values in product(range(-2, 3), repeat=length):
+        data = list(values)
+        expected = oracle(data)
+        actual = pairs_sum_to_zero(data)
+        tested += 1
+        if actual != expected:
+            mismatches.append((data, expected, actual))
+
+print(f"DIFFERENTIAL_CASES={tested}")
+print(f"MISMATCHES={len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
diff --git a/projection.k b/projection.k
new file mode 100644
index 0000000000000000000000000000000000000000..c7659379b462d1bb06f68b5597ac8d6844a67684
--- /dev/null
+++ b/projection.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module INT-PROJECTION
+  imports MPY
+
+  // A total, guarded sort projection.  The non-Int value is irrelevant to the
+  // proof bridges, whose domain requires isInt(V), but makes totality explicit.
+  syntax Int ::= intProj(Val) [function, total]
+  rule intProj(I:Int) => I
+  rule intProj(V:Val) => 0
+    requires notBool isInt(V)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..66535c883a3f0a0befab4f6b17d32b5d93ffd6f0
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def pairs_sum_to_zero(l):
+    found = False
+    x = 0
+    for x in l:
+        if x == 0:
+            if l.count(0) > 1:
+                found = True
+        else:
+            if l.count(-x) > 0:
+                found = True
+    return found
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..2ec582f9e2d10d1186afada14e3cfeb7d30a9a6d
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: the nonzero branch incorrectly requires two inverse
+  // occurrences.  For [1, -1] the correct result is true, so this must fail.
+  claim [mutated-body]:
+    <k>
+      #loop(
+        list(vCons(1, vCons(-1, .ValSeq))),
+        Name("x"),
+        If(Compare(Name("x"), CmpOp("==", Int(0))),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"), Int(0)),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> (false => true)
+        "l"     |-> list(vCons(1, vCons(-1, .ValSeq)))
+        "x"     |-> (0 => -1),
+        parent(0))
+      ...
+    </scopes>
+endmodule
