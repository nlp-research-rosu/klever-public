+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> (false => true)
+        "l"     |-> list(vCons(1, vCons(-1, .ValSeq)))
+        "x"     |-> (0 => ?XF:Val),
+        parent(0))
+      ...
+    </scopes>
+endmodule
