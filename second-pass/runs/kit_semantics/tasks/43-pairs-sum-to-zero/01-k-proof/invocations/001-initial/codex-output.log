diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d0a156ced89bc396d5b7bf542e8de0eabdb37c1a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Program boundary: the exact translated function definition is loaded and
+  // called with an unboxed semantic list.  Input domain: every element is Int.
+  // Observable result: the returned Bool.  Other cells are unchanged.
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(REM:ValSeq),
+        Name("x"),
+        If(Compare(Name("x"), CmpOp("==", Int(0))),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"), Int(0)),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(0))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> (FOUND:Bool => FOUND orBool anyInverse(REM, FULL))
+        "l"     |-> list(FULL:ValSeq)
+        "x"     |-> (_X0:Int => ?XF:Int),
+        parent(0))
+      ...
+    </scopes>
+    requires allInts(FULL) andBool allInts(REM)
+
+  claim [pairs-sum-to-zero]:
+    <k>
+      #loadAll(Module(
+        FuncDef("pairs_sum_to_zero", Params("l"),
+          Assign(Name("found"), Bool(false))
+          Assign(Name("x"), Int(0))
+          For(Name("x"), Name("l"),
+            If(Compare(Name("x"), CmpOp("==", Int(0))),
+              If(Compare(
+                Call(Attribute(Name("l"), "count"), Int(0)),
+                CmpOp(">", Int(1))),
+                Assign(Name("found"), Bool(true)),
+                .Stmts),
+              If(Compare(
+                Call(Attribute(Name("l"), "count"),
+                     UnaryOp("-", Name("x"))),
+                CmpOp(">", Int(0))),
+                Assign(Name("found"), Bool(true)),
+                .Stmts)))
+          Return(Name("found"))
+        )
+        Assign(
+          Name("$result"),
+          Call(Name("pairs_sum_to_zero"), list(FULL:ValSeq)))
+      ))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope((.Map => ?MODULE:Map), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(FULL)
+    ensures {?MODULE["$result"]}:>Bool ==Bool anyInverse(FULL, FULL)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8fc891a61ea1eb516b2aa3cc63bc777ef5428b84
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly when X has a distinct-position additive inverse in FULL.
+  syntax Bool ::= hasInverse(Int, ValSeq) [function, total]
+  rule hasInverse(0, FULL) => cntOccVS(FULL, 0) >Int 1
+  rule hasInverse(X, FULL) => cntOccVS(FULL, 0 -Int X) >Int 0
+    requires X =/=Int 0
+
+  // True exactly when some integer in REM has an inverse partner in FULL.
+  // The function is intentionally partial outside integer ValSeqs; every use
+  // is guarded by allInts.
+  syntax Bool ::= anyInverse(ValSeq, ValSeq) [function]
+  rule anyInverse(.ValSeq, _FULL) => false
+  rule anyInverse(vCons(X:Val, REM), FULL)
+    => hasInverse({X}:>Int, FULL) orBool anyInverse(REM, FULL)
+    requires isInt(X)
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(X:Val, REM)) => isInt(X) andBool allInts(REM)
+
+  // Sort-recovery bridges.  Their guards say that the Val is an injected Int;
+  // connection-spec.k proves the corresponding fixed-semantics transitions
+  // without importing this module.  Both rules preserve the whole continuation.
+  rule applyCmp("==", V:Val, I:Int) => {V}:>Int ==Int I
+    requires isInt(V)
+    [simplification]
+
+  rule applyUn("-", V:Val) => 0 -Int {V}:>Int
+    requires isInt(V)
+    [simplification]
+endmodule

