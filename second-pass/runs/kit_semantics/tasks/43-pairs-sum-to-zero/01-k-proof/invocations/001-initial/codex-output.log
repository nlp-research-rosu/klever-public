+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(0))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
