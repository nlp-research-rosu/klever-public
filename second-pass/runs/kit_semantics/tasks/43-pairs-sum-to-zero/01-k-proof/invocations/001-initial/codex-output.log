+def pairs_sum_to_zero(l):
+    found = False
+    x = 0
+    for x in l:
+        if x == 0:
+            if l.count(0) > 1:
+                found = True
+        else:
+            if l.count(-x) > 0:
+                found = True
+    return found
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..458fa51735f64fefd5b620e5e70f5a70cf647761
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: the nonzero branch incorrectly requires two inverse
+  // occurrences.  For [1, -1] the correct result is true, so this must fail.
+  claim [mutated-body]:
+    <k>
+      #loop(
+        list(vCons(1, vCons(-1, .ValSeq))),
+        Name("x"),
+        If(Compare(Name("x"), CmpOp("==", Int(0))),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"), Int(0)),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> (false => true)
+        "l"     |-> list(vCons(1, vCons(-1, .ValSeq)))
+        "x"     |-> (0 => ?XF:Val),
+        parent(0))
+      ...
+    </scopes>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..cb84854677c3cc2d2741928ab34bbcb3c233fcd0
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: [1, -1] has a zero-sum pair, so the loop changes
+  // found from false to true.  Keeping it false must be rejected.
+  claim [false-result]:
+    <k>
+      #loop(
+        list(vCons(1, vCons(-1, .ValSeq))),
+        Name("x"),
+        If(Compare(Name("x"), CmpOp("==", Int(0))),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"), Int(0)),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(0))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> false
+        "l"     |-> list(vCons(1, vCons(-1, .ValSeq)))
+        "x"     |-> (0 => ?XF:Val),
+        parent(0))
+      ...
+    </scopes>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8d99d20f386bf30e981c125a23168d824e62c95b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Program boundary: the exact translated function definition is loaded and
+  // called with an unboxed semantic list.  Input domain: every element is Int.
+  // Observable result: the returned Bool.  Other cells are unchanged.
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(REM:ValSeq),
+        Name("x"),
+        If(Compare(Name("x"), CmpOp("==", Int(0))),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"), Int(0)),
+            CmpOp(">", Int(1))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts),
+          If(Compare(
+            Call(Attribute(Name("l"), "count"),
+                 UnaryOp("-", Name("x"))),
+            CmpOp(">", Int(0))),
+            Assign(Name("found"), Bool(true)),
+            .Stmts))
+      ) => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "found" |-> (FOUND:Bool => FOUND orBool anyInverse(REM, FULL))
+        "l"     |-> list(FULL:ValSeq)
+        "x"     |-> (_X0:Val => ?XF:Val),
+        parent(0))
+      ...
+    </scopes>
+    requires allInts(FULL) andBool allInts(REM)
+
+  claim [pairs-sum-to-zero]:
+    <k>
+      #loadAll(Module(
+        FuncDef("pairs_sum_to_zero", Params("l"),
+          Assign(Name("found"), Bool(false))
+          Assign(Name("x"), Int(0))
+          For(Name("x"), Name("l"),
+            If(Compare(Name("x"), CmpOp("==", Int(0))),
+              If(Compare(
+                Call(Attribute(Name("l"), "count"), Int(0)),
+                CmpOp(">", Int(1))),
+                Assign(Name("found"), Bool(true)),
+                .Stmts),
+              If(Compare(
+                Call(Attribute(Name("l"), "count"),
+                     UnaryOp("-", Name("x"))),
+                CmpOp(">", Int(0))),
+                Assign(Name("found"), Bool(true)),
+                .Stmts)))
+          Return(Name("found"))
+        )
+        Assign(
+          Name("$result"),
+          Call(Name("pairs_sum_to_zero"), list(FULL:ValSeq)))
+      ))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope((.Map => ?MODULE:Map), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(FULL)
+    ensures {?MODULE["$result"]}:>Bool ==Bool anyInverse(FULL, FULL)
+endmodule
