patch: completed
/tmp/lean-proc-self.c
diff --git a//tmp/lean-proc-self.c b//tmp/lean-proc-self.c
new file mode 100644
index 0000000000000000000000000000000000000000..6f1d68f6093162dcdc05f4e405eb6c69be62564d
--- /dev/null
+++ b//tmp/lean-proc-self.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = 0;
+  if (!real_readlink)
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0)
+    path = "/proc/self/exe";
+
+  return real_readlink(path, buffer, size);
+}
