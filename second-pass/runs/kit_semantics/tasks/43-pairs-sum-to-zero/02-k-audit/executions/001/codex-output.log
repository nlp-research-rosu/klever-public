+            issues.append(f"{label}: {error}")
+            continue
+        status = "OK" if actual == expected else "MISMATCH"
+        print(
+            f"TREE {label}: {status} expected={expected} actual={actual} path={path}"
+        )
+        print(
+            f"TREE {label}: audit-input secondary digest "
