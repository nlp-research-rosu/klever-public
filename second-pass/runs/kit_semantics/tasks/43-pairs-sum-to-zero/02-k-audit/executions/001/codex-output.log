+    ) if kind == "file"]
+    if not trace_files:
+        issues.append("structured trace contains no files")
+    for path in trace_files:
+        print(f"TRACE_FILE {path} size={path.stat().st_size}")
+
+    print(f"ISSUE_COUNT={len(issues)}")
+    for issue in issues:
+        print(f"ISSUE {issue}")
+    return 1 if issues else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
