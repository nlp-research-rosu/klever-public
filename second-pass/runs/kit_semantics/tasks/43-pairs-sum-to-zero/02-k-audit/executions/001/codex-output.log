new file mode 100644
index 0000000000000000000000000000000000000000..f3bcc4181f59f1830a29a21aa6b28077f1fb0c29
--- /dev/null
+++ b/evidence/04_ground_substitution.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module GROUND-SUBSTITUTION
+  imports VERIFICATION
+
+  claim [empty-domain]:
+    <k> allInts(.ValSeq) => true ... </k>
