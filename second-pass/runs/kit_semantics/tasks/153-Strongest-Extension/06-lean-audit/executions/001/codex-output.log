      "start_line": 246,
      "text": "  rule <k>\n         #loop(STRING:Str, Name(\"character\"), INNER-BODY)\n         => .K\n         ...\n       </k>\n       <env> L </env>\n       <scopes>\n         ...\n         L |-> scope(\n           \"class_name\" |-> str(CLASS)\n           \"extensions\" |-> list(ALLEXTS)\n           \"strongest\" |-> str(BEST)\n           \"best_strength\" |-> BESTVAL:Val\n           \"extension\" |-> str(EXT)\n           \"strength\" |-> (\n             S:Int\n             => S +Int extensionStrength(codesOf(STRING))\n           )\n           \"character\" |-> (\n             str(OLDCHAR)\n             => str(lastCharacter(codesOf(STRING), OLDCHAR))\n           ),\n           parent(0)\n         )\n         ...\n       </scopes>\n    [priority(30)]"
    },
