+    ("selected Stage 2 audit tree", K_AUDIT, "k_audit_sha256"),
+    ("Stage 4 generation tree", GENERATION, "klean_generation_sha256"),
+    ("Stage 5 candidate tree", CANDIDATE, "lean_workspace_sha256"),
