+        rule["classification"],
+    )
+
+domain = [rule for rule in rules if rule["classification"] == "DOMAIN_LEMMA"]
+obligations = obligation_map["obligations"]
+check("generator obligation count", len(obligations), generator["obligation_count"])
+check(
