diff --git a//tmp/audit-work/lean_proc_self_shim.c b//tmp/audit-work/lean_proc_self_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..25cc4eff4ee1a1eddf1aab7a764d16dae3417ae5
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_shim.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink)
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+
+    char expected[64];
+    int length = snprintf(expected, sizeof(expected), "/proc/%ld/exe", (long)getpid());
+    if (length > 0 && (size_t)length < sizeof(expected) && strcmp(path, expected) == 0)
+        path = "/proc/self/exe";
+    return real_readlink(path, buffer, size);
+}
