+#include <lean/lean.h>
+#include <stdio.h>
+
+extern void lean_initialize_runtime_module(void);
+extern lean_object *lean_io_app_path(lean_object *world);
+
+int main(void) {
+    lean_initialize_runtime_module();
+    lean_object *result = lean_io_app_path(lean_io_mk_world());
+    if (lean_io_result_is_error(result)) {
+        printf("lean_io_app_path error: ");
+        lean_io_result_show_error(result);
+        return 1;
+    }
+    lean_object *value = lean_io_result_get_value(result);
+    printf("lean_io_app_path ok: %s\n", lean_string_cstr(value));
+    return 0;
+}
diff --git a//tmp/audit-work/lean_proc_self_shim.c b//tmp/audit-work/lean_proc_self_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..25cc4eff4ee1a1eddf1aab7a764d16dae3417ae5
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_shim.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink)
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+
+    char expected[64];
+    int length = snprintf(expected, sizeof(expected), "/proc/%ld/exe", (long)getpid());
+    if (length > 0 && (size_t)length < sizeof(expected) && strcmp(path, expected) == 0)
+        path = "/proc/self/exe";
+    return real_readlink(path, buffer, size);
+}
diff --git a//tmp/audit-work/uv_exepath_probe.c b//tmp/audit-work/uv_exepath_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..760f449b73f1bb91206f8c02ea911508ad443c09
--- /dev/null
+++ b//tmp/audit-work/uv_exepath_probe.c
@@ -0,0 +1,17 @@
+#include <stdio.h>
+#include <unistd.h>
+#include <limits.h>
+#include <stddef.h>
+
+extern int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+    char buffer[PATH_MAX];
+    size_t size = sizeof(buffer);
+    int rc = uv_exepath(buffer, &size);
+    printf("uv_exepath rc=%d size=%zu path=%s\n", rc, size, rc == 0 ? buffer : "");
+    ssize_t n = readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+    if (n >= 0) buffer[n] = '\0';
+    printf("readlink n=%zd path=%s\n", n, n >= 0 ? buffer : "");
+    return 0;
+}
