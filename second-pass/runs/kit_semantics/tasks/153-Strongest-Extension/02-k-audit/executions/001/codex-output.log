+    <scopes>
+      0 |-> scope(
+        .Map
+        => "Strongest_Extension" |->
+             closureVal(
+               "class_name", "extensions", .ParamNames,
+               Return(Str("wrong"))
+               .Stmts,
+               0
+             ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
