+            rel = path.relative_to(root).as_posix()
+            entry_kind = kind(path)
+            digest = sha256(path) if entry_kind == "file" else None
+            if entry_kind == "symlink":
+                digest = os.readlink(path)
+            result[rel] = (entry_kind, digest)
+    return result
+
+
