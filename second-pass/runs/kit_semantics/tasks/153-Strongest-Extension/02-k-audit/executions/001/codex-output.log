candidate	/candidate/spec.k	158	endmodule		4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4	endmodule
# SUMMARY
# candidate	claim	8
# candidate	endmodule	6
# candidate	imports	6
# candidate	module	6
# candidate	requires	4
# candidate	rule	42
# candidate	syntax	18
# supplied	configuration	1
# supplied	context	5
# supplied	endmodule	25
