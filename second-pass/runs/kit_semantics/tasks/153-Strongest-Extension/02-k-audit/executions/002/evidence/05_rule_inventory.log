0081 |   // ==== numeric cross-type membership (Python: 1 == True == 1.0) =============
0082 |   // `x in list` / `x not in list` compare elements with ==K in list.k, which does
0083 |   // NOT collapse across the numeric types (true =/=K 1, 1 =/=K 1.0). Under krun,
0084 |   // override the membership fold with a numeric-aware equality so `in` and
0085 |   // unique()-style dedup behave like CPython for mixed int/bool/float elements.
0086 |   // (set.k needs no change: setV holds int char codes, compared with ==Int, so a
0087 |   // cross-type ==K collapse never arises there.)
0088 |   // krun-only (priority 40 beats list.k's default rules); kprove uses the
0089 |   // structural ==K rules in list.k unchanged.
END 0077 rule
BEGIN 0090 syntax attrs=function
0090 |   syntax Bool ::= numOrKEq(Val, Val) [function]
END 0090 syntax
BEGIN 0091 rule
0091 |   rule numOrKEq(A:Val, B:Val) => applyCmp("==", A, B)
0092 |        requires (isInt(A) orBool isBool(A) orBool isFloat(A))
0093 |         andBool (isInt(B) orBool isBool(B) orBool isFloat(B))
END 0091 rule
BEGIN 0094 rule attrs=owise
0094 |   rule numOrKEq(A:Val, B:Val) => A ==K B [owise]
0095 | 
END 0094 rule
BEGIN 0096 rule attrs=priority
0096 |   rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
0097 |        requires numOrKEq(E, V) [priority(40)]
END 0096 rule
BEGIN 0098 rule attrs=priority
