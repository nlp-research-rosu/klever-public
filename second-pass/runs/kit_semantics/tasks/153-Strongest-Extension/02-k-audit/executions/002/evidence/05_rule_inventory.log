BEGIN 0039 rule
0039 |   rule dHasKey(vCons(A:Val, _:ValSeq), K:Val) => true          requires A ==K K
END 0039 rule
BEGIN 0040 rule
0040 |   rule dHasKey(vCons(A:Val, R:ValSeq), K:Val) => dHasKey(R, K) requires notBool (A ==K K)
