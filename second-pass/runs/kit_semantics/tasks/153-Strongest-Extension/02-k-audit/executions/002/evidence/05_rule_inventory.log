FILE /tmp/audit-work/153-strongest-extension/verification.k
BEGIN 0001 requires
0001 | requires "reference-semantics/semantics.k"
0002 | 
END 0001 requires
BEGIN 0003 module
0003 | module VERIFICATION-BASE
END 0003 module
BEGIN 0004 imports
0004 |   imports MPY
0005 | 
0006 |   // Compile-time abbreviations for the exact translated source blocks.
0007 |   // These are macros, so no execution rule for the program is added.
END 0004 imports
BEGIN 0008 syntax attrs=macro
0008 |   syntax Stmts ::= "INNER-BODY" [macro]
END 0008 syntax
BEGIN 0009 rule
0009 |   rule INNER-BODY
0010 |     => If(
0011 |          Call(Attribute(Name("character"), "isupper"), .Exprs),
0012 |          AugAssign(Name("strength"), "+", Int(1)) .Stmts,
0013 |          If(
0014 |            Call(Attribute(Name("character"), "islower"), .Exprs),
0015 |            AugAssign(Name("strength"), "-", Int(1)) .Stmts,
0016 |            .Stmts
0017 |          ) .Stmts
0018 |        ) .Stmts
0019 | 
END 0009 rule
BEGIN 0020 syntax attrs=macro
0020 |   syntax Stmts ::= "OUTER-BODY" [macro]
END 0020 syntax
BEGIN 0021 rule
0021 |   rule OUTER-BODY
0022 |     => Assign(Name("strength"), Int(0))
0023 |        For(Name("character"), Name("extension"), INNER-BODY)
0024 |        If(
0025 |          BoolOp(
0026 |            "or",
0027 |            Compare(Name("best_strength"), CmpOp("is", NoneVal)),
0028 |            Compare(
0029 |              Name("strength"),
0030 |              CmpOp(">", Name("best_strength"))
0031 |            ),
0032 |            .Exprs
0033 |          ),
0034 |          Assign(Name("strongest"), Name("extension"))
0035 |          Assign(Name("best_strength"), Name("strength"))
0036 |          .Stmts,
0037 |          .Stmts
0038 |        )
0039 |        .Stmts
0040 | 
END 0021 rule
BEGIN 0041 syntax attrs=macro
0041 |   syntax Stmts ::= "STRONGEST-BODY" [macro]
END 0041 syntax
BEGIN 0042 rule
0042 |   rule STRONGEST-BODY
0043 |     => Assign(Name("strongest"), Str(""))
0044 |        Assign(Name("best_strength"), NoneVal)
0045 |        Assign(Name("extension"), Str(""))
0046 |        Assign(Name("character"), Str(""))
0047 |        For(Name("extension"), Name("extensions"), OUTER-BODY)
0048 |        Return(
0049 |          BinOp(
0050 |            "+",
0051 |            BinOp("+", Name("class_name"), Str(".")),
0052 |            Name("strongest")
0053 |          )
0054 |        )
0055 |        .Stmts
0056 | 
0057 |   // The score defined by the prompt, over the reference semantics' code
0058 |   // sequence model. The three guarded cases are exhaustive and disjoint.
END 0042 rule
BEGIN 0059 syntax attrs=function,total
0059 |   syntax Int ::= charStrength(Int) [function, total]
END 0059 syntax
BEGIN 0060 rule
0060 |   rule charStrength(C) => 1
0061 |     requires isUpperC(C)
END 0060 rule
BEGIN 0062 rule
0062 |   rule charStrength(C) => 0 -Int 1
0063 |     requires isLowerC(C)
END 0062 rule
BEGIN 0064 rule
0064 |   rule charStrength(C) => 0
0065 |     requires notBool isUpperC(C) andBool notBool isLowerC(C)
0066 | 
END 0064 rule
BEGIN 0067 syntax attrs=function,total
0067 |   syntax Int ::= extensionStrength(IntSeq) [function, total]
END 0067 syntax
BEGIN 0068 rule
0068 |   rule extensionStrength(.IntSeq) => 0
END 0068 rule
BEGIN 0069 rule
0069 |   rule extensionStrength(iCons(C, CS))
0070 |     => charStrength(C) +Int extensionStrength(CS)
0071 | 
0072 |   // The character variable retains its old value on an empty string and
0073 |   // otherwise retains the final one-character string visited by the loop.
END 0069 rule
BEGIN 0074 syntax attrs=function,total
0074 |   syntax IntSeq ::= lastCharacter(IntSeq, IntSeq) [function, total]
END 0074 syntax
BEGIN 0075 rule
0075 |   rule lastCharacter(.IntSeq, OLD) => OLD
END 0075 rule
BEGIN 0076 rule
0076 |   rule lastCharacter(iCons(C, CS), OLD)
0077 |     => lastCharacter(CS, iCons(C, .IntSeq))
0078 | 
END 0076 rule
BEGIN 0079 syntax attrs=function,total
0079 |   syntax Bool ::= isStringVal(Val) [function, total]
END 0079 syntax
BEGIN 0080 rule
0080 |   rule isStringVal(_:Str) => true
