FILE /tmp/audit-work/153-strongest-extension/reference-semantics/semantics/bool.k
BEGIN 0005 module
0005 | module MPY-BOOL
END 0005 module
BEGIN 0006 imports
0006 |   imports MPY-CORE
0007 | 
END 0006 imports
BEGIN 0008 rule
0008 |   rule applyUn("not", V:Val) => notBool truthy(V)
0009 | 
END 0008 rule
BEGIN 0010 rule
0010 |   rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
END 0010 rule
BEGIN 0011 rule
0011 |   rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2
0012 | 
0013 |   // bool is a subtype of int: a Bool compared with an Int promotes to 0/1 and
0014 |   // re-dispatches to the Int comparison cases (True==1, False==0, True<2, ...).
0015 |   // The == / != Bool x Bool cases above are kept; only the four ordering ops are
0016 |   // promoted for Bool x Bool (to avoid duplicating the two rules above).
END 0011 rule
BEGIN 0017 rule
0017 |   rule applyCmp(OP:String, B:Bool, I:Int) => applyCmp(OP, boolAsInt(B), I)
0018 |        requires isEqOrdOp(OP)
END 0017 rule
BEGIN 0019 rule
0019 |   rule applyCmp(OP:String, I:Int, B:Bool) => applyCmp(OP, I, boolAsInt(B))
0020 |        requires isEqOrdOp(OP)
END 0019 rule
BEGIN 0021 rule
0021 |   rule applyCmp(OP:String, B1:Bool, B2:Bool) => applyCmp(OP, boolAsInt(B1), boolAsInt(B2))
0022 |        requires isOrdOp(OP)
0023 | 
0024 |   // ==== BoolOp: short-circuit, value-returning and / or =====================
0025 |   // the node is its own accumulator: heat the HEAD element only, then either return it
0026 |   // (short-circuit) or drop it and continue
END 0021 rule
BEGIN 0027 context
0027 |   context BoolOp(_, (HOLE:Expr, _:Exprs))
END 0027 context
BEGIN 0028 rule
0028 |   rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
END 0028 rule
BEGIN 0029 rule
0029 |   rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
0030 |        requires truthy(V)
END 0029 rule
BEGIN 0031 rule
0031 |   rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
0032 |        requires notBool truthy(V)
END 0031 rule
BEGIN 0033 rule
0033 |   rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
0034 |        requires truthy(V)
END 0033 rule
BEGIN 0035 rule
0035 |   rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
0036 |        requires notBool truthy(V)
0037 | 
0038 |   // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
0039 |   // operand — and/or return the OBJECT itself (Python identity), not its structure
END 0035 rule
BEGIN 0040 rule attrs=priority
0040 |   rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
0041 |        [priority(40)]
