0134 |        requires X in_keys(M)
0135 |   // a SYNTACTICALLY cell-bound name reads through the heap cell AT THE
0136 |   // LOOKUP (higher priority beats the plain return above on concrete cell
0137 |   // bindings; abstract claim values take the plain rule unchanged) — this
0138 |   // covers cross-frame cell reads (a comprehension closure reading the
0139 |   // enclosing function's cellvar) without a narrowing-prone k-top redex
0140 |   // guarded on the FOUND frame's DECLARED cellvars (pnMember over the
0141 |   // cellsMark): decidable for every concrete frame pin — plain frames and
0142 |   // non-cell names prune outright, so an abstract looked-up value never
0143 |   // drags a narrowing cellV heap match along (probed on 5-intersperse and
0144 |   // Q4's abstract `numbers` in the annotated frame)
END 0132 rule
BEGIN 0145 rule attrs=priority
0145 |   rule <k> #look(X:String, L:Int) => V ... </k>
0146 |        <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
0147 |        <heap> ... H |-> cellV(V:Val) ... </heap>
0148 |        requires X in_keys(M) andBool "$cells" in_keys(M)
0149 |         andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
0150 |         andBool {M[X]}:>Val ==K cellRef(H)
0151 |        [priority(40)]
END 0145 rule
