BEGIN 0076 syntax
0076 |   syntax KItem ::= #dsetK(String, Val)
END 0076 syntax
BEGIN 0077 rule
0077 |   rule <k> Assign(Subscript(Name(X:String), K:Expr), VV:Val) => K ~> #dsetK(X, VV) ... </k>
