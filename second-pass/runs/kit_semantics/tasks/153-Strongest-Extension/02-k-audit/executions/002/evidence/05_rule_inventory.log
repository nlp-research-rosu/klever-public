END 0251 syntax
BEGIN 0252 rule attrs=concrete
0252 |   rule roundF(F:Float)
0253 |     => #if (F -Float floorFloat(F)) ==Float 0.5
0254 |        #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
0255 |               #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
0256 |        #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
0257 |   // round(F, N): CPython rounds the EXACT binary value of F at the Nth decimal
0258 |   // place, half-to-even, then converts to the nearest double. The old code did
0259 |   // Int2Float(roundF(F *Float 10^N)) / 10^N — the float multiply F *Float 10^N
0260 |   // misrounds the half-way decision (witness: a Heron triangle area that must
0261 |   // round to 2.69 came out 2.68). Exact version, via arbitrary-precision integers:
0262 |   //     F = numer / 2^k      numer = Float2Int(F * 2^(52-e)),  k = 52 - exponentFloat(F)
0263 |   //     q = round-half-even( numer * 10^N , 2^k )        (exact big-integer round)
0264 |   //     result = nearest double to q / 10^N
0265 |   //   IEEE division is correctly rounded, so (double)q /Float (double)10^N equals
0266 |   //   the nearest double to q/10^N whenever q and 10^N are exactly representable.
0267 |   // Guarded to finite F with |F| < 1e12 and |F|*10^N < 2^52 (keeps numer and q
0268 |   // exactly representable) and a non-subnormal exponent (avoids 2^k overflowing a
0269 |   // double); the exotic tail keeps the old path, so nothing regresses.
0270 |   // Opaque for kprove, [concrete] for krun.
END 0252 rule
