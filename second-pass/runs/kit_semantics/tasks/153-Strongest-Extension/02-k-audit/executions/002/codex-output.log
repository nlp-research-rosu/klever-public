+             )
+        )
+        "best_strength" |-> noneV
+        "extension" |-> str(iCons(65, .IntSeq))
+        "strength" |-> (0 => 1)
+        "character" |-> (
+          str(.IntSeq) => str(iCons(65, .IntSeq))
+        ),
+        parent(0)
+      )
+      ...
+    </scopes>
+endmodule
