   151	  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
   152	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   153	       requires N >=Int 0
   154	  // negative operand: the '-' sign prefixes the magnitude's digits
   155	  rule applyBuiltin("bin", N:Int, .Vals)
   156	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   157	       requires N <Int 0
   158	  syntax IntSeq ::= binCodes(Int) [function, total]
   159	  rule binCodes(0) => iCons(48, .IntSeq)
   160	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   161	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   162	  rule binAcc(0, ACC:IntSeq) => ACC
   163	  rule binAcc(N:Int, ACC:IntSeq)
   164	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   165	       requires N >Int 0
   166	
   167	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   168	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   169	        => #alloc(list(enumVS(VS, 0))) ... </k>
   170	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   171	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   172	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   173	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   174	
   175	  // ==== map(str, xs) — eager (only the str case is in the subset) =============
   176	  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
   177	        => #alloc(list(mapStrVS(VS))) ... </k>
   178	  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
   179	  rule mapStrVS(.ValSeq) => .ValSeq
   180	  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
   181	  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
   182	
   183	  // ==== int(x) identities (int(round(x)) composes through) ====================
   184	  rule applyBuiltin("int", I:Int, .Vals) => I
   185	
   186	  // ==== ord / chr ===========================================================
   187	  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
   188	  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
   189	       requires 0 <=Int I andBool I <Int 128
   190	
   191	  // ==== str(int) / str(str) =================================================
   192	  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
   193	  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
   194	
   195	  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
   196	  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
   197	       requires 48 <=Int C andBool C <=Int 57
   198	
   199	  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
   200	  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
   201	       requires isLen(CS) >=Int 2
   202	  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
   203	  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
   204	  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
