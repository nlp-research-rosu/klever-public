@@ -0,0 +1,53 @@
+requires "reviewer-pinning.k"
+
+module MODEL-GAP-SPEC
+  imports REVIEWER-PINNING
+
+  // Fixed ASCII model: "" and "Ω" both score zero, so the first extension wins.
+  claim [model-gap]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "Strongest_Extension",
+            Params("class_name", "extensions"),
+            REVIEWED-PROGRAM-BODY
+          )
+          .Stmts
+        )
+      )
+      ~> Call(
+           Name("Strongest_Extension"),
+           str(iCons(71, iCons(97, iCons(112, .IntSeq)))),
+           list(
+             vCons(
+               str(.IntSeq),
+               vCons(str(iCons(937, .IntSeq)), .ValSeq)
+             )
+           ),
+           .Exprs
+         )
+      => str(iCons(71, iCons(97, iCons(112, iCons(46, .IntSeq)))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "Strongest_Extension" |->
+             closureVal(
+               "class_name", "extensions", .ParamNames,
+               REVIEWED-PROGRAM-BODY,
+               0
+             ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/reviewer-pinning.k b/evidence/reviewer-pinning.k
new file mode 100644
index 0000000000000000000000000000000000000000..4675f5527aa92c9841e2677322fa1a927d459e8f
--- /dev/null
+++ b/evidence/reviewer-pinning.k
@@ -0,0 +1,51 @@
+requires "reference-semantics/semantics.k"
+
+module REVIEWER-PINNING
+  imports MPY
+
+  syntax Stmts ::= "REVIEWED-PROGRAM-BODY" [macro]
+  rule REVIEWED-PROGRAM-BODY
+    => Assign(Name("strongest"), Str(""))
+       Assign(Name("best_strength"), NoneVal)
+       Assign(Name("extension"), Str(""))
+       Assign(Name("character"), Str(""))
+       For(
+         Name("extension"),
+         Name("extensions"),
+         Assign(Name("strength"), Int(0))
+         For(
+           Name("character"),
+           Name("extension"),
+           If(
+             Call(Attribute(Name("character"), "isupper"), .Exprs),
+             AugAssign(Name("strength"), "+", Int(1)) .Stmts,
+             If(
+               Call(Attribute(Name("character"), "islower"), .Exprs),
+               AugAssign(Name("strength"), "-", Int(1)) .Stmts,
+               .Stmts
+             ) .Stmts
+           ) .Stmts
+         )
+         If(
+           BoolOp(
+             "or",
+             Compare(Name("best_strength"), CmpOp("is", NoneVal)),
+             Compare(Name("strength"), CmpOp(">", Name("best_strength"))),
+             .Exprs
+           ),
+           Assign(Name("strongest"), Name("extension"))
+           Assign(Name("best_strength"), Name("strength"))
+           .Stmts,
+           .Stmts
+         )
+         .Stmts
+       )
+       Return(
+         BinOp(
+           "+",
+           BinOp("+", Name("class_name"), Str(".")),
+           Name("strongest")
+         )
+       )
+       .Stmts
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9c9230725d6e776a9bb36d82e8d2df2cde159ba7
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+: > "$log_path"
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee -a "$log_path"
+
+set +e
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+set -e
+
+printf 'EXIT_STATUS: %s\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"

