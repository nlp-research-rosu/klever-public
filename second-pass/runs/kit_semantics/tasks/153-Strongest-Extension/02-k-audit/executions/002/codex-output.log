+        ("strict_greater", "C", ["a", "A"]),
+        ("equal_tie_first", "C", ["Ab", "Cd", "XYzz"]),
+        ("less_no_update", "C", ["AA", "bbb"]),
+        ("empty_extension", "", [""]),
+        ("unicode_upper", "Κλάση", ["", "Ω"]),
+        ("unicode_lower", "Κλάση", ["", "ω"]),
+        ("titlecase", "C", ["", "ǅ"]),
+        ("uncased_unicode", "C", ["", "中"]),
+        ("combining", "C", ["A\u0301", "a\u0301"]),
+    ]
+
+    failures: list[str] = []
