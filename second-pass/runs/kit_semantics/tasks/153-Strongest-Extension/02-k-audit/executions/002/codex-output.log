@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module REVIEWER-VACUITY
+  imports TARGET-VERIFICATION
+
+  // Satisfiable input: "B" has score +1 and beats "a" with score -1.
+  // Deliberately false postcondition chooses the losing first extension.
+  claim [wrong-winner]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "Strongest_Extension",
+            Params("class_name", "extensions"),
+            STRONGEST-BODY
+          )
+          .Stmts
+        )
+      )
+      ~> Call(
+           Name("Strongest_Extension"),
+           str(iCons(67, .IntSeq)),
+           list(
+             vCons(
+               str(iCons(97, .IntSeq)),
+               vCons(str(iCons(66, .IntSeq)), .ValSeq)
+             )
+           ),
+           .Exprs
+         )
+      => str(iCons(67, iCons(46, iCons(97, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "Strongest_Extension" |->
+             closureVal(
+               "class_name", "extensions", .ParamNames,
+               STRONGEST-BODY,
+               0
+             ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9c9230725d6e776a9bb36d82e8d2df2cde159ba7
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+: > "$log_path"
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee -a "$log_path"
+
+set +e
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+set -e
+
+printf 'EXIT_STATUS: %s\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"

exec
/bin/bash -lc "rg -n 'isupper|islower|isUpperC|isLowerC|applyCmp\\(\"is\"|applyBin\\(\"[+-]\".*Int|Int\\(I|NoneVal|Name\\(' /reference/reference-semantics/semantics/*.k /reference/reference-semantics/semantics.k | head -n 180" in /audit-output
 succeeded in 0ms:
/reference/reference-semantics/semantics/int.k:9:  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
/reference/reference-semantics/semantics/int.k:11:  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
/reference/reference-semantics/semantics/int.k:12:  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
/reference/reference-semantics/semantics/int.k:22:  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
