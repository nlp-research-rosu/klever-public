   222	module VERIFICATION
   223	  imports VERIFICATION-BASE
   224	
   225	  // Connection-backed static-sort twin of the fixed
   226	  // #iterYield/#loopStep transition.
   227	  rule <k>
   228	         #iterYield(V:Val, list(VS))
   229	         ~> #loopStep(Name("extension"), OUTER-BODY)
   230	         => #bindTgt(Name("extension"), projectStrTotal(V))
   231	            ~> OUTER-BODY
   232	            ~> #loopLbl(
   233	                 #loop(
   234	                   list(VS),
   235	                   Name("extension"),
   236	                   OUTER-BODY
   237	                 )
   238	               )
   239	         ...
   240	       </k>
   241	    requires isStringVal(V)
   242	    [priority(40)]
   243	
   244	  // Exact inner-loop bridge. CONNECTION-SPEC.inner-loop proves this complete
   245	  // transition under VERIFICATION-BASE, which does not import this rule.
   246	  rule <k>
   247	         #loop(STRING:Str, Name("character"), INNER-BODY)
   248	         => .K
   249	         ...
   250	       </k>
   251	       <env> L </env>
   252	       <scopes>
   253	         ...
   254	         L |-> scope(
   255	           "class_name" |-> str(CLASS)
   256	           "extensions" |-> list(ALLEXTS)
   257	           "strongest" |-> str(BEST)
   258	           "best_strength" |-> BESTVAL:Val
   259	           "extension" |-> str(EXT)
   260	           "strength" |-> (
   261	             S:Int
   262	             => S +Int extensionStrength(codesOf(STRING))
   263	           )
   264	           "character" |-> (
   265	             str(OLDCHAR)
   266	             => str(lastCharacter(codesOf(STRING), OLDCHAR))
   267	           ),
   268	           parent(0)
   269	         )
   270	         ...
   271	       </scopes>
   272	    [priority(30)]
   273	endmodule
