    58	  // sequence model. The three guarded cases are exhaustive and disjoint.
    59	  syntax Int ::= charStrength(Int) [function, total]
    60	  rule charStrength(C) => 1
    61	    requires isUpperC(C)
    62	  rule charStrength(C) => 0 -Int 1
    63	    requires isLowerC(C)
    64	  rule charStrength(C) => 0
    65	    requires notBool isUpperC(C) andBool notBool isLowerC(C)
    66	
    67	  syntax Int ::= extensionStrength(IntSeq) [function, total]
    68	  rule extensionStrength(.IntSeq) => 0
    69	  rule extensionStrength(iCons(C, CS))
    70	    => charStrength(C) +Int extensionStrength(CS)
    71	
    72	  // The character variable retains its old value on an empty string and
    73	  // otherwise retains the final one-character string visited by the loop.
    74	  syntax IntSeq ::= lastCharacter(IntSeq, IntSeq) [function, total]
    75	  rule lastCharacter(.IntSeq, OLD) => OLD
    76	  rule lastCharacter(iCons(C, CS), OLD)
    77	    => lastCharacter(CS, iCons(C, .IntSeq))
    78	
    79	  syntax Bool ::= isStringVal(Val) [function, total]
    80	  rule isStringVal(_:Str) => true
    81	  rule isStringVal(_:Val) => false [owise]
    82	
    83	  syntax Bool ::= allStrings(ValSeq) [function, total]
    84	  rule allStrings(.ValSeq) => true
    85	  rule allStrings(vCons(V, VS))
    86	    => isStringVal(V) andBool allStrings(VS)
    87	
    88	  // Guarded total twin of K's partial Val-to-Str subsort projection. It is
    89	  // an identity on Str and has no evaluator that can invent a string value.
    90	  syntax Bool ::= definedProjectStr(Val) [function, total]
    91	  rule definedProjectStr(V) => isStringVal(V)
    92	
    93	  syntax Str ::= projectStrTotal(Val)
    94	    [function, total, symbol(projectStrTotal), no-evaluators]
    95	
    96	  rule #Ceil({@V:Val}:>Str)
    97	    => (
    98	         { definedProjectStr(@V) #Equals true }
    99	         #And #Ceil(@V)
   100	       )
   101	    [simplification]
   102	
   103	  rule projectStrTotal(V:Val) => {V}:>Str
   104	    requires definedProjectStr(V)
   105	    [concrete, simplification(10), preserves-definedness]
   106	
   107	  rule {V:Val}:>Str => projectStrTotal(V)
   108	    requires definedProjectStr(V)
   109	    [symbolic(V), simplification, preserves-definedness]
   110	
   111	  rule projectStrTotal(S:Str) => S
   112	    [simplification]
   113	
   114	  rule projectStrTotal(projectStrTotal(V)) => projectStrTotal(V)
   115	    [simplification]
   116	
   117	  // Exact datatype characterization of the identity projection.
   118	  rule { @V:Val #Equals projectStrTotal(@V) }
   119	    => { isStringVal(@V) #Equals true }
   120	    [simplification]
   121	
   122	  rule { @V:Val #Equals str(codesProject(@V)) }
   123	    => { isStringVal(@V) #Equals true }
   124	    [simplification]
   125	
   126	  syntax IntSeq ::= codesOf(Str) [function, total]
   127	  rule codesOf(str(CS)) => CS
   128	
   129	  syntax IntSeq ::= codesProject(Val)
   130	    [function, total, no-evaluators]
   131	  rule codesProject(str(CS)) => CS
   132	
   133	  rule projectStrTotal(V:Val) => str(codesProject(V))
   134	    requires isStringVal(V)
   135	    [symbolic(V), simplification(20), preserves-definedness]
   136	
   137	  // Exact left-to-right scan summaries. Strict comparison preserves the
   138	  // earlier extension on ties, matching the source program.
   139	  syntax IntSeq ::= bestCodes(ValSeq, IntSeq, Int) [function]
   140	  rule bestCodes(.ValSeq, BEST, _BESTSCORE) => BEST
   141	  rule bestCodes(vCons(V, VS), _BEST, BESTSCORE)
   142	    => bestCodes(
   143	         VS,
   144	         codesProject(V),
   145	         extensionStrength(codesProject(V))
   146	       )
   147	    requires isStringVal(V)
   148	      andBool extensionStrength(codesProject(V)) >Int BESTSCORE
   149	    [simplification]
   150	  rule bestCodes(vCons(V, VS), BEST, BESTSCORE)
   151	    => bestCodes(VS, BEST, BESTSCORE)
   152	    requires isStringVal(V)
   153	      andBool (
   154	        (extensionStrength(codesProject(V)) >Int BESTSCORE)
   155	        ==Bool false
   156	      )
   157	    [simplification]
   158	
   159	  syntax Int ::= bestScore(ValSeq, Int) [function]
   160	  rule bestScore(.ValSeq, BESTSCORE) => BESTSCORE
   161	  rule bestScore(vCons(V, VS), BESTSCORE)
   162	    => bestScore(
   163	         VS,
   164	         extensionStrength(codesProject(V))
   165	       )
   166	    requires isStringVal(V)
   167	      andBool extensionStrength(codesProject(V)) >Int BESTSCORE
   168	    [simplification]
   169	  rule bestScore(vCons(V, VS), BESTSCORE)
   170	    => bestScore(VS, BESTSCORE)
   171	    requires isStringVal(V)
   172	      andBool (
   173	        (extensionStrength(codesProject(V)) >Int BESTSCORE)
   174	        ==Bool false
   175	      )
   176	    [simplification]
   177	
   178	  // Exact summaries for the loop variables that remain in the Python frame.
   179	  syntax IntSeq ::= lastExtension(ValSeq, IntSeq) [function]
   180	  rule lastExtension(.ValSeq, OLD) => OLD
   181	  rule lastExtension(vCons(V, VS), _OLD)
   182	    => lastExtension(VS, codesProject(V))
   183	    requires isStringVal(V)
   184	
   185	  syntax Int ::= lastStrength(ValSeq, Int) [function]
   186	  rule lastStrength(.ValSeq, OLD) => OLD
   187	  rule lastStrength(vCons(V, VS), _OLD)
   188	    => lastStrength(
   189	         VS,
   190	         extensionStrength(codesProject(V))
   191	       )
   192	    requires isStringVal(V)
   193	
   194	  syntax IntSeq ::= lastCharacterAcross(ValSeq, IntSeq) [function]
   195	  rule lastCharacterAcross(.ValSeq, OLD) => OLD
   196	  rule lastCharacterAcross(vCons(V, VS), OLD)
   197	    => lastCharacterAcross(
   198	         VS,
   199	         lastCharacter(codesProject(V), OLD)
   200	       )
   201	    requires isStringVal(V)
   202	
   203	  // Whole-function mathematical result. The empty-list case is the
   204	  // implementation's explicit, total extension of the prompt.
   205	  syntax Str ::= expectedResult(IntSeq, ValSeq) [function]
   206	  rule expectedResult(CLASS, .ValSeq)
   207	    => str(
   208	         seqConcat(
   209	           seqConcat(CLASS, iCons(46, .IntSeq)),
   210	           .IntSeq
   211	         )
   212	       )
   213	  rule expectedResult(CLASS, vCons(str(CS), VS))
   214	    => str(
   215	         seqConcat(
   216	           seqConcat(CLASS, iCons(46, .IntSeq)),
   217	           bestCodes(VS, CS, extensionStrength(CS))
   218	         )
   219	       )
   220	endmodule
