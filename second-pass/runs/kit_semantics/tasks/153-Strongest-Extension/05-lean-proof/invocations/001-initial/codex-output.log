diff --git a//tmp/lean-readlink-fix.c b//tmp/lean-readlink-fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..40901b732330b1fba9934df05ac6fc73ef2be1d1
--- /dev/null
+++ b//tmp/lean-readlink-fix.c
@@ -0,0 +1,17 @@
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *restrict path, char *restrict buffer, size_t size) {
+  const size_t length = strlen(path);
+  const char *resolved = path;
+  if (length >= 10 &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    resolved = "/proc/self/exe";
+  }
+  return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}
