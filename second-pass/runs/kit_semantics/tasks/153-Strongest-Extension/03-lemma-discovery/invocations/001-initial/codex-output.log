RULE 0
{
  "attributes": [],
  "end_line": 18,
  "module": "VERIFICATION-BASE",
  "normalized_sha256": "c9e766351d9a554a3516c782ea902cd0e58f4f7bc86e13833e93b86e1cea3d2f",
  "source_rule_id": "rule-c9e766351d9a554a3516c782ea902cd0e58f4f7bc86e13833e93b86e1cea3d2f",
  "start_line": 9,
  "text": "  rule INNER-BODY\n    => If(\n         Call(Attribute(Name(\"character\"), \"isupper\"), .Exprs),\n         AugAssign(Name(\"strength\"), \"+\", Int(1)) .Stmts,\n         If(\n           Call(Attribute(Name(\"character\"), \"islower\"), .Exprs),\n           AugAssign(Name(\"strength\"), \"-\", Int(1)) .Stmts,\n           .Stmts\n         ) .Stmts\n       ) .Stmts"
}

RULE 1
{
  "attributes": [],
  "end_line": 39,
  "module": "VERIFICATION-BASE",
  "normalized_sha256": "17a3ac998db71bdf10c3c89a3d1c7c68c0ab1e446bdbc72166dbbcb524f9f7fe",
  "source_rule_id": "rule-17a3ac998db71bdf10c3c89a3d1c7c68c0ab1e446bdbc72166dbbcb524f9f7fe",
  "start_line": 21,
  "text": "  rule OUTER-BODY\n    => Assign(Name(\"strength\"), Int(0))\n       For(Name(\"character\"), Name(\"extension\"), INNER-BODY)\n       If(\n         BoolOp(\n           \"or\",\n           Compare(Name(\"best_strength\"), CmpOp(\"is\", NoneVal)),\n           Compare(\n             Name(\"strength\"),\n             CmpOp(\">\", Name(\"best_strength\"))\n           ),\n           .Exprs\n         ),\n         Assign(Name(\"strongest\"), Name(\"extension\"))\n         Assign(Name(\"best_strength\"), Name(\"strength\"))\n         .Stmts,\n         .Stmts\n       )\n       .Stmts"
}

RULE 2
{
  "attributes": [],
  "end_line": 55,
  "module": "VERIFICATION-BASE",
  "normalized_sha256": "cecfeea25238c1c70932f4dcc380b47591a21b7696964f2eb539ed002d9d1156",
  "source_rule_id": "rule-cecfeea25238c1c70932f4dcc380b47591a21b7696964f2eb539ed002d9d1156",
  "start_line": 42,
  "text": "  rule STRONGEST-BODY\n    => Assign(Name(\"strongest\"), Str(\"\"))\n       Assign(Name(\"best_strength\"), NoneVal)\n       Assign(Name(\"extension\"), Str(\"\"))\n       Assign(Name(\"character\"), Str(\"\"))\n       For(Name(\"extension\"), Name(\"extensions\"), OUTER-BODY)\n       Return(\n         BinOp(\n           \"+\",\n           BinOp(\"+\", Name(\"class_name\"), Str(\".\")),\n           Name(\"strongest\")\n         )\n       )\n       .Stmts"
}

