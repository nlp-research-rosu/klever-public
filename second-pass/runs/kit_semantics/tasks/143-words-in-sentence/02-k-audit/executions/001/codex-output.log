    verification_modules = [
        name
        for name in file_modules.get(verification_file, ())
        if name.endswith("-VERIFICATION")
    ]
    if len(verification_modules) != 1:
        raise KleanExportError(
            "verification.k must define exactly one -VERIFICATION module"
        )
    verification_module = verification_modules[0]
    reached_modules: set[str] = set()
    reached_files: set[Path] = set()
    pending_modules = [verification_module]
    pending_files = [verification_file]
    while pending_modules or pending_files:
        while pending_files:
            path = pending_files.pop()
