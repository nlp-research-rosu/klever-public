'no-build-cache':[p for p in allp if not any(x.endswith('-kompiled') or x=='runtime-kompiled' or x=='__pycache__' for x in p.relative_to(root).parts)],
'source-ext':[p for p in allp if p.is_file() and p.suffix in {'.py','.mpy','.k','.sh','.md'}],
'required':[root/x for x in ['solution.py','solution.mpy','verification.k','spec.k','prove.sh','PROOF.md']],
}
