+      0 |-> scope(
+             "words_in_sentence"
+               |-> closureVal("sentence", #wordsBody, 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 1 <=Int isLen(CS)
+     andBool isLen(CS) <=Int 100
+endmodule
