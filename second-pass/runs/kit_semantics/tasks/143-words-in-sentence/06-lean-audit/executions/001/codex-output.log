+#!/usr/bin/env bash
+set -euo pipefail
+
+cd /tmp/audit-work/fresh-k-001
+
+solution_command=(
+  kast solution.mpy
+  --definition verification-kompiled
+  --module VERIFICATION
+  --sort Module
+  --expand-macros
+  --output kore
+)
+macro_command=(
+  kast
+  --expression '#solutionModule'
+  --definition verification-kompiled
+  --module VERIFICATION
+  --sort Module
+  --expand-macros
+  --output kore
+)
+
+printf 'SOLUTION_COMMAND:'
+printf ' %q' "${solution_command[@]}"
+printf '\nMACRO_COMMAND:'
+printf ' %q' "${macro_command[@]}"
