PROVE.SH
#!/usr/bin/env bash
set -euo pipefail

# Recreate the submitted transliteration.
python3 py2mpy.py solution.py > solution.mpy

# Concrete LLVM execution of the prompt examples and boundary cases.
python3 py2mpy.py concrete_examples.py > concrete_examples.mpy
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun concrete_examples.mpy \
  --definition runtime-kompiled \
  2>&1 | tee concrete_examples.krun.out

# The proof's compile-time program alias must be exactly solution.mpy.
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled
kast solution.mpy \
  --definition verification-kompiled \
  --module VERIFICATION \
  --sort Module \
  --expand-macros \
  --output kore > solution.ast.kore
kast \
  --expression '#solutionModule' \
  --definition verification-kompiled \
  --module VERIFICATION \
  --sort Module \
  --expand-macros \
  --output kore > verification-module.ast.kore
cmp solution.ast.kore verification-module.ast.kore
echo 'AST_IDENTITY: PASS'

# First close the loop circularity, then prove the simultaneous claim set
# containing both the loop invariant and the whole-program claim.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.scan-loop \
  2>&1 | tee proof-loop.out
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  2>&1 | tee proof-full.out

# Independent executable oracle evidence.
python3 test_solution.py

# Gate A5: appending "x" to the required result is deliberately false.
if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY \
     > spec-vacuity.out 2>&1; then
  echo 'ERROR: false-postcondition mutation unexpectedly proved'
  exit 1
else
  vacuity_status=$?
  echo "EXPECTED_VACUITY_FAILURE_EXIT=${vacuity_status}"
  rg -m 1 'WarnStuckClaimState' spec-vacuity.out
fi

# Gate A1: changing the emitted separator from space to "x" must break the
# connection between execution and the original summary.
kompile verification-body-mutant.k \
  --backend haskell \
  --main-module VERIFICATION-BODY-MUTANT \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-body-mutant-kompiled
if kprove spec-body-mutant.k \
     --definition verification-body-mutant-kompiled \
     --spec-module SPEC-BODY-MUTANT \
     > spec-body-mutant.out 2>&1; then
  echo 'ERROR: body mutation unexpectedly proved'
  exit 1
else
  body_mutant_status=$?
  echo "EXPECTED_BODY_MUTATION_FAILURE_EXIT=${body_mutant_status}"
  rg -m 1 'WarnStuckClaimState' spec-body-mutant.out
fi

echo 'ALL_PROOF_AND_VALIDATION_CHECKS_PASSED'

VERIFICATION.K
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Compile-time aliases for the exact AST emitted in solution.mpy.
  syntax Expr ::= "#primeTuple" [macro]
  rule #primeTuple
    => TupleExpr(
         Int(2),  Int(3),  Int(5),  Int(7),  Int(11),
         Int(13), Int(17), Int(19), Int(23), Int(29),
         Int(31), Int(37), Int(41), Int(43), Int(47),
         Int(53), Int(59), Int(61), Int(67), Int(71),
         Int(73), Int(79), Int(83), Int(89), Int(97))

  syntax Stmt ::= "#emitSelected" [macro]
  rule #emitSelected
    => Assign(
         Name("result"),
         BinOp(
           "+",
           BinOp("+", Name("result"), Name("word")),
           Str(" ")))

  syntax Stmt ::= "#maybeEmit" [macro]
  rule #maybeEmit
    => If(
         Compare(
           Call(Name("len"), Name("word")),
           CmpOp("in", #primeTuple)),
         #emitSelected,
         .Stmts)

  syntax Stmt ::= "#scanBody" [macro]
  rule #scanBody
    => If(
         Compare(Name("char"), CmpOp("==", Str(" "))),
         #maybeEmit
         Assign(Name("word"), Str("")),
         Assign(
           Name("word"),
           BinOp("+", Name("word"), Name("char"))))

  syntax Stmts ::= "#wordsBody" [macro]
  rule #wordsBody
    => Assign(Name("result"), Str(""))
       Assign(Name("word"), Str(""))
       Assign(Name("char"), Str(""))
       For(Name("char"), Name("sentence"), #scanBody)
       #maybeEmit
       Return(Call(Attribute(Name("result"), "strip"), .Exprs))

  syntax Module ::= "#solutionModule" [macro]
  rule #solutionModule
    => Module(
         FuncDef(
           "words_in_sentence",
           Params("sentence"),
           #wordsBody))

  // The implementation's finite prime test. Under the prompt's length bound
  // every word length is at most 100, so these are exactly all possible primes.
  syntax Bool ::= primeLength(Int)
    [function, total, no-evaluators]
  rule primeLength(N) => true
    requires N ==Int 2  orBool N ==Int 3  orBool N ==Int 5
      orBool N ==Int 7  orBool N ==Int 11 orBool N ==Int 13
      orBool N ==Int 17 orBool N ==Int 19 orBool N ==Int 23
      orBool N ==Int 29 orBool N ==Int 31 orBool N ==Int 37
      orBool N ==Int 41 orBool N ==Int 43 orBool N ==Int 47
      orBool N ==Int 53 orBool N ==Int 59 orBool N ==Int 61
      orBool N ==Int 67 orBool N ==Int 71 orBool N ==Int 73
      orBool N ==Int 79 orBool N ==Int 83 orBool N ==Int 89
      orBool N ==Int 97
    [simplification]
  rule primeLength(N) => false
    requires notBool (
      N ==Int 2  orBool N ==Int 3  orBool N ==Int 5
      orBool N ==Int 7  orBool N ==Int 11 orBool N ==Int 13
      orBool N ==Int 17 orBool N ==Int 19 orBool N ==Int 23
      orBool N ==Int 29 orBool N ==Int 31 orBool N ==Int 37
      orBool N ==Int 41 orBool N ==Int 43 orBool N ==Int 47
      orBool N ==Int 53 orBool N ==Int 59 orBool N ==Int 61
      orBool N ==Int 67 orBool N ==Int 71 orBool N ==Int 73
      orBool N ==Int 79 orBool N ==Int 83 orBool N ==Int 89
      orBool N ==Int 97)
    [simplification]

  syntax IntSeq ::= emitWord(IntSeq, IntSeq) [function, total]
  rule emitWord(W:IntSeq, O:IntSeq)
    => #if primeLength(isLen(W))
       #then seqConcat(seqConcat(O, W), iCons(32, .IntSeq))
       #else O
       #fi

  // Exact fold summaries for the three locals changed by the character loop.
  // scanOutput excludes the final unterminated word; #maybeEmit after the loop
  // performs that final emission.
  syntax IntSeq ::= scanOutput(IntSeq, IntSeq, IntSeq)
    [function, total, no-evaluators]
  rule scanOutput(.IntSeq, _W:IntSeq, O:IntSeq) => O
    [simplification]
  rule scanOutput(iCons(32, R:IntSeq), W:IntSeq, O:IntSeq)
    => scanOutput(R, .IntSeq, emitWord(W, O))
    [simplification]
  rule scanOutput(iCons(C:Int, R:IntSeq), W:IntSeq, O:IntSeq)
    => scanOutput(R, seqConcat(W, iCons(C, .IntSeq)), O)
    requires C =/=Int 32
    [simplification]

  syntax IntSeq ::= scanWord(IntSeq, IntSeq)
    [function, total, no-evaluators]
  rule scanWord(.IntSeq, W:IntSeq) => W
    [simplification]
  rule scanWord(iCons(32, R:IntSeq), _W:IntSeq)
    => scanWord(R, .IntSeq)
    [simplification]
  rule scanWord(iCons(C:Int, R:IntSeq), W:IntSeq)
    => scanWord(R, seqConcat(W, iCons(C, .IntSeq)))
    requires C =/=Int 32
    [simplification]

  syntax IntSeq ::= scanLast(IntSeq, IntSeq)
    [function, total, no-evaluators]
  rule scanLast(.IntSeq, CH:IntSeq) => CH [simplification]
  rule scanLast(iCons(C:Int, R:IntSeq), _CH:IntSeq)
    => scanLast(R, iCons(C, .IntSeq))
    [simplification]

  syntax IntSeq ::= sentenceResult(IntSeq) [function, total]
  rule sentenceResult(CS:IntSeq)
    => revIS(
         trimWS(
           revIS(
             trimWS(
               emitWord(
                 scanWord(CS, .IntSeq),
                 scanOutput(CS, .IntSeq, .IntSeq))))))

endmodule

SPEC.K
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Circularity at the exact loop head reached by words_in_sentence.
  claim [scan-loop]:
    <k>
      #loop(str(CS:IntSeq), Name("char"), #scanBody)
      =>
      .K
      ...
    </k>
    <env> 1 </env>
    <scopes>
      0 |-> scope(
             "words_in_sentence"
               |-> closureVal("sentence", #wordsBody, 0),
             parent(-1))
      -1 |-> builtinsScope
      1 |-> scope(
             "sentence" |-> str(INPUT:IntSeq)
             "result"   |-> (str(O:IntSeq) => str(scanOutput(CS, W, O)))
             "word"     |-> (str(W:IntSeq) => str(scanWord(CS, W)))
             "char"     |-> (str(CH:IntSeq) => str(scanLast(CS, CH))),
             parent(0))
    </scopes>
    <scopeLoc> 2 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(KONT:K, 0, 1)) </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  // Whole program: load the exact translated definition, call it, and return
  // the prime-length words in their original order.
  claim [words-in-sentence]:
    <k>
      #loadAll(#solutionModule)
      ~> Call(Name("words_in_sentence"), str(CS:IntSeq))
      =>
      str(sentenceResult(CS))
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
      =>
      0 |-> scope(
             "words_in_sentence"
               |-> closureVal("sentence", #wordsBody, 0),
             parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires 1 <=Int isLen(CS)
     andBool isLen(CS) <=Int 100
endmodule

