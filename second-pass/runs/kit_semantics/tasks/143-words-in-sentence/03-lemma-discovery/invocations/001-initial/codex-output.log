print('INVENTORY_SHA256=' + out['inventory_sha256'])
for name in ['DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA']:
    print(f'{name}={counts[name]}')
