diff --git a/evidence/proc_self_exe_shim.c b/evidence/proc_self_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..769c147d95669d98208d836c7b38725cbd1a0419
--- /dev/null
+++ b/evidence/proc_self_exe_shim.c
@@ -0,0 +1,37 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+        if (real_readlink == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+
+    ssize_t result = real_readlink(path, buffer, size);
+    if (result >= 0 || errno != ENOENT || path == NULL) {
+        return result;
+    }
+
+    char expected[64];
+    int length = snprintf(expected, sizeof(expected), "/proc/%ld/exe",
+                          (long)getpid());
+    if (length <= 0 || (size_t)length >= sizeof(expected) ||
+        strcmp(path, expected) != 0) {
+        return result;
+    }
+
+    return real_readlink("/proc/self/exe", buffer, size);
+}

