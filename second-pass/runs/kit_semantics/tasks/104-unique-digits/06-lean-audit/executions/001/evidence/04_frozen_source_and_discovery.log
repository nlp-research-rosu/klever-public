SOLUTION.PY
     1	def unique_digits(x):
     2	    result = []
     3	    value = 0
     4	    number = 0
     5	    bad = 0
     6	    for value in x:
     7	        number = sum((value,))
     8	        bad = 0
     9	        while number > 0:
    10	            bad += number % 2 == 0
    11	            number //= 10
    12	        if bad == 0:
    13	            result.append(value)
    14	    return sorted(result)

