    19	module VERIFICATION
    20	  imports VERIFICATION-SYNTAX
    21	  imports MPY
    22	
    23	  // The theorem covers all integer lists; the HumanEval positive-integer
    24	  // domain is a subset.
    25	  rule integerVals(.ValSeq) => true
    26	  rule integerVals(vCons(V:Val, VS:ValSeq))
    27	    => isInt(V) andBool integerVals(VS)
    28	
    29	  // Exact final bad-counter value of the decimal digit loop.
    30	  rule scanBad(B:Int, N:Int) => B
    31	    requires N <=Int 0
    32	  rule scanBad(B:Int, N:Int)
    33	    => scanBad(
    34	         B +Int (#if pyMod(N, 2) ==Int 0 #then 1 #else 0 #fi),
    35	         (N -Int pyMod(N, 10)) /Int 10)
    36	    requires N >Int 0
    37	
    38	  rule scanNumber(N:Int)
    39	    => #if N >Int 0 #then 0 #else N #fi
    40	
    41	  rule appendCandidate(VS:ValSeq, V:Val)
    42	    => valSeqConcat(VS, vCons(V, .ValSeq))
    43	    requires isInt(V)
    44	     andBool scanBad(0, intOf(V)) ==Int 0
    45	  rule appendCandidate(VS:ValSeq, V:Val) => VS
    46	    requires isInt(V)
    47	     andBool scanBad(0, intOf(V)) =/=Int 0
    48	
    49	  // Exact accumulator fold for the outer loop over the admitted input domain.
    50	  rule collect(ACC:ValSeq, .ValSeq) => ACC
    51	  rule collect(ACC:ValSeq, vCons(V:Val, VS:ValSeq))
    52	    => collect(appendCandidate(ACC, V), VS)
    53	    requires isInt(V)
    54	
    55	  // Python for-loop targets and body locals persist after the loop.
    56	  rule afterValue(.ValSeq, V:Val) => V
    57	  rule afterValue(vCons(V:Val, VS:ValSeq), _:Val)
    58	    => afterValue(VS, V)
    59	
    60	  rule afterNumber(.ValSeq, N:Int) => N
    61	  rule afterNumber(vCons(V:Val, VS:ValSeq), _:Int)
    62	    => afterNumber(VS, scanNumber(intOf(V)))
    63	    requires isInt(V)
    64	
    65	  rule afterBad(.ValSeq, B:Int) => B
    66	  rule afterBad(vCons(V:Val, VS:ValSeq), _:Int)
    67	    => afterBad(VS, scanBad(0, intOf(V)))
    68	    requires isInt(V)
    69	endmodule

