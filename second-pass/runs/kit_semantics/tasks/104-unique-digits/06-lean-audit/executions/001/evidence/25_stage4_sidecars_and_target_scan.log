      "module": "VERIFICATION",
      "normalized_sha256": "deac1092831d0f56a57b5d50d5bb50905bd4181b70079af78ff6c94b96c9b9ed",
      "rationale": "Guarded recurrence defining scanBad for a positive integer by updating the counter and recurring on the decimal quotient.",
      "source_rule_id": "rule-deac1092831d0f56a57b5d50d5bb50905bd4181b70079af78ff6c94b96c9b9ed",
      "start_line": 32,
      "text": "  rule scanBad(B:Int, N:Int)\n    => scanBad(\n         B +Int (#if pyMod(N, 2) ==Int 0 #then 1 #else 0 #fi),\n         (N -Int pyMod(N, 10)) /Int 10)\n    requires N >Int 0"
    },
    {
      "attributes": [],
