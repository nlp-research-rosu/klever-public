+  -e 'While(' \
+  -e '#while(' \
+  -e '#whileCond' \
+  -e 'TupleExpr' \
+  -e 'toTuple' \
+  -e '#bindTgt(Name' \
+  -e 'BinOp(' \
+  -e 'Compare(' \
+  -e 'applyBin("%"' \
+  -e 'applyBin("+"' \
+  -e 'applyBin("//"' \
+  -e 'applyCmp("=="' \
+  -e 'applyCmp(">"' \
+  -e 'FuncDef(' \
+  -e '#applyK(toCall(closureVal' \
+  -e '#bindP' \
+  -e 'Return(' \
+  -e '#pop' \
+  -e 'Call(' \
+  -e '#callee' \
+  -e 'builtinV("sum"' \
+  -e '#sumAcc' \
+  -e 'intOf' \
+  -e 'Attribute(' \
+  -e 'boundMethodV(ref(H:Int), "append"' \
+  -e 'valSeqConcat' \
