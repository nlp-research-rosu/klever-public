+    199,
+    200,
+    201,
+    999,
+    1000,
+    1001,
+    9999,
+    10_000,
+    10_001,
+]
+for left in boundary_values:
+    for right in boundary_values:
+        cases.append((f"boundary-pair-{left}-{right}", [left, right], None))
+
+rng = random.Random(104_2026_07_29)
+for index in range(2_000):
+    length = rng.randrange(0, 25)
