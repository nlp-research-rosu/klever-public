@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
+  return "$status"
+}
+
+run python3 /audit-output/evidence/provenance_check.py
+run cmp /candidate/prompt.py /reference/prompt.py
+run cmp /candidate/py2mpy.py /reference/py2mpy.py
+run diff --no-dereference --recursive /candidate/reference-semantics /reference/reference-semantics
+
+printf '$ find /candidate /reference /generation-evidence -xdev -type l -print\n'
+find /candidate /reference /generation-evidence -xdev -type l -print
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status"
+test "$status" -eq 0
+
+for mounted in \
+  /candidate \
+  /generation-evidence \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /audit-input.json \
+  /audit-campaign-lock.json \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /reference/reference-semantics
+do
+  run findmnt -T "$mounted" -n -o TARGET,OPTIONS
+done
diff --git a/evidence/record_command.sh b/evidence/record_command.sh
new file mode 100644
index 0000000000000000000000000000000000000000..19574ccb80dc6c9a607c04affdbe22f064a6940b
--- /dev/null
+++ b/evidence/record_command.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+# Execute one command, preserving its exact argv, cwd, combined output, and status.
+set -uo pipefail
+
+if [[ "$#" -lt 3 ]]; then
+  echo "usage: record_command.sh LOG WORKDIR COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+command_workdir=$2
+shift 2
+
+{
+  printf 'WORKDIR: %q\n' "$command_workdir"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  (
+    cd "$command_workdir" || exit 125
+    "$@"
+  )
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+exit "${PIPESTATUS[0]}"
diff --git a/evidence/solution-func-term.mpy b/evidence/solution-func-term.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..538407baed67cc89da55673b4b4086ddc8694957
--- /dev/null
+++ b/evidence/solution-func-term.mpy
@@ -0,0 +1,22 @@
+FuncDef("unique_digits", Params("x"),
+  Assign(Name("result"), ListExpr())
+  Assign(Name("value"), Int(0))
+  Assign(Name("number"), Int(0))
+  Assign(Name("bad"), Int(0))
+  For(Name("value"), Name("x"),
+    Assign(
+      Name("number"),
+      Call(Name("sum"), TupleExpr(Name("value"))))
+    Assign(Name("bad"), Int(0))
+    While(Compare(Name("number"), CmpOp(">", Int(0))),
+      AugAssign(
+        Name("bad"),
+        "+",
+        Compare(
+          BinOp("%", Name("number"), Int(2)),
+          CmpOp("==", Int(0))))
+      AugAssign(Name("number"), "//", Int(10)))
+    If(Compare(Name("bad"), CmpOp("==", Int(0))),
+      Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
+      ))
+  Return(Call(Name("sorted"), Name("result"))))
diff --git a/evidence/spec-func-term.mpy b/evidence/spec-func-term.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..5de266de7909250d03a55b9b65363cf3b56d8ae6
--- /dev/null
+++ b/evidence/spec-func-term.mpy
@@ -0,0 +1,35 @@
+FuncDef(
+  "unique_digits", Params("x"),
+  Assign(Name("result"), ListExpr(.Exprs))
+  Assign(Name("value"), Int(0))
+  Assign(Name("number"), Int(0))
+  Assign(Name("bad"), Int(0))
+  For(
+    Name("value"), Name("x"),
+    Assign(
+      Name("number"),
+      Call(
+        Name("sum"),
+        (TupleExpr((Name("value"), .Exprs)), .Exprs)))
+    Assign(Name("bad"), Int(0))
+    While(
+      Compare(Name("number"), CmpOp(">", Int(0))),
+      AugAssign(
+        Name("bad"),
+        "+",
+        Compare(
+          BinOp("%", Name("number"), Int(2)),
+          CmpOp("==", Int(0))))
+      AugAssign(Name("number"), "//", Int(10))
+      .Stmts)
+    If(
+      Compare(Name("bad"), CmpOp("==", Int(0))),
+      Expr(
+        Call(
+          Attribute(Name("result"), "append"),
+          (Name("value"), .Exprs)))
+      .Stmts,
+      .Stmts)
+    .Stmts)
+  Return(Call(Name("sorted"), (Name("result"), .Exprs)))
+  .Stmts)
