+  printf '\n'
+  (
+    cd "$command_workdir" || exit 125
+    "$@"
+  )
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+exit "${PIPESTATUS[0]}"
