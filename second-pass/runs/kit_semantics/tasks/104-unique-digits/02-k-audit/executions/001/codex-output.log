+  -e 'AugAssign(' \
+  -e '#branch' \
+  -e 'For(' \
+  -e '#loop(' \
+  -e '#iterNext(list' \
+  -e '#iterYield' \
+  -e 'While(' \
+  -e '#while(' \
+  -e '#whileCond' \
+  -e 'TupleExpr' \
+  -e 'toTuple' \
+  -e '#bindTgt(Name' \
+  -e 'BinOp(' \
+  -e 'Compare(' \
+  -e 'applyBin("%"' \
+  -e 'applyBin("+"' \
+  -e 'applyBin("//"' \
+  -e 'applyCmp("=="' \
+  -e 'applyCmp(">"' \
+  -e 'FuncDef(' \
+  -e '#applyK(toCall(closureVal' \
+  -e '#bindP' \
