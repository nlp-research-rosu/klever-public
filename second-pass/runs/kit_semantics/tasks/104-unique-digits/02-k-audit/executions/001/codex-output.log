+  -e '#iterYield' \
+  -e 'While(' \
+  -e '#while(' \
+  -e '#whileCond' \
+  -e 'TupleExpr' \
+  -e 'toTuple' \
+  -e '#bindTgt(Name' \
+  -e 'BinOp(' \
+  -e 'Compare(' \
+  -e 'applyBin("%"' \
+  -e 'applyBin("+"' \
+  -e 'applyBin("//"' \
+  -e 'applyCmp("=="' \
