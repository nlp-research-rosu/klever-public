+      AugAssign(
+        Name("bad"),
+        "+",
+        Compare(
+          BinOp("%", Name("number"), Int(2)),
+          CmpOp("==", Int(0))))
+      AugAssign(Name("number"), "//", Int(10)))
+    If(Compare(Name("bad"), CmpOp("==", Int(0))),
+      Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
+      ))
+  Return(Call(Name("sorted"), Name("result"))))
diff --git a/evidence/spec-func-term.mpy b/evidence/spec-func-term.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..5de266de7909250d03a55b9b65363cf3b56d8ae6
--- /dev/null
+++ b/evidence/spec-func-term.mpy
@@ -0,0 +1,35 @@
+FuncDef(
+  "unique_digits", Params("x"),
+  Assign(Name("result"), ListExpr(.Exprs))
+  Assign(Name("value"), Int(0))
+  Assign(Name("number"), Int(0))
+  Assign(Name("bad"), Int(0))
+  For(
+    Name("value"), Name("x"),
+    Assign(
+      Name("number"),
+      Call(
+        Name("sum"),
+        (TupleExpr((Name("value"), .Exprs)), .Exprs)))
+    Assign(Name("bad"), Int(0))
+    While(
+      Compare(Name("number"), CmpOp(">", Int(0))),
+      AugAssign(
+        Name("bad"),
+        "+",
+        Compare(
+          BinOp("%", Name("number"), Int(2)),
+          CmpOp("==", Int(0))))
+      AugAssign(Name("number"), "//", Int(10))
+      .Stmts)
+    If(
+      Compare(Name("bad"), CmpOp("==", Int(0))),
+      Expr(
+        Call(
+          Attribute(Name("result"), "append"),
+          (Name("value"), .Exprs)))
+      .Stmts,
+      .Stmts)
+    .Stmts)
+  Return(Call(Name("sorted"), (Name("result"), .Exprs)))
+  .Stmts)
