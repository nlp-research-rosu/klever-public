cp /candidate/solution.py /candidate/solution.mpy /candidate/verification.k /candidate/spec.k /tmp/audit-work/candidate-src/
cp /reference/canonical.py /reference/prompt.py /reference/py2mpy.py /tmp/audit-work/trusted/
