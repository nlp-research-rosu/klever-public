+FuncDef("unique_digits", Params("x"),
+  Assign(Name("result"), ListExpr())
+  Assign(Name("value"), Int(0))
+  Assign(Name("number"), Int(0))
+  Assign(Name("bad"), Int(0))
+  For(Name("value"), Name("x"),
+    Assign(
+      Name("number"),
+      Call(Name("sum"), TupleExpr(Name("value"))))
+    Assign(Name("bad"), Int(0))
+    While(Compare(Name("number"), CmpOp(">", Int(0))),
+      AugAssign(
+        Name("bad"),
+        "+",
+        Compare(
+          BinOp("%", Name("number"), Int(2)),
+          CmpOp("==", Int(0))))
+      AugAssign(Name("number"), "//", Int(10)))
+    If(Compare(Name("bad"), CmpOp("==", Int(0))),
+      Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
+      ))
+  Return(Call(Name("sorted"), Name("result"))))
diff --git a/evidence/spec-func-term.mpy b/evidence/spec-func-term.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..5de266de7909250d03a55b9b65363cf3b56d8ae6
--- /dev/null
+++ b/evidence/spec-func-term.mpy
@@ -0,0 +1,35 @@
+FuncDef(
+  "unique_digits", Params("x"),
+  Assign(Name("result"), ListExpr(.Exprs))
+  Assign(Name("value"), Int(0))
+  Assign(Name("number"), Int(0))
+  Assign(Name("bad"), Int(0))
+  For(
+    Name("value"), Name("x"),
+    Assign(
+      Name("number"),
+      Call(
+        Name("sum"),
+        (TupleExpr((Name("value"), .Exprs)), .Exprs)))
+    Assign(Name("bad"), Int(0))
+    While(
+      Compare(Name("number"), CmpOp(">", Int(0))),
+      AugAssign(
+        Name("bad"),
+        "+",
+        Compare(
+          BinOp("%", Name("number"), Int(2)),
+          CmpOp("==", Int(0))))
+      AugAssign(Name("number"), "//", Int(10))
+      .Stmts)
+    If(
+      Compare(Name("bad"), CmpOp("==", Int(0))),
+      Expr(
+        Call(
+          Attribute(Name("result"), "append"),
+          (Name("value"), .Exprs)))
+      .Stmts,
+      .Stmts)
+    .Stmts)
+  Return(Call(Name("sorted"), (Name("result"), .Exprs)))
+  .Stmts)
diff --git a/evidence/stage2_fidelity.sh b/evidence/stage2_fidelity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..90b8b95ecbab32e343f06abb5280c536404dd00d
--- /dev/null
+++ b/evidence/stage2_fidelity.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
+  return "$status"
+}
+
+printf '$ python3 /tmp/audit-work/trusted/py2mpy.py /tmp/audit-work/candidate-src/solution.py | cmp - /tmp/audit-work/candidate-src/solution.mpy\n'
+python3 /tmp/audit-work/trusted/py2mpy.py \
+  /tmp/audit-work/candidate-src/solution.py \
+  | cmp - /tmp/audit-work/candidate-src/solution.mpy
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status"
+test "$status" -eq 0
+
+run sha256sum \
+  /tmp/audit-work/candidate-src/solution.py \
+  /tmp/audit-work/candidate-src/solution.mpy \
+  /candidate/solution.py \
+  /candidate/solution.mpy
+
+run python3 /audit-output/evidence/differential_test.py
