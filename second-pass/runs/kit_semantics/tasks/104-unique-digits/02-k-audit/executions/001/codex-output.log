+  -e '#loop(' \
+  -e '#iterNext(list' \
+  -e '#iterYield' \
+  -e 'While(' \
+  -e '#while(' \
+  -e '#whileCond' \
+  -e 'TupleExpr' \
+  -e 'toTuple' \
+  -e '#bindTgt(Name' \
+  -e 'BinOp(' \
+  -e 'Compare(' \
+  -e 'applyBin("%"' \
+  -e 'applyBin("+"' \
+  -e 'applyBin("//"' \
+  -e 'applyCmp("=="' \
+  -e 'applyCmp(">"' \
+  -e 'FuncDef(' \
+  -e '#applyK(toCall(closureVal' \
+  -e '#bindP' \
+  -e 'Return(' \
+  -e '#pop' \
+  -e 'Call(' \
+  -e '#callee' \
+  -e 'builtinV("sum"' \
+  -e '#sumAcc' \
+  -e 'intOf' \
+  -e 'Attribute(' \
+  -e 'boundMethodV(ref(H:Int), "append"' \
+  -e 'valSeqConcat' \
+  -e 'builtinV("sorted"' \
+  -e 'sortVS' \
+  -e 'insVS' \
+  "$semantics/core.k" \
+  "$semantics/controls.k" \
+  "$semantics/operators.k" \
+  "$semantics/int.k" \
+  "$semantics/list.k" \
+  "$semantics/tuple.k" \
+  "$semantics/call.k" \
+  "$semantics/functions.k" \
+  "$semantics/builtins.k" \
+  "$semantics/sort.k"
+
+printf '\nCANDIDATE-LOCAL OPERATIONAL BRIDGES\n'
