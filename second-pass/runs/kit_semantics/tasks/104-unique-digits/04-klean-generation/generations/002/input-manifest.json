{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "fb45f6c21602bcf45c317e9243ab74c0e4d150dfe3405c24eac94cb927907858",
      "rationale": "Base equation defining the integerVals predicate on the empty ValSeq; it names the input-domain test and does not model an execution step.",
      "source_rule_id": "rule-fb45f6c21602bcf45c317e9243ab74c0e4d150dfe3405c24eac94cb927907858",
      "start_line": 25,
      "text": "  rule integerVals(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "0fdf311e95699768f6653655fbcb75f1495794a6f4af7637ef16c68028a6dec8",
      "rationale": "Constructor-recursive equation defining integerVals on a nonempty ValSeq from isInt of the head and integerVals of the tail.",
      "source_rule_id": "rule-0fdf311e95699768f6653655fbcb75f1495794a6f4af7637ef16c68028a6dec8",
      "start_line": 26,
      "text": "  rule integerVals(vCons(V:Val, VS:ValSeq))\n    => isInt(V) andBool integerVals(VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "198caddd4e44844a4182afdc12cbe8b847068f235ba70560ca4acbb72b403a9c",
      "rationale": "Guarded base equation defining scanBad to return its accumulator when the scanned integer is nonpositive.",
      "source_rule_id": "rule-198caddd4e44844a4182afdc12cbe8b847068f235ba70560ca4acbb72b403a9c",
      "start_line": 30,
      "text": "  rule scanBad(B:Int, N:Int) => B\n    requires N <=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "VERIFICATION",
      "normalized_sha256": "deac1092831d0f56a57b5d50d5bb50905bd4181b70079af78ff6c94b96c9b9ed",
      "rationale": "Guarded recurrence defining scanBad for a positive integer by updating the counter and recurring on the decimal quotient.",
      "source_rule_id": "rule-deac1092831d0f56a57b5d50d5bb50905bd4181b70079af78ff6c94b96c9b9ed",
      "start_line": 32,
      "text": "  rule scanBad(B:Int, N:Int)\n    => scanBad(\n         B +Int (#if pyMod(N, 2) ==Int 0 #then 1 #else 0 #fi),\n         (N -Int pyMod(N, 10)) /Int 10)\n    requires N >Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "0c8212d872266a65f9628509b5e1ac121627dcc197e58d169331630d950d6ea4",
      "rationale": "Unconditional equation defining the named scanNumber summary with a conditional expression.",
      "source_rule_id": "rule-0c8212d872266a65f9628509b5e1ac121627dcc197e58d169331630d950d6ea4",
      "start_line": 38,
      "text": "  rule scanNumber(N:Int)\n    => #if N >Int 0 #then 0 #else N #fi"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "d0916ab1075ee30abc9bb69f741540c1aba4289fd887a7bf3041fd19926825f4",
      "rationale": "Guarded equation defining appendCandidate's append branch for an integer whose scanBad summary is zero.",
      "source_rule_id": "rule-d0916ab1075ee30abc9bb69f741540c1aba4289fd887a7bf3041fd19926825f4",
      "start_line": 41,
      "text": "  rule appendCandidate(VS:ValSeq, V:Val)\n    => valSeqConcat(VS, vCons(V, .ValSeq))\n    requires isInt(V)\n     andBool scanBad(0, intOf(V)) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION",
      "normalized_sha256": "9e5adb33c787aab59ead767c0c33455c05defb2160117d4c0940e26577caf9a6",
      "rationale": "Complementary guarded equation defining appendCandidate's unchanged-accumulator branch for a nonzero scanBad summary.",
      "source_rule_id": "rule-9e5adb33c787aab59ead767c0c33455c05defb2160117d4c0940e26577caf9a6",
      "start_line": 45,
      "text": "  rule appendCandidate(VS:ValSeq, V:Val) => VS\n    requires isInt(V)\n     andBool scanBad(0, intOf(V)) =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "VERIFICATION",
      "normalized_sha256": "282ed41406ab13eb82b75217914e68692e6094a01c85eeb1866659cbe295ca65",
      "rationale": "Base equation defining the collect fold over an empty ValSeq.",
      "source_rule_id": "rule-282ed41406ab13eb82b75217914e68692e6094a01c85eeb1866659cbe295ca65",
      "start_line": 50,
      "text": "  rule collect(ACC:ValSeq, .ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 53,
      "module": "VERIFICATION",
      "normalized_sha256": "68f7dc46d6f6ba285ff86612d5bf5920c4bb5b391b302eec660c347e42802807",
      "rationale": "Constructor-recursive equation defining collect by applying appendCandidate to the head and folding over the tail.",
      "source_rule_id": "rule-68f7dc46d6f6ba285ff86612d5bf5920c4bb5b391b302eec660c347e42802807",
      "start_line": 51,
      "text": "  rule collect(ACC:ValSeq, vCons(V:Val, VS:ValSeq))\n    => collect(appendCandidate(ACC, V), VS)\n    requires isInt(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "e86655f5dac9607527040fcf3e3137fe2eb24adeced3f6ce55069aa63d8b3976",
      "rationale": "Base equation defining afterValue on an empty remaining sequence.",
      "source_rule_id": "rule-e86655f5dac9607527040fcf3e3137fe2eb24adeced3f6ce55069aa63d8b3976",
      "start_line": 56,
      "text": "  rule afterValue(.ValSeq, V:Val) => V"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "20b0fef7038d8a2ae37d334bd943372f2de264539aa1fa5c7adfe7f6332d1325",
      "rationale": "Constructor-recursive equation defining afterValue by carrying the current head while consuming the remaining sequence.",
      "source_rule_id": "rule-20b0fef7038d8a2ae37d334bd943372f2de264539aa1fa5c7adfe7f6332d1325",
      "start_line": 57,
      "text": "  rule afterValue(vCons(V:Val, VS:ValSeq), _:Val)\n    => afterValue(VS, V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 60,
      "module": "VERIFICATION",
      "normalized_sha256": "7dbd72f534f8827fae1ca749560e74c0b2851f710376eaaf6b43468df83bf7dd",
      "rationale": "Base equation defining afterNumber on an empty remaining sequence.",
      "source_rule_id": "rule-7dbd72f534f8827fae1ca749560e74c0b2851f710376eaaf6b43468df83bf7dd",
      "start_line": 60,
      "text": "  rule afterNumber(.ValSeq, N:Int) => N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 63,
      "module": "VERIFICATION",
      "normalized_sha256": "2cdae319e0d7f6b8ee7164bab66368ec7935956f067feb5fa8959dff5b035d0b",
      "rationale": "Constructor-recursive equation defining afterNumber from scanNumber of each integer head.",
      "source_rule_id": "rule-2cdae319e0d7f6b8ee7164bab66368ec7935956f067feb5fa8959dff5b035d0b",
      "start_line": 61,
      "text": "  rule afterNumber(vCons(V:Val, VS:ValSeq), _:Int)\n    => afterNumber(VS, scanNumber(intOf(V)))\n    requires isInt(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 65,
      "module": "VERIFICATION",
      "normalized_sha256": "3b5df8b88e16b28463ee3c71c8e6ccbb3f47c567782514a03d885de4a71144d9",
      "rationale": "Base equation defining afterBad on an empty remaining sequence.",
      "source_rule_id": "rule-3b5df8b88e16b28463ee3c71c8e6ccbb3f47c567782514a03d885de4a71144d9",
      "start_line": 65,
      "text": "  rule afterBad(.ValSeq, B:Int) => B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 68,
      "module": "VERIFICATION",
      "normalized_sha256": "1dc1bf365d06a0db8dd6cb05935a8779e9b0e53ff37f93aba8d009b0cf224660",
      "rationale": "Constructor-recursive equation defining afterBad from scanBad of each integer head.",
      "source_rule_id": "rule-1dc1bf365d06a0db8dd6cb05935a8779e9b0e53ff37f93aba8d009b0cf224660",
      "start_line": 66,
      "text": "  rule afterBad(vCons(V:Val, VS:ValSeq), _:Int)\n    => afterBad(VS, scanBad(0, intOf(V)))\n    requires isInt(V)"
    }
  ],
