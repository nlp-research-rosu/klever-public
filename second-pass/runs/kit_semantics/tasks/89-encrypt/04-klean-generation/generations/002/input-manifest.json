{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "VERIFICATION",
      "normalized_sha256": "a2cf8a164cbf94a5a3d7e444fbdaf3102628d2d0fecf228f37fd79d4dece6873",
      "rationale": "This equation defines the named rot4Code mathematical summary as the same modular integer expression used for an in-alphabet source character; it does not rewrite an operational configuration or assert a separate fact.",
      "source_rule_id": "rule-a2cf8a164cbf94a5a3d7e444fbdaf3102628d2d0fecf228f37fd79d4dece6873",
      "start_line": 8,
      "text": "  rule rot4Code(C)\n    => pyMod(C -Int 97 +Int 4, 26) +Int 97"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 14,
      "module": "VERIFICATION",
      "normalized_sha256": "d0417986ed3df602be0bfac4ca4cca3508a931dd5e1f044c0f0c1403dda203c7",
      "rationale": "This is the below-alphabet guarded case of the total encryptedChar definition, defining the one-character summary to preserve codes less than 97.",
      "source_rule_id": "rule-d0417986ed3df602be0bfac4ca4cca3508a931dd5e1f044c0f0c1403dda203c7",
      "start_line": 13,
      "text": "  rule encryptedChar(C) => iCons(C, .IntSeq)\n    requires C <Int 97"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "235635117bf711de90184aa7ad59620fe6b55936d3bbd90d5bb3b6a779d23518",
      "rationale": "This is the lowercase-alphabet guarded case of the total encryptedChar definition, defining its one-character summary through rot4Code.",
      "source_rule_id": "rule-235635117bf711de90184aa7ad59620fe6b55936d3bbd90d5bb3b6a779d23518",
      "start_line": 15,
      "text": "  rule encryptedChar(C) => iCons(rot4Code(C), .IntSeq)\n    requires 97 <=Int C andBool C <=Int 122"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "7fd0c0a9b39e8cb02242fc4650209b4e029307a059efc848cc10aeb01bec0b3e",
      "rationale": "This is the above-alphabet guarded case of the total encryptedChar definition, defining the one-character summary to preserve codes greater than 122.",
      "source_rule_id": "rule-7fd0c0a9b39e8cb02242fc4650209b4e029307a059efc848cc10aeb01bec0b3e",
      "start_line": 17,
      "text": "  rule encryptedChar(C) => iCons(C, .IntSeq)\n    requires C >Int 122"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "5a9a473afba1abcdb4a753006cdb3325c9531614b72a97d3ae145928cb54c00e",
      "rationale": "This equation is the empty-sequence base case of the structurally recursive encryptFold mathematical summary.",
      "source_rule_id": "rule-5a9a473afba1abcdb4a753006cdb3325c9531614b72a97d3ae145928cb54c00e",
      "start_line": 22,
      "text": "  rule encryptFold(A, .IntSeq) => A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "6d8f5b2a6f2c94349997e8605406de5e3a62f684322db20582a216c99de16051",
      "rationale": "This equation is the constructor recurrence for encryptFold, defining the summary by appending encryptedChar(C) and recurring on the structurally smaller tail R.",
      "source_rule_id": "rule-6d8f5b2a6f2c94349997e8605406de5e3a62f684322db20582a216c99de16051",
      "start_line": 23,
      "text": "  rule encryptFold(A, iCons(C, R))\n    => encryptFold(\n         seqConcat(A, encryptedChar(C)),\n         R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "85d0bc26ae10c2b14fd916a400f96b49f796f68ed4a275143ca218d6795865b0",
      "rationale": "This equation defines encryptResult as the encryptFold summary initialized with the empty accumulator.",
      "source_rule_id": "rule-85d0bc26ae10c2b14fd916a400f96b49f796f68ed4a275143ca218d6795865b0",
      "start_line": 29,
      "text": "  rule encryptResult(S) => encryptFold(.IntSeq, S)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "VERIFICATION",
      "normalized_sha256": "5e6f27b3aa1140b7b8710b50f99a56ad029c2c48b9706918c0973fff130113a2",
      "rationale": "This equation is the empty-sequence base case of finalLoopChar, defining the summarized final loop-target value to remain the supplied initial value.",
      "source_rule_id": "rule-5e6f27b3aa1140b7b8710b50f99a56ad029c2c48b9706918c0973fff130113a2",
      "start_line": 33,
      "text": "  rule finalLoopChar(.IntSeq, V) => V"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "f55a8da87fb92ce9e96ebbc4ea82ce71e9cee705e034c1c7003d546479f625c2",
      "rationale": "This equation is the constructor recurrence for finalLoopChar, defining the loop-target summary by carrying the current one-character string into the structurally smaller tail.",
      "source_rule_id": "rule-f55a8da87fb92ce9e96ebbc4ea82ce71e9cee705e034c1c7003d546479f625c2",
      "start_line": 34,
      "text": "  rule finalLoopChar(iCons(C, R), _V)\n    => finalLoopChar(R, str(iCons(C, .IntSeq)))"
    }
  ],
