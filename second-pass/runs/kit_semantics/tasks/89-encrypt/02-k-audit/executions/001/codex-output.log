index 0000000000000000000000000000000000000000..b43c302f88baaa050de41b83e5b7d8f2398abed7
--- /dev/null
+++ b/evidence/audit-spec-body-sensitivity.k
@@ -0,0 +1,63 @@
+requires "../../tmp/audit-work/reconstruction/verification.k"
+
+module AUDIT-SPEC-BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // Independent body mutation. The executed body is ROT5, so "w" becomes
+  // "b" (code 98), while the unchanged ROT4 obligation demands "a" (97).
+  claim [rot5-body-rejected]:
+    <k>
+      Call(Name("encrypt"), str(iCons(119, .IntSeq)))
+      =>
+      str(iCons(97, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "encrypt" |->
+          closureVal(
+            "s",
+            Expr(
+              Str("Rotate lowercase letters four places and preserve other characters."))
+            Assign(Name("out"), Str(""))
+            Assign(Name("c"), Str(""))
+            For(
+              Name("c"),
+              Name("s"),
+              If(
+                BoolOp(
+                  "and",
+                  Compare(
+                    Call(Name("ord"), Name("c")),
+                    CmpOp(">=", Int(97))),
+                  Compare(
+                    Call(Name("ord"), Name("c")),
+                    CmpOp("<=", Int(122)))),
+                AugAssign(
+                  Name("out"),
+                  "+",
+                  Call(
+                    Name("chr"),
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "%",
+                        BinOp(
+                          "+",
+                          BinOp("-", Call(Name("ord"), Name("c")), Int(97)),
+                          Int(5)),
+                        Int(26)),
+                      Int(97)))),
+                AugAssign(Name("out"), "+", Name("c"))))
+            Return(Name("out")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
