+  printf '\n'
+  "$@" 2>&1
+  command_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"

