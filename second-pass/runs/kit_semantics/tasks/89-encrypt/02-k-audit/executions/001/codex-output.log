+      =>
+      str(iCons(97, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "encrypt" |->
+          closureVal(
+            "s",
+            Expr(
+              Str("Rotate lowercase letters four places and preserve other characters."))
+            Assign(Name("out"), Str(""))
+            Assign(Name("c"), Str(""))
+            For(
+              Name("c"),
