+                    BinOp(
+                      "+",
+                      BinOp(
+                        "%",
+                        BinOp(
+                          "+",
+                          BinOp("-", Call(Name("ord"), Name("c")), Int(97)),
+                          Int(5)),
+                        Int(26)),
+                      Int(97)))),
+                AugAssign(Name("out"), "+", Name("c"))))
+            Return(Name("out")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
