/bin/bash -lc 'chmod +x /audit-output/evidence/check_toolchain.sh /audit-output/evidence/make_concrete_program.py /audit-output/evidence/build_and_run_concrete.sh /audit-output/evidence/build_proof.sh; /audit-output/evidence/run_logged.sh /audit-output/evidence/03-toolchain.log /audit-output/evidence/check_toolchain.sh' in /audit-output
