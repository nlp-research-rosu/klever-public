+                  Compare(
+                    Call(Name("ord"), Name("c")),
+                    CmpOp(">=", Int(97))),
+                  Compare(
+                    Call(Name("ord"), Name("c")),
+                    CmpOp("<=", Int(122)))),
+                AugAssign(
+                  Name("out"),
