     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The code emitted for one source character by solution.py.
     7	  syntax Int ::= rot4Code(Int) [function, total]
     8	  rule rot4Code(C)
     9	    => pyMod(C -Int 97 +Int 4, 26) +Int 97
    10	
    11	  // A source character outside the lowercase alphabet passes through.
    12	  syntax IntSeq ::= encryptedChar(Int) [function, total]
    13	  rule encryptedChar(C) => iCons(C, .IntSeq)
    14	    requires C <Int 97
    15	  rule encryptedChar(C) => iCons(rot4Code(C), .IntSeq)
    16	    requires 97 <=Int C andBool C <=Int 122
    17	  rule encryptedChar(C) => iCons(C, .IntSeq)
    18	    requires C >Int 122
    19	
    20	  // Tail-recursive left fold matching the program's `out += ...` updates.
    21	  syntax IntSeq ::= encryptFold(IntSeq, IntSeq) [function, total]
    22	  rule encryptFold(A, .IntSeq) => A
    23	  rule encryptFold(A, iCons(C, R))
    24	    => encryptFold(
    25	         seqConcat(A, encryptedChar(C)),
    26	         R)
    27	
    28	  syntax IntSeq ::= encryptResult(IntSeq) [function, total]
    29	  rule encryptResult(S) => encryptFold(.IntSeq, S)
    30	
    31	  // Python leaves the for-target bound to its last value, if there is one.
    32	  syntax Val ::= finalLoopChar(IntSeq, Val) [function, total]
    33	  rule finalLoopChar(.IntSeq, V) => V
    34	  rule finalLoopChar(iCons(C, R), _V)
    35	    => finalLoopChar(R, str(iCons(C, .IntSeq)))
    36	endmodule
