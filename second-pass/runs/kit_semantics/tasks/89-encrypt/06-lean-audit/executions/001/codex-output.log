@@ -0,0 +1,72 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *program_invocation_short_name;
+
+static const char *tool_path(void) {
+    static char path[PATH_MAX];
+    const char *name = program_invocation_short_name;
+    if (name == NULL || name[0] == '\0') {
+        name = "lean";
+    }
+    snprintf(path, sizeof(path),
+             "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/%s", name);
+    return path;
+}
+
+static int is_proc_self_exe(const char *path) {
+    int pid = -1;
+    char extra = '\0';
+    return path != NULL &&
+           (strcmp(path, "/proc/self/exe") == 0 ||
+            (sscanf(path, "/proc/%d/exe%c", &pid, &extra) == 1 &&
+             pid == (int)getpid()));
+}
+
+ssize_t readlink(const char *restrict path, char *restrict buffer, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+    if (is_proc_self_exe(path)) {
+        const char *replacement = tool_path();
+        size_t length = strlen(replacement);
+        if (length > size) {
+            length = size;
+        }
+        memcpy(buffer, replacement, length);
+        return (ssize_t)length;
+    }
+    if (real_readlink == NULL) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    if (real_readlink == NULL) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return real_readlink(path, buffer, size);
+}
+
+ssize_t readlinkat(int dirfd, const char *restrict path,
+                   char *restrict buffer, size_t size) {
+    static ssize_t (*real_readlinkat)(int, const char *, char *, size_t) = NULL;
+    if (is_proc_self_exe(path)) {
+        const char *replacement = tool_path();
+        size_t length = strlen(replacement);
+        if (length > size) {
+            length = size;
+        }
+        memcpy(buffer, replacement, length);
+        return (ssize_t)length;
+    }
+    if (real_readlinkat == NULL) {
+        real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+    }
+    if (real_readlinkat == NULL) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return real_readlinkat(dirfd, path, buffer, size);
+}
