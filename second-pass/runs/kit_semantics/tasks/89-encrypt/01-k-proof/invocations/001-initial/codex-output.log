diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ff5a41ff45e9f73d8996a9725d267e555ad884fc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The code emitted for one source character by solution.py.
+  syntax Int ::= rot4Code(Int) [function, total]
+  rule rot4Code(C)
+    => pyMod(C -Int 97 +Int 4, 26) +Int 97
+
+  // A source character outside the lowercase alphabet passes through.
+  syntax IntSeq ::= encryptedChar(Int) [function, total]
+  rule encryptedChar(C) => iCons(C, .IntSeq)
+    requires C <Int 97
+  rule encryptedChar(C) => iCons(rot4Code(C), .IntSeq)
+    requires 97 <=Int C andBool C <=Int 122
+  rule encryptedChar(C) => iCons(C, .IntSeq)
+    requires C >Int 122
+
+  // Tail-recursive left fold matching the program's `out += ...` updates.
+  syntax IntSeq ::= encryptFold(IntSeq, IntSeq) [function, total]
+  rule encryptFold(A, .IntSeq) => A
+  rule encryptFold(A, iCons(C, R))
+    => encryptFold(
+         seqConcat(A, encryptedChar(C)),
+         R)
+
+  syntax IntSeq ::= encryptResult(IntSeq) [function, total]
+  rule encryptResult(S) => encryptFold(.IntSeq, S)
+
+  // Python leaves the for-target bound to its last value, if there is one.
+  syntax Val ::= finalLoopChar(IntSeq, Val) [function, total]
+  rule finalLoopChar(.IntSeq, V) => V
+  rule finalLoopChar(iCons(C, R), V)
+    => finalLoopChar(R, str(iCons(C, .IntSeq)))
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..7760d47134bbf07942f65053ff3164fb1657cd0f
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,19 @@
+def encrypt(s):
+    """Rotate lowercase letters four places and preserve other characters."""
+    out = ""
+    c = ""
+    for c in s:
+        if ord(c) >= 97 and ord(c) <= 122:
+            out += chr((ord(c) - 97 + 4) % 26 + 97)
+        else:
+            out += c
+    return out
+
+
+assert encrypt("hi") == "lm"
+assert encrypt("asdfghjkl") == "ewhjklnop"
+assert encrypt("gf") == "kj"
+assert encrypt("et") == "ix"
+assert encrypt("") == ""
+assert encrypt("xyz") == "bcd"
+assert encrypt("a z!") == "e d!"
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..409337e0609c9b24a7e0d58d63c8f36796f76799
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,42 @@
+import random
+import string
+
+from solution import encrypt
+
+
+SOURCE = string.ascii_lowercase
+TARGET = SOURCE[4:] + SOURCE[:4]
+TABLE = str.maketrans(SOURCE, TARGET)
+
+
+def oracle(value):
+    return value.translate(TABLE)
+
+
+rng = random.Random(0)
+cases = [""]
+cases.extend(chr(code) for code in range(128))
+cases.extend(
+    [
+        "abcdefghijklmnopqrstuvwxyz",
+        "xyz",
+        "a z!",
+        "Hello, World!",
+        "éclair λ",
+    ]
+)
+alphabet = string.ascii_letters + string.digits + string.punctuation + " "
+cases.extend(
+    "".join(rng.choice(alphabet) for _ in range(rng.randrange(65)))
+    for _ in range(1000)
+)
+
+mismatches = [
+    (value, encrypt(value), oracle(value))
+    for value in cases
+    if encrypt(value) != oracle(value)
+]
+
+print(f"cases={len(cases)} mismatches={len(mismatches)}")
+if mismatches:
+    raise AssertionError(mismatches[:5])
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b8539494bcb5ae8049d47a65fdb5dabfdcc56fd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def encrypt(s):
+    """Rotate lowercase letters four places and preserve other characters."""
+    out = ""
+    c = ""
+    for c in s:
+        if ord(c) >= 97 and ord(c) <= 122:
+            out += chr((ord(c) - 97 + 4) % 26 + 97)
+        else:
+            out += c
+    return out
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..105be4ec4f40b95825f7077993e479d679f3ae7e
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,65 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Expected to fail: changing the shift from four to five maps "a" to "f",
+  // while the ROT4 postcondition still requires "e".
+  claim [rot5-does-not-prove-rot4]:
+    <k>
+      Call(
+        Name("encrypt"),
+        str(iCons(97, .IntSeq)))
+      =>
+      str(iCons(101, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "encrypt" |->
+          closureVal(
+            "s",
+            Expr(
+              Str("Rotate lowercase letters four places and preserve other characters."))
+            Assign(Name("out"), Str(""))
+            Assign(Name("c"), Str(""))
+            For(
+              Name("c"),
+              Name("s"),
+              If(
+                BoolOp(
+                  "and",
+                  Compare(
+                    Call(Name("ord"), Name("c")),
+                    CmpOp(">=", Int(97))),
+                  Compare(
+                    Call(Name("ord"), Name("c")),
+                    CmpOp("<=", Int(122)))),
+                AugAssign(
+                  Name("out"),
+                  "+",
+                  Call(
+                    Name("chr"),
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "%",
+                        BinOp(
+                          "+",
+                          BinOp("-", Call(Name("ord"), Name("c")), Int(97)),
+                          Int(5)),
+                        Int(26)),
+                      Int(97)))),
+                AugAssign(Name("out"), "+", Name("c"))))
+            Return(Name("out")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
