+      -1 |-> builtinsScope
+      1 |-> scope(
+        ("s"   |-> str(_INPUT:IntSeq))
+        ("out" |-> (str(A:IntSeq) => str(encryptFold(A, S))))
+        ("c"   |-> (C0:Val => finalLoopChar(S, C0))),
+        parent(0))
+    </scopes>
+
+  claim [encrypt-entry]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "encrypt",
+          Params("s"),
+          Expr(
+            Str("Rotate lowercase letters four places and preserve other characters."))
+          Assign(Name("out"), Str(""))
+          Assign(Name("c"), Str(""))
