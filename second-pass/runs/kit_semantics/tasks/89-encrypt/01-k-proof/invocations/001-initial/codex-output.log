+
+  claim [encrypt-loop]:
+    <k>
+      #loop(
+        str(S:IntSeq),
+        Name("c"),
+        If(
+          BoolOp(
+            "and",
+            Compare(
+              Call(Name("ord"), Name("c")),
+              CmpOp(">=", Int(97))),
+            Compare(
+              Call(Name("ord"), Name("c")),
+              CmpOp("<=", Int(122)))),
+          AugAssign(
+            Name("out"),
+            "+",
+            Call(
+              Name("chr"),
+              BinOp(
+                "+",
+                BinOp(
+                  "%",
+                  BinOp(
+                    "+",
+                    BinOp("-", Call(Name("ord"), Name("c")), Int(97)),
+                    Int(4)),
+                  Int(26)),
+                Int(97)))),
+          AugAssign(Name("out"), "+", Name("c"))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope("encrypt" |-> ENC:Val, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        ("s"   |-> str(INPUT:IntSeq))
+        ("out" |-> (str(A:IntSeq) => str(encryptFold(A, S))))
+        ("c"   |-> (C0:Val => finalLoopChar(S, C0))),
+        parent(0))
+    </scopes>
+
+  claim [encrypt-entry]:
