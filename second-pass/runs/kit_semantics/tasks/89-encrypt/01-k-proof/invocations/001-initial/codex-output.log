diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..7760d47134bbf07942f65053ff3164fb1657cd0f
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,19 @@
+def encrypt(s):
+    """Rotate lowercase letters four places and preserve other characters."""
+    out = ""
+    c = ""
+    for c in s:
+        if ord(c) >= 97 and ord(c) <= 122:
+            out += chr((ord(c) - 97 + 4) % 26 + 97)
+        else:
+            out += c
+    return out
+
+
+assert encrypt("hi") == "lm"
+assert encrypt("asdfghjkl") == "ewhjklnop"
+assert encrypt("gf") == "kj"
+assert encrypt("et") == "ix"
+assert encrypt("") == ""
+assert encrypt("xyz") == "bcd"
+assert encrypt("a z!") == "e d!"
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..409337e0609c9b24a7e0d58d63c8f36796f76799
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,42 @@
+import random
+import string
+
+from solution import encrypt
+
+
+SOURCE = string.ascii_lowercase
+TARGET = SOURCE[4:] + SOURCE[:4]
+TABLE = str.maketrans(SOURCE, TARGET)
+
+
+def oracle(value):
+    return value.translate(TABLE)
+
+
+rng = random.Random(0)
+cases = [""]
+cases.extend(chr(code) for code in range(128))
+cases.extend(
+    [
+        "abcdefghijklmnopqrstuvwxyz",
+        "xyz",
+        "a z!",
+        "Hello, World!",
+        "éclair λ",
+    ]
+)
+alphabet = string.ascii_letters + string.digits + string.punctuation + " "
+cases.extend(
+    "".join(rng.choice(alphabet) for _ in range(rng.randrange(65)))
+    for _ in range(1000)
+)
+
+mismatches = [
+    (value, encrypt(value), oracle(value))
+    for value in cases
+    if encrypt(value) != oracle(value)
+]
+
+print(f"cases={len(cases)} mismatches={len(mismatches)}")
+if mismatches:
+    raise AssertionError(mismatches[:5])
