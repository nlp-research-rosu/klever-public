Module(
  FuncDef("encrypt", Params("s"),
    Expr(
      Str(
        "Rotate lowercase letters four places and preserve other characters."))
    Assign(Name("out"), Str(""))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("s"),
      If(BoolOp(
        "and",
        Compare(Call(Name("ord"), Name("c")), CmpOp(">=", Int(97))),
        Compare(Call(Name("ord"), Name("c")), CmpOp("<=", Int(122)))),
        AugAssign(
          Name("out"),
          "+",
          Call(
            Name("chr"),
            BinOp(
              "+",
              BinOp(
                "%",
                BinOp(
                  "+",
                  BinOp("-", Call(Name("ord"), Name("c")), Int(97)),
                  Int(4)),
                Int(26)),
              Int(97)))),
        AugAssign(Name("out"), "+", Name("c"))))
    Return(Name("out")))
  Assert(
    Compare(Call(Name("encrypt"), Str("hi")), CmpOp("==", Str("lm"))))
  Assert(
    Compare(
      Call(Name("encrypt"), Str("asdfghjkl")),
      CmpOp("==", Str("ewhjklnop"))))
  Assert(
    Compare(Call(Name("encrypt"), Str("gf")), CmpOp("==", Str("kj"))))
  Assert(
    Compare(Call(Name("encrypt"), Str("et")), CmpOp("==", Str("ix"))))
  Assert(Compare(Call(Name("encrypt"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(Call(Name("encrypt"), Str("xyz")), CmpOp("==", Str("bcd"))))
  Assert(
    Compare(
      Call(Name("encrypt"), Str("a z!")),
      CmpOp("==", Str("e d!")))))
