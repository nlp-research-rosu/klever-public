Module(
  FuncDef("encrypt", Params("s"),
    Expr(
      Str(
        "Rotate lowercase letters four places and preserve other characters."))
    Assign(Name("out"), Str(""))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("s"),
      If(BoolOp(
        "and",
        Compare(Call(Name("ord"), Name("c")), CmpOp(">=", Int(97))),
        Compare(Call(Name("ord"), Name("c")), CmpOp("<=", Int(122)))),
        AugAssign(
          Name("out"),
          "+",
          Call(
            Name("chr"),
            BinOp(
              "+",
              BinOp(
                "%",
                BinOp(
                  "+",
                  BinOp("-", Call(Name("ord"), Name("c")), Int(97)),
                  Int(4)),
                Int(26)),
              Int(97)))),
        AugAssign(Name("out"), "+", Name("c"))))
    Return(Name("out"))))
