/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
canonical = json.loads(Path('/reference/rule-inventory.json').read_text(encoding='utf-8'))
out = json.loads(Path('/workspace/trust-boundary.json').read_text(encoding='utf-8'))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == canonical['inventory_sha256']
expected_ids = [r['source_rule_id'] for r in canonical['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids)) == len(expected_ids)
for index, rule in enumerate(out['rules']):
    assert list(rule) == ['source_rule_id', 'classification', 'rationale'], (index, list(rule))
    assert rule['classification'] in allowed
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()
for canonical_rule, classified in zip(canonical['rules'], out['rules']):
    if 'simplification' in canonical_rule.get('attributes', []):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print(f\"schema_version={out['schema_version']}\")
print(f\"inventory_sha256={out['inventory_sha256']}\")
print(f\"rules={len(actual_ids)} unique={len(set(actual_ids))} order_match={actual_ids == expected_ids}\")
from collections import Counter
print('classifications=' + json.dumps(Counter(r['classification'] for r in out['rules']), sort_keys=True))
print(f\"simplification_rules={sum('simplification' in r.get('attributes', []) for r in canonical['rules'])}\")
