+      str(strToCodes("No"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "file_name_check" |->
+          closureVal(
+            ("file_name", .ParamNames),
+            fileNameCheckBody,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
