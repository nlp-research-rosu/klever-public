+    if file_name[0] not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ":
+        return "No"
+    if not (
+        file_name[-4:] == ".txt"
+        or file_name[-4:] == ".exe"
+        or file_name[-4:] == ".dll"
+    ):
+        return "No"
+    if (
+        file_name.count("0")
+        + file_name.count("1")
+        + file_name.count("2")
+        + file_name.count("3")
+        + file_name.count("4")
+        + file_name.count("5")
+        + file_name.count("6")
+        + file_name.count("7")
+        + file_name.count("8")
+        + file_name.count("9")
+        > 3
+    ):
+        return "No"
+    return "Yes"
+
