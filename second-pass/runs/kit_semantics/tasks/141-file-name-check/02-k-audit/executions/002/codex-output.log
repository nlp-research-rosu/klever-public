def _rule_documents(text: str, module: _Module) -> list[dict[str, Any]]:
    return [
        dataclasses.asdict(span.rule)
        for span in _rule_spans(text, module)
    ]


def _attribute_token_spans(
    text: str,
    masked_text: str,
) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            spans.append(
                (
                    start,
                    index,
                    _without_comments(text[start:index]).strip(),
                )
            )
            start = index + 1
    spans.append(
        (
            start,
            len(text),
            _without_comments(text[start:]).strip(),
        )
    )
    return spans


def _blank_non_newlines(text: str) -> str:
    return "".join(
        character if character in "\r\n" else " "
        for character in text
    )


def desimplify_rule_ids(
    text: str,
    source_rule_ids: list[str],
) -> str:
    """Remove simplification from exactly the selected canonical rule IDs."""

    if len(source_rule_ids) != len(set(source_rule_ids)):
        raise KRuleInventoryError(
            "exact rule transformation contains a duplicate source rule ID"
        )
    selected = set(source_rule_ids)
    module = _verification_module(_mask_non_code(text))
    spans = _rule_spans(text, module)
    by_id = {span.rule.source_rule_id: span for span in spans}
    unknown = sorted(selected - set(by_id))
    if unknown:
        raise KRuleInventoryError(
            "exact rule transformation names an unknown source rule ID: "
            + ", ".join(unknown)
        )

    edits: list[tuple[int, int]] = []
    for source_rule_id in source_rule_ids:
        span = by_id[source_rule_id]
        attribute_text = text[
            span.attribute_start + 1 : span.attribute_end - 1
        ]
        masked_attributes = _mask_non_code(attribute_text)
        tokens = _attribute_token_spans(
            attribute_text,
            masked_attributes,
        )
        matches = [
            index
            for index, (_start, _end, token) in enumerate(tokens)
            if token == "simplification"
        ]
        if len(matches) != 1:
            raise KRuleInventoryError(
                "selected source rule has ambiguous simplification "
                f"attributes: {source_rule_id}"
            )
        token_index = matches[0]
        if len(tokens) == 1:
            edit_start = span.attribute_start
            edit_end = span.attribute_end
        elif token_index < len(tokens) - 1:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index][0]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index + 1][0]
            )
        else:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index - 1][1]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index][1]
            )
        edits.append((edit_start, edit_end))

    transformed = text
    for start, end in sorted(edits, reverse=True):
        transformed = (
            transformed[:start]
            + _blank_non_newlines(transformed[start:end])
            + transformed[end:]
        )
    return transformed


def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    module = _verification_module(masked_text)
    rule_documents = _rule_documents(text, module)
    return {
        "schema_version": 1,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }

diff --git a/evidence/claim_witnesses.py b/evidence/claim_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..66ae7920f47126111dbd21b78c3a110799850e3f
--- /dev/null
+++ b/evidence/claim_witnesses.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Ground witnesses for every SPEC entry precondition and result."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+SCRATCH = Path("/tmp/audit-work/proof")
+ASCII_LATIN = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+
+def load_function(module_name: str, path: Path):
+    module_spec = importlib.util.spec_from_file_location(module_name, path)
+    if module_spec is None or module_spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(module_spec)
+    module_spec.loader.exec_module(module)
+    return module.file_name_check
+
+
+canonical = load_function("canonical_witness", SCRATCH / "canonical.py")
+generated = load_function("generated_witness", SCRATCH / "solution.py")
+
+
+def dot_count(name: str) -> int:
+    return name.count(".")
+
+
+def first_is_ascii_latin(name: str) -> bool:
+    return bool(name) and name[0] in ASCII_LATIN
+
+
+def extension_is(name: str, extension: str) -> bool:
+    return name[-4:] == extension
+
+
+def allowed_extension(name: str) -> bool:
+    return any(extension_is(name, ext) for ext in (".txt", ".exe", ".dll"))
+
+
+def decimal_digit_count(name: str) -> int:
+    return sum(name.count(digit) for digit in "0123456789")
+
+
+claims = [
+    ("empty-name", "", "No", lambda name: name == ""),
+    (
+        "bad-dot-count",
+        "abc",
+        "No",
+        lambda name: bool(name) and dot_count(name) != 1,
+    ),
+    (
+        "bad-initial",
+        "1.txt",
+        "No",
+        lambda name: (
+            bool(name) and dot_count(name) == 1 and not first_is_ascii_latin(name)
+        ),
+    ),
+    (
+        "bad-extension",
+        "a.pdf",
+        "No",
+        lambda name: (
+            bool(name)
+            and dot_count(name) == 1
+            and first_is_ascii_latin(name)
+            and not allowed_extension(name)
+        ),
+    ),
+    (
+        "too-many-digits-txt",
+        "a1234.txt",
+        "No",
+        lambda name: (
+            dot_count(name) == 1
+            and first_is_ascii_latin(name)
+            and extension_is(name, ".txt")
+            and decimal_digit_count(name) > 3
+        ),
+    ),
+    (
+        "too-many-digits-exe",
+        "a1234.exe",
+        "No",
+        lambda name: (
+            dot_count(name) == 1
+            and first_is_ascii_latin(name)
+            and not extension_is(name, ".txt")
+            and extension_is(name, ".exe")
+            and decimal_digit_count(name) > 3
+        ),
+    ),
+    (
+        "too-many-digits-dll",
+        "a1234.dll",
+        "No",
+        lambda name: (
+            dot_count(name) == 1
+            and first_is_ascii_latin(name)
+            and not extension_is(name, ".txt")
+            and not extension_is(name, ".exe")
+            and extension_is(name, ".dll")
+            and decimal_digit_count(name) > 3
+        ),
+    ),
+    (
+        "valid-name-txt",
+        "a.txt",
+        "Yes",
+        lambda name: (
+            dot_count(name) == 1
+            and first_is_ascii_latin(name)
+            and extension_is(name, ".txt")
+            and decimal_digit_count(name) <= 3
+        ),
+    ),
+    (
+        "valid-name-exe",
+        "a.exe",
+        "Yes",
+        lambda name: (
+            dot_count(name) == 1
+            and first_is_ascii_latin(name)
+            and not extension_is(name, ".txt")
+            and extension_is(name, ".exe")
+            and decimal_digit_count(name) <= 3
+        ),
+    ),
+    (
+        "valid-name-dll",
+        "a.dll",
+        "Yes",
+        lambda name: (
+            dot_count(name) == 1
+            and first_is_ascii_latin(name)
+            and not extension_is(name, ".txt")
+            and not extension_is(name, ".exe")
+            and extension_is(name, ".dll")
+            and decimal_digit_count(name) <= 3
+        ),
+    ),
+]
+
+for label, witness, destination, precondition in claims:
+    satisfied = precondition(witness)
+    canonical_result = canonical(witness)
+    generated_result = generated(witness)
+    print(
+        f"{label}: witness={witness!r} precondition={satisfied} "
+        f"destination={destination} canonical={canonical_result} "
+        f"generated={generated_result}"
+    )
+    assert satisfied
+    assert canonical_result == destination
+    assert generated_result == destination
diff --git a/evidence/concrete_checks.py b/evidence/concrete_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..f98f0893c22b04ac4b01c65f4fdc58856159b369
--- /dev/null
+++ b/evidence/concrete_checks.py
@@ -0,0 +1,40 @@
+def file_name_check(file_name):
+    if file_name.count(".") != 1:
+        return "No"
+    if file_name[0] not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ":
+        return "No"
+    if not (
+        file_name[-4:] == ".txt"
+        or file_name[-4:] == ".exe"
+        or file_name[-4:] == ".dll"
+    ):
+        return "No"
+    if (
+        file_name.count("0")
+        + file_name.count("1")
+        + file_name.count("2")
+        + file_name.count("3")
+        + file_name.count("4")
+        + file_name.count("5")
+        + file_name.count("6")
+        + file_name.count("7")
+        + file_name.count("8")
+        + file_name.count("9")
+        > 3
+    ):
+        return "No"
+    return "Yes"
+
+
+assert file_name_check("example.txt") == "Yes"
+assert file_name_check("1example.dll") == "No"
+assert file_name_check("") == "No"
+assert file_name_check(".txt") == "No"
+assert file_name_check("a..txt") == "No"
+assert file_name_check("a.pdf") == "No"
+assert file_name_check("a123.txt") == "Yes"
+assert file_name_check("a1234.txt") == "No"
+assert file_name_check("a.exe") == "Yes"
+assert file_name_check("a.dll") == "Yes"
+assert file_name_check("é.txt") == "No"
+assert file_name_check("a１２３４.txt") == "Yes"
