{"category": "rule:ordinary", "end_line": 135, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:135", "keyword": "rule", "sha256": "3262fc150fee7baa45990dfdc328e957e1a23026303557c96c0c59a1344bf826", "start_line": 135, "text": "rule applyBin(\"-\",  F:Float, I:Int) => subF(F, intToF(I))"}
{"category": "rule:ordinary", "end_line": 136, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:136", "keyword": "rule", "sha256": "167f6a0aa189326fd991b987a4088d533a688cd459669bd5dcf6424bb9119817", "start_line": 136, "text": "rule applyBin(\"+\",  I:Int, F:Float) => addF(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 137, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:137", "keyword": "rule", "sha256": "4af2b331bab8377b7df2c68930d8be2d1338d5d8a59d169edb6a9f671c7f9131", "start_line": 137, "text": "rule applyBin(\"+\",  F:Float, I:Int) => addF(F, intToF(I))"}
{"category": "rule:ordinary", "end_line": 138, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:138", "keyword": "rule", "sha256": "96e9b55afb287a214c2dcee990abecadafda681eb7e292e41a7571ce19813eb8", "start_line": 138, "text": "rule applyBin(\"*\",  I:Int, F:Float) => mulF(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 141, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:139", "keyword": "rule", "sha256": "fe6b6b5ea0a6d14a9236371e85d9d924d83b6c7eadca652c3df3c76574cc0816", "start_line": 139, "text": "rule applyBin(\"*\",  F:Float, I:Int) => mulF(F, intToF(I))\n\n  // ---- mixed Int == Float (shared eqF; opaque symbolic / concrete twin) ----"}
{"category": "syntax:function,total,symbol", "end_line": 142, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:142", "keyword": "syntax", "sha256": "4d0d2ce425b47cbd6bee2f255bcf3d96198d491b336ae2a39b526ef63bea2402", "start_line": 142, "text": "syntax Bool ::= eqF(Float, Float) [function, total, symbol(eqF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 143, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:143", "keyword": "rule", "sha256": "9653dcd55b20d0e03ba4d3cbe0f0bc8f742986e54a1d18bce5cea115e0effbb2", "start_line": 143, "text": "rule eqF(F1:Float, F2:Float) => F1 ==Float F2 [concrete]"}
{"category": "rule:ordinary", "end_line": 144, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:144", "keyword": "rule", "sha256": "ac77f892cfc0b69b735ac2dedee89bcc32c18ec0b6242435d33e360dc3bdfebc", "start_line": 144, "text": "rule applyCmp(\"==\", I:Int, F:Float) => eqF(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 145, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:145", "keyword": "rule", "sha256": "722beef5b388f74df4709c027e46917747d36d8c1d7c43bf20a191f26682e6a0", "start_line": 145, "text": "rule applyCmp(\"==\", F:Float, I:Int) => eqF(F, intToF(I))"}
