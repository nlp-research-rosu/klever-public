{"category": "rule:ordinary", "end_line": 79, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:78", "keyword": "rule", "sha256": "692729d259206da577961ce444546ad89a98c0f19aa8efbb325dd4a7da0c38bd", "start_line": 78, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAcc(R, {V}:>Int) ... </k>\n       requires isInt(V)"}
{"category": "rule:ordinary", "end_line": 80, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:80", "keyword": "rule", "sha256": "66b9fabf71fa1c3cb5935e7c758b7835d42c078229bef95a9d00258c2be25942", "start_line": 80, "text": "rule <k> #maxAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #maxCont(M) ... </k>"}
{"category": "rule:ordinary", "end_line": 81, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:81", "keyword": "rule", "sha256": "45675f8137ef759c03793ddbc5f29ba0c26e9b63dbb20548eff076acbe7f1e57", "start_line": 81, "text": "rule <k> #iterDone ~> #maxCont(M:Int) => M ... </k>"}
{"category": "rule:ordinary", "end_line": 85, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:82", "keyword": "rule", "sha256": "87e28ee6f8a2be67b8ac2b47463faa8bcd6ddd4f914c2395a4f94500b86ed90a", "start_line": 82, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)\n        => #maxAcc(R, maxInt(M, {V}:>Int)) ... </k>\n       requires isInt(V)"}
{"category": "syntax", "end_line": 86, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:86", "keyword": "syntax", "sha256": "612c7bdfd2d38320c9120a5ad0911e5880488eb2a92ab68e87ac7a0a9bdcc60d", "start_line": 86, "text": "syntax KItem ::= #minAcc0(Iterable) | \"#minCont0\" | #minAcc(Iterable, Int) | #minCont(Int)"}
{"category": "rule:ordinary", "end_line": 87, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:87", "keyword": "rule", "sha256": "eb6389d2a176f8e9c2eb65f49175e5c400253651be9a571add590da6ce3ba770", "start_line": 87, "text": "rule <k> #minAcc0(IT:Iterable) => #iterNext(IT) ~> #minCont0 ... </k>"}
{"category": "rule:ordinary", "end_line": 89, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:88", "keyword": "rule", "sha256": "1905dec42a2a4d4bdd46ce09839aaef16948a4298223134f6ba5f442f967a4ff", "start_line": 88, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAcc(R, {V}:>Int) ... </k>\n       requires isInt(V)"}
{"category": "rule:ordinary", "end_line": 90, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:90", "keyword": "rule", "sha256": "20c0d7b936a1ae717e1b498c544d3e56d529de8b54a671c87468ea52c0180f02", "start_line": 90, "text": "rule <k> #minAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #minCont(M) ... </k>"}
{"category": "rule:ordinary", "end_line": 91, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:91", "keyword": "rule", "sha256": "3f472924a83dcd925a34d32704d5cb43591b3115643998243b00b590ffd0789e", "start_line": 91, "text": "rule <k> #iterDone ~> #minCont(M:Int) => M ... </k>"}
{"category": "rule:ordinary", "end_line": 96, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:92", "keyword": "rule", "sha256": "b3c896b30c84e77ba55e851149bb7efe92722e1f73be43ef46b1c7a0352a9c67", "start_line": 92, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)\n        => #minAcc(R, minInt(M, {V}:>Int)) ... </k>\n       requires isInt(V)\n\n  // ==== variadic max / min (a Vals fold) ===================================="}
{"category": "syntax:function", "end_line": 97, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:97", "keyword": "syntax", "sha256": "4282c4747876bd11b0e0b06b2e4a8b6d9a709d9fb7d61a124e4e6e221a9cf49a", "start_line": 97, "text": "syntax Int ::= maxVals(Int, Vals) [function]"}
{"category": "rule:ordinary", "end_line": 98, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:98", "keyword": "rule", "sha256": "16f482b70cca4e393239fcfc21ef383ea47184220924e70160efcc4f10351c27", "start_line": 98, "text": "rule applyBuiltin(\"max\", I:Int, REST:Vals) => maxVals(I, REST)"}
{"category": "rule:ordinary", "end_line": 99, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:99", "keyword": "rule", "sha256": "fb21a7851f56f7d9ed3357c97a7904370b3d6ede28cf28b7d032ee8519c55d21", "start_line": 99, "text": "rule maxVals(M:Int, .Vals)           => M"}
{"category": "rule:ordinary", "end_line": 101, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:100", "keyword": "rule", "sha256": "f1bf63869c2f8c3b4f48e5d002007a959d31bd3f9c39589cedd372e8e8c2c1fd", "start_line": 100, "text": "rule maxVals(M:Int, (I:Int, R:Vals)) => maxVals(maxInt(M, I), R)"}
{"category": "syntax:function", "end_line": 102, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:102", "keyword": "syntax", "sha256": "8b1e9d6e3b83d5fbb06102823efcc1bd5eceebe50248a0519155605df3d8928e", "start_line": 102, "text": "syntax Int ::= minVals(Int, Vals) [function]"}
{"category": "rule:ordinary", "end_line": 103, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:103", "keyword": "rule", "sha256": "92b52ecacf4f7bcc94c1774bbf2f8c46491933333083bff18d1fba94099a53f7", "start_line": 103, "text": "rule applyBuiltin(\"min\", I:Int, REST:Vals) => minVals(I, REST)"}
{"category": "rule:ordinary", "end_line": 104, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:104", "keyword": "rule", "sha256": "4daf802c8ea1f71caaa5a73ccf57bd5032b7603812eeefe0498b96e1a0c92e34", "start_line": 104, "text": "rule minVals(M:Int, .Vals)           => M"}
{"category": "rule:ordinary", "end_line": 107, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:105", "keyword": "rule", "sha256": "c3b99a9b9cf37c7b30e97a132c1184be3fe79b6ffcd762a32dbe76e9e7a732ce", "start_line": 105, "text": "rule minVals(M:Int, (I:Int, R:Vals)) => minVals(minInt(M, I), R)\n\n  // ==== bin(n) — \"0b\" + binary digit codes (promoted from 103's defined fold) =="}
{"category": "rule:ordinary", "end_line": 110, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:108", "keyword": "rule", "sha256": "c62f22bf7149492bc25cb98ac8e0ae0ac2d757bc4c9be67924be698bf0deec7f", "start_line": 108, "text": "rule applyBuiltin(\"bin\", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))\n       requires N >=Int 0\n  // negative operand: the '-' sign prefixes the magnitude's digits"}
{"category": "rule:ordinary", "end_line": 113, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:111", "keyword": "rule", "sha256": "1979f4a341ad8321ef8d4441be86616249940221d3343d44985b51329bb549f6", "start_line": 111, "text": "rule applyBuiltin(\"bin\", N:Int, .Vals)\n    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))\n       requires N <Int 0"}
{"category": "syntax:function,total", "end_line": 114, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:114", "keyword": "syntax", "sha256": "c616aba4766ff2aaf0704be23847369aa1831eaf4276066d724101d505f66734", "start_line": 114, "text": "syntax IntSeq ::= binCodes(Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 115, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:115", "keyword": "rule", "sha256": "4e15dfee6cc651ddde7fae203da6c1cac63f9526f0a298a0e12298cece607136", "start_line": 115, "text": "rule binCodes(0) => iCons(48, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 116, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:116", "keyword": "rule", "sha256": "7e1227c3ef64530774984a9128b2c12c553bcb563b0a0b83bc5b6e1c346beaa4", "start_line": 116, "text": "rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0"}
{"category": "syntax:function,total", "end_line": 117, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:117", "keyword": "syntax", "sha256": "939453dbc7b8105a40a22f0da3eb1cc17b459109ddb7ba032b38664edc20227c", "start_line": 117, "text": "syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 118, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:118", "keyword": "rule", "sha256": "7503c649eb67d40e57fdd7614dcfa3de4a3e4715eee89ab6ca8ce6dea1dc7de8", "start_line": 118, "text": "rule binAcc(0, ACC:IntSeq) => ACC"}
{"category": "rule:ordinary", "end_line": 123, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:119", "keyword": "rule", "sha256": "bcfba1ec4bfef58ee753242afa66c5239e11f9aff499dbbdae03e7659469fe64", "start_line": 119, "text": "rule binAcc(N:Int, ACC:IntSeq)\n    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))\n       requires N >Int 0\n\n  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list ========="}
{"category": "rule:ordinary", "end_line": 125, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:124", "keyword": "rule", "sha256": "84309128fd265ab1732b88f5f947372859b1d835eba94fb7c8c0c07b852a6db0", "start_line": 124, "text": "rule <k> #applyK(toCall(builtinV(\"enumerate\")), (list(VS:ValSeq), .Vals))\n        => #alloc(list(enumVS(VS, 0))) ... </k>"}
{"category": "syntax:function,total", "end_line": 126, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:126", "keyword": "syntax", "sha256": "aeb5f1496dff1950ec1446b3259063e01a84eb972208b260c0d6f09ce9506bf5", "start_line": 126, "text": "syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 127, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:127", "keyword": "rule", "sha256": "4833a908272d7c487063f0cfa562afde5a3451844e05cf3fe38d54ed348f1bc0", "start_line": 127, "text": "rule enumVS(.ValSeq, _:Int) => .ValSeq"}
{"category": "rule:ordinary", "end_line": 131, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:128", "keyword": "rule", "sha256": "6b56f57fd6ffbb592173ec85906095abfcc277e79da3694e64c2739af79afcdf", "start_line": 128, "text": "rule enumVS(vCons(V:Val, R:ValSeq), I:Int)\n    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))\n\n  // ==== map(str, xs) — eager (only the str case is in the subset) ============="}
{"category": "rule:ordinary", "end_line": 133, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:132", "keyword": "rule", "sha256": "1ee11e41d66b965624ac59a98c37dcab9bb13688562be3de4b533e7ead914df4", "start_line": 132, "text": "rule <k> #applyK(toCall(builtinV(\"map\")), (typeV(\"str\"), list(VS:ValSeq), .Vals))\n        => #alloc(list(mapStrVS(VS))) ... </k>"}
{"category": "syntax:function,total", "end_line": 134, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:134", "keyword": "syntax", "sha256": "0513f86f41d97840aa4c9001828f9522be7fdfe0d34a81d66b1c7cb69dd19429", "start_line": 134, "text": "syntax ValSeq ::= mapStrVS(ValSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 135, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:135", "keyword": "rule", "sha256": "289c1f88138532f4849f1759636f258f7a27e847636d3570f4d47118be315292", "start_line": 135, "text": "rule mapStrVS(.ValSeq) => .ValSeq"}
{"category": "rule:ordinary", "end_line": 136, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:136", "keyword": "rule", "sha256": "74f471f298eebc641fbb40d2d7b15dd6178b5ded64b3cfb82bf8ed4d84d78288", "start_line": 136, "text": "rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))"}
{"category": "rule:ordinary", "end_line": 139, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:137", "keyword": "rule", "sha256": "55c68699cae0039402ab8bf270547dbf3c527d047845bccee0757b90c18859bd", "start_line": 137, "text": "rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))\n\n  // ==== int(x) identities (int(round(x)) composes through) ===================="}
{"category": "rule:ordinary", "end_line": 142, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:140", "keyword": "rule", "sha256": "02ffa1f36ccff62728940ae7f7d286a4d2e9d96baebc03183eb8a5f1d88fbea1", "start_line": 140, "text": "rule applyBuiltin(\"int\", I:Int, .Vals) => I\n\n  // ==== ord / chr ==========================================================="}
{"category": "rule:ordinary", "end_line": 143, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:143", "keyword": "rule", "sha256": "c4bb6edca9516337358f2cb7225d3ce0895ec4e19972031b438ad7517dc71f51", "start_line": 143, "text": "rule applyBuiltin(\"ord\", str(iCons(C:Int, .IntSeq)), .Vals) => C"}
{"category": "rule:ordinary", "end_line": 147, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:144", "keyword": "rule", "sha256": "0569bd5e23d22f878194192c86cd1127935433ba9ef715f2316a45f1a161b32f", "start_line": 144, "text": "rule applyBuiltin(\"chr\", I:Int, .Vals) => str(iCons(I, .IntSeq))\n       requires 0 <=Int I andBool I <Int 128\n\n  // ==== str(int) / str(str) ================================================="}
{"category": "rule:ordinary", "end_line": 148, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:148", "keyword": "rule", "sha256": "8e899362692d9ad0f61deb3419e5f8f6992150b924e853176c2b9e2bb77c628a", "start_line": 148, "text": "rule applyBuiltin(\"str\", I:Int, .Vals)       => str(strToCodes(Int2String(I)))"}
{"category": "rule:ordinary", "end_line": 151, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:149", "keyword": "rule", "sha256": "890718a6415358969ba6c413352361fa0339fd3f75324281662d7cb8a123f065", "start_line": 149, "text": "rule applyBuiltin(\"str\", str(CS:IntSeq), .Vals) => str(CS)\n\n  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value ====="}
{"category": "rule:ordinary", "end_line": 155, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:152", "keyword": "rule", "sha256": "c9d939087a89536b4f1db978fd50853202fde5e18dd8be8fd0666c248155b465", "start_line": 152, "text": "rule applyBuiltin(\"int\", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48\n       requires 48 <=Int C andBool C <=Int 57\n\n  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)"}
{"category": "rule:ordinary", "end_line": 157, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:156", "keyword": "rule", "sha256": "685720c87ab9647d5dfacaf835081acd02783eea94fe62d7f61dc2a58d8ecde4", "start_line": 156, "text": "rule applyBuiltin(\"int\", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)\n       requires isLen(CS) >=Int 2"}
{"category": "syntax:function,total", "end_line": 158, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:158", "keyword": "syntax", "sha256": "5400597dd0d27beb9fb8b90889ee5e284a9ef3f9ae1719cc1cdcf297cc5222df", "start_line": 158, "text": "syntax Int ::= intDigAcc(IntSeq, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 159, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:159", "keyword": "rule", "sha256": "0d7d7afcdff4458cceec72313655cf6281aede2ccdccaec6603bd3d2b868034c", "start_line": 159, "text": "rule intDigAcc(.IntSeq, ACC:Int)             => ACC"}
{"category": "rule:ordinary", "end_line": 162, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:160", "keyword": "rule", "sha256": "ff0cd2c2c99b2ee6c816de6f4cb9d9a2caaa85c84750c7a76e7386435a924572", "start_line": 160, "text": "rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))\n\n  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter ====="}
{"category": "rule:ordinary", "end_line": 163, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:163", "keyword": "rule", "sha256": "d3b8ae0c04fe1c9c52482cb2873d5b12f4fc0b6fc09c01fe1cf2ebea8995dfca", "start_line": 163, "text": "rule applyBuiltin(\"zip\", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)"}
{"category": "rule:ordinary", "end_line": 166, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:164", "keyword": "rule", "sha256": "ed3db7a4e3c7e3347adbc43176a7cf17cb0297f3ec965e77e4da4e7cb4f56d3d", "start_line": 164, "text": "rule applyBuiltin(\"zip\", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)\n\n  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)"}
{"category": "rule:ordinary", "end_line": 168, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:167", "keyword": "rule", "sha256": "ee54105504d32115caa7dbe979711b58d037f6f4edcc8c54a67c8b0fdbf67108", "start_line": 167, "text": "rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))\n        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>"}
{"category": "rule:ordinary", "end_line": 169, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:169", "keyword": "rule", "sha256": "db7593d35aaf34fb56e5bd6ef14cf491a6e3240d22d717b2c4ec9ee86860516f", "start_line": 169, "text": "rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>"}
{"category": "rule:ordinary", "end_line": 170, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:170", "keyword": "rule", "sha256": "84cabfd28956dc3a489c060c4e01deda2dd393855e02d4eae64649ac5a7a0885", "start_line": 170, "text": "rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>"}
{"category": "rule:ordinary", "end_line": 172, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:171", "keyword": "rule", "sha256": "3123ec683490f278ecf87e7685c01abd0f138d70ad484826bef881ffd1243eae", "start_line": 171, "text": "rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))\n        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>"}
{"category": "rule:ordinary", "end_line": 173, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:173", "keyword": "rule", "sha256": "221848fbddbab3621aaa1edd05406921f4cbd1365138984dd84655a7433bfbc2", "start_line": 173, "text": "rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>"}
{"category": "rule:ordinary", "end_line": 176, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:174", "keyword": "rule", "sha256": "0fefbdf111e341234ca7fc2ad81697c5ae77160a04645a2f8570db1822b995f4", "start_line": 174, "text": "rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>\n\n  // ==== range(stop) / range(start, stop) / range(start, stop, step) ========="}
{"category": "rule:ordinary", "end_line": 177, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:177", "keyword": "rule", "sha256": "4ff496b44fe127e32a9e38fa7e11e858bce666d4bfa2efde1dab60289b1288ef", "start_line": 177, "text": "rule applyBuiltin(\"range\", I:Int, .Vals)               => rangeObj(0, I, 1)"}
{"category": "rule:ordinary", "end_line": 178, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:178", "keyword": "rule", "sha256": "906c5a513bd4fd1d9e337a539e46c9a23224889f56558625440bfb54ccad18c1", "start_line": 178, "text": "rule applyBuiltin(\"range\", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)"}
{"category": "rule:ordinary", "end_line": 186, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:179", "keyword": "rule", "sha256": "021b151ab737bfb6ac99f0e93a37d6c81b69a9ea64672ce252cec365921cc449", "start_line": 179, "text": "rule applyBuiltin(\"range\", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)\n       requires S =/=Int 0\n\n  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========\n  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's\n  // trusted pass evaluator, now DEFINED in the reference and driven by a\n  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic\n  // argument leaves the call unevaluated for problem-level folds."}
{"category": "rule:ordinary", "end_line": 187, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:187", "keyword": "rule", "sha256": "3115789003f5fd3304efbfa147941564256ce839d48ae9c7ec4ab0817276c8a7", "start_line": 187, "text": "rule applyBuiltin(\"eval\", str(CS:IntSeq), .Vals) => evalArith(CS)"}
{"category": "syntax:function", "end_line": 188, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:188", "keyword": "syntax", "sha256": "ac5c7747453bcef9f306787c450027d49b33b7ccc8424f568c0a59340f7be95b", "start_line": 188, "text": "syntax Int ::= evalArith(IntSeq) [function]"}
{"category": "rule:ordinary", "end_line": 191, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:189", "keyword": "rule", "sha256": "51c0c83fdb40819d780c7b8c693a03dac0e5c98c0e3ea64f32b66243d60f0d3d", "start_line": 189, "text": "rule evalArith(CS:IntSeq)\n    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))"}
{"category": "syntax", "end_line": 193, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:192", "keyword": "syntax", "sha256": "82f289aff1572a4406a04b267222ab0133343ece15b934ac425fb05cc70ffb83", "start_line": 192, "text": "syntax OpSeq ::= \".OpSeq\" | oCons(String, OpSeq)"}
{"category": "syntax:function,total", "end_line": 194, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:194", "keyword": "syntax", "sha256": "b174a010e1cc48fc9c87f146d63c9f0b5fe2cc39edccb9bccec656443882ed7e", "start_line": 194, "text": "syntax Bool ::= evDigit(Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 195, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:195", "keyword": "rule", "sha256": "3e38e9b3918ab5f217a28ee11803a976860adc4a4a43d7e5f0a8dbe20d6f746d", "start_line": 195, "text": "rule evDigit(C:Int) => C >=Int 48 andBool C <=Int 57"}
{"category": "syntax:function,total", "end_line": 196, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:196", "keyword": "syntax", "sha256": "7322fabc33c94db411ece339632320083ba49717b78a26188e9cc33fd0ba692a", "start_line": 196, "text": "syntax Bool ::= evHead42(IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 197, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:197", "keyword": "rule", "sha256": "8943c2a4d63090268d6e9b4908ea537fadc1b77bb23ba953b72c8e042d469510", "start_line": 197, "text": "rule evHead42(iCons(42, _:IntSeq)) => true"}
{"category": "rule:owise", "end_line": 198, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:198", "keyword": "rule", "sha256": "91cad1617995640b868856509a5d21000d4029e3a7110e1888e921693a2b6c51", "start_line": 198, "text": "rule evHead42(_:IntSeq)            => false [owise]"}
{"category": "syntax:function,total", "end_line": 199, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:199", "keyword": "syntax", "sha256": "0c7954767f99543b9df8d794bd317db6dd33a660a59579479ada56d88fcac4e4", "start_line": 199, "text": "syntax Bool ::= evHead47(IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 200, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:200", "keyword": "rule", "sha256": "238e1f40d90ae25e3e018df6ad041e714bf374ab5bfa3a169df3a4b92a4fa8d7", "start_line": 200, "text": "rule evHead47(iCons(47, _:IntSeq)) => true"}
{"category": "rule:owise", "end_line": 202, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:201", "keyword": "rule", "sha256": "fb275676fb19fcf1e54142850cc9fa2c0669f5daa8f1339bd28107da034fa60d", "start_line": 201, "text": "rule evHead47(_:IntSeq)            => false [owise]"}
{"category": "syntax:function,total", "end_line": 203, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:203", "keyword": "syntax", "sha256": "d6d582239dd5c12601e35b409a04def1e7d471de1e96122e7a75d07a819d4c1c", "start_line": 203, "text": "syntax OpSeq ::= tokOps(IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 204, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:204", "keyword": "rule", "sha256": "e04fbacffc8906aa66fd92593efd41ff3daebbaed0e7aeade1b00f1345f9fb1e", "start_line": 204, "text": "rule tokOps(.IntSeq)                 => .OpSeq"}
{"category": "rule:ordinary", "end_line": 205, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:205", "keyword": "rule", "sha256": "9e10fd4dda1100f6dec3fe434375334e180e081e66f1b51317223e75c17aebb8", "start_line": 205, "text": "rule tokOps(iCons(32, R:IntSeq))     => tokOps(R)"}
{"category": "rule:ordinary", "end_line": 206, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:206", "keyword": "rule", "sha256": "584bf3fa5f5988f14630c932156bd40ed5119b7c9f536827ca59717775e32e07", "start_line": 206, "text": "rule tokOps(iCons(C:Int, R:IntSeq))  => tokOps(R) requires evDigit(C)"}
{"category": "rule:ordinary", "end_line": 207, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:207", "keyword": "rule", "sha256": "011c9edcd2e8becfa114c58f13dac94960765c17469779243288ff3af8abb706", "start_line": 207, "text": "rule tokOps(iCons(42, iCons(42, R:IntSeq))) => oCons(\"**\", tokOps(R))"}
{"category": "rule:ordinary", "end_line": 208, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:208", "keyword": "rule", "sha256": "d5628edd807e379a7f63b92bc05c9e67d94eaed0d9c4f0c514c9e2ac1368c539", "start_line": 208, "text": "rule tokOps(iCons(42, R:IntSeq))     => oCons(\"*\", tokOps(R)) requires notBool evHead42(R)"}
{"category": "rule:ordinary", "end_line": 209, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:209", "keyword": "rule", "sha256": "005eaf8a7dd6285a798e4e70b662f6a95ea2eabcc597d42dfe99af4f1b29d569", "start_line": 209, "text": "rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons(\"//\", tokOps(R))"}
{"category": "rule:ordinary", "end_line": 210, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:210", "keyword": "rule", "sha256": "8111317537ff599035e86c4d9a1973a03811df69dc6fd3abfc29ab5cddb3957d", "start_line": 210, "text": "rule tokOps(iCons(47, R:IntSeq))     => oCons(\"/\", tokOps(R)) requires notBool evHead47(R)"}
{"category": "rule:ordinary", "end_line": 211, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:211", "keyword": "rule", "sha256": "85d2d15517e25b2ef196f3f9b30cb04459470074d1256eac18078784bd8e3006", "start_line": 211, "text": "rule tokOps(iCons(43, R:IntSeq))     => oCons(\"+\", tokOps(R))"}
{"category": "rule:ordinary", "end_line": 213, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:212", "keyword": "rule", "sha256": "a6a3d20dada58ed1fcff3d95a93dd6582e6bb148575f5f8178e2216954591873", "start_line": 212, "text": "rule tokOps(iCons(45, R:IntSeq))     => oCons(\"-\", tokOps(R))"}
{"category": "syntax:function,total", "end_line": 215, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:214", "keyword": "syntax", "sha256": "d508522621a896ef266bf1edd61ca5a243bd87a6d688926fcff7bad12b614e93", "start_line": 214, "text": "syntax IntSeq ::= tokNds(IntSeq) [function, total]\n                  | tokNdAcc(Int, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 216, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:216", "keyword": "rule", "sha256": "8c6548026431321462b01a0cd28f2df59c24eb423cdd1db18b1e9d9ca79d479c", "start_line": 216, "text": "rule tokNds(.IntSeq)                => .IntSeq"}
{"category": "rule:ordinary", "end_line": 217, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:217", "keyword": "rule", "sha256": "a6ad609ffead44bb74a4b912e5a6526d3e6c283b135169d0c297610dd4f61c94", "start_line": 217, "text": "rule tokNds(iCons(32, R:IntSeq))    => tokNds(R)"}
{"category": "rule:ordinary", "end_line": 218, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:218", "keyword": "rule", "sha256": "2378510f6563de1061f2178b6a21c8a76a60c0e7f601ed9be70103eddf86cf55", "start_line": 218, "text": "rule tokNds(iCons(C:Int, R:IntSeq)) => tokNdAcc(C -Int 48, R) requires evDigit(C)"}
{"category": "rule:ordinary", "end_line": 220, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:219", "keyword": "rule", "sha256": "05eb9aff974152d5233d49efe4c36343cf564665d63dad84949d3de42c14f6c6", "start_line": 219, "text": "rule tokNds(iCons(C:Int, R:IntSeq)) => tokNds(R)\n       requires notBool evDigit(C) andBool C =/=Int 32"}
{"category": "rule:ordinary", "end_line": 222, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:221", "keyword": "rule", "sha256": "86cd82351ee8686f0d5a563605888528a96203b87d02eca7eb1617ed627802a0", "start_line": 221, "text": "rule tokNdAcc(A:Int, iCons(C:Int, R:IntSeq)) => tokNdAcc(A *Int 10 +Int (C -Int 48), R)\n       requires evDigit(C)"}
{"category": "rule:owise", "end_line": 224, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:223", "keyword": "rule", "sha256": "a5f697b9adb7c8b0ca4ee6f23007fde8a5d61e94f3066d3bc35c79caa8395ade", "start_line": 223, "text": "rule tokNdAcc(A:Int, S:IntSeq) => iCons(A, tokNds(S)) [owise]"}
{"category": "syntax", "end_line": 225, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:225", "keyword": "syntax", "sha256": "906d0c17f2fb826efe4efc82beb72a4d68f990ca14e99999640dfb946f7e6e6e", "start_line": 225, "text": "syntax EvPair ::= evp(OpSeq, IntSeq)"}
{"category": "syntax:function,total", "end_line": 226, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:226", "keyword": "syntax", "sha256": "cdf7f8b500cfb4398499c7e394562a0b14477808f647c6ee721f498aa1fb9416", "start_line": 226, "text": "syntax Int ::= firstNdE(EvPair) [function, total]"}
{"category": "rule:ordinary", "end_line": 227, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:227", "keyword": "rule", "sha256": "493a0efa8ace14cbd61f46bf3d0e7a35639532c12c55fe97b0345c3e214172e5", "start_line": 227, "text": "rule firstNdE(evp(_:OpSeq, iCons(N:Int, _:IntSeq))) => N"}
{"category": "rule:owise", "end_line": 229, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:228", "keyword": "rule", "sha256": "99460cf0fcab8942aa7842de35e012e3fdd575d398f6e967cca26cb5484b00d4", "start_line": 228, "text": "rule firstNdE(_:EvPair) => 0 [owise]"}
{"category": "syntax:function,total", "end_line": 230, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:230", "keyword": "syntax", "sha256": "f15a46d2a8840cf972edcb93b43af177e7e040743128ac33ac7d277186128d3e", "start_line": 230, "text": "syntax Int ::= applyOpE(String, Int, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 231, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:231", "keyword": "rule", "sha256": "e87c23f5d28b5005fd818cad9d9ca4208c601cde7805b9d12f063be473b84f7d", "start_line": 231, "text": "rule applyOpE(\"+\",  A:Int, B:Int) => A +Int B"}
{"category": "rule:ordinary", "end_line": 232, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:232", "keyword": "rule", "sha256": "d26a9d3a522a7efa6e379b03ad1a74a38f4c9555a6f9922d1df938b138331e3c", "start_line": 232, "text": "rule applyOpE(\"-\",  A:Int, B:Int) => A -Int B"}
{"category": "rule:ordinary", "end_line": 233, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:233", "keyword": "rule", "sha256": "d27c36510a59794759317adbeee9fda4f0a7fd8f4e7ac5daa6253aea19b573d4", "start_line": 233, "text": "rule applyOpE(\"*\",  A:Int, B:Int) => A *Int B"}
{"category": "rule:ordinary", "end_line": 234, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:234", "keyword": "rule", "sha256": "fe469f129f991e5bf72cb167734210674f0a824b896f3d490090150f7e8c8ff7", "start_line": 234, "text": "rule applyOpE(\"//\", A:Int, B:Int) => A divInt B"}
{"category": "rule:ordinary", "end_line": 235, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:235", "keyword": "rule", "sha256": "45890407b0492b0c493d87a536fe5c8c5b2638dec4e8ca3e6807a4de200feeba", "start_line": 235, "text": "rule applyOpE(\"**\", A:Int, B:Int) => A ^Int B"}
{"category": "rule:owise", "end_line": 237, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:236", "keyword": "rule", "sha256": "77542379cedbe6f215bafd871a01024c1a53e4aaddb0e5c13b5a86a9ea4f4d23", "start_line": 236, "text": "rule applyOpE(_:String, A:Int, _:Int) => A [owise]"}
{"category": "syntax:function,total", "end_line": 238, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:238", "keyword": "syntax", "sha256": "7039540535a2a934e1476e82610824ca18f40978dc212deea8d2425979e582b3", "start_line": 238, "text": "syntax EvPair ::= passPowE(OpSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 239, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:239", "keyword": "rule", "sha256": "337779ec32074914e6e27bc5f85de1641f10d2afc874b25642ccdc76406e7431", "start_line": 239, "text": "rule passPowE(.OpSeq, NDS:IntSeq) => evp(.OpSeq, NDS)"}
{"category": "rule:ordinary", "end_line": 240, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:240", "keyword": "rule", "sha256": "cfc7aaf386852d921b5c016af8b582faecaf7ed85c957e07e8a45a0a8d382eb4", "start_line": 240, "text": "rule passPowE(oCons(\"**\", OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCombE(N, passPowE(OPS, NDS))"}
{"category": "rule:ordinary", "end_line": 242, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:241", "keyword": "rule", "sha256": "2ba5f008db68f2c3d656fc79e966925a41c175a10e403ed5f05b2d3da1a253d0", "start_line": 241, "text": "rule passPowE(oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCarryE(O, N, passPowE(OPS, NDS))\n       requires O =/=String \"**\""}
{"category": "rule:owise", "end_line": 243, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:243", "keyword": "rule", "sha256": "25a4663fe177b1bb7951e46a96f911fa2cbb67bb09b33e61fd15260ab70bb461", "start_line": 243, "text": "rule passPowE(_:OpSeq, .IntSeq) => evp(.OpSeq, .IntSeq) [owise]"}
{"category": "syntax:function,total", "end_line": 244, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:244", "keyword": "syntax", "sha256": "6a975303e128a6b1b0e7d23b8e37d9f1ae2ad9e69d282f2fa22132f46c7e50ae", "start_line": 244, "text": "syntax EvPair ::= powCombE(Int, EvPair) [function, total]"}
{"category": "rule:ordinary", "end_line": 245, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:245", "keyword": "rule", "sha256": "b0fe3350706d64a2ed9d52bc609d637f07d7662af49a883fd8a47391ce0ee69b", "start_line": 245, "text": "rule powCombE(N:Int, evp(OPS:OpSeq, iCons(M:Int, REST:IntSeq))) => evp(OPS, iCons(N ^Int M, REST))"}
{"category": "rule:ordinary", "end_line": 246, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:246", "keyword": "rule", "sha256": "2474e1e106b7656c99a940038d99b9f219abc2e34fdc07fc22cc1333f730fd6e", "start_line": 246, "text": "rule powCombE(N:Int, evp(OPS:OpSeq, .IntSeq)) => evp(OPS, iCons(N, .IntSeq))"}
{"category": "syntax:function,total", "end_line": 247, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:247", "keyword": "syntax", "sha256": "ccb2ec4ebb2f9efa05e40d029742beb8cfb1dbdf2fff046fcc8a3189f9b95ab3", "start_line": 247, "text": "syntax EvPair ::= powCarryE(String, Int, EvPair) [function, total]"}
{"category": "rule:ordinary", "end_line": 249, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:248", "keyword": "rule", "sha256": "1b1d231b33e55aff0eed8c4c991c12970b36112c2714d56965864a761949ca78", "start_line": 248, "text": "rule powCarryE(O:String, N:Int, evp(OPS:OpSeq, NDS:IntSeq)) => evp(oCons(O, OPS), iCons(N, NDS))"}
{"category": "syntax:function,total", "end_line": 250, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:250", "keyword": "syntax", "sha256": "b236e49f85be5349a9675f896a77076f773e9504b7f97d14a6c867bb11b778eb", "start_line": 250, "text": "syntax EvPair ::= passMulE(EvPair) [function, total] | passAddE(EvPair) [function, total]"}
{"category": "rule:ordinary", "end_line": 251, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:251", "keyword": "rule", "sha256": "e5919eeb7c7e9743f9ab2b65f117ba635202f5d7d4f266e5f792fd9922c4a5e2", "start_line": 251, "text": "rule passMulE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE(\"mul\", N0, OPS, NDS, .OpSeq, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 252, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:252", "keyword": "rule", "sha256": "6b1d3c71e798a33a869fa96af0ff246045b0d50f1cbae9d6e0b730faf9318ba3", "start_line": 252, "text": "rule passMulE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 253, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:253", "keyword": "rule", "sha256": "c3f2a5ab71feddf57b9ec4f6ac41ce023d2c3d261b228d3a481ecf75b457f517", "start_line": 253, "text": "rule passAddE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE(\"add\", N0, OPS, NDS, .OpSeq, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 254, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:254", "keyword": "rule", "sha256": "8842e532de290ccc6229328d1ff7b4e0a8bb81f4b6833a6abe2359f186fcca76", "start_line": 254, "text": "rule passAddE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)"}
{"category": "syntax:function,total", "end_line": 255, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:255", "keyword": "syntax", "sha256": "3b8c247c3782a565e300e94a2fb42976e6b99be17f945b42d7f555f31696d32f", "start_line": 255, "text": "syntax EvPair ::= passLGoE(String, Int, OpSeq, IntSeq, OpSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 256, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:256", "keyword": "rule", "sha256": "1232a86fdb86335bf2e99f4e74879b87030f1e6babb381980e59583e8d66bbbd", "start_line": 256, "text": "rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))"}
{"category": "rule:ordinary", "end_line": 259, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:257", "keyword": "rule", "sha256": "b050e168b90f38f01f0f79eda40d91f7b11e14222b5be357c630b85a062211ae", "start_line": 257, "text": "rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)\n    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)\n       requires inLevelE(L, O)"}
{"category": "rule:ordinary", "end_line": 262, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:260", "keyword": "rule", "sha256": "453fc29790b10a6c68046f247ed015bead6065f732c02dfd65cf3bae6135c479", "start_line": 260, "text": "rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)\n    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))\n       requires notBool inLevelE(L, O)"}
{"category": "rule:owise", "end_line": 264, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:263", "keyword": "rule", "sha256": "bd2ed20b94e7306466c98dbf5a55ff3062d39a002d0a251eca99fe7f1846ee9b", "start_line": 263, "text": "rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)\n    => evp(OO, appendIE(ON, CUR)) [owise]"}
{"category": "syntax:function,total", "end_line": 265, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:265", "keyword": "syntax", "sha256": "241368398e21fbed55a3fe2220ff3fd74d5176a9b6d12d755f6576d4485dd3c9", "start_line": 265, "text": "syntax Bool ::= inLevelE(String, String) [function, total]"}
{"category": "rule:ordinary", "end_line": 266, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:266", "keyword": "rule", "sha256": "55734e1ee04564bb05f5a1222d96d045ca785db371f0dd1e412700b3137b2e2b", "start_line": 266, "text": "rule inLevelE(\"mul\", O:String) => O ==String \"*\" orBool O ==String \"//\" orBool O ==String \"/\""}
{"category": "rule:ordinary", "end_line": 267, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:267", "keyword": "rule", "sha256": "d4ca4934e9e1b81eff61ec775162bde071bd8f9fb90a53610d86e3fad50df9b9", "start_line": 267, "text": "rule inLevelE(\"add\", O:String) => O ==String \"+\" orBool O ==String \"-\""}
{"category": "rule:owise", "end_line": 268, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:268", "keyword": "rule", "sha256": "7c8e03ff739bc71b7303f7f870446e7a75c52ec1b6e9ebcb29253ca4d8ee4dd7", "start_line": 268, "text": "rule inLevelE(_:String, _:String) => false [owise]"}
{"category": "syntax:function,total", "end_line": 269, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:269", "keyword": "syntax", "sha256": "b9870a621ad1be4d3a7c365468aea378f44ec26954b7e9c188db758ca114faf5", "start_line": 269, "text": "syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]"}
{"category": "rule:ordinary", "end_line": 270, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:270", "keyword": "rule", "sha256": "7a7e56f7388050cd1919f7e222333ac3b98c776e784b8539d083a19bb64848f6", "start_line": 270, "text": "rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)"}
{"category": "rule:ordinary", "end_line": 271, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:271", "keyword": "rule", "sha256": "d0623558f5e85944ab1fcd7335be39840a83c46b7d5428876c7833b4f89b5384", "start_line": 271, "text": "rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))"}
{"category": "syntax:function,total", "end_line": 272, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:272", "keyword": "syntax", "sha256": "5895024c900ed926efd37641fc7f49c57eb17dfb01becd0b3a37b5314cd99ee0", "start_line": 272, "text": "syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 273, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:273", "keyword": "rule", "sha256": "0a8e13361178e515263f1d8ae563297c568b0362c79d97efdfcea3c88117f181", "start_line": 273, "text": "rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 278, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:274", "keyword": "rule", "sha256": "6a074d0b500b3dd61de61ad70bd8ee000682d28c6ebc2343d18848b96402f640", "start_line": 274, "text": "rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))\n\n  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================\n  // The md5 value itself is a named shared trust (sortVS-style, no concrete\n  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k)."}
{"category": "syntax", "end_line": 279, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:279", "keyword": "syntax", "sha256": "daf634ba2a452a465a8979ce59cb66a1fadf69f201135b26bbf668a0b140cee6", "start_line": 279, "text": "syntax KItem ::= \"#md5\""}
{"category": "rule:priority(40)", "end_line": 281, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:280", "keyword": "rule", "sha256": "1651b5d13893a33ca1aa264433af99f80a5fff365d2129c6ed6e7dcba72ac927", "start_line": 280, "text": "rule <k> Call(Attribute(Name(\"hashlib\"), \"md5\"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>\n       [priority(40)]"}
{"category": "rule:ordinary", "end_line": 282, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:282", "keyword": "rule", "sha256": "3dea3e5b7893d5a8de66b418ef62a7720a4922b0196b3bf6f60da7b3ce209a46", "start_line": 282, "text": "rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>"}
{"category": "syntax", "end_line": 283, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:283", "keyword": "syntax", "sha256": "697d07fdfb4368b871b79100399c9f9a6e5a9fe6cabea49f874000787d63e6c6", "start_line": 283, "text": "syntax Val ::= md5Obj(IntSeq)"}
{"category": "rule:ordinary", "end_line": 284, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:284", "keyword": "rule", "sha256": "314edc78f759a075f1de50ee2835fb29fabb540ba0d03224597f229c4569402c", "start_line": 284, "text": "rule applyMethod(md5Obj(CS:IntSeq), \"hexdigest\", .Vals) => str(md5hexCodes(CS))"}
{"category": "syntax:function,total,symbol", "end_line": 290, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:285", "keyword": "syntax", "sha256": "3164649fc0c74f1f45170c6c06d43e76ac28d37cee45f8933671c0e9730d2d47", "start_line": 285, "text": "syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]\n\n  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================\n  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to\n  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old\n  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before)."}
{"category": "rule:ordinary", "end_line": 291, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:291", "keyword": "rule", "sha256": "89ae05ae7446b64459d70500af804820a1dd08a2e026be0482e5c3a785017dc4", "start_line": 291, "text": "rule applyBuiltin(\"isinstance\", V:Val, typeV(\"int\"), .Vals) => isIntV(V)"}
{"category": "rule:ordinary", "end_line": 292, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:292", "keyword": "rule", "sha256": "42f642e09611be70a172dc68c2006d70fc21a4a1e53a226708cb78c84dba1a46", "start_line": 292, "text": "rule applyBuiltin(\"isinstance\", V:Val, typeV(\"str\"), .Vals) => isStrV(V)"}
{"category": "syntax:function", "end_line": 293, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:293", "keyword": "syntax", "sha256": "09de746af4b8bd37b0903d806cc36bc62183fa7c6cdd818358b1c420b1dc7ec0", "start_line": 293, "text": "syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]"}
{"category": "rule:ordinary", "end_line": 294, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:294", "keyword": "rule", "sha256": "999a8165286db50932b5ae7b7ce8b0abb05650f1198e29e2ad3b081a328d917e", "start_line": 294, "text": "rule isIntV(_:Int)         => true"}
{"category": "rule:owise", "end_line": 295, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:295", "keyword": "rule", "sha256": "fa24b26417742a45e251fde06a487327af3729e2c0fdef2b3a03f63d4baf20dd", "start_line": 295, "text": "rule isIntV(_:Val)         => false [owise]"}
{"category": "rule:ordinary", "end_line": 296, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:296", "keyword": "rule", "sha256": "d3c0ce1552b2b2853fc67dafe979d0d00417538151d66cb0639225f240b23ade", "start_line": 296, "text": "rule isStrV(str(_:IntSeq)) => true"}
{"category": "rule:owise", "end_line": 297, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:297", "keyword": "rule", "sha256": "c794000917834d2289e8326f137c50434f83a0d909583ea0b19bf1ecf25735c7", "start_line": 297, "text": "rule isStrV(_:Val)         => false [owise]"}
{"category": "endmodule", "end_line": 298, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:298", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 298, "text": "endmodule"}
{"category": "module", "end_line": 10, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:10", "keyword": "module", "sha256": "876a0ba2b4a12f1d7c9d9b9078fa73163bb752f12602c9436ab479a8e7586358", "start_line": 10, "text": "module MPY-CALL"}
{"category": "imports", "end_line": 11, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:11", "keyword": "imports", "sha256": "09fe9e0706aef859710b0c5447f1427e859a1a9e9660b612e310bb91d51ec923", "start_line": 11, "text": "imports MPY-METHODS"}
{"category": "imports", "end_line": 12, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:12", "keyword": "imports", "sha256": "513b07985ad1b60ab1fc94f4a08021dd25a5b0aa218c3a975ce281a00395ddfa", "start_line": 12, "text": "imports MPY-BUILTINS"}
{"category": "imports", "end_line": 15, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:13", "keyword": "imports", "sha256": "67ac93088ef9b779e5ae3b7345e6c00edd227c69ea1d356e5c8f3fe5ca0ada32", "start_line": 13, "text": "imports MPY-FUNCTIONS\n\n  // a cooled attribute is a bound method value"}
{"category": "rule:owise", "end_line": 18, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:16", "keyword": "rule", "sha256": "5cfad04764ee2b06732280ff368c5035829167e0eb34c2354667357175067e38", "start_line": 16, "text": "rule <k> Attribute(V:Val, M:String) => boundMethodV(V, M) ... </k>\n\n  // evaluate callee, then args ([owise]: problem-local Call interceptions beat this)"}
{"category": "syntax", "end_line": 19, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:19", "keyword": "syntax", "sha256": "2e4b9931b31d9e16cfac26853c8ae9d20f6a224c0926e14661fb1687c29a28c5", "start_line": 19, "text": "syntax KItem ::= #callee(Exprs)"}
{"category": "rule:owise", "end_line": 20, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:20", "keyword": "rule", "sha256": "1e7cf6c3f022cb177607930a786e4fdcc401edb04cf97903c0420352b69ecead", "start_line": 20, "text": "rule <k> Call(Fe:Expr, ARGS:Exprs) => Fe ~> #callee(ARGS) ... </k> [owise]"}
{"category": "rule:ordinary", "end_line": 23, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:21", "keyword": "rule", "sha256": "117d37e83838f0c5f99f8c541e00d7ef631788cee93e03710b61c45f4b13500b", "start_line": 21, "text": "rule <k> CV:Val ~> #callee(ARGS:Exprs) => #evalArgs(ARGS, .Vals, toCall(CV)) ... </k>\n\n  // ==== dispatch on the callee value ========================================"}
{"category": "rule:ordinary", "end_line": 25, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:24", "keyword": "rule", "sha256": "ba0da2a7daa02786dc1db5e4224e2e2046dc13fd8f9cff675b66fa21b3e64cc3", "start_line": 24, "text": "rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), ACC:Vals) => applyMethod(OBJ, M, ACC) ... </k>"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:26", "keyword": "rule", "sha256": "9355577d2cbe61131a734689308fa7e966bed71322d4c012ae085359653437bb", "start_line": 26, "text": "rule <k> #applyK(toCall(builtinV(\"sum\")), (OBJ:Iterable, .Vals)) => #sumAcc(OBJ, 0) ... </k>"}
{"category": "rule:ordinary", "end_line": 27, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:27", "keyword": "rule", "sha256": "c61154d49e9b79cf53f1e67054efca397b0251a3382d13c4767413e14ceb822e", "start_line": 27, "text": "rule <k> #applyK(toCall(builtinV(\"all\")), (OBJ:Iterable, .Vals)) => #allAcc(OBJ)    ... </k>"}
{"category": "rule:ordinary", "end_line": 28, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:28", "keyword": "rule", "sha256": "c6499b637357afcc724c653c7ba837a1c1ac561f2ffc5451ef7945727fc94bae", "start_line": 28, "text": "rule <k> #applyK(toCall(builtinV(\"any\")), (OBJ:Iterable, .Vals)) => #anyAcc(OBJ)    ... </k>"}
{"category": "rule:ordinary", "end_line": 29, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:29", "keyword": "rule", "sha256": "c477beb1100e758a45f116488480f46efabc752048a57a93a6d9b7ba087483aa", "start_line": 29, "text": "rule <k> #applyK(toCall(builtinV(\"max\")), (OBJ:Iterable, .Vals)) => #maxAcc0(OBJ)   ... </k>"}
{"category": "rule:ordinary", "end_line": 30, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:30", "keyword": "rule", "sha256": "c299129ec67567c2edf5161e5e99f14922c4d735d6c7ba7ef1110777d7cbe4d1", "start_line": 30, "text": "rule <k> #applyK(toCall(builtinV(\"min\")), (OBJ:Iterable, .Vals)) => #minAcc0(OBJ)   ... </k>"}
{"category": "rule:owise", "end_line": 31, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:31", "keyword": "rule", "sha256": "6240ee6cdac44c092bb0f74980dbda8676b27a5f3bac089732a70dcd47a4c708", "start_line": 31, "text": "rule <k> #applyK(toCall(builtinV(BN:String)), ACC:Vals) => applyBuiltin(BN, ACC) ... </k> [owise]"}
{"category": "rule:ordinary", "end_line": 37, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:32", "keyword": "rule", "sha256": "cd21b8ce5bca92a5f815999dbdb6f8e75e8876a84b8876b99c9b20dc0288c06e", "start_line": 32, "text": "rule <k> #applyK(toCall(typeV(T:String)),     ACC:Vals) => applyBuiltin(T, ACC)  ... </k>\n\n  // ==== heap-object arguments/receivers =====================================\n  // Builtins and type calls READ structure — deref the first two arg positions\n  // (covers len/sum/all/any/max/min/sorted/list/set + zip's pair). Mutating list\n  // methods take the ref itself; every other method receiver is deref'd."}
{"category": "rule:priority(40)", "end_line": 41, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:38", "keyword": "rule", "sha256": "ee3d87d37701286abb1207dd0c1403a910173ce0c2345a48e5af0a2a0db63169", "start_line": 38, "text": "rule <k> #applyK(toCall(builtinV(BN:String)), (ref(H:Int), REST:Vals))\n        => #applyK(toCall(builtinV(BN)), (V, REST)) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "rule:priority(40)", "end_line": 46, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:42", "keyword": "rule", "sha256": "5cfcef8958d3928b8da8e943711dbcc374254ac310d045f92782b67b160b5f84", "start_line": 42, "text": "rule <k> #applyK(toCall(builtinV(BN:String)), (A:Val, ref(H:Int), REST:Vals))\n        => #applyK(toCall(builtinV(BN)), (A, V, REST)) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       requires notBool isRefV(A)\n       [priority(40)]"}
{"category": "rule:priority(40)", "end_line": 51, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:47", "keyword": "rule", "sha256": "fd42ded76cba98e50afddb7e0b87b526721d3d23a0665609e9bb4433cffcf745", "start_line": 47, "text": "rule <k> #applyK(toCall(typeV(T:String)), (ref(H:Int), REST:Vals))\n        => #applyK(toCall(typeV(T)), (V, REST)) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "syntax:function,total", "end_line": 52, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:52", "keyword": "syntax", "sha256": "d5c2626ac8a700308c530f067a7ff9b69d436d8a00d27e497c985cb0c3eb667a", "start_line": 52, "text": "syntax Bool ::= isMutMethod(String) [function, total]"}
{"category": "rule:ordinary", "end_line": 55, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:53", "keyword": "rule", "sha256": "1d9f03fc012dee3e24ac432d4f4d947421732faebea49e364513101a304c1556", "start_line": 53, "text": "rule isMutMethod(M:String)\n    => M ==String \"append\" orBool M ==String \"sort\" orBool M ==String \"extend\"\n       orBool M ==String \"insert\" orBool M ==String \"pop\" orBool M ==String \"remove\""}
{"category": "rule:priority(40)", "end_line": 62, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:56", "keyword": "rule", "sha256": "3c518e910de94496b6e3b8c1dbb2e313454f7d3ad68f843b0df402cd37ec1433", "start_line": 56, "text": "rule <k> #applyK(toCall(boundMethodV(ref(H:Int), M:String)), ACC:Vals)\n        => #applyK(toCall(boundMethodV(V, M)), ACC) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       requires notBool isMutMethod(M)\n       [priority(40)]\n  // non-mutating methods READ their heap-object arguments too (join's list);\n  // mutators keep refs (append of a list into a list-of-lists stays aliased)"}
{"category": "rule:priority(40)", "end_line": 68, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:63", "keyword": "rule", "sha256": "187b119fad389e6d37b6210e9f9617d6d10d63eba562bc58509ae550865d0e20", "start_line": 63, "text": "rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), (ref(H:Int), REST:Vals))\n        => #applyK(toCall(boundMethodV(OBJ, M)), (V, REST)) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       requires notBool isMutMethod(M) andBool notBool isRefV(OBJ)\n       [priority(40)]"}
{"category": "rule:ordinary", "end_line": 79, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:69", "keyword": "rule", "sha256": "eda58ef1dc7b0e536c8f4a8f3784fdc3f2e30160445b22a5d53955da61bb68df", "start_line": 69, "text": "rule <k> #applyK(toCall(closureVal(PNS:ParamNames, BODY:Stmts, DEFL:Int)), ACC:Vals) ~> CONT\n        => #bindP(PNS, ACC) ~> BODY ~> #endcall </k>\n       <env>     CALLERL:Int => NEWL </env>\n       <scopes>   STORE:Map => STORE [ NEWL <- scope(.Map, parent(DEFL)) ] </scopes>\n       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>\n       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>\n\n  // annotated closure: the frame starts with the captured freevar cells, its\n  // parent is the module scope (all enclosing-local reads go through cells),\n  // and the cellvars' fresh cells allocate before params bind (a cellvar param\n  // then writes through its cell in #bindP)."}
{"category": "rule:ordinary", "end_line": 86, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:80", "keyword": "rule", "sha256": "dfda7a0ca530f2e95bca4cec727bb8bde04e76eb4591e7a93105040e61d2d86b", "start_line": 80, "text": "rule <k> #applyK(toCall(closureValC(PNS:ParamNames, CVS:ParamNames, BODY:Stmts, CM:Map)), ACC:Vals) ~> CONT\n        => #allocCells(CVS) ~> #bindP(PNS, ACC) ~> BODY ~> #endcall </k>\n       <env>     CALLERL:Int => NEWL </env>\n       <scopes>   STORE:Map => STORE [ NEWL <- scope(CM [ \"$cells\" <- cellsMark(CVS) ], parent(0)) ] </scopes>\n       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>\n       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>"}
{"category": "syntax", "end_line": 87, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:87", "keyword": "syntax", "sha256": "66b816d7dbbcb9d731590143b3d24bb779b4f8884fc7b5bb7f970cefaffb7f05", "start_line": 87, "text": "syntax KItem ::= #allocCells(ParamNames)"}
{"category": "rule:ordinary", "end_line": 88, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:88", "keyword": "rule", "sha256": "ab5f4beee335a8e71b2964a9d669bbe365a142f028d53ec7fe526ddc46ec1346", "start_line": 88, "text": "rule <k> #allocCells(.ParamNames) => .K ... </k>"}
{"category": "rule:ordinary", "end_line": 94, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:89", "keyword": "rule", "sha256": "fafea1ce5a102d6dbdc6d260523447277ad8fb738086cec855cc5c8b8071d66d", "start_line": 89, "text": "rule <k> #allocCells((CV:String, R:ParamNames)) => #allocCells(R) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ CV <- cellRef(N) ], _) ... </scopes>\n       <heap>    H:Map => (N |-> cellV(noneV)) H </heap>\n       <heapLoc> N:Int => N +Int 1 </heapLoc>\n       requires notBool N in_keys(H)"}
{"category": "endmodule", "end_line": 95, "file": "reference-semantics/semantics/call.k", "id": "reference-semantics/semantics/call.k:95", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 95, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:3", "keyword": "module", "sha256": "5d080156bedbd23cced0d31375ba799d8e28e2b518843fc2cec979392a9af1b3", "start_line": 3, "text": "module MPY-COMPREHENSION"}
{"category": "imports", "end_line": 4, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:4", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 4, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 5, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:5", "keyword": "imports", "sha256": "ee018db6efb00ffdd01d59dac03e43be2192505ed7049d1c693197e018cbc088", "start_line": 5, "text": "imports MPY-OPERATORS"}
{"category": "imports", "end_line": 6, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:6", "keyword": "imports", "sha256": "511c798e04e96a7ad3e9efe5e06eb4804d66d38f1294d62d46068dc7eafb0373", "start_line": 6, "text": "imports MPY-LIST"}
{"category": "imports", "end_line": 7, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:7", "keyword": "imports", "sha256": "47dfd92e317bb7c0d2b37ea8704d1ebdf3daf5f2ca37f0555105ffde812c5061", "start_line": 7, "text": "imports MPY-CONTROLS"}
{"category": "imports", "end_line": 10, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:8", "keyword": "imports", "sha256": "89f0416e001bb7caf37979aa5b30bcff10e96db7c9e1f60dfb34cc6797d8b539", "start_line": 8, "text": "imports MPY-FUNCTIONS\n\n  // A comprehension is pure syntactic sugar"}
{"category": "rule:ordinary", "end_line": 11, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:11", "keyword": "rule", "sha256": "4645372e277c8411d291e3fcff391daaf3c5a73e3ef74cbf6ce8cdc816de97ff", "start_line": 11, "text": "rule ListComp(ELT:Expr, Gs:CompFors) => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)"}
{"category": "rule:ordinary", "end_line": 13, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:12", "keyword": "rule", "sha256": "a3878283cbe84afd313554e74f09aa30008617c89e48cea7794053ac457fe422", "start_line": 12, "text": "rule GenExp(ELT:Expr, Gs:CompFors)   => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)"}
{"category": "syntax:macro", "end_line": 14, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:14", "keyword": "syntax", "sha256": "824d607beedb6356c5932cea164d2188bc5585db6eb430ba265d3b4c19c55484", "start_line": 14, "text": "syntax Stmts ::= compBody(CompFors, Expr) [macro]"}
{"category": "rule:ordinary", "end_line": 17, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:15", "keyword": "rule", "sha256": "5c4c897cdd72e8a7413d023e28696791d3f3d4fda709ae7157a43c443db26063", "start_line": 15, "text": "rule compBody(Gs:CompFors, ELT:Expr)\n    => Assign(Name(\"$acc\"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name(\"$acc\"))"}
{"category": "syntax:macro", "end_line": 18, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:18", "keyword": "syntax", "sha256": "7d588d134f4b785d98fc64c4e16c825bbe11c41d9d7d37f0e06cd1f66093fb24", "start_line": 18, "text": "syntax Stmt ::= compNest(CompFors, Expr) [macro-rec]"}
{"category": "rule:ordinary", "end_line": 20, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:19", "keyword": "rule", "sha256": "57c2e26708bed376d2236fcc120e16c02b0b178f3e5c627d9fa8e205902b03da", "start_line": 19, "text": "rule compNest(.CompFors, ELT:Expr)\n    => Assign(Name(\"$acc\"), BinOp(\"+\", Name(\"$acc\"), ListExpr(ELT)))"}
{"category": "rule:ordinary", "end_line": 23, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:21", "keyword": "rule", "sha256": "6e48579ec017c00a34566736dc1e72964a47c188a54407d865de33da30011b56", "start_line": 21, "text": "rule compNest((CompFor(T:Expr, ITER:Expr, Fs:Exprs) GRest:CompFors), ELT:Expr)\n    => For(T, ITER, If(compGuard(Fs), compNest(GRest, ELT), .Stmts))"}
{"category": "syntax:macro", "end_line": 24, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:24", "keyword": "syntax", "sha256": "2ecdbee509dd4259654a9d1406ac80f7ab26ed49249fa5c649e11cb66b7d4134", "start_line": 24, "text": "syntax Expr ::= compGuard(Exprs) [macro]"}
{"category": "rule:ordinary", "end_line": 25, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:25", "keyword": "rule", "sha256": "17ed18454df98d53e7d1a6a94290e3081b63ee95609550af3de7d0a75d683a8d", "start_line": 25, "text": "rule compGuard(.Exprs)             => Bool(true)"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:26", "keyword": "rule", "sha256": "93505f664b89633f28cdf7cccc72842555b929b721d95b861d75f48ffe8f9c05", "start_line": 26, "text": "rule compGuard((F:Expr, Fs:Exprs)) => BoolOp(\"and\", (F, Fs))"}
{"category": "endmodule", "end_line": 27, "file": "reference-semantics/semantics/comprehension.k", "id": "reference-semantics/semantics/comprehension.k:27", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 27, "text": "endmodule"}
{"category": "module", "end_line": 8, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:8", "keyword": "module", "sha256": "31e028e78e3cd17c58c12c312a9b611cc9c541190813a73e485ea085b096dc6b", "start_line": 8, "text": "module MPY-CONCRETE"}
{"category": "imports", "end_line": 12, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:9", "keyword": "imports", "sha256": "b48c1fb32865ec1ab577847a65862fb91e67583633646960c4c018637e299c1f", "start_line": 9, "text": "imports MPY\n\n  // deep equality for list compares whose elements are heap objects\n  // (list-of-lists): Python == is structural at every depth."}
{"category": "rule:ordinary", "end_line": 15, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:13", "keyword": "rule", "sha256": "5b920898a92169b34743023dcc569e1ac931faf55d8a52834219f2cff9390c68", "start_line": 13, "text": "rule <k> Compare(list(A:ValSeq), CmpOp(\"==\", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>\n       <heap> HP:Map </heap>\n       requires hasRefVS(A) orBool hasRefVS(B)"}
{"category": "rule:priority(40)", "end_line": 24, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:16", "keyword": "rule", "sha256": "94569d5ed4fdbdb2494154fe7a8d3eb88d1a46bc2385f0adbffd51753e50d40a", "start_line": 16, "text": "rule <k> Compare(list(A:ValSeq), CmpOp(\"!=\", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>\n       <heap> HP:Map </heap>\n       requires hasRefVS(A) orBool hasRefVS(B)\n\n  // ==== keyed sort, concrete leg ============================================\n  // Computes each key by a REAL call through the uniform #callee machinery\n  // (closures, len, type objects all work), stable-inserts on the key, and\n  // allocates the result. priority(40) beats sort.k's opaque rules, so krun\n  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS."}
{"category": "syntax", "end_line": 25, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:25", "keyword": "syntax", "sha256": "2a90169184182c410fe4c2ce341278c2dedd8d7d6f8601a991c3dc2e0b42f634", "start_line": 25, "text": "syntax Val ::= kvP(Val, Val)"}
{"category": "syntax", "end_line": 27, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:26", "keyword": "syntax", "sha256": "c81660cf2dedd63a8ee7672ce7b20af8ec00e2a0b7462de560b4663e005bdffe", "start_line": 26, "text": "syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)\n                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)"}
{"category": "rule:priority(40)", "end_line": 30, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:28", "keyword": "rule", "sha256": "69542fb8e5438746cc466f08577b098cb8d583d4f6214ad9d09b42704cf192d8", "start_line": 28, "text": "rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), .Vals))\n        => #ksort(VS, KV, .ValSeq, false) ... </k>\n       [priority(40)]"}
{"category": "rule:priority(40)", "end_line": 33, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:31", "keyword": "rule", "sha256": "00feff65cbca1395cd99428233dd29ab273306e4329d768563936e3c10fef121", "start_line": 31, "text": "rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), kwV(\"reverse\", RB:Bool), .Vals))\n        => #ksort(VS, KV, .ValSeq, RB) ... </k>\n       [priority(40)]"}
{"category": "rule:ordinary", "end_line": 35, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:34", "keyword": "rule", "sha256": "14b845c8db97157f52fa9eb1fb0853a61bfb146f9f537df2f9267f06eb0a0f6c", "start_line": 34, "text": "rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)\n        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>"}
{"category": "rule:ordinary", "end_line": 37, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:36", "keyword": "rule", "sha256": "fb87dc6e2e9f6c302d51ce0572d5a76514d22254534513c5d8c0b5b7ab3ccfca", "start_line": 36, "text": "rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)\n        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>"}
{"category": "rule:ordinary", "end_line": 41, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:38", "keyword": "rule", "sha256": "110222299ad8c5cac55089f61fccd9b2a89be2ebce452a4c15239befbcb6fade", "start_line": 38, "text": "rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)\n        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>\n       requires notBool isKwV(K)"}
{"category": "syntax:function", "end_line": 42, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:42", "keyword": "syntax", "sha256": "55dc07274299e7b58a622feb28c763987b5c35ead1b9d2cf9165912436433038", "start_line": 42, "text": "syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]"}
{"category": "rule:ordinary", "end_line": 43, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:43", "keyword": "rule", "sha256": "1b9c47e83939876546f307ade1ff83df08d7a46c8ba0d6c86b5ae1a324438de2", "start_line": 43, "text": "rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)"}
{"category": "rule:ordinary", "end_line": 46, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:44", "keyword": "rule", "sha256": "041af2698561669805bb214d2bfe19799589545db02a2eb49debbdc2b03b731f", "start_line": 44, "text": "rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)\n    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))\n       requires kLt(K, K2)"}
{"category": "rule:ordinary", "end_line": 50, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:47", "keyword": "rule", "sha256": "0be272f2ab8565878dafed9c628877896aa702bdf4ab3d159550680aa74abb6e", "start_line": 47, "text": "rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)\n    => vCons(kvP(K2, V2), insPair(R, K, V))\n       requires notBool kLt(K, K2)"}
{"category": "syntax:function", "end_line": 51, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:51", "keyword": "syntax", "sha256": "a74ccb7aaf4fb0873480901bff971b092c9dbd03f69b4a4430f9e6813bad457d", "start_line": 51, "text": "syntax Bool ::= kLt(Val, Val) [function]"}
{"category": "rule:ordinary", "end_line": 52, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:52", "keyword": "rule", "sha256": "fbdc0f5eaf8a7c25a1740bd9f4f4c0af8072c6e46405e76d325b130c4050f75e", "start_line": 52, "text": "rule kLt(I1:Int, I2:Int)             => I1 <Int I2"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:53", "keyword": "rule", "sha256": "b5c575a5cf7156a38288d730f2592923afe7520934e825981a2d28804187326d", "start_line": 53, "text": "rule kLt(F1:Float, F2:Float)         => F1 <Float F2"}
{"category": "rule:ordinary", "end_line": 55, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:54", "keyword": "rule", "sha256": "608ffd1665edfb59d472955da76f6ec8ad22974711f47c9d1117cc0cb9476b0a", "start_line": 54, "text": "rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)"}
{"category": "syntax:function,total", "end_line": 56, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:56", "keyword": "syntax", "sha256": "4f9bc29fa28a4ee808049a44a900983a4a13f51e3667cf63740414c413645975", "start_line": 56, "text": "syntax ValSeq ::= unpairVS(ValSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 57, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:57", "keyword": "rule", "sha256": "a2e6dd066c677c3fbb8ae42e1bb4c4e08b35e98d6758e9817a1c0e32f2ed298d", "start_line": 57, "text": "rule unpairVS(.ValSeq) => .ValSeq"}
{"category": "rule:ordinary", "end_line": 58, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:58", "keyword": "rule", "sha256": "84d1ae0473a111b622b6e1cdad885d3b2af53ee0c5cea2bb9e91888301892032", "start_line": 58, "text": "rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))"}
{"category": "rule:owise", "end_line": 59, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:59", "keyword": "rule", "sha256": "7ae54fdad398cb576570dee684b0148c5f7a140e6fef4af4509048db2f3d63e7", "start_line": 59, "text": "rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]"}
{"category": "endmodule", "end_line": 60, "file": "reference-semantics/semantics/concrete.k", "id": "reference-semantics/semantics/concrete.k:60", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 60, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:3", "keyword": "module", "sha256": "f64b2208f5bd8e4aed5d3dc9982419bc4a18cce867ec3ca3063120a89b7c4f48", "start_line": 3, "text": "module MPY-CONTROLS"}
{"category": "imports", "end_line": 4, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:4", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 4, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 5, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:5", "keyword": "imports", "sha256": "b1d1ddeb005d397d01d2501033a979d991b52ce94dc5c6fcb2c801237e698309", "start_line": 5, "text": "imports MPY-TUPLE"}
{"category": "imports", "end_line": 8, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:6", "keyword": "imports", "sha256": "d864334f5631ded50ff32890cda27b412923469c6312ee160eb533325c878d9c", "start_line": 6, "text": "imports MPY-ITER\n\n  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) =="}
{"category": "rule:ordinary", "end_line": 11, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:9", "keyword": "rule", "sha256": "727336c6ee2cfe6067accc720b6f2131f763150ba92b7f78182575af12d854d0", "start_line": 9, "text": "rule <k> Assign(Name(X:String), V:Val) => .K ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>"}
{"category": "rule:priority(40)", "end_line": 19, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:12", "keyword": "rule", "sha256": "86f7726c7fa43d7d5edeef0f096b381249c49a5d32f58df4e181cb6b39413bf2", "start_line": 12, "text": "rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\n       requires \"$cells\" in_keys(M)\n        andBool pnMember(X, cellsOf({M[\"$cells\"]}:>Val))\n        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)\n       [priority(40)]"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:20", "keyword": "rule", "sha256": "f7b414275b729ba4510328dbe45ee25c60a0d74d940bfcc0dabf9bf30055b4ff", "start_line": 20, "text": "rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>\n       requires X in_keys(M)\n  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the\n  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route\n  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref)."}
{"category": "rule:priority(40)", "end_line": 34, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:27", "keyword": "rule", "sha256": "27209f24214773923c6c6bf08745f386e0ef2fde43543bb98fdeb245bc187c93", "start_line": 27, "text": "rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\n       requires X in_keys(M) andBool isRefV({M[X]}:>Val)\n       [priority(40)]\n\n  // ==== import trivia: `from math import floor, ceil` binds the supported\n  // names as builtins in the current scope; every other import is a no-op"}
{"category": "rule:ordinary", "end_line": 35, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:35", "keyword": "rule", "sha256": "f402a7269397fca0b1ac21aed748b760050ba708a163d261f974e913771da3c2", "start_line": 35, "text": "rule <k> ImportFrom(\"math\", NS:ParamNames) => #bindImports(NS) ... </k>"}
{"category": "rule:owise", "end_line": 36, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:36", "keyword": "rule", "sha256": "52700f6597b29ddb0bc621e8272d2fed465b14604d21641c831c107ffb9411fd", "start_line": 36, "text": "rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]"}
{"category": "syntax", "end_line": 37, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:37", "keyword": "syntax", "sha256": "88b5590c6cf0d241359de642778c97d21462b7df276d7ff9da14b483221cd040", "start_line": 37, "text": "syntax KItem ::= #bindImports(ParamNames)"}
{"category": "rule:ordinary", "end_line": 38, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:38", "keyword": "rule", "sha256": "775670eae46ffc1b3ac3c61cc6400e6a17c0e758ff2a08cda58bb08045a0ad4d", "start_line": 38, "text": "rule <k> #bindImports(.ParamNames) => .K ... </k>"}
{"category": "rule:ordinary", "end_line": 42, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:39", "keyword": "rule", "sha256": "72a0209aaedb8845bc859deb2c1c9bdbe8679e0f2c756d60ba6751f70de8bc39", "start_line": 39, "text": "rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>\n       requires N ==String \"floor\" orBool N ==String \"ceil\""}
{"category": "rule:ordinary", "end_line": 47, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:43", "keyword": "rule", "sha256": "ae5c2b5f3a70907cc72f68c707b220a1e25cf172ff5240a66e92737254dcd767", "start_line": 43, "text": "rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>\n       requires notBool (N ==String \"floor\" orBool N ==String \"ceil\")\n\n  // ==== Expr statement: evaluate for effect, discard the value ===============\n  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)"}
{"category": "rule:ordinary", "end_line": 50, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:48", "keyword": "rule", "sha256": "c6a1ea8d63abb1beb7b837a2cabef723c0661108979d1a4c1217c74a6e31f494", "start_line": 48, "text": "rule <k> Expr(_:Val) => .K ... </k>\n\n  // ==== If (condition evaluated by strictness) =============================="}
{"category": "syntax", "end_line": 51, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:51", "keyword": "syntax", "sha256": "7b0fe50a62195a3b0fef8fb68b9e36bec75ecac9e75acf69e84b5201a689d177", "start_line": 51, "text": "syntax KItem ::= #branch(Bool, Stmts, Stmts)"}
{"category": "rule:ordinary", "end_line": 52, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:52", "keyword": "rule", "sha256": "cbe0a65ca8b486f863733c806119e1f4a10dbab29dfe59f18e11ba8a0eba3c24", "start_line": 52, "text": "rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:53", "keyword": "rule", "sha256": "5e1b96eb480c005b10b3da418ba32506ea88f229b85e332c9f021a88eb505350", "start_line": 53, "text": "rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>"}
{"category": "rule:ordinary", "end_line": 56, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:54", "keyword": "rule", "sha256": "e4b03b7b0df69b0ccdcb66d89cae665ad1c6d940adc8969e9b931119b9a6b75e", "start_line": 54, "text": "rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>\n\n  // ==== IfExp: ternary T if C else E ========================================"}
{"category": "rule:ordinary", "end_line": 58, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:57", "keyword": "rule", "sha256": "ac20784b5ae48350f463d4018adc2035c439260236a2835fef54d2e887c6a95e", "start_line": 57, "text": "rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>\n       requires truthy(V)"}
{"category": "rule:ordinary", "end_line": 64, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:59", "keyword": "rule", "sha256": "37c6dedb7b350d9c6d567e28a11b50a4e0567a59386ecdcb566ff3aec7558f7f", "start_line": 59, "text": "rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>\n       requires notBool truthy(V)\n\n  // ==== For: one loop, in-cell continuation, over #iterNext =================\n  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —\n  // circularities anchor on #loop and narrowing substitutes the structure)"}
{"category": "syntax", "end_line": 68, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:65", "keyword": "syntax", "sha256": "d3eeb935e6cc098a035391767235774d42deface1d76abdf0ea01852d285ed80", "start_line": 65, "text": "syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)\n                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)\n                 | #loopLbl(K) | \"#cont\" | \"#brk\""}
{"category": "rule:ordinary", "end_line": 70, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:69", "keyword": "rule", "sha256": "54e2c3c93eb9e29b84ab176aea9ecc6ea72a430e4d0191059235eb51231c0480", "start_line": 69, "text": "rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>"}
{"category": "rule:ordinary", "end_line": 71, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:71", "keyword": "rule", "sha256": "f6431203e70c43ecb8a36acee40238048e5ae9c14481a6f5e8cb0b7b1d58b46e", "start_line": 71, "text": "rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>"}
{"category": "rule:ordinary", "end_line": 72, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:72", "keyword": "rule", "sha256": "e22f89d510cff7d36192b2a2ccfeaaf725796c8c8c827450ae307c7947ef155a", "start_line": 72, "text": "rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>"}
{"category": "rule:ordinary", "end_line": 76, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:73", "keyword": "rule", "sha256": "8b972de97f32cfd1a4a83ed23633ccbf4aa4ca29f24216c9a1ae8c7ba8cd37f8", "start_line": 73, "text": "rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)\n        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>\n\n  // ==== While =============================================================="}
{"category": "rule:ordinary", "end_line": 77, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:77", "keyword": "rule", "sha256": "cc778d0a7dee57761ad2083c164374f1ca61a417f970a113330d7964d8a869df", "start_line": 77, "text": "rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>"}
{"category": "rule:ordinary", "end_line": 78, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:78", "keyword": "rule", "sha256": "6b4a239ea0168f84cd9b863978fae9d5c0b970eabaf77a73c6bbda53ca569539", "start_line": 78, "text": "rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>"}
{"category": "rule:ordinary", "end_line": 80, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:79", "keyword": "rule", "sha256": "4d0735d2af7409ad7c2b79a66034469506b75b09f49a77fe8cce99ec389be53b", "start_line": 79, "text": "rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>\n       requires truthy(V)"}
{"category": "rule:ordinary", "end_line": 84, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:81", "keyword": "rule", "sha256": "eec09df2babc41ccc4851b81d6eed48bcd72107b7a6d39cf25ccf293837b2ddd", "start_line": 81, "text": "rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>\n       requires notBool truthy(V)\n\n  // ==== loop control (break / continue) ====================================="}
{"category": "rule:ordinary", "end_line": 85, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:85", "keyword": "rule", "sha256": "bb87d59b209abee2097a69ac0521f4f49fc8162769983885860572a9797f7f3a", "start_line": 85, "text": "rule <k> #loopLbl(NEXT:K) => NEXT ... </k>"}
{"category": "rule:ordinary", "end_line": 86, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:86", "keyword": "rule", "sha256": "7987cb734506ffbd385ee94489bf6138d7d3e170c7e1bcf045a5de280ba0bb83", "start_line": 86, "text": "rule <k> Continue => #cont ... </k>"}
{"category": "rule:ordinary", "end_line": 87, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:87", "keyword": "rule", "sha256": "0c6690a88f1d95c9312e4548a2245797efb3794c54bd0b998bc299250012679e", "start_line": 87, "text": "rule <k> Break => #brk ... </k>"}
{"category": "rule:ordinary", "end_line": 88, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:88", "keyword": "rule", "sha256": "8617466b01468a24391f6c8144aa24fad531384c5ac6b67bf45ac202c9903691", "start_line": 88, "text": "rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>"}
{"category": "rule:owise", "end_line": 89, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:89", "keyword": "rule", "sha256": "5cabf37fa715399227a3a3ac10bbe5848811a4674872d38789dbcaaf8a962b70", "start_line": 89, "text": "rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]"}
{"category": "rule:ordinary", "end_line": 90, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:90", "keyword": "rule", "sha256": "5b9a5f06df03d210661bd4242bc729c182e9d98bf2ac35665f7d2c1cba2048f8", "start_line": 90, "text": "rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>"}
{"category": "rule:priority(40),owise", "end_line": 94, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:91", "keyword": "rule", "sha256": "9c411991a9cc3d354b4a10691a5751b31e6a81104aa893590fcf7733761b3ccf", "start_line": 91, "text": "rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]\n\n  // ==== heap-object deref at the truthiness/iteration consumers ==============\n  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)"}
{"category": "rule:priority(40)", "end_line": 97, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:95", "keyword": "rule", "sha256": "aebf4530a7ab360e4f1286a99172e256a32a9d9ee285c4959dbfaa347b8ac4b7", "start_line": 95, "text": "rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "rule:priority(40)", "end_line": 100, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:98", "keyword": "rule", "sha256": "c18a31f5ea1dbfc2cf24e90bf2353fffce1bbd2542d9da496f9fe999f856775a", "start_line": 98, "text": "rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "rule:priority(40)", "end_line": 105, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:101", "keyword": "rule", "sha256": "a6ee6070532512fe4ee882b4d6ccc3b0c5f641f627e1b6a3ab86c3fb9095d8ff", "start_line": 101, "text": "rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]\n  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;\n  // mutating the iterated list inside its own loop is outside the subset)"}
{"category": "rule:priority(40)", "end_line": 108, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:106", "keyword": "rule", "sha256": "f3e64e39e89e271f06d0fd0ad67705152170c53f43f4dcf7bcb8737f1c607bdc", "start_line": 106, "text": "rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "endmodule", "end_line": 109, "file": "reference-semantics/semantics/controls.k", "id": "reference-semantics/semantics/controls.k:109", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 109, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:3", "keyword": "module", "sha256": "6f8de5b253608309bc62e1e06d6c9d794fdc890af16d988e5e49d07a95e3b1df", "start_line": 3, "text": "module MPY-CORE"}
{"category": "imports", "end_line": 4, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:4", "keyword": "imports", "sha256": "53e3bff8f927183283d900a5251fa5e2512a93c8faf32e529621ebe895d93050", "start_line": 4, "text": "imports MPY-SYNTAX"}
{"category": "imports", "end_line": 5, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:5", "keyword": "imports", "sha256": "e6c6a545c82f21825986f4acedb91066255b1648e6ea357da01ee474f877a7ec", "start_line": 5, "text": "imports INT"}
{"category": "imports", "end_line": 6, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:6", "keyword": "imports", "sha256": "a87b57b80409f2a188407cd25e5a2bd9c412a60b8d7e64f7d839e3e9593b8569", "start_line": 6, "text": "imports BOOL"}
{"category": "imports", "end_line": 7, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:7", "keyword": "imports", "sha256": "0285d3d5d999f874f605ab7b0a1c28e70d0b96e3b33c6590556e0032fa33fd39", "start_line": 7, "text": "imports STRING"}
{"category": "imports", "end_line": 8, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:8", "keyword": "imports", "sha256": "acf7e2a94c16324b89d1a51d98c5e05fc55dc40954dc9fcb6723ba7baeb4ec53", "start_line": 8, "text": "imports MAP"}
{"category": "imports", "end_line": 9, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:9", "keyword": "imports", "sha256": "82a7d762e10459837802636cd031705c66f6df450b6e63ea0e20f72dc5a6fcd0", "start_line": 9, "text": "imports LIST"}
{"category": "imports", "end_line": 12, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:10", "keyword": "imports", "sha256": "1b73a263ea21e6b521a1cc554a4bff8cbb7037c9ab0ab07166ac32141ececf6e", "start_line": 10, "text": "imports K-EQUAL\n\n  // ==== values, the algebraic lists, and the scope heap ====================="}
{"category": "syntax", "end_line": 13, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:13", "keyword": "syntax", "sha256": "2768b2d6c3a17c8dc96cd3fe2032aaa71938dc7e459f3302d39650b2eb1e8be4", "start_line": 13, "text": "syntax IntSeq ::= \".IntSeq\" | iCons(Int, IntSeq)"}
{"category": "syntax", "end_line": 14, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:14", "keyword": "syntax", "sha256": "3571b0fa24f69901cc16fe43a413976e68db54b0f47c1857bba7bb311aec6578", "start_line": 14, "text": "syntax ValSeq ::= \".ValSeq\" | vCons(Val, ValSeq)"}
{"category": "syntax", "end_line": 17, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:15", "keyword": "syntax", "sha256": "4785e636d142fe61260c07b39088a19ce093ec3834fd48289870be1b89f08ccc", "start_line": 15, "text": "syntax Str    ::= str(IntSeq)\n\n  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)"}
{"category": "syntax", "end_line": 24, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:18", "keyword": "syntax", "sha256": "95c276903d0fc27b4eaec5be301f45077c8dde47e748a03fdfd7a4d83a5b9b99", "start_line": 18, "text": "syntax Iterable ::= list(ValSeq)\n                    | tuple(ValSeq)\n                    | Str\n                    | rangeObj(Int, Int, Int)\n                    | zipObj(ValSeq, ValSeq)\n                    | zipObjS(IntSeq, IntSeq)"}
{"category": "syntax:function", "end_line": 35, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:25", "keyword": "syntax", "sha256": "5093ac28883449f2c46b3d0405f435afba41dae57fbfeac713016c1419ac2102", "start_line": 25, "text": "syntax Val      ::= Int\n                    | Bool\n                    | \"noneV\"\n                    | Iterable\n                    | ref(Int)          // a heap object: <heap> holds its list(VS)\n                    | cellRef(Int)      // a closure cell: <heap> holds cellV(V)\n                    | closureVal(ParamNames, Stmts, Int)\n                    | typeV(String)     // a type object (int/str), resolved from the builtins frame\n                    | builtinV(String)  // a builtin function, resolved like any name (LEGB fallthrough)\n                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method"}
{"category": "syntax", "end_line": 36, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:36", "keyword": "syntax", "sha256": "c883cd56f6e685d5e8623d76e4aed287f4bffee3b2cea4f66f9451c765dfd5a2", "start_line": 36, "text": "syntax Parent   ::= \"root\" | parent(Int)"}
{"category": "syntax", "end_line": 37, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:37", "keyword": "syntax", "sha256": "364e84e4303edc97749aaf11c5b406463b42fd3abf1c5093021f3943454c734a", "start_line": 37, "text": "syntax Scope    ::= scope(Map, Parent)"}
{"category": "syntax", "end_line": 38, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:38", "keyword": "syntax", "sha256": "48fc3fcf188262b8158cb91b521e47fc57f5321156831f36d1c9f531499525a9", "start_line": 38, "text": "syntax KResult  ::= Val"}
{"category": "syntax", "end_line": 39, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:39", "keyword": "syntax", "sha256": "af287dc638f302c981d84bedb85d24be8becf783444634f4cb489ec041a1c4de", "start_line": 39, "text": "syntax Expr     ::= Val   // cooling puts results back into expression holes"}
{"category": "syntax", "end_line": 40, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:40", "keyword": "syntax", "sha256": "2db74932694df17faa6d6ecd630eb3747966a6f14c58f43fc53c388008db2a2b", "start_line": 40, "text": "syntax Vals     ::= List{Val, \",\"}"}
{"category": "syntax", "end_line": 41, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:41", "keyword": "syntax", "sha256": "f742989919fe406cfc32d91cb9e3d83d8493b276c5a80b84f7f0bcfcd9e430c6", "start_line": 41, "text": "syntax Exc      ::= \"NoExc\" | \"AssertionError\""}
{"category": "syntax", "end_line": 48, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:42", "keyword": "syntax", "sha256": "685995afea92f7983186637b0b323215636a78beaf857c9c5d9582e2d28b7e26", "start_line": 42, "text": "syntax RetState ::= \"noRet\" | retV(Val)\n\n  // ==== configuration =======================================================\n  // The builtins namespace is a real scope at reserved location -1 (the bottom of every\n  // chain; scopeLoc only allocates >=1, so -1 never collides). The module scope (loc 0)\n  // has it as parent, so an unbound name resolves there last — exactly LEGB. `int`/`str`\n  // resolve to their type objects; any local/global binding shadows them via normal lookup."}
{"category": "configuration", "end_line": 67, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:49", "keyword": "configuration", "sha256": "e2bc35df6cb3b1922e3e46df0539895bea0bb55b8539e807227cf58569bcb650", "start_line": 49, "text": "configuration\n    <k>       #loadAll($PGM:Module) </k>\n    <env>     0 </env>\n    <scopes>   0     |-> scope(.Map, parent(-1))\n              -1    |-> builtinsScope </scopes>\n    <scopeLoc> 1 </scopeLoc>\n    <heap>    .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack>   .List </stack>\n    <ret>     noRet </ret>\n    <exc>     NoExc </exc>\n    <exit-code exit=\"\"> 0 </exit-code>\n\n  // ==== heap allocation (constructed lists become objects) ==================\n  // Cons-form emission with a freshness guard (the heap-list-probe discipline:\n  // an update-form H[N <- _] never re-normalizes symbolically). heapLoc is\n  // monotonic — it does NOT wind back at #pop: returned lists escape by ref.\n  // A bare list(VS) Val stays legal (read-only inputs in claims flow unboxed);\n  // only CONSTRUCTORS in program syntax allocate."}
{"category": "syntax:function,total", "end_line": 68, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:68", "keyword": "syntax", "sha256": "3338ad77ca0049a96dfe1eaeb080b4c41c6be71c0c3b3f745920c8a3f234cec0", "start_line": 68, "text": "syntax Bool ::= isRefV(Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 69, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:69", "keyword": "rule", "sha256": "d1ee5822bc201a81a9e53ef1bbc95650db6ed80ae67b039110a99e1244587cac", "start_line": 69, "text": "rule isRefV(ref(_:Int)) => true"}
{"category": "rule:owise", "end_line": 74, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:70", "keyword": "rule", "sha256": "202bffa7e5d274457c7b92e7694913f9a54efa7d6fd1457c5e28fae343537000", "start_line": 70, "text": "rule isRefV(_:Val)      => false [owise]\n\n  // closure cells (Python-faithful capture): the heap holds cellV(V); a\n  // cellRef surfacing as the k-redex reads through (lookup is the only use —\n  // cellRefs never escape to user-visible values)"}
{"category": "syntax", "end_line": 75, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:75", "keyword": "syntax", "sha256": "21cd98225d729d9f7639156eab6a245a02779ba0a9d8b21e9f073c0ff26f5274", "start_line": 75, "text": "syntax HeapVal ::= cellV(Val)"}
{"category": "syntax:function,total", "end_line": 76, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:76", "keyword": "syntax", "sha256": "a9d42f86eb00022dec3e226b09600aaa48f1a7be55f597845133e1bd191296a1", "start_line": 76, "text": "syntax Bool ::= isCellRef(Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 77, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:77", "keyword": "rule", "sha256": "d10f04444db1ef0234b6d965704225f982b943f5f876e0dd2b84ca6cb186d00d", "start_line": 77, "text": "rule isCellRef(cellRef(_:Int)) => true"}
{"category": "rule:owise", "end_line": 84, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:78", "keyword": "rule", "sha256": "a851114a10aa46045278d37e3a1c48b50b52ae854ea9d359a33628eb58d436b3", "start_line": 78, "text": "rule isCellRef(_:Val)          => false [owise]\n  // k-top deref for cell-bound reads surfacing INSIDE the annotated frame\n  // (AugAssign's in-place read and friends). The \"$cells\" guard keeps this\n  // DECIDABLY inapplicable in plain frames — an unguarded rule lets the\n  // prover narrow abstract k-top values into cellRef junk (probed on\n  // 26-remove-duplicates). Cross-frame reads (a comprehension closure\n  // reading the enclosing function's cellvar) deref inside #look instead."}
{"category": "rule:priority(40)", "end_line": 94, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:85", "keyword": "rule", "sha256": "0761cf7dfc0237219e5805e6d49f0bc3da1703f77abe946d17094d8fb1b1bac5", "start_line": 85, "text": "rule <k> cellRef(H:Int) => V ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\n       <heap> ... H |-> cellV(V:Val) ... </heap>\n       requires \"$cells\" in_keys(M)\n       [priority(40)]\n\n  // write through a cell (Assign / #bindP / #bindTgt dispatch here on\n  // cell-bound names)\n  // a keyword argument cools to a TAGGED value (consumed by kw-aware builtins)"}
{"category": "syntax", "end_line": 95, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:95", "keyword": "syntax", "sha256": "746e63785a2ae3973e73c46044dcbf4775ebee34152fc64892f4b2b789edd83f", "start_line": 95, "text": "syntax Val ::= kwV(String, Val)"}
{"category": "syntax", "end_line": 96, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:96", "keyword": "syntax", "sha256": "7135e0a28684c3f959f5c02eb7518d47f4673034587be13a48e55a135987f6e2", "start_line": 96, "text": "syntax KItem ::= #kwTag(String)"}
{"category": "rule:ordinary", "end_line": 97, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:97", "keyword": "rule", "sha256": "28d46dc1bd55f13049d73cb2bf63a371dc732d4615cdd181645239d4cd5ad537", "start_line": 97, "text": "rule <k> KwArg(N:String, E:Expr) => E ~> #kwTag(N) ... </k>"}
{"category": "rule:ordinary", "end_line": 99, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:98", "keyword": "rule", "sha256": "13f6503b186565614de3baa258da595b8b7609cbca2b9a1a745257ceb05d9473", "start_line": 98, "text": "rule <k> V:Val ~> #kwTag(N:String) => kwV(N, V) ... </k>\n       requires notBool isKwV(V)"}
{"category": "syntax:function,total", "end_line": 100, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:100", "keyword": "syntax", "sha256": "50eabe9c99f38505cf15bf77c4bac9a1abf4f9b87d14b59bbda92ca979979de1", "start_line": 100, "text": "syntax Bool ::= isKwV(Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 101, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:101", "keyword": "rule", "sha256": "a1fa116710bde2dcf3a27bef6ca7c778952c610ebf3439a992d3b795fbb62980", "start_line": 101, "text": "rule isKwV(kwV(_:String, _:Val)) => true"}
{"category": "rule:owise", "end_line": 105, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:102", "keyword": "rule", "sha256": "642168558795264f7d331bc9412849304c52b0da8d17a56c701d59812f5e5d58", "start_line": 102, "text": "rule isKwV(_:Val)                => false [owise]\n\n  // the frame marker carries the CONCRETE cellvar list, so cell-write dispatch\n  // decides by pnMember even over an abstract frame rest (no prover branching)"}
{"category": "syntax", "end_line": 106, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:106", "keyword": "syntax", "sha256": "2285105441dce6794397ba48377014495fd03df64a341f3f38c98e1db8345f5a", "start_line": 106, "text": "syntax Val ::= cellsMark(ParamNames)"}
{"category": "syntax:function", "end_line": 107, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:107", "keyword": "syntax", "sha256": "ad2441054e7f455725e98d81f76b8fd041bc9ed222e5edb98a5c94ae3839523b", "start_line": 107, "text": "syntax ParamNames ::= cellsOf(Val) [function]"}
{"category": "rule:ordinary", "end_line": 108, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:108", "keyword": "rule", "sha256": "dadd75df53218bc9b64ef8083a5cfdd2ce110ae737320172b4df3b74b49eca81", "start_line": 108, "text": "rule cellsOf(cellsMark(CVS:ParamNames)) => CVS"}
{"category": "syntax:function,total", "end_line": 109, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:109", "keyword": "syntax", "sha256": "009b993788c253193b1ce0fa5b061697c6440e0788701a19869c9dab19663ff9", "start_line": 109, "text": "syntax Bool ::= pnMember(String, ParamNames) [function, total]"}
{"category": "rule:ordinary", "end_line": 110, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:110", "keyword": "rule", "sha256": "09cb69784187ad842a22036b322bfc6e6b6b0146b07291ed5538c1ed17fb12c8", "start_line": 110, "text": "rule pnMember(_:String, .ParamNames) => false"}
{"category": "rule:ordinary", "end_line": 112, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:111", "keyword": "rule", "sha256": "40d3ebcbac2e7febec8650f7bec5a04bd4771fe1fb00b0029b055011e68b54d1", "start_line": 111, "text": "rule pnMember(X:String, (P:String, R:ParamNames)) => X ==String P orBool pnMember(X, R)"}
{"category": "syntax", "end_line": 113, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:113", "keyword": "syntax", "sha256": "16af91ae25382cf323fddfcbec2b15113bb7f8e345fc838cffd3d1ea5c48402f", "start_line": 113, "text": "syntax KItem ::= #cellW(Val, Val)"}
{"category": "rule:ordinary", "end_line": 116, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:114", "keyword": "rule", "sha256": "23d2c2b6c8f343e577bcdca8e7dc488fe3bbb6326a22649852051d981cdc7f8c", "start_line": 114, "text": "rule <k> #cellW(cellRef(H:Int), V:Val) => .K ... </k>\n       <heap> ... H |-> cellV(_:Val => V) ... </heap>"}
{"category": "syntax", "end_line": 117, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:117", "keyword": "syntax", "sha256": "584583182d331f98087811d087ed974611dcaaa6ed451b3fd1b5669db71ee113", "start_line": 117, "text": "syntax KItem ::= #alloc(Val)"}
{"category": "rule:ordinary", "end_line": 123, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:118", "keyword": "rule", "sha256": "62f7bc59f34e6912fbe212f36c2dc2ca5446e8459840f1e3b1a9d910df2c478d", "start_line": 118, "text": "rule <k> #alloc(V:Val) => ref(N) ... </k>\n       <heap>    H:Map => (N |-> V) H </heap>\n       <heapLoc> N:Int => N +Int 1 </heapLoc>\n       requires notBool N in_keys(H)\n\n  // ==== module load + statement sequencing =================================="}
{"category": "syntax", "end_line": 124, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:124", "keyword": "syntax", "sha256": "40d32b5e1ad10747cb8671cd1e429ea97d3cec1b42c0c51a97d4025ea15ec9d2", "start_line": 124, "text": "syntax KItem ::= #loadAll(Module)"}
{"category": "rule:ordinary", "end_line": 125, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:125", "keyword": "rule", "sha256": "831765b43e688fdf9dd2115a4b939d436706f8c21eec8d12ae58d63460ea64ff", "start_line": 125, "text": "rule <k> #loadAll(Module(SS:Stmts)) => SS ... </k>"}
{"category": "rule:ordinary", "end_line": 126, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:126", "keyword": "rule", "sha256": "622f8afd49106ea25b456b94d71e2824694c02f0a7d79c85174ee0f6bbe5aeb2", "start_line": 126, "text": "rule <k> (S:Stmt SS:Stmts):Stmts => S ~> SS ... </k>"}
{"category": "rule:ordinary", "end_line": 129, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:127", "keyword": "rule", "sha256": "2f770e15c4044ee8233ec4db08c52015ffecbf5bd1fe1aea90364ec7ec92a19a", "start_line": 127, "text": "rule <k> .Stmts => .K ... </k>\n\n  // ==== Name lookup (walk the scope chain; builtins live in the -1 scope) ===="}
{"category": "syntax", "end_line": 130, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:130", "keyword": "syntax", "sha256": "68e17b99a979fdef8ca37621b96b2adca48d3919ab7f1ce5c01b65d55df1c936", "start_line": 130, "text": "syntax KItem ::= #look(String, Int)"}
{"category": "rule:ordinary", "end_line": 131, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:131", "keyword": "rule", "sha256": "4dffd7efda704b7e4db7e1c647183217805e651df4dafc5254bb00bf2fdc9cbe", "start_line": 131, "text": "rule <k> Name(X:String) => #look(X, L) ... </k> <env> L:Int </env>"}
{"category": "rule:ordinary", "end_line": 144, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:132", "keyword": "rule", "sha256": "e184a5f152d03841a98d3c6b722344abaa72717b22dc613d43ce36884ef1a719", "start_line": 132, "text": "rule <k> #look(X:String, L:Int) => {M[X]}:>Val ... </k>\n       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>\n       requires X in_keys(M)\n  // a SYNTACTICALLY cell-bound name reads through the heap cell AT THE\n  // LOOKUP (higher priority beats the plain return above on concrete cell\n  // bindings; abstract claim values take the plain rule unchanged) — this\n  // covers cross-frame cell reads (a comprehension closure reading the\n  // enclosing function's cellvar) without a narrowing-prone k-top redex\n  // guarded on the FOUND frame's DECLARED cellvars (pnMember over the\n  // cellsMark): decidable for every concrete frame pin — plain frames and\n  // non-cell names prune outright, so an abstract looked-up value never\n  // drags a narrowing cellV heap match along (probed on 5-intersperse and\n  // Q4's abstract `numbers` in the annotated frame)"}
{"category": "rule:priority(40)", "end_line": 151, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:145", "keyword": "rule", "sha256": "d28eff3f5eef355bda25dd1df05ee07373b3a386f2aefa92e8f6b2b0c2acffb7", "start_line": 145, "text": "rule <k> #look(X:String, L:Int) => V ... </k>\n       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>\n       <heap> ... H |-> cellV(V:Val) ... </heap>\n       requires X in_keys(M) andBool \"$cells\" in_keys(M)\n        andBool pnMember(X, cellsOf({M[\"$cells\"]}:>Val))\n        andBool {M[X]}:>Val ==K cellRef(H)\n       [priority(40)]"}
{"category": "rule:ordinary", "end_line": 156, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:152", "keyword": "rule", "sha256": "658277d4aceef536b5a4d90e05a6552455093b48f5d921387ddb97c1c95f1027", "start_line": 152, "text": "rule <k> #look(X:String, L:Int) => #look(X, P) ... </k>\n       <scopes> ... L |-> scope(M:Map, parent(P:Int)) ... </scopes>\n       requires notBool (X in_keys(M))\n\n  // the ONE predefined builtins scope (the -1 frame; claims write `-1 |-> builtinsScope`)"}
{"category": "syntax:function,total", "end_line": 157, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:157", "keyword": "syntax", "sha256": "9b3d6c932d97b99118d4972bbf495e2ee6ff961180c802cfc8002ac45499bc28", "start_line": 157, "text": "syntax Scope ::= \"builtinsScope\" [function, total]"}
{"category": "rule:ordinary", "end_line": 184, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:158", "keyword": "rule", "sha256": "21d16701c784a5f12c34eddc909aea82cdb85c70891a633359c0aff547d7db39", "start_line": 158, "text": "rule builtinsScope\n    => scope(.Map [ \"len\"    <- builtinV(\"len\")    ]\n                  [ \"set\"    <- builtinV(\"set\")    ]\n                  [ \"sum\"    <- builtinV(\"sum\")    ]\n                  [ \"abs\"    <- builtinV(\"abs\")    ]\n                  [ \"min\"    <- builtinV(\"min\")    ]\n                  [ \"max\"    <- builtinV(\"max\")    ]\n                  [ \"ord\"    <- builtinV(\"ord\")    ]\n                  [ \"chr\"    <- builtinV(\"chr\")    ]\n                  [ \"range\"  <- builtinV(\"range\")  ]\n                  [ \"all\"    <- builtinV(\"all\")    ]\n                  [ \"any\"    <- builtinV(\"any\")    ]\n                  [ \"zip\"    <- builtinV(\"zip\")    ]\n                  [ \"isinstance\" <- builtinV(\"isinstance\") ]\n                  [ \"sorted\" <- builtinV(\"sorted\") ]\n                  [ \"list\"   <- builtinV(\"list\")   ]\n                  [ \"round\"  <- builtinV(\"round\")  ]\n                  [ \"bin\"    <- builtinV(\"bin\")    ]\n                  [ \"enumerate\" <- builtinV(\"enumerate\") ]\n                  [ \"map\"    <- builtinV(\"map\")    ]\n                  [ \"eval\"   <- builtinV(\"eval\")   ]\n                  [ \"int\"    <- typeV(\"int\")       ]\n                  [ \"str\"    <- typeV(\"str\")       ]\n                  [ \"float\"  <- typeV(\"float\")     ], root)\n\n  // ==== argument/element evaluation: ONE left-to-right loop, tagged by destination ==\n  // (list/tuple literals and calls all use it; modules extend ApplyK with their tags)"}
{"category": "syntax", "end_line": 185, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:185", "keyword": "syntax", "sha256": "0cd464bb92d6fbd9eb61627b5a302e8d1419fb60845e61f594eea37e505361c0", "start_line": 185, "text": "syntax ApplyK ::= toCall(Val)"}
{"category": "syntax", "end_line": 188, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:186", "keyword": "syntax", "sha256": "c232da225c21257d3e3e5301aef8e23b76581b13cf947d492e5ced64affbe4f3", "start_line": 186, "text": "syntax KItem  ::= #evalArgs(Exprs, Vals, ApplyK)\n                  | #evalArgCont(Exprs, Vals, ApplyK)\n                  | #applyK(ApplyK, Vals)"}
{"category": "rule:ordinary", "end_line": 189, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:189", "keyword": "rule", "sha256": "e7135690e7262635dd0046776e8c65541a1b0e833e52085a497abbab22a24c0d", "start_line": 189, "text": "rule <k> #evalArgs((A:Expr, REST:Exprs), ACC:Vals, K:ApplyK) => A ~> #evalArgCont(REST, ACC, K) ... </k>"}
{"category": "rule:ordinary", "end_line": 190, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:190", "keyword": "rule", "sha256": "aee090561fe2fc878e5922d8eeb9c6b759e0948f8c972db0ec10627a3d75e10a", "start_line": 190, "text": "rule <k> V:Val ~> #evalArgCont(REST:Exprs, ACC:Vals, K:ApplyK) => #evalArgs(REST, appendVal(ACC, V), K) ... </k>"}
{"category": "rule:ordinary", "end_line": 193, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:191", "keyword": "rule", "sha256": "e7fbc45b04805627e12ea76cc99b091b64ae88516ec41a90c15b3aa7d8bdbb1b", "start_line": 191, "text": "rule <k> #evalArgs(.Exprs, ACC:Vals, K:ApplyK) => #applyK(K, ACC) ... </k>\n\n  // ==== Int / Bool / None literals =========================================="}
{"category": "rule:ordinary", "end_line": 194, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:194", "keyword": "rule", "sha256": "818c9ba8a73e602de648f77c3229c3f329451dcf093b7645d31a7a84c3599b2d", "start_line": 194, "text": "rule <k> Int(I:Int)   => I ... </k>"}
{"category": "rule:ordinary", "end_line": 195, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:195", "keyword": "rule", "sha256": "28c8aac589ebebb882cb3f121a4017a8cda85f190a8992d2ffac23ca9f423675", "start_line": 195, "text": "rule <k> Bool(B:Bool) => B ... </k>"}
{"category": "rule:ordinary", "end_line": 198, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:196", "keyword": "rule", "sha256": "7195ee1b98085a4f9c8967c6b5200d05de9ba5e9d8afcbed08cdd94a66fe6b59", "start_line": 196, "text": "rule <k> NoneVal      => noneV ... </k>\n\n  // ==== truthy (If, Assert, BoolOp, IfExp, not, While) ======================"}
{"category": "syntax:function", "end_line": 199, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:199", "keyword": "syntax", "sha256": "c70b8b2eac36b927650e58afbb71b054cb3bbaaf272b95c269b562f4cca551bf", "start_line": 199, "text": "syntax Bool ::= truthy(Val) [function]"}
{"category": "rule:ordinary", "end_line": 200, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:200", "keyword": "rule", "sha256": "7df2db27abe2bddbaf2012fde2fd417c9300f92bb110f9f0f57ead33438100da", "start_line": 200, "text": "rule truthy(B:Bool)          => B"}
{"category": "rule:ordinary", "end_line": 201, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:201", "keyword": "rule", "sha256": "2154ca8be6a6c52c1f1d9aa7a06756ccada3d35f965cb0abc1069f5d6be034bb", "start_line": 201, "text": "rule truthy(noneV)           => false"}
{"category": "rule:ordinary", "end_line": 202, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:202", "keyword": "rule", "sha256": "1b473f75237380fd17ad8c4c377e30e0b7ed7f59e5e9a1b861ab14ca3a913ad8", "start_line": 202, "text": "rule truthy(I:Int)           => I =/=Int 0"}
{"category": "rule:ordinary", "end_line": 203, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:203", "keyword": "rule", "sha256": "a91f771de331765a4efa538f1b1a623c45a9af0bf80bae74890843d6bc699a28", "start_line": 203, "text": "rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)"}
{"category": "rule:ordinary", "end_line": 204, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:204", "keyword": "rule", "sha256": "3f51557103001e18db4f5e551e814890251d325b27865a35e07502fb990704fe", "start_line": 204, "text": "rule truthy(list(V:ValSeq))  => notBool (V ==K .ValSeq)"}
{"category": "rule:ordinary", "end_line": 207, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:205", "keyword": "rule", "sha256": "f61663b6407182f3b1d3e5600557eea58ee2e3018ad9462566cf5b6404ae5b76", "start_line": 205, "text": "rule truthy(tuple(V:ValSeq)) => notBool (V ==K .ValSeq)\n\n  // ==== extensible operator dispatch (cases added by the construct modules) =="}
{"category": "syntax:function", "end_line": 208, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:208", "keyword": "syntax", "sha256": "033e06a0df360023103ed08a603eabfd6380cbe8e9c08fab1c5934a329b75545", "start_line": 208, "text": "syntax Val  ::= applyUn(String, Val) [function]"}
{"category": "syntax:function", "end_line": 209, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:209", "keyword": "syntax", "sha256": "c8b918102a85371f3652892358425c0aa1e5c7993f300034a09dbb4a38938e1c", "start_line": 209, "text": "syntax Val  ::= applyBin(String, Val, Val) [function]"}
{"category": "syntax:function", "end_line": 212, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:210", "keyword": "syntax", "sha256": "44f7baada40be6cf505be54b321ad028db4c46d1b8f2735d8e5a36d1d444f485", "start_line": 210, "text": "syntax Bool ::= applyCmp(String, Val, Val) [function]\n\n  // ==== shared list helpers ================================================="}
{"category": "syntax:function,total", "end_line": 213, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:213", "keyword": "syntax", "sha256": "763cc5fd6e1abb711ac3c786c23d3e9954aa228ccb4012bbd586bfaa5ba4fadd", "start_line": 213, "text": "syntax Vals ::= appendVal(Vals, Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 214, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:214", "keyword": "rule", "sha256": "4114893ecb98b10a768f572ff91ec2594b5d93b13bb81a72ec772cf7d3617142", "start_line": 214, "text": "rule appendVal(.Vals, V:Val)              => V , .Vals"}
{"category": "rule:ordinary", "end_line": 216, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:215", "keyword": "rule", "sha256": "32c06da8db7ce479decbfea30e47ec9519c040489a2e343f796088549abd3219", "start_line": 215, "text": "rule appendVal((V0:Val, VS:Vals), V:Val)  => V0 , appendVal(VS, V)"}
{"category": "syntax:function,total", "end_line": 217, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:217", "keyword": "syntax", "sha256": "7a97605e841a91e05985c61a14143af9e0f2bfbec36c5c9bd36fc15daf540b31", "start_line": 217, "text": "syntax ValSeq ::= vals2valSeq(Vals) [function, total]"}
{"category": "rule:ordinary", "end_line": 218, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:218", "keyword": "rule", "sha256": "24991725fdf96eeb102b7a752c3f6290b01a61425afed33134bfee5c0dbf4b48", "start_line": 218, "text": "rule vals2valSeq(.Vals)            => .ValSeq"}
{"category": "rule:ordinary", "end_line": 222, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:219", "keyword": "rule", "sha256": "48a8823f92c99273c7ab2d194fc173d99a48783f7ad88355c986e9870ebd9eab", "start_line": 219, "text": "rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))\n\n  // ==== shared sequence length (len / summaries across many modules) ========\n  // (positional access valSeqAt/intSeqAt + normIdx live in subscript.k)"}
{"category": "syntax:function,total", "end_line": 223, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:223", "keyword": "syntax", "sha256": "dd74bc995871facfa87ea8ae2ecfdd41abc06296c877effa234a3e72b3d18dc0", "start_line": 223, "text": "syntax Int ::= vsLen(ValSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 224, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:224", "keyword": "rule", "sha256": "c4769d54f3a019ae842229751e1e88da00dafaec92e5271f6cf3afe5f2b358ac", "start_line": 224, "text": "rule vsLen(.ValSeq)                => 0"}
{"category": "rule:ordinary", "end_line": 226, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:225", "keyword": "rule", "sha256": "c1a7ece3322915ef794297b5c75a3938b56e9ca672ce0ac429021ecfc9588598", "start_line": 225, "text": "rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)"}
{"category": "syntax:function,total", "end_line": 227, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:227", "keyword": "syntax", "sha256": "cefb7744efac56151396c7b5c9ca84f75f0488d25c2614a59448994443d13dc2", "start_line": 227, "text": "syntax Int ::= isLen(IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 228, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:228", "keyword": "rule", "sha256": "4447a9050e81e7570cbeefb3978bf42af63df2ae5f074940c0df064ea9056169", "start_line": 228, "text": "rule isLen(.IntSeq)                => 0"}
{"category": "rule:ordinary", "end_line": 232, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:229", "keyword": "rule", "sha256": "90686a986cd0bc8e3f557a51ee06be76df7486764351425b58d929156bd5f0f7", "start_line": 229, "text": "rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)\n\n  // in-bounds positional write (list subscript-assign); OOB leaves the seq unchanged\n  // (valid programs write in-bounds — mirrors valSeqAt's total-but-underspecified stance)"}
{"category": "syntax:function,total", "end_line": 233, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:233", "keyword": "syntax", "sha256": "912ccb9ff6dc8632845252b58a055e68a16f0a9118db220d4bf8ee08fca756ff", "start_line": 233, "text": "syntax ValSeq ::= setVSAt(ValSeq, Int, Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 234, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:234", "keyword": "rule", "sha256": "1e6118f46d4ffef8676219dc4c30d1de500331e0466cd3d5a1e849890048c032", "start_line": 234, "text": "rule setVSAt(.ValSeq, _:Int, _:Val)               => .ValSeq"}
{"category": "rule:ordinary", "end_line": 235, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:235", "keyword": "rule", "sha256": "41d35046504fa6ce6dcbdf1a5dd40d48d23b094091362c44fb4e0765b67d36ce", "start_line": 235, "text": "rule setVSAt(vCons(_:Val, S:ValSeq), 0, V:Val)    => vCons(V, S)"}
{"category": "rule:ordinary", "end_line": 237, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:236", "keyword": "rule", "sha256": "915d44202de0b2e0119d0715cd87df6f2f8e2cdab4778eb19984962e30595f30", "start_line": 236, "text": "rule setVSAt(vCons(W:Val, S:ValSeq), I:Int, V:Val) => vCons(W, setVSAt(S, I -Int 1, V))\n       requires I >Int 0"}
{"category": "rule:ordinary", "end_line": 239, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:238", "keyword": "rule", "sha256": "8935316ee3141a1897586fa4583996fca321ce1cc972d0a80498d97f09ddfa5f", "start_line": 238, "text": "rule setVSAt(VS:ValSeq, I:Int, _:Val)             => VS\n       requires I <Int 0"}
{"category": "endmodule", "end_line": 240, "file": "reference-semantics/semantics/core.k", "id": "reference-semantics/semantics/core.k:240", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 240, "text": "endmodule"}
{"category": "module", "end_line": 13, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:13", "keyword": "module", "sha256": "d48a71acd5079caa73133115bb3e9ea52d81522d0be0b88a52e09f8978d7cb34", "start_line": 13, "text": "module MPY-DICT"}
{"category": "imports", "end_line": 14, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:14", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 14, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 15, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:15", "keyword": "imports", "sha256": "8ad41781e06e91093b117ccd78f6f10180a840cf3b4adaa62547edd340b26acc", "start_line": 15, "text": "imports MPY-ITER"}
{"category": "imports", "end_line": 16, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:16", "keyword": "imports", "sha256": "09fe9e0706aef859710b0c5447f1427e859a1a9e9660b612e310bb91d51ec923", "start_line": 16, "text": "imports MPY-METHODS"}
{"category": "imports", "end_line": 19, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:17", "keyword": "imports", "sha256": "0ea5b225fc26a3a66e6cf92c3e70543257c4a64794228d113ee7fc401579c222", "start_line": 17, "text": "imports MPY-LIST\n\n  // dict as PARALLEL ordered key/value ValSeqs (same length; keys distinct)."}
{"category": "syntax", "end_line": 22, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:20", "keyword": "syntax", "sha256": "826e3280028f5fcc02ebca5ce2c66e3d29b2542e2055d9a89facdad752ffff47", "start_line": 20, "text": "syntax Val ::= dictV(ValSeq, ValSeq)\n\n  // ==== DictExpr: {k: v, ...} literal. Eval each key then value, left to right, insert-with-dedup."}
{"category": "syntax", "end_line": 25, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:23", "keyword": "syntax", "sha256": "64f4d467c14c831eae241a160cd60e145b3966d37cf015a6ea9c4bba757d6397", "start_line": 23, "text": "syntax KItem ::= #dictAcc(Entries, ValSeq, ValSeq)\n                 | #dictKey(Expr, Entries, ValSeq, ValSeq)\n                 | #dictVal(Val, Entries, ValSeq, ValSeq)"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:26", "keyword": "rule", "sha256": "338fc50af3ecaf41411e972eea5912fd2bee7938e1bff6720692e99e334f5fba", "start_line": 26, "text": "rule <k> DictExpr(ES:Entries) => #dictAcc(ES, .ValSeq, .ValSeq) ... </k>"}
{"category": "rule:ordinary", "end_line": 27, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:27", "keyword": "rule", "sha256": "f86750e273ef1a0279ecf6f61df440040bd682375694808504d2126cfe14f07d", "start_line": 27, "text": "rule <k> #dictAcc(.Entries, KS:ValSeq, VS:ValSeq) => dictV(KS, VS) ... </k>"}
{"category": "rule:ordinary", "end_line": 29, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:28", "keyword": "rule", "sha256": "9f430a15316b78fa77b66b8089590b47d4a6367bb8da9a41fa95e5b6220d751c", "start_line": 28, "text": "rule <k> #dictAcc((Entry(K:Expr, V:Expr), REST:Entries), KS:ValSeq, VS:ValSeq)\n        => K ~> #dictKey(V, REST, KS, VS) ... </k>"}
{"category": "rule:ordinary", "end_line": 31, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:30", "keyword": "rule", "sha256": "a93b464aec895c1a58429c568dbe24afa3231566e7c1086c77e714842ff2bcf0", "start_line": 30, "text": "rule <k> KV:Val ~> #dictKey(V:Expr, REST:Entries, KS:ValSeq, VS:ValSeq)\n        => V ~> #dictVal(KV, REST, KS, VS) ... </k>"}
{"category": "rule:ordinary", "end_line": 36, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:32", "keyword": "rule", "sha256": "00dda07614fe0839cf0dc1817365e800dbeb405ba1b5bbde27db43f813339647", "start_line": 32, "text": "rule <k> VV:Val ~> #dictVal(KV:Val, REST:Entries, KS:ValSeq, VS:ValSeq)\n        => #dictAcc(REST, dPutK(KS, KV), dPutV(KS, VS, KV, VV)) ... </k>\n\n  // insert-with-dedup helpers (concrete Val key equality via ==K). [total] so buildFold over a dict is\n  // total (its #Ceil is #Top) — needed when a symbolic proof carries a built dict as a config value."}
{"category": "syntax:function,total", "end_line": 37, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:37", "keyword": "syntax", "sha256": "b1e4066d0d4acd3c64f38780d7aea22278b1bd58e3672a864ff09a7970008697", "start_line": 37, "text": "syntax Bool ::= dHasKey(ValSeq, Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 38, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:38", "keyword": "rule", "sha256": "f3d38f90b6d26dc45d79986b13facf7530eafacaa8de5697e96db10abe32da86", "start_line": 38, "text": "rule dHasKey(.ValSeq, _:Val)                => false"}
{"category": "rule:ordinary", "end_line": 39, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:39", "keyword": "rule", "sha256": "eabe6c23e4590055c3731fa5660d690a04202f7673eac1eaaaeee979517e0230", "start_line": 39, "text": "rule dHasKey(vCons(A:Val, _:ValSeq), K:Val) => true          requires A ==K K"}
{"category": "rule:ordinary", "end_line": 42, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:40", "keyword": "rule", "sha256": "3bb5b75311540bc0fcf255e460551b89ee0c46c04c399450f6f26516dd7bcf66", "start_line": 40, "text": "rule dHasKey(vCons(A:Val, R:ValSeq), K:Val) => dHasKey(R, K) requires notBool (A ==K K)\n\n  // dPutK: KS unchanged if K already present, else append K (keep-first-position)."}
{"category": "syntax:function,total", "end_line": 43, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:43", "keyword": "syntax", "sha256": "97a166c788d6c17c0b8006da462d27de937efebd9f79b1205190771acf087932", "start_line": 43, "text": "syntax ValSeq ::= dPutK(ValSeq, Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 44, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:44", "keyword": "rule", "sha256": "f36012828a09a78faf4f69389e959d07b5cd1fe783ee707076c2e375ab7ac30d", "start_line": 44, "text": "rule dPutK(KS:ValSeq, K:Val) => KS                                  requires dHasKey(KS, K)"}
{"category": "rule:owise", "end_line": 48, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:45", "keyword": "rule", "sha256": "78fc4478c49c00777f2a3f769a2a83740a799ba7e3ab8ce5bcb35d281381e4ac", "start_line": 45, "text": "rule dPutK(KS:ValSeq, K:Val) => valSeqConcat(KS, vCons(K, .ValSeq)) requires notBool dHasKey(KS, K)\n\n  // dPutV: parallel to KS — set the value at K's position if present, else append V at the end. The\n  // [owise] catch-all covers the degenerate mismatched-length case (never reached for a well-formed dict)."}
{"category": "syntax:function,total", "end_line": 49, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:49", "keyword": "syntax", "sha256": "a03444397cd8f766654c7e3d429905bf2ef672ac16a3d38004b0ccea0cdf26dc", "start_line": 49, "text": "syntax ValSeq ::= dPutV(ValSeq, ValSeq, Val, Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 51, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:50", "keyword": "rule", "sha256": "d9941fcd23425a6922a77cbd5f7ee319152c2ef5d268e6d12bcf9daffeb4058a", "start_line": 50, "text": "rule dPutV(vCons(A:Val, _:ValSeq), vCons(_:Val, VR:ValSeq), K:Val, V:Val)  => vCons(V, VR)\n       requires A ==K K"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:52", "keyword": "rule", "sha256": "a4c617d1ea5da922d1fbae6f5fedf975c88570260b80630331a5c1645b1a83ae", "start_line": 52, "text": "rule dPutV(vCons(A:Val, KR:ValSeq), vCons(B:Val, VR:ValSeq), K:Val, V:Val) => vCons(B, dPutV(KR, VR, K, V))\n       requires notBool (A ==K K)"}
{"category": "rule:owise", "end_line": 57, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:54", "keyword": "rule", "sha256": "168bc4fec2e7acaa3f7010388a43eb6ced9e8301b45f97b313980c07f8fadb54", "start_line": 54, "text": "rule dPutV(_KS:ValSeq, VS:ValSeq, _K:Val, V:Val) => valSeqConcat(VS, vCons(V, .ValSeq)) [owise]\n\n  // ==== dict methods ========================================================\n  // d.keys() -> a FRESH list object of the ordered keys (k-cell: it allocates)."}
{"category": "rule:priority(40)", "end_line": 62, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:58", "keyword": "rule", "sha256": "ae08a29df6d5b608ae5a98968bb4df6988d97fce34b1ca625202ea94e1234df3", "start_line": 58, "text": "rule <k> #applyK(toCall(boundMethodV(dictV(KS:ValSeq, _:ValSeq), \"keys\")), .Vals)\n        => #alloc(list(KS)) ... </k>\n       [priority(40)]\n\n  // ==== dict subscript READ: d[k] (assoc lookup; KeyError is out of subset) =="}
{"category": "rule:ordinary", "end_line": 63, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:63", "keyword": "rule", "sha256": "2e626ca3a0e5e06a889a4d97406f45d3659087e9efdac24f9037c7b021b61d25", "start_line": 63, "text": "rule applyIndexD(dictV(KS:ValSeq, VS:ValSeq), K:Val) => dGet(KS, VS, K)"}
{"category": "syntax:function", "end_line": 64, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:64", "keyword": "syntax", "sha256": "391e4efc55553a5e694ebaf97dfe170a4a08c60841a9c39d8958cc9545fc76f2", "start_line": 64, "text": "syntax Val ::= applyIndexD(Val, Val) [function]"}
{"category": "rule:priority(45)", "end_line": 69, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:65", "keyword": "rule", "sha256": "e0f03a6fec15ab44a973a887ec7068753389bf4cb782bf47cf1f530b193676dd", "start_line": 65, "text": "rule <k> Subscript(dictV(KS:ValSeq, VS:ValSeq), K:Val) => applyIndexD(dictV(KS, VS), K) ... </k>\n       [priority(45)]\n\n  // ==== dict subscript-assign: d[k] = v (insert/update in place) =============\n  // Only for a LOCAL dict variable X (the current scope holds it). Reuses dPutK/dPutV."}
{"category": "syntax:function", "end_line": 70, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:70", "keyword": "syntax", "sha256": "31f3f6e36c107f354fb41ccfe3cf3cd21869f226637d592051299da74c7cdd2f", "start_line": 70, "text": "syntax Val ::= dictSet(Val, Val, Val) [function]"}
{"category": "rule:ordinary", "end_line": 75, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:71", "keyword": "rule", "sha256": "6e30641aeead8d7fb04643604ef97b5a4b900ac0bee231a0dcd6a0fa6f3cb606", "start_line": 71, "text": "rule dictSet(dictV(KS:ValSeq, VS:ValSeq), K:Val, V:Val) => dictV(dPutK(KS, K), dPutV(KS, VS, K, V))\n\n  // RHS evaluates first (Assign strictness), then the key. Dispatch on the scope\n  // value: a bare dict updates in the scope (dicts stay values); a ref (a heap\n  // list — or a heap dict later) writes the heap in place."}
{"category": "syntax", "end_line": 76, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:76", "keyword": "syntax", "sha256": "882d796d0a94e03af3316fa067c35a7bb135e1dabf98f9924be715aa1ac35f94", "start_line": 76, "text": "syntax KItem ::= #dsetK(String, Val)"}
{"category": "rule:ordinary", "end_line": 77, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:77", "keyword": "rule", "sha256": "4bbcefc7ea06cb0a74912a7e16f43ad37f5b0a3ee22b17219012676ff5ecc3ec", "start_line": 77, "text": "rule <k> Assign(Subscript(Name(X:String), K:Expr), VV:Val) => K ~> #dsetK(X, VV) ... </k>"}
{"category": "rule:ordinary", "end_line": 81, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:78", "keyword": "rule", "sha256": "883ae84d25cdedfdea11d70562f8e22e006a2a5dc2423ebe966cb8d6ec5852cf", "start_line": 78, "text": "rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => .K ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ X <- dictSet({M[X]}:>Val, KV, VV) ], _) ... </scopes>\n       requires X in_keys(M) andBool notBool isRefV({M[X]}:>Val)"}
{"category": "rule:ordinary", "end_line": 85, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:82", "keyword": "rule", "sha256": "1174d6494b10ef91ece094a7ea18b2945f1b7dd5891316a4f67d582457a20537", "start_line": 82, "text": "rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => #dsetV({M[X]}:>Val, KV, VV) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\n       requires X in_keys(M) andBool isRefV({M[X]}:>Val)"}
{"category": "syntax", "end_line": 86, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:86", "keyword": "syntax", "sha256": "cfa9005e176ec5b6079b3150ca401aac1e59264561f6ebcd7e0052b2e1767255", "start_line": 86, "text": "syntax KItem ::= #dsetV(Val, Val, Val)"}
{"category": "rule:ordinary", "end_line": 89, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:87", "keyword": "rule", "sha256": "0585a796d9ac39e1a1a131d2549d56dc691a40a17d4be0584f679d4eec1f5fdd", "start_line": 87, "text": "rule <k> #dsetV(ref(H:Int), I:Int, VV:Val) => .K ... </k>\n       <heap> ... H |-> list(VS:ValSeq => setVSAt(VS, normIdxD(I, vsLen(VS)), VV)) ... </heap>\n  // negative-index normalization local to the write (subscript.k's is not imported here)"}
{"category": "syntax:function,total", "end_line": 90, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:90", "keyword": "syntax", "sha256": "1c5323bfd95cd3cb664adcf89003e8bd1edfe2eefca936b6e63553bd03ca2a9b", "start_line": 90, "text": "syntax Int ::= normIdxD(Int, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 91, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:91", "keyword": "rule", "sha256": "0abef29e8f8da45ba95f3511946081b6cef106a4c9e3e63341c6bced6b9e49fb", "start_line": 91, "text": "rule normIdxD(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0"}
{"category": "rule:ordinary", "end_line": 94, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:92", "keyword": "rule", "sha256": "2452403fa2f8022ba73eb7d552a781eaaa26f6d15188fdfecc984f60ff13ad11", "start_line": 92, "text": "rule normIdxD(I:Int, _:Int)   => I          requires I >=Int 0\n\n  // ==== dict == (order-insensitive: same size + same key->value pairs) ======="}
{"category": "rule:ordinary", "end_line": 96, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:95", "keyword": "rule", "sha256": "79a01618ecfd9f8d7fc93fa0d5d833f17a7b08bb316adcb90ff76a89d933102b", "start_line": 95, "text": "rule applyCmp(\"==\", dictV(KS1:ValSeq, VS1:ValSeq), dictV(KS2:ValSeq, VS2:ValSeq))\n    => (vsLen(KS1) ==Int vsLen(KS2)) andBool dSubset(KS1, VS1, KS2, VS2)"}
{"category": "syntax:function", "end_line": 97, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:97", "keyword": "syntax", "sha256": "24fc648b5bc5f1b87c0b113593503702ac899646af3d254d731c3d4e5ffc61ae", "start_line": 97, "text": "syntax Bool ::= dSubset(ValSeq, ValSeq, ValSeq, ValSeq) [function]"}
{"category": "rule:ordinary", "end_line": 98, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:98", "keyword": "rule", "sha256": "38e9c64805ad38d661e4e7c2f33c2399b182a2711ca7bc122061e762bf8474ee", "start_line": 98, "text": "rule dSubset(.ValSeq, .ValSeq, _:ValSeq, _:ValSeq) => true"}
{"category": "rule:ordinary", "end_line": 100, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:99", "keyword": "rule", "sha256": "673f8778545fe2dc3ebc8f7a4c927b599323891908a2318ef4ac32b92c6b5da1", "start_line": 99, "text": "rule dSubset(vCons(K:Val, KR:ValSeq), vCons(V:Val, VR:ValSeq), KS2:ValSeq, VS2:ValSeq)\n    => dHasKey(KS2, K) andBool (dGet(KS2, VS2, K) ==K V) andBool dSubset(KR, VR, KS2, VS2)"}
{"category": "syntax:function", "end_line": 101, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:101", "keyword": "syntax", "sha256": "10fc860d42b91939926b7ddbf4700aa5545a6754489e58ab76b66d3af6d482a5", "start_line": 101, "text": "syntax Val ::= dGet(ValSeq, ValSeq, Val) [function]"}
{"category": "rule:ordinary", "end_line": 102, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:102", "keyword": "rule", "sha256": "acfc6ddc0886716d9b79918a7c7f6424360de4c9a50503e726ed6be80bed45f8", "start_line": 102, "text": "rule dGet(vCons(A:Val, _:ValSeq), vCons(B:Val, _:ValSeq), K:Val) => B                requires A ==K K"}
{"category": "rule:ordinary", "end_line": 103, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:103", "keyword": "rule", "sha256": "6971aef401036e46e2e9df3628917fcccf09751381df9430a38bd33284b82f27", "start_line": 103, "text": "rule dGet(vCons(A:Val, KR:ValSeq), vCons(_:Val, VR:ValSeq), K:Val) => dGet(KR, VR, K) requires notBool (A ==K K)"}
{"category": "endmodule", "end_line": 104, "file": "reference-semantics/semantics/dict.k", "id": "reference-semantics/semantics/dict.k:104", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 104, "text": "endmodule"}
{"category": "module", "end_line": 14, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:14", "keyword": "module", "sha256": "987e02a6cef8bdd2686721dff327d4cb12a797c3844db8cddae4120ffb1035cc", "start_line": 14, "text": "module MPY-FLOAT"}
{"category": "imports", "end_line": 15, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:15", "keyword": "imports", "sha256": "ee018db6efb00ffdd01d59dac03e43be2192505ed7049d1c693197e018cbc088", "start_line": 15, "text": "imports MPY-OPERATORS"}
{"category": "imports", "end_line": 16, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:16", "keyword": "imports", "sha256": "513b07985ad1b60ab1fc94f4a08021dd25a5b0aa218c3a975ce281a00395ddfa", "start_line": 16, "text": "imports MPY-BUILTINS"}
{"category": "imports", "end_line": 19, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:17", "keyword": "imports", "sha256": "bae2d61e71ac0aaab29ad017caa99518c6af66a7964e54a5a1b20a3ea998a9d3", "start_line": 17, "text": "imports FLOAT\n\n  // Float is a value; the float literal evaluates to the K Float."}
{"category": "syntax", "end_line": 20, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:20", "keyword": "syntax", "sha256": "f206c1a5ca92a9a762be3e97c9ab44ee4f72fa5d071bcb8ed4a0aa3b63cb0d34", "start_line": 20, "text": "syntax Val ::= Float"}
{"category": "rule:ordinary", "end_line": 23, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:21", "keyword": "rule", "sha256": "5f69d506a2d5fd65cb3a7b3ca2f171c2eaed7a4cf74a39b61a4ccc60d7d04f10", "start_line": 21, "text": "rule <k> Float(F:Float) => F ... </k>\n\n  // Int / float true division. OPAQUE for kprove (no-evaluators); concrete for krun."}
{"category": "syntax:function,total,symbol", "end_line": 24, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:24", "keyword": "syntax", "sha256": "f4862b43f760e695beb6727198d6b0bd1486a20fc8ba5871213b46541b77f8dd", "start_line": 24, "text": "syntax Float ::= intFloatDiv(Int, Float) [function, total, symbol(intFloatDiv), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:25", "keyword": "rule", "sha256": "be877732fabb34242222ef0e2c0fb64b761eece113ce9bbb8de0aeaf9ce64fca", "start_line": 25, "text": "rule intFloatDiv(I:Int, F:Float) => Int2Float(I, 53, 11) /Float F [concrete]"}
{"category": "rule:ordinary", "end_line": 29, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:27", "keyword": "rule", "sha256": "2b3dd72cce4adc70368f2990e9e98ea2b3be85370f4880299d87bb0f753f47c0", "start_line": 27, "text": "rule applyBin(\"/\", I:Int, F:Float) => intFloatDiv(I, F)\n\n  // Int / Int true division (Python: always a float). OPAQUE for kprove; concrete for krun."}
{"category": "syntax:function,total,symbol", "end_line": 30, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:30", "keyword": "syntax", "sha256": "3c7cef5fcc77371d3654505ea7b198e0da74e7585aa45aca562525a59a63923b", "start_line": 30, "text": "syntax Float ::= divII(Int, Int) [function, total, symbol(divII), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 31, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:31", "keyword": "rule", "sha256": "111c0e226da2c6738b3f8b5cec611cb2e1bd07bb09ee056045a36d3d6475f6c7", "start_line": 31, "text": "rule divII(I1:Int, I2:Int) => Int2Float(I1, 53, 11) /Float Int2Float(I2, 53, 11) [concrete]"}
{"category": "rule:ordinary", "end_line": 36, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:32", "keyword": "rule", "sha256": "c5332a3a15f13a6ee8b421b0e4f7cc15ec6c840578422e37e6fac4a116884bec", "start_line": 32, "text": "rule applyBin(\"/\", I1:Int, I2:Int) => divII(I1, I2)\n\n  // float % float (e.g. `number % 1.0` = the fractional part). OPAQUE for kprove, concrete for\n  // krun. Python's float `%` is floor-based: a % b = a - floor(a/b)*b (K's %Float is IEEE\n  // remainder, which differs — 3.5 %Float 1.0 = -0.5 vs Python 0.5 — so it is NOT used)."}
{"category": "syntax:function,total,symbol", "end_line": 37, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:37", "keyword": "syntax", "sha256": "26237ef2edca0917e0569815f93385224bbda0fd4d6cc2bc1419ffa94686c7ee", "start_line": 37, "text": "syntax Float ::= floatMod(Float, Float) [function, total, symbol(floatMod), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 38, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:38", "keyword": "rule", "sha256": "f0f814d6f918a67f2d1dbe84073ffb15231fd42083b328d44910ae370821cf9c", "start_line": 38, "text": "rule floatMod(F1:Float, F2:Float) => F1 -Float (floorFloat(F1 /Float F2) *Float F2) [concrete]"}
{"category": "rule:ordinary", "end_line": 42, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:39", "keyword": "rule", "sha256": "73fc56e481402d794ecb03c60d674eb9e421dd968e9dfd78659541b4f3c19544", "start_line": 39, "text": "rule applyBin(\"%\", F1:Float, F2:Float) => floatMod(F1, F2)\n\n  // float equality — for concrete krun asserts (e.g. `area == 7.5`); the FLOAT.eq hook is fine on\n  // concrete floats. kprove proofs return floats structurally and do not compare them."}
{"category": "rule:ordinary", "end_line": 43, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:43", "keyword": "rule", "sha256": "ce568cc9c8ae662d6f5e89cde017ce3384e06a48825731fd774752aac5f9ec52", "start_line": 43, "text": "rule applyCmp(\"==\", F1:Float, F2:Float) => F1 ==Float F2"}
{"category": "rule:ordinary", "end_line": 49, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:44", "keyword": "rule", "sha256": "656997b6da3ec32665a5952849f6cfa9395b54ca5c824ee857d9dde80b6d70b8", "start_line": 44, "text": "rule applyCmp(\"!=\", F1:Float, F2:Float) => notBool (F1 ==Float F2)\n\n  // float `<` and abs — OPAQUE for kprove ([no-evaluators], so a SYMBOLIC float compare stays an\n  // uninterpreted Bool a proof case-splits on — a SINGLE compare per branch, not a nonlinear cascade),\n  // [concrete] for krun. Additive, sort-disjoint from the Int rules. (has_close_elements: the pairwise\n  // `abs(a-b) < t` proximity test.)"}
{"category": "syntax:function,total,symbol", "end_line": 50, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:50", "keyword": "syntax", "sha256": "9675cd9c7a220914d5e1ac6fd0cea726b7800b8a4e4cc8e3827dab3f1a64e40a", "start_line": 50, "text": "syntax Bool ::= floatLt(Float, Float) [function, total, symbol(floatLt), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 51, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:51", "keyword": "rule", "sha256": "2a8121a4d91fa2828c6f00490d4170198174d13b61570468b22f0e42ac18f7ad", "start_line": 51, "text": "rule floatLt(F1:Float, F2:Float) => F1 <Float F2 [concrete]"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:52", "keyword": "rule", "sha256": "c073d8cee697c56f18c7591e4e094442f43e33bde7d1f323b558237de1ec7fb4", "start_line": 52, "text": "rule applyCmp(\"<\", F1:Float, F2:Float) => floatLt(F1, F2)"}
{"category": "syntax:function,total,symbol", "end_line": 54, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:54", "keyword": "syntax", "sha256": "12a1faf44cdf66e02b407c54180b85b62a91e0e15d77be9b9e9206ab00a1f8b4", "start_line": 54, "text": "syntax Float ::= absF(Float) [function, total, symbol(absF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 55, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:55", "keyword": "rule", "sha256": "b00b8066b8e964faa56e75d261ba728c14a5849399b0c29bf1f32b48ec5eedec", "start_line": 55, "text": "rule absF(F:Float) => absFloat(F) [concrete]"}
{"category": "rule:ordinary", "end_line": 60, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:56", "keyword": "rule", "sha256": "113b8162e51cb766e0c41c3d6106ecb7c5436779cd9bc1a17c8c6be6239170be", "start_line": 56, "text": "rule applyBuiltin(\"abs\", F:Float, .Vals) => absF(F)\n\n  // ==== math.ceil ===========================================================\n  // `import X` is a no-op (we intercept the specific math functions syntactically; `math` itself is\n  // never bound as a value)."}
{"category": "rule:ordinary", "end_line": 64, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:61", "keyword": "rule", "sha256": "db9d46716def1c5b4a4f42016fa2b2cbb557ddac3984a915131c14a7395bf01f", "start_line": 61, "text": "rule <k> Import(_:String) => .K ... </k>\n\n  // math.ceil(x): ceiling to an int. Intercepted at the Call BEFORE `math` is looked up (higher\n  // priority than the generic Attribute/method dispatch in call.k)."}
{"category": "syntax", "end_line": 65, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:65", "keyword": "syntax", "sha256": "b46507b52502d69ecd0b28bf99b17d6364e01f0ddfcc14834ec07fcafceb1f78", "start_line": 65, "text": "syntax KItem ::= \"#mathCeil\""}
{"category": "rule:priority(40)", "end_line": 66, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:66", "keyword": "rule", "sha256": "6731784767d29f257a6e457e28ea5da072a6cdb279502efc86711cf04b62290e", "start_line": 66, "text": "rule <k> Call(Attribute(Name(\"math\"), \"ceil\"), (E:Expr, .Exprs)) => E ~> #mathCeil ... </k> [priority(40)]"}
{"category": "rule:ordinary", "end_line": 69, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:67", "keyword": "rule", "sha256": "5d044531e6be6dee55c68d1faa84d6194b938d3e4d36ab27793ef41fd1a36f58", "start_line": 67, "text": "rule <k> V:Val ~> #mathCeil => ceilF(V) ... </k>\n\n  // math.floor(x) — same interception shape as math.ceil"}
{"category": "syntax", "end_line": 70, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:70", "keyword": "syntax", "sha256": "7182dabba36769b189524af8593436518f2392b447983f4d2982643bf6ca9f6d", "start_line": 70, "text": "syntax KItem ::= \"#mathFloor\""}
{"category": "rule:priority(40)", "end_line": 71, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:71", "keyword": "rule", "sha256": "8c6ed970676f93aca0ee122cdf288baef386e0d235737cd00ef0972d35539986", "start_line": 71, "text": "rule <k> Call(Attribute(Name(\"math\"), \"floor\"), (E:Expr, .Exprs)) => E ~> #mathFloor ... </k> [priority(40)]"}
{"category": "rule:ordinary", "end_line": 72, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:72", "keyword": "rule", "sha256": "65f0f3138bd4041429d19744d61cd2ab7ae411553229ea4ff3dbdd7b1684509a", "start_line": 72, "text": "rule <k> V:Val ~> #mathFloor => floorFI(V) ... </k>"}
{"category": "syntax:function,total,symbol", "end_line": 73, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:73", "keyword": "syntax", "sha256": "bb414e98ce7ce75743ab373e70347f41d2f4ee07ff45aa6580a15966550ccb50", "start_line": 73, "text": "syntax Int ::= floorFI(Val) [function, total, symbol(floorFI)]"}
{"category": "rule:ordinary", "end_line": 74, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:74", "keyword": "rule", "sha256": "f37a1802fdeee0b242ca9cf3b6c9aa81ad4b780976503f54a17cd1e19e86c629", "start_line": 74, "text": "rule floorFI(I:Int)   => I                        [concrete]"}
{"category": "rule:ordinary", "end_line": 77, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:75", "keyword": "rule", "sha256": "2e62e747aeae220223f2b473acb59e9d48d9725d0e965525fd1ca55bfbd12bfd", "start_line": 75, "text": "rule floorFI(F:Float) => Float2Int(floorFloat(F)) [concrete]\n\n  // bare floor/ceil (bound by `from math import floor, ceil`)"}
{"category": "rule:ordinary", "end_line": 78, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:78", "keyword": "rule", "sha256": "4f4ffc4a6628c5740fa8ade1d51ba965ebb75a520f0dee556a13f5d680058c82", "start_line": 78, "text": "rule applyBuiltin(\"floor\", V:Val, .Vals) => floorFI(V)"}
{"category": "rule:ordinary", "end_line": 81, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:79", "keyword": "rule", "sha256": "0abe88ce75d2f8942765f5f0c43a0ecb269955a3d15b5682b07882d62fed03e7", "start_line": 79, "text": "rule applyBuiltin(\"ceil\",  V:Val, .Vals) => ceilF(V)\n\n  // math.pow(x, y) — a two-arg interception onto powF (ints promote)"}
{"category": "syntax", "end_line": 82, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:82", "keyword": "syntax", "sha256": "533ce20926848a932096268dcc8d19a7affc311f363f07719348863d48fca5b4", "start_line": 82, "text": "syntax KItem ::= #mathPow1(Expr) | #mathPow2(Val)"}
{"category": "rule:priority(40)", "end_line": 83, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:83", "keyword": "rule", "sha256": "841a8e8cad165e0baad70da3e93cd4b35a8e56bf91952b8dd9176dfbcc1fd55a", "start_line": 83, "text": "rule <k> Call(Attribute(Name(\"math\"), \"pow\"), (E1:Expr, E2:Expr, .Exprs)) => E1 ~> #mathPow1(E2) ... </k> [priority(40)]"}
{"category": "rule:ordinary", "end_line": 84, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:84", "keyword": "rule", "sha256": "fbcd9d035631ab0d6584bf5ad7e731663ca5f847f66a3e2c17f88cc6b8b62f59", "start_line": 84, "text": "rule <k> V1:Val ~> #mathPow1(E2:Expr) => E2 ~> #mathPow2(V1) ... </k>"}
{"category": "rule:ordinary", "end_line": 85, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:85", "keyword": "rule", "sha256": "f6ee2424cb4d2471040a4178c7b5055007746c94dd088fd5fe295808e4d9ba56", "start_line": 85, "text": "rule <k> V2:Val ~> #mathPow2(V1:Val) => powF(toF(V1), toF(V2)) ... </k>"}
{"category": "syntax:function,total,symbol", "end_line": 86, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:86", "keyword": "syntax", "sha256": "5506be32391181835ed65a75fc4654d2c25ffe352ec3115b3d137d28f495bf73", "start_line": 86, "text": "syntax Float ::= toF(Val) [function, total, symbol(toF)]"}
{"category": "rule:ordinary", "end_line": 87, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:87", "keyword": "rule", "sha256": "f04a867ac1b6f31890bbd9c3da33c260a5bf6e593c9549ffebfe24e7fb297368", "start_line": 87, "text": "rule toF(F:Float) => F        [concrete]"}
{"category": "rule:ordinary", "end_line": 92, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:88", "keyword": "rule", "sha256": "0c49af5c120845e096e99d0de46a14374e1e2322a1fa6b85c00a957ec7dabd4e", "start_line": 88, "text": "rule toF(I:Int)   => intToF(I) [concrete]\n\n  // ceilF: math.ceil as an Int. TOTAL (K trusts it; a symbolic list element stays opaque for\n  // kprove — structural). [concrete] so the Int2Float/ceilFloat hooks only run for krun (llvm).\n  // Matches Python incl. negatives: ceil(-2.4) = -2 = Float2Int(ceilFloat(-2.4))."}
{"category": "syntax:function,total,symbol", "end_line": 93, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:93", "keyword": "syntax", "sha256": "52675460312419ec876e710ac18206472fab07ac74a094bd6caa45e1ec0027ed", "start_line": 93, "text": "syntax Int ::= ceilF(Val) [function, total, symbol(ceilF)]"}
{"category": "rule:ordinary", "end_line": 94, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:94", "keyword": "rule", "sha256": "e87663a7197556888ef4e288cb4cfc4639ea666312d88b5a920ea666150c4852", "start_line": 94, "text": "rule ceilF(I:Int)   => I                       [concrete]"}
{"category": "rule:ordinary", "end_line": 98, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:95", "keyword": "rule", "sha256": "f2b3d212256e2986d92a9edb76ad96359f5d9fa6364c3ac01e79f80c523cd573", "start_line": 95, "text": "rule ceilF(F:Float) => Float2Int(ceilFloat(F)) [concrete]\n\n  // unary minus on a float (e.g. the literal -2.4 = UnaryOp(\"-\", Float(2.4))). Concrete for krun;\n  // proofs use symbolic elements, never a float literal."}
{"category": "rule:ordinary", "end_line": 102, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:99", "keyword": "rule", "sha256": "8adae69ff624dc243c729433e1afacc3924d21e06c05d63e1df11d928950d3b4", "start_line": 99, "text": "rule applyUn(\"-\", F:Float) => 0.0 -Float F\n\n  // ---- float - / / / + (OPAQUE for kprove [no-evaluators], concrete for krun) — for float-list\n  // element maps (x - lo) / (hi - lo). Mirror intFloatDiv: additive, sort-disjoint from the Int rules."}
{"category": "syntax:function,total,symbol", "end_line": 103, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:103", "keyword": "syntax", "sha256": "bd9289f118f1e03fa252abe44e6e1c934c9f1ae015ed8e3fbd4299e7f5c26494", "start_line": 103, "text": "syntax Float ::= subF(Float, Float) [function, total, symbol(subF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 104, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:104", "keyword": "rule", "sha256": "12f60d082454bd2b0805c3344bf9ab377c453dcd7d5e9c5b42bf333f5d57edb8", "start_line": 104, "text": "rule subF(F1:Float, F2:Float) => F1 -Float F2 [concrete]"}
{"category": "rule:ordinary", "end_line": 106, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:105", "keyword": "rule", "sha256": "600f864e0d4d5f3dfe90085090dd70db36baef4d5567bb1aaeef349e99da06db", "start_line": 105, "text": "rule applyBin(\"-\", F1:Float, F2:Float) => subF(F1, F2)"}
{"category": "syntax:function,total,symbol", "end_line": 107, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:107", "keyword": "syntax", "sha256": "91e03f2ac9cf90dce2b3ea5859601973196a3504474c25eb80ec2b21be7ffe57", "start_line": 107, "text": "syntax Float ::= divF(Float, Float) [function, total, symbol(divF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 108, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:108", "keyword": "rule", "sha256": "26654b7bcf191054c73e2246eb8532b4bd2b7243dfed90f8a8981b961ece60f8", "start_line": 108, "text": "rule divF(F1:Float, F2:Float) => F1 /Float F2 [concrete]"}
{"category": "rule:ordinary", "end_line": 110, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:109", "keyword": "rule", "sha256": "ef46ce780b55860627d49bf1404f7f29e15fe39b90cd069c1022d94b833e6290", "start_line": 109, "text": "rule applyBin(\"/\", F1:Float, F2:Float) => divF(F1, F2)"}
{"category": "syntax:function,total,symbol", "end_line": 111, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:111", "keyword": "syntax", "sha256": "2398531263a97112a72ea01928b6cf992a9f2306201ba7f3170536661db96622", "start_line": 111, "text": "syntax Float ::= addF(Float, Float) [function, total, symbol(addF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 112, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:112", "keyword": "rule", "sha256": "3f45f37477446abb30b2cf45ac67d631b0bf8d597d6dfac37aebfb9494124574", "start_line": 112, "text": "rule addF(F1:Float, F2:Float) => F1 +Float F2 [concrete]"}
{"category": "rule:ordinary", "end_line": 114, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:113", "keyword": "rule", "sha256": "034cf2b7767250b7e2e63618d233e160da84cceb00705122dacb2b21d37f9641", "start_line": 113, "text": "rule applyBin(\"+\", F1:Float, F2:Float) => addF(F1, F2)"}
{"category": "syntax:function,total,symbol", "end_line": 115, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:115", "keyword": "syntax", "sha256": "4e0d8b299c8516d20b15b89833ed1e760641f6fa8ecc8d0069cf24fa804c9c98", "start_line": 115, "text": "syntax Float ::= mulF(Float, Float) [function, total, symbol(mulF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 116, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:116", "keyword": "rule", "sha256": "46a5b95d90aada84fb908fcccfac676a044aaa6b9f76e95e95f4c620acb0278b", "start_line": 116, "text": "rule mulF(F1:Float, F2:Float) => F1 *Float F2 [concrete]"}
{"category": "rule:ordinary", "end_line": 118, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:117", "keyword": "rule", "sha256": "7bc5c419eaac104d84561c37f738d88864aedb6a8f4fe53efafeaf9213747acd", "start_line": 117, "text": "rule applyBin(\"*\", F1:Float, F2:Float) => mulF(F1, F2)"}
{"category": "syntax:function,total,symbol", "end_line": 119, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:119", "keyword": "syntax", "sha256": "47a046af374b7333041c374f5e55c9c816bb128c6ec2b425f34da68716e8cea3", "start_line": 119, "text": "syntax Float ::= powF(Float, Float) [function, total, symbol(powF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 120, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:120", "keyword": "rule", "sha256": "88f0b7d20137e8c6cc512845c967e98e804b4966da1b2ef8eb07db88bae5b8fa", "start_line": 120, "text": "rule powF(F1:Float, F2:Float) => F1 ^Float F2 [concrete]"}
{"category": "rule:ordinary", "end_line": 124, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:121", "keyword": "rule", "sha256": "002c7a3afe52957a9a76f2c61a3d67399275193ac497f010141bc9fbcdf06a0c", "start_line": 121, "text": "rule applyBin(\"**\", F1:Float, F2:Float) => powF(F1, F2)\n\n  // ---- the remaining comparisons (gtF promoted from find_zero — its summaries\n  //      case-split on the atom; >= / <= derive from the two opaque compares) ----"}
{"category": "syntax:function,total,symbol", "end_line": 125, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:125", "keyword": "syntax", "sha256": "9fdcc02ab4ee99148d3e6503c0421d6d40e4c43f206fecef2bf271337906a0c0", "start_line": 125, "text": "syntax Bool ::= gtF(Float, Float) [function, total, symbol(gtF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 126, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:126", "keyword": "rule", "sha256": "088703ce3653f7358ab35922090d8b0c6380e7bdabc390bab127a4fb756fe9f9", "start_line": 126, "text": "rule gtF(F1:Float, F2:Float) => F1 >Float F2 [concrete]"}
{"category": "rule:ordinary", "end_line": 127, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:127", "keyword": "rule", "sha256": "f0c90e2b4e5cbdf34b0352a19734bcc2a25cb81685fd75e763790b8b32f4b573", "start_line": 127, "text": "rule applyCmp(\">\",  F1:Float, F2:Float) => gtF(F1, F2)"}
{"category": "rule:ordinary", "end_line": 128, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:128", "keyword": "rule", "sha256": "5eb9299eb06c3b1274bb92813d634fba7250df5e932e6fbd4f10219082b4e26d", "start_line": 128, "text": "rule applyCmp(\">=\", F1:Float, F2:Float) => notBool floatLt(F1, F2)"}
{"category": "rule:ordinary", "end_line": 131, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:129", "keyword": "rule", "sha256": "813036c506b92e1cb9343fd02b0982e8b1250870905c9253bbcb69c18ced603d", "start_line": 129, "text": "rule applyCmp(\"<=\", F1:Float, F2:Float) => notBool gtF(F1, F2)\n\n  // ---- mixed Int/Float operators promote the Int side (n ** 0.5 etc.) ----"}
