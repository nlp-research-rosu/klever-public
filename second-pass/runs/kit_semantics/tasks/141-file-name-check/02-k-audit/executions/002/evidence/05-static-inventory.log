{"category": "rule:ordinary", "end_line": 35, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:35", "keyword": "rule", "sha256": "d19a2af0b57612a4a42fa18792f97042a5ef7759c0c609eca004ae8dd1a4afb3", "start_line": 35, "text": "rule <k> #applyK(toCall(builtinV(\"list\")), (str(CS:IntSeq), .Vals))   => #alloc(list(charsOf(CS))) ... </k>"}
{"category": "syntax:function,total", "end_line": 36, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:36", "keyword": "syntax", "sha256": "01aff6eecdd49ca279cb4378e0ba39cf9a5e1da377c6bda52586943e73543839", "start_line": 36, "text": "syntax ValSeq ::= charsOf(IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 37, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:37", "keyword": "rule", "sha256": "18e5f857c9437096279ec2b4e4f3bf20712174c985f8be831a7e064273d4b28e", "start_line": 37, "text": "rule charsOf(.IntSeq)                => .ValSeq"}
{"category": "rule:ordinary", "end_line": 40, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:38", "keyword": "rule", "sha256": "1bc93a13a365a05ece63b293f4d2b122105adb223384d6bbd2a41a21936118f8", "start_line": 38, "text": "rule charsOf(iCons(C:Int, R:IntSeq)) => vCons(str(iCons(C, .IntSeq)), charsOf(R))\n\n  // ==== set(str) — distinct character codes ================================="}
{"category": "rule:ordinary", "end_line": 43, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:41", "keyword": "rule", "sha256": "3a64e28bd3ad2a27ef770e5a4cfd3780f3d929a4835263a3f9e0c07ad5f35313", "start_line": 41, "text": "rule applyBuiltin(\"set\", str(CS:IntSeq), .Vals) => setV(dedupCodes(CS))\n\n  // ==== abs(int) ============================================================"}
{"category": "rule:ordinary", "end_line": 46, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:44", "keyword": "rule", "sha256": "2461aa2aed3789246b208123da4a4f50069013a259f991819b82df4f966833b6", "start_line": 44, "text": "rule applyBuiltin(\"abs\", I:Int, .Vals) => absInt(I)\n\n  // ==== sum(iterable) — one #iterNext fold; intOf = int value of an int/bool =="}
{"category": "syntax", "end_line": 47, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:47", "keyword": "syntax", "sha256": "8faa5250ed2b829b2c57a81708a1e0b4c8fc5683bff408e6fae108fe3ec4e60f", "start_line": 47, "text": "syntax KItem ::= #sumAcc(Iterable, Int) | #sumCont(Int)"}
{"category": "rule:ordinary", "end_line": 48, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:48", "keyword": "rule", "sha256": "cd531bdb9afa464c73c67f8946bbe64957682a3d5dd078d0bf22a556ccc572e6", "start_line": 48, "text": "rule <k> #sumAcc(IT:Iterable, ACC:Int) => #iterNext(IT) ~> #sumCont(ACC) ... </k>"}
{"category": "rule:ordinary", "end_line": 49, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:49", "keyword": "rule", "sha256": "74ff8e8be84218b889ef85b902de5efaea860b572c8a5da8306df05a1b3c4947", "start_line": 49, "text": "rule <k> #iterDone ~> #sumCont(ACC:Int) => ACC ... </k>"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:50", "keyword": "rule", "sha256": "3216ead685aa5370a65f5bafe7ee04e29df904ba74829cb47b0618825da4a5c7", "start_line": 50, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)\n        => #sumAcc(R, ACC +Int intOf(V)) ... </k>\n       requires isInt(V) orBool isBool(V)"}
{"category": "syntax:function", "end_line": 54, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:54", "keyword": "syntax", "sha256": "0355f95a50a6608682b1c8b9e304799a37a3ed6f4f6f81f8cc0d968f5ff678a4", "start_line": 54, "text": "syntax Int ::= intOf(Val) [function]"}
{"category": "rule:ordinary", "end_line": 55, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:55", "keyword": "rule", "sha256": "ec6a1865ddeceeb1356af42bd0644f42e721db83ff7aa5df01295cd1f3a2519e", "start_line": 55, "text": "rule intOf(I:Int)  => I"}
{"category": "rule:ordinary", "end_line": 58, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:56", "keyword": "rule", "sha256": "e91ba8bc0324b61732a057b06f981d2ef99aaf66c5385cde280ffca809b5828f", "start_line": 56, "text": "rule intOf(B:Bool) => #if B #then 1 #else 0 #fi\n\n  // ==== all / any (short-circuiting #iterNext folds) ========================"}
{"category": "syntax", "end_line": 59, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:59", "keyword": "syntax", "sha256": "ed695fa0c4dbae8a1436b754495b020fb468e206c2b6448c21a61316bf0da571", "start_line": 59, "text": "syntax KItem ::= #allAcc(Iterable) | \"#allCont\""}
{"category": "rule:ordinary", "end_line": 60, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:60", "keyword": "rule", "sha256": "e7fc3b9b3a8439566a4974be9e36608e65f380fca9cc34bcc9c6b41e522e9c16", "start_line": 60, "text": "rule <k> #allAcc(IT:Iterable) => #iterNext(IT) ~> #allCont ... </k>"}
{"category": "rule:ordinary", "end_line": 61, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:61", "keyword": "rule", "sha256": "b74e515d3e67d8a52e1d0a061bb0432a2bf1de1b43995cc280a0ee2003d49c36", "start_line": 61, "text": "rule <k> #iterDone ~> #allCont => true ... </k>"}
{"category": "rule:ordinary", "end_line": 63, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:62", "keyword": "rule", "sha256": "c7480ce5c2eb3eb3cf930d867643a2729be3cfcebc0649afc2d2d4a5daf30742", "start_line": 62, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #allCont => #allAcc(R) ... </k>\n       requires truthy(V)"}
{"category": "rule:ordinary", "end_line": 66, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:64", "keyword": "rule", "sha256": "d10dbb51af3218e338284652dfa0b076d7286d4367e49b9ac039449f8ff18bf5", "start_line": 64, "text": "rule <k> #iterYield(V:Val, _:Iterable) ~> #allCont => false ... </k>\n       requires notBool truthy(V)"}
{"category": "syntax", "end_line": 67, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:67", "keyword": "syntax", "sha256": "fbd45cd7894ab0316f890fc61b1b5354b41eabbba062394cbcbf820f53d00eb0", "start_line": 67, "text": "syntax KItem ::= #anyAcc(Iterable) | \"#anyCont\""}
{"category": "rule:ordinary", "end_line": 68, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:68", "keyword": "rule", "sha256": "ca3f3bc3212a4bde9db710ca67b9ff4f7372092a568008c9e263f36654c478be", "start_line": 68, "text": "rule <k> #anyAcc(IT:Iterable) => #iterNext(IT) ~> #anyCont ... </k>"}
{"category": "rule:ordinary", "end_line": 69, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:69", "keyword": "rule", "sha256": "c0ee3d29de0f584789682596e1516d301ee7f3cd73ca05694f3f10b3a978063a", "start_line": 69, "text": "rule <k> #iterDone ~> #anyCont => false ... </k>"}
{"category": "rule:ordinary", "end_line": 71, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:70", "keyword": "rule", "sha256": "3bc1ac77dc8af7beea8301485a9e885afa680e79861b77353c10e1dd6e72d8e3", "start_line": 70, "text": "rule <k> #iterYield(V:Val, _:Iterable) ~> #anyCont => true ... </k>\n       requires truthy(V)"}
{"category": "rule:ordinary", "end_line": 75, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:72", "keyword": "rule", "sha256": "b2842f1b6a85990297531546408ac1cdc71f5efd72e1e598e9c9c9f6d74f89c4", "start_line": 72, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #anyCont => #anyAcc(R) ... </k>\n       requires notBool truthy(V)\n\n  // ==== max / min over an iterable (#iterNext folds; first element seeds) ===="}
{"category": "syntax", "end_line": 76, "file": "reference-semantics/semantics/builtins.k", "id": "reference-semantics/semantics/builtins.k:76", "keyword": "syntax", "sha256": "e3461106d962a1af387b25dc9d0efaf45f25429c84e747320080d55a256fe3c6", "start_line": 76, "text": "syntax KItem ::= #maxAcc0(Iterable) | \"#maxCont0\" | #maxAcc(Iterable, Int) | #maxCont(Int)"}
