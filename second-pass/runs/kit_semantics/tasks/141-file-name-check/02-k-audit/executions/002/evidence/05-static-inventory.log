{"category": "rule:ordinary", "end_line": 133, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:133", "keyword": "rule", "sha256": "6353492521ad97f8b794ad6a43bd8fd197aa82dde113f341a78b56fbcebb6436", "start_line": 133, "text": "rule applyBin(\"**\", F:Float, I:Int) => powF(F, intToF(I))"}
