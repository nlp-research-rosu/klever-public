{"category": "rule:ordinary", "end_line": 147, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:147", "keyword": "rule", "sha256": "330ac8e38f2c5dc2e16493d9573956960ac5ac0f1aa2ec0b94a2bab7f4776709", "start_line": 147, "text": "rule applyCmp(\"!=\", F:Float, I:Int) => notBool eqF(F, intToF(I))"}
{"category": "rule:ordinary", "end_line": 148, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:148", "keyword": "rule", "sha256": "124e1c20285e928170f6978067d75c61b57350dd390ed37d5ef07002fb11005c", "start_line": 148, "text": "rule applyCmp(\"<\",  I:Int, F:Float) => floatLt(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 149, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:149", "keyword": "rule", "sha256": "37d0e64b69466241fa8e18d67df1c2ae2d0944a7347368b017009bc581634b47", "start_line": 149, "text": "rule applyCmp(\"<\",  F:Float, I:Int) => floatLt(F, intToF(I))"}
{"category": "rule:ordinary", "end_line": 150, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:150", "keyword": "rule", "sha256": "f4596c34e133989e1f1c10dd062f978fcf076d7210ba4033ada41cf7c3e7d1d6", "start_line": 150, "text": "rule applyCmp(\">\",  I:Int, F:Float) => gtF(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 153, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:151", "keyword": "rule", "sha256": "86a568c48c62273e274cd49e25301f329d01ab8c9e335100d4652c85b64da24b", "start_line": 151, "text": "rule applyCmp(\">\",  F:Float, I:Int) => gtF(F, intToF(I))\n\n  // ---- x == None (promoted from 137; `is` cases live in operators.k) ----"}
{"category": "rule:ordinary", "end_line": 154, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:154", "keyword": "rule", "sha256": "ed4df68a2d974fe706e71c86e88eb3e36801da78a3eaa8c2ecbaa51f6ced123c", "start_line": 154, "text": "rule applyCmp(\"==\", V:Val, noneV) => V ==K noneV"}
{"category": "rule:ordinary", "end_line": 159, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:155", "keyword": "rule", "sha256": "96baae3b14da3f2af648ecb61f5368281cab0c8fa9bb387130e02e518ed811ee", "start_line": 155, "text": "rule applyCmp(\"!=\", V:Val, noneV) => notBool (V ==K noneV)\n\n  // ---- float(str): decimal parse (promoted from 137's defined chain) ----\n  // digits '.' digits, optional leading '-'; concrete evaluation only (the\n  // symbolic side stays an opaque decStrToF term a proof case-splits on)."}
{"category": "syntax:function,total,symbol", "end_line": 160, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:160", "keyword": "syntax", "sha256": "588f5768440e82dbce509dc1072150d464064371a95ab449d306de6c8a1ab71d", "start_line": 160, "text": "syntax Float ::= decStrToF(IntSeq) [function, total, symbol(decStrToF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 161, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:161", "keyword": "rule", "sha256": "32ad68f36a3579ddde24fed9991e513dbe124c01fa42f3cf8d325c00724072e5", "start_line": 161, "text": "rule decStrToF(iCons(45, CS:IntSeq)) => 0.0 -Float decStrToF(CS) [concrete]"}
{"category": "rule:ordinary", "end_line": 164, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:162", "keyword": "rule", "sha256": "4eca371f8a9ee7251c6e73f3fe8c1ab52dc68366c1f7064338ae4d26ad29d980", "start_line": 162, "text": "rule decStrToF(CS:IntSeq)\n    => intToF(intPart(CS)) +Float (intToF(fracPart(CS)) /Float intToF(fracScale(CS)))\n       requires isLen(CS) >Int 0 andBool headIS(CS) =/=Int 45 [concrete]"}
{"category": "syntax:function", "end_line": 165, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:165", "keyword": "syntax", "sha256": "7ccb5a6fa421529eb4d84258e8892a126f17837c883f5f769a46302b9f415a77", "start_line": 165, "text": "syntax Int ::= headIS(IntSeq) [function]"}
{"category": "rule:ordinary", "end_line": 166, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:166", "keyword": "rule", "sha256": "87f97131d232c3b3fe63af84c485392eb5fa213372961692ad8be1d4e829b6be", "start_line": 166, "text": "rule headIS(iCons(C:Int, _:IntSeq)) => C"}
