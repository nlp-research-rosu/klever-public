{"category": "imports", "end_line": 7, "file": "verification.k", "id": "verification.k:4", "keyword": "imports", "sha256": "c5341dd6595a7a72cd6c3319cd3ccf62693193aa3715d86a0b2cd516b9f54692", "start_line": 4, "text": "imports MPY\n\n  // Parse-time alias for the exact body generated in solution.mpy.  This macro\n  // disappears before execution; every operation below executes in MPY."}
{"category": "syntax:macro", "end_line": 8, "file": "verification.k", "id": "verification.k:8", "keyword": "syntax", "sha256": "2081851fab24a49d79dc1d56f3b3ce25b1126f03b5fbf7eb204ee0f7144e955d", "start_line": 8, "text": "syntax Stmts ::= \"fileNameCheckBody\" [macro]"}
{"category": "rule:ordinary", "end_line": 101, "file": "verification.k", "id": "verification.k:9", "keyword": "rule", "sha256": "cbff671006b4db46cd780a3e0ebde57b1ea780d26423119679faf31e316858b0", "start_line": 9, "text": "rule fileNameCheckBody\n    => If(\n         Compare(\n           Call(Attribute(Name(\"file_name\"), \"count\"), Str(\".\")),\n           CmpOp(\"!=\", Int(1))),\n         Return(Str(\"No\")),\n         .Stmts)\n       If(\n         Compare(\n           Subscript(Name(\"file_name\"), Int(0)),\n           CmpOp(\n             \"not in\",\n             Str(\"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"))),\n         Return(Str(\"No\")),\n         .Stmts)\n       If(\n         UnaryOp(\n           \"not\",\n           BoolOp(\n             \"or\",\n             Compare(\n               Subscript(\n                 Name(\"file_name\"),\n                 Slice(UnaryOp(\"-\", Int(4)), NoBound, NoBound)),\n               CmpOp(\"==\", Str(\".txt\"))),\n             Compare(\n               Subscript(\n                 Name(\"file_name\"),\n                 Slice(UnaryOp(\"-\", Int(4)), NoBound, NoBound)),\n               CmpOp(\"==\", Str(\".exe\"))),\n             Compare(\n               Subscript(\n                 Name(\"file_name\"),\n                 Slice(UnaryOp(\"-\", Int(4)), NoBound, NoBound)),\n               CmpOp(\"==\", Str(\".dll\"))))),\n         Return(Str(\"No\")),\n         .Stmts)\n       If(\n         Compare(\n           BinOp(\n             \"+\",\n             BinOp(\n               \"+\",\n               BinOp(\n                 \"+\",\n                 BinOp(\n                   \"+\",\n                   BinOp(\n                     \"+\",\n                     BinOp(\n                       \"+\",\n                       BinOp(\n                         \"+\",\n                         BinOp(\n                           \"+\",\n                           BinOp(\n                             \"+\",\n                             Call(\n                               Attribute(Name(\"file_name\"), \"count\"),\n                               Str(\"0\")),\n                             Call(\n                               Attribute(Name(\"file_name\"), \"count\"),\n                               Str(\"1\"))),\n                           Call(\n                             Attribute(Name(\"file_name\"), \"count\"),\n                             Str(\"2\"))),\n                         Call(\n                           Attribute(Name(\"file_name\"), \"count\"),\n                           Str(\"3\"))),\n                       Call(\n                         Attribute(Name(\"file_name\"), \"count\"),\n                         Str(\"4\"))),\n                     Call(\n                       Attribute(Name(\"file_name\"), \"count\"),\n                       Str(\"5\"))),\n                   Call(\n                     Attribute(Name(\"file_name\"), \"count\"),\n                     Str(\"6\"))),\n                 Call(\n                   Attribute(Name(\"file_name\"), \"count\"),\n                   Str(\"7\"))),\n               Call(\n                 Attribute(Name(\"file_name\"), \"count\"),\n                 Str(\"8\"))),\n             Call(\n               Attribute(Name(\"file_name\"), \"count\"),\n               Str(\"9\"))),\n           CmpOp(\">\", Int(3))),\n         Return(Str(\"No\")),\n         .Stmts)\n       Return(Str(\"Yes\"))\n\n  // Mathematical summaries used only to state the claim partitions."}
{"category": "syntax:function,total", "end_line": 102, "file": "verification.k", "id": "verification.k:102", "keyword": "syntax", "sha256": "9e58700388e6b01ed6f39b81a6e8b0f6ab2dacf0de50bd93cd0bd48294b58bd9", "start_line": 102, "text": "syntax Int ::= decimalDigitCount(IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 114, "file": "verification.k", "id": "verification.k:103", "keyword": "rule", "sha256": "973e41e21c918c3eb9f4a49bae26ea8a52772abd7ba9ae52ec5960481c17630c", "start_line": 103, "text": "rule decimalDigitCount(CS)\n    => cntSub(CS, strToCodes(\"0\"))\n       +Int cntSub(CS, strToCodes(\"1\"))\n       +Int cntSub(CS, strToCodes(\"2\"))\n       +Int cntSub(CS, strToCodes(\"3\"))\n       +Int cntSub(CS, strToCodes(\"4\"))\n       +Int cntSub(CS, strToCodes(\"5\"))\n       +Int cntSub(CS, strToCodes(\"6\"))\n       +Int cntSub(CS, strToCodes(\"7\"))\n       +Int cntSub(CS, strToCodes(\"8\"))\n       +Int cntSub(CS, strToCodes(\"9\"))"}
{"category": "syntax:function,total", "end_line": 115, "file": "verification.k", "id": "verification.k:115", "keyword": "syntax", "sha256": "24d12eb0cb54581a52de767624366cb898f2fc2d870d3bf2c554de35a46d6b25", "start_line": 115, "text": "syntax Bool ::= fileExtensionIs(IntSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 121, "file": "verification.k", "id": "verification.k:116", "keyword": "rule", "sha256": "902d10de6d27bf3958048c833b05706b5f739f9a62bd02f544b5a27bb3af28ad", "start_line": 116, "text": "rule fileExtensionIs(CS, EXT)\n    => applyCmp(\n         \"==\",\n         doSlice(str(CS), someB(-4), noB, noB),\n         str(EXT))"}
{"category": "syntax:function,total", "end_line": 122, "file": "verification.k", "id": "verification.k:122", "keyword": "syntax", "sha256": "1f6b76c51acadccbef5dfaaa657f1eecb272300dc50e7792e137f44fb5bdee17", "start_line": 122, "text": "syntax Bool ::= allowedFileExtension(IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 127, "file": "verification.k", "id": "verification.k:123", "keyword": "rule", "sha256": "f50cf83d5fa5dbb6057a9897b48c856d39697f43c813ccd4f2468b89cb4b3947", "start_line": 123, "text": "rule allowedFileExtension(CS)\n    => fileExtensionIs(CS, strToCodes(\".txt\"))\n       orBool fileExtensionIs(CS, strToCodes(\".exe\"))\n       orBool fileExtensionIs(CS, strToCodes(\".dll\"))"}
{"category": "rule:simplification", "end_line": 131, "file": "verification.k", "id": "verification.k:128", "keyword": "rule", "sha256": "e53c6fd519174c53fd5f77d05ad1c2d1b361be16d8f451a8c2b3a0530a16d343", "start_line": 128, "text": "rule N:Int >Int 3 => false\n    requires N <=Int 3\n    [simplification]"}
{"category": "endmodule", "end_line": 132, "file": "verification.k", "id": "verification.k:132", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 132, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "spec.k", "id": "spec.k:3", "keyword": "module", "sha256": "c6567408bb5c38e7013f6daa38b909379d4edf5653f933dc6606de6284e37144", "start_line": 3, "text": "module SPEC"}
{"category": "imports", "end_line": 5, "file": "spec.k", "id": "spec.k:4", "keyword": "imports", "sha256": "c9ea3dd45f204446d73a7c80562ae112680efac12dabb8fbabe9fe20dfbe5ec4", "start_line": 4, "text": "imports VERIFICATION"}
{"category": "claim", "end_line": 30, "file": "spec.k", "id": "spec.k:6", "keyword": "claim", "sha256": "da3c42f81c4226d314e41b3adce413e5a58b05a32bb4ebe3e3cb2ab293db4d6f", "start_line": 6, "text": "claim [empty-name]:\n    <k>\n      Call(Name(\"file_name_check\"), str(.IntSeq))\n      =>\n      str(strToCodes(\"No\"))\n    </k>\n    <env> 0 </env>\n    <scopes>\n      0 |-> scope(\n        \"file_name_check\" |->\n          closureVal(\n            (\"file_name\", .ParamNames),\n            fileNameCheckBody,\n            0),\n        parent(-1))\n      -1 |-> builtinsScope\n    </scopes>\n    <scopeLoc> 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack> .List </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>"}
{"category": "claim", "end_line": 56, "file": "spec.k", "id": "spec.k:31", "keyword": "claim", "sha256": "9f23ea66f2afbb41e11bd9b1779c52b78953085b19f24c16148db506b70e0827", "start_line": 31, "text": "claim [bad-dot-count]:\n    <k>\n      Call(Name(\"file_name_check\"), str(iCons(C:Int, REST:IntSeq)))\n      =>\n      str(strToCodes(\"No\"))\n    </k>\n    <env> 0 </env>\n    <scopes>\n      0 |-> scope(\n        \"file_name_check\" |->\n          closureVal(\n            (\"file_name\", .ParamNames),\n            fileNameCheckBody,\n            0),\n        parent(-1))\n      -1 |-> builtinsScope\n    </scopes>\n    <scopeLoc> 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack> .List </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    requires cntSub(iCons(C, REST), strToCodes(\".\")) =/=Int 1"}
{"category": "claim", "end_line": 85, "file": "spec.k", "id": "spec.k:57", "keyword": "claim", "sha256": "9c5175d1298e19d18e5b7c2a3be44afda2d1a492584fdc8ef38baca0b9f6035b", "start_line": 57, "text": "claim [bad-initial]:\n    <k>\n      Call(Name(\"file_name_check\"), str(iCons(C:Int, REST:IntSeq)))\n      =>\n      str(strToCodes(\"No\"))\n    </k>\n    <env> 0 </env>\n    <scopes>\n      0 |-> scope(\n        \"file_name_check\" |->\n          closureVal(\n            (\"file_name\", .ParamNames),\n            fileNameCheckBody,\n            0),\n        parent(-1))\n      -1 |-> builtinsScope\n    </scopes>\n    <scopeLoc> 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack> .List </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    requires cntSub(iCons(C, REST), strToCodes(\".\")) ==Int 1\n     andBool notBool strContains(\n       iCons(C, .IntSeq),\n       strToCodes(\"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"))"}
{"category": "claim", "end_line": 115, "file": "spec.k", "id": "spec.k:86", "keyword": "claim", "sha256": "0b098d431193f38b4372d14f1059d6723969359ef7fcf2eca859c6b8a0f24c46", "start_line": 86, "text": "claim [bad-extension]:\n    <k>\n      Call(Name(\"file_name_check\"), str(iCons(C:Int, REST:IntSeq)))\n      =>\n      str(strToCodes(\"No\"))\n    </k>\n    <env> 0 </env>\n    <scopes>\n      0 |-> scope(\n        \"file_name_check\" |->\n          closureVal(\n            (\"file_name\", .ParamNames),\n            fileNameCheckBody,\n            0),\n        parent(-1))\n      -1 |-> builtinsScope\n    </scopes>\n    <scopeLoc> 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack> .List </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    requires cntSub(iCons(C, REST), strToCodes(\".\")) ==Int 1\n     andBool strContains(\n       iCons(C, .IntSeq),\n       strToCodes(\"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"))\n     andBool notBool allowedFileExtension(iCons(C, REST))"}
{"category": "claim", "end_line": 146, "file": "spec.k", "id": "spec.k:116", "keyword": "claim", "sha256": "09c548bec5cb588c411ec6f11d23ac3d2835f8a6d6a4fb932382861b485a4daf", "start_line": 116, "text": "claim [too-many-digits-txt]:\n    <k>\n      Call(Name(\"file_name_check\"), str(iCons(C:Int, REST:IntSeq)))\n      =>\n      str(strToCodes(\"No\"))\n    </k>\n    <env> 0 </env>\n    <scopes>\n      0 |-> scope(\n        \"file_name_check\" |->\n          closureVal(\n            (\"file_name\", .ParamNames),\n            fileNameCheckBody,\n            0),\n        parent(-1))\n      -1 |-> builtinsScope\n    </scopes>\n    <scopeLoc> 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack> .List </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    requires cntSub(iCons(C, REST), strToCodes(\".\")) ==Int 1\n     andBool strContains(\n       iCons(C, .IntSeq),\n       strToCodes(\"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"))\n     andBool fileExtensionIs(iCons(C, REST), strToCodes(\".txt\"))\n     andBool decimalDigitCount(iCons(C, REST)) >Int 3"}
