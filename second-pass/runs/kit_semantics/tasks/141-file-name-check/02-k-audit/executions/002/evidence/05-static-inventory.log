{"category": "rule:ordinary", "end_line": 182, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:182", "keyword": "rule", "sha256": "abd5cc4adcbe2ff17a9a65065bab11cb91f71486cec9b3aec6b916a2dadd508f", "start_line": 182, "text": "rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46"}
{"category": "rule:ordinary", "end_line": 183, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:183", "keyword": "rule", "sha256": "1e74ce0b2611ba03551065586840c66efcef50ec31c87931ea7e1fcdd0c038d5", "start_line": 183, "text": "rule fscAcc(.IntSeq, A:Int) => A"}
{"category": "rule:ordinary", "end_line": 184, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:184", "keyword": "rule", "sha256": "21eab0b39d565a3e9d8d58a6a31ae9dc36d9912941fde9c3fde2ba3b0e13a8b1", "start_line": 184, "text": "rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)"}
{"category": "rule:ordinary", "end_line": 185, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:185", "keyword": "rule", "sha256": "a528cb142102cbb205e5e2a04f502db9659e955dbeb0b957699af3bdbb7e1409", "start_line": 185, "text": "rule applyBuiltin(\"float\", str(CS:IntSeq), .Vals) => decStrToF(CS)"}
{"category": "rule:ordinary", "end_line": 186, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:186", "keyword": "rule", "sha256": "80d889ec0b352f31ddead51ab7e6eb0b7e10c9d44e1228bf125b4ef8fa1e3fd7", "start_line": 186, "text": "rule applyBuiltin(\"float\", I:Int, .Vals)          => intToF(I)"}
{"category": "rule:ordinary", "end_line": 189, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:187", "keyword": "rule", "sha256": "9d01ad910e12fa47775070c5ef387a256eb14b7ed48c947293725769b85c6c91", "start_line": 187, "text": "rule applyBuiltin(\"float\", F:Float, .Vals)        => F\n\n  // ---- float / int division (promoted from mean_absolute_deviation) ----"}
{"category": "syntax:function,total,symbol", "end_line": 190, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:190", "keyword": "syntax", "sha256": "f49cc043a05b2accf64a4db2d7e01a1b3b2ad8d4c9aac725e410510fe5868681", "start_line": 190, "text": "syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 191, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:191", "keyword": "rule", "sha256": "a71c4a7b3d8c96c0b1b11e6d910903e91cc245db5c6b79525d6f74e8d046211e", "start_line": 191, "text": "rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]"}
{"category": "rule:ordinary", "end_line": 194, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:192", "keyword": "rule", "sha256": "13a3ca39a300f657c933e80bf5dc5d1bd4016fe9ad94017f6b30535589336708", "start_line": 192, "text": "rule applyBin(\"/\", F:Float, I:Int) => divFloatIntV(F, I)\n\n  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----"}
{"category": "syntax:function,total,symbol", "end_line": 195, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:195", "keyword": "syntax", "sha256": "4f21c29912e1361d8706f1bf1cde8207bd9e40372f9128ae77571effd103a990", "start_line": 195, "text": "syntax Float ::= intToF(Int) [function, total, symbol(intToF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 196, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:196", "keyword": "rule", "sha256": "389178d3dfd7c359c14f9336e08d770f7068b029dbbe053760f92d9769d2781f", "start_line": 196, "text": "rule intToF(I:Int) => Int2Float(I, 53, 11) [concrete]"}
{"category": "rule:ordinary", "end_line": 197, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:197", "keyword": "rule", "sha256": "695a4d4bdd54bacc726be8bb1b947957b13ac3c1ea85079e6f37f176f5dd1e85", "start_line": 197, "text": "rule applyBin(\"+\", I:Int, F:Float) => addF(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 198, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:198", "keyword": "rule", "sha256": "8105c256a812da5488c816ddc234cc23a361eaea37ba294397ab351db64ecbe8", "start_line": 198, "text": "rule applyBin(\"+\", F:Float, I:Int) => addF(F, intToF(I))"}
{"category": "rule:ordinary", "end_line": 199, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:199", "keyword": "rule", "sha256": "7b68c306973586de958d305580b9863c51bc797c0632e645a8be0e4e94ab5f88", "start_line": 199, "text": "rule applyBin(\"-\", I:Int, F:Float) => subF(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 200, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:200", "keyword": "rule", "sha256": "1409954604e558d1e20ebb673b113bb4e753382700056a9bb050e2f5877f2435", "start_line": 200, "text": "rule applyBin(\"-\", F:Float, I:Int) => subF(F, intToF(I))"}
{"category": "rule:ordinary", "end_line": 201, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:201", "keyword": "rule", "sha256": "74e2f8b58bc61612bd447aba290b62193b7b0a596847a535cef8ecf17013ed6d", "start_line": 201, "text": "rule applyBin(\"*\", I:Int, F:Float) => mulF(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 202, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:202", "keyword": "rule", "sha256": "de611e1415d1413bffdbb0fc1e35fdc3143eee6a775b9cef2212242ec9d8114a", "start_line": 202, "text": "rule applyBin(\"*\", F:Float, I:Int) => mulF(F, intToF(I))"}
{"category": "rule:ordinary", "end_line": 203, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:203", "keyword": "rule", "sha256": "1714c1550770bc11884e259edb53966f4938fc04546dd96c773cabee38acab6c", "start_line": 203, "text": "rule applyCmp(\"<\", I:Int, F:Float) => floatLt(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 204, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:204", "keyword": "rule", "sha256": "a3b308b7b2c2e9343ae069b0a7bbe47498537cca6859ee92873552c2df50f105", "start_line": 204, "text": "rule applyCmp(\"<\", F:Float, I:Int) => floatLt(F, intToF(I))"}
{"category": "rule:ordinary", "end_line": 205, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:205", "keyword": "rule", "sha256": "fc6de3b7c2f96d950f9aaca9f5df3aed76102c3b005e86cef59e2d2bce19afcf", "start_line": 205, "text": "rule applyCmp(\">\", I:Int, F:Float) => gtF(intToF(I), F)"}
{"category": "rule:ordinary", "end_line": 208, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:206", "keyword": "rule", "sha256": "fcf4563e15b1e0d933360363888b337b15cde5cbdfea8885c006cdbd12e2fc4a", "start_line": 206, "text": "rule applyCmp(\">\", F:Float, I:Int) => gtF(F, intToF(I))\n\n  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----"}
{"category": "syntax:function,total,symbol", "end_line": 209, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:209", "keyword": "syntax", "sha256": "11c17aa2d43131ae18ec1be82f27b6922d13447bcdad8aea53515aaf4222e7a0", "start_line": 209, "text": "syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 210, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:210", "keyword": "rule", "sha256": "bee730d1e87168f9dad702b1113b5a919a7ee189741db231857746a167529d25", "start_line": 210, "text": "rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]"}
{"category": "rule:ordinary", "end_line": 212, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:211", "keyword": "rule", "sha256": "651a7c3ee92f0a9635c032666a3452b3cfa8ca92836f167a48bc06274401d3e0", "start_line": 211, "text": "rule applyBuiltin(\"int\", F:Float, .Vals) => truncF(F)"}
{"category": "rule:ordinary", "end_line": 213, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:213", "keyword": "rule", "sha256": "d009baabfcf1f2b26f4113ab9512d85bfd29d32c1ad36850c876624d7b5201ae", "start_line": 213, "text": "rule applyBuiltin(\"float\", I:Int, .Vals)   => intToF(I)"}
{"category": "rule:ordinary", "end_line": 216, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:214", "keyword": "rule", "sha256": "7daaf4f6f5055d6dd7e9badeaf949beacc771ff7e3701afc790072c793bde45d", "start_line": 214, "text": "rule applyBuiltin(\"float\", F:Float, .Vals) => F\n\n  // round: Python half-even (banker's); round(F, N) scales by 10^N"}
{"category": "syntax:function,total,symbol", "end_line": 217, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:217", "keyword": "syntax", "sha256": "d0b7f75c69f6a7f52a6d150fa1f859c9c843ffefeea29b68a7ef6d619f7a89ba", "start_line": 217, "text": "syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 222, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:218", "keyword": "rule", "sha256": "71a93adeb3de8a6b9ff6b8cc3a3405dbcfab47ff954a427d1980458854e0db88", "start_line": 218, "text": "rule roundF(F:Float)\n    => #if (F -Float floorFloat(F)) ==Float 0.5\n       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0\n              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)\n       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]"}
{"category": "syntax:function,total,symbol", "end_line": 223, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:223", "keyword": "syntax", "sha256": "73ff3255d50db9ef5ce4e5587a02f3727412ba9e564eb216091a4a44fea04c54", "start_line": 223, "text": "syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 226, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:224", "keyword": "rule", "sha256": "7dd52ea7b2ef06b6dd10b04df266737bc188824c30df132916d16144ad57f9d3", "start_line": 224, "text": "rule roundFN(F:Float, N:Int)\n    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)\n       /Float Int2Float(10 ^Int N, 53, 11) [concrete]"}
{"category": "rule:ordinary", "end_line": 227, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:227", "keyword": "rule", "sha256": "a41ad11a3b0bf8c5d2bbad324162fd5a1d4948f425ad6862278978a3d7af5626", "start_line": 227, "text": "rule applyBuiltin(\"round\", F:Float, .Vals)        => roundF(F)"}
{"category": "rule:ordinary", "end_line": 229, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:228", "keyword": "rule", "sha256": "053cb084a5421b38959bd6e86a7f16795e1408d819c3053e85c24ab6c9bd01f4", "start_line": 228, "text": "rule applyBuiltin(\"round\", F:Float, N:Int, .Vals) => roundFN(F, N)"}
{"category": "syntax:function,total,symbol", "end_line": 230, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:230", "keyword": "syntax", "sha256": "ccbc575470399e30c153b9c247d480371d972bf5c6a908dd1deba29b7a3fb92e", "start_line": 230, "text": "syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]"}
{"category": "rule:ordinary", "end_line": 231, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:231", "keyword": "rule", "sha256": "6233ea5230d8583f4585636e51bd39d973ee97f98281d6711e369677f7fab7c2", "start_line": 231, "text": "rule sqrtF(F:Float) => sqrtFloat(F) [concrete]"}
{"category": "syntax", "end_line": 232, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:232", "keyword": "syntax", "sha256": "cf723364ca5d681bba80f43226edcd7e8beea1e13bea0f107f710ad340966933", "start_line": 232, "text": "syntax KItem ::= \"#mathSqrt\""}
{"category": "rule:priority(40)", "end_line": 233, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:233", "keyword": "rule", "sha256": "9708f9876df9bd54f74a36d6f213af9a101a9064261c6b8717ef86a520e5f151", "start_line": 233, "text": "rule <k> Call(Attribute(Name(\"math\"), \"sqrt\"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]"}
{"category": "rule:ordinary", "end_line": 234, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:234", "keyword": "rule", "sha256": "7e79b6dbd8c07376bb029b374572020a5420a378a9c49c65d56f1567c002a4c0", "start_line": 234, "text": "rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>"}
{"category": "rule:ordinary", "end_line": 242, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:235", "keyword": "rule", "sha256": "bf8709cfbb23e5d066ac27ac3afb563d7120f9afdfd4f0dfe7e7e1b2ec5890e2", "start_line": 235, "text": "rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>\n\n  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which\n  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires\n  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof\n  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at\n  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:\n  // the isFloat guard is disjoint from the existing isInt one."}
{"category": "syntax", "end_line": 243, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:243", "keyword": "syntax", "sha256": "a63f310fdba5a6f45aa19461da4b980cdebc96e73ac1a35a94f6c219c4f4ac1f", "start_line": 243, "text": "syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)"}
{"category": "rule:ordinary", "end_line": 244, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:244", "keyword": "rule", "sha256": "838b90fdad470a0cb9ec017aca4445c39c79d1400f0c8199bc5e379d1394c6ac", "start_line": 244, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)"}
{"category": "rule:ordinary", "end_line": 245, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:245", "keyword": "rule", "sha256": "dfa99d6b3002d3d181db1c1b740bbb0d365de00515a7b0da3d6ccd418d8ad5f0", "start_line": 245, "text": "rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>"}
{"category": "rule:ordinary", "end_line": 246, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:246", "keyword": "rule", "sha256": "35a797d2ae5f80419d2f097787037eeac7ac26d46a573a396d00a2c237fe0902", "start_line": 246, "text": "rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>"}
{"category": "rule:ordinary", "end_line": 249, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:247", "keyword": "rule", "sha256": "62e0de8abff00f60bb6618fa7e8d62374c5902e8e93da6ca8e776b7601eb5125", "start_line": 247, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>\n       requires isFloat(V)"}
{"category": "syntax", "end_line": 250, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:250", "keyword": "syntax", "sha256": "cd35b1a809162624d97017592cb4c67cfabdc4236752758dfc73e9223f535029", "start_line": 250, "text": "syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)"}
{"category": "rule:ordinary", "end_line": 251, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:251", "keyword": "rule", "sha256": "785007e31d6e0716e9e2c2607b7db6ddc091436f5499b86dd575c0fc5b1e1546", "start_line": 251, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)"}
{"category": "rule:ordinary", "end_line": 252, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:252", "keyword": "rule", "sha256": "6b8405dae8d41cf373535771fde16f1e70f4e5c27e9318ec9f469b6c95df0487", "start_line": 252, "text": "rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>"}
{"category": "rule:ordinary", "end_line": 253, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:253", "keyword": "rule", "sha256": "700ae0c8579a15db7131fac162e19ae25bcac57d8cb38ce3275296d31d7d0441", "start_line": 253, "text": "rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>"}
{"category": "rule:ordinary", "end_line": 260, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:254", "keyword": "rule", "sha256": "5cba829dabded77690b8bf9f78fcc5048f854dfefc522352ae905013041298c3", "start_line": 254, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>\n       requires isFloat(V)\n\n  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared\n  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).\n  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof\n  // with isInt(V) in its path condition refutes this branch without sort reasoning."}
{"category": "syntax", "end_line": 261, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:261", "keyword": "syntax", "sha256": "0abd52ddf475c76be88e36b6ae667fa4b020f936fe9da72fa0159555df394556", "start_line": 261, "text": "syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)"}
{"category": "rule:ordinary", "end_line": 264, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:262", "keyword": "rule", "sha256": "37c9e8542e68ca5776841e96eb3dc52e926331242d3d6f4d4026f017137b731f", "start_line": 262, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)\n        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>\n       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))"}
{"category": "rule:ordinary", "end_line": 265, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:265", "keyword": "rule", "sha256": "65c1e01d9cd3ba0608befb376b26333c0a382f6396af8fad36e39e1ea0018c6c", "start_line": 265, "text": "rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>"}
{"category": "rule:ordinary", "end_line": 266, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:266", "keyword": "rule", "sha256": "a39fca22a1537ecfaa404ec9fe4c163ac7600183a1ac70ec53c1f71b2c0cd536", "start_line": 266, "text": "rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>"}
{"category": "rule:ordinary", "end_line": 269, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:267", "keyword": "rule", "sha256": "666c7bfe3488eacae767db18299340448d30319c354df4278db9cd6509a10260", "start_line": 267, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)\n        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>\n       requires isFloat(V)"}
{"category": "rule:ordinary", "end_line": 272, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:270", "keyword": "rule", "sha256": "53789ad2c50a83736759de71b0337f1d548c33e65851748c6edbee907d31b422", "start_line": 270, "text": "rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)\n        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>\n       requires isInt(V) orBool isBool(V)"}
{"category": "endmodule", "end_line": 273, "file": "reference-semantics/semantics/float.k", "id": "reference-semantics/semantics/float.k:273", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 273, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:3", "keyword": "module", "sha256": "443014fc63307393fbae4cefb1f0e0c1626a46f092c728c97ec64c4e2e9cc71d", "start_line": 3, "text": "module MPY-FUNCTIONS"}
{"category": "imports", "end_line": 7, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:4", "keyword": "imports", "sha256": "e12c4f98e9599f655ee3340e926435e0396851d0faa6348ea5c831462018a688", "start_line": 4, "text": "imports MPY-CORE\n\n  // call routing + callee/arg evaluation (#callee/#args/#argCont) live in call.k;\n  // this module owns the frame lifecycle (bind params, return, pop)."}
{"category": "syntax", "end_line": 13, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:8", "keyword": "syntax", "sha256": "5654f2ffb4c0d740d48dc2d3b73ecba9ccb09e8063210f521a6fe9d4cfe0d219", "start_line": 8, "text": "syntax KItem ::= frame(continuation: K, callerEnv: Int, savedLoc: Int)\n                 | #bindP(ParamNames, Vals)\n                 | \"#pop\"\n                 | \"#endcall\"\n\n  // ==== def / anonymous closure ============================================="}
{"category": "rule:ordinary", "end_line": 17, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:14", "keyword": "rule", "sha256": "3d9d7b82c79b4d528cd1f35df609190d7717ab53a16e49af50541a65fe23d874", "start_line": 14, "text": "rule <k> FuncDef(F:String, Params(PNS:ParamNames), BODY:Stmts) => .K ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ F <- closureVal(PNS, BODY, L) ], _) ... </scopes>"}
{"category": "syntax", "end_line": 18, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:18", "keyword": "syntax", "sha256": "a6aeea98e7de047f34a60286bc922b09e47fb2b1ed36e387cb4dd043ab958d97", "start_line": 18, "text": "syntax Expr ::= closureExpr(ParamNames, Stmts)"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:19", "keyword": "rule", "sha256": "880a8eac9cefa55032726a4024734661406ec2b2f6c1869d9e65f19172660faf", "start_line": 19, "text": "rule <k> closureExpr(PNS:ParamNames, BODY:Stmts) => closureVal(PNS, BODY, L) ... </k>\n       <env> L:Int </env>\n\n  // ==== annotated def/lambda (closure cells; spec 2.3) ======================\n  // closureValC(params, cellvars, body, captured-cells). No frame anchor: all\n  // enclosing-local reads are freevars (symtable-complete) and go through the\n  // captured cells; everything else is global/builtin, so the callee frame's\n  // parent is the module scope (0) — sound after the defining frame dies."}
{"category": "syntax", "end_line": 30, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:27", "keyword": "syntax", "sha256": "45a1d25378d800acbd129009901a8f0e354e1da75d144b198f5543d5fcd75f9b", "start_line": 27, "text": "syntax Val ::= closureValC(ParamNames, ParamNames, Stmts, Map)\n\n  // capture: resolve each freevar to the enclosing frame's cellRef, then bind\n  // (FuncDef) or yield (Lambda) the closure value."}
{"category": "syntax", "end_line": 32, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:31", "keyword": "syntax", "sha256": "2874a00eb4f887256881e6957abe664f52a595925191bef800e552c039b38f2b", "start_line": 31, "text": "syntax KItem ::= #mkClosure(String, ParamNames, ParamNames, ParamNames, Stmts, Map)\n                 | #mkLambda(ParamNames, ParamNames, ParamNames, Stmts, Map)"}
{"category": "rule:ordinary", "end_line": 35, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:33", "keyword": "rule", "sha256": "eeed2278165438195a6be264a81d447882527d628007b5b99434ae560b811039", "start_line": 33, "text": "rule <k> FuncDef(F:String, Params(PNS:ParamNames), CellVars(CVS:ParamNames),\n                   FreeVars(FVS:ParamNames), BODY:Stmts)\n        => #mkClosure(F, PNS, CVS, FVS, BODY, .Map) ... </k>"}
{"category": "rule:ordinary", "end_line": 41, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:36", "keyword": "rule", "sha256": "da212052370e95a6b1a8f81760e179f4178934f309cc333f1a21735244767974", "start_line": 36, "text": "rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,\n                      (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)\n        => #mkClosure(F, PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\n       requires FV in_keys(M)"}
{"category": "rule:ordinary", "end_line": 46, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:42", "keyword": "rule", "sha256": "1baa1ec6b80e3c50013bb2b480fd4be70f3bf6c4ac5eeb99778c38146dc30664", "start_line": 42, "text": "rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,\n                      .ParamNames, BODY:Stmts, CM:Map) => .K ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ F <- closureValC(PNS, CVS, BODY, CM) ], _) ... </scopes>"}
{"category": "rule:ordinary", "end_line": 49, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:47", "keyword": "rule", "sha256": "df3f1718f0fabb4d0e79fc09b1b1204c254b142da78ea188e02e6993cf99373f", "start_line": 47, "text": "rule <k> Lambda(Params(PNS:ParamNames), E:Expr)\n        => closureVal(PNS, Return(E) .Stmts, L) ... </k>\n       <env> L:Int </env>"}
{"category": "rule:ordinary", "end_line": 52, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:50", "keyword": "rule", "sha256": "23034bad30979b7fa3b1aef73bc2f1c145b94ed2accd837e7d9a8a4ddd0d9d0f", "start_line": 50, "text": "rule <k> Lambda(Params(PNS:ParamNames), CellVars(CVS:ParamNames),\n                  FreeVars(FVS:ParamNames), E:Expr)\n        => #mkLambda(PNS, CVS, FVS, Return(E) .Stmts, .Map) ... </k>"}
{"category": "rule:ordinary", "end_line": 58, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:53", "keyword": "rule", "sha256": "9d4bb562bd6752f110f4a55869ed09087f77298eee4c916b3d5d6021d4552e51", "start_line": 53, "text": "rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames,\n                     (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)\n        => #mkLambda(PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\n       requires FV in_keys(M)"}
{"category": "rule:ordinary", "end_line": 62, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:59", "keyword": "rule", "sha256": "f74364e19bbe096c41d2a12bf283210597419892851d46b91cbdcaddbad6f19e", "start_line": 59, "text": "rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames, .ParamNames, BODY:Stmts, CM:Map)\n        => closureValC(PNS, CVS, BODY, CM) ... </k>\n\n  // ==== bind params ========================================================"}
{"category": "rule:ordinary", "end_line": 63, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:63", "keyword": "rule", "sha256": "e3671d9bac62395286261253cedc1db6b2cc0499988e29cfc0fef9ecb270a51f", "start_line": 63, "text": "rule <k> #bindP(.ParamNames, .Vals) => .K ... </k>"}
{"category": "rule:ordinary", "end_line": 67, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:64", "keyword": "rule", "sha256": "00aa592629d2d2b222d81ff215fcc5374c8b1f688976e1add4b634caca3e135a", "start_line": 64, "text": "rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals)) => #bindP(PS, VS) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ P <- V ], _) ... </scopes>\n  // a param that is a cellvar was pre-bound to its cell at frame entry"}
{"category": "rule:priority(40)", "end_line": 77, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:68", "keyword": "rule", "sha256": "f54b63580577cc9e00068968c2282860c588233656e4282fef0a11480d1b159a", "start_line": 68, "text": "rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals))\n        => #cellW({M[P]}:>Val, V) ~> #bindP(PS, VS) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\n       requires \"$cells\" in_keys(M)\n        andBool pnMember(P, cellsOf({M[\"$cells\"]}:>Val))\n        andBool P in_keys(M) andBool isCellRef({M[P]}:>Val)\n       [priority(40)]\n\n  // ==== return / pop the frame (the returned expr evaluates by strictness) =="}
{"category": "rule:ordinary", "end_line": 79, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:78", "keyword": "rule", "sha256": "1c5a24070b0f22d091ba8fec858eba0b7ecc5b6f0a1322c34cc21e72d78f1a93", "start_line": 78, "text": "rule <k> Return(V:Val) ~> _ => #pop </k>\n       <ret> noRet => retV(V) </ret>"}
{"category": "rule:ordinary", "end_line": 84, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:80", "keyword": "rule", "sha256": "50321bd01cb5b84f0494a1e3196f6cdcab093a8fdb57a393c1828f8ae451eeee", "start_line": 80, "text": "rule <k> #endcall => #pop ... </k>\n       <ret> noRet => retV(noneV) </ret>\n  // pop: restore env, DEALLOCATE the callee frame, and wind scopeLoc back (LIFO allocation\n  // makes the saved loc the callee frame's own loc). Sound because no closureVal outlives its\n  // defining frame (frontend subset: no returned/stored closures; module defs live in loc 0)."}
{"category": "rule:ordinary", "end_line": 90, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:85", "keyword": "rule", "sha256": "102fe224b1a3c24139eaeb7be2c86f8be5ba9bee68b44460f9da6bc6710edfde", "start_line": 85, "text": "rule <k> #pop => V ~> CONT </k>\n       <ret>   retV(V) => noRet </ret>\n       <stack> ListItem(frame(CONT:K, CALLERL:Int, SAVEDL:Int)) => .List ... </stack>\n       <env>   L:Int => CALLERL </env>\n       <scopes> SC:Map => SC [ L <- undef ] </scopes>\n       <scopeLoc> _ => SAVEDL </scopeLoc>"}
{"category": "endmodule", "end_line": 91, "file": "reference-semantics/semantics/functions.k", "id": "reference-semantics/semantics/functions.k:91", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 91, "text": "endmodule"}
{"category": "module", "end_line": 4, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:4", "keyword": "module", "sha256": "74fc45d7398a54f6acd3ef6f2de6e8aaaa5970993284ffc2414ef9b80f8ee099", "start_line": 4, "text": "module MPY-INT"}
{"category": "imports", "end_line": 6, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:5", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 5, "text": "imports MPY-CORE"}
{"category": "rule:ordinary", "end_line": 8, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:7", "keyword": "rule", "sha256": "bea824a9d0c76babe487fb83fc65f9325c396843c8776705ff5df097dcbe35ab", "start_line": 7, "text": "rule applyUn(\"-\", I:Int) => 0 -Int I"}
{"category": "rule:ordinary", "end_line": 10, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:9", "keyword": "rule", "sha256": "c1356f411510fd9881be531988387f8897f1dc6d3c9480dd793121a48783d0b3", "start_line": 9, "text": "rule applyBin(\"+\",  I1:Int, I2:Int) => I1 +Int I2\n  // Bool participates in int arithmetic (x += (a == b))"}
{"category": "rule:ordinary", "end_line": 11, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:11", "keyword": "rule", "sha256": "161421e6a6967d356ac739b77ee8130aadce1cccdbd60eb39bbe2d09de0fc8f4", "start_line": 11, "text": "rule applyBin(\"+\",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi"}
{"category": "rule:ordinary", "end_line": 12, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:12", "keyword": "rule", "sha256": "aea33156fe56e41f55fde9df571d6a6ebc51d0db17e842f2ea668785f79ef67e", "start_line": 12, "text": "rule applyBin(\"+\",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I"}
{"category": "rule:ordinary", "end_line": 13, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:13", "keyword": "rule", "sha256": "3ed75ef0b6a51d6ae6b6d2d2789a09370509f3a7ceeab0c1954285debb169233", "start_line": 13, "text": "rule applyBin(\"-\",  I1:Int, I2:Int) => I1 -Int I2"}
{"category": "rule:ordinary", "end_line": 14, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:14", "keyword": "rule", "sha256": "08fc0a4f5088a685dca4d1ae9955eeb1cc741b9285a3638e320d0534d159a2c6", "start_line": 14, "text": "rule applyBin(\"*\",  I1:Int, I2:Int) => I1 *Int I2"}
{"category": "rule:ordinary", "end_line": 15, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:15", "keyword": "rule", "sha256": "b6d3e6ecd7f82dcce0a9e2c0d4bcaee810b8fc0dbc7848c3b48b6b7c7f6091b2", "start_line": 15, "text": "rule applyBin(\"%\",  I1:Int, I2:Int) => pyMod(I1, I2)"}
{"category": "rule:ordinary", "end_line": 16, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:16", "keyword": "rule", "sha256": "85afa4d25d1446e6442d53737a36d1cc763b73b3fc78e5ee581835eea8b7b0f2", "start_line": 16, "text": "rule applyBin(\"//\", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2"}
{"category": "rule:ordinary", "end_line": 18, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:17", "keyword": "rule", "sha256": "614ae406522ba61d5dafd570459dee468b49b861442a3c456ef857b36c41e18a", "start_line": 17, "text": "rule applyBin(\"**\", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0"}
{"category": "syntax:function", "end_line": 19, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:19", "keyword": "syntax", "sha256": "c131b0a212330737a12ec60d92eb60b3277a638e494ba82dba54d486be7e0c1a", "start_line": 19, "text": "syntax Int ::= pyMod(Int, Int) [function]"}
{"category": "rule:ordinary", "end_line": 21, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:20", "keyword": "rule", "sha256": "e3bb9293bfdee6b979c9f707348dfd94cb34c6ea9cc50901bfde37efe127d5f7", "start_line": 20, "text": "rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2"}
{"category": "rule:ordinary", "end_line": 22, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:22", "keyword": "rule", "sha256": "060cdde574874cb412a1cb5ff05d44a0c1c9d1387d37158f1b1b61bb92b1a243", "start_line": 22, "text": "rule applyCmp(\"<\",  I1:Int, I2:Int)   => I1 <Int  I2"}
{"category": "rule:ordinary", "end_line": 23, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:23", "keyword": "rule", "sha256": "6feefb9796ed343953dfe83352fa4bca7851392c4e28122fee363883beb876e0", "start_line": 23, "text": "rule applyCmp(\"<=\", I1:Int, I2:Int)   => I1 <=Int I2"}
{"category": "rule:ordinary", "end_line": 24, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:24", "keyword": "rule", "sha256": "96c9008e9527cbc5cb93ded0cd82da40c8b2d8f17a5d09fcd2c3943723710e11", "start_line": 24, "text": "rule applyCmp(\">\",  I1:Int, I2:Int)   => I1 >Int  I2"}
{"category": "rule:ordinary", "end_line": 25, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:25", "keyword": "rule", "sha256": "a2928e82e850c463ea98574fc9e8369c21d2e0b8299a36503d0aadd85482a334", "start_line": 25, "text": "rule applyCmp(\">=\", I1:Int, I2:Int)   => I1 >=Int I2"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:26", "keyword": "rule", "sha256": "2814f20ec081b5f2ba475bee20c59ac460d1924445c7968c8af4bf1cc48fd11b", "start_line": 26, "text": "rule applyCmp(\"==\", I1:Int, I2:Int)   => I1 ==Int I2"}
{"category": "rule:ordinary", "end_line": 27, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:27", "keyword": "rule", "sha256": "098913bfaf25d2ed2ed28f70f9930be24a8bf7afe1fb4c20d7a0483e61a68116", "start_line": 27, "text": "rule applyCmp(\"!=\", I1:Int, I2:Int)   => I1 =/=Int I2"}
{"category": "endmodule", "end_line": 28, "file": "reference-semantics/semantics/int.k", "id": "reference-semantics/semantics/int.k:28", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 28, "text": "endmodule"}
{"category": "module", "end_line": 6, "file": "reference-semantics/semantics/iter.k", "id": "reference-semantics/semantics/iter.k:6", "keyword": "module", "sha256": "65489422ea2a70bfef194feb6c0efcb5208a49917849941598ec8a343e2ece68", "start_line": 6, "text": "module MPY-ITER"}
{"category": "imports", "end_line": 7, "file": "reference-semantics/semantics/iter.k", "id": "reference-semantics/semantics/iter.k:7", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 7, "text": "imports MPY-CORE"}
{"category": "syntax", "end_line": 8, "file": "reference-semantics/semantics/iter.k", "id": "reference-semantics/semantics/iter.k:8", "keyword": "syntax", "sha256": "2fa814827c664147e6d7c96edd48c3a829a22cd77adc337afbe1fec74dba68ec", "start_line": 8, "text": "syntax KItem ::= #iterNext(Iterable) | \"#iterDone\" | #iterYield(Val, Iterable)"}
{"category": "endmodule", "end_line": 9, "file": "reference-semantics/semantics/iter.k", "id": "reference-semantics/semantics/iter.k:9", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 9, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:3", "keyword": "module", "sha256": "61efb165f96a6f5cda9e0ada6aa477f882898ac2258363d4a6911fbe5ca45ee4", "start_line": 3, "text": "module MPY-LIST"}
{"category": "imports", "end_line": 4, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:4", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 4, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 5, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:5", "keyword": "imports", "sha256": "8ad41781e06e91093b117ccd78f6f10180a840cf3b4adaa62547edd340b26acc", "start_line": 5, "text": "imports MPY-ITER"}
{"category": "imports", "end_line": 8, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:6", "keyword": "imports", "sha256": "424d2024bcef134fe9394d751b5b29901efd886fe5026f0718c9c5e92b6e1cb3", "start_line": 6, "text": "imports MPY-OPERATORS\n\n  // ==== iteration (the iterator protocol's list case) ======================="}
{"category": "rule:ordinary", "end_line": 9, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:9", "keyword": "rule", "sha256": "6fbad02eed1393671791b41b360b2e3d04305e9ed88115dbe5c066d85a767e49", "start_line": 9, "text": "rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>"}
{"category": "rule:ordinary", "end_line": 12, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:10", "keyword": "rule", "sha256": "d2a2ddead8cf62e43919c4082d6f76f03c3cca86c36205e7200934e43b29f21f", "start_line": 10, "text": "rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>\n\n  // ==== ListExpr: [...] literal -> a fresh heap object ======================="}
{"category": "syntax", "end_line": 13, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:13", "keyword": "syntax", "sha256": "3d024af826bb0836a06da6fe46f0ff98c9b78f2c58b136c80135b77c71073d7d", "start_line": 13, "text": "syntax ApplyK ::= \"toList\""}
{"category": "rule:ordinary", "end_line": 14, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:14", "keyword": "rule", "sha256": "f3163ec1febd09901035e7b494bbfc753c89a46a9286d5ed34309f5bf3a03b91", "start_line": 14, "text": "rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>"}
{"category": "rule:ordinary", "end_line": 17, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:15", "keyword": "rule", "sha256": "975932b6aeb0f6961e467debf269a841e3a6792fdff4cacbcff455e2c142dddf", "start_line": 15, "text": "rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>\n\n  // ==== list ops: + / == / != ==============================================="}
{"category": "syntax:function,total", "end_line": 18, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:18", "keyword": "syntax", "sha256": "ac8c744da9bbc4a3bc2a3f5ce845163aab64e079291f25529f7fea3a7eb17b02", "start_line": 18, "text": "syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 19, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:19", "keyword": "rule", "sha256": "f058ddea1c8527d55f2f1de4096104d23988a217be11d41d0d5e659527ddd117", "start_line": 19, "text": "rule valSeqConcat(.ValSeq, T:ValSeq)                => T"}
{"category": "rule:priority(45)", "end_line": 23, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:20", "keyword": "rule", "sha256": "72574078cd7f5d97e8b747bed2134f30e3e722dca0637ac8b0277cf0afbc8bcf", "start_line": 20, "text": "rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))\n\n  // list + list constructs a NEW object (k-cell — it allocates; operands land here\n  // already deref'd). priority(45) beats the generic BinOp dispatch."}
{"category": "rule:priority(45)", "end_line": 26, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:24", "keyword": "rule", "sha256": "7c2e29a9bff39c873327c31a44e154903ea75494c1a00567f57c632eac87a123", "start_line": 24, "text": "rule <k> BinOp(\"+\", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>\n       [priority(45)]"}
{"category": "rule:ordinary", "end_line": 27, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:27", "keyword": "rule", "sha256": "408c1dfb03ffb9842e1592e2fc229c8dc323c41b1a08feced658b6845110398c", "start_line": 27, "text": "rule applyCmp(\"==\", list(A:ValSeq), list(B:ValSeq)) => A ==K B"}
{"category": "rule:ordinary", "end_line": 32, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:28", "keyword": "rule", "sha256": "c28df05ac9ca891e08caf2e9d4946fccb34d9647c9165f92c0cd3a6304f1ed6f", "start_line": 28, "text": "rule applyCmp(\"!=\", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)\n\n  // ==== deep equality when elements are heap objects (list-of-lists) ========\n  // Python == is structural at every depth. Fires ONLY when a ref is present\n  // (the guard decides on concrete seqs); the plain ==K path above is unchanged."}
{"category": "syntax:function,total", "end_line": 33, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:33", "keyword": "syntax", "sha256": "afe83d38567e7cd0f351930bbf72bf06852a8be4cd8aa7d3a8a0baedfe69508a", "start_line": 33, "text": "syntax Bool ::= hasRefVS(ValSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 34, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:34", "keyword": "rule", "sha256": "c6097b5c360d5d3d562eac9b510a966cb93aa9a82da70ef82590f2129ae69479", "start_line": 34, "text": "rule hasRefVS(.ValSeq)                => false"}
{"category": "rule:ordinary", "end_line": 36, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:35", "keyword": "rule", "sha256": "3e47ea875f2d3db96838bc493159b5314396db5be11a6042c7f37ccc9135968e", "start_line": 35, "text": "rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)"}
{"category": "syntax:function", "end_line": 38, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:37", "keyword": "syntax", "sha256": "c331eb24453a080fb3beacb6d4aa5d9f23891042fda20d5d0b88618160e4f6e0", "start_line": 37, "text": "syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]\n                | deepEqV(Val, Val, Map)        [function]"}
{"category": "rule:ordinary", "end_line": 39, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:39", "keyword": "rule", "sha256": "2394eddeadea3951f4bd5364e3ee3b600ea958fb5b5aae9aa8062c6b9704ee56", "start_line": 39, "text": "rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true"}
{"category": "rule:ordinary", "end_line": 40, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:40", "keyword": "rule", "sha256": "e2fba109126125c19d026bb7e9358b5f0c6e36f08431f71ffa0f961538666690", "start_line": 40, "text": "rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false"}
{"category": "rule:ordinary", "end_line": 41, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:41", "keyword": "rule", "sha256": "20bfecdfc83caa7a51a85dd15366a4b171f7dc174346f70ced632e73246372cb", "start_line": 41, "text": "rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false"}
{"category": "rule:ordinary", "end_line": 44, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:42", "keyword": "rule", "sha256": "d7909ad8764a8acafac75d30ada1600d528d673b1b23e84637de99753e16050b", "start_line": 42, "text": "rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)\n    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)"}
{"category": "rule:ordinary", "end_line": 46, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:45", "keyword": "rule", "sha256": "f950fd8a48acc86dedd6c8c5afd8001ba706d49e8448dff651ebbd61eb6a0cae", "start_line": 45, "text": "rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)\n       requires H in_keys(HP)"}
{"category": "rule:ordinary", "end_line": 48, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:47", "keyword": "rule", "sha256": "0fefe5738b329c650b074ed10a8d98b31c18cf958d47abc1e0b22d02d28c07bb", "start_line": 47, "text": "rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)\n       requires notBool isRefV(A) andBool H in_keys(HP)"}
{"category": "rule:ordinary", "end_line": 49, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:49", "keyword": "rule", "sha256": "3863900e8a58f55b84dfb8e7bbb5d85873021d96c873b9f9d8df464649e1fe74", "start_line": 49, "text": "rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)"}
{"category": "rule:owise", "end_line": 52, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:50", "keyword": "rule", "sha256": "fe0f9e83b749e0a6e2aa39071848ac39e5aecdadc589419e3c5083b7c7465081", "start_line": 50, "text": "rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]\n\n  // ==== mutator: xs.append(v) — an in-place heap write ======================"}
{"category": "rule:priority(40)", "end_line": 57, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:53", "keyword": "rule", "sha256": "31d5e83cb39e4a8d2176cb70aa60ae3d1e2d30e61ec4656a0e40f9587219f812", "start_line": 53, "text": "rule <k> #applyK(toCall(boundMethodV(ref(H:Int), \"append\")), (V:Val, .Vals)) => noneV ... </k>\n       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>\n       [priority(40)]\n\n  // ==== `x in list` — a <k>-cell fold over #iterNext ========================"}
{"category": "syntax", "end_line": 58, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:58", "keyword": "syntax", "sha256": "e171041153df48d94a2b0f613d3cea691d9708f5a08bc58349b786188006ec0c", "start_line": 58, "text": "syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | \"#notB\""}
{"category": "rule:ordinary", "end_line": 59, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:59", "keyword": "rule", "sha256": "ebd1399faaffbf28bddd10ef00edb76bc60c148688370961d364a71e2c09fc4f", "start_line": 59, "text": "rule <k> Compare(LV:Val, CmpOp(\"in\",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>"}
{"category": "rule:ordinary", "end_line": 60, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:60", "keyword": "rule", "sha256": "81419bc508aecac692f551f75d6b28b9e01b040d4bc0084db4de317160a54492", "start_line": 60, "text": "rule <k> Compare(LV:Val, CmpOp(\"not in\", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>"}
{"category": "rule:ordinary", "end_line": 61, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:61", "keyword": "rule", "sha256": "e84f869d57a9b95738d25e2c08fe4c7a9fc5eee5cc83a72dce6b9b077d8e258a", "start_line": 61, "text": "rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>"}
{"category": "rule:ordinary", "end_line": 62, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:62", "keyword": "rule", "sha256": "d8442792286ce85192874167d4b911992fb7f792c374c8aa1981e75ee444d220", "start_line": 62, "text": "rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>"}
{"category": "rule:ordinary", "end_line": 64, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:63", "keyword": "rule", "sha256": "5d0b63b75b9cf250873259b3f0fcbdf3e7ed3db429e143a1df7b9ef624103ff1", "start_line": 63, "text": "rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>\n       requires E ==K V"}
{"category": "rule:ordinary", "end_line": 66, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:65", "keyword": "rule", "sha256": "9f843c1448707d78018ab26db3494d6be68c0e06935af2e136d5cf6161aa173e", "start_line": 65, "text": "rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>\n       requires notBool (E ==K V)"}
{"category": "rule:ordinary", "end_line": 67, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:67", "keyword": "rule", "sha256": "5511f8c4ec4450e21911f2ff0f12e7e5b0efafc30602e42132f5d292d30a5d81", "start_line": 67, "text": "rule <k> B:Bool ~> #notB => notBool B ... </k>"}
{"category": "endmodule", "end_line": 68, "file": "reference-semantics/semantics/list.k", "id": "reference-semantics/semantics/list.k:68", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 68, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:3", "keyword": "module", "sha256": "47c4712939d78225ec8e93900e3b20269eb1c602283292296d9d06cac05c2962", "start_line": 3, "text": "module MPY-METHODS"}
{"category": "imports", "end_line": 4, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:4", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 4, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 5, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:5", "keyword": "imports", "sha256": "5d664c02791debafd1c58c1ef3ced502c6bc84e391ab9bf326e009fc1f3c5ec9", "start_line": 5, "text": "imports K-EQUAL"}
{"category": "imports", "end_line": 6, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:6", "keyword": "imports", "sha256": "1c022ad4e0c945f696aa1f9d78eb4c3caf78ef9d9b46ae55d6fd081ff4264877", "start_line": 6, "text": "imports MPY-STR"}
{"category": "imports", "end_line": 9, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:7", "keyword": "imports", "sha256": "725037cad96b8005f33206b1e4a3cf773add403d6a0804f5ce84da4912b67502", "start_line": 7, "text": "imports MPY-LIST\n\n  // method-call routing + arg-eval live in call.k; this module owns applyMethod."}
{"category": "syntax:function", "end_line": 12, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:10", "keyword": "syntax", "sha256": "fc57ca301bffa84435b3de70dcd4a389d5401d97679cd02e7a22b218737f08aa", "start_line": 10, "text": "syntax Val ::= applyMethod(Val, String, Vals) [function]\n\n  // ==== string predicates (Python semantics) ================================="}
{"category": "rule:ordinary", "end_line": 13, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:13", "keyword": "rule", "sha256": "328b30a3774c14efcc41ec3ccafc8b66c15e41138c101b1814f95c16e7d3c3b5", "start_line": 13, "text": "rule applyMethod(str(CS:IntSeq), \"isupper\", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)"}
{"category": "rule:ordinary", "end_line": 14, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:14", "keyword": "rule", "sha256": "a6ae81f68d63fdf6ebf7a83e4cebc6a8ea356b697bc7b9e100d0e313713cafea", "start_line": 14, "text": "rule applyMethod(str(CS:IntSeq), \"islower\", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)"}
{"category": "rule:ordinary", "end_line": 15, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:15", "keyword": "rule", "sha256": "eb11f68e60879a03923bdb729b6cb65379b96d936aca7636c174815b536d2af1", "start_line": 15, "text": "rule applyMethod(str(CS:IntSeq), \"isalpha\", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)"}
{"category": "rule:ordinary", "end_line": 18, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:16", "keyword": "rule", "sha256": "5ab08bc2a01e6c3d76c02ceaedcf7136e04347d9292193ff19f790ca695451a0", "start_line": 16, "text": "rule applyMethod(str(CS:IntSeq), \"isdigit\", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)\n\n  // ==== case maps ============================================================"}
{"category": "rule:ordinary", "end_line": 19, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:19", "keyword": "rule", "sha256": "8ac3d7a0baa7cb995f784068fa4f8aa4b7472366db8205bf8dc59db91439244b", "start_line": 19, "text": "rule applyMethod(str(CS:IntSeq), \"lower\",    .Vals) => str(mapLower(CS))"}
{"category": "rule:ordinary", "end_line": 20, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:20", "keyword": "rule", "sha256": "ec5cf79a45b053c7f2ae1c008e1c5a51654f364c9674f5056d9dcfdf2fab67e4", "start_line": 20, "text": "rule applyMethod(str(CS:IntSeq), \"upper\",    .Vals) => str(mapUpper(CS))"}
{"category": "rule:ordinary", "end_line": 25, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:21", "keyword": "rule", "sha256": "69deac1db7c49d4f293f8bab9d442c7b11570e808ff2ac6f79fc95cdcdc1f3b6", "start_line": 21, "text": "rule applyMethod(str(CS:IntSeq), \"swapcase\", .Vals) => str(mapSwap(CS))\n\n  // ==== join / count / strip / encode ========================================\n  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by\n  // the call layer; the result str is a value)"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:26", "keyword": "rule", "sha256": "7c16ae8ffba754403e7d8d5b92438d28f400facc922dec2dcfd2f19b2638b867", "start_line": 26, "text": "rule applyMethod(str(SEP:IntSeq), \"join\", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))"}
{"category": "syntax:function,total", "end_line": 27, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:27", "keyword": "syntax", "sha256": "8449bace9b91c5f0d37c5971d3b28cd1cad5edfa8c5a4b09064e3d0368f9d4c4", "start_line": 27, "text": "syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 28, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:28", "keyword": "rule", "sha256": "dcb47502ba7100828de3ffb17ec481bef2af40dba346ade5600c4ff154b7e376", "start_line": 28, "text": "rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq"}
{"category": "rule:ordinary", "end_line": 29, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:29", "keyword": "rule", "sha256": "f2558775f8dab0e8cd93a50b44fe41f53fbfa634e3f8bb69170c8354661a39e0", "start_line": 29, "text": "rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS"}
{"category": "rule:ordinary", "end_line": 33, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:30", "keyword": "rule", "sha256": "d76e3c3797ff76247a278dc879efdcc8d74a59198fbaa7a2cf0c7870bce15d18", "start_line": 30, "text": "rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))\n    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))\n\n  // S.count(sub): non-overlapping window scan (Python str.count)"}
{"category": "rule:ordinary", "end_line": 34, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:34", "keyword": "rule", "sha256": "21c9fe9f742047bb32315eba84888c896b61193306c3c917ee7c909b4828e677", "start_line": 34, "text": "rule applyMethod(str(CS:IntSeq), \"count\", str(PC:IntSeq), .Vals) => cntSub(CS, PC)"}
{"category": "syntax:function", "end_line": 35, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:35", "keyword": "syntax", "sha256": "277077c74e8e5c1c9b55dccc915e494892ca2a34006043a7e2e1b08e7507c261", "start_line": 35, "text": "syntax Int ::= cntSub(IntSeq, IntSeq) [function]"}
{"category": "rule:ordinary", "end_line": 36, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:36", "keyword": "rule", "sha256": "f4dfc7d2f461d391d0196a077c5f476695803634821d0edeccc7045cb02eb5c8", "start_line": 36, "text": "rule cntSub(.IntSeq, _:IntSeq) => 0"}
{"category": "rule:ordinary", "end_line": 38, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:37", "keyword": "rule", "sha256": "3dfe01810fca3d7ace0645f6b704fe1e9012d767e218c307349d75572d429596", "start_line": 37, "text": "rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)\n       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0"}
{"category": "rule:ordinary", "end_line": 40, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:39", "keyword": "rule", "sha256": "b8d3c3017ae125d33521eaa2bc48803150675ea6b47bee0547cf52a9883b9144", "start_line": 39, "text": "rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)\n       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0"}
{"category": "syntax:function,total", "end_line": 41, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:41", "keyword": "syntax", "sha256": "121d0c58dbca6c2852abf6c8fbc50c66fa47e0563465d6ee60f128d83e251aa4", "start_line": 41, "text": "syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 42, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:42", "keyword": "rule", "sha256": "036bd013d44b4c1edf7a703d1d6db67965c6fa20915eca3d3946a6022c1d2ea9", "start_line": 42, "text": "rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0"}
{"category": "rule:owise", "end_line": 43, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:43", "keyword": "rule", "sha256": "f7a542230356ebad6029f1716109b7d96c72f11c2d5eeba3c1f490ad8595b4a1", "start_line": 43, "text": "rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]"}
{"category": "rule:ordinary", "end_line": 46, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:44", "keyword": "rule", "sha256": "05b3278c00285d292273e4ff672f849546367017cb3ce7723b767c09a9c04513", "start_line": 44, "text": "rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0\n\n  // S.strip(): trim whitespace runs from both ends"}
{"category": "rule:ordinary", "end_line": 47, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:47", "keyword": "rule", "sha256": "fc495b2dc6ff9d31d6c463b238bc6f4493026df5e3b1bdb6a89f40b1df908ecc", "start_line": 47, "text": "rule applyMethod(str(CS:IntSeq), \"strip\", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))"}
{"category": "syntax:function,total", "end_line": 48, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:48", "keyword": "syntax", "sha256": "4eeafed3826be8194a981bc1e80c6de26dba5f5a70b2bbac7793fa157606154c", "start_line": 48, "text": "syntax IntSeq ::= trimWS(IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 49, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:49", "keyword": "rule", "sha256": "4291267251cee7ecfdb91403f873109d0c5ef939a1f6251e0a4fedd1156ca37b", "start_line": 49, "text": "rule trimWS(.IntSeq) => .IntSeq"}
{"category": "rule:ordinary", "end_line": 50, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:50", "keyword": "rule", "sha256": "879a0736a8b490a2e2b40e4831c2e1462be6bf413bab581ea2fef7fef0e2f13a", "start_line": 50, "text": "rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)"}
{"category": "rule:ordinary", "end_line": 51, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:51", "keyword": "rule", "sha256": "988ee980274cf866a4026887cbba6282e3f7c959e268cc0e188d304b386fe20f", "start_line": 51, "text": "rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)"}
{"category": "syntax:function,total", "end_line": 52, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:52", "keyword": "syntax", "sha256": "588afa88ddb7cf7ccee3e65194d4b948b7144aff2cb57bf1c63a5b88eea31739", "start_line": 52, "text": "syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:53", "keyword": "rule", "sha256": "f72cb5914e4ad9c0fb018b845bab1085013c5baa882264e635d565f1ec941aee", "start_line": 53, "text": "rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 54, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:54", "keyword": "rule", "sha256": "24b1a05b8e5db65b0005965f6a85b1d0b37681f9aea425a3fd11cfee46934c89", "start_line": 54, "text": "rule revISAcc(.IntSeq, A:IntSeq) => A"}
{"category": "rule:ordinary", "end_line": 57, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:55", "keyword": "rule", "sha256": "6fd3193a5c77347b88936441b0ee75cc3795d68ea155a0fd00e4e4d294dde505", "start_line": 55, "text": "rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))\n\n  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)"}
{"category": "rule:ordinary", "end_line": 60, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:58", "keyword": "rule", "sha256": "61c5464136bcbb8b16c0c02b41d9389df0a8223f04869b4283b879f7bbb61ea3", "start_line": 58, "text": "rule applyMethod(str(CS:IntSeq), \"encode\", str(_:IntSeq), .Vals) => str(CS)\n\n  // ==== prefix ==============================================================="}
{"category": "rule:ordinary", "end_line": 63, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:61", "keyword": "rule", "sha256": "ab0e315ca7e5b5da8a9e7e5e92d981c30a104ad73e33202b7760f0c3fc7b518a", "start_line": 61, "text": "rule applyMethod(str(XC:IntSeq), \"startswith\", str(PC:IntSeq), .Vals) => startsWith(PC, XC)\n\n  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) =========="}
{"category": "rule:ordinary", "end_line": 64, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:64", "keyword": "rule", "sha256": "bf346f893e63110f2247b4095f95a28b356af1cec402e140ea43d69c26c85380", "start_line": 64, "text": "rule applyMethod(list(VS:ValSeq), \"count\", V:Val, .Vals) => cntOccVS(VS, V)"}
{"category": "syntax:function,total", "end_line": 65, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:65", "keyword": "syntax", "sha256": "b0bd756c21697bd2cd0656ba80c117936e75820eef660f3bd1ad62020d9d73f6", "start_line": 65, "text": "syntax Int ::= cntOccVS(ValSeq, Val) [function, total]"}
{"category": "rule:ordinary", "end_line": 66, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:66", "keyword": "rule", "sha256": "3123629a39817409b047a10fe83b0874fb5f52f116eade9b17c84895bb530915", "start_line": 66, "text": "rule cntOccVS(.ValSeq, _:Val)                => 0"}
{"category": "rule:ordinary", "end_line": 67, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:67", "keyword": "rule", "sha256": "87d9bfa2c6dc520cacd075a24b600fd6e56f675d04b6531d733a9a0b13ef16fe", "start_line": 67, "text": "rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V"}
{"category": "rule:ordinary", "end_line": 71, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:68", "keyword": "rule", "sha256": "be1ee2fb5026a3ad5bbcfae298a79b5f3c73dab40bcef1d40b3820da3f57bddc", "start_line": 68, "text": "rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)\n\n  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========\n  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally."}
{"category": "rule:priority(40)", "end_line": 74, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:72", "keyword": "rule", "sha256": "f87f16cdb41aab4a3a0238d2dfd0111cc7915c322a53c1d7cc59b6d7b7ca8080", "start_line": 72, "text": "rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), .Vals)\n        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>\n       [priority(40)]"}
{"category": "syntax:function,token", "end_line": 75, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:75", "keyword": "syntax", "sha256": "c6cbf0518fb67cfe0cc25614d769d4aa1bd401a183b61fc6da68c4c8b4de3506", "start_line": 75, "text": "syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result"}
{"category": "rule:ordinary", "end_line": 76, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:76", "keyword": "rule", "sha256": "e52130b97ceec63beef441b26323fc08c38cfe3a90e45c887dc3dc5e1a00b6d4", "start_line": 76, "text": "rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)"}
{"category": "rule:ordinary", "end_line": 78, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:77", "keyword": "rule", "sha256": "f030838ce6a97ec9406d6cd9c992fddcb77261a481588957849bbebf5cc04e5c", "start_line": 77, "text": "rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))\n       requires isWSC(C)"}
{"category": "rule:ordinary", "end_line": 81, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:79", "keyword": "rule", "sha256": "c1b92498fe1d9c94d8153f3dbab6be54e9a6a15feab7874b15a584d31b83d3c7", "start_line": 79, "text": "rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)\n       requires notBool isWSC(C)\n  // flush the current token to the result list iff non-empty."}
{"category": "syntax:function", "end_line": 82, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:82", "keyword": "syntax", "sha256": "002dffc41af21f640ec2d6c3961dac9a3d4c9f70cd750b85ea4637646913c277", "start_line": 82, "text": "syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]"}
{"category": "rule:ordinary", "end_line": 83, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:83", "keyword": "rule", "sha256": "2fce7516e2f015809fc1b1c97bb72995124ed82683440059f34143aea6d42396", "start_line": 83, "text": "rule flushTok(ACC:ValSeq, .IntSeq)            => ACC"}
{"category": "rule:ordinary", "end_line": 84, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:84", "keyword": "rule", "sha256": "0c970d4acf65c9b6165ba1fe9178229acd7b60d37a1f841e0a59864678cb91d1", "start_line": 84, "text": "rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))"}
{"category": "syntax:function,total", "end_line": 85, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:85", "keyword": "syntax", "sha256": "37f133bfa155728fbce4d8d71377c834d069d72a03b76ab067d8d40e862021b7", "start_line": 85, "text": "syntax Bool ::= isWSC(Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 88, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:86", "keyword": "rule", "sha256": "2219bdda1fcd0ef16120b011e5f5957b7b4164850883847e1ca7e2a205a68252", "start_line": 86, "text": "rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13\n\n  // split(sep='x') keyword form delegates to the positional k-cell rule"}
{"category": "rule:priority(39)", "end_line": 93, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:89", "keyword": "rule", "sha256": "dad83db23a6dc13ca48798e54ee9c006468fe98d9d2ebe3fe3dacbe2173e8a21", "start_line": 89, "text": "rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), (kwV(\"sep\", str(S:IntSeq)), .Vals))\n        => #applyK(toCall(boundMethodV(str(CS), \"split\")), (str(S), .Vals)) ... </k>\n       [priority(39)]\n\n  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1)."}
{"category": "rule:priority(40)", "end_line": 96, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:94", "keyword": "rule", "sha256": "3ec5aa46cf7807d2580522a85b169f118962c8890bb36c21b8535acb266cd227", "start_line": 94, "text": "rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), \"split\")), (str(iCons(SEP:Int, .IntSeq)), .Vals))\n        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>\n       [priority(40)]"}
{"category": "syntax:function,token", "end_line": 97, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:97", "keyword": "syntax", "sha256": "c7f1e785bafcb98b68939de79ae57e229625fce1dd0ee4623d1fc7d61afabd02", "start_line": 97, "text": "syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token"}
{"category": "rule:ordinary", "end_line": 98, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:98", "keyword": "rule", "sha256": "3e2b8460ffa27555f212ebd1a2f1f10300ade010a71b0bdd14582058f9afc708", "start_line": 98, "text": "rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)"}
{"category": "rule:ordinary", "end_line": 100, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:99", "keyword": "rule", "sha256": "101dfa34ca8cdd35fc4a6ee95eb1adf3e6be3f9597d345ec6979087fac47ec19", "start_line": 99, "text": "rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))\n       requires C ==Int SEP"}
{"category": "rule:ordinary", "end_line": 103, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:101", "keyword": "rule", "sha256": "cc530b70412e8384b87b10021af4261f27b1306049e80818a94b85fcf298e699", "start_line": 101, "text": "rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))\n       requires notBool (C ==Int SEP)"}
{"category": "rule:ordinary", "end_line": 105, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:104", "keyword": "rule", "sha256": "a8e93dddcc5af471c877058c30c742cf87f6c9430cbc0bda3e9b8726c0117088", "start_line": 104, "text": "rule applyMethod(str(CS:IntSeq), \"replace\", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)\n    => str(replaceC(CS, A, B))"}
{"category": "syntax:function,total", "end_line": 106, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:106", "keyword": "syntax", "sha256": "6c0dfc288cc629a1d6c7002d834de9ab6467f109d87dbf2def009ecf65e4feab", "start_line": 106, "text": "syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 107, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:107", "keyword": "rule", "sha256": "2e484a1f777cc09f68825bbd754691f9f058053c7e5f2416508105aba01f4899", "start_line": 107, "text": "rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq"}
{"category": "rule:ordinary", "end_line": 108, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:108", "keyword": "rule", "sha256": "439491c8316246eaa540a332a8b69e523cad49c2c7c4d2d0142a7365c4cf940a", "start_line": 108, "text": "rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A"}
{"category": "rule:ordinary", "end_line": 111, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:109", "keyword": "rule", "sha256": "d6db34c0845f08b6710ab24b6a38edadc6b8a75d0df71fa0f3cef7dbd62c6619", "start_line": 109, "text": "rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(C, replaceC(R, A, B)) requires notBool (C ==Int A)\n\n  // ==== char helpers ========================================================="}
{"category": "syntax:function,total", "end_line": 112, "file": "reference-semantics/semantics/methods.k", "id": "reference-semantics/semantics/methods.k:112", "keyword": "syntax", "sha256": "d60af3772ac0b1d7afb4df9a5320f88f50130c50810ac094f36f4dea6537df54", "start_line": 112, "text": "syntax Bool ::= isUpperC(Int) [function, total]"}
