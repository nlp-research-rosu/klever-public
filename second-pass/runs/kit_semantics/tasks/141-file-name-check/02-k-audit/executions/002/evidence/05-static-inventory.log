{"category": "rule:ordinary", "end_line": 9, "file": "reference-semantics/semantics/bool.k", "id": "reference-semantics/semantics/bool.k:8", "keyword": "rule", "sha256": "f6a9f817afd56c9168797a3f098cd08c12966f18447d1e0f9d1a05f16ae677c4", "start_line": 8, "text": "rule applyUn(\"not\", V:Val) => notBool truthy(V)"}
{"category": "rule:ordinary", "end_line": 10, "file": "reference-semantics/semantics/bool.k", "id": "reference-semantics/semantics/bool.k:10", "keyword": "rule", "sha256": "27c7ab07384784839a8a863b3f9933be214b73575a7e3e811e125c3d99a0370a", "start_line": 10, "text": "rule applyCmp(\"==\", B1:Bool, B2:Bool) => B1 ==Bool B2"}
{"category": "rule:ordinary", "end_line": 15, "file": "reference-semantics/semantics/bool.k", "id": "reference-semantics/semantics/bool.k:11", "keyword": "rule", "sha256": "64b2d68f0eaf9df7fa8d45276685b58272fe6d03ae9d8abe9f39184059290dad", "start_line": 11, "text": "rule applyCmp(\"!=\", B1:Bool, B2:Bool) => B1 =/=Bool B2\n\n  // ==== BoolOp: short-circuit, value-returning and / or =====================\n  // the node is its own accumulator: heat the HEAD element only, then either return it\n  // (short-circuit) or drop it and continue"}
{"category": "context", "end_line": 16, "file": "reference-semantics/semantics/bool.k", "id": "reference-semantics/semantics/bool.k:16", "keyword": "context", "sha256": "4bad2e2ff81c39e87091eef691d33bff23a6d7adf29b55aafe2a261e9e7aa33a", "start_line": 16, "text": "context BoolOp(_, (HOLE:Expr, _:Exprs))"}
