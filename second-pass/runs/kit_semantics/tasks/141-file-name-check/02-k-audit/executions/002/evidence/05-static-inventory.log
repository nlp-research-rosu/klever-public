{"category": "module", "end_line": 6, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:6", "keyword": "module", "sha256": "45e2448ad0cc46cb22870ee06d94f85e37bb4b1d5cd0a61f153e870e11385a1e", "start_line": 6, "text": "module MPY-OPERATORS"}
{"category": "imports", "end_line": 7, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:7", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 7, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 9, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:8", "keyword": "imports", "sha256": "8ad41781e06e91093b117ccd78f6f10180a840cf3b4adaa62547edd340b26acc", "start_line": 8, "text": "imports MPY-ITER"}
{"category": "rule:ordinary", "end_line": 11, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:10", "keyword": "rule", "sha256": "ec04b29e2d1b46254cb3f8a70fed7bc53b6920095b428522d967063442fc073b", "start_line": 10, "text": "rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>"}
{"category": "rule:ordinary", "end_line": 14, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:12", "keyword": "rule", "sha256": "a5de9880fff165fc5f79a79ac6642d54379e736a164cbbf0baacfb4b95f00567", "start_line": 12, "text": "rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>\n\n  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes"}
{"category": "context", "end_line": 15, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:15", "keyword": "context", "sha256": "e4932b24484a885d34b3f53705eeeb1fed84fc516b3ed52d0654f78929b823f1", "start_line": 15, "text": "context Compare(HOLE, _)"}
{"category": "context", "end_line": 16, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:16", "keyword": "context", "sha256": "ca9e40a2c27b7a232b7510b580b93e5ae8114c5866de16dfeea069acb5d453d0", "start_line": 16, "text": "context Compare(_:Val, CmpOp(_, HOLE))"}
{"category": "rule:owise", "end_line": 18, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:17", "keyword": "rule", "sha256": "262226c0a44f44c7a4f1da356324355babc5b5d4fb8f040deb3476d6fcd78288", "start_line": 17, "text": "rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]"}
{"category": "rule:ordinary", "end_line": 19, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:19", "keyword": "rule", "sha256": "30c0e5930768cffa209dcc402d10a63e4fa24f2b95f94374d61199560ab481d5", "start_line": 19, "text": "rule applyCmp(\"is\",     V:Val, noneV) => V ==K noneV"}
{"category": "rule:priority(40)", "end_line": 24, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:20", "keyword": "rule", "sha256": "52df1f5bc1a935f35a813527c5669d40b53cefedc17c6a72eb1a109be4612496", "start_line": 20, "text": "rule applyCmp(\"is not\", V:Val, noneV) => notBool (V ==K noneV)\n\n  // ==== operand deref: heap objects combine/compare by STRUCTURE ============\n  // (Python: list == is structural; identity only via `is`.) priority(40)\n  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref."}
{"category": "rule:priority(40)", "end_line": 27, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:25", "keyword": "rule", "sha256": "a0cb682355d9e6fd2eee7968bf5f1a27bd3f685382f059ce986128e626a623f3", "start_line": 25, "text": "rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "rule:priority(40)", "end_line": 33, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:28", "keyword": "rule", "sha256": "27e80018f4e6e98e0d3f4f512e1b1c5baba5b5445475f48470536464ea2b793d", "start_line": 28, "text": "rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       requires notBool isRefV(L)\n       [priority(40)]\n\n  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd"}
{"category": "rule:priority(40)", "end_line": 37, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:34", "keyword": "rule", "sha256": "ca104b09a61f62fb08f6d7b9c708ad649b2404f0669ef7a74d4523b35dd7f26c", "start_line": 34, "text": "rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       requires OP =/=String \"in\" andBool OP =/=String \"not in\"\n       [priority(40)]"}
{"category": "rule:priority(40)", "end_line": 43, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:38", "keyword": "rule", "sha256": "e0069c80841c490d3bc0504828042659c43afff27e3b15f461a8e16af1f7e990", "start_line": 38, "text": "rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       requires notBool isRefV(L)\n        orBool OP ==String \"in\" orBool OP ==String \"not in\"\n       [priority(40)]"}
{"category": "rule:priority(40)", "end_line": 46, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:44", "keyword": "rule", "sha256": "ad34ddf8843f4722734b16e788db858155b62d9e4dee724054725a7880d8df4e", "start_line": 44, "text": "rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "endmodule", "end_line": 47, "file": "reference-semantics/semantics/operators.k", "id": "reference-semantics/semantics/operators.k:47", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 47, "text": "endmodule"}
{"category": "module", "end_line": 5, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:5", "keyword": "module", "sha256": "3245f59acaa6746804c8828bc1367c52002d920809be287b0ba05af1d0e0aabf", "start_line": 5, "text": "module MPY-RANGE"}
{"category": "imports", "end_line": 6, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:6", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 6, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 8, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:7", "keyword": "imports", "sha256": "8ad41781e06e91093b117ccd78f6f10180a840cf3b4adaa62547edd340b26acc", "start_line": 7, "text": "imports MPY-ITER"}
{"category": "syntax:function,total", "end_line": 9, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:9", "keyword": "syntax", "sha256": "dec39b9740c8dd9d0236a292381d109809f8767a4531aef24a40002ccc2123ea", "start_line": 9, "text": "syntax Bool ::= inRange(Int, Int, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 11, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:10", "keyword": "rule", "sha256": "f93b1245c72320e5aa7cbc51256b44d4efb5755c048893f6ba2f6d35d191c295", "start_line": 10, "text": "rule inRange(I:Int, HI:Int, ST:Int) => (ST >Int 0 andBool I <Int HI) orBool (ST <Int 0 andBool I >Int HI)"}
{"category": "syntax:function", "end_line": 12, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:12", "keyword": "syntax", "sha256": "9f9f1aaeaee29256645f794ab24ac2a68d22b03a0716b38717979c26620d48f6", "start_line": 12, "text": "syntax Int ::= rangeLen(Int, Int, Int) [function]"}
{"category": "rule:ordinary", "end_line": 14, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:13", "keyword": "rule", "sha256": "86948590010c9f624136f208d956988d4cfbc4214142761836e8615a9837c4fb", "start_line": 13, "text": "rule rangeLen(LO:Int, HI:Int, ST:Int) => (HI -Int LO +Int ST -Int 1) /Int ST\n       requires ST >Int 0 andBool HI >Int LO"}
{"category": "rule:ordinary", "end_line": 16, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:15", "keyword": "rule", "sha256": "f92c137c0eb79d5144ed247dc60b6deff7b22c31247f6188976d50d728f38164", "start_line": 15, "text": "rule rangeLen(LO:Int, HI:Int, ST:Int) => (LO -Int HI -Int ST -Int 1) /Int (0 -Int ST)\n       requires ST <Int 0 andBool HI <Int LO"}
{"category": "rule:ordinary", "end_line": 19, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:17", "keyword": "rule", "sha256": "954aadd3bd47a86505a15998c9837a997ff2edaa8143b0cfdf5e2b59f3f7d312", "start_line": 17, "text": "rule rangeLen(LO:Int, HI:Int, ST:Int) => 0\n       requires (ST >Int 0 andBool HI <=Int LO) orBool (ST <Int 0 andBool HI >=Int LO)"}
{"category": "rule:ordinary", "end_line": 22, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:20", "keyword": "rule", "sha256": "df9306db7d3b08c5049ed3262d59b4860b67228e29867f8e6e2e66141206fd67", "start_line": 20, "text": "rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int))\n        => #iterYield(I, rangeObj(I +Int ST, HI, ST)) ... </k>\n       requires inRange(I, HI, ST)"}
{"category": "rule:ordinary", "end_line": 24, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:23", "keyword": "rule", "sha256": "b1dd4699b330a9812cdaa4c2a37ec28f21dd8f73383b0b1fea8b858ab6a9be24", "start_line": 23, "text": "rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int)) => #iterDone ... </k>\n       requires notBool inRange(I, HI, ST)"}
{"category": "endmodule", "end_line": 25, "file": "reference-semantics/semantics/range.k", "id": "reference-semantics/semantics/range.k:25", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 25, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:3", "keyword": "module", "sha256": "a61579bc570f8ff47f9955153b49516c35a9ec599610a638f928f0e7cc5ea32b", "start_line": 3, "text": "module MPY-SET"}
{"category": "imports", "end_line": 7, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:4", "keyword": "imports", "sha256": "e5eeba2662383acd9811e3851239a18db41788430bde206385489e10ba7e09b5", "start_line": 4, "text": "imports MPY-CORE\n\n  // a set value, carried as its distinct codes in first-seen order (order is irrelevant\n  // to membership/cardinality — the two observations sets support here)."}
{"category": "syntax", "end_line": 10, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:8", "keyword": "syntax", "sha256": "b89f52ac9a5ad5c1c192f98309e1ceeb2251ae6cafbb2682c6b58d5a8661f33b", "start_line": 8, "text": "syntax Val ::= setV(IntSeq)\n\n  // membership of a code in the accumulated distinct-code sequence"}
{"category": "syntax:function,total", "end_line": 11, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:11", "keyword": "syntax", "sha256": "be0ae2291d5d6df7e27aeb082308a7eef47f89db683207f1bf0a156860e1c128", "start_line": 11, "text": "syntax Bool ::= codeIn(Int, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 12, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:12", "keyword": "rule", "sha256": "be0e691e3c2c66e35bd4b30ee725e678df5ea6989dd4e17c9554a7ba351d60c2", "start_line": 12, "text": "rule codeIn(_:Int, .IntSeq)                => false"}
{"category": "rule:ordinary", "end_line": 15, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:13", "keyword": "rule", "sha256": "df6478ab6f79609b469de712f0bde4616651f84f1d29c0ededd16305579afa46", "start_line": 13, "text": "rule codeIn(C:Int, iCons(H:Int, T:IntSeq)) => C ==Int H orBool codeIn(C, T)\n\n  // the distinct codes of CS (insert-if-absent fold, first-seen order)"}
{"category": "syntax:function,total", "end_line": 17, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:16", "keyword": "syntax", "sha256": "1128bf4578c0d1120031ca20c5f54a1214111fe7a8fff22f74b18c7f131932d9", "start_line": 16, "text": "syntax IntSeq ::= dedupCodes(IntSeq)         [function, total]\n                  | dedupFrom(IntSeq, IntSeq)  [function, total]"}
{"category": "rule:ordinary", "end_line": 18, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:18", "keyword": "rule", "sha256": "d766b83ec2d86623c34078fd5baac96439ef9df58e2905582ef9572bf4141f92", "start_line": 18, "text": "rule dedupCodes(CS:IntSeq) => dedupFrom(CS, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 19, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:19", "keyword": "rule", "sha256": "43f63938c9877ea6964a01be9a0975520ad7bcd1547963caf64819fb8899825e", "start_line": 19, "text": "rule dedupFrom(.IntSeq, ACC:IntSeq) => ACC"}
{"category": "rule:ordinary", "end_line": 21, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:20", "keyword": "rule", "sha256": "bc0cbdf40272be16b7a64f5fffb9d7d307ed819d2df5cc1e9b47c6a0b2f07917", "start_line": 20, "text": "rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, ACC)\n       requires codeIn(C, ACC)"}
{"category": "rule:ordinary", "end_line": 24, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:22", "keyword": "rule", "sha256": "cdcf7512adc552f1c2ac105a0070922f7de4bf480257116a757177208f718dd4", "start_line": 22, "text": "rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, snocCode(ACC, C))\n       requires notBool codeIn(C, ACC)"}
{"category": "syntax:function,total", "end_line": 25, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:25", "keyword": "syntax", "sha256": "c59b599a912dfbe757f346db515843be1349471c0c709ed66b796ec08ec1cdd1", "start_line": 25, "text": "syntax IntSeq ::= snocCode(IntSeq, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:26", "keyword": "rule", "sha256": "054d50d68e3621614137c41879522bb71d7967af1598a7dd30ae30b0ae0e1581", "start_line": 26, "text": "rule snocCode(.IntSeq, C:Int)                => iCons(C, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 30, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:27", "keyword": "rule", "sha256": "c5516997bf898755082c78c10ac5c780bdd332b8a71365119173ca7bba17c72f", "start_line": 27, "text": "rule snocCode(iCons(H:Int, T:IntSeq), C:Int) => iCons(H, snocCode(T, C))\n\n  // ==== set equality: two sets are equal iff mutually subsuming ==============\n  // subsetCodes(A, B) — every code of A occurs in B (duplicates in A are harmless)."}
{"category": "syntax:function,total", "end_line": 31, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:31", "keyword": "syntax", "sha256": "b1d04ee84fabe3f58ed28b05901d2634c5c530b5391f4673cdf9b2dedafdacc7", "start_line": 31, "text": "syntax Bool ::= subsetCodes(IntSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 32, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:32", "keyword": "rule", "sha256": "d53c3df008c30d16ebd9725d0b613f7ad07171dc2826338b4d3ea5fa2b6ec877", "start_line": 32, "text": "rule subsetCodes(.IntSeq, _:IntSeq)                => true"}
{"category": "rule:ordinary", "end_line": 34, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:33", "keyword": "rule", "sha256": "850be538170a9edb22a44a4ce2568f35b29fa79f58888e09984a4033d6aebbaf", "start_line": 33, "text": "rule subsetCodes(iCons(C:Int, S:IntSeq), B:IntSeq) => codeIn(C, B) andBool subsetCodes(S, B)"}
{"category": "syntax:function,total", "end_line": 35, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:35", "keyword": "syntax", "sha256": "6156266fe9d9b07a383778418b8a8a6b768dca1807dfad3ee0498cff0ecc75f7", "start_line": 35, "text": "syntax Bool ::= sameSet(IntSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 38, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:36", "keyword": "rule", "sha256": "74bedff665080b5e0c412ecb110cde61f04ebba6c5b62c46c1626a51fd9703fb", "start_line": 36, "text": "rule sameSet(A:IntSeq, B:IntSeq) => subsetCodes(A, B) andBool subsetCodes(B, A)\n\n  // set == set  (the only comparison sets support here)"}
{"category": "rule:ordinary", "end_line": 39, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:39", "keyword": "rule", "sha256": "7a5ed6b4e8d675889fbd0c888e0097b0f319b6b1c37872ccf6716c2f2afc0565", "start_line": 39, "text": "rule applyCmp(\"==\", setV(A:IntSeq), setV(B:IntSeq)) => sameSet(A, B)"}
{"category": "endmodule", "end_line": 40, "file": "reference-semantics/semantics/set.k", "id": "reference-semantics/semantics/set.k:40", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 40, "text": "endmodule"}
{"category": "module", "end_line": 10, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:10", "keyword": "module", "sha256": "2324159bdf28df653f286067082feb187a9e02a44c740456dae31b27022b595d", "start_line": 10, "text": "module MPY-SORT"}
{"category": "imports", "end_line": 11, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:11", "keyword": "imports", "sha256": "513b07985ad1b60ab1fc94f4a08021dd25a5b0aa218c3a975ce281a00395ddfa", "start_line": 11, "text": "imports MPY-BUILTINS"}
{"category": "imports", "end_line": 17, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:12", "keyword": "imports", "sha256": "afa5f4317540e548794244fb7d7f943cc5da28a580133599abbf3ecb0b378882", "start_line": 12, "text": "imports MPY-SUBSCRIPT\n\n  // sortVS(VS): the ascending sort of the Val list VS. Opaque for symbolic VS (no-evaluators);\n  // concrete insertion sort for krun.\n  // Concrete sort matches Int-sorted elements directly (an int Val IS an Int); projectIntTotal\n  // (lemmas-only) is not available in the semantics. Int and str lists."}
{"category": "syntax:function,total,symbol", "end_line": 18, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:18", "keyword": "syntax", "sha256": "c6d761b986e34bb35057126ad5885215fea615a238764749865f535e470fa43b", "start_line": 18, "text": "syntax ValSeq ::= sortVS(ValSeq) [function, total, symbol(sortVS), no-evaluators]"}
{"category": "syntax:function", "end_line": 19, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:19", "keyword": "syntax", "sha256": "0a76cca66b26bec5620b0fa0900cfbae5de0d5c61ed2c375e74ec5aed8aacf19", "start_line": 19, "text": "syntax ValSeq ::= insVS(Int, ValSeq) [function]"}
{"category": "rule:ordinary", "end_line": 20, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:20", "keyword": "rule", "sha256": "47b723f10a2368e5fff704a6fa6e3d8217ce25b51cba6fcd2ed2ab5ca9d0dc3e", "start_line": 20, "text": "rule sortVS(.ValSeq)                => .ValSeq          [concrete]"}
{"category": "rule:ordinary", "end_line": 21, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:21", "keyword": "rule", "sha256": "afe20c3cfa1af6db4fd20a8050faf019552807fa0b01572e504e92491be14b63", "start_line": 21, "text": "rule sortVS(vCons(X:Int, R:ValSeq)) => insVS(X, sortVS(R)) [concrete]"}
{"category": "rule:ordinary", "end_line": 22, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:22", "keyword": "rule", "sha256": "c51e9071fd27147763dcd3e70dd3dec2763d41c581efc7d97e52c558a5dba245", "start_line": 22, "text": "rule insVS(X:Int, .ValSeq)                => vCons(X, .ValSeq) [concrete]"}
{"category": "rule:ordinary", "end_line": 23, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:23", "keyword": "rule", "sha256": "e38dbfdea30a930ec41dc76e1fc86def100bfbfcfd88853d63d1fd9597a78ee5", "start_line": 23, "text": "rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(X, vCons(Y, R)) requires X <=Int Y [concrete]"}
{"category": "rule:ordinary", "end_line": 25, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:24", "keyword": "rule", "sha256": "28954fe82fc627d19d9106b7b8aefbf58205302cb51d87e690c4eb81cd4f0773", "start_line": 24, "text": "rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(Y, insVS(X, R)) requires X  >Int Y [concrete]\n  // str elements insert by the shared lexicographic strLt (methods.k)"}
{"category": "syntax:function", "end_line": 26, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:26", "keyword": "syntax", "sha256": "f778a322aece37266d282b5757dcb47aa66fbd6bcd3cb99133579990e1ea7411", "start_line": 26, "text": "syntax ValSeq ::= insVSs(IntSeq, ValSeq) [function]"}
{"category": "rule:ordinary", "end_line": 27, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:27", "keyword": "rule", "sha256": "f56269f2805fdf6e8a4ee27fc629bc2b5ad70b59c74649375bb93f7ddd171898", "start_line": 27, "text": "rule sortVS(vCons(str(CS:IntSeq), R:ValSeq)) => insVSs(CS, sortVS(R)) [concrete]"}
{"category": "rule:ordinary", "end_line": 28, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:28", "keyword": "rule", "sha256": "1f2df95775eb233969123f430eb5df8ccfc8e3c063894b7b20733a158307ff84", "start_line": 28, "text": "rule insVSs(A:IntSeq, .ValSeq) => vCons(str(A), .ValSeq) [concrete]"}
{"category": "rule:ordinary", "end_line": 30, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:29", "keyword": "rule", "sha256": "6da9281774d279068b274afd0b0295f08f640e9506dc7ce9f465d4f1029181fa", "start_line": 29, "text": "rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(A), vCons(str(B), R))\n       requires strLt(A, B) orBool A ==K B [concrete]"}
{"category": "rule:owise", "end_line": 35, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:31", "keyword": "rule", "sha256": "731e13d3d48843944fc3656f2b25f7203df775e45086d18666b42252cdd2f318", "start_line": 31, "text": "rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))\n       requires notBool (strLt(A, B) orBool A ==K B) [concrete]\n\n  // sorted(list) constructs a NEW object: k-cell pre-dispatch (beats the [owise]\n  // applyBuiltin routing in call.k) so the result allocates."}
{"category": "rule:ordinary", "end_line": 39, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:36", "keyword": "rule", "sha256": "2b476f2d74bbaefea2eeed9b8efda1aadd2b05ac9e747c8d6040ba96a0705061", "start_line": 36, "text": "rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), .Vals))\n        => #alloc(list(sortVS(VS))) ... </k>\n\n  // mutator: xs.sort() — the in-place heap write over the same trusted sortVS"}
{"category": "rule:priority(40)", "end_line": 48, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:40", "keyword": "rule", "sha256": "e2c12477dcb6997dd699d82a211261b7274290ebf178fe093701ebc8c6247e2c", "start_line": 40, "text": "rule <k> #applyK(toCall(boundMethodV(ref(H:Int), \"sort\")), .Vals) => noneV ... </k>\n       <heap> ... H |-> list(VS:ValSeq => sortVS(VS)) ... </heap>\n       [priority(40)]\n\n  // ==== keyed / reversed sorted() (WP2) =====================================\n  // sortKeyVS(VS, KV): the stable ascending sort of VS by the key value KV\n  // (a closure/builtin/type — anything callable). OPAQUE here; the concrete\n  // leg (MPY-CONCRETE, llvm only) computes keys by REAL calls and stable-\n  // inserts, at priority(40) over these."}
{"category": "syntax:function,total,symbol", "end_line": 50, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:49", "keyword": "syntax", "sha256": "f2ac55ee34d899f8dea02d048fbe04c31e9380eb65b24fe7a665a4c459a47fce", "start_line": 49, "text": "syntax ValSeq ::= sortKeyVS(ValSeq, Val) [function, total, symbol(sortKeyVS), no-evaluators]"}
{"category": "syntax:function,total", "end_line": 52, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:51", "keyword": "syntax", "sha256": "4cc64fd11b54ce15d4a917ce90ac5be549067bdf71d5d92c93618994d00d88ea", "start_line": 51, "text": "syntax ValSeq ::= revVS(ValSeq) [function, total]\n                  | revVSAcc(ValSeq, ValSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:53", "keyword": "rule", "sha256": "ce0aa18a536023617b5fa012c4896693902eb851d32017e9e0add330616fdfbd", "start_line": 53, "text": "rule revVS(S:ValSeq) => revVSAcc(S, .ValSeq)"}
{"category": "rule:ordinary", "end_line": 54, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:54", "keyword": "rule", "sha256": "726a2866a59e53374aab2b1bed31946a74b1866463d1adc19b016a7017ae08fd", "start_line": 54, "text": "rule revVSAcc(.ValSeq, A:ValSeq) => A"}
{"category": "rule:ordinary", "end_line": 56, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:55", "keyword": "rule", "sha256": "5fd679052347f58f5e3637566616cd1304da061a3232edc871028bc59707c5f3", "start_line": 55, "text": "rule revVSAcc(vCons(V:Val, R:ValSeq), A:ValSeq) => revVSAcc(R, vCons(V, A))"}
{"category": "syntax:function,total", "end_line": 57, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:57", "keyword": "syntax", "sha256": "7e8ff8d017c7edb7bd2d8f72a2de7fb5fcf8c1afde10e1aa97a2656fb519c6d3", "start_line": 57, "text": "syntax ValSeq ::= condRev(ValSeq, Bool) [function, total]"}
{"category": "rule:ordinary", "end_line": 58, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:58", "keyword": "rule", "sha256": "a1e37b0851c34a5eb84ec7d35cfb0b013cf9a4c94a656167b6fbc8fbe0204cea", "start_line": 58, "text": "rule condRev(S:ValSeq, false) => S"}
{"category": "rule:ordinary", "end_line": 60, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:59", "keyword": "rule", "sha256": "c4ff333dfa8c4fd77661cfcc932e6d8ec1a214410180c5ae2090aec9d2f40a63", "start_line": 59, "text": "rule condRev(S:ValSeq, true)  => revVS(S)"}
{"category": "rule:ordinary", "end_line": 62, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:61", "keyword": "rule", "sha256": "f3941ef082181a76260944a2df4e05e8e980e64aa398911bf716d6ff43a077a7", "start_line": 61, "text": "rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), .Vals))\n        => #alloc(list(sortKeyVS(VS, KV))) ... </k>"}
{"category": "rule:ordinary", "end_line": 64, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:63", "keyword": "rule", "sha256": "b949e0b45750cade476b7101537888f298c8a1c8b95aba14c01ebe0eb77d22e6", "start_line": 63, "text": "rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"key\", KV:Val), kwV(\"reverse\", RB:Bool), .Vals))\n        => #alloc(list(condRev(sortKeyVS(VS, KV), RB))) ... </k>"}
{"category": "rule:ordinary", "end_line": 71, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:65", "keyword": "rule", "sha256": "fdde2db3477f3ca576ecb0ff7fcafe93079795d0c757503edf269e3bdb3c1d2d", "start_line": 65, "text": "rule <k> #applyK(toCall(builtinV(\"sorted\")), (list(VS:ValSeq), kwV(\"reverse\", RB:Bool), .Vals))\n        => #alloc(list(condRev(sortVS(VS), RB))) ... </k>\n\n  // Indexing the opaque sorted list: `valSeqAt(sortVS(VS), I)` is DEFINED because valSeqAt is\n  // [total] (subscript.k) — it stays an abstract total value for a symbolic sort and reduces\n  // over the concrete sort for krun. No separate sortedAt indirection is needed; wrappers write\n  // their postcondition directly as valSeqAt(sortVS(VS), …)."}
{"category": "endmodule", "end_line": 72, "file": "reference-semantics/semantics/sort.k", "id": "reference-semantics/semantics/sort.k:72", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 72, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:3", "keyword": "module", "sha256": "6e503b11331c16b57328e9bf82938cba732cd5f1a51afa54ca44810b505a770a", "start_line": 3, "text": "module MPY-STR"}
{"category": "imports", "end_line": 4, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:4", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 4, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 7, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:5", "keyword": "imports", "sha256": "2f3edb691a018085c62944d1d5a16c651bfdd8d2e22007c629c3d76dfdcfe93a", "start_line": 5, "text": "imports MPY-ITER\n\n  // ==== iteration (the iterator protocol's str case; yields 1-char strings) =="}
{"category": "rule:ordinary", "end_line": 8, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:8", "keyword": "rule", "sha256": "5aea34cb3320cb4ceeee6e29d81d9d9643e3031241d8196ab67c866cf2cdd689", "start_line": 8, "text": "rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>"}
{"category": "rule:ordinary", "end_line": 12, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:9", "keyword": "rule", "sha256": "23ac9f9a320aa53cc0dcd15c7410b4282668c0f856c14a059308066b31032549", "start_line": 9, "text": "rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))\n        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>\n\n  // ==== str literal (ASCII-only) ============================================"}
{"category": "syntax:function", "end_line": 13, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:13", "keyword": "syntax", "sha256": "4c7f66efcd88665dff4c35a17dc03b67c9783ab5b67b51e3f1f429be8c12c225", "start_line": 13, "text": "syntax IntSeq ::= strToCodes(String) [function]"}
{"category": "rule:ordinary", "end_line": 14, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:14", "keyword": "rule", "sha256": "70d0a8a9935761aeff6d90853c1ce79fe6b2d3d84e32ade7a48810ae01e1c6bc", "start_line": 14, "text": "rule <k> Str(S:String) => str(strToCodes(S)) ... </k>"}
{"category": "rule:ordinary", "end_line": 15, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:15", "keyword": "rule", "sha256": "c7b4b4fc80bd1dab004d1c0cff5999112395445d816bdc9b0edecc99a8798b39", "start_line": 15, "text": "rule strToCodes(\"\") => .IntSeq"}
{"category": "rule:ordinary", "end_line": 19, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:16", "keyword": "rule", "sha256": "fcef828d29926c8be0cd4e489f4a71413b0575f14eb7c7a0e05c2e792cef32a9", "start_line": 16, "text": "rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))\n    requires S =/=String \"\" andBool ordChar(substrString(S, 0, 1)) <Int 128\n\n  // ==== operators: + / == / != / in ========================================="}
{"category": "syntax:function,total", "end_line": 20, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:20", "keyword": "syntax", "sha256": "4dcfe32d71db24ec5955e3d81daa08ca2c8c1c4249a4a4c3817f846f0b17c0f5", "start_line": 20, "text": "syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 21, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:21", "keyword": "rule", "sha256": "91549ced59459162b3f030f9e12b60194b79b081cabb8a3372199b240acf0dfd", "start_line": 21, "text": "rule seqConcat(.IntSeq, T:IntSeq)                => T"}
{"category": "rule:ordinary", "end_line": 23, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:22", "keyword": "rule", "sha256": "b8aaa07a8414960ab2e09a7e8d287988619c5616b854d3a0fa67a9011c4c911d", "start_line": 22, "text": "rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))"}
{"category": "rule:ordinary", "end_line": 24, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:24", "keyword": "rule", "sha256": "8fc5d2cd4bed1babf9e5d89c47d91fb3d37b0a7b67931e5df2f7b96ac4c1847a", "start_line": 24, "text": "rule applyBin(\"+\",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))"}
{"category": "rule:ordinary", "end_line": 25, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:25", "keyword": "rule", "sha256": "8039b62069c1e72239f18ede04a673fdc8c5822d023118b6a05d14faaa5bd94e", "start_line": 25, "text": "rule applyCmp(\"==\", str(A:IntSeq), str(B:IntSeq)) => A ==K B"}
{"category": "rule:ordinary", "end_line": 28, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:26", "keyword": "rule", "sha256": "0fe61d56dd0c3a6adda71091a6993477ab67fd29cf2727aa799595b20e4ea11c", "start_line": 26, "text": "rule applyCmp(\"!=\", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)\n\n  // substring membership: `P in X` iff the code-seq P occurs contiguously in X"}
{"category": "rule:ordinary", "end_line": 29, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:29", "keyword": "rule", "sha256": "96acbdc1af10881067d4b2edc285b58dbf1e9b04fed4a7af8b1b4d3ec84b6091", "start_line": 29, "text": "rule applyCmp(\"in\",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)"}
{"category": "rule:ordinary", "end_line": 31, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:30", "keyword": "rule", "sha256": "b646f3d3387b9d153ef8f01453f878e378af6f9923a2fa437887132d7ff05e8f", "start_line": 30, "text": "rule applyCmp(\"not in\", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)"}
{"category": "syntax:function,total", "end_line": 32, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:32", "keyword": "syntax", "sha256": "0c2a240d2f88394551e618a37947d5264f22335393502b4e0b535fe4ee17b42e", "start_line": 32, "text": "syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 33, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:33", "keyword": "rule", "sha256": "4144b55882343b7d74abbb053c9ceab8970ba16a65afb6398549dccfac300aa2", "start_line": 33, "text": "rule strPrefix(.IntSeq, _:IntSeq)               => true"}
{"category": "rule:ordinary", "end_line": 34, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:34", "keyword": "rule", "sha256": "0e758c7b129dc20e372ee10b7d456c59868ce228e665daed0b04bd14738c35df", "start_line": 34, "text": "rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false"}
{"category": "rule:ordinary", "end_line": 36, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:35", "keyword": "rule", "sha256": "d6816398ab1624e9bdb2e81cae94e7049aa5a1faab17f799f6e2d0563a83f669", "start_line": 35, "text": "rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)"}
{"category": "syntax:function,total", "end_line": 37, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:37", "keyword": "syntax", "sha256": "e5d82a70ec2aaeff27e0dbaebe4f7c40ff0ac2535c50906ea65726e53c9f7851", "start_line": 37, "text": "syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 38, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:38", "keyword": "rule", "sha256": "34700463fbce73098eed81cdf1ee13f8ba11e7188dcacab2c710fb5c9527d31f", "start_line": 38, "text": "rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)"}
{"category": "rule:ordinary", "end_line": 39, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:39", "keyword": "rule", "sha256": "af56f94634817e26d5ae76b054b84412d6768f5b43a8d82ed36a4937ec0dc4dc", "start_line": 39, "text": "rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)"}
{"category": "rule:ordinary", "end_line": 47, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:40", "keyword": "rule", "sha256": "3f727393a459b08bd1fe047bcef88651e54043f06fb96236006d95c781c6e8b5", "start_line": 40, "text": "rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)\n       requires notBool strPrefix(P, iCons(C, Xs))\n\n  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code\n  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones\n  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic\n  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on\n  // str </<=/>/>= comparisons."}
{"category": "syntax:function,total", "end_line": 48, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:48", "keyword": "syntax", "sha256": "e6a79420c495be30ba61123f1b16b3235ce1737390d5e7d920ed4d34624726c2", "start_line": 48, "text": "syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]"}
{"category": "rule:ordinary", "end_line": 49, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:49", "keyword": "rule", "sha256": "3dbb3480331f6b64c095ef6ae0b700cf565a8212397a978ae0c6a0e848b03b7f", "start_line": 49, "text": "rule strLt(.IntSeq, .IntSeq)                => false"}
{"category": "rule:ordinary", "end_line": 50, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:50", "keyword": "rule", "sha256": "1d055a6c97d452ded1f5b8522897bd99bfa0dd9ba3d5bab09339e76d0f414fbc", "start_line": 50, "text": "rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true"}
{"category": "rule:ordinary", "end_line": 51, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:51", "keyword": "rule", "sha256": "d1e1c922c4b206ef8c71888f6f964968eb7bc34ab9c172778c6243675c445926", "start_line": 51, "text": "rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false"}
{"category": "rule:ordinary", "end_line": 52, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:52", "keyword": "rule", "sha256": "1af5632197a6faa21f2063b495d5ecc1ae92eec0b7646529ecba82aff50ffafb", "start_line": 52, "text": "rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:53", "keyword": "rule", "sha256": "66583c4efcfdd0d9c8c6adde6b2ce95bde6253f060a18ca2d3a410f0c0ef8adc", "start_line": 53, "text": "rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B"}
{"category": "rule:ordinary", "end_line": 55, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:54", "keyword": "rule", "sha256": "d72e4a9c68cd264b7906d638a49bcf274a4fae7e0c350f191081f81696042a79", "start_line": 54, "text": "rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B"}
{"category": "rule:ordinary", "end_line": 56, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:56", "keyword": "rule", "sha256": "eca13b5d654378ccf3a238b38ee80140e0c546b4c7eb880e210f2032a5bde48c", "start_line": 56, "text": "rule applyCmp(\"<\",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)"}
{"category": "rule:ordinary", "end_line": 57, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:57", "keyword": "rule", "sha256": "8d9e17848541f3935a7eb29ff38727fcb72a6c88eced0c084a5453e02d23685a", "start_line": 57, "text": "rule applyCmp(\">\",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)"}
{"category": "rule:ordinary", "end_line": 58, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:58", "keyword": "rule", "sha256": "fd8254e2aad6ddc722ec79acfc57d3d9f56eeb5a7cedabedeb40aab07d805865", "start_line": 58, "text": "rule applyCmp(\"<=\", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)"}
{"category": "rule:ordinary", "end_line": 59, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:59", "keyword": "rule", "sha256": "0bb37c9e5117e140f89907947627e32d6756cc5e18e9518e3823c2710a62fc6c", "start_line": 59, "text": "rule applyCmp(\">=\", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)"}
{"category": "endmodule", "end_line": 60, "file": "reference-semantics/semantics/str.k", "id": "reference-semantics/semantics/str.k:60", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 60, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:3", "keyword": "module", "sha256": "a6d1f94e4e770f9c24016905d16a5d2ab9f0dcb7ac9955f1d47d6bd6fd7e4ded", "start_line": 3, "text": "module MPY-SUBSCRIPT"}
{"category": "imports", "end_line": 10, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:4", "keyword": "imports", "sha256": "9f33ed745f63b85e43ca3b5a2aae370e73c06c43e93bd2e34b19abbbfef56cb9", "start_line": 4, "text": "imports MPY-CORE\n\n  // ==== positional access + negative-index normalization (used only here) ===\n  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.\n  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the\n  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total\n  // atK. K trusts the [total] annotation; valid programs index in-bounds."}
{"category": "syntax:function,total", "end_line": 11, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:11", "keyword": "syntax", "sha256": "92dd5a3cbdae995653f421008f9fa2c2f911d143c899dee80374413a92482473", "start_line": 11, "text": "syntax Val ::= valSeqAt(ValSeq, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 12, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:12", "keyword": "rule", "sha256": "be09883d26ef7a167a1b7c21c9cc7c1ae77e2db2129f6cb2a29db81b397513b8", "start_line": 12, "text": "rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V"}
{"category": "rule:ordinary", "end_line": 15, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:13", "keyword": "rule", "sha256": "8a6a88c38c3decd88a8b8bed71298366c978babfb1bbe00a0f6cc16216db9721", "start_line": 13, "text": "rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)\n       requires I >Int 0"}
{"category": "syntax:function", "end_line": 16, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:16", "keyword": "syntax", "sha256": "d573fee41395263868cfcc4fbae6df6d4a3bcc1a7bca14e633a30ec4f77887a1", "start_line": 16, "text": "syntax Int ::= intSeqAt(IntSeq, Int) [function]"}
{"category": "rule:ordinary", "end_line": 17, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:17", "keyword": "rule", "sha256": "df3c3702e26dec79e2293d12005a00e2e57e83a023d4e5b4c10abf16fc5418ff", "start_line": 17, "text": "rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C"}
{"category": "rule:ordinary", "end_line": 20, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:18", "keyword": "rule", "sha256": "6dded3b88658dc880758486d34d0bd30bfea1f81a8228f7597fbeace1349d9e8", "start_line": 18, "text": "rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)\n       requires I >Int 0"}
{"category": "syntax:function,total", "end_line": 21, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:21", "keyword": "syntax", "sha256": "8d0629ddf60abdd87d1319c61a91897635eaf44a195cae23c3e4a9059fb8d475", "start_line": 21, "text": "syntax Int ::= normIdx(Int, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 22, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:22", "keyword": "rule", "sha256": "b98d45a6a45beab98faf69968542325a650d5e6805dac02b45519bfebe3115e7", "start_line": 22, "text": "rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0"}
{"category": "rule:ordinary", "end_line": 26, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:23", "keyword": "rule", "sha256": "70c411682f48997194fece35a1af53198cc8ab49aad6f3045b64ada2788ca53d", "start_line": 23, "text": "rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0\n\n  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================\n  // contexts (not strict attrs): the Index slot's Slice alternative must never heat"}
{"category": "context", "end_line": 27, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:27", "keyword": "context", "sha256": "e235a553cf7939b217e6aad3c563f19136b897acadf2bfa842db991933f28e85", "start_line": 27, "text": "context Subscript(HOLE, _)"}
{"category": "context", "end_line": 30, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:28", "keyword": "context", "sha256": "5b1ea90ce396aa7d7b7e3b7c62fd23dcfac82bb363fbfd3ec37260902448f6f5", "start_line": 28, "text": "context Subscript(_:Val, HOLE:Expr)\n\n  // heap-object deref (covers both the index and slice forms via the Index slot)"}
{"category": "rule:priority(40)", "end_line": 34, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:31", "keyword": "rule", "sha256": "14b58651f9c59c4b4f069d7f9fe90c2fb07b1daa3a9fd3f84d4707fbabac0bbb", "start_line": 31, "text": "rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "rule:ordinary", "end_line": 36, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:35", "keyword": "rule", "sha256": "e2cbe99533f0bbd2f5a28abaaea776b05e2d8eb2f238a9406b0c9ab6b8287633", "start_line": 35, "text": "rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>"}
{"category": "syntax:function", "end_line": 37, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:37", "keyword": "syntax", "sha256": "83aa86951e423ee652f166e56f679403febdfb828febf5216d59b54bda2753a5", "start_line": 37, "text": "syntax Val ::= applyIndex(Val, Int) [function]"}
{"category": "rule:ordinary", "end_line": 38, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:38", "keyword": "rule", "sha256": "48f741540df284d00a5203ed7cb63ffe03e24864a469f3e6667d435100b9c4b4", "start_line": 38, "text": "rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))"}
{"category": "rule:ordinary", "end_line": 39, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:39", "keyword": "rule", "sha256": "52ab84557b24a72bd0e049cec6cb67ec53e2d262f19c93e2abec650a0e856c1e", "start_line": 39, "text": "rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))"}
{"category": "rule:ordinary", "end_line": 43, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:40", "keyword": "rule", "sha256": "ae9ff89686ac25dfaeac537bea712e596b04688cb2bdc650579107a77df90ead", "start_line": 40, "text": "rule applyIndex(str(IS:IntSeq),   I:Int)\n    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))\n\n  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices =========="}
{"category": "syntax", "end_line": 48, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:44", "keyword": "syntax", "sha256": "170630aa9deeddb08509012149c60a38803e26774062674fa9f3653ed1fc2b30", "start_line": 44, "text": "syntax KItem ::= #evalB(Bound) | \"#toSome\"\n                 | #slLo(Val, Bound, Bound)\n                 | #slHi(Val, OptInt, Bound)\n                 | #slStep(Val, OptInt, OptInt)"}
{"category": "syntax", "end_line": 49, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:49", "keyword": "syntax", "sha256": "560ebb71a2e12f9a78694f384d19cb1d73190b6c9e724c4bdc202b583f111b3f", "start_line": 49, "text": "syntax OptInt ::= \"noB\" | someB(Int)"}
{"category": "rule:ordinary", "end_line": 50, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:50", "keyword": "rule", "sha256": "8bfda75b10b54d84f2970b20ff0a0ba47c5a1582d85d1650835cba648f8dd2da", "start_line": 50, "text": "rule <k> #evalB(NoBound)  => noB ... </k>"}
{"category": "rule:ordinary", "end_line": 51, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:51", "keyword": "rule", "sha256": "d96ec0c4fa393f873eb8cb7a071f04cd7dd79ef79fbc964d30418d3d9db92de9", "start_line": 51, "text": "rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>"}
{"category": "rule:ordinary", "end_line": 53, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:52", "keyword": "rule", "sha256": "55c49487ba7821307656b279fb60c670618fe70606d57783c776ef4b2986550c", "start_line": 52, "text": "rule <k> I:Int ~> #toSome => someB(I) ... </k>"}
{"category": "rule:ordinary", "end_line": 54, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:54", "keyword": "rule", "sha256": "b39cd50c6c413a35564da1aa0434956df105d8e124a63f8867bec71c7c410abd", "start_line": 54, "text": "rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>"}
{"category": "rule:ordinary", "end_line": 55, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:55", "keyword": "rule", "sha256": "57331568a526494bc1ff498a0a5b2114937bca02783d0c84cb66f20539625dc0", "start_line": 55, "text": "rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>"}
{"category": "rule:ordinary", "end_line": 57, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:56", "keyword": "rule", "sha256": "9de5529341d6097ada2c96c350de569a0438d12b65aac3bf0b8c9aee97225076", "start_line": 56, "text": "rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>\n  // a list slice constructs a NEW object; a str slice stays a value"}
{"category": "rule:priority(45)", "end_line": 60, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:58", "keyword": "rule", "sha256": "a66a9e5be1e7b2f6bbbe045b6ad2869abcb8989cec6f6e78e9a521e8f0f6581d", "start_line": 58, "text": "rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)\n        => #alloc(doSlice(list(VS), LO, HI, ST)) ... </k>\n       [priority(45)]"}
{"category": "rule:ordinary", "end_line": 62, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:61", "keyword": "rule", "sha256": "4b6c937f1b27b309ca57781e12cde5632c9fe631b46769f8b5fb2ae27e5d3559", "start_line": 61, "text": "rule <k> ST:OptInt ~> #slStep(OBJ:Val, LO:OptInt, HI:OptInt) => doSlice(OBJ, LO, HI, ST) ... </k>"}
{"category": "syntax:function", "end_line": 63, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:63", "keyword": "syntax", "sha256": "35803b4f4140c58723c0e31492a1715f532186e38b4e9b68650e58ae677e48dd", "start_line": 63, "text": "syntax Val ::= doSlice(Val, OptInt, OptInt, OptInt) [function]"}
{"category": "rule:ordinary", "end_line": 65, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:64", "keyword": "rule", "sha256": "42ed1f69b35deec92310fe03510da9c2a37e756a0adb052784bc11c1fc52f6f9", "start_line": 64, "text": "rule doSlice(list(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)\n    => list(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))"}
{"category": "rule:ordinary", "end_line": 67, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:66", "keyword": "rule", "sha256": "82d3fca1e37ef65abb108a2ffbd5e3856ac8386e187e95b9ecc4ec29cd05de8d", "start_line": 66, "text": "rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)\n    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))"}
{"category": "rule:ordinary", "end_line": 71, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:68", "keyword": "rule", "sha256": "82024279903dcd3acfe4b3025fdb70009743a732985b36c0ac70ba88124c4612", "start_line": 68, "text": "rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)\n    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))\n\n  // ==== slice.indices: step / start / stop / clamp =========================="}
{"category": "syntax:function,total", "end_line": 72, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:72", "keyword": "syntax", "sha256": "3673727509ac1987488ad8a299c7a4a1ed9143e108520907ed8ae746269699c8", "start_line": 72, "text": "syntax Int ::= slStep(OptInt) [function, total]"}
{"category": "rule:ordinary", "end_line": 73, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:73", "keyword": "rule", "sha256": "7c2511c1afc342c2d553e1959b388621634664d4626695f54f090959e2c08708", "start_line": 73, "text": "rule slStep(noB)          => 1"}
{"category": "rule:ordinary", "end_line": 75, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:74", "keyword": "rule", "sha256": "38520b2d08df510dd573e03a40c5d25b7f8b89388b18d9d7aec6e9196ba1f6a1", "start_line": 74, "text": "rule slStep(someB(S:Int)) => S"}
{"category": "syntax:function", "end_line": 76, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:76", "keyword": "syntax", "sha256": "12940b25c9d85c4c575623a2d2085f8f09acda4390e58e7e27114df698e02858", "start_line": 76, "text": "syntax Int ::= slStart(OptInt, OptInt, Int) [function]"}
{"category": "rule:ordinary", "end_line": 78, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:77", "keyword": "rule", "sha256": "d1245451058bb3c0c957f1a47dfda9f5136da320f3183dd3d6379b089a553a0d", "start_line": 77, "text": "rule slStart(noB,          ST:OptInt, _LEN:Int) => 0\n       requires slStep(ST) >Int 0"}
{"category": "rule:ordinary", "end_line": 80, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:79", "keyword": "rule", "sha256": "32a8543ade1c9b387ccd61c6528748030ab4d7ffc9b5c17fc25dc71e45b33315", "start_line": 79, "text": "rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1\n       requires slStep(ST) <Int 0"}
{"category": "rule:ordinary", "end_line": 82, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:81", "keyword": "rule", "sha256": "eb72ac47325f36eab2b1f75d90b37e2f060ce5cce5db37d982ea3dbb2fdb54b4", "start_line": 81, "text": "rule slStart(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))"}
{"category": "syntax:function", "end_line": 83, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:83", "keyword": "syntax", "sha256": "def902114717732bd04bddb5459b883a7e72943d9905a006fa2908eeda667d1b", "start_line": 83, "text": "syntax Int ::= slStop(OptInt, OptInt, Int) [function]"}
{"category": "rule:ordinary", "end_line": 85, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:84", "keyword": "rule", "sha256": "74fd2b418d136a0d4e2f1066d1f30495fb6ec4ac2b756a0fcc39a633968f2ddc", "start_line": 84, "text": "rule slStop(noB,          ST:OptInt, LEN:Int)  => LEN\n       requires slStep(ST) >Int 0"}
{"category": "rule:ordinary", "end_line": 87, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:86", "keyword": "rule", "sha256": "ff38d06e869ba9148e1565bfbdc58ef1cd52fb7bb1dd8da4c9a8d80bd51d0822", "start_line": 86, "text": "rule slStop(noB,          ST:OptInt, _LEN:Int) => -1\n       requires slStep(ST) <Int 0"}
{"category": "rule:ordinary", "end_line": 89, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:88", "keyword": "rule", "sha256": "adb5792d38521a88f1a82243e1c7db65a737c5b2beed6609f0fbd74a1da361a3", "start_line": 88, "text": "rule slStop(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))"}
{"category": "syntax:function,total", "end_line": 90, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:90", "keyword": "syntax", "sha256": "9ec1896aa81dbda8d1ea3e6687ee086beea967bc3822cd10a318a2f04b3aa7bd", "start_line": 90, "text": "syntax Int ::= slAdjust(Int, Int, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 92, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:91", "keyword": "rule", "sha256": "a33fd3355164980a7b81150468f75b21b27956222891746bbbb393cb00aa9d48", "start_line": 91, "text": "rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampLo(I +Int LEN, STEP)\n       requires I  <Int 0"}
{"category": "rule:ordinary", "end_line": 95, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:93", "keyword": "rule", "sha256": "753b0f615233dc67e880e5a1eeb0af65070701049bcadae53877e9f9ca767d71", "start_line": 93, "text": "rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampHi(I, LEN, STEP)\n       requires I >=Int 0"}
{"category": "syntax:function,total", "end_line": 96, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:96", "keyword": "syntax", "sha256": "74b1e671d5bc2675c57a6e37b0517ae907a75fd226523c01205ef0a8bd3ac2f3", "start_line": 96, "text": "syntax Int ::= clampLo(Int, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 98, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:97", "keyword": "rule", "sha256": "e393553cb99a0f663462f3e98f06f0badc59cdf05209a3b3aaa1e2d8242d8607", "start_line": 97, "text": "rule clampLo(J:Int, _STEP:Int) => J\n       requires J >=Int 0"}
{"category": "rule:ordinary", "end_line": 101, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:99", "keyword": "rule", "sha256": "df573f70389c9107530abad570d1dde79cd95b5bd734e403a30875a84f4b062a", "start_line": 99, "text": "rule clampLo(J:Int, STEP:Int)  => #if STEP <Int 0 #then -1 #else 0 #fi\n       requires J <Int 0"}
{"category": "syntax:function,total", "end_line": 102, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:102", "keyword": "syntax", "sha256": "cf49fd584aa0aaff635d15fbfb5b3e627a19462ba2e20a330262744fbc4167da", "start_line": 102, "text": "syntax Int ::= clampHi(Int, Int, Int) [function, total]"}
{"category": "rule:ordinary", "end_line": 104, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:103", "keyword": "rule", "sha256": "edcd350fd0b87c45b1526d6ca691de986f5a27e6d7352971a3b9beaf187349f9", "start_line": 103, "text": "rule clampHi(I:Int, LEN:Int, _STEP:Int) => I\n       requires I  <Int LEN"}
{"category": "rule:ordinary", "end_line": 108, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:105", "keyword": "rule", "sha256": "c51f07fcd2336c5e9c97aefc9571216f0498a3895eb43054d63e09e8ab018f4b", "start_line": 105, "text": "rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi\n       requires I >=Int LEN\n\n  // ==== build the strided sub-sequence (indices in range by construction) ===="}
{"category": "syntax:function", "end_line": 109, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:109", "keyword": "syntax", "sha256": "328023ed05394848428d502f2282a83f2f6fce266a9ff7c7187134b098872146", "start_line": 109, "text": "syntax ValSeq ::= buildVS(ValSeq, Int, Int, Int) [function]"}
{"category": "rule:ordinary", "end_line": 112, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:110", "keyword": "rule", "sha256": "32b99cf6a66ccbf1514b605edb1e9b1e3fad8a9cf3df4304944c87d03734ecaf", "start_line": 110, "text": "rule buildVS(VS:ValSeq, I:Int, STOP:Int, STEP:Int)\n    => vCons(valSeqAt(VS, I), buildVS(VS, I +Int STEP, STOP, STEP))\n       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)"}
{"category": "rule:ordinary", "end_line": 115, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:113", "keyword": "rule", "sha256": "257fa9fa471a082206d53edd2212ef00e8ef13ae44dc075acad531294a3d1b2d", "start_line": 113, "text": "rule buildVS(_:ValSeq, I:Int, STOP:Int, STEP:Int) => .ValSeq\n       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))"}
{"category": "syntax:function", "end_line": 116, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:116", "keyword": "syntax", "sha256": "0a55bc39332ca672124112c173cf443fc87f1059e0eab1577ce827bbbc559228", "start_line": 116, "text": "syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]"}
{"category": "rule:ordinary", "end_line": 119, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:117", "keyword": "rule", "sha256": "443572026d5c99c86f44df390aa49b751079f99a2bf804b07191fb4a75b3d1ed", "start_line": 117, "text": "rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)\n    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))\n       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)"}
{"category": "rule:ordinary", "end_line": 121, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:120", "keyword": "rule", "sha256": "0f259c668431d90b167f6b9d8bf12ac07490fd6cf6f229df56d546bca1261206", "start_line": 120, "text": "rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq\n       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))"}
{"category": "endmodule", "end_line": 122, "file": "reference-semantics/semantics/subscript.k", "id": "reference-semantics/semantics/subscript.k:122", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 122, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:3", "keyword": "module", "sha256": "f08baa14168e33e40c6ea094538294709ff69e62fe8705a5b36d30f64f9b9e58", "start_line": 3, "text": "module MPY-SYNTAX"}
{"category": "imports", "end_line": 4, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:4", "keyword": "imports", "sha256": "549ff9577e48f84166cff97c44b34be0e7224b138ffc651802ef6e9dcfde5500", "start_line": 4, "text": "imports INT-SYNTAX"}
{"category": "imports", "end_line": 5, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:5", "keyword": "imports", "sha256": "57afda1786d22d995573523f49342280f158fcd841d333439b17a44120be7b40", "start_line": 5, "text": "imports FLOAT-SYNTAX"}
{"category": "imports", "end_line": 6, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:6", "keyword": "imports", "sha256": "53df7c7bde9742b651b6208bf2d29aed7e6cfec6eeed12c7af5ebc790e3c8608", "start_line": 6, "text": "imports BOOL-SYNTAX"}
{"category": "imports", "end_line": 8, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:7", "keyword": "imports", "sha256": "5a171c0d093c3345d9e07e15e5f3768211a92909782e475d3d50063a338f319c", "start_line": 7, "text": "imports STRING-SYNTAX"}
{"category": "syntax:macro", "end_line": 31, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:9", "keyword": "syntax", "sha256": "b137de7fc427a41cde26087776c1ea5758c1826ec753fa78c7c633c1ad99b621", "start_line": 9, "text": "syntax Expr ::= \"Int\"      \"(\" Int \")\"\n                | \"Float\"    \"(\" Float \")\"\n                | \"Bool\"     \"(\" Bool \")\"\n                | \"Name\"     \"(\" String \")\"\n                | \"Str\"      \"(\" String \")\"\n                | \"UnaryOp\"  \"(\" String \",\" Expr \")\" [strict(2)]\n                | \"BinOp\"    \"(\" String \",\" Expr \",\" Expr \")\" [seqstrict(2, 3)]\n                | \"BoolOp\"    \"(\" String \",\" Exprs \")\"\n                | \"ListExpr\"  \"(\" Exprs \")\"\n                | \"DictExpr\"  \"(\" Entries \")\"\n                | \"ListComp\"  \"(\" Expr \",\" CompFors \")\" [macro]\n                | \"GenExp\"    \"(\" Expr \",\" CompFors \")\" [macro]\n                | \"TupleExpr\" \"(\" Exprs \")\"\n                | \"Subscript\" \"(\" Expr \",\" Index \")\"\n                | \"IfExp\"     \"(\" Expr \",\" Expr \",\" Expr \")\" [strict(1)]\n                | \"Lambda\"    \"(\" Params \",\" Expr \")\"\n                | \"KwArg\"     \"(\" String \",\" Expr \")\"\n                | \"Lambda\"    \"(\" Params \",\" CellVars \",\" FreeVars \",\" Expr \")\"\n                | \"NoneVal\"\n                | \"Call\"      \"(\" Expr \",\" Exprs \")\"\n                | \"Attribute\" \"(\" Expr \",\" String \")\" [strict(1)]\n                | \"Compare\"   \"(\" Expr \",\" CmpOp \")\""}
{"category": "syntax", "end_line": 32, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:32", "keyword": "syntax", "sha256": "79e0572a08cb7fe6c891dbccbbfa0fe54ff80f037e0bc33a358552675d4d1e31", "start_line": 32, "text": "syntax CmpOp    ::= \"CmpOp\" \"(\" String \",\" Expr \")\""}
{"category": "syntax", "end_line": 33, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:33", "keyword": "syntax", "sha256": "8985681d39e21efc4b2289c4f2c77cd54399853c604e0a863cdc1f964edb85ea", "start_line": 33, "text": "syntax Entry    ::= \"Entry\" \"(\" Expr \",\" Expr \")\""}
{"category": "syntax", "end_line": 34, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:34", "keyword": "syntax", "sha256": "1523104ecc07741aa692ef0b772b71a26386fcfb9e92d9b7df7db55937601302", "start_line": 34, "text": "syntax Entries  ::= List{Entry, \",\"}"}
{"category": "syntax", "end_line": 35, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:35", "keyword": "syntax", "sha256": "d77836cca454196368732a11215208cbeee9e1828ecdba5cae603e223b15f474", "start_line": 35, "text": "syntax CompFor  ::= \"CompFor\" \"(\" Expr \",\" Expr \",\" Exprs \")\""}
{"category": "syntax", "end_line": 36, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:36", "keyword": "syntax", "sha256": "76d2ff7278fb79223076a48063fb3990b4456a793dc2ebc0dae8979f1c8a8177", "start_line": 36, "text": "syntax CompFors ::= List{CompFor, \"\"}"}
{"category": "syntax", "end_line": 37, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:37", "keyword": "syntax", "sha256": "e680c1e2f7b6932d3b0f3cb4a8f7c91636d1bc0f5c5d6787efe98eb417cc753b", "start_line": 37, "text": "syntax Exprs    ::= List{Expr, \",\"}"}
{"category": "syntax", "end_line": 38, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:38", "keyword": "syntax", "sha256": "b3f9e60ba967a610d0c91cff30e593327bfecfcd11e23d502dca5d77515364c2", "start_line": 38, "text": "syntax Index    ::= Expr | \"Slice\" \"(\" Bound \",\" Bound \",\" Bound \")\""}
{"category": "syntax", "end_line": 40, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:39", "keyword": "syntax", "sha256": "c5203ebf142244980b90423134b2a01ed50a5f89d833b42bdbf5510e5857d9c7", "start_line": 39, "text": "syntax Bound    ::= Expr | \"NoBound\""}
{"category": "syntax", "end_line": 55, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:41", "keyword": "syntax", "sha256": "6e900c516e20a2540b81928072d3279f4d22e5429c0316f77c42570a420b3c34", "start_line": 41, "text": "syntax Stmt ::= \"Assign\"    \"(\" Expr \",\" Expr \")\" [strict(2)]\n                | \"Import\"    \"(\" String \")\"\n                | \"ImportFrom\" \"(\" String \",\" ParamNames \")\"\n                | \"AugAssign\" \"(\" Expr \",\" String \",\" Expr \")\" [strict(3)]\n                | \"For\"       \"(\" Expr \",\" Expr \",\" Stmts \")\" [strict(2)]\n                | \"While\"     \"(\" Expr \",\" Stmts \")\"\n                | \"Break\"\n                | \"Continue\"\n                | \"If\"        \"(\" Expr \",\" Stmts \",\" Stmts \")\" [strict(1)]\n                | \"Return\"    \"(\" Expr \")\" [strict]\n                | \"Assert\"    \"(\" Expr \")\" [strict]\n                | \"Expr\"      \"(\" Expr \")\" [strict]\n                | \"FuncDef\"   \"(\" String \",\" Params \",\" Stmts \")\"\n                | \"FuncDef\"   \"(\" String \",\" Params \",\" CellVars \",\" FreeVars \",\" Stmts \")\""}
{"category": "syntax", "end_line": 56, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:56", "keyword": "syntax", "sha256": "c2eb1faa5708b02c2a2f441aacb5368f28580f601d4183b911aa35e98784f0cb", "start_line": 56, "text": "syntax Stmts      ::= List{Stmt, \"\"}"}
{"category": "syntax", "end_line": 57, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:57", "keyword": "syntax", "sha256": "bc2dc3cfbacd711751a50d9a9fb25b147845b06b405fc6ca133cc352d8189fab", "start_line": 57, "text": "syntax Params     ::= \"Params\" \"(\" ParamNames \")\""}
{"category": "syntax", "end_line": 58, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:58", "keyword": "syntax", "sha256": "6081c51206f12c5739aeca75441dee0eaba5de7d97d784adc1f0544f06c053e5", "start_line": 58, "text": "syntax CellVars   ::= \"CellVars\" \"(\" ParamNames \")\""}
{"category": "syntax", "end_line": 59, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:59", "keyword": "syntax", "sha256": "2bd8e51bc504ed4f6f3fc93f39a88c66be89cfb43367a3727e1d3e71fee64d25", "start_line": 59, "text": "syntax FreeVars   ::= \"FreeVars\" \"(\" ParamNames \")\""}
{"category": "syntax", "end_line": 60, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:60", "keyword": "syntax", "sha256": "8788a8da7c08b959b55f76539af04c5a55abe26a1584ada00a2820ee79b3501e", "start_line": 60, "text": "syntax ParamNames ::= List{String, \",\"}"}
{"category": "syntax", "end_line": 61, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:61", "keyword": "syntax", "sha256": "f7e6da5815fd19921a3635de4c564d6ace28f9e89e3f7bd13c67cb0141fdd2a8", "start_line": 61, "text": "syntax Module     ::= \"Module\" \"(\" Stmts \")\""}
{"category": "endmodule", "end_line": 62, "file": "reference-semantics/semantics/syntax.k", "id": "reference-semantics/semantics/syntax.k:62", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 62, "text": "endmodule"}
{"category": "module", "end_line": 3, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:3", "keyword": "module", "sha256": "a660cd1e92e23d91d092c593b0d7ec83407e40b5085309e11090d5b01bc4f030", "start_line": 3, "text": "module MPY-TUPLE"}
{"category": "imports", "end_line": 4, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:4", "keyword": "imports", "sha256": "4258a966960e81238ac1318ebb92f5cd383bcf94ed5077b6dea55341a4254bfd", "start_line": 4, "text": "imports MPY-CORE"}
{"category": "imports", "end_line": 5, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:5", "keyword": "imports", "sha256": "8ad41781e06e91093b117ccd78f6f10180a840cf3b4adaa62547edd340b26acc", "start_line": 5, "text": "imports MPY-ITER"}
{"category": "imports", "end_line": 6, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:6", "keyword": "imports", "sha256": "511c798e04e96a7ad3e9efe5e06eb4804d66d38f1294d62d46068dc7eafb0373", "start_line": 6, "text": "imports MPY-LIST"}
{"category": "imports", "end_line": 9, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:7", "keyword": "imports", "sha256": "56f0ef3874c2e99b8f1cd267165c377ab6b71cb800fcaa92537c5ddb7a82090e", "start_line": 7, "text": "imports MPY-METHODS\n\n  // ==== iteration (the iterator protocol's tuple case) ======================"}
{"category": "rule:ordinary", "end_line": 10, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:10", "keyword": "rule", "sha256": "8571b818781fcb6d4f8ce6210f43b60c7608d9e4b21cdb66cf3eca84dd3be2b6", "start_line": 10, "text": "rule <k> #iterNext(tuple(.ValSeq))                => #iterDone ... </k>"}
{"category": "rule:ordinary", "end_line": 13, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:11", "keyword": "rule", "sha256": "e5c34d4ffbb67a2f14398ee7ded9b30df6be4bd7186872e3656e0959b155d02c", "start_line": 11, "text": "rule <k> #iterNext(tuple(vCons(V:Val, R:ValSeq))) => #iterYield(V, tuple(R)) ... </k>\n\n  // ==== TupleExpr: tuple(ValSeq) literal + == != ==========================="}
{"category": "syntax", "end_line": 14, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:14", "keyword": "syntax", "sha256": "508a95f61aed6d1129b9e3f84b2cc6d4021eb25accb256e816573049feff554b", "start_line": 14, "text": "syntax ApplyK ::= \"toTuple\""}
{"category": "rule:ordinary", "end_line": 15, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:15", "keyword": "rule", "sha256": "ff193ea2849e97ee999677d4a6b7f490cbe8fd917a21c5b418eb6620def33124", "start_line": 15, "text": "rule <k> TupleExpr(ES:Exprs) => #evalArgs(ES, .Vals, toTuple) ... </k>"}
{"category": "rule:ordinary", "end_line": 17, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:16", "keyword": "rule", "sha256": "b0d84d481730d06c5882783cccdcdbaf7a0b81c185e990531bf607fc1dc9b01d", "start_line": 16, "text": "rule <k> #applyK(toTuple, ACC:Vals) => tuple(vals2valSeq(ACC)) ... </k>"}
{"category": "rule:ordinary", "end_line": 19, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:18", "keyword": "rule", "sha256": "85f06205d3ecef62754a5ea95a68659d8110dd661c78dc265171ee0cf9dc130b", "start_line": 18, "text": "rule applyCmp(\"==\", tuple(A:ValSeq), tuple(B:ValSeq)) => A ==K B\n  // membership routes through the same k-cell fold as lists (list.k)"}
{"category": "rule:ordinary", "end_line": 20, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:20", "keyword": "rule", "sha256": "1b68f3cf2df91641f7e1b1b007cc4dee3ed266a97bf68d8d4a09b260f4302cf5", "start_line": 20, "text": "rule <k> Compare(LV:Val, CmpOp(\"in\",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>"}
{"category": "rule:ordinary", "end_line": 22, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:21", "keyword": "rule", "sha256": "0233eca330175bd1af79e05caa340e6c3bf94df7609aa0ccc66ca16ac4f8ed88", "start_line": 21, "text": "rule <k> Compare(LV:Val, CmpOp(\"not in\", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>\n  // t.index(v): first index of v (ValueError out of subset)"}
{"category": "rule:ordinary", "end_line": 23, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:23", "keyword": "rule", "sha256": "bd7254bbf1105af77c015d6c37e329774f93ff7da7628dac38536f793e7eaf75", "start_line": 23, "text": "rule applyMethod(tuple(VS:ValSeq), \"index\", V:Val, .Vals) => idxOfVS(VS, V, 0)"}
{"category": "syntax:function", "end_line": 24, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:24", "keyword": "syntax", "sha256": "df13ef70912b4ded4f2c2f97e50011c9ef936dff982309cfb623b77d247755d2", "start_line": 24, "text": "syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]"}
{"category": "rule:ordinary", "end_line": 25, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:25", "keyword": "rule", "sha256": "663f7ddf889dc5c9c1fd12455b160afe66ad15883ae2930da18fb89d423d57ce", "start_line": 25, "text": "rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V"}
{"category": "rule:ordinary", "end_line": 27, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:26", "keyword": "rule", "sha256": "0fcb8941c5fc3d71e019dca0cb1011e84f0d0d47c5f618a354ed45440f9b2a84", "start_line": 26, "text": "rule idxOfVS(vCons(A:Val, R:ValSeq), V:Val, I:Int) => idxOfVS(R, V, I +Int 1)\n       requires notBool (A ==K V)"}
{"category": "rule:ordinary", "end_line": 30, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:28", "keyword": "rule", "sha256": "92c93d1c09ed3a91032d3aec64049a6a89228c39442e3ec656254b46ece0cd9f", "start_line": 28, "text": "rule applyCmp(\"!=\", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)\n\n  // ==== target binding: bind a Name or a TupleExpr target to a value ========"}
{"category": "syntax", "end_line": 31, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:31", "keyword": "syntax", "sha256": "98b229b9b4321ace7e17cbcc2dc0408fe6d1dfad46dffa400d30f3c40ccaad7d", "start_line": 31, "text": "syntax KItem ::= #bindTgt(Expr, Val)"}
{"category": "rule:ordinary", "end_line": 34, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:32", "keyword": "rule", "sha256": "14aff46eab0fb42f6a6bd83a9d70ac41e6be836a74c8deafc84ece8b02811880", "start_line": 32, "text": "rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>"}
{"category": "rule:priority(40)", "end_line": 41, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:35", "keyword": "rule", "sha256": "00b05b2c0ef54d7e09c2574e1614faee4c01e3cfb82e8a3bf8eea0fa0af55059", "start_line": 35, "text": "rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>\n       <env> L:Int </env>\n       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\n       requires \"$cells\" in_keys(M)\n        andBool pnMember(X, cellsOf({M[\"$cells\"]}:>Val))\n        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)\n       [priority(40)]"}
{"category": "rule:ordinary", "end_line": 42, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:42", "keyword": "rule", "sha256": "0d5b4092fa171333cbf5df6b548b5769cbb17dc4e57757e026b955c62cd7a9f3", "start_line": 42, "text": "rule <k> #bindTgt(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>"}
{"category": "rule:ordinary", "end_line": 43, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:43", "keyword": "rule", "sha256": "ac45b93d13bf624aec5e0ee2d85da280de4edc0774af30809dad8ee46150b5ea", "start_line": 43, "text": "rule <k> #bindTgt(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>"}
{"category": "rule:priority(40)", "end_line": 48, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:44", "keyword": "rule", "sha256": "1dd8a5c94687cd4b794557ed2a59c28073ee80d6f60db1e23ea421a3a2c3a219", "start_line": 44, "text": "rule <k> #bindTgt(TupleExpr(TS:Exprs), ref(H:Int)) => #bindTgt(TupleExpr(TS), V) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]\n\n  // ==== unpacking: a, b = <tuple|list> (RHS evaluated by strictness) ========"}
{"category": "syntax", "end_line": 49, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:49", "keyword": "syntax", "sha256": "7dbe45ad3aa2cd3bf8ecd6f3515826ea6cbe564d227a73d51ed9eb4c590411e1", "start_line": 49, "text": "syntax KItem ::= #unpackSeq(Exprs, ValSeq)"}
{"category": "rule:ordinary", "end_line": 50, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:50", "keyword": "rule", "sha256": "3187abeadb723949255c0b48fe693a94615b14483be47e07de1b13b7a83b4a5c", "start_line": 50, "text": "rule <k> Assign(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>"}
{"category": "rule:ordinary", "end_line": 51, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:51", "keyword": "rule", "sha256": "867fac1e6227828b100d1e341659e7101780962206666885b564814e0491670e", "start_line": 51, "text": "rule <k> Assign(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>"}
{"category": "rule:priority(40)", "end_line": 54, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:52", "keyword": "rule", "sha256": "c2d1189c7fd5e16df427f20cce12ab10008fb3699738d96c2652106c538a0438", "start_line": 52, "text": "rule <k> Assign(TupleExpr(TS:Exprs), ref(H:Int)) => Assign(TupleExpr(TS), V) ... </k>\n       <heap> ... H |-> V:Val ... </heap>\n       [priority(40)]"}
{"category": "rule:ordinary", "end_line": 56, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:55", "keyword": "rule", "sha256": "006177fc1c708b4ab272564fe7da88666b684cebb14f423a757718fc5191b581", "start_line": 55, "text": "rule <k> #unpackSeq((T:Expr, TS:Exprs), vCons(V:Val, VS:ValSeq))\n        => #bindTgt(T, V) ~> #unpackSeq(TS, VS) ... </k>"}
{"category": "rule:ordinary", "end_line": 57, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:57", "keyword": "rule", "sha256": "2377fb943da101e36f2c0d35e43554ee1815fe1b1fe043893a271defc9620fd7", "start_line": 57, "text": "rule <k> #unpackSeq(.Exprs, .ValSeq) => .K ... </k>"}
{"category": "endmodule", "end_line": 58, "file": "reference-semantics/semantics/tuple.k", "id": "reference-semantics/semantics/tuple.k:58", "keyword": "endmodule", "sha256": "4c5df27adc717388cee7175c70de02f160d4f9a8e25c48eb0fc23e1968ad13f4", "start_line": 58, "text": "endmodule"}
