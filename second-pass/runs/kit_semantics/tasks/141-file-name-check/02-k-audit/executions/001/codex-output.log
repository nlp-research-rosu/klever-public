/bin/bash -lc "sed -n '1,220p' /reference/reference-semantics/semantics/range.k; sed -n '1,220p' /reference/reference-semantics/semantics/set.k; sed -n '1,260p' /reference/reference-semantics/semantics/list.k; sed -n '1,260p' /reference/reference-semantics/semantics/tuple.k; sed -n '1,220p' /reference/reference-semantics/semantics/comprehension.k; sed -n '1,260p' /reference/reference-semantics/semantics/dict.k; sed -n '1,160p' /reference/reference-semantics/semantics/assert.k; sed -n '1,120p' /reference/reference-semantics/semantics/iter.k" in /audit-output
