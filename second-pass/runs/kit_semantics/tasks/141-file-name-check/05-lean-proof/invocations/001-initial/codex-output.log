codex
The root cause is concrete and local: this Lean 4.22 runtime resolves `/proc/<getpid()>/exe`, but the container’s PID namespace exposes only `/proc/self/exe`, so both Lean and Lake fail before elaboration. I’m applying a temporary process-local `readlink` compatibility shim for the build only; it does not modify the pinned toolchain, project configuration, Base, or proof sources.
apply patch
patch: completed
/tmp/lean_app_path_shim.c
diff --git a//tmp/lean_app_path_shim.c b//tmp/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..3b465067bddc640239c3b01bc13bc87ed9ed8ac0
--- /dev/null
+++ b//tmp/lean_app_path_shim.c
@@ -0,0 +1,15 @@
+#define _GNU_SOURCE
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  size_t length = strlen(path);
+  if (length > 10 &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    path = "/proc/self/exe";
+  }
+  return syscall(SYS_readlink, path, buffer, size);
+}
