Module(
  FuncDef("file_name_check", Params("file_name"),
    If(Compare(
      Call(Attribute(Name("file_name"), "count"), Str(".")),
      CmpOp("!=", Int(1))),
      Return(Str("No")),
      )
    If(Compare(
      Subscript(Name("file_name"), Int(0)),
      CmpOp(
        "not in",
        Str("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"))),
      Return(Str("No")),
      )
    If(UnaryOp(
      "not",
      BoolOp(
        "or",
        Compare(
          Subscript(
            Name("file_name"),
            Slice(UnaryOp("-", Int(4)), NoBound, NoBound)),
          CmpOp("==", Str(".txt"))),
        Compare(
          Subscript(
            Name("file_name"),
            Slice(UnaryOp("-", Int(4)), NoBound, NoBound)),
          CmpOp("==", Str(".exe"))),
        Compare(
          Subscript(
            Name("file_name"),
            Slice(UnaryOp("-", Int(4)), NoBound, NoBound)),
          CmpOp("==", Str(".dll"))))),
      Return(Str("No")),
      )
    If(Compare(
      BinOp(
        "+",
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      BinOp(
                        "+",
                        Call(
                          Attribute(Name("file_name"), "count"),
                          Str("0")),
                        Call(
                          Attribute(Name("file_name"), "count"),
                          Str("1"))),
                      Call(
                        Attribute(Name("file_name"), "count"),
                        Str("2"))),
                    Call(
                      Attribute(Name("file_name"), "count"),
                      Str("3"))),
                  Call(Attribute(Name("file_name"), "count"), Str("4"))),
                Call(Attribute(Name("file_name"), "count"), Str("5"))),
              Call(Attribute(Name("file_name"), "count"), Str("6"))),
            Call(Attribute(Name("file_name"), "count"), Str("7"))),
          Call(Attribute(Name("file_name"), "count"), Str("8"))),
        Call(Attribute(Name("file_name"), "count"), Str("9"))),
      CmpOp(">", Int(3))),
      Return(Str("No")),
      )
    Return(Str("Yes"))))
