+)
+used = _parse_axioms(output)
+allowed = _allowed_axioms(inventory)
+generated_names = {
+    entry["name"] for entry in inventory["allowlist"]
+}
+standard_core_allowance = {
+    "Classical.choice",
+    "propext",
+    "Quot.sound",
+}
+unexpected = sorted(used - allowed)
+checks = {
