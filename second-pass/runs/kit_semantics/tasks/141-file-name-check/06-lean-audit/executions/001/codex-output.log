+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+audit = json.loads(AUDIT_INPUT.read_text())
+source_manifest = json.loads((BUNDLE / "source-manifest.json").read_text())
+generator = json.loads(GENERATOR_MANIFEST.read_text())
