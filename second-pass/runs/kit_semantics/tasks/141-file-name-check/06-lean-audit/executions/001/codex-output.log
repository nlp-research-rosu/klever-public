+    Klean141FileNameCheck.Lemmas.targetStatement
+      constantFalseGt Proof.«_<=Int_» := by
+  intro _N _h
+  rfl
+
+example : constantFalseGt 4 3 ≠ Proof.«_>Int_» 4 3 := by decide
+
+def reversedLe (x0 x1 : SortInt) : SortBool := x0 >= x1
+
+example : reversedLe 4 3 ≠ Proof.«_<=Int_» 4 3 := by decide
+example : reversedLe (-100) 3 ≠ Proof.«_<=Int_» (-100) 3 := by decide
+
