     1	def file_name_check(file_name):
     2	    if file_name.count(".") != 1:
     3	        return "No"
     4	    if file_name[0] not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ":
     5	        return "No"
     6	    if not (
     7	        file_name[-4:] == ".txt"
     8	        or file_name[-4:] == ".exe"
     9	        or file_name[-4:] == ".dll"
    10	    ):
    11	        return "No"
    12	    if (
    13	        file_name.count("0")
    14	        + file_name.count("1")
    15	        + file_name.count("2")
    16	        + file_name.count("3")
    17	        + file_name.count("4")
    18	        + file_name.count("5")
    19	        + file_name.count("6")
