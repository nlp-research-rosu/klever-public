      "start_line": 9,
      "text": "  rule fileNameCheckBody\n    => If(\n         Compare(\n           Call(Attribute(Name(\"file_name\"), \"count\"), Str(\".\")),\n           CmpOp(\"!=\", Int(1))),\n         Return(Str(\"No\")),\n         .Stmts)\n       If(\n         Compare(\n           Subscript(Name(\"file_name\"), Int(0)),\n           CmpOp(\n             \"not in\",\n             Str(\"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"))),\n         Return(Str(\"No\")),\n         .Stmts)\n       If(\n         UnaryOp(\n           \"not\",\n           BoolOp(\n             \"or\",\n             Compare(\n               Subscript(\n                 Name(\"file_name\"),\n                 Slice(UnaryOp(\"-\", Int(4)), NoBound, NoBound)),\n               CmpOp(\"==\", Str(\".txt\"))),\n             Compare(\n               Subscript(\n                 Name(\"file_name\"),\n                 Slice(UnaryOp(\"-\", Int(4)), NoBound, NoBound)),\n               CmpOp(\"==\", Str(\".exe\"))),\n             Compare(\n               Subscript(\n                 Name(\"file_name\"),\n                 Slice(UnaryOp(\"-\", Int(4)), NoBound, NoBound)),\n               CmpOp(\"==\", Str(\".dll\"))))),\n         Return(Str(\"No\")),\n         .Stmts)\n       If(\n         Compare(\n           BinOp(\n             \"+\",\n             BinOp(\n               \"+\",\n               BinOp(\n                 \"+\",\n                 BinOp(\n                   \"+\",\n                   BinOp(\n                     \"+\",\n                     BinOp(\n                       \"+\",\n                       BinOp(\n                         \"+\",\n                         BinOp(\n                           \"+\",\n                           BinOp(\n                             \"+\",\n                             Call(\n                               Attribute(Name(\"file_name\"), \"count\"),\n                               Str(\"0\")),\n                             Call(\n                               Attribute(Name(\"file_name\"), \"count\"),\n                               Str(\"1\"))),\n                           Call(\n                             Attribute(Name(\"file_name\"), \"count\"),\n                             Str(\"2\"))),\n                         Call(\n                           Attribute(Name(\"file_name\"), \"count\"),\n                           Str(\"3\"))),\n                       Call(\n                         Attribute(Name(\"file_name\"), \"count\"),\n                         Str(\"4\"))),\n                     Call(\n                       Attribute(Name(\"file_name\"), \"count\"),\n                       Str(\"5\"))),\n                   Call(\n                     Attribute(Name(\"file_name\"), \"count\"),\n                     Str(\"6\"))),\n                 Call(\n                   Attribute(Name(\"file_name\"), \"count\"),\n                   Str(\"7\"))),\n               Call(\n                 Attribute(Name(\"file_name\"), \"count\"),\n                 Str(\"8\"))),\n             Call(\n               Attribute(Name(\"file_name\"), \"count\"),\n               Str(\"9\"))),\n           CmpOp(\">\", Int(3))),\n         Return(Str(\"No\")),\n         .Stmts)\n       Return(Str(\"Yes\"))"
