+
+namespace BridgeChecks
+
+example : Proof.«_>Int_» 4 3 = true := by decide
+example : Proof.«_>Int_» 3 3 = false := by decide
+example : Proof.«_>Int_» (-100) 3 = false := by decide
+example : Proof.«_>Int_» 9223372036854775808 3 = true := by decide
+
+example : Proof.«_<=Int_» 4 3 = false := by decide
+example : Proof.«_<=Int_» 3 3 = true := by decide
+example : Proof.«_<=Int_» (-100) 3 = true := by decide
+example : Proof.«_<=Int_» 9223372036854775808 3 = false := by decide
+
+def constantFalseGt (_x0 _x1 : SortInt) : SortBool := false
+
+theorem constantFalseStillProvesGeneratedEquation :
+    Klean141FileNameCheck.Lemmas.targetStatement
+      constantFalseGt Proof.«_<=Int_» := by
+  intro _N _h
+  rfl
+
+example : constantFalseGt 4 3 ≠ Proof.«_>Int_» 4 3 := by decide
+
+def reversedLe (x0 x1 : SortInt) : SortBool := x0 >= x1
+
+example : reversedLe 4 3 ≠ Proof.«_<=Int_» 4 3 := by decide
+example : reversedLe (-100) 3 ≠ Proof.«_<=Int_» (-100) 3 := by decide
+
+end BridgeChecks
