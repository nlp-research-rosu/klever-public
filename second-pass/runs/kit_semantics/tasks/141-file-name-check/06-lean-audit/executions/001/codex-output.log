+    "classified_ids_unique": len(classified_ids) == len(set(classified_ids)),
+    "same_rule_count": len(canonical_ids) == len(classified_ids),
+    "contract_validation_completed": True,
+}
+print(
+    json.dumps(
+        {
+            "inventory": inventory,
+            "manifest_rules": discovery["rules"],
+            "validated_partition": {
