     6	  // binRel(N, ACC, OUT) defines the sequence produced by completing the
     7	  // repeated-divide-by-two loop from N with the already accumulated suffix
     8	  // ACC.  Its three guards are disjoint and cover all mathematical integers.
     9	  syntax Bool ::= binRel(Int, IntSeq, IntSeq) [function, total]
    10	
    11	  rule binRel(N, ACC, OUT) => ACC ==K OUT
    12	    requires N ==Int 0
    13	
    14	  rule binRel(N, ACC, OUT)
    15	    => binRel(
    16	         (N -Int pyMod(N, 2)) /Int 2,
    17	         iCons(48 +Int pyMod(N, 2), ACC),
    18	         OUT)
    19	    requires N >Int 0
    20	
    21	  rule binRel(N, _ACC, _OUT) => false
    22	    requires N <Int 0
    23	
    24	  // The executable loop starts with the trailing "db" already in ACC.  The
    25	  // task-level result then has a literal leading "db" followed by TAIL.
    26	  syntax Bool ::= decimalTailRel(Int, IntSeq) [function, total]
    27	
    28	  rule decimalTailRel(N, TAIL)
    29	    => TAIL ==K iCons(48, iCons(100, iCons(98, .IntSeq)))
    30	    requires N ==Int 0
    31	
    32	  rule decimalTailRel(N, TAIL)
    33	    => binRel(N, iCons(100, iCons(98, .IntSeq)), TAIL)
    34	    requires N >Int 0
    35	
    36	  rule decimalTailRel(N, _TAIL) => false
    37	    requires N <Int 0
    38	
    39	  syntax Bool ::= decimalResultRel(Int, IntSeq) [function, total]
    40	
    41	  rule decimalResultRel(N, iCons(100, iCons(98, TAIL)))
    42	    => decimalTailRel(N, TAIL)
    43	
    44	  rule decimalResultRel(_N, _CODES) => false [owise]
    45	endmodule
     1	def decimal_to_binary(decimal):
     2	    binary = "db"
     3	    if decimal == 0:
     4	        binary = "0" + binary
     5	    while decimal != 0:
     6	        binary = chr(48 + decimal % 2) + binary
     7	        decimal = decimal // 2
     8	    return "db" + binary
