+sha256sum "$scratch/regenerated-solution.mpy" /candidate/solution.mpy
+hash_status=$?
+echo "SHA256_EXIT_STATUS=$hash_status"
+
+echo '$ python3 /audit-output/evidence/differential.py'
+python3 /audit-output/evidence/differential.py
+diff_status=$?
