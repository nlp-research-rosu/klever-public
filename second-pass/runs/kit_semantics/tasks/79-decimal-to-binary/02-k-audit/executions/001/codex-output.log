index 0000000000000000000000000000000000000000..57d0340ba68c887b62296e472212a5ae4f5d69f1
--- /dev/null
+++ b/evidence/run_adequacy_and_pinning.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+echo '$ python3 /audit-output/evidence/adequacy_and_pinning.py'
