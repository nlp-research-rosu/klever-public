+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/79-audit/fidelity
+mkdir -p "$scratch"
+
+echo '$ python3 /reference/py2mpy.py /candidate/solution.py > /tmp/audit-work/79-audit/fidelity/regenerated-solution.mpy'
