diff --git a/evidence/run_static_review.sh b/evidence/run_static_review.sh
new file mode 100644
index 0000000000000000000000000000000000000000..4ef334bdb30f91b86461d5e65fbed1f9b01d75b2
--- /dev/null
+++ b/evidence/run_static_review.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
