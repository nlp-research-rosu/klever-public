    14	    Examples:
    15	    decimal_to_binary(15)   # returns "db1111db"
    16	    decimal_to_binary(32)   # returns "db100000db"
    17	    """
    18	    return "db" + bin(decimal)[2:] + "db"

===== /candidate/solution.py =====
     1	def decimal_to_binary(decimal):
     2	    binary = "db"
     3	    if decimal == 0:
     4	        binary = "0" + binary
     5	    while decimal != 0:
     6	        binary = chr(48 + decimal % 2) + binary
     7	        decimal = decimal // 2
     8	    return "db" + binary

