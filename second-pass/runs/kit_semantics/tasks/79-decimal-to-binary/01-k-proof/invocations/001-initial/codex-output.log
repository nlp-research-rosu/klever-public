The call-level proof is still running after 55 seconds, while the loop theorem is already closed. I’m letting the command’s 90-second cap expire so any residual reflects the function setup/teardown rather than an interrupted trace.
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..44bdee043c8f5a97f236f12c22acebc3385235b6
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,15 @@
+def decimal_to_binary(decimal):
+    binary = ""
+    if decimal == 0:
+        binary = "0"
+    while decimal != 0:
+        binary = chr(48 + decimal % 2) + binary
+        decimal = decimal // 2
+    return "db" + binary + "db"
+
+
+assert decimal_to_binary(0) == "db0db"
+assert decimal_to_binary(1) == "db1db"
+assert decimal_to_binary(15) == "db1111db"
+assert decimal_to_binary(32) == "db100000db"
+assert decimal_to_binary(255) == "db11111111db"
