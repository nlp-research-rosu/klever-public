+              Compare(Name("decimal"), CmpOp(">", Int(0))),
+              If(
+                Compare(
+                  BinOp("%", Name("decimal"), Int(2)),
+                  CmpOp("==", Int(0))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("0"), Name("binary"))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("1"), Name("binary"))))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(
+              BinOp(
+                "+",
+                BinOp("+", Str("db"), Name("binary")),
+                Str("db"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
