+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Machine-checked separately by CONNECTION-SPEC against VERIFICATION-BASE,
+  // which does not contain this simplification lemma.
+  rule binRel(N, ACC, binAcc(N, ACC)) => true
+    requires N >=Int 0
+    [simplification]
+endmodule

