diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec7b8b764b064d0b8f1d629799a0ddfaf2d0e6b5
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,106 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant:
+  // The premise threads the result property through each real iteration:
+  // binAcc(current, accumulator) is always binCodes(original).
+  claim [binary-loop]:
+    <k>
+      #while(
+        Compare(Name("decimal"), CmpOp("!=", Int(0))),
+        If(
+          Compare(
+            BinOp("%", Name("decimal"), Int(2)),
+            CmpOp("==", Int(0))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("0"), Name("binary"))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("1"), Name("binary"))))
+        Assign(
+          Name("decimal"),
+          BinOp("//", Name("decimal"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope(MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "binary"  |-> (str(ACC:IntSeq) => str(binCodes(ORIGINAL)))
+        "decimal" |-> (N:Int => 0)
+        "original" |-> ORIGINAL:Int,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+      andBool binAcc(N, ACC) ==K binCodes(ORIGINAL)
+
+  // Exact invocation of the translated function body under its real binding.
+  claim [decimal-to-binary]:
+    <k>
+      Call(
+        Name("decimal_to_binary"),
+        (N:Int, .Exprs))
+      => str(
+           iCons(100,
+             iCons(98,
+               seqConcat(
+                 binCodes(N),
+                 iCons(100, iCons(98, .IntSeq))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "decimal_to_binary" |->
+          closureVal(
+            ("decimal", .ParamNames),
+            Assign(Name("original"), Name("decimal"))
+            Assign(Name("binary"), Str(""))
+            If(
+              Compare(Name("decimal"), CmpOp("==", Int(0))),
+              Assign(Name("binary"), Str("0")),
+              .Stmts)
+            While(
+              Compare(Name("decimal"), CmpOp("!=", Int(0))),
+              If(
+                Compare(
+                  BinOp("%", Name("decimal"), Int(2)),
+                  CmpOp("==", Int(0))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("0"), Name("binary"))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("1"), Name("binary"))))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(
+              BinOp(
+                "+",
+                BinOp("+", Str("db"), Name("binary")),
+                Str("db"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ac8d5060035229c28b17cfb5d31e27a791a51120
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Guarded generalization of the fixed base equation binAcc(0, ACC) => ACC.
+  // It lets the backend use a path equality E == 0 when E is not syntactically
+  // the literal zero.
+  rule binAcc(N, ACC) => ACC
+    requires N ==Int 0
+    [simplification]
+endmodule

