diff --git a/verification-base.k b/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..c00bce5abf5eeb9956d255d298bd7d3a8d77e080
--- /dev/null
+++ b/verification-base.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // Relational form of the binary accumulator recurrence.  Unlike binAcc,
+  // its zero case is guarded rather than syntactically restricted to literal
+  // 0, so a symbolic loop-exit path can use it without unbounded unfolding.
+  syntax Bool ::= binRel(Int, IntSeq, IntSeq) [function, total]
+
+  rule binRel(N, ACC, TARGET) => ACC ==K TARGET
+    requires N ==Int 0
+
+  rule binRel(N, ACC, TARGET)
+    => binRel(
+         (N -Int pyMod(N, 2)) /Int 2,
+         iCons(48 +Int pyMod(N, 2), ACC),
+         TARGET)
+    requires N >Int 0
+
+  rule binRel(N, _ACC, _TARGET) => false
+    requires N <Int 0
+endmodule
