+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant:
+  // The premise threads the result property through each real iteration:
+  // binAcc(current, accumulator) is always binCodes(original).
+  claim [binary-loop-many]:
+    <k>
+      #while(
+        Compare(Name("decimal"), CmpOp("!=", Int(0))),
+        If(
+          Compare(
+            BinOp("%", Name("decimal"), Int(2)),
+            CmpOp("==", Int(0))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("0"), Name("binary"))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("1"), Name("binary"))))
+        Assign(
+          Name("decimal"),
+          BinOp("//", Name("decimal"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope(MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "binary"  |-> (str(ACC:IntSeq) => str(binCodes(ORIGINAL)))
+        "decimal" |-> (N:Int => 0)
+        "original" |-> ORIGINAL:Int,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+      andBool binAcc(N, ACC) ==K binCodes(ORIGINAL)
+
+  // Concrete inductive base: one real iteration turns 1 into 0 and prepends
+  // the code for "1".
+  claim [binary-loop-one]:
+    <k>
+      #while(
+        Compare(Name("decimal"), CmpOp("!=", Int(0))),
+        If(
+          Compare(
+            BinOp("%", Name("decimal"), Int(2)),
+            CmpOp("==", Int(0))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("0"), Name("binary"))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("1"), Name("binary"))))
+        Assign(
+          Name("decimal"),
+          BinOp("//", Name("decimal"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope(MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "binary"  |-> (str(ACC:IntSeq) => str(binCodes(ORIGINAL)))
+        "decimal" |-> (1 => 0)
+        "original" |-> ORIGINAL:Int,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires binAcc(1, ACC) ==K binCodes(ORIGINAL)
+
+  // Exact invocation of the translated function body for every positive input.
+  claim [decimal-to-binary-positive]:
+    <k>
+      Call(
+        Name("decimal_to_binary"),
+        (N:Int, .Exprs))
+      => str(
+           iCons(100,
+             iCons(98,
+               seqConcat(
+                 binCodes(N),
+                 iCons(100, iCons(98, .IntSeq))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "decimal_to_binary" |->
+          closureVal(
+            ("decimal", .ParamNames),
+            Assign(Name("original"), Name("decimal"))
+            Assign(Name("binary"), Str(""))
+            If(
+              Compare(Name("decimal"), CmpOp("==", Int(0))),
+              Assign(Name("binary"), Str("0")),
+              .Stmts)
+            While(
+              Compare(Name("decimal"), CmpOp("!=", Int(0))),
+              If(
+                Compare(
+                  BinOp("%", Name("decimal"), Int(2)),
+                  CmpOp("==", Int(0))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("0"), Name("binary"))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("1"), Name("binary"))))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(
+              BinOp(
+                "+",
+                BinOp("+", Str("db"), Name("binary")),
+                Str("db"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+
+  // The zero input takes the explicit initialization branch and then skips
+  // the loop.  This claim plus the positive claim covers all N >= 0.
+  claim [decimal-to-binary-zero]:
+    <k>
+      Call(
+        Name("decimal_to_binary"),
+        (0, .Exprs))
+      => str(
+           iCons(100,
+             iCons(98,
+               iCons(48,
+                 iCons(100, iCons(98, .IntSeq))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "decimal_to_binary" |->
+          closureVal(
+            ("decimal", .ParamNames),
+            Assign(Name("original"), Name("decimal"))
+            Assign(Name("binary"), Str(""))
+            If(
+              Compare(Name("decimal"), CmpOp("==", Int(0))),
+              Assign(Name("binary"), Str("0")),
+              .Stmts)
+            While(
+              Compare(Name("decimal"), CmpOp("!=", Int(0))),
+              If(
+                Compare(
+                  BinOp("%", Name("decimal"), Int(2)),
+                  CmpOp("==", Int(0))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("0"), Name("binary"))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("1"), Name("binary"))))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(
+              BinOp(
+                "+",
+                BinOp("+", Str("db"), Name("binary")),
+                Str("db"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
