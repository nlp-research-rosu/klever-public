+            CmpOp("==", Int(0))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("0"), Name("binary"))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("1"), Name("binary"))))
+        Assign(
+          Name("decimal"),
+          BinOp("//", Name("decimal"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
