requires "verification.k"

module SPEC
  imports VERIFICATION

  // Loop invariant:
  // The premise threads the result property through each real iteration:
  // binAcc(current, accumulator) is always binCodes(original).
  claim [binary-loop]:
    <k>
      #while(
        Compare(Name("decimal"), CmpOp(">", Int(0))),
        If(
          Compare(
            BinOp("%", Name("decimal"), Int(2)),
            CmpOp("==", Int(0))),
          Assign(
            Name("binary"),
            BinOp("+", Str("0"), Name("binary"))),
          Assign(
            Name("binary"),
            BinOp("+", Str("1"), Name("binary"))))
        Assign(
          Name("decimal"),
          BinOp("//", Name("decimal"), Int(2))))
      => .K
      ...
    </k>
    <env> 1 </env>
    <scopes>
      0  |-> scope(MODULE:Map, parent(-1))
      -1 |-> builtinsScope
      1  |-> scope(
        "binary"  |-> (str(ACC:IntSeq) => str(binCodes(ORIGINAL)))
        "decimal" |-> (N:Int => 0),
        "original" |-> ORIGINAL:Int,
        parent(0))
    </scopes>
    <scopeLoc> 2 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> STACK:List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 0
      andBool binAcc(N, ACC) ==K binCodes(ORIGINAL)

  // Exact invocation of the translated function body under its real binding.
  claim [decimal-to-binary]:
    <k>
      Call(
        Name("decimal_to_binary"),
        (N:Int, .Exprs))
      => str(
           iCons(100,
             iCons(98,
               seqConcat(
                 binCodes(N),
                 iCons(100, iCons(98, .IntSeq))))))
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        "decimal_to_binary" |->
          closureVal(
            ("decimal", .ParamNames),
            Assign(Name("original"), Name("decimal"))
            Assign(Name("binary"), Str(""))
            If(
              Compare(Name("decimal"), CmpOp("==", Int(0))),
              Assign(Name("binary"), Str("0")),
              .Stmts)
            While(
              Compare(Name("decimal"), CmpOp(">", Int(0))),
              If(
                Compare(
                  BinOp("%", Name("decimal"), Int(2)),
                  CmpOp("==", Int(0))),
                Assign(
                  Name("binary"),
                  BinOp("+", Str("0"), Name("binary"))),
                Assign(
                  Name("binary"),
                  BinOp("+", Str("1"), Name("binary"))))
              Assign(
                Name("decimal"),
                BinOp("//", Name("decimal"), Int(2))))
            Return(
              BinOp(
                "+",
                BinOp("+", Str("db"), Name("binary")),
                Str("db"))),
            0),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 0
endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..d195424fd9e30c308f0e76c21729f6df33e2c41b
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,19 @@
+def decimal_to_binary(decimal):
+    original = decimal
+    binary = ""
+    if decimal == 0:
+        binary = "0"
+    while decimal > 0:
+        if decimal % 2 == 0:
+            binary = "0" + binary
+        else:
+            binary = "1" + binary
+        decimal = decimal // 2
+    return "db" + binary + "db"
+
+
+assert decimal_to_binary(0) == "db0db"
+assert decimal_to_binary(1) == "db1db"
+assert decimal_to_binary(15) == "db1111db"
+assert decimal_to_binary(32) == "db100000db"
+assert decimal_to_binary(255) == "db11111111db"
