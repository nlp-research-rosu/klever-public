+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant:
+  // The premise threads the result property through each real iteration:
+  // binAcc(current, accumulator) is always binCodes(original).
+  claim [binary-loop]:
+    <k>
+      #while(
+        Compare(Name("decimal"), CmpOp("!=", Int(0))),
+        If(
+          Compare(
+            BinOp("%", Name("decimal"), Int(2)),
+            CmpOp("==", Int(0))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("0"), Name("binary"))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("1"), Name("binary"))))
+        Assign(
+          Name("decimal"),
+          BinOp("//", Name("decimal"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope(MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "binary"  |-> (str(ACC:IntSeq) => str(binCodes(ORIGINAL)))
+        "decimal" |-> (N:Int => 0)
+        "original" |-> ORIGINAL:Int,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+      andBool binAcc(N, ACC) ==K binCodes(ORIGINAL)
+
+  // Exact invocation of the translated function body under its real binding.
+  claim [decimal-to-binary]:
+    <k>
+      Call(
+        Name("decimal_to_binary"),
+        (N:Int, .Exprs))
+      => str(
+           iCons(100,
+             iCons(98,
+               seqConcat(
+                 binCodes(N),
+                 iCons(100, iCons(98, .IntSeq))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "decimal_to_binary" |->
+          closureVal(
+            ("decimal", .ParamNames),
+            Assign(Name("original"), Name("decimal"))
+            Assign(Name("binary"), Str(""))
+            If(
+              Compare(Name("decimal"), CmpOp("==", Int(0))),
+              Assign(Name("binary"), Str("0")),
+              .Stmts)
+            While(
+              Compare(Name("decimal"), CmpOp("!=", Int(0))),
+              If(
+                Compare(
+                  BinOp("%", Name("decimal"), Int(2)),
+                  CmpOp("==", Int(0))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("0"), Name("binary"))),
+                Assign(
+                  Name("binary"),
+                  BinOp("+", Str("1"), Name("binary"))))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(
+              BinOp(
+                "+",
+                BinOp("+", Str("db"), Name("binary")),
+                Str("db"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f6a876a5a138870e9b904b3776726a25781f0141
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Guarded use of the fixed base equation binAcc(0, ACC) => ACC inside
+  // equality obligations.  Keeping the rule at Bool sort avoids unfolding a
+  // symbolic binAcc term merely to test whether its argument might be zero.
+  rule (binAcc(N, ACC) ==K B:IntSeq) => (ACC ==K B)
+    requires N ==Int 0
+    [simplification]
+endmodule

codex
The remaining obstacle is confined to the transition where a symbolic quotient is known equal to zero. I’m removing the helper rule and expressing the induction with explicit semantic base and recursive claims: one claim for current value `1`, one for `N ≥ 2`, plus separate whole-function claims for input `0` and positive inputs. Together they still cover every nonnegative integer, while every base reduction becomes syntactically concrete.
