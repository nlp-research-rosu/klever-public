+def decimal_to_binary(decimal):
+    binary = "db"
+    if decimal == 0:
+        binary = "0" + binary
+    while decimal != 0:
+        binary = chr(48 + decimal % 2) + binary
+        decimal = decimal // 2
+    return "db" + binary
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..20f9c9806188a66a76ed73e7eb36ee422b2a3e31
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,59 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // The closure is materially mutated from 48 + n % 2 to 49 + n % 2.
+  // For decimal=2 it must not establish the real result "db10db".
+  claim [mutated-body]:
+    <k>
+      Call(Name("decimal_to_binary"), (2, .Exprs))
+      => str(
+           iCons(100,
+             iCons(98,
+               iCons(49,
+                 iCons(48,
+                   iCons(100, iCons(98, .IntSeq)))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "decimal_to_binary" |->
+          closureVal(
+            ("decimal", .ParamNames),
+            Assign(Name("binary"), Str("db"))
+            If(
+              Compare(Name("decimal"), CmpOp("==", Int(0))),
+              Assign(
+                Name("binary"),
+                BinOp("+", Str("0"), Name("binary"))),
+              .Stmts)
+            While(
+              Compare(Name("decimal"), CmpOp("!=", Int(0))),
+              Assign(
+                Name("binary"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    BinOp(
+                      "+",
+                      Int(49),
+                      BinOp("%", Name("decimal"), Int(2)))),
+                  Name("binary")))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(BinOp("+", Str("db"), Name("binary"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..b683b67c49119bf9d3ccba1e0e4c7ccca639958e
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,58 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false for the satisfiable witness decimal=0:
+  // the real result is "db0db", not "db1db".
+  claim [wrong-zero-result]:
+    <k>
+      Call(Name("decimal_to_binary"), (0, .Exprs))
+      => str(
+           iCons(100,
+             iCons(98,
+               iCons(49,
+                 iCons(100, iCons(98, .IntSeq))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "decimal_to_binary" |->
+          closureVal(
+            ("decimal", .ParamNames),
+            Assign(Name("binary"), Str("db"))
+            If(
+              Compare(Name("decimal"), CmpOp("==", Int(0))),
+              Assign(
+                Name("binary"),
+                BinOp("+", Str("0"), Name("binary"))),
+              .Stmts)
+            While(
+              Compare(Name("decimal"), CmpOp("!=", Int(0))),
+              Assign(
+                Name("binary"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    BinOp(
+                      "+",
+                      Int(48),
+                      BinOp("%", Name("decimal"), Int(2)))),
+                  Name("binary")))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(BinOp("+", Str("db"), Name("binary"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b352588a86885a426ec13e57efa4c35ca621ad8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,106 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant: the actual loop returns a digit sequence satisfying the
+  // guarded base-2 recurrence from its current integer and accumulator.
+  claim [binary-loop]:
+    <k>
+      #while(
+        Compare(Name("decimal"), CmpOp("!=", Int(0))),
+        Assign(
+          Name("binary"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              BinOp(
+                "+",
+                Int(48),
+                BinOp("%", Name("decimal"), Int(2)))),
+            Name("binary")))
+        Assign(
+          Name("decimal"),
+          BinOp("//", Name("decimal"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope(
+        "decimal_to_binary" |-> FUNCTION:Val,
+        parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "binary"  |-> (str(ACC:IntSeq) => str(?OUT:IntSeq))
+        "decimal" |-> (N:Int => 0),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    ensures binRel(N, ACC, ?OUT)
+
+  // Exact invocation of the translated function body under its real binding.
+  // The complete result code sequence is constrained by decimalResultRel.
+  claim [decimal-to-binary]:
+    <k>
+      Call(
+        Name("decimal_to_binary"),
+        (N:Int, .Exprs))
+      => str(?CODES:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "decimal_to_binary" |->
+          closureVal(
+            ("decimal", .ParamNames),
+            Assign(Name("binary"), Str("db"))
+            If(
+              Compare(Name("decimal"), CmpOp("==", Int(0))),
+              Assign(
+                Name("binary"),
+                BinOp("+", Str("0"), Name("binary"))),
+              .Stmts)
+            While(
+              Compare(Name("decimal"), CmpOp("!=", Int(0))),
+              Assign(
+                Name("binary"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    BinOp(
+                      "+",
+                      Int(48),
+                      BinOp("%", Name("decimal"), Int(2)))),
+                  Name("binary")))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(
+              BinOp(
+                "+",
+                Str("db"),
+                Name("binary"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    ensures decimalResultRel(N, ?CODES)
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5bc37a5acdc67dddb9e2fe33dd502552f04809d
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,26 @@
+import ast
+from pathlib import Path
+
+from solution import decimal_to_binary
+
+
+def function_ast(path):
+    tree = ast.parse(Path(path).read_text(encoding="utf-8"), filename=path)
+    return ast.dump(next(node for node in tree.body
+                         if isinstance(node, ast.FunctionDef)
+                         and node.name == "decimal_to_binary"))
+
+
+assert function_ast("solution.py") == function_ast("smoke.py")
+
+checked = list(range(0, 10001))
+checked += [2 ** exponent - 1 for exponent in range(1, 257)]
+checked += [2 ** exponent for exponent in range(1, 257)]
+checked += [2 ** exponent + 1 for exponent in range(1, 257)]
+
+for value in checked:
+    expected = "db" + format(value, "b") + "db"
+    actual = decimal_to_binary(value)
+    assert actual == expected, (value, actual, expected)
+
+print(f"CPython differential: {len(checked)} cases, 0 mismatches")
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..dff930cc301c783d6ce2b0e6f13da27261bb89dc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,45 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // binRel(N, ACC, OUT) defines the sequence produced by completing the
+  // repeated-divide-by-two loop from N with the already accumulated suffix
+  // ACC.  Its three guards are disjoint and cover all mathematical integers.
+  syntax Bool ::= binRel(Int, IntSeq, IntSeq) [function, total]
+
+  rule binRel(N, ACC, OUT) => ACC ==K OUT
+    requires N ==Int 0
+
+  rule binRel(N, ACC, OUT)
+    => binRel(
+         (N -Int pyMod(N, 2)) /Int 2,
+         iCons(48 +Int pyMod(N, 2), ACC),
+         OUT)
+    requires N >Int 0
+
+  rule binRel(N, _ACC, _OUT) => false
+    requires N <Int 0
+
+  // The executable loop starts with the trailing "db" already in ACC.  The
+  // task-level result then has a literal leading "db" followed by TAIL.
+  syntax Bool ::= decimalTailRel(Int, IntSeq) [function, total]
+
+  rule decimalTailRel(N, TAIL)
+    => TAIL ==K iCons(48, iCons(100, iCons(98, .IntSeq)))
+    requires N ==Int 0
+
+  rule decimalTailRel(N, TAIL)
+    => binRel(N, iCons(100, iCons(98, .IntSeq)), TAIL)
+    requires N >Int 0
+
+  rule decimalTailRel(N, _TAIL) => false
+    requires N <Int 0
+
+  syntax Bool ::= decimalResultRel(Int, IntSeq) [function, total]
+
+  rule decimalResultRel(N, iCons(100, iCons(98, TAIL)))
+    => decimalTailRel(N, TAIL)
+
+  rule decimalResultRel(_N, _CODES) => false [owise]
+endmodule

