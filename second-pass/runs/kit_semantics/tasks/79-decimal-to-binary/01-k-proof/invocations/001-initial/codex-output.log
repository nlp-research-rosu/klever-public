--- /dev/null
+++ b/spec.k
@@ -0,0 +1,109 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant: the actual loop returns a digit sequence satisfying the
+  // guarded base-2 recurrence from its current integer and accumulator.
+  claim [binary-loop]:
+    <k>
+      #while(
+        Compare(Name("decimal"), CmpOp("!=", Int(0))),
+        Assign(
+          Name("binary"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              BinOp(
+                "+",
+                Int(48),
+                BinOp("%", Name("decimal"), Int(2)))),
+            Name("binary")))
+        Assign(
+          Name("decimal"),
+          BinOp("//", Name("decimal"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope(
+        "decimal_to_binary" |-> FUNCTION:Val,
+        parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "binary"  |-> (str(ACC:IntSeq) => str(?OUT:IntSeq))
+        "decimal" |-> (N:Int => 0),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    ensures binRel(N, ACC, ?OUT)
+
+  // Exact invocation of the translated function body under its real binding.
+  // The existential middle sequence is constrained by decimalBitsRel.
+  claim [decimal-to-binary]:
+    <k>
+      Call(
+        Name("decimal_to_binary"),
+        (N:Int, .Exprs))
+      => str(
+           iCons(100,
+             iCons(98,
+               seqConcat(
+                 ?BITS:IntSeq,
+                 iCons(100, iCons(98, .IntSeq))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "decimal_to_binary" |->
+          closureVal(
+            ("decimal", .ParamNames),
+            Assign(Name("binary"), Str(""))
+            If(
+              Compare(Name("decimal"), CmpOp("==", Int(0))),
+              Assign(Name("binary"), Str("0")),
+              .Stmts)
+            While(
+              Compare(Name("decimal"), CmpOp("!=", Int(0))),
+              Assign(
+                Name("binary"),
+                BinOp(
+                  "+",
+                  Call(
+                    Name("chr"),
+                    BinOp(
+                      "+",
+                      Int(48),
+                      BinOp("%", Name("decimal"), Int(2)))),
+                  Name("binary")))
+              Assign(
+                Name("decimal"),
+                BinOp("//", Name("decimal"), Int(2))))
+            Return(
+              BinOp(
+                "+",
+                BinOp("+", Str("db"), Name("binary")),
+                Str("db"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    ensures decimalBitsRel(N, ?BITS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f5ae5f6acaae6876aab97c68eeef33258185bc07
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // binRel(N, ACC, OUT) defines the sequence produced by completing the
+  // repeated-divide-by-two loop from N with the already accumulated suffix
+  // ACC.  Its three guards are disjoint and cover all mathematical integers.
+  syntax Bool ::= binRel(Int, IntSeq, IntSeq) [function, total]
+
+  rule binRel(N, ACC, OUT) => ACC ==K OUT
+    requires N ==Int 0
+
+  rule binRel(N, ACC, OUT)
+    => binRel(
+         (N -Int pyMod(N, 2)) /Int 2,
+         iCons(48 +Int pyMod(N, 2), ACC),
+         OUT)
+    requires N >Int 0
+
+  rule binRel(N, _ACC, _OUT) => false
+    requires N <Int 0
+
+  // The task-level representation gives zero one explicit digit.  Positive
+  // inputs use the loop recurrence from an empty accumulator.
+  syntax Bool ::= decimalBitsRel(Int, IntSeq) [function, total]
+
+  rule decimalBitsRel(N, OUT) => OUT ==K iCons(48, .IntSeq)
+    requires N ==Int 0
+
+  rule decimalBitsRel(N, OUT) => binRel(N, .IntSeq, OUT)
+    requires N >Int 0
+
+  rule decimalBitsRel(N, _OUT) => false
+    requires N <Int 0
+endmodule

