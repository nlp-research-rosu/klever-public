+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // binRel(N, ACC, OUT) defines the sequence produced by completing the
+  // repeated-divide-by-two loop from N with the already accumulated suffix
+  // ACC.  Its three guards are disjoint and cover all mathematical integers.
+  syntax Bool ::= binRel(Int, IntSeq, IntSeq) [function, total]
+
+  rule binRel(N, ACC, OUT) => ACC ==K OUT
+    requires N ==Int 0
+
+  rule binRel(N, ACC, OUT)
+    => binRel(
+         (N -Int pyMod(N, 2)) /Int 2,
+         iCons(48 +Int pyMod(N, 2), ACC),
+         OUT)
+    requires N >Int 0
+
+  rule binRel(N, _ACC, _OUT) => false
+    requires N <Int 0
+
+  // The task-level representation gives zero one explicit digit.  Positive
+  // inputs use the loop recurrence from an empty accumulator.
+  syntax Bool ::= decimalBitsRel(Int, IntSeq) [function, total]
+
+  rule decimalBitsRel(N, OUT) => OUT ==K iCons(48, .IntSeq)
+    requires N ==Int 0
+
+  rule decimalBitsRel(N, OUT) => binRel(N, .IntSeq, OUT)
+    requires N >Int 0
+
+  rule decimalBitsRel(N, _OUT) => false
+    requires N <Int 0
+endmodule

