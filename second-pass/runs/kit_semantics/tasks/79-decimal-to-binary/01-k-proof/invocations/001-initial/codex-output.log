+            CmpOp("==", Int(0))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("0"), Name("binary"))),
+          Assign(
+            Name("binary"),
+            BinOp("+", Str("1"), Name("binary"))))
+        Assign(
+          Name("decimal"),
+          BinOp("//", Name("decimal"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope(MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+        "binary"  |-> (str(ACC:IntSeq) => str(binCodes(ORIGINAL)))
+        "decimal" |-> (N:Int => 0)
+        "original" |-> ORIGINAL:Int,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
