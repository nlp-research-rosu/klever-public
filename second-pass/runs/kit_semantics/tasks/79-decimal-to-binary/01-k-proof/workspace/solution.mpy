Module(
  FuncDef("decimal_to_binary", Params("decimal"),
    Assign(Name("binary"), Str("db"))
    If(Compare(Name("decimal"), CmpOp("==", Int(0))),
      Assign(Name("binary"), BinOp("+", Str("0"), Name("binary"))),
      )
    While(Compare(Name("decimal"), CmpOp("!=", Int(0))),
      Assign(
        Name("binary"),
        BinOp(
          "+",
          Call(
            Name("chr"),
            BinOp("+", Int(48), BinOp("%", Name("decimal"), Int(2)))),
          Name("binary")))
      Assign(Name("decimal"), BinOp("//", Name("decimal"), Int(2))))
    Return(BinOp("+", Str("db"), Name("binary")))))
