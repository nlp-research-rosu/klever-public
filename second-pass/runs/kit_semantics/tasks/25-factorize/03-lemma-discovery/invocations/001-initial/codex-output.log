fi

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION; then
  echo "ERROR: body-mutation probe unexpectedly passed"
  exit 1
else
  echo "EXPECTED FAILURE: body-mutation probe rejected"
fi

