     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical tail-recursive summary of the loop's result sequence.
     7	  // It does not rewrite or replace any program computation.
     8	  syntax ValSeq ::= factorAcc(ValSeq, Int, Int) [function]
     9	
    10	  rule factorAcc(A:ValSeq, N:Int, D:Int) => A
    11	    requires N <Int D
    12	
    13	  rule factorAcc(A:ValSeq, N:Int, D:Int)
    14	    => factorAcc(
    15	         valSeqConcat(A, vCons(D, .ValSeq)),
    16	         (N -Int pyMod(N, D)) /Int D,
    17	         D)
    18	    requires D <=Int N andBool pyMod(N, D) ==Int 0
    19	
    20	  rule factorAcc(A:ValSeq, N:Int, D:Int)
    21	    => factorAcc(A, N, D +Int 1)
    22	    requires D <=Int N andBool pyMod(N, D) =/=Int 0
    23	endmodule
COMMAND: nl -ba solution.py
     1	from typing import List
     2	
     3	
     4	def factorize(n: int) -> List[int]:
     5	    factors = []
     6	    divisor = 2
     7	    while divisor <= n:
     8	        if n % divisor == 0:
     9	            factors.append(divisor)
    10	            n = n // divisor
    11	        else:
    12	            divisor = divisor + 1
    13	    return factors
