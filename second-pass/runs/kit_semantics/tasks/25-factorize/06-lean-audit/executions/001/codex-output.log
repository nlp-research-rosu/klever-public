+#!/usr/bin/env python3
+"""Rerun the trusted Stage 4 generation checker and print returned evidence."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from tools.klean_preflight import check_generation
+
+
+def main() -> None:
