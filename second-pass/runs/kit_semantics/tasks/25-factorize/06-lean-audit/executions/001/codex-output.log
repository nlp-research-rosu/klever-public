+            "audit_input_target": resolution["target"],
+            "export_status": export_result["status"],
+            "preflight_status": recorded_preflight["status"],
+            "selected_status": resolution["selections"][
+                "klean_generation"
+            ]["status"],
+            "candidate_present": Path("/candidate").exists(),
