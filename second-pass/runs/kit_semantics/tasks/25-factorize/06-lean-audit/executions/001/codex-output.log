+            "file_set": producer_file_set,
+            "file_set_exact": producer_file_set
+            == ["klean.py", "klean_export.py", "source-manifest.json"],
+            "generator_manifest_image_id": generator_image_id,
+            "source_manifest_image_id": source_manifest[
