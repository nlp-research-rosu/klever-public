+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Expr(
+                  Call(
+                    Attribute(Name("factors"), "append"),
+                    Name("divisor")))
+                Assign(
+                  Name("n"),
+                  BinOp("//", Name("n"), Name("divisor"))),
+                Assign(
+                  Name("divisor"),
+                  BinOp("+", Name("divisor"), Int(1))))
+              .Stmts)
+            Return(Name("factors"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
