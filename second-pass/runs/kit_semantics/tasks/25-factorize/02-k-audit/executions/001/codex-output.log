+                Assign(
+                  Name("n"),
+                  BinOp("//", Name("n"), Name("divisor"))),
+                Assign(
+                  Name("divisor"),
+                  BinOp("+", Name("divisor"), Int(1))))
+              .Stmts)
+            Return(Name("factors"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
