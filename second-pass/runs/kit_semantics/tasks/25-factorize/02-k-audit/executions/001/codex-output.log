diff --git a//tmp/audit-work/review-25-factorize/spec-audit-false.k b//tmp/audit-work/review-25-factorize/spec-audit-false.k
new file mode 100644
index 0000000000000000000000000000000000000000..002e5689c1b2d42700539756390ea18aea5629b9
--- /dev/null
+++ b//tmp/audit-work/review-25-factorize/spec-audit-false.k
@@ -0,0 +1,55 @@
+requires "verification.k"
+
+module SPEC-AUDIT-FALSE
+  imports VERIFICATION
+
+  // Fresh false result obligation. The exact submitted body returns [] at 1,
+  // while this destination demands [2].
+  claim [audit-wrong-result]:
+    <k>
+      Call(Name("factorize"), (Int(1), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "factorize" |->
+          closureVal(
+            "n",
+            Assign(Name("factors"), ListExpr(.Exprs))
+            Assign(Name("divisor"), Int(2))
+            While(
+              Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Expr(
+                  Call(
+                    Attribute(Name("factors"), "append"),
+                    Name("divisor")))
+                Assign(
+                  Name("n"),
+                  BinOp("//", Name("n"), Name("divisor"))),
+                Assign(
+                  Name("divisor"),
+                  BinOp("+", Name("divisor"), Int(1))))
+              .Stmts)
+            Return(Name("factors"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(2, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
