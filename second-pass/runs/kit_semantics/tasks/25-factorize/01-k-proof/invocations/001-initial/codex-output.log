--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,21 @@
+from typing import List
+
+
+def factorize(n: int) -> List[int]:
+    factors = []
+    divisor = 2
+    while divisor <= n:
+        if n % divisor == 0:
+            factors.append(divisor)
+            n = n // divisor
