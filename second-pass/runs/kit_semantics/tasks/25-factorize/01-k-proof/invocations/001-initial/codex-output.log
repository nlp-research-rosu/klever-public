+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [factor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("factors"), "append"),
+              Name("divisor")))
+          Assign(
+            Name("n"),
+            BinOp("//", Name("n"), Name("divisor"))),
+          Assign(
+            Name("divisor"),
+            BinOp("+", Name("divisor"), Int(1))))
+        .Stmts)
+      ~> Return(Name("factors"))
+      ~> #endcall
+      =>
+      Return(Name("factors"))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(
+        "factorize" |->
+          closureVal(
+            "n",
+            Assign(Name("factors"), ListExpr(.Exprs))
