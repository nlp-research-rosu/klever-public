diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2d735bcd23707f1ab89859974a0cc750abc4a996
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+from typing import List
+
+
+def factorize(n: int) -> List[int]:
+    factors = []
+    divisor = 2
+    while divisor <= n:
+        if n % divisor == 0:
+            factors.append(divisor)
+            n = n // divisor
+        else:
+            divisor = divisor + 1
+    return factors
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..b3f68ff2bd1f961c29265415a90a0a40824c136f
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,55 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: start divisor at 3.  For n = 2 this returns [],
+  // so the original result [2] must be rejected.
+  claim [mutated-divisor]:
+    <k>
+      Call(Name("factorize"), (Int(2), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "factorize" |->
+          closureVal(
+            "n",
+            Assign(Name("factors"), ListExpr(.Exprs))
+            Assign(Name("divisor"), Int(3))
+            While(
+              Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Expr(
+                  Call(
+                    Attribute(Name("factors"), "append"),
+                    Name("divisor")))
+                Assign(
+                  Name("n"),
+                  BinOp("//", Name("n"), Name("divisor"))),
+                Assign(
+                  Name("divisor"),
+                  BinOp("+", Name("divisor"), Int(1))))
+              .Stmts)
+            Return(Name("factors"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(2, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
