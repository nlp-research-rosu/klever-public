+                 Assign(
+                   Name("n"),
+                   BinOp("//", Name("n"), Name("divisor"))),
+                 Assign(
+                   Name("divisor"),
+                   BinOp("+", Name("divisor"), Int(1))))
+               .Stmts)
+             Return(Name("factors"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(factorAcc(.ValSeq, N, 2))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
