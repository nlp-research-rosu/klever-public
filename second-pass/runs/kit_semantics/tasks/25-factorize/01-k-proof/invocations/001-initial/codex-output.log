--- /dev/null
+++ b/spec.k
@@ -0,0 +1,126 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [factor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("factors"), "append"),
+              Name("divisor")))
+          Assign(
+            Name("n"),
+            BinOp("//", Name("n"), Name("divisor"))),
+          Assign(
+            Name("divisor"),
+            BinOp("+", Name("divisor"), Int(1))))
+        .Stmts)
+      ~> (Return(Name("factors")) .Stmts)
+      ~> #endcall
+      =>
+      (Return(Name("factors")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(
+        "factorize" |->
+          closureVal(
+            "n",
+            Assign(Name("factors"), ListExpr(.Exprs))
+            Assign(Name("divisor"), Int(2))
+            While(
+              Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Expr(
+                  Call(
+                    Attribute(Name("factors"), "append"),
+                    Name("divisor")))
+                Assign(
+                  Name("n"),
+                  BinOp("//", Name("n"), Name("divisor"))),
+                Assign(
+                  Name("divisor"),
+                  BinOp("+", Name("divisor"), Int(1))))
+              .Stmts)
+            Return(Name("factors"))
+            .Stmts,
+            0),
+        parent(-1))
+      1 |-> scope(
+        "n" |-> (N:Int => ?NF:Int)
+        "divisor" |-> (D:Int => ?DF:Int)
+        "factors" |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(A:ValSeq => factorAcc(A, N, D))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1 andBool D >=Int 2
+
+  claim [factorize]:
+    <k>
+      Call(Name("factorize"), (Int(N:Int), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+         "factorize" |->
+           closureVal(
+             "n",
+             Assign(Name("factors"), ListExpr(.Exprs))
+             Assign(Name("divisor"), Int(2))
+             While(
+               Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+               If(
+                 Compare(
+                   BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+                 Expr(
+                   Call(
+                     Attribute(Name("factors"), "append"),
+                     Name("divisor")))
+                 Assign(
+                   Name("n"),
+                   BinOp("//", Name("n"), Name("divisor"))),
+                 Assign(
+                   Name("divisor"),
+                   BinOp("+", Name("divisor"), Int(1))))
+               .Stmts)
+             Return(Name("factors"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(factorAcc(.ValSeq, N, 2))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4e8a6498b6a79eeba9e23335599bd101b09e7e86
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,36 @@
+import math
+
+from solution import factorize
+
+
+def independent_oracle(n: int) -> list[int]:
+    result: list[int] = []
+    remaining = n
+    candidate = 2
+    while candidate * candidate <= remaining:
+        while remaining % candidate == 0:
+            result.append(candidate)
+            remaining //= candidate
+        candidate += 1
+    if remaining > 1:
+        result.append(remaining)
+    return result
+
+
+def main() -> None:
+    checked = 0
+    inputs = list(range(1, 2001)) + [9973, 65536, 99991]
+    for n in inputs:
+        actual = factorize(n)
+        expected = independent_oracle(n)
+        assert actual == expected, (n, actual, expected)
+        assert actual == sorted(actual), (n, actual)
+        assert all(p >= 2 and all(p % d for d in range(2, math.isqrt(p) + 1))
+                   for p in actual), (n, actual)
+        assert math.prod(actual) == n, (n, actual)
+        checked += 1
+    print(f"differential inputs={checked} mismatches=0")
+
+
+if __name__ == "__main__":
+    main()
