diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4e8a6498b6a79eeba9e23335599bd101b09e7e86
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,36 @@
+import math
+
+from solution import factorize
+
+
+def independent_oracle(n: int) -> list[int]:
+    result: list[int] = []
+    remaining = n
+    candidate = 2
+    while candidate * candidate <= remaining:
+        while remaining % candidate == 0:
+            result.append(candidate)
+            remaining //= candidate
+        candidate += 1
+    if remaining > 1:
+        result.append(remaining)
+    return result
+
+
+def main() -> None:
+    checked = 0
+    inputs = list(range(1, 2001)) + [9973, 65536, 99991]
+    for n in inputs:
+        actual = factorize(n)
+        expected = independent_oracle(n)
+        assert actual == expected, (n, actual, expected)
+        assert actual == sorted(actual), (n, actual)
+        assert all(p >= 2 and all(p % d for d in range(2, math.isqrt(p) + 1))
+                   for p in actual), (n, actual)
+        assert math.prod(actual) == n, (n, actual)
+        checked += 1
+    print(f"differential inputs={checked} mismatches=0")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bdc013e7d7ae4f8bda02e5884c529e710a1bf6ff
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical tail-recursive summary of the loop's result sequence.
+  // It does not rewrite or replace any program computation.
+  syntax ValSeq ::= factorAcc(ValSeq, Int, Int) [function]
+
+  rule factorAcc(A:ValSeq, N:Int, D:Int) => A
+    requires N <Int D
+
+  rule factorAcc(A:ValSeq, N:Int, D:Int)
+    => factorAcc(
+         valSeqConcat(A, vCons(D, .ValSeq)),
+         (N -Int pyMod(N, D)) /Int D,
+         D)
+    requires D <=Int N andBool pyMod(N, D) ==Int 0
+
+  rule factorAcc(A:ValSeq, N:Int, D:Int)
+    => factorAcc(A, N, D +Int 1)
+    requires D <=Int N andBool pyMod(N, D) =/=Int 0
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a6562e90fed282aca6e715e9f1bc669797cbcc7
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,21 @@
+from typing import List
+
+
+def factorize(n: int) -> List[int]:
+    factors = []
+    divisor = 2
+    while divisor <= n:
+        if n % divisor == 0:
+            factors.append(divisor)
+            n = n // divisor
+        else:
+            divisor = divisor + 1
+    return factors
+
+
+assert factorize(1) == []
+assert factorize(2) == [2]
+assert factorize(8) == [2, 2, 2]
+assert factorize(25) == [5, 5]
+assert factorize(70) == [2, 5, 7]
+assert factorize(97) == [97]
