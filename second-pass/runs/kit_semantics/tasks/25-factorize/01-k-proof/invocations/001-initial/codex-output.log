index 0000000000000000000000000000000000000000..bdc013e7d7ae4f8bda02e5884c529e710a1bf6ff
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical tail-recursive summary of the loop's result sequence.
+  // It does not rewrite or replace any program computation.
+  syntax ValSeq ::= factorAcc(ValSeq, Int, Int) [function]
+
+  rule factorAcc(A:ValSeq, N:Int, D:Int) => A
+    requires N <Int D
+
+  rule factorAcc(A:ValSeq, N:Int, D:Int)
+    => factorAcc(
+         valSeqConcat(A, vCons(D, .ValSeq)),
+         (N -Int pyMod(N, D)) /Int D,
+         D)
+    requires D <=Int N andBool pyMod(N, D) ==Int 0
+
+  rule factorAcc(A:ValSeq, N:Int, D:Int)
+    => factorAcc(A, N, D +Int 1)
+    requires D <=Int N andBool pyMod(N, D) =/=Int 0
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2d735bcd23707f1ab89859974a0cc750abc4a996
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+from typing import List
+
+
+def factorize(n: int) -> List[int]:
+    factors = []
+    divisor = 2
+    while divisor <= n:
+        if n % divisor == 0:
+            factors.append(divisor)
+            n = n // divisor
+        else:
+            divisor = divisor + 1
+    return factors
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f2c741d61a1661bafc0e437c4ccefcf16de45f30
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,126 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [factor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("factors"), "append"),
+              Name("divisor")))
+          Assign(
+            Name("n"),
+            BinOp("//", Name("n"), Name("divisor"))),
+          Assign(
+            Name("divisor"),
+            BinOp("+", Name("divisor"), Int(1))))
+        .Stmts)
+      ~> (Return(Name("factors")) .Stmts)
+      ~> #endcall
+      =>
+      (Return(Name("factors")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(
+        "factorize" |->
+          closureVal(
+            "n",
+            Assign(Name("factors"), ListExpr(.Exprs))
+            Assign(Name("divisor"), Int(2))
+            While(
+              Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Expr(
+                  Call(
+                    Attribute(Name("factors"), "append"),
+                    Name("divisor")))
+                Assign(
+                  Name("n"),
+                  BinOp("//", Name("n"), Name("divisor"))),
+                Assign(
+                  Name("divisor"),
+                  BinOp("+", Name("divisor"), Int(1))))
+              .Stmts)
+            Return(Name("factors"))
+            .Stmts,
+            0),
+        parent(-1))
+      1 |-> scope(
+        "n" |-> (N:Int => ?NF:Int)
+        "divisor" |-> (D:Int => ?DF:Int)
+        "factors" |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(A:ValSeq => factorAcc(A, N, D))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1 andBool D >=Int 2
+
+  claim [factorize]:
+    <k>
+      Call(Name("factorize"), (Int(N:Int), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+         "factorize" |->
+           closureVal(
+             "n",
+             Assign(Name("factors"), ListExpr(.Exprs))
+             Assign(Name("divisor"), Int(2))
+             While(
+               Compare(Name("divisor"), CmpOp("<=", Name("n"))),
+               If(
+                 Compare(
+                   BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+                 Expr(
+                   Call(
+                     Attribute(Name("factors"), "append"),
+                     Name("divisor")))
+                 Assign(
+                   Name("n"),
+                   BinOp("//", Name("n"), Name("divisor"))),
+                 Assign(
+                   Name("divisor"),
+                   BinOp("+", Name("divisor"), Int(1))))
+               .Stmts)
+             Return(Name("factors"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(factorAcc(.ValSeq, N, 2))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1
+endmodule
