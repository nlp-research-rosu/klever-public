+  | SortVal.inj_SortInt a, SortVal.inj_SortInt b => intCompareImpl operator a b
+  | SortVal.inj_SortFloat a, SortVal.inj_SortFloat b => floatCompareImpl operator a b
+  | SortVal.inj_SortBool a, SortVal.inj_SortBool b =>
