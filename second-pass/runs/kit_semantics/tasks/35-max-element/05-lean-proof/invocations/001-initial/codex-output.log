+  match floatDyadicImpl f with
+  | some d => dyadicLessThanIntImpl d i
+  | none => if f.isNaN then false else floatSignBitImpl f
+
+def intLessThanFloatImpl (i : SortInt) (f : SortFloat) : SortBool :=
+  match floatDyadicImpl f with
