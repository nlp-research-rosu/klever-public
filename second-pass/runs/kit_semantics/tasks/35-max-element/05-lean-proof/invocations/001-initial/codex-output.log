+noncomputable def valTermEqualImpl (a b : SortVal) : SortBool := by
+  classical
+  exact decide (a = b)
+
+noncomputable def valSeqTermEqualImpl (a b : SortValSeq) : SortBool := by
+  classical
+  exact decide (a = b)
