+++ b//tmp/lean-proc-self-shim.c
@@ -0,0 +1,33 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static int is_pid_exe(const char *path) {
+  const char prefix[] = "/proc/";
+  const char suffix[] = "/exe";
+  size_t n, i;
+  if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) return 0;
+  n = strlen(path);
+  if (n <= sizeof(prefix) + sizeof(suffix) - 2) return 0;
+  if (strcmp(path + n - (sizeof(suffix) - 1), suffix) != 0) return 0;
+  for (i = sizeof(prefix) - 1; i < n - (sizeof(suffix) - 1); ++i)
+    if (path[i] < '0' || path[i] > '9') return 0;
+  return 1;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (real_readlink == NULL) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  if (is_pid_exe(path)) path = "/proc/self/exe";
+  return real_readlink(path, buf, size);
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (real_readlinkat == NULL) real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  if (is_pid_exe(path)) path = "/proc/self/exe";
+  return real_readlinkat(dirfd, path, buf, size);
+}
