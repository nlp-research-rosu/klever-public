+   totalizes only combinations for which frozen MPY has no applyCmp rule. -/
+noncomputable def cmpDispatchImpl
+    (operator : SortString) (left right : SortVal) : SortBool :=
+  match left, right with
+  | _, SortVal.«noneV_MPY-CORE_Val» =>
