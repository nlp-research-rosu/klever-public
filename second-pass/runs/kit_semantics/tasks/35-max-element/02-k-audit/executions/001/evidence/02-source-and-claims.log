     7	def max_element(l: list):
     8	    """Return maximum element in the list.
     9	    >>> max_element([1, 2, 3])
    10	    3
    11	    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])
    12	    123
    13	    """
    14	    m = l[0]
    15	    for e in l:
    16	        if e > m:
    17	            m = e
    18	    return m
