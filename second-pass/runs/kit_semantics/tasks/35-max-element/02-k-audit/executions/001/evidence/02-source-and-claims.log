     6	  // A guarded total twin of Val's partial projection to Int.
     7	  syntax Int ::= projectIntTotal(Val)
     8	    [function, total, symbol(projectIntTotal), no-evaluators]
     9	  rule #Ceil({@V:Val}:>Int)
    10	    => ({ isInt(@V) #Equals true } #And #Ceil(@V))
    11	    [simplification]
    12	  rule projectIntTotal(V:Val) => {V}:>Int
    13	    requires isInt(V)
    14	    [concrete, simplification(10), preserves-definedness]
    15	  rule {V:Val}:>Int => projectIntTotal(V)
    16	    requires isInt(V)
    17	    [symbolic(V), simplification, preserves-definedness]
    18	  rule projectIntTotal(I:Int) => I [simplification]
    19	
    20	  // Dispatch twin needed by the symbolic backend.  It restates the equation
    21	  // already enforced by MPY's static Int rule.
    22	  rule applyCmp(">", V:Val, M:Int)
    23	    => projectIntTotal(V) >Int M
    24	    requires isInt(V)
    25	    [simplification]
    26	
    27	  // ---- Full fixed-semantics max domain -----------------------------------
    28	
    29	  syntax Bool ::= isNumericV(Val) [function, total]
    30	  rule isNumericV(V:Val)
    31	    => isInt(V) orBool isBool(V) orBool isFloat(V)
    32	
    33	  syntax Bool ::= allNumericVS(ValSeq) [function, total]
    34	  rule allNumericVS(.ValSeq) => true
    35	  rule allNumericVS(vCons(V:Val, REST:ValSeq))
    36	    => isNumericV(V) andBool allNumericVS(REST)
    37	
    38	  syntax Bool ::= allStrVS(ValSeq) [function, total]
    39	  rule allStrVS(.ValSeq) => true
    40	  rule allStrVS(vCons(V:Val, REST:ValSeq))
    41	    => isStr(V) andBool allStrVS(REST)
    42	
    43	  // Guarded total projections for the other three orderable value sorts.
    44	  syntax Float ::= projectFloatTotal(Val)
    45	    [function, total, symbol(projectFloatTotal), no-evaluators]
    46	  rule #Ceil({@V:Val}:>Float)
    47	    => ({ isFloat(@V) #Equals true } #And #Ceil(@V))
    48	    [simplification]
    49	  rule projectFloatTotal(V:Val) => {V}:>Float
    50	    requires isFloat(V)
    51	    [concrete, simplification(10), preserves-definedness]
    52	  rule {V:Val}:>Float => projectFloatTotal(V)
    53	    requires isFloat(V)
    54	    [symbolic(V), simplification, preserves-definedness]
    55	  rule projectFloatTotal(F:Float) => F [simplification]
    56	
    57	  // Haskell has no FLOAT.max hook.  Symbolic proofs keep this fixed primitive
    58	  // opaque and thread its Float result; LLVM ground execution still evaluates
    59	  // the real hook through the concrete equation.
    60	  syntax Float ::= maxFOpaque(Float, Float)
    61	    [function, total, symbol(maxFOpaque), no-evaluators]
    62	  rule maxFOpaque(F1:Float, F2:Float) => maxFloat(F1, F2) [concrete]
    63	  rule maxFloat(F1:Float, F2:Float) => maxFOpaque(F1, F2)
    64	    [symbolic(F1, F2), simplification]
    65	
    66	  syntax Bool ::= projectBoolTotal(Val)
    67	    [function, total, symbol(projectBoolTotal), no-evaluators]
    68	  rule #Ceil({@V:Val}:>Bool)
