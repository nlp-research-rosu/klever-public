/reference/reference-semantics/semantics/subscript.k:7:  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
/reference/reference-semantics/semantics/subscript.k-8-  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
/reference/reference-semantics/semantics/subscript.k-9-  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
/reference/reference-semantics/semantics/subscript.k-10-  // atK. K trusts the [total] annotation; valid programs index in-bounds.
/reference/reference-semantics/semantics/subscript.k-11-  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
/reference/reference-semantics/semantics/subscript.k:12:  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
/reference/reference-semantics/semantics/subscript.k:13:  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
/reference/reference-semantics/semantics/subscript.k-14-       requires I >Int 0
/reference/reference-semantics/semantics/subscript.k-15-
/reference/reference-semantics/semantics/subscript.k-16-  syntax Int ::= intSeqAt(IntSeq, Int) [function]
/reference/reference-semantics/semantics/subscript.k-17-  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C
