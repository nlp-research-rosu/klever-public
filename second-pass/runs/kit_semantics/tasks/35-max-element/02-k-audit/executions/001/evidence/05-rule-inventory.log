/reference/reference-semantics/semantics/str.k-20-  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/str.k-21-  rule seqConcat(.IntSeq, T:IntSeq)                => T
/reference/reference-semantics/semantics/str.k-22-  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
/reference/reference-semantics/semantics/str.k-23-
/reference/reference-semantics/semantics/str.k-24-  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
/reference/reference-semantics/semantics/str.k:25:  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
/reference/reference-semantics/semantics/str.k:26:  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
/reference/reference-semantics/semantics/str.k-27-
/reference/reference-semantics/semantics/str.k-28-  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
/reference/reference-semantics/semantics/str.k:29:  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
/reference/reference-semantics/semantics/str.k:30:  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
/reference/reference-semantics/semantics/str.k-31-
/reference/reference-semantics/semantics/str.k-32-  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/str.k-33-  rule strPrefix(.IntSeq, _:IntSeq)               => true
/reference/reference-semantics/semantics/str.k-34-  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
/reference/reference-semantics/semantics/str.k-35-  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
--
/reference/reference-semantics/semantics/str.k-39-  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
/reference/reference-semantics/semantics/str.k-40-  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
/reference/reference-semantics/semantics/str.k-41-       requires notBool strPrefix(P, iCons(C, Xs))
/reference/reference-semantics/semantics/str.k-42-
/reference/reference-semantics/semantics/str.k-43-  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
/reference/reference-semantics/semantics/str.k:44:  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
/reference/reference-semantics/semantics/str.k-45-  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
/reference/reference-semantics/semantics/str.k-46-  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
/reference/reference-semantics/semantics/str.k-47-  // str </<=/>/>= comparisons.
/reference/reference-semantics/semantics/str.k:48:  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/str.k:49:  rule strLt(.IntSeq, .IntSeq)                => false
/reference/reference-semantics/semantics/str.k:50:  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
/reference/reference-semantics/semantics/str.k:51:  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
/reference/reference-semantics/semantics/str.k:52:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
/reference/reference-semantics/semantics/str.k:53:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
/reference/reference-semantics/semantics/str.k:54:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
/reference/reference-semantics/semantics/str.k-55-
/reference/reference-semantics/semantics/str.k:56:  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
/reference/reference-semantics/semantics/str.k:57:  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
/reference/reference-semantics/semantics/str.k:58:  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
/reference/reference-semantics/semantics/str.k:59:  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
/reference/reference-semantics/semantics/str.k-60-endmodule
