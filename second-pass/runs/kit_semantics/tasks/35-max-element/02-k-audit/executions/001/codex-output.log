/reference/reference-semantics/semantics/call.k-71-       <env>     CALLERL:Int => NEWL </env>
/reference/reference-semantics/semantics/call.k-72-       <scopes>   STORE:Map => STORE [ NEWL <- scope(.Map, parent(DEFL)) ] </scopes>
/reference/reference-semantics/semantics/call.k-73-       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
/reference/reference-semantics/semantics/call.k-74-       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
