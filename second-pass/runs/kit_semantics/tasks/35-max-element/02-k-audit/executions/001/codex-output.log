/reference/reference-semantics/semantics/call.k:80:  rule <k> #applyK(toCall(closureValC(PNS:ParamNames, CVS:ParamNames, BODY:Stmts, CM:Map)), ACC:Vals) ~> CONT
/reference/reference-semantics/semantics/call.k-81-        => #allocCells(CVS) ~> #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
/reference/reference-semantics/semantics/call.k-82-       <env>     CALLERL:Int => NEWL </env>
/reference/reference-semantics/semantics/call.k-83-       <scopes>   STORE:Map => STORE [ NEWL <- scope(CM [ "$cells" <- cellsMark(CVS) ], parent(0)) ] </scopes>
/reference/reference-semantics/semantics/call.k-84-       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
