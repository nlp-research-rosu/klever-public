    43	  // Guarded total projections for the other three orderable value sorts.
    44	  syntax Float ::= projectFloatTotal(Val)
    45	    [function, total, symbol(projectFloatTotal), no-evaluators]
    46	  rule #Ceil({@V:Val}:>Float)
    47	    => ({ isFloat(@V) #Equals true } #And #Ceil(@V))
    48	    [simplification]
    49	  rule projectFloatTotal(V:Val) => {V}:>Float
    50	    requires isFloat(V)
    51	    [concrete, simplification(10), preserves-definedness]
    52	  rule {V:Val}:>Float => projectFloatTotal(V)
    53	    requires isFloat(V)
    54	    [symbolic(V), simplification, preserves-definedness]
    55	  rule projectFloatTotal(F:Float) => F [simplification]
    56	
    57	  // Haskell has no FLOAT.max hook.  Symbolic proofs keep this fixed primitive
    58	  // opaque and thread its Float result; LLVM ground execution still evaluates
    59	  // the real hook through the concrete equation.
    60	  syntax Float ::= maxFOpaque(Float, Float)
    61	    [function, total, symbol(maxFOpaque), no-evaluators]
    62	  rule maxFOpaque(F1:Float, F2:Float) => maxFloat(F1, F2) [concrete]
    63	  rule maxFloat(F1:Float, F2:Float) => maxFOpaque(F1, F2)
    64	    [symbolic(F1, F2), simplification]
    65	
    66	  syntax Bool ::= projectBoolTotal(Val)
    67	    [function, total, symbol(projectBoolTotal), no-evaluators]
    68	  rule #Ceil({@V:Val}:>Bool)
    69	    => ({ isBool(@V) #Equals true } #And #Ceil(@V))
    70	    [simplification]
    71	  rule projectBoolTotal(V:Val) => {V}:>Bool
    72	    requires isBool(V)
    73	    [concrete, simplification(10), preserves-definedness]
    74	  rule {V:Val}:>Bool => projectBoolTotal(V)
    75	    requires isBool(V)
    76	    [symbolic(V), simplification, preserves-definedness]
    77	  rule projectBoolTotal(B:Bool) => B [simplification]
    78	
    79	  syntax Str ::= projectStrTotal(Val)
    80	    [function, total, symbol(projectStrTotal), no-evaluators]
    81	  rule #Ceil({@V:Val}:>Str)
    82	    => ({ isStr(@V) #Equals true } #And #Ceil(@V))
    83	    [simplification]
    84	  rule projectStrTotal(V:Val) => {V}:>Str
    85	    requires isStr(V)
    86	    [concrete, simplification(10), preserves-definedness]
    87	  rule {V:Val}:>Str => projectStrTotal(V)
    88	    requires isStr(V)
    89	    [symbolic(V), simplification, preserves-definedness]
    90	  rule projectStrTotal(S:Str) => S [simplification]
    91	
    92	  syntax IntSeq ::= codesOf(Str) [function, total]
    93	  rule codesOf(str(CS:IntSeq)) => CS
    94	
    95	  // A total tagged view of Val.  Its four disjoint guards cover every Val;
    96	  // only the first three cases are admitted by allNumericVS.
    97	  syntax NumericView ::= nInt(Int)
    98	                       | nBool(Bool)
    99	                       | nFloat(Float)
   100	                       | nOther(Val)
   101	  syntax NumericView ::= numericView(Val) [function, total]
   102	  rule numericView(V:Val) => nInt(projectIntTotal(V))
   103	    requires isInt(V)
   104	  rule numericView(V:Val) => nBool(projectBoolTotal(V))
   105	    requires isBool(V)
   106	  rule numericView(V:Val) => nFloat(projectFloatTotal(V))
   107	    requires isFloat(V)
   108	  rule numericView(V:Val) => nOther(V)
   109	    requires notBool isNumericV(V)
   110	
   111	  // Exhaustive comparison table.  Every numeric equation is the RHS of MPY's
   112	  // existing static applyCmp dispatch for the corresponding pair of sorts.
   113	  syntax Bool ::= numericGt(NumericView, NumericView) [function, total]
   114	  rule numericGt(nInt(I:Int), nInt(J:Int)) => I >Int J
   115	  rule numericGt(nInt(I:Int), nBool(B:Bool))
   116	    => I >Int boolAsInt(B)
   117	  rule numericGt(nBool(B:Bool), nInt(I:Int))
   118	    => boolAsInt(B) >Int I
   119	  rule numericGt(nBool(B1:Bool), nBool(B2:Bool))
   120	    => boolAsInt(B1) >Int boolAsInt(B2)
   121	  rule numericGt(nFloat(F1:Float), nFloat(F2:Float)) => gtF(F1, F2)
   122	  rule numericGt(nInt(I:Int), nFloat(F:Float)) => ltFI(F, I)
   123	  rule numericGt(nFloat(F:Float), nInt(I:Int)) => ltIF(I, F)
   124	  rule numericGt(nBool(B:Bool), nFloat(F:Float))
   125	    => ltFI(F, boolAsInt(B))
   126	  rule numericGt(nFloat(F:Float), nBool(B:Bool))
   127	    => ltIF(boolAsInt(B), F)
   128	  rule numericGt(nOther(_:Val), _:NumericView) => false
   129	  rule numericGt(_:NumericView, nOther(_:Val)) => false
   130	
   131	  // Dynamic dispatch twins for the two orderable domains.
   132	  rule applyCmp(">", V:Val, M:Val)
   133	    => numericGt(numericView(V), numericView(M))
   134	    requires isNumericV(V) andBool isNumericV(M)
   135	    [simplification]
   136	  rule applyCmp(">", V:Val, M:Val)
   137	    => strLt(codesOf(projectStrTotal(M)), codesOf(projectStrTotal(V)))
   138	    requires isStr(V) andBool isStr(M)
   139	    [simplification]
   140	
   141	  // The three value-sort predicates are mutually exclusive in K even though
   142	  // the symbolic backend does not infer that fact from a Boolean guard.
   143	  rule isFloat(V:Val) orBool isBool(V) => false
   144	    requires isInt(V)
   145	    [simplification]
   146	  rule isInt(V:Val) orBool isBool(V) => false
   147	    requires isFloat(V)
   148	    [simplification]
   149	  rule isInt(V:Val) orBool isFloat(V) => false
   150	    requires isBool(V)
   151	    [simplification]
   152	
   153	  // General strict-comparison folds.  They keep the first element on ties,
   154	  // matching MPY's #maxAccV continuation.
   155	  syntax Val ::= maxNumericGeneralVS(Val, ValSeq) [function]
   156	  rule maxNumericGeneralVS(M:Val, .ValSeq) => M
   157	  rule maxNumericGeneralVS(M:Val, vCons(V:Val, REST:ValSeq))
   158	    => maxNumericGeneralVS(
   159	         #if numericGt(numericView(V), numericView(M))
   160	         #then V
   161	         #else M
   162	         #fi,
   163	         REST
   164	       )
   165	
   166	  syntax Val ::= maxStrGeneralVS(Val, ValSeq) [function]
   167	  rule maxStrGeneralVS(M:Val, .ValSeq) => M
   168	  rule maxStrGeneralVS(M:Val, vCons(V:Val, REST:ValSeq))
   169	    => maxStrGeneralVS(
   170	         #if strLt(
   171	               codesOf(projectStrTotal(M)),
   172	               codesOf(projectStrTotal(V))
   173	             )
   174	         #then V
   175	         #else M
   176	         #fi,
   177	         REST
   178	       )
   179	
   180	  // State-specific summaries mirror MPY's specialized accumulator and the
   181	  // exact point where a mixed numeric value hands execution to #maxAccV.
   182	  syntax Val ::= maxIntNumericVS(Int, ValSeq) [function]
   183	  rule maxIntNumericVS(M:Int, .ValSeq) => M
   184	  rule maxIntNumericVS(M:Int, vCons(V:Val, REST:ValSeq))
   185	    => maxIntNumericVS(maxInt(M, projectIntTotal(V)), REST)
   186	    requires isInt(V)
   187	    [simplification]
   188	  rule maxIntNumericVS(M:Int, vCons(V:Val, REST:ValSeq))
   189	    => maxNumericGeneralVS(M, vCons(V, REST))
   190	    requires isFloat(V) orBool isBool(V)
   191	    [simplification]
   192	
   193	  syntax Val ::= maxFloatNumericVS(Float, ValSeq) [function]
   194	  rule maxFloatNumericVS(M:Float, .ValSeq) => M
   195	  rule maxFloatNumericVS(M:Float, vCons(V:Val, REST:ValSeq))
   196	    => maxFloatNumericVS(
   197	         maxFloat(M, projectFloatTotal(V)),
   198	         REST
   199	       )
   200	    requires isFloat(V)
   201	    [simplification]
   202	  rule maxFloatNumericVS(M:Float, vCons(V:Val, REST:ValSeq))
   203	    => maxNumericGeneralVS(M, vCons(V, REST))
   204	    requires isInt(V) orBool isBool(V)
   205	    [simplification]
   206	endmodule
