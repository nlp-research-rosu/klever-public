/bin/bash -lc "python3 - <<'PY'
import json, collections, sys
inv=json.load(open('/reference/rule-inventory.json'))
out=json.load(open('/workspace/trust-boundary.json'))
errors=[]
if set(out) "'!= {'"'schema_version','inventory_sha256','rules'}: errors.append(f'top keys {set(out)}')
if out.get('schema_version') "'!= 2: errors.append('"'schema_version')
if out.get('inventory_sha256') "'!= inv.get('"'inventory_sha256'): errors.append('inventory hash')
irs=[r['source_rule_id'] for r in inv['rules']]
ors=[r.get('source_rule_id') for r in out['rules']]
if ors "'!= irs: errors.append('"'rule ids/order differ')
if len(ors) "'!= len(set(ors)): errors.append('"'duplicate ids')
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
for i,(src,r) in enumerate(zip(inv['rules'],out['rules'])):
    if set(r) "'!= {'"'source_rule_id','classification','rationale'}: errors.append(f'entry {i} keys')
    if r.get('classification') not in allowed: errors.append(f'entry {i} class')
    if not isinstance(r.get('rationale'),str) or not r['rationale'].strip(): errors.append(f'entry {i} rationale')
    if any(a == 'simplification' or a.startswith('simplification(') for a in src.get('attributes',[])) and r['classification'] not in {'DEFINITION','DOMAIN_LEMMA'}:
        errors.append(f'entry {i} simplification class')
counts=collections.Counter(r['classification'] for r in out['rules'])
print('inventory_sha256:', out['inventory_sha256'])
print('rules/order/uniqueness:', 'PASS' if ors == irs and len(ors)==len(set(ors)) else 'FAIL')
print('exact object fields:', 'PASS' if not any('keys' in e for e in errors) else 'FAIL')
print('counts:', dict(counts), 'total=',sum(counts.values()))
print('validation:', 'PASS' if not errors else 'FAIL')
if errors:
    print('\\n'.join(errors)); sys.exit(1)
PY
