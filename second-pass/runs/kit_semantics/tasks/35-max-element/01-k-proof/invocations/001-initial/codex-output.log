diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fa314c815f91fc3857312fc50aaa142130f7e2cc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [max-int-acc]:
+    <k> #maxAcc(list(VS:ValSeq), M:Int) => maxIntVS(M, VS) ... </k>
+    requires allIntVS(VS)
+
+  claim [max-element-int]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(I:Int, REST:ValSeq)))
+      => maxIntVS(I, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allIntVS(REST)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a507c7cccaa9457b5a43b025e943b07ceda98631
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,18 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly when every value in the sequence is an integer.
+  syntax Bool ::= allIntVS(ValSeq) [function, total]
+  rule allIntVS(.ValSeq) => true
+  rule allIntVS(vCons(_:Int, REST:ValSeq)) => allIntVS(REST)
+  rule allIntVS(vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  // The maximum of the accumulator and every integer in REST.
+  syntax Int ::= maxIntVS(Int, ValSeq) [function]
+  rule maxIntVS(M:Int, .ValSeq) => M
+  rule maxIntVS(M:Int, vCons(I:Int, REST:ValSeq))
+    => maxIntVS(maxInt(M, I), REST)
+endmodule

