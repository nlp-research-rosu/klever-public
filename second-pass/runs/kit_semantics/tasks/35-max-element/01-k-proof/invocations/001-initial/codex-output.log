+
+  syntax IntSeq ::= codesOf(Str) [function, total]
+  rule codesOf(str(CS:IntSeq)) => CS
+
+  // Static MPY comparison equations restated over dynamically sorted values.
+  // The guards are exactly the original static match domains.
+  rule applyCmp(">", V:Val, M:Val)
+    => projectIntTotal(V) >Int projectIntTotal(M)
+    requires isInt(V) andBool isInt(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => projectIntTotal(V) >Int boolAsInt(projectBoolTotal(M))
+    requires isInt(V) andBool isBool(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => boolAsInt(projectBoolTotal(V)) >Int projectIntTotal(M)
+    requires isBool(V) andBool isInt(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => boolAsInt(projectBoolTotal(V)) >Int
+       boolAsInt(projectBoolTotal(M))
+    requires isBool(V) andBool isBool(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => gtF(projectFloatTotal(V), projectFloatTotal(M))
+    requires isFloat(V) andBool isFloat(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => ltFI(projectFloatTotal(M), projectIntTotal(V))
+    requires isInt(V) andBool isFloat(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => ltIF(projectIntTotal(M), projectFloatTotal(V))
+    requires isFloat(V) andBool isInt(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => ltFI(projectFloatTotal(M), boolAsInt(projectBoolTotal(V)))
+    requires isBool(V) andBool isFloat(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => ltIF(boolAsInt(projectBoolTotal(M)), projectFloatTotal(V))
+    requires isFloat(V) andBool isBool(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => strLt(codesOf(projectStrTotal(M)), codesOf(projectStrTotal(V)))
+    requires isStr(V) andBool isStr(M)
+    [simplification]
+
+  // The three value-sort predicates are mutually exclusive in K even though
+  // the symbolic backend does not infer that fact from a Boolean guard.
+  rule isFloat(V:Val) orBool isBool(V) => false
+    requires isInt(V)
+    [simplification]
+  rule isInt(V:Val) orBool isBool(V) => false
+    requires isFloat(V)
+    [simplification]
+  rule isInt(V:Val) orBool isFloat(V) => false
+    requires isBool(V)
+    [simplification]
+
+  // General strict-comparison fold.  It keeps the first element on ties,
+  // matching MPY's #maxAccV continuation.
+  syntax Val ::= maxGeneralVS(Val, ValSeq) [function]
+  rule maxGeneralVS(M:Val, .ValSeq) => M
+  rule maxGeneralVS(M:Val, vCons(V:Val, REST:ValSeq))
+    => maxGeneralVS(V, REST)
+    requires applyCmp(">", V, M)
+  rule maxGeneralVS(M:Val, vCons(V:Val, REST:ValSeq))
+    => maxGeneralVS(M, REST)
+    requires notBool applyCmp(">", V, M)
+
+  // State-specific summaries mirror MPY's specialized accumulator and the
+  // exact point where a mixed numeric value hands execution to #maxAccV.
+  syntax Val ::= maxIntNumericVS(Int, ValSeq) [function]
+  rule maxIntNumericVS(M:Int, .ValSeq) => M
+  rule maxIntNumericVS(M:Int, vCons(V:Val, REST:ValSeq))
+    => maxIntNumericVS(maxInt(M, projectIntTotal(V)), REST)
+    requires isInt(V)
+  rule maxIntNumericVS(M:Int, vCons(V:Val, REST:ValSeq))
+    => maxGeneralVS(M, vCons(V, REST))
+    requires isFloat(V) orBool isBool(V)
+
+  syntax Val ::= maxFloatNumericVS(Float, ValSeq) [function]
+  rule maxFloatNumericVS(M:Float, .ValSeq) => M
+  rule maxFloatNumericVS(M:Float, vCons(V:Val, REST:ValSeq))
+    => maxFloatNumericVS(
+         maxFloat(M, projectFloatTotal(V)),
+         REST
+       )
+    requires isFloat(V)
+  rule maxFloatNumericVS(M:Float, vCons(V:Val, REST:ValSeq))
+    => maxGeneralVS(M, vCons(V, REST))
+    requires isInt(V) orBool isBool(V)
+endmodule

