diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fa314c815f91fc3857312fc50aaa142130f7e2cc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [max-int-acc]:
+    <k> #maxAcc(list(VS:ValSeq), M:Int) => maxIntVS(M, VS) ... </k>
+    requires allIntVS(VS)
+
+  claim [max-element-int]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(I:Int, REST:ValSeq)))
+      => maxIntVS(I, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allIntVS(REST)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..60c9767cf6ad0ad9ad37970c9de71dc624048a9c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly when every value in the sequence is an integer.
+  syntax Bool ::= allIntVS(ValSeq) [function, total]
+  rule allIntVS(.ValSeq) => true
+  rule allIntVS(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allIntVS(REST)
+
+  // A guarded total twin of Val's partial projection to Int.  It is used only
+  // when allIntVS has established isInt(V).
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+  rule #Ceil({@V:Val}:>Int)
+    => ({ isInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires isInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires isInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+
+  // Sort-disjointness and dispatch twins needed by the symbolic backend.  Each
+  // restates a fact already enforced by MPY's static Int rules.
+  rule isFloat(V:Val) => false
+    requires isInt(V)
+    [simplification]
+  rule isBool(V:Val) => false
+    requires isInt(V)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Int)
+    => projectIntTotal(V) >Int M
+    requires isInt(V)
+    [simplification]
+
+  // The maximum of the accumulator and every integer in REST.
+  syntax Int ::= maxIntVS(Int, ValSeq) [function]
+  rule maxIntVS(M:Int, .ValSeq) => M
+  rule maxIntVS(M:Int, vCons(V:Val, REST:ValSeq))
+    => maxIntVS(maxInt(M, projectIntTotal(V)), REST)
+    requires isInt(V)
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.max-int-acc' in /workspace
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1118e9b402feccf96d3208c83f132e5e7b1cdf3
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,8 @@
+def max_element(l: list):
+    return max(l)
+
+
+assert max_element([1, 2, 3]) == 3
+assert max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]) == 123
+assert max_element([-4]) == -4
+assert max_element(["ant", "zebra", "yak"]) == "zebra"
