+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumericVS(REST)
+
+  claim [max-element-bool-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(B:Bool, REST:ValSeq)))
+      => maxNumericGeneralVS(B, REST)
+    </k>
+    <env> 0 </env>
