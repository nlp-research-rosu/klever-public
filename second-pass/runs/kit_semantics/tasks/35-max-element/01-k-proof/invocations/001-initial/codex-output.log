    "all" |-> builtinV ( "all" )
    "any" |-> builtinV ( "any" )
    "bin" |-> builtinV ( "bin" )
    "chr" |-> builtinV ( "chr" )
    "enumerate" |-> builtinV ( "enumerate" )
    "eval" |-> builtinV ( "eval" )
    "float" |-> typeV ( "float" )
    "int" |-> typeV ( "int" )
    "isinstance" |-> builtinV ( "isinstance" )
    "len" |-> builtinV ( "len" )
    "list" |-> builtinV ( "list" )
    "map" |-> builtinV ( "map" )
    "max" |-> builtinV ( "max" )
    "min" |-> builtinV ( "min" )
    "ord" |-> builtinV ( "ord" )
    "range" |-> builtinV ( "range" )
    "round" |-> builtinV ( "round" )
    "set" |-> builtinV ( "set" )
    "sorted" |-> builtinV ( "sorted" )
    "str" |-> typeV ( "str" )
    "sum" |-> builtinV ( "sum" )

exec
/bin/bash -lc 'set +e
kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY > vacuity.out 2>&1
vacuity_rc=$?
kprove spec-body-mutation.k --definition verification-kompiled --spec-module SPEC-BODY-MUTATION > body-mutation.out 2>&1
body_rc=$?
printf '"'vacuity exit: %s\\nbody mutation exit: %s\\n' \""'$vacuity_rc" "$body_rc"
printf '"'%s\\n' '--- vacuity tail ---'
tail -n 35 vacuity.out
printf '%s\\n' '--- body mutation tail ---'
tail -n 35 body-mutation.out
if [ \""'$vacuity_rc" -eq 0 ] || [ "$body_rc" -eq 0 ]; then exit 1; fi
exit 0' in /workspace
