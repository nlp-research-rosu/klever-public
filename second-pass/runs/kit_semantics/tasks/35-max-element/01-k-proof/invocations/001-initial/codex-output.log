+
+  // The maximum of the accumulator and every integer in REST.  This is also
+  // retained as a focused mathematical theorem for the examples' domain.
+  syntax Int ::= maxIntVS(Int, ValSeq) [function]
+  rule maxIntVS(M:Int, .ValSeq) => M
+  rule maxIntVS(M:Int, vCons(V:Val, REST:ValSeq))
+    => maxIntVS(maxInt(M, projectIntTotal(V)), REST)
