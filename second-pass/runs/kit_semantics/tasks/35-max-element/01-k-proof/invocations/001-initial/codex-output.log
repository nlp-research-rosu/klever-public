+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
