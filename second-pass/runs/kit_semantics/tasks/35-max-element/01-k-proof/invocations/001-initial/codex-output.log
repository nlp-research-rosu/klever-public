diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..61cecaf0bb4146b492442dcd746b4e7152c07dcd
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: returning 0 must not establish the original
+  // max_element([1]) result.
+  claim [mutated-body]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Int(0))
+          )
+        )
+      )
+      ~> Call(
+           Name("max_element"),
+           list(vCons(1, .ValSeq))
+         )
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Int(0)) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..59b15f6ca767bfb99421527c4721e80eb617f13a
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: max_element([1, 2]) is 2, not 1.  This also forces
+  // the greater-than/replacement branch of the numeric fold.
+  claim [false-result]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(
+           Name("max_element"),
+           list(vCons(1, vCons(2, .ValSeq)))
+         )
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..35d088cf7fc7890d204b5ceff8b01a36a37d218b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,198 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [max-int-numeric-acc]:
+    <k>
+      #maxAcc(list(VS:ValSeq), M:Int)
+      =>
+      maxIntNumericVS(M, VS)
+      ...
+    </k>
+    requires allNumericVS(VS)
+
+  claim [max-float-numeric-acc]:
+    <k>
+      #maxAccF(list(VS:ValSeq), M:Float)
+      =>
+      maxFloatNumericVS(M, VS)
+      ...
+    </k>
+    requires allNumericVS(VS)
+
+  claim [max-general-numeric-acc]:
+    <k>
+      #maxAccV(list(VS:ValSeq), M:Val)
+      =>
+      maxNumericGeneralVS(M, VS)
+      ...
+    </k>
+    requires isNumericV(M) andBool allNumericVS(VS)
+
+  claim [max-element-int-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(I:Int, REST:ValSeq)))
+      => maxIntNumericVS(I, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumericVS(REST)
+
+  claim [max-element-float-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(F:Float, REST:ValSeq)))
+      => maxFloatNumericVS(F, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumericVS(REST)
+
+  claim [max-element-bool-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(B:Bool, REST:ValSeq)))
+      => maxNumericGeneralVS(B, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumericVS(REST)
+
+endmodule
+
+module SPEC-STR
+  imports VERIFICATION
+
+  claim [max-general-str-acc]:
+    <k>
+      #maxAccV(list(VS:ValSeq), M:Val)
+      =>
+      maxStrGeneralVS(M, VS)
+      ...
+    </k>
+    requires isStr(M) andBool allStrVS(VS)
+
+  claim [max-element-str-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(S:Str, REST:ValSeq)))
+      => maxStrGeneralVS(S, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrVS(REST)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5df517ef93be7b60cd1be287bb5a5b105f36dafc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,206 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A guarded total twin of Val's partial projection to Int.
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+  rule #Ceil({@V:Val}:>Int)
+    => ({ isInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires isInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires isInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+
+  // Dispatch twin needed by the symbolic backend.  It restates the equation
+  // already enforced by MPY's static Int rule.
+  rule applyCmp(">", V:Val, M:Int)
+    => projectIntTotal(V) >Int M
+    requires isInt(V)
+    [simplification]
+
+  // ---- Full fixed-semantics max domain -----------------------------------
+
+  syntax Bool ::= isNumericV(Val) [function, total]
+  rule isNumericV(V:Val)
+    => isInt(V) orBool isBool(V) orBool isFloat(V)
+
+  syntax Bool ::= allNumericVS(ValSeq) [function, total]
+  rule allNumericVS(.ValSeq) => true
+  rule allNumericVS(vCons(V:Val, REST:ValSeq))
+    => isNumericV(V) andBool allNumericVS(REST)
+
+  syntax Bool ::= allStrVS(ValSeq) [function, total]
+  rule allStrVS(.ValSeq) => true
+  rule allStrVS(vCons(V:Val, REST:ValSeq))
+    => isStr(V) andBool allStrVS(REST)
+
+  // Guarded total projections for the other three orderable value sorts.
+  syntax Float ::= projectFloatTotal(Val)
+    [function, total, symbol(projectFloatTotal), no-evaluators]
+  rule #Ceil({@V:Val}:>Float)
+    => ({ isFloat(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectFloatTotal(V:Val) => {V}:>Float
+    requires isFloat(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Float => projectFloatTotal(V)
+    requires isFloat(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectFloatTotal(F:Float) => F [simplification]
+
+  // Haskell has no FLOAT.max hook.  Symbolic proofs keep this fixed primitive
+  // opaque and thread its Float result; LLVM ground execution still evaluates
+  // the real hook through the concrete equation.
+  syntax Float ::= maxFOpaque(Float, Float)
+    [function, total, symbol(maxFOpaque), no-evaluators]
+  rule maxFOpaque(F1:Float, F2:Float) => maxFloat(F1, F2) [concrete]
+  rule maxFloat(F1:Float, F2:Float) => maxFOpaque(F1, F2)
+    [symbolic(F1, F2), simplification]
+
+  syntax Bool ::= projectBoolTotal(Val)
+    [function, total, symbol(projectBoolTotal), no-evaluators]
+  rule #Ceil({@V:Val}:>Bool)
+    => ({ isBool(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectBoolTotal(V:Val) => {V}:>Bool
+    requires isBool(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Bool => projectBoolTotal(V)
+    requires isBool(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectBoolTotal(B:Bool) => B [simplification]
+
+  syntax Str ::= projectStrTotal(Val)
+    [function, total, symbol(projectStrTotal), no-evaluators]
+  rule #Ceil({@V:Val}:>Str)
+    => ({ isStr(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectStrTotal(V:Val) => {V}:>Str
+    requires isStr(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Str => projectStrTotal(V)
+    requires isStr(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectStrTotal(S:Str) => S [simplification]
+
+  syntax IntSeq ::= codesOf(Str) [function, total]
+  rule codesOf(str(CS:IntSeq)) => CS
+
+  // A total tagged view of Val.  Its four disjoint guards cover every Val;
+  // only the first three cases are admitted by allNumericVS.
+  syntax NumericView ::= nInt(Int)
+                       | nBool(Bool)
+                       | nFloat(Float)
+                       | nOther(Val)
+  syntax NumericView ::= numericView(Val) [function, total]
+  rule numericView(V:Val) => nInt(projectIntTotal(V))
+    requires isInt(V)
+  rule numericView(V:Val) => nBool(projectBoolTotal(V))
+    requires isBool(V)
+  rule numericView(V:Val) => nFloat(projectFloatTotal(V))
+    requires isFloat(V)
+  rule numericView(V:Val) => nOther(V)
+    requires notBool isNumericV(V)
+
+  // Exhaustive comparison table.  Every numeric equation is the RHS of MPY's
+  // existing static applyCmp dispatch for the corresponding pair of sorts.
+  syntax Bool ::= numericGt(NumericView, NumericView) [function, total]
+  rule numericGt(nInt(I:Int), nInt(J:Int)) => I >Int J
+  rule numericGt(nInt(I:Int), nBool(B:Bool))
+    => I >Int boolAsInt(B)
+  rule numericGt(nBool(B:Bool), nInt(I:Int))
+    => boolAsInt(B) >Int I
+  rule numericGt(nBool(B1:Bool), nBool(B2:Bool))
+    => boolAsInt(B1) >Int boolAsInt(B2)
+  rule numericGt(nFloat(F1:Float), nFloat(F2:Float)) => gtF(F1, F2)
+  rule numericGt(nInt(I:Int), nFloat(F:Float)) => ltFI(F, I)
+  rule numericGt(nFloat(F:Float), nInt(I:Int)) => ltIF(I, F)
+  rule numericGt(nBool(B:Bool), nFloat(F:Float))
+    => ltFI(F, boolAsInt(B))
+  rule numericGt(nFloat(F:Float), nBool(B:Bool))
+    => ltIF(boolAsInt(B), F)
+  rule numericGt(nOther(_:Val), _:NumericView) => false
+  rule numericGt(_:NumericView, nOther(_:Val)) => false
+
+  // Dynamic dispatch twins for the two orderable domains.
+  rule applyCmp(">", V:Val, M:Val)
+    => numericGt(numericView(V), numericView(M))
+    requires isNumericV(V) andBool isNumericV(M)
+    [simplification]
+  rule applyCmp(">", V:Val, M:Val)
+    => strLt(codesOf(projectStrTotal(M)), codesOf(projectStrTotal(V)))
+    requires isStr(V) andBool isStr(M)
+    [simplification]
+
+  // The three value-sort predicates are mutually exclusive in K even though
+  // the symbolic backend does not infer that fact from a Boolean guard.
+  rule isFloat(V:Val) orBool isBool(V) => false
+    requires isInt(V)
+    [simplification]
+  rule isInt(V:Val) orBool isBool(V) => false
+    requires isFloat(V)
+    [simplification]
+  rule isInt(V:Val) orBool isFloat(V) => false
+    requires isBool(V)
+    [simplification]
+
+  // General strict-comparison folds.  They keep the first element on ties,
+  // matching MPY's #maxAccV continuation.
+  syntax Val ::= maxNumericGeneralVS(Val, ValSeq) [function]
+  rule maxNumericGeneralVS(M:Val, .ValSeq) => M
+  rule maxNumericGeneralVS(M:Val, vCons(V:Val, REST:ValSeq))
+    => maxNumericGeneralVS(
+         #if numericGt(numericView(V), numericView(M))
+         #then V
+         #else M
+         #fi,
+         REST
+       )
+
+  syntax Val ::= maxStrGeneralVS(Val, ValSeq) [function]
+  rule maxStrGeneralVS(M:Val, .ValSeq) => M
+  rule maxStrGeneralVS(M:Val, vCons(V:Val, REST:ValSeq))
+    => maxStrGeneralVS(
+         #if strLt(
+               codesOf(projectStrTotal(M)),
+               codesOf(projectStrTotal(V))
+             )
+         #then V
+         #else M
+         #fi,
+         REST
+       )
+
+  // State-specific summaries mirror MPY's specialized accumulator and the
+  // exact point where a mixed numeric value hands execution to #maxAccV.
+  syntax Val ::= maxIntNumericVS(Int, ValSeq) [function]
+  rule maxIntNumericVS(M:Int, .ValSeq) => M
+  rule maxIntNumericVS(M:Int, vCons(V:Val, REST:ValSeq))
+    => maxIntNumericVS(maxInt(M, projectIntTotal(V)), REST)
+    requires isInt(V)
+    [simplification]
+  rule maxIntNumericVS(M:Int, vCons(V:Val, REST:ValSeq))
+    => maxNumericGeneralVS(M, vCons(V, REST))
+    requires isFloat(V) orBool isBool(V)
+    [simplification]
+
+  syntax Val ::= maxFloatNumericVS(Float, ValSeq) [function]
+  rule maxFloatNumericVS(M:Float, .ValSeq) => M
+  rule maxFloatNumericVS(M:Float, vCons(V:Val, REST:ValSeq))
+    => maxFloatNumericVS(
+         maxFloat(M, projectFloatTotal(V)),
+         REST
+       )
+    requires isFloat(V)
+    [simplification]
+  rule maxFloatNumericVS(M:Float, vCons(V:Val, REST:ValSeq))
+    => maxNumericGeneralVS(M, vCons(V, REST))
+    requires isInt(V) orBool isBool(V)
+    [simplification]
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..14c1df2f7a2c49590d03a3470b1c25642c3b03ff
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+
+python3 smoke.py
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun smoke.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-STR
+
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY; then
+  echo "ERROR: false-result mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-result mutation was rejected"
+fi
+
+if kprove spec-body-mutation.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-BODY-MUTATION; then
+  echo "ERROR: mutated body unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: mutated body was rejected"
+fi
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea9033fd8e7646b17a484ff45c655c94c5ae7cc6
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,12 @@
+def max_element(l: list):
+    return max(l)
+
+
+assert max_element([1, 2, 3]) == 3
+assert max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]) == 123
+assert max_element([-4]) == -4
+assert max_element(["ant", "zebra", "yak"]) == "zebra"
+assert max_element([False, True, False]) == True
+assert max_element([1, 2.5, True, -4]) == 2.5
+assert max_element([1.5, -2, 3.25]) == 3.25
+assert max_element([9007199254740993, 9007199254740992.0]) == 9007199254740993
