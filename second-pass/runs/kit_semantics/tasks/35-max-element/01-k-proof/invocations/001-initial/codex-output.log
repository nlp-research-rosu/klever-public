diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..61cecaf0bb4146b492442dcd746b4e7152c07dcd
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: returning 0 must not establish the original
+  // max_element([1]) result.
+  claim [mutated-body]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Int(0))
+          )
+        )
+      )
+      ~> Call(
+           Name("max_element"),
+           list(vCons(1, .ValSeq))
+         )
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Int(0)) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..59b15f6ca767bfb99421527c4721e80eb617f13a
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: max_element([1, 2]) is 2, not 1.  This also forces
+  // the greater-than/replacement branch of the numeric fold.
+  claim [false-result]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(
+           Name("max_element"),
+           list(vCons(1, vCons(2, .ValSeq)))
+         )
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..35d088cf7fc7890d204b5ceff8b01a36a37d218b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,198 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [max-int-numeric-acc]:
+    <k>
+      #maxAcc(list(VS:ValSeq), M:Int)
+      =>
+      maxIntNumericVS(M, VS)
+      ...
+    </k>
+    requires allNumericVS(VS)
+
+  claim [max-float-numeric-acc]:
+    <k>
+      #maxAccF(list(VS:ValSeq), M:Float)
+      =>
+      maxFloatNumericVS(M, VS)
+      ...
+    </k>
+    requires allNumericVS(VS)
+
+  claim [max-general-numeric-acc]:
+    <k>
+      #maxAccV(list(VS:ValSeq), M:Val)
+      =>
+      maxNumericGeneralVS(M, VS)
+      ...
+    </k>
+    requires isNumericV(M) andBool allNumericVS(VS)
+
+  claim [max-element-int-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(I:Int, REST:ValSeq)))
+      => maxIntNumericVS(I, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumericVS(REST)
+
+  claim [max-element-float-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(F:Float, REST:ValSeq)))
+      => maxFloatNumericVS(F, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumericVS(REST)
+
+  claim [max-element-bool-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(B:Bool, REST:ValSeq)))
+      => maxNumericGeneralVS(B, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumericVS(REST)
+
+endmodule
+
+module SPEC-STR
+  imports VERIFICATION
+
+  claim [max-general-str-acc]:
+    <k>
+      #maxAccV(list(VS:ValSeq), M:Val)
+      =>
+      maxStrGeneralVS(M, VS)
+      ...
+    </k>
+    requires isStr(M) andBool allStrVS(VS)
+
+  claim [max-element-str-head]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(S:Str, REST:ValSeq)))
+      => maxStrGeneralVS(S, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrVS(REST)
+endmodule
