+      #maxAccV(list(VS:ValSeq), M:Val)
+      =>
+      maxStrGeneralVS(M, VS)
+      ...
+    </k>
+    requires isStr(M) andBool allStrVS(VS)
+
+  claim [max-element-int]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "max_element",
+            Params("l"),
+            Return(Call(Name("max"), Name("l")))
+          )
+        )
+      )
+      ~> Call(Name("max_element"), list(vCons(I:Int, REST:ValSeq)))
+      => maxIntVS(I, REST)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "max_element" |->
+          closureVal(
+            ("l", .ParamNames),
+            (Return(Call(Name("max"), Name("l"))) .Stmts),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allIntVS(REST)
