Module(
  FuncDef("max_element", Params("l"),
    Return(Call(Name("max"), Name("l"))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(
          Int(5),
          Int(3),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(3)),
          Int(3),
          Int(9),
          Int(0),
          Int(123),
          Int(1),
          UnaryOp("-", Int(10)))),
      CmpOp("==", Int(123))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(UnaryOp("-", Int(4)))),
      CmpOp("==", UnaryOp("-", Int(4)))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(Str("ant"), Str("zebra"), Str("yak"))),
      CmpOp("==", Str("zebra"))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(Bool(false), Bool(true), Bool(false))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(Int(1), Float(2.5), Bool(true), UnaryOp("-", Int(4)))),
      CmpOp("==", Float(2.5))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(Float(1.5), UnaryOp("-", Int(2)), Float(3.25))),
      CmpOp("==", Float(3.25))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(Int(9007199254740993), Float(9007199254740992.0))),
      CmpOp("==", Int(9007199254740993)))))
