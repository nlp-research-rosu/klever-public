{"attributes": [], "classification": "DEFINITION", "id_matches_hash": true, "independent_normalized_sha256": "32a51cee3fc6f0e6bd5594fce41b3f278ca36b027dc489b37ccdf93c9e2fc8c0", "index": 49, "module": "VERIFICATION", "normalized_sha256": "32a51cee3fc6f0e6bd5594fce41b3f278ca36b027dc489b37ccdf93c9e2fc8c0", "rationale": "Structural recurrence defining maxStrGeneralVS by lexicographic comparison and tail recursion.", "source_rule_id": "rule-32a51cee3fc6f0e6bd5594fce41b3f278ca36b027dc489b37ccdf93c9e2fc8c0", "source_span": [168, 178], "text": "  rule maxStrGeneralVS(M:Val, vCons(V:Val, REST:ValSeq))\n    => maxStrGeneralVS(\n         #if strLt(\n               codesOf(projectStrTotal(M)),\n               codesOf(projectStrTotal(V))\n             )\n         #then V\n         #else M\n         #fi,\n         REST\n       )"}
{"attributes": [], "classification": "DEFINITION", "id_matches_hash": true, "independent_normalized_sha256": "e81ed6ec77a43a8e8c85671143c37ab554f1caa2f9c323c33226ab2692d4363c", "index": 50, "module": "VERIFICATION", "normalized_sha256": "e81ed6ec77a43a8e8c85671143c37ab554f1caa2f9c323c33226ab2692d4363c", "rationale": "Base equation defining maxIntNumericVS on an empty remaining sequence.", "source_rule_id": "rule-e81ed6ec77a43a8e8c85671143c37ab554f1caa2f9c323c33226ab2692d4363c", "source_span": [183, 183], "text": "  rule maxIntNumericVS(M:Int, .ValSeq) => M"}
{"attributes": ["simplification"], "classification": "DEFINITION", "id_matches_hash": true, "independent_normalized_sha256": "23754d023b3d3104d4c9eb14a6c6ce7d0b4af2ec9955785c89f12b97d0361d22", "index": 51, "module": "VERIFICATION", "normalized_sha256": "23754d023b3d3104d4c9eb14a6c6ce7d0b4af2ec9955785c89f12b97d0361d22", "rationale": "Guarded recursive equation defining the same-sort Int step of maxIntNumericVS.", "source_rule_id": "rule-23754d023b3d3104d4c9eb14a6c6ce7d0b4af2ec9955785c89f12b97d0361d22", "source_span": [184, 187], "text": "  rule maxIntNumericVS(M:Int, vCons(V:Val, REST:ValSeq))\n    => maxIntNumericVS(maxInt(M, projectIntTotal(V)), REST)\n    requires isInt(V)\n    [simplification]"}
{"attributes": ["simplification"], "classification": "DEFINITION", "id_matches_hash": true, "independent_normalized_sha256": "e2e1300056aa1f76bdc99d920a1c5e589e92a6269d99eede2b557430c0430894", "index": 52, "module": "VERIFICATION", "normalized_sha256": "e2e1300056aa1f76bdc99d920a1c5e589e92a6269d99eede2b557430c0430894", "rationale": "Guarded equation defining the mixed-type handoff from maxIntNumericVS to maxNumericGeneralVS.", "source_rule_id": "rule-e2e1300056aa1f76bdc99d920a1c5e589e92a6269d99eede2b557430c0430894", "source_span": [188, 191], "text": "  rule maxIntNumericVS(M:Int, vCons(V:Val, REST:ValSeq))\n    => maxNumericGeneralVS(M, vCons(V, REST))\n    requires isFloat(V) orBool isBool(V)\n    [simplification]"}
{"attributes": [], "classification": "DEFINITION", "id_matches_hash": true, "independent_normalized_sha256": "c7f10070b563d562d1e001d975ca7a7ab7c1b7b6f0b37efc41fe9f3b8ce838cd", "index": 53, "module": "VERIFICATION", "normalized_sha256": "c7f10070b563d562d1e001d975ca7a7ab7c1b7b6f0b37efc41fe9f3b8ce838cd", "rationale": "Base equation defining maxFloatNumericVS on an empty remaining sequence.", "source_rule_id": "rule-c7f10070b563d562d1e001d975ca7a7ab7c1b7b6f0b37efc41fe9f3b8ce838cd", "source_span": [194, 194], "text": "  rule maxFloatNumericVS(M:Float, .ValSeq) => M"}
{"attributes": ["simplification"], "classification": "DEFINITION", "id_matches_hash": true, "independent_normalized_sha256": "39e9adbcf4aa0f6c0ecae743fd3ad49cc429a4e5cdcbb35be91f3d7286fdd0b7", "index": 54, "module": "VERIFICATION", "normalized_sha256": "39e9adbcf4aa0f6c0ecae743fd3ad49cc429a4e5cdcbb35be91f3d7286fdd0b7", "rationale": "Guarded recursive equation defining the same-sort Float step of maxFloatNumericVS.", "source_rule_id": "rule-39e9adbcf4aa0f6c0ecae743fd3ad49cc429a4e5cdcbb35be91f3d7286fdd0b7", "source_span": [195, 201], "text": "  rule maxFloatNumericVS(M:Float, vCons(V:Val, REST:ValSeq))\n    => maxFloatNumericVS(\n         maxFloat(M, projectFloatTotal(V)),\n         REST\n       )\n    requires isFloat(V)\n    [simplification]"}
{"attributes": ["simplification"], "classification": "DEFINITION", "id_matches_hash": true, "independent_normalized_sha256": "f9cf2e7b6b077884daea9768277f93ed6c400899cfe5e3ff11e9f5f295f290dc", "index": 55, "module": "VERIFICATION", "normalized_sha256": "f9cf2e7b6b077884daea9768277f93ed6c400899cfe5e3ff11e9f5f295f290dc", "rationale": "Guarded equation defining the mixed-type handoff from maxFloatNumericVS to maxNumericGeneralVS.", "source_rule_id": "rule-f9cf2e7b6b077884daea9768277f93ed6c400899cfe5e3ff11e9f5f295f290dc", "source_span": [202, 205], "text": "  rule maxFloatNumericVS(M:Float, vCons(V:Val, REST:ValSeq))\n    => maxNumericGeneralVS(M, vCons(V, REST))\n    requires isInt(V) orBool isBool(V)\n    [simplification]"}
