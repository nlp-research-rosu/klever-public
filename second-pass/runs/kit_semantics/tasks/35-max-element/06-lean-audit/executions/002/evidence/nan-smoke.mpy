Module(
  FuncDef("max_element", Params("l"),
    Return(Call(Name("max"), Name("l"))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(Float(NaN), Float(1.0))),
      CmpOp("==", Float(1.0))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(Float(1.0), Float(NaN))),
      CmpOp("==", Float(1.0)))))
