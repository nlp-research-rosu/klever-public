  private double min(double a, double b) {
    if (a != a) {
      return b;
    }
    if (b != b) {
      return a;
    }
    return Math.min(a, b);
  }

  private double max(double a, double b) {
    if (a != a) {
      return b;
    }
    if (b != b) {
      return a;
    }
    return Math.max(a, b);
  }

