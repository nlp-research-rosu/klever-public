    (operator : SortString) (f : SortFloat) (i : SortInt) : SortBool :=
  match operator with
  | "<" => floatLessThanIntImpl f i
  | "<=" => !intLessThanFloatImpl i f
  | ">" => intLessThanFloatImpl i f
  | ">=" => !floatLessThanIntImpl f i
  | "==" => intEqualFloatImpl i f
  | "!=" => !intEqualFloatImpl i f
  | _ => false

private def strCompareImpl
    (operator : SortString) (a b : SortIntSeq) : SortBool :=
  match operator with
  | "==" => intSeqEqualImpl a b
  | "!=" => !intSeqEqualImpl a b
  | "in" => strContainsImpl a b
  | "not in" => !strContainsImpl a b
