   223	private def dyadicLessThanIntImpl
   224	    (d : FloatDyadicImpl) (i : SortInt) : SortBool :=
   225	  if d.exponent ≥ 0 then
   226	    decide (d.mantissa * Int.ofNat (2 ^ d.exponent.toNat) < i)
   227	  else
   228	    decide (d.mantissa < i * Int.ofNat (2 ^ (-d.exponent).toNat))
   229	
   230	private def intLessThanDyadicImpl
   231	    (i : SortInt) (d : FloatDyadicImpl) : SortBool :=
   232	  if d.exponent ≥ 0 then
   233	    decide (i < d.mantissa * Int.ofNat (2 ^ d.exponent.toNat))
   234	  else
   235	    decide (i * Int.ofNat (2 ^ (-d.exponent).toNat) < d.mantissa)
   236	
   237	private def intEqualDyadicImpl
   238	    (i : SortInt) (d : FloatDyadicImpl) : SortBool :=
   239	  if d.exponent ≥ 0 then
   240	    decide (i = d.mantissa * Int.ofNat (2 ^ d.exponent.toNat))
   241	  else
   242	    decide (i * Int.ofNat (2 ^ (-d.exponent).toNat) = d.mantissa)
   243	
   244	private def floatLessThanIntImpl (f : SortFloat) (i : SortInt) : SortBool :=
   245	  match floatDyadicImpl f with
   246	  | some d => dyadicLessThanIntImpl d i
   247	  | none =>
   248	      if f.isNaN then false else floatSignBitImpl f
