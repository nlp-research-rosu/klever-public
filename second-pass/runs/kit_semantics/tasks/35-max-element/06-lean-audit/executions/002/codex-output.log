   435	      SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» keys₂ values₂ =>
   436	      if operator = "==" then dictEqualImpl keys₁ values₁ keys₂ values₂
   437	      else false
   438	  | _, _ => false
