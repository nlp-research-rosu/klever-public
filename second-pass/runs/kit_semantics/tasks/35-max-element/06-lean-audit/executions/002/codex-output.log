   322	private def intCompareImpl
   323	    (operator : SortString) (a b : SortInt) : SortBool :=
   324	  match operator with
   325	  | "<" => decide (a < b)
   326	  | "<=" => decide (a ≤ b)
   327	  | ">" => decide (a > b)
   328	  | ">=" => decide (a ≥ b)
   329	  | "==" => decide (a = b)
   330	  | "!=" => decide (a ≠ b)
   331	  | _ => false
   332	
   333	private def floatCompareImpl
   334	    (operator : SortString) (a b : SortFloat) : SortBool :=
   335	  match operator with
   336	  | "<" => floatLessImpl a b
   337	  | "<=" => !floatGreaterImpl a b
   338	  | ">" => floatGreaterImpl a b
   339	  | ">=" => !floatLessImpl a b
   340	  | "==" => floatEqualImpl a b
   341	  | "!=" => !floatEqualImpl a b
   342	  | _ => false
   343	
   344	private def intFloatCompareImpl
   345	    (operator : SortString) (i : SortInt) (f : SortFloat) : SortBool :=
   346	  match operator with
   347	  | "<" => intLessThanFloatImpl i f
   348	  | "<=" => !floatLessThanIntImpl f i
   349	  | ">" => floatLessThanIntImpl f i
   350	  | ">=" => !intLessThanFloatImpl i f
   351	  | "==" => intEqualFloatImpl i f
   352	  | "!=" => !intEqualFloatImpl i f
   353	  | _ => false
   354	
   355	private def floatIntCompareImpl
   356	    (operator : SortString) (f : SortFloat) (i : SortInt) : SortBool :=
   357	  match operator with
   358	  | "<" => floatLessThanIntImpl f i
   359	  | "<=" => !intLessThanFloatImpl i f
   360	  | ">" => intLessThanFloatImpl i f
   361	  | ">=" => !floatLessThanIntImpl f i
   362	  | "==" => intEqualFloatImpl i f
   363	  | "!=" => !intEqualFloatImpl i f
   364	  | _ => false
   365	
   366	private def strCompareImpl
   367	    (operator : SortString) (a b : SortIntSeq) : SortBool :=
   368	  match operator with
   369	  | "==" => intSeqEqualImpl a b
   370	  | "!=" => !intSeqEqualImpl a b
   371	  | "in" => strContainsImpl a b
   372	  | "not in" => !strContainsImpl a b
   373	  | "<" => strLessImpl a b
   374	  | ">" => strLessImpl b a
   375	  | "<=" => !strLessImpl b a
   376	  | ">=" => !strLessImpl a b
   377	  | _ => false
