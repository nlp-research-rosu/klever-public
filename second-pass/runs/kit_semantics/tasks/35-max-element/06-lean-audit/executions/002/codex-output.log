private def intEqualFloatImpl (i : SortInt) (f : SortFloat) : SortBool :=
  match floatDyadicImpl f with
  | some d => intEqualDyadicImpl i d
  | none => false

private def floatLessImpl (a b : SortFloat) : SortBool := decide (a < b)
private def floatGreaterImpl (a b : SortFloat) : SortBool := decide (b < a)
