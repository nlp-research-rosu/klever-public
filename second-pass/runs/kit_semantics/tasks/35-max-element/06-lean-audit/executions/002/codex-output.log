   418	        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» a),
   419	      SortVal.inj_SortIterable
   420	        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» b) =>
   421	      if operator = "==" then valSeqTermEqualImpl a b
   422	      else if operator = "!=" then !valSeqTermEqualImpl a b
   423	      else false
   424	  | SortVal.inj_SortIterable
   425	        (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» a),
   426	      SortVal.inj_SortIterable
   427	        (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» b) =>
   428	      if operator = "==" then valSeqTermEqualImpl a b
   429	      else if operator = "!=" then !valSeqTermEqualImpl a b
   430	      else false
   431	  | SortVal.«setV(_)_MPY-SET_Val_IntSeq» a,
   432	      SortVal.«setV(_)_MPY-SET_Val_IntSeq» b =>
   433	      if operator = "==" then sameSetImpl a b else false
