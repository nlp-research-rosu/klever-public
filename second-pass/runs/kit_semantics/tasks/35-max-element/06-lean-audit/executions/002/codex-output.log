   250	private def intLessThanFloatImpl (i : SortInt) (f : SortFloat) : SortBool :=
   251	  match floatDyadicImpl f with
   252	  | some d => intLessThanDyadicImpl i d
   253	  | none =>
   254	      if f.isNaN then false else !floatSignBitImpl f
   255	
   256	private def intEqualFloatImpl (i : SortInt) (f : SortFloat) : SortBool :=
   257	  match floatDyadicImpl f with
   258	  | some d => intEqualDyadicImpl i d
   259	  | none => false
