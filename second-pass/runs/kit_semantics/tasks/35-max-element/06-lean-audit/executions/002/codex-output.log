index 0000000000000000000000000000000000000000..747823a83c1df467c5d77410c31db868d6c48984
--- /dev/null
+++ b/evidence/09b_k_adversarial_run.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+set -euo pipefail
+set -x
+
+test -d /tmp/audit-work/max-float-test-kompiled
+krun --definition /tmp/audit-work/max-float-test-kompiled -cPGM=nanLeft
