+  /audit-output/evidence/proc_pid_shim.c \
+  -o /tmp/audit-work/proc_pid_shim.so
+
+sha256sum \
+  /audit-output/evidence/proc_pid_shim.c \
+  /tmp/audit-work/proc_pid_shim.so
+
