   302	  | SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» a,
   303	      SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» b =>
   304	      intGreaterImpl (boolAsIntImpl a) (boolAsIntImpl b)
   305	  | SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» a,
