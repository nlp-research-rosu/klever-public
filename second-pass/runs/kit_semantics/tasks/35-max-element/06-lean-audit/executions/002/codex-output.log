   379	/- Complete frozen applyCmp rule table.  The final arm is used only when MPY
   380	   has no applyCmp rule for that operator/sort combination (a stuck K term). -/
   381	private noncomputable def cmpDispatchImpl
   382	    (operator : SortString) (left right : SortVal) : SortBool :=
   383	  match left, right with
   384	  | _, SortVal.«noneV_MPY-CORE_Val» =>
   385	      match operator with
   386	      | "==" | "is" =>
   387	          match left with
   388	          | SortVal.«noneV_MPY-CORE_Val» => true
   389	          | _ => false
   390	      | "!=" | "is not" =>
   391	          match left with
   392	          | SortVal.«noneV_MPY-CORE_Val» => false
   393	          | _ => true
   394	      | _ => false
   395	  | SortVal.inj_SortInt a, SortVal.inj_SortInt b =>
   396	      intCompareImpl operator a b
   397	  | SortVal.inj_SortFloat a, SortVal.inj_SortFloat b =>
   398	      floatCompareImpl operator a b
   399	  | SortVal.inj_SortBool a, SortVal.inj_SortBool b =>
   400	      if operator = "==" then decide (a = b)
   401	      else if operator = "!=" then decide (a ≠ b)
   402	      else intCompareImpl operator (boolAsIntImpl a) (boolAsIntImpl b)
   403	  | SortVal.inj_SortBool a, SortVal.inj_SortInt b =>
   404	      intCompareImpl operator (boolAsIntImpl a) b
   405	  | SortVal.inj_SortInt a, SortVal.inj_SortBool b =>
   406	      intCompareImpl operator a (boolAsIntImpl b)
   407	  | SortVal.inj_SortInt i, SortVal.inj_SortFloat f =>
   408	      intFloatCompareImpl operator i f
   409	  | SortVal.inj_SortFloat f, SortVal.inj_SortInt i =>
   410	      floatIntCompareImpl operator f i
   411	  | SortVal.inj_SortBool b, SortVal.inj_SortFloat f =>
   412	      intFloatCompareImpl operator (boolAsIntImpl b) f
   413	  | SortVal.inj_SortFloat f, SortVal.inj_SortBool b =>
   414	      floatIntCompareImpl operator f (boolAsIntImpl b)
   415	  | SortVal.inj_SortStr a, SortVal.inj_SortStr b =>
   416	      strCompareImpl operator (codesFromStrImpl a) (codesFromStrImpl b)
