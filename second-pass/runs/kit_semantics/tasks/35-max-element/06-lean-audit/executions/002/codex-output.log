/- FLOAT.max / fp.max: NaNs propagate, greater operands win, and +0 is selected
   for the equal-zero case. -/
private def floatMaxImpl (a b : SortFloat) : SortFloat :=
  if a.isNaN then a
  else if b.isNaN then b
  else if a < b then b
  else if b < a then a
  else if a.toBits = 0x8000000000000000 && b.toBits = 0 then b
  else if b.toBits = 0x8000000000000000 && a.toBits = 0 then a
  else a

private def numericImpl : SortVal → SortBool
  | SortVal.inj_SortInt _ => true
  | SortVal.inj_SortBool _ => true
  | SortVal.inj_SortFloat _ => true
