+cp -a /reference/klean-generation/generated/. "$counterfactual/Base/"
+
+sed -i '461s/:= floatMaxImpl/:= fun _ _ => 0.0/' "$counterfactual/Proof.lean"
+sed -i '463s/:= floatMaxImpl/:= fun _ _ => 0.0/' "$counterfactual/Proof.lean"
