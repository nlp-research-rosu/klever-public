import Klean35MaxElement.Lemmas

namespace Proof

/-!
The private definitions below are executable models of the K symbols named by
the generated obligations.  Helpers deliberately have names distinct from all
27 public bindings: each generated binding is introduced exactly once, at its
original stub location.
-/

private def valItemImpl : SortVal → SortKItem
  | SortVal.inj_SortBool b => SortKItem.inj_SortBool b
  | SortVal.inj_SortFloat f => SortKItem.inj_SortFloat f
  | SortVal.inj_SortInt i => SortKItem.inj_SortInt i
  | SortVal.inj_SortIterable it => SortKItem.inj_SortIterable it
  | SortVal.inj_SortStr s => SortKItem.inj_SortStr s
  | v => SortKItem.inj_SortVal v

private def valKImpl (v : SortVal) : SortK :=
  SortK.kseq (valItemImpl v) SortK.dotk

private theorem injValItem_eq (v : SortVal) :
    ((@inj SortVal SortKItem) v) = valItemImpl v := by
  cases v <;> rfl

private def boolAndImpl (a b : SortBool) : SortBool := a && b
private def boolOrImpl (a b : SortBool) : SortBool := a || b
private def intGreaterImpl (a b : SortInt) : SortBool := decide (a > b)

private def boolProjectionOptImpl : SortK → Option SortBool
  | SortK.kseq (SortKItem.inj_SortBool b) SortK.dotk => some b
  | _ => none

private def floatProjectionOptImpl : SortK → Option SortFloat
  | SortK.kseq (SortKItem.inj_SortFloat f) SortK.dotk => some f
  | _ => none

private def intProjectionOptImpl : SortK → Option SortInt
  | SortK.kseq (SortKItem.inj_SortInt i) SortK.dotk => some i
  | _ => none

private def strProjectionOptImpl : SortK → Option SortStr
  | SortK.kseq (SortKItem.inj_SortStr s) SortK.dotk => some s
  | _ => none

private def isBoolImpl (k : SortK) : SortBool :=
  (boolProjectionOptImpl k).isSome

private def isFloatImpl (k : SortK) : SortBool :=
  (floatProjectionOptImpl k).isSome

private def isIntImpl (k : SortK) : SortBool :=
  (intProjectionOptImpl k).isSome

private def isStrImpl (k : SortK) : SortBool :=
  (strProjectionOptImpl k).isSome

/- The partial K casts are represented by honest projections on their domain.
   Their otherwise-unreachable total branches are canonical inhabitants. -/
private def boolProjectionImpl (k : SortK) : SortBool :=
  (boolProjectionOptImpl k).getD false

private def floatProjectionImpl (k : SortK) : SortFloat :=
  (floatProjectionOptImpl k).getD 0.0

private def intProjectionImpl (k : SortK) : SortInt :=
  (intProjectionOptImpl k).getD 0

private def emptyStrImpl : SortStr :=
  SortStr.«str(_)_MPY-CORE_Str_IntSeq»
    SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»

private def strProjectionImpl (k : SortK) : SortStr :=
  (strProjectionOptImpl k).getD emptyStrImpl

private def boolTotalProjectionImpl : SortVal → SortBool
  | SortVal.inj_SortBool b => b
  | _ => false

private def floatTotalProjectionImpl : SortVal → SortFloat
  | SortVal.inj_SortFloat f => f
  | _ => 0.0

private def intTotalProjectionImpl : SortVal → SortInt
  | SortVal.inj_SortInt i => i
  | _ => 0

private def strTotalProjectionImpl : SortVal → SortStr
  | SortVal.inj_SortStr s => s
  | _ => emptyStrImpl

private def codesFromStrImpl : SortStr → SortIntSeq
  | SortStr.«str(_)_MPY-CORE_Str_IntSeq» cs => cs

private def intSeqEqualImpl : SortIntSeq → SortIntSeq → SortBool
  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => true
  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» a as,
      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» b bs =>
      decide (a = b) && intSeqEqualImpl as bs
  | _, _ => false

private def strLessImpl : SortIntSeq → SortIntSeq → SortBool
  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
