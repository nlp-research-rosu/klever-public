   261	private def floatLessImpl (a b : SortFloat) : SortBool := decide (a < b)
   262	private def floatGreaterImpl (a b : SortFloat) : SortBool := decide (b < a)
   263	private def floatEqualImpl (a b : SortFloat) : SortBool := a == b
