   216	      if exponentBits = 0 then fraction else (2 ^ 52) + fraction
   217	    let signedMantissa : Int :=
   218	      if floatSignBitImpl f then -(Int.ofNat magnitude) else Int.ofNat magnitude
   219	    let exponent : Int :=
   220	      if exponentBits = 0 then -1074 else Int.ofNat exponentBits - 1075
   221	    some ⟨signedMantissa, exponent⟩
