   265	/- FLOAT.max / fp.max: NaNs propagate, greater operands win, and +0 is selected
   266	   for the equal-zero case. -/
   267	private def floatMaxImpl (a b : SortFloat) : SortFloat :=
   268	  if a.isNaN then a
   269	  else if b.isNaN then b
   270	  else if a < b then b
   271	  else if b < a then a
   272	  else if a.toBits = 0x8000000000000000 && b.toBits = 0 then b
   273	  else if b.toBits = 0x8000000000000000 && a.toBits = 0 then a
   274	  else a
