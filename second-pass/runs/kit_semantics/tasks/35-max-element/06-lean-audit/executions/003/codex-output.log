    79	def intSeqEqualImpl : SortIntSeq → SortIntSeq → SortBool
    80	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => true
    81	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» a as,
    82	      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» b bs =>
    83	      decide (a = b) && intSeqEqualImpl as bs
