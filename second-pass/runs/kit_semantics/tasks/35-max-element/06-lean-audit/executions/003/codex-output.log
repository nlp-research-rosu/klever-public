   123	/- `==K` is syntactic equality of generated K terms. -/
   124	noncomputable def valTermEqualImpl (a b : SortVal) : SortBool := by
   125	  classical
   126	  exact decide (a = b)
   127	
   128	noncomputable def valSeqTermEqualImpl (a b : SortValSeq) : SortBool := by
   129	  classical
   130	  exact decide (a = b)
