+import Proof
+
+namespace AdversarialAudit
+
+def emptySeq : SortIntSeq := SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+def seq1 (a : Int) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» a emptySeq
+def seq2 (a b : Int) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» a (seq1 b)
+def str1 (a : Int) : SortStr := SortStr.«str(_)_MPY-CORE_Str_IntSeq» (seq1 a)
+def kInt (i : Int) : SortK :=
+  SortK.kseq (SortKItem.inj_SortInt i) SortK.dotk
+def kBool (b : Bool) : SortK :=
+  SortK.kseq (SortKItem.inj_SortBool b) SortK.dotk
+def kFloat (f : Float) : SortK :=
+  SortK.kseq (SortKItem.inj_SortFloat f) SortK.dotk
+def kStr (s : SortStr) : SortK :=
+  SortK.kseq (SortKItem.inj_SortStr s) SortK.dotk
+
+def fOne : Float := Float.ofBits 0x3ff0000000000000
+def fTwo : Float := Float.ofBits 0x4000000000000000
+def fTwo53 : Float := Float.ofBits 0x4340000000000000
+def fNaN : Float := Float.ofBits 0x7ff8000000000001
+def fNegZero : Float := Float.ofBits 0x8000000000000000
+def fPosZero : Float := Float.ofBits 0
+
+-- Ordinary boolean and integer hooks, including asymmetric inputs.
+example : Proof._andBool_ true false = false := rfl
+example : Proof._andBool_ true true = true := rfl
+example : Proof._orBool_ false true = true := rfl
+example : Proof._orBool_ false false = false := rfl
+example : Proof.«_>Int_» 7 (-3) = true := by native_decide
+example : Proof.«_>Int_» (-3) 7 = false := by native_decide
+example : Proof.«_>Int_» 7 7 = false := by native_decide
+
+-- Exact K-sequence sort projections and disjointness.
+example : Proof.«project:Int?» (kInt 5) = some 5 := rfl
+example : Proof.«project:Int?» (kBool true) = none := rfl
+example : Proof.«project:Bool?» (kBool true) = some true := rfl
+example : Proof.«project:Bool?» (kInt 1) = none := rfl
+example : Proof.«project:Float?» (kFloat fTwo) = some fTwo := rfl
+example : Proof.«project:Str?» (kStr (str1 97)) = some (str1 97) := rfl
+example : Proof.isInt (kInt 5) = true := rfl
+example : Proof.isInt (kBool true) = false := rfl
+example : Proof.isBool (kBool true) = true := rfl
+example : Proof.isFloat (kFloat fOne) = true := rfl
+example : Proof.isStr (kStr (str1 97)) = true := rfl
+example : Proof.«project:Int» (kInt 5) = 5 := rfl
+example : Proof.projectIntTotal (SortVal.inj_SortInt 5) = 5 := rfl
+example : Proof.projectBoolTotal (SortVal.inj_SortBool true) = true := rfl
+example : Proof.projectFloatTotal (SortVal.inj_SortFloat fTwo) = fTwo := rfl
+example : Proof.projectStrTotal (SortVal.inj_SortStr (str1 97)) = str1 97 := rfl
+
+-- Frozen verification summaries and mixed numeric ordering.
+example : Proof.«codesOf(_)_VERIFICATION_IntSeq_Str» (str1 97) = seq1 97 := rfl
+example : Proof.«isNumericV(_)_VERIFICATION_Bool_Val» (SortVal.inj_SortInt 2) = true := rfl
+example : Proof.«isNumericV(_)_VERIFICATION_Bool_Val» (SortVal.inj_SortBool false) = true := rfl
+example : Proof.«isNumericV(_)_VERIFICATION_Bool_Val» (SortVal.inj_SortFloat fOne) = true := rfl
+example : Proof.«isNumericV(_)_VERIFICATION_Bool_Val» (SortVal.inj_SortStr (str1 97)) = false := rfl
+example : Proof.«numericView(_)_VERIFICATION_NumericView_Val» (SortVal.inj_SortInt 2) =
+    SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» 2 := rfl
+example : Proof.«numericView(_)_VERIFICATION_NumericView_Val» (SortVal.inj_SortBool true) =
+    SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» true := rfl
+example : Proof.«numericGt(_,_)_VERIFICATION_Bool_NumericView_NumericView»
+    (SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» true)
+    (SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» 0) = true := by native_decide
+example : Proof.«numericGt(_,_)_VERIFICATION_Bool_NumericView_NumericView»
+    (SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» 9007199254740993)
+    (SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» fTwo53) = true := by native_decide
+example : Proof.«numericGt(_,_)_VERIFICATION_Bool_NumericView_NumericView»
+    (SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» fTwo53)
+    (SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» 9007199254740993) = false := by native_decide
+
+-- Lexicographic code-point ordering and dynamic comparison dispatch.
+example : Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (seq1 97) (seq1 98) = true := by native_decide
+example : Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (seq1 98) (seq1 97) = false := by native_decide
+example : Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (seq1 97) (seq2 97 98) = true := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">"
+    (SortVal.inj_SortInt 5) (SortVal.inj_SortBool true) = true := by rfl
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">"
+    (SortVal.inj_SortStr (str1 98)) (SortVal.inj_SortStr (str1 97)) = true := by rfl
+
+-- FLOAT.max edge cases checked against an independently compiled K oracle.
+example : (Proof.maxFOpaque fOne fTwo).toBits = fTwo.toBits := by native_decide
+example : (Proof.maxFOpaque fTwo fOne).toBits = fTwo.toBits := by native_decide
+example : (Proof.maxFOpaque fNaN fOne).toBits = fOne.toBits := by native_decide
+example : (Proof.maxFOpaque fOne fNaN).toBits = fOne.toBits := by native_decide
+example : (Proof.maxFOpaque fNegZero fPosZero).toBits = fPosZero.toBits := by native_decide
+example : (Proof.maxFOpaque fPosZero fNegZero).toBits = fPosZero.toBits := by native_decide
+example : (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» fOne fTwo).toBits = fTwo.toBits := by native_decide
+
+-- Counterfactual mutations all have concrete separating witnesses.
+def badGreater (_ _ : SortInt) : SortBool := false
+def badIsInt (_ : SortK) : SortBool := true
+def badIntProjection (_ : SortK) : SortInt := 0
+def badNumericView (_ : SortVal) : SortNumericView :=
+  SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» 0
+def badStrLess (_ _ : SortIntSeq) : SortBool := false
+def badFloatMax (a _ : SortFloat) : SortFloat := a
+
+example : badGreater 7 (-3) ≠ Proof.«_>Int_» 7 (-3) := by native_decide
+example : badIsInt (kBool true) ≠ Proof.isInt (kBool true) := by native_decide
+example : badIntProjection (kInt 5) ≠ Proof.«project:Int» (kInt 5) := by native_decide
+example : badNumericView (SortVal.inj_SortBool true) ≠
+    Proof.«numericView(_)_VERIFICATION_NumericView_Val» (SortVal.inj_SortBool true) := by
+  simp [badNumericView, Proof.«numericView(_)_VERIFICATION_NumericView_Val», Operational.numericViewImpl]
+example : badStrLess (seq1 97) (seq1 98) ≠
+    Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (seq1 97) (seq1 98) := by native_decide
+example : (badFloatMax fOne fTwo).toBits ≠ (Proof.maxFOpaque fOne fTwo).toBits := by native_decide
+
+end AdversarialAudit
