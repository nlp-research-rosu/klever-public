     8	def valItemImpl : SortVal → SortKItem
     9	  | SortVal.inj_SortBool b => SortKItem.inj_SortBool b
    10	  | SortVal.inj_SortFloat f => SortKItem.inj_SortFloat f
    11	  | SortVal.inj_SortInt i => SortKItem.inj_SortInt i
    12	  | SortVal.inj_SortIterable it => SortKItem.inj_SortIterable it
