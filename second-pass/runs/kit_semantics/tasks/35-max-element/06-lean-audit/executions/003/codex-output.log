   104	def strContainsImpl (pattern : SortIntSeq) : SortIntSeq → SortBool
   105	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» =>
   106	      strPrefixImpl pattern SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
   107	  | haystack@(SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ rest) =>
