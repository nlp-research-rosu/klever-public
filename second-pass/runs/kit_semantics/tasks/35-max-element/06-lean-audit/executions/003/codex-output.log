   115	def subsetCodesImpl : SortIntSeq → SortIntSeq → SortBool
   116	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», _ => true
   117	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail, other =>
