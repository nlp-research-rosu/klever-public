   110	def codeInImpl (code : SortInt) : SortIntSeq → SortBool
   111	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
   112	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail =>
   113	      decide (code = head) || codeInImpl code tail
