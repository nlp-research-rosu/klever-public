+    status = "PASS" if observed == expected else "FAIL"
+    print(f"{status} {label}")
+    print(f"  observed={observed!r}")
+    print(f"  expected={expected!r}")
+    if status == "FAIL":
+        raise SystemExit(f"mismatch: {label}")
+
+
