    96	def strPrefixImpl : SortIntSeq → SortIntSeq → SortBool
    97	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», _ => true
    98	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _,
    99	      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
   100	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» a as,
   101	      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» b bs =>
   102	      decide (a = b) && strPrefixImpl as bs
