+#!/usr/bin/env python3
+"""Independent mechanical reconstruction for the 35-max-element audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from tools import (
+    k_rule_inventory,
