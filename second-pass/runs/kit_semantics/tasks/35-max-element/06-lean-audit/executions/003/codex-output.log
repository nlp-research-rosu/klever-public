   326	/- Complete rule table over the Base-representable Val universe.  The final arm
   327	   totalizes only combinations for which frozen MPY has no applyCmp rule. -/
   328	noncomputable def cmpDispatchImpl
   329	    (operator : SortString) (left right : SortVal) : SortBool :=
   330	  match left, right with
   331	  | _, SortVal.«noneV_MPY-CORE_Val» =>
   332	      match operator with
