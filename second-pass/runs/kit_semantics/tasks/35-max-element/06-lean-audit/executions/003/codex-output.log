    86	def strLessImpl : SortIntSeq → SortIntSeq → SortBool
    87	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
    88	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
    89	      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _ => true
    90	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _,
    91	      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
    92	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» a as,
    93	      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» b bs =>
    94	      if a < b then true else if a > b then false else strLessImpl as bs
