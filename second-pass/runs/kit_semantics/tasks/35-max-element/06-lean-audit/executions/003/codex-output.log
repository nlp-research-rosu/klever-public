   132	def valSeqLengthImpl : SortValSeq → Nat
   133	  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => 0
   134	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ tail => valSeqLengthImpl tail + 1
