   136	noncomputable def dictFindImpl
   137	    (keys values : SortValSeq) (key : SortVal) : Option SortVal :=
   138	  match keys, values with
   139	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» candidate keyTail,
   140	      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value valueTail =>
   141	      if valTermEqualImpl candidate key then some value
   142	      else dictFindImpl keyTail valueTail key
   143	  | _, _ => none
   144	
   145	noncomputable def dictHasKeyImpl (keys : SortValSeq) (key : SortVal) : SortBool :=
   146	  match keys with
   147	  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => false
   148	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» candidate tail =>
   149	      if valTermEqualImpl candidate key then true else dictHasKeyImpl tail key
   150	
   151	noncomputable def dictSubsetImpl
   152	    (keys values otherKeys otherValues : SortValSeq) : SortBool :=
   153	  match keys, values with
   154	  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq», SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => true
   155	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» key keyTail,
   156	      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value valueTail =>
   157	      dictHasKeyImpl otherKeys key &&
   158	        (match dictFindImpl otherKeys otherValues key with
   159	         | some found => valTermEqualImpl found value
   160	         | none => false) &&
   161	        dictSubsetImpl keyTail valueTail otherKeys otherValues
   162	  | _, _ => false
   163	
   164	noncomputable def dictEqualImpl
   165	    (keys₁ values₁ keys₂ values₂ : SortValSeq) : SortBool :=
   166	  decide (valSeqLengthImpl keys₁ = valSeqLengthImpl keys₂) &&
   167	    dictSubsetImpl keys₁ values₁ keys₂ values₂
   168	
   169	def boolAsIntImpl (b : SortBool) : SortInt := if b then 1 else 0
   170	
   171	/- Exact binary64 decoding for the frozen ltIF/ltFI/eqIF hooks. -/
   172	structure FloatDyadicImpl where
   173	  mantissa : Int
   174	  exponent : Int
   175	
   176	def floatSignBitImpl (f : SortFloat) : SortBool :=
   177	  ((f.toBits.toNat / (2 ^ 63)) % 2) = 1
   178	
   179	def floatDyadicImpl (f : SortFloat) : Option FloatDyadicImpl :=
   180	  let bits := f.toBits.toNat
   181	  let exponentBits := (bits / (2 ^ 52)) % (2 ^ 11)
   182	  let fraction := bits % (2 ^ 52)
   183	  if exponentBits = (2 ^ 11) - 1 then none
   184	  else
   185	    let magnitude := if exponentBits = 0 then fraction else (2 ^ 52) + fraction
   186	    let signedMantissa : Int :=
   187	      if floatSignBitImpl f then -(Int.ofNat magnitude) else Int.ofNat magnitude
   188	    let exponent : Int :=
   189	      if exponentBits = 0 then -1074 else Int.ofNat exponentBits - 1075
   190	    some ⟨signedMantissa, exponent⟩
   191	
   192	def dyadicLessThanIntImpl (d : FloatDyadicImpl) (i : SortInt) : SortBool :=
   193	  if d.exponent ≥ 0 then
   194	    decide (d.mantissa * Int.ofNat (2 ^ d.exponent.toNat) < i)
   195	  else
   196	    decide (d.mantissa < i * Int.ofNat (2 ^ (-d.exponent).toNat))
   197	
   198	def intLessThanDyadicImpl (i : SortInt) (d : FloatDyadicImpl) : SortBool :=
   199	  if d.exponent ≥ 0 then
   200	    decide (i < d.mantissa * Int.ofNat (2 ^ d.exponent.toNat))
   201	  else
   202	    decide (i * Int.ofNat (2 ^ (-d.exponent).toNat) < d.mantissa)
   203	
   204	def intEqualDyadicImpl (i : SortInt) (d : FloatDyadicImpl) : SortBool :=
   205	  if d.exponent ≥ 0 then
   206	    decide (i = d.mantissa * Int.ofNat (2 ^ d.exponent.toNat))
   207	  else
   208	    decide (i * Int.ofNat (2 ^ (-d.exponent).toNat) = d.mantissa)
   209	
   210	def floatLessThanIntImpl (f : SortFloat) (i : SortInt) : SortBool :=
   211	  match floatDyadicImpl f with
   212	  | some d => dyadicLessThanIntImpl d i
   213	  | none => if f.isNaN then false else floatSignBitImpl f
   214	
   215	def intLessThanFloatImpl (i : SortInt) (f : SortFloat) : SortBool :=
   216	  match floatDyadicImpl f with
   217	  | some d => intLessThanDyadicImpl i d
   218	  | none => if f.isNaN then false else !floatSignBitImpl f
   219	
   220	def intEqualFloatImpl (i : SortInt) (f : SortFloat) : SortBool :=
   221	  match floatDyadicImpl f with
   222	  | some d => intEqualDyadicImpl i d
   223	  | none => false
   224	
   225	def floatLessImpl (a b : SortFloat) : SortBool := decide (a < b)
   226	def floatGreaterImpl (a b : SortFloat) : SortBool := decide (b < a)
   227	def floatEqualImpl (a b : SortFloat) : SortBool := a == b
   228	
   229	/- K 7.1.293 FLOAT.max is max-number, not NaN-propagating: if exactly
   230	   one operand is NaN it returns the non-NaN operand.  Equal signed zeros select
   231	   +0, and otherwise the numerically greater operand wins. -/
   232	def floatMaxImpl (a b : SortFloat) : SortFloat :=
   233	  if a.isNaN then b
   234	  else if b.isNaN then a
   235	  else if a < b then b
   236	  else if b < a then a
   237	  else if a.toBits = 0x8000000000000000 && b.toBits = 0 then b
   238	  else if b.toBits = 0x8000000000000000 && a.toBits = 0 then a
   239	  else a
   240	
   241	def numericImpl : SortVal → SortBool
   242	  | SortVal.inj_SortInt _ => true
   243	  | SortVal.inj_SortBool _ => true
   244	  | SortVal.inj_SortFloat _ => true
   245	  | _ => false
   246	
   247	def numericViewImpl : SortVal → SortNumericView
   248	  | SortVal.inj_SortInt i => SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» i
   249	  | SortVal.inj_SortBool b => SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» b
   250	  | SortVal.inj_SortFloat f => SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» f
   251	  | v => SortNumericView.«nOther(_)_VERIFICATION_NumericView_Val» v
   252	
   253	def numericGreaterImpl : SortNumericView → SortNumericView → SortBool
   254	  | SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» i,
   255	      SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» j => intGreaterImpl i j
   256	  | SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» i,
   257	      SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» b => intGreaterImpl i (boolAsIntImpl b)
   258	  | SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» b,
   259	      SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» i => intGreaterImpl (boolAsIntImpl b) i
   260	  | SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» a,
   261	      SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» b => intGreaterImpl (boolAsIntImpl a) (boolAsIntImpl b)
   262	  | SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» a,
   263	      SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» b => floatGreaterImpl a b
   264	  | SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» i,
   265	      SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» f => floatLessThanIntImpl f i
   266	  | SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» f,
   267	      SortNumericView.«nInt(_)_VERIFICATION_NumericView_Int» i => intLessThanFloatImpl i f
   268	  | SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» b,
   269	      SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» f => floatLessThanIntImpl f (boolAsIntImpl b)
   270	  | SortNumericView.«nFloat(_)_VERIFICATION_NumericView_Float» f,
   271	      SortNumericView.«nBool(_)_VERIFICATION_NumericView_Bool» b => intLessThanFloatImpl (boolAsIntImpl b) f
   272	  | _, _ => false
   273	
   274	def intCompareImpl (operator : SortString) (a b : SortInt) : SortBool :=
   275	  match operator with
   276	  | "<" => decide (a < b)
   277	  | "<=" => decide (a ≤ b)
   278	  | ">" => decide (a > b)
   279	  | ">=" => decide (a ≥ b)
   280	  | "==" => decide (a = b)
   281	  | "!=" => decide (a ≠ b)
   282	  | _ => false
   283	
   284	def floatCompareImpl (operator : SortString) (a b : SortFloat) : SortBool :=
   285	  match operator with
   286	  | "<" => floatLessImpl a b
   287	  | "<=" => !floatGreaterImpl a b
   288	  | ">" => floatGreaterImpl a b
   289	  | ">=" => !floatLessImpl a b
   290	  | "==" => floatEqualImpl a b
   291	  | "!=" => !floatEqualImpl a b
   292	  | _ => false
   293	
   294	def intFloatCompareImpl (operator : SortString) (i : SortInt) (f : SortFloat) : SortBool :=
   295	  match operator with
   296	  | "<" => intLessThanFloatImpl i f
   297	  | "<=" => !floatLessThanIntImpl f i
   298	  | ">" => floatLessThanIntImpl f i
   299	  | ">=" => !intLessThanFloatImpl i f
   300	  | "==" => intEqualFloatImpl i f
   301	  | "!=" => !intEqualFloatImpl i f
   302	  | _ => false
   303	
   304	def floatIntCompareImpl (operator : SortString) (f : SortFloat) (i : SortInt) : SortBool :=
   305	  match operator with
   306	  | "<" => floatLessThanIntImpl f i
   307	  | "<=" => !intLessThanFloatImpl i f
   308	  | ">" => intLessThanFloatImpl i f
   309	  | ">=" => !floatLessThanIntImpl f i
   310	  | "==" => intEqualFloatImpl i f
   311	  | "!=" => !intEqualFloatImpl i f
   312	  | _ => false
   313	
   314	def strCompareImpl (operator : SortString) (a b : SortIntSeq) : SortBool :=
   315	  match operator with
   316	  | "==" => intSeqEqualImpl a b
   317	  | "!=" => !intSeqEqualImpl a b
   318	  | "in" => strContainsImpl a b
   319	  | "not in" => !strContainsImpl a b
   320	  | "<" => strLessImpl a b
   321	  | ">" => strLessImpl b a
   322	  | "<=" => !strLessImpl b a
   323	  | ">=" => !strLessImpl a b
   324	  | _ => false
