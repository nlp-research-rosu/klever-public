+    (Proof.«numericView(_)_VERIFICATION_NumericView_Val» (intV 9007199254740993))
+    (Proof.«numericView(_)_VERIFICATION_NumericView_Val» (floatV 9007199254740992.0)))
+#eval ("numeric-nan-gt-int",
+  Proof.«numericGt(_,_)_VERIFICATION_Bool_NumericView_NumericView»
+    (Proof.«numericView(_)_VERIFICATION_NumericView_Val» (floatV nan))
+    (Proof.«numericView(_)_VERIFICATION_NumericView_Val» (intV 0)))
+
+#eval ("max-nan-left", (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» nan 1.0).toBits)
+#eval ("max-nan-right", (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» 1.0 nan).toBits)
+#eval ("max-negzero-poszero", (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» negZero 0.0).toBits)
+#eval ("max-poszero-negzero", (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» 0.0 negZero).toBits)
+#eval ("max-ordinary", Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» (-1.0) 2.0)
+
+end BridgeAudit
