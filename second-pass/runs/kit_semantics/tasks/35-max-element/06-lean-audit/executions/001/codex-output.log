+#print axioms Proof.final
diff --git a//tmp/audit-work/stage5-fresh/BridgeAudit.lean b//tmp/audit-work/stage5-fresh/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..3407b32894804b63b0be5f72909289eb54b3584b
--- /dev/null
+++ b//tmp/audit-work/stage5-fresh/BridgeAudit.lean
@@ -0,0 +1,57 @@
+import Proof
+
+namespace BridgeAudit
+
+def intV (i : SortInt) : SortVal := SortVal.inj_SortInt i
+def boolV (b : SortBool) : SortVal := SortVal.inj_SortBool b
+def floatV (f : SortFloat) : SortVal := SortVal.inj_SortFloat f
+def intSeq (xs : List SortInt) : SortIntSeq :=
+  xs.foldr
+    SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+    SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+def strV (xs : List SortInt) : SortVal :=
+  SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» (intSeq xs))
+
+def nan : SortFloat := Float.ofBits 0x7ff8000000000000
+def negZero : SortFloat := Float.ofBits 0x8000000000000000
+
+#eval ("and-tt", Proof._andBool_ true true)
+#eval ("and-tf", Proof._andBool_ true false)
+#eval ("or-ff", Proof._orBool_ false false)
+#eval ("or-ft", Proof._orBool_ false true)
+#eval ("gt-int", Proof.«_>Int_» 3 2)
+#eval ("not-gt-int", Proof.«_>Int_» (-3) 2)
+
+#eval ("cmp-gt-int", Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">" (intV 3) (intV 2))
+#eval ("cmp-gt-bool", Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">" (boolV true) (boolV false))
+#eval ("cmp-gt-mixed", Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">" (intV 2) (floatV 1.5))
+#eval ("cmp-lt-int-adversarial", Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intV 1) (intV 2))
+#eval ("cmp-eq-int-adversarial", Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "==" (intV 2) (intV 2))
+#eval ("cmp-lt-float-adversarial", Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (floatV 1.0) (floatV 2.0))
+
+#eval ("is-int", Proof.isInt (SortK.kseq (SortKItem.inj_SortInt 4) SortK.dotk))
+#eval ("is-int-wrong-sort", Proof.isInt (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk))
+#eval ("is-int-extra-k", Proof.isInt (SortK.kseq (SortKItem.inj_SortInt 4) (SortK.kseq (SortKItem.inj_SortInt 5) SortK.dotk)))
+#eval ("project-int-some", Proof.«project:Int?» (SortK.kseq (SortKItem.inj_SortInt 4) SortK.dotk))
+#eval ("project-int-none", Proof.«project:Int?» (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk))
+
+#eval ("str-lt-prefix", Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (intSeq [97]) (intSeq [97, 98]))
+#eval ("str-lt-first-code", Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (intSeq [98]) (intSeq [97, 122]))
+#eval ("cmp-gt-str", Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">" (strV [98]) (strV [97]))
+
+#eval ("numeric-large-int-over-float",
+  Proof.«numericGt(_,_)_VERIFICATION_Bool_NumericView_NumericView»
+    (Proof.«numericView(_)_VERIFICATION_NumericView_Val» (intV 9007199254740993))
+    (Proof.«numericView(_)_VERIFICATION_NumericView_Val» (floatV 9007199254740992.0)))
+#eval ("numeric-nan-gt-int",
+  Proof.«numericGt(_,_)_VERIFICATION_Bool_NumericView_NumericView»
+    (Proof.«numericView(_)_VERIFICATION_NumericView_Val» (floatV nan))
+    (Proof.«numericView(_)_VERIFICATION_NumericView_Val» (intV 0)))
+
+#eval ("max-nan-left", (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» nan 1.0).toBits)
+#eval ("max-nan-right", (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» 1.0 nan).toBits)
+#eval ("max-negzero-poszero", (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» negZero 0.0).toBits)
+#eval ("max-poszero-negzero", (Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» 0.0 negZero).toBits)
+#eval ("max-ordinary", Proof.«maxFloat(_,_)_FLOAT_Float_Float_Float» (-1.0) 2.0)
+
+end BridgeAudit

