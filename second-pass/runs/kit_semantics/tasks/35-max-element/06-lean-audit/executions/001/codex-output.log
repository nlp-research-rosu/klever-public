codex
The failure is caused by the execution sandbox’s PID view: Lean 4 resolves its executable through `/proc/<getpid>/exe`, but the sandbox exposes `/proc/self/exe` while hiding that numeric PID path. I’m applying a narrowly scoped runtime shim below `/tmp/audit-work` that redirects only numeric `/proc/*/exe` `readlink` calls to `/proc/self/exe`; this changes neither candidate nor provenance content and allows the pinned Lean binary to run. I’ll record the shim source, hash, compile command, and every build output.
apply patch
patch: completed
/tmp/audit-work/proc-self-readlink.c
diff --git a//tmp/audit-work/proc-self-readlink.c b//tmp/audit-work/proc-self-readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..b68b8270dd52b0e79df9f944021ef38439765b14
--- /dev/null
+++ b//tmp/audit-work/proc-self-readlink.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_hidden_proc_pid_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t length;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    if (strcmp(path, "/proc/self/exe") == 0) {
+        return 0;
+    }
+    length = strlen(path);
+    return length > sizeof(prefix) + sizeof(suffix) - 2
+        && strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0;
+}
+
+ssize_t readlink(const char *restrict path, char *restrict buffer, size_t size) {
+    const char *resolved = is_hidden_proc_pid_exe(path)
+        ? "/proc/self/exe"
+        : path;
+    return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}

