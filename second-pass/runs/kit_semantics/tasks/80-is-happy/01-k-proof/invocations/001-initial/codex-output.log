from itertools import product
from solution import is_happy

def oracle(s):
    return len(s) >= 3 and all(len(set(s[i:i+3])) == 3 for i in range(len(s) - 2))

count = 0
for n in range(8):
    for chars in product('abc', repeat=n):
        s = ''.join(chars)
        assert is_happy(s) == oracle(s), s
        count += 1
print('python differential cases:', count, 'mismatches: 0')
PY
