diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..967c91c977f9a66ec50272373304dfbe13481728
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly when the three characters starting at I are pairwise
+  // distinct.  The guard is the domain on which the three indices exist.
+  syntax Bool ::= windowGood(IntSeq, Int) [function]
+  rule windowGood(IS:IntSeq, I:Int)
+    => (intSeqAt(IS, I) =/=Int intSeqAt(IS, I +Int 1))
+       andBool (intSeqAt(IS, I) =/=Int intSeqAt(IS, I +Int 2))
+       andBool (intSeqAt(IS, I +Int 1) =/=Int intSeqAt(IS, I +Int 2))
+    requires 0 <=Int I andBool I <Int isLen(IS) -Int 2
+
+  // Conjunction of windowGood from I through the final length-three window.
+  // The negative case makes the declaration genuinely total over Int.
+  syntax Bool ::= happyFrom(IntSeq, Int) [function, total]
+  rule happyFrom(_:IntSeq, I:Int) => false
+    requires I <Int 0
+  rule happyFrom(IS:IntSeq, I:Int) => true
+    requires I >=Int 0 andBool I >=Int isLen(IS) -Int 2
+  rule happyFrom(IS:IntSeq, I:Int)
+    => windowGood(IS, I) andBool happyFrom(IS, I +Int 1)
+    requires I >=Int 0 andBool I <Int isLen(IS) -Int 2
+endmodule

