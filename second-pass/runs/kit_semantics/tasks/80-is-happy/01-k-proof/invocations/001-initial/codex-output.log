+assert is_happy("aa") == False
+assert is_happy("abcd") == True
+assert is_happy("aabb") == False
+assert is_happy("adb") == True
+assert is_happy("xyy") == False
+assert is_happy("abca") == True
+assert is_happy("abac") == False
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8beaf20e7e7259142bb572b3502bee0e4cf9bffb
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def is_happy(s):
+    happy = True
+    previous2 = -1
+    previous1 = -1
+    i = 0
+    ch = ""
+    code = 0
+    for ch in s:
+        code = ord(ch)
+        if i >= 2 and (code == previous1 or code == previous2 or previous1 == previous2):
+            happy = False
+        previous2 = previous1
+        previous1 = code
+        i = i + 1
+
+    return i >= 3 and happy
