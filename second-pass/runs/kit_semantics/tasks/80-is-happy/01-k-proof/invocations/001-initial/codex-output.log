+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(
+          Name("i"),
+          CmpOp("<", BinOp("-", Call(Name("len"), Name("s")), Int(2)))),
+        If(
+          BoolOp(
+            "or",
+            Compare(
+              Subscript(Name("s"), Name("i")),
+              CmpOp(
+                "==",
+                Subscript(Name("s"), BinOp("+", Name("i"), Int(1))))),
+            Compare(
+              Subscript(Name("s"), Name("i")),
+              CmpOp(
+                "==",
+                Subscript(Name("s"), BinOp("+", Name("i"), Int(2))))),
+            Compare(
+              Subscript(Name("s"), BinOp("+", Name("i"), Int(1))),
+              CmpOp(
+                "==",
+                Subscript(Name("s"), BinOp("+", Name("i"), Int(2)))))),
+          Assign(Name("happy"), Bool(false)),
+          .Stmts)
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope("is_happy" |-> _:Val, parent(-1))
+       1 |-> scope(
+              "s"     |-> str(IS:IntSeq)
+              "happy" |-> (H:Bool => H andBool happyFrom(IS, I))
+              "i"     |-> (I:Int => isLen(IS) -Int 2),
+              parent(0))
+    </scopes>
+    requires 0 <=Int I andBool I <=Int isLen(IS) -Int 2
+
+  claim [is-happy]:
+    <k>
+      Call(Name("is_happy"), str(IS:IntSeq))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "is_happy" |->
+                closureVal(
+                  ("s", .ParamNames),
+                  If(
+                    Compare(
+                      Call(Name("len"), Name("s")),
+                      CmpOp("<", Int(3))),
+                    Return(Bool(false)),
+                    .Stmts)
+                  Assign(Name("happy"), Bool(true))
+                  Assign(Name("i"), Int(0))
+                  While(
+                    Compare(
+                      Name("i"),
+                      CmpOp(
+                        "<",
+                        BinOp(
+                          "-",
+                          Call(Name("len"), Name("s")),
+                          Int(2)))),
+                    If(
+                      BoolOp(
+                        "or",
+                        Compare(
+                          Subscript(Name("s"), Name("i")),
+                          CmpOp(
+                            "==",
+                            Subscript(
+                              Name("s"),
+                              BinOp("+", Name("i"), Int(1))))),
+                        Compare(
+                          Subscript(Name("s"), Name("i")),
+                          CmpOp(
+                            "==",
+                            Subscript(
+                              Name("s"),
+                              BinOp("+", Name("i"), Int(2))))),
+                        Compare(
+                          Subscript(
+                            Name("s"),
+                            BinOp("+", Name("i"), Int(1))),
+                          CmpOp(
+                            "==",
+                            Subscript(
+                              Name("s"),
+                              BinOp("+", Name("i"), Int(2)))))),
+                      Assign(Name("happy"), Bool(false)),
+                      .Stmts)
+                    Assign(
+                      Name("i"),
+                      BinOp("+", Name("i"), Int(1))))
+                  Return(Name("happy")),
+                  0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    ensures ?R ==Bool
+      ((isLen(IS) >=Int 3) andBool happyFrom(IS, 0))
+endmodule
