+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "is_happy" |->
+                closureVal(
+                  ("s", .ParamNames),
+                  If(
+                    Compare(
+                      Call(Name("len"), Name("s")),
+                      CmpOp("<", Int(3))),
+                    Return(Bool(false)),
+                    .Stmts)
+                  Assign(Name("happy"), Bool(true))
+                  Assign(Name("i"), Int(0))
+                  While(
+                    Compare(
+                      Name("i"),
+                      CmpOp(
+                        "<",
+                        BinOp(
+                          "-",
+                          Call(Name("len"), Name("s")),
+                          Int(2)))),
