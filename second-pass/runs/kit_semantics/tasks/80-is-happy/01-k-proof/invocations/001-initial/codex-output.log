+    <k>
+      Call(Name("is_happy"), str(IS:IntSeq))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "is_happy" |->
