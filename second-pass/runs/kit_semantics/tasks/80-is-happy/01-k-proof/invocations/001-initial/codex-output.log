/bin/bash -lc "python3 -m py_compile solution.py
python3 - <<'PY'
from solution import is_happy
cases = [('a', False), ('aa', False), ('abcd', True), ('aabb', False), ('adb', True), ('xyy', False), ('abca', True), ('abac', False), ('åßç', True), ('ååç', False)]
for s, expected in cases:
    actual = is_happy(s)
    print(repr(s), actual, expected)
    assert actual is expected
PY
kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-invariant" in /workspace
