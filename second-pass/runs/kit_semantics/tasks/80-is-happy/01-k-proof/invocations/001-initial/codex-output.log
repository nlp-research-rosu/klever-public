+
+    happy = True
+    i = 0
+    while i < len(s) - 2:
+        if s[i] == s[i + 1] or s[i] == s[i + 2] or s[i + 1] == s[i + 2]:
+            happy = False
+        i = i + 1
+
+    return happy

