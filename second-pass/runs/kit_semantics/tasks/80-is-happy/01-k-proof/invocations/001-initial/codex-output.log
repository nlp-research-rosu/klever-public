diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1eb6bdf237b2859e0aaff2c18748420d87ea8218
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def is_happy(s):
+    if len(s) < 3:
+        return False
+
+    happy = True
+    i = 0
+    while i < len(s) - 2:
+        if s[i] == s[i + 1] or s[i] == s[i + 2] or s[i + 1] == s[i + 2]:
+            happy = False
+        i = i + 1
+
+    return happy
