exec
/bin/bash -lc 'set +e
kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY
probe_status=$?
printf '"'spec-vacuity exit: %s (expected nonzero)\\n' \""'$probe_status"
if [ "$probe_status" -eq 0 ]; then exit 1; fi
exit 0' in /workspace
