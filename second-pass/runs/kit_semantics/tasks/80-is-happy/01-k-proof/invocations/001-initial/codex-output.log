+def is_happy(s):
+    if len(s) < 3:
+        return False
+
+    happy = True
+    i = 0
+    while i < len(s) - 2:
+        if ord(s[i]) == ord(s[i + 1]) or ord(s[i]) == ord(s[i + 2]) or ord(s[i + 1]) == ord(s[i + 2]):
+            happy = False
+        i = i + 1
+
+    return happy
