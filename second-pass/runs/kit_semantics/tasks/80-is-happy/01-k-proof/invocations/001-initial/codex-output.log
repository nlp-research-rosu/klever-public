--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def is_happy(s):
+    if len(s) < 3:
+        return False
+
+    happy = True
+    previous2 = -1
+    previous1 = -1
+    i = 0
+    ch = ""
+    code = 0
+    for ch in s:
+        code = ord(ch)
+        if i >= 2 and (code == previous1 or code == previous2 or previous1 == previous2):
+            happy = False
+        previous2 = previous1
+        previous1 = code
+        i = i + 1
+
+    return happy
