from pathlib import Path

canonical = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == canonical['inventory_sha256']
assert len(out['rules']) == len(canonical['rules'])

allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
canonical_ids = [r['source_rule_id'] for r in canonical['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == canonical_ids
assert len(out_ids) == len(set(out_ids))

for canonical_rule, classified in zip(canonical['rules'], out['rules']):
    assert list(classified.keys()) == ['source_rule_id', 'classification', 'rationale']
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if 'simplification' in canonical_rule.get('attributes', []):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

print('schema: valid')
print('inventory hash:', out['inventory_sha256'])
print('canonical rules:', len(canonical_ids))
print('classified exactly once in order:', len(out_ids))
print('classifications:', {c: sum(r['classification'] == c for r in out['rules']) for c in sorted(allowed)})
PY
