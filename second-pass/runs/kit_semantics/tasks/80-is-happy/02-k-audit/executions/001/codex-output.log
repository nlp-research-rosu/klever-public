                 closureVal(
                   ("s", .ParamNames),
-                  Assign(Name("happy"), Bool(true))
+                  Assign(Name("happy"), Bool(false))
                   Assign(Name("previous2"), UnaryOp("-", Int(1)))
                   Assign(Name("previous1"), UnaryOp("-", Int(1)))
                   Assign(Name("i"), Int(0))
diff --git a//tmp/audit-work/80-is-happy/audit-spec-vacuity.k b//tmp/audit-work/80-is-happy/audit-spec-vacuity.k
index b59142aa325d778a7795fe5a5f7513937b859fd5..f76b8310294ecc764aae32d236dc88c746520765
--- a//tmp/audit-work/80-is-happy/audit-spec-vacuity.k
+++ b//tmp/audit-work/80-is-happy/audit-spec-vacuity.k
