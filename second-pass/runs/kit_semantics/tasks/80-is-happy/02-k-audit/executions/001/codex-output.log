diff --git a//tmp/audit-work/80-is-happy/stage4_witnesses.py b//tmp/audit-work/80-is-happy/stage4_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..b44133c32fad41d4494e9ba98b0d56440c1d9d47
--- /dev/null
+++ b//tmp/audit-work/80-is-happy/stage4_witnesses.py
@@ -0,0 +1,25 @@
+def is_happy(s):
+    happy = True
+    previous2 = -1
+    previous1 = -1
+    i = 0
+    ch = ""
+    code = 0
+    for ch in s:
+        code = ord(ch)
+        if i >= 2 and (code == previous1 or code == previous2 or previous1 == previous2):
+            happy = False
+        previous2 = previous1
+        previous1 = code
+        i = i + 1
+
+    return i >= 3 and happy
+
+
+assert is_happy("") == False
+assert is_happy("a") == False
+assert is_happy("aa") == False
+assert is_happy("abc") == True
+assert is_happy("aba") == False
+assert is_happy("abca") == True
+assert is_happy("abac") == False
