    63	  // Cons-form emission with a freshness guard (the heap-list-probe discipline:
    64	  // an update-form H[N <- _] never re-normalizes symbolically). heapLoc is
    65	  // monotonic — it does NOT wind back at #pop: returned lists escape by ref.
    66	  // A bare list(VS) Val stays legal (read-only inputs in claims flow unboxed);
    67	  // only CONSTRUCTORS in program syntax allocate.
    68	  syntax Bool ::= isRefV(Val) [function, total]
    69	  rule isRefV(ref(_:Int)) => true
    70	  rule isRefV(_:Val)      => false [owise]
    71	
    72	  // closure cells (Python-faithful capture): the heap holds cellV(V); a
    73	  // cellRef surfacing as the k-redex reads through (lookup is the only use —
    74	  // cellRefs never escape to user-visible values)
    75	  syntax HeapVal ::= cellV(Val)
    76	  syntax Bool ::= isCellRef(Val) [function, total]
    77	  rule isCellRef(cellRef(_:Int)) => true
    78	  rule isCellRef(_:Val)          => false [owise]
    79	  // k-top deref for cell-bound reads surfacing INSIDE the annotated frame
    80	  // (AugAssign's in-place read and friends). The "$cells" guard keeps this
    81	  // DECIDABLY inapplicable in plain frames — an unguarded rule lets the
    82	  // prover narrow abstract k-top values into cellRef junk (probed on
    83	  // 26-remove-duplicates). Cross-frame reads (a comprehension closure
    84	  // reading the enclosing function's cellvar) deref inside #look instead.
    85	  rule <k> cellRef(H:Int) => V ... </k>
    86	       <env> L:Int </env>
    87	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    88	       <heap> ... H |-> cellV(V:Val) ... </heap>
    89	       requires "$cells" in_keys(M)
    90	       [priority(40)]
    91	
    92	  // write through a cell (Assign / #bindP / #bindTgt dispatch here on
    93	  // cell-bound names)
    94	  // a keyword argument cools to a TAGGED value (consumed by kw-aware builtins)
    95	  syntax Val ::= kwV(String, Val)
    96	  syntax KItem ::= #kwTag(String)
    97	  rule <k> KwArg(N:String, E:Expr) => E ~> #kwTag(N) ... </k>
    98	  rule <k> V:Val ~> #kwTag(N:String) => kwV(N, V) ... </k>
    99	       requires notBool isKwV(V)
   100	  syntax Bool ::= isKwV(Val) [function, total]
   101	  rule isKwV(kwV(_:String, _:Val)) => true
   102	  rule isKwV(_:Val)                => false [owise]
   103	
   104	  // the frame marker carries the CONCRETE cellvar list, so cell-write dispatch
   105	  // decides by pnMember even over an abstract frame rest (no prover branching)
   106	  syntax Val ::= cellsMark(ParamNames)
   107	  syntax ParamNames ::= cellsOf(Val) [function]
   108	  rule cellsOf(cellsMark(CVS:ParamNames)) => CVS
   109	  syntax Bool ::= pnMember(String, ParamNames) [function, total]
   110	  rule pnMember(_:String, .ParamNames) => false
   111	  rule pnMember(X:String, (P:String, R:ParamNames)) => X ==String P orBool pnMember(X, R)
   112	
   113	  syntax KItem ::= #cellW(Val, Val)
   114	  rule <k> #cellW(cellRef(H:Int), V:Val) => .K ... </k>
   115	       <heap> ... H |-> cellV(_:Val => V) ... </heap>
   116	
   117	  syntax KItem ::= #alloc(Val)
   118	  rule <k> #alloc(V:Val) => ref(N) ... </k>
   119	       <heap>    H:Map => (N |-> V) H </heap>
   120	       <heapLoc> N:Int => N +Int 1 </heapLoc>
   121	       requires notBool N in_keys(H)
   122	
   123	  // ==== module load + statement sequencing ==================================
   124	  syntax KItem ::= #loadAll(Module)
   125	  rule <k> #loadAll(Module(SS:Stmts)) => SS ... </k>
   126	  rule <k> (S:Stmt SS:Stmts):Stmts => S ~> SS ... </k>
   127	  rule <k> .Stmts => .K ... </k>
   128	
   129	  // ==== Name lookup (walk the scope chain; builtins live in the -1 scope) ====
   130	  syntax KItem ::= #look(String, Int)
   131	  rule <k> Name(X:String) => #look(X, L) ... </k> <env> L:Int </env>
   132	  rule <k> #look(X:String, L:Int) => {M[X]}:>Val ... </k>
   133	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   134	       requires X in_keys(M)
   135	  // a SYNTACTICALLY cell-bound name reads through the heap cell AT THE
   136	  // LOOKUP (higher priority beats the plain return above on concrete cell
   137	  // bindings; abstract claim values take the plain rule unchanged) — this
   138	  // covers cross-frame cell reads (a comprehension closure reading the
   139	  // enclosing function's cellvar) without a narrowing-prone k-top redex
   140	  // guarded on the FOUND frame's DECLARED cellvars (pnMember over the
   141	  // cellsMark): decidable for every concrete frame pin — plain frames and
   142	  // non-cell names prune outright, so an abstract looked-up value never
   143	  // drags a narrowing cellV heap match along (probed on 5-intersperse and
   144	  // Q4's abstract `numbers` in the annotated frame)
   145	  rule <k> #look(X:String, L:Int) => V ... </k>
   146	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   147	       <heap> ... H |-> cellV(V:Val) ... </heap>
   148	       requires X in_keys(M) andBool "$cells" in_keys(M)
   149	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
   150	        andBool {M[X]}:>Val ==K cellRef(H)
   151	       [priority(40)]
   152	  rule <k> #look(X:String, L:Int) => #look(X, P) ... </k>
   153	       <scopes> ... L |-> scope(M:Map, parent(P:Int)) ... </scopes>
   154	       requires notBool (X in_keys(M))
   155	
   156	  // the ONE predefined builtins scope (the -1 frame; claims write `-1 |-> builtinsScope`)
   157	  syntax Scope ::= "builtinsScope" [function, total]
   158	  rule builtinsScope
   159	    => scope(.Map [ "len"    <- builtinV("len")    ]
   160	                  [ "set"    <- builtinV("set")    ]
   161	                  [ "sum"    <- builtinV("sum")    ]
   162	                  [ "abs"    <- builtinV("abs")    ]
   163	                  [ "min"    <- builtinV("min")    ]
   164	                  [ "max"    <- builtinV("max")    ]
   165	                  [ "ord"    <- builtinV("ord")    ]
   166	                  [ "chr"    <- builtinV("chr")    ]
   167	                  [ "range"  <- builtinV("range")  ]
   168	                  [ "all"    <- builtinV("all")    ]
   169	                  [ "any"    <- builtinV("any")    ]
   170	                  [ "zip"    <- builtinV("zip")    ]
   171	                  [ "isinstance" <- builtinV("isinstance") ]
   172	                  [ "sorted" <- builtinV("sorted") ]
   173	                  [ "list"   <- builtinV("list")   ]
   174	                  [ "round"  <- builtinV("round")  ]
   175	                  [ "bin"    <- builtinV("bin")    ]
   176	                  [ "enumerate" <- builtinV("enumerate") ]
   177	                  [ "map"    <- builtinV("map")    ]
   178	                  [ "eval"   <- builtinV("eval")   ]
   179	                  [ "int"    <- typeV("int")       ]
   180	                  [ "str"    <- typeV("str")       ]
   181	                  [ "float"  <- typeV("float")     ], root)
   182	
   183	  // ==== argument/element evaluation: ONE left-to-right loop, tagged by destination ==
   184	  // (list/tuple literals and calls all use it; modules extend ApplyK with their tags)
   185	  syntax ApplyK ::= toCall(Val)
   186	  syntax KItem  ::= #evalArgs(Exprs, Vals, ApplyK)
   187	                  | #evalArgCont(Exprs, Vals, ApplyK)
   188	                  | #applyK(ApplyK, Vals)
   189	  rule <k> #evalArgs((A:Expr, REST:Exprs), ACC:Vals, K:ApplyK) => A ~> #evalArgCont(REST, ACC, K) ... </k>
   190	  rule <k> V:Val ~> #evalArgCont(REST:Exprs, ACC:Vals, K:ApplyK) => #evalArgs(REST, appendVal(ACC, V), K) ... </k>
   191	  rule <k> #evalArgs(.Exprs, ACC:Vals, K:ApplyK) => #applyK(K, ACC) ... </k>
   192	
   193	  // ==== Int / Bool / None literals ==========================================
   194	  rule <k> Int(I:Int)   => I ... </k>
   195	  rule <k> Bool(B:Bool) => B ... </k>
   196	  rule <k> NoneVal      => noneV ... </k>
   197	
   198	  // ==== truthy (If, Assert, BoolOp, IfExp, not, While) ======================
   199	  syntax Bool ::= truthy(Val) [function]
   200	  rule truthy(B:Bool)          => B
   201	  rule truthy(noneV)           => false
   202	  rule truthy(I:Int)           => I =/=Int 0
   203	  rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)
   204	  rule truthy(list(V:ValSeq))  => notBool (V ==K .ValSeq)
   205	  rule truthy(tuple(V:ValSeq)) => notBool (V ==K .ValSeq)
   206	
   207	  // ==== extensible operator dispatch (cases added by the construct modules) ==
   208	  syntax Val  ::= applyUn(String, Val) [function]
   209	  syntax Val  ::= applyBin(String, Val, Val) [function]
   210	  syntax Bool ::= applyCmp(String, Val, Val) [function]
   211	
   212	  // ==== shared list helpers =================================================
   213	  syntax Vals ::= appendVal(Vals, Val) [function, total]
   214	  rule appendVal(.Vals, V:Val)              => V , .Vals
   215	  rule appendVal((V0:Val, VS:Vals), V:Val)  => V0 , appendVal(VS, V)
   216	
   217	  syntax ValSeq ::= vals2valSeq(Vals) [function, total]
   218	  rule vals2valSeq(.Vals)            => .ValSeq
   219	  rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))
   220	
   221	  // ==== shared sequence length (len / summaries across many modules) ========
   222	  // (positional access valSeqAt/intSeqAt + normIdx live in subscript.k)
   223	  syntax Int ::= vsLen(ValSeq) [function, total]
   224	  rule vsLen(.ValSeq)                => 0
   225	  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
   226	
   227	  syntax Int ::= isLen(IntSeq) [function, total]
   228	  rule isLen(.IntSeq)                => 0
   229	  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
   230	
   231	  // in-bounds positional write (list subscript-assign); OOB leaves the seq unchanged
   232	  // (valid programs write in-bounds — mirrors valSeqAt's total-but-underspecified stance)
   233	  syntax ValSeq ::= setVSAt(ValSeq, Int, Val) [function, total]
   234	  rule setVSAt(.ValSeq, _:Int, _:Val)               => .ValSeq
   235	  rule setVSAt(vCons(_:Val, S:ValSeq), 0, V:Val)    => vCons(V, S)
   236	  rule setVSAt(vCons(W:Val, S:ValSeq), I:Int, V:Val) => vCons(W, setVSAt(S, I -Int 1, V))
   237	       requires I >Int 0
   238	  rule setVSAt(VS:ValSeq, I:Int, _:Val)             => VS
   239	       requires I <Int 0
   240	endmodule
     1	// reference/src/semantics/iter.k — MPY-ITER
     2	// The iterator protocol, DECLARATION ONLY. Each iterable's #iterNext case lives in that
     3	// iterable's own module (list/tuple/str in their modules, rangeObj in range.k, zip in
     4	// builtins.k). Consumers (the for-loop, `x in _`, sum/all/any/max/min) import this.
     5	
     6	module MPY-ITER
     7	  imports MPY-CORE
     8	  syntax KItem ::= #iterNext(Iterable) | "#iterDone" | #iterYield(Val, Iterable)
     9	endmodule
     1	// reference/src/semantics/str.k — MPY-STR
     2	
     3	module MPY-STR
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	
     7	  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
     8	  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
     9	  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
    10	        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
    11	
    12	  // ==== str literal (ASCII-only) ============================================
    13	  syntax IntSeq ::= strToCodes(String) [function]
    14	  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
    15	  rule strToCodes("") => .IntSeq
    16	  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    17	    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
    18	
    19	  // ==== operators: + / == / != / in =========================================
    20	  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
    21	  rule seqConcat(.IntSeq, T:IntSeq)                => T
    22	  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
    23	
    24	  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
    26	  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
    27	
    28	  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
    29	  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
    30	  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
    31	
    32	  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
    33	  rule strPrefix(.IntSeq, _:IntSeq)               => true
    34	  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
    35	  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
    36	
    37	  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
    38	  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
    39	  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
    40	  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
    41	       requires notBool strPrefix(P, iCons(C, Xs))
    42	
    43	  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
    44	  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
    45	  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
    46	  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
    47	  // str </<=/>/>= comparisons.
    48	  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
    49	  rule strLt(.IntSeq, .IntSeq)                => false
    50	  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
    51	  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
    52	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
    53	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
    54	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
    55	
    56	  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    57	  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
    58	  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
    59	  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
    60	endmodule
     1	// reference/src/semantics/builtins.k — MPY-BUILTINS
     2	
     3	module MPY-BUILTINS
     4	  imports MPY-CORE
     5	  imports MPY-STR
     6	  imports MPY-SET
     7	  imports MPY-ITER
     8	  imports MPY-RANGE
     9	  imports MPY-INT
    10	  imports MPY-METHODS
    11	
    12	  // the builtins REGISTRY is core.k's builtinsScope (the -1 frame); names resolve by lookup
    13	
    14	  // Call routing + argument evaluation live in call.k, which also routes the fold
    15	  // builtins (sum/all/any/max/min) to the #_Acc folds below and everything else to
    16	  // applyBuiltin. This module owns applyBuiltin + the fold implementations.
    17	  syntax Val ::= applyBuiltin(String, Vals) [function]
    18	
    19	  // ==== len(obj) — O(1) per kind ============================================
    20	  syntax Int ::= seqLen(Val) [function]
    21	  rule applyBuiltin("len", OBJ:Val, .Vals) => seqLen(OBJ)
    22	  rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
    23	  rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
    24	  rule seqLen(str(IS:IntSeq))                   => isLen(IS)
    25	  rule seqLen(setV(DS:IntSeq))                  => isLen(DS)
    26	  rule seqLen(rangeObj(LO:Int, HI:Int, ST:Int)) => rangeLen(LO, HI, ST)
    27	
    28	  // ==== list(seq) — materialize a list/tuple into a list (e.g. list(d.keys())) ==
    29	  // Minimal: the "copy a sequence" case (list of a list is itself; list of a tuple keeps order).
    30	  // list() of other iterables (str/range/set/zip) is added via the iterator fold when needed.
    31	  // (k-cell — list() constructs a NEW object)
    32	  rule <k> #applyK(toCall(builtinV("list")), (list(VS:ValSeq),  .Vals)) => #alloc(list(VS)) ... </k>
    33	  rule <k> #applyK(toCall(builtinV("list")), (tuple(VS:ValSeq), .Vals)) => #alloc(list(VS)) ... </k>
    34	  rule <k> #applyK(toCall(builtinV("list")), .Vals)                     => #alloc(list(.ValSeq)) ... </k>
    35	  rule <k> #applyK(toCall(builtinV("list")), (str(CS:IntSeq), .Vals))   => #alloc(list(charsOf(CS))) ... </k>
    36	  syntax ValSeq ::= charsOf(IntSeq) [function, total]
    37	  rule charsOf(.IntSeq)                => .ValSeq
    38	  rule charsOf(iCons(C:Int, R:IntSeq)) => vCons(str(iCons(C, .IntSeq)), charsOf(R))
    39	
    40	  // ==== set(str) — distinct character codes =================================
    41	  rule applyBuiltin("set", str(CS:IntSeq), .Vals) => setV(dedupCodes(CS))
    42	
    43	  // ==== abs(int) ============================================================
    44	  rule applyBuiltin("abs", I:Int, .Vals) => absInt(I)
    45	
    46	  // ==== sum(iterable) — one #iterNext fold; intOf = int value of an int/bool ==
    47	  syntax KItem ::= #sumAcc(Iterable, Int) | #sumCont(Int)
    48	  rule <k> #sumAcc(IT:Iterable, ACC:Int) => #iterNext(IT) ~> #sumCont(ACC) ... </k>
    49	  rule <k> #iterDone ~> #sumCont(ACC:Int) => ACC ... </k>
    50	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
    51	        => #sumAcc(R, ACC +Int intOf(V)) ... </k>
    52	       requires isInt(V) orBool isBool(V)
    53	
    54	  syntax Int ::= intOf(Val) [function]
    55	  rule intOf(I:Int)  => I
    56	  rule intOf(B:Bool) => #if B #then 1 #else 0 #fi
    57	
    58	  // ==== all / any (short-circuiting #iterNext folds) ========================
    59	  syntax KItem ::= #allAcc(Iterable) | "#allCont"
    60	  rule <k> #allAcc(IT:Iterable) => #iterNext(IT) ~> #allCont ... </k>
    61	  rule <k> #iterDone ~> #allCont => true ... </k>
    62	  rule <k> #iterYield(V:Val, R:Iterable) ~> #allCont => #allAcc(R) ... </k>
    63	       requires truthy(V)
    64	  rule <k> #iterYield(V:Val, _:Iterable) ~> #allCont => false ... </k>
    65	       requires notBool truthy(V)
    66	
    67	  syntax KItem ::= #anyAcc(Iterable) | "#anyCont"
    68	  rule <k> #anyAcc(IT:Iterable) => #iterNext(IT) ~> #anyCont ... </k>
    69	  rule <k> #iterDone ~> #anyCont => false ... </k>
    70	  rule <k> #iterYield(V:Val, _:Iterable) ~> #anyCont => true ... </k>
    71	       requires truthy(V)
    72	  rule <k> #iterYield(V:Val, R:Iterable) ~> #anyCont => #anyAcc(R) ... </k>
    73	       requires notBool truthy(V)
    74	
    75	  // ==== max / min over an iterable (#iterNext folds; first element seeds) ====
    76	  syntax KItem ::= #maxAcc0(Iterable) | "#maxCont0" | #maxAcc(Iterable, Int) | #maxCont(Int)
    77	  rule <k> #maxAcc0(IT:Iterable) => #iterNext(IT) ~> #maxCont0 ... </k>
    78	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAcc(R, {V}:>Int) ... </k>
    79	       requires isInt(V)
    80	  rule <k> #maxAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #maxCont(M) ... </k>
    81	  rule <k> #iterDone ~> #maxCont(M:Int) => M ... </k>
    82	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)
    83	        => #maxAcc(R, maxInt(M, {V}:>Int)) ... </k>
    84	       requires isInt(V)
    85	
    86	  syntax KItem ::= #minAcc0(Iterable) | "#minCont0" | #minAcc(Iterable, Int) | #minCont(Int)
    87	  rule <k> #minAcc0(IT:Iterable) => #iterNext(IT) ~> #minCont0 ... </k>
    88	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAcc(R, {V}:>Int) ... </k>
    89	       requires isInt(V)
    90	  rule <k> #minAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #minCont(M) ... </k>
    91	  rule <k> #iterDone ~> #minCont(M:Int) => M ... </k>
    92	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)
    93	        => #minAcc(R, minInt(M, {V}:>Int)) ... </k>
    94	       requires isInt(V)
    95	
    96	  // ==== variadic max / min (a Vals fold) ====================================
    97	  syntax Int ::= maxVals(Int, Vals) [function]
    98	  rule applyBuiltin("max", I:Int, REST:Vals) => maxVals(I, REST)
    99	  rule maxVals(M:Int, .Vals)           => M
   100	  rule maxVals(M:Int, (I:Int, R:Vals)) => maxVals(maxInt(M, I), R)
   101	
   102	  syntax Int ::= minVals(Int, Vals) [function]
   103	  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
   104	  rule minVals(M:Int, .Vals)           => M
   105	  rule minVals(M:Int, (I:Int, R:Vals)) => minVals(minInt(M, I), R)
   106	
   107	  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
   108	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   109	       requires N >=Int 0
   110	  // negative operand: the '-' sign prefixes the magnitude's digits
   111	  rule applyBuiltin("bin", N:Int, .Vals)
   112	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   113	       requires N <Int 0
   114	  syntax IntSeq ::= binCodes(Int) [function, total]
   115	  rule binCodes(0) => iCons(48, .IntSeq)
   116	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   117	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   118	  rule binAcc(0, ACC:IntSeq) => ACC
   119	  rule binAcc(N:Int, ACC:IntSeq)
   120	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   121	       requires N >Int 0
   122	
   123	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   124	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   125	        => #alloc(list(enumVS(VS, 0))) ... </k>
   126	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   127	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   128	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   129	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   130	
   131	  // ==== map(str, xs) — eager (only the str case is in the subset) =============
   132	  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
   133	        => #alloc(list(mapStrVS(VS))) ... </k>
   134	  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
   135	  rule mapStrVS(.ValSeq) => .ValSeq
   136	  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
   137	  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
   138	
   139	  // ==== int(x) identities (int(round(x)) composes through) ====================
   140	  rule applyBuiltin("int", I:Int, .Vals) => I
   141	
   142	  // ==== ord / chr ===========================================================
   143	  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
   144	  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
   145	       requires 0 <=Int I andBool I <Int 128
   146	
   147	  // ==== str(int) / str(str) =================================================
   148	  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
   149	  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
   150	
   151	  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
   152	  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
   153	       requires 48 <=Int C andBool C <=Int 57
   154	
   155	  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
   156	  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
   157	       requires isLen(CS) >=Int 2
   158	  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
   159	  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
   160	  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
   161	
   162	  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
   163	  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
   164	  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
   165	
   166	  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
   167	  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
   168	        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
   169	  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
   170	  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
   171	  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
   172	        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
   173	  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
   174	  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>
   175	
   176	  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
   177	  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
   178	  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
   179	  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
   180	       requires S =/=Int 0
   181	
   182	  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
   183	  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
   184	  // trusted pass evaluator, now DEFINED in the reference and driven by a
   185	  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
   186	  // argument leaves the call unevaluated for problem-level folds.
   187	  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
   188	  syntax Int ::= evalArith(IntSeq) [function]
   189	  rule evalArith(CS:IntSeq)
   190	    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))
   191	
   192	  syntax OpSeq ::= ".OpSeq" | oCons(String, OpSeq)
   193	
   194	  syntax Bool ::= evDigit(Int) [function, total]
   195	  rule evDigit(C:Int) => C >=Int 48 andBool C <=Int 57
   196	  syntax Bool ::= evHead42(IntSeq) [function, total]
   197	  rule evHead42(iCons(42, _:IntSeq)) => true
   198	  rule evHead42(_:IntSeq)            => false [owise]
   199	  syntax Bool ::= evHead47(IntSeq) [function, total]
   200	  rule evHead47(iCons(47, _:IntSeq)) => true
   201	  rule evHead47(_:IntSeq)            => false [owise]
   202	
   203	  syntax OpSeq ::= tokOps(IntSeq) [function, total]
   204	  rule tokOps(.IntSeq)                 => .OpSeq
   205	  rule tokOps(iCons(32, R:IntSeq))     => tokOps(R)
   206	  rule tokOps(iCons(C:Int, R:IntSeq))  => tokOps(R) requires evDigit(C)
   207	  rule tokOps(iCons(42, iCons(42, R:IntSeq))) => oCons("**", tokOps(R))
   208	  rule tokOps(iCons(42, R:IntSeq))     => oCons("*", tokOps(R)) requires notBool evHead42(R)
   209	  rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons("//", tokOps(R))
   210	  rule tokOps(iCons(47, R:IntSeq))     => oCons("/", tokOps(R)) requires notBool evHead47(R)
   211	  rule tokOps(iCons(43, R:IntSeq))     => oCons("+", tokOps(R))
   212	  rule tokOps(iCons(45, R:IntSeq))     => oCons("-", tokOps(R))
   213	
   214	  syntax IntSeq ::= tokNds(IntSeq) [function, total]
   215	                  | tokNdAcc(Int, IntSeq) [function, total]
   216	  rule tokNds(.IntSeq)                => .IntSeq
   217	  rule tokNds(iCons(32, R:IntSeq))    => tokNds(R)
   218	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNdAcc(C -Int 48, R) requires evDigit(C)
   219	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNds(R)
   220	       requires notBool evDigit(C) andBool C =/=Int 32
   221	  rule tokNdAcc(A:Int, iCons(C:Int, R:IntSeq)) => tokNdAcc(A *Int 10 +Int (C -Int 48), R)
   222	       requires evDigit(C)
   223	  rule tokNdAcc(A:Int, S:IntSeq) => iCons(A, tokNds(S)) [owise]
   224	
   225	  syntax EvPair ::= evp(OpSeq, IntSeq)
   226	  syntax Int ::= firstNdE(EvPair) [function, total]
   227	  rule firstNdE(evp(_:OpSeq, iCons(N:Int, _:IntSeq))) => N
   228	  rule firstNdE(_:EvPair) => 0 [owise]
   229	
   230	  syntax Int ::= applyOpE(String, Int, Int) [function, total]

diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..231fca0e8d32caffd679de1936c13a2fab6714df
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee "$log_path"
+
+set +e
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+set -e
+
+printf 'EXIT_STATUS: %s\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"
diff --git a/evidence/stage1_integrity.py b/evidence/stage1_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..b46e3e3d2f732362b5c11be2ac50cc37605c9fd1
--- /dev/null
+++ b/evidence/stage1_integrity.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+"""Independent integrity checks for the launcher-owned audit inputs."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+from collections import Counter
+from pathlib import Path
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+CAMPAIGN_LOCK = Path("/audit-campaign-lock.json")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def require_regular(path: Path) -> None:
+    assert path.exists(), f"missing required file: {path}"
+    assert not path.is_symlink(), f"symlinked required file: {path}"
+    assert path.is_file(), f"mistyped required file: {path}"
+    with path.open("rb"):
+        pass
+
+
+def sha256_tree(root: Path) -> str:
+    """Reimplement the launcher tree digest from mounted bytes and entry types."""
+    root_stat = root.lstat()
+    assert stat.S_ISDIR(root_stat.st_mode), f"not a real directory: {root}"
+    digest = hashlib.sha256()
+    entries: list[tuple[str, str, Path]] = []
+    pending = [root]
+    while pending:
+        directory = pending.pop()
+        for child in os.scandir(directory):
+            path = Path(child.path)
+            mode = child.stat(follow_symlinks=False).st_mode
+            relative = path.relative_to(root).as_posix()
+            if stat.S_ISDIR(mode):
+                entries.append((relative, "directory", path))
+                pending.append(path)
+            elif stat.S_ISREG(mode):
+                entries.append((relative, "file", path))
+            else:
+                raise AssertionError(f"linked or unsupported tree entry: {path}")
+    for relative, kind, path in sorted(entries):
+        encoded = relative.encode()
+        digest.update(len(encoded).to_bytes(4, "big"))
+        digest.update(encoded)
+        digest.update(kind.encode() + b"\0")
+        if kind == "file":
+            size = path.stat(follow_symlinks=False).st_size
+            digest.update(size.to_bytes(8, "big"))
+            with path.open("rb") as stream:
+                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                    digest.update(chunk)
+    return digest.hexdigest()
+
+
+audit = json.loads(AUDIT_INPUT.read_text(encoding="utf-8"))
+lock = json.loads(CAMPAIGN_LOCK.read_text(encoding="utf-8"))
+assert audit["record_layout"] == "pipeline-v3"
+assert audit["semantics_mode"] == "SUPPLIED_SEMANTICS"
+assert audit["audit_campaign"] == lock
+assert sha256(CAMPAIGN_LOCK) == audit["hashes"]["audit_campaign_lock_sha256"]
+
+paths = audit["container_paths"]
+required = {
+    "audit_campaign_lock": Path(paths["audit_campaign_lock"]),
+    "candidate": Path(paths["candidate"]),
+    "canonical": Path(paths["canonical"]),
+    "generation_last": Path(paths["generation_last"]),
+    "generation_manifest": Path(paths["generation_manifest"]),
+    "generation_metrics": Path(paths["generation_metrics"]),
+    "generation_output": Path(paths["generation_output"]),
+    "run_manifest": Path(paths["run_manifest"]),
+    "stage1_result": Path(paths["stage1_result"]),
+    "task_manifest": Path(paths["task_manifest"]),
+    "translator": Path(paths["translator"]),
+    "trusted_prompt": Path(paths["trusted_prompt"]),
+    "generation_runtime_metrics": Path("/generation-evidence/runtime-metrics.json"),
+    "generation_usage": Path("/generation-evidence/usage.json"),
+    "generation_prompt": Path("/generation-evidence/prompt.txt"),
+}
+for key, path in required.items():
+    if key == "candidate":
+        assert path.is_dir() and not path.is_symlink(), f"invalid mount: {path}"
+    else:
+        require_regular(path)
+
+trace_root = Path(paths["generation_trace"])
+assert trace_root.is_dir() and not trace_root.is_symlink()
+trace_files = sorted(trace_root.rglob("*"))
+assert trace_files, "structured trace is empty"
+assert not any(path.is_symlink() for path in trace_files)
+trace_jsonl = [path for path in trace_files if path.is_file()]
+assert len(trace_jsonl) == 1
+trace_path = trace_jsonl[0]
+
+hash_checks = {
+    "canonical_sha256": Path(paths["canonical"]),
+    "trusted_prompt_sha256": Path(paths["trusted_prompt"]),
+    "trusted_translator_sha256": Path(paths["translator"]),
+    "run_manifest_sha256": Path(paths["run_manifest"]),
+    "task_manifest_sha256": Path(paths["task_manifest"]),
+    "stage1_result_sha256": Path(paths["stage1_result"]),
+    "stage1_invocation_sha256": Path(paths["generation_manifest"]),
+    "generation_metrics_sha256": Path(paths["generation_metrics"]),
+    "generation_runtime_metrics_sha256": required["generation_runtime_metrics"],
+    "generation_usage_sha256": required["generation_usage"],
+    "generation_codex_last_sha256": Path(paths["generation_last"]),
+    "generation_codex_output_sha256": Path(paths["generation_output"]),
+    "generation_prompt_sha256": required["generation_prompt"],
+}
+for hash_key, path in hash_checks.items():
+    actual = sha256(path)
+    expected = audit["hashes"][hash_key]
+    assert actual == expected, f"{hash_key}: {actual} != {expected}"
+
+result = json.loads(Path(paths["stage1_result"]).read_text(encoding="utf-8"))
+usage = json.loads(required["generation_usage"].read_text(encoding="utf-8"))
+trace_rel = str(trace_path.relative_to(Path(paths["generation_root"])))
+trace_expected = result["outputs"]["evidence"][trace_rel]
+assert sha256(trace_path) == trace_expected
+assert sha256_tree(trace_root) == usage["source_trace_sha256"]
+
+candidate = Path(paths["candidate"])
+candidate_pipeline_tree_hash = sha256_tree(candidate)
+assert candidate_pipeline_tree_hash == result["outputs"]["workspace_sha256"]
+proof_artifacts = (
+    "solution.py",
+    "solution.mpy",
+    "verification.k",
+    "spec.k",
+    "prove.sh",
+    "PROOF.md",
+)
+for relative in proof_artifacts:
+    require_regular(candidate / relative)
+
+reference_semantics = Path("/reference/reference-semantics")
+candidate_semantics = candidate / "reference-semantics"
+assert reference_semantics.is_dir() and not reference_semantics.is_symlink()
+assert candidate_semantics.is_dir() and not candidate_semantics.is_symlink()
+trusted_semantics_tree_hash = sha256_tree(reference_semantics)
+candidate_semantics_tree_hash = sha256_tree(candidate_semantics)
+assert (
+    trusted_semantics_tree_hash
+    == audit["hashes"]["trusted_reference_semantics_manifest_sha256"]
+)
+assert candidate_semantics_tree_hash == trusted_semantics_tree_hash
+
+
+def tree_entries(root: Path) -> dict[str, tuple[str, str | None]]:
+    entries: dict[str, tuple[str, str | None]] = {}
+    for path in sorted(root.rglob("*")):
+        relative = str(path.relative_to(root))
+        if path.is_symlink():
+            entries[relative] = ("symlink", os.readlink(path))
+        elif path.is_dir():
+            entries[relative] = ("directory", None)
+        elif path.is_file():
+            entries[relative] = ("file", sha256(path))
+        else:
+            entries[relative] = ("other", None)
+    return entries
+
+
+trusted_entries = tree_entries(reference_semantics)
+candidate_entries = tree_entries(candidate_semantics)
+assert candidate_entries == trusted_entries
+assert (candidate / "prompt.py").read_bytes() == Path(paths["trusted_prompt"]).read_bytes()
+assert (candidate / "py2mpy.py").read_bytes() == Path(paths["translator"]).read_bytes()
+
+event_counts: Counter[tuple[str, str]] = Counter()
+line_count = 0
+with trace_path.open(encoding="utf-8") as stream:
+    for line_count, line in enumerate(stream, start=1):
+        event = json.loads(line)
+        event_counts[(event.get("type", ""), event.get("payload", {}).get("type", ""))] += 1
+
+print("record_layout=pipeline-v3")
+print("semantics_mode=SUPPLIED_SEMANTICS")
+print("campaign_lock_json_match=true")
+print("campaign_lock_hash_match=true")
+print(f"required_launcher_records={len(required) + 1}")
+print("required_launcher_records_present_regular=true")
+print("candidate_required_proof_artifacts_present_regular=true")
+print(f"candidate_pipeline_tree_sha256={candidate_pipeline_tree_hash}")
+print("candidate_pipeline_tree_hash_matches_generation_result=true")
+print("candidate_prompt_matches_trusted=true")
+print("candidate_translator_matches_trusted=true")
+print(f"supplied_semantics_entries={len(trusted_entries)}")
+print(f"supplied_semantics_tree_sha256={trusted_semantics_tree_hash}")
+print("supplied_semantics_recursive_identity=true")
+print("symlink_count_candidate_reference_generation=0")
+print(f"trace_path={trace_path}")
+print(f"trace_lines={line_count}")
+print(f"trace_sha256={sha256(trace_path)}")
+print(f"trace_tree_sha256={sha256_tree(trace_root)}")
+print("trace_tree_hash_matches_usage_record=true")
+print("trace_json_parse=true")
+print("trace_event_counts:")
+for (top_type, payload_type), count in sorted(event_counts.items()):
+    print(f"  {top_type}/{payload_type or '-'}={count}")
+print("all_declared_single_file_hashes_match=true")
diff --git a/evidence/stage2_differential.py b/evidence/stage2_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..b0dbbd1521b4181082af2337f2573a291586731c
--- /dev/null
+++ b/evidence/stage2_differential.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Independent candidate-versus-canonical differential test for HumanEval/80."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import itertools
+import json
+import random
+from pathlib import Path
+
+
+def load_entry(path: Path, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.is_happy
+
+
+def contract_oracle(text: str) -> bool:
+    """Direct statement of: length >= 3 and each width-3 window is distinct."""
+    return len(text) >= 3 and all(
+        len({text[index], text[index + 1], text[index + 2]}) == 3
+        for index in range(len(text) - 2)
+    )
+
+
+parser = argparse.ArgumentParser()
+parser.add_argument("canonical", type=Path)
+parser.add_argument("candidate", type=Path)
+parser.add_argument("corpus_output", type=Path)
+args = parser.parse_args()
+
+canonical = load_entry(args.canonical, "audit_trusted_canonical")
+candidate = load_entry(args.candidate, "audit_generated_solution")
+
+documented = {
+    "a": False,
+    "aa": False,
+    "abcd": True,
+    "aabb": False,
+    "adb": True,
+    "xyy": False,
+}
+boundaries = [
+    "",
+    "a",
+    "ab",
+    "aa",
+    "abc",
+    "aab",
+    "abb",
+    "aba",
+    "abcd",
+    "abca",  # distance-three repetition is allowed
+    "abac",
+    "abcb",
+    "aabc",
+    "abbc",
+    "abcc",
+    "\x00\x01\x02",
+    "\x00\x01\x00",
+    "😀βγ😀",
+    "😀β😀",
+    "éｅ𝄞",
+    "éｅé",
+]
+
+exhaustive = [
+    "".join(chars)
+    for length in range(0, 8)
+    for chars in itertools.product("abc", repeat=length)
+]
+
+rng = random.Random(800080)
+alphabet = ["a", "b", "c", "x", "é", "中", "😀", "\x00", "\U0010ffff"]
+generated = [
+    "".join(rng.choice(alphabet) for _ in range(rng.randrange(0, 81)))
+    for _ in range(2500)
+]
+generated.extend(
+    [
+        "".join(chr(code) for code in range(1, 201)),
+        "abc" * 4000,
+        "".join(chr(0x10000 + offset) for offset in range(1000)),
+    ]
+)
+
+all_cases: list[str] = []
+seen: set[str] = set()
+for text in list(documented) + boundaries + exhaustive + generated:
+    if text not in seen:
+        seen.add(text)
+        all_cases.append(text)
+
+args.corpus_output.write_text(
+    json.dumps(
+        {
+            "seed": 800080,
+            "random_alphabet_codepoints": [ord(char) for char in alphabet],
+            "cases": all_cases,
+        },
+        ensure_ascii=True,
+        indent=2,
+    )
+    + "\n",
+    encoding="utf-8",
+)
+
+mismatches: list[dict[str, object]] = []
+for text in all_cases:
+    expected_contract = contract_oracle(text)
+    expected_canonical = canonical(text)
+    actual = candidate(text)
+    if text in documented and expected_canonical is not documented[text]:
+        mismatches.append(
+            {
+                "kind": "documented/canonical",
+                "input": repr(text),
+                "documented": documented[text],
+                "canonical": expected_canonical,
+            }
+        )
+    if expected_canonical is not expected_contract:
+        mismatches.append(
+            {
+                "kind": "contract/canonical",
+                "input": repr(text),
+                "contract": expected_contract,
+                "canonical": expected_canonical,
+            }
+        )
+    if actual is not expected_canonical:
+        mismatches.append(
+            {
+                "kind": "candidate/canonical",
+                "input": repr(text),
+                "canonical": expected_canonical,
+                "candidate": actual,
+            }
+        )
+
+corpus_hash = hashlib.sha256(args.corpus_output.read_bytes()).hexdigest()
+print(f"documented_cases={len(documented)}")
+print(f"boundary_cases={len(boundaries)}")
+print(f"exhaustive_alphabet=abc exhaustive_lengths=0..7 count={len(exhaustive)}")
+print(f"generated_seed=800080 generated_count={len(generated)}")
+print(f"unique_total_cases={len(all_cases)}")
+print(f"max_input_length={max(map(len, all_cases))}")
+print(f"corpus_sha256={corpus_hash}")
+print(f"mismatches={len(mismatches)}")
+for mismatch in mismatches[:20]:
+    print(json.dumps(mismatch, ensure_ascii=True, sort_keys=True))
+raise SystemExit(1 if mismatches else 0)

