@@ -0,0 +1,48 @@
+Module(
+  FuncDef("is_happy", Params("s"),
+    Assign(Name("happy"), Bool(true))
+    Assign(Name("previous2"), UnaryOp("-", Int(1)))
+    Assign(Name("previous1"), UnaryOp("-", Int(1)))
+    Assign(Name("i"), Int(0))
+    Assign(Name("ch"), Str(""))
+    Assign(Name("code"), Int(0))
+    For(Name("ch"), Name("s"),
+      Assign(Name("code"), Call(Name("ord"), Name("ch")))
+      If(BoolOp(
+        "and",
+        Compare(Name("i"), CmpOp(">=", Int(2))),
+        BoolOp(
+          "or",
+          Compare(Name("code"), CmpOp("==", Name("previous1"))),
+          Compare(Name("code"), CmpOp("==", Name("previous2"))),
+          Compare(Name("previous1"), CmpOp("==", Name("previous2"))))),
+        Assign(Name("happy"), Bool(false)),
+        )
+      Assign(Name("previous2"), Name("previous1"))
+      Assign(Name("previous1"), Name("code"))
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+    Return(
+      BoolOp(
+        "and",
+        Compare(Name("i"), CmpOp(">=", Int(3))),
+        Name("happy"))))
+  Assert(
+    Compare(Call(Name("is_happy"), Str("")), CmpOp("==", Bool(false))))
+  Assert(
+    Compare(Call(Name("is_happy"), Str("a")), CmpOp("==", Bool(false))))
+  Assert(
+    Compare(Call(Name("is_happy"), Str("aa")), CmpOp("==", Bool(false))))
+  Assert(
+    Compare(Call(Name("is_happy"), Str("abc")), CmpOp("==", Bool(true))))
+  Assert(
+    Compare(
+      Call(Name("is_happy"), Str("aba")),
+      CmpOp("==", Bool(false))))
+  Assert(
+    Compare(
+      Call(Name("is_happy"), Str("abca")),
+      CmpOp("==", Bool(true))))
+  Assert(
+    Compare(
+      Call(Name("is_happy"), Str("abac")),
+      CmpOp("==", Bool(false)))))
diff --git a/evidence/stage4_concrete_witness.py b/evidence/stage4_concrete_witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..b44133c32fad41d4494e9ba98b0d56440c1d9d47
--- /dev/null
+++ b/evidence/stage4_concrete_witness.py
@@ -0,0 +1,25 @@
+def is_happy(s):
+    happy = True
+    previous2 = -1
+    previous1 = -1
+    i = 0
+    ch = ""
+    code = 0
+    for ch in s:
+        code = ord(ch)
+        if i >= 2 and (code == previous1 or code == previous2 or previous1 == previous2):
+            happy = False
+        previous2 = previous1
+        previous1 = code
+        i = i + 1
+
+    return i >= 3 and happy
+
+
+assert is_happy("") == False
+assert is_happy("a") == False
+assert is_happy("aa") == False
+assert is_happy("abc") == True
+assert is_happy("aba") == False
+assert is_happy("abca") == True
+assert is_happy("abac") == False
