+ nl -ba /reference/k-proof/solution.py
     1	def is_happy(s):
     2	    happy = True
     3	    previous2 = -1
     4	    previous1 = -1
     5	    i = 0
     6	    ch = ""
     7	    code = 0
     8	    for ch in s:
     9	        code = ord(ch)
    10	        if i >= 2 and (code == previous1 or code == previous2 or previous1 == previous2):
    11	            happy = False
    12	        previous2 = previous1
    13	        previous1 = code
    14	        i = i + 1
    15	
    16	    return i >= 3 and happy
