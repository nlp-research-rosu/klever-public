     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Exact summary of the remaining structural string iteration. P2 and P1
     7	  // are the character codes two and one positions before the next character.
     8	  syntax Bool ::= scanHappy(IntSeq, Int, Int, Int) [function, total]
     9	  rule scanHappy(.IntSeq, _:Int, _:Int, _:Int) => true
    10	  rule scanHappy(iCons(C:Int, REST:IntSeq), I:Int, _:Int, P1:Int)
    11	    => scanHappy(REST, I +Int 1, P1, C)
    12	    requires I <Int 2
    13	  rule scanHappy(iCons(C:Int, REST:IntSeq), I:Int, P2:Int, P1:Int)
    14	    => (C =/=Int P1)
    15	       andBool (C =/=Int P2)
    16	       andBool (P1 =/=Int P2)
    17	       andBool scanHappy(REST, I +Int 1, P1, C)
    18	    requires I >=Int 2
    19	endmodule
