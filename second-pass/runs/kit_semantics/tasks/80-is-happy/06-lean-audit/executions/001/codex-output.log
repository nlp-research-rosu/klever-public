/bin/bash -lc "find /tmp/klean-generated-build -maxdepth 4 -type f -print 2>/dev/null | sort | sed -n '1,200p'; ls -ld /tmp/klean-generated-build 2>/dev/null || true; find / -path '*/bin/lean' -type f -print 2>/dev/null | sort | sed -n '1,80p'" in /audit-output
