diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..dafbc4f9e93830ebdc78b4d7605853c5984eeade
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,37 @@
+from solution import fib4
+
+
+def contract_oracle(n: int) -> int:
+    values = [0, 0, 2, 0]
+    for i in range(4, n + 1):
+        values.append(
+            values[i - 1]
+            + values[i - 2]
+            + values[i - 3]
+            + values[i - 4]
+        )
+    return values[n]
+
+
+def main() -> None:
+    examples = {5: 4, 6: 8, 7: 14}
+    for n, expected in examples.items():
+        assert fib4(n) == expected
+
+    mismatches = []
+    for n in range(201):
+        actual = fib4(n)
+        expected = contract_oracle(n)
+        if actual != expected:
+            mismatches.append((n, actual, expected))
+
+    print("domain: n = 0..200")
+    print("oracle: direct prompt recurrence with stored prefix")
+    print(f"mismatches: {len(mismatches)}")
+    if mismatches:
+        print(mismatches[:10])
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..14ef8d8b5652f5f53bff5ad0c6494c27de702978
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,24 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT-SYNTAX
+
+  // The prompt's Fib4 recurrence, totalized to 0 below the stated N >= 0 domain.
+  syntax Int ::= fib4Spec(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule fib4Spec(N) => 0
+    requires N <=Int 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+  rule fib4Spec(N)
+    => fib4Spec(N -Int 1) +Int fib4Spec(N -Int 2)
+       +Int fib4Spec(N -Int 3) +Int fib4Spec(N -Int 4)
+    requires N >=Int 4
+endmodule

apply patch
