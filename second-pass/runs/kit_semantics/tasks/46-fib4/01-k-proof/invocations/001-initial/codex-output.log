/bin/bash -lc "chmod +x prove.sh; bash -n prove.sh; git status --short 2>/dev/null || true; rg -n \"fib4Advance|n\\\"\\), CmpOp\\(\\\">|Name\\(\\\"n\\\"\\), BinOp\\(\\\"-\\\"\" solution.py solution.mpy verification.k spec*.k smoke.py smoke.mpy || true" in /workspace
