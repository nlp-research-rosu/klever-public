+        values.append(
+            values[i - 1]
+            + values[i - 2]
+            + values[i - 3]
+            + values[i - 4]
+        )
+    return values[n]
+
+
+def main() -> None:
+    examples = {5: 4, 6: 8, 7: 14}
+    for n, expected in examples.items():
+        assert fib4(n) == expected
+
+    mismatches = []
+    for n in range(201):
+        actual = fib4(n)
+        expected = contract_oracle(n)
+        if actual != expected:
