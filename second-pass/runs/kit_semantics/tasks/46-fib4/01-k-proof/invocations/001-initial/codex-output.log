index 0000000000000000000000000000000000000000..67ed940289bb89652b7048b6f07aeddb2e7e15da
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,48 @@
+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Deliberately false at the realizable witness n = 0: the correct result is 0.
+  claim [fib4-wrong-result]:
+    <k>
+      Call(Name("fib4"), Int(0))
+      =>
+      1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fib4" |-> closureVal(
+          "n",
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(0))
+          Assign(Name("c"), Int(2))
+          Assign(Name("d"), Int(0))
+          Assign(Name("e"), Int(0))
+          While(
+            Compare(Name("n"), CmpOp(">", Int(0))),
+            Assign(
+              Name("e"),
+              BinOp(
+                "+",
+                BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+                Name("d")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("d"), Name("e"))
+            Assign(Name("n"), BinOp("-", Name("n"), Int(1))))
+          Return(Name("a")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2f79bf6efcbf9dedea8e71ee8ddbb7d26c89b454
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,85 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Circularity at the recurring internal while-loop head.  The continuation
+  // and all configuration cells except the active local scope are framed.
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">", Int(0))),
+        Assign(
+          Name("e"),
+          BinOp(
+            "+",
+            BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+            Name("d")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("c"))
+        Assign(Name("c"), Name("d"))
+        Assign(Name("d"), Name("e"))
+        Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+      ) => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("n" |-> (N:Int => 0))
+        ("a" |-> (A:Int => fib4Advance(N, A, B, C, D)))
+        ("b" |-> (B:Int => ?BFinal:Int))
+        ("c" |-> (C:Int => ?CFinal:Int))
+        ("d" |-> (D:Int => ?DFinal:Int))
+        ("e" |-> (E:Int => ?EFinal:Int)),
+        P:Parent)
+      ...
+    </scopes>
+    requires N >=Int 0
+
+  // Exact source-level invocation boundary: lookup is pinned to the translated
+  // fib4 closure, and the supplied semantics executes its complete body.
+  claim [fib4-correct]:
+    <k>
+      Call(Name("fib4"), Int(N:Int))
+      =>
+      fib4Advance(N, 0, 0, 2, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fib4" |-> closureVal(
+          "n",
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(0))
+          Assign(Name("c"), Int(2))
+          Assign(Name("d"), Int(0))
+          Assign(Name("e"), Int(0))
+          While(
+            Compare(Name("n"), CmpOp(">", Int(0))),
+            Assign(
+              Name("e"),
+              BinOp(
+                "+",
+                BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+                Name("d")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("d"), Name("e"))
+            Assign(Name("n"), BinOp("-", Name("n"), Int(1))))
+          Return(Name("a")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..dafbc4f9e93830ebdc78b4d7605853c5984eeade
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,37 @@
+from solution import fib4
+
+
+def contract_oracle(n: int) -> int:
+    values = [0, 0, 2, 0]
+    for i in range(4, n + 1):
+        values.append(
+            values[i - 1]
+            + values[i - 2]
+            + values[i - 3]
+            + values[i - 4]
+        )
+    return values[n]
+
+
+def main() -> None:
+    examples = {5: 4, 6: 8, 7: 14}
+    for n, expected in examples.items():
+        assert fib4(n) == expected
+
+    mismatches = []
+    for n in range(201):
+        actual = fib4(n)
+        expected = contract_oracle(n)
+        if actual != expected:
+            mismatches.append((n, actual, expected))
+
+    print("domain: n = 0..200")
+    print("oracle: direct prompt recurrence with stored prefix")
+    print(f"mismatches: {len(mismatches)}")
+    if mismatches:
+        print(mismatches[:10])
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e08ef800abd308b87fb46918cb342df3e47bd88e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT-SYNTAX
+
+  // Apply the loop's four-register transition N times and return register a.
+  syntax Int ::= fib4Advance(Int, Int, Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Totalization at N <= 0 agrees with zero iterations.  The proof uses N >= 0.
+  rule fib4Advance(N, A, _B, _C, _D) => A
+    requires N <=Int 0
+
+  rule fib4Advance(N, A, B, C, D)
+    => fib4Advance(N -Int 1, B, C, D, A +Int B +Int C +Int D)
+    requires N >Int 0
+endmodule

exec
/bin/bash -lc 'kprove spec-body-mutation.k --definition verification-kompiled --spec-module SPEC-BODY-MUTATION' in /workspace
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..f2a4670881556b34264a9438075037fd5e537826
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,26 @@
+def fib4(n: int):
+    a = 0
+    b = 0
+    c = 2
+    d = 0
+    e = 0
+
+    while n > 0:
+        e = a + b + c + d
+        a = b
+        b = c
+        c = d
+        d = e
+        n = n - 1
+
+    return a
+
+
+assert fib4(0) == 0
+assert fib4(1) == 0
+assert fib4(2) == 2
+assert fib4(3) == 0
+assert fib4(5) == 4
+assert fib4(6) == 8
+assert fib4(7) == 14
+assert fib4(10) == 104
