--- /dev/null
+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT-SYNTAX
+
+  // Apply the loop's four-register transition N times and return register a.
+  syntax Int ::= fib4Advance(Int, Int, Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Totalization at N <= 0 agrees with zero iterations.  The proof uses N >= 0.
+  rule fib4Advance(N, A, _B, _C, _D) => A
+    requires N <=Int 0
+
+  rule fib4Advance(N, A, B, C, D)
+    => fib4Advance(N -Int 1, B, C, D, A +Int B +Int C +Int D)
+    requires N >Int 0
+endmodule

