diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2f79bf6efcbf9dedea8e71ee8ddbb7d26c89b454
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,85 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Circularity at the recurring internal while-loop head.  The continuation
+  // and all configuration cells except the active local scope are framed.
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">", Int(0))),
+        Assign(
+          Name("e"),
+          BinOp(
+            "+",
+            BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+            Name("d")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("c"))
+        Assign(Name("c"), Name("d"))
+        Assign(Name("d"), Name("e"))
+        Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+      ) => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("n" |-> (N:Int => 0))
+        ("a" |-> (A:Int => fib4Advance(N, A, B, C, D)))
+        ("b" |-> (B:Int => ?BFinal:Int))
+        ("c" |-> (C:Int => ?CFinal:Int))
+        ("d" |-> (D:Int => ?DFinal:Int))
+        ("e" |-> (E:Int => ?EFinal:Int)),
+        P:Parent)
+      ...
+    </scopes>
+    requires N >=Int 0
+
+  // Exact source-level invocation boundary: lookup is pinned to the translated
+  // fib4 closure, and the supplied semantics executes its complete body.
+  claim [fib4-correct]:
+    <k>
+      Call(Name("fib4"), Int(N:Int))
+      =>
+      fib4Advance(N, 0, 0, 2, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fib4" |-> closureVal(
+          "n",
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(0))
+          Assign(Name("c"), Int(2))
+          Assign(Name("d"), Int(0))
+          Assign(Name("e"), Int(0))
+          While(
+            Compare(Name("n"), CmpOp(">", Int(0))),
+            Assign(
+              Name("e"),
+              BinOp(
+                "+",
+                BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+                Name("d")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("d"), Name("e"))
+            Assign(Name("n"), BinOp("-", Name("n"), Int(1))))
+          Return(Name("a")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
