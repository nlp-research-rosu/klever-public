LINE 193 apply_patch: "*** Begin Patch\n*** Add File: /workspace/spec-vacuity.k\n+requires \"spec.k\"\n+\n+module SPEC-VACUITY\n+  imports SPEC\n+\n+  // Deliberately false at the realizable witness n = 0: the correct result is 0.\n+  claim [fib4-wrong-result]:\n+    <k>\n+      Call(Name(\"fib4\"), Int(0))\n+      =>\n+      1\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      0 |-> scope(\n+        \"fib4\" |-> closureVal(\n+          \"n\",\n+          Assign(Name(\"a\"), Int(0))\n+          Assign(Name(\"b\"), Int(0))\n+          Assign(Name(\"c\"), Int(2))\n+          Assign(Name(\"d\"), Int(0))\n+          Assign(Name(\"e\"), Int(0))\n+          While(\n+            Compare(Name(\"n\"), CmpOp(\">\", Int(0))),\n+            Assign(\n+              Name(\"e\"),\n+              BinOp(\n+                \"+\",\n+                BinOp(\"+\", BinOp(\"+\", Name(\"a\"), Name(\"b\")), Name(\"c\")),\n+                Name(\"d\")))\n+            Assign(Name(\"a\"), Name(\"b\"))\n+            Assign(Name(\"b\"), Name(\"c\"))\n+            Assign(Name(\"c\"), Name(\"d\"))\n+            Assign(Name(\"d\"), Name(\"e\"))\n+            Assign(Name(\"n\"), BinOp(\"-\", Name(\"n\"), Int(1))))\n+          Return(Name(\"a\")),\n+          0),\n+        parent(-1))\n+      -1 |-> builtinsScope\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map </heap>\n+    <heapLoc> 0 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+endmodule\n*** End Patch\n"
