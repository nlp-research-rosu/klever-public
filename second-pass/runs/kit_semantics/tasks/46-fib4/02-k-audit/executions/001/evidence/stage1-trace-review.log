LINE 180 apply_patch: "*** Begin Patch\n*** Add File: /workspace/smoke.py\n+def fib4(n: int):\n+    a = 0\n+    b = 0\n+    c = 2\n+    d = 0\n+    e = 0\n+\n+    while n > 0:\n+        e = a + b + c + d\n+        a = b\n+        b = c\n+        c = d\n+        d = e\n+        n = n - 1\n+\n+    return a\n+\n+\n+assert fib4(0) == 0\n+assert fib4(1) == 0\n+assert fib4(2) == 2\n+assert fib4(3) == 0\n+assert fib4(5) == 4\n+assert fib4(6) == 8\n+assert fib4(7) == 14\n+assert fib4(10) == 104\n*** Add File: /workspace/test_solution.py\n+from solution import fib4\n+\n+\n+def contract_oracle(n: int) -> int:\n+    values = [0, 0, 2, 0]\n+    for i in range(4, n + 1):\n+        values.append(\n+            values[i - 1]\n+            + values[i - 2]\n+            + values[i - 3]\n+            + values[i - 4]\n+        )\n+    return values[n]\n+\n+\n+def main() -> None:\n+    examples = {5: 4, 6: 8, 7: 14}\n+    for n, expected in examples.items():\n+        assert fib4(n) == expected\n+\n+    mismatches = []\n+    for n in range(201):\n+        actual = fib4(n)\n+        expected = contract_oracle(n)\n+        if actual != expected:\n+            mismatches.append((n, actual, expected))\n+\n+    print(\"domain: n = 0..200\")\n+    print(\"oracle: direct prompt recurrence with stored prefix\")\n+    print(f\"mismatches: {len(mismatches)}\")\n+    if mismatches:\n+        print(mismatches[:10])\n+        raise SystemExit(1)\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n*** End Patch\n"
