LINE 94 apply_patch: "*** Begin Patch\n*** Add File: /workspace/verification.k\n+requires \"reference-semantics/semantics.k\"\n+\n+module VERIFICATION-SYNTAX\n+  imports MPY-SYNTAX\n+  imports INT-SYNTAX\n+\n+  // Apply the loop's four-register transition N times and return register a.\n+  syntax Int ::= fib4Advance(Int, Int, Int, Int, Int) [function, total]\n+endmodule\n+\n+module VERIFICATION\n+  imports MPY\n+  imports VERIFICATION-SYNTAX\n+\n+  // Totalization at N <= 0 agrees with zero iterations.  The proof uses N >= 0.\n+  rule fib4Advance(N, A, _B, _C, _D) => A\n+    requires N <=Int 0\n+\n+  rule fib4Advance(N, A, B, C, D)\n+    => fib4Advance(N -Int 1, B, C, D, A +Int B +Int C +Int D)\n+    requires N >Int 0\n+endmodule\n*** Add File: /workspace/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Circularity at the recurring internal while-loop head.  The continuation\n+  // and all configuration cells except the active local scope are framed.\n+  claim [loop-invariant]:\n+    <k>\n+      #while(\n+        Compare(Name(\"n\"), CmpOp(\">\", Int(0))),\n+        Assign(\n+          Name(\"e\"),\n+          BinOp(\n+            \"+\",\n+            BinOp(\"+\", BinOp(\"+\", Name(\"a\"), Name(\"b\")), Name(\"c\")),\n+            Name(\"d\")))\n+        Assign(Name(\"a\"), Name(\"b\"))\n+        Assign(Name(\"b\"), Name(\"c\"))\n+        Assign(Name(\"c\"), Name(\"d\"))\n+        Assign(Name(\"d\"), Name(\"e\"))\n+        Assign(Name(\"n\"), BinOp(\"-\", Name(\"n\"), Int(1)))\n+      ) => .K\n+      ...\n+    </k>\n+    <env> L:Int </env>\n+    <scopes>\n+      ...\n+      L |-> scope(\n+        (\"n\" |-> (N:Int => 0))\n+        (\"a\" |-> (A:Int => fib4Advance(N, A, B, C, D)))\n+        (\"b\" |-> (B:Int => ?BFinal:Int))\n+        (\"c\" |-> (C:Int => ?CFinal:Int))\n+        (\"d\" |-> (D:Int => ?DFinal:Int))\n+        (\"e\" |-> (E:Int => ?EFinal:Int)),\n+        P:Parent)\n+      ...\n+    </scopes>\n+    requires N >=Int 0\n+\n+  // Exact source-level invocation boundary: lookup is pinned to the translated\n+  // fib4 closure, and the supplied semantics executes its complete body.\n+  claim [fib4-correct]:\n+    <k>\n+      Call(Name(\"fib4\"), Int(N:Int))\n+      =>\n+      fib4Advance(N, 0, 0, 2, 0)\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      0 |-> scope(\n+        \"fib4\" |-> closureVal(\n+          \"n\",\n+          Assign(Name(\"a\"), Int(0))\n+          Assign(Name(\"b\"), Int(0))\n+          Assign(Name(\"c\"), Int(2))\n+          Assign(Name(\"d\"), Int(0))\n+          Assign(Name(\"e\"), Int(0))\n+          While(\n+            Compare(Name(\"n\"), CmpOp(\">\", Int(0))),\n+            Assign(\n+              Name(\"e\"),\n+              BinOp(\n+                \"+\",\n+                BinOp(\"+\", BinOp(\"+\", Name(\"a\"), Name(\"b\")), Name(\"c\")),\n+                Name(\"d\")))\n+            Assign(Name(\"a\"), Name(\"b\"))\n+            Assign(Name(\"b\"), Name(\"c\"))\n+            Assign(Name(\"c\"), Name(\"d\"))\n+            Assign(Name(\"d\"), Name(\"e\"))\n+            Assign(Name(\"n\"), BinOp(\"-\", Name(\"n\"), Int(1))))\n+          Return(Name(\"a\")),\n+          0),\n+        parent(-1))\n+      -1 |-> builtinsScope\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map </heap>\n+    <heapLoc> 0 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires N >=Int 0\n+endmodule\n*** End Patch\n"
