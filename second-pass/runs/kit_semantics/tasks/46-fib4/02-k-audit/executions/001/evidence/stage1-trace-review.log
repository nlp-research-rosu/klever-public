LINE 208 apply_patch: "*** Begin Patch\n*** Add File: /workspace/spec-body-mutation.k\n+requires \"spec.k\"\n+\n+module SPEC-BODY-MUTATION\n+  imports SPEC\n+\n+  // Material mutation: c starts at 3 instead of 2.  At n = 2 this body returns\n+  // 3, so the original contract result 2 must no longer be provable.\n+  claim [mutated-body-rejected]:\n+    <k>\n+      Call(Name(\"fib4\"), Int(2))\n+      =>\n+      2\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      0 |-> scope(\n+        \"fib4\" |-> closureVal(\n+          \"n\",\n+          Assign(Name(\"a\"), Int(0))\n+          Assign(Name(\"b\"), Int(0))\n+          Assign(Name(\"c\"), Int(3))\n+          Assign(Name(\"d\"), Int(0))\n+          Assign(Name(\"e\"), Int(0))\n+          While(\n+            Compare(Name(\"n\"), CmpOp(\">\", Int(0))),\n+            Assign(\n+              Name(\"e\"),\n+              BinOp(\n+                \"+\",\n+                BinOp(\"+\", BinOp(\"+\", Name(\"a\"), Name(\"b\")), Name(\"c\")),\n+                Name(\"d\")))\n+            Assign(Name(\"a\"), Name(\"b\"))\n+            Assign(Name(\"b\"), Name(\"c\"))\n+            Assign(Name(\"c\"), Name(\"d\"))\n+            Assign(Name(\"d\"), Name(\"e\"))\n+            Assign(Name(\"n\"), BinOp(\"-\", Name(\"n\"), Int(1))))\n+          Return(Name(\"a\")),\n+          0),\n+        parent(-1))\n+      -1 |-> builtinsScope\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map </heap>\n+    <heapLoc> 0 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+endmodule\n*** End Patch\n"
