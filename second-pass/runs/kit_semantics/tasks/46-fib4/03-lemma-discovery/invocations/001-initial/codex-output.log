+    },
+    {
+      "source_rule_id": "rule-d44d71dd060859619764bc0fe005a75f61253b9f2ffa46e35b48b4b028aaeca1",
+      "classification": "DEFINITION",
+      "rationale": "This guarded, descending recurrence defines fib4Spec for N >= 4 as the sum of its preceding four values; it is the defining recurrence of the mathematical summary, not an extra algebraic fact or an execution rule."
+    }
+  ]
+}

