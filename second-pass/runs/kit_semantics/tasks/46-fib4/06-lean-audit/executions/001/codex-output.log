     1	def fib4(n: int):
     2	    a = 0
     3	    b = 0
     4	    c = 2
     5	    d = 0
     6	    e = 0
     7	    i = 0
     8	
     9	    while i < n:
    10	        e = a + b + c + d
    11	        a = b
    12	        b = c
    13	        c = d
    14	        d = e
    15	        i = i + 1
    16	
    17	    return a

