+def dictEqual
+    (leftKeys leftValues rightKeys rightValues : SortValSeq) : Bool :=
+  (valSeqLength leftKeys == valSeqLength rightKeys) &&
+    dictSubset leftKeys leftValues rightKeys rightValues
