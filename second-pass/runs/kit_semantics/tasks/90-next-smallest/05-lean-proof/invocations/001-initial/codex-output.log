+def applyBinComplete (operator : String) (left right : SortVal) : SortVal :=
+  if operator == "+" then
+    match stringCodes? left, stringCodes? right with
+    | some leftCodes, some rightCodes =>
+        makeStringValue (intSeqAppend leftCodes rightCodes)
