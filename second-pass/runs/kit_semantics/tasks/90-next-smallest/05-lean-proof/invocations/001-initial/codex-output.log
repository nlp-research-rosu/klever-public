    | SortVal.inj_SortStr x => some (SortIterable.inj_SortStr x)
    | SortVal.inj_SortIterable x => some x
    | _ => none

instance : Inj SortStr SortVal where
  inj := SortVal.inj_SortStr
  retr
    | SortVal.inj_SortStr x => some x
    | _ => none
