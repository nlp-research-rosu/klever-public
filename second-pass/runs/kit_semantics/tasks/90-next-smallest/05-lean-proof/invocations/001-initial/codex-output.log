+def dictHasKey : SortValSeq → SortVal → Bool
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq», _ => false
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» candidate rest, key =>
+      valStructuralEq candidate key || dictHasKey rest key
