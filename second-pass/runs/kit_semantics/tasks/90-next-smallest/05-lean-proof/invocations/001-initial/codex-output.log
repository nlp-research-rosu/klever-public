+import Proof
+
+open ProofOperational
+
+def intValue? : SortVal → Option Int
+  | SortVal.inj_SortInt value => some value
+  | _ => none
+
+def floatValue? : SortVal → Option Float
+  | SortVal.inj_SortFloat value => some value
+  | _ => none
+
+def ints : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | x :: xs => SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (ints xs)
+
+def vals : List SortVal → SortValSeq
+  | [] => SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+  | x :: xs => SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» x (vals xs)
+
+def strVal (codes : List Int) : SortVal := makeStringValue (ints codes)
+def listVal (values : List SortVal) : SortVal :=
+  SortVal.inj_SortIterable (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» (vals values))
+def tupleVal (values : List SortVal) : SortVal :=
+  SortVal.inj_SortIterable (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» (vals values))
+
+#eval [
+  intValue? (applyBinComplete "%" (SortVal.inj_SortInt (-3)) (SortVal.inj_SortInt 2)) == some 1,
+  intValue? (applyBinComplete "%" (SortVal.inj_SortInt 3) (SortVal.inj_SortInt (-2))) == some (-1),
+  intValue? (applyBinComplete "//" (SortVal.inj_SortInt (-3)) (SortVal.inj_SortInt 2)) == some (-2),
+  intValue? (applyBinComplete "//" (SortVal.inj_SortInt 3) (SortVal.inj_SortInt (-2))) == some (-2),
+  intValue? (applyBinComplete "+" (SortVal.inj_SortBool true) (SortVal.inj_SortInt 4)) == some 5,
+  floatValue? (applyBinComplete "%" (SortVal.inj_SortFloat 3.5) (SortVal.inj_SortFloat 1.0)) == some 0.5,
+  applyCmpComplete "<" (strVal [97]) (strVal [98]),
+  applyCmpComplete "in" (strVal [98]) (strVal [97, 98, 99]),
+  applyCmpComplete "==" (listVal [SortVal.inj_SortBool true, strVal [97]])
+    (listVal [SortVal.inj_SortBool true, strVal [97]]),
+  applyCmpComplete "!=" (tupleVal [SortVal.inj_SortInt 1])
+    (tupleVal [SortVal.inj_SortInt 2]),
+  applyCmpComplete "==" (SortVal.«setV(_)_MPY-SET_Val_IntSeq» (ints [1, 2]))
+    (SortVal.«setV(_)_MPY-SET_Val_IntSeq» (ints [2, 1])),
+  applyCmpComplete "is" SortVal.«noneV_MPY-CORE_Val» SortVal.«noneV_MPY-CORE_Val»,
+  applyCmpComplete "is not" (SortVal.inj_SortInt 0) SortVal.«noneV_MPY-CORE_Val»
+]
+
+def dictA : SortVal := SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq»
+  (vals [SortVal.inj_SortInt 1, SortVal.inj_SortInt 2])
+  (vals [strVal [97], strVal [98]])
+def dictB : SortVal := SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq»
+  (vals [SortVal.inj_SortInt 2, SortVal.inj_SortInt 1])
+  (vals [strVal [98], strVal [97]])
+
+#eval applyCmpComplete "==" dictA dictB
+#eval let nan := (0.0 : Float) / 0.0
+  (applyCmpComplete ">=" (SortVal.inj_SortFloat nan) (SortVal.inj_SortFloat 1.0),
+   applyCmpComplete "<=" (SortVal.inj_SortFloat nan) (SortVal.inj_SortFloat 1.0))

