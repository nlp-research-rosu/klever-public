+      | SortVal.inj_SortBool l, SortVal.inj_SortInt r => SortVal.inj_SortInt (boolInt l + r)
+      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => SortVal.inj_SortFloat (l + r)
