+      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => l > r
+      | SortVal.inj_SortInt l, SortVal.inj_SortFloat r => intAsFloat l > r
+      | SortVal.inj_SortFloat l, SortVal.inj_SortInt r => l > intAsFloat r
