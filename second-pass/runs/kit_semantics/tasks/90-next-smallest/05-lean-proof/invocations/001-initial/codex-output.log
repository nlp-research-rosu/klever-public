new file mode 100644
index 0000000000000000000000000000000000000000..36d6145707b4bb56325e8b1d1a304f899446e5fe
--- /dev/null
+++ b//tmp/lean_app_path.c
@@ -0,0 +1,34 @@
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+
+int uv_exepath(char *buffer, size_t *size) {
+  static const char path[] =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+  const size_t length = sizeof(path) - 1;
+  if (*size <= length) {
+    *size = length + 1;
+    return -105;
+  }
+  memcpy(buffer, path, length + 1);
+  *size = length;
+  return 0;
+}
+
+int lean_uv_exepath(char *buffer, size_t *size) {
+  return uv_exepath(buffer, size);
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static const char executable[] =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+  const size_t length = sizeof(executable) - 1;
+  if (strncmp(path, "/proc/", 6) == 0 && strstr(path, "/exe") != NULL) {
+    if (size < length) {
+      return (ssize_t)size;
+    }
+    memcpy(buffer, executable, length);
+    return (ssize_t)length;
+  }
+  return -1;
+}
