/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
assert len(out['rules']) == len(inventory['rules']) == 32
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inventory['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == 32
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
by_id = {}
for entry in out['rules']:
    assert list(entry) == ['source_rule_id', 'classification', 'rationale'], entry
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
    by_id[entry['source_rule_id']] = entry['classification']
for rule in inventory['rules']:
    if any(a == 'simplification' or a.startswith('simplification(') for a in rule['attributes']):
        assert by_id[rule['source_rule_id']] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(e['classification'] for e in out['rules'])
assert counts == Counter({'DEFINITION': 27, 'DOMAIN_LEMMA': 5}), counts
expected_domain = {
  'rule-0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43',
  'rule-22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d',
  'rule-3efffca8ed723c4a95578d5fda655b02240729a8ee1b5bd9b6eaab14655f86c0',
  'rule-d010c14fc64f0f33dd28b1ec00706ade9980faa201a1db3fac9d2f2e55a066e0',
  'rule-d3f3513c93e027de881c4a1afcfdd26ca1202897eb3fd37f1be702df77bc49a5',
}
assert {k for k,v in by_id.items() if v == 'DOMAIN_LEMMA'} == expected_domain
md = Path('/workspace/DISCOVERY.md').read_text()
assert 'There are no separately proved derived lemmas.' in md
assert 'domain-lemma set is **not empty**' in md
for rule_id in expected_domain:
    assert rule_id in md
print('schema_version:', out['schema_version'])
print('inventory_sha256:', out['inventory_sha256'])
print('rules:', len(out['rules']))
print('classifications:', dict(sorted(counts.items())))
print('canonical order and exact-once coverage: PASS')
print('simplification restriction: PASS')
print('discovery evidence statements: PASS')
