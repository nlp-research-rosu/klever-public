     6	  // The exact translated program and its two statement blocks.  Keeping these
     7	  // as constructor-valued functions makes the invocation claim bind the real
     8	  // function body while keeping the loop circularity readable.
     9	  syntax Stmts ::= "nextSmallestLoopBody" [function]
    10	  rule nextSmallestLoopBody =>
    11	    Assign(Name("x"), BinOp("+", Name("x"), Int(0)))
    12	    If(UnaryOp("not", Name("found_smallest")),
    13	      Assign(Name("smallest"), Name("x"))
    14	      Assign(Name("found_smallest"), Bool(true)),
    15	      If(Compare(Name("x"), CmpOp("<", Name("smallest"))),
    16	        Assign(Name("second"), Name("smallest"))
    17	        Assign(Name("found_second"), Bool(true))
    18	        Assign(Name("smallest"), Name("x")),
    19	        If(BoolOp(
    20	          "and",
    21	          Compare(Name("x"), CmpOp("!=", Name("smallest"))),
    22	          BoolOp(
    23	            "or",
    24	            UnaryOp("not", Name("found_second")),
    25	            Compare(Name("x"), CmpOp("<", Name("second"))))),
    26	          Assign(Name("second"), Name("x"))
    27	          Assign(Name("found_second"), Bool(true)),
    28	          .Stmts)))
