   241	    match stringCodes? left, stringCodes? right with
   242	    | some leftCodes, some rightCodes =>
   243	        makeStringValue (intSeqAppend leftCodes rightCodes)
   244	    | _, _ =>
   245	      match left, right with
   246	      | SortVal.inj_SortInt l, SortVal.inj_SortInt r => SortVal.inj_SortInt (l + r)
   247	      | SortVal.inj_SortInt l, SortVal.inj_SortBool r => SortVal.inj_SortInt (l + boolInt r)
   248	      | SortVal.inj_SortBool l, SortVal.inj_SortInt r => SortVal.inj_SortInt (boolInt l + r)
   249	      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => SortVal.inj_SortFloat (l + r)
   250	      | SortVal.inj_SortInt l, SortVal.inj_SortFloat r => SortVal.inj_SortFloat (intAsFloat l + r)
   251	      | SortVal.inj_SortFloat l, SortVal.inj_SortInt r => SortVal.inj_SortFloat (l + intAsFloat r)
   252	      | _, _ => undefinedBinValue
   253	  else if operator == "-" then
   254	    match left, right with
   255	    | SortVal.inj_SortInt l, SortVal.inj_SortInt r => SortVal.inj_SortInt (l - r)
   256	    | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => SortVal.inj_SortFloat (l - r)
   257	    | SortVal.inj_SortInt l, SortVal.inj_SortFloat r => SortVal.inj_SortFloat (intAsFloat l - r)
   258	    | SortVal.inj_SortFloat l, SortVal.inj_SortInt r => SortVal.inj_SortFloat (l - intAsFloat r)
   259	    | _, _ => undefinedBinValue
   260	  else if operator == "*" then
   261	    match left, right with
   262	    | SortVal.inj_SortInt l, SortVal.inj_SortInt r => SortVal.inj_SortInt (l * r)
   263	    | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => SortVal.inj_SortFloat (l * r)
   264	    | SortVal.inj_SortInt l, SortVal.inj_SortFloat r => SortVal.inj_SortFloat (intAsFloat l * r)
   265	    | SortVal.inj_SortFloat l, SortVal.inj_SortInt r => SortVal.inj_SortFloat (l * intAsFloat r)
   266	    | _, _ => undefinedBinValue
   267	  else if operator == "%" then
   268	    match left, right with
   269	    | SortVal.inj_SortInt l, SortVal.inj_SortInt r =>
   270	        if r == 0 then undefinedBinValue else SortVal.inj_SortInt (pythonIntMod l r)
   271	    | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r =>
   272	        SortVal.inj_SortFloat (pythonFloatMod l r)
   273	    | _, _ => undefinedBinValue
   274	  else if operator == "//" then
   275	    match left, right with
   276	    | SortVal.inj_SortInt l, SortVal.inj_SortInt r =>
   277	        if r == 0 then undefinedBinValue else SortVal.inj_SortInt (pythonIntFloorDiv l r)
   278	    | _, _ => undefinedBinValue
   279	  else if operator == "/" then
   280	    match left, right with
   281	    | SortVal.inj_SortInt l, SortVal.inj_SortInt r =>
   282	        SortVal.inj_SortFloat (intAsFloat l / intAsFloat r)
   283	    | SortVal.inj_SortInt l, SortVal.inj_SortFloat r =>
   284	        SortVal.inj_SortFloat (intAsFloat l / r)
   285	    | SortVal.inj_SortFloat l, SortVal.inj_SortInt r =>
   286	        SortVal.inj_SortFloat (l / intAsFloat r)
   287	    | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r =>
   288	        SortVal.inj_SortFloat (l / r)
   289	    | _, _ => undefinedBinValue
   290	  else if operator == "**" then
   291	    match left, right with
   292	    | SortVal.inj_SortInt l, SortVal.inj_SortInt r =>
   293	        if r < 0 then undefinedBinValue else SortVal.inj_SortInt (intPower l r)
   294	    | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r =>
   295	        SortVal.inj_SortFloat (Float.pow l r)
   296	    | SortVal.inj_SortInt l, SortVal.inj_SortFloat r =>
   297	        SortVal.inj_SortFloat (Float.pow (intAsFloat l) r)
   298	    | SortVal.inj_SortFloat l, SortVal.inj_SortInt r =>
