   303	def applyCmpComplete (operator : String) (left right : SortVal) : Bool :=
   304	  if operator == "is" then
   305	    if isNoneValue right then isNoneValue left else false
   306	  else if operator == "is not" then
   307	    if isNoneValue right then !isNoneValue left else false
   308	  else if operator == "==" then
   309	    if isNoneValue right then isNoneValue left else
   310	    match stringCodes? left, stringCodes? right with
   311	    | some l, some r => intSeqEq l r
   312	    | _, _ =>
   313	      match left, right with
   314	      | SortVal.inj_SortInt l, SortVal.inj_SortInt r => l == r
   315	      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => l == r
   316	      | SortVal.inj_SortInt l, SortVal.inj_SortFloat r => intAsFloat l == r
   317	      | SortVal.inj_SortFloat l, SortVal.inj_SortInt r => l == intAsFloat r
   318	      | SortVal.inj_SortBool l, SortVal.inj_SortBool r => l == r
   319	      | SortVal.inj_SortIterable (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» l),
   320	          SortVal.inj_SortIterable (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» r) =>
   321	          valSeqStructuralEq l r
   322	      | SortVal.inj_SortIterable (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» l),
   323	          SortVal.inj_SortIterable (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» r) =>
   324	          valSeqStructuralEq l r
   325	      | SortVal.«setV(_)_MPY-SET_Val_IntSeq» l,
   326	          SortVal.«setV(_)_MPY-SET_Val_IntSeq» r => sameSetCodes l r
   327	      | SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» lk lv,
   328	          SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» rk rv =>
   329	          dictEqual lk lv rk rv
   330	      | _, _ => false
   331	  else if operator == "!=" then
   332	    if isNoneValue right then !isNoneValue left else
   333	    match stringCodes? left, stringCodes? right with
   334	    | some l, some r => !intSeqEq l r
   335	    | _, _ =>
   336	      match left, right with
   337	      | SortVal.inj_SortInt l, SortVal.inj_SortInt r => l != r
   338	      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => !(l == r)
   339	      | SortVal.inj_SortInt l, SortVal.inj_SortFloat r => !(intAsFloat l == r)
   340	      | SortVal.inj_SortFloat l, SortVal.inj_SortInt r => !(l == intAsFloat r)
   341	      | SortVal.inj_SortBool l, SortVal.inj_SortBool r => l != r
   342	      | SortVal.inj_SortIterable (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» l),
   343	          SortVal.inj_SortIterable (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» r) =>
   344	          !valSeqStructuralEq l r
   345	      | SortVal.inj_SortIterable (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» l),
   346	          SortVal.inj_SortIterable (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» r) =>
   347	          !valSeqStructuralEq l r
   348	      | _, _ => false
   349	  else if operator == "<" then
   350	    match stringCodes? left, stringCodes? right with
   351	    | some l, some r => intSeqLt l r
   352	    | _, _ =>
   353	      match left, right with
   354	      | SortVal.inj_SortInt l, SortVal.inj_SortInt r => l < r
   355	      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => l < r
   356	      | SortVal.inj_SortInt l, SortVal.inj_SortFloat r => intAsFloat l < r
   357	      | SortVal.inj_SortFloat l, SortVal.inj_SortInt r => l < intAsFloat r
   358	      | _, _ => false
   359	  else if operator == ">" then
   360	    match stringCodes? left, stringCodes? right with
   361	    | some l, some r => intSeqLt r l
   362	    | _, _ =>
   363	      match left, right with
   364	      | SortVal.inj_SortInt l, SortVal.inj_SortInt r => l > r
   365	      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => l > r
   366	      | SortVal.inj_SortInt l, SortVal.inj_SortFloat r => intAsFloat l > r
   367	      | SortVal.inj_SortFloat l, SortVal.inj_SortInt r => l > intAsFloat r
   368	      | _, _ => false
   369	  else if operator == "<=" then
   370	    match stringCodes? left, stringCodes? right with
   371	    | some l, some r => !intSeqLt r l
   372	    | _, _ =>
   373	      match left, right with
   374	      | SortVal.inj_SortInt l, SortVal.inj_SortInt r => l <= r
   375	      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => !(l > r)
   376	      | _, _ => false
   377	  else if operator == ">=" then
   378	    match stringCodes? left, stringCodes? right with
   379	    | some l, some r => !intSeqLt l r
   380	    | _, _ =>
   381	      match left, right with
   382	      | SortVal.inj_SortInt l, SortVal.inj_SortInt r => l >= r
   383	      | SortVal.inj_SortFloat l, SortVal.inj_SortFloat r => !(l < r)
   384	      | _, _ => false
   385	  else if operator == "in" then
   386	    match stringCodes? left, stringCodes? right with
