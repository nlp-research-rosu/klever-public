+import Proof
+
+private def intVal (n : Int) : SortVal := SortVal.inj_SortInt n
+private def intK (n : Int) : SortK := SortK.kseq (SortKItem.inj_SortInt n) SortK.dotk
+
+-- Primitive parameters: ordinary and boundary-shaped cases.
+example : Proof._andBool_ true false = false := by native_decide
+example : Proof._andBool_ true true = true := by native_decide
+example : Proof.«_<Int_» (-7) 2 = true := by native_decide
+example : Proof.«_=/=Int_» 5 5 = false := by native_decide
+example : Proof.«_+Int_» (-7) 2 = -5 := by native_decide
+
+-- Projection bridge: accepts exactly integer values in the source-relevant domain.
+example : Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» (intVal (-11)) = true := by native_decide
+example : Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» SortVal.«noneV_MPY-CORE_Val» = false := by native_decide
+example : Proof.«project:Int?» (intK 42) = some 42 := by native_decide
+example : Proof.«project:Int?» (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = none := by native_decide
+example : Proof.projectIntTotal (intVal (-11)) = -11 := by native_decide
+example : Proof.«project:Int» (intK 42) = 42 := by native_decide
+example : Proof.isInt (SortK.kseq (SortKItem.inj_SortInt (-3)) SortK.dotk) = true := by native_decide
+example : Proof.isInt (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = false := by native_decide
+
+-- Source operations, including negatives and equality boundaries.
+example :
+    (match Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "+" (intVal (-7)) (intVal 2) with
+      | SortVal.inj_SortInt n => n == -5
+      | _ => false) = true := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intVal (-1)) (intVal 0) = true := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intVal 0) (intVal (-1)) = false := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "!=" (intVal 3) (intVal 3) = false := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "!=" (intVal 3) (intVal 4) = true := by native_decide
+
+-- Counterfactual operators: catches definitions hard-coded only to the target equations.
+example :
+    (match Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "-" (intVal 7) (intVal 2) with
+      | SortVal.inj_SortInt n => n == 5
+      | _ => false) = true := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">" (intVal 7) (intVal 2) = true := by native_decide
diff --git a//tmp/audit-work/stage5-90-next-smallest-audit-001/AuditMutations.lean b//tmp/audit-work/stage5-90-next-smallest-audit-001/AuditMutations.lean
