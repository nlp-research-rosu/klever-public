+env PYTHONPATH=/reference AUDIT_LEAN_EXE_PATH=/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean LD_PRELOAD=/tmp/audit-work/libaudit_proc_exe.so python3 /audit-output/evidence/run_preflight.py
