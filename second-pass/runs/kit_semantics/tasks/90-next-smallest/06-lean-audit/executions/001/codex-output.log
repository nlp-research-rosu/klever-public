+++ b//tmp/audit-work/stage5-90-next-smallest-audit-001/AuditBridge.lean
@@ -0,0 +1,38 @@
+import Proof
+
+private def intVal (n : Int) : SortVal := SortVal.inj_SortInt n
+private def intK (n : Int) : SortK := SortK.kseq (SortKItem.inj_SortInt n) SortK.dotk
+
+-- Primitive parameters: ordinary and boundary-shaped cases.
+example : Proof._andBool_ true false = false := by native_decide
+example : Proof._andBool_ true true = true := by native_decide
+example : Proof.«_<Int_» (-7) 2 = true := by native_decide
+example : Proof.«_=/=Int_» 5 5 = false := by native_decide
+example : Proof.«_+Int_» (-7) 2 = -5 := by native_decide
+
+-- Projection bridge: accepts exactly integer values in the source-relevant domain.
+example : Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» (intVal (-11)) = true := by native_decide
+example : Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» SortVal.«noneV_MPY-CORE_Val» = false := by native_decide
+example : Proof.«project:Int?» (intK 42) = some 42 := by native_decide
+example : Proof.«project:Int?» (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = none := by native_decide
+example : Proof.projectIntTotal (intVal (-11)) = -11 := by native_decide
+example : Proof.«project:Int» (intK 42) = 42 := by native_decide
+example : Proof.isInt (SortK.kseq (SortKItem.inj_SortInt (-3)) SortK.dotk) = true := by native_decide
+example : Proof.isInt (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = false := by native_decide
+
+-- Source operations, including negatives and equality boundaries.
+example :
+    (match Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "+" (intVal (-7)) (intVal 2) with
+      | SortVal.inj_SortInt n => n == -5
+      | _ => false) = true := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intVal (-1)) (intVal 0) = true := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intVal 0) (intVal (-1)) = false := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "!=" (intVal 3) (intVal 3) = false := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "!=" (intVal 3) (intVal 4) = true := by native_decide
+
+-- Counterfactual operators: catches definitions hard-coded only to the target equations.
+example :
+    (match Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "-" (intVal 7) (intVal 2) with
+      | SortVal.inj_SortInt n => n == 5
+      | _ => false) = true := by native_decide
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">" (intVal 7) (intVal 2) = true := by native_decide
diff --git a//tmp/audit-work/stage5-90-next-smallest-audit-001/AuditMutations.lean b//tmp/audit-work/stage5-90-next-smallest-audit-001/AuditMutations.lean
new file mode 100644
index 0000000000000000000000000000000000000000..91efff2aca67f107e4fd2c03dfec79a9fc13ddc3
--- /dev/null
+++ b//tmp/audit-work/stage5-90-next-smallest-audit-001/AuditMutations.lean
@@ -0,0 +1,53 @@
+import Proof
+
+private def intVal (n : Int) : SortVal := SortVal.inj_SortInt n
+
+-- Deliberately convenient counterfactuals.
+private def constantFalseAnd (_ _ : SortBool) : SortBool := false
+private def constantZeroAdd (_ _ : SortInt) : SortInt := 0
+private def constantFalseCmp (_ : SortString) (_ _ : SortVal) : SortBool := false
+private def constantFalseDefined (_ : SortVal) : SortBool := false
+
+-- A false conjunction implementation would make each guarded dispatch
+-- obligation vacuous; the operational-bridge audit must therefore reject it.
+example (P : SortVal → SortBool) :
+    ∀ V W, constantFalseAnd (P V) (P W) = true → False := by
+  intro V W h
+  simp [constantFalseAnd] at h
+
+example : Proof._andBool_ true true ≠ constantFalseAnd true true := by
+  native_decide
+
+-- With the honest conjunction and integer recognizer, a constant addition
+-- cannot satisfy the fixed generated theorem.
+example : ¬ Klean90NextSmallest.Lemmas.targetStatement
+    Proof._andBool_ Proof.«_<Int_» Proof.«_=/=Int_» constantZeroAdd
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» Proof.isInt
+    Proof.«project:Int» Proof.projectIntTotal Proof.«project:Int?» := by
+  intro target
+  have counterexample := target.2.2.1 (intVal 2) (intVal 1) (by native_decide)
+  simp [intVal, constantZeroAdd, Proof.projectIntTotal,
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»,
+    ProofOperational.applyBinComplete, ProofOperational.stringCodes?] at counterexample
+
+-- A constant comparison likewise fails the strict-less-than obligation.
+example : ¬ Klean90NextSmallest.Lemmas.targetStatement
+    Proof._andBool_ Proof.«_<Int_» Proof.«_=/=Int_» Proof.«_+Int_»
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» constantFalseCmp
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» Proof.isInt
+    Proof.«project:Int» Proof.projectIntTotal Proof.«project:Int?» := by
+  intro target
+  have counterexample := target.2.2.2.1 (intVal 0) (intVal (-1)) (by native_decide)
+  simp [intVal, constantFalseCmp, Proof.projectIntTotal, Proof.«_<Int_»] at counterexample
+
+-- A predicate chosen to falsify the cast guard cannot satisfy the Ceil bridge.
+example : ¬ Klean90NextSmallest.Lemmas.targetStatement
+    Proof._andBool_ Proof.«_<Int_» Proof.«_=/=Int_» Proof.«_+Int_»
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» constantFalseDefined
+    Proof.isInt Proof.«project:Int» Proof.projectIntTotal Proof.«project:Int?» := by
+  intro target
+  have counterexample := target.1 (intVal 1)
+  simp [intVal, constantFalseDefined, Proof.«project:Int?», inj] at counterexample
