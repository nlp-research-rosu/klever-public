     1	def next_smallest(lst):
     2	    """
     3	    Return the second-smallest distinct integer in lst, or None when it
     4	    does not exist.
     5	    """
     6	    found_smallest = False
     7	    found_second = False
     8	    smallest = 0
     9	    second = 0
    10	    x = 0
    11	
    12	    for x in lst:
    13	        # Keep the loop variable in the semantics' integer subsort.  For the
    14	        # promised integer inputs this is the identity operation.
    15	        x = x + 0
    16	
    17	        if not found_smallest:
    18	            smallest = x
    19	            found_smallest = True
    20	        elif x < smallest:
    21	            second = smallest
    22	            found_second = True
    23	            smallest = x
    24	        elif x != smallest and (not found_second or x < second):
    25	            second = x
    26	            found_second = True
    27	
    28	    if found_second:
    29	        return second
    30	    return None
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Loop circularity: scanVS describes exactly the accumulator state after
     7	  // consuming the arbitrary finite suffix VS.
     8	  claim [loop-invariant]:
     9	    <k> #loop(list(VS:ValSeq), Name("x"), nextSmallestLoopBody)
    10	        => .K ... </k>
    11	    <env> L:Int </env>
    12	    <scopes>
    13	      ... L |-> scope(
    14	        "lst" |-> list(ORIG:ValSeq)
    15	        "found_smallest" |->
    16	          (HA:Bool => scanFoundSmallest(scanVS(VS, A, HA, B, HB)))
    17	        "found_second" |->
    18	          (HB:Bool => scanFoundSecond(scanVS(VS, A, HA, B, HB)))
    19	        "smallest" |->
    20	          (A:Int => scanSmallest(scanVS(VS, A, HA, B, HB)))
    21	        "second" |->
    22	          (B:Int => scanSecond(scanVS(VS, A, HA, B, HB)))
    23	        "x" |-> (X0:Int => lastInt(VS, X0)),
    24	        parent(0)) ...
    25	    </scopes>
    26	    requires allInts(VS)
    27	
    28	  // Whole-function target theorem, from exact name binding and exact body.
    29	  claim [next-smallest]:
    30	    <k> #loadAll(solutionProgram)
    31	         ~> Call(Name("next_smallest"), (list(VS:ValSeq), .Exprs))
    32	        => nextSmallestSpec(VS) </k>
    33	    <env> 0 </env>
    34	    <scopes>
    35	      0 |-> (scope(.Map, parent(-1))
    36	             => scope(
    37	                  "next_smallest" |->
    38	                    closureVal(("lst", .ParamNames), nextSmallestBody, 0),
    39	                  parent(-1)))
    40	      -1 |-> builtinsScope
    41	    </scopes>
    42	    <scopeLoc> 1 </scopeLoc>
    43	    <heap> .Map </heap>
    44	    <heapLoc> 0 </heapLoc>
    45	    <stack> .List </stack>
    46	    <ret> noRet </ret>
    47	    <exc> NoExc </exc>
    48	    <exit-code> 0 </exit-code>
    49	    requires allInts(VS)
    50	endmodule
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
     6	
     7	python3 - <<'PY'
     8	import ast
     9	import itertools
    10	import random
    11	from pathlib import Path
    12	
    13	from solution import next_smallest
    14	
    15	
    16	def first_function(path):
    17	    tree = ast.parse(Path(path).read_text(encoding="utf-8"))
    18	    return ast.dump(
    19	        next(node for node in tree.body if isinstance(node, ast.FunctionDef)),
    20	        include_attributes=False,
    21	    )
    22	
    23	
    24	def oracle(values):
    25	    distinct = sorted(set(values))
    26	    return distinct[1] if len(distinct) >= 2 else None
    27	
    28	
    29	assert first_function("solution.py") == first_function("concrete_tests.py")
    30	print("concrete harness function AST identity: PASS")
    31	
    32	exhaustive_count = 0
    33	for length in range(7):
    34	    for values in itertools.product(range(-2, 3), repeat=length):
    35	        values = list(values)
    36	        assert next_smallest(values) == oracle(values)
    37	        exhaustive_count += 1
    38	
    39	rng = random.Random(20260731)
    40	random_count = 10000
    41	for _ in range(random_count):
    42	    values = [rng.randint(-10**12, 10**12)
    43	              for _ in range(rng.randint(0, 40))]
    44	    assert next_smallest(values) == oracle(values)
    45	
    46	print(
    47	    "python differential: PASS "
    48	    f"({exhaustive_count} exhaustive + {random_count} seeded random; "
    49	    "mismatches=0)"
    50	)
