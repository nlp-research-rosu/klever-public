@@ -0,0 +1,53 @@
+import Proof
+
+private def intVal (n : Int) : SortVal := SortVal.inj_SortInt n
+
+-- Deliberately convenient counterfactuals.
+private def constantFalseAnd (_ _ : SortBool) : SortBool := false
+private def constantZeroAdd (_ _ : SortInt) : SortInt := 0
+private def constantFalseCmp (_ : SortString) (_ _ : SortVal) : SortBool := false
+private def constantFalseDefined (_ : SortVal) : SortBool := false
+
+-- A false conjunction implementation would make each guarded dispatch
+-- obligation vacuous; the operational-bridge audit must therefore reject it.
+example (P : SortVal → SortBool) :
+    ∀ V W, constantFalseAnd (P V) (P W) = true → False := by
+  intro V W h
+  simp [constantFalseAnd] at h
+
+example : Proof._andBool_ true true ≠ constantFalseAnd true true := by
+  native_decide
+
+-- With the honest conjunction and integer recognizer, a constant addition
+-- cannot satisfy the fixed generated theorem.
+example : ¬ Klean90NextSmallest.Lemmas.targetStatement
+    Proof._andBool_ Proof.«_<Int_» Proof.«_=/=Int_» constantZeroAdd
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» Proof.isInt
+    Proof.«project:Int» Proof.projectIntTotal Proof.«project:Int?» := by
+  intro target
+  have counterexample := target.2.2.1 (intVal 2) (intVal 1) (by native_decide)
+  simp [intVal, constantZeroAdd, Proof.projectIntTotal,
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»,
+    ProofOperational.applyBinComplete, ProofOperational.stringCodes?] at counterexample
+
+-- A constant comparison likewise fails the strict-less-than obligation.
+example : ¬ Klean90NextSmallest.Lemmas.targetStatement
+    Proof._andBool_ Proof.«_<Int_» Proof.«_=/=Int_» Proof.«_+Int_»
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» constantFalseCmp
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» Proof.isInt
+    Proof.«project:Int» Proof.projectIntTotal Proof.«project:Int?» := by
+  intro target
+  have counterexample := target.2.2.2.1 (intVal 0) (intVal (-1)) (by native_decide)
+  simp [intVal, constantFalseCmp, Proof.projectIntTotal, Proof.«_<Int_»] at counterexample
+
+-- A predicate chosen to falsify the cast guard cannot satisfy the Ceil bridge.
+example : ¬ Klean90NextSmallest.Lemmas.targetStatement
+    Proof._andBool_ Proof.«_<Int_» Proof.«_=/=Int_» Proof.«_+Int_»
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» constantFalseDefined
+    Proof.isInt Proof.«project:Int» Proof.projectIntTotal Proof.«project:Int?» := by
+  intro target
+  have counterexample := target.1 (intVal 1)
+  simp [intVal, constantFalseDefined, Proof.«project:Int?», inj] at counterexample
