+import Proof
+
+open Klean90NextSmallest Generated
+
+private def intVal (n : Int) : SortVal := SortVal.inj_SortInt n
+private def boolVal (b : Bool) : SortVal := SortVal.inj_SortBool b
+
+-- Primitive parameters: ordinary and boundary-shaped cases.
+example : Proof._andBool_ true false = false := by native_decide
+example : Proof._andBool_ true true = true := by native_decide
+example : Proof.«_<_Int» (-7) 2 = true := by native_decide
+example : Proof.«_=/=_Int» 5 5 = false := by native_decide
+example : Proof.«_+Int_» (-7) 2 = -5 := by native_decide
+
+-- Projection bridge: accepts exactly integer values in the source-relevant domain.
+example : Proof.definedProjectInt (intVal (-11)) = true := by native_decide
+example : Proof.definedProjectInt Generated.noneV = false := by native_decide
+example : Proof.«project:Int?» (intVal 42) = some 42 := by native_decide
+example : Proof.«project:Int?» (boolVal true) = none := by native_decide
+example : Proof.projectIntTotal (intVal (-11)) = -11 := by native_decide
+example : Proof.«project:Int» (intVal 42) = 42 := by native_decide
+example : Proof.isInt (SortK.kseq (SortKItem.inj_SortInt (-3)) SortK.dotk) = true := by native_decide
+example : Proof.isInt (SortK.kseq (SortKItem.inj_SortVal (boolVal true)) SortK.dotk) = false := by native_decide
+
+-- Source operations, including negatives and equality boundaries.
+example : Proof.applyBin "+" (intVal (-7)) (intVal 2) = intVal (-5) := by native_decide
+example : Proof.applyCmp "<" (intVal (-1)) (intVal 0) = boolVal true := by native_decide
+example : Proof.applyCmp "<" (intVal 0) (intVal (-1)) = boolVal false := by native_decide
+example : Proof.applyCmp "!=" (intVal 3) (intVal 3) = boolVal false := by native_decide
+example : Proof.applyCmp "!=" (intVal 3) (intVal 4) = boolVal true := by native_decide
+
+-- Counterfactual operators: catches definitions hard-coded only to the target equations.
+example : Proof.applyBin "-" (intVal 7) (intVal 2) = intVal 5 := by native_decide
+example : Proof.applyCmp ">" (intVal 7) (intVal 2) = boolVal true := by native_decide
