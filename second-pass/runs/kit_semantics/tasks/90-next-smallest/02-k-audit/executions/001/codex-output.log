diff --git a/evidence/make_pinning_spec.py b/evidence/make_pinning_spec.py
new file mode 100644
index 0000000000000000000000000000000000000000..a8a9cdc4d3b7b075e97fe870c3dd23edce363d35
--- /dev/null
+++ b/evidence/make_pinning_spec.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Generate a K identity claim from the trusted translator's exact MPY output."""
+
+import argparse
+from pathlib import Path
+
+
+parser = argparse.ArgumentParser()
+parser.add_argument("mpy", type=Path)
+parser.add_argument("output", type=Path)
+args = parser.parse_args()
+
+term = args.mpy.read_text(encoding="utf-8").strip()
+spec = f'''requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // RHS is inserted verbatim from trusted py2mpy.py output.
+  claim solutionProgram => {term}
+endmodule
+'''
+args.output.write_text(spec, encoding="utf-8")
+print(f"source={args.mpy}")
+print(f"output={args.output}")
+print(f"inserted_bytes={len(term.encode('utf-8'))}")
