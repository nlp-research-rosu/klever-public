Module(
  FuncDef("next_smallest", Params("lst"),
    Expr(
      Str(
        "\n    Return the second-smallest distinct integer in lst, or None when it\n    does not exist.\n    "))
    Assign(Name("found_smallest"), Bool(false))
    Assign(Name("found_second"), Bool(false))
    Assign(Name("smallest"), Int(0))
    Assign(Name("second"), Int(0))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("lst"),
      Assign(Name("x"), BinOp("+", Name("x"), Int(0)))
      If(UnaryOp("not", Name("found_smallest")),
        Assign(Name("smallest"), Name("x"))
        Assign(Name("found_smallest"), Bool(true)),
        If(Compare(Name("x"), CmpOp("<", Name("smallest"))),
          Assign(Name("second"), Name("smallest"))
          Assign(Name("found_second"), Bool(true))
          Assign(Name("smallest"), Name("x")),
          If(BoolOp(
            "and",
            Compare(Name("x"), CmpOp("!=", Name("smallest"))),
            BoolOp(
              "or",
              UnaryOp("not", Name("found_second")),
              Compare(Name("x"), CmpOp("<", Name("second"))))),
            Assign(Name("second"), Name("x"))
            Assign(Name("found_second"), Bool(true)),
            ))))
    If(Name("found_second"),
      Return(Name("second")),
      )
    Return(NoneVal))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(5), Int(1), Int(4), Int(3), Int(2))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr()),
      CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr(Int(1), Int(1))),
      CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr(Int(0), Int(0), Int(1))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(2), Int(1), Int(2), Int(1))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(
          Int(1000000000000),
          UnaryOp("-", Int(1000000000000)),
          Int(7))),
      CmpOp("==", Int(7)))))
