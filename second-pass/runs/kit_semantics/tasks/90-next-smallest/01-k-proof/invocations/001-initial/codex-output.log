+             (list(vCons(1, vCons(2, .ValSeq))), .Exprs))
+        => noneV </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "next_smallest" |->
+          closureVal(("lst", .ParamNames), nextSmallestBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
