+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the correct result for [1, 2] is 2, not None.
+  claim [false-result]:
+    <k> Call(Name("next_smallest"),
+             (list(vCons(1, vCons(2, .ValSeq))), .Exprs))
+        => noneV </k>
+    <env> 0 </env>
+    <scopes>
