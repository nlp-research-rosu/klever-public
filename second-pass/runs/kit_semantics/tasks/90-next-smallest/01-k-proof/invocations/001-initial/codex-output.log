+        "x" |-> (X0:Int => lastInt(VS, X0)),
+        parent(0)) ...
+    </scopes>
+    requires allInts(VS)
+
+  // Whole-function target theorem, from exact name binding and exact body.
+  claim [next-smallest]:
+    <k> #loadAll(solutionProgram)
+         ~> Call(Name("next_smallest"), (list(VS:ValSeq), .Exprs))
+        => nextSmallestSpec(VS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "next_smallest" |->
+                    closureVal(("lst", .ParamNames), nextSmallestBody, 0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
