exec
/bin/bash -lc "python3 py2mpy.py concrete_tests.py > concrete_tests.mpy && python3 - <<'PY'
import ast
from pathlib import Path

def first_fn(path):
    tree = ast.parse(Path(path).read_text())
    return ast.dump(next(n for n in tree.body if isinstance(n, ast.FunctionDef)), include_attributes=False)

assert first_fn('solution.py') == first_fn('concrete_tests.py')
