+
+        if not found_smallest:
+            smallest = x
+            found_smallest = True
+        elif x < smallest:
+            second = smallest
+            found_second = True
+            smallest = x
+        elif x != smallest and (not found_second or x < second):
+            second = x
+            found_second = True
+
+    if found_second:
+        return second
+    return None
