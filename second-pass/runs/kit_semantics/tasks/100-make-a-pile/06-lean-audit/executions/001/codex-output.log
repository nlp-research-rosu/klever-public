+    "no_candidate_recorded": (
+        resolution.get("lean_workspace") is None
+        and resolution.get("lean_invocation") is None
+        and resolution.get("stage5_result") is None
+    ),
+}
+
+print(json.dumps(checks, indent=2, sort_keys=True))
