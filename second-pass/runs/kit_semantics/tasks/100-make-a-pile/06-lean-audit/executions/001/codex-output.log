  2> proof.err | tee proof.out

python3 validate.py | tee validation.out

set +e
kprove spec-vacuity.k \
  --definition verification-kompiled \
  --spec-module SPEC-VACUITY \
  > vacuity.out 2> vacuity.err
vacuity_status=$?

kprove spec-body-mutation.k \
