+      0 |-> list(finishPile(.ValSeq, N, 0))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..20cd39560510561a56685f689f9a56580bc4c357
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax ValSeq ::= finishPile(ValSeq, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule finishPile(A:ValSeq, N:Int, I:Int) => A
+    requires I >=Int N
+
+  rule finishPile(A:ValSeq, N:Int, I:Int)
+    => finishPile(
+         valSeqConcat(A, vCons(N +Int (2 *Int I), .ValSeq)),
+         N,
+         I +Int 1)
+    requires I <Int N
+endmodule

