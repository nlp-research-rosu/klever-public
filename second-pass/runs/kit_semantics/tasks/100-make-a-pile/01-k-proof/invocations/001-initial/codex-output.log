+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax ValSeq ::= finishPile(ValSeq, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule finishPile(A:ValSeq, N:Int, I:Int) => A
+    requires I >=Int N
+
+  rule finishPile(A:ValSeq, N:Int, I:Int)
+    => finishPile(
+         valSeqConcat(A, vCons(N +Int (2 *Int I), .ValSeq)),
+         N,
+         I +Int 1)
+    requires I <Int N
+endmodule

codex
The audit exposed one easy strengthening worth making before I finalize: the entry claim already executed the exact definition and call, but began just after the semantics’ `#loadAll(Module(...))` wrapper. I’m including that fixed loading step too, so the theorem’s left side contains the complete generated module AST from `solution.mpy` plus the invocation harness.
