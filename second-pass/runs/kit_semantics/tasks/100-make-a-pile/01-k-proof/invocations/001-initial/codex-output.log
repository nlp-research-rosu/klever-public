+        AugAssign(Name("i"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "n"    |-> N:Int
+        "pile" |-> ref(H:Int)
+        "i"    |-> (I:Int => N)
+        LOCAL:Map,
+        P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(A:ValSeq => finishPile(A, N, I))
+      ...
+    </heap>
+    requires N >=Int 0
+     andBool I >=Int 0
+     andBool I <=Int N
+     andBool H >=Int 0
+
+  claim [make-a-pile]:
+    <k>
+      FuncDef(
