+    requires N >=Int 0
+     andBool I >=Int 0
+     andBool I <=Int N
+
+  // Deliberately false: the real invocation returns the freshly allocated ref(0).
+  claim [wrong-return]:
+    <k>
+      FuncDef(
+        "make_a_pile",
+        Params("n"),
+        Assign(Name("pile"), ListExpr(.Exprs))
+        Assign(Name("i"), Int(0))
