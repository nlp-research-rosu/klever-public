index 0000000000000000000000000000000000000000..dbc61b2efec1f88dbb9dac358cf6f53375dd03a5
--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit.6hDcA5/OperationalBridgeAudit.lean
@@ -0,0 +1,59 @@
+import Proof
+
+open Klean65CircularShift.Lemmas
+
+def codesToList : SortIntSeq → List Int
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => []
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail =>
+      head :: codesToList tail
+
+#eval Proof.«Int2String(_)_STRING-COMMON_String_Int» 0
+#eval Proof.«Int2String(_)_STRING-COMMON_String_Int» 507
+#eval Proof.«Int2String(_)_STRING-COMMON_String_Int» (-120)
+#eval (Proof.«strToCodes(_)_MPY-STR_IntSeq_String?» "").map codesToList
+#eval (Proof.«strToCodes(_)_MPY-STR_IntSeq_String?» "A0-").map codesToList
+#eval (Proof.«strToCodes(_)_MPY-STR_IntSeq_String?» "é").map codesToList
+#eval (Proof.«strToCodes(_)_MPY-STR_IntSeq_String?» "Aé").map codesToList
+#eval
+  (Proof.«strToCodes(_)_MPY-STR_IntSeq_String?»
+    (String.singleton (Char.ofNat 127))).map codesToList
+#eval
+  (Proof.«strToCodes(_)_MPY-STR_IntSeq_String?»
+    (String.singleton (Char.ofNat 128))).map codesToList
+
+def constantInt2String (_ : SortInt) : SortString := ""
+def constantSomeCodes (_ : SortString) : Option SortIntSeq :=
+  some SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+#eval constantInt2String (-120)
+#eval (constantSomeCodes "A0-").map codesToList
+#eval (constantSomeCodes "é").map codesToList
+
+example :
+    targetStatement constantInt2String
+      Proof.«strToCodes(_)_MPY-STR_IntSeq_String?» := by
+  unfold targetStatement
+  intro value
+  change
+    ((Proof.«strToCodes(_)_MPY-STR_IntSeq_String?» "").isSome = true) ↔ True
+  decide
+
+example :
+    targetStatement
+      Proof.«Int2String(_)_STRING-COMMON_String_Int»
+      constantSomeCodes := by
+  unfold targetStatement
+  intro value
+  simp [constantSomeCodes]
+
+example : Proof.«Int2String(_)_STRING-COMMON_String_Int» (-120) = "-120" := by
+  rfl
+
+example :
+    (Proof.«strToCodes(_)_MPY-STR_IntSeq_String?» "A0-").map codesToList =
+      some [65, 48, 45] := by
+  rfl
+
+example :
+    Proof.«strToCodes(_)_MPY-STR_IntSeq_String?» "é" = none := by
+  rfl
