codex
The root cause is now concrete: inside this audit sandbox, `getpid()` returns namespace PID `2`, but `/proc/2/exe` does not exist; Lean 4.22 resolves its executable through `/proc/<getpid>/exe`, so both `lean` and project-loading `lake` fail. I’m applying a narrowly scoped, recorded preload shim that maps only `/proc/<digits>/exe` reads to `/proc/self/exe`. This restores Lean’s own path lookup without changing any source, theorem, build input, or proof behavior.
apply patch
patch: completed
/tmp/audit-work/lean-proc-self-shim.c
diff --git a//tmp/audit-work/lean-proc-self-shim.c b//tmp/audit-work/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..847088735e92d333e866b24a9f527bc9800f0ae6
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    const char *cursor;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+        cursor = path + 6;
+        while (*cursor >= '0' && *cursor <= '9') {
+            cursor++;
+        }
+        if (strcmp(cursor, "/exe") == 0) {
+            path = "/proc/self/exe";
+        }
+    }
+    return real_readlink(path, buffer, size);
+}

