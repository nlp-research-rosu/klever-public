/bin/bash -lc "python3 - <<'PY' | tee /audit-output/evidence/41-generator-image-id-reconciliation.txt
import json
from pathlib import Path
gm=json.loads(Path('/reference/klean-generation/generator-manifest.json').read_text())
sm=json.loads(Path('/reference/generation-tools/source-manifest.json').read_text())
ai=json.loads(Path('/audit-input.json').read_text())['resolution']
gid=gm['provenance']['generator_image_id']
source_gid=sm['generator_image_id']
audit_path=Path(ai['generation_producer_sources'])
audit_gid='sha256:'+audit_path.name
print('generator_manifest_image_id',gid)
print('source_manifest_image_id',source_gid)
print('audit_input_bundle_path',audit_path)
