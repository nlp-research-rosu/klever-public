     3	/- K trust-boundary goals. The second-pass agent must replace every
     4	   writable opaque stub with an honest definition and prove this
     5	   immutable proposition in the separate Proof.lean workspace. -/
     6	
     7	namespace Klean65CircularShift.Lemmas
     8	
     9	def targetStatement
    10	    («Int2String(_)_STRING-COMMON_String_Int» : SortInt → SortString)
    11	    («strToCodes(_)_MPY-STR_IntSeq_String?» : SortString → Option SortIntSeq)
    12	    : Prop :=
    13	    (∀ (X : SortInt), ((«strToCodes(_)_MPY-STR_IntSeq_String?» («Int2String(_)_STRING-COMMON_String_Int» X)).isSome = true) ↔ (True))
