Module(
  Expr(
    Str(
      "Reviewer-authored concrete execution cases for the supplied MPY semantics."))
  FuncDef("circular_shift", Params("x", "shift"),
    Assign(Name("s"), Call(Name("str"), Name("x")))
    Return(
      IfExp(
        Compare(Name("shift"), CmpOp(">", Call(Name("len"), Name("s")))),
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
        IfExp(
          Compare(Name("shift"), CmpOp("<", Int(0))),
          Name("s"),
          Subscript(
            BinOp("+", Name("s"), Name("s")),
            Slice(
              BinOp("-", Call(Name("len"), Name("s")), Name("shift")),
              BinOp(
                "-",
                BinOp("*", Int(2), Call(Name("len"), Name("s"))),
                Name("shift")),
              NoBound))))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(0), Int(0)),
      CmpOp("==", Str("0"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(0), Int(1)),
      CmpOp("==", Str("0"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(0), Int(2)),
      CmpOp("==", Str("0"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12), Int(1)),
      CmpOp("==", Str("21"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12), Int(2)),
      CmpOp("==", Str("12"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12), Int(3)),
      CmpOp("==", Str("21"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(100), Int(1)),
      CmpOp("==", Str("010"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12345), Int(4)),
      CmpOp("==", Str("23451"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12345), Int(5)),
      CmpOp("==", Str("12345"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12345), UnaryOp("-", Int(1))),
      CmpOp("==", Str("12345"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), UnaryOp("-", Int(120)), Int(1)),
      CmpOp("==", Str("0-12"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), UnaryOp("-", Int(120)), Int(2)),
      CmpOp("==", Str("20-1"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), UnaryOp("-", Int(120)), Int(4)),
      CmpOp("==", Str("-120"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), UnaryOp("-", Int(120)), Int(5)),
      CmpOp("==", Str("021-"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12345678901234567890), Int(3)),
      CmpOp("==", Str("89012345678901234567")))))
