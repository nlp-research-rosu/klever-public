+        "review": "Bounds evaluate lo, hi, step in order; CPython-style default/clamp equations feed structural buildIS recursion.",
+    },
+]
+
+USED_RANGES = {
+    "reference-semantics/semantics/syntax.k": [
+        (9, 15),
+        (22, 23),
+        (28, 32),
+        (37, 41),
+        (50, 61),
