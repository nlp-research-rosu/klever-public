+    "reference-semantics/semantics/call.k": [(18, 21), (31, 32), (69, 74)],
+    "reference-semantics/semantics/controls.k": [(8, 18), (56, 60)],
+    "reference-semantics/semantics/operators.k": [(10, 17)],
