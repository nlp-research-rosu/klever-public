+                "fixed-semantics result terms for the three source branches; "
+                "the symbol appears only in claim destinations."
+            )
+        else:
+            entry["static_decision"] = "STRUCTURAL_PROOF_MODULE_SENTENCE"
+            entry["static_rationale"] = (
