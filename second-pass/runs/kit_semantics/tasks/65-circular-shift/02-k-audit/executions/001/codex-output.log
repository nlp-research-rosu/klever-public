diff --git a/evidence/stage6_false_witness.py b/evidence/stage6_false_witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..0831c85d6a9a73c69a9098128dcfa30d7252265d
--- /dev/null
+++ b/evidence/stage6_false_witness.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""Show that the fresh stage-6 destination is false on a satisfying input."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+def load(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.circular_shift
+
+
+x = 100
+shift = 1
