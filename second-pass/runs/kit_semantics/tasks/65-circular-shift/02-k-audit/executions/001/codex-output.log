+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+              "circular_shift" |->
+                closureVal(
+                  ("x", "shift", .ParamNames),
+                  Assign(
+                    Name("s"),
+                    Call(Name("str"), (Name("x"), .Exprs)))
+                  Return(Name("s"))
+                  .Stmts,
+                  0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
