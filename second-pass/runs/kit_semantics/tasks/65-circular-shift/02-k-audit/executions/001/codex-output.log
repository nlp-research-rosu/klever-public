     1	def circular_shift(x, shift):
     2	    s = str(x)
     3	    return (
     4	        s[::-1]
     5	        if shift > len(s)
     6	        else (
     7	            s
     8	            if shift < 0
     9	            else (s + s)[len(s) - shift:2 * len(s) - shift]
    10	        )
    11	    )
