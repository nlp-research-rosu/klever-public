+
+def overlaps_used_range(entry: dict[str, object]) -> bool:
+    for lo, hi in USED_RANGES.get(str(entry["source"]), []):
+        if int(entry["start_line"]) <= hi and int(entry["end_line"]) >= lo:
+            return True
+    return False
