diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..ecd8d5e971ae9d58eac26e7fc17654153f9707d0
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,26 @@
+from solution import circular_shift
+
+
+def direct_two_slice_oracle(x, shift):
+    digits = str(x)
+    if shift > len(digits):
+        return digits[::-1]
+    split = len(digits) - shift
+    return digits[split:] + digits[:split]
+
+
+def main():
+    xs = list(range(-200, 201)) + [10**20 + 123456789]
+    shifts = range(-12, 30)
+    checked = 0
+    for x in xs:
+        for shift in shifts:
+            actual = circular_shift(x, shift)
+            expected = direct_two_slice_oracle(x, shift)
+            assert actual == expected, (x, shift, actual, expected)
+            checked += 1
+    print(f"differential: {checked} cases, 0 mismatches")
+
+
+if __name__ == "__main__":
+    main()
