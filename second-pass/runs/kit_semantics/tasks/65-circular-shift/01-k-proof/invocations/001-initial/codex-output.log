from solution import circular_shift

def canonical(x, shift):
    s = str(x)
    if shift > len(s):
        return s[::-1]
    return s[len(s) - shift:] + s[:len(s) - shift]

cases = 0
for x in list(range(-200, 201)) + [10**20 + 123456789]:
    for shift in range(-12, 30):
        assert circular_shift(x, shift) == canonical(x, shift), (x, shift)
        cases += 1
print(f'python differential vs canonical: {cases} passed')
