+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Validation scope:
+  // - Program boundary: the exact translated circular_shift body.
+  // - Input domain: every X:Int and SHIFT:Int (no finite length bound).
+  // - Observable final state: returned Str and restored call-frame cells.
+  // - Property: reverse iff SHIFT exceeds the decimal-string length;
+  //   otherwise rotate right by splitting at length - SHIFT.
+  claim [circular-shift]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int, .Exprs))
+      => circularShiftResult(X, SHIFT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |->
+        scope(
+          "circular_shift" |->
+            closureVal(
+              ("x", "shift", .ParamNames),
+              Assign(Name("s"), Call(Name("str"), (Name("x"), .Exprs)))
+              If(
+                Compare(
+                  Name("shift"),
+                  CmpOp(">", Call(Name("len"), (Name("s"), .Exprs)))),
+                Return(
+                  Subscript(
+                    Name("s"),
+                    Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))
+                .Stmts,
+                .Stmts)
+              Return(
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("s"),
+                    Slice(
+                      BinOp(
+                        "-",
+                        Call(Name("len"), (Name("s"), .Exprs)),
+                        Name("shift")),
+                      NoBound,
+                      NoBound)),
+                  Subscript(
+                    Name("s"),
+                    Slice(
+                      NoBound,
+                      BinOp(
+                        "-",
+                        Call(Name("len"), (Name("s"), .Exprs)),
+                        Name("shift")),
+                      NoBound))))
+              .Stmts,
+              0),
+          parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6dfe80b149bd78388b8072f1bb243d986dd1e4d9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,37 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical result of the Python function, expressed entirely with the
+  // fixed semantics' decimal conversion and string-slice functions.
+  syntax Str ::= circularShiftResult(Int, Int) [function, total]
+
+  rule circularShiftResult(X:Int, SHIFT:Int)
+    => str(buildIS(
+         strToCodes(Int2String(X)),
+         isLen(strToCodes(Int2String(X))) -Int 1,
+         -1,
+         -1))
+    requires SHIFT >Int isLen(strToCodes(Int2String(X)))
+
+  rule circularShiftResult(X:Int, SHIFT:Int)
+    => str(seqConcat(
+         buildIS(
+           strToCodes(Int2String(X)),
+           slAdjust(
+             isLen(strToCodes(Int2String(X))) -Int SHIFT,
+             isLen(strToCodes(Int2String(X))),
+             1),
+           isLen(strToCodes(Int2String(X))),
+           1),
+         buildIS(
+           strToCodes(Int2String(X)),
+           0,
+           slAdjust(
+             isLen(strToCodes(Int2String(X))) -Int SHIFT,
+             isLen(strToCodes(Int2String(X))),
+             1),
+           1)))
+    requires SHIFT <=Int isLen(strToCodes(Int2String(X)))
+endmodule

