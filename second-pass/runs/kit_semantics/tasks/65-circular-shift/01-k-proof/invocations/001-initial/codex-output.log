diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0efda07303f2ca1066da33a142c0f3bab9ff6f20
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Validation scope:
+  // - Program boundary: circularShiftClosure expands to the exact translated
+  //   function value in solution.mpy, and the fixed call semantics executes it.
+  // - Input domain: every X:Int and SHIFT:Int.  The three claims use the exact
+  //   nested-conditional guards and collectively cover every integer pair.
+  // - Observable final state: returned Str and restored call-frame cells.
+  // - Property: reverse iff SHIFT exceeds the decimal-string length; preserve
+  //   the canonical implementation's negative-shift behavior; otherwise take
+  //   the length-sized rotation window from the doubled decimal string.
+
+  claim [circular-shift-reverse]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int, .Exprs))
+      => circularShiftResult(X, SHIFT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+              "circular_shift" |-> circularShiftClosure,
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires SHIFT >Int isLen(strToCodes(Int2String(X)))
+
+  claim [circular-shift-negative]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int, .Exprs))
+      => circularShiftResult(X, SHIFT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+              "circular_shift" |-> circularShiftClosure,
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (
+               SHIFT >Int isLen(strToCodes(Int2String(X))))
+      andBool SHIFT <Int 0
+
+  claim [circular-shift-rotate]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int, .Exprs))
+      => circularShiftResult(X, SHIFT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+              "circular_shift" |-> circularShiftClosure,
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (
+               SHIFT >Int isLen(strToCodes(Int2String(X))))
+      andBool notBool (SHIFT <Int 0)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..af437954a709222c617ce3de98b4b407e9d1fb87
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,87 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // K's Int2String hook always emits an ASCII decimal representation.  The
+  // supplied strToCodes definition is partial only because arbitrary String
+  // values may contain non-ASCII characters; this composition is defined.
+  rule #Ceil(strToCodes(Int2String(X:Int))) => #Top [simplification]
+
+  // Exact transliteration of solution.mpy's function value.  This is only a
+  // compact syntax name for use in the three complementary claims; calls
+  // still execute the supplied lookup, argument, frame, body, and return rules.
+  syntax Val ::= "circularShiftClosure" [function, total]
+  rule circularShiftClosure
+    => closureVal(
+         ("x", "shift", .ParamNames),
+         Assign(Name("s"), Call(Name("str"), (Name("x"), .Exprs)))
+         Return(
+           IfExp(
+             Compare(
+               Name("shift"),
+               CmpOp(">", Call(Name("len"), (Name("s"), .Exprs)))),
+             Subscript(
+               Name("s"),
+               Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
+             IfExp(
+               Compare(Name("shift"), CmpOp("<", Int(0))),
+               Name("s"),
+               Subscript(
+                 BinOp("+", Name("s"), Name("s")),
+                 Slice(
+                   BinOp(
+                     "-",
+                     Call(Name("len"), (Name("s"), .Exprs)),
+                     Name("shift")),
+                   BinOp(
+                     "-",
+                     BinOp(
+                       "*",
+                       Int(2),
+                       Call(Name("len"), (Name("s"), .Exprs))),
+                     Name("shift")),
+                   NoBound)))))
+         .Stmts,
+         0)
+
+  // Mathematical result of the Python function, expressed entirely with the
+  // fixed semantics' decimal conversion and string-slice functions.
+  syntax Str ::= circularShiftResult(Int, Int) [function, total]
+
+  rule circularShiftResult(X:Int, SHIFT:Int)
+    => str(buildIS(
+         strToCodes(Int2String(X)),
+         isLen(strToCodes(Int2String(X))) -Int 1,
+         -1,
+         -1))
+    requires SHIFT >Int isLen(strToCodes(Int2String(X)))
+
+  rule circularShiftResult(X:Int, SHIFT:Int)
+    => str(strToCodes(Int2String(X)))
+    requires notBool (
+               SHIFT >Int isLen(strToCodes(Int2String(X))))
+      andBool SHIFT <Int 0
+
+  rule circularShiftResult(X:Int, SHIFT:Int)
+    => str(buildIS(
+         seqConcat(
+           strToCodes(Int2String(X)),
+           strToCodes(Int2String(X))),
+         slAdjust(
+           isLen(strToCodes(Int2String(X))) -Int SHIFT,
+           isLen(seqConcat(
+             strToCodes(Int2String(X)),
+             strToCodes(Int2String(X)))),
+           1),
+         slAdjust(
+           (2 *Int isLen(strToCodes(Int2String(X)))) -Int SHIFT,
+           isLen(seqConcat(
+             strToCodes(Int2String(X)),
+             strToCodes(Int2String(X)))),
+           1),
+         1))
+    requires notBool (
+               SHIFT >Int isLen(strToCodes(Int2String(X))))
+      andBool notBool (SHIFT <Int 0)
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..f76330bbd35fc250d456933cdbdc376bba3140f8
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,21 @@
+def circular_shift(x, shift):
+    s = str(x)
+    return (
+        s[::-1]
+        if shift > len(s)
+        else (
+            s
+            if shift < 0
+            else (s + s)[len(s) - shift:2 * len(s) - shift]
+        )
+    )
+
+
+assert circular_shift(12, 1) == "21"
+assert circular_shift(12, 2) == "12"
+assert circular_shift(12, 3) == "21"
+assert circular_shift(100, 1) == "010"
+assert circular_shift(1234, 0) == "1234"
+assert circular_shift(1234, 4) == "1234"
+assert circular_shift(1234, -3) == "1234"
+assert circular_shift(-120, 2) == "20-1"
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..ecd8d5e971ae9d58eac26e7fc17654153f9707d0
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,26 @@
+from solution import circular_shift
+
+
+def direct_two_slice_oracle(x, shift):
+    digits = str(x)
+    if shift > len(digits):
+        return digits[::-1]
+    split = len(digits) - shift
+    return digits[split:] + digits[:split]
+
+
+def main():
+    xs = list(range(-200, 201)) + [10**20 + 123456789]
+    shifts = range(-12, 30)
+    checked = 0
+    for x in xs:
+        for shift in shifts:
+            actual = circular_shift(x, shift)
+            expected = direct_two_slice_oracle(x, shift)
+            assert actual == expected, (x, shift, actual, expected)
+            checked += 1
+    print(f"differential: {checked} cases, 0 mismatches")
+
+
+if __name__ == "__main__":
+    main()
