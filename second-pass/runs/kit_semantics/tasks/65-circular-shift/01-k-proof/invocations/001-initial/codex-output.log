+    <scopes>
+      0 |-> scope(
+              "circular_shift" |->
+                closureVal(
+                  ("x", "shift", .ParamNames),
+                  Assign(
+                    Name("s"),
+                    Call(Name("str"), (Name("x"), .Exprs)))
+                  Return(Name("s"))
