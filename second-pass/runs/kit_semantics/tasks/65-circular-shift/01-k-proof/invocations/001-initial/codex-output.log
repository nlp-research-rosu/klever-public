index 0000000000000000000000000000000000000000..f0d2b9a3fef17a862e1f2f6b9bbf513c151bbe7b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,42 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // K's Int2String hook always emits an ASCII decimal representation.  The
+  // supplied strToCodes definition is partial only because arbitrary String
+  // values may contain non-ASCII characters; this composition is defined.
+  rule #Ceil(strToCodes(Int2String(X:Int))) => #Top [simplification]
+
+  // Mathematical result of the Python function, expressed entirely with the
+  // fixed semantics' decimal conversion and string-slice functions.
+  syntax Str ::= circularShiftResult(Int, Int) [function, total]
+
+  rule circularShiftResult(X:Int, SHIFT:Int)
+    => str(buildIS(
+         strToCodes(Int2String(X)),
+         isLen(strToCodes(Int2String(X))) -Int 1,
+         -1,
+         -1))
+    requires SHIFT >Int isLen(strToCodes(Int2String(X)))
+
+  rule circularShiftResult(X:Int, SHIFT:Int)
+    => str(seqConcat(
+         buildIS(
+           strToCodes(Int2String(X)),
+           slAdjust(
+             isLen(strToCodes(Int2String(X))) -Int SHIFT,
+             isLen(strToCodes(Int2String(X))),
+             1),
+           isLen(strToCodes(Int2String(X))),
+           1),
+         buildIS(
+           strToCodes(Int2String(X)),
+           0,
+           slAdjust(
+             isLen(strToCodes(Int2String(X))) -Int SHIFT,
+             isLen(strToCodes(Int2String(X))),
+             1),
+           1)))
+    requires SHIFT <=Int isLen(strToCodes(Int2String(X)))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.circular-shift-reverse' in /workspace
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..e41759187dd75372b5fcac2e71eb90fd93484c34
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def circular_shift(x, shift):
+    s = str(x)
+    return (
+        s[::-1]
+        if shift > len(s)
+        else s[len(s) - shift:] + s[:len(s) - shift]
+    )
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..854647eca7209bdc3df38c054847892a5d20e198
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,121 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Validation scope:
+  // - Program boundary: the exact translated circular_shift body.
+  // - Input domain: every X:Int and SHIFT:Int (no finite length bound).
+  // - Observable final state: returned Str and restored call-frame cells.
+  // - Property: reverse iff SHIFT exceeds the decimal-string length;
+  //   otherwise rotate right by splitting at length - SHIFT.
+  claim [circular-shift-reverse]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int, .Exprs))
+      => circularShiftResult(X, SHIFT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |->
+        scope(
+          "circular_shift" |->
+            closureVal(
+              ("x", "shift", .ParamNames),
+              Assign(Name("s"), Call(Name("str"), (Name("x"), .Exprs)))
+              Return(
+                IfExp(
+                  Compare(
+                    Name("shift"),
+                    CmpOp(">", Call(Name("len"), (Name("s"), .Exprs)))),
+                  Subscript(
+                    Name("s"),
+                    Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
+                  BinOp(
+                    "+",
+                    Subscript(
+                      Name("s"),
+                      Slice(
+                        BinOp(
+                          "-",
+                          Call(Name("len"), (Name("s"), .Exprs)),
+                          Name("shift")),
+                        NoBound,
+                        NoBound)),
+                    Subscript(
+                      Name("s"),
+                      Slice(
+                        NoBound,
+                        BinOp(
+                          "-",
+                          Call(Name("len"), (Name("s"), .Exprs)),
+                          Name("shift")),
+                        NoBound)))))
+              .Stmts,
+              0),
+          parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires SHIFT >Int isLen(strToCodes(Int2String(X)))
+
+  claim [circular-shift-rotate]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int, .Exprs))
+      => circularShiftResult(X, SHIFT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |->
+        scope(
+          "circular_shift" |->
+            closureVal(
+              ("x", "shift", .ParamNames),
+              Assign(Name("s"), Call(Name("str"), (Name("x"), .Exprs)))
+              Return(
+                IfExp(
+                  Compare(
+                    Name("shift"),
+                    CmpOp(">", Call(Name("len"), (Name("s"), .Exprs)))),
+                  Subscript(
+                    Name("s"),
+                    Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
+                  BinOp(
+                    "+",
+                    Subscript(
+                      Name("s"),
+                      Slice(
+                        BinOp(
+                          "-",
+                          Call(Name("len"), (Name("s"), .Exprs)),
+                          Name("shift")),
+                        NoBound,
+                        NoBound)),
+                    Subscript(
+                      Name("s"),
+                      Slice(
+                        NoBound,
+                        BinOp(
+                          "-",
+                          Call(Name("len"), (Name("s"), .Exprs)),
+                          Name("shift")),
+                        NoBound)))))
+              .Stmts,
+              0),
+          parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires SHIFT <=Int isLen(strToCodes(Int2String(X)))
+endmodule
