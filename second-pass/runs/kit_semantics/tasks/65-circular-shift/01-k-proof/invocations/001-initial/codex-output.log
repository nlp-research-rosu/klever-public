new file mode 100644
index 0000000000000000000000000000000000000000..362088ca8dadedd79e21cb5695ed08c758cad272
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def circular_shift(x, shift):
+    s = str(x)
+    return (
+        s[::-1]
+        if shift > len(s)
+        else (
+            s
+            if shift < 0
+            else (s + s)[len(s) - shift:2 * len(s) - shift]
+        )
+    )
