diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..e41759187dd75372b5fcac2e71eb90fd93484c34
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def circular_shift(x, shift):
+    s = str(x)
+    return (
+        s[::-1]
+        if shift > len(s)
+        else s[len(s) - shift:] + s[:len(s) - shift]
+    )
