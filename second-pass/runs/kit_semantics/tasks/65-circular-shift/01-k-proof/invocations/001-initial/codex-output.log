+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (
+               SHIFT >Int isLen(strToCodes(Int2String(X))))
+      andBool notBool (SHIFT <Int 0)
