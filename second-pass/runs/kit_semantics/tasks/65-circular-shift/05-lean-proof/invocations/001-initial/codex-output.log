new file mode 100644
index 0000000000000000000000000000000000000000..4c5d2b7f392e06c87e1564575ef395adbbb9006e
--- /dev/null
+++ b//tmp/selfpath.c
@@ -0,0 +1,10 @@
+#include <unistd.h>
+#include <stdio.h>
+int main(void) {
+  char b[4096];
+  ssize_t n = readlink("/proc/self/exe", b, sizeof(b)-1);
+  if (n < 0) { perror("readlink"); return 1; }
+  b[n] = 0;
+  puts(b);
+  return 0;
+}
diff --git a//tmp/tracepath.c b//tmp/tracepath.c
new file mode 100644
index 0000000000000000000000000000000000000000..217dc2844076720f92493c8c9ec5abab5a347355
--- /dev/null
