+++ b//tmp/selfpath.c
@@ -0,0 +1,10 @@
+#include <unistd.h>
+#include <stdio.h>
+int main(void) {
+  char b[4096];
+  ssize_t n = readlink("/proc/self/exe", b, sizeof(b)-1);
