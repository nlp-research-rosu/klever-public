The source now preserves the fixed theorem and exposes the full dispatch model, but the pinned `lake` launcher cannot inspect its own executable path in this container (`could not detect the configuration`). I’m applying the same process-local path shim used for this benchmark environment; it changes neither the project nor the pinned toolchain, and will let the actual Lean diagnostics run.
apply patch
patch: completed
/workspace/.lean-app-path.c
diff --git a/.lean-app-path.c b/.lean-app-path.c
new file mode 100644
index 0000000000000000000000000000000000000000..4acdce9e6d8713bf1b2f9f4d51fb9a7761dc04f9
--- /dev/null
+++ b/.lean-app-path.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *requested, char *buffer, size_t capacity) {
+  static const char path[] =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake";
+  const size_t length = sizeof(path) - 1;
+  const size_t requested_length = strlen(requested);
+
+  if (strncmp(requested, "/proc/", 6) == 0 &&
+      requested_length >= 4 &&
+      strcmp(requested + requested_length - 4, "/exe") == 0) {
+    if (capacity < length) {
+      return -1;
+    }
+    memcpy(buffer, path, length);
+    return (ssize_t)length;
+  }
+
+  static ssize_t (*actual_readlink)(const char *, char *, size_t);
+  if (actual_readlink == NULL) {
+    actual_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  return actual_readlink(requested, buffer, capacity);
+}
