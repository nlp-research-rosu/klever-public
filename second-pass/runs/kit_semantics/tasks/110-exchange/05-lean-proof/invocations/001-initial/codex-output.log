+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => 0
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ tail =>
+      valSeqLength tail + 1
+
+noncomputable def dictLookup
+    (key : SortVal) : SortValSeq → SortValSeq → Option SortVal
