      if operator = "+" then some (SortVal.inj_SortFloat (intToFloat x + y))
      else if operator = "-" then
        some (SortVal.inj_SortFloat (intToFloat x - y))
      else if operator = "*" then
        some (SortVal.inj_SortFloat (intToFloat x * y))
      else if operator = "/" then
        some (SortVal.inj_SortFloat (intToFloat x / y))
      else if operator = "**" then
        some (SortVal.inj_SortFloat (intToFloat x ^ y))
      else none
