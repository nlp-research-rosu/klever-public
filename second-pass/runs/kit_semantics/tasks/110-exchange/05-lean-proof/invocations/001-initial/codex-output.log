    | SortVal.inj_SortInt x, SortVal.inj_SortInt y =>
        if operator = "<" then some (decide (x < y))
        else if operator = "<=" then some (decide (x ≤ y))
        else if operator = ">" then some (decide (x > y))
        else if operator = ">=" then some (decide (x ≥ y))
