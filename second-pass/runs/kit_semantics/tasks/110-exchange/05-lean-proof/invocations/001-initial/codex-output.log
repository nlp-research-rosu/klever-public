+def valSeqLength : SortValSeq → SortInt
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => 0
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ tail =>
