noncomputable def applyBin?
    (operator : SortString) (left right : SortVal) : Option SortVal :=
  match left, right with
  | SortVal.inj_SortInt x, SortVal.inj_SortInt y =>
      if operator = "+" then some (SortVal.inj_SortInt (x + y))
