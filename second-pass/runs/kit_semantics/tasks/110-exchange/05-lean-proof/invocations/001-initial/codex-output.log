+def projectFloat? : SortK → Option SortFloat
+  | SortK.kseq (SortKItem.inj_SortFloat value) SortK.dotk => some value
+  | _ => none
+
+def projectInt? : SortK → Option SortInt
+  | SortK.kseq (SortKItem.inj_SortInt value) SortK.dotk => some value
+  | _ => none
+
