+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *requested, char *buffer, size_t capacity) {
+  static const char path[] =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake";
+  const size_t length = sizeof(path) - 1;
+  const size_t requested_length = strlen(requested);
+
+  if (strncmp(requested, "/proc/", 6) == 0 &&
+      requested_length >= 4 &&
+      strcmp(requested + requested_length - 4, "/exe") == 0) {
+    if (capacity < length) {
+      return -1;
+    }
+    memcpy(buffer, path, length);
+    return (ssize_t)length;
+  }
+
+  static ssize_t (*actual_readlink)(const char *, char *, size_t);
+  if (actual_readlink == NULL) {
+    actual_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  return actual_readlink(requested, buffer, capacity);
+}
