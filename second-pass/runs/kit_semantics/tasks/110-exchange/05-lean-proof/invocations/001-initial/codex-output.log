      if operator = "%" then
        if y = 2 then some (SortVal.inj_SortFloat (floatModTwo x)) else none
      else if operator = "+" then
        some (SortVal.inj_SortFloat (x + intToFloat y))
      else if operator = "-" then
        some (SortVal.inj_SortFloat (x - intToFloat y))
      else if operator = "*" then
        some (SortVal.inj_SortFloat (x * intToFloat y))
      else if operator = "/" then
        some (SortVal.inj_SortFloat (x / intToFloat y))
      else if operator = "**" then
        some (SortVal.inj_SortFloat (x ^ intToFloat y))
