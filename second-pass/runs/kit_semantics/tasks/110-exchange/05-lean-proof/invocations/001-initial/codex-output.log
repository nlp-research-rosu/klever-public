+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», _ => true
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail, right =>
+      codeIn head right && subsetCodes tail right
