Module(
  FuncDef("exchange", Params("lst1", "lst2"),
    Assign(Name("even_count"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst1"),
      If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
        AugAssign(Name("even_count"), "+", Int(1)),
        ))
    For(Name("value"), Name("lst2"),
      If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
        AugAssign(Name("even_count"), "+", Int(1)),
        ))
    If(Compare(
      Name("even_count"),
      CmpOp(">=", Call(Name("len"), Name("lst1")))),
      Return(Str("YES")),
      )
    Return(Str("NO")))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(1), Int(2), Int(3), Int(4)),
        ListExpr(Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(1), Int(2), Int(3), Int(4)),
        ListExpr(Int(1), Int(5), Int(3), Int(4))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(Name("exchange"), ListExpr(Int(2)), ListExpr(Int(1))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(Name("exchange"), ListExpr(Int(1)), ListExpr(Int(2))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(Name("exchange"), ListExpr(Int(1), Int(3)), ListExpr(Int(2))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(2))),
        ListExpr(Int(0))),
      CmpOp("==", Str("YES")))))
