Module(
  FuncDef("exchange", Params("lst1", "lst2"),
    Assign(Name("even_count"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst1"),
      If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
        AugAssign(Name("even_count"), "+", Int(1)),
        ))
    For(Name("value"), Name("lst2"),
      If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
        AugAssign(Name("even_count"), "+", Int(1)),
        ))
    If(Compare(
      Name("even_count"),
      CmpOp(">=", Call(Name("len"), Name("lst1")))),
      Return(Str("YES")),
      )
    Return(Str("NO")))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Float(1.0), Float(2.0)),
        ListExpr(Float(4.0))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Bool(true), Bool(false)),
        ListExpr(Int(2))),
      CmpOp("==", Str("YES")))))
