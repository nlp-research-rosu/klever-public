   168	    => evenCount(VS)
   169	    requires definedProjectBool(V)
   170	     andBool pyMod(boolToInt(projectBoolTotal(V)), 2) =/=Int 0
   171	    [simplification]
   172	  rule evenCount(vCons(V:Val, VS:ValSeq))
   173	    => 1 +Int evenCount(VS)
   174	    requires definedProjectFloat(V)
   175	     andBool eqF(
   176	       floatMod(projectFloatTotal(V), 2.0),
   177	       0.0)
   178	    [simplification]
   179	  rule evenCount(vCons(V:Val, VS:ValSeq))
   180	    => evenCount(VS)
   181	    requires definedProjectFloat(V)
   182	     andBool notBool eqF(
   183	       floatMod(projectFloatTotal(V), 2.0),
   184	       0.0)
   185	    [simplification]
   186	
   187	  // The specified answer: exchanges exist exactly when the combined pool
   188	  // contains at least as many even values as the length of lst1.
   189	  syntax Str ::= exchangeResult(ValSeq, ValSeq) [function, total]
   190	  rule exchangeResult(VS1:ValSeq, VS2:ValSeq) => str(strToCodes("YES"))
   191	    requires evenCount(VS1) +Int evenCount(VS2) >=Int vsLen(VS1)
   192	  rule exchangeResult(VS1:ValSeq, VS2:ValSeq) => str(strToCodes("NO"))
   193	    requires evenCount(VS1) +Int evenCount(VS2) <Int vsLen(VS1)
   194	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Four mutually recursive cases form one universal invariant for both
     7	  // syntactic loops: empty, Int head, Bool head, and Float head.  The tail in
     8	  // every step case is an arbitrary numeric ValSeq, so heterogeneous lists are
     9	  // covered at unbounded length.
    10	  claim [count-loop-empty]:
    11	    <k>
    12	      #loop(list(.ValSeq), Name("value"), countBody)
    13	      => .K
    14	      ...
    15	    </k>
    16	    <env> L:Int </env>
    17	    <scopes>
    18	      ...
    19	      L |-> scope(
    20	        ("lst1" |-> INPUT1:Val)
    21	        ("lst2" |-> INPUT2:Val)
    22	        ("even_count" |-> C:Int)
    23	        ("value" |-> V0:Val)
    24	        .Map,
    25	        parent(0))
    26	      ...
    27	    </scopes>
    28	    <heap> .Map </heap>
    29	
    30	  claim [count-loop-int]:
    31	    <k>
    32	      #loop(list(vCons(I:Int, VS:ValSeq)), Name("value"), countBody)
    33	      => .K
    34	      ...
    35	    </k>
    36	    <env> L:Int </env>
    37	    <scopes>
    38	      ...
    39	      L |-> scope(
    40	        ("lst1" |-> INPUT1:Val)
    41	        ("lst2" |-> INPUT2:Val)
    42	        ("even_count" |->
    43	          (C:Int => C +Int evenCount(vCons(I, VS))))
    44	        ("value" |-> (_V0:Val => ?V1:Val))
    45	        .Map,
    46	        parent(0))
    47	      ...
    48	    </scopes>
    49	    <heap> .Map </heap>
    50	    requires allNumbers(VS)
    51	
    52	  claim [count-loop-bool]:
    53	    <k>
    54	      #loop(list(vCons(B:Bool, VS:ValSeq)), Name("value"), countBody)
    55	      => .K
    56	      ...
    57	    </k>
    58	    <env> L:Int </env>
    59	    <scopes>
    60	      ...
    61	      L |-> scope(
    62	        ("lst1" |-> INPUT1:Val)
    63	        ("lst2" |-> INPUT2:Val)
    64	        ("even_count" |->
    65	          (C:Int => C +Int evenCount(vCons(B, VS))))
    66	        ("value" |-> (_V0:Val => ?V1:Val))
    67	        .Map,
    68	        parent(0))
    69	      ...
    70	    </scopes>
    71	    <heap> .Map </heap>
    72	    requires allNumbers(VS)
    73	
    74	  claim [count-loop-float]:
    75	    <k>
    76	      #loop(list(vCons(F:Float, VS:ValSeq)), Name("value"), countBody)
    77	      => .K
    78	      ...
    79	    </k>
    80	    <env> L:Int </env>
    81	    <scopes>
    82	      ...
    83	      L |-> scope(
    84	        ("lst1" |-> INPUT1:Val)
    85	        ("lst2" |-> INPUT2:Val)
    86	        ("even_count" |->
    87	          (C:Int => C +Int evenCount(vCons(F, VS))))
    88	        ("value" |-> (_V0:Val => ?V1:Val))
    89	        .Map,
    90	        parent(0))
    91	      ...
    92	    </scopes>
    93	    <heap> .Map </heap>
    94	    requires allNumbers(VS)
    95	
    96	  // Full entry-point theorem over arbitrary non-empty finite integer lists.
    97	  // All fixed semantics state starts in the reference initial configuration;
    98	  // the returned value, normal control state, and absence of side effects are
    99	  // observed at termination.
   100	  claim [exchange]:
   101	    <k>
   102	      #loadAll(exchangeProgram)
   103	      ~> Call(
   104	           Name("exchange"),
