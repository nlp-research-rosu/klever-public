index 0000000000000000000000000000000000000000..9fbbe7d1a4502f44995f0e783ea643319c252750
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,20 @@
+def exchange(lst1, lst2):
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
+
+
+assert exchange([1, 2, 3, 4], [1, 2, 3, 4]) == "YES"
+assert exchange([1, 2, 3, 4], [1, 5, 3, 4]) == "NO"
+assert exchange([2], [1]) == "YES"
+assert exchange([1], [2]) == "YES"
+assert exchange([1, 3], [2]) == "NO"
+assert exchange([-3, -2], [0]) == "YES"
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cddb523f6aa23776e3cc98d9371d99f4f6da129c
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module CONNECTION-SPEC
+  imports VERIFICATION-BASE
+
+  // These claims deliberately import VERIFICATION-BASE, not VERIFICATION, so
+  // the operational parity bridge is unavailable while its value is proved.
+  claim [parity-int]:
+    <k>
+      applyCmp("==", applyBin("%", I:Int, 2), 0)
+      => numberEven(I)
+      ...
+    </k>
+
+  claim [parity-bool]:
+    <k>
+      applyCmp("==", applyBin("%", B:Bool, 2), 0)
+      => numberEven(B)
+      ...
+    </k>
+
+  claim [parity-float]:
+    <k>
+      applyCmp("==", applyBin("%", F:Float, 2), 0)
+      => numberEven(F)
+      ...
+    </k>
+
+  // Source-expression execution reaches the same connected value under the
+  // bridge-free definition, including literal evaluation and operator routing.
+  claim [parity-int-exec]:
+    <k>
+      Compare(BinOp("%", I:Int, 2), CmpOp("==", Int(0)))
+      => numberEven(I)
+      ...
+    </k>
+
+  claim [parity-bool-exec]:
+    <k>
+      Compare(BinOp("%", B:Bool, 2), CmpOp("==", Int(0)))
+      => numberEven(B)
+      ...
+    </k>
+
+  claim [parity-float-exec]:
+    <k>
+      Compare(BinOp("%", F:Float, 2), CmpOp("==", Int(0)))
+      => numberEven(F)
+      ...
+    </k>
+endmodule
diff --git a/connection-wrong-spec.k b/connection-wrong-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..eb26787a3ebbaf517fb047a7dcdb039f5b23734f
