   111	      (0 |-> scope(.Map, parent(-1)))
   112	      (-1 |-> builtinsScope)
   113	      =>
   114	      ?FINALSCOPES:Map
   115	    </scopes>
   116	    <scopeLoc> 1 </scopeLoc>
   117	    <heap> .Map </heap>
   118	    <heapLoc> 0 </heapLoc>
   119	    <stack> .List </stack>
