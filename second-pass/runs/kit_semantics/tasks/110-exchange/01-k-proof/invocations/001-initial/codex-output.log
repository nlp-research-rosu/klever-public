+def exchange(lst1, lst2):
+    """Return whether exchanges can make every element of lst1 even."""
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d220a205837c31afb751b6adac2c24bbaa9756f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,53 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // One universal loop theorem applies to both syntactic for-loops, whose
+  // bodies and state footprints are identical.
+  claim [count-loop]:
+    <k>
+      #loop(list(intVals(IS:IntSeq)), Name("value"), countBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("even_count" |-> (C:Int => C +Int evenCount(intVals(IS))))
+        ("value" |-> (_V0:Val => ?V1:Val))
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+
+  // Full entry-point theorem over arbitrary non-empty finite integer lists.
+  // All fixed semantics state starts in the reference initial configuration;
+  // the returned value, normal control state, and absence of side effects are
+  // observed at termination.
+  claim [exchange]:
+    <k>
+      #loadAll(exchangeProgram)
+      ~> Call(
+           Name("exchange"),
+           list(intVals(IS1:IntSeq)),
+           list(intVals(IS2:IntSeq)))
+      => exchangeResult(IS1, IS2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(IS1) >Int 0 andBool isLen(IS2) >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d770476022dbb27fce708e5c00b8416fda46b981
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact syntax abbreviations for solution.mpy.  These are expanded as
+  // macros; they do not replace or shortcut any operational execution.
+  syntax Stmts ::= "countBody" [macro]
+  rule countBody
+    => If(
+         Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+         AugAssign(Name("even_count"), "+", Int(1)),
+         .Stmts)
+
+  syntax Stmts ::= "exchangeBody" [macro]
+  rule exchangeBody
+    => Expr(Str("Return whether exchanges can make every element of lst1 even."))
+       Assign(Name("even_count"), Int(0))
+       Assign(Name("value"), Int(0))
+       For(Name("value"), Name("lst1"), countBody)
+       For(Name("value"), Name("lst2"), countBody)
+       If(
+         Compare(
+           Name("even_count"),
+           CmpOp(">=", Call(Name("len"), Name("lst1"), .Exprs))),
+         Return(Str("YES")),
+         .Stmts)
+       Return(Str("NO"))
+
+  syntax Module ::= "exchangeProgram" [macro]
+  rule exchangeProgram
+    => Module(FuncDef(
+         "exchange",
+         Params("lst1", "lst2"),
+         exchangeBody))
+
+  // Embed an arbitrary finite sequence of mathematical integers into the
+  // reference semantics' heterogeneous Python-list representation.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS))
+
+  // Mathematical count of even integer values in a Python value sequence.
+  // The final equation makes the function total outside the theorem's
+  // integer-list domain by ignoring non-integer values.
+  syntax Int ::= evenCount(ValSeq) [function, total]
+  rule evenCount(.ValSeq) => 0
+  rule evenCount(vCons(I:Int, VS:ValSeq)) => 1 +Int evenCount(VS)
+    requires pyMod(I, 2) ==Int 0
+  rule evenCount(vCons(I:Int, VS:ValSeq)) => evenCount(VS)
+    requires pyMod(I, 2) =/=Int 0
+  rule evenCount(vCons(_V:Val, VS:ValSeq)) => evenCount(VS) [owise]
+
+  // The specified answer: exchanges exist exactly when the combined pool
+  // contains at least as many even values as the length of lst1.
+  syntax Str ::= exchangeResult(IntSeq, IntSeq) [function, total]
+  rule exchangeResult(IS1:IntSeq, IS2:IntSeq) => str(strToCodes("YES"))
+    requires evenCount(intVals(IS1)) +Int evenCount(intVals(IS2))
+             >=Int vsLen(intVals(IS1))
+  rule exchangeResult(IS1:IntSeq, IS2:IntSeq) => str(strToCodes("NO"))
+    requires evenCount(intVals(IS1)) +Int evenCount(intVals(IS2))
+             <Int vsLen(intVals(IS1))
+endmodule

