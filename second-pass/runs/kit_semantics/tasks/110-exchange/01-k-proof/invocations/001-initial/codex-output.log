@@ -0,0 +1,13 @@
+def exchange(lst1, lst2):
+    """Return whether exchanges can make every element of lst1 even."""
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7a06c448f6b58824a06e167f7da24284edb6f097
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,125 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Four mutually recursive cases form one universal invariant for both
+  // syntactic loops: empty, Int head, Bool head, and Float head.  The tail in
+  // every step case is an arbitrary numeric ValSeq, so heterogeneous lists are
+  // covered at unbounded length.
+  claim [count-loop-empty]:
+    <k>
+      #loop(list(.ValSeq), Name("value"), countBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("lst1" |-> INPUT1:Val)
+        ("lst2" |-> INPUT2:Val)
+        ("even_count" |-> C:Int)
+        ("value" |-> V0:Val)
+        .Map,
+        parent(0))
+      ...
+    </scopes>
+    <heap> .Map </heap>
+
+  claim [count-loop-int]:
+    <k>
+      #loop(list(vCons(I:Int, VS:ValSeq)), Name("value"), countBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("lst1" |-> INPUT1:Val)
+        ("lst2" |-> INPUT2:Val)
+        ("even_count" |->
+          (C:Int => C +Int evenCount(vCons(I, VS))))
+        ("value" |-> (_V0:Val => ?V1:Val))
+        .Map,
+        parent(0))
+      ...
+    </scopes>
+    <heap> .Map </heap>
+    requires allNumbers(VS)
+
+  claim [count-loop-bool]:
+    <k>
+      #loop(list(vCons(B:Bool, VS:ValSeq)), Name("value"), countBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("lst1" |-> INPUT1:Val)
+        ("lst2" |-> INPUT2:Val)
+        ("even_count" |->
+          (C:Int => C +Int evenCount(vCons(B, VS))))
+        ("value" |-> (_V0:Val => ?V1:Val))
+        .Map,
+        parent(0))
+      ...
+    </scopes>
+    <heap> .Map </heap>
+    requires allNumbers(VS)
+
+  claim [count-loop-float]:
+    <k>
+      #loop(list(vCons(F:Float, VS:ValSeq)), Name("value"), countBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("lst1" |-> INPUT1:Val)
+        ("lst2" |-> INPUT2:Val)
+        ("even_count" |->
+          (C:Int => C +Int evenCount(vCons(F, VS))))
+        ("value" |-> (_V0:Val => ?V1:Val))
+        .Map,
+        parent(0))
+      ...
+    </scopes>
+    <heap> .Map </heap>
+    requires allNumbers(VS)
+
+  // Full entry-point theorem over arbitrary non-empty finite integer lists.
+  // All fixed semantics state starts in the reference initial configuration;
+  // the returned value, normal control state, and absence of side effects are
+  // observed at termination.
+  claim [exchange]:
+    <k>
+      #loadAll(exchangeProgram)
+      ~> Call(
+           Name("exchange"),
+           list(VS1:ValSeq),
+           list(VS2:ValSeq))
+      => exchangeResult(VS1, VS2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumbers(VS1) andBool allNumbers(VS2)
+      andBool vsLen(VS1) >Int 0 andBool vsLen(VS2) >Int 0
+endmodule
