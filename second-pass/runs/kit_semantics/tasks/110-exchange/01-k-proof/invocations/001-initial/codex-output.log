diff --git a/concrete-numeric-tests.py b/concrete-numeric-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..71462d89f7d049a2fae65b4b44e37cdd24037d93
--- /dev/null
+++ b/concrete-numeric-tests.py
@@ -0,0 +1,16 @@
+def exchange(lst1, lst2):
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
+
+
+assert exchange([1.0, 2.0], [4.0]) == "YES"
+assert exchange([True, False], [2]) == "YES"
