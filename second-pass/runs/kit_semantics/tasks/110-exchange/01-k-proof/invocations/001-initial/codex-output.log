   109	
   110	  // A recursive domain predicate keeps every dynamic list head in the full
   111	  // numeric domain represented by the reference model.
   112	  syntax Bool ::= allNumbers(ValSeq) [function, total]
   113	  rule allNumbers(.ValSeq) => true
   114	  rule allNumbers(vCons(V:Val, VS:ValSeq))
   115	    => (definedProjectInt(V)
   116	        orBool definedProjectBool(V)
   117	        orBool definedProjectFloat(V))
   118	       andBool allNumbers(VS)
   119	
   120	  // Restate each static modulo equation at the dynamic Val boundary.
   121	  rule applyBin("%", V:Val, I:Int) => pyMod(projectIntTotal(V), I)
   122	    requires definedProjectInt(V)
   123	    [simplification]
   124	  rule applyBin("%", V:Val, I:Int)
   125	    => pyMod(boolToInt(projectBoolTotal(V)), I)
   126	    requires definedProjectBool(V)
   127	    [simplification]
   128	  rule applyBin("%", V:Val, 2)
