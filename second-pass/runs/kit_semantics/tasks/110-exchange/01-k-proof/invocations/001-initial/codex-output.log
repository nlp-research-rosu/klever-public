+++ b/k-numeric-tests.py
@@ -0,0 +1,24 @@
+def exchange(lst1, lst2):
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
+
+
+assert exchange([1.0, 2.0], [4.0]) == "YES"
+assert exchange([1.5, 2.0], [3.5]) == "NO"
+assert exchange([-4.0, -3.0], [0.0]) == "YES"
+assert exchange([-1.5], [2.0]) == "YES"
+assert exchange([True, False], [2]) == "YES"
+assert exchange([True], [False]) == "YES"
+assert exchange([True, True], [False]) == "NO"
+assert exchange([1, 3.0], [2.0, False]) == "YES"
+assert exchange([2.0, True, 4], [3.5]) == "NO"
+assert exchange([2.0, False, 4], [3.5]) == "YES"
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb360706d7abdc8550241e4e11c3875eaf5ac179
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def exchange(lst1, lst2):
+    """Return whether exchanges can make every element of lst1 even."""
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..fe7ec76c580a3acff835ffe9d49d6b60b7de4e4c
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,62 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Both loop conditions are materially mutated from `% 2 == 0` to
+  // `% 2 == 1`.  On [2], [2], the original returns "YES" and this mutant
+  // returns "NO", so the original postcondition must be rejected.
+  claim [odd-count-mutant]:
+    <k>
+      #loadAll(Module(FuncDef(
+        "exchange",
+        Params("lst1", "lst2"),
+        Expr(Str("Return whether exchanges can make every element of lst1 even."))
+        Assign(Name("even_count"), Int(0))
+        Assign(Name("value"), Int(0))
+        For(
+          Name("value"),
+          Name("lst1"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(1))),
+            AugAssign(Name("even_count"), "+", Int(1)),
+            .Stmts))
+        For(
+          Name("value"),
+          Name("lst2"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(1))),
+            AugAssign(Name("even_count"), "+", Int(1)),
+            .Stmts))
+        If(
+          Compare(
+            Name("even_count"),
+            CmpOp(">=", Call(Name("len"), Name("lst1"), .Exprs))),
+          Return(Str("YES")),
+          .Stmts)
+        Return(Str("NO")))))
+      ~> Call(
+           Name("exchange"),
+           list(vCons(2, .ValSeq)),
+           list(vCons(2, .ValSeq)))
+      => str(strToCodes("YES"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
