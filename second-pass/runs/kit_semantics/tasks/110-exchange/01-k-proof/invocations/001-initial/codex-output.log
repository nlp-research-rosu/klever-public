+requires "verification.k"
+
+module CONNECTION-SPEC
+  imports VERIFICATION-BASE
+
+  // These claims deliberately import VERIFICATION-BASE, not VERIFICATION, so
+  // the operational parity bridge is unavailable while its value is proved.
+  claim [parity-int]:
+    <k>
+      Compare(BinOp("%", I:Int, 2), CmpOp("==", Int(0)))
+      => numberEven(I)
+      ...
+    </k>
+
+  claim [parity-bool]:
+    <k>
+      Compare(BinOp("%", B:Bool, 2), CmpOp("==", Int(0)))
+      => numberEven(B)
+      ...
+    </k>
+
+  claim [parity-float]:
+    <k>
+      Compare(BinOp("%", F:Float, 2), CmpOp("==", Int(0)))
+      => numberEven(F)
+      ...
+    </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb360706d7abdc8550241e4e11c3875eaf5ac179
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def exchange(lst1, lst2):
+    """Return whether exchanges can make every element of lst1 even."""
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
