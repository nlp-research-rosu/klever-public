+      => numberEven(I)
+      ...
+    </k>
+
+  claim [parity-bool]:
+    <k>
+      Compare(BinOp("%", B:Bool, 2), CmpOp("==", Int(0)))
+      => numberEven(B)
+      ...
+    </k>
+
+  claim [parity-float]:
+    <k>
+      Compare(BinOp("%", F:Float, 2), CmpOp("==", Int(0)))
+      => numberEven(F)
+      ...
