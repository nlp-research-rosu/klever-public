+  syntax Stmts ::= "countBody" [macro]
+  rule countBody
+    => If(
+         Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+         AugAssign(Name("even_count"), "+", Int(1)),
+         .Stmts)
+
+  syntax Stmts ::= "exchangeBody" [macro]
+  rule exchangeBody
+    => Expr(Str("Return whether exchanges can make every element of lst1 even."))
+       Assign(Name("even_count"), Int(0))
+       Assign(Name("value"), Int(0))
+       For(Name("value"), Name("lst1"), countBody)
+       For(Name("value"), Name("lst2"), countBody)
+       If(
+         Compare(
+           Name("even_count"),
+           CmpOp(">=", Call(Name("len"), Name("lst1"), .Exprs))),
+         Return(Str("YES")),
+         .Stmts)
+       Return(Str("NO"))
+
+  syntax Module ::= "exchangeProgram" [macro]
+  rule exchangeProgram
+    => Module(FuncDef(
+         "exchange",
+         Params("lst1", "lst2"),
+         exchangeBody))
+
+  // Embed an arbitrary finite sequence of mathematical integers into the
+  // reference semantics' heterogeneous Python-list representation.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS))
+
+  // The reference list iterator exposes its head at the dynamic Val sort.
+  // This guarded total projection is the standard defined-cast twin used to
+  // recover the Int subsort known from intVals without manufacturing a value.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
+    [simplification]
+
+  // intVals emits only Int heads.  This characterization and the dispatch
+  // twin restate the existing MPY-INT equation at the dynamic Val boundary.
+  rule isInt(V:Val) => true
+    requires intVals(_IS:IntSeq) ==K vCons(V, _REST:ValSeq)
+    [simplification]
+  rule applyBin("%", V:Val, I:Int) => pyMod(projectIntTotal(V), I)
+    requires isInt(V)
+    [simplification]
+
+  // Mathematical count of even integer values in a Python value sequence.
+  // The final equation makes the function total outside the theorem's
+  // integer-list domain by ignoring non-integer values.
+  syntax Int ::= evenCount(ValSeq) [function, total]
+  rule evenCount(.ValSeq) => 0
+  rule evenCount(vCons(I:Int, VS:ValSeq)) => 1 +Int evenCount(VS)
+    requires pyMod(I, 2) ==Int 0
+  rule evenCount(vCons(I:Int, VS:ValSeq)) => evenCount(VS)
+    requires pyMod(I, 2) =/=Int 0
+  rule evenCount(vCons(_V:Val, VS:ValSeq)) => evenCount(VS) [owise]
+
+  // The specified answer: exchanges exist exactly when the combined pool
+  // contains at least as many even values as the length of lst1.
+  syntax Str ::= exchangeResult(IntSeq, IntSeq) [function, total]
+  rule exchangeResult(IS1:IntSeq, IS2:IntSeq) => str(strToCodes("YES"))
+    requires evenCount(intVals(IS1)) +Int evenCount(intVals(IS2))
+             >=Int vsLen(intVals(IS1))
+  rule exchangeResult(IS1:IntSeq, IS2:IntSeq) => str(strToCodes("NO"))
+    requires evenCount(intVals(IS1)) +Int evenCount(intVals(IS2))
+             <Int vsLen(intVals(IS1))
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..9fbbe7d1a4502f44995f0e783ea643319c252750
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,20 @@
+def exchange(lst1, lst2):
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
+
+
+assert exchange([1, 2, 3, 4], [1, 2, 3, 4]) == "YES"
+assert exchange([1, 2, 3, 4], [1, 5, 3, 4]) == "NO"
+assert exchange([2], [1]) == "YES"
+assert exchange([1], [2]) == "YES"
+assert exchange([1, 3], [2]) == "NO"
+assert exchange([-3, -2], [0]) == "YES"
