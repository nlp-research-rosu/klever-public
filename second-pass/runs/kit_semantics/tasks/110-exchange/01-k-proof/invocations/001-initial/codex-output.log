   131	    [simplification]
   132	
   133	  // Mathematical count of even numeric values in a Python value sequence.
   134	  // The final equation totalizes the summary outside the numeric theorem
   135	  // domain by ignoring non-numeric values.
   136	  syntax Int ::= evenCount(ValSeq) [function, total]
   137	  rule evenCount(.ValSeq) => 0
   138	  rule evenCount(vCons(I:Int, VS:ValSeq)) => 1 +Int evenCount(VS)
   139	    requires pyMod(I, 2) ==Int 0
   140	  rule evenCount(vCons(I:Int, VS:ValSeq)) => evenCount(VS)
   141	    requires pyMod(I, 2) =/=Int 0
   142	  rule evenCount(vCons(B:Bool, VS:ValSeq)) => 1 +Int evenCount(VS)
   143	    requires pyMod(boolToInt(B), 2) ==Int 0
   144	  rule evenCount(vCons(B:Bool, VS:ValSeq)) => evenCount(VS)
   145	    requires pyMod(boolToInt(B), 2) =/=Int 0
   146	  rule evenCount(vCons(F:Float, VS:ValSeq)) => 1 +Int evenCount(VS)
