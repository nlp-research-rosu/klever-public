   148	  rule evenCount(vCons(F:Float, VS:ValSeq)) => evenCount(VS)
   149	    requires notBool eqF(floatMod(F, 2.0), 0.0)
   150	  rule evenCount(vCons(_V:Val, VS:ValSeq)) => evenCount(VS) [owise]
   151	
   152	  rule evenCount(vCons(V:Val, VS:ValSeq))
   153	    => 1 +Int evenCount(VS)
   154	    requires definedProjectInt(V)
   155	     andBool pyMod(projectIntTotal(V), 2) ==Int 0
   156	    [simplification]
   157	  rule evenCount(vCons(V:Val, VS:ValSeq))
   158	    => evenCount(VS)
   159	    requires definedProjectInt(V)
   160	     andBool pyMod(projectIntTotal(V), 2) =/=Int 0
   161	    [simplification]
   162	  rule evenCount(vCons(V:Val, VS:ValSeq))
