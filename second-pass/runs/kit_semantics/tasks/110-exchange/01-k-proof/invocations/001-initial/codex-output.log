    39	  // to recover numeric subsorts without manufacturing values.
    40	  syntax Bool ::= definedProjectInt(Val) [function, total]
    41	  rule definedProjectInt(V:Val) => isInt(V)
    42	
    43	  syntax Int ::= projectIntTotal(Val)
    44	    [function, total, symbol(projectIntTotal), no-evaluators]
    45	
    46	  rule #Ceil({@V:Val}:>Int)
    47	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    48	    [simplification]
    49	
    50	  rule projectIntTotal(V:Val) => {V}:>Int
    51	    requires definedProjectInt(V)
    52	    [concrete, simplification(10), preserves-definedness]
    53	  rule {V:Val}:>Int => projectIntTotal(V)
    54	    requires definedProjectInt(V)
    55	    [symbolic(V), simplification, preserves-definedness]
    56	  rule projectIntTotal(I:Int) => I [simplification]
    57	  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
    58	    [simplification]
    59	
    60	  syntax Bool ::= definedProjectBool(Val) [function, total]
    61	  rule definedProjectBool(V:Val) => isBool(V)
    62	
    63	  syntax Bool ::= projectBoolTotal(Val)
    64	    [function, total, symbol(projectBoolTotal), no-evaluators]
    65	
    66	  rule #Ceil({@V:Val}:>Bool)
    67	    => ({ definedProjectBool(@V) #Equals true } #And #Ceil(@V))
    68	    [simplification]
    69	
    70	  rule projectBoolTotal(V:Val) => {V}:>Bool
    71	    requires definedProjectBool(V)
    72	    [concrete, simplification(10), preserves-definedness]
    73	  rule {V:Val}:>Bool => projectBoolTotal(V)
    74	    requires definedProjectBool(V)
    75	    [symbolic(V), simplification, preserves-definedness]
    76	  rule projectBoolTotal(B:Bool) => B [simplification]
    77	  rule projectBoolTotal(projectBoolTotal(V:Val)) => projectBoolTotal(V)
    78	    [simplification]
    79	
    80	  syntax Bool ::= definedProjectFloat(Val) [function, total]
