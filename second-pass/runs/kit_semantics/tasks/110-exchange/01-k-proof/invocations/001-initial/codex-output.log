/bin/bash -lc 'set +e
kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.count-loop > kprove-loop.out 2> kprove-loop.err
code=$?
printf '"'EXIT=%s\\n' \""'$code"
tail -200 kprove-loop.out
tail -180 kprove-loop.err
