+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("lst1" |-> INPUT1:Val)
+        ("lst2" |-> INPUT2:Val)
+        ("even_count" |-> (C:Int => C +Int evenCount(VS)))
+        ("value" |-> (_V0:Val => ?V1:Val))
+        .Map,
+        parent(0))
+      ...
+    </scopes>
+    <heap> .Map </heap>
+    requires allInts(VS)
