   102	  syntax Int ::= boolToInt(Bool) [function, total]
   103	  rule boolToInt(false) => 0
   104	  rule boolToInt(true) => 1
   105	
   106	  rule applyBin("%", B:Bool, I:Int) => pyMod(boolToInt(B), I)
   107	  rule applyBin("%", F:Float, 2) => floatMod(F, 2.0)
