+      applyCmp("==", applyBin("%", I:Int, 2), 0)
+      => numberEven(I)
+      ...
+    </k>
+
+  claim [parity-bool]:
+    <k>
+      applyCmp("==", applyBin("%", B:Bool, 2), 0)
+      => numberEven(B)
+      ...
+    </k>
+
+  claim [parity-float]:
