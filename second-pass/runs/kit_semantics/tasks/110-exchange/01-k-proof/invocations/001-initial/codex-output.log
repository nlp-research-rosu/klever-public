exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && set +e
kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.count-loop --depth 45 > depth-45.out 2> depth-45.err
code=$?
printf '"'EXIT=%s\\n' \""'$code"
tail -220 depth-45.out
tail -100 depth-45.err
exit 0' in /workspace
