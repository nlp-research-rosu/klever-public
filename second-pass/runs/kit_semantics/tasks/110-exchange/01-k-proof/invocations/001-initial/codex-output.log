diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..9fbbe7d1a4502f44995f0e783ea643319c252750
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,20 @@
+def exchange(lst1, lst2):
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
+
+
+assert exchange([1, 2, 3, 4], [1, 2, 3, 4]) == "YES"
+assert exchange([1, 2, 3, 4], [1, 5, 3, 4]) == "NO"
+assert exchange([2], [1]) == "YES"
+assert exchange([1], [2]) == "YES"
+assert exchange([1, 3], [2]) == "NO"
+assert exchange([-3, -2], [0]) == "YES"
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb360706d7abdc8550241e4e11c3875eaf5ac179
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def exchange(lst1, lst2):
+    """Return whether exchanges can make every element of lst1 even."""
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f8c93b20d75cc66d754ec9b8e1e23a05fb550bc8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // One universal loop theorem applies to both syntactic for-loops, whose
+  // bodies and state footprints are identical.
+  claim [count-loop]:
+    <k>
+      #loop(list(intVals(IS:IntSeq)), Name("value"), countBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("even_count" |-> (C:Int => C +Int evenCount(intVals(IS))))
+        ("value" |-> (_V0:Val => ?V1:Val))
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    requires notBool ("$cells" in_keys(REST))
+
+  // Full entry-point theorem over arbitrary non-empty finite integer lists.
+  // All fixed semantics state starts in the reference initial configuration;
+  // the returned value, normal control state, and absence of side effects are
+  // observed at termination.
+  claim [exchange]:
+    <k>
+      #loadAll(exchangeProgram)
+      ~> Call(
+           Name("exchange"),
+           list(intVals(IS1:IntSeq)),
+           list(intVals(IS2:IntSeq)))
+      => exchangeResult(IS1, IS2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(IS1) >Int 0 andBool isLen(IS2) >Int 0
+endmodule
