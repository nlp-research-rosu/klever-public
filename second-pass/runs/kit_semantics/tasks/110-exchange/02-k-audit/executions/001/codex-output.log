+          .Stmts)
+        Return(Str("NO")))))
+      ~> Call(
+           Name("exchange"),
+           list(vCons(2, .ValSeq)),
+           list(vCons(2, .ValSeq)))
+      => str(strToCodes("YES"))
+    </k>
+    <env> 0 </env>
+    <scopes>
