new file mode 100644
index 0000000000000000000000000000000000000000..4b602765f7777bf39e425c3e949470832f14a2ae
--- /dev/null
+++ b/evidence/stage4/body-mutation-spec.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module BODY-MUTATION-SPEC
+  imports VERIFICATION
+
+  // The actual executed program term is mutated to count odd values.
+  // On [2], [2] it returns NO, so the original expected YES must be rejected.
+  claim [odd-count-mutant]:
+    <k>
+      #loadAll(Module(FuncDef(
+        "exchange",
+        Params("lst1", "lst2"),
+        Expr(Str("Return whether exchanges can make every element of lst1 even."))
+        Assign(Name("even_count"), Int(0))
+        Assign(Name("value"), Int(0))
+        For(
+          Name("value"),
+          Name("lst1"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(1))),
+            AugAssign(Name("even_count"), "+", Int(1)),
+            .Stmts))
+        For(
+          Name("value"),
+          Name("lst2"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(1))),
+            AugAssign(Name("even_count"), "+", Int(1)),
+            .Stmts))
+        If(
+          Compare(
+            Name("even_count"),
+            CmpOp(">=", Call(Name("len"), Name("lst1"), .Exprs))),
+          Return(Str("YES")),
+          .Stmts)
+        Return(Str("NO")))))
+      ~> Call(
+           Name("exchange"),
+           list(vCons(2, .ValSeq)),
+           list(vCons(2, .ValSeq)))
+      => str(strToCodes("YES"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
