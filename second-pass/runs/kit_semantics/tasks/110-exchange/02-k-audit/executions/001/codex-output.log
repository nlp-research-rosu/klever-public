+++ b/evidence/stage3/run_positive_claims.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd /tmp/audit-work/scratch/proof
+
+run_claim() {
+  local definition=$1
+  local spec_file=$2
+  local spec_module=$3
+  local label=$4
+  printf '\nCOMMAND: kprove %s --definition %s --spec-module %s --claims %s\n' \
+    "$spec_file" "$definition" "$spec_module" "$label"
+  set +e
+  kprove "$spec_file" \
+    --definition "$definition" \
+    --spec-module "$spec_module" \
+    --claims "$label"
+  local status=$?
+  set -e
+  printf 'EXIT STATUS: %d (%s)\n' "$status" "$label"
+  if [[ $status -ne 0 ]]; then
+    return "$status"
+  fi
+}
+
+run_claim verification-base-rebuilt connection-spec.k CONNECTION-SPEC \
+  CONNECTION-SPEC.parity-int
+run_claim verification-base-rebuilt connection-spec.k CONNECTION-SPEC \
+  CONNECTION-SPEC.parity-bool
+run_claim verification-base-rebuilt connection-spec.k CONNECTION-SPEC \
+  CONNECTION-SPEC.parity-float
+run_claim verification-base-rebuilt connection-spec.k CONNECTION-SPEC \
+  CONNECTION-SPEC.parity-int-exec
+run_claim verification-base-rebuilt connection-spec.k CONNECTION-SPEC \
+  CONNECTION-SPEC.parity-bool-exec
+run_claim verification-base-rebuilt connection-spec.k CONNECTION-SPEC \
+  CONNECTION-SPEC.parity-float-exec
+run_claim verification-rebuilt spec.k SPEC SPEC.count-loop
+run_claim verification-rebuilt spec.k SPEC SPEC.exchange
diff --git a/evidence/stage4/body-mutation-spec.k b/evidence/stage4/body-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b602765f7777bf39e425c3e949470832f14a2ae
--- /dev/null
+++ b/evidence/stage4/body-mutation-spec.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module BODY-MUTATION-SPEC
+  imports VERIFICATION
+
+  // The actual executed program term is mutated to count odd values.
+  // On [2], [2] it returns NO, so the original expected YES must be rejected.
+  claim [odd-count-mutant]:
+    <k>
+      #loadAll(Module(FuncDef(
+        "exchange",
+        Params("lst1", "lst2"),
+        Expr(Str("Return whether exchanges can make every element of lst1 even."))
+        Assign(Name("even_count"), Int(0))
+        Assign(Name("value"), Int(0))
+        For(
+          Name("value"),
+          Name("lst1"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(1))),
+            AugAssign(Name("even_count"), "+", Int(1)),
+            .Stmts))
+        For(
+          Name("value"),
+          Name("lst2"),
+          If(
+            Compare(
+              BinOp("%", Name("value"), Int(2)),
+              CmpOp("==", Int(1))),
+            AugAssign(Name("even_count"), "+", Int(1)),
+            .Stmts))
+        If(
+          Compare(
+            Name("even_count"),
+            CmpOp(">=", Call(Name("len"), Name("lst1"), .Exprs))),
+          Return(Str("YES")),
+          .Stmts)
+        Return(Str("NO")))))
+      ~> Call(
+           Name("exchange"),
+           list(vCons(2, .ValSeq)),
+           list(vCons(2, .ValSeq)))
+      => str(strToCodes("YES"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
