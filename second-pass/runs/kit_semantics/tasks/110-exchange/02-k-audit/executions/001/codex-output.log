import hashlib
from pathlib import Path
for root in [Path('/reference/reference-semantics'),Path('/generation-evidence/codex-trace'),Path('/candidate')]:
    files=sorted(p for p in root.rglob('*') if p.is_file())
    for tag, data in [
      ('bytes', b''.join(p.read_bytes() for p in files)),
      ('path-bytes', b''.join(p.relative_to(root).as_posix().encode()+b'\\0'+p.read_bytes() for p in files)),
      ('path-hash', b''.join(p.relative_to(root).as_posix().encode()+b'\\0'+hashlib.sha256(p.read_bytes()).hexdigest().encode()+b'\\n' for p in files)),
    ]: print(root, tag, hashlib.sha256(data).hexdigest(),len(files))
