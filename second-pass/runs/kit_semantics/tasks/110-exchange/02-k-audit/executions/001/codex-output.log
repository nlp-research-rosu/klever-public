diff --git a/evidence/stage5/opposite-odd-spec.k b/evidence/stage5/opposite-odd-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fe53d98d00b955bfdba18b0743a9b39b81d2725c
--- /dev/null
+++ b/evidence/stage5/opposite-odd-spec.k
@@ -0,0 +1,9 @@
