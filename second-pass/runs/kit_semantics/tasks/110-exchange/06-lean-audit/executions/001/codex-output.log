    57	def intSeqLt : SortIntSeq → SortIntSeq → SortBool
    58	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
    59	      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
    60	  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
