+
+example :
+    applyBin? "%" (SortVal.inj_SortBool true) (SortVal.inj_SortInt 3) =
+      none := by
+  rfl
+
+example :
+    definedProjectInt (SortVal.inj_SortInt 7) = true ∧
+    definedProjectBool (SortVal.inj_SortInt 7) = false ∧
+    definedProjectFloat (SortVal.inj_SortInt 7) = false := by
