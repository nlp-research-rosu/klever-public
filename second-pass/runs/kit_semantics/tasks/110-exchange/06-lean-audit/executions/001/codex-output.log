   190	noncomputable def equality?
   191	    (left right : SortVal) : Option SortBool :=
   192	  match right with
   193	  | SortVal.«noneV_MPY-CORE_Val» => some (kEqual left right)
   194	  | _ =>
   195	    match left, right with
   196	    | SortVal.inj_SortInt x, SortVal.inj_SortInt y => some (x == y)
   197	    | SortVal.inj_SortBool x, SortVal.inj_SortBool y => some (x == y)
   198	    | SortVal.inj_SortFloat x, SortVal.inj_SortFloat y =>
   199	        some (floatEq x y)
   200	    | SortVal.inj_SortInt x, SortVal.inj_SortFloat y =>
   201	        some (floatEq (intToFloat x) y)
   202	    | SortVal.inj_SortFloat x, SortVal.inj_SortInt y =>
   203	        if y = 0 then some (floatEq x (0.0 : SortFloat))
   204	        else some (floatEq x (intToFloat y))
   205	    | SortVal.inj_SortStr
   206	        (SortStr.«str(_)_MPY-CORE_Str_IntSeq» leftCodes),
   207	        SortVal.inj_SortStr
   208	        (SortStr.«str(_)_MPY-CORE_Str_IntSeq» rightCodes) =>
   209	        some (kEqual leftCodes rightCodes)
   210	    | SortVal.inj_SortIterable
   211	        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» leftValues),
   212	        SortVal.inj_SortIterable
   213	        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
   214	        some (kEqual leftValues rightValues)
   215	    | SortVal.inj_SortIterable
   216	        (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» leftValues),
   217	        SortVal.inj_SortIterable
   218	        (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
   219	        some (kEqual leftValues rightValues)
   220	    | SortVal.«setV(_)_MPY-SET_Val_IntSeq» leftCodes,
   221	        SortVal.«setV(_)_MPY-SET_Val_IntSeq» rightCodes =>
   222	        some (sameSet leftCodes rightCodes)
   223	    | SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» leftKeys leftValues,
   224	        SortVal.«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» rightKeys rightValues =>
   225	        some (dictEqual leftKeys leftValues rightKeys rightValues)
   226	    | _, _ => none
