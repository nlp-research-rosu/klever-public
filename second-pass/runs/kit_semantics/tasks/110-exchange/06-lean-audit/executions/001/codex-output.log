diff --git a//tmp/audit-work/proc_self_exe_shim.c b//tmp/audit-work/proc_self_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..02d0927e8f937548b561ba79d530fa803f18514c
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_shim.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn original;
+  if (original == NULL) {
+    original = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  const size_t length = strlen(path);
+  if (strncmp(path, "/proc/", 6) == 0 &&
+      length >= 10 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return original("/proc/self/exe", buffer, size);
+  }
+  return original(path, buffer, size);
+}
diff --git a//tmp/audit-work/readlink_test.c b//tmp/audit-work/readlink_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..a85e848ce02b24b08eeeb9361a2f68c7b7d1bcfe
--- /dev/null
+++ b//tmp/audit-work/readlink_test.c
@@ -0,0 +1,14 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char proc[4096];
+  char out[4096] = {0};
+  snprintf(proc, sizeof proc, "/proc/%d/exe", getpid());
+  ssize_t size = readlink(proc, out, sizeof out);
+  printf("path=%s size=%zd errno=%d (%s) out=%s\n",
+         proc, size, errno, strerror(errno), out);
+  return size < 0;
+}
