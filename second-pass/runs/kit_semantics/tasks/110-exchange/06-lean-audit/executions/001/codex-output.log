    88	noncomputable def dictLookup
    89	    (key : SortVal) : SortValSeq → SortValSeq → Option SortVal
    90	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» candidate keys,
    91	      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value values =>
