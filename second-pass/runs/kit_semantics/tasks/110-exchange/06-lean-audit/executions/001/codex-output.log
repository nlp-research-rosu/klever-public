+        "classification_counts": classification_counts,
+        "domain_rule_ids": domain_ids,
+    },
+    "checks": checks,
+    "all_checks_pass": all(entry["ok"] for entry in checks),
+}
+print(json.dumps(report, indent=2, sort_keys=True))
