+      CmpOp(">=", Call(Name("len"), Name("lst1")))),
+      Return(Str("YES")),
+      )
+    Return(Str("NO")))
+  Assert(Compare(
+    Call(Name("exchange"),
+      ListExpr(Int(2)),
+      ListExpr(Int(2))),
+    CmpOp("==", Str("YES")))))
