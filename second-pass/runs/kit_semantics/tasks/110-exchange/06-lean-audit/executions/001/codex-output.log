+
+example :
+    applyBin? "%" (SortVal.inj_SortInt (-3)) (SortVal.inj_SortInt 2) =
+      some (SortVal.inj_SortInt 1) := by
+  rfl
+
+example :
+    applyBin? "%" (SortVal.inj_SortBool true) (SortVal.inj_SortInt 2) =
+      some (SortVal.inj_SortInt 1) := by
