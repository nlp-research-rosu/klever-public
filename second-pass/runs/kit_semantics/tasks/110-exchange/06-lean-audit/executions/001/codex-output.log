    15	/- MPY-FLOAT fixes IEEE-754's (53, 11) format, represented by Lean `Float`. -/
    16	def intToFloat : SortInt → SortFloat
    17	  | Int.ofNat value => Float.ofNat value
    18	  | Int.negSucc value => -(Float.ofNat (value + 1))
    19	
    20	def floatEq (x y : SortFloat) : SortBool := x == y
    21	
    22	def floatLt (x y : SortFloat) : SortBool := decide (x < y)
    23	
    24	def floatGt (x y : SortFloat) : SortBool := decide (y < x)
    25	
    26	def floatMod (x modulus : SortFloat) : SortFloat :=
    27	  x - Float.floor (x / modulus) * modulus
    28	
    29	def floatModTwo (x : SortFloat) : SortFloat :=
    30	  floatMod x (2.0 : SortFloat)
