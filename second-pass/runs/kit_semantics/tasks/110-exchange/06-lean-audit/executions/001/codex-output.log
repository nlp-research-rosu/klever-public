   109	noncomputable def dictEqual
   110	    (leftKeys leftValues rightKeys rightValues : SortValSeq) : SortBool :=
   111	  (valSeqLength leftKeys == valSeqLength rightKeys) &&
   112	    dictSubset rightKeys rightValues leftKeys leftValues
