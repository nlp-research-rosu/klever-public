   114	/- Complete frozen `applyBin` rule table. `none` means that no frozen rule
   115	   matches, or that a guarded/partial Int operation is undefined. -/
   116	noncomputable def applyBin?
   117	    (operator : SortString) (left right : SortVal) : Option SortVal :=
   118	  match left, right with
   119	  | SortVal.inj_SortInt x, SortVal.inj_SortInt y =>
   120	      if operator = "+" then some (SortVal.inj_SortInt (x + y))
   121	      else if operator = "-" then some (SortVal.inj_SortInt (x - y))
   122	      else if operator = "*" then some (SortVal.inj_SortInt (x * y))
   123	      else if operator = "%" then (pyMod x y).map SortVal.inj_SortInt
   124	      else if operator = "//" then
   125	        (pyMod x y).map
   126	          (fun remainder => SortVal.inj_SortInt (Int.tdiv (x - remainder) y))
   127	      else if operator = "**" then
   128	        if y < 0 then none
   129	        else some (SortVal.inj_SortInt (x ^ y.toNat))
   130	      else if operator = "/" then
   131	        some (SortVal.inj_SortFloat (intToFloat x / intToFloat y))
   132	      else none
   133	  | SortVal.inj_SortInt x, SortVal.inj_SortBool y =>
   134	      if operator = "+" then
   135	        some (SortVal.inj_SortInt (x + boolToInt y))
   136	      else none
   137	  | SortVal.inj_SortBool x, SortVal.inj_SortInt y =>
   138	      if operator = "+" then
   139	        some (SortVal.inj_SortInt (boolToInt x + y))
   140	      else if operator = "%" then
   141	        if y = 2 then
   142	          some (SortVal.inj_SortInt ((pyMod (boolToInt x) 2).getD 0))
   143	        else none
   144	      else none
   145	  | SortVal.inj_SortFloat x, SortVal.inj_SortFloat y =>
   146	      if operator = "+" then some (SortVal.inj_SortFloat (x + y))
   147	      else if operator = "-" then some (SortVal.inj_SortFloat (x - y))
   148	      else if operator = "*" then some (SortVal.inj_SortFloat (x * y))
   149	      else if operator = "/" then some (SortVal.inj_SortFloat (x / y))
   150	      else if operator = "%" then
   151	        some (SortVal.inj_SortFloat (floatMod x y))
   152	      else if operator = "**" then some (SortVal.inj_SortFloat (x ^ y))
   153	      else none
   154	  | SortVal.inj_SortInt x, SortVal.inj_SortFloat y =>
   155	      if operator = "+" then some (SortVal.inj_SortFloat (intToFloat x + y))
   156	      else if operator = "-" then
   157	        some (SortVal.inj_SortFloat (intToFloat x - y))
   158	      else if operator = "*" then
   159	        some (SortVal.inj_SortFloat (intToFloat x * y))
   160	      else if operator = "/" then
   161	        some (SortVal.inj_SortFloat (intToFloat x / y))
   162	      else if operator = "**" then
   163	        some (SortVal.inj_SortFloat (intToFloat x ^ y))
   164	      else none
   165	  | SortVal.inj_SortFloat x, SortVal.inj_SortInt y =>
   166	      if operator = "%" then
   167	        if y = 2 then some (SortVal.inj_SortFloat (floatModTwo x)) else none
   168	      else if operator = "+" then
   169	        some (SortVal.inj_SortFloat (x + intToFloat y))
   170	      else if operator = "-" then
   171	        some (SortVal.inj_SortFloat (x - intToFloat y))
   172	      else if operator = "*" then
   173	        some (SortVal.inj_SortFloat (x * intToFloat y))
   174	      else if operator = "/" then
   175	        some (SortVal.inj_SortFloat (x / intToFloat y))
   176	      else if operator = "**" then
   177	        some (SortVal.inj_SortFloat (x ^ intToFloat y))
   178	      else none
   179	  | SortVal.inj_SortStr
   180	      (SortStr.«str(_)_MPY-CORE_Str_IntSeq» leftCodes),
   181	      SortVal.inj_SortStr
   182	      (SortStr.«str(_)_MPY-CORE_Str_IntSeq» rightCodes) =>
   183	      if operator = "+" then
   184	        some (SortVal.inj_SortStr
   185	          (SortStr.«str(_)_MPY-CORE_Str_IntSeq»
   186	            (intSeqAppend leftCodes rightCodes)))
   187	      else none
   188	  | _, _ => none
