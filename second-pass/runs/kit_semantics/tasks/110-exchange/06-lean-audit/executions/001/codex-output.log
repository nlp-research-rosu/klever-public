   228	noncomputable def inequality?
   229	    (left right : SortVal) : Option SortBool :=
   230	  match right with
   231	  | SortVal.«noneV_MPY-CORE_Val» => some (!(kEqual left right))
   232	  | _ =>
   233	    match left, right with
   234	    | SortVal.inj_SortInt x, SortVal.inj_SortInt y => some (!(x == y))
   235	    | SortVal.inj_SortBool x, SortVal.inj_SortBool y => some (!(x == y))
   236	    | SortVal.inj_SortFloat x, SortVal.inj_SortFloat y =>
   237	        some (!(floatEq x y))
   238	    | SortVal.inj_SortInt x, SortVal.inj_SortFloat y =>
   239	        some (!(floatEq (intToFloat x) y))
   240	    | SortVal.inj_SortFloat x, SortVal.inj_SortInt y =>
   241	        some (!(floatEq x (intToFloat y)))
   242	    | SortVal.inj_SortStr
   243	        (SortStr.«str(_)_MPY-CORE_Str_IntSeq» leftCodes),
   244	        SortVal.inj_SortStr
   245	        (SortStr.«str(_)_MPY-CORE_Str_IntSeq» rightCodes) =>
   246	        some (!(kEqual leftCodes rightCodes))
   247	    | SortVal.inj_SortIterable
   248	        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» leftValues),
   249	        SortVal.inj_SortIterable
   250	        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
   251	        some (!(kEqual leftValues rightValues))
   252	    | SortVal.inj_SortIterable
   253	        (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» leftValues),
   254	        SortVal.inj_SortIterable
   255	        (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» rightValues) =>
   256	        some (!(kEqual leftValues rightValues))
   257	    | _, _ => none
