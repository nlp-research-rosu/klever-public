   259	/- Complete frozen `applyCmp` table. List/tuple membership is intentionally
   260	   absent because the frozen semantics implements it as a configuration fold
   261	   before `applyCmp`, not as a rule for this symbol. -/
   262	noncomputable def applyCmp?
   263	    (operator : SortString) (left right : SortVal) : Option SortBool :=
   264	  if operator = "==" then equality? left right
   265	  else if operator = "!=" then inequality? left right
   266	  else if operator = "is" then
   267	    match right with
   268	    | SortVal.«noneV_MPY-CORE_Val» => some (kEqual left right)
   269	    | _ => none
   270	  else if operator = "is not" then
   271	    match right with
   272	    | SortVal.«noneV_MPY-CORE_Val» => some (!(kEqual left right))
   273	    | _ => none
   274	  else
   275	    match left, right with
   276	    | SortVal.inj_SortInt x, SortVal.inj_SortInt y =>
   277	        if operator = "<" then some (decide (x < y))
   278	        else if operator = "<=" then some (decide (x ≤ y))
   279	        else if operator = ">" then some (decide (x > y))
   280	        else if operator = ">=" then some (decide (x ≥ y))
   281	        else none
   282	    | SortVal.inj_SortFloat x, SortVal.inj_SortFloat y =>
   283	        if operator = "<" then some (floatLt x y)
   284	        else if operator = ">" then some (floatGt x y)
   285	        else if operator = ">=" then some (!(floatLt x y))
   286	        else if operator = "<=" then some (!(floatGt x y))
   287	        else none
   288	    | SortVal.inj_SortInt x, SortVal.inj_SortFloat y =>
   289	        if operator = "<" then some (floatLt (intToFloat x) y)
   290	        else if operator = ">" then some (floatGt (intToFloat x) y)
   291	        else none
   292	    | SortVal.inj_SortFloat x, SortVal.inj_SortInt y =>
   293	        if operator = "<" then some (floatLt x (intToFloat y))
   294	        else if operator = ">" then some (floatGt x (intToFloat y))
   295	        else none
   296	    | SortVal.inj_SortStr
   297	        (SortStr.«str(_)_MPY-CORE_Str_IntSeq» leftCodes),
   298	        SortVal.inj_SortStr
   299	        (SortStr.«str(_)_MPY-CORE_Str_IntSeq» rightCodes) =>
   300	        if operator = "in" then some (intSeqContains leftCodes rightCodes)
   301	        else if operator = "not in" then
   302	          some (!(intSeqContains leftCodes rightCodes))
   303	        else if operator = "<" then some (intSeqLt leftCodes rightCodes)
   304	        else if operator = ">" then some (intSeqLt rightCodes leftCodes)
   305	        else if operator = "<=" then some (!(intSeqLt rightCodes leftCodes))
   306	        else if operator = ">=" then some (!(intSeqLt leftCodes rightCodes))
   307	        else none
