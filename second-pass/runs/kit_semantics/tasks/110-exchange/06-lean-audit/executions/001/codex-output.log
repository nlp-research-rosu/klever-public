    95	noncomputable def dictSubset
    96	    (rightKeys rightValues : SortValSeq) :
    97	    SortValSeq → SortValSeq → SortBool
    98	  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq»,
    99	      SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => true
   100	  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» key keys,
   101	      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value values =>
   102	      match dictLookup key rightKeys rightValues with
   103	      | some rightValue =>
   104	          kEqual rightValue value &&
   105	            dictSubset rightKeys rightValues keys values
   106	      | none => false
   107	  | _, _ => false
