diff --git a/evidence/python-operational-oracle.py b/evidence/python-operational-oracle.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d0d515d625d7587d6535968afc71ad4a32803f4
--- /dev/null
+++ b/evidence/python-operational-oracle.py
@@ -0,0 +1,27 @@
+def exchange(lst1, lst2):
+    even_count = 0
+    value = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even_count += 1
+    for value in lst2:
+        if value % 2 == 0:
+            even_count += 1
+    if even_count >= len(lst1):
+        return "YES"
+    return "NO"
+
+
+cases = [
+    ([-3, -4], [False]),
+    ([-3, True], [2]),
+    ([-3.0, -4.0], [0.0]),
+    ([-3.5, -2.5], [4.0]),
+    ([True, False, -2.0], [-3, 6]),
+]
+
+for left, right in cases:
+    print(left, right, exchange(left, right))
+
+for value in [-4, -3, False, True, -4.0, -3.0, -3.5]:
+    print("parity", repr(value), value % 2, value % 2 == 0)

diff --git a//tmp/audit-work/adversarial-operational-tests.mpy b//tmp/audit-work/adversarial-operational-tests.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..4cbd37cf0b761beb7d686f5effc4fb748a8c39c1
--- /dev/null
+++ b//tmp/audit-work/adversarial-operational-tests.mpy
@@ -0,0 +1,43 @@
+Module(
+  FuncDef("exchange", Params("lst1", "lst2"),
+    Assign(Name("even_count"), Int(0))
+    Assign(Name("value"), Int(0))
+    For(Name("value"), Name("lst1"),
+      If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+        AugAssign(Name("even_count"), "+", Int(1)),
+        ))
+    For(Name("value"), Name("lst2"),
+      If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+        AugAssign(Name("even_count"), "+", Int(1)),
+        ))
+    If(Compare(
+      Name("even_count"),
+      CmpOp(">=", Call(Name("len"), Name("lst1")))),
+      Return(Str("YES")),
+      )
+    Return(Str("NO")))
+  Assert(Compare(
+    Call(Name("exchange"),
+      ListExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(4))),
+      ListExpr(Bool(false))),
+    CmpOp("==", Str("YES"))))
+  Assert(Compare(
+    Call(Name("exchange"),
+      ListExpr(UnaryOp("-", Int(3)), Bool(true)),
+      ListExpr(Int(2))),
+    CmpOp("==", Str("NO"))))
+  Assert(Compare(
+    Call(Name("exchange"),
+      ListExpr(UnaryOp("-", Float(3.0)), UnaryOp("-", Float(4.0))),
+      ListExpr(Float(0.0))),
+    CmpOp("==", Str("YES"))))
+  Assert(Compare(
+    Call(Name("exchange"),
+      ListExpr(UnaryOp("-", Float(3.5)), UnaryOp("-", Float(2.5))),
+      ListExpr(Float(4.0))),
+    CmpOp("==", Str("NO"))))
+  Assert(Compare(
+    Call(Name("exchange"),
+      ListExpr(Bool(true), Bool(false), UnaryOp("-", Float(2.0))),
+      ListExpr(UnaryOp("-", Int(3)), Int(6))),
+    CmpOp("==", Str("YES")))))
