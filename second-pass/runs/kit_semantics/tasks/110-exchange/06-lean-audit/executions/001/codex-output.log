    45	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _,
    46	      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
    47	  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» leftHead leftTail,
    48	      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» rightHead rightTail =>
