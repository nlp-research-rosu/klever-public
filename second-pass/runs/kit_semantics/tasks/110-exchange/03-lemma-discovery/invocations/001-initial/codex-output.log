/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
inv_ids = [r['source_rule_id'] for r in inv['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert len(set(out_ids)) == len(out_ids)
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for canonical, classified in zip(inv['rules'], out['rules']):
    assert list(classified) == ['source_rule_id', 'classification', 'rationale'], classified
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if any(a.startswith('simplification') for a in canonical.get('attributes', [])):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}, classified
print('validated_rule_count', len(out['rules']))
print('classification_counts', dict(Counter(r['classification'] for r in out['rules'])))
print('inventory_sha256', out['inventory_sha256'])
