   106	  rule applyBin("%", B:Bool, 2) => pyMod(boolToInt(B), 2)
   107	  rule applyBin("%", F:Float, 2) => floatMod(F, 2.0)
   108	  rule applyCmp("==", F:Float, 0) => eqF(F, 0.0) [priority(40)]
   109	
   110	  syntax Bool ::= isNumberVal(Val) [function, total]
   111	  rule isNumberVal(V:Val)
   112	    => definedProjectInt(V)
   113	       orBool definedProjectBool(V)
   114	       orBool definedProjectFloat(V)
   115	
   116	  // A recursive domain predicate keeps every dynamic list head in the full
   117	  // numeric domain represented by the reference model.
   118	  syntax Bool ::= allNumbers(ValSeq) [function, total]
   119	  rule allNumbers(.ValSeq) => true
   120	  rule allNumbers(vCons(V:Val, VS:ValSeq))
   121	    => isNumberVal(V) andBool allNumbers(VS)
   122	
   123	  // Exact parity predicate for each numeric subsort.  The total projections
   124	  // occur only under their matching definedness conjunct.
   125	  syntax Bool ::= numberEven(Val) [function, total]
   126	  rule numberEven(V:Val)
   127	    => (definedProjectInt(V)
   128	        andBool pyMod(projectIntTotal(V), 2) ==Int 0)
   129	       orBool
   130	       (definedProjectBool(V)
   131	        andBool pyMod(boolToInt(projectBoolTotal(V)), 2) ==Int 0)
   132	       orBool
   133	       (definedProjectFloat(V)
   134	        andBool eqF(floatMod(projectFloatTotal(V), 2.0), 0.0))
   135	
   136	  // Mathematical count of even numeric values in a Python value sequence.
   137	  syntax Int ::= evenCount(ValSeq) [function, total]
   138	  rule evenCount(.ValSeq) => 0
   139	  rule evenCount(vCons(V:Val, VS:ValSeq)) => 1 +Int evenCount(VS)
   140	    requires numberEven(V)
   141	    [simplification]
   142	  rule evenCount(vCons(V:Val, VS:ValSeq)) => evenCount(VS)
   143	    requires notBool numberEven(V)
   144	    [simplification]
   145	
   146	  // The specified answer: exchanges exist exactly when the combined pool
   147	  // contains at least as many even values as the length of lst1.
   148	  syntax Str ::= exchangeResult(ValSeq, ValSeq) [function, total]
   149	  rule exchangeResult(VS1:ValSeq, VS2:ValSeq) => str(strToCodes("YES"))
   150	    requires evenCount(VS1) +Int evenCount(VS2) >=Int vsLen(VS1)
   151	  rule exchangeResult(VS1:ValSeq, VS2:ValSeq) => str(strToCodes("NO"))
   152	    requires evenCount(VS1) +Int evenCount(VS2) <Int vsLen(VS1)
   153	endmodule
   154	
   155	module VERIFICATION
   156	  imports VERIFICATION-BASE
   157	
   158	  // Name lookup and both literals have already executed when this pure
   159	  // function-composition term is reached.  Its three numeric connection
   160	  // claims are proved bridge-free in connection-spec.k.
   161	  rule applyCmp("==", applyBin("%", V:Val, 2), 0) => numberEven(V)
   162	    requires isNumberVal(V)
   163	    [simplification]
   164	  rule #Ceil(applyBin("%", V:Val, 2)) => #Top
   165	    requires isNumberVal(V)
   166	    [simplification]
   167	endmodule
