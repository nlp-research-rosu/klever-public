{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "b1eebada4272e13e3d5bce7ac761094c87a1fcaa90213d8d2afff9d7009d2e82",
      "rationale": "Macro expansion defining the exact translated loop body used by the proof.",
      "source_rule_id": "rule-b1eebada4272e13e3d5bce7ac761094c87a1fcaa90213d8d2afff9d7009d2e82",
      "start_line": 9,
      "text": "  rule countBody\n    => If(\n         Compare(BinOp(\"%\", Name(\"value\"), Int(2)), CmpOp(\"==\", Int(0))),\n         AugAssign(Name(\"even_count\"), \"+\", Int(1)),\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "d16ad005bff09589253f018f19fcba4f135e9c30828655f82df718e34075bced",
      "rationale": "Macro expansion defining the exact translated exchange function body.",
      "source_rule_id": "rule-d16ad005bff09589253f018f19fcba4f135e9c30828655f82df718e34075bced",
      "start_line": 16,
      "text": "  rule exchangeBody\n    => Expr(Str(\"Return whether exchanges can make every element of lst1 even.\"))\n       Assign(Name(\"even_count\"), Int(0))\n       Assign(Name(\"value\"), Int(0))\n       For(Name(\"value\"), Name(\"lst1\"), countBody)\n       For(Name(\"value\"), Name(\"lst2\"), countBody)\n       If(\n         Compare(\n           Name(\"even_count\"),\n           CmpOp(\">=\", Call(Name(\"len\"), Name(\"lst1\"), .Exprs))),\n         Return(Str(\"YES\")),\n         .Stmts)\n       Return(Str(\"NO\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "48810b045ac121b84a7ae717e91307d75641c2b00354dee5d8bde4f523b767fc",
      "rationale": "Macro expansion defining the module containing the translated exchange function.",
      "source_rule_id": "rule-48810b045ac121b84a7ae717e91307d75641c2b00354dee5d8bde4f523b767fc",
      "start_line": 31,
      "text": "  rule exchangeProgram\n    => Module(FuncDef(\n         \"exchange\",\n         Params(\"lst1\", \"lst2\"),\n         exchangeBody))"
    },
