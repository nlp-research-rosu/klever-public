+  | x@.«.IntSeq_MPY-CORE_IntSeq» => strPrefix p x
+  | x@(.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ xs) =>
+      strPrefix p x || strContains p xs
