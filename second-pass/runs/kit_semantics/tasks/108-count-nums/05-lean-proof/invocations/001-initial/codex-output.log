+private def dHasKey (keys : SortValSeq) (key : SortVal) : Bool :=
+  match keys with
+  | .«.ValSeq_MPY-CORE_ValSeq» => false
+  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» h t =>
+      h == key || dHasKey t key
