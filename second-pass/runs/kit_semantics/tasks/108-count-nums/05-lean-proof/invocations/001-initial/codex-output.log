+        · have hz : (0 : Int) ≤ (n % 10 : Nat) := Int.ofNat_zero_le _
+          rw [Int.ofNat_add]
+          omega
+        · have hm' : (n % 10 : Int) < 10 := Int.ofNat_lt.mpr hm
+          rw [Int.ofNat_add]
+          omega
