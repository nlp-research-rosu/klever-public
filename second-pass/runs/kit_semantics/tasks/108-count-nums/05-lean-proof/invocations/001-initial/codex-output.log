+private def intSeqSnoc : SortIntSeq → Int → SortIntSeq
+  | .«.IntSeq_MPY-CORE_IntSeq», i => intSeqCons i intSeqNil
+  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» h t, i =>
+      intSeqCons h (intSeqSnoc t i)
