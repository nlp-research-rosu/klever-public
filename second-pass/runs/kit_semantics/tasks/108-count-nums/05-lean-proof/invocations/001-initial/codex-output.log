+private def takeNumber (acc : Int) : List Int → Int × List Int
+  | c :: r =>
+      if 48 ≤ c && c ≤ 57 then takeNumber (acc * 10 + c - 48) r
+      else (acc, c :: r)
+  | [] => (acc, [])
