+private def applyEvalOp (op : String) (a b : Int) : Int :=
+  if op == "+" then a + b
+  else if op == "-" then a - b
+  else if op == "*" then a * b
+  else if op == "//" then a / b
+  else if op == "**" then intPowK a b
+  else a
