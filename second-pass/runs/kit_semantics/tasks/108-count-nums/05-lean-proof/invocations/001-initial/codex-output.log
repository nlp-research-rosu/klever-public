+      .inj_SortInt (if f ≥ 0.0 then floatFloorInt f else floatCeilInt f)
+  | "int", .«_,__MPY-CORE_Vals_Val_Vals»
+      (.inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» s))
+      .«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
