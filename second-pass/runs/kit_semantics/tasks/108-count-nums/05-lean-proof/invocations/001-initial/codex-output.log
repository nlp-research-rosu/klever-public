+private def decimalCodesImpl (i : Int) : SortIntSeq :=
+  if i < 0 then
+    intSeqCons 45 (natDecimalCodesAux (i.natAbs + 1) i.natAbs)
+  else
+    natDecimalCodesAux (i.toNat + 1) i.toNat
