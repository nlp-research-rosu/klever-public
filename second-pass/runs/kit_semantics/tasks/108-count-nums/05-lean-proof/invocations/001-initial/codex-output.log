+private def tokenizeNumsFuel : Nat → List Int → List Int
+  | 0, _ => []
+  | _ + 1, [] => []
+  | fuel + 1, c :: r =>
+      if 48 ≤ c && c ≤ 57 then
+        let p := takeNumber (c - 48) r
+        p.1 :: tokenizeNumsFuel fuel p.2
+      else tokenizeNumsFuel fuel r
