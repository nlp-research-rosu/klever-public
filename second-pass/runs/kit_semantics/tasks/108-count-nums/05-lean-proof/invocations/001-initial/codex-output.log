+  | «iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» h t ih =>
+      simp [allDigitCodesImpl] at hs
+      simp [intSeqSnoc, intSeqCons, allDigitCodesImpl, hs.1, ih hs.2]
