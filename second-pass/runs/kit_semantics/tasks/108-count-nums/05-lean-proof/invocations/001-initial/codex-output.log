+  | 47 :: 47 :: r => "//" :: tokenizeOps r
+  | 42 :: r => "*" :: tokenizeOps r
+  | 47 :: r => "/" :: tokenizeOps r
+  | 43 :: r => "+" :: tokenizeOps r
+  | 45 :: r => "-" :: tokenizeOps r
+  | _ :: r => tokenizeOps r
