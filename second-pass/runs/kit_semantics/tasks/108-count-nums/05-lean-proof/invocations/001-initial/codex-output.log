+private def roundFloatInt (f : Float) : Int :=
+  let fl := f.floor
+  if f - fl == 0.5 then
+    let i := fl.toInt64.toInt
+    if i % 2 == 0 then i else f.ceil.toInt64.toInt
+  else
+    (f + 0.5).floor.toInt64.toInt
