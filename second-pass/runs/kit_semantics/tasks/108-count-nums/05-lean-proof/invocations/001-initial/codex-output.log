+  | "!=", v, .«noneV_MPY-CORE_Val» => v != noneVal
+  | "is", v, .«noneV_MPY-CORE_Val» => v == noneVal
+  | "is not", v, .«noneV_MPY-CORE_Val» => v != noneVal
