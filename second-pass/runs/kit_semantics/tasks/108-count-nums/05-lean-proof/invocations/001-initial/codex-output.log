+private def passPow : List String → List Int → List String × List Int
+  | [], ns => ([], ns)
+  | _, [] => ([], [])
+  | op :: ops, n :: ns =>
+      let p := passPow ops ns
+      if op == "**" then
+        match p.2 with
+        | m :: rest => (p.1, intPowK n m :: rest)
+        | [] => (p.1, [n])
+      else
+        (op :: p.1, n :: p.2)
