+private def tokenizeNums : List Int → List Int
+  | [] => []
+  | c :: r =>
+      if 48 ≤ c && c ≤ 57 then
+        let p := takeNumber (c - 48) r
+        p.1 :: tokenizeNums p.2
+      else tokenizeNums r
