+private def rangeLen (lo hi st : Int) : Option Int :=
+  if st > 0 then
+    some (if lo < hi then (hi - lo + st - 1) / st else 0)
+  else if st < 0 then
+    some (if hi < lo then (lo - hi - st - 1) / (0 - st) else 0)
+  else none
