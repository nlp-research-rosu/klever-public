+private def applyEvalOp (op : String) (a b : Int) : Int :=
+  if op == "+" then a + b
+  else if op == "-" then a - b
+  else if op == "*" then a * b
+  else if op == "//" then a / b
+  else if op == "**" then intPowK a b
+  else a
+
+private def inEvalLevel (level op : String) : Bool :=
+  if level == "mul" then op == "*" || op == "//" || op == "/"
+  else if level == "add" then op == "+" || op == "-"
+  else false
