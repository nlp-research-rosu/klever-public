+private def applyBuiltinImpl : String → SortVals → SortVal
+  | "len", .«_,__MPY-CORE_Vals_Val_Vals» obj .«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+      match seqLenImpl obj with | some n => .inj_SortInt n | none => noneVal
