+private theorem decimalCodes_nonnegative_digits (n : Int) (h : n ≥ 0) :
+    allDigitCodesImpl (decimalCodesImpl n) = true := by
+  simp [decimalCodesImpl, h, natDecimalCodesAux_digits]
