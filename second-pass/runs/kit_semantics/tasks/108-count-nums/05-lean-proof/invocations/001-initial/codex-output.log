+private def intSeqLen : SortIntSeq → Int
+  | .«.IntSeq_MPY-CORE_IntSeq» => 0
+  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ t => 1 + intSeqLen t
