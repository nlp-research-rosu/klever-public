+  | "!=", .inj_SortInt a, .inj_SortInt b => a != b
+  | "<",  .inj_SortInt a, .inj_SortInt b => a < b
+  | "<=", .inj_SortInt a, .inj_SortInt b => a ≤ b
+  | ">",  .inj_SortInt a, .inj_SortInt b => a > b
