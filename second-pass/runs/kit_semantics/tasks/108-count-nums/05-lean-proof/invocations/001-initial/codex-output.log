+private def evalArith (s : SortIntSeq) : Int :=
+  let codes := intSeqToList s
+  let p := passPow (tokenizeOps codes) (tokenizeNums codes)
+  match (passLevel "add" (passLevel "mul" p)).2 with
+  | n :: _ => n
+  | [] => 0
