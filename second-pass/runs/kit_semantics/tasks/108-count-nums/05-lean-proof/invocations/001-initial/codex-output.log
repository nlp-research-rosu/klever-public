+private def natDecimalCodesAux : Nat → Nat → SortIntSeq
+  | 0, _ => intSeqCons 48 intSeqNil
+  | fuel + 1, n =>
+      if n < 10 then
+        intSeqCons (Int.ofNat (48 + n)) intSeqNil
+      else
+        intSeqSnoc (natDecimalCodesAux fuel (n / 10))
+          (Int.ofNat (48 + n % 10))
