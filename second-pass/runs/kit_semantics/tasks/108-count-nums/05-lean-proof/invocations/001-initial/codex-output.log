+      (.inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a))
+      (.«_,__MPY-CORE_Vals_Val_Vals»
+        (.inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b))
