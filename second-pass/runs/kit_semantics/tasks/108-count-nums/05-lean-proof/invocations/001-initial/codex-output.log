+  | "abs", .«_,__MPY-CORE_Vals_Val_Vals» (.inj_SortFloat f)
+      .«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» => .inj_SortFloat f.abs
+  | "floor", .«_,__MPY-CORE_Vals_Val_Vals» (.inj_SortInt i)
