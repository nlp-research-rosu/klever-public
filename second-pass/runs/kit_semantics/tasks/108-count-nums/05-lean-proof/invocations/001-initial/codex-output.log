diff --git a//tmp/lean-host-pid.c b//tmp/lean-host-pid.c
new file mode 100644
index 0000000000000000000000000000000000000000..6b568fd9be79de51b9317a411b7ca0c65338ae9b
--- /dev/null
+++ b//tmp/lean-host-pid.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+pid_t getpid(void) {
+  FILE *f = fopen("/proc/self/status", "r");
+  char line[256];
+  if (f) {
+    while (fgets(line, sizeof line, f)) {
+      if (strncmp(line, "Pid:", 4) == 0) {
+        fclose(f);
+        return (pid_t)strtol(line + 4, NULL, 10);
+      }
+    }
+    fclose(f);
+  }
+  return 1;
+}
