+            _ = 57 := by rfl
+      · have hm : n % 10 < 10 := Nat.mod_lt _ (by omega)
+        apply intSeqSnoc_digits _ _ (ih _)
+        · have hloNat : (48 : Nat) ≤ 48 + n % 10 := by omega
+          exact Int.ofNat_le.mpr hloNat
+        · have hhiNat : 48 + n % 10 ≤ (57 : Nat) := by omega
+          exact Int.ofNat_le.mpr hhiNat
