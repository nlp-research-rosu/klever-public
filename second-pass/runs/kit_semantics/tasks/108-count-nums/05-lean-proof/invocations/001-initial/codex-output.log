+  | "!=", .inj_SortBool a, .inj_SortBool b => a != b
+  | "==", .inj_SortFloat a, .inj_SortFloat b => a == b
+  | "!=", .inj_SortFloat a, .inj_SortFloat b => a != b
+  | "<",  .inj_SortFloat a, .inj_SortFloat b => a < b
+  | "<=", .inj_SortFloat a, .inj_SortFloat b => !(a > b)
+  | ">",  .inj_SortFloat a, .inj_SortFloat b => a > b
+  | ">=", .inj_SortFloat a, .inj_SortFloat b => !(a < b)
