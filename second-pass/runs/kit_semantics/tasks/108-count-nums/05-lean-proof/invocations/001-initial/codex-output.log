+  | "==", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
+          .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => a == b
+  | "!=", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
+          .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => a != b
+  | "in", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
