diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..112cf25fb531acfa52f768910436076c93dfb243
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,28 @@
+def count_nums(arr):
+    count = 0
+    for num in arr:
+        if num < 0:
+            n = -num
+        else:
+            n = num
+
+        digit_sum = 0
+        while n >= 10:
+            digit_sum += n % 10
+            n //= 10
+
+        if num < 0:
+            digit_sum -= n
+        else:
+            digit_sum += n
+
+        if digit_sum > 0:
+            count += 1
+
+    return count
+
+
+assert count_nums([]) == 0
+assert count_nums([-1, 11, -11]) == 1
+assert count_nums([1, 1, 2]) == 3
+assert count_nums([-123, -100, -19, 0, 10, 99]) == 4
