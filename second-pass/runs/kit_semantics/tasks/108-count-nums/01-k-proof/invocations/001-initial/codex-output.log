diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b07eebe6d95d57be8834edf2eccc3bea641dc73d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,217 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Repeatedly remove the last decimal digit while n has at least two
+  // digits. The circularity describes exactly the two local variables changed
+  // by the loop and frames the surrounding continuation and state.
+  claim [digit-loop]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">=", Int(10))),
+        AugAssign(Name("digit_sum"), "+",
+          BinOp("%", Name("n"), Int(10)))
+        AugAssign(Name("n"), "//", Int(10))
+        .Stmts)
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SCOPES:Map
+      L |-> scope(
+        "n" |-> (N:Int => leadingDigit(N))
+        "digit_sum" |-> (S:Int => S +Int trailingDigitSum(N))
+        LOCALS:Map,
+        P:Parent)
+    </scopes>
+    <scopeLoc> NEXTLOC:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires N >=Int 0
+
+  // Base circularity for an exhausted input list.
+  claim [outer-loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("num"),
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+          Assign(Name("n"), Name("num")) .Stmts)
+        Assign(Name("digit_sum"), Int(0))
+        While(
+          Compare(Name("n"), CmpOp(">=", Int(10))),
+          AugAssign(Name("digit_sum"), "+",
+            BinOp("%", Name("n"), Int(10)))
+          AugAssign(Name("n"), "//", Int(10))
+          .Stmts)
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          AugAssign(Name("digit_sum"), "-", Name("n")) .Stmts,
+          AugAssign(Name("digit_sum"), "+", Name("n")) .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SCOPES:Map
+      L |-> scope("count" |-> C:Int LOCALS:Map, P:Parent)
+    </scopes>
+    <scopeLoc> NEXTLOC:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+
+  // Inductive circularity for one integer head and an arbitrary finite
+  // integer tail. Other locals are existential because the caller observes
+  // only count, and the function-return rule deletes this local frame.
+  claim [outer-loop-step]:
+    <k>
+      #loop(
+        list(vCons(I:Int, R:ValSeq)),
+        Name("num"),
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+          Assign(Name("n"), Name("num")) .Stmts)
+        Assign(Name("digit_sum"), Int(0))
+        While(
+          Compare(Name("n"), CmpOp(">=", Int(10))),
+          AugAssign(Name("digit_sum"), "+",
+            BinOp("%", Name("n"), Int(10)))
+          AugAssign(Name("n"), "//", Int(10))
+          .Stmts)
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          AugAssign(Name("digit_sum"), "-", Name("n")) .Stmts,
+          AugAssign(Name("digit_sum"), "+", Name("n")) .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SCOPES:Map
+      L |-> (scope("count" |-> C:Int LOCALS:Map, P:Parent)
+        => scope(
+          "count" |-> C +Int countNumsSpec(vCons(I, R))
+          ?FINALLOCALS:Map,
+          P))
+    </scopes>
+    <scopeLoc> NEXTLOC:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires allInts(R)
+    ensures notBool ("count" in_keys(?FINALLOCALS))
+
+  // Empty input call.
+  claim [count-nums-empty]:
+    <k>
+      Call(Name("count_nums"), list(.ValSeq))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_nums" |->
+          closureVal(
+            "arr" , .ParamNames,
+            Assign(Name("count"), Int(0))
+            For(
+              Name("num"),
+              Name("arr"),
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+                Assign(Name("n"), Name("num")) .Stmts)
+              Assign(Name("digit_sum"), Int(0))
+              While(
+                Compare(Name("n"), CmpOp(">=", Int(10))),
+                AugAssign(Name("digit_sum"), "+",
+                  BinOp("%", Name("n"), Int(10)))
+                AugAssign(Name("n"), "//", Int(10))
+                .Stmts)
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                AugAssign(Name("digit_sum"), "-", Name("n")) .Stmts,
+                AugAssign(Name("digit_sum"), "+", Name("n")) .Stmts)
+              If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Every nonempty finite integer list: one symbolic head and an arbitrary
+  // all-integer tail.
+  claim [count-nums-nonempty]:
+    <k>
+      Call(Name("count_nums"), list(vCons(I:Int, R:ValSeq)))
+      => ?RESULT:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_nums" |->
+          closureVal(
+            "arr" , .ParamNames,
+            Assign(Name("count"), Int(0))
+            For(
+              Name("num"),
+              Name("arr"),
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+                Assign(Name("n"), Name("num")) .Stmts)
+              Assign(Name("digit_sum"), Int(0))
+              While(
+                Compare(Name("n"), CmpOp(">=", Int(10))),
+                AugAssign(Name("digit_sum"), "+",
+                  BinOp("%", Name("n"), Int(10)))
+                AugAssign(Name("n"), "//", Int(10))
+                .Stmts)
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                AugAssign(Name("digit_sum"), "-", Name("n")) .Stmts,
+                AugAssign(Name("digit_sum"), "+", Name("n")) .Stmts)
+              If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(R)
+    ensures ?RESULT ==Int countNumsSpec(vCons(I, R))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f06fa78aefca2b937ef04c8a0bb41b6f67bafbce
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,52 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // True exactly when every value in a semantic list is an integer.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(I:Int, R:ValSeq)) => allInts(R)
+  rule allInts(vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  // Non-negative magnitude.
+  syntax Int ::= magnitude(Int) [function, total]
+  rule magnitude(I:Int) => 0 -Int I requires I <Int 0
+  rule magnitude(I:Int) => I        requires I >=Int 0
+
+  // The leading decimal digit and the sum of all remaining decimal digits.
+  // Their equations mirror repeated non-negative Python division by 10.
+  syntax Int ::= leadingDigit(Int) [function]
+               | trailingDigitSum(Int) [function]
+  rule leadingDigit(N:Int) => N
+    requires 0 <=Int N andBool N <Int 10
+  rule leadingDigit(N:Int)
+    => leadingDigit((N -Int pyMod(N, 10)) /Int 10)
+    requires N >=Int 10
+
+  rule trailingDigitSum(N:Int) => 0
+    requires 0 <=Int N andBool N <Int 10
+  rule trailingDigitSum(N:Int)
+    => pyMod(N, 10)
+       +Int trailingDigitSum((N -Int pyMod(N, 10)) /Int 10)
+    requires N >=Int 10
+
+  // The prompt's signed-digit convention: only the leading digit is negated.
+  syntax Int ::= signedDigitSum(Int) [function, total]
+  rule signedDigitSum(I:Int)
+    => trailingDigitSum(magnitude(I)) -Int leadingDigit(magnitude(I))
+    requires I <Int 0
+  rule signedDigitSum(I:Int)
+    => trailingDigitSum(magnitude(I)) +Int leadingDigit(magnitude(I))
+    requires I >=Int 0
+
+  // Mathematical count over an arbitrary finite integer ValSeq.
+  syntax Int ::= countNumsSpec(ValSeq) [function]
+  rule countNumsSpec(.ValSeq) => 0
+  rule countNumsSpec(vCons(I:Int, R:ValSeq))
+    => (#if signedDigitSum(I) >Int 0 #then 1 #else 0 #fi)
+       +Int countNumsSpec(R)
+endmodule

