+    requires isInt(V)
+  rule countNumsSpec(vCons(V:Val, R:ValSeq))
+    => countNumsSpec(R)
+    requires notBool isInt(V)
+endmodule

codex
The empty entry claim closes independently with `#Top`. The nonempty entry is now isolated with exactly its three supporting invariants; this avoids the extra circularity search that made the all-claims-at-once command impractically slow while preserving the same proof theory.
diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1b0ae13a22d5985e6464ce661e34cac235e0a6a
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,31 @@
+def count_nums(arr):
+    count = 0
+    for num in arr:
+        if num < 0:
+            n = -num
+        else:
+            n = num
+
+        digit_sum = 0
+        first_digit = 0
+        char = "0"
+        digit = 0
+        for char in str(n):
+            digit = int(char)
+            if first_digit == 0:
+                first_digit = digit
+            digit_sum += digit
+
+        if num < 0:
+            digit_sum -= 2 * first_digit
+
+        if digit_sum > 0:
+            count += 1
+
+    return count
+
+
+assert count_nums([]) == 0
+assert count_nums([-1, 11, -11]) == 1
+assert count_nums([1, 1, 2]) == 3
+assert count_nums([-123, -100, -19, 0, 10, 99]) == 4
