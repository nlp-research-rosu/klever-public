+    <scopeLoc> NEXTLOC:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..58e524752a1a281d3c93a05383a3cf788a26b7f5
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,220 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Repeatedly remove the last decimal digit while n has at least two
+  // digits. The circularity describes exactly the two local variables changed
+  // by the loop and frames the surrounding continuation and state.
+  claim [digit-loop]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">=", Int(10))),
+        AugAssign(Name("digit_sum"), "+",
+          BinOp("%", Name("n"), Int(10)))
+        AugAssign(Name("n"), "//", Int(10))
+        .Stmts)
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      SCOPES:Map
+      1 |-> scope(
+        "arr" |-> list(ARR:ValSeq)
+        "count" |-> COUNT:Int
+        "num" |-> NUM:Int
+        "n" |-> (N:Int => leadingDigit(N))
+        "digit_sum" |-> (S:Int => S +Int trailingDigitSum(N))
+        ,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+
+  // Base circularity for an exhausted input list.
+  claim [outer-loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("num"),
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+          Assign(Name("n"), Name("num")) .Stmts)
+        Assign(Name("digit_sum"), Int(0))
+        While(
+          Compare(Name("n"), CmpOp(">=", Int(10))),
+          AugAssign(Name("digit_sum"), "+",
+            BinOp("%", Name("n"), Int(10)))
+          AugAssign(Name("n"), "//", Int(10))
+          .Stmts)
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          AugAssign(Name("digit_sum"), "-", Name("n")) .Stmts,
+          AugAssign(Name("digit_sum"), "+", Name("n")) .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SCOPES:Map
+      L |-> scope("count" |-> C:Int LOCALS:Map, P:Parent)
+    </scopes>
+    <scopeLoc> NEXTLOC:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+
+  // Inductive circularity for one integer head and an arbitrary finite
+  // integer tail. Other locals are existential because the caller observes
+  // only count, and the function-return rule deletes this local frame.
+  claim [outer-loop-step]:
+    <k>
+      #loop(
+        list(vCons(I:Int, R:ValSeq)),
+        Name("num"),
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+          Assign(Name("n"), Name("num")) .Stmts)
+        Assign(Name("digit_sum"), Int(0))
+        While(
+          Compare(Name("n"), CmpOp(">=", Int(10))),
+          AugAssign(Name("digit_sum"), "+",
+            BinOp("%", Name("n"), Int(10)))
+          AugAssign(Name("n"), "//", Int(10))
+          .Stmts)
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          AugAssign(Name("digit_sum"), "-", Name("n")) .Stmts,
+          AugAssign(Name("digit_sum"), "+", Name("n")) .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SCOPES:Map
+      L |-> (scope("count" |-> C:Int LOCALS:Map, P:Parent)
+        => scope(
+          "count" |-> C +Int countNumsSpec(vCons(I, R))
+          ?FINALLOCALS:Map,
+          P))
+    </scopes>
+    <scopeLoc> NEXTLOC:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires allInts(R)
+    ensures notBool ("count" in_keys(?FINALLOCALS))
+
+  // Empty input call.
+  claim [count-nums-empty]:
+    <k>
+      Call(Name("count_nums"), list(.ValSeq))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_nums" |->
+          closureVal(
+            "arr" , .ParamNames,
+            Assign(Name("count"), Int(0))
+            For(
+              Name("num"),
+              Name("arr"),
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+                Assign(Name("n"), Name("num")) .Stmts)
+              Assign(Name("digit_sum"), Int(0))
+              While(
+                Compare(Name("n"), CmpOp(">=", Int(10))),
+                AugAssign(Name("digit_sum"), "+",
+                  BinOp("%", Name("n"), Int(10)))
+                AugAssign(Name("n"), "//", Int(10))
+                .Stmts)
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                AugAssign(Name("digit_sum"), "-", Name("n")) .Stmts,
+                AugAssign(Name("digit_sum"), "+", Name("n")) .Stmts)
+              If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Every nonempty finite integer list: one symbolic head and an arbitrary
+  // all-integer tail.
+  claim [count-nums-nonempty]:
+    <k>
+      Call(Name("count_nums"), list(vCons(I:Int, R:ValSeq)))
+      => ?RESULT:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_nums" |->
+          closureVal(
+            "arr" , .ParamNames,
+            Assign(Name("count"), Int(0))
+            For(
+              Name("num"),
+              Name("arr"),
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+                Assign(Name("n"), Name("num")) .Stmts)
+              Assign(Name("digit_sum"), Int(0))
+              While(
+                Compare(Name("n"), CmpOp(">=", Int(10))),
+                AugAssign(Name("digit_sum"), "+",
+                  BinOp("%", Name("n"), Int(10)))
+                AugAssign(Name("n"), "//", Int(10))
+                .Stmts)
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                AugAssign(Name("digit_sum"), "-", Name("n")) .Stmts,
+                AugAssign(Name("digit_sum"), "+", Name("n")) .Stmts)
+              If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(R)
+    ensures ?RESULT ==Int countNumsSpec(vCons(I, R))
+endmodule
