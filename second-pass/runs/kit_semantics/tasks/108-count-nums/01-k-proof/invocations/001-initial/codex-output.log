diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..38302636890a7fc2c08c079069d9f15f510b2ce7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,288 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Structural circularity for the inner traversal over decimal character
+  // codes.  The fixed semantics executes every source statement in the body.
+  claim [digit-loop]:
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("char"),
+        Assign(Name("digit"), Call(Name("int"), Name("char")))
+        If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+          Assign(Name("first_digit"), Name("digit")) .Stmts,
+          .Stmts)
+        AugAssign(Name("digit_sum"), "+", Name("digit"))
+        .Stmts)
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope("count_nums" |-> FN:Val, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> (
+        scope(
+          "arr" |-> list(ARR:ValSeq)
+          "count" |-> COUNT:Int
+          "num" |-> NUM:Int
+          "n" |-> NN:Int
+          "digit_sum" |-> SUM:Int
+          "first_digit" |-> FIRST:Int
+          LOCALS:Map,
+          parent(0))
+        =>
+        scope(
+          "arr" |-> list(ARR)
+          "count" |-> COUNT
+          "num" |-> NUM
+          "n" |-> NN
+          "digit_sum" |-> SUM +Int codeDigitSum(CS)
+          "first_digit" |-> chooseFirst(FIRST, CS)
+          ?FINALLOCALS:Map,
+          parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allDigitCodes(CS)
+      andBool notBool ("str" in_keys(LOCALS))
+      andBool notBool ("int" in_keys(LOCALS))
+      andBool notBool ("$cells" in_keys(LOCALS))
+
+  // Exhausted outer traversal, including the actual source return and the
+  // supplied function-frame pop.
+  claim [outer-loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("num"),
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+          Assign(Name("n"), Name("num")) .Stmts)
+        Assign(Name("digit_sum"), Int(0))
+        Assign(Name("first_digit"), Int(0))
+        For(
+          Name("char"),
+          Call(Name("str"), Name("n")),
+          Assign(Name("digit"), Call(Name("int"), Name("char")))
+          If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+            Assign(Name("first_digit"), Name("digit")) .Stmts,
+            .Stmts)
+          AugAssign(Name("digit_sum"), "+", Name("digit"))
+          .Stmts)
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          AugAssign(
+            Name("digit_sum"),
+            "-",
+            BinOp("*", Int(2), Name("first_digit")))
+          .Stmts,
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+        .Stmts)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => C:Int
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope("count_nums" |-> FN:Val, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "arr" |-> list(ORIGINAL:ValSeq)
+        "count" |-> C:Int
+        LOCALS:Map,
+        parent(0))
+      =>
+      0 |-> scope("count_nums" |-> FN, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // One integer head and an arbitrary all-integer tail.
+  claim [outer-loop-step]:
+    <k>
+      #loop(
+        list(vCons(I:Int, R:ValSeq)),
+        Name("num"),
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+          Assign(Name("n"), Name("num")) .Stmts)
+        Assign(Name("digit_sum"), Int(0))
+        Assign(Name("first_digit"), Int(0))
+        For(
+          Name("char"),
+          Call(Name("str"), Name("n")),
+          Assign(Name("digit"), Call(Name("int"), Name("char")))
+          If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+            Assign(Name("first_digit"), Name("digit")) .Stmts,
+            .Stmts)
+          AugAssign(Name("digit_sum"), "+", Name("digit"))
+          .Stmts)
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          AugAssign(
+            Name("digit_sum"),
+            "-",
+            BinOp("*", Int(2), Name("first_digit")))
+          .Stmts,
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+        .Stmts)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => C:Int +Int countNumsSpec(vCons(I, R))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope("count_nums" |-> FN:Val, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "arr" |-> list(ORIGINAL:ValSeq)
+        "count" |-> C:Int
+        LOCALS:Map,
+        parent(0))
+      =>
+      0 |-> scope("count_nums" |-> FN, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(R)
+      andBool notBool ("str" in_keys(LOCALS))
+      andBool notBool ("int" in_keys(LOCALS))
+      andBool notBool ("$cells" in_keys(LOCALS))
+
+  claim [count-nums-empty]:
+    <k>
+      Call(Name("count_nums"), list(.ValSeq))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_nums" |->
+          closureVal(
+            "arr" , .ParamNames,
+            Assign(Name("count"), Int(0))
+            For(
+              Name("num"),
+              Name("arr"),
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+                Assign(Name("n"), Name("num")) .Stmts)
+              Assign(Name("digit_sum"), Int(0))
+              Assign(Name("first_digit"), Int(0))
+              For(
+                Name("char"),
+                Call(Name("str"), Name("n")),
+                Assign(Name("digit"), Call(Name("int"), Name("char")))
+                If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+                  Assign(Name("first_digit"), Name("digit")) .Stmts,
+                  .Stmts)
+                AugAssign(Name("digit_sum"), "+", Name("digit"))
+                .Stmts)
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                AugAssign(
+                  Name("digit_sum"),
+                  "-",
+                  BinOp("*", Int(2), Name("first_digit")))
+                .Stmts,
+                .Stmts)
+              If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [count-nums-nonempty]:
+    <k>
+      Call(Name("count_nums"), list(vCons(I:Int, R:ValSeq)))
+      => ?RESULT:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_nums" |->
+          closureVal(
+            "arr" , .ParamNames,
+            Assign(Name("count"), Int(0))
+            For(
+              Name("num"),
+              Name("arr"),
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+                Assign(Name("n"), Name("num")) .Stmts)
+              Assign(Name("digit_sum"), Int(0))
+              Assign(Name("first_digit"), Int(0))
+              For(
+                Name("char"),
+                Call(Name("str"), Name("n")),
+                Assign(Name("digit"), Call(Name("int"), Name("char")))
+                If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+                  Assign(Name("first_digit"), Name("digit")) .Stmts,
+                  .Stmts)
+                AugAssign(Name("digit_sum"), "+", Name("digit"))
+                .Stmts)
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                AugAssign(
+                  Name("digit_sum"),
+                  "-",
+                  BinOp("*", Int(2), Name("first_digit")))
+                .Stmts,
+                .Stmts)
+              If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(R)
+    ensures ?RESULT ==Int countNumsSpec(vCons(I, R))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d7ec175e41db819c46e4729dd92cde0995726529
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,66 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Candidate-domain predicate: every element is an integer.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(_:Int, R:ValSeq)) => allInts(R)
+  rule allInts(vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  syntax Int ::= magnitude(Int) [function, total]
+  rule magnitude(I:Int) => 0 -Int I requires I <Int 0
+  rule magnitude(I:Int) => I        requires I >=Int 0
+
+  // A proof-side name for the code sequence returned by the supplied
+  // Int2String/strToCodes primitive.  The concrete rule remains in the fixed
+  // semantics; this simplification names its already-produced result.
+  syntax IntSeq ::= decimalCodes(Int)
+    [function, total, no-evaluators]
+  rule strToCodes(Int2String(N:Int)) => decimalCodes(N)
+    requires N >=Int 0
+    [simplification]
+
+  syntax Bool ::= allDigitCodes(IntSeq) [function, total]
+  rule allDigitCodes(.IntSeq) => true
+  rule allDigitCodes(iCons(C:Int, R:IntSeq))
+    => (48 <=Int C andBool C <=Int 57) andBool allDigitCodes(R)
+
+  // Contract of the fixed Int2String primitive on non-negative integers.
+  // This is the only value-level trust boundary in the proof.
+  rule allDigitCodes(decimalCodes(N:Int)) => true
+    requires N >=Int 0
+    [simplification]
+
+  syntax Int ::= codeDigitSum(IntSeq) [function, total]
+  rule codeDigitSum(.IntSeq) => 0
+  rule codeDigitSum(iCons(C:Int, R:IntSeq))
+    => (C -Int 48) +Int codeDigitSum(R)
+
+  // Result of the source loop's "first nonzero digit seen" accumulator.
+  syntax Int ::= chooseFirst(Int, IntSeq) [function, total]
+  rule chooseFirst(F:Int, .IntSeq) => F
+  rule chooseFirst(F:Int, iCons(C:Int, R:IntSeq))
+    => chooseFirst(
+         #if F ==Int 0 #then C -Int 48 #else F #fi,
+         R)
+
+  syntax Int ::= signedDigitSum(Int) [function, total]
+  rule signedDigitSum(I:Int)
+    => codeDigitSum(decimalCodes(magnitude(I)))
+       -Int (2 *Int chooseFirst(0, decimalCodes(magnitude(I))))
+    requires I <Int 0
+  rule signedDigitSum(I:Int)
+    => codeDigitSum(decimalCodes(magnitude(I)))
+    requires I >=Int 0
+
+  syntax Int ::= countNumsSpec(ValSeq) [function]
+  rule countNumsSpec(.ValSeq) => 0
+  rule countNumsSpec(vCons(I:Int, R:ValSeq))
+    => (#if signedDigitSum(I) >Int 0 #then 1 #else 0 #fi)
+       +Int countNumsSpec(R)
+endmodule

