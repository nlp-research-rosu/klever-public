@@ -0,0 +1,57 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // True exactly when every value in a semantic list is an integer.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(I:Int, R:ValSeq)) => allInts(R)
+  rule allInts(vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  // Non-negative magnitude.
+  syntax Int ::= magnitude(Int) [function, total]
+  rule magnitude(I:Int) => 0 -Int I requires I <Int 0
+  rule magnitude(I:Int) => I        requires I >=Int 0
+
+  // The leading decimal digit and the sum of all remaining decimal digits.
+  // Their equations mirror repeated non-negative Python division by 10.
+  syntax Int ::= leadingDigit(Int) [function]
+               | trailingDigitSum(Int) [function]
+  rule leadingDigit(N:Int) => N [simplification]
+    requires 0 <=Int N andBool N <Int 10
+  // Recursive equations are oriented as folds.  Forward orientation on a
+  // symbolic integer would expand forever even though the concrete recursion
+  // is well founded.
+  rule leadingDigit((N -Int pyMod(N, 10)) /Int 10)
+    => leadingDigit(N)
+    requires N >=Int 10
+    [simplification]
+
+  rule trailingDigitSum(N:Int) => 0 [simplification]
+    requires 0 <=Int N andBool N <Int 10
+  rule pyMod(N, 10)
+       +Int trailingDigitSum((N -Int pyMod(N, 10)) /Int 10)
+    => trailingDigitSum(N)
+    requires N >=Int 10
+    [simplification]
+
+  // The prompt's signed-digit convention: only the leading digit is negated.
+  syntax Int ::= signedDigitSum(Int) [function, total]
+  rule signedDigitSum(I:Int)
+    => trailingDigitSum(magnitude(I)) -Int leadingDigit(magnitude(I))
+    requires I <Int 0
+  rule signedDigitSum(I:Int)
+    => trailingDigitSum(magnitude(I)) +Int leadingDigit(magnitude(I))
+    requires I >=Int 0
+
+  // Mathematical count over an arbitrary finite integer ValSeq.
+  syntax Int ::= countNumsSpec(ValSeq) [function]
+  rule countNumsSpec(.ValSeq) => 0
+  rule countNumsSpec(vCons(I:Int, R:ValSeq))
+    => (#if signedDigitSum(I) >Int 0 #then 1 #else 0 #fi)
+       +Int countNumsSpec(R)
+endmodule

