+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Every nonempty finite integer list: one symbolic head and an arbitrary
+  // all-integer tail.
+  claim [count-nums-nonempty]:
