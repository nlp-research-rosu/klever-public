+            digit = int(char)
+            if first_digit == 0:
+                first_digit = digit
+            digit_sum += digit
+
+        if num < 0:
+            digit_sum -= 2 * first_digit
+
+        if digit_sum > 0:
+            count += 1
+
+    return count
+
+
+assert count_nums([]) == 0
+assert count_nums([-1, 11, -11]) == 1
+assert count_nums([1, 1, 2]) == 3
+assert count_nums([-123, -100, -19, 0, 10, 99]) == 4
