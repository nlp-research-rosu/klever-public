+  rule magnitude(I:Int) => I        requires I >=Int 0
+
+  // The leading decimal digit and the sum of all remaining decimal digits.
+  // Their equations mirror repeated non-negative Python division by 10.
+  syntax Int ::= leadingDigit(Int) [function]
+               | trailingDigitSum(Int) [function]
+  rule leadingDigit(N:Int) => N
+    requires 0 <=Int N andBool N <Int 10
+    [simplification]
+
+  rule trailingDigitSum(N:Int) => 0
+    requires 0 <=Int N andBool N <Int 10
+    [simplification]
+
+  // The prompt's signed-digit convention: only the leading digit is negated.
+  syntax Int ::= signedDigitSum(Int) [function, total]
+  rule signedDigitSum(I:Int)
+    => trailingDigitSum(magnitude(I)) -Int leadingDigit(magnitude(I))
+    requires I <Int 0
+  rule signedDigitSum(I:Int)
+    => trailingDigitSum(magnitude(I)) +Int leadingDigit(magnitude(I))
+    requires I >=Int 0
+
+  // Mathematical count over an arbitrary finite integer ValSeq.
+  syntax Int ::= countNumsSpec(ValSeq) [function]
+  rule countNumsSpec(.ValSeq) => 0
+  rule countNumsSpec(vCons(I:Int, R:ValSeq))
+    => (#if signedDigitSum(I) >Int 0 #then 1 #else 0 #fi)
+       +Int countNumsSpec(R)
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..28ee6a7b34e08d81c916a3112524a9537d458bc1
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,29 @@
+def count_nums(arr):
+    count = 0
+    for num in arr:
+        if num < 0:
+            n = -num
+        else:
+            n = num
+
+        digit_sum = 0
+        first_digit = 0
+        for char in str(n):
+            digit = int(char)
+            if first_digit == 0:
+                first_digit = digit
+            digit_sum += digit
+
+        if num < 0:
+            digit_sum -= 2 * first_digit
+
+        if digit_sum > 0:
+            count += 1
+
+    return count
+
+
+assert count_nums([]) == 0
+assert count_nums([-1, 11, -11]) == 1
+assert count_nums([1, 1, 2]) == 3
+assert count_nums([-123, -100, -19, 0, 10, 99]) == 4
