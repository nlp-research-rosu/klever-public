+        Compare(Name("n"), CmpOp(">=", Int(10))),
+        AugAssign(Name("digit_sum"), "+",
+          BinOp("%", Name("n"), Int(10)))
+        AugAssign(Name("n"), "//", Int(10))
+        .Stmts)
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      SCOPES:Map
+      1 |-> scope(
+        "arr" |-> list(ARR:ValSeq)
+        "count" |-> COUNT:Int
+        "num" |-> NUM:Int
+        "n" |-> (N:Int => leadingDigit(N))
+        "digit_sum" |-> (S:Int => S +Int trailingDigitSum(N))
+        ,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
