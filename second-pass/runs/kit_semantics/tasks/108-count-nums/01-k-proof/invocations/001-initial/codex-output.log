diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5f4276dda4f9e232d9fb436f88f8ba159cc46d07
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,22 @@
+def count_nums(arr):
+    count = 0
+    for num in arr:
+        if num < 0:
+            n = -num
+        else:
+            n = num
+
+        digit_sum = 0
+        while n >= 10:
+            digit_sum += n % 10
+            n //= 10
+
+        if num < 0:
+            digit_sum -= n
+        else:
+            digit_sum += n
+
+        if digit_sum > 0:
+            count += 1
+
+    return count
diff --git a/spec-digit.k b/spec-digit.k
new file mode 100644
index 0000000000000000000000000000000000000000..8e8b920ae941ffb0dadcd3ca08c934a568e04610
--- /dev/null
+++ b/spec-digit.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SPEC-DIGIT
+  imports VERIFICATION
+
+  claim [digit-loop]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">=", Int(10))),
+        AugAssign(Name("digit_sum"), "+",
+          BinOp("%", Name("n"), Int(10)))
+        AugAssign(Name("n"), "//", Int(10))
+        .Stmts)
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      SCOPES:Map
+      1 |-> scope(
+        "arr" |-> list(ARR:ValSeq)
+        "count" |-> COUNT:Int
+        "num" |-> NUM:Int
+        "n" |-> (N:Int => leadingDigit(N))
+        "digit_sum" |-> (S:Int => S +Int trailingDigitSum(N))
+        ,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
