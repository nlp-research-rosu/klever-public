/bin/bash -lc 'python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
python3 concrete-tests.py
krun concrete-tests.mpy --definition runtime-kompiled > concrete-krun.out 2> concrete-krun.err
kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
