index 0000000000000000000000000000000000000000..454970babc50cf9e9e68bcb9151cfae6a3530c4f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,300 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Structural invariant for the inner character loop.  PREV is the code of
+  // the last character already visited (48 before the first iteration).
+  claim [digit-loop]:
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("char"),
+        Assign(Name("digit"), Call(Name("int"), Name("char")))
+        If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+          Assign(Name("first_digit"), Name("digit")) .Stmts,
+          .Stmts)
+        AugAssign(Name("digit_sum"), "+", Name("digit"))
+        .Stmts)
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope("count_nums" |-> FN:Val, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "arr" |-> list(ARR:ValSeq)
+        "count" |-> COUNT:Int
+        "num" |-> NUM:Val
+        "n" |-> NN:Val
+        "digit_sum" |->
+          (SUM:Int => SUM +Int codeDigitSum(CS))
+        "first_digit" |->
+          (FIRST:Int => chooseFirst(FIRST, CS))
+        "char" |->
+          (str(iCons(PREV:Int, .IntSeq))
+            => str(iCons(lastCode(PREV, CS), .IntSeq)))
+        "digit" |->
+          (PREV -Int 48 => lastCode(PREV, CS) -Int 48),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allDigitCodes(CS)
+      andBool 48 <=Int PREV
+      andBool PREV <=Int 57
+
+  // Recurrent outer-loop base case.  The source return and fixed frame-pop
+  // behavior are part of this claim.
+  claim [outer-loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("num"),
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+          Assign(Name("n"), Name("num")) .Stmts)
+        Assign(Name("digit_sum"), Int(0))
+        Assign(Name("first_digit"), Int(0))
+        Assign(Name("char"), Str("0"))
+        Assign(Name("digit"), Int(0))
+        For(
+          Name("char"),
+          Call(Name("str"), Name("n")),
+          Assign(Name("digit"), Call(Name("int"), Name("char")))
+          If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+            Assign(Name("first_digit"), Name("digit")) .Stmts,
+            .Stmts)
+          AugAssign(Name("digit_sum"), "+", Name("digit"))
+          .Stmts)
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          AugAssign(
+            Name("digit_sum"),
+            "-",
+            BinOp("*", Int(2), Name("first_digit")))
+          .Stmts,
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+        .Stmts)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => C:Int
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope("count_nums" |-> FN:Val, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "arr" |-> list(ORIGINAL:ValSeq)
+        "count" |-> C:Int
+        "num" |-> OLDNUM:Val
+        "n" |-> OLDN:Val
+        "digit_sum" |-> OLDSUM:Int
+        "first_digit" |-> OLDFIRST:Int
+        "char" |-> str(iCons(OLDCODE:Int, .IntSeq))
+        "digit" |-> OLDCODE -Int 48,
+        parent(0))
+      =>
+      0 |-> scope("count_nums" |-> FN, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Recurrent outer-loop inductive case over one integer head and an
+  // arbitrary all-integer tail.
+  claim [outer-loop-step]:
+    <k>
+      #loop(
+        list(vCons(I:Val, R:ValSeq)),
+        Name("num"),
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+          Assign(Name("n"), Name("num")) .Stmts)
+        Assign(Name("digit_sum"), Int(0))
+        Assign(Name("first_digit"), Int(0))
+        Assign(Name("char"), Str("0"))
+        Assign(Name("digit"), Int(0))
+        For(
+          Name("char"),
+          Call(Name("str"), Name("n")),
+          Assign(Name("digit"), Call(Name("int"), Name("char")))
+          If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+            Assign(Name("first_digit"), Name("digit")) .Stmts,
+            .Stmts)
+          AugAssign(Name("digit_sum"), "+", Name("digit"))
+          .Stmts)
+        If(Compare(Name("num"), CmpOp("<", Int(0))),
+          AugAssign(
+            Name("digit_sum"),
+            "-",
+            BinOp("*", Int(2), Name("first_digit")))
+          .Stmts,
+          .Stmts)
+        If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+        .Stmts)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => C:Int +Int countNumsSpec(vCons(I, R))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope("count_nums" |-> FN:Val, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "arr" |-> list(ORIGINAL:ValSeq)
+        "count" |-> C:Int
+        "num" |-> OLDNUM:Val
+        "n" |-> OLDN:Val
+        "digit_sum" |-> OLDSUM:Int
+        "first_digit" |-> OLDFIRST:Int
+        "char" |-> str(iCons(OLDCODE:Int, .IntSeq))
+        "digit" |-> OLDCODE -Int 48,
+        parent(0))
+      =>
+      0 |-> scope("count_nums" |-> FN, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isInt(I) andBool allInts(R)
+
+  // Exact translated function call on the empty list.
+  claim [count-nums-empty]:
+    <k>
+      Call(Name("count_nums"), list(.ValSeq))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_nums" |->
+          closureVal(
+            "arr" , .ParamNames,
+            Assign(Name("count"), Int(0))
+            For(
+              Name("num"),
+              Name("arr"),
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+                Assign(Name("n"), Name("num")) .Stmts)
+              Assign(Name("digit_sum"), Int(0))
+              Assign(Name("first_digit"), Int(0))
+              Assign(Name("char"), Str("0"))
+              Assign(Name("digit"), Int(0))
+              For(
+                Name("char"),
+                Call(Name("str"), Name("n")),
+                Assign(Name("digit"), Call(Name("int"), Name("char")))
+                If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+                  Assign(Name("first_digit"), Name("digit")) .Stmts,
+                  .Stmts)
+                AugAssign(Name("digit_sum"), "+", Name("digit"))
+                .Stmts)
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                AugAssign(
+                  Name("digit_sum"),
+                  "-",
+                  BinOp("*", Int(2), Name("first_digit")))
+                .Stmts,
+                .Stmts)
+              If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Exact translated function call on every nonempty finite integer list.
+  claim [count-nums-nonempty]:
+    <k>
+      Call(Name("count_nums"), list(vCons(I:Int, R:ValSeq)))
+      => ?RESULT:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "count_nums" |->
+          closureVal(
+            "arr" , .ParamNames,
+            Assign(Name("count"), Int(0))
+            For(
+              Name("num"),
+              Name("arr"),
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                Assign(Name("n"), UnaryOp("-", Name("num"))) .Stmts,
+                Assign(Name("n"), Name("num")) .Stmts)
+              Assign(Name("digit_sum"), Int(0))
+              Assign(Name("first_digit"), Int(0))
+              Assign(Name("char"), Str("0"))
+              Assign(Name("digit"), Int(0))
+              For(
+                Name("char"),
+                Call(Name("str"), Name("n")),
+                Assign(Name("digit"), Call(Name("int"), Name("char")))
+                If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
+                  Assign(Name("first_digit"), Name("digit")) .Stmts,
+                  .Stmts)
+                AugAssign(Name("digit_sum"), "+", Name("digit"))
+                .Stmts)
+              If(Compare(Name("num"), CmpOp("<", Int(0))),
+                AugAssign(
+                  Name("digit_sum"),
+                  "-",
+                  BinOp("*", Int(2), Name("first_digit")))
+                .Stmts,
+                .Stmts)
+              If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
+                AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(R)
+    ensures ?RESULT ==Int countNumsSpec(vCons(I, R))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bdb18edb48ed30f8cce02fbdcab1e71533358e3e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,117 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Candidate-domain predicate: every element is an integer.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // The Haskell backend does not refine V:Val to Int from an isInt(V) path
+  // condition.  This guarded total projection is the standard K cast-boundary
+  // idiom; it creates no integer value unless the fixed subsort cast is
+  // defined.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val))
+    => projectIntTotal(V)
+    [simplification]
+
+  // Guarded dispatch twins of the supplied Int equations used after list
+  // iteration yields a dynamically sorted Val.
+  rule applyCmp("<", V:Val, J:Int)
+    => projectIntTotal(V) <Int J
+    requires isInt(V)
+    [simplification]
+  rule applyUn("-", V:Val)
+    => 0 -Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  syntax Int ::= magnitude(Int) [function, total]
+  rule magnitude(I:Int) => 0 -Int I requires I <Int 0
+  rule magnitude(I:Int) => I        requires I >=Int 0
+
+  // A proof-side name for the code sequence returned by the supplied
+  // Int2String/strToCodes primitive.  The concrete rule remains in the fixed
+  // semantics; this simplification names its already-produced result.
+  syntax IntSeq ::= decimalCodes(Int)
+    [function, total, no-evaluators]
+  rule strToCodes(Int2String(N:Int)) => decimalCodes(N)
+    requires N >=Int 0
+    [simplification]
+
+  rule applyBuiltin("str", V:Val, .Vals)
+    => str(decimalCodes(projectIntTotal(V)))
+    requires isInt(V)
+    [simplification]
+
+  syntax Bool ::= allDigitCodes(IntSeq) [function, total]
+  rule allDigitCodes(.IntSeq) => true
+  rule allDigitCodes(iCons(C:Int, R:IntSeq))
+    => (48 <=Int C andBool C <=Int 57) andBool allDigitCodes(R)
+
+  // Contract of the fixed Int2String primitive on non-negative integers.
+  // This is the only value-level trust boundary in the proof.
+  rule allDigitCodes(decimalCodes(N:Int)) => true
+    requires N >=Int 0
+    [simplification]
+
+  syntax Int ::= codeDigitSum(IntSeq) [function, total]
+  rule codeDigitSum(.IntSeq) => 0
+  rule codeDigitSum(iCons(C:Int, R:IntSeq))
+    => (C -Int 48) +Int codeDigitSum(R)
+
+  // Result of the source loop's "first nonzero digit seen" accumulator.
+  syntax Int ::= chooseFirst(Int, IntSeq) [function, total]
+  rule chooseFirst(F:Int, .IntSeq) => F
+  rule chooseFirst(0, iCons(C:Int, R:IntSeq))
+    => chooseFirst(C -Int 48, R)
+  rule chooseFirst(F:Int, iCons(_:Int, R:IntSeq))
+    => chooseFirst(F, R)
+    requires F =/=Int 0
+    [simplification]
+
+  syntax Int ::= lastCode(Int, IntSeq) [function, total]
+  rule lastCode(C:Int, .IntSeq) => C
+  rule lastCode(_:Int, iCons(C:Int, R:IntSeq)) => lastCode(C, R)
+
+  syntax Int ::= signedDigitSum(Int) [function, total]
+  rule signedDigitSum(I:Int)
+    => codeDigitSum(decimalCodes(magnitude(I)))
+       -Int (2 *Int chooseFirst(0, decimalCodes(magnitude(I))))
+    requires I <Int 0
+  rule signedDigitSum(I:Int)
+    => codeDigitSum(decimalCodes(magnitude(I)))
+    requires I >=Int 0
+
+  syntax Int ::= countNumsSpec(ValSeq) [function, total]
+  rule countNumsSpec(.ValSeq) => 0
+  rule countNumsSpec(vCons(V:Val, R:ValSeq))
+    => (#if signedDigitSum(projectIntTotal(V)) >Int 0
+         #then 1 #else 0 #fi)
+       +Int countNumsSpec(R)
+    requires isInt(V)
+  rule countNumsSpec(vCons(V:Val, R:ValSeq))
+    => countNumsSpec(R)
+    requires notBool isInt(V)
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1b0ae13a22d5985e6464ce661e34cac235e0a6a
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,31 @@
+def count_nums(arr):
+    count = 0
+    for num in arr:
+        if num < 0:
+            n = -num
+        else:
+            n = num
+
+        digit_sum = 0
+        first_digit = 0
+        char = "0"
+        digit = 0
+        for char in str(n):
+            digit = int(char)
+            if first_digit == 0:
+                first_digit = digit
+            digit_sum += digit
+
+        if num < 0:
+            digit_sum -= 2 * first_digit
+
+        if digit_sum > 0:
+            count += 1
+
+    return count
+
+
+assert count_nums([]) == 0
+assert count_nums([-1, 11, -11]) == 1
+assert count_nums([1, 1, 2]) == 3
+assert count_nums([-123, -100, -19, 0, 10, 99]) == 4
