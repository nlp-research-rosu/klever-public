+          .Stmts)
+        .Stmts)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => C:Int
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope("count_nums" |-> FN:Val, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
