exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled >/tmp/count_nums_kompile.out 2>/tmp/count_nums_kompile.err && timeout 60s kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.digit-loop --depth 30 > digit-depth-30.out 2> digit-depth-30.err; status=$?; echo EXIT=$status; tail -n 160 digit-depth-30.out; tail -n 100 digit-depth-30.err; exit 0' in /workspace
