+                .Stmts)
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Exact translated function call on every nonempty finite integer list.
+  claim [count-nums-nonempty]:
+    <k>
+      Call(Name("count_nums"), list(vCons(I:Int, R:ValSeq)))
+      => ?RESULT:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
