+def count_nums(arr):
+    count = 0
+    for num in arr:
+        if num < 0:
+            n = -num
+        else:
+            n = num
+
+        digit_sum = 0
+        while n >= 10:
+            digit_sum += n % 10
+            n //= 10
+
+        if num < 0:
+            digit_sum -= n
+        else:
+            digit_sum += n
+
+        if digit_sum > 0:
+            count += 1
+
+    return count

