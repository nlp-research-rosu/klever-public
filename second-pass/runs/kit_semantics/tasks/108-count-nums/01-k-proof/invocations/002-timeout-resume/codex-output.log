def count_nums(arr):
    count = 0
    for num in arr:
        if num < 0:
            n = -num
        else:
            n = num

        digit_sum = 0
        first_digit = 0
        char = "0"
        digit = 0
        for char in str(n):
            digit = int(char)
            if first_digit == 0:
                first_digit = digit
            digit_sum += digit

        if num < 0:
            digit_sum -= 2 * first_digit

        if digit_sum > 0:
            count += 1

    return count


assert count_nums([]) == 0
assert count_nums([-1, 11, -11]) == 1
assert count_nums([1, 1, 2]) == 3
assert count_nums([-123, -100, -19, 0, 10, 99]) == 4
import random

from solution import count_nums


def signed_digit_sum_oracle(number):
    text = str(number)
    if text[0] == "-":
        return -int(text[1]) + sum(int(char) for char in text[2:])
    return sum(int(char) for char in text)


def count_nums_oracle(values):
    return sum(signed_digit_sum_oracle(value) > 0 for value in values)


def main():
    cases = [
        [],
        [-1, 11, -11],
        [1, 1, 2],
        [-123, -100, -19, 0, 10, 99],
        [-(10**50 - 1), 10**50 - 1, -10000000000000000001],
    ]

    # Exhaustive singleton coverage around all sign and decimal boundaries.
    cases.extend([[value] for value in range(-5000, 5001)])

    rng = random.Random(20260729)
    for _ in range(2000):
        size = rng.randrange(0, 21)
        cases.append(
            [rng.randrange(-(10**30), 10**30 + 1) for _ in range(size)]
        )

    mismatches = []
    decimal_contract_failures = []
    checked_values = 0
    for values in cases:
        expected = count_nums_oracle(values)
        actual = count_nums(values)
        if actual != expected:
            mismatches.append((values, expected, actual))

        for value in values:
            checked_values += 1
            magnitude_text = str(abs(value))
            if not magnitude_text or not all("0" <= char <= "9" for char in magnitude_text):
                decimal_contract_failures.append((value, magnitude_text))

    print(
        f"cases={len(cases)} values={checked_values} "
        f"mismatches={len(mismatches)} "
        f"decimal_contract_failures={len(decimal_contract_failures)}"
    )
    if mismatches:
        print("first mismatch:", mismatches[0])
    if decimal_contract_failures:
        print("first decimal contract failure:", decimal_contract_failures[0])

    assert not mismatches
    assert not decimal_contract_failures


if __name__ == "__main__":
    main()
Module(
  FuncDef("count_nums", Params("arr"),
    Assign(Name("count"), Int(0))
    For(Name("num"), Name("arr"),
      If(Compare(Name("num"), CmpOp("<", Int(0))),
        Assign(Name("n"), UnaryOp("-", Name("num"))),
        Assign(Name("n"), Name("num")))
      Assign(Name("digit_sum"), Int(0))
      Assign(Name("first_digit"), Int(0))
      Assign(Name("char"), Str("0"))
      Assign(Name("digit"), Int(0))
      For(Name("char"), Call(Name("str"), Name("n")),
        Assign(Name("digit"), Call(Name("int"), Name("char")))
        If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
          Assign(Name("first_digit"), Name("digit")),
          )
        AugAssign(Name("digit_sum"), "+", Name("digit")))
      If(Compare(Name("num"), CmpOp("<", Int(0))),
        AugAssign(
          Name("digit_sum"),
          "-",
          BinOp("*", Int(2), Name("first_digit"))),
        )
      If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
        AugAssign(Name("count"), "+", Int(1)),
        ))
    Return(Name("count"))))

