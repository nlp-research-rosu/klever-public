+mutation_status=${PIPESTATUS[0]}
+set -e
+echo "EXPECTED_NONZERO_STATUS=$mutation_status"
+if (( mutation_status == 0 )); then
+  echo "The body-mutation probe unexpectedly proved." >&2
+  exit 1
+fi
