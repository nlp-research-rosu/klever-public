     1	def count_nums(arr):
     2	    count = 0
     3	    for num in arr:
     4	        if num < 0:
     5	            n = -num
     6	        else:
     7	            n = num
     8	
     9	        digit_sum = 0
    10	        first_digit = 0
    11	        char = "0"
    12	        digit = 0
    13	        for char in str(n):
    14	            digit = int(char)
    15	            if first_digit == 0:
    16	                first_digit = digit
    17	            digit_sum += digit
    18	
    19	        if num < 0:
    20	            digit_sum -= 2 * first_digit
    21	
    22	        if digit_sum > 0:
    23	            count += 1
    24	
    25	    return count
