+
+example : (Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+    "str" (oneArg (.inj_SortInt 908)) == strVal [57, 48, 56]) = true := by native_decide
+example : (Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+    "str" (oneArg (.inj_SortInt 0)) == strVal [48]) = true := by native_decide
+
+#check (Proof.final :
+  Klean108CountNums.Lemmas.targetStatement
+    Proof.«_-Int_» Proof._andBool_ Proof.«_>=Int_» Proof.«_<Int_»
+    Proof.«allDigitCodes(_)_VERIFICATION_Bool_IntSeq»
+    Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    Proof.«applyUn(_,_)_MPY-CORE_Val_String_Val»
+    Proof.«decimalCodes(_)_VERIFICATION_IntSeq_Int»
+    Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val»
