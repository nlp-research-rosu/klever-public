   487	/- Complete executable table for the frozen applyBuiltin rules.  A noneV
   488	   result occurs only when the corresponding K function has no matching
   489	   concrete rule (that is, execution would be stuck). -/
   490	private def applyBuiltinImpl : String → SortVals → SortVal
   491	  | "len", .«_,__MPY-CORE_Vals_Val_Vals» obj .«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
   492	      match seqLenImpl obj with | some n => .inj_SortInt n | none => noneVal
   493	  | "set", .«_,__MPY-CORE_Vals_Val_Vals»
