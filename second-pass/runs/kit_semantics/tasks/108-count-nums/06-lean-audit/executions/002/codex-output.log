codex
The root cause is isolated: this sandbox exposes `/proc/self/exe` but not Lean’s constructed `/proc/<pid>/exe` path. A narrowly scoped preload shim redirects only that exact executable-path lookup to `/proc/self/exe`; I’m recording its source/hash and using it solely to restore the pinned Lean binary’s normal launcher detection. The clean build is now running.
diff --git a//tmp/audit-work/app_path_probe.c b//tmp/audit-work/app_path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..c2c31a95532c0f8d3453deada7a212cc67b5032e
--- /dev/null
+++ b//tmp/audit-work/app_path_probe.c
@@ -0,0 +1,16 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[4096];
+  ssize_t size = readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+  if (size < 0) {
+    fprintf(stderr, "readlink failed: errno=%d (%s)\n", errno, strerror(errno));
+    return 1;
+  }
+  buffer[size] = '\0';
+  printf("%s\n", buffer);
+  return 0;
+}
