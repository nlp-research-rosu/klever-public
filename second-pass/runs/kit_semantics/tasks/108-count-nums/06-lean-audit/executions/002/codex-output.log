   478	private def applyUnImpl : String → SortVal → SortVal
   479	  | "-", .inj_SortInt i => .inj_SortInt (0 - i)
   480	  | "-", .inj_SortFloat f => .inj_SortFloat (0.0 - f)
   481	  | "not", v =>
   482	      match truthyImpl v with
   483	      | some b => .inj_SortBool (!b)
   484	      | none => noneVal
   485	  | _, _ => noneVal
