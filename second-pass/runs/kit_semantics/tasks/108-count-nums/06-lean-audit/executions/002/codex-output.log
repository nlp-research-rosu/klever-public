   326	private def tokenizeOps : List Int → List String
   327	  | [] => []
   328	  | 42 :: 42 :: r => "**" :: tokenizeOps r
   329	  | 47 :: 47 :: r => "//" :: tokenizeOps r
   330	  | 42 :: r => "*" :: tokenizeOps r
   331	  | 47 :: r => "/" :: tokenizeOps r
   332	  | 43 :: r => "+" :: tokenizeOps r
   333	  | 45 :: r => "-" :: tokenizeOps r
   334	  | _ :: r => tokenizeOps r
