+#!/usr/bin/env python3
+import hashlib
+import json
+import re
+from pathlib import Path
+
+
+def load(path: str):
+    return json.loads(Path(path).read_text())
+
+
+def sha256(path: str) -> str:
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+generator = load("/reference/klean-generation/generator-manifest.json")
+obligation_map = load("/reference/klean-generation/generated/obligation-map.json")
+discovery = load("/reference/lemma-discovery.json")
+audit_input = load("/audit-input.json")
+proof_path = Path("/candidate/Proof.lean")
+proof = proof_path.read_text()
+
+domain_ids = [
+    rule["source_rule_id"]
+    for rule in discovery["rules"]
+    if rule["classification"] == "DOMAIN_LEMMA"
+]
+source_ids = [rule["source_rule_id"] for rule in obligation_map["source_rules"]]
+obligation_ids = [item["source_rule_id"] for item in obligation_map["obligations"]]
+
+target = generator["target"]
+final_match = re.search(r"(?ms)^theorem\s+final\s*:\s*(.*?)\s*:=\s*by", proof)
+if final_match is None:
+    raise SystemExit("Proof.final statement not found")
+normalize = lambda value: " ".join(value.split())
+candidate_statement = normalize(final_match.group(1))
+expected_statement = normalize(target["statement"])
+
+forbidden = {
+    token: [match.start() for match in re.finditer(rf"\b{token}\b", proof)]
+    for token in ("sorry", "admit", "unsafe", "axiom", "opaque")
+}
+parameter_bindings = []
+for parameter in target["parameters"]:
+    name = parameter["name"]
+    parameter_bindings.append(
+        {
+            "name": name,
+            "kore_symbol": parameter["kore_symbol"],
+            "source_rule_ids": parameter["source_rule_ids"],
+            "public_def_present_once": len(
+                re.findall(rf"(?m)^def\s+{re.escape(name)}(?=\s|:)", proof)
+            )
+            == 1,
+        }
+    )
+
+result = {
+    "commands": [
+        "sha256sum candidate/Proof.lean and generated/obligation-map.json",
+        "compare generator target to audit-input target and stage4_preflight target",
+        "compare ordered Stage3 DOMAIN_LEMMA, Stage4 source_rules, and Stage4 obligations IDs",
+        "extract Proof.final statement and compare with fixed target statement",
+        "scan candidate Proof.lean for sorry/admit/unsafe/axiom/opaque and target shadowing",
+        "check every target parameter has exactly one public candidate def",
+    ],
+    "hashes": {
+        "candidate_Proof_lean_sha256": sha256(str(proof_path)),
+        "obligation_map_sha256_actual": sha256(
+            "/reference/klean-generation/generated/obligation-map.json"
+        ),
+        "obligation_map_sha256_manifest": generator["obligation_map_sha256"],
+    },
+    "target": {
+        "generator_equals_audit_input": target == audit_input["resolution"]["target"],
+        "generator_equals_recorded_preflight": target
+        == audit_input["resolution"]["stage4_preflight"]["target"],
+        "declaration": target["declaration"],
+        "definition_sha256": target["definition_sha256"],
+        "statement_sha256": target["statement_sha256"],
+        "candidate_final_statement_exact": candidate_statement == expected_statement,
+        "candidate_target_shadow_declaration_count": len(
+            re.findall(
+                r"(?m)^(?:def|theorem|axiom|opaque)\s+targetStatement\b", proof
+            )
+        ),
+        "candidate_final_declaration_count": len(
+            re.findall(r"(?m)^theorem\s+final\b", proof)
+        ),
+    },
+    "bijection": {
+        "stage3_domain_ids": domain_ids,
+        "stage4_source_ids": source_ids,
+        "stage4_obligation_ids": obligation_ids,
+        "all_three_ordered_lists_equal": domain_ids == source_ids == obligation_ids,
+        "unique": len(domain_ids) == len(set(domain_ids)),
+        "count": len(domain_ids),
+    },
+    "obligations": [
+        {
+            "source_rule_id": item["source_rule_id"],
+            "source_span": item["source_span"],
+            "lean_conjunct_sha256": item["lean_conjunct_sha256"],
+            "is_exact_True": normalize(item["lean_conjunct"]) == "True",
+            "contains_True_subterm": "True" in item["lean_conjunct"],
+            "lean_conjunct": item["lean_conjunct"],
+        }
+        for item in obligation_map["obligations"]
+    ],
+    "candidate": {
+        "forbidden_token_offsets": forbidden,
+        "all_forbidden_empty": all(not positions for positions in forbidden.values()),
+        "parameter_bindings": parameter_bindings,
+        "all_parameters_bound_once": all(
+            entry["public_def_present_once"] for entry in parameter_bindings
+        ),
+    },
+}
+
+print(json.dumps(result, indent=2, sort_keys=True))
+
+assert result["hashes"]["obligation_map_sha256_actual"] == result["hashes"]["obligation_map_sha256_manifest"]
+assert result["target"]["generator_equals_audit_input"]
+assert result["target"]["generator_equals_recorded_preflight"]
