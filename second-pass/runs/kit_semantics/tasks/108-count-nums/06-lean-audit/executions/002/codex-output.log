@@ -0,0 +1,16 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[4096];
+  ssize_t size = readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+  if (size < 0) {
+    fprintf(stderr, "readlink failed: errno=%d (%s)\n", errno, strerror(errno));
+    return 1;
+  }
+  buffer[size] = '\0';
+  printf("%s\n", buffer);
+  return 0;
+}
