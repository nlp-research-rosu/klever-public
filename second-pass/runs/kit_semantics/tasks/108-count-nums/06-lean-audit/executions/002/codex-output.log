   336	private def takeNumber (acc : Int) : List Int → Int × List Int
   337	  | c :: r =>
   338	      if 48 ≤ c && c ≤ 57 then takeNumber (acc * 10 + c - 48) r
   339	      else (acc, c :: r)
   340	  | [] => (acc, [])
   341	
   342	private def tokenizeNumsFuel : Nat → List Int → List Int
   343	  | 0, _ => []
   344	  | _ + 1, [] => []
   345	  | fuel + 1, c :: r =>
   346	      if 48 ≤ c && c ≤ 57 then
   347	        let p := takeNumber (c - 48) r
   348	        p.1 :: tokenizeNumsFuel fuel p.2
   349	      else tokenizeNumsFuel fuel r
   350	
   351	private def tokenizeNums (s : List Int) : List Int :=
   352	  tokenizeNumsFuel (s.length + 1) s
