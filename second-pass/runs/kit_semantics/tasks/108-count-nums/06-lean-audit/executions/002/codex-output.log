   417	/- Complete executable table for the frozen applyCmp rules over every sort
   418	   represented by SortVal. Unsupported combinations are precisely the stuck
   419	   cases of the partial K dispatcher. -/
   420	private def applyCmpImpl : String → SortVal → SortVal → Bool
   421	  | "==", .inj_SortInt a, .inj_SortInt b => a == b
   422	  | "!=", .inj_SortInt a, .inj_SortInt b => a != b
   423	  | "<",  .inj_SortInt a, .inj_SortInt b => a < b
   424	  | "<=", .inj_SortInt a, .inj_SortInt b => a ≤ b
   425	  | ">",  .inj_SortInt a, .inj_SortInt b => a > b
   426	  | ">=", .inj_SortInt a, .inj_SortInt b => a ≥ b
   427	  | "==", .inj_SortBool a, .inj_SortBool b => a == b
   428	  | "!=", .inj_SortBool a, .inj_SortBool b => a != b
   429	  | "==", .inj_SortFloat a, .inj_SortFloat b => a == b
   430	  | "!=", .inj_SortFloat a, .inj_SortFloat b => a != b
   431	  | "<",  .inj_SortFloat a, .inj_SortFloat b => a < b
   432	  | "<=", .inj_SortFloat a, .inj_SortFloat b => !(a > b)
   433	  | ">",  .inj_SortFloat a, .inj_SortFloat b => a > b
   434	  | ">=", .inj_SortFloat a, .inj_SortFloat b => !(a < b)
   435	  | "==", .inj_SortInt a, .inj_SortFloat b => Float.ofInt a == b
   436	  | "!=", .inj_SortInt a, .inj_SortFloat b => Float.ofInt a != b
   437	  | "<",  .inj_SortInt a, .inj_SortFloat b => Float.ofInt a < b
   438	  | ">",  .inj_SortInt a, .inj_SortFloat b => Float.ofInt a > b
   439	  | "==", .inj_SortFloat a, .inj_SortInt b => a == Float.ofInt b
   440	  | "!=", .inj_SortFloat a, .inj_SortInt b => a != Float.ofInt b
   441	  | "<",  .inj_SortFloat a, .inj_SortInt b => a < Float.ofInt b
   442	  | ">",  .inj_SortFloat a, .inj_SortInt b => a > Float.ofInt b
   443	  | "==", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
   444	          .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => a == b
   445	  | "!=", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
   446	          .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => a != b
   447	  | "in", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
   448	          .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => strContains a b
   449	  | "not in", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
   450	              .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => !strContains a b
   451	  | "<", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
   452	         .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => strLt a b
   453	  | ">", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
   454	         .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => strLt b a
   455	  | "<=", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
   456	          .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => !strLt b a
   457	  | ">=", .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» a),
   458	          .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» b) => !strLt a b
   459	  | "==", .inj_SortIterable (.«list(_)_MPY-CORE_Iterable_ValSeq» a),
   460	          .inj_SortIterable (.«list(_)_MPY-CORE_Iterable_ValSeq» b) => a == b
   461	  | "!=", .inj_SortIterable (.«list(_)_MPY-CORE_Iterable_ValSeq» a),
   462	          .inj_SortIterable (.«list(_)_MPY-CORE_Iterable_ValSeq» b) => a != b
   463	  | "==", .inj_SortIterable (.«tuple(_)_MPY-CORE_Iterable_ValSeq» a),
   464	          .inj_SortIterable (.«tuple(_)_MPY-CORE_Iterable_ValSeq» b) => a == b
   465	  | "!=", .inj_SortIterable (.«tuple(_)_MPY-CORE_Iterable_ValSeq» a),
   466	          .inj_SortIterable (.«tuple(_)_MPY-CORE_Iterable_ValSeq» b) => a != b
   467	  | "==", .«setV(_)_MPY-SET_Val_IntSeq» a,
   468	          .«setV(_)_MPY-SET_Val_IntSeq» b => sameSet a b
   469	  | "==", .«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» k₁ v₁,
   470	          .«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» k₂ v₂ =>
   471	      dictEq k₁ v₁ k₂ v₂
   472	  | "==", v, .«noneV_MPY-CORE_Val» => v == noneVal
   473	  | "!=", v, .«noneV_MPY-CORE_Val» => v != noneVal
   474	  | "is", v, .«noneV_MPY-CORE_Val» => v == noneVal
   475	  | "is not", v, .«noneV_MPY-CORE_Val» => v != noneVal
   476	  | _, _, _ => false
