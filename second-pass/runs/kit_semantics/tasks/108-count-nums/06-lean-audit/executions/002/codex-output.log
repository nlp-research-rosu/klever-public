+import Proof
+
+namespace OperationalAudit
+
+private def intSeqNil : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+private def intSeqCons (i : Int) (r : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» i r
+
+private def codes (xs : List Int) : SortIntSeq :=
+  xs.foldr intSeqCons intSeqNil
+
+private def valsNil : SortVals :=
+  SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+
+private def oneArg (v : SortVal) : SortVals :=
+  SortVals.«_,__MPY-CORE_Vals_Val_Vals» v valsNil
+
+private def asK (v : SortVal) : SortK :=
+  SortK.kseq ((@inj SortVal SortKItem) v) SortK.dotk
+
+private def strVal (xs : List Int) : SortVal :=
+  SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» (codes xs))
+
+-- Primitive hooks used by the frozen rules.
+example : Proof.«_-Int_» 7 12 = -5 := by native_decide
+example : Proof.«_-Int_» (-4) 9 = -13 := by native_decide
+example : Proof._andBool_ true false = false := rfl
+example : Proof._andBool_ true true = true := rfl
+example : Proof.«_>=Int_» (-1) 0 = false := by native_decide
+example : Proof.«_>=Int_» 0 0 = true := by native_decide
+example : Proof.«_<Int_» (-4) 0 = true := by native_decide
+example : Proof.«_<Int_» 3 3 = false := by native_decide
+
+-- Structural digit predicate, including both boundaries and adversarial codes.
+example : Proof.«allDigitCodes(_)_VERIFICATION_Bool_IntSeq» (codes []) = true := rfl
+example : Proof.«allDigitCodes(_)_VERIFICATION_Bool_IntSeq» (codes [48, 57, 50]) = true := by native_decide
+example : Proof.«allDigitCodes(_)_VERIFICATION_Bool_IntSeq» (codes [47]) = false := by native_decide
+example : Proof.«allDigitCodes(_)_VERIFICATION_Bool_IntSeq» (codes [58]) = false := by native_decide
+
+-- Cast observer, partial projection, and guarded total projection.
+example : Proof.isInt (asK (.inj_SortInt (-37))) = true := rfl
+example : Proof.isInt (asK (strVal [49])) = false := rfl
+example : Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» (.inj_SortInt 22) = true := rfl
+example : Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» (strVal [50]) = false := rfl
+example : Proof.«project:Int?» (asK (.inj_SortInt (-37))) = some (-37) := rfl
+example : Proof.«project:Int?» (asK (strVal [49])) = none := rfl
+example : Proof.projectIntTotal (.inj_SortInt (-37)) = -37 := rfl
+-- The totalized fallback is outside the guard and is not used as evidence.
+example : Proof.projectIntTotal (strVal [49]) = 0 := rfl
+
+-- Exact dynamic-Val bridges from the three operational domain lemmas.
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    "<" (.inj_SortInt (-3)) (.inj_SortInt 2) = true := rfl
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    "<" (.inj_SortInt 2) (.inj_SortInt (-3)) = false := rfl
+example : Proof.«applyUn(_,_)_MPY-CORE_Val_String_Val»
+    "-" (.inj_SortInt (-8)) = .inj_SortInt 8 := rfl
+example : Proof.«applyUn(_,_)_MPY-CORE_Val_String_Val»
+    "-" (.inj_SortInt 8) = .inj_SortInt (-8) := rfl
+
+-- Independent decimal witnesses: zero, internal zeros, multi-digit and sign.
+example : (Proof.«decimalCodes(_)_VERIFICATION_IntSeq_Int» 0 == codes [48]) = true := by native_decide
+example : (Proof.«decimalCodes(_)_VERIFICATION_IntSeq_Int» 7 == codes [55]) = true := by native_decide
+example : (Proof.«decimalCodes(_)_VERIFICATION_IntSeq_Int» 10 == codes [49, 48]) = true := by native_decide
+example : (Proof.«decimalCodes(_)_VERIFICATION_IntSeq_Int» 101 == codes [49, 48, 49]) = true := by native_decide
+example : (Proof.«decimalCodes(_)_VERIFICATION_IntSeq_Int» 908 == codes [57, 48, 56]) = true := by native_decide
