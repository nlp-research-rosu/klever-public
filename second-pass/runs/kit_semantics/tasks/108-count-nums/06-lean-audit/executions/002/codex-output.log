   282	/- Decode a binary64 directly, so Float2Int has the arbitrary-precision Int
   283	   range of K rather than silently narrowing through Int64. -/
   284	private def floatIntegralBound (wantCeil : Bool) (f : Float) : Int :=
   285	  let bits := f.toBits.toNat
   286	  let sign := bits / (2 ^ 63) == 1
   287	  let exponent := (bits / (2 ^ 52)) % 2048
   288	  let fraction := bits % (2 ^ 52)
   289	  if exponent == 2047 then
   290	    0
   291	  else
   292	    let mantissa := if exponent == 0 then fraction else 2 ^ 52 + fraction
   293	    let shift : Int :=
   294	      if exponent == 0 then -1074 else Int.ofNat exponent - 1075
   295	    if shift ≥ 0 then
   296	      let magnitude := Int.ofNat (mantissa * (2 ^ shift.toNat))
   297	      if sign then -magnitude else magnitude
   298	    else
   299	      let denominator := 2 ^ (0 - shift).toNat
   300	      let quotient := mantissa / denominator
   301	      let remainder := mantissa % denominator
   302	      let q := Int.ofNat quotient
   303	      if sign then
   304	        if wantCeil || remainder == 0 then -q else -(q + 1)
   305	      else
   306	        if wantCeil && remainder != 0 then q + 1 else q
   307	
   308	private def floatFloorInt (f : Float) : Int := floatIntegralBound false f
   309	private def floatCeilInt (f : Float) : Int := floatIntegralBound true f
   310	
   311	private def roundFloatInt (f : Float) : Int :=
   312	  let fl := f.floor
   313	  if f - fl == 0.5 then
   314	    let i := fl.toInt64.toInt
   315	    if i % 2 == 0 then i else f.ceil.toInt64.toInt
   316	  else
   317	    (f + 0.5).floor.toInt64.toInt
