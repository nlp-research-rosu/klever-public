   357	private def passPow : List String → List Int → List String × List Int
   358	  | [], ns => ([], ns)
   359	  | _, [] => ([], [])
   360	  | op :: ops, n :: ns =>
   361	      let p := passPow ops ns
   362	      if op == "**" then
   363	        match p.2 with
   364	        | m :: rest => (p.1, intPowK n m :: rest)
   365	        | [] => (p.1, [n])
   366	      else
   367	        (op :: p.1, n :: p.2)
   368	
   369	private def applyEvalOp (op : String) (a b : Int) : Int :=
   370	  if op == "+" then a + b
   371	  else if op == "-" then a - b
   372	  else if op == "*" then a * b
   373	  else if op == "//" then a / b
   374	  else if op == "**" then intPowK a b
   375	  else a
   376	
   377	private def inEvalLevel (level op : String) : Bool :=
   378	  if level == "mul" then op == "*" || op == "//" || op == "/"
   379	  else if level == "add" then op == "+" || op == "-"
   380	  else false
   381	
   382	private def passLevelGo (level : String) :
   383	    Int → List String → List Int → List String → List Int →
   384	      List String × List Int
   385	  | cur, [], _, outOps, outNums =>
   386	      (outOps.reverse, (cur :: outNums).reverse)
   387	  | cur, _ :: _, [], outOps, outNums =>
   388	      (outOps.reverse, (cur :: outNums).reverse)
   389	  | cur, op :: ops, n :: ns, outOps, outNums =>
   390	      if inEvalLevel level op then
   391	        passLevelGo level (applyEvalOp op cur n) ops ns outOps outNums
   392	      else
   393	        passLevelGo level n ops ns (op :: outOps) (cur :: outNums)
   394	
   395	private def passLevel (level : String)
   396	    (p : List String × List Int) : List String × List Int :=
   397	  match p.2 with
   398	  | [] => (p.1, [])
   399	  | n :: ns => passLevelGo level n p.1 ns [] []
   400	
   401	private def evalArith (s : SortIntSeq) : Int :=
   402	  let codes := intSeqToList s
   403	  let p := passPow (tokenizeOps codes) (tokenizeNums codes)
   404	  match (passLevel "add" (passLevel "mul" p)).2 with
   405	  | n :: _ => n
   406	  | [] => 0
