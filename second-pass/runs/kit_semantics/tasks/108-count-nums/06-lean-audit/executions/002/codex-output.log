    96	  | «iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» h t ih =>
    97	      simp [allDigitCodesImpl] at hs
    98	      simp [intSeqSnoc, intSeqCons, allDigitCodesImpl, hs.1, ih hs.2]
    99	
   100	private theorem natDecimalCodesAux_digits (fuel n : Nat) :
   101	    allDigitCodesImpl (natDecimalCodesAux fuel n) = true := by
   102	  induction fuel generalizing n with
   103	  | zero => simp [natDecimalCodesAux, intSeqCons, intSeqNil, allDigitCodesImpl]
   104	  | succ fuel ih =>
   105	      simp only [natDecimalCodesAux]
   106	      split
   107	      · simp [intSeqCons, intSeqNil, allDigitCodesImpl]
   108	        have hnleNat : n ≤ 9 := by omega
   109	        have hnle : (n : Int) ≤ (9 : Int) := Int.ofNat_le.mpr hnleNat
   110	        constructor
   111	        · exact Int.le_add_of_nonneg_right (Int.ofNat_zero_le n)
   112	        · calc
   113	            48 + (n : Int) ≤ 48 + 9 := Int.add_le_add_left hnle 48
   114	            _ = 57 := by rfl
   115	      · have hm : n % 10 < 10 := Nat.mod_lt _ (by omega)
   116	        apply intSeqSnoc_digits _ _ (ih _)
   117	        · have hloNat : (48 : Nat) ≤ 48 + n % 10 := by omega
   118	          exact Int.ofNat_le.mpr hloNat
   119	        · have hhiNat : 48 + n % 10 ≤ (57 : Nat) := by omega
   120	          exact Int.ofNat_le.mpr hhiNat
   121	
   122	private theorem decimalCodes_nonnegative_digits (n : Int) (h : n ≥ 0) :
   123	    allDigitCodesImpl (decimalCodesImpl n) = true := by
   124	  have hn : ¬ n < 0 := by omega
   125	  simp [decimalCodesImpl, hn, natDecimalCodesAux_digits]
