+#!/usr/bin/env bash
+set -euo pipefail
+
+echo 'COMMAND: nl -ba verification.k | sed -n selected-ranges'
+nl -ba /reference/k-proof/verification.k | sed -n '1,118p'
+
+echo 'COMMAND: nl -ba int.k | sed -n 1,30p'
+nl -ba /reference/k-proof/reference-semantics/semantics/int.k | sed -n '1,30p'
+
+echo 'COMMAND: nl -ba builtins.k | sed -n 132,156p'
+nl -ba /reference/k-proof/reference-semantics/semantics/builtins.k | sed -n '132,156p'
+
+echo 'COMMAND: nl -ba str.k | sed -n 1,20p'
+nl -ba /reference/k-proof/reference-semantics/semantics/str.k | sed -n '1,20p'
+
+echo 'COMMAND: nl -ba solution.py'
+nl -ba /reference/k-proof/solution.py
+
+echo 'COMMAND: rg module/import/claim in spec.k and validation.k'
+rg -n '^(module|endmodule|[[:space:]]*imports|[[:space:]]*claim)' /reference/k-proof/spec.k /reference/k-proof/validation.k
diff --git a//tmp/audit-work/final_structural_checks.py b//tmp/audit-work/final_structural_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..7307cd98236e1dc46b79ed83603acada36f7a862
--- /dev/null
+++ b//tmp/audit-work/final_structural_checks.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+import re
+from pathlib import Path
+
+
+def load(path: str):
+    return json.loads(Path(path).read_text())
+
+
+def sha256(path: str) -> str:
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+generator = load("/reference/klean-generation/generator-manifest.json")
+obligation_map = load("/reference/klean-generation/generated/obligation-map.json")
+discovery = load("/reference/lemma-discovery.json")
+audit_input = load("/audit-input.json")
+proof_path = Path("/candidate/Proof.lean")
+proof = proof_path.read_text()
+
+domain_ids = [
+    rule["source_rule_id"]
+    for rule in discovery["rules"]
+    if rule["classification"] == "DOMAIN_LEMMA"
+]
+source_ids = [rule["source_rule_id"] for rule in obligation_map["source_rules"]]
+obligation_ids = [item["source_rule_id"] for item in obligation_map["obligations"]]
+
+target = generator["target"]
+final_match = re.search(r"(?ms)^theorem\s+final\s*:\s*(.*?)\s*:=\s*by", proof)
+if final_match is None:
+    raise SystemExit("Proof.final statement not found")
+normalize = lambda value: " ".join(value.split())
+candidate_statement = normalize(final_match.group(1))
+expected_statement = normalize(target["statement"])
+
+forbidden = {
+    token: [match.start() for match in re.finditer(rf"\b{token}\b", proof)]
+    for token in ("sorry", "admit", "unsafe", "axiom", "opaque")
+}
+parameter_bindings = []
+for parameter in target["parameters"]:
+    name = parameter["name"]
+    parameter_bindings.append(
+        {
+            "name": name,
+            "kore_symbol": parameter["kore_symbol"],
+            "source_rule_ids": parameter["source_rule_ids"],
+            "public_def_present_once": len(
+                re.findall(rf"(?m)^def\s+{re.escape(name)}(?=\s|:)", proof)
+            )
+            == 1,
+        }
+    )
+
+result = {
+    "commands": [
+        "sha256sum candidate/Proof.lean and generated/obligation-map.json",
+        "compare generator target to audit-input target and stage4_preflight target",
+        "compare ordered Stage3 DOMAIN_LEMMA, Stage4 source_rules, and Stage4 obligations IDs",
+        "extract Proof.final statement and compare with fixed target statement",
+        "scan candidate Proof.lean for sorry/admit/unsafe/axiom/opaque and target shadowing",
+        "check every target parameter has exactly one public candidate def",
+    ],
+    "hashes": {
+        "candidate_Proof_lean_sha256": sha256(str(proof_path)),
+        "obligation_map_sha256_actual": sha256(
+            "/reference/klean-generation/generated/obligation-map.json"
+        ),
+        "obligation_map_sha256_manifest": generator["obligation_map_sha256"],
+    },
+    "target": {
+        "generator_equals_audit_input": target == audit_input["resolution"]["target"],
+        "generator_equals_recorded_preflight": target
+        == audit_input["resolution"]["stage4_preflight"]["target"],
+        "declaration": target["declaration"],
+        "definition_sha256": target["definition_sha256"],
+        "statement_sha256": target["statement_sha256"],
+        "candidate_final_statement_exact": candidate_statement == expected_statement,
+        "candidate_target_shadow_declaration_count": len(
+            re.findall(
+                r"(?m)^(?:def|theorem|axiom|opaque)\s+targetStatement\b", proof
+            )
+        ),
+        "candidate_final_declaration_count": len(
+            re.findall(r"(?m)^theorem\s+final\b", proof)
+        ),
+    },
+    "bijection": {
+        "stage3_domain_ids": domain_ids,
+        "stage4_source_ids": source_ids,
+        "stage4_obligation_ids": obligation_ids,
+        "all_three_ordered_lists_equal": domain_ids == source_ids == obligation_ids,
+        "unique": len(domain_ids) == len(set(domain_ids)),
+        "count": len(domain_ids),
+    },
+    "obligations": [
+        {
+            "source_rule_id": item["source_rule_id"],
+            "source_span": item["source_span"],
+            "lean_conjunct_sha256": item["lean_conjunct_sha256"],
+            "is_exact_True": normalize(item["lean_conjunct"]) == "True",
+            "contains_True_subterm": "True" in item["lean_conjunct"],
+            "lean_conjunct": item["lean_conjunct"],
+        }
+        for item in obligation_map["obligations"]
+    ],
+    "candidate": {
+        "forbidden_token_offsets": forbidden,
+        "all_forbidden_empty": all(not positions for positions in forbidden.values()),
+        "parameter_bindings": parameter_bindings,
+        "all_parameters_bound_once": all(
+            entry["public_def_present_once"] for entry in parameter_bindings
+        ),
+    },
+}
+
+print(json.dumps(result, indent=2, sort_keys=True))
+
+assert result["hashes"]["obligation_map_sha256_actual"] == result["hashes"]["obligation_map_sha256_manifest"]
+assert result["target"]["generator_equals_audit_input"]
+assert result["target"]["generator_equals_recorded_preflight"]
+assert result["target"]["candidate_final_statement_exact"]
+assert result["target"]["candidate_target_shadow_declaration_count"] == 0
+assert result["target"]["candidate_final_declaration_count"] == 1
+assert result["bijection"]["all_three_ordered_lists_equal"]
+assert result["bijection"]["unique"]
+assert result["candidate"]["all_forbidden_empty"]
+assert result["candidate"]["all_parameters_bound_once"]
+print("FINAL_STRUCTURAL_CHECKS: PASS")
diff --git a//tmp/audit-work/independent_checks.py b//tmp/audit-work/independent_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..0fc333c24eb405a464b71487cb65bba5981d8cc4
--- /dev/null
+++ b//tmp/audit-work/independent_checks.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import (
+    k_rule_inventory,
+    klean_export,
+    lemma_discovery_contract,
+    pipeline_contract,
+    stage6_resolution_contract,
+)
+
+
+def file_sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def regular_hashes(root: Path) -> dict[str, str]:
+    result: dict[str, str] = {}
+    for path in sorted(root.rglob("*")):
+        mode = path.lstat().st_mode
+        if path.is_symlink():
+            raise RuntimeError(f"unexpected symlink: {path}")
+        if path.is_file():
+            result[path.relative_to(root).as_posix()] = file_sha(path)
+    return result
+
+
+audit_document = json.loads(Path("/audit-input.json").read_text())
+resolution, resolved_digest = stage6_resolution_contract.verify_audit_input(
+    audit_document
+)
+source_manifest = json.loads(
+    Path("/reference/generation-tools/source-manifest.json").read_text()
+)
+generator_manifest = json.loads(
+    Path("/reference/klean-generation/generator-manifest.json").read_text()
+)
+
+producer_observed = {
+    name: file_sha(Path("/reference/generation-tools") / name)
+    for name in ("klean.py", "klean_export.py")
+}
+producer_image_from_audit_path = "sha256:" + Path(
+    resolution["generation_producer_sources"]
+).name
+
+inventory = k_rule_inventory.inventory_verification(Path("/reference/k-proof"))
+validated = lemma_discovery_contract.validate_trust_boundary(
+    Path("/reference/k-proof"), Path("/reference/lemma-discovery.json")
+)
+discovery = json.loads(Path("/reference/lemma-discovery.json").read_text())
+inventory_ids = [entry["source_rule_id"] for entry in inventory["rules"]]
+discovery_ids = [entry["source_rule_id"] for entry in discovery["rules"]]
+
+mounted_stage1_hashes = regular_hashes(Path("/reference/k-proof"))
+recorded_stage1_hashes = resolution["stage1_source_hashes"]
+
+observed_hashes = {
+    "k_workspace_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/k-proof")
+    ),
+    "k_audit_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/k-audit")
+    ),
+    "discovery_manifest_sha256": file_sha(
+        Path("/reference/lemma-discovery.json")
+    ),
+    "klean_generation_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/klean-generation")
+    ),
+    "generated_tree_sha256": klean_export.tree_digest(
+        Path("/reference/klean-generation/generated")
+    ),
+    "generation_producer_sources_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/generation-tools")
+    ),
+    "lean_workspace_sha256": pipeline_contract.sha256_tree(Path("/candidate")),
+    "stage1_export_sha256": klean_export.tree_digest(
+        Path("/reference/k-proof")
+    ),
+}
+
+recorded_hashes = resolution["hashes"]
+hash_comparisons = {
+    key: {
+        "observed": value,
+        "recorded": recorded_hashes.get(key),
+        "match": value == recorded_hashes.get(key),
+    }
+    for key, value in observed_hashes.items()
+}
+
+report = {
+    "audit_mode_environment": __import__("os").environ.get("AUDIT_MODE"),
+    "audit_mode_recorded": resolution["mode"],
+    "resolved_input_sha256": resolved_digest,
+    "producer_provenance": {
+        "observed_files": producer_observed,
+        "source_manifest_files": source_manifest["files"],
+        "generator_manifest_exporter_sha256": generator_manifest[
+            "exporter_sha256"
+        ],
+        "generator_manifest_klean_py_sha256": generator_manifest[
+            "klean_py_sha256"
+        ],
+        "source_manifest_image_id": source_manifest["generator_image_id"],
+        "generator_manifest_image_id": generator_manifest["provenance"][
+            "generator_image_id"
+        ],
+        "audit_input_image_id": producer_image_from_audit_path,
+        "all_match": (
+            producer_observed == source_manifest["files"]
+            and producer_observed["klean_export.py"]
+            == generator_manifest["exporter_sha256"]
+            and producer_observed["klean.py"]
+            == generator_manifest["klean_py_sha256"]
+            and source_manifest["generator_image_id"]
+            == generator_manifest["provenance"]["generator_image_id"]
+            == producer_image_from_audit_path
+        ),
+    },
+    "hash_comparisons": hash_comparisons,
+    "all_available_recorded_hashes_match": all(
+        item["match"] for item in hash_comparisons.values()
+    ),
+    "stage1_source_hashes": {
+        "mounted_count": len(mounted_stage1_hashes),
+        "recorded_count": len(recorded_stage1_hashes),
+        "missing_from_mount": sorted(
+            set(recorded_stage1_hashes) - set(mounted_stage1_hashes)
+        ),
+        "extra_in_mount": sorted(
+            set(mounted_stage1_hashes) - set(recorded_stage1_hashes)
+        ),
+        "mismatches": {
+            name: {
+                "observed": mounted_stage1_hashes[name],
+                "recorded": recorded_stage1_hashes[name],
+            }
+            for name in sorted(
+                set(mounted_stage1_hashes) & set(recorded_stage1_hashes)
+            )
+            if mounted_stage1_hashes[name] != recorded_stage1_hashes[name]
+        },
+    },
+    "inventory": inventory,
+    "inventory_contract": {
+        "validated_inventory_sha256": validated["inventory_sha256"],
+        "rule_count": len(inventory_ids),
+        "manifest_rule_count": len(discovery_ids),
+        "ordered_identities_equal": inventory_ids == discovery_ids,
+        "inventory_ids_unique": len(inventory_ids) == len(set(inventory_ids)),
+        "manifest_ids_unique": len(discovery_ids) == len(set(discovery_ids)),
+        "definitions": len(validated["definitions"]),
+        "operational_rules": len(validated["operational_rules"]),
+        "proved_derived_lemmas": len(validated["proved_derived_lemmas"]),
+        "domain_lemmas": len(validated["domain_lemmas"]),
+    },
+}
+print(json.dumps(report, indent=2, sort_keys=True))
diff --git a//tmp/audit-work/proc_exe_shim.c b//tmp/audit-work/proc_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..6b1df8cd102f2ef0ba3a71ea415e2edc02e9986a
--- /dev/null
+++ b//tmp/audit-work/proc_exe_shim.c
@@ -0,0 +1,22 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_numeric_proc_exe(const char *path) {
+  const char *cursor = path;
+  if (strncmp(cursor, "/proc/", 6) != 0) return 0;
+  cursor += 6;
+  if (*cursor < '0' || *cursor > '9') return 0;
+  while (*cursor >= '0' && *cursor <= '9') cursor++;
+  return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (!real_readlink) real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  if (is_numeric_proc_exe(path)) path = "/proc/self/exe";
+  return real_readlink(path, buffer, size);
+}
