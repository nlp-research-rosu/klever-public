   226	private def natBinaryCodesAux : Nat → Nat → SortIntSeq
   227	  | 0, _ => intSeqCons 48 intSeqNil
   228	  | _ + 1, n =>
   229	      if n < 2 then intSeqCons (Int.ofNat (48 + n)) intSeqNil
   230	      else
