     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Translate the preserved source and the concrete assertion harness.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
     7	
     8	# Concrete and independent executable checks.
     9	python3 concrete-tests.py
    10	python3 differential_test.py
    11	
    12	# Concrete execution uses the supplied semantics without proof extensions.
    13	kompile --backend llvm reference-semantics/semantics.k \
    14	  --main-module MPY-KRUN \
    15	  --syntax-module MPY-SYNTAX \
    16	  --output-definition runtime-kompiled
    17	krun concrete-tests.mpy --definition runtime-kompiled \
    18	  2> concrete-krun.err | tee concrete-krun.out
    19	
    20	# Symbolic proof definition: import the supplied MPY semantics read-only.
    21	kompile --backend haskell verification.k \
    22	  --main-module VERIFICATION \
    23	  --syntax-module MPY-SYNTAX \
    24	  --output-definition verification-kompiled
    25	
    26	# Together these two positive commands prove all seven claims in spec.k.
    27	kprove spec.k \
    28	  --definition verification-kompiled \
    29	  --spec-module SPEC \
    30	  --claims SPEC.digit-loop,SPEC.outer-loop-empty,SPEC.outer-loop-step,SPEC.call-setup-nonempty,SPEC.outer-loop-initial,SPEC.count-nums-nonempty \
    31	  2>&1 | tee kprove-entry-nonempty.log
    32	kprove spec.k \
    33	  --definition verification-kompiled \
    34	  --spec-module SPEC \
    35	  --claims SPEC.count-nums-empty \
    36	  2>&1 | tee kprove-entry-empty.log
    37	
    38	# Gate A validation definition and expected-failure probes.
    39	kompile --backend haskell validation.k \
    40	  --main-module VALIDATION \
    41	  --syntax-module MPY-SYNTAX \
    42	  --output-definition validation-kompiled
    43	
    44	set +e
    45	kprove spec-vacuity.k \
    46	  --definition validation-kompiled \
    47	  --spec-module SPEC-VACUITY \
    48	  2>&1 | tee kprove-vacuity.log
    49	vacuity_status=${PIPESTATUS[0]}
    50	set -e
    51	echo "EXPECTED_NONZERO_STATUS=$vacuity_status"
    52	if (( vacuity_status == 0 )); then
    53	  echo "The false-postcondition probe unexpectedly proved." >&2
    54	  exit 1
    55	fi
    56	
    57	set +e
    58	kprove spec-body-mutation.k \
    59	  --definition validation-kompiled \
    60	  --spec-module SPEC-BODY-MUTATION \
    61	  2>&1 | tee kprove-body-mutation.log
    62	mutation_status=${PIPESTATUS[0]}
    63	set -e
    64	echo "EXPECTED_NONZERO_STATUS=$mutation_status"
    65	if (( mutation_status == 0 )); then
    66	  echo "The body-mutation probe unexpectedly proved." >&2
    67	  exit 1
    68	fi

COMMAND: nl -ba /candidate/Proof.lean
     1	import Klean108CountNums.Lemmas
     2	import Init.Omega
     3	
     4	namespace Proof
     5	
     6	private def allDigitCodesImpl : SortIntSeq → SortBool
     7	  | .«.IntSeq_MPY-CORE_IntSeq» => true
     8	  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» c rest =>
     9	      (decide (48 ≤ c) && decide (c ≤ 57)) && allDigitCodesImpl rest
    10	
    11	private def intSeqSnoc : SortIntSeq → SortInt → SortIntSeq
    12	  | .«.IntSeq_MPY-CORE_IntSeq», c =>
    13	      .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» c
    14	        .«.IntSeq_MPY-CORE_IntSeq»
    15	  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail, c =>
    16	      .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head (intSeqSnoc tail c)
    17	
    18	private theorem allDigitCodesImpl_intSeqSnoc
    19	    (codes : SortIntSeq) (c : SortInt) :
    20	    allDigitCodesImpl (intSeqSnoc codes c) =
    21	      (allDigitCodesImpl codes && (decide (48 ≤ c) && decide (c ≤ 57))) := by
    22	  induction codes with
    23	  | «.IntSeq_MPY-CORE_IntSeq» =>
    24	      simp [intSeqSnoc, allDigitCodesImpl]
    25	  | «iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail ih =>
    26	      simp [intSeqSnoc, allDigitCodesImpl, ih, Bool.and_assoc]
    27	
    28	private theorem singletonDigitValid (n : Nat) (h : n < 10) :
    29	    allDigitCodesImpl
    30	      (.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» (48 + (n : Int))
    31	        .«.IntSeq_MPY-CORE_IntSeq») = true := by
    32	  have hlo : (48 : Int) ≤ 48 + (n : Int) := by
    33	    have hn := Int.natCast_nonneg n
    34	    simpa using Int.add_le_add_left hn 48
    35	  have hn : (n : Int) < (10 : Nat) := Int.ofNat_lt.mpr h
    36	  have hs : 48 + (n : Int) < 48 + (10 : Nat) :=
    37	    Int.add_lt_add_left hn 48
    38	  have hhi : 48 + (n : Int) ≤ (57 : Int) := by
    39	    have : 48 + (n : Int) ≤ (48 + (10 : Nat)) - 1 :=
    40	      Int.le_sub_one_iff.mpr hs
    41	    simpa using this
    42	  simp [allDigitCodesImpl, hlo, hhi]
    43	
    44	/- Standard base-10 conversion. Each recursive step converts the quotient
    45	   first and appends ASCII '0' plus the remainder; the initial fuel `n`
    46	   exceeds the number of decimal divisions needed for `n`. -/
    47	private def natDecimalCodesAux : Nat → Nat → SortIntSeq
    48	  | 0, n =>
    49	      .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
    50	        (48 + ((n % 10) : Int))
    51	        .«.IntSeq_MPY-CORE_IntSeq»
    52	  | fuel + 1, n =>
    53	      if n < 10 then
    54	        .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» (48 + (n : Int))
    55	          .«.IntSeq_MPY-CORE_IntSeq»
    56	      else
    57	        intSeqSnoc (natDecimalCodesAux fuel (n / 10))
    58	          (48 + ((n % 10) : Int))
    59	
    60	private theorem natDecimalCodesAuxValid (fuel n : Nat) :
    61	    allDigitCodesImpl (natDecimalCodesAux fuel n) = true := by
    62	  induction fuel generalizing n with
    63	  | zero =>
    64	      exact singletonDigitValid (n % 10)
    65	        (Nat.mod_lt n (by decide))
    66	  | succ fuel ih =>
    67	      by_cases h : n < 10
    68	      · simpa [natDecimalCodesAux, h] using singletonDigitValid n h
    69	      · rw [natDecimalCodesAux]
    70	        simp only [h, ↓reduceIte]
    71	        rw [allDigitCodesImpl_intSeqSnoc]
    72	        have htail := ih (n / 10)
    73	        have hlast := singletonDigitValid (n % 10)
    74	          (Nat.mod_lt n (by decide))
    75	        simp [htail]
    76	        simpa [allDigitCodesImpl] using hlast
    77	
    78	private def decimalCodesImpl : SortInt → SortIntSeq
    79	  | .ofNat n => natDecimalCodesAux n n
    80	  | .negSucc n =>
    81	      .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 45
    82	        (natDecimalCodesAux (n + 1) (n + 1))
    83	
    84	private theorem decimalCodesImplNonnegative (n : SortInt) (h : n ≥ 0) :
    85	    allDigitCodesImpl (decimalCodesImpl n) = true := by
    86	  cases n with
    87	  | ofNat n => exact natDecimalCodesAuxValid n n
    88	  | negSucc n =>
    89	      have hn : Int.negSucc n < 0 := Int.negSucc_lt_zero n
    90	      exact False.elim ((Int.not_lt_of_ge h) hn)
    91	
    92	private def isIntImpl : SortK → SortBool
    93	  | .kseq (.inj_SortInt _) .dotk => true
    94	  | _ => false
    95	
    96	private def definedProjectIntImpl : SortVal → SortBool
    97	  | .inj_SortInt _ => true
    98	  | _ => false
