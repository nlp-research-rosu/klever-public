+    },
+    "«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»": {
+        "candidate_lines": "111-118,150-151",
+        "frozen_semantics": [
+            "reference-semantics/semantics/int.k:22-27",
+            "verification.k:41-44",
+        ],
+        "assessment": (
+            "All six frozen integer comparison dispatches are implemented on "
+            "integer constructors; the cited '<' rule is guarded by isInt. "
+            "Signed true and false cases reject a constant comparator. "
+            "Non-integer dispatch is outside the cited guarded rule."
+        ),
+    },
+    "«applyUn(_,_)_MPY-CORE_Val_String_Val»": {
+        "candidate_lines": "120-122,153-154",
+        "frozen_semantics": [
+            "reference-semantics/semantics/int.k:7",
