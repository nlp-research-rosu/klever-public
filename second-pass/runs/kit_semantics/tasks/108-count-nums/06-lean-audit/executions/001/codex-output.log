+#!/usr/bin/env python3
+"""Record the independent per-parameter operational bridge comparison."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+
+manifest = json.loads(
+    Path("/reference/klean-generation/generator-manifest.json").read_text()
+)
+
+judgments = {
