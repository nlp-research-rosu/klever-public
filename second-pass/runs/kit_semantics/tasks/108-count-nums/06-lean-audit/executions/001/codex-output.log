import Klean108CountNums.Lemmas
import Init.Omega

namespace Proof

private def allDigitCodesImpl : SortIntSeq → SortBool
  | .«.IntSeq_MPY-CORE_IntSeq» => true
  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» c rest =>
      (decide (48 ≤ c) && decide (c ≤ 57)) && allDigitCodesImpl rest

private def intSeqSnoc : SortIntSeq → SortInt → SortIntSeq
  | .«.IntSeq_MPY-CORE_IntSeq», c =>
      .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» c
        .«.IntSeq_MPY-CORE_IntSeq»
  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail, c =>
      .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head (intSeqSnoc tail c)

private theorem allDigitCodesImpl_intSeqSnoc
    (codes : SortIntSeq) (c : SortInt) :
    allDigitCodesImpl (intSeqSnoc codes c) =
      (allDigitCodesImpl codes && (decide (48 ≤ c) && decide (c ≤ 57))) := by
  induction codes with
  | «.IntSeq_MPY-CORE_IntSeq» =>
      simp [intSeqSnoc, allDigitCodesImpl]
  | «iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail ih =>
      simp [intSeqSnoc, allDigitCodesImpl, ih, Bool.and_assoc]

private theorem singletonDigitValid (n : Nat) (h : n < 10) :
    allDigitCodesImpl
      (.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» (48 + (n : Int))
        .«.IntSeq_MPY-CORE_IntSeq») = true := by
  have hlo : (48 : Int) ≤ 48 + (n : Int) := by
    have hn := Int.natCast_nonneg n
    simpa using Int.add_le_add_left hn 48
  have hn : (n : Int) < (10 : Nat) := Int.ofNat_lt.mpr h
  have hs : 48 + (n : Int) < 48 + (10 : Nat) :=
    Int.add_lt_add_left hn 48
  have hhi : 48 + (n : Int) ≤ (57 : Int) := by
    have : 48 + (n : Int) ≤ (48 + (10 : Nat)) - 1 :=
      Int.le_sub_one_iff.mpr hs
    simpa using this
  simp [allDigitCodesImpl, hlo, hhi]

/- Standard base-10 conversion. Each recursive step converts the quotient
   first and appends ASCII '0' plus the remainder; the initial fuel `n`
   exceeds the number of decimal divisions needed for `n`. -/
private def natDecimalCodesAux : Nat → Nat → SortIntSeq
  | 0, n =>
      .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
        (48 + ((n % 10) : Int))
        .«.IntSeq_MPY-CORE_IntSeq»
  | fuel + 1, n =>
      if n < 10 then
        .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» (48 + (n : Int))
          .«.IntSeq_MPY-CORE_IntSeq»
      else
        intSeqSnoc (natDecimalCodesAux fuel (n / 10))
          (48 + ((n % 10) : Int))

private theorem natDecimalCodesAuxValid (fuel n : Nat) :
    allDigitCodesImpl (natDecimalCodesAux fuel n) = true := by
  induction fuel generalizing n with
  | zero =>
      exact singletonDigitValid (n % 10)
        (Nat.mod_lt n (by decide))
  | succ fuel ih =>
      by_cases h : n < 10
      · simpa [natDecimalCodesAux, h] using singletonDigitValid n h
      · rw [natDecimalCodesAux]
        simp only [h, ↓reduceIte]
        rw [allDigitCodesImpl_intSeqSnoc]
        have htail := ih (n / 10)
        have hlast := singletonDigitValid (n % 10)
          (Nat.mod_lt n (by decide))
        simp [htail]
        simpa [allDigitCodesImpl] using hlast

private def decimalCodesImpl : SortInt → SortIntSeq
  | .ofNat n => natDecimalCodesAux n n
  | .negSucc n =>
      .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 45
        (natDecimalCodesAux (n + 1) (n + 1))

private theorem decimalCodesImplNonnegative (n : SortInt) (h : n ≥ 0) :
    allDigitCodesImpl (decimalCodesImpl n) = true := by
  cases n with
  | ofNat n => exact natDecimalCodesAuxValid n n
  | negSucc n =>
      have hn : Int.negSucc n < 0 := Int.negSucc_lt_zero n
      exact False.elim ((Int.not_lt_of_ge h) hn)

private def isIntImpl : SortK → SortBool
  | .kseq (.inj_SortInt _) .dotk => true
  | _ => false

private def definedProjectIntImpl : SortVal → SortBool
  | .inj_SortInt _ => true
  | _ => false

/- The K total projector is operationally used only under `isInt`.
   Its integer constructor is projected exactly; zero is the canonical total
   value outside the partial cast's defined domain. -/
private def projectIntTotalImpl : SortVal → SortInt
  | .inj_SortInt i => i
  | _ => 0

private def projectIntOptionImpl : SortK → Option SortInt
  | .kseq (.inj_SortInt i) .dotk => some i
  | _ => none

private def applyCmpImpl : SortString → SortVal → SortVal → SortBool
  | "<", .inj_SortInt i, .inj_SortInt j => decide (i < j)
  | "<=", .inj_SortInt i, .inj_SortInt j => decide (i ≤ j)
  | ">", .inj_SortInt i, .inj_SortInt j => decide (i > j)
  | ">=", .inj_SortInt i, .inj_SortInt j => decide (i ≥ j)
  | "==", .inj_SortInt i, .inj_SortInt j => decide (i = j)
  | "!=", .inj_SortInt i, .inj_SortInt j => decide (i ≠ j)
  | _, _, _ => false

private def applyUnImpl : SortString → SortVal → SortVal
  | "-", .inj_SortInt i => .inj_SortInt (0 - i)
  | _, _ => .«noneV_MPY-CORE_Val»

private def applyBuiltinImpl : SortString → SortVals → SortVal
  | "str",
      .«_,__MPY-CORE_Vals_Val_Vals» (.inj_SortInt i)
        .«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
      .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» (decimalCodesImpl i))
