+import Proof
+
+private def digits105 : SortIntSeq :=
+  .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 49
+    (.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 48
