printf '"'%s\\n' \""'$FRESH" > /audit-output/evidence/fresh-proof-workspace.txt
printf '"'FRESH_WORKSPACE: %s\\n' \""'$FRESH" > /audit-output/evidence/03-fresh-copy.log
printf '"'COMMAND: cp -a /candidate/. %s/\\n' \""'$FRESH" >> /audit-output/evidence/03-fresh-copy.log
printf '"'COMMAND: cp -a /reference/klean-generation/generated/. %s/Base/\\n' \""'$FRESH" >> /audit-output/evidence/03-fresh-copy.log
find "$FRESH" -maxdepth 3 -type f -printf '"'%P\\n' | sort >> /audit-output/evidence/03-fresh-copy.log
" in /audit-output
