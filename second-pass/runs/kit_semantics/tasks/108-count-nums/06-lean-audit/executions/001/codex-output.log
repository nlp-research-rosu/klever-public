+    },
+    "«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»": {
+        "candidate_lines": "124-133,147-148",
+        "frozen_semantics": [
+            "reference-semantics/semantics/builtins.k:147-149",
+            "verification.k:63-67",
+        ],
+        "assessment": (
+            "On the complete `str` match domain cited by the obligation it "
+            "maps a singleton Int argument to str(decimal codes) and a singleton "
