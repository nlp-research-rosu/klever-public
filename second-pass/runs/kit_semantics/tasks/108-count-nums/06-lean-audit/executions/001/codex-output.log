+        lean_box(0),
+        lean_box(0),
+        lean_box(0),
+        lean_box(0),
+        mk_empty_options(),
+        lean_box_uint32(0),
+        lean_box(0),
+        lean_box(0),
+        lean_box(0),
+        lean_box(0),
+        lean_box(0),
+        lean_box(0),
+        lean_box(0),
+        lean_mk_empty_array(),
+        lean_box(0),
+        lean_box(0),
+        lean_io_mk_world(),
+    };
+    lean_object *result =
+        l___private_Lean_Shell_0__Lean_shellMain___boxed(arguments);
+
+    fprintf(stderr, "wrapper: shell returned\n");
+    lean_finalize_task_manager();
+    if (lean_io_result_is_error(result)) {
+        lean_io_result_show_error(result);
+        lean_dec(result);
+        return 1;
+    }
+    uint32_t code = lean_unbox_uint32(lean_io_result_get_value(result));
+    lean_dec(result);
+    return (int)code;
+}
