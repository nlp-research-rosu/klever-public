+
+struct parsed {
+    const char *file;
+    const char *root;
+    const char *setup;
+    const char *olean;
+    const char *ilean;
+    const char *cfile;
+    const char *bcfile;
+    bool only_deps;
+    bool only_src_deps;
+    bool json;
+    bool stats;
+    bool run;
