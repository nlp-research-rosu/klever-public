+        lean_object *cell = lean_alloc_ctor(1, 2, 0);
+        lean_ctor_set(cell, 0, lean_mk_string(argv[i]));
+        lean_ctor_set(cell, 1, result);
+        result = cell;
+    }
+    return result;
+}
+
+static lean_object *mk_empty_options(void) {
+    lean_object *result = lean_alloc_ctor(0, 1, 0);
+    lean_ctor_set(result, 0, lean_box(0));
+    return result;
+}
+
+int main(int argc, char **argv) {
+    fprintf(stderr, "wrapper: setup\n");
+    lean_setup_args(argc, argv);
+    lean_initialize();
+    lean_set_panic_messages(false);
+    fprintf(stderr, "wrapper: initialize shell\n");
+    lean_object *initialized = initialize_Lean_Shell(1);
+    if (lean_io_result_is_error(initialized)) {
+        lean_io_result_show_error(initialized);
+        lean_dec(initialized);
+        return 1;
+    }
+    lean_dec(initialized);
+    lean_set_panic_messages(true);
