      "inventory_sha256": "86637211d8eb42b498d51f829d1bcd21ab5987f93b26ba91a4a35193e5b3824b",
      "module": "VERIFICATION",
      "normalized_sha256": "0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
      "rationale": "Adds an unproved characterization of the definedness of K's partial Val-to-Int cast; Stage 1 imports this simplification while proving its claims and never proves the exact rule in a module that omits it.",
      "source_rule_id": "rule-0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
      "start_line": 24,
      "text": "  rule #Ceil({@V:Val}:>Int)\n    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "77be13d6ea2a48897fe1570e3a22e3540f58569c942222ef4c0ef019e242355e",
      "end_line": 44,
      "inventory_sha256": "86637211d8eb42b498d51f829d1bcd21ab5987f93b26ba91a4a35193e5b3824b",
      "module": "VERIFICATION",
      "normalized_sha256": "f0bc44c15424da687bfa0aeb3e970f71a2cc9dbd9a38c4ac04629f27cea4ac69",
      "rationale": "Adds a simplification bridge from dynamically sorted integer comparison to projected Int comparison; its exact statement is not separately proved before the rule is imported.",
      "source_rule_id": "rule-f0bc44c15424da687bfa0aeb3e970f71a2cc9dbd9a38c4ac04629f27cea4ac69",
      "start_line": 41,
      "text": "  rule applyCmp(\"<\", V:Val, J:Int)\n    => projectIntTotal(V) <Int J\n    requires isInt(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "77be13d6ea2a48897fe1570e3a22e3540f58569c942222ef4c0ef019e242355e",
      "end_line": 48,
      "inventory_sha256": "86637211d8eb42b498d51f829d1bcd21ab5987f93b26ba91a4a35193e5b3824b",
      "module": "VERIFICATION",
      "normalized_sha256": "dd0c5a6695115ef6c4608553ba13c7b4e2cd91e78ce50bf59e458ba0a5eb5be2",
      "rationale": "Adds a simplification bridge from dynamically sorted unary negation to projected Int subtraction; its exact statement is not separately proved before the rule is imported.",
      "source_rule_id": "rule-dd0c5a6695115ef6c4608553ba13c7b4e2cd91e78ce50bf59e458ba0a5eb5be2",
      "start_line": 45,
      "text": "  rule applyUn(\"-\", V:Val)\n    => 0 -Int projectIntTotal(V)\n    requires isInt(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "77be13d6ea2a48897fe1570e3a22e3540f58569c942222ef4c0ef019e242355e",
      "end_line": 67,
      "inventory_sha256": "86637211d8eb42b498d51f829d1bcd21ab5987f93b26ba91a4a35193e5b3824b",
      "module": "VERIFICATION",
      "normalized_sha256": "96422d110466a9240b0e25343046e54b8fa06a0bdf0abc4c25fcd195583f54da",
      "rationale": "Adds an unproved guarded simplification for the existing str builtin on a dynamic Val and connects its observable result to decimalCodes; Stage 1 contains no prior exact connection proof without this rule.",
      "source_rule_id": "rule-96422d110466a9240b0e25343046e54b8fa06a0bdf0abc4c25fcd195583f54da",
      "start_line": 63,
      "text": "  rule applyBuiltin(\"str\", V:Val, .Vals)\n    => str(decimalCodes(projectIntTotal(V)))\n    requires isInt(V)\n     andBool projectIntTotal(V) >=Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "77be13d6ea2a48897fe1570e3a22e3540f58569c942222ef4c0ef019e242355e",
      "end_line": 78,
      "inventory_sha256": "86637211d8eb42b498d51f829d1bcd21ab5987f93b26ba91a4a35193e5b3824b",
      "module": "VERIFICATION",
      "normalized_sha256": "5af48b88759940f404acea3042b6fa69d00290648ae1c95910aaad61bea89344",
      "rationale": "Trusted additional fact asserting that every opaque decimalCodes result for a nonnegative integer consists only of digit codes; it is explicitly the Stage 1 value-level primitive contract and is not separately proved.",
      "source_rule_id": "rule-5af48b88759940f404acea3042b6fa69d00290648ae1c95910aaad61bea89344",
      "start_line": 76,
      "text": "  rule allDigitCodes(decimalCodes(N:Int)) => true\n    requires N >=Int 0\n    [simplification]"
    }
