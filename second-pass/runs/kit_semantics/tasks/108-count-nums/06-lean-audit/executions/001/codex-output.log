     1	{
     2	  "definitions": [
     3	    {
     4	      "attributes": [],
     5	      "classification": "DEFINITION",
     6	      "end_line": 10,
     7	      "module": "VERIFICATION",
     8	      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
     9	      "rationale": "Base equation defining the structural all-integer predicate on the empty value sequence.",
    10	      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
    11	      "start_line": 10,
    12	      "text": "  rule allInts(.ValSeq) => true"
    13	    },
    14	    {
    15	      "attributes": [],
    16	      "classification": "DEFINITION",
    17	      "end_line": 12,
    18	      "module": "VERIFICATION",
    19	      "normalized_sha256": "bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
    20	      "rationale": "Recursive constructor equation defining allInts by checking the head and descending through the tail.",
    21	      "source_rule_id": "rule-bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
    22	      "start_line": 11,
    23	      "text": "  rule allInts(vCons(V:Val, R:ValSeq))\n    => isInt(V) andBool allInts(R)"
    24	    },
    25	    {
    26	      "attributes": [],
    27	      "classification": "DEFINITION",
    28	      "end_line": 19,
    29	      "module": "VERIFICATION",
    30	      "normalized_sha256": "9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
    31	      "rationale": "Defines the named projection-definedness predicate to be the existing integer-sort observation isInt.",
    32	      "source_rule_id": "rule-9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
    33	      "start_line": 19,
    34	      "text": "  rule definedProjectInt(V:Val) => isInt(V)"
    35	    },
    36	    {
    37	      "attributes": [
    38	        "concrete",
    39	        "simplification(10)",
    40	        "preserves-definedness"
    41	      ],
    42	      "classification": "DEFINITION",
    43	      "end_line": 30,
    44	      "module": "VERIFICATION",
    45	      "normalized_sha256": "ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
    46	      "rationale": "Guarded defining equation for the new total projection proof term in terms of the built-in partial cast.",
    47	      "source_rule_id": "rule-ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
    48	      "start_line": 28,
    49	      "text": "  rule projectIntTotal(V:Val) => {V}:>Int\n    requires definedProjectInt(V)\n    [concrete, simplification(10), preserves-definedness]"
    50	    },
    51	    {
    52	      "attributes": [
    53	        "symbolic(V)",
    54	        "simplification",
    55	        "preserves-definedness"
    56	      ],
    57	      "classification": "DEFINITION",
    58	      "end_line": 33,
    59	      "module": "VERIFICATION",
    60	      "normalized_sha256": "22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
    61	      "rationale": "Symbolic macro orientation of the same guarded definition, replacing a defined partial cast by its named total-projection proof term.",
    62	      "source_rule_id": "rule-22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
    63	      "start_line": 31,
    64	      "text": "  rule {V:Val}:>Int => projectIntTotal(V)\n    requires definedProjectInt(V)\n    [symbolic(V), simplification, preserves-definedness]"
    65	    },
    66	    {
    67	      "attributes": [
    68	        "simplification"
    69	      ],
    70	      "classification": "DEFINITION",
    71	      "end_line": 34,
    72	      "module": "VERIFICATION",
    73	      "normalized_sha256": "7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
    74	      "rationale": "Collapse equation defining total projection on an argument already statically sorted as Int.",
    75	      "source_rule_id": "rule-7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
    76	      "start_line": 34,
    77	      "text": "  rule projectIntTotal(I:Int) => I [simplification]"
    78	    },
    79	    {
    80	      "attributes": [
    81	        "simplification"
    82	      ],
    83	      "classification": "DEFINITION",
    84	      "end_line": 37,
    85	      "module": "VERIFICATION",
    86	      "normalized_sha256": "9e1486b6d25b62bd0949213fd58d7aac97ed89cc3e87b8c5063f915d1d6b7081",
    87	      "rationale": "Normalization equation for nested occurrences of the named total-projection proof term.",
    88	      "source_rule_id": "rule-9e1486b6d25b62bd0949213fd58d7aac97ed89cc3e87b8c5063f915d1d6b7081",
    89	      "start_line": 35,
    90	      "text": "  rule projectIntTotal(projectIntTotal(V:Val))\n    => projectIntTotal(V)\n    [simplification]"
    91	    },
    92	    {
    93	      "attributes": [],
    94	      "classification": "DEFINITION",
    95	      "end_line": 51,
    96	      "module": "VERIFICATION",
    97	      "normalized_sha256": "cd27978567771d575588139b24cd026dda1f8d3b5bd9dc20f111ee477bce6c6f",
    98	      "rationale": "Negative branch of the guarded equation defining integer magnitude.",
    99	      "source_rule_id": "rule-cd27978567771d575588139b24cd026dda1f8d3b5bd9dc20f111ee477bce6c6f",
   100	      "start_line": 51,
   101	      "text": "  rule magnitude(I:Int) => 0 -Int I requires I <Int 0"
   102	    },
   103	    {
   104	      "attributes": [],
   105	      "classification": "DEFINITION",
   106	      "end_line": 52,
   107	      "module": "VERIFICATION",
   108	      "normalized_sha256": "4e3e19345a89d5245f12afed38debbaa37bc0ea3a68547465b9f4bdcbdbd6e31",
   109	      "rationale": "Nonnegative branch of the guarded equation defining integer magnitude.",
   110	      "source_rule_id": "rule-4e3e19345a89d5245f12afed38debbaa37bc0ea3a68547465b9f4bdcbdbd6e31",
   111	      "start_line": 52,
   112	      "text": "  rule magnitude(I:Int) => I        requires I >=Int 0"
   113	    },
   114	    {
   115	      "attributes": [
   116	        "simplification"
   117	      ],
   118	      "classification": "DEFINITION",
   119	      "end_line": 61,
   120	      "module": "VERIFICATION",
   121	      "normalized_sha256": "3032a0a4c60ed2250faa69944052df311935b7bba4b927b500bd6fb7bd37352e",
   122	      "rationale": "Definitional naming equation that represents the supplied nonnegative Int2String/strToCodes result by the opaque proof term decimalCodes.",
   123	      "source_rule_id": "rule-3032a0a4c60ed2250faa69944052df311935b7bba4b927b500bd6fb7bd37352e",
   124	      "start_line": 59,
   125	      "text": "  rule strToCodes(Int2String(N:Int)) => decimalCodes(N)\n    requires N >=Int 0\n    [simplification]"
   126	    },
   127	    {
   128	      "attributes": [],
   129	      "classification": "DEFINITION",
   130	      "end_line": 70,
   131	      "module": "VERIFICATION",
   132	      "normalized_sha256": "2416ca8bb671955f95078b5302ff134b3fced29f9d3f1e56bc01b51a3e7d8dbf",
   133	      "rationale": "Base equation defining the allDigitCodes structural predicate on the empty code sequence.",
   134	      "source_rule_id": "rule-2416ca8bb671955f95078b5302ff134b3fced29f9d3f1e56bc01b51a3e7d8dbf",
   135	      "start_line": 70,
   136	      "text": "  rule allDigitCodes(.IntSeq) => true"
   137	    },
   138	    {
   139	      "attributes": [],
   140	      "classification": "DEFINITION",
   141	      "end_line": 72,
   142	      "module": "VERIFICATION",
   143	      "normalized_sha256": "29f1f8943e5f1334e382c33eb25577534dc610689ff0a931e35fb251701efdca",
