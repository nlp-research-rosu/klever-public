+    lean_object *, uint8_t, uint8_t, uint8_t, uint8_t, lean_object *,
+    uint32_t, lean_object *, lean_object *, lean_object *, lean_object *,
+    lean_object *, lean_object *, uint8_t, lean_object *, uint8_t, uint8_t,
+    lean_object *);
