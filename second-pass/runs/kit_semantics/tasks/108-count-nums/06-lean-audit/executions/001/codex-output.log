for p in ['/reference/klean-generation/generator-manifest.json','/reference/klean-generation/input-manifest.json','/reference/klean-generation/export-result.json','/reference/klean-generation/trust-inventory.json','/reference/lemma-discovery.json','/reference/klean-toolchain.lock.json']:
    d=json.load(open(p))
    print('\\n###',p)
    if p.endswith('generator-manifest.json'):
        for k in d:
            if k not in ('obligations','target'):
                print(k,':',d[k])
        print('target:',d.get('target'))
        print('obligations count:',len(d.get('obligations',[])))
    elif p.endswith('input-manifest.json'):
        for k in d:
            if k not in ('source_rules','obligations'):
                print(k,':',d[k])
        print('source_rules count:',len(d.get('source_rules',[])))
        print('obligations count:',len(d.get('obligations',[])))
    elif p.endswith('lemma-discovery.json'):
        for k in d:
            if k not in ('rules','inventory'):
                print(k,':',d[k])
        rules=d.get('rules',d.get('inventory',[]))
        print('rules count:',len(rules))
    else:
        print(json.dumps(d,indent=2)[:12000])
