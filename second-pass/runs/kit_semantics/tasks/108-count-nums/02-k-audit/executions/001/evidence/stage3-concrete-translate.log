COMMAND: python3 /reference/py2mpy.py /audit-output/evidence/audit_concrete.py
WORKDIR: /audit-output
Module(
  FuncDef("count_nums", Params("arr"),
    Assign(Name("count"), Int(0))
    For(Name("num"), Name("arr"),
      If(Compare(Name("num"), CmpOp("<", Int(0))),
        Assign(Name("n"), UnaryOp("-", Name("num"))),
        Assign(Name("n"), Name("num")))
      Assign(Name("digit_sum"), Int(0))
      Assign(Name("first_digit"), Int(0))
      Assign(Name("char"), Str("0"))
      Assign(Name("digit"), Int(0))
      For(Name("char"), Call(Name("str"), Name("n")),
        Assign(Name("digit"), Call(Name("int"), Name("char")))
        If(Compare(Name("first_digit"), CmpOp("==", Int(0))),
          Assign(Name("first_digit"), Name("digit")),
          )
        AugAssign(Name("digit_sum"), "+", Name("digit")))
      If(Compare(Name("num"), CmpOp("<", Int(0))),
        AugAssign(
          Name("digit_sum"),
          "-",
          BinOp("*", Int(2), Name("first_digit"))),
        )
      If(Compare(Name("digit_sum"), CmpOp(">", Int(0))),
        AugAssign(Name("count"), "+", Int(1)),
        ))
    Return(Name("count")))
  Assert(
    Compare(Call(Name("count_nums"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("count_nums"),
        ListExpr(UnaryOp("-", Int(1)), Int(11), UnaryOp("-", Int(11)))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("count_nums"), ListExpr(Int(1), Int(1), Int(2))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("count_nums"),
        ListExpr(
          Int(0),
          UnaryOp("-", Int(11)),
          UnaryOp("-", Int(12)),
          UnaryOp("-", Int(99)),
          UnaryOp("-", Int(109)),
          Int(10),
          Int(101))),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(
        Name("count_nums"),
        ListExpr(
          UnaryOp("-", Int(100)),
          UnaryOp("-", Int(101)),
          UnaryOp("-", Int(102)),
          UnaryOp("-", Int(999)),
          Int(999))),
      CmpOp("==", Int(3)))))
EXIT_STATUS: 0
