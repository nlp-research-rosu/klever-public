/audit-output/evidence/run_logged.sh /audit-output/evidence/stage5-inventory-generation.log python3 /audit-output/evidence/k_inventory.py /tmp/audit-work/108-count-nums-audit/reference-semantics /tmp/audit-work/108-count-nums-audit/verification.k /audit-output/evidence/k-rule-inventory.md
wc -l -c /audit-output/evidence/k-rule-inventory.md
