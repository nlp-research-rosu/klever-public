+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+} >"$log"
+
+"$@" > >(tee -a "$log") 2> >(tee -a "$log" >&2)
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$log"
+exit "$status"

codex
The fresh off-by-one postcondition mutation failed exactly at the implication `count + 1 = count`, with a satisfiable symbolic state—valid non-vacuity evidence. I also changed the initializer inside the closure term actually executed by the nonempty entry claim (not merely `solution.py`); that mutated claim compiled and is now running as a separate body-sensitivity check.
diff --git a/evidence/audit_concrete.py b/evidence/audit_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..4cb0fb5f2098fd2a12ff0421bd682665f632051d
--- /dev/null
+++ b/evidence/audit_concrete.py
@@ -0,0 +1,32 @@
+def count_nums(arr):
+    count = 0
+    for num in arr:
+        if num < 0:
+            n = -num
+        else:
+            n = num
+
+        digit_sum = 0
+        first_digit = 0
+        char = "0"
+        digit = 0
+        for char in str(n):
+            digit = int(char)
+            if first_digit == 0:
+                first_digit = digit
+            digit_sum += digit
+
+        if num < 0:
+            digit_sum -= 2 * first_digit
+
+        if digit_sum > 0:
+            count += 1
+
+    return count
+
+
+assert count_nums([]) == 0
+assert count_nums([-1, 11, -11]) == 1
+assert count_nums([1, 1, 2]) == 3
+assert count_nums([0, -11, -12, -99, -109, 10, 101]) == 4
+assert count_nums([-100, -101, -102, -999, 999]) == 3
