def _without_comments(text: str) -> str:
    """Remove K comments while preserving strings and their exact contents."""

    output: list[str] = []
    index = 0
    block_depth = 0
    state = "code"
    while index < len(text):
        character = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if state == "line-comment":
            if character in "\r\n":
                output.append(character)
                state = "code"
            index += 1
            continue
        if state == "string":
            output.append(character)
            if character == "\\" and following:
                output.append(following)
                index += 2
                continue
            if character == '"':
                state = "code"
            index += 1
            continue
        if state == "block-comment":
            if character == "/" and following == "*":
                block_depth += 1
                index += 2
                continue
            if character == "*" and following == "/":
                block_depth -= 1
                index += 2
                if block_depth == 0:
                    state = "code"
                continue
            if character in "\r\n":
                output.append(character)
            index += 1
            continue
        if character == "/" and following == "/":
            output.append(" ")
            state = "line-comment"
            index += 2
            continue
        if character == "/" and following == "*":
            output.append(" ")
            state = "block-comment"
            block_depth = 1
            index += 2
            continue
        output.append(character)
        if character == '"':
            state = "string"
        index += 1
    return "".join(output)


def _attribute_tokens(text: str, masked_text: str) -> list[str]:
    tokens: list[str] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            token = _without_comments(text[start:index]).strip()
            if token:
                tokens.append(token)
            start = index + 1
    final = _without_comments(text[start:]).strip()
    if final:
        tokens.append(final)
    return tokens


def _rule_spans(text: str, module: _Module) -> list[_RuleSpan]:
    masked_text = _mask_non_code(text)
    sentences = module.sentences
    rules: list[_RuleSpan] = []
    seen_hashes: set[str] = set()
    for index, sentence in enumerate(sentences):
        if sentence.keyword != "rule":
            continue
        end_offset = (
            sentences[index + 1].start
            if index + 1 < len(sentences)
            else module.content_end
        )
        start_offset = sentence.start
        raw_segment = text[start_offset:end_offset]
        masked_segment = masked_text[start_offset:end_offset]
        logical_length = len(masked_segment.rstrip(" \t\r\n"))
        if logical_length == 0:
            continue
        rule_text = raw_segment[:logical_length].rstrip(" \t\r\n")
        masked_rule = _mask_non_code(rule_text)
        attribute_match = _TRAILING_ATTRIBUTES_RE.search(masked_rule)
        if attribute_match is None:
            continue
        attribute_start = attribute_match.start("attributes")
        attribute_end = attribute_match.end("attributes")
        attributes = _attribute_tokens(
            rule_text[attribute_start:attribute_end],
            masked_rule[attribute_start:attribute_end],
        )
        if "simplification" not in attributes:
            continue
        normalized = " ".join(rule_text.split())
        digest = hashlib.sha256(normalized.encode()).hexdigest()
        if digest in seen_hashes:
            raise KRuleInventoryError(
                f"duplicate normalized simplification rule hash: {digest}"
            )
        seen_hashes.add(digest)
        start_line = text.count("\n", 0, start_offset) + 1
        end_line = start_line + rule_text.count("\n")
        rule = KRule(
            source_rule_id=f"rule-{digest}",
            start_line=start_line,
            end_line=end_line,
            normalized_sha256=digest,
            attributes=attributes,
            text=rule_text,
        )
        rules.append(
            _RuleSpan(
                rule=rule,
                start_offset=start_offset,
                end_offset=start_offset + len(rule_text),
                attribute_start=start_offset + attribute_match.start(),
                attribute_end=start_offset + attribute_match.end(),
            )
        )
    return rules


def _rule_documents(text: str, module: _Module) -> list[dict[str, Any]]:
    return [
        dataclasses.asdict(span.rule)
        for span in _rule_spans(text, module)
    ]


def _attribute_token_spans(
    text: str,
    masked_text: str,
) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            spans.append(
                (
                    start,
                    index,
                    _without_comments(text[start:index]).strip(),
                )
            )
            start = index + 1
    spans.append(
        (
            start,
            len(text),
            _without_comments(text[start:]).strip(),
        )
    )
    return spans


def _blank_non_newlines(text: str) -> str:
    return "".join(
        character if character in "\r\n" else " "
        for character in text
    )


def desimplify_rule_ids(
    text: str,
    source_rule_ids: list[str],
) -> str:
    """Remove simplification from exactly the selected canonical rule IDs."""

    if len(source_rule_ids) != len(set(source_rule_ids)):
        raise KRuleInventoryError(
            "exact rule transformation contains a duplicate source rule ID"
        )
    selected = set(source_rule_ids)
    module = _verification_module(_mask_non_code(text))
    spans = _rule_spans(text, module)
    by_id = {span.rule.source_rule_id: span for span in spans}
    unknown = sorted(selected - set(by_id))
    if unknown:
        raise KRuleInventoryError(
            "exact rule transformation names an unknown source rule ID: "
            + ", ".join(unknown)
        )

    edits: list[tuple[int, int]] = []
    for source_rule_id in source_rule_ids:
        span = by_id[source_rule_id]
        attribute_text = text[
            span.attribute_start + 1 : span.attribute_end - 1
        ]
        masked_attributes = _mask_non_code(attribute_text)
        tokens = _attribute_token_spans(
            attribute_text,
            masked_attributes,
        )
        matches = [
            index
            for index, (_start, _end, token) in enumerate(tokens)
            if token == "simplification"
        ]
        if len(matches) != 1:
            raise KRuleInventoryError(
                "selected source rule has ambiguous simplification "
                f"attributes: {source_rule_id}"
            )
        token_index = matches[0]
        if len(tokens) == 1:
            edit_start = span.attribute_start
            edit_end = span.attribute_end
        elif token_index < len(tokens) - 1:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index][0]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index + 1][0]
            )
        else:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index - 1][1]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index][1]
            )
        edits.append((edit_start, edit_end))

    transformed = text
    for start, end in sorted(edits, reverse=True):
        transformed = (
            transformed[:start]
            + _blank_non_newlines(transformed[start:end])
            + transformed[end:]
        )
    return transformed


def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    module = _verification_module(masked_text)
    rule_documents = _rule_documents(text, module)
    return {
        "schema_version": 1,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }

diff --git a/evidence/audit_concrete.py b/evidence/audit_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..4cb0fb5f2098fd2a12ff0421bd682665f632051d
--- /dev/null
+++ b/evidence/audit_concrete.py
@@ -0,0 +1,32 @@
+def count_nums(arr):
+    count = 0
+    for num in arr:
+        if num < 0:
+            n = -num
+        else:
+            n = num
+
+        digit_sum = 0
+        first_digit = 0
+        char = "0"
+        digit = 0
+        for char in str(n):
+            digit = int(char)
+            if first_digit == 0:
+                first_digit = digit
+            digit_sum += digit
+
+        if num < 0:
+            digit_sum -= 2 * first_digit
+
+        if digit_sum > 0:
+            count += 1
+
+    return count
+
+
+assert count_nums([]) == 0
+assert count_nums([-1, 11, -11]) == 1
+assert count_nums([1, 1, 2]) == 3
+assert count_nums([0, -11, -12, -99, -109, 10, 101]) == 4
+assert count_nums([-100, -101, -102, -999, 999]) == 3
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..4bd8388bedf569add1d3dbfe3bfe097ee1c5f060
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Independent deterministic differential test for HumanEval 108."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import itertools
+import json
+import random
+import sys
+from pathlib import Path
+
+
+sys.dont_write_bytecode = True
+
+
+def load_function(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.count_nums
+
+
+def signed_digit_sum_math(number: int) -> int:
+    magnitude_digits = [ord(ch) - ord("0") for ch in str(abs(number))]
+    total = sum(magnitude_digits)
+    if number < 0:
+        total -= 2 * magnitude_digits[0]
+    return total
+
+
+def independent_oracle(values: list[int]) -> int:
+    return sum(signed_digit_sum_math(value) > 0 for value in values)
+
+
+def main() -> int:
+    if len(sys.argv) != 4:
+        print(
+            "usage: differential_test.py CANONICAL.py SOLUTION.py INPUT-MANIFEST.json",
+            file=sys.stderr,
+        )
+        return 2
+
+    canonical_path = Path(sys.argv[1])
+    solution_path = Path(sys.argv[2])
+    manifest_path = Path(sys.argv[3])
+    canonical = load_function("trusted_canonical_108", canonical_path)
+    generated = load_function("generated_solution_108", solution_path)
+
+    documented = [
+        [],
+        [-1, 11, -11],
+        [1, 1, 2],
+    ]
+    curated = [
+        [0],
+        [1],
+        [-1],
+        [9, 10, 11, 99, 100, 101, 109],
+        [-9, -10, -11, -12, -19, -20, -90, -99, -100, -101, -102, -109],
+        [10**99, -(10**99), 10**99 - 1, -(10**99 - 1)],
+        [-(2**4096), 2**4096, -(2**4096 - 1), 2**4096 - 1],
+        [-999999999999999999, -100000000000000001, 0, 100000000000000001],
+    ]
+    pool = [
+        -999,
+        -109,
+        -102,
+        -101,
+        -100,
+        -99,
+        -20,
+        -12,
+        -11,
+        -10,
+        -1,
+        0,
+        1,
+        9,
+        10,
+        11,
+        12,
+        99,
+        100,
+        101,
+        109,
+        999,
+    ]
+    exhaustive_max_length = 3
+    exhaustive = [
+        list(values)
+        for length in range(exhaustive_max_length + 1)
+        for values in itertools.product(pool, repeat=length)
+    ]
+
+    seed = 108_202_607_29
+    random_count = 2_000
+    rng = random.Random(seed)
+    random_cases: list[list[int]] = []
+    for _ in range(random_count):
+        length = rng.randrange(0, 21)
+        case: list[int] = []
+        for _ in range(length):
+            selector = rng.randrange(4)
+            if selector == 0:
+                case.append(rng.randrange(-10_000, 10_001))
+            elif selector == 1:
+                digits = rng.randrange(1, 101)
+                magnitude = rng.randrange(10 ** (digits - 1), 10**digits)
+                case.append(-magnitude if rng.randrange(2) else magnitude)
+            elif selector == 2:
+                case.append(rng.choice(pool))
+            else:
+                exponent = rng.randrange(0, 513)
+                magnitude = 10**exponent
+                delta = rng.choice([-2, -1, 0, 1, 2])
+                value = magnitude + delta
+                case.append(-value if rng.randrange(2) else value)
+
+        random_cases.append(case)
+
+    groups = [
+        ("documented", documented),
+        ("curated-boundaries", curated),
+        ("exhaustive", exhaustive),
+        ("seeded-random", random_cases),
+    ]
+
+    manifest = {
+        "canonical": str(canonical_path),
+        "generated": str(solution_path),
+        "documented": documented,
+        "curated": curated,
+        "exhaustive": {
+            "pool": pool,
+            "lengths": list(range(exhaustive_max_length + 1)),
+            "case_count": len(exhaustive),
+        },
+        "seeded_random": {
+            "seed": seed,
+            "case_count": random_count,
+            "list_length_range": [0, 20],
+            "integer_generation": "four selectors encoded in differential_test.py",
+        },
+    }
+    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
+
+    total = 0
+    mismatches: list[dict[str, object]] = []
+    digest = hashlib.sha256()
+    for group_name, cases in groups:
+        for values in cases:
+            total += 1
+            digest.update(json.dumps(values, separators=(",", ":")).encode())
+            digest.update(b"\n")
+            expected = canonical(values)
+            actual = generated(values)
+            independent = independent_oracle(values)
+            if expected != actual or expected != independent:
+                mismatches.append(
+                    {
+                        "group": group_name,
+                        "input": values,
+                        "canonical": expected,
+                        "generated": actual,
+                        "independent": independent,
+                    }
+                )
+                if len(mismatches) >= 20:
+                    break
+        if len(mismatches) >= 20:
+            break
+
+    print(f"documented_cases={len(documented)}")
+    print(f"curated_boundary_cases={len(curated)}")
+    print(f"exhaustive_cases={len(exhaustive)}")
+    print(f"seeded_random_cases={len(random_cases)} seed={seed}")
+    print(f"total_cases={total}")
+    print(f"ordered_input_sha256={digest.hexdigest()}")
+    print(f"mismatches={len(mismatches)}")
+    if mismatches:
+        print(json.dumps(mismatches, indent=2, sort_keys=True))
+        return 1
+    print("DIFFERENTIAL_PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
