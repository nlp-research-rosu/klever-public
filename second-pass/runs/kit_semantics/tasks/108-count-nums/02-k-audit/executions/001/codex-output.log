new file mode 100644
index 0000000000000000000000000000000000000000..6a745b314b8161fb5f87f8eb2f1d28f957a5fcba
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+} >"$log"
+
+"$@" > >(tee -a "$log") 2> >(tee -a "$log" >&2)
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$log"
+exit "$status"

