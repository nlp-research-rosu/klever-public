diff --git a//tmp/audit-work/outer-pid-getpid.c b//tmp/audit-work/outer-pid-getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..aab77e9188c540e4895ce19f9d68240d64baffbe
--- /dev/null
+++ b//tmp/audit-work/outer-pid-getpid.c
@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * Lean 4.22's Linux IO.appPath asks for /proc/<getpid()>/exe.  The audit
+ * launcher supplies a /proc mount from the outer PID namespace, so return
+ * the first (outermost) NSpid value to make that read refer to this process.
+ * Fall back to the raw system call only if /proc/self/status is unavailable.
+ */
+pid_t getpid(void) {
+    FILE *status = fopen("/proc/self/status", "r");
+    if (status != NULL) {
+        char line[512];
+        while (fgets(line, sizeof(line), status) != NULL) {
+            if (strncmp(line, "NSpid:", 6) == 0) {
+                long outer_pid = -1;
+                if (sscanf(line + 6, "%ld", &outer_pid) == 1 && outer_pid > 0) {
+                    fclose(status);
+                    return (pid_t)outer_pid;
+                }
+                break;
+            }
+        }
+        fclose(status);
+    }
+    return (pid_t)syscall(39); /* __NR_getpid on x86_64 */
+}
