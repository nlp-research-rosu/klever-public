   245	def _modInt_ (x0 x1 : SortInt) : Option SortInt :=
   246	  ite (x1 == 0) none (Int.emod x0 x1)
   247	def «_^%Int__» (x0 x1 x2 : SortInt) : Option SortInt :=
   248	   if x2 == 0 then none else
   249	   match x1 with -- TODO: Revisit this implementation
   250	   | .ofNat n => some (Int.emod (Int.pow x0 n) x2)
   251	   | _ => none
