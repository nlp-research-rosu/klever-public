$ nl -ba /reference/k-proof/verification-base.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // Exact structural domain predicate for lists whose elements are integers.
     7	  syntax Bool ::= allInts(ValSeq) [function, total]
     8	  rule allInts(.ValSeq) => true
     9	  rule allInts(vCons(V:Val, REST:ValSeq))
    10	    => isInt(V) andBool allInts(REST)
    11	
    12	  // Guarded total projection, following K's standard partial-cast twin idiom.
    13	  syntax Bool ::= definedProjectInt(Val) [function, total]
    14	  rule definedProjectInt(V:Val) => isInt(V)
    15	
    16	  syntax Int ::= projectIntTotal(Val)
    17	    [function, total, symbol(projectIntTotal), no-evaluators]
    18	
    19	  rule #Ceil({@V:Val}:>Int)
    20	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    21	    [simplification]
    22	
    23	  rule projectIntTotal(V:Val) => {V}:>Int
    24	    requires definedProjectInt(V)
    25	    [concrete, simplification(10), preserves-definedness]
    26	  rule {V:Val}:>Int => projectIntTotal(V)
    27	    requires definedProjectInt(V)
    28	    [symbolic(V), simplification, preserves-definedness]
    29	
    30	  rule projectIntTotal(I:Int) => I [simplification]
    31	  rule projectIntTotal(projectIntTotal(V:Val))
    32	    => projectIntTotal(V)
    33	    [simplification]
    34	
    35	  // Guarded dynamic-sort twins of the fixed MPY-INT equations.
    36	  rule applyBin("%", V:Val, I:Int)
    37	    => pyMod(projectIntTotal(V), I)
    38	    requires isInt(V)
    39	    [simplification]
    40	  rule applyBin("+", I:Int, V:Val)
    41	    => I +Int projectIntTotal(V)
    42	    requires isInt(V)
    43	    [simplification]
    44	
    45	  // Mathematical contribution of one value at a zero-based position.
    46	  syntax Int ::= oddContribution(Int, Int) [function, total]
    47	  rule oddContribution(I:Int, P:Int) => I
    48	    requires pyMod(P, 2) ==Int 0 andBool pyMod(I, 2) =/=Int 0
    49	  rule oddContribution(I:Int, P:Int) => 0
    50	    requires notBool (pyMod(P, 2) ==Int 0 andBool pyMod(I, 2) =/=Int 0)
    51	
    52	  // Sum of odd integer elements at even positions, beginning at position P.
    53	  // The non-integer equation totalizes the helper outside the target domain.
    54	  syntax Int ::= oddAtEvenSum(ValSeq, Int) [function, total]
    55	  rule oddAtEvenSum(.ValSeq, _:Int) => 0
    56	  rule oddAtEvenSum(vCons(V:Val, REST:ValSeq), P:Int)
    57	    => oddContribution(projectIntTotal(V), P)
    58	       +Int oddAtEvenSum(REST, P +Int 1)
    59	    requires isInt(V)
    60	  rule oddAtEvenSum(vCons(V:Val, REST:ValSeq), P:Int)
    61	    => oddAtEvenSum(REST, P +Int 1)
    62	    requires notBool isInt(V)
    63	
    64	  // Value left in the loop target after consuming a sequence.
    65	  syntax Val ::= lastAfter(ValSeq, Val) [function, total]
    66	  rule lastAfter(.ValSeq, CURRENT:Val) => CURRENT
    67	  rule lastAfter(vCons(V:Val, REST:ValSeq), _:Val)
    68	    => lastAfter(REST, V)
    69	endmodule
