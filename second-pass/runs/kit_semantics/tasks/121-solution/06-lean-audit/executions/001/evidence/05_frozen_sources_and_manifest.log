$ nl -ba /reference/k-proof/solution.py /reference/k-proof/solution.mpy
     1	def solution(lst):
     2	    result = 0
     3	    position = 0
     4	    value = 0
     5	    for value in lst:
     6	        if position % 2 == 0:
     7	            if value % 2 != 0:
     8	                result += value
     9	        position += 1
    10	    return result
    11	Module(
    12	  FuncDef("solution", Params("lst"),
    13	    Assign(Name("result"), Int(0))
    14	    Assign(Name("position"), Int(0))
    15	    Assign(Name("value"), Int(0))
    16	    For(Name("value"), Name("lst"),
    17	      If(Compare(BinOp("%", Name("position"), Int(2)), CmpOp("==", Int(0))),
    18	        If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("!=", Int(0))),
    19	          AugAssign(Name("result"), "+", Name("value")),
    20	          ),
    21	        )
    22	      AugAssign(Name("position"), "+", Int(1)))
    23	    Return(Name("result"))))
