     3	module VERIFICATION
     4	  imports VERIFICATION-BASE
     5	
     6	  // Exact loop-only bridge justified independently by CONNECTION-SPEC.loop.
     7	  // The arbitrary continuation and omitted cells are equally general in that
     8	  // bridge-free theorem and are preserved unchanged.
     9	  rule
    10	    <k>
    11	      #loop(
