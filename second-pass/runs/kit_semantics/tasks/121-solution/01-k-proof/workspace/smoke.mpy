Module(
  FuncDef("solution", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("position"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Compare(BinOp("%", Name("position"), Int(2)), CmpOp("==", Int(0))),
        If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("!=", Int(0))),
          AugAssign(Name("result"), "+", Name("value")),
          ),
        )
      AugAssign(Name("position"), "+", Int(1)))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(5), Int(8), Int(7), Int(1))),
      CmpOp("==", Int(12))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(Int(3), Int(3), Int(3), Int(3), Int(3))),
      CmpOp("==", Int(9))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(Int(30), Int(13), Int(24), Int(321))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(UnaryOp("-", Int(5)), Int(2), UnaryOp("-", Int(7)))),
      CmpOp("==", UnaryOp("-", Int(12)))))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(2))),
      CmpOp("==", Int(0)))))
