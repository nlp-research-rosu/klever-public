Module(
          FuncDef(
            "solution",
            Params("lst"),
            Assign(Name("result"), Int(0))
            Assign(Name("position"), Int(0))
            Assign(Name("value"), Int(0))
            For(
              Name("value"),
              Name("lst"),
              If(
                Compare(
                  BinOp("%", Name("position"), Int(2)),
                  CmpOp("==", Int(0))
                ),
                If(
                  Compare(
                    BinOp("%", Name("value"), Int(2)),
                    CmpOp("!=", Int(0))
                  ),
                  AugAssign(Name("result"), "+", Name("value")),
                 
                ),
               
              )
              AugAssign(Name("position"), "+", Int(1))
            )
            Return(Name("result"))
          )
        )
