+#!/usr/bin/env bash
+set -uo pipefail
+
+run_success() {
+  echo "+ $*"
+  "$@"
+  local status=$?
+  echo "EXIT: $status"
+  if [[ $status -ne 0 ]]; then
+    exit "$status"
+  fi
+}
+
+run_expected_failure() {
+  echo "+ $*"
+  "$@"
+  local status=$?
+  echo "EXIT: $status (expected nonzero)"
+  if [[ $status -eq 0 ]]; then
+    echo "ERROR: body mutation unexpectedly proved"
