          "solution" |-> closureVal(
            "lst" , .ParamNames,
            Assign(Name("result"), Int(0))
            Assign(Name("position"), Int(0))
            Assign(Name("value"), Int(0))
            For(
              Name("value"),
              Name("lst"),
              If(
                Compare(
                  BinOp("%", Name("position"), Int(2)),
                  CmpOp("==", Int(0))
                ),
                If(
                  Compare(
                    BinOp("%", Name("value"), Int(2)),
                    CmpOp("!=", Int(0))
                  ),
                  AugAssign(Name("result"), "+", Name("value")) .Stmts,
                  .Stmts
                ) .Stmts,
                .Stmts
              )
              AugAssign(Name("position"), "+", Int(1)) .Stmts
            )
            Return(Name("result")) .Stmts,
            0
          ),
          parent(-1)
        )
      )
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(vCons(HEAD, TAIL))
endmodule
requires "verification-base.k"

module VERIFICATION
  imports VERIFICATION-BASE

  // Exact loop-only bridge justified independently by CONNECTION-SPEC.loop.
  // The arbitrary continuation and omitted cells are equally general in that
  // bridge-free theorem and are preserved unchanged.
  rule
    <k>
      #loop(
        list(REST:ValSeq),
        Name("value"),
        If(
          Compare(
            BinOp("%", Name("position"), Int(2)),
            CmpOp("==", Int(0))
          ),
          If(
            Compare(
              BinOp("%", Name("value"), Int(2)),
              CmpOp("!=", Int(0))
            ),
            AugAssign(Name("result"), "+", Name("value")) .Stmts,
            .Stmts
          ) .Stmts,
          .Stmts
        )
        AugAssign(Name("position"), "+", Int(1)) .Stmts
      )
      => .K
      ...
    </k>
    <env> L:Int </env>
    <scopes>
      ...
      L |-> scope(
        "lst"      |-> list(ALL:ValSeq)
        "position" |-> (POSITION:Int => POSITION +Int vsLen(REST))
        "result"   |-> (ACC:Int => ACC +Int oddAtEvenSum(REST, POSITION))
        "value"    |-> (CURRENT:Val => lastAfter(REST, CURRENT)),
        PARENT:Parent
      )
      ...
    </scopes>
    requires allInts(REST) andBool POSITION >=Int 0
    [priority(40)]
endmodule
requires "reference-semantics/semantics.k"

module VERIFICATION-BASE
  imports MPY

  // Exact structural domain predicate for lists whose elements are integers.
  syntax Bool ::= allInts(ValSeq) [function, total]
  rule allInts(.ValSeq) => true
  rule allInts(vCons(V:Val, REST:ValSeq))
    => isInt(V) andBool allInts(REST)

  // Guarded total projection, following K's standard partial-cast twin idiom.
  syntax Bool ::= definedProjectInt(Val) [function, total]
  rule definedProjectInt(V:Val) => isInt(V)

  syntax Int ::= projectIntTotal(Val)
    [function, total, symbol(projectIntTotal), no-evaluators]

  rule #Ceil({@V:Val}:>Int)
    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    [simplification]

  rule projectIntTotal(V:Val) => {V}:>Int
    requires definedProjectInt(V)
    [concrete, simplification(10), preserves-definedness]
  rule {V:Val}:>Int => projectIntTotal(V)
    requires definedProjectInt(V)
    [symbolic(V), simplification, preserves-definedness]

  rule projectIntTotal(I:Int) => I [simplification]
  rule projectIntTotal(projectIntTotal(V:Val))
    => projectIntTotal(V)
    [simplification]

  // Guarded dynamic-sort twins of the fixed MPY-INT equations.
  rule applyBin("%", V:Val, I:Int)
    => pyMod(projectIntTotal(V), I)
    requires isInt(V)
    [simplification]
  rule applyBin("+", I:Int, V:Val)
    => I +Int projectIntTotal(V)
    requires isInt(V)
    [simplification]

  // Mathematical contribution of one value at a zero-based position.
  syntax Int ::= oddContribution(Int, Int) [function, total]
  rule oddContribution(I:Int, P:Int) => I
    requires pyMod(P, 2) ==Int 0 andBool pyMod(I, 2) =/=Int 0
  rule oddContribution(I:Int, P:Int) => 0
    requires notBool (pyMod(P, 2) ==Int 0 andBool pyMod(I, 2) =/=Int 0)

  // Sum of odd integer elements at even positions, beginning at position P.
  // The non-integer equation totalizes the helper outside the target domain.
  syntax Int ::= oddAtEvenSum(ValSeq, Int) [function, total]
  rule oddAtEvenSum(.ValSeq, _:Int) => 0
  rule oddAtEvenSum(vCons(V:Val, REST:ValSeq), P:Int)
    => oddContribution(projectIntTotal(V), P)
       +Int oddAtEvenSum(REST, P +Int 1)
    requires isInt(V)
  rule oddAtEvenSum(vCons(V:Val, REST:ValSeq), P:Int)
    => oddAtEvenSum(REST, P +Int 1)
    requires notBool isInt(V)

  // Value left in the loop target after consuming a sequence.
  syntax Val ::= lastAfter(ValSeq, Val) [function, total]
  rule lastAfter(.ValSeq, CURRENT:Val) => CURRENT
  rule lastAfter(vCons(V:Val, REST:ValSeq), _:Val)
    => lastAfter(REST, V)
endmodule
requires "verification-base.k"

module CONNECTION-SPEC
  imports VERIFICATION-BASE

  claim [loop]:
    <k>
      #loop(
        list(REST:ValSeq),
        Name("value"),
        If(
          Compare(
            BinOp("%", Name("position"), Int(2)),
            CmpOp("==", Int(0))
          ),
          If(
            Compare(
              BinOp("%", Name("value"), Int(2)),
              CmpOp("!=", Int(0))
            ),
            AugAssign(Name("result"), "+", Name("value")) .Stmts,
            .Stmts
          ) .Stmts,
          .Stmts
        )
        AugAssign(Name("position"), "+", Int(1)) .Stmts
      )
      => .K
      ...
    </k>
    <env> L:Int </env>
    <scopes>
      ...
      L |-> scope(
        "lst"      |-> list(ALL:ValSeq)
        "position" |-> (POSITION:Int => POSITION +Int vsLen(REST))
        "result"   |-> (ACC:Int => ACC +Int oddAtEvenSum(REST, POSITION))
        "value"    |-> (CURRENT:Val => lastAfter(REST, CURRENT)),
        PARENT:Parent
      )
      ...
    </scopes>
    requires allInts(REST) andBool POSITION >=Int 0
endmodule
requires "verification-base.k"

module PROJECTION-POSITIVE
  imports VERIFICATION-BASE

  claim [positive-five]:
    <k> projectIntTotal(5) => 5 </k>

  claim [negative-seven]:
    <k> projectIntTotal(-7) => -7 </k>
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy
python3 differential_test.py

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun smoke.mpy --definition runtime-kompiled

# Bridge-free universal connection theorem.
kompile --backend haskell verification-base.k \
  --main-module VERIFICATION-BASE \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-base-kompiled
kprove connection-spec.k \
  --definition verification-base-kompiled \
  --spec-module CONNECTION-SPEC
kprove projection-positive.k \
  --definition verification-base-kompiled \
  --spec-module PROJECTION-POSITIVE

# Full non-empty symbolic target theorem.
kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

# Negative validation probes must all be rejected.
if kprove spec-vacuity.k \
    --definition verification-kompiled \
    --spec-module SPEC-VACUITY; then
  echo "ERROR: false postcondition unexpectedly proved" >&2
  exit 1
else
  echo "EXPECTED FAILURE: false postcondition rejected"
fi

if kprove connection-mutation.k \
    --definition verification-base-kompiled \
    --spec-module CONNECTION-MUTATION; then
  echo "ERROR: mutated loop connection unexpectedly proved" >&2
  exit 1
else
  echo "EXPECTED FAILURE: mutated loop connection rejected"
fi

if kprove connection-mutation.k \
    --definition verification-kompiled \
    --spec-module CONNECTION-MUTATION; then
  echo "ERROR: loop bridge matched a mutated body" >&2
  exit 1
else
  echo "EXPECTED FAILURE: loop bridge rejected the mutated body"
fi

if kprove projection-mutation.k \
    --definition verification-base-kompiled \
    --spec-module PROJECTION-MUTATION; then
  echo "ERROR: false projection interpretation unexpectedly proved" >&2
  exit 1
else
  echo "EXPECTED FAILURE: false projection interpretation rejected"
fi

