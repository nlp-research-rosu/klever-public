+run_expected_failure kprove stage5-body-sensitivity.k \
+  --definition auditor-verification-base-kompiled \
+  --spec-module STAGE5-BODY-SENSITIVITY
+run_expected_failure kprove stage5-body-sensitivity.k \
+  --definition auditor-verification-kompiled \
