@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+run_checked() {
+  echo "+ $*"
+  "$@"
+  local status=$?
+  echo "EXIT: $status"
+  if [[ $status -ne 0 ]]; then
+    exit "$status"
+  fi
+}
+
