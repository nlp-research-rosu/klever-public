+          "position" |-> 0
+          "result"   |-> 0
+          "value"    |-> 0,
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(.Map, parent(-1))
+        1 |-> scope(
+          "lst"      |-> list(vCons(1, vCons(3, .ValSeq)))
+          "position" |-> 2
+          "result"   |-> 1
+          "value"    |-> 3,
+          parent(0)
+        )
+      )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
