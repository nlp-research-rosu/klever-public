+example : Proof.«isStrV(_)_MPY-BUILTINS_Bool_Val» nestedNoncanonicalString = false := by rfl
+
+example : Proof.«stringCodes(_)_VERIFICATION_IntSeq_Val» threeString = threeCodes := by rfl
+example :
