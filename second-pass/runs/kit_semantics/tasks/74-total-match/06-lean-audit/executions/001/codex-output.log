    51	            CmpOp(">", Call(Name("_total_length"), Name("lst2")))),
    52	            Return(Name("lst1")),
    53	            .Stmts)
    54	          Return(Name("lst2")),
    55	          0
    56	        ),
    57	        parent(-1)
    58	      )
