+example : Proof.«seqLen(_)_MPY-BUILTINS_Int_Val» rangeEmpty = 0 := by rfl
+example : Proof.«seqLen(_)_MPY-BUILTINS_Int_Val» rangeZeroStep = 0 := by rfl
+example : Proof.«seqLen(_)_MPY-BUILTINS_Int_Val» setThree = 3 := by rfl
+example :
