    38	        "_total_length" |-> closureVal(
    39	          ("strings", .ParamNames),
    40	          Assign(Name("total"), Int(0))
    41	          Assign(Name("string"), NoneVal)
    42	          For(Name("string"), Name("strings"),
    43	            AugAssign(Name("total"), "+", Call(Name("len"), Name("string"))))
    44	          Return(Name("total")),
    45	          0
    46	        )
