print('"'stage1_source_hash_count_expected=', len(expected_files))
print('stage1_source_hash_count_actual=', len(actual_files))
print('stage1_source_missing=', missing)
print('stage1_source_extra=', extra)
print('stage1_source_mismatch=', mismatch)
print('all_mounted_top_level_hashes_match=', all(h[key] == actual for key, actual in checks))
print('all_stage1_file_hashes_match=', not missing and not extra and not mismatch)
print('lean_invocation_sha256_verifiable_from_mount=', False, '(invocation evidence is not mounted; /candidate is the workspace mount)')
