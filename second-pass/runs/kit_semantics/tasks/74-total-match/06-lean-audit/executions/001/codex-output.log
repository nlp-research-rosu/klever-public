diff --git a//tmp/audit-work/proc_exe_compat.c b//tmp/audit-work/proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..c9010083b910569d739464fdfa7c543489aeab4f
--- /dev/null
+++ b//tmp/audit-work/proc_exe_compat.c
@@ -0,0 +1,57 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <unistd.h>
+
+static int is_numeric_proc_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    const char *cursor = path;
+    const char *expected = prefix;
+    if (cursor == NULL) {
+        return 0;
+    }
+    while (*expected != '\0') {
+        if (*cursor++ != *expected++) {
+            return 0;
+        }
+    }
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    expected = suffix;
+    while (*expected != '\0') {
+        if (*cursor++ != *expected++) {
+            return 0;
+        }
+    }
+    return *cursor == '\0';
+}
+
+ssize_t readlink(const char *restrict path, char *restrict buffer,
+                 size_t buffer_size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    if (real_readlink == NULL) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_numeric_proc_exe(path)) {
+        path = "/proc/self/exe";
+    }
+    return real_readlink(path, buffer, buffer_size);
+}
+
+ssize_t readlinkat(int directory_fd, const char *restrict path,
+                   char *restrict buffer, size_t buffer_size) {
+    static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+    if (real_readlinkat == NULL) {
+        real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+    }
+    if (is_numeric_proc_exe(path)) {
+        path = "/proc/self/exe";
+    }
+    return real_readlinkat(directory_fd, path, buffer, buffer_size);
+}
diff --git a//tmp/audit-work/proc_exe_probe.c b//tmp/audit-work/proc_exe_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..ed4a5672c6e48d69ab88663efd7c9a34fbaf551d
--- /dev/null
+++ b//tmp/audit-work/proc_exe_probe.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+    char path[PATH_MAX];
+    char target[PATH_MAX];
+    pid_t pid = getpid();
+    int n = snprintf(path, sizeof(path), "/proc/%ld/exe", (long)pid);
+    if (n < 0 || (size_t)n >= sizeof(path)) {
+        return 2;
+    }
+    ssize_t self_count = readlink("/proc/self/exe", target, sizeof(target) - 1);
+    if (self_count >= 0) {
+        target[self_count] = '\0';
+    }
+    printf("getpid=%ld\n", (long)pid);
+    printf("self_readlink_count=%ld errno=%d target=%s\n",
+           (long)self_count, errno, self_count >= 0 ? target : "");
+    errno = 0;
+    ssize_t pid_count = readlink(path, target, sizeof(target) - 1);
+    if (pid_count >= 0) {
+        target[pid_count] = '\0';
+    }
+    printf("pid_path=%s\n", path);
+    printf("pid_readlink_count=%ld errno=%d target=%s\n",
+           (long)pid_count, errno, pid_count >= 0 ? target : "");
+    return 0;
+}

exec
/bin/bash -lc "PYTHONPATH=/reference python - <<'PY' | tee /audit-output/evidence/40_independent_tree_and_manifest_hashes.txt
import hashlib, json
from pathlib import Path
from tools.audit_contract import sha256_tree as audit_tree
from tools.klean_export import tree_digest
paths = [
    Path('/reference/k-proof'),
    Path('/reference/klean-generation/generated'),
    Path('/reference/klean-generation'),
    Path('/reference/generation-tools'),
    Path('/candidate'),
]
for p in paths:
    print(p)
    try: print('  audit_contract.sha256_tree =', audit_tree(p))
    except Exception as e: print('  audit_contract.sha256_tree ERROR =', repr(e))
    try: print('  klean_export.tree_digest =', tree_digest(p))
    except Exception as e: print('  klean_export.tree_digest ERROR =', repr(e))
print('file_sha256:')
for p in [
    Path('/reference/lemma-discovery.json'),
    Path('/reference/generation-tools/klean_export.py'),
    Path('/reference/generation-tools/klean.py'),
    Path('/reference/generation-tools/source-manifest.json'),
    Path('/reference/klean-generation/input-manifest.json'),
    Path('/reference/klean-generation/generator-manifest.json'),
    Path('/reference/klean-generation/trust-inventory.json'),
    Path('/reference/klean-generation/export-result.json'),
    Path('/reference/klean-generation/generated/obligation-map.json'),
]:
    print(' ', hashlib.sha256(p.read_bytes()).hexdigest(), p)
PY
status="'${PIPESTATUS[0]}; echo "EXIT: $status" | tee -a /audit-output/evidence/40_independent_tree_and_manifest_hashes.txt; test "$status" -eq 0' in /audit-output
