h = audit['hashes']
checks = [
  ('discovery_manifest_sha256', hashlib.sha256(Path('/reference/lemma-discovery.json').read_bytes()).hexdigest()),
  ('generated_tree_sha256', tree_digest(Path('/reference/klean-generation/generated'))),
