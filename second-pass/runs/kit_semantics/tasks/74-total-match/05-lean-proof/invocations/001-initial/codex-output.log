+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length <= 0) {
