module MPY-RANGE
  imports MPY-CORE
  imports MPY-ITER

  syntax Bool ::= inRange(Int, Int, Int) [function, total]
  rule inRange(I:Int, HI:Int, ST:Int) => (ST >Int 0 andBool I <Int HI) orBool (ST <Int 0 andBool I >Int HI)

