codex
The installation itself is intact; the sandbox exposes host PIDs in `/proc` while Lean queries its namespace PID, so Lean’s executable-path lookup fails. I’m using a temporary process-local compatibility shim for that lookup; it does not alter the pinned toolchain, Base, or proof sources.
apply patch
patch: completed
/workspace/.lean_proc_pid.c
diff --git a/.lean_proc_pid.c b/.lean_proc_pid.c
new file mode 100644
index 0000000000000000000000000000000000000000..e3bd72e2b2823df2378f96faf4def24b39d9df27
--- /dev/null
+++ b/.lean_proc_pid.c
@@ -0,0 +1,14 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length <= 0) {
+    return 1;
+  }
+  target[length] = '\0';
+  return (pid_t)strtol(target, NULL, 10);
+}
