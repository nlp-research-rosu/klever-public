VERIFICATION.K
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The prompt's list-of-strings domain, unfolded one ValSeq constructor at a
     7	  // time.  isStrV is supplied by the fixed semantics.
     8	  syntax Bool ::= onlyStrings(ValSeq) [function, total]
     9	  rule onlyStrings(.ValSeq) => true
    10	  rule onlyStrings(vCons(V:Val, REST:ValSeq))
    11	    => isStrV(V) andBool onlyStrings(REST)
    12	
    13	  // A total projection used only under isStrV.  Its non-string case makes the
    14	  // definition exhaustive but cannot affect a claim in the formal domain.
    15	  syntax IntSeq ::= stringCodes(Val) [function, total]
    16	  rule stringCodes(str(CS:IntSeq)) => CS
    17	  rule stringCodes(_V:Val) => .IntSeq [owise]
    18	
    19	  // This is the reference rule seqLen(str(CS)) => isLen(CS), generalized under
    20	  // the exact fixed-semantics string recognizer.
    21	  rule seqLen(V:Val) => isLen(stringCodes(V))
    22	    requires isStrV(V)
    23	    [simplification]
    24	
    25	  // A left-fold summary that exactly follows the program's accumulator update.
    26	  syntax Int ::= totalLen(ValSeq) [function, total]
    27	               | totalLenFrom(Int, ValSeq) [function, total]
    28	  rule totalLen(ITEMS:ValSeq) => totalLenFrom(0, ITEMS)
    29	  rule totalLenFrom(ACC:Int, .ValSeq) => ACC
    30	  rule totalLenFrom(ACC:Int, vCons(V:Val, REST:ValSeq))
    31	    => totalLenFrom(ACC +Int isLen(stringCodes(V)), REST)
    32	
    33	  // The exact final value left in a Python for-loop target.
    34	  syntax Val ::= lastLoopValue(ValSeq, Val) [function, total]
    35	  rule lastLoopValue(.ValSeq, OLD:Val) => OLD
    36	  rule lastLoopValue(vCons(V:Val, REST:ValSeq), _OLD:Val)
    37	    => lastLoopValue(REST, V)
    38	endmodule

PROVE.SH
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py smoke.py > smoke.mpy
     6	python3 -m py_compile solution.py differential_test.py
     7	
     8	kompile reference-semantics/semantics.k \
     9	  --backend llvm \
    10	  --main-module MPY-KRUN \
    11	  --syntax-module MPY-SYNTAX \
    12	  --output-definition runtime-kompiled
    13	
    14	krun smoke.mpy --definition runtime-kompiled
    15	
    16	kompile verification.k \
    17	  --backend haskell \
    18	  --main-module VERIFICATION \
    19	  --syntax-module MPY-SYNTAX \
    20	  --output-definition verification-kompiled
    21	
    22	kprove spec.k \
    23	  --definition verification-kompiled \
    24	  --spec-module SPEC
    25	
    26	python3 differential_test.py
    27	
    28	set +e
    29	kprove spec-vacuity.k \
    30	  --definition verification-kompiled \
    31	  --spec-module SPEC-VACUITY
    32	vacuity_status=$?
    33	
    34	kprove spec-body-mutation.k \
    35	  --definition verification-kompiled \
    36	  --spec-module SPEC-BODY-MUTATION
    37	body_mutation_status=$?
    38	set -e
    39	
    40	if [ "$vacuity_status" -eq 0 ]; then
    41	  echo "ERROR: false-result mutation unexpectedly proved"
    42	  exit 1
    43	fi
    44	echo "EXPECTED FAILURE: false-result mutation exited $vacuity_status"
    45	
    46	if [ "$body_mutation_status" -eq 0 ]; then
    47	  echo "ERROR: body mutation unexpectedly proved"
    48	  exit 1
    49	fi
    50	echo "EXPECTED FAILURE: body mutation exited $body_mutation_status"

