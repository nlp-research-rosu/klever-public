      "start_line": 10,
      "text": "  rule onlyStrings(vCons(V:Val, REST:ValSeq))\n    => isStrV(V) andBool onlyStrings(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
