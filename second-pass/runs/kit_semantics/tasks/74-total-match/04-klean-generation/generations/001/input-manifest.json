      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "15462c50b7340ac165d712c183d20f39114256f0a77864f57113d62121d4b835",
      "rationale": "Exhaustive owise equation completing the total definition of stringCodes on non-string Val constructors.",
      "source_rule_id": "rule-15462c50b7340ac165d712c183d20f39114256f0a77864f57113d62121d4b835",
      "start_line": 17,
      "text": "  rule stringCodes(_V:Val) => .IntSeq [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "1bba7b86c835e7afed82818697a61da1c1a640f585771c5451e6a4797d223cc7",
      "rationale": "Wrapper equation defining totalLen as the newly named left-fold summary totalLenFrom with initial accumulator zero.",
      "source_rule_id": "rule-1bba7b86c835e7afed82818697a61da1c1a640f585771c5451e6a4797d223cc7",
      "start_line": 28,
      "text": "  rule totalLen(ITEMS:ValSeq) => totalLenFrom(0, ITEMS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "ad39b76bc1e390fe2c642f62148031564aba628ffb8a4e6671eac35ea5830b19",
      "rationale": "Base equation defining the totalLenFrom recurrence on the empty ValSeq.",
      "source_rule_id": "rule-ad39b76bc1e390fe2c642f62148031564aba628ffb8a4e6671eac35ea5830b19",
      "start_line": 29,
      "text": "  rule totalLenFrom(ACC:Int, .ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "59d7919df49851f487a751100aea360abb2cc715fcf4747dbb11d037bb2b45eb",
      "rationale": "Descending recursive equation defining the totalLenFrom mathematical fold over a nonempty ValSeq.",
      "source_rule_id": "rule-59d7919df49851f487a751100aea360abb2cc715fcf4747dbb11d037bb2b45eb",
      "start_line": 30,
      "text": "  rule totalLenFrom(ACC:Int, vCons(V:Val, REST:ValSeq))\n    => totalLenFrom(ACC +Int isLen(stringCodes(V)), REST)"
    },
    {
      "attributes": [],
