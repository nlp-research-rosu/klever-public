diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f05d0ab574b9f4dda576bb30b15302f8c20ec594
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,18 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A mathematical summary of the supplied semantics' len result for every
+  // element of a ValSeq.  The HumanEval claims instantiate elements as strings.
+  syntax Int ::= totalLen(ValSeq) [function, total]
+  rule totalLen(.ValSeq) => 0
+  rule totalLen(vCons(V:Val, VS:ValSeq))
+    => seqLen(V) +Int totalLen(VS)
+
+  // The exact final value left in a Python for-loop target.
+  syntax Val ::= lastLoopValue(ValSeq, Val) [function, total]
+  rule lastLoopValue(.ValSeq, OLD:Val) => OLD
+  rule lastLoopValue(vCons(V:Val, VS:ValSeq), _OLD:Val)
+    => lastLoopValue(VS, V)
+endmodule

