diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8eef0cbf4921c2f0ea85c945dca3efc14cf2ccc7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A mathematical summary of the supplied semantics' len result for every
+  // element of a ValSeq.  The HumanEval claims instantiate elements as strings.
+  syntax Int ::= totalLen(ValSeq) [function, total]
+  rule totalLen(.ValSeq) => 0
+  rule totalLen(vCons(V:Val, VS:ValSeq))
+    => seqLen(V) +Int totalLen(VS)
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..5eb153e1b438fa3148b8d6edfb44df8e1c0e4f35
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,21 @@
+def _total_length(strings):
+    total = 0
+    string = None
+    for string in strings:
+        total += len(string)
+    return total
+
+
+def total_match(lst1, lst2):
+    if _total_length(lst1) <= _total_length(lst2):
+        return lst1
+    return lst2
+
+
+assert total_match([], []) == []
+assert total_match(["hi", "admin"], ["hI", "Hi"]) == ["hI", "Hi"]
+assert total_match(
+    ["hi", "admin"], ["hi", "hi", "admin", "project"]
+) == ["hi", "admin"]
+assert total_match(["hi", "admin"], ["hI", "hi", "hi"]) == ["hI", "hi", "hi"]
+assert total_match(["4"], ["1", "2", "3", "4", "5"]) == ["4"]
