+            CmpOp("<=", Call(Name("_total_length"), Name("lst2")))),
+            Return(Name("lst1")),
+            .Stmts)
+          Return(Name("lst2")),
+          0
+        ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires totalLen(A) <=Int totalLen(B)
+
+  claim [entry-second]:
+    <k>
+      #loadAll(Module(
+        FuncDef("_total_length", Params("strings"),
+          Assign(Name("total"), Int(0))
+          Assign(Name("string"), NoneVal)
