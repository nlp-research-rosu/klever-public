diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..88476cfbd44dc63e8aaf04c0b59001998311ef24
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,27 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A typed representation of exactly the prompt's list-of-strings domain.
+  syntax StringItems ::= ".StringItems"
+                       | siCons(IntSeq, StringItems)
+  syntax ValSeq ::= stringVals(StringItems) [function, total]
+  rule stringVals(.StringItems) => .ValSeq
+  rule stringVals(siCons(CS:IntSeq, REST:StringItems))
+    => vCons(str(CS), stringVals(REST))
+
+  // A left-fold summary that exactly follows the program's accumulator update.
+  syntax Int ::= totalLen(StringItems) [function, total]
+               | totalLenFrom(Int, StringItems) [function, total]
+  rule totalLen(ITEMS:StringItems) => totalLenFrom(0, ITEMS)
+  rule totalLenFrom(ACC:Int, .StringItems) => ACC
+  rule totalLenFrom(ACC:Int, siCons(CS:IntSeq, REST:StringItems))
+    => totalLenFrom(ACC +Int isLen(CS), REST)
+
+  // The exact final value left in a Python for-loop target.
+  syntax Val ::= lastLoopValue(StringItems, Val) [function, total]
+  rule lastLoopValue(.StringItems, OLD:Val) => OLD
+  rule lastLoopValue(siCons(CS:IntSeq, REST:StringItems), _OLD:Val)
+    => lastLoopValue(REST, str(CS))
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..5eb153e1b438fa3148b8d6edfb44df8e1c0e4f35
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,21 @@
+def _total_length(strings):
+    total = 0
+    string = None
+    for string in strings:
+        total += len(string)
+    return total
+
+
+def total_match(lst1, lst2):
+    if _total_length(lst1) <= _total_length(lst2):
+        return lst1
+    return lst2
+
+
+assert total_match([], []) == []
+assert total_match(["hi", "admin"], ["hI", "Hi"]) == ["hI", "Hi"]
+assert total_match(
+    ["hi", "admin"], ["hi", "hi", "admin", "project"]
+) == ["hi", "admin"]
+assert total_match(["hi", "admin"], ["hI", "hi", "hi"]) == ["hI", "hi", "hi"]
+assert total_match(["4"], ["1", "2", "3", "4", "5"]) == ["4"]
