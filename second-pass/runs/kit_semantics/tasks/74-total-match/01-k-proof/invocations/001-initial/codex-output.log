+            CmpOp("<=", Call(Name("_total_length"), Name("lst2")))),
+            Return(Name("lst1")),
+            .Stmts)
+          Return(Name("lst2")))
+      ))
+      ~> Call(Name("total_match"), list(.ValSeq), list(.ValSeq))
+      => noneV
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "_total_length" |-> closureVal(
