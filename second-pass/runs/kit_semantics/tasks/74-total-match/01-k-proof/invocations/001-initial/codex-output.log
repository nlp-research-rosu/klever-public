diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8eef0cbf4921c2f0ea85c945dca3efc14cf2ccc7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A mathematical summary of the supplied semantics' len result for every
+  // element of a ValSeq.  The HumanEval claims instantiate elements as strings.
+  syntax Int ::= totalLen(ValSeq) [function, total]
+  rule totalLen(.ValSeq) => 0
+  rule totalLen(vCons(V:Val, VS:ValSeq))
+    => seqLen(V) +Int totalLen(VS)
+endmodule

