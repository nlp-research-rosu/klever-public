diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..88c20f848c289660285024e0b62eacb267f66a06
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,38 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The prompt's list-of-strings domain, unfolded one ValSeq constructor at a
+  // time.  isStrV is supplied by the fixed semantics.
+  syntax Bool ::= onlyStrings(ValSeq) [function, total]
+  rule onlyStrings(.ValSeq) => true
+  rule onlyStrings(vCons(V:Val, REST:ValSeq))
+    => isStrV(V) andBool onlyStrings(REST)
+
+  // A total projection used only under isStrV.  Its non-string case makes the
+  // definition exhaustive but cannot affect a claim in the formal domain.
+  syntax IntSeq ::= stringCodes(Val) [function, total]
+  rule stringCodes(str(CS:IntSeq)) => CS
+  rule stringCodes(_V:Val) => .IntSeq [owise]
+
+  // This is the reference rule seqLen(str(CS)) => isLen(CS), generalized under
+  // the exact fixed-semantics string recognizer.
+  rule seqLen(V:Val) => isLen(stringCodes(V))
+    requires isStrV(V)
+    [simplification]
+
+  // A left-fold summary that exactly follows the program's accumulator update.
+  syntax Int ::= totalLen(ValSeq) [function, total]
+               | totalLenFrom(Int, ValSeq) [function, total]
+  rule totalLen(ITEMS:ValSeq) => totalLenFrom(0, ITEMS)
+  rule totalLenFrom(ACC:Int, .ValSeq) => ACC
+  rule totalLenFrom(ACC:Int, vCons(V:Val, REST:ValSeq))
+    => totalLenFrom(ACC +Int isLen(stringCodes(V)), REST)
+
+  // The exact final value left in a Python for-loop target.
+  syntax Val ::= lastLoopValue(ValSeq, Val) [function, total]
+  rule lastLoopValue(.ValSeq, OLD:Val) => OLD
+  rule lastLoopValue(vCons(V:Val, REST:ValSeq), _OLD:Val)
+    => lastLoopValue(REST, V)
+endmodule

diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..709fade2b0aeedb0f0fda43fded49e99b5d28e1c
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,41 @@
+from itertools import product
+
+from solution import total_match
+
+
+def oracle(lst1, lst2):
+    return lst1 if len("".join(lst1)) <= len("".join(lst2)) else lst2
+
+
+atoms = ("", "a", "bc", "XYZ")
+lists = []
+for size in range(4):
+    lists.extend([list(items) for items in product(atoms, repeat=size)])
+
+prompt_cases = [
+    ([], []),
+    (["hi", "admin"], ["hI", "Hi"]),
+    (["hi", "admin"], ["hi", "hi", "admin", "project"]),
+    (["hi", "admin"], ["hI", "hi", "hi"]),
+    (["4"], ["1", "2", "3", "4", "5"]),
+]
+
+tested = 0
+mismatches = []
+for lst1, lst2 in product(lists, repeat=2):
+    expected = oracle(lst1, lst2)
+    actual = total_match(lst1, lst2)
+    tested += 1
+    if actual is not expected:
+        mismatches.append((lst1, lst2, expected, actual))
+
+for lst1, lst2 in prompt_cases:
+    expected = oracle(lst1, lst2)
+    actual = total_match(lst1, lst2)
+    tested += 1
+    if actual is not expected:
+        mismatches.append((lst1, lst2, expected, actual))
+
+print(f"tested={tested} mismatches={len(mismatches)}")
+if mismatches:
+    raise AssertionError(mismatches[:5])
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..6afbbbe71eff20ba07210af2ec8dd37c5c90abab
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+python3 -m py_compile solution.py differential_test.py
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun smoke.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+python3 differential_test.py
+
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY
+vacuity_status=$?
+
+kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION
+body_mutation_status=$?
+set -e
+
+if [ "$vacuity_status" -eq 0 ]; then
+  echo "ERROR: false-result mutation unexpectedly proved"
+  exit 1
+fi
+echo "EXPECTED FAILURE: false-result mutation exited $vacuity_status"
+
+if [ "$body_mutation_status" -eq 0 ]; then
+  echo "ERROR: body mutation unexpectedly proved"
+  exit 1
+fi
+echo "EXPECTED FAILURE: body mutation exited $body_mutation_status"
