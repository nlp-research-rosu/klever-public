Module(
  FuncDef("_total_length", Params("strings"),
    Assign(Name("total"), Int(0))
    Assign(Name("string"), NoneVal)
    For(Name("string"), Name("strings"),
      AugAssign(Name("total"), "+", Call(Name("len"), Name("string"))))
    Return(Name("total")))
  FuncDef("total_match", Params("lst1", "lst2"),
    If(Compare(
      Call(Name("_total_length"), Name("lst1")),
      CmpOp("<=", Call(Name("_total_length"), Name("lst2")))),
      Return(Name("lst1")),
      )
    Return(Name("lst2")))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hI"), Str("Hi"))),
      CmpOp("==", ListExpr(Str("hI"), Str("Hi")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hi"), Str("hi"), Str("admin"), Str("project"))),
      CmpOp("==", ListExpr(Str("hi"), Str("admin")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hI"), Str("hi"), Str("hi"))),
      CmpOp("==", ListExpr(Str("hI"), Str("hi"), Str("hi")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("4")),
        ListExpr(Str("1"), Str("2"), Str("3"), Str("4"), Str("5"))),
      CmpOp("==", ListExpr(Str("4"))))))
