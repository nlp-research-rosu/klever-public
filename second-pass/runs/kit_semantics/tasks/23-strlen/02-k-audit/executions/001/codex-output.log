+            "strlen",
+            Params("string"),
+            Return(Call(Name("len"), (Name("string"), .Exprs))) .Stmts
+          ) .Stmts
+        )
+      )
+      ~> Call(Name("strlen"), (str(iCons(128578, .IntSeq)), .Exprs))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "strlen" |-> closureVal(
+             "string" , .ParamNames,
+             Return(Call(Name("len"), (Name("string"), .Exprs))) .Stmts,
+             0
+           ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
