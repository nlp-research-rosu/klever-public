/bin/bash -lc 'cp /audit-output/evidence/stage3_concrete.py ./stage3_concrete.py
set +e
python3 reference/py2mpy.py stage3_concrete.py > stage3_concrete.mpy
stage3_translate_status=$?
{
  printf '"'COMMAND: python3 reference/py2mpy.py stage3_concrete.py > stage3_concrete.mpy\\n'
  printf 'EXIT_STATUS: %s\\n' \""'$stage3_translate_status"
  printf '"'\\nTRANSLATED_TERM:\\n'
  sed -n '1,220p' stage3_concrete.mpy
} > /audit-output/evidence/stage3_concrete_translation.log
sed -n '1,260p' /audit-output/evidence/stage3_concrete_translation.log
exit \""'$stage3_translate_status"' in /tmp/audit-work/23-strlen
 succeeded in 0ms:
COMMAND: python3 reference/py2mpy.py stage3_concrete.py > stage3_concrete.mpy
EXIT_STATUS: 0

TRANSLATED_TERM:
Module(
  FuncDef("strlen", Params("string"),
    Return(Call(Name("len"), Name("string"))))
  Assert(Compare(Call(Name("strlen"), Str("")), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("strlen"), Str("a")), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("strlen"), Str("abc")), CmpOp("==", Int(3))))
  Assert(Compare(Call(Name("strlen"), Str("a b")), CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("strlen"), Str("0123456789")),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(Name("strlen"), Str("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")),
      CmpOp("==", Int(32)))))

diff --git a/evidence/stage1_integrity.py b/evidence/stage1_integrity.py
