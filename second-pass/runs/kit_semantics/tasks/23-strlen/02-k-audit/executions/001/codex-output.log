+        => "strlen" |-> closureVal(
+             "string" , .ParamNames,
+             Return(Call(Name("len"), (Name("string"), .Exprs))) .Stmts,
+             0
+           ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

