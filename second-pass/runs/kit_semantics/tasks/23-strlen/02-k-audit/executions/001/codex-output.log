  printf '"'COMMAND: kast --definition audit-verification-kompiled --input rule --module VERIFICATION --output json stage4_claim_rule.k > /audit-output/evidence/stage4_claim_rule.kast.json\\nEXIT_STATUS: %s\\n' \""'$claim_kast_status"
