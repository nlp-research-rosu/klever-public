--- /dev/null
+++ b/evidence/run_preflight_with_shim.sh
@@ -0,0 +1,8 @@
+#!/bin/sh
+set -eu
+
+gcc -shared -fPIC /audit-output/evidence/procself_readlink_shim.c \
+  -ldl -o /tmp/audit-work/libprocself_readlink.so
+LD_PRELOAD=/tmp/audit-work/libprocself_readlink.so \
+  PYTHONPATH=/reference \
+  python /audit-output/evidence/rerun_preflight.py

exec
/bin/bash -lc "chmod +x /audit-output/evidence/run_preflight_with_shim.sh
script -e -c '/audit-output/evidence/run_preflight_with_shim.sh' /audit-output/evidence/rerun_preflight_reproduced.log" in /audit-output
