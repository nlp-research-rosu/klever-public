diff --git a//tmp/audit-work/procself_readlink_shim.c b//tmp/audit-work/procself_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..20b36111496b873d7e0e83871cdefe8161f6a5d4
--- /dev/null
+++ b//tmp/audit-work/procself_readlink_shim.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    const char *cursor = path;
+    if (strncmp(cursor, "/proc/", 6) == 0) {
+        cursor += 6;
+        const char *digits = cursor;
+        while (isdigit((unsigned char)*cursor)) {
+            cursor++;
+        }
+        if (cursor > digits && strcmp(cursor, "/exe") == 0) {
+            path = "/proc/self/exe";
+        }
+    }
+    return real_readlink(path, buffer, size);
+}
diff --git a//tmp/audit-work/uv_exepath_probe.c b//tmp/audit-work/uv_exepath_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..32758f2f18635e1a1ca1bddbd7e01c4d3b603c5c
--- /dev/null
+++ b//tmp/audit-work/uv_exepath_probe.c
@@ -0,0 +1,22 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+    char direct[PATH_MAX];
+    ssize_t count = readlink("/proc/self/exe", direct, sizeof(direct) - 1);
+    if (count >= 0) direct[count] = '\0';
+    printf("readlink_count=%zd errno=%d path=%s\n", count, errno,
+           count >= 0 ? direct : strerror(errno));
+
+    char via_uv[PATH_MAX];
+    size_t size = sizeof(via_uv);
+    int code = uv_exepath(via_uv, &size);
+    printf("uv_code=%d size=%zu path=%s\n", code, size,
+           code == 0 ? via_uv : "<error>");
+    return code == 0 ? 0 : 1;
+}
