+failed = sorted(name for name, passed in checks.items() if not passed)
+report = {
+    "schema_version": 1,
+    "resolved_input_sha256": resolved_digest,
+    "checks": checks,
+    "failed_checks": failed,
+    "details": details,
+}
+print(json.dumps(report, indent=2, sort_keys=True))
