+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(int argc, char **argv) {
+  char buf[4096];
+  ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+  if (n < 0) {
+    fprintf(stderr, "readlink: %s\n", strerror(errno));
+    return 1;
+  }
+  buf[n] = '\0';
+  printf("argv0=%s\nproc_self_exe=%s\n", argv[0], buf);
+  return 0;
+}
diff --git a//tmp/audit-work/lean_self_exe_shim.c b//tmp/audit-work/lean_self_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..47b88c44cd9cb56b34d1baf65979917937bdc45c
--- /dev/null
+++ b//tmp/audit-work/lean_self_exe_shim.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/auxv.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *restrict path, char *restrict buffer, size_t size) {
+  long requested_pid = -1;
+  char trailing = '\0';
+  if (sscanf(path, "/proc/%ld/exe%c", &requested_pid, &trailing) == 1 &&
+      requested_pid == (long)getpid()) {
+    const char *execfn = (const char *)getauxval(AT_EXECFN);
+    if (execfn == NULL) {
+      errno = ENOENT;
+      return -1;
+    }
+    size_t length = strlen(execfn);
+    size_t copied = length < size ? length : size;
+    memcpy(buffer, execfn, copied);
+    return (ssize_t)copied;
+  }
+  return syscall(SYS_readlink, path, buffer, size);
+}
