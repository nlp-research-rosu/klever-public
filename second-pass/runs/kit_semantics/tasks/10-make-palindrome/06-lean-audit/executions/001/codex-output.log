     2	  FuncDef("is_palindrome", Params("string"),
     3	    Expr(Str("Test if given string is a palindrome."))
     4	    Return(
     5	      Compare(
     6	        Name("string"),
     7	        CmpOp(
     8	          "==",
     9	          Subscript(
    10	            Name("string"),
    11	            Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
    12	  FuncDef("make_palindrome", Params("string"),
    13	    Expr(Str("Return the shortest palindrome that begins with string."))
    14	    Assign(Name("reverse_string"), Str(""))
    15	    Assign(Name("char"), Str(""))
    16	    For(Name("char"), Name("string"),
    17	      Assign(
    18	        Name("reverse_string"),
    19	        BinOp("+", Name("char"), Name("reverse_string"))))
    20	    Assign(Name("prefix"), Str(""))
    21	    Assign(Name("reverse_prefix"), Str(""))
    22	    Assign(
    23	      Name("found"),
    24	      Compare(Name("string"), CmpOp("==", Name("reverse_string"))))
    25	    Assign(
    26	      Name("result"),
    27	      IfExp(
    28	        Name("found"),
    29	        Name("string"),
    30	        BinOp("+", Name("string"), Name("reverse_string"))))
    31	    For(Name("char"), Name("string"),
    32	      If(UnaryOp("not", Name("found")),
    33	        Assign(Name("prefix"), BinOp("+", Name("prefix"), Name("char")))
    34	        Assign(
    35	          Name("reverse_prefix"),
    36	          BinOp("+", Name("char"), Name("reverse_prefix")))
    37	        If(Compare(
    38	          BinOp("+", Name("string"), Name("reverse_prefix")),
    39	          CmpOp(
    40	            "==",
    41	            BinOp("+", Name("prefix"), Name("reverse_string")))),
    42	          Assign(
    43	            Name("result"),
    44	            BinOp("+", Name("string"), Name("reverse_prefix")))
    45	          Assign(Name("found"), Bool(true)),
    46	          ),
    47	        ))
    48	    Return(Name("result"))))
