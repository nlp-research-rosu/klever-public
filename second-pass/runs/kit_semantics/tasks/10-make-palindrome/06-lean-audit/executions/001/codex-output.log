     1	def is_palindrome(string: str) -> bool:
     2	    """Test if given string is a palindrome."""
     3	    return string == string[::-1]
     4	
     5	
     6	def make_palindrome(string: str) -> str:
     7	    """Return the shortest palindrome that begins with string."""
     8	    reverse_string = ""
     9	    char = ""
    10	    for char in string:
    11	        reverse_string = char + reverse_string
    12	
    13	    prefix = ""
    14	    reverse_prefix = ""
    15	    found = string == reverse_string
    16	    result = string if found else string + reverse_string
    17	
    18	    for char in string:
    19	        if not found:
    20	            prefix = prefix + char
    21	            reverse_prefix = char + reverse_prefix
    22	            if string + reverse_prefix == prefix + reverse_string:
    23	                result = string + reverse_prefix
    24	                found = True
    25	
    26	    return result
