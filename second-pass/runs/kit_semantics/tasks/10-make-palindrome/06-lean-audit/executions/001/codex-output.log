      "normalized_sha256": "164bf3f22b483d6e3e5cddb2170e3e764abf2d1712660583980778c1b221404d",
      "rationale": "Macro expansion naming the exact is_palindrome statement body as an MPY AST term; it defines a named proof term and does not replace execution.",
      "source_rule_id": "rule-164bf3f22b483d6e3e5cddb2170e3e764abf2d1712660583980778c1b221404d",
      "start_line": 29,
      "text": "  rule isPalindromeBody\n    => Expr(Str(\"Test if given string is a palindrome.\"))\n       Return(\n         Compare(\n           Name(\"string\"),\n           CmpOp(\n             \"==\",\n             Subscript(\n               Name(\"string\"),\n               Slice(NoBound, NoBound, UnaryOp(\"-\", Int(1)))))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "863b8902176feff6d512de42846538b0f25b3a15476e7ef9b694414144e96117",
      "rationale": "Macro expansion naming the exact reverse-loop assignment AST; it is a structural abbreviation consumed by ordinary MPY loop execution.",
      "source_rule_id": "rule-863b8902176feff6d512de42846538b0f25b3a15476e7ef9b694414144e96117",
      "start_line": 40,
      "text": "  rule reverseLoopBody\n    => Assign(\n         Name(\"reverse_string\"),\n         BinOp(\"+\", Name(\"char\"), Name(\"reverse_string\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 65,
      "module": "VERIFICATION",
      "normalized_sha256": "cddfef53d40182cb89704eca062582bd63b7ed8afa7d1852d4889e5442c5162b",
      "rationale": "Macro expansion naming the exact search-loop conditional and assignments as an AST term; it defines the body rather than an operational shortcut.",
      "source_rule_id": "rule-cddfef53d40182cb89704eca062582bd63b7ed8afa7d1852d4889e5442c5162b",
      "start_line": 45,
      "text": "  rule searchLoopBody\n    => If(\n         UnaryOp(\"not\", Name(\"found\")),\n         Assign(\n           Name(\"prefix\"),\n           BinOp(\"+\", Name(\"prefix\"), Name(\"char\")))\n         Assign(\n           Name(\"reverse_prefix\"),\n           BinOp(\"+\", Name(\"char\"), Name(\"reverse_prefix\")))\n         If(\n           Compare(\n             BinOp(\"+\", Name(\"string\"), Name(\"reverse_prefix\")),\n             CmpOp(\n               \"==\",\n               BinOp(\"+\", Name(\"prefix\"), Name(\"reverse_string\")))),\n           Assign(\n             Name(\"result\"),\n             BinOp(\"+\", Name(\"string\"), Name(\"reverse_prefix\")))\n           Assign(Name(\"found\"), Bool(true)),\n           .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 84,
      "module": "VERIFICATION",
      "normalized_sha256": "c7027bcdf2e016cd33b1f8bb8fb635d9d401fbbd82f2636ee15acd9a89f692a8",
      "rationale": "Macro expansion naming the exact make_palindrome function body AST, including both loops and the return; fixed MPY rules execute the expanded body.",
      "source_rule_id": "rule-c7027bcdf2e016cd33b1f8bb8fb635d9d401fbbd82f2636ee15acd9a89f692a8",
      "start_line": 67,
      "text": "  rule makePalindromeBody\n    => Expr(Str(\"Return the shortest palindrome that begins with string.\"))\n       Assign(Name(\"reverse_string\"), Str(\"\"))\n       Assign(Name(\"char\"), Str(\"\"))\n       For(Name(\"char\"), Name(\"string\"), reverseLoopBody)\n       Assign(Name(\"prefix\"), Str(\"\"))\n       Assign(Name(\"reverse_prefix\"), Str(\"\"))\n       Assign(\n         Name(\"found\"),\n         Compare(Name(\"string\"), CmpOp(\"==\", Name(\"reverse_string\"))))\n       Assign(\n         Name(\"result\"),\n         IfExp(\n           Name(\"found\"),\n           Name(\"string\"),\n           BinOp(\"+\", Name(\"string\"), Name(\"reverse_string\"))))\n       For(Name(\"char\"), Name(\"string\"), searchLoopBody)\n       Return(Name(\"result\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 90,
      "module": "VERIFICATION",
      "normalized_sha256": "8b581a01122ab6df874eba355074a294f619cf6b685af9e2b458235741a4e853",
      "rationale": "Macro expansion defining the is_palindrome closure value from its parameter list, exact body term, and parent scope.",
      "source_rule_id": "rule-8b581a01122ab6df874eba355074a294f619cf6b685af9e2b458235741a4e853",
      "start_line": 86,
      "text": "  rule isPalindromeClosure\n    => closureVal(\n         (\"string\", .ParamNames),\n         isPalindromeBody,\n         0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 96,
      "module": "VERIFICATION",
      "normalized_sha256": "b6a5e4d018419efc0a187ab9344b4b7738058b4f7aacd856baa698459ae2600c",
      "rationale": "Macro expansion defining the make_palindrome closure value from its parameter list, exact body term, and parent scope.",
      "source_rule_id": "rule-b6a5e4d018419efc0a187ab9344b4b7738058b4f7aacd856baa698459ae2600c",
      "start_line": 92,
      "text": "  rule makePalindromeClosure\n    => closureVal(\n         (\"string\", .ParamNames),\n         makePalindromeBody,\n         0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 107,
      "module": "VERIFICATION",
      "normalized_sha256": "dbfdd30938d6cf96a13cafdb6acbffee2678949b6f33ddd79cf8ac9032b648ef",
      "rationale": "Macro expansion defining the solution module AST containing the two exact function definitions; module loading remains governed by MPY semantics.",
      "source_rule_id": "rule-dbfdd30938d6cf96a13cafdb6acbffee2678949b6f33ddd79cf8ac9032b648ef",
      "start_line": 98,
      "text": "  rule solutionModule\n    => Module(\n         FuncDef(\n           \"is_palindrome\",\n           Params(\"string\", .ParamNames),\n           isPalindromeBody)\n         FuncDef(\n           \"make_palindrome\",\n           Params(\"string\", .ParamNames),\n           makePalindromeBody))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 109,
      "module": "VERIFICATION",
      "normalized_sha256": "abe360a10bb0df260fdc944ef9561825e3638fafaadcb0d82b50f7c7aa534c94",
      "rationale": "Base equation for the reverseAcc mathematical summary: reversing an empty remainder returns the accumulator.",
      "source_rule_id": "rule-abe360a10bb0df260fdc944ef9561825e3638fafaadcb0d82b50f7c7aa534c94",
      "start_line": 109,
      "text": "  rule reverseAcc(.IntSeq, A:IntSeq) => A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 111,
      "module": "VERIFICATION",
      "normalized_sha256": "ec18b8a14ce996822bd721f96d291178d2254755a51676c9886bebcc56244c24",
      "rationale": "Structurally decreasing recurrence for reverseAcc that moves the input head onto the accumulator and recurses on the tail.",
      "source_rule_id": "rule-ec18b8a14ce996822bd721f96d291178d2254755a51676c9886bebcc56244c24",
      "start_line": 110,
      "text": "  rule reverseAcc(iCons(C:Int, R:IntSeq), A:IntSeq)\n    => reverseAcc(R, iCons(C, A))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 114,
      "module": "VERIFICATION",
      "normalized_sha256": "9508497d5b6869f10d2b9cbb7c5e63ecb16ab1598c153eef2ab631bac2abc4e2",
      "rationale": "Equation defining the palIS summary as equality between a sequence and its reverseAcc reversal.",
      "source_rule_id": "rule-9508497d5b6869f10d2b9cbb7c5e63ecb16ab1598c153eef2ab631bac2abc4e2",
      "start_line": 113,
      "text": "  rule palIS(S:IntSeq)\n    => S ==K reverseAcc(S, .IntSeq)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 117,
      "module": "VERIFICATION",
      "normalized_sha256": "98d164a964469ba2c0327091215381c133d8dad66d196528fc426012346c21e9",
      "rationale": "Guarded equation defining seedResult for palindromic inputs by returning the input sequence unchanged.",
      "source_rule_id": "rule-98d164a964469ba2c0327091215381c133d8dad66d196528fc426012346c21e9",
      "start_line": 116,
      "text": "  rule seedResult(S:IntSeq) => S\n    requires palIS(S)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 120,
      "module": "VERIFICATION",
      "normalized_sha256": "06fe831599a6562f9e5ef176f545a6f7443342c9a9ac3c42824d27adec3d18b6",
      "rationale": "Complementary guarded equation defining seedResult for non-palindromic inputs as the input concatenated with its reversal.",
      "source_rule_id": "rule-06fe831599a6562f9e5ef176f545a6f7443342c9a9ac3c42824d27adec3d18b6",
      "start_line": 118,
      "text": "  rule seedResult(S:IntSeq)\n    => seqConcat(S, reverseAcc(S, .IntSeq))\n    requires notBool palIS(S)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 125,
      "module": "VERIFICATION",
      "normalized_sha256": "532eef03c35c023e23162ede04edf49b372877d70ad71cb5f5961d2e9553fbaf",
      "rationale": "Base equation for the searchResult summary: once found is true, the accumulated result is retained.",
      "source_rule_id": "rule-532eef03c35c023e23162ede04edf49b372877d70ad71cb5f5961d2e9553fbaf",
      "start_line": 122,
      "text": "  rule searchResult(\n         _:IntSeq, _:IntSeq, _:IntSeq, _:IntSeq,\n         _:IntSeq, true, RESULT:IntSeq)\n    => RESULT"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 129,
      "module": "VERIFICATION",
      "normalized_sha256": "533620ae11e6480779af7880bd89a4f20a6a9fb590c128ea053dfded2464f5b3",
      "rationale": "Base equation for the searchResult summary: exhaustion of the remaining sequence returns the accumulated result.",
      "source_rule_id": "rule-533620ae11e6480779af7880bd89a4f20a6a9fb590c128ea053dfded2464f5b3",
      "start_line": 126,
      "text": "  rule searchResult(\n         _:IntSeq, .IntSeq, _:IntSeq, _:IntSeq,\n         _:IntSeq, _:Bool, RESULT:IntSeq)\n    => RESULT"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 148,
      "module": "VERIFICATION",
      "normalized_sha256": "c4e89d104cd26a8936bb72a3ed5284209ed914e1db1a420e6a0bcffb29143a99",
      "rationale": "Structurally decreasing recurrence defining one false-found searchResult step, with the source equality selecting a candidate or recursion on the tail.",
      "source_rule_id": "rule-c4e89d104cd26a8936bb72a3ed5284209ed914e1db1a420e6a0bcffb29143a99",
      "start_line": 130,
      "text": "  rule searchResult(\n         S:IntSeq, iCons(C:Int, R:IntSeq), P:IntSeq, RP:IntSeq,\n         REV:IntSeq, false, RESULT:IntSeq)\n    => #if\n         seqConcat(seqConcat(P, iCons(C, .IntSeq)), REV)\n         ==K\n         seqConcat(S, iCons(C, RP))\n       #then\n         seqConcat(S, iCons(C, RP))\n       #else\n         searchResult(\n           S,\n           R,\n           seqConcat(P, iCons(C, .IntSeq)),\n           iCons(C, RP),\n           REV,\n           false,\n           RESULT)\n       #fi"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 158,
      "module": "VERIFICATION",
      "normalized_sha256": "0f34934a7976172c6d2777019a71b4e5fbf9b5af2039a4e57c76f102d93de3c3",
      "rationale": "Equation defining completePal by initializing the searchResult summary with the input, empty prefixes, its reversal, palindrome status, and seed result.",
      "source_rule_id": "rule-0f34934a7976172c6d2777019a71b4e5fbf9b5af2039a4e57c76f102d93de3c3",
      "start_line": 150,
      "text": "  rule completePal(S:IntSeq)\n    => searchResult(\n         S,\n         S,\n         .IntSeq,\n         .IntSeq,\n         reverseAcc(S, .IntSeq),\n         palIS(S),\n         seedResult(S))"
    }
