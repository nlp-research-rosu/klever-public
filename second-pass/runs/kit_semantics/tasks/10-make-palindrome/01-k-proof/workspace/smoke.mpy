Module(
  FuncDef("is_palindrome", Params("string"),
    Return(
      Compare(
        Name("string"),
        CmpOp(
          "==",
          Subscript(
            Name("string"),
            Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
  FuncDef("make_palindrome", Params("string"),
    Assign(Name("reverse_string"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("string"),
      Assign(
        Name("reverse_string"),
        BinOp("+", Name("char"), Name("reverse_string"))))
    Assign(Name("prefix"), Str(""))
    Assign(Name("reverse_prefix"), Str(""))
    Assign(
      Name("found"),
      Compare(Name("string"), CmpOp("==", Name("reverse_string"))))
    Assign(
      Name("result"),
      IfExp(
        Name("found"),
        Name("string"),
        BinOp("+", Name("string"), Name("reverse_string"))))
    For(Name("char"), Name("string"),
      If(UnaryOp("not", Name("found")),
        Assign(Name("prefix"), BinOp("+", Name("prefix"), Name("char")))
        Assign(
          Name("reverse_prefix"),
          BinOp("+", Name("char"), Name("reverse_prefix")))
        If(Compare(
          BinOp("+", Name("string"), Name("reverse_prefix")),
          CmpOp(
            "==",
            BinOp("+", Name("prefix"), Name("reverse_string")))),
          Assign(
            Name("result"),
            BinOp("+", Name("string"), Name("reverse_prefix")))
          Assign(Name("found"), Bool(true)),
          ),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("make_palindrome"), Str("")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("make_palindrome"), Str("cat")),
      CmpOp("==", Str("catac"))))
  Assert(
    Compare(
      Call(Name("make_palindrome"), Str("cata")),
      CmpOp("==", Str("catac"))))
  Assert(
    Compare(
      Call(Name("make_palindrome"), Str("race")),
      CmpOp("==", Str("racecar"))))
  Assert(
    Compare(
      Call(Name("make_palindrome"), Str("abba")),
      CmpOp("==", Str("abba")))))
