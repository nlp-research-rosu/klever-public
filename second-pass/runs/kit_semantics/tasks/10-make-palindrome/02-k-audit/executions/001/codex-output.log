+           Name("make_palindrome"),
+           (str(iCons(99, iCons(97, iCons(116, .IntSeq)))), .Exprs))
+      =>
+      str(iCons(99, iCons(97, iCons(116, iCons(97, iCons(98, .IntSeq))))))
+    </k>
+    <env> 0 </env>
