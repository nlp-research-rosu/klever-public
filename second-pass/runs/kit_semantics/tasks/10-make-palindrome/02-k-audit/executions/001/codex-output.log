     3	module VERIFICATION-SYNTAX
     4	  imports MPY-SYNTAX
     5	  imports BOOL-SYNTAX
     6	
     7	  syntax Stmts ::= "isPalindromeBody" [macro]
     8	                 | "makePalindromeBody" [macro]
     9	                 | "reverseLoopBody" [macro]
    10	                 | "searchLoopBody" [macro]
    11	  syntax Val ::= "isPalindromeClosure" [macro]
    12	               | "makePalindromeClosure" [macro]
    13	  syntax Module ::= "solutionModule" [macro]
    14	
    15	  syntax IntSeq ::= reverseAcc(IntSeq, IntSeq) [function, total]
    16	                   | seedResult(IntSeq) [function, total]
    17	                   | searchResult(
    18	                       IntSeq, IntSeq, IntSeq, IntSeq,
    19	                       IntSeq, Bool, IntSeq) [function, total]
    20	                   | completePal(IntSeq) [function, total]
    21	  syntax Bool ::= palIS(IntSeq) [function, total]
    22	endmodule
    23	
    24	module VERIFICATION
    25	  imports VERIFICATION-SYNTAX
    26	  imports MPY
    27	  imports K-EQUAL
    28	
    29	  rule isPalindromeBody
    30	    => Expr(Str("Test if given string is a palindrome."))
    31	       Return(
    32	         Compare(
    33	           Name("string"),
    34	           CmpOp(
    35	             "==",
    36	             Subscript(
    37	               Name("string"),
    38	               Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))))
    39	
    40	  rule reverseLoopBody
    41	    => Assign(
    42	         Name("reverse_string"),
    43	         BinOp("+", Name("char"), Name("reverse_string")))
    44	
    45	  rule searchLoopBody
    46	    => If(
    47	         UnaryOp("not", Name("found")),
    48	         Assign(
    49	           Name("prefix"),
    50	           BinOp("+", Name("prefix"), Name("char")))
    51	         Assign(
    52	           Name("reverse_prefix"),
    53	           BinOp("+", Name("char"), Name("reverse_prefix")))
    54	         If(
    55	           Compare(
    56	             BinOp("+", Name("string"), Name("reverse_prefix")),
    57	             CmpOp(
    58	               "==",
    59	               BinOp("+", Name("prefix"), Name("reverse_string")))),
    60	           Assign(
    61	             Name("result"),
    62	             BinOp("+", Name("string"), Name("reverse_prefix")))
    63	           Assign(Name("found"), Bool(true)),
    64	           .Stmts),
    65	         .Stmts)
    66	
    67	  rule makePalindromeBody
    68	    => Expr(Str("Return the shortest palindrome that begins with string."))
    69	       Assign(Name("reverse_string"), Str(""))
    70	       Assign(Name("char"), Str(""))
    71	       For(Name("char"), Name("string"), reverseLoopBody)
    72	       Assign(Name("prefix"), Str(""))
    73	       Assign(Name("reverse_prefix"), Str(""))
    74	       Assign(
    75	         Name("found"),
    76	         Compare(Name("string"), CmpOp("==", Name("reverse_string"))))
    77	       Assign(
    78	         Name("result"),
    79	         IfExp(
    80	           Name("found"),
    81	           Name("string"),
    82	           BinOp("+", Name("string"), Name("reverse_string"))))
    83	       For(Name("char"), Name("string"), searchLoopBody)
    84	       Return(Name("result"))
    85	
    86	  rule isPalindromeClosure
    87	    => closureVal(
    88	         ("string", .ParamNames),
    89	         isPalindromeBody,
    90	         0)
    91	
    92	  rule makePalindromeClosure
    93	    => closureVal(
    94	         ("string", .ParamNames),
    95	         makePalindromeBody,
    96	         0)
    97	
    98	  rule solutionModule
    99	    => Module(
   100	         FuncDef(
   101	           "is_palindrome",
   102	           Params("string", .ParamNames),
   103	           isPalindromeBody)
   104	         FuncDef(
   105	           "make_palindrome",
   106	           Params("string", .ParamNames),
   107	           makePalindromeBody))
   108	
   109	  rule reverseAcc(.IntSeq, A:IntSeq) => A
   110	  rule reverseAcc(iCons(C:Int, R:IntSeq), A:IntSeq)
   111	    => reverseAcc(R, iCons(C, A))
   112	
   113	  rule palIS(S:IntSeq)
   114	    => S ==K reverseAcc(S, .IntSeq)
   115	
   116	  rule seedResult(S:IntSeq) => S
   117	    requires palIS(S)
   118	  rule seedResult(S:IntSeq)
   119	    => seqConcat(S, reverseAcc(S, .IntSeq))
   120	    requires notBool palIS(S)
   121	
   122	  rule searchResult(
   123	         _:IntSeq, _:IntSeq, _:IntSeq, _:IntSeq,
   124	         _:IntSeq, true, RESULT:IntSeq)
   125	    => RESULT
   126	  rule searchResult(
   127	         _:IntSeq, .IntSeq, _:IntSeq, _:IntSeq,
   128	         _:IntSeq, _:Bool, RESULT:IntSeq)
   129	    => RESULT
   130	  rule searchResult(
   131	         S:IntSeq, iCons(C:Int, R:IntSeq), P:IntSeq, RP:IntSeq,
   132	         REV:IntSeq, false, RESULT:IntSeq)
   133	    => #if
   134	         seqConcat(seqConcat(P, iCons(C, .IntSeq)), REV)
   135	         ==K
   136	         seqConcat(S, iCons(C, RP))
   137	       #then
   138	         seqConcat(S, iCons(C, RP))
   139	       #else
   140	         searchResult(
   141	           S,
   142	           R,
   143	           seqConcat(P, iCons(C, .IntSeq)),
   144	           iCons(C, RP),
   145	           REV,
   146	           false,
   147	           RESULT)
   148	       #fi
   149	
   150	  rule completePal(S:IntSeq)
   151	    => searchResult(
   152	         S,
   153	         S,
   154	         .IntSeq,
   155	         .IntSeq,
   156	         reverseAcc(S, .IntSeq),
   157	         palIS(S),
   158	         seedResult(S))
   159	endmodule
