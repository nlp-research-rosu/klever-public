diff --git a/evidence/stage5_body_sensitivity.sh b/evidence/stage5_body_sensitivity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a20b027e54ee17c5f9b873e60cde0b8d9b64b2e8
--- /dev/null
+++ b/evidence/stage5_body_sensitivity.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+work=/tmp/audit-work/candidate-clean
+evidence=/audit-output/evidence
+
