Module ( FuncDef ( "is_palindrome" , Params ( "string" , .ParamNames ) , Expr ( Str ( "Test if given string is a palindrome." ) )  Return ( Compare ( Name ( "string" ) , CmpOp ( "==" , Subscript ( Name ( "string" ) , Slice ( NoBound , NoBound , UnaryOp ( "-" , Int ( 1 ) ) ) ) ) ) )  .Stmts )  FuncDef ( "make_palindrome" , Params ( "string" , .ParamNames ) , Expr ( Str ( "Return the shortest palindrome that begins with string." ) )  Assign ( Name ( "reverse_string" ) , Str ( "" ) )  Assign ( Name ( "char" ) , Str ( "" ) )  For ( Name ( "char" ) , Name ( "string" ) , Assign ( Name ( "reverse_string" ) , BinOp ( "+" , Name ( "char" ) , Name ( "reverse_string" ) ) )  .Stmts )  Assign ( Name ( "prefix" ) , Str ( "" ) )  Assign ( Name ( "reverse_prefix" ) , Str ( "" ) )  Assign ( Name ( "found" ) , Compare ( Name ( "string" ) , CmpOp ( "==" , Name ( "reverse_string" ) ) ) )  Assign ( Name ( "result" ) , IfExp ( Name ( "found" ) , Name ( "string" ) , BinOp ( "+" , Name ( "string" ) , Name ( "reverse_string" ) ) ) )  For ( Name ( "char" ) , Name ( "string" ) , If ( UnaryOp ( "not" , Name ( "found" ) ) , Assign ( Name ( "prefix" ) , BinOp ( "+" , Name ( "prefix" ) , Name ( "char" ) ) )  Assign ( Name ( "reverse_prefix" ) , BinOp ( "+" , Name ( "char" ) , Name ( "reverse_prefix" ) ) )  If ( Compare ( BinOp ( "+" , Name ( "string" ) , Name ( "reverse_prefix" ) ) , CmpOp ( "==" , BinOp ( "+" , Name ( "prefix" ) , Name ( "reverse_string" ) ) ) ) , Assign ( Name ( "result" ) , BinOp ( "+" , Name ( "string" ) , Name ( "reverse_prefix" ) ) )  Assign ( Name ( "found" ) , Bool ( true ) )  .Stmts , .Stmts )  .Stmts , .Stmts )  .Stmts )  Return ( Name ( "result" ) )  .Stmts )  .Stmts )
