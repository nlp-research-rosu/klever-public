+      "classification": "DOMAIN_LEMMA",
+      "rationale": "Additional one-step exit-boundary simplifier deriving result B when the next prime-bit update reaches the target; its exact statement is not separately proved without this rule."
+    },
+    {
+      "source_rule_id": "rule-88229ce3ed2cdd6dfe0c0cedf0411c4b335071c8bc4cd37ed184c0b6a9feaa02",
+      "classification": "DEFINITION",
+      "rationale": "Inductive recurrence equation for primeFibSearch, oriented to fold the updated count and Fibonacci state back to the current summary."
+    }
+  ]
+}

