/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv = json.load(open('/reference/rule-inventory.json'))
out = json.load(open('/workspace/trust-boundary.json'))
allowed = {'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inv['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == len(inv['rules'])
classes = {}
for got, src in zip(out['rules'], inv['rules']):
    assert list(got) == ['source_rule_id', 'classification', 'rationale']
    assert got['classification'] in allowed
    assert isinstance(got['rationale'], str) and got['rationale'].strip()
    if 'simplification' in src['attributes']:
        assert got['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
    classes[got['source_rule_id']] = got['classification']
print('validated rules:', len(out['rules']))
print('inventory order exact: yes')
print('unique IDs:', len(set(classes)))
print('class counts:', dict(Counter(classes.values())))
print('inventory_sha256:', out['inventory_sha256'])
PY
