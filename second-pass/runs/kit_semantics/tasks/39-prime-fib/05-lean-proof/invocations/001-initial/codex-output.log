from pathlib import Path
import json, re
root=Path('/workspace')
files=[p for p in root.rglob('*.lean') if 'Base' not in p.parts and '.lake' not in p.parts]
text='\\n'.join(p.read_text() for p in files)
with open(root/'Base/obligation-map.json') as f:
    names=[x['name'] for x in json.load(f)['trust_parameters']]
for name in names:
    plain=name[1:-1] if name.startswith('«') and name.endswith('»') else name
    count=sum(len(re.findall(rf'(?m)"'^'"\\s*(?:noncomputable\\s+)?def\\s+{re.escape(form)}(?:\\s|\\()', text)) for form in (plain, '«'+plain+'»'))
    print(f'{name}: def_count={count}')
for path in files:
    src=path.read_text()
    for match in re.finditer(r'(?m)"'^'"\\s*(?:axiom|opaque)\\b|\\b(?:sorry|admit|unsafe)\\b', src):
        print('FORBIDDEN', path, src.count('\\n', 0, match.start()) + 1, match.group(0))
PY
