+        d += 1
+    return flag
+
+
+def candidate_scan_port(a: int, d: int, flag: bool) -> bool:
+    if d < 2:
+        return False
+    if not flag:
+        return False
+    fuel = max(a, 0) + 1
+    while fuel:
+        if d * d > a:
+            return True
+        if py_mod(a, d) == 0:
+            return False
+        d += 1
+        fuel -= 1
+    return True  # Exact port of runPrimeDivisorScan's zero-fuel branch.
+
+
