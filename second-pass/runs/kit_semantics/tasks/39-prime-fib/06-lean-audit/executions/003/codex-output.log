+import Proof
+
+open Klean39PrimeFib.Lemmas
+
+namespace AuditOperational
+
+abbrev scan :=
+  Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+
+noncomputable abbrev search :=
+  Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+
+-- Primitive-hook boundary and negative-integer adversarial checks.
+example : Proof._andBool_ true false = false := rfl
+example : Proof._andBool_ true true = true := rfl
+example : Proof.notBool_ false = true := rfl
+example : Proof.«_>=Int_» (-3) (-4) = true := rfl
+example : Proof.«_<Int_» (-4) (-3) = true := rfl
+example : Proof.«_+Int_» (-7) 3 = -4 := rfl
+
+-- Trial-division boundaries, composites, primes, and an already-false flag.
+example : scan (-3) 2 true = true := rfl
+example : scan 1 2 true = true := rfl
+example : scan 2 2 true = true := rfl
+example : scan 4 2 true = false := rfl
+example : scan 5 2 true = true := rfl
+example : scan 9 2 true = false := rfl
+example : scan 25 2 true = false := rfl
+example : scan 49 2 true = false := rfl
+example : scan 97 2 true = true := rfl
+example : scan 97 3 false = false := rfl
+
+-- Exact search base and one-step exit boundary used by the fixed obligation.
+example : search 3 3 5 8 = 5 := rfl
+example : search 1 0 0 2 = 2 := rfl
+example :
+    Proof._andBool_
+      (Proof._andBool_
+        (Proof._andBool_ (Proof.«_>=Int_» 1 1) (Proof.«_<Int_» 0 1))
+        (Proof.notBool_
+          (Proof.«_<Int_»
+            (Proof.«_+Int_» 0 (kite (scan 2 2 (Proof.«_>=Int_» 2 2)) 1 0))
+            1)))
+      (Proof.«_>=Int_» 2 1) = true := rfl
+
+end AuditOperational
