+import Klean39PrimeFib.Lemmas
+
+namespace AuditCounterfactual
+
+def andBool (x y : SortBool) : SortBool := x && y
+def geInt (x y : SortInt) : SortBool := decide (x ≥ y)
+def ltInt (x y : SortInt) : SortBool := decide (x < y)
+def addInt (x y : SortInt) : SortInt := x + y
+def boolNot (x : SortBool) : SortBool := !x
+
+-- Deliberately operationally false shortcuts. Their provability demonstrates
+-- why the immutable equation alone is not an operational-bridge check.
+def constantScan (_a _d : SortInt) (_p : SortBool) : SortBool := false
+def projectionSearch (_n _c _a b : SortInt) : SortInt := b
+
+theorem shortcutStillProvesGeneratedTarget :
+    Klean39PrimeFib.Lemmas.targetStatement
+      andBool geInt ltInt addInt boolNot projectionSearch constantScan := by
+  constructor
+  · intro d a h
+    rfl
+  · intro b a c n h
+    rfl
+
+end AuditCounterfactual
