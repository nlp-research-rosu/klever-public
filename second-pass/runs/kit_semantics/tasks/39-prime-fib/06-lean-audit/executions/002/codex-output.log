+    (k : SortInt) (hk : 1 ≤ k) : candidatePrimeIncrement (4 * k) = 0 := by
+  change (1 : Int) ≤ k at hk
+  have h2 : (2 : Int) ≤ 4 * k := by omega
+  have h4 : ¬(4 * k : Int) < 4 := by omega
+  have hmod : (4 * k : Int) % 2 = 0 := by omega
