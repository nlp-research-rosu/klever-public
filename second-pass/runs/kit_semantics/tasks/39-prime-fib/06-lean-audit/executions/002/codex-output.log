+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn real_readlink;
+  if (!real_readlink)
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  size_t n = strlen(path);
+  if (n > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + n - 4, "/exe") == 0)
+    path = "/proc/self/exe";
+  return real_readlink(path, buf, size);
+}
diff --git a//tmp/audit-work/test_app.c b//tmp/audit-work/test_app.c
new file mode 100644
index 0000000000000000000000000000000000000000..cfdb110047b86d65d0f03de12411543d3be914f6
--- /dev/null
+++ b//tmp/audit-work/test_app.c
@@ -0,0 +1,15 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096] = {0};
+  char out[4096] = {0};
+  snprintf(path, sizeof(path), "/proc/%d/exe", getpid());
+  ssize_t n = readlink(path, out, sizeof(out));
+  printf("pid=%d path=%s n=%zd errno=%d %s out=%s\n", getpid(), path, n,
+         errno, strerror(errno), out);
+  return n < 0;
+}
