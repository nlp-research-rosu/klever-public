+print("TARGET", json.dumps(observed_target, indent=2, sort_keys=True))
+print("EXPECTED_TARGET_DEFINITION")
+print(expected_definition)
+print("FIXED_TARGET_IDENTITY", "PASS")
+print("NONVACUITY_WITNESS_1", "D=2, A=4; 2 >= 2 is true")
+print(
