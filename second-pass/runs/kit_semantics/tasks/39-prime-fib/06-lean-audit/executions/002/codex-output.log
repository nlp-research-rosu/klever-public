+private def multipleFourState (state : FibonacciSearchState) : Prop :=
+  state.count = 0 ∧
+    ∃ ka : Int, 1 ≤ ka ∧ state.a = 4 * ka ∧
+    ∃ kb : Int, 1 ≤ kb ∧ state.b = 4 * kb
