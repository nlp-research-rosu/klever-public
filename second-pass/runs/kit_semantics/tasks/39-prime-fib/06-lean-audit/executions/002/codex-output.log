+  induction steps generalizing state with
+  | zero => simpa [iterateFibonacciSearch]
+  | succ steps ih =>
+      simp only [iterateFibonacciSearch]
+      exact ih (stepFibonacciSearch state)
+        (step_preserves_multiple_four state h)
