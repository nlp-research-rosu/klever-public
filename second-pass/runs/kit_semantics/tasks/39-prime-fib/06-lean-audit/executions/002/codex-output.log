      "end_line": 75,
      "module": "VERIFICATION",
      "normalized_sha256": "2eeee8218fa0f1ab3abdeb706b12f9b9c5caa3732a3901edbab9195bf216b5c7",
      "rationale": "Macro expansion defining the named primeFibOuter source-level Fibonacci-search while statement.",
      "source_rule_id": "rule-2eeee8218fa0f1ab3abdeb706b12f9b9c5caa3732a3901edbab9195bf216b5c7",
      "start_line": 59,
      "text": "  rule primeFibOuter\n    => While(\n         Compare(Name(\"count\"), CmpOp(\"<\", Name(\"n\"))),\n         Assign(\n           Name(\"next_value\"),\n           BinOp(\"+\", Name(\"a\"), Name(\"b\")))\n         Assign(Name(\"a\"), Name(\"b\"))\n         Assign(Name(\"b\"), Name(\"next_value\"))\n         Assign(Name(\"divisor\"), Int(2))\n         Assign(\n           Name(\"is_prime\"),\n           Compare(Name(\"a\"), CmpOp(\">=\", Int(2))))\n         primeFibInner\n         Assign(\n           Name(\"count\"),\n           BinOp(\"+\", Name(\"count\"), Name(\"is_prime\")))\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 93,
      "module": "VERIFICATION",
      "normalized_sha256": "557c59673423be46fad688ff932860ebe8ffbf6a93b9b76798d9917cbf431255",
      "rationale": "Macro expansion defining the named primeFibOuterCore proof term as the corresponding internal #while loop head.",
      "source_rule_id": "rule-557c59673423be46fad688ff932860ebe8ffbf6a93b9b76798d9917cbf431255",
      "start_line": 77,
      "text": "  rule primeFibOuterCore\n    => #while(\n         Compare(Name(\"count\"), CmpOp(\"<\", Name(\"n\"))),\n         Assign(\n           Name(\"next_value\"),\n           BinOp(\"+\", Name(\"a\"), Name(\"b\")))\n         Assign(Name(\"a\"), Name(\"b\"))\n         Assign(Name(\"b\"), Name(\"next_value\"))\n         Assign(Name(\"divisor\"), Int(2))\n         Assign(\n           Name(\"is_prime\"),\n           Compare(Name(\"a\"), CmpOp(\">=\", Int(2))))\n         primeFibInner\n         Assign(\n           Name(\"count\"),\n           BinOp(\"+\", Name(\"count\"), Name(\"is_prime\")))\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 104,
      "module": "VERIFICATION",
      "normalized_sha256": "42b12587f50eda8ad9a9526c55e96494f2ebf4b50034495a0c8bc4fd6fd8abc4",
      "rationale": "Macro expansion defining primeFibBody as the exact initialization, outer loop, and return constructor sequence.",
      "source_rule_id": "rule-42b12587f50eda8ad9a9526c55e96494f2ebf4b50034495a0c8bc4fd6fd8abc4",
      "start_line": 95,
      "text": "  rule primeFibBody\n    => Assign(Name(\"a\"), Int(0))\n       Assign(Name(\"b\"), Int(1))\n       Assign(Name(\"count\"), Int(0))\n       Assign(Name(\"next_value\"), Int(0))\n       Assign(Name(\"divisor\"), Int(2))\n       Assign(Name(\"is_prime\"), Bool(false))\n       primeFibOuter\n       Return(Name(\"a\"))\n       .Stmts"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 110,
      "module": "VERIFICATION",
      "normalized_sha256": "ed39697ae845fca5c3929cc19f202f89ba72c9d726de3189a7db0165f7d66247",
      "rationale": "Base equation of the primeScan summary: when the next divisor exceeds the square-root bound, the incoming flag is the scan result.",
      "source_rule_id": "rule-ed39697ae845fca5c3929cc19f202f89ba72c9d726de3189a7db0165f7d66247",
      "start_line": 108,
      "text": "  rule primeScan(A, D, P) => P\n    requires D >=Int 2 andBool D *Int D >Int A\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 115,
      "module": "VERIFICATION",
      "normalized_sha256": "3b0d654a52c07f36a2c8e03ab9a42adb2fbab342d609dc7963241a2fd2dd5c7f",
      "rationale": "Divisor case of the primeScan recurrence: a divisor within the scan bound defines the result to be false.",
      "source_rule_id": "rule-3b0d654a52c07f36a2c8e03ab9a42adb2fbab342d609dc7963241a2fd2dd5c7f",
      "start_line": 111,
      "text": "  rule primeScan(A, D, _P) => false\n    requires D >=Int 2\n     andBool D *Int D <=Int A\n     andBool pyMod(A, D) ==Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 120,
      "module": "VERIFICATION",
      "normalized_sha256": "d1b2c3dd591d8a0aa4abb1a73970f1bbc7d8c61befd06b9e7e07e0ec88ca15a3",
      "rationale": "Non-divisor recurrence equation for primeScan, oriented as a fold from the next divisor state to the current named summary.",
      "source_rule_id": "rule-d1b2c3dd591d8a0aa4abb1a73970f1bbc7d8c61befd06b9e7e07e0ec88ca15a3",
      "start_line": 116,
      "text": "  rule primeScan(A, D +Int 1, P) => primeScan(A, D, P)\n    requires D >=Int 2\n     andBool D *Int D <=Int A\n     andBool pyMod(A, D) =/=Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 131,
      "module": "VERIFICATION",
      "normalized_sha256": "7add6c868057fde760e298599f3f04aca6b58a8f251dc5a65f962e218851c151",
      "rationale": "Base equation of primeFibSearch: once the accumulated count reaches the target, the current Fibonacci value A is the result.",
      "source_rule_id": "rule-7add6c868057fde760e298599f3f04aca6b58a8f251dc5a65f962e218851c151",
      "start_line": 129,
      "text": "  rule primeFibSearch(N, C, A, _B) => A\n    requires C >=Int N\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 150,
      "module": "VERIFICATION",
      "normalized_sha256": "88229ce3ed2cdd6dfe0c0cedf0411c4b335071c8bc4cd37ed184c0b6a9feaa02",
      "rationale": "Inductive recurrence equation for primeFibSearch, oriented to fold the updated count and Fibonacci state back to the current summary.",
      "source_rule_id": "rule-88229ce3ed2cdd6dfe0c0cedf0411c4b335071c8bc4cd37ed184c0b6a9feaa02",
      "start_line": 140,
      "text": "  rule primeFibSearch(\n         N,\n         C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi,\n         B,\n         A +Int B)\n    => primeFibSearch(N, C, A, B)\n    requires N >=Int 1\n     andBool C <Int N\n     andBool A >=Int 0\n     andBool B >=Int 1\n    [simplification]"
    }
  ],
