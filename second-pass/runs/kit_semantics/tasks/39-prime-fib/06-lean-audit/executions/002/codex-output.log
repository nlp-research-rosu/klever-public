+print("RULE_COUNT", len(inventory["rules"]))
+print("INVENTORY_SHA256", inventory["inventory_sha256"])
+print("MANIFEST_ORDER_AND_BIJECTION", "PASS")
+print("TRUST_BOUNDARY_VALIDATOR", "PASS")
