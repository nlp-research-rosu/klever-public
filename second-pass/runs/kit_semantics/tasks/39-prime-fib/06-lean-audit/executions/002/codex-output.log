+cp -a /reference/klean-generation/generated \
+  /tmp/audit-work/39-prime-fib-independent-audit/Base
+cp /candidate/Proof.lean /candidate/lake-manifest.json \
+  /candidate/lakefile.lean /candidate/lean-toolchain \
