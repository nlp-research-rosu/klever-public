+env LD_PRELOAD=/tmp/audit-work/lean_app_path_fix.so \
+  /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake clean
+env LD_PRELOAD=/tmp/audit-work/lean_app_path_fix.so \
