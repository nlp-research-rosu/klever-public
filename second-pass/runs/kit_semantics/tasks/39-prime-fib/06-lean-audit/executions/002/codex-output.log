def _input_hashes(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
) -> dict[str, Any]:
    try:
        return {
            "k_workspace_sha256": pipeline_contract.sha256_tree(
                frozen_input
            ),
            "stage1_export_sha256": klean_export.tree_digest(
                frozen_input
            ),
            "discovery_manifest_sha256": (
                pipeline_contract.sha256_file(discovery_manifest)
            ),
            "klean_generation_sha256": (
                pipeline_contract.sha256_tree(generation)
            ),
            "lean_workspace_sha256": (
                pipeline_contract.sha256_tree(candidate)
                if candidate is not None
                else None
            ),
        }
    except (
        OSError,
        klean_export.KleanExportError,
        pipeline_contract.PipelineContractError,
    ) as error:
        raise KleanFinalGateError(
            "cannot hash Stage 6 mechanical inputs"
        ) from error


def _require_bound_inputs(
    audit_input: dict[str, Any],
    observed: dict[str, Any],
) -> None:
    expected = audit_input["resolution"]["hashes"]
    for key, digest in observed.items():
        if expected.get(key) != digest:
            raise KleanFinalGateError(
                f"Stage 6 {key} differs from audit input"
            )


def _result_binding(audit_input: Path) -> dict[str, Any]:
    try:
        document = _audit_input_binding(Path(audit_input))
    except KleanFinalGateError:
        return {}
    return {
        "mode": document["resolution"]["mode"],
        "resolved_input_sha256": document[
            "resolved_input_sha256"
        ],
        "input_hashes": document["resolution"]["hashes"],
    }


def check_final(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    frozen_input = Path(frozen_input)
    discovery_manifest = Path(discovery_manifest)
    generation = Path(generation)
    candidate = Path(candidate) if candidate is not None else None
    audit_binding = _audit_input_binding(Path(audit_input))
    signed_resolution = audit_binding["resolution"]
    if (
        signed_resolution["mode"] == "CLASSIFICATION_AND_PROOF"
        and candidate is None
    ):
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    if (
        signed_resolution["mode"] == "CLASSIFICATION_ONLY"
        and candidate is not None
    ):
        raise KleanFinalGateError(
            "classification-only audit must not use a Stage 5 Lean "
            "candidate"
        )
    expected_mode = signed_resolution["mode"]
    observed_mode = (
        "CLASSIFICATION_AND_PROOF"
        if candidate is not None
        else "CLASSIFICATION_ONLY"
    )
    if observed_mode != expected_mode:
        raise KleanFinalGateError(
            "Stage 6 mechanical mode differs from audit input"
        )
    before_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    _require_bound_inputs(audit_binding, before_hashes)
    try:
        preflight = klean_preflight.check_generation(
            frozen_input,
            discovery_manifest,
            generation,
            toolchain_lock=toolchain_lock,
            run_command=run_command,
        )
    except klean_preflight.KleanPreflightError as error:
        raise KleanFinalGateError(
            f"deterministic Klean preflight failed: {error}"
        ) from error
    preflight_status = preflight.get("status")
    if preflight_status not in {"PASS", "KLEAN_NO_OBLIGATIONS"}:
        raise KleanFinalGateError(
            "Stage 4 Klean preflight is not mechanically auditable"
        )
    manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    target = manifest.get("target")
    if preflight_status == "KLEAN_NO_OBLIGATIONS":
        if candidate is not None:
            raise KleanFinalGateError(
                "classification-only audit must not use a Stage 5 Lean "
                "candidate"
            )
        if target is not None or preflight.get("obligation_count") != 0:
            raise KleanFinalGateError(
                "KLEAN_NO_OBLIGATIONS has a target or nonempty domain set"
            )
        after_hashes = _input_hashes(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
        )
        if after_hashes != before_hashes:
            raise KleanFinalGateError(
                "resolved inputs changed during mechanical audit"
            )
        _require_bound_inputs(audit_binding, after_hashes)
        return {
            "status": "PASS",
            "mode": "CLASSIFICATION_ONLY",
            "resolved_input_sha256": audit_binding[
                "resolved_input_sha256"
            ],
            "input_hashes": signed_resolution["hashes"],
            "semantic_classification": "NOT_EVALUATED",
            "target": None,
            "klean_preflight": preflight,
            "generation_sha256": klean_export.tree_digest(generation),
            "candidate_sha256": None,
            "used_axioms": [],
            "diagnostics": [],
        }
    if candidate is None:
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    proof_check = check_proof_candidate(
        generation, candidate, run_command=run_command
    )
    after_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    if after_hashes != before_hashes:
        if (
            after_hashes.get("lean_workspace_sha256")
            != before_hashes.get("lean_workspace_sha256")
        ):
            raise KleanFinalGateError(
                "candidate changed during mechanical audit"
            )
        raise KleanFinalGateError(
            "resolved inputs changed during mechanical audit"
        )
    _require_bound_inputs(audit_binding, after_hashes)
    return {
        "status": "PASS",
        "mode": "CLASSIFICATION_AND_PROOF",
        "resolved_input_sha256": audit_binding[
            "resolved_input_sha256"
        ],
        "input_hashes": signed_resolution["hashes"],
        "semantic_classification": "NOT_EVALUATED",
        "target": proof_check["target"],
        "klean_preflight": preflight,
        "generation_sha256": proof_check["generation_sha256"],
        "candidate_sha256": proof_check["candidate_sha256"],
        "used_axioms": proof_check["used_axioms"],
        "diagnostics": proof_check["diagnostics"],
    }


def run_gate(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    output: Path,
) -> dict[str, Any]:
    output = Path(output)
    if output.exists() or output.is_symlink():
        raise KleanFinalGateError(f"output already exists: {output}")
    try:
        document = check_final(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
            toolchain_lock=toolchain_lock,
            audit_input=audit_input,
        )
    except KleanFinalGateError as error:
        document = {
            "status": "FAIL",
            "error": str(error),
            **_result_binding(audit_input),
        }
    except BaseException as error:
        document = {
            "status": "AUDIT_ERROR",
            "error": f"{type(error).__name__}: {error}",
            **_result_binding(audit_input),
        }
    temporary = output.with_name(f".{output.name}.tmp")
    temporary.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n")
    os.replace(temporary, output)
    return document


def evaluate_gate(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
) -> dict[str, Any]:
    try:
        return check_final(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
            toolchain_lock=toolchain_lock,
            audit_input=audit_input,
        )
    except KleanFinalGateError as error:
        return {
            "status": "FAIL",
            "error": str(error),
            **_result_binding(audit_input),
        }
    except BaseException as error:
        return {
            "status": "AUDIT_ERROR",
            "error": f"{type(error).__name__}: {error}",
            **_result_binding(audit_input),
        }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--frozen-k", required=True, type=Path)
    )
    task, state, run_manifest = pipeline_contract._resolve_task_state(
        repo, run_id, problem
    )
    pipeline_contract.require_task_unblocked(task, "Stage 5")
    protected = _protected_inputs(task, state, problem)
    initial_s, total_s = _timeout_policy(run_manifest)
    return {
        "run_id": run_id,
        "problem": problem,
        "status": protected.generation.status,
        "session_id": protected.session_id,
        "initial_timeout_s": initial_s,
        "total_timeout_s": total_s,
        "stage1_reference": str(protected.k_reference),
        "stage3_discovery": str(protected.discovery.path),
        "stage4_generation": str(protected.generation.path),
        "workspace": str(task / f"{STAGE}/workspace"),
        "prompt": "klean-prove.md",
    }


def _initialize_workspace(
    workspace: Path, generation_manifest: dict[str, Any], problem: str
) -> None:
    target = generation_manifest.get("target")
    if not isinstance(target, dict):
        raise Stage5RunnerError("generator target manifest is malformed")
    statement = target.get("statement")
    declaration = target.get("declaration")
    parameters = target.get("parameters")
    if not isinstance(statement, str) or not statement:
        raise Stage5RunnerError("generated target statement is missing")
    if not isinstance(declaration, str) or "." not in declaration:
        raise Stage5RunnerError("generated target declaration is malformed")
    if not isinstance(parameters, list):
        raise Stage5RunnerError("generated target parameters are malformed")
    normalized_parameters: list[tuple[str, str, str, list[str]]] = []
    for parameter in parameters:
        if not isinstance(parameter, dict):
            raise Stage5RunnerError(
                "generated target parameter is malformed"
            )
        name = parameter.get("name")
        lean_type = parameter.get("type")
        kore_symbol = parameter.get("kore_symbol")
        source_rule_ids = parameter.get("source_rule_ids")
        binding_sha256 = parameter.get("binding_sha256")
        if (
            not isinstance(name, str)
            or not _safe_lean_identifier(name)
            or not isinstance(lean_type, str)
            or not lean_type.strip()
            or "\n" in lean_type
            or not isinstance(kore_symbol, str)
            or not kore_symbol
            or "\n" in kore_symbol
            or not isinstance(source_rule_ids, list)
            or not source_rule_ids
            or not all(
                isinstance(source_rule_id, str) and source_rule_id
                for source_rule_id in source_rule_ids
            )
        ):
            raise Stage5RunnerError("generated target parameter is unsafe")
        binding = {
            "kore_symbol": kore_symbol,
            "name": name,
            "type": lean_type,
            "source_rule_ids": source_rule_ids,
        }
        expected_binding_sha256 = hashlib.sha256(
            json.dumps(
                binding, sort_keys=True, separators=(",", ":")
            ).encode()
        ).hexdigest()
        if binding_sha256 != expected_binding_sha256:
            raise Stage5RunnerError(
                "generated target parameter binding changed"
            )
        normalized_parameters.append(
            (name, lean_type.strip(), kore_symbol, source_rule_ids)
        )
    expected_statement = " ".join(
        (
            declaration,
            *(
                name
                for name, _lean_type, _kore_symbol, _source_rule_ids
                in normalized_parameters
            ),
        )
    )
    if statement != expected_statement:
        raise Stage5RunnerError(
            "generated target application is inconsistent"
        )
    module = declaration.rsplit(".", 1)[0]
    package = f"klean-{problem.lower()}"
    lakefile = (
        "import Lake\n"
        "open Lake DSL\n"
        'package "proof"\n'
        f'require «{package}» from "./Base"\n'
        "@[default_target]\n"
        "lean_lib Proof\n"
    )
    toolchain = generation_manifest.get("toolchain", {}).get(
        "lean_toolchain"
    )
    if not isinstance(toolchain, str) or not toolchain:
        raise Stage5RunnerError("generated Lean toolchain is missing")
    existing = list(workspace.iterdir())
    if existing:
        required = {"Proof.lean", "lakefile.lean", "lean-toolchain"}
        if not required.issubset(path.name for path in existing):
            raise Stage5RunnerError(
                "Lean workspace is partially initialized"
            )
        try:
            pipeline_contract.require_regular_file(
                workspace / "Proof.lean", "Stage 5 proof module"
            )
            lakefile_path = pipeline_contract.require_regular_file(
                workspace / "lakefile.lean", "Stage 5 Lean lakefile"
            )
            toolchain_path = pipeline_contract.require_regular_file(
                workspace / "lean-toolchain",
                "Stage 5 Lean toolchain",
            )
        except pipeline_contract.PipelineContractError as error:
            raise Stage5RunnerError(
                "Lean workspace contains a linked or non-regular "
                "immutable file"
            ) from error
        if lakefile_path.read_text() != lakefile:
            raise Stage5RunnerError("immutable Lean lakefile changed")
        if toolchain_path.read_text() != toolchain + "\n":
            raise Stage5RunnerError("immutable Lean toolchain changed")
        return
    workspace.joinpath("lakefile.lean").write_text(lakefile)
    workspace.joinpath("lean-toolchain").write_text(toolchain + "\n")
    parameter_stubs = "".join(
        "/- KORE symbol: "
        + kore_symbol
        + "; frozen source obligations: "
        + ", ".join(source_rule_ids)
        + ". Replace this stub with its honest total meaning from the frozen "
        "K semantics. -/\n"
        + f"axiom {name} : {lean_type}\n"
        for name, lean_type, kore_symbol, source_rule_ids
        in normalized_parameters
    )
    if parameter_stubs:
        parameter_stubs += "\n"
    workspace.joinpath("Proof.lean").write_text(
        f"import {module}\n\n"
        "namespace Proof\n\n"
        f"{parameter_stubs}"
        "theorem final :\n"
        f"    {statement} := by\n"
        "  sorry\n\n"
        "end Proof\n"
    )


