      "module": "VERIFICATION",
      "normalized_sha256": "a100ddf7646fa9f900ad120af90a1d1db8c452277cb178014ca5f3675572126f",
      "rationale": "Additional one-step exit-boundary simplifier deriving result B when the next prime-bit update reaches the target; its exact statement is not separately proved without this rule.",
      "source_rule_id": "rule-a100ddf7646fa9f900ad120af90a1d1db8c452277cb178014ca5f3675572126f",
      "start_line": 132,
      "text": "  rule primeFibSearch(N, C, _A, B) => B\n    requires N >=Int 1\n     andBool C <Int N\n     andBool notBool (\n       C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi\n       <Int N)\n     andBool B >=Int 1\n    [simplification]"
    }
