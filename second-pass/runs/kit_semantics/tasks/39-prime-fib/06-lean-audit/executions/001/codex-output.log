+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      5 2 false = false := by native_decide
+
+example :
+    Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+      1 1 2 3 = 2 := by rfl
+example :
+    Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+      1 0 1 2 = 2 := by rfl
+example :
+    Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+      2 1 2 3 = 3 := by rfl
+example :
+    Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+      3 2 3 5 = 5 := by rfl
+
+end OperationalExamples
