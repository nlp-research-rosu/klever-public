+example : Proof.«_>=Int_» 2 2 = true := by native_decide
+example : Proof.«_<Int_» 2 3 = true := by native_decide
+example : Proof.«_<Int_» 3 2 = false := by native_decide
+example : Proof.«_+Int_» (-7) 4 = -3 := rfl
+example : Proof.notBool_ true = false := rfl
+example : Proof.notBool_ false = true := rfl
+
+example :
+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      2 2 true = true := by native_decide
+example :
+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      4 2 true = false := by native_decide
+example :
+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      5 2 true = true := by native_decide
+example :
+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      9 2 true = false := by native_decide
+example :
+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      25 3 true = false := by native_decide
+example :
+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      49 5 true = false := by native_decide
+example :
+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      (-7) 2 true = true := by native_decide
+example :
+    Proof.«primeScan(_,_,_)_VERIFICATION-SYNTAX_Bool_Int_Int_Bool»
+      5 2 false = false := by native_decide
+
+example :
+    Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+      1 1 2 3 = 2 := by rfl
+example :
+    Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+      1 0 1 2 = 2 := by native_decide
+example :
+    Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+      2 1 2 3 = 3 := by native_decide
+example :
+    Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+      3 2 3 5 = 5 := by native_decide
+
+end OperationalExamples
