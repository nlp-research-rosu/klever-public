+import Klean39PrimeFib.Lemmas
+
+namespace CounterfactualBridges
+
+def badAnd (_x _y : SortBool) : SortBool := false
+def honestGe (x y : SortInt) : SortBool := decide (x ≥ y)
+def honestLt (x y : SortInt) : SortBool := decide (x < y)
+def honestAdd (x y : SortInt) : SortInt := x + y
+def honestNot (x : SortBool) : SortBool := !x
+def badSearch (_target _count _a b : SortInt) : SortInt := b
+def badScan (_a _d : SortInt) (_flag : SortBool) : SortBool := false
+
+theorem exactTargetStillCloses :
+    Klean39PrimeFib.Lemmas.targetStatement
+      badAnd honestGe honestLt honestAdd honestNot badSearch badScan := by
+  constructor
+  · intro _d _a _h
+    rfl
+  · intro _b _a _count _target h
+    simp [badAnd] at h
+
+example : badScan 5 2 true ≠ true := by native_decide
+example : badSearch 1 1 2 3 ≠ 2 := by native_decide
+
+#print axioms CounterfactualBridges.exactTargetStillCloses
+
+end CounterfactualBridges
