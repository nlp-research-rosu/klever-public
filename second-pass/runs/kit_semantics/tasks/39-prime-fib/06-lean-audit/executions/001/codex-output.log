+import Proof
+
+set_option pp.privateNames true in
+#print Proof.«primeFibSearch(_,_,_,_)_VERIFICATION-SYNTAX_Int_Int_Int_Int_Int»
+
+set_option pp.privateNames true in
+#print _private.Proof.«0».Proof.semanticSearch
