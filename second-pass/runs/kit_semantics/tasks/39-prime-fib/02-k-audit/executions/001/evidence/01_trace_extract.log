+def prime_fib(n: int):
+    a = 0
+    b = 1
+    count = 0
+    while count < n:
+        next_value = a + b
+        a = b
+        b = next_value
+        divisor = 2
+        is_prime = a >= 2
+        while divisor * divisor <= a:
+            if a % divisor == 0:
+                is_prime = False
+            divisor = divisor + 1
+        if is_prime:
+            count = count + 1
+    return a
