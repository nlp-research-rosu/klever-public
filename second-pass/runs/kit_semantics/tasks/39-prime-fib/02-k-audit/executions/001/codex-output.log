+#!/usr/bin/env bash
+set -eu
+set -o pipefail
+
+scratch=/tmp/audit-work/39-prime-fib-audit
+evidence=/audit-output/evidence
+
+run_capture() {
+  log=$1
+  shift
+  printf 'running %s\n' "$log"
+  set +e
+  (
+    printf '$'
+    printf ' %q' "$@"
+    printf '\n'
+    "$@"
+    rc=$?
+    printf '[exit %d]\n' "$rc"
+    exit "$rc"
+  ) > "$evidence/$log" 2>&1
+  rc=$?
+  set -e
+  return "$rc"
+}
+
+cd "$scratch"
