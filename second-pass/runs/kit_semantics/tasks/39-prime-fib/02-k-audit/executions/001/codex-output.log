+           Assign(Name("count"), Int(0))
+           Assign(Name("next_value"), Int(0))
+           Assign(Name("divisor"), Int(2))
+           Assign(Name("is_prime"), Bool(false))
+           primeFibOuter
+           Return(Name("a"))
+           .Stmts,
+           0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
