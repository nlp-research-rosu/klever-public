Module(
  FuncDef("prime_fib", Params("n"),
    Assign(Name("a"), Int(0))
    Assign(Name("b"), Int(1))
    Assign(Name("count"), Int(0))
    Assign(Name("next_value"), Int(0))
    Assign(Name("divisor"), Int(2))
    Assign(Name("is_prime"), Bool(false))
    While(Compare(Name("count"), CmpOp("<", Name("n"))),
      Assign(Name("next_value"), BinOp("+", Name("a"), Name("b")))
      Assign(Name("a"), Name("b"))
      Assign(Name("b"), Name("next_value"))
      Assign(Name("divisor"), Int(2))
      Assign(Name("is_prime"), Compare(Name("a"), CmpOp(">=", Int(2))))
      While(Compare(
        BinOp("*", Name("divisor"), Name("divisor")),
        CmpOp("<=", Name("a"))),
        If(Compare(
          BinOp("%", Name("a"), Name("divisor")),
          CmpOp("==", Int(0))),
          Assign(Name("is_prime"), Bool(false)),
          )
        Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
      Assign(Name("count"), BinOp("+", Name("count"), Name("is_prime"))))
    Return(Name("a")))
  Assign(Name("result"), Call(Name("prime_fib"), Int(5))))
