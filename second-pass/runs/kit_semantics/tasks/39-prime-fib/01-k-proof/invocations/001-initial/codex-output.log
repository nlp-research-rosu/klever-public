index 0000000000000000000000000000000000000000..fd67e00bcda12e8c387ee81dab1aa4bb6f7bbc2f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def prime_fib(n: int):
+    a = 0
+    b = 1
+    count = 0
+    next_value = 0
+    divisor = 2
+    is_prime = False
+    while count < n:
+        next_value = a + b
+        a = b
+        b = next_value
+        divisor = 2
+        is_prime = a >= 2
+        while divisor * divisor <= a:
+            if a % divisor == 0:
+                is_prime = False
+            divisor = divisor + 1
+        count = count + is_prime
+    return a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..38e60ec8c37500cb5dfdc53db3cc1a81a3a4d098
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k> primeFibInnerCore => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "n"          |-> N:Int
+        "a"          |-> A:Int
+        "b"          |-> B:Int
+        "count"      |-> C:Int
+        "next_value" |-> NV:Int
+        "divisor"    |-> (D:Int => ?DF:Int)
+        "is_prime"   |-> (P:Bool => primeScan(A, D, P)),
+        parent(0))
+      ...
+    </scopes>
+    requires A >=Int 0
+     andBool D >=Int 2
+
+  claim [outer-loop]:
+    <k> primeFibOuterCore => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "n"          |-> N:Int
+        "a"          |-> (A:Int  => primeFibSearch(N, C, A, B))
+        "b"          |-> (B:Int  => ?BF:Int)
+        "count"      |-> (C:Int  => N)
+        "next_value" |-> (NV:Int => ?NVF:Int)
+        "divisor"    |-> (D:Int  => ?DF:Int)
+        "is_prime"   |-> (P:Bool => ?PF:Bool),
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 1
+     andBool C >=Int 0
+     andBool C <=Int N
+     andBool A >=Int 0
+     andBool B >=Int 1
+
+  claim [prime-fib]:
+    <k> Call(Name("prime_fib"), (Int(N), .Exprs))
+      => primeFibSearch(N, 0, 0, 1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+         "prime_fib" |-> closureVal("n", primeFibBody, 0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a8183fd6d16c3ea3cd05ee5082590c65e5144124
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,139 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  // Syntactic abbreviations only: these macros expand to the translated
+  // solution.py body before execution or proof.
+  syntax Stmt  ::= "primeFibInner" [macro]
+                 | "primeFibOuter" [macro]
+  syntax Stmts ::= "primeFibBody"  [macro]
+  syntax KItem ::= "primeFibInnerCore" [macro]
+                 | "primeFibOuterCore" [macro]
+
+  // Mathematical summaries used by the loop invariants.
+  syntax Bool ::= primeScan(Int, Int, Bool) [function]
+                | mathPrime(Int)            [function]
+  syntax Int  ::= boolInt(Bool) [function, total]
+  syntax Int  ::= primeFibSearch(Int, Int, Int, Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule primeFibInner
+    => While(
+         Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("a"))),
+         If(
+           Compare(
+             BinOp("%", Name("a"), Name("divisor")),
+             CmpOp("==", Int(0))),
+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibInnerCore
+    => #while(
+         Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("a"))),
+         If(
+           Compare(
+             BinOp("%", Name("a"), Name("divisor")),
+             CmpOp("==", Int(0))),
+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibOuter
+    => While(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         Assign(
+           Name("count"),
+           BinOp("+", Name("count"), Name("is_prime")))
+         .Stmts)
+
+  rule primeFibOuterCore
+    => #while(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         Assign(
+           Name("count"),
+           BinOp("+", Name("count"), Name("is_prime")))
+         .Stmts)
+
+  rule primeFibBody
+    => Assign(Name("a"), Int(0))
+       Assign(Name("b"), Int(1))
+       Assign(Name("count"), Int(0))
+       Assign(Name("next_value"), Int(0))
+       Assign(Name("divisor"), Int(2))
+       Assign(Name("is_prime"), Bool(false))
+       primeFibOuter
+       Return(Name("a"))
+       .Stmts
+
+  // primeScan(A,D,P) is the flag left after trial-dividing A by every
+  // integer from D through floor(sqrt(A)), starting with flag P.
+  rule primeScan(A, D, P) => P
+    requires D >=Int 2 andBool D *Int D >Int A
+  rule primeScan(A, D, _P) => primeScan(A, D +Int 1, false)
+    requires D >=Int 2
+     andBool D *Int D <=Int A
+     andBool pyMod(A, D) ==Int 0
+  rule primeScan(A, D, P) => primeScan(A, D +Int 1, P)
+    requires D >=Int 2
+     andBool D *Int D <=Int A
+     andBool pyMod(A, D) =/=Int 0
+
+  // Once a divisor has cleared the flag, later iterations cannot restore it.
+  rule primeScan(_A, D, false) => false
+    requires D >=Int 2
+    [simplification]
+
+  // This is the usual trial-division definition of primality for an integer.
+  rule mathPrime(A) => primeScan(A, 2, A >=Int 2)
+
+  rule boolInt(B) => #if B #then 1 #else 0 #fi
+
+  // Remaining-search summary for the outer loop.  A and B are consecutive
+  // Fibonacci-state values, and C prime Fibonacci values have been seen.
+  rule primeFibSearch(N, C, A, _B) => A
+    requires C >=Int N
+  rule primeFibSearch(N, C, A, B)
+    => primeFibSearch(
+         N, C +Int boolInt(mathPrime(B)), B, A +Int B)
+    requires C <Int N
+endmodule

