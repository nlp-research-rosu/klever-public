+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibOuter
+    => While(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         If(
+           Name("is_prime"),
+           Assign(
+             Name("count"),
+             BinOp("+", Name("count"), Int(1)))
+           .Stmts,
+           .Stmts)
+         .Stmts)
+
+  rule primeFibOuterCore
+    => #while(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         If(
+           Name("is_prime"),
+           Assign(
+             Name("count"),
+             BinOp("+", Name("count"), Int(1)))
+           .Stmts,
+           .Stmts)
+         .Stmts)
+
+  rule primeFibBody
+    => Assign(Name("a"), Int(0))
+       Assign(Name("b"), Int(1))
+       Assign(Name("count"), Int(0))
+       Assign(Name("next_value"), Int(0))
+       Assign(Name("divisor"), Int(2))
+       Assign(Name("is_prime"), Bool(false))
+       primeFibOuter
