+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibOuter
+    => While(
