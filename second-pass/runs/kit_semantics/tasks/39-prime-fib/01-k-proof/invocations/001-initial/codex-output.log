diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1ccbe02dc989e04964d1f9a0e58a432c4603f012
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,84 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop-true]:
+    <k> primeFibInnerCore => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "n"          |-> N:Int
+        "a"          |-> A:Int
+        "b"          |-> B:Int
+        "count"      |-> C:Int
+        "next_value" |-> NV:Int
+        "divisor"    |-> (D:Int => ?DF:Int)
+        "is_prime"   |-> (P:Bool => true),
+        parent(0))
+      ...
+    </scopes>
+    requires A >=Int 0
+     andBool D >=Int 2
+     andBool primeScan(A, D, P)
+
+  claim [inner-loop-false]:
+    <k> primeFibInnerCore => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "n"          |-> N:Int
+        "a"          |-> A:Int
+        "b"          |-> B:Int
+        "count"      |-> C:Int
+        "next_value" |-> NV:Int
+        "divisor"    |-> (D:Int => ?DF:Int)
+        "is_prime"   |-> (P:Bool => false),
+        parent(0))
+      ...
+    </scopes>
+    requires A >=Int 0
+     andBool D >=Int 2
+     andBool notBool primeScan(A, D, P)
+
+  claim [outer-loop]:
+    <k> primeFibOuterCore => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "n"          |-> N:Int
+        "a"          |-> (A:Int  => primeFibSearch(N, C, A, B))
+        "b"          |-> (B:Int  => ?BF:Int)
+        "count"      |-> (C:Int  => N)
+        "next_value" |-> (NV:Int => ?NVF:Int)
+        "divisor"    |-> (D:Int  => ?DF:Int)
+        "is_prime"   |-> (P:Bool => ?PF:Bool),
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 1
+     andBool C >=Int 0
+     andBool C <=Int N
+     andBool A >=Int 0
+     andBool B >=Int 1
+
+  claim [prime-fib]:
+    <k> Call(Name("prime_fib"), (Int(N), .Exprs))
+      => primeFibSearch(N, 0, 0, 1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+         "prime_fib" |-> closureVal("n", primeFibBody, 0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..49133e84658ae03d18bf6bda9ede4b6eb02b9101
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,141 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  // Syntactic abbreviations only: these macros expand to the translated
+  // solution.py body before execution or proof.
+  syntax Stmt  ::= "primeFibInner" [macro]
+                 | "primeFibOuter" [macro]
+  syntax Stmts ::= "primeFibBody"  [macro]
+  syntax KItem ::= "primeFibInnerCore" [macro]
+                 | "primeFibOuterCore" [macro]
+
+  // Mathematical summaries used by the loop invariants.
+  syntax Bool ::= primeScan(Int, Int, Bool) [function]
+                | mathPrime(Int)            [function]
+  syntax Int  ::= primeFibSearch(Int, Int, Int, Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule primeFibInner
+    => While(
+         Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("a"))),
+         If(
+           Compare(
+             BinOp("%", Name("a"), Name("divisor")),
+             CmpOp("==", Int(0))),
+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibInnerCore
+    => #while(
+         Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("a"))),
+         If(
+           Compare(
+             BinOp("%", Name("a"), Name("divisor")),
+             CmpOp("==", Int(0))),
+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibOuter
+    => While(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         If(
+           Name("is_prime"),
+           Assign(
+             Name("count"),
+             BinOp("+", Name("count"), Int(1)))
+           .Stmts,
+           .Stmts)
+         .Stmts)
+
+  rule primeFibOuterCore
+    => #while(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         If(
+           Name("is_prime"),
+           Assign(
+             Name("count"),
+             BinOp("+", Name("count"), Int(1)))
+           .Stmts,
+           .Stmts)
+         .Stmts)
+
+  rule primeFibBody
+    => Assign(Name("a"), Int(0))
+       Assign(Name("b"), Int(1))
+       Assign(Name("count"), Int(0))
+       Assign(Name("next_value"), Int(0))
+       Assign(Name("divisor"), Int(2))
+       Assign(Name("is_prime"), Bool(false))
+       primeFibOuter
+       Return(Name("a"))
+       .Stmts
+
+  // primeScan(A,D,P) is the flag left after trial-dividing A by every
+  // integer from D through floor(sqrt(A)), starting with flag P.
+  rule primeScan(A, D, P) => P
+    requires D >=Int 2 andBool D *Int D >Int A
+  rule primeScan(A, D, _P) => primeScan(A, D +Int 1, false)
+    requires D >=Int 2
+     andBool D *Int D <=Int A
+     andBool pyMod(A, D) ==Int 0
+  rule primeScan(A, D, P) => primeScan(A, D +Int 1, P)
+    requires D >=Int 2
+     andBool D *Int D <=Int A
+     andBool pyMod(A, D) =/=Int 0
+
+  // This is the usual trial-division definition of primality for an integer.
+  rule mathPrime(A) => primeScan(A, 2, A >=Int 2)
+
+  // Remaining-search summary for the outer loop.  A and B are consecutive
+  // Fibonacci-state values, and C prime Fibonacci values have been seen.
+  rule primeFibSearch(N, C, A, _B) => A
+    requires C >=Int N
+  rule primeFibSearch(N, C, A, B)
+    => primeFibSearch(N, C +Int 1, B, A +Int B)
+    requires C <Int N andBool mathPrime(B)
+  rule primeFibSearch(N, C, A, B)
+    => primeFibSearch(N, C, B, A +Int B)
+    requires C <Int N andBool notBool mathPrime(B)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --exclude SPEC.prime-fib' in /workspace
