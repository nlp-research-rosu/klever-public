+++ b/test_solution.py
@@ -0,0 +1,37 @@
+from math import isqrt
+
+from solution import prime_fib
+
+
+def oracle_is_prime(value):
+    if value < 2:
+        return False
+    for divisor in range(2, isqrt(value) + 1):
+        if value % divisor == 0:
+            return False
+    return True
+
+
+def oracle_prime_fibs(limit):
+    values = []
+    a = 0
+    b = 1
+    while len(values) < limit:
+        a, b = b, a + b
+        if oracle_is_prime(a):
+            values.append(a)
+    return values
+
+
+expected_examples = [2, 3, 5, 13, 89]
+actual_examples = [prime_fib(n) for n in range(1, 6)]
+assert actual_examples == expected_examples
+
+oracle_values = oracle_prime_fibs(10)
+actual_values = [prime_fib(n) for n in range(1, 11)]
+assert actual_values == oracle_values
+
+print("prompt examples:", actual_examples)
+print("differential inputs: n=1..10")
+print("oracle values:", oracle_values)
+print("mismatches: 0")
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..eca94d552820f278674e0c9afc88251664a184fd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,158 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  // Syntactic abbreviations only: these macros expand to the translated
+  // solution.py body before execution or proof.
+  syntax Stmt  ::= "primeFibInner" [macro]
+                 | "primeFibOuter" [macro]
+  syntax Stmts ::= "primeFibBody"  [macro]
+  syntax KItem ::= "primeFibInnerCore" [macro]
+                 | "primeFibOuterCore" [macro]
+
+  // Mathematical summaries used by the loop invariants.
+  syntax Bool ::= primeScan(Int, Int, Bool) [function]
+                | mathPrime(Int) [function]
+  syntax Int  ::= boolInt(Bool) [function, total]
+  syntax Int  ::= primeFibSearch(Int, Int, Int, Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule primeFibInner
+    => While(
+         Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("a"))),
+         If(
+           Compare(
+             BinOp("%", Name("a"), Name("divisor")),
+             CmpOp("==", Int(0))),
+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibInnerCore
+    => #while(
+         Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("a"))),
+         If(
+           Compare(
+             BinOp("%", Name("a"), Name("divisor")),
+             CmpOp("==", Int(0))),
+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibOuter
+    => While(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         Assign(
+           Name("count"),
+           BinOp("+", Name("count"), Name("is_prime")))
+         .Stmts)
+
+  rule primeFibOuterCore
+    => #while(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         Assign(
+           Name("count"),
+           BinOp("+", Name("count"), Name("is_prime")))
+         .Stmts)
+
+  rule primeFibBody
+    => Assign(Name("a"), Int(0))
+       Assign(Name("b"), Int(1))
+       Assign(Name("count"), Int(0))
+       Assign(Name("next_value"), Int(0))
+       Assign(Name("divisor"), Int(2))
+       Assign(Name("is_prime"), Bool(false))
+       primeFibOuter
+       Return(Name("a"))
+       .Stmts
+
+  // primeScan(A,D,P) is the flag left after trial-dividing A by every
+  // integer from D through floor(sqrt(A)), starting with flag P.
+  rule primeScan(A, D, P) => P
+    requires D >=Int 2 andBool D *Int D >Int A
+    [simplification]
+  rule primeScan(A, D, _P) => false
+    requires D >=Int 2
+     andBool D *Int D <=Int A
+     andBool pyMod(A, D) ==Int 0
+    [simplification]
+  rule primeScan(A, D +Int 1, P) => primeScan(A, D, P)
+    requires D >=Int 2
+     andBool D *Int D <=Int A
+     andBool pyMod(A, D) =/=Int 0
+    [simplification]
+
+  // Once a divisor has cleared the flag, later iterations cannot restore it.
+  rule primeScan(_A, D, false) => false
+    requires D >=Int 2
+    [simplification]
+
+  // This is the usual trial-division definition of primality for an integer.
+  rule mathPrime(A) => primeScan(A, 2, A >=Int 2)
+
+  rule boolInt(B) => #if B #then 1 #else 0 #fi
+
+  // Remaining-search summary for the outer loop.  A and B are consecutive
+  // Fibonacci-state values, and C prime Fibonacci values have been seen.
+  rule primeFibSearch(N, C, A, _B) => A
+    requires C >=Int N
+    [simplification]
+  rule primeFibSearch(N, C, _A, B) => B
+    requires N >=Int 1
+     andBool C <Int N
+     andBool notBool (
+       C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi
+       <Int N)
+     andBool B >=Int 1
+    [simplification]
+  rule primeFibSearch(
+         N,
+         C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi,
+         B,
+         A +Int B)
+    => primeFibSearch(N, C, A, B)
+    requires N >=Int 1
+     andBool C <Int N
+     andBool A >=Int 0
+     andBool B >=Int 1
+    [simplification]
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a1f23f6597a1d2456305f2c53341459c4ff9cab3
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+python3 test_solution.py
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun smoke.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition verification-kompiled
+
+# Prove the nested loop first.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.inner-loop
+
+# Prove the outer loop using the already-proved inner claim as a staged lemma.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.inner-loop,SPEC.outer-loop \
+  --trusted SPEC.inner-loop
+
+# Prove the entry claim using the two already-proved loop claims.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.inner-loop,SPEC.outer-loop,SPEC.prime-fib \
+  --trusted SPEC.inner-loop,SPEC.outer-loop
+
+if kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY \
+  --claims SPEC.inner-loop,SPEC.outer-loop,SPEC-VACUITY.false-result \
+  --trusted SPEC.inner-loop,SPEC.outer-loop
+then
+  echo "ERROR: false-result mutation unexpectedly proved"
+  exit 1
+else
+  mutation_status=$?
+  echo "EXPECTED FAILURE: false-result mutation exited ${mutation_status}"
+fi
+
+if kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION \
+  --claims SPEC.inner-loop,SPEC.outer-loop,SPEC-BODY-MUTATION.changed-initial-b \
+  --trusted SPEC.inner-loop,SPEC.outer-loop
+then
+  echo "ERROR: body mutation unexpectedly proved"
+  exit 1
+else
+  body_mutation_status=$?
+  echo "EXPECTED FAILURE: body mutation exited ${body_mutation_status}"
+fi
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..ef68d0c09008224c196f35a7372321211a069c88
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,22 @@
+def prime_fib(n: int):
+    a = 0
+    b = 1
+    count = 0
+    next_value = 0
+    divisor = 2
+    is_prime = False
+    while count < n:
+        next_value = a + b
+        a = b
+        b = next_value
+        divisor = 2
+        is_prime = a >= 2
+        while divisor * divisor <= a:
+            if a % divisor == 0:
+                is_prime = False
+            divisor = divisor + 1
+        count = count + is_prime
+    return a
+
+
+result = prime_fib(5)
