+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [inner-loop]:
+    <k> primeFibInnerCore => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "n"          |-> N:Int
+        "a"          |-> A:Int
+        "b"          |-> B:Int
+        "count"      |-> C:Int
+        "next_value" |-> NV:Int
+        "divisor"    |-> (D:Int => ?DF:Int)
+        "is_prime"   |-> (P:Bool => primeScan(A, D, P)),
+        parent(0))
+      ...
+    </scopes>
+    requires A >=Int 0
+     andBool D >=Int 2
+
+  claim [outer-loop]:
+    <k> primeFibOuterCore => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "n"          |-> N:Int
+        "a"          |-> (A:Int  => primeFibSearch(N, C, A, B))
+        "b"          |-> (B:Int  => ?BF:Int)
+        "count"      |-> (C:Int  => ?CF:Int)
+        "next_value" |-> (NV:Int => ?NVF:Int)
+        "divisor"    |-> (D:Int  => ?DF:Int)
+        "is_prime"   |-> (P:Bool => ?PF:Bool),
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 1
+     andBool A >=Int 0
+     andBool B >=Int 1
+
+  claim [prime-fib]:
+    <k> Call(Name("prime_fib"), (Int(N), .Exprs))
+      => primeFibSearch(N, 0, 0, 1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+         "prime_fib" |-> closureVal("n", primeFibBody, 0),
+         parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..13edd12e3797ea9c3302e0d369222c594bb73a2f
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,37 @@
+from math import isqrt
+
+from solution import prime_fib
+
+
+def oracle_is_prime(value):
+    if value < 2:
+        return False
+    for divisor in range(2, isqrt(value) + 1):
+        if value % divisor == 0:
+            return False
+    return True
+
+
+def oracle_prime_fibs(limit):
+    values = []
+    a = 0
+    b = 1
+    while len(values) < limit:
+        a, b = b, a + b
+        if oracle_is_prime(a):
+            values.append(a)
+    return values
+
+
+expected_examples = [2, 3, 5, 13, 89]
+actual_examples = [prime_fib(n) for n in range(1, 6)]
+assert actual_examples == expected_examples
+
+oracle_values = oracle_prime_fibs(10)
+actual_values = [prime_fib(n) for n in range(1, 11)]
+assert actual_values == oracle_values
+
+print("prompt examples:", actual_examples)
+print("differential inputs: n=1..10")
+print("oracle values:", oracle_values)
+print("mismatches: 0")
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..eca94d552820f278674e0c9afc88251664a184fd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,158 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  // Syntactic abbreviations only: these macros expand to the translated
+  // solution.py body before execution or proof.
+  syntax Stmt  ::= "primeFibInner" [macro]
+                 | "primeFibOuter" [macro]
+  syntax Stmts ::= "primeFibBody"  [macro]
+  syntax KItem ::= "primeFibInnerCore" [macro]
+                 | "primeFibOuterCore" [macro]
+
+  // Mathematical summaries used by the loop invariants.
+  syntax Bool ::= primeScan(Int, Int, Bool) [function]
+                | mathPrime(Int) [function]
+  syntax Int  ::= boolInt(Bool) [function, total]
+  syntax Int  ::= primeFibSearch(Int, Int, Int, Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule primeFibInner
+    => While(
+         Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("a"))),
+         If(
+           Compare(
+             BinOp("%", Name("a"), Name("divisor")),
+             CmpOp("==", Int(0))),
+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibInnerCore
+    => #while(
+         Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("a"))),
+         If(
+           Compare(
+             BinOp("%", Name("a"), Name("divisor")),
+             CmpOp("==", Int(0))),
+           Assign(Name("is_prime"), Bool(false))
+           .Stmts,
+           .Stmts)
+         Assign(
+           Name("divisor"),
+           BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+
+  rule primeFibOuter
+    => While(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         Assign(
+           Name("count"),
+           BinOp("+", Name("count"), Name("is_prime")))
+         .Stmts)
+
+  rule primeFibOuterCore
+    => #while(
+         Compare(Name("count"), CmpOp("<", Name("n"))),
+         Assign(
+           Name("next_value"),
+           BinOp("+", Name("a"), Name("b")))
+         Assign(Name("a"), Name("b"))
+         Assign(Name("b"), Name("next_value"))
+         Assign(Name("divisor"), Int(2))
+         Assign(
+           Name("is_prime"),
+           Compare(Name("a"), CmpOp(">=", Int(2))))
+         primeFibInner
+         Assign(
+           Name("count"),
+           BinOp("+", Name("count"), Name("is_prime")))
+         .Stmts)
+
+  rule primeFibBody
+    => Assign(Name("a"), Int(0))
+       Assign(Name("b"), Int(1))
+       Assign(Name("count"), Int(0))
+       Assign(Name("next_value"), Int(0))
+       Assign(Name("divisor"), Int(2))
+       Assign(Name("is_prime"), Bool(false))
+       primeFibOuter
+       Return(Name("a"))
+       .Stmts
+
+  // primeScan(A,D,P) is the flag left after trial-dividing A by every
+  // integer from D through floor(sqrt(A)), starting with flag P.
+  rule primeScan(A, D, P) => P
+    requires D >=Int 2 andBool D *Int D >Int A
+    [simplification]
+  rule primeScan(A, D, _P) => false
+    requires D >=Int 2
+     andBool D *Int D <=Int A
+     andBool pyMod(A, D) ==Int 0
+    [simplification]
+  rule primeScan(A, D +Int 1, P) => primeScan(A, D, P)
+    requires D >=Int 2
+     andBool D *Int D <=Int A
+     andBool pyMod(A, D) =/=Int 0
+    [simplification]
+
+  // Once a divisor has cleared the flag, later iterations cannot restore it.
+  rule primeScan(_A, D, false) => false
+    requires D >=Int 2
+    [simplification]
+
+  // This is the usual trial-division definition of primality for an integer.
+  rule mathPrime(A) => primeScan(A, 2, A >=Int 2)
+
+  rule boolInt(B) => #if B #then 1 #else 0 #fi
+
+  // Remaining-search summary for the outer loop.  A and B are consecutive
+  // Fibonacci-state values, and C prime Fibonacci values have been seen.
+  rule primeFibSearch(N, C, A, _B) => A
+    requires C >=Int N
+    [simplification]
+  rule primeFibSearch(N, C, _A, B) => B
+    requires N >=Int 1
+     andBool C <Int N
+     andBool notBool (
+       C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi
+       <Int N)
+     andBool B >=Int 1
+    [simplification]
+  rule primeFibSearch(
+         N,
+         C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi,
+         B,
+         A +Int B)
+    => primeFibSearch(N, C, A, B)
+    requires N >=Int 1
+     andBool C <Int N
+     andBool A >=Int 0
+     andBool B >=Int 1
+    [simplification]
+endmodule

