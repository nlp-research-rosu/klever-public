diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..1da60a7f2a8fb362878bc96018b1991608ffb8b1
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,23 @@
+def prime_fib(n: int):
+    a = 0
+    b = 1
+    count = 0
+    next_value = 0
+    divisor = 2
+    is_prime = False
+    while count < n:
+        next_value = a + b
+        a = b
+        b = next_value
+        divisor = 2
+        is_prime = a >= 2
+        while divisor * divisor <= a:
+            if a % divisor == 0:
+                is_prime = False
+            divisor = divisor + 1
+        if is_prime:
+            count = count + 1
+    return a
+
+
+result = prime_fib(5)
