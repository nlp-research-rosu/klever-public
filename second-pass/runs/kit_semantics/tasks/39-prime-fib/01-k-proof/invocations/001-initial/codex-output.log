+  rule boolInt(B) => #if B #then 1 #else 0 #fi
+
+  // Remaining-search summary for the outer loop.  A and B are consecutive
+  // Fibonacci-state values, and C prime Fibonacci values have been seen.
+  rule primeFibSearch(N, C, A, _B) => A
+    requires C >=Int N
+    [simplification]
+  rule primeFibSearch(N, C, _A, B) => B
+    requires N >=Int 1
+     andBool C >=Int 0
+     andBool C <Int N
+     andBool notBool (
+       C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi
+       <Int N)
+     andBool B >=Int 1
+    [simplification]
+  rule primeFibSearch(
+         N,
+         C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi,
+         B,
+         A +Int B)
+    => primeFibSearch(N, C, A, B)
+    requires N >=Int 1
+     andBool C >=Int 0
+     andBool C <Int N
+     andBool A >=Int 0
+     andBool B >=Int 1
+    [simplification]
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..ef68d0c09008224c196f35a7372321211a069c88
--- /dev/null
