+         B,
+         A +Int B)
+    => primeFibSearch(N, C, A, B)
+    requires N >=Int 1
+     andBool C >=Int 0
+     andBool C <Int N
+     andBool A >=Int 0
+     andBool B >=Int 1
+    [simplification]
+endmodule

