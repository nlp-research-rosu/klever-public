+       <Int N)
+     andBool B >=Int 1
+    [simplification]
+  rule primeFibSearch(
+         N,
+         C +Int #if primeScan(B, 2, B >=Int 2) #then 1 #else 0 #fi,
+         B,
+         A +Int B)
+    => primeFibSearch(N, C, A, B)
+    requires N >=Int 1
+     andBool C >=Int 0
+     andBool C <Int N
+     andBool A >=Int 0
+     andBool B >=Int 1
