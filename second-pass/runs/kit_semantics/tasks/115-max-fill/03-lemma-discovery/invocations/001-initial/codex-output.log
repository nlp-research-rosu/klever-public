+      "classification": "DEFINITION",
+      "rationale": "Defines the disjoint nonpositive-capacity totalization branch of bucketCost."
+    },
+    {
+      "source_rule_id": "rule-d64dccd6306357f40c9b821cb592e9b1ae30964f44f52576617a90c97cb434cb",
+      "classification": "DEFINITION",
+      "rationale": "Defines the empty-grid base case of the gridCost recurrence."
+    },
+    {
+      "source_rule_id": "rule-8e4ed42ce768056a9a2107e00bc2962b9a3f934581c589d848903da0a97a8dc2",
+      "classification": "DEFINITION",
+      "rationale": "Defines the nonempty gridCost recurrence as the head-row bucket cost plus the tail-grid cost."
+    },
+    {
