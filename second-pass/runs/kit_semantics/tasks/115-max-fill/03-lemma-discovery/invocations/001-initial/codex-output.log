allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
for i,(a,b) in enumerate(zip(out['rules'],inv['rules'])):
    assert list(a.keys()) == ['source_rule_id','classification','rationale'], (i,a.keys())
    assert a['source_rule_id'] == b['source_rule_id'], (i,a['source_rule_id'],b['source_rule_id'])
    assert a['classification'] in allowed, (i,a['classification'])
    assert isinstance(a['rationale'],str) and a['rationale'].strip(), i
    if any(x.startswith('simplification') for x in b['attributes']):
        assert a['classification'] in {'DEFINITION','DOMAIN_LEMMA'}, (i,a['classification'])
print('inventory_sha256', out['inventory_sha256'])
print('rules', len(out['rules']))
print('counts', dict(Counter(x['classification'] for x in out['rules'])))
print('order_and_schema_valid', True)
PY
