   227	def ByteArray.decEq (a b : ByteArray) : Decidable (Eq a b) :=
   228	  match a, b with
   229	  | ⟨⟨al⟩⟩, ⟨⟨bl⟩⟩ => match List.hasDecEq al bl with
   230	    | isTrue t => isTrue (by rw [t])
   231	    | isFalse f => isFalse (by simp [f])
   232	
   233	instance: DecidableEq SortBytes := ByteArray.decEq
