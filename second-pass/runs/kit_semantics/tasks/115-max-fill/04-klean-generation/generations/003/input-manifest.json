{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "3d79da82b43c275c9d34980f5c70a5d2655a97a29064001247280c1e26e49628",
      "rationale": "Defines the named domain predicate definedProjectInt as the existing sort test isInt.",
      "source_rule_id": "rule-3d79da82b43c275c9d34980f5c70a5d2655a97a29064001247280c1e26e49628",
      "start_line": 9,
      "text": "  rule definedProjectInt(V) => isInt(V)"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "44699459891b0065e1274df000145d152d5593dbc795d66a9108a23233e8be46",
      "rationale": "Defines the named projectInt proof term by the built-in partial Int cast under its explicit definedness guard.",
      "source_rule_id": "rule-44699459891b0065e1274df000145d152d5593dbc795d66a9108a23233e8be46",
      "start_line": 17,
      "text": "  rule projectInt(V:Val) => {V}:>Int\n    requires definedProjectInt(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "2f319fc608bca611d97f73f2eccd57da4594fe7eccf200e64ea8ed18a6d1d77c",
      "rationale": "Provides the reverse definitional orientation between the guarded built-in Int cast and the named projectInt term.",
      "source_rule_id": "rule-2f319fc608bca611d97f73f2eccd57da4594fe7eccf200e64ea8ed18a6d1d77c",
      "start_line": 20,
      "text": "  rule {V:Val}:>Int => projectInt(V)\n    requires definedProjectInt(V)\n    [symbolic(V), simplification, preserves-definedness]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "46034a138591ba84c5320bfdce28ff27c4aa3b71ab6d96d8b058b079aaf09395",
      "rationale": "Defines the projectInt collapse equation on values already of sort Int.",
      "source_rule_id": "rule-46034a138591ba84c5320bfdce28ff27c4aa3b71ab6d96d8b058b079aaf09395",
      "start_line": 23,
      "text": "  rule projectInt(I:Int) => I [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "a84abb0c9f7460007105f14618fe68e01c23ed95d5e76276d9dbbbf6caaaa4ab",
      "rationale": "Defines the rowVals structural projection for a list value by returning its contained ValSeq.",
      "source_rule_id": "rule-a84abb0c9f7460007105f14618fe68e01c23ed95d5e76276d9dbbbf6caaaa4ab",
      "start_line": 27,
      "text": "  rule rowVals(list(VS)) => VS [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "ba030e77444ea0ae71094841ccfc19ed9c36a3a4d7d781feeba64d83869abd91",
      "rationale": "Defines the named isListVal predicate through equality with the list reconstructed from rowVals.",
      "source_rule_id": "rule-ba030e77444ea0ae71094841ccfc19ed9c36a3a4d7d781feeba64d83869abd91",
      "start_line": 30,
      "text": "  rule isListVal(V) => V ==K list(rowVals(V))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 37,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "d485439b4f9a7bc2e21a43a788c49763ed95bb43ce67c13ed8de6c7ae72e5684",
      "rationale": "Defines the empty-sequence base case of the recursive allBinary domain predicate.",
      "source_rule_id": "rule-d485439b4f9a7bc2e21a43a788c49763ed95bb43ce67c13ed8de6c7ae72e5684",
      "start_line": 37,
      "text": "  rule allBinary(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 42,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "39d37bb16064c309a28bcf1621f1b5d89ffcb8e6e081129875411ff8b13e3020",
      "rationale": "Defines the structurally recursive nonempty case of allBinary, including the exact 0-or-1 head condition.",
      "source_rule_id": "rule-39d37bb16064c309a28bcf1621f1b5d89ffcb8e6e081129875411ff8b13e3020",
      "start_line": 38,
      "text": "  rule allBinary(vCons(V, VS))\n    => isInt(V)\n       andBool (V ==K projectInt(V))\n       andBool (projectInt(V) ==Int 0 orBool projectInt(V) ==Int 1)\n       andBool allBinary(VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "1881128594a7caf02b04803f8a2dfcfc888430ef33bfa5b8a5caabafcdd6327e",
      "rationale": "Defines the empty-grid base case of the recursive allRows domain predicate.",
      "source_rule_id": "rule-1881128594a7caf02b04803f8a2dfcfc888430ef33bfa5b8a5caabafcdd6327e",
      "start_line": 44,
      "text": "  rule allRows(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 46,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "5ff5b6060b1a32de00d5fe758e5eaf41e5a1abf0b58b43d5e111a32c905a2fc8",
      "rationale": "Defines the structurally recursive nonempty case of allRows from isListVal, allBinary, and the remaining rows.",
      "source_rule_id": "rule-5ff5b6060b1a32de00d5fe758e5eaf41e5a1abf0b58b43d5e111a32c905a2fc8",
      "start_line": 45,
      "text": "  rule allRows(vCons(V, VS))\n    => isListVal(V) andBool allBinary(rowVals(V)) andBool allRows(VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 54,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "41943ae4d2d233c4fc22178aa9c1fc1f6c7d9fd9d3c074edcb6f474c9c114cc3",
      "rationale": "Defines the zero base case of the mathematical rowSum recurrence.",
      "source_rule_id": "rule-41943ae4d2d233c4fc22178aa9c1fc1f6c7d9fd9d3c074edcb6f474c9c114cc3",
      "start_line": 54,
      "text": "  rule rowSum(.ValSeq)       => 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 55,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "86b1ccf093b81e9c9d9ca5149e3534f3b4b7600685efab3663b1175e00d352f2",
      "rationale": "Defines the nonempty rowSum recurrence by adding the head's integer value to the tail summary.",
      "source_rule_id": "rule-86b1ccf093b81e9c9d9ca5149e3534f3b4b7600685efab3663b1175e00d352f2",
      "start_line": 55,
      "text": "  rule rowSum(vCons(V, VS))  => intOf(V) +Int rowSum(VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 62,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "64d73f88068d2576ba631bbefba2d4b4d016acc401b9b48b4abfb2466e99b7fb",
      "rationale": "Defines bucketCost for positive capacity using the exact integer-floor expression summarized by the proof.",
      "source_rule_id": "rule-64d73f88068d2576ba631bbefba2d4b4d016acc401b9b48b4abfb2466e99b7fb",
      "start_line": 59,
      "text": "  rule bucketCost(VS, C)\n    => ((rowSum(VS) +Int C -Int 1)\n          -Int pyMod(rowSum(VS) +Int C -Int 1, C)) /Int C\n    requires C >Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 64,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "d212810cc7f5c01a08d820bb3797b78d481037be2ba27fcf8d82366426404bfb",
      "rationale": "Defines the disjoint nonpositive-capacity totalization branch of bucketCost.",
      "source_rule_id": "rule-d212810cc7f5c01a08d820bb3797b78d481037be2ba27fcf8d82366426404bfb",
      "start_line": 63,
      "text": "  rule bucketCost(_VS, C) => 0\n    requires C <=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 66,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "d64dccd6306357f40c9b821cb592e9b1ae30964f44f52576617a90c97cb434cb",
      "rationale": "Defines the empty-grid base case of the gridCost recurrence.",
      "source_rule_id": "rule-d64dccd6306357f40c9b821cb592e9b1ae30964f44f52576617a90c97cb434cb",
      "start_line": 66,
      "text": "  rule gridCost(.ValSeq, _C)      => 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 67,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "8e4ed42ce768056a9a2107e00bc2962b9a3f934581c589d848903da0a97a8dc2",
      "rationale": "Defines the nonempty gridCost recurrence as the head-row bucket cost plus the tail-grid cost.",
      "source_rule_id": "rule-8e4ed42ce768056a9a2107e00bc2962b9a3f934581c589d848903da0a97a8dc2",
      "start_line": 67,
      "text": "  rule gridCost(vCons(V, VS), C)  => bucketCost(rowVals(V), C) +Int gridCost(VS, C)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 72,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "63b8f99214b24f4293f9007e279bd8591f69b68897b3583455f02e39940ab1a8",
      "rationale": "Defines finalRow on an empty suffix as the previously bound loop-target value.",
      "source_rule_id": "rule-63b8f99214b24f4293f9007e279bd8591f69b68897b3583455f02e39940ab1a8",
      "start_line": 72,
      "text": "  rule finalRow(.ValSeq, PREV)       => PREV"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 73,
      "module": "MAX-FILL-SUMMARY",
      "normalized_sha256": "979fbd648068a0707834be206f2ec357c17842a5f3a3e6191fbe12989c1a186c",
      "rationale": "Defines the structurally recursive finalRow step by carrying the current head as the new previous value.",
      "source_rule_id": "rule-979fbd648068a0707834be206f2ec357c17842a5f3a3e6191fbe12989c1a186c",
      "start_line": 73,
      "text": "  rule finalRow(vCons(V, VS), _PREV) => finalRow(VS, V)"
    }
  ],
