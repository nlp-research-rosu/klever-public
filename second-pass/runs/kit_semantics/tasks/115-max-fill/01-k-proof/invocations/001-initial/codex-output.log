+++ b/verification.k
@@ -0,0 +1,49 @@
+requires "reference-semantics/semantics.k"
+
+module MAX-FILL-VERIFICATION
+  imports MPY
+
+  // An inductive presentation of exactly the values admitted by the prompt:
+  // every row element is either the Python integer 0 or the Python integer 1.
+  syntax Bit     ::= "b0" | "b1"
+  syntax BitSeq  ::= ".BitSeq" | bCons(Bit, BitSeq)
+  syntax GridSeq ::= ".GridSeq" | gCons(BitSeq, GridSeq)
+
+  // Proof encodings into the fixed semantics' ordinary Python list values.
+  syntax ValSeq ::= bitVals(BitSeq)   [function, total]
+  syntax ValSeq ::= gridVals(GridSeq) [function, total]
+
+  rule bitVals(.BitSeq)       => .ValSeq
+  rule bitVals(bCons(b0, BS)) => vCons(0, bitVals(BS))
+  rule bitVals(bCons(b1, BS)) => vCons(1, bitVals(BS))
+
+  rule gridVals(.GridSeq)       => .ValSeq
+  rule gridVals(gCons(BS, GSS)) => vCons(list(bitVals(BS)), gridVals(GSS))
+
+  // Mathematical summaries. bucketCost is the exact positive-divisor
+  // integer-floor expression used by MPY-INT for Python's // operator.
+  syntax Int ::= bitSum(BitSeq)           [function, total]
+               | bucketCost(BitSeq, Int)  [function, total]
+               | gridCost(GridSeq, Int)   [function, total]
+
+  rule bitSum(.BitSeq)       => 0
+  rule bitSum(bCons(b0, BS)) => bitSum(BS)
+  rule bitSum(bCons(b1, BS)) => 1 +Int bitSum(BS)
+
+  rule bucketCost(BS, C)
+    => ((bitSum(BS) +Int C -Int 1)
+          -Int pyMod(bitSum(BS) +Int C -Int 1, C)) /Int C
+    requires C >Int 0
+  rule bucketCost(_BS, C) => 0
+    requires C <=Int 0
+
+  rule gridCost(.GridSeq, _C)       => 0
+  rule gridCost(gCons(BS, GSS), C)  => bucketCost(BS, C) +Int gridCost(GSS, C)
+
+  // The for target is initialized before the loop. This helper records the
+  // exact value left in it after consuming an arbitrary suffix.
+  syntax Val ::= finalRow(GridSeq, Val) [function, total]
+  rule finalRow(.GridSeq, PREV)       => PREV
+  rule finalRow(gCons(BS, GSS), _PREV)
+    => finalRow(GSS, list(bitVals(BS)))
+endmodule

