+          closureVal(
+            ("grid", "capacity"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("row"), Int(0))
+            For(
+              Name("row"),
+              Name("grid"),
+              AugAssign(
+                Name("total"),
+                "+",
+                BinOp(
