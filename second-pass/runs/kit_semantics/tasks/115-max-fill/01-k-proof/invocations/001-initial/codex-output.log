+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "max_fill" |->
+          closureVal(
+            ("grid", "capacity"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("row"), Int(0))
+            For(
+              Name("row"),
