+  claim [grid-loop]:
+    <k> #loop(
+          list(GS:ValSeq),
+          Name("row"),
+          AugAssign(
+            Name("total"),
+            "+",
+            BinOp(
+              "//",
+              BinOp(
+                "-",
+                BinOp("+", Call(Name("sum"), Name("row")), Name("capacity")),
