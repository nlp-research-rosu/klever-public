+requires "verification.k"
+
+module MAX-FILL-SPEC
+  imports MAX-FILL-VERIFICATION
+
+  // Fixed-semantics auxiliary circularity for sum(row).
+  claim [sum-loop]:
+    <k> #sumAcc(list(VS:ValSeq), A:Int)
+          => A +Int rowSum(VS) ... </k>
+    requires allBinary(VS)
+
+  // Program-loop circularity. The body is the exact AST emitted in solution.mpy.
+  claim [grid-loop]:
+    <k> #loop(
+          list(GS:ValSeq),
+          Name("row"),
+          AugAssign(
+            Name("total"),
+            "+",
+            BinOp(
+              "//",
+              BinOp(
+                "-",
+                BinOp("+", Call(Name("sum"), Name("row")), Name("capacity")),
+                Int(1)),
+              Name("capacity"))))
+          => .K
+          ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+            "capacity" |-> C:Int
+            "grid"     |-> _ORIGINAL_GRID:Val
+            "total"    |-> (S:Int => S +Int gridCost(GS, C))
+            "row"      |-> (PREV:Val => finalRow(GS, PREV))
+            .Map,
+            parent(0))
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    requires C >Int 0
+      andBool allRows(GS)
+      andBool notBool ("sum" in_keys(GLOBALS))
+
+  // Exact invocation theorem: normal lookup selects the exact closure body,
+  // arguments are evaluated and bound by MPY-CALL, and return/pop execute.
+  claim [max-fill]:
+    <k> Call(Name("max_fill"), list(GS:ValSeq), C:Int)
+          => gridCost(GS, C) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "max_fill" |->
+          closureVal(
+            ("grid", "capacity"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("row"), Int(0))
+            For(
+              Name("row"),
+              Name("grid"),
+              AugAssign(
+                Name("total"),
+                "+",
+                BinOp(
+                  "//",
+                  BinOp(
+                    "-",
+                    BinOp(
+                      "+",
+                      Call(Name("sum"), Name("row")),
+                      Name("capacity")),
+                    Int(1)),
+                  Name("capacity"))))
+            Return(Name("total")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires C >Int 0 andBool allRows(GS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2ca4189f76a3570394f9e8c69e02addca7366163
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,92 @@
+requires "reference-semantics/semantics.k"
+
+module MAX-FILL-SUMMARY
+  imports MPY
+
+  // Guarded total projections for the dynamic Val supersort. Their values are
+  // used only under the matching sort/constructor guards below.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V) => isInt(V)
+
+  syntax Int ::= projectInt(Val)
+    [function, total, symbol(maxFillProjectInt), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectInt(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectInt(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectInt(I:Int) => I [simplification]
+
+  syntax ValSeq ::= rowVals(Val)
+    [function, total, symbol(maxFillRowVals), no-evaluators]
+  rule rowVals(list(VS)) => VS [simplification]
+
+  syntax Bool ::= isListVal(Val) [function, total]
+  rule isListVal(V) => V ==K list(rowVals(V))
+
+  // Domain predicates. allRows permits any finite number and length of rows,
+  // but every element must be an integer 0 or 1.
+  syntax Bool ::= allBinary(ValSeq) [function, total]
+                | allRows(ValSeq)   [function, total]
+
+  rule allBinary(.ValSeq) => true
+  rule allBinary(vCons(V, VS))
+    => isInt(V)
+       andBool (V ==K projectInt(V))
+       andBool (projectInt(V) ==Int 0 orBool projectInt(V) ==Int 1)
+       andBool allBinary(VS)
+
+  rule allRows(.ValSeq) => true
+  rule allRows(vCons(V, VS))
+    => isListVal(V) andBool allBinary(rowVals(V)) andBool allRows(VS)
+
+  // Exact value summaries. rowSum deliberately uses MPY-BUILTINS' intOf:
+  // on allBinary rows that is exactly the transition performed by #sumAcc.
+  syntax Int ::= rowSum(ValSeq)          [function, total]
+               | bucketCost(ValSeq, Int) [function, total]
+               | gridCost(ValSeq, Int)   [function, total]
+
+  rule rowSum(.ValSeq)       => 0
+  rule rowSum(vCons(V, VS))  => intOf(V) +Int rowSum(VS)
+
+  // This is MPY-INT's exact positive-divisor // equation, after the numerator
+  // expression in solution.py has evaluated.
+  rule bucketCost(VS, C)
+    => ((rowSum(VS) +Int C -Int 1)
+          -Int pyMod(rowSum(VS) +Int C -Int 1, C)) /Int C
+    requires C >Int 0
+  rule bucketCost(_VS, C) => 0
+    requires C <=Int 0
+
+  rule gridCost(.ValSeq, _C)      => 0
+  rule gridCost(vCons(V, VS), C)  => bucketCost(rowVals(V), C) +Int gridCost(VS, C)
+
+  // The for target is initialized before the loop. This helper records the
+  // exact value left in it after consuming an arbitrary suffix.
+  syntax Val ::= finalRow(ValSeq, Val) [function, total]
+  rule finalRow(.ValSeq, PREV)       => PREV
+  rule finalRow(vCons(V, VS), _PREV) => finalRow(VS, V)
+
+endmodule
+
+module MAX-FILL-VERIFICATION
+  imports MAX-FILL-SUMMARY
+
+  // Guarded static-dispatch twin of MPY-BUILTINS' intOf(I:Int) => I.
+  rule intOf(V:Val) => projectInt(V)
+    requires isInt(V)
+    [simplification]
+
+  // Guarded dispatch twin for the existing MPY-CALL sum rule. isListVal(V)
+  // is definitionally V ==K list(rowVals(V)), so the RHS is exactly the fixed
+  // rule's #sumAcc(V, 0). No continuation or state cell is changed.
+  rule <k> #applyK(toCall(builtinV("sum")), (V:Val, .Vals))
+        => #sumAcc(list(rowVals(V)), 0) ... </k>
+    requires isListVal(V)
+    [priority(40)]
+endmodule

diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..817840b8804551cea624c366cdd914493f900e7c
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+// This module is proved against a definition whose main module is
+// MAX-FILL-SUMMARY, so neither dispatch twin in MAX-FILL-VERIFICATION exists
+// in the executable theory.
+module MAX-FILL-CONNECTION-SPEC
+  imports MAX-FILL-SUMMARY
+
+  claim [fixed-int-of]:
+    <k> intOf(I:Int) => I ... </k>
+
+  claim [fixed-sum-dispatch]:
+    <k> #applyK(toCall(builtinV("sum")), (list(VS:ValSeq), .Vals))
+          => #sumAcc(list(VS), 0) ... </k>
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b1dd4db87456f6df38e854c8673add10ce7ffc8
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,65 @@
+from itertools import product
+from random import Random
+
+from solution import max_fill
+
+
+def extraction_oracle(grid, capacity):
+    dips = 0
+    for row in grid:
+        water = 0
+        for cell in row:
+            if cell == 1:
+                water += 1
+        while water > 0:
+            water -= capacity
+            dips += 1
+    return dips
+
+
+def check(grid, capacity):
+    actual = max_fill(grid, capacity)
+    expected = extraction_oracle(grid, capacity)
+    if actual != expected:
+        raise AssertionError((grid, capacity, actual, expected))
+
+
+cases = 0
+
+# Exhaust every binary grid through 3x4, including the proof's empty/ragged
+# boundary shapes, for capacities 1 through 4.
+check([], 1)
+cases += 1
+for height in range(1, 4):
+    for width in range(0, 5):
+        for flat in product((0, 1), repeat=height * width):
+            grid = [
+                list(flat[row * width:(row + 1) * width])
+                for row in range(height)
+            ]
+            for capacity in range(1, 5):
+                check(grid, capacity)
+                cases += 1
+
+# Prompt-boundary cases and a seeded broader sample over the stated domain.
+for grid, capacity in (
+    ([[0] * 100 for _ in range(100)], 10),
+    ([[1] * 100 for _ in range(100)], 1),
+    ([[1] * 100 for _ in range(100)], 10),
+):
+    check(grid, capacity)
+    cases += 1
+
+rng = Random(20260729)
+for _ in range(250):
+    height = rng.randint(1, 100)
+    width = rng.randint(1, 100)
+    grid = [
+        [rng.randint(0, 1) for _ in range(width)]
+        for _ in range(height)
+    ]
+    capacity = rng.randint(1, 10)
+    check(grid, capacity)
+    cases += 1
+
+print(f"cases={cases} mismatches=0")
