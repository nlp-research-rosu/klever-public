Module(
  FuncDef("max_fill", Params("grid", "capacity"),
    Assign(Name("total"), Int(0))
    Assign(Name("row"), Int(0))
    For(Name("row"), Name("grid"),
      AugAssign(
        Name("total"),
        "+",
        BinOp(
          "//",
          BinOp(
            "-",
            BinOp("+", Call(Name("sum"), Name("row")), Name("capacity")),
            Int(1)),
          Name("capacity"))))
    Return(Name("total")))
  Assert(
    Compare(
      Call(
        Name("max_fill"),
        ListExpr(
          ListExpr(Int(0), Int(0), Int(1), Int(0)),
          ListExpr(Int(0), Int(1), Int(0), Int(0)),
          ListExpr(Int(1), Int(1), Int(1), Int(1))),
        Int(1)),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(
        Name("max_fill"),
        ListExpr(
          ListExpr(Int(0), Int(0), Int(1), Int(1)),
          ListExpr(Int(0), Int(0), Int(0), Int(0)),
          ListExpr(Int(1), Int(1), Int(1), Int(1)),
          ListExpr(Int(0), Int(1), Int(1), Int(1))),
        Int(2)),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(
        Name("max_fill"),
        ListExpr(
          ListExpr(Int(0), Int(0), Int(0)),
          ListExpr(Int(0), Int(0), Int(0))),
        Int(5)),
      CmpOp("==", Int(0)))))
