Module(
  FuncDef("max_fill", Params("grid", "capacity"),
    Assign(Name("total"), Int(0))
    Assign(Name("row"), Int(0))
    For(Name("row"), Name("grid"),
      AugAssign(
        Name("total"),
        "+",
        BinOp(
          "//",
          BinOp(
            "-",
            BinOp("+", Call(Name("sum"), Name("row")), Name("capacity")),
            Int(1)),
          Name("capacity"))))
    Return(Name("total"))))
