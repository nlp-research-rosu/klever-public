+                    "-",
+                    BinOp(
+                      "+",
+                      Call(Name("sum"), Name("row")),
+                      Name("capacity")),
+                    Int(1)),
+                  Name("capacity"))))
+            Return(Name("total")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
