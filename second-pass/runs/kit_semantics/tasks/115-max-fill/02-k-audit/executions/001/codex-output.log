+      andBool gridCost(
+        vCons(list(vCons(1, .ValSeq)), .ValSeq),
+        1) ==Int 1
+
+  claim [ground-entry-execution]:
+    <k> Call(
+          Name("max_fill"),
+          list(vCons(list(vCons(1, .ValSeq)), .ValSeq)),
+          1)
+          => 1 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "max_fill" |->
+          closureVal(
+            ("grid", "capacity"),
