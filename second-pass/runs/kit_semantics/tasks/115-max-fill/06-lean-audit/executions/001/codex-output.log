@@ -0,0 +1,76 @@
+import Proof
+
+open Klean115MaxFill.Lemmas
+
+def badPredicateFalse : SortVal → SortBool := fun _ => false
+def badPredicateTrue : SortVal → SortBool := fun _ => true
+
+def badProjectZero : SortK → Option SortInt
+  | .kseq (.inj_SortInt _) .dotk => some 0
+  | _ => none
+
+example :
+    Proof.«definedProjectInt(_)_MAX-FILL-SUMMARY_Bool_Val»
+      (.inj_SortInt 7) = true := rfl
+
+example :
+    Proof.«definedProjectInt(_)_MAX-FILL-SUMMARY_Bool_Val»
+      (.inj_SortBool false) = false := rfl
+
+example :
+    Proof.«definedProjectInt(_)_MAX-FILL-SUMMARY_Bool_Val»
+      .«noneV_MPY-CORE_Val» = false := rfl
+
+example :
+    Proof.«project:Int?»
+      (.kseq (.inj_SortInt 7) .dotk) = some 7 := rfl
+
+example :
+    Proof.«project:Int?»
+      (.kseq (.inj_SortBool false) .dotk) = none := rfl
+
+example :
+    Proof.«project:Int?»
+      (.kseq (.inj_SortInt 7) (.kseq (.inj_SortInt 8) .dotk)) = none := rfl
+
+example :
+    ¬ targetStatement badPredicateFalse Proof.«project:Int?» := by
+  intro h
+  have witness := h (.inj_SortInt 7)
+  simp [badPredicateFalse, Proof.«project:Int?»] at witness
+  change (some 7 : Option SortInt) = none at witness
+  cases witness
+
+example :
+    ¬ targetStatement badPredicateTrue Proof.«project:Int?» := by
+  intro h
+  have witness := h (.inj_SortBool false)
+  simp [badPredicateTrue, Proof.«project:Int?»] at witness
+  change (none : Option SortInt).isSome = true at witness
+  cases witness
+
+/- The domain-only generated equation cannot constrain the projected integer's
+   value. This deliberately wrong projection still proves it, so the separate
+   operational-bridge audit must compare the candidate body with K's projection. -/
+theorem badProjectZeroStillProvesDomainEquation :
+    targetStatement
+      Proof.«definedProjectInt(_)_MAX-FILL-SUMMARY_Bool_Val»
+      badProjectZero := by
+  have andTrue (p : Prop) : p ↔ p ∧ True :=
+    ⟨fun hp => ⟨hp, True.intro⟩, fun hp => hp.1⟩
+  intro V
+  cases V <;> exact andTrue _
+
+example :
+    badProjectZero (.kseq (.inj_SortInt 7) .dotk) = some 0 := rfl
+
+example :
+    badProjectZero (.kseq (.inj_SortInt 7) .dotk) ≠
+      Proof.«project:Int?» (.kseq (.inj_SortInt 7) .dotk) := by
+  decide
+
+#eval Proof.«definedProjectInt(_)_MAX-FILL-SUMMARY_Bool_Val» (.inj_SortInt 7)
+#eval Proof.«definedProjectInt(_)_MAX-FILL-SUMMARY_Bool_Val» (.inj_SortBool false)
+#eval Proof.«project:Int?» (.kseq (.inj_SortInt 7) .dotk)
+#eval Proof.«project:Int?» (.kseq (.inj_SortBool false) .dotk)
+#eval badProjectZero (.kseq (.inj_SortInt 7) .dotk)
