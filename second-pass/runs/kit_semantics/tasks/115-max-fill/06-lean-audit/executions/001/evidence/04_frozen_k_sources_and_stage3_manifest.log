     2	  FuncDef("max_fill", Params("grid", "capacity"),
     3	    Assign(Name("total"), Int(0))
     4	    Assign(Name("row"), Int(0))
     5	    For(Name("row"), Name("grid"),
     6	      AugAssign(
     7	        Name("total"),
     8	        "+",
