+ nl -ba /reference/k-proof/solution.py
     1	def max_fill(grid, capacity):
     2	    total = 0
     3	    row = 0
     4	    for row in grid:
     5	        total += (sum(row) + capacity - 1) // capacity
     6	    return total
+ nl -ba /reference/k-proof/solution.mpy
