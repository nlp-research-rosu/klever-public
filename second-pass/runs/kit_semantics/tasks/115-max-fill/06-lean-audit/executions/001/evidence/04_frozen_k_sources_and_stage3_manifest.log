     9	  rule definedProjectInt(V) => isInt(V)
    10	
    11	  syntax Int ::= projectInt(Val)
    12	    [function, total, symbol(maxFillProjectInt), no-evaluators]
    13	
    14	  rule #Ceil({@V:Val}:>Int)
    15	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    16	    [simplification]
    17	  rule projectInt(V:Val) => {V}:>Int
    18	    requires definedProjectInt(V)
    19	    [concrete, simplification(10), preserves-definedness]
    20	  rule {V:Val}:>Int => projectInt(V)
    21	    requires definedProjectInt(V)
    22	    [symbolic(V), simplification, preserves-definedness]
    23	  rule projectInt(I:Int) => I [simplification]
    24	
    25	  syntax ValSeq ::= rowVals(Val)
    26	    [function, total, symbol(maxFillRowVals), no-evaluators]
    27	  rule rowVals(list(VS)) => VS [simplification]
    28	
    29	  syntax Bool ::= isListVal(Val) [function, total]
    30	  rule isListVal(V) => V ==K list(rowVals(V))
    31	
    32	  // Domain predicates. allRows permits any finite number and length of rows,
    33	  // but every element must be an integer 0 or 1.
    34	  syntax Bool ::= allBinary(ValSeq) [function, total]
    35	                | allRows(ValSeq)   [function, total]
    36	
    37	  rule allBinary(.ValSeq) => true
    38	  rule allBinary(vCons(V, VS))
    39	    => isInt(V)
    40	       andBool (V ==K projectInt(V))
    41	       andBool (projectInt(V) ==Int 0 orBool projectInt(V) ==Int 1)
    42	       andBool allBinary(VS)
    43	
    44	  rule allRows(.ValSeq) => true
    45	  rule allRows(vCons(V, VS))
    46	    => isListVal(V) andBool allBinary(rowVals(V)) andBool allRows(VS)
    47	
    48	  // Exact value summaries. rowSum deliberately uses MPY-BUILTINS' intOf:
    49	  // on allBinary rows that is exactly the transition performed by #sumAcc.
    50	  syntax Int ::= rowSum(ValSeq)          [function, total]
    51	               | bucketCost(ValSeq, Int) [function, total]
    52	               | gridCost(ValSeq, Int)   [function, total]
    53	
    54	  rule rowSum(.ValSeq)       => 0
    55	  rule rowSum(vCons(V, VS))  => intOf(V) +Int rowSum(VS)
    56	
    57	  // This is MPY-INT's exact positive-divisor // equation, after the numerator
    58	  // expression in solution.py has evaluated.
    59	  rule bucketCost(VS, C)
    60	    => ((rowSum(VS) +Int C -Int 1)
    61	          -Int pyMod(rowSum(VS) +Int C -Int 1, C)) /Int C
    62	    requires C >Int 0
    63	  rule bucketCost(_VS, C) => 0
    64	    requires C <=Int 0
    65	
    66	  rule gridCost(.ValSeq, _C)      => 0
    67	  rule gridCost(vCons(V, VS), C)  => bucketCost(rowVals(V), C) +Int gridCost(VS, C)
    68	
    69	  // The for target is initialized before the loop. This helper records the
    70	  // exact value left in it after consuming an arbitrary suffix.
    71	  syntax Val ::= finalRow(ValSeq, Val) [function, total]
    72	  rule finalRow(.ValSeq, PREV)       => PREV
    73	  rule finalRow(vCons(V, VS), _PREV) => finalRow(VS, V)
    74	
    75	endmodule
