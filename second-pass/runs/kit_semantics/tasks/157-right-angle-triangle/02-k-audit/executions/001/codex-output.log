     7	
     8	def oracle(a, b, c):
     9	    x, y, z = sorted((a, b, c))
    10	    return x * x + y * y == z * z
    11	
    12	
    13	examples = [
    14	    (3, 4, 5, True),
    15	    (1, 2, 3, False),
    16	    (5, 12, 13, True),
    17	    (6, 8, 10, True),
    18	    (2, 2, 3, False),
    19	    (3.0, 4.0, 5.0, True),
    20	    (1.5, 2.0, 2.5, True),
    21	    (3, 4.0, 5, True),
    22	    (1.0, 2, 3.0, False),
    23	    (0.3, 0.4, 0.5, True),
    24	]
    25	
    26	for a, b, c, expected in examples:
    27	    assert solution.right_angle_triangle(a, b, c) is expected
    28	
    29	mismatches = []
    30	tested = 0
    31	for a in range(1, 31):
    32	    for b in range(1, 31):
    33	        for c in range(1, 31):
    34	            tested += 1
    35	            actual = solution.right_angle_triangle(a, b, c)
    36	            expected = oracle(a, b, c)
    37	            if actual != expected:
    38	                mismatches.append((a, b, c, actual, expected))
    39	
    40	for a2 in range(1, 21):
    41	    for b2 in range(1, 21):
    42	        for c2 in range(1, 21):
    43	            a = a2 / 2
    44	            b = b2 / 2
    45	            c = c2 / 2
    46	            tested += 1
    47	            actual = solution.right_angle_triangle(a, b, c)
    48	            expected = oracle(a, b, c)
    49	            if actual != expected:
    50	                mismatches.append((a, b, c, actual, expected))
    51	
    52	solution_def = ast.parse(inspect.getsource(solution.right_angle_triangle)).body[0]
    53	concrete_def = ast.parse(
    54	    inspect.getsource(concrete_tests.right_angle_triangle)
    55	).body[0]
    56	assert ast.dump(solution_def) == ast.dump(concrete_def)
    57	assert not mismatches, mismatches[:10]
    58	
    59	print(
    60	    f"validation: examples={len(examples)}, "
    61	    f"positive_numeric_triples={tested}, mismatches={len(mismatches)}, "
    62	    "concrete_harness_ast=identical"
    63	)

