  rg -q '"'WarnStuckClaimState' false-result-output.txt || exit 91
  rg -q 'true ~> .K' false-result-output.txt || exit 92
  printf '%s\\n' 'EXPECTED_FAILURE_CONFIRMED: real submitted body returned true while mutated obligation required false'
  exit 0
} 2>&1 | tee /audit-output/evidence/06-false-result.log" in /tmp/audit-work/reconstruction
