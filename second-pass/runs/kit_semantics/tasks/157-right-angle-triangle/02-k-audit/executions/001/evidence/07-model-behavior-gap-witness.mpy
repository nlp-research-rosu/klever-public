Module(
  FuncDef("right_angle_triangle", Params("a", "b", "c"),
    Return(
      BoolOp(
        "or",
        Compare(
          BinOp("*", Name("a"), Name("a")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("b"), Name("b")),
              BinOp("*", Name("c"), Name("c"))))),
        Compare(
          BinOp("*", Name("b"), Name("b")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("a"), Name("a")),
              BinOp("*", Name("c"), Name("c"))))),
        Compare(
          BinOp("*", Name("c"), Name("c")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("a"), Name("a")),
              BinOp("*", Name("b"), Name("b"))))))))
  Assign(
    Name("result"),
    Call(
      Name("right_angle_triangle"),
      BinOp("**", Int(10), Int(308)),
      Float(1e+308),
      Float(1e+308))))
