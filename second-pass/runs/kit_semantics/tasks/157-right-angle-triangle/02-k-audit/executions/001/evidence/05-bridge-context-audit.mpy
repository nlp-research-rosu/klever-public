Module(
  Assign(Name("x"), Int(0))
  If(Compare(Float(1.0), CmpOp("==", Float(1.0))),
    Assign(Name("x"), Int(11)),
    Assign(Name("x"), Int(12)))
  Assert(Compare(Name("x"), CmpOp("==", Int(11))))
  Assign(Name("y"), Int(0))
  If(Compare(Float(1.0), CmpOp("==", Float(2.0))),
    Assign(Name("y"), Int(21)),
    Assign(Name("y"), Int(22)))
  Assert(Compare(Name("y"), CmpOp("==", Int(22))))
  Assert(
    Compare(
      BoolOp(
        "or",
        Compare(Float(3.0), CmpOp("==", Float(3.0))),
        Bool(false)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      BoolOp(
        "or",
        Compare(Float(3.0), CmpOp("==", Float(4.0))),
        Bool(false)),
      CmpOp("==", Bool(false)))))
