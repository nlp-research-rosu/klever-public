      "end_line": 88,
      "module": "VERIFICATION",
      "normalized_sha256": "1afabb2501ba90f7b6b2f4a191175e8345881ad804004a8236b0d9f6c1f2938b",
      "rationale": "This equation defines the Float-by-Float case of ratEq in terms of the named trustedFloatEq proof term.",
      "source_rule_id": "rule-1afabb2501ba90f7b6b2f4a191175e8345881ad804004a8236b0d9f6c1f2938b",
      "start_line": 88,
      "text": "  rule ratEq(F1:Float, F2:Float) => trustedFloatEq(F1, F2)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 89,
      "module": "VERIFICATION",
      "normalized_sha256": "f057392d9a01c96d24175b0d4f7208b353fa74cbca6db6a0fe229d27cbb63742",
      "rationale": "This equation defines the Int-by-Float case of ratEq using the supplied mixed numeric equality operation eqIF.",
      "source_rule_id": "rule-f057392d9a01c96d24175b0d4f7208b353fa74cbca6db6a0fe229d27cbb63742",
      "start_line": 89,
      "text": "  rule ratEq(I:Int,    F:Float)  => eqIF(I, F)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 90,
      "module": "VERIFICATION",
      "normalized_sha256": "b0af0664109d2a9418b589eebb1c7d92db991a458e003b53c3df708fa93f9f96",
      "rationale": "This equation defines the Float-by-Int case of ratEq using the supplied mixed numeric equality operation eqIF with its canonical argument order.",
      "source_rule_id": "rule-b0af0664109d2a9418b589eebb1c7d92db991a458e003b53c3df708fa93f9f96",
      "start_line": 90,
      "text": "  rule ratEq(F:Float,  I:Int)    => eqIF(I, F)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 95,
      "module": "VERIFICATION",
      "normalized_sha256": "d8d41e07eca28f709366e4001ff4bb2533907409c202365ff87267e3f7c2a3c5",
      "rationale": "This equation defines ratExpected by composing the square, addition, and equality summaries into the three Pythagorean alternatives.",
      "source_rule_id": "rule-d8d41e07eca28f709366e4001ff4bb2533907409c202365ff87267e3f7c2a3c5",
      "start_line": 92,
      "text": "  rule ratExpected(A:Val, B:Val, C:Val)\n    => ratEq(ratSquare(A), ratAdd(ratSquare(B), ratSquare(C)))\n       orBool ratEq(ratSquare(B), ratAdd(ratSquare(A), ratSquare(C)))\n       orBool ratEq(ratSquare(C), ratAdd(ratSquare(A), ratSquare(B)))"
    }
