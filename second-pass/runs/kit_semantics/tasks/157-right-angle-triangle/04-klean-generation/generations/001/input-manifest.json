{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 51,
      "module": "VERIFICATION",
      "normalized_sha256": "65ee359690c078f314b8315c3c94f6b34835bd20c0477637da6af76778cb6311",
      "rationale": "This nullary equation defines the named closure term by expanding it to the exact translated candidate body; it names program syntax and does not add a mathematical fact or perform an execution step.",
      "source_rule_id": "rule-65ee359690c078f314b8315c3c94f6b34835bd20c0477637da6af76778cb6311",
      "start_line": 9,
      "text": "  rule rightAngleTriangleClosure()\n    => closureVal(\n         (\"a\", \"b\", \"c\"),\n         Return(\n           BoolOp(\n             \"or\",\n             Compare(\n               BinOp(\"*\", Name(\"a\"), Name(\"a\")),\n               CmpOp(\n                 \"==\",\n                 BinOp(\n                   \"+\",\n                   BinOp(\"*\", Name(\"b\"), Name(\"b\")),\n                   BinOp(\"*\", Name(\"c\"), Name(\"c\"))\n                 )\n               )\n             ),\n             Compare(\n               BinOp(\"*\", Name(\"b\"), Name(\"b\")),\n               CmpOp(\n                 \"==\",\n                 BinOp(\n                   \"+\",\n                   BinOp(\"*\", Name(\"a\"), Name(\"a\")),\n                   BinOp(\"*\", Name(\"c\"), Name(\"c\"))\n                 )\n               )\n             ),\n             Compare(\n               BinOp(\"*\", Name(\"c\"), Name(\"c\")),\n               CmpOp(\n                 \"==\",\n                 BinOp(\n                   \"+\",\n                   BinOp(\"*\", Name(\"a\"), Name(\"a\")),\n                   BinOp(\"*\", Name(\"b\"), Name(\"b\"))\n                 )\n               )\n             )\n           )\n         ),\n         0\n       )"
    },
    {
      "attributes": [
        "concrete"
      ],
      "classification": "DEFINITION",
      "end_line": 60,
      "module": "VERIFICATION",
      "normalized_sha256": "a1eb58804a065f00833d0cbff55cae05f7761567a754ebd590c73ddaa855646c",
      "rationale": "This concrete equation defines how the named trustedFloatEq proof term evaluates under the concrete backend, namely by the existing Float equality hook; it is not separately proved or used as a symbolic derived lemma.",
      "source_rule_id": "rule-a1eb58804a065f00833d0cbff55cae05f7761567a754ebd590c73ddaa855646c",
      "start_line": 58,
      "text": "  rule trustedFloatEq(F1:Float, F2:Float)\n    => F1 ==Float F2\n    [concrete]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 79,
      "module": "VERIFICATION",
      "normalized_sha256": "b1545a06cd0d3ee4ecafe211cfda36d9751f52e9da5c1c1de2cbe40bac4f6a0d",
      "rationale": "This sort-specific equation defines the integer case of the ratSquare mathematical summary as integer multiplication.",
      "source_rule_id": "rule-b1545a06cd0d3ee4ecafe211cfda36d9751f52e9da5c1c1de2cbe40bac4f6a0d",
      "start_line": 79,
      "text": "  rule ratSquare(I:Int)   => I *Int I"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 80,
      "module": "VERIFICATION",
      "normalized_sha256": "31b9c981ad4580f01b7319d650db78633cceddfae0847e5882e90719f8f93a15",
      "rationale": "This sort-specific equation defines the Float case of the ratSquare mathematical summary using the supplied mulF operation.",
      "source_rule_id": "rule-31b9c981ad4580f01b7319d650db78633cceddfae0847e5882e90719f8f93a15",
      "start_line": 80,
      "text": "  rule ratSquare(F:Float) => mulF(F, F)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 82,
      "module": "VERIFICATION",
      "normalized_sha256": "aa80bc4e205f53786d399a0371853b4f4eae4815b58b747ea925bc44702ee37e",
      "rationale": "This equation defines the Int-by-Int case of the ratAdd summary as interpreted integer addition.",
      "source_rule_id": "rule-aa80bc4e205f53786d399a0371853b4f4eae4815b58b747ea925bc44702ee37e",
      "start_line": 82,
      "text": "  rule ratAdd(I1:Int,   I2:Int)   => I1 +Int I2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 83,
      "module": "VERIFICATION",
      "normalized_sha256": "9fb7033cdbeb63a2d02cc452e8e120a0703114f66571646d17900b17d023ccda",
      "rationale": "This equation defines the Float-by-Float case of the ratAdd summary using the supplied addF operation.",
      "source_rule_id": "rule-9fb7033cdbeb63a2d02cc452e8e120a0703114f66571646d17900b17d023ccda",
      "start_line": 83,
      "text": "  rule ratAdd(F1:Float, F2:Float) => addF(F1, F2)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 84,
      "module": "VERIFICATION",
      "normalized_sha256": "df4850e1b3b778356ac4b1e4fb8f71d6b6e16b0e00f292bd3c53d92dc38fff98",
      "rationale": "This equation defines the Int-by-Float case of ratAdd by applying the supplied integer-to-Float conversion and Float addition.",
      "source_rule_id": "rule-df4850e1b3b778356ac4b1e4fb8f71d6b6e16b0e00f292bd3c53d92dc38fff98",
      "start_line": 84,
      "text": "  rule ratAdd(I:Int,    F:Float)  => addF(intToF(I), F)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 85,
      "module": "VERIFICATION",
      "normalized_sha256": "26fd9a98998e60f90ca8da1882e9dd903042f49046e2e06c353ae351866725aa",
      "rationale": "This equation defines the Float-by-Int case of ratAdd by applying the supplied integer-to-Float conversion and Float addition.",
      "source_rule_id": "rule-26fd9a98998e60f90ca8da1882e9dd903042f49046e2e06c353ae351866725aa",
      "start_line": 85,
      "text": "  rule ratAdd(F:Float,  I:Int)    => addF(F, intToF(I))"
    },
    {
