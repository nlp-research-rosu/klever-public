      "normalized_sha256": "010bd337cb206f908725187e688369f657100fa2471779046a1410fbc1698f55",
      "rationale": "This equation defines the Int-by-Int case of the ratEq summary as interpreted integer equality.",
      "source_rule_id": "rule-010bd337cb206f908725187e688369f657100fa2471779046a1410fbc1698f55",
      "start_line": 87,
      "text": "  rule ratEq(I1:Int,   I2:Int)   => I1 ==Int I2"
    },
    {
      "attributes": [],
