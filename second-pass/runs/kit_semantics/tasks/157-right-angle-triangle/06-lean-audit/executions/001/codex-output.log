diff --git a//tmp/audit-work/lean_app_path_shim.c b//tmp/audit-work/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..3f69f7a5c50b78ec11d6a647159fcf0352b73712
--- /dev/null
+++ b//tmp/audit-work/lean_app_path_shim.c
@@ -0,0 +1,72 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static int is_proc_exe(const char *path) {
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) return 0;
+    const char *tail = strrchr(path, '/');
+    return tail != NULL && strcmp(tail, "/exe") == 0;
+}
+
+static const char *lean_app_path(void) {
+    static char result[PATH_MAX];
+    char command[PATH_MAX];
+    int fd = open("/proc/self/cmdline", O_RDONLY);
+    if (fd < 0) return NULL;
+    ssize_t count = read(fd, command, sizeof(command) - 1);
+    close(fd);
+    if (count <= 0) return NULL;
+    command[count] = '\0';
+    const char *base = strrchr(command, '/');
+    base = base == NULL ? command : base + 1;
+    if (strcmp(base, "lean") != 0 && strcmp(base, "lake") != 0 &&
+        strcmp(base, "leanc") != 0 && strcmp(base, "leanchecker") != 0 &&
+        strcmp(base, "leanmake") != 0 && strcmp(base, "leanpkg") != 0) {
+        return NULL;
+    }
+    int written = snprintf(
+        result,
+        sizeof(result),
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/%s",
+        base
+    );
+    return written > 0 && (size_t)written < sizeof(result) ? result : NULL;
+}
+
+static ssize_t copy_path(const char *source, char *buffer, size_t size) {
+    size_t length = strlen(source);
+    if (size == 0) return 0;
+    size_t copied = length < size ? length : size;
+    memcpy(buffer, source, copied);
+    return (ssize_t)copied;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+    const char *replacement = is_proc_exe(path) ? lean_app_path() : NULL;
+    if (replacement != NULL) return copy_path(replacement, buffer, size);
+    if (real_readlink == NULL) real_readlink = dlsym(RTLD_NEXT, "readlink");
+    if (real_readlink == NULL) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return real_readlink(path, buffer, size);
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buffer, size_t size) {
+    static ssize_t (*real_readlinkat)(int, const char *, char *, size_t) = NULL;
+    const char *replacement = is_proc_exe(path) ? lean_app_path() : NULL;
+    if (replacement != NULL) return copy_path(replacement, buffer, size);
+    if (real_readlinkat == NULL) real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+    if (real_readlinkat == NULL) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return real_readlinkat(dirfd, path, buffer, size);
+}

