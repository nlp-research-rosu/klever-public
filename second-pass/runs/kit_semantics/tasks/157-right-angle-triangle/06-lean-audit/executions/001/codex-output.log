     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Exact translated body of solution.py, named only to keep the eight
     7	  // Int/Float sort-combination claims identical at the call boundary.
     8	  syntax Val ::= rightAngleTriangleClosure() [function, total]
     9	  rule rightAngleTriangleClosure()
    10	    => closureVal(
    11	         ("a", "b", "c"),
    12	         Return(
    13	           BoolOp(
    14	             "or",
    15	             Compare(
    16	               BinOp("*", Name("a"), Name("a")),
    17	               CmpOp(
    18	                 "==",
    19	                 BinOp(
    20	                   "+",
    21	                   BinOp("*", Name("b"), Name("b")),
    22	                   BinOp("*", Name("c"), Name("c"))
    23	                 )
    24	               )
    25	             ),
    26	             Compare(
    27	               BinOp("*", Name("b"), Name("b")),
    28	               CmpOp(
    29	                 "==",
    30	                 BinOp(
    31	                   "+",
    32	                   BinOp("*", Name("a"), Name("a")),
    33	                   BinOp("*", Name("c"), Name("c"))
    34	                 )
    35	               )
    36	             ),
    37	             Compare(
    38	               BinOp("*", Name("c"), Name("c")),
    39	               CmpOp(
    40	                 "==",
    41	                 BinOp(
    42	                   "+",
    43	                   BinOp("*", Name("a"), Name("a")),
    44	                   BinOp("*", Name("b"), Name("b"))
    45	                 )
    46	               )
    47	             )
    48	           )
    49	         ),
    50	         0
    51	       )
    52	
    53	  // MPY's Float equality delegates to the FLOAT.eq hook, which the LLVM
    54	  // backend implements but the Haskell backend does not.  This symbol is the
    55	  // explicit trusted primitive for that fixed external operation.
