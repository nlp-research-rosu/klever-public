import json, sys
inv_path='/reference/rule-inventory.json'
out_path='/workspace/trust-boundary.json'
with open(inv_path) as f: inv=json.load(f)
with open(out_path) as f: out=json.load(f)
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules']) == 14
inv_ids=[r['source_rule_id'] for r in inv['rules']]
out_ids=[r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert len(set(out_ids)) == len(out_ids)
for i,(ir,orule) in enumerate(zip(inv['rules'],out['rules'])):
    assert list(orule.keys()) == ['source_rule_id','classification','rationale'], (i,list(orule.keys()))
    assert orule['classification'] in allowed
    assert isinstance(orule['rationale'],str) and orule['rationale'].strip()
    if any(a == 'simplification' or a.startswith('simplification(') for a in ir.get('attributes',[])):
        assert orule['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
from collections import Counter
print('schema/order/hash validation: PASS')
print('rule_count:', len(out_ids))
print('unique_rule_count:', len(set(out_ids)))
print('classifications:', dict(Counter(r['classification'] for r in out['rules'])))
print('domain_lemma_set_empty:', not any(r['classification']=='DOMAIN_LEMMA' for r in out['rules']))
print('proved_derived_lemma_set_empty:', not any(r['classification']=='PROVED_DERIVED_LEMMA' for r in out['rules']))
