new file mode 100644
index 0000000000000000000000000000000000000000..247294586fd636e6f531c936e0053384ffe748c7
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,13 @@
+def right_angle_triangle(a, b, c):
+    return (
+        a * a == b * b + c * c
+        or b * b == a * a + c * c
+        or c * c == a * a + b * b
+    )
+
+
+assert right_angle_triangle(3, 4, 5) == True
+assert right_angle_triangle(1, 2, 3) == False
+assert right_angle_triangle(5, 12, 13) == True
+assert right_angle_triangle(6, 8, 10) == True
+assert right_angle_triangle(2, 2, 3) == False
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..7a3229dcc03647459e1bee88df7469904a1364b0
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py solution.py | cmp - solution.mpy
+python3 validation_tests.py
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+python3 py2mpy.py concrete_tests.py > concrete-tests.mpy
+krun concrete-tests.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY
+vacuity_status=$?
+set -e
+
+if [ "$vacuity_status" -eq 0 ]; then
+  echo "ERROR: false-postcondition mutation unexpectedly proved"
+  exit 1
+fi
+
+echo "EXPECTED FAILURE: false-postcondition mutation exited $vacuity_status"
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..988db65393a503ee85176d1341f91bf7ee3f7576
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def right_angle_triangle(a, b, c):
+    return (
+        a * a == b * b + c * c
+        or b * b == a * a + c * c
+        or c * c == a * a + b * b
+    )
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b4c0d5a3da135ce22b8d59baeefe4c22f997603
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: (3, 4, 5) returns true, not false.
+  claim [false-right-angle-result]:
+    <k>
+      Call(Name("right_angle_triangle"), 3, 4, 5)
+      =>
+      ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "right_angle_triangle" |->
+          closureVal(
+            ("a", "b", "c"),
+            Return(
+              BoolOp(
+                "or",
+                Compare(
+                  BinOp("*", Name("a"), Name("a")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("b"), Name("b")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("b"), Name("b")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("c"), Name("c")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("b"), Name("b"))
+                    )
+                  )
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?RESULT ==Bool false
+endmodule
