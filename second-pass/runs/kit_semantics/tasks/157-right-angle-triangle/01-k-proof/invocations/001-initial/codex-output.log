+                    BinOp(
+                      "+",
+                      BinOp("*", Name("b"), Name("b")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("b"), Name("b")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("c"), Name("c")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("b"), Name("b"))
+                    )
+                  )
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?RESULT ==Bool false
+endmodule
