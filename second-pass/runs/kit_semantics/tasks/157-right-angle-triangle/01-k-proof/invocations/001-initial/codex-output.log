index 0000000000000000000000000000000000000000..247294586fd636e6f531c936e0053384ffe748c7
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,13 @@
+def right_angle_triangle(a, b, c):
+    return (
+        a * a == b * b + c * c
+        or b * b == a * a + c * c
+        or c * c == a * a + b * b
+    )
+
+
+assert right_angle_triangle(3, 4, 5) == True
+assert right_angle_triangle(1, 2, 3) == False
+assert right_angle_triangle(5, 12, 13) == True
+assert right_angle_triangle(6, 8, 10) == True
+assert right_angle_triangle(2, 2, 3) == False
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..988db65393a503ee85176d1341f91bf7ee3f7576
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def right_angle_triangle(a, b, c):
+    return (
+        a * a == b * b + c * c
+        or b * b == a * a + c * c
+        or c * c == a * a + b * b
+    )
diff --git a/spec-float-test.k b/spec-float-test.k
new file mode 100644
index 0000000000000000000000000000000000000000..408f65f9157097e287ab5dfaa558b99bd638e7e5
--- /dev/null
+++ b/spec-float-test.k
@@ -0,0 +1,96 @@
+requires "verification.k"
+
+module SPEC-FLOAT-TEST
+  imports VERIFICATION
+
+  claim [right-angle-triangle-float]:
+    <k>
+      Call(
+        Name("right_angle_triangle"),
+        A:Float,
+        B:Float,
+        C:Float
+      )
+      =>
+      ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "right_angle_triangle" |->
+          closureVal(
+            ("a", "b", "c"),
+            Return(
+              BoolOp(
+                "or",
+                Compare(
+                  BinOp("*", Name("a"), Name("a")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("b"), Name("b")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("b"), Name("b")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("c"), Name("c")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("b"), Name("b"))
+                    )
+                  )
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures
+      ?RESULT
+      ==Bool
+      (
+        applyCmp(
+          "==",
+          applyBin("*", A, A),
+          applyBin("+", applyBin("*", B, B), applyBin("*", C, C))
+        )
+        orBool
+        applyCmp(
+          "==",
+          applyBin("*", B, B),
+          applyBin("+", applyBin("*", A, A), applyBin("*", C, C))
+        )
+        orBool
+        applyCmp(
+          "==",
+          applyBin("*", C, C),
+          applyBin("+", applyBin("*", A, A), applyBin("*", B, B))
+        )
+      )
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b4c0d5a3da135ce22b8d59baeefe4c22f997603
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: (3, 4, 5) returns true, not false.
+  claim [false-right-angle-result]:
+    <k>
+      Call(Name("right_angle_triangle"), 3, 4, 5)
+      =>
+      ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "right_angle_triangle" |->
+          closureVal(
+            ("a", "b", "c"),
+            Return(
+              BoolOp(
+                "or",
+                Compare(
+                  BinOp("*", Name("a"), Name("a")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("b"), Name("b")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("b"), Name("b")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("c"), Name("c")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("b"), Name("b"))
+                    )
+                  )
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?RESULT ==Bool false
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ef964441c41916eb1da8fb1574d53a6c66abb8e6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,84 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [right-angle-triangle-int]:
+    <k>
+      Call(
+        Name("right_angle_triangle"),
+        A:Int,
+        B:Int,
+        C:Int
+      )
+      =>
+      ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "right_angle_triangle" |->
+          closureVal(
+            ("a", "b", "c"),
+            Return(
+              BoolOp(
+                "or",
+                Compare(
+                  BinOp("*", Name("a"), Name("a")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("b"), Name("b")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("b"), Name("b")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("c"), Name("c")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("b"), Name("b"))
+                    )
+                  )
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures
+      ?RESULT
+      ==Bool
+      (
+        (A *Int A ==Int B *Int B +Int C *Int C)
+        orBool
+        (B *Int B ==Int A *Int A +Int C *Int C)
+        orBool
+        (C *Int C ==Int A *Int A +Int B *Int B)
+      )
+endmodule
