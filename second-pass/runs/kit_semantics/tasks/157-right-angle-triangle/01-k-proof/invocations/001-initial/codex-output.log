diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..e3a242c39bed42fe9aef02ce1b8a3f9a3bcfa79e
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: the real (3, 4, 5) postcondition is retained,
+  // but this body always returns false.
+  claim [mutated-body-is-detected]:
+    <k>
+      Call(Name("right_angle_triangle"), 3, 4, 5)
+      =>
+      ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "right_angle_triangle" |->
+          closureVal(
+            ("a", "b", "c"),
+            Return(Bool(false)),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?RESULT ==Bool true
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b4c0d5a3da135ce22b8d59baeefe4c22f997603
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: (3, 4, 5) returns true, not false.
+  claim [false-right-angle-result]:
+    <k>
+      Call(Name("right_angle_triangle"), 3, 4, 5)
+      =>
+      ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "right_angle_triangle" |->
+          closureVal(
+            ("a", "b", "c"),
+            Return(
+              BoolOp(
+                "or",
+                Compare(
+                  BinOp("*", Name("a"), Name("a")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("b"), Name("b")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("b"), Name("b")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("c"), Name("c")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("b"), Name("b"))
+                    )
+                  )
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?RESULT ==Bool false
+endmodule
