--- /dev/null
+++ b/spec.k
@@ -0,0 +1,84 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [right-angle-triangle-int]:
+    <k>
+      Call(
+        Name("right_angle_triangle"),
+        A:Int,
+        B:Int,
+        C:Int
+      )
+      =>
+      ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "right_angle_triangle" |->
+          closureVal(
+            ("a", "b", "c"),
+            Return(
+              BoolOp(
+                "or",
+                Compare(
+                  BinOp("*", Name("a"), Name("a")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("b"), Name("b")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("b"), Name("b")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("c"), Name("c"))
+                    )
+                  )
+                ),
+                Compare(
+                  BinOp("*", Name("c"), Name("c")),
+                  CmpOp(
+                    "==",
+                    BinOp(
+                      "+",
+                      BinOp("*", Name("a"), Name("a")),
+                      BinOp("*", Name("b"), Name("b"))
+                    )
+                  )
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures
+      ?RESULT
+      ==Bool
+      (
+        (A *Int A ==Int B *Int B +Int C *Int C)
+        orBool
+        (B *Int B ==Int A *Int A +Int C *Int C)
+        orBool
+        (C *Int C ==Int A *Int A +Int B *Int B)
+      )
+endmodule
diff --git a/validation_tests.py b/validation_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..2c49782d8f0c44974e9403ed8934e5db0f57e74f
--- /dev/null
+++ b/validation_tests.py
@@ -0,0 +1,46 @@
+import ast
+import inspect
+
+import concrete_tests
+import solution
+
+
+def oracle(a, b, c):
+    x, y, z = sorted((a, b, c))
+    return x * x + y * y == z * z
+
+
+examples = [
+    (3, 4, 5, True),
+    (1, 2, 3, False),
+    (5, 12, 13, True),
+    (6, 8, 10, True),
+    (2, 2, 3, False),
+]
+
+for a, b, c, expected in examples:
+    assert solution.right_angle_triangle(a, b, c) is expected
+
+mismatches = []
+tested = 0
+for a in range(1, 31):
+    for b in range(1, 31):
+        for c in range(1, 31):
+            tested += 1
+            actual = solution.right_angle_triangle(a, b, c)
+            expected = oracle(a, b, c)
+            if actual != expected:
+                mismatches.append((a, b, c, actual, expected))
+
+solution_def = ast.parse(inspect.getsource(solution.right_angle_triangle)).body[0]
+concrete_def = ast.parse(
+    inspect.getsource(concrete_tests.right_angle_triangle)
+).body[0]
+assert ast.dump(solution_def) == ast.dump(concrete_def)
+assert not mismatches, mismatches[:10]
+
+print(
+    f"validation: examples={len(examples)}, "
+    f"positive_integer_triples={tested}, mismatches={len(mismatches)}, "
+    "concrete_harness_ast=identical"
+)
