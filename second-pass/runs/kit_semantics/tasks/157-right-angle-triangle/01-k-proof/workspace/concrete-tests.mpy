Module(
  FuncDef("right_angle_triangle", Params("a", "b", "c"),
    Return(
      BoolOp(
        "or",
        Compare(
          BinOp("*", Name("a"), Name("a")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("b"), Name("b")),
              BinOp("*", Name("c"), Name("c"))))),
        Compare(
          BinOp("*", Name("b"), Name("b")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("a"), Name("a")),
              BinOp("*", Name("c"), Name("c"))))),
        Compare(
          BinOp("*", Name("c"), Name("c")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("a"), Name("a")),
              BinOp("*", Name("b"), Name("b"))))))))
  Assert(
    Compare(
      Call(Name("right_angle_triangle"), Int(3), Int(4), Int(5)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("right_angle_triangle"), Int(1), Int(2), Int(3)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("right_angle_triangle"), Int(5), Int(12), Int(13)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("right_angle_triangle"), Int(6), Int(8), Int(10)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("right_angle_triangle"), Int(2), Int(2), Int(3)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("right_angle_triangle"),
        Float(3.0),
        Float(4.0),
        Float(5.0)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("right_angle_triangle"),
        Float(1.5),
        Float(2.0),
        Float(2.5)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("right_angle_triangle"), Int(3), Float(4.0), Int(5)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("right_angle_triangle"), Float(1.0), Int(2), Float(3.0)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("right_angle_triangle"),
        Float(0.3),
        Float(0.4),
        Float(0.5)),
      CmpOp("==", Bool(true)))))
