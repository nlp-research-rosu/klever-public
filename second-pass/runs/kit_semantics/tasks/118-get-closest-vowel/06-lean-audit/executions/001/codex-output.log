     9	  syntax Stmts ::= "getClosestLoopBody" [macro]
    10	  syntax Module ::= "getClosestProgram" [macro]
    11	
    12	  syntax IntSeq ::= closestCandidate(IntSeq, Int) [function]
    13	  syntax Bool ::= vowelPred(Int) [function, total]
    14	  syntax Bool ::= isVowelCode(Int) [function, total]
    15	  syntax Bool ::= closestQualifies(IntSeq, Int) [function]
