@@ -0,0 +1,64 @@
+import Proof
+
+namespace OperationalAudit
+
+def nilCodes : SortIntSeq := .«.IntSeq_MPY-CORE_IntSeq»
+
+def consCode (head : SortInt) (rest : SortIntSeq) : SortIntSeq :=
+  .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head rest
+
+def bab : SortIntSeq := consCode 98 (consCode 97 (consCode 98 nilCodes))
+def aab : SortIntSeq := consCode 97 (consCode 97 (consCode 98 nilCodes))
+def baa : SortIntSeq := consCode 98 (consCode 97 (consCode 97 nilCodes))
+def chosen : SortIntSeq := consCode 42 nilCodes
+
+-- Boundary and out-of-bounds probes for the intSeqAt bridge.
+example : Proof.«isLen(_)_MPY-CORE_Int_IntSeq» bab = 3 := by rfl
+example : Proof.«intSeqAt(_,_)_MPY-SUBSCRIPT_Int_IntSeq_Int?» bab (-1) = none := by rfl
+example : Proof.«intSeqAt(_,_)_MPY-SUBSCRIPT_Int_IntSeq_Int?» bab 0 = some 98 := by rfl
+example : Proof.«intSeqAt(_,_)_MPY-SUBSCRIPT_Int_IntSeq_Int?» bab 1 = some 97 := by rfl
+example : Proof.«intSeqAt(_,_)_MPY-SUBSCRIPT_Int_IntSeq_Int?» bab 2 = some 98 := by rfl
+example : Proof.«intSeqAt(_,_)_MPY-SUBSCRIPT_Int_IntSeq_Int?» bab 3 = none := by rfl
+
+-- Branch probes for closestScan: isolated vowel, left-vowel exclusion,
+-- right-vowel exclusion, found=true preservation, and nonpositive base case.
+example :
+    Proof.«closestScan(_,_,_,_)_FOUNDATION-SYNTAX_IntSeq_IntSeq_Int_IntSeq_Bool?»
+      bab 1 nilCodes false = some (consCode 97 nilCodes) := by rfl
+example :
+    Proof.«closestScan(_,_,_,_)_FOUNDATION-SYNTAX_IntSeq_IntSeq_Int_IntSeq_Bool?»
+      aab 1 nilCodes false = some nilCodes := by rfl
+example :
+    Proof.«closestScan(_,_,_,_)_FOUNDATION-SYNTAX_IntSeq_IntSeq_Int_IntSeq_Bool?»
+      baa 1 nilCodes false = some nilCodes := by rfl
+example :
+    Proof.«closestScan(_,_,_,_)_FOUNDATION-SYNTAX_IntSeq_IntSeq_Int_IntSeq_Bool?»
+      bab 1 chosen true = some chosen := by rfl
+example :
+    Proof.«closestScan(_,_,_,_)_FOUNDATION-SYNTAX_IntSeq_IntSeq_Int_IntSeq_Bool?»
+      nilCodes (-5) chosen false = some chosen := by rfl
+
+-- Counterfactual convenient bridges.  These intentionally do not implement K,
+-- yet the fixed theorem's totality-only equations can still be proved.  This is
+-- why the operational comparison above is an independent audit obligation.
+def constantAt (_ : SortIntSeq) (_ : SortInt) : Option SortInt := some 0
+
+def identityScan (_ : SortIntSeq) (_ : SortInt) (result : SortIntSeq)
+    (_ : SortBool) : Option SortIntSeq := some result
+
+theorem dishonestCounterfactualStillProvesTarget :
+    Klean118GetClosestVowel.Lemmas.targetStatement
+      Proof._andBool_ Proof.«_>=Int_» Proof.«_<Int_» Proof.«_<=Int_»
+      Proof.«_+Int_» Proof.«isLen(_)_MPY-CORE_Int_IntSeq»
+      identityScan constantAt := by
+  unfold Klean118GetClosestVowel.Lemmas.targetStatement
+  constructor <;> intros <;> simp [constantAt, identityScan]
+
+example : constantAt nilCodes 0 = some 0 := by rfl
+example : Proof.«intSeqAt(_,_)_MPY-SUBSCRIPT_Int_IntSeq_Int?» nilCodes 0 = none := by rfl
+example : identityScan bab 1 nilCodes false = some nilCodes := by rfl
+example :
+    Proof.«closestScan(_,_,_,_)_FOUNDATION-SYNTAX_IntSeq_IntSeq_Int_IntSeq_Bool?»
+      bab 1 nilCodes false = some (consCode 97 nilCodes) := by rfl
+
+end OperationalAudit

