    20	module FOUNDATION
    21	  imports FOUNDATION-SYNTAX
    22	  imports MPY
    23	
    24	  rule isVowelBody =>
    25	    Assign(Name("result"), Bool(false))
    26	    While(
    27	      Compare(Name("ch"), CmpOp("==", Str("a"))),
    28	      Assign(Name("result"), Bool(true))
    29	      Assign(Name("ch"), Str("")))
    30	    While(
    31	      Compare(Name("ch"), CmpOp("==", Str("e"))),
    32	      Assign(Name("result"), Bool(true))
    33	      Assign(Name("ch"), Str("")))
    34	    While(
    35	      Compare(Name("ch"), CmpOp("==", Str("i"))),
    36	      Assign(Name("result"), Bool(true))
    37	      Assign(Name("ch"), Str("")))
    38	    While(
    39	      Compare(Name("ch"), CmpOp("==", Str("o"))),
    40	      Assign(Name("result"), Bool(true))
    41	      Assign(Name("ch"), Str("")))
    42	    While(
    43	      Compare(Name("ch"), CmpOp("==", Str("u"))),
    44	      Assign(Name("result"), Bool(true))
    45	      Assign(Name("ch"), Str("")))
    46	    While(
    47	      Compare(Name("ch"), CmpOp("==", Str("A"))),
    48	      Assign(Name("result"), Bool(true))
    49	      Assign(Name("ch"), Str("")))
    50	    While(
    51	      Compare(Name("ch"), CmpOp("==", Str("E"))),
    52	      Assign(Name("result"), Bool(true))
    53	      Assign(Name("ch"), Str("")))
    54	    While(
    55	      Compare(Name("ch"), CmpOp("==", Str("I"))),
    56	      Assign(Name("result"), Bool(true))
    57	      Assign(Name("ch"), Str("")))
    58	    While(
    59	      Compare(Name("ch"), CmpOp("==", Str("O"))),
    60	      Assign(Name("result"), Bool(true))
    61	      Assign(Name("ch"), Str("")))
    62	    While(
    63	      Compare(Name("ch"), CmpOp("==", Str("U"))),
    64	      Assign(Name("result"), Bool(true))
    65	      Assign(Name("ch"), Str("")))
    66	    Return(Name("result"))
    67	
    68	  rule getClosestLoopBody =>
    69	    While(
    70	      BoolOp("and",
    71	        ( UnaryOp("not", Name("found")),
    72	          Call(
    73	            Name("_is_vowel"),
    74	            Subscript(Name("word"), Name("i"))),
    75	          UnaryOp(
    76	            "not",
    77	            Call(
    78	              Name("_is_vowel"),
    79	              Subscript(
    80	                Name("word"),
    81	                BinOp("-", Name("i"), Int(1))))),
    82	          UnaryOp(
    83	            "not",
    84	            Call(
    85	              Name("_is_vowel"),
    86	              Subscript(
    87	                Name("word"),
    88	                BinOp("+", Name("i"), Int(1))))),
    89	          .Exprs)),
    90	      Assign(Name("result"), Subscript(Name("word"), Name("i")))
    91	      Assign(Name("found"), Bool(true)))
    92	    Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
    93	
    94	  rule getClosestBody =>
    95	    Assign(Name("result"), Str(""))
    96	    Assign(Name("found"), Bool(false))
    97	    Assign(
    98	      Name("i"),
    99	      BinOp("-", Call(Name("len"), Name("word")), Int(2)))
   100	    While(Compare(Name("i"), CmpOp(">", Int(0))), getClosestLoopBody)
   101	    Return(Name("result"))
   102	
   103	  rule getClosestProgram =>
   104	    Module(
   105	      FuncDef(
   106	        "_is_vowel",
   107	        Params("ch"),
   108	        isVowelBody)
   109	      FuncDef(
   110	        "get_closest_vowel",
   111	        Params("word"),
   112	        getClosestBody))
   113	
   114	  rule closestCandidate(CS, I)
   115	    => iCons(intSeqAt(CS, I), .IntSeq)
   116	
   117	  rule vowelPred(C)
   118	    => C ==Int 97
   119	     orBool C ==Int 101
   120	     orBool C ==Int 105
   121	     orBool C ==Int 111
   122	     orBool C ==Int 117
   123	     orBool C ==Int 65
   124	     orBool C ==Int 69
   125	     orBool C ==Int 73
   126	     orBool C ==Int 79
   127	     orBool C ==Int 85
   128	  rule isVowelCode(C)
   129	    => true
   130	    requires vowelPred(C)
   131	  rule isVowelCode(C)
   132	    => false
   133	    requires notBool vowelPred(C)
   134	
   135	  rule closestQualifies(CS, I)
   136	    => isVowelCode(intSeqAt(CS, I))
   137	       andBool notBool isVowelCode(intSeqAt(CS, I -Int 1))
   138	       andBool notBool isVowelCode(intSeqAt(CS, I +Int 1))
   139	
   140	  rule closestScan(_CS, I, R, _F) => R
   141	    requires I <=Int 0
   142	    [simplification]
   143	  rule closestScan(CS, I, R, true)
   144	    => closestScan(CS, I -Int 1, R, true)
   145	    requires I >Int 0
   146	    [simplification]
   147	  rule closestScan(CS, I, R, false)
   148	    => closestScan(
   149	         CS,
   150	         I -Int 1,
   151	         closestCandidate(CS, I),
   152	         true)
   153	    requires I >Int 0
   154	     andBool vowelPred(intSeqAt(CS, I))
   155	     andBool notBool vowelPred(intSeqAt(CS, I -Int 1))
   156	     andBool notBool vowelPred(intSeqAt(CS, I +Int 1))
   157	    [simplification]
   158	  rule closestScan(CS, I, R, false)
   159	    => closestScan(CS, I -Int 1, R, false)
   160	    requires I >Int 0
   161	     andBool notBool vowelPred(intSeqAt(CS, I))
   162	    [simplification]
   163	  rule closestScan(CS, I, R, false)
   164	    => closestScan(CS, I -Int 1, R, false)
   165	    requires I >Int 0
   166	     andBool vowelPred(intSeqAt(CS, I))
   167	     andBool vowelPred(intSeqAt(CS, I -Int 1))
   168	    [simplification]
   169	  rule closestScan(CS, I, R, false)
   170	    => closestScan(CS, I -Int 1, R, false)
   171	    requires I >Int 0
   172	     andBool vowelPred(intSeqAt(CS, I))
   173	     andBool notBool vowelPred(intSeqAt(CS, I -Int 1))
   174	     andBool vowelPred(intSeqAt(CS, I +Int 1))
   175	    [simplification]
   176	
   177	  rule closestVowel(CS)
   178	    => closestScan(CS, isLen(CS) -Int 2, .IntSeq, false)
   179	
   180	  // intSeqAt has rules only for in-bounds constructor cases in the supplied
   181	  // semantics.  This derived definedness lemma exposes the corresponding
   182	  // structural induction fact to the symbolic backend.
   183	  rule #Ceil(intSeqAt(CS, I)) => #Top
   184	    requires 0 <=Int I
   185	     andBool I <Int isLen(CS)
   186	    [simplification]
   187	
   188	  rule #Ceil(closestScan(CS, I, R, F)) => #Top
   189	    requires I >=Int 0
   190	     andBool I +Int 1 <Int isLen(CS)
   191	    [simplification]
   192	
   193	endmodule
