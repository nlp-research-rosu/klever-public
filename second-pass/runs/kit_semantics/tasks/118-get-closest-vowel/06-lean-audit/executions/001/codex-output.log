     1	def _is_vowel(ch):
     2	    result = False
     3	    while ch == "a":
     4	        result = True
     5	        ch = ""
     6	    while ch == "e":
     7	        result = True
     8	        ch = ""
     9	    while ch == "i":
    10	        result = True
    11	        ch = ""
    12	    while ch == "o":
    13	        result = True
    14	        ch = ""
    15	    while ch == "u":
    16	        result = True
    17	        ch = ""
    18	    while ch == "A":
    19	        result = True
    20	        ch = ""
    21	    while ch == "E":
    22	        result = True
    23	        ch = ""
    24	    while ch == "I":
    25	        result = True
    26	        ch = ""
    27	    while ch == "O":
    28	        result = True
    29	        ch = ""
    30	    while ch == "U":
    31	        result = True
    32	        ch = ""
    33	    return result
    34	
    35	
    36	def get_closest_vowel(word):
    37	    result = ""
    38	    found = False
    39	    i = len(word) - 2
    40	    while i > 0:
    41	        while (not found and _is_vowel(word[i])
    42	               and not _is_vowel(word[i - 1])
    43	               and not _is_vowel(word[i + 1])):
