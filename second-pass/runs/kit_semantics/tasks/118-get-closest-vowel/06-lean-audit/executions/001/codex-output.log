    13	    <k>
    14	      #while(
    15	        Compare(Name("i"), CmpOp(">", Int(0))),
    16	        While(
    17	          BoolOp("and",
    18	            ( UnaryOp("not", Name("found")),
    19	              Call(
    20	                Name("_is_vowel"),
    21	                Subscript(Name("word"), Name("i"))),
    22	              UnaryOp(
    23	                "not",
    24	                Call(
    25	                  Name("_is_vowel"),
    26	                  Subscript(
    27	                    Name("word"),
    28	                    BinOp("-", Name("i"), Int(1))))),
    29	              UnaryOp(
    30	                "not",
    31	                Call(
    32	                  Name("_is_vowel"),
    33	                  Subscript(
    34	                    Name("word"),
    35	                    BinOp("+", Name("i"), Int(1))))),
    36	              .Exprs)),
    37	          Assign(Name("result"), Subscript(Name("word"), Name("i")))
    38	          Assign(Name("found"), Bool(true)))
    39	        Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
    40	      ~> (Return(Name("result")) .Stmts)
    41	      ~> #endcall
    42	      => str(closestScan(CS, I, R, F))
    43	    </k>
    44	    <env> 1 => 0 </env>
    45	    <scopes>
    46	      ( 0 |-> scope(
    47	          ( "_is_vowel" |-> closureVal(
    48	              ("ch", .ParamNames),
    49	              isVowelBody,
    50	              0)
    51	            "get_closest_vowel" |-> closureVal(
    52	              ("word", .ParamNames),
    53	              getClosestBody,
    54	              0) ),
    55	          parent(-1))
    56	        1 |-> scope(
    57	          ( "word"   |-> str(CS)
    58	            "result" |-> str(R)
    59	            "found"  |-> F
    60	            "i"      |-> I ),
    61	          parent(0))
    62	        -1 |-> BUILTINS )
    63	      =>
    64	      ( 0 |-> scope(
    65	          ( "_is_vowel" |-> closureVal(
    66	              ("ch", .ParamNames),
    67	              isVowelBody,
    68	              0)
    69	            "get_closest_vowel" |-> closureVal(
    70	              ("word", .ParamNames),
    71	              getClosestBody,
    72	              0) ),
    73	          parent(-1))
    74	        -1 |-> BUILTINS )
    75	    </scopes>
