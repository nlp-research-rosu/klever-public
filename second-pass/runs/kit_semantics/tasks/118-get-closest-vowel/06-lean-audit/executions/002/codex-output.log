  | .«.IntSeq_MPY-CORE_IntSeq», _ => none
  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head rest, index =>
      if index = 0 then some head
      else if index > 0 then intSeqAtOperational rest (index - 1)
