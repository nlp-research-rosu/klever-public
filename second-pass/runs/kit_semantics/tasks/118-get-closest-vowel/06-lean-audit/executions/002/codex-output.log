# recursively show scalar paths containing generator/producer/exporter/klean_py/image_id
terms=('generator','producer','exporter','klean_py','image_id')
def walk(x,p=''):
 if isinstance(x,dict):
  for k,v in x.items():
   q=f'{p}.{k}' if p else k
   if any(t in k.lower() for t in terms) and not isinstance(v,(dict,list)):
    print(q, repr(v))
   walk(v,q)
 elif isinstance(x,list):
  for i,v in enumerate(x): walk(v,f'{p}[{i}]')
walk(a)
