{
    "definitions": [
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 66,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "9750751be23de63eea428066c5f2315f3bebcc22fe43dddf5e6d79c43915d75b",
            "rationale": "This macro equation defines the fresh verification symbol isVowelBody as the exact constructor-form helper body.",
            "source_rule_id": "rule-9750751be23de63eea428066c5f2315f3bebcc22fe43dddf5e6d79c43915d75b",
            "start_line": 24,
            "text": "  rule isVowelBody =>\n    Assign(Name(\"result\"), Bool(false))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"a\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"e\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"i\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"o\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"u\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"A\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"E\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"I\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"O\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"U\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    Return(Name(\"result\"))"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 92,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "9f040a569fbdef71fcf41191a36aa87b4a12a1408da3cb7e8e4fd521f3142050",
            "rationale": "This macro equation defines the fresh verification symbol getClosestLoopBody as the exact constructor-form loop body.",
            "source_rule_id": "rule-9f040a569fbdef71fcf41191a36aa87b4a12a1408da3cb7e8e4fd521f3142050",
            "start_line": 68,
            "text": "  rule getClosestLoopBody =>\n    While(\n      BoolOp(\"and\",\n        ( UnaryOp(\"not\", Name(\"found\")),\n          Call(\n            Name(\"_is_vowel\"),\n            Subscript(Name(\"word\"), Name(\"i\"))),\n          UnaryOp(\n            \"not\",\n            Call(\n              Name(\"_is_vowel\"),\n              Subscript(\n                Name(\"word\"),\n                BinOp(\"-\", Name(\"i\"), Int(1))))),\n          UnaryOp(\n            \"not\",\n            Call(\n              Name(\"_is_vowel\"),\n              Subscript(\n                Name(\"word\"),\n                BinOp(\"+\", Name(\"i\"), Int(1))))),\n          .Exprs)),\n      Assign(Name(\"result\"), Subscript(Name(\"word\"), Name(\"i\")))\n      Assign(Name(\"found\"), Bool(true)))\n    Assign(Name(\"i\"), BinOp(\"-\", Name(\"i\"), Int(1)))"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 101,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "b469237f699e183d197e8af26b5fe59f2f7ee10feb5e2cae653d35fa6db3b18e",
            "rationale": "This macro equation defines the fresh verification symbol getClosestBody as the exact constructor-form function body.",
            "source_rule_id": "rule-b469237f699e183d197e8af26b5fe59f2f7ee10feb5e2cae653d35fa6db3b18e",
            "start_line": 94,
            "text": "  rule getClosestBody =>\n    Assign(Name(\"result\"), Str(\"\"))\n    Assign(Name(\"found\"), Bool(false))\n    Assign(\n      Name(\"i\"),\n      BinOp(\"-\", Call(Name(\"len\"), Name(\"word\")), Int(2)))\n    While(Compare(Name(\"i\"), CmpOp(\">\", Int(0))), getClosestLoopBody)\n    Return(Name(\"result\"))"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 112,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "bda9325d20b98ccb8ea35f87db6a25e30467c4fdc5a3795dff9cc7b0fad1df95",
            "rationale": "This macro equation defines the fresh verification symbol getClosestProgram as the exact constructor-form two-function module.",
            "source_rule_id": "rule-bda9325d20b98ccb8ea35f87db6a25e30467c4fdc5a3795dff9cc7b0fad1df95",
            "start_line": 103,
            "text": "  rule getClosestProgram =>\n    Module(\n      FuncDef(\n        \"_is_vowel\",\n        Params(\"ch\"),\n        isVowelBody)\n      FuncDef(\n        \"get_closest_vowel\",\n        Params(\"word\"),\n        getClosestBody))"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 115,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "f92258ede26e827ded78066798d36a19faf667c244668896801918a553460f73",
            "rationale": "This equation defines the fresh summary function closestCandidate as the singleton sequence containing the selected code.",
            "source_rule_id": "rule-f92258ede26e827ded78066798d36a19faf667c244668896801918a553460f73",
            "start_line": 114,
            "text": "  rule closestCandidate(CS, I)\n    => iCons(intSeqAt(CS, I), .IntSeq)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 127,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "b53c8b783e2e5811d5637116208c57afb5dff0bec4c0f204437b0d5e025b40bf",
            "rationale": "This equation defines the fresh predicate vowelPred by the disjunction of the ten case-sensitive ASCII vowel codes.",
            "source_rule_id": "rule-b53c8b783e2e5811d5637116208c57afb5dff0bec4c0f204437b0d5e025b40bf",
            "start_line": 117,
            "text": "  rule vowelPred(C)\n    => C ==Int 97\n     orBool C ==Int 101\n     orBool C ==Int 105\n     orBool C ==Int 111\n     orBool C ==Int 117\n     orBool C ==Int 65\n     orBool C ==Int 69\n     orBool C ==Int 73\n     orBool C ==Int 79\n     orBool C ==Int 85"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 130,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "4ffa001d0025dfc39e75914c4018aec5fc84882a251347e2f7d3411147df71c2",
            "rationale": "This is the true guarded defining equation of the fresh total predicate isVowelCode.",
            "source_rule_id": "rule-4ffa001d0025dfc39e75914c4018aec5fc84882a251347e2f7d3411147df71c2",
            "start_line": 128,
            "text": "  rule isVowelCode(C)\n    => true\n    requires vowelPred(C)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 133,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "d4475acafd5ccc48b928bf84e40a47c36c492090891bdaac93fb21beb3dd6a08",
            "rationale": "This is the false guarded defining equation of the fresh total predicate isVowelCode; together with the preceding complementary case it completes the definition.",
            "source_rule_id": "rule-d4475acafd5ccc48b928bf84e40a47c36c492090891bdaac93fb21beb3dd6a08",
            "start_line": 131,
            "text": "  rule isVowelCode(C)\n    => false\n    requires notBool vowelPred(C)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 138,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "3ece48af78d3f7d2f9eaef5f4a84518a114cf9815cb9dbeb7d46bd3102033d68",
            "rationale": "This equation defines the fresh predicate closestQualifies from the current and neighboring vowel tests.",
            "source_rule_id": "rule-3ece48af78d3f7d2f9eaef5f4a84518a114cf9815cb9dbeb7d46bd3102033d68",
            "start_line": 135,
            "text": "  rule closestQualifies(CS, I)\n    => isVowelCode(intSeqAt(CS, I))\n       andBool notBool isVowelCode(intSeqAt(CS, I -Int 1))\n       andBool notBool isVowelCode(intSeqAt(CS, I +Int 1))"
        },
        {
            "attributes": [
                "simplification"
            ],
            "classification": "DEFINITION",
            "end_line": 142,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "438d7cc7c496278810f0bb993f58a64eacd19276c70d0f101e30bc6b5084c96f",
            "rationale": "This simplification equation is the guarded base case defining the fresh recursive summary closestScan.",
            "source_rule_id": "rule-438d7cc7c496278810f0bb993f58a64eacd19276c70d0f101e30bc6b5084c96f",
            "start_line": 140,
            "text": "  rule closestScan(_CS, I, R, _F) => R\n    requires I <=Int 0\n    [simplification]"
        },
        {
            "attributes": [
                "simplification"
            ],
            "classification": "DEFINITION",
            "end_line": 146,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "44428f2a6174cdcf211cfdd4a90819eb05c02a3189ffc69f34a0c1f6958959a7",
            "rationale": "This simplification equation defines the found=true recursive case of the fresh summary closestScan.",
            "source_rule_id": "rule-44428f2a6174cdcf211cfdd4a90819eb05c02a3189ffc69f34a0c1f6958959a7",
            "start_line": 143,
            "text": "  rule closestScan(CS, I, R, true)\n    => closestScan(CS, I -Int 1, R, true)\n    requires I >Int 0\n    [simplification]"
        },
        {
            "attributes": [
                "simplification"
            ],
            "classification": "DEFINITION",
            "end_line": 157,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "a7036ead5012afd996265af2ec30eed7ee568c6f0416cf2e867b9ee5977d169c",
            "rationale": "This simplification equation defines the qualifying-vowel recursive case of the fresh summary closestScan, recording the candidate and setting found to true.",
            "source_rule_id": "rule-a7036ead5012afd996265af2ec30eed7ee568c6f0416cf2e867b9ee5977d169c",
            "start_line": 147,
            "text": "  rule closestScan(CS, I, R, false)\n    => closestScan(\n         CS,\n         I -Int 1,\n         closestCandidate(CS, I),\n         true)\n    requires I >Int 0\n     andBool vowelPred(intSeqAt(CS, I))\n     andBool notBool vowelPred(intSeqAt(CS, I -Int 1))\n     andBool notBool vowelPred(intSeqAt(CS, I +Int 1))\n    [simplification]"
        },
        {
            "attributes": [
                "simplification"
            ],
            "classification": "DEFINITION",
            "end_line": 162,
            "file": "foundation.k",
            "module": "FOUNDATION",
            "normalized_sha256": "faba90d09a0cbb9fce0409db469110529b83cdc311057d00d3f26b64c3f6667f",
            "rationale": "This simplification equation defines the current-code-is-not-a-vowel recursive case of the fresh summary closestScan.",
            "source_rule_id": "rule-faba90d09a0cbb9fce0409db469110529b83cdc311057d00d3f26b64c3f6667f",
            "start_line": 158,
            "text": "  rule closestScan(CS, I, R, false)\n    => closestScan(CS, I -Int 1, R, false)\n    requires I >Int 0\n     andBool notBool vowelPred(intSeqAt(CS, I))\n    [simplification]"
        },
        {
            "attributes": [
                "simplification"
            ],
