Module(
  FuncDef("_is_vowel", Params("ch"),
    Assign(Name("result"), Bool(false))
    While(Compare(Name("ch"), CmpOp("==", Str("a"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("e"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("i"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("o"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("u"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("A"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("E"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("I"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("O"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(Compare(Name("ch"), CmpOp("==", Str("U"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    Return(Name("result")))
  FuncDef("get_closest_vowel", Params("word"),
    Assign(Name("result"), Str(""))
    Assign(Name("found"), Bool(false))
    Assign(
      Name("i"),
      BinOp("-", Call(Name("len"), Name("word")), Int(2)))
    While(Compare(Name("i"), CmpOp(">", Int(0))),
      While(BoolOp(
        "and",
        UnaryOp("not", Name("found")),
        Call(Name("_is_vowel"), Subscript(Name("word"), Name("i"))),
        UnaryOp(
          "not",
          Call(
            Name("_is_vowel"),
            Subscript(Name("word"), BinOp("-", Name("i"), Int(1))))),
        UnaryOp(
          "not",
          Call(
            Name("_is_vowel"),
            Subscript(Name("word"), BinOp("+", Name("i"), Int(1)))))),
        Assign(Name("result"), Subscript(Name("word"), Name("i")))
        Assign(Name("found"), Bool(true)))
      Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
    Return(Name("result")))
  Assign(
    Name("r_yogurt"),
    Call(Name("get_closest_vowel"), Str("yogurt")))
  Assign(Name("r_full"), Call(Name("get_closest_vowel"), Str("FULL")))
  Assign(Name("r_quick"), Call(Name("get_closest_vowel"), Str("quick")))
  Assign(Name("r_ab"), Call(Name("get_closest_vowel"), Str("ab")))
  Assign(Name("r_empty"), Call(Name("get_closest_vowel"), Str("")))
  Assign(
    Name("r_rightmost"),
    Call(Name("get_closest_vowel"), Str("babeXid"))))
