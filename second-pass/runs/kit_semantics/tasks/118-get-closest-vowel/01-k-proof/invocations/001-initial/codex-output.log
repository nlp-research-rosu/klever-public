+      => str(closestVowel(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
