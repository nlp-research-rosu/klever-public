+++ b/solution.py
@@ -0,0 +1,12 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    result = ""
+    i = len(word) - 2
+    while i > 0:
+        if result == "":
+            if word[i] in vowels:
+                if word[i - 1] not in vowels:
+                    if word[i + 1] not in vowels:
+                        result = word[i]
+        i = i - 1
+    return result
