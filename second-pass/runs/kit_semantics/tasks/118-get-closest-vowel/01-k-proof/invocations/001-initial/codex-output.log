+      ~> CONT:K
+      =>
+      false ~> CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
