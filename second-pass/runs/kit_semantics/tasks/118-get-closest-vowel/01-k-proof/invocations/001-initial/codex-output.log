+      ~> Call(Name("get_closest_vowel"), (str(CS), .Exprs))
+      => str(closestVowel(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8830933715fc06cf2b903d2b76127238064c985f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,88 @@
+requires "helper-verification.k"
+
+module VERIFICATION-SYNTAX
+  imports HELPER-VERIFICATION-SYNTAX
+endmodule
+
+module VERIFICATION
+  imports HELPER-VERIFICATION
+
+  // Exact loop/return/frame-pop summary justified by the bridge-free
+  // reachability theorem in loop-connection-spec.k.
+  rule
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp(">", Int(0))),
+        While(
+          BoolOp("and",
+            ( UnaryOp("not", Name("found")),
+              Call(
+                Name("_is_vowel"),
+                Subscript(Name("word"), Name("i"))),
+              UnaryOp(
+                "not",
+                Call(
+                  Name("_is_vowel"),
+                  Subscript(
+                    Name("word"),
+                    BinOp("-", Name("i"), Int(1))))),
+              UnaryOp(
+                "not",
+                Call(
+                  Name("_is_vowel"),
+                  Subscript(
+                    Name("word"),
+                    BinOp("+", Name("i"), Int(1))))),
+              .Exprs)),
+          Assign(Name("result"), Subscript(Name("word"), Name("i")))
+          Assign(Name("found"), Bool(true)))
+        Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => str(closestScan(CS, I, R, F))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              HELPERBODY,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              TARGETBODY,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              HELPERBODY,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              TARGETBODY,
+              0) ),
+          parent(-1))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool I +Int 1 <Int isLen(CS)
+    [priority(40)]
+endmodule

