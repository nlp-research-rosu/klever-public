  FuncDef("get_closest_vowel", Params("word"),
    Assign(Name("result"), Str(""))
    Assign(
      Name("i"),
      BinOp("-", Call(Name("len"), Name("word")), Int(2)))
    While(Compare(Name("i"), CmpOp(">", Int(0))),
      While(BoolOp(
        "and",
        Compare(Name("result"), CmpOp("==", Str(""))),
        Call(Name("_is_vowel"), Subscript(Name("word"), Name("i"))),
        UnaryOp(
          "not",
          Call(
            Name("_is_vowel"),
            Subscript(Name("word"), BinOp("-", Name("i"), Int(1))))),
        UnaryOp(
          "not",
          Call(
            Name("_is_vowel"),
            Subscript(Name("word"), BinOp("+", Name("i"), Int(1)))))),
        Assign(Name("result"), Subscript(Name("word"), Name("i"))))
      Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
    Return(Name("result"))))
requires "reference-semantics/semantics.k"

module VERIFICATION-SYNTAX
  imports MPY-SYNTAX
  imports MPY-CORE

  syntax Stmts ::= "isVowelBody" [function, total]
  syntax Stmts ::= "getClosestBody" [function, total]
  syntax Stmts ::= "getClosestLoopBody" [function, total]
  syntax Module ::= "getClosestProgram" [function, total]

  syntax IntSeq ::= closestCandidate(IntSeq, Int) [function, total]
  syntax Bool ::= isVowelCode(Int) [function, total]
  syntax Bool ::= closestQualifies(IntSeq, Int) [function, total]
  syntax IntSeq ::= closestPick(IntSeq, Int, IntSeq) [function, total]
  syntax IntSeq ::= closestScan(IntSeq, Int, IntSeq) [function]
  syntax IntSeq ::= closestVowel(IntSeq) [function, total]
endmodule

module VERIFICATION
  imports VERIFICATION-SYNTAX
  imports MPY

  rule isVowelBody =>
    Assign(Name("result"), Bool(false))
    While(
      Compare(Name("ch"), CmpOp("==", Str("a"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("e"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("i"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("o"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("u"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("A"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("E"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("I"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("O"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    While(
      Compare(Name("ch"), CmpOp("==", Str("U"))),
      Assign(Name("result"), Bool(true))
      Assign(Name("ch"), Str("")))
    Return(Name("result"))

  rule getClosestLoopBody =>
    While(
      BoolOp("and",
        ( Compare(Name("result"), CmpOp("==", Str(""))),
          Call(
            Name("_is_vowel"),
            Subscript(Name("word"), Name("i"))),
          UnaryOp(
            "not",
            Call(
              Name("_is_vowel"),
              Subscript(
                Name("word"),
                BinOp("-", Name("i"), Int(1))))),
          UnaryOp(
            "not",
            Call(
              Name("_is_vowel"),
              Subscript(
                Name("word"),
                BinOp("+", Name("i"), Int(1))))),
          .Exprs)),
      Assign(Name("result"), Subscript(Name("word"), Name("i"))))
    Assign(Name("i"), BinOp("-", Name("i"), Int(1)))

  rule getClosestBody =>
    Assign(Name("result"), Str(""))
    Assign(
      Name("i"),
      BinOp("-", Call(Name("len"), Name("word")), Int(2)))
    While(Compare(Name("i"), CmpOp(">", Int(0))), getClosestLoopBody)
    Return(Name("result"))

  rule getClosestProgram =>
    Module(
      FuncDef(
        "_is_vowel",
        Params("ch"),
        isVowelBody)
      FuncDef(
        "get_closest_vowel",
        Params("word"),
        getClosestBody))

  rule closestCandidate(CS, I)
    => iCons(intSeqAt(CS, I), .IntSeq)

  rule isVowelCode(C)
    => true
    requires C ==Int 97
     orBool C ==Int 101
     orBool C ==Int 105
     orBool C ==Int 111
     orBool C ==Int 117
     orBool C ==Int 65
     orBool C ==Int 69
     orBool C ==Int 73
     orBool C ==Int 79
     orBool C ==Int 85
  rule isVowelCode(C)
    => false
    requires notBool (
       C ==Int 97
       orBool C ==Int 101
       orBool C ==Int 105
       orBool C ==Int 111
       orBool C ==Int 117
       orBool C ==Int 65
       orBool C ==Int 69
       orBool C ==Int 73
       orBool C ==Int 79
       orBool C ==Int 85)

  rule closestQualifies(CS, I)
    => isVowelCode(intSeqAt(CS, I))
       andBool notBool isVowelCode(intSeqAt(CS, I -Int 1))
       andBool notBool isVowelCode(intSeqAt(CS, I +Int 1))

  rule closestPick(CS, I, R)
    => #if R ==K .IntSeq andBool closestQualifies(CS, I)
       #then closestCandidate(CS, I)
       #else R
       #fi

  rule closestScan(_CS, I, R) => R
    requires I <=Int 0
  rule closestScan(CS, I, R)
    => closestScan(CS, I -Int 1, closestPick(CS, I, R))
    requires I >Int 0

  rule closestVowel(CS)
    => closestScan(CS, isLen(CS) -Int 2, .IntSeq)

  // intSeqAt has rules only for in-bounds constructor cases in the supplied
  // semantics.  This derived definedness lemma exposes the corresponding
  // structural induction fact to the symbolic backend.
  rule #Ceil(intSeqAt(CS, I)) => #Top
    requires 0 <=Int I
     andBool I <Int isLen(CS)
    [simplification]

endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [loop-invariant]:
    <k>
      While(
        Compare(Name("i"), CmpOp(">", Int(0))),
        getClosestLoopBody)
      ~> Return(Name("result"))
      ~> #endcall
      => str(closestScan(CS, I, R))
    </k>
    <env> 1 => 0 </env>
    <scopes>
      ( 0 |-> scope(
          ( "_is_vowel" |-> closureVal(
              ("ch", .ParamNames),
              isVowelBody,
              0)
            "get_closest_vowel" |-> closureVal(
              ("word", .ParamNames),
              getClosestBody,
              0) ),
          parent(-1))
        1 |-> scope(
          ( "word"   |-> str(CS)
            "result" |-> str(R)
            "i"      |-> I ),
          parent(0))
        -1 |-> builtinsScope )
      =>
      ( 0 |-> scope(
          ( "_is_vowel" |-> closureVal(
              ("ch", .ParamNames),
              isVowelBody,
              0)
            "get_closest_vowel" |-> closureVal(
              ("word", .ParamNames),
              getClosestBody,
              0) ),
          parent(-1))
        -1 |-> builtinsScope )
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack>
      ListItem(frame(.K, 0, 1)) => .List
    </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires I >=Int 0
     andBool I +Int 1 <Int isLen(CS)

  claim [entry]:
    <k>
      #loadAll(getClosestProgram)
      ~> Call(Name("get_closest_vowel"), (str(CS), .Exprs))
      => str(closestVowel(CS))
    </k>
    <env> 0 </env>
    <scopes>
      ( 0 |-> scope(.Map, parent(-1))
        -1 |-> builtinsScope )
      =>
      ( 0 |-> scope(
          ( "_is_vowel" |-> closureVal(
              ("ch", .ParamNames),
              isVowelBody,
              0)
            "get_closest_vowel" |-> closureVal(
              ("word", .ParamNames),
              getClosestBody,
              0) ),
          parent(-1))
        -1 |-> builtinsScope )
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
