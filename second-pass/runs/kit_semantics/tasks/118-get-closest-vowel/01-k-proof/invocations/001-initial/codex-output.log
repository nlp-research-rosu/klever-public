diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..51d596d7844b654e13ea29337a3a67f6524a58a5
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,55 @@
+def _is_vowel(ch):
+    result = False
+    while ch == "a":
+        result = True
+        ch = ""
+    while ch == "e":
+        result = True
+        ch = ""
+    while ch == "i":
+        result = True
+        ch = ""
+    while ch == "o":
+        result = True
+        ch = ""
+    while ch == "u":
+        result = True
+        ch = ""
+    while ch == "A":
+        result = True
+        ch = ""
+    while ch == "E":
+        result = True
+        ch = ""
+    while ch == "I":
+        result = True
+        ch = ""
+    while ch == "O":
+        result = True
+        ch = ""
+    while ch == "U":
+        result = True
+        ch = ""
+    return result
+
+
+def get_closest_vowel(word):
+    result = ""
+    found = False
+    i = len(word) - 2
+    while i > 0:
+        while (not found and _is_vowel(word[i])
+               and not _is_vowel(word[i - 1])
+               and not _is_vowel(word[i + 1])):
+            result = word[i]
+            found = True
+        i = i - 1
+    return result
+
+
+r_yogurt = get_closest_vowel("yogurt")
+r_full = get_closest_vowel("FULL")
+r_quick = get_closest_vowel("quick")
+r_ab = get_closest_vowel("ab")
+r_empty = get_closest_vowel("")
+r_rightmost = get_closest_vowel("babeXid")
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7c40dc3e19095e06e5b741dc7b6b4cf487d5ec9d
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,87 @@
+requires "foundation.k"
+
+module CONNECTION-SPEC
+  imports FOUNDATION
+
+  claim [helper-vowel]:
+    <k>
+      #applyK(
+        toCall(closureVal(
+          ("ch", .ParamNames),
+          isVowelBody,
+          0)),
+        (str(iCons(C, .IntSeq)), .Vals))
+      ~> CONT:K
+      =>
+      true ~> CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires vowelPred(C)
+
+  claim [helper-consonant]:
+    <k>
+      #applyK(
+        toCall(closureVal(
+          ("ch", .ParamNames),
+          isVowelBody,
+          0)),
+        (str(iCons(C, .IntSeq)), .Vals))
+      ~> CONT:K
+      =>
+      false ~> CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool vowelPred(C)
+endmodule
diff --git a/continuation-mutation-spec.k b/continuation-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..81e37d3f48b39661a14d85aba616248eb9254bed
--- /dev/null
+++ b/continuation-mutation-spec.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module CONTINUATION-MUTATION-SPEC
+  imports VERIFICATION
+
+  claim [changed-suffix-must-not-prove]:
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp(">", Int(0))),
+        getClosestLoopBody)
+      ~> ( Assign(Name("result"), Str("x"))
+           Return(Name("result"))
+           .Stmts )
+      ~> #endcall
+      => str(strToCodes("a"))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(strToCodes("bab"))
+            "result" |-> str(.IntSeq)
+            "found"  |-> false
+            "i"      |-> 1 ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
