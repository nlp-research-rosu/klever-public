+            ("word", .ParamNames),
+            getClosestBody,
+            0),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "vowels" |-> str(strToCodes("aeiouAEIOU"))
+            "result" |-> str(R)
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "get_closest_vowel" |-> closureVal(
+            ("word", .ParamNames),
+            getClosestBody,
+            0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool I +Int 1 <Int isLen(CS)
+
+  claim [entry]:
+    <k>
+      #loadAll(getClosestProgram)
+      ~> Call(Name("get_closest_vowel"), (str(CS), .Exprs))
+      => str(closestVowel(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "get_closest_vowel" |-> closureVal(
+            ("word", .ParamNames),
+            getClosestBody,
+            0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
