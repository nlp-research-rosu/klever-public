diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..90ee0069a943c38886165f15f0ec172fb565385d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,47 @@
+def _is_vowel(ch):
+    result = False
+    while ch == "a":
+        result = True
+        ch = ""
+    while ch == "e":
+        result = True
+        ch = ""
+    while ch == "i":
+        result = True
+        ch = ""
+    while ch == "o":
+        result = True
+        ch = ""
+    while ch == "u":
+        result = True
+        ch = ""
+    while ch == "A":
+        result = True
+        ch = ""
+    while ch == "E":
+        result = True
+        ch = ""
+    while ch == "I":
+        result = True
+        ch = ""
+    while ch == "O":
+        result = True
+        ch = ""
+    while ch == "U":
+        result = True
+        ch = ""
+    return result
+
+
+def get_closest_vowel(word):
+    result = ""
+    found = False
+    i = len(word) - 2
+    while i > 0:
+        while (not found and _is_vowel(word[i])
+               and not _is_vowel(word[i - 1])
+               and not _is_vowel(word[i + 1])):
+            result = word[i]
+            found = True
+        i = i - 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..dfa62b79472562172dfaf9d54d18f1b09e3cda6b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [entry]:
+    <k>
+      #loadAll(getClosestProgram)
+      ~> Call(Name("get_closest_vowel"), (str(CS), .Exprs))
+      => str(closestVowel(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
