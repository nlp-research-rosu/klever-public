+  imports MPY-SYNTAX
+  imports MPY-CORE
+
+  syntax Stmts ::= "isVowelBody" [function, total]
+  syntax Stmts ::= "getClosestBody" [function, total]
+  syntax Stmts ::= "getClosestLoopBody" [function, total]
+  syntax Module ::= "getClosestProgram" [function, total]
+
+  syntax IntSeq ::= closestCandidate(IntSeq, Int) [function, total]
+  syntax Bool ::= vowelPred(Int) [function, total]
+  syntax Bool ::= isVowelCode(Int) [function, total]
+  syntax Bool ::= closestQualifies(IntSeq, Int) [function, total]
+  syntax IntSeq ::= closestScan(IntSeq, Int, IntSeq, Bool) [function]
+  syntax IntSeq ::= closestVowel(IntSeq) [function, total]
+endmodule
+
+module FOUNDATION
+  imports FOUNDATION-SYNTAX
+  imports MPY
+
+  rule isVowelBody =>
+    Assign(Name("result"), Bool(false))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("a"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("e"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("i"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("o"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("u"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("A"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("E"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("I"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("O"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    While(
+      Compare(Name("ch"), CmpOp("==", Str("U"))),
+      Assign(Name("result"), Bool(true))
+      Assign(Name("ch"), Str("")))
+    Return(Name("result"))
+
+  rule getClosestLoopBody =>
+    While(
+      BoolOp("and",
+        ( UnaryOp("not", Name("found")),
+          Call(
+            Name("_is_vowel"),
+            Subscript(Name("word"), Name("i"))),
+          UnaryOp(
+            "not",
+            Call(
+              Name("_is_vowel"),
+              Subscript(
+                Name("word"),
+                BinOp("-", Name("i"), Int(1))))),
+          UnaryOp(
+            "not",
+            Call(
+              Name("_is_vowel"),
+              Subscript(
+                Name("word"),
+                BinOp("+", Name("i"), Int(1))))),
+          .Exprs)),
+      Assign(Name("result"), Subscript(Name("word"), Name("i")))
+      Assign(Name("found"), Bool(true)))
+    Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+
+  rule getClosestBody =>
+    Assign(Name("result"), Str(""))
+    Assign(Name("found"), Bool(false))
+    Assign(
+      Name("i"),
+      BinOp("-", Call(Name("len"), Name("word")), Int(2)))
+    While(Compare(Name("i"), CmpOp(">", Int(0))), getClosestLoopBody)
+    Return(Name("result"))
+
+  rule getClosestProgram =>
+    Module(
+      FuncDef(
+        "_is_vowel",
+        Params("ch"),
+        isVowelBody)
+      FuncDef(
+        "get_closest_vowel",
+        Params("word"),
+        getClosestBody))
+
+  rule closestCandidate(CS, I)
+    => iCons(intSeqAt(CS, I), .IntSeq)
+
+  rule vowelPred(C)
+    => C ==Int 97
+     orBool C ==Int 101
+     orBool C ==Int 105
+     orBool C ==Int 111
+     orBool C ==Int 117
+     orBool C ==Int 65
+     orBool C ==Int 69
+     orBool C ==Int 73
+     orBool C ==Int 79
+     orBool C ==Int 85
+  rule isVowelCode(C)
+    => true
+    requires vowelPred(C)
+  rule isVowelCode(C)
+    => false
+    requires notBool vowelPred(C)
+
+  rule closestQualifies(CS, I)
+    => isVowelCode(intSeqAt(CS, I))
+       andBool notBool isVowelCode(intSeqAt(CS, I -Int 1))
+       andBool notBool isVowelCode(intSeqAt(CS, I +Int 1))
+
+  rule closestScan(_CS, I, R, _F) => R
+    requires I <=Int 0
+  rule closestScan(CS, I, R, true)
+    => closestScan(CS, I -Int 1, R, true)
+    requires I >Int 0
+  rule closestScan(CS, I, R, false)
+    => closestScan(
+         CS,
+         I -Int 1,
+         closestCandidate(CS, I),
+         true)
+    requires I >Int 0
+     andBool closestQualifies(CS, I)
+  rule closestScan(CS, I, R, false)
+    => closestScan(CS, I -Int 1, R, false)
+    requires I >Int 0
+     andBool notBool closestQualifies(CS, I)
+
+  rule closestVowel(CS)
+    => closestScan(CS, isLen(CS) -Int 2, .IntSeq, false)
+
+  // intSeqAt has rules only for in-bounds constructor cases in the supplied
+  // semantics.  This derived definedness lemma exposes the corresponding
+  // structural induction fact to the symbolic backend.
+  rule #Ceil(intSeqAt(CS, I)) => #Top
+    requires 0 <=Int I
+     andBool I <Int isLen(CS)
+    [simplification]
+
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..90ee0069a943c38886165f15f0ec172fb565385d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,47 @@
+def _is_vowel(ch):
+    result = False
+    while ch == "a":
+        result = True
+        ch = ""
+    while ch == "e":
+        result = True
+        ch = ""
+    while ch == "i":
+        result = True
+        ch = ""
+    while ch == "o":
+        result = True
+        ch = ""
+    while ch == "u":
+        result = True
+        ch = ""
+    while ch == "A":
+        result = True
+        ch = ""
+    while ch == "E":
+        result = True
+        ch = ""
+    while ch == "I":
+        result = True
+        ch = ""
+    while ch == "O":
+        result = True
+        ch = ""
+    while ch == "U":
+        result = True
+        ch = ""
+    return result
+
+
+def get_closest_vowel(word):
+    result = ""
+    found = False
+    i = len(word) - 2
+    while i > 0:
+        while (not found and _is_vowel(word[i])
+               and not _is_vowel(word[i - 1])
+               and not _is_vowel(word[i + 1])):
+            result = word[i]
+            found = True
+        i = i - 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6700462db6707c0a6258265dade94e821fd6e904
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,89 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp(">", Int(0))),
+        getClosestLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => str(closestScan(CS, I, R, F))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool I +Int 1 <Int isLen(CS)
+
+  claim [entry]:
+    <k>
+      #loadAll(getClosestProgram)
+      ~> Call(Name("get_closest_vowel"), (str(CS), .Exprs))
+      => str(closestVowel(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..15857da026e9cf6bc40d783484233ea2260c18d7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,101 @@
+requires "foundation.k"
+
+module VERIFICATION-SYNTAX
+  imports FOUNDATION-SYNTAX
+endmodule
+
+module VERIFICATION
+  imports FOUNDATION
+
+  // These exact-context call summaries are justified by the bridge-free
+  // helper claims in connection-spec.k.  Their arbitrary k continuation is
+  // contained by the CONT:K quantified in those claims; all other cells and
+  // bindings are matched exactly and remain unchanged.
+  rule
+    <k>
+      #applyK(
+        toCall(closureVal(
+          ("ch", .ParamNames),
+          HELPERBODY,
+          0)),
+        (str(iCons(C, .IntSeq)), .Vals))
+      => true
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              HELPERBODY,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              TARGETBODY,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires HELPERBODY ==K isVowelBody
+     andBool TARGETBODY ==K getClosestBody
+     andBool BUILTINS ==K builtinsScope
+     andBool vowelPred(C)
+    [priority(40)]
+
+  rule
+    <k>
+      #applyK(
+        toCall(closureVal(
+          ("ch", .ParamNames),
+          HELPERBODY,
+          0)),
+        (str(iCons(C, .IntSeq)), .Vals))
+      => false
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              HELPERBODY,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              TARGETBODY,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires HELPERBODY ==K isVowelBody
+     andBool TARGETBODY ==K getClosestBody
+     andBool BUILTINS ==K builtinsScope
+     andBool notBool vowelPred(C)
+    [priority(40)]
+endmodule

