+            "vowels" |-> str(strToCodes("aeiouAEIOU"))
+            "result" |-> str(R)
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "get_closest_vowel" |-> closureVal(
+            ("word", .ParamNames),
+            getClosestBody,
+            0),
+          parent(-1))
