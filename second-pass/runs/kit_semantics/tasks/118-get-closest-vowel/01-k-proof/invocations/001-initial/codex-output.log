+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
