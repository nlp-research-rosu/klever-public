@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [entry]:
+    <k>
+      #loadAll(getClosestProgram)
+      ~> Call(Name("get_closest_vowel"), (str(CS), .Exprs))
+      => str(closestVowel(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
