diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6099d2f834d1b99ed099d883f8dbb5cd6675618a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    result = ""
+    i = len(word) - 2
+    while i > 0:
+        if result == "":
+            if word[i] in vowels:
+                if word[i - 1] not in vowels:
+                    if word[i + 1] not in vowels:
+                        result = word[i]
+        i = i - 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f9dddf32c086d9cfa0fd4b8c3101f42501b2bd9b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      While(
+        Compare(Name("i"), CmpOp(">", Int(0))),
+        getClosestLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => str(closestScan(CS, I, R))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "get_closest_vowel" |-> closureVal(
+            ("word", .ParamNames),
+            getClosestBody,
+            0),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "vowels" |-> str(strToCodes("aeiouAEIOU"))
+            "result" |-> str(R)
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "get_closest_vowel" |-> closureVal(
+            ("word", .ParamNames),
+            getClosestBody,
+            0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool I +Int 1 <Int isLen(CS)
+
+  claim [entry]:
+    <k>
+      #loadAll(getClosestProgram)
+      ~> Call(Name("get_closest_vowel"), (str(CS), .Exprs))
+      => str(closestVowel(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "get_closest_vowel" |-> closureVal(
+            ("word", .ParamNames),
+            getClosestBody,
+            0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
