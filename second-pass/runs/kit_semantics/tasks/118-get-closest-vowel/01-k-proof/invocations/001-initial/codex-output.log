+    If(Compare(Name("result"), CmpOp("==", Str(""))),
+      If(Compare(
+        Subscript(Name("word"), Name("i")),
+        CmpOp("in", Name("vowels"))),
+        If(Compare(
+          Subscript(Name("word"), BinOp("-", Name("i"), Int(1))),
+          CmpOp("not in", Name("vowels"))),
+          If(Compare(
+            Subscript(Name("word"), BinOp("+", Name("i"), Int(1))),
+            CmpOp("not in", Name("vowels"))),
+            Assign(Name("result"), Subscript(Name("word"), Name("i"))),
+            .Stmts),
+          .Stmts),
+        .Stmts),
+      .Stmts)
+    Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+
+  rule getClosestBody =>
+    Assign(Name("vowels"), Str("aeiouAEIOU"))
+    Assign(Name("result"), Str(""))
+    Assign(
+      Name("i"),
+      BinOp("-", Call(Name("len"), Name("word")), Int(2)))
+    While(Compare(Name("i"), CmpOp(">", Int(0))), getClosestLoopBody)
+    Return(Name("result"))
+
+  rule getClosestProgram =>
+    Module(
+      FuncDef(
+        "get_closest_vowel",
+        Params("word"),
+        getClosestBody))
+
+  rule closestCandidate(CS, I)
+    => iCons(intSeqAt(CS, I), .IntSeq)
+
+  rule isVowelCode(C)
+    => C ==Int 97
+       orBool C ==Int 101
+       orBool C ==Int 105
+       orBool C ==Int 111
+       orBool C ==Int 117
+       orBool C ==Int 65
+       orBool C ==Int 69
+       orBool C ==Int 73
+       orBool C ==Int 79
+       orBool C ==Int 85
+
+  rule closestQualifies(CS, I)
+    => isVowelCode(intSeqAt(CS, I))
+       andBool notBool isVowelCode(intSeqAt(CS, I -Int 1))
+       andBool notBool isVowelCode(intSeqAt(CS, I +Int 1))
+
+  rule closestPick(CS, I, R)
+    => #if R ==K .IntSeq andBool closestQualifies(CS, I)
+       #then closestCandidate(CS, I)
+       #else R
+       #fi
+
+  rule closestScan(_CS, I, R) => R
+    requires I <=Int 0
+  rule closestScan(CS, I, R)
+    => closestScan(CS, I -Int 1, closestPick(CS, I, R))
+    requires I >Int 0
+
+  rule closestVowel(CS)
+    => closestScan(CS, isLen(CS) -Int 2, .IntSeq)
+
+  // intSeqAt has rules only for in-bounds constructor cases in the supplied
+  // semantics.  This derived definedness lemma exposes the corresponding
+  // structural induction fact to the symbolic backend.
+  rule #Ceil(intSeqAt(CS, I)) => #Top
+    requires 0 <=Int I
+     andBool I <Int isLen(CS)
+    [simplification]
+
+  // Finite expansion of the supplied strContains/strPrefix equations for a
+  // one-character string and the exact ten-character vowel literal.
+  rule strContains(
+         iCons(C, .IntSeq),
+         iCons(97,
+           iCons(101,
+             iCons(105,
+               iCons(111,
+                 iCons(117,
+                   iCons(65,
+                     iCons(69,
+                       iCons(73,
+                         iCons(79,
+                           iCons(85, .IntSeq)))))))))))
+    => isVowelCode(C)
+    [simplification]
+endmodule

