+      Name("i"),
+      BinOp("-", Call(Name("len"), Name("word")), Int(2)))
+    While(Compare(Name("i"), CmpOp(">", Int(0))), getClosestLoopBody)
+    Return(Name("result"))
+
+  rule getClosestProgram =>
+    Module(
+      FuncDef(
+        "_is_vowel",
+        Params("ch"),
+        isVowelBody)
+      FuncDef(
+        "get_closest_vowel",
+        Params("word"),
+        getClosestBody))
+
+  rule closestCandidate(CS, I)
+    => iCons(intSeqAt(CS, I), .IntSeq)
+
+  rule vowelPred(C)
+    => C ==Int 97
+     orBool C ==Int 101
+     orBool C ==Int 105
