diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9fba2c48a8b74af90f6f8eb97e9590319798cc03
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    result = ""
+    i = len(word) - 2
+    while i > 0:
+        while (result == "" and word[i] in vowels
+               and word[i - 1] not in vowels
+               and word[i + 1] not in vowels):
+            result = word[i]
+        i = i - 1
+    return result
