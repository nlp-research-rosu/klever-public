--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    result = ""
+    i = len(word) - 2
+    while i > 0:
+        while (result == "" and word[i] in vowels
+               and word[i - 1] not in vowels
+               and word[i + 1] not in vowels):
+            result = word[i]
+        i = i - 1
+    return result
