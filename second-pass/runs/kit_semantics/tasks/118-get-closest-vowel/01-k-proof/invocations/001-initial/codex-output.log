+    <k>
+      Call(
+        Name("_is_vowel"),
+        (str(iCons(C, .IntSeq)), .Exprs))
+      ~> CONT:K
+      =>
+      false ~> CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
