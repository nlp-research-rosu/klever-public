diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..5a6eeaa7e667ebca0d40acb62ebb6ab32265065b
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,52 @@
+from itertools import product
+from random import Random
+from string import ascii_letters
+
+from solution import get_closest_vowel
+
+
+def oracle(word):
+    vowels = "aeiouAEIOU"
+    for i in range(len(word) - 2, 0, -1):
+        if (word[i] in vowels
+                and word[i - 1] not in vowels
+                and word[i + 1] not in vowels):
+            return word[i]
+    return ""
+
+
+def main():
+    cases = [
+        "yogurt",
+        "FULL",
+        "quick",
+        "ab",
+        "",
+        "babeXid",
+    ]
+
+    alphabet = "abEYZ"
+    for length in range(8):
+        cases.extend("".join(chars) for chars in product(alphabet, repeat=length))
+
+    rng = Random(20260725)
+    for _ in range(5000):
+        length = rng.randrange(0, 41)
+        cases.append("".join(rng.choice(ascii_letters) for _ in range(length)))
+
+    mismatches = []
+    for word in cases:
+        actual = get_closest_vowel(word)
+        expected = oracle(word)
+        if actual != expected:
+            mismatches.append((word, actual, expected))
+
+    print(f"differential cases={len(cases)} mismatches={len(mismatches)}")
+    if mismatches:
+        for mismatch in mismatches[:10]:
+            print(repr(mismatch))
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1421358f0b0399a61b1983f3af2d0c9a7721863
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,88 @@
+requires "helper-verification.k"
+
+module VERIFICATION-SYNTAX
+  imports HELPER-VERIFICATION-SYNTAX
+endmodule
+
+module VERIFICATION
+  imports HELPER-VERIFICATION
+
+  // Exact loop/return/frame-pop summary justified by the bridge-free
+  // reachability theorem in loop-connection-spec.k.
+  rule
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp(">", Int(0))),
+        While(
+          BoolOp("and",
+            ( UnaryOp("not", Name("found")),
+              Call(
+                Name("_is_vowel"),
+                Subscript(Name("word"), Name("i"))),
+              UnaryOp(
+                "not",
+                Call(
+                  Name("_is_vowel"),
+                  Subscript(
+                    Name("word"),
+                    BinOp("-", Name("i"), Int(1))))),
+              UnaryOp(
+                "not",
+                Call(
+                  Name("_is_vowel"),
+                  Subscript(
+                    Name("word"),
+                    BinOp("+", Name("i"), Int(1))))),
+              .Exprs)),
+          Assign(Name("result"), Subscript(Name("word"), Name("i")))
+          Assign(Name("found"), Bool(true)))
+        Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => str(closestScan(CS, I, R, F))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool I +Int 1 <Int isLen(CS)
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'python3 validate.py' in /workspace
