+        toCall(closureVal(
+          ("ch", .ParamNames),
+          isVowelBody,
+          0)),
+        (str(iCons(C, .IntSeq)), .Vals))
+      ~> CONT:K
+      =>
+      false ~> CONT
+    </k>
