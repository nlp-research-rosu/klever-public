+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(strToCodes("bab"))
+            "result" |-> str(.IntSeq)
+            "found"  |-> false
+            "i"      |-> 1 ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
