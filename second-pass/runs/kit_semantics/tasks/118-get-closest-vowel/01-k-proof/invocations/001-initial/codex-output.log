+  // structural induction fact to the symbolic backend.
+  rule #Ceil(intSeqAt(CS, I)) => #Top
+    requires 0 <=Int I
+     andBool I <Int isLen(CS)
+    [simplification]
+
+endmodule

exec
/bin/bash -lc "python3 py2mpy.py solution.py > solution.mpy && sed -n '1,260p' solution.mpy && python3 - <<'PY'
from solution import get_closest_vowel
cases = [('yogurt','u'), ('FULL','U'), ('quick',''), ('ab',''), ('',''), ('abc',''), ('baXeb','e')]
for value, expected in cases:
    actual = get_closest_vowel(value)
    print(repr(value), repr(actual), actual == expected)
PY
kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module VERIFICATION-SYNTAX --output-definition verification-kompiled" in /workspace
