+requires "reference-semantics/semantics.k"
+
+module DEFINEDNESS-SPEC
+  imports MPY
+
+  claim [int-seq-at-defined]:
+    <k> .K </k>
+    requires 0 <=Int I
+     andBool I <Int isLen(CS)
+    ensures #Ceil(intSeqAt(CS, I))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6099d2f834d1b99ed099d883f8dbb5cd6675618a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    result = ""
+    i = len(word) - 2
+    while i > 0:
+        if result == "":
+            if word[i] in vowels:
+                if word[i - 1] not in vowels:
+                    if word[i + 1] not in vowels:
+                        result = word[i]
+        i = i - 1
+    return result
