+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
