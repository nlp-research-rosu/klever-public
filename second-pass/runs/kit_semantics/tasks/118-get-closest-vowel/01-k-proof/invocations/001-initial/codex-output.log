+          Call(
+            Name("_is_vowel"),
+            Subscript(Name("word"), Name("i"))),
+          UnaryOp(
+            "not",
+            Call(
+              Name("_is_vowel"),
+              Subscript(
+                Name("word"),
+                BinOp("-", Name("i"), Int(1))))),
+          UnaryOp(
+            "not",
+            Call(
+              Name("_is_vowel"),
+              Subscript(
+                Name("word"),
