diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e81a145c3e5b1510b0c09130bccca300fc78c7d0
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,82 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+
+  syntax Stmts ::= "getClosestBody" [function, total]
+  syntax Stmts ::= "getClosestLoopBody" [function, total]
+  syntax Module ::= "getClosestProgram" [function, total]
+
+  syntax IntSeq ::= closestCandidate(IntSeq, Int) [function, total]
+  syntax Bool ::= closestQualifies(IntSeq, Int) [function, total]
+  syntax IntSeq ::= closestPick(IntSeq, Int, IntSeq) [function, total]
+  syntax IntSeq ::= closestScan(IntSeq, Int, IntSeq) [function]
+  syntax IntSeq ::= closestVowel(IntSeq) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule getClosestLoopBody =>
+    If(Compare(Name("result"), CmpOp("==", Str(""))),
+      If(Compare(
+        Subscript(Name("word"), Name("i")),
+        CmpOp("in", Name("vowels"))),
+        If(Compare(
+          Subscript(Name("word"), BinOp("-", Name("i"), Int(1))),
+          CmpOp("not in", Name("vowels"))),
+          If(Compare(
+            Subscript(Name("word"), BinOp("+", Name("i"), Int(1))),
+            CmpOp("not in", Name("vowels"))),
+            Assign(Name("result"), Subscript(Name("word"), Name("i"))),
+            .Stmts),
+          .Stmts),
+        .Stmts),
+      .Stmts)
+    Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+
+  rule getClosestBody =>
+    Assign(Name("vowels"), Str("aeiouAEIOU"))
+    Assign(Name("result"), Str(""))
+    Assign(
+      Name("i"),
+      BinOp("-", Call(Name("len"), Name("word")), Int(2)))
+    While(Compare(Name("i"), CmpOp(">", Int(0))), getClosestLoopBody)
+    Return(Name("result"))
+
+  rule getClosestProgram =>
+    Module(
+      FuncDef(
+        "get_closest_vowel",
+        Params("word"),
+        getClosestBody))
+
+  rule closestCandidate(CS, I)
+    => iCons(intSeqAt(CS, I), .IntSeq)
+
+  rule closestQualifies(CS, I)
+    => strContains(closestCandidate(CS, I), strToCodes("aeiouAEIOU"))
+       andBool notBool strContains(
+         closestCandidate(CS, I -Int 1),
+         strToCodes("aeiouAEIOU"))
+       andBool notBool strContains(
+         closestCandidate(CS, I +Int 1),
+         strToCodes("aeiouAEIOU"))
+
+  rule closestPick(CS, I, R)
+    => #if R ==K .IntSeq andBool closestQualifies(CS, I)
+       #then closestCandidate(CS, I)
+       #else R
+       #fi
+
+  rule closestScan(_CS, I, R) => R
+    requires I <=Int 0
+  rule closestScan(CS, I, R)
+    => closestScan(CS, I -Int 1, closestPick(CS, I, R))
+    requires I >Int 0
+
+  rule closestVowel(CS)
+    => closestScan(CS, isLen(CS) -Int 2, .IntSeq)
+endmodule

