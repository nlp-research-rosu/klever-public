+    [priority(40)]
+
+  rule
+    <k>
+      #applyK(
+        toCall(closureVal(
+          ("ch", .ParamNames),
+          HELPERBODY,
+          0)),
+        (str(iCons(C, .IntSeq)), .Vals))
+      => false
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              HELPERBODY,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              TARGETBODY,
+              0) ),
