+               iCons(111,
+                 iCons(117,
+                   iCons(65,
+                     iCons(69,
+                       iCons(73,
+                         iCons(79,
+                           iCons(85, .IntSeq)))))))))))
+    => isVowelCode(C)
+    [simplification]
