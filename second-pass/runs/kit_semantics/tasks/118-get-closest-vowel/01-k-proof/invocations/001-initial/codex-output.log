+        1 |-> scope(
+          ( "word"   |-> str(strToCodes("bab"))
+            "result" |-> str(.IntSeq)
+            "found"  |-> false
+            "i"      |-> 1 ),
+          parent(0))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/helper-verification.k b/helper-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3aca1e8924ab53ef9d68982c95f85522256369f7
--- /dev/null
+++ b/helper-verification.k
@@ -0,0 +1,95 @@
+requires "foundation.k"
+
+module HELPER-VERIFICATION-SYNTAX
+  imports FOUNDATION-SYNTAX
+endmodule
+
+module HELPER-VERIFICATION
+  imports FOUNDATION
+
+  // These exact-context call summaries are justified by the bridge-free
+  // helper claims in connection-spec.k.  Their arbitrary k continuation is
+  // contained by the CONT:K quantified in those claims; all other cells and
+  // bindings are matched exactly and remain unchanged.
+  rule
+    <k>
+      #applyK(
+        toCall(closureVal(
+          ("ch", .ParamNames),
+          isVowelBody,
+          0)),
+        (str(iCons(C, .IntSeq)), .Vals))
+      => true
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires vowelPred(C)
+    [priority(40)]
+
+  rule
+    <k>
+      #applyK(
+        toCall(closureVal(
+          ("ch", .ParamNames),
+          isVowelBody,
+          0)),
+        (str(iCons(C, .IntSeq)), .Vals))
+      => false
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(CS)
+            "result" |-> str(R)
+            "found"  |-> F
+            "i"      |-> I ),
+          parent(0))
+        -1 |-> BUILTINS )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool vowelPred(C)
+    [priority(40)]
+endmodule
diff --git a/loop-body-mutation-spec.k b/loop-body-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5a30bda0134fdfdd0eb34be79af2c9a0d08158e9
--- /dev/null
+++ b/loop-body-mutation-spec.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module LOOP-BODY-MUTATION-SPEC
+  imports VERIFICATION
+
+  claim [mutated-loop-must-not-prove]:
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp(">", Int(0))),
+        While(
+          BoolOp("and",
+            ( UnaryOp("not", Name("found")),
+              Call(
+                Name("_is_vowel"),
+                Subscript(Name("word"), Name("i"))),
+              UnaryOp(
+                "not",
+                Call(
+                  Name("_is_vowel"),
+                  Subscript(
+                    Name("word"),
+                    BinOp("-", Name("i"), Int(1))))),
+              UnaryOp(
+                "not",
+                Call(
+                  Name("_is_vowel"),
+                  Subscript(
+                    Name("word"),
+                    BinOp("+", Name("i"), Int(1))))),
+              .Exprs)),
+          Assign(Name("result"), Subscript(Name("word"), Name("i")))
+          Assign(Name("found"), Bool(true)))
+        Assign(Name("i"), BinOp("-", Name("i"), Int(2))))
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => str(strToCodes("a"))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        1 |-> scope(
+          ( "word"   |-> str(strToCodes("bbabc"))
+            "result" |-> str(.IntSeq)
+            "found"  |-> false
+            "i"      |-> 3 ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          ( "_is_vowel" |-> closureVal(
+              ("ch", .ParamNames),
+              isVowelBody,
+              0)
+            "get_closest_vowel" |-> closureVal(
+              ("word", .ParamNames),
+              getClosestBody,
+              0) ),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
