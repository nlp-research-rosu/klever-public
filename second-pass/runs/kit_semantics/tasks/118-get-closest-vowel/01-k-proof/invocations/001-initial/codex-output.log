+    requires C ==Int 97
+     orBool C ==Int 101
+     orBool C ==Int 105
+     orBool C ==Int 111
+     orBool C ==Int 117
+     orBool C ==Int 65
+     orBool C ==Int 69
+     orBool C ==Int 73
+     orBool C ==Int 79
+     orBool C ==Int 85
+  rule isVowelCode(C)
+    => false
+    requires notBool (
+       C ==Int 97
+       orBool C ==Int 101
+       orBool C ==Int 105
+       orBool C ==Int 111
+       orBool C ==Int 117
+       orBool C ==Int 65
+       orBool C ==Int 69
+       orBool C ==Int 73
+       orBool C ==Int 79
+       orBool C ==Int 85)
+
+  rule closestQualifies(CS, I)
+    => isVowelCode(intSeqAt(CS, I))
+       andBool notBool isVowelCode(intSeqAt(CS, I -Int 1))
+       andBool notBool isVowelCode(intSeqAt(CS, I +Int 1))
+
+  rule closestPick(CS, I, R)
+    => #if R ==K .IntSeq andBool closestQualifies(CS, I)
+       #then closestCandidate(CS, I)
