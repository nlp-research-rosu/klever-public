exec
/bin/bash -lc "set +e
for item in 'spec-vacuity.k|verification-kompiled|SPEC-VACUITY' 'helper-body-mutation-spec.k|connection-kompiled|HELPER-BODY-MUTATION-SPEC' 'loop-body-mutation-spec.k|verification-kompiled|LOOP-BODY-MUTATION-SPEC' 'continuation-mutation-spec.k|verification-kompiled|CONTINUATION-MUTATION-SPEC'; do
  IFS='|' read -r spec_file spec_def spec_module <<< \""'$item"
  echo "PROBE $spec_file"
  kprove "$spec_file" --definition "$spec_def" --spec-module "$spec_module"
  echo "EXIT $?"
done
exit 0' in /workspace
