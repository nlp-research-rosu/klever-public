     7	module HELPER-VERIFICATION
     8	  imports FOUNDATION
     9	
    10	  // These exact-context call summaries are justified by the bridge-free
    11	  // helper claims in connection-spec.k.  Their arbitrary k continuation is
    12	  // contained by the CONT:K quantified in those claims; all other cells and
    13	  // bindings are matched exactly and remain unchanged.
    14	  rule
    15	    <k>
    16	      #applyK(
    17	        toCall(closureVal(
    18	          ("ch", .ParamNames),
    19	          isVowelBody,
    20	          0)),
    21	        (str(iCons(C, .IntSeq)), .Vals))
    22	      => true
    23	      ...
    24	    </k>
    25	    <env> 1 </env>
    26	    <scopes>
    27	      ( 0 |-> scope(
    28	          ( "_is_vowel" |-> closureVal(
    29	              ("ch", .ParamNames),
    30	              isVowelBody,
    31	              0)
    32	            "get_closest_vowel" |-> closureVal(
    33	              ("word", .ParamNames),
    34	              getClosestBody,
    35	              0) ),
    36	          parent(-1))
    37	        1 |-> scope(
    38	          ( "word"   |-> str(CS)
    39	            "result" |-> str(R)
    40	            "found"  |-> F
    41	            "i"      |-> I ),
    42	          parent(0))
    43	        -1 |-> BUILTINS )
    44	    </scopes>
    45	    <scopeLoc> 2 </scopeLoc>
    46	    <heap> .Map </heap>
    47	    <heapLoc> 0 </heapLoc>
    48	    <stack> ListItem(frame(.K, 0, 1)) </stack>
    49	    <ret> noRet </ret>
    50	    <exc> NoExc </exc>
    51	    <exit-code> 0 </exit-code>
    52	    requires vowelPred(C)
