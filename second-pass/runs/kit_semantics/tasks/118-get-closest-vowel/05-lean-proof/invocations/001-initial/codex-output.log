--- /dev/null
+++ b/.lean_getpid_shim.c
@@ -0,0 +1,14 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+pid_t getpid(void) {
+  char buffer[64];
+  ssize_t count = readlink("/proc/self", buffer, sizeof(buffer) - 1);
+  if (count <= 0) {
+    return 1;
+  }
+  buffer[count] = '\0';
+  return (pid_t)strtol(buffer, NULL, 10);
+}
