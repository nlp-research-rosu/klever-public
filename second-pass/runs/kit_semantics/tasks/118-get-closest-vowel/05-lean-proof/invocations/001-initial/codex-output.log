diff --git a/.lean_getpid_shim.c b/.lean_getpid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..a906190a8979d3f9e04815d467a23b2c2a9c64fa
--- /dev/null
+++ b/.lean_getpid_shim.c
@@ -0,0 +1,14 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+pid_t getpid(void) {
+  char buffer[64];
+  ssize_t count = readlink("/proc/self", buffer, sizeof(buffer) - 1);
+  if (count <= 0) {
+    return 1;
+  }
+  buffer[count] = '\0';
+  return (pid_t)strtol(buffer, NULL, 10);
+}
