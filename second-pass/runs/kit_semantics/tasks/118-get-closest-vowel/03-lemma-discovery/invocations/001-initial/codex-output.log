  "start_line": 24,
  "text": "  rule isVowelBody =>\n    Assign(Name(\"result\"), Bool(false))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"a\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"e\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"i\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"o\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"u\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"A\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"E\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"I\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"O\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    While(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"U\"))),\n      Assign(Name(\"result\"), Bool(true))\n      Assign(Name(\"ch\"), Str(\"\")))\n    Return(Name(\"result\"))"
}

