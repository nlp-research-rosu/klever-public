import json,sys
inv=json.load(open('/reference/rule-inventory.json'))
out=json.load(open('/workspace/trust-boundary.json'))
errors=[]
if list(out)"'!=['"'schema_version','inventory_sha256','rules']:
 errors.append(f'top-level keys/order: {list(out)}')
if set(out)"'!= {'"'schema_version','inventory_sha256','rules'}: errors.append('top-level key set')
if out['schema_version'] "'!= 2: errors.append('"'schema version')
if out['inventory_sha256'] "'!= inv['"'inventory_sha256']: errors.append('inventory sha')
irs=[r['source_rule_id'] for r in inv['rules']]
ors=[r['source_rule_id'] for r in out['rules']]
if ors "'!= irs: errors.append('"'rule ids/order mismatch')
if len(ors)"'!=len(set(ors)): errors.append('"'duplicate source_rule_id')
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
for i,r in enumerate(out['rules']):
 if list(r)"'!=['"'source_rule_id','classification','rationale']:
  errors.append(f'entry {i} keys/order {list(r)}')
 if set(r)"'!= {'"'source_rule_id','classification','rationale'}:errors.append(f'entry {i} key set')
 if r['classification'] not in allowed:errors.append(f'entry {i} classification')
 if not isinstance(r['rationale'],str) or not r['rationale'].strip():errors.append(f'entry {i} rationale')
 attrs=inv['rules'][i].get('attributes',[])
 if any('simplification' in x for x in attrs) and r['classification'] not in {'DEFINITION','DOMAIN_LEMMA'}:
  errors.append(f'entry {i} simplification classification')
from collections import Counter
print('inventory_sha256:',out['inventory_sha256'])
print('rules:',len(out['rules']))
print('classification counts:',dict(Counter(r['classification'] for r in out['rules'])))
print('simplification positions:',[i for i,r in enumerate(inv['rules']) if any('simplification' in x for x in r.get('attributes',[]))])
print('domain IDs:',[r['source_rule_id'] for r in out['rules'] if r['classification']=='DOMAIN_LEMMA'])
print('errors:',errors)
if errors:sys.exit(1)
PY
