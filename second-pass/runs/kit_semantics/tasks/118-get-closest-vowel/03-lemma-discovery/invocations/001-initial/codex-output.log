  "text": "  rule getClosestLoopBody =>\n    While(\n      BoolOp(\"and\",\n        ( UnaryOp(\"not\", Name(\"found\")),\n          Call(\n            Name(\"_is_vowel\"),\n            Subscript(Name(\"word\"), Name(\"i\"))),\n          UnaryOp(\n            \"not\",\n            Call(\n              Name(\"_is_vowel\"),\n              Subscript(\n                Name(\"word\"),\n                BinOp(\"-\", Name(\"i\"), Int(1))))),\n          UnaryOp(\n            \"not\",\n            Call(\n              Name(\"_is_vowel\"),\n              Subscript(\n                Name(\"word\"),\n                BinOp(\"+\", Name(\"i\"), Int(1))))),\n          .Exprs)),\n      Assign(Name(\"result\"), Subscript(Name(\"word\"), Name(\"i\")))\n      Assign(Name(\"found\"), Bool(true)))\n    Assign(Name(\"i\"), BinOp(\"-\", Name(\"i\"), Int(1)))"
}

