  "text": "  rule\n    <k>\n      #while(\n        Compare(Name(\"i\"), CmpOp(\">\", Int(0))),\n        While(\n          BoolOp(\"and\",\n            ( UnaryOp(\"not\", Name(\"found\")),\n              Call(\n                Name(\"_is_vowel\"),\n                Subscript(Name(\"word\"), Name(\"i\"))),\n              UnaryOp(\n                \"not\",\n                Call(\n                  Name(\"_is_vowel\"),\n                  Subscript(\n                    Name(\"word\"),\n                    BinOp(\"-\", Name(\"i\"), Int(1))))),\n              UnaryOp(\n                \"not\",\n                Call(\n                  Name(\"_is_vowel\"),\n                  Subscript(\n                    Name(\"word\"),\n                    BinOp(\"+\", Name(\"i\"), Int(1))))),\n              .Exprs)),\n          Assign(Name(\"result\"), Subscript(Name(\"word\"), Name(\"i\")))\n          Assign(Name(\"found\"), Bool(true)))\n        Assign(Name(\"i\"), BinOp(\"-\", Name(\"i\"), Int(1))))\n      ~> (Return(Name(\"result\")) .Stmts)\n      ~> #endcall\n      => str(closestScan(CS, I, R, F))\n    </k>\n    <env> 1 => 0 </env>\n    <scopes>\n      ( 0 |-> scope(\n          ( \"_is_vowel\" |-> closureVal(\n              (\"ch\", .ParamNames),\n              isVowelBody,\n              0)\n            \"get_closest_vowel\" |-> closureVal(\n              (\"word\", .ParamNames),\n              getClosestBody,\n              0) ),\n          parent(-1))\n        1 |-> scope(\n          ( \"word\"   |-> str(CS)\n            \"result\" |-> str(R)\n            \"found\"  |-> F\n            \"i\"      |-> I ),\n          parent(0))\n        -1 |-> BUILTINS )\n      =>\n      ( 0 |-> scope(\n          ( \"_is_vowel\" |-> closureVal(\n              (\"ch\", .ParamNames),\n              isVowelBody,\n              0)\n            \"get_closest_vowel\" |-> closureVal(\n              (\"word\", .ParamNames),\n              getClosestBody,\n              0) ),\n          parent(-1))\n        -1 |-> BUILTINS )\n    </scopes>\n    <scopeLoc> 2 => 1 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack>\n      ListItem(frame(.K, 0, 1)) => .List\n    </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    requires I >=Int 0\n     andBool I +Int 1 <Int isLen(CS)\n    [priority(40)]"
