+++ b/evidence/run_stage2.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/132-is-nested-review || exit 90
+
+run_and_record() {
+  echo "\$ $*"
