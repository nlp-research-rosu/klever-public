ls -la /opt/elan/toolchains
ls -la /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin | head -80
/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean --version 2>&1 || true
/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake --version 2>&1 || true
ELAN_HOME=/opt/elan lean --version 2>&1 || true
