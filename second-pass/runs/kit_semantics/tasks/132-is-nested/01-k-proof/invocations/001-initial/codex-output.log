--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,22 @@
+def is_nested(string):
+    state = 0
+    bracket = ""
+    for bracket in string:
+        if state < 2:
+            if bracket == "[":
+                state += 1
+        elif state < 4:
+            if bracket == "]":
+                state += 1
+    return state == 4
+
+
+assert is_nested("[[]]") == True
+assert is_nested("[]]]]]]][[[[[]") == False
+assert is_nested("[][]") == False
+assert is_nested("[]") == False
+assert is_nested("[[][]]") == True
+assert is_nested("[[]][[") == True
+assert is_nested("") == False
+assert is_nested("[[") == False
+assert is_nested("]]][[]]") == True
