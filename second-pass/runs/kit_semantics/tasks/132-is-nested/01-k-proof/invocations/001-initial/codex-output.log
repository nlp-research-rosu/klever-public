diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..a7ba663de8105e14ca97a4182a9c17c6256d984d
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,22 @@
+def is_nested(string):
+    state = 0
+    bracket = ""
+    for bracket in string:
+        if state < 2:
+            if bracket == "[":
+                state += 1
+        elif state < 4:
+            if bracket == "]":
+                state += 1
+    return state == 4
+
+
+assert is_nested("[[]]") == True
+assert is_nested("[]]]]]]][[[[[]") == False
+assert is_nested("[][]") == False
+assert is_nested("[]") == False
+assert is_nested("[[][]]") == True
+assert is_nested("[[]][[") == True
+assert is_nested("") == False
+assert is_nested("[[") == False
+assert is_nested("]]][[]]") == True
