+                .Stmts))
+            .Stmts)
+          Return(Compare(Name("state"), CmpOp("==", Int(4))))
+          .Stmts,
+          0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bracketInput(CS)
+    ensures ?RESULT ==Bool nestedResult(CS)
+endmodule
