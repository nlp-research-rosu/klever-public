+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop]:
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("bracket"),
+        If(Compare(Name("state"), CmpOp("<", Int(2))),
+          If(Compare(Name("bracket"), CmpOp("==", Str("["))),
+            AugAssign(Name("state"), "+", Int(1)),
+            .Stmts),
+          If(Compare(Name("state"), CmpOp("<", Int(4))),
+            If(Compare(Name("bracket"), CmpOp("==", Str("]"))),
+              AugAssign(Name("state"), "+", Int(1)),
+              .Stmts),
+            .Stmts))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |-> scope(
+        "state"   |-> (S:Int => nestedScan(CS, S))
+        "bracket" |-> (_BR:Val => ?BR:Val)
+        "string"  |-> str(INPUT:IntSeq),
+        parent(0))
+      ...
+    </scopes>
+    requires bracketInput(CS)
+      andBool S >=Int 0
+      andBool S <=Int 4
+
+  claim [program]:
+    <k>
+      #loadAll(Module(
+        FuncDef("is_nested", Params("string"),
+          Assign(Name("state"), Int(0))
+          Assign(Name("bracket"), Str(""))
+          For(Name("bracket"), Name("string"),
+            If(Compare(Name("state"), CmpOp("<", Int(2))),
+              If(Compare(Name("bracket"), CmpOp("==", Str("["))),
+                AugAssign(Name("state"), "+", Int(1)),
+                .Stmts),
+              If(Compare(Name("state"), CmpOp("<", Int(4))),
+                If(Compare(Name("bracket"), CmpOp("==", Str("]"))),
+                  AugAssign(Name("state"), "+", Int(1)),
+                  .Stmts),
+                .Stmts))
+            .Stmts)
+          Return(Compare(Name("state"), CmpOp("==", Int(4))))
+          .Stmts)
+        .Stmts))
+      ~> Call(Name("is_nested"), str(CS:IntSeq))
+      => ?RESULT:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        =>
+        "is_nested" |-> closureVal(
+          "string", .ParamNames,
+          Assign(Name("state"), Int(0))
+          Assign(Name("bracket"), Str(""))
+          For(Name("bracket"), Name("string"),
+            If(Compare(Name("state"), CmpOp("<", Int(2))),
+              If(Compare(Name("bracket"), CmpOp("==", Str("["))),
+                AugAssign(Name("state"), "+", Int(1)),
+                .Stmts),
+              If(Compare(Name("state"), CmpOp("<", Int(4))),
+                If(Compare(Name("bracket"), CmpOp("==", Str("]"))),
+                  AugAssign(Name("state"), "+", Int(1)),
+                  .Stmts),
+                .Stmts))
+            .Stmts)
+          Return(Compare(Name("state"), CmpOp("==", Int(4))))
+          .Stmts,
+          0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bracketInput(CS)
+    ensures ?RESULT ==Bool nestedResult(CS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..54b032f85ec05f76a9324d1f8df9748d0bceb966
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // The next state of the four-state subsequence recognizer.
+  syntax Int ::= nestedStep(Int, Int) [function, total]
+  rule nestedStep(C, S) => S +Int 1
+    requires S <Int 2 andBool C ==Int 91
+  rule nestedStep(C, S) => S
+    requires S <Int 2 andBool C =/=Int 91
+  rule nestedStep(C, S) => S +Int 1
+    requires S >=Int 2 andBool S <Int 4 andBool C ==Int 93
+  rule nestedStep(C, S) => S
+    requires S >=Int 2 andBool S <Int 4 andBool C =/=Int 93
+  rule nestedStep(_C, S) => S
+    requires S >=Int 4
+
+  // Scan a code sequence starting in state S.
+  syntax Int ::= nestedScan(IntSeq, Int) [function, total]
+  rule nestedScan(.IntSeq, S) => S
+  rule nestedScan(iCons(C, CS), S) =>
+    nestedScan(CS, nestedStep(C, S))
+
+  // The prompt's stated input domain: strings containing only square brackets.
+  syntax Bool ::= bracketInput(IntSeq) [function, total]
+  rule bracketInput(.IntSeq) => true
+  rule bracketInput(iCons(C, CS)) =>
+    (C ==Int 91 orBool C ==Int 93) andBool bracketInput(CS)
+
+  // A completed state 4 means that [ [ ] ] occurred in order as a subsequence.
+  syntax Bool ::= nestedResult(IntSeq) [function, total]
+  rule nestedResult(CS) => nestedScan(CS, 0) ==Int 4
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.program --depth 70' in /workspace
exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.program --depth 90' in /workspace
