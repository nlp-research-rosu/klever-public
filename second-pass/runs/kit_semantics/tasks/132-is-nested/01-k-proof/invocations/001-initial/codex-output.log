+    requires bracketInput(CS)
+      andBool S >=Int 0
+      andBool S <=Int 4
+
+  claim [program]:
+    <k>
+      #loadAll(Module(
+        FuncDef("is_nested", Params("string"),
+          Assign(Name("state"), Int(0))
+          Assign(Name("bracket"), Str(""))
+          For(Name("bracket"), Name("string"),
+            If(Compare(Name("state"), CmpOp("<", Int(2))),
