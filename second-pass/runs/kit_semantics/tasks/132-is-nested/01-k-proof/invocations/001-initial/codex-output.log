diff --git a/validation.py b/validation.py
new file mode 100644
index 0000000000000000000000000000000000000000..b6d59ba9334836f35b3fc7a0722037f791de74e4
--- /dev/null
+++ b/validation.py
@@ -0,0 +1,41 @@
+import ast
+import itertools
+
+from solution import is_nested
+
+
+def brute_force_oracle(value):
+    target = "[[]]"
+    for positions in itertools.combinations(range(len(value)), 4):
+        candidate = "".join(value[position] for position in positions)
+        if candidate == target:
+            return True
+    return False
+
+
+def implementation_body(path):
+    with open(path, encoding="utf-8") as source_file:
+        module = ast.parse(source_file.read(), filename=path)
+    return ast.dump(module.body[0], include_attributes=False)
+
+
+assert implementation_body("solution.py") == implementation_body("concrete_tests.py")
+
+checked = 0
+mismatches = []
+for size in range(13):
+    for characters in itertools.product("[]", repeat=size):
+        value = "".join(characters)
+        expected = brute_force_oracle(value)
+        actual = is_nested(value)
+        checked += 1
+        if actual != expected:
+            mismatches.append((value, actual, expected))
+
+print("oracle=brute-force four-index subsequence search")
+print("domain=all square-bracket strings of lengths 0..12")
+print("checked=" + str(checked))
+print("mismatches=" + str(len(mismatches)))
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..54b032f85ec05f76a9324d1f8df9748d0bceb966
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // The next state of the four-state subsequence recognizer.
+  syntax Int ::= nestedStep(Int, Int) [function, total]
+  rule nestedStep(C, S) => S +Int 1
+    requires S <Int 2 andBool C ==Int 91
+  rule nestedStep(C, S) => S
+    requires S <Int 2 andBool C =/=Int 91
+  rule nestedStep(C, S) => S +Int 1
+    requires S >=Int 2 andBool S <Int 4 andBool C ==Int 93
+  rule nestedStep(C, S) => S
+    requires S >=Int 2 andBool S <Int 4 andBool C =/=Int 93
+  rule nestedStep(_C, S) => S
+    requires S >=Int 4
+
+  // Scan a code sequence starting in state S.
+  syntax Int ::= nestedScan(IntSeq, Int) [function, total]
+  rule nestedScan(.IntSeq, S) => S
+  rule nestedScan(iCons(C, CS), S) =>
+    nestedScan(CS, nestedStep(C, S))
+
+  // The prompt's stated input domain: strings containing only square brackets.
+  syntax Bool ::= bracketInput(IntSeq) [function, total]
+  rule bracketInput(.IntSeq) => true
+  rule bracketInput(iCons(C, CS)) =>
+    (C ==Int 91 orBool C ==Int 93) andBool bracketInput(CS)
+
+  // A completed state 4 means that [ [ ] ] occurred in order as a subsequence.
+  syntax Bool ::= nestedResult(IntSeq) [function, total]
+  rule nestedResult(CS) => nestedScan(CS, 0) ==Int 4
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..a7ba663de8105e14ca97a4182a9c17c6256d984d
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,22 @@
+def is_nested(string):
+    state = 0
+    bracket = ""
+    for bracket in string:
+        if state < 2:
+            if bracket == "[":
+                state += 1
+        elif state < 4:
+            if bracket == "]":
+                state += 1
+    return state == 4
+
+
+assert is_nested("[[]]") == True
+assert is_nested("[]]]]]]][[[[[]") == False
+assert is_nested("[][]") == False
+assert is_nested("[]") == False
+assert is_nested("[[][]]") == True
+assert is_nested("[[]][[") == True
+assert is_nested("") == False
+assert is_nested("[[") == False
+assert is_nested("]]][[]]") == True
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c4a9b414069011e6870c6f65867f30b4ad085277
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -eu
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+krun concrete_tests.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+python3 validation.py
+
+if kprove spec-vacuity.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY
+then
+  echo "ERROR: false-result mutation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-result mutation was rejected"
+fi
+
+if kprove spec-body-mutation.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-BODY-MUTATION
+then
+  echo "ERROR: body mutation unexpectedly proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: body mutation was rejected"
+fi
