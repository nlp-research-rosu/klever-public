diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2b30ad62a31954c1b5552932b4529e5df4737da2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def is_nested(string):
+    state = 0
+    bracket = ""
+    for bracket in string:
+        if state < 2:
+            if bracket == "[":
+                state += 1
+        elif state < 4:
+            if bracket == "]":
+                state += 1
+    return state == 4
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..2d3ca7e148339be5ae1376ca63281f0697e51a3e
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberate mutation: state starts at 4, so the empty string returns true.
+  // The original theorem's expected result for the empty string is false.
+  claim [mutated-body]:
+    <k>
+      Call(Name("is_nested"), str(.IntSeq))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "is_nested" |-> closureVal(
+          "string", .ParamNames,
+          Assign(Name("state"), Int(4))
+          Assign(Name("bracket"), Str(""))
+          For(Name("bracket"), Name("string"),
+            If(Compare(Name("state"), CmpOp("<", Int(2))),
+              If(Compare(Name("bracket"), CmpOp("==", Str("["))),
+                AugAssign(Name("state"), "+", Int(1)),
+                .Stmts),
+              If(Compare(Name("state"), CmpOp("<", Int(4))),
+                If(Compare(Name("bracket"), CmpOp("==", Str("]"))),
+                  AugAssign(Name("state"), "+", Int(1)),
+                  .Stmts),
+                .Stmts))
+            .Stmts)
+          Return(Compare(Name("state"), CmpOp("==", Int(4))))
+          .Stmts,
+          0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
