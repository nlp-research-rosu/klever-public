{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "VERIFICATION",
      "normalized_sha256": "d3f0b3b96e611b41d2e8c331de464a83b4e68e55a3a9ef80c85072283e3a52e6",
      "rationale": "This guarded nestedStep equation defines the DFA transition that increments an early state when the input code is 91 ('[').",
      "source_rule_id": "rule-d3f0b3b96e611b41d2e8c331de464a83b4e68e55a3a9ef80c85072283e3a52e6",
      "start_line": 10,
      "text": "  rule nestedStep(C, S) => S +Int 1\n    requires S <Int 2 andBool C ==Int 91"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "5235cdc16e73a4af8cde1dbf5b49f86ee7f418aed9aca6ae1e221671c623b08b",
      "rationale": "This guarded nestedStep equation defines the complementary early-state case, leaving the state unchanged when the code is not 91.",
      "source_rule_id": "rule-5235cdc16e73a4af8cde1dbf5b49f86ee7f418aed9aca6ae1e221671c623b08b",
      "start_line": 12,
      "text": "  rule nestedStep(C, S) => S\n    requires S <Int 2 andBool C =/=Int 91"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "2632b098e390f757cdbc95d8a688555d956e3ba1ea0c29d982f03ab021c4c38a",
      "rationale": "This guarded nestedStep equation defines the middle DFA transition that increments states 2 or 3 when the input code is 93 (']').",
      "source_rule_id": "rule-2632b098e390f757cdbc95d8a688555d956e3ba1ea0c29d982f03ab021c4c38a",
      "start_line": 14,
      "text": "  rule nestedStep(C, S) => S +Int 1\n    requires S >=Int 2 andBool S <Int 4 andBool C ==Int 93"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "20a7c7c6a34063a9caf1231ef507ed100c405cf13773a8407bb758e23da8a956",
      "rationale": "This guarded nestedStep equation defines the complementary middle-state case, leaving states 2 or 3 unchanged when the code is not 93.",
      "source_rule_id": "rule-20a7c7c6a34063a9caf1231ef507ed100c405cf13773a8407bb758e23da8a956",
      "start_line": 16,
      "text": "  rule nestedStep(C, S) => S\n    requires S >=Int 2 andBool S <Int 4 andBool C =/=Int 93"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "97fd5a94cf85ea0ea85838319221cb4b69e04384d7611ccab77c11e40b315cdd",
      "rationale": "This nestedStep equation defines every state at or above 4 as absorbing, completing the transition function's state partition.",
      "source_rule_id": "rule-97fd5a94cf85ea0ea85838319221cb4b69e04384d7611ccab77c11e40b315cdd",
      "start_line": 18,
      "text": "  rule nestedStep(_C, S) => S\n    requires S >=Int 4"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "93dce5c554493a3aaf098de0b0f849282a9eeabdbd187be97413f28507e3f9f9",
      "rationale": "This is the base equation for the structurally recursive nestedScan summary: scanning an empty IntSeq returns the current state.",
      "source_rule_id": "rule-93dce5c554493a3aaf098de0b0f849282a9eeabdbd187be97413f28507e3f9f9",
      "start_line": 23,
      "text": "  rule nestedScan(.IntSeq, S) => S"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "51cb2a9f32f1e0f28c99c7bb9ba96fa06a420bfc0ff59247b5dfae9db1d39768",
      "rationale": "This is the recursive nestedScan equation, consuming one IntSeq constructor and continuing with the state defined by nestedStep.",
      "source_rule_id": "rule-51cb2a9f32f1e0f28c99c7bb9ba96fa06a420bfc0ff59247b5dfae9db1d39768",
      "start_line": 24,
      "text": "  rule nestedScan(iCons(C, CS), S) =>\n    nestedScan(CS, nestedStep(C, S))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "86c81c4e83f334a250f0f7cd6a3d696ef3dd176482dc7252a0d002fb835aa66c",
      "rationale": "This is the base equation defining the empty code sequence as belonging to the bracket-only input domain.",
      "source_rule_id": "rule-86c81c4e83f334a250f0f7cd6a3d696ef3dd176482dc7252a0d002fb835aa66c",
      "start_line": 29,
      "text": "  rule bracketInput(.IntSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "ae46ad4c111fd8416f3da10532e15c6d50824884fc7bba26f2ddee8a60b4c781",
      "rationale": "This structurally recursive equation defines bracketInput for a nonempty sequence by checking the head code and recursively checking the tail.",
      "source_rule_id": "rule-ae46ad4c111fd8416f3da10532e15c6d50824884fc7bba26f2ddee8a60b4c781",
      "start_line": 30,
      "text": "  rule bracketInput(iCons(C, CS)) =>\n    (C ==Int 91 orBool C ==Int 93) andBool bracketInput(CS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "b4ad6b97ec2791a39b26f63843ed3879c0a6a47ab5790df412ba95eca8a70c12",
      "rationale": "This equation defines the named Boolean proof result as whether nestedScan from initial state 0 finishes in state 4.",
      "source_rule_id": "rule-b4ad6b97ec2791a39b26f63843ed3879c0a6a47ab5790df412ba95eca8a70c12",
      "start_line": 35,
      "text": "  rule nestedResult(CS) => nestedScan(CS, 0) ==Int 4"
    }
  ],
