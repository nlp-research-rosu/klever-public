     1	def largest_divisor(n: int) -> int:
     2	    divisor = n - 1
     3	    while n % divisor != 0:
     4	        divisor = divisor - 1
     5	    return divisor
     1	Module(
     2	  FuncDef("largest_divisor", Params("n"),
     3	    Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
     4	    While(Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
     5	      Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
     6	    Return(Name("divisor"))))
