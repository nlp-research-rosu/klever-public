COMMAND: bash -lc $'rg -n "b377a4d6|0e653377|0e6dba9d|generator_image|generation_producer|generator-manifest|source-manifest" /audit-input.json /reference/klean-generation/generator-manifest.json /reference/generation-tools/source-manifest.json; python3 - <<"PY"\nimport hashlib, json\nfrom pathlib import Path\npaths = [Path("/reference/generation-tools/klean.py"), Path("/reference/generation-tools/klean_export.py")]\nsource = json.loads(Path("/reference/generation-tools/source-manifest.json").read_text())\ngenerator = json.loads(Path("/reference/klean-generation/generator-manifest.json").read_text())\naudit = json.loads(Path("/audit-input.json").read_text())\nfor path in paths:\n    digest = hashlib.sha256(path.read_bytes()).hexdigest()\n    source_digest = source["files"][path.name]\n    generator_key = "klean_py_sha256" if path.name == "klean.py" else "exporter_sha256"\n    generator_digest = generator[generator_key]\n    print(path.name, digest, source_digest, generator_digest, digest == source_digest == generator_digest)\nsource_image = source["generator_image_id"]\ngenerator_image = generator["provenance"]["generator_image_id"]\naudit_source_dir = Path(audit["resolution"]["generation_producer_sources"]).name\nprint("source image:", source_image)\nprint("generator image:", generator_image)\nprint("audit producer basename:", audit_source_dir)\nprint("image IDs agree:", source_image == generator_image == "sha256:" + audit_source_dir)\nprint("audit producer set hash:", audit["resolution"]["hashes"]["generation_producer_sources_sha256"])\nPY'
