COMMAND: python3 -c $'def summary(n,d):\n steps=0\n while True:\n  if d>=1 and n%d==0: return d,steps\n  if d>1 and n%d!=0: d-=1; steps+=1; continue\n  raise RuntimeError((n,d))\ndef brute(n): return max(d for d in range(1,n) if n%d==0)\nw=[(2,1),(3,2),(4,3),(15,14),(25,24),(49,48),(97,96),(360,359)]\nfor n,d in w: print("witness",n,d,"summary",summary(n,d),"brute",brute(n))\nm=[]\nfor n in range(2,1001):\n got,_=summary(n,n-1); want=brute(n)\n if got!=want: m.append((n,got,want))\nprint("tested_n",999,"mismatch_count",len(m),"mismatches",m[:10])\nprint("base_recur_overlap",[(n,d) for n in range(2,30) for d in range(1,n) if d>=1 and n%d==0 and d>1 and n%d!=0])\nprint("coverage_gaps",[(n,d) for n in range(2,30) for d in range(1,n) if not ((d>=1 and n%d==0) or (d>1 and n%d!=0))])\nprint("counterfactual_skip_mismatches",sum(1 for n in range(2,101) if (lambda d: d-1 if d>1 and n%d!=0 else d)(n-1)!=brute(n)))\nprint("counterfactual_constant_one_mismatches",sum(1 for n in range(2,101) if 1!=brute(n)))'
