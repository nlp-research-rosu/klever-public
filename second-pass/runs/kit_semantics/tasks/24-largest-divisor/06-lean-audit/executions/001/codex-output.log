@@ -0,0 +1,371 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import (
+    k_rule_inventory,
+    klean_export,
+    lemma_discovery_contract,
+    pipeline_contract,
+    stage6_resolution_contract,
+)
