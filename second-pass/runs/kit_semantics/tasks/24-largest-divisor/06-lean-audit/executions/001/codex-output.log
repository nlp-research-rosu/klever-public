+#!/usr/bin/env bash
+set -o errexit
+set -o nounset
+set -o pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG_NAME COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}"
