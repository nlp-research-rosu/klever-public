diff --git a//tmp/audit-work/apptrace.c b//tmp/audit-work/apptrace.c
new file mode 100644
index 0000000000000000000000000000000000000000..dde4aa1f7bedca6961dbeee18ea6f3e6a34f60f2
--- /dev/null
+++ b//tmp/audit-work/apptrace.c
@@ -0,0 +1,63 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  errno = 0;
+  ssize_t result = real_readlink(path, buf, size);
+  int saved = errno;
+  fprintf(stderr, "APPTRACE readlink(%s) = %zd errno=%d value=%.*s\n",
+          path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (!real_readlinkat) {
+    real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  }
+  errno = 0;
+  ssize_t result = real_readlinkat(dirfd, path, buf, size);
+  int saved = errno;
+  fprintf(stderr, "APPTRACE readlinkat(%d,%s) = %zd errno=%d value=%.*s\n",
+          dirfd, path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+char *getcwd(char *buf, size_t size) {
+  static char *(*real_getcwd)(char *, size_t);
+  if (!real_getcwd) {
+    real_getcwd = dlsym(RTLD_NEXT, "getcwd");
+  }
+  errno = 0;
+  char *result = real_getcwd(buf, size);
+  int saved = errno;
+  fprintf(stderr, "APPTRACE getcwd = %s errno=%d\n",
+          result ? result : "(null)", saved);
+  errno = saved;
+  return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+  static char *(*real_realpath)(const char *, char *);
+  if (!real_realpath) {
+    real_realpath = dlsym(RTLD_NEXT, "realpath");
+  }
+  errno = 0;
+  char *result = real_realpath(path, resolved);
+  int saved = errno;
+  fprintf(stderr, "APPTRACE realpath(%s) = %s errno=%d\n",
+          path, result ? result : "(null)", saved);
+  errno = saved;
+  return result;
+}
diff --git a//tmp/audit-work/lean_proc_self.c b//tmp/audit-work/lean_proc_self.c
new file mode 100644
index 0000000000000000000000000000000000000000..7627726bede18b0df74df7860a74e427a8c4fe1f
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+static const char *normalized_proc_exe(const char *path) {
+  if (path != NULL &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + strlen(path) - 4, "/exe") == 0) {
+    return "/proc/self/exe";
+  }
+  return path;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  return real_readlink(normalized_proc_exe(path), buf, size);
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (!real_readlinkat) {
+    real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  }
+  return real_readlinkat(dirfd, normalized_proc_exe(path), buf, size);
+}
