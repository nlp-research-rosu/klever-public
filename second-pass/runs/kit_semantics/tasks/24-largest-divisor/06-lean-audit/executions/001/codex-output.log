@@ -0,0 +1,63 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  errno = 0;
+  ssize_t result = real_readlink(path, buf, size);
+  int saved = errno;
+  fprintf(stderr, "APPTRACE readlink(%s) = %zd errno=%d value=%.*s\n",
+          path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (!real_readlinkat) {
+    real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  }
+  errno = 0;
+  ssize_t result = real_readlinkat(dirfd, path, buf, size);
+  int saved = errno;
+  fprintf(stderr, "APPTRACE readlinkat(%d,%s) = %zd errno=%d value=%.*s\n",
+          dirfd, path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+char *getcwd(char *buf, size_t size) {
+  static char *(*real_getcwd)(char *, size_t);
+  if (!real_getcwd) {
+    real_getcwd = dlsym(RTLD_NEXT, "getcwd");
+  }
+  errno = 0;
+  char *result = real_getcwd(buf, size);
+  int saved = errno;
+  fprintf(stderr, "APPTRACE getcwd = %s errno=%d\n",
+          result ? result : "(null)", saved);
+  errno = saved;
+  return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+  static char *(*real_realpath)(const char *, char *);
+  if (!real_realpath) {
+    real_realpath = dlsym(RTLD_NEXT, "realpath");
+  }
+  errno = 0;
+  char *result = real_realpath(path, resolved);
+  int saved = errno;
+  fprintf(stderr, "APPTRACE realpath(%s) = %s errno=%d\n",
+          path, result ? result : "(null)", saved);
+  errno = saved;
+  return result;
+}
