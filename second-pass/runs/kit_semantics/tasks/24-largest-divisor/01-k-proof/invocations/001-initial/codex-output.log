+                BinOp("-", Name("divisor"), Int(1))) .Stmts)
+            Return(Name("divisor")) .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8f9e3db0a2b180fbdc88db7ff06c23e7fa421ba1
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,18 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical specification of the first divisor encountered while
+  // searching downward from D.  The proof only uses it for N >= 2 and D >= 1.
+  syntax Int ::= largestDivisorAtOrBelow(Int, Int) [function]
+
+  rule largestDivisorAtOrBelow(N, D) => D
+    requires D >=Int 1
+     andBool pyMod(N, D) ==Int 0
+
+  rule largestDivisorAtOrBelow(N, D)
+    => largestDivisorAtOrBelow(N, D -Int 1)
+    requires D >Int 1
+     andBool pyMod(N, D) =/=Int 0
+endmodule

