index 0000000000000000000000000000000000000000..49d5d67fd674feb08398dc280c2cc1cb8a41a92b
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,11 @@
+def largest_divisor(n: int) -> int:
+    divisor = n - 1
+    while n % divisor != 0:
+        divisor = divisor - 1
+    return divisor
+
+
+assert largest_divisor(15) == 5
+assert largest_divisor(7) == 1
+assert largest_divisor(100) == 50
+assert largest_divisor(2) == 1
