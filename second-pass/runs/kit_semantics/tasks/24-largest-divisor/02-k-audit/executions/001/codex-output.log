@@ -0,0 +1,67 @@
+requires "verification.k"
+
+module SPEC-CONCRETE-WITNESS
+  imports VERIFICATION
+
+  claim [entry-15]:
+    <k> Call(Name("largest_divisor"), Int(15)) => 5 </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "largest_divisor" |->
+          closureVal(
+            "n",
+            Assign(
+              Name("divisor"),
+              BinOp("-", Name("n"), Int(1)))
+            While(
+              Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("!=", Int(0))),
+              Assign(
+                Name("divisor"),
+                BinOp("-", Name("divisor"), Int(1))) .Stmts)
+            Return(Name("divisor")) .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [entry-2]:
+    <k> Call(Name("largest_divisor"), Int(2)) => 1 </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "largest_divisor" |->
+          closureVal(
+            "n",
+            Assign(
+              Name("divisor"),
+              BinOp("-", Name("n"), Int(1)))
+            While(
+              Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("!=", Int(0))),
+              Assign(
+                Name("divisor"),
+                BinOp("-", Name("divisor"), Int(1))) .Stmts)
+            Return(Name("divisor")) .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
