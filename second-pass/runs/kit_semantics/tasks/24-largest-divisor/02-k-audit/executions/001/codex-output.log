+
+  claim [entry-2]:
+    <k> Call(Name("largest_divisor"), Int(2)) => 1 </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "largest_divisor" |->
+          closureVal(
