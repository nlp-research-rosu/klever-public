new file mode 100644
index 0000000000000000000000000000000000000000..7c33dab0cc8c462d640a389151e45909545cb81c
--- /dev/null
+++ b/evidence/spec-audit-false.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-AUDIT-FALSE
+  imports VERIFICATION
+
+  // Fresh reviewer mutation. The precondition witness n=49 is valid, but the
