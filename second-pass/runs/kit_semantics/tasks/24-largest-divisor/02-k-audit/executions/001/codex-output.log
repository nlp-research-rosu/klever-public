+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  run_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$run_status"
+  exit "$run_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"

