COMMAND: bash -lc for\ audit_path\ in\ /audit-input.json\ /audit-campaign-lock.json\ /run.json\ /task.json\ /generation-result.json\ /candidate\ /reference\ /generation-evidence\;\ do\ if\ test\ -e\ \"\$audit_path\"\ \|\|\ test\ -L\ \"\$audit_path\"\;\ then\ stat\ -c\ \"%F\ %A\ %U:%G\ %s\ %N\"\ \"\$audit_path\"\;\ else\ echo\ \"MISSING\ \$audit_path\"\;\ fi\;\ done\;\ find\ /candidate\ /reference\ /generation-evidence\ -printf\ \"%y\ %p\ -\>\ %l\\n\"\ 2\>\&1\ \|\ sort
