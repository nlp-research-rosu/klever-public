FILE /reference/reference-semantics/semantics/assert.k module=MPY-ASSERT rule=3
  RULE 6-7 attrs=- :: rule <k> Assert(V:Val) => .K ... </k> requires truthy(V)
  RULE 8-12 attrs=- :: rule <k> Assert(V:Val) ~> _ => .K </k> <exc> NoExc => AssertionError </exc> <exit-code> _ => 1 </exit-code> requires notBool truthy(V)
  RULE 13-15 attrs=priority(40) :: rule <k> Assert(ref(H:Int)) => Assert(V) ... </k> <heap> ... H |-> V:Val ... </heap> [priority(40)]
