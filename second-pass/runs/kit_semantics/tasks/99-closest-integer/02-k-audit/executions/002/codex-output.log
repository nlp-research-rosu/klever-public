+requires "verification.k"
+
+module AUDITOR-FALSE-SPEC
+  imports VERIFICATION
+
+  // Fresh audit mutation: the real positive-near branch returns floor(F), but
+  // this destination falsely requires floor(F) + 1.  A concrete satisfying
+  // witness is "15.3": the real result is 15 and this mutation demands 16.
+  claim [false-positive-lower-off-by-one]:
+    <k>
+      Call(Name("closest_integer"), str(CS:IntSeq))
+      =>
+      floorFI(decStrToF(CS)) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "closest_integer" |-> closureVal(
+          "value",
+          Assign(Name("number"), Call(Name("float"), Name("value")))
+          Assign(
+            Name("lower"),
+            Call(Attribute(Name("math"), "floor"), Name("number"))
+          )
+          Assign(
+            Name("upper"),
+            Call(Attribute(Name("math"), "ceil"), Name("number"))
+          )
+          If(
+            Compare(Name("number"), CmpOp(">", Int(0))),
+            If(
+              Compare(
+                BinOp("-", Name("number"), Name("lower")),
+                CmpOp("<", Float(0.5))
+              ),
+              Return(Name("lower")),
+              .Stmts
+            )
+            Return(Name("upper")),
+            .Stmts
+          )
+          If(
+            Compare(
+              BinOp("-", Name("upper"), Name("number")),
+              CmpOp("<", Float(0.5))
+            ),
+            Return(Name("upper")),
+            .Stmts
+          )
+          Return(Name("lower")),
+          0
+        ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires ltIF(0, decStrToF(CS))
+     andBool floatLt(
+       subF(
+         decStrToF(CS),
+         intToF(floorFI(decStrToF(CS)))
+       ),
+       0.5
+     )
+endmodule

diff --git a//tmp/audit-work/auditor_concrete_probe.py b//tmp/audit-work/auditor_concrete_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..2ca6a639e98d56fb5fd214d6799247560567065a
--- /dev/null
+++ b//tmp/audit-work/auditor_concrete_probe.py
@@ -0,0 +1,31 @@
+import math
+
+
+def closest_integer(value):
+    number = float(value)
+    lower = math.floor(number)
+    upper = math.ceil(number)
+    if number > 0:
+        if number - lower < 0.5:
+            return lower
+        return upper
+    if upper - number < 0.5:
+        return upper
+    return lower
+
+
+assert closest_integer("10") == 10
+assert closest_integer("15.3") == 15
+assert closest_integer("14.5") == 15
+assert closest_integer("-14.5") == -15
+assert closest_integer("0") == 0
+assert closest_integer("0.49") == 0
+assert closest_integer("0.5") == 1
+assert closest_integer("0.51") == 1
+assert closest_integer("-0.49") == 0
+assert closest_integer("-0.5") == -1
+assert closest_integer("-0.51") == -1
+assert closest_integer("2.499999") == 2
+assert closest_integer("2.500001") == 3
+assert closest_integer("-2.499999") == -2
+assert closest_integer("-2.500001") == -3
