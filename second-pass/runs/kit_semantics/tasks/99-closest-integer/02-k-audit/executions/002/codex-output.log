    12	  // the builtins REGISTRY is core.k's builtinsScope (the -1 frame); names resolve by lookup
    13	
    14	  // Call routing + argument evaluation live in call.k, which also routes the fold
    15	  // builtins (sum/all/any/max/min) to the #_Acc folds below and everything else to
    16	  // applyBuiltin. This module owns applyBuiltin + the fold implementations.
    17	  syntax Val ::= applyBuiltin(String, Vals) [function]
    18	
    19	  // ==== len(obj) — O(1) per kind ============================================
    20	  syntax Int ::= seqLen(Val) [function]
    21	  rule applyBuiltin("len", OBJ:Val, .Vals) => seqLen(OBJ)
    22	  rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
    23	  rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
    24	  rule seqLen(str(IS:IntSeq))                   => isLen(IS)
    25	  rule seqLen(setV(DS:IntSeq))                  => isLen(DS)
    26	  rule seqLen(rangeObj(LO:Int, HI:Int, ST:Int)) => rangeLen(LO, HI, ST)
    27	
    28	  // ==== list(seq) — materialize a list/tuple into a list (e.g. list(d.keys())) ==
    29	  // Minimal: the "copy a sequence" case (list of a list is itself; list of a tuple keeps order).
    30	  // list() of other iterables (str/range/set/zip) is added via the iterator fold when needed.
    31	  // (k-cell — list() constructs a NEW object)
    32	  rule <k> #applyK(toCall(builtinV("list")), (list(VS:ValSeq),  .Vals)) => #alloc(list(VS)) ... </k>
    33	  rule <k> #applyK(toCall(builtinV("list")), (tuple(VS:ValSeq), .Vals)) => #alloc(list(VS)) ... </k>
    34	  rule <k> #applyK(toCall(builtinV("list")), .Vals)                     => #alloc(list(.ValSeq)) ... </k>
    35	  rule <k> #applyK(toCall(builtinV("list")), (str(CS:IntSeq), .Vals))   => #alloc(list(charsOf(CS))) ... </k>
    36	  syntax ValSeq ::= charsOf(IntSeq) [function, total]
    37	  rule charsOf(.IntSeq)                => .ValSeq
    38	  rule charsOf(iCons(C:Int, R:IntSeq)) => vCons(str(iCons(C, .IntSeq)), charsOf(R))
    39	
    40	  // ==== set(str) — distinct character codes =================================
    41	  rule applyBuiltin("set", str(CS:IntSeq), .Vals) => setV(dedupCodes(CS))
    42	
    43	  // ==== abs(int) ============================================================
    44	  rule applyBuiltin("abs", I:Int, .Vals) => absInt(I)
    45	
    46	  // ==== sum(iterable) — one #iterNext fold; intOf = int value of an int/bool ==
    47	  syntax KItem ::= #sumAcc(Iterable, Int) | #sumCont(Int)
    48	  rule <k> #sumAcc(IT:Iterable, ACC:Int) => #iterNext(IT) ~> #sumCont(ACC) ... </k>
    49	  rule <k> #iterDone ~> #sumCont(ACC:Int) => ACC ... </k>
    50	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
    51	        => #sumAcc(R, ACC +Int intOf(V)) ... </k>
    52	       requires isInt(V) orBool isBool(V)
    53	
    54	  syntax Int ::= intOf(Val) [function]
    55	  rule intOf(I:Int)  => I
    56	  rule intOf(B:Bool) => #if B #then 1 #else 0 #fi
    57	
    58	  // ==== all / any (short-circuiting #iterNext folds) ========================
    59	  syntax KItem ::= #allAcc(Iterable) | "#allCont"
    60	  rule <k> #allAcc(IT:Iterable) => #iterNext(IT) ~> #allCont ... </k>
    61	  rule <k> #iterDone ~> #allCont => true ... </k>
    62	  rule <k> #iterYield(V:Val, R:Iterable) ~> #allCont => #allAcc(R) ... </k>
    63	       requires truthy(V)
    64	  rule <k> #iterYield(V:Val, _:Iterable) ~> #allCont => false ... </k>
    65	       requires notBool truthy(V)
    66	
    67	  syntax KItem ::= #anyAcc(Iterable) | "#anyCont"
    68	  rule <k> #anyAcc(IT:Iterable) => #iterNext(IT) ~> #anyCont ... </k>
    69	  rule <k> #iterDone ~> #anyCont => false ... </k>
    70	  rule <k> #iterYield(V:Val, _:Iterable) ~> #anyCont => true ... </k>
    71	       requires truthy(V)
    72	  rule <k> #iterYield(V:Val, R:Iterable) ~> #anyCont => #anyAcc(R) ... </k>
    73	       requires notBool truthy(V)
    74	
    75	  // ==== max / min over an iterable (#iterNext folds; first element seeds) ====
    76	  syntax KItem ::= #maxAcc0(Iterable) | "#maxCont0" | #maxAcc(Iterable, Int) | #maxCont(Int)
    77	  rule <k> #maxAcc0(IT:Iterable) => #iterNext(IT) ~> #maxCont0 ... </k>
    78	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAcc(R, {V}:>Int) ... </k>
    79	       requires isInt(V)
    80	  rule <k> #maxAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #maxCont(M) ... </k>
    81	  rule <k> #iterDone ~> #maxCont(M:Int) => M ... </k>
    82	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)
    83	        => #maxAcc(R, maxInt(M, {V}:>Int)) ... </k>
    84	       requires isInt(V)
    85	
    86	  syntax KItem ::= #minAcc0(Iterable) | "#minCont0" | #minAcc(Iterable, Int) | #minCont(Int)
    87	  rule <k> #minAcc0(IT:Iterable) => #iterNext(IT) ~> #minCont0 ... </k>
    88	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAcc(R, {V}:>Int) ... </k>
    89	       requires isInt(V)
    90	  rule <k> #minAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #minCont(M) ... </k>
    91	  rule <k> #iterDone ~> #minCont(M:Int) => M ... </k>
    92	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)
    93	        => #minAcc(R, minInt(M, {V}:>Int)) ... </k>
    94	       requires isInt(V)
    95	
    96	  // ---- general Val branch of the max/min folds (v3) ------------------------
    97	  // The Int fold above and the Float fold (float.k) cover homogeneous lists; the
    98	  // remaining CPython-orderable seeds (Bool, str) and every cross-sort step land
    99	  // here. Ordering reuses the semantics' OWN applyCmp dispatch (int.k; float.k's
   100	  // exact ltIF/ltFI bridges; bool.k's bool->int promotion; str.k's strLt), so
   101	  // mixed comparisons stay bit-exact with CPython; a pair applyCmp does not
   102	  // order (e.g. int vs str) leaves the fold stuck (unmodeled TypeError).
   103	  // Strict > (resp. <) replacement keeps the FIRST maximal (minimal) element —
   104	  // CPython's tie rule.
   105	  syntax KItem ::= #maxAccV(Iterable, Val) | #maxContV(Val)
   106	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccV(R, V) ... </k>
   107	       requires isBool(V) orBool isStr(V)
   108	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)
   109	        => #iterYield(V, R) ~> #maxContV(M) ... </k>
   110	       requires isFloat(V) orBool isBool(V)
   111	  rule <k> #maxAccV(IT:Iterable, M:Val) => #iterNext(IT) ~> #maxContV(M) ... </k>
   112	  rule <k> #iterDone ~> #maxContV(M:Val) => M ... </k>
   113	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContV(M:Val) => #maxAccV(R, V) ... </k>
   114	       requires applyCmp(">", V, M)
   115	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContV(M:Val) => #maxAccV(R, M) ... </k>
   116	       requires notBool applyCmp(">", V, M)
   117	
   118	  syntax KItem ::= #minAccV(Iterable, Val) | #minContV(Val)
   119	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccV(R, V) ... </k>
   120	       requires isBool(V) orBool isStr(V)
   121	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)
   122	        => #iterYield(V, R) ~> #minContV(M) ... </k>
   123	       requires isFloat(V) orBool isBool(V)
   124	  rule <k> #minAccV(IT:Iterable, M:Val) => #iterNext(IT) ~> #minContV(M) ... </k>
   125	  rule <k> #iterDone ~> #minContV(M:Val) => M ... </k>
   126	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContV(M:Val) => #minAccV(R, V) ... </k>
   127	       requires applyCmp("<", V, M)
   128	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContV(M:Val) => #minAccV(R, M) ... </k>
   129	       requires notBool applyCmp("<", V, M)
   130	
   131	  // ==== variadic max / min (a Vals fold) ====================================
   132	  // v3: Val operands (mixed int/float/bool, str) via the same applyCmp
   133	  // dispatch; strict > / < keeps the FIRST maximal/minimal operand (CPython's
   134	  // tie rule — and exactly the old maxInt/minInt fold on the all-Int domain).
   135	  syntax Val ::= maxVals(Val, Vals) [function]
   136	  rule applyBuiltin("max", I:Int, REST:Vals) => maxVals(I, REST)
   137	  rule applyBuiltin("max", V:Val, (V2:Val, REST:Vals)) => maxVals(V, (V2, REST))
   138	       requires isFloat(V) orBool isBool(V) orBool isStr(V)
   139	  rule maxVals(M:Val, .Vals)           => M
   140	  rule maxVals(M:Val, (V:Val, R:Vals)) => maxVals(V, R) requires applyCmp(">", V, M)
   141	  rule maxVals(M:Val, (V:Val, R:Vals)) => maxVals(M, R) requires notBool applyCmp(">", V, M)
   142	
   143	  syntax Val ::= minVals(Val, Vals) [function]
   144	  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
   145	  rule applyBuiltin("min", V:Val, (V2:Val, REST:Vals)) => minVals(V, (V2, REST))
   146	       requires isFloat(V) orBool isBool(V) orBool isStr(V)
   147	  rule minVals(M:Val, .Vals)           => M
   148	  rule minVals(M:Val, (V:Val, R:Vals)) => minVals(V, R) requires applyCmp("<", V, M)
   149	  rule minVals(M:Val, (V:Val, R:Vals)) => minVals(M, R) requires notBool applyCmp("<", V, M)
   150	
   151	  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
   152	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   153	       requires N >=Int 0
   154	  // negative operand: the '-' sign prefixes the magnitude's digits
   155	  rule applyBuiltin("bin", N:Int, .Vals)
   156	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   157	       requires N <Int 0
   158	  syntax IntSeq ::= binCodes(Int) [function, total]
   159	  rule binCodes(0) => iCons(48, .IntSeq)
   160	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   161	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   162	  rule binAcc(0, ACC:IntSeq) => ACC
   163	  rule binAcc(N:Int, ACC:IntSeq)
   164	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   165	       requires N >Int 0
   166	
   167	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   168	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   169	        => #alloc(list(enumVS(VS, 0))) ... </k>
   170	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   171	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   172	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   173	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   174	
   175	  // ==== map(str, xs) — eager (only the str case is in the subset) =============
   176	  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
   177	        => #alloc(list(mapStrVS(VS))) ... </k>
   178	  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
   179	  rule mapStrVS(.ValSeq) => .ValSeq
   180	  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
   181	  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
   182	
   183	  // ==== int(x) identities (int(round(x)) composes through) ====================
   184	  rule applyBuiltin("int", I:Int, .Vals) => I
   185	
   186	  // ==== ord / chr ===========================================================
   187	  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
   188	  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
   189	       requires 0 <=Int I andBool I <Int 128
   190	
   191	  // ==== str(int) / str(str) =================================================
   192	  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
   193	  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
   194	
   195	  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
   196	  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
   197	       requires 48 <=Int C andBool C <=Int 57
   198	
   199	  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
   200	  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
   201	       requires isLen(CS) >=Int 2
   202	  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
   203	  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
   204	  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
   205	
   206	  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
   207	  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
   208	  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
   209	
   210	  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
   211	  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
   212	        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
   213	  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
   214	  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
   215	  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
   216	        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
   217	  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
   218	  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>
   219	
   220	  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
   221	  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
   222	  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
   223	  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
   224	       requires S =/=Int 0
   225	
   226	  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
   227	  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
   228	  // trusted pass evaluator, now DEFINED in the reference and driven by a
   229	  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
   230	  // argument leaves the call unevaluated for problem-level folds.
   231	  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
   232	  syntax Int ::= evalArith(IntSeq) [function]
   233	  rule evalArith(CS:IntSeq)
   234	    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))
   235	
   236	  syntax OpSeq ::= ".OpSeq" | oCons(String, OpSeq)
   237	
   238	  syntax Bool ::= evDigit(Int) [function, total]
   239	  rule evDigit(C:Int) => C >=Int 48 andBool C <=Int 57
   240	  syntax Bool ::= evHead42(IntSeq) [function, total]
   241	  rule evHead42(iCons(42, _:IntSeq)) => true
   242	  rule evHead42(_:IntSeq)            => false [owise]
   243	  syntax Bool ::= evHead47(IntSeq) [function, total]
   244	  rule evHead47(iCons(47, _:IntSeq)) => true
   245	  rule evHead47(_:IntSeq)            => false [owise]
   246	
   247	  syntax OpSeq ::= tokOps(IntSeq) [function, total]
   248	  rule tokOps(.IntSeq)                 => .OpSeq
   249	  rule tokOps(iCons(32, R:IntSeq))     => tokOps(R)
   250	  rule tokOps(iCons(C:Int, R:IntSeq))  => tokOps(R) requires evDigit(C)
   251	  rule tokOps(iCons(42, iCons(42, R:IntSeq))) => oCons("**", tokOps(R))
   252	  rule tokOps(iCons(42, R:IntSeq))     => oCons("*", tokOps(R)) requires notBool evHead42(R)
   253	  rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons("//", tokOps(R))
   254	  rule tokOps(iCons(47, R:IntSeq))     => oCons("/", tokOps(R)) requires notBool evHead47(R)
   255	  rule tokOps(iCons(43, R:IntSeq))     => oCons("+", tokOps(R))
   256	  rule tokOps(iCons(45, R:IntSeq))     => oCons("-", tokOps(R))
   257	
   258	  syntax IntSeq ::= tokNds(IntSeq) [function, total]
   259	                  | tokNdAcc(Int, IntSeq) [function, total]
   260	  rule tokNds(.IntSeq)                => .IntSeq
   261	  rule tokNds(iCons(32, R:IntSeq))    => tokNds(R)
   262	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNdAcc(C -Int 48, R) requires evDigit(C)
   263	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNds(R)
   264	       requires notBool evDigit(C) andBool C =/=Int 32
   265	  rule tokNdAcc(A:Int, iCons(C:Int, R:IntSeq)) => tokNdAcc(A *Int 10 +Int (C -Int 48), R)
   266	       requires evDigit(C)
   267	  rule tokNdAcc(A:Int, S:IntSeq) => iCons(A, tokNds(S)) [owise]
   268	
   269	  syntax EvPair ::= evp(OpSeq, IntSeq)
   270	  syntax Int ::= firstNdE(EvPair) [function, total]
   271	  rule firstNdE(evp(_:OpSeq, iCons(N:Int, _:IntSeq))) => N
   272	  rule firstNdE(_:EvPair) => 0 [owise]
   273	
   274	  syntax Int ::= applyOpE(String, Int, Int) [function, total]
   275	  rule applyOpE("+",  A:Int, B:Int) => A +Int B
   276	  rule applyOpE("-",  A:Int, B:Int) => A -Int B
   277	  rule applyOpE("*",  A:Int, B:Int) => A *Int B
   278	  rule applyOpE("//", A:Int, B:Int) => A divInt B
   279	  rule applyOpE("**", A:Int, B:Int) => A ^Int B
   280	  rule applyOpE(_:String, A:Int, _:Int) => A [owise]
   281	
   282	  syntax EvPair ::= passPowE(OpSeq, IntSeq) [function, total]
   283	  rule passPowE(.OpSeq, NDS:IntSeq) => evp(.OpSeq, NDS)
   284	  rule passPowE(oCons("**", OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCombE(N, passPowE(OPS, NDS))
   285	  rule passPowE(oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCarryE(O, N, passPowE(OPS, NDS))
   286	       requires O =/=String "**"
   287	  rule passPowE(_:OpSeq, .IntSeq) => evp(.OpSeq, .IntSeq) [owise]
   288	  syntax EvPair ::= powCombE(Int, EvPair) [function, total]
   289	  rule powCombE(N:Int, evp(OPS:OpSeq, iCons(M:Int, REST:IntSeq))) => evp(OPS, iCons(N ^Int M, REST))
   290	  rule powCombE(N:Int, evp(OPS:OpSeq, .IntSeq)) => evp(OPS, iCons(N, .IntSeq))
   291	  syntax EvPair ::= powCarryE(String, Int, EvPair) [function, total]
   292	  rule powCarryE(O:String, N:Int, evp(OPS:OpSeq, NDS:IntSeq)) => evp(oCons(O, OPS), iCons(N, NDS))
   293	
   294	  syntax EvPair ::= passMulE(EvPair) [function, total] | passAddE(EvPair) [function, total]
   295	  rule passMulE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("mul", N0, OPS, NDS, .OpSeq, .IntSeq)
   296	  rule passMulE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   297	  rule passAddE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("add", N0, OPS, NDS, .OpSeq, .IntSeq)
   298	  rule passAddE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   299	  syntax EvPair ::= passLGoE(String, Int, OpSeq, IntSeq, OpSeq, IntSeq) [function, total]
   300	  rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))
   301	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   302	    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)
   303	       requires inLevelE(L, O)
   304	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   305	    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))
   306	       requires notBool inLevelE(L, O)
   307	  rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)
   308	    => evp(OO, appendIE(ON, CUR)) [owise]
   309	  syntax Bool ::= inLevelE(String, String) [function, total]
   310	  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
   311	  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
   312	  rule inLevelE(_:String, _:String) => false [owise]
   313	  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
   314	  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
   315	  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))
   316	  syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]
   317	  rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)
   318	  rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))
   319	
   320	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   321	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   322	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   323	  syntax KItem ::= "#md5"
   324	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   325	       [priority(40)]
   326	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   327	  syntax Val ::= md5Obj(IntSeq)
   328	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   329	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   330	
   331	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   332	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   333	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   334	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   335	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   336	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   337	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   338	  rule isIntV(_:Int)         => true
   339	  // bool is a subtype of int in Python: isinstance(True, int) is True
   340	  rule isIntV(_:Bool)        => true
   341	  rule isIntV(_:Val)         => false [owise]
   342	  rule isStrV(str(_:IntSeq)) => true
   343	  rule isStrV(_:Val)         => false [owise]
   344	endmodule

diff --git a//tmp/audit-work/auditor_concrete_probe.py b//tmp/audit-work/auditor_concrete_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..2ca6a639e98d56fb5fd214d6799247560567065a
--- /dev/null
+++ b//tmp/audit-work/auditor_concrete_probe.py
@@ -0,0 +1,31 @@
+import math
+
+
+def closest_integer(value):
+    number = float(value)
+    lower = math.floor(number)
+    upper = math.ceil(number)
+    if number > 0:
+        if number - lower < 0.5:
+            return lower
+        return upper
+    if upper - number < 0.5:
+        return upper
+    return lower
+
+
+assert closest_integer("10") == 10
+assert closest_integer("15.3") == 15
+assert closest_integer("14.5") == 15
+assert closest_integer("-14.5") == -15
+assert closest_integer("0") == 0
+assert closest_integer("0.49") == 0
+assert closest_integer("0.5") == 1
+assert closest_integer("0.51") == 1
+assert closest_integer("-0.49") == 0
+assert closest_integer("-0.5") == -1
+assert closest_integer("-0.51") == -1
+assert closest_integer("2.499999") == 2
+assert closest_integer("2.500001") == 3
+assert closest_integer("-2.499999") == -2
+assert closest_integer("-2.500001") == -3
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e68d528f6dadb00458c838b5b757923adb9a13ed
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 OUTPUT_PREFIX COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+output_prefix=$1
+shift
+
+printf '%q ' "$@" > "${output_prefix}.cmd"
+printf '\n' >> "${output_prefix}.cmd"
+
+started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
+printf 'started_utc=%s\n' "$started" > "${output_prefix}.meta"
+
+set +e
+"$@" > "${output_prefix}.log" 2>&1
+status=$?
+set -e
+
+finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
+printf '%s\n' "$status" > "${output_prefix}.status"
+printf 'finished_utc=%s\n' "$finished" >> "${output_prefix}.meta"
+
+sed -n '1,240p' "${output_prefix}.log"
+exit "$status"
diff --git a/evidence/stage1/check_integrity.py b/evidence/stage1/check_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..5d00667deb8e3a4341d2018e80d326f823cd766e
--- /dev/null
+++ b/evidence/stage1/check_integrity.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+import os
+import stat
+from pathlib import Path
+
+
+AUDIT = Path("/audit-input.json")
+LOCK = Path("/audit-campaign-lock.json")
+
+
+def sha256_file(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as inp:
+        for chunk in iter(lambda: inp.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def type_name(path: Path) -> str:
+    mode = path.lstat().st_mode
+    if stat.S_ISREG(mode):
+        return "regular"
+    if stat.S_ISDIR(mode):
+        return "directory"
+    if stat.S_ISLNK(mode):
+        return "symlink"
+    return f"other({mode:o})"
+
+
+def walk_entries(root: Path):
+    for parent, dirs, files in os.walk(root, followlinks=False):
+        dirs.sort()
+        files.sort()
+        for name in dirs + files:
+            p = Path(parent) / name
+            yield p.relative_to(root).as_posix(), p
+
+
+def compare_trees(left: Path, right: Path):
+    left_items = {rel: path for rel, path in walk_entries(left)}
+    right_items = {rel: path for rel, path in walk_entries(right)}
+    diffs = []
+    for rel in sorted(left_items.keys() | right_items.keys()):
+        lp = left_items.get(rel)
+        rp = right_items.get(rel)
+        if lp is None:
+            diffs.append((rel, "missing-left", None, type_name(rp)))
+            continue
+        if rp is None:
+            diffs.append((rel, "additional-left", type_name(lp), None))
+            continue
+        lt = type_name(lp)
+        rt = type_name(rp)
+        if lt != rt:
+            diffs.append((rel, "type", lt, rt))
+        elif lt == "regular":
+            lh = sha256_file(lp)
+            rh = sha256_file(rp)
+            if lh != rh:
+                diffs.append((rel, "content", lh, rh))
+        elif lt == "symlink":
+            diffs.append((rel, "symlink-forbidden", os.readlink(lp), os.readlink(rp)))
+    return diffs
+
+
+with AUDIT.open() as inp:
+    audit = json.load(inp)
+with LOCK.open() as inp:
+    lock = json.load(inp)
+
+print("record_layout", audit.get("record_layout"))
+print("semantics_mode", audit.get("semantics_mode"))
+print("campaign_object_equal", audit["audit_campaign"] == lock)
+print("lock_sha256", sha256_file(LOCK))
+print("lock_sha256_declared", audit["hashes"]["audit_campaign_lock_sha256"])
+print("lock_hash_match", sha256_file(LOCK) == audit["hashes"]["audit_campaign_lock_sha256"])
+
+required = [
+    Path("/audit-input.json"),
+    Path("/audit-campaign-lock.json"),
+    Path("/run.json"),
+    Path("/task.json"),
+    Path("/generation-result.json"),
+    Path("/generation-evidence/invocation.json"),
+    Path("/generation-evidence/metrics.json"),
+    Path("/generation-evidence/runtime-metrics.json"),
+    Path("/generation-evidence/usage.json"),
+    Path("/generation-evidence/codex-last.txt"),
+    Path("/generation-evidence/codex-output.log"),
+    Path("/generation-evidence/prompt.txt"),
+    Path("/generation-evidence/codex-trace"),
+    Path("/candidate"),
+    Path("/reference/canonical.py"),
+    Path("/reference/prompt.py"),
+    Path("/reference/py2mpy.py"),
+    Path("/reference/reference-semantics"),
+]
+print("required_records")
+for p in required:
+    exists = p.exists()
+    readable = os.access(p, os.R_OK)
+    t = type_name(p) if os.path.lexists(p) else "absent"
+    print(f"  {p}: exists={exists} readable={readable} type={t}")
+
+hash_checks = [
+    ("/reference/canonical.py", "canonical_sha256"),
+    ("/reference/prompt.py", "trusted_prompt_sha256"),
+    ("/reference/py2mpy.py", "trusted_translator_sha256"),
+    ("/candidate/prompt.py", "candidate_prompt_sha256"),
+    ("/candidate/py2mpy.py", "candidate_translator_sha256"),
+    ("/run.json", "run_manifest_sha256"),
+    ("/task.json", "task_manifest_sha256"),
+    ("/generation-result.json", "stage1_result_sha256"),
+    ("/generation-evidence/invocation.json", "stage1_invocation_sha256"),
+    ("/generation-evidence/metrics.json", "generation_metrics_sha256"),
+    ("/generation-evidence/runtime-metrics.json", "generation_runtime_metrics_sha256"),
+    ("/generation-evidence/usage.json", "generation_usage_sha256"),
+    ("/generation-evidence/codex-last.txt", "generation_codex_last_sha256"),
+    ("/generation-evidence/codex-output.log", "generation_codex_output_sha256"),
+    ("/generation-evidence/prompt.txt", "generation_prompt_sha256"),
+]
+print("declared_file_hashes")
+for raw, key in hash_checks:
+    p = Path(raw)
+    actual = sha256_file(p)
+    expected = audit["hashes"][key]
+    print(f"  {raw}: {actual} declared={expected} match={actual == expected}")
+
+with Path("/generation-result.json").open() as inp:
+    result = json.load(inp)
+print("generation_result_evidence_hashes")
+for rel, expected in sorted(result["outputs"]["evidence"].items()):
+    p = Path("/generation-evidence") / rel
+    actual = sha256_file(p)
+    print(f"  {rel}: {actual} declared={expected} match={actual == expected}")
+
+prompt_same = Path("/candidate/prompt.py").read_bytes() == Path("/reference/prompt.py").read_bytes()
+translator_same = Path("/candidate/py2mpy.py").read_bytes() == Path("/reference/py2mpy.py").read_bytes()
+print("candidate_prompt_byte_identical", prompt_same)
+print("candidate_translator_byte_identical", translator_same)
+
+tree_diffs = compare_trees(
+    Path("/candidate/reference-semantics"),
+    Path("/reference/reference-semantics"),
+)
+print("reference_semantics_tree_diff_count", len(tree_diffs))
+for diff in tree_diffs:
+    print("  tree_diff", diff)
+
+symlinks = []
+for root in (Path("/candidate"), Path("/reference"), Path("/generation-evidence")):
+    for rel, p in walk_entries(root):
+        if p.is_symlink():
+            symlinks.append(str(root / rel))
+print("symlink_count_all_mounted_inputs", len(symlinks))
+for p in symlinks:
+    print("  symlink", p)
diff --git a/evidence/stage1/inspect_trace.py b/evidence/stage1/inspect_trace.py
new file mode 100644
index 0000000000000000000000000000000000000000..45a3be625bc805a77dca2d04e22a3d156bf617a0
--- /dev/null
+++ b/evidence/stage1/inspect_trace.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+import collections
+import json
+from pathlib import Path
+
+trace = Path(
+    "/generation-evidence/codex-trace/2026/07/30/"
+    "rollout-2026-07-30T02-20-25-019fb1e5-574a-7a01-9912-7e04dde6ea3c.jsonl"
+)
+
+top_types = collections.Counter()
+payload_types = collections.Counter()
+response_roles = collections.Counter()
+tool_calls = []
+tool_outputs = []
+messages = []
+malformed = []
+
+for line_no, raw in enumerate(trace.open(), 1):
+    try:
+        item = json.loads(raw)
+    except Exception as err:
+        malformed.append((line_no, str(err)))
+        continue
+    top_types[item.get("type")] += 1
+    payload = item.get("payload", {})
+    payload_types[payload.get("type")] += 1
+    if item.get("type") == "response_item":
+        ptype = payload.get("type")
+        if ptype == "message":
+            role = payload.get("role")
+            response_roles[role] += 1
+            texts = [
+                c.get("text", "")
+                for c in payload.get("content", [])
+                if c.get("type") in {"input_text", "output_text"}
+            ]
+            messages.append((line_no, role, "\n".join(texts)))
+        elif ptype in {"function_call", "custom_tool_call"}:
+            tool_calls.append(
+                (
+                    line_no,
+                    payload.get("name"),
+                    payload.get("arguments", payload.get("input", "")),
+                )
+            )
+        elif ptype in {"function_call_output", "custom_tool_call_output"}:
+            tool_outputs.append(
+                (
+                    line_no,
+                    payload.get("call_id"),
+                    payload.get("output", ""),
+                )
+            )
+
+print("trace", trace)
+print("line_count", sum(top_types.values()))
+print("malformed_count", len(malformed))
+print("top_types", dict(sorted(top_types.items(), key=lambda x: str(x[0]))))
+print("payload_types", dict(sorted(payload_types.items(), key=lambda x: str(x[0]))))
+print("response_roles", dict(sorted(response_roles.items(), key=lambda x: str(x[0]))))
+print("tool_call_count", len(tool_calls))
+print("tool_output_count", len(tool_outputs))
+
+print("tool_calls")
+for line_no, name, args in tool_calls:
+    flat = str(args).replace("\n", "\\n")
+    if len(flat) > 1800:
+        flat = flat[:1800] + "...[truncated]"
+    print(f"  line={line_no} tool={name} args={flat}")
+
+print("assistant_messages")
+for line_no, role, msg in messages:
+    if role != "assistant":
+        continue
+    flat = msg.replace("\n", "\\n")
+    if len(flat) > 3000:
+        flat = flat[:3000] + "...[truncated]"
+    print(f"  line={line_no} role={role} text={flat}")
+
+print("tool_outputs_status_summary")
+for line_no, call_id, output in tool_outputs:
+    text = str(output)
+    markers = []
+    for needle in (
+        '"exit_code":0',
+        '"exit_code": 0',
+        '"exit_code":1',
+        '"exit_code": 1',
+        "#Top",
+        "WarnStuckClaimState",
+        "timed out",
+        "Traceback",
+    ):
+        if needle in text:
+            markers.append(needle)
+    print(
+        f"  line={line_no} call_id={call_id} chars={len(text)} "
+        f"markers={markers}"
+    )
diff --git a/evidence/stage2/independent_differential.py b/evidence/stage2/independent_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e96064f2cba828c88c0dd1f107e2a85d508f6b2
--- /dev/null
+++ b/evidence/stage2/independent_differential.py
@@ -0,0 +1,211 @@
+#!/usr/bin/env python3
+"""Independent docstring/canonical/candidate differential for HumanEval 99."""
+
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import random
+
+
+def load_function(module_name: str, path: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module.closest_integer
+
+
+canonical = load_function("trusted_canonical", "/reference/canonical.py")
+candidate = load_function("submitted_solution", "/candidate/solution.py")
+
+
+def invoke(function, text):
+    try:
+        value = function(text)
+        return {"kind": "return", "type": type(value).__name__, "value": value}
+    except Exception as err:
+        return {
+            "kind": "raise",
+            "type": type(err).__name__,
+            "value": str(err),
+        }
+
+
+def decimal_oracle(text):
+    """Nearest integer of the exact finite Decimal denoted by text."""
+    try:
+        number = Decimal(text)
+    except (InvalidOperation, ValueError):
+        return None
+    if not number.is_finite():
+        return None
+    return int(number.to_integral_value(rounding=ROUND_HALF_UP))
+
+
+named_cases = [
+    # Docstring examples.
+    ("example", "10"),
+    ("example", "15.3"),
+    ("example", "14.5"),
+    ("example", "-14.5"),
+    # Zero, integer spellings, and both sign branches.
+    ("boundary", "0"),
+    ("boundary", "-0"),
+    ("boundary", "0.0"),
+    ("boundary", "-0.0"),
+    ("boundary", "12."),
+    ("boundary", "-12."),
+    ("boundary", ".25"),
+    ("boundary", "-.25"),
+    # Every half boundary and immediate decimal neighbors.
+    ("boundary", "0.49"),
+    ("boundary", "0.5"),
+    ("boundary", "0.51"),
+    ("boundary", "-0.49"),
+    ("boundary", "-0.5"),
+    ("boundary", "-0.51"),
+    ("boundary", "2.499999"),
+    ("boundary", "2.500000"),
+    ("boundary", "2.500001"),
+    ("boundary", "-2.499999"),
+    ("boundary", "-2.500000"),
+    ("boundary", "-2.500001"),
+    # Alternate numeric-string spellings, including ties not ending in ".5".
+    ("spelling", "+14.5"),
+    ("spelling", "014.500"),
+    ("spelling", "145e-1"),
+    ("spelling", "-145e-1"),
+    ("spelling", "1.45e1"),
+    ("spelling", "-1.45e1"),
+    ("spelling", " 14.5 "),
+    # Numeric-representation boundary probes.
+    ("representation", "0.49999999999999994"),
+    ("representation", "0.49999999999999999"),
+    ("representation", "-0.49999999999999994"),
+    ("representation", "-0.49999999999999999"),
+    ("representation", "2.49999999999999999"),
+    ("representation", "-2.49999999999999999"),
+    ("representation", "9007199254740992.5"),
+    ("representation", "-9007199254740992.5"),
+    ("representation", "1e308"),
+    ("representation", "-1e308"),
+    ("representation", "5e-324"),
+    ("representation", "-5e-324"),
+    # Underspecified invalid/non-finite inputs; recorded but not scored.
+    ("unspecified", ""),
+    ("unspecified", "not-a-number"),
+    ("unspecified", "nan"),
+    ("unspecified", "inf"),
+    ("unspecified", "-inf"),
+]
+
+generated = []
+for n in range(-40, 41):
+    generated.extend(
+        [
+            ("generated-grid", str(n)),
+            ("generated-grid", f"{n}.25"),
+            ("generated-grid", f"{n}.49"),
+            ("generated-grid", f"{n}.50"),
+            ("generated-grid", f"{n}.51"),
+            ("generated-grid", f"{n}.75"),
+        ]
+    )
+
+rng = random.Random(990073)
+for _ in range(750):
+    sign = "-" if rng.randrange(2) else ""
+    integer = rng.randrange(0, 100_000)
+    fraction = rng.randrange(0, 1_000_000)
+    generated.append(("generated-random-6dp", f"{sign}{integer}.{fraction:06d}"))
+
+cases = named_cases + generated
+records = []
+candidate_exact_mismatches = []
+candidate_canonical_mismatches = []
+candidate_doc_examples_bad = []
+
+for category, text in cases:
+    expected = decimal_oracle(text)
+    cand = invoke(candidate, text)
+    canon = invoke(canonical, text)
+    record = {
+        "category": category,
+        "input": text,
+        "exact_decimal_oracle": expected,
+        "candidate": cand,
+        "canonical": canon,
+    }
+    records.append(record)
+    if cand != canon:
+        candidate_canonical_mismatches.append(record)
+    if expected is not None and cand != {
+        "kind": "return",
+        "type": "int",
+        "value": expected,
+    }:
+        candidate_exact_mismatches.append(record)
+    if category == "example" and cand != {
+        "kind": "return",
+        "type": "int",
+        "value": expected,
+    }:
+        candidate_doc_examples_bad.append(record)
+
+inputs_path = Path("/audit-output/evidence/stage2/differential-inputs.json")
+results_path = Path("/audit-output/evidence/stage2/differential-results.json")
+inputs_path.write_text(
+    json.dumps(
+        {
+            "seed": 990073,
+            "generated_random_count": 750,
+            "cases": [{"category": c, "input": t} for c, t in cases],
+        },
+        indent=2,
+        ensure_ascii=False,
+    )
+    + "\n"
+)
+results_path.write_text(
+    json.dumps(
+        {
+            "records": records,
+            "candidate_exact_mismatches": candidate_exact_mismatches,
+            "candidate_canonical_mismatches": candidate_canonical_mismatches,
+            "candidate_doc_examples_bad": candidate_doc_examples_bad,
+        },
+        indent=2,
+        ensure_ascii=False,
+    )
+    + "\n"
+)
+
+input_hash = hashlib.sha256(inputs_path.read_bytes()).hexdigest()
+print(f"case_count={len(cases)}")
+print(f"input_manifest_sha256={input_hash}")
+print(f"candidate_doc_examples_bad={len(candidate_doc_examples_bad)}")
+print(f"candidate_exact_decimal_mismatches={len(candidate_exact_mismatches)}")
+print(f"candidate_canonical_mismatches={len(candidate_canonical_mismatches)}")
+
+print("candidate_exact_decimal_mismatch_records")
+for record in candidate_exact_mismatches:
+    print(json.dumps(record, sort_keys=True))
+
+print("candidate_canonical_mismatch_records")
+for record in candidate_canonical_mismatches:
+    print(json.dumps(record, sort_keys=True))
+
+assert not candidate_doc_examples_bad
+
+# On the ordinary six-decimal generated domain, exact decimal behavior is
+# docstring-determined and should not depend on exotic float representation.
+ordinary_bad = [
+    r
+    for r in candidate_exact_mismatches
+    if r["category"] in {"generated-grid", "generated-random-6dp"}
+]
+print(f"ordinary_generated_exact_mismatches={len(ordinary_bad)}")
+assert not ordinary_bad
