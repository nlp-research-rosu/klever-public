+              CmpOp("<", Float(0.5))
+            ),
+            Return(Name("upper")),
+            .Stmts
+          )
+          Return(Name("lower")),
+          0
+        ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
