+    ("boundary", "-0.5"),
+    ("boundary", "-0.51"),
+    ("boundary", "2.499999"),
+    ("boundary", "2.500000"),
+    ("boundary", "2.500001"),
+    ("boundary", "-2.499999"),
+    ("boundary", "-2.500000"),
+    ("boundary", "-2.500001"),
+    # Alternate numeric-string spellings, including ties not ending in ".5".
+    ("spelling", "+14.5"),
+    ("spelling", "014.500"),
+    ("spelling", "145e-1"),
+    ("spelling", "-145e-1"),
+    ("spelling", "1.45e1"),
+    ("spelling", "-1.45e1"),
+    ("spelling", " 14.5 "),
