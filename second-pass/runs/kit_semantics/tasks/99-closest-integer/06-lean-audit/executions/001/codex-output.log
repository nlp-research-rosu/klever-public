 succeeded in 0ms:
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    modules = _modules(masked_text)
    module = _verification_module(
        modules, _last_verification_main_module(workspace)
    )
    closure = _verification_closure(modules, module)
    rule_documents = _rule_documents(text, closure)
    return {
        "schema_version": 2,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "verification_modules": [module.name for module in closure],
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }
--- prove.sh ---
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
     6	python3 py2mpy.py model_boundary.py > model_boundary.mpy
     7	python3 differential_test.py
     8	
     9	kompile reference-semantics/semantics.k \
    10	  --backend llvm \
    11	  --main-module MPY-KRUN \
    12	  --syntax-module MPY-SYNTAX \
    13	  --output-definition runtime-kompiled
    14	
    15	krun solution.mpy --definition runtime-kompiled
    16	krun concrete_tests.mpy --definition runtime-kompiled
    17	krun model_boundary.mpy --definition runtime-kompiled
    18	python3 model_boundary_cpython.py
    19	
    20	kompile --backend haskell verification.k \
    21	  --main-module VERIFICATION \
    22	  --syntax-module MPY-SYNTAX \
    23	  --output-definition verification-kompiled
    24	
    25	kprove spec.k \
    26	  --definition verification-kompiled \
    27	  --spec-module SPEC
    28	
    29	set +e
    30	kprove spec-vacuity.k \
    31	  --definition verification-kompiled \
    32	  --spec-module SPEC-VACUITY \
    33	  > vacuity-probe.log 2>&1
    34	vacuity_status=$?
    35	set -e
    36	cat vacuity-probe.log
    37	if [[ $vacuity_status -ne 1 ]]; then
    38	  echo "Unexpected vacuity-probe exit: $vacuity_status" >&2
    39	  exit 1
    40	fi
    41	echo "EXPECTED FAILURE: false-result probe exited 1"
    42	
    43	set +e
    44	kprove spec-body-mutation.k \
    45	  --definition verification-kompiled \
    46	  --spec-module SPEC-BODY-MUTATION \
    47	  > body-mutation-probe.log 2>&1
    48	body_mutation_status=$?
    49	set -e
    50	cat body-mutation-probe.log
    51	if [[ $body_mutation_status -ne 1 ]]; then
    52	  echo "Unexpected body-mutation-probe exit: $body_mutation_status" >&2
    53	  exit 1
    54	fi
    55	echo "EXPECTED FAILURE: changed-body probe exited 1"
