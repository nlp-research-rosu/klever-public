--- solution.py ---
     1	import math
     2	
     3	
     4	def closest_integer(value):
     5	    number = float(value)
     6	    lower = math.floor(number)
     7	    upper = math.ceil(number)
     8	    if number > 0:
     9	        if number - lower < 0.5:
    10	            return lower
    11	        return upper
    12	    if upper - number < 0.5:
    13	        return upper
    14	    return lower
