Module(
  Import("math")
  FuncDef("closest_integer", Params("value"),
    Assign(Name("number"), Call(Name("float"), Name("value")))
    Assign(
      Name("lower"),
      Call(Attribute(Name("math"), "floor"), Name("number")))
    Assign(
      Name("upper"),
      Call(Attribute(Name("math"), "ceil"), Name("number")))
    If(Compare(Name("number"), CmpOp(">", Int(0))),
      If(Compare(
        BinOp("-", Name("number"), Name("lower")),
        CmpOp("<", Float(0.5))),
        Return(Name("lower")),
        )
      Return(Name("upper")),
      )
    If(Compare(
      BinOp("-", Name("upper"), Name("number")),
      CmpOp("<", Float(0.5))),
      Return(Name("upper")),
      )
    Return(Name("lower")))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("10")),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("15.3")),
      CmpOp("==", Int(15))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("14.5")),
      CmpOp("==", Int(15))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-14.5")),
      CmpOp("==", UnaryOp("-", Int(15)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("0")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("0.49")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-0.49")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("0.5")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-0.5")),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("2.499")),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-2.499")),
      CmpOp("==", UnaryOp("-", Int(2)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("2.501")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-2.501")),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("999.499999")),
      CmpOp("==", Int(999))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-999.499999")),
      CmpOp("==", UnaryOp("-", Int(999)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("999.500001")),
      CmpOp("==", Int(1000))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-999.500001")),
      CmpOp("==", UnaryOp("-", Int(1000)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str(".5")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-.5")),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("12.")),
      CmpOp("==", Int(12))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-12.")),
      CmpOp("==", UnaryOp("-", Int(12)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("0.49999999999999994")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-0.49999999999999994")),
      CmpOp("==", Int(0)))))
