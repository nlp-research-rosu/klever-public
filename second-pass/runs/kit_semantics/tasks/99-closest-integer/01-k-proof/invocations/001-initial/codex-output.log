diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..211bf2145b00644754ce661883b579bdcb4d9cd8
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,69 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  claim [changed-positive-far-branch]:
+    <k>
+      Call(Name("closest_integer"), str(CS:IntSeq))
+      =>
+      ceilF(decStrToF(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "closest_integer" |-> closureVal(
+          "value",
+          Assign(Name("number"), Call(Name("float"), Name("value")))
+          Assign(
+            Name("lower"),
+            Call(Attribute(Name("math"), "floor"), Name("number"))
+          )
+          Assign(
+            Name("upper"),
+            Call(Attribute(Name("math"), "ceil"), Name("number"))
+          )
+          If(
+            Compare(Name("number"), CmpOp(">", Int(0))),
+            If(
+              Compare(
+                BinOp("-", Name("number"), Name("lower")),
+                CmpOp("<", Float(0.5))
+              ),
+              Return(Name("lower")),
+              .Stmts
+            )
+            Return(Name("lower")),
+            .Stmts
+          )
+          If(
+            Compare(
+              BinOp("-", Name("upper"), Name("number")),
+              CmpOp("<", Float(0.5))
+            ),
+            Return(Name("upper")),
+            .Stmts
+          )
+          Return(Name("lower")),
+          0
+        ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires ltIF(0, decStrToF(CS))
+     andBool notBool floatLt(
+       subF(
+         decStrToF(CS),
+         intToF(floorFI(decStrToF(CS)))
+       ),
+       0.5
+     )
+endmodule
