  syntax Int ::= headIS(IntSeq) [function]
  rule headIS(iCons(C:Int, _:IntSeq)) => C
  syntax Int ::= intPart(IntSeq) [function, total] | intPartAcc(IntSeq, Int) [function, total]
  rule intPart(CS:IntSeq) => intPartAcc(CS, 0)
  rule intPartAcc(.IntSeq, A:Int) => A
  rule intPartAcc(iCons(46, _:IntSeq), A:Int) => A
  rule intPartAcc(iCons(C:Int, R:IntSeq), A:Int) => intPartAcc(R, A *Int 10 +Int (C -Int 48))
       requires C =/=Int 46
  syntax Int ::= fracPart(IntSeq) [function, total] | fracAcc(IntSeq, Int) [function, total]
  rule fracPart(.IntSeq) => 0
  rule fracPart(iCons(46, R:IntSeq)) => fracAcc(R, 0)
  rule fracPart(iCons(C:Int, R:IntSeq)) => fracPart(R) requires C =/=Int 46
  rule fracAcc(.IntSeq, A:Int) => A
  rule fracAcc(iCons(C:Int, R:IntSeq), A:Int) => fracAcc(R, A *Int 10 +Int (C -Int 48))
  syntax Int ::= fracScale(IntSeq) [function, total] | fscAcc(IntSeq, Int) [function, total]
  rule fracScale(.IntSeq) => 1
  rule fracScale(iCons(46, R:IntSeq)) => fscAcc(R, 1)
  rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46
  rule fscAcc(.IntSeq, A:Int) => A
  rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)
  rule applyBuiltin("float", str(CS:IntSeq), .Vals) => decStrToF(CS)
  rule applyBuiltin("float", I:Int, .Vals)          => intToF(I)
  rule applyBuiltin("float", F:Float, .Vals)        => F

  // ---- float / int division (promoted from mean_absolute_deviation) ----
  syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]
  rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]
  rule applyBin("/", F:Float, I:Int) => divFloatIntV(F, I)

  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----
  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----
  syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]
  rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]
  rule applyBuiltin("int", F:Float, .Vals) => truncF(F)

  rule applyBuiltin("float", I:Int, .Vals)   => intToF(I)
  rule applyBuiltin("float", F:Float, .Vals) => F

  // round: Python half-even (banker's); round(F, N) scales by 10^N
  syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]
  rule roundF(F:Float)
    => #if (F -Float floorFloat(F)) ==Float 0.5
       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
  // round(F, N): CPython rounds the EXACT binary value of F at the Nth decimal
  // place, half-to-even, then converts to the nearest double. The old code did
  // Int2Float(roundF(F *Float 10^N)) / 10^N — the float multiply F *Float 10^N
  // misrounds the half-way decision (witness: a Heron triangle area that must
  // round to 2.69 came out 2.68). Exact version, via arbitrary-precision integers:
  //     F = numer / 2^k      numer = Float2Int(F * 2^(52-e)),  k = 52 - exponentFloat(F)
  //     q = round-half-even( numer * 10^N , 2^k )        (exact big-integer round)
  //     result = nearest double to q / 10^N
  //   IEEE division is correctly rounded, so (double)q /Float (double)10^N equals
  //   the nearest double to q/10^N whenever q and 10^N are exactly representable.
  // Guarded to finite F with |F| < 1e12 and |F|*10^N < 2^52 (keeps numer and q
  // exactly representable) and a non-subnormal exponent (avoids 2^k overflowing a
  // double); the exotic tail keeps the old path, so nothing regresses.
  // Opaque for kprove, [concrete] for krun.
  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
  rule roundFN(F:Float, N:Int) => roundExactFN(F, N)
       requires notBool isNaN(F) andBool notBool isInfinite(F) andBool N >=Int 0
        andBool absFloat(F) <Float 1000000000000.0
        andBool (absFloat(F) *Float Int2Float(10 ^Int N, 53, 11)) <Float 4500000000000000.0
        andBool exponentFloat(F) >Int -900 [concrete]
  rule roundFN(F:Float, N:Int)
    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
       /Float Int2Float(10 ^Int N, 53, 11) [owise, concrete]

  syntax Float ::= roundExactFN(Float, Int) [function]
  rule roundExactFN(F:Float, N:Int)
    => rheToFloat(rndHalfEven(rExNumer(F) *Int (10 ^Int N), rExDenom(F)), 10 ^Int N, F) [concrete]

  // exact fraction of a finite in-range float:  F = rExNumer(F) / rExDenom(F),
  // rExDenom(F) = 2^k, k = 52 - exponentFloat(F) >= 0 within the guard above.
  syntax Int ::= rExK(Float) [function]
  rule rExK(F:Float) => 52 -Int exponentFloat(F) [concrete]
  syntax Int ::= rExNumer(Float) [function]
  rule rExNumer(F:Float) => Float2Int(F *Float Int2Float(2 ^Int rExK(F), 53, 11)) [concrete]
  syntax Int ::= rExDenom(Float) [function]
  rule rExDenom(F:Float) => 2 ^Int rExK(F) [concrete]

  // round-half-even of A/B (B > 0), to the nearest integer, ties to even.
  // divInt/modInt are Euclidean (B>0 => remainder in [0,B)) — i.e. floored here.
  syntax Int ::= rndHalfEven(Int, Int) [function]
  rule rndHalfEven(A:Int, B:Int) => rndHE(A divInt B, A modInt B, B) [concrete]
  syntax Int ::= rndHE(Int, Int, Int) [function]
  rule rndHE(Q:Int, R:Int, B:Int) => Q        requires 2 *Int R <Int B [concrete]
  rule rndHE(Q:Int, R:Int, B:Int) => Q +Int 1 requires 2 *Int R >Int B [concrete]
  rule rndHE(Q:Int, R:Int, B:Int) => Q        requires 2 *Int R ==Int B andBool Q modInt 2 ==Int 0 [concrete]
  rule rndHE(Q:Int, R:Int, B:Int) => Q +Int 1 requires 2 *Int R ==Int B andBool Q modInt 2 =/=Int 0 [concrete]

  // q / 10^N as the nearest double; preserve Python's signed zero when q == 0.
  syntax Float ::= rheToFloat(Int, Int, Float) [function]
  rule rheToFloat(0, _:Int, F:Float) => #if signFloat(F) #then --Float 0.0 #else 0.0 #fi [concrete]
  rule rheToFloat(Q:Int, SCALE:Int, _:Float)
    => Int2Float(Q, 53, 11) /Float Int2Float(SCALE, 53, 11) requires Q =/=Int 0 [concrete]

  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)

  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
  syntax KItem ::= "#mathSqrt"
  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>

  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which

