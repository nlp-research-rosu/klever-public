diff --git a/evidence/proc_exe_compat.c b/evidence/proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..fe0c52a9f1c4da66d0cddf99a4e4389de65c5f64
--- /dev/null
+++ b/evidence/proc_exe_compat.c
@@ -0,0 +1,26 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  const char *effective = path;
+  if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+    const char *cursor = path + 6;
+    while (*cursor >= '0' && *cursor <= '9') {
+      ++cursor;
+    }
+    if (strcmp(cursor, "/exe") == 0) {
+      effective = "/proc/self/exe";
+    }
+  }
+  return real_readlink(effective, buffer, size);
+}
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..68362cd16ed1e32182ada7a08f75ba9b9d6a8329
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf '%s\n' '--- OUTPUT BEGIN ---'
+  "$@"
+  rc=$?
+  printf '%s\n' '--- OUTPUT END ---'
+  printf 'EXIT: %d\n' "$rc"
+} >"$log" 2>&1
+
+exit "$rc"
diff --git a/evidence/run_preflight.py b/evidence/run_preflight.py
new file mode 100644
