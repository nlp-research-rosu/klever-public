diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2cb87bc0499a8a7398bc8fed563ad69b20cbff87
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,43 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // For arbitrary mathematical integers X and Y, load the exact translated
+  // function body, invoke its module binding, and observe the returned value.
+  claim [add-correct]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("add", Params("x", "y"),
+            Return(BinOp("+", Name("x"), Name("y"))))
+        )
+      )
+      ~> Call(Name("add"), Int(X:Int), Int(Y:Int))
+      => X +Int Y
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> (
+         scope(.Map, parent(-1))
+         =>
+         scope(
+           "add" |->
+             closureVal(
+               "x", "y", .ParamNames,
+               Return(BinOp("+", Name("x"), Name("y"))) .Stmts,
+               0
+             ),
+           parent(-1)
+         )
+       )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..27773e3e8d498095a5ad7b5bdaebfec716444bbf
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,17 @@
+import operator
+
+from solution import add
+
+
+def main():
+    values = (-100, -7, -1, 0, 1, 8, 100)
+    checked = 0
+    for x in values:
+        for y in values:
+            assert add(x, y) == operator.add(x, y)
+            checked += 1
+    print(f"CPython differential checks: {checked}; mismatches: 0")
+
+
+if __name__ == "__main__":
+    main()
