index 0000000000000000000000000000000000000000..3d64d9bcdfbf253f4436dc683da32c4e3304be49
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_file"
+
+"$@" >> "$log_file" 2>&1
+status=$?
+
+printf 'EXIT_STATUS: %d\n' "$status" >> "$log_file"
+exit "$status"

exec
