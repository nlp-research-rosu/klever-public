+import Proof
+
+open Proof
+
+#print axioms Proof.final
+
+private def emptyVS := SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+private def oneInt (i : Int) :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+    (SortVal.inj_SortInt i) emptyVS
+
+#eval («applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+  "+" (SortVal.inj_SortInt 4) (SortVal.inj_SortBool true)) ==
+    SortVal.inj_SortInt 5
+#eval («applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+  "//" (SortVal.inj_SortInt (-7)) (SortVal.inj_SortInt 3)) ==
+    SortVal.inj_SortInt (-3)
+#eval («applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+  "**" (SortVal.inj_SortInt 3) (SortVal.inj_SortInt 4)) ==
+    SortVal.inj_SortInt 81
+#eval «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+  "==" (SortVal.inj_SortBool true) (SortVal.inj_SortBool false)
+#eval «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+  "==" (SortVal.inj_SortIterable
+    (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» (oneInt 3)))
+  (SortVal.inj_SortIterable
+    (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» (oneInt 3)))
+#eval «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+  "==" (SortVal.«setV(_)_MPY-SET_Val_IntSeq»
+    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 1
+      (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 2
+        SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»)))
+  (SortVal.«setV(_)_MPY-SET_Val_IntSeq»
+    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 2
+      (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 1
+        SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»)))
