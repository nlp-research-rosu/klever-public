+    obtain ⟨i, rfl⟩ := isIntGuardValue V h
+    rfl
+  constructor
+  · intro I V h
+    obtain ⟨i, rfl⟩ := isIntGuardValue V h
+    rfl
+  · intro V₂ V₁ h
+    have h₁ :
