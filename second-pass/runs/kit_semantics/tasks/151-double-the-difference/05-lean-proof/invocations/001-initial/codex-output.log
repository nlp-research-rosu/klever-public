+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» key keys,
+    SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value values,
+    sought =>
+      if key == sought then some value else dictLookup? keys values sought
+  | _, _, _ => none
