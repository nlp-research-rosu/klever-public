+      andTrueLeft _ _ h
+    have h₂ :
+        isInt (SortK.kseq ((@inj SortVal SortKItem) V₂) SortK.dotk) = true :=
+      andTrueRight _ _ h
+    obtain ⟨i₁, rfl⟩ := isIntGuardValue V₁ h₁
+    obtain ⟨i₂, rfl⟩ := isIntGuardValue V₂ h₂
+    rfl
 
