Module(
  FuncDef("double_the_difference", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("lst"),
      If(Call(Name("isinstance"), Name("number"), Name("int")),
        If(Compare(Name("number"), CmpOp(">", Int(0))),
          If(Compare(
            BinOp("%", Name("number"), Int(2)),
            CmpOp("==", Int(1))),
            AugAssign(
              Name("result"),
              "+",
              BinOp("*", Name("number"), Name("number"))),
            ),
          ),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(Int(1), Int(3), Int(2), Int(0))),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(2)), Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(Int(9), UnaryOp("-", Int(2)))),
      CmpOp("==", Int(81))))
  Assert(
    Compare(
      Call(Name("double_the_difference"), ListExpr(Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("double_the_difference"), ListExpr()),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(
          Float(1.5),
          Int(3),
          UnaryOp("-", Int(5)),
          Float(7.0),
          Int(5),
          Bool(false))),
      CmpOp("==", Int(34)))))
