Module(
  FuncDef("double_the_difference", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("lst"),
      If(Call(Name("isinstance"), Name("number"), Name("int")),
        If(Compare(Name("number"), CmpOp(">", Int(0))),
          If(Compare(
            BinOp("%", Name("number"), Int(2)),
            CmpOp("==", Int(1))),
            AugAssign(
              Name("result"),
              "+",
              BinOp("*", Name("number"), Name("number"))),
            ),
          ),
        ))
    Return(Name("result"))))
