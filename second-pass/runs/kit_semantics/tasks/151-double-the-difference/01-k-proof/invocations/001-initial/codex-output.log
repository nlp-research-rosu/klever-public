+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Circularity once the loop target has been bound.
+  claim [loop-invariant]:
+    <k>
+      #loop(list(VS:ValSeq), Name("number"), dtdLoopBody)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+      1 |-> scope(
+        "lst" |-> list(INPUT:ValSeq)
+        "number" |-> (OLD:Val => lastNumber(VS, OLD))
+        "result" |-> (S:Int => S +Int dtd(VS)),
+        parent(0))
+    </scopes>
+    requires numericVals(VS)
+
+  // The first iteration creates the loop-target binding.  These two claims are
+  // exhaustive over the fixed model's numeric element classes and then reuse
+  // loop-invariant for the arbitrary tail.
+  claim [loop-first-int]:
+    <k>
+      #loop(list(vCons(I:Int, R:ValSeq)),
+            Name("number"), dtdLoopBody)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+      1 |-> (
+        scope(
+          "lst" |-> list(vCons(I, R))
+          "result" |-> S:Int,
+          parent(0))
+        =>
+        scope(
+          "lst" |-> list(vCons(I, R))
+          "number" |-> lastNumber(R, I)
+          "result" |-> S +Int oddIntSquare(I) +Int dtd(R),
+          parent(0)))
+    </scopes>
+    requires numericVals(R)
+
+  claim [loop-first-float]:
+    <k>
+      #loop(list(vCons(F:Float, R:ValSeq)),
+            Name("number"), dtdLoopBody)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+      1 |-> (
+        scope(
+          "lst" |-> list(vCons(F, R))
+          "result" |-> S:Int,
+          parent(0))
+        =>
+        scope(
+          "lst" |-> list(vCons(F, R))
+          "number" |-> lastNumber(R, F)
+          "result" |-> S +Int dtd(R),
+          parent(0)))
+    </scopes>
+    requires numericVals(R)
+
+  // Whole-function theorem: ordinary lookup, call-frame allocation, parameter
+  // binding, body execution, return, and frame cleanup all use fixed MPY rules.
+  claim [double-the-difference]:
+    <k>
+      Call(Name("double_the_difference"), (list(VS:ValSeq), .Exprs))
+      => dtd(VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVals(VS)
+
+endmodule
