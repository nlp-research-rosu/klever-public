+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax Int ::= dtd(ValSeq) [function, total]
+               | oddSquare(Val) [function, total]
+               | projectIntTotal(Val)
+                   [function, total, symbol(projectIntTotal), no-evaluators]
+  syntax Val ::= lastValue(ValSeq, Val) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Mathematical summary of the remaining iterable suffix.
+  rule dtd(.ValSeq) => 0
+  rule dtd(vCons(V:Val, VS:ValSeq))
+    => oddSquare(V) +Int dtd(VS)
+
+  // The fixed model's isinstance(_, int) recognizes exactly the Int subsort.
+  rule oddSquare(V:Val)
+    => #if isInt(V)
+       #then #if projectIntTotal(V) >Int 0
+                    andBool pyMod(projectIntTotal(V), 2) ==Int 1
+              #then projectIntTotal(V) *Int projectIntTotal(V)
+              #else 0
+              #fi
+       #else 0
+       #fi
+
+  // Exact final value of the loop target (irrelevant after the call frame pops,
+  // but retained so the circularity describes the full local scope).
+  rule lastValue(.ValSeq, OLD:Val) => OLD
+  rule lastValue(vCons(V:Val, .ValSeq), _OLD:Val) => V
+  rule lastValue(vCons(_V:Val, vCons(W:Val, WS:ValSeq)), OLD:Val)
+    => lastValue(vCons(W, WS), OLD)
+
+  // Guarded total projection: it only yields a concrete Int when its argument
+  // already is in the Int subsort.
+  rule projectIntTotal(I:Int) => I [simplification]
+
+  // Dynamic-sort dispatch twins of fixed MPY-INT equations.  Each guard is
+  // exactly the original static Int match domain.
+  rule isIntV(V:Val) => isInt(V) [simplification]
+  rule applyCmp(">", V:Val, I:Int)
+    => projectIntTotal(V) >Int I
+    requires isInt(V)
+    [simplification]
+  rule applyBin("%", V:Val, I:Int)
+    => pyMod(projectIntTotal(V), I)
+    requires isInt(V)
+    [simplification]
+  rule applyBin("*", V1:Val, V2:Val)
+    => projectIntTotal(V1) *Int projectIntTotal(V2)
+    requires isInt(V1) andBool isInt(V2)
+    [simplification]
+endmodule

