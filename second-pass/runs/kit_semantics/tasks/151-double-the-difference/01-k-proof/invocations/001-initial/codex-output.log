+                             CmpOp("==", Int(1))),
+                    AugAssign(Name("result"), "+",
+                              BinOp("+", Name("number"), Name("number"))),
+                    .Stmts),
+                  .Stmts),
+                .Stmts))
+            Return(Name("result")),
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+endmodule
