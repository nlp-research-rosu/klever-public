new file mode 100644
index 0000000000000000000000000000000000000000..a6d95318f634559271151f5d235641a4b0292f3c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,71 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  // An arbitrary finite sequence over every numeric class represented by the
+  // fixed semantics.  The conversion is surjective onto Int/Float ValSeqs.
+  syntax Number ::= nInt(Int) | nFloat(Float)
+  syntax NumberSeq ::= ".NumberSeq" | nCons(Number, NumberSeq)
+
+  syntax ValSeq ::= numberVals(NumberSeq) [function, total]
+  syntax Val ::= numberVal(Number) [function, total]
+               | lastNumber(NumberSeq, Val) [function, total]
+  syntax Int ::= dtd(NumberSeq) [function, total]
+               | oddIntSquare(Int) [function, total]
+
+  // Exact source-term abbreviations.  These expand at kompile time and do not
+  // add execution rules.
+  syntax Stmts ::= "dtdLoopBody" [macro]
+                 | "dtdBody" [macro]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule numberVal(nInt(I:Int)) => I
+  rule numberVal(nFloat(F:Float)) => F
+
+  rule numberVals(.NumberSeq) => .ValSeq
+  rule numberVals(nCons(nInt(I:Int), NS:NumberSeq))
+    => vCons(I, numberVals(NS))
+  rule numberVals(nCons(nFloat(F:Float), NS:NumberSeq))
+    => vCons(F, numberVals(NS))
+
+  // Mathematical summary of the arbitrary remaining numeric suffix.
+  rule dtd(.NumberSeq) => 0
+  rule dtd(nCons(nInt(I:Int), NS:NumberSeq))
+    => oddIntSquare(I) +Int dtd(NS)
+  rule dtd(nCons(nFloat(_F:Float), NS:NumberSeq))
+    => dtd(NS)
+
+  rule oddIntSquare(I:Int)
+    => #if I >Int 0 andBool pyMod(I, 2) ==Int 1
+       #then I *Int I
+       #else 0
+       #fi
+
+  // Exact final loop-target value.  It is local and later deallocated, but
+  // retaining it makes the circularity describe the entire function scope.
+  rule lastNumber(.NumberSeq, OLD:Val) => OLD
+  rule lastNumber(nCons(N:Number, NS:NumberSeq), _OLD:Val)
+    => lastNumber(NS, numberVal(N))
+
+  rule dtdLoopBody
+    => If(Call(Name("isinstance"),
+               (Name("number"), Name("int"), .Exprs)),
+         If(Compare(Name("number"), CmpOp(">", Int(0))),
+           If(Compare(BinOp("%", Name("number"), Int(2)),
+                      CmpOp("==", Int(1))),
+             AugAssign(Name("result"), "+",
+                       BinOp("*", Name("number"), Name("number"))),
+             .Stmts),
+           .Stmts),
+         .Stmts)
+
+  rule dtdBody
+    => Assign(Name("result"), Int(0))
+       For(Name("number"), Name("lst"), dtdLoopBody)
+       Return(Name("result"))
+endmodule

