diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7db21b1baeb7f026903278921812b62602a92924
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // One circularity covers every arbitrary finite Int/Float suffix.
+  claim [loop-invariant]:
+    <k>
+      #loop(list(VS:ValSeq), Name("number"), dtdLoopBody)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+      1 |-> scope(M:Map => ?M:Map, parent(0))
+    </scopes>
+    requires numericVals(VS)
+     andBool "lst" in_keys(M)
+     andBool "result" in_keys(M)
+     andBool notBool ("$cells" in_keys(M))
+     andBool notBool ("int" in_keys(M))
+     andBool notBool ("isinstance" in_keys(M))
+     andBool {M["result"]}:>Int ==Int S
+    ensures "result" in_keys(?M)
+     andBool {?M["result"]}:>Int ==Int S +Int dtd(VS)
+
+  // Whole-function theorem: ordinary lookup, call-frame allocation, parameter
+  // binding, body execution, return, and frame cleanup all use fixed MPY rules.
+  claim [double-the-difference]:
+    <k>
+      Call(Name("double_the_difference"), (list(VS:ValSeq), .Exprs))
+      => dtd(VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVals(VS)
+
+endmodule
