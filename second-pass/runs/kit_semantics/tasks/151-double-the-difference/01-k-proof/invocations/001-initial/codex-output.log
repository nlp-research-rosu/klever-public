/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-invariant' in /workspace
