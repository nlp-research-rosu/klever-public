+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+      1 |-> scope(
+        "lst" |-> list(INPUT:ValSeq)
+        "number" |-> (OLD:Val => lastNumber(VS, OLD))
+        "result" |-> (S:Int => S +Int dtd(VS)),
+        parent(0))
+    </scopes>
+    requires numericVals(VS)
+
+  // The first iteration creates the loop-target binding.  These two claims are
+  // exhaustive over the fixed model's numeric element classes and then reuse
+  // loop-invariant for the arbitrary tail.
+  claim [loop-first-int]:
