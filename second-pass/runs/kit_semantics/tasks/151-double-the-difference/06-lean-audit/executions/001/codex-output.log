diff --git a//tmp/audit-work/operational-checks-151.py b//tmp/audit-work/operational-checks-151.py
new file mode 100644
index 0000000000000000000000000000000000000000..85325ac2a515fb90424692f61740fd030f297037
--- /dev/null
+++ b//tmp/audit-work/operational-checks-151.py
@@ -0,0 +1,22 @@
+def double_the_difference(lst):
+    result = 0
+    number = 0
+    for number in lst:
+        if isinstance(number, int):
+            if number > 0:
+                if number % 2 == 1:
+                    result += number * number
+    return result
+
+
+assert double_the_difference([]) == 0
+assert double_the_difference([1, 3, 2, 0]) == 10
+assert double_the_difference([-1, -2, 0]) == 0
+assert double_the_difference([9, -2]) == 81
+assert double_the_difference([1.5, 5, 4.0, -3, 7]) == 74
+assert (-3 % 2) == 1
+assert (5 % 2) == 1
+assert (5 * -4) == -20
+assert isinstance(7, int)
+assert not isinstance(7.0, int)
+assert not isinstance(True, int)
