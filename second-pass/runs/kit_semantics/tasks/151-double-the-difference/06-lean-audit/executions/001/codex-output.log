+import Proof
+
+namespace Counterfactual
+
+def falseAnd (_ _ : SortBool) : SortBool := false
+def falseGt (_ _ : SortInt) : SortBool := false
+def zeroAdd (_ _ : SortInt) : SortInt := 0
+def zeroMul (_ _ : SortInt) : SortInt := 0
+def noBin (_ : SortString) (_ _ : SortVal) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+def falseCmp (_ : SortString) (_ _ : SortVal) : SortBool := false
+def falseDefined (_ : SortVal) : SortBool := false
+def zeroDtd (_ : SortValSeq) : SortInt := 0
+def falseK (_ : SortK) : SortBool := false
+def falseVal (_ : SortVal) : SortBool := false
+def zeroOdd (_ : SortInt) : SortInt := 0
+def zeroProject (_ : SortVal) : SortInt := 0
+def zeroMod (_ _ : SortInt) : SortInt := 0
+def noProjection (_ : SortK) : Option SortInt := none
+
+theorem degenerateTargetStillCloses :
+    Klean151DoubleTheDifference.Lemmas.targetStatement
+      falseAnd falseGt zeroAdd zeroMul noBin falseCmp falseDefined zeroDtd
+      falseK falseK falseVal zeroOdd zeroProject zeroMod noProjection := by
+  simp [Klean151DoubleTheDifference.Lemmas.targetStatement, falseAnd,
+    falseGt, zeroAdd, zeroMul, noBin, falseCmp, falseDefined, zeroDtd,
+    falseK, falseVal, zeroOdd, zeroProject, zeroMod, noProjection]
+
+end Counterfactual
