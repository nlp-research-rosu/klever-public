+        (SortVal.inj_SortInt (-4))
+        (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+          (SortVal.inj_SortBool true)
+          (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+            (SortVal.inj_SortInt 7)
+            SortValSeq.«.ValSeq_MPY-CORE_ValSeq»))))
+
+#eval Proof._andBool_ true false
+#eval Proof._andBool_ true true
+#eval Proof.«_>Int_» (-1) 0
+#eval Proof.«_>Int_» 9 0
+#eval Proof.«_+Int_» (-3) 8
+#eval Proof.«_*Int_» 5 (-4)
+#eval Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-3) 2
+#eval Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» 5 2
+#eval Proof.«oddIntSquare(_)_VERIFICATION-SYNTAX_Int_Int» (-3)
+#eval Proof.«oddIntSquare(_)_VERIFICATION-SYNTAX_Int_Int» 4
+#eval Proof.«oddIntSquare(_)_VERIFICATION-SYNTAX_Int_Int» 5
+#eval Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+  (SortVal.inj_SortInt 7)
+#eval Proof.«definedProjectInt(_)_VERIFICATION-SYNTAX_Bool_Val»
+  (SortVal.inj_SortFloat (Float.ofInt 7))
+#eval Proof.isInt
+  (SortK.kseq (SortKItem.inj_SortInt 7) SortK.dotk)
+#eval Proof.isFloat
+  (SortK.kseq (SortKItem.inj_SortFloat (Float.ofInt 7)) SortK.dotk)
+#eval Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» (SortVal.inj_SortInt 7)
+#eval Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» (SortVal.inj_SortBool true)
+#eval Proof.projectIntTotal (SortVal.inj_SortInt (-11))
+#eval Proof.«project:Int?»
+  (SortK.kseq (SortKItem.inj_SortInt (-11)) SortK.dotk)
+#eval Proof.«project:Int?»
+  (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk)
+#eval Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">"
+  (SortVal.inj_SortInt 9) (SortVal.inj_SortInt 0)
+#eval match Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "%"
+    (SortVal.inj_SortInt (-3)) (SortVal.inj_SortInt 2) with
+  | SortVal.inj_SortInt i => some i
+  | _ => none
+#eval match Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "*"
+    (SortVal.inj_SortInt 5) (SortVal.inj_SortInt (-4)) with
+  | SortVal.inj_SortInt i => some i
+  | _ => none
+#eval Proof.«dtd(_)_VERIFICATION-SYNTAX_Int_ValSeq» adversarialValues
+
+example :
+    Proof.«dtd(_)_VERIFICATION-SYNTAX_Int_ValSeq» adversarialValues = 74 := by
+  native_decide
+
+example :
+    (Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "%"
+      (SortVal.inj_SortInt (-3)) (SortVal.inj_SortInt 2) ==
+      SortVal.inj_SortInt 1) = true := by
+  native_decide
+
+example :
+    (Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "*"
+      (SortVal.inj_SortInt 5) (SortVal.inj_SortInt (-4)) ==
+      SortVal.inj_SortInt (-20)) = true := by
+  native_decide
+
+example :
+    Proof.«isIntV(_)_MPY-BUILTINS_Bool_Val» (SortVal.inj_SortBool true) =
+      false := by
+  rfl
diff --git a//tmp/audit-work/operational-checks-151.py b//tmp/audit-work/operational-checks-151.py
new file mode 100644
index 0000000000000000000000000000000000000000..85325ac2a515fb90424692f61740fd030f297037
--- /dev/null
+++ b//tmp/audit-work/operational-checks-151.py
@@ -0,0 +1,22 @@
+def double_the_difference(lst):
+    result = 0
+    number = 0
+    for number in lst:
+        if isinstance(number, int):
+            if number > 0:
+                if number % 2 == 1:
+                    result += number * number
+    return result
+
+
+assert double_the_difference([]) == 0
+assert double_the_difference([1, 3, 2, 0]) == 10
+assert double_the_difference([-1, -2, 0]) == 0
+assert double_the_difference([9, -2]) == 81
+assert double_the_difference([1.5, 5, 4.0, -3, 7]) == 74
+assert (-3 % 2) == 1
+assert (5 % 2) == 1
+assert (5 * -4) == -20
+assert isinstance(7, int)
+assert not isinstance(7.0, int)
+assert not isinstance(True, int)
