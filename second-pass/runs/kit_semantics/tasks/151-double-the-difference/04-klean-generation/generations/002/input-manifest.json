      "rationale": "Base equation defining the numericVals domain predicate on the empty value sequence.",
      "source_rule_id": "rule-66cf82d7237685a06ca264938d829ef692b6502a47052bc8b2f6955fe66a6b93",
      "start_line": 25,
      "text": "  rule numericVals(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "e9fc08fe6f0ef484c171a413dc9c554c9e1cb235e2a13e54d0b99e027be012c6",
      "rationale": "Structural recurrence defining numericVals on a cons sequence from the fixed Int and Float sort predicates.",
      "source_rule_id": "rule-e9fc08fe6f0ef484c171a413dc9c554c9e1cb235e2a13e54d0b99e027be012c6",
      "start_line": 26,
      "text": "  rule numericVals(vCons(V:Val, VS:ValSeq))\n    => (isInt(V) orBool isFloat(V)) andBool numericVals(VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "05f070d41939b56798e284af83a3e82bf4d5f6d0664fcca2e436614ee08ee58b",
      "rationale": "Base equation defining the dtd mathematical summary for an empty sequence.",
      "source_rule_id": "rule-05f070d41939b56798e284af83a3e82bf4d5f6d0664fcca2e436614ee08ee58b",
      "start_line": 30,
      "text": "  rule dtd(.ValSeq) => 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "VERIFICATION",
      "normalized_sha256": "091a4aebff684b5edd2fda9f704a6dcd74b9e0ee75b759c08524d9372c9492ae",
      "rationale": "Primary recurrence defining dtd for an Int head by adding its defined odd-square contribution.",
      "source_rule_id": "rule-091a4aebff684b5edd2fda9f704a6dcd74b9e0ee75b759c08524d9372c9492ae",
      "start_line": 31,
      "text": "  rule dtd(vCons(I:Int, VS:ValSeq))\n    => oddIntSquare(I) +Int dtd(VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "VERIFICATION",
      "normalized_sha256": "02f1cd1ee63740c19aa3424d09cc566b2276808d9227302e4960c6cdf31c1498",
      "rationale": "Primary recurrence defining dtd for a Float head, which contributes zero.",
      "source_rule_id": "rule-02f1cd1ee63740c19aa3424d09cc566b2276808d9227302e4960c6cdf31c1498",
      "start_line": 33,
      "text": "  rule dtd(vCons(_F:Float, VS:ValSeq)) => dtd(VS)"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "4e0a1617be504700d11652945bd8b5943571997cdfaf10f58ecb4a649fdddd06",
      "rationale": "Catch-all definitional case making dtd total on non-Int, non-Float value heads.",
      "source_rule_id": "rule-4e0a1617be504700d11652945bd8b5943571997cdfaf10f58ecb4a649fdddd06",
      "start_line": 34,
      "text": "  rule dtd(vCons(_V:Val, VS:ValSeq)) => dtd(VS) [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION",
      "normalized_sha256": "2bac10cc0d5570f5c4119daf459bab1b743889d5580499871f03e1f76e2a0072",
      "rationale": "Equation defining the named oddIntSquare summary by positivity, Python modulo parity, and squaring.",
      "source_rule_id": "rule-2bac10cc0d5570f5c4119daf459bab1b743889d5580499871f03e1f76e2a0072",
      "start_line": 43,
      "text": "  rule oddIntSquare(I:Int)\n    => #if I >Int 0 andBool pyMod(I, 2) ==Int 1\n       #then I *Int I\n       #else 0\n       #fi"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 51,
      "module": "VERIFICATION",
      "normalized_sha256": "103bd3ccf8069de7e32015f61cbdcfcd2fea57ae81cf1fc97f11833c3e79466d",
      "rationale": "Base equation defining lastNumber for an empty remaining sequence.",
      "source_rule_id": "rule-103bd3ccf8069de7e32015f61cbdcfcd2fea57ae81cf1fc97f11833c3e79466d",
      "start_line": 51,
      "text": "  rule lastNumber(.ValSeq, OLD:Val) => OLD"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 53,
      "module": "VERIFICATION",
      "normalized_sha256": "6ca9bcdd5aaae2268b88e058ecf722a3c6d99c23f29b1facbeace313029cc1c2",
      "rationale": "Structural recurrence defining lastNumber by threading the current head as the latest loop-target value.",
      "source_rule_id": "rule-6ca9bcdd5aaae2268b88e058ecf722a3c6d99c23f29b1facbeace313029cc1c2",
      "start_line": 52,
      "text": "  rule lastNumber(vCons(V:Val, VS:ValSeq), _OLD:Val)\n    => lastNumber(VS, V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 57,
      "module": "VERIFICATION",
      "normalized_sha256": "9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
      "rationale": "Equation defining the named definedProjectInt guard as membership in the fixed Int subsort.",
      "source_rule_id": "rule-9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
      "start_line": 57,
      "text": "  rule definedProjectInt(V:Val) => isInt(V)"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 63,
      "module": "VERIFICATION",
      "normalized_sha256": "ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "rationale": "Guarded definitional orientation identifying the named projectIntTotal proof term with the built-in partial Int cast.",
      "source_rule_id": "rule-ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "start_line": 61,
      "text": "  rule projectIntTotal(V:Val) => {V}:>Int\n    requires definedProjectInt(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 66,
      "module": "VERIFICATION",
      "normalized_sha256": "22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
      "rationale": "Reverse symbolic orientation in the definition of projectIntTotal as an alias for the defined built-in Int cast.",
      "source_rule_id": "rule-22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
      "start_line": 64,
      "text": "  rule {V:Val}:>Int => projectIntTotal(V)\n    requires definedProjectInt(V)\n    [symbolic(V), simplification, preserves-definedness]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 67,
      "module": "VERIFICATION",
      "normalized_sha256": "7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
      "rationale": "Sort-collapse equation defining projectIntTotal to be the identity on an actual Int.",
      "source_rule_id": "rule-7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
      "start_line": 67,
      "text": "  rule projectIntTotal(I:Int) => I [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 95,
      "module": "VERIFICATION",
      "normalized_sha256": "1779f1a9c768fbefeb2ffd12021c24568c63cc6be52362c9e4b2905a88ebdbce",
      "rationale": "Macro expansion defining the named dtdLoopBody proof term as the exact source-level nested conditional and update.",
      "source_rule_id": "rule-1779f1a9c768fbefeb2ffd12021c24568c63cc6be52362c9e4b2905a88ebdbce",
      "start_line": 85,
      "text": "  rule dtdLoopBody\n    => If(Call(Name(\"isinstance\"),\n               (Name(\"number\"), Name(\"int\"), .Exprs)),\n         If(Compare(Name(\"number\"), CmpOp(\">\", Int(0))),\n           If(Compare(BinOp(\"%\", Name(\"number\"), Int(2)),\n                      CmpOp(\"==\", Int(1))),\n             AugAssign(Name(\"result\"), \"+\",\n                       BinOp(\"*\", Name(\"number\"), Name(\"number\"))),\n             .Stmts),\n           .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 101,
      "module": "VERIFICATION",
      "normalized_sha256": "868c5f6cd2b1bc2cd603649f9d6fa81ce150a47b98260c1f12a5dd85c34b916d",
      "rationale": "Macro expansion defining the named dtdBody proof term as initialization, the loop, and return.",
      "source_rule_id": "rule-868c5f6cd2b1bc2cd603649f9d6fa81ce150a47b98260c1f12a5dd85c34b916d",
      "start_line": 97,
      "text": "  rule dtdBody\n    => Assign(Name(\"result\"), Int(0))\n       Assign(Name(\"number\"), Int(0))\n       For(Name(\"number\"), Name(\"lst\"), dtdLoopBody)\n       Return(Name(\"result\"))"
    }
  ],
