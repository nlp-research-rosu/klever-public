@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module WITNESS-VALUES
+  imports VERIFICATION
+
+  claim [empty]:
+    <k> dtd(.ValSeq) => 0 </k>
+
+  claim [examples-and-boundaries]:
+    <k>
+      dtd(vCons(-3,
+          vCons(-2,
+          vCons(-1,
+          vCons(0,
+          vCons(1,
+          vCons(2,
+          vCons(3, .ValSeq))))))))
+      => 10
+    </k>
+
