diff --git a/evidence/concrete_execution.py b/evidence/concrete_execution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3b229c5d220e30a1b8ee076d09766b696fb356ff
--- /dev/null
+++ b/evidence/concrete_execution.py
@@ -0,0 +1,19 @@
+def double_the_difference(lst):
+    result = 0
+    number = 0
+    for number in lst:
+        if isinstance(number, int):
+            if number > 0:
+                if number % 2 == 1:
+                    result += number * number
+    return result
+
+
+assert double_the_difference([]) == 0
+assert double_the_difference([1, 3, 2, 0]) == 10
+assert double_the_difference([-3, -2, -1, 0, 1, 2, 3]) == 10
+assert double_the_difference([-1, -2, 0]) == 0
+assert double_the_difference([9, -2]) == 81
+assert double_the_difference([0]) == 0
+assert double_the_difference([1.5, 3, -5, 7.0, 5]) == 34
+assert double_the_difference([1000000000000000000001]) == 1000000000000000000002000000000000000000001
