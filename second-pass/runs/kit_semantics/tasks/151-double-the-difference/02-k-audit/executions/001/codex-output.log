@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""Concrete satisfying witnesses for both entry preconditions."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.double_the_difference
+
+
+canonical = load(Path("/reference/canonical.py"), "witness_canonical")
+candidate = load(
+    Path("/tmp/audit-work/candidate-src/solution.py"), "witness_candidate"
+)
+
+witnesses = [
+    ("empty", [], 0),
+    ("examples-and-boundaries", [-3, -2, -1, 0, 1, 2, 3], 10),
+    ("mixed-numeric", [1.5, 3, -5, 7.0, 5], 34),
+]
+
+for name, values, formal_dtd in witnesses:
+    c = candidate(values)
+    r = canonical(values)
+    print(
+        f"{name}: input={values!r} formal_dtd={formal_dtd} "
+        f"candidate={c!r} canonical={r!r}"
+    )
+    assert c == formal_dtd
+    assert r == formal_dtd
+
+print("loop_precondition_witness: VS=.ValSeq INPUT=.ValSeq OLD=0 S=0")
+print("whole_precondition_witness: VS=.ValSeq with exact initial cells")

diff --git a//tmp/audit-work/candidate-src/audit-body-mutation.k b//tmp/audit-work/candidate-src/audit-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..e8f16d96d02da2c602502551773e63c9be8fd1d6
--- /dev/null
+++ b//tmp/audit-work/candidate-src/audit-body-mutation.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module AUDIT-BODY-MUTATION
+  imports VERIFICATION
+
+  // Original body returns 1 on [1]. This closure term materially changes the
+  // multiplication to addition, so its real execution returns 2.
+  claim [changed-body-rejects-original-result]:
+    <k>
+      Call(Name("double_the_difference"),
+           (list(vCons(1, .ValSeq)), .Exprs))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(
+            ("lst", .ParamNames),
+            Assign(Name("result"), Int(0))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("lst"),
+              If(
+                Call(
+                  Name("isinstance"),
+                  (Name("number"), Name("int"), .Exprs)),
+                If(
+                  Compare(Name("number"), CmpOp(">", Int(0))),
+                  If(
+                    Compare(
+                      BinOp("%", Name("number"), Int(2)),
+                      CmpOp("==", Int(1))),
+                    AugAssign(
+                      Name("result"),
+                      "+",
+                      BinOp(
+                        "+",
+                        Name("number"),
+                        Name("number"))),
+                    .Stmts),
+                  .Stmts),
+                .Stmts))
+            Return(Name("result")),
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/candidate-src/audit-spec-vacuity.k b//tmp/audit-work/candidate-src/audit-spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..6aa8f6d2ab0a501d3744b6d361c94e3bd76a0f4a
--- /dev/null
+++ b//tmp/audit-work/candidate-src/audit-spec-vacuity.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(list(VS:ValSeq), Name("number"), dtdLoopBody)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+      1 |-> scope(
+        "lst" |-> list(INPUT:ValSeq)
+        "number" |-> (OLD:Val => lastNumber(VS, OLD))
+        "result" |-> (S:Int => S +Int dtd(VS)),
+        parent(0))
+    </scopes>
+    requires numericVals(VS)
+
+  // Fresh audit mutation: false for the satisfying empty-list witness because
+  // the real result and dtd(.ValSeq) are 0, not 1.
+  claim [false-result-plus-one]:
+    <k>
+      Call(Name("double_the_difference"), (list(VS:ValSeq), .Exprs))
+      => dtd(VS) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVals(VS)
+endmodule
