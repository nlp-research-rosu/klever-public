+      Call(Name("double_the_difference"), (list(VS:ValSeq), .Exprs))
+      => dtd(VS) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), dtdBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVals(VS)
