    26	  rule numericVals(vCons(V:Val, VS:ValSeq))
    27	    => (isInt(V) orBool isFloat(V)) andBool numericVals(VS)
    28	
    29	  // Mathematical summary of the arbitrary remaining numeric suffix.
    30	  rule dtd(.ValSeq) => 0
    31	  rule dtd(vCons(I:Int, VS:ValSeq))
    32	    => oddIntSquare(I) +Int dtd(VS)
    33	  rule dtd(vCons(_F:Float, VS:ValSeq)) => dtd(VS)
    34	  rule dtd(vCons(_V:Val, VS:ValSeq)) => dtd(VS) [owise]
    35	  rule dtd(vCons(V:Val, VS:ValSeq))
    36	    => oddIntSquare(projectIntTotal(V)) +Int dtd(VS)
    37	    requires isInt(V)
    38	    [simplification]
    39	  rule dtd(vCons(V:Val, VS:ValSeq)) => dtd(VS)
    40	    requires isFloat(V)
    41	    [simplification]
    42	
    43	  rule oddIntSquare(I:Int)
    44	    => #if I >Int 0 andBool pyMod(I, 2) ==Int 1
    45	       #then I *Int I
    46	       #else 0
    47	       #fi
    48	
    49	  // Exact final loop-target value.  It is local and later deallocated, but
    50	  // retaining it makes the circularity describe the entire function scope.
    51	  rule lastNumber(.ValSeq, OLD:Val) => OLD
    52	  rule lastNumber(vCons(V:Val, VS:ValSeq), _OLD:Val)
    53	    => lastNumber(VS, V)
    54	
    55	  // Guarded dynamic-to-static refinement.  These equations are exact twins of
    56	  // isIntV and the corresponding fixed MPY-INT dispatch equations.
    57	  rule definedProjectInt(V:Val) => isInt(V)
    58	  rule #Ceil({@V:Val}:>Int)
    59	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    60	    [simplification]
    61	  rule projectIntTotal(V:Val) => {V}:>Int
    62	    requires definedProjectInt(V)
    63	    [concrete, simplification(10), preserves-definedness]
    64	  rule {V:Val}:>Int => projectIntTotal(V)
    65	    requires definedProjectInt(V)
    66	    [symbolic(V), simplification, preserves-definedness]
    67	  rule projectIntTotal(I:Int) => I [simplification]
    68	  rule projectIntTotal(projectIntTotal(V:Val))
    69	    => projectIntTotal(V)
    70	    [simplification]
    71	  rule isIntV(V:Val) => isInt(V) [simplification]
    72	  rule applyCmp(">", V:Val, I:Int)
    73	    => projectIntTotal(V) >Int I
    74	    requires isInt(V)
    75	    [simplification]
    76	  rule applyBin("%", V:Val, I:Int)
    77	    => pyMod(projectIntTotal(V), I)
    78	    requires isInt(V)
    79	    [simplification]
    80	  rule applyBin("*", V1:Val, V2:Val)
    81	    => projectIntTotal(V1) *Int projectIntTotal(V2)
    82	    requires isInt(V1) andBool isInt(V2)
    83	    [simplification]
    84	
    85	  rule dtdLoopBody
    86	    => If(Call(Name("isinstance"),
    87	               (Name("number"), Name("int"), .Exprs)),
    88	         If(Compare(Name("number"), CmpOp(">", Int(0))),
    89	           If(Compare(BinOp("%", Name("number"), Int(2)),
    90	                      CmpOp("==", Int(1))),
    91	             AugAssign(Name("result"), "+",
    92	                       BinOp("*", Name("number"), Name("number"))),
    93	             .Stmts),
    94	           .Stmts),
    95	         .Stmts)
    96	
    97	  rule dtdBody
    98	    => Assign(Name("result"), Int(0))
    99	       Assign(Name("number"), Int(0))
   100	       For(Name("number"), Name("lst"), dtdLoopBody)
   101	       Return(Name("result"))
   102	endmodule
