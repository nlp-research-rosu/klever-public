dirs=sorted(p for p in root.rglob('*') if p.is_dir())
paths_options={
 'files':files,
 'all':sorted(files+dirs),
}
path_forms={
 'rel':lambda p:p.relative_to(root).as_posix().encode(),
 'dotrel':lambda p:('./'+p.relative_to(root).as_posix()).encode(),
 'rootrel':lambda p:('reference-semantics/'+p.relative_to(root).as_posix()).encode(),
}
seps={'none':b'','nul':b'\\0','nl':b'\\n','space':b' ','2space':b'  ','colon':b':'}
contents={
 'bytes':lambda p:p.read_bytes() if p.is_file() else b'',
 'rawhash':lambda p:hashlib.sha256(p.read_bytes()).digest() if p.is_file() else b'',
 'hexhash':lambda p:hashlib.sha256(p.read_bytes()).hexdigest().encode() if p.is_file() else b'',
 'typebytes':lambda p:(b'f'+p.read_bytes()) if p.is_file() else b'd',
 'typehash':lambda p:(b'f'+hashlib.sha256(p.read_bytes()).digest()) if p.is_file() else b'd',
 'typehex':lambda p:(b'f'+hashlib.sha256(p.read_bytes()).hexdigest().encode()) if p.is_file() else b'd',
}
