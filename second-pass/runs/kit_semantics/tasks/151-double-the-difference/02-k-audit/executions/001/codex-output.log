diff --git a//tmp/audit-work/candidate-src/audit-body-mutation.k b//tmp/audit-work/candidate-src/audit-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..cdc263161e7b7fbdb534a9570d411db0332e9fe2
--- /dev/null
+++ b//tmp/audit-work/candidate-src/audit-body-mutation.k
@@ -0,0 +1,55 @@
+requires "verification.k"
+
+module AUDIT-BODY-MUTATION-SYNTAX
+  imports VERIFICATION-SYNTAX
+
+  syntax Stmts ::= "auditMutatedLoopBody" [macro]
+                 | "auditMutatedBody" [macro]
+endmodule
+
+module AUDIT-BODY-MUTATION
+  imports VERIFICATION
+  imports AUDIT-BODY-MUTATION-SYNTAX
+
+  // Material mutation: replace number * number by number + number.
+  rule auditMutatedLoopBody
+    => If(Call(Name("isinstance"),
+               (Name("number"), Name("int"), .Exprs)),
+         If(Compare(Name("number"), CmpOp(">", Int(0))),
+           If(Compare(BinOp("%", Name("number"), Int(2)),
+                      CmpOp("==", Int(1))),
+             AugAssign(Name("result"), "+",
+                       BinOp("+", Name("number"), Name("number"))),
+             .Stmts),
+           .Stmts),
+         .Stmts)
+
+  rule auditMutatedBody
+    => Assign(Name("result"), Int(0))
+       Assign(Name("number"), Int(0))
+       For(Name("number"), Name("lst"), auditMutatedLoopBody)
+       Return(Name("result"))
+
+  // Original body returns 1 on [1]; the mutated body returns 2.
+  claim [changed-body-rejects-original-result]:
+    <k>
+      Call(Name("double_the_difference"),
+           (list(vCons(1, .ValSeq)), .Exprs))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(("lst", .ParamNames), auditMutatedBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
