     h=hashlib.sha256()
     for p in paths:
      h.update(pf(p)); h.update(s1); h.update(cf(p)); h.update(s2)
     if h.hexdigest()==expected: found.append((pn,pfn,s1n,cn,s2n))
print('found',found)
