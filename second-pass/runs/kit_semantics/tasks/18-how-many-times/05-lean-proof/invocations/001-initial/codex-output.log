--- /dev/null
+++ b//tmp/lean-pidshim.c
@@ -0,0 +1,14 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length <= 0) {
+    return 1;
+  }
+  target[length] = '\0';
+  return (pid_t)strtol(target, NULL, 10);
+}
