diff --git a//tmp/lean-pidshim.c b//tmp/lean-pidshim.c
new file mode 100644
index 0000000000000000000000000000000000000000..e3bd72e2b2823df2378f96faf4def24b39d9df27
--- /dev/null
+++ b//tmp/lean-pidshim.c
@@ -0,0 +1,14 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length <= 0) {
+    return 1;
+  }
+  target[length] = '\0';
+  return (pid_t)strtol(target, NULL, 10);
+}
