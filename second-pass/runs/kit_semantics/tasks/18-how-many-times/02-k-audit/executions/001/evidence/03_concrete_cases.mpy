Module(
  FuncDef("how_many_times", Params("string", "substring"),
    If(Compare(Name("substring"), CmpOp("==", Str(""))),
      Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
      )
    Assign(Name("count"), Int(0))
    While(Compare(Name("string"), CmpOp("!=", Str(""))),
      If(Call(Attribute(Name("string"), "startswith"), Name("substring")),
        AugAssign(Name("count"), "+", Int(1)),
        )
      Assign(
        Name("string"),
        Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
    Return(Name("count")))
  Assign(
    Name("case_empty_nonempty"),
    Call(Name("how_many_times"), Str(""), Str("a")))
  Assign(
    Name("case_empty_empty"),
    Call(Name("how_many_times"), Str(""), Str("")))
  Assign(
    Name("case_single"),
    Call(Name("how_many_times"), Str("a"), Str("a")))
  Assign(
    Name("case_pattern_longer"),
    Call(Name("how_many_times"), Str("a"), Str("aa")))
  Assign(
    Name("case_prompt_single"),
    Call(Name("how_many_times"), Str("aaa"), Str("a")))
  Assign(
    Name("case_prompt_overlap"),
    Call(Name("how_many_times"), Str("aaaa"), Str("aa")))
  Assign(
    Name("case_overlap_three"),
    Call(Name("how_many_times"), Str("aaaaa"), Str("aaa")))
  Assign(
    Name("case_shifted_overlap"),
    Call(Name("how_many_times"), Str("ababa"), Str("aba")))
  Assign(
    Name("case_no_match"),
    Call(Name("how_many_times"), Str("abc"), Str("z")))
  Assign(
    Name("case_empty_pattern"),
    Call(Name("how_many_times"), Str("abc"), Str(""))))
