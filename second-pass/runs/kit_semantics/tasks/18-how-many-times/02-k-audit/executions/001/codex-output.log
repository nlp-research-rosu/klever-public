     6	  // Mathematical count of overlapping occurrences.  The empty pattern occurs
     7	  // at every boundary; a nonempty pattern is tested at every successive suffix.
     8	  syntax Int ::= overlapCount(IntSeq, IntSeq) [function, total]
     9	  syntax IntSeq ::= tailIS(IntSeq) [function, total]
    10	
    11	  rule tailIS(.IntSeq) => .IntSeq
    12	  rule tailIS(iCons(_:Int, CS:IntSeq)) => CS
    13	
    14	  rule overlapCount(S:IntSeq, P:IntSeq)
    15	    => isLen(S) +Int 1
    16	    requires P ==K .IntSeq
    17	
    18	  rule overlapCount(.IntSeq, P:IntSeq)
    19	    => 0
    20	    requires notBool (P ==K .IntSeq)
    21	
    22	  rule overlapCount(S:IntSeq, P:IntSeq)
    23	    => (#if startsWith(P, S)
    24	        #then 1 #else 0 #fi)
    25	       +Int overlapCount(tailIS(S), P)
    26	    requires notBool (S ==K .IntSeq)
    27	     andBool notBool (P ==K .IntSeq)
    28	
    29	  // Derived slice lemma: taking [1:] of a nonempty code sequence yields its
    30	  // tail.  This is an induction consequence of buildIS/intSeqAt/isLen.
    31	  rule buildIS(
    32	         S:IntSeq,
    33	         clampHi(1, isLen(S), 1),
    34	         isLen(S),
