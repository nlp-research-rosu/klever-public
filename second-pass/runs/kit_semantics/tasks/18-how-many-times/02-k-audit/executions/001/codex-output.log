[reference-semantics/semantics/list.k:3-6] kind=module attributes=ordinary
module MPY-LIST
  imports MPY-CORE
  imports MPY-ITER
  imports MPY-OPERATORS

[reference-semantics/semantics/list.k:9-9] kind=rule attributes=ordinary
  rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>

[reference-semantics/semantics/list.k:10-10] kind=rule attributes=ordinary
  rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>

[reference-semantics/semantics/list.k:13-13] kind=syntax attributes=ordinary
  syntax ApplyK ::= "toList"

[reference-semantics/semantics/list.k:14-14] kind=rule attributes=ordinary
  rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>

[reference-semantics/semantics/list.k:15-15] kind=rule attributes=ordinary
  rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>

[reference-semantics/semantics/list.k:18-18] kind=syntax attributes=function,total
  syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]

[reference-semantics/semantics/list.k:19-19] kind=rule attributes=ordinary
  rule valSeqConcat(.ValSeq, T:ValSeq)                => T

[reference-semantics/semantics/list.k:20-20] kind=rule attributes=ordinary
  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))

[reference-semantics/semantics/list.k:24-25] kind=rule attributes=priority
  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
       [priority(45)]

[reference-semantics/semantics/list.k:27-27] kind=rule attributes=ordinary
  rule applyCmp("==", list(A:ValSeq), list(B:ValSeq)) => A ==K B

[reference-semantics/semantics/list.k:28-28] kind=rule attributes=ordinary
  rule applyCmp("!=", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)

[reference-semantics/semantics/list.k:33-33] kind=syntax attributes=function,total
  syntax Bool ::= hasRefVS(ValSeq) [function, total]

[reference-semantics/semantics/list.k:34-34] kind=rule attributes=ordinary
  rule hasRefVS(.ValSeq)                => false

[reference-semantics/semantics/list.k:35-35] kind=rule attributes=ordinary
  rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)

[reference-semantics/semantics/list.k:37-38] kind=syntax attributes=function
  syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]
                | deepEqV(Val, Val, Map)        [function]

[reference-semantics/semantics/list.k:39-39] kind=rule attributes=ordinary
  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true

[reference-semantics/semantics/list.k:40-40] kind=rule attributes=ordinary
  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false

[reference-semantics/semantics/list.k:41-41] kind=rule attributes=ordinary
  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false

[reference-semantics/semantics/list.k:42-43] kind=rule attributes=ordinary
  rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)
    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)

[reference-semantics/semantics/list.k:45-46] kind=rule attributes=ordinary
  rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)
       requires H in_keys(HP)

[reference-semantics/semantics/list.k:47-48] kind=rule attributes=ordinary
  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
       requires notBool isRefV(A) andBool H in_keys(HP)

[reference-semantics/semantics/list.k:49-49] kind=rule attributes=ordinary
  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)

[reference-semantics/semantics/list.k:50-50] kind=rule attributes=owise
  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]

[reference-semantics/semantics/list.k:53-55] kind=rule attributes=priority
  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
       [priority(40)]

[reference-semantics/semantics/list.k:58-58] kind=syntax attributes=ordinary
  syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | "#notB"

[reference-semantics/semantics/list.k:59-59] kind=rule attributes=ordinary
  rule <k> Compare(LV:Val, CmpOp("in",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>

[reference-semantics/semantics/list.k:60-60] kind=rule attributes=ordinary
  rule <k> Compare(LV:Val, CmpOp("not in", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>

[reference-semantics/semantics/list.k:61-61] kind=rule attributes=ordinary
  rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>

[reference-semantics/semantics/list.k:62-62] kind=rule attributes=ordinary
  rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>

[reference-semantics/semantics/list.k:63-64] kind=rule attributes=ordinary
  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
       requires E ==K V

[reference-semantics/semantics/list.k:65-66] kind=rule attributes=ordinary
  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
       requires notBool (E ==K V)

[reference-semantics/semantics/list.k:67-67] kind=rule attributes=ordinary
  rule <k> B:Bool ~> #notB => notBool B ... </k>

[reference-semantics/semantics/list.k:68-68] kind=endmodule attributes=ordinary
endmodule

FILE reference-semantics/semantics/methods.k
