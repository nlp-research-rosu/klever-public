[reference-semantics/semantics/str.k:14-14] kind=rule attributes=ordinary
  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>

[reference-semantics/semantics/str.k:15-15] kind=rule attributes=ordinary
  rule strToCodes("") => .IntSeq

[reference-semantics/semantics/str.k:16-17] kind=rule attributes=ordinary
  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128

[reference-semantics/semantics/str.k:20-20] kind=syntax attributes=function,total
  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]

[reference-semantics/semantics/str.k:21-21] kind=rule attributes=ordinary
  rule seqConcat(.IntSeq, T:IntSeq)                => T

[reference-semantics/semantics/str.k:22-22] kind=rule attributes=ordinary
  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))

[reference-semantics/semantics/str.k:24-24] kind=rule attributes=ordinary
  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))

[reference-semantics/semantics/str.k:25-25] kind=rule attributes=ordinary
  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B

[reference-semantics/semantics/str.k:26-26] kind=rule attributes=ordinary
  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)

[reference-semantics/semantics/str.k:29-29] kind=rule attributes=ordinary
  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)

[reference-semantics/semantics/str.k:30-30] kind=rule attributes=ordinary
  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)

[reference-semantics/semantics/str.k:32-32] kind=syntax attributes=function,total
  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]

[reference-semantics/semantics/str.k:33-33] kind=rule attributes=ordinary
  rule strPrefix(.IntSeq, _:IntSeq)               => true

[reference-semantics/semantics/str.k:34-34] kind=rule attributes=ordinary
  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false

[reference-semantics/semantics/str.k:35-35] kind=rule attributes=ordinary
  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)

[reference-semantics/semantics/str.k:37-37] kind=syntax attributes=function,total
  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]

[reference-semantics/semantics/str.k:38-38] kind=rule attributes=ordinary
  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)

[reference-semantics/semantics/str.k:39-39] kind=rule attributes=ordinary
  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)

[reference-semantics/semantics/str.k:40-41] kind=rule attributes=ordinary
  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
       requires notBool strPrefix(P, iCons(C, Xs))

[reference-semantics/semantics/str.k:48-48] kind=syntax attributes=function,total
  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]

[reference-semantics/semantics/str.k:49-49] kind=rule attributes=ordinary
  rule strLt(.IntSeq, .IntSeq)                => false

[reference-semantics/semantics/str.k:50-50] kind=rule attributes=ordinary
  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true

[reference-semantics/semantics/str.k:51-51] kind=rule attributes=ordinary
  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false

[reference-semantics/semantics/str.k:52-52] kind=rule attributes=ordinary
  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B

[reference-semantics/semantics/str.k:53-53] kind=rule attributes=ordinary
  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B

[reference-semantics/semantics/str.k:54-54] kind=rule attributes=ordinary
  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B

[reference-semantics/semantics/str.k:56-56] kind=rule attributes=ordinary
  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)

[reference-semantics/semantics/str.k:57-57] kind=rule attributes=ordinary
  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)

[reference-semantics/semantics/str.k:58-58] kind=rule attributes=ordinary
  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)

[reference-semantics/semantics/str.k:59-59] kind=rule attributes=ordinary
  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)

[reference-semantics/semantics/str.k:60-60] kind=endmodule attributes=ordinary
endmodule

FILE reference-semantics/semantics/subscript.k
COUNTS context=2 endmodule=1 module=1 rule=40 syntax=15

[reference-semantics/semantics/subscript.k:3-4] kind=module attributes=ordinary
module MPY-SUBSCRIPT
  imports MPY-CORE

[reference-semantics/semantics/subscript.k:11-11] kind=syntax attributes=function,total
  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]

[reference-semantics/semantics/subscript.k:12-12] kind=rule attributes=ordinary
  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V

[reference-semantics/semantics/subscript.k:13-14] kind=rule attributes=ordinary
  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
       requires I >Int 0

[reference-semantics/semantics/subscript.k:16-16] kind=syntax attributes=function
  syntax Int ::= intSeqAt(IntSeq, Int) [function]

[reference-semantics/semantics/subscript.k:17-17] kind=rule attributes=ordinary
  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C

[reference-semantics/semantics/subscript.k:18-19] kind=rule attributes=ordinary
  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
       requires I >Int 0

[reference-semantics/semantics/subscript.k:21-21] kind=syntax attributes=function,total
  syntax Int ::= normIdx(Int, Int) [function, total]

[reference-semantics/semantics/subscript.k:22-22] kind=rule attributes=ordinary
  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0

[reference-semantics/semantics/subscript.k:23-23] kind=rule attributes=ordinary
  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0

[reference-semantics/semantics/subscript.k:27-27] kind=context attributes=ordinary
  context Subscript(HOLE, _)

[reference-semantics/semantics/subscript.k:28-28] kind=context attributes=ordinary
  context Subscript(_:Val, HOLE:Expr)

[reference-semantics/semantics/subscript.k:31-33] kind=rule attributes=priority
  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]

[reference-semantics/semantics/subscript.k:35-35] kind=rule attributes=ordinary
  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>

[reference-semantics/semantics/subscript.k:37-37] kind=syntax attributes=function
  syntax Val ::= applyIndex(Val, Int) [function]

[reference-semantics/semantics/subscript.k:38-38] kind=rule attributes=ordinary
  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))

[reference-semantics/semantics/subscript.k:39-39] kind=rule attributes=ordinary
  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))

[reference-semantics/semantics/subscript.k:40-41] kind=rule attributes=ordinary
  rule applyIndex(str(IS:IntSeq),   I:Int)
    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))

[reference-semantics/semantics/subscript.k:44-47] kind=syntax attributes=ordinary
  syntax KItem ::= #evalB(Bound) | "#toSome"
                 | #slLo(Val, Bound, Bound)
                 | #slHi(Val, OptInt, Bound)
                 | #slStep(Val, OptInt, OptInt)

[reference-semantics/semantics/subscript.k:49-49] kind=syntax attributes=ordinary
  syntax OptInt ::= "noB" | someB(Int)

[reference-semantics/semantics/subscript.k:50-50] kind=rule attributes=ordinary
  rule <k> #evalB(NoBound)  => noB ... </k>

[reference-semantics/semantics/subscript.k:51-51] kind=rule attributes=ordinary
  rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>

[reference-semantics/semantics/subscript.k:52-52] kind=rule attributes=ordinary
  rule <k> I:Int ~> #toSome => someB(I) ... </k>

[reference-semantics/semantics/subscript.k:54-54] kind=rule attributes=ordinary
  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>

[reference-semantics/semantics/subscript.k:55-55] kind=rule attributes=ordinary
  rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>

[reference-semantics/semantics/subscript.k:56-56] kind=rule attributes=ordinary
  rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>

[reference-semantics/semantics/subscript.k:58-60] kind=rule attributes=priority
  rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)
        => #alloc(doSlice(list(VS), LO, HI, ST)) ... </k>
       [priority(45)]

[reference-semantics/semantics/subscript.k:61-61] kind=rule attributes=ordinary
  rule <k> ST:OptInt ~> #slStep(OBJ:Val, LO:OptInt, HI:OptInt) => doSlice(OBJ, LO, HI, ST) ... </k>

[reference-semantics/semantics/subscript.k:63-63] kind=syntax attributes=function
  syntax Val ::= doSlice(Val, OptInt, OptInt, OptInt) [function]

[reference-semantics/semantics/subscript.k:64-65] kind=rule attributes=ordinary
  rule doSlice(list(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => list(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))

[reference-semantics/semantics/subscript.k:66-67] kind=rule attributes=ordinary
  rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))

[reference-semantics/semantics/subscript.k:68-69] kind=rule attributes=ordinary
  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))

[reference-semantics/semantics/subscript.k:72-72] kind=syntax attributes=function,total
  syntax Int ::= slStep(OptInt) [function, total]

[reference-semantics/semantics/subscript.k:73-73] kind=rule attributes=ordinary
  rule slStep(noB)          => 1

[reference-semantics/semantics/subscript.k:74-74] kind=rule attributes=ordinary
  rule slStep(someB(S:Int)) => S

[reference-semantics/semantics/subscript.k:76-76] kind=syntax attributes=function
  syntax Int ::= slStart(OptInt, OptInt, Int) [function]

[reference-semantics/semantics/subscript.k:77-78] kind=rule attributes=ordinary
  rule slStart(noB,          ST:OptInt, _LEN:Int) => 0
       requires slStep(ST) >Int 0

[reference-semantics/semantics/subscript.k:79-80] kind=rule attributes=ordinary
  rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1
       requires slStep(ST) <Int 0

[reference-semantics/semantics/subscript.k:81-81] kind=rule attributes=ordinary
  rule slStart(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))

[reference-semantics/semantics/subscript.k:83-83] kind=syntax attributes=function
  syntax Int ::= slStop(OptInt, OptInt, Int) [function]

[reference-semantics/semantics/subscript.k:84-85] kind=rule attributes=ordinary
  rule slStop(noB,          ST:OptInt, LEN:Int)  => LEN
       requires slStep(ST) >Int 0

[reference-semantics/semantics/subscript.k:86-87] kind=rule attributes=ordinary
  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
       requires slStep(ST) <Int 0

[reference-semantics/semantics/subscript.k:88-88] kind=rule attributes=ordinary
  rule slStop(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))

[reference-semantics/semantics/subscript.k:90-90] kind=syntax attributes=function,total
  syntax Int ::= slAdjust(Int, Int, Int) [function, total]

[reference-semantics/semantics/subscript.k:91-92] kind=rule attributes=ordinary
  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampLo(I +Int LEN, STEP)
       requires I  <Int 0

[reference-semantics/semantics/subscript.k:93-94] kind=rule attributes=ordinary
  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampHi(I, LEN, STEP)
       requires I >=Int 0

[reference-semantics/semantics/subscript.k:96-96] kind=syntax attributes=function,total
  syntax Int ::= clampLo(Int, Int) [function, total]

[reference-semantics/semantics/subscript.k:97-98] kind=rule attributes=ordinary
  rule clampLo(J:Int, _STEP:Int) => J
       requires J >=Int 0

[reference-semantics/semantics/subscript.k:99-100] kind=rule attributes=ordinary
  rule clampLo(J:Int, STEP:Int)  => #if STEP <Int 0 #then -1 #else 0 #fi
       requires J <Int 0

[reference-semantics/semantics/subscript.k:102-102] kind=syntax attributes=function,total
  syntax Int ::= clampHi(Int, Int, Int) [function, total]

[reference-semantics/semantics/subscript.k:103-104] kind=rule attributes=ordinary
  rule clampHi(I:Int, LEN:Int, _STEP:Int) => I
       requires I  <Int LEN

[reference-semantics/semantics/subscript.k:105-106] kind=rule attributes=ordinary
  rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi
       requires I >=Int LEN

[reference-semantics/semantics/subscript.k:109-109] kind=syntax attributes=function
  syntax ValSeq ::= buildVS(ValSeq, Int, Int, Int) [function]

[reference-semantics/semantics/subscript.k:110-112] kind=rule attributes=ordinary
  rule buildVS(VS:ValSeq, I:Int, STOP:Int, STEP:Int)
    => vCons(valSeqAt(VS, I), buildVS(VS, I +Int STEP, STOP, STEP))
       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)

[reference-semantics/semantics/subscript.k:113-114] kind=rule attributes=ordinary
  rule buildVS(_:ValSeq, I:Int, STOP:Int, STEP:Int) => .ValSeq
       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))

[reference-semantics/semantics/subscript.k:116-116] kind=syntax attributes=function
  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]

[reference-semantics/semantics/subscript.k:117-119] kind=rule attributes=ordinary
  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)

[reference-semantics/semantics/subscript.k:120-121] kind=rule attributes=ordinary
  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))

[reference-semantics/semantics/subscript.k:122-122] kind=endmodule attributes=ordinary
endmodule

FILE reference-semantics/semantics/syntax.k
COUNTS endmodule=1 module=1 syntax=16

[reference-semantics/semantics/syntax.k:3-7] kind=module attributes=ordinary
module MPY-SYNTAX
  imports INT-SYNTAX
  imports FLOAT-SYNTAX
  imports BOOL-SYNTAX
  imports STRING-SYNTAX

[reference-semantics/semantics/syntax.k:9-30] kind=syntax attributes=macro,strict,seqstrict
  syntax Expr ::= "Int"      "(" Int ")"
                | "Float"    "(" Float ")"
                | "Bool"     "(" Bool ")"
                | "Name"     "(" String ")"
                | "Str"      "(" String ")"
                | "UnaryOp"  "(" String "," Expr ")" [strict(2)]
                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
                | "BoolOp"    "(" String "," Exprs ")"
                | "ListExpr"  "(" Exprs ")"
                | "DictExpr"  "(" Entries ")"
                | "ListComp"  "(" Expr "," CompFors ")" [macro]
                | "GenExp"    "(" Expr "," CompFors ")" [macro]
                | "TupleExpr" "(" Exprs ")"
                | "Subscript" "(" Expr "," Index ")"
                | "IfExp"     "(" Expr "," Expr "," Expr ")" [strict(1)]
                | "Lambda"    "(" Params "," Expr ")"
                | "KwArg"     "(" String "," Expr ")"
                | "Lambda"    "(" Params "," CellVars "," FreeVars "," Expr ")"
                | "NoneVal"
                | "Call"      "(" Expr "," Exprs ")"
                | "Attribute" "(" Expr "," String ")" [strict(1)]
                | "Compare"   "(" Expr "," CmpOp ")"

[reference-semantics/semantics/syntax.k:32-32] kind=syntax attributes=ordinary
  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"

[reference-semantics/semantics/syntax.k:33-33] kind=syntax attributes=ordinary
  syntax Entry    ::= "Entry" "(" Expr "," Expr ")"

[reference-semantics/semantics/syntax.k:34-34] kind=syntax attributes=ordinary
  syntax Entries  ::= List{Entry, ","}

[reference-semantics/semantics/syntax.k:35-35] kind=syntax attributes=ordinary
  syntax CompFor  ::= "CompFor" "(" Expr "," Expr "," Exprs ")"

[reference-semantics/semantics/syntax.k:36-36] kind=syntax attributes=ordinary
  syntax CompFors ::= List{CompFor, ""}

[reference-semantics/semantics/syntax.k:37-37] kind=syntax attributes=ordinary
  syntax Exprs    ::= List{Expr, ","}

[reference-semantics/semantics/syntax.k:38-38] kind=syntax attributes=ordinary
  syntax Index    ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"

[reference-semantics/semantics/syntax.k:39-39] kind=syntax attributes=ordinary
  syntax Bound    ::= Expr | "NoBound"

[reference-semantics/semantics/syntax.k:41-54] kind=syntax attributes=strict
  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
                | "Import"    "(" String ")"
                | "ImportFrom" "(" String "," ParamNames ")"
                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
                | "While"     "(" Expr "," Stmts ")"
                | "Break"
                | "Continue"
                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
                | "Return"    "(" Expr ")" [strict]
                | "Assert"    "(" Expr ")" [strict]
                | "Expr"      "(" Expr ")" [strict]
                | "FuncDef"   "(" String "," Params "," Stmts ")"
                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"

[reference-semantics/semantics/syntax.k:56-56] kind=syntax attributes=ordinary
  syntax Stmts      ::= List{Stmt, ""}

[reference-semantics/semantics/syntax.k:57-57] kind=syntax attributes=ordinary
  syntax Params     ::= "Params" "(" ParamNames ")"

[reference-semantics/semantics/syntax.k:58-58] kind=syntax attributes=ordinary
  syntax CellVars   ::= "CellVars" "(" ParamNames ")"

[reference-semantics/semantics/syntax.k:59-59] kind=syntax attributes=ordinary
  syntax FreeVars   ::= "FreeVars" "(" ParamNames ")"

[reference-semantics/semantics/syntax.k:60-60] kind=syntax attributes=ordinary
  syntax ParamNames ::= List{String, ","}

[reference-semantics/semantics/syntax.k:61-61] kind=syntax attributes=ordinary
  syntax Module     ::= "Module" "(" Stmts ")"

[reference-semantics/semantics/syntax.k:62-62] kind=endmodule attributes=ordinary
endmodule

FILE reference-semantics/semantics/tuple.k
