       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0

[reference-semantics/semantics/methods.k:39-40] kind=rule attributes=ordinary
  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0

[reference-semantics/semantics/methods.k:41-41] kind=syntax attributes=function,total
  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]

[reference-semantics/semantics/methods.k:42-42] kind=rule attributes=ordinary
  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0

[reference-semantics/semantics/methods.k:43-43] kind=rule attributes=owise
  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]

[reference-semantics/semantics/methods.k:44-44] kind=rule attributes=ordinary
  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0

[reference-semantics/semantics/methods.k:47-47] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))

[reference-semantics/semantics/methods.k:48-48] kind=syntax attributes=function,total
  syntax IntSeq ::= trimWS(IntSeq) [function, total]

[reference-semantics/semantics/methods.k:49-49] kind=rule attributes=ordinary
  rule trimWS(.IntSeq) => .IntSeq

[reference-semantics/semantics/methods.k:50-50] kind=rule attributes=ordinary
  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)

[reference-semantics/semantics/methods.k:51-51] kind=rule attributes=ordinary
  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)

[reference-semantics/semantics/methods.k:52-52] kind=syntax attributes=function,total
  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]

[reference-semantics/semantics/methods.k:53-53] kind=rule attributes=ordinary
