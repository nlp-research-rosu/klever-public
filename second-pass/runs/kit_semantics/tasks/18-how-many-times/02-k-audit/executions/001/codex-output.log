[reference-semantics/semantics/methods.k:55-55] kind=rule attributes=ordinary
  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))

[reference-semantics/semantics/methods.k:58-58] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)

[reference-semantics/semantics/methods.k:61-61] kind=rule attributes=ordinary
  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)

[reference-semantics/semantics/methods.k:64-64] kind=rule attributes=ordinary
  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)

[reference-semantics/semantics/methods.k:65-65] kind=syntax attributes=function,total
  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]

[reference-semantics/semantics/methods.k:66-66] kind=rule attributes=ordinary
  rule cntOccVS(.ValSeq, _:Val)                => 0

[reference-semantics/semantics/methods.k:67-67] kind=rule attributes=ordinary
  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V

[reference-semantics/semantics/methods.k:68-68] kind=rule attributes=ordinary
  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)

[reference-semantics/semantics/methods.k:72-74] kind=rule attributes=priority
  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
       [priority(40)]

[reference-semantics/semantics/methods.k:75-75] kind=syntax attributes=function
  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result

[reference-semantics/semantics/methods.k:76-76] kind=rule attributes=ordinary
