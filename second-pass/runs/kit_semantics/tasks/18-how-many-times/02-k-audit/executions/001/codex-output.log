+cp /audit-output/evidence/05_slice_ground_bad.k audit-slice-ground-bad.k
+
+printf '%s\n' \
+  'COMMAND: kprove audit-slice-ground-good.k --definition audit-lemma-kompiled --spec-module AUDIT-SLICE-GROUND-GOOD'
