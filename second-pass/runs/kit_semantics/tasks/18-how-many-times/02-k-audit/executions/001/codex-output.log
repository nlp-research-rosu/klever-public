[reference-semantics/semantics/tuple.k:3-7] kind=module attributes=ordinary
module MPY-TUPLE
  imports MPY-CORE
  imports MPY-ITER
  imports MPY-LIST
  imports MPY-METHODS

[reference-semantics/semantics/tuple.k:10-10] kind=rule attributes=ordinary
  rule <k> #iterNext(tuple(.ValSeq))                => #iterDone ... </k>

[reference-semantics/semantics/tuple.k:11-11] kind=rule attributes=ordinary
  rule <k> #iterNext(tuple(vCons(V:Val, R:ValSeq))) => #iterYield(V, tuple(R)) ... </k>

[reference-semantics/semantics/tuple.k:14-14] kind=syntax attributes=ordinary
  syntax ApplyK ::= "toTuple"

[reference-semantics/semantics/tuple.k:15-15] kind=rule attributes=ordinary
