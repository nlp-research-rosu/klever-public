module MPY-INT
  imports MPY-CORE

[reference-semantics/semantics/int.k:7-7] kind=rule attributes=ordinary
  rule applyUn("-", I:Int) => 0 -Int I

[reference-semantics/semantics/int.k:9-9] kind=rule attributes=ordinary
  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2

[reference-semantics/semantics/int.k:11-11] kind=rule attributes=ordinary
  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi

[reference-semantics/semantics/int.k:12-12] kind=rule attributes=ordinary
  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I

[reference-semantics/semantics/int.k:13-13] kind=rule attributes=ordinary
  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2

[reference-semantics/semantics/int.k:14-14] kind=rule attributes=ordinary
  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2

[reference-semantics/semantics/int.k:15-15] kind=rule attributes=ordinary
  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)

[reference-semantics/semantics/int.k:16-16] kind=rule attributes=ordinary
  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2

[reference-semantics/semantics/int.k:17-17] kind=rule attributes=ordinary
  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0

[reference-semantics/semantics/int.k:19-19] kind=syntax attributes=function
  syntax Int ::= pyMod(Int, Int) [function]

[reference-semantics/semantics/int.k:20-20] kind=rule attributes=ordinary
  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2

[reference-semantics/semantics/int.k:22-22] kind=rule attributes=ordinary
  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2

[reference-semantics/semantics/int.k:23-23] kind=rule attributes=ordinary
  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2

[reference-semantics/semantics/int.k:24-24] kind=rule attributes=ordinary
  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2

[reference-semantics/semantics/int.k:25-25] kind=rule attributes=ordinary
  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2

[reference-semantics/semantics/int.k:26-26] kind=rule attributes=ordinary
  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2

[reference-semantics/semantics/int.k:27-27] kind=rule attributes=ordinary
  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2

[reference-semantics/semantics/int.k:28-28] kind=endmodule attributes=ordinary
endmodule

