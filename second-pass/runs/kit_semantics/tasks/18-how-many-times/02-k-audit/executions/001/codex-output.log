[reference-semantics/semantics/methods.k:3-7] kind=module attributes=ordinary
module MPY-METHODS
  imports MPY-CORE
  imports K-EQUAL
  imports MPY-STR
  imports MPY-LIST

[reference-semantics/semantics/methods.k:10-10] kind=syntax attributes=function
  syntax Val ::= applyMethod(Val, String, Vals) [function]

[reference-semantics/semantics/methods.k:13-13] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "isupper", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)

[reference-semantics/semantics/methods.k:14-14] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "islower", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)

[reference-semantics/semantics/methods.k:15-15] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "isalpha", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)

[reference-semantics/semantics/methods.k:16-16] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "isdigit", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)

[reference-semantics/semantics/methods.k:19-19] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "lower",    .Vals) => str(mapLower(CS))

[reference-semantics/semantics/methods.k:20-20] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "upper",    .Vals) => str(mapUpper(CS))

[reference-semantics/semantics/methods.k:21-21] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "swapcase", .Vals) => str(mapSwap(CS))

[reference-semantics/semantics/methods.k:26-26] kind=rule attributes=ordinary
  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))

[reference-semantics/semantics/methods.k:27-27] kind=syntax attributes=function,total
  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]

[reference-semantics/semantics/methods.k:28-28] kind=rule attributes=ordinary
  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq

[reference-semantics/semantics/methods.k:29-29] kind=rule attributes=ordinary
  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS

[reference-semantics/semantics/methods.k:30-31] kind=rule attributes=ordinary
  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))

[reference-semantics/semantics/methods.k:34-34] kind=rule attributes=ordinary
  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)

[reference-semantics/semantics/methods.k:35-35] kind=syntax attributes=function
