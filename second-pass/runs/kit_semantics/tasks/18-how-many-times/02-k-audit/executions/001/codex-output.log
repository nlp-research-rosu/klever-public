  rule overlapCount(S:IntSeq, P:IntSeq)
    => isLen(S) +Int 1

[verification.k:16-16] kind=requires attributes=ordinary
    requires P ==K .IntSeq

[verification.k:18-19] kind=rule attributes=ordinary
  rule overlapCount(.IntSeq, P:IntSeq)
    => 0

[verification.k:20-20] kind=requires attributes=ordinary
    requires notBool (P ==K .IntSeq)

[verification.k:22-25] kind=rule attributes=ordinary
  rule overlapCount(S:IntSeq, P:IntSeq)
    => (#if startsWith(P, S)
        #then 1 #else 0 #fi)
       +Int overlapCount(tailIS(S), P)

