new file mode 100644
index 0000000000000000000000000000000000000000..ad2e824919d3347d1823d42ff9c86a7c5d498853
--- /dev/null
+++ b/evidence/05_inventory.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
