[reference-semantics/semantics/tuple.k:20-20] kind=rule attributes=ordinary
  rule <k> Compare(LV:Val, CmpOp("in",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>

[reference-semantics/semantics/tuple.k:21-21] kind=rule attributes=ordinary
  rule <k> Compare(LV:Val, CmpOp("not in", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>

[reference-semantics/semantics/tuple.k:23-23] kind=rule attributes=ordinary
  rule applyMethod(tuple(VS:ValSeq), "index", V:Val, .Vals) => idxOfVS(VS, V, 0)

[reference-semantics/semantics/tuple.k:24-24] kind=syntax attributes=function
  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]

[reference-semantics/semantics/tuple.k:25-25] kind=rule attributes=ordinary
  rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V

[reference-semantics/semantics/tuple.k:26-27] kind=rule attributes=ordinary
  rule idxOfVS(vCons(A:Val, R:ValSeq), V:Val, I:Int) => idxOfVS(R, V, I +Int 1)
       requires notBool (A ==K V)

[reference-semantics/semantics/tuple.k:28-28] kind=rule attributes=ordinary
  rule applyCmp("!=", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)

[reference-semantics/semantics/tuple.k:31-31] kind=syntax attributes=ordinary
  syntax KItem ::= #bindTgt(Expr, Val)

[reference-semantics/semantics/tuple.k:32-34] kind=rule attributes=ordinary
  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>

[reference-semantics/semantics/tuple.k:35-41] kind=rule attributes=priority
  rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
       requires "$cells" in_keys(M)
        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
