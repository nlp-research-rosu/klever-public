[reference-semantics/semantics/dict.k:76-76] kind=syntax attributes=ordinary
  syntax KItem ::= #dsetK(String, Val)

[reference-semantics/semantics/dict.k:77-77] kind=rule attributes=ordinary
  rule <k> Assign(Subscript(Name(X:String), K:Expr), VV:Val) => K ~> #dsetK(X, VV) ... </k>

[reference-semantics/semantics/dict.k:78-81] kind=rule attributes=ordinary
