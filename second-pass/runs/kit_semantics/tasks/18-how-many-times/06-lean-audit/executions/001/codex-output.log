@@ -0,0 +1,317 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+
+sys.path.insert(0, "/reference")
+
+from tools.klean_export import tree_digest
+from tools.pipeline_contract import sha256_tree
+
+
+def file_sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def check(label: str, condition: bool, detail: str = "") -> None:
+    suffix = f" :: {detail}" if detail else ""
+    print(f"{label}={'PASS' if condition else 'FAIL'}{suffix}")
+
+
+def main() -> int:
+    audit_input = json.loads(Path("/audit-input.json").read_text())
+    resolution = audit_input["resolution"]
+    hashes = resolution["hashes"]
+    generation = Path("/reference/klean-generation")
+    generated = generation / "generated"
+    producer = Path("/reference/generation-tools")
+    generator = json.loads((generation / "generator-manifest.json").read_text())
+    input_manifest = json.loads((generation / "input-manifest.json").read_text())
+    export_result = json.loads((generation / "export-result.json").read_text())
+    trust_inventory = json.loads((generation / "trust-inventory.json").read_text())
+    source_manifest = json.loads((producer / "source-manifest.json").read_text())
+    obligation_map = json.loads((generated / "obligation-map.json").read_text())
+    discovery = json.loads(Path("/reference/lemma-discovery.json").read_text())
+
+    print("RECORDED IMMUTABLE HASHES")
+    observed_hashes = {
+        "k_workspace_sha256": sha256_tree(Path("/reference/k-proof")),
+        "stage1_export_sha256": tree_digest(Path("/reference/k-proof")),
+        "discovery_manifest_sha256": file_sha256(
+            Path("/reference/lemma-discovery.json")
+        ),
+        "k_audit_sha256": sha256_tree(Path("/reference/k-audit")),
+        "klean_generation_sha256": sha256_tree(generation),
+        "generation_producer_sources_sha256": sha256_tree(producer),
+        "generated_tree_sha256": tree_digest(generated),
+        "lean_workspace_sha256": sha256_tree(Path("/candidate")),
+    }
+    for name, observed in observed_hashes.items():
+        check(name, hashes.get(name) == observed, f"observed={observed}")
+    print(
+        "lean_invocation_sha256=NOT_REHASHABLE"
+        " :: the Stage 5 invocation directory is not a mounted audit input"
+    )
+    print()
+
+    print("EVERY RECORDED STAGE 1 SOURCE FILE")
+    observed_sources = {
+        path.relative_to("/reference/k-proof").as_posix(): file_sha256(path)
+        for path in sorted(Path("/reference/k-proof").rglob("*"))
+        if path.is_file() and not path.is_symlink()
+    }
+    recorded_sources = resolution["stage1_source_hashes"]
+    check(
+        "stage1_source_keyset",
+        set(observed_sources) == set(recorded_sources),
+        (
+            f"observed={len(observed_sources)} "
+            f"recorded={len(recorded_sources)}"
+        ),
+    )
+    mismatched_sources = sorted(
+        name
+        for name in set(observed_sources) & set(recorded_sources)
+        if observed_sources[name] != recorded_sources[name]
+    )
+    check(
+        "stage1_source_values",
+        not mismatched_sources,
+        f"mismatches={mismatched_sources}",
+    )
+    print()
+
+    print("PRODUCER SOURCE / IMAGE BINDING")
+    producer_files = {
+        "klean.py": file_sha256(producer / "klean.py"),
+        "klean_export.py": file_sha256(producer / "klean_export.py"),
+    }
+    recorded_image = generator["provenance"]["generator_image_id"]
+    audit_image_key = Path(resolution["generation_producer_sources"]).name
+    check(
+        "producer_file_hashes_source_manifest",
+        producer_files == source_manifest["files"],
+        json.dumps(producer_files, sort_keys=True),
+    )
+    check(
+        "producer_file_hashes_generator_manifest",
+        producer_files["klean.py"] == generator["klean_py_sha256"]
+        and producer_files["klean_export.py"] == generator["exporter_sha256"],
+    )
+    check(
+        "producer_image_source_generator",
+        source_manifest["generator_image_id"] == recorded_image,
+        recorded_image,
+    )
+    check(
+        "producer_image_audit_input",
+        recorded_image == f"sha256:{audit_image_key}",
+        f"audit_path_key={audit_image_key}",
+    )
+    print()
+
+    print("STAGE 4 SIDECAR AND OBLIGATION HASHES")
+    check(
+        "generated_tree_generator_manifest",
+        generator["generated_tree_sha256"] == tree_digest(generated),
+    )
+    check(
+        "generated_tree_export_result",
+        export_result["generated_tree_sha256"] == tree_digest(generated),
+    )
+    check(
+        "obligation_map_file_hash",
+        generator["obligation_map_sha256"]
+        == file_sha256(generated / "obligation-map.json"),
+        file_sha256(generated / "obligation-map.json"),
+    )
+    check(
+        "trust_inventory_file_hash",
+        export_result["trust_inventory_sha256"]
+        == file_sha256(generation / "trust-inventory.json"),
+        file_sha256(generation / "trust-inventory.json"),
+    )
+    check(
+        "inventory_hash_all_records",
+        len(
+            {
+                discovery["inventory_sha256"],
+                input_manifest["inventory_sha256"],
+                generator["provenance"]["inventory_sha256"],
+                obligation_map["source_rules"][0]["inventory_sha256"],
+                obligation_map["obligations"][0]["inventory_sha256"],
+            }
+        )
+        == 1,
+    )
+    check(
+        "stage1_hash_all_stage4_records",
+        input_manifest["frozen_input_sha256"]
+        == input_manifest["stage1_workspace_sha256"]
+        == generator["provenance"]["stage1_workspace_sha256"]
+        == export_result["frozen_input_sha256"]
+        == tree_digest(Path("/reference/k-proof")),
+    )
+    check(
+        "stage3_hash_all_stage4_records",
+        input_manifest["stage3_discovery_manifest_sha256"]
+        == generator["provenance"]["stage3_discovery_manifest_sha256"]
+        == export_result["stage3_discovery_manifest_sha256"]
+        == file_sha256(Path("/reference/lemma-discovery.json")),
+    )
+    check(
+        "source_rule_bijection",
+        input_manifest["source_rules"] == obligation_map["source_rules"]
+        and len(input_manifest["source_rules"]) == len(obligation_map["obligations"])
+        and [
+            rule["source_rule_id"] for rule in input_manifest["source_rules"]
+        ]
+        == [
+            obligation["source_rule_id"]
+            for obligation in obligation_map["obligations"]
+        ],
+    )
+    obligation = obligation_map["obligations"][0]
+    check(
+        "lean_conjunct_hash",
+        obligation["lean_conjunct_sha256"]
+        == hashlib.sha256(obligation["lean_conjunct"].encode()).hexdigest(),
+        obligation["lean_conjunct_sha256"],
+    )
+    check(
+        "obligation_count_all_records",
+        generator["obligation_count"]
+        == export_result["obligation_count"]
+        == len(obligation_map["obligations"])
+        == 1,
+    )
+    print()
+
+    print("FIXED TARGET IDENTITY")
+    lemmas = generated / generator["target"]["file"]
+    lemmas_text = lemmas.read_text()
+    target_matches = list(
+        re.finditer(
+            r"(?ms)^\s*def\s+targetStatement\b.*?(?=^\s*end\s+\S+\s*$)",
+            lemmas_text,
+        )
+    )
+    check("single_target_definition", len(target_matches) == 1)
+    definition = target_matches[0].group(0).strip()
+    check(
+        "target_definition_hash",
+        hashlib.sha256(definition.encode()).hexdigest()
+        == generator["target"]["definition_sha256"],
+        hashlib.sha256(definition.encode()).hexdigest(),
+    )
+    parameters = obligation_map["trust_parameters"]
+    parameter_hashes_ok = True
+    for parameter in parameters:
+        binding = {
+            "kore_symbol": parameter["kore_symbol"],
+            "name": parameter["name"],
+            "type": parameter["type"],
+            "source_rule_ids": parameter["source_rule_ids"],
+        }
+        observed = hashlib.sha256(
+            json.dumps(
+                binding,
+                sort_keys=True,
+                separators=(",", ":"),
+                ensure_ascii=True,
+            ).encode()
+        ).hexdigest()
+        parameter_hashes_ok &= observed == parameter["binding_sha256"]
+    check("all_target_parameter_binding_hashes", parameter_hashes_ok)
+    statement = " ".join(
+        (
+            "Klean18HowManyTimes.Lemmas.targetStatement",
+            *(parameter["name"] for parameter in parameters),
+        )
+    )
+    check("target_statement_text", statement == generator["target"]["statement"])
+    check(
+        "target_statement_hash",
+        hashlib.sha256(statement.encode()).hexdigest()
+        == generator["target"]["statement_sha256"],
+        hashlib.sha256(statement.encode()).hexdigest(),
+    )
+    audit_targets = [
+        resolution["target"],
+        resolution["stage4_preflight"]["target"],
+        generator["target"],
+    ]
+    check("target_object_all_records", audit_targets.count(audit_targets[0]) == 3)
+    print()
+
+    print("CANDIDATE TARGET AND TRUST ESCAPES")
+    proof_text = Path("/candidate/Proof.lean").read_text()
+    candidate_lean_files = [
+        path
+        for path in Path("/candidate").rglob("*.lean")
+        if "Base" not in path.relative_to("/candidate").parts
+    ]
+    forbidden = []
+    for path in candidate_lean_files:
+        for match in re.finditer(
+            r"\b(?:sorry|admit|unsafe|axiom|opaque)\b", path.read_text()
+        ):
+            forbidden.append(
+                f"{path.relative_to('/candidate')}:{match.group(0)}"
+            )
+    check("candidate_forbidden_tokens", not forbidden, str(forbidden))
+    check(
+        "candidate_does_not_define_targetStatement",
+        re.search(r"(?m)^\s*def\s+targetStatement\b", proof_text) is None,
+    )
+    theorem_matches = re.findall(
+        r"(?ms)^\s*theorem\s+final\s*:\s*(.*?)\s*:=\s*by\b",
+        proof_text,
+    )
+    check("single_Proof_final", len(theorem_matches) == 1)
+    check(
+        "Proof_final_exact_statement",
+        len(theorem_matches) == 1
+        and " ".join(theorem_matches[0].split())
+        == " ".join(generator["target"]["statement"].split()),
+    )
+    declaration_counts = {}
+    for parameter in parameters:
+        name = parameter["name"]
+        declaration_counts[name] = len(
+            re.findall(
+                rf"(?m)^\s*(?:noncomputable\s+)?def\s+{re.escape(name)}"
+                rf"\s*(?::|\()",
+                proof_text,
+            )
+        )
+    check(
+        "exact_one_candidate_def_per_target_parameter",
+        all(count == 1 for count in declaration_counts.values()),
+        json.dumps(declaration_counts, sort_keys=True),
+    )
+    check(
+        "mounted_candidate_tree_hash",
+        sha256_tree(Path("/candidate")) == hashes["lean_workspace_sha256"],
+        sha256_tree(Path("/candidate")),
+    )
+    print()
+
+    print("TRUST INVENTORY OBJECT")
+    check(
+        "audit_input_trust_inventory_path",
+        Path(resolution["trust_inventory"]).name == "trust-inventory.json",
+        resolution["trust_inventory"],
+    )
+    check(
+        "trust_inventory_export_binding",
+        file_sha256(generation / "trust-inventory.json")
+        == export_result["trust_inventory_sha256"],
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a//tmp/audit-work/proc_self_exe_shim.c b//tmp/audit-work/proc_self_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..1133b95973b93f614dce1d37c94435a8cf7b3dd7
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_shim.c
@@ -0,0 +1,42 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    static const char prefix[] = "/proc/";
+    static const char suffix[] = "/exe";
+    const char *cursor;
+    size_t length;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    length = strlen(path);
+    if (length <= (sizeof(prefix) - 1) + (sizeof(suffix) - 1) ||
+        strcmp(path + length - (sizeof(suffix) - 1), suffix) != 0) {
+        return 0;
+    }
+    cursor = path + sizeof(prefix) - 1;
+    while (cursor < path + length - (sizeof(suffix) - 1)) {
+        if (*cursor < '0' || *cursor > '9') {
+            return 0;
+        }
+        cursor++;
+    }
+    return 1;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_proc_pid_exe(path)) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
