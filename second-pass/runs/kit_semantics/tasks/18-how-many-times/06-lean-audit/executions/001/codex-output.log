     2	  FuncDef("how_many_times", Params("string", "substring"),
     3	    If(Compare(Name("substring"), CmpOp("==", Str(""))),
     4	      Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
     5	      )
     6	    Assign(Name("count"), Int(0))
     7	    While(Compare(Name("string"), CmpOp("!=", Str(""))),
     8	      If(Call(Attribute(Name("string"), "startswith"), Name("substring")),
     9	        AugAssign(Name("count"), "+", Int(1)),
    10	        )
    11	      Assign(
    12	        Name("string"),
    13	        Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
    14	    Return(Name("count"))))

