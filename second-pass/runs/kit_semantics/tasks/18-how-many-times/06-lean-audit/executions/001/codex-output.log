diff --git a//tmp/audit-work/structural_crosscheck.py b//tmp/audit-work/structural_crosscheck.py
new file mode 100644
index 0000000000000000000000000000000000000000..d190c1093f131bf7da9cdfaae337428a10880e46
--- /dev/null
+++ b//tmp/audit-work/structural_crosscheck.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+import sys
+from collections import Counter
+from pathlib import Path
+
+sys.path.insert(0, "/reference")
+
+from tools.k_rule_inventory import inventory_verification
+from tools.klean_export import tree_digest
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> int:
+    workspace = Path("/reference/k-proof")
+    discovery_path = Path("/reference/lemma-discovery.json")
+    reconstructed = inventory_verification(workspace)
+    discovery = json.loads(discovery_path.read_text())
+
+    expected_ids = [rule["source_rule_id"] for rule in reconstructed["rules"]]
+    observed_ids = [rule.get("source_rule_id") for rule in discovery["rules"]]
+    counts = Counter(observed_ids)
+    duplicate_ids = sorted(
+        source_rule_id
+        for source_rule_id, count in counts.items()
+        if count != 1
+    )
+
+    print("RECONSTRUCTION / STAGE 3 BIJECTION")
+    print(f"reconstructed_count={len(expected_ids)}")
+    print(f"stage3_count={len(observed_ids)}")
+    print(f"ordered_ids_equal={observed_ids == expected_ids}")
+    print(f"missing_ids={sorted(set(expected_ids) - set(observed_ids))}")
+    print(f"extra_ids={sorted(set(observed_ids) - set(expected_ids))}")
+    print(f"non_unique_stage3_ids={duplicate_ids}")
+    print(
+        "inventory_hash_equal="
+        f"{discovery.get('inventory_sha256') == reconstructed['inventory_sha256']}"
+    )
+    print(
+        f"reconstructed_inventory_sha256={reconstructed['inventory_sha256']}"
+    )
+    print(f"stage3_inventory_sha256={discovery.get('inventory_sha256')}")
+    print()
+
+    print("RULE ID / NORMALIZED HASH / SOURCE SPAN")
+    for index, rule in enumerate(reconstructed["rules"]):
+        suffix = rule["source_rule_id"].removeprefix("rule-")
+        print(
+            json.dumps(
+                {
+                    "index": index,
+                    "module": rule["module"],
+                    "span": [rule["start_line"], rule["end_line"]],
+                    "normalized_sha256": rule["normalized_sha256"],
+                    "source_rule_id": rule["source_rule_id"],
+                    "id_hash_equal": suffix == rule["normalized_sha256"],
+                    "stage3_classification": discovery["rules"][index][
+                        "classification"
+                    ],
+                },
+                sort_keys=True,
+            )
+        )
+    print()
+
+    print("IMMUTABLE INPUT HASHES")
+    values = {
+        "stage1_tree_sha256": tree_digest(workspace),
+        "stage3_file_sha256": sha256(discovery_path),
+        "generated_tree_sha256": tree_digest(
+            Path("/reference/klean-generation/generated")
+        ),
+        "generation_producer_sources_tree_sha256": tree_digest(
+            Path("/reference/generation-tools")
+        ),
+        "verification_file_sha256": sha256(workspace / "verification.k"),
+    }
+    for key, value in values.items():
+        print(f"{key}={value}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
