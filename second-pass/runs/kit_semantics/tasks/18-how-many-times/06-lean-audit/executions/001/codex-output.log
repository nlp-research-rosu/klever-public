+
+open Proof
+
+def empty : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def cons (x : SortInt) (xs : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x xs
+
+def witness : SortIntSeq := cons 10 (cons 20 (cons 30 empty))
+
+def asK (xs : SortIntSeq) : SortK :=
+  SortK.kseq (SortKItem.inj_SortIntSeq xs) SortK.dotk
+
+example :
+    Proof.notBool_ (Proof.«_==K_» (asK witness) (asK empty)) = true := by
+  simp [Proof.notBool_, Proof.«_==K_», asK, witness, empty, cons]
+
+-- False mutation: replace the correct tail result with the original sequence.
+example :
+    Proof.«buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
+        witness
+        (Proof.«clampHi(_,_,_)_MPY-SUBSCRIPT_Int_Int_Int_Int»
+          1 (Proof.«isLen(_)_MPY-CORE_Int_IntSeq» witness) 1)
+        (Proof.«isLen(_)_MPY-CORE_Int_IntSeq» witness)
+        1 =
+      witness := by
+  rfl
+
+end MutationShouldFail
