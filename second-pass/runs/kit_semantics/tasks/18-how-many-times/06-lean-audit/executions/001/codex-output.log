solution.py
     1	def how_many_times(string: str, substring: str) -> int:
     2	    if substring == "":
     3	        return len(string) + 1
     4	
     5	    count = 0
     6	    while string != "":
     7	        if string.startswith(substring):
     8	            count += 1
     9	        string = string[1:]
    10	
    11	    return count

