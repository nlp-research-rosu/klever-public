diff --git a//tmp/audit-work/proof-audit-001/BridgeAudit.lean b//tmp/audit-work/proof-audit-001/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..5217ea05ac8030ba8695fb150d76f4b3b0f7935f
--- /dev/null
+++ b//tmp/audit-work/proof-audit-001/BridgeAudit.lean
@@ -0,0 +1,91 @@
+import Proof
+
+namespace BridgeAudit
+
+open Proof
+
+def s0 : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def cons (x : SortInt) (xs : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x xs
+
+def s1 : SortIntSeq := cons 10 s0
+def s2 : SortIntSeq := cons 10 (cons 20 s0)
+def s3 : SortIntSeq := cons 10 (cons 20 (cons 30 s0))
+def s4 : SortIntSeq := cons 10 (cons 20 (cons 30 (cons 40 s0)))
+
+def asK (xs : SortIntSeq) : SortK :=
+  SortK.kseq (SortKItem.inj_SortIntSeq xs) SortK.dotk
+
+def build :=
+  Proof.«buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
+
+def clamp :=
+  Proof.«clampHi(_,_,_)_MPY-SUBSCRIPT_Int_Int_Int_Int»
+
+def length :=
+  Proof.«isLen(_)_MPY-CORE_Int_IntSeq»
+
+def tail :=
+  Proof.«tailIS(_)_VERIFICATION_IntSeq_IntSeq»
+
+-- Boundary and distinguishing witnesses for every target parameter.
+example : Proof.«_==K_» (asK s0) (asK s0) = true := by
+  simp [Proof.«_==K_»]
+example : Proof.«_==K_» (asK s0) (asK s1) = false := by
+  simp [Proof.«_==K_», asK, s0, s1, cons]
+example : Proof.notBool_ true = false := by native_decide
+example : Proof.notBool_ false = true := by native_decide
+example : length s0 = 0 := by native_decide
+example : length s3 = 3 := by native_decide
+example : clamp 1 0 1 = 0 := by native_decide
+example : clamp 1 1 1 = 1 := by native_decide
+example : clamp 1 3 1 = 1 := by native_decide
+example : clamp 5 3 (-1) = 2 := by native_decide
+example : tail s0 = s0 := by rfl
+example : tail s1 = s0 := by rfl
+example : tail s3 = cons 20 (cons 30 s0) := by rfl
+
+-- Exact K-recursion witnesses on positive, negative, zero, and boundary steps.
+example : intSeqToList (build s3 1 3 1) = [20, 30] := by native_decide
+example : intSeqToList (build s4 0 4 2) = [10, 30] := by native_decide
+example : intSeqToList (build s3 2 (-1) (-1)) = [30, 20, 10] := by
+  native_decide
+example : intSeqToList (build s3 0 3 0) = [] := by native_decide
+example : intSeqToList (build s1 (clamp 1 (length s1) 1) (length s1) 1) = [] := by
+  native_decide
+example : intSeqToList (build s3 (clamp 1 (length s3) 1) (length s3) 1) =
+    [20, 30] := by
+  native_decide
+
+-- The translated guard is satisfiable on a concrete nonempty sequence.
+example :
+    Proof.notBool_ (Proof.«_==K_» (asK s1) (asK s0)) = true := by
+  simp [Proof.notBool_, Proof.«_==K_», asK, s0, s1, cons]
+
+-- Counterfactual: the equation alone accepts coordinated constant bridges.
+def badBuild (_ : SortIntSeq) (_ _ _ : SortInt) : SortIntSeq := s0
+def badTail (_ : SortIntSeq) : SortIntSeq := s0
+
+theorem target_accepts_coordinated_constants :
+    Klean18HowManyTimes.Lemmas.targetStatement
+      Proof.«_==K_»
+      badBuild
+      Proof.«clampHi(_,_,_)_MPY-SUBSCRIPT_Int_Int_Int_Int»
+      Proof.«isLen(_)_MPY-CORE_Int_IntSeq»
+      Proof.notBool_
+      badTail := by
+  intro _ _
+  rfl
+
+-- These witnesses ensure the submitted bridges are not those constants.
+example : tail s3 ≠ badTail s3 := by
+  simp [tail, badTail, Proof.«tailIS(_)_VERIFICATION_IntSeq_IntSeq»,
+    s3, s0, cons]
+example : build s3 1 3 1 ≠ badBuild s3 1 3 1 := by
+  simp [build, badBuild,
+    Proof.«buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»,
+    Proof.intSeqToList, Proof.listToIntSeq, s3, s0, cons]
+
+end BridgeAudit
diff --git a//tmp/audit-work/proof-audit-001/MutationShouldFail.lean b//tmp/audit-work/proof-audit-001/MutationShouldFail.lean
new file mode 100644
index 0000000000000000000000000000000000000000..9080bf3dc0340c0feeec89a5caafc1c52fa15971
--- /dev/null
+++ b//tmp/audit-work/proof-audit-001/MutationShouldFail.lean
@@ -0,0 +1,33 @@
+import Proof
+
+namespace MutationShouldFail
+
+open Proof
+
+def empty : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def cons (x : SortInt) (xs : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x xs
+
+def witness : SortIntSeq := cons 10 (cons 20 (cons 30 empty))
+
+def asK (xs : SortIntSeq) : SortK :=
+  SortK.kseq (SortKItem.inj_SortIntSeq xs) SortK.dotk
+
+example :
+    Proof.notBool_ (Proof.«_==K_» (asK witness) (asK empty)) = true := by
+  simp [Proof.notBool_, Proof.«_==K_», asK, witness, empty, cons]
+
+-- False mutation: replace the correct tail result with the original sequence.
+example :
+    Proof.«buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
+        witness
+        (Proof.«clampHi(_,_,_)_MPY-SUBSCRIPT_Int_Int_Int_Int»
+          1 (Proof.«isLen(_)_MPY-CORE_Int_IntSeq» witness) 1)
+        (Proof.«isLen(_)_MPY-CORE_Int_IntSeq» witness)
+        1 =
+      witness := by
+  rfl
+
+end MutationShouldFail
