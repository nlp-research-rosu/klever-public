Module(
  FuncDef("how_many_times", Params("string", "substring"),
    If(Compare(Name("substring"), CmpOp("==", Str(""))),
      Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
      )
    Assign(Name("count"), Int(0))
    While(Compare(Name("string"), CmpOp("!=", Str(""))),
      If(Call(Attribute(Name("string"), "startswith"), Name("substring")),
        AugAssign(Name("count"), "+", Int(1)),
        )
      Assign(
        Name("string"),
        Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
    Return(Name("count"))))
