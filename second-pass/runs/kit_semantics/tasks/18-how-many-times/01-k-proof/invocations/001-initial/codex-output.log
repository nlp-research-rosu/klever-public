+              If(
+                Call(Attribute(Name("string"), "startswith"), Name("substring")),
+                AugAssign(Name("count"), "+", Int(1)),
+                .Stmts)
+              Assign(
+                Name("string"),
+                Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
+            Return(Name("count")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
