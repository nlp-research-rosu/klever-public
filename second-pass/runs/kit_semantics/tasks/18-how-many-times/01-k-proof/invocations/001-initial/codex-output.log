+  echo "ERROR: changed-body mutation unexpectedly proved"
+  exit 1
+else
+  mutation_status=$?
+  echo "EXPECTED_FAILURE_CHANGED_BODY_EXIT=$mutation_status"
+fi
+
+rg -U -q '<k>[[:space:]]*3 ~> \.K' vacuity-output.txt
+rg -U -q '<k>[[:space:]]*4 ~> \.K' body-mutation-output.txt
