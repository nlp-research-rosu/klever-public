+def how_many_times(string: str, substring: str) -> int:
+    if substring == "":
+        return len(string) + 1
+
+    count = 0
+    current = string
+    for char in string:
+        if current.startswith(substring):
+            count += 1
+        current = current[1:]
+
+    return count

