diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..501b0f82fdec83091273575de2dbf3074df29a80
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,66 @@
+from itertools import product
+
+from solution import how_many_times
+
+
+def oracle(string: str, substring: str) -> int:
+    width = len(substring)
+    return sum(
+        string[index:index + width] == substring
+        for index in range(len(string) - width + 1)
+    )
+
+
+alphabet = "ab"
+strings = [
+    "".join(chars)
+    for length in range(7)
+    for chars in product(alphabet, repeat=length)
+]
+patterns = [
+    "".join(chars)
+    for length in range(4)
+    for chars in product(alphabet, repeat=length)
+]
+
+mismatches = []
+for string in strings:
+    for substring in patterns:
+        actual = how_many_times(string, substring)
+        expected = oracle(string, substring)
+        if actual != expected:
+            mismatches.append((string, substring, actual, expected))
+
+print(f"CASES={len(strings) * len(patterns)}")
+print(f"MISMATCHES={len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
+
+
+def build_is(codes: tuple[int, ...], index: int, stop: int) -> tuple[int, ...]:
+    result = []
+    while index < stop:
+        result.append(codes[index])
+        index += 1
+    return tuple(result)
+
+
+slice_mismatches = []
+slice_cases = 0
+for length in range(1, 9):
+    for codes in product(range(3), repeat=length):
+        slice_cases += 1
+        start = 1 if 1 < len(codes) else len(codes)
+        fixed_semantics_shape = build_is(codes, start, len(codes))
+        python_oracle = codes[1:]
+        if fixed_semantics_shape != python_oracle:
+            slice_mismatches.append(
+                (codes, fixed_semantics_shape, python_oracle)
+            )
+
+print(f"SLICE_CASES={slice_cases}")
+print(f"SLICE_MISMATCHES={len(slice_mismatches)}")
+if slice_mismatches:
+    print(slice_mismatches[:10])
+    raise SystemExit(1)
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2fcce749049c138c1de203da1dce5a66c0aacb0f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical count of overlapping occurrences.  The empty pattern occurs
+  // at every boundary; a nonempty pattern is tested at every successive suffix.
+  syntax Int ::= overlapCount(IntSeq, IntSeq) [function, total]
+  syntax IntSeq ::= tailIS(IntSeq) [function, total]
+
+  rule tailIS(.IntSeq) => .IntSeq
+  rule tailIS(iCons(_:Int, CS:IntSeq)) => CS
+
+  rule overlapCount(S:IntSeq, P:IntSeq)
+    => isLen(S) +Int 1
+    requires P ==K .IntSeq
+
+  rule overlapCount(.IntSeq, P:IntSeq)
+    => 0
+    requires notBool (P ==K .IntSeq)
+
+  rule overlapCount(S:IntSeq, P:IntSeq)
+    => (#if startsWith(P, S)
+        #then 1 #else 0 #fi)
+       +Int overlapCount(tailIS(S), P)
+    requires notBool (S ==K .IntSeq)
+     andBool notBool (P ==K .IntSeq)
+
+  // Derived slice lemma: taking [1:] of a nonempty code sequence yields its
+  // tail.  This is an induction consequence of buildIS/intSeqAt/isLen.
+  rule buildIS(
+         S:IntSeq,
+         clampHi(1, isLen(S), 1),
+         isLen(S),
+         1)
+    => tailIS(S)
+    requires notBool (S ==K .IntSeq)
+    [simplification]
+endmodule

