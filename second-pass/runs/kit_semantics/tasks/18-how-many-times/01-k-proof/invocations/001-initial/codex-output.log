+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical count of overlapping occurrences.  The empty pattern occurs
+  // at every boundary; a nonempty pattern is tested at every successive suffix.
+  syntax Int ::= overlapCount(IntSeq, IntSeq) [function, total]
+
+  rule overlapCount(S:IntSeq, .IntSeq)
+    => isLen(S) +Int 1
+
+  rule overlapCount(.IntSeq, iCons(P:Int, PS:IntSeq))
+    => 0
+
+  rule overlapCount(iCons(C:Int, CS:IntSeq), iCons(P:Int, PS:IntSeq))
+    => (#if strPrefix(iCons(P, PS), iCons(C, CS))
+        #then 1 #else 0 #fi)
+       +Int overlapCount(CS, iCons(P, PS))
+
+  // Derived slice lemma: taking [1:] of a nonempty code sequence yields its
+  // tail.  This is an induction consequence of buildIS/intSeqAt/isLen.
+  rule buildIS(iCons(C:Int, CS:IntSeq), 1, 1 +Int isLen(CS), 1)
+    => CS
+    [simplification]
+endmodule

