+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the real result for ("aaaa", "aa") is 3, not 4.
+  claim [false-result]:
+    <k>
+      Call(Name("how_many_times"), Str("aaaa"), Str("aa"))
+      => 4
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "how_many_times" |->
+          closureVal(
+            ("string", "substring"),
+            If(
+              Compare(Name("substring"), CmpOp("==", Str(""))),
+              Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+              .Stmts)
+            Assign(Name("count"), Int(0))
+            While(
+              Compare(Name("string"), CmpOp("!=", Str(""))),
+              If(
+                Call(Attribute(Name("string"), "startswith"), Name("substring")),
+                AugAssign(Name("count"), "+", Int(1)),
+                .Stmts)
+              Assign(
+                Name("string"),
+                Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
+            Return(Name("count")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ffca9127cc25b81d9af877cd0b34b4f8f6916a46
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #while(
+        Compare(Name("string"), CmpOp("!=", Str(""))),
+        If(
+          Call(Attribute(Name("string"), "startswith"), Name("substring")),
+          AugAssign(Name("count"), "+", Int(1)),
+          .Stmts)
+        Assign(
+          Name("string"),
+          Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "string"    |-> (str(S:IntSeq) => str(.IntSeq))
+        "substring" |-> str(P:IntSeq)
+        "count"     |-> (C:Int => C +Int overlapCount(S, P)),
+        PAR:Parent)
+      ...
+    </scopes>
+    requires notBool (P ==K .IntSeq)
+
+  claim [target]:
+    <k>
+      Call(
+        Name("how_many_times"),
+        str(S:IntSeq),
+        str(P:IntSeq))
+      => ?R:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "how_many_times" |->
+          closureVal(
+            ("string", "substring"),
+            If(
+              Compare(Name("substring"), CmpOp("==", Str(""))),
+              Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+              .Stmts)
+            Assign(Name("count"), Int(0))
+            While(
+              Compare(Name("string"), CmpOp("!=", Str(""))),
+              If(
+                Call(Attribute(Name("string"), "startswith"), Name("substring")),
+                AugAssign(Name("count"), "+", Int(1)),
+                .Stmts)
+              Assign(
+                Name("string"),
+                Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
+            Return(Name("count")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Int overlapCount(S, P)
+endmodule
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..58844c8ffc7f4924306f4d57fb0ed57a3b523682
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,38 @@
+from itertools import product
+
+from solution import how_many_times
+
+
+def oracle(string: str, substring: str) -> int:
+    width = len(substring)
+    return sum(
+        string[index:index + width] == substring
+        for index in range(len(string) - width + 1)
+    )
+
+
+alphabet = "ab"
+strings = [
+    "".join(chars)
+    for length in range(7)
+    for chars in product(alphabet, repeat=length)
+]
+patterns = [
+    "".join(chars)
+    for length in range(4)
+    for chars in product(alphabet, repeat=length)
+]
+
+mismatches = []
+for string in strings:
+    for substring in patterns:
+        actual = how_many_times(string, substring)
+        expected = oracle(string, substring)
+        if actual != expected:
+            mismatches.append((string, substring, actual, expected))
+
+print(f"CASES={len(strings) * len(patterns)}")
+print(f"MISMATCHES={len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
