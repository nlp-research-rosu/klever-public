+++ b/slice-lemma-spec.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module SLICE-LEMMA-SPEC
+  imports MPY
+
+  // Bridge-free validation of the derived simplification lemma used by the
+  // target proof.  Every nonempty IntSeq has this constructor form.
+  claim [slice-tail]:
+    <k>
+      buildIS(
+        iCons(C:Int, CS:IntSeq),
+        clampHi(1, isLen(iCons(C, CS)), 1),
+        isLen(iCons(C, CS)),
+        1)
+      => CS
+    </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e9330569ca31b0e727ca4bf05f521a1ddbb8546
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def how_many_times(string: str, substring: str) -> int:
+    if substring == "":
+        return len(string) + 1
+
+    count = 0
+    while string != "":
+        if string.startswith(substring):
+            count += 1
+        string = string[1:]
+
+    return count
