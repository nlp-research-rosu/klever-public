@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #while(
+        Compare(Name("string"), CmpOp("!=", Str(""))),
+        If(
+          Call(Attribute(Name("string"), "startswith"), Name("substring")),
+          AugAssign(Name("count"), "+", Int(1)),
+          .Stmts)
+        Assign(
+          Name("string"),
+          Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "string"    |-> (str(S:IntSeq) => str(.IntSeq))
+        "substring" |-> str(P:IntSeq)
+        "count"     |-> (C:Int => C +Int overlapCount(S, P)),
+        PAR:Parent)
+      ...
+    </scopes>
+    requires notBool (P ==K .IntSeq)
+
+  claim [target]:
+    <k>
+      Call(
+        Name("how_many_times"),
+        str(S:IntSeq),
+        str(P:IntSeq))
+      => ?R:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "how_many_times" |->
+          closureVal(
+            ("string", "substring"),
+            If(
+              Compare(Name("substring"), CmpOp("==", Str(""))),
+              Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+              .Stmts)
+            Assign(Name("count"), Int(0))
+            While(
+              Compare(Name("string"), CmpOp("!=", Str(""))),
+              If(
+                Call(Attribute(Name("string"), "startswith"), Name("substring")),
+                AugAssign(Name("count"), "+", Int(1)),
+                .Stmts)
+              Assign(
+                Name("string"),
+                Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
+            Return(Name("count")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Int overlapCount(S, P)
+endmodule
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..58844c8ffc7f4924306f4d57fb0ed57a3b523682
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,38 @@
+from itertools import product
+
+from solution import how_many_times
+
+
+def oracle(string: str, substring: str) -> int:
+    width = len(substring)
+    return sum(
+        string[index:index + width] == substring
+        for index in range(len(string) - width + 1)
+    )
+
+
+alphabet = "ab"
+strings = [
+    "".join(chars)
+    for length in range(7)
+    for chars in product(alphabet, repeat=length)
+]
+patterns = [
+    "".join(chars)
+    for length in range(4)
+    for chars in product(alphabet, repeat=length)
+]
+
+mismatches = []
+for string in strings:
+    for substring in patterns:
+        actual = how_many_times(string, substring)
+        expected = oracle(string, substring)
+        if actual != expected:
+            mismatches.append((string, substring, actual, expected))
+
+print(f"CASES={len(strings) * len(patterns)}")
+print(f"MISMATCHES={len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2fcce749049c138c1de203da1dce5a66c0aacb0f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical count of overlapping occurrences.  The empty pattern occurs
+  // at every boundary; a nonempty pattern is tested at every successive suffix.
+  syntax Int ::= overlapCount(IntSeq, IntSeq) [function, total]
+  syntax IntSeq ::= tailIS(IntSeq) [function, total]
+
+  rule tailIS(.IntSeq) => .IntSeq
+  rule tailIS(iCons(_:Int, CS:IntSeq)) => CS
+
+  rule overlapCount(S:IntSeq, P:IntSeq)
+    => isLen(S) +Int 1
+    requires P ==K .IntSeq
+
+  rule overlapCount(.IntSeq, P:IntSeq)
+    => 0
+    requires notBool (P ==K .IntSeq)
+
+  rule overlapCount(S:IntSeq, P:IntSeq)
+    => (#if startsWith(P, S)
+        #then 1 #else 0 #fi)
+       +Int overlapCount(tailIS(S), P)
+    requires notBool (S ==K .IntSeq)
+     andBool notBool (P ==K .IntSeq)
+
+  // Derived slice lemma: taking [1:] of a nonempty code sequence yields its
+  // tail.  This is an induction consequence of buildIS/intSeqAt/isLen.
+  rule buildIS(
+         S:IntSeq,
+         clampHi(1, isLen(S), 1),
+         isLen(S),
+         1)
+    => tailIS(S)
+    requires notBool (S ==K .IntSeq)
+    [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..437aa7d190f3c3c20f59ed258af312a057166f86
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,17 @@
+def how_many_times(string: str, substring: str) -> int:
+    if substring == "":
+        return len(string) + 1
+
+    count = 0
+    while string != "":
+        if string.startswith(substring):
+            count += 1
+        string = string[1:]
+
+    return count
+
+
+example_empty = how_many_times("", "a")
+example_single = how_many_times("aaa", "a")
+example_overlap = how_many_times("aaaa", "aa")
+empty_substring = how_many_times("abc", "")
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..64eaa2691f63cf575430c8b54d0f0877bef9bebe
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy --definition runtime-kompiled \
+  2>&1 | tee concrete-output.txt
+rg -q '"example_empty" \\|-> 0' concrete-output.txt
+rg -q '"example_single" \\|-> 3' concrete-output.txt
+rg -q '"example_overlap" \\|-> 3' concrete-output.txt
+rg -q '"empty_substring" \\|-> 4' concrete-output.txt
+
+python3 validate.py 2>&1 | tee differential-output.txt
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-inv \
+  2>&1 | tee loop-proof-output.txt
+rg -q '^#Top$' loop-proof-output.txt
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  2>&1 | tee target-proof-output.txt
+rg -q '^#Top$' target-proof-output.txt
+
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY \
+     2>&1 | tee vacuity-output.txt; then
+  echo "ERROR: false-result mutation unexpectedly proved"
+  exit 1
+else
+  mutation_status=$?
+  echo "EXPECTED_FAILURE_FALSE_RESULT_EXIT=$mutation_status"
+fi
+
+if kprove spec-body-mutation.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-BODY-MUTATION \
+     2>&1 | tee body-mutation-output.txt; then
+  echo "ERROR: changed-body mutation unexpectedly proved"
+  exit 1
+else
+  mutation_status=$?
+  echo "EXPECTED_FAILURE_CHANGED_BODY_EXIT=$mutation_status"
+fi
+
+rg -U -q '<k>[[:space:]]*3 ~> \.K' vacuity-output.txt
+rg -U -q '<k>[[:space:]]*4 ~> \.K' body-mutation-output.txt
