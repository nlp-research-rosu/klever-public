@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module SLICE-LEMMA-SPEC
+  imports MPY
+
+  // Bridge-free validation of the derived simplification lemma used by the
+  // target proof.  Every nonempty IntSeq has this constructor form.
+  claim [slice-tail]:
+    <k>
+      buildIS(
+        iCons(C:Int, CS:IntSeq),
+        clampHi(1, isLen(iCons(C, CS)), 1),
+        isLen(iCons(C, CS)),
+        1)
+      => CS
+    </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e9330569ca31b0e727ca4bf05f521a1ddbb8546
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def how_many_times(string: str, substring: str) -> int:
+    if substring == "":
+        return len(string) + 1
+
+    count = 0
+    while string != "":
+        if string.startswith(substring):
+            count += 1
+        string = string[1:]
+
+    return count
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..09a0b0ee78d6f6aa6c5b4a111033eea89343eeec
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately changed body: count starts at 1.  The original expected
+  // result 3 must therefore be rejected for ("aaaa", "aa").
+  claim [changed-body]:
+    <k>
+      Call(Name("how_many_times"), Str("aaaa"), Str("aa"))
+      => 3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "how_many_times" |->
+          closureVal(
+            ("string", "substring"),
+            If(
+              Compare(Name("substring"), CmpOp("==", Str(""))),
+              Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+              .Stmts)
+            Assign(Name("count"), Int(1))
+            While(
+              Compare(Name("string"), CmpOp("!=", Str(""))),
+              If(
+                Call(Attribute(Name("string"), "startswith"), Name("substring")),
+                AugAssign(Name("count"), "+", Int(1)),
+                .Stmts)
+              Assign(
+                Name("string"),
+                Subscript(Name("string"), Slice(Int(1), NoBound, NoBound))))
+            Return(Name("count")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
