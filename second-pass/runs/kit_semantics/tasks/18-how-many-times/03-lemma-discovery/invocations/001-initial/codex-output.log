/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path

canonical = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == canonical['inventory_sha256']
canonical_ids = [r['source_rule_id'] for r in canonical['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == canonical_ids
assert len(out_ids) == len(set(out_ids)) == len(canonical_ids)
for entry in out['rules']:
    assert list(entry) == ['source_rule_id', 'classification', 'rationale'], list(entry)
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
by_id = {r['source_rule_id']: r for r in out['rules']}
for rule in canonical['rules']:
    if 'simplification' in rule.get('attributes', []):
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

print('VALID_JSON=1')
print('RULE_COUNT=' + str(len(out_ids)))
print('ORDER_MATCH=1')
print('UNIQUE_COVERAGE=1')
print('HASH_MATCH=1')
for key, value in sorted(Counter(r['classification'] for r in out['rules']).items()):
    print(f'{key}={value}')
PY
python3 -m json.tool trust-boundary.json >/dev/null
rg -n 'domain-lemma set is \\*\\*not empty\\*\\*|There are no "'`PROVED_DERIVED_LEMMA`'"' DISCOVERY.md
ls -l trust-boundary.json DISCOVERY.md" in /workspace
