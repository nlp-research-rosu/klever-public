      "text": "  rule overlapCount(S:IntSeq, P:IntSeq)\n    => (#if startsWith(P, S)\n        #then 1 #else 0 #fi)\n       +Int overlapCount(tailIS(S), P)\n    requires notBool (S ==K .IntSeq)\n     andBool notBool (P ==K .IntSeq)"
