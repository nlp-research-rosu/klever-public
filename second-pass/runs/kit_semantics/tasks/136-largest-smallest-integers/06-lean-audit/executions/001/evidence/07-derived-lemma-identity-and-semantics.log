$ source prompt and implementation
     1	
     2	def largest_smallest_integers(lst):
     3	    '''
     4	    Create a function that returns a tuple (a, b), where 'a' is
     5	    the largest of negative integers, and 'b' is the smallest
     6	    of positive integers in a list.
     7	    If there is no negative or positive integers, return them as None.
     8	
     9	    Examples:
    10	    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)
    11	    largest_smallest_integers([]) == (None, None)
    12	    largest_smallest_integers([0]) == (None, None)
    13	    '''
     1	def largest_smallest_integers(lst):
     2	    largest_negative = 0
     3	    smallest_positive = 0
     4	    value = 0
     5	
     6	    for value in lst:
     7	        if value < 0:
     8	            if largest_negative == 0 or value > largest_negative:
     9	                largest_negative = value
    10	
    11	        if value > 0:
    12	            if smallest_positive == 0 or value < smallest_positive:
    13	                smallest_positive = value
    14	
    15	    return (
    16	        None if largest_negative == 0 else largest_negative,
    17	        None if smallest_positive == 0 else smallest_positive,
    18	    )
