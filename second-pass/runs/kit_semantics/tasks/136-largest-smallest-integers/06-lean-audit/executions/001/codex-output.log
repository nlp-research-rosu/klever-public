+trust_path = root / "klean-generation/trust-inventory.json"
+trust_hash = hashlib.sha256(trust_path.read_bytes()).hexdigest()
+export_result = load(root / "klean-generation/export-result.json")
+recorded_preflight = load(root / "klean-generation/preflight.json")
+fresh_preflight = load(Path("/audit-output/evidence/20-preflight-return.json"))
+
+for label, observed in {
+    "input frozen_input_sha256": input_manifest["frozen_input_sha256"],
+    "input stage1_workspace_sha256": input_manifest["stage1_workspace_sha256"],
+    "generator provenance stage1_workspace_sha256": generator["provenance"]["stage1_workspace_sha256"],
+    "export frozen_input_sha256": export_result["frozen_input_sha256"],
+    "fresh preflight frozen_input_sha256": fresh_preflight["frozen_input_sha256"],
+    "fresh preflight stage1_workspace_sha256": fresh_preflight["stage1_workspace_sha256"],
+}.items():
+    check(label, observed, stage1_export)
+for label, observed in {
+    "input discovery hash": input_manifest["stage3_discovery_manifest_sha256"],
+    "generator provenance discovery hash": generator["provenance"]["stage3_discovery_manifest_sha256"],
+    "export discovery hash": export_result["stage3_discovery_manifest_sha256"],
+    "fresh preflight discovery hash": fresh_preflight["stage3_discovery_manifest_sha256"],
+}.items():
+    check(label, observed, discovery_hash)
+for label, observed in {
+    "generator generated tree": generator["generated_tree_sha256"],
+    "export generated tree": export_result["generated_tree_sha256"],
+    "fresh preflight generated tree": fresh_preflight["generated_tree_sha256"],
+}.items():
+    check(label, observed, generated_tree)
+
+check("generator obligation-map hash", generator["obligation_map_sha256"], hashlib.sha256(obligation_map_path.read_bytes()).hexdigest())
+check("export trust-inventory hash", export_result["trust_inventory_sha256"], trust_hash)
+check("generator pinned toolchain", generator["toolchain"], load(root / "klean-toolchain.lock.json"))
+check("verification.k hash input manifest", input_manifest["verification_sha256"], hashlib.sha256((root / "k-proof/verification.k").read_bytes()).hexdigest())
+
+independent_domain_ids: list[str] = []
+check("independent domain IDs vs input source rules", input_manifest["source_rules"], independent_domain_ids)
+check("input source rules vs obligation-map source rules", obligation_map["source_rules"], input_manifest["source_rules"])
+check("obligation IDs exact order", [x["source_rule_id"] for x in obligation_map["obligations"]], independent_domain_ids)
+check("obligation IDs unique", len({x["source_rule_id"] for x in obligation_map["obligations"]}), len(obligation_map["obligations"]))
+check("obligation-map trust parameters", obligation_map["trust_parameters"], [])
+check("generator obligation count", generator["obligation_count"], len(obligation_map["obligations"]))
+check("export obligation count", export_result["obligation_count"], len(obligation_map["obligations"]))
+check("fresh preflight obligation count", fresh_preflight["obligation_count"], len(obligation_map["obligations"]))
+
+expected_target = klean_export.expected_target_definition(obligation_map)
+actual_target = klean_export.target_statement(root / "klean-generation/generated")
+check("expected generated target definition", expected_target, None)
+check("actual generated target", actual_target, None)
+check("generator target", generator["target"], actual_target)
+check("recorded preflight target", recorded_preflight["target"], actual_target)
+check("fresh preflight target", fresh_preflight["target"], actual_target)
+check("audit-input target", resolution["target"], actual_target)
+check("audit-input stage4_preflight target", resolution["stage4_preflight"]["target"], actual_target)
+check("Stage 4 export status", export_result["status"], "KLEAN_NO_OBLIGATIONS")
+check("fresh preflight status", fresh_preflight["status"], "KLEAN_NO_OBLIGATIONS")
+check("selected Stage 4 status", resolution["selections"]["klean_generation"]["status"], "KLEAN_NO_OBLIGATIONS")
+
+check("audit mode", resolution["mode"], "CLASSIFICATION_ONLY")
+check("semantics mode", resolution["semantics_mode"], "SUPPLIED_SEMANTICS")
+check("audit-input lean workspace", resolution["lean_workspace"], None)
+check("audit-input lean invocation", resolution["lean_invocation"], None)
+check("audit-input Stage 5 result", resolution["stage5_result"], None)
+
+print("ALL CHECKS PASSED")
