            for k,v in x.items():
                q=f'{p}.{k}'
                if any(s in k.lower() for s in ('generator','producer','exporter','klean_py')):
                    print(q, '=', v)
                walk(v,q)
        elif isinstance(x,list):
            for i,v in enumerate(x): walk(v,f'{p}[{i}]')
    walk(obj)
