+check("resolution.hashes.stage1_export_sha256", stage1_export, resolution["hashes"]["stage1_export_sha256"])
+check("resolution.hashes.generated_tree_sha256", generated_tree, resolution["hashes"]["generated_tree_sha256"])
+check("resolution.hashes.discovery_manifest_sha256", discovery_hash, resolution["hashes"]["discovery_manifest_sha256"])
+check("resolution.hashes.lean_workspace_sha256", None, resolution["hashes"]["lean_workspace_sha256"])
+check("resolution.hashes.lean_invocation_sha256", None, resolution["hashes"]["lean_invocation_sha256"])
+
+walked = {
+    path.relative_to(root / "k-proof").as_posix(): pipeline_contract.sha256_file(path)
+    for path in pipeline_contract._walk_regular_files(root / "k-proof", "Stage 1 workspace")
+}
+check("stage1_source_hashes exact file/hash bijection", walked, resolution["stage1_source_hashes"])
+print(f"  file_count={len(walked)}")
+
+producer = root / "generation-tools"
+source_manifest = load(producer / "source-manifest.json")
+generator = load(root / "klean-generation/generator-manifest.json")
+image_id = generator["provenance"]["generator_image_id"]
+check("producer image ID source/generator", source_manifest["generator_image_id"], image_id)
+check("producer image ID audit-input path", Path(resolution["generation_producer_sources"]).name, image_id.removeprefix("sha256:"))
+producer_names = sorted(path.name for path in producer.iterdir())
+check("producer bundle file set", producer_names, ["klean.py", "klean_export.py", "source-manifest.json"])
+for filename, manifest_hash in source_manifest["files"].items():
+    actual = hashlib.sha256((producer / filename).read_bytes()).hexdigest()
+    check(f"producer {filename} source-manifest hash", actual, manifest_hash)
+check("producer klean_export.py generator-manifest hash", source_manifest["files"]["klean_export.py"], generator["exporter_sha256"])
+check("producer klean.py generator-manifest hash", source_manifest["files"]["klean.py"], generator["klean_py_sha256"])
+
+inventory = inventory_verification(root / "k-proof")
+discovery = load(root / "lemma-discovery.json")
+check("inventory whole hash discovery", inventory["inventory_sha256"], discovery["inventory_sha256"])
