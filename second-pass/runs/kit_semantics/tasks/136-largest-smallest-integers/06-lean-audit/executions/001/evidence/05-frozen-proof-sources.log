    10	  syntax Stmts ::= "lsiLoopBody" [macro]
    11	  syntax Stmts ::= "lsiBody" [macro]
    12	
    13	  syntax Bool ::= takeNeg(Int, Int) [function, total]
    14	                | takePos(Int, Int) [function, total]
    15	
    16	  syntax Int ::= nextNeg(Int, Int) [function, total]
    17	               | nextPos(Int, Int) [function, total]
    18	               | scanNeg(IntSeq, Int) [function, total]
    19	               | scanPos(IntSeq, Int) [function, total]
    20	
    21	  syntax Int ::= lastValue(IntSeq, Int) [function, total]
    22	  syntax Val ::= negativeResult(Int) [function, total]
    23	               | positiveResult(Int) [function, total]
