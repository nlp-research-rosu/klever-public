    25	
    26	module VERIFICATION-CORE
    27	  imports MPY
    28	  imports INT-VAL-REP
    29	  imports VERIFICATION-CORE-SYNTAX
    30	  imports INT
    31	  imports BOOL
    32	
    33	  rule lsiLoopBody
    34	    => If(Compare(Name("value"), CmpOp("<", Int(0))),
    35	         If(BoolOp("or",
    36	              Compare(Name("largest_negative"), CmpOp("==", Int(0))),
    37	              Compare(Name("value"), CmpOp(">", Name("largest_negative")))),
    38	            Assign(Name("largest_negative"), Name("value")),
    39	            .Stmts),
    40	         .Stmts)
    41	       If(Compare(Name("value"), CmpOp(">", Int(0))),
    42	         If(BoolOp("or",
    43	              Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
    44	              Compare(Name("value"), CmpOp("<", Name("smallest_positive")))),
    45	            Assign(Name("smallest_positive"), Name("value")),
    46	            .Stmts),
    47	         .Stmts)
    48	
    49	  rule lsiBody
    50	    => Assign(Name("largest_negative"), Int(0))
    51	       Assign(Name("smallest_positive"), Int(0))
    52	       Assign(Name("value"), Int(0))
    53	       For(Name("value"), Name("lst"), lsiLoopBody)
    54	       Return(TupleExpr(
    55	         IfExp(Compare(Name("largest_negative"), CmpOp("==", Int(0))),
    56	               NoneVal,
    57	               Name("largest_negative")),
    58	         IfExp(Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
    59	               NoneVal,
    60	               Name("smallest_positive"))))
    61	
    62	  rule takeNeg(X:Int, N:Int)
    63	    => X <Int 0 andBool (N ==Int 0 orBool X >Int N)
    64	  rule takePos(X:Int, P:Int)
    65	    => X >Int 0 andBool (P ==Int 0 orBool X <Int P)
    66	
    67	  rule nextNeg(X:Int, N:Int) => X
    68	    requires takeNeg(X, N)
    69	  rule nextNeg(X:Int, N:Int) => N
    70	    requires notBool takeNeg(X, N)
    71	
    72	  rule nextPos(X:Int, P:Int) => X
    73	    requires takePos(X, P)
    74	  rule nextPos(X:Int, P:Int) => P
    75	    requires notBool takePos(X, P)
    76	
    77	  rule scanNeg(.IntSeq, N:Int) => N
    78	  rule scanNeg(iCons(I:Int, IS:IntSeq), N:Int)
    79	    => scanNeg(IS, nextNeg(I, N))
    80	
    81	  rule scanPos(.IntSeq, P:Int) => P
    82	  rule scanPos(iCons(I:Int, IS:IntSeq), P:Int)
    83	    => scanPos(IS, nextPos(I, P))
    84	
    85	  rule lastValue(.IntSeq, CURRENT:Int) => CURRENT
    86	  rule lastValue(iCons(I:Int, IS:IntSeq), _:Int)
    87	    => lastValue(IS, I)
