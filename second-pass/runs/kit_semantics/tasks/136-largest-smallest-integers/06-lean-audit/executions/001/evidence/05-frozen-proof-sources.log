     1	requires "reference-semantics/semantics.k"
     2	
     3	module INT-VAL-REP
     4	  imports MPY
     5	
     6	  // A structural, one-for-one embedding of arbitrary finite Int sequences
     7	  // into the reference semantics' heterogeneous value-sequence sort.
     8	  syntax ValSeq ::= intVals(IntSeq)
     9	
    10	  rule intVals(.IntSeq) => .ValSeq
    11	  rule intVals(iCons(I:Int, IS:IntSeq))
    12	    => vCons(I, intVals(IS))
    13	
    14	  // Expose exactly one constructor at the only observer used by the program.
    15	  // The supplied #iterNext rules then perform the actual iteration step.
    16	  rule <k>
    17	    #iterNext(list(intVals(.IntSeq)))
    18	    => #iterNext(list(.ValSeq))
    19	    ...
    20	  </k>
    21	
    22	  rule <k>
    23	    #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
    24	    => #iterNext(list(vCons(I, intVals(IS))))
    25	    ...
    26	  </k>
    27	endmodule
