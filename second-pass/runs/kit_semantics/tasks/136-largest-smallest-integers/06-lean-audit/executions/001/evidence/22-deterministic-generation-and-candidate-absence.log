def stage_definition_driver(
    scratch: Path,
    workspace: Path,
    resolution: DefinitionResolution,
    transformed_verification: str,
    export_module_text: str,
) -> Path:
    """Mirror the frozen K closure and require each root exactly once."""

    scratch = Path(scratch)
    workspace = Path(workspace).resolve()
    source_root = scratch / "definition-source"
    source_root.mkdir()
    staged: dict[Path, Path] = {}
    for source in resolution.required_files:
        relative = source.relative_to(workspace)
        destination = source_root / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
        staged[source] = destination
    staged_verification = staged.get(resolution.verification_file)
    if staged_verification is None:
        raise KleanExportError("definition closure omitted verification.k")
    staged_verification.write_text(transformed_verification)
    entry_files: list[Path] = []
    for source in resolution.entry_files:
        entry = staged.get(source)
        if entry is None:
            raise KleanExportError("definition entry file is outside closure")
        entry_files.append(entry)
    driver = scratch / "export.k"
            "_in_keys(_)_MAP_Bool_KItem_Map",
            "_[_<-undef]",
            "Map:lookup",
            "Map:update",
        ),
    ),
)

# Canonical order of the modeled-hook identities recorded in the manifests.
_COLLECTION_HOOK_NAME_ORDER = (
    ".List",
    ".Map",
    "ListItem",
    "Map:lookup",
    "Map:update",
    "_List_",
    "_Map_",
    "_in_keys(_)_MAP_Bool_KItem_Map",
    "_[_<-undef]",
    "_|->_",
)


def _collection_hook_symbol(signature: str) -> str:
    """Recover the K symbol a registered hook axiom declares."""

    body = signature[len("axiom ") :].lstrip()
    if body.startswith("«"):
        return body[1 : body.index("»")]
    return body.split(None, 1)[0]


def model_collection_hooks(
    function_text: str,
) -> tuple[str, tuple[str, ...]]:
    """Replace Klean's unconstrained List/Map hook axioms with K models.

    The pyk exporter emits an axiom only for the collection hooks a definition
    references, so the registered families appear independently.  Every
    registered hook belongs to exactly one family, and every member of a family
    that appears must appear in full; a partially emitted family means the
    exporter produced a collection theory we do not fully model, so export
    fails closed instead of leaving an unconstrained collection axiom behind.
    """

    signature_of = {
        _collection_hook_symbol(signature): signature
        for signature in _COLLECTION_HOOK_MODELS
    }
    covered = {
        name
        for _family, members in _COLLECTION_HOOK_FAMILIES
        for name in members
    }
    if covered != set(signature_of) or set(
        _COLLECTION_HOOK_NAME_ORDER
    ) != set(signature_of):
        raise KleanExportError(
            "collection-hook family registry is inconsistent"
        )

    modeled_signatures: list[str] = []
    for family, members in _COLLECTION_HOOK_FAMILIES:
        present = [
            name for name in members if signature_of[name] in function_text
        ]
        if not present:
            continue
        missing = [
            name
            for name in members
            if signature_of[name] not in function_text
        ]
        if missing:
            raise KleanExportError(
                f"generated collection-hook family '{family}' is incomplete: "
                + ", ".join(sorted(signature_of[name] for name in missing))
            )
        modeled_signatures.extend(signature_of[name] for name in members)
    if not modeled_signatures:
        return function_text, ()

    for signature in modeled_signatures:
        if function_text.count(signature) != 1:
            raise KleanExportError(
                f"generated collection hook is not unique: {signature}"
            )
    first = min(modeled_signatures, key=function_text.index)
    repaired = function_text.replace(
        first,
        _COLLECTION_HOOK_HELPERS.rstrip()
        + "\n\n"
        + _COLLECTION_HOOK_MODELS[first],
        1,
    )
    for signature in modeled_signatures:
        if signature == first:
            continue
        repaired = repaired.replace(
            signature, _COLLECTION_HOOK_MODELS[signature], 1
        )

    modeled = {
        _collection_hook_symbol(signature)
        for signature in modeled_signatures
    }
    names = tuple(
        name for name in _COLLECTION_HOOK_NAME_ORDER if name in modeled
    )
    return repaired, names


