+requires "reference-semantics/semantics.k"
+
+module INT-VAL-REP
+  imports MPY
+
+  // A structural, one-for-one embedding of arbitrary finite Int sequences
+  // into the reference semantics' heterogeneous value-sequence sort.
+  syntax ValSeq ::= intVals(IntSeq)
+
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq))
+    => vCons(I, intVals(IS))
+
+  // Expose exactly one constructor at the only observer used by the program.
+  // The supplied #iterNext rules then perform the actual iteration step.
+  rule <k>
+    #iterNext(list(intVals(.IntSeq)))
+    => #iterNext(list(.ValSeq))
+    ...
+  </k>
+
+  rule <k>
+    #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
+    => #iterNext(list(vCons(I, intVals(IS))))
+    ...
+  </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..df37b658b36a8d64c27d53553020dca862cfaf73
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def largest_smallest_integers(lst):
+    largest_negative = 0
+    smallest_positive = 0
+    value = 0
+
+    for value in lst:
+        if value < 0:
+            if largest_negative == 0 or value > largest_negative:
+                largest_negative = value
+
+        if value > 0:
+            if smallest_positive == 0 or value < smallest_positive:
+                smallest_positive = value
+
+    return (
+        None if largest_negative == 0 else largest_negative,
+        None if smallest_positive == 0 else smallest_positive,
+    )
