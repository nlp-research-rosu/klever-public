diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..49026e61ed2d42c7846e9093e6e75c1e949a432e
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun solution.mpy --definition runtime-kompiled
+krun concrete-tests.mpy --definition runtime-kompiled
+
+kompile --backend haskell connection.k \
+  --main-module CONNECTION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition connection-kompiled
+kprove connection-spec.k \
+  --definition connection-kompiled \
+  --spec-module CONNECTION-SPEC
+
+kompile --backend haskell verification-core.k \
+  --main-module VERIFICATION-CORE \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-core-kompiled
+kprove loop-spec.k \
+  --definition verification-core-kompiled \
+  --spec-module LOOP-SPEC
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+if kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY
+then
+  echo "ERROR: false-result mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-result mutation was rejected"
+fi
+
+kompile --backend haskell body-mutation.k \
+  --main-module BODY-MUTATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition body-mutation-kompiled
+if kprove body-mutation-spec.k \
+  --definition body-mutation-kompiled \
+  --spec-module BODY-MUTATION-SPEC
+then
+  echo "ERROR: mutated body unexpectedly proved the correct result" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: mutated body was rejected"
+fi
+
+python3 differential_test.py
diff --git a/representation.k b/representation.k
new file mode 100644
index 0000000000000000000000000000000000000000..b8f9f6676f28eed87b15281afa3ab02ec4c66a01
--- /dev/null
+++ b/representation.k
@@ -0,0 +1,27 @@
+requires "reference-semantics/semantics.k"
+
+module INT-VAL-REP
+  imports MPY
+
+  // A structural, one-for-one embedding of arbitrary finite Int sequences
+  // into the reference semantics' heterogeneous value-sequence sort.
+  syntax ValSeq ::= intVals(IntSeq)
+
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq))
+    => vCons(I, intVals(IS))
+
+  // Expose exactly one constructor at the only observer used by the program.
+  // The supplied #iterNext rules then perform the actual iteration step.
+  rule <k>
+    #iterNext(list(intVals(.IntSeq)))
+    => #iterNext(list(.ValSeq))
+    ...
+  </k>
+
+  rule <k>
+    #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
+    => #iterNext(list(vCons(I, intVals(IS))))
+    ...
+  </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..df37b658b36a8d64c27d53553020dca862cfaf73
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def largest_smallest_integers(lst):
+    largest_negative = 0
+    smallest_positive = 0
+    value = 0
+
+    for value in lst:
+        if value < 0:
+            if largest_negative == 0 or value > largest_negative:
+                largest_negative = value
+
+        if value > 0:
+            if smallest_positive == 0 or value < smallest_positive:
+                smallest_positive = value
+
+    return (
+        None if largest_negative == 0 else largest_negative,
+        None if smallest_positive == 0 else smallest_positive,
+    )
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..178b368401ef756c2091411348e5b1598e84956d
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // False for the satisfiable input [-1]: the real result is (-1, None).
+  claim [false-result]:
+    <k>
+      #loadAll(Module(
+        FuncDef("largest_smallest_integers", Params("lst"), lsiBody)))
+      ~> Call(
+           Name("largest_smallest_integers"),
+           (list(intVals(iCons(-1, .IntSeq))), .Exprs))
+      => tuple(vCons(noneV, vCons(noneV, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "largest_smallest_integers"
+           |-> closureVal(("lst", .ParamNames), lsiBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c549debc6d31f1e4bb7b7ac6d697f4ddd27331d3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k> #loop(list(intVals(IS:IntSeq)), Name("value"), lsiLoopBody)
+      => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "largest_negative" |-> (N:Int => scanNeg(IS, N))
+        "lst" |-> INPUT:Val
+        "smallest_positive" |-> (P:Int => scanPos(IS, P))
+        "value" |-> (CURRENT:Int => lastValue(IS, CURRENT)),
+        parent(0))
+      0 |-> scope(
+        "largest_smallest_integers"
+          |-> closureVal(("lst", .ParamNames), lsiBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    requires N <=Int 0
+      andBool P >=Int 0
+
+  claim [entry]:
+    <k>
+      #loadAll(Module(
+        FuncDef("largest_smallest_integers", Params("lst"), lsiBody)))
+      ~> Call(Name("largest_smallest_integers"), (list(intVals(IS:IntSeq)), .Exprs))
+      => tuple(vCons(negativeResult(scanNeg(IS, 0)),
+               vCons(positiveResult(scanPos(IS, 0)), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "largest_smallest_integers"
+           |-> closureVal(("lst", .ParamNames), lsiBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification-core.k b/verification-core.k
new file mode 100644
index 0000000000000000000000000000000000000000..029aff24da83c5b19fc7b8bcac11a4a920123d7e
--- /dev/null
+++ b/verification-core.k
@@ -0,0 +1,96 @@
+requires "reference-semantics/semantics.k"
+requires "representation.k"
+
+module VERIFICATION-CORE-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+  imports INT
+  imports BOOL
+
+  syntax Stmts ::= "lsiLoopBody" [macro]
+  syntax Stmts ::= "lsiBody" [macro]
+
+  syntax Bool ::= takeNeg(Int, Int) [function, total]
+                | takePos(Int, Int) [function, total]
+
+  syntax Int ::= nextNeg(Int, Int) [function, total]
+               | nextPos(Int, Int) [function, total]
+               | scanNeg(IntSeq, Int) [function, total]
+               | scanPos(IntSeq, Int) [function, total]
+
+  syntax Int ::= lastValue(IntSeq, Int) [function, total]
+  syntax Val ::= negativeResult(Int) [function, total]
+               | positiveResult(Int) [function, total]
+endmodule
+
+module VERIFICATION-CORE
+  imports MPY
+  imports INT-VAL-REP
+  imports VERIFICATION-CORE-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule lsiLoopBody
+    => If(Compare(Name("value"), CmpOp("<", Int(0))),
+         If(BoolOp("or",
+              Compare(Name("largest_negative"), CmpOp("==", Int(0))),
+              Compare(Name("value"), CmpOp(">", Name("largest_negative")))),
+            Assign(Name("largest_negative"), Name("value")),
+            .Stmts),
+         .Stmts)
+       If(Compare(Name("value"), CmpOp(">", Int(0))),
+         If(BoolOp("or",
+              Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
+              Compare(Name("value"), CmpOp("<", Name("smallest_positive")))),
+            Assign(Name("smallest_positive"), Name("value")),
+            .Stmts),
+         .Stmts)
+
+  rule lsiBody
+    => Assign(Name("largest_negative"), Int(0))
+       Assign(Name("smallest_positive"), Int(0))
+       Assign(Name("value"), Int(0))
+       For(Name("value"), Name("lst"), lsiLoopBody)
+       Return(TupleExpr(
+         IfExp(Compare(Name("largest_negative"), CmpOp("==", Int(0))),
+               NoneVal,
+               Name("largest_negative")),
+         IfExp(Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
+               NoneVal,
+               Name("smallest_positive"))))
+
+  rule takeNeg(X:Int, N:Int)
+    => X <Int 0 andBool (N ==Int 0 orBool X >Int N)
+  rule takePos(X:Int, P:Int)
+    => X >Int 0 andBool (P ==Int 0 orBool X <Int P)
+
+  rule nextNeg(X:Int, N:Int) => X
+    requires takeNeg(X, N)
+  rule nextNeg(X:Int, N:Int) => N
+    requires notBool takeNeg(X, N)
+
+  rule nextPos(X:Int, P:Int) => X
+    requires takePos(X, P)
+  rule nextPos(X:Int, P:Int) => P
+    requires notBool takePos(X, P)
+
+  rule scanNeg(.IntSeq, N:Int) => N
+  rule scanNeg(iCons(I:Int, IS:IntSeq), N:Int)
+    => scanNeg(IS, nextNeg(I, N))
+
+  rule scanPos(.IntSeq, P:Int) => P
+  rule scanPos(iCons(I:Int, IS:IntSeq), P:Int)
+    => scanPos(IS, nextPos(I, P))
+
+  rule lastValue(.IntSeq, CURRENT:Int) => CURRENT
+  rule lastValue(iCons(I:Int, IS:IntSeq), _:Int)
+    => lastValue(IS, I)
+
+  rule negativeResult(0) => noneV
+  rule negativeResult(N:Int) => N
+    requires N =/=Int 0
+
+  rule positiveResult(0) => noneV
+  rule positiveResult(P:Int) => P
+    requires P =/=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..894efc7b58d0f5f04e69b4c909b4881b8f68c86c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "verification-core.k"
+
+module VERIFICATION
+  imports VERIFICATION-CORE
+
+  // This rule is admitted only after loop-spec.k proves the identical
+  // reachability transition against VERIFICATION-CORE, which has no such
+  // bridge.  Its arbitrary continuation and omitted cells have exactly the
+  // same framing as that connection theorem.
+  rule <k>
+    #loop(list(intVals(IS:IntSeq)), Name("value"), lsiLoopBody)
+    => .K
+    ...
+  </k>
+  <env> 1 </env>
+  <scopes>
+    1 |-> scope(
+      "largest_negative" |-> (N:Int => scanNeg(IS, N))
+      "lst" |-> INPUT:Val
+      "smallest_positive" |-> (P:Int => scanPos(IS, P))
+      "value" |-> (CURRENT:Int => lastValue(IS, CURRENT)),
+      parent(0))
+    0 |-> scope(
+      "largest_smallest_integers"
+        |-> closureVal(("lst", .ParamNames), lsiBody, 0),
+      parent(-1))
+    -1 |-> BUILTINS:Scope
+  </scopes>
+  requires N <=Int 0
+    andBool P >=Int 0
+  [priority(40)]
+endmodule

diff --git a/body-mutation-spec.k b/body-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..969fb8203f114251b477ad404fc6f66f47624056
--- /dev/null
+++ b/body-mutation-spec.k
@@ -0,0 +1,36 @@
+requires "body-mutation.k"
+
+module BODY-MUTATION-SPEC
+  imports BODY-MUTATION
+
+  // The mutated body returns (-3, None), so the correct (-1, None)
+  // postcondition must not close.
+  claim [mutated-body-rejected]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "largest_smallest_integers",
+          Params("lst"),
+          lsiMutantBody)))
+      ~> Call(
+           Name("largest_smallest_integers"),
+           (list(vCons(-3, vCons(-1, .ValSeq))), .Exprs))
+      => tuple(vCons(-1, vCons(noneV, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "largest_smallest_integers"
+           |-> closureVal(("lst", .ParamNames), lsiMutantBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/body-mutation.k b/body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..8cdc590a54ee52c1e2ddc0b8ae4d0e8e931acd9d
--- /dev/null
+++ b/body-mutation.k
@@ -0,0 +1,44 @@
+requires "verification-core.k"
+
+module BODY-MUTATION-SYNTAX
+  imports VERIFICATION-CORE-SYNTAX
+
+  syntax Stmts ::= "lsiMutantLoopBody" [macro]
+  syntax Stmts ::= "lsiMutantBody" [macro]
+endmodule
+
+module BODY-MUTATION
+  imports VERIFICATION-CORE
+  imports BODY-MUTATION-SYNTAX
+
+  // Mutation: among later negative values, choose a smaller value instead of
+  // the larger (closer-to-zero) value.
+  rule lsiMutantLoopBody
+    => If(Compare(Name("value"), CmpOp("<", Int(0))),
+         If(BoolOp("or",
+              Compare(Name("largest_negative"), CmpOp("==", Int(0))),
+              Compare(Name("value"), CmpOp("<", Name("largest_negative")))),
+            Assign(Name("largest_negative"), Name("value")),
+            .Stmts),
+         .Stmts)
+       If(Compare(Name("value"), CmpOp(">", Int(0))),
+         If(BoolOp("or",
+              Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
+              Compare(Name("value"), CmpOp("<", Name("smallest_positive")))),
+            Assign(Name("smallest_positive"), Name("value")),
+            .Stmts),
+         .Stmts)
+
+  rule lsiMutantBody
+    => Assign(Name("largest_negative"), Int(0))
+       Assign(Name("smallest_positive"), Int(0))
+       Assign(Name("value"), Int(0))
+       For(Name("value"), Name("lst"), lsiMutantLoopBody)
+       Return(TupleExpr(
+         IfExp(Compare(Name("largest_negative"), CmpOp("==", Int(0))),
+               NoneVal,
+               Name("largest_negative")),
+         IfExp(Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
+               NoneVal,
+               Name("smallest_positive"))))
+endmodule
diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..879368dd83c28725ffe6962a4c3724d805a41366
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,26 @@
+def largest_smallest_integers(lst):
+    largest_negative = 0
+    smallest_positive = 0
+    value = 0
+
+    for value in lst:
+        if value < 0:
+            if largest_negative == 0 or value > largest_negative:
+                largest_negative = value
+
+        if value > 0:
+            if smallest_positive == 0 or value < smallest_positive:
+                smallest_positive = value
+
+    return (
+        None if largest_negative == 0 else largest_negative,
+        None if smallest_positive == 0 else smallest_positive,
+    )
+
+
+assert largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)
+assert largest_smallest_integers([]) == (None, None)
+assert largest_smallest_integers([0]) == (None, None)
+assert largest_smallest_integers([-3, -1, -7]) == (-1, None)
+assert largest_smallest_integers([-3, 4, -1, 2, 0]) == (-1, 2)
+assert largest_smallest_integers([7, 2, 9]) == (None, 2)
