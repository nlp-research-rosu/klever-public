diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..06d9d11c1225b5bce2540134b5042e968e3cc055
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,30 @@
+from itertools import product
+
+from solution import largest_smallest_integers
+
+
+def oracle(values):
+    negatives = [value for value in values if value < 0]
+    positives = [value for value in values if value > 0]
+    return (
+        max(negatives) if negatives else None,
+        min(positives) if positives else None,
+    )
+
+
+checked = 0
+mismatches = []
+alphabet = range(-3, 4)
+
+for length in range(6):
+    for values in product(alphabet, repeat=length):
+        actual = largest_smallest_integers(list(values))
+        expected = oracle(values)
+        checked += 1
+        if actual != expected:
+            mismatches.append((values, actual, expected))
+
+print(f"checked={checked} mismatches={len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e64e43653910a2aa8c8641384b8a4969544eee35
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,28 @@
+requires "verification-core.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-CORE
+
+  claim [loop-connection]:
+    <k>
+      #loop(list(intVals(IS:IntSeq)), Name("value"), lsiLoopBody)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "largest_negative" |-> (N:Int => scanNeg(IS, N))
+        "lst" |-> INPUT:Val
+        "smallest_positive" |-> (P:Int => scanPos(IS, P))
+        "value" |-> (CURRENT:Int => lastValue(IS, CURRENT)),
+        parent(0))
+      0 |-> scope(
+        "largest_smallest_integers"
+          |-> closureVal(("lst", .ParamNames), lsiBody, 0),
+        parent(-1))
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    requires N <=Int 0
+      andBool P >=Int 0
+endmodule
diff --git a/representation.k b/representation.k
new file mode 100644
index 0000000000000000000000000000000000000000..b8f9f6676f28eed87b15281afa3ab02ec4c66a01
--- /dev/null
+++ b/representation.k
@@ -0,0 +1,27 @@
+requires "reference-semantics/semantics.k"
+
+module INT-VAL-REP
+  imports MPY
+
+  // A structural, one-for-one embedding of arbitrary finite Int sequences
+  // into the reference semantics' heterogeneous value-sequence sort.
+  syntax ValSeq ::= intVals(IntSeq)
+
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq))
+    => vCons(I, intVals(IS))
+
+  // Expose exactly one constructor at the only observer used by the program.
+  // The supplied #iterNext rules then perform the actual iteration step.
+  rule <k>
+    #iterNext(list(intVals(.IntSeq)))
+    => #iterNext(list(.ValSeq))
+    ...
+  </k>
+
+  rule <k>
+    #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
+    => #iterNext(list(vCons(I, intVals(IS))))
+    ...
+  </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..df37b658b36a8d64c27d53553020dca862cfaf73
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def largest_smallest_integers(lst):
+    largest_negative = 0
+    smallest_positive = 0
+    value = 0
+
+    for value in lst:
+        if value < 0:
+            if largest_negative == 0 or value > largest_negative:
+                largest_negative = value
+
+        if value > 0:
+            if smallest_positive == 0 or value < smallest_positive:
+                smallest_positive = value
+
+    return (
+        None if largest_negative == 0 else largest_negative,
+        None if smallest_positive == 0 else smallest_positive,
+    )
diff --git a/spec-vacuity.k b/spec-vacuity.k
