+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k> #loop(list(VS:ValSeq), Name("value"), lsiLoopBody)
+      => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "largest_negative" |-> (N:Int => scanNeg(VS, N))
+        "lst" |-> INPUT:Val
+        "smallest_positive" |-> (P:Int => scanPos(VS, P))
+        "value" |-> (CURRENT:Val => lastValue(VS, CURRENT)),
+        parent(0))
+      0 |-> scope(
+        "largest_smallest_integers"
+          |-> closureVal(("lst", .ParamNames), lsiBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    requires N <=Int 0
+      andBool P >=Int 0
+
+  claim [entry]:
+    <k>
+      #loadAll(Module(
+        FuncDef("largest_smallest_integers", Params("lst"), lsiBody)))
+      ~> Call(Name("largest_smallest_integers"), (list(VS:ValSeq), .Exprs))
+      => tuple(vCons(negativeResult(scanNeg(VS, 0)),
+               vCons(positiveResult(scanPos(VS, 0)), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "largest_smallest_integers"
+           |-> closureVal(("lst", .ParamNames), lsiBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..41ce3ba99f3d7728028410d71b45d74b6cb644f4
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,104 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+  imports INT
+  imports BOOL
+
+  syntax Stmts ::= "lsiLoopBody" [macro]
+  syntax Stmts ::= "lsiBody" [macro]
+
+  syntax Bool ::= takeNeg(Int, Int) [function, total]
+                | takePos(Int, Int) [function, total]
+
+  syntax Int ::= nextNeg(Int, Int) [function, total]
+               | nextPos(Int, Int) [function, total]
+               | scanNeg(ValSeq, Int) [function, total]
+               | scanPos(ValSeq, Int) [function, total]
+
+  syntax Val ::= lastValue(ValSeq, Val) [function, total]
+               | negativeResult(Int) [function, total]
+               | positiveResult(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule lsiLoopBody
+    => If(Call(Name("isinstance"), (Name("value"), Name("int"), .Exprs)),
+         If(Compare(Name("value"), CmpOp("<", Int(0))),
+           If(BoolOp("or",
+                Compare(Name("largest_negative"), CmpOp("==", Int(0))),
+                Compare(Name("value"), CmpOp(">", Name("largest_negative")))),
+              Assign(Name("largest_negative"), Name("value")),
+              .Stmts),
+           .Stmts)
+         If(Compare(Name("value"), CmpOp(">", Int(0))),
+           If(BoolOp("or",
+                Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
+                Compare(Name("value"), CmpOp("<", Name("smallest_positive")))),
+              Assign(Name("smallest_positive"), Name("value")),
+              .Stmts),
+           .Stmts),
+         .Stmts)
+
+  rule lsiBody
+    => Assign(Name("largest_negative"), Int(0))
+       Assign(Name("smallest_positive"), Int(0))
+       Assign(Name("value"), Int(0))
+       For(Name("value"), Name("lst"), lsiLoopBody)
+       Return(TupleExpr(
+         IfExp(Compare(Name("largest_negative"), CmpOp("==", Int(0))),
+               NoneVal,
+               Name("largest_negative")),
+         IfExp(Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
+               NoneVal,
+               Name("smallest_positive"))))
+
+  rule takeNeg(X:Int, N:Int)
+    => X <Int 0 andBool (N ==Int 0 orBool X >Int N)
+  rule takePos(X:Int, P:Int)
+    => X >Int 0 andBool (P ==Int 0 orBool X <Int P)
+
+  rule nextNeg(X:Int, N:Int) => X
+    requires takeNeg(X, N)
+  rule nextNeg(X:Int, N:Int) => N
+    requires notBool takeNeg(X, N)
+
+  rule nextPos(X:Int, P:Int) => X
+    requires takePos(X, P)
+  rule nextPos(X:Int, P:Int) => P
+    requires notBool takePos(X, P)
+
+  rule scanNeg(.ValSeq, N:Int) => N
+  rule scanNeg(vCons(V:Val, VS:ValSeq), N:Int)
+    => scanNeg(VS, nextNeg({V}:>Int, N))
+    requires isInt(V)
+  rule scanNeg(vCons(V:Val, VS:ValSeq), N:Int)
+    => scanNeg(VS, N)
+    requires notBool isInt(V)
+
+  rule scanPos(.ValSeq, P:Int) => P
+  rule scanPos(vCons(V:Val, VS:ValSeq), P:Int)
+    => scanPos(VS, nextPos({V}:>Int, P))
+    requires isInt(V)
+  rule scanPos(vCons(V:Val, VS:ValSeq), P:Int)
+    => scanPos(VS, P)
+    requires notBool isInt(V)
+
+  rule lastValue(.ValSeq, CURRENT:Val) => CURRENT
+  rule lastValue(vCons(V:Val, VS:ValSeq), _:Val)
+    => lastValue(VS, V)
+
+  rule negativeResult(0) => noneV
+  rule negativeResult(N:Int) => N
+    requires N =/=Int 0
+
+  rule positiveResult(0) => noneV
+  rule positiveResult(P:Int) => P
+    requires P =/=Int 0
+endmodule

