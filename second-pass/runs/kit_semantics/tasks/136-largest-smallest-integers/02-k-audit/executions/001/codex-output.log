+    require_plain_file(AUDIT_INPUT)
+    audit = json.loads(AUDIT_INPUT.read_text(encoding="utf-8"))
+    if audit["record_layout"] != "pipeline-v3":
+        raise AssertionError(f"unexpected layout: {audit['record_layout']}")
