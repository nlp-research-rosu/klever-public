     6	def largest_smallest_integers(lst):
     7	    '''
     8	    Create a function that returns a tuple (a, b), where 'a' is
     9	    the largest of negative integers, and 'b' is the smallest
    10	    of positive integers in a list.
    11	    If there is no negative or positive integers, return them as None.
    12	
    13	    Examples:
    14	    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)
    15	    largest_smallest_integers([]) == (None, None)
    16	    largest_smallest_integers([0]) == (None, None)
    17	    '''
    18	    smallest = list(filter(lambda x: x < 0, lst))
    19	    largest = list(filter(lambda x: x > 0, lst))
    20	    return (max(smallest) if smallest else None, min(largest) if largest else None)

