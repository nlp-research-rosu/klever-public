@@ -0,0 +1,2 @@
+Module(
+  FuncDef("largest_smallest_integers", Params("lst"), lsiBody))
diff --git a//tmp/audit-work/review-136/concrete-probe.py b//tmp/audit-work/review-136/concrete-probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..40246e461161ddbc95970ead05102fd03bb01f18
--- /dev/null
+++ b//tmp/audit-work/review-136/concrete-probe.py
@@ -0,0 +1,29 @@
+def largest_smallest_integers(lst):
+    largest_negative = 0
+    smallest_positive = 0
+    value = 0
+
+    for value in lst:
+        if value < 0:
+            if largest_negative == 0 or value > largest_negative:
+                largest_negative = value
+
+        if value > 0:
+            if smallest_positive == 0 or value < smallest_positive:
+                smallest_positive = value
+
+    return (
+        None if largest_negative == 0 else largest_negative,
+        None if smallest_positive == 0 else smallest_positive,
+    )
+
+
+assert largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)
+assert largest_smallest_integers([]) == (None, None)
+assert largest_smallest_integers([0]) == (None, None)
+assert largest_smallest_integers([-3, -1, 0, 4, 2]) == (-1, 2)
+assert largest_smallest_integers([-1, -3, 3, 1]) == (-1, 1)
+assert largest_smallest_integers([-100000000000000000000, 100000000000000000000]) == (
+    -100000000000000000000,
+    100000000000000000000,
+)
