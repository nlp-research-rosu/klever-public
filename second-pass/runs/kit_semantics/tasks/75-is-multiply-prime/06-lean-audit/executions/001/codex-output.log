/bin/bash -lc "script -q -e -c \"bash -lc 'export PYTHONPATH=/reference; python3 /tmp/audit-work/verify_recorded_hashes.py; printf \\\"verify_recorded_hashes_exit=%s\\\\n\\\" \\\"\\"'$?'"\\\"'\" /audit-output/evidence/14_recorded_hash_reconciliation.txt" in /audit-output
