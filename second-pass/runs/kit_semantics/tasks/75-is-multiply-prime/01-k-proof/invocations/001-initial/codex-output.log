module MPY
  imports MPY-CORE
  imports MPY-ITER
  imports MPY-RANGE
  imports MPY-OPERATORS
  imports MPY-INT
  imports MPY-BOOL
  imports MPY-FLOAT
  imports MPY-STR
  imports MPY-SET
  imports MPY-LIST
  imports MPY-TUPLE
  imports MPY-SUBSCRIPT
  imports MPY-COMPREHENSION
  imports MPY-METHODS
  imports MPY-CONTROLS
  imports MPY-FUNCTIONS
  imports MPY-BUILTINS
  imports MPY-CALL
  imports MPY-SORT
  imports MPY-ASSERT
  imports MPY-DICT
