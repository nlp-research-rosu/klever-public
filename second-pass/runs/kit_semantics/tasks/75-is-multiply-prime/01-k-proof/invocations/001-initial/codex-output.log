@@ -0,0 +1,5 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+endmodule

exec
/bin/bash -lc 'set +e
kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY --claims SPEC-VACUITY.false-postcondition > vacuity.out 2>&1
vacuity_status=$?
kprove spec-body-mutation.k --definition verification-kompiled --spec-module SPEC-BODY-MUTATION --claims SPEC-BODY-MUTATION.changed-body > body-mutation.out 2>&1
body_status=$?
printf '"'vacuity_exit=%s\\nbody_mutation_exit=%s\\n' \""'$vacuity_status" "$body_status"
printf '"'%s\\n' 'vacuity residual:'
rg -n '#Top|WarnStuckClaimState|implication check|cannot be rewritten|Error' vacuity.out | tail -n 12
printf '%s\\n' 'body residual:'
rg -n '#Top|WarnStuckClaimState|implication check|cannot be rewritten|Error' body-mutation.out | tail -n 12
exit 0" in /workspace
