+from solution import is_multiply_prime
+
+
+def oracle(a):
+    factors = 0
+    divisor = 2
+    remaining = a
+    while divisor * divisor <= remaining:
+        while remaining % divisor == 0:
+            factors += 1
+            remaining //= divisor
+        divisor += 1
+    if remaining > 1:
+        factors += 1
+    return factors == 3
