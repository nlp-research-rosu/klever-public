COMMAND: nl -ba /reference/k-proof/verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Exact statement body emitted in solution.mpy.  These two macro rules are
     7	  // syntax abbreviations only: after macro expansion the fixed MPY rules
     8	  // execute the real function definition, call, body, and return.
     9	  syntax Stmts ::= "bfBody" [macro]
    10	  rule bfBody =>
    11	    Assign(
    12	      Name("planets"),
    13	      TupleExpr(
    14	        Str("Mercury"),
    15	        Str("Venus"),
    16	        Str("Earth"),
    17	        Str("Mars"),
    18	        Str("Jupiter"),
    19	        Str("Saturn"),
    20	        Str("Uranus"),
    21	        Str("Neptune")))
    22	    If(
    23	      BoolOp(
    24	        "or",
    25	        Compare(Name("planet1"), CmpOp("not in", Name("planets"))),
    26	        Compare(Name("planet2"), CmpOp("not in", Name("planets")))),
    27	      Return(TupleExpr(.Exprs)),
    28	      .Stmts)
    29	    Assign(
    30	      Name("index1"),
    31	      Call(Attribute(Name("planets"), "index"), Name("planet1")))
    32	    Assign(
    33	      Name("index2"),
    34	      Call(Attribute(Name("planets"), "index"), Name("planet2")))
    35	    If(
    36	      Compare(Name("index1"), CmpOp("<", Name("index2"))),
    37	      Return(
    38	        Subscript(
    39	          Name("planets"),
    40	          Slice(
    41	            BinOp("+", Name("index1"), Int(1)),
    42	            Name("index2"),
    43	            NoBound))),
    44	      .Stmts)
    45	    Return(
    46	      Subscript(
    47	        Name("planets"),
    48	        Slice(
    49	          BinOp("+", Name("index2"), Int(1)),
    50	          Name("index1"),
    51	          NoBound)))
    52	
    53	  syntax Module ::= "bfModule" [macro]
    54	  rule bfModule =>
    55	    Module(FuncDef("bf", Params("planet1", "planet2"), bfBody))
    56	
    57	  syntax Expr ::= bfCall(IntSeq, IntSeq) [macro]
    58	  rule bfCall(P1, P2) =>
    59	    Call(Name("bf"), str(P1), str(P2))
    60	
    61	  // Mathematical model of the ordered planet names.
    62	  syntax ValSeq ::= "planetValues" [function, total]
    63	  rule planetValues =>
    64	    vCons(str(strToCodes("Mercury")),
    65	    vCons(str(strToCodes("Venus")),
    66	    vCons(str(strToCodes("Earth")),
    67	    vCons(str(strToCodes("Mars")),
    68	    vCons(str(strToCodes("Jupiter")),
    69	    vCons(str(strToCodes("Saturn")),
    70	    vCons(str(strToCodes("Uranus")),
    71	    vCons(str(strToCodes("Neptune")), .ValSeq))))))))
    72	
    73	  // -1 means that the supplied string is not a planet name.
    74	  syntax Int ::= planetIndex(IntSeq) [function, total]
    75	  rule planetIndex(P) => 0 requires P ==K strToCodes("Mercury")
    76	  rule planetIndex(P) => 1 requires P ==K strToCodes("Venus")
    77	  rule planetIndex(P) => 2 requires P ==K strToCodes("Earth")
    78	  rule planetIndex(P) => 3 requires P ==K strToCodes("Mars")
    79	  rule planetIndex(P) => 4 requires P ==K strToCodes("Jupiter")
    80	  rule planetIndex(P) => 5 requires P ==K strToCodes("Saturn")
    81	  rule planetIndex(P) => 6 requires P ==K strToCodes("Uranus")
    82	  rule planetIndex(P) => 7 requires P ==K strToCodes("Neptune")
    83	  rule planetIndex(P) => -1
    84	    requires notBool (P ==K strToCodes("Mercury"))
    85	     andBool notBool (P ==K strToCodes("Venus"))
    86	     andBool notBool (P ==K strToCodes("Earth"))
    87	     andBool notBool (P ==K strToCodes("Mars"))
    88	     andBool notBool (P ==K strToCodes("Jupiter"))
    89	     andBool notBool (P ==K strToCodes("Saturn"))
    90	     andBool notBool (P ==K strToCodes("Uranus"))
    91	     andBool notBool (P ==K strToCodes("Neptune"))
    92	
    93	  syntax ValSeq ::= betweenPlanets(IntSeq, IntSeq) [function, total]
    94	  rule betweenPlanets(P1, P2) =>
    95	    betweenIndices(planetIndex(P1), planetIndex(P2))
    96	
    97	  syntax ValSeq ::= betweenIndices(Int, Int) [function, total]
    98	  rule betweenIndices(I, J) => .ValSeq
    99	    requires I <Int 0 orBool J <Int 0
   100	  rule betweenIndices(I, J) => buildVS(planetValues, I +Int 1, J, 1)
   101	    requires I >=Int 0 andBool J >=Int 0 andBool I <Int J
   102	  rule betweenIndices(I, J) => buildVS(planetValues, J +Int 1, I, 1)
   103	    requires I >=Int 0 andBool J >=Int 0 andBool I >=Int J
   104	endmodule

