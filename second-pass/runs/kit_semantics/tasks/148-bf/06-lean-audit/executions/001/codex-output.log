+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract, stage6_resolution_contract
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+K_PROOF = Path("/reference/k-proof")
+K_AUDIT = Path("/reference/k-audit")
+DISCOVERY = Path("/reference/lemma-discovery.json")
+GENERATION = Path("/reference/klean-generation")
+GENERATED = GENERATION / "generated"
+PRODUCERS = Path("/reference/generation-tools")
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def main() -> None:
+    document = json.loads(AUDIT_INPUT.read_text())
+    resolution, resolved_digest = stage6_resolution_contract.verify_audit_input(
+        document
+    )
+    hashes = resolution["hashes"]
+    generator_manifest = json.loads(
+        (GENERATION / "generator-manifest.json").read_text()
+    )
+    source_manifest = json.loads((PRODUCERS / "source-manifest.json").read_text())
+    preflight = json.loads((GENERATION / "preflight.json").read_text())
+    export_result = json.loads((GENERATION / "export-result.json").read_text())
+
+    stage1_paths = {
+        path.relative_to(K_PROOF).as_posix(): path
+        for path in pipeline_contract._walk_regular_files(
+            K_PROOF, "mounted Stage 1 workspace"
+        )
+    }
+    expected_stage1 = resolution["stage1_source_hashes"]
+    all_stage1_names = sorted(set(stage1_paths) | set(expected_stage1))
+    stage1_results = []
+    for name in all_stage1_names:
+        actual = file_sha256(stage1_paths[name]) if name in stage1_paths else None
+        expected = expected_stage1.get(name)
+        stage1_results.append(
+            {
+                "path": name,
+                "expected_sha256": expected,
+                "actual_sha256": actual,
+                "match": expected == actual,
+            }
+        )
+
+    actual_hashes = {
+        "k_workspace_sha256": pipeline_contract.sha256_tree(K_PROOF),
+        "stage1_export_sha256": klean_export.tree_digest(K_PROOF),
+        "discovery_manifest_sha256": file_sha256(DISCOVERY),
+        "k_audit_sha256": pipeline_contract.sha256_tree(K_AUDIT),
+        "klean_generation_sha256": pipeline_contract.sha256_tree(GENERATION),
+        "generation_producer_sources_sha256": pipeline_contract.sha256_tree(
+            PRODUCERS
+        ),
+        "generated_tree_sha256": klean_export.tree_digest(GENERATED),
+        "lean_workspace_sha256": None,
+        "lean_invocation_sha256": None,
+    }
+
+    producer_actual = {
+        name: file_sha256(PRODUCERS / name)
+        for name in ("klean_export.py", "klean.py")
+    }
+    producer_expected_generator = {
+        "klean_export.py": generator_manifest["exporter_sha256"],
+        "klean.py": generator_manifest["klean_py_sha256"],
+    }
+    generator_image_id = generator_manifest["provenance"]["generator_image_id"]
+    audit_image_key = Path(resolution["generation_producer_sources"]).name
+    mounted_producer_entries = sorted(
+        path.relative_to(PRODUCERS).as_posix()
+        for path in pipeline_contract._walk_regular_files(
+            PRODUCERS, "mounted producer sources"
+        )
+    )
+
+    checks = {
+        "audit_mode_environment_matches": (
+            os.environ.get("AUDIT_MODE") == resolution["mode"]
+        ),
+        "resolved_input_sha256_valid": (
+            resolved_digest == document["resolved_input_sha256"]
+        ),
+        "problem_id": resolution["problem_id"] == "148-bf",
+        "condition": resolution["condition"] == "kit-semantics",
+        "semantics_mode": resolution["semantics_mode"] == "SUPPLIED_SEMANTICS",
+        "all_resolution_hashes_match": actual_hashes == hashes,
+        "all_stage1_source_hashes_match": all(
+            result["match"] for result in stage1_results
+        ),
+        "stage1_source_file_set_exact": set(stage1_paths) == set(expected_stage1),
+        "producer_bundle_file_set_exact": mounted_producer_entries
+        == ["klean.py", "klean_export.py", "source-manifest.json"],
+        "producer_file_hashes_match_generator_manifest": (
+            producer_actual == producer_expected_generator
+        ),
+        "producer_file_hashes_match_source_manifest": (
+            producer_actual == source_manifest["files"]
+        ),
+        "producer_source_manifest_file_map_matches_generator_manifest": (
+            source_manifest["files"] == producer_expected_generator
+        ),
+        "generator_image_id_matches_source_manifest": (
+            generator_image_id == source_manifest["generator_image_id"]
+        ),
+        "generator_image_id_matches_audit_input_path": (
+            generator_image_id == f"sha256:{audit_image_key}"
+        ),
+        "producer_tree_hash_matches_audit_input": (
+            actual_hashes["generation_producer_sources_sha256"]
+            == hashes["generation_producer_sources_sha256"]
+        ),
+        "generator_tree_hash_matches_manifest": (
+            actual_hashes["generated_tree_sha256"]
+            == generator_manifest["generated_tree_sha256"]
+        ),
+        "resolution_target_matches_generator_manifest": (
+            resolution["target"] == generator_manifest["target"]
+        ),
+        "recorded_preflight_matches_file": resolution["stage4_preflight"]
+        == preflight,
+        "stage4_status_consistent": (
+            resolution["selections"]["klean_generation"]["status"]
+            == preflight["status"]
+            == export_result["status"]
+            == "KLEAN_NO_OBLIGATIONS"
+        ),
+        "classification_only_has_no_lean_input": (
+            resolution["mode"] == "CLASSIFICATION_ONLY"
+            and resolution["lean_workspace"] is None
+            and resolution["lean_invocation"] is None
+            and resolution["stage5_result"] is None
+            and not (Path("/candidate").exists() or Path("/candidate").is_symlink())
+        ),
+        "no_generated_target": generator_manifest["target"] is None,
+    }
+
+    report = {
+        "checks": checks,
+        "all_checks_pass": all(checks.values()),
+        "audit_mode_environment": os.environ.get("AUDIT_MODE"),
+        "audit_mode_recorded": resolution["mode"],
+        "resolved_input_sha256": resolved_digest,
+        "expected_resolution_hashes": hashes,
+        "actual_resolution_hashes": actual_hashes,
+        "stage1_source_hash_count_expected": len(expected_stage1),
+        "stage1_source_hash_count_actual": len(stage1_paths),
+        "stage1_source_hash_mismatch_count": sum(
+            not result["match"] for result in stage1_results
+        ),
+        "stage1_source_hash_results": stage1_results,
+        "producer_actual_sha256": producer_actual,
+        "producer_expected_from_generator_manifest": producer_expected_generator,
+        "producer_source_manifest": source_manifest,
+        "generator_image_id": generator_image_id,
+        "audit_input_producer_path_image_key": audit_image_key,
+        "mounted_producer_entries": mounted_producer_entries,
+        "generator_manifest_target": generator_manifest["target"],
+        "selected_stage4_status": resolution["selections"]["klean_generation"][
+            "status"
+        ],
+    }
+    print(json.dumps(report, indent=2, sort_keys=True))
+    if not report["all_checks_pass"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a//tmp/audit-work/reconstruct_inventory.py b//tmp/audit-work/reconstruct_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..4e2affc4a45d844ebb36cf71fd8ef8652ab5219d
--- /dev/null
+++ b//tmp/audit-work/reconstruct_inventory.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import k_rule_inventory, lemma_discovery_contract
+
+
+WORKSPACE = Path("/reference/k-proof")
+DISCOVERY = Path("/reference/lemma-discovery.json")
+
+
+def main() -> None:
+    inventory = k_rule_inventory.inventory_verification(WORKSPACE)
+    manifest = json.loads(DISCOVERY.read_text())
+    validated = lemma_discovery_contract.validate_trust_boundary(
+        WORKSPACE, DISCOVERY
+    )
+    source_lines = (WORKSPACE / "verification.k").read_text().splitlines()
+    manifest_ids = [entry["source_rule_id"] for entry in manifest["rules"]]
+    inventory_ids = [rule["source_rule_id"] for rule in inventory["rules"]]
+    classified = {
+        entry["source_rule_id"]: entry for entry in manifest["rules"]
+    }
+    rule_results = []
+    for rule in inventory["rules"]:
+        reconstructed_text = "\n".join(
+            source_lines[rule["start_line"] - 1 : rule["end_line"]]
+        )
+        normalized = " ".join(reconstructed_text.split())
+        digest = hashlib.sha256(normalized.encode()).hexdigest()
+        classification = classified[rule["source_rule_id"]]["classification"]
+        rule_results.append(
+            {
+                **rule,
+                "classification": classification,
+                "rationale": classified[rule["source_rule_id"]]["rationale"],
+                "reconstructed_text_matches": reconstructed_text == rule["text"],
+                "recomputed_normalized_sha256": digest,
+                "normalized_sha256_matches": digest
+                == rule["normalized_sha256"],
+                "source_rule_id_matches": rule["source_rule_id"]
+                == f"rule-{digest}",
+                "simplification_class_allowed": (
+                    "simplification" not in rule["attributes"]
+                    or classification in {"DEFINITION", "DOMAIN_LEMMA"}
+                ),
+            }
+        )
+    recomputed_inventory_hash = k_rule_inventory.canonical_json_sha256(
+        inventory["rules"]
+    )
+    checks = {
+        "verification_module": inventory["verification_module"]
+        == "VERIFICATION",
+        "verification_module_closure": inventory["verification_modules"]
+        == ["VERIFICATION"],
+        "rule_count": len(inventory["rules"]) == 17,
+        "source_spans_and_hashes_recomputed": all(
+            entry["reconstructed_text_matches"]
+            and entry["normalized_sha256_matches"]
+            and entry["source_rule_id_matches"]
+            for entry in rule_results
+        ),
+        "whole_inventory_hash_recomputed": recomputed_inventory_hash
+        == inventory["inventory_sha256"],
+        "manifest_inventory_hash_matches": manifest["inventory_sha256"]
+        == inventory["inventory_sha256"],
+        "identity_order_exact": manifest_ids == inventory_ids,
+        "identity_set_exact": set(manifest_ids) == set(inventory_ids),
+        "no_manifest_duplicates": len(manifest_ids) == len(set(manifest_ids)),
+        "every_rule_classified": len(manifest_ids) == len(inventory_ids),
+        "simplification_classifications_allowed": all(
+            entry["simplification_class_allowed"] for entry in rule_results
+        ),
+        "trusted_contract_validation_succeeded": len(validated["rules"])
+        == len(inventory["rules"]),
+    }
+    report = {
+        "checks": checks,
+        "all_checks_pass": all(checks.values()),
+        "inventory_summary": {
+            key: value for key, value in inventory.items() if key != "rules"
+        },
+        "recomputed_inventory_sha256": recomputed_inventory_hash,
+        "manifest_identity_order": manifest_ids,
+        "inventory_identity_order": inventory_ids,
+        "classification_counts": {
+            role: sum(
+                entry["classification"] == role for entry in manifest["rules"]
+            )
+            for role in (
+                "DEFINITION",
+                "OPERATIONAL_RULE",
+                "PROVED_DERIVED_LEMMA",
+                "DOMAIN_LEMMA",
+            )
+        },
+        "rules": rule_results,
+    }
+    print(json.dumps(report, indent=2, sort_keys=True))
+    if not report["all_checks_pass"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
