diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9622f21d6134997b960087d86f4f843636ebadf4
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '\nEXIT_STATUS: %d\n' "$status"
+  exit "$status"
+} >"$log" 2>&1

exec
/bin/bash -lc "toolroot=/opt/elan/toolchains/leanprover--lean4---v4.22.0
for setting in \\
  \"LEAN_PATH="'$toolroot/lib/lean" '"\\
  \"LEAN_SYSROOT="'$toolroot LEAN_PATH=$toolroot/lib/lean" '"\\
  \"LEAN_HOME="'$toolroot LEAN_PATH=$toolroot/lib/lean"; do
  printf '"'SETTING %s\\n' \""'$setting"
  env $setting "$toolroot/bin/lean" --version 2>&1 || true
done
strings "$toolroot/lib/lean/libleanshared.so" | rg -n '"'LEAN_(PATH|SYSROOT|HOME)|lean_sysroot|print-prefix' | head -100" in /audit-output
