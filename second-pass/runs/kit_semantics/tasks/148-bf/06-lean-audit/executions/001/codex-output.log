{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 51,
      "module": "VERIFICATION",
      "normalized_sha256": "0629da93c5130935249ecfa4991c65d2afaaca2b33ec20afc6a779f158c11014",
      "rationale": "This macro equation expands bfBody into the exact MPY statement term for the submitted function, so it defines a named program term rather than adding an execution or mathematical fact.",
      "source_rule_id": "rule-0629da93c5130935249ecfa4991c65d2afaaca2b33ec20afc6a779f158c11014",
      "start_line": 10,
      "text": "  rule bfBody =>\n    Assign(\n      Name(\"planets\"),\n      TupleExpr(\n        Str(\"Mercury\"),\n        Str(\"Venus\"),\n        Str(\"Earth\"),\n        Str(\"Mars\"),\n        Str(\"Jupiter\"),\n        Str(\"Saturn\"),\n        Str(\"Uranus\"),\n        Str(\"Neptune\")))\n    If(\n      BoolOp(\n        \"or\",\n        Compare(Name(\"planet1\"), CmpOp(\"not in\", Name(\"planets\"))),\n        Compare(Name(\"planet2\"), CmpOp(\"not in\", Name(\"planets\")))),\n      Return(TupleExpr(.Exprs)),\n      .Stmts)\n    Assign(\n      Name(\"index1\"),\n      Call(Attribute(Name(\"planets\"), \"index\"), Name(\"planet1\")))\n    Assign(\n      Name(\"index2\"),\n      Call(Attribute(Name(\"planets\"), \"index\"), Name(\"planet2\")))\n    If(\n      Compare(Name(\"index1\"), CmpOp(\"<\", Name(\"index2\"))),\n      Return(\n        Subscript(\n          Name(\"planets\"),\n          Slice(\n            BinOp(\"+\", Name(\"index1\"), Int(1)),\n            Name(\"index2\"),\n            NoBound))),\n      .Stmts)\n    Return(\n      Subscript(\n        Name(\"planets\"),\n        Slice(\n          BinOp(\"+\", Name(\"index2\"), Int(1)),\n          Name(\"index1\"),\n          NoBound)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 55,
      "module": "VERIFICATION",
      "normalized_sha256": "6bd0b985697081bba61414fe0cb7e6c71e74e938dc9839ce970e8282328ed6df",
      "rationale": "This macro equation expands bfModule into the module containing the bf definition and therefore is a structural definition of a named proof term.",
      "source_rule_id": "rule-6bd0b985697081bba61414fe0cb7e6c71e74e938dc9839ce970e8282328ed6df",
      "start_line": 54,
      "text": "  rule bfModule =>\n    Module(FuncDef(\"bf\", Params(\"planet1\", \"planet2\"), bfBody))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 59,
      "module": "VERIFICATION",
      "normalized_sha256": "88469b06cedfdd9bc9231dd866cbabd952ef4e833651c4773ab66caa83e829fd",
      "rationale": "This macro equation expands bfCall into the ordinary MPY Call term with two string arguments, defining entry syntax without replacing call execution.",
      "source_rule_id": "rule-88469b06cedfdd9bc9231dd866cbabd952ef4e833651c4773ab66caa83e829fd",
      "start_line": 58,
      "text": "  rule bfCall(P1, P2) =>\n    Call(Name(\"bf\"), str(P1), str(P2))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 71,
      "module": "VERIFICATION",
      "normalized_sha256": "253ec3e1f18c2bc078c0f545ec4ee0507f3f8493dc5d2c771d4a7096479972a1",
      "rationale": "This equation defines planetValues as the fixed ordered eight-element planet sequence used by the mathematical postcondition.",
      "source_rule_id": "rule-253ec3e1f18c2bc078c0f545ec4ee0507f3f8493dc5d2c771d4a7096479972a1",
      "start_line": 63,
      "text": "  rule planetValues =>\n    vCons(str(strToCodes(\"Mercury\")),\n    vCons(str(strToCodes(\"Venus\")),\n    vCons(str(strToCodes(\"Earth\")),\n    vCons(str(strToCodes(\"Mars\")),\n    vCons(str(strToCodes(\"Jupiter\")),\n    vCons(str(strToCodes(\"Saturn\")),\n    vCons(str(strToCodes(\"Uranus\")),\n    vCons(str(strToCodes(\"Neptune\")), .ValSeq))))))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 75,
      "module": "VERIFICATION",
      "normalized_sha256": "d4d0231b5462732c3739470808deffd92ea65132f2d1e22a1deb0340bdeeda2a",
      "rationale": "This guarded equation is the Mercury case of the total planetIndex definition, assigning index 0 exactly when the input code sequence is Mercury.",
      "source_rule_id": "rule-d4d0231b5462732c3739470808deffd92ea65132f2d1e22a1deb0340bdeeda2a",
      "start_line": 75,
      "text": "  rule planetIndex(P) => 0 requires P ==K strToCodes(\"Mercury\")"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 76,
      "module": "VERIFICATION",
