@@ -0,0 +1,187 @@
+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract, stage6_resolution_contract
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+K_PROOF = Path("/reference/k-proof")
+K_AUDIT = Path("/reference/k-audit")
+DISCOVERY = Path("/reference/lemma-discovery.json")
+GENERATION = Path("/reference/klean-generation")
+GENERATED = GENERATION / "generated"
+PRODUCERS = Path("/reference/generation-tools")
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def main() -> None:
+    document = json.loads(AUDIT_INPUT.read_text())
+    resolution, resolved_digest = stage6_resolution_contract.verify_audit_input(
+        document
+    )
+    hashes = resolution["hashes"]
+    generator_manifest = json.loads(
+        (GENERATION / "generator-manifest.json").read_text()
+    )
+    source_manifest = json.loads((PRODUCERS / "source-manifest.json").read_text())
+    preflight = json.loads((GENERATION / "preflight.json").read_text())
+    export_result = json.loads((GENERATION / "export-result.json").read_text())
+
+    stage1_paths = {
+        path.relative_to(K_PROOF).as_posix(): path
+        for path in pipeline_contract._walk_regular_files(
+            K_PROOF, "mounted Stage 1 workspace"
+        )
+    }
+    expected_stage1 = resolution["stage1_source_hashes"]
+    all_stage1_names = sorted(set(stage1_paths) | set(expected_stage1))
+    stage1_results = []
+    for name in all_stage1_names:
+        actual = file_sha256(stage1_paths[name]) if name in stage1_paths else None
+        expected = expected_stage1.get(name)
+        stage1_results.append(
+            {
+                "path": name,
+                "expected_sha256": expected,
+                "actual_sha256": actual,
+                "match": expected == actual,
+            }
+        )
+
+    actual_hashes = {
+        "k_workspace_sha256": pipeline_contract.sha256_tree(K_PROOF),
+        "stage1_export_sha256": klean_export.tree_digest(K_PROOF),
+        "discovery_manifest_sha256": file_sha256(DISCOVERY),
+        "k_audit_sha256": pipeline_contract.sha256_tree(K_AUDIT),
+        "klean_generation_sha256": pipeline_contract.sha256_tree(GENERATION),
+        "generation_producer_sources_sha256": pipeline_contract.sha256_tree(
+            PRODUCERS
+        ),
+        "generated_tree_sha256": klean_export.tree_digest(GENERATED),
+        "lean_workspace_sha256": None,
+        "lean_invocation_sha256": None,
+    }
+
+    producer_actual = {
+        name: file_sha256(PRODUCERS / name)
+        for name in ("klean_export.py", "klean.py")
+    }
+    producer_expected_generator = {
+        "klean_export.py": generator_manifest["exporter_sha256"],
+        "klean.py": generator_manifest["klean_py_sha256"],
+    }
+    generator_image_id = generator_manifest["provenance"]["generator_image_id"]
+    audit_image_key = Path(resolution["generation_producer_sources"]).name
+    mounted_producer_entries = sorted(
+        path.relative_to(PRODUCERS).as_posix()
+        for path in pipeline_contract._walk_regular_files(
+            PRODUCERS, "mounted producer sources"
+        )
+    )
+
+    checks = {
+        "audit_mode_environment_matches": (
+            os.environ.get("AUDIT_MODE") == resolution["mode"]
+        ),
+        "resolved_input_sha256_valid": (
+            resolved_digest == document["resolved_input_sha256"]
+        ),
+        "problem_id": resolution["problem_id"] == "148-bf",
+        "condition": resolution["condition"] == "kit-semantics",
+        "semantics_mode": resolution["semantics_mode"] == "SUPPLIED_SEMANTICS",
+        "all_resolution_hashes_match": actual_hashes == hashes,
+        "all_stage1_source_hashes_match": all(
+            result["match"] for result in stage1_results
+        ),
+        "stage1_source_file_set_exact": set(stage1_paths) == set(expected_stage1),
+        "producer_bundle_file_set_exact": mounted_producer_entries
+        == ["klean.py", "klean_export.py", "source-manifest.json"],
+        "producer_file_hashes_match_generator_manifest": (
+            producer_actual == producer_expected_generator
+        ),
+        "producer_file_hashes_match_source_manifest": (
+            producer_actual == source_manifest["files"]
+        ),
+        "producer_source_manifest_file_map_matches_generator_manifest": (
+            source_manifest["files"] == producer_expected_generator
+        ),
+        "generator_image_id_matches_source_manifest": (
+            generator_image_id == source_manifest["generator_image_id"]
+        ),
+        "generator_image_id_matches_audit_input_path": (
+            generator_image_id == f"sha256:{audit_image_key}"
+        ),
+        "producer_tree_hash_matches_audit_input": (
+            actual_hashes["generation_producer_sources_sha256"]
+            == hashes["generation_producer_sources_sha256"]
+        ),
+        "generator_tree_hash_matches_manifest": (
+            actual_hashes["generated_tree_sha256"]
+            == generator_manifest["generated_tree_sha256"]
+        ),
+        "resolution_target_matches_generator_manifest": (
+            resolution["target"] == generator_manifest["target"]
+        ),
+        "recorded_preflight_matches_file": resolution["stage4_preflight"]
+        == preflight,
+        "stage4_status_consistent": (
+            resolution["selections"]["klean_generation"]["status"]
+            == preflight["status"]
+            == export_result["status"]
+            == "KLEAN_NO_OBLIGATIONS"
+        ),
+        "classification_only_has_no_lean_input": (
+            resolution["mode"] == "CLASSIFICATION_ONLY"
+            and resolution["lean_workspace"] is None
+            and resolution["lean_invocation"] is None
+            and resolution["stage5_result"] is None
+            and not (Path("/candidate").exists() or Path("/candidate").is_symlink())
+        ),
+        "no_generated_target": generator_manifest["target"] is None,
+    }
+
+    report = {
+        "checks": checks,
+        "all_checks_pass": all(checks.values()),
+        "audit_mode_environment": os.environ.get("AUDIT_MODE"),
+        "audit_mode_recorded": resolution["mode"],
+        "resolved_input_sha256": resolved_digest,
+        "expected_resolution_hashes": hashes,
+        "actual_resolution_hashes": actual_hashes,
+        "stage1_source_hash_count_expected": len(expected_stage1),
+        "stage1_source_hash_count_actual": len(stage1_paths),
+        "stage1_source_hash_mismatch_count": sum(
+            not result["match"] for result in stage1_results
+        ),
+        "stage1_source_hash_results": stage1_results,
+        "producer_actual_sha256": producer_actual,
+        "producer_expected_from_generator_manifest": producer_expected_generator,
+        "producer_source_manifest": source_manifest,
+        "generator_image_id": generator_image_id,
+        "audit_input_producer_path_image_key": audit_image_key,
+        "mounted_producer_entries": mounted_producer_entries,
+        "generator_manifest_target": generator_manifest["target"],
+        "selected_stage4_status": resolution["selections"]["klean_generation"][
+            "status"
+        ],
+    }
+    print(json.dumps(report, indent=2, sort_keys=True))
+    if not report["all_checks_pass"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a//tmp/audit-work/classification_semantics_checks.py b//tmp/audit-work/classification_semantics_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d3bf3ffcfb17d48e6610a67c4ce6004eb801005
--- /dev/null
+++ b//tmp/audit-work/classification_semantics_checks.py
@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import ast
+import json
+from pathlib import Path
+
+
+PLANETS = (
+    "Mercury",
+    "Venus",
+    "Earth",
+    "Mars",
+    "Jupiter",
+    "Saturn",
+    "Uranus",
+    "Neptune",
+)
+
+
+def operational_oracle(first: str, second: str) -> tuple[str, ...]:
+    if first not in PLANETS or second not in PLANETS:
+        return ()
+    first_index = PLANETS.index(first)
+    second_index = PLANETS.index(second)
+    if first_index < second_index:
+        return PLANETS[first_index + 1 : second_index]
+    return PLANETS[second_index + 1 : first_index]
+
+
+def summary_index(value: str) -> int:
+    for index, planet in enumerate(PLANETS):
+        if value == planet:
+            return index
+    return -1
+
+
+def summary_between_indices(first: int, second: int) -> tuple[str, ...]:
+    if first < 0 or second < 0:
+        return ()
+    if first < second:
+        return tuple(PLANETS[index] for index in range(first + 1, second, 1))
+    return tuple(PLANETS[index] for index in range(second + 1, first, 1))
+
+
+def summary_model(first: str, second: str) -> tuple[str, ...]:
+    return summary_between_indices(summary_index(first), summary_index(second))
+
+
+def mutation_include_first(first: str, second: str) -> tuple[str, ...]:
+    i, j = summary_index(first), summary_index(second)
+    if i < 0 or j < 0:
+        return ()
+    return PLANETS[min(i, j) : max(i, j)]
+
+
+def mutation_reverse_output(first: str, second: str) -> tuple[str, ...]:
+    return tuple(reversed(summary_model(first, second)))
+
+
+def mutation_invalid_full(first: str, second: str) -> tuple[str, ...]:
+    if summary_index(first) < 0 or summary_index(second) < 0:
+        return PLANETS
+    return summary_model(first, second)
+
+
+def ast_shape_checks() -> dict[str, bool]:
+    module = ast.parse(Path("/reference/k-proof/solution.py").read_text())
+    function = module.body[0]
+    assert isinstance(function, ast.FunctionDef)
+    body = function.body
+    planets_assignment = body[0]
+    invalid_if = body[1]
+    index1_assignment = body[2]
+    index2_assignment = body[3]
+    ascending_if = body[4]
+    descending_return = body[5]
+    tuple_values = tuple(
+        element.value for element in planets_assignment.value.elts
+    )
+
+    def is_index_call(statement: ast.Assign, variable: str, argument: str) -> bool:
+        call = statement.value
+        return (
+            isinstance(call, ast.Call)
+            and isinstance(call.func, ast.Attribute)
+            and isinstance(call.func.value, ast.Name)
+            and call.func.value.id == "planets"
+            and call.func.attr == "index"
+            and len(call.args) == 1
+            and isinstance(call.args[0], ast.Name)
+            and call.args[0].id == argument
+            and isinstance(statement.targets[0], ast.Name)
+            and statement.targets[0].id == variable
+        )
+
+    def slice_shape(statement: ast.Return, low_name: str, high_name: str) -> bool:
+        value = statement.value
+        if not isinstance(value, ast.Subscript) or not isinstance(value.slice, ast.Slice):
+            return False
+        lower = value.slice.lower
+        upper = value.slice.upper
+        return (
+            isinstance(value.value, ast.Name)
+            and value.value.id == "planets"
+            and isinstance(lower, ast.BinOp)
+            and isinstance(lower.op, ast.Add)
+            and isinstance(lower.left, ast.Name)
+            and lower.left.id == low_name
+            and isinstance(lower.right, ast.Constant)
+            and lower.right.value == 1
+            and isinstance(upper, ast.Name)
+            and upper.id == high_name
+            and value.slice.step is None
+        )
+
+    invalid_test = invalid_if.test
+    return {
+        "one_bf_function": len(module.body) == 1 and function.name == "bf",
+        "two_parameters": [argument.arg for argument in function.args.args]
+        == ["planet1", "planet2"],
+        "exact_planet_tuple": tuple_values == PLANETS,
+        "invalid_guard_is_or": isinstance(invalid_test, ast.BoolOp)
+        and isinstance(invalid_test.op, ast.Or)
+        and len(invalid_test.values) == 2
+        and all(
+            isinstance(test, ast.Compare)
+            and len(test.ops) == 1
+            and isinstance(test.ops[0], ast.NotIn)
+            for test in invalid_test.values
+        ),
+        "invalid_returns_empty_tuple": isinstance(invalid_if.body[0], ast.Return)
+        and isinstance(invalid_if.body[0].value, ast.Tuple)
+        and invalid_if.body[0].value.elts == [],
+        "index1_exact": is_index_call(index1_assignment, "index1", "planet1"),
+        "index2_exact": is_index_call(index2_assignment, "index2", "planet2"),
+        "ascending_guard_exact": isinstance(ascending_if.test, ast.Compare)
+        and isinstance(ascending_if.test.ops[0], ast.Lt),
+        "ascending_slice_exact": slice_shape(
+            ascending_if.body[0], "index1", "index2"
+        ),
+        "descending_slice_exact": slice_shape(
+            descending_return, "index2", "index1"
+        ),
+    }
+
+
+def main() -> None:
+    samples = PLANETS + ("Pluto", "", "Mércury")
+    comparisons = []
+    for first in samples:
+        for second in samples:
+            expected = operational_oracle(first, second)
+            observed = summary_model(first, second)
+            comparisons.append(
+                {
+                    "first": first,
+                    "second": second,
+                    "operational": expected,
+                    "summary": observed,
+                    "match": expected == observed,
+                }
+            )
+    mutation_witnesses = {
+        "include_endpoint": {
+            "input": ["Earth", "Mercury"],
+            "expected": operational_oracle("Earth", "Mercury"),
+            "mutated": mutation_include_first("Earth", "Mercury"),
+        },
+        "reverse_output": {
+            "input": ["Mercury", "Uranus"],
+            "expected": operational_oracle("Mercury", "Uranus"),
+            "mutated": mutation_reverse_output("Mercury", "Uranus"),
+        },
+        "invalid_nonempty": {
+            "input": ["Pluto", "Mercury"],
+            "expected": operational_oracle("Pluto", "Mercury"),
+            "mutated": mutation_invalid_full("Pluto", "Mercury"),
+        },
+    }
+    ast_checks = ast_shape_checks()
+    checks = {
+        "source_ast_matches_frozen_algorithm": all(ast_checks.values()),
+        "summary_matches_operational_cases": all(
+            comparison["match"] for comparison in comparisons
+        ),
+        "planet_index_cases_disjoint": len(set(PLANETS)) == len(PLANETS),
+        "planet_index_cases_cover_named_and_other": all(
+            summary_index(name) == index for index, name in enumerate(PLANETS)
+        )
+        and all(summary_index(value) == -1 for value in samples[len(PLANETS) :]),
+        "between_indices_guards_cover_reachable_indices": all(
+            (i < 0 or j < 0) or (i >= 0 and j >= 0 and (i < j or i >= j))
+            for i in range(-1, 8)
+            for j in range(-1, 8)
+        ),
+        "counterfactual_mutations_detected": all(
+            witness["expected"] != witness["mutated"]
+            for witness in mutation_witnesses.values()
+        ),
+    }
+    report = {
+        "checks": checks,
+        "all_checks_pass": all(checks.values()),
+        "source_ast_checks": ast_checks,
+        "sample_count": len(comparisons),
+        "mismatch_count": sum(not item["match"] for item in comparisons),
+        "comparisons": comparisons,
+        "counterfactual_mutation_witnesses": mutation_witnesses,
+    }
+    print(json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False))
+    if not report["all_checks_pass"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a//tmp/audit-work/proc_exe_readlink_shim.c b//tmp/audit-work/proc_exe_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..69ad8d10adea333959e73d7ace4237d15520efea
--- /dev/null
+++ b//tmp/audit-work/proc_exe_readlink_shim.c
@@ -0,0 +1,42 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    const char *cursor;
+
+    if (strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor = path + 6;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+        if (real_readlink == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+    if (is_proc_pid_exe(path)) {
+        path = "/proc/self/exe";
+    }
+    return real_readlink(path, buffer, size);
+}
