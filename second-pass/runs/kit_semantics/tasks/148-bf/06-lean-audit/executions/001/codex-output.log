diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9622f21d6134997b960087d86f4f843636ebadf4
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '\nEXIT_STATUS: %d\n' "$status"
+  exit "$status"
+} >"$log" 2>&1

