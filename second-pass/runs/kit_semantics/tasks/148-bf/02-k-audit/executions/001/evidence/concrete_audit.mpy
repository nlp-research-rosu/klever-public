Module(
  FuncDef("bf", Params("planet1", "planet2"),
    Assign(
      Name("planets"),
      TupleExpr(
        Str("Mercury"),
        Str("Venus"),
        Str("Earth"),
        Str("Mars"),
        Str("Jupiter"),
        Str("Saturn"),
        Str("Uranus"),
        Str("Neptune")))
    If(BoolOp(
      "or",
      Compare(Name("planet1"), CmpOp("not in", Name("planets"))),
      Compare(Name("planet2"), CmpOp("not in", Name("planets")))),
      Return(TupleExpr()),
      )
    Assign(
      Name("index1"),
      Call(Attribute(Name("planets"), "index"), Name("planet1")))
    Assign(
      Name("index2"),
      Call(Attribute(Name("planets"), "index"), Name("planet2")))
    If(Compare(Name("index1"), CmpOp("<", Name("index2"))),
      Return(
        Subscript(
          Name("planets"),
          Slice(
            BinOp("+", Name("index1"), Int(1)),
            Name("index2"),
            NoBound))),
      )
    Return(
      Subscript(
        Name("planets"),
        Slice(
          BinOp("+", Name("index2"), Int(1)),
          Name("index1"),
          NoBound))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Jupiter"), Str("Neptune")),
      CmpOp("==", TupleExpr(Str("Saturn"), Str("Uranus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("Mercury")),
      CmpOp("==", TupleExpr(Str("Venus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Mercury"), Str("Uranus")),
      CmpOp(
        "==",
        TupleExpr(
          Str("Venus"),
          Str("Earth"),
          Str("Mars"),
          Str("Jupiter"),
          Str("Saturn")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Mercury"), Str("Venus")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Venus"), Str("Mercury")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("Earth")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Mercury"), Str("Neptune")),
      CmpOp(
        "==",
        TupleExpr(
          Str("Venus"),
          Str("Earth"),
          Str("Mars"),
          Str("Jupiter"),
          Str("Saturn"),
          Str("Uranus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Neptune"), Str("Mercury")),
      CmpOp(
        "==",
        TupleExpr(
          Str("Venus"),
          Str("Earth"),
          Str("Mars"),
          Str("Jupiter"),
          Str("Saturn"),
          Str("Uranus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str(""), Str("Earth")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Pluto"), Str("Pluto")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Neptune "), Str("Neptune")),
      CmpOp("==", TupleExpr()))))
