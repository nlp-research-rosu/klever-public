/bin/bash -lc '/audit-output/evidence/run_logged.sh 13-kompile-body-mutant kompile --backend haskell verification-body-mutant-audit.k --main-module BODY-MUTANT-AUDIT --syntax-module MPY-SYNTAX --output-definition body-mutant-kompiled-audit' in /tmp/audit-work/fresh
