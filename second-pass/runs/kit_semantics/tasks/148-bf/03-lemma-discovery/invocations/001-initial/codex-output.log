/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv = json.load(open('/reference/rule-inventory.json'))
out = json.load(open('/workspace/trust-boundary.json'))
allowed = {'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
canonical = [r['source_rule_id'] for r in inv['rules']]
actual = [r['source_rule_id'] for r in out['rules']]
assert actual == canonical
assert len(set(actual)) == len(actual)
for i, entry in enumerate(out['rules']):
    assert list(entry.keys()) == ['source_rule_id','classification','rationale'], (i, entry.keys())
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
for src, entry in zip(inv['rules'], out['rules']):
    if 'simplification' in src.get('attributes', []):
        assert entry['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print(f\"inventory_sha256={out['inventory_sha256']}\")
print(f\"canonical_rules={len(canonical)}\")
print(f\"unique_output_ids={len(set(actual))}\")
print('order_match=true')
print('top_level_keys_exact=true')
print('entry_keys_exact=true')
print('class_counts=' + json.dumps(Counter(r['classification'] for r in out['rules']), sort_keys=True))
