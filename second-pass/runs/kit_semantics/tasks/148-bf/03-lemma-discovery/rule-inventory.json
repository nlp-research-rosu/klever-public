      "start_line": 10,
      "text": "  rule bfBody =>\n    Assign(\n      Name(\"planets\"),\n      TupleExpr(\n        Str(\"Mercury\"),\n        Str(\"Venus\"),\n        Str(\"Earth\"),\n        Str(\"Mars\"),\n        Str(\"Jupiter\"),\n        Str(\"Saturn\"),\n        Str(\"Uranus\"),\n        Str(\"Neptune\")))\n    If(\n      BoolOp(\n        \"or\",\n        Compare(Name(\"planet1\"), CmpOp(\"not in\", Name(\"planets\"))),\n        Compare(Name(\"planet2\"), CmpOp(\"not in\", Name(\"planets\")))),\n      Return(TupleExpr(.Exprs)),\n      .Stmts)\n    Assign(\n      Name(\"index1\"),\n      Call(Attribute(Name(\"planets\"), \"index\"), Name(\"planet1\")))\n    Assign(\n      Name(\"index2\"),\n      Call(Attribute(Name(\"planets\"), \"index\"), Name(\"planet2\")))\n    If(\n      Compare(Name(\"index1\"), CmpOp(\"<\", Name(\"index2\"))),\n      Return(\n        Subscript(\n          Name(\"planets\"),\n          Slice(\n            BinOp(\"+\", Name(\"index1\"), Int(1)),\n            Name(\"index2\"),\n            NoBound))),\n      .Stmts)\n    Return(\n      Subscript(\n        Name(\"planets\"),\n        Slice(\n          BinOp(\"+\", Name(\"index2\"), Int(1)),\n          Name(\"index1\"),\n          NoBound)))"
    },
