    If(Compare(Name("index1"), CmpOp("<", Name("index2"))),
      Return(
        Subscript(
          Name("planets"),
          Slice(
            BinOp("+", Name("index1"), Int(1)),
            Name("index2"),
            NoBound))),
      )
    Return(
      Subscript(
        Name("planets"),
        Slice(
          BinOp("+", Name("index2"), Int(1)),
          Name("index1"),
          NoBound))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Jupiter"), Str("Neptune")),
      CmpOp("==", TupleExpr(Str("Saturn"), Str("Uranus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("Mercury")),
      CmpOp("==", TupleExpr(Str("Venus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Mercury"), Str("Uranus")),
      CmpOp(
        "==",
        TupleExpr(
          Str("Venus"),
          Str("Earth"),
          Str("Mars"),
          Str("Jupiter"),
          Str("Saturn")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Mercury"), Str("Venus")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("Earth")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Neptune"), Str("Mercury")),
      CmpOp(
        "==",
        TupleExpr(
          Str("Venus"),
          Str("Earth"),
          Str("Mars"),
          Str("Jupiter"),
          Str("Saturn"),
          Str("Uranus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Pluto"), Str("Earth")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("Pluto")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str(""), Str("")),
      CmpOp("==", TupleExpr()))))

