diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..569ee87d17f20ffbc0af3a13398d6d5097dedc13
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,56 @@
+import ast
+import itertools
+
+from solution import bf
+
+
+PLANETS = (
+    "Mercury",
+    "Venus",
+    "Earth",
+    "Mars",
+    "Jupiter",
+    "Saturn",
+    "Uranus",
+    "Neptune",
+)
+INVALID = ("", "Pluto", "mercury", "Sun", "Neptune ", "🪐", "Earth\0")
+
+
+def oracle(planet1, planet2):
+    positions = {name: position for position, name in enumerate(PLANETS)}
+    if planet1 not in positions or planet2 not in positions:
+        return ()
+    low = min(positions[planet1], positions[planet2])
+    high = max(positions[planet1], positions[planet2])
+    return tuple(
+        name
+        for position, name in enumerate(PLANETS)
+        if low < position < high
+    )
+
+
+def main():
+    inputs = PLANETS + INVALID
+    mismatches = []
+    for planet1, planet2 in itertools.product(inputs, repeat=2):
+        actual = bf(planet1, planet2)
+        expected = oracle(planet1, planet2)
+        if actual != expected:
+            mismatches.append((planet1, planet2, actual, expected))
+
+    with open("solution.py", encoding="utf-8") as solution_file:
+        solution_tree = ast.parse(solution_file.read())
+    with open("krun_examples.py", encoding="utf-8") as krun_file:
+        krun_tree = ast.parse(krun_file.read())
+    same_function_ast = ast.dump(solution_tree.body[0]) == ast.dump(krun_tree.body[0])
+
+    print(f"pairs_checked={len(inputs) ** 2}")
+    print(f"mismatches={len(mismatches)}")
+    print(f"krun_function_ast_matches_solution={same_function_ast}")
+    if mismatches or not same_function_ast:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification-mutant.k b/verification-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..d9a802142dd2ab051528241a16220a435aba272f
--- /dev/null
+++ b/verification-mutant.k
@@ -0,0 +1,14 @@
+requires "verification.k"
+
+module MUTATION
+  imports VERIFICATION
+
+  // Body-sensitivity probe: same binding and signature, but a materially
+  // changed body that always returns the empty tuple.
+  syntax Stmts ::= "mutantBody" [macro]
+  rule mutantBody => Return(TupleExpr(.Exprs))
+
+  syntax Module ::= "mutantModule" [macro]
+  rule mutantModule =>
+    Module(FuncDef("bf", Params("planet1", "planet2"), mutantBody))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6d7437d3bb95ddf10888a70d356acf595085a879
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,104 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact statement body emitted in solution.mpy.  These macro rules are
+  // syntax abbreviations only: after macro expansion the fixed MPY rules
+  // execute the real function definition, call, body, and return.
+  syntax Stmts ::= "bfBody" [macro]
+  rule bfBody =>
+    Assign(
+      Name("planets"),
+      TupleExpr(
+        Str("Mercury"),
+        Str("Venus"),
+        Str("Earth"),
+        Str("Mars"),
+        Str("Jupiter"),
+        Str("Saturn"),
+        Str("Uranus"),
+        Str("Neptune")))
+    If(
+      BoolOp(
+        "or",
+        Compare(Name("planet1"), CmpOp("not in", Name("planets"))),
+        Compare(Name("planet2"), CmpOp("not in", Name("planets")))),
+      Return(TupleExpr(.Exprs)),
+      .Stmts)
+    Assign(
+      Name("index1"),
+      Call(Attribute(Name("planets"), "index"), Name("planet1")))
+    Assign(
+      Name("index2"),
+      Call(Attribute(Name("planets"), "index"), Name("planet2")))
+    If(
+      Compare(Name("index1"), CmpOp("<", Name("index2"))),
+      Return(
+        Subscript(
+          Name("planets"),
+          Slice(
+            BinOp("+", Name("index1"), Int(1)),
+            Name("index2"),
+            NoBound))),
+      .Stmts)
+    Return(
+      Subscript(
+        Name("planets"),
+        Slice(
+          BinOp("+", Name("index2"), Int(1)),
+          Name("index1"),
+          NoBound)))
+
+  syntax Module ::= "bfModule" [macro]
+  rule bfModule =>
+    Module(FuncDef("bf", Params("planet1", "planet2"), bfBody))
+
+  syntax Expr ::= bfCall(IntSeq, IntSeq) [macro]
+  rule bfCall(P1, P2) =>
+    Call(Name("bf"), str(P1), str(P2))
+
+  // Mathematical model of the ordered planet names.
+  syntax ValSeq ::= "planetValues" [function, total]
+  rule planetValues =>
+    vCons(str(strToCodes("Mercury")),
+    vCons(str(strToCodes("Venus")),
+    vCons(str(strToCodes("Earth")),
+    vCons(str(strToCodes("Mars")),
+    vCons(str(strToCodes("Jupiter")),
+    vCons(str(strToCodes("Saturn")),
+    vCons(str(strToCodes("Uranus")),
+    vCons(str(strToCodes("Neptune")), .ValSeq))))))))
+
+  // -1 means that the supplied string is not a planet name.
+  syntax Int ::= planetIndex(IntSeq) [function, total]
+  rule planetIndex(P) => 0 requires P ==K strToCodes("Mercury")
+  rule planetIndex(P) => 1 requires P ==K strToCodes("Venus")
+  rule planetIndex(P) => 2 requires P ==K strToCodes("Earth")
+  rule planetIndex(P) => 3 requires P ==K strToCodes("Mars")
+  rule planetIndex(P) => 4 requires P ==K strToCodes("Jupiter")
+  rule planetIndex(P) => 5 requires P ==K strToCodes("Saturn")
+  rule planetIndex(P) => 6 requires P ==K strToCodes("Uranus")
+  rule planetIndex(P) => 7 requires P ==K strToCodes("Neptune")
+  rule planetIndex(P) => -1
+    requires notBool (P ==K strToCodes("Mercury"))
+     andBool notBool (P ==K strToCodes("Venus"))
+     andBool notBool (P ==K strToCodes("Earth"))
+     andBool notBool (P ==K strToCodes("Mars"))
+     andBool notBool (P ==K strToCodes("Jupiter"))
+     andBool notBool (P ==K strToCodes("Saturn"))
+     andBool notBool (P ==K strToCodes("Uranus"))
+     andBool notBool (P ==K strToCodes("Neptune"))
+
+  syntax ValSeq ::= betweenPlanets(IntSeq, IntSeq) [function, total]
+  rule betweenPlanets(P1, P2) =>
+    betweenIndices(planetIndex(P1), planetIndex(P2))
+
+  syntax ValSeq ::= betweenIndices(Int, Int) [function, total]
+  rule betweenIndices(I, J) => .ValSeq
+    requires I <Int 0 orBool J <Int 0
+  rule betweenIndices(I, J) => buildVS(planetValues, I +Int 1, J, 1)
+    requires I >=Int 0 andBool J >=Int 0 andBool I <Int J
+  rule betweenIndices(I, J) => buildVS(planetValues, J +Int 1, I, 1)
+    requires I >=Int 0 andBool J >=Int 0 andBool I >=Int J
+endmodule

diff --git a/krun_examples.py b/krun_examples.py
new file mode 100644
index 0000000000000000000000000000000000000000..df5f455a47bc62b9a7b5d9783b3304099db3ac0c
--- /dev/null
+++ b/krun_examples.py
@@ -0,0 +1,42 @@
+def bf(planet1, planet2):
+    planets = (
+        "Mercury",
+        "Venus",
+        "Earth",
+        "Mars",
+        "Jupiter",
+        "Saturn",
+        "Uranus",
+        "Neptune",
+    )
+    if planet1 not in planets or planet2 not in planets:
+        return ()
+    index1 = planets.index(planet1)
+    index2 = planets.index(planet2)
+    if index1 < index2:
+        return planets[index1 + 1:index2]
+    return planets[index2 + 1:index1]
+
+
+assert bf("Jupiter", "Neptune") == ("Saturn", "Uranus")
+assert bf("Earth", "Mercury") == ("Venus",)
+assert bf("Mercury", "Uranus") == (
+    "Venus",
+    "Earth",
+    "Mars",
+    "Jupiter",
+    "Saturn",
+)
+assert bf("Mercury", "Venus") == ()
+assert bf("Earth", "Earth") == ()
+assert bf("Neptune", "Mercury") == (
+    "Venus",
+    "Earth",
+    "Mars",
+    "Jupiter",
+    "Saturn",
+    "Uranus",
+)
+assert bf("Pluto", "Earth") == ()
+assert bf("Earth", "Pluto") == ()
+assert bf("", "") == ()
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d7c3f5b8d5723951cde7f239f46bf72bc1047c15
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation with the fixed front end.
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+# Independent finite differential evidence and an AST identity check for the
+# function copied into the concrete K test module.
+python3 test_solution.py
+python3 py2mpy.py krun_examples.py > krun_examples.mpy
+
+# Gate C concrete execution uses exactly the requested LLVM main/syntax modules.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun krun_examples.mpy --definition runtime-kompiled
+
+# Positive symbolic target proof.
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.bf-correct
+
+# Gate A5: a deliberately false postcondition must not prove.
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY > vacuity.out 2>&1; then
+  cat vacuity.out
+  echo "ERROR: false-postcondition mutation unexpectedly proved" >&2
+  exit 1
+else
+  status=$?
+  cat vacuity.out
+  echo "VACUITY_EXIT=$status"
+fi
+
+# Gate A1: a material body mutation must invalidate the original property.
+kompile --backend haskell verification-mutant.k \
+  --main-module MUTATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition mutation-kompiled
+if kprove spec-body-mutation.k \
+     --definition mutation-kompiled \
+     --spec-module SPEC-BODY-MUTATION > body-mutation.out 2>&1; then
+  cat body-mutation.out
+  echo "ERROR: changed-body mutation unexpectedly proved" >&2
+  exit 1
+else
+  status=$?
+  cat body-mutation.out
+  echo "BODY_MUTATION_EXIT=$status"
+fi
