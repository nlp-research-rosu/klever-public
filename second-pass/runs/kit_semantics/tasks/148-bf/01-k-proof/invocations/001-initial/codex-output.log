+        => tuple(.ValSeq) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map => "bf" |-> closureVal(("planet1", "planet2"), bfBody, 0),
+                    parent(-1))
+      -1 |-> builtinsScope
