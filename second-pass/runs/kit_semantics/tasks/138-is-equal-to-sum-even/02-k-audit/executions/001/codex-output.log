+    pattern = r'"(?:[^"\\]|\\.)*"|=>|~>|>=Int|==Int|andBool|\.[A-Za-z]+|#[A-Za-z]+|[A-Za-z_][A-Za-z0-9_-]*|-?[0-9]+|[(){},]|[^\s]'
+    return re.findall(pattern, text)
+
