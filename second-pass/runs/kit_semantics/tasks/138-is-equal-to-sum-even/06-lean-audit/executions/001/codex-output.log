requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [is-equal-to-sum-even]:
    <k>
      #loadAll(
        Module(
          FuncDef(
            "is_equal_to_sum_even",
            Params("n"),
            Return(
              BoolOp(
                "and",
                Compare(Name("n"), CmpOp(">=", Int(8))),
                Compare(
                  BinOp("%", Name("n"), Int(2)),
                  CmpOp("==", Int(0))
                )
              )
            )
          )
        )
      )
      ~> Call(Name("is_equal_to_sum_even"), Int(N))
      => (N >=Int 8 andBool pyMod(N, 2) ==Int 0)
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      =>
      (0 |-> scope(
              "is_equal_to_sum_even"
                |-> closureVal(
                      "n",
                      Return(
                        BoolOp(
                          "and",
                          Compare(Name("n"), CmpOp(">=", Int(8))),
                          Compare(
                            BinOp("%", Name("n"), Int(2)),
                            CmpOp("==", Int(0))
                          )
                        )
                      )
                      .Stmts,
                      0
                    ),
              parent(-1)
            )
       -1 |-> builtinsScope)
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
def is_equal_to_sum_even(n):
    return n >= 8 and n % 2 == 0
Module(
  FuncDef("is_equal_to_sum_even", Params("n"),
    Return(
      BoolOp(
        "and",
        Compare(Name("n"), CmpOp(">=", Int(8))),
        Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0)))))))

