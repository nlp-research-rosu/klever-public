Module(
  FuncDef("is_equal_to_sum_even", Params("n"),
    Return(
      BoolOp(
        "and",
        Compare(Name("n"), CmpOp(">=", Int(8))),
        Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))))))
  Assert(
    Compare(
      Call(Name("is_equal_to_sum_even"), Int(4)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_equal_to_sum_even"), Int(6)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_equal_to_sum_even"), Int(8)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_equal_to_sum_even"), UnaryOp("-", Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_equal_to_sum_even"), Int(9)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_equal_to_sum_even"), Int(10)),
      CmpOp("==", Bool(true)))))
