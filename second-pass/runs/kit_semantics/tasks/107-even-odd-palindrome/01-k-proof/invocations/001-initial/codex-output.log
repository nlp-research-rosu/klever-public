/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.three-inc-odd' in /workspace
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3c10341ff8ad1312004915bebfd2b0c3f60519c6
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,23 @@
+def even_odd_palindrome(n):
+    if n < 10:
+        return (n // 2, (n + 1) // 2)
+
+    if n < 100:
+        two_digit = n // 11
+        return (4 + two_digit // 2, 5 + (two_digit + 1) // 2)
+
+    three_digit = n // 10 - 10
+    if n // 100 <= n % 10:
+        three_digit = three_digit + 1
+
+    full_groups = three_digit // 10
+    tail = three_digit % 10
+    even = 8 + 10 * (full_groups // 2)
+    odd = 10 + 10 * ((full_groups + 1) // 2)
+
+    if (full_groups + 1) % 2 == 0:
+        even = even + tail
+    else:
+        odd = odd + tail
+
+    return (even, odd)
