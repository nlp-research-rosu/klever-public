index 0000000000000000000000000000000000000000..3c10341ff8ad1312004915bebfd2b0c3f60519c6
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,23 @@
+def even_odd_palindrome(n):
+    if n < 10:
+        return (n // 2, (n + 1) // 2)
+
+    if n < 100:
+        two_digit = n // 11
+        return (4 + two_digit // 2, 5 + (two_digit + 1) // 2)
+
+    three_digit = n // 10 - 10
+    if n // 100 <= n % 10:
+        three_digit = three_digit + 1
+
+    full_groups = three_digit // 10
+    tail = three_digit % 10
+    even = 8 + 10 * (full_groups // 2)
+    odd = 10 + 10 * ((full_groups + 1) // 2)
+
+    if (full_groups + 1) % 2 == 0:
+        even = even + tail
+    else:
+        odd = odd + tail
+
+    return (even, odd)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..487232a9fc8a6e3cd4f1ca0a4f2390211644a3a4
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,181 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [small]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(vCons(pyFloor(N, 2),
+                     vCons(pyFloor(N +Int 1, 2), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 1 <=Int N andBool N <Int 10
+
+  claim [two-digit]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             4 +Int pyFloor(pyFloor(N, 11), 2),
+             vCons(
+               5 +Int pyFloor(pyFloor(N, 11) +Int 1, 2),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 10 <=Int N andBool N <Int 100
+
+  claim [three-inc-even]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             8
+             +Int 10 *Int pyFloor(
+               pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10), 2)
+             +Int pyMod(pyFloor(N, 10) -Int 10 +Int 1, 10),
+             vCons(
+               10
+               +Int 10 *Int pyFloor(
+                 pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10)
+                 +Int 1,
+                 2),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 100 <=Int N andBool N <=Int 1000
+     andBool pyFloor(N, 100) <=Int pyMod(N, 10)
+     andBool pyMod(
+       pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10) +Int 1,
+       2) ==Int 0
+
+  claim [three-inc-odd]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             8
+             +Int 10 *Int pyFloor(
+               pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10), 2),
+             vCons(
+               10
+               +Int 10 *Int pyFloor(
+                 pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10)
+                 +Int 1,
+                 2)
+               +Int pyMod(pyFloor(N, 10) -Int 10 +Int 1, 10),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 100 <=Int N andBool N <=Int 1000
+     andBool pyFloor(N, 100) <=Int pyMod(N, 10)
+     andBool pyMod(
+       pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10) +Int 1,
+       2) =/=Int 0
+
+  claim [three-noinc-even]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             8
+             +Int 10 *Int pyFloor(
+               pyFloor(pyFloor(N, 10) -Int 10, 10), 2)
+             +Int pyMod(pyFloor(N, 10) -Int 10, 10),
+             vCons(
+               10
+               +Int 10 *Int pyFloor(
+                 pyFloor(pyFloor(N, 10) -Int 10, 10) +Int 1,
+                 2),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 100 <=Int N andBool N <=Int 1000
+     andBool pyFloor(N, 100) >Int pyMod(N, 10)
+     andBool pyMod(
+       pyFloor(pyFloor(N, 10) -Int 10, 10) +Int 1,
+       2) ==Int 0
+
+  claim [three-noinc-odd]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             8
+             +Int 10 *Int pyFloor(
+               pyFloor(pyFloor(N, 10) -Int 10, 10), 2),
+             vCons(
+               10
+               +Int 10 *Int pyFloor(
+                 pyFloor(pyFloor(N, 10) -Int 10, 10) +Int 1,
+                 2)
+               +Int pyMod(pyFloor(N, 10) -Int 10, 10),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 100 <=Int N andBool N <=Int 1000
+     andBool pyFloor(N, 100) >Int pyMod(N, 10)
+     andBool pyMod(
+       pyFloor(pyFloor(N, 10) -Int 10, 10) +Int 1,
+       2) =/=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4e9a6f893543a31275b032b28ae6485e1c5fdb05
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,93 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Exact closure value transliterated from solution.py / solution.mpy.
+  syntax Val ::= "solutionClosure" "(" ")" [function, total]
+  rule solutionClosure()
+    => closureVal(
+         ("n", .ParamNames),
+         If(
+           Compare(Name("n"), CmpOp("<", Int(10))),
+           Return(
+             TupleExpr(
+               BinOp("//", Name("n"), Int(2)),
+               BinOp("//", BinOp("+", Name("n"), Int(1)), Int(2)))),
+           .Stmts)
+         If(
+           Compare(Name("n"), CmpOp("<", Int(100))),
+           Assign(Name("two_digit"), BinOp("//", Name("n"), Int(11)))
+           Return(
+             TupleExpr(
+               BinOp("+", Int(4),
+                 BinOp("//", Name("two_digit"), Int(2))),
+               BinOp("+", Int(5),
+                 BinOp("//",
+                   BinOp("+", Name("two_digit"), Int(1)),
+                   Int(2))))),
+           .Stmts)
+         Assign(
+           Name("three_digit"),
+           BinOp("-", BinOp("//", Name("n"), Int(10)), Int(10)))
+         If(
+           Compare(
+             BinOp("//", Name("n"), Int(100)),
+             CmpOp("<=", BinOp("%", Name("n"), Int(10)))),
+           Assign(
+             Name("three_digit"),
+             BinOp("+", Name("three_digit"), Int(1))),
+           .Stmts)
+         Assign(
+           Name("full_groups"),
+           BinOp("//", Name("three_digit"), Int(10)))
+         Assign(
+           Name("tail"),
+           BinOp("%", Name("three_digit"), Int(10)))
+         Assign(
+           Name("even"),
+           BinOp(
+             "+",
+             Int(8),
+             BinOp("*", Int(10),
+               BinOp("//", Name("full_groups"), Int(2)))))
+         Assign(
+           Name("odd"),
+           BinOp(
+             "+",
+             Int(10),
+             BinOp("*", Int(10),
+               BinOp("//",
+                 BinOp("+", Name("full_groups"), Int(1)),
+                 Int(2)))))
+         If(
+           Compare(
+             BinOp("%",
+               BinOp("+", Name("full_groups"), Int(1)),
+               Int(2)),
+             CmpOp("==", Int(0))),
+           Assign(
+             Name("even"),
+             BinOp("+", Name("even"), Name("tail"))),
+           Assign(
+             Name("odd"),
+             BinOp("+", Name("odd"), Name("tail"))))
+         Return(TupleExpr(Name("even"), Name("odd"))),
+         0)
+
+  // Python floor division, written in the same integer primitives used by MPY.
+  syntax Int ::= pyFloor(Int, Int) [function]
+  rule pyFloor(A, B) => A /Int B
+    requires A >=Int 0 andBool B >Int 0
+
+  // Derived from MPY's pyMod equation on nonnegative dividends.
+  rule (A -Int pyMod(A, B)) /Int B => A /Int B
+    requires A >=Int 0 andBool B >Int 0
+    [simplification]
+
+  rule pyMod(A, B) => A -Int B *Int (A /Int B)
+    requires A >=Int 0 andBool B >Int 0
+    [simplification]
+endmodule

