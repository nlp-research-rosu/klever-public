+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 10 <=Int N andBool N <Int 100
+
+  claim [three-inc-even]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             8
+             +Int 10 *Int pyFloor(
+               pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10), 2)
+             +Int pyMod(pyFloor(N, 10) -Int 10 +Int 1, 10),
+             vCons(
+               10
+               +Int 10 *Int pyFloor(
+                 pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10)
+                 +Int 1,
+                 2),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 100 <=Int N andBool N <=Int 1000
+     andBool pyFloor(N, 100) <=Int pyMod(N, 10)
+     andBool pyMod(
+       pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10) +Int 1,
+       2) ==Int 0
+
+  claim [three-inc-odd]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             8
+             +Int 10 *Int pyFloor(
+               pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10), 2),
+             vCons(
+               10
+               +Int 10 *Int pyFloor(
+                 pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10)
+                 +Int 1,
+                 2)
+               +Int pyMod(pyFloor(N, 10) -Int 10 +Int 1, 10),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 100 <=Int N andBool N <=Int 1000
+     andBool pyFloor(N, 100) <=Int pyMod(N, 10)
+     andBool pyMod(
+       pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10) +Int 1,
+       2) =/=Int 0
+
+  claim [three-noinc-even]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             8
+             +Int 10 *Int pyFloor(
+               pyFloor(pyFloor(N, 10) -Int 10, 10), 2)
+             +Int pyMod(pyFloor(N, 10) -Int 10, 10),
+             vCons(
+               10
+               +Int 10 *Int pyFloor(
+                 pyFloor(pyFloor(N, 10) -Int 10, 10) +Int 1,
+                 2),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
