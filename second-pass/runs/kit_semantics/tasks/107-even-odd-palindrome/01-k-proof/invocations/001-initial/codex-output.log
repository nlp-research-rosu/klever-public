+           BinOp(
+             "+",
+             Int(10),
+             BinOp("*", Int(10),
+               BinOp("//",
+                 BinOp("+", Name("full_groups"), Int(1)),
+                 Int(2)))))
+         If(
+           Compare(
+             BinOp("%",
+               BinOp("+", Name("full_groups"), Int(1)),
+               Int(2)),
+             CmpOp("==", Int(0))),
+           Assign(
