diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..487232a9fc8a6e3cd4f1ca0a4f2390211644a3a4
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,181 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [small]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(vCons(pyFloor(N, 2),
+                     vCons(pyFloor(N +Int 1, 2), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 1 <=Int N andBool N <Int 10
+
+  claim [two-digit]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             4 +Int pyFloor(pyFloor(N, 11), 2),
+             vCons(
+               5 +Int pyFloor(pyFloor(N, 11) +Int 1, 2),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 10 <=Int N andBool N <Int 100
+
+  claim [three-inc-even]:
+    <k> Call(solutionClosure(), Int(N))
+      => tuple(
+           vCons(
+             8
+             +Int 10 *Int pyFloor(
+               pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10), 2)
+             +Int pyMod(pyFloor(N, 10) -Int 10 +Int 1, 10),
+             vCons(
+               10
+               +Int 10 *Int pyFloor(
+                 pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10)
+                 +Int 1,
+                 2),
+               .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 100 <=Int N andBool N <=Int 1000
+     andBool pyFloor(N, 100) <=Int pyMod(N, 10)
+     andBool pyMod(
+       pyFloor(pyFloor(N, 10) -Int 10 +Int 1, 10) +Int 1,
+       2) ==Int 0
