+                BinOp("+", Int(5),
+                  BinOp("//",
+                    BinOp("+", Name("two_digit"), Int(1)),
+                    Int(2))))),
+            .Stmts)
+          Assign(
+            Name("three_digit"),
+            BinOp("-", BinOp("//", Name("n"), Int(10)), Int(10)))
+          If(
+            Compare(
+              BinOp("//", Name("n"), Int(100)),
+              CmpOp("<=", BinOp("%", Name("n"), Int(10)))),
+            Assign(
+              Name("three_digit"),
+              BinOp("+", Name("three_digit"), Int(1))),
+            .Stmts)
+          Assign(
+            Name("full_groups"),
+            BinOp("//", Name("three_digit"), Int(10)))
+          Assign(
+            Name("tail"),
+            BinOp("%", Name("three_digit"), Int(10)))
+          Assign(
+            Name("even"),
+            BinOp(
+              "+",
+              Int(8),
+              BinOp("*", Int(10),
+                BinOp("//", Name("full_groups"), Int(2)))))
+          Assign(
+            Name("odd"),
+            BinOp(
+              "+",
+              Int(10),
+              BinOp("*", Int(10),
+                BinOp("//",
+                  BinOp("+", Name("full_groups"), Int(1)),
+                  Int(2)))))
+          If(
+            Compare(
+              BinOp("%",
+                BinOp("+", Name("full_groups"), Int(1)),
+                Int(2)),
+              CmpOp("==", Int(0))),
+            Assign(
+              Name("even"),
+              BinOp("+", Name("even"), Name("tail"))),
+            Assign(
+              Name("odd"),
+              BinOp("+", Name("odd"), Name("tail"))))
+          Return(TupleExpr(Name("even"), Name("odd"))),
+          0),
+        Int(N))
+      =>
+        tuple(
+          vCons(
+            evenPalindromeCount(N),
+            vCons(oddPalindromeCount(N), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 1 <=Int N andBool N <Int 10
+endmodule
