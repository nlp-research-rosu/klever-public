@@ -0,0 +1,23 @@
+def even_odd_palindrome(n):
+    if n < 10:
+        return (n // 2, (n + 1) // 2)
+
+    if n < 100:
+        two_digit = n // 11
+        return (4 + two_digit // 2, 5 + (two_digit + 1) // 2)
+
+    three_digit = n // 10 - 10
