+          Assign(
+            Name("even"),
+            BinOp(
+              "+",
+              Int(8),
+              BinOp("*", Int(10),
+                BinOp("//", Name("full_groups"), Int(2)))))
+          Assign(
+            Name("odd"),
+            BinOp(
