for include_dirs in [False,True]:
 es=[p for p in entries if include_dirs or p.is_file()]
 for lead in ['', './', root.name+'/', str(root)+'/']:
  for typ in ['', 'words', 'letters']:
   for sep in [b'',b'\\0',b'\\n',b':',b' ']:
