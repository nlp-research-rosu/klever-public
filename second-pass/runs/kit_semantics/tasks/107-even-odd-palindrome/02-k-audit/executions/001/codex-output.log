/bin/bash -lc "pwd; command -v jq; command -v kup; command -v kompile; command -v kprove; find /candidate /reference /generation-evidence -maxdepth 3 -printf '%y %p -> %l\\n' | sort | sed -n '1,260p'; for f in /audit-input.json /audit-campaign-lock.json /run.json /task.json /generation-result.json; do echo \"===== "'$f"; jq . "$f"; done' in /audit-output
