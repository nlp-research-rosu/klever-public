     3	module VERIFICATION
     4	  imports MPY
     5	  imports INT
     6	  imports BOOL
     7	
     8	  // Exact closure value transliterated from solution.py / solution.mpy.
     9	  syntax Val ::= "solutionClosure" "(" ")" [function, total]
