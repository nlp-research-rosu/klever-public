  if [ "$translate_status" -eq 0 ] && [ "$krun_status" -eq 0 ]; then exit 0; else exit 1; fi
} 2>&1 | tee /audit-output/evidence/09-concrete-execution.log
status=${PIPESTATUS[0]}
echo "OVERALL_EXIT_STATUS: $status" | tee -a /audit-output/evidence/09-concrete-execution.log
exit "$status"' in /tmp/audit-work/reconstruction
