Module(
  FuncDef("reverse_delete", Params("s", "c"),
    Assign(Name("result"), Str(""))
    Assign(Name("reversed_result"), Str(""))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      If(Compare(Name("ch"), CmpOp("not in", Name("c"))),
        AugAssign(Name("result"), "+", Name("ch"))
        Assign(
          Name("reversed_result"),
          BinOp("+", Name("ch"), Name("reversed_result"))),
        ))
    Return(
      TupleExpr(
        Name("result"),
        Compare(Name("result"), CmpOp("==", Name("reversed_result")))))))
