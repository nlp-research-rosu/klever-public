Module(
  FuncDef("reverse_delete", Params("s", "c"),
    Assign(Name("result"), Str(""))
    Assign(Name("reversed_result"), Str(""))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      If(Compare(Name("ch"), CmpOp("not in", Name("c"))),
        AugAssign(Name("result"), "+", Name("ch"))
        Assign(
          Name("reversed_result"),
          BinOp("+", Name("ch"), Name("reversed_result"))),
        ))
    Return(
      TupleExpr(
        Name("result"),
        Compare(Name("result"), CmpOp("==", Name("reversed_result"))))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("abcde"), Str("ae")),
      CmpOp("==", TupleExpr(Str("bcd"), Bool(false)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("abcdef"), Str("b")),
      CmpOp("==", TupleExpr(Str("acdef"), Bool(false)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("abcdedcba"), Str("ab")),
      CmpOp("==", TupleExpr(Str("cdedc"), Bool(true)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str(""), Str("abc")),
      CmpOp("==", TupleExpr(Str(""), Bool(true)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("abba"), Str("x")),
      CmpOp("==", TupleExpr(Str("abba"), Bool(true))))))
