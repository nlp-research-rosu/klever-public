from pathlib import Path
import hashlib,json,itertools
root=Path('/reference/reference-semantics'); exp={'1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de','4e06397a1c5a2c7be4f6cc3f61490d87805523b8c9d3c1a0ecd8e1d6bde3789f'}
files=sorted((p for p in root.rglob('*') if p.is_file()),key=lambda p:p.relative_to(root).as_posix())
