+#!/usr/bin/env python3
+"""Run one command and preserve a bounded combined-output audit log."""
+
+from __future__ import annotations
+
+import datetime as dt
+import os
+import pathlib
+import shlex
+import subprocess
+import sys
+
+
+LIMIT = 300_000
+
+
+def main() -> int:
+    if len(sys.argv) < 4 or sys.argv[2] != "--":
