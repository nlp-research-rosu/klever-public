      "start_line": 8,
      "text": "  rule deleteAcc(.IntSeq, _:IntSeq, ACC:IntSeq) => ACC"
    },
    {
      "attributes": [],
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "9958ef1e5cedad6393d09ebbc3c826f504a56323dc84f7f28b3c814045e0cd23",
      "source_rule_id": "rule-9958ef1e5cedad6393d09ebbc3c826f504a56323dc84f7f28b3c814045e0cd23",
      "start_line": 9,
      "text": "  rule deleteAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, ACC:IntSeq)\n    => #if strContains(iCons(X, .IntSeq), C)\n       #then deleteAcc(XS, C, ACC)\n       #else deleteAcc(XS, C, seqConcat(ACC, iCons(X, .IntSeq)))\n       #fi"
    },
