      "rationale": "This is the empty-input base equation defining deleteAcc: with no remaining characters, the named accumulator summary is exactly ACC.",
      "source_rule_id": "rule-0b1487f16122d27497d8c2b109033346786d2ad1ea565f1e4e43ff7b63a74ee6",
      "start_line": 8,
      "text": "  rule deleteAcc(.IntSeq, _:IntSeq, ACC:IntSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "9958ef1e5cedad6393d09ebbc3c826f504a56323dc84f7f28b3c814045e0cd23",
      "rationale": "This is the iCons recurrence defining deleteAcc by a structural case split: it either skips the current character or appends it before recurring on the strict suffix XS.",
      "source_rule_id": "rule-9958ef1e5cedad6393d09ebbc3c826f504a56323dc84f7f28b3c814045e0cd23",
      "start_line": 9,
      "text": "  rule deleteAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, ACC:IntSeq)\n    => #if strContains(iCons(X, .IntSeq), C)\n       #then deleteAcc(XS, C, ACC)\n       #else deleteAcc(XS, C, seqConcat(ACC, iCons(X, .IntSeq)))\n       #fi"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "ec000690c3aa4109db5bb6cc52464e7d8893560fc3144e4db5d63ff5b9da171c",
      "rationale": "This is the empty-input base equation defining reverseDeleteAcc: with no remaining characters, the named reverse-accumulator summary is exactly ACC.",
      "source_rule_id": "rule-ec000690c3aa4109db5bb6cc52464e7d8893560fc3144e4db5d63ff5b9da171c",
      "start_line": 19,
      "text": "  rule reverseDeleteAcc(.IntSeq, _:IntSeq, ACC:IntSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "d31842da509f8fdf40a424d203025312d80e1fea7bb96b8b765027072309de32",
      "rationale": "This is the iCons recurrence defining reverseDeleteAcc by a structural case split: it either skips the current character or prepends it before recurring on the strict suffix XS.",
      "source_rule_id": "rule-d31842da509f8fdf40a424d203025312d80e1fea7bb96b8b765027072309de32",
      "start_line": 20,
      "text": "  rule reverseDeleteAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, ACC:IntSeq)\n    => #if strContains(iCons(X, .IntSeq), C)\n       #then reverseDeleteAcc(XS, C, ACC)\n       #else reverseDeleteAcc(XS, C, iCons(X, ACC))\n       #fi"
    }
  ],
