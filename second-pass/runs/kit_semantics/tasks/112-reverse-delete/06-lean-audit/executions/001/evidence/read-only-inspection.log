+ nl -ba /reference/k-proof/solution.py
     1	def reverse_delete(s, c):
     2	    result = ""
     3	    reversed_result = ""
     4	    ch = ""
     5	    for ch in s:
     6	        if ch not in c:
     7	            result += ch
     8	            reversed_result = ch + reversed_result
     9	    return (result, result == reversed_result)
