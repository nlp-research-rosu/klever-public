     6	  // The filtered suffix appended to an already-built result.
     7	  syntax IntSeq ::= deleteAcc(IntSeq, IntSeq, IntSeq) [function, total]
     8	  rule deleteAcc(.IntSeq, _:IntSeq, ACC:IntSeq) => ACC
     9	  rule deleteAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, ACC:IntSeq)
    10	    => #if strContains(iCons(X, .IntSeq), C)
    11	       #then deleteAcc(XS, C, ACC)
    12	       #else deleteAcc(XS, C, seqConcat(ACC, iCons(X, .IntSeq)))
    13	       #fi
    14	
    15	  // The filtered suffix prepended, one character at a time, to a reverse
    16	  // accumulator.  With an empty accumulator this is the reverse of deleteAcc.
    17	  syntax IntSeq ::= reverseDeleteAcc(IntSeq, IntSeq, IntSeq)
    18	                    [function, total]
    19	  rule reverseDeleteAcc(.IntSeq, _:IntSeq, ACC:IntSeq) => ACC
    20	  rule reverseDeleteAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, ACC:IntSeq)
    21	    => #if strContains(iCons(X, .IntSeq), C)
    22	       #then reverseDeleteAcc(XS, C, ACC)
    23	       #else reverseDeleteAcc(XS, C, iCons(X, ACC))
    24	       #fi
    25	endmodule
