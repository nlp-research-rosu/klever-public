+        "sha256:" + str(resolution["generation_producer_sources"]).rstrip("/").split("/")[-1],
+    )
+)
+producer_names = sorted(
+    path.relative_to(PRODUCERS).as_posix()
+    for path in pipeline_contract._walk_regular_files(
