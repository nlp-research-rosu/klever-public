+        for category in (
+            "definitions",
+            "operational_rules",
+            "proved_derived_lemmas",
+            "domain_lemmas",
+        )
+        for rule in validated[category]
+    ],
+    "obligation_map": obligation_map,
+}
+print(json.dumps(result, indent=2, sort_keys=True))
+raise SystemExit(0 if not failed else 1)
