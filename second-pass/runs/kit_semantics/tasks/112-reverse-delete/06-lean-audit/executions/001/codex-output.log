codex
I found the concrete cause: each sandboxed command has PID `2`, but `/proc` is the parent namespace’s procfs, so Lean’s runtime cannot resolve `/proc/2/exe`. I’m applying a narrow local compatibility shim under `/tmp/audit-work` that only repairs `readlink("/proc/<pid>/exe")` using the process’s actual invocation path. It does not alter Lean files, generated sources, theorem content, or the preflight checker; I’ll record the shim source, compile command, and rerun output.
apply patch
patch: completed
/tmp/audit-work/fix_proc_exe.c
diff --git a//tmp/audit-work/fix_proc_exe.c b//tmp/audit-work/fix_proc_exe.c
new file mode 100644
index 0000000000000000000000000000000000000000..adf11f7b88bad23b43c37249f695ec49f30e9bd9
--- /dev/null
+++ b//tmp/audit-work/fix_proc_exe.c
@@ -0,0 +1,49 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+static int is_proc_exe(const char *path) {
+    if (strcmp(path, "/proc/self/exe") == 0) return 1;
+    if (strncmp(path, "/proc/", 6) != 0) return 0;
+    const char *cursor = path + 6;
+    if (*cursor < '0' || *cursor > '9') return 0;
+    while (*cursor >= '0' && *cursor <= '9') cursor++;
+    return strcmp(cursor, "/exe") == 0;
+}
+
+static ssize_t invocation_path(char *buffer, size_t size) {
+    const char *name = program_invocation_name;
+    char resolved[PATH_MAX];
+    if (name == NULL || strchr(name, '/') == NULL || realpath(name, resolved) == NULL) {
+        errno = ENOENT;
+        return -1;
+    }
+    size_t length = strlen(resolved);
+    size_t copied = length < size ? length : size;
+    memcpy(buffer, resolved, copied);
+    return (ssize_t)copied;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static ssize_t (*original)(const char *, char *, size_t) = NULL;
+    if (is_proc_exe(path)) return invocation_path(buffer, size);
+    if (original == NULL) original = dlsym(RTLD_NEXT, "readlink");
+    return original(path, buffer, size);
+}
+
+ssize_t readlinkat(int directory, const char *path, char *buffer, size_t size) {
+    static ssize_t (*original)(int, const char *, char *, size_t) = NULL;
+    if (path != NULL && path[0] == '/' && is_proc_exe(path)) {
+        return invocation_path(buffer, size);
+    }
+    if (original == NULL) original = dlsym(RTLD_NEXT, "readlinkat");
+    return original(directory, path, buffer, size);
+}
