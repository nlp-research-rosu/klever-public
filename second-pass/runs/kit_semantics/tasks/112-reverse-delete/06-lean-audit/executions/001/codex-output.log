+        "observed": observed,
+        "expected": expected,
+        "match": observed == expected,
+    }
+
+
+audit_document = load(AUDIT_INPUT)
+resolution, resolved_input_sha256 = stage6_resolution_contract.verify_audit_input(
+    audit_document
+)
+hashes = resolution["hashes"]
