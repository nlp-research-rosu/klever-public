Module(
  FuncDef("vowels_count", Params("s"),
    Assign(Name("count"), Int(0))
    Assign(Name("last"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("s"),
      AugAssign(
        Name("count"),
        "+",
        Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
      Assign(Name("last"), Name("char")))
    AugAssign(
      Name("count"),
      "+",
      Compare(Name("last"), CmpOp("==", Str("y"))))
    AugAssign(
      Name("count"),
      "+",
      Compare(Name("last"), CmpOp("==", Str("Y"))))
    Return(Name("count")))
  Assert(
    Compare(Call(Name("vowels_count"), Str("")), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("vowels_count"), Str("abcde")),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("vowels_count"), Str("ACEDY")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(Call(Name("vowels_count"), Str("yyy")), CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("vowels_count"), Str("rhythm")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("vowels_count"), Str("AEIOU")),
      CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("vowels_count"), Str("sky")), CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("vowels_count"), Str("yellow")),
      CmpOp("==", Int(2)))))
