diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..86ebb1ffcc80f97092e99dfef237a6f1c93a4f13
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,20 @@
+def vowels_count(s):
+    count = 0
+    last = ""
+    char = ""
+    for char in s:
+        count += char in "aeiouAEIOU"
+        last = char
+    count += last == "y"
+    count += last == "Y"
+    return count
+
+
+assert vowels_count("") == 0
+assert vowels_count("abcde") == 2
+assert vowels_count("ACEDY") == 3
+assert vowels_count("yyy") == 1
+assert vowels_count("rhythm") == 0
+assert vowels_count("AEIOU") == 5
+assert vowels_count("sky") == 1
+assert vowels_count("yellow") == 2
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d34e382f3c987a15f765d72749e1ad1228c0192b
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,55 @@
+requires "connection-verification.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION-VERIFICATION
+
+  claim [loop-connection]:
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("char"),
+        AugAssign(
+          Name("count"),
+          "+",
+          Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+        Assign(Name("last"), Name("char"))
+        .Stmts)
+      ~> AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("y"))))
+      ~> AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("Y"))))
+      ~> Return(Name("count"))
+      ~> #endcall
+      =>
+      (COUNT:Int +Int vowelsTail(CS, LAST:IntSeq)) ~> CONT:K
+    </k>
+    <env> 1 => CALLER:Int </env>
+    <scopes>
+      (0 |-> scope(GLOBAL:Map, parent(-1))
+       1 |-> scope(
+         "s" |-> str(ORIGINAL:IntSeq)
+         "count" |-> COUNT
+         "last" |-> str(LAST)
+         "char" |-> CHAR:Val,
+         parent(0))
+       -1 |-> BUILTINS:Scope)
+      =>
+      (0 |-> scope(GLOBAL, parent(-1))
+       -1 |-> BUILTINS)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, 1)) CALLSTACK:List
+      =>
+      CALLSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/connection-verification.k b/connection-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..67e1ddbf1c5cd8efd26dade61f62389694f2b70f
--- /dev/null
+++ b/connection-verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module CONNECTION-VERIFICATION
+  imports MPY
+
+  // The number still to be added when CS remains to be iterated and LAST is
+  // the previous one-character string (or .IntSeq before the first step).
+  // These equations are exhaustive and constructor-disjoint on IntSeq.
+  syntax Int ::= vowelsTail(IntSeq, IntSeq) [function, total]
+
+  rule vowelsTail(.IntSeq, LAST)
+    => intOf(LAST ==K iCons(121, .IntSeq))
+       +Int intOf(LAST ==K iCons(89, .IntSeq))
+
+  rule vowelsTail(iCons(C, REST), _LAST)
+    => intOf(strContains(
+         iCons(C, .IntSeq),
+         iCons(97,
+         iCons(101,
+         iCons(105,
+         iCons(111,
+         iCons(117,
+         iCons(65,
+         iCons(69,
+         iCons(73,
+         iCons(79,
+         iCons(85, .IntSeq))))))))))))
+       +Int vowelsTail(REST, iCons(C, .IntSeq))
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..f837136401e4f8f0d7441cfc58bfc0655a8c3563
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,38 @@
+from itertools import product
+
+from solution import vowels_count
+
+
+def oracle(word):
+    ordinary = sum(1 for char in word if char.lower() in "aeiou")
+    terminal_y = int(word[-1:].lower() == "y")
+    return ordinary + terminal_y
+
+
+examples = {
+    "": 0,
+    "abcde": 2,
+    "ACEDY": 3,
+    "yyy": 1,
+    "rhythm": 0,
+    "AEIOU": 5,
+    "sky": 1,
+    "yellow": 2,
+}
+
+checked = 0
+mismatches = 0
+for word, expected in examples.items():
+    checked += 1
+    mismatches += vowels_count(word) != expected
+
+alphabet = "aAeEyYbz"
+for length in range(6):
+    for chars in product(alphabet, repeat=length):
+        word = "".join(chars)
+        checked += 1
+        mismatches += vowels_count(word) != oracle(word)
+
+print("checked:", checked)
+print("mismatches:", mismatches)
+assert mismatches == 0
