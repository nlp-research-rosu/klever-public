index 0000000000000000000000000000000000000000..1486d91608a6c130f12352f6b84c8fcedeea72cf
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def vowels_count(s):
+    count = 0
+    last = ""
+    char = ""
+    for char in s:
+        count += char in "aeiouAEIOU"
+        last = char
+    count += last == "y"
+    count += last == "Y"
+    return count
