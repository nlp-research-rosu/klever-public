+def vowels_count(s):
+    count = 0
+    last = ""
+    for char in s:
+        count += char in "aeiouAEIOU"
+        last = char
+    count += last == "y"
+    count += last == "Y"
+    return count
+
+
+assert vowels_count("") == 0
+assert vowels_count("abcde") == 2
