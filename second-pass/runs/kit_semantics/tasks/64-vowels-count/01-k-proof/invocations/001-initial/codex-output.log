diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ed7ba7a16ff125866606dc9e0ba90cb17b8ba99d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,111 @@
+requires "connection-verification.k"
+
+module VERIFICATION
+  imports CONNECTION-VERIFICATION
+
+  // Certified operational bridge. Its complete match domain and state
+  // transition are exactly connection-spec.k's loop-connection claim, which
+  // is proved using CONNECTION-VERIFICATION (where this rule is absent).
+  rule
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("char"),
+        AugAssign(
+          Name("count"),
+          "+",
+          Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+        Assign(Name("last"), Name("char"))
+        .Stmts)
+      ~> AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("y"))))
+      ~> AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("Y"))))
+      ~> Return(Name("count"))
+      ~> #endcall
+      =>
+      vowelsTail(CS, .IntSeq)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(
+         "vowels_count" |-> closureVal(
+           ("s", .ParamNames),
+           Assign(Name("count"), Int(0))
+           Assign(Name("last"), Str(""))
+           Assign(Name("char"), Str(""))
+           For(
+             Name("char"),
+             Name("s"),
+             AugAssign(
+               Name("count"),
+               "+",
+               Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+             Assign(Name("last"), Name("char"))
+             .Stmts)
+           AugAssign(
+             Name("count"),
+             "+",
+             Compare(Name("last"), CmpOp("==", Str("y"))))
+           AugAssign(
+             Name("count"),
+             "+",
+             Compare(Name("last"), CmpOp("==", Str("Y"))))
+           Return(Name("count"))
+           .Stmts,
+           0),
+         parent(-1))
+       1 |-> scope(
+         "s" |-> str(CS)
+         "count" |-> 0
+         "last" |-> str(.IntSeq)
+         "char" |-> str(.IntSeq),
+         parent(0))
+       -1 |-> BUILTINS:Scope)
+      =>
+      (0 |-> scope(
+         "vowels_count" |-> closureVal(
+           ("s", .ParamNames),
+           Assign(Name("count"), Int(0))
+           Assign(Name("last"), Str(""))
+           Assign(Name("char"), Str(""))
+           For(
+             Name("char"),
+             Name("s"),
+             AugAssign(
+               Name("count"),
+               "+",
+               Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+             Assign(Name("last"), Name("char"))
+             .Stmts)
+           AugAssign(
+             Name("count"),
+             "+",
+             Compare(Name("last"), CmpOp("==", Str("y"))))
+           AugAssign(
+             Name("count"),
+             "+",
+             Compare(Name("last"), CmpOp("==", Str("Y"))))
+           Return(Name("count"))
+           .Stmts,
+           0),
+         parent(-1))
+       -1 |-> BUILTINS)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(30)]
+endmodule

exec
/bin/bash -lc 'kprove --help | rg -n -i "claim|trusted|lemma|axiom|spec|circular" | head -n 120' in /workspace
