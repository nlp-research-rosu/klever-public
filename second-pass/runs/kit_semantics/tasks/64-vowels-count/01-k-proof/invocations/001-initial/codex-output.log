+    <scopes>
+      (0 |-> scope(GLOBAL:Map, parent(-1))
+       1 |-> scope(
+         "s" |-> str(ORIGINAL:IntSeq)
+         "count" |-> COUNT
+         "last" |-> str(LAST)
+         "char" |-> CHAR:Val,
+         parent(0))
+       -1 |-> BUILTINS:Scope)
+      =>
+      (0 |-> scope(GLOBAL, parent(-1))
+       -1 |-> BUILTINS)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, 1)) CALLSTACK:List
+      =>
+      CALLSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires BUILTINS ==K builtinsScope
+endmodule

