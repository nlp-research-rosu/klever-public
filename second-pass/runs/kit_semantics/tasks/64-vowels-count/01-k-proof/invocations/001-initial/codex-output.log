+            Name("s"),
+            AugAssign(
+              Name("count"),
+              "+",
+              Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+            Assign(Name("last"), Name("char"))
+            .Stmts)
+          AugAssign(
+            Name("count"),
+            "+",
+            Compare(Name("last"), CmpOp("==", Str("y"))))
+          AugAssign(
+            Name("count"),
+            "+",
+            Compare(Name("last"), CmpOp("==", Str("Y"))))
+          Return(Name("count"))
+          .Stmts)
+        .Stmts))
+      ~> Call(Name("vowels_count"), (str(INPUT:IntSeq), .Exprs))
+      =>
+      ?RESULT:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "vowels_count" |-> closureVal(
+           ("s", .ParamNames),
+           Assign(Name("count"), Int(0))
+           Assign(Name("last"), Str(""))
+           Assign(Name("char"), Str(""))
+           For(
+             Name("char"),
+             Name("s"),
+             AugAssign(
+               Name("count"),
+               "+",
+               Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+             Assign(Name("last"), Name("char"))
+             .Stmts)
+           AugAssign(
+             Name("count"),
+             "+",
+             Compare(Name("last"), CmpOp("==", Str("y"))))
+           AugAssign(
+             Name("count"),
+             "+",
+             Compare(Name("last"), CmpOp("==", Str("Y"))))
+           Return(Name("count"))
+           .Stmts,
+           0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?RESULT ==Int vowelsTail(INPUT, .IntSeq)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..67834dde8e693110cbbf4a23138bb4aa62f53048
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,59 @@
+requires "connection-verification.k"
+
+module VERIFICATION
+  imports CONNECTION-VERIFICATION
+
+  // Certified operational bridge. Its complete match domain and state
+  // transition are exactly connection-spec.k's loop-connection claim, which
+  // is proved using CONNECTION-VERIFICATION (where this rule is absent).
+  rule
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("char"),
+        AugAssign(
+          Name("count"),
+          "+",
+          Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+        Assign(Name("last"), Name("char"))
+        .Stmts)
+      ~> AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("y"))))
+      ~> AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("Y"))))
+      ~> Return(Name("count"))
+      ~> #endcall
+      =>
+      (COUNT:Int +Int vowelsTail(CS, LAST:IntSeq)) ~> CONT:K
+    </k>
+    <env> 1 => CALLER:Int </env>
+    <scopes>
+      (0 |-> scope(GLOBAL:Map, parent(-1))
+       1 |-> scope(
+         "s" |-> str(ORIGINAL:IntSeq)
+         "count" |-> COUNT
+         "last" |-> str(LAST)
+         "char" |-> CHAR:Val,
+         parent(0))
+       -1 |-> BUILTINS:Scope)
+      =>
+      (0 |-> scope(GLOBAL, parent(-1))
+       -1 |-> BUILTINS)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, 1)) CALLSTACK:List
+      =>
+      CALLSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule

