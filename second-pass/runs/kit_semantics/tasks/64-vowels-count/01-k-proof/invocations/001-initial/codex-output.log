+           "+",
+           Compare(Name("last"), CmpOp("==", Str("y"))))
+      ~> AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("Y"))))
+      ~> Return(Name("count"))
+      ~> #endcall
