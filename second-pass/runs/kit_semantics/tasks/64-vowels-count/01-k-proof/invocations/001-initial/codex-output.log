+         iCons(117,
+         iCons(65,
+         iCons(69,
+         iCons(73,
+         iCons(79,
+         iCons(85, .IntSeq))))))))))))
+       +Int vowelsTail(REST, iCons(C, .IntSeq))
+endmodule

