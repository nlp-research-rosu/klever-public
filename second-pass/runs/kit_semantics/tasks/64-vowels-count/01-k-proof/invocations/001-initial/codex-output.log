diff --git a/connection-verification.k b/connection-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..67e1ddbf1c5cd8efd26dade61f62389694f2b70f
--- /dev/null
+++ b/connection-verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module CONNECTION-VERIFICATION
+  imports MPY
+
+  // The number still to be added when CS remains to be iterated and LAST is
+  // the previous one-character string (or .IntSeq before the first step).
+  // These equations are exhaustive and constructor-disjoint on IntSeq.
+  syntax Int ::= vowelsTail(IntSeq, IntSeq) [function, total]
+
+  rule vowelsTail(.IntSeq, LAST)
+    => intOf(LAST ==K iCons(121, .IntSeq))
+       +Int intOf(LAST ==K iCons(89, .IntSeq))
+
+  rule vowelsTail(iCons(C, REST), _LAST)
+    => intOf(strContains(
+         iCons(C, .IntSeq),
+         iCons(97,
+         iCons(101,
+         iCons(105,
+         iCons(111,
+         iCons(117,
+         iCons(65,
+         iCons(69,
+         iCons(73,
+         iCons(79,
+         iCons(85, .IntSeq))))))))))))
+       +Int vowelsTail(REST, iCons(C, .IntSeq))
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..f837136401e4f8f0d7441cfc58bfc0655a8c3563
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,38 @@
+from itertools import product
+
+from solution import vowels_count
+
+
+def oracle(word):
+    ordinary = sum(1 for char in word if char.lower() in "aeiou")
+    terminal_y = int(word[-1:].lower() == "y")
+    return ordinary + terminal_y
+
+
+examples = {
+    "": 0,
+    "abcde": 2,
+    "ACEDY": 3,
+    "yyy": 1,
+    "rhythm": 0,
+    "AEIOU": 5,
+    "sky": 1,
+    "yellow": 2,
+}
+
+checked = 0
+mismatches = 0
+for word, expected in examples.items():
+    checked += 1
+    mismatches += vowels_count(word) != expected
+
+alphabet = "aAeEyYbz"
+for length in range(6):
+    for chars in product(alphabet, repeat=length):
+        word = "".join(chars)
+        checked += 1
+        mismatches += vowels_count(word) != oracle(word)
+
+print("checked:", checked)
+print("mismatches:", mismatches)
+assert mismatches == 0
