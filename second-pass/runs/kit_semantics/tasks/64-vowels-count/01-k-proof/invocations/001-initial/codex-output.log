+    => intOf(LAST ==K iCons(121, .IntSeq))
+       +Int intOf(LAST ==K iCons(89, .IntSeq))
+
+  rule vowelsTail(iCons(C, REST), _LAST)
+    => intOf(strContains(
+         iCons(C, .IntSeq),
+         iCons(97,
+         iCons(101,
+         iCons(105,
+         iCons(111,
+         iCons(117,
+         iCons(65,
+         iCons(69,
+         iCons(73,
+         iCons(79,
+         iCons(85, .IntSeq))))))))))))
