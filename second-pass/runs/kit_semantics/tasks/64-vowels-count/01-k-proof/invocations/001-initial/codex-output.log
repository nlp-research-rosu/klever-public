+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("char"),
+        AugAssign(
+          Name("count"),
+          "+",
+          Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+        Assign(Name("last"), Name("char"))
+        .Stmts)
+      ~> AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("y"))))
+         AugAssign(
+           Name("count"),
+           "+",
+           Compare(Name("last"), CmpOp("==", Str("Y"))))
+         Return(Name("count"))
+         .Stmts
+      ~> #endcall
+      =>
+      (COUNT:Int +Int vowelsTail(CS, LAST:IntSeq)) ~> CONT:K
+    </k>
+    <env> 1 => CALLER:Int </env>
+    <scopes>
+      (0 |-> scope(GLOBAL:Map, parent(-1))
+       1 |-> scope(
+         "s" |-> str(ORIGINAL:IntSeq)
+         "count" |-> COUNT
+         "last" |-> str(LAST)
+         "char" |-> CHAR:Val,
+         parent(0))
+       -1 |-> BUILTINS:Scope)
+      =>
+      (0 |-> scope(GLOBAL, parent(-1))
+       -1 |-> BUILTINS)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, 1)) CALLSTACK:List
+      =>
+      CALLSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [vowels-count]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "vowels_count",
+          Params("s"),
+          Assign(Name("count"), Int(0))
+          Assign(Name("last"), Str(""))
+          Assign(Name("char"), Str(""))
+          For(
+            Name("char"),
+            Name("s"),
+            AugAssign(
+              Name("count"),
+              "+",
+              Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+            Assign(Name("last"), Name("char"))
+            .Stmts)
+          AugAssign(
+            Name("count"),
+            "+",
+            Compare(Name("last"), CmpOp("==", Str("y"))))
+          AugAssign(
+            Name("count"),
+            "+",
+            Compare(Name("last"), CmpOp("==", Str("Y"))))
+          Return(Name("count"))
+          .Stmts)
+        .Stmts))
+      ~> Call(Name("vowels_count"), (str(INPUT:IntSeq), .Exprs))
+      =>
+      vowelsTail(INPUT, .IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "vowels_count" |-> closureVal(
+           ("s", .ParamNames),
+           Assign(Name("count"), Int(0))
+           Assign(Name("last"), Str(""))
+           Assign(Name("char"), Str(""))
+           For(
+             Name("char"),
+             Name("s"),
+             AugAssign(
+               Name("count"),
+               "+",
+               Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))))
+             Assign(Name("last"), Name("char"))
+             .Stmts)
+           AugAssign(
+             Name("count"),
+             "+",
+             Compare(Name("last"), CmpOp("==", Str("y"))))
+           AugAssign(
+             Name("count"),
+             "+",
+             Compare(Name("last"), CmpOp("==", Str("Y"))))
+           Return(Name("count"))
+           .Stmts,
+           0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..27eee4bb2a3db9f9503812c05a223359257c2341
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The number still to be added when CS remains to be iterated and LAST is
+  // the previous one-character string (or .IntSeq before the first step).
+  // These equations are exhaustive and constructor-disjoint on IntSeq.
+  syntax Int ::= vowelsTail(IntSeq, IntSeq) [function, total]
+
+  rule vowelsTail(.IntSeq, LAST)
+    => intOf(LAST ==K iCons(121, .IntSeq))
+       +Int intOf(LAST ==K iCons(89, .IntSeq))
+
+  rule vowelsTail(iCons(C, REST), _LAST)
+    => intOf(strContains(
+         iCons(C, .IntSeq),
+         iCons(97,
+         iCons(101,
+         iCons(105,
+         iCons(111,
+         iCons(117,
+         iCons(65,
+         iCons(69,
+         iCons(73,
+         iCons(79,
+         iCons(85, .IntSeq))))))))))))
+       +Int vowelsTail(REST, iCons(C, .IntSeq))
+endmodule

