      "start_line": 11,
      "text": "  rule vowelsTail(.IntSeq, LAST)\n    => intOf(LAST ==K iCons(121, .IntSeq))\n       +Int intOf(LAST ==K iCons(89, .IntSeq))"
    },
    {
      "attributes": [],
