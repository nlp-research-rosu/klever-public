     1	def vowels_count(s):
     2	    count = 0
     3	    last = ""
     4	    char = ""
     5	    for char in s:
     6	        count += char in "aeiouAEIOU"
     7	        last = char
     8	    count += last == "y"
     9	    count += last == "Y"
    10	    return count
