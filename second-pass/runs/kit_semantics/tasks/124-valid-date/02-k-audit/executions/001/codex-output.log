   173	  syntax Bool ::= validMonthDay(Int, Int) [function, total]
   174	  rule validMonthDay(M, D)
   175	    => (M ==Int 2
   176	        andBool 1 <=Int D andBool D <=Int 29)
   177	       orBool
   178	       ((M ==Int 4 orBool M ==Int 6 orBool M ==Int 9 orBool M ==Int 11)
   179	        andBool 1 <=Int D andBool D <=Int 30)
   180	       orBool
   181	       ((M ==Int 1 orBool M ==Int 3 orBool M ==Int 5
   182	         orBool M ==Int 7 orBool M ==Int 8 orBool M ==Int 10
   183	         orBool M ==Int 12)
   184	        andBool 1 <=Int D andBool D <=Int 31)
   185	
   186	  syntax Bool ::= validDateResult(IntSeq) [function, total]
   187	  rule validDateResult(CS) => false
   188	    requires isLen(CS) =/=Int 10
   189	
   190	  rule validDateResult(CS)
   191	    => intSeqAt(CS, 2) ==Int 45
   192	       andBool intSeqAt(CS, 5) ==Int 45
   193	       andBool asciiDigit(intSeqAt(CS, 0))
   194	       andBool asciiDigit(intSeqAt(CS, 1))
   195	       andBool asciiDigit(intSeqAt(CS, 3))
   196	       andBool asciiDigit(intSeqAt(CS, 4))
   197	       andBool asciiDigit(intSeqAt(CS, 6))
   198	       andBool asciiDigit(intSeqAt(CS, 7))
   199	       andBool asciiDigit(intSeqAt(CS, 8))
   200	       andBool asciiDigit(intSeqAt(CS, 9))
   201	       andBool validMonthDay(
   202	         (intSeqAt(CS, 0) -Int 48) *Int 10
   203	           +Int (intSeqAt(CS, 1) -Int 48),
   204	         (intSeqAt(CS, 3) -Int 48) *Int 10
   205	           +Int (intSeqAt(CS, 4) -Int 48))
   206	    requires isLen(CS) ==Int 10
   207	endmodule
