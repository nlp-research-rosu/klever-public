+  exit 64
+fi
+
+log_path=$1
+shift
+
+: > "$log_path"
+{
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee -a "$log_path"
+
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS=%d\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"

