     1	import re
     2	
     3	from solution import valid_date
     4	
     5	
     6	def oracle(date):
     7	    match = re.fullmatch(r"([0-9]{2})-([0-9]{2})-([0-9]{4})", date)
     8	    if match is None:
     9	        return False
    10	    month = int(match.group(1))
    11	    day = int(match.group(2))
    12	    limits = (0, 31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
    13	    return 1 <= month <= 12 and 1 <= day <= limits[month]
    14	
    15	
    16	def main():
    17	    tested = 0
    18	    mismatches = []
    19	
    20	    for year in ("0000", "2000", "9999"):
    21	        for month in range(100):
    22	            for day in range(100):
    23	                date = f"{month:02d}-{day:02d}-{year}"
    24	                tested += 1
    25	                if valid_date(date) != oracle(date):
    26	                    mismatches.append(date)
    27	
    28	    malformed = (
    29	        "",
    30	        "03-11-200",
    31	        "003-11-2000",
    32	        "03/11/2000",
    33	        "03-11/2000",
    34	        "0a-11-2000",
    35	        "03-b1-2000",
    36	        "03-11-20c0",
    37	        "０3-11-2000",
    38	        "03-11-２０００",
    39	    )
    40	    for date in malformed:
    41	        tested += 1
    42	        if valid_date(date) != oracle(date):
    43	            mismatches.append(date)
    44	
    45	    print(f"tested={tested} mismatches={len(mismatches)}")
    46	    if mismatches:
    47	        print("first_mismatches=", mismatches[:10])
    48	        raise SystemExit(1)
    49	
    50	
    51	if __name__ == "__main__":
    52	    main()
