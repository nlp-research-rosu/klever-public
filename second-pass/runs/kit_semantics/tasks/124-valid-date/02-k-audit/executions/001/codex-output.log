--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+: > "$log_path"
+{
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee -a "$log_path"
+
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS=%d\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"
