+    "06-30-2000",
+    "06-31-2000",
+    "09-30-2000",
+    "09-31-2000",
+    "11-30-2000",
+    "11-31-2000",
+    "12-31-2000",
+    "12-32-2000",
+    "13-01-2000",
+    "99-99-9999",
+    "02-29-0000",
+    "02-29-9999",
+    "0a-11-2000",
+    "03-b1-2000",
+    "03-11-20c0",
+    "０3-11-2000",
