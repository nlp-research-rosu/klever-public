+    Call(Name("valid_date"), Str("04-0-2040")),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("06-04-2020")),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("06/04/2020")),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("02-29-0000")),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("02-30-2000")),
+    CmpOp("==", Bool(false)))))
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..968b4f2396cf17081be61f95e8fab7610841c252
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy --definition runtime-kompiled
+python3 test_solution.py
+
+# Check that the proof's named program constant is exactly solution.mpy after
+# both are parsed to KORE (explicit .Stmts is only needed inside K source).
+sed -n '13,166p' verification.k \
+  | sed -e '1s/^[[:space:]]*=> //' -e 's/\.Stmts//g' \
+  > verification-program.mpy
+kast solution.mpy \
+  --definition runtime-kompiled \
+  --module MPY-SYNTAX \
+  --sort Module \
+  --output kore \
+  --output-file /tmp/solution.kore
+kast verification-program.mpy \
+  --definition runtime-kompiled \
+  --module MPY-SYNTAX \
+  --sort Module \
+  --output kore \
+  --output-file /tmp/verification-program.kore
+cmp /tmp/solution.kore /tmp/verification-program.kore
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.valid-date-10
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.valid-date-non10
+
+# Gate A5: a valid witness must not prove the deliberately false result.
+if kprove spec-vacuity.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY; then
+  echo "ERROR: false-result mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-result mutation was rejected"
+fi
+
+# Gate A1: changing February's bound in the executed body from 29 to 28 must
+# break the universal connection to the unchanged calendar summary.
+sed '137s/Int(29)/Int(28)/' verification.k > verification-mutant.k
+sed -e '1s/verification.k/verification-mutant.k/' \
+    -e 's/^module SPEC$/module SPEC-MUTANT/' \
+    spec.k > spec-mutant.k
+kompile verification-mutant.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-mutant-kompiled
+if kprove spec-mutant.k \
+    --definition verification-mutant-kompiled \
+    --spec-module SPEC-MUTANT \
+    --claims SPEC-MUTANT.valid-date-10; then
+  echo "ERROR: body mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: body mutation was rejected"
+fi
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1fff7a6ac410b4806b6480c7dbf1327917813934
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,44 @@
+def valid_date(date):
+    if len(date) != 10:
+        return False
+
+    if date[2] != "-" or date[5] != "-":
+        return False
+
+    month_tens = ord(date[0]) - 48
+    month_ones = ord(date[1]) - 48
+    day_tens = ord(date[3]) - 48
+    day_ones = ord(date[4]) - 48
+    year_thousands = ord(date[6]) - 48
+    year_hundreds = ord(date[7]) - 48
+    year_tens = ord(date[8]) - 48
+    year_ones = ord(date[9]) - 48
+
+    if month_tens < 0 or month_tens > 9:
+        return False
+    if month_ones < 0 or month_ones > 9:
+        return False
+    if day_tens < 0 or day_tens > 9:
+        return False
+    if day_ones < 0 or day_ones > 9:
+        return False
+    if year_thousands < 0 or year_thousands > 9:
+        return False
+    if year_hundreds < 0 or year_hundreds > 9:
+        return False
+    if year_tens < 0 or year_tens > 9:
+        return False
+    if year_ones < 0 or year_ones > 9:
+        return False
+
+    month = month_tens * 10 + month_ones
+    day = day_tens * 10 + day_ones
+
+    if month == 2:
+        return day >= 1 and day <= 29
+    if month == 4 or month == 6 or month == 9 or month == 11:
+        return day >= 1 and day <= 30
+    if (month == 1 or month == 3 or month == 5 or month == 7
+            or month == 8 or month == 10 or month == 12):
+        return day >= 1 and day <= 31
+    return False
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..55051084ee0bbe1613ff4fd8b0f03ec9b58ad2b4
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: 03-11-2000 is valid, so the real function returns
+  // true.  Gate A5 requires this claim to be rejected.
+  claim [false-result]:
+    <k>
+      #loadAll(validDateProgram)
+        ~> Call(Name("valid_date"), Str("03-11-2000"))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e702de45e9ec53a21f7b6ff1b20bddf3d2ac180c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Validation scope:
+  // - boundary: load the exact translated module, look up valid_date, execute
+  //   its closure body, and return to the module continuation;
+  // - domain: every MPY string value str(CS);
+  // - observable final state: the returned Bool plus clean call-control cells;
+  // - property: validDateResult is true exactly for mm-dd-yyyy strings whose
+  //   month/day pair obeys the limits in prompt.py.
+  claim [valid-date-10]:
+    <k>
+      #loadAll(validDateProgram)
+        ~> Call(Name("valid_date"),
+             str(iCons(C0:Int,
+                 iCons(C1:Int,
+                 iCons(C2:Int,
+                 iCons(C3:Int,
+                 iCons(C4:Int,
+                 iCons(C5:Int,
+                 iCons(C6:Int,
+                 iCons(C7:Int,
+                 iCons(C8:Int,
+                 iCons(C9:Int, .IntSeq))))))))))))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool
+      validDateResult(
+        iCons(C0,
+        iCons(C1,
+        iCons(C2,
+        iCons(C3,
+        iCons(C4,
+        iCons(C5,
+        iCons(C6,
+        iCons(C7,
+        iCons(C8,
+        iCons(C9, .IntSeq)))))))))))
+
+  claim [valid-date-non10]:
+    <k>
+      #loadAll(validDateProgram)
+        ~> Call(Name("valid_date"), str(CS:IntSeq))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) =/=Int 10
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..383b795be1a7e932ffcf6008d4fd4bee37b9a798
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,52 @@
+import re
+
+from solution import valid_date
+
+
+def oracle(date):
+    match = re.fullmatch(r"([0-9]{2})-([0-9]{2})-([0-9]{4})", date)
+    if match is None:
+        return False
+    month = int(match.group(1))
+    day = int(match.group(2))
+    limits = (0, 31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
+    return 1 <= month <= 12 and 1 <= day <= limits[month]
+
+
+def main():
+    tested = 0
+    mismatches = []
+
+    for year in ("0000", "2000", "9999"):
+        for month in range(100):
+            for day in range(100):
+                date = f"{month:02d}-{day:02d}-{year}"
+                tested += 1
+                if valid_date(date) != oracle(date):
+                    mismatches.append(date)
+
+    malformed = (
+        "",
+        "03-11-200",
+        "003-11-2000",
+        "03/11/2000",
+        "03-11/2000",
+        "0a-11-2000",
+        "03-b1-2000",
+        "03-11-20c0",
+        "０3-11-2000",
+        "03-11-２０００",
+    )
+    for date in malformed:
+        tested += 1
+        if valid_date(date) != oracle(date):
+            mismatches.append(date)
+
+    print(f"tested={tested} mismatches={len(mismatches)}")
+    if mismatches:
+        print("first_mismatches=", mismatches[:10])
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ecf531deb42e13fe62f9334090f140fd58b8c940
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,207 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // An exact name for the translator output in solution.mpy.  This equation
+  // only constructs the source AST; MPY still performs loading, lookup,
+  // argument evaluation, frame management, the body, and return control.
+  syntax Module ::= "validDateProgram" [function, total]
+  rule validDateProgram
+    => Module(
+         FuncDef("valid_date", Params("date"),
+           If(Compare(Call(Name("len"), Name("date")), CmpOp("!=", Int(10))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Subscript(Name("date"), Int(2)), CmpOp("!=", Str("-"))),
+             Compare(Subscript(Name("date"), Int(5)), CmpOp("!=", Str("-")))),
+             Return(Bool(false)),
+             .Stmts)
+           Assign(
+             Name("month_tens"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(0))),
+               Int(48)))
+           Assign(
+             Name("month_ones"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(1))),
+               Int(48)))
+           Assign(
+             Name("day_tens"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(3))),
+               Int(48)))
+           Assign(
+             Name("day_ones"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(4))),
+               Int(48)))
+           Assign(
+             Name("year_thousands"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(6))),
+               Int(48)))
+           Assign(
+             Name("year_hundreds"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(7))),
+               Int(48)))
+           Assign(
+             Name("year_tens"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(8))),
+               Int(48)))
+           Assign(
+             Name("year_ones"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(9))),
+               Int(48)))
+           If(BoolOp(
+             "or",
+             Compare(Name("month_tens"), CmpOp("<", Int(0))),
+             Compare(Name("month_tens"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("month_ones"), CmpOp("<", Int(0))),
+             Compare(Name("month_ones"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("day_tens"), CmpOp("<", Int(0))),
+             Compare(Name("day_tens"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("day_ones"), CmpOp("<", Int(0))),
+             Compare(Name("day_ones"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("year_thousands"), CmpOp("<", Int(0))),
+             Compare(Name("year_thousands"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("year_hundreds"), CmpOp("<", Int(0))),
+             Compare(Name("year_hundreds"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("year_tens"), CmpOp("<", Int(0))),
+             Compare(Name("year_tens"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("year_ones"), CmpOp("<", Int(0))),
+             Compare(Name("year_ones"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           Assign(
+             Name("month"),
+             BinOp(
+               "+",
+               BinOp("*", Name("month_tens"), Int(10)),
+               Name("month_ones")))
+           Assign(
+             Name("day"),
+             BinOp(
+               "+",
+               BinOp("*", Name("day_tens"), Int(10)),
+               Name("day_ones")))
+           If(Compare(Name("month"), CmpOp("==", Int(2))),
+             Return(
+               BoolOp(
+                 "and",
+                 Compare(Name("day"), CmpOp(">=", Int(1))),
+                 Compare(Name("day"), CmpOp("<=", Int(29))))),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("month"), CmpOp("==", Int(4))),
+             Compare(Name("month"), CmpOp("==", Int(6))),
+             Compare(Name("month"), CmpOp("==", Int(9))),
+             Compare(Name("month"), CmpOp("==", Int(11)))),
+             Return(
+               BoolOp(
+                 "and",
+                 Compare(Name("day"), CmpOp(">=", Int(1))),
+                 Compare(Name("day"), CmpOp("<=", Int(30))))),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("month"), CmpOp("==", Int(1))),
+             Compare(Name("month"), CmpOp("==", Int(3))),
+             Compare(Name("month"), CmpOp("==", Int(5))),
+             Compare(Name("month"), CmpOp("==", Int(7))),
+             Compare(Name("month"), CmpOp("==", Int(8))),
+             Compare(Name("month"), CmpOp("==", Int(10))),
+             Compare(Name("month"), CmpOp("==", Int(12)))),
+             Return(
+               BoolOp(
+                 "and",
+                 Compare(Name("day"), CmpOp(">=", Int(1))),
+                 Compare(Name("day"), CmpOp("<=", Int(31))))),
+             .Stmts)
+           Return(Bool(false))))
+
+  // Proof-local mathematical summaries.  None of these rules rewrites an
+  // MPY program term or bypasses fixed-semantics execution.
+  syntax Bool ::= asciiDigit(Int) [function, total]
+  rule asciiDigit(C) => 48 <=Int C andBool C <=Int 57
+
+  syntax Bool ::= validMonthDay(Int, Int) [function, total]
+  rule validMonthDay(M, D)
+    => (M ==Int 2
+        andBool 1 <=Int D andBool D <=Int 29)
+       orBool
+       ((M ==Int 4 orBool M ==Int 6 orBool M ==Int 9 orBool M ==Int 11)
+        andBool 1 <=Int D andBool D <=Int 30)
+       orBool
+       ((M ==Int 1 orBool M ==Int 3 orBool M ==Int 5
+         orBool M ==Int 7 orBool M ==Int 8 orBool M ==Int 10
+         orBool M ==Int 12)
+        andBool 1 <=Int D andBool D <=Int 31)
+
+  syntax Bool ::= validDateResult(IntSeq) [function, total]
+  rule validDateResult(CS) => false
+    requires isLen(CS) =/=Int 10
+
+  rule validDateResult(CS)
+    => intSeqAt(CS, 2) ==Int 45
+       andBool intSeqAt(CS, 5) ==Int 45
+       andBool asciiDigit(intSeqAt(CS, 0))
+       andBool asciiDigit(intSeqAt(CS, 1))
+       andBool asciiDigit(intSeqAt(CS, 3))
+       andBool asciiDigit(intSeqAt(CS, 4))
+       andBool asciiDigit(intSeqAt(CS, 6))
+       andBool asciiDigit(intSeqAt(CS, 7))
+       andBool asciiDigit(intSeqAt(CS, 8))
+       andBool asciiDigit(intSeqAt(CS, 9))
+       andBool validMonthDay(
+         (intSeqAt(CS, 0) -Int 48) *Int 10
+           +Int (intSeqAt(CS, 1) -Int 48),
+         (intSeqAt(CS, 3) -Int 48) *Int 10
+           +Int (intSeqAt(CS, 4) -Int 48))
+    requires isLen(CS) ==Int 10
+endmodule

diff --git a/concrete-tests.mpy b/concrete-tests.mpy
index 4a0c698bd450d66b2c864f158aea2f2cf1e87a4e..d1de6e4bf8bae47779ee590d66b541503bfa5181
--- a/concrete-tests.mpy
+++ b/concrete-tests.mpy
@@ -152,3 +152,24 @@
           Compare(Name("day"), CmpOp("<=", Int(31))))),
       )
     Return(Bool(false)))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("03-11-2000")),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("15-01-2012")),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("04-0-2040")),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("06-04-2020")),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("06/04/2020")),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("02-29-0000")),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("02-30-2000")),
+    CmpOp("==", Bool(false)))))
