+        iCons(C1,
+        iCons(C2,
+        iCons(C3,
+        iCons(C4,
+        iCons(C5,
+        iCons(C6,
+        iCons(C7,
+        iCons(C8,
+        iCons(C9, .IntSeq)))))))))))
+
+  claim [valid-date-non10]:
+    <k>
+      #loadAll(validDateProgram)
+        ~> Call(Name("valid_date"), str(CS:IntSeq))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
