+  // - property: validDateResult is true exactly for mm-dd-yyyy strings whose
+  //   month/day pair obeys the limits in prompt.py.
+  claim [valid-date-10]:
+    <k>
+      #loadAll(validDateProgram)
+        ~> Call(Name("valid_date"),
+             str(iCons(C0:Int,
+                 iCons(C1:Int,
+                 iCons(C2:Int,
+                 iCons(C3:Int,
+                 iCons(C4:Int,
+                 iCons(C5:Int,
+                 iCons(C6:Int,
+                 iCons(C7:Int,
+                 iCons(C8:Int,
+                 iCons(C9:Int, .IntSeq))))))))))))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
