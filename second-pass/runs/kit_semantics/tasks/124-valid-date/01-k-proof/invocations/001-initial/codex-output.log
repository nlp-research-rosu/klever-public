+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("06-04-2020")),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("06/04/2020")),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("02-29-0000")),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    Call(Name("valid_date"), Str("02-30-2000")),
+    CmpOp("==", Bool(false)))))
