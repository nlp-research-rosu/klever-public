diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1fff7a6ac410b4806b6480c7dbf1327917813934
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,44 @@
+def valid_date(date):
+    if len(date) != 10:
+        return False
+
+    if date[2] != "-" or date[5] != "-":
+        return False
+
+    month_tens = ord(date[0]) - 48
+    month_ones = ord(date[1]) - 48
+    day_tens = ord(date[3]) - 48
+    day_ones = ord(date[4]) - 48
+    year_thousands = ord(date[6]) - 48
+    year_hundreds = ord(date[7]) - 48
+    year_tens = ord(date[8]) - 48
+    year_ones = ord(date[9]) - 48
+
+    if month_tens < 0 or month_tens > 9:
+        return False
+    if month_ones < 0 or month_ones > 9:
+        return False
+    if day_tens < 0 or day_tens > 9:
+        return False
+    if day_ones < 0 or day_ones > 9:
+        return False
+    if year_thousands < 0 or year_thousands > 9:
+        return False
+    if year_hundreds < 0 or year_hundreds > 9:
+        return False
+    if year_tens < 0 or year_tens > 9:
+        return False
+    if year_ones < 0 or year_ones > 9:
+        return False
+
+    month = month_tens * 10 + month_ones
+    day = day_tens * 10 + day_ones
+
+    if month == 2:
+        return day >= 1 and day <= 29
+    if month == 4 or month == 6 or month == 9 or month == 11:
+        return day >= 1 and day <= 30
+    if (month == 1 or month == 3 or month == 5 or month == 7
+            or month == 8 or month == 10 or month == 12):
+        return day >= 1 and day <= 31
+    return False
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c3b54caaafdb276e31912fdf83300cf609c5e2fd
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,188 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Validation scope:
+  // - boundary: load the exact translated module, look up valid_date, execute
+  //   its closure body, and return to the module continuation;
+  // - domain: every MPY string value str(CS);
+  // - observable final state: the returned Bool plus clean call-control cells;
+  // - property: validDateResult is true exactly for mm-dd-yyyy strings whose
+  //   month/day pair obeys the limits in prompt.py.
+  claim [valid-date]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("valid_date", Params("date"),
+            If(Compare(Call(Name("len"), Name("date")), CmpOp("!=", Int(10))),
+              Return(Bool(false)),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Subscript(Name("date"), Int(2)), CmpOp("!=", Str("-"))),
+              Compare(Subscript(Name("date"), Int(5)), CmpOp("!=", Str("-")))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(
+              Name("month_tens"),
+              BinOp(
+                "-",
+                Call(Name("ord"), Subscript(Name("date"), Int(0))),
+                Int(48)))
+            Assign(
+              Name("month_ones"),
+              BinOp(
+                "-",
+                Call(Name("ord"), Subscript(Name("date"), Int(1))),
+                Int(48)))
+            Assign(
+              Name("day_tens"),
+              BinOp(
+                "-",
+                Call(Name("ord"), Subscript(Name("date"), Int(3))),
+                Int(48)))
+            Assign(
+              Name("day_ones"),
+              BinOp(
+                "-",
+                Call(Name("ord"), Subscript(Name("date"), Int(4))),
+                Int(48)))
+            Assign(
+              Name("year_thousands"),
+              BinOp(
+                "-",
+                Call(Name("ord"), Subscript(Name("date"), Int(6))),
+                Int(48)))
+            Assign(
+              Name("year_hundreds"),
+              BinOp(
+                "-",
+                Call(Name("ord"), Subscript(Name("date"), Int(7))),
+                Int(48)))
+            Assign(
+              Name("year_tens"),
+              BinOp(
+                "-",
+                Call(Name("ord"), Subscript(Name("date"), Int(8))),
+                Int(48)))
+            Assign(
+              Name("year_ones"),
+              BinOp(
+                "-",
+                Call(Name("ord"), Subscript(Name("date"), Int(9))),
+                Int(48)))
+            If(BoolOp(
+              "or",
+              Compare(Name("month_tens"), CmpOp("<", Int(0))),
+              Compare(Name("month_tens"), CmpOp(">", Int(9)))),
+              Return(Bool(false)),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("month_ones"), CmpOp("<", Int(0))),
+              Compare(Name("month_ones"), CmpOp(">", Int(9)))),
+              Return(Bool(false)),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("day_tens"), CmpOp("<", Int(0))),
+              Compare(Name("day_tens"), CmpOp(">", Int(9)))),
+              Return(Bool(false)),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("day_ones"), CmpOp("<", Int(0))),
+              Compare(Name("day_ones"), CmpOp(">", Int(9)))),
+              Return(Bool(false)),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("year_thousands"), CmpOp("<", Int(0))),
+              Compare(Name("year_thousands"), CmpOp(">", Int(9)))),
+              Return(Bool(false)),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("year_hundreds"), CmpOp("<", Int(0))),
+              Compare(Name("year_hundreds"), CmpOp(">", Int(9)))),
+              Return(Bool(false)),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("year_tens"), CmpOp("<", Int(0))),
+              Compare(Name("year_tens"), CmpOp(">", Int(9)))),
+              Return(Bool(false)),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("year_ones"), CmpOp("<", Int(0))),
+              Compare(Name("year_ones"), CmpOp(">", Int(9)))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(
+              Name("month"),
+              BinOp(
+                "+",
+                BinOp("*", Name("month_tens"), Int(10)),
+                Name("month_ones")))
+            Assign(
+              Name("day"),
+              BinOp(
+                "+",
+                BinOp("*", Name("day_tens"), Int(10)),
+                Name("day_ones")))
+            If(Compare(Name("month"), CmpOp("==", Int(2))),
+              Return(
+                BoolOp(
+                  "and",
+                  Compare(Name("day"), CmpOp(">=", Int(1))),
+                  Compare(Name("day"), CmpOp("<=", Int(29))))),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("month"), CmpOp("==", Int(4))),
+              Compare(Name("month"), CmpOp("==", Int(6))),
+              Compare(Name("month"), CmpOp("==", Int(9))),
+              Compare(Name("month"), CmpOp("==", Int(11)))),
+              Return(
+                BoolOp(
+                  "and",
+                  Compare(Name("day"), CmpOp(">=", Int(1))),
+                  Compare(Name("day"), CmpOp("<=", Int(30))))),
+              .Stmts)
+            If(BoolOp(
+              "or",
+              Compare(Name("month"), CmpOp("==", Int(1))),
+              Compare(Name("month"), CmpOp("==", Int(3))),
+              Compare(Name("month"), CmpOp("==", Int(5))),
+              Compare(Name("month"), CmpOp("==", Int(7))),
+              Compare(Name("month"), CmpOp("==", Int(8))),
+              Compare(Name("month"), CmpOp("==", Int(10))),
+              Compare(Name("month"), CmpOp("==", Int(12)))),
+              Return(
+                BoolOp(
+                  "and",
+                  Compare(Name("day"), CmpOp(">=", Int(1))),
+                  Compare(Name("day"), CmpOp("<=", Int(31))))),
+              .Stmts)
+            Return(Bool(false))))
+        )
+        ~> Call(Name("valid_date"), str(CS:IntSeq))
+      => ?R:Bool
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Bool validDateResult(CS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0b1e140420cf029e81657abf037c216e0a6e38ec
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,207 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // An exact name for the translator output in solution.mpy.  This equation
+  // only constructs the source AST; MPY still performs loading, lookup,
+  // argument evaluation, frame management, the body, and return control.
+  syntax Module ::= validDateProgram [function, total]
+  rule validDateProgram
+    => Module(
+         FuncDef("valid_date", Params("date"),
+           If(Compare(Call(Name("len"), Name("date")), CmpOp("!=", Int(10))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Subscript(Name("date"), Int(2)), CmpOp("!=", Str("-"))),
+             Compare(Subscript(Name("date"), Int(5)), CmpOp("!=", Str("-")))),
+             Return(Bool(false)),
+             .Stmts)
+           Assign(
+             Name("month_tens"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(0))),
+               Int(48)))
+           Assign(
+             Name("month_ones"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(1))),
+               Int(48)))
+           Assign(
+             Name("day_tens"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(3))),
+               Int(48)))
+           Assign(
+             Name("day_ones"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(4))),
+               Int(48)))
+           Assign(
+             Name("year_thousands"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(6))),
+               Int(48)))
+           Assign(
+             Name("year_hundreds"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(7))),
+               Int(48)))
+           Assign(
+             Name("year_tens"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(8))),
+               Int(48)))
+           Assign(
+             Name("year_ones"),
+             BinOp(
+               "-",
+               Call(Name("ord"), Subscript(Name("date"), Int(9))),
+               Int(48)))
+           If(BoolOp(
+             "or",
+             Compare(Name("month_tens"), CmpOp("<", Int(0))),
+             Compare(Name("month_tens"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("month_ones"), CmpOp("<", Int(0))),
+             Compare(Name("month_ones"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("day_tens"), CmpOp("<", Int(0))),
+             Compare(Name("day_tens"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("day_ones"), CmpOp("<", Int(0))),
+             Compare(Name("day_ones"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("year_thousands"), CmpOp("<", Int(0))),
+             Compare(Name("year_thousands"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("year_hundreds"), CmpOp("<", Int(0))),
+             Compare(Name("year_hundreds"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("year_tens"), CmpOp("<", Int(0))),
+             Compare(Name("year_tens"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("year_ones"), CmpOp("<", Int(0))),
+             Compare(Name("year_ones"), CmpOp(">", Int(9)))),
+             Return(Bool(false)),
+             .Stmts)
+           Assign(
+             Name("month"),
+             BinOp(
+               "+",
+               BinOp("*", Name("month_tens"), Int(10)),
+               Name("month_ones")))
+           Assign(
+             Name("day"),
+             BinOp(
+               "+",
+               BinOp("*", Name("day_tens"), Int(10)),
+               Name("day_ones")))
+           If(Compare(Name("month"), CmpOp("==", Int(2))),
+             Return(
+               BoolOp(
+                 "and",
+                 Compare(Name("day"), CmpOp(">=", Int(1))),
+                 Compare(Name("day"), CmpOp("<=", Int(29))))),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("month"), CmpOp("==", Int(4))),
+             Compare(Name("month"), CmpOp("==", Int(6))),
+             Compare(Name("month"), CmpOp("==", Int(9))),
+             Compare(Name("month"), CmpOp("==", Int(11)))),
+             Return(
+               BoolOp(
+                 "and",
+                 Compare(Name("day"), CmpOp(">=", Int(1))),
+                 Compare(Name("day"), CmpOp("<=", Int(30))))),
+             .Stmts)
+           If(BoolOp(
+             "or",
+             Compare(Name("month"), CmpOp("==", Int(1))),
+             Compare(Name("month"), CmpOp("==", Int(3))),
+             Compare(Name("month"), CmpOp("==", Int(5))),
+             Compare(Name("month"), CmpOp("==", Int(7))),
+             Compare(Name("month"), CmpOp("==", Int(8))),
+             Compare(Name("month"), CmpOp("==", Int(10))),
+             Compare(Name("month"), CmpOp("==", Int(12)))),
+             Return(
+               BoolOp(
+                 "and",
+                 Compare(Name("day"), CmpOp(">=", Int(1))),
+                 Compare(Name("day"), CmpOp("<=", Int(31))))),
+             .Stmts)
+           Return(Bool(false))))
+
+  // Proof-local mathematical summaries.  None of these rules rewrites an
+  // MPY program term or bypasses fixed-semantics execution.
+  syntax Bool ::= asciiDigit(Int) [function, total]
+  rule asciiDigit(C) => 48 <=Int C andBool C <=Int 57
+
+  syntax Bool ::= validMonthDay(Int, Int) [function, total]
+  rule validMonthDay(M, D)
+    => (M ==Int 2
+        andBool 1 <=Int D andBool D <=Int 29)
+       orBool
+       ((M ==Int 4 orBool M ==Int 6 orBool M ==Int 9 orBool M ==Int 11)
+        andBool 1 <=Int D andBool D <=Int 30)
+       orBool
+       ((M ==Int 1 orBool M ==Int 3 orBool M ==Int 5
+         orBool M ==Int 7 orBool M ==Int 8 orBool M ==Int 10
+         orBool M ==Int 12)
+        andBool 1 <=Int D andBool D <=Int 31)
+
+  syntax Bool ::= validDateResult(IntSeq) [function, total]
+  rule validDateResult(CS) => false
+    requires isLen(CS) =/=Int 10
+
+  rule validDateResult(CS)
+    => intSeqAt(CS, 2) ==Int 45
+       andBool intSeqAt(CS, 5) ==Int 45
+       andBool asciiDigit(intSeqAt(CS, 0))
+       andBool asciiDigit(intSeqAt(CS, 1))
+       andBool asciiDigit(intSeqAt(CS, 3))
+       andBool asciiDigit(intSeqAt(CS, 4))
+       andBool asciiDigit(intSeqAt(CS, 6))
+       andBool asciiDigit(intSeqAt(CS, 7))
+       andBool asciiDigit(intSeqAt(CS, 8))
+       andBool asciiDigit(intSeqAt(CS, 9))
+       andBool validMonthDay(
+         (intSeqAt(CS, 0) -Int 48) *Int 10
+           +Int (intSeqAt(CS, 1) -Int 48),
+         (intSeqAt(CS, 3) -Int 48) *Int 10
+           +Int (intSeqAt(CS, 4) -Int 48))
+    requires isLen(CS) ==Int 10
+endmodule

