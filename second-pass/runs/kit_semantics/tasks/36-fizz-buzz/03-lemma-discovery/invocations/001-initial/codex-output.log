#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
python3 check_identity.py

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun concrete-tests.mpy --definition runtime-kompiled

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY; then
  echo "ERROR: false-postcondition mutation unexpectedly proved" >&2
  exit 1
else
  echo "EXPECTED FAILURE: false-postcondition mutation was rejected"
fi

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION; then
  echo "ERROR: mutated implementation unexpectedly proved" >&2
  exit 1
else
  echo "EXPECTED FAILURE: mutated implementation was rejected"
fi

python3 validate.py

-- verification.k --
requires "reference-semantics/semantics.k"

module VERIFICATION-SYNTAX
  imports MPY-SYNTAX
  imports INT

  syntax Int ::= digitResult(Int, Int) [function]
               | fizzResult(Int, Int) [function]
endmodule

module VERIFICATION
  imports MPY
  imports VERIFICATION-SYNTAX
  imports INT
  imports BOOL

  // Tail-recursive mathematical result of the inner loop.
  rule digitResult(C, N) => C
    requires N <=Int 0
    [simplification]
  rule digitResult(C, N) =>
      C +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
    requires N >Int 0
     andBool (N -Int pyMod(N, 10)) /Int 10 <=Int 0
    [simplification]
  rule digitResult(
         C +Int
           (#if ((N %Int 10) +Int 10) %Int 10 ==Int 7
            #then 1 #else 0 #fi),
         (N -Int (((N %Int 10) +Int 10) %Int 10)) /Int 10)
       => digitResult(C, N)
    requires N >Int 0
    [simplification]

  // Tail-recursive mathematical result of the outer loop.
  rule fizzResult(C, N) => C
    requires N <=Int 0
    [simplification]
  rule fizzResult(digitResult(C, N +Int -1), N +Int -1)
       => fizzResult(C, N)
    requires N >Int 0
     andBool (
       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
       orBool
       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
    [simplification]
  rule fizzResult(C, N +Int -1)
       => fizzResult(C, N)
    requires N >Int 0
     andBool notBool (
       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
       orBool
       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
    [simplification]
endmodule

