Module(
  FuncDef("fizz_buzz", Params("n"),
    Assign(Name("count"), Int(0))
    Assign(Name("i"), Name("n"))
    Assign(Name("x"), Int(0))
    While(Compare(Name("i"), CmpOp(">", Int(0))),
      Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
      If(BoolOp(
        "or",
        Compare(BinOp("%", Name("i"), Int(11)), CmpOp("==", Int(0))),
        Compare(BinOp("%", Name("i"), Int(13)), CmpOp("==", Int(0)))),
        Assign(Name("x"), Name("i"))
        While(Compare(Name("x"), CmpOp(">", Int(0))),
          Assign(
            Name("count"),
            BinOp(
              "+",
              Name("count"),
              Compare(
                BinOp("%", Name("x"), Int(10)),
                CmpOp("==", Int(7)))))
          Assign(Name("x"), BinOp("//", Name("x"), Int(10)))),
        ))
    Return(Name("count")))
  Assert(
    Compare(
      Call(Name("fizz_buzz"), UnaryOp("-", Int(5))),
      CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("fizz_buzz"), Int(0)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("fizz_buzz"), Int(1)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("fizz_buzz"), Int(50)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("fizz_buzz"), Int(77)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("fizz_buzz"), Int(78)), CmpOp("==", Int(2))))
  Assert(Compare(Call(Name("fizz_buzz"), Int(79)), CmpOp("==", Int(3))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(117)), CmpOp("==", Int(3))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(118)), CmpOp("==", Int(4))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(143)), CmpOp("==", Int(4))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(144)), CmpOp("==", Int(4))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(176)), CmpOp("==", Int(4))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(177)), CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(178)), CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(187)), CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(188)), CmpOp("==", Int(6))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(777)), CmpOp("==", Int(37))))
  Assert(
    Compare(Call(Name("fizz_buzz"), Int(1000)), CmpOp("==", Int(47)))))
