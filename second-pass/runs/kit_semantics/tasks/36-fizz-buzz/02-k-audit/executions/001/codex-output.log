+            rows.append(("l", rel, path.readlink().as_posix()))
+        elif path.is_dir():
+            rows.append(("d", rel, ""))
+        elif path.is_file():
+            rows.append(("f", rel, sha256(path.read_bytes()).hexdigest()))
+        else:
+            rows.append(("?", rel, ""))
+    return rows
