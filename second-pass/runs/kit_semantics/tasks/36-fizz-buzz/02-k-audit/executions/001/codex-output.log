+  "$@"
+  local status=$?
+  printf 'EXIT STATUS: %s\n' "$status"
+  return "$status"
+}
+
+run kompile --version || exit $?
+run kprove --version || exit $?
+
+printf 'COMMAND: python3 trusted/py2mpy.py audit-concrete-tests.py > audit-concrete-tests.mpy\n'
