+run kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition audit-runtime-kompiled || exit $?
+
+run krun audit-concrete-tests.mpy \
