+
+run kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition audit-verification-kompiled || exit $?
+
+run kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module SPEC || exit $?
+
+run kprove spec.k \
+  --definition audit-verification-kompiled \
