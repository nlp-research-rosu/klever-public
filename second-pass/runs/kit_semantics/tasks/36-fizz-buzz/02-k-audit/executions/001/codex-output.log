+    root = Path(root_name)
+    rows = []
+    for path in sorted(root.rglob("*")):
+        rel = path.relative_to(root).as_posix()
+        if path.is_symlink():
+            rows.append(("l", rel, path.readlink().as_posix()))
+        elif path.is_dir():
+            rows.append(("d", rel, ""))
+        elif path.is_file():
+            rows.append(("f", rel, sha256(path.read_bytes()).hexdigest()))
