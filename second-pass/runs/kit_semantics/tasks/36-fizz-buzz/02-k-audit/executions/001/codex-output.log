+  --claims SPEC.inner-loop || exit $?
+
+run kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.inner-loop,SPEC.outer-loop || exit $?
+
+run kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.inner-loop,SPEC.outer-loop,SPEC.fizz-buzz || exit $?
