+      => ?R:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fizz_buzz" |->
+          closureVal(
+            "n",
+            Assign(Name("count"), Int(0))
+            Assign(Name("i"), Name("n"))
+            Assign(Name("x"), Int(0))
+            While(Compare(Name("i"), CmpOp(">", Int(0))),
+              Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+              If(BoolOp(
+                "or",
+                Compare(
+                  BinOp("%", Name("i"), Int(11)),
+                  CmpOp("==", Int(0))),
