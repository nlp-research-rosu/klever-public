+  rule (C +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
+          +Int digitSevens((N -Int pyMod(N, 10)) /Int 10))
+       ==Int (C +Int digitSevens(N))
+       => true
+    requires N >Int 0
+    [simplification]
+  rule digitSevens(N) =>
+       #if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi
+    requires N >Int 0
+     andBool (N -Int pyMod(N, 10)) /Int 10 <=Int 0
+    [simplification]
+
+  // Contribution of one candidate integer to fizz_buzz's result.
+  rule qualifyingSevens(N) =>
