+      #while(Compare(Name("x"), CmpOp(">", Int(0))),
+        Assign(
+          Name("count"),
+          BinOp(
+            "+",
+            Name("count"),
+            Compare(
+              BinOp("%", Name("x"), Int(10)),
+              CmpOp("==", Int(7)))))
+        Assign(Name("x"), BinOp("//", Name("x"), Int(10))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => C +Int digitSevens(X))
+        "i"     |-> I:Int
+        "n"     |-> N:Int
+        "x"     |-> (X:Int => 0),
+        parent(0))
+      ...
+    </scopes>
+    requires X >=Int 0
+
+  // Exact outer while-loop: process all candidates below I.
