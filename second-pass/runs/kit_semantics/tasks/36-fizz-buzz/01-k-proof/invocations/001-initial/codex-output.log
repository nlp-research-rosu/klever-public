+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => digitResult(C, X))
+        "i"     |-> I:Int
+        "n"     |-> N:Int
+        "x"     |-> (X:Int => 0),
+        parent(0))
+      ...
+    </scopes>
+    requires X >=Int 0
+
+  // Exact outer while-loop: process all candidates below I.
+  claim [outer-loop]:
+    <k>
+      #while(Compare(Name("i"), CmpOp(">", Int(0))),
+        Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+        If(BoolOp(
+          "or",
+          Compare(
+            BinOp("%", Name("i"), Int(11)),
+            CmpOp("==", Int(0))),
+          Compare(
+            BinOp("%", Name("i"), Int(13)),
+            CmpOp("==", Int(0)))),
+          Assign(Name("x"), Name("i"))
