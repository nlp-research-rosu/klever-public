index 0000000000000000000000000000000000000000..a8242c105490dce3567051b1d72b027ec2cd0623
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,128 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact inner while-loop: add the number of 7 digits in X to count.
+  claim [inner-loop]:
+    <k>
+      #while(Compare(Name("x"), CmpOp(">", Int(0))),
+        Assign(
+          Name("count"),
+          BinOp(
+            "+",
+            Name("count"),
+            Compare(
+              BinOp("%", Name("x"), Int(10)),
+              CmpOp("==", Int(7)))))
+        Assign(Name("x"), BinOp("//", Name("x"), Int(10))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => digitResult(C, X))
+        "i"     |-> I:Int
+        "n"     |-> N:Int
+        "x"     |-> (X:Int => 0),
+        parent(0))
+      ...
+    </scopes>
+    requires X >=Int 0
+
+  // Exact outer while-loop: process all candidates below I.
+  claim [outer-loop]:
+    <k>
+      #while(Compare(Name("i"), CmpOp(">", Int(0))),
+        Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+        If(BoolOp(
+          "or",
+          Compare(
+            BinOp("%", Name("i"), Int(11)),
+            CmpOp("==", Int(0))),
+          Compare(
+            BinOp("%", Name("i"), Int(13)),
+            CmpOp("==", Int(0)))),
+          Assign(Name("x"), Name("i"))
+          While(Compare(Name("x"), CmpOp(">", Int(0))),
+            Assign(
+              Name("count"),
+              BinOp(
+                "+",
+                Name("count"),
+                Compare(
+                  BinOp("%", Name("x"), Int(10)),
+                  CmpOp("==", Int(7)))))
+            Assign(Name("x"), BinOp("//", Name("x"), Int(10)))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => fizzResult(C, I))
+        "i"     |-> (I:Int => 0)
+        "n"     |-> N:Int
+        "x"     |-> 0,
+        parent(0))
+      ...
+    </scopes>
+    requires I >=Int 0
+
+  // Exact closure invocation for the implementation in solution.mpy.
+  claim [fizz-buzz]:
+    <k>
+      Call(Name("fizz_buzz"), Int(N:Int))
+      => ?R:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fizz_buzz" |->
+          closureVal(
+            "n",
+            Assign(Name("count"), Int(0))
+            Assign(Name("i"), Name("n"))
+            Assign(Name("x"), Int(0))
+            While(Compare(Name("i"), CmpOp(">", Int(0))),
+              Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+              If(BoolOp(
+                "or",
+                Compare(
+                  BinOp("%", Name("i"), Int(11)),
+                  CmpOp("==", Int(0))),
+                Compare(
+                  BinOp("%", Name("i"), Int(13)),
+                  CmpOp("==", Int(0)))),
+                Assign(Name("x"), Name("i"))
+                While(Compare(Name("x"), CmpOp(">", Int(0))),
+                  Assign(
+                    Name("count"),
+                    BinOp(
+                      "+",
+                      Name("count"),
+                      Compare(
+                        BinOp("%", Name("x"), Int(10)),
+                        CmpOp("==", Int(7)))))
+                  Assign(
+                    Name("x"),
+                    BinOp("//", Name("x"), Int(10)))),
+                .Stmts))
+            Return(Name("count")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Int fizzResult(0, N)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5a574a91f71619cd10d0fe2e8dc7b4f98bfacc6b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  syntax Bool ::= isQualifying(Int) [function, total]
+  syntax Int ::= digitResult(Int, Int) [function]
+               | fizzResult(Int, Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule isQualifying(N) =>
+      pyMod(N, 11) ==Int 0 orBool pyMod(N, 13) ==Int 0
+
+  // Tail-recursive mathematical result of the inner loop.
+  rule digitResult(C, N) => C
+    requires N <=Int 0
+    [simplification]
+  rule digitResult(C, N) =>
+      C +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
+    requires N >Int 0
+     andBool (N -Int pyMod(N, 10)) /Int 10 <=Int 0
+    [simplification]
+  rule digitResult(
+         C +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi),
+         (N -Int pyMod(N, 10)) /Int 10)
+       => digitResult(C, N)
+    requires N >Int 0
+    [simplification]
+
+  // Tail-recursive mathematical result of the outer loop.
+  rule fizzResult(C, N) => C
+    requires N <=Int 0
+    [simplification]
+  rule fizzResult(C, N) => C
+    requires N >Int 0 andBool N <=Int 1
+    [simplification]
+  rule fizzResult(digitResult(C, N -Int 1), N -Int 1)
+       => fizzResult(C, N)
+    requires N >Int 1 andBool isQualifying(N -Int 1)
+    [simplification]
+  rule fizzResult(C, N -Int 1)
+       => fizzResult(C, N)
+    requires N >Int 1 andBool notBool isQualifying(N -Int 1)
+    [simplification]
+endmodule

codex
The accumulator shape now matches exactly, and the remaining mismatch is syntactic: rules are indexed before the helper `pyMod` on their left-hand side is unfolded, while the runtime state already contains its normalized modulo expression. I’m inlining that supplied semantics equation in the fold pattern so matching is structural.
apply patch
patch: completed
/workspace/verification.k
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5bd01cc1abfc2a2f953dea854b1eed9fd5f04b4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = n
+    x = 0
+    while i > 0:
+        i = i - 1
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                count = count + (x % 10 == 7)
+                x = x // 10
+    return count
