diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..a638b726e32d6b018ccaf18dbfe71a570bcb0773
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,35 @@
+from solution import fizz_buzz
+
+
+def arithmetic_model(n):
+    total = 0
+    for candidate in range(n):
+        if candidate % 11 == 0 or candidate % 13 == 0:
+            value = candidate
+            while value > 0:
+                total += value % 10 == 7
+                value //= 10
+    return total
+
+
+def string_oracle(n):
+    return sum(
+        str(candidate).count("7")
+        for candidate in range(n)
+        if candidate % 11 == 0 or candidate % 13 == 0
+    )
+
+
+inputs = list(range(-25, 501)) + [777, 1000, 2026, 5000, 10000]
+mismatches = []
+for value in inputs:
+    implementation = fizz_buzz(value)
+    model = arithmetic_model(value)
+    oracle = string_oracle(value)
+    if not implementation == model == oracle:
+        mismatches.append((value, implementation, model, oracle))
+
+print(f"inputs={len(inputs)} mismatches={len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..870c04775cd965e4d89c1e3cc40349f4668f54af
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,55 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+
+  syntax Int ::= digitResult(Int, Int) [function]
+               | fizzResult(Int, Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  // Tail-recursive mathematical result of the inner loop.
+  rule digitResult(C, N) => C
+    requires N <=Int 0
+    [simplification]
+  rule digitResult(C, N) =>
+      C +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
+    requires N >Int 0
+     andBool (N -Int pyMod(N, 10)) /Int 10 <=Int 0
+    [simplification]
+  rule digitResult(
+         C +Int
+           (#if ((N %Int 10) +Int 10) %Int 10 ==Int 7
+            #then 1 #else 0 #fi),
+         (N -Int (((N %Int 10) +Int 10) %Int 10)) /Int 10)
+       => digitResult(C, N)
+    requires N >Int 0
+    [simplification]
+
+  // Tail-recursive mathematical result of the outer loop.
+  rule fizzResult(C, N) => C
+    requires N <=Int 0
+    [simplification]
+  rule fizzResult(digitResult(C, N +Int -1), N +Int -1)
+       => fizzResult(C, N)
+    requires N >Int 0
+     andBool (
+       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
+       orBool
+       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
+    [simplification]
+  rule fizzResult(C, N +Int -1)
+       => fizzResult(C, N)
+    requires N >Int 0
+     andBool notBool (
+       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
+       orBool
+       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
+    [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..4a277f8e704042405f240315492b8d573fb547ef
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,21 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = n
+    x = 0
+    while i > 0:
+        i = i - 1
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                count = count + (x % 10 == 7)
+                x = x // 10
+    return count
+
+
+assert fizz_buzz(-5) == 0
+assert fizz_buzz(0) == 0
+assert fizz_buzz(50) == 0
+assert fizz_buzz(78) == 2
+assert fizz_buzz(79) == 3
+assert fizz_buzz(177) == 5
+assert fizz_buzz(777) == 37
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..98d1ac976d06eaba066cba0a05e642fdf028c2d4
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY; then
+  echo "ERROR: false-postcondition mutation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-postcondition mutation was rejected"
+fi
+
+if kprove spec-body-mutation.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-BODY-MUTATION; then
+  echo "ERROR: mutated implementation unexpectedly proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: mutated implementation was rejected"
+fi
+
+python3 validate.py
