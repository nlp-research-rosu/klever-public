new file mode 100644
index 0000000000000000000000000000000000000000..d5bd01cc1abfc2a2f953dea854b1eed9fd5f04b4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = n
+    x = 0
+    while i > 0:
+        i = i - 1
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                count = count + (x % 10 == 7)
+                x = x // 10
+    return count
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b0beb890ad31c2ca239db32993be10843023231f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,128 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact inner while-loop: add the number of 7 digits in X to count.
+  claim [inner-loop]:
+    <k>
+      While(Compare(Name("x"), CmpOp(">", Int(0))),
+        Assign(
+          Name("count"),
+          BinOp(
+            "+",
+            Name("count"),
+            Compare(
+              BinOp("%", Name("x"), Int(10)),
+              CmpOp("==", Int(7)))))
+        Assign(Name("x"), BinOp("//", Name("x"), Int(10))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => C +Int digitSevens(X))
+        "i"     |-> I:Int
+        "n"     |-> N:Int
+        "x"     |-> (X:Int => 0),
+        parent(0))
+      ...
+    </scopes>
+    requires X >=Int 0
+
+  // Exact outer while-loop: process all candidates below I.
+  claim [outer-loop]:
+    <k>
+      While(Compare(Name("i"), CmpOp(">", Int(0))),
+        Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+        If(BoolOp(
+          "or",
+          Compare(
+            BinOp("%", Name("i"), Int(11)),
+            CmpOp("==", Int(0))),
+          Compare(
+            BinOp("%", Name("i"), Int(13)),
+            CmpOp("==", Int(0)))),
+          Assign(Name("x"), Name("i"))
+          While(Compare(Name("x"), CmpOp(">", Int(0))),
+            Assign(
+              Name("count"),
+              BinOp(
+                "+",
+                Name("count"),
+                Compare(
+                  BinOp("%", Name("x"), Int(10)),
+                  CmpOp("==", Int(7)))))
+            Assign(Name("x"), BinOp("//", Name("x"), Int(10)))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => C +Int fizzBuzzCount(I))
+        "i"     |-> (I:Int => 0)
+        "n"     |-> N:Int
+        "x"     |-> 0,
+        parent(0))
+      ...
+    </scopes>
+    requires I >=Int 0
+
+  // Exact closure invocation for the implementation in solution.mpy.
+  claim [fizz-buzz]:
+    <k>
+      Call(Name("fizz_buzz"), Int(N:Int))
+      => ?R:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fizz_buzz" |->
+          closureVal(
+            "n",
+            Assign(Name("count"), Int(0))
+            Assign(Name("i"), Name("n"))
+            Assign(Name("x"), Int(0))
+            While(Compare(Name("i"), CmpOp(">", Int(0))),
+              Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+              If(BoolOp(
+                "or",
+                Compare(
+                  BinOp("%", Name("i"), Int(11)),
+                  CmpOp("==", Int(0))),
+                Compare(
+                  BinOp("%", Name("i"), Int(13)),
+                  CmpOp("==", Int(0)))),
+                Assign(Name("x"), Name("i"))
+                While(Compare(Name("x"), CmpOp(">", Int(0))),
+                  Assign(
+                    Name("count"),
+                    BinOp(
+                      "+",
+                      Name("count"),
+                      Compare(
+                        BinOp("%", Name("x"), Int(10)),
+                        CmpOp("==", Int(7)))))
+                  Assign(
+                    Name("x"),
+                    BinOp("//", Name("x"), Int(10)))),
+                .Stmts))
+            Return(Name("count")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Int fizzBuzzCount(N)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e90de4ad2446a2f83fa76bc0a261a24d031c10c9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+
+  syntax Int ::= digitSevens(Int) [function]
+               | qualifyingSevens(Int) [function, total]
+               | fizzBuzzCount(Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  // Number of decimal digit 7s in a nonnegative integer.  Zero has no 7s.
+  rule digitSevens(N) => 0
+    requires N <=Int 0
+    [simplification]
+  rule digitSevens((N -Int pyMod(N, 10)) /Int 10)
+       +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
+       => digitSevens(N)
+    requires N >Int 0
+    [simplification]
+  rule (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
+       +Int digitSevens((N -Int pyMod(N, 10)) /Int 10)
+       => digitSevens(N)
+    requires N >Int 0
+    [simplification]
+  rule digitSevens(N) =>
+       #if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi
+    requires N >Int 0
+     andBool (N -Int pyMod(N, 10)) /Int 10 <=Int 0
+    [simplification]
+
+  // Contribution of one candidate integer to fizz_buzz's result.
+  rule qualifyingSevens(N) =>
+      #if pyMod(N, 11) ==Int 0 orBool pyMod(N, 13) ==Int 0
+      #then digitSevens(N)
+      #else 0
+      #fi
+
+  // Count for range(N).  For N <= 0, Python's range(N) is empty.
+  rule fizzBuzzCount(N) => 0
+    requires N <=Int 0
+    [simplification]
+  rule fizzBuzzCount(N -Int 1) +Int qualifyingSevens(N -Int 1)
+       => fizzBuzzCount(N)
+    requires N >Int 0
+    [simplification]
+endmodule

