+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact inner while-loop: add the number of 7 digits in X to count.
+  claim [inner-loop]:
+    <k>
+      #while(Compare(Name("x"), CmpOp(">", Int(0))),
+        Assign(
+          Name("count"),
+          BinOp(
+            "+",
+            Name("count"),
+            Compare(
+              BinOp("%", Name("x"), Int(10)),
+              CmpOp("==", Int(7)))))
+        Assign(Name("x"), BinOp("//", Name("x"), Int(10))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => digitResult(C, X))
+        "i"     |-> I:Int
+        "n"     |-> N:Int
+        "x"     |-> (X:Int => 0),
+        parent(0))
+      ...
+    </scopes>
+    requires X >=Int 0
+
+  // Exact outer while-loop: process all candidates below I.
+  claim [outer-loop]:
+    <k>
+      #while(Compare(Name("i"), CmpOp(">", Int(0))),
+        Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+        If(BoolOp(
+          "or",
+          Compare(
+            BinOp("%", Name("i"), Int(11)),
+            CmpOp("==", Int(0))),
+          Compare(
+            BinOp("%", Name("i"), Int(13)),
+            CmpOp("==", Int(0)))),
+          Assign(Name("x"), Name("i"))
+          While(Compare(Name("x"), CmpOp(">", Int(0))),
+            Assign(
+              Name("count"),
+              BinOp(
+                "+",
+                Name("count"),
+                Compare(
+                  BinOp("%", Name("x"), Int(10)),
+                  CmpOp("==", Int(7)))))
+            Assign(Name("x"), BinOp("//", Name("x"), Int(10)))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => fizzResult(C, I))
+        "i"     |-> (I:Int => 0)
+        "n"     |-> N:Int
+        "x"     |-> 0,
+        parent(0))
+      ...
+    </scopes>
+    requires I >=Int 0
+
+  // Exact closure invocation for the implementation in solution.mpy.
+  claim [fizz-buzz]:
+    <k>
+      Call(Name("fizz_buzz"), Int(N:Int))
+      => ?R:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fizz_buzz" |->
+          closureVal(
+            "n",
+            Assign(Name("count"), Int(0))
+            Assign(Name("i"), Name("n"))
+            Assign(Name("x"), Int(0))
+            While(Compare(Name("i"), CmpOp(">", Int(0))),
+              Assign(Name("i"), BinOp("-", Name("i"), Int(1)))
+              If(BoolOp(
+                "or",
+                Compare(
+                  BinOp("%", Name("i"), Int(11)),
+                  CmpOp("==", Int(0))),
+                Compare(
+                  BinOp("%", Name("i"), Int(13)),
+                  CmpOp("==", Int(0)))),
+                Assign(Name("x"), Name("i"))
+                While(Compare(Name("x"), CmpOp(">", Int(0))),
+                  Assign(
+                    Name("count"),
+                    BinOp(
+                      "+",
+                      Name("count"),
+                      Compare(
+                        BinOp("%", Name("x"), Int(10)),
+                        CmpOp("==", Int(7)))))
+                  Assign(
+                    Name("x"),
+                    BinOp("//", Name("x"), Int(10)))),
+                .Stmts))
+            Return(Name("count")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Int fizzResult(0, N)
+endmodule
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..a638b726e32d6b018ccaf18dbfe71a570bcb0773
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,35 @@
+from solution import fizz_buzz
+
+
+def arithmetic_model(n):
+    total = 0
+    for candidate in range(n):
+        if candidate % 11 == 0 or candidate % 13 == 0:
+            value = candidate
+            while value > 0:
+                total += value % 10 == 7
+                value //= 10
+    return total
+
+
+def string_oracle(n):
+    return sum(
+        str(candidate).count("7")
+        for candidate in range(n)
+        if candidate % 11 == 0 or candidate % 13 == 0
+    )
+
+
+inputs = list(range(-25, 501)) + [777, 1000, 2026, 5000, 10000]
+mismatches = []
+for value in inputs:
+    implementation = fizz_buzz(value)
+    model = arithmetic_model(value)
+    oracle = string_oracle(value)
+    if not implementation == model == oracle:
+        mismatches.append((value, implementation, model, oracle))
+
+print(f"inputs={len(inputs)} mismatches={len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..870c04775cd965e4d89c1e3cc40349f4668f54af
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,55 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+
+  syntax Int ::= digitResult(Int, Int) [function]
+               | fizzResult(Int, Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  // Tail-recursive mathematical result of the inner loop.
+  rule digitResult(C, N) => C
+    requires N <=Int 0
+    [simplification]
+  rule digitResult(C, N) =>
+      C +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
+    requires N >Int 0
+     andBool (N -Int pyMod(N, 10)) /Int 10 <=Int 0
+    [simplification]
+  rule digitResult(
+         C +Int
+           (#if ((N %Int 10) +Int 10) %Int 10 ==Int 7
+            #then 1 #else 0 #fi),
+         (N -Int (((N %Int 10) +Int 10) %Int 10)) /Int 10)
+       => digitResult(C, N)
+    requires N >Int 0
+    [simplification]
+
+  // Tail-recursive mathematical result of the outer loop.
+  rule fizzResult(C, N) => C
+    requires N <=Int 0
+    [simplification]
+  rule fizzResult(digitResult(C, N +Int -1), N +Int -1)
+       => fizzResult(C, N)
+    requires N >Int 0
+     andBool (
+       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
+       orBool
+       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
+    [simplification]
+  rule fizzResult(C, N +Int -1)
+       => fizzResult(C, N)
+    requires N >Int 0
+     andBool notBool (
+       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
+       orBool
+       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
+    [simplification]
+endmodule

