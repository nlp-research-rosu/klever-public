+       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
+       orBool
+       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
+    [simplification]
+  rule fizzResult(C, N +Int -1)
+       => fizzResult(C, N)
+    requires N >Int 1
+     andBool notBool (
+       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
+       orBool
+       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
+    [simplification]
+endmodule

