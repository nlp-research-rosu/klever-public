+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule isQualifying(N) =>
+      pyMod(N, 11) ==Int 0 orBool pyMod(N, 13) ==Int 0
