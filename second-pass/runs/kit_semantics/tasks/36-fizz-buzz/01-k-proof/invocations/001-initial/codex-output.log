diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2b41167e9353a8a01edac6f369bed4e80ce186c0
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+
+  syntax Int ::= digitSevens(Int) [function]
+               | qualifyingSevens(Int) [function, total]
+               | fizzBuzzCount(Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  // Number of decimal digit 7s in a nonnegative integer.  Zero has no 7s.
+  rule digitSevens(N) => 0
+    requires N <=Int 0
+    [simplification]
+  rule digitSevens(N /Int 10)
+       +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
+       => digitSevens(N)
+    requires N >Int 0
+    [simplification]
+
+  // Contribution of one candidate integer to fizz_buzz's result.
+  rule qualifyingSevens(N) =>
+      #if pyMod(N, 11) ==Int 0 orBool pyMod(N, 13) ==Int 0
+      #then digitSevens(N)
+      #else 0
+      #fi
+
+  // Count for range(N).  For N <= 0, Python's range(N) is empty.
+  rule fizzBuzzCount(N) => 0
+    requires N <=Int 0
+    [simplification]
+  rule fizzBuzzCount(N -Int 1) +Int qualifyingSevens(N -Int 1)
+       => fizzBuzzCount(N)
+    requires N >Int 0
+    [simplification]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5bd01cc1abfc2a2f953dea854b1eed9fd5f04b4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = n
+    x = 0
+    while i > 0:
+        i = i - 1
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                count = count + (x % 10 == 7)
+                x = x // 10
+    return count
