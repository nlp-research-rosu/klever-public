diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0f1aa10ca41bdae412eb87285f7a1d6debd1b759
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  syntax Bool ::= isQualifying(Int) [function, total]
+  syntax Int ::= digitResult(Int, Int) [function]
+               | fizzResult(Int, Int) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule isQualifying(N) =>
+      pyMod(N, 11) ==Int 0 orBool pyMod(N, 13) ==Int 0
+
+  // Tail-recursive mathematical result of the inner loop.
+  rule digitResult(C, N) => C
+    requires N <=Int 0
+    [simplification]
+  rule digitResult(C, N) =>
+      C +Int (#if pyMod(N, 10) ==Int 7 #then 1 #else 0 #fi)
+    requires N >Int 0
+     andBool (N -Int pyMod(N, 10)) /Int 10 <=Int 0
+    [simplification]
+  rule digitResult(
+         C +Int
+           (#if ((N %Int 10) +Int 10) %Int 10 ==Int 7
+            #then 1 #else 0 #fi),
+         (N -Int (((N %Int 10) +Int 10) %Int 10)) /Int 10)
+       => digitResult(C, N)
+    requires N >Int 0
+    [simplification]
+
+  // Tail-recursive mathematical result of the outer loop.
+  rule fizzResult(C, N) => C
+    requires N <=Int 0
+    [simplification]
+  rule fizzResult(C, N) => C
+    requires N >Int 0 andBool N <=Int 1
+    [simplification]
+  rule fizzResult(digitResult(C, N +Int -1), N +Int -1)
+       => fizzResult(C, N)
+    requires N >Int 1
+     andBool (
+       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
+       orBool
+       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
+    [simplification]
+  rule fizzResult(C, N +Int -1)
+       => fizzResult(C, N)
+    requires N >Int 1
+     andBool notBool (
+       ((((N +Int -1) %Int 11) +Int 11) %Int 11 ==Int 0)
+       orBool
+       ((((N +Int -1) %Int 13) +Int 13) %Int 13 ==Int 0))
+    [simplification]
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5bd01cc1abfc2a2f953dea854b1eed9fd5f04b4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = n
+    x = 0
+    while i > 0:
+        i = i - 1
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                count = count + (x % 10 == 7)
+                x = x // 10
+    return count
