+                    BinOp(
+                      "+",
+                      Name("count"),
+                      Compare(
+                        BinOp("%", Name("x"), Int(10)),
+                        CmpOp("==", Int(7)))))
+                  Assign(
+                    Name("x"),
+                    BinOp("//", Name("x"), Int(10)))),
+                .Stmts))
+            Return(Name("count")),
