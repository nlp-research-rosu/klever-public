+    prefix = name + "("
+    if not text.startswith(prefix, start):
+        raise ValueError(f"expected {prefix!r} at offset {start}")
+    args = []
+    arg_start = start + len(prefix)
+    depth = 0
+    in_string = False
+    escaped = False
+    index = arg_start
+    while index < len(text):
+        char = text[index]
+        if in_string:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                in_string = False
+        elif char == '"':
+            in_string = True
