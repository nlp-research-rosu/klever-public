+                Name("count"),
+                Compare(
+                  BinOp("%", Name("x"), Int(10)),
+                  CmpOp("==", Int(7)))))
+            Assign(Name("x"), BinOp("//", Name("x"), Int(10)))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (C:Int => fizzResult(C, I))
+        "i"     |-> (I:Int => 0)
+        "n"     |-> N:Int
+        "x"     |-> 0,
+        parent(0))
+      ...
+    </scopes>
+    requires I >=Int 0
+
+  // Exact closure invocation for the implementation in solution.mpy.
+  claim [fizz-buzz]:
+    <k>
