diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5bd01cc1abfc2a2f953dea854b1eed9fd5f04b4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = n
+    x = 0
+    while i > 0:
+        i = i - 1
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                count = count + (x % 10 == 7)
+                x = x // 10
+    return count
