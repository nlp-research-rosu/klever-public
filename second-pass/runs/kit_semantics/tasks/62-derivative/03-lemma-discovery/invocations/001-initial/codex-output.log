+  "rules": [
+    {
+      "source_rule_id": "rule-82fd85d7d877438e349407a829d1e35806842c5943d9c0f294aa58ed3173779c",
+      "classification": "DEFINITION",
+      "rationale": "This is the base equation of the recursive derivAcc mathematical summary: processing an empty remaining coefficient sequence returns the accumulator. It defines the named proof term and does not rewrite an execution configuration."
+    },
+    {
+      "source_rule_id": "rule-51a3749a6415a476a599f9f4b4d86298466c83cbf2e19efd98a63953ec251c03",
+      "classification": "DEFINITION",
+      "rationale": "This is the guarded nonpositive-index recurrence of derivAcc, consuming one sequence constructor while leaving the accumulator unchanged. It is a defining equation for the summary, including its simplification use, rather than an independently asserted mathematical fact."
+    },
+    {
