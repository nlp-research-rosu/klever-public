Module(
  FuncDef("derivative", Params("xs"),
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("x"), NoneVal)
    For(Name("x"), Name("xs"),
      If(Compare(Name("i"), CmpOp(">", Int(0))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            BinOp("*", Name("i"), Name("x")))),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result"))))
