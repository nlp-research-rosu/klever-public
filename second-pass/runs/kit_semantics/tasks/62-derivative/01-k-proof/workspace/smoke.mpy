Module(
  FuncDef("derivative", Params("xs"),
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("x"), NoneVal)
    For(Name("x"), Name("xs"),
      If(Compare(Name("i"), CmpOp(">", Int(0))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            BinOp("*", Name("i"), Name("x")))),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr(Int(7))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(2), Int(6)))))
  Assert(
    Compare(
      Call(
        Name("derivative"),
        ListExpr(Int(3), Int(1), Int(2), Int(4), Int(5))),
      CmpOp("==", ListExpr(Int(1), Int(4), Int(12), Int(20)))))
  Assert(
    Compare(
      Call(
        Name("derivative"),
        ListExpr(
          Int(0),
          UnaryOp("-", Int(2)),
          Int(4),
          UnaryOp("-", Int(3)))),
      CmpOp(
        "==",
        ListExpr(UnaryOp("-", Int(2)), Int(8), UnaryOp("-", Int(9))))))
  Assert(
    Compare(
      Call(
        Name("derivative"),
        ListExpr(Float(1.0), Float(2.5), UnaryOp("-", Float(3.0)))),
      CmpOp("==", ListExpr(Float(2.5), UnaryOp("-", Float(6.0)))))))
