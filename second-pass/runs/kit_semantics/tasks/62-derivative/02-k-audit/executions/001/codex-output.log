/bin/bash -lc "kast --help | rg -n -- '--output|--definition|--sort|--module' | sed -n '1,140p'; python3 /audit-output/evidence/extract_claim_program.py spec.k claim-program.mpy; kast --definition verification-kompiled --module MPY-SYNTAX --sort Module --output kore solution.mpy > solution.kore; kast --definition verification-kompiled --module MPY-SYNTAX --sort Module --output kore claim-program.mpy > claim-program.kore; cmp -s solution.kore claim-program.kore; printf 'cmp_status=%d\\n' \""'$?"; wc -c solution.kore claim-program.kore; diff -u solution.kore claim-program.kore | sed -n '"'1,100p'" in /tmp/audit-work/62-derivative
