print('expected target definition:',klean_export.expected_target_definition(om))
print('generator target:',gm['target'])
print('audit-input target:',ai['resolution']['target'])
print('all target identities exact:',actual_target==gm['target']==ai['resolution']['target'] is None)
print('selected Stage 4 status:',ai['resolution']['selections']['klean_generation']['status'])
print('export result status:',er['status'])
print('candidate exists:',Path('/candidate').exists())
lean_files=sorted(gen.rglob('*.lean'))
forbidden={tok:[] for tok in ('sorry','admit','unsafe')}
for p in lean_files:
 text=p.read_text()
 for tok in forbidden:
  if re.search(rf'\\b{tok}\\b',text): forbidden[tok].append(p.relative_to(gen).as_posix())
print('generated forbidden tokens:',forbidden)
print('generated producer vs trusted exporter sha:',hashlib.sha256(Path('/reference/generation-tools/klean_export.py').read_bytes()).hexdigest(),hashlib.sha256(Path('/reference/tools/klean_export.py').read_bytes()).hexdigest())
print('generated producer vs trusted klean.py sha:',hashlib.sha256(Path('/reference/generation-tools/klean.py').read_bytes()).hexdigest(),hashlib.sha256(Path('/reference/tools/klean.py').read_bytes()).hexdigest())
print('FINAL_STRUCTURAL_RESULT:', all([
 im['definitions']==validated['definitions'],
 im['source_rules']==expected_source_rules,
 om['source_rules']==expected_source_rules,
 obs_ids==exp_ids,
 len(obs_ids)==len(set(obs_ids)),
