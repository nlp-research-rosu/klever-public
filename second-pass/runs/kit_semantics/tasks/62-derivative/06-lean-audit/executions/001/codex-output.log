import json
from pathlib import Path
rec=json.loads(Path('/audit-output/evidence/03_reconstructed_inventory.json').read_text())
disc=json.loads(Path('/reference/lemma-discovery.json').read_text())
print('discovery top-level keys:', sorted(disc))
print('reconstructed schema:', rec['schema_version'])
print('reconstructed verification_file:', rec['verification_file'])
print('reconstructed verification_sha256:', rec['verification_sha256'])
print('reconstructed verification_module:', rec['verification_module'])
print('reconstructed verification_modules:', rec['verification_modules'])
print('reconstructed rule_count:', len(rec['rules']))
print('reconstructed inventory_sha256:', rec['inventory_sha256'])
print('discovery schema:', disc.get('schema_version'))
for key in ('verification_file','verification_sha256','verification_module','verification_modules','inventory_sha256'):
    print(f'discovery {key}:', disc.get(key))
entries = disc.get('classifications', disc.get('rules', disc.get('inventory')))
print('classification container type:', type(entries).__name__)
print('classification count:', len(entries) if isinstance(entries,list) else None)
if isinstance(entries,list):
    print('\\nRECONSTRUCTED ORDER:')
    for i,r in enumerate(rec['rules']):
        print(i, r['source_rule_id'], r['module'], f\"{r['start_line']}-{r['end_line']}\", r['normalized_sha256'], r['attributes'])
        print('  TEXT:', ' '.join(r['text'].split()))
    print('\\nDISCOVERY ORDER/CLASSIFICATION:')
    for i,e in enumerate(entries):
        print(i, e.get('source_rule_id'), e.get('module'), f\"{e.get('start_line')}-{e.get('end_line')}\", e.get('normalized_sha256'), e.get('attributes'), e.get('classification'), e.get('category'))
        print('  KEYS:', sorted(e))
        print('  TEXT:', ' '.join(str(e.get('text','')).split()))
    exact = rec['rules'] == [{k:e.get(k) for k in rec['rules'][0].keys()} for e in entries] if rec['rules'] else not entries
    print('\\nraw rule projection exact:', exact)
    rid_rec=[r['source_rule_id'] for r in rec['rules']]
    rid_disc=[e.get('source_rule_id') for e in entries]
    print('ID sequence exact:', rid_rec==rid_disc)
    print('discovery IDs unique:', len(rid_disc)==len(set(rid_disc)))
    print('missing IDs:', [x for x in rid_rec if x not in set(rid_disc)])
    print('extra IDs:', [x for x in rid_disc if x not in set(rid_rec)])
