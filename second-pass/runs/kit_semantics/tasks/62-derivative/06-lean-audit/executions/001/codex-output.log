print('observed obligation IDs:',obs_ids)
print('obligation IDs exact sequence:',obs_ids==exp_ids)
print('obligation IDs unique:',len(obs_ids)==len(set(obs_ids)))
print('trust_parameters:',om['trust_parameters'])
print('obligation map sha actual:',hashlib.sha256((gen/'obligation-map.json').read_bytes()).hexdigest())
print('obligation map sha manifest:',gm['obligation_map_sha256'])
print('generator obligation_count:',gm['obligation_count'])
