gm=json.loads((root/'generator-manifest.json').read_text())
im=json.loads((root/'input-manifest.json').read_text())
er=json.loads((root/'export-result.json').read_text())
om=json.loads((gen/'obligation-map.json').read_text())
ai=json.loads(Path('/audit-input.json').read_text())
expected_domain=validated['domain_lemmas']
expected_source_rules=klean_export._domain_source_rules(validated,hashlib.sha256(Path('/reference/lemma-discovery.json').read_bytes()).hexdigest())
obs_ids=[x.get('source_rule_id') for x in om['obligations']]
exp_ids=[x['source_rule_id'] for x in expected_source_rules]
