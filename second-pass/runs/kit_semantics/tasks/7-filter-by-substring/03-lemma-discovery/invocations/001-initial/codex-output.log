import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
assert len(out['rules']) == len(inventory['rules'])
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inventory['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == len(out['rules'])
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for canonical, classified in zip(inventory['rules'], out['rules']):
    assert list(classified) == ['source_rule_id', 'classification', 'rationale']
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if 'simplification' in canonical.get('attributes', []):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

counts = {name: sum(r['classification'] == name for r in out['rules']) for name in sorted(allowed)}
print('validated_rules=', len(out['rules']), sep='')
print('inventory_sha256=', out['inventory_sha256'], sep='')
