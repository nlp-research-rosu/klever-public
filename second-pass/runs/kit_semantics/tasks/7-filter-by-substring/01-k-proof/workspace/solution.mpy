Module(
  ImportFrom("typing", "List")
  FuncDef("filter_by_substring", Params("strings", "substring"),
    Assign(Name("result"), ListExpr())
    Assign(Name("string"), Str(""))
    For(Name("string"), Name("strings"),
      If(Compare(Name("substring"), CmpOp("in", Name("string"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
        ))
    Return(Name("result"))))
