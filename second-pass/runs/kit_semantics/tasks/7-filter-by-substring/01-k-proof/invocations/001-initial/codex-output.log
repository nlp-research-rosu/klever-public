+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("string"),
+        If(
+          Compare(Name("substring"), CmpOp("in", Name("string"))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("string"))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      OUTER:Map
+      L |-> scope(
+        "result" |-> ref(H:Int)
+        "substring" |-> str(P:IntSeq)
+        LOCAL:Map,
+        PAR:Parent)
+      =>
+      ?OUTER:Map
+      L |-> scope(
+        "result" |-> ref(H)
+        "substring" |-> str(P)
+        ?LOCAL:Map,
+        PAR)
+    </scopes>
+    <heap>
+      H |-> list(
+        ACC:ValSeq
+        =>
+        filterAcc(ACC, P, VS))
+      HEAP:Map
+    </heap>
+    requires allStrVS(VS)
+      andBool notBool ("$cells" in_keys(LOCAL))
+
+  claim [filter-by-substring]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "filter_by_substring",
+            Params("strings", "substring"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_substring"),
+           list(VS:ValSeq),
+           str(P:IntSeq))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "filter_by_substring" |->
+          closureVal(
+            ("strings", "substring", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(filterAcc(.ValSeq, P, VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrVS(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9b576bda63d9212b7ac65bb02ecaf22f7a6278c9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports BOOL
+
+  // The source annotation is List[str].  This predicate states that domain
+  // over the semantics' heterogeneous ValSeq representation.
+  syntax Bool ::= allStrVS(ValSeq) [function, total]
+  rule allStrVS(.ValSeq)                         => true
+  rule allStrVS(vCons(str(_:IntSeq), R:ValSeq)) => allStrVS(R)
+  rule allStrVS(vCons(_:Val, _:ValSeq))         => false [owise]
+
+  // Mathematical filter summary in accumulator form.  Its equations cover
+  // every allStrVS input; no equation is asserted for out-of-domain heads.
+  syntax ValSeq ::= filterAcc(ValSeq, IntSeq, ValSeq) [function]
+  rule filterAcc(A:ValSeq, _:IntSeq, .ValSeq) => A
+  rule filterAcc(A:ValSeq, P:IntSeq,
+                 vCons(str(S:IntSeq), R:ValSeq))
+    => filterAcc(
+         valSeqConcat(A, vCons(str(S), .ValSeq)),
+         P,
+         R)
+    requires strContains(P, S)
+  rule filterAcc(A:ValSeq, P:IntSeq,
+                 vCons(str(S:IntSeq), R:ValSeq))
+    => filterAcc(A, P, R)
+    requires notBool strContains(P, S)
+endmodule

