diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9b576bda63d9212b7ac65bb02ecaf22f7a6278c9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports BOOL
+
+  // The source annotation is List[str].  This predicate states that domain
+  // over the semantics' heterogeneous ValSeq representation.
+  syntax Bool ::= allStrVS(ValSeq) [function, total]
+  rule allStrVS(.ValSeq)                         => true
+  rule allStrVS(vCons(str(_:IntSeq), R:ValSeq)) => allStrVS(R)
+  rule allStrVS(vCons(_:Val, _:ValSeq))         => false [owise]
+
+  // Mathematical filter summary in accumulator form.  Its equations cover
+  // every allStrVS input; no equation is asserted for out-of-domain heads.
+  syntax ValSeq ::= filterAcc(ValSeq, IntSeq, ValSeq) [function]
+  rule filterAcc(A:ValSeq, _:IntSeq, .ValSeq) => A
+  rule filterAcc(A:ValSeq, P:IntSeq,
+                 vCons(str(S:IntSeq), R:ValSeq))
+    => filterAcc(
+         valSeqConcat(A, vCons(str(S), .ValSeq)),
+         P,
+         R)
+    requires strContains(P, S)
+  rule filterAcc(A:ValSeq, P:IntSeq,
+                 vCons(str(S:IntSeq), R:ValSeq))
+    => filterAcc(A, P, R)
+    requires notBool strContains(P, S)
+endmodule

apply patch
patch: completed
/workspace/spec.k
