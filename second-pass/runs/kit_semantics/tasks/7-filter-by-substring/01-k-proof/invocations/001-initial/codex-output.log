+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_substring"),
+           list(VS:ValSeq),
+           str(P:IntSeq))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
