+    <env> L:Int </env>
+    <scopes>
+      OUTER:Map
+      L |-> scope(
+        "result" |-> ref(H:Int)
+        "substring" |-> str(P:IntSeq)
+        LOCAL:Map,
+        PAR:Parent)
+      =>
+      ?OUTER:Map
+      L |-> scope(
+        "result" |-> ref(H)
+        "substring" |-> str(P)
+        ?LOCAL:Map,
+        PAR)
+    </scopes>
+    <heap>
+      H |-> list(
+        ACC:ValSeq
+        =>
