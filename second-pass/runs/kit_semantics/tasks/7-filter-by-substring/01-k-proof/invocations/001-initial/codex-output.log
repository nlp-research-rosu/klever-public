index 0000000000000000000000000000000000000000..e8787ed792581701bdbd16d10269b15302f1ade2
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,83 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material mutation: the loop tests "not in" instead of "in", while the
+  // postcondition still requires the original behavior for ["a"], "a".
+  claim [changed-condition]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "filter_by_substring",
+            Params("strings", "substring"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("not in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_substring"),
+           list(
+             vCons(
+               str(iCons(97, .IntSeq)),
+               .ValSeq)),
+           str(iCons(97, .IntSeq)))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "filter_by_substring" |->
+          closureVal(
+            ("strings", "substring", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("not in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(
+          str(iCons(97, .IntSeq)),
+          .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..cdd1808e42888a9c61fff5bfc8a13a71f5e8d53c
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false for the satisfiable witness strings=[],
+  // substring="a": the claimed result contains one empty string.
+  claim [false-postcondition]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "filter_by_substring",
+            Params("strings", "substring"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_substring"),
+           list(.ValSeq),
+           str(iCons(97, .IntSeq)))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "filter_by_substring" |->
+          closureVal(
+            ("strings", "substring", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(str(.IntSeq), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e659ccd4943922ea0c499e1344da3586c9796972
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,118 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("string"),
+        If(
+          Compare(Name("substring"), CmpOp("in", Name("string"))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("string"))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      OUTER:Map
+      L |-> scope(
+        "result" |-> ref(H:Int)
+        "string" |-> OLD:Val
+        "strings" |-> list(ORIGINAL:ValSeq)
+        "substring" |-> str(P:IntSeq),
+        PAR:Parent)
+      =>
+      OUTER
+      L |-> scope(
+        "result" |-> ref(H)
+        "string" |-> ?LAST:Val
+        "strings" |-> list(ORIGINAL)
+        "substring" |-> str(P),
+        PAR)
+    </scopes>
+    <heap>
+      H |-> list(
+        ACC:ValSeq
+        =>
+        filterAcc(ACC, P, VS))
+      HEAP:Map
+    </heap>
+    requires allStrVS(VS)
+
+  claim [filter-by-substring]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "filter_by_substring",
+            Params("strings", "substring"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_substring"),
+           list(VS:ValSeq),
+           str(P:IntSeq))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "filter_by_substring" |->
+          closureVal(
+            ("strings", "substring", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(filterAcc(.ValSeq, P, VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrVS(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..44f3f493e151ded84d7a80fcd73880bba468d82c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,44 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports BOOL
+
+  // The source annotation is List[str].  This predicate states that domain
+  // over the semantics' heterogeneous ValSeq representation.
+  // A total projection makes string-ness solver-visible: V is a semantic
+  // string exactly when V ==K str(strCodes(V)).
+  syntax IntSeq ::= strCodes(Val) [function, total]
+  rule strCodes(str(S:IntSeq)) => S
+  rule strCodes(_:Val)         => .IntSeq [owise]
+
+  syntax Bool ::= allStrVS(ValSeq) [function, total]
+  rule allStrVS(.ValSeq) => true
+  rule allStrVS(vCons(V:Val, R:ValSeq))
+    => (V ==K str(strCodes(V))) andBool allStrVS(R)
+
+  // Derived specialization of MPY-STR's fixed applyCmp("in", str, str)
+  // equation.  The guard states exactly that V has the required constructor.
+  rule applyCmp("in", str(P:IntSeq), V:Val)
+    => strContains(P, strCodes(V))
+    requires V ==K str(strCodes(V))
+    [simplification]
+
+  // Mathematical filter summary in accumulator form.  Its equations cover
+  // every allStrVS input; no equation is asserted for out-of-domain heads.
+  syntax ValSeq ::= filterAcc(ValSeq, IntSeq, ValSeq) [function]
+  rule filterAcc(A:ValSeq, _:IntSeq, .ValSeq) => A
+  rule filterAcc(A:ValSeq, P:IntSeq, vCons(V:Val, R:ValSeq))
+    => filterAcc(
+         valSeqConcat(A, vCons(V, .ValSeq)),
+         P,
+         R)
+    requires V ==K str(strCodes(V))
+      andBool strContains(P, strCodes(V))
+    [simplification]
+  rule filterAcc(A:ValSeq, P:IntSeq, vCons(V:Val, R:ValSeq))
+    => filterAcc(A, P, R)
+    requires V ==K str(strCodes(V))
+      andBool notBool strContains(P, strCodes(V))
+    [simplification]
+endmodule

diff --git a/concrete-smoke.mpy b/concrete-smoke.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..6a8ef079ec2f100cfbf0aa4724cf635251cff669
--- /dev/null
+++ b/concrete-smoke.mpy
@@ -0,0 +1,21 @@
+Module(
+  ImportFrom("typing", "List")
+  FuncDef("filter_by_substring", Params("strings", "substring"),
+    Assign(Name("result"), ListExpr())
+    Assign(Name("string"), Str(""))
+    For(Name("string"), Name("strings"),
+      If(Compare(Name("substring"), CmpOp("in", Name("string"))),
+        Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+        ))
+    Return(Name("result")))
+  Assert(
+    Compare(
+      Call(Name("filter_by_substring"), ListExpr(), Str("a")),
+      CmpOp("==", ListExpr())))
+  Assert(
+    Compare(
+      Call(
+        Name("filter_by_substring"),
+        ListExpr(Str("abc"), Str("bacd"), Str("cde"), Str("array")),
+        Str("a")),
+      CmpOp("==", ListExpr(Str("abc"), Str("bacd"), Str("array"))))))
diff --git a/concrete-smoke.py b/concrete-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..85cc2077524f2cba9524e0810b215dfaf7a6a0ce
--- /dev/null
+++ b/concrete-smoke.py
@@ -0,0 +1,18 @@
+from typing import List
+
+
+def filter_by_substring(strings: List[str], substring: str) -> List[str]:
+    result = []
+    string = ""
+    for string in strings:
+        if substring in string:
+            result.append(string)
+    return result
+
+
+assert filter_by_substring([], "a") == []
+assert filter_by_substring(["abc", "bacd", "cde", "array"], "a") == [
+    "abc",
+    "bacd",
+    "array",
+]
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..bd8f09a2df483aa7355ea06546605c86e1cc4f9a
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,38 @@
+from itertools import product
+
+from solution import filter_by_substring
+
+
+def oracle(strings, substring):
+    return list(filter(lambda item: substring in item, strings))
+
+
+alphabet = "ab"
+string_values = [""]
+for length in range(1, 3):
+    string_values.extend(
+        "".join(chars) for chars in product(alphabet, repeat=length)
+    )
+substrings = string_values + ["c"]
+
+cases = 0
+mismatches = 0
+for list_length in range(4):
+    for items in product(string_values, repeat=list_length):
+        strings = list(items)
+        for substring in substrings:
+            cases += 1
+            actual = filter_by_substring(strings, substring)
+            expected = oracle(strings, substring)
+            if actual != expected:
+                mismatches += 1
+                print(
+                    "mismatch:",
+                    repr(strings),
+                    repr(substring),
+                    repr(actual),
+                    repr(expected),
+                )
+
+print(f"cases={cases} mismatches={mismatches}")
+raise SystemExit(1 if mismatches else 0)
