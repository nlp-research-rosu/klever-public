+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "filter_by_substring",
+            Params("strings", "substring"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("not in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")))))
+      ~> Call(
+           Name("filter_by_substring"),
+           list(
+             vCons(
+               str(iCons(97, .IntSeq)),
+               .ValSeq)),
+           str(iCons(97, .IntSeq)))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "filter_by_substring" |->
+          closureVal(
+            ("strings", "substring", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
