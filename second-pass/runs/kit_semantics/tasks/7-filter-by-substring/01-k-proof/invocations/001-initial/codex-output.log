+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(filterAcc(.ValSeq, P, VS))
