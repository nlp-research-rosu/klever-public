+    <scopes>
+      OUTER:Map
+      L |-> scope(
+        "result" |-> ref(H:Int)
+        "string" |-> OLD:Val
+        "strings" |-> list(ORIGINAL:ValSeq)
+        "substring" |-> str(P:IntSeq),
+        PAR:Parent)
+      =>
+      OUTER
+      L |-> scope(
+        "result" |-> ref(H)
+        "string" |-> ?LAST:Val
+        "strings" |-> list(ORIGINAL)
+        "substring" |-> str(P),
+        PAR)
+    </scopes>
+    <heap>
+      H |-> list(
+        ACC:ValSeq
+        =>
+        filterAcc(ACC, P, VS))
+      HEAP:Map
+    </heap>
+    requires allStrVS(VS)
+
+  claim [filter-by-substring]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "filter_by_substring",
+            Params("strings", "substring"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("string"), Str(""))
+            For(
+              Name("string"),
+              Name("strings"),
+              If(
