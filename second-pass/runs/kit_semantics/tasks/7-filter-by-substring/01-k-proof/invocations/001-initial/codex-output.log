+              Name("string"),
+              Name("strings"),
+              If(
+                Compare(
+                  Name("substring"),
+                  CmpOp("in", Name("string"))),
+                Expr(
+                  Call(
+                    Attribute(Name("result"), "append"),
+                    Name("string"))),
+                .Stmts))
+            Return(Name("result")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(filterAcc(.ValSeq, P, VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrVS(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6c500bb70b5f25fd30fdfaaf5c23834b00a4d14
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports BOOL
+
+  // The source annotation is List[str].  This predicate states that domain
+  // over the semantics' heterogeneous ValSeq representation.
+  syntax Bool ::= isStrVal(Val) [function, total]
+  rule isStrVal(str(_:IntSeq)) => true
+  rule isStrVal(_:Val)         => false [owise]
+
+  syntax Bool ::= allStrVS(ValSeq) [function, total]
+  rule allStrVS(.ValSeq)                => true
+  rule allStrVS(vCons(V:Val, R:ValSeq)) => isStrVal(V) andBool allStrVS(R)
+
+  // Mathematical filter summary in accumulator form.  Its equations cover
+  // every allStrVS input; no equation is asserted for out-of-domain heads.
+  syntax ValSeq ::= filterAcc(ValSeq, IntSeq, ValSeq) [function]
+  rule filterAcc(A:ValSeq, _:IntSeq, .ValSeq) => A
+  rule filterAcc(A:ValSeq, P:IntSeq,
+                 vCons(str(S:IntSeq), R:ValSeq))
+    => filterAcc(
+         valSeqConcat(A, vCons(str(S), .ValSeq)),
+         P,
+         R)
+    requires strContains(P, S)
+  rule filterAcc(A:ValSeq, P:IntSeq,
+                 vCons(str(S:IntSeq), R:ValSeq))
+    => filterAcc(A, P, R)
+    requires notBool strContains(P, S)
+endmodule

