+      =>
+      iCons(97, .IntSeq)
+    </k>
+
+  claim [contains-yes]:
+    <k>
+      applyCmp(
+        "in",
+        str(iCons(97, .IntSeq)),
+        str(iCons(97, .IntSeq)))
+      =>
+      true
+    </k>
+
+  claim [contains-no]:
+    <k>
+      applyCmp(
+        "in",
+        str(iCons(97, .IntSeq)),
+        str(iCons(98, .IntSeq)))
+      =>
+      false
+    </k>
+endmodule
