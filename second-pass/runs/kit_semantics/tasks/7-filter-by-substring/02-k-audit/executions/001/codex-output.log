+        ([], "a"),
+        (["abc", "bacd", "cde", "array"], "a"),
+        ([], ""),
+        ([""], ""),
+        (["", "a", "aa", "ba", "ab"], ""),
+        (["", "a", "aa", "ba", "ab"], "a"),
+        (["abc"], "abc"),
+        (["abc"], "abcd"),
+        (["abc"], "ab"),
