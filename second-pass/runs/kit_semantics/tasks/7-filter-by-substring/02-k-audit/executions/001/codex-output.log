/audit-output/evidence/run_logged.sh /audit-output/evidence/19-vacuity-proof.log bash -c '"'export PATH=\""'$HOME/.nix-profile/bin:$PATH"; kprove spec-reviewer-vacuity.k --definition reviewer-verification-kompiled --spec-module SPEC-REVIEWER-VACUITY'"'
proof_status="'$?
