diff --git a/evidence/spec-reviewer-vacuity.k b/evidence/spec-reviewer-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..48e6945cf3d51e3573f45d374588ac0d72b9c866
--- /dev/null
+++ b/evidence/spec-reviewer-vacuity.k
@@ -0,0 +1,80 @@
+requires "verification.k"
+
+module SPEC-REVIEWER-VACUITY
