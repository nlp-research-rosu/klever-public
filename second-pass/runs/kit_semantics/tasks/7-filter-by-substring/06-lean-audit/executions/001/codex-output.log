diff --git a//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean b//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..c6e7d82f7eb7f5c5a2aae624e785100260cf90d2
--- /dev/null
+++ b//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean
@@ -0,0 +1,77 @@
+import Proof
+
+namespace BridgeAudit
+
+def seq : List Int → SortIntSeq
+  | [] => .«.IntSeq_MPY-CORE_IntSeq»
+  | x :: xs => .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (seq xs)
+
+def sval (xs : List Int) : SortVal :=
+  .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» (seq xs))
+
+-- Boundary and adversarial substring examples from the frozen strContains rules.
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval []) (sval []) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval []) (sval [98, 97]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97]) (sval [98, 97]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97, 98]) (sval [97]) =
+      false := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in"
+        (sval [97, 98]) (sval [0, 97, 98, 2]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97, 99]) (sval [97, 98]) =
+      false := by
+  rfl
+
+-- Exact behavior of the two frozen strCodes definition rules.
+example :
+    Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (sval [65, 66]) = seq [65, 66] := by
+  rfl
+
+example :
+    Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (SortVal.inj_SortInt 7) =
+      seq [] := by
+  rfl
+
+-- A deliberately dishonest operational bridge still satisfies the fixed
+-- equation.  This confirms why independent bridge review is essential.
+def badApplyCmp (_ : SortString) (_ _ : SortVal) : SortBool := false
+
+def badStrCodes (_ : SortVal) : SortIntSeq := seq []
+
+theorem fixedTargetAcceptsCounterfactual :
+    Klean7FilterBySubstring.Lemmas.targetStatement badApplyCmp badStrCodes := by
+  intro V P h
+  rfl
+
+-- The counterfactual is observably wrong on a positive substring case.
+example : badApplyCmp "in" (sval [97]) (sval [98, 97]) = false := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97]) (sval [98, 97]) ≠
+      badApplyCmp "in" (sval [97]) (sval [98, 97]) := by
+  decide
+
+example : badStrCodes (sval [65]) ≠ Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (sval [65]) := by
+  simp [badStrCodes, sval, seq, Proof.«strCodes(_)_VERIFICATION_IntSeq_Val»]
+
+end BridgeAudit
