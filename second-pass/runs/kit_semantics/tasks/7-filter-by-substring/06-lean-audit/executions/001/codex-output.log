  LD_PRELOAD=/tmp/audit-work/proc-self-readlink.so LAKE_HOME=/opt/elan/toolchains/leanprover--lean4---v4.22.0 LEAN_SYSROOT=/opt/elan/toolchains/leanprover--lean4---v4.22.0 /opt/elan/bin/lake env lean BridgeAudit.lean
