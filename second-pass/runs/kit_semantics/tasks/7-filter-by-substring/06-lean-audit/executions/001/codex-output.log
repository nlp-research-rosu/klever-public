diff --git a//tmp/audit-work/lean_shim.c b//tmp/audit-work/lean_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..3493e741054480678437443047d21bb0f5223b0a
--- /dev/null
+++ b//tmp/audit-work/lean_shim.c
@@ -0,0 +1,104 @@
+#include <lean/lean.h>
+#include <stdint.h>
+#include <stdio.h>
+
+extern lean_object *initialize_Lean(uint8_t builtin, lean_object *world);
+extern lean_object *lean_init_search_path(uint8_t builtin);
+extern void lean_initialize(void);
+extern char **lean_setup_args(int argc, char **argv);
+extern lean_object *l___private_Lean_Shell_0__Lean_shellMain___boxed(
+    lean_object *args,
+    lean_object *use_stdin,
+    lean_object *only_deps,
+    lean_object *only_src_deps,
+    lean_object *deps_json,
+    lean_object *options,
+    lean_object *trust_level,
+    lean_object *root_dir,
+    lean_object *setup_file,
+    lean_object *olean_file,
+    lean_object *ilean_file,
+    lean_object *c_file,
+    lean_object *bc_file,
+    lean_object *json_output,
+    lean_object *error_on_kinds,
+    lean_object *print_stats,
+    lean_object *run,
+    lean_object *world);
+extern lean_object *l_Lean_Options_empty;
+
+static lean_object *list_from_args(int argc, char **argv) {
+    lean_object *result = lean_box(0);
+    for (int index = argc - 1; index >= 1; --index) {
+        lean_object *cons = lean_alloc_ctor(1, 2, 0);
+        lean_ctor_set(cons, 0, lean_mk_string(argv[index]));
+        lean_ctor_set(cons, 1, result);
+        result = cons;
+    }
+    return result;
+}
+
+static int consume_init_result(const char *label, lean_object *result) {
+    if (lean_io_result_is_error(result)) {
+        fprintf(stderr, "%s failed:\n", label);
+        lean_io_result_show_error(result);
+        lean_dec(result);
+        return 0;
+    }
+    lean_dec(result);
+    return 1;
+}
+
+int main(int argc, char **argv) {
+    argv = lean_setup_args(argc, argv);
+    lean_initialize();
+    lean_set_panic_messages(0);
+
+    if (!consume_init_result(
+            "lean_init_search_path", lean_init_search_path(0))) {
+        return 1;
+    }
+    if (!consume_init_result(
+            "initialize_Lean", initialize_Lean(1, lean_io_mk_world()))) {
+        return 1;
+    }
+
+    lean_set_panic_messages(1);
+    lean_io_mark_end_initialization();
+    lean_init_task_manager();
+
+    lean_object *args = list_from_args(argc, argv);
+    lean_object *options = l_Lean_Options_empty;
+    lean_inc(options);
+    lean_object *result =
+        l___private_Lean_Shell_0__Lean_shellMain___boxed(
+            args,
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            options,
+            lean_box_uint32(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_mk_empty_array(),
+            lean_box(0),
+            lean_box(0),
+            lean_io_mk_world());
+
+    lean_finalize_task_manager();
+    if (lean_io_result_is_error(result)) {
+        lean_io_result_show_error(result);
+        lean_dec(result);
+        return 1;
+    }
+    lean_object *value = lean_io_result_get_value(result);
+    int exit_code = (int)lean_unbox(value);
+    lean_dec(result);
+    return exit_code;
+}
