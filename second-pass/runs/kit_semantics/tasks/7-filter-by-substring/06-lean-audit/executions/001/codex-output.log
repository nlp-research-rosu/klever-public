+            lean_box_uint32(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_mk_empty_array(),
+            lean_box(0),
+            lean_box(0),
+            lean_io_mk_world());
+
+    lean_finalize_task_manager();
+    if (lean_io_result_is_error(result)) {
