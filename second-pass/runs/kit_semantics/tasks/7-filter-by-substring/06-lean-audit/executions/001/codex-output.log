+            args,
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            options,
+            lean_box_uint32(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_mk_empty_array(),
+            lean_box(0),
+            lean_box(0),
+            lean_io_mk_world());
+
+    lean_finalize_task_manager();
+    if (lean_io_result_is_error(result)) {
+        lean_io_result_show_error(result);
+        lean_dec(result);
+        return 1;
+    }
+    lean_object *value = lean_io_result_get_value(result);
+    int exit_code = (int)lean_unbox(value);
+    lean_dec(result);
+    return exit_code;
+}
