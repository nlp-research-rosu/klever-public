diff --git a//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean b//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..c6e7d82f7eb7f5c5a2aae624e785100260cf90d2
--- /dev/null
+++ b//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean
@@ -0,0 +1,77 @@
+import Proof
+
+namespace BridgeAudit
+
+def seq : List Int → SortIntSeq
+  | [] => .«.IntSeq_MPY-CORE_IntSeq»
+  | x :: xs => .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (seq xs)
+
+def sval (xs : List Int) : SortVal :=
+  .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» (seq xs))
+
+-- Boundary and adversarial substring examples from the frozen strContains rules.
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval []) (sval []) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval []) (sval [98, 97]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97]) (sval [98, 97]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97, 98]) (sval [97]) =
+      false := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in"
+        (sval [97, 98]) (sval [0, 97, 98, 2]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97, 99]) (sval [97, 98]) =
+      false := by
+  rfl
+
+-- Exact behavior of the two frozen strCodes definition rules.
+example :
+    Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (sval [65, 66]) = seq [65, 66] := by
+  rfl
+
+example :
+    Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (SortVal.inj_SortInt 7) =
+      seq [] := by
+  rfl
+
+-- A deliberately dishonest operational bridge still satisfies the fixed
+-- equation.  This confirms why independent bridge review is essential.
+def badApplyCmp (_ : SortString) (_ _ : SortVal) : SortBool := false
+
+def badStrCodes (_ : SortVal) : SortIntSeq := seq []
+
+theorem fixedTargetAcceptsCounterfactual :
+    Klean7FilterBySubstring.Lemmas.targetStatement badApplyCmp badStrCodes := by
+  intro V P h
+  rfl
+
+-- The counterfactual is observably wrong on a positive substring case.
+example : badApplyCmp "in" (sval [97]) (sval [98, 97]) = false := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97]) (sval [98, 97]) ≠
+      badApplyCmp "in" (sval [97]) (sval [98, 97]) := by
+  decide
+
+example : badStrCodes (sval [65]) ≠ Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (sval [65]) := by
+  simp [badStrCodes, sval, seq, Proof.«strCodes(_)_VERIFICATION_IntSeq_Val»]
+
+end BridgeAudit
diff --git a/evidence/check_integrity.py b/evidence/check_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..3413517670a25fc6b276f24b7dd4b881596d0830
--- /dev/null
+++ b/evidence/check_integrity.py
@@ -0,0 +1,308 @@
+#!/usr/bin/env python3
+"""Independent, read-only integrity checks for the mounted audit inputs."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract
+from tools.k_rule_inventory import inventory_verification
+
+
+def load(path: str) -> dict:
+    value = json.loads(Path(path).read_text())
+    assert isinstance(value, dict), path
+    return value
+
+
+def file_sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def regular_files(root: Path) -> dict[str, str]:
+    result: dict[str, str] = {}
+    for path in sorted(root.rglob("*")):
+        if path.is_symlink():
+            raise AssertionError(f"symlink in {root}: {path}")
+        if path.is_file():
+            result[path.relative_to(root).as_posix()] = file_sha(path)
+    return result
+
+
+def check(label: str, actual, expected) -> None:
+    ok = actual == expected
+    print(f"{label}: {'PASS' if ok else 'FAIL'}")
+    print(f"  actual:   {actual}")
+    print(f"  expected: {expected}")
+    if not ok:
+        raise AssertionError(label)
+
+
+audit = load("/audit-input.json")["resolution"]
+discovery = load("/reference/lemma-discovery.json")
+input_manifest = load("/reference/klean-generation/input-manifest.json")
+generator = load("/reference/klean-generation/generator-manifest.json")
+obligation_map = load(
+    "/reference/klean-generation/generated/obligation-map.json"
+)
+export_result = load("/reference/klean-generation/export-result.json")
+source_manifest = load("/reference/generation-tools/source-manifest.json")
+stage4_preflight = load("/reference/klean-generation/preflight.json")
+
+inventory = inventory_verification(Path("/reference/k-proof"))
+rules = inventory["rules"]
+manifest_rules = discovery["rules"]
+
+print("=== inventory reconstruction and Stage 3 bijection ===")
+check("inventory schema", inventory["schema_version"], 2)
+check("verification module closure", inventory["verification_modules"], ["VERIFICATION"])
+check(
+    "verification source sha256",
+    inventory["verification_sha256"],
+    input_manifest["verification_sha256"],
+)
+check(
+    "inventory sha256",
+    inventory["inventory_sha256"],
+    discovery["inventory_sha256"],
+)
+inventory_ids = [rule["source_rule_id"] for rule in rules]
+manifest_ids = [rule["source_rule_id"] for rule in manifest_rules]
+check("manifest identity order", manifest_ids, inventory_ids)
+check("manifest identities unique", len(set(manifest_ids)), len(manifest_ids))
+check("inventory identities unique", len(set(inventory_ids)), len(inventory_ids))
+
+verification_lines = Path("/reference/k-proof/verification.k").read_text().splitlines()
+for index, rule in enumerate(rules):
+    normalized = " ".join(rule["text"].split())
+    digest = hashlib.sha256(normalized.encode()).hexdigest()
+    span = "\n".join(
+        verification_lines[rule["start_line"] - 1 : rule["end_line"]]
+    )
+    check(f"rule[{index}] span", span, rule["text"])
+    check(f"rule[{index}] normalized sha256", digest, rule["normalized_sha256"])
+    check(f"rule[{index}] source_rule_id", "rule-" + digest, rule["source_rule_id"])
+
+# These expected classes are an independent classification from the frozen K
+# source, not copied from the Stage 3 manifest.
+independent_classes = {
+    "rule-d4676ce65d5aa71d896650582ea7fd95efd3f817b5b09d834d0ee937362738f4": "DEFINITION",
+    "rule-847ade70763e1124464b657827fa409b360b4ee6da4959b08c37af4bfcc6ea05": "DEFINITION",
+    "rule-8f5f9af1fe8efa4c83c0197e4a31cd8150af4cd53c7d3fc694a6fa2796bc0d5a": "DEFINITION",
+    "rule-865c4b24763637b23fa93793d11806aae069dc118aea556597904b6aae56a5ad": "DEFINITION",
