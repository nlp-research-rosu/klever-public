+    lean_object *error_on_kinds,
+    lean_object *print_stats,
+    lean_object *run,
+    lean_object *world);
+extern lean_object *l_Lean_Options_empty;
+
+static lean_object *list_from_args(int argc, char **argv) {
+    lean_object *result = lean_box(0);
+    for (int index = argc - 1; index >= 1; --index) {
+        lean_object *cons = lean_alloc_ctor(1, 2, 0);
+        lean_ctor_set(cons, 0, lean_mk_string(argv[index]));
+        lean_ctor_set(cons, 1, result);
+        result = cons;
+    }
+    return result;
+}
+
+static int consume_init_result(const char *label, lean_object *result) {
+    if (lean_io_result_is_error(result)) {
+        fprintf(stderr, "%s failed:\n", label);
+        lean_io_result_show_error(result);
+        lean_dec(result);
+        return 0;
+    }
+    lean_dec(result);
+    return 1;
+}
+
+int main(int argc, char **argv) {
+    argv = lean_setup_args(argc, argv);
+    lean_initialize();
+    lean_set_panic_messages(0);
+
+    if (!consume_init_result(
+            "initialize_Lean", initialize_Lean(1, lean_io_mk_world()))) {
+        return 1;
+    }
+
+    lean_set_panic_messages(1);
+    lean_io_mark_end_initialization();
+    lean_init_task_manager();
+
+    lean_object *args = list_from_args(argc, argv);
+    lean_object *options = l_Lean_Options_empty;
+    lean_inc(options);
+    lean_object *result =
+        l___private_Lean_Shell_0__Lean_shellMain___boxed(
+            args,
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            options,
+            lean_box_uint32(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_box(0),
+            lean_mk_empty_array(),
+            lean_box(0),
+            lean_box(0),
+            lean_io_mk_world());
+
+    lean_finalize_task_manager();
+    if (lean_io_result_is_error(result)) {
+        lean_io_result_show_error(result);
+        lean_dec(result);
+        return 1;
+    }
+    lean_object *value = lean_io_result_get_value(result);
+    int exit_code = (int)lean_unbox(value);
+    lean_dec(result);
+    return exit_code;
+}
diff --git a//tmp/audit-work/proc_self_readlink.c b//tmp/audit-work/proc_self_readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..4fc2d87e350f0bbf2df28e8ad4a3220a05fb9793
--- /dev/null
+++ b//tmp/audit-work/proc_self_readlink.c
@@ -0,0 +1,35 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox exposes a host-PID /proc mount while getpid() returns a
+ * nested-namespace PID. Lean 4.22 resolves its executable through
+ * /proc/<getpid()>/exe, which therefore does not exist. Redirect only that
+ * executable lookup to the namespace-stable /proc/self/exe path.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t length = strlen(path);
+    int is_process_exe =
+        length > sizeof(prefix) - 1 + sizeof(suffix) - 1 &&
+        strncmp(path, prefix, sizeof(prefix) - 1) == 0 &&
+        strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0;
+    if (is_process_exe) {
+        const char *cursor = path + sizeof(prefix) - 1;
+        const char *end = path + length - (sizeof(suffix) - 1);
+        while (cursor < end && isdigit((unsigned char)*cursor)) {
+            ++cursor;
+        }
+        is_process_exe = cursor == end;
+    }
+    return syscall(
+        SYS_readlink,
+        is_process_exe ? "/proc/self/exe" : path,
+        buffer,
+        size);
+}
