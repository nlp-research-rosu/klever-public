+    )
+    check(f"rule[{index}] span", span, rule["text"])
+    check(f"rule[{index}] normalized sha256", digest, rule["normalized_sha256"])
+    check(f"rule[{index}] source_rule_id", "rule-" + digest, rule["source_rule_id"])
+
