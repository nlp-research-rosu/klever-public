diff --git a//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean b//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..c6e7d82f7eb7f5c5a2aae624e785100260cf90d2
--- /dev/null
+++ b//tmp/audit-work/stage5-fresh-001/BridgeAudit.lean
@@ -0,0 +1,77 @@
+import Proof
+
+namespace BridgeAudit
+
+def seq : List Int → SortIntSeq
+  | [] => .«.IntSeq_MPY-CORE_IntSeq»
+  | x :: xs => .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (seq xs)
+
+def sval (xs : List Int) : SortVal :=
+  .inj_SortStr (.«str(_)_MPY-CORE_Str_IntSeq» (seq xs))
+
+-- Boundary and adversarial substring examples from the frozen strContains rules.
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval []) (sval []) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval []) (sval [98, 97]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97]) (sval [98, 97]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97, 98]) (sval [97]) =
+      false := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in"
+        (sval [97, 98]) (sval [0, 97, 98, 2]) =
+      true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97, 99]) (sval [97, 98]) =
+      false := by
+  rfl
+
+-- Exact behavior of the two frozen strCodes definition rules.
+example :
+    Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (sval [65, 66]) = seq [65, 66] := by
+  rfl
+
+example :
+    Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (SortVal.inj_SortInt 7) =
+      seq [] := by
+  rfl
+
+-- A deliberately dishonest operational bridge still satisfies the fixed
+-- equation.  This confirms why independent bridge review is essential.
+def badApplyCmp (_ : SortString) (_ _ : SortVal) : SortBool := false
+
+def badStrCodes (_ : SortVal) : SortIntSeq := seq []
+
+theorem fixedTargetAcceptsCounterfactual :
+    Klean7FilterBySubstring.Lemmas.targetStatement badApplyCmp badStrCodes := by
+  intro V P h
+  rfl
+
+-- The counterfactual is observably wrong on a positive substring case.
+example : badApplyCmp "in" (sval [97]) (sval [98, 97]) = false := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in" (sval [97]) (sval [98, 97]) ≠
+      badApplyCmp "in" (sval [97]) (sval [98, 97]) := by
+  decide
+
+example : badStrCodes (sval [65]) ≠ Proof.«strCodes(_)_VERIFICATION_IntSeq_Val» (sval [65]) := by
+  simp [badStrCodes, sval, seq, Proof.«strCodes(_)_VERIFICATION_IntSeq_Val»]
+
+end BridgeAudit
diff --git a/REVIEW.md b/REVIEW.md
new file mode 100644
index 0000000000000000000000000000000000000000..267c3bebad127287986a42c34aed705d53a3b218
--- /dev/null
+++ b/REVIEW.md
@@ -0,0 +1,268 @@
+# Independent audit: `7-filter-by-substring`
+
+## Result
+
+The Stage 3 classification, deterministic Stage 4 generation, and Stage 5
+Lean proof are legitimate. I reconstructed and reclassified the frozen rule
+inventory without relying on the prior classification or review conclusions.
+The one genuine domain lemma is present exactly once in the generated
+obligation, the generated target is unchanged, and the candidate supplies
+operationally honest definitions for both target parameters.
+
+Audit mode was `CLASSIFICATION_AND_PROOF`; the condition was `kit-semantics`
+and the semantics mode was `SUPPLIED_SEMANTICS`.
+
+## Producer and input authentication
+
+I hashed the mounted generation-time sources before judging Stage 4:
+
+| Source | Actual SHA-256 | Recorded SHA-256 | Result |
+|---|---|---|---|
+| `klean_export.py` | `bbd11ce0fe6ac12ea89d4bdc70c260044bc9f87c987ff310684b637ea6464a07` | same in `source-manifest.json` and `generator-manifest.json` | match |
+| `klean.py` | `42a38e6d65b74af3536acc49947b7cfbac809406bdfe5549841e3132af5a5c4d` | same in `source-manifest.json` and `generator-manifest.json` | match |
+
+The generator image ID is
+`sha256:f884238cea5ab1ed0da0a75d0c9a29ac4abe988616c3f493ba60e74ca3290cf7`.
+It agrees between the source manifest and generator manifest, and the same
+digest is the basename of the generation-producer-source path recorded by
+`/audit-input.json`. The mounted producer-source tree hash is
+`388cac39f4f89b5a912d2628ef5c7963e791f5ed775cf1e9606fe64dcfd5f11e`,
+also exactly as recorded by the launcher.
+
+I independently recomputed the launcher-bound tree and file hashes. These
+include the K workspace
+`4247d334d98f7c24b67dd9ce59ba8c0be544897429b8b4e5e3a84e800e3bfcb6`,
+the Stage 1 export
+`ab03184a1dc4cf9d039f2d1577fe299a98e7857f923621d370f5eb14e4c4c0dc`,
+the Stage 2 audit
+`4dc3da0f27fcbc9c8a13385605b20046775c1400ba42efc39b237b1a9bf7cb72`,
+the discovery manifest
+`ff7d79db18ea952e08f0933f163c8000e246bdfcc6aeb93c986e752582840959`,
+the Stage 4 generation
+`5c1891356052f0af3e2435c84c71022f033f594ec5e5da31333ef65b67d6a4f0`,
+the generated tree
+`3f21302f11b2328e6d3f9a1abb941e89512a4fdb7b523e96cec2334e5e7f0381`,
+and the candidate tree
+`855081126d8b3024cf2869dee257f2106fe442064bbfbd76123bda4b218fc956`.
+Every individual frozen Stage 1 file path and hash also matched the launcher
+record.
+
