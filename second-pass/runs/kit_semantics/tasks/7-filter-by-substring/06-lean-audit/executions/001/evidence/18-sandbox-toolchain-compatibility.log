     1	#define _GNU_SOURCE
     2	#include <ctype.h>
     3	#include <stddef.h>
     4	#include <string.h>
     5	#include <sys/syscall.h>
     6	#include <unistd.h>
     7	
     8	/*
     9	 * The audit sandbox exposes a host-PID /proc mount while getpid() returns a
    10	 * nested-namespace PID. Lean 4.22 resolves its executable through
    11	 * /proc/<getpid()>/exe, which therefore does not exist. Redirect only that
    12	 * executable lookup to the namespace-stable /proc/self/exe path.
    13	 */
    14	ssize_t readlink(const char *path, char *buffer, size_t size) {
    15	    const char prefix[] = "/proc/";
    16	    const char suffix[] = "/exe";
    17	    size_t length = strlen(path);
    18	    int is_process_exe =
    19	        length > sizeof(prefix) - 1 + sizeof(suffix) - 1 &&
    20	        strncmp(path, prefix, sizeof(prefix) - 1) == 0 &&
    21	        strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0;
    22	    if (is_process_exe) {
    23	        const char *cursor = path + sizeof(prefix) - 1;
    24	        const char *end = path + length - (sizeof(suffix) - 1);
    25	        while (cursor < end && isdigit((unsigned char)*cursor)) {
    26	            ++cursor;
    27	        }
    28	        is_process_exe = cursor == end;
    29	    }
    30	    return syscall(
    31	        SYS_readlink,
    32	        is_process_exe ? "/proc/self/exe" : path,
    33	        buffer,
    34	        size);
    35	}
