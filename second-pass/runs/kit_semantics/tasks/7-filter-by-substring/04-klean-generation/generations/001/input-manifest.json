      "normalized_sha256": "d4676ce65d5aa71d896650582ea7fd95efd3f817b5b09d834d0ee937362738f4",
      "rationale": "Defining equation for the proof-local strCodes projection on a semantic string constructor.",
      "source_rule_id": "rule-d4676ce65d5aa71d896650582ea7fd95efd3f817b5b09d834d0ee937362738f4",
      "start_line": 12,
      "text": "  rule strCodes(str(S:IntSeq)) => S"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "847ade70763e1124464b657827fa409b360b4ee6da4959b08c37af4bfcc6ea05",
      "rationale": "Owise defining equation that completes the proof-local total strCodes projection on non-string Val constructors.",
      "source_rule_id": "rule-847ade70763e1124464b657827fa409b360b4ee6da4959b08c37af4bfcc6ea05",
      "start_line": 13,
      "text": "  rule strCodes(_:Val)         => .IntSeq [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "8f5f9af1fe8efa4c83c0197e4a31cd8150af4cd53c7d3fc694a6fa2796bc0d5a",
      "rationale": "Base equation defining the allStrVS proof-domain predicate on the empty value sequence.",
      "source_rule_id": "rule-8f5f9af1fe8efa4c83c0197e4a31cd8150af4cd53c7d3fc694a6fa2796bc0d5a",
      "start_line": 16,
      "text": "  rule allStrVS(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "865c4b24763637b23fa93793d11806aae069dc118aea556597904b6aae56a5ad",
      "rationale": "Structural recurrence defining allStrVS on a value-sequence head and its strictly smaller tail.",
      "source_rule_id": "rule-865c4b24763637b23fa93793d11806aae069dc118aea556597904b6aae56a5ad",
      "start_line": 17,
      "text": "  rule allStrVS(vCons(V:Val, R:ValSeq))\n    => (V ==K str(strCodes(V))) andBool allStrVS(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "c7e3f2f45bbfd43ef6b8731a4e0c5ffee7b1efe6805f88d96b74e539a66d2e71",
      "rationale": "Base equation defining the filterAcc mathematical summary when no input elements remain.",
      "source_rule_id": "rule-c7e3f2f45bbfd43ef6b8731a4e0c5ffee7b1efe6805f88d96b74e539a66d2e71",
      "start_line": 31,
      "text": "  rule filterAcc(A:ValSeq, _:IntSeq, .ValSeq) => A"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "e766fccb4416695974e50ef3cf530b303db323532b6a6987b87d7a5a123c4193",
      "rationale": "Contained-element recurrence defining filterAcc by appending the string head and recursing on the tail; its simplification attribute does not change its definitional role.",
      "source_rule_id": "rule-e766fccb4416695974e50ef3cf530b303db323532b6a6987b87d7a5a123c4193",
      "start_line": 32,
      "text": "  rule filterAcc(A:ValSeq, P:IntSeq, vCons(V:Val, R:ValSeq))\n    => filterAcc(\n         valSeqConcat(A, vCons(V, .ValSeq)),\n         P,\n         R)\n    requires V ==K str(strCodes(V))\n      andBool strContains(P, strCodes(V))\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "ad345f4ab95b42abade2e1e581a480d6a8f282ec27387d0fc23704a7aa59979b",
      "rationale": "Excluded-element recurrence defining filterAcc by retaining the accumulator and recursing on the tail; its simplification attribute does not change its definitional role.",
      "source_rule_id": "rule-ad345f4ab95b42abade2e1e581a480d6a8f282ec27387d0fc23704a7aa59979b",
      "start_line": 40,
      "text": "  rule filterAcc(A:ValSeq, P:IntSeq, vCons(V:Val, R:ValSeq))\n    => filterAcc(A, P, R)\n    requires V ==K str(strCodes(V))\n      andBool notBool strContains(P, strCodes(V))\n    [simplification]"
    }
  ],
