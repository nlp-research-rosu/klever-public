Module(
  FuncDef("sort_third", Params("l"),
    Assign(
      Name("thirds"),
      Call(
        Name("sorted"),
        Subscript(Name("l"), Slice(NoBound, NoBound, Int(3)))))
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    While(Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("l")))),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            Subscript(Name("thirds"), BinOp("//", Name("i"), Int(3))))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            Subscript(Name("l"), Name("i")))))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("sort_third"),
        ListExpr(Int(5), Int(6), Int(3), Int(4), Int(8), Int(9), Int(2))),
      CmpOp(
        "==",
        ListExpr(Int(2), Int(6), Int(3), Int(4), Int(8), Int(9), Int(5))))))
