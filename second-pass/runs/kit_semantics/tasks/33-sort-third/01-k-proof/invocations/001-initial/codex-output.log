new file mode 100644
index 0000000000000000000000000000000000000000..35fc4aaeec9f2c5829ae5d38008ba911e5934a69
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def sort_third(l: list):
+    thirds = sorted(l[::3])
+    result = []
+    i = 0
+    while i < len(l):
+        if i % 3 == 0:
+            result.append(thirds[i // 3])
+        else:
+            result.append(l[i])
+        i += 1
+    return result
