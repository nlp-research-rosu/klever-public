+            .Stmts)
+          .Stmts))
+      ~> Call(
+           Name("sort_third"),
+           (list(VS), .Exprs))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "sort_third" |->
+           closureVal(
+             ("l", .ParamNames),
+             Assign(
+               Name("thirds"),
+               Call(
+                 Name("sorted"),
+                 (Subscript(
+                    Name("l"),
+                    Slice(NoBound, NoBound, Int(3))),
+                  .Exprs)))
