+               (Subscript(
+                  Name("thirds"),
+                  BinOp("//", Name("i"), Int(3))),
+                .Exprs)))
+           .Stmts),
+          (Expr(
+             Call(
+               Attribute(Name("result"), "append"),
+               (Subscript(Name("l"), Name("i")), .Exprs)))
+           .Stmts))
+        AugAssign(Name("i"), "+", Int(1))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "i" |-> (I => N)
+        "l" |-> list(VS)
+        "result" |-> ref(OUT)
+        "thirds" |-> ref(THIRD),
