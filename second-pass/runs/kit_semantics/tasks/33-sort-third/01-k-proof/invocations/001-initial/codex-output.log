+                      Attribute(Name("result"), "append"),
+                      (Subscript(
+                         Name("thirds"),
+                         BinOp("//", Name("i"), Int(3))),
+                       .Exprs)))
+                  .Stmts),
+                 (Expr(
+                    Call(
+                      Attribute(Name("result"), "append"),
+                      (Subscript(Name("l"), Name("i")), .Exprs)))
+                  .Stmts))
+               AugAssign(Name("i"), "+", Int(1))
+               .Stmts)
+             Return(Name("result"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      (0 |-> list(buildVS(VS, 0, vsLen(VS), 3))
+       1 |-> list(sortVS(buildVS(VS, 0, vsLen(VS), 3)))
+       2 |-> list(sortThirdResult(VS)))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
