+  SortVal.inj_SortIterable (SortIterable.inj_SortStr (checkStrTerm codes))
+
+private def checkInt (value : Int) : SortVal := SortVal.inj_SortInt value
+private def checkBool (value : Bool) : SortVal := SortVal.inj_SortBool value
+private def checkFloat (value : Float) : SortVal := SortVal.inj_SortFloat value
+private def checkNone : SortVal := SortVal.«noneV_MPY-CORE_Val»
+
+private def checkRun (values : List SortVal) : List SortVal :=
+  checkList («sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» (checkSeq values))
+
+example :
+    checkRun [checkInt 5, checkInt 6, checkInt 3, checkInt 4,
+      checkInt 8, checkInt 9, checkInt 2] =
+    [checkInt 2, checkInt 6, checkInt 3, checkInt 4,
+      checkInt 8, checkInt 9, checkInt 5] := rfl
+
+/- Selected slice is ["b", "a"] although the whole list mixes strings/ints. -/
+example :
+    checkRun [checkStr [98], checkInt 0, checkInt 0, checkStr [97]] =
+    [checkStr [97], checkInt 0, checkInt 0, checkStr [98]] := rfl
+
+/- The raw nested Iterable injection denotes the same frozen str value. -/
+example :
+    checkRun [checkNestedStr [98], checkNone, checkNone, checkStr [97]] =
+    [checkStr [97], checkNone, checkNone, checkNestedStr [98]] := rfl
+
+example :
+    checkRun [checkBool true, checkNone, checkNone,
+      checkBool false, checkNone, checkNone, checkBool true] =
+    [checkBool false, checkNone, checkNone,
+      checkBool true, checkNone, checkNone, checkBool true] := rfl
+
+private def checkFloatOrdering : Bool :=
+  match checkRun [checkFloat 2.5, checkNone, checkNone,
+      checkInt 1, checkNone, checkNone,
+      checkBool false, checkNone, checkNone,
+      checkFloat (-1.0)] with
+  | [SortVal.inj_SortFloat first, _, _,
+     SortVal.inj_SortBool false, _, _,
+     SortVal.inj_SortInt 1, _, _,
+     SortVal.inj_SortFloat fourth] =>
