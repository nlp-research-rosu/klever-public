diff --git a//tmp/lean-proc-exe-shim.c b//tmp/lean-proc-exe-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..abfd0cea0240c88b280b9e173f0d527dfcbd92fe
--- /dev/null
+++ b//tmp/lean-proc-exe-shim.c
@@ -0,0 +1,18 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (!real_readlink)
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  if (path && strncmp(path, "/proc/", 6) == 0) {
+    const char *tail = strrchr(path, '/');
+    if (tail && strcmp(tail, "/exe") == 0)
+      return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}
