     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The suffix of the final result produced by loop iterations I .. N-1.
     7	  // SV is sorted(buildVS(VS, 0, N, 3)).
     8	  syntax ValSeq ::= mergeThirdFrom(ValSeq, ValSeq, Int, Int)
     9	                    [function, total]
    10	
    11	  rule mergeThirdFrom(_VS, _SV, I, N) => .ValSeq
    12	    requires I >=Int N
    13	
    14	  rule mergeThirdFrom(VS, SV, I, N)
    15	    => vCons(valSeqAt(SV, I /Int 3),
    16	             mergeThirdFrom(VS, SV, I +Int 1, N))
    17	    requires I <Int N andBool pyMod(I, 3) ==Int 0
    18	
    19	  rule mergeThirdFrom(VS, SV, I, N)
    20	    => vCons(valSeqAt(VS, I),
    21	             mergeThirdFrom(VS, SV, I +Int 1, N))
    22	    requires I <Int N andBool pyMod(I, 3) =/=Int 0
    23	
    24	  syntax ValSeq ::= sortThirdResult(ValSeq)
    25	                    [function, total, no-evaluators]
    26	
    27	  // A folding orientation for the exact complete-result definition avoids
    28	  // unbounded eager unfolding when VS is symbolic.
    29	  rule mergeThirdFrom(
    30	         VS,
    31	         sortVS(buildVS(VS, 0, vsLen(VS), 3)),
    32	         0,
    33	         vsLen(VS))
    34	    => sortThirdResult(VS)
    35	    [simplification]
    36	
    37	  rule sortThirdResult(VS) => .ValSeq
    38	    requires vsLen(VS) <=Int 0
    39	    [simplification]
    40	
    41	  // Derived from the two exhaustive equations for valSeqConcat in MPY-LIST.
    42	  rule valSeqConcat(valSeqConcat(A, B), C)
    43	    => valSeqConcat(A, valSeqConcat(B, C))
    44	    [simplification]
    45	
    46	  // Right identity, also derived by structural induction from MPY-LIST.
    47	  rule valSeqConcat(A, .ValSeq) => A [simplification]
    48	endmodule

