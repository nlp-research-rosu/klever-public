+++ b//tmp/audit-work/33-sort-third-audit/OperationalAudit.lean
@@ -0,0 +1,37 @@
+import Proof
+
+namespace OperationalAudit
+
+private def nil : SortValSeq :=
+  SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+private def cons (value : SortVal) (rest : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest
+
+private def trueVal : SortVal := SortVal.inj_SortBool true
+private def falseVal : SortVal := SortVal.inj_SortBool false
+private def filler : SortVal := SortVal.«noneV_MPY-CORE_Val»
+
+private def unsortedInput : SortValSeq :=
+  cons trueVal (cons filler (cons filler (cons falseVal nil)))
+
+private def sourceExpected : SortValSeq :=
+  cons falseVal (cons filler (cons filler (cons trueVal nil)))
+
+theorem candidate_keeps_unsorted_selected_values :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» unsortedInput =
+      unsortedInput := by
+  rfl
+
+theorem candidate_differs_from_source_sorted_result :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» unsortedInput ≠
+      sourceExpected := by
+  intro h
+  injection h with headEquality _
+  injection headEquality with boolEquality
+  cases boolEquality
+
+#print OperationalAudit.candidate_keeps_unsorted_selected_values
+#print OperationalAudit.candidate_differs_from_source_sorted_result
+
+end OperationalAudit
