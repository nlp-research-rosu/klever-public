     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py concrete_test.py > concrete_test.mpy
     6	python3 py2mpy.py body_mutation_test.py > body_mutation_test.mpy
     7	
     8	kompile --backend llvm reference-semantics/semantics.k \
     9	  --main-module MPY-KRUN \
    10	  --syntax-module MPY-SYNTAX \
    11	  --output-definition runtime-kompiled
    12	
    13	krun concrete_test.mpy --definition runtime-kompiled > concrete.out
    14	grep -A1 '<exit-code' concrete.out | tail -n 2
    15	
    16	python3 differential_test.py
    17	
    18	set +e
    19	krun body_mutation_test.mpy \
    20	  --definition runtime-kompiled > body_mutation.out 2>&1
    21	body_mutation_status=$?
    22	set -e
    23	grep -A1 '<exit-code' body_mutation.out | tail -n 2
    24	if [[ $body_mutation_status -eq 0 ]]; then
    25	  echo "ERROR: body mutation unexpectedly passed"
    26	  exit 1
    27	fi
    28	echo "EXPECTED BODY-MUTATION FAILURE: exit $body_mutation_status"
    29	
    30	kompile --backend haskell verification.k \
    31	  --main-module VERIFICATION \
    32	  --syntax-module MPY-SYNTAX \
    33	  --output-definition verification-kompiled
    34	
    35	kprove spec.k \
    36	  --definition verification-kompiled \
    37	  --spec-module SPEC \
    38	  --claims SPEC.loop-invariant
    39	
    40	# Run the complete spec together: the target claim consumes loop-invariant as
    41	# its circularity. Filtering to only SPEC.sort-third would remove that proof
    42	# dependency.
    43	kprove spec.k \
    44	  --definition verification-kompiled \
    45	  --spec-module SPEC
    46	
    47	set +e
    48	kprove spec-vacuity.k \
    49	  --definition verification-kompiled \
    50	  --spec-module SPEC-VACUITY > vacuity.out 2>&1
    51	vacuity_status=$?
    52	set -e
    53	sed -n '1,80p' vacuity.out
    54	if [[ $vacuity_status -eq 0 ]]; then
    55	  echo "ERROR: false postcondition unexpectedly proved"
    56	  exit 1
    57	fi
    58	echo "EXPECTED FALSE-POSTCONDITION FAILURE: exit $vacuity_status"

diff --git a//tmp/audit-work/lean_proc_self_fix.c b//tmp/audit-work/lean_proc_self_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..6851087f7edd2aafd508da409449c495a7c33833
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_fix.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+  const char *p = path;
+  if (strncmp(p, "/proc/", 6) != 0) return 0;
+  p += 6;
+  if (!isdigit((unsigned char)*p)) return 0;
+  while (isdigit((unsigned char)*p)) p++;
+  return strcmp(p, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  return real_readlink(is_proc_pid_exe(path) ? "/proc/self/exe" : path,
+                       buf, bufsiz);
+}
