@@ -0,0 +1,36 @@
+import Proof
+
+open SortValSeq
+
+def auditIntSeq : List Int → SortValSeq
+  | [] => SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+  | value :: rest =>
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+        (SortVal.inj_SortInt value) (auditIntSeq rest)
+
+def auditSeqInts : SortValSeq → Option (List Int)
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => some []
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+      (SortVal.inj_SortInt value) rest =>
+      (value :: ·) <$> auditSeqInts rest
+  | _ => none
+
+#eval auditSeqInts
+  (Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+    (auditIntSeq [5, 6, 3, 4, 8, 9, 2]))
+
+#eval auditSeqInts
+  (Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+    (auditIntSeq [9, 1, 2, 4]))
+
+#eval auditSeqInts
+  (Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+    (auditIntSeq [8, -1, 7, 6, 5, 4, 3, 2, 1, 0]))
+
+#eval auditSeqInts
+  (Proof.«valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq»
+    (auditIntSeq [1, 2]) (auditIntSeq [3, 4]))
+
+#eval Proof.«vsLen(_)_MPY-CORE_Int_ValSeq» (auditIntSeq [-1, 0, 1])
+#eval Proof.«_<=Int_» (-2) 1
+#eval Proof.«_<=Int_» 2 1
diff --git a//tmp/audit-work/proof-audit.PdhDnI/Counterfactual.lean b//tmp/audit-work/proof-audit.PdhDnI/Counterfactual.lean
new file mode 100644
index 0000000000000000000000000000000000000000..ebf45ef6580d4c201c8a6980df33dc2747889225
--- /dev/null
+++ b//tmp/audit-work/proof-audit.PdhDnI/Counterfactual.lean
@@ -0,0 +1,53 @@
+import Proof
+
+namespace Counterfactual
+
+/- Deliberately wrong on every nonempty input whose third-position values need
+   reordering. This is the identity function, not sort_third. -/
+def fakeSortThird (values : SortValSeq) : SortValSeq := values
+
+def sourceLe (left right : SortInt) : SortBool := decide (left ≤ right)
+
+def sourceLength : SortValSeq → SortInt
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => 0
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest =>
+      sourceLength rest + 1
+
+def sourceConcat : SortValSeq → SortValSeq → SortValSeq
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq», suffix => suffix
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest,
+      suffix =>
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value
+        (sourceConcat rest suffix)
+
+theorem sourceConcatAssoc : ∀ (a b c : SortValSeq),
+    sourceConcat (sourceConcat a b) c = sourceConcat a (sourceConcat b c)
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq», _, _ => rfl
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest,
+      b, c =>
+      congrArg
+        (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value)
+        (sourceConcatAssoc rest b c)
+
+theorem sourceConcatRight : ∀ (a : SortValSeq),
+    sourceConcat a SortValSeq.«.ValSeq_MPY-CORE_ValSeq» = a
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => rfl
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest =>
+      congrArg
+        (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value)
+        (sourceConcatRight rest)
+
+theorem fakeFinal :
+    Klean33SortThird.Lemmas.targetStatement
+      sourceLe fakeSortThird sourceConcat sourceLength := by
+  constructor
+  · intro values h
+    cases values with
+    | «.ValSeq_MPY-CORE_ValSeq» => rfl
+    | «vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest =>
+        simp [sourceLe, sourceLength] at h
+  · exact ⟨(fun c b a => sourceConcatAssoc a b c), sourceConcatRight⟩
+
+#print axioms Counterfactual.fakeFinal
+
+end Counterfactual
diff --git a//tmp/audit-work/readlink_trace.c b//tmp/audit-work/readlink_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..4a2f6ebc9a6f3c7a2b1b5f8be3326cec962db9af
--- /dev/null
+++ b//tmp/audit-work/readlink_trace.c
@@ -0,0 +1,38 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = real_readlink(path, buf, bufsiz);
+  int saved = errno;
+  fprintf(stderr, "TRACE readlink(%s,%zu)=%zd errno=%d", path, bufsiz, result, saved);
+  if (result > 0) fprintf(stderr, " target=%.*s", (int)result, buf);
+  fputc('\n', stderr);
+  errno = saved;
+  return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t) = NULL;
+  if (!real_readlinkat) real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  ssize_t result = real_readlinkat(dirfd, path, buf, bufsiz);
+  int saved = errno;
+  fprintf(stderr, "TRACE readlinkat(%d,%s,%zu)=%zd errno=%d\n", dirfd, path, bufsiz, result, saved);
+  errno = saved;
+  return result;
+}
+
+char *getcwd(char *buf, size_t size) {
+  static char *(*real_getcwd)(char *, size_t) = NULL;
+  if (!real_getcwd) real_getcwd = dlsym(RTLD_NEXT, "getcwd");
+  char *result = real_getcwd(buf, size);
+  int saved = errno;
+  fprintf(stderr, "TRACE getcwd(%zu)=%s errno=%d\n", size, result ? result : "NULL", saved);
+  errno = saved;
+  return result;
+}
