    27	               (Subscript(Name("l"), Name("i")), .Exprs)))
    28	           .Stmts))
    29	        AugAssign(Name("i"), "+", Int(1))
    30	        .Stmts)
    31	      => .K
    32	      ...
    33	    </k>
    34	    <env> L </env>
    35	    <scopes>
    36	      ...
    37	      L |-> scope(
    38	        "i" |-> (I => N)
    39	        "l" |-> list(VS)
    40	        "result" |-> ref(OUT)
    41	        "thirds" |-> ref(THIRD),
    42	        parent(0))
    43	      0 |-> scope(MODULESCOPE, parent(-1))
    44	      -1 |-> builtinsScope
    45	      ...
    46	    </scopes>
    47	    <heap>
    48	      ...
    49	      OUT |-> list(
    50	        A
    51	        => valSeqConcat(A, mergeThirdFrom(VS, SV, I, N)))
    52	      THIRD |-> list(SV)
    53	      ...
    54	    </heap>
    55	    requires 0 <=Int I
    56	     andBool I <=Int N
    57	     andBool N ==Int vsLen(VS)
    58	     andBool notBool ("len" in_keys(MODULESCOPE))
    59	
    60	  claim [sort-third]:
    61	    <k>
    62	      #loadAll(
