requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // The suffix of the final result produced by loop iterations I .. N-1.
  // SV is sorted(buildVS(VS, 0, N, 3)).
  syntax ValSeq ::= mergeThirdFrom(ValSeq, ValSeq, Int, Int)
                    [function, total]

  rule mergeThirdFrom(_VS, _SV, I, N) => .ValSeq
    requires I >=Int N

  rule mergeThirdFrom(VS, SV, I, N)
    => vCons(valSeqAt(SV, I /Int 3),
             mergeThirdFrom(VS, SV, I +Int 1, N))
    requires I <Int N andBool pyMod(I, 3) ==Int 0

  rule mergeThirdFrom(VS, SV, I, N)
    => vCons(valSeqAt(VS, I),
             mergeThirdFrom(VS, SV, I +Int 1, N))
    requires I <Int N andBool pyMod(I, 3) =/=Int 0

  syntax ValSeq ::= sortThirdResult(ValSeq)
                    [function, total, no-evaluators]

  // A folding orientation for the exact complete-result definition avoids
  // unbounded eager unfolding when VS is symbolic.
  rule mergeThirdFrom(
         VS,
         sortVS(buildVS(VS, 0, vsLen(VS), 3)),
         0,
         vsLen(VS))
    => sortThirdResult(VS)
    [simplification]

  rule sortThirdResult(VS) => .ValSeq
    requires vsLen(VS) <=Int 0
    [simplification]

  // Derived from the two exhaustive equations for valSeqConcat in MPY-LIST.
  rule valSeqConcat(valSeqConcat(A, B), C)
    => valSeqConcat(A, valSeqConcat(B, C))
    [simplification]

  // Right identity, also derived by structural induction from MPY-LIST.
  rule valSeqConcat(A, .ValSeq) => A [simplification]
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [loop-invariant]:
    <k>
      #while(
        Compare(
          Name("i"),
          CmpOp("<", Call(Name("len"), (Name("l"), .Exprs)))),
        If(
          Compare(
            BinOp("%", Name("i"), Int(3)),
            CmpOp("==", Int(0))),
          (Expr(
             Call(
               Attribute(Name("result"), "append"),
               (Subscript(
                  Name("thirds"),
                  BinOp("//", Name("i"), Int(3))),
                .Exprs)))
           .Stmts),
          (Expr(
             Call(
               Attribute(Name("result"), "append"),
               (Subscript(Name("l"), Name("i")), .Exprs)))
           .Stmts))
        AugAssign(Name("i"), "+", Int(1))
        .Stmts)
      => .K
      ...
    </k>
    <env> L </env>
    <scopes>
      ...
      L |-> scope(
        "i" |-> (I => N)
        "l" |-> list(VS)
        "result" |-> ref(OUT)
        "thirds" |-> ref(THIRD),
        parent(0))
      0 |-> scope(MODULESCOPE, parent(-1))
      -1 |-> builtinsScope
      ...
    </scopes>
    <heap>
      ...
      OUT |-> list(
        A
        => valSeqConcat(A, mergeThirdFrom(VS, SV, I, N)))
      THIRD |-> list(SV)
      ...
    </heap>
    requires 0 <=Int I
     andBool I <=Int N
     andBool N ==Int vsLen(VS)
     andBool notBool ("len" in_keys(MODULESCOPE))

  claim [sort-third]:
    <k>
      #loadAll(
        Module(
          FuncDef(
            "sort_third",
            Params("l", .ParamNames),
            Assign(
              Name("thirds"),
              Call(
                Name("sorted"),
                (Subscript(
                   Name("l"),
                   Slice(NoBound, NoBound, Int(3))),
                 .Exprs)))
            Assign(Name("result"), ListExpr(.Exprs))
            Assign(Name("i"), Int(0))
            While(
              Compare(
                Name("i"),
                CmpOp(
                  "<",
                  Call(Name("len"), (Name("l"), .Exprs)))),
              If(
                Compare(
                  BinOp("%", Name("i"), Int(3)),
                  CmpOp("==", Int(0))),
                (Expr(
                   Call(
                     Attribute(Name("result"), "append"),
                     (Subscript(
                        Name("thirds"),
                        BinOp("//", Name("i"), Int(3))),
                      .Exprs)))
                 .Stmts),
                (Expr(
                   Call(
                     Attribute(Name("result"), "append"),
                     (Subscript(Name("l"), Name("i")), .Exprs)))
                 .Stmts))
              AugAssign(Name("i"), "+", Int(1))
              .Stmts)
            Return(Name("result"))
            .Stmts)
          .Stmts))
      ~> Call(
           Name("sort_third"),
           (list(VS), .Exprs))
      => ref(2)
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      =>
      (0 |-> scope(
         "sort_third" |->
           closureVal(
             ("l", .ParamNames),
             Assign(
               Name("thirds"),
               Call(
                 Name("sorted"),
                 (Subscript(
                    Name("l"),
                    Slice(NoBound, NoBound, Int(3))),
                  .Exprs)))
             Assign(Name("result"), ListExpr(.Exprs))
             Assign(Name("i"), Int(0))
             While(
               Compare(
                 Name("i"),
                 CmpOp(
                   "<",
                   Call(Name("len"), (Name("l"), .Exprs)))),
               If(
                 Compare(
                   BinOp("%", Name("i"), Int(3)),
                   CmpOp("==", Int(0))),
                 (Expr(
                    Call(
                      Attribute(Name("result"), "append"),
                      (Subscript(
                         Name("thirds"),
                         BinOp("//", Name("i"), Int(3))),
                       .Exprs)))
                  .Stmts),
                 (Expr(
                    Call(
                      Attribute(Name("result"), "append"),
                      (Subscript(Name("l"), Name("i")), .Exprs)))
                  .Stmts))
               AugAssign(Name("i"), "+", Int(1))
               .Stmts)
             Return(Name("result"))
             .Stmts,
             0),
         parent(-1))
       -1 |-> builtinsScope)
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      =>
      (0 |-> list(buildVS(VS, 0, vsLen(VS), 3))
       1 |-> list(sortVS(buildVS(VS, 0, vsLen(VS), 3)))
       2 |-> list(sortThirdResult(VS)))
    </heap>
    <heapLoc> 0 => 3 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
