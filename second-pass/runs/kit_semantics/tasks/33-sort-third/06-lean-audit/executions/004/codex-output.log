+  | value :: rest =>
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+        (SortVal.inj_SortInt value) (auditIntSeq rest)
+
+def auditSeqInts : SortValSeq → Option (List Int)
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => some []
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+      (SortVal.inj_SortInt value) rest =>
+      (value :: ·) <$> auditSeqInts rest
+  | _ => none
