+7. rule-d101... (47): DOMAIN_LEMMA. Right identity of that same left-recursive concatenation, again not separately proved. It is relevant when mergeThirdFrom reaches its empty base at loop exit.
+
+CONSISTENCY AND RELEVANCE
+- All four rules tagged simplification are classified only as DEFINITION or DOMAIN_LEMMA.
+- The two merge recurrence guards are exhaustive over I < N because pyMod(I,3) is an integer and equality versus disequality to zero are complementary; the I >= N base supplies termination.
+- valSeqConcat associativity and right identity are true by structural induction on the first ValSeq argument using supplied list.k lines 19-20.
+- vsLen is nonnegative on the algebraic ValSeq constructors by core.k lines 223-225, so the zero-length guard identifies the empty sequence; the complete merge definition then reduces by its base case.
+- No local rule is an ordinary K-cell execution/observation rule, so OPERATIONAL_RULE is empty.
+- prove.sh has only the loop invariant and final claims from spec.k, after compiling every verification.k rule; there is no bridge-free, earlier kprove of any exact local rule. PROVED_DERIVED_LEMMA is therefore empty.
+
+JUDGMENT
+The protected Stage 3 classifications match the independent classification exactly. The true domain-lemma set is nonempty and consists of precisely rules 5-7.

codex
I found the precise cause: this sandbox’s PID namespace makes Lean’s `IO.appPath` request `/proc/<namespace-pid>/exe`, but that numeric path is absent from the mounted `/proc`; `/proc/self/exe` works. I’m applying a narrow audit-local preload shim that redirects only `/proc/[digits]+/exe` reads to `/proc/self/exe`, then rerunning the pinned toolchain and preflight. This changes no candidate or provenance input.
apply patch
patch: completed
/tmp/audit-work/lean_proc_self_fix.c
diff --git a//tmp/audit-work/lean_proc_self_fix.c b//tmp/audit-work/lean_proc_self_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..6851087f7edd2aafd508da409449c495a7c33833
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_fix.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+  const char *p = path;
+  if (strncmp(p, "/proc/", 6) != 0) return 0;
+  p += 6;
+  if (!isdigit((unsigned char)*p)) return 0;
+  while (isdigit((unsigned char)*p)) p++;
+  return strcmp(p, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  return real_readlink(is_proc_pid_exe(path) ? "/proc/self/exe" : path,
+                       buf, bufsiz);
+}
diff --git a//tmp/audit-work/readlink_trace.c b//tmp/audit-work/readlink_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..4a2f6ebc9a6f3c7a2b1b5f8be3326cec962db9af
--- /dev/null
+++ b//tmp/audit-work/readlink_trace.c
@@ -0,0 +1,38 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = real_readlink(path, buf, bufsiz);
+  int saved = errno;
+  fprintf(stderr, "TRACE readlink(%s,%zu)=%zd errno=%d", path, bufsiz, result, saved);
+  if (result > 0) fprintf(stderr, " target=%.*s", (int)result, buf);
+  fputc('\n', stderr);
+  errno = saved;
+  return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t) = NULL;
+  if (!real_readlinkat) real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  ssize_t result = real_readlinkat(dirfd, path, buf, bufsiz);
+  int saved = errno;
+  fprintf(stderr, "TRACE readlinkat(%d,%s,%zu)=%zd errno=%d\n", dirfd, path, bufsiz, result, saved);
+  errno = saved;
+  return result;
+}
+
+char *getcwd(char *buf, size_t size) {
+  static char *(*real_getcwd)(char *, size_t) = NULL;
+  if (!real_getcwd) real_getcwd = dlsym(RTLD_NEXT, "getcwd");
+  char *result = real_getcwd(buf, size);
+  int saved = errno;
+  fprintf(stderr, "TRACE getcwd(%zu)=%s errno=%d\n", size, result ? result : "NULL", saved);
+  errno = saved;
+  return result;
+}
