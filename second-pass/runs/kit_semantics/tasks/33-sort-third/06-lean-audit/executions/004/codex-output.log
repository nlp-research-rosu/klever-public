+import Proof
+
+namespace Counterfactual
+
+/- Deliberately wrong on every nonempty input whose third-position values need
+   reordering. This is the identity function, not sort_third. -/
+def fakeSortThird (values : SortValSeq) : SortValSeq := values
+
+def sourceLe (left right : SortInt) : SortBool := decide (left ≤ right)
+
+def sourceLength : SortValSeq → SortInt
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => 0
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest =>
+      sourceLength rest + 1
+
+theorem sourceLengthNonnegative : ∀ (values : SortValSeq), 0 ≤ sourceLength values
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => by simp [sourceLength]
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest => by
+      simpa [sourceLength] using
+        Int.add_nonneg (sourceLengthNonnegative rest) (by decide : (0 : Int) ≤ 1)
+
+def sourceConcat : SortValSeq → SortValSeq → SortValSeq
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq», suffix => suffix
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest,
+      suffix =>
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value
+        (sourceConcat rest suffix)
+
+theorem sourceConcatAssoc : ∀ (a b c : SortValSeq),
+    sourceConcat (sourceConcat a b) c = sourceConcat a (sourceConcat b c)
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq», _, _ => rfl
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest,
+      b, c =>
+      congrArg
+        (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value)
+        (sourceConcatAssoc rest b c)
+
+theorem sourceConcatRight : ∀ (a : SortValSeq),
+    sourceConcat a SortValSeq.«.ValSeq_MPY-CORE_ValSeq» = a
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => rfl
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest =>
+      congrArg
+        (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value)
+        (sourceConcatRight rest)
+
+theorem fakeFinal :
+    Klean33SortThird.Lemmas.targetStatement
+      sourceLe fakeSortThird sourceConcat sourceLength := by
+  constructor
+  · intro values h
+    cases values with
+    | «.ValSeq_MPY-CORE_ValSeq» => rfl
+    | «vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest =>
+        have hle : sourceLength rest + 1 ≤ 0 := by
+          exact of_decide_eq_true h
+        have hpos : 0 < sourceLength rest + 1 :=
+          Int.add_pos_of_nonneg_of_pos (sourceLengthNonnegative rest) (by decide)
+        exact (Int.not_lt_of_ge hle hpos).elim
+  · exact ⟨(fun c b a => sourceConcatAssoc a b c), sourceConcatRight⟩
+
+#print axioms Counterfactual.fakeFinal
+
+end Counterfactual
