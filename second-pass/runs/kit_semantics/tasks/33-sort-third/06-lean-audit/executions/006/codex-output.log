index 0000000000000000000000000000000000000000..915b8a1a39b01290ca7362d6bb38c2399ec79fb9
--- /dev/null
+++ b/evidence/reconstruct_inventory.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+import json
+from pathlib import Path
+
+from tools import k_rule_inventory, lemma_discovery_contract
+
+
+workspace = Path("/reference/k-proof")
+manifest_path = Path("/reference/lemma-discovery.json")
+manifest = json.loads(manifest_path.read_text())
+reconstructed = k_rule_inventory.inventory_verification(workspace)
+validated = lemma_discovery_contract.validate_trust_boundary(
+    workspace, manifest_path
+)
+
+observed_records = manifest.get("rules", [])
+observed_ids = [record.get("source_rule_id") for record in observed_records]
+expected_ids = [record["source_rule_id"] for record in reconstructed["rules"]]
+comparison = {
+    "inventory_hash_matches": manifest.get("inventory_sha256")
+    == reconstructed["inventory_sha256"],
+    "ordered_ids_match": observed_ids == expected_ids,
+    "no_duplicate_manifest_ids": len(observed_ids) == len(set(observed_ids)),
+    "manifest_rule_count": len(observed_ids),
+    "reconstructed_rule_count": len(expected_ids),
+    "omitted_ids": [item for item in expected_ids if item not in observed_ids],
+    "extra_ids": [item for item in observed_ids if item not in expected_ids],
+}
+comparison["bijection_and_order_match"] = all(
+    comparison[key]
+    for key in (
+        "inventory_hash_matches",
+        "ordered_ids_match",
+        "no_duplicate_manifest_ids",
+    )
+) and comparison["manifest_rule_count"] == comparison["reconstructed_rule_count"]
+
+print(json.dumps({
+    "comparison": comparison,
+    "reconstructed": reconstructed,
+    "validated_trust_boundary": validated,
+}, indent=2, sort_keys=True))

diff --git a//tmp/audit-work/33-sort-third-proof.TyFA4i/Adversarial.lean b//tmp/audit-work/33-sort-third-proof.TyFA4i/Adversarial.lean
new file mode 100644
index 0000000000000000000000000000000000000000..918b667052b97586d1af86b395cade9629963ec0
--- /dev/null
+++ b//tmp/audit-work/33-sort-third-proof.TyFA4i/Adversarial.lean
@@ -0,0 +1,75 @@
+import Proof
+
+namespace Adversarial
+
+def nil : SortValSeq := SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+def cons (value : SortVal) (rest : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest
+
+def int (value : Int) : SortVal := SortVal.inj_SortInt value
+
+def ints : List Int → SortValSeq
+  | [] => nil
+  | value :: rest => cons (int value) (ints rest)
+
+def values : List SortVal → SortValSeq
+  | [] => nil
+  | value :: rest => cons value (values rest)
+
+def codes : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | value :: rest =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» value (codes rest)
+
+def str (value : List Int) : SortVal :=
+  SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» (codes value))
+
+-- HumanEval's stated nontrivial example.
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+        (ints [5, 6, 3, 4, 8, 9, 2]) =
+      ints [2, 6, 3, 4, 8, 9, 5] := by
+  rfl
+
+-- Boundary lengths exercise every partial final triple.
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» nil = nil := by
+  rfl
+
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» (ints [7]) =
+      ints [7] := by
+  rfl
+
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» (ints [7, 8]) =
+      ints [7, 8] := by
+  rfl
+
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+        (ints [9, 8, 7, -2]) =
+      ints [-2, 8, 7, 9] := by
+  rfl
+
+-- String order uses the same integer-code lexicographic recurrence as strLt.
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+        (values [str [122], str [107, 101, 101, 112],
+          str [97, 108, 115, 111], str [97]]) =
+      values [str [97], str [107, 101, 101, 112],
+        str [97, 108, 115, 111], str [122]] := by
+  rfl
+
+-- Direct checks of the three primitive bridges.
+example : Proof.«_<=Int_» (-1) 0 = true := by rfl
+example : Proof.«_<=Int_» 1 0 = false := by rfl
+example : Proof.«vsLen(_)_MPY-CORE_Int_ValSeq» (ints [3, 1, 4]) = 3 := by
+  rfl
+example :
+    Proof.«valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq»
+        (ints [1, 2]) (ints [3, 4]) = ints [1, 2, 3, 4] := by
+  rfl
+
+end Adversarial
