     8	    Assign(Name("result"), ListExpr())
     9	    Assign(Name("i"), Int(0))
    10	    While(Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("l")))),
    11	      If(Compare(BinOp("%", Name("i"), Int(3)), CmpOp("==", Int(0))),
    12	        Expr(
    13	          Call(
    14	            Attribute(Name("result"), "append"),
    15	            Subscript(Name("thirds"), BinOp("//", Name("i"), Int(3))))),
    16	        Expr(
    17	          Call(
    18	            Attribute(Name("result"), "append"),
    19	            Subscript(Name("l"), Name("i")))))
    20	      AugAssign(Name("i"), "+", Int(1)))
    21	    Return(Name("result"))))
