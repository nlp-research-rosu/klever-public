--- /dev/null
+++ b//tmp/audit-work/33-sort-third-proof.TyFA4i/Adversarial.lean
@@ -0,0 +1,75 @@
+import Proof
+
+namespace Adversarial
+
+def nil : SortValSeq := SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+def cons (value : SortVal) (rest : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest
+
+def int (value : Int) : SortVal := SortVal.inj_SortInt value
+
+def ints : List Int → SortValSeq
+  | [] => nil
+  | value :: rest => cons (int value) (ints rest)
+
+def values : List SortVal → SortValSeq
+  | [] => nil
+  | value :: rest => cons value (values rest)
+
+def codes : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | value :: rest =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» value (codes rest)
+
+def str (value : List Int) : SortVal :=
+  SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» (codes value))
+
+-- HumanEval's stated nontrivial example.
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+        (ints [5, 6, 3, 4, 8, 9, 2]) =
+      ints [2, 6, 3, 4, 8, 9, 5] := by
+  rfl
+
+-- Boundary lengths exercise every partial final triple.
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» nil = nil := by
+  rfl
+
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» (ints [7]) =
+      ints [7] := by
+  rfl
+
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» (ints [7, 8]) =
+      ints [7, 8] := by
+  rfl
+
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+        (ints [9, 8, 7, -2]) =
+      ints [-2, 8, 7, 9] := by
+  rfl
+
+-- String order uses the same integer-code lexicographic recurrence as strLt.
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq»
+        (values [str [122], str [107, 101, 101, 112],
+          str [97, 108, 115, 111], str [97]]) =
+      values [str [97], str [107, 101, 101, 112],
+        str [97, 108, 115, 111], str [122]] := by
+  rfl
+
+-- Direct checks of the three primitive bridges.
+example : Proof.«_<=Int_» (-1) 0 = true := by rfl
+example : Proof.«_<=Int_» 1 0 = false := by rfl
+example : Proof.«vsLen(_)_MPY-CORE_Int_ValSeq» (ints [3, 1, 4]) = 3 := by
+  rfl
+example :
+    Proof.«valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq»
+        (ints [1, 2]) (ints [3, 4]) = ints [1, 2, 3, 4] := by
+  rfl
+
+end Adversarial
