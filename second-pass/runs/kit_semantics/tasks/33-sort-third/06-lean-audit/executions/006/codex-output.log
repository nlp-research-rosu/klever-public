   163	def _workspace_k_files(workspace: Path) -> tuple[Path, ...]:
   164	    workspace = Path(workspace)
   165	    if not workspace.is_dir() or workspace.is_symlink():
   166	        raise KleanExportError("K definition workspace must be a real directory")
   167	    files = tuple(
   168	        path.resolve()
   169	        for _relative, kind, path in _tree_entries(workspace)
   170	        if kind == "file" and path.suffix == ".k"
   171	    )
   172	    if not files:
   173	        raise KleanExportError("K definition workspace contains no .k files")
   174	    return tuple(sorted(files, key=str))
