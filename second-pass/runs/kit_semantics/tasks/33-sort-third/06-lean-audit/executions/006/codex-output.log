     3	def sort_third(l: list):
     4	    """This function takes a list l and returns a list l' such that
     5	    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal
     6	    to the values of the corresponding indicies of l, but sorted.
     7	    >>> sort_third([1, 2, 3])
     8	    [1, 2, 3]
     9	    >>> sort_third([5, 6, 3, 4, 8, 9, 2])
    10	    [2, 6, 3, 4, 8, 9, 5]
    11	    """
