   110	def _proof_kompile_commands(workspace: Path) -> tuple[KompileCommand, ...]:
   111	    prove = workspace / "prove.sh"
   112	    if not prove.is_file() or prove.is_symlink():
   113	        return ()
   114	    logical_lines = prove.read_text().replace("\\\n", " ").splitlines()
   115	    commands: list[KompileCommand] = []
   116	    for line in logical_lines:
   117	        try:
   118	            words = shlex.split(line, comments=True)
   119	        except ValueError:
   120	            continue
   121	        try:
   122	            index = words.index("kompile")
   123	        except ValueError:
   124	            continue
   125	        arguments = words[index + 1 :]
   126	        source_word = next(
   127	            (
   128	                word
   129	                for word in arguments
   130	                if not word.startswith("-") and word.endswith(".k")
   131	            ),
   132	            None,
   133	        )
   134	        if source_word is None:
   135	            continue
   136	        source = (workspace / source_word).resolve()
   137	        try:
   138	            source.relative_to(workspace)
   139	        except ValueError:
   140	            continue
   141	        if not source.is_file() or source.is_symlink():
   142	            continue
   143	
   144	        def option(name: str) -> str | None:
   145	            if name not in arguments:
   146	                return None
   147	            option_index = arguments.index(name)
   148	            if option_index + 1 >= len(arguments):
   149	                return None
   150	            return arguments[option_index + 1]
   151	
   152	        commands.append(
   153	            KompileCommand(
   154	                source=source,
   155	                main_module=option("--main-module"),
   156	                syntax_module=option("--syntax-module"),
   157	                backend=option("--backend"),
   158	            )
   159	        )
   160	    return tuple(commands)
   161	
