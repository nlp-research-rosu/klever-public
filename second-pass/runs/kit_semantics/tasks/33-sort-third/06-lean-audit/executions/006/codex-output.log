   177	def _local_required_file(source: Path, required: str, workspace: Path) -> Path | None:
   178	    candidate = Path(required)
   179	    unresolved = (
   180	        candidate
   181	        if candidate.is_absolute()
   182	        else source.parent / candidate
   183	    )
   184	    resolved = unresolved.resolve()
   185	    try:
   186	        resolved.relative_to(workspace)
   187	    except ValueError:
   188	        raise KleanExportError(
   189	            "K definition requires a file outside the frozen workspace: "
   190	            f"{required}"
   191	        )
   192	    if not resolved.exists():
   193	        if resolved.suffix == ".k":
   194	            raise KleanExportError(
   195	                f"K definition requires a missing workspace .k file: {required}"
   196	            )
   197	        return None
   198	    if unresolved.is_symlink() or not resolved.is_file() or resolved.suffix != ".k":
   199	        raise KleanExportError(
   200	            f"K definition require is not a regular workspace .k file: {resolved}"
   201	        )
   202	    return resolved
