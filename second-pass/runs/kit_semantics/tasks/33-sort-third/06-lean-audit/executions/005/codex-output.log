+++ b/evidence/stage5_static_check.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+
+sys.path.insert(0, "/reference")
+from tools.klean_export import target_statement
+from tools.provenance import pipeline_tree_digest
+
+audit = json.loads(Path("/audit-input.json").read_text())
+manifest = json.loads(Path("/reference/klean-generation/generator-manifest.json").read_text())
+candidate = Path("/candidate")
+proof = candidate / "Proof.lean"
+text = proof.read_text()
+
+observed = target_statement(Path("/reference/klean-generation"))
+statement = observed["statement"]
+definition = observed["definition"]
+definition_hash = hashlib.sha256(definition.encode()).hexdigest()
+statement_hash = hashlib.sha256(statement.encode()).hexdigest()
+
+print("MODE", audit["audit_mode"])
+print("TARGET_DECLARATION", observed["declaration"])
+print("TARGET_DEFINITION_SHA256", definition_hash)
+print("TARGET_STATEMENT_SHA256", statement_hash)
+print("TARGET_MATCHES_GENERATOR_MANIFEST", definition_hash == manifest["target"]["definition_sha256"] and statement_hash == manifest["target"]["statement_sha256"])
+print("TARGET_MATCHES_AUDIT_INPUT", definition_hash == audit["generation"]["target"]["definition_sha256"] and statement_hash == audit["generation"]["target"]["statement_sha256"])
+
+candidate_digest = pipeline_tree_digest(candidate)
+generated_digest = pipeline_tree_digest(Path("/reference/klean-generation"))
+print("CANDIDATE_TREE_SHA256", candidate_digest)
+print("CANDIDATE_TREE_MATCHES_AUDIT_INPUT", candidate_digest == audit["candidate"]["tree_sha256"])
+print("GENERATED_TREE_SHA256", generated_digest)
+print("GENERATED_TREE_MATCHES_AUDIT_INPUT", generated_digest == audit["generation"]["tree_sha256"])
+
+lean_files = sorted(p for p in candidate.rglob("*.lean") if "Base" not in p.parts)
+joined = "\n".join(p.read_text() for p in lean_files)
+forbidden = {}
+patterns = {
+    "sorry": r"\bsorry\b",
+    "admit": r"\badmit\b",
+    "unsafe": r"\bunsafe\b",
+    "axiom": r"(?m)^\s*axiom\b",
+    "opaque": r"(?m)^\s*opaque\b",
+}
+for name, pattern in patterns.items():
+    forbidden[name] = len(re.findall(pattern, joined))
+print("CANDIDATE_LEAN_FILES", [str(p.relative_to(candidate)) for p in lean_files])
+print("FORBIDDEN_COUNTS", forbidden)
+print("TARGET_DEFINITION_SHADOW_COUNT", len(re.findall(r"(?m)^\s*(?:def|theorem|axiom|opaque)\s+targetStatement\b", joined)))
+print("TARGET_NAMESPACE_REOPEN_COUNT", len(re.findall(r"(?m)^\s*namespace\s+Klean33SortThird\.Lemmas\b", joined)))
+
+params = [p["name"] for p in manifest["target"]["parameters"]]
+for name in params:
+    count = len(re.findall(rf"(?m)^\s*def\s+{re.escape(name)}\b", text))
+    print("PARAMETER_DEF_COUNT", name, count)
+
+final_match = re.search(
+    r"theorem\s+final\s*:\s*Klean33SortThird\.Lemmas\.targetStatement\s+leInt\s+sortThirdResult\s+concatValSeq\s+vsLen\s*:=",
+    text,
+    re.S,
+)
+print("FINAL_EXACT_FIXED_TARGET", bool(final_match))
+print("ALL_STATIC_CHECKS_PASS", all(forbidden[x] == 0 for x in forbidden) and bool(final_match))

apply patch
