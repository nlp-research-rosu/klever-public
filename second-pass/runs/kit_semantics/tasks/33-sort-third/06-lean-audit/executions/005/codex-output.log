    69	/- This is source `<` lifted to the value universe retained by Base. Boolean,
    70	   integer, and float values share Python's numeric order; lists and tuples
    71	   compare lexicographically within their own kinds. Base has no injection for
    72	   the frozen `str(IntSeq)` Python value. All other pairs use the same fixed
    73	   incomparable result because the frozen comparison is partial there. -/
    74	mutual
    75	  private def proofCompareBaseValuesFuel :
    76	      Nat → SortVal → SortVal → Option Ordering
    77	    | 0, _, _ => none
    78	    | Nat.succ _, SortVal.inj_SortBool left, SortVal.inj_SortBool right =>
    79	        some (proofCompareInts (proofBoolAsInt left) (proofBoolAsInt right))
    80	    | Nat.succ _, SortVal.inj_SortBool left, SortVal.inj_SortInt right =>
    81	        some (proofCompareInts (proofBoolAsInt left) right)
    82	    | Nat.succ _, SortVal.inj_SortInt left, SortVal.inj_SortBool right =>
    83	        some (proofCompareInts left (proofBoolAsInt right))
    84	    | Nat.succ _, SortVal.inj_SortInt left, SortVal.inj_SortInt right =>
    85	        some (proofCompareInts left right)
    86	    | Nat.succ _, SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
    87	        proofCompareFloats left right
    88	    | Nat.succ _, SortVal.inj_SortInt left, SortVal.inj_SortFloat right =>
    89	        proofCompareFloats (Float.ofInt left) right
    90	    | Nat.succ _, SortVal.inj_SortFloat left, SortVal.inj_SortInt right =>
    91	        proofCompareFloats left (Float.ofInt right)
    92	    | Nat.succ _, SortVal.inj_SortBool left, SortVal.inj_SortFloat right =>
    93	        proofCompareFloats (Float.ofInt (proofBoolAsInt left)) right
    94	    | Nat.succ _, SortVal.inj_SortFloat left, SortVal.inj_SortBool right =>
    95	        proofCompareFloats left (Float.ofInt (proofBoolAsInt right))
    96	    | Nat.succ fuel,
    97	        SortVal.inj_SortIterable
    98	          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» left),
    99	        SortVal.inj_SortIterable
   100	          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» right) =>
   101	        proofCompareBaseSequencesFuel fuel left right
   102	    | Nat.succ fuel,
   103	        SortVal.inj_SortIterable
   104	          (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» left),
   105	        SortVal.inj_SortIterable
   106	          (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» right) =>
   107	        proofCompareBaseSequencesFuel fuel left right
   108	    | Nat.succ _, _, _ => none
   109	
   110	  private def proofCompareBaseSequencesFuel :
   111	      Nat → SortValSeq → SortValSeq → Option Ordering
   112	    | 0, _, _ => none
   113	    | Nat.succ _, SortValSeq.«.ValSeq_MPY-CORE_ValSeq»,
   114	        SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => some .eq
   115	    | Nat.succ _, SortValSeq.«.ValSeq_MPY-CORE_ValSeq»,
   116	        SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ _ => some .lt
   117	    | Nat.succ _, SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ _,
   118	        SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => some .gt
   119	    | Nat.succ fuel,
   120	        SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» left leftRest,
   121	        SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» right rightRest =>
