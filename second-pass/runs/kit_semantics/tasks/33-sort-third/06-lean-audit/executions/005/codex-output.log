+    "trust_inventory_sha256_computed": hashlib.sha256(
+        (generation / "trust-inventory.json").read_bytes()
+    ).hexdigest(),
+    "trust_inventory_sha256_export_result": export_result[
+        "trust_inventory_sha256"
