     1	import Klean33SortThird.Inj
     2	
     3	/- K trust-boundary goals. The second-pass agent must replace every
     4	   writable opaque stub with an honest definition and prove this
     5	   immutable proposition in the separate Proof.lean workspace. -/
     6	
     7	namespace Klean33SortThird.Lemmas
     8	
     9	def targetStatement
    10	    («_<=Int_» : SortInt → SortInt → SortBool)
    11	    («sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» : SortValSeq → SortValSeq)
    12	    («valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» : SortValSeq → SortValSeq → SortValSeq)
    13	    («vsLen(_)_MPY-CORE_Int_ValSeq» : SortValSeq → SortInt)
    14	    : Prop :=
    15	    (∀ (VS : SortValSeq) (h : («_<=Int_» («vsLen(_)_MPY-CORE_Int_ValSeq» VS) 0) = true), («sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» VS : SortValSeq) = (SortValSeq.«.ValSeq_MPY-CORE_ValSeq» : SortValSeq))
    16	    ∧ (∀ (C : SortValSeq) (B : SortValSeq) (A : SortValSeq), («valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» («valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» A B) C : SortValSeq) = («valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» A («valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» B C) : SortValSeq))
    17	    ∧ (∀ (A : SortValSeq), («valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» A SortValSeq.«.ValSeq_MPY-CORE_ValSeq» : SortValSeq) = (A : SortValSeq))
    18	
    19	end Klean33SortThird.Lemmas

