diff --git a//tmp/audit-work/lean-audit.5FJWJt/BridgeAudit.lean b//tmp/audit-work/lean-audit.5FJWJt/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..62df4bdf2552618ece8e6e5d844b6d836ca73190
--- /dev/null
+++ b//tmp/audit-work/lean-audit.5FJWJt/BridgeAudit.lean
@@ -0,0 +1,32 @@
+import Proof
+
+private abbrev nil : SortValSeq :=
+  SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+private abbrev cons (v : SortVal) (vs : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» v vs
+
+private abbrev t : SortVal := SortVal.inj_SortBool true
+private abbrev f : SortVal := SortVal.inj_SortBool false
+
+-- The source selects [true, false] at indices 0 and 3, sorts it to
+-- [false, true], and weaves those values back into the same positions.
+private abbrev boolInput : SortValSeq :=
+  cons t (cons t (cons f (cons f nil)))
+
+private abbrev sourceExpected : SortValSeq :=
+  cons f (cons t (cons f (cons t nil)))
+
+-- The submitted bridge's non-integer branch leaves the selected values in
+-- their original order, so its public result is the original input.
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» boolInput = boolInput :=
+  rfl
+
+example :
+    Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» boolInput ≠ sourceExpected := by
+  intro h
+  cases h
+
+#reduce Proof.«sortThirdResult(_)_VERIFICATION_ValSeq_ValSeq» boolInput
+#reduce sourceExpected
diff --git a//tmp/audit-work/lean-audit.5FJWJt/CounterfactualAudit.lean b//tmp/audit-work/lean-audit.5FJWJt/CounterfactualAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..490762c80f1fb9a64ffd4a489490b480e9f53e1a
--- /dev/null
+++ b//tmp/audit-work/lean-audit.5FJWJt/CounterfactualAudit.lean
@@ -0,0 +1,36 @@
+import Proof
+
+def identitySortThirdResult (values : SortValSeq) : SortValSeq := values
+
+def operationalVsLen : SortValSeq → SortInt
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => 0
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest =>
+      operationalVsLen rest + 1
+
+private theorem operationalVsLenNonnegative :
+    ∀ values, (0 : Int) ≤ operationalVsLen values
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => by simp [operationalVsLen]
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest => by
+      simp only [operationalVsLen]
+      have ih := operationalVsLenNonnegative rest
+      omega
+
+-- The exact generated target still accepts a result bridge that is merely
+-- identity on every nonempty input. This mutation is intentionally wrong for
+-- the source program, but the target's empty-input conjunct cannot observe it.
+theorem identityBridgeAlsoPasses :
+    Klean33SortThird.Lemmas.targetStatement
+      Proof.«_<=Int_»
+      identitySortThirdResult
+      Proof.«valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq»
+      operationalVsLen := by
+  rcases Proof.final with ⟨_, assoc, rightIdentity⟩
+  refine ⟨?_, assoc, rightIdentity⟩
+  intro VS h
+  cases VS with
+  | «.ValSeq_MPY-CORE_ValSeq» => rfl
+  | «vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest =>
+      simp [Proof.«_<=Int_», operationalVsLen] at h
+      have nonnegative := operationalVsLenNonnegative rest
+      have positive : (0 : Int) < operationalVsLen rest + 1 := by omega
+      exact (Int.not_le_of_gt positive h).elim
