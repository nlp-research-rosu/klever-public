 'lean_workspace_sha256':sha256_tree(Path('/candidate')),
}
for name,observed in checks.items():
 expected=ai['hashes'][name]
 print(f'{name}: expected={expected} observed={observed} match={expected==observed}')
expected_sources=ai['stage1_source_hashes']; root=Path('/reference/k-proof')
observed_sources={p.relative_to(root).as_posix():sha256_file(p) for p in _walk_regular_files(root,'Stage 1')}
