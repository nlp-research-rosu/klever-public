  decide (left ≤ right)

private def proofValSeqToList : SortValSeq → List SortVal
  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => []
  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest =>
      value :: proofValSeqToList rest

private def proofValSeqOfList : List SortVal → SortValSeq
  | [] => SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
  | value :: rest =>
      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
        value (proofValSeqOfList rest)

private def proofValSeqLength : SortValSeq → Nat
  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => 0
  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest =>
      Nat.succ (proofValSeqLength rest)

/- `buildVS(VS, 0, vsLen(VS), 3)`: retain indices 0, 3, 6, ... . -/
private def proofEveryThird : List SortVal → List SortVal
  | [] => []
  | first :: _ :: _ :: rest => first :: proofEveryThird rest
  | first :: _ => [first]

private def proofAllIntegerValues : List SortVal → Bool
  | [] => true
  | SortVal.inj_SortInt _ :: rest => proofAllIntegerValues rest
  | _ => false

/- The `insVS` equations from the frozen concrete `sortVS` table. The final
   arm totalizes inputs outside that table and is unreachable when called
   through `proofSortFrozenIntegers` on an all-integer sequence. -/
private def proofInsertFrozenInteger (value : SortVal) : List SortVal → List SortVal
  | [] => [value]
  | head :: tail =>
      match value, head with
      | SortVal.inj_SortInt valueInt, SortVal.inj_SortInt headInt =>
          if valueInt ≤ headInt then value :: head :: tail
          else head :: proofInsertFrozenInteger value tail
      | _, _ => value :: head :: tail

private def proofInsertionSortFrozenIntegers : List SortVal → List SortVal
  | [] => []
  | value :: rest =>
      proofInsertFrozenInteger value (proofInsertionSortFrozenIntegers rest)

/- `sortVS` remains uninterpreted on symbolic sequences and has concrete equations for
   homogeneous integer sequences in the frozen semantics. This implements
   those equations exactly and gives a stable total extension elsewhere. -/
private def proofSortFrozenIntegers (values : List SortVal) : List SortVal :=
  match proofAllIntegerValues values with
  | true => proofInsertionSortFrozenIntegers values
  | false => values

/- `mergeThirdFrom` at I = 0: consume one sorted selected value for the first
   element of each three-element chunk and preserve the other positions. -/
private def proofWeaveThird : List SortVal → List SortVal → List SortVal
