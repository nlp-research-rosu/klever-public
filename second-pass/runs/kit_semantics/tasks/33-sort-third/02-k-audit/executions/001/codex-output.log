/bin/bash -lc 'cp /audit-output/evidence/base-verification.k /audit-output/evidence/fixed-lemma-spec.k /tmp/audit-work/33-sort-third/ && python3 /audit-output/evidence/command_runner.py /audit-output/evidence/13-kompile-fixed-base.log kompile --backend haskell base-verification.k --main-module BASE-VERIFICATION --syntax-module MPY-SYNTAX --output-definition fixed-base-kompiled' in /tmp/audit-work/33-sort-third
