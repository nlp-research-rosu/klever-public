new file mode 100644
index 0000000000000000000000000000000000000000..57d6008663b5c00761d8ec0d815f8d2d03d53b62
--- /dev/null
+++ b/evidence/k_concrete_test.py
@@ -0,0 +1,25 @@
+def sort_third(l: list):
+    thirds = sorted(l[::3])
+    result = []
+    i = 0
+    while i < len(l):
+        if i % 3 == 0:
+            result.append(thirds[i // 3])
+        else:
+            result.append(l[i])
+        i += 1
+    return result
+
+
+assert sort_third([]) == []
+assert sort_third([1]) == [1]
+assert sort_third([2, 1]) == [2, 1]
+assert sort_third([1, 2, 3]) == [1, 2, 3]
+assert sort_third([9, 8, 7, 6]) == [6, 8, 7, 9]
+assert sort_third([5, 6, 3, 4, 8, 9, 2]) == [2, 6, 3, 4, 8, 9, 5]
+assert sort_third([8, -1, 7, 6, 5, 4, 3, 2, 1, 0]) == [
+    0, -1, 7, 3, 5, 4, 6, 2, 1, 8
+]
+assert sort_third(["z", "keep", "also", "a"]) == [
+    "a", "keep", "also", "z"
+]
