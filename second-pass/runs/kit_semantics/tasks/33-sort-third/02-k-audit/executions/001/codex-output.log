     2	// Int cases of the operator dispatch; Python // and % are floored (pyMod).
     3	
     4	module MPY-INT
     5	  imports MPY-CORE
     6	
     7	  rule applyUn("-", I:Int) => 0 -Int I
     8	
     9	  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
    10	  // Bool participates in int arithmetic (x += (a == b))
    11	  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
    12	  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
    13	  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
    14	  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
    15	  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
    16	  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
    17	  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
    18	
    19	  syntax Int ::= pyMod(Int, Int) [function]
    20	  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
    21	
    22	  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
    23	  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
    24	  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
    25	  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
    26	  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
    27	  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
    28	endmodule
     1	// reference/src/semantics/bool.k — MPY-BOOL
     2	// Bool operator cases + the truthy boolean operations (not / and / or; and-or are
     3	// value-returning short-circuit over any Vals, per Python).
     4	
     5	module MPY-BOOL
     6	  imports MPY-CORE
     7	
     8	  rule applyUn("not", V:Val) => notBool truthy(V)
     9	
    10	  rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
    11	  rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2
    12	
    13	  // ==== BoolOp: short-circuit, value-returning and / or =====================
    14	  // the node is its own accumulator: heat the HEAD element only, then either return it
    15	  // (short-circuit) or drop it and continue
    16	  context BoolOp(_, (HOLE:Expr, _:Exprs))
    17	  rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
    18	  rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    19	       requires truthy(V)
    20	  rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
    21	       requires notBool truthy(V)
    22	  rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
    23	       requires truthy(V)
    24	  rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    25	       requires notBool truthy(V)
    26	
    27	  // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
    28	  // operand — and/or return the OBJECT itself (Python identity), not its structure
    29	  rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
    30	       [priority(40)]
    31	  rule <k> BoolOp("and", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       requires truthy(V)
    34	       [priority(40)]
    35	  rule <k> BoolOp("and", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    36	       <heap> ... H |-> V:Val ... </heap>
    37	       requires notBool truthy(V)
    38	       [priority(40)]
    39	  rule <k> BoolOp("or", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    40	       <heap> ... H |-> V:Val ... </heap>
    41	       requires truthy(V)
    42	       [priority(40)]
    43	  rule <k> BoolOp("or", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    44	       <heap> ... H |-> V:Val ... </heap>
    45	       requires notBool truthy(V)
    46	       [priority(40)]
    47	endmodule
     1	// reference/src/semantics/list.k — MPY-LIST
     2	
     3	module MPY-LIST
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-OPERATORS
     7	
     8	  // ==== iteration (the iterator protocol's list case) =======================
     9	  rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>
    10	  rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>
    11	
    12	  // ==== ListExpr: [...] literal -> a fresh heap object =======================
    13	  syntax ApplyK ::= "toList"
    14	  rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>
    15	  rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>
    16	
    17	  // ==== list ops: + / == / != ===============================================
    18	  syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]
    19	  rule valSeqConcat(.ValSeq, T:ValSeq)                => T
    20	  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))
    21	
    22	  // list + list constructs a NEW object (k-cell — it allocates; operands land here
    23	  // already deref'd). priority(45) beats the generic BinOp dispatch.
    24	  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
    25	       [priority(45)]
    26	
    27	  rule applyCmp("==", list(A:ValSeq), list(B:ValSeq)) => A ==K B
    28	  rule applyCmp("!=", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== deep equality when elements are heap objects (list-of-lists) ========
    31	  // Python == is structural at every depth. Fires ONLY when a ref is present
    32	  // (the guard decides on concrete seqs); the plain ==K path above is unchanged.
    33	  syntax Bool ::= hasRefVS(ValSeq) [function, total]
    34	  rule hasRefVS(.ValSeq)                => false
    35	  rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)
    36	
    37	  syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]
    38	                | deepEqV(Val, Val, Map)        [function]
    39	  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true
    40	  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false
    41	  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false
    42	  rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)
    43	    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)
    44	
    45	  rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)
    46	       requires H in_keys(HP)
    47	  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
    48	       requires notBool isRefV(A) andBool H in_keys(HP)
    49	  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)
    50	  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]
    51	
    52	  // ==== mutator: xs.append(v) — an in-place heap write ======================
    53	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
    54	       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
    55	       [priority(40)]
    56	
    57	  // ==== `x in list` — a <k>-cell fold over #iterNext ========================
    58	  syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | "#notB"
    59	  rule <k> Compare(LV:Val, CmpOp("in",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>
    60	  rule <k> Compare(LV:Val, CmpOp("not in", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>
    61	  rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>
    62	  rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>
    63	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    64	       requires E ==K V
    65	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    66	       requires notBool (E ==K V)
    67	  rule <k> B:Bool ~> #notB => notBool B ... </k>
    68	endmodule
     1	// reference/src/semantics/subscript.k — MPY-SUBSCRIPT
     2	
     3	module MPY-SUBSCRIPT
     4	  imports MPY-CORE
     5	
     6	  // ==== positional access + negative-index normalization (used only here) ===
     7	  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
     8	  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
     9	  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
    10	  // atK. K trusts the [total] annotation; valid programs index in-bounds.
    11	  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
    12	  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
    13	  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
    14	       requires I >Int 0
    15	
    16	  syntax Int ::= intSeqAt(IntSeq, Int) [function]
    17	  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C
    18	  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
    19	       requires I >Int 0
    20	
    21	  syntax Int ::= normIdx(Int, Int) [function, total]
    22	  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
    23	  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0
    24	
    25	  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================
    26	  // contexts (not strict attrs): the Index slot's Slice alternative must never heat
    27	  context Subscript(HOLE, _)
    28	  context Subscript(_:Val, HOLE:Expr)
    29	
    30	  // heap-object deref (covers both the index and slice forms via the Index slot)
    31	  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       [priority(40)]
    34	
    35	  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>
    36	
    37	  syntax Val ::= applyIndex(Val, Int) [function]
    38	  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    39	  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    40	  rule applyIndex(str(IS:IntSeq),   I:Int)
    41	    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))
    42	
    43	  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
    44	  syntax KItem ::= #evalB(Bound) | "#toSome"
    45	                 | #slLo(Val, Bound, Bound)
    46	                 | #slHi(Val, OptInt, Bound)
    47	                 | #slStep(Val, OptInt, OptInt)
    48	
    49	  syntax OptInt ::= "noB" | someB(Int)
    50	  rule <k> #evalB(NoBound)  => noB ... </k>
    51	  rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>
    52	  rule <k> I:Int ~> #toSome => someB(I) ... </k>
    53	
    54	  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>
    55	  rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>
    56	  rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>
    57	  // a list slice constructs a NEW object; a str slice stays a value
    58	  rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)
    59	        => #alloc(doSlice(list(VS), LO, HI, ST)) ... </k>
    60	       [priority(45)]
    61	  rule <k> ST:OptInt ~> #slStep(OBJ:Val, LO:OptInt, HI:OptInt) => doSlice(OBJ, LO, HI, ST) ... </k>
    62	
    63	  syntax Val ::= doSlice(Val, OptInt, OptInt, OptInt) [function]
    64	  rule doSlice(list(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    65	    => list(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
    66	  rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    67	    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
    68	  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    69	    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))
    70	
    71	  // ==== slice.indices: step / start / stop / clamp ==========================
    72	  syntax Int ::= slStep(OptInt) [function, total]
    73	  rule slStep(noB)          => 1
    74	  rule slStep(someB(S:Int)) => S
    75	
    76	  syntax Int ::= slStart(OptInt, OptInt, Int) [function]
    77	  rule slStart(noB,          ST:OptInt, _LEN:Int) => 0
    78	       requires slStep(ST) >Int 0
    79	  rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1
    80	       requires slStep(ST) <Int 0
    81	  rule slStart(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
    82	
    83	  syntax Int ::= slStop(OptInt, OptInt, Int) [function]
    84	  rule slStop(noB,          ST:OptInt, LEN:Int)  => LEN
    85	       requires slStep(ST) >Int 0
    86	  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
    87	       requires slStep(ST) <Int 0
    88	  rule slStop(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
    89	
    90	  syntax Int ::= slAdjust(Int, Int, Int) [function, total]
    91	  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampLo(I +Int LEN, STEP)
    92	       requires I  <Int 0
    93	  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampHi(I, LEN, STEP)
    94	       requires I >=Int 0
    95	
    96	  syntax Int ::= clampLo(Int, Int) [function, total]
    97	  rule clampLo(J:Int, _STEP:Int) => J
    98	       requires J >=Int 0
    99	  rule clampLo(J:Int, STEP:Int)  => #if STEP <Int 0 #then -1 #else 0 #fi
   100	       requires J <Int 0
   101	
   102	  syntax Int ::= clampHi(Int, Int, Int) [function, total]
   103	  rule clampHi(I:Int, LEN:Int, _STEP:Int) => I
   104	       requires I  <Int LEN
   105	  rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi
   106	       requires I >=Int LEN
   107	
   108	  // ==== build the strided sub-sequence (indices in range by construction) ====
   109	  syntax ValSeq ::= buildVS(ValSeq, Int, Int, Int) [function]
   110	  rule buildVS(VS:ValSeq, I:Int, STOP:Int, STEP:Int)
   111	    => vCons(valSeqAt(VS, I), buildVS(VS, I +Int STEP, STOP, STEP))
   112	       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
   113	  rule buildVS(_:ValSeq, I:Int, STOP:Int, STEP:Int) => .ValSeq
   114	       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
   115	
   116	  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]
   117	  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
   118	    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
   119	       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
   120	  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
   121	       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
   122	endmodule
     1	// reference/src/semantics/sort.k — MPY-SORT
     2	// Trusted sorted(): sorted(list) as an opaque ascending permutation `sortVS` — opaque symbolic
     3	// for kprove (a trusted primitive, correctness/ordering proved in Lean / notes/sort-probe),
     4	// and a concrete insertion sort for krun. Wrappers verify the logic AROUND the sort (index /
     5	// slice / filter / dedup); indexing an opaque sortVS(VS) carries through as an opaque term, so
     6	// no ordering lemma is needed in K — the trust (sortVS = real sorted) is discharged by each
     7	// problem's differential test. Only int lists (compared by projectIntTotal); keyed / string
     8	// sorts are separate. Fires only via the "sorted" builtin, so inert for non-sorting programs.
     9	
    10	module MPY-SORT
    11	  imports MPY-BUILTINS
    12	  imports MPY-SUBSCRIPT
    13	
    14	  // sortVS(VS): the ascending sort of the Val list VS. Opaque for symbolic VS (no-evaluators);
    15	  // concrete insertion sort for krun.
    16	  // Concrete sort matches Int-sorted elements directly (an int Val IS an Int); projectIntTotal
    17	  // (lemmas-only) is not available in the semantics. Int and str lists.
    18	  syntax ValSeq ::= sortVS(ValSeq) [function, total, symbol(sortVS), no-evaluators]
    19	  syntax ValSeq ::= insVS(Int, ValSeq) [function]
    20	  rule sortVS(.ValSeq)                => .ValSeq          [concrete]
    21	  rule sortVS(vCons(X:Int, R:ValSeq)) => insVS(X, sortVS(R)) [concrete]
    22	  rule insVS(X:Int, .ValSeq)                => vCons(X, .ValSeq) [concrete]
    23	  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(X, vCons(Y, R)) requires X <=Int Y [concrete]
    24	  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(Y, insVS(X, R)) requires X  >Int Y [concrete]
    25	  // str elements insert by the shared lexicographic strLt (methods.k)
    26	  syntax ValSeq ::= insVSs(IntSeq, ValSeq) [function]
    27	  rule sortVS(vCons(str(CS:IntSeq), R:ValSeq)) => insVSs(CS, sortVS(R)) [concrete]
    28	  rule insVSs(A:IntSeq, .ValSeq) => vCons(str(A), .ValSeq) [concrete]
    29	  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(A), vCons(str(B), R))
    30	       requires strLt(A, B) orBool A ==K B [concrete]
    31	  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))
    32	       requires notBool (strLt(A, B) orBool A ==K B) [concrete]
    33	
    34	  // sorted(list) constructs a NEW object: k-cell pre-dispatch (beats the [owise]
    35	  // applyBuiltin routing in call.k) so the result allocates.
    36	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), .Vals))
    37	        => #alloc(list(sortVS(VS))) ... </k>
    38	
    39	  // mutator: xs.sort() — the in-place heap write over the same trusted sortVS
    40	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "sort")), .Vals) => noneV ... </k>
    41	       <heap> ... H |-> list(VS:ValSeq => sortVS(VS)) ... </heap>
    42	       [priority(40)]
    43	
    44	  // ==== keyed / reversed sorted() (WP2) =====================================
    45	  // sortKeyVS(VS, KV): the stable ascending sort of VS by the key value KV
    46	  // (a closure/builtin/type — anything callable). OPAQUE here; the concrete
    47	  // leg (MPY-CONCRETE, llvm only) computes keys by REAL calls and stable-
    48	  // inserts, at priority(40) over these.
    49	  syntax ValSeq ::= sortKeyVS(ValSeq, Val) [function, total, symbol(sortKeyVS), no-evaluators]
    50	
    51	  syntax ValSeq ::= revVS(ValSeq) [function, total]
    52	                  | revVSAcc(ValSeq, ValSeq) [function, total]
    53	  rule revVS(S:ValSeq) => revVSAcc(S, .ValSeq)
    54	  rule revVSAcc(.ValSeq, A:ValSeq) => A
    55	  rule revVSAcc(vCons(V:Val, R:ValSeq), A:ValSeq) => revVSAcc(R, vCons(V, A))
    56	
    57	  syntax ValSeq ::= condRev(ValSeq, Bool) [function, total]
    58	  rule condRev(S:ValSeq, false) => S
    59	  rule condRev(S:ValSeq, true)  => revVS(S)
    60	
    61	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    62	        => #alloc(list(sortKeyVS(VS, KV))) ... </k>
    63	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    64	        => #alloc(list(condRev(sortKeyVS(VS, KV), RB))) ... </k>
    65	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("reverse", RB:Bool), .Vals))
    66	        => #alloc(list(condRev(sortVS(VS), RB))) ... </k>
    67	
    68	  // Indexing the opaque sorted list: `valSeqAt(sortVS(VS), I)` is DEFINED because valSeqAt is
    69	  // [total] (subscript.k) — it stays an abstract total value for a symbolic sort and reduces
    70	  // over the concrete sort for krun. No separate sortedAt indirection is needed; wrappers write
    71	  // their postcondition directly as valSeqAt(sortVS(VS), …).
    72	endmodule
     1	// reference/src/semantics/assert.k — MPY-ASSERT
     2	
     3	module MPY-ASSERT
     4	  imports MPY-CORE
     5	
     6	  rule <k> Assert(V:Val) => .K ... </k>
     7	       requires truthy(V)
     8	  rule <k> Assert(V:Val) ~> _ => .K </k>
     9	       <exc> NoExc => AssertionError </exc>
    10	       <exit-code> _ => 1 </exit-code>
    11	       requires notBool truthy(V)
    12	
    13	  rule <k> Assert(ref(H:Int)) => Assert(V) ... </k>
    14	       <heap> ... H |-> V:Val ... </heap>
    15	       [priority(40)]
    16	endmodule
     1	// reference/src/semantics/concrete.k — MPY-CONCRETE
     2	// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
     3	// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
     4	// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
     5	// backend ([concrete] is not respected on rewrite rules) — probed on
     6	// 26-remove-duplicates, where element compares branched into deepEqVS.
     7	
     8	module MPY-CONCRETE
     9	  imports MPY
    10	
    11	  // deep equality for list compares whose elements are heap objects
    12	  // (list-of-lists): Python == is structural at every depth.
    13	  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
    14	       <heap> HP:Map </heap>
    15	       requires hasRefVS(A) orBool hasRefVS(B)
    16	  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
    17	       <heap> HP:Map </heap>
    18	       requires hasRefVS(A) orBool hasRefVS(B)
    19	
    20	  // ==== keyed sort, concrete leg ============================================
    21	  // Computes each key by a REAL call through the uniform #callee machinery
    22	  // (closures, len, type objects all work), stable-inserts on the key, and
    23	  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
    24	  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
    25	  syntax Val ::= kvP(Val, Val)
    26	  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
    27	                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
    28	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    29	        => #ksort(VS, KV, .ValSeq, false) ... </k>
    30	       [priority(40)]
    31	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    32	        => #ksort(VS, KV, .ValSeq, RB) ... </k>
    33	       [priority(40)]
    34	  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
    35	        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
    36	  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
    37	        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
    38	  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
    39	        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
    40	       requires notBool isKwV(K)
    41	
    42	  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
    43	  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
    44	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    45	    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
    46	       requires kLt(K, K2)
    47	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    48	    => vCons(kvP(K2, V2), insPair(R, K, V))
    49	       requires notBool kLt(K, K2)
    50	
    51	  syntax Bool ::= kLt(Val, Val) [function]
    52	  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
    53	  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
    54	  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    55	
    56	  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
    57	  rule unpairVS(.ValSeq) => .ValSeq
    58	  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
    59	  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
    60	endmodule

diff --git a/evidence/command_runner.py b/evidence/command_runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..f2bc8d7da3eae436832425ba397409da593666b4
--- /dev/null
+++ b/evidence/command_runner.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Run one command and preserve a bounded, auditable combined-output log."""
+
+from __future__ import annotations
+
+import datetime
+import pathlib
+import shlex
+import subprocess
+import sys
+
+
+def main() -> int:
+    if len(sys.argv) < 3:
+        print("usage: command_runner.py LOG COMMAND [ARG ...]", file=sys.stderr)
+        return 2
+
+    log_path = pathlib.Path(sys.argv[1])
+    command = sys.argv[2:]
+    started = datetime.datetime.now(datetime.timezone.utc)
+    result = subprocess.run(
+        command,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+        errors="replace",
+    )
+    finished = datetime.datetime.now(datetime.timezone.utc)
+    output = result.stdout
+    max_chars = 200_000
+    if len(output) > max_chars:
+        half = max_chars // 2
+        output = (
+            output[:half]
+            + "\n...[bounded log: middle omitted]...\n"
+            + output[-half:]
+        )
+
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    log_path.write_text(
+        "\n".join(
+            [
+                f"START_UTC: {started.isoformat()}",
+                f"WORKDIR: {pathlib.Path.cwd()}",
+                "COMMAND: " + shlex.join(command),
+                f"EXIT_STATUS: {result.returncode}",
+                f"FINISH_UTC: {finished.isoformat()}",
+                "OUTPUT:",
+                output,
+            ]
+        ),
+        encoding="utf-8",
+    )
+    sys.stdout.write(output)
+    print(f"\n[exit {result.returncode}; log {log_path}]")
+    return result.returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/compare_program_kast.py b/evidence/compare_program_kast.py
new file mode 100644
index 0000000000000000000000000000000000000000..c755b7763c948ce29595cd98496c2442c77302b8
--- /dev/null
+++ b/evidence/compare_program_kast.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Compare the normalized K constructor trees for solution.mpy and entry claim."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import pathlib
+from collections import Counter
+
+
+SCRATCH = pathlib.Path("/tmp/audit-work/33-sort-third")
+translated = json.loads((SCRATCH / "translated-program.json").read_text())["term"]
+claimed_rewrite = json.loads((SCRATCH / "claimed-rule.json").read_text())["term"]
+assert claimed_rewrite["node"] == "KRewrite"
+claimed = claimed_rewrite["lhs"]
+
+
+def canonical_hash(term: object) -> str:
+    encoded = json.dumps(term, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def inventory(term: object, counts: Counter[str]) -> None:
+    if isinstance(term, dict):
+        if term.get("node") == "KApply":
+            counts[term["label"]["name"]] += 1
+        for value in term.values():
+            inventory(value, counts)
+    elif isinstance(term, list):
+        for value in term:
+            inventory(value, counts)
+
+
+translated_counts: Counter[str] = Counter()
+claimed_counts: Counter[str] = Counter()
+inventory(translated, translated_counts)
+inventory(claimed, claimed_counts)
+print(f"translated_sha256={canonical_hash(translated)}")
+print(f"claimed_sha256={canonical_hash(claimed)}")
+print(f"constructor_tree_exact_equal={translated == claimed}")
+print(f"translated_kapply_nodes={sum(translated_counts.values())}")
+print(f"claimed_kapply_nodes={sum(claimed_counts.values())}")
+print(f"constructor_label_inventory_equal={translated_counts == claimed_counts}")
+if translated != claimed:
+    raise SystemExit(1)
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..9ea9677cbc927c43647d739401d7693bbeab52bb
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Independent canonical-vs-candidate differential test for HumanEval/33."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import pathlib
+import random
+
+
+SCRATCH = pathlib.Path("/tmp/audit-work/33-sort-third")
+
+
+def load_function(module_name: str, path: pathlib.Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.sort_third
+
+
+canonical = load_function("trusted_canonical", SCRATCH / "canonical.py")
+candidate = load_function("generated_solution", SCRATCH / "solution.py")
+
+documented_and_boundaries = [
+    [1, 2, 3],
+    [5, 6, 3, 4, 8, 9, 2],
+    [],
+    [1],
+    [2, 1],
+    [3, 2, 1],
+    [9, 8, 7, 6],
+    [9, 8, 7, 6, 5],
+    [9, 8, 7, 6, 5, 4],
+    [9, 8, 7, 6, 5, 4, 3],
+    [4, 0, 0, 3, 0, 0, 2, 0, 0, 1],
+    [-1, 2, -3, -4, 5, -6, -7],
+    [3, 3, 3, 1, 1, 1, 2, 2, 2, 0],
+    [True, 8, 7, False, 5, 4, True],
+    [3.5, 2.0, -7.5, -2.25, 0.0, 10.5, 1.125],
+    list(""),
+    list("a"),
+    list("sortthird"),
+    list("zyxwvutsrqpon"),
+]
+
+cases: list[list[object]] = list(documented_and_boundaries)
+for length in range(7):
+    cases.extend(
+        list(values)
+        for values in itertools.product(range(-2, 3), repeat=length)
+    )
+for length in range(6):
+    cases.extend(
+        list(values)
+        for values in itertools.product("abc", repeat=length)
+    )
+
+rng = random.Random(330072026)
+for _ in range(2_000):
+    length = rng.randrange(0, 101)
+    cases.append([rng.randint(-10_000, 10_000) for _ in range(length)])
+
+mismatches = []
+mutations = []
+for index, source in enumerate(cases):
+    before = list(source)
+    try:
+        expected = ("return", canonical(source))
+    except Exception as error:  # Included to compare normal/exceptional behavior.
+        expected = ("raise", type(error), str(error))
+    if source != before:
+        mutations.append(("canonical", index, before, source))
+    source[:] = before
+    try:
+        actual = ("return", candidate(source))
+    except Exception as error:
+        actual = ("raise", type(error), str(error))
+    if source != before:
+        mutations.append(("candidate", index, before, source))
+    if actual != expected:
+        mismatches.append((index, before, expected, actual))
+
+print(f"documented_and_boundary_cases={len(documented_and_boundaries)}")
+print("exhaustive_integer_lengths=0..6 values=-2..2")
+print("exhaustive_string_lengths=0..5 alphabet=abc")
+print("random_integer_cases=2000 lengths=0..100 seed=330072026")
+print(f"total_cases={len(cases)}")
+print(f"input_mutations={len(mutations)}")
+print(f"mismatches={len(mismatches)}")
+if mutations:
+    print(f"first_mutation={mutations[0]!r}")
+if mismatches:
+    print(f"first_mismatch={mismatches[0]!r}")
+raise SystemExit(1 if mutations or mismatches else 0)
diff --git a/evidence/extract_claim_program.py b/evidence/extract_claim_program.py
new file mode 100644
index 0000000000000000000000000000000000000000..c1f9e455757cf4f1db3f76817af6b7f0f418042e
--- /dev/null
+++ b/evidence/extract_claim_program.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Extract the first Module(...) term executed under #loadAll in SPEC.sort-third."""
+
+from __future__ import annotations
+
+import pathlib
+
+
+SPEC = pathlib.Path("/tmp/audit-work/33-sort-third/spec.k")
+OUTPUT = pathlib.Path("/tmp/audit-work/33-sort-third/claimed-program.mpy")
+RULE_OUTPUT = pathlib.Path("/tmp/audit-work/33-sort-third/claimed-program.rule")
+
+
+text = SPEC.read_text(encoding="utf-8")
+load_start = text.index("#loadAll(")
+start = text.index("Module(", load_start)
+depth = 0
+quote = False
+escaped = False
+end = None
+for index in range(start, len(text)):
+    character = text[index]
+    if quote:
+        if escaped:
+            escaped = False
+        elif character == "\\":
+            escaped = True
+        elif character == '"':
+            quote = False
+        continue
+    if character == '"':
+        quote = True
+    elif character == "(":
+        depth += 1
+    elif character == ")":
+        depth -= 1
+        if depth == 0:
+            end = index + 1
+            break
+
+assert end is not None
+program = text[start:end] + "\n"
+OUTPUT.write_text(program, encoding="utf-8")
+RULE_OUTPUT.write_text(f"{program.strip()} => {program.strip()}\n", encoding="utf-8")
+print(f"source={SPEC}")
+print(f"start_offset={start}")
+print(f"end_offset={end}")
+print(f"output={OUTPUT}")
+print(f"rule_output={RULE_OUTPUT}")
+print(f"characters={len(program)}")
diff --git a/evidence/integrity_check.py b/evidence/integrity_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..0289495e61f914fb53a27c5a0c2294c6ad31c191
--- /dev/null
+++ b/evidence/integrity_check.py
@@ -0,0 +1,279 @@
+#!/usr/bin/env python3
+"""Independent launcher-record and mounted-input integrity checks."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import pathlib
+import sys
+from collections import Counter
+
+
+AUDIT = pathlib.Path("/audit-input.json")
+LOCK = pathlib.Path("/audit-campaign-lock.json")
+
+
+def sha256_file(path: pathlib.Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def tree_manifest(root: pathlib.Path) -> tuple[str, int, int, int]:
+    records: list[str] = []
+    files = directories = symlinks = 0
+    for path in sorted(root.rglob("*"), key=lambda item: item.as_posix()):
+        relative = path.relative_to(root).as_posix()
+        if path.is_symlink():
+            symlinks += 1
+            records.append(f"L\0{relative}\0{os.readlink(path)}\n")
+        elif path.is_dir():
+            directories += 1
+            records.append(f"D\0{relative}\n")
+        elif path.is_file():
+            files += 1
+            records.append(f"F\0{relative}\0{sha256_file(path)}\n")
+        else:
+            records.append(f"O\0{relative}\0{path.stat().st_mode:o}\n")
+    digest = hashlib.sha256("".join(records).encode()).hexdigest()
+    return digest, files, directories, symlinks
+
+
+def compare_trees(left: pathlib.Path, right: pathlib.Path) -> list[str]:
+    problems: list[str] = []
+    left_paths = {
+        path.relative_to(left).as_posix(): path for path in left.rglob("*")
+    }
+    right_paths = {
+        path.relative_to(right).as_posix(): path for path in right.rglob("*")
+    }
+    for relative in sorted(left_paths.keys() | right_paths.keys()):
+        lpath = left_paths.get(relative)
+        rpath = right_paths.get(relative)
+        if lpath is None:
+            problems.append(f"missing candidate entry: {relative}")
+            continue
+        if rpath is None:
+            problems.append(f"additional candidate entry: {relative}")
+            continue
+        ltype = (
+            "symlink"
+            if lpath.is_symlink()
+            else "dir"
+            if lpath.is_dir()
+            else "file"
+            if lpath.is_file()
+            else "other"
+        )
+        rtype = (
+            "symlink"
+            if rpath.is_symlink()
+            else "dir"
+            if rpath.is_dir()
+            else "file"
+            if rpath.is_file()
+            else "other"
+        )
+        if ltype != rtype:
+            problems.append(
+                f"type mismatch {relative}: candidate={ltype}, trusted={rtype}"
+            )
+        elif ltype == "symlink":
+            problems.append(f"symlink entry forbidden: {relative}")
+        elif ltype == "file" and sha256_file(lpath) != sha256_file(rpath):
+            problems.append(f"content mismatch: {relative}")
+    return problems
+
+
+def regular_readable(path: pathlib.Path) -> bool:
+    return (
+        path.exists()
+        and path.is_file()
+        and not path.is_symlink()
+        and os.access(path, os.R_OK)
+    )
+
+
+def main() -> int:
+    failures: list[str] = []
+    audit = json.loads(AUDIT.read_text())
+    lock = json.loads(LOCK.read_text())
+
+    print(f"record_layout={audit.get('record_layout')}")
+    print(f"semantics_mode={audit.get('semantics_mode')}")
+    print(f"problem_id={audit.get('problem_id')}")
+    if audit.get("record_layout") != "pipeline-v3":
+        failures.append("declared layout is not pipeline-v3")
+    if audit.get("semantics_mode") != "SUPPLIED_SEMANTICS":
+        failures.append("declared semantics mode is not SUPPLIED_SEMANTICS")
+    if lock != audit.get("audit_campaign"):
+        failures.append("campaign lock content does not match audit_campaign block")
+    print(f"campaign_block_exact_match={lock == audit.get('audit_campaign')}")
+
+    required = [
+        pathlib.Path("/audit-input.json"),
+        pathlib.Path("/audit-campaign-lock.json"),
+        pathlib.Path("/run.json"),
+        pathlib.Path("/task.json"),
+        pathlib.Path("/generation-result.json"),
+        pathlib.Path("/generation-evidence/invocation.json"),
+        pathlib.Path("/generation-evidence/metrics.json"),
+        pathlib.Path("/generation-evidence/runtime-metrics.json"),
+        pathlib.Path("/generation-evidence/usage.json"),
+        pathlib.Path("/generation-evidence/codex-last.txt"),
+        pathlib.Path("/generation-evidence/codex-output.log"),
+        pathlib.Path("/generation-evidence/prompt.txt"),
+        pathlib.Path("/reference/canonical.py"),
+        pathlib.Path("/reference/prompt.py"),
+        pathlib.Path("/reference/py2mpy.py"),
+    ]
+    for path in required:
+        ok = regular_readable(path)
+        print(f"required_regular_readable {path}: {ok}")
+        if not ok:
+            failures.append(f"missing, unreadable, non-regular, or symlinked: {path}")
+
+    for key, raw_path in audit.get("container_paths", {}).items():
+        path = pathlib.Path(raw_path)
+        ok = path.exists() and not path.is_symlink() and os.access(path, os.R_OK)
+        print(f"container_path {key} {path}: {ok}")
+        if not ok:
+            failures.append(f"launcher-declared mount unavailable: {key}={path}")
+
+    direct_hashes = {
+        "audit_campaign_lock_sha256": pathlib.Path("/audit-campaign-lock.json"),
+        "canonical_sha256": pathlib.Path("/reference/canonical.py"),
+        "trusted_prompt_sha256": pathlib.Path("/reference/prompt.py"),
+        "candidate_prompt_sha256": pathlib.Path("/candidate/prompt.py"),
+        "trusted_translator_sha256": pathlib.Path("/reference/py2mpy.py"),
+        "candidate_translator_sha256": pathlib.Path("/candidate/py2mpy.py"),
+        "generation_codex_last_sha256": pathlib.Path(
+            "/generation-evidence/codex-last.txt"
+        ),
+        "generation_codex_output_sha256": pathlib.Path(
+            "/generation-evidence/codex-output.log"
+        ),
+        "generation_metrics_sha256": pathlib.Path(
+            "/generation-evidence/metrics.json"
+        ),
+        "generation_prompt_sha256": pathlib.Path(
+            "/generation-evidence/prompt.txt"
+        ),
+        "generation_runtime_metrics_sha256": pathlib.Path(
+            "/generation-evidence/runtime-metrics.json"
+        ),
+        "generation_usage_sha256": pathlib.Path(
+            "/generation-evidence/usage.json"
+        ),
+        "manifest_sha256": pathlib.Path("/task.json"),
+        "run_manifest_sha256": pathlib.Path("/run.json"),
+        "stage1_invocation_sha256": pathlib.Path(
+            "/generation-evidence/invocation.json"
+        ),
+        "stage1_result_sha256": pathlib.Path("/generation-result.json"),
+        "task_manifest_sha256": pathlib.Path("/task.json"),
+    }
+    for key, path in direct_hashes.items():
+        actual = sha256_file(path)
+        expected = audit["hashes"].get(key)
+        match = actual == expected
+        print(f"recorded_hash {key}: match={match} actual={actual}")
+        if not match:
+            failures.append(f"recorded hash mismatch: {key}")
+
+    if pathlib.Path("/candidate/prompt.py").read_bytes() != pathlib.Path(
+        "/reference/prompt.py"
+    ).read_bytes():
+        failures.append("candidate prompt differs from trusted prompt")
+    if pathlib.Path("/candidate/py2mpy.py").read_bytes() != pathlib.Path(
+        "/reference/py2mpy.py"
+    ).read_bytes():
+        failures.append("candidate translator differs from trusted translator")
+    print(
+        "candidate_prompt_byte_equal_trusted="
+        + str(
+            pathlib.Path("/candidate/prompt.py").read_bytes()
+            == pathlib.Path("/reference/prompt.py").read_bytes()
+        )
+    )
+    print(
+        "candidate_translator_byte_equal_trusted="
+        + str(
+            pathlib.Path("/candidate/py2mpy.py").read_bytes()
+            == pathlib.Path("/reference/py2mpy.py").read_bytes()
+        )
+    )
+
+    trusted_semantics = pathlib.Path("/reference/reference-semantics")
+    candidate_semantics = pathlib.Path("/candidate/reference-semantics")
+    if not trusted_semantics.is_dir() or trusted_semantics.is_symlink():
+        failures.append("trusted supplied-semantics tree absent or symlinked")
+    if not candidate_semantics.is_dir() or candidate_semantics.is_symlink():
+        failures.append("candidate supplied-semantics tree absent or symlinked")
+    semantics_problems = compare_trees(candidate_semantics, trusted_semantics)
+    print(f"semantics_recursive_problem_count={len(semantics_problems)}")
+    for problem in semantics_problems:
+        print(f"semantics_problem={problem}")
+    failures.extend(semantics_problems)
+
+    for name, root in [
+        ("candidate", pathlib.Path("/candidate")),
+        ("candidate_reference_semantics", candidate_semantics),
+        ("trusted_reference_semantics", trusted_semantics),
+        ("generation_trace", pathlib.Path("/generation-evidence/codex-trace")),
+    ]:
+        digest, files, directories, symlinks = tree_manifest(root)
+        print(
+            f"independent_tree_manifest {name}: sha256={digest} "
+            f"files={files} dirs={directories} symlinks={symlinks}"
+        )
+
+    result = json.loads(pathlib.Path("/generation-result.json").read_text())
+    evidence_hashes = result["outputs"]["evidence"]
+    for relative, expected in sorted(evidence_hashes.items()):
+        path = pathlib.Path("/generation-evidence") / relative
+        ok = regular_readable(path)
+        actual = sha256_file(path) if ok else "UNAVAILABLE"
+        match = ok and actual == expected
+        print(
+            f"generation_result_evidence_hash {relative}: "
+            f"match={match} actual={actual}"
+        )
+        if not match:
+            failures.append(f"generation-result evidence mismatch: {relative}")
+
+    trace_files = sorted(
+        pathlib.Path("/generation-evidence/codex-trace").rglob("*.jsonl")
+    )
+    if not trace_files:
+        failures.append("structured trace has no JSONL files")
+    event_counts: Counter[str] = Counter()
+    trace_lines = 0
+    for path in trace_files:
+        if path.is_symlink() or not path.is_file():
+            failures.append(f"invalid trace entry: {path}")
+            continue
+        with path.open(encoding="utf-8") as stream:
+            for number, line in enumerate(stream, 1):
+                trace_lines += 1
+                try:
+                    event = json.loads(line)
+                except json.JSONDecodeError as err:
+                    failures.append(f"malformed trace line {path}:{number}: {err}")
+                    continue
+                event_counts[str(event.get("type", "<missing>"))] += 1
+    print(f"trace_files={len(trace_files)} trace_lines={trace_lines}")
+    print(f"trace_event_types={dict(sorted(event_counts.items()))}")
+
+    print(f"FAILURE_COUNT={len(failures)}")
+    for failure in failures:
+        print(f"FAILURE={failure}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/evidence/k_concrete_test.py b/evidence/k_concrete_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..57d6008663b5c00761d8ec0d815f8d2d03d53b62
--- /dev/null
+++ b/evidence/k_concrete_test.py
@@ -0,0 +1,25 @@
+def sort_third(l: list):
+    thirds = sorted(l[::3])
+    result = []
+    i = 0
+    while i < len(l):
+        if i % 3 == 0:
+            result.append(thirds[i // 3])
+        else:
+            result.append(l[i])
+        i += 1
+    return result
+
+
+assert sort_third([]) == []
+assert sort_third([1]) == [1]
+assert sort_third([2, 1]) == [2, 1]
+assert sort_third([1, 2, 3]) == [1, 2, 3]
+assert sort_third([9, 8, 7, 6]) == [6, 8, 7, 9]
+assert sort_third([5, 6, 3, 4, 8, 9, 2]) == [2, 6, 3, 4, 8, 9, 5]
+assert sort_third([8, -1, 7, 6, 5, 4, 3, 2, 1, 0]) == [
+    0, -1, 7, 3, 5, 4, 6, 2, 1, 8
+]
+assert sort_third(["z", "keep", "also", "a"]) == [
+    "a", "keep", "also", "z"
+]
