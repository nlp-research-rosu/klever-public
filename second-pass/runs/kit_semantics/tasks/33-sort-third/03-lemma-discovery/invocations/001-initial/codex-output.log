+{
+  "schema_version": 2,
+  "inventory_sha256": "03cd112179c09fbd3bee367ec800153a9171a0e1d7bedcc3f7d88ed7d49ecc52",
+  "rules": [
+    {
+      "source_rule_id": "rule-ea80c64ba3e52dd72b25433dd6dd721d97e283355279ee9fc2a39f905f582faa",
+      "classification": "DEFINITION",
+      "rationale": "This is the terminating base equation of the mergeThirdFrom mathematical summary: once I is at or beyond N, the remaining output suffix is empty. It defines a proof term and does not execute or observe the Python model."
+    },
+    {
+      "source_rule_id": "rule-8eaaf331b2562006a2a6f4704a4b81a167862611d6c8b82d78a59369cb08a019",
+      "classification": "DEFINITION",
+      "rationale": "This is the divisible-by-three recurrence for mergeThirdFrom, defining the next summary element from the sorted third-position sequence and recurring at I + 1. It is a mathematical summary equation rather than an operational MPY rule."
+    },
+    {
+      "source_rule_id": "rule-4860445cf3432071a9a322001c5e3ce052bb80b75147a784f2df24a8fbba41ca",
+      "classification": "DEFINITION",
+      "rationale": "This is the complementary recurrence for mergeThirdFrom, defining a non-third position from the original sequence and recurring at I + 1. Together with the other guarded cases it defines the summary and does not replace source execution."
+    },
+    {
+      "source_rule_id": "rule-0855e7c5303f3b1835ec56db22a573c2fc2903b161c139dd7b0ff4a1d1ee9ed0",
+      "classification": "DEFINITION",
+      "rationale": "This simplification rule introduces sortThirdResult as a folding name for the exact complete mergeThirdFrom term. Its orientation is solver-facing, but its role is definitional abbreviation of a named proof summary."
+    },
+    {
+      "source_rule_id": "rule-684bef72ba46103ebf75024cdc1fa13051bb1bec81e5c3ebfd659638388ad8f2",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This simplifier asserts the zero-length consequence for the already defined sortThirdResult summary. Stage 1 uses the rule in the compiled verification theory and provides no earlier kprove of this exact guarded statement against a module omitting it, so it is an additional trusted mathematical fact rather than a proved derived lemma."
+    },
+    {
+      "source_rule_id": "rule-a1197a694d8ff7aa6e41e81faf447c740a45b12fc2bad596cbef040446551918",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This is list-concatenation associativity, a reusable mathematical fact about the pre-existing valSeqConcat function. Although Stage 1 describes a structural-induction justification, prove.sh compiles this simplification rule before all proofs and contains no separate proof of the exact equation without the rule."
+    },
+    {
+      "source_rule_id": "rule-d101e72bc8dee6c43ac06d55f47939cef9e5ae630efb965cc680c40d10bb36f9",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This is the right-identity law for the pre-existing valSeqConcat function. Its comment calls it derived by structural induction, but Stage 1 does not first prove the exact statement in a module that omits the simplifier, so the finalized K proof trusts it as a domain lemma."
+    }
+  ]
+}

