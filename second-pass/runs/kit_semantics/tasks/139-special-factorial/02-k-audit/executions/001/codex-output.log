diff --git a/evidence/04_constructor_compare.py b/evidence/04_constructor_compare.py
new file mode 100644
index 0000000000000000000000000000000000000000..2b759fad05681b4712326d20e84caa3e3bc8a4c1
--- /dev/null
+++ b/evidence/04_constructor_compare.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+"""Mechanical constructor-level pinning check for the entry claim."""
+
+import pathlib
+import re
+import sys
+
+
+def squash(text: str) -> str:
+    return re.sub(r"\s+", "", text)
+
+
+mpy = squash(pathlib.Path("/tmp/audit-work/reconstruction/solution.mpy").read_text())
+spec = squash(pathlib.Path("/tmp/audit-work/reconstruction/spec.k").read_text())
+
+loaded_program = "#loadAll(" + mpy + ")"
+call = 'Call(Name("special_factorial"),(N:Int,.Exprs))'
+checks = {
+    "exact_translated_module_loaded": loaded_program in spec,
+    "exact_entry_binding_called": call in spec,
+    "positive_unbounded_int_precondition": "requiresN>=Int1" in spec,
+    "result_constrained_by_recurrence": "=>productAfter(1,N,1,1)" in spec,
+}
+
+print(f"normalized_solution_mpy={mpy}")
+print(f"exact_loaded_program_occurrences={spec.count(loaded_program)}")
+for name, result in checks.items():
+    print(f"{name}={result}")
+
+sys.exit(0 if all(checks.values()) and spec.count(loaded_program) == 1 else 1)
diff --git a/evidence/04_witnesses.k b/evidence/04_witnesses.k
new file mode 100644
index 0000000000000000000000000000000000000000..c60990f9d846ff28723a3e1a5f285a0759e79cc4
--- /dev/null
+++ b/evidence/04_witnesses.k
@@ -0,0 +1,83 @@
+requires "verification.k"
+
+module AUDIT-WITNESSES
+  imports VERIFICATION
+
+  // A concrete state satisfying the loop claim's precondition:
+  // N=4, I=1, F=1, R=1, L=1.
+  claim [loop-precondition-witness-n4]:
+    <k>
+      #while(Compare(Name("i"), CmpOp("<=", Name("n"))),
+        Assign(
+          Name("factorial"),
+          BinOp("*", Name("factorial"), Name("i")))
+        Assign(
+          Name("result"),
+          BinOp("*", Name("result"), Name("factorial")))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |-> scope(
+        "n"         |-> 4
+        "factorial" |-> (1 => 24)
+        "result"    |-> (1 => 288)
+        "i"         |-> (1 => 5),
+        parent(0))
+      ...
+    </scopes>
+
+  // A concrete state satisfying the entry claim's N>=1 precondition. The
+  // destination is an independent ground result, not productAfter.
+  claim [entry-precondition-witness-n4]:
+    <k>
+      #loadAll(Module(
+        FuncDef("special_factorial", Params("n"),
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("result"), Int(1))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            Assign(
+              Name("factorial"),
+              BinOp("*", Name("factorial"), Name("i")))
+            Assign(
+              Name("result"),
+              BinOp("*", Name("result"), Name("factorial")))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("result")))))
+      ~> Call(Name("special_factorial"), (4, .Exprs))
+      => 288
