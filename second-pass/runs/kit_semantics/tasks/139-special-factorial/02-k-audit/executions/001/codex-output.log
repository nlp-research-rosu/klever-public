+fi
+
+python3 /audit-output/evidence/02_differential.py
+differential_status=$?
+printf 'differential_exit=%s\n' "$differential_status"
+
+if [ "$translate_status" -ne 0 ] || [ "$cmp_status" -ne 0 ] || [ "$differential_status" -ne 0 ]; then
+  exit 1
+fi
