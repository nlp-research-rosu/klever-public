+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/reconstruction
+
+printf '%s\n' 'COMMAND: python3 /audit-output/evidence/04_constructor_compare.py'
+python3 /audit-output/evidence/04_constructor_compare.py
