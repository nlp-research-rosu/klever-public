+print("required_candidate_proof_artifacts_regular:", require_regular(proof_artifacts))
+
+if not (
+    all_hashes_match
+    and all_tree_hashes_match
+    and result_files_match
+    and trace_ok
+    and json_ok
+):
+    sys.exit(1)
