# iterative patterns
seps=[b'',b'\\0',b'\\n',b' ',b'  ',b':',b'\\t']
nameforms=[lambda r:r.encode(), lambda r:('./'+r).encode()]
hashforms=[lambda h,hr,b:h.encode(),lambda h,hr,b:hr,lambda h,hr,b:b]
for nf_i,nf in enumerate(nameforms):
