      "normalized_sha256": "76c9fee7d31c7b9af2772f9513ebc29daf766162032c70206947d10685c8ab71",
      "rationale": "This is the guarded base equation for the total mathematical summary factorialAfter: when the loop index is past N, the final factorial accumulator is the current accumulator F. It defines the summary symbol and does not execute or observe an MPY program term.",
      "source_rule_id": "rule-76c9fee7d31c7b9af2772f9513ebc29daf766162032c70206947d10685c8ab71",
      "start_line": 11,
      "text": "  rule factorialAfter(I:Int, N:Int, F:Int) => F\n    requires I >Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "56984dfdcdf0ba8c027875164046db3a50319cd8bde210cf5869ac4eb5483d0b",
      "rationale": "This is the guarded recursive equation for factorialAfter, advancing the index and factorial accumulator exactly as the named fold is defined. It is part of the recurrence definition, not an additional mathematical fact or an operational MPY rule.",
      "source_rule_id": "rule-56984dfdcdf0ba8c027875164046db3a50319cd8bde210cf5869ac4eb5483d0b",
      "start_line": 13,
      "text": "  rule factorialAfter(I:Int, N:Int, F:Int)\n    => factorialAfter(I +Int 1, N, F *Int I)\n    requires I <=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "7e43f2e0797b8ac08b474026ab65d98ed66d18b24b058dc65450b65246cf00b5",
      "rationale": "This is the guarded base equation for the total mathematical summary productAfter: once the index is past N, the final product is the current result accumulator R. Its left-hand side is the proof summary symbol rather than an execution configuration.",
      "source_rule_id": "rule-7e43f2e0797b8ac08b474026ab65d98ed66d18b24b058dc65450b65246cf00b5",
      "start_line": 18,
      "text": "  rule productAfter(I:Int, N:Int, _F:Int, R:Int) => R\n    requires I >Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "110b740de92d5388806b355cf84cbe138a0ae279db89595139a60295681df25c",
      "rationale": "This is the guarded recursive equation defining productAfter by advancing the index, factorial accumulator, and result accumulator for one fold step. It defines the summary recurrence and neither replaces MPY execution nor asserts a separate trusted domain fact.",
      "source_rule_id": "rule-110b740de92d5388806b355cf84cbe138a0ae279db89595139a60295681df25c",
      "start_line": 20,
      "text": "  rule productAfter(I:Int, N:Int, F:Int, R:Int)\n    => productAfter(I +Int 1, N, F *Int I, R *Int (F *Int I))\n    requires I <=Int N"
    }
  ],
