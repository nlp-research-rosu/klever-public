/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path

canonical = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == canonical['inventory_sha256']
expected_ids = [r['source_rule_id'] for r in canonical['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids)) == len(expected_ids)
for entry in out['rules']:
    assert list(entry.keys()) == ['source_rule_id', 'classification', 'rationale'], list(entry.keys())
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
attrs = [r for r in canonical['rules'] if 'simplification' in r.get('attributes', [])]
for rule, entry in zip(canonical['rules'], out['rules']):
    if 'simplification' in rule.get('attributes', []):
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print('inventory_sha256=' + out['inventory_sha256'])
print('rules=' + str(len(actual_ids)))
print('counts=' + json.dumps(Counter(e['classification'] for e in out['rules']), sort_keys=True))
print('simplification_rules=' + str(len(attrs)))
print('validation=PASS')
PY
