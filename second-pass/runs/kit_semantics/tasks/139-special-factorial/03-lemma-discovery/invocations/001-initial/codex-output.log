--- verification.k ---
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY
  imports INT

  // Definitional summaries for the two accumulators after executing the
  // source loop from counter I through N.  These equations name mathematical
  // values; they do not rewrite or bypass any MPY program computation.
  syntax Int ::= factorialAfter(Int, Int, Int) [function, total]
  rule factorialAfter(I:Int, N:Int, F:Int) => F
    requires I >Int N
  rule factorialAfter(I:Int, N:Int, F:Int)
    => factorialAfter(I +Int 1, N, F *Int I)
    requires I <=Int N

  syntax Int ::= productAfter(Int, Int, Int, Int) [function, total]
  rule productAfter(I:Int, N:Int, _F:Int, R:Int) => R
    requires I >Int N
  rule productAfter(I:Int, N:Int, F:Int, R:Int)
    => productAfter(I +Int 1, N, F *Int I, R *Int (F *Int I))
    requires I <=Int N
endmodule
--- prove.sh ---
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy
python3 py2mpy.py body-mutation.py > body-mutation.mpy

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun smoke.mpy --definition runtime-kompiled | tee krun-smoke.out
python3 test_solution.py | tee differential.out

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC 2>&1 | tee proof.out

kprove summary-test.k \
  --definition verification-kompiled \
  --spec-module SUMMARY-TEST 2>&1 | tee summary-test.out

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY > vacuity.out 2>&1; then
  cat vacuity.out
  echo "ERROR: false-postcondition mutation unexpectedly proved" >&2
  exit 1
fi
grep -q "WarnStuckClaimState" vacuity.out
grep -Fq "productAfter ( 2 , N , 1 , 1 ) +Int 1" vacuity.out
echo "false-postcondition mutation: expected failure"

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION > body-mutation.out 2>&1; then
  cat body-mutation.out
  echo "ERROR: changed-body mutation unexpectedly proved" >&2
  exit 1
fi
grep -q "WarnStuckClaimState" body-mutation.out
grep -Fq "R *Int ( F *Int I ) +Int 1" body-mutation.out
echo "changed-body mutation: expected failure"
--- spec.k ---
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [loop-invariant]:
    <k>
      #while(Compare(Name("i"), CmpOp("<=", Name("n"))),
        Assign(
          Name("factorial"),
          BinOp("*", Name("factorial"), Name("i")))
        Assign(
          Name("result"),
          BinOp("*", Name("result"), Name("factorial")))
        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
      => .K ...
    </k>
    <env> L:Int </env>
    <scopes>
      ...
      L |-> scope(
        "n"         |-> N:Int
        "factorial" |-> (F:Int => factorialAfter(I, N, F))
        "result"    |-> (R:Int => productAfter(I, N, F, R))
        "i"         |-> (I:Int => N +Int 1),
        _P:Parent)
      ...
    </scopes>
    requires N >=Int 1
      andBool I >=Int 1
      andBool I <=Int N +Int 1

  claim [special-factorial]:
    <k>
      #loadAll(Module(
        FuncDef("special_factorial", Params("n"),
          Assign(Name("factorial"), Int(1))
          Assign(Name("result"), Int(1))
          Assign(Name("i"), Int(1))
          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
            Assign(
              Name("factorial"),
              BinOp("*", Name("factorial"), Name("i")))
            Assign(
              Name("result"),
              BinOp("*", Name("result"), Name("factorial")))
            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
          Return(Name("result")))))
      ~> Call(Name("special_factorial"), (N:Int, .Exprs))
      => productAfter(1, N, 1, 1)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        .Map
        => "special_factorial" |->
             closureVal(
               ("n", .ParamNames),
               Assign(Name("factorial"), Int(1))
               Assign(Name("result"), Int(1))
               Assign(Name("i"), Int(1))
               While(Compare(Name("i"), CmpOp("<=", Name("n"))),
                 Assign(
                   Name("factorial"),
                   BinOp("*", Name("factorial"), Name("i")))
                 Assign(
                   Name("result"),
                   BinOp("*", Name("result"), Name("factorial")))
                 Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
               Return(Name("result")),
               0),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 1
endmodule
