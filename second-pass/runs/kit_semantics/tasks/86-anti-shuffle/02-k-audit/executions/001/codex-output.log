+  else
+    sed -n '1,120p' "$tmp_log"
+    printf '\n[... %s middle lines omitted ...]\n\n' "$((line_count - 240))"
+    tail -n 120 "$tmp_log"
+  fi
+} >"$log_path"
+
+exit "$status"

