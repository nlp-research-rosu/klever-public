diff --git a/evidence/inventory_rules.py b/evidence/inventory_rules.py
new file mode 100644
index 0000000000000000000000000000000000000000..10374af108982cba7bd3d7493255286b23288b11
--- /dev/null
+++ b/evidence/inventory_rules.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Create a line-addressed inventory of the supplied and proof-local K theory."""
+
+from __future__ import annotations
+
+import re
+from collections import Counter
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work/anti-shuffle")
+FILES = [
+    ROOT / "reference-semantics" / "semantics.k",
+    *sorted((ROOT / "reference-semantics" / "semantics").glob("*.k")),
+    ROOT / "program-generated.k",
+    ROOT / "verification.k",
+    ROOT / "spec.k",
+    ROOT / "lemma-spec.k",
+]
+START = re.compile(
+    r"^\s{2}(syntax|rule|context|configuration|claim)\b"
+)
+BOUNDARY = re.compile(
+    r"^\s{0,2}(?:syntax|rule|context|configuration|claim|module|endmodule|"
+    r"imports|requires)\b"
+)
+ATTR = re.compile(r"\[([^\]]+)\]")
+
+
+def entries(path: Path):
+    lines = path.read_text(encoding="utf-8").splitlines()
+    starts = [i for i, line in enumerate(lines) if START.match(line)]
+    for start in starts:
+        kind = START.match(lines[start]).group(1)
+        end = start + 1
+        while end < len(lines) and not BOUNDARY.match(lines[end]):
+            end += 1
+        block_lines = [
+            line.split("//", 1)[0].strip()
+            for line in lines[start:end]
+            if line.split("//", 1)[0].strip()
+        ]
+        block = " ".join(block_lines)
+        attrs = ",".join(ATTR.findall(block)) or "-"
+        flags = [
+            flag
+            for flag in (
+                "function",
+                "functional",
+                "total",
+                "simplification",
+                "priority",
+                "owise",
+                "concrete",
+                "no-evaluators",
+                "macro",
+                "macro-rec",
+                "strict",
+                "seqstrict",
+            )
+            if re.search(rf"\b{re.escape(flag)}\b", block)
+        ]
+        yield start + 1, kind, attrs, ",".join(flags) or "-", block
+
+
+def main() -> None:
+    totals = Counter()
+    rendered = []
+    for path in FILES:
+        rel = path.relative_to(ROOT)
+        file_entries = list(entries(path))
+        kinds = Counter(item[1] for item in file_entries)
+        totals.update(kinds)
+        rendered.append(
+            f"\n## `{rel}`\n\n"
+            f"Entries: {len(file_entries)} "
+            + ", ".join(f"{kind}={count}" for kind, count in sorted(kinds.items()))
+            + "\n"
+        )
+        for line, kind, attrs, flags, block in file_entries:
+            rendered.append(
+                f"\n- `{rel}:{line}` | `{kind}` | attrs `{attrs}` | "
+                f"flags `{flags}` | `{block}`"
+            )
+        rendered.append("\n")
+
+    print("# K declaration and rule inventory")
+    print()
+    print(
+        "Generated by `inventory_rules.py`. Each declaration/rule/context/claim "
+        "is listed by source line; multiline declarations are flattened."
+    )
+    print()
+    print(
+        "Totals: "
+        + ", ".join(f"{kind}={count}" for kind, count in sorted(totals.items()))
+        + f"; all={sum(totals.values())}"
+    )
+    print("".join(rendered))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..82dfd8bc82c07b4260423bdd96cc3b585fa04136
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# Run one command and preserve a bounded, reproducible combined-output log.
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log_path=$1
+shift
+tmp_log=$(mktemp /tmp/audit-work/anti-shuffle-command.XXXXXX)
+trap 'rm -f -- "$tmp_log"' EXIT
+
+"$@" >"$tmp_log" 2>&1
+status=$?
+line_count=$(wc -l <"$tmp_log")
+byte_count=$(wc -c <"$tmp_log")
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\nEXIT: %s\nOUTPUT_LINES: %s\nOUTPUT_BYTES: %s\nOUTPUT:\n' \
+    "$status" "$line_count" "$byte_count"
+  if (( line_count <= 240 )); then
+    sed -n '1,240p' "$tmp_log"
+  else
+    sed -n '1,120p' "$tmp_log"
+    printf '\n[... %s middle lines omitted ...]\n\n' "$((line_count - 240))"
+    tail -n 120 "$tmp_log"
+  fi
+} >"$log_path"
+
+exit "$status"

