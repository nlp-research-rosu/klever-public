+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // "aa" -> "aa"; witnesses the comparison-equality path.
+  claim [ground-duplicate]:
+    <k>
+      #loadAll(solutionModule())
+      ~> Call(
