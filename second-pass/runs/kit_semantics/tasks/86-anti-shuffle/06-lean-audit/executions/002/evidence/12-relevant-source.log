/reference/k-proof/solution.py
1:def anti_shuffle(s):
2:    result = ''
3:    word = ''
4:    char = ''
5:    new_word = ''
6:    inserted = False
7:    old_char = ''
8:    for char in s:
9:        if char == ' ':
10:            result += word
11:            result += ' '
12:            word = ''
13:        else:
14:            new_word = ''
15:            inserted = False
16:            for old_char in word:
17:                if not inserted and char < old_char:
18:                    new_word += char
19:                    inserted = True
20:                new_word += old_char
21:            if not inserted:
22:                new_word += char
23:                inserted = True
24:            word = new_word
25:    result += word
26:    return result

