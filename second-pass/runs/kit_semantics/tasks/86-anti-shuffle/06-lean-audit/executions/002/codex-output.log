+#!/usr/bin/env python3
+"""Independent hash, obligation-bijection, and target-identity audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import (
+    k_rule_inventory,
+    klean_export,
