+    ),
+    "input_manifest_verification_hash": (
+        input_manifest["verification_sha256"]
+        == inventory["verification_sha256"]
+    ),
+    "generator_provenance_stage1_hash": (
+        generator["provenance"]["stage1_workspace_sha256"]
