+    "SortIntSeq.«.IntSeq_MPY-CORE_IntSeq») "
+    "(SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» D "
+    "SortIntSeq.«.IntSeq_MPY-CORE_IntSeq») : SortBool) = "
