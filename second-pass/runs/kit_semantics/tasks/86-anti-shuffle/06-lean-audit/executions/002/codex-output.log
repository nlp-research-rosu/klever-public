41:       requires notBool strPrefix(P, iCons(C, Xs))
42:
43:  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
44:  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
45:  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
46:  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
47:  // str </<=/>/>= comparisons.
48:  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
49:  rule strLt(.IntSeq, .IntSeq)                => false
50:  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
51:  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
52:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
53:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
54:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
55:
56:  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
57:  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
58:  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
59:  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
60:endmodule

/reference/k-proof/verification.k
1:requires "program-generated.k"
2:
3:module VERIFICATION
4:  imports PROGRAM-GENERATED
5:
6:  // Derived directly from MPY-STR's complete lexicographic cases: for two
7:  // one-character strings, lexicographic order is integer-code order.
8:  rule strLt(
9:         iCons(C:Int, .IntSeq),
10:         iCons(D:Int, .IntSeq))
11:    => C <Int D
12:    [simplification]
13:
14:  // Exact AST aliases for the translated implementation.  These construct
15:  // syntax only; they do not summarize or replace execution.
16:  syntax Stmts ::= antiInnerBody() [function, total]
17:                 | antiPostInsert() [function, total]
18:                 | antiOuterBody() [function, total]
19:                 | antiTail() [function, total]
20:
21:  rule antiInnerBody()
22:    => If(
23:         BoolOp(
24:           "and",
25:           (UnaryOp("not", Name("inserted")),
26:            Compare(Name("char"), CmpOp("<", Name("old_char"))),
27:            .Exprs)),
28:         AugAssign(Name("new_word"), "+", Name("char"))
29:         Assign(Name("inserted"), Bool(true))
30:         .Stmts,
31:         .Stmts)
32:       AugAssign(Name("new_word"), "+", Name("old_char"))
33:       .Stmts
34:
35:  rule antiPostInsert()
36:    => If(
37:         UnaryOp("not", Name("inserted")),
38:         AugAssign(Name("new_word"), "+", Name("char"))
39:         Assign(Name("inserted"), Bool(true))
40:         .Stmts,
41:         .Stmts)
42:       Assign(Name("word"), Name("new_word"))
43:       .Stmts
44:
45:  rule antiOuterBody()
46:    => If(
47:         Compare(Name("char"), CmpOp("==", Str(" "))),
48:         AugAssign(Name("result"), "+", Name("word"))
49:         AugAssign(Name("result"), "+", Str(" "))
50:         Assign(Name("word"), Str(""))
51:         .Stmts,
52:         Assign(Name("new_word"), Str(""))
53:         Assign(Name("inserted"), Bool(false))
54:         For(Name("old_char"), Name("word"), antiInnerBody())
55:         antiPostInsert())
56:       .Stmts
57:
58:  rule antiTail()
59:    => AugAssign(Name("result"), "+", Name("word"))
60:       Return(Name("result"))
61:       .Stmts
62:
63:  // Exact value produced by the insertion loop from its loop-head state.
64:  // The guard-free constructor equations unfold one step without splitting an
65:  // unknown tail.
66:  syntax IntSeq ::= insertGo(IntSeq, Int, IntSeq, Bool)
67:                    [function, total]
68:  rule insertGo(.IntSeq, C:Int, A:IntSeq, B:Bool)
69:    => #if B
70:       #then A
71:       #else seqConcat(A, iCons(C, .IntSeq))
72:       #fi
73:  rule insertGo(
74:         iCons(OLD:Int, IS:IntSeq),
75:         C:Int,
76:         A:IntSeq,
77:         B:Bool)
78:    => #if notBool B andBool C <Int OLD
79:       #then insertGo(
80:               IS,
81:               C,
82:               seqConcat(
83:                 seqConcat(A, iCons(C, .IntSeq)),
84:                 iCons(OLD, .IntSeq)),
85:               true)
86:       #else insertGo(
87:               IS,
88:               C,
89:               seqConcat(A, iCons(OLD, .IntSeq)),
90:               B)
91:       #fi
92:
93:  // Exact value produced by the outer loop and its function tail.
94:  syntax IntSeq ::= antiGo(IntSeq, IntSeq, IntSeq) [function, total]
95:  rule antiGo(.IntSeq, R:IntSeq, W:IntSeq)
96:    => seqConcat(R, W)
97:  rule antiGo(iCons(C:Int, S:IntSeq), R:IntSeq, W:IntSeq)
98:    => #if C ==Int 32
99:       #then antiGo(
100:               S,
101:               seqConcat(seqConcat(R, W), iCons(32, .IntSeq)),
102:               .IntSeq)
103:       #else antiGo(
104:               S,
105:               R,
106:               insertGo(W, C, .IntSeq, false))
107:       #fi
108:
109:endmodule
Script done.

diff --git a//tmp/audit-work/proc-self-test.c b//tmp/audit-work/proc-self-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..c79a357051617101fa78413e0a253a213b105b99
--- /dev/null
+++ b//tmp/audit-work/proc-self-test.c
@@ -0,0 +1,12 @@
+#include <stdio.h>
+#include <unistd.h>
+#include <errno.h>
+#include <string.h>
+int main(void) {
+  char path[4096], buf[4096] = {0};
+  snprintf(path, sizeof(path), "/proc/%d/exe", getpid());
+  ssize_t n = readlink(path, buf, sizeof(buf));
+  printf("path=%s n=%zd errno=%d (%s) target=%s\n", path, n, errno,
+         strerror(errno), buf);
+  return n < 0;
+}
