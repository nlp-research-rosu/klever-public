+        len(source_rules) == len(obligations) == generator["obligation_count"] == 1
+        and export_result["status"] == "OK"
+        and stored_preflight["status"] == "PASS"
+    ),
+    "source_rule_is_exact_reconstructed_domain_rule": (
+        source_rules == [expected_source_rule]
