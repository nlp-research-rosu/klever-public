diff --git a//tmp/audit-work/stage5-proof-audit/AuditBridge.lean b//tmp/audit-work/stage5-proof-audit/AuditBridge.lean
new file mode 100644
index 0000000000000000000000000000000000000000..9e3fc1a56bf85740cf4bd8c57b4947e3e03ce254
--- /dev/null
+++ b//tmp/audit-work/stage5-proof-audit/AuditBridge.lean
@@ -0,0 +1,102 @@
+import Proof
+
+namespace AuditBridge
+
+def encode : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | x :: xs =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (encode xs)
+
+/- Independent executable restatement of the six supplied MPY-STR cases:
+   three empty/nonempty cases and the less/greater/equal-head cases. -/
+def operationalStrLt : List Int → List Int → Bool
+  | [], [] => false
+  | [], _ :: _ => true
+  | _ :: _, [] => false
+  | left :: leftRest, right :: rightRest =>
+      if left < right then true
+      else if left > right then false
+      else operationalStrLt leftRest rightRest
+
+theorem candidate_strLt_matches_operational_cases :
+    ∀ left right,
+      Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq»
+          (encode left) (encode right) = operationalStrLt left right := by
+  intro left
+  induction left with
+  | nil =>
+      intro right
+      cases right <;> rfl
+  | cons head tail ih =>
+      intro right
+      cases right with
+      | nil => rfl
+      | cons rightHead rightTail =>
+          simp [encode, operationalStrLt,
+            Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq», ih]
+
+theorem candidate_intLt_is_K_integer_order (left right : SortInt) :
+    Proof.«_<Int_» left right = decide (left < right) := by
+  rfl
+
+#eval (Proof.«_<Int_» (-3) 2, Proof.«_<Int_» 2 (-3), Proof.«_<Int_» 4 4)
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode []) (encode []),
+  operationalStrLt [] [])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode []) (encode [0]),
+  operationalStrLt [] [0])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [0]) (encode []),
+  operationalStrLt [0] [])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [-2]) (encode [-1]),
+  operationalStrLt [-2] [-1])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [-1]) (encode [-2]),
+  operationalStrLt [-1] [-2])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [5, -3]) (encode [5, 2]),
+  operationalStrLt [5, -3] [5, 2])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [1]) (encode [1, 0]),
+  operationalStrLt [1] [1, 0])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [1, 0]) (encode [1]),
+  operationalStrLt [1, 0] [1])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [1, 2]) (encode [1, 2]),
+  operationalStrLt [1, 2] [1, 2])
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [0, 100]) (encode [1, -100]),
+  operationalStrLt [0, 100] [1, -100])
+
+/- Counterfactuals: the fixed singleton equation alone admits dishonest
+   coordinated constants and a head-only implementation.  These definitions
+   are audit probes, not candidate code. -/
+def constantIntLt (_ _ : SortInt) : SortBool := false
+def constantStrLt (_ _ : SortIntSeq) : SortBool := false
+
+example : Klean86AntiShuffle.Lemmas.targetStatement
+    constantIntLt constantStrLt := by
+  unfold Klean86AntiShuffle.Lemmas.targetStatement
+  intro D C
+  rfl
+
+example : ¬ Klean86AntiShuffle.Lemmas.targetStatement
+    Proof.«_<Int_» constantStrLt := by
+  intro h
+  have bad := h (1 : SortInt) (0 : SortInt)
+  simp [constantStrLt, Proof.«_<Int_»] at bad
+
+def headOnlyStrLt : SortIntSeq → SortIntSeq → SortBool
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
+      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»,
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _ => true
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ _,
+      SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => false
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» left _,
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» right _ =>
+      decide (left < right)
+
+example : Klean86AntiShuffle.Lemmas.targetStatement
+    Proof.«_<Int_» headOnlyStrLt := by
+  unfold Klean86AntiShuffle.Lemmas.targetStatement
+  intro D C
+  simp [headOnlyStrLt, Proof.«_<Int_»]
+
+#eval (Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» (encode [1]) (encode [1, 0]),
+  headOnlyStrLt (encode [1]) (encode [1, 0]))
+
+end AuditBridge
