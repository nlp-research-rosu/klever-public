/reference/k-proof/verification.k-62-
/reference/k-proof/verification.k-63-  // Exact value produced by the insertion loop from its loop-head state.
/reference/k-proof/verification.k-64-  // The guard-free constructor equations unfold one step without splitting an
/reference/k-proof/verification.k-65-  // unknown tail.
/reference/k-proof/verification.k:66:  syntax IntSeq ::= insertGo(IntSeq, Int, IntSeq, Bool)
/reference/k-proof/verification.k-67-                    [function, total]
/reference/k-proof/verification.k-68-  rule insertGo(.IntSeq, C:Int, A:IntSeq, B:Bool)
/reference/k-proof/verification.k-69-    => #if B
/reference/k-proof/verification.k-70-       #then A
/reference/k-proof/verification.k:71:       #else seqConcat(A, iCons(C, .IntSeq))
/reference/k-proof/verification.k-72-       #fi
/reference/k-proof/verification.k-73-  rule insertGo(
/reference/k-proof/verification.k:74:         iCons(OLD:Int, IS:IntSeq),
/reference/k-proof/verification.k-75-         C:Int,
/reference/k-proof/verification.k-76-         A:IntSeq,
/reference/k-proof/verification.k-77-         B:Bool)
/reference/k-proof/verification.k-78-    => #if notBool B andBool C <Int OLD
/reference/k-proof/verification.k-79-       #then insertGo(
/reference/k-proof/verification.k-80-               IS,
/reference/k-proof/verification.k-81-               C,
/reference/k-proof/verification.k-82-               seqConcat(
/reference/k-proof/verification.k:83:                 seqConcat(A, iCons(C, .IntSeq)),
/reference/k-proof/verification.k:84:                 iCons(OLD, .IntSeq)),
/reference/k-proof/verification.k-85-               true)
/reference/k-proof/verification.k-86-       #else insertGo(
/reference/k-proof/verification.k-87-               IS,
/reference/k-proof/verification.k-88-               C,
/reference/k-proof/verification.k:89:               seqConcat(A, iCons(OLD, .IntSeq)),
/reference/k-proof/verification.k-90-               B)
/reference/k-proof/verification.k-91-       #fi
/reference/k-proof/verification.k-92-
/reference/k-proof/verification.k-93-  // Exact value produced by the outer loop and its function tail.
/reference/k-proof/verification.k:94:  syntax IntSeq ::= antiGo(IntSeq, IntSeq, IntSeq) [function, total]
/reference/k-proof/verification.k-95-  rule antiGo(.IntSeq, R:IntSeq, W:IntSeq)
/reference/k-proof/verification.k-96-    => seqConcat(R, W)
/reference/k-proof/verification.k:97:  rule antiGo(iCons(C:Int, S:IntSeq), R:IntSeq, W:IntSeq)
/reference/k-proof/verification.k-98-    => #if C ==Int 32
/reference/k-proof/verification.k-99-       #then antiGo(
/reference/k-proof/verification.k-100-               S,
/reference/k-proof/verification.k:101:               seqConcat(seqConcat(R, W), iCons(32, .IntSeq)),
/reference/k-proof/verification.k-102-               .IntSeq)
/reference/k-proof/verification.k-103-       #else antiGo(
/reference/k-proof/verification.k-104-               S,
/reference/k-proof/verification.k-105-               R,
/reference/k-proof/verification.k-106-               insertGo(W, C, .IntSeq, false))
/reference/k-proof/verification.k-107-       #fi
