+    ),
+    "all_mounted_resolution_hashes_match": actual_hashes == recorded_hashes,
+    "stage1_file_hash_map_exact": actual_stage1_files == recorded_stage1_files,
+    "stage1_file_hash_map_has_no_duplicate_paths": (
