+}
+recorded_hashes = {
+    key: resolution["hashes"][key] for key in actual_hashes
+}
+
+actual_stage1_files = {
+    path.relative_to(Path("/reference/k-proof")).as_posix(): file_hash(path)
+    for path in pipeline_contract._walk_regular_files(
