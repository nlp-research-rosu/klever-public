+```sh
+printf "AUDIT_MODE=%s\n" "$AUDIT_MODE"
+sed -n '1,260p' /audit-input.json
+rg --files /reference/tools | sort
+find /reference -mindepth 1 -maxdepth 2 -printf '%y %p\n' | sort
+find /candidate -mindepth 1 -maxdepth 3 -printf '%y %p\n' | sort
