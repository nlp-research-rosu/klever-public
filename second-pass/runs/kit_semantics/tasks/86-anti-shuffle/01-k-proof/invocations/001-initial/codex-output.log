@@ -0,0 +1,33 @@
+def anti_shuffle(s):
+    result = ''
+    word = ''
+    char = ''
+    new_word = ''
+    inserted = False
+    old_char = ''
+    for char in s:
+        if char == ' ':
+            result += word
+            result += ' '
+            word = ''
+        else:
+            new_word = ''
