+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("char" |-> OLDCHAR:Val)
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(W:IntSeq)),
+             parent(0))
+      =>
