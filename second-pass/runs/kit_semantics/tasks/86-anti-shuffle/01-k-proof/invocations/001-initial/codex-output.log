+                           .Exprs),
+                         .Exprs))
+                     AugAssign(Name("result"), "+", Str(" "))
+                     Assign(Name("word"), Str(""))
+                     .Stmts,
+                     AugAssign(Name("word"), "+", Name("char"))
+                     .Stmts))
+                 AugAssign(
+                   Name("result"),
+                   "+",
+                   Call(
+                     Attribute(Str(""), "join"),
+                     Call(
+                       Name("sorted"),
+                       Call(Name("list"), Name("word"), .Exprs),
+                       .Exprs),
+                     .Exprs))
+                 Return(Name("result"))
+                 .Stmts,
+                 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
