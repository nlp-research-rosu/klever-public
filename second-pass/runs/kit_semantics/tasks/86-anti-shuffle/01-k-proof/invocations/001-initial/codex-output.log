+#!/usr/bin/env python3
+"""Generate K aliases for the exact translated solution module and body."""
+
+import argparse
+import ast
+import hashlib
+import re
+import symtable
+from pathlib import Path
+
+import py2mpy
+
+
+def indent(text, spaces):
+    pad = " " * spaces
+    return "\n".join(pad + line if line else line for line in text.splitlines())
