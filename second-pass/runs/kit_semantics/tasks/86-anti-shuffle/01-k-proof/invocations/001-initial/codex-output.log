index 0000000000000000000000000000000000000000..eae107e0cce06f4ddb4e447468a59c8522393887
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,34 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
