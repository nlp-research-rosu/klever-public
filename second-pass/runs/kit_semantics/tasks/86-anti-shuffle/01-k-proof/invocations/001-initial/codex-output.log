--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def anti_shuffle(s):
+    # `word` is the unfinished word; `result` contains all prior words/spaces.
+    result = ''.join([])
+    word = ''
+    for char in s:
+        if char == ' ':
+            result += ''.join(sorted(list(word)))
+            result += ' '
+            word = ''
+        else:
+            word += char
+    result += ''.join(sorted(list(word)))
+    return result
