diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c7058b0099c3402419f249ccb02b049228c44b71
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,118 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner insertion loop, including the exact remaining outer continuation.
+  claim [anti-shuffle-inner-loop]:
+    <k>
+      #loop(str(IS:IntSeq), Name("old_char"), antiInnerBody())
+      ~> antiPostInsert()
+      ~> #loopLbl(#loop(str(OS:IntSeq), Name("char"), antiOuterBody()))
+      ~> antiTail()
+      ~> #endcall
+      => str(?OUTPUT:IntSeq)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(WORD:IntSeq))
+             ("char" |-> str(iCons(C:Int, .IntSeq)))
+             ("new_word" |-> str(A:IntSeq))
+             ("inserted" |-> B:Bool)
+             ("old_char" |-> str(OLD:IntSeq)),
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures innerThenOuter(IS, C, A, B, OS, R, ?OUTPUT)
+
+  // Outer character loop.  The relation in the postcondition is also the
+  // invariant threaded through the inner-loop claim above.
+  claim [anti-shuffle-outer-loop]:
+    <k>
+      #loop(str(S:IntSeq), Name("char"), antiOuterBody())
+      ~> antiTail()
+      ~> #endcall
+      => str(?OUTPUT:IntSeq)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(W:IntSeq))
+             ("char" |-> str(CURRENT:IntSeq))
+             ("new_word" |-> str(NEW:IntSeq))
+             ("inserted" |-> INSERTED:Bool)
+             ("old_char" |-> str(OLD:IntSeq)),
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures outerResult(S, R, W, ?OUTPUT)
+
+  // Whole-program claim: load the exact translated definition, resolve its
+  // public name, execute the real body, and constrain the returned string.
+  claim [anti-shuffle]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("anti_shuffle", Params("s"), antiBody())))
+      ~> Call(Name("anti_shuffle"), str(INPUT:IntSeq), .Exprs)
+      => str(?OUTPUT:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures outerResult(INPUT, .IntSeq, .IntSeq, ?OUTPUT)
+endmodule
