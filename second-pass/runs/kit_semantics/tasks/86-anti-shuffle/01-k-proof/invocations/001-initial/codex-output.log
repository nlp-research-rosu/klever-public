diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..df7a849504ff31ee71ea5133be3178363dc4485d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,115 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Result relation at the outer character-loop head.
+  //
+  // S = unprocessed input, R = completed output, W = current sorted word,
+  // O = final output.
+  syntax Bool ::= outerResult(IntSeq, IntSeq, IntSeq, IntSeq) [function]
+  rule outerResult(.IntSeq, R:IntSeq, W:IntSeq, O:IntSeq)
+    => O ==K seqConcat(R, W)
+  rule outerResult(
+         iCons(32, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => outerResult(
+         S,
+         seqConcat(seqConcat(R, W), iCons(32, .IntSeq)),
+         .IntSeq,
+         O)
+  rule outerResult(
+         iCons(C:Int, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(W, C, .IntSeq, false, S, R, O)
+    requires C =/=Int 32
+
+  // Result relation at the insertion-loop head.
+  //
+  // IS = unprocessed old word, C = character being inserted,
+  // A = constructed new word, B = whether C has already been inserted,
+  // OS/R = remaining outer input/completed output, O = final output.
+  syntax Bool ::= innerThenOuter(
+                    IntSeq, Int, IntSeq, Bool,
+                    IntSeq, IntSeq, IntSeq) [function]
+
+  rule innerThenOuter(
+         .IntSeq,
+         _:Int,
+         A:IntSeq,
+         true,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => outerResult(OS, R, A, O)
+  rule innerThenOuter(
+         .IntSeq,
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => outerResult(
+         OS,
+         R,
+         seqConcat(A, iCons(C, .IntSeq)),
+         O)
+
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(
+           seqConcat(A, iCons(C, .IntSeq)),
+           iCons(OLD, .IntSeq)),
+         true,
+         OS,
+         R,
+         O)
+    requires C <Int OLD
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         false,
+         OS,
+         R,
+         O)
+    requires C >=Int OLD
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         true,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         true,
+         OS,
+         R,
+         O)
+endmodule

