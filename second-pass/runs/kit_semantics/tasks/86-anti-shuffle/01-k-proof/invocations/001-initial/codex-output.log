@@ -0,0 +1,15 @@
+requires "reference-semantics/semantics.k"
+
+module LEMMA-SPEC
+  imports MPY
+
+  // Bridge-free universal derivation of verification.k's one-character
+  // lexicographic simplification.
+  claim [single-char-str-lt]:
+    <k>
+      strLt(
+        iCons(C:Int, .IntSeq),
+        iCons(D:Int, .IntSeq))
+      => C <Int D
+    </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7bbccb38b54ddfb6f0b74b02405723cbaa179c13
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,26 @@
+def anti_shuffle(s):
+    result = ''
+    word = ''
+    char = ''
+    new_word = ''
+    inserted = False
+    old_char = ''
+    for char in s:
+        if char == ' ':
+            result += word
+            result += ' '
+            word = ''
+        else:
+            new_word = ''
+            inserted = False
+            for old_char in word:
+                if not inserted and char < old_char:
+                    new_word += char
+                    inserted = True
+                new_word += old_char
+            if not inserted:
+                new_word += char
+                inserted = True
+            word = new_word
+    result += word
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6b86b3fd9a1328fbd69a24687dce3ba2f48411e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,121 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner insertion loop as an independent local-state theorem.  The framed
+  // continuation is arbitrary and is preserved.
+  claim [anti-shuffle-inner-loop]:
+    <k>
+      #loop(str(IS:IntSeq), Name("old_char"), antiInnerBody())
+      ~> antiPostInsert()
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), solutionBody(), 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(WORD:IntSeq))
+             ("char" |-> str(iCons(C:Int, .IntSeq)))
+             ("new_word" |-> str(A:IntSeq))
+             ("inserted" |-> B:Bool)
+             ("old_char" |-> str(OLD:IntSeq)),
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), solutionBody(), 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(insertGo(IS, C, A, B)))
+             ("char" |-> str(iCons(C:Int, .IntSeq)))
+             ("new_word" |-> str(insertGo(IS, C, A, B)))
+             ("inserted" |-> true)
+             ("old_char" |-> str(?FINALOLD:IntSeq)),
+             parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Outer character loop.  The relation in the postcondition is also the
+  // invariant threaded through the inner-loop claim above.
+  claim [anti-shuffle-outer-loop]:
+    <k>
+      #loop(str(S:IntSeq), Name("char"), antiOuterBody())
+      ~> antiTail()
+      ~> #endcall
+      => str(antiGo(S, R, W))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), solutionBody(), 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(W:IntSeq))
+             ("char" |-> str(CURRENT:IntSeq))
+             ("new_word" |-> str(NEW:IntSeq))
+             ("inserted" |-> INSERTED:Bool)
+             ("old_char" |-> str(OLD:IntSeq)),
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), solutionBody(), 0),
+             parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Whole-program claim: load the exact translated definition, resolve its
+  // public name, execute the real body, and constrain the returned string.
+  claim [anti-shuffle]:
+    <k>
+      #loadAll(solutionModule())
+      ~> Call(Name("anti_shuffle"), str(INPUT:IntSeq), .Exprs)
+      => str(antiGo(INPUT, .IntSeq, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), solutionBody(), 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0807db513966d15da09874fb880d6126b6e7d025
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,109 @@
+requires "program-generated.k"
+
+module VERIFICATION
+  imports PROGRAM-GENERATED
+
+  // Derived directly from MPY-STR's complete lexicographic cases: for two
+  // one-character strings, lexicographic order is integer-code order.
+  rule strLt(
+         iCons(C:Int, .IntSeq),
+         iCons(D:Int, .IntSeq))
+    => C <Int D
+    [simplification]
+
+  // Exact AST aliases for the translated implementation.  These construct
+  // syntax only; they do not summarize or replace execution.
+  syntax Stmts ::= antiInnerBody() [function, total]
+                 | antiPostInsert() [function, total]
+                 | antiOuterBody() [function, total]
+                 | antiTail() [function, total]
+
+  rule antiInnerBody()
+    => If(
+         BoolOp(
+           "and",
+           (UnaryOp("not", Name("inserted")),
+            Compare(Name("char"), CmpOp("<", Name("old_char"))),
+            .Exprs)),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       AugAssign(Name("new_word"), "+", Name("old_char"))
+       .Stmts
+
+  rule antiPostInsert()
+    => If(
+         UnaryOp("not", Name("inserted")),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       Assign(Name("word"), Name("new_word"))
+       .Stmts
+
+  rule antiOuterBody()
+    => If(
+         Compare(Name("char"), CmpOp("==", Str(" "))),
+         AugAssign(Name("result"), "+", Name("word"))
+         AugAssign(Name("result"), "+", Str(" "))
+         Assign(Name("word"), Str(""))
+         .Stmts,
+         Assign(Name("new_word"), Str(""))
+         Assign(Name("inserted"), Bool(false))
+         For(Name("old_char"), Name("word"), antiInnerBody())
+         antiPostInsert())
+       .Stmts
+
+  rule antiTail()
+    => AugAssign(Name("result"), "+", Name("word"))
+       Return(Name("result"))
+       .Stmts
+
+  // Exact value produced by the insertion loop from its loop-head state.
+  // The guard-free constructor equations unfold one step without splitting an
+  // unknown tail.
+  syntax IntSeq ::= insertGo(IntSeq, Int, IntSeq, Bool)
+                    [function, total]
+  rule insertGo(.IntSeq, C:Int, A:IntSeq, B:Bool)
+    => #if B
+       #then A
+       #else seqConcat(A, iCons(C, .IntSeq))
+       #fi
+  rule insertGo(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         B:Bool)
+    => #if notBool B andBool C <Int OLD
+       #then insertGo(
+               IS,
+               C,
+               seqConcat(
+                 seqConcat(A, iCons(C, .IntSeq)),
+                 iCons(OLD, .IntSeq)),
+               true)
+       #else insertGo(
+               IS,
+               C,
+               seqConcat(A, iCons(OLD, .IntSeq)),
+               B)
+       #fi
+
+  // Exact value produced by the outer loop and its function tail.
+  syntax IntSeq ::= antiGo(IntSeq, IntSeq, IntSeq) [function, total]
+  rule antiGo(.IntSeq, R:IntSeq, W:IntSeq)
+    => seqConcat(R, W)
+  rule antiGo(iCons(C:Int, S:IntSeq), R:IntSeq, W:IntSeq)
+    => #if C ==Int 32
+       #then antiGo(
+               S,
+               seqConcat(seqConcat(R, W), iCons(32, .IntSeq)),
+               .IntSeq)
+       #else antiGo(
+               S,
+               R,
+               insertGo(W, C, .IntSeq, false))
+       #fi
+
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..c96fbdd4a738c4b0c1f69e6ca68ce1ada9889f90
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,33 @@
+def anti_shuffle(s):
+    result = ''
+    word = ''
+    char = ''
+    new_word = ''
+    inserted = False
+    old_char = ''
+    for char in s:
+        if char == ' ':
+            result += word
+            result += ' '
+            word = ''
+        else:
+            new_word = ''
+            inserted = False
+            for old_char in word:
+                if not inserted and char < old_char:
+                    new_word += char
+                    inserted = True
+                new_word += old_char
+            if not inserted:
+                new_word += char
+                inserted = True
+            word = new_word
+    result += word
+    return result
+
+
+assert anti_shuffle('Hi') == 'Hi'
+assert anti_shuffle('hello') == 'ehllo'
+assert anti_shuffle('Hello World!!!') == 'Hello !!!Wdlor'
+assert anti_shuffle('') == ''
+assert anti_shuffle('  cba  a') == '  abc  a'
