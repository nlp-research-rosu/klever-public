+                     .Stmts))
+                 AugAssign(
+                   Name("result"),
+                   "+",
+                   Call(
+                     Attribute(Str(""), "join"),
+                     Call(
+                       Name("sorted"),
+                       Call(Name("list"), Name("word"), .Exprs),
