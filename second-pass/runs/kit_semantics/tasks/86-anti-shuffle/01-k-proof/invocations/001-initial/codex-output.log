+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures outerResult(S, R, W, ?OUTPUT, ?TRACE:InsertTrace)
+
+  // Whole-program claim: load the exact translated definition, resolve its
+  // public name, execute the real body, and constrain the returned string.
+  claim [anti-shuffle]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("anti_shuffle", Params("s"), antiBody())))
+      ~> Call(Name("anti_shuffle"), str(INPUT:IntSeq), .Exprs)
+      => str(?OUTPUT:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures outerResult(
+              INPUT,
+              .IntSeq,
+              .IntSeq,
+              ?OUTPUT,
+              ?TRACE:InsertTrace)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ce59fe0358f18e29dca2e8b913eb959dcf47994a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,173 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Derived directly from MPY-STR's complete lexicographic cases: for two
+  // one-character strings, lexicographic order is integer-code order.
+  rule strLt(
+         iCons(C:Int, .IntSeq),
+         iCons(D:Int, .IntSeq))
+    => C <Int D
+    [simplification]
+
+  // Exact AST aliases for the translated implementation.  These construct
+  // syntax only; they do not summarize or replace execution.
+  syntax Stmts ::= antiInnerBody() [function, total]
+                 | antiPostInsert() [function, total]
+                 | antiOuterBody() [function, total]
+                 | antiTail() [function, total]
+                 | antiBody() [function, total]
+
+  rule antiInnerBody()
+    => If(
+         BoolOp(
+           "and",
+           (UnaryOp("not", Name("inserted")),
+            Compare(Name("char"), CmpOp("<", Name("old_char"))),
+            .Exprs)),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       AugAssign(Name("new_word"), "+", Name("old_char"))
+       .Stmts
+
+  rule antiPostInsert()
+    => If(
+         UnaryOp("not", Name("inserted")),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       Assign(Name("word"), Name("new_word"))
+       .Stmts
+
+  rule antiOuterBody()
+    => If(
+         Compare(Name("char"), CmpOp("==", Str(" "))),
+         AugAssign(Name("result"), "+", Name("word"))
+         AugAssign(Name("result"), "+", Str(" "))
+         Assign(Name("word"), Str(""))
+         .Stmts,
+         Assign(Name("new_word"), Str(""))
+         Assign(Name("inserted"), Bool(false))
+         For(Name("old_char"), Name("word"), antiInnerBody())
+         antiPostInsert())
+       .Stmts
+
+  rule antiTail()
+    => AugAssign(Name("result"), "+", Name("word"))
+       Return(Name("result"))
+       .Stmts
+
+  rule antiBody()
+    => Assign(Name("result"), Str(""))
+       Assign(Name("word"), Str(""))
+       Assign(Name("char"), Str(""))
+       Assign(Name("new_word"), Str(""))
+       Assign(Name("inserted"), Bool(false))
+       Assign(Name("old_char"), Str(""))
+       For(Name("char"), Name("s"), antiOuterBody())
+       antiTail()
+
+  // Result relation at the outer character-loop head.
+  //
+  // S = unprocessed input, R = completed output, W = current sorted word,
+  // O = final output.
+  syntax InsertTrace ::= ".InsertTrace"
+                       | tCons(IntSeq, InsertTrace)
+
+  syntax Bool ::= outerResult(
+                    IntSeq, IntSeq, IntSeq, IntSeq, InsertTrace)
+                  [function]
+  rule outerResult(
+         .IntSeq,
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq,
+         .InsertTrace)
+    => O ==K seqConcat(R, W)
+  rule outerResult(
+         iCons(32, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq,
+         T:InsertTrace)
+    => outerResult(
+         S,
+         seqConcat(seqConcat(R, W), iCons(32, .IntSeq)),
+         .IntSeq,
+         O,
+         T)
+  rule outerResult(
+         iCons(C:Int, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq,
+         tCons(I:IntSeq, T:InsertTrace))
+    => insertResult(W, C, .IntSeq, false, I)
+       andBool outerResult(S, R, I, O, T)
+    requires C =/=Int 32
+
+  // Relates an insertion-loop head to the word produced at loop exit.
+  syntax Bool ::= insertResult(
+                    IntSeq, Int, IntSeq, Bool, IntSeq) [function]
+
+  rule insertResult(
+         .IntSeq,
+         _:Int,
+         A:IntSeq,
+         true,
+         I:IntSeq)
+    => I ==K A
+  rule insertResult(
+         .IntSeq,
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => I ==K seqConcat(A, iCons(C, .IntSeq))
+
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(
+           seqConcat(A, iCons(C, .IntSeq)),
+           iCons(OLD, .IntSeq)),
+         true,
+         I)
+    requires C <Int OLD
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         false,
+         I)
+    requires C >=Int OLD
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         true,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         true,
+         I)
+
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..c96fbdd4a738c4b0c1f69e6ca68ce1ada9889f90
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,33 @@
+def anti_shuffle(s):
+    result = ''
+    word = ''
+    char = ''
+    new_word = ''
+    inserted = False
+    old_char = ''
+    for char in s:
+        if char == ' ':
+            result += word
+            result += ' '
+            word = ''
+        else:
+            new_word = ''
+            inserted = False
+            for old_char in word:
+                if not inserted and char < old_char:
+                    new_word += char
+                    inserted = True
+                new_word += old_char
+            if not inserted:
+                new_word += char
+                inserted = True
+            word = new_word
+    result += word
+    return result
+
+
+assert anti_shuffle('Hi') == 'Hi'
+assert anti_shuffle('hello') == 'ehllo'
+assert anti_shuffle('Hello World!!!') == 'Hello !!!Wdlor'
+assert anti_shuffle('') == ''
+assert anti_shuffle('  cba  a') == '  abc  a'
