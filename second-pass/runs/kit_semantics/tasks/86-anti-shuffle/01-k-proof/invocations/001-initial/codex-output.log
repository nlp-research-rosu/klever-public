+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner insertion loop as an independent local-state theorem.  The framed
+  // continuation is arbitrary and is preserved.
+  claim [anti-shuffle-inner-loop]:
+    <k>
+      #loop(str(IS:IntSeq), Name("old_char"), antiInnerBody())
+      ~> antiPostInsert()
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(WORD:IntSeq))
+             ("char" |-> str(iCons(C:Int, .IntSeq)))
+             ("new_word" |-> str(A:IntSeq))
+             ("inserted" |-> B:Bool)
+             ("old_char" |-> str(OLD:IntSeq)),
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(?INSERTEDWORD:IntSeq))
+             ("char" |-> str(iCons(C:Int, .IntSeq)))
+             ("new_word" |-> str(?INSERTEDWORD))
+             ("inserted" |-> true)
+             ("old_char" |-> str(?FINALOLD:IntSeq)),
+             parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures insertResult(IS, C, A, B, ?INSERTEDWORD)
+
+  // Outer character loop.  The relation in the postcondition is also the
+  // invariant threaded through the inner-loop claim above.
+  claim [anti-shuffle-outer-loop]:
+    <k>
+      #loop(str(S:IntSeq), Name("char"), antiOuterBody())
+      ~> antiTail()
+      ~> #endcall
+      => str(?OUTPUT:IntSeq)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(W:IntSeq))
+             ("char" |-> str(CURRENT:IntSeq))
+             ("new_word" |-> str(NEW:IntSeq))
+             ("inserted" |-> INSERTED:Bool)
+             ("old_char" |-> str(OLD:IntSeq)),
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures outerResult(S, R, W, ?OUTPUT)
+
+  // Whole-program claim: load the exact translated definition, resolve its
+  // public name, execute the real body, and constrain the returned string.
+  claim [anti-shuffle]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("anti_shuffle", Params("s"), antiBody())))
+      ~> Call(Name("anti_shuffle"), str(INPUT:IntSeq), .Exprs)
+      => str(?OUTPUT:IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(("s", .ParamNames), antiBody(), 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures outerResult(INPUT, .IntSeq, .IntSeq, ?OUTPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6d0d8e80601c564fd249d441ebb486ffbefaffbc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,191 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Derived directly from MPY-STR's complete lexicographic cases: for two
+  // one-character strings, lexicographic order is integer-code order.
+  rule strLt(
+         iCons(C:Int, .IntSeq),
+         iCons(D:Int, .IntSeq))
+    => C <Int D
+    [simplification]
+
+  // Exact AST aliases for the translated implementation.  These construct
+  // syntax only; they do not summarize or replace execution.
+  syntax Stmts ::= antiInnerBody() [function, total]
+                 | antiPostInsert() [function, total]
+                 | antiOuterBody() [function, total]
+                 | antiTail() [function, total]
+                 | antiBody() [function, total]
+
+  rule antiInnerBody()
+    => If(
+         BoolOp(
+           "and",
+           (UnaryOp("not", Name("inserted")),
+            Compare(Name("char"), CmpOp("<", Name("old_char"))),
+            .Exprs)),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       AugAssign(Name("new_word"), "+", Name("old_char"))
+       .Stmts
+
+  rule antiPostInsert()
+    => If(
+         UnaryOp("not", Name("inserted")),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       Assign(Name("word"), Name("new_word"))
+       .Stmts
+
+  rule antiOuterBody()
+    => If(
+         Compare(Name("char"), CmpOp("==", Str(" "))),
+         AugAssign(Name("result"), "+", Name("word"))
+         AugAssign(Name("result"), "+", Str(" "))
+         Assign(Name("word"), Str(""))
+         .Stmts,
+         Assign(Name("new_word"), Str(""))
+         Assign(Name("inserted"), Bool(false))
+         For(Name("old_char"), Name("word"), antiInnerBody())
+         antiPostInsert())
+       .Stmts
+
+  rule antiTail()
+    => AugAssign(Name("result"), "+", Name("word"))
+       Return(Name("result"))
+       .Stmts
+
+  rule antiBody()
+    => Assign(Name("result"), Str(""))
+       Assign(Name("word"), Str(""))
+       Assign(Name("char"), Str(""))
+       Assign(Name("new_word"), Str(""))
+       Assign(Name("inserted"), Bool(false))
+       Assign(Name("old_char"), Str(""))
+       For(Name("char"), Name("s"), antiOuterBody())
+       antiTail()
+
+  // Result relation at the outer character-loop head.
+  //
+  // S = unprocessed input, R = completed output, W = current sorted word,
+  // O = final output.
+  syntax Bool ::= outerResult(IntSeq, IntSeq, IntSeq, IntSeq) [function]
+  rule outerResult(.IntSeq, R:IntSeq, W:IntSeq, O:IntSeq)
+    => O ==K seqConcat(R, W)
+  rule outerResult(
+         iCons(32, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => outerResult(
+         S,
+         seqConcat(seqConcat(R, W), iCons(32, .IntSeq)),
+         .IntSeq,
+         O)
+  rule outerResult(
+         iCons(C:Int, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => insertThenOuter(W, C, S, R, O)
+    requires C =/=Int 32
+
+  // Relates an insertion-loop head to the word produced at loop exit.
+  syntax Bool ::= insertResult(
+                    IntSeq, Int, IntSeq, Bool, IntSeq) [function]
+
+  rule insertResult(
+         .IntSeq,
+         _:Int,
+         A:IntSeq,
+         true,
+         I:IntSeq)
+    => I ==K A
+  rule insertResult(
+         .IntSeq,
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => I ==K seqConcat(A, iCons(C, .IntSeq))
+
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(
+           seqConcat(A, iCons(C, .IntSeq)),
+           iCons(OLD, .IntSeq)),
+         true,
+         I)
+    requires C <Int OLD
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         false,
+         I)
+    requires C >=Int OLD
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         true,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         true,
+         I)
+
+  // Existential composition of the independently verified insertion with
+  // the remaining outer scan.
+  syntax Bool ::= insertThenOuter(
+                    IntSeq, Int, IntSeq, IntSeq, IntSeq)
+                  [function, no-evaluators]
+  rule {
+         insertThenOuter(
+           @W:IntSeq,
+           @C:Int,
+           @S:IntSeq,
+           @R:IntSeq,
+           @O:IntSeq)
+         #Equals true
+       }
+    => #Exists I:IntSeq .
+         ({ insertResult(@W, @C, .IntSeq, false, I) #Equals true }
+          #And { outerResult(@S, @R, I, @O) #Equals true })
+    [simplification]
+  rule {
+         true
+         #Equals
+         insertThenOuter(
+           @W:IntSeq,
+           @C:Int,
+           @S:IntSeq,
+           @R:IntSeq,
+           @O:IntSeq)
+       }
+    => #Exists I:IntSeq .
+         ({ insertResult(@W, @C, .IntSeq, false, I) #Equals true }
+          #And { outerResult(@S, @R, I, @O) #Equals true })
+    [simplification]
+endmodule

