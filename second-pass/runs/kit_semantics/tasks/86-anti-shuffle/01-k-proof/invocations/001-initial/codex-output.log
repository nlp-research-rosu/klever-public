+                 ("s", .ParamNames),
+                 Assign(Name("result"), Str(""))
+                 Assign(Name("word"), Str(""))
+                 For(
+                   Name("char"),
+                   Name("s"),
+                   If(
+                     Compare(Name("char"), CmpOp("==", Str(" "))),
+                     AugAssign(
+                       Name("result"),
+                       "+",
+                       Call(
+                         Attribute(Str(""), "join"),
+                         Call(
+                           Name("sorted"),
+                           Call(Name("list"), Name("word"), .Exprs),
+                           .Exprs),
+                         .Exprs))
+                     AugAssign(Name("result"), "+", Str(" "))
+                     Assign(Name("word"), Str(""))
+                     .Stmts,
+                     AugAssign(Name("word"), "+", Name("char"))
+                     .Stmts))
+                 AugAssign(
+                   Name("result"),
+                   "+",
+                   Call(
+                     Attribute(Str(""), "join"),
+                     Call(
+                       Name("sorted"),
+                       Call(Name("list"), Name("word"), .Exprs),
+                       .Exprs),
+                     .Exprs))
+                 Return(Name("result"))
+                 .Stmts,
+                 0),
+             parent(-1))
+      1 |-> scope(
+             ("s" |-> str(ORIGINAL:IntSeq))
+             ("char" |-> OLDCHAR:Val)
+             ("result" |-> str(R:IntSeq))
+             ("word" |-> str(W:IntSeq)),
+             parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(
+                 ("s", .ParamNames),
+                 Assign(Name("result"), Str(""))
+                 Assign(Name("word"), Str(""))
+                 For(
+                   Name("char"),
+                   Name("s"),
+                   If(
+                     Compare(Name("char"), CmpOp("==", Str(" "))),
+                     AugAssign(
+                       Name("result"),
+                       "+",
+                       Call(
