+        iCons(D:Int, .IntSeq))
+      => true
+    </k>
+    requires C <Int D
+
+  claim [single-char-str-lt-greater]:
+    <k>
+      strLt(
+        iCons(C:Int, .IntSeq),
+        iCons(D:Int, .IntSeq))
+      => false
+    </k>
+    requires C >Int D
+
+  claim [single-char-str-lt-equal]:
+    <k>
+      strLt(
