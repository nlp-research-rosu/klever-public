+                         Call(
+                           Name("sorted"),
+                           Call(Name("list"), Name("word"), .Exprs),
+                           .Exprs),
+                         .Exprs))
+                     AugAssign(Name("result"), "+", Str(" "))
+                     Assign(Name("word"), Str(""))
+                     .Stmts,
+                     AugAssign(Name("word"), "+", Name("char"))
+                     .Stmts))
+                 AugAssign(
+                   Name("result"),
+                   "+",
+                   Call(
+                     Attribute(Str(""), "join"),
+                     Call(
