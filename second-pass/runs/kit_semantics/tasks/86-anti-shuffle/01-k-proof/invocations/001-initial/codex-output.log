diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..673572b45010fb4f3dd0c3af7045b16b6baae9fd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,68 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports SET
+
+  // The fixed semantics deliberately keeps sortVS opaque during symbolic
+  // proofs.  This wrapper only names the exact value produced by
+  // ''.join(sorted(list(str(W)))).
+  syntax IntSeq ::= sortedWord(IntSeq) [function, total]
+  rule sortedWord(W:IntSeq)
+    => joinCodes(.IntSeq, sortVS(charsOf(W)))
+
+  // Exact result of finishing the character loop with:
+  //   remaining input S, completed output R, unfinished word W.
+  syntax IntSeq ::= antiGo(IntSeq, IntSeq, IntSeq) [function, total]
+  rule antiGo(.IntSeq, R:IntSeq, W:IntSeq)
+    => seqConcat(R, sortedWord(W))
+  rule antiGo(iCons(32, S:IntSeq), R:IntSeq, W:IntSeq)
+    => antiGo(
+         S,
+         seqConcat(seqConcat(R, sortedWord(W)), iCons(32, .IntSeq)),
+         .IntSeq)
+  rule antiGo(iCons(C:Int, S:IntSeq), R:IntSeq, W:IntSeq)
+    => antiGo(S, R, seqConcat(W, iCons(C, .IntSeq)))
+    requires C =/=Int 32
+
+  syntax IntSeq ::= antiShuffle(IntSeq) [function, total]
+  rule antiShuffle(S:IntSeq) => antiGo(S, .IntSeq, .IntSeq)
+
+  // Relational form of the same summary.  Keeping the output as an argument
+  // avoids relying on matching-logic equality normalization in reachability
+  // postconditions.
+  syntax Bool ::= antiResult(IntSeq, IntSeq, IntSeq, IntSeq)
+                  [function, total]
+  rule antiResult(.IntSeq, R:IntSeq, W:IntSeq, O:IntSeq)
+    => O ==K seqConcat(R, sortedWord(W))
+  rule antiResult(
+         iCons(32, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => antiResult(
+         S,
+         seqConcat(seqConcat(R, sortedWord(W)), iCons(32, .IntSeq)),
+         .IntSeq,
+         O)
+  rule antiResult(
+         iCons(C:Int, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => antiResult(S, R, seqConcat(W, iCons(C, .IntSeq)), O)
+    requires C =/=Int 32
+
+  // Reconstruct the heap generated by sequential allocations.  HS stores
+  // allocated values newest first and N is the next location.
+  syntax Map ::= heapRev(Int, ValSeq) [function, total]
+  rule heapRev(_:Int, .ValSeq) => .Map
+  rule heapRev(N:Int, vCons(V:Val, HS:ValSeq))
+    => ((N -Int 1) |-> V) heapRev(N -Int 1, HS)
+
+  // Derived by induction on HS: every key of heapRev(N, HS) is below N.
+  // This is allocator bookkeeping only; it does not characterize the result.
+  rule I:Int in_keys(heapRev(N:Int, HS:ValSeq)) => false
+    requires I >=Int N
+    [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..e9b035a8b9440d5ab050049202bec063f931ac7d
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,19 @@
+def anti_shuffle(s):
+    result = ''
+    word = ''
+    for char in s:
+        if char == ' ':
+            result += ''.join(sorted(list(word)))
+            result += ' '
+            word = ''
+        else:
+            word += char
+    result += ''.join(sorted(list(word)))
+    return result
+
+
+assert anti_shuffle('Hi') == 'Hi'
+assert anti_shuffle('hello') == 'ehllo'
+assert anti_shuffle('Hello World!!!') == 'Hello !!!Wdlor'
+assert anti_shuffle('') == ''
+assert anti_shuffle('  cba  a') == '  abc  a'
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..87cdec5763bf0fe6ed367e54d2a0ffee60badd78
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def anti_shuffle(s):
+    # `word` is the unfinished word; `result` contains all prior words/spaces.
+    result = ''
+    word = ''
+    for char in s:
+        if char == ' ':
+            result += ''.join(sorted(list(word)))
+            result += ' '
+            word = ''
+        else:
+            word += char
+    result += ''.join(sorted(list(word)))
+    return result
