+    result = ''
+    word = ''
+    char = ''
+    new_word = ''
+    inserted = False
+    old_char = ''
+    for char in s:
+        if char == ' ':
+            result += word
+            result += ' '
+            word = ''
+        else:
+            new_word = ''
+            inserted = False
