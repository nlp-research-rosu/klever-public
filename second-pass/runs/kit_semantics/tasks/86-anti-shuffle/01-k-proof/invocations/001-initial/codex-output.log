+  // OS/R = remaining outer input/completed output, O = final output.
+  syntax Bool ::= innerThenOuter(
+                    IntSeq, Int, IntSeq, Bool,
+                    IntSeq, IntSeq, IntSeq) [function]
+
+  rule innerThenOuter(
+         .IntSeq,
+         _:Int,
+         A:IntSeq,
+         true,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => outerResult(OS, R, A, O)
+  rule innerThenOuter(
+         .IntSeq,
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => outerResult(
+         OS,
+         R,
+         seqConcat(A, iCons(C, .IntSeq)),
+         O)
+
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(
+           seqConcat(A, iCons(C, .IntSeq)),
+           iCons(OLD, .IntSeq)),
+         true,
+         OS,
+         R,
+         O)
+    requires C <Int OLD
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         false,
+         OS,
+         R,
+         O)
+    requires C >=Int OLD
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         true,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         true,
+         OS,
+         R,
+         O)
+endmodule

