diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ac064ca486b502ceafb01049042d8a43a115095b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,176 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Derived directly from MPY-STR's complete lexicographic cases: for two
+  // one-character strings, lexicographic order is integer-code order.
+  rule strLt(
+         iCons(C:Int, .IntSeq),
+         iCons(D:Int, .IntSeq))
+    => C <Int D
+    [simplification]
+
+  // Exact AST aliases for the translated implementation.  These construct
+  // syntax only; they do not summarize or replace execution.
+  syntax Stmts ::= antiInnerBody() [function, total]
+                 | antiPostInsert() [function, total]
+                 | antiOuterBody() [function, total]
+                 | antiTail() [function, total]
+                 | antiBody() [function, total]
+
+  rule antiInnerBody()
+    => If(
+         BoolOp(
+           "and",
+           (UnaryOp("not", Name("inserted")),
+            Compare(Name("char"), CmpOp("<", Name("old_char"))),
+            .Exprs)),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       AugAssign(Name("new_word"), "+", Name("old_char"))
+       .Stmts
+
+  rule antiPostInsert()
+    => If(
+         UnaryOp("not", Name("inserted")),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       Assign(Name("word"), Name("new_word"))
+       .Stmts
+
+  rule antiOuterBody()
+    => If(
+         Compare(Name("char"), CmpOp("==", Str(" "))),
+         AugAssign(Name("result"), "+", Name("word"))
+         AugAssign(Name("result"), "+", Str(" "))
+         Assign(Name("word"), Str(""))
+         .Stmts,
+         Assign(Name("new_word"), Str(""))
+         Assign(Name("inserted"), Bool(false))
+         For(Name("old_char"), Name("word"), antiInnerBody())
+         antiPostInsert())
+       .Stmts
+
+  rule antiTail()
+    => AugAssign(Name("result"), "+", Name("word"))
+       Return(Name("result"))
+       .Stmts
+
+  rule antiBody()
+    => Assign(Name("result"), Str(""))
+       Assign(Name("word"), Str(""))
+       Assign(Name("char"), Str(""))
+       Assign(Name("new_word"), Str(""))
+       Assign(Name("inserted"), Bool(false))
+       Assign(Name("old_char"), Str(""))
+       For(Name("char"), Name("s"), antiOuterBody())
+       antiTail()
+
+  // Result relation at the outer character-loop head.
+  //
+  // S = unprocessed input, R = completed output, W = current sorted word,
+  // O = final output.
+  syntax Bool ::= outerResult(IntSeq, IntSeq, IntSeq, IntSeq) [function]
+  rule outerResult(.IntSeq, R:IntSeq, W:IntSeq, O:IntSeq)
+    => O ==K seqConcat(R, W)
+  rule outerResult(
+         iCons(32, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => outerResult(
+         S,
+         seqConcat(seqConcat(R, W), iCons(32, .IntSeq)),
+         .IntSeq,
+         O)
+  rule outerResult(
+         iCons(C:Int, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => insertThenOuter(W, C, S, R, O)
+    requires C =/=Int 32
+
+  // Relates an insertion-loop head to the word produced at loop exit.
+  syntax Bool ::= insertResult(
+                    IntSeq, Int, IntSeq, Bool, IntSeq) [function]
+
+  rule insertResult(
+         .IntSeq,
+         _:Int,
+         A:IntSeq,
+         true,
+         I:IntSeq)
+    => I ==K A
+  rule insertResult(
+         .IntSeq,
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => I ==K seqConcat(A, iCons(C, .IntSeq))
+
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(
+           seqConcat(A, iCons(C, .IntSeq)),
+           iCons(OLD, .IntSeq)),
+         true,
+         I)
+    requires C <Int OLD
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         false,
+         I)
+    requires C >=Int OLD
+  rule insertResult(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         true,
+         I:IntSeq)
+    => insertResult(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         true,
+         I)
+
+  // Existential composition of the independently verified insertion with
+  // the remaining outer scan.
+  syntax Bool ::= insertThenOuter(
+                    IntSeq, Int, IntSeq, IntSeq, IntSeq) [function]
+  rule {
+         insertThenOuter(
+           @W:IntSeq,
+           @C:Int,
+           @S:IntSeq,
+           @R:IntSeq,
+           @O:IntSeq)
+         #Equals true
+       }
+    => #Exists I:IntSeq .
+         ({ insertResult(@W, @C, .IntSeq, false, I) #Equals true }
+          #And { outerResult(@S, @R, I, @O) #Equals true })
+    [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..c96fbdd4a738c4b0c1f69e6ca68ce1ada9889f90
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,33 @@
+def anti_shuffle(s):
+    result = ''
+    word = ''
+    char = ''
+    new_word = ''
+    inserted = False
+    old_char = ''
+    for char in s:
+        if char == ' ':
+            result += word
+            result += ' '
+            word = ''
+        else:
+            new_word = ''
+            inserted = False
+            for old_char in word:
+                if not inserted and char < old_char:
+                    new_word += char
+                    inserted = True
+                new_word += old_char
+            if not inserted:
+                new_word += char
+                inserted = True
+            word = new_word
+    result += word
+    return result
+
+
+assert anti_shuffle('Hi') == 'Hi'
+assert anti_shuffle('hello') == 'ehllo'
+assert anti_shuffle('Hello World!!!') == 'Hello !!!Wdlor'
+assert anti_shuffle('') == ''
+assert anti_shuffle('  cba  a') == '  abc  a'
