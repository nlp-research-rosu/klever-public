new file mode 100644
index 0000000000000000000000000000000000000000..87cdec5763bf0fe6ed367e54d2a0ffee60badd78
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def anti_shuffle(s):
+    # `word` is the unfinished word; `result` contains all prior words/spaces.
+    result = ''
+    word = ''
+    for char in s:
+        if char == ' ':
+            result += ''.join(sorted(list(word)))
+            result += ' '
+            word = ''
+        else:
+            word += char
+    result += ''.join(sorted(list(word)))
+    return result
