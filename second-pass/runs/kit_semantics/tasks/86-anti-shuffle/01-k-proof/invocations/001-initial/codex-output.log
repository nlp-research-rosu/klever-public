+  syntax Bool ::= antiResult(IntSeq, IntSeq, IntSeq, IntSeq)
+                  [function, total]
+  rule antiResult(.IntSeq, R:IntSeq, W:IntSeq, O:IntSeq)
+    => O ==K seqConcat(R, sortedWord(W))
+  rule antiResult(
+         iCons(32, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => antiResult(
+         S,
+         seqConcat(seqConcat(R, sortedWord(W)), iCons(32, .IntSeq)),
+         .IntSeq,
+         O)
+  rule antiResult(
+         iCons(C:Int, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => antiResult(S, R, seqConcat(W, iCons(C, .IntSeq)), O)
+    requires C =/=Int 32
+
+  // Reconstruct the heap generated by sequential allocations.  HS stores
+  // allocated values newest first and N is the next location.
+  syntax Map ::= heapRev(Int, ValSeq) [function, total]
+  rule heapRev(_:Int, .ValSeq) => .Map
+  rule heapRev(N:Int, vCons(V:Val, HS:ValSeq))
+    => ((N -Int 1) |-> V) heapRev(N -Int 1, HS)
+
+  // Derived by induction on HS: every key of heapRev(N, HS) is below N.
+  // This is allocator bookkeeping only; it does not characterize the result.
+  rule I:Int in_keys(heapRev(N:Int, HS:ValSeq)) => false
+    requires I >=Int N
+    [simplification]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
