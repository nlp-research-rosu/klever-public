+def anti_shuffle(s):
+    """
+    Sort the characters in each space-delimited word while preserving spaces.
+    """
+    result = ''
+    word = ''
+    for char in s:
+        if char == ' ':
+            result += ''.join(sorted(list(word)))
+            result += ' '
+            word = ''
+        else:
+            word += char
+    result += ''.join(sorted(list(word)))
+    return result

