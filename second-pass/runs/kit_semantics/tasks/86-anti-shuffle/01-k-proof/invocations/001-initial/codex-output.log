+      0 |-> scope(
+             "anti_shuffle" |->
+               closureVal(
+                 ("s", .ParamNames),
+                 Assign(Name("result"), Str(""))
+                 Assign(Name("word"), Str(""))
+                 For(
+                   Name("char"),
+                   Name("s"),
