diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..aac9ad46ddbfd9810ded1d934511fa3d503ce18c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,183 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Derived directly from MPY-STR's complete lexicographic cases: for two
+  // one-character strings, lexicographic order is integer-code order.
+  rule strLt(
+         iCons(C:Int, .IntSeq),
+         iCons(D:Int, .IntSeq))
+    => C <Int D
+    [simplification]
+
+  // Exact AST aliases for the translated implementation.  These construct
+  // syntax only; they do not summarize or replace execution.
+  syntax Stmts ::= antiInnerBody() [function, total]
+                 | antiPostInsert() [function, total]
+                 | antiOuterBody() [function, total]
+                 | antiTail() [function, total]
+                 | antiBody() [function, total]
+
+  rule antiInnerBody()
+    => If(
+         BoolOp(
+           "and",
+           (UnaryOp("not", Name("inserted")),
+            Compare(Name("char"), CmpOp("<", Name("old_char"))),
+            .Exprs)),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       AugAssign(Name("new_word"), "+", Name("old_char"))
+       .Stmts
+
+  rule antiPostInsert()
+    => If(
+         UnaryOp("not", Name("inserted")),
+         AugAssign(Name("new_word"), "+", Name("char"))
+         Assign(Name("inserted"), Bool(true))
+         .Stmts,
+         .Stmts)
+       Assign(Name("word"), Name("new_word"))
+       .Stmts
+
+  rule antiOuterBody()
+    => If(
+         Compare(Name("char"), CmpOp("==", Str(" "))),
+         AugAssign(Name("result"), "+", Name("word"))
+         AugAssign(Name("result"), "+", Str(" "))
+         Assign(Name("word"), Str(""))
+         .Stmts,
+         Assign(Name("new_word"), Str(""))
+         Assign(Name("inserted"), Bool(false))
+         For(Name("old_char"), Name("word"), antiInnerBody())
+         antiPostInsert())
+       .Stmts
+
+  rule antiTail()
+    => AugAssign(Name("result"), "+", Name("word"))
+       Return(Name("result"))
+       .Stmts
+
+  rule antiBody()
+    => Assign(Name("result"), Str(""))
+       Assign(Name("word"), Str(""))
+       Assign(Name("char"), Str(""))
+       Assign(Name("new_word"), Str(""))
+       Assign(Name("inserted"), Bool(false))
+       Assign(Name("old_char"), Str(""))
+       For(Name("char"), Name("s"), antiOuterBody())
+       antiTail()
+
+  // Result relation at the outer character-loop head.
+  //
+  // S = unprocessed input, R = completed output, W = current sorted word,
+  // O = final output.
+  syntax Bool ::= outerResult(IntSeq, IntSeq, IntSeq, IntSeq) [function]
+  rule outerResult(.IntSeq, R:IntSeq, W:IntSeq, O:IntSeq)
+    => O ==K seqConcat(R, W)
+  rule outerResult(
+         iCons(32, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => outerResult(
+         S,
+         seqConcat(seqConcat(R, W), iCons(32, .IntSeq)),
+         .IntSeq,
+         O)
+  rule outerResult(
+         iCons(C:Int, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(W, C, .IntSeq, false, S, R, O)
+    requires C =/=Int 32
+
+  // Result relation at the insertion-loop head.
+  //
+  // IS = unprocessed old word, C = character being inserted,
+  // A = constructed new word, B = whether C has already been inserted,
+  // OS/R = remaining outer input/completed output, O = final output.
+  syntax Bool ::= innerThenOuter(
+                    IntSeq, Int, IntSeq, Bool,
+                    IntSeq, IntSeq, IntSeq) [function]
+
+  rule innerThenOuter(
+         .IntSeq,
+         _:Int,
+         A:IntSeq,
+         true,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => outerResult(OS, R, A, O)
+  rule innerThenOuter(
+         .IntSeq,
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => outerResult(
+         OS,
+         R,
+         seqConcat(A, iCons(C, .IntSeq)),
+         O)
+
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(
+           seqConcat(A, iCons(C, .IntSeq)),
+           iCons(OLD, .IntSeq)),
+         true,
+         OS,
+         R,
+         O)
+    requires C <Int OLD
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         false,
+         OS,
+         R,
+         O)
+    requires C >=Int OLD
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         true,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         true,
+         OS,
+         R,
+         O)
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..c96fbdd4a738c4b0c1f69e6ca68ce1ada9889f90
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,33 @@
+def anti_shuffle(s):
+    result = ''
+    word = ''
+    char = ''
+    new_word = ''
+    inserted = False
+    old_char = ''
+    for char in s:
+        if char == ' ':
+            result += word
+            result += ' '
+            word = ''
+        else:
+            new_word = ''
+            inserted = False
+            for old_char in word:
+                if not inserted and char < old_char:
+                    new_word += char
+                    inserted = True
+                new_word += old_char
+            if not inserted:
+                new_word += char
+                inserted = True
+            word = new_word
+    result += word
+    return result
+
+
+assert anti_shuffle('Hi') == 'Hi'
+assert anti_shuffle('hello') == 'ehllo'
+assert anti_shuffle('Hello World!!!') == 'Hello !!!Wdlor'
+assert anti_shuffle('') == ''
+assert anti_shuffle('  cba  a') == '  abc  a'
