+  rule outerResult(
+         iCons(C:Int, S:IntSeq),
+         R:IntSeq,
+         W:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(W, C, .IntSeq, false, S, R, O)
+    requires C =/=Int 32
+
+  // Result relation at the insertion-loop head.
+  //
+  // IS = unprocessed old word, C = character being inserted,
+  // A = constructed new word, B = whether C has already been inserted,
+  // OS/R = remaining outer input/completed output, O = final output.
+  syntax Bool ::= innerThenOuter(
+                    IntSeq, Int, IntSeq, Bool,
+                    IntSeq, IntSeq, IntSeq) [function]
+
+  rule innerThenOuter(
+         .IntSeq,
+         _:Int,
+         A:IntSeq,
+         true,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => outerResult(OS, R, A, O)
+  rule innerThenOuter(
+         .IntSeq,
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => outerResult(
+         OS,
+         R,
+         seqConcat(A, iCons(C, .IntSeq)),
+         O)
+
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(
+           seqConcat(A, iCons(C, .IntSeq)),
+           iCons(OLD, .IntSeq)),
+         true,
+         OS,
+         R,
+         O)
+    requires C <Int OLD
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         false,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         false,
+         OS,
+         R,
+         O)
+    requires C >=Int OLD
+  rule innerThenOuter(
+         iCons(OLD:Int, IS:IntSeq),
+         C:Int,
+         A:IntSeq,
+         true,
+         OS:IntSeq,
+         R:IntSeq,
+         O:IntSeq)
+    => innerThenOuter(
+         IS,
+         C,
+         seqConcat(A, iCons(OLD, .IntSeq)),
+         true,
+         OS,
+         R,
+         O)
+endmodule

