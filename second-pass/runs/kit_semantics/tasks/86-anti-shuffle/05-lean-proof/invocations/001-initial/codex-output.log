+#define _GNU_SOURCE
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+ssize_t readlink(const char *path, char *buffer, size_t capacity) {
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0 &&
+      program_invocation_name != NULL && program_invocation_name[0] == '/') {
+    size_t app_length = strlen(program_invocation_name);
+    if (app_length > capacity) {
+      app_length = capacity;
+    }
+    memcpy(buffer, program_invocation_name, app_length);
+    return (ssize_t)app_length;
+  }
+  return syscall(SYS_readlink, path, buffer, capacity);
+}
