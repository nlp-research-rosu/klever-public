diff --git a//tmp/lean_app_path_shim.c b//tmp/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..b9f684d88228f1e28113b52bf3223fb1ba43746e
--- /dev/null
+++ b//tmp/lean_app_path_shim.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+
+typedef unsigned long size_t;
+typedef long ssize_t;
+
+extern size_t strlen(const char *text);
+extern int strncmp(const char *left, const char *right, size_t count);
+extern int strcmp(const char *left, const char *right);
+extern void *memcpy(void *destination, const void *source, size_t count);
+extern long syscall(long number, ...);
+
+#define SYS_readlink 89
+
+extern char *program_invocation_name;
+
+ssize_t readlink(const char *path, char *buffer, size_t capacity) {
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0 &&
+      program_invocation_name != (void *)0 &&
+      program_invocation_name[0] == '/') {
+    size_t app_length = strlen(program_invocation_name);
+    if (app_length > capacity) {
+      app_length = capacity;
+    }
+    memcpy(buffer, program_invocation_name, app_length);
+    return (ssize_t)app_length;
+  }
+  return syscall(SYS_readlink, path, buffer, capacity);
+}
