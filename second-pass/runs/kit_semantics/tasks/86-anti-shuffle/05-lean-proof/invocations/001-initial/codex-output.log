codex
The failure is environmental: this execution namespace has no `/proc/<current-pid>/exe`, while Lean 4.22’s `IO.appPath` unconditionally reads that path. I confirmed the same `ENOENT` from Python. I’ll use a temporary preload shim that returns the process’s actual absolute `argv[0]` only for that missing `/proc/.../exe` lookup; this leaves the pinned toolchain, project, Base, and proof sources unchanged.
apply patch
patch: completed
/tmp/lean_app_path_shim.c
diff --git a//tmp/lean_app_path_shim.c b//tmp/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..102ed253e485f9320f2d43f785aa04b5ce598102
--- /dev/null
+++ b//tmp/lean_app_path_shim.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+ssize_t readlink(const char *path, char *buffer, size_t capacity) {
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0 &&
+      program_invocation_name != NULL && program_invocation_name[0] == '/') {
+    size_t app_length = strlen(program_invocation_name);
+    if (app_length > capacity) {
+      app_length = capacity;
+    }
+    memcpy(buffer, program_invocation_name, app_length);
+    return (ssize_t)app_length;
+  }
+  return syscall(SYS_readlink, path, buffer, capacity);
