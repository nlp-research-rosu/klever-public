/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
expected = [r['source_rule_id'] for r in inv['rules']]
actual = [r['source_rule_id'] for r in out['rules']]
assert actual == expected
assert len(actual) == len(set(actual))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
by_id = {r['source_rule_id']: r for r in inv['rules']}
for item in out['rules']:
    assert list(item) == ['source_rule_id', 'classification', 'rationale']
    assert item['classification'] in allowed
    assert isinstance(item['rationale'], str) and item['rationale'].strip()
    if 'simplification' in by_id[item['source_rule_id']]['attributes']:
        assert item['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(x['classification'] for x in out['rules'])
assert counts == Counter({'DEFINITION': 8, 'DOMAIN_LEMMA': 1})
assert out['rules'][0]['classification'] == 'DOMAIN_LEMMA'
md = Path('/workspace/DISCOVERY.md').read_text()
assert 'domain-lemma set is **not empty**' in md
assert 'lemma-spec.k' in md and 'prove.sh' in md and '#Top' in md
print(f\"schema=valid rules={len(actual)} unique={len(set(actual))} order=canonical\")
print(f\"inventory_sha256={out['inventory_sha256']}\")
print('classifications=' + json.dumps(counts, sort_keys=True))
