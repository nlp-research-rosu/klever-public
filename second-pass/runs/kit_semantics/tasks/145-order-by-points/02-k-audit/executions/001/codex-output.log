+assert order_by_points([12, 21, 3, 30]) == [12, 21, 3, 30]
+assert order_by_points([100, -100, 10, -10, 1, -1, 0]) == [
+    -100,
+    -10,
+    -1,
+    0,
+    100,
+    10,
+    1,
+]

