+            )
+        helper_checked += 1
+
+    print(
+        "SUMMARY",
+        f"entry_cases={checked}",
+        f"helper_cases={helper_checked}",
+        "random_seed=1452026",
+        f"case_digest={digest.hexdigest()}",
+        "mismatches=0",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
