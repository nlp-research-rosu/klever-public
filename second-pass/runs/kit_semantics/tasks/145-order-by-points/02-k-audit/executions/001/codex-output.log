+                            (
+                                line_number,
+                                name,
+                                hashlib.sha256(arguments.encode()).hexdigest(),
+                            )
+                        )
+                if payload_type == "agent_message" and payload.get("phase") == "final_answer":
+                    final_messages.append(str(payload.get("message", "")))
+
