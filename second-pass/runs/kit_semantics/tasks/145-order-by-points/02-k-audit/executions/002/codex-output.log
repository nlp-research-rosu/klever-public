     requires N >=Int 10
-  rule lowerDigitSum(N:Int) => lowerDigitSum(0 -Int N)
+  rule lowerDigitSumAcc(N:Int, S:Int)
+    => lowerDigitSumAcc(0 -Int N, S)
     requires N <Int 0
*** Update File: /workspace/spec.k
