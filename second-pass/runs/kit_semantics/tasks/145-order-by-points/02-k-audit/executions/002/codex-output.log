index 0000000000000000000000000000000000000000..7c9e10cf5c044aa8d70169aa50608440d7d4c0ad
--- /dev/null
+++ b/evidence/stage6_nonvacuity_run.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/145-order-by-points-002
+evidence=/audit-output/evidence
+overall=0
+
+echo "SATISFYING WITNESS input=[1,11,-1,-11,-12]"
+echo "CORRECT result=[-1,-11,1,-12,11]"
