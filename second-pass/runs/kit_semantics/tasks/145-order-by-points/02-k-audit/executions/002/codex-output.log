+fi
+if ! rg -q '#Equals|0' "$evidence/stage4_body_sensitivity_proof.log"; then
+  echo "MISSING expected changed-result evidence"
+  overall=1
+fi
+
+echo "STAGE4 SCRIPT EXIT: $overall"
+exit "$overall"
