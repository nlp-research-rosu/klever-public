+canonical = load("canonical_witness", Path("/reference/canonical.py"))
+candidate = load(
+    "candidate_witness",
+    Path("/tmp/audit-work/145-order-by-points-002/solution.py"),
+)
+
+list_witnesses = [
+    [1, 11, -1, -11, -12],
+    [],
+    [1, 10, 100, 2, 20, 200],
+    [-12, -21, -30, -3, -102, -120, -201, -210],
