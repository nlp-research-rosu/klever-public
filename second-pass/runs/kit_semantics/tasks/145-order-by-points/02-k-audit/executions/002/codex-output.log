diff --git a/evidence/trace_commands.py b/evidence/trace_commands.py
new file mode 100644
index 0000000000000000000000000000000000000000..e8d815e686754f6380239eb9e5c1f16d80a04e8d
--- /dev/null
+++ b/evidence/trace_commands.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+import json
+from pathlib import Path
+
+
+trace_root = Path("/generation-evidence/codex-trace")
+
+
+def bounded(value, limit=4000):
+    text = str(value)
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n...[truncated {len(text) - limit} characters]"
+
+
+for path in sorted(trace_root.rglob("*.jsonl")):
+    print(f"TRACE FILE {path}")
+    with path.open(encoding="utf-8") as stream:
+        for line_number, line in enumerate(stream, 1):
+            record = json.loads(line)
+            payload = record.get("payload", {})
+            payload_type = payload.get("type")
+            if payload_type in {
+                "function_call",
+                "function_call_output",
+                "custom_tool_call",
+                "custom_tool_call_output",
+                "agent_message",
+            }:
+                print(f"LINE {line_number} TYPE {payload_type}")
+                if payload_type == "function_call":
+                    print(f"NAME {payload.get('name')}")
+                    print(bounded(payload.get("arguments", "")))
+                elif payload_type == "function_call_output":
+                    print(bounded(payload.get("output", "")))
+                elif payload_type == "custom_tool_call":
+                    print(f"NAME {payload.get('name')}")
+                    print(bounded(payload.get("input", "")))
+                elif payload_type == "custom_tool_call_output":
+                    print(bounded(payload.get("output", "")))
+                else:
+                    print(bounded(payload.get("message", "")))

exec
/bin/bash -lc "python3 - <<'PY'
import hashlib,itertools,os,stat
from pathlib import Path
root=Path('/reference/reference-semantics')
target='1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de'
files=sorted([p for p in root.rglob('*') if p.is_file()],key=lambda p:p.relative_to(root).as_posix())
dirs=sorted([p for p in root.rglob('*') if p.is_dir()],key=lambda p:p.relative_to(root).as_posix())
rels=lambda ps,dot:[(('./' if dot else '')+p.relative_to(root).as_posix(),p) for p in ps]
seps=[b'',b'\\0',b'\\n',b' ',b'  ']
for dot,include_dirs,kind_mode,content_mode,sep1,sep2 in itertools.product([0,1],[0,1],range(5),range(6),seps,seps):
    entries=rels((dirs+files if include_dirs else files),dot)
    entries.sort()
    h=hashlib.sha256()
    for rel,p in entries:
        isdir=p.is_dir()
        if kind_mode==0: pre=b''
        elif kind_mode==1: pre=(b'directory' if isdir else b'file')
        elif kind_mode==2: pre=(b'D' if isdir else b'F')
        elif kind_mode==3: pre=(b'd' if isdir else b'f')
        else: pre=(b'40000' if isdir else b'100644')
        data=b'' if isdir else p.read_bytes()
        if content_mode==0: val=data
        elif content_mode==1: val=hashlib.sha256(data).hexdigest().encode()
        elif content_mode==2: val=hashlib.sha256(data).digest()
        elif content_mode==3: val=str(len(data)).encode()+b' '+hashlib.sha256(data).hexdigest().encode()
        elif content_mode==4: val=str(len(data)).encode()
        else: val=(b'' if isdir else hashlib.sha256(data).hexdigest().encode()+b'  '+rel.encode())
        h.update(pre+sep1+rel.encode()+sep2+val)
    if h.hexdigest()==target:
        print('FOUND',dot,include_dirs,kind_mode,content_mode,sep1,sep2);raise SystemExit
print('not found')
PY" in /audit-output
