+      ~> Call(
+           Name("order_by_points"),
+           (list(
+             vCons(1,
+             vCons(11,
+             vCons(-1,
+             vCons(-11,
+             vCons(-12, .ValSeq)))))), .Exprs))
+      => ref(0)
