+      .Map
+      =>
+      0 |-> list(
+        revVS(
+          expectedOrder(
+            vCons(1,
+            vCons(11,
+            vCons(-1,
+            vCons(-11,
+            vCons(-12, .ValSeq))))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
