+      =>
+        0 |-> scope(
+          "digit_sum" |-> closureVal("number", digitSumBody, 0)
+          "order_by_points" |->
+            closureVal("nums", orderByPointsBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        revVS(
+          expectedOrder(
+            vCons(1,
+            vCons(11,
+            vCons(-1,
+            vCons(-11,
+            vCons(-12, .ValSeq))))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
