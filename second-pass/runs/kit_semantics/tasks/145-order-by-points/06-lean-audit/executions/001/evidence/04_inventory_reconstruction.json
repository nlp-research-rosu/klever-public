{
  "inventory_sha256": "d1938e7b1244c903982851964801e608d93aaaa374c0212142e8a48ca89529d1",
  "rules": [
    {
      "attributes": [],
      "end_line": 11,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "664c5cffd59c4d15b07d7fe6963f00cf5c76f67667d8d821ffde854f571a8012",
      "source_rule_id": "rule-664c5cffd59c4d15b07d7fe6963f00cf5c76f67667d8d821ffde854f571a8012",
      "start_line": 8,
      "text": "  rule digitSumLoopBody =>\n      AugAssign(Name(\"total\"), \"+\",\n        BinOp(\"%\", Name(\"number\"), Int(10)))\n      AugAssign(Name(\"number\"), \"//\", Int(10))"
    },
    {
      "attributes": [],
      "end_line": 23,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "37a274447eef3c1ee182a04b21215a965bc6dfb48a8d775adac404e38ed35b2e",
      "source_rule_id": "rule-37a274447eef3c1ee182a04b21215a965bc6dfb48a8d775adac404e38ed35b2e",
      "start_line": 14,
      "text": "  rule digitSumBody =>\n      If(Compare(Name(\"number\"), CmpOp(\"<\", Int(0))),\n        Assign(Name(\"sign\"), UnaryOp(\"-\", Int(1)))\n        Assign(Name(\"number\"), UnaryOp(\"-\", Name(\"number\"))),\n        Assign(Name(\"sign\"), Int(1)))\n      Assign(Name(\"total\"), Int(0))\n      While(Compare(Name(\"number\"), CmpOp(\">=\", Int(10))),\n        digitSumLoopBody)\n      Return(BinOp(\"+\", Name(\"total\"),\n        BinOp(\"*\", Name(\"sign\"), Name(\"number\"))))"
    },
    {
      "attributes": [],
      "end_line": 28,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "d10f1357927738dce878b76dcd6916c350886d346342c7e1507243e50c56b398",
      "source_rule_id": "rule-d10f1357927738dce878b76dcd6916c350886d346342c7e1507243e50c56b398",
      "start_line": 26,
      "text": "  rule orderByPointsBody =>\n      Return(Call(Name(\"sorted\"), Name(\"nums\"),\n        KwArg(\"key\", Name(\"digit_sum\"))))"
    },
    {
      "attributes": [],
      "end_line": 34,
      "module": "VERIFICATION-SYNTAX",
      "normalized_sha256": "2bcc3a782cae89edaedc8c1c582e99adc92dd5b52e6e4293aaa849284675298e",
      "source_rule_id": "rule-2bcc3a782cae89edaedc8c1c582e99adc92dd5b52e6e4293aaa849284675298e",
      "start_line": 31,
      "text": "  rule solutionModule =>\n      Module(\n        FuncDef(\"digit_sum\", Params(\"number\"), digitSumBody)\n        FuncDef(\"order_by_points\", Params(\"nums\"), orderByPointsBody))"
    },
    {
      "attributes": [],
