+  if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+    return 0;
+  }
+  p = path + 6;
+  if (!isdigit((unsigned char)*p)) {
+    return 0;
+  }
+  while (isdigit((unsigned char)*p)) {
+    p++;
+  }
+  return strcmp(p, "/exe") == 0;
+}
