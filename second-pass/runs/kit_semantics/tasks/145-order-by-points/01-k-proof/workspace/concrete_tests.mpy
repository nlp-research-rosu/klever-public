Module(
  FuncDef("digit_sum", Params("number"),
    If(Compare(Name("number"), CmpOp("<", Int(0))),
      Assign(Name("sign"), UnaryOp("-", Int(1)))
      Assign(Name("number"), UnaryOp("-", Name("number"))),
      Assign(Name("sign"), Int(1)))
    Assign(Name("total"), Int(0))
    While(Compare(Name("number"), CmpOp(">=", Int(10))),
      AugAssign(Name("total"), "+", BinOp("%", Name("number"), Int(10)))
      AugAssign(Name("number"), "//", Int(10)))
    Return(
      BinOp(
        "+",
        Name("total"),
        BinOp("*", Name("sign"), Name("number")))))
  FuncDef("order_by_points", Params("nums"),
    Return(
      Call(
        Name("sorted"),
        Name("nums"),
        KwArg("key", Name("digit_sum")))))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(1),
          Int(11),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(11)),
          UnaryOp("-", Int(12)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(11)),
          Int(1),
          UnaryOp("-", Int(12)),
          Int(11)))))
  Assert(
    Compare(
      Call(Name("order_by_points"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(0),
          UnaryOp("-", Int(10)),
          Int(10),
          UnaryOp("-", Int(1)),
          Int(1))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(10)),
          UnaryOp("-", Int(1)),
          Int(0),
          Int(10),
          Int(1)))))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(100),
          Int(10),
          Int(1),
          UnaryOp("-", Int(100)),
          UnaryOp("-", Int(10)),
          UnaryOp("-", Int(1)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(100)),
          UnaryOp("-", Int(10)),
          UnaryOp("-", Int(1)),
          Int(100),
          Int(10),
          Int(1))))))
