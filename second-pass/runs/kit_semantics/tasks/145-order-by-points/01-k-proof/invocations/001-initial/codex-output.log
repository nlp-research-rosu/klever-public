+          "order_by_points" |->
+            closureVal("nums", orderByPointsBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(1,
+        vCons(11,
+        vCons(-1,
+        vCons(-11,
+        vCons(-12, .ValSeq))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
