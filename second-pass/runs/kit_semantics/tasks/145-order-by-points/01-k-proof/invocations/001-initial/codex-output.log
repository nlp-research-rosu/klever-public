diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f2c909bee8525ca25f0ecbb125a1a52708a6d554
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,90 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+mkdir -p proof-logs
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+python3 validate.py 2>&1 | tee proof-logs/python-validation.out
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled \
+  2>&1 | tee proof-logs/llvm-kompile.out
+
+krun concrete_tests.mpy \
+  --definition runtime-kompiled \
+  2>&1 | tee proof-logs/concrete-krun.out
+rg -U -q '<exc>[[:space:]]+NoExc[[:space:]]+</exc>' \
+  proof-logs/concrete-krun.out
+rg -U -q '<exit-code>[[:space:]]+0[[:space:]]+</exit-code>' \
+  proof-logs/concrete-krun.out
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  2>&1 | tee proof-logs/haskell-kompile.out
+
+kast solution.mpy \
+  --definition verification-kompiled \
+  --module VERIFICATION-SYNTAX \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  > solution.kore
+kast \
+  --expression solutionModule \
+  --definition verification-kompiled \
+  --module VERIFICATION-SYNTAX \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  > verification-solution.kore
+diff -u solution.kore verification-solution.kore \
+  > proof-logs/program-identity.diff
+echo "KORE program identity: identical" \
+  | tee proof-logs/program-identity.out
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  2>&1 | tee proof-logs/kprove.out
+rg -q '^#Top$' proof-logs/kprove.out
+
+set +e
+kprove mutation-spec.k \
+  --definition verification-kompiled \
+  --spec-module MUTATION-SPEC \
+  --claims MUTATION-SPEC.digit-sum-body-mutation \
+  > proof-logs/mutation-body.out 2>&1
+mutation_body_status=$?
+set -e
+if [ "$mutation_body_status" -eq 0 ]; then
+  echo "unexpected success: digit-sum body mutation" >&2
+  exit 1
+fi
+rg -q 'WarnStuckClaimState' proof-logs/mutation-body.out
+echo "digit-sum body mutation: expected exit $mutation_body_status" \
+  | tee proof-logs/mutation-body-status.out
+
+set +e
+kprove mutation-spec.k \
+  --definition verification-kompiled \
+  --spec-module MUTATION-SPEC \
+  --claims MUTATION-SPEC.target-postcondition-mutation \
+  > proof-logs/mutation-postcondition.out 2>&1
+mutation_postcondition_status=$?
+set -e
+if [ "$mutation_postcondition_status" -eq 0 ]; then
+  echo "unexpected success: target postcondition mutation" >&2
+  exit 1
+fi
+rg -q 'WarnStuckClaimState' proof-logs/mutation-postcondition.out
+echo "target postcondition mutation: expected exit $mutation_postcondition_status" \
+  | tee proof-logs/mutation-postcondition-status.out
+
+echo "all positive proofs and validation checks passed"
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..afdce9fd6d604c94c88e12a3483d2bfabc89b44c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,15 @@
+def digit_sum(number):
+    if number < 0:
+        sign = -1
+        number = -number
+    else:
+        sign = 1
+    total = 0
+    while number >= 10:
+        total += number % 10
+        number //= 10
+    return total + sign * number
+
+
+def order_by_points(nums):
+    return sorted(nums, key=digit_sum)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e3e736cd86d74d2f1d1a030ec03defc167eb24b4
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,78 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [digit-sum-loop]:
+    <k>
+      #while(
+        Compare(Name("number"), CmpOp(">=", Int(10))),
+        digitSumLoopBody
+      ) => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |-> scope(
+        "number" |-> (N:Int => leadingDigit(N))
+        "sign"   |-> SIGN:Int
+        "total"  |-> (S:Int => lowerDigitSumAcc(N, S)),
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0
+
+  claim [digit-sum-function]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("digit_sum"), (N:Int, .Exprs))
+      => signedDigitSum(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+        0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+        0 |-> scope(
+          "digit_sum" |-> closureVal("number", digitSumBody, 0)
+          "order_by_points" |->
+            closureVal("nums", orderByPointsBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [order-by-points]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("order_by_points"), (list(VS:ValSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+        0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+        0 |-> scope(
+          "digit_sum" |-> closureVal("number", digitSumBody, 0)
+          "order_by_points" |->
+            closureVal("nums", orderByPointsBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(expectedOrder(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..95d7c33991307444725e5226651d0630e0d68050
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,46 @@
+import ast
+import itertools
+from pathlib import Path
+import random
+
+from solution import digit_sum, order_by_points
+
+
+solution_tree = ast.parse(Path("solution.py").read_text(encoding="utf-8"))
+concrete_tree = ast.parse(Path("concrete_tests.py").read_text(encoding="utf-8"))
+assert ast.dump(solution_tree) == ast.dump(
+    ast.Module(body=concrete_tree.body[:2], type_ignores=[])
+)
+
+
+def oracle_digit_sum(number):
+    text = str(number)
+    if text[0] == "-":
+        return -int(text[1]) + sum(int(char) for char in text[2:])
+    return sum(int(char) for char in text)
+
+
+scalar_cases = 0
+for value in range(-10000, 10001):
+    assert digit_sum(value) == oracle_digit_sum(value)
+    scalar_cases += 1
+
+list_cases = 0
+pool = [-101, -20, -12, -11, -1, 0, 1, 2, 10, 11, 12, 20, 101]
+for length in range(5):
+    for values in itertools.product(pool[:5], repeat=length):
+        expected = sorted(values, key=oracle_digit_sum)
+        assert order_by_points(list(values)) == list(expected)
+        list_cases += 1
+
+rng = random.Random(20260725)
+for _ in range(1000):
+    values = [rng.randint(-10**12, 10**12) for _ in range(rng.randrange(0, 30))]
+    expected = sorted(values, key=oracle_digit_sum)
+    assert order_by_points(values) == expected
+    list_cases += 1
+
+print(
+    "validated exact concrete-test body identity, "
+    f"{scalar_cases} digit keys, and {list_cases} stable sorts"
+)
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ca2776992513b95a7eeecaffc2e07409239ba445
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,98 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  // Exact syntactic abbreviations for the two bodies in solution.mpy.
+  syntax Stmts ::= "digitSumLoopBody" [macro]
+  rule digitSumLoopBody =>
+      AugAssign(Name("total"), "+",
+        BinOp("%", Name("number"), Int(10)))
+      AugAssign(Name("number"), "//", Int(10))
+
+  syntax Stmts ::= "digitSumBody" [macro]
+  rule digitSumBody =>
+      If(Compare(Name("number"), CmpOp("<", Int(0))),
+        Assign(Name("sign"), UnaryOp("-", Int(1)))
+        Assign(Name("number"), UnaryOp("-", Name("number"))),
+        Assign(Name("sign"), Int(1)))
+      Assign(Name("total"), Int(0))
+      While(Compare(Name("number"), CmpOp(">=", Int(10))),
+        digitSumLoopBody)
+      Return(BinOp("+", Name("total"),
+        BinOp("*", Name("sign"), Name("number"))))
+
+  syntax Stmts ::= "orderByPointsBody" [macro]
+  rule orderByPointsBody =>
+      Return(Call(Name("sorted"), Name("nums"),
+        KwArg("key", Name("digit_sum"))))
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule =>
+      Module(
+        FuncDef("digit_sum", Params("number"), digitSumBody)
+        FuncDef("order_by_points", Params("nums"), orderByPointsBody))
+
+  // Mathematical summaries used by the claims.
+  syntax Int ::= magnitude(Int) [function, total]
+               | leadingDigit(Int) [function, total]
+               | lowerDigitSum(Int) [function, total]
+               | lowerDigitSumAcc(Int, Int) [function, total]
+               | signedDigitSum(Int) [function, total]
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+
+  // The intended stable ordering, conditional on the supplied semantics'
+  // contract for the external Python primitive sorted(..., key=...).
+  syntax ValSeq ::= expectedOrder(ValSeq) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+
+  rule magnitude(N:Int) => N
+    requires N >=Int 0
+  rule magnitude(N:Int) => 0 -Int N
+    requires N <Int 0
+
+  rule leadingDigit(N:Int) => N
+    requires 0 <=Int N andBool N <Int 10
+  rule leadingDigit(N:Int)
+    => leadingDigit((N -Int pyMod(N, 10)) /Int 10)
+    requires N >=Int 10
+  rule leadingDigit(N:Int) => leadingDigit(0 -Int N)
+    requires N <Int 0
+
+  rule lowerDigitSum(N:Int) => lowerDigitSumAcc(N, 0)
+    requires N >=Int 0
+  rule lowerDigitSum(N:Int) => lowerDigitSumAcc(0 -Int N, 0)
+    requires N <Int 0
+
+  rule lowerDigitSumAcc(N:Int, S:Int) => S
+    requires 0 <=Int N andBool N <Int 10
+  rule lowerDigitSumAcc(N:Int, S:Int)
+    => lowerDigitSumAcc(
+         (N -Int pyMod(N, 10)) /Int 10,
+         S +Int pyMod(N, 10))
+    requires N >=Int 10
+  rule lowerDigitSumAcc(N:Int, S:Int)
+    => lowerDigitSumAcc(0 -Int N, S)
+    requires N <Int 0
+
+  rule signedDigitSum(N:Int)
+    => lowerDigitSum(magnitude(N)) +Int leadingDigit(magnitude(N))
+    requires N >=Int 0
+  rule signedDigitSum(N:Int)
+    => lowerDigitSum(magnitude(N)) -Int leadingDigit(magnitude(N))
+    requires N <Int 0
+
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(_:Int, REST:ValSeq)) => allInts(REST)
+  rule allInts(vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  rule expectedOrder(VS:ValSeq)
+    => sortKeyVS(
+         VS,
+         closureVal("number", digitSumBody, 0))
+endmodule

exec
/bin/bash -lc ./prove.sh in /workspace
