     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  syntax Bool ::= numericVal(Val) [function, total]
     7	  rule numericVal(V:Val)
     8	    => isInt(V) orBool isBool(V) orBool isFloat(V)
     9	
    10	  syntax Bool ::= numericSeq(ValSeq) [function, total]
    11	  rule numericSeq(.ValSeq) => true
    12	  rule numericSeq(vCons(V:Val, REST:ValSeq))
    13	    => numericVal(V) andBool numericSeq(REST)
    14	
    15	  // Total comparison summary. The first three equations are exactly the
    16	  // corresponding fixed-semantics applyCmp("<", _, Int) cases.
    17	  syntax Bool ::= numericLt(Val, Int) [function, total]
    18	  rule numericLt(I:Int, T:Int)   => I <Int T
    19	  rule numericLt(B:Bool, T:Int)  => boolAsInt(B) <Int T
    20	  rule numericLt(F:Float, T:Int) => ltFI(F, T)
    21	  rule numericLt(_:Val, _:Int)   => false [owise]
    22	
    23	  syntax Bool ::= allBelow(ValSeq, Int) [function, total]
    24	  rule allBelow(.ValSeq, _:Int) => true
    25	  rule allBelow(vCons(V:Val, REST:ValSeq), T:Int)
    26	    => numericLt(V, T) andBool allBelow(REST, T)
    27	
    28	  // Exact final value of the source-level loop variable. This state summary is
    29	  // needed because MPY represents frame deletion as a symbolic map update.
    30	  syntax Val ::= lastVisited(ValSeq, Val, Int) [function, total]
    31	  rule lastVisited(.ValSeq, OLD:Val, _:Int) => OLD
    32	  rule lastVisited(vCons(V:Val, REST:ValSeq), _:Val, T:Int)
    33	    => #if numericLt(V, T)
    34	       #then lastVisited(REST, V, T)
    35	       #else V
    36	       #fi
    37	endmodule
