+            "inventory_header": {
+                key: value for key, value in inventory.items() if key != "rules"
+            },
+            "checks": checks,
+            "rules": details,
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)
+
+if not all(checks.values()):
+    raise SystemExit(1)
