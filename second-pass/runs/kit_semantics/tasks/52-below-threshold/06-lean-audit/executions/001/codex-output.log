            "MODEL": str(run_manifest["model"]),
            "EFFORT": str(run_manifest["effort"]),
            "TIMEOUT_S": str(invocation.allocation_s),
            "KIT": "1" if kit else "0",
        }
    )
    process = subprocess.run(command, env=environment)
    try:
        try:
