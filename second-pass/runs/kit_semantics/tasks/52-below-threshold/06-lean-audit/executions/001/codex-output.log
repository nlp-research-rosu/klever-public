        except Stage1RunnerError:
            return InvocationOutcome(
                exit_code=(
                    process.returncode if process.returncode != 0 else 70
                ),
                duration_s=0,
                timeout_marker=False,
                oom_killed=False,
                image_id="UNAVAILABLE",
            )

