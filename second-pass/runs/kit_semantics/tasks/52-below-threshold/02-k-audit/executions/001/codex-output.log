diff --git a//tmp/audit-work/reconstruction/model-gap-decimal.py b//tmp/audit-work/reconstruction/model-gap-decimal.py
new file mode 100644
index 0000000000000000000000000000000000000000..962f6d9b8596894f1050395db0e14a082d26b99a
--- /dev/null
+++ b//tmp/audit-work/reconstruction/model-gap-decimal.py
@@ -0,0 +1,16 @@
+from decimal import Decimal
+
+
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
+
+
+assert below_threshold([Decimal("1.5")], 2) == True
+assert below_threshold([Decimal("2.0")], 2) == False
+
