+fi
+
+printf '\n$ cd %q && kprove stage6-false-postcondition.k --definition fresh-verification-kompiled --spec-module STAGE6-FALSE-POSTCONDITION\n' "$work"
+(cd "$work" && kprove stage6-false-postcondition.k \
