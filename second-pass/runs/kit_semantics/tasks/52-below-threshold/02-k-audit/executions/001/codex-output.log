+#!/usr/bin/env bash
+set -u
+
+status=0
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf '[exit %d]\n' "$rc"
+  if [ "$rc" -ne 0 ]; then
+    status=1
+  fi
+}
+
+printf 'STAGE 2 PROGRAM FIDELITY AND DIFFERENTIAL\n'
+run sed -n 1,120p /reference/prompt.py
