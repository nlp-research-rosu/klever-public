diff --git a//tmp/audit-work/reconstruction/model-gap-decimal.py b//tmp/audit-work/reconstruction/model-gap-decimal.py
new file mode 100644
index 0000000000000000000000000000000000000000..962f6d9b8596894f1050395db0e14a082d26b99a
--- /dev/null
+++ b//tmp/audit-work/reconstruction/model-gap-decimal.py
@@ -0,0 +1,16 @@
+from decimal import Decimal
+
+
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
+
+
+assert below_threshold([Decimal("1.5")], 2) == True
+assert below_threshold([Decimal("2.0")], 2) == False
+
diff --git a//tmp/audit-work/reconstruction/reviewer-smoke.py b//tmp/audit-work/reconstruction/reviewer-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..8dec56b4ca9af6731da7c4f2afad14f4da7a7637
--- /dev/null
+++ b//tmp/audit-work/reconstruction/reviewer-smoke.py
@@ -0,0 +1,19 @@
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
+
+
+assert below_threshold([1, 2, 4, 10], 100) == True
+assert below_threshold([1, 20, 4, 10], 5) == False
+assert below_threshold([], 0) == True
+assert below_threshold([4], 5) == True
+assert below_threshold([5], 5) == False
+assert below_threshold([6], 5) == False
+assert below_threshold([-4, -3, -2], -2) == False
+assert below_threshold([False, True], 2) == True
+assert below_threshold([-2.5, 0.5, 4.5], 5) == True
diff --git a//tmp/audit-work/reconstruction/stage5-body-mutation.k b//tmp/audit-work/reconstruction/stage5-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..285ed731f8e0e235e8aa6e09909e5be411059fdb
--- /dev/null
+++ b//tmp/audit-work/reconstruction/stage5-body-mutation.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module STAGE5-BODY-MUTATION
+  imports VERIFICATION
+
+  // Reviewer mutation: `>` replaces `<`. On [1], 2 the mutated program
+  // returns false, so the docstring-determined true result must be rejected.
+  claim [changed-body]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("below_threshold", Params("l", "t"),
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp(">", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)))))
+      ~> Call(Name("below_threshold"), list(vCons(1, .ValSeq)), 2)
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
