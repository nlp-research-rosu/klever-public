+from decimal import Decimal
+
+
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
+
+
+assert below_threshold([Decimal("1.5")], 2) == True
+assert below_threshold([Decimal("2.0")], 2) == False
+
