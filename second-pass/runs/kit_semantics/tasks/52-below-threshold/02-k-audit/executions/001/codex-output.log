+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf '[exit %d]\n' "$rc"
+  if [ "$rc" -ne 0 ]; then
+    status=1
+  fi
+}
+
+printf 'STAGE 2 PROGRAM FIDELITY AND DIFFERENTIAL\n'
