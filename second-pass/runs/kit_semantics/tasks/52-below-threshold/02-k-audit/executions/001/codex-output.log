+  /reference/reference-semantics/semantics/float.k \
+  /candidate/base-verification.k /candidate/verification-loops.k \
+  /candidate/verification.k /candidate/connection-spec.k \
+  /candidate/loop-spec.k /candidate/spec.k
+
+exit "$status"

