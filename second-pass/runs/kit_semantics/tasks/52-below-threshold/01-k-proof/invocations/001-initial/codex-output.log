diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..e5e0cd678369d50e00a92453da536b54e81b417a
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
+
+
+assert below_threshold([1, 2, 4, 10], 100) == True
+assert below_threshold([1, 20, 4, 10], 5) == False
+assert below_threshold([], 0) == True
+assert below_threshold([5], 5) == False
+assert below_threshold([True, False], 2) == True
+assert below_threshold([1.5, -2.0], 2) == True
