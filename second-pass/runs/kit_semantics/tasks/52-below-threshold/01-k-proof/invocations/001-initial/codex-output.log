diff --git a/spec-mutation.k b/spec-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..6a9ed3b33f8e2e5ce1fbece604e4543c8659c50a
--- /dev/null
+++ b/spec-mutation.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC-MUTATION
+  imports VERIFICATION
+
+  // Material body mutation: using <= makes [5], 5 return true. The original
+  // contract requires false, so this connection/target claim must be rejected.
+  claim [changed-comparison]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("below_threshold", Params("l", "t"),
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<=", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)))))
+      ~> Call(Name("below_threshold"), list(vCons(5, .ValSeq)), 5)
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..15e75c4350411f2a24f02578a764147f94e31dc9
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: below_threshold([5], 5) returns false, not true.
+  claim [false-postcondition]:
+    <k>
