+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
