+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact source body emitted in solution.mpy.
+  claim [loop-empty]:
+    <k>
+      #loop(list(.ValSeq), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(.ValSeq, OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-cons]:
+    <k>
+      #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+
+  claim [below-threshold-empty]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("below_threshold", Params("l", "t"),
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)))))
+      ~> Call(Name("below_threshold"), list(.ValSeq), T:Int)
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+ 
+  claim [below-threshold-cons]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("below_threshold", Params("l", "t"),
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)))))
+      ~> Call(
+        Name("below_threshold"),
+        list(vCons(V:Val, REST:ValSeq)),
+        T:Int)
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+endmodule
