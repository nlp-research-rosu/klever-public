+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact source body emitted in solution.mpy.
+  claim [loop-empty]:
+    <k>
+      #loop(list(.ValSeq), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-int]:
+    <k>
+      #loop(list(vCons(I:Int, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(I, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericSeq(REST)
+
+  claim [loop-bool]:
+    <k>
+      #loop(list(vCons(B:Bool, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(B, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericSeq(REST)
+
+  claim [loop-float]:
+    <k>
+      #loop(list(vCons(F:Float, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(F, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericSeq(REST)
+
+  claim [below-threshold]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("below_threshold", Params("l", "t"),
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)))))
+      ~> Call(Name("below_threshold"), list(INPUT:ValSeq), T:Int)
+      => allBelow(INPUT, T)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "below_threshold" |->
+          closureVal(
+            "l", "t", .ParamNames,
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericSeq(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..889e5293d59119fec2db14ee4d889f7b291386ca
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The modeled numeric values on which comparison with the integer threshold
+  // is defined: integers, booleans (Python's integer subtype), and floats.
+  syntax Bool ::= numericSeq(ValSeq) [function, total]
+  rule numericSeq(.ValSeq) => true
+  rule numericSeq(vCons(_:Int, REST:ValSeq))   => numericSeq(REST)
+  rule numericSeq(vCons(_:Bool, REST:ValSeq))  => numericSeq(REST)
+  rule numericSeq(vCons(_:Float, REST:ValSeq)) => numericSeq(REST)
+  rule numericSeq(vCons(_:Val, _:ValSeq))      => false [owise]
+
+  // Mathematical result of below_threshold over a finite numeric sequence.
+  // The cases use the exact comparison functions of the fixed MPY semantics.
+  syntax Bool ::= allBelow(ValSeq, Int) [function, total]
+  rule allBelow(.ValSeq, _:Int) => true
+  rule allBelow(vCons(I:Int, REST:ValSeq), T:Int)
+    => (I <Int T) andBool allBelow(REST, T)
+  rule allBelow(vCons(B:Bool, REST:ValSeq), T:Int)
+    => (boolAsInt(B) <Int T) andBool allBelow(REST, T)
+  rule allBelow(vCons(F:Float, REST:ValSeq), T:Int)
+    => ltFI(F, T) andBool allBelow(REST, T)
+  rule allBelow(vCons(_:Val, _:ValSeq), _:Int) => false [owise]
+endmodule

