new file mode 100644
index 0000000000000000000000000000000000000000..8171519bcdd6bba99490acdcb0609117faf32098
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,14 @@
+requires "base-verification.k"
+
+module CONNECTION-SPEC
+  imports VERIFICATION-BASE
+
+  claim [cmp-int]:
+    <k> applyCmp("<", I:Int, T:Int) => numericLt(I, T) </k>
+
+  claim [cmp-bool]:
+    <k> applyCmp("<", B:Bool, T:Int) => numericLt(B, T) </k>
+
+  claim [cmp-float]:
+    <k> applyCmp("<", F:Float, T:Int) => numericLt(F, T) </k>
+endmodule
