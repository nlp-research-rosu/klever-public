diff --git a/verification-loops.k b/verification-loops.k
new file mode 100644
index 0000000000000000000000000000000000000000..43a2f276e7680053cf004e61416b62891a31a8bb
--- /dev/null
+++ b/verification-loops.k
@@ -0,0 +1,11 @@
+requires "base-verification.k"
+
+module VERIFICATION-LOOPS
+  imports VERIFICATION-BASE
+
+  // Derived dispatch lemma. connection-spec.k proves each complete numeric
+  // sort case without importing this module.
+  rule applyCmp("<", V:Val, T:Int) => numericLt(V, T)
+    requires numericVal(V)
+    [simplification]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..574cbde66244ea3b11f03469ada540754b302da7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,129 @@
+requires "verification-loops.k"
+
+module VERIFICATION
+  imports VERIFICATION-LOOPS
+
+  // Exact entry-to-loop bridge. prelude-spec.k proves the identical
+  // configuration transition without importing this module.
+  rule <k>
+      #loadAll(
+        Module(
+          FuncDef("below_threshold", Params("l", "t"),
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)))))
+      ~> Call(Name("below_threshold"), list(INPUT:ValSeq), T:Int)
+      =>
+      #loop(list(INPUT), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "below_threshold" |->
+          closureVal(
+            "l", "t", .ParamNames,
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)),
+            0),
+        parent(-1))
+      1 |-> scope(
+        "l" |-> list(INPUT)
+        "t" |-> T
+        "e" |-> 0,
+        parent(0))
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List => ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+
+  // Exact operational bridges for the two native ValSeq constructors.
+  // loop-spec.k proves the identical configurations with no bridge imported.
+  rule <k>
+      #loop(list(.ValSeq), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(.ValSeq, OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+
+  rule <k>
+      #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+    [priority(40)]
+endmodule

diff --git a/base-verification.k b/base-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2678c6985d8d1fefdc76911c5cc48d94f3debc84
--- /dev/null
+++ b/base-verification.k
@@ -0,0 +1,37 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  syntax Bool ::= numericVal(Val) [function, total]
+  rule numericVal(V:Val)
+    => isInt(V) orBool isBool(V) orBool isFloat(V)
+
+  syntax Bool ::= numericSeq(ValSeq) [function, total]
+  rule numericSeq(.ValSeq) => true
+  rule numericSeq(vCons(V:Val, REST:ValSeq))
+    => numericVal(V) andBool numericSeq(REST)
+
+  // Total comparison summary. The first three equations are exactly the
+  // corresponding fixed-semantics applyCmp("<", _, Int) cases.
+  syntax Bool ::= numericLt(Val, Int) [function, total]
+  rule numericLt(I:Int, T:Int)   => I <Int T
+  rule numericLt(B:Bool, T:Int)  => boolAsInt(B) <Int T
+  rule numericLt(F:Float, T:Int) => ltFI(F, T)
+  rule numericLt(_:Val, _:Int)   => false [owise]
+
+  syntax Bool ::= allBelow(ValSeq, Int) [function, total]
+  rule allBelow(.ValSeq, _:Int) => true
+  rule allBelow(vCons(V:Val, REST:ValSeq), T:Int)
+    => numericLt(V, T) andBool allBelow(REST, T)
+
+  // Exact final value of the source-level loop variable. This state summary is
+  // needed because MPY represents frame deletion as a symbolic map update.
+  syntax Val ::= lastVisited(ValSeq, Val, Int) [function, total]
+  rule lastVisited(.ValSeq, OLD:Val, _:Int) => OLD
+  rule lastVisited(vCons(V:Val, REST:ValSeq), _:Val, T:Int)
+    => #if numericLt(V, T)
+       #then lastVisited(REST, V, T)
+       #else V
+       #fi
+endmodule
diff --git a/composition-probe.k b/composition-probe.k
new file mode 100644
index 0000000000000000000000000000000000000000..c63b119474b9c0389a80beb3b6451ed0f3e965e9
--- /dev/null
+++ b/composition-probe.k
@@ -0,0 +1,156 @@
+requires "verification.k"
+
+module COMPOSITION-PROBE
+  imports VERIFICATION
+
+  claim [loop-lemma]:
+    <k>
+      #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+
+  // Deliberately identical theorem under a distinct label. If loop-lemma is
+  // available for composition, this closes immediately.
+  claim [loop-client]:
+    <k>
+      #loopLbl(
+        #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+          If(Compare(Name("e"), CmpOp("<", Name("t"))),
+            Continue, .Stmts)
+          Return(Bool(false))))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+
+  claim [concrete-client]:
+    <k>
+      #loopLbl(
+        #loop(list(vCons(I:Int, REST:ValSeq)), Name("e"),
+          If(Compare(Name("e"), CmpOp("<", Name("t"))),
+            Continue, .Stmts)
+          Return(Bool(false))))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(I, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "below_threshold" |->
+          closureVal(
+            "l", "t", .ParamNames,
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)),
+            0),
+        parent(-1))
+      1 |-> scope(
+        "e" |-> 0
+        "l" |-> list(vCons(I, REST))
+        "t" |-> T:Int,
+        parent(0))
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericSeq(REST)
+
+  // One fixed-semantics step reaches loop-lemma's exact LHS. This specifically
+  // probes cross-claim composition rather than self-circularity.
+  claim [wrapper-client]:
+    <k>
+      #loopLbl(
+        #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+          If(Compare(Name("e"), CmpOp("<", Name("t"))),
+            Continue, .Stmts)
+          Return(Bool(false))))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+endmodule
