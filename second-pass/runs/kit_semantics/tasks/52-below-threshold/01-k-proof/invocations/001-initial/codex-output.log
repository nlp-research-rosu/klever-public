+++ b/solution.py
@@ -0,0 +1,8 @@
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..dacb8e1e51d3a7ce2ca179bebd3414793f6b96bc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,105 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact source body emitted in solution.mpy.
+  claim [loop-empty]:
+    <k>
+      #loop(list(.ValSeq), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-cons]:
+    <k>
+      #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+
+  claim [below-threshold]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("below_threshold", Params("l", "t"),
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)))))
+      ~> Call(Name("below_threshold"), list(INPUT:ValSeq), T:Int)
+      => allBelow(INPUT, T)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
