diff --git a/verification-loops.k b/verification-loops.k
new file mode 100644
index 0000000000000000000000000000000000000000..43a2f276e7680053cf004e61416b62891a31a8bb
--- /dev/null
+++ b/verification-loops.k
@@ -0,0 +1,11 @@
+requires "base-verification.k"
+
+module VERIFICATION-LOOPS
+  imports VERIFICATION-BASE
+
+  // Derived dispatch lemma. connection-spec.k proves each complete numeric
+  // sort case without importing this module.
+  rule applyCmp("<", V:Val, T:Int) => numericLt(V, T)
+    requires numericVal(V)
+    [simplification]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1af738e9ef13392982c0f83291e43cfcdc78bf6b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,143 @@
+requires "verification-loops.k"
+
+module VERIFICATION
+  imports VERIFICATION-LOOPS
+
+  // Exact operational bridges for the two native ValSeq constructors.
+  // loop-spec.k proves the loop configurations with no bridge imported.
+  rule <k>
+      #loop(list(.ValSeq), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> (Return(Bool(true)) .Stmts):Stmts ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(.ValSeq, OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+
+  rule <k>
+      #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> (Return(Bool(true)) .Stmts):Stmts ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+    [priority(40)]
+
+  // Source-For bridges. LOOP-SPEC.for-* proves these exact transitions by one
+  // fixed For step plus the independently proved loop claims.
+  rule <k>
+      For(Name("e"), list(.ValSeq),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> (Return(Bool(true)) .Stmts):Stmts ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(.ValSeq, OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+
+  rule <k>
+      For(Name("e"), list(vCons(V:Val, REST:ValSeq)),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
