index 0000000000000000000000000000000000000000..56c5ba789126c00a58c76f1a84b4ef8a7dc84f3a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,11 @@
+requires "base-verification.k"
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Derived dispatch lemma. connection-spec.k proves each complete numeric
+  // sort case without importing this module.
+  rule applyCmp("<", V:Val, T:Int) => numericLt(V, T)
+    requires numericVal(V)
+    [simplification]
+endmodule

diff --git a/base-verification.k b/base-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..59ea39d6a12f054847731d8e458eea4f39da3622
--- /dev/null
+++ b/base-verification.k
@@ -0,0 +1,27 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  syntax Bool ::= numericVal(Val) [function, total]
+  rule numericVal(V:Val)
+    => isInt(V) orBool isBool(V) orBool isFloat(V)
+
+  syntax Bool ::= numericSeq(ValSeq) [function, total]
+  rule numericSeq(.ValSeq) => true
+  rule numericSeq(vCons(V:Val, REST:ValSeq))
+    => numericVal(V) andBool numericSeq(REST)
+
+  // Total comparison summary. The first three equations are exactly the
+  // corresponding fixed-semantics applyCmp("<", _, Int) cases.
+  syntax Bool ::= numericLt(Val, Int) [function, total]
+  rule numericLt(I:Int, T:Int)   => I <Int T
+  rule numericLt(B:Bool, T:Int)  => boolAsInt(B) <Int T
+  rule numericLt(F:Float, T:Int) => ltFI(F, T)
+  rule numericLt(_:Val, _:Int)   => false [owise]
+
+  syntax Bool ::= allBelow(ValSeq, Int) [function, total]
+  rule allBelow(.ValSeq, _:Int) => true
+  rule allBelow(vCons(V:Val, REST:ValSeq), T:Int)
+    => numericLt(V, T) andBool allBelow(REST, T)
+endmodule
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8171519bcdd6bba99490acdcb0609117faf32098
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,14 @@
+requires "base-verification.k"
+
+module CONNECTION-SPEC
+  imports VERIFICATION-BASE
+
+  claim [cmp-int]:
+    <k> applyCmp("<", I:Int, T:Int) => numericLt(I, T) </k>
+
+  claim [cmp-bool]:
+    <k> applyCmp("<", B:Bool, T:Int) => numericLt(B, T) </k>
+
+  claim [cmp-float]:
+    <k> applyCmp("<", F:Float, T:Int) => numericLt(F, T) </k>
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..e5e0cd678369d50e00a92453da536b54e81b417a
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
+
+
+assert below_threshold([1, 2, 4, 10], 100) == True
+assert below_threshold([1, 20, 4, 10], 5) == False
+assert below_threshold([], 0) == True
+assert below_threshold([5], 5) == False
+assert below_threshold([True, False], 2) == True
+assert below_threshold([1.5, -2.0], 2) == True
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9a7ed103d9e5c248f8fdf2455b49cf1350cad3c7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..44f21f1783479c24b1b3f6579de57e3d3b028008
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,92 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact source body emitted in solution.mpy.
+  claim [loop-empty]:
+    <k>
+      #loop(list(.ValSeq), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-cons]:
+    <k>
+      #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+
+  claim [below-threshold]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("below_threshold", Params("l", "t"),
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)))))
+      ~> Call(Name("below_threshold"), list(INPUT:ValSeq), T:Int)
+      => allBelow(INPUT, T)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericSeq(INPUT)
+endmodule
