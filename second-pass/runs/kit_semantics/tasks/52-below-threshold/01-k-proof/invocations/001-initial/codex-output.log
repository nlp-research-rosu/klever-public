--- /dev/null
+++ b/bridge-smoke.py
@@ -0,0 +1,15 @@
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t."""
+    e = 0
+    for e in l:
+        if e < t:
+            continue
+        return False
+    return True
+
+
+assert below_threshold([], 0) == True
+assert below_threshold([1, 2, 4, 10], 100) == True
+assert below_threshold([1, 20, 4, 10], 5) == False
+assert below_threshold([5], 5) == False
+assert below_threshold([True, False], 2) == True
diff --git a/composition-probe.k b/composition-probe.k
new file mode 100644
index 0000000000000000000000000000000000000000..c63b119474b9c0389a80beb3b6451ed0f3e965e9
--- /dev/null
+++ b/composition-probe.k
@@ -0,0 +1,156 @@
+requires "verification.k"
+
+module COMPOSITION-PROBE
+  imports VERIFICATION
+
+  claim [loop-lemma]:
+    <k>
+      #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+        If(Compare(Name("e"), CmpOp("<", Name("t"))),
+          Continue, .Stmts)
+        Return(Bool(false)))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+
+  // Deliberately identical theorem under a distinct label. If loop-lemma is
+  // available for composition, this closes immediately.
+  claim [loop-client]:
+    <k>
+      #loopLbl(
+        #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+          If(Compare(Name("e"), CmpOp("<", Name("t"))),
+            Continue, .Stmts)
+          Return(Bool(false))))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+
+  claim [concrete-client]:
+    <k>
+      #loopLbl(
+        #loop(list(vCons(I:Int, REST:ValSeq)), Name("e"),
+          If(Compare(Name("e"), CmpOp("<", Name("t"))),
+            Continue, .Stmts)
+          Return(Bool(false))))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(I, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "below_threshold" |->
+          closureVal(
+            "l", "t", .ParamNames,
+            Expr(Str("Return True if all numbers in the list l are below threshold t."))
+            Assign(Name("e"), Int(0))
+            For(Name("e"), Name("l"),
+              If(Compare(Name("e"), CmpOp("<", Name("t"))),
+                Continue, .Stmts)
+              Return(Bool(false)))
+            Return(Bool(true)),
+            0),
+        parent(-1))
+      1 |-> scope(
+        "e" |-> 0
+        "l" |-> list(vCons(I, REST))
+        "t" |-> T:Int,
+        parent(0))
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericSeq(REST)
+
+  // One fixed-semantics step reaches loop-lemma's exact LHS. This specifically
+  // probes cross-claim composition rather than self-circularity.
+  claim [wrapper-client]:
+    <k>
+      #loopLbl(
+        #loop(list(vCons(V:Val, REST:ValSeq)), Name("e"),
+          If(Compare(Name("e"), CmpOp("<", Name("t"))),
+            Continue, .Stmts)
+          Return(Bool(false))))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      GLOBALS:Map
+      1 |-> scope(
+        "l" |-> list(ORIGINAL:ValSeq)
+        "t" |-> T:Int
+        "e" |-> OLD:Val,
+        parent(0))
+      =>
+      (1 |-> scope(
+        "l" |-> list(ORIGINAL)
+        "t" |-> T
+        "e" |-> lastVisited(vCons(V, REST), OLD, T),
+        parent(0))
+       GLOBALS) [1 <- undef]
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> H:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires numericVal(V) andBool numericSeq(REST)
+endmodule
