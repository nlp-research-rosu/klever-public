/bin/bash -lc 'kompile --backend haskell base-verification.k --main-module VERIFICATION-BASE --syntax-module MPY-SYNTAX --output-definition connection-kompiled && kprove connection-spec.k --definition connection-kompiled --spec-module CONNECTION-SPEC' in /workspace
