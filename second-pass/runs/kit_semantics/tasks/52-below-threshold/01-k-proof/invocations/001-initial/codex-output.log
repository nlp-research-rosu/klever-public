diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bb9541b884651d08bf2b8bb933831ea1993c93c4
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,24 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The modeled numeric values on which comparison with the integer threshold
+  // is defined: integers, booleans (Python's integer subtype), and floats.
+  syntax Bool ::= numericSeq(ValSeq) [function, total]
+  rule numericSeq(.ValSeq) => true
+  rule numericSeq(vCons(V:Val, REST:ValSeq))
+    => (isInt(V) orBool isBool(V) orBool isFloat(V))
+       andBool numericSeq(REST)
+
+  // Mathematical result of below_threshold over a finite numeric sequence.
+  // The cases use the exact comparison functions of the fixed MPY semantics.
+  syntax Bool ::= allBelow(ValSeq, Int) [function]
+  rule allBelow(.ValSeq, _:Int) => true
+  rule allBelow(vCons(I:Int, REST:ValSeq), T:Int)
+    => (I <Int T) andBool allBelow(REST, T)
+  rule allBelow(vCons(B:Bool, REST:ValSeq), T:Int)
+    => (boolAsInt(B) <Int T) andBool allBelow(REST, T)
+  rule allBelow(vCons(F:Float, REST:ValSeq), T:Int)
+    => ltFI(F, T) andBool allBelow(REST, T)
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
