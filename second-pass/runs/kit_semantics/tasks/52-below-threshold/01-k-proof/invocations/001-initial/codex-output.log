+          If(Compare(Name("e"), CmpOp("<", Name("t"))),
+            Continue, .Stmts)
+          Return(Bool(false))))
+      ~> Return(Bool(true)) ~> #endcall
+      => allBelow(vCons(V, REST), T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "below_threshold" |->
+          closureVal(
