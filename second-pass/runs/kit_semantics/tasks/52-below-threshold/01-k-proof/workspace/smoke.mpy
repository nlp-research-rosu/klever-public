Module(
  FuncDef("below_threshold", Params("l", "t"),
    Expr(
      Str(
        "Return True if all numbers in the list l are below threshold t."))
    Assign(Name("e"), Int(0))
    For(Name("e"), Name("l"),
      If(Compare(Name("e"), CmpOp("<", Name("t"))),
        Continue,
        )
      Return(Bool(false)))
    Return(Bool(true)))
  Assert(
    Compare(
      Call(
        Name("below_threshold"),
        ListExpr(Int(1), Int(2), Int(4), Int(10)),
        Int(100)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("below_threshold"),
        ListExpr(Int(1), Int(20), Int(4), Int(10)),
        Int(5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("below_threshold"), ListExpr(), Int(0)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("below_threshold"), ListExpr(Int(5)), Int(5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("below_threshold"),
        ListExpr(Bool(true), Bool(false)),
        Int(2)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("below_threshold"),
        ListExpr(Float(1.5), UnaryOp("-", Float(2.0))),
        Int(2)),
      CmpOp("==", Bool(true)))))
