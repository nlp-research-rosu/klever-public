Module(
  FuncDef("encode", Params("message"),
    Return(
      Call(
        Attribute(
          Call(
            Attribute(
              Call(
                Attribute(
                  Call(
                    Attribute(
                      Call(
                        Attribute(
                          Call(
                            Attribute(
                              Call(
                                Attribute(
                                  Call(
                                    Attribute(
                                      Call(
                                        Attribute(
                                          Call(
                                            Attribute(
                                              Call(
                                                Attribute(
                                                  Name("message"),
                                                  "swapcase"),
                                                ),
                                              "replace"),
                                            Str("a"),
                                            Str("c")),
                                          "replace"),
                                        Str("e"),
                                        Str("g")),
                                      "replace"),
                                    Str("i"),
                                    Str("k")),
                                  "replace"),
                                Str("o"),
                                Str("q")),
                              "replace"),
                            Str("u"),
                            Str("w")),
                          "replace"),
                        Str("A"),
                        Str("C")),
                      "replace"),
                    Str("E"),
                    Str("G")),
                  "replace"),
                Str("I"),
                Str("K")),
              "replace"),
            Str("O"),
            Str("Q")),
          "replace"),
        Str("U"),
        Str("W"))))
  Assert(
    Compare(Call(Name("encode"), Str("test")), CmpOp("==", Str("TGST"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("This is a message")),
      CmpOp("==", Str("tHKS KS C MGSSCGG"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("aeiouAEIOU")),
      CmpOp("==", Str("CGKQWcgkqw"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("xyz XYZ")),
      CmpOp("==", Str("XYZ xyz"))))
  Assert(Compare(Call(Name("encode"), Str("")), CmpOp("==", Str("")))))
