+char *realpath(const char *path, char *resolved) {
+  static char *(*real_realpath)(const char *, char *) = NULL;
+  if (!real_realpath) real_realpath = dlsym(RTLD_NEXT, "realpath");
+  char *result = real_realpath(path, resolved);
+  int saved = errno;
+  fprintf(stderr, "TRACE realpath path=%s result=%s errno=%d\n",
+          path, result ? result : "(null)", saved);
+  errno = saved;
+  return result;
+}
