          Int(49),
          UnaryOp("-", Int(24)),
          UnaryOp("-", Int(37)),
          Int(35),
          Int(29),
          Int(17))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(37)),
          Int(34),
          UnaryOp("-", Int(33)),
          Int(49),
          UnaryOp("-", Int(24)),
          UnaryOp("-", Int(37)),
          Int(17),
          Int(29),
          Int(35)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(29)),
          Int(30),
          UnaryOp("-", Int(38)),
          UnaryOp("-", Int(1)),
          Int(20),
          UnaryOp("-", Int(44)),
          UnaryOp("-", Int(31)),
          UnaryOp("-", Int(9)),
          UnaryOp("-", Int(2)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(38)),
          Int(30),
          UnaryOp("-", Int(31)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(29)),
          UnaryOp("-", Int(44)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(9)),
          Int(20)))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(26), UnaryOp("-", Int(12)))),
      CmpOp("==", ListExpr(Int(26), UnaryOp("-", Int(12))))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(34)),
          Int(5),
          UnaryOp("-", Int(32)),
          Int(16),
          Int(0))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(34)),
          Int(5),
          UnaryOp("-", Int(32)),
          Int(16),
          Int(0)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(42)),
          UnaryOp("-", Int(46)),
          Int(8),
          UnaryOp("-", Int(3)),
          Int(25),
          Int(47),
          UnaryOp("-", Int(22)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(42)),
          UnaryOp("-", Int(46)),
          UnaryOp("-", Int(22)),
          UnaryOp("-", Int(3)),
          Int(8),
          Int(47),
          Int(25)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          Int(24),
          UnaryOp("-", Int(34)),
          UnaryOp("-", Int(17)),
          UnaryOp("-", Int(8)),
          UnaryOp("-", Int(2)),
          Int(17),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(30)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(17)),
          UnaryOp("-", Int(34)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(8)),
          UnaryOp("-", Int(2)),
          Int(17),
          Int(24),
          UnaryOp("-", Int(30))))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          Int(14),
          UnaryOp("-", Int(5)),
          Int(16),
          UnaryOp("-", Int(49)),
          Int(35),
          Int(7),
          UnaryOp("-", Int(27)),
          UnaryOp("-", Int(12)),
          Int(46),
          Int(14))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(27)),
