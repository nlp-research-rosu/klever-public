Module(
  FuncDef("sort_even", Params("l"),
    Assign(Name("result"), Call(Name("list"), Name("l")))
    Assign(
      Name("evens"),
      Call(
        Name("sorted"),
        Subscript(Name("l"), Slice(NoBound, NoBound, Int(2)))))
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(
      Name("range"),
      BinOp(
        "//",
        BinOp("+", Call(Name("len"), Name("l")), Int(1)),
        Int(2))),
      Assign(
        Subscript(Name("result"), BinOp("*", Int(2), Name("i"))),
        Subscript(Name("evens"), Name("i"))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(7))),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(2), Int(1)))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(9), Int(8), Int(3))),
      CmpOp("==", ListExpr(Int(3), Int(8), Int(9)))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(5), Int(6), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(3), Int(6), Int(5), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          Int(5),
          UnaryOp("-", Int(9)),
          UnaryOp("-", Int(1)),
          Int(8),
          Int(0))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(9)),
          Int(0),
          Int(8),
          Int(5)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          Int(13),
          UnaryOp("-", Int(14)),
          Int(47),
          Int(37),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(23)),
          UnaryOp("-", Int(44)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(44)),
          UnaryOp("-", Int(14)),
          UnaryOp("-", Int(4)),
          Int(37),
          Int(13),
          UnaryOp("-", Int(23)),
          Int(47)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(6)),
          Int(28),
          UnaryOp("-", Int(46)),
          Int(29),
          UnaryOp("-", Int(46)),
          UnaryOp("-", Int(12)),
          UnaryOp("-", Int(2)),
          Int(50))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(46)),
          Int(28),
          UnaryOp("-", Int(46)),
          Int(29),
          UnaryOp("-", Int(6)),
          UnaryOp("-", Int(12)),
          UnaryOp("-", Int(2)),
          Int(50)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(Int(23), UnaryOp("-", Int(24)), UnaryOp("-", Int(22)))),
      CmpOp(
        "==",
        ListExpr(UnaryOp("-", Int(22)), UnaryOp("-", Int(24)), Int(23)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(6)),
          UnaryOp("-", Int(32)),
          UnaryOp("-", Int(34)),
          UnaryOp("-", Int(10)),
          Int(36))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(34)),
          UnaryOp("-", Int(32)),
          UnaryOp("-", Int(6)),
          UnaryOp("-", Int(10)),
          Int(36)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(15)),
          Int(26),
          Int(1),
          Int(12),
          UnaryOp("-", Int(28)),
          Int(49),
          Int(5),
          Int(36),
          Int(9),
          UnaryOp("-", Int(34)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(28)),
          Int(26),
          UnaryOp("-", Int(15)),
          Int(12),
          Int(1),
          Int(49),
          Int(5),
          Int(36),
          Int(9),
          UnaryOp("-", Int(34))))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          Int(10),
          Int(10),
          Int(27),
          UnaryOp("-", Int(24)),
          Int(43),
          UnaryOp("-", Int(1)),
          Int(31),
          UnaryOp("-", Int(37)),
          Int(29),
          UnaryOp("-", Int(10)))),
      CmpOp(
        "==",
        ListExpr(
          Int(10),
          Int(10),
          Int(27),
          UnaryOp("-", Int(24)),
          Int(29),
          UnaryOp("-", Int(1)),
          Int(31),
          UnaryOp("-", Int(37)),
          Int(43),
          UnaryOp("-", Int(10))))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(47))),
      CmpOp("==", ListExpr(Int(47)))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(UnaryOp("-", Int(3)))),
      CmpOp("==", ListExpr(UnaryOp("-", Int(3))))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(48)),
          UnaryOp("-", Int(49)),
          UnaryOp("-", Int(11)),
          Int(43),
          Int(36))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(48)),
          UnaryOp("-", Int(49)),
          UnaryOp("-", Int(11)),
          Int(43),
          Int(36)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(4)),
          Int(47),
          Int(27),
          Int(41),
          Int(9),
          Int(5),
          UnaryOp("-", Int(9)),
          Int(3),
          Int(50),
          UnaryOp("-", Int(2)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(9)),
          Int(47),
          UnaryOp("-", Int(4)),
          Int(41),
          Int(9),
          Int(5),
          Int(27),
          Int(3),
          Int(50),
          UnaryOp("-", Int(2))))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(Int(37), Int(15), UnaryOp("-", Int(31)), Int(27))),
      CmpOp(
        "==",
        ListExpr(UnaryOp("-", Int(31)), Int(15), Int(37), Int(27)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          UnaryOp("-", Int(33)),
