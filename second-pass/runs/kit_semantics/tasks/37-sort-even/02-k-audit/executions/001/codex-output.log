+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ( 0 |-> list(vCons(9, vCons(8, vCons(3, .ValSeq))))
+        1 |-> list(vCons(9, vCons(3, .ValSeq)))
+        2 |-> list(vCons(3, vCons(9, .ValSeq))) )
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
