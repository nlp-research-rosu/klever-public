+    print("RUN/TASK/CONDITION CONSISTENCY true")
+
+    required_candidate_artifacts = [
+        "solution.py",
+        "solution.mpy",
+        "verification.k",
+        "spec.k",
+        "prove.sh",
+        "PROOF.md",
+    ]
+    defects: list[str] = []
