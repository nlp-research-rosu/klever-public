def sort_even(l: list):
    """This function takes a list l and returns a list l' such that
    l' is identical to l in the odd indicies, while its values at the even indicies are equal
    to the values of the even indicies of l, but sorted.
    >>> sort_even([1, 2, 3])
    [1, 2, 3]
    >>> sort_even([5, 6, 3, 4])
    [3, 6, 5, 4]
    """
# canonical.py — the UNMODIFIED HumanEval/37 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: sort_even



def sort_even(l: list):
    """This function takes a list l and returns a list l' such that
    l' is identical to l in the odd indicies, while its values at the even indicies are equal
    to the values of the even indicies of l, but sorted.
    >>> sort_even([1, 2, 3])
    [1, 2, 3]
    >>> sort_even([5, 6, 3, 4])
    [3, 6, 5, 4]
    """
    evens = l[::2]
    odds = l[1::2]
    evens.sort()
    ans = []
    for e, o in zip(evens, odds):
        ans.extend([e, o])
    if len(evens) > len(odds):
        ans.append(evens[-1])
    return ans
def sort_even(l: list):
    result = list(l)
    evens = sorted(l[::2])
    i = 0
    for i in range((len(l) + 1) // 2):
        result[2 * i] = evens[i]
    return result
Module(
  FuncDef("sort_even", Params("l"),
    Assign(Name("result"), Call(Name("list"), Name("l")))
    Assign(
      Name("evens"),
      Call(
        Name("sorted"),
        Subscript(Name("l"), Slice(NoBound, NoBound, Int(2)))))
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(
      Name("range"),
      BinOp(
        "//",
        BinOp("+", Call(Name("len"), Name("l")), Int(1)),
        Int(2))),
      Assign(
        Subscript(Name("result"), BinOp("*", Int(2), Name("i"))),
        Subscript(Name("evens"), Name("i"))))
    Return(Name("result"))))
