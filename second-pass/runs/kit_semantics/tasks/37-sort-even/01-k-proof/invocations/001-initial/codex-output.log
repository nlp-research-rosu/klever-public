+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(
+          CUR
+          => fillEven(
+               CUR,
+               sortVS(buildVS(VS, 0, vsLen(VS), 2)),
+               I,
+               C))
+        1 |-> list(buildVS(VS, 0, vsLen(VS), 2))
+        2 |-> list(sortVS(buildVS(VS, 0, vsLen(VS), 2))) )
+    </heap>
+    <heapLoc> 3 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+
+  claim [sort-even]:
+    <k>
+      #loadAll(Module(FuncDef("sort_even", Params("l"), sortEvenBody)))
+      ~> Call(Name("sort_even"), list(VS))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ( 0 |-> list(sortEvenResult(VS))
+        1 |-> list(buildVS(VS, 0, vsLen(VS), 2))
+        2 |-> list(sortVS(buildVS(VS, 0, vsLen(VS), 2))) )
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd6dd8e42600906e9d98d1dc0773ed3de6b71627
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,35 @@
+from itertools import product
+
+from solution import sort_even
+
+
+def contract_oracle(values):
+    expected = values[:]
+    expected[::2] = sorted(expected[::2])
+    return expected
+
+
+def main():
+    examples = [
+        [],
+        [7],
+        [1, 2, 3],
+        [5, 6, 3, 4],
+        [9, -1, 4, -2, 4],
+    ]
+    tested = 0
+    for values in examples:
+        assert sort_even(values) == contract_oracle(values)
+        tested += 1
+
+    for length in range(7):
+        for values in product(range(-2, 3), repeat=length):
+            sample = list(values)
+            assert sort_even(sample) == contract_oracle(sample)
+            tested += 1
+
+    print(f"Python differential tests: {tested} cases, 0 mismatches")
+
+
+if __name__ == "__main__":
+    main()
