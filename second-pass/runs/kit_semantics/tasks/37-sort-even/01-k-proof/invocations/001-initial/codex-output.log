+          parent(-1))
+        1 |-> scope(
+          ( "l"      |-> list(VS)
+            "result" |-> ref(0)
+            "evens"  |-> ref(2)
+            "i"      |-> _J ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
