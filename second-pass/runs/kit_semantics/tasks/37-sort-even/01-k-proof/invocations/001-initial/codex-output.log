+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(
+          vCons(9, vCons(8, .ValSeq))
+          => fillEven(
