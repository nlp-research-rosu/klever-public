diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..0f68b455a8a74864965a549c23027c459c58a009
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION-NO-BRIDGE
+
+  // Deliberately mutated displaced execution: write the sorted value at
+  // 2*i+1 instead of 2*i.  The original fillEven postcondition must fail.
+  claim [mutated-loop]:
+    <k>
+      #loop(
+        rangeObj(0, 1, 1),
+        Name("i"),
+        ( Assign(
+            Subscript(
+              Name("result"),
+              BinOp(
+                "+",
+                BinOp("*", Int(2), Name("i")),
+                Int(1))),
+            Subscript(Name("evens"), Name("i")))
+          .Stmts ))
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        1 |-> scope(
+          ( "l"      |-> list(vCons(9, vCons(8, .ValSeq)))
+            "result" |-> ref(0)
+            "evens"  |-> ref(2)
+            "i"      |-> 0 ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(
+          vCons(9, vCons(8, .ValSeq))
+          => fillEven(
+               vCons(9, vCons(8, .ValSeq)),
+               vCons(3, .ValSeq),
+               0,
+               1))
+        1 |-> list(vCons(9, .ValSeq))
+        2 |-> list(vCons(3, .ValSeq)) )
+    </heap>
+    <heapLoc> 3 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-connection.k b/spec-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..5d07cb0750e6b12af310f6b7d0984c3801ccfa4c
--- /dev/null
+++ b/spec-connection.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module SPEC-CONNECTION
+  imports VERIFICATION-NO-BRIDGE
+
+  // Bridge-free universal connection theorem for the exact operational rule
+  // in module VERIFICATION.
+  claim [loop-connection]:
+    <k>
+      #loop(
+        rangeObj(I, C, 1),
+        Name("i"),
+        sortEvenLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        1 |-> scope(
+          ( "l"      |-> list(VS)
+            "result" |-> ref(0)
+            "evens"  |-> ref(2)
+            "i"      |-> _J ),
+          parent(0))
+        -1 |-> B:Scope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> B )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(
+          CUR
+          => fillEven(
+               CUR,
+               SORTED,
+               I,
+               C))
+        1 |-> list(SLICE)
+        2 |-> list(SORTED) )
+    </heap>
+    <heapLoc> 3 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..4f7ac310719222e13eee4a52aa4ae36edea21034
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false for the realizable witness [5, 6, 3, 4]: it demands
+  // that the result remain unsorted instead of becoming [3, 6, 5, 4].
+  claim [false-result]:
+    <k>
+      #loadAll(Module(FuncDef("sort_even", Params("l"), sortEvenBody)))
+      ~> Call(
+           Name("sort_even"),
+           list(vCons(5, vCons(6, vCons(3, vCons(4, .ValSeq))))))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ( 0 |-> list(vCons(5, vCons(6, vCons(3, vCons(4, .ValSeq)))))
+        1 |-> list(
+          buildVS(
+            vCons(5, vCons(6, vCons(3, vCons(4, .ValSeq)))),
+            0,
+            4,
+            2))
+        2 |-> list(
+          sortVS(
+            buildVS(
+              vCons(5, vCons(6, vCons(3, vCons(4, .ValSeq)))),
+              0,
+              4,
+              2))) )
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..252331686cfbb1be015c9b8d747a0c741913d4be
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,85 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        rangeObj(I, C, 1),
+        Name("i"),
+        sortEvenLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        1 |-> scope(
+          ( "l"      |-> list(VS)
+            "result" |-> ref(0)
+            "evens"  |-> ref(2)
+            "i"      |-> _J ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(
+          CUR
+          => fillEven(
+               CUR,
+               sortVS(buildVS(VS, 0, vsLen(VS), 2)),
+               I,
+               C))
+        1 |-> list(buildVS(VS, 0, vsLen(VS), 2))
+        2 |-> list(sortVS(buildVS(VS, 0, vsLen(VS), 2))) )
+    </heap>
+    <heapLoc> 3 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+
+  claim [sort-even]:
+    <k>
+      #loadAll(Module(FuncDef("sort_even", Params("l"), sortEvenBody)))
+      ~> Call(Name("sort_even"), list(VS))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ( 0 |-> list(sortEvenResult(VS))
+        1 |-> list(buildVS(VS, 0, vsLen(VS), 2))
+        2 |-> list(sortVS(buildVS(VS, 0, vsLen(VS), 2))) )
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd6dd8e42600906e9d98d1dc0773ed3de6b71627
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,35 @@
+from itertools import product
+
+from solution import sort_even
+
+
+def contract_oracle(values):
+    expected = values[:]
+    expected[::2] = sorted(expected[::2])
+    return expected
+
+
+def main():
+    examples = [
+        [],
+        [7],
+        [1, 2, 3],
+        [5, 6, 3, 4],
+        [9, -1, 4, -2, 4],
+    ]
+    tested = 0
+    for values in examples:
+        assert sort_even(values) == contract_oracle(values)
+        tested += 1
+
+    for length in range(7):
+        for values in product(range(-2, 3), repeat=length):
+            sample = list(values)
+            assert sort_even(sample) == contract_oracle(sample)
+            tested += 1
+
+    print(f"Python differential tests: {tested} cases, 0 mismatches")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..220ab6acfd875c6c45c1ffab3f923b3d383a717a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,135 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  // Exact source-body macros. They only avoid duplicating the translated AST
+  // in the claims; macro expansion happens before execution.
+  syntax Stmts ::= "sortEvenBody" [macro]
+  syntax Stmts ::= "sortEvenLoopBody" [macro]
+
+  // Number of even positions in a sequence of length N.
+  syntax Int ::= evenCount(Int) [function, total]
+
+  // Apply consecutive writes for counters I through STOP - 1.
+  syntax ValSeq ::= fillEven(ValSeq, ValSeq, Int, Int)
+                    [function, total]
+
+  // The result specified by the source contract: the input sequence with its
+  // even-position projection replaced by the ascending sort of that projection.
+  syntax ValSeq ::= sortEvenResult(ValSeq) [function, total]
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule sortEvenLoopBody
+    => Assign(
+         Subscript(Name("result"), BinOp("*", Int(2), Name("i"))),
+         Subscript(Name("evens"), Name("i")))
+
+  rule sortEvenBody
+    => Assign(Name("result"), Call(Name("list"), Name("l")))
+       Assign(
+         Name("evens"),
+         Call(
+           Name("sorted"),
+           Subscript(Name("l"), Slice(NoBound, NoBound, Int(2)))))
+       Assign(Name("i"), Int(0))
+       For(
+         Name("i"),
+         Call(
+           Name("range"),
+           BinOp(
+             "//",
+             BinOp("+", Call(Name("len"), Name("l")), Int(1)),
+             Int(2))),
+         sortEvenLoopBody)
+       Return(Name("result"))
+
+  rule evenCount(N)
+    => (N +Int 1 -Int pyMod(N +Int 1, 2)) /Int 2
+
+  rule fillEven(VS, _SORTED, I, STOP) => VS
+    requires I >=Int STOP
+
+  rule fillEven(VS, SORTED, I, STOP)
+    => fillEven(
+         setVSAt(VS, 2 *Int I, valSeqAt(SORTED, I)),
+         SORTED,
+         I +Int 1,
+         STOP)
+    requires I <Int STOP
+
+  rule sortEvenResult(VS)
+    => fillEven(
+         VS,
+         sortVS(buildVS(VS, 0, vsLen(VS), 2)),
+         0,
+         evenCount(vsLen(VS)))
+endmodule
+
+// Used to prove the loop connection theorem without the operational bridge.
+module VERIFICATION-NO-BRIDGE
+  imports VERIFICATION-BASE
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Exact operational bridge justified by SPEC-CONNECTION.loop-connection,
+  // which is proved under VERIFICATION-NO-BRIDGE.  The rule deliberately
+  // accepts no continuation, binding, heap, stack, return, exception, or exit
+  // context beyond the universally quantified context of that theorem.
+  rule
+    <k>
+      #loop(
+        rangeObj(I, C, 1),
+        Name("i"),
+        sortEvenLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        1 |-> scope(
+          ( "l"      |-> list(VS)
+            "result" |-> ref(0)
+            "evens"  |-> ref(2)
+            "i"      |-> _J ),
+          parent(0))
+        -1 |-> B:Scope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> B )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(
+          CUR
+          => fillEven(
+               CUR,
+               SORTED,
+               I,
+               C))
+        1 |-> list(SLICE)
+        2 |-> list(SORTED) )
+    </heap>
+    <heapLoc> 3 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+    [priority(40)]
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..bf3cfd08dc24695e5a41c14de31a30edf3ba8885
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun smoke.mpy --definition runtime-kompiled
+python3 test_solution.py
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION-NO-BRIDGE \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-no-bridge-kompiled
+
+kprove spec-connection.k \
+  --definition verification-no-bridge-kompiled \
+  --spec-module SPEC-CONNECTION
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY; then
+  echo "UNEXPECTED SUCCESS: false-result mutation proved"
+  exit 1
+else
+  status=$?
+  echo "EXPECTED FAILURE: false-result mutation exited ${status}"
+fi
+
+if kprove spec-body-mutation.k \
+     --definition verification-no-bridge-kompiled \
+     --spec-module SPEC-BODY-MUTATION; then
+  echo "UNEXPECTED SUCCESS: mutated loop body proved"
+  exit 1
+else
+  status=$?
+  echo "EXPECTED FAILURE: mutated loop body exited ${status}"
+fi
