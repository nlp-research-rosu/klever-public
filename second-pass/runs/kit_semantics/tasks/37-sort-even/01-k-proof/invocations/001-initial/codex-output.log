+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        rangeObj(I, C, 1),
+        Name("i"),
+        sortEvenLoopBody)
+      ~> (Return(Name("result")) .Stmts)
