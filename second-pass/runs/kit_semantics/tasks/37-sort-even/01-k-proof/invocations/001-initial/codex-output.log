+       Assign(Name("i"), Int(0))
+       For(
+         Name("i"),
+         Call(
+           Name("range"),
+           BinOp(
+             "//",
+             BinOp("+", Call(Name("len"), Name("l")), Int(1)),
+             Int(2))),
+         sortEvenLoopBody)
+       Return(Name("result"))
+
+  rule evenCount(N)
+    => (N +Int 1 -Int pyMod(N +Int 1, 2)) /Int 2
+
+  rule fillEven(VS, _SORTED, _I, N) => VS
+    requires N <=Int 0
+
+  rule fillEven(VS, SORTED, I, N)
+    => fillEven(
+         setVSAt(VS, 2 *Int I, valSeqAt(SORTED, I)),
+         SORTED,
+         I +Int 1,
+         N -Int 1)
+    requires N >Int 0
+
+  rule sortEvenResult(VS)
+    => fillEven(
+         VS,
+         sortVS(buildVS(VS, 0, vsLen(VS), 2)),
+         0,
+         evenCount(vsLen(VS)))
+endmodule

codex
The first residual is narrow and expected: the circularity reached the correct post-state, but two arithmetically equal “remaining count” expressions were not canonicalized inside the recursive summary. I’m replacing that count-based summary with an endpoint-based one, so the inductive step is definitionally identical and needs no extra arithmetic lemma.
apply patch
