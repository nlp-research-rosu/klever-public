diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..25b25c053347b0dd34a2706a1578283429b1751e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,87 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        rangeObj(I, C, 1),
+        Name("i"),
+        sortEvenLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        1 |-> scope(
+          ( "l"      |-> list(VS)
+            "result" |-> ref(0)
+            "evens"  |-> ref(2)
+            "i"      |-> J ),
+          parent(0))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(
+          CUR
+          => fillEven(
+               CUR,
+               sortVS(buildVS(VS, 0, vsLen(VS), 2)),
+               I,
+               C))
+        1 |-> list(buildVS(VS, 0, vsLen(VS), 2))
+        2 |-> list(sortVS(buildVS(VS, 0, vsLen(VS), 2))) )
+    </heap>
+    <heapLoc> 3 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires C ==Int evenCount(vsLen(VS))
+     andBool 0 <=Int I
+     andBool I <=Int C
+
+  claim [sort-even]:
+    <k>
+      #loadAll(Module(FuncDef("sort_even", Params("l"), sortEvenBody)))
+      ~> Call(Name("sort_even"), list(VS))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0 |-> scope(
+          "sort_even" |-> closureVal("l", sortEvenBody, 0),
+          parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ( 0 |-> list(sortEvenResult(VS))
+        1 |-> list(buildVS(VS, 0, vsLen(VS), 2))
+        2 |-> list(sortVS(buildVS(VS, 0, vsLen(VS), 2))) )
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
