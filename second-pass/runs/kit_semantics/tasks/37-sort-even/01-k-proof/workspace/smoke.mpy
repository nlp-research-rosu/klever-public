Module(
  FuncDef("sort_even", Params("l"),
    Assign(Name("result"), Call(Name("list"), Name("l")))
    Assign(
      Name("evens"),
      Call(
        Name("sorted"),
        Subscript(Name("l"), Slice(NoBound, NoBound, Int(2)))))
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(
      Name("range"),
      BinOp(
        "//",
        BinOp("+", Call(Name("len"), Name("l")), Int(1)),
        Int(2))),
      Assign(
        Subscript(Name("result"), BinOp("*", Int(2), Name("i"))),
        Subscript(Name("evens"), Name("i"))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(7))),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(5), Int(6), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(3), Int(6), Int(5), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("sort_even"),
        ListExpr(
          Int(9),
          UnaryOp("-", Int(1)),
          Int(4),
          UnaryOp("-", Int(2)),
          Int(4))),
      CmpOp(
        "==",
        ListExpr(
          Int(4),
          UnaryOp("-", Int(1)),
          Int(4),
          UnaryOp("-", Int(2)),
          Int(9))))))
