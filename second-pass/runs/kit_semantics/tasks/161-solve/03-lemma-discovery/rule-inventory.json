      "source_rule_id": "rule-a22bf74536ca2c9ab90997fa2778e59bb863fe55a97cb2d4ef4e0938017132fe",
      "start_line": 13,
      "text": "  rule loopBody\n    => Assign(\n         Name(\"reversed_s\"),\n         BinOp(\"+\", Name(\"c\"), Name(\"reversed_s\")))\n       If(\n         Call(Attribute(Name(\"c\"), \"isalpha\"), .Exprs),\n         AugAssign(\n           Name(\"swapped\"),\n           \"+\",\n           Call(Attribute(Name(\"c\"), \"swapcase\"), .Exprs))\n         Assign(Name(\"has_letter\"), Bool(true))\n         .Stmts,\n         AugAssign(Name(\"swapped\"), \"+\", Name(\"c\"))\n         .Stmts)\n       .Stmts"
    },
    {
      "attributes": [],
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "63de44a807e654f91177cf67175935a5d211c45c4dea2cce51f96809ae8edb68",
      "source_rule_id": "rule-63de44a807e654f91177cf67175935a5d211c45c4dea2cce51f96809ae8edb68",
      "start_line": 30,
      "text": "  rule solveBody\n    => Expr(\n         Str(\"Toggle letter case, or reverse a string containing no letters.\"))\n       Assign(Name(\"swapped\"), Str(\"\"))\n       Assign(Name(\"reversed_s\"), Str(\"\"))\n       Assign(Name(\"has_letter\"), Bool(false))\n       Assign(Name(\"c\"), Str(\"\"))\n       For(Name(\"c\"), Name(\"s\"), loopBody)\n       If(\n         Name(\"has_letter\"),\n         Return(Name(\"swapped\")) .Stmts,\n         .Stmts)\n       Return(Name(\"reversed_s\"))\n       .Stmts"
    },
    {
