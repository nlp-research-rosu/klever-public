Module(
  FuncDef("solve", Params("s"),
    Assign(Name("swapped"), Str(""))
    Assign(Name("reversed_s"), Str(""))
    Assign(Name("has_letter"), Bool(false))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("s"),
      Assign(
        Name("reversed_s"),
        BinOp("+", Name("c"), Name("reversed_s")))
      If(Call(Attribute(Name("c"), "isalpha"), ),
        AugAssign(
          Name("swapped"),
          "+",
          Call(Attribute(Name("c"), "swapcase"), ))
        Assign(Name("has_letter"), Bool(true)),
        AugAssign(Name("swapped"), "+", Name("c"))))
    If(Name("has_letter"),
      Return(Name("swapped")),
      )
    Return(Name("reversed_s")))
  Assign(Name("example_digits"), Call(Name("solve"), Str("1234")))
  Assign(Name("example_letters"), Call(Name("solve"), Str("ab")))
  Assign(Name("example_mixed"), Call(Name("solve"), Str("#a@C")))
  Assign(Name("empty"), Call(Name("solve"), Str(""))))
