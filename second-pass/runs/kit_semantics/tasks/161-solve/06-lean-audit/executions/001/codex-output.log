/reference/k-proof/reference-semantics/semantics/str.k:53:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
/reference/k-proof/reference-semantics/semantics/str.k:54:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
/reference/k-proof/reference-semantics/semantics/str.k-55-
/reference/k-proof/reference-semantics/semantics/str.k-56-  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
/reference/k-proof/reference-semantics/semantics/str.k-57-  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
/reference/k-proof/reference-semantics/semantics/str.k-58-  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
/reference/k-proof/reference-semantics/semantics/str.k-59-  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
