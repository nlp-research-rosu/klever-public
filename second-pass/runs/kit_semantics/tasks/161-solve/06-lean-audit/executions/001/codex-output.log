+                    while (cursor < length
+                           && (buffer[cursor] == ' '
+                               || buffer[cursor] == '\t')) {
+                        ++cursor;
+                    }
+                    pid_t host_pid = 0;
+                    while (cursor < length
+                           && buffer[cursor] >= '0'
+                           && buffer[cursor] <= '9') {
+                        host_pid =
+                            host_pid * 10 + (pid_t)(buffer[cursor] - '0');
+                        ++cursor;
+                    }
+                    if (host_pid > 0) {
+                        return host_pid;
+                    }
+                }
+            }
+        }
+    }
+    return (pid_t)syscall(SYS_getpid);
+}
