#!/usr/bin/env python3
"""Model-free acceptance check for one Stage 5 Lean proof candidate."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
if str(REPO) not in sys.path:
    sys.path.insert(0, str(REPO))

from tools import klean_final_gate


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--generation", required=True, type=Path)
    parser.add_argument("--candidate", required=True, type=Path)
    arguments = parser.parse_args(argv)
    gate = subprocess.run(
        ["/usr/local/bin/assert-frozen-toolchain", "agent"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if gate.returncode != 0:
        result = {
            "status": "AUDIT_ERROR",
            "error": "frozen toolchain gate failed",
            "toolchain_output_tail": gate.stdout[-4000:],
        }
    else:
        result = klean_final_gate.evaluate_proof_candidate(
            arguments.generation, arguments.candidate
        )
        result["toolchain_gate"] = "PASS"
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
#!/usr/bin/env python3
"""Model-free Stage 6 gate for Klean classification and optional proof."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Callable

REPO = Path(__file__).resolve().parent.parent
if str(REPO) not in sys.path:
    sys.path.insert(0, str(REPO))

from tools import (
    klean_export,
    klean_preflight,
    pipeline_contract,
    stage6_resolution_contract,
)


class KleanFinalGateError(RuntimeError):
    pass


def _run(
    command: list[str],
    *,
    cwd: Path,
    timeout: int,
) -> tuple[int, str]:
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            timeout=timeout,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        return result.returncode, result.stdout
    except subprocess.TimeoutExpired:
        return 124, f"TIMEOUT after {timeout}s"


def _regular_json(path: Path, label: str) -> dict[str, Any]:
    if not path.is_file() or path.is_symlink():
        raise KleanFinalGateError(f"{label} is not a regular file")
    try:
        document = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        raise KleanFinalGateError(f"{label} is malformed") from error
    if not isinstance(document, dict):
        raise KleanFinalGateError(f"{label} must be a JSON object")
    return document


def _candidate_gate(candidate: Path, target: dict[str, Any]) -> None:
    entries = klean_export._tree_entries(candidate)
    proof = candidate / "Proof.lean"
    if not proof.is_file() or proof.is_symlink():
        raise KleanFinalGateError("candidate is missing regular Proof.lean")
    for required in ("lakefile.lean", "lean-toolchain"):
        path = candidate / required
        if not path.is_file() or path.is_symlink():
            raise KleanFinalGateError(f"candidate is missing regular {required}")
    candidate_sources: list[tuple[str, str]] = []
    for relative, kind, path in entries:
        if kind != "file" or path.suffix != ".lean":
            continue
        text = path.read_text()
        if Path(relative).parts[0] != "Base":
            candidate_sources.append((relative, text))
        forbidden = re.search(
            r"\b(?:sorry|admit|unsafe|axiom|opaque)\b", text
        )
        if forbidden is not None:
            raise KleanFinalGateError(
                f"candidate contains forbidden Lean token "
                f"{forbidden.group(0)!r} in {relative}"
            )
    statement = target.get("statement")
    parameters = target.get("parameters")
    if not isinstance(statement, str) or not statement:
        raise KleanFinalGateError("generator target statement is malformed")
    if not isinstance(parameters, list):
        raise KleanFinalGateError("generator target bindings are malformed")
    proof_text = proof.read_text()
    for parameter in parameters:
        if not isinstance(parameter, dict):
            raise KleanFinalGateError("generator target binding is malformed")
        name = parameter.get("name")
        lean_type = parameter.get("type")
        if not isinstance(name, str) or not isinstance(lean_type, str):
            raise KleanFinalGateError("generator target binding is malformed")
        declarations = [
            (relative, match.start())
            for relative, text in candidate_sources
            for match in re.finditer(
                rf"(?m)^\s*(?:@\[[^\n]*\]\s*)*"
                rf"(?:noncomputable\s+)?def\s+{re.escape(name)}"
                rf"\s*(?::|\()",
                text,
            )
        ]
        if len(declarations) != 1:
            raise KleanFinalGateError(
                f"candidate must define exact trust binding {name!r} once"
            )
    theorem_matches = re.findall(
        r"(?ms)^\s*theorem\s+final\s*:\s*(.*?)\s*:=\s*by\b",
        proof_text,
    )
    if len(theorem_matches) != 1:
        raise KleanFinalGateError(
            "candidate must contain exactly one theorem final"
        )
    if " ".join(theorem_matches[0].split()) != " ".join(statement.split()):
        raise KleanFinalGateError(
            "Proof.final does not state the exact generated target"
        )


def _allowed_axioms(inventory: dict[str, Any]) -> set[str]:
    allowlist = inventory.get("allowlist")
    if not isinstance(allowlist, list):
        raise KleanFinalGateError("trust inventory allowlist is malformed")
    names = {"Classical.choice", "propext", "Quot.sound"}
    for entry in allowlist:
        if not isinstance(entry, dict):
            raise KleanFinalGateError("trust inventory entry is malformed")
        name = entry.get("name")
        if not isinstance(name, str) or not name:
            raise KleanFinalGateError("trust inventory name is malformed")
        names.add(name)
    return names


def _parse_axioms(output: str) -> set[str]:
    matches = list(re.finditer(r"depends on axioms:\s*\[", output))
    axiom_free = re.findall(
        r"does not depend on any axioms", output
    )
    if len(matches) + len(axiom_free) != 1:
        raise KleanFinalGateError("#print axioms output is missing or ambiguous")
    if axiom_free:
        return set()
    tokens: list[str] = []
    token: list[str] = []
    quoted = False
    for character in output[matches[0].end() :]:
        if character == "«" and not quoted:
            quoted = True
            token.append(character)
        elif character == "»" and quoted:
            quoted = False
            token.append(character)
        elif character == "," and not quoted:
            name = "".join(token).strip()
            if not name:
                raise KleanFinalGateError(
                    "#print axioms output contains an empty axiom name"
                )
            tokens.append(name)
            token = []
        elif character == "]" and not quoted:
            name = "".join(token).strip()
            if name:
                tokens.append(name)
            return set(tokens)
        else:
            token.append(character)
    raise KleanFinalGateError("#print axioms output has no closing bracket")


def check_proof_candidate(
    generation: Path,
    candidate: Path,
    *,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    """Independently build and axiom-check one immutable Stage 5 proof."""

    generation = Path(generation)
    candidate = Path(candidate)
    manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    target = manifest.get("target")
    if not isinstance(target, dict):
        raise KleanFinalGateError("generator target is malformed")
    before_generation = klean_export.tree_digest(generation)
    before_candidate = klean_export.tree_digest(candidate)
    _candidate_gate(candidate, target)
    inventory = _regular_json(
        generation / "trust-inventory.json", "trust inventory"
    )
    diagnostics: list[dict[str, Any]] = []
    with tempfile.TemporaryDirectory(prefix="klean-proof-check-") as temporary:
        project = Path(temporary) / "project"
        shutil.copytree(candidate, project)
        if klean_export.tree_digest(project) != before_candidate:
            raise KleanFinalGateError(
                "candidate changed while copying for mechanical audit"
            )
        shutil.rmtree(project / ".lake", ignore_errors=True)
        shutil.rmtree(project / "Base", ignore_errors=True)
        shutil.copytree(generation / "generated", project / "Base")
        audit_source = project / "AxiomAudit.lean"
        audit_source.write_text(
            "import Proof\n\n"
            "namespace Proof\n\n"
            f"#check (final : {target['statement']})\n"
            "#print axioms final\n\n"
            "end Proof\n"
        )
        outputs: dict[tuple[str, ...], str] = {}
        commands = (
            ["lake", "clean"],
            ["lake", "build"],
            ["lake", "env", "lean", "AxiomAudit.lean"],
        )
        for command in commands:
            code, output = run_command(command, cwd=project, timeout=600)
            diagnostics.append(
                {
                    "command": command,
                    "exit_code": code,
                    "output_sha256": hashlib.sha256(
                        output.encode()
                    ).hexdigest(),
                    "output_tail": output[-4000:],
                }
            )
            outputs[tuple(command)] = output
            if code != 0:
                raise KleanFinalGateError(
                    f"{' '.join(command)} failed ({code}): {output[-600:]}"
                )
        used_axioms = _parse_axioms(
            outputs[("lake", "env", "lean", "AxiomAudit.lean")]
        )
    if klean_export.tree_digest(generation) != before_generation:
        raise KleanFinalGateError(
            "generation changed during mechanical audit"
        )
    if klean_export.tree_digest(candidate) != before_candidate:
        raise KleanFinalGateError(
            "candidate changed during mechanical audit"
        )
    if "sorryAx" in used_axioms:
        raise KleanFinalGateError("Proof.final depends on forbidden sorryAx")
    allowed = _allowed_axioms(inventory)
    unexpected = sorted(
        axiom for axiom in used_axioms if axiom not in allowed
    )
    if unexpected:
        raise KleanFinalGateError(
            "Proof.final has unrecorded axiom dependencies: "
            + ", ".join(unexpected)
        )
    return {
        "status": "PASS",
        "target": target,
        "generation_sha256": before_generation,
        "candidate_sha256": before_candidate,
        "used_axioms": sorted(used_axioms),
        "diagnostics": diagnostics,
    }


def evaluate_proof_candidate(
    generation: Path,
    candidate: Path,
    *,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    try:
        return check_proof_candidate(
            generation, candidate, run_command=run_command
        )
    except KleanFinalGateError as error:
        return {"status": "FAIL", "error": str(error)}
    except BaseException as error:
        return {
            "status": "AUDIT_ERROR",
            "error": f"{type(error).__name__}: {error}",
        }


def _audit_input_binding(path: Path) -> dict[str, Any]:
    document = _regular_json(path, "Stage 6 audit input")
    try:
        resolution, digest = (
            stage6_resolution_contract.verify_audit_input(document)
        )
    except (
        stage6_resolution_contract.Stage6ResolutionContractError
    ) as error:
        raise KleanFinalGateError(str(error)) from error
    mode = resolution.get("mode")
    hashes = resolution.get("hashes")
    if (
        mode not in {
            "CLASSIFICATION_ONLY",
            "CLASSIFICATION_AND_PROOF",
        }
        or not isinstance(hashes, dict)
    ):
        raise KleanFinalGateError(
            "Stage 6 audit input binding is malformed"
        )
    return {
        "resolution": resolution,
        "resolved_input_sha256": digest,
    }


def _input_hashes(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
) -> dict[str, Any]:
    try:
        return {
            "k_workspace_sha256": pipeline_contract.sha256_tree(
                frozen_input
            ),
            "stage1_export_sha256": klean_export.tree_digest(
                frozen_input
            ),
            "discovery_manifest_sha256": (
                pipeline_contract.sha256_file(discovery_manifest)
            ),
            "klean_generation_sha256": (
                pipeline_contract.sha256_tree(generation)
            ),
            "lean_workspace_sha256": (
                pipeline_contract.sha256_tree(candidate)
                if candidate is not None
                else None
            ),
        }
    except (
        OSError,
        klean_export.KleanExportError,
        pipeline_contract.PipelineContractError,
    ) as error:
        raise KleanFinalGateError(
            "cannot hash Stage 6 mechanical inputs"
        ) from error


def _require_bound_inputs(
    audit_input: dict[str, Any],
    observed: dict[str, Any],
) -> None:
    expected = audit_input["resolution"]["hashes"]
    for key, digest in observed.items():
        if expected.get(key) != digest:
            raise KleanFinalGateError(
                f"Stage 6 {key} differs from audit input"
            )


def _result_binding(audit_input: Path) -> dict[str, Any]:
    try:
        document = _audit_input_binding(Path(audit_input))
    except KleanFinalGateError:
        return {}
    return {
        "mode": document["resolution"]["mode"],
        "resolved_input_sha256": document[
            "resolved_input_sha256"
        ],
        "input_hashes": document["resolution"]["hashes"],
    }


def check_final(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    frozen_input = Path(frozen_input)
    discovery_manifest = Path(discovery_manifest)
    generation = Path(generation)
    candidate = Path(candidate) if candidate is not None else None
    audit_binding = _audit_input_binding(Path(audit_input))
    signed_resolution = audit_binding["resolution"]
    if (
        signed_resolution["mode"] == "CLASSIFICATION_AND_PROOF"
        and candidate is None
    ):
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    if (
        signed_resolution["mode"] == "CLASSIFICATION_ONLY"
        and candidate is not None
    ):
        raise KleanFinalGateError(
            "classification-only audit must not use a Stage 5 Lean "
            "candidate"
        )
    expected_mode = signed_resolution["mode"]
    observed_mode = (
        "CLASSIFICATION_AND_PROOF"
        if candidate is not None
        else "CLASSIFICATION_ONLY"
    )
    if observed_mode != expected_mode:
        raise KleanFinalGateError(
            "Stage 6 mechanical mode differs from audit input"
        )
    before_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    _require_bound_inputs(audit_binding, before_hashes)
    try:
        preflight = klean_preflight.check_generation(
            frozen_input,
            discovery_manifest,
            generation,
            toolchain_lock=toolchain_lock,
            run_command=run_command,
        )
    except klean_preflight.KleanPreflightError as error:
        raise KleanFinalGateError(
            f"deterministic Klean preflight failed: {error}"
        ) from error
    preflight_status = preflight.get("status")
    if preflight_status not in {"PASS", "KLEAN_NO_OBLIGATIONS"}:
        raise KleanFinalGateError(
            "Stage 4 Klean preflight is not mechanically auditable"
        )
    manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    target = manifest.get("target")
    if preflight_status == "KLEAN_NO_OBLIGATIONS":
        if candidate is not None:
            raise KleanFinalGateError(

diff --git a/evidence/hostpid_shim.c b/evidence/hostpid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..472d7e7960321c4891c410c92394dbb97e6f2a29
--- /dev/null
+++ b/evidence/hostpid_shim.c
@@ -0,0 +1,53 @@
+#define _GNU_SOURCE
+
+#include <fcntl.h>
+#include <stddef.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox's PID namespace and mounted /proc disagree. Lean 4.22
+ * resolves its executable through /proc/<getpid()>/exe, so return the first
+ * (host) NSpid value exposed by /proc/self/status.
+ */
+pid_t getpid(void) {
+    char buffer[8192];
+    const char key[] = "NSpid:";
+    int descriptor = open("/proc/self/status", O_RDONLY | O_CLOEXEC);
+    if (descriptor >= 0) {
+        ssize_t length = read(descriptor, buffer, sizeof(buffer) - 1);
+        close(descriptor);
+        if (length > 0) {
+            buffer[length] = '\0';
+            for (ssize_t index = 0; index + (ssize_t)sizeof(key) < length;
+                 ++index) {
+                size_t offset = 0;
+                while (offset < sizeof(key) - 1
+                       && buffer[index + (ssize_t)offset] == key[offset]) {
+                    ++offset;
+                }
+                if (offset == sizeof(key) - 1) {
+                    ssize_t cursor = index + (ssize_t)offset;
+                    while (cursor < length
+                           && (buffer[cursor] == ' '
+                               || buffer[cursor] == '\t')) {
+                        ++cursor;
+                    }
+                    pid_t host_pid = 0;
+                    while (cursor < length
+                           && buffer[cursor] >= '0'
+                           && buffer[cursor] <= '9') {
+                        host_pid =
+                            host_pid * 10 + (pid_t)(buffer[cursor] - '0');
+                        ++cursor;
+                    }
+                    if (host_pid > 0) {
+                        return host_pid;
+                    }
+                }
+            }
+        }
+    }
+    return (pid_t)syscall(SYS_getpid);
+}
diff --git a/evidence/structural_checks.py b/evidence/structural_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..5826fd1b45710fd18f4fdc7cf66b7808de0f27a4
--- /dev/null
+++ b/evidence/structural_checks.py
@@ -0,0 +1,360 @@
+#!/usr/bin/env python3
+"""Independent read-only structural checks for the 161-solve audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from tools import klean_export, lemma_discovery_contract, pipeline_contract
+from tools.k_rule_inventory import canonical_json_sha256, inventory_verification
+
+
+K_PROOF = Path("/reference/k-proof")
+DISCOVERY = Path("/reference/lemma-discovery.json")
+GENERATION = Path("/reference/klean-generation")
+GENERATED = GENERATION / "generated"
+PRODUCERS = Path("/reference/generation-tools")
+AUDIT_INPUT = Path("/audit-input.json")
+
+
+def sha256_file(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def load(path: Path) -> dict:
+    document = json.loads(path.read_text())
+    assert isinstance(document, dict)
+    return document
+
+
+def check(condition: bool, label: str) -> dict[str, object]:
+    return {"check": label, "pass": bool(condition)}
+
+
+def main() -> None:
+    audit = load(AUDIT_INPUT)["resolution"]
+    source_manifest = load(PRODUCERS / "source-manifest.json")
+    generator_manifest = load(GENERATION / "generator-manifest.json")
+    input_manifest = load(GENERATION / "input-manifest.json")
+    obligation_map = load(GENERATED / "obligation-map.json")
+    discovery_document = load(DISCOVERY)
+
+    image_id = generator_manifest["provenance"]["generator_image_id"]
+    expected_image_key = image_id.removeprefix("sha256:")
+    producer_hashes = {
+        name: sha256_file(PRODUCERS / name)
+        for name in ("klean_export.py", "klean.py")
+    }
+    producer_checks = [
+        check(
+            producer_hashes == source_manifest["files"],
+            "producer file hashes equal source-manifest files",
+        ),
+        check(
+            producer_hashes["klean_export.py"]
+            == generator_manifest["exporter_sha256"],
+            "klean_export.py hash equals generator-manifest exporter_sha256",
+        ),
+        check(
+            producer_hashes["klean.py"]
+            == generator_manifest["klean_py_sha256"],
+            "klean.py hash equals generator-manifest klean_py_sha256",
+        ),
+        check(
+            source_manifest["generator_image_id"] == image_id,
+            "source and generator manifests identify the same immutable image",
+        ),
+        check(
+            Path(audit["generation_producer_sources"]).name
+            == expected_image_key,
+            "audit-input producer path basename identifies the same image",
+        ),
+        check(
+            pipeline_contract.sha256_tree(PRODUCERS)
+            == audit["hashes"]["generation_producer_sources_sha256"],
+            "producer bundle tree equals audit-input hash",
+        ),
+        check(
+            {p.name for p in PRODUCERS.iterdir()}
+            == {"klean_export.py", "klean.py", "source-manifest.json"},
+            "producer bundle contains exactly the authenticated source set",
+        ),
+    ]
+
+    inventory = inventory_verification(K_PROOF)
+    validated = lemma_discovery_contract.validate_trust_boundary(
+        K_PROOF, DISCOVERY
+    )
+    canonical_ids = [rule["source_rule_id"] for rule in inventory["rules"]]
+    classified_ids = [
+        rule["source_rule_id"] for rule in discovery_document["rules"]
+    ]
+    verification_lines = (
+        (K_PROOF / "verification.k").read_text().splitlines()
+    )
+    per_rule = []
+    for rule in inventory["rules"]:
+        normalized = " ".join(rule["text"].split())
+        span_text = "\n".join(
+            verification_lines[rule["start_line"] - 1 : rule["end_line"]]
+        )
+        per_rule.append(
+            {
+                "source_rule_id": rule["source_rule_id"],
+                "module": rule["module"],
+                "start_line": rule["start_line"],
+                "end_line": rule["end_line"],
+                "attributes": rule["attributes"],
+                "normalized_sha256": rule["normalized_sha256"],
+                "checks": [
+                    check(
+                        sha256_file(K_PROOF / "verification.k")
+                        == inventory["verification_sha256"],
+                        "verification file hash",
+                    ),
+                    check(
+                        hashlib.sha256(normalized.encode()).hexdigest()
+                        == rule["normalized_sha256"],
+                        "normalized text hash",
+                    ),
+                    check(
+                        rule["source_rule_id"]
+                        == f"rule-{rule['normalized_sha256']}",
+                        "source_rule_id derived from normalized hash",
+                    ),
+                    check(
+                        span_text == rule["text"],
+                        "reported source span is exact",
+                    ),
+                ],
+                "text": rule["text"],
+            }
+        )
+    inventory_checks = [
+        check(
+            canonical_json_sha256(inventory["rules"])
+            == inventory["inventory_sha256"],
+            "whole inventory canonical hash",
+        ),
+        check(
+            inventory["inventory_sha256"]
+            == discovery_document["inventory_sha256"],
+            "discovery whole-inventory hash",
+        ),
+        check(
+            len(canonical_ids) == len(set(canonical_ids)),
+            "canonical IDs have no duplicates",
+        ),
+        check(
+            len(classified_ids) == len(set(classified_ids)),
+            "classified IDs have no duplicates",
+        ),
+        check(
+            classified_ids == canonical_ids,
+            "classified identities are a bijection in canonical source order",
+        ),
+        check(
+            inventory["verification_module"] == "VERIFICATION",
+            "selected verification module",
+        ),
+        check(
+            inventory["verification_modules"] == ["VERIFICATION"],
+            "local verification-module closure",
+        ),
+    ]
+
+    discovery_hash = sha256_file(DISCOVERY)
+    expected_domain_rules = klean_export._domain_source_rules(
+        validated, discovery_hash
+    )
+    obligations = obligation_map["obligations"]
+    observed_obligation_ids = [
+        obligation["source_rule_id"] for obligation in obligations
+    ]
+    expected_domain_ids = [
+        rule["source_rule_id"] for rule in expected_domain_rules
+    ]
+    per_obligation = []
+    for index, obligation in enumerate(obligations):
+        source_rule = expected_domain_rules[index]
+        per_obligation.append(
+            {
+                "source_rule_id": obligation["source_rule_id"],
+                "lean_conjunct": obligation["lean_conjunct"],
+                "checks": [
+                    check(
+                        obligation["source_rule_id"]
+                        == source_rule["source_rule_id"],
+                        "obligation source identity",
+                    ),
+                    check(
+                        obligation["source_span"]
+                        == {
+                            "start_line": source_rule["start_line"],
+                            "end_line": source_rule["end_line"],
+                        },
+                        "obligation source span",
+                    ),
+                    check(
+                        obligation["normalized_sha256"]
+                        == source_rule["normalized_sha256"],
+                        "obligation normalized source hash",
+                    ),
+                    check(
+                        obligation["inventory_sha256"]
+                        == source_rule["inventory_sha256"],
+                        "obligation inventory hash",
+                    ),
+                    check(
+                        obligation["discovery_manifest_sha256"]
+                        == source_rule["discovery_manifest_sha256"],
+                        "obligation discovery hash",
+                    ),
+                    check(
+                        klean_export.sha256_text(obligation["lean_conjunct"])
+                        == obligation["lean_conjunct_sha256"],
+                        "Lean conjunct hash",
+                    ),
+                ],
+            }
+        )
+
+    expected_definition = klean_export.expected_target_definition(
+        obligation_map
+    )
+    observed_target = klean_export.target_statement(GENERATED)
+    stage4_checks = [
+        check(
+            pipeline_contract.sha256_tree(K_PROOF)
+            == audit["hashes"]["k_workspace_sha256"],
+            "Stage 1 selected workspace tree hash",
+        ),
+        check(
+            klean_export.tree_digest(K_PROOF)
+            == audit["hashes"]["stage1_export_sha256"],
+            "Stage 1 deterministic-export tree hash",
+        ),
+        check(
+            sha256_file(DISCOVERY)
+            == audit["hashes"]["discovery_manifest_sha256"],
+            "Stage 3 discovery file hash",
+        ),
+        check(
+            pipeline_contract.sha256_tree(GENERATION)
+            == audit["hashes"]["klean_generation_sha256"],
+            "Stage 4 selected generation tree hash",
+        ),
+        check(
+            klean_export.tree_digest(GENERATED)
+            == audit["hashes"]["generated_tree_sha256"],
+            "generated project deterministic tree hash",
+        ),
+        check(
+            input_manifest["source_rules"] == expected_domain_rules,
+            "input-manifest source rules equal independently selected domain set",
+        ),
+        check(
+            obligation_map["source_rules"] == expected_domain_rules,
+            "obligation-map source rules equal independently selected domain set",
+        ),
+        check(
+            observed_obligation_ids == expected_domain_ids
+            and len(observed_obligation_ids)
+            == len(set(observed_obligation_ids)),
+            "exact source-rule/obligation bijection in source order",
+        ),
+        check(
+            generator_manifest["obligation_count"] == len(obligations),
+            "generator obligation count",
+        ),
+        check(
+            sha256_file(GENERATED / "obligation-map.json")
+            == generator_manifest["obligation_map_sha256"],
+            "obligation-map file hash",
+        ),
+        check(
+            expected_definition is not None
+            and klean_export.sha256_text(expected_definition)
+            == generator_manifest["target"]["definition_sha256"],
+            "fixed target is exact conjunction of obligations",
+        ),
+        check(
+            observed_target == generator_manifest["target"],
+            "generated target equals generator manifest",
+        ),
+        check(
+            observed_target == audit["target"],
+            "generated target equals audit input",
+        ),
+    ]
+
+    result = {
+        "audit_mode_environment": os.environ.get("AUDIT_MODE"),
+        "audit_mode_recorded": audit["mode"],
+        "producer_authentication": {
+            "observed_file_sha256": producer_hashes,
+            "source_manifest": source_manifest,
