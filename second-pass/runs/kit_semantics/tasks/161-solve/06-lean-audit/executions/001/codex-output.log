+                    check(
+                        rule["source_rule_id"]
+                        == f"rule-{rule['normalized_sha256']}",
+                        "source_rule_id derived from normalized hash",
+                    ),
+                    check(
+                        span_text == rule["text"],
+                        "reported source span is exact",
+                    ),
+                ],
+                "text": rule["text"],
+            }
