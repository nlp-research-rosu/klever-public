+            == expected_image_key,
+            "audit-input producer path basename identifies the same image",
+        ),
+        check(
+            pipeline_contract.sha256_tree(PRODUCERS)
+            == audit["hashes"]["generation_producer_sources_sha256"],
+            "producer bundle tree equals audit-input hash",
