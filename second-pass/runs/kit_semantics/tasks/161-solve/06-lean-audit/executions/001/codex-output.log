/reference/k-proof/reference-semantics/semantics/str.k:49:  rule strLt(.IntSeq, .IntSeq)                => false
/reference/k-proof/reference-semantics/semantics/str.k:50:  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
/reference/k-proof/reference-semantics/semantics/str.k:51:  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
