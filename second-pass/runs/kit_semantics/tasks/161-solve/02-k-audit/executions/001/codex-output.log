def solve(s):
    """You are given a string s.
    if s[i] is a letter, reverse its case from lower to upper or vise versa, 
    otherwise keep it as it is.
    If the string contains no letters, reverse the string.
    The function should return the resulted string.
    Examples
    solve("1234") = "4321"
    solve("ab") = "AB"
    solve("#a@C") = "#A@c"
    """
    flg = 0
    idx = 0
    new_str = list(s)
    for i in s:
        if i.isalpha():
            new_str[idx] = i.swapcase()
            flg = 1
        idx += 1
    s = ""
    for i in new_str:
        s += i
    if flg == 0:
        return s[len(s)::-1]
    return s
def solve(s):
    """Toggle letter case, or reverse a string containing no letters."""
    swapped = ""
    reversed_s = ""
    has_letter = False
    c = ""
    for c in s:
        reversed_s = c + reversed_s
        if c.isalpha():
            swapped += c.swapcase()
            has_letter = True
        else:
            swapped += c
    if has_letter:
        return swapped
    return reversed_s
Module(
  FuncDef("solve", Params("s"),
    Expr(
      Str(
        "Toggle letter case, or reverse a string containing no letters."))
    Assign(Name("swapped"), Str(""))
    Assign(Name("reversed_s"), Str(""))
    Assign(Name("has_letter"), Bool(false))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("s"),
      Assign(
        Name("reversed_s"),
        BinOp("+", Name("c"), Name("reversed_s")))
      If(Call(Attribute(Name("c"), "isalpha"), ),
        AugAssign(
          Name("swapped"),
          "+",
          Call(Attribute(Name("c"), "swapcase"), ))
        Assign(Name("has_letter"), Bool(true)),
        AugAssign(Name("swapped"), "+", Name("c"))))
    If(Name("has_letter"),
      Return(Name("swapped")),
      )
    Return(Name("reversed_s"))))
