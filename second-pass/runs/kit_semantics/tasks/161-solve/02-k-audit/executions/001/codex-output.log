printf 'COMMAND: kprove /audit-output/evidence/fresh-vacuity.k --definition verification-kompiled --spec-module FRESH-VACUITY\\n' | tee /audit-output/evidence/stage6_fresh_vacuity.log
kprove /audit-output/evidence/fresh-vacuity.k --definition verification-kompiled --spec-module FRESH-VACUITY 2>&1 | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
mutation_status="'${PIPESTATUS[0]}
printf '"'RAW_KPROVE_EXIT_STATUS: %d\\n' \""'$mutation_status" | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
if [[ "$mutation_status" -ne 0 ]] && rg -q '"'WarnStuckClaimState' /audit-output/evidence/stage6_fresh_vacuity.log && rg -q '\"answer\" |-> str \\( iCons \\( 65' /audit-output/evidence/stage6_fresh_vacuity.log && rg -q 'backend terminated because the configuration cannot be rewritten further' /audit-output/evidence/stage6_fresh_vacuity.log; then
  printf 'FALSE_POSTCONDITION_WITNESS input=\"a\" actual=\"A\" mutated_required=\"a\"\\n' | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
  printf 'FRESH_NON_VACUITY EXPECTED_FAILURE_PASS\\n' | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
  printf 'EXPECTED_PROBE_EXIT_STATUS: 0\\n' | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
  exit 0
fi
printf 'FRESH_NON_VACUITY PROBE_FAIL\\n' | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
printf 'EXPECTED_PROBE_EXIT_STATUS: 1\\n' | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
exit 1" in /tmp/audit-work/161-solve/scratch
