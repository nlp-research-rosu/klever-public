printf 'COMMAND: kprove /audit-output/evidence/fresh-vacuity.k --definition verification-kompiled --spec-module FRESH-VACUITY\\n' | tee /audit-output/evidence/stage6_fresh_vacuity.log
kprove /audit-output/evidence/fresh-vacuity.k --definition verification-kompiled --spec-module FRESH-VACUITY 2>&1 | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
mutation_status="'${PIPESTATUS[0]}
printf '"'RAW_KPROVE_EXIT_STATUS: %d\\n' \""'$mutation_status" | tee -a /audit-output/evidence/stage6_fresh_vacuity.log
if [[ "$mutation_status" -ne 0 ]] && rg -q '"'WarnStuckClaimState' /audit-output/evidence/stage6_fresh_vacuity.log && rg -Fq '\"answer\" |-> str ( iCons ( 65' /audit-output/evidence/stage6_fresh_vacuity.log && rg -q 'backend terminated because the configuration cannot be rewritten further' /audit-output/evidence/stage6_fresh_vacuity.log; then
