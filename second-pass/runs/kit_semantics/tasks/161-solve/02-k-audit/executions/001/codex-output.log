+fi
+
+printf 'STAGE: required candidate proof artifact types\n'
+for path in \
+  /candidate/solution.py \
+  /candidate/solution.mpy \
+  /candidate/verification.k \
+  /candidate/spec.k \
+  /candidate/prove.sh \
+  /candidate/PROOF.md; do
