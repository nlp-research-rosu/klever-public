index 0000000000000000000000000000000000000000..a71a7110a1b0df636166e89ab9a344882aa0bdef
--- /dev/null
+++ b//tmp/audit-work/161-solve/scratch/concrete_unicode_gap.py
@@ -0,0 +1,19 @@
+def solve(s):
+    """Toggle letter case, or reverse a string containing no letters."""
+    swapped = ""
+    reversed_s = ""
+    has_letter = False
+    c = ""
+    for c in s:
+        reversed_s = c + reversed_s
+        if c.isalpha():
+            swapped += c.swapcase()
+            has_letter = True
+        else:
+            swapped += c
+    if has_letter:
+        return swapped
+    return reversed_s
+
+
+unicode_gap = solve("é1")
