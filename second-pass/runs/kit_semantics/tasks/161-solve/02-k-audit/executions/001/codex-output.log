+    "Z#a",
+    "abcXYZ",
+    "123# abc XYZ!",
+    "é",
+    "é1",
+    "éa",
+    "ß",
+    "ß1",
+    "İ",
+    "Σσς",
+    "Жя",
+    "中文",
+    "א",
+    "ا",
+    "e\u0301",
+    "\u0301",
+    "😀",
+    "😀1",
+    "𐐀𐐨",
+    "\x00",
+    "\x00a\x00",
+]
+
+small_alphabet = ["a", "Z", "0", "#", " ", "\n", "é", "ß", "Σ", "\u0301", "😀"]
+exhaustive_cases = (
