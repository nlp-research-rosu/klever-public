   137	  rule applyBuiltin("max", V:Val, (V2:Val, REST:Vals)) => maxVals(V, (V2, REST))
   138	       requires isFloat(V) orBool isBool(V) orBool isStr(V)
   139	  rule maxVals(M:Val, .Vals)           => M
   140	  rule maxVals(M:Val, (V:Val, R:Vals)) => maxVals(V, R) requires applyCmp(">", V, M)
   141	  rule maxVals(M:Val, (V:Val, R:Vals)) => maxVals(M, R) requires notBool applyCmp(">", V, M)
   142	
   143	  syntax Val ::= minVals(Val, Vals) [function]
   144	  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
   145	  rule applyBuiltin("min", V:Val, (V2:Val, REST:Vals)) => minVals(V, (V2, REST))
   146	       requires isFloat(V) orBool isBool(V) orBool isStr(V)
   147	  rule minVals(M:Val, .Vals)           => M
   148	  rule minVals(M:Val, (V:Val, R:Vals)) => minVals(V, R) requires applyCmp("<", V, M)
   149	  rule minVals(M:Val, (V:Val, R:Vals)) => minVals(M, R) requires notBool applyCmp("<", V, M)
   150	
   151	  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
   152	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   153	       requires N >=Int 0
   154	  // negative operand: the '-' sign prefixes the magnitude's digits
   155	  rule applyBuiltin("bin", N:Int, .Vals)
   156	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   157	       requires N <Int 0
   158	  syntax IntSeq ::= binCodes(Int) [function, total]
   159	  rule binCodes(0) => iCons(48, .IntSeq)
   160	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   161	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   162	  rule binAcc(0, ACC:IntSeq) => ACC
   163	  rule binAcc(N:Int, ACC:IntSeq)
   164	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   165	       requires N >Int 0
   166	
   167	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   168	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   169	        => #alloc(list(enumVS(VS, 0))) ... </k>
   170	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   171	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   172	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   173	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   174	
   175	  // ==== map(str, xs) — eager (only the str case is in the subset) =============
   176	  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
   177	        => #alloc(list(mapStrVS(VS))) ... </k>
   178	  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
   179	  rule mapStrVS(.ValSeq) => .ValSeq
   180	  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
   181	  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
   182	
   183	  // ==== int(x) identities (int(round(x)) composes through) ====================
   184	  rule applyBuiltin("int", I:Int, .Vals) => I
   185	
   186	  // ==== ord / chr ===========================================================
   187	  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
   188	  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
   189	       requires 0 <=Int I andBool I <Int 128
   190	
   191	  // ==== str(int) / str(str) =================================================
   192	  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
   193	  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
   194	
   195	  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
   196	  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
   197	       requires 48 <=Int C andBool C <=Int 57
   198	
   199	  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
   200	  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
   201	       requires isLen(CS) >=Int 2
   202	  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
   203	  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
   204	  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
   205	
   206	  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
   207	  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
   208	  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
   209	
   210	  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
   211	  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
   212	        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
   213	  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
   214	  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
   215	  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
   216	        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
   217	  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
   218	  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>
   219	
   220	  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
   221	  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
   222	  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
   223	  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
   224	       requires S =/=Int 0
   225	
   226	  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
   227	  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
   228	  // trusted pass evaluator, now DEFINED in the reference and driven by a
   229	  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
   230	  // argument leaves the call unevaluated for problem-level folds.
   231	  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
   232	  syntax Int ::= evalArith(IntSeq) [function]
   233	  rule evalArith(CS:IntSeq)
   234	    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))
   235	
   236	  syntax OpSeq ::= ".OpSeq" | oCons(String, OpSeq)
   237	
   238	  syntax Bool ::= evDigit(Int) [function, total]
   239	  rule evDigit(C:Int) => C >=Int 48 andBool C <=Int 57
   240	  syntax Bool ::= evHead42(IntSeq) [function, total]
   241	  rule evHead42(iCons(42, _:IntSeq)) => true
   242	  rule evHead42(_:IntSeq)            => false [owise]
   243	  syntax Bool ::= evHead47(IntSeq) [function, total]
   244	  rule evHead47(iCons(47, _:IntSeq)) => true
   245	  rule evHead47(_:IntSeq)            => false [owise]
   246	
   247	  syntax OpSeq ::= tokOps(IntSeq) [function, total]
   248	  rule tokOps(.IntSeq)                 => .OpSeq
   249	  rule tokOps(iCons(32, R:IntSeq))     => tokOps(R)
   250	  rule tokOps(iCons(C:Int, R:IntSeq))  => tokOps(R) requires evDigit(C)
   251	  rule tokOps(iCons(42, iCons(42, R:IntSeq))) => oCons("**", tokOps(R))
   252	  rule tokOps(iCons(42, R:IntSeq))     => oCons("*", tokOps(R)) requires notBool evHead42(R)
   253	  rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons("//", tokOps(R))
   254	  rule tokOps(iCons(47, R:IntSeq))     => oCons("/", tokOps(R)) requires notBool evHead47(R)
   255	  rule tokOps(iCons(43, R:IntSeq))     => oCons("+", tokOps(R))
   256	  rule tokOps(iCons(45, R:IntSeq))     => oCons("-", tokOps(R))
   257	
   258	  syntax IntSeq ::= tokNds(IntSeq) [function, total]
   259	                  | tokNdAcc(Int, IntSeq) [function, total]
   260	  rule tokNds(.IntSeq)                => .IntSeq
   261	  rule tokNds(iCons(32, R:IntSeq))    => tokNds(R)
   262	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNdAcc(C -Int 48, R) requires evDigit(C)
   263	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNds(R)
   264	       requires notBool evDigit(C) andBool C =/=Int 32
   265	  rule tokNdAcc(A:Int, iCons(C:Int, R:IntSeq)) => tokNdAcc(A *Int 10 +Int (C -Int 48), R)
   266	       requires evDigit(C)
   267	  rule tokNdAcc(A:Int, S:IntSeq) => iCons(A, tokNds(S)) [owise]
   268	
   269	  syntax EvPair ::= evp(OpSeq, IntSeq)
   270	  syntax Int ::= firstNdE(EvPair) [function, total]
   271	  rule firstNdE(evp(_:OpSeq, iCons(N:Int, _:IntSeq))) => N
   272	  rule firstNdE(_:EvPair) => 0 [owise]
   273	
   274	  syntax Int ::= applyOpE(String, Int, Int) [function, total]
   275	  rule applyOpE("+",  A:Int, B:Int) => A +Int B
   276	  rule applyOpE("-",  A:Int, B:Int) => A -Int B
   277	  rule applyOpE("*",  A:Int, B:Int) => A *Int B
   278	  rule applyOpE("//", A:Int, B:Int) => A divInt B
   279	  rule applyOpE("**", A:Int, B:Int) => A ^Int B
   280	  rule applyOpE(_:String, A:Int, _:Int) => A [owise]
   281	
   282	  syntax EvPair ::= passPowE(OpSeq, IntSeq) [function, total]
   283	  rule passPowE(.OpSeq, NDS:IntSeq) => evp(.OpSeq, NDS)
   284	  rule passPowE(oCons("**", OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCombE(N, passPowE(OPS, NDS))
   285	  rule passPowE(oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCarryE(O, N, passPowE(OPS, NDS))
   286	       requires O =/=String "**"
   287	  rule passPowE(_:OpSeq, .IntSeq) => evp(.OpSeq, .IntSeq) [owise]
   288	  syntax EvPair ::= powCombE(Int, EvPair) [function, total]
   289	  rule powCombE(N:Int, evp(OPS:OpSeq, iCons(M:Int, REST:IntSeq))) => evp(OPS, iCons(N ^Int M, REST))
   290	  rule powCombE(N:Int, evp(OPS:OpSeq, .IntSeq)) => evp(OPS, iCons(N, .IntSeq))
   291	  syntax EvPair ::= powCarryE(String, Int, EvPair) [function, total]
   292	  rule powCarryE(O:String, N:Int, evp(OPS:OpSeq, NDS:IntSeq)) => evp(oCons(O, OPS), iCons(N, NDS))
   293	
   294	  syntax EvPair ::= passMulE(EvPair) [function, total] | passAddE(EvPair) [function, total]
   295	  rule passMulE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("mul", N0, OPS, NDS, .OpSeq, .IntSeq)
   296	  rule passMulE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   297	  rule passAddE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("add", N0, OPS, NDS, .OpSeq, .IntSeq)
   298	  rule passAddE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   299	  syntax EvPair ::= passLGoE(String, Int, OpSeq, IntSeq, OpSeq, IntSeq) [function, total]
   300	  rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))
   301	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   302	    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)
   303	       requires inLevelE(L, O)
   304	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   305	    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))
   306	       requires notBool inLevelE(L, O)
   307	  rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)
   308	    => evp(OO, appendIE(ON, CUR)) [owise]
   309	  syntax Bool ::= inLevelE(String, String) [function, total]
   310	  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
   311	  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
   312	  rule inLevelE(_:String, _:String) => false [owise]
   313	  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
   314	  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
   315	  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))
   316	  syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]
   317	  rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)
   318	  rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))
   319	
   320	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   321	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   322	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   323	  syntax KItem ::= "#md5"
   324	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   325	       [priority(40)]
   326	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   327	  syntax Val ::= md5Obj(IntSeq)
   328	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   329	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   330	
   331	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   332	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   333	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   334	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   335	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   336	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   337	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   338	  rule isIntV(_:Int)         => true
   339	  // bool is a subtype of int in Python: isinstance(True, int) is True
   340	  rule isIntV(_:Bool)        => true
   341	  rule isIntV(_:Val)         => false [owise]
   342	  rule isStrV(str(_:IntSeq)) => true
   343	  rule isStrV(_:Val)         => false [owise]
   344	endmodule
     1	// reference/src/semantics/dict.k — MPY-DICT
     2	//
     3	// Minimal dict support. A dict value is `dictV(KS, VS)`: PARALLEL insertion-ordered key/value
     4	// ValSeqs (Python dict order; keys distinct; re-inserting a key updates its value in place, keeping
     5	// the original position). Concrete for krun (the ordered build + `.keys()` are the real ops); a proof
     6	// over a SYMBOLIC dict passes `dictV(KS, WS)` with a symbolic key sequence KS and reads
     7	// `d.keys() = list(KS)`, then keeps each key opaque problem-locally.
     8	//
     9	// Only the pieces needed so far: a dict VALUE (so `{}` inside a mixed list evaluates and
    10	// `isinstance(x, int)` rejects it), the `{k: v, ...}` literal, and `.keys()`. More dict ops (subscript
    11	// / `.get()` / `.values()` / dict `==`) are added as dict problems need them — kept minimal + additive.
    12	
    13	module MPY-DICT
    14	  imports MPY-CORE
    15	  imports MPY-ITER
    16	  imports MPY-METHODS
    17	  imports MPY-LIST
    18	
    19	  // dict as PARALLEL ordered key/value ValSeqs (same length; keys distinct).
    20	  syntax Val ::= dictV(ValSeq, ValSeq)
    21	
    22	  // ==== DictExpr: {k: v, ...} literal. Eval each key then value, left to right, insert-with-dedup.
    23	  syntax KItem ::= #dictAcc(Entries, ValSeq, ValSeq)
    24	                 | #dictKey(Expr, Entries, ValSeq, ValSeq)
    25	                 | #dictVal(Val, Entries, ValSeq, ValSeq)
    26	  rule <k> DictExpr(ES:Entries) => #dictAcc(ES, .ValSeq, .ValSeq) ... </k>
    27	  rule <k> #dictAcc(.Entries, KS:ValSeq, VS:ValSeq) => dictV(KS, VS) ... </k>
    28	  rule <k> #dictAcc((Entry(K:Expr, V:Expr), REST:Entries), KS:ValSeq, VS:ValSeq)
    29	        => K ~> #dictKey(V, REST, KS, VS) ... </k>
    30	  rule <k> KV:Val ~> #dictKey(V:Expr, REST:Entries, KS:ValSeq, VS:ValSeq)
    31	        => V ~> #dictVal(KV, REST, KS, VS) ... </k>
    32	  rule <k> VV:Val ~> #dictVal(KV:Val, REST:Entries, KS:ValSeq, VS:ValSeq)
    33	        => #dictAcc(REST, dPutK(KS, KV), dPutV(KS, VS, KV, VV)) ... </k>
    34	
    35	  // insert-with-dedup helpers (concrete Val key equality via ==K). [total] so buildFold over a dict is
    36	  // total (its #Ceil is #Top) — needed when a symbolic proof carries a built dict as a config value.
    37	  syntax Bool ::= dHasKey(ValSeq, Val) [function, total]
    38	  rule dHasKey(.ValSeq, _:Val)                => false
    39	  rule dHasKey(vCons(A:Val, _:ValSeq), K:Val) => true          requires A ==K K
    40	  rule dHasKey(vCons(A:Val, R:ValSeq), K:Val) => dHasKey(R, K) requires notBool (A ==K K)
    41	
    42	  // dPutK: KS unchanged if K already present, else append K (keep-first-position).
    43	  syntax ValSeq ::= dPutK(ValSeq, Val) [function, total]
    44	  rule dPutK(KS:ValSeq, K:Val) => KS                                  requires dHasKey(KS, K)
    45	  rule dPutK(KS:ValSeq, K:Val) => valSeqConcat(KS, vCons(K, .ValSeq)) requires notBool dHasKey(KS, K)
    46	
    47	  // dPutV: parallel to KS — set the value at K's position if present, else append V at the end. The
    48	  // [owise] catch-all covers the degenerate mismatched-length case (never reached for a well-formed dict).
    49	  syntax ValSeq ::= dPutV(ValSeq, ValSeq, Val, Val) [function, total]
    50	  rule dPutV(vCons(A:Val, _:ValSeq), vCons(_:Val, VR:ValSeq), K:Val, V:Val)  => vCons(V, VR)
    51	       requires A ==K K
    52	  rule dPutV(vCons(A:Val, KR:ValSeq), vCons(B:Val, VR:ValSeq), K:Val, V:Val) => vCons(B, dPutV(KR, VR, K, V))
    53	       requires notBool (A ==K K)
    54	  rule dPutV(_KS:ValSeq, VS:ValSeq, _K:Val, V:Val) => valSeqConcat(VS, vCons(V, .ValSeq)) [owise]
    55	
    56	  // ==== dict methods ========================================================
    57	  // d.keys() -> a FRESH list object of the ordered keys (k-cell: it allocates).
    58	  rule <k> #applyK(toCall(boundMethodV(dictV(KS:ValSeq, _:ValSeq), "keys")), .Vals)
    59	        => #alloc(list(KS)) ... </k>
    60	       [priority(40)]
    61	
    62	  // ==== dict subscript READ: d[k] (assoc lookup; KeyError is out of subset) ==
    63	  rule applyIndexD(dictV(KS:ValSeq, VS:ValSeq), K:Val) => dGet(KS, VS, K)
    64	  syntax Val ::= applyIndexD(Val, Val) [function]
    65	  rule <k> Subscript(dictV(KS:ValSeq, VS:ValSeq), K:Val) => applyIndexD(dictV(KS, VS), K) ... </k>
    66	       [priority(45)]
    67	
    68	  // ==== dict subscript-assign: d[k] = v (insert/update in place) =============
    69	  // Only for a LOCAL dict variable X (the current scope holds it). Reuses dPutK/dPutV.
    70	  syntax Val ::= dictSet(Val, Val, Val) [function]
    71	  rule dictSet(dictV(KS:ValSeq, VS:ValSeq), K:Val, V:Val) => dictV(dPutK(KS, K), dPutV(KS, VS, K, V))
    72	
    73	  // RHS evaluates first (Assign strictness), then the key. Dispatch on the scope
    74	  // value: a bare dict updates in the scope (dicts stay values); a ref (a heap
    75	  // list — or a heap dict later) writes the heap in place.
    76	  syntax KItem ::= #dsetK(String, Val)
    77	  rule <k> Assign(Subscript(Name(X:String), K:Expr), VV:Val) => K ~> #dsetK(X, VV) ... </k>
    78	  rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => .K ... </k>
    79	       <env> L:Int </env>
    80	       <scopes> ... L |-> scope(M:Map => M [ X <- dictSet({M[X]}:>Val, KV, VV) ], _) ... </scopes>
    81	       requires X in_keys(M) andBool notBool isRefV({M[X]}:>Val)
    82	  rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => #dsetV({M[X]}:>Val, KV, VV) ... </k>
    83	       <env> L:Int </env>
    84	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    85	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    86	  syntax KItem ::= #dsetV(Val, Val, Val)
    87	  rule <k> #dsetV(ref(H:Int), I:Int, VV:Val) => .K ... </k>
    88	       <heap> ... H |-> list(VS:ValSeq => setVSAt(VS, normIdxD(I, vsLen(VS)), VV)) ... </heap>
    89	  // negative-index normalization local to the write (subscript.k's is not imported here)
    90	  syntax Int ::= normIdxD(Int, Int) [function, total]
    91	  rule normIdxD(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
    92	  rule normIdxD(I:Int, _:Int)   => I          requires I >=Int 0
    93	
    94	  // ==== dict == (order-insensitive: same size + same key->value pairs) =======
    95	  rule applyCmp("==", dictV(KS1:ValSeq, VS1:ValSeq), dictV(KS2:ValSeq, VS2:ValSeq))
    96	    => (vsLen(KS1) ==Int vsLen(KS2)) andBool dSubset(KS1, VS1, KS2, VS2)
    97	  syntax Bool ::= dSubset(ValSeq, ValSeq, ValSeq, ValSeq) [function]
    98	  rule dSubset(.ValSeq, .ValSeq, _:ValSeq, _:ValSeq) => true
    99	  rule dSubset(vCons(K:Val, KR:ValSeq), vCons(V:Val, VR:ValSeq), KS2:ValSeq, VS2:ValSeq)
   100	    => dHasKey(KS2, K) andBool (dGet(KS2, VS2, K) ==K V) andBool dSubset(KR, VR, KS2, VS2)
   101	  syntax Val ::= dGet(ValSeq, ValSeq, Val) [function]
   102	  rule dGet(vCons(A:Val, _:ValSeq), vCons(B:Val, _:ValSeq), K:Val) => B                requires A ==K K
   103	  rule dGet(vCons(A:Val, KR:ValSeq), vCons(_:Val, VR:ValSeq), K:Val) => dGet(KR, VR, K) requires notBool (A ==K K)
   104	endmodule
     1	// reference/src/semantics/subscript.k — MPY-SUBSCRIPT
     2	
     3	module MPY-SUBSCRIPT
     4	  imports MPY-CORE
     5	
     6	  // ==== positional access + negative-index normalization (used only here) ===
     7	  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
     8	  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
     9	  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
    10	  // atK. K trusts the [total] annotation; valid programs index in-bounds.
    11	  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
    12	  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
    13	  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
    14	       requires I >Int 0
    15	
    16	  syntax Int ::= intSeqAt(IntSeq, Int) [function]
    17	  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C
    18	  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
    19	       requires I >Int 0
    20	
    21	  syntax Int ::= normIdx(Int, Int) [function, total]
    22	  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
    23	  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0
    24	
    25	  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================
    26	  // contexts (not strict attrs): the Index slot's Slice alternative must never heat
    27	  context Subscript(HOLE, _)
    28	  context Subscript(_:Val, HOLE:Expr)
    29	
    30	  // heap-object deref (covers both the index and slice forms via the Index slot)
    31	  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       [priority(40)]
    34	
    35	  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>
    36	
    37	  syntax Val ::= applyIndex(Val, Int) [function]
    38	  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    39	  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    40	  rule applyIndex(str(IS:IntSeq),   I:Int)
    41	    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))
    42	
    43	  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
    44	  syntax KItem ::= #evalB(Bound) | "#toSome"
    45	                 | #slLo(Val, Bound, Bound)
    46	                 | #slHi(Val, OptInt, Bound)
    47	                 | #slStep(Val, OptInt, OptInt)
    48	
    49	  syntax OptInt ::= "noB" | someB(Int)
    50	  rule <k> #evalB(NoBound)  => noB ... </k>
    51	  rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>
    52	  rule <k> I:Int ~> #toSome => someB(I) ... </k>
    53	
    54	  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>
    55	  rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>
    56	  rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>
    57	  // a list slice constructs a NEW object; a str slice stays a value
    58	  rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)
    59	        => #alloc(doSlice(list(VS), LO, HI, ST)) ... </k>
    60	       [priority(45)]
    61	  rule <k> ST:OptInt ~> #slStep(OBJ:Val, LO:OptInt, HI:OptInt) => doSlice(OBJ, LO, HI, ST) ... </k>
    62	
    63	  syntax Val ::= doSlice(Val, OptInt, OptInt, OptInt) [function]
    64	  rule doSlice(list(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    65	    => list(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
    66	  rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    67	    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
    68	  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    69	    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))
    70	
    71	  // ==== slice.indices: step / start / stop / clamp ==========================
    72	  syntax Int ::= slStep(OptInt) [function, total]
    73	  rule slStep(noB)          => 1
    74	  rule slStep(someB(S:Int)) => S
    75	
    76	  syntax Int ::= slStart(OptInt, OptInt, Int) [function]
    77	  rule slStart(noB,          ST:OptInt, _LEN:Int) => 0
    78	       requires slStep(ST) >Int 0
    79	  rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1
    80	       requires slStep(ST) <Int 0
    81	  rule slStart(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
    82	
    83	  syntax Int ::= slStop(OptInt, OptInt, Int) [function]
    84	  rule slStop(noB,          ST:OptInt, LEN:Int)  => LEN
    85	       requires slStep(ST) >Int 0
    86	  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
    87	       requires slStep(ST) <Int 0
    88	  rule slStop(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
    89	
    90	  syntax Int ::= slAdjust(Int, Int, Int) [function, total]
    91	  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampLo(I +Int LEN, STEP)
    92	       requires I  <Int 0
    93	  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampHi(I, LEN, STEP)
    94	       requires I >=Int 0
    95	
    96	  syntax Int ::= clampLo(Int, Int) [function, total]
    97	  rule clampLo(J:Int, _STEP:Int) => J
    98	       requires J >=Int 0
    99	  rule clampLo(J:Int, STEP:Int)  => #if STEP <Int 0 #then -1 #else 0 #fi
   100	       requires J <Int 0
   101	
   102	  syntax Int ::= clampHi(Int, Int, Int) [function, total]
   103	  rule clampHi(I:Int, LEN:Int, _STEP:Int) => I
   104	       requires I  <Int LEN
   105	  rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi
   106	       requires I >=Int LEN
   107	
   108	  // ==== build the strided sub-sequence (indices in range by construction) ====
   109	  syntax ValSeq ::= buildVS(ValSeq, Int, Int, Int) [function]
   110	  rule buildVS(VS:ValSeq, I:Int, STOP:Int, STEP:Int)
   111	    => vCons(valSeqAt(VS, I), buildVS(VS, I +Int STEP, STOP, STEP))
   112	       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
   113	  rule buildVS(_:ValSeq, I:Int, STOP:Int, STEP:Int) => .ValSeq
   114	       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
   115	
   116	  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]
   117	  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
   118	    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
   119	       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
   120	  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
   121	       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
   122	endmodule

diff --git a//tmp/audit-work/161-solve/scratch/concrete_cases.py b//tmp/audit-work/161-solve/scratch/concrete_cases.py
new file mode 100644
index 0000000000000000000000000000000000000000..4da22bb686a391d2b50e28adc4c984e026030df7
--- /dev/null
+++ b//tmp/audit-work/161-solve/scratch/concrete_cases.py
@@ -0,0 +1,28 @@
+def solve(s):
+    """Toggle letter case, or reverse a string containing no letters."""
+    swapped = ""
+    reversed_s = ""
+    has_letter = False
+    c = ""
+    for c in s:
+        reversed_s = c + reversed_s
+        if c.isalpha():
+            swapped += c.swapcase()
+            has_letter = True
+        else:
+            swapped += c
+    if has_letter:
+        return swapped
+    return reversed_s
+
+
+example_digits = solve("1234")
+example_letters = solve("ab")
+example_mixed = solve("#a@C")
+empty = solve("")
+single_nonletter = solve("#")
+single_letter = solve("z")
+no_letters_odd = solve("1#2")
+letter_first = solve("a12")
+letter_last = solve("12Z")
+case_boundaries = solve("AzZa")
