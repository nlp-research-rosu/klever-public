+if [[ "$campaign_status" -ne 0 ]]; then
+  failures=$((failures + 1))
+fi
+
+printf 'STAGE: candidate/trusted prompt, translator, and supplied semantics\n'
+if cmp -s /candidate/prompt.py /reference/prompt.py; then
+  printf 'PROMPT_BYTE_IDENTITY PASS\n'
