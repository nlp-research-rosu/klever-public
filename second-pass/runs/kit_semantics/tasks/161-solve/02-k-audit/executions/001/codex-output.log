+  "$scratch" "$scratch"
+python3 /reference/py2mpy.py "$scratch/solution.py" > "$scratch/regenerated-solution.mpy"
+translator_status=$?
+printf 'TRANSLATOR_EXIT_STATUS: %d\n' "$translator_status"
+if [[ "$translator_status" -ne 0 ]]; then
+  failures=$((failures + 1))
+fi
+
