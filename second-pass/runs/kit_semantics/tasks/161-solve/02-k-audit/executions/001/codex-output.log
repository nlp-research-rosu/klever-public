    58	module MPY
    59	  imports MPY-CORE
    60	  imports MPY-ITER
    61	  imports MPY-RANGE
    62	  imports MPY-OPERATORS
    63	  imports MPY-INT
    64	  imports MPY-BOOL
    65	  imports MPY-FLOAT
    66	  imports MPY-STR
    67	  imports MPY-SET
    68	  imports MPY-LIST
    69	  imports MPY-TUPLE
