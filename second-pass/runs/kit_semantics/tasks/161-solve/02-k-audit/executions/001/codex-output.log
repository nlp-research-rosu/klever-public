+          Call(Name("solve"), str(iCons(97, .IntSeq))))
+        .Stmts))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0  |-> scope(
