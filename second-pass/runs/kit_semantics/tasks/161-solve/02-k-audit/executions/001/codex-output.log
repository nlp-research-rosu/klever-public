+               "answer" |-> solveResult(iCons(97, .IntSeq))
+               "solve"  |-> ?SOLVE:Val,
+               parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
