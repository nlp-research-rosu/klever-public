index 0000000000000000000000000000000000000000..04e71aae4306c1fd4f5ee66a492071061eb47a63
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+requires "verification-with-lemma.k"
+
+module LOOP-PROOF
+  imports VERIFICATION
+
+  // Loop-tail invariant: from nonnegative remaining magnitude N and current
+  // counters E/O, the exact loop and return suffix add the digit summaries.
+  claim [loop-tail]:
+    <k> #while(Compare(Name("num"), CmpOp(">", Int(0))),
+          Assign(Name("even"),
+                 BinOp("-",
+                   BinOp("+", Name("even"), Int(1)),
+                   BinOp("%", Name("num"), Int(2))))
+          Assign(Name("odd"),
+                 BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
+          Assign(Name("num"), BinOp("//", Name("num"), Int(10)))
+          .Stmts)
+        ~> (Return(TupleExpr(Name("even"), Name("odd"))) .Stmts)
+        ~> #endcall
+        => tuple(vCons(?ER:Int, vCons(?OR:Int, .ValSeq))) ~> CONT
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> B:Scope
+       0 |-> scope("even_odd_count" |-> C:Val, parent(-1))
+       1 |-> scope("num"  |-> N
+                   "even" |-> E
+                   "odd"  |-> O,
+                   parent(0))
+      =>
+      -1 |-> B
+       0 |-> scope("even_odd_count" |-> C, parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(CONT, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    ensures ?ER ==Int E +Int evenPos(N)
+     andBool ?OR ==Int O +Int oddPos(N)
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-LEMMA
+
+  // Whole function call from an exact module binding, for every mathematical
+  // integer accepted by the HumanEval signature.
+  claim [even-odd-count]:
+    <k> Call(Name("even_odd_count"), N:Int)
+        => tuple(vCons(?ER:Int, vCons(?OR:Int, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope("even_odd_count" |-> evenOddClosure, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?ER ==Int decEven(N)
+     andBool ?OR ==Int decOdd(N)
+endmodule
diff --git a/verification-with-lemma.k b/verification-with-lemma.k
new file mode 100644
index 0000000000000000000000000000000000000000..90e0e2de71e09ca7e8370d439979064b0b0263a3
--- /dev/null
+++ b/verification-with-lemma.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module VERIFICATION-WITH-LEMMA
+  imports VERIFICATION
+
+  // Operational use of the independently proved LOOP-PROOF.loop-tail theorem.
+  // Its complete match context and state footprint are identical to that claim.
+  rule
+    <k> #while(Compare(Name("num"), CmpOp(">", Int(0))),
+          Assign(Name("even"),
+                 BinOp("-",
+                   BinOp("+", Name("even"), Int(1)),
+                   BinOp("%", Name("num"), Int(2))))
+          Assign(Name("odd"),
+                 BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
+          Assign(Name("num"), BinOp("//", Name("num"), Int(10)))
+          .Stmts)
+        ~> (Return(TupleExpr(Name("even"), Name("odd"))) .Stmts)
+        ~> #endcall
+        => tuple(vCons(E +Int evenPos(N),
+                      vCons(O +Int oddPos(N), .ValSeq))) ~> CONT
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> B:Scope
+       0 |-> scope("even_odd_count" |-> C:Val, parent(-1))
+       1 |-> scope("num"  |-> N
+                   "even" |-> E
+                   "odd"  |-> O,
+                   parent(0))
+      =>
+      -1 |-> B
+       0 |-> scope("even_odd_count" |-> C, parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(CONT, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    [priority(40)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..34921fe0dcbcec40b3ae393f550b75696bc03804
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,105 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact translated body of solution.py, named only to keep claims readable.
+  syntax Stmts ::= "evenOddBody" [function, total]
+  rule evenOddBody
+    => Expr(Str("Return the counts of even and odd decimal digits in num."))
+       Assign(Name("num"), Call(Name("abs"), Name("num")))
+       Assign(Name("even"), Int(0))
+       Assign(Name("odd"), Int(0))
+       If(Compare(Name("num"), CmpOp("==", Int(0))),
+          Return(TupleExpr(Int(1), Int(0))) .Stmts,
+          .Stmts)
+       While(Compare(Name("num"), CmpOp(">", Int(0))),
+         Assign(Name("even"),
+                BinOp("-",
+                  BinOp("+", Name("even"), Int(1)),
+                  BinOp("%", Name("num"), Int(2))))
+         Assign(Name("odd"),
+                BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
+         Assign(Name("num"), BinOp("//", Name("num"), Int(10)))
+         .Stmts)
+       Return(TupleExpr(Name("even"), Name("odd")))
+       .Stmts
+
+  syntax Val ::= "evenOddClosure" [function, total]
+  rule evenOddClosure => closureVal("num", evenOddBody, 0)
+
+  // Mathematical counts for a strictly-positive decimal representation.
+  // The zero terminator contributes no digit; the public summaries below give
+  // the integer 0 its single even digit.
+  syntax Int ::= evenPos(Int) [function, total, no-evaluators]
+               | oddPos(Int)  [function, total, no-evaluators]
+               | decEven(Int) [function, total]
+               | decOdd(Int)  [function, total]
+               | quot10(Int)  [function, total]
+
+  rule evenPos(0) => 0
+  rule oddPos(0)  => 0
+  rule evenPos(N) => 0 requires N ==Int 0 [simplification]
+  rule oddPos(N)  => 0 requires N ==Int 0 [simplification]
+
+  // The negative branch is outside loop use but totalizes the symbols.
+  rule evenPos(N) => evenPos(0 -Int N) requires N <Int 0
+  rule oddPos(N)  => oddPos(0 -Int N)  requires N <Int 0
+
+  rule decEven(0) => 1
+  rule decEven(N) => evenPos(N)        requires N >Int 0
+  rule decEven(N) => evenPos(0 -Int N) requires N <Int 0
+
+  rule decOdd(0) => 0
+  rule decOdd(N) => oddPos(N)        requires N >Int 0
+  rule decOdd(N) => oddPos(0 -Int N) requires N <Int 0
+
+  rule quot10(N) => (N -Int pyMod(N, 10)) /Int 10
+
+  // Public zero case after the program's abs call.
+  rule { 1 #Equals decEven(N) } => #Top
+    requires absInt(N) ==Int 0
+    [simplification]
+  rule { 0 #Equals decOdd(N) } => #Top
+    requires absInt(N) ==Int 0
+    [simplification]
+  rule { evenPos(absInt(N)) #Equals decEven(N) } => #Top
+    requires absInt(N) >Int 0
+    [simplification]
+  rule { decEven(N) #Equals evenPos(absInt(N)) } => #Top
+    requires absInt(N) >Int 0
+    [simplification]
+  rule { oddPos(absInt(N)) #Equals decOdd(N) } => #Top
+    requires absInt(N) >Int 0
+    [simplification]
+  rule { decOdd(N) #Equals oddPos(absInt(N)) } => #Top
+    requires absInt(N) >Int 0
+    [simplification]
+
+  // One-step decimal recurrence in the exact matching-logic equality shapes
+  // produced after the loop circularity applies.
+  rule { E +Int evenPos(N)
+         #Equals (E +Int 1 -Int ((N %Int 2 +Int 2) %Int 2))
+                    +Int evenPos((N -Int ((N %Int 10 +Int 10) %Int 10))
+                                    /Int 10) } => #Top
+    requires N >Int 0
+    [simplification, comm]
+  rule { (E +Int 1 -Int ((N %Int 2 +Int 2) %Int 2))
+           +Int evenPos((N -Int ((N %Int 10 +Int 10) %Int 10))
+                           /Int 10)
+         #Equals E +Int evenPos(N) } => #Top
+    requires N >Int 0
+    [simplification]
+  rule { O +Int oddPos(N)
+         #Equals (O +Int ((N %Int 2 +Int 2) %Int 2))
+                    +Int oddPos((N -Int ((N %Int 10 +Int 10) %Int 10))
+                                   /Int 10) } => #Top
+    requires N >Int 0
+    [simplification, comm]
+  rule { (O +Int ((N %Int 2 +Int 2) %Int 2))
+           +Int oddPos((N -Int ((N %Int 10 +Int 10) %Int 10))
+                          /Int 10)
+         #Equals O +Int oddPos(N) } => #Top
+    requires N >Int 0
+    [simplification]
+endmodule

exec
/bin/bash -lc 'set +e
kprove body-mutation-spec.k --definition verification-kompiled --spec-module BODY-MUTATION-SPEC > body-mutation.log 2>&1
status=$?
printf '"'body mutation exit: %s\\n' \""'$status"
sed -n '"'1,70p' body-mutation.log
exit 0" in /workspace
diff --git a/body_mutant.py b/body_mutant.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5d60bdb7d2c4f756597ad4f7942ab9d601730d4
--- /dev/null
+++ b/body_mutant.py
@@ -0,0 +1,15 @@
+def even_odd_count(num):
+    """Return the counts of even and odd decimal digits in num."""
+    num = abs(num)
+    even = 0
+    odd = 0
+
+    if num == 0:
+        return (1, 0)
+
+    while num > 0:
+        even = even + num % 2
+        odd = odd + num % 2
+        num = num // 10
+
+    return (even, odd)
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb49ad5c0e0644afc598e218497e3d8f153617b1
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,23 @@
+def even_odd_count(num):
+    """Return the counts of even and odd decimal digits in num."""
+    num = abs(num)
+    even = 0
+    odd = 0
+
+    if num == 0:
+        return (1, 0)
+
+    while num > 0:
+        even = even + 1 - num % 2
+        odd = odd + num % 2
+        num = num // 10
+
+    return (even, odd)
+
+
+assert even_odd_count(-12) == (1, 1)
+assert even_odd_count(123) == (1, 2)
+assert even_odd_count(0) == (1, 0)
+assert even_odd_count(-24680) == (5, 0)
+assert even_odd_count(13579) == (0, 5)
+assert even_odd_count(1002) == (3, 1)
diff --git a/context-spec.k b/context-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..07e9f8256a41f78593af7e1428fda633f65eda03
--- /dev/null
+++ b/context-spec.k
@@ -0,0 +1,24 @@
+requires "verification-with-lemma.k"
+
+module CONTEXT-SPEC
+  imports VERIFICATION-WITH-LEMMA
+
+  // The loop bridge must preserve an arbitrary caller continuation. Here the
+  // function result is discarded by Expr and a following expression yields 7.
+  claim [caller-continuation]:
+    <k> Expr(Call(Name("even_odd_count"), Int(12))) ~> Int(7)
+        => 7
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope("even_odd_count" |-> evenOddClosure, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..3dec2bc81dd8911e5e332a0e52145750ffda62a8
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+"""Finite independent validation of solution.even_odd_count."""
+
+from solution import even_odd_count
+
+
+def oracle(num):
+    digits = str(abs(num))
+    even = sum(1 for digit in digits if int(digit) % 2 == 0)
+    odd = len(digits) - even
+    return even, odd
+
+
+def main():
+    inputs = list(range(-10000, 10001))
+    inputs += [
+        -(10**50 + 24680),
+        -(10**30),
+        10**30,
+        10**50 + 13579,
+    ]
+    mismatches = []
+    for num in inputs:
+        actual = even_odd_count(num)
+        expected = oracle(num)
+        if actual != expected:
+            mismatches.append((num, actual, expected))
+    print(f"differential cases: {len(inputs)}; mismatches: {len(mismatches)}")
+    if mismatches:
+        raise AssertionError(mismatches[:10])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/make_program_spec.py b/make_program_spec.py
new file mode 100644
index 0000000000000000000000000000000000000000..83ff63ddcdb4da1304436b322bba7cd3069e7866
--- /dev/null
+++ b/make_program_spec.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Generate small K specs whose program term comes from an actual .mpy file."""
+
+import argparse
+import re
+from pathlib import Path
+
+
+def identity_spec(program: str) -> str:
+    return f'''requires "verification.k"
+
+module IDENTITY-SPEC
+  imports VERIFICATION
+
+  claim [translated-program-identity]:
+    <k> #loadAll({program}) => .K </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(.Map => "even_odd_count" |-> evenOddClosure, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+'''
+
+
+def mutant_spec(program: str) -> str:
+    return f'''requires "verification-with-lemma.k"
+
+module BODY-MUTATION-SPEC
+  imports VERIFICATION-WITH-LEMMA
+
+  claim [mutated-body-rejected]:
+    <k> #loadAll({program})
+         ~> Call(Name("even_odd_count"), Int(2))
+         => tuple(vCons(1, vCons(0, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(.Map => ?M:Map, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+'''
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("mode", choices=("identity", "mutant"))
+    parser.add_argument("program")
+    args = parser.parse_args()
+    program = Path(args.program).read_text(encoding="utf-8").strip()
+    # The standalone .mpy parser accepts a blank list argument. When embedded
+    # in a K rule, spell the empty statement-list unit explicitly.
+    program = re.sub(r",\s*\)", ", .Stmts)", program)
+    print(identity_spec(program) if args.mode == "identity" else mutant_spec(program))
+
+
+if __name__ == "__main__":
+    main()
