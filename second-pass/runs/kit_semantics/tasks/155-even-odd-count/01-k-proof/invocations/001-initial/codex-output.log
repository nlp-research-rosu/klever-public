+    [simplification]
+  rule evenPos(N) => evenPos(quot10(N))
+    requires N >Int 0
+     andBool pyMod(pyMod(N, 10), 2) =/=Int 0
+    [simplification]
+  rule oddPos(N) => oddPos(quot10(N))
+    requires N >Int 0
+     andBool pyMod(pyMod(N, 10), 2) ==Int 0
+    [simplification]
+  rule oddPos(N) => 1 +Int oddPos(quot10(N))
+    requires N >Int 0
+     andBool pyMod(pyMod(N, 10), 2) =/=Int 0
