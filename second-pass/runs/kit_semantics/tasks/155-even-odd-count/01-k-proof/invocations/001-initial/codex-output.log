+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope("even_odd_count" |-> evenOddClosure, parent(-1))
+       1 |-> scope("num"  |-> N
+                   "even" |-> E
+                   "odd"  |-> O,
+                   parent(0))
+      =>
+      -1 |-> builtinsScope
