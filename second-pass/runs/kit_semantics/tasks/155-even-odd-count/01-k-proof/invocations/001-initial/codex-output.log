+def even_odd_count(num):
+    """Return the counts of even and odd decimal digits in num."""
+    num = abs(num)
+    even = 0
+    odd = 0
+
+    if num == 0:
+        return (1, 0)
+
+    while num > 0:
+        digit = num % 10
+        if digit % 2 == 0:
+            even = even + 1
+        else:
+            odd = odd + 1
+        num = num // 10
+
+    return (even, odd)

