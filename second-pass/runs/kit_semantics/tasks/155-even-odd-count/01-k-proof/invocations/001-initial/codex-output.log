+
+    if num == 0:
+        return (1, 0)
+
+    while num > 0:
+        even = even + 1 - num % 2
+        odd = odd + num % 2
+        num = num // 10
+
+    return (even, odd)
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
