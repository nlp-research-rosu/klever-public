+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope("even_odd_count" |-> evenOddClosure, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
