Module(
  FuncDef("even_odd_count", Params("num"),
    Expr(
      Str("Return the counts of even and odd decimal digits in num."))
    Assign(Name("num"), Call(Name("abs"), Name("num")))
    Assign(Name("even"), Int(0))
    Assign(Name("odd"), Int(0))
    If(Compare(Name("num"), CmpOp("==", Int(0))),
      Return(TupleExpr(Int(1), Int(0))),
      )
    While(Compare(Name("num"), CmpOp(">", Int(0))),
      Assign(
        Name("even"),
        BinOp(
          "-",
          BinOp("+", Name("even"), Int(1)),
          BinOp("%", Name("num"), Int(2))))
      Assign(
        Name("odd"),
        BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
      Assign(Name("num"), BinOp("//", Name("num"), Int(10))))
    Return(TupleExpr(Name("even"), Name("odd"))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), UnaryOp("-", Int(12))),
      CmpOp("==", TupleExpr(Int(1), Int(1)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(123)),
      CmpOp("==", TupleExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(0)),
      CmpOp("==", TupleExpr(Int(1), Int(0)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), UnaryOp("-", Int(24680))),
      CmpOp("==", TupleExpr(Int(5), Int(0)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(13579)),
      CmpOp("==", TupleExpr(Int(0), Int(5)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(1002)),
      CmpOp("==", TupleExpr(Int(3), Int(1))))))
