    21	print("Harness function AST matches solution.py")
    22	PY
    23	
    24	# Required LLVM execution of the supplied reference semantics.
    25	kompile reference-semantics/semantics.k \
    26	  --backend llvm \
    27	  --main-module MPY-KRUN \
    28	  --syntax-module MPY-SYNTAX \
    29	  --output-definition runtime-kompiled \
    30	  2>&1 | tee llvm-build.log
    31	krun concrete_tests.mpy --definition runtime-kompiled \
