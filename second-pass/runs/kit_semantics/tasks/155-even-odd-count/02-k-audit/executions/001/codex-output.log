    44	  --spec-module LOOP-PROOF \
    45	  2>&1 | tee loop-proof.log
    46	rg -q "^#Top$" loop-proof.log
    47	kprove identity-spec.k \
    48	  --definition loop-verification-kompiled \
    49	  --spec-module IDENTITY-SPEC \
    50	  2>&1 | tee identity-proof.log
    51	rg -q "^#Top$" identity-proof.log
    52	
    53	# Extended definition: use only the exact-context bridge justified above.
    54	kompile --backend haskell verification-with-lemma.k \
