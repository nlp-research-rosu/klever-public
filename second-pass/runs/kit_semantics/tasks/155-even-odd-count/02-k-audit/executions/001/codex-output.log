    87	fi
    88	if [[ "$body_mutation_status" -eq 0 ]]; then
    89	  echo "ERROR: mutated body unexpectedly proved" >&2
    90	  exit 1
    91	fi
    92	rg -q "WarnStuckClaimState" vacuity.log
    93	rg -Fq "decEven ( N ) +Int 1" vacuity.log
