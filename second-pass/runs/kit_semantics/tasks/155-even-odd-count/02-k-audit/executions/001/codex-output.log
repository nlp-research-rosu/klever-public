    18	        ~> (Return(TupleExpr(Name("even"), Name("odd"))) .Stmts)
    19	        ~> #endcall
    20	        => tuple(vCons(E +Int evenPos(N),
    21	                      vCons(O +Int oddPos(N), .ValSeq))) ~> CONT
    22	    </k>
    23	    <env> 1 => 0 </env>
    24	    <scopes>
    25	      -1 |-> B:Scope
    26	       0 |-> scope("even_odd_count" |-> C:Val, parent(-1))
    27	       1 |-> scope("num"  |-> N
    28	                   "even" |-> E
    29	                   "odd"  |-> O,
    30	                   parent(0))
    31	      =>
    32	      -1 |-> B
    33	       0 |-> scope("even_odd_count" |-> C, parent(-1))
    34	    </scopes>
    35	    <scopeLoc> 2 => 1 </scopeLoc>
    36	    <heap> .Map </heap>
    37	    <heapLoc> 0 </heapLoc>
    38	    <stack> ListItem(frame(CONT, 0, 1)) => .List </stack>
    39	    <ret> noRet </ret>
    40	    <exc> NoExc </exc>
    41	    <exit-code> 0 </exit-code>
    42	    requires N >=Int 0
    43	    [priority(40)]
    44	endmodule
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Translate the submitted implementation and all concrete/mutation harnesses.
     5	python3 py2mpy.py solution.py > solution.mpy
