    33	rg -q "NoExc" concrete-krun.log
    34	
    35	# Bridge-free definition: prove the exact loop connection theorem and the
    36	# generated solution.mpy-to-evenOddClosure identity theorem.
    37	kompile --backend haskell verification.k \
