import json, re
from pathlib import Path
root = Path('/workspace')
files = sorted(p for p in root.rglob('*.lean') if 'Base' not in p.parts and '.lake' not in p.parts)
data = {p: p.read_text() for p in files}
params = json.loads((root / 'Base/obligation-map.json').read_text())['trust_parameters']
failed = False
for item in params:
    name = item['name']
    pat = re.compile(r'"'^'"\\s*def\\s+' + re.escape(name) + r'(?=\\s|:|\\()', re.M)
    hits = [(str(p.relative_to(root)), len(pat.findall(text))) for p, text in data.items() if pat.search(text)]
    count = sum(n for _, n in hits)
    print(f'{name}: {count} definition(s) {hits}')
    failed |= count "'!= 1
forbidden = re.compile(r'"'\\b(sorry|admit|unsafe)\\b|"'^'"\\s*(axiom|opaque)\\b', re.M)
for p, text in data.items():
    hits = [(text.count('\\n', 0, m.start()) + 1, m.group(0)) for m in forbidden.finditer(text)]
    if hits:
        print(f'FORBIDDEN {p.relative_to(root)}: {hits}')
        failed = True
print(f'Writable Lean files checked: {[str(p.relative_to(root)) for p in files]}')
print('MECHANICAL_CHECK:', 'FAIL' if failed else 'PASS')
raise SystemExit(1 if failed else 0)
PY
