hits = {str(p.relative_to(root)): [m.group(0) for m in forbidden.finditer(text)] for p, text in data.items() if forbidden.search(text)}
print('binding definition counts:', counts)
print('forbidden-token hits:', hits)
print('FINAL_MECHANICAL_CHECK:', 'PASS' if all(v == 1 for v in counts.values()) and not hits else 'FAIL')
raise SystemExit(0 if all(v == 1 for v in counts.values()) and not hits else 1)
