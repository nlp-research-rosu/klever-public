    15	          Assign(Name("odd"),
    16	                 BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
    17	          Assign(Name("num"), BinOp("//", Name("num"), Int(10)))
    18	          .Stmts)
    19	        ~> (Return(TupleExpr(Name("even"), Name("odd"))) .Stmts)
    20	        ~> #endcall
    21	        => tuple(vCons(?ER:Int, vCons(?OR:Int, .ValSeq))) ~> CONT
    22	    </k>
    23	    <env> 1 => 0 </env>
    24	    <scopes>
    25	      -1 |-> B:Scope
