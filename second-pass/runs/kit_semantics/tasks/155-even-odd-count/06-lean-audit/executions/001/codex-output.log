exec
/bin/bash -lc 'set -o pipefail
audit_project=$(cat /audit-output/evidence/fresh-project-path.txt)
{
  set -x
  cd "$audit_project"
  env LD_PRELOAD=/tmp/audit-work/proc-exe-shim.so lake env lean AuditBridgeExamples.lean
  status=$?
  printf '"'BRIDGE_EXAMPLES_EXIT=%s\\n' \""'$status"
  exit "$status"
} 2>&1 | tee /audit-output/evidence/65-operational-bridge-examples.txt' in /audit-output
