  status=$?
  printf '"'DIRECT_K_TMOD_EXIT=%s\\n' \""'$status"
  rg -n "Lbl'"'UndsPerc'Int'Unds'.*hook.*INT.tmod\" \""'$audit_def/definition.kore"
  exit "$status"
} 2>&1 | tee /audit-output/evidence/69-direct-k-tmod-evaluation.txt' in /audit-output
