     7	  syntax Stmts ::= "evenOddBody" [function, total]
     8	  rule evenOddBody
     9	    => Expr(Str("Return the counts of even and odd decimal digits in num."))
    10	       Assign(Name("num"), Call(Name("abs"), Name("num")))
    11	       Assign(Name("even"), Int(0))
    12	       Assign(Name("odd"), Int(0))
    13	       If(Compare(Name("num"), CmpOp("==", Int(0))),
    14	          Return(TupleExpr(Int(1), Int(0))) .Stmts,
    15	          .Stmts)
    16	       While(Compare(Name("num"), CmpOp(">", Int(0))),
    17	         Assign(Name("even"),
    18	                BinOp("-",
    19	                  BinOp("+", Name("even"), Int(1)),
    20	                  BinOp("%", Name("num"), Int(2))))
    21	         Assign(Name("odd"),
    22	                BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
    23	         Assign(Name("num"), BinOp("//", Name("num"), Int(10)))
    24	         .Stmts)
    25	       Return(TupleExpr(Name("even"), Name("odd")))
    26	       .Stmts
    27	
    28	  syntax Val ::= "evenOddClosure" [function, total]
    29	  rule evenOddClosure => closureVal("num", evenOddBody, 0)
    30	
    31	  // Mathematical counts for a strictly-positive decimal representation.
    32	  // The zero terminator contributes no digit; the public summaries below give
    33	  // the integer 0 its single even digit.
    34	  syntax Int ::= evenPos(Int) [function, total, no-evaluators]
    35	               | oddPos(Int)  [function, total, no-evaluators]
    36	               | decEven(Int) [function, total]
    37	               | decOdd(Int)  [function, total]
    38	
    39	  rule evenPos(0) => 0
    40	  rule oddPos(0)  => 0
