+import Proof
+
+open Klean155EvenOddCount
+
+def badFalse (_ _ : SortInt) : SortBool := false
+def badInt (_ : SortInt) : SortInt := 0
+
+-- With dishonest always-false guards, all ten generated implications are
+-- vacuous.  This deliberately demonstrates why the operational bridge must
+-- be audited independently of theorem construction.
+theorem vacuousCounterfactual :
+    Lemmas.targetStatement Int.sub badFalse badFalse Int.emod Int.add Int.tdiv
+      badInt badInt badInt badInt badInt := by
+  unfold Lemmas.targetStatement
+  simp [badFalse]
+
+-- Concrete witnesses reject convenient constant, identity, and wrong
+-- arithmetic replacements for the candidate's honest bindings.
+def badAbsIdentity (n : SortInt) : SortInt := n
+def badSummaryConstant (_ : SortInt) : SortInt := 0
+def badModAsDividend (a _ : SortInt) : SortInt := a
+def badDivIdentity (a _ : SortInt) : SortInt := a
+
+#eval ("badAbsIdentity(-101)", badAbsIdentity (-101))
+#eval ("honestAbs(-101)", Proof.«absInt(_)_INT-COMMON_Int_Int» (-101))
+#eval ("badSummaryConstant(24680)", badSummaryConstant 24680)
+#eval ("honestEven(24680)", Proof.«evenPos(_)_VERIFICATION_Int_Int» 24680)
+#eval ("badModAsDividend(-11,10)", badModAsDividend (-11) 10)
+#eval ("honestEmod(-11,10)", Proof.«_%Int_» (-11) 10)
+#eval ("badDivIdentity(123,10)", badDivIdentity 123 10)
+#eval ("honestTdiv(123,10)", Proof.«_/Int_» 123 10)
+
+example : badAbsIdentity (-101) ≠
+    Proof.«absInt(_)_INT-COMMON_Int_Int» (-101) := by native_decide
+example : badSummaryConstant 24680 ≠
+    Proof.«evenPos(_)_VERIFICATION_Int_Int» 24680 := by native_decide
+example : badModAsDividend (-11) 10 ≠ Proof.«_%Int_» (-11) 10 := by
+  native_decide
+example : badDivIdentity 123 10 ≠ Proof.«_/Int_» 123 10 := by
+  native_decide
diff --git a//tmp/audit-work/proc-exe-shim.c b//tmp/audit-work/proc-exe-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..ab3b90c854222d0d0ebf6ecf5f6f1d5cff41d710
--- /dev/null
+++ b//tmp/audit-work/proc-exe-shim.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_numeric_proc_exe(const char *path) {
+    const char *cursor;
+
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor = path + 6;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *restrict path, char *restrict buffer, size_t size) {
+    const char *resolved =
+        is_numeric_proc_exe(path) ? "/proc/self/exe" : path;
+    return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}
