SOLUTION
     1	def even_odd_count(num):
     2	    """Return the counts of even and odd decimal digits in num."""
     3	    num = abs(num)
     4	    even = 0
     5	    odd = 0
     6	
     7	    if num == 0:
     8	        return (1, 0)
     9	
    10	    while num > 0:
    11	        even = even + 1 - num % 2
    12	        odd = odd + num % 2
    13	        num = num // 10
    14	
    15	    return (even, odd)

