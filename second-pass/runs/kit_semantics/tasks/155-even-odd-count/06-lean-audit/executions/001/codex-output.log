exec
/bin/bash -lc 'set -o pipefail
{
  set -x
  audit_def=/tmp/audit-work/int-audit-kompiled
  kompile /tmp/audit-work/int-audit.k --backend haskell --main-module INT-AUDIT --syntax-module INT-AUDIT --output-definition "$audit_def"
