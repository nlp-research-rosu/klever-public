codex
The failure is now isolated: this sandbox exposes `/proc/self/exe` but not `/proc/<getpid()>/exe`; Lean 4.22 hard-codes the latter, so its otherwise intact binary fails before elaboration. I’m applying a narrowly scoped, auditable preload shim in `/tmp/audit-work` that redirects only `/proc/<digits>/exe` reads to `/proc/self/exe`. The pinned Lean binaries and all candidate/reference files remain byte-for-byte unchanged.
apply patch
patch: completed
/tmp/audit-work/proc-exe-shim.c
diff --git a//tmp/audit-work/proc-exe-shim.c b//tmp/audit-work/proc-exe-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..ab3b90c854222d0d0ebf6ecf5f6f1d5cff41d710
--- /dev/null
+++ b//tmp/audit-work/proc-exe-shim.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_numeric_proc_exe(const char *path) {
+    const char *cursor;
+
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor = path + 6;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *restrict path, char *restrict buffer, size_t size) {
+    const char *resolved =
+        is_numeric_proc_exe(path) ? "/proc/self/exe" : path;
+    return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}

