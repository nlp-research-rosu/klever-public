$ LD_PRELOAD=/tmp/audit-work/proc_exe_compat.so python3 - <<'PY'
import ast, hashlib, os, subprocess
p=subprocess.run(['lake','env','lean','DifferentialAudit.lean'],cwd='/tmp/audit-work/proof-audit-155',env=os.environ.copy(),text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
print('lean_exit',p.returncode)
print('lean_output_sha256',hashlib.sha256(p.stdout.encode()).hexdigest())
values=ast.literal_eval(p.stdout.strip())
print('candidate_rows',len(values))
print('first_row',values[0])
print('zero_row',values[500])
print('last_row',values[-1])
mismatches=[]
for n,even,odd in values:
    digits=str(abs(n))
    expected_even=sum((ord(c)-48)%2==0 for c in digits)
    expected_odd=sum((ord(c)-48)%2==1 for c in digits)
    if (even,odd)!=(expected_even,expected_odd):
        mismatches.append((n,even,odd,expected_even,expected_odd))
print('oracle','independent decimal-string parity count over abs(n), with str(0) = "0"')
print('domain','all integers -500 through 500 inclusive')
print('mismatch_count',len(mismatches))
print('mismatches',mismatches[:20])
raise SystemExit(0 if p.returncode==0 and not mismatches else 1)
