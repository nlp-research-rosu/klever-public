$ PYTHONPATH=/reference python3 - <<'PY'
import json
from pathlib import Path
from tools.k_rule_inventory import inventory_verification
inv=inventory_verification(Path('/reference/k-proof'))
disc=json.loads(Path('/reference/lemma-discovery.json').read_text())
print(json.dumps(inv,indent=2,sort_keys=True))
print('--- BIJECTION ---')
inv_ids=[r['source_rule_id'] for r in inv['rules']]
disc_ids=[r['source_rule_id'] for r in disc['rules']]
print('inventory_count',len(inv_ids))
print('discovery_count',len(disc_ids))
print('inventory_unique',len(set(inv_ids)))
print('discovery_unique',len(set(disc_ids)))
print('ordered_ids_equal',inv_ids==disc_ids)
print('omitted_from_discovery',sorted(set(inv_ids)-set(disc_ids)))
print('extra_in_discovery',sorted(set(disc_ids)-set(inv_ids)))
print('inventory_sha256_observed',inv['inventory_sha256'])
print('inventory_sha256_discovery',disc['inventory_sha256'])
print('inventory_hash_equal',inv['inventory_sha256']==disc['inventory_sha256'])
for i,(src,claim) in enumerate(zip(inv['rules'],disc['rules']),1):
    print(i,src['source_rule_id'],src['module'],f"{src['start_line']}-{src['end_line']}",src['normalized_sha256'],src['attributes'],claim['classification'])
