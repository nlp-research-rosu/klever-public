      badInt1 badInt1 badInt1 badInt1 badInt1 := by
  simp [Klean155EvenOddCount.Lemmas.targetStatement, badBool2]

example : badBool2 1 0 = false := rfl
example : Proof.«_>Int_» 1 0 = true := by native_decide
example : badInt1 (-204) = 0 := rfl
example : Proof.«evenPos(_)_VERIFICATION_Int_Int» (-204) = 3 := by native_decide

