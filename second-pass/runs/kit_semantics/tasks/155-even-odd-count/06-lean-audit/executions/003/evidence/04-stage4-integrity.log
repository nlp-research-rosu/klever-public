$ PYTHONPATH=/reference python3 - <<'PY'
import hashlib,json
from pathlib import Path
from tools import pipeline_contract,klean_export
A=json.loads(Path('/audit-input.json').read_text())['resolution']
H=A['hashes']
paths={
 'k_workspace_sha256':Path('/reference/k-proof'),
 'k_audit_sha256':Path('/reference/k-audit'),
 'klean_generation_sha256':Path('/reference/klean-generation'),
 'lean_workspace_sha256':Path('/candidate'),
 'generation_producer_sources_sha256':Path('/reference/generation-tools'),
}
print('AUDIT_INPUT_TREE_HASHES')
for k,p in paths.items():
 obs=pipeline_contract.sha256_tree(p)
 print(k,'expected',H[k],'observed',obs,'equal',obs==H[k])
for k,p in [('stage1_export_sha256',Path('/reference/k-proof')),('generated_tree_sha256',Path('/reference/klean-generation/generated'))]:
 obs=klean_export.tree_digest(p)
 print(k,'expected',H[k],'observed',obs,'equal',obs==H[k])
obs=hashlib.sha256(Path('/reference/lemma-discovery.json').read_bytes()).hexdigest()
print('discovery_manifest_sha256','expected',H['discovery_manifest_sha256'],'observed',obs,'equal',obs==H['discovery_manifest_sha256'])
print('lean_invocation_sha256','expected',H['lean_invocation_sha256'],'observed','NOT_MOUNTED_AS_SEPARATE_INPUT')
G=Path('/reference/klean-generation')
gm=json.loads((G/'generator-manifest.json').read_text())
im=json.loads((G/'input-manifest.json').read_text())
er=json.loads((G/'export-result.json').read_text())
om=json.loads((G/'generated/obligation-map.json').read_text())
print('\nSIDECAR_HASH_BINDINGS')
checks={
 'obligation_map_sha256':(gm['obligation_map_sha256'],hashlib.sha256((G/'generated/obligation-map.json').read_bytes()).hexdigest()),
 'generated_tree_sha256':(gm['generated_tree_sha256'],klean_export.tree_digest(G/'generated')),
 'trust_inventory_sha256':(er['trust_inventory_sha256'],hashlib.sha256((G/'trust-inventory.json').read_bytes()).hexdigest()),
 'inventory_sha256_generator_input':(gm['provenance']['inventory_sha256'],im['inventory_sha256']),
 'frozen_input_export_input':(er['frozen_input_sha256'],im['frozen_input_sha256']),
}
for k,(e,o) in checks.items(): print(k,'expected',e,'observed',o,'equal',e==o)
sources=om['source_rules']; obligations=om['obligations']
print('\nOBLIGATION_BIJECTION')
print('source_count',len(sources),'obligation_count',len(obligations),'manifest_count',gm['obligation_count'])
print('ordered_ids_equal',[x['source_rule_id'] for x in sources]==[x['source_rule_id'] for x in obligations])
print('source_ids_unique',len({x['source_rule_id'] for x in sources})==len(sources))
print('obligation_ids_unique',len({x['source_rule_id'] for x in obligations})==len(obligations))
for i,(s,o) in enumerate(zip(sources,obligations),1):
 print(i,s['source_rule_id'],'span_equal',{'start_line':s['start_line'],'end_line':s['end_line']}==o['source_span'],'normalized_equal',s['normalized_sha256']==o['normalized_sha256'],'lean_hash_equal',hashlib.sha256(o['lean_conjunct'].encode()).hexdigest()==o['lean_conjunct_sha256'])
expected=klean_export.expected_target_definition(om)
observed=klean_export.target_statement(G/'generated')
print('\nTARGET')
print('expected_definition_sha256',klean_export.sha256_text(expected))
print('observed_declaration',observed['declaration'])
print('observed_file',observed['file'])
print('observed_statement',observed['statement'])
print('observed_statement_sha256',observed['statement_sha256'])
print('observed_definition_sha256',observed['definition_sha256'])
print('generator_target_equal',observed==gm['target'])
print('audit_target_equal',observed==A['target'])
print('definition_exact',observed['definition_sha256']==klean_export.sha256_text(expected))
print('parameter_count',len(observed['parameters']))
