import ast, os, subprocess
p=subprocess.run(['lake','env','lean','DifferentialAudit.lean'],cwd='/tmp/audit-work/proof-audit-155',env=os.environ.copy(),text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
print('lean_exit',p.returncode)
print('lean_output_sha256',__import__('hashlib').sha256(p.stdout.encode()).hexdigest())
values=ast.literal_eval(p.stdout.strip())
print('candidate_rows',len(values))
print('first_row',values[0])
print('zero_row',values[500])
print('last_row',values[-1])
mismatches=[]
for n,even,odd in values:
    digits=str(abs(n))
    expected_even=sum((ord(c)-48)%2==0 for c in digits)
    expected_odd=sum((ord(c)-48)%2==1 for c in digits)
    if (even,odd)"'!=(expected_even,expected_odd):
        mismatches.append((n,even,odd,expected_even,expected_odd))
print('"'oracle','independent decimal-string parity count over abs(n), with str(0) = \"0\"')
print('domain','all integers -500 through 500 inclusive')
print('mismatch_count',len(mismatches))
print('mismatches',mismatches[:20])
raise SystemExit(0 if p.returncode==0 and not mismatches else 1)
PY" in /audit-output
diff --git a//tmp/audit-work/proc_exe_compat.c b//tmp/audit-work/proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..bdd345546f23616f3f200d85aaf2abeb3eb8f53e
--- /dev/null
+++ b//tmp/audit-work/proc_exe_compat.c
@@ -0,0 +1,22 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+        const char *suffix = strrchr(path, '/');
+        if (suffix != NULL && strcmp(suffix, "/exe") == 0) {
+            return real_readlink("/proc/self/exe", buffer, size);
+        }
+    }
+    return real_readlink(path, buffer, size);
+}
