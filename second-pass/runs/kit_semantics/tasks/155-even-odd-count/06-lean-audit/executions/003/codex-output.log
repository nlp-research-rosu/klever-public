     6	/- Decimal-digit counters used to implement the four VERIFICATION summaries.
     7	   The zero terminator contributes no digit; `decEven` supplies the source
     8	   program's special result for the integer zero. -/
     9	private def evenDigitCount (n : Nat) : Int :=
    10	  if h : n = 0 then 0
    11	  else 1 - Int.ofNat (n % 2) + evenDigitCount (n / 10)
    12	termination_by n
    13	decreasing_by
    14	  exact Nat.div_lt_self (Nat.pos_of_ne_zero h) (by omega)
    15	
    16	private def oddDigitCount (n : Nat) : Int :=
    17	  if n = 0 then 0
    18	  else Int.ofNat (n % 2) + oddDigitCount (n / 10)
    19	termination_by n
    20	decreasing_by
    21	  apply Nat.div_lt_self <;> omega
    22	
    23	private theorem evenDigitCount_step (n : Nat) (h : 0 < n) :
    24	    evenDigitCount n =
    25	      1 - Int.ofNat (n % 2) + evenDigitCount (n / 10) := by
    26	  rw [evenDigitCount]
    27	  simp [Nat.ne_of_gt h]
    28	
    29	private theorem oddDigitCount_step (n : Nat) (h : 0 < n) :
    30	    oddDigitCount n = Int.ofNat (n % 2) + oddDigitCount (n / 10) := by
    31	  rw [oddDigitCount]
    32	  simp [Nat.ne_of_gt h]
    33	
    34	private def evenMagnitude (n : Int) : Int := evenDigitCount n.natAbs
    35	private def oddMagnitude (n : Int) : Int := oddDigitCount n.natAbs
