    37	/- On positive integers, K's normalized remainder expressions are ordinary
    38	   decimal remainders and K's truncated quotient removes the last digit. -/
    39	private theorem positive_normalizations (n : Int) (h : n > 0) :
    40	    Int.tmod (Int.tmod n 2 + 2) 2 = Int.ofNat (n.natAbs % 2) ∧
    41	    Int.tdiv (n - Int.tmod (Int.tmod n 10 + 10) 10) 10 =
    42	      Int.ofNat (n.natAbs / 10) := by
    43	  cases n with
    44	  | ofNat m =>
    45	      constructor
    46	      · change Int.ofNat ((m % 2 + 2) % 2) = Int.ofNat (m % 2)
    47	        simp
    48	      · have hlast :
    49	            Int.tmod (Int.tmod (Int.ofNat m) 10 + 10) 10 =
    50	              Int.ofNat (m % 10) := by
    51	          change Int.ofNat ((m % 10 + 10) % 10) = Int.ofNat (m % 10)
    52	          simp
    53	        rw [hlast]
    54	        have hle : m % 10 ≤ m := Nat.mod_le m 10
    55	        have hsub :
    56	            Int.ofNat m - Int.ofNat (m % 10) =
    57	              Int.ofNat (m - m % 10) := (Int.ofNat_sub hle).symm
    58	        rw [hsub]
    59	        change Int.ofNat ((m - m % 10) / 10) = Int.ofNat (m / 10)
    60	        have hdecomp := Nat.mod_add_div' m 10
    61	        have hsubnat : m - m % 10 = m / 10 * 10 := by omega
    62	        rw [hsubnat]
    63	        simp
    64	  | negSucc m => omega
    65	
    66	private theorem evenMagnitude_step (n : Int) (h : n > 0) :
    67	    evenMagnitude n =
    68	      1 - Int.tmod (Int.tmod n 2 + 2) 2 +
    69	        evenMagnitude
    70	          (Int.tdiv (n - Int.tmod (Int.tmod n 10 + 10) 10) 10) := by
    71	  have hn : 0 < n.natAbs := Int.natAbs_pos.mpr (by omega)
    72	  rw [evenMagnitude, evenDigitCount_step n.natAbs hn]
    73	  obtain ⟨hparity, hquotient⟩ := positive_normalizations n h
    74	  rw [hparity, hquotient]
    75	  rw [evenMagnitude]
    76	  rfl
    77	
    78	private theorem oddMagnitude_step (n : Int) (h : n > 0) :
    79	    oddMagnitude n =
    80	      Int.tmod (Int.tmod n 2 + 2) 2 +
    81	        oddMagnitude
    82	          (Int.tdiv (n - Int.tmod (Int.tmod n 10 + 10) 10) 10) := by
    83	  have hn : 0 < n.natAbs := Int.natAbs_pos.mpr (by omega)
    84	  rw [oddMagnitude, oddDigitCount_step n.natAbs hn]
    85	  obtain ⟨hparity, hquotient⟩ := positive_normalizations n h
    86	  rw [hparity, hquotient]
    87	  rw [oddMagnitude]
    88	  rfl
