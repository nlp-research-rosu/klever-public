@@ -0,0 +1,23 @@
+import Proof
+
+namespace CounterfactualAudit
+
+def badInt2 (_ _ : SortInt) : SortInt := 0
+def badBool2 (_ _ : SortInt) : SortBool := false
+def badInt1 (_ : SortInt) : SortInt := 0
+
+-- This deliberately degenerate interpretation makes every generated guard
+-- false.  It demonstrates why the operational bindings require an audit
+-- independent of a successful proof of the parameterized target.
+example :
+    Klean155EvenOddCount.Lemmas.targetStatement
+      badInt2 badBool2 badBool2 badInt2 badInt2 badInt2
+      badInt1 badInt1 badInt1 badInt1 badInt1 := by
+  simp [Klean155EvenOddCount.Lemmas.targetStatement, badBool2]
+
+example : badBool2 1 0 = false := rfl
+example : Proof.«_>Int_» 1 0 = true := by native_decide
+example : badInt1 (-204) = 0 := rfl
+example : Proof.«evenPos(_)_VERIFICATION_Int_Int» (-204) = 3 := by native_decide
+
+end CounterfactualAudit
