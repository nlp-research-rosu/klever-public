+$ sha256sum /reference/generation-tools/klean_export.py /reference/generation-tools/klean.py /reference/generation-tools/source-manifest.json
+PYTHONPATH=/reference python3 - <<'PY'
+import json
+from pathlib import Path
+from tools import pipeline_contract, klean_export, stage6_resolution_contract
+ai=json.loads(Path('/audit-input.json').read_text())
+res,digest=stage6_resolution_contract.verify_audit_input(ai)
+gm=json.loads(Path('/reference/klean-generation/generator-manifest.json').read_text())
+sm=json.loads(Path('/reference/generation-tools/source-manifest.json').read_text())
+print('verified_audit_input_digest',digest)
+print('recorded_resolved_input_sha256',ai['resolved_input_sha256'])
+print('audit_mode',res['mode'])
+print('audit_generation_producer_sources',res['generation_producer_sources'])
+print('audit_generation_producer_sources_basename',Path(res['generation_producer_sources']).name)
+print('audit_generation_producer_sources_sha256',res['hashes']['generation_producer_sources_sha256'])
+print('observed_pipeline_tree_sha256',pipeline_contract.sha256_tree(Path('/reference/generation-tools')))
+print('generator_manifest_image_id',gm['provenance']['generator_image_id'])
+print('source_manifest_image_id',sm['generator_image_id'])
+print('source_manifest_files',sm['files'])
+print('generator_manifest_exporter_sha256',gm['exporter_sha256'])
+print('generator_manifest_klean_py_sha256',gm['klean_py_sha256'])
+PY
