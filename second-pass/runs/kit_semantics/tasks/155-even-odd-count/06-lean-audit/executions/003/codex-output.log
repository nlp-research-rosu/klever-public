new file mode 100644
index 0000000000000000000000000000000000000000..27d0fee14a4760cef4d7e61099716f89068732d3
--- /dev/null
+++ b/evidence/10-counterfactual.log
@@ -0,0 +1,26 @@
+$ sed -n '1,240p' CounterfactualAudit.lean
+LD_PRELOAD=/tmp/audit-work/proc_exe_compat.so lake env lean CounterfactualAudit.lean
+import Proof
+
+namespace CounterfactualAudit
+
+def badInt2 (_ _ : SortInt) : SortInt := 0
+def badBool2 (_ _ : SortInt) : SortBool := false
+def badInt1 (_ : SortInt) : SortInt := 0
+
+-- This deliberately degenerate interpretation makes every generated guard
+-- false.  It demonstrates why the operational bindings require an audit
+-- independent of a successful proof of the parameterized target.
+example :
+    Klean155EvenOddCount.Lemmas.targetStatement
+      badInt2 badBool2 badBool2 badInt2 badInt2 badInt2
+      badInt1 badInt1 badInt1 badInt1 badInt1 := by
+  simp [Klean155EvenOddCount.Lemmas.targetStatement, badBool2]
+
+example : badBool2 1 0 = false := rfl
+example : Proof.«_>Int_» 1 0 = true := by native_decide
+example : badInt1 (-204) = 0 := rfl
+example : Proof.«evenPos(_)_VERIFICATION_Int_Int» (-204) = 3 := by native_decide
+
+end CounterfactualAudit
+EXIT: 0
diff --git a/evidence/11-differential.log b/evidence/11-differential.log
new file mode 100644
index 0000000000000000000000000000000000000000..4c7a719d0e12039c77bc8d8de1fc7430f5abbc95
--- /dev/null
+++ b/evidence/11-differential.log
@@ -0,0 +1,43 @@
+DifferentialAudit.lean:
+import Proof
+
+#eval (List.range 1001).map fun i =>
+  let n : Int := Int.ofNat i - 500
+  (n,
+   Proof.«decEven(_)_VERIFICATION_Int_Int» n,
+   Proof.«decOdd(_)_VERIFICATION_Int_Int» n)
+
+$ LD_PRELOAD=/tmp/audit-work/proc_exe_compat.so python3 - <<'PY'
+import ast, hashlib, os, subprocess
+p=subprocess.run(['lake','env','lean','DifferentialAudit.lean'],cwd='/tmp/audit-work/proof-audit-155',env=os.environ.copy(),text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+print('lean_exit',p.returncode)
+print('lean_output_sha256',hashlib.sha256(p.stdout.encode()).hexdigest())
+values=ast.literal_eval(p.stdout.strip())
+print('candidate_rows',len(values))
+print('first_row',values[0])
+print('zero_row',values[500])
+print('last_row',values[-1])
+mismatches=[]
+for n,even,odd in values:
+    digits=str(abs(n))
+    expected_even=sum((ord(c)-48)%2==0 for c in digits)
+    expected_odd=sum((ord(c)-48)%2==1 for c in digits)
+    if (even,odd)!=(expected_even,expected_odd):
+        mismatches.append((n,even,odd,expected_even,expected_odd))
+print('oracle','independent decimal-string parity count over abs(n), with str(0) = "0"')
+print('domain','all integers -500 through 500 inclusive')
+print('mismatch_count',len(mismatches))
+print('mismatches',mismatches[:20])
+raise SystemExit(0 if p.returncode==0 and not mismatches else 1)
+PY
+lean_exit 0
+lean_output_sha256 c47fbacabd1eb09101f912fb67b4ea6157590b90f8cd42d2cdb74d53e68d4d8e
+candidate_rows 1001
+first_row (-500, 2, 1)
+zero_row (0, 1, 0)
+last_row (500, 2, 1)
+oracle independent decimal-string parity count over abs(n), with str(0) = "0"
+domain all integers -500 through 500 inclusive
+mismatch_count 0
+mismatches []
+EXIT: 0
