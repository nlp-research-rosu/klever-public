    if let some cc ← IO.getEnv "LEAN_CC" then
      return withCustomCc i cc
    else
      let cc := leanCcExe sysroot
      if (← cc.pathExists) then
        return withInternalCc i cc
      else if let some cc ← IO.getEnv "CC" then
        return withCustomCc i cc
      else
        return withCustomCc i "cc"
