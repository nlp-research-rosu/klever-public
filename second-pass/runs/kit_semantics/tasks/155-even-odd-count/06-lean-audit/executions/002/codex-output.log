import Klean155EvenOddCount.Lemmas
import Std.Tactic

namespace Proof

/- Decimal-digit counts for a nonnegative magnitude. The recursive argument
   is divided by ten, exactly as in the frozen Python loop. -/
private def evenDigitCount (n : Nat) : Int :=
  if _h : n = 0 then
    0
  else
    1 - Int.ofNat (n % 2) + evenDigitCount (n / 10)
termination_by n
decreasing_by omega

private def oddDigitCount (n : Nat) : Int :=
  if _h : n = 0 then
    0
  else
    Int.ofNat (n % 2) + oddDigitCount (n / 10)
termination_by n
decreasing_by omega

private theorem evenDigitCount_step (n : Nat) (h : 0 < n) :
    evenDigitCount n =
      1 - Int.ofNat (n % 2) + evenDigitCount (n / 10) := by
  rw [evenDigitCount]
  simp [Nat.ne_of_gt h]

private theorem oddDigitCount_step (n : Nat) (h : 0 < n) :
    oddDigitCount n = Int.ofNat (n % 2) + oddDigitCount (n / 10) := by
  rw [oddDigitCount]
  simp [Nat.ne_of_gt h]

private def evenMagnitude (n : Int) : Int := evenDigitCount n.natAbs
private def oddMagnitude (n : Int) : Int := oddDigitCount n.natAbs

/- K's guarded terms normalize the already-nonnegative remainders once more.
   On a positive input they are the ordinary parity and decimal quotient. -/
private theorem positive_normalizations (N : Int) (h : 0 < N) :
    ((N % 2 + 2) % 2 = N % 2) ∧
    ((N % 10 + 10) % 10 = N % 10) ∧
    Int.tdiv (N - ((N % 10 + 10) % 10)) 10 = N / 10 := by
  have hn : 0 ≤ N := by omega
  constructor
  · omega
  constructor
  · omega
  rw [Int.tdiv_eq_ediv_of_nonneg]
  · omega
  · have hr : 0 ≤ N % 10 := Int.emod_nonneg N (by omega)
    omega

private theorem evenMagnitude_step (N : Int) (h : 0 < N) :
    evenMagnitude N =
      1 - ((N % 2 + 2) % 2) +
        evenMagnitude
          (Int.tdiv (N - ((N % 10 + 10) % 10)) 10) := by
  rcases positive_normalizations N h with ⟨hp, _hm, hq⟩
  rw [hp, hq]
  unfold evenMagnitude
  have hN : 0 ≤ N := by omega
  have hqAbs : (N / 10).natAbs = N.natAbs / 10 := by
    simpa using Int.natAbs_ediv_of_nonneg (b := 10) hN
  have hpNat : (N % 2).natAbs = N.natAbs % 2 := by
    simpa using Int.natAbs_emod_of_nonneg hN 2
  have hpNonneg : 0 ≤ N % 2 := Int.emod_nonneg N (by omega)
  have hpCast : Int.ofNat (N.natAbs % 2) = N % 2 := by
    rw [← hpNat]
    exact Int.natAbs_of_nonneg hpNonneg
  rw [hqAbs]
  rw [evenDigitCount_step N.natAbs (by omega)]
  rw [hpCast]

private theorem oddMagnitude_step (N : Int) (h : 0 < N) :
    oddMagnitude N =
      ((N % 2 + 2) % 2) +
        oddMagnitude
          (Int.tdiv (N - ((N % 10 + 10) % 10)) 10) := by
  rcases positive_normalizations N h with ⟨hp, _hm, hq⟩
  rw [hp, hq]
  unfold oddMagnitude
  have hN : 0 ≤ N := by omega
  have hqAbs : (N / 10).natAbs = N.natAbs / 10 := by
    simpa using Int.natAbs_ediv_of_nonneg (b := 10) hN
  have hpNat : (N % 2).natAbs = N.natAbs % 2 := by
    simpa using Int.natAbs_emod_of_nonneg hN 2
  have hpNonneg : 0 ≤ N % 2 := Int.emod_nonneg N (by omega)
  have hpCast : Int.ofNat (N.natAbs % 2) = N % 2 := by
    rw [← hpNat]
    exact Int.natAbs_of_nonneg hpNonneg
  rw [hqAbs]
  rw [oddDigitCount_step N.natAbs (by omega)]
  rw [hpCast]

