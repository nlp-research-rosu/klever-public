     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The exact translated body of solution.py, named only to keep claims readable.
     7	  syntax Stmts ::= "evenOddBody" [function, total]
     8	  rule evenOddBody
     9	    => Expr(Str("Return the counts of even and odd decimal digits in num."))
    10	       Assign(Name("num"), Call(Name("abs"), Name("num")))
    11	       Assign(Name("even"), Int(0))
    12	       Assign(Name("odd"), Int(0))
    13	       If(Compare(Name("num"), CmpOp("==", Int(0))),
    14	          Return(TupleExpr(Int(1), Int(0))) .Stmts,
    15	          .Stmts)
    16	       While(Compare(Name("num"), CmpOp(">", Int(0))),
    17	         Assign(Name("even"),
    18	                BinOp("-",
    19	                  BinOp("+", Name("even"), Int(1)),
    20	                  BinOp("%", Name("num"), Int(2))))
    21	         Assign(Name("odd"),
    22	                BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
    23	         Assign(Name("num"), BinOp("//", Name("num"), Int(10)))
    24	         .Stmts)
    25	       Return(TupleExpr(Name("even"), Name("odd")))
    26	       .Stmts
    27	
    28	  syntax Val ::= "evenOddClosure" [function, total]
    29	  rule evenOddClosure => closureVal("num", evenOddBody, 0)
    30	
    31	  // Mathematical counts for a strictly-positive decimal representation.
    32	  // The zero terminator contributes no digit; the public summaries below give
    33	  // the integer 0 its single even digit.
    34	  syntax Int ::= evenPos(Int) [function, total, no-evaluators]
    35	               | oddPos(Int)  [function, total, no-evaluators]
    36	               | decEven(Int) [function, total]
    37	               | decOdd(Int)  [function, total]
    38	
    39	  rule evenPos(0) => 0
    40	  rule oddPos(0)  => 0
    41	  rule evenPos(N) => 0 requires N ==Int 0 [simplification]
    42	  rule oddPos(N)  => 0 requires N ==Int 0 [simplification]
    43	
    44	  // The negative branch is outside loop use but totalizes the symbols.
    45	  rule evenPos(N) => evenPos(0 -Int N) requires N <Int 0
    46	  rule oddPos(N)  => oddPos(0 -Int N)  requires N <Int 0
    47	
    48	  rule decEven(0) => 1
    49	  rule decEven(N) => evenPos(N)        requires N >Int 0
    50	  rule decEven(N) => evenPos(0 -Int N) requires N <Int 0
    51	
    52	  rule decOdd(0) => 0
    53	  rule decOdd(N) => oddPos(N)        requires N >Int 0
    54	  rule decOdd(N) => oddPos(0 -Int N) requires N <Int 0
    55	
    56	  // Public zero case after the program's abs call.
    57	  rule { 1 #Equals decEven(N) } => #Top
    58	    requires absInt(N) ==Int 0
    59	    [simplification]
    60	  rule { 0 #Equals decOdd(N) } => #Top
    61	    requires absInt(N) ==Int 0
    62	    [simplification]
    63	  rule { evenPos(absInt(N)) #Equals decEven(N) } => #Top
    64	    requires absInt(N) >Int 0
    65	    [simplification]
    66	  rule { decEven(N) #Equals evenPos(absInt(N)) } => #Top
    67	    requires absInt(N) >Int 0
    68	    [simplification]
    69	  rule { oddPos(absInt(N)) #Equals decOdd(N) } => #Top
    70	    requires absInt(N) >Int 0
    71	    [simplification]
    72	  rule { decOdd(N) #Equals oddPos(absInt(N)) } => #Top
    73	    requires absInt(N) >Int 0
    74	    [simplification]
    75	
    76	  // One-step decimal recurrence in the exact matching-logic equality shapes
    77	  // produced after the loop circularity applies.
    78	  rule { E +Int evenPos(N)
    79	         #Equals (E +Int 1 -Int ((N %Int 2 +Int 2) %Int 2))
    80	                    +Int evenPos((N -Int ((N %Int 10 +Int 10) %Int 10))
    81	                                    /Int 10) } => #Top
    82	    requires N >Int 0
    83	    [simplification]
    84	  rule { (E +Int 1 -Int ((N %Int 2 +Int 2) %Int 2))
    85	           +Int evenPos((N -Int ((N %Int 10 +Int 10) %Int 10))
    86	                           /Int 10)
    87	         #Equals E +Int evenPos(N) } => #Top
    88	    requires N >Int 0
    89	    [simplification]
    90	  rule { O +Int oddPos(N)
    91	         #Equals (O +Int ((N %Int 2 +Int 2) %Int 2))
    92	                    +Int oddPos((N -Int ((N %Int 10 +Int 10) %Int 10))
    93	                                   /Int 10) } => #Top
    94	    requires N >Int 0
    95	    [simplification]
    96	  rule { (O +Int ((N %Int 2 +Int 2) %Int 2))
    97	           +Int oddPos((N -Int ((N %Int 10 +Int 10) %Int 10))
    98	                          /Int 10)
    99	         #Equals O +Int oddPos(N) } => #Top
   100	    requires N >Int 0
