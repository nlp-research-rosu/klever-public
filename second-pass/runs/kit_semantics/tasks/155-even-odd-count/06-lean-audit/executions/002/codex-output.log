     1	import Klean155EvenOddCount.Lemmas
     2	import Std.Tactic
     3	
     4	namespace Proof
     5	
     6	/- Decimal-digit counts for a nonnegative magnitude. The recursive argument
     7	   is divided by ten, exactly as in the frozen Python loop. -/
     8	private def evenDigitCount (n : Nat) : Int :=
     9	  if _h : n = 0 then
    10	    0
    11	  else
    12	    1 - Int.ofNat (n % 2) + evenDigitCount (n / 10)
    13	termination_by n
    14	decreasing_by omega
    15	
    16	private def oddDigitCount (n : Nat) : Int :=
    17	  if _h : n = 0 then
    18	    0
    19	  else
    20	    Int.ofNat (n % 2) + oddDigitCount (n / 10)
    21	termination_by n
    22	decreasing_by omega
    23	
    24	private theorem evenDigitCount_step (n : Nat) (h : 0 < n) :
    25	    evenDigitCount n =
    26	      1 - Int.ofNat (n % 2) + evenDigitCount (n / 10) := by
    27	  rw [evenDigitCount]
    28	  simp [Nat.ne_of_gt h]
    29	
    30	private theorem oddDigitCount_step (n : Nat) (h : 0 < n) :
    31	    oddDigitCount n = Int.ofNat (n % 2) + oddDigitCount (n / 10) := by
    32	  rw [oddDigitCount]
    33	  simp [Nat.ne_of_gt h]
    34	
    35	private def evenMagnitude (n : Int) : Int := evenDigitCount n.natAbs
    36	private def oddMagnitude (n : Int) : Int := oddDigitCount n.natAbs
    37	
    38	/- K's guarded terms normalize the already-nonnegative remainders once more.
    39	   On a positive input they are the ordinary parity and decimal quotient. -/
    40	private theorem positive_normalizations (N : Int) (h : 0 < N) :
    41	    ((N % 2 + 2) % 2 = N % 2) ∧
    42	    ((N % 10 + 10) % 10 = N % 10) ∧
    43	    Int.tdiv (N - ((N % 10 + 10) % 10)) 10 = N / 10 := by
    44	  have hn : 0 ≤ N := by omega
    45	  constructor
    46	  · omega
    47	  constructor
    48	  · omega
    49	  rw [Int.tdiv_eq_ediv_of_nonneg]
    50	  · omega
    51	  · have hr : 0 ≤ N % 10 := Int.emod_nonneg N (by omega)
    52	    omega
    53	
    54	private theorem evenMagnitude_step (N : Int) (h : 0 < N) :
    55	    evenMagnitude N =
    56	      1 - ((N % 2 + 2) % 2) +
    57	        evenMagnitude
    58	          (Int.tdiv (N - ((N % 10 + 10) % 10)) 10) := by
    59	  rcases positive_normalizations N h with ⟨hp, _hm, hq⟩
    60	  rw [hp, hq]
    61	  unfold evenMagnitude
    62	  have hN : 0 ≤ N := by omega
    63	  have hqAbs : (N / 10).natAbs = N.natAbs / 10 := by
    64	    simpa using Int.natAbs_ediv_of_nonneg (b := 10) hN
    65	  have hpNat : (N % 2).natAbs = N.natAbs % 2 := by
    66	    simpa using Int.natAbs_emod_of_nonneg hN 2
    67	  have hpNonneg : 0 ≤ N % 2 := Int.emod_nonneg N (by omega)
    68	  have hpCast : Int.ofNat (N.natAbs % 2) = N % 2 := by
    69	    rw [← hpNat]
    70	    exact Int.natAbs_of_nonneg hpNonneg
    71	  rw [hqAbs]
    72	  rw [evenDigitCount_step N.natAbs (by omega)]
    73	  rw [hpCast]
    74	
    75	private theorem oddMagnitude_step (N : Int) (h : 0 < N) :
    76	    oddMagnitude N =
    77	      ((N % 2 + 2) % 2) +
    78	        oddMagnitude
    79	          (Int.tdiv (N - ((N % 10 + 10) % 10)) 10) := by
    80	  rcases positive_normalizations N h with ⟨hp, _hm, hq⟩
    81	  rw [hp, hq]
    82	  unfold oddMagnitude
    83	  have hN : 0 ≤ N := by omega
    84	  have hqAbs : (N / 10).natAbs = N.natAbs / 10 := by
    85	    simpa using Int.natAbs_ediv_of_nonneg (b := 10) hN
