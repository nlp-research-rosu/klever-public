     8	    If(Compare(Name("num"), CmpOp("==", Int(0))),
     9	      Return(TupleExpr(Int(1), Int(0))),
    10	      )
    11	    While(Compare(Name("num"), CmpOp(">", Int(0))),
    12	      Assign(
    13	        Name("even"),
    14	        BinOp(
    15	          "-",
    16	          BinOp("+", Name("even"), Int(1)),
    17	          BinOp("%", Name("num"), Int(2))))
    18	      Assign(
    19	        Name("odd"),
    20	        BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
    21	      Assign(Name("num"), BinOp("//", Name("num"), Int(10))))
    22	    Return(TupleExpr(Name("even"), Name("odd")))))

