     3	module VERIFICATION-WITH-LEMMA
     4	  imports VERIFICATION
     5	
     6	  // Operational use of the independently proved LOOP-PROOF.loop-tail theorem.
     7	  // Its complete match context and state footprint are identical to that claim.
     8	  rule
     9	    <k> #while(Compare(Name("num"), CmpOp(">", Int(0))),
    10	          Assign(Name("even"),
    11	                 BinOp("-",
    12	                   BinOp("+", Name("even"), Int(1)),
    13	                   BinOp("%", Name("num"), Int(2))))
    14	          Assign(Name("odd"),
    15	                 BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
    16	          Assign(Name("num"), BinOp("//", Name("num"), Int(10)))
    17	          .Stmts)
    18	        ~> (Return(TupleExpr(Name("even"), Name("odd"))) .Stmts)
    19	        ~> #endcall
    20	        => tuple(vCons(E +Int evenPos(N),
    21	                      vCons(O +Int oddPos(N), .ValSeq))) ~> CONT
    22	    </k>
    23	    <env> 1 => 0 </env>
    24	    <scopes>
    25	      -1 |-> B:Scope
