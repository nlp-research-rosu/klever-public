     1	requires "verification.k"
     2	requires "verification-with-lemma.k"
     3	
     4	module LOOP-PROOF
     5	  imports VERIFICATION
     6	
     7	  // Loop-tail invariant: from nonnegative remaining magnitude N and current
     8	  // counters E/O, the exact loop and return suffix add the digit summaries.
     9	  claim [loop-tail]:
    10	    <k> #while(Compare(Name("num"), CmpOp(">", Int(0))),
    11	          Assign(Name("even"),
    12	                 BinOp("-",
    13	                   BinOp("+", Name("even"), Int(1)),
    14	                   BinOp("%", Name("num"), Int(2))))
    15	          Assign(Name("odd"),
    16	                 BinOp("+", Name("odd"), BinOp("%", Name("num"), Int(2))))
    17	          Assign(Name("num"), BinOp("//", Name("num"), Int(10)))
    18	          .Stmts)
    19	        ~> (Return(TupleExpr(Name("even"), Name("odd"))) .Stmts)
    20	        ~> #endcall
    21	        => tuple(vCons(?ER:Int, vCons(?OR:Int, .ValSeq))) ~> CONT
    22	    </k>
    23	    <env> 1 => 0 </env>
    24	    <scopes>
    25	      -1 |-> B:Scope
    26	       0 |-> scope("even_odd_count" |-> C:Val, parent(-1))
    27	       1 |-> scope("num"  |-> N
    28	                   "even" |-> E
    29	                   "odd"  |-> O,
    30	                   parent(0))
    31	      =>
    32	      -1 |-> B
    33	       0 |-> scope("even_odd_count" |-> C, parent(-1))
    34	    </scopes>
    35	    <scopeLoc> 2 => 1 </scopeLoc>
    36	    <heap> .Map </heap>
    37	    <heapLoc> 0 </heapLoc>
    38	    <stack> ListItem(frame(CONT, 0, 1)) => .List </stack>
    39	    <ret> noRet </ret>
    40	    <exc> NoExc </exc>
    41	    <exit-code> 0 </exit-code>
    42	    requires N >=Int 0
    43	    ensures ?ER ==Int E +Int evenPos(N)
    44	     andBool ?OR ==Int O +Int oddPos(N)
    45	endmodule
    46	
    47	module SPEC
    48	  imports VERIFICATION-WITH-LEMMA
    49	
    50	  // Whole function call from an exact module binding, for every mathematical
    51	  // integer accepted by the HumanEval signature.
    52	  claim [even-odd-count]:
    53	    <k> Call(Name("even_odd_count"), N:Int)
    54	        => tuple(vCons(?ER:Int, vCons(?OR:Int, .ValSeq)))
    55	    </k>
    56	    <env> 0 </env>
    57	    <scopes>
    58	      -1 |-> builtinsScope
    59	       0 |-> scope("even_odd_count" |-> evenOddClosure, parent(-1))
    60	    </scopes>
    61	    <scopeLoc> 1 </scopeLoc>
    62	    <heap> .Map </heap>
    63	    <heapLoc> 0 </heapLoc>
    64	    <stack> .List </stack>
    65	    <ret> noRet </ret>
    66	    <exc> NoExc </exc>
    67	    <exit-code> 0 </exit-code>
    68	    ensures ?ER ==Int decEven(N)
    69	     andBool ?OR ==Int decOdd(N)
    70	endmodule
     1	def even_odd_count(num):
     2	    """Return the counts of even and odd decimal digits in num."""
     3	    num = abs(num)
     4	    even = 0
     5	    odd = 0
     6	
     7	    if num == 0:
     8	        return (1, 0)
     9	
    10	    while num > 0:
    11	        even = even + 1 - num % 2
    12	        odd = odd + num % 2
    13	        num = num // 10
    14	
    15	    return (even, odd)
