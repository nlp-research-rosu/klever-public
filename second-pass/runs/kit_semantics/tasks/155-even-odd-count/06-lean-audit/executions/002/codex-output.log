diff --git a//tmp/audit-work/candidate-structure.py b//tmp/audit-work/candidate-structure.py
new file mode 100644
index 0000000000000000000000000000000000000000..a77a9fddb365a76f4093ace3004b4c3f51783ce7
--- /dev/null
+++ b//tmp/audit-work/candidate-structure.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+
+import json
+import re
+from pathlib import Path
+
+from tools.klean_final_gate import _candidate_gate
+
+
+candidate = Path("/candidate")
+manifest = json.loads(
+    Path("/reference/klean-generation/generator-manifest.json").read_text()
+)
+target = manifest["target"]
+_candidate_gate(candidate, target)
+
+sources = {
+    path.relative_to(candidate).as_posix(): path.read_text()
+    for path in candidate.rglob("*.lean")
+    if "Base" not in path.relative_to(candidate).parts
+}
+forbidden = []
+for relative, text in sources.items():
+    for match in re.finditer(r"\b(?:sorry|admit|unsafe|axiom|opaque)\b", text):
+        forbidden.append({
+            "file": relative,
+            "token": match.group(0),
+            "offset": match.start(),
+        })
+
+proof = sources["Proof.lean"]
+parameter_counts = {}
+for parameter in target["parameters"]:
+    name = parameter["name"]
+    parameter_counts[name] = len(
+        re.findall(
+            rf"(?m)^\s*(?:noncomputable\s+)?def\s+{re.escape(name)}\s*(?::|\()",
+            proof,
+        )
+    )
+
+final_matches = re.findall(
+    r"(?ms)^\s*theorem\s+final\s*:\s*(.*?)\s*:=\s*by\b", proof
+)
+normalized_final = " ".join(final_matches[0].split()) if final_matches else None
+
+print(json.dumps({
+    "trusted_candidate_gate": "PASS",
+    "candidate_lean_sources_outside_base": sorted(sources),
+    "forbidden_tokens": forbidden,
+    "candidate_targetStatement_declarations": sum(
+        len(re.findall(r"(?m)^\s*def\s+targetStatement\b", text))
+        for text in sources.values()
+    ),
+    "final_theorem_count": len(final_matches),
+    "final_statement_exact_match": normalized_final
+    == " ".join(target["statement"].split()),
+    "parameter_definition_counts": parameter_counts,
+}, indent=2, sort_keys=True))
