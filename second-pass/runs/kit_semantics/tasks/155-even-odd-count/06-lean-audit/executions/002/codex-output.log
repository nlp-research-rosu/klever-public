index 0000000000000000000000000000000000000000..7243b4591a912951c7e741358e9d4e9cb5575dd1
--- /dev/null
+++ b//tmp/audit-work/stage4-integrity.py
@@ -0,0 +1,170 @@
+#!/usr/bin/env python3
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract
+from tools.lemma_discovery_contract import validate_trust_boundary
+
+
+def file_sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+audit = json.loads(Path("/audit-input.json").read_text())
+resolution = audit["resolution"]
+recorded = resolution["hashes"]
+k_workspace = Path("/reference/k-proof")
+k_audit = Path("/reference/k-audit")
+generation = Path("/reference/klean-generation")
+generated = generation / "generated"
+candidate = Path("/candidate")
+producer = Path("/reference/generation-tools")
+discovery_path = Path("/reference/lemma-discovery.json")
+
+observed_hashes = {
+    "k_workspace_sha256": pipeline_contract.sha256_tree(k_workspace),
+    "stage1_export_sha256": klean_export.tree_digest(k_workspace),
+    "discovery_manifest_sha256": file_sha(discovery_path),
+    "k_audit_sha256": pipeline_contract.sha256_tree(k_audit),
+    "klean_generation_sha256": pipeline_contract.sha256_tree(generation),
+    "generation_producer_sources_sha256": pipeline_contract.sha256_tree(producer),
+    "generated_tree_sha256": klean_export.tree_digest(generated),
+    "lean_workspace_sha256": pipeline_contract.sha256_tree(candidate),
+}
+
+expected_source_hashes = resolution["stage1_source_hashes"]
+observed_source_hashes = {
+    path.relative_to(k_workspace).as_posix(): pipeline_contract.sha256_file(path)
+    for path in pipeline_contract._walk_regular_files(
+        k_workspace, "frozen Stage 1 workspace"
+    )
+}
+
+generator_manifest = json.loads((generation / "generator-manifest.json").read_text())
+input_manifest = json.loads((generation / "input-manifest.json").read_text())
+obligation_path = generated / "obligation-map.json"
+obligation_map = json.loads(obligation_path.read_text())
+validated = validate_trust_boundary(k_workspace, discovery_path)
+domain_rules = validated["domain_lemmas"]
+source_rules = obligation_map["source_rules"]
+obligations = obligation_map["obligations"]
+
+domain_ids = [entry["source_rule_id"] for entry in domain_rules]
+source_ids = [entry["source_rule_id"] for entry in source_rules]
+obligation_ids = [entry["source_rule_id"] for entry in obligations]
+
+expected_definition = klean_export.expected_target_definition(obligation_map)
+observed_target = klean_export.target_statement(generated)
+audit_target = resolution["target"]
+
+conjunct_hash_mismatches = [
+    entry["source_rule_id"]
+    for entry in obligations
+    if entry["lean_conjunct_sha256"]
+    != klean_export.sha256_text(entry["lean_conjunct"])
+]
+binding_hash_mismatches = []
+for parameter in obligation_map["trust_parameters"]:
+    binding = {
+        key: parameter[key]
+        for key in ("kore_symbol", "name", "type", "source_rule_ids")
+    }
+    digest = klean_export.sha256_text(
+        json.dumps(binding, sort_keys=True, separators=(",", ":"))
+    )
+    if digest != parameter["binding_sha256"]:
+        binding_hash_mismatches.append(parameter["name"])
+
+source_rule_exact_matches = [
+    source_rules[index] == {
+        **domain_rules[index],
+        "discovery_manifest_sha256": observed_hashes[
+            "discovery_manifest_sha256"
+        ],
+        "inventory_sha256": validated["inventory_sha256"],
+    }
+    for index in range(len(domain_rules))
+] if len(source_rules) == len(domain_rules) else []
+
+sidecar_hashes = {
+    name: file_sha(generation / name)
+    for name in (
+        "generator-manifest.json",
+        "input-manifest.json",
+        "export-result.json",
+        "trust-inventory.json",
+    )
+}
+
+report = {
+    "recorded_hash_comparison": {
+        key: {
+            "expected": recorded[key],
+            "observed": value,
+            "match": recorded[key] == value,
+        }
+        for key, value in observed_hashes.items()
+    },
+    "unmounted_recorded_hashes_not_recomputed": ["lean_invocation_sha256"],
+    "stage1_source_file_hashes": {
+        "expected_count": len(expected_source_hashes),
+        "observed_count": len(observed_source_hashes),
+        "missing": sorted(set(expected_source_hashes) - set(observed_source_hashes)),
+        "extra": sorted(set(observed_source_hashes) - set(expected_source_hashes)),
+        "mismatched": sorted(
+            path for path in set(expected_source_hashes) & set(observed_source_hashes)
+            if expected_source_hashes[path] != observed_source_hashes[path]
+        ),
+    },
+    "stage4_sidecar_hashes": sidecar_hashes,
+    "manifest_cross_checks": {
+        "input_frozen_hash_matches": input_manifest["frozen_input_sha256"]
+        == observed_hashes["stage1_export_sha256"],
+        "input_stage1_hash_matches": input_manifest["stage1_workspace_sha256"]
+        == observed_hashes["stage1_export_sha256"],
+        "input_discovery_hash_matches": input_manifest[
+            "stage3_discovery_manifest_sha256"
+        ] == observed_hashes["discovery_manifest_sha256"],
+        "input_inventory_hash_matches": input_manifest["inventory_sha256"]
+        == validated["inventory_sha256"],
+        "input_verification_hash_matches": input_manifest["verification_sha256"]
+        == file_sha(k_workspace / "verification.k"),
+        "generator_tree_hash_matches": generator_manifest["generated_tree_sha256"]
+        == observed_hashes["generated_tree_sha256"],
+        "generator_obligation_map_hash_matches": generator_manifest[
+            "obligation_map_sha256"
+        ] == file_sha(obligation_path),
+        "generator_obligation_count_matches": generator_manifest["obligation_count"]
+        == len(obligations),
+        "generator_target_matches_observed": generator_manifest["target"]
+        == observed_target,
+        "audit_target_matches_observed": audit_target == observed_target,
+    },
+    "bijection": {
+        "domain_count": len(domain_ids),
+        "source_count": len(source_ids),
+        "obligation_count": len(obligation_ids),
+        "ordered_ids_equal": domain_ids == source_ids == obligation_ids,
+        "domain_ids_unique": len(domain_ids) == len(set(domain_ids)),
+        "source_ids_unique": len(source_ids) == len(set(source_ids)),
+        "obligation_ids_unique": len(obligation_ids) == len(set(obligation_ids)),
+        "source_rules_exact": len(source_rule_exact_matches) == len(domain_rules)
+        and all(source_rule_exact_matches),
+        "conjunct_hash_mismatches": conjunct_hash_mismatches,
+    },
+    "target": {
+        "observed": observed_target,
+        "expected_definition_sha256": klean_export.sha256_text(expected_definition),
+        "expected_definition_matches_observed": klean_export.sha256_text(
+            expected_definition
+        ) == observed_target["definition_sha256"],
+        "statement_hash_recomputed": klean_export.sha256_text(
+            observed_target["statement"]
+        ),
+        "binding_hash_mismatches": binding_hash_mismatches,
+    },
+}
+
+print(json.dumps(report, indent=2, sort_keys=True))
