Module(
  FuncDef("below_zero", Params("operations"),
    Assign(Name("balance"), Int(0))
    Assign(Name("operation"), Int(0))
    For(Name("operation"), Name("operations"),
      AugAssign(Name("balance"), "+", Name("operation"))
      If(Compare(Name("balance"), CmpOp("<", Int(0))),
        Return(Bool(true)),
        ))
    Return(Bool(false)))
  Assert(
    Compare(
      Call(Name("below_zero"), ListExpr()),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("below_zero"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("below_zero"),
        ListExpr(Int(1), Int(2), UnaryOp("-", Int(4)), Int(5))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("below_zero"), ListExpr(Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("below_zero"), ListExpr(UnaryOp("-", Int(1)))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("below_zero"),
        ListExpr(Int(5), UnaryOp("-", Int(5)), UnaryOp("-", Int(1)))),
      CmpOp("==", Bool(true)))))
