+      ~> Return(Bool(false)) .Stmts ~> #endcall
+      => belowFrom(BALANCE, VS)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
