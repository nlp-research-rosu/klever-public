exec
/bin/bash -lc 'set +e
for d in 32 33 34; do
 kprove spec.k --definition verification-kompiled --spec-module SPEC --depth "$d" > "marker-depth-$d.out" 2>&1
 printf '"'DEPTH=%s EXIT=%s\\n' \""'$d" "$?"
