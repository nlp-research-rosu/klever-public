+        Return(Bool(true)), .Stmts))
+    ~> Return(Bool(false)) ~> #endcall
+    => #belowZeroLoop(allInts(VS), VS) ... </k>
+    [priority(40)]
+
+  rule allInts(VS:ValSeq) => true
+    requires allInts(VS)
+    [simplification]
