+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/context-spec.k b/context-spec.k
