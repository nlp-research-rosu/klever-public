/bin/bash -lc 'set +e
kprove spec.k --definition verification-kompiled --spec-module SPEC > kprove-target.out 2>&1
status=$?
printf '"'EXIT=%s\\n' \""'$status"
sed -n '"'1,700p' kprove-target.out
exit 0" in /workspace
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0dacee6e12b7bededcdf9fe38dfbfdc09a51a175
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,38 @@
+requires "verification-base.k"
+
+module CONNECTION-SPEC
+  imports VERIFICATION-BASE
+
+  // Bridge-free universal connection theorem for the exact loop context used
+  // by the target proof.
+  claim [loop-connection]:
+    <k>
+      #loop(list(VS:ValSeq), Name("operation"),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) ~> #endcall
+      => belowFrom(BALANCE, VS)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..d68533ba39d2b61a71620f6835ed620512133a7d
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def below_zero(operations):
+    balance = 0
+    operation = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
+
+
+assert below_zero([]) == False
+assert below_zero([1, 2, 3]) == False
+assert below_zero([1, 2, -4, 5]) == True
+assert below_zero([0]) == False
+assert below_zero([-1]) == True
+assert below_zero([5, -5, -1]) == True
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7631caeeb7eb3cd9dbdfa7993fccb12935f700cd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+from typing import List
+
+
+def below_zero(operations: List[int]) -> bool:
+    balance = 0
+    operation = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8814a34edd79c1ffb3966ed83c0632940c902609
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Full target: load the exact translated module, install its exact closure,
+  // invoke the required entry point, and characterize every finite Int list.
+  claim [below-zero]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("below_zero", Params("operations"),
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)))))
+      ~> Call(Name("below_zero"), list(INPUT:ValSeq))
+      => belowFrom(0, INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+endmodule
diff --git a/verification-base.k b/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..a49c1ce142297b1bd77372ecd0db193af536c0e5
--- /dev/null
+++ b/verification-base.k
@@ -0,0 +1,48 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
+    [simplification]
+
+  syntax Bool ::= belowFrom(Int, ValSeq) [function, total]
+  rule belowFrom(_:Int, .ValSeq) => false
+  rule belowFrom(BALANCE:Int, vCons(V:Val, REST:ValSeq))
+    => #if BALANCE +Int projectIntTotal(V) <Int 0
+       #then true
+       #else belowFrom(BALANCE +Int projectIntTotal(V), REST)
+       #fi
+    requires isInt(V)
+  rule belowFrom(_:Int, vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  rule applyBin("+", I:Int, V:Val) => I +Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  rule ((L:Int |-> _:Scope) STORE:Map)[L <- undef] => STORE
+    requires notBool (L in_keys(STORE))
+    [simplification]
+endmodule
