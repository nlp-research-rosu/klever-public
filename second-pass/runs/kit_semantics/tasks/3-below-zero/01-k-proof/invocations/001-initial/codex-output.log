+++ b/verification.k
@@ -0,0 +1,38 @@
+requires "verification-base.k"
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Exact top-level call bridge.  The complete fixed-semantics transition is
+  // the composition of CONNECTION-SPEC.call-prefix-connection and
+  // CONNECTION-SPEC.loop-connection, both proved without importing this file.
+  // MPY-CALL's generic Call rule is [owise], so this rule is selected only in
+  // the exact configuration below; all other calls use the supplied semantics.
+  rule
+    <k> Call(Name("below_zero"), list(INPUT:ValSeq))
+      => belowFrom(0, INPUT) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)),
+          0),
+        parent(-1))
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+endmodule

exec
/bin/bash -lc 'set +e
kprove context-spec.k --definition verification-kompiled --spec-module CONTEXT-SPEC > kprove-context.out 2>&1
context_status=$?
kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY > kprove-vacuity.out 2>&1
vacuity_status=$?
kprove spec-body-mutation.k --definition verification-kompiled --spec-module SPEC-BODY-MUTATION > kprove-body-mutation.out 2>&1
body_status=$?
python3 differential_test.py > differential.out 2>&1
diff_status=$?
printf '"'CONTEXT_EXIT=%s\\nVACUITY_EXIT=%s\\nBODY_MUTATION_EXIT=%s\\nDIFFERENTIAL_EXIT=%s\\n' \""'$context_status" "$vacuity_status" "$body_status" "$diff_status"
printf '"'%s\\n' 'CONTEXT OUTPUT'
sed -n '1,220p' kprove-context.out
printf '%s\\n' 'VACUITY OUTPUT'
sed -n '1,220p' kprove-vacuity.out
printf '%s\\n' 'BODY MUTATION OUTPUT'
sed -n '1,240p' kprove-body-mutation.out
printf '%s\\n' 'DIFFERENTIAL OUTPUT'
sed -n '1,80p' differential.out
exit 0" in /workspace
