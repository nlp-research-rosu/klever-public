+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Full target: load the exact translated module, install its exact closure,
+  // invoke the required entry point, and characterize every finite Int list.
+  claim [below-zero]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("below_zero", Params("operations"),
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)))))
+      ~> Call(Name("below_zero"), list(INPUT:ValSeq))
+      => belowFrom(0, INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+endmodule
diff --git a/verification-base.k b/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..a49c1ce142297b1bd77372ecd0db193af536c0e5
--- /dev/null
+++ b/verification-base.k
@@ -0,0 +1,48 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
+    [simplification]
+
+  syntax Bool ::= belowFrom(Int, ValSeq) [function, total]
+  rule belowFrom(_:Int, .ValSeq) => false
+  rule belowFrom(BALANCE:Int, vCons(V:Val, REST:ValSeq))
+    => #if BALANCE +Int projectIntTotal(V) <Int 0
+       #then true
+       #else belowFrom(BALANCE +Int projectIntTotal(V), REST)
+       #fi
+    requires isInt(V)
+  rule belowFrom(_:Int, vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  rule applyBin("+", I:Int, V:Val) => I +Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  rule ((L:Int |-> _:Scope) STORE:Map)[L <- undef] => STORE
+    requires notBool (L in_keys(STORE))
+    [simplification]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9bfa3ad3bfe082e50a051674959d1ef9d2c763c3
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,95 @@
+requires "verification-base.k"
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  syntax KItem ::= #belowZeroLoop(Bool, Int, ValSeq)
+
+  // Total, exact-context dispatcher.  allInts is total, so the next two rules
+  // partition every matched list.  Both cases have bridge-free connection
+  // claims in connection-spec.k.
+  rule
+    <k>
+      #loop(list(VS:ValSeq), Name("operation"),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) ~> #endcall
+      => #belowZeroLoop(allInts(VS), BALANCE, VS)
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+    [priority(10)]
+
+  // List[int] case: exactly the state transition proved by loop-connection.
+  rule
+    <k> #belowZeroLoop(true, BALANCE:Int, VS:ValSeq)
+      => belowFrom(BALANCE, VS) </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(10)]
+
+  // Non-List[int] case: exactly MPY-CONTROLS' first #loop step, as proved by
+  // loop-fallback-connection.  Target claims never take this branch.
+  rule
+    <k> #belowZeroLoop(false, BALANCE:Int, VS:ValSeq)
+      => #iterNext(list(VS))
+         ~> #loopStep(Name("operation"),
+           AugAssign(Name("balance"), "+", Name("operation"))
+           If(Compare(Name("balance"), CmpOp("<", Int(0))),
+             Return(Bool(true)), .Stmts))
+         ~> Return(Bool(false)) ~> #endcall </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool allInts(VS)
+    [priority(10)]
+endmodule

diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e8556081cf777a00348ff8beebe742fc92363099
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,74 @@
+requires "verification-base.k"
+
+module CONNECTION-SPEC
+  imports VERIFICATION-BASE
+
+  // Bridge-free universal connection theorem for the exact loop context used
+  // by the target proof.
+  claim [loop-connection]:
+    <k>
+      #loop(list(VS:ValSeq), Name("operation"),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) ~> #endcall
+      => belowFrom(BALANCE, VS)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+
+  // Complementary connection theorem: outside List[int], the proof bridge
+  // performs exactly MPY-CONTROLS' first #loop step and no state change.
+  claim [loop-fallback-connection]:
+    <k>
+      #loop(list(VS:ValSeq), Name("operation"),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) ~> #endcall
+      =>
+      #iterNext(list(VS))
+      ~> #loopStep(Name("operation"),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool allInts(VS)
+endmodule
