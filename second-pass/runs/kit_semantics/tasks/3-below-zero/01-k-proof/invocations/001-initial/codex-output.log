+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  syntax KItem ::= #belowZeroLoop(Bool, Int, ValSeq)
+
+  // Total, exact-context dispatcher.  allInts is total, so the next two rules
+  // partition every matched list.  Both cases have bridge-free connection
+  // claims in connection-spec.k.
+  rule
+    <k>
+      #loop(list(VS:ValSeq), Name("operation"),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) ~> #endcall
+      => #belowZeroLoop(allInts(VS), BALANCE, VS)
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(100)]
+
+  // List[int] case: exactly the state transition proved by loop-connection.
+  rule
+    <k> #belowZeroLoop(true, BALANCE:Int, VS:ValSeq)
+      => belowFrom(BALANCE, VS) </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+    [priority(100)]
+
+  // Non-List[int] case: exactly MPY-CONTROLS' first #loop step, as proved by
+  // loop-fallback-connection.  Target claims never take this branch.
+  rule
+    <k> #belowZeroLoop(false, BALANCE:Int, VS:ValSeq)
+      => #iterNext(list(VS))
+         ~> #loopStep(Name("operation"),
+           AugAssign(Name("balance"), "+", Name("operation"))
+           If(Compare(Name("balance"), CmpOp("<", Int(0))),
+             Return(Bool(true)), .Stmts))
+         ~> Return(Bool(false)) ~> #endcall </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool allInts(VS)
+    [priority(100)]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled >/tmp/compile-priority.out 2>&1
status=$?
printf '"'COMPILE_EXIT=%s\\n' \""'$status"
if [ "$status" -ne 0 ]; then sed -n '"'1,200p' /tmp/compile-priority.out; exit 0; fi
set +e
kprove spec.k --definition verification-kompiled --spec-module SPEC --depth 33 > priority-depth33.out 2>&1
printf 'PROVE_EXIT=%s\\n' \""'$?"
sed -n '"'/<k>/,/<\\/k>/p' priority-depth33.out | head -50" in /workspace
