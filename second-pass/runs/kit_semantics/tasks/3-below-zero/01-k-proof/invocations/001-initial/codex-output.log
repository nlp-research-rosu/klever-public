+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+    [priority(40)]
+
+  // In every context not covered above, take exactly MPY-CONTROLS' first
+  // #loop step.  loop-fallback-connection proves this without the dispatcher.
+  rule <k> #belowZeroLoop(_:Bool, VS:ValSeq)
+    => #iterNext(list(VS))
+       ~> #loopStep(Name("operation"),
+         AugAssign(Name("balance"), "+", Name("operation"))
+         If(Compare(Name("balance"), CmpOp("<", Int(0))),
+           Return(Bool(true)), .Stmts))
+       ~> Return(Bool(false)) ~> #endcall ... </k>
+    [owise]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled >/tmp/compile-final.out 2>&1
status=$?
printf '"'COMPILE_EXIT=%s\\n' \""'$status"
if [ "$status" -ne 0 ]; then sed -n '"'1,260p' /tmp/compile-final.out; exit 0; fi
set +e
kprove spec.k --definition verification-kompiled --spec-module SPEC --depth 33 > marker2-depth33.out 2>&1
printf 'DEPTH_EXIT=%s\\n' \""'$?"
sed -n '"'/<k>/,/<\\/k>/p' marker2-depth33.out | head -60" in /workspace
