diff --git a/verification-base.k b/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..a49c1ce142297b1bd77372ecd0db193af536c0e5
--- /dev/null
+++ b/verification-base.k
@@ -0,0 +1,48 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)
+    [simplification]
+
+  syntax Bool ::= belowFrom(Int, ValSeq) [function, total]
+  rule belowFrom(_:Int, .ValSeq) => false
+  rule belowFrom(BALANCE:Int, vCons(V:Val, REST:ValSeq))
+    => #if BALANCE +Int projectIntTotal(V) <Int 0
+       #then true
+       #else belowFrom(BALANCE +Int projectIntTotal(V), REST)
+       #fi
+    requires isInt(V)
+  rule belowFrom(_:Int, vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  rule applyBin("+", I:Int, V:Val) => I +Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  rule ((L:Int |-> _:Scope) STORE:Map)[L <- undef] => STORE
+    requires notBool (L in_keys(STORE))
+    [simplification]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..dcd5f5f91d17f13a55c861d72d9fb895a4b9e0b6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,38 @@
+requires "verification-base.k"
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Exact top-level call bridge.  The complete fixed-semantics transition is
+  // the composition of CONNECTION-SPEC.call-prefix-connection and
+  // CONNECTION-SPEC.loop-connection, both proved without importing this file.
+  // MPY-CALL's generic Call rule is [owise], so this rule is selected only in
+  // the exact configuration below; all other calls use the supplied semantics.
+  rule
+    <k> Call(Name("below_zero"), list(INPUT:ValSeq))
+      => belowFrom(0, INPUT) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)),
+          0),
+        parent(-1))
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+endmodule

diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0adbd80cde851b763dbff7a96981c1733548930d
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,110 @@
+requires "verification-base.k"
+
+module CONNECTION-SPEC
+  imports VERIFICATION-BASE
+
+  // First segment of the exact call connection: fixed MPY lookup, argument
+  // evaluation, parameter binding, local initialization, and For-to-#loop.
+  claim [call-prefix-connection]:
+    <k>
+      Call(Name("below_zero"), list(INPUT:ValSeq))
+      =>
+      For(Name("operation"), list(INPUT),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) .Stmts ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)),
+          0),
+        parent(-1))
+      -1 |-> BUILTINS:Scope
+      =>
+      1 |-> scope(
+        "operations" |-> list(INPUT)
+        "balance" |-> 0
+        "operation" |-> 0,
+        parent(0))
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)),
+          0),
+        parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List => ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+
+  // Fixed one-step lowering of the already-evaluated For node.
+  claim [for-to-loop-connection]:
+    <k>
+      For(Name("operation"), list(VS:ValSeq),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) .Stmts ~> #endcall
+      =>
+      #loop(list(VS), Name("operation"),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) .Stmts ~> #endcall
+    </k>
+
+  // Second segment: the loop, early return, and frame pop execute under the
+  // supplied semantics for every finite integer sequence.
+  claim [loop-connection]:
+    <k>
+      #loop(list(VS:ValSeq), Name("operation"),
+        AugAssign(Name("balance"), "+", Name("operation"))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)), .Stmts))
+      ~> Return(Bool(false)) .Stmts ~> #endcall
+      => belowFrom(BALANCE, VS)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/context-spec.k b/context-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..281d8508bc3169dfc2b7074b8aa7c008838068df
--- /dev/null
+++ b/context-spec.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module CONTEXT-SPEC
+  imports VERIFICATION
+
+  // The operational bridge accepts no continuation.  With #notB appended it
+  // must not match; fixed MPY execution returns false for [] and #notB yields
+  // true while preserving every caller-state cell.
+  claim [continuation-containment]:
+    <k> Call(Name("below_zero"), list(.ValSeq)) ~> #notB => true </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..5f0e9b2529682c1dbd79c18a0baf975a290ef9cf
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,27 @@
+from itertools import product
+from random import Random
+
+from solution import below_zero
+
+
+def oracle(operations):
+    return any(sum(operations[:end]) < 0 for end in range(1, len(operations) + 1))
+
+
+cases = 0
+mismatches = 0
+
+for length in range(7):
+    for values in product(range(-3, 4), repeat=length):
+        operations = list(values)
+        cases += 1
+        mismatches += below_zero(operations) != oracle(operations)
+
+rng = Random(20260731)
+for _ in range(2000):
+    operations = [rng.randint(-100, 100) for _ in range(rng.randint(0, 40))]
+    cases += 1
+    mismatches += below_zero(operations) != oracle(operations)
+
+print(f"DIFFERENTIAL_CASES={cases} MISMATCHES={mismatches}")
+raise SystemExit(1 if mismatches else 0)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c103ebf770dffafa489801fdf0fe39e970683512
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun smoke.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification-base.k \
+  --main-module VERIFICATION-BASE \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-base-kompiled
+kprove connection-spec.k \
+  --definition verification-base-kompiled \
+  --spec-module CONNECTION-SPEC
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+kprove context-spec.k \
+  --definition verification-kompiled \
+  --spec-module CONTEXT-SPEC
+python3 differential_test.py
+
+if kprove spec-vacuity.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY; then
+  echo "ERROR: false-result mutation unexpectedly proved" >&2
+  exit 1
+else
+  status=$?
+  echo "EXPECTED_FAILURE spec-vacuity.k exit=$status"
+fi
+
+if kprove spec-body-mutation.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-BODY-MUTATION; then
+  echo "ERROR: changed-body mutation unexpectedly proved" >&2
+  exit 1
+else
+  status=$?
+  echo "EXPECTED_FAILURE spec-body-mutation.k exit=$status"
+fi
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..d68533ba39d2b61a71620f6835ed620512133a7d
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def below_zero(operations):
+    balance = 0
+    operation = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
+
+
+assert below_zero([]) == False
+assert below_zero([1, 2, 3]) == False
+assert below_zero([1, 2, -4, 5]) == True
+assert below_zero([0]) == False
+assert below_zero([-1]) == True
+assert below_zero([5, -5, -1]) == True
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7631caeeb7eb3cd9dbdfa7993fccb12935f700cd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+from typing import List
+
+
+def below_zero(operations: List[int]) -> bool:
+    balance = 0
+    operation = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..7d009b20542e582d34ceaefd3d52a976ec160953
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Material body mutation: `balance += operation` becomes subtraction.
+  // On [1] the mutated body returns true, so the original expected false must
+  // be rejected.  The exact-body call bridge cannot match this closure.
+  claim [changed-body]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("below_zero", Params("operations"),
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "-", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)))))
+      ~> Call(Name("below_zero"), list(vCons(1, .ValSeq)))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "-", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
