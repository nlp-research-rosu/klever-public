+          Return(Bool(false)),
+          0),
+        parent(-1))
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
