diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..568ab88e2b098d78d482cbcbdc3deaa995edc968
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,47 @@
+requires "verification-base.k"
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  syntax KItem ::= #belowZeroLoop(ValSeq)
+
+  // This internal dispatcher matches exactly the same <k> redex as MPY's
+  // first #loop step.  The valid exact context takes the proved summary below;
+  // every other context takes the owise fixed-step fallback.
+  rule <k>
+    #loop(list(VS:ValSeq), Name("operation"),
+      AugAssign(Name("balance"), "+", Name("operation"))
+      If(Compare(Name("balance"), CmpOp("<", Int(0))),
+        Return(Bool(true)), .Stmts))
+    ~> Return(Bool(false)) ~> #endcall
+    => #belowZeroLoop(VS) ... </k>
+    [simplification]
+
+  // Exact List[int] transition proved bridge-free by loop-connection.
+  rule
+    <k> #belowZeroLoop(VS:ValSeq)
+      => belowFrom(BALANCE, VS) </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+    [priority(40)]
+
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled >/tmp/compile-dispatch-simp.out 2>&1
status=$?
printf '"'COMPILE_EXIT=%s\\n' \""'$status"
if [ "$status" -ne 0 ]; then sed -n '"'1,300p' /tmp/compile-dispatch-simp.out; exit 0; fi
set +e
kprove spec.k --definition verification-kompiled --spec-module SPEC --depth 33 > dispatch-simp33.out 2>&1
printf 'DEPTH_EXIT=%s\\n' \""'$?"
sed -n '"'/<k>/,/<\\/k>/p' dispatch-simp33.out | head -100" in /workspace
