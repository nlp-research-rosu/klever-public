+         AugAssign(Name("balance"), "+", Name("operation"))
+         If(Compare(Name("balance"), CmpOp("<", Int(0))),
+           Return(Bool(true)), .Stmts))
+       ~> Return(Bool(false)) ~> #endcall ... </k>
+    [owise]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled >/tmp/compile-marker-simple.out 2>&1
status=$?
printf '"'COMPILE_EXIT=%s\\n' \""'$status"
if [ "$status" -ne 0 ]; then sed -n '"'1,320p' /tmp/compile-marker-simple.out; exit 0; fi
set +e
kprove spec.k --definition verification-kompiled --spec-module SPEC --depth 34 > marker-simple-depth34.out 2>&1
printf 'DEPTH_EXIT=%s\\n' \""'$?"
sed -n '"'/<k>/,/<\\/k>/p' marker-simple-depth34.out | head -80" in /workspace
