+      AugAssign(Name("balance"), "+", Name("operation"))
+      If(Compare(Name("balance"), CmpOp("<", Int(0))),
+        Return(Bool(true)), .Stmts))
+    ~> Return(Bool(false)) ~> #endcall
+    => #belowZeroLoop(VS) ... </k>
+    [simplification]
+
+  // Exact List[int] transition proved bridge-free by loop-connection.
+  rule
+    <k> #belowZeroLoop(VS:ValSeq)
+      => belowFrom(BALANCE, VS) </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
+        parent(0))
+      0 |-> MODULE:Scope
+      -1 |-> BUILTINS:Scope
+      =>
+      0 |-> MODULE
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+    [priority(40)]
+
+endmodule

codex
The supplied semantics offers a cleaner, intended interception point: generic `Call` routing is explicitly `[owise]` so problem-local exact-call rules can preempt it. I’m abandoning the non-firing loop interceptor. Instead I’ll machine-check two bridge-free universal segments—exact call setup to the loop head, then loop head to result—and use their reachability composition to justify one exact top-level call bridge. This preserves an end-to-end target claim while keeping the bridge connection independent and fully symbolic.
apply patch
