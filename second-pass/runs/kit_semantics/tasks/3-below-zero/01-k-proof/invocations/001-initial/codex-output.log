+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "+", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)),
+          0),
+        parent(-1))
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+endmodule

exec
/bin/bash -lc "set +e
kprove connection-spec.k --definition verification-base-kompiled --spec-module CONNECTION-SPEC --claims CONNECTION-SPEC.call-prefix-connection > kprove-prefix.out 2>&1
printf 'EXIT=%s\\n' \""'$?"
sed -n '"'1,500p' kprove-prefix.out
exit 0" in /workspace
