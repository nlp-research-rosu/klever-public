+      ~> Return(Bool(false)) ~> #endcall
+      => belowFrom(BALANCE, VS) ~> CONT
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      STORE:Map
+      L |-> scope(
+        "operations" |-> list(ORIGINAL:ValSeq)
+        "balance" |-> BALANCE:Int
+        "operation" |-> OLD:Val,
