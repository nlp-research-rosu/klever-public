  retr
    | SortBound.inj_SortBool x => some (SortExpr.inj_SortBool x)
    | SortBound.inj_SortFloat x => some (SortExpr.inj_SortFloat x)
    | SortBound.inj_SortInt x => some (SortExpr.inj_SortInt x)
