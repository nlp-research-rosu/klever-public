#include <sys/types.h>
#include <unistd.h>
#include <stdlib.h>
#include <errno.h>

pid_t getpid(void) {
  char visible[64];
  ssize_t n = readlink(\"/proc/self\", visible, sizeof(visible) - 1);
  if (n <= 0 || n >= (ssize_t)sizeof(visible)) {
    errno = ENOENT;
    return (pid_t)-1;
  }
  visible[n] = '\\0';
  return (pid_t)strtol(visible, NULL, 10);
}
