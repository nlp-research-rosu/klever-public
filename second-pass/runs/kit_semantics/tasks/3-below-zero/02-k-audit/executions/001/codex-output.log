diff --git a//tmp/audit-work/3-below-zero-audit/auditor-smoke.py b//tmp/audit-work/3-below-zero-audit/auditor-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..705e1fc1c229e5d665dbc4dbad9904218753a744
--- /dev/null
+++ b//tmp/audit-work/3-below-zero-audit/auditor-smoke.py
@@ -0,0 +1,21 @@
+from typing import List
+
+
+def below_zero(operations: List[int]) -> bool:
+    balance = 0
+    operation = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
+
+
+assert below_zero([]) == False
+assert below_zero([1, 2, 3]) == False
+assert below_zero([1, 2, -4, 5]) == True
+assert below_zero([0]) == False
+assert below_zero([-1]) == True
+assert below_zero([10, -10, -1]) == True
+assert below_zero([100000000000000000000, -100000000000000000000]) == False
+assert below_zero([100000000000000000000, -100000000000000000001]) == True
