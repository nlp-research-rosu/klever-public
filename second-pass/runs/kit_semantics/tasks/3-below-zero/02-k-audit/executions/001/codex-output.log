for opts in '--sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner' '--sort=name --mtime=UTC\\ 1970-01-01 --owner=0 --group=0 --numeric-owner' '--sort=name'; do eval tar "'$opts -cf - . 2>/dev/null | sha256sum; done
