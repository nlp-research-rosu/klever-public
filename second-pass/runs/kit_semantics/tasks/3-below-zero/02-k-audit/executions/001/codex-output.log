@@ -0,0 +1,48 @@
+requires "verification.k"
+
+module AUDITOR-BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // Fresh operational mutation: addition becomes subtraction. On [1], fixed
+  // execution returns true, so the original false result must be rejected.
+  claim [subtract-body]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("below_zero", Params("operations"),
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "-", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)))))
+      ~> Call(Name("below_zero"), list(vCons(1, .ValSeq)))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", .ParamNames,
+          Assign(Name("balance"), Int(0))
+          Assign(Name("operation"), Int(0))
+          For(Name("operation"), Name("operations"),
+            AugAssign(Name("balance"), "-", Name("operation"))
+            If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              Return(Bool(true)), .Stmts))
+          Return(Bool(false)), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/3-below-zero-audit/auditor-ground-summary-spec.k b//tmp/audit-work/3-below-zero-audit/auditor-ground-summary-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d1c82921d0cb179f1f4520b06502ffbf06992861
--- /dev/null
+++ b//tmp/audit-work/3-below-zero-audit/auditor-ground-summary-spec.k
@@ -0,0 +1,17 @@
+requires "verification-base.k"
+
+module AUDITOR-GROUND-SUMMARY-SPEC
+  imports VERIFICATION-BASE
+
+  claim [empty]:
+    <k> belowFrom(0, .ValSeq) => false </k>
+
+  claim [all-positive]:
+    <k> belowFrom(0, vCons(1, vCons(2, vCons(3, .ValSeq)))) => false </k>
