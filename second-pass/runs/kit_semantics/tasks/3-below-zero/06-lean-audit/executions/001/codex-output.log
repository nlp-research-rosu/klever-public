+private def badIsInt (_ : SortK) : SortBool := false
+private def badNot (_ : SortBool) : SortBool := false
+private def badProject (_ : SortK) : SortInt := 0
+private def badProjectTotal (_ : SortVal) : SortInt := 0
+private def badProjectOption (_ : SortK) : Option SortInt := none
+
+theorem vacuousCountermodel :
+    Klean3BelowZero.Lemmas.targetStatement
+      badMap badInKeys badDelete badMapItem badAdd badApply badDefined
+      badIsInt badNot badProject badProjectTotal badProjectOption := by
+  simp [Klean3BelowZero.Lemmas.targetStatement, badMap, badInKeys,
+    badDelete, badMapItem, badAdd, badApply, badDefined, badIsInt, badNot,
+    badProject, badProjectTotal, badProjectOption]
+
+end
+
+end OperationalAudit
