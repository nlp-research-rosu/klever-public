input ['definitions', 'frozen_input_sha256', 'inventory_sha256', 'lowered_structural_definition_rules', 'modeled_collection_hooks', 'modeled_operational_hooks', 'modeled_recursive_functions', 'operational_rules', 'problem', 'promoted_structural_definitions', 'proved_derived_lemmas', 'required_k_files', 'schema_version', 'source_rules', 'stage1_workspace_sha256', 'stage3_discovery_manifest_sha256', 'summary_functions', 'syntax_module', 'verification_module', 'verification_sha256']
{
  "inventory_sha256": "cbd01d2180727a31e50a6a9a84bb19a5f64ee02043eacf45565f265a3fdfb237",
  "schema_version": 3,
  "source_rules": [
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "f856a12a750c74e702b1beb9d39418a9bced8edfc66354eeb6a2dc544cdbb0cb",
      "end_line": 19,
      "file": "verification-base.k",
      "inventory_sha256": "cbd01d2180727a31e50a6a9a84bb19a5f64ee02043eacf45565f265a3fdfb237",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
      "rationale": "The left-hand side is #Ceil of K's generated Val-to-Int projection, both operations supplied outside the verification module. The simplification asserts a definedness fact about those operations and was not first proved as an identical claim.",
      "source_rule_id": "rule-0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
      "start_line": 17,
      "text": "  rule #Ceil({@V:Val}:>Int)\n    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))\n    [simplification]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "f856a12a750c74e702b1beb9d39418a9bced8edfc66354eeb6a2dc544cdbb0cb",
      "end_line": 25,
      "file": "verification-base.k",
      "inventory_sha256": "cbd01d2180727a31e50a6a9a84bb19a5f64ee02043eacf45565f265a3fdfb237",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
      "rationale": "The left-hand operation is K's generated Val-to-Int projection, so this symbolic orientation is a fact about an operation defined outside the verification module even though the right-hand side mentions a fresh helper. No identical prior claim proves it.",
      "source_rule_id": "rule-22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
      "start_line": 23,
      "text": "  rule {V:Val}:>Int => projectIntTotal(V)\n    requires definedProjectInt(V)\n    [symbolic(V), simplification, preserves-definedness]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "f856a12a750c74e702b1beb9d39418a9bced8edfc66354eeb6a2dc544cdbb0cb",
      "end_line": 28,
      "file": "verification-base.k",
      "inventory_sha256": "cbd01d2180727a31e50a6a9a84bb19a5f64ee02043eacf45565f265a3fdfb237",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "9e1486b6d25b62bd0949213fd58d7aac97ed89cc3e87b8c5063f915d1d6b7081",
      "rationale": "This is an idempotence property of the already-defined projectIntTotal helper rather than an input-case defining equation. It is installed as a simplification fact and has no statement-identical prior proof.",
      "source_rule_id": "rule-9e1486b6d25b62bd0949213fd58d7aac97ed89cc3e87b8c5063f915d1d6b7081",
      "start_line": 27,
      "text": "  rule projectIntTotal(projectIntTotal(V:Val)) => projectIntTotal(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "f856a12a750c74e702b1beb9d39418a9bced8edfc66354eeb6a2dc544cdbb0cb",
      "end_line": 43,
      "file": "verification-base.k",
      "inventory_sha256": "cbd01d2180727a31e50a6a9a84bb19a5f64ee02043eacf45565f265a3fdfb237",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "573796c5ae90b21570a38c51e4cd10a1610683b2a2b51c68ff466ef5277fc7fc",
      "rationale": "applyBin is defined by the supplied reference semantics, including integer addition. This simplification asserts an additional guarded fact for a dynamically sorted Val operand and was not first proved as an identical claim.",
      "source_rule_id": "rule-573796c5ae90b21570a38c51e4cd10a1610683b2a2b51c68ff466ef5277fc7fc",
      "start_line": 41,
      "text": "  rule applyBin(\"+\", I:Int, V:Val) => I +Int projectIntTotal(V)\n    requires isInt(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "f856a12a750c74e702b1beb9d39418a9bced8edfc66354eeb6a2dc544cdbb0cb",
      "end_line": 47,
      "file": "verification-base.k",
      "inventory_sha256": "cbd01d2180727a31e50a6a9a84bb19a5f64ee02043eacf45565f265a3fdfb237",
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "cb90fdcb0e186a19989751bd4a10097f8ae8a2187f7744809e5610f526f6179b",
      "rationale": "Map update and the scope-deletion operation are supplied outside the verification module. This simplification is an additional finite-map identity, not a definition of a fresh verification symbol, and no identical prior claim proves it.",
      "source_rule_id": "rule-cb90fdcb0e186a19989751bd4a10097f8ae8a2187f7744809e5610f526f6179b",
      "start_line": 45,
      "text": "  rule ((L:Int |-> _:Scope) STORE:Map)[L <- undef] => STORE\n    requires notBool (L in_keys(STORE))\n    [simplification]"
    }
  ],
  "verification_sha256": "c601d4228baa09fc834cc8142cbbfda01ad54ab92f4b1416a03ac3385cfbb73b"
}
