@@ -0,0 +1,94 @@
+import Proof
+
+namespace OperationalAudit
+
+open Proof
+
+noncomputable section
+
+local instance : DecidableEq SortKItem :=
+  Classical.typeDecidableEq SortKItem
+
+private def intVal (value : SortInt) : SortVal :=
+  SortVal.inj_SortInt value
+
+private def boolVal (value : SortBool) : SortVal :=
+  SortVal.inj_SortBool value
+
+private def intTerm (value : SortInt) : SortK :=
+  SortK.kseq (SortKItem.inj_SortInt value) SortK.dotk
+
+private def boolTerm (value : SortBool) : SortK :=
+  SortK.kseq (SortKItem.inj_SortBool value) SortK.dotk
+
+private def scope0 : SortScope :=
+  SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent»
+    ⟨[]⟩ SortParent.«root_MPY-CORE_Parent»
+
+private def key1 : SortKItem := SortKItem.inj_SortInt 1
+private def key2 : SortKItem := SortKItem.inj_SortInt 2
+private def val0 : SortKItem := SortKItem.inj_SortScope scope0
+private def emptyMap : SortMap := ⟨[]⟩
+private def store2 : SortMap := ⟨[(key2, val0)]⟩
+
+-- Boundary and adversarial witnesses for integer projection and arithmetic.
+example : Proof.«_+Int_» (-7) 2 = -5 := rfl
+example : Proof.«definedProjectInt(_)_VERIFICATION-BASE_Bool_Val»
+    (intVal (-13)) = true := rfl
+example : Proof.«definedProjectInt(_)_VERIFICATION-BASE_Bool_Val»
+    (boolVal true) = false := rfl
+example : Proof.isInt (intTerm (-13)) = true := rfl
+example : Proof.isInt (boolTerm true) = false := rfl
+example : Proof.«project:Int?» (intTerm (-13)) = some (-13) := rfl
+example : Proof.«project:Int?» (boolTerm true) = none := rfl
+example : Proof.«project:Int» (intTerm 37) = 37 := rfl
+example : Proof.projectIntTotal (intVal 37) = 37 := rfl
+example : Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "+" (intVal (-7)) (intVal 2) = intVal (-5) := rfl
+example : Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "+" (intVal 4) (boolVal true) = intVal 5 := rfl
+
+-- Map witnesses exercise both the guard and the update/delete transition.
+example : Proof.«_in_keys(_)_MAP_Bool_KItem_Map» key1 emptyMap = false := by
+  rfl
+
+-- Counterfactual mutations disagree on concrete reachable witnesses.
+private def subtractMutation (left right : SortInt) : SortInt := left - right
+private def constantProjectionMutation (_ : SortVal) : SortInt := 0
+private def constantMembershipMutation
+    (_ : SortKItem) (_ : SortMap) : SortBool := true
+
+example : subtractMutation (-7) 2 ≠ Proof.«_+Int_» (-7) 2 := by decide
+example : constantProjectionMutation (intVal 37) ≠
+    Proof.projectIntTotal (intVal 37) := by decide
+example : constantMembershipMutation key1 emptyMap ≠
+    Proof.«_in_keys(_)_MAP_Bool_KItem_Map» key1 emptyMap := by
+  decide
+
+-- The parameterized target itself admits a deliberately vacuous model.  This
+-- demonstrates why the separate operational-bridge audit is load-bearing.
+private def badMap (_ _ : SortMap) : SortMap := ⟨[]⟩
+private def badInKeys (_ : SortKItem) (_ : SortMap) : SortBool := true
+private def badDelete (_ : SortMap) (_ : SortKItem) : SortMap := ⟨[]⟩
+private def badMapItem (_ _ : SortKItem) : SortMap := ⟨[]⟩
+private def badAdd (_ _ : SortInt) : SortInt := 0
+private def badApply (_ : SortString) (_ _ : SortVal) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+private def badDefined (_ : SortVal) : SortBool := false
+private def badIsInt (_ : SortK) : SortBool := false
+private def badNot (_ : SortBool) : SortBool := false
+private def badProject (_ : SortK) : SortInt := 0
+private def badProjectTotal (_ : SortVal) : SortInt := 0
+private def badProjectOption (_ : SortK) : Option SortInt := none
+
+theorem vacuousCountermodel :
+    Klean3BelowZero.Lemmas.targetStatement
+      badMap badInKeys badDelete badMapItem badAdd badApply badDefined
+      badIsInt badNot badProject badProjectTotal badProjectOption := by
+  simp [Klean3BelowZero.Lemmas.targetStatement, badMap, badInKeys,
+    badDelete, badMapItem, badAdd, badApply, badDefined, badIsInt, badNot,
+    badProject, badProjectTotal, badProjectOption]
+
+end
+
+end OperationalAudit
