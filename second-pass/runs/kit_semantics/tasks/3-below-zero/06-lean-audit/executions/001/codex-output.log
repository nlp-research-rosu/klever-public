diff --git a//tmp/audit-work/proc_exe_shim.c b//tmp/audit-work/proc_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..89102c2d917765e9645e60526933ce4ccd56a0e4
--- /dev/null
+++ b//tmp/audit-work/proc_exe_shim.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (path && strncmp(path, "/proc/", 6) == 0) {
+        const char *suffix = strrchr(path, '/');
+        if (suffix && strcmp(suffix, "/exe") == 0) {
+            path = "/proc/self/exe";
+        }
+    }
+    return real_readlink(path, buf, bufsiz);
+}
