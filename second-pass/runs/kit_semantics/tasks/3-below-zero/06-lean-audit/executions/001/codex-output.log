index 0000000000000000000000000000000000000000..7399296ea6117173bff5f5927bd1d2d3ce935a07
--- /dev/null
+++ b//tmp/audit-work/lean-audit-DaSChT/OperationalAudit.lean
@@ -0,0 +1,108 @@
+import Proof
+
+namespace OperationalAudit
+
+open Proof
+
+noncomputable section
+
+local instance : DecidableEq SortKItem :=
+  Classical.typeDecidableEq SortKItem
+
+private def intVal (value : SortInt) : SortVal :=
+  SortVal.inj_SortInt value
+
+private def boolVal (value : SortBool) : SortVal :=
+  SortVal.inj_SortBool value
+
+private def intTerm (value : SortInt) : SortK :=
+  SortK.kseq (SortKItem.inj_SortInt value) SortK.dotk
+
+private def boolTerm (value : SortBool) : SortK :=
+  SortK.kseq (SortKItem.inj_SortBool value) SortK.dotk
+
+private def scope0 : SortScope :=
+  SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent»
+    ⟨[]⟩ SortParent.«root_MPY-CORE_Parent»
+
+private def key1 : SortKItem := SortKItem.inj_SortInt 1
+private def key2 : SortKItem := SortKItem.inj_SortInt 2
+private def val0 : SortKItem := SortKItem.inj_SortScope scope0
+private def emptyMap : SortMap := ⟨[]⟩
+private def store2 : SortMap := ⟨[(key2, val0)]⟩
+
+-- Boundary and adversarial witnesses for integer projection and arithmetic.
+example : Proof.«_+Int_» (-7) 2 = -5 := rfl
+example : Proof.«definedProjectInt(_)_VERIFICATION-BASE_Bool_Val»
+    (intVal (-13)) = true := rfl
+example : Proof.«definedProjectInt(_)_VERIFICATION-BASE_Bool_Val»
+    (boolVal true) = false := rfl
+example : Proof.isInt (intTerm (-13)) = true := rfl
+example : Proof.isInt (boolTerm true) = false := rfl
+example : Proof.«project:Int?» (intTerm (-13)) = some (-13) := rfl
+example : Proof.«project:Int?» (boolTerm true) = none := rfl
+example : Proof.«project:Int» (intTerm 37) = 37 := rfl
+example : Proof.projectIntTotal (intVal 37) = 37 := rfl
+example : Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "+" (intVal (-7)) (intVal 2) = intVal (-5) := rfl
+example : Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "+" (intVal 4) (boolVal true) = intVal 5 := rfl
+
+-- Map witnesses exercise both the guard and the update/delete transition.
+example : Proof.«_in_keys(_)_MAP_Bool_KItem_Map» key1 emptyMap = false := by
+  simp [Proof.«_in_keys(_)_MAP_Bool_KItem_Map», emptyMap]
+
+example : Proof.«_in_keys(_)_MAP_Bool_KItem_Map» key2 store2 = true := by
+  simp [Proof.«_in_keys(_)_MAP_Bool_KItem_Map», store2]
+
+example : Proof.notBool_
+    (Proof.«_in_keys(_)_MAP_Bool_KItem_Map» key1 store2) = true := by
+  simp [Proof.notBool_, Proof.«_in_keys(_)_MAP_Bool_KItem_Map», store2,
+    key1, key2]
+
+example : Proof.«_[_<-undef]»
+    (Proof._Map_ (Proof.«_|->_» key1 val0) store2) key1 = store2 := by
+  simp [Proof.«_[_<-undef]», Proof._Map_, Proof.«_|->_», store2, key1,
+    key2]
+
+-- Counterfactual mutations disagree on concrete reachable witnesses.
+private def subtractMutation (left right : SortInt) : SortInt := left - right
+private def constantProjectionMutation (_ : SortVal) : SortInt := 0
+private def constantMembershipMutation
+    (_ : SortKItem) (_ : SortMap) : SortBool := true
+
+example : subtractMutation (-7) 2 ≠ Proof.«_+Int_» (-7) 2 := by decide
+example : constantProjectionMutation (intVal 37) ≠
+    Proof.projectIntTotal (intVal 37) := by decide
+example : constantMembershipMutation key1 emptyMap ≠
+    Proof.«_in_keys(_)_MAP_Bool_KItem_Map» key1 emptyMap := by
+  simp [constantMembershipMutation,
+    Proof.«_in_keys(_)_MAP_Bool_KItem_Map», emptyMap]
+
+-- The parameterized target itself admits a deliberately vacuous model.  This
+-- demonstrates why the separate operational-bridge audit is load-bearing.
+private def badMap (_ _ : SortMap) : SortMap := ⟨[]⟩
+private def badInKeys (_ : SortKItem) (_ : SortMap) : SortBool := true
+private def badDelete (_ : SortMap) (_ : SortKItem) : SortMap := ⟨[]⟩
+private def badMapItem (_ _ : SortKItem) : SortMap := ⟨[]⟩
+private def badAdd (_ _ : SortInt) : SortInt := 0
+private def badApply (_ : SortString) (_ _ : SortVal) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+private def badDefined (_ : SortVal) : SortBool := false
+private def badIsInt (_ : SortK) : SortBool := false
+private def badNot (_ : SortBool) : SortBool := false
+private def badProject (_ : SortK) : SortInt := 0
+private def badProjectTotal (_ : SortVal) : SortInt := 0
+private def badProjectOption (_ : SortK) : Option SortInt := none
+
+theorem vacuousCountermodel :
+    Klean3BelowZero.Lemmas.targetStatement
+      badMap badInKeys badDelete badMapItem badAdd badApply badDefined
+      badIsInt badNot badProject badProjectTotal badProjectOption := by
+  simp [Klean3BelowZero.Lemmas.targetStatement, badMap, badInKeys,
+    badDelete, badMapItem, badAdd, badApply, badDefined, badIsInt, badNot,
+    badProject, badProjectTotal, badProjectOption]
+
+end
+
+end OperationalAudit
diff --git a//tmp/audit-work/proc_exe_shim.c b//tmp/audit-work/proc_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..89102c2d917765e9645e60526933ce4ccd56a0e4
--- /dev/null
+++ b//tmp/audit-work/proc_exe_shim.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (path && strncmp(path, "/proc/", 6) == 0) {
+        const char *suffix = strrchr(path, '/');
+        if (suffix && strcmp(suffix, "/exe") == 0) {
+            path = "/proc/self/exe";
+        }
+    }
+    return real_readlink(path, buf, bufsiz);
+}
diff --git a/evidence/audit_stage4.py b/evidence/audit_stage4.py
new file mode 100644
index 0000000000000000000000000000000000000000..afeb21599f2268db04da79db2584c6fc34dd3cb8
--- /dev/null
+++ b/evidence/audit_stage4.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+from pathlib import Path
+
+from tools import k_rule_inventory, klean_export
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha256_file(path: Path) -> str:
+    return sha256_bytes(path.read_bytes())
+
+
+generation = Path("/reference/klean-generation")
+generated = generation / "generated"
+obligation_path = generated / "obligation-map.json"
+obligation_map = json.loads(obligation_path.read_text())
+generator = json.loads((generation / "generator-manifest.json").read_text())
+input_manifest = json.loads((generation / "input-manifest.json").read_text())
+export_result = json.loads((generation / "export-result.json").read_text())
+audit = json.loads(Path("/audit-input.json").read_text())["resolution"]
+discovery_hash = sha256_file(Path("/reference/lemma-discovery.json"))
+inventory = k_rule_inventory.inventory_verification(Path("/reference/k-proof"))
+canonical = {r["source_rule_id"]: r for r in inventory["rules"]}
+domain = input_manifest["source_rules"]
+obligations = obligation_map["obligations"]
+
+domain_ids = [r["source_rule_id"] for r in domain]
+mapped_source_ids = [r["source_rule_id"] for r in obligation_map["source_rules"]]
+obligation_ids = [r["source_rule_id"] for r in obligations]
+
+per_obligation = []
+for source, obligation in zip(domain, obligations, strict=True):
+    canonical_rule = canonical[source["source_rule_id"]]
+    per_obligation.append({
+        "source_rule_id": source["source_rule_id"],
+        "canonical_source_match": all(
+            source.get(key) == canonical_rule.get(key)
+            for key in (
+                "source_rule_id", "module", "file", "start_line",
+                "end_line", "normalized_sha256", "attributes", "text",
+            )
+        ),
+        "obligation_source_id_match": (
+            obligation["source_rule_id"] == source["source_rule_id"]
+        ),
+        "obligation_source_span_match": obligation["source_span"] == {
+            "start_line": source["start_line"],
+            "end_line": source["end_line"],
+        },
+        "obligation_normalized_hash_match": (
+            obligation["normalized_sha256"] == source["normalized_sha256"]
+        ),
+        "obligation_inventory_hash_match": (
+            obligation["inventory_sha256"] == inventory["inventory_sha256"]
+        ),
+        "obligation_discovery_hash_match": (
+            obligation["discovery_manifest_sha256"] == discovery_hash
+        ),
+        "lean_conjunct_hash_actual": sha256_bytes(
+            obligation["lean_conjunct"].encode()
+        ),
+        "lean_conjunct_hash_recorded": obligation[
+            "lean_conjunct_sha256"
+        ],
+    })
+
+actual_target = klean_export.target_statement(generated)
+expected_definition = klean_export.expected_target_definition(obligation_map)
+print(json.dumps({
+    "domain_rule_ids": domain_ids,
+    "mapped_source_rule_ids": mapped_source_ids,
+    "obligation_rule_ids": obligation_ids,
+    "exact_ordered_bijection": (
+        domain_ids == mapped_source_ids == obligation_ids
+        and len(domain_ids) == len(set(domain_ids))
+    ),
+    "domain_count": len(domain_ids),
+    "manifest_obligation_count": generator["obligation_count"],
+    "export_obligation_count": export_result["obligation_count"],
+    "per_obligation": per_obligation,
+    "obligation_map_sha256_actual": sha256_file(obligation_path),
+    "obligation_map_sha256_recorded": generator["obligation_map_sha256"],
+    "expected_definition_sha256": sha256_bytes(
+        expected_definition.encode()
+    ),
+    "actual_target": actual_target,
+    "generator_target": generator["target"],
+    "audit_input_target": audit["target"],
+    "target_identity_all_match": (
+        actual_target == generator["target"] == audit["target"]
+    ),
+    "generated_tree_sha256_actual": klean_export.tree_digest(generated),
+    "generated_tree_sha256_generator": generator["generated_tree_sha256"],
+    "generated_tree_sha256_audit": audit["hashes"]["generated_tree_sha256"],
+    "discovery_sha256_actual": discovery_hash,
+    "discovery_sha256_input_manifest": input_manifest[
+        "stage3_discovery_manifest_sha256"
+    ],
+    "discovery_sha256_audit": audit["hashes"][
+        "discovery_manifest_sha256"
+    ],
+    "inventory_sha256_actual": inventory["inventory_sha256"],
+    "inventory_sha256_input_manifest": input_manifest["inventory_sha256"],
+    "verification_sha256_actual": sha256_file(
+        Path("/reference/k-proof/verification.k")
+    ),
+    "verification_sha256_input_manifest": input_manifest[
+        "verification_sha256"
+    ],
+}, indent=2, sort_keys=True))
