@@ -233,3 +233,52 @@
 end
 
 end Proof
+
+namespace Proof
+
+noncomputable section
+
+private def auditScope0 : SortScope :=
+  SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent»
+    ⟨[]⟩ SortParent.«root_MPY-CORE_Parent»
+
+private def auditKey1 : SortKItem := SortKItem.inj_SortInt 1
+private def auditKey2 : SortKItem := SortKItem.inj_SortInt 2
+private def auditVal0 : SortKItem := SortKItem.inj_SortScope auditScope0
+private def auditEmptyMap : SortMap := ⟨[]⟩
+private def auditStore2 : SortMap := ⟨[(auditKey2, auditVal0)]⟩
+
+-- Public target parameters reduce to the independently expected boundary
+-- behavior; private helpers are unfolded here because this audit copy is the
+-- same Lean source module as the candidate declarations.
+example : «_in_keys(_)_MAP_Bool_KItem_Map» auditKey1 auditEmptyMap = false := by
+  simp [«_in_keys(_)_MAP_Bool_KItem_Map», mapKeyPresentOperational,
+    auditEmptyMap]
+
+example : «_in_keys(_)_MAP_Bool_KItem_Map» auditKey2 auditStore2 = true := by
+  simp [«_in_keys(_)_MAP_Bool_KItem_Map», mapKeyPresentOperational,
+    auditStore2]
+
+example : notBool_
+    («_in_keys(_)_MAP_Bool_KItem_Map» auditKey1 auditStore2) = true := by
+  simp [notBool_, «_in_keys(_)_MAP_Bool_KItem_Map»,
+    mapKeyPresentOperational, auditStore2, auditKey1, auditKey2]
+
+example : «_[_<-undef]» (_Map_ («_|->_» auditKey1 auditVal0) auditStore2)
+    auditKey1 = auditStore2 := by
+  simp [_Map_, «_|->_», «_[_<-undef]», mapCrossDisjointOperational,
+    mapKeyPresentOperational, mapDeleteOperational, auditStore2,
+    auditKey1, auditKey2]
+
+-- Repeated occurrences are removed by delete; although duplicate keys are not
+-- well-formed K maps, this is an adversarial totalization witness.
+example : («_[_<-undef]»
+    ⟨[(auditKey1, auditVal0), (auditKey2, auditVal0),
+      (auditKey1, auditVal0)]⟩ auditKey1).coll =
+    [(auditKey2, auditVal0)] := by
+  simp [«_[_<-undef]», mapDeleteOperational, auditKey1, auditKey2]
+
+end
+
+
+end Proof
