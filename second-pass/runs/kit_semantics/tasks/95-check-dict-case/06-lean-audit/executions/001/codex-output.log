     2	def check_dict_case(dict):
     3	    """
     4	    Given a dictionary, return True if all keys are strings in lower 
     5	    case or all keys are strings in upper case, else return False.
     6	    The function should return False is the given dictionary is empty.
     7	    Examples:
     8	    check_dict_case({"a":"apple", "b":"banana"}) should return True.
     9	    check_dict_case({"a":"apple", "A":"banana", "B":"banana"}) should return False.
    10	    check_dict_case({"a":"apple", 8:"banana", "a":"apple"}) should return False.
    11	    check_dict_case({"Name":"John", "Age":"36", "City":"Houston"}) should return False.
    12	    check_dict_case({"STATE":"NC", "ZIP":"12345" }) should return True.
    13	    """
