   248	def md5Rounds (block : List Nat) :
   249	    Nat → Nat → UInt32 → UInt32 → UInt32 → UInt32 → Md5State
   250	  | 0, _, a, b, c, d => ⟨a, b, c, d⟩
   251	  | fuel + 1, i, a, b, c, d =>
   252	      let fg : UInt32 × Nat :=
   253	        if i < 16 then
   254	          ((b &&& c) ||| (~~~b &&& d), i)
   255	        else if i < 32 then
   256	          ((d &&& b) ||| (~~~d &&& c), (5 * i + 1) % 16)
