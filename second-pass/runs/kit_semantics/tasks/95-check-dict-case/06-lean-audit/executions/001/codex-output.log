+  inv=inventory_verification(workspace)
+  print(json.dumps(inv, indent=2, sort_keys=True))
+  canonical=[r['source_rule_id'] for r in inv['rules']]
+  classified=[r['source_rule_id'] for r in manifest['rules']]
+  print(json.dumps({
+    'canonical_count':len(canonical),
+    'manifest_count':len(classified),
+    'same_order':canonical==classified,
+    'unique_manifest':len(classified)==len(set(classified)),
+    'missing':sorted(set(canonical)-set(classified)),
+    'extra':sorted(set(classified)-set(canonical)),
