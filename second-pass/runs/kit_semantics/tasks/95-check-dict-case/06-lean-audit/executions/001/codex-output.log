   279	  let zeros := (56 + 64 - (withMarker.length % 64)) % 64
   280	  let bitLength := (bytes.length * 8) % (2 ^ 64)
   281	  withMarker ++ List.replicate zeros 0 ++
   282	    [natByte bitLength 0, natByte bitLength 8, natByte bitLength 16,
   283	     natByte bitLength 24, natByte bitLength 32, natByte bitLength 40,
   284	     natByte bitLength 48, natByte bitLength 56]
