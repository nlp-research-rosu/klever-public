     1	def check_dict_case(dict):
     2	    all_lower = True
     3	    all_upper = True
     4	    seen_key = False
     5	    key = None
     6	    is_string = False
     7	
     8	    for key in dict.keys():
     9	        seen_key = True
    10	        is_string = (all_lower or all_upper) and isinstance(key, str)
    11	        all_lower = all_lower and is_string and key.islower()
    12	        all_upper = all_upper and is_string and key.isupper()
    13	
    14	    return seen_key and (all_lower or all_upper)
