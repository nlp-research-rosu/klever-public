The trusted final gate is in its clean-build phase; no failure output has appeared. Independently, the adversarial bridge test is already decisive: Lean treats the invented carrier as a string and returns `true` for `"a".islower`, while frozen K proves that same carrier is not a string and leaves its `islower` application stuck.
diff --git a//tmp/audit-work/lean-hostpid-shim.c b//tmp/audit-work/lean-hostpid-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..32e01932a2d5cb8fc23e9c173a0af3ac8208c0ef
--- /dev/null
+++ b//tmp/audit-work/lean-hostpid-shim.c
@@ -0,0 +1,22 @@
+#define _GNU_SOURCE
+
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    FILE *status = fopen("/proc/self/status", "r");
+    if (status != NULL) {
+        char line[256];
+        while (fgets(line, sizeof(line), status) != NULL) {
+            long host_pid;
+            if (sscanf(line, "Pid:\t%ld", &host_pid) == 1) {
+                fclose(status);
+                return (pid_t)host_pid;
+            }
+        }
+        fclose(status);
+    }
+    return (pid_t)syscall(SYS_getpid);
+}
