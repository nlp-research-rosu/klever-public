+    (SortVal.«setV(_)_MPY-SET_Val_IntSeq» lowerCodes))
+#eval ("string_codes_round_trip", Proof.stringCodes encodedLower == lowerCodes)
+#eval ("lower_empty",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» emptyCodes)
+#eval ("lower_lower",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» lowerCodes)
