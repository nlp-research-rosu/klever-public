   404	def dispatchMethod
   405	    (receiver : SortVal) (method : SortString) (args : SortVals) : SortVal :=
   406	  match stringValueCodes? receiver with
   407	  | some codes => applyStringMethod codes method args
   408	  | none => applyNonStringMethod receiver method args
