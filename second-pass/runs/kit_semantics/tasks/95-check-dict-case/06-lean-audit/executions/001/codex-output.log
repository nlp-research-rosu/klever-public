+#eval ("is_ref_cell_ref",
+  Proof.«isRefV(_)_MPY-CORE_Bool_Val» (SortVal.«cellRef(_)_MPY-CORE_Val_Int» 7))
+#eval ("invented_carrier_is_string",
+  Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» encodedLower)
+#eval ("ordinary_set_is_string",
+  Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val»
+    (SortVal.«setV(_)_MPY-SET_Val_IntSeq» lowerCodes))
+#eval ("string_codes_round_trip", Proof.stringCodes encodedLower == lowerCodes)
+#eval ("lower_empty",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» emptyCodes)
+#eval ("lower_lower",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» lowerCodes)
+#eval ("lower_upper",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» upperCodes)
+#eval ("lower_mixed",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» mixedCodes)
+#eval ("upper_empty",
