@@ -0,0 +1,38 @@
+import Proof
+
+namespace Counterfactual
+
+def constantFalseAnd (_left _right : SortBool) : SortBool :=
+  false
+
+def constantMethod
+    (_receiver : SortVal) (_method : SortString) (_args : SortVals) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+
+def constantPredicate (_value : SortVal) : SortBool :=
+  false
+
+def constantNot (_value : SortBool) : SortBool :=
+  false
+
+def constantCodes (_value : SortVal) : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def constantCodePredicate (_codes : SortIntSeq) : SortBool :=
+  false
+
+theorem targetAcceptsVacuousConstants :
+    Klean95CheckDictCase.Lemmas.targetStatement
+      constantFalseAnd
+      constantMethod
+      constantPredicate
+      constantPredicate
+      constantCodePredicate
+      constantNot
+      constantCodes
+      constantCodePredicate := by
+  constructor <;> intro V h <;> simp [constantFalseAnd] at h
+
+#print axioms Counterfactual.targetAcceptsVacuousConstants
+
+end Counterfactual
