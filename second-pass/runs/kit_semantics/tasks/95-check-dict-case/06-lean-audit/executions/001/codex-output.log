diff --git a//tmp/audit-work/stage5-proof.Ib1FOg/ParameterAudit.lean b//tmp/audit-work/stage5-proof.Ib1FOg/ParameterAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..c95a5e914bc38aa7e57ccf70e7f0a1ae220fafc7
--- /dev/null
+++ b//tmp/audit-work/stage5-proof.Ib1FOg/ParameterAudit.lean
@@ -0,0 +1,51 @@
+import Proof
+
+def emptyCodes : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def lowerCodes : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 97 emptyCodes
+
+def upperCodes : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 65 emptyCodes
+
+def mixedCodes : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 97 upperCodes
+
+def encodedLower : SortVal :=
+  Operational.makeStringValue lowerCodes
+
+#eval ("and_tt", Proof._andBool_ true true)
+#eval ("and_tf", Proof._andBool_ true false)
+#eval ("not_true", Proof.notBool_ true)
+#eval ("not_false", Proof.notBool_ false)
+#eval ("is_ref_ref",
+  Proof.«isRefV(_)_MPY-CORE_Bool_Val» (SortVal.«ref(_)_MPY-CORE_Val_Int» 7))
+#eval ("is_ref_cell_ref",
+  Proof.«isRefV(_)_MPY-CORE_Bool_Val» (SortVal.«cellRef(_)_MPY-CORE_Val_Int» 7))
+#eval ("invented_carrier_is_string",
+  Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» encodedLower)
+#eval ("ordinary_set_is_string",
+  Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val»
+    (SortVal.«setV(_)_MPY-SET_Val_IntSeq» lowerCodes))
+#eval ("string_codes_round_trip", Proof.stringCodes encodedLower == lowerCodes)
+#eval ("lower_empty",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» emptyCodes)
+#eval ("lower_lower",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» lowerCodes)
+#eval ("lower_upper",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» upperCodes)
+#eval ("lower_mixed",
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» mixedCodes)
+#eval ("upper_empty",
+  Proof.«upperKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» emptyCodes)
+#eval ("upper_lower",
+  Proof.«upperKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» lowerCodes)
+#eval ("upper_upper",
+  Proof.«upperKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» upperCodes)
+#eval ("upper_mixed",
+  Proof.«upperKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» mixedCodes)
+#eval ("invented_receiver_islower",
+  Proof.«applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals»
+    encodedLower "islower" SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+    == SortVal.inj_SortBool true)
