+Initial result (exit 1):
+  Traceback (most recent call last):
+    File "<stdin>", line 3, in <module>
+    File "/reference/tools/klean_preflight.py", line 582, in check_generation
+      raise KleanPreflightError(
+  tools.klean_preflight.KleanPreflightError: lake clean failed (1): error: could not detect the configuration of the Lake installation
+
+Runtime diagnosis:
+  `/proc/self/status` exposed a host Pid and a distinct NSpid. Lean 4.22's
+  runtime used getpid() (the namespace PID) to resolve `/proc/<pid>/exe`, but
+  this container's `/proc` was mounted with host PIDs. `lean --version`
+  consequently printed `error: failed to locate application`.
+
+Narrow workaround source:
+  /tmp/audit-work/lean-hostpid-shim.c
+
+  #define _GNU_SOURCE
+  #include <stdio.h>
+  #include <sys/syscall.h>
+  #include <sys/types.h>
+  #include <unistd.h>
+  pid_t getpid(void) {
+      FILE *status = fopen("/proc/self/status", "r");
+      if (status != NULL) {
+          char line[256];
+          while (fgets(line, sizeof(line), status) != NULL) {
+              long host_pid;
+              if (sscanf(line, "Pid:\t%ld", &host_pid) == 1) {
+                  fclose(status);
+                  return (pid_t)host_pid;
+              }
+          }
+          fclose(status);
+      }
+      return (pid_t)syscall(SYS_getpid);
+  }
+
