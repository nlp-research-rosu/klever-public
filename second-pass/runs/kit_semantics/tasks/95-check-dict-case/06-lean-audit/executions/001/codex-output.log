+
+#eval ("and_tt", Proof._andBool_ true true)
+#eval ("and_tf", Proof._andBool_ true false)
+#eval ("not_true", Proof.notBool_ true)
+#eval ("not_false", Proof.notBool_ false)
+#eval ("is_ref_ref",
