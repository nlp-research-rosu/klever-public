+import Proof
+
+def aCodes : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 97
+    SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def fakeString : SortVal :=
+  Operational.makeStringValue aCodes
+
+#eval Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» fakeString
+#eval Proof.«isRefV(_)_MPY-CORE_Bool_Val» fakeString
+#eval Proof._andBool_
+  (Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» fakeString)
+  (Proof.notBool_ (Proof.«isRefV(_)_MPY-CORE_Bool_Val» fakeString))
+#eval Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» aCodes
+#eval Proof.«applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals»
+  fakeString "islower" SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+  == SortVal.inj_SortBool true
