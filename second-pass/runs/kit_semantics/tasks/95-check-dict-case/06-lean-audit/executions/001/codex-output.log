   388	  | SortVal.inj_SortIterable
   389	      (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» values) =>
   390	      if method == "index" then
   391	        match oneArgument args with
   392	        | some value =>
   393	            match indexOfValueAux values value 0 with
   394	            | some index => SortVal.inj_SortInt index
   395	            | none => undefinedMethodValue
