+#eval ("upper_lower",
+  Proof.«upperKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» lowerCodes)
+#eval ("upper_upper",
+  Proof.«upperKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» upperCodes)
+#eval ("upper_mixed",
+  Proof.«upperKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» mixedCodes)
+#eval ("invented_receiver_islower",
+  Proof.«applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals»
+    encodedLower "islower" SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+    == SortVal.inj_SortBool true)
