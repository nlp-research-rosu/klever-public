   324	def applyStringMethod
   325	    (codes : SortIntSeq) (method : SortString) (args : SortVals) : SortVal :=
   326	  if method == "isupper" && noArguments args then
   327	    SortVal.inj_SortBool (hasUpperCode codes && !hasLowerCode codes)
   328	  else if method == "islower" && noArguments args then
   329	    SortVal.inj_SortBool (hasLowerCode codes && !hasUpperCode codes)
   330	  else if method == "isalpha" && noArguments args then
   331	    SortVal.inj_SortBool
   332	      (!(intSeqToList codes).isEmpty && allAlphaCodes codes)
   333	  else if method == "isdigit" && noArguments args then
   334	    SortVal.inj_SortBool
   335	      (!(intSeqToList codes).isEmpty && allDigitCodes codes)
   336	  else if method == "lower" && noArguments args then
   337	    makeStringValue (mapLowerCodes codes)
   338	  else if method == "upper" && noArguments args then
   339	    makeStringValue (mapUpperCodes codes)
   340	  else if method == "swapcase" && noArguments args then
   341	    makeStringValue (mapSwapCodes codes)
   342	  else if method == "join" then
   343	    match oneArgument args with
   344	    | some (SortVal.inj_SortIterable
   345	        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» values)) =>
   346	        match joinStringValues codes values with
   347	        | some joined => makeStringValue joined
   348	        | none => undefinedMethodValue
   349	    | _ => undefinedMethodValue
   350	  else if method == "count" then
   351	    match oneArgument args >>= stringValueCodes? with
   352	    | some pattern => SortVal.inj_SortInt (countSubCodes codes pattern)
   353	    | none => undefinedMethodValue
   354	  else if method == "strip" && noArguments args then
   355	    makeStringValue (stripCodes codes)
   356	  else if method == "encode" then
   357	    match oneArgument args >>= stringValueCodes? with
   358	    | some _ => makeStringValue codes
   359	    | none => undefinedMethodValue
   360	  else if method == "startswith" then
   361	    match oneArgument args >>= stringValueCodes? with
   362	    | some prefixCodes => SortVal.inj_SortBool (startsWithCodes prefixCodes codes)
   363	    | none => undefinedMethodValue
   364	  else if method == "replace" then
   365	    match twoArguments args with
   366	    | some (oldValue, newValue) =>
   367	        match stringValueCodes? oldValue, stringValueCodes? newValue with
   368	        | some (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» oldCode
   369	            SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»),
   370	          some (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» newCode
   371	            SortIntSeq.«.IntSeq_MPY-CORE_IntSeq») =>
   372	            makeStringValue (replaceCode codes oldCode newCode)
   373	        | _, _ => undefinedMethodValue
   374	    | none => undefinedMethodValue
   375	  else
   376	    undefinedMethodValue
