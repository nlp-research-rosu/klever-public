+          setV(iCons(97, .IntSeq)),
+          "$KLEAN::MPY::RESERVED::STR$"))
+      =>
+      false
+    </k>
+
+  claim [fake-islower-stuck]:
+    <k>
+      applyMethod(
+        boundMethodV(
+          setV(iCons(97, .IntSeq)),
+          "$KLEAN::MPY::RESERVED::STR$"),
+        "islower",
+        .Vals)
+      =>
+      true
+    </k>
+endmodule
