   378	def applyNonStringMethod
   379	    (receiver : SortVal) (method : SortString) (args : SortVals) : SortVal :=
   380	  match receiver with
   381	  | SortVal.inj_SortIterable
   382	      (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» values) =>
   383	      if method == "count" then
   384	        match oneArgument args with
   385	        | some value => SortVal.inj_SortInt (countValueOccurrences values value)
   386	        | none => undefinedMethodValue
