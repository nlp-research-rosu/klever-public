index 0000000000000000000000000000000000000000..a45d900588dbf17df9980ca106e68bddfcb7140e
--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit.Y1Auq5/AuditOperational.lean
@@ -0,0 +1,119 @@
+import Proof
+
+namespace AuditOperational
+
+def codes (values : List Int) : SortIntSeq :=
+  Operational.listToIntSeq values
+
+def directString (values : List Int) : SortVal :=
+  Operational.makeStringValue (codes values)
+
+def nestedString (values : List Int) : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.inj_SortStr
+      (SortStr.«str(_)_MPY-CORE_Str_IntSeq» (codes values)))
+
+def noArgs : SortVals :=
+  SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+
+def oneArg (value : SortVal) : SortVals :=
+  SortVals.«_,__MPY-CORE_Vals_Val_Vals» value noArgs
+
+def intValue : SortVal := SortVal.inj_SortInt 7
+def refValue : SortVal := SortVal.«ref(_)_MPY-CORE_Val_Int» 7
+
+def apply (receiver : SortVal) (method : String) (args : SortVals) : SortVal :=
+  Proof.«applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals» receiver method args
+
+def lower (values : List Int) : Bool :=
+  Proof.«lowerKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» (codes values)
+
+def upper (values : List Int) : Bool :=
+  Proof.«upperKeyCodes(_)_PROOF-THEORY_Bool_IntSeq» (codes values)
+
+def operationalChecks : List (String × Bool) :=
+  [ ("andBool truth table",
+      [Proof._andBool_ false false, Proof._andBool_ false true,
+       Proof._andBool_ true false, Proof._andBool_ true true] ==
+      [false, false, false, true])
+  , ("notBool truth table", [Proof.notBool_ false, Proof.notBool_ true] == [true, false])
+  , ("isRefV distinguishes ref/string/int",
+      [Proof.«isRefV(_)_MPY-CORE_Bool_Val» refValue,
+       Proof.«isRefV(_)_MPY-CORE_Bool_Val» (directString [97]),
+       Proof.«isRefV(_)_MPY-CORE_Bool_Val» intValue] == [true, false, false])
+  , ("isStringKey accepts direct and raw nested strings only",
+      [Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» (directString [97]),
+       Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» (nestedString [97]),
+       Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» intValue,
+       Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» refValue] ==
+      [true, true, false, false])
+  , ("stringCodes preserves direct representation",
+      Proof.stringCodes (directString [65, 97, 49]) == codes [65, 97, 49])
+  , ("stringCodes preserves nested representation",
+      Proof.stringCodes (nestedString [65, 97, 49]) == codes [65, 97, 49])
+  , ("lowerKeyCodes boundaries and mixed case",
+      [lower [], lower [96], lower [97], lower [122], lower [123],
+       lower [97, 49], lower [97, 65]] ==
+      [false, false, true, true, false, true, false])
+  , ("upperKeyCodes boundaries and mixed case",
+      [upper [], upper [64], upper [65], upper [90], upper [91],
+       upper [65, 49], upper [65, 97]] ==
+      [false, false, true, true, false, true, false])
+  , ("applyMethod islower on direct/nested/empty/mixed",
+      [apply (directString [97]) "islower" noArgs,
+       apply (nestedString [97, 49]) "islower" noArgs,
+       apply (directString []) "islower" noArgs,
+       apply (directString [97, 65]) "islower" noArgs] ==
+      [SortVal.inj_SortBool true, SortVal.inj_SortBool true,
+       SortVal.inj_SortBool false, SortVal.inj_SortBool false])
+  , ("applyMethod isupper on direct/nested/empty/mixed",
+      [apply (directString [65]) "isupper" noArgs,
+       apply (nestedString [65, 49]) "isupper" noArgs,
+       apply (directString []) "isupper" noArgs,
+       apply (directString [65, 97]) "isupper" noArgs] ==
+      [SortVal.inj_SortBool true, SortVal.inj_SortBool true,
+       SortVal.inj_SortBool false, SortVal.inj_SortBool false])
+  , ("applyMethod rejects wrong arity and unknown method",
+      [apply (directString [97]) "islower" (oneArg intValue),
+       apply (directString [97]) "not-a-method" noArgs] ==
+      [Operational.fixedUndefinedMethodValue, Operational.fixedUndefinedMethodValue])
+  ]
+
+/- Counterfactual definitions deliberately make each target parameter convenient
+   or vacuous.  Each comparison must be false on a concrete semantic witness. -/
+def constantFalseApply (_ : SortVal) (_ : String) (_ : SortVals) : SortVal :=
+  SortVal.inj_SortBool false
+
+def identityApply (receiver : SortVal) (_ : String) (_ : SortVals) : SortVal :=
+  receiver
+
+def counterfactualChecks : List (String × Bool) :=
+  [ ("left-projection andBool is rejected",
+      (true : Bool) != Proof._andBool_ true false)
+  , ("identity notBool is rejected",
+      (true : Bool) != Proof.notBool_ true)
+  , ("constant-false isRefV is rejected by ref",
+      false != Proof.«isRefV(_)_MPY-CORE_Bool_Val» refValue)
+  , ("constant-true isStringKey is rejected by int",
+      true != Proof.«isStringKey(_)_PROOF-THEORY_Bool_Val» intValue)
+  , ("constant-empty stringCodes is rejected by lowercase string",
+      Operational.emptyCodeSequence != Proof.stringCodes (directString [97]))
+  , ("constant-false lowerKeyCodes is rejected by lowercase string",
+      false != lower [97])
+  , ("constant-false upperKeyCodes is rejected by uppercase string",
+      false != upper [65])
+  , ("constant-false applyMethod is rejected by islower(a)",
+      constantFalseApply (directString [97]) "islower" noArgs !=
+        apply (directString [97]) "islower" noArgs)
+  , ("identity applyMethod is rejected by islower(a)",
+      identityApply (directString [97]) "islower" noArgs !=
+        apply (directString [97]) "islower" noArgs)
+  ]
+
+#eval operationalChecks
+#eval counterfactualChecks
+
+example : operationalChecks.all (fun check => check.2) = true := by native_decide
+example : counterfactualChecks.all (fun check => check.2) = true := by native_decide
+
+end AuditOperational
