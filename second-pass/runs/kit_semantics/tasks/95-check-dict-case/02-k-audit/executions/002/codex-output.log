    14	  rule <k> FuncDef(F:String, Params(PNS:ParamNames), BODY:Stmts) => .K ... </k>
    15	       <env> L:Int </env>
    16	       <scopes> ... L |-> scope(M:Map => M [ F <- closureVal(PNS, BODY, L) ], _) ... </scopes>
    17	
    18	  syntax Expr ::= closureExpr(ParamNames, Stmts)
    19	  rule <k> closureExpr(PNS:ParamNames, BODY:Stmts) => closureVal(PNS, BODY, L) ... </k>
    20	       <env> L:Int </env>
    21	
    22	  // ==== annotated def/lambda (closure cells; spec 2.3) ======================
    23	  // closureValC(params, cellvars, body, captured-cells). No frame anchor: all
    24	  // enclosing-local reads are freevars (symtable-complete) and go through the
    25	  // captured cells; everything else is global/builtin, so the callee frame's
    26	  // parent is the module scope (0) — sound after the defining frame dies.
    27	  syntax Val ::= closureValC(ParamNames, ParamNames, Stmts, Map)
    28	
    29	  // capture: resolve each freevar to the enclosing frame's cellRef, then bind
    30	  // (FuncDef) or yield (Lambda) the closure value.
    31	  syntax KItem ::= #mkClosure(String, ParamNames, ParamNames, ParamNames, Stmts, Map)
    32	                 | #mkLambda(ParamNames, ParamNames, ParamNames, Stmts, Map)
    33	  rule <k> FuncDef(F:String, Params(PNS:ParamNames), CellVars(CVS:ParamNames),
    34	                   FreeVars(FVS:ParamNames), BODY:Stmts)
    35	        => #mkClosure(F, PNS, CVS, FVS, BODY, .Map) ... </k>
    36	  rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,
    37	                      (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)
    38	        => #mkClosure(F, PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>
    39	       <env> L:Int </env>
    40	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    41	       requires FV in_keys(M)
    42	  rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,
    43	                      .ParamNames, BODY:Stmts, CM:Map) => .K ... </k>
    44	       <env> L:Int </env>
    45	       <scopes> ... L |-> scope(M:Map => M [ F <- closureValC(PNS, CVS, BODY, CM) ], _) ... </scopes>
    46	
    47	  rule <k> Lambda(Params(PNS:ParamNames), E:Expr)
    48	        => closureVal(PNS, Return(E) .Stmts, L) ... </k>
    49	       <env> L:Int </env>
    50	  rule <k> Lambda(Params(PNS:ParamNames), CellVars(CVS:ParamNames),
    51	                  FreeVars(FVS:ParamNames), E:Expr)
    52	        => #mkLambda(PNS, CVS, FVS, Return(E) .Stmts, .Map) ... </k>
    53	  rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames,
    54	                     (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)
    55	        => #mkLambda(PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>
    56	       <env> L:Int </env>
    57	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    58	       requires FV in_keys(M)
    59	  rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames, .ParamNames, BODY:Stmts, CM:Map)
    60	        => closureValC(PNS, CVS, BODY, CM) ... </k>
    61	
    62	  // ==== bind params ========================================================
    63	  rule <k> #bindP(.ParamNames, .Vals) => .K ... </k>
    64	  rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals)) => #bindP(PS, VS) ... </k>
    65	       <env> L:Int </env>
    66	       <scopes> ... L |-> scope(M:Map => M [ P <- V ], _) ... </scopes>
    67	  // a param that is a cellvar was pre-bound to its cell at frame entry
    68	  rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals))
    69	        => #cellW({M[P]}:>Val, V) ~> #bindP(PS, VS) ... </k>
    70	       <env> L:Int </env>
    71	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    72	       requires "$cells" in_keys(M)
    73	        andBool pnMember(P, cellsOf({M["$cells"]}:>Val))
    74	        andBool P in_keys(M) andBool isCellRef({M[P]}:>Val)
    75	       [priority(40)]
    76	
    77	  // ==== return / pop the frame (the returned expr evaluates by strictness) ==
    78	  rule <k> Return(V:Val) ~> _ => #pop </k>
    79	       <ret> noRet => retV(V) </ret>
    80	  rule <k> #endcall => #pop ... </k>
    81	       <ret> noRet => retV(noneV) </ret>
    82	  // pop: restore env, DEALLOCATE the callee frame, and wind scopeLoc back (LIFO allocation
    83	  // makes the saved loc the callee frame's own loc). Sound because no closureVal outlives its
    84	  // defining frame (frontend subset: no returned/stored closures; module defs live in loc 0).
    85	  rule <k> #pop => V ~> CONT </k>
    86	       <ret>   retV(V) => noRet </ret>
    87	       <stack> ListItem(frame(CONT:K, CALLERL:Int, SAVEDL:Int)) => .List ... </stack>
    88	       <env>   L:Int => CALLERL </env>
    89	       <scopes> SC:Map => SC [ L <- undef ] </scopes>
    90	       <scopeLoc> _ => SAVEDL </scopeLoc>
    91	endmodule
     1	// reference/src/semantics/controls.k — MPY-CONTROLS
     2	
     3	module MPY-CONTROLS
     4	  imports MPY-CORE
     5	  imports MPY-TUPLE
     6	  imports MPY-ITER
     7	
     8	  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
     9	  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
    10	       <env> L:Int </env>
    11	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
    12	  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
    13	       <env> L:Int </env>
    14	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    15	       requires "$cells" in_keys(M)
    16	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
    17	        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
    18	       [priority(40)]
    19	
    20	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
    21	       <env> L:Int </env>
    22	       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
    23	       requires X in_keys(M)
    24	  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
    25	  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
    26	  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
    27	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
    28	       <env> L:Int </env>
    29	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    30	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    31	       [priority(40)]
    32	
    33	  // ==== import trivia: `from math import floor, ceil` binds the supported
    34	  // names as builtins in the current scope; every other import is a no-op
    35	  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
    36	  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
    37	  syntax KItem ::= #bindImports(ParamNames)
    38	  rule <k> #bindImports(.ParamNames) => .K ... </k>
    39	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    40	       <env> L:Int </env>
    41	       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
    42	       requires N ==String "floor" orBool N ==String "ceil"
    43	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    44	       requires notBool (N ==String "floor" orBool N ==String "ceil")
    45	
    46	  // ==== Expr statement: evaluate for effect, discard the value ===============
    47	  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
    48	  rule <k> Expr(_:Val) => .K ... </k>
    49	
    50	  // ==== If (condition evaluated by strictness) ==============================
    51	  syntax KItem ::= #branch(Bool, Stmts, Stmts)
    52	  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
    53	  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
    54	  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
    55	
    56	  // ==== IfExp: ternary T if C else E ========================================
    57	  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
    58	       requires truthy(V)
    59	  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
    60	       requires notBool truthy(V)
    61	
    62	  // ==== For: one loop, in-cell continuation, over #iterNext =================
    63	  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
    64	  // circularities anchor on #loop and narrowing substitutes the structure)
    65	  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
    66	                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
    67	                 | #loopLbl(K) | "#cont" | "#brk"
    68	
    69	  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
    70	
    71	  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
    72	  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
    73	  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
    74	        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
    75	
    76	  // ==== While ==============================================================
    77	  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
    78	  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
    79	  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
    80	       requires truthy(V)
    81	  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
    82	       requires notBool truthy(V)
    83	
    84	  // ==== loop control (break / continue) =====================================
    85	  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
    86	  rule <k> Continue => #cont ... </k>
    87	  rule <k> Break => #brk ... </k>
    88	  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
    89	  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
    90	  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
    91	  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
    92	
    93	  // ==== heap-object deref at the truthiness/iteration consumers ==============
    94	  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
    95	  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
    96	       <heap> ... H |-> V:Val ... </heap>
    97	       [priority(40)]
    98	  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
    99	       <heap> ... H |-> V:Val ... </heap>
   100	       [priority(40)]
   101	  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
   102	       <heap> ... H |-> V:Val ... </heap>
   103	       [priority(40)]
   104	  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
   105	  // mutating the iterated list inside its own loop is outside the subset)
   106	  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
   107	       <heap> ... H |-> V:Val ... </heap>
   108	       [priority(40)]
   109	endmodule
     1	// reference/src/semantics/list.k — MPY-LIST
     2	
     3	module MPY-LIST
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-OPERATORS
     7	
     8	  // ==== iteration (the iterator protocol's list case) =======================
     9	  rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>
    10	  rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>
    11	
    12	  // ==== ListExpr: [...] literal -> a fresh heap object =======================
    13	  syntax ApplyK ::= "toList"
    14	  rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>
    15	  rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>
    16	
    17	  // ==== list ops: + / == / != ===============================================
    18	  syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]
    19	  rule valSeqConcat(.ValSeq, T:ValSeq)                => T
    20	  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))
    21	
    22	  // list + list constructs a NEW object (k-cell — it allocates; operands land here
    23	  // already deref'd). priority(45) beats the generic BinOp dispatch.
    24	  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
    25	       [priority(45)]
    26	
    27	  rule applyCmp("==", list(A:ValSeq), list(B:ValSeq)) => A ==K B
    28	  rule applyCmp("!=", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== deep equality when elements are heap objects (list-of-lists) ========
    31	  // Python == is structural at every depth. Fires ONLY when a ref is present
    32	  // (the guard decides on concrete seqs); the plain ==K path above is unchanged.
    33	  syntax Bool ::= hasRefVS(ValSeq) [function, total]
    34	  rule hasRefVS(.ValSeq)                => false
    35	  rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)
    36	
    37	  syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]
    38	                | deepEqV(Val, Val, Map)        [function]
    39	  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true
    40	  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false
    41	  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false
    42	  rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)
    43	    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)
    44	
    45	  rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)
    46	       requires H in_keys(HP)
    47	  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
    48	       requires notBool isRefV(A) andBool H in_keys(HP)
    49	  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)
    50	  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]
    51	
    52	  // ==== mutator: xs.append(v) — an in-place heap write ======================
    53	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
    54	       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
    55	       [priority(40)]
    56	
    57	  // ==== `x in list` — a <k>-cell fold over #iterNext ========================
    58	  syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | "#notB"
    59	  rule <k> Compare(LV:Val, CmpOp("in",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>
    60	  rule <k> Compare(LV:Val, CmpOp("not in", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>
    61	  rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>
    62	  rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>
    63	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    64	       requires E ==K V
    65	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    66	       requires notBool (E ==K V)
    67	  rule <k> B:Bool ~> #notB => notBool B ... </k>
    68	endmodule
     1	// reference/src/semantics/str.k — MPY-STR
     2	
     3	module MPY-STR
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	
     7	  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
     8	  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
     9	  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
    10	        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
    11	
    12	  // ==== str literal (ASCII-only) ============================================
    13	  syntax IntSeq ::= strToCodes(String) [function]
    14	  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
    15	  rule strToCodes("") => .IntSeq
    16	  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    17	    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
    18	
    19	  // ==== operators: + / == / != / in =========================================
    20	  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
    21	  rule seqConcat(.IntSeq, T:IntSeq)                => T
    22	  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
    23	
    24	  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
    26	  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
    27	
    28	  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
    29	  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
    30	  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
    31	
    32	  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
    33	  rule strPrefix(.IntSeq, _:IntSeq)               => true
    34	  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
    35	  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
    36	
    37	  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
    38	  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
    39	  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
    40	  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
    41	       requires notBool strPrefix(P, iCons(C, Xs))
    42	
    43	  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
    44	  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
    45	  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
    46	  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
    47	  // str </<=/>/>= comparisons.
    48	  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
    49	  rule strLt(.IntSeq, .IntSeq)                => false
    50	  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
    51	  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
    52	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
    53	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
    54	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
    55	
    56	  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    57	  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
    58	  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
    59	  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
    60	endmodule
   180	                  [ "str"    <- typeV("str")       ]
   181	                  [ "float"  <- typeV("float")     ], root)
   182	
   183	  // ==== argument/element evaluation: ONE left-to-right loop, tagged by destination ==
   184	  // (list/tuple literals and calls all use it; modules extend ApplyK with their tags)
   185	  syntax ApplyK ::= toCall(Val)
   186	  syntax KItem  ::= #evalArgs(Exprs, Vals, ApplyK)
   187	                  | #evalArgCont(Exprs, Vals, ApplyK)
   188	                  | #applyK(ApplyK, Vals)
   189	  rule <k> #evalArgs((A:Expr, REST:Exprs), ACC:Vals, K:ApplyK) => A ~> #evalArgCont(REST, ACC, K) ... </k>
   190	  rule <k> V:Val ~> #evalArgCont(REST:Exprs, ACC:Vals, K:ApplyK) => #evalArgs(REST, appendVal(ACC, V), K) ... </k>
   191	  rule <k> #evalArgs(.Exprs, ACC:Vals, K:ApplyK) => #applyK(K, ACC) ... </k>
   192	
   193	  // ==== Int / Bool / None literals ==========================================
   194	  rule <k> Int(I:Int)   => I ... </k>
   195	  rule <k> Bool(B:Bool) => B ... </k>
   196	  rule <k> NoneVal      => noneV ... </k>
   197	
   198	  // ==== truthy (If, Assert, BoolOp, IfExp, not, While) ======================
   199	  syntax Bool ::= truthy(Val) [function]
   200	  rule truthy(B:Bool)          => B
   201	  rule truthy(noneV)           => false
   202	  rule truthy(I:Int)           => I =/=Int 0
   203	  rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)
   204	  rule truthy(list(V:ValSeq))  => notBool (V ==K .ValSeq)
   205	  rule truthy(tuple(V:ValSeq)) => notBool (V ==K .ValSeq)
   206	
   207	  // ==== extensible operator dispatch (cases added by the construct modules) ==
   208	  syntax Val  ::= applyUn(String, Val) [function]
   209	  syntax Val  ::= applyBin(String, Val, Val) [function]
   210	  syntax Bool ::= applyCmp(String, Val, Val) [function]
   211	
   212	  // ==== bool-is-a-subtype-of-int: numeric promotion helpers =================
   213	  // Python: `bool` derives from `int`; True/False act as 1/0 in arithmetic and
   214	  // comparison. boolAsInt is the total 0/1 coercion; the op-class predicates gate
   215	  // the generic Bool-operand promotion rules in int.k / bool.k / float.k (they
   216	  // re-dispatch to the existing Int / Float cases after coercion, so no numeric
   217	  // logic is duplicated). == and != over Bool x Bool stay in bool.k unchanged.
   218	  syntax Int ::= boolAsInt(Bool) [function, total]
   219	  rule boolAsInt(true)  => 1
   220	  rule boolAsInt(false) => 0
   221	
   222	  syntax Bool ::= isArithOp(String) [function, total]
   223	  rule isArithOp(OP:String)
   224	    => OP ==String "+"  orBool OP ==String "-"  orBool OP ==String "*"
   225	       orBool OP ==String "/" orBool OP ==String "//" orBool OP ==String "%"
   226	       orBool OP ==String "**"
   227	  // the six comparison operators (== != < <= > >=)
   228	  syntax Bool ::= isEqOrdOp(String) [function, total]
   229	  rule isEqOrdOp(OP:String)
   230	    => OP ==String "==" orBool OP ==String "!=" orBool OP ==String "<"
   231	       orBool OP ==String "<=" orBool OP ==String ">" orBool OP ==String ">="
   232	  // the four ordering operators only (< <= > >=)
   233	  syntax Bool ::= isOrdOp(String) [function, total]
   234	  rule isOrdOp(OP:String)
   235	    => OP ==String "<" orBool OP ==String "<=" orBool OP ==String ">" orBool OP ==String ">="
   236	
   237	  // ==== shared list helpers =================================================
   238	  syntax Vals ::= appendVal(Vals, Val) [function, total]
   239	  rule appendVal(.Vals, V:Val)              => V , .Vals
   240	  rule appendVal((V0:Val, VS:Vals), V:Val)  => V0 , appendVal(VS, V)
   241	
   242	  syntax ValSeq ::= vals2valSeq(Vals) [function, total]
   243	  rule vals2valSeq(.Vals)            => .ValSeq
   244	  rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))
   245	
   246	  // ==== shared sequence length (len / summaries across many modules) ========
   247	  // (positional access valSeqAt/intSeqAt + normIdx live in subscript.k)
   248	  syntax Int ::= vsLen(ValSeq) [function, total]
   249	  rule vsLen(.ValSeq)                => 0
   250	  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
   251	
   252	  syntax Int ::= isLen(IntSeq) [function, total]
   253	  rule isLen(.IntSeq)                => 0
   254	  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
   255	
   256	  // in-bounds positional write (list subscript-assign); OOB leaves the seq unchanged
   257	  // (valid programs write in-bounds — mirrors valSeqAt's total-but-underspecified stance)
   258	  syntax ValSeq ::= setVSAt(ValSeq, Int, Val) [function, total]
   259	  rule setVSAt(.ValSeq, _:Int, _:Val)               => .ValSeq
   260	  rule setVSAt(vCons(_:Val, S:ValSeq), 0, V:Val)    => vCons(V, S)
   261	  rule setVSAt(vCons(W:Val, S:ValSeq), I:Int, V:Val) => vCons(W, setVSAt(S, I -Int 1, V))
   262	       requires I >Int 0
   263	  rule setVSAt(VS:ValSeq, I:Int, _:Val)             => VS
   264	       requires I <Int 0
   265	endmodule

diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..7509cf840adcca52a947fc5d06d6afb6a93e3d97
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,155 @@
+#!/usr/bin/env bash
+set -u
+
+evidence_dir=/audit-output/evidence
+
+required_paths=(
+  /audit-input.json
+  /audit-campaign-lock.json
+  /candidate
+  /reference/canonical.py
+  /reference/prompt.py
+  /reference/py2mpy.py
+  /reference/reference-semantics
+  /run.json
+  /task.json
+  /generation-result.json
+  /generation-evidence/invocation.json
+  /generation-evidence/metrics.json
+  /generation-evidence/runtime-metrics.json
+  /generation-evidence/usage.json
+  /generation-evidence/codex-last.txt
+  /generation-evidence/codex-output.log
+  /generation-evidence/prompt.txt
+  /generation-evidence/codex-trace
+)
+
+status=0
+for path in "${required_paths[@]}"; do
+  if [[ -r "$path" ]]; then
+    stat -c 'REQUIRED_OK type=%F mode=%A path=%n' "$path"
+  else
+    printf 'REQUIRED_MISSING_OR_UNREADABLE path=%s\n' "$path"
+    status=1
+  fi
+done
+
+printf 'DIRECT_FILE_HASHES\n'
+sha256sum \
+  /audit-campaign-lock.json \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /generation-evidence/invocation.json \
+  /generation-evidence/metrics.json \
+  /generation-evidence/runtime-metrics.json \
+  /generation-evidence/usage.json \
+  /generation-evidence/codex-last.txt \
+  /generation-evidence/codex-output.log \
+  /generation-evidence/prompt.txt
+
+python3 - <<'PY'
+import hashlib
+import json
+from pathlib import Path
+
+audit = json.loads(Path("/audit-input.json").read_text())
+lock = json.loads(Path("/audit-campaign-lock.json").read_text())
+print("CAMPAIGN_OBJECT_EQUALS_LOCK", audit["audit_campaign"] == lock)
+print("RECORD_LAYOUT", audit["record_layout"])
+print("SEMANTICS_MODE", audit["semantics_mode"])
+
+expected = audit["hashes"]
+checks = {
+    "audit_campaign_lock_sha256": "/audit-campaign-lock.json",
+    "canonical_sha256": "/reference/canonical.py",
+    "trusted_prompt_sha256": "/reference/prompt.py",
+    "trusted_translator_sha256": "/reference/py2mpy.py",
+    "run_manifest_sha256": "/run.json",
+    "task_manifest_sha256": "/task.json",
+    "stage1_result_sha256": "/generation-result.json",
+    "stage1_invocation_sha256": "/generation-evidence/invocation.json",
+    "generation_metrics_sha256": "/generation-evidence/metrics.json",
+    "generation_runtime_metrics_sha256": "/generation-evidence/runtime-metrics.json",
+    "generation_usage_sha256": "/generation-evidence/usage.json",
+    "generation_codex_last_sha256": "/generation-evidence/codex-last.txt",
+    "generation_codex_output_sha256": "/generation-evidence/codex-output.log",
+    "generation_prompt_sha256": "/generation-evidence/prompt.txt",
+}
+for key, path in checks.items():
+    actual = hashlib.sha256(Path(path).read_bytes()).hexdigest()
+    print(
+        "RECORDED_HASH_CHECK",
+        key,
+        "expected=" + expected[key],
+        "actual=" + actual,
+        "match=" + str(expected[key] == actual),
+    )
+
+stage1 = json.loads(Path("/generation-result.json").read_text())
+for rel, recorded in sorted(stage1["outputs"]["evidence"].items()):
+    path = Path("/generation-evidence") / rel
+    actual = hashlib.sha256(path.read_bytes()).hexdigest()
+    print(
+        "STAGE1_EVIDENCE_HASH_CHECK",
+        rel,
+        "expected=" + recorded,
+        "actual=" + actual,
+        "match=" + str(recorded == actual),
+    )
+PY
+
+cmp -s /candidate/prompt.py /reference/prompt.py
+printf 'CANDIDATE_PROMPT_BYTE_IDENTICAL exit=%s\n' "$?"
+cmp -s /candidate/py2mpy.py /reference/py2mpy.py
+printf 'CANDIDATE_TRANSLATOR_BYTE_IDENTICAL exit=%s\n' "$?"
+
+diff -qr --no-dereference \
+  /reference/reference-semantics \
+  /candidate/reference-semantics
+semantics_diff_status=$?
+printf 'SUPPLIED_SEMANTICS_RECURSIVE_DIFF exit=%s\n' "$semantics_diff_status"
+if [[ "$semantics_diff_status" -ne 0 ]]; then
+  status=1
+fi
+
+for root in \
+  /candidate/reference-semantics \
+  /reference/reference-semantics \
+  /generation-evidence/codex-trace; do
+  printf 'ENTRY_TYPE_COUNTS root=%s\n' "$root"
+  find "$root" -printf '%y\n' | sort | uniq -c
+  find "$root" -type l -printf 'SYMLINK path=%p target=%l\n'
+done
+
+(
+  cd /candidate
+  find . -type f -print0 |
+    sort -z |
+    xargs -0 sha256sum
+) >"$evidence_dir/candidate-file-hashes.txt"
+
+(
+  cd /reference/reference-semantics
+  find . -type f -print0 |
+    sort -z |
+    xargs -0 sha256sum
+) >"$evidence_dir/trusted-semantics-file-hashes.txt"
+
+(
+  cd /candidate/reference-semantics
+  find . -type f -print0 |
+    sort -z |
+    xargs -0 sha256sum
+) >"$evidence_dir/candidate-semantics-file-hashes.txt"
+
+cmp -s \
+  "$evidence_dir/trusted-semantics-file-hashes.txt" \
+  "$evidence_dir/candidate-semantics-file-hashes.txt"
+printf 'SUPPLIED_SEMANTICS_HASH_MANIFEST_IDENTICAL exit=%s\n' "$?"
+
+printf 'FINAL_STATUS %s\n' "$status"
+exit "$status"
diff --git a/evidence/stage2_differential.py b/evidence/stage2_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..282c89a73246e8820c789b57378a98eaafe3eac4
--- /dev/null
+++ b/evidence/stage2_differential.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""Independent docstring-first differential for HumanEval/95.
+
+Oracle construction is intentionally separate from both implementations:
+for a nonempty plain dict, every key must be a string and either every key
+satisfies str.islower() or every key satisfies str.isupper().
+"""
+
+from __future__ import annotations
+
+from itertools import product
+import importlib.util
+import random
+from pathlib import Path
+
+
+def load_function(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.check_dict_case
+
+
+def contract_oracle(mapping: dict) -> bool:
+    keys = list(mapping.keys())
+    if not keys:
+        return False
+    all_lower = all(isinstance(key, str) and key.islower() for key in keys)
+    all_upper = all(isinstance(key, str) and key.isupper() for key in keys)
+    return all_lower or all_upper
+
+
+candidate = load_function(
+    "audited_candidate",
+    Path("/tmp/audit-work/case95/candidate-src/solution.py"),
+)
+canonical = load_function(
+    "trusted_canonical",
+    Path("/tmp/audit-work/case95/trusted/canonical.py"),
+)
+
+documented = [
+    {"a": "apple", "b": "banana"},
+    {"a": "apple", "A": "banana", "B": "banana"},
+    {"a": "apple", 8: "banana"},
+    {"Name": "John", "Age": "36", "City": "Houston"},
+    {"STATE": "NC", "ZIP": "12345"},
+]
+
+boundaries = [
+    {},
+    {"a": 0},
+    {"A": 0},
+    {"a": 0, "b": 0, 8: 0},
+    {"A": 0, "B": 0, 8: 0},
+    {"a": 0, "b": 0, "C": 0},
+    {"A": 0, "B": 0, "c": 0},
+    {"a": 0, "A": 0},
+    {8: 0},
+    {"": 0},
+    {"1": 0},
+    {"-": 0},
+    {"a1": 0},
+    {"A1": 0},
+    {"é": 0},
+    {"É": 0},
+    {"ß": 0},
+    {"中": 0},
+    {b"a": 0},
+    {("a",): 0},
+    {None: 0},
+]
+
+# Exhaust every insertion sequence through length four over a branch-oriented
+# pool. Repeated/equal keys deliberately exercise real dict de-duplication.
+key_pool = [
+    "a",
+    "b",
+    "A",
+    "B",
+    "Name",
+    "",
+    "1",
+    "a1",
+    "A1",
+    "é",
+    "É",
+    "中",
+    0,
+    8,
+    None,
+    b"a",
+    ("a",),
+]
+exhaustive = []
+for length in range(5):
+    for sequence in product(key_pool, repeat=length):
+        exhaustive.append({key: index for index, key in enumerate(sequence)})
+
+# Deterministic broader sample over arbitrary short strings and ordinary
+# non-string hashable keys.
+rng = random.Random(950095)
+alphabet = "abABzZ09_-éÉß中"
+generated = []
+for _ in range(5000):
+    mapping = {}
+    for index in range(rng.randrange(0, 9)):
+        kind = rng.randrange(5)
+        if kind == 0:
+            key = "".join(
+                rng.choice(alphabet) for _ in range(rng.randrange(0, 7))
+            )
+        elif kind == 1:
+            key = rng.randrange(-5, 12)
+        elif kind == 2:
+            key = None
+        elif kind == 3:
+            key = bytes([rng.randrange(0, 128)])
+        else:
+            key = (rng.randrange(-2, 3),)
+        mapping[key] = index
+    generated.append(mapping)
+
+groups = [
+    ("documented", documented),
+    ("boundaries", boundaries),
+    ("exhaustive_sequences", exhaustive),
+    ("generated", generated),
+]
+
+candidate_mismatches = []
+canonical_mismatches = []
+candidate_mismatch_count = 0
+canonical_mismatch_count = 0
+total = 0
+for group_name, cases in groups:
+    group_candidate = 0
+    group_canonical = 0
+    for mapping in cases:
+        expected = contract_oracle(mapping)
+        got_candidate = candidate(mapping)
+        got_canonical = canonical(mapping)
+        total += 1
+        if type(got_candidate) is not bool or got_candidate != expected:
+            group_candidate += 1
+            candidate_mismatch_count += 1
+            if len(candidate_mismatches) < 20:
+                candidate_mismatches.append(
+                    (group_name, mapping, expected, got_candidate)
+                )
+        if type(got_canonical) is not bool or got_canonical != expected:
+            group_canonical += 1
+            canonical_mismatch_count += 1
+            if len(canonical_mismatches) < 20:
+                canonical_mismatches.append(
+                    (group_name, mapping, expected, got_canonical)
+                )
+    print(
+        f"GROUP {group_name} cases={len(cases)} "
+        f"candidate_mismatches={group_candidate} "
+        f"canonical_mismatches={group_canonical}"
+    )
+
+for index, mapping in enumerate(documented, start=1):
+    print(
+        f"DOCUMENTED {index} input={mapping!r} expected={contract_oracle(mapping)!r} "
+        f"candidate={candidate(mapping)!r} canonical={canonical(mapping)!r}"
+    )
+
+print(f"TOTAL cases={total} candidate_mismatches={candidate_mismatch_count}")
+for row in candidate_mismatches:
+    print("CANDIDATE_MISMATCH", repr(row))
+print("CANONICAL_MISMATCH_COUNT", canonical_mismatch_count)
+for row in canonical_mismatches:
+    print("CANONICAL_MISMATCH_SAMPLE", repr(row))
+
+if candidate_mismatch_count:
+    raise SystemExit(1)
diff --git a/evidence/stage4_concrete_compare.py b/evidence/stage4_concrete_compare.py
new file mode 100644
index 0000000000000000000000000000000000000000..78c620bbafbd035986f8a0efabb2441969e3f905
--- /dev/null
+++ b/evidence/stage4_concrete_compare.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Concrete satisfying witnesses for the target precondition."""
+
+from pathlib import Path
+import importlib.util
+
+
+def load_function(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.check_dict_case
+
+
+candidate = load_function(
+    "candidate_stage4",
+    Path("/tmp/audit-work/case95/candidate-src/solution.py"),
+)
+canonical = load_function(
+    "canonical_stage4",
+    Path("/tmp/audit-work/case95/trusted/canonical.py"),
+)
+
+# These plain dictionaries correspond to non-reference ValSeq witnesses and
+# to the five K summary claims in stage4_summary_spec.k.
+cases = [
+    ("empty", {}, False),
+    ("lower", {"a": 0}, True),
+    ("upper", {"A": 0}, True),
+    ("mixed", {"a": 0, "B": 0}, False),
+    ("non-string", {8: 0}, False),
+]
+
+for name, mapping, claimed in cases:
+    candidate_result = candidate(mapping)
+    canonical_result = canonical(mapping)
+    print(
+        f"{name}: input={mapping!r} claimed={claimed!r} "
+        f"candidate={candidate_result!r} canonical={canonical_result!r}"
+    )
+    if candidate_result != claimed or canonical_result != claimed:
+        raise SystemExit(1)
diff --git a/evidence/stage4_extract_target.py b/evidence/stage4_extract_target.py
new file mode 100644
index 0000000000000000000000000000000000000000..74e9732e85d392198101892c18bdc13f197b8f89
--- /dev/null
+++ b/evidence/stage4_extract_target.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Extract the first target FuncDef from spec.k by balanced delimiters.
+
+The output wraps exactly that constructor subtree in Module(...), allowing K's
+own parser to normalize and compare it with trusted-regenerated solution.mpy.
+"""
+
+from pathlib import Path
+
+
+spec_path = Path("/tmp/audit-work/case95/candidate-src/spec.k")
+output_path = Path("/tmp/audit-work/case95/target-function.mpy")
+text = spec_path.read_text()
+
+target_offset = text.index("claim [target]:")
+start = text.index('FuncDef("check_dict_case"', target_offset)
+open_paren = text.index("(", start)
+depth = 0
+in_string = False
+escaped = False
+end = None
+for index in range(open_paren, len(text)):
+    char = text[index]
+    if in_string:
+        if escaped:
+            escaped = False
+        elif char == "\\":
+            escaped = True
+        elif char == '"':
+            in_string = False
+        continue
+    if char == '"':
+        in_string = True
+    elif char == "(":
+        depth += 1
+    elif char == ")":
+        depth -= 1
+        if depth == 0:
+            end = index + 1
+            break
+
+if end is None:
+    raise RuntimeError("unbalanced FuncDef constructor")
+
+func_def = text[start:end]
+# In claim/rule syntax K spells empty user lists as their generated terminator
+# (".Exprs"); the program parser spells the same list as an empty position.
+terminator_count = func_def.count(".Exprs")
+program_form = func_def.replace(".Exprs", "")
+output_path.write_text("Module(\n" + program_form + ")\n")
+print(
+    f"extracted_chars={len(func_def)} normalized_empty_exprs={terminator_count} "
+    f"output={output_path}"
+)
