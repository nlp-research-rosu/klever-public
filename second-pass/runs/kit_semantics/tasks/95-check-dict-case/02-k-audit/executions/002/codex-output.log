+    {"a": "apple", "A": "banana", "B": "banana"},
+    {"a": "apple", 8: "banana"},
+    {"Name": "John", "Age": "36", "City": "Houston"},
+    {"STATE": "NC", "ZIP": "12345"},
+]
+
+boundaries = [
+    {},
+    {"a": 0},
+    {"A": 0},
+    {"a": 0, "b": 0, 8: 0},
+    {"A": 0, "B": 0, 8: 0},
+    {"a": 0, "b": 0, "C": 0},
+    {"A": 0, "B": 0, "c": 0},
+    {"a": 0, "A": 0},
+    {8: 0},
+    {"": 0},
+    {"1": 0},
+    {"-": 0},
+    {"a1": 0},
+    {"A1": 0},
+    {"é": 0},
+    {"É": 0},
+    {"ß": 0},
