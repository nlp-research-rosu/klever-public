Module(
  FuncDef("check_dict_case", Params("dict"),
    Assign(Name("all_lower"), Bool(true))
    Assign(Name("all_upper"), Bool(true))
    Assign(Name("seen_key"), Bool(false))
    Assign(Name("key"), NoneVal)
    Assign(Name("is_string"), Bool(false))
    For(Name("key"), Call(Attribute(Name("dict"), "keys"), ),
      Assign(Name("seen_key"), Bool(true))
      Assign(
        Name("is_string"),
        BoolOp(
          "and",
          BoolOp("or", Name("all_lower"), Name("all_upper")),
          Call(Name("isinstance"), Name("key"), Name("str"))))
      Assign(
        Name("all_lower"),
        BoolOp(
          "and",
          Name("all_lower"),
          Name("is_string"),
          Call(Attribute(Name("key"), "islower"), )))
      Assign(
        Name("all_upper"),
        BoolOp(
          "and",
          Name("all_upper"),
          Name("is_string"),
          Call(Attribute(Name("key"), "isupper"), ))))
    Return(
      BoolOp(
        "and",
        Name("seen_key"),
        BoolOp("or", Name("all_lower"), Name("all_upper")))))
  Assign(
    Name("empty_result"),
    Call(Name("check_dict_case"), DictExpr()))
  Assign(
    Name("lower_result"),
    Call(
      Name("check_dict_case"),
      DictExpr(Entry(Str("a"), Int(1)), Entry(Str("b2"), Int(2)))))
  Assign(
    Name("upper_result"),
    Call(
      Name("check_dict_case"),
      DictExpr(Entry(Str("STATE"), Int(1)), Entry(Str("ZIP"), Int(2)))))
  Assign(
    Name("mixed_result"),
    Call(
      Name("check_dict_case"),
      DictExpr(Entry(Str("a"), Int(1)), Entry(Str("B"), Int(2)))))
  Assign(
    Name("late_mixed_result"),
    Call(
      Name("check_dict_case"),
      DictExpr(
        Entry(Str("A"), Int(1)),
        Entry(Str("B"), Int(2)),
        Entry(Str("c"), Int(3)))))
  Assign(
    Name("late_nonstr_result"),
    Call(
      Name("check_dict_case"),
      DictExpr(
        Entry(Str("a"), Int(1)),
        Entry(Str("b"), Int(2)),
        Entry(Int(8), Int(3)))))
  Assign(
    Name("uncased_result"),
    Call(Name("check_dict_case"), DictExpr(Entry(Str("123"), Int(1))))))
