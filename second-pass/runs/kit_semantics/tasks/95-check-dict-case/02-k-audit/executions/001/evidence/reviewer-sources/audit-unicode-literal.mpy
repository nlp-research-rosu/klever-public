Module(
  FuncDef("check_dict_case", Params("dict"),
    Assign(Name("all_lower"), Bool(true))
    Assign(Name("all_upper"), Bool(true))
    Assign(Name("seen_key"), Bool(false))
    Assign(Name("key"), NoneVal)
    Assign(Name("is_string"), Bool(false))
    For(Name("key"), Call(Attribute(Name("dict"), "keys"), ),
      Assign(Name("seen_key"), Bool(true))
      Assign(
        Name("is_string"),
        BoolOp(
          "and",
          BoolOp("or", Name("all_lower"), Name("all_upper")),
          Call(Name("isinstance"), Name("key"), Name("str"))))
      Assign(
        Name("all_lower"),
        BoolOp(
          "and",
          Name("all_lower"),
          Name("is_string"),
          Call(Attribute(Name("key"), "islower"), )))
      Assign(
        Name("all_upper"),
        BoolOp(
          "and",
          Name("all_upper"),
          Name("is_string"),
          Call(Attribute(Name("key"), "isupper"), ))))
    Return(
      BoolOp(
        "and",
        Name("seen_key"),
        BoolOp("or", Name("all_lower"), Name("all_upper")))))
  Assign(
    Name("unicode_lower_result"),
    Call(
      Name("check_dict_case"),
      DictExpr(Entry(Str("\u00e9"), Int(1))))))
