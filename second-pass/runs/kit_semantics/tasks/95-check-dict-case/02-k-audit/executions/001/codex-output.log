diff --git a//tmp/audit-work/95-check-dict-case/audit-summary-witness.k b//tmp/audit-work/95-check-dict-case/audit-summary-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..bff07754e6967e3e8f88738eacf76e020c3804a4
--- /dev/null
+++ b//tmp/audit-work/95-check-dict-case/audit-summary-witness.k
@@ -0,0 +1,43 @@
+requires "connection.k"
+
+module AUDIT-SUMMARY-WITNESS
+  imports CONNECTION
+
+  claim [empty]:
+    <k>
+      checkCaseSummary(true, true, false, .ValSeq)
+      =>
+      false
+    </k>
+
+  claim [all-lower]:
+    <k>
+      checkCaseSummary(
+        true,
+        true,
+        false,
+        vCons(
+          str(iCons(97, .IntSeq)),
+          vCons(str(iCons(98, iCons(50, .IntSeq))), .ValSeq)))
+      =>
+      true
+    </k>
+
+  // This key sequence satisfies SPEC.target's no-reference premise.  It is
+  // also the smallest explicit candidate/canonical divergence found by the
+  // independent differential: A, B, then c.
+  claim [late-mixed]:
+    <k>
+      checkCaseSummary(
+        true,
+        true,
+        false,
+        vCons(
+          str(iCons(65, .IntSeq)),
+          vCons(
+            str(iCons(66, .IntSeq)),
+            vCons(str(iCons(99, .IntSeq)), .ValSeq))))
+      =>
+      false
+    </k>
+endmodule
