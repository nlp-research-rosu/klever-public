+          "check_dict_case" |->
+            closureVal(("dict", .ParamNames), checkDictBody(), 0)
+          "result" |-> false,
+          parent(-1))
+        -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(
+          str(iCons(97, .IntSeq)),
+          vCons(str(iCons(98, iCons(50, .IntSeq))), .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
