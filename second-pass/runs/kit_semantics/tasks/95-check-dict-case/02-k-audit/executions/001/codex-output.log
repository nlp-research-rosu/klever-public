     6	def contract_oracle(d):
     7	    if not d:
     8	        return False
     9	    keys = tuple(d.keys())
    10	    return (
    11	        all(isinstance(k, str) and k.islower() for k in keys)
    12	        or all(isinstance(k, str) and k.isupper() for k in keys)
    13	    )
