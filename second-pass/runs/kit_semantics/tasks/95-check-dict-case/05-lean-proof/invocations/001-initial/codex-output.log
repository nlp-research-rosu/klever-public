+/- Executable operational meaning of the frozen md5hexCodes trust symbol. -/
+structure Md5State where
+  a : UInt32
+  b : UInt32
+  c : UInt32
+  d : UInt32
+
+def nthD {α : Type} : List α → Nat → α → α
+  | [], _, fallback => fallback
+  | head :: _, 0, _ => head
+  | _ :: tail, index + 1, fallback => nthD tail index fallback
