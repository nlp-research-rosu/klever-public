+def mapUpperCodes : SortIntSeq → SortIntSeq
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => emptyCodeSequence
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail =>
