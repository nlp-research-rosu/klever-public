+def noArguments : SortVals → SortBool
+  | SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» => true
+  | _ => false
+
+def fixedUndefinedMethodValue : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
