+def joinStringValues (separator : SortIntSeq) : SortValSeq → Option SortIntSeq
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => some emptyCodeSequence
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value
+      SortValSeq.«.ValSeq_MPY-CORE_ValSeq» =>
+      stringValueCodes? value
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value rest => do
+      let headCodes ← stringValueCodes? value
+      let tailCodes ← joinStringValues separator rest
+      pure (intSeqAppend headCodes (intSeqAppend separator tailCodes))
