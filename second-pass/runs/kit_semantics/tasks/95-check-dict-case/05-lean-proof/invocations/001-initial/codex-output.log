+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» (swapCode head)
+        (mapSwapCodes tail)
+
+def trimWhitespace : SortIntSeq → SortIntSeq
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => emptyCodeSequence
