+def rotateLeft32 (word amount : UInt32) : UInt32 :=
+  (word <<< amount) ||| (word >>> (32 - amount))
+
+def md5Word (block : List Nat) (word : Nat) : UInt32 :=
+  let position := word * 4
+  UInt32.ofNat (nthD block position 0) |||
