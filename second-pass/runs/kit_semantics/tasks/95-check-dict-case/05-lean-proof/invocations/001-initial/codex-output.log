+import Proof
+
+namespace DispatchChecks
+
+def codes (xs : List Int) : SortIntSeq := Operational.listToIntSeq xs
+def str (xs : List Int) : SortVal := Operational.makeStringValue (codes xs)
+def rawStr (xs : List Int) : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» (codes xs)))
+def noArgs : SortVals := SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+def args1 (a : SortVal) : SortVals := SortVals.«_,__MPY-CORE_Vals_Val_Vals» a noArgs
+def args2 (a b : SortVal) : SortVals :=
+  SortVals.«_,__MPY-CORE_Vals_Val_Vals» a (args1 b)
+def seq : List SortVal → SortValSeq
+  | [] => SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+  | x :: xs => SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» x (seq xs)
+def listV (xs : List SortVal) : SortVal :=
+  SortVal.inj_SortIterable (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» (seq xs))
+def tupleV (xs : List SortVal) : SortVal :=
+  SortVal.inj_SortIterable (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» (seq xs))
+def intV (n : Int) : SortVal := SortVal.inj_SortInt n
+def boolV (b : Bool) : SortVal := SortVal.inj_SortBool b
+def noneV : SortVal := SortVal.«noneV_MPY-CORE_Val»
+def call (v : SortVal) (m : String) (args : SortVals) : SortVal :=
+  Proof.«applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals» v m args
+
+#eval ("isupper", call (str [65, 66, 33]) "isupper" noArgs == boolV true)
+#eval ("islower", call (str [97, 98, 33]) "islower" noArgs == boolV true)
+#eval ("isalpha-empty", call (str []) "isalpha" noArgs == boolV false)
+#eval ("isalpha", call (str [65, 122]) "isalpha" noArgs == boolV true)
+#eval ("isdigit", call (str [48, 57]) "isdigit" noArgs == boolV true)
+#eval ("lower", call (str [65, 33, 122]) "lower" noArgs == str [97, 33, 122])
+#eval ("upper", call (str [97, 33, 90]) "upper" noArgs == str [65, 33, 90])
+#eval ("swapcase", call (str [65, 122, 33]) "swapcase" noArgs == str [97, 90, 33])
+#eval ("join", call (str [44]) "join" (args1 (listV [str [97], rawStr [98]])) == str [97, 44, 98])
+#eval ("join-partial-tail", call (str [44]) "join" (args1 (listV [str [97], boolV true])) == str [97, 44])
+#eval ("join-partial-head", call (str [44]) "join" (args1 (listV [boolV true, str [97]])) == str [])
+#eval ("count-nonoverlap", call (str [97, 97, 97, 97]) "count" (args1 (str [97, 97])) == intV 2)
+#eval ("count-empty", call (str [97]) "count" (args1 (str [])) == intV 0)
+#eval ("strip", call (str [32, 9, 97, 10]) "strip" noArgs == str [97])
+#eval ("encode", call (str [97, 98]) "encode" (args1 (str [120])) == str [97, 98])
+#eval ("startswith", call (str [97, 98, 99]) "startswith" (args1 (rawStr [97, 98])) == boolV true)
+#eval ("replace", call (str [97, 98, 97]) "replace" (args2 (str [97]) (str [120])) == str [120, 98, 120])
+#eval ("list-count-bool", call (listV [boolV false, boolV true, boolV false]) "count" (args1 (boolV false)) == intV 2)
+#eval ("list-count-raw-string", call (listV [str [97], rawStr [97]]) "count" (args1 (str [97])) == intV 2)
+#eval ("tuple-index-mixed", call (tupleV [boolV true, str [97], intV 4]) "index" (args1 (rawStr [97])) == intV 1)
+#eval ("tuple-index-totalized", call (tupleV [boolV true]) "index" (args1 (boolV false)) == intV 0)
+#eval ("invalid-totalization", call (boolV true) "lower" noArgs == noneV)
+#eval ("md5-empty", call (SortVal.«md5Obj(_)_MPY-BUILTINS_Val_IntSeq» (codes [])) "hexdigest" noArgs ==
+  str [100,52,49,100,56,99,100,57,56,102,48,48,98,50,48,52,101,57,56,48,48,57,57,56,101,99,102,56,52,50,55,101])
+#eval ("md5-abc", call (SortVal.«md5Obj(_)_MPY-BUILTINS_Val_IntSeq» (codes [97,98,99])) "hexdigest" noArgs ==
+  str [57,48,48,49,53,48,57,56,51,99,100,50,52,102,98,48,100,54,57,54,51,102,55,100,50,56,101,49,55,102,55,50])
+
+end DispatchChecks
diff --git a//tmp/lean-proc-self.c b//tmp/lean-proc-self.c
new file mode 100644
index 0000000000000000000000000000000000000000..dda5a647fc69eaedae5ee123735ba1e9606378df
--- /dev/null
+++ b//tmp/lean-proc-self.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn real_readlink;
+  if (!real_readlink)
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  if (path && strncmp(path, "/proc/", 6) == 0) {
+    const char *suffix = strrchr(path, '/');
+    if (suffix && strcmp(suffix, "/exe") == 0)
+      return real_readlink("/proc/self/exe", buf, size);
+  }
+  return real_readlink(path, buf, size);
+}
