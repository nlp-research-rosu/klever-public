+def intSeqReverseAux : SortIntSeq → SortIntSeq → SortIntSeq
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», accumulator => accumulator
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail,
+      accumulator =>
