+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», _, _ => emptyCodeSequence
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail, oldCode,
