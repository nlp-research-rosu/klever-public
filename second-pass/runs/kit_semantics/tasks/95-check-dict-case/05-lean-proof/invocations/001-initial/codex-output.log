+def upperCode (code : SortInt) : SortInt :=
+  if isLowerCode code then code - 32 else code
+
+def swapCode (code : SortInt) : SortInt :=
+  if isUpperCode code then code + 32
+  else if isLowerCode code then code - 32
+  else code
+
