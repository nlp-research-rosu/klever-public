+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», right => right
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail, right =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head
+        (intSeqAppend tail right)
+
