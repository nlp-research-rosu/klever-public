+    | some (oldValue, newValue) =>
+        match stringValueCodes? oldValue, stringValueCodes? newValue with
+        | some (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» oldCode
+              SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»),
