+def countSubFuel : Nat → List SortInt → List SortInt → Nat
+  | 0, _, _ => 0
+  | _ + 1, [], _ => 0
+  | fuel + 1, source@(_ :: rest), pattern =>
+      if pattern.isEmpty then
