+    Nat → Nat → UInt32 → UInt32 → UInt32 → UInt32 → Md5State
+  | 0, _, a, b, c, d => ⟨a, b, c, d⟩
+  | fuel + 1, index, a, b, c, d =>
+      let fg : UInt32 × Nat :=
+        if index < 16 then
+          ((b &&& c) ||| (~~~b &&& d), index)
+        else if index < 32 then
+          ((d &&& b) ||| (~~~d &&& c), (5 * index + 1) % 16)
+        else if index < 48 then
+          (b ^^^ c ^^^ d, (3 * index + 5) % 16)
+        else
+          (c ^^^ (b ||| ~~~d), (7 * index) % 16)
