+def listPrefix : List SortInt → List SortInt → SortBool
+  | [], _ => true
+  | _ :: _, [] => false
+  | a :: as, b :: bs => a == b && listPrefix as bs
+
+def countSubFuel : Nat → List SortInt → List SortInt → Nat
+  | 0, _, _ => 0
+  | _ + 1, [], _ => 0
+  | fuel + 1, source@(_ :: rest), pattern =>
