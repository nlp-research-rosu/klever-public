+def md5Block (state : Md5State) (block : List Nat) : Md5State :=
+  let output := md5Rounds block 64 0 state.a state.b state.c state.d
+  ⟨state.a + output.a, state.b + output.b,
+   state.c + output.c, state.d + output.d⟩
