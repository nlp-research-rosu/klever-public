+  | fuel + 1, index, a, b, c, d =>
+      let fg : UInt32 × Nat :=
+        if index < 16 then
+          ((b &&& c) ||| (~~~b &&& d), index)
+        else if index < 32 then
+          ((d &&& b) ||| (~~~d &&& c), (5 * index + 1) % 16)
+        else if index < 48 then
+          (b ^^^ c ^^^ d, (3 * index + 5) % 16)
+        else
+          (c ^^^ (b ||| ~~~d), (7 * index) % 16)
+      let step := a + fg.1 + md5Constant index + md5Word block fg.2
+      md5Rounds block fuel (index + 1) d
