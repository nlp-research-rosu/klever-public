diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..474fdf1c8ef1405e71fe193e499bd11776a61557
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,41 @@
+requires "connection.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  // Complete fixed-semantics result of the exact isinstance call site for an
+  // arbitrary value and arbitrary following computation.
+  claim [isinstance]:
+    <k>
+      #applyK(
+        toCall(builtinV("isinstance")),
+        (V:Val, typeV("str"), .Vals))
+      ~> CONT:K
+      =>
+      isStringKey(V) ~> CONT
+    </k>
+    requires notBool isRefV(V)
+
+  // Fixed string-method behavior over the complete bridge match domain.
+  claim [islower]:
+    <k>
+      #applyK(
+        toCall(boundMethodV(V:Val, "islower")),
+        .Vals)
+      ~> CONT:K
+      =>
+      lowerKeyCodes(stringCodes(V)) ~> CONT
+    </k>
+    requires isStringKey(V) andBool notBool isRefV(V)
+
+  claim [isupper]:
+    <k>
+      #applyK(
+        toCall(boundMethodV(V:Val, "isupper")),
+        .Vals)
+      ~> CONT:K
+      =>
+      upperKeyCodes(stringCodes(V)) ~> CONT
+    </k>
+    requires isStringKey(V) andBool notBool isRefV(V)
+endmodule
