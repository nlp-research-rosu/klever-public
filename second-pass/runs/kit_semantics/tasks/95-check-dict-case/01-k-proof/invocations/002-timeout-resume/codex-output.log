diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fec4a2a8bb45c0fffd5d93b5c15f438f4616002d
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,39 @@
+requires "connection.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  // Complete fixed-semantics result of the exact isinstance call site for an
+  // arbitrary value and arbitrary following computation.
+  claim [isinstance]:
+    <k>
+      #applyK(
+        toCall(builtinV("isinstance")),
+        (V:Val, typeV("str"), .Vals))
+      ~> CONT:K
+      =>
+      isStrV(V) ~> CONT
+    </k>
+    requires notBool isRefV(V)
+
+  // Fixed string-method behavior over the complete Str constructor domain.
+  claim [islower]:
+    <k>
+      #applyK(
+        toCall(boundMethodV(str(CS:IntSeq), "islower")),
+        .Vals)
+      ~> CONT:K
+      =>
+      (hasLower(CS) andBool notBool hasUpper(CS)) ~> CONT
+    </k>
+
+  claim [isupper]:
+    <k>
+      #applyK(
+        toCall(boundMethodV(str(CS:IntSeq), "isupper")),
+        .Vals)
+      ~> CONT:K
+      =>
+      (hasUpper(CS) andBool notBool hasLower(CS)) ~> CONT
+    </k>
+endmodule
diff --git a/connection.k b/connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..708dce6811f10a6989907cf482616214a9d5141c
--- /dev/null
+++ b/connection.k
@@ -0,0 +1,6 @@
+requires "reference-semantics/semantics.k"
+
+// Deliberately bridge-free: this module imports only the frozen MPY semantics.
+module CONNECTION
+  imports MPY
+endmodule
