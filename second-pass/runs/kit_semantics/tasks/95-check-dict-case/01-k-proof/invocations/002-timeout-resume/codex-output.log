+      -1 |-> builtinsScope
+      L |-> scope(
+        "dict" |-> DICT:Val
+        "all_lower" |-> AL:Bool
+        "all_upper" |-> AU:Bool
+        "seen_key" |-> SEEN:Bool
+        "key" |-> (_OLDKEY:Val => ?FINALKEY:Val)
