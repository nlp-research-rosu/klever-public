+      #loop(
+        list(KS:ValSeq),
+        Name("key"),
+        Assign(Name("seen_key"), Bool(true))
+        Assign(
+          Name("is_string"),
+          Call(Name("isinstance"), Name("key"), Name("str")))
+        Assign(
+          Name("all_lower"),
+          BoolOp(
+            "and",
+            Name("all_lower"),
+            Name("is_string"),
+            Call(Attribute(Name("key"), "islower"), .Exprs)))
+        Assign(
+          Name("all_upper"),
+          BoolOp(
+            "and",
+            Name("all_upper"),
+            Name("is_string"),
+            Call(Attribute(Name("key"), "isupper"), .Exprs))))
+      ~> Return(
+           BoolOp(
+             "and",
+             Name("seen_key"),
+             BoolOp("or", Name("all_lower"), Name("all_upper"))))
+      ~> #endcall
+      =>
+      Return(
+        BoolOp(
+          "and",
+          Name("seen_key"),
+          BoolOp("or", Name("all_lower"), Name("all_upper"))))
+      ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+          "dict" |-> DICT:Val
+          "all_lower" |->
+            (AL:Bool => AL andBool allLowerKeys(KS))
+          "all_upper" |->
