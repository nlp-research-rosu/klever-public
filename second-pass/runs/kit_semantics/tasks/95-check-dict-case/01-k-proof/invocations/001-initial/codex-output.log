+      #loop(
+        list(KS:ValSeq),
+        Name("key"),
+        Assign(Name("seen_key"), Bool(true))
+        Assign(
+          Name("is_string"),
+          Call(Name("isinstance"), Name("key"), Name("str")))
+        Assign(
+          Name("all_lower"),
+          BoolOp(
+            "and",
+            Name("all_lower"),
+            Name("is_string"),
+            Call(Attribute(Name("key"), "islower"), .Exprs)))
+        Assign(
