diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ab6be9599d99634c2ac8ed4e68584025704512dd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,47 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Python's str.islower()/str.isupper() predicates in the supplied ASCII
+  // string model, named so the contract summaries remain readable.
+  syntax Bool ::= lowerKeyCodes(IntSeq) [function, total]
+                | upperKeyCodes(IntSeq) [function, total]
+
+  rule lowerKeyCodes(CS:IntSeq)
+    => hasLower(CS) andBool notBool hasUpper(CS)
+  rule upperKeyCodes(CS:IntSeq)
+    => hasUpper(CS) andBool notBool hasLower(CS)
+
+  // Mathematical predicates over every key in a symbolic dictionary key
+  // sequence.  The non-string equations are disjoint from the string cases.
+  syntax Bool ::= allLowerKeys(ValSeq) [function, total]
+                | allUpperKeys(ValSeq) [function, total]
+                | hasAnyKey(ValSeq)    [function, total]
+
+  rule allLowerKeys(.ValSeq) => true
+  rule allLowerKeys(vCons(str(CS:IntSeq), REST:ValSeq))
+    => lowerKeyCodes(CS) andBool allLowerKeys(REST)
+  rule allLowerKeys(vCons(V:Val, _REST:ValSeq)) => false
+    requires notBool isStrV(V)
+
+  rule allUpperKeys(.ValSeq) => true
+  rule allUpperKeys(vCons(str(CS:IntSeq), REST:ValSeq))
+    => upperKeyCodes(CS) andBool allUpperKeys(REST)
+  rule allUpperKeys(vCons(V:Val, _REST:ValSeq)) => false
+    requires notBool isStrV(V)
+
+  rule hasAnyKey(.ValSeq) => false
+  rule hasAnyKey(vCons(_:Val, _:ValSeq)) => true
+
+  // Loop-head summary: AL/AU/SEEN are the three running Bool variables and
+  // KS is the unprocessed suffix.  This is the source contract itself,
+  // parameterized by the mid-loop state.
+  syntax Bool ::= checkCaseSummary(Bool, Bool, Bool, ValSeq)
+                  [function, total]
+  rule checkCaseSummary(AL:Bool, AU:Bool, SEEN:Bool, KS:ValSeq)
+    => (SEEN orBool hasAnyKey(KS))
+       andBool
+       ((AL andBool allLowerKeys(KS))
+        orBool (AU andBool allUpperKeys(KS)))
+endmodule

