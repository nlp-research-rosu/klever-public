+          Assign(Name("all_upper"), Bool(true))
+          Assign(Name("seen_key"), Bool(false))
+          Assign(Name("key"), NoneVal)
+          Assign(Name("is_string"), Bool(false))
+          For(Name("key"), Call(Attribute(Name("dict"), "keys"), .Exprs),
+            Assign(Name("seen_key"), Bool(true))
+            Assign(
+              Name("is_string"),
+              Call(Name("isinstance"), Name("key"), Name("str")))
+            Assign(
+              Name("all_lower"),
+              BoolOp(
+                "and",
+                Name("all_lower"),
+                Name("is_string"),
+                Call(Attribute(Name("key"), "islower"), .Exprs)))
+            Assign(
+              Name("all_upper"),
+              BoolOp(
+                "and",
+                Name("all_upper"),
+                Name("is_string"),
+                Call(Attribute(Name("key"), "isupper"), .Exprs))))
+          Return(
+            BoolOp(
+              "and",
+              Name("seen_key"),
+              BoolOp("or", Name("all_lower"), Name("all_upper")))))
+        Assign(
+          Name("result"),
+          Call(
+            Name("check_dict_case"),
+            dictV(KS:ValSeq, VALUES:ValSeq)))))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope)
+      =>
+      ( 0 |-> scope(
+          "check_dict_case" |->
+            closureVal(
+              ("dict", .ParamNames),
+              Assign(Name("all_lower"), Bool(true))
+              Assign(Name("all_upper"), Bool(true))
+              Assign(Name("seen_key"), Bool(false))
+              Assign(Name("key"), NoneVal)
+              Assign(Name("is_string"), Bool(false))
+              For(Name("key"), Call(Attribute(Name("dict"), "keys"), .Exprs),
+                Assign(Name("seen_key"), Bool(true))
+                Assign(
+                  Name("is_string"),
+                  Call(Name("isinstance"), Name("key"), Name("str")))
+                Assign(
+                  Name("all_lower"),
+                  BoolOp(
+                    "and",
+                    Name("all_lower"),
+                    Name("is_string"),
+                    Call(Attribute(Name("key"), "islower"), .Exprs)))
+                Assign(
+                  Name("all_upper"),
+                  BoolOp(
+                    "and",
+                    Name("all_upper"),
+                    Name("is_string"),
+                    Call(Attribute(Name("key"), "isupper"), .Exprs))))
+              Return(
+                BoolOp(
+                  "and",
+                  Name("seen_key"),
+                  BoolOp("or", Name("all_lower"), Name("all_upper")))),
+              0)
+          "result" |-> checkCaseSummary(true, true, false, KS),
+          parent(-1))
+        -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(KS) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
