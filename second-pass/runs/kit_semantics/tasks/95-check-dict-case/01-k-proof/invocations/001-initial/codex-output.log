+                BoolOp(
+                  "and",
+                  Name("seen_key"),
+                  BoolOp("or", Name("all_lower"), Name("all_upper")))),
+              0)
+          "result" |-> checkCaseSummary(true, true, false, KS),
+          parent(-1))
+        -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(KS) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
