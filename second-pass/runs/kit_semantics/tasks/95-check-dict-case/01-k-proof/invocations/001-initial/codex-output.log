+             Name("seen_key"),
+             BoolOp("or", Name("all_lower"), Name("all_upper"))))
+      ~> #endcall
+      =>
+      Return(
+        BoolOp(
+          "and",
+          Name("seen_key"),
+          BoolOp("or", Name("all_lower"), Name("all_upper"))))
+      ~> #endcall
+    </k>
+    <env> L:Int </env>
