+    <k>
+      #loop(
+        list(KS:ValSeq),
+        Name("key"),
+        Assign(Name("seen_key"), Bool(true))
+        If(
+          Call(Name("isinstance"), Name("key"), Name("str")),
+          Assign(
+            Name("all_lower"),
+            BoolOp(
+              "and",
+              Name("all_lower"),
+              Call(Attribute(Name("key"), "islower"), .Exprs)))
+          Assign(
+            Name("all_upper"),
+            BoolOp(
+              "and",
+              Name("all_upper"),
+              Call(Attribute(Name("key"), "isupper"), .Exprs))),
+          Assign(Name("all_lower"), Bool(false))
+          Assign(Name("all_upper"), Bool(false))))
+      =>
+      .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+          "dict" |-> DICT:Val
+          "all_lower" |->
+            (AL:Bool => AL andBool allLowerKeys(KS))
+          "all_upper" |->
+            (AU:Bool => AU andBool allUpperKeys(KS))
+          "seen_key" |->
+            (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+          "key" |-> (OLDKEY:Val => ?FINALKEY:Val),
+          parent(0))
+    </scopes>
+    <scopeLoc> SCOPELOC:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires L >=Int 1
+
