+                 [function, total, symbol(projectStrTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Str)
+    => ({ definedProjectStr(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectStrTotal(V:Val) => {V}:>Str
+    requires definedProjectStr(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Str => projectStrTotal(V)
+    requires definedProjectStr(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectStrTotal(S:Str) => S [simplification]
+  rule projectStrTotal(projectStrTotal(V:Val))
+    => projectStrTotal(V)
+    [simplification]
+
+  // Str has exactly the str(IntSeq) constructor in MPY.  This guarded code
+  // projection is therefore the exact constructor field of projectStrTotal.
+  syntax IntSeq ::= strCodesTotal(Val)
+                    [function, total, symbol(strCodesTotal), no-evaluators]
+  rule strCodesTotal(str(CS:IntSeq)) => CS [simplification]
+  rule projectStrTotal(V:Val) => str(strCodesTotal(V))
+    requires definedProjectStr(V)
+    [simplification]
+
+  // Python's str.islower()/str.isupper() predicates in the supplied ASCII
+  // string model, named so the contract summaries remain readable.
+  syntax Bool ::= lowerKeyCodes(IntSeq) [function, total]
+                | upperKeyCodes(IntSeq) [function, total]
+
+  rule lowerKeyCodes(CS:IntSeq)
+    => hasLower(CS) andBool notBool hasUpper(CS)
+  rule upperKeyCodes(CS:IntSeq)
+    => hasUpper(CS) andBool notBool hasLower(CS)
+
+  // Mathematical predicates over every key in a symbolic dictionary key
+  // sequence.  The non-string equations are disjoint from the string cases.
+  syntax Bool ::= allLowerKeys(ValSeq) [function, total]
+                | allUpperKeys(ValSeq) [function, total]
+                | hasAnyKey(ValSeq)    [function, total]
+
+  rule allLowerKeys(.ValSeq) => true
+  rule allLowerKeys(vCons(str(CS:IntSeq), REST:ValSeq))
+    => lowerKeyCodes(CS) andBool allLowerKeys(REST)
+  rule allLowerKeys(vCons(V:Val, REST:ValSeq))
+    => lowerKeyCodes(strCodesTotal(V)) andBool allLowerKeys(REST)
+    requires definedProjectStr(V)
