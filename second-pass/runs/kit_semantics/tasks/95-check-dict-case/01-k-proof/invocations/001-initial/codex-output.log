+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      (ListItem(frame(CONT, CALLER, L)) STACK:List) => STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires L >=Int 1
+
