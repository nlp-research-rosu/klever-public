+    => lowerKeyCodes(strCodesTotal(V))
+    requires definedProjectStr(V)
+    [simplification]
+  rule applyMethod(V:Val, "isupper", .Vals)
+    => upperKeyCodes(strCodesTotal(V))
+    requires definedProjectStr(V)
+    [simplification]
+
+  // The frozen builtin returns isStrV(V).  These guarded dispatch twins expose
+  // that same Boolean as a constructor after lookup and argument evaluation.
+  rule <k> #applyK(
+              toCall(builtinV("isinstance")),
+              (V:Val, typeV("str"), .Vals))
+        => true ... </k>
+    requires definedProjectStr(V)
+    [priority(40)]
+  rule <k> #applyK(
+              toCall(builtinV("isinstance")),
+              (V:Val, typeV("str"), .Vals))
+        => false ... </k>
+    requires notBool definedProjectStr(V)
+    [priority(40)]
+endmodule

codex
The total-tag dispatch is no longer stopping at `isStrV(V)`; the invariant proof is exploring the resulting true/false and accumulator branches. It is taking materially longer than prior stuck runs, so I’m letting this unbounded proof continue while watching for either `#Top` or a new stable residual.
