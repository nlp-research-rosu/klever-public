+def check_dict_case(dict):
+    all_lower = True
+    all_upper = True
+    seen_key = False
+    key = None
+    is_string = False
+
+    for key in dict.keys():
+        seen_key = True
+        is_string = isinstance(key, str)
+        all_lower = all_lower and is_string and key.islower()
+        all_upper = all_upper and is_string and key.isupper()
+
+    return seen_key and (all_lower or all_upper)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5e099331d2b5998090d6a1c545f8c24520b21909
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,165 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The coinductive invariant consumes exactly the fixed semantics' stable
+  // #loop term, preserves its continuation, and summarizes the three locals.
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(KS:ValSeq),
+        Name("key"),
+        Assign(Name("seen_key"), Bool(true))
+        Assign(
+          Name("is_string"),
+          Call(Name("isinstance"), Name("key"), Name("str")))
+        Assign(
+          Name("all_lower"),
+          BoolOp(
+            "and",
+            Name("all_lower"),
+            Name("is_string"),
+            Call(Attribute(Name("key"), "islower"), .Exprs)))
+        Assign(
+          Name("all_upper"),
+          BoolOp(
+            "and",
+            Name("all_upper"),
+            Name("is_string"),
+            Call(Attribute(Name("key"), "isupper"), .Exprs))))
+      ~> Return(
+           BoolOp(
+             "and",
+             Name("seen_key"),
+             BoolOp("or", Name("all_lower"), Name("all_upper"))))
+      ~> #endcall
+      =>
+      Return(
+        BoolOp(
+          "and",
+          Name("seen_key"),
+          BoolOp("or", Name("all_lower"), Name("all_upper"))))
+      ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+          "dict" |-> DICT:Val
+          "all_lower" |->
+            (AL:Bool => AL andBool allLowerKeys(KS))
+          "all_upper" |->
+            (AU:Bool => AU andBool allUpperKeys(KS))
+          "seen_key" |->
+            (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+          "key" |-> (OLDKEY:Val => lastKeyAfter(OLDKEY, KS))
+          "is_string" |->
+            (OLDISSTRING:Bool => lastStringFlagAfter(OLDISSTRING, KS)),
+          parent(0))
+    </scopes>
+    <scopeLoc> SCOPELOC:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires L >=Int 1
+
+  // Full entry-point theorem.  The actual translated body is loaded, looked
+  // up by its public name, called with an arbitrary symbolic dictV, and its
+  // return is assigned to result.
+  claim [target]:
+    <k>
+      #loadAll(Module(
+        FuncDef("check_dict_case", Params("dict"),
+          Assign(Name("all_lower"), Bool(true))
+          Assign(Name("all_upper"), Bool(true))
+          Assign(Name("seen_key"), Bool(false))
+          Assign(Name("key"), NoneVal)
+          Assign(Name("is_string"), Bool(false))
+          For(Name("key"), Call(Attribute(Name("dict"), "keys"), .Exprs),
+            Assign(Name("seen_key"), Bool(true))
+            Assign(
+              Name("is_string"),
+              Call(Name("isinstance"), Name("key"), Name("str")))
+            Assign(
+              Name("all_lower"),
+              BoolOp(
+                "and",
+                Name("all_lower"),
+                Name("is_string"),
+                Call(Attribute(Name("key"), "islower"), .Exprs)))
+            Assign(
+              Name("all_upper"),
+              BoolOp(
+                "and",
+                Name("all_upper"),
+                Name("is_string"),
+                Call(Attribute(Name("key"), "isupper"), .Exprs))))
+          Return(
+            BoolOp(
+              "and",
+              Name("seen_key"),
+              BoolOp("or", Name("all_lower"), Name("all_upper")))))
+        Assign(
+          Name("result"),
+          Call(
+            Name("check_dict_case"),
+            dictV(KS:ValSeq, VALUES:ValSeq)))))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope)
+      =>
+      ( 0 |-> scope(
+          "check_dict_case" |->
+            closureVal(
+              ("dict", .ParamNames),
+              Assign(Name("all_lower"), Bool(true))
+              Assign(Name("all_upper"), Bool(true))
+              Assign(Name("seen_key"), Bool(false))
+              Assign(Name("key"), NoneVal)
+              Assign(Name("is_string"), Bool(false))
+              For(Name("key"), Call(Attribute(Name("dict"), "keys"), .Exprs),
+                Assign(Name("seen_key"), Bool(true))
+                Assign(
+                  Name("is_string"),
+                  Call(Name("isinstance"), Name("key"), Name("str")))
+                Assign(
+                  Name("all_lower"),
+                  BoolOp(
+                    "and",
+                    Name("all_lower"),
+                    Name("is_string"),
+                    Call(Attribute(Name("key"), "islower"), .Exprs)))
+                Assign(
+                  Name("all_upper"),
+                  BoolOp(
+                    "and",
+                    Name("all_upper"),
+                    Name("is_string"),
+                    Call(Attribute(Name("key"), "isupper"), .Exprs))))
+              Return(
+                BoolOp(
+                  "and",
+                  Name("seen_key"),
+                  BoolOp("or", Name("all_lower"), Name("all_upper")))),
+              0)
+          "result" |-> checkCaseSummary(true, true, false, KS),
+          parent(-1))
+        -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(KS) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
