+      #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+      ~> Return(checkDictReturn()) ~> #endcall
+      =>
+      Return(checkDictReturn()) ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+        "dict" |-> DICT:Val
+        "all_lower" |-> (true => allLowerKeys(KS))
+        "all_upper" |-> (true => allUpperKeys(KS))
+        "seen_key" |-> (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+        "key" |-> (OLDKEY:Val => lastKeyAfter(OLDKEY, KS))
+        "is_string" |->
+          (OLDISSTRING:Bool => lastStringFlagAfter(OLDISSTRING, KS)),
+        parent(0))
+    </scopes>
+    requires L >=Int 1
+
+  claim [loop-tf]:
+    <k>
+      #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+      ~> Return(checkDictReturn()) ~> #endcall
+      =>
+      Return(checkDictReturn()) ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+        "dict" |-> DICT:Val
+        "all_lower" |-> (true => allLowerKeys(KS))
+        "all_upper" |-> false
+        "seen_key" |-> (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+        "key" |-> (OLDKEY:Val => lastKeyAfter(OLDKEY, KS))
+        "is_string" |->
+          (OLDISSTRING:Bool => lastStringFlagAfter(OLDISSTRING, KS)),
+        parent(0))
+    </scopes>
+    requires L >=Int 1
+
+  claim [loop-ft]:
+    <k>
+      #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+      ~> Return(checkDictReturn()) ~> #endcall
+      =>
+      Return(checkDictReturn()) ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+        "dict" |-> DICT:Val
+        "all_lower" |-> false
+        "all_upper" |-> (true => allUpperKeys(KS))
+        "seen_key" |-> (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+        "key" |-> (OLDKEY:Val => lastKeyAfter(OLDKEY, KS))
+        "is_string" |->
+          (OLDISSTRING:Bool => lastStringFlagAfter(OLDISSTRING, KS)),
+        parent(0))
+    </scopes>
+    requires L >=Int 1
+
+  claim [loop-ff]:
+    <k>
+      #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+      ~> Return(checkDictReturn()) ~> #endcall
+      =>
+      Return(checkDictReturn()) ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
