diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f39810f85714a78b0518eef5c8ebc6e2ef2e1cf9
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,196 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Coinductive invariant family over the four concrete accumulator states.
+  // Each member consumes the exact #loop cutpoint and preserves its suffix.
+  claim [loop-tt]:
+    <k>
+      #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+      ~> Return(checkDictReturn()) ~> #endcall
+      =>
+      Return(checkDictReturn()) ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+        "dict" |-> DICT:Val
+        "all_lower" |-> (true => allLowerKeys(KS))
+        "all_upper" |-> (true => allUpperKeys(KS))
+        "seen_key" |-> (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+        "key" |-> (_OLDKEY:Val => ?FINALKEY:Val)
+        "is_string" |-> (_OLDISSTRING:Bool => ?FINALISSTRING:Bool),
+        parent(0))
+    </scopes>
+    requires L >=Int 1
+
+  claim [loop-tf]:
+    <k>
+      #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+      ~> Return(checkDictReturn()) ~> #endcall
+      =>
+      Return(checkDictReturn()) ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+        "dict" |-> DICT:Val
+        "all_lower" |-> (true => allLowerKeys(KS))
+        "all_upper" |-> false
+        "seen_key" |-> (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+        "key" |-> (_OLDKEY:Val => ?FINALKEY:Val)
+        "is_string" |-> (_OLDISSTRING:Bool => ?FINALISSTRING:Bool),
+        parent(0))
+    </scopes>
+    requires L >=Int 1
+
+  claim [loop-ft]:
+    <k>
+      #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+      ~> Return(checkDictReturn()) ~> #endcall
+      =>
+      Return(checkDictReturn()) ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+        "dict" |-> DICT:Val
+        "all_lower" |-> false
+        "all_upper" |-> (true => allUpperKeys(KS))
+        "seen_key" |-> (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+        "key" |-> (_OLDKEY:Val => ?FINALKEY:Val)
+        "is_string" |-> (_OLDISSTRING:Bool => ?FINALISSTRING:Bool),
+        parent(0))
+    </scopes>
+    requires L >=Int 1
+
+  claim [loop-ff]:
+    <k>
+      #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+      ~> Return(checkDictReturn()) ~> #endcall
+      =>
+      Return(checkDictReturn()) ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      0 |-> scope("check_dict_case" |-> FUNCTION:Val, parent(-1))
+      -1 |-> builtinsScope
+      L |-> scope(
+        "dict" |-> DICT:Val
+        "all_lower" |-> false
+        "all_upper" |-> false
+        "seen_key" |-> (SEEN:Bool => SEEN orBool hasAnyKey(KS))
+        "key" |-> (_OLDKEY:Val => ?FINALKEY:Val)
+        "is_string" |-> (_OLDISSTRING:Bool => ?FINALISSTRING:Bool),
+        parent(0))
+    </scopes>
+    requires L >=Int 1
+
+  // Full entry-point theorem.  The actual translated body is loaded, looked
+  // up by its public name, called with an arbitrary symbolic dictV, and its
+  // return is assigned to result.
+  claim [target]:
+    <k>
+      #loadAll(Module(
+        FuncDef("check_dict_case", Params("dict"),
+          Assign(Name("all_lower"), Bool(true))
+          Assign(Name("all_upper"), Bool(true))
+          Assign(Name("seen_key"), Bool(false))
+          Assign(Name("key"), NoneVal)
+          Assign(Name("is_string"), Bool(false))
+          For(Name("key"), Call(Attribute(Name("dict"), "keys"), .Exprs),
+            Assign(Name("seen_key"), Bool(true))
+            Assign(
+              Name("is_string"),
+              BoolOp(
+                "and",
+                BoolOp("or", Name("all_lower"), Name("all_upper")),
+                Call(Name("isinstance"), Name("key"), Name("str"))))
+            Assign(
+              Name("all_lower"),
+              BoolOp(
+                "and",
+                Name("all_lower"),
+                Name("is_string"),
+                Call(Attribute(Name("key"), "islower"), .Exprs)))
+            Assign(
+              Name("all_upper"),
+              BoolOp(
+                "and",
+                Name("all_upper"),
+                Name("is_string"),
+                Call(Attribute(Name("key"), "isupper"), .Exprs))))
+          Return(
+            BoolOp(
+              "and",
+              Name("seen_key"),
+              BoolOp("or", Name("all_lower"), Name("all_upper")))))
+        Assign(
+          Name("result"),
+          Call(
+            Name("check_dict_case"),
+            dictV(KS:ValSeq, VALUES:ValSeq)))))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope)
+      =>
+      ( 0 |-> scope(
+          "check_dict_case" |->
+            closureVal(
+              ("dict", .ParamNames),
+              Assign(Name("all_lower"), Bool(true))
+              Assign(Name("all_upper"), Bool(true))
+              Assign(Name("seen_key"), Bool(false))
+              Assign(Name("key"), NoneVal)
+              Assign(Name("is_string"), Bool(false))
+              For(Name("key"), Call(Attribute(Name("dict"), "keys"), .Exprs),
+                Assign(Name("seen_key"), Bool(true))
+                Assign(
+                  Name("is_string"),
+                  BoolOp(
+                    "and",
+                    BoolOp("or", Name("all_lower"), Name("all_upper")),
+                    Call(Name("isinstance"), Name("key"), Name("str"))))
+                Assign(
+                  Name("all_lower"),
+                  BoolOp(
+                    "and",
+                    Name("all_lower"),
+                    Name("is_string"),
+                    Call(Attribute(Name("key"), "islower"), .Exprs)))
+                Assign(
+                  Name("all_upper"),
+                  BoolOp(
+                    "and",
+                    Name("all_upper"),
+                    Name("is_string"),
+                    Call(Attribute(Name("key"), "isupper"), .Exprs))))
+              Return(
+                BoolOp(
+                  "and",
+                  Name("seen_key"),
+                  BoolOp("or", Name("all_lower"), Name("all_upper")))),
+              0)
+          "result" |-> checkCaseSummary(true, true, false, KS),
+          parent(-1))
+        -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(KS) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6f7db5756d0b72bd36e704e72690767a6bcd0527
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,164 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Definitional AST aliases used by the invariant family.  They expand to
+  // the literal translated loop body and return expression.
+  syntax Stmts ::= checkDictLoopBody() [function, total]
+  rule checkDictLoopBody()
+    => Assign(Name("seen_key"), Bool(true))
+       Assign(
+         Name("is_string"),
+         BoolOp(
+           "and",
+           BoolOp("or", Name("all_lower"), Name("all_upper")),
+           Call(Name("isinstance"), Name("key"), Name("str"))))
+       Assign(
+         Name("all_lower"),
+         BoolOp(
+           "and",
+           Name("all_lower"),
+           Name("is_string"),
+           Call(Attribute(Name("key"), "islower"), .Exprs)))
+       Assign(
+         Name("all_upper"),
+         BoolOp(
+           "and",
+           Name("all_upper"),
+           Name("is_string"),
+           Call(Attribute(Name("key"), "isupper"), .Exprs)))
+
+  syntax Expr ::= checkDictReturn() [function, total]
+  rule checkDictReturn()
+    => BoolOp(
+         "and",
+         Name("seen_key"),
+         BoolOp("or", Name("all_lower"), Name("all_upper")))
+
+  // Guarded total projection used only where the fixed isStrV predicate holds.
+  // It refines the semantics' dynamic Val sort without inventing a value.
+  syntax Bool ::= definedProjectStr(Val)
+                  [function, total, symbol(definedProjectStr), no-evaluators]
+  rule definedProjectStr(str(_:IntSeq)) => true [concrete]
+  rule definedProjectStr(_:Val) => false [owise, concrete]
+
+  // The frozen definition gives isStrV one str equation and an [owise]
+  // equation for every other Val, so it is defined on the complete Val sort
+  // even though its declaration omits the [total] attribute.
+  rule #Ceil(isStrV(@V:Val)) => #Ceil(@V) [simplification]
+
+  syntax Str ::= projectStrTotal(Val)
+                 [function, total, symbol(projectStrTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Str)
+    => ({ definedProjectStr(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectStrTotal(V:Val) => {V}:>Str
+    requires definedProjectStr(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Str => projectStrTotal(V)
+    requires definedProjectStr(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectStrTotal(S:Str) => S [simplification]
+  rule projectStrTotal(projectStrTotal(V:Val))
+    => projectStrTotal(V)
+    [simplification]
+
+  // Str has exactly the str(IntSeq) constructor in MPY.  This guarded code
+  // projection is therefore the exact constructor field of projectStrTotal.
+  syntax IntSeq ::= strCodesTotal(Val)
+                    [function, total, symbol(strCodesTotal), no-evaluators]
+  rule strCodesTotal(str(CS:IntSeq)) => CS [simplification]
+  rule projectStrTotal(V:Val) => str(strCodesTotal(V))
+    requires definedProjectStr(V)
+    [simplification]
+
+  // Python's str.islower()/str.isupper() predicates in the supplied ASCII
+  // string model, named so the contract summaries remain readable.
+  syntax Bool ::= lowerKeyCodes(IntSeq) [function, total]
+                | upperKeyCodes(IntSeq) [function, total]
+
+  rule lowerKeyCodes(CS:IntSeq)
+    => hasLower(CS) andBool notBool hasUpper(CS)
+  rule upperKeyCodes(CS:IntSeq)
+    => hasUpper(CS) andBool notBool hasLower(CS)
+
+  // Mathematical predicates over every key in a symbolic dictionary key
+  // sequence.  The non-string equations are disjoint from the string cases.
+  syntax Bool ::= allLowerKeys(ValSeq) [function, total]
+                | allUpperKeys(ValSeq) [function, total]
+                | hasAnyKey(ValSeq)    [function, total]
+
+  rule allLowerKeys(.ValSeq) => true
+  rule allLowerKeys(vCons(str(CS:IntSeq), REST:ValSeq))
+    => lowerKeyCodes(CS) andBool allLowerKeys(REST)
+  rule allLowerKeys(vCons(V:Val, REST:ValSeq))
+    => lowerKeyCodes(strCodesTotal(V)) andBool allLowerKeys(REST)
+    requires definedProjectStr(V)
+    [simplification]
+  rule allLowerKeys(vCons(V:Val, _REST:ValSeq)) => false
+    requires notBool definedProjectStr(V)
+
+  rule allUpperKeys(.ValSeq) => true
+  rule allUpperKeys(vCons(str(CS:IntSeq), REST:ValSeq))
+    => upperKeyCodes(CS) andBool allUpperKeys(REST)
+  rule allUpperKeys(vCons(V:Val, REST:ValSeq))
+    => upperKeyCodes(strCodesTotal(V)) andBool allUpperKeys(REST)
+    requires definedProjectStr(V)
+    [simplification]
+  rule allUpperKeys(vCons(V:Val, _REST:ValSeq)) => false
+    requires notBool definedProjectStr(V)
+
+  rule hasAnyKey(.ValSeq) => false
+  rule hasAnyKey(vCons(_:Val, _:ValSeq)) => true
+
+  // Exact final values of the two auxiliary loop locals.
+  syntax Val ::= lastKeyAfter(Val, ValSeq) [function, total]
+  rule lastKeyAfter(OLD:Val, .ValSeq) => OLD
+  rule lastKeyAfter(_OLD:Val, vCons(V:Val, REST:ValSeq))
+    => lastKeyAfter(V, REST)
+
+  syntax Bool ::= lastStringFlagAfter(Bool, ValSeq) [function, total]
+  rule lastStringFlagAfter(OLD:Bool, .ValSeq) => OLD
+  rule lastStringFlagAfter(_OLD:Bool, vCons(V:Val, REST:ValSeq))
+    => lastStringFlagAfter(definedProjectStr(V), REST)
+
+  // Loop-head summary: AL/AU/SEEN are the three running Bool variables and
+  // KS is the unprocessed suffix.  This is the source contract itself,
+  // parameterized by the mid-loop state.
+  syntax Bool ::= checkCaseSummary(Bool, Bool, Bool, ValSeq)
+                  [function, total]
+  rule checkCaseSummary(AL:Bool, AU:Bool, SEEN:Bool, KS:ValSeq)
+    => (SEEN orBool hasAnyKey(KS))
+       andBool
+       ((AL andBool allLowerKeys(KS))
+        orBool (AU andBool allUpperKeys(KS)))
+
+  // String-method dispatch twins restate the frozen equations over a dynamic
+  // Val under the exact string guard.
+  rule applyMethod(V:Val, "islower", .Vals)
+    => lowerKeyCodes(strCodesTotal(V))
+    requires definedProjectStr(V)
+    [simplification]
+  rule applyMethod(V:Val, "isupper", .Vals)
+    => upperKeyCodes(strCodesTotal(V))
+    requires definedProjectStr(V)
+    [simplification]
+
+  // The frozen builtin returns isStrV(V).  These guarded dispatch twins expose
+  // that same Boolean as a constructor after lookup and argument evaluation.
+  rule <k> #applyK(
+              toCall(builtinV("isinstance")),
+              (V:Val, typeV("str"), .Vals))
+        => true ... </k>
+    requires definedProjectStr(V)
+    [priority(40)]
+  rule <k> #applyK(
+              toCall(builtinV("isinstance")),
+              (V:Val, typeV("str"), .Vals))
+        => false ... </k>
+    requires notBool definedProjectStr(V)
+    [priority(40)]
+endmodule

