+          "all_lower" |-> AL
+          "all_upper" |-> AU
+          "seen_key" |-> SEEN
+          "key" |-> OLDKEY:Val,
+          parent(0)))
+      =>
+      ( 0 |-> scope(MODULE, parent(-1))
+        -1 |-> builtinsScope
+        L |-> scope(
+          "dict" |-> DICT
+          "all_lower" |-> AL
+          "all_upper" |-> AU
+          "seen_key" |-> SEEN
+          "key" |-> OLDKEY,
+          parent(0)))
+      [ L <- undef ]
+    </scopes>
