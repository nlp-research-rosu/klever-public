+def check_dict_case(dict):
+    all_lower = True
+    all_upper = True
+    seen_key = False
+    key = None
+
+    for key in dict.keys():
+        seen_key = True
+        all_lower = all_lower and isinstance(key, str) and key.islower()
+        all_upper = all_upper and isinstance(key, str) and key.isupper()
