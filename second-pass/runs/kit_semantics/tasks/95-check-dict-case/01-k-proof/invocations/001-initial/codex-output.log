+                BoolOp(
+                  "and",
+                  Name("all_lower"),
+                  Call(Attribute(Name("key"), "islower"), )))
+              Assign(
+                Name("all_upper"),
+                BoolOp(
+                  "and",
+                  Name("all_upper"),
+                  Call(Attribute(Name("key"), "isupper"), ))),
+              Assign(Name("all_lower"), Bool(false))
+              Assign(Name("all_upper"), Bool(false))))
+          Return(
+            BoolOp(
+              "and",
+              Name("seen_key"),
+              BoolOp("or", Name("all_lower"), Name("all_upper")))))
+        Assign(
+          Name("result"),
+          Call(
+            Name("check_dict_case"),
+            dictV(KS:ValSeq, VALUES:ValSeq)))))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope)
+      =>
+      ( 0 |-> scope(
+          "check_dict_case" |->
