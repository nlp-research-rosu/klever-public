+            BoolOp(
+              "and",
+              Name("all_lower"),
+              Call(Attribute(Name("key"), "islower"), .Exprs)))
+          Assign(
+            Name("all_upper"),
+            BoolOp(
+              "and",
+              Name("all_upper"),
+              Call(Attribute(Name("key"), "isupper"), .Exprs))),
+          Assign(Name("all_lower"), Bool(false))
+          Assign(Name("all_upper"), Bool(false))))
+      ~> Return(
+           BoolOp(
+             "and",
+             Name("seen_key"),
+             BoolOp("or", Name("all_lower"), Name("all_upper"))))
+      ~> #endcall
+      =>
+      checkCaseSummary(AL:Bool, AU:Bool, SEEN:Bool, KS)
+      ~> CONT:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      ( 0 |-> scope(MODULE:Map, parent(-1))
+        -1 |-> builtinsScope
+        L |-> scope(
