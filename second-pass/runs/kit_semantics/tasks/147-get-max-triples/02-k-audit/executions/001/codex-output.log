     5	
     6	def get_max_triples(n):
     7	    """
     8	    You are given a positive integer n. You have to create an integer array a of length n.
     9	        For each i (1 ≤ i ≤ n), the value of a[i] = i * i - i + 1.
    10	        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, 
    11	    and a[i] + a[j] + a[k] is a multiple of 3.
    12	
    13	    Example :
    14	        Input: n = 5
    15	        Output: 1
    16	        Explanation: 
    17	        a = [1, 3, 7, 13, 21]
    18	        The only valid triple is (1, 7, 13).
    19	    """
    20	    A = [i*i - i + 1 for i in range(1,n+1)]
    21	    ans = []
    22	    for i in range(n):
    23	        for j in range(i+1,n):
    24	            for k in range(j+1,n):
    25	                if (A[i]+A[j]+A[k])%3 == 0:
    26	                    ans += [(A[i],A[j],A[k])]
    27	    return len(ans)

===== /candidate/solution.py =====
     1	def get_max_triples(n):
     2	    divisible_by_three = (n + 1) // 3
     3	    not_divisible_by_three = n - divisible_by_three
     4	
     5	    triples_of_divisible = (
     6	        divisible_by_three
     7	        * (divisible_by_three - 1)
     8	        * (divisible_by_three - 2)
     9	        // 6
    10	    )
    11	    triples_of_non_divisible = (
    12	        not_divisible_by_three
    13	        * (not_divisible_by_three - 1)
    14	        * (not_divisible_by_three - 2)
    15	        // 6
    16	    )
    17	    return triples_of_divisible + triples_of_non_divisible

