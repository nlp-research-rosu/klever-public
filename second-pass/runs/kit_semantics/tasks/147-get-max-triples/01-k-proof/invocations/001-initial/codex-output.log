+      => expectedTriples(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "get_max_triples" |->
+          closureVal("n", Return(Int(0)), 0),
+        parent(-1))
+      -1 |-> builtinsScope
