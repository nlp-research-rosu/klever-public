diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..593bc9d7617833899151045d2a854c4fbc110dc3
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,31 @@
+from itertools import combinations
+
+from solution import get_max_triples
+
+
+def brute_force(n):
+    values = [i * i - i + 1 for i in range(1, n + 1)]
+    return sum(
+        1
+        for triple in combinations(values, 3)
+        if sum(triple) % 3 == 0
+    )
+
+
+def main():
+    tested = list(range(1, 101))
+    mismatches = [
+        (n, get_max_triples(n), brute_force(n))
+        for n in tested
+        if get_max_triples(n) != brute_force(n)
+    ]
+    assert get_max_triples(5) == 1
+    assert not mismatches, mismatches
+    print(
+        "oracle=direct array construction + itertools.combinations; "
+        f"inputs=1..100; example_n=5; mismatches={len(mismatches)}"
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..393465ded80702ee3bcf1632ce5607ac10392562
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT-SYNTAX
+
+  syntax Int ::= zeroResidueCount(Int) [function, total]
+               | chooseThree(Int)      [function, total]
+               | expectedTriples(Int)  [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+  imports INT
+
+  // Among 1,...,N, these are the indices congruent to 2 modulo 3.
+  rule zeroResidueCount(N)
+    => ((N +Int 1) -Int pyMod(N +Int 1, 3)) /Int 3
+
+  // This form deliberately mirrors the reference semantics for Python's //.
+  rule chooseThree(X)
+    => (X *Int (X -Int 1) *Int (X -Int 2)
+        -Int pyMod(X *Int (X -Int 1) *Int (X -Int 2), 6)) /Int 6
+
+  rule expectedTriples(N)
+    => chooseThree(zeroResidueCount(N))
+       +Int chooseThree(N -Int zeroResidueCount(N))
+endmodule

diff --git a/check_artifacts.py b/check_artifacts.py
new file mode 100644
index 0000000000000000000000000000000000000000..898d0501de91553d53765c34f991018d36682e61
--- /dev/null
+++ b/check_artifacts.py
@@ -0,0 +1,31 @@
+import ast
+import re
+
+
+def normalized(path):
+    with open(path, encoding="utf-8") as stream:
+        return re.sub(r"\s+", "", stream.read())
+
+
+def only_function(path):
+    with open(path, encoding="utf-8") as stream:
+        tree = ast.parse(stream.read(), filename=path)
+    functions = [node for node in tree.body if isinstance(node, ast.FunctionDef)]
+    assert len(functions) == 1
+    return ast.dump(functions[0], include_attributes=False)
+
+
+solution_term = normalized("solution.mpy")
+prefix = 'Module(FuncDef("get_max_triples",Params("n"),'
+assert solution_term.startswith(prefix)
+assert solution_term.endswith("))")
+body = solution_term[len(prefix):-2]
+
+spec_term = normalized("spec.k")
+assert f'closureVal("n",{body},0)' in spec_term
+assert only_function("solution.py") == only_function("smoke.py")
+
+print(
+    "artifact-identity=PASS; "
+    "solution.mpy body equals spec.k closure body and smoke.py function AST"
+)
