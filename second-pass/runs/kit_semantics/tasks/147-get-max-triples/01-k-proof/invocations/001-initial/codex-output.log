+++ b/spec.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [get-max-triples]:
+    <k>
+      Call(Name("get_max_triples"), Int(N))
+      => expectedTriples(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "get_max_triples" |->
+          closureVal(
+            "n",
+            Assign(
+              Name("divisible_by_three"),
+              BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)))
+            Assign(
+              Name("not_divisible_by_three"),
+              BinOp("-", Name("n"), Name("divisible_by_three")))
+            Assign(
+              Name("triples_of_divisible"),
+              BinOp(
+                "//",
+                BinOp(
+                  "*",
+                  BinOp(
+                    "*",
+                    Name("divisible_by_three"),
+                    BinOp("-", Name("divisible_by_three"), Int(1))),
+                  BinOp("-", Name("divisible_by_three"), Int(2))),
+                Int(6)))
+            Assign(
+              Name("triples_of_non_divisible"),
+              BinOp(
+                "//",
+                BinOp(
+                  "*",
+                  BinOp(
+                    "*",
+                    Name("not_divisible_by_three"),
+                    BinOp("-", Name("not_divisible_by_three"), Int(1))),
+                  BinOp("-", Name("not_divisible_by_three"), Int(2))),
+                Int(6)))
+            Return(
+              BinOp(
+                "+",
+                Name("triples_of_divisible"),
+                Name("triples_of_non_divisible"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+endmodule
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..593bc9d7617833899151045d2a854c4fbc110dc3
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,31 @@
+from itertools import combinations
+
+from solution import get_max_triples
+
+
+def brute_force(n):
+    values = [i * i - i + 1 for i in range(1, n + 1)]
+    return sum(
+        1
+        for triple in combinations(values, 3)
+        if sum(triple) % 3 == 0
+    )
+
+
+def main():
+    tested = list(range(1, 101))
+    mismatches = [
+        (n, get_max_triples(n), brute_force(n))
+        for n in tested
+        if get_max_triples(n) != brute_force(n)
+    ]
+    assert get_max_triples(5) == 1
+    assert not mismatches, mismatches
+    print(
+        "oracle=direct array construction + itertools.combinations; "
+        f"inputs=1..100; example_n=5; mismatches={len(mismatches)}"
+    )
+
+
+if __name__ == "__main__":
+    main()
