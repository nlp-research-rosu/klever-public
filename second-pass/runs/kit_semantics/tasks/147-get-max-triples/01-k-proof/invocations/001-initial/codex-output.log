diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..7b015e3c8a702e27c03502ed8135e93eac559d69
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  claim [changed-body]:
+    <k>
+      Call(Name("get_max_triples"), Int(N))
+      => expectedTriples(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "get_max_triples" |->
+          closureVal("n", Return(Int(0)), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int 4
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..e4631e996131e9a3954ca16b737e0272ab30ffca
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  claim [false-postcondition]:
+    <k>
+      Call(Name("get_max_triples"), Int(N))
+      => expectedTriples(N) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "get_max_triples" |->
+          closureVal(
+            "n",
+            Assign(
+              Name("divisible_by_three"),
+              BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)))
+            Assign(
+              Name("not_divisible_by_three"),
+              BinOp("-", Name("n"), Name("divisible_by_three")))
+            Assign(
+              Name("triples_of_divisible"),
+              BinOp(
+                "//",
+                BinOp(
+                  "*",
+                  BinOp(
+                    "*",
+                    Name("divisible_by_three"),
+                    BinOp("-", Name("divisible_by_three"), Int(1))),
+                  BinOp("-", Name("divisible_by_three"), Int(2))),
+                Int(6)))
+            Assign(
+              Name("triples_of_non_divisible"),
+              BinOp(
+                "//",
+                BinOp(
+                  "*",
+                  BinOp(
+                    "*",
+                    Name("not_divisible_by_three"),
+                    BinOp("-", Name("not_divisible_by_three"), Int(1))),
+                  BinOp("-", Name("not_divisible_by_three"), Int(2))),
+                Int(6)))
+            Return(
+              BinOp(
+                "+",
+                Name("triples_of_divisible"),
+                Name("triples_of_non_divisible"))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int 4
+endmodule
