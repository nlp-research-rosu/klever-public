+                ),
+                "validated_domain_lemma_count": len(
+                    validated["domain_lemmas"]
+                ),
+                "expected_source_rule_ids": expected_ids,
+                "observed_obligation_source_rule_ids": observed_ids,
+                "target_statement": target,
+            },
+            "checks": checks,
+            "all_checks_pass": all(checks.values()),
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)

