    10	endmodule
    11	
    12	module VERIFICATION
    13	  imports VERIFICATION-SYNTAX
    14	  imports MPY
    15	  imports INT
    16	
    17	  // Among 1,...,N, these are the indices congruent to 2 modulo 3.
    18	  rule zeroResidueCount(N)
    19	    => ((N +Int 1) -Int pyMod(N +Int 1, 3)) /Int 3
    20	
    21	  // This form deliberately mirrors the reference semantics for Python's //.
    22	  rule chooseThree(X)
    23	    => (X *Int (X -Int 1) *Int (X -Int 2)
    24	        -Int pyMod(X *Int (X -Int 1) *Int (X -Int 2), 6)) /Int 6
    25	
    26	  rule expectedTriples(N)
    27	    => chooseThree(zeroResidueCount(N))
    28	       +Int chooseThree(N -Int zeroResidueCount(N))
    29	endmodule
