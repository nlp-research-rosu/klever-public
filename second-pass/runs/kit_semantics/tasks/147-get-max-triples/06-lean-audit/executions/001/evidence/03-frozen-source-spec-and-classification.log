solution.py
     1	def get_max_triples(n):
     2	    divisible_by_three = (n + 1) // 3
     3	    not_divisible_by_three = n - divisible_by_three
     4	
     5	    triples_of_divisible = (
     6	        divisible_by_three
     7	        * (divisible_by_three - 1)
     8	        * (divisible_by_three - 2)
     9	        // 6
    10	    )
    11	    triples_of_non_divisible = (
    12	        not_divisible_by_three
    13	        * (not_divisible_by_three - 1)
    14	        * (not_divisible_by_three - 2)
    15	        // 6
    16	    )
    17	    return triples_of_divisible + triples_of_non_divisible
