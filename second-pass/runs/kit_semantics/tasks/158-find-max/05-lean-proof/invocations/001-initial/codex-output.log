+def compareIntegers
+    (operator : SortString) (left right : SortInt) : SortBool :=
+  if operator = "<" then decide (left < right)
+  else if operator = "<=" then decide (left <= right)
+  else if operator = ">" then decide (left > right)
+  else if operator = ">=" then decide (left >= right)
+  else if operator = "==" then left == right
+  else if operator = "!=" then !(left == right)
+  else false
