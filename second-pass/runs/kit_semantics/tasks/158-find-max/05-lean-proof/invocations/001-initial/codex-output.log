+def decimalFold : SortIntSeq → SortInt → SortInt
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», acc => acc
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» code rest, acc =>
+      decimalFold rest (acc * 10 + (code - 48))
