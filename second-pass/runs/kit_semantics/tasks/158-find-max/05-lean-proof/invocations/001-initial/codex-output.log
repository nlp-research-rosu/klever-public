+      0
+    else
+      let significand := (2 ^ 52) + fraction
+      if exponentBits >= 1023 + 52 then
+        significand * (2 ^ (exponentBits - 1023 - 52))
+      else if exponentBits >= 1023 then
+        significand / (2 ^ (52 - (exponentBits - 1023)))
+      else
