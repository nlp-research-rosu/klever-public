+def characterListToCodes : List Char → SortIntSeq
+  | [] => emptyCodes
+  | char :: rest =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+        (Int.ofNat char.toNat) (characterListToCodes rest)
