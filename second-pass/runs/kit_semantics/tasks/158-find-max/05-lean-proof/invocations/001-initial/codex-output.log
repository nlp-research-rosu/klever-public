+  SortVal.«setV(_)_MPY-SET_Val_IntSeq» (codes "ab")
+#eval builtin "len" [listValue [int 1, int 2, int 3]] == int 3
+#eval builtin "abs" [int (-7)] == int 7
+#eval builtin "max" [int 2, int 9, int 4] == int 9
+#eval builtin "min" [int 2, int (-9), int 4] == int (-9)
+#eval builtin "bin" [int 0] == str "0b0"
+#eval builtin "bin" [int 6] == str "0b110"
+#eval builtin "bin" [int (-6)] == str "-0b110"
+#eval builtin "ord" [str "A"] == int 65
+#eval builtin "chr" [int 65] == str "A"
+#eval builtin "str" [int (-123)] == str "-123"
+#eval builtin "int" [str "7"] == int 7
+#eval builtin "int" [str "123"] == int 123
+#eval builtin "eval" [str "2 + 3 * 4"] == int 14
+#eval builtin "eval" [str "2 ** 3 ** 2"] == int 512
+#eval builtin "eval" [str "10 // 3"] == int 3
+#eval builtin "isinstance"
