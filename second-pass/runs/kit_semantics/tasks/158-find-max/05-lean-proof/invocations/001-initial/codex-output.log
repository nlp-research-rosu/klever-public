+def codesContain (pattern : SortIntSeq) : SortIntSeq → SortBool
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => codesPrefix pattern emptyCodes
+  | whole@(SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ rest) =>
