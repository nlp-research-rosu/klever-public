+      if operator = "**" then
+        match remainingValues with
+        | next :: rest =>
+            (remainingOperators, integerPower value next :: rest)
+        | [] => (remainingOperators, [value])
+      else
+        (operator :: remainingOperators, value :: remainingValues)
