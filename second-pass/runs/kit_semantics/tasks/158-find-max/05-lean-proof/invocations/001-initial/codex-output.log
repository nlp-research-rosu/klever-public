new file mode 100644
index 0000000000000000000000000000000000000000..9374ec6d4e5c280aae211de5dc42d155476e18e5
--- /dev/null
+++ b//tmp/DispatchTests.lean
@@ -0,0 +1,57 @@
+import Proof
+
+open Operational
+
+def args : List SortVal → SortVals
+  | [] => noArguments
+  | value :: rest =>
+      SortVals.«_,__MPY-CORE_Vals_Val_Vals» value (args rest)
+
+def codes (text : String) : SortIntSeq :=
+  characterListToCodes text.toList
+
+def str (text : String) : SortVal :=
+  stringValue (codes text)
+
+def int (value : Int) : SortVal :=
+  integerValue value
+
+def listValue (values : List SortVal) : SortVal :=
+  iterableValue
+    (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» (go values))
+where
+  go : List SortVal → SortValSeq
+    | [] => emptyValues
+    | value :: rest =>
+        SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value (go rest)
+
+def builtin (name : String) (values : List SortVal) : SortVal :=
+  Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals» name (args values)
+
+#eval builtin "set" [str "aba"] ==
+  SortVal.«setV(_)_MPY-SET_Val_IntSeq» (codes "ab")
+#eval builtin "len" [listValue [int 1, int 2, int 3]] == int 3
+#eval builtin "abs" [int (-7)] == int 7
+#eval builtin "max" [int 2, int 9, int 4] == int 9
+#eval builtin "min" [int 2, int (-9), int 4] == int (-9)
+#eval builtin "bin" [int 0] == str "0b0"
+#eval builtin "bin" [int 6] == str "0b110"
+#eval builtin "bin" [int (-6)] == str "-0b110"
+#eval builtin "ord" [str "A"] == int 65
+#eval builtin "chr" [int 65] == str "A"
+#eval builtin "str" [int (-123)] == str "-123"
+#eval builtin "int" [str "7"] == int 7
+#eval builtin "int" [str "123"] == int 123
+#eval builtin "eval" [str "2 + 3 * 4"] == int 14
+#eval builtin "eval" [str "2 ** 3 ** 2"] == int 512
+#eval builtin "eval" [str "10 // 3"] == int 3
+#eval builtin "isinstance"
+  [int 1, SortVal.«typeV(_)_MPY-CORE_Val_String» "int"] ==
+  booleanValue true
+
+#eval Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<"
+  (int 2) (int 3)
+#eval Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "in"
+  (str "bc") (str "abcd")
+#eval Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "=="
+  (listValue [int 1, str "x"]) (listValue [int 1, str "x"])
