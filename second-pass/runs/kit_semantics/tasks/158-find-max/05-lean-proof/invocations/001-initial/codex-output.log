+  if precision < 0 then
+    let scale := Float.ofInt (tenPower (0 - precision))
+    Float.ofInt (roundFloatToInteger (value / scale)) * scale
+  else
+    let scale := Float.ofInt (tenPower precision)
+    Float.ofInt (roundFloatToInteger (value * scale)) / scale
