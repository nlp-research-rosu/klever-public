        pattern = r'(?m)"'^'"\\s*def\\s+' + re.escape(name)
    else:
        pattern = r'(?m)"'^'"\\s*def\\s+' + re.escape(name) + r'\\b'
    print(f\"{name}: {len(re.findall(pattern, text))}\")
PY
printf '%s\\n' 'import Proof' '#print axioms Proof.final' | LD_PRELOAD=/tmp/lean-proc-self.so lake env lean --stdin
LD_PRELOAD=/tmp/lean-proc-self.so lake build" in /workspace
