+      (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» values) =>
+      some (valueSequenceLength values)
+  | SortVal.inj_SortIterable
+      (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» values) =>
+      some (valueSequenceLength values)
