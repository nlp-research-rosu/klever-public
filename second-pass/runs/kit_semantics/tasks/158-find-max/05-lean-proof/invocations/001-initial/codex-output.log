+def integralFloatToInteger (value : SortFloat) : SortInt :=
+  let bits := value.toBits.toNat
+  let sign := bits / (2 ^ 63)
+  let exponentBits := (bits / (2 ^ 52)) % (2 ^ 11)
+  let fraction := bits % (2 ^ 52)
+  let magnitude :=
