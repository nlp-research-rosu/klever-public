+def floatComparisonLess (left right : SortFloat) : SortBool :=
+  decide (left < right)
+
+def floatComparisonGreater (left right : SortFloat) : SortBool :=
+  decide (right < left)
+
+def floatComparisonEqual (left right : SortFloat) : SortBool :=
+  left == right
