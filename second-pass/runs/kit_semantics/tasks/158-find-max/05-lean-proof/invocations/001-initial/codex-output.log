+def stringPayload : SortStr → SortIntSeq
+  | SortStr.«str(_)_MPY-CORE_Str_IntSeq» codes => codes
+
+def intSequenceLength : SortIntSeq → SortInt
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => 0
