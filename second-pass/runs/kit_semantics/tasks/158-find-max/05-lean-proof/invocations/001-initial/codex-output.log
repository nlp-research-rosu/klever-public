+def evaluateArithmetic (codes : SortIntSeq) : SortInt :=
+  let powered := powerPass (operatorTokens codes) (operandTokens codes)
+  let multiplied := leftPass "mul" powered
+  let added := leftPass "add" multiplied
+  match added.2 with
+  | first :: _ => first
+  | [] => 0
