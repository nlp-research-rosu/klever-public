diff --git a//tmp/lean-proc-self.c b//tmp/lean-proc-self.c
new file mode 100644
index 0000000000000000000000000000000000000000..d13b70d9824276731e2c27c070f65adc020a5ceb
--- /dev/null
+++ b//tmp/lean-proc-self.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+    const size_t length = strlen(path);
+    if (length >= 4 && strcmp(path + length - 4, "/exe") == 0) {
+      return real_readlink("/proc/self/exe", buffer, size);
+    }
+  }
+  return real_readlink(path, buffer, size);
+}
