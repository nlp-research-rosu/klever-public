+def dictionariesEqual
+    (leftKeys leftValues rightKeys rightValues : SortValSeq) : SortBool :=
+  (valueSequenceLength leftKeys == valueSequenceLength rightKeys) &&
+    dictionarySubset leftKeys leftValues rightKeys rightValues
