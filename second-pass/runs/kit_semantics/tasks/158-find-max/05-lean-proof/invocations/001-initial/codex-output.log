+#eval builtin "abs" [floatValue (-2.5)] == floatValue 2.5
+#eval builtin "floor" [floatValue (-2.4)] == int (-3)
+#eval builtin "ceil" [floatValue (-2.4)] == int (-2)
+#eval builtin "int" [floatValue (-2.4)] == int (-2)
+#eval builtin "round" [floatValue 2.5] == int 2
+#eval builtin "round" [floatValue 3.5] == int 4
+#eval builtin "float" [str "-2.5"] == floatValue (-2.5)
+
