+    | SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+        (SortVal.inj_SortStr
+          (SortStr.«str(_)_MPY-CORE_Str_IntSeq» codes))
+        SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+        match integerFromStringCodes codes with
