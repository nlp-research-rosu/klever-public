+  else if operator = "not in" then !(codesContain left right)
+  else if operator = "<" then lexicographicallyLess left right
+  else if operator = ">" then lexicographicallyLess right left
+  else if operator = "<=" then !(lexicographicallyLess right left)
+  else if operator = ">=" then !(lexicographicallyLess left right)
+  else false
