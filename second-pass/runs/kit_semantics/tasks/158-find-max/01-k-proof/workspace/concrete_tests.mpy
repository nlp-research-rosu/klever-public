Module(
  FuncDef("find_max", Params("words"),
    Assign(Name("result"), Str(""))
    Assign(Name("max_unique"), UnaryOp("-", Int(1)))
    Assign(Name("word"), Str(""))
    Assign(Name("unique"), UnaryOp("-", Int(1)))
    For(Name("word"), Name("words"),
      Assign(
        Name("unique"),
        Call(Name("len"), Call(Name("set"), Name("word"))))
      If(BoolOp(
        "or",
        Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
        BoolOp(
          "and",
          Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
          Compare(Name("word"), CmpOp("<", Name("result"))))),
        Assign(Name("result"), Name("word"))
        Assign(Name("max_unique"), Name("unique")),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("name"), Str("of"), Str("string"))),
      CmpOp("==", Str("string"))))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("name"), Str("enam"), Str("game"))),
      CmpOp("==", Str("enam"))))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("aaaaaaa"), Str("bb"), Str("cc"))),
      CmpOp("==", Str("aaaaaaa"))))
  Assert(
    Compare(
      Call(Name("find_max"), ListExpr(Str("z"), Str("aa"))),
      CmpOp("==", Str("aa"))))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("abc"), Str("bca"), Str("cab"))),
      CmpOp("==", Str("abc"))))
  Assert(
    Compare(Call(Name("find_max"), ListExpr()), CmpOp("==", Str("")))))
