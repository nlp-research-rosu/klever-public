index 0000000000000000000000000000000000000000..73caa377e57d766b19d5f6b3be7c1e138036f5b3
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def find_max(words):
+    result = ""
+    max_unique = -1
+    word = ""
+    unique = -1
+    for word in words:
+        unique = len(set(word))
+        if unique > max_unique or unique == max_unique and word < result:
+            result = word
+            max_unique = unique
+    return result
