+  claim [set-str-connection]:
+    <k>
+      applyBuiltin("set", str(CS), .Vals)
+      => setV(dedupCodes(CS))
+    </k>
+
+  claim [str-lt-connection]:
+    <k>
+      applyCmp("<", str(A), str(B))
+      => strLt(A, B)
+    </k>
+
+  claim [set-dynamic-connection]:
+    <k>
+      applyBuiltin("set", V:Val, .Vals)
+      => setV(dedupCodes(codesOf(projectStrTotal(V))))
+    </k>
+    requires definedProjectStr(V)
+
+  claim [str-lt-dynamic-connection]:
+    <k>
+      applyCmp("<", A:Val, B:Val)
+      => strLt(
+           codesOf(projectStrTotal(A)),
+           codesOf(projectStrTotal(B)))
+    </k>
+    requires definedProjectStr(A) andBool definedProjectStr(B)
+endmodule
diff --git a/connection.k b/connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..bb3b393a3617fef328e7ab0124e3860876eebfb2
--- /dev/null
+++ b/connection.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+// Deliberately imports only the fixed supplied semantics.  In particular, it
+// does not import VERIFICATION or either guarded dispatch twin.
+module CONNECTION
+  imports MPY
+
+  syntax Bool ::= definedProjectStr(Val) [function, total]
+  rule definedProjectStr(V:Val) => isStr(V)
+
+  syntax Str ::= projectStrTotal(Val)
+    [function, total, symbol(projectStrTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Str)
+    => ({ definedProjectStr(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectStrTotal(V:Val) => {V}:>Str
+    requires definedProjectStr(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Str => projectStrTotal(V)
+    requires definedProjectStr(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectStrTotal(S:Str) => S [simplification]
+  rule projectStrTotal(projectStrTotal(V)) => projectStrTotal(V) [simplification]
+
+  syntax IntSeq ::= codesOf(Str) [function, total]
+  rule codesOf(str(CS)) => CS
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..c75c76ec3abee9ba9b1cd2aeaaa5c33d2466c487
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,47 @@
+from itertools import permutations
+from random import Random
+
+from solution import find_max
+
+
+def oracle(words):
+    if not words:
+        return ""
+    return sorted(words, key=lambda word: (-len(set(word)), word))[0]
+
+
+cases = [
+    ["name", "of", "string"],
+    ["name", "enam", "game"],
+    ["aaaaaaa", "bb", "cc"],
+    [],
+    ["é", "e", "😀"],
+]
+
+pool = ["", "a", "b", "aa", "ab", "ba", "abc"]
+for size in range(1, 5):
+    cases.extend(list(items) for items in permutations(pool, size))
+
+rng = Random(20260729)
+alphabet = "abcxyz"
+universe = [""]
+for _ in range(80):
+    universe.append(
+        "".join(rng.choice(alphabet) for _ in range(rng.randrange(0, 9)))
+    )
+universe = sorted(set(universe))
+for _ in range(5000):
+    size = rng.randrange(0, min(12, len(universe)) + 1)
+    cases.append(rng.sample(universe, size))
+
+mismatches = []
+for words in cases:
+    actual = find_max(words)
+    expected = oracle(words)
+    if actual != expected:
+        mismatches.append((words, actual, expected))
+
+print(f"cases={len(cases)} mismatches={len(mismatches)}")
+if mismatches:
+    print(mismatches[:10])
+    raise SystemExit(1)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..523ee219107ebf22508977233323288c82562a3d
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+python3 py2mpy.py body_mutation.py > body_mutation.mpy
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+# Supporting isolated invariant proof.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-inv
+
+# Required positive target proof: both the invariant and whole entry claim.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+kompile --backend haskell connection.k \
+  --main-module CONNECTION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition connection-kompiled
+
+# Bridge-free universal fixed-semantics equations used to justify the guarded
+# dynamic dispatch twins.
+kprove connection-spec.k \
+  --definition connection-kompiled \
+  --spec-module CONNECTION-SPEC
+
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY; then
+  echo "UNEXPECTED: false-result mutation proved"
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-result mutation was rejected"
+fi
+
+if krun body_mutation.mpy --definition runtime-kompiled; then
+  echo "UNEXPECTED: material body mutant passed"
+  exit 1
+else
+  echo "EXPECTED FAILURE: material body mutant changed the result"
+fi
+
+python3 differential_test.py
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..73caa377e57d766b19d5f6b3be7c1e138036f5b3
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def find_max(words):
+    result = ""
+    max_unique = -1
+    word = ""
+    unique = -1
+    for word in words:
+        unique = len(set(word))
+        if unique > max_unique or unique == max_unique and word < result:
+            result = word
+            max_unique = unique
+    return result
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..940659980e4b373b7dfb0ff539f81745c4f8480c
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,90 @@
+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Satisfiable witness: the original program on ["a"] returns "a", not "".
+  claim [false-result]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "find_max",
+            Params("words"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)))
+      ~> Call(
+        Name("find_max"),
+        list(vCons(str(iCons(97, .IntSeq)), .ValSeq)),
+        .Exprs)
+      => str(.IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        (.Map
+          => "find_max" |-> closureVal(
+            "words" , .ParamNames,
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..aa7a4b4181b79049638f7ce94e09b9f60fdb6e40
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,180 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("word"),
+        Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+        If(
+          BoolOp(
+            "or",
+            Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            BoolOp(
+              "and",
+              Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              Compare(Name("word"), CmpOp("<", Name("result"))),
+              .Exprs),
+            .Exprs),
+          Assign(Name("result"), Name("word"))
+          Assign(Name("max_unique"), Name("unique"))
+          .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "words"      |-> list(ORIGINAL)
+        "result"     |-> str(BEST)
+        "max_unique" |-> SCORE
+        "word"       |-> str(CURRENT)
+        "unique"     |-> CURRENT_SCORE,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-step]:
+    <k>
+      #loop(
+        list(vCons(str(CS), REST)),
+        Name("word"),
+        Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+        If(
+          BoolOp(
+            "or",
+            Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            BoolOp(
+              "and",
+              Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              Compare(Name("word"), CmpOp("<", Name("result"))),
+              .Exprs),
+            .Exprs),
+          Assign(Name("result"), Name("word"))
+          Assign(Name("max_unique"), Name("unique"))
+          .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "words"      |-> list(ORIGINAL)
+        "result"     |-> (str(BEST) => bestWord(vCons(str(CS), REST), BEST, SCORE))
+        "max_unique" |-> (SCORE => bestScore(vCons(str(CS), REST), BEST, SCORE))
+        "word"       |-> (str(CURRENT) => lastWord(vCons(str(CS), REST), CURRENT))
+        "unique"     |-> (CURRENT_SCORE => lastScore(vCons(str(CS), REST), CURRENT_SCORE)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrings(REST)
+         andBool notBool ("len" in_keys(MODULE))
+         andBool notBool ("set" in_keys(MODULE))
+
+  claim [find-max]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "find_max",
+            Params("words"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)))
+      ~> Call(Name("find_max"), list(WORDS), .Exprs)
+      => bestWord(WORDS, .IntSeq, 0 -Int 1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        (.Map
+          => "find_max" |-> closureVal(
+            "words" , .ParamNames,
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrings(WORDS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..693ace1a50cfbea1cca5bd383cc34640c2de8b58
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,49 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exactly the finite ValSeq values whose elements are modeled strings.
+  syntax Bool ::= allStrings(ValSeq) [function, total]
+  rule allStrings(.ValSeq)                       => true
+  rule allStrings(vCons(str(_CS), REST))         => allStrings(REST)
+  rule allStrings(vCons(_NON_STRING, _REST))     => false [owise]
+
+  // The score used by the HumanEval contract.
+  syntax Int ::= uniqueCount(IntSeq) [function, total]
+  rule uniqueCount(CS) => isLen(dedupCodes(CS))
+
+  // A candidate wins on score, then on lexicographically smaller spelling.
+  syntax Bool ::= candidateWins(IntSeq, IntSeq, Int) [function, total]
+  rule candidateWins(CS, BEST, SCORE)
+    => uniqueCount(CS) >Int SCORE
+       orBool (uniqueCount(CS) ==Int SCORE andBool strLt(CS, BEST))
+
+  // Exact mathematical fold computed by the loop, defined on string lists.
+  syntax Str ::= bestWord(ValSeq, IntSeq, Int) [function]
+  rule bestWord(.ValSeq, BEST, _SCORE) => str(BEST)
+  rule bestWord(vCons(str(CS), REST), BEST, SCORE)
+    => #if candidateWins(CS, BEST, SCORE)
+       #then bestWord(REST, CS, uniqueCount(CS))
+       #else bestWord(REST, BEST, SCORE)
+       #fi
+    [simplification]
+
+  syntax Int ::= bestScore(ValSeq, IntSeq, Int) [function]
+  rule bestScore(.ValSeq, _BEST, SCORE) => SCORE
+  rule bestScore(vCons(str(CS), REST), BEST, SCORE)
+    => #if candidateWins(CS, BEST, SCORE)
+       #then bestScore(REST, CS, uniqueCount(CS))
+       #else bestScore(REST, BEST, SCORE)
+       #fi
+    [simplification]
+
+  // Exact final values of the loop target and per-element score temporary.
+  syntax Str ::= lastWord(ValSeq, IntSeq) [function]
+  rule lastWord(.ValSeq, WORD)                       => str(WORD)
+  rule lastWord(vCons(str(CS), REST), _WORD)         => lastWord(REST, CS)
+
+  syntax Int ::= lastScore(ValSeq, Int) [function]
+  rule lastScore(.ValSeq, SCORE)                       => SCORE
+  rule lastScore(vCons(str(CS), REST), _SCORE)         => lastScore(REST, uniqueCount(CS))
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
