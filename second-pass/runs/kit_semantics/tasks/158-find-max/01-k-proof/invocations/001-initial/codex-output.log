+
+  // A candidate wins on score, then on lexicographically smaller spelling.
+  syntax Bool ::= candidateWins(IntSeq, IntSeq, Int) [function, total]
+  rule candidateWins(CS, BEST, SCORE)
+    => uniqueCount(CS) >Int SCORE
+       orBool (uniqueCount(CS) ==Int SCORE andBool strLt(CS, BEST))
+
+  // Exact mathematical fold computed by the outer loop.
+  syntax Str ::= bestWord(StrSeq, IntSeq, Int) [function, total]
+  rule bestWord(.StrSeq, BEST, _SCORE) => str(BEST)
+  rule bestWord(sCons(CS, REST), BEST, SCORE)
+    => bestWord(REST, CS, uniqueCount(CS))
+    requires candidateWins(CS, BEST, SCORE)
+  rule bestWord(sCons(CS, REST), BEST, SCORE)
+    => bestWord(REST, BEST, SCORE)
+    requires notBool candidateWins(CS, BEST, SCORE)
+
+  syntax Int ::= bestScore(StrSeq, IntSeq, Int) [function, total]
+  rule bestScore(.StrSeq, _BEST, SCORE) => SCORE
+  rule bestScore(sCons(CS, REST), BEST, SCORE)
+    => bestScore(REST, CS, uniqueCount(CS))
+    requires candidateWins(CS, BEST, SCORE)
+  rule bestScore(sCons(CS, REST), BEST, SCORE)
+    => bestScore(REST, BEST, SCORE)
+    requires notBool candidateWins(CS, BEST, SCORE)
+
+  // Exact final values of the loop target and its per-element score temporary.
+  syntax Str ::= lastWord(StrSeq, IntSeq) [function, total]
+  rule lastWord(.StrSeq, WORD)         => str(WORD)
+  rule lastWord(sCons(CS, REST), _WORD) => lastWord(REST, CS)
+
+  syntax Int ::= lastScore(StrSeq, Int) [function, total]
+  rule lastScore(.StrSeq, SCORE)          => SCORE
+  rule lastScore(sCons(CS, REST), _SCORE) => lastScore(REST, uniqueCount(CS))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-inv' in /workspace
