+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "words"      |-> list(ORIGINAL)
+        "result"     |-> (str(BEST) => bestWord(vCons(str(CS), REST), BEST, SCORE))
+        "max_unique" |-> (SCORE => bestScore(vCons(str(CS), REST), BEST, SCORE))
+        "word"       |-> (str(CURRENT) => lastWord(vCons(str(CS), REST), CURRENT))
+        "unique"     |-> (CURRENT_SCORE => lastScore(vCons(str(CS), REST), CURRENT_SCORE)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrings(REST)
+         andBool notBool ("len" in_keys(MODULE))
+         andBool notBool ("set" in_keys(MODULE))
+
+  claim [find-max]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "find_max",
+            Params("words"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)))
+      ~> Call(Name("find_max"), list(WORDS), .Exprs)
+      => bestWord(WORDS, .IntSeq, 0 -Int 1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        (.Map
+          => "find_max" |-> closureVal(
+            "words" , .ParamNames,
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrings(WORDS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..57c649751be297d4e98305fc288c2ecc63bfcfcd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,57 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exactly the finite ValSeq values whose elements are modeled strings.
+  syntax Bool ::= allStrings(ValSeq) [function, total]
+  rule allStrings(.ValSeq)                       => true
+  rule allStrings(vCons(str(_CS), REST))         => allStrings(REST)
+  rule allStrings(vCons(_NON_STRING, _REST))     => false [owise]
+
+  // The score used by the HumanEval contract.
+  syntax Int ::= uniqueCount(IntSeq) [function, total]
+  rule uniqueCount(CS) => isLen(dedupCodes(CS))
+
+  // A candidate wins on score, then on lexicographically smaller spelling.
+  syntax Bool ::= candidateWins(IntSeq, IntSeq, Int) [function, total]
+  rule candidateWins(CS, BEST, SCORE)
+    => uniqueCount(CS) >Int SCORE
+       orBool (uniqueCount(CS) ==Int SCORE andBool strLt(CS, BEST))
+
+  // Exact mathematical fold computed by the loop, defined on string lists.
+  syntax Str ::= bestWord(ValSeq, IntSeq, Int) [function, total]
+  rule bestWord(.ValSeq, BEST, _SCORE) => str(BEST)
+  rule bestWord(vCons(str(CS), REST), BEST, SCORE)
+    => #if candidateWins(CS, BEST, SCORE)
+       #then bestWord(REST, CS, uniqueCount(CS))
+       #else bestWord(REST, BEST, SCORE)
+       #fi
+    [simplification]
+  rule bestWord(vCons(_NON_STRING, REST), BEST, SCORE)
+    => bestWord(REST, BEST, SCORE)
+    [owise]
+
+  syntax Int ::= bestScore(ValSeq, IntSeq, Int) [function, total]
+  rule bestScore(.ValSeq, _BEST, SCORE) => SCORE
+  rule bestScore(vCons(str(CS), REST), BEST, SCORE)
+    => #if candidateWins(CS, BEST, SCORE)
+       #then bestScore(REST, CS, uniqueCount(CS))
+       #else bestScore(REST, BEST, SCORE)
+       #fi
+    [simplification]
+  rule bestScore(vCons(_NON_STRING, REST), BEST, SCORE)
+    => bestScore(REST, BEST, SCORE)
+    [owise]
+
+  // Exact final values of the loop target and per-element score temporary.
+  syntax Str ::= lastWord(ValSeq, IntSeq) [function, total]
+  rule lastWord(.ValSeq, WORD)                       => str(WORD)
+  rule lastWord(vCons(str(CS), REST), _WORD)         => lastWord(REST, CS)
+  rule lastWord(vCons(_NON_STRING, REST), WORD)      => lastWord(REST, WORD) [owise]
+
+  syntax Int ::= lastScore(ValSeq, Int) [function, total]
+  rule lastScore(.ValSeq, SCORE)                       => SCORE
+  rule lastScore(vCons(str(CS), REST), _SCORE)         => lastScore(REST, uniqueCount(CS))
+  rule lastScore(vCons(_NON_STRING, REST), SCORE)      => lastScore(REST, SCORE) [owise]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
diff --git a/body_mutation.py b/body_mutation.py
new file mode 100644
index 0000000000000000000000000000000000000000..32a057a62112cbc783427e5c5dc573ac0122eede
--- /dev/null
+++ b/body_mutation.py
@@ -0,0 +1,15 @@
+def find_max(words):
+    result = ""
+    max_unique = 100
+    word = ""
+    unique = -1
+    for word in words:
+        unique = len(set(word))
+        if unique > max_unique or unique == max_unique and word < result:
+            result = word
+            max_unique = unique
+    return result
+
+
+# The original implementation and contract return "a"; this mutant returns "".
+assert find_max(["a"]) == "a"
