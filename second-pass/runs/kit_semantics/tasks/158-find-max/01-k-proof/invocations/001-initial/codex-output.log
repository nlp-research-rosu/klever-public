+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrings(WORDS)
+         andBool definedProjectStr(BEST)
+         andBool notBool isRefV(BEST)
+
+  claim [find-max]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "find_max",
