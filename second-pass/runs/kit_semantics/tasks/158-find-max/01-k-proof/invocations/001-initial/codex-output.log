index 0000000000000000000000000000000000000000..45f3370dc84dedf0a70907d222720a301d717239
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,51 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A statically typed representation of every finite modeled list of strings.
+  syntax StrSeq ::= ".StrSeq"
+                  | sCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strVals(StrSeq) [function, total]
+  rule strVals(.StrSeq)          => .ValSeq
+  rule strVals(sCons(CS, REST))  => vCons(str(CS), strVals(REST))
+
+  // The score used by the HumanEval contract.
+  syntax Int ::= uniqueCount(IntSeq) [function, total]
+  rule uniqueCount(CS) => isLen(dedupCodes(CS))
+
+  // A candidate wins on score, then on lexicographically smaller spelling.
+  syntax Bool ::= candidateWins(IntSeq, IntSeq, Int) [function, total]
+  rule candidateWins(CS, BEST, SCORE)
+    => uniqueCount(CS) >Int SCORE
+       orBool (uniqueCount(CS) ==Int SCORE andBool strLt(CS, BEST))
+
+  // Exact mathematical fold computed by the outer loop.
+  syntax Str ::= bestWord(StrSeq, IntSeq, Int) [function, total]
+  rule bestWord(.StrSeq, BEST, _SCORE) => str(BEST)
+  rule bestWord(sCons(CS, REST), BEST, SCORE)
+    => bestWord(REST, CS, uniqueCount(CS))
+    requires candidateWins(CS, BEST, SCORE)
+  rule bestWord(sCons(CS, REST), BEST, SCORE)
+    => bestWord(REST, BEST, SCORE)
+    requires notBool candidateWins(CS, BEST, SCORE)
+
+  syntax Int ::= bestScore(StrSeq, IntSeq, Int) [function, total]
+  rule bestScore(.StrSeq, _BEST, SCORE) => SCORE
+  rule bestScore(sCons(CS, REST), BEST, SCORE)
+    => bestScore(REST, CS, uniqueCount(CS))
+    requires candidateWins(CS, BEST, SCORE)
+  rule bestScore(sCons(CS, REST), BEST, SCORE)
+    => bestScore(REST, BEST, SCORE)
+    requires notBool candidateWins(CS, BEST, SCORE)
+
+  // Exact final values of the loop target and its per-element score temporary.
+  syntax Str ::= lastWord(StrSeq, IntSeq) [function, total]
+  rule lastWord(.StrSeq, WORD)         => str(WORD)
+  rule lastWord(sCons(CS, REST), _WORD) => lastWord(REST, CS)
+
+  syntax Int ::= lastScore(StrSeq, Int) [function, total]
+  rule lastScore(.StrSeq, SCORE)          => SCORE
+  rule lastScore(sCons(CS, REST), _SCORE) => lastScore(REST, uniqueCount(CS))
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..93f8a7f5c1334da91946d0fa28784ddc86b0b78c
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,19 @@
+def find_max(words):
+    result = ""
+    max_unique = -1
+    word = ""
+    unique = -1
+    for word in words:
+        unique = len(set(word))
+        if unique > max_unique or unique == max_unique and word < result:
+            result = word
+            max_unique = unique
+    return result
+
+
+assert find_max(["name", "of", "string"]) == "string"
+assert find_max(["name", "enam", "game"]) == "enam"
+assert find_max(["aaaaaaa", "bb", "cc"]) == "aaaaaaa"
+assert find_max(["z", "aa"]) == "aa"
+assert find_max(["abc", "bca", "cab"]) == "abc"
+assert find_max([]) == ""
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..73caa377e57d766b19d5f6b3be7c1e138036f5b3
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def find_max(words):
+    result = ""
+    max_unique = -1
+    word = ""
+    unique = -1
+    for word in words:
+        unique = len(set(word))
+        if unique > max_unique or unique == max_unique and word < result:
+            result = word
+            max_unique = unique
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..eacdacc3f4c81a0b17e4b2c6e0fe3999479508e2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,162 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        list(strVals(WORDS)),
+        Name("word"),
+        Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+        If(
+          BoolOp(
+            "or",
+            Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            BoolOp(
+              "and",
+              Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              Compare(Name("word"), CmpOp("<", Name("result"))),
+              .Exprs),
+            .Exprs),
+          Assign(Name("result"), Name("word"))
+          Assign(Name("max_unique"), Name("unique"))
+          .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(
+        "find_max" |-> closureVal(
+          "words" , .ParamNames,
+          Assign(Name("result"), Str(""))
+          Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+          Assign(Name("word"), Str(""))
+          Assign(Name("unique"), UnaryOp("-", Int(1)))
+          For(
+            Name("word"),
+            Name("words"),
+            Assign(
+              Name("unique"),
+              Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+            If(
+              BoolOp(
+                "or",
+                Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                BoolOp(
+                  "and",
+                  Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                  Compare(Name("word"), CmpOp("<", Name("result"))),
+                  .Exprs),
+                .Exprs),
+              Assign(Name("result"), Name("word"))
+              Assign(Name("max_unique"), Name("unique"))
+              .Stmts,
+              .Stmts)
+            .Stmts)
+          Return(Name("result"))
+          .Stmts,
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "words"      |-> list(strVals(ORIGINAL))
+        "result"     |-> (str(BEST) => bestWord(WORDS, BEST, SCORE))
+        "max_unique" |-> (SCORE => bestScore(WORDS, BEST, SCORE))
+        "word"       |-> (str(CURRENT) => lastWord(WORDS, CURRENT))
+        "unique"     |-> (CURRENT_SCORE => lastScore(WORDS, CURRENT_SCORE)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP </heap>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [find-max]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "find_max",
+            Params("words"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)))
+      ~> Call(Name("find_max"), list(strVals(WORDS)), .Exprs)
+      => bestWord(WORDS, .IntSeq, 0 -Int 1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        (.Map
+          => "find_max" |-> closureVal(
+            "words" , .ParamNames,
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
