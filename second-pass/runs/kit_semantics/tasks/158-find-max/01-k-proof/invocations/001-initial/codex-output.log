diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6ad66ea6edccca0004d495281cfe9c9e1ed1348
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,47 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exactly the finite ValSeq values whose elements are modeled strings.
+  syntax Bool ::= allStrings(ValSeq) [function, total]
+  rule allStrings(.ValSeq)                       => true
+  rule allStrings(vCons(str(_CS), REST))         => allStrings(REST)
+  rule allStrings(vCons(_NON_STRING, _REST))     => false [owise]
+
+  // The score used by the HumanEval contract.
+  syntax Int ::= uniqueCount(IntSeq) [function, total]
+  rule uniqueCount(CS) => isLen(dedupCodes(CS))
+
+  // A candidate wins on score, then on lexicographically smaller spelling.
+  syntax Bool ::= candidateWins(IntSeq, IntSeq, Int) [function, total]
+  rule candidateWins(CS, BEST, SCORE)
+    => uniqueCount(CS) >Int SCORE
+       orBool (uniqueCount(CS) ==Int SCORE andBool strLt(CS, BEST))
+
+  // Exact mathematical fold computed by the loop, defined on string lists.
+  syntax Str ::= bestWord(ValSeq, IntSeq, Int) [function]
+  rule bestWord(.ValSeq, BEST, _SCORE) => str(BEST)
+  rule bestWord(vCons(str(CS), REST), BEST, SCORE)
+    => #if candidateWins(CS, BEST, SCORE)
+       #then bestWord(REST, CS, uniqueCount(CS))
+       #else bestWord(REST, BEST, SCORE)
+       #fi
+
+  syntax Int ::= bestScore(ValSeq, IntSeq, Int) [function]
+  rule bestScore(.ValSeq, _BEST, SCORE) => SCORE
+  rule bestScore(vCons(str(CS), REST), BEST, SCORE)
+    => #if candidateWins(CS, BEST, SCORE)
+       #then bestScore(REST, CS, uniqueCount(CS))
+       #else bestScore(REST, BEST, SCORE)
+       #fi
+
+  // Exact final values of the loop target and per-element score temporary.
+  syntax Str ::= lastWord(ValSeq, IntSeq) [function]
+  rule lastWord(.ValSeq, WORD)                       => str(WORD)
+  rule lastWord(vCons(str(CS), REST), _WORD)         => lastWord(REST, CS)
+
+  syntax Int ::= lastScore(ValSeq, Int) [function]
+  rule lastScore(.ValSeq, SCORE)                       => SCORE
+  rule lastScore(vCons(str(CS), REST), _SCORE)         => lastScore(REST, uniqueCount(CS))
+endmodule

