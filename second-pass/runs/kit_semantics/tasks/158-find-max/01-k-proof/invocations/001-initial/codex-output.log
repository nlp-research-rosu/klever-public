+        "unique"     |-> CURRENT_SCORE,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-step]:
+    <k>
+      #loop(
+        list(vCons(str(CS), REST)),
+        Name("word"),
+        Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+        If(
+          BoolOp(
+            "or",
+            Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            BoolOp(
+              "and",
+              Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              Compare(Name("word"), CmpOp("<", Name("result"))),
+              .Exprs),
