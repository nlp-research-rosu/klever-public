@@ -0,0 +1,19 @@
+def find_max(words):
+    result = ""
+    max_unique = -1
+    word = ""
+    unique = -1
+    for word in words:
+        unique = len(set(word))
+        if unique > max_unique or unique == max_unique and word < result:
+            result = word
+            max_unique = unique
+    return result
+
+
+assert find_max(["name", "of", "string"]) == "string"
+assert find_max(["name", "enam", "game"]) == "enam"
+assert find_max(["aaaaaaa", "bb", "cc"]) == "aaaaaaa"
+assert find_max(["z", "aa"]) == "aa"
+assert find_max(["abc", "bca", "cab"]) == "abc"
+assert find_max([]) == ""
diff --git a/connection-spec.k b/connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..567210a51fbdbddab752284fcb4ec126e1c97f57
--- /dev/null
+++ b/connection-spec.k
@@ -0,0 +1,19 @@
+requires "connection.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  // These universal constructor-domain claims are the fixed equations that
+  // the guarded dynamic dispatch twins restate through the total projection.
+  claim [set-str-connection]:
+    <k>
+      applyBuiltin("set", str(CS), .Vals)
+      => setV(dedupCodes(CS))
+    </k>
+
+  claim [str-lt-connection]:
+    <k>
+      applyCmp("<", str(A), str(B))
+      => strLt(A, B)
+    </k>
+endmodule
