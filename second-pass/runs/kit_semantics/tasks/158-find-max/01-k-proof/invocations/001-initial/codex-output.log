+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "find_max",
+            Params("words"),
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)))
+      ~> Call(
+        Name("find_max"),
+        list(vCons(str(iCons(97, .IntSeq)), .ValSeq)),
+        .Exprs)
+      => str(.IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        (.Map
+          => "find_max" |-> closureVal(
+            "words" , .ParamNames,
+            Assign(Name("result"), Str(""))
+            Assign(Name("max_unique"), UnaryOp("-", Int(1)))
+            Assign(Name("word"), Str(""))
+            Assign(Name("unique"), UnaryOp("-", Int(1)))
+            For(
+              Name("word"),
+              Name("words"),
+              Assign(
+                Name("unique"),
+                Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+              If(
+                BoolOp(
+                  "or",
+                  Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+                  BoolOp(
+                    "and",
+                    Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+                    Compare(Name("word"), CmpOp("<", Name("result"))),
+                    .Exprs),
+                  .Exprs),
+                Assign(Name("result"), Name("word"))
+                Assign(Name("max_unique"), Name("unique"))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..aa7a4b4181b79049638f7ce94e09b9f60fdb6e40
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,180 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("word"),
+        Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+        If(
+          BoolOp(
+            "or",
+            Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            BoolOp(
+              "and",
+              Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              Compare(Name("word"), CmpOp("<", Name("result"))),
+              .Exprs),
+            .Exprs),
+          Assign(Name("result"), Name("word"))
+          Assign(Name("max_unique"), Name("unique"))
+          .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "words"      |-> list(ORIGINAL)
+        "result"     |-> str(BEST)
+        "max_unique" |-> SCORE
+        "word"       |-> str(CURRENT)
+        "unique"     |-> CURRENT_SCORE,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-step]:
+    <k>
+      #loop(
+        list(vCons(str(CS), REST)),
+        Name("word"),
+        Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"), .Exprs), .Exprs))
+        If(
+          BoolOp(
+            "or",
+            Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            BoolOp(
+              "and",
+              Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              Compare(Name("word"), CmpOp("<", Name("result"))),
+              .Exprs),
+            .Exprs),
+          Assign(Name("result"), Name("word"))
+          Assign(Name("max_unique"), Name("unique"))
+          .Stmts,
+          .Stmts)
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "words"      |-> list(ORIGINAL)
+        "result"     |-> (str(BEST) => bestWord(vCons(str(CS), REST), BEST, SCORE))
