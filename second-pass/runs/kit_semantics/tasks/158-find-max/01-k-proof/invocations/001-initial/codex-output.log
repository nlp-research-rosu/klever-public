+++ b/body_mutation.py
@@ -0,0 +1,15 @@
+def find_max(words):
+    result = ""
+    max_unique = 100
+    word = ""
+    unique = -1
+    for word in words:
+        unique = len(set(word))
+        if unique > max_unique or unique == max_unique and word < result:
+            result = word
+            max_unique = unique
+    return result
+
+
+# The original implementation and contract return "a"; this mutant returns "".
+assert find_max(["a"]) == "a"
