    16	    return sorted(words, key = lambda x: (-len(set(x)), x))[0]

===== /candidate/solution.py =====
     1	def find_max(words):
     2	    result = ""
     3	    max_unique = -1
     4	    word = ""
     5	    unique = -1
     6	    for word in words:
     7	        unique = len(set(word))
     8	        if unique > max_unique or unique == max_unique and word < result:
     9	            result = word
    10	            max_unique = unique
    11	    return result

