--- /dev/null
+++ b/evidence/audit-dynamic-connection-spec.k
@@ -0,0 +1,21 @@
+requires "audit-dynamic-connection.k"
+
+module AUDIT-DYNAMIC-CONNECTION-SPEC
+  imports AUDIT-DYNAMIC-CONNECTION
+
+  claim [set-full-guard-domain]:
+    <k>
+      applyBuiltin("set", V:Val, .Vals)
+      => setV(dedupCodes(auditCodesOf(auditProjectStr(V))))
+    </k>
+    requires auditDefinedStr(V)
+
+  claim [lt-full-guard-domain]:
+    <k>
+      applyCmp("<", A:Val, B:Val)
+      => strLt(
+           auditCodesOf(auditProjectStr(A)),
+           auditCodesOf(auditProjectStr(B)))
+    </k>
+    requires auditDefinedStr(A) andBool auditDefinedStr(B)
+endmodule
diff --git a/evidence/audit-dynamic-connection.k b/evidence/audit-dynamic-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..d7229b40a8d94df06de743502cd127891a7c9275
--- /dev/null
+++ b/evidence/audit-dynamic-connection.k
@@ -0,0 +1,28 @@
+requires "/tmp/audit-work/reconstruct-001/reference-semantics/semantics.k"
+
+module AUDIT-DYNAMIC-CONNECTION
+  imports MPY
+
+  syntax Bool ::= auditDefinedStr(Val) [function, total]
+  rule auditDefinedStr(V:Val) => isStr(V)
+
+  syntax Str ::= auditProjectStr(Val)
+    [function, total, symbol(auditProjectStr), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Str)
+    => ({ auditDefinedStr(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule auditProjectStr(V:Val) => {V}:>Str
+    requires auditDefinedStr(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Str => auditProjectStr(V)
+    requires auditDefinedStr(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule auditProjectStr(S:Str) => S [simplification]
+  rule auditProjectStr(auditProjectStr(V)) => auditProjectStr(V)
+    [simplification]
+
+  syntax IntSeq ::= auditCodesOf(Str) [function, total]
+  rule auditCodesOf(str(CS)) => CS
+endmodule
