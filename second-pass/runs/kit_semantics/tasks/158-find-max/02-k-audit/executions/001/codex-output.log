+            Return(Name("result"))
+            .Stmts)))
+      ~> Call(
+           Name("find_max"),
+           list(
+             vCons(
+               str(iCons(98, iCons(97, .IntSeq))),
+               vCons(str(iCons(97, iCons(98, .IntSeq))), .ValSeq))),
+           .Exprs)
+      => str(iCons(98, iCons(97, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        (.Map
