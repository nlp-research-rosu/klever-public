exec
/bin/bash -lc 'bash /audit-output/evidence/stage4_program_pinning.sh > /audit-output/evidence/stage4_program_pinning.log 2>&1; rc=$?; printf '"'exit=%d\\n' \""'$rc"; cat /audit-output/evidence/stage4_program_pinning.log; if (( rc != 0 )); then diff -u /audit-output/evidence/stage4_kast_solution.log /audit-output/evidence/stage4_kast_claim_program.log | head -160; fi; exit "$rc"' in /audit-output
