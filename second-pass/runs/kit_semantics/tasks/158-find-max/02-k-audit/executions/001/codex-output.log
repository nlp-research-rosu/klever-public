diff --git a/evidence/stage4_body_sensitivity.sh b/evidence/stage4_body_sensitivity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..82b3a102856ba6ae01209da3835134c5de9e1b08
--- /dev/null
+++ b/evidence/stage4_body_sensitivity.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/reconstruct-001
+evidence=/audit-output/evidence
+log=$evidence/stage4_body_sensitivity_kprove.log
+
