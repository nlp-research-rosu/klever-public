diff --git a/evidence/stage4_body_sensitivity.sh b/evidence/stage4_body_sensitivity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..82b3a102856ba6ae01209da3835134c5de9e1b08
--- /dev/null
