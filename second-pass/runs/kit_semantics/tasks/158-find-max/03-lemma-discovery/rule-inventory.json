{
  "inventory_sha256": "b74ac0a769f9ce93027f625ba4030e585fe307aa7c7ec1941c933938c4cea026",
  "rules": [
    {
      "attributes": [],
      "end_line": 8,
      "module": "VERIFICATION",
      "normalized_sha256": "44fe28b4800d381466b4f0054162b48095b54f30cdd880e1642b3e6fe7c27d6f",
      "source_rule_id": "rule-44fe28b4800d381466b4f0054162b48095b54f30cdd880e1642b3e6fe7c27d6f",
      "start_line": 8,
      "text": "  rule definedProjectStr(V:Val) => isStr(V)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "0dda33275c7cbd1779ea25ffe3285879bf6652eca3210dd703138ffe06f5bf83",
      "source_rule_id": "rule-0dda33275c7cbd1779ea25ffe3285879bf6652eca3210dd703138ffe06f5bf83",
      "start_line": 13,
      "text": "  rule #Ceil({@V:Val}:>Str)\n    => ({ definedProjectStr(@V) #Equals true } #And #Ceil(@V))\n    [simplification]"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "e36d5c480914b95ecfc03189a914cb697e22cf78565e60467ec0e6c664136d4a",
      "source_rule_id": "rule-e36d5c480914b95ecfc03189a914cb697e22cf78565e60467ec0e6c664136d4a",
      "start_line": 17,
      "text": "  rule projectStrTotal(V:Val) => {V}:>Str\n    requires definedProjectStr(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "db9d27e9548a05d29d1ed50dae5699e3007e66b4be241553668c21d60b3a10ae",
      "source_rule_id": "rule-db9d27e9548a05d29d1ed50dae5699e3007e66b4be241553668c21d60b3a10ae",
      "start_line": 20,
      "text": "  rule {V:Val}:>Str => projectStrTotal(V)\n    requires definedProjectStr(V)\n    [symbolic(V), simplification, preserves-definedness]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "357de5496dc1a3e3b0ca9c3b05657fc36dd604057e89554979c1533e63de589f",
      "source_rule_id": "rule-357de5496dc1a3e3b0ca9c3b05657fc36dd604057e89554979c1533e63de589f",
      "start_line": 23,
      "text": "  rule projectStrTotal(S:Str) => S [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "f85e27b93f985712e161e1d9f93c9edc4bb9b998f80b67e076ae37e57255f5e0",
      "source_rule_id": "rule-f85e27b93f985712e161e1d9f93c9edc4bb9b998f80b67e076ae37e57255f5e0",
      "start_line": 24,
      "text": "  rule projectStrTotal(projectStrTotal(V)) => projectStrTotal(V) [simplification]"
    },
    {
      "attributes": [],
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "958d625e76fa6b4192b4e6381e8af905713c413adf69067501de2d1f27b917e6",
      "source_rule_id": "rule-958d625e76fa6b4192b4e6381e8af905713c413adf69067501de2d1f27b917e6",
      "start_line": 27,
      "text": "  rule codesOf(str(CS)) => CS"
    },
    {
      "attributes": [],
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "3b8505c6c0b4c58fd103639c3144a8b121ca1f368bc7d48a365acfc91ef3978f",
      "source_rule_id": "rule-3b8505c6c0b4c58fd103639c3144a8b121ca1f368bc7d48a365acfc91ef3978f",
      "start_line": 31,
      "text": "  rule allStrings(.ValSeq) => true"
    },
    {
      "attributes": [],
      "end_line": 33,
      "module": "VERIFICATION",
      "normalized_sha256": "adae26c5e31079669a406366978f6733da2a5ecd8da0a2627536cc38654075e8",
      "source_rule_id": "rule-adae26c5e31079669a406366978f6733da2a5ecd8da0a2627536cc38654075e8",
      "start_line": 32,
      "text": "  rule allStrings(vCons(V, REST))\n    => definedProjectStr(V) andBool notBool isRefV(V) andBool allStrings(REST)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "ec057976d8c8f7e9534ebd2d518671f034dd02fd1170d6411f89c1fd1a2417c3",
      "source_rule_id": "rule-ec057976d8c8f7e9534ebd2d518671f034dd02fd1170d6411f89c1fd1a2417c3",
      "start_line": 36,
      "text": "  rule applyBuiltin(\"set\", V:Val, .Vals)\n    => setV(dedupCodes(codesOf(projectStrTotal(V))))\n    requires definedProjectStr(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "1684a1226f0f56832d19a2311f81f35f276a3945a3d87268f06be40436a1f20b",
      "source_rule_id": "rule-1684a1226f0f56832d19a2311f81f35f276a3945a3d87268f06be40436a1f20b",
      "start_line": 41,
      "text": "  rule applyCmp(\"<\", A:Val, B:Val)\n    => strLt(codesOf(projectStrTotal(A)), codesOf(projectStrTotal(B)))\n    requires definedProjectStr(A) andBool definedProjectStr(B)\n    [simplification]"
    },
    {
      "attributes": [],
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "e90dea9027e77838a76b86d178c99203269c894c3cf24ce0b678316e38f70130",
      "source_rule_id": "rule-e90dea9027e77838a76b86d178c99203269c894c3cf24ce0b678316e38f70130",
      "start_line": 48,
      "text": "  rule uniqueCount(V)\n    => isLen(dedupCodes(codesOf(projectStrTotal(V))))"
    },
    {
      "attributes": [],
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "677196bd5b936bff1955ac2e81ede8106fc48950eb2f080a9223b8c9fde2a36d",
      "source_rule_id": "rule-677196bd5b936bff1955ac2e81ede8106fc48950eb2f080a9223b8c9fde2a36d",
      "start_line": 53,
      "text": "  rule candidateWins(V, BEST, SCORE)\n    => uniqueCount(V) >Int SCORE\n       orBool (uniqueCount(V) ==Int SCORE\n               andBool strLt(\n                 codesOf(projectStrTotal(V)),\n                 codesOf(projectStrTotal(BEST))))"
    },
    {
      "attributes": [],
      "end_line": 62,
      "module": "VERIFICATION",
      "normalized_sha256": "71ed302519a1efe4f04dd36672849132119453afd4a51de86b7c18c676c2e014",
      "source_rule_id": "rule-71ed302519a1efe4f04dd36672849132119453afd4a51de86b7c18c676c2e014",
      "start_line": 62,
      "text": "  rule bestWord(.ValSeq, BEST, _SCORE) => BEST"
    },
    {
      "attributes": [],
      "end_line": 67,
      "module": "VERIFICATION",
      "normalized_sha256": "18b3cd0f0ad4149cbf97cbfbcf38117cc9faa3cca27259968e23c289fa07e1b6",
      "source_rule_id": "rule-18b3cd0f0ad4149cbf97cbfbcf38117cc9faa3cca27259968e23c289fa07e1b6",
      "start_line": 63,
      "text": "  rule bestWord(vCons(V, REST), BEST, SCORE)\n    => #if candidateWins(V, BEST, SCORE)\n       #then bestWord(REST, V, uniqueCount(V))\n       #else bestWord(REST, BEST, SCORE)\n       #fi"
    },
    {
      "attributes": [],
      "end_line": 70,
      "module": "VERIFICATION",
      "normalized_sha256": "17c0b8966b5aa9bd3ddca5892a5d0cec6c71bb4e5047318d3fc294c700e01c83",
      "source_rule_id": "rule-17c0b8966b5aa9bd3ddca5892a5d0cec6c71bb4e5047318d3fc294c700e01c83",
      "start_line": 70,
      "text": "  rule bestScore(.ValSeq, _BEST, SCORE) => SCORE"
    },
    {
      "attributes": [],
      "end_line": 75,
      "module": "VERIFICATION",
      "normalized_sha256": "5fb99ce3aff2b4cb2a9d6e2615e77a052e9ed9b58a198a68dace385a7501a66b",
      "source_rule_id": "rule-5fb99ce3aff2b4cb2a9d6e2615e77a052e9ed9b58a198a68dace385a7501a66b",
      "start_line": 71,
      "text": "  rule bestScore(vCons(V, REST), BEST, SCORE)\n    => #if candidateWins(V, BEST, SCORE)\n       #then bestScore(REST, V, uniqueCount(V))\n       #else bestScore(REST, BEST, SCORE)\n       #fi"
    },
    {
      "attributes": [],
      "end_line": 79,
      "module": "VERIFICATION",
      "normalized_sha256": "885aba145d46b0d26fa1644dd25f1d99347b1df6ea85af76094576e6f810eced",
      "source_rule_id": "rule-885aba145d46b0d26fa1644dd25f1d99347b1df6ea85af76094576e6f810eced",
      "start_line": 79,
      "text": "  rule lastWord(.ValSeq, WORD)         => WORD"
    },
    {
      "attributes": [],
      "end_line": 80,
      "module": "VERIFICATION",
      "normalized_sha256": "3a13a9d61aa9526bb06b823ee6b1d09fac49b0ac24a2a24621619023a426755a",
      "source_rule_id": "rule-3a13a9d61aa9526bb06b823ee6b1d09fac49b0ac24a2a24621619023a426755a",
      "start_line": 80,
      "text": "  rule lastWord(vCons(V, REST), _WORD) => lastWord(REST, V)"
    },
    {
      "attributes": [],
      "end_line": 83,
      "module": "VERIFICATION",
      "normalized_sha256": "e8184b6ac17231e50401fa57e8093839e7186422168d742804f36027e58204de",
      "source_rule_id": "rule-e8184b6ac17231e50401fa57e8093839e7186422168d742804f36027e58204de",
      "start_line": 83,
      "text": "  rule lastScore(.ValSeq, SCORE)         => SCORE"
    },
    {
      "attributes": [],
      "end_line": 84,
      "module": "VERIFICATION",
      "normalized_sha256": "a40b2b49225491f32cb88978d5ded791f35533704ee5a917d66805aceddef962",
      "source_rule_id": "rule-a40b2b49225491f32cb88978d5ded791f35533704ee5a917d66805aceddef962",
      "start_line": 84,
      "text": "  rule lastScore(vCons(V, REST), _SCORE) => lastScore(REST, uniqueCount(V))"
    }
