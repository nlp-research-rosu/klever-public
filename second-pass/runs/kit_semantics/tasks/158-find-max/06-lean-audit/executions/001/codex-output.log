+def valAB : SortVal := SortVal.inj_SortStr strAB
+def valABA : SortVal := SortVal.inj_SortStr strABA
+def valInt : SortVal := SortVal.inj_SortInt 97
+
+def oneArg (value : SortVal) : SortVals :=
+  SortVals.«_,__MPY-CORE_Vals_Val_Vals» value
+    SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+
+def exactStringK (value : SortStr) : SortK :=
+  SortK.kseq (SortKItem.inj_SortStr value) SortK.dotk
+
