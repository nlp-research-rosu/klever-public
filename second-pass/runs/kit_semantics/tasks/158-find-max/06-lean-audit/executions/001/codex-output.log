   320	def leftPassGo
   321	    (level : String) (current : SortInt)
   322	    (operators : List String) (operands : List SortInt)
   323	    (outOperators : List String) (outOperands : List SortInt) :
   324	    List String × List SortInt :=
   325	  match operators, operands with
   326	  | [], _ => (outOperators, appendInteger outOperands current)
   327	  | operator :: remainingOperators, next :: remainingOperands =>
   328	      if operatorAtLevel level operator then
   329	        leftPassGo level (applyArithmeticOperator operator current next)
   330	          remainingOperators remainingOperands outOperators outOperands
   331	      else
   332	        leftPassGo level next remainingOperators remainingOperands
   333	          (appendString outOperators operator) (appendInteger outOperands current)
   334	  | _ :: _, [] => (outOperators, appendInteger outOperands current)
