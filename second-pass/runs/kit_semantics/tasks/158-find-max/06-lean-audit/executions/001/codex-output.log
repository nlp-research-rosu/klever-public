     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // A guarded total twin of the partial Val-to-Str subsort projection.
     7	  syntax Bool ::= definedProjectStr(Val) [function, total]
     8	  rule definedProjectStr(V:Val) => isStr(V)
     9	
    10	  syntax Str ::= projectStrTotal(Val)
    11	    [function, total, symbol(projectStrTotal), no-evaluators]
    12	
    13	  rule #Ceil({@V:Val}:>Str)
    14	    => ({ definedProjectStr(@V) #Equals true } #And #Ceil(@V))
    15	    [simplification]
    16	
    17	  rule projectStrTotal(V:Val) => {V}:>Str
    18	    requires definedProjectStr(V)
    19	    [concrete, simplification(10), preserves-definedness]
    20	  rule {V:Val}:>Str => projectStrTotal(V)
    21	    requires definedProjectStr(V)
    22	    [symbolic(V), simplification, preserves-definedness]
    23	  rule projectStrTotal(S:Str) => S [simplification]
    24	  rule projectStrTotal(projectStrTotal(V)) => projectStrTotal(V) [simplification]
    25	
    26	  syntax IntSeq ::= codesOf(Str) [function, total]
    27	  rule codesOf(str(CS)) => CS
    28	
    29	  // The complete dynamic input-domain predicate.
    30	  syntax Bool ::= allStrings(ValSeq) [function, total]
    31	  rule allStrings(.ValSeq) => true
    32	  rule allStrings(vCons(V, REST))
    33	    => definedProjectStr(V) andBool notBool isRefV(V) andBool allStrings(REST)
    34	
    35	  // Guarded dispatch twins of the fixed set(str) and str < str equations.
    36	  rule applyBuiltin("set", V:Val, .Vals)
    37	    => setV(dedupCodes(codesOf(projectStrTotal(V))))
    38	    requires definedProjectStr(V)
    39	    [simplification]
    40	
    41	  rule applyCmp("<", A:Val, B:Val)
    42	    => strLt(codesOf(projectStrTotal(A)), codesOf(projectStrTotal(B)))
    43	    requires definedProjectStr(A) andBool definedProjectStr(B)
    44	    [simplification]
    45	
    46	  // The score used by the HumanEval contract.
    47	  syntax Int ::= uniqueCount(Val) [function, total]
    48	  rule uniqueCount(V)
    49	    => isLen(dedupCodes(codesOf(projectStrTotal(V))))
    50	
    51	  // A candidate wins on score, then on lexicographically smaller spelling.
    52	  syntax Bool ::= candidateWins(Val, Val, Int) [function, total]
    53	  rule candidateWins(V, BEST, SCORE)
    54	    => uniqueCount(V) >Int SCORE
    55	       orBool (uniqueCount(V) ==Int SCORE
    56	               andBool strLt(
    57	                 codesOf(projectStrTotal(V)),
    58	                 codesOf(projectStrTotal(BEST))))
    59	
    60	  // Exact mathematical fold computed by the outer loop.
    61	  syntax Val ::= bestWord(ValSeq, Val, Int) [function, total]
    62	  rule bestWord(.ValSeq, BEST, _SCORE) => BEST
    63	  rule bestWord(vCons(V, REST), BEST, SCORE)
    64	    => #if candidateWins(V, BEST, SCORE)
    65	       #then bestWord(REST, V, uniqueCount(V))
    66	       #else bestWord(REST, BEST, SCORE)
    67	       #fi
    68	
    69	  syntax Int ::= bestScore(ValSeq, Val, Int) [function, total]
    70	  rule bestScore(.ValSeq, _BEST, SCORE) => SCORE
    71	  rule bestScore(vCons(V, REST), BEST, SCORE)
    72	    => #if candidateWins(V, BEST, SCORE)
    73	       #then bestScore(REST, V, uniqueCount(V))
    74	       #else bestScore(REST, BEST, SCORE)
    75	       #fi
    76	
    77	  // Exact final values of the loop target and its per-element score temporary.
    78	  syntax Val ::= lastWord(ValSeq, Val) [function, total]
    79	  rule lastWord(.ValSeq, WORD)         => WORD
    80	  rule lastWord(vCons(V, REST), _WORD) => lastWord(REST, V)
    81	
    82	  syntax Int ::= lastScore(ValSeq, Int) [function, total]
    83	  rule lastScore(.ValSeq, SCORE)         => SCORE
    84	  rule lastScore(vCons(V, REST), _SCORE) => lastScore(REST, uniqueCount(V))
    85	endmodule

solution.py
     1	def find_max(words):
     2	    result = ""
     3	    max_unique = -1
     4	    word = ""
     5	    unique = -1
     6	    for word in words:
     7	        unique = len(set(word))
     8	        if unique > max_unique or unique == max_unique and word < result:
     9	            result = word
    10	            max_unique = unique
    11	    return result

