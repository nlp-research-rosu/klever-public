diff --git a//tmp/audit-work/158-find-max-proof-audit/BridgeAudit.lean b//tmp/audit-work/158-find-max-proof-audit/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..bc965c433924b4a2072c9e8467b527bc750f8493
--- /dev/null
+++ b//tmp/audit-work/158-find-max-proof-audit/BridgeAudit.lean
@@ -0,0 +1,123 @@
+import Proof
+
+namespace BridgeAudit
+
+def nilCodes : SortIntSeq := SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+def consCode (head : SortInt) (tail : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail
+
+def codesA : SortIntSeq := consCode 97 nilCodes
+def codesB : SortIntSeq := consCode 98 nilCodes
+def codesAB : SortIntSeq := consCode 97 codesB
+def codesABA : SortIntSeq := consCode 97 (consCode 98 codesA)
+def codesBA : SortIntSeq := consCode 98 codesA
+
+def strA : SortStr := SortStr.«str(_)_MPY-CORE_Str_IntSeq» codesA
+def strB : SortStr := SortStr.«str(_)_MPY-CORE_Str_IntSeq» codesB
+def strAB : SortStr := SortStr.«str(_)_MPY-CORE_Str_IntSeq» codesAB
+def strABA : SortStr := SortStr.«str(_)_MPY-CORE_Str_IntSeq» codesABA
+
+def valA : SortVal := SortVal.inj_SortStr strA
+def valB : SortVal := SortVal.inj_SortStr strB
+def valAB : SortVal := SortVal.inj_SortStr strAB
+def valABA : SortVal := SortVal.inj_SortStr strABA
+def valInt : SortVal := SortVal.inj_SortInt 97
+
+def oneArg (value : SortVal) : SortVals :=
+  SortVals.«_,__MPY-CORE_Vals_Val_Vals» value
+    SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+
+def exactStringK (value : SortStr) : SortK :=
+  SortK.kseq (SortKItem.inj_SortStr value) SortK.dotk
+
+def trailingStringK (value : SortStr) : SortK :=
+  SortK.kseq (SortKItem.inj_SortStr value)
+    (SortK.kseq (SortKItem.inj_SortInt 0) SortK.dotk)
+
+-- Each fixed target parameter is exercised on discriminating inputs.
+example : Proof._andBool_ true true = true := rfl
+example : Proof._andBool_ true false = false := rfl
+
+example : Proof.«codesOf(_)_VERIFICATION_IntSeq_Str» strABA = codesABA := rfl
+example : Proof.«dedupCodes(_)_MPY-SET_IntSeq_IntSeq» codesABA = codesAB := rfl
+example : Proof.«dedupCodes(_)_MPY-SET_IntSeq_IntSeq» codesBA = codesBA := rfl
+
+example : Proof.«definedProjectStr(_)_VERIFICATION_Bool_Val» valABA = true := rfl
+example : Proof.«definedProjectStr(_)_VERIFICATION_Bool_Val» valInt = false := rfl
+example : Proof.projectStrTotal valABA = strABA := rfl
+example : Proof.projectStrTotal valInt =
+    SortStr.«str(_)_MPY-CORE_Str_IntSeq» nilCodes := rfl
+
+example : Proof.«project:Str?» (exactStringK strABA) = some strABA := rfl
+example : Proof.«project:Str?» (trailingStringK strABA) = none := rfl
+example : Proof.«project:Str?»
+    (SortK.kseq (SortKItem.inj_SortInt 97) SortK.dotk) = none := rfl
+
+example : Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» codesA codesAB = true := rfl
+example : Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» codesAB codesA = false := rfl
+example : Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» codesA codesB = true := rfl
+example : Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» codesB codesA = false := rfl
+example : Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» codesA codesA = false := rfl
+
+example : Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+    "set" (oneArg valABA) = SortVal.«setV(_)_MPY-SET_Val_IntSeq» codesAB := rfl
+example : Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+    "set" (oneArg valInt) = SortVal.«noneV_MPY-CORE_Val» := rfl
+
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    "<" valA valB = true := rfl
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    "<" valB valA = false := rfl
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    "<" valA valA = false := rfl
+example : Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+    "<" valA valAB = true := rfl
+
+-- Counterfactual implementations are refuted by the same witnesses.
+def constantFalseDefined (_ : SortVal) : SortBool := false
+def constantEmptyProjection (_ : SortVal) : SortStr :=
+  SortStr.«str(_)_MPY-CORE_Str_IntSeq» nilCodes
+def identityDedup (codes : SortIntSeq) : SortIntSeq := codes
+def constantFalseLt (_ _ : SortIntSeq) : SortBool := false
+def constantNoneProject (_ : SortK) : Option SortStr := none
+def constantNoneBuiltin (_ : SortString) (_ : SortVals) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+def constantFalseCmp (_ : SortString) (_ _ : SortVal) : SortBool := false
+
+example : constantFalseDefined valA ≠
+    Proof.«definedProjectStr(_)_VERIFICATION_Bool_Val» valA := by decide
+example : constantEmptyProjection valABA ≠ Proof.projectStrTotal valABA := by
+  simp [constantEmptyProjection, Proof.projectStrTotal,
+    Operational.totalStringProjection, valABA, strABA, codesABA,
+    nilCodes, consCode]
+example : identityDedup codesABA ≠
+    Proof.«dedupCodes(_)_MPY-SET_IntSeq_IntSeq» codesABA := by
+  change codesABA ≠ codesAB
+  simp [codesABA, codesAB, codesA, codesB, nilCodes, consCode]
+example : constantFalseLt codesA codesB ≠
+    Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq» codesA codesB := by decide
+example : constantNoneProject (exactStringK strA) ≠
+    Proof.«project:Str?» (exactStringK strA) := by
+  simp [constantNoneProject, Proof.«project:Str?»,
+    Operational.optionalStringProjection, exactStringK]
+example : constantNoneBuiltin "set" (oneArg valABA) ≠
+    Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+      "set" (oneArg valABA) := by
+  simp [constantNoneBuiltin,
+    Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»,
+    Operational.dispatchBuiltin, oneArg, valABA, strABA]
+example : constantFalseCmp "<" valA valB ≠
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+      "<" valA valB := by decide
+
+#check Proof._andBool_
+#check Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+#check Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+#check Proof.«codesOf(_)_VERIFICATION_IntSeq_Str»
+#check Proof.«dedupCodes(_)_MPY-SET_IntSeq_IntSeq»
+#check Proof.«definedProjectStr(_)_VERIFICATION_Bool_Val»
+#check Proof.projectStrTotal
+#check Proof.«strLt(_,_)_MPY-STR_Bool_IntSeq_IntSeq»
+#check Proof.«project:Str?»
+
+end BridgeAudit
diff --git a//tmp/audit-work/check_bound_hashes.py b//tmp/audit-work/check_bound_hashes.py
new file mode 100644
index 0000000000000000000000000000000000000000..c89d180590e0bc8e20202d8a47b8b5288d9b7592
--- /dev/null
+++ b//tmp/audit-work/check_bound_hashes.py
@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract
+from tools.stage6_resolution_contract import verify_audit_input
+
+
+def file_hash(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+audit_path = Path("/audit-input.json")
+audit = json.loads(audit_path.read_text())
+resolution, resolved_digest = verify_audit_input(audit)
+expected = resolution["hashes"]
+
+trees = {
+    "k_workspace_sha256": Path("/reference/k-proof"),
+    "k_audit_sha256": Path("/reference/k-audit"),
+    "klean_generation_sha256": Path("/reference/klean-generation"),
+    "generation_producer_sources_sha256": Path("/reference/generation-tools"),
+    "lean_workspace_sha256": Path("/candidate"),
+}
+tree_results = {}
+for key, path in trees.items():
+    observed = pipeline_contract.sha256_tree(path)
+    tree_results[key] = {
+        "expected": expected[key],
+        "observed": observed,
+        "equal": observed == expected[key],
+    }
+
+export_results = {}
+for key, path in {
+    "stage1_export_sha256": Path("/reference/k-proof"),
+    "generated_tree_sha256": Path("/reference/klean-generation/generated"),
+}.items():
+    observed = klean_export.tree_digest(path)
+    export_results[key] = {
+        "expected": expected[key],
+        "observed": observed,
+        "equal": observed == expected[key],
+    }
+
+discovery_observed = file_hash(Path("/reference/lemma-discovery.json"))
+
+expected_sources = resolution["stage1_source_hashes"]
+observed_sources = {
+    path.relative_to("/reference/k-proof").as_posix(): file_hash(path)
+    for path in pipeline_contract._walk_regular_files(
+        Path("/reference/k-proof"), "mounted Stage 1 workspace"
+    )
+}
+source_mismatches = {
+    name: {"expected": expected_sources.get(name), "observed": observed_sources.get(name)}
+    for name in sorted(set(expected_sources) | set(observed_sources))
+    if expected_sources.get(name) != observed_sources.get(name)
+}
+
+source_manifest = json.loads(
+    Path("/reference/generation-tools/source-manifest.json").read_text()
+)
+generator_manifest = json.loads(
+    Path("/reference/klean-generation/generator-manifest.json").read_text()
+)
+producer_file_hashes = {
+    name: file_hash(Path("/reference/generation-tools") / name)
+    for name in ("klean_export.py", "klean.py")
+}
+image_id = generator_manifest["provenance"]["generator_image_id"]
+producer_authentication = {
+    "generator_image_id": image_id,
+    "source_manifest_image_id": source_manifest["generator_image_id"],
+    "audit_input_bundle_component": Path(
+        resolution["generation_producer_sources"]
+    ).name,
+    "image_ids_equal": (
+        source_manifest["generator_image_id"] == image_id
+        and Path(resolution["generation_producer_sources"]).name
+        == image_id.removeprefix("sha256:")
+    ),
+    "observed_file_hashes": producer_file_hashes,
+    "source_manifest_file_hashes": source_manifest["files"],
+    "generator_manifest_file_hashes": {
+        "klean_export.py": generator_manifest["exporter_sha256"],
+        "klean.py": generator_manifest["klean_py_sha256"],
+    },
+    "all_file_hashes_equal": (
+        producer_file_hashes == source_manifest["files"]
+        == {
+            "klean_export.py": generator_manifest["exporter_sha256"],
+            "klean.py": generator_manifest["klean_py_sha256"],
+        }
+    ),
+}
+
+target_observed = klean_export.target_statement(
+    Path("/reference/klean-generation/generated")
+)
+target_identity = {
+    "observed_equals_generator_manifest": target_observed
+    == generator_manifest["target"],
+    "observed_equals_audit_target": target_observed == resolution["target"],
+    "observed_equals_audit_preflight_target": target_observed
+    == resolution["stage4_preflight"]["target"],
+    "target": target_observed,
+}
+
+print(
+    json.dumps(
+        {
+            "audit_input_envelope": {
+                "status": "PASS",
+                "resolved_input_sha256": resolved_digest,
+            },
+            "pipeline_tree_hashes": tree_results,
+            "export_tree_hashes": export_results,
+            "discovery_manifest_hash": {
+                "expected": expected["discovery_manifest_sha256"],
+                "observed": discovery_observed,
+                "equal": discovery_observed
+                == expected["discovery_manifest_sha256"],
+            },
+            "stage1_per_file_hashes": {
+                "expected_count": len(expected_sources),
+                "observed_count": len(observed_sources),
+                "mismatch_count": len(source_mismatches),
+                "mismatches": source_mismatches,
+            },
+            "producer_authentication": producer_authentication,
+            "target_identity": target_identity,
+            "unmounted_recorded_hashes": {
+                "lean_invocation_sha256": expected["lean_invocation_sha256"]
+            },
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)
