     5	    Assign(Name("word"), Str(""))
     6	    Assign(Name("unique"), UnaryOp("-", Int(1)))
     7	    For(Name("word"), Name("words"),
     8	      Assign(
     9	        Name("unique"),
    10	        Call(Name("len"), Call(Name("set"), Name("word"))))
