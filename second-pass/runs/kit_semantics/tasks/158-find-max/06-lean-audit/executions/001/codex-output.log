   515	def dispatchComparison
   516	    (operator : SortString) (left right : SortVal) : SortBool :=
   517	  match left, right with
   518	  | value, SortVal.«noneV_MPY-CORE_Val» =>
   519	      if operator = "is" || operator = "==" then
   520	        match value with
   521	        | SortVal.«noneV_MPY-CORE_Val» => true
   522	        | _ => false
   523	      else if operator = "is not" || operator = "!=" then
   524	        match value with
   525	        | SortVal.«noneV_MPY-CORE_Val» => false
   526	        | _ => true
   527	      else false
