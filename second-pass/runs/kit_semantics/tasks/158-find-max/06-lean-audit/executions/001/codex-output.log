   429	
   430	def roundFloatToInteger (value : SortFloat) : SortInt :=
   431	  let floorValue := value.floor
   432	  let floorInteger := integralFloatToInteger floorValue
   433	  if (value - floorValue) == 0.5 then
   434	    if floorInteger % 2 == 0 then
   435	      floorInteger
   436	    else
   437	      ceilFloatToInteger value
   438	  else
   439	    floorFloatToInteger (value + 0.5)
   440	
   441	def tenPower (exponent : SortInt) : SortInt :=
   442	  if exponent < 0 then 1 else Int.pow 10 exponent.toNat
   443	
   444	def roundFloatAtPrecision
   445	    (value : SortFloat) (precision : SortInt) : SortFloat :=
   446	  if precision < 0 then
   447	    let scale := Float.ofInt (tenPower (0 - precision))
   448	    Float.ofInt (roundFloatToInteger (value / scale)) * scale
   449	  else
   450	    let scale := Float.ofInt (tenPower precision)
   451	    Float.ofInt (roundFloatToInteger (value * scale)) / scale
