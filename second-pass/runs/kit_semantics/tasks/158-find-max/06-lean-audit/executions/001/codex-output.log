/bin/bash -lc "script -q -e -c 'export LD_PRELOAD=/tmp/audit-work/getpid_host.so; lake env lean BridgeAudit.lean' /audit-output/evidence/18_operational_bridge_adversarial_lean.txt" in /tmp/audit-work/158-find-max-proof-audit
