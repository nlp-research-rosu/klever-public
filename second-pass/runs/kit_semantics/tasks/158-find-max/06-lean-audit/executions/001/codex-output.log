   293	def powerPass : List String → List SortInt → List String × List SortInt
   294	  | [], operands => ([], operands)
   295	  | _, [] => ([], [])
   296	  | operator :: operators, value :: values =>
   297	      let (remainingOperators, remainingValues) := powerPass operators values
   298	      if operator = "**" then
   299	        match remainingValues with
   300	        | next :: rest =>
   301	            (remainingOperators, integerPower value next :: rest)
   302	        | [] => (remainingOperators, [value])
   303	      else
   304	        (operator :: remainingOperators, value :: remainingValues)
