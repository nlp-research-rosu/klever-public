   306	def operatorAtLevel (level operator : String) : SortBool :=
   307	  if level = "mul" then
   308	    operator = "*" || operator = "//" || operator = "/"
   309	  else if level = "add" then
   310	    operator = "+" || operator = "-"
   311	  else
   312	    false
