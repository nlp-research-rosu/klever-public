     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical count of one-character strings that occur in "2357BD".
     7	  syntax Int ::= hexCount(IntSeq) [function, total]
     8	
     9	  rule hexCount(.IntSeq) => 0
    10	  rule hexCount(iCons(C:Int, CS:IntSeq))
    11	    => (#if strContains(iCons(C, .IntSeq), strToCodes("2357BD"))
    12	        #then 1
    13	        #else 0
    14	        #fi) +Int hexCount(CS)
    15	endmodule
