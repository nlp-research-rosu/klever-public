Module(
  FuncDef("hex_key", Params("num"),
    Assign(Name("count"), Int(0))
    Assign(Name("digit"), Str(""))
    For(Name("digit"), Name("num"),
      AugAssign(
        Name("count"),
        "+",
        Compare(Name("digit"), CmpOp("in", Str("2357BD")))))
    Return(Name("count")))
  Assert(Compare(Call(Name("hex_key"), Str("")), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("hex_key"), Str("AB")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("hex_key"), Str("1077E")), CmpOp("==", Int(2))))
  Assert(
    Compare(Call(Name("hex_key"), Str("ABED1A33")), CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(Name("hex_key"), Str("123456789ABCDEF0")),
      CmpOp("==", Int(6))))
  Assert(
    Compare(Call(Name("hex_key"), Str("2020")), CmpOp("==", Int(2)))))
