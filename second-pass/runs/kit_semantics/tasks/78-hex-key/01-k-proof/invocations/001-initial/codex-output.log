diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..37159c6fb3760bab556942e40ec9d9b5c6d1ab51
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,90 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [hex-loop]:
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("digit"),
+        AugAssign(
+          Name("count"),
+          "+",
+          Compare(Name("digit"), CmpOp("in", Str("2357BD")))))
+      ~> (Return(Name("count")) .Stmts)
+      ~> #endcall
+      =>
+      (Return(Name("count")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "hex_key" |-> closureVal(
+                ("num", .ParamNames),
+                (Assign(Name("count"), Int(0))
+                 Assign(Name("digit"), Str(""))
+                 For(
+                   Name("digit"),
+                   Name("num"),
+                   AugAssign(
+                     Name("count"),
+                     "+",
+                     Compare(
+                       Name("digit"),
+                       CmpOp("in", Str("2357BD")))))
+                 Return(Name("count"))),
+                0),
+              parent(-1))
+       1 |-> scope(
+              "num"   |-> str(NUMCS:IntSeq)
+              "count" |-> (ACC:Int => ACC +Int hexCount(CS))
+              "digit" |-> (DIGIT:Str => ?FINALDIGIT:Str),
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [hex-key]:
+    <k>
+      Call(Name("hex_key"), str(CS:IntSeq))
+      =>
+      ?RESULT:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "hex_key" |-> closureVal(
+                ("num", .ParamNames),
+                (Assign(Name("count"), Int(0))
+                 Assign(Name("digit"), Str(""))
+                 For(
+                   Name("digit"),
+                   Name("num"),
+                   AugAssign(
+                     Name("count"),
+                     "+",
+                     Compare(
+                       Name("digit"),
+                       CmpOp("in", Str("2357BD")))))
+                 Return(Name("count"))),
+                0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?RESULT ==Int hexCount(CS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5f623ee0ff65bccd12f8d5c36a4012bede463d5b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,15 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical count of one-character strings that occur in "2357BD".
+  syntax Int ::= hexCount(IntSeq) [function, total]
+
+  rule hexCount(.IntSeq) => 0
+  rule hexCount(iCons(C:Int, CS:IntSeq))
+    => (#if strContains(iCons(C, .IntSeq), strToCodes("2357BD"))
+        #then 1
+        #else 0
+        #fi) +Int hexCount(CS)
+endmodule

