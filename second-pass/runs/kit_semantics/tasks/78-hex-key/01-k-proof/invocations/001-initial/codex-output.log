diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..edf3c2a4922875bf2b3a9406cddc197c1bef71ab
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [hex-loop]:
+    <k>
+      #loop(
+        str(CS:IntSeq),
+        Name("digit"),
+        AugAssign(
+          Name("count"),
+          "+",
+          Compare(Name("digit"), CmpOp("in", Str("2357BD")))))
+      ~> (Return(Name("count")) .Stmts)
+      ~> #endcall
+      =>
+      (Return(Name("count")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(GLOBALS:Map, parent(-1))
+       1 |-> scope(
+              "num"   |-> str(NUMCS:IntSeq)
+              "count" |-> (ACC:Int => ACC +Int hexCount(CS))
+              "digit" |-> (DIGIT:Str => ?FINALDIGIT:Str),
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [hex-key]:
+    <k>
+      Call(Name("hex_key"), str(CS:IntSeq))
+      =>
+      ?RESULT:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "hex_key" |-> closureVal(
+                ("num", .ParamNames),
+                (Assign(Name("count"), Int(0))
+                 Assign(Name("digit"), Str(""))
+                 For(
+                   Name("digit"),
