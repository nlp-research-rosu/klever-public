    13	  rule applyMethod(str(CS:IntSeq), "isupper", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)
    14	  rule applyMethod(str(CS:IntSeq), "islower", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)
    15	  rule applyMethod(str(CS:IntSeq), "isalpha", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)
    16	  rule applyMethod(str(CS:IntSeq), "isdigit", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)
    17	
    18	  // ==== case maps ============================================================
    19	  rule applyMethod(str(CS:IntSeq), "lower",    .Vals) => str(mapLower(CS))
    20	  rule applyMethod(str(CS:IntSeq), "upper",    .Vals) => str(mapUpper(CS))
    21	  rule applyMethod(str(CS:IntSeq), "swapcase", .Vals) => str(mapSwap(CS))
    22	
    23	  // ==== join / count / strip / encode ========================================
    24	  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by
    25	  // the call layer; the result str is a value)
    26	  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))
    27	  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]
    28	  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq
    29	  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS
    30	  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
    31	    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))
    32	
    33	  // S.count(sub): non-overlapping window scan (Python str.count)
    34	  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
    35	  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
    36	  rule cntSub(.IntSeq, _:IntSeq) => 0
    37	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
    38	       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0
    39	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
    40	       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0
    41	  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]
    42	  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0
    43	  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]
    44	  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
    45	
    46	  // S.strip(): trim whitespace runs from both ends
    47	  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
    48	  syntax IntSeq ::= trimWS(IntSeq) [function, total]
    49	  rule trimWS(.IntSeq) => .IntSeq
    50	  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)
    51	  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)
    52	  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]
    53	  rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)
    54	  rule revISAcc(.IntSeq, A:IntSeq) => A
    55	  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))
    56	
    57	  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)
    58	  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)
    59	
    60	  // ==== prefix ===============================================================
    61	  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)
    62	
    63	  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========
    64	  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)
    65	  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]
    66	  rule cntOccVS(.ValSeq, _:Val)                => 0
    67	  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V
    68	  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)
    69	
    70	  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========
    71	  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
    72	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
    73	        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
    74	       [priority(40)]
    75	  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result
    76	  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)
    77	  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))
    78	       requires isWSC(C)
    79	  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)
    80	       requires notBool isWSC(C)
    81	  // flush the current token to the result list iff non-empty.
    82	  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]
    83	  rule flushTok(ACC:ValSeq, .IntSeq)            => ACC
    84	  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))
    85	  syntax Bool ::= isWSC(Int) [function, total]
    86	  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13
    87	
    88	  // split(sep='x') keyword form delegates to the positional k-cell rule
    89	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (kwV("sep", str(S:IntSeq)), .Vals))
    90	        => #applyK(toCall(boundMethodV(str(CS), "split")), (str(S), .Vals)) ... </k>
    91	       [priority(39)]
    92	
    93	  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).
    94	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (str(iCons(SEP:Int, .IntSeq)), .Vals))
    95	        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>
    96	       [priority(40)]
    97	  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token
    98	  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)
    99	  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))
   100	       requires C ==Int SEP
   101	  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))
   102	       requires notBool (C ==Int SEP)
   103	
   104	  rule applyMethod(str(CS:IntSeq), "replace", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)
   105	    => str(replaceC(CS, A, B))
   106	  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]
   107	  rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq
   108	  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A
   109	  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(C, replaceC(R, A, B)) requires notBool (C ==Int A)
   110	
   111	  // ==== char helpers =========================================================
   112	  syntax Bool ::= isUpperC(Int) [function, total]
   113	  rule isUpperC(C:Int) => C >=Int 65 andBool C <=Int 90
   114	
   115	  syntax Bool ::= isLowerC(Int) [function, total]
   116	  rule isLowerC(C:Int) => C >=Int 97 andBool C <=Int 122
   117	
   118	  syntax Bool ::= isAlphaC(Int) [function, total]
   119	  rule isAlphaC(C:Int) => isUpperC(C) orBool isLowerC(C)
   120	
   121	  syntax Bool ::= isDigitC(Int) [function, total]
   122	  rule isDigitC(C:Int) => C >=Int 48 andBool C <=Int 57
   123	
   124	  syntax Bool ::= hasUpper(IntSeq) [function, total]
   125	  rule hasUpper(.IntSeq) => false
   126	  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)
   127	
   128	  syntax Bool ::= hasLower(IntSeq) [function, total]
   129	  rule hasLower(.IntSeq) => false
   130	  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)
   131	
   132	  syntax Bool ::= allAlpha(IntSeq) [function, total]
   133	  rule allAlpha(.IntSeq) => true
   134	  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)
   135	
   136	  syntax Bool ::= allDigit(IntSeq) [function, total]
   137	  rule allDigit(.IntSeq) => true
   138	  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)
   139	
   140	  syntax Int ::= lowerC(Int) [function, total]
   141	
   142	  rule lowerC(C:Int) => C +Int 32 requires isUpperC(C)
   143	  rule lowerC(C:Int) => C         [owise]
   144	
   145	  syntax Int ::= upperC(Int) [function, total]
   146	  rule upperC(C:Int) => C -Int 32 requires isLowerC(C)
   147	  rule upperC(C:Int) => C         [owise]
   148	
   149	  syntax Int ::= swapC(Int) [function, total]
   150	  rule swapC(C:Int) => C +Int 32 requires isUpperC(C)
   151	  rule swapC(C:Int) => C -Int 32 requires isLowerC(C)
   152	  rule swapC(C:Int) => C         [owise]
   153	
   154	  syntax IntSeq ::= mapLower(IntSeq) [function, total]
   155	  rule mapLower(.IntSeq) => .IntSeq
   156	  rule mapLower(iCons(C:Int, S:IntSeq)) => iCons(lowerC(C), mapLower(S))
   157	
   158	  syntax IntSeq ::= mapUpper(IntSeq) [function, total]
   159	  rule mapUpper(.IntSeq) => .IntSeq
   160	  rule mapUpper(iCons(C:Int, S:IntSeq)) => iCons(upperC(C), mapUpper(S))
   161	
   162	  syntax IntSeq ::= mapSwap(IntSeq) [function, total]
   163	  rule mapSwap(.IntSeq) => .IntSeq
   164	  rule mapSwap(iCons(C:Int, S:IntSeq)) => iCons(swapC(C), mapSwap(S))
   165	
   166	  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]
   167	  rule startsWith(.IntSeq, _:IntSeq)               => true
   168	  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false
   169	  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)
   170	endmodule

diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..5bba4fe7fa78619d713e47416ec744e11f6b095f
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,18 @@
+def hex_key(num):
+    count = 0
+    digit = ""
+    for digit in num:
+        count += digit in "2357BD"
+    return count
+
+
+assert hex_key("") == 0
+assert hex_key("AB") == 1
+assert hex_key("1077E") == 2
+assert hex_key("ABED1A33") == 4
+assert hex_key("123456789ABCDEF0") == 6
+assert hex_key("2020") == 2
+assert hex_key("2357BD") == 6
+assert hex_key("014689ACEF") == 0
+assert hex_key("22222222") == 8
+assert hex_key("FFFFFFFF") == 0
diff --git a/evidence/constructor_compare.py b/evidence/constructor_compare.py
new file mode 100644
index 0000000000000000000000000000000000000000..5c098c18f1b5cae91d0972211ef4bcdac2f28a3c
--- /dev/null
+++ b/evidence/constructor_compare.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""Compare the proof's executed closure body with trusted-translated solution.mpy."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+def matching_paren(text: str, start: int) -> int:
+    if text[start] != "(":
+        raise ValueError("expected opening parenthesis")
+    depth = 0
+    in_string = False
+    escaped = False
+    for index in range(start, len(text)):
+        character = text[index]
+        if in_string:
+            if escaped:
+                escaped = False
+            elif character == "\\":
+                escaped = True
+            elif character == '"':
+                in_string = False
+            continue
+        if character == '"':
+            in_string = True
+        elif character == "(":
+            depth += 1
+        elif character == ")":
+            depth -= 1
+            if depth == 0:
+                return index
+    raise ValueError("unbalanced parenthesis")
+
+
+if len(sys.argv) != 5:
+    raise SystemExit(
+        "usage: constructor_compare.py SPEC.k SOLUTION.mpy DEFINITION SCRATCH"
+    )
+
+spec_path = Path(sys.argv[1])
+solution_path = Path(sys.argv[2])
+definition = Path(sys.argv[3])
+scratch = Path(sys.argv[4])
+
+spec_text = spec_path.read_text()
+binding_marker = '"hex_key" |-> closureVal('
+binding_start = spec_text.index(binding_marker)
+parameter_marker = '("num", .ParamNames),'
+parameter_end = spec_text.index(parameter_marker, binding_start) + len(
+    parameter_marker
+)
+body_start = parameter_end
+while spec_text[body_start].isspace():
+    body_start += 1
+if spec_text[body_start] != "(":
+    raise AssertionError("closure body is not an explicit Stmts sequence")
+body_end = matching_paren(spec_text, body_start)
+body = spec_text[body_start + 1 : body_end]
+closure_tail = spec_text[body_end + 1 :]
+if not closure_tail.lstrip().startswith(",\n                0)"):
+    raise AssertionError("unexpected closure parent environment")
+
+synthetic_path = scratch / "claim-closure-as-module.mpy"
+synthetic_path.write_text(
+    'Module(\n  FuncDef("hex_key", Params("num"),\n'
+    + body
+    + "))\n"
+)
+
+
+def parse(path: Path) -> dict:
+    command = [
+        "kast",
+        "--definition",
+        str(definition),
+        "--module",
+        "MPY-SYNTAX",
+        "--sort",
+        "Module",
+        "--input",
+        "program",
+        "--output",
+        "json",
+        str(path),
+    ]
+    print("INNER_COMMAND:", " ".join(command))
+    completed = subprocess.run(
+        command, check=True, stdout=subprocess.PIPE, text=True
+    )
+    return json.loads(completed.stdout)
+
+
+solution_kast = parse(solution_path)
+claim_kast = parse(synthetic_path)
+solution_term = solution_kast["term"]
+claim_term = claim_kast["term"]
+solution_serialized = json.dumps(
+    solution_term, sort_keys=True, separators=(",", ":")
+).encode()
+claim_serialized = json.dumps(
+    claim_term, sort_keys=True, separators=(",", ":")
+).encode()
+solution_hash = hashlib.sha256(solution_serialized).hexdigest()
+claim_hash = hashlib.sha256(claim_serialized).hexdigest()
+
+print(f"SOLUTION_CONSTRUCTOR_SHA256={solution_hash}")
+print(f"CLAIM_CONSTRUCTOR_SHA256={claim_hash}")
+print(f"FUNCTION_BINDING=hex_key PARAMETER=num PARENT_ENV=0")
+print(f"CONSTRUCTOR_TERMS_IDENTICAL={solution_term == claim_term}")
+
+if solution_term != claim_term:
+    raise SystemExit(1)
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..2dac0eea660953e7b11437509f12369abd2569be
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""Independent CPython differential test for HumanEval 78 (hex_key)."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import random
+import sys
+from pathlib import Path
+
+
+def load_entry(path: Path, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.hex_key
+
+
+def independent_oracle(value: str) -> int:
+    prime_digits = frozenset(("2", "3", "5", "7", "B", "D"))
+    total = 0
+    for character in value:
+        if character in prime_digits:
+            total += 1
+    return total
+
+
+if len(sys.argv) != 3:
+    raise SystemExit("usage: differential_test.py CANONICAL.py SOLUTION.py")
+
+canonical = load_entry(Path(sys.argv[1]), "trusted_canonical")
+generated = load_entry(Path(sys.argv[2]), "generated_solution")
+
+documented = {
+    "AB": 1,
+    "1077E": 2,
+    "ABED1A33": 4,
+    "123456789ABCDEF0": 6,
+    "2020": 2,
+}
+alphabet = "0123456789ABCDEF"
+
+cases: list[tuple[str, str]] = []
+cases.append(("empty", ""))
+for value, expected in documented.items():
+    cases.append((f"documented(expected={expected})", value))
+for character in alphabet:
+    cases.append(("single-character-branch", character))
+for value in (
+    "2357BD",
+    "014689ACEF",
+    "22222222",
+    "00000000",
+    "DDDDDDDD",
+    "FFFFFFFF",
+    "20" * 64,
+    "0123456789ABCDEF" * 16,
+):
+    cases.append(("boundary-pattern", value))
+
+for length in range(5):
+    for symbols in itertools.product(alphabet, repeat=length):
+        cases.append((f"exhaustive-length-{length}", "".join(symbols)))
+
+rng = random.Random(0x78A11D)
+for index in range(1000):
+    length = rng.randrange(0, 257)
+    value = "".join(rng.choice(alphabet) for _ in range(length))
+    cases.append((f"deterministic-random-{index}", value))
+
+mismatches: list[tuple[str, str, int, int, int]] = []
+for category, value in cases:
+    trusted_result = canonical(value)
+    generated_result = generated(value)
+    oracle_result = independent_oracle(value)
+    expected = documented.get(value)
+    if (
+        trusted_result != generated_result
+        or generated_result != oracle_result
+        or (expected is not None and generated_result != expected)
+    ):
+        mismatches.append(
+            (
+                category,
+                value,
+                trusted_result,
+                generated_result,
+                oracle_result,
+            )
+        )
+        if len(mismatches) >= 20:
+            break
+
+print(f"documented_cases={len(documented)}")
+print("branch_singletons=16 (true branch: 2,3,5,7,B,D; false branch: other 10)")
+print("exhaustive_domain=all uppercase hexadecimal strings of lengths 0..4")
+print("generated_domain=1000 deterministic strings of lengths 0..256")
+print(f"total_comparisons={len(cases)}")
+print(f"mismatches={len(mismatches)}")
+for mismatch in mismatches:
+    print(f"MISMATCH {mismatch!r}")
+
+if mismatches:
+    raise SystemExit(1)
diff --git a/evidence/ground_witnesses.py b/evidence/ground_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..fea6e5808682b9f2c5ff5185fa937a2ef64a5e28
--- /dev/null
+++ b/evidence/ground_witnesses.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Concrete satisfying instances of the symbolic entry claim."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.hex_key
+
+
+if len(sys.argv) != 3:
+    raise SystemExit("usage: ground_witnesses.py CANONICAL.py SOLUTION.py")
+
+canonical = load(Path(sys.argv[1]), "ground_canonical")
+solution = load(Path(sys.argv[2]), "ground_solution")
+prime_codes = frozenset((50, 51, 53, 55, 66, 68))
+
+witnesses = ("", "2", "A", "D", "AB", "ABED1A33")
+for value in witnesses:
+    codes = tuple(ord(character) for character in value)
+    claimed_hex_count = sum(code in prime_codes for code in codes)
+    trusted_result = canonical(value)
+    candidate_result = solution(value)
+    print(
+        f"value={value!r} CS={codes!r} "
+        f"hexCount={claimed_hex_count} canonical={trusted_result} "
+        f"candidate={candidate_result}"
+    )
+    assert claimed_hex_count == trusted_result == candidate_result
+
+print(
+    "SATISFYING_ENTRY_STATE: env=0; scopes={-1:builtinsScope, "
+    "0:scope(hex_key->exact closure,parent(-1))}; scopeLoc=1; "
+    "heap=.Map; heapLoc=0; stack=.List; ret=noRet; exc=NoExc; exit-code=0"
+)
diff --git a/evidence/prepare_scratch.sh b/evidence/prepare_scratch.sh
new file mode 100644
index 0000000000000000000000000000000000000000..756b93917f8a658f4ac6f37270f044f56b9d9a49
--- /dev/null
+++ b/evidence/prepare_scratch.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+scratch=/tmp/audit-work/reconstruction
+mkdir -p "$scratch"
+
+cp -a /reference/reference-semantics "$scratch/reference-semantics"
+cp -a /reference/canonical.py "$scratch/canonical.py"
+cp -a /reference/prompt.py "$scratch/prompt.py"
+cp -a /reference/py2mpy.py "$scratch/py2mpy.py"
+
+for source_name in \
+  solution.py solution.mpy verification.k spec.k prove.sh PROOF.md \
+  spec-vacuity.k spec-body-mutation.k spec-loop-body-mutation.k \
+  spec-value-mutation.k concrete_tests.py concrete_tests.mpy test_solution.py
+do
+  cp -a "/candidate/$source_name" "$scratch/$source_name"
+done
+
+find "$scratch" -maxdepth 3 -type l -print
+find "$scratch" -maxdepth 3 -type f -printf '%P\n' | sort
diff --git a/evidence/provenance_check.py b/evidence/provenance_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..97d41fe504e18d5e2ad01066a0a5df93a5a7f1dc
