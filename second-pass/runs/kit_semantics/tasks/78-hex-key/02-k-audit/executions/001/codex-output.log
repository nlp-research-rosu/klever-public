   240	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   241	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   242	  // the isFloat guard is disjoint from the existing isInt one.
   243	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   244	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   245	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   246	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   247	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   248	       requires isFloat(V)
   249	
   250	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   251	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   252	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   253	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   254	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   255	       requires isFloat(V)
   256	
   257	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   258	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   259	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   260	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   261	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   262	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   263	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   264	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   265	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   266	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   267	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   268	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   269	       requires isFloat(V)
   270	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   271	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   272	       requires isInt(V) orBool isBool(V)
   273	endmodule
FILE reference-semantics/semantics/set.k
     1	// reference/src/semantics/set.k — MPY-SET
     2	
     3	module MPY-SET
     4	  imports MPY-CORE
     5	
     6	  // a set value, carried as its distinct codes in first-seen order (order is irrelevant
     7	  // to membership/cardinality — the two observations sets support here).
     8	  syntax Val ::= setV(IntSeq)
     9	
    10	  // membership of a code in the accumulated distinct-code sequence
    11	  syntax Bool ::= codeIn(Int, IntSeq) [function, total]
    12	  rule codeIn(_:Int, .IntSeq)                => false
    13	  rule codeIn(C:Int, iCons(H:Int, T:IntSeq)) => C ==Int H orBool codeIn(C, T)
    14	
    15	  // the distinct codes of CS (insert-if-absent fold, first-seen order)
    16	  syntax IntSeq ::= dedupCodes(IntSeq)         [function, total]
    17	                  | dedupFrom(IntSeq, IntSeq)  [function, total]
    18	  rule dedupCodes(CS:IntSeq) => dedupFrom(CS, .IntSeq)
    19	  rule dedupFrom(.IntSeq, ACC:IntSeq) => ACC
    20	  rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, ACC)
    21	       requires codeIn(C, ACC)
    22	  rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, snocCode(ACC, C))
    23	       requires notBool codeIn(C, ACC)
    24	
    25	  syntax IntSeq ::= snocCode(IntSeq, Int) [function, total]
    26	  rule snocCode(.IntSeq, C:Int)                => iCons(C, .IntSeq)
    27	  rule snocCode(iCons(H:Int, T:IntSeq), C:Int) => iCons(H, snocCode(T, C))
    28	
    29	  // ==== set equality: two sets are equal iff mutually subsuming ==============
    30	  // subsetCodes(A, B) — every code of A occurs in B (duplicates in A are harmless).
    31	  syntax Bool ::= subsetCodes(IntSeq, IntSeq) [function, total]
    32	  rule subsetCodes(.IntSeq, _:IntSeq)                => true
    33	  rule subsetCodes(iCons(C:Int, S:IntSeq), B:IntSeq) => codeIn(C, B) andBool subsetCodes(S, B)
    34	
    35	  syntax Bool ::= sameSet(IntSeq, IntSeq) [function, total]
    36	  rule sameSet(A:IntSeq, B:IntSeq) => subsetCodes(A, B) andBool subsetCodes(B, A)
    37	
    38	  // set == set  (the only comparison sets support here)
    39	  rule applyCmp("==", setV(A:IntSeq), setV(B:IntSeq)) => sameSet(A, B)
    40	endmodule
FILE reference-semantics/semantics/list.k
     1	// reference/src/semantics/list.k — MPY-LIST
     2	
     3	module MPY-LIST
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-OPERATORS
     7	
     8	  // ==== iteration (the iterator protocol's list case) =======================
     9	  rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>
    10	  rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>
    11	
    12	  // ==== ListExpr: [...] literal -> a fresh heap object =======================
    13	  syntax ApplyK ::= "toList"
    14	  rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>
    15	  rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>
    16	
    17	  // ==== list ops: + / == / != ===============================================
    18	  syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]
    19	  rule valSeqConcat(.ValSeq, T:ValSeq)                => T
    20	  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))
    21	
    22	  // list + list constructs a NEW object (k-cell — it allocates; operands land here
    23	  // already deref'd). priority(45) beats the generic BinOp dispatch.
    24	  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
    25	       [priority(45)]
    26	
    27	  rule applyCmp("==", list(A:ValSeq), list(B:ValSeq)) => A ==K B
    28	  rule applyCmp("!=", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== deep equality when elements are heap objects (list-of-lists) ========
    31	  // Python == is structural at every depth. Fires ONLY when a ref is present
    32	  // (the guard decides on concrete seqs); the plain ==K path above is unchanged.
    33	  syntax Bool ::= hasRefVS(ValSeq) [function, total]
    34	  rule hasRefVS(.ValSeq)                => false
    35	  rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)
    36	
    37	  syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]
    38	                | deepEqV(Val, Val, Map)        [function]
    39	  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true
    40	  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false
    41	  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false
    42	  rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)
    43	    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)
    44	
    45	  rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)
    46	       requires H in_keys(HP)
    47	  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
    48	       requires notBool isRefV(A) andBool H in_keys(HP)
    49	  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)
    50	  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]
    51	
    52	  // ==== mutator: xs.append(v) — an in-place heap write ======================
    53	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
    54	       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
    55	       [priority(40)]
    56	
    57	  // ==== `x in list` — a <k>-cell fold over #iterNext ========================
    58	  syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | "#notB"
    59	  rule <k> Compare(LV:Val, CmpOp("in",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>
    60	  rule <k> Compare(LV:Val, CmpOp("not in", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>
    61	  rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>
    62	  rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>
    63	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    64	       requires E ==K V
    65	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    66	       requires notBool (E ==K V)
    67	  rule <k> B:Bool ~> #notB => notBool B ... </k>
    68	endmodule
FILE reference-semantics/semantics/tuple.k
     1	// reference/src/semantics/tuple.k — MPY-TUPLE
     2	
     3	module MPY-TUPLE
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-LIST
     7	  imports MPY-METHODS
     8	
     9	  // ==== iteration (the iterator protocol's tuple case) ======================
    10	  rule <k> #iterNext(tuple(.ValSeq))                => #iterDone ... </k>
    11	  rule <k> #iterNext(tuple(vCons(V:Val, R:ValSeq))) => #iterYield(V, tuple(R)) ... </k>
    12	
    13	  // ==== TupleExpr: tuple(ValSeq) literal + == != ===========================
    14	  syntax ApplyK ::= "toTuple"
    15	  rule <k> TupleExpr(ES:Exprs) => #evalArgs(ES, .Vals, toTuple) ... </k>
    16	  rule <k> #applyK(toTuple, ACC:Vals) => tuple(vals2valSeq(ACC)) ... </k>
    17	
    18	  rule applyCmp("==", tuple(A:ValSeq), tuple(B:ValSeq)) => A ==K B
    19	  // membership routes through the same k-cell fold as lists (list.k)
    20	  rule <k> Compare(LV:Val, CmpOp("in",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>
    21	  rule <k> Compare(LV:Val, CmpOp("not in", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>
    22	  // t.index(v): first index of v (ValueError out of subset)
    23	  rule applyMethod(tuple(VS:ValSeq), "index", V:Val, .Vals) => idxOfVS(VS, V, 0)
    24	  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]
    25	  rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V
    26	  rule idxOfVS(vCons(A:Val, R:ValSeq), V:Val, I:Int) => idxOfVS(R, V, I +Int 1)
    27	       requires notBool (A ==K V)
    28	  rule applyCmp("!=", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== target binding: bind a Name or a TupleExpr target to a value ========
    31	  syntax KItem ::= #bindTgt(Expr, Val)
    32	  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
    33	       <env> L:Int </env>
    34	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
    35	  rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
    36	       <env> L:Int </env>
    37	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    38	       requires "$cells" in_keys(M)
    39	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
    40	        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
    41	       [priority(40)]
    42	  rule <k> #bindTgt(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
    43	  rule <k> #bindTgt(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
    44	  rule <k> #bindTgt(TupleExpr(TS:Exprs), ref(H:Int)) => #bindTgt(TupleExpr(TS), V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	
    48	  // ==== unpacking: a, b = <tuple|list> (RHS evaluated by strictness) ========
    49	  syntax KItem ::= #unpackSeq(Exprs, ValSeq)
    50	  rule <k> Assign(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
    51	  rule <k> Assign(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
    52	  rule <k> Assign(TupleExpr(TS:Exprs), ref(H:Int)) => Assign(TupleExpr(TS), V) ... </k>
    53	       <heap> ... H |-> V:Val ... </heap>
    54	       [priority(40)]
    55	  rule <k> #unpackSeq((T:Expr, TS:Exprs), vCons(V:Val, VS:ValSeq))
    56	        => #bindTgt(T, V) ~> #unpackSeq(TS, VS) ... </k>
    57	  rule <k> #unpackSeq(.Exprs, .ValSeq) => .K ... </k>
    58	endmodule

diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..5bba4fe7fa78619d713e47416ec744e11f6b095f
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,18 @@
+def hex_key(num):
+    count = 0
+    digit = ""
+    for digit in num:
+        count += digit in "2357BD"
+    return count
+
+
+assert hex_key("") == 0
+assert hex_key("AB") == 1
+assert hex_key("1077E") == 2
+assert hex_key("ABED1A33") == 4
+assert hex_key("123456789ABCDEF0") == 6
+assert hex_key("2020") == 2
+assert hex_key("2357BD") == 6
+assert hex_key("014689ACEF") == 0
+assert hex_key("22222222") == 8
+assert hex_key("FFFFFFFF") == 0
diff --git a/evidence/constructor_compare.py b/evidence/constructor_compare.py
new file mode 100644
index 0000000000000000000000000000000000000000..5c098c18f1b5cae91d0972211ef4bcdac2f28a3c
--- /dev/null
+++ b/evidence/constructor_compare.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""Compare the proof's executed closure body with trusted-translated solution.mpy."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+def matching_paren(text: str, start: int) -> int:
+    if text[start] != "(":
+        raise ValueError("expected opening parenthesis")
+    depth = 0
+    in_string = False
+    escaped = False
+    for index in range(start, len(text)):
+        character = text[index]
+        if in_string:
+            if escaped:
+                escaped = False
+            elif character == "\\":
+                escaped = True
+            elif character == '"':
+                in_string = False
+            continue
+        if character == '"':
+            in_string = True
+        elif character == "(":
+            depth += 1
+        elif character == ")":
+            depth -= 1
+            if depth == 0:
+                return index
+    raise ValueError("unbalanced parenthesis")
+
+
+if len(sys.argv) != 5:
+    raise SystemExit(
+        "usage: constructor_compare.py SPEC.k SOLUTION.mpy DEFINITION SCRATCH"
+    )
+
+spec_path = Path(sys.argv[1])
+solution_path = Path(sys.argv[2])
+definition = Path(sys.argv[3])
+scratch = Path(sys.argv[4])
+
+spec_text = spec_path.read_text()
+binding_marker = '"hex_key" |-> closureVal('
+binding_start = spec_text.index(binding_marker)
+parameter_marker = '("num", .ParamNames),'
+parameter_end = spec_text.index(parameter_marker, binding_start) + len(
+    parameter_marker
+)
+body_start = parameter_end
+while spec_text[body_start].isspace():
+    body_start += 1
+if spec_text[body_start] != "(":
+    raise AssertionError("closure body is not an explicit Stmts sequence")
+body_end = matching_paren(spec_text, body_start)
+body = spec_text[body_start + 1 : body_end]
+closure_tail = spec_text[body_end + 1 :]
+if not closure_tail.lstrip().startswith(",\n                0)"):
+    raise AssertionError("unexpected closure parent environment")
+
+synthetic_path = scratch / "claim-closure-as-module.mpy"
+synthetic_path.write_text(
+    'Module(\n  FuncDef("hex_key", Params("num"),\n'
+    + body
+    + "))\n"
+)
+
+
+def parse(path: Path) -> dict:
+    command = [
+        "kast",
+        "--definition",
+        str(definition),
+        "--module",
+        "MPY-SYNTAX",
+        "--sort",
+        "Module",
+        "--input",
+        "program",
+        "--output",
+        "json",
+        str(path),
+    ]
+    print("INNER_COMMAND:", " ".join(command))
+    completed = subprocess.run(
+        command, check=True, stdout=subprocess.PIPE, text=True
+    )
+    return json.loads(completed.stdout)
+
+
+solution_kast = parse(solution_path)
+claim_kast = parse(synthetic_path)
+solution_term = solution_kast["term"]
+claim_term = claim_kast["term"]
+solution_serialized = json.dumps(
+    solution_term, sort_keys=True, separators=(",", ":")
+).encode()
+claim_serialized = json.dumps(
+    claim_term, sort_keys=True, separators=(",", ":")
+).encode()
+solution_hash = hashlib.sha256(solution_serialized).hexdigest()
+claim_hash = hashlib.sha256(claim_serialized).hexdigest()
+
+print(f"SOLUTION_CONSTRUCTOR_SHA256={solution_hash}")
+print(f"CLAIM_CONSTRUCTOR_SHA256={claim_hash}")
+print(f"FUNCTION_BINDING=hex_key PARAMETER=num PARENT_ENV=0")
+print(f"CONSTRUCTOR_TERMS_IDENTICAL={solution_term == claim_term}")
+
+if solution_term != claim_term:
+    raise SystemExit(1)
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..2dac0eea660953e7b11437509f12369abd2569be
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""Independent CPython differential test for HumanEval 78 (hex_key)."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import random
+import sys
+from pathlib import Path
+
+
+def load_entry(path: Path, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.hex_key
+
+
+def independent_oracle(value: str) -> int:
+    prime_digits = frozenset(("2", "3", "5", "7", "B", "D"))
+    total = 0
+    for character in value:
+        if character in prime_digits:
+            total += 1
+    return total
+
+
+if len(sys.argv) != 3:
+    raise SystemExit("usage: differential_test.py CANONICAL.py SOLUTION.py")
+
+canonical = load_entry(Path(sys.argv[1]), "trusted_canonical")
+generated = load_entry(Path(sys.argv[2]), "generated_solution")
+
+documented = {
+    "AB": 1,
+    "1077E": 2,
+    "ABED1A33": 4,
+    "123456789ABCDEF0": 6,
+    "2020": 2,
+}
+alphabet = "0123456789ABCDEF"
+
+cases: list[tuple[str, str]] = []
+cases.append(("empty", ""))
+for value, expected in documented.items():
+    cases.append((f"documented(expected={expected})", value))
+for character in alphabet:
+    cases.append(("single-character-branch", character))
+for value in (
+    "2357BD",
+    "014689ACEF",
+    "22222222",
+    "00000000",
+    "DDDDDDDD",
+    "FFFFFFFF",
+    "20" * 64,
+    "0123456789ABCDEF" * 16,
+):
+    cases.append(("boundary-pattern", value))
+
+for length in range(5):
+    for symbols in itertools.product(alphabet, repeat=length):
+        cases.append((f"exhaustive-length-{length}", "".join(symbols)))
+
+rng = random.Random(0x78A11D)
+for index in range(1000):
+    length = rng.randrange(0, 257)
+    value = "".join(rng.choice(alphabet) for _ in range(length))
+    cases.append((f"deterministic-random-{index}", value))
+
+mismatches: list[tuple[str, str, int, int, int]] = []
+for category, value in cases:
+    trusted_result = canonical(value)
+    generated_result = generated(value)
+    oracle_result = independent_oracle(value)
+    expected = documented.get(value)
+    if (
+        trusted_result != generated_result
+        or generated_result != oracle_result
+        or (expected is not None and generated_result != expected)
+    ):
+        mismatches.append(
+            (
+                category,
+                value,
+                trusted_result,
+                generated_result,
+                oracle_result,
+            )
+        )
+        if len(mismatches) >= 20:
+            break
+
+print(f"documented_cases={len(documented)}")
+print("branch_singletons=16 (true branch: 2,3,5,7,B,D; false branch: other 10)")
+print("exhaustive_domain=all uppercase hexadecimal strings of lengths 0..4")
+print("generated_domain=1000 deterministic strings of lengths 0..256")
+print(f"total_comparisons={len(cases)}")
+print(f"mismatches={len(mismatches)}")
+for mismatch in mismatches:
+    print(f"MISMATCH {mismatch!r}")
+
+if mismatches:
+    raise SystemExit(1)
diff --git a/evidence/ground_witnesses.py b/evidence/ground_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..fea6e5808682b9f2c5ff5185fa937a2ef64a5e28
--- /dev/null
+++ b/evidence/ground_witnesses.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Concrete satisfying instances of the symbolic entry claim."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.hex_key
+
+
+if len(sys.argv) != 3:
+    raise SystemExit("usage: ground_witnesses.py CANONICAL.py SOLUTION.py")
+
+canonical = load(Path(sys.argv[1]), "ground_canonical")
+solution = load(Path(sys.argv[2]), "ground_solution")
+prime_codes = frozenset((50, 51, 53, 55, 66, 68))
+
+witnesses = ("", "2", "A", "D", "AB", "ABED1A33")
+for value in witnesses:
+    codes = tuple(ord(character) for character in value)
+    claimed_hex_count = sum(code in prime_codes for code in codes)
+    trusted_result = canonical(value)
+    candidate_result = solution(value)
+    print(
+        f"value={value!r} CS={codes!r} "
+        f"hexCount={claimed_hex_count} canonical={trusted_result} "
+        f"candidate={candidate_result}"
+    )
+    assert claimed_hex_count == trusted_result == candidate_result
+
+print(
+    "SATISFYING_ENTRY_STATE: env=0; scopes={-1:builtinsScope, "
+    "0:scope(hex_key->exact closure,parent(-1))}; scopeLoc=1; "
+    "heap=.Map; heapLoc=0; stack=.List; ret=noRet; exc=NoExc; exit-code=0"
+)
