+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "hex_key" |-> closureVal(
+                ("num", .ParamNames),
+                (Assign(Name("count"), Int(0))
+                 Assign(Name("digit"), Str(""))
+                 For(
+                   Name("digit"),
