index 0000000000000000000000000000000000000000..43e57252585708322e115a31df88171dabcbc6ee
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG_FILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$audit_log"
+
+set +e
+"$@" > >(tee -a "$audit_log") 2>&1
+audit_status=$?
+set -e
+
+{
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} | tee -a "$audit_log"
+
+exit "$audit_status"

exec
/bin/bash -lc "/audit-output/evidence/run_logged.sh /audit-output/evidence/stage3-concrete-translate.log bash -c 'python3 /tmp/audit-work/reconstruction/py2mpy.py /audit-output/evidence/concrete_audit.py > /tmp/audit-work/reconstruction/concrete_audit.mpy' && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage3-krun-concrete.log krun concrete_audit.mpy --definition runtime-audit-kompiled" in /tmp/audit-work/reconstruction
