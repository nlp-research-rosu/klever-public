index 0000000000000000000000000000000000000000..43e57252585708322e115a31df88171dabcbc6ee
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG_FILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$audit_log"
+
+set +e
+"$@" > >(tee -a "$audit_log") 2>&1
+audit_status=$?
+set -e
+
+{
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} | tee -a "$audit_log"
+
+exit "$audit_status"

exec
/bin/bash -lc "find / -xdev -type f \\( -name '*.py' -o -name '*.sh' \\) -size -2M -print 2>/dev/null | while IFS= read -r audit_source; do rg -l \"audit_campaign_lock_sha256|candidate_reference_semantics_sha256\" \""'$audit_source" 2>/dev/null; done | head -100' in /audit-output
