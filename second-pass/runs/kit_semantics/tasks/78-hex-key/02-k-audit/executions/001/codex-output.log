@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG_FILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$audit_log"
+
+set +e
+"$@" > >(tee -a "$audit_log") 2>&1
+audit_status=$?
+set -e
+
+{
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} | tee -a "$audit_log"
+
+exit "$audit_status"

exec
/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/stage6-mutation-dry-run.log kprove fresh-false-mutation.k --definition verification-audit-kompiled --spec-module AUDITOR-FRESH-FALSE-MUTATION --claims AUDITOR-FRESH-FALSE-MUTATION.bd2-is-two,SPEC.hex-loop --trusted SPEC.hex-loop --dry-run' in /tmp/audit-work/reconstruction
