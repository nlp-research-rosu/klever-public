+  claim [bd2-is-two]:
+    <k>
+      Call(
+        Name("hex_key"),
+        str(iCons(66, iCons(68, iCons(50, .IntSeq)))))
+      =>
+      2
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "hex_key" |-> closureVal(
+                ("num", .ParamNames),
