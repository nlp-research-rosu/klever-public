     1	def specialFilter(nums):
     2	    count = 0
     3	    num = 0
     4	    text = ""
     5	    for num in nums:
     6	        if num > 10:
     7	            text = str(num)
     8	            if ord(text[0]) % 2 == 1:
     9	                if ord(text[-1]) % 2 == 1:
    10	                    count += 1
    11	    return count
