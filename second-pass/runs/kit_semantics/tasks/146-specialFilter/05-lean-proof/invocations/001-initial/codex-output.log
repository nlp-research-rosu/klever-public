requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Exact syntactic abbreviations for the translated Python body.
  syntax Stmts ::= filterBody() [macro]
  rule filterBody()
    => If(
         Compare(Name("num"), CmpOp(">", Int(10))),
         Assign(Name("text"), Call(Name("str"), Name("num")))
         If(
           Compare(
             BinOp(
               "%",
               Call(Name("ord"), Subscript(Name("text"), Int(0))),
               Int(2)),
             CmpOp("==", Int(1))),
           If(
             Compare(
               BinOp(
                 "%",
                 Call(
                   Name("ord"),
                   Subscript(Name("text"), UnaryOp("-", Int(1)))),
                 Int(2)),
               CmpOp("==", Int(1))),
             AugAssign(Name("count"), "+", Int(1)),
             .Stmts),
           .Stmts),
         .Stmts)

  syntax Stmts ::= specialFilterStmts() [macro]
  rule specialFilterStmts()
    => Assign(Name("count"), Int(0))
       Assign(Name("num"), Int(0))
       Assign(Name("text"), Str(""))
       For(Name("num"), Name("nums"), filterBody())
       Return(Name("count"))

  // The contract domain: arbitrary finite Python lists whose values are Ints.
  syntax Bool ::= allInts(ValSeq) [function, total]
  rule allInts(.ValSeq) => true
  rule allInts(vCons(V:Val, REST:ValSeq))
    => isInt(V) andBool allInts(REST)

  // Guarded total projection from the dynamic Val sort to Int. This is the
  // standard K total-projection pattern: it is connected to the built-in
  // partial subsort cast and can only be used while isInt(V) is entailed.
  syntax Bool ::= definedProjectInt(Val) [function, total]
  rule definedProjectInt(V:Val) => isInt(V)

  syntax Int ::= projectIntTotal(Val)
    [function, total, symbol(projectIntTotal), no-evaluators]

  rule #Ceil({@V:Val}:>Int)
    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    [simplification]

  rule projectIntTotal(V:Val) => {V}:>Int
    requires definedProjectInt(V)
    [concrete, simplification(10), preserves-definedness]
  rule {V:Val}:>Int => projectIntTotal(V)
    requires definedProjectInt(V)
    [symbolic(V), simplification, preserves-definedness]

  rule projectIntTotal(N:Int) => N [simplification]
  rule projectIntTotal(projectIntTotal(V:Val))
    => projectIntTotal(V)
    [simplification]

  // Guarded dispatch twins of the exact frozen-semantics equations used by the
  // program when a dynamically sorted list element is known to be an Int.
  rule applyCmp(">", V:Val, I:Int)
    => projectIntTotal(V) >Int I
    requires definedProjectInt(V)
    [simplification]

  rule applyBuiltin("str", V:Val, .Vals)
    => str(strToCodes(Int2String(projectIntTotal(V))))
    requires definedProjectInt(V)
    [simplification]

  // Decimal character codes used by the implementation. Int2String is the
  // fixed K STRING operation used by the supplied Python str(int) semantics.
  syntax Int ::= firstDecimalCode(Int) [function, total]
               | lastDecimalCode(Int)  [function, total]
  rule firstDecimalCode(N:Int)
    => intSeqAt(strToCodes(Int2String(N)), 0)
  rule lastDecimalCode(N:Int)
    => intSeqAt(
         strToCodes(Int2String(N)),
         -1 +Int isLen(strToCodes(Int2String(N))))

  syntax Bool ::= isSpecial(Int) [function, total]
                | firstDigitOdd(Int) [function, total]
                | lastDigitOdd(Int)  [function, total]
  rule firstDigitOdd(N:Int)
    => pyMod(firstDecimalCode(N), 2) ==Int 1
  rule lastDigitOdd(N:Int)
    => pyMod(lastDecimalCode(N), 2) ==Int 1
  rule isSpecial(N:Int)
    => N >Int 10
       andBool firstDigitOdd(N)
       andBool lastDigitOdd(N)

  // Mathematical count of qualifying elements in an arbitrary finite input.
  syntax Int ::= specialCount(ValSeq) [function, total]
  rule specialCount(.ValSeq) => 0 [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => 1 +Int specialCount(REST)
    requires definedProjectInt(V)
     andBool projectIntTotal(V) >Int 10
     andBool firstDigitOdd(projectIntTotal(V))
     andBool lastDigitOdd(projectIntTotal(V))
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires definedProjectInt(V)
     andBool notBool (projectIntTotal(V) >Int 10)
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires definedProjectInt(V)
     andBool projectIntTotal(V) >Int 10
     andBool notBool firstDigitOdd(projectIntTotal(V))
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires definedProjectInt(V)
     andBool projectIntTotal(V) >Int 10
     andBool firstDigitOdd(projectIntTotal(V))
     andBool notBool lastDigitOdd(projectIntTotal(V))
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires notBool definedProjectInt(V)
    [simplification]
endmodule
// reference/src/semantics/int.k — MPY-INT
// Int cases of the operator dispatch; Python // and % are floored (pyMod).

module MPY-INT
  imports MPY-CORE

  rule applyUn("-", I:Int) => 0 -Int I

  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
  // Bool participates in int arithmetic (x += (a == b))
  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
  // bool is a subtype of int: any Bool operand promotes to 0/1 and re-dispatches
  // to the Int cases (the "+" mixed cases above are kept, so "+" is excluded here
  // to avoid a duplicate rule — Bool + Bool still promotes via the Bool x Bool rule).
  rule applyBin(OP:String, B1:Bool, B2:Bool) => applyBin(OP, boolAsInt(B1), boolAsInt(B2))
       requires isArithOp(OP)
  rule applyBin(OP:String, B:Bool, I:Int)    => applyBin(OP, boolAsInt(B), I)
       requires isArithOp(OP) andBool OP =/=String "+"
  rule applyBin(OP:String, I:Int, B:Bool)    => applyBin(OP, I, boolAsInt(B))
       requires isArithOp(OP) andBool OP =/=String "+"
  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0

  syntax Int ::= pyMod(Int, Int) [function]
  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2

  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
endmodule
// reference/src/semantics/bool.k — MPY-BOOL
// Bool operator cases + the truthy boolean operations (not / and / or; and-or are
// value-returning short-circuit over any Vals, per Python).

module MPY-BOOL
  imports MPY-CORE

  rule applyUn("not", V:Val) => notBool truthy(V)

  rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
  rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2

  // bool is a subtype of int: a Bool compared with an Int promotes to 0/1 and
  // re-dispatches to the Int comparison cases (True==1, False==0, True<2, ...).
  // The == / != Bool x Bool cases above are kept; only the four ordering ops are
  // promoted for Bool x Bool (to avoid duplicating the two rules above).
  rule applyCmp(OP:String, B:Bool, I:Int) => applyCmp(OP, boolAsInt(B), I)
       requires isEqOrdOp(OP)
  rule applyCmp(OP:String, I:Int, B:Bool) => applyCmp(OP, I, boolAsInt(B))
       requires isEqOrdOp(OP)
  rule applyCmp(OP:String, B1:Bool, B2:Bool) => applyCmp(OP, boolAsInt(B1), boolAsInt(B2))
       requires isOrdOp(OP)

  // ==== BoolOp: short-circuit, value-returning and / or =====================
  // the node is its own accumulator: heat the HEAD element only, then either return it
  // (short-circuit) or drop it and continue
  context BoolOp(_, (HOLE:Expr, _:Exprs))
  rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
  rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
       requires truthy(V)
  rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
       requires notBool truthy(V)
  rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
       requires truthy(V)
  rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
       requires notBool truthy(V)

  // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
  // operand — and/or return the OBJECT itself (Python identity), not its structure
  rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
       [priority(40)]
  rule <k> BoolOp("and", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       requires truthy(V)
       [priority(40)]
  rule <k> BoolOp("and", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
       <heap> ... H |-> V:Val ... </heap>
