codex
I found the launcher defect precisely: this container’s PID namespace exposes `/proc/self/exe` but not `/proc/<getpid>/exe`, while Lean 4.22 resolves its application path only through the latter. I’m applying a temporary runtime-only path shim (outside the proof workspace) so the pinned toolchain can execute unchanged; no project or dependency configuration is being modified.
apply patch
patch: completed
/tmp/lean-proc-self-shim.c
diff --git a//tmp/lean-proc-self-shim.c b//tmp/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..1ff83d48670e15dfe6af943ab9234f2c5728d53d
--- /dev/null
+++ b//tmp/lean-proc-self-shim.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (path != NULL && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + strlen(path) - 4, "/exe") == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}
