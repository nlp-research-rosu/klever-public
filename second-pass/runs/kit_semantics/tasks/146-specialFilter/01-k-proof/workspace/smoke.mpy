Module(
  FuncDef("specialFilter", Params("nums"),
    Assign(Name("count"), Int(0))
    Assign(Name("num"), Int(0))
    Assign(Name("text"), Str(""))
    For(Name("num"), Name("nums"),
      If(Compare(Name("num"), CmpOp(">", Int(10))),
        Assign(Name("text"), Call(Name("str"), Name("num")))
        If(Compare(
          BinOp(
            "%",
            Call(Name("ord"), Subscript(Name("text"), Int(0))),
            Int(2)),
          CmpOp("==", Int(1))),
          If(Compare(
            BinOp(
              "%",
              Call(
                Name("ord"),
                Subscript(Name("text"), UnaryOp("-", Int(1)))),
              Int(2)),
            CmpOp("==", Int(1))),
            AugAssign(Name("count"), "+", Int(1)),
            ),
          ),
        ))
    Return(Name("count")))
  Assert(
    Compare(
      Call(
        Name("specialFilter"),
        ListExpr(
          Int(15),
          UnaryOp("-", Int(73)),
          Int(14),
          UnaryOp("-", Int(15)))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("specialFilter"),
        ListExpr(
          Int(33),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)),
          Int(45),
          Int(21),
          Int(109))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("specialFilter"), ListExpr()),
      CmpOp("==", Int(0)))))
