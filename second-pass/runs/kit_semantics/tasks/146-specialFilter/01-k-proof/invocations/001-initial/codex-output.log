diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..edae64a96992bbf2e25ae73bb988488ff188a695
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: count starts at 1 instead of 0. The original
+  // empty-input postcondition must therefore be rejected.
+  claim [changed-initial-count]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "specialFilter",
+            Params("nums"),
+            Assign(Name("count"), Int(1))
+            Assign(Name("num"), Int(0))
+            Assign(Name("text"), Str(""))
+            For(Name("num"), Name("nums"), filterBody())
+            Return(Name("count")))))
+      ~> Call(Name("specialFilter"), list(.ValSeq))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              .Map
+              => "specialFilter"
+                 |-> closureVal(
+                       "nums",
+                       Assign(Name("count"), Int(1))
+                       Assign(Name("num"), Int(0))
+                       Assign(Name("text"), Str(""))
+                       For(Name("num"), Name("nums"), filterBody())
+                       Return(Name("count")),
+                       0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..7a95d016128d9750d289ddae1b6f9be9fc325e77
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,34 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false postcondition for the realizable empty input.
+  claim [wrong-result-empty]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "specialFilter",
+            Params("nums"),
+            specialFilterStmts())))
+      ~> Call(Name("specialFilter"), list(.ValSeq))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              .Map
+              => "specialFilter"
+                 |-> closureVal("nums", specialFilterStmts(), 0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
