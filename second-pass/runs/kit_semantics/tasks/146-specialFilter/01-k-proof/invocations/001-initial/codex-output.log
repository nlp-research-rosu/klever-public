+    <k>
+      #loop(list(intsToVals(INPUT:IntSeq)), Name("num"), filterBody())
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(GLOBALS:Map, parent(-1))
+       L |-> scope(
+              "nums"  |-> NUMS:Val
+              "count" |-> (COUNT:Int => COUNT +Int specialCount(INPUT))
+              "num"   |-> (OLD-NUM:Int => ?FINAL-NUM:Int)
+              "text"  |-> (str(OLD-TEXT:IntSeq) => str(?FINAL-TEXT:IntSeq)),
+              parent(0))
+    </scopes>
+    <scopeLoc> NEXT-SCOPE:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT-HEAP:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires L =/=Int 0 andBool L =/=Int -1
+
+  // Required target: load the exact solution body and call it on every
+  // arbitrary finite integer list represented by the supplied semantics.
+  claim [special-filter]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "specialFilter",
+            Params("nums"),
+            specialFilterStmts())))
+      ~> Call(Name("specialFilter"), list(intsToVals(INPUT:IntSeq)))
+      => specialCount(INPUT)
