+def specialFilter(nums):
+    count = 0
+    num = 0
+    text = ""
+    for num in nums:
+        if num > 10:
+            text = str(num)
+            if ord(text[0]) % 2 == 1:
+                if ord(text[-1]) % 2 == 1:
+                    count += 1
