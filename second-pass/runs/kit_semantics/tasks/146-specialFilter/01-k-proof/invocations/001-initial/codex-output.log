    requires definedProjectInt(V)
     andBool notBool (projectIntTotal(V) >Int 10)
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires definedProjectInt(V)
     andBool projectIntTotal(V) >Int 10
     andBool notBool firstDigitOdd(projectIntTotal(V))
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires definedProjectInt(V)
     andBool projectIntTotal(V) >Int 10
     andBool firstDigitOdd(projectIntTotal(V))
     andBool notBool lastDigitOdd(projectIntTotal(V))
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires notBool definedProjectInt(V)
    [simplification]
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Loop circularity: from any loop head, count gains exactly the number of
  // qualifying integers in the unbounded remaining sequence.
  claim [filter-loop]:
    <k>
      #loop(list(INPUT:ValSeq), Name("num"), filterBody())
      ~> (Return(Name("count")) .Stmts)
      ~> #endcall
      ~> .K
      =>
      (Return(Name("count")) .Stmts)
      ~> #endcall
      ~> .K
    </k>
    <env> 1 </env>
    <scopes>
      -1 |-> builtinsScope
       0 |-> scope(
              "specialFilter"
              |-> closureVal("nums", specialFilterStmts(), 0),
              parent(-1))
       1 |-> scope(
              "nums"  |-> list(ORIGINAL:ValSeq)
              "count" |-> (COUNT:Int => COUNT +Int specialCount(INPUT))
              "num"   |-> (OLDNUM:Val => ?FINALNUM:Val)
              "text"  |-> (str(OLDTEXT:IntSeq) => str(?FINALTEXT:IntSeq)),
              parent(0))
    </scopes>
    <scopeLoc> 2 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(INPUT)

  // Required target: load the exact solution body and call it on every
  // arbitrary finite integer list represented by the supplied semantics.
  claim [special-filter]:
    <k>
      #loadAll(
        Module(
          FuncDef(
            "specialFilter",
            Params("nums"),
            specialFilterStmts())))
      ~> Call(Name("specialFilter"), list(INPUT:ValSeq))
      => specialCount(INPUT)
    </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
       0 |-> scope(
              .Map
              => "specialFilter"
                 |-> closureVal("nums", specialFilterStmts(), 0),
              parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(INPUT)
endmodule
#!/usr/bin/env bash
set -eu

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun smoke.mpy --definition runtime-kompiled

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

python3 test_solution.py

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY; then
  echo "ERROR: false-postcondition mutation unexpectedly proved"
  exit 1
else
  echo "EXPECTED_FAILURE: false-postcondition mutation rejected"
fi

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION; then
  echo "ERROR: changed-body mutation unexpectedly proved"
  exit 1
else
  echo "EXPECTED_FAILURE: changed-body mutation rejected"
fi

if kprove spec-value-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-VALUE-MUTATION; then
  echo "ERROR: opposite-value mutation unexpectedly proved"
  exit 1
else
  echo "EXPECTED_FAILURE: opposite-value mutation rejected"
fi
