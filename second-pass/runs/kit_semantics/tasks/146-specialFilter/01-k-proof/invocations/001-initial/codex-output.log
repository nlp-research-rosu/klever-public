+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              .Map
+              => "specialFilter"
+                 |-> closureVal("nums", specialFilterStmts(), 0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
