+          FuncDef(
+            "specialFilter",
+            Params("nums"),
+            specialFilterStmts())))
+      ~> Call(Name("specialFilter"), list(INPUT:ValSeq))
+      => specialCount(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
