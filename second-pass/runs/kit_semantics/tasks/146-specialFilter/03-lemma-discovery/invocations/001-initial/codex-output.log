requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Exact syntactic abbreviations for the translated Python body.
  syntax Stmts ::= filterBody() [macro]
  rule filterBody()
    => If(
         Compare(Name("num"), CmpOp(">", Int(10))),
         Assign(Name("text"), Call(Name("str"), Name("num")))
         If(
           Compare(
             BinOp(
               "%",
               Call(Name("ord"), Subscript(Name("text"), Int(0))),
               Int(2)),
             CmpOp("==", Int(1))),
           If(
             Compare(
               BinOp(
                 "%",
                 Call(
                   Name("ord"),
                   Subscript(Name("text"), UnaryOp("-", Int(1)))),
                 Int(2)),
               CmpOp("==", Int(1))),
             AugAssign(Name("count"), "+", Int(1)),
             .Stmts),
           .Stmts),
         .Stmts)

  syntax Stmts ::= specialFilterStmts() [macro]
  rule specialFilterStmts()
    => Assign(Name("count"), Int(0))
       Assign(Name("num"), Int(0))
       Assign(Name("text"), Str(""))
       For(Name("num"), Name("nums"), filterBody())
       Return(Name("count"))

  // The contract domain: arbitrary finite Python lists whose values are Ints.
  syntax Bool ::= allInts(ValSeq) [function, total]
  rule allInts(.ValSeq) => true
  rule allInts(vCons(V:Val, REST:ValSeq))
    => isInt(V) andBool allInts(REST)

  // Guarded total projection from the dynamic Val sort to Int. This is the
  // standard K total-projection pattern: it is connected to the built-in
  // partial subsort cast and can only be used while isInt(V) is entailed.
  syntax Bool ::= definedProjectInt(Val) [function, total]
  rule definedProjectInt(V:Val) => isInt(V)

  syntax Int ::= projectIntTotal(Val)
    [function, total, symbol(projectIntTotal), no-evaluators]

  rule #Ceil({@V:Val}:>Int)
    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    [simplification]

  rule projectIntTotal(V:Val) => {V}:>Int
    requires definedProjectInt(V)
    [concrete, simplification(10), preserves-definedness]
  rule {V:Val}:>Int => projectIntTotal(V)
    requires definedProjectInt(V)
    [symbolic(V), simplification, preserves-definedness]

  rule projectIntTotal(N:Int) => N [simplification]
  rule projectIntTotal(projectIntTotal(V:Val))
    => projectIntTotal(V)
    [simplification]

  // Guarded dispatch twins of the exact frozen-semantics equations used by the
  // program when a dynamically sorted list element is known to be an Int.
  rule applyCmp(">", V:Val, I:Int)
    => projectIntTotal(V) >Int I
    requires definedProjectInt(V)
    [simplification]

  rule applyBuiltin("str", V:Val, .Vals)
    => str(strToCodes(Int2String(projectIntTotal(V))))
    requires definedProjectInt(V)
    [simplification]

  // Decimal character codes used by the implementation. Int2String is the
  // fixed K STRING operation used by the supplied Python str(int) semantics.
  syntax Int ::= firstDecimalCode(Int) [function, total]
               | lastDecimalCode(Int)  [function, total]
  rule firstDecimalCode(N:Int)
    => intSeqAt(strToCodes(Int2String(N)), 0)
  rule lastDecimalCode(N:Int)
    => intSeqAt(
         strToCodes(Int2String(N)),
         -1 +Int isLen(strToCodes(Int2String(N))))

  syntax Bool ::= isSpecial(Int) [function, total]
                | firstDigitOdd(Int) [function, total]
                | lastDigitOdd(Int)  [function, total]
  rule firstDigitOdd(N:Int)
    => pyMod(firstDecimalCode(N), 2) ==Int 1
  rule lastDigitOdd(N:Int)
    => pyMod(lastDecimalCode(N), 2) ==Int 1
  rule isSpecial(N:Int)
    => N >Int 10
       andBool firstDigitOdd(N)
       andBool lastDigitOdd(N)

  // Mathematical count of qualifying elements in an arbitrary finite input.
  syntax Int ::= specialCount(ValSeq) [function, total]
  rule specialCount(.ValSeq) => 0 [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => 1 +Int specialCount(REST)
    requires definedProjectInt(V)
     andBool projectIntTotal(V) >Int 10
     andBool firstDigitOdd(projectIntTotal(V))
     andBool lastDigitOdd(projectIntTotal(V))
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires definedProjectInt(V)
     andBool notBool (projectIntTotal(V) >Int 10)
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires definedProjectInt(V)
     andBool projectIntTotal(V) >Int 10
     andBool notBool firstDigitOdd(projectIntTotal(V))
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires definedProjectInt(V)
     andBool projectIntTotal(V) >Int 10
     andBool firstDigitOdd(projectIntTotal(V))
     andBool notBool lastDigitOdd(projectIntTotal(V))
    [simplification]
  rule specialCount(vCons(V:Val, REST:ValSeq))
    => specialCount(REST)
    requires notBool definedProjectInt(V)
    [simplification]
endmodule
#!/usr/bin/env bash
set -eu

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun smoke.mpy --definition runtime-kompiled

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

python3 test_solution.py

if kprove spec-vacuity.k \
     --definition verification-kompiled \
     --spec-module SPEC-VACUITY; then
  echo "ERROR: false-postcondition mutation unexpectedly proved"
  exit 1
else
  echo "EXPECTED_FAILURE: false-postcondition mutation rejected"
fi

if kprove spec-body-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-BODY-MUTATION; then
  echo "ERROR: changed-body mutation unexpectedly proved"
  exit 1
else
  echo "EXPECTED_FAILURE: changed-body mutation rejected"
fi

if kprove spec-value-mutation.k \
     --definition verification-kompiled \
     --spec-module SPEC-VALUE-MUTATION; then
  echo "ERROR: opposite-value mutation unexpectedly proved"
  exit 1
else
  echo "EXPECTED_FAILURE: opposite-value mutation rejected"
fi
VALIDATED

## What is proven

Under the supplied MPY semantics, `specialFilter` is partially correct for every
arbitrary finite list of integers, with no bound on list length or integer
magnitude. If the call terminates, it returns the number of input integers that
are greater than 10 and whose first and last decimal digits are odd.

The target claim loads the exact translated function body, resolves the
`specialFilter`, `str`, and `ord` bindings through the real scope chain, creates
and pops the real call frame, executes the real loop body, and constrains the
final `<k>` result to `specialCount(INPUT)`. It also observes that the module
binding remains, the local frame is removed, and the environment, heap,
allocation counters, stack, return state, exception state, and exit code have
their stated final values.

This is a partial-correctness theorem, not a separate liveness theorem.

## Formal claim

The required target is `SPEC.special-filter` in `spec.k`:

- Domain: `INPUT:ValSeq` satisfying `allInts(INPUT)`.
- Program boundary: `#loadAll(Module(FuncDef(...)))` for the exact
  `solution.mpy` body, followed by
  `Call(Name("specialFilter"), list(INPUT))`.
- Result: `specialCount(INPUT)`.
- Observable final state: result, module binding, environment, scope counter,
  heap, heap counter, stack, return state, exception state, and exit code.

`specialCount` is structurally recursive over the entire symbolic `ValSeq`.
Its disjoint step cases add one exactly when the projected integer is greater
than 10 and both endpoint decimal character codes are odd. Decimal digit
character codes have the same parity as their digit values because ASCII
`'0'` has even code 48.

`SPEC.filter-loop` is the loop circularity. In the exact reachable call
context, it proves that running the loop over any remaining symbolic
`INPUT:ValSeq` increases `count` by `specialCount(INPUT)`. Its empty and
inductive cases collectively cover arbitrary finite inputs.

