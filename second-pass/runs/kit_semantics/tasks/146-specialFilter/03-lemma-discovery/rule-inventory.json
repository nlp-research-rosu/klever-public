      "start_line": 8,
      "text": "  rule filterBody()\n    => If(\n         Compare(Name(\"num\"), CmpOp(\">\", Int(10))),\n         Assign(Name(\"text\"), Call(Name(\"str\"), Name(\"num\")))\n         If(\n           Compare(\n             BinOp(\n               \"%\",\n               Call(Name(\"ord\"), Subscript(Name(\"text\"), Int(0))),\n               Int(2)),\n             CmpOp(\"==\", Int(1))),\n           If(\n             Compare(\n               BinOp(\n                 \"%\",\n                 Call(\n                   Name(\"ord\"),\n                   Subscript(Name(\"text\"), UnaryOp(\"-\", Int(1)))),\n                 Int(2)),\n               CmpOp(\"==\", Int(1))),\n             AugAssign(Name(\"count\"), \"+\", Int(1)),\n             .Stmts),\n           .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "9d27a81e40c58ebe05874d4adb1e888533322d5b70991a2c1e9eee4699e7a495",
      "source_rule_id": "rule-9d27a81e40c58ebe05874d4adb1e888533322d5b70991a2c1e9eee4699e7a495",
      "start_line": 34,
      "text": "  rule specialFilterStmts()\n    => Assign(Name(\"count\"), Int(0))\n       Assign(Name(\"num\"), Int(0))\n       Assign(Name(\"text\"), Str(\"\"))\n       For(Name(\"num\"), Name(\"nums\"), filterBody())\n       Return(Name(\"count\"))"
    },
