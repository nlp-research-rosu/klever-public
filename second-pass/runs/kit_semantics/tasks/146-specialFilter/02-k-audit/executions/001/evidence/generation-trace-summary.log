// reference/src/semantics/call.k — MPY-CALL
// ONE call route for every callable: evaluate the callee to a VALUE (name lookup reaches
// builtins at the root; a cooled Attribute is a bound method), evaluate the args (the shared
// #evalArgs loop in core.k), then dispatch on the callee value:
//   closureVal    -> bind params, push a frame (user function)
//   boundMethodV  -> applyMethod
//   builtinV      -> the #iterNext folds (sum/all/any/max/min) or applyBuiltin
//   typeV         -> callable type objects: int(...) / str(...)

module MPY-CALL
  imports MPY-METHODS
  imports MPY-BUILTINS
  imports MPY-FUNCTIONS

  // a cooled attribute is a bound method value
  rule <k> Attribute(V:
... <13727 chars omitted> ...
needs no change: setV holds int char codes, compared with ==Int, so a
  // cross-type ==K collapse never arises there.)
  // krun-only (priority 40 beats list.k's default rules); kprove uses the
  // structural ==K rules in list.k unchanged.
  syntax Bool ::= numOrKEq(Val, Val) [function]
  rule numOrKEq(A:Val, B:Val) => applyCmp("==", A, B)
       requires (isInt(A) orBool isBool(A) orBool isFloat(A))
        andBool (isInt(B) orBool isBool(B) orBool isFloat(B))
  rule numOrKEq(A:Val, B:Val) => A ==K B [owise]

  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
       requires numOrKEq(E, V) [priority(40)]
  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
       requires notBool numOrKEq(E, V) [priority(40)]
endmodule

