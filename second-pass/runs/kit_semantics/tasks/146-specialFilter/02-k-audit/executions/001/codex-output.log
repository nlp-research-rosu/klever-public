     6	def specialFilter(nums):
     7	    """Write a function that takes an array of numbers as input and returns 
     8	    the number of elements in the array that are greater than 10 and both 
     9	    first and last digits of a number are odd (1, 3, 5, 7, 9).
    10	    For example:
    11	    specialFilter([15, -73, 14, -15]) => 1 
    12	    specialFilter([33, -2, -3, 45, 21, 109]) => 2
    13	    """
    14	    
    15	    count = 0
    16	    for num in nums:
    17	        if num > 10:
    18	            odd_digits = (1, 3, 5, 7, 9)
    19	            number_as_string = str(num)
    20	            if int(number_as_string[0]) in odd_digits and int(number_as_string[-1]) in odd_digits:
    21	                count += 1
    22	        
    23	    return count 
