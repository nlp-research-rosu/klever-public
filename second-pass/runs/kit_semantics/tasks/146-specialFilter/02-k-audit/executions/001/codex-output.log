diff --git a/evidence/proof-replay.sh b/evidence/proof-replay.sh
new file mode 100644
index 0000000000000000000000000000000000000000..756515aaf0ec55d4950482dc7b85217f9889c158
--- /dev/null
+++ b/evidence/proof-replay.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -uo pipefail
+cd /tmp/audit-work
+
+echo 'COMMAND: independent loop claim'
+echo 'kprove spec.k --definition replay-verification-kompiled --spec-module SPEC --claims SPEC.filter-loop'
+kprove spec.k \
