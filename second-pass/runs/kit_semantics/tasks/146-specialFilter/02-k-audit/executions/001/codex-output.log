index 0000000000000000000000000000000000000000..e79e1662355a811e4a57332a0d8840a1be8afe83
--- /dev/null
+++ b//tmp/audit-work/spec-ground.k
@@ -0,0 +1,97 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  claim [empty]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "specialFilter",
+            Params("nums"),
+            specialFilterStmts())))
+      ~> Call(Name("specialFilter"), list(.ValSeq))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              .Map
+              => "specialFilter"
+                 |-> closureVal("nums", specialFilterStmts(), 0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [fifteen]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "specialFilter",
+            Params("nums"),
+            specialFilterStmts())))
+      ~> Call(Name("specialFilter"), list(vCons(15, .ValSeq)))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              .Map
+              => "specialFilter"
+                 |-> closureVal("nums", specialFilterStmts(), 0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [doc-two]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "specialFilter",
+            Params("nums"),
+            specialFilterStmts())))
+      ~> Call(
+           Name("specialFilter"),
+           list(
+             vCons(33,
+             vCons(-2,
+             vCons(-3,
+             vCons(45,
+             vCons(21,
+             vCons(109, .ValSeq))))))))
+      => 2
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              .Map
+              => "specialFilter"
+                 |-> closureVal("nums", specialFilterStmts(), 0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
