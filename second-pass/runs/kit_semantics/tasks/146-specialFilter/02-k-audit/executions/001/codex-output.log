+  claim [threshold-one-hundred]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "specialFilter",
+            Params("nums"),
+            Assign(Name("count"), Int(0))
+            Assign(Name("num"), Int(0))
