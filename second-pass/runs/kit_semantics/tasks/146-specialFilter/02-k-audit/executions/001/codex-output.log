+                                     Subscript(Name("text"), UnaryOp("-", Int(1)))),
+                                   Int(2)),
+                                 CmpOp("==", Int(1))),
+                               AugAssign(Name("count"), "+", Int(1)),
+                               .Stmts),
+                             .Stmts),
+                           .Stmts))
+                       Return(Name("count")),
+                       0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
