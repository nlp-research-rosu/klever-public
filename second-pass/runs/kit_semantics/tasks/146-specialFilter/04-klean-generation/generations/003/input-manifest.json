      "start_line": 100,
      "text": "  rule lastDigitOdd(N:Int)\n    => pyMod(lastDecimalCode(N), 2) ==Int 1"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 105,
      "module": "VERIFICATION",
