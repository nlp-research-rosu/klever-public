      "source_rule_id": "rule-3f693acbe30326ded85fe4006a1d92ccd6733a56cc235cd3362184e45e6e0d03",
      "start_line": 90,
      "text": "  rule lastDecimalCode(N:Int)\n    => intSeqAt(\n         strToCodes(Int2String(N)),\n         -1 +Int isLen(strToCodes(Int2String(N))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 99,
      "module": "VERIFICATION",
      "normalized_sha256": "974792a28f9b7a63655bcdf632d17b799ff47d88f98edb17cfbda11da0b4e134",
      "rationale": "Equation defining firstDigitOdd as parity of the first decimal character code.",
      "source_rule_id": "rule-974792a28f9b7a63655bcdf632d17b799ff47d88f98edb17cfbda11da0b4e134",
      "start_line": 98,
      "text": "  rule firstDigitOdd(N:Int)\n    => pyMod(firstDecimalCode(N), 2) ==Int 1"
    },
    {
      "attributes": [],
