    10	    select_words("Mary had a little lamb", 3) ==> ["Mary", "lamb"]
    11	    select_words("simple white space", 2) ==> []
    12	    select_words("Hello world", 4) ==> ["world"]
    13	    select_words("Uncle sam", 3) ==> ["Uncle"]
    14	    """
