+        .Stmts))
+      ~> Call(Name("select_words"), str(iCons(98, .IntSeq)), 1)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(("s", "n", .ParamNames), selectWordsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
