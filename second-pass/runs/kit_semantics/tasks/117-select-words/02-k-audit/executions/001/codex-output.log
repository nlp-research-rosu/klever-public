+requires "verification.k"
+
+module REVIEWER-GROUND-WITNESS
+  imports VERIFICATION
+
+  // Satisfying precondition witness: s = "b", n = 1.  The expected heap is
+  // literal ["b"], rather than a proof-side summary symbol.
+  claim:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"), selectWordsBody)
+        .Stmts))
+      ~> Call(Name("select_words"), str(iCons(98, .IntSeq)), 1)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(("s", "n", .ParamNames), selectWordsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(str(iCons(98, .IntSeq)), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-program-identity.k b/evidence/spec-program-identity.k
new file mode 100644
index 0000000000000000000000000000000000000000..94dbc3824a1b6722ca434131cfa034a4de09d3eb
--- /dev/null
+++ b/evidence/spec-program-identity.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module REVIEWER-PROGRAM-IDENTITY
+  imports VERIFICATION
+
+  // Constructor-level equality between the proof's body aliases and the body
+  // in the trusted-regenerated solution.mpy.
+  claim:
+    <k>
+      selectWordsBody
+      =>
+      Assign(Name("result"), ListExpr())
+      Assign(Name("word"), Str(""))
+      Assign(Name("count"), Int(0))
+      Assign(Name("ch"), Str(""))
+      For(Name("ch"), Name("s"),
+        If(Compare(Name("ch"), CmpOp("==", Str(" "))),
+          If(BoolOp(
+            "and",
+            Compare(Name("count"), CmpOp("==", Name("n"))),
+            Compare(Name("word"), CmpOp("!=", Str("")))),
+            Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
+            )
+          Assign(Name("word"), Str(""))
+          Assign(Name("count"), Int(0)),
+          Assign(Name("word"), BinOp("+", Name("word"), Name("ch")))
+          If(Compare(Name("ch"), CmpOp("not in", Str("aeiouAEIOU"))),
+            Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
+            )))
+      If(BoolOp(
+        "and",
+        Compare(Name("count"), CmpOp("==", Name("n"))),
+        Compare(Name("word"), CmpOp("!=", Str("")))),
+        Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
+        )
+      Return(Name("result"))
+    </k>
+endmodule
