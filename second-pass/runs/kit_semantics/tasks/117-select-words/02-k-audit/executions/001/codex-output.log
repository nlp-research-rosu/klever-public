/bin/bash -lc "{
  echo '"'$ python3 py2mpy.py solution.py > regenerated-solution.mpy'"'
  python3 py2mpy.py solution.py > regenerated-solution.mpy
  translate_status="'$?
  echo "translate_exit=$translate_status"
  echo '"'"'$ cmp regenerated-solution.mpy solution.mpy'"'
  cmp regenerated-solution.mpy solution.mpy
  cmp_status="'$?
  echo "cmp_exit=$cmp_status"
  echo '"'"'$ python3 /audit-output/evidence/differential_test.py'"'
  python3 /audit-output/evidence/differential_test.py
  differential_status="'$?
  echo "differential_exit=$differential_status"
  if test "$translate_status" -ne 0 || test "$cmp_status" -ne 0 || test "$differential_status" -ne 0; then exit 1; fi
} > /audit-output/evidence/stage2-fidelity.log 2>&1; status=$?; sed -n '"'1,260p' /audit-output/evidence/stage2-fidelity.log; exit \""'$status"' in /tmp/audit-work/117-select-words-audit
