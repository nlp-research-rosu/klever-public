@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module REVIEWER-GROUND-WITNESS
+  imports VERIFICATION
+
+  // Satisfying precondition witness: s = "b", n = 1.  The expected heap is
+  // literal ["b"], rather than a proof-side summary symbol.
+  claim [ground-witness]:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"), selectWordsBody)
+        .Stmts))
+      ~> Call(Name("select_words"), str(iCons(98, .IntSeq)), 1)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(("s", "n", .ParamNames), selectWordsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(str(iCons(98, .IntSeq)), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-program-identity.k b/evidence/spec-program-identity.k
new file mode 100644
index 0000000000000000000000000000000000000000..4c1ccde865d8ebfa36b856ba6d368803c9368268
--- /dev/null
+++ b/evidence/spec-program-identity.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module REVIEWER-PROGRAM-IDENTITY
+  imports VERIFICATION
+
+  // Constructor-level equality between the proof's body aliases and the body
+  // in the trusted-regenerated solution.mpy.
+  claim [constructor-identity]:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"), selectWordsBody)
+        .Stmts))
+      =>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("word"), Str(""))
+          Assign(Name("count"), Int(0))
+          Assign(Name("ch"), Str(""))
+          For(Name("ch"), Name("s"),
+            If(Compare(Name("ch"), CmpOp("==", Str(" "))),
+              If(BoolOp("and",
+                   Compare(Name("count"), CmpOp("==", Name("n"))),
+                   Compare(Name("word"), CmpOp("!=", Str("")))),
+                Expr(Call(Attribute(Name("result"), "append"), Name("word")))
+                .Stmts,
+                .Stmts)
+              Assign(Name("word"), Str(""))
+              Assign(Name("count"), Int(0)),
+              Assign(Name("word"), BinOp("+", Name("word"), Name("ch")))
+              If(Compare(Name("ch"), CmpOp("not in", Str("aeiouAEIOU"))),
+                Assign(Name("count"),
+                  BinOp("+", Name("count"), Int(1)))
+                .Stmts,
+                .Stmts)
+              .Stmts)
+            .Stmts)
+          If(BoolOp("and",
+               Compare(Name("count"), CmpOp("==", Name("n"))),
+               Compare(Name("word"), CmpOp("!=", Str("")))),
+            Expr(Call(Attribute(Name("result"), "append"), Name("word")))
+            .Stmts,
+            .Stmts)
+          Return(Name("result")))
+        .Stmts))
+    </k>
+endmodule
diff --git a/evidence/spec-reviewer-body-mutation.k b/evidence/spec-reviewer-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..9f50c605e99fedbf021e5a38d552bd9288df529d
--- /dev/null
+++ b/evidence/spec-reviewer-body-mutation.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module REVIEWER-BODY-MUTATION
+  imports VERIFICATION
+
+  // Materially mutate the executed body: initialize count to 1.  For "b", 1
+  // that program returns [], so the original literal ["b"] result must fail.
+  claim [body-mutation]:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("word"), Str(""))
+          Assign(Name("count"), Int(1))
+          Assign(Name("ch"), Str(""))
+          For(Name("ch"), Name("s"), charLoopBody)
+          afterCharLoop)))
+      ~> Call(Name("select_words"), str(iCons(98, .IntSeq)), 1)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(
+            ("s", "n", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("word"), Str(""))
+            Assign(Name("count"), Int(1))
+            Assign(Name("ch"), Str(""))
+            For(Name("ch"), Name("s"), charLoopBody)
+            afterCharLoop,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(str(iCons(98, .IntSeq)), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/trace_summary.js b/evidence/trace_summary.js
new file mode 100644
index 0000000000000000000000000000000000000000..3fbc5bf87c8f30b29da5b3621ee3c673dae16e85
--- /dev/null
+++ b/evidence/trace_summary.js
@@ -0,0 +1,50 @@
+const fs = require("fs");
+
+if (process.argv.length !== 3) {
+  console.error("usage: node trace_summary.js TRACE.jsonl");
+  process.exit(2);
+}
+
+const lines = fs.readFileSync(process.argv[2], "utf8").trimEnd().split("\n");
+const counts = new Map();
+const calls = [];
+const messages = [];
+
+for (let index = 0; index < lines.length; index += 1) {
+  const row = JSON.parse(lines[index]);
+  const payloadType = row.payload && row.payload.type ? row.payload.type : "";
+  const key = `${row.type}:${payloadType}`;
+  counts.set(key, (counts.get(key) || 0) + 1);
+
+  if (row.type === "response_item" && payloadType === "function_call") {
+    calls.push({
+      line: index + 1,
+      name: row.payload.name,
+      arguments: row.payload.arguments,
+    });
+  }
+  if (
+    row.type === "response_item" &&
+    payloadType === "message" &&
+    row.payload.role === "assistant"
+  ) {
+    const text = (row.payload.content || [])
+      .filter((item) => item.type === "output_text")
+      .map((item) => item.text)
+      .join("\n");
+    messages.push({ line: index + 1, text });
+  }
+}
+
+console.log(`lines=${lines.length}`);
+for (const [key, value] of [...counts.entries()].sort()) {
+  console.log(`event_count ${key} ${value}`);
+}
+for (const call of calls) {
+  console.log(`tool_call line=${call.line} name=${call.name}`);
+  console.log(call.arguments);
+}
+for (const message of messages) {
+  console.log(`assistant_message line=${message.line}`);
+  console.log(message.text);
+}

