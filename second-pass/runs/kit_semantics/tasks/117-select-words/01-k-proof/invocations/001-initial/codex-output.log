+          "n"      |-> N:Int
+          "result" |-> ref(H:Int)
+          "word"   |-> str(WORD:IntSeq)
+          "count"  |-> COUNT:Int
+          "ch"     |-> str(OLDCH:IntSeq),
+          parent(0))
+        =>
+        scope(
+          "s"      |-> str(ORIGINAL)
+          "n"      |-> N
+          "result" |-> ref(H)
+          "word"   |-> str(wordAfter(S, WORD))
+          "count"  |-> countAfter(S, COUNT)
+          "ch"     |-> str(charAfter(S, OLDCH)),
+          parent(0)))
+      ...
+    </scopes>
