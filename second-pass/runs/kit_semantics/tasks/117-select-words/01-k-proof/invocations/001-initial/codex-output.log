printf 'REQUIRED_FILES\\n'
ls -l solution.py solution.mpy verification.k spec.k prove.sh PROOF.md
printf 'PROOF_HEADLINE=%s\\n' \""'$(head -n 1 PROOF.md)"
printf '"'POSITIVE_OUTPUT=%s\\n' \""'$(cat proof-positive.out)"' in /workspace
