@@ -0,0 +1,17 @@
+def select_words(s, n):
+    result = []
+    word = ""
+    count = 0
+    for ch in s:
+        if ch == " ":
+            if count == n and word != "":
+                result.append(word)
+            word = ""
+            count = 0
+        else:
+            word = word + ch
+            if ch not in "aeiouAEIOU":
+                count = count + 1
+    if count == n and word != "":
+        result.append(word)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9a9519e92182f42d60880f72bc7e392b0392ddd0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop circularity at the exact continuation in select_words.  It executes
+  // the real loop body, final flush, Return, and frame pop.
+  claim [select-words-loop]:
+    <k>
+      #loop(str(S:IntSeq), Name("ch"), charLoopBody)
+      ~> afterCharLoop
+      ~> #endcall
+      =>
+      ref(H) ~> KONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      (L |-> scope(
+        "s"      |-> str(ORIGINAL:IntSeq)
+        "n"      |-> N:Int
+        "result" |-> ref(H:Int)
+        "word"   |-> str(WORD:IntSeq)
+        "count"  |-> COUNT:Int
+        LOCALS:Map,
+        parent(0))
+       SCOPES:Map)
+      =>
+      SCOPES
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap>
+      H |-> (list(A:ValSeq) => list(selectScan(S, N, WORD, COUNT, A)))
+      ...
+    </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack>
+      (ListItem(frame(KONT:K, CALLER:Int, L:Int)) => .List)
+      ...
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0 andBool validInputText(S)
+
+  // Whole-program claim from the initial reference configuration.  The
+  // function definition, parameter binding, body, loop, return, and heap
+  // result all execute under the fixed semantics.
+  claim [select-words]:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"), selectWordsBody)
+        .Stmts))
+      ~> Call(Name("select_words"), str(S:IntSeq), N:Int)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(("s", "n", .ParamNames), selectWordsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(selectScan(S, N, .IntSeq, 0, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0 andBool validInputText(S)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6788326652e3fd1aff87fa2524e0e46e7d8ad5fa
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,116 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+
+  // Exact AST fragments generated from solution.py.  These are names for
+  // syntax trees; they do not replace any operational step.
+  syntax Stmts ::= "charLoopBody" [function, total]
+                 | "afterCharLoop" [function, total]
+                 | "selectWordsBody" [function, total]
+
+  // Mathematical specification: scan the remaining character codes while
+  // carrying the current word, its consonant count, and the selected words.
+  syntax ValSeq ::= selectScan(IntSeq, Int, IntSeq, Int, ValSeq)
+                    [function, total]
+                  | flushSelected(ValSeq, IntSeq, Int, Int)
+                    [function, total]
+
+  syntax Bool ::= validInputText(IntSeq) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule charLoopBody =>
+    If(Compare(Name("ch"), CmpOp("==", Str(" "))),
+      If(BoolOp("and",
+           Compare(Name("count"), CmpOp("==", Name("n"))),
+           Compare(Name("word"), CmpOp("!=", Str("")))),
+        Expr(Call(Attribute(Name("result"), "append"), Name("word")))
+        .Stmts,
+        .Stmts)
+      Assign(Name("word"), Str(""))
+      Assign(Name("count"), Int(0))
+      .Stmts,
+      Assign(Name("word"), BinOp("+", Name("word"), Name("ch")))
+      If(Compare(Name("ch"), CmpOp("not in", Str("aeiouAEIOU"))),
+        Assign(Name("count"),
+          BinOp("+", Name("count"), Int(1)))
+        .Stmts,
+        .Stmts)
+      .Stmts)
+    .Stmts
+
+  rule afterCharLoop =>
+    If(BoolOp("and",
+         Compare(Name("count"), CmpOp("==", Name("n"))),
+         Compare(Name("word"), CmpOp("!=", Str("")))),
+      Expr(Call(Attribute(Name("result"), "append"), Name("word")))
+      .Stmts,
+      .Stmts)
+    Return(Name("result"))
+    .Stmts
+
+  rule selectWordsBody =>
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("word"), Str(""))
+    Assign(Name("count"), Int(0))
+    For(Name("ch"), Name("s"), charLoopBody)
+    afterCharLoop
+
+  // Flush never selects an empty token, including when n == 0.
+  rule flushSelected(A:ValSeq, .IntSeq, _COUNT:Int, _N:Int) => A
+  rule flushSelected(A:ValSeq, iCons(C:Int, R:IntSeq), COUNT:Int, N:Int)
+    => valSeqConcat(A, vCons(str(iCons(C, R)), .ValSeq))
+    requires COUNT ==Int N
+  rule flushSelected(A:ValSeq, iCons(_C:Int, _R:IntSeq), COUNT:Int, N:Int)
+    => A
+    requires COUNT =/=Int N
+
+  rule selectScan(.IntSeq, N:Int, WORD:IntSeq, COUNT:Int, A:ValSeq)
+    => flushSelected(A, WORD, COUNT, N)
+
+  // A space ends the current word.  Empty runs never create words.
+  rule selectScan(iCons(C:Int, R:IntSeq), N:Int, .IntSeq,
+                  _COUNT:Int, A:ValSeq)
+    => selectScan(R, N, .IntSeq, 0, A)
+    requires C ==Int 32
+  rule selectScan(iCons(C:Int, R:IntSeq), N:Int,
+                  iCons(W:Int, WR:IntSeq), COUNT:Int, A:ValSeq)
+    => selectScan(
+         R, N, .IntSeq, 0,
+         valSeqConcat(
+           A, vCons(str(iCons(W, WR)), .ValSeq)))
+    requires C ==Int 32 andBool COUNT ==Int N
+  rule selectScan(iCons(C:Int, R:IntSeq), N:Int,
+                  iCons(_W:Int, _WR:IntSeq), COUNT:Int, A:ValSeq)
+    => selectScan(R, N, .IntSeq, 0, A)
+    requires C ==Int 32 andBool COUNT =/=Int N
+
+  // Every non-space code extends the current word.  Membership in the exact
+  // vowel literal used by solution.py determines whether the count changes.
+  rule selectScan(iCons(C:Int, R:IntSeq), N:Int, WORD:IntSeq,
+                  COUNT:Int, A:ValSeq)
+    => selectScan(
+         R, N, seqConcat(WORD, iCons(C, .IntSeq)), COUNT, A)
+    requires C =/=Int 32
+      andBool strContains(
+        iCons(C, .IntSeq), strToCodes("aeiouAEIOU"))
+  rule selectScan(iCons(C:Int, R:IntSeq), N:Int, WORD:IntSeq,
+                  COUNT:Int, A:ValSeq)
+    => selectScan(
+         R, N, seqConcat(WORD, iCons(C, .IntSeq)),
+         COUNT +Int 1, A)
+    requires C =/=Int 32
+      andBool notBool strContains(
+        iCons(C, .IntSeq), strToCodes("aeiouAEIOU"))
+
+  // The prompt's "letters and spaces" domain, interpreted in the reference
+  // semantics' ASCII character model.
+  rule validInputText(.IntSeq) => true
+  rule validInputText(iCons(C:Int, R:IntSeq))
+    => (isAlphaC(C) orBool C ==Int 32) andBool validInputText(R)
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..7810b67fe926673b2f1b494b623cbe07e0921454
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,25 @@
+def select_words(s, n):
+    result = []
+    word = ""
+    count = 0
+    for ch in s:
+        if ch == " ":
+            if count == n and word != "":
+                result.append(word)
+            word = ""
+            count = 0
+        else:
+            word = word + ch
+            if ch not in "aeiouAEIOU":
+                count = count + 1
+    if count == n and word != "":
+        result.append(word)
+    return result
+
+
+assert select_words("Mary had a little lamb", 4) == ["little"]
+assert select_words("Mary had a little lamb", 3) == ["Mary", "lamb"]
+assert select_words("simple white space", 2) == []
+assert select_words("Hello world", 4) == ["world"]
+assert select_words("Uncle sam", 3) == ["Uncle"]
+assert select_words("", 0) == []
