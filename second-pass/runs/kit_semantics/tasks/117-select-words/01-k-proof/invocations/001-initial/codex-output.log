+          Assign(Name("count"), Int(1))
+          Assign(Name("ch"), Str(""))
+          For(Name("ch"), Name("s"), charLoopBody)
+          afterCharLoop)))
+      ~> Call(
+           Name("select_words"),
+           str(iCons(98, .IntSeq)),
+           1)
+      =>
