diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..d1c60d90176e884c09e349fad4116823b011745d
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,55 @@
+requires "spec.k"
+
+module SPEC-BODY-MUTATION
+  imports SPEC
+
+  // Gate A body-sensitivity probe: changing count's initialization from 0 to
+  // 1 must invalidate the original postcondition for s = "b", n = 1.
+  claim [mutated-body]:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("word"), Str(""))
+          Assign(Name("count"), Int(1))
+          Assign(Name("ch"), Str(""))
+          For(Name("ch"), Name("s"), charLoopBody)
+          afterCharLoop)))
+      ~> Call(
+           Name("select_words"),
+           str(iCons(98, .IntSeq)),
+           1)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(
+            ("s", "n", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("word"), Str(""))
+            Assign(Name("count"), Int(1))
+            Assign(Name("ch"), Str(""))
+            For(Name("ch"), Name("s"), charLoopBody)
+            afterCharLoop,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        selectScan(iCons(98, .IntSeq), 1, .IntSeq, 0, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..6e82f2214d4026b37d849ba27a70e36bc4404ac3
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,37 @@
+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Deliberately false postcondition for the realizable witness s = "b", n = 1:
+  // the real program returns ["b"], not [].
+  claim [false-result]:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"), selectWordsBody)
+        .Stmts))
+      ~> Call(
+           Name("select_words"),
+           str(iCons(98, .IntSeq)),
+           1)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(("s", "n", .ParamNames), selectWordsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..85a8d545d60e516163ae5cc40815c0458aab20f0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,78 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop circularity over the exact ordinary local frame and result-list heap
+  // cell.  Return and frame pop remain outside this invariant.
+  claim [select-words-loop]:
+    <k>
+      #loop(str(S:IntSeq), Name("ch"), charLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> (
+        scope(
+          "s"      |-> str(ORIGINAL:IntSeq)
+          "n"      |-> N:Int
+          "result" |-> ref(H:Int)
+          "word"   |-> str(WORD:IntSeq)
+          "count"  |-> COUNT:Int
+          "ch"     |-> str(OLDCH:IntSeq),
+          parent(0))
+        =>
+        scope(
+          "s"      |-> str(ORIGINAL)
+          "n"      |-> N
+          "result" |-> ref(H)
+          "word"   |-> str(wordAfter(S, WORD))
+          "count"  |-> countAfter(S, COUNT)
+          "ch"     |-> str(charAfter(S, OLDCH)),
+          parent(0)))
+      ...
+    </scopes>
+    <heap>
+      H |-> (list(A:ValSeq) => list(scanAccum(S, N, WORD, COUNT, A)))
+      ...
+    </heap>
+    requires N >=Int 0
+
+  // Whole-program claim from the initial reference configuration.  The
+  // function definition, parameter binding, body, loop, return, and heap
+  // result all execute under the fixed semantics.
+  claim [select-words]:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"), selectWordsBody)
+        .Stmts))
+      ~> Call(Name("select_words"), str(S:IntSeq), N:Int)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(("s", "n", .ParamNames), selectWordsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(selectScan(S, N, .IntSeq, 0, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6fde3728f713317c7a06c0de0dc50fd7b205b26b
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,61 @@
+import itertools
+
+from solution import select_words
+
+
+VOWELS = "aeiouAEIOU"
+
+
+def oracle(s, n):
+    words = s.split()
+    return [
+        word
+        for word in words
+        if sum(1 for ch in word if ch not in VOWELS) == n
+    ]
+
+
+PROMPT_CASES = [
+    ("Mary had a little lamb", 4, ["little"]),
+    ("Mary had a little lamb", 3, ["Mary", "lamb"]),
+    ("simple white space", 2, []),
+    ("Hello world", 4, ["world"]),
+    ("Uncle sam", 3, ["Uncle"]),
+    ("", 0, []),
+]
+
+
+def main():
+    checks = 0
+    for s, n, expected in PROMPT_CASES:
+        actual = select_words(s, n)
+        assert actual == expected
+        assert actual == oracle(s, n)
+        checks += 1
+
+    alphabet = "aB "
+    for length in range(7):
+        for chars in itertools.product(alphabet, repeat=length):
+            s = "".join(chars)
+            for n in range(7):
+                assert select_words(s, n) == oracle(s, n)
+                checks += 1
+
+    structured = [
+        "  a  BB aB ",
+        "AEIOU aeiou",
+        "bcdfghjklmnpqrstvwxyz",
+        "A B C D E",
+        "Mary had a little lamb",
+        "z " * 40,
+    ]
+    for s in structured:
+        for n in range(12):
+            assert select_words(s, n) == oracle(s, n)
+            checks += 1
+
+    print(f"differential checks: {checks}; mismatches: 0")
+
+
+if __name__ == "__main__":
+    main()
