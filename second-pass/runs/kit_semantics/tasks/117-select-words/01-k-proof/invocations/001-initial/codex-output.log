+def select_words(s, n):
+    result = []
+    word = ""
+    count = 0
+    ch = ""
+    for ch in s:
+        if ch == " ":
+            if count == n and word != "":
+                result.append(word)
+            word = ""
+            count = 0
+        else:
+            word = word + ch
+            if ch not in "aeiouAEIOU":
+                count = count + 1
+    if count == n and word != "":
+        result.append(word)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..164b12ff2f103c7a0f875adcc22f870c1894b723
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,78 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop circularity over the exact ordinary local frame and result-list heap
+  // cell.  Return and frame pop remain outside this invariant.
+  claim [select-words-loop]:
+    <k>
+      #loop(str(S:IntSeq), Name("ch"), charLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> (
+        scope(
+          "s"      |-> str(ORIGINAL:IntSeq)
+          "n"      |-> N:Int
+          "result" |-> ref(H:Int)
+          "word"   |-> str(WORD:IntSeq)
+          "count"  |-> COUNT:Int
+          "ch"     |-> str(OLDCH:IntSeq),
+          parent(0))
+        =>
+        scope(
+          "s"      |-> str(ORIGINAL)
+          "n"      |-> N
+          "result" |-> ref(H)
+          "word"   |-> str(wordAfter(S, WORD))
+          "count"  |-> countAfter(S, COUNT)
+          "ch"     |-> str(charAfter(S, OLDCH)),
+          parent(0)))
+      ...
+    </scopes>
+    <heap>
+      H |-> (list(A:ValSeq) => list(scanAccum(S, N, WORD, COUNT, A)))
+      ...
+    </heap>
+    requires N >=Int 0 andBool validInputText(S)
+
+  // Whole-program claim from the initial reference configuration.  The
+  // function definition, parameter binding, body, loop, return, and heap
+  // result all execute under the fixed semantics.
+  claim [select-words]:
+    <k>
+      #loadAll(Module(
+        FuncDef("select_words", Params("s", "n"), selectWordsBody)
+        .Stmts))
+      ~> Call(Name("select_words"), str(S:IntSeq), N:Int)
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "select_words" |->
+          closureVal(("s", "n", .ParamNames), selectWordsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(selectScan(S, N, .IntSeq, 0, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0 andBool validInputText(S)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f6e88c9b76514c39b818bb5b112bd1c270acb312
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,179 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+
+  // Exact AST fragments generated from solution.py.  These are names for
+  // syntax trees; they do not replace any operational step.
+  syntax Stmts ::= "charLoopBody" [function, total]
+                 | "afterCharLoop" [function, total]
+                 | "selectWordsBody" [function, total]
+
+  // Mathematical specification: scan the remaining character codes while
+  // carrying the current word, its consonant count, and the selected words.
+  syntax ValSeq ::= selectScan(IntSeq, Int, IntSeq, Int, ValSeq)
+                    [function, total]
+                  | scanAccum(IntSeq, Int, IntSeq, Int, ValSeq)
+                    [function, total]
+                  | flushSelected(ValSeq, IntSeq, Int, Int)
+                    [function, total]
+
+  syntax IntSeq ::= wordAfter(IntSeq, IntSeq) [function, total]
+                  | charAfter(IntSeq, IntSeq) [function, total]
+  syntax Int ::= countAfter(IntSeq, Int) [function, total]
+  syntax Bool ::= validInputText(IntSeq) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule charLoopBody =>
+    If(Compare(Name("ch"), CmpOp("==", Str(" "))),
+      If(BoolOp("and",
+           Compare(Name("count"), CmpOp("==", Name("n"))),
+           Compare(Name("word"), CmpOp("!=", Str("")))),
+        Expr(Call(Attribute(Name("result"), "append"), Name("word")))
+        .Stmts,
+        .Stmts)
+      Assign(Name("word"), Str(""))
+      Assign(Name("count"), Int(0))
+      .Stmts,
+      Assign(Name("word"), BinOp("+", Name("word"), Name("ch")))
+      If(Compare(Name("ch"), CmpOp("not in", Str("aeiouAEIOU"))),
+        Assign(Name("count"),
+          BinOp("+", Name("count"), Int(1)))
+        .Stmts,
+        .Stmts)
+      .Stmts)
+    .Stmts
+
+  rule afterCharLoop =>
+    If(BoolOp("and",
+         Compare(Name("count"), CmpOp("==", Name("n"))),
+         Compare(Name("word"), CmpOp("!=", Str("")))),
+      Expr(Call(Attribute(Name("result"), "append"), Name("word")))
+      .Stmts,
+      .Stmts)
+    Return(Name("result"))
+    .Stmts
+
+  rule selectWordsBody =>
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("word"), Str(""))
+    Assign(Name("count"), Int(0))
+    Assign(Name("ch"), Str(""))
+    For(Name("ch"), Name("s"), charLoopBody)
+    afterCharLoop
+
+  // Flush never selects an empty token, including when n == 0.
+  rule flushSelected(A:ValSeq, _WORD:IntSeq, COUNT:Int, N:Int) => A
+    requires COUNT =/=Int N
+    [simplification]
+  rule flushSelected(A:ValSeq, .IntSeq, COUNT:Int, N:Int) => A
+    requires COUNT ==Int N
+    [simplification]
+  rule flushSelected(A:ValSeq, WORD:IntSeq, COUNT:Int, N:Int)
+    => valSeqConcat(A, vCons(str(WORD), .ValSeq))
+    requires COUNT ==Int N andBool notBool (WORD ==K .IntSeq)
+    [simplification]
+
+  rule selectScan(S:IntSeq, N:Int, WORD:IntSeq, COUNT:Int, A:ValSeq)
+    => flushSelected(
+         scanAccum(S, N, WORD, COUNT, A),
+         wordAfter(S, WORD),
+         countAfter(S, COUNT),
+         N)
+    [simplification]
+
+  // A space ends the current word.  Empty runs never create words.
+  rule scanAccum(.IntSeq, _N:Int, _WORD:IntSeq, _COUNT:Int, A:ValSeq)
+    => A
+    [simplification]
+  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int, _WORD:IntSeq,
+                 COUNT:Int, A:ValSeq)
+    => scanAccum(R, N, .IntSeq, 0, A)
+    requires C ==Int 32 andBool COUNT =/=Int N
+    [simplification]
+  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int, .IntSeq,
+                 COUNT:Int, A:ValSeq)
+    => scanAccum(R, N, .IntSeq, 0, A)
+    requires C ==Int 32 andBool COUNT ==Int N
+    [simplification]
+  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int,
+                 WORD:IntSeq, COUNT:Int, A:ValSeq)
+    => scanAccum(
+         R, N, .IntSeq, 0,
+         valSeqConcat(
+           A, vCons(str(WORD), .ValSeq)))
+    requires C ==Int 32 andBool COUNT ==Int N
+      andBool notBool (WORD ==K .IntSeq)
+    [simplification]
+
+  // Every non-space code extends the current word.  Membership in the exact
+  // vowel literal used by solution.py determines whether the count changes.
+  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int, WORD:IntSeq,
+                 COUNT:Int, A:ValSeq)
+    => scanAccum(
+         R, N, seqConcat(WORD, iCons(C, .IntSeq)), COUNT, A)
+    requires C =/=Int 32
+      andBool strContains(
+        iCons(C, .IntSeq), strToCodes("aeiouAEIOU"))
+    [simplification]
+  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int, WORD:IntSeq,
+                 COUNT:Int, A:ValSeq)
+    => scanAccum(
+         R, N, seqConcat(WORD, iCons(C, .IntSeq)),
+         COUNT +Int 1, A)
+    requires C =/=Int 32
+      andBool notBool strContains(
+        iCons(C, .IntSeq), strToCodes("aeiouAEIOU"))
+    [simplification]
+
+  // Final loop-local values.  They are specified separately so the loop
+  // circularity describes exactly the state that the fixed semantics reaches.
+  rule wordAfter(.IntSeq, WORD:IntSeq) => WORD
+    [simplification]
+  rule wordAfter(iCons(C:Int, R:IntSeq), _WORD:IntSeq)
+    => wordAfter(R, .IntSeq)
+    requires C ==Int 32
+    [simplification]
+  rule wordAfter(iCons(C:Int, R:IntSeq), WORD:IntSeq)
+    => wordAfter(R, seqConcat(WORD, iCons(C, .IntSeq)))
+    requires C =/=Int 32
+    [simplification]
+
+  rule countAfter(.IntSeq, COUNT:Int) => COUNT
+    [simplification]
+  rule countAfter(iCons(C:Int, R:IntSeq), _COUNT:Int)
+    => countAfter(R, 0)
+    requires C ==Int 32
+    [simplification]
+  rule countAfter(iCons(C:Int, R:IntSeq), COUNT:Int)
+    => countAfter(R, COUNT)
+    requires C =/=Int 32
+      andBool strContains(
+        iCons(C, .IntSeq), strToCodes("aeiouAEIOU"))
+    [simplification]
+  rule countAfter(iCons(C:Int, R:IntSeq), COUNT:Int)
+    => countAfter(R, COUNT +Int 1)
+    requires C =/=Int 32
+      andBool notBool strContains(
+        iCons(C, .IntSeq), strToCodes("aeiouAEIOU"))
+    [simplification]
+
+  rule charAfter(.IntSeq, OLD:IntSeq) => OLD
+    [simplification]
+  rule charAfter(iCons(C:Int, R:IntSeq), _OLD:IntSeq)
+    => charAfter(R, iCons(C, .IntSeq))
+    [simplification]
+
+  // The prompt's "letters and spaces" domain, interpreted in the reference
+  // semantics' ASCII character model.
+  rule validInputText(.IntSeq) => true
+    [simplification]
+  rule validInputText(iCons(C:Int, R:IntSeq))
+    => (isAlphaC(C) orBool C ==Int 32) andBool validInputText(R)
+    [simplification]
+endmodule

