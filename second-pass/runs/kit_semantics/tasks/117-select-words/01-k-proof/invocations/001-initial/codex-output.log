+          closureVal(
+            ("s", "n", .ParamNames),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("word"), Str(""))
+            Assign(Name("count"), Int(1))
+            Assign(Name("ch"), Str(""))
+            For(Name("ch"), Name("s"), charLoopBody)
+            afterCharLoop,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        selectScan(iCons(98, .IntSeq), 1, .IntSeq, 0, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
