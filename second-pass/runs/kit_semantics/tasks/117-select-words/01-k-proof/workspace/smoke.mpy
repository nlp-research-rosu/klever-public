Module(
  FuncDef("select_words", Params("s", "n"),
    Assign(Name("result"), ListExpr())
    Assign(Name("word"), Str(""))
    Assign(Name("count"), Int(0))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      If(Compare(Name("ch"), CmpOp("==", Str(" "))),
        If(BoolOp(
          "and",
          Compare(Name("count"), CmpOp("==", Name("n"))),
          Compare(Name("word"), CmpOp("!=", Str("")))),
          Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
          )
        Assign(Name("word"), Str(""))
        Assign(Name("count"), Int(0)),
        Assign(Name("word"), BinOp("+", Name("word"), Name("ch")))
        If(Compare(Name("ch"), CmpOp("not in", Str("aeiouAEIOU"))),
          Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
          )))
    If(BoolOp(
      "and",
      Compare(Name("count"), CmpOp("==", Name("n"))),
      Compare(Name("word"), CmpOp("!=", Str("")))),
      Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
      )
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Mary had a little lamb"), Int(4)),
      CmpOp("==", ListExpr(Str("little")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Mary had a little lamb"), Int(3)),
      CmpOp("==", ListExpr(Str("Mary"), Str("lamb")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("simple white space"), Int(2)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Hello world"), Int(4)),
      CmpOp("==", ListExpr(Str("world")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Uncle sam"), Int(3)),
      CmpOp("==", ListExpr(Str("Uncle")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str(""), Int(0)),
      CmpOp("==", ListExpr()))))
