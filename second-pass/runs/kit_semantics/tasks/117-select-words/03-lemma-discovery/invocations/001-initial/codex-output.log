+++ b/trust-boundary.json
@@ -0,0 +1,116 @@
+{
+  "schema_version": 2,
+  "inventory_sha256": "b8a651c082f47c4331d73fb06595968cd0537666f9d79a596a98bb456cea6f9e",
+  "rules": [
+    {
+      "source_rule_id": "rule-88d44bbeacc012163f4a550cc7f2da110222e8f0d8ee5c4e2265041bb159478b",
+      "classification": "DEFINITION",
+      "rationale": "Unconditionally expands the proof-only name charLoopBody to the exact MPY statement tree for the source loop body; it defines a named proof term and is not an execution rule."
+    },
+    {
+      "source_rule_id": "rule-8635913e32586d18bce90e9d51186e6c6f50482fb25069a2904dfe8c644ef207",
+      "classification": "DEFINITION",
+      "rationale": "Unconditionally expands afterCharLoop to the exact final conditional-append and return statement tree, so it is a named-term definition rather than an operational semantic rule."
+    },
+    {
+      "source_rule_id": "rule-650eec71495d5eaf1154e20a3faf4c89d6057eadfb8dafacdb0543762db3f0ec",
+      "classification": "DEFINITION",
+      "rationale": "Defines selectWordsBody by composing the exact initialization statements, loop term, and post-loop term used in the proof."
+    },
+    {
+      "source_rule_id": "rule-45277caa31dec6a3e3af4c4523cca6e1309014853e9ab22bdbe274101b1caf95",
+      "classification": "DEFINITION",
+      "rationale": "Defines the flushSelected count-mismatch branch: no word is selected and the accumulator is returned unchanged."
