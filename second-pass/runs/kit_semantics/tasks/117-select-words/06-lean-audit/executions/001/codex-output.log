     1	def select_words(s, n):
     2	    result = []
     3	    word = ""
     4	    count = 0
     5	    ch = ""
     6	    for ch in s:
     7	        if ch == " ":
     8	            if count == n and word != "":
     9	                result.append(word)
    10	            word = ""
    11	            count = 0
    12	        else:
    13	            word = word + ch
    14	            if ch not in "aeiouAEIOU":
    15	                count = count + 1
    16	    if count == n and word != "":
    17	        result.append(word)
    18	    return result
