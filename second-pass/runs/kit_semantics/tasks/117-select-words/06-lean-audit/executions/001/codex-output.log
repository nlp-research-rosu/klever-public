+        == "KLEAN_NO_OBLIGATIONS"
+        and preflight["status"] == "KLEAN_NO_OBLIGATIONS"
+        and export_result["status"] == "KLEAN_NO_OBLIGATIONS"
+    ),
+    "all_targets_absent": (
