 Compare(Name(\"count\"), CmpOp(\"==\", Name(\"n\"))),\n    54\t         Compare(Name(\"word\"), CmpOp(\"!=\", Str(\"\")))),\n    55\t      Expr(Call(Attribute(Name(\"result\"), \"append\"), Name(\"word\")))\n    56\t      .Stmts,\n    57\t      .Stmts)\n    58\t    Return(Name(\"result\"))\n    59\t    .Stmts\n    60\t\n    61\t  rule selectWordsBody =>\n    62\t    Assign(Name(\"result\"), ListExpr(.Exprs))\n    63\t    Assign(Name(\"word\"), Str(\"\"))\n    64\t    Assign(Name(\"count\"), Int(0))\n    65\t    Assign(Name(\"ch\"), Str(\"\"))\n    66\t    For(Name(\"ch\"), Name(\"s\"), charLoopBody)\n    67\t    afterCharLoop\n    68\t\n    69\t  // Flush never selects an empty token, including when n == 0.\n    70\t  rule flushSelected(A:ValSeq, _WORD:IntSeq, COUNT:Int, N:Int) => A\n    71\t    requires COUNT =/=Int N\n    72\t    [simplification]\n    73\t  rule flushSelected(A:ValSeq, .IntSeq, COUNT:Int, N:Int) => A\n    74\t    requires COUNT ==Int N\n    75\t    [simplification]\n    76\t  rule flushSelected(A:ValSeq, WORD:IntSeq, COUNT:Int, N:Int)\n    77\t    => valSeqConcat(A, vCons(str(WORD), .ValSeq))\n    78\t    requires COUNT ==Int N andBool notBool (WORD ==K .IntSeq)\n    79\t    [simplification]\n    80\t\n    81\t  rule selectScan(S:IntSeq, N:Int, WORD:IntSeq, COUNT:Int, A:ValSeq)\n    82\t    => flushSelected(\n    83\t         scanAccum(S, N, WORD, COUNT, A),\n    84\t         wordAfter(S, WORD),\n    85\t         countAfter(S, COUNT),\n    86\t         N)\n    87\t    [simplification]\n    88\t\n    89\t  // A space ends the current word.  Empty runs never create words.\n    90\t  rule scanAccum(.IntSeq, _N:Int, _WORD:IntSeq, _COUNT:Int, A:ValSeq)\n    91\t    => A\n    92\t    [simplification]\n    93\t  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int, _WORD:IntSeq,\n    94\t                 COUNT:Int, A:ValSeq)\n    95\t    => scanAccum(R, N, .IntSeq, 0, A)\n    96\t    requires C ==Int 32 andBool COUNT =/=Int N\n    97\t    [simplification]\n    98\t  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int, .IntSeq,\n    99\t                 COUNT:Int, A:ValSeq)\n   100\t    => scanAccum(R, N, .IntSeq, 0, A)\n   101\t    requires C ==Int 32 andBool COUNT ==Int N\n   102\t    [simplification]\n   103\t  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int,\n   104\t                 WORD:IntSeq, COUNT:Int, A:ValSeq)\n   105\t    => scanAccum(\n   106\t         R, N, .IntSeq, 0,\n   107\t         valSeqConcat(\n   108\t           A, vCons(str(WORD), .ValSeq)))\n   109\t    requires C ==Int 32 andBool COUNT ==Int N\n   110\t      andBool notBool (WORD ==K .IntSeq)\n   111\t    [simplification]\n   112\t\n   113\t  // Every non-space code extends the current word.  Membership in the exact\n   114\t  // vowel literal used by solution.py determines whether the count changes.\n   115\t  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int, WORD:IntSeq,\n   116\t                 COUNT:Int, A:ValSeq)\n   117\t    => scanAccum(\n   118\t         R, N, seqConcat(WORD, iCons(C, .IntSeq)), COUNT, A)\n   119\t    requires C =/=Int 32\n   120\t      andBool strContains(\n   121\t        iCons(C, .IntSeq), strToCodes(\"aeiouAEIOU\"))\n   122\t    [simplification]\n   123\t  rule scanAccum(iCons(C:Int, R:IntSeq), N:Int, WORD:IntSeq,\n   124\t                 COUNT:Int, A:ValSeq)\n   125\t    => scanAccum(\n   126\t         R, N, seqConcat(WORD, iCons(C, .IntSeq)),\n   127\t         COUNT +Int 1, A)\n   128\t    requires C =/=Int 32\n   129\t      andBool notBool strContains(\n   130\t        iCons(C, .IntSeq), strToCodes(\"aeiouAEIOU\"))\n   131\t    [simplification]\n   132\t\n   133\t  // Final loop-local values.  They are specified separately so the loop\n   134\t  // circularity describes exactly the state that the fixed semantics reaches.\n   135\t  rule wordAfter(.IntSeq, WORD:IntSeq) => WORD\n   136\t    [simplification]\n   137\t  rule wordAfter(iCons(C:Int, R:IntSeq), _WORD:IntSeq)\n   138\t    => wordAfter(R, .IntSeq)\n   139\t    requires C ==Int 32\n   140\t    [simplification]\n   141\t  rule wordAfter(iCons(C:Int, R:IntSeq), WORD:IntSeq)\n   142\t    => wordAfter(R, seqConcat(WORD, iCons(C, .IntSeq)))\n   143\t    requires C =/=Int 32\n   144\t    [simplification]\n   145\t\n   146\t  rule countAfter(.IntSeq, COUNT:Int) => COUNT\n   147\t    [simplification]\n   148\t  rule countAfter(iCons(C:Int, R:IntSeq), _COUNT:Int)\n   149\t    => countAfter(R, 0)\n   150\t    requires C ==Int 32\n   151\t    [simplification]\n   152\t  rule countAfter(iCons(C:Int, R:IntSeq), COUNT:Int)\n   153\t    => countAfter(R, COUNT)\n   154\t    requires C =/=Int 32\n   155\t      andBool strContains(\n   156\t        iCons(C, .IntSeq), strToCodes(\"aeiouAEIOU\"))\n   157\t    [simplification]\n   158\t  rule countAfter(iCons(C:Int, R:IntSeq), COUNT:Int)\n   159\t    => countAfter(R, COUNT +Int 1)\n   160\t    requires C =/=Int 32\n   161\t      andBool notBool strContains(\n   162\t        iCons(C, .IntSeq), strToCodes(\"aeiouAEIOU\"))\n   163\t    [simplification]\n   164\t\n   165\t  rule charAfter(.IntSeq, OLD:IntSeq) => OLD\n   166\t    [simplification]\n   167\t  rule charAfter(iCons(C:Int, R:IntSeq), _OLD:IntSeq)\n   168\t    => charAfter(R, iCons(C, .IntSeq))\n   169\t    [simplification]\n   170\t\n   171\tendmodule\n===== /candidate/spec.k\n     1\trequires \"verification.k\"\n     2\t\n     3\tmodule SPEC\n     4\t  imports VERIFICATION\n     5\t\n     6\t  // Loop circularity over the exact ordinary local frame and result-list heap\n     7\t  // cell.  Return and frame pop remain outside this invariant.\n     8\t  claim [select-words-loop]:\n     9\t    <k>\n    10\t      #loop(str(S:IntSeq), Name(\"ch\"), charLoopBody)\n    11\t      =>\n    12\t      .K\n    13\t      ...\n    14\t    </k>\n    15\t    <env> L </env>\n    16\t    <scopes>\n    17\t      ...\n    18\t      L |-> (\n    19\t        scope(\n    20\t          \"s\"      |-> str(ORIGINAL:IntSeq)\n    21\t          \"n\"      |-> N:Int\n    22\t          \"result\" |-> ref(H:Int)\n    23\t          \"word\"   |-> str(WORD:IntSeq)\n    24\t          \"count\"  |-> COUNT:Int\n    25\t          \"ch\"     |-> str(OLDCH:IntSeq),\n    26\t          parent(0))\n    27\t        =>\n    28\t        scope(\n    29\t          \"s\"      |-> str(ORIGINAL)\n    30\t          \"n\"      |-> N\n    31\t          \"result\" |-> ref(H)\n    32\t          \"word\"   |-> str(wordAfter(S, WORD))\n    33\t          \"count\"  |-> countAfter(S, COUNT)\n    34\t          \"ch\"     |-> str(charAfter(S, OLDCH)),\n    35\t          parent(0)))\n    36\t      ...\n    37\t    </scopes>\n    38\t    <heap>\n    39\t      H |-> (list(A:ValSeq) => list(scanAccum(S, N, WORD, COUNT, A)))\n    40\t      ...\n    41\t    </heap>\n    42\t    requires N >=Int 0\n    43\t\n    44\t  // Whole-program claim from the initial reference configuration.  The\n    45\t  // function definition, parameter binding, body, loop, return, and heap\n    46\t  // result all execute under the fixed semantics.\n    47\t  claim [select-words]:\n    48\t    <k>\n    49\t      #loadAll(Module(\n    50\t        FuncDef(\"select_words\", Params(\"s\", \"n\"), selectWordsBody)\n    51\t        .Stmts))\n    52\t      ~> Call(Name(\"select_words\"), str(S:IntSeq), N:Int)\n    53\t      =>\n    54\t      ref(0)\n    55\t    </k>\n    56\t    <env> 0 </env>\n    57\t    <scopes>\n    58\t      0 |-> scope(\n    59\t        .Map\n    60\t        =>\n    61\t        \"select_words\" |->\n    62\t          closureVal((\"s\", \"n\", .ParamNames), selectWordsBody, 0),\n    63\t        parent(-1))\n    64\t      -1 |-> builtinsScope\n    65\t    </scopes>\n    66\t    <scopeLoc> 1 </scopeLoc>\n    67\t    <heap>\n    68\t      .Map\n    69\t      =>\n    70\t      0 |-> list(selectScan(S, N, .IntSeq, 0, .ValSeq))\n    71\t    </heap>\n    72\t    <heapLoc> 0 => 1 </heapLoc>\n    73\t    <stack> .List </stack>\n    74\t    <ret> noRet </ret>\n    75\t    <exc> NoExc </exc>\n    76\t    <exit-code> 0 </exit-code>\n    77\t    requires N >=Int 0\n    78\tendmodule\n===== /candidate/prove.sh\n     1\t#!/usr/bin/env bash\n     2\tset -euo pipefail\n     3\t\n     4\tpython3 py2mpy.py solution.py > solution.mpy\n     5\tpython3 -m py_compile solution.py smoke.py test_solution.py\n     6\tpython3 test_solution.py | tee differential.out\n     7\t\n     8\tkompile --backend llvm reference-semantics/semantics.k \\\n     9\t  --main-module MPY-KRUN \\\n    10\t  --syntax-module MPY-SYNTAX \\\n    11\t  --output-definition runtime-kompiled\n    12\tpython3 py2mpy.py smoke.py > smoke.mpy\n    13\tkrun smoke.mpy --definition runtime-kompiled | tee krun-smoke.out\n    14\trg -U '<k>[[:space:]]+\\.K[[:space:]]+</k>' krun-smoke.out > /dev/null\n    15\t\n    16\tkompile --backend haskell verification.k \\\n    17\t  --main-module VERIFICATION \\\n    18\t  --syntax-module MPY-SYNTAX \\\n    19\t  --output-definition verification-kompiled\n    20\tkprove spec.k \\\n    21\t  --definition verification-kompiled \\\n    22\t  --spec-module SPEC | tee proof-positive.out\n    23\trg '^#Top$' proof-positive.out > /dev/null\n    24\t\n    25\tset +e\n    26\tkprove spec-vacuity.k \\\n    27\t  --definition verification-kompiled \\\n    28\t  --spec-module SPEC-VACUITY 2>&1 | tee vacuity.out\n    29\tvacuity_status=${PIPESTATUS[0]}\n    30\tset -e\n    31\tprintf '%s\\n' \"$vacuity_status\" > vacuity.exit\n    32\ttest \"$vacuity_status\" -eq 1\n    33\trg 'WarnStuckClaimState' vacuity.out > /dev/null\n    34\t\n    35\tset +e\n    36\tkprove spec-body-mutation.k \\\n    37\t  --definition verification-kompiled \\\n    38\t  --spec-module SPEC-BODY-MUTATION 2>&1 | tee body-mutation.out\n    39\tbody_status=${PIPESTATUS[0]}\n    40\tset -e\n    41\tprintf '%s\\n' \"$body_status\" > body-mutation.exit\n    42\ttest \"$body_status\" -eq 1\n    43\trg 'WarnStuckClaimState' body-mutation.out > /dev/null\n    44\t\n    45\tprintf 'all positive checks passed; both negative probes failed as expected\\n'\n===== /candidate/PROOF.md\n     1\tVALIDATED\n     2\t\n     3\t## What is proven\n     4\t\n     5\tUnder the supplied `MPY` semantics, for every finite `IntSeq` string `S` and\n     6\tevery integer `N >= 0`, the exact translated `select_words` definition is\n     7\tpartially correct:\n     8\t\n     9\t- the function definition is loaded and selected through normal name lookup;\n    10\t- `S` and `N` are bound through the normal function-call rules;\n    11\t- the translated Python body executes, including list allocation, iteration,\n    12\t  comparisons, concatenation, append, return, and frame cleanup;\n    13\t- the returned value is `ref(0)` and heap location `0` contains\n    14\t  `list(selectScan(S, N, .IntSeq, 0, .ValSeq))`.\n    15\t\n    16\t`selectScan` is the mathematical property definition. It scans left to right,\n    17\tuses code 32 as the word separator, never emits an empty word, increments the\n    18\tcurrent count exactly when the character is absent from\n    19\t`\"aeiouAEIOU\"`, and appends the completed word exactly when the count equals\n    20\t`N`. `valSeqConcat` preserves encounter order.\n    21\t\n    22\tThis is a partial-correctness result in the Kit sense. It does not make a\n    23\tseparate liveness, complexity, or resource-bound claim.\n    24\t\n    25\t## Formal claims and validation scope\n    26\t\n    27\t`SPEC.select-words-loop` is the loop circularity. At the exact loop head it\n    28\trelates:\n    29\t\n    30\t- the unprocessed suffix `S`;\n    31\t- locals `word`, `count`, and `ch`;\n    32\t- the closed ordinary local frame containing `s`, `n`, and `result`; and\n    33\t- heap location `H` containing the accumulated list `A`\n    34\t\n    35\tto `wordAfter(S, WORD)`, `countAfter(S, COUNT)`,\n    36\t`charAfter(S, OLDCH)`, and `scanAccum(S, N, WORD, COUNT, A)`.\n    37\tThe continuation and all unmentioned cells are framed unchanged.\n    38\t\n    39\t`SPEC.select-words` is the entry theorem. Its left side starts at\n    40\t`#loadAll(Module(FuncDef(...))) ~> Call(...)` in the complete initial\n    41\tconfiguration. Its right side constrains the returned reference, selected-word\n    42\theap contents, final module binding, allocation counters, empty call stack,\n    43\t`noRet`, `NoExc`, and exit code 0.\n    44\t\n    45\tValidation scope:\n    46\t\n    47\t- Program boundary: the exact `FuncDef` and all program-defined operations in\n    48\t  `solution.mpy`.\n    49\t- Input domain: every `str(IntSeq)` represented by the semantics and every\n    50\t  natural-number argument `N >= 0`. This is a superset of the prompt's promised\n    51\t  letters-and-spaces strings.\n    52\t- Observable final state: returned reference and its heap list, plus the\n    53\t  lifecycle cells constrained by the entry claim.\n    54\t- Intended property: all and only space-delimited, nonempty words with exactly\n    55\t  `N` non-vowel characters, in source order.\n    56\t\n    57\tBoth claims were proved together, so the entry theorem had the loop claim\n    58\tavailable as a circularity.\n    59\t\n    60\t## Proof-extension inventory\n    61\t\n    62\t### Exact AST names\n    63\t\n    64\tExtensions: `charLoopBody`, `afterCharLoop`, and `selectWordsBody`, with one\n    65\tunconditional equation each.\n    66\t\n    67\t- Class: definitional summary.\n    68\t- Semantic role: names exact MPY syntax trees; it does not replace an MPY\n    69\t  operational transition.\n    70\t- Domain and matched context: every occurrence of the corresponding proof-only\n    71\t  `Stmts` symbol; no guard, continuation, binding, or state is matched.\n    72\t- Justification scope and context containment: each right side is the literal\n    73\t  AST emitted in `solution.mpy`; expansion is valid in every syntax context in\n    74\t  which the name can occur.\n    75\t- State footprint: none.\n    76\t- Value/control influence: these names determine the exact source body used by\n    77\t  both claims.\n    78\t- Value justification: not result-bearing; the equations only expand syntax.\n    79\t- Dependents: both target claims.\n    80\t- Control/value validation: `prove.sh` regenerates `solution.mpy` directly\n    81\t  from `solution.py`; manual comparison of the final constructor tree with\n    82\t  these equations is exact. The body-sensitivity probe changes the initial\n    83\t  `count` assignment and the original result theorem is rejected.\n    84\t\n    85\t### Mathematical result and loop-state summaries\n    86\t\n    87\tExtensions: `selectScan`, `scanAccum`, `flushSelected`, `wordAfter`,\n    88\t`countAfter`, and `charAfter`, including their `[simplification]` equations.\n    89\t\n    90\t- Class: definitional summary.\n    91\t- Semantic role: describes mathematical results and expected loop-local state;\n    92\t  none of these symbols occurs in the source computation or rewrites an MPY\n    93\t  program term.\n    94\t- Domain: all declared `IntSeq`, `Int`, and `ValSeq` arguments.\n    95\t- Matched context: pure applications of the named functions. No `<k>` term,\n    96\t  continuation, control stack, binding, or operational cell is matched.\n    97\t- Justification scope and context containment: the equations are definitions\n    98\t  over the complete constructor domains.\n    99\t- State footprint: none directly. Their values constrain the loop's local\n   100\t  scope and the selected-word heap cell.\n   101\t- Value influence: `scanAccum` affects the result list; `wordAfter` and\n   102\t  `countAfter` affect the final flush; `charAfter` constrains the last loop\n   103\t  target; `selectScan` is the entry postcondition.\n   104\t- Value justification: exhaustive recursive equations that descend on `S`.\n   105\t  Space/non-space, equal/not-equal count, empty/nonempty word, and\n   106\t  vowel/non-vowel guards cover the full use domain.\n   107\t- Dependents: `SPEC.select-words-loop` and `SPEC.select-words`.\n   108\t- Control validation: not applicable; these equations do not replace\n   109\t  execution.\n   110\t- Value validation: the loop claim and entry claim both print `#Top`; the\n   111\t  false-result probe is rejected on `(\"b\", 1)`; 7,729 independent\n   112\t  differential checks report zero mismatches.\n   113\t- Equation audit: guard pairs are disjoint, except no overlapping equations\n   114\t  remain with different right sides. Base equations terminate immediately;\n   115\t  recursive equations consume one `iCons`; `flushSelected` is nonrecursive;\n   116\t  `selectScan` expands once into the other structurally recursive definitions.\n   117\t\n   118\t### Loop circularity\n   119\t\n   120\tExtension: `SPEC.select-words-loop`.\n   121\t\n   122\t- Class: derived lemma (auxiliary reachability claim).\n   123\t- Semantic role: executes the fixed `#loop` rules and the exact Python loop\n   124\t  body, then supplies a reusable universal loop theorem to the entry proof.\n   125\t  It is not an ordinary rewrite in `verification.k`.\n   126\t- Domain: all finite suffixes `S`, all integer local counts and words, all list\n   127\t  accumulators, and `N >= 0`, with `result` pinned to a heap location containing\n   128\t  a list.\n   129\t- Matched context: exact `#loop(str(S), Name(\"ch\"), charLoopBody)` at the head\n   130\t  of `<k>` with the existing continuation framed; environment `L`; a closed\n   131\t  ordinary local scope with the six source locals and parent 0; heap entry\n   132\t  `H |-> list(A)`; all other cells and map entries framed and preserved.\n   133\t- Justification scope and context containment: the claim proves precisely that\n   134\t  matched configuration. The body contains no abrupt control, so the framed\n   135\t  continuation is preserved by every fixed-semantics step.\n   136\t- State footprint: reads `s`, `n`, `word`, `count`, `ch`, and `result`; writes\n   137\t  `word`, `count`, `ch`, and heap entry `H`; preserves the remaining scope,\n   138\t  heap, continuation, stack, return, exception, allocation, and exit cells.\n   139\t- Value influence: determines every selected element and the loop-local values\n   140\t  used by the final flush.\n   141\t- Value justification: the exhaustive definitions above match the exact branch\n   142\t  predicates in `charLoopBody`.\n   143\t- Dependents: `SPEC.select-words`.\n   144\t- Control validation: the focused loop proof printed `#Top`; the full proof\n   145\t  printed `#Top`; the body mutation was rejected after fixed execution reached\n   146\t  an empty result rather than the required `[\"b\"]`.\n   147\t- Value validation: the false postcondition was rejected with the concrete\n   148\t  reached heap containing `[\"b\"]`.\n   149\t\n   150\tThere are no proof-local operational bridges, priority rules, opaque result\n   151\toracles, or trusted primitives.\n   152\t\n   153\t## Reproducible commands and actual results\n   154\t\n   155\tThe complete recorded runner is:\n   156\t\n   157\t```bash\n   158\t./prove.sh\n   159\t```\n   160\t\n   161\tActual final line: `all positive checks passed; both negative probes failed as expected`\n   162\t\n   163\tActual exit: 0.\n   164\t\n   165\tThe runner contains these exact positive proof commands:\n   166\t\n   167\t```bash\n   168\tkompile --backend haskell verification.k \\\n   169\t  --main-module VERIFICATION \\\n   170\t  --syntax-module MPY-SYNTAX \\\n   171\t  --output-definition verification-kompiled\n   172\tkprove spec.k \\\n   173\t  --definition verification-kompiled \\\n   174\t  --spec-module SPEC\n   175\t```\n   176\t\n   177\tActual `kprove` stdout in `proof-positive.out`:\n   178\t\n   179\t```text\n   180\t#Top\n   181\t```\n   182\t\n   183\tActual `kprove` exit: 0. The Haskell compilation exited 0; its only diagnostics\n   184\twere the supplied `str.k` unused-variable warnings for `As` and `Bs`.\n   185\t\n   186\tConcrete execution uses the required module selection:\n   187\t\n   188\t```bash\n   189\tkompile --backend llvm reference-semantics/semantics.k \\\n   190\t  --main-module MPY-KRUN \\\n   191\t  --syntax-module MPY-SYNTAX \\\n   192\t  --output-definition runtime-kompiled\n   193\tpython3 py2mpy.py smoke.py > smoke.mpy\n   194\tkrun smoke.mpy --definition runtime-kompiled\n   195\t```\n   196\t\n   197\tActual result: exit 0 with `.K` in `<k>` and `NoExc`; the complete final\n   198\tconfiguration is in `krun-smoke.out`. LLVM compilation emitted only warnings\n   199\tfrom unused or nonexhaustive supplied semantics functions outside this\n   200\tprogram's exercised paths.\n   201\t\n   202\tDifferential command:\n   203\t\n   204\t```bash\n   205\tpython3 test_solution.py\n   206\t```\n   207\t\n   208\tActual output:\n   209\t\n   210\t```text\n   211\tdifferential checks: 7729; mismatches: 0\n   212\t```\n   213\t\n   214\tThe scope was the five prompt examples, the empty-string boundary case, every\n   215\tstring over `\"aB \"` of lengths 0 through 6 paired with `n = 0..6`, and six\n   216\tstructured cases paired with `n = 0..11`. The oracle independently uses Python\n   217\t`str.split()` plus a consonant-count comprehension.\n   218\t\n   219\tFalse-postcondition command:\n   220\t\n   221\t```bash\n   222\tkprove spec-vacuity.k \\\n   223\t  --definition verification-kompiled \\\n   224\t  --spec-module SPEC-VACUITY\n   225\t```\n   226\t\n   227\tActual result: exit 1 with `WarnStuckClaimState`. For the satisfiable witness\n   228\t`s = \"b\", n = 1`, the reached heap contains `[\"b\"]` while the mutation requires\n   229\t`[]`. Full output is in `vacuity.out`; the exit is in `vacuity.exit`.\n   230\t\n   231\tBody-sensitivity command:\n   232\t\n   233\t```bash\n   234\tkprove spec-body-mutation.k \\\n   235\t  --definition verification-kompiled \\\n   236\t  --spec-module SPEC-BODY-MUTATION\n   237\t```\n   238\t\n   239\tActual result: exit 1 with `WarnStuckClaimState`. Changing initial `count` from\n   240\t0 to 1 reaches `[]` for `s = \"b\", n = 1`, while the original theorem requires\n   241\t`[\"b\"]`. Full output is in `body-mutation.out`; the exit is in\n   242\t`body-mutation.exit`.\n   243\t\n   244\t## Gate results\n   245\t\n   246\t### Gate A — PASS\n   247\t\n   248\t- A1: the exact program-defined function executes under fixed semantics.\n   249\t  `solution.mpy` is regenerated from the unmodified translator, and the\n   250\t  function-body mutation invalidates the original result.\n   251\t- A2: no operational bridge skips state. The loop theorem explicitly tracks\n   252\t  the local scope and result heap entry; framed cells are preserved.\n   253\t- A3: the entry claim exercises loading, lookup, argument evaluation and\n   254\t  binding, allocation, append, return, and frame pop. The loop claim pins a\n   255\t  closed ordinary local frame and exact list binding, while preserving an\n   256\t  arbitrary continuation.\n   257\t- A4: all proof-local functions have exhaustive, terminating, compatible\n   258\t  equations. No false off-domain rule, opacity, or execution preemption was\n   259\t  found.\n   260\t- A5: `(\"b\", 1)` realizes the precondition, produces `[\"b\"]`, and the false\n   261\t  `[]` postcondition is rejected with exit 1.\n   262\t\n   263\t### Gate B — PASS\n   264\t\n   265\t- B1: the only precondition is `N >= 0`. The formal string domain is broader\n   266\t  than the prompt's promised letters-and-spaces domain, so no intended input is\n   267\t  excluded.\n   268\t- B2: the supplied model represents strings as finite integer-code sequences\n   269\t  and lists as heap objects. For the operations used here—iteration, ASCII\n   270\t  literal equality/membership, concatenation, comparison, and append—this\n   271\t  preserves the value distinctions needed by the prompt. CPython behaviors\n   272\t  outside the supplied subset are excluded below.\n   273\t- B3: implementation refinement to `selectScan` is formally proved.\n   274\t  `selectScan`'s equations directly define the requested word boundary,\n   275\t  consonant count, empty-token, and order behavior. The finite differential\n   276\t  run independently supports, but does not replace, this formal connection.\n   277\t- B4: all prompt examples and the empty-input case pass under both CPython and\n   278\t  the supplied LLVM semantics.\n   279\t\n   280\t### Gate C — PASS\n   281\t\n   282\t- C1: the trust ledger below names all components outside the proof-local\n   283\t  theorem. There is no hidden proof-local oracle.\n   284\t- C2: every cited artifact and exact command exists. Positive proof, concrete\n   285\t  execution, differential, false-result, and body-mutation evidence are\n   286\t  reproducible through `prove.sh`.\n   287\t- C3: this report separates the K theorem, conditional trust in the supplied\n   288\t  semantics/toolchain, finite empirical evidence, and excluded behavior.\n   289\t\n   290\t## Trust boundary\n   291\t\n   292\t| Component | Why outside this theorem | Influence | Dependents | Evidence |\n   293\t|---|---|---|---|---|\n   294\t| Supplied `reference-semantics/` MPY rules | Fixed theory required by the task; not reproved here | Value, control, heap, scopes, exceptions | Both claims | LLVM prompt-example execution, CPython differential tests, direct source inspection |\n   295\t| `py2mpy.py` | Fixed translator supplied by the task | Program identity | Entry claim/body comparison | `prove.sh` regenerates `solution.mpy`; translation succeeds deterministically |\n   296\t| K v7.1.293 compiler and Haskell/LLVM backends | Verification toolchain trusted computing base | Compilation, symbolic closure, concrete execution | All machine results | Exit codes, `#Top`, concrete `.K`, and discriminating negative probes |\n   297\t| CPython oracle in `test_solution.py` | Finite validation evidence, not part of the theorem | Adequacy evidence only | Gate C evidence | 7,729 checks, zero mismatches |\n   298\t\n   299\t## Empirically supported facts\n   300\t\n   301\tThe prompt examples and empty case terminate with no K exception. The\n   302\tindependent Python oracle agrees on 7,729 recorded inputs. These are finite\n   303\tevidence only; universal correctness comes from the two reachability claims\n   304\tunder the supplied K theory.\n   305\t\n   306\t## Excluded behavior\n   307\t\n   308\t- `n < 0`, non-integer `n`, and non-string `s` are outside the formal input\n   309\t  contract.\n   310\t- Inputs that violate the prompt's letters-and-spaces promise are proved\n   311\t  against the implementation's literal non-vowel rule, but no English\n   312\t  linguistic interpretation is claimed for punctuation or other symbols.\n   313\t- Behaviors absent from the supplied subset—full CPython exception behavior,\n   314\t  object identity details outside the modeled heap, concurrency, I/O, and\n   315\t  implementation performance—are not claimed.\n   316\t- The result is conditional on the supplied reference semantics, translator,\n   317\t  and K toolchain. It is not an independent proof that those components\n   318\t  implement all of CPython.\n   319\t- Termination bounds and resource usage are not claimed.\n","internal_chat_message_metadata_passthrough":{"turn_id":"019fae47-b63e-78c1-86e6-e5a7adc0e805"}}}
