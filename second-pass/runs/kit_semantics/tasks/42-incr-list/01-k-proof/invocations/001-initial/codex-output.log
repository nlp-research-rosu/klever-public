diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0988a161fef51049a3d4a5d4125f5691fafbbc7c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,99 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        list(REM:ValSeq),
+        Name("x"),
+        Expr(
+          Call(
+            Attribute(Name("result"), "append"),
+            (BinOp("+", Name("x"), Int(1)), .Exprs)))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "l"      |-> list(INPUT:ValSeq)
+        "result" |-> ref(H:Int)
+        "x"      |-> (X:Val => ?X:Val),
+        P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> (list(ACC:ValSeq) => list(incrAcc(ACC, REM)))
+      ...
+    </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumeric(REM)
+
+  claim [incr-list]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "incr_list",
+            Params("l"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("x"), Int(0))
+            For(
+              Name("x"),
+              Name("l"),
+              Expr(
+                Call(
+                  Attribute(Name("result"), "append"),
+                  (BinOp("+", Name("x"), Int(1)), .Exprs)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("incr_list"), (list(INPUT:ValSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "incr_list" |->
+           closureVal(
+             "l",
+             Assign(Name("result"), ListExpr(.Exprs))
+             Assign(Name("x"), Int(0))
+             For(
+               Name("x"),
+               Name("l"),
+               Expr(
+                 Call(
+                   Attribute(Name("result"), "append"),
+                   (BinOp("+", Name("x"), Int(1)), .Exprs)))
+               .Stmts)
+             Return(Name("result"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(incrAcc(.ValSeq, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumeric(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3e55b32331c03ec9b8cc6b3fb434bac9ab7882b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The source operation `x + 1` is defined by the supplied semantics for
+  // Int, Bool, and Float values.  This predicate records exactly that domain.
+  syntax Bool ::= isNumericVal(Val) [function, total]
+  rule isNumericVal(_:Int)   => true
+  rule isNumericVal(_:Bool)  => true
+  rule isNumericVal(_:Float) => true
+  rule isNumericVal(_:Val)   => false [owise]
+
+  syntax Bool ::= allNumeric(ValSeq) [function, total]
+  rule allNumeric(.ValSeq)                => true
+  rule allNumeric(vCons(V:Val, R:ValSeq)) => isNumericVal(V) andBool allNumeric(R)
+
+  // Exact iterative summary of the result-list contents.  applyBin is the
+  // fixed semantics' own operator dispatch; no program execution is replaced.
+  syntax ValSeq ::= incrAcc(ValSeq, ValSeq) [function, total]
+  rule incrAcc(ACC:ValSeq, .ValSeq) => ACC
+  rule incrAcc(ACC:ValSeq, vCons(V:Val, R:ValSeq))
+    => incrAcc(
+         valSeqConcat(ACC, vCons(applyBin("+", V, 1), .ValSeq)),
+         R)
+endmodule

