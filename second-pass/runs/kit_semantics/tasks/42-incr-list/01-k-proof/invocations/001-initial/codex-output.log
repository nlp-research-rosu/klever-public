new file mode 100644
index 0000000000000000000000000000000000000000..66be365762020dbed982c875985ab7e18823a108
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #loop(
+        list(REM:ValSeq),
+        Name("x"),
+        Expr(
+          Call(
+            Attribute(Name("result"), "append"),
+            (BinOp("+", Name("x"), Int(1)), .Exprs)))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "l"      |-> LVALUE:Val
+        "result" |-> ref(H:Int)
+        "x"      |-> (X:Val => ?X:Val),
+        P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> (list(ACC:ValSeq) => list(incrAcc(ACC, REM)))
+      ...
+    </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumeric(REM)
+
+  claim [incr-list]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "incr_list",
+            Params("l"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("x"), Int(0))
+            For(
+              Name("x"),
+              Name("l"),
+              Expr(
+                Call(
+                  Attribute(Name("result"), "append"),
+                  (BinOp("+", Name("x"), Int(1)), .Exprs)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("incr_list"), (ref(0), .Exprs))
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+         "incr_list" |->
+           closureVal(
+             "l",
+             Assign(Name("result"), ListExpr(.Exprs))
+             Assign(Name("x"), Int(0))
+             For(
+               Name("x"),
+               Name("l"),
+               Expr(
+                 Call(
+                   Attribute(Name("result"), "append"),
+                   (BinOp("+", Name("x"), Int(1)), .Exprs)))
+               .Stmts)
+             Return(Name("result"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(INPUT:ValSeq)
+      =>
+      0 |-> list(INPUT)
+      1 |-> list(incrAcc(.ValSeq, INPUT))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNumeric(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3e55b32331c03ec9b8cc6b3fb434bac9ab7882b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The source operation `x + 1` is defined by the supplied semantics for
+  // Int, Bool, and Float values.  This predicate records exactly that domain.
+  syntax Bool ::= isNumericVal(Val) [function, total]
+  rule isNumericVal(_:Int)   => true
+  rule isNumericVal(_:Bool)  => true
+  rule isNumericVal(_:Float) => true
+  rule isNumericVal(_:Val)   => false [owise]
+
+  syntax Bool ::= allNumeric(ValSeq) [function, total]
+  rule allNumeric(.ValSeq)                => true
+  rule allNumeric(vCons(V:Val, R:ValSeq)) => isNumericVal(V) andBool allNumeric(R)
+
+  // Exact iterative summary of the result-list contents.  applyBin is the
+  // fixed semantics' own operator dispatch; no program execution is replaced.
+  syntax ValSeq ::= incrAcc(ValSeq, ValSeq) [function, total]
+  rule incrAcc(ACC:ValSeq, .ValSeq) => ACC
+  rule incrAcc(ACC:ValSeq, vCons(V:Val, R:ValSeq))
+    => incrAcc(
+         valSeqConcat(ACC, vCons(applyBin("+", V, 1), .ValSeq)),
+         R)
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh && set +e
./prove.sh > prove-run.out 2>&1
status=$?
printf '"'%s\\n' \""'$status" > prove-run.exit
printf '"'PROVE_SH_EXIT=%s\\n' \""'$status"
tail -n 80 prove-run.out
exit "$status"' in /workspace
diff --git a/differential.py b/differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..b9c9ac82e9aadf89b2a0949be1d226c09ae5ca3a
--- /dev/null
+++ b/differential.py
@@ -0,0 +1,24 @@
+"""Deterministic CPython differential check for solution.incr_list."""
+
+from itertools import product
+
+from solution import incr_list
+
+
+VALUES = (-3, 0, 4, False, True, -2.5, 0.5, 3.0)
+CASES = [[]]
+for length in range(1, 4):
+    CASES.extend([list(items) for items in product(VALUES, repeat=length)])
+
+mismatches = []
+for case in CASES:
+    expected = [value + 1 for value in case]
+    actual = incr_list(case)
+    if actual != expected:
+        mismatches.append((case, expected, actual))
+
+print(f"cases={len(CASES)} mismatches={len(mismatches)}")
+if mismatches:
+    for mismatch in mismatches[:10]:
+        print(mismatch)
+    raise SystemExit(1)
