diff --git a//tmp/audit-work/hostpid_shim.c b//tmp/audit-work/hostpid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..792329bc433b4c2fcc9a1abf4cbc6f6ce9d736bb
--- /dev/null
+++ b//tmp/audit-work/hostpid_shim.c
@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox places processes in a PID namespace but exposes a
+ * host-mounted /proc. Lean 4.22 resolves its executable via /proc/<getpid()>/exe,
+ * which fails when getpid() is namespace-local. Return the host-visible PID
+ * from /proc/self so that this read-only executable lookup succeeds.
+ */
+pid_t getpid(void) {
+    char link_target[64];
+    ssize_t length = readlink("/proc/self", link_target,
+                              sizeof(link_target) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(link_target)) {
+        return (pid_t)1;
+    }
+    link_target[length] = '\0';
+
+    errno = 0;
+    char *end = NULL;
+    long host_pid = strtol(link_target, &end, 10);
+    if (errno != 0 || end == link_target || *end != '\0' ||
+        host_pid <= 0 || host_pid > INT_MAX) {
+        return (pid_t)1;
+    }
+    return (pid_t)host_pid;
+}
