    18	  // Exact iterative summary of the result-list contents.  applyBin is the
    19	  // fixed semantics' own operator dispatch; no program execution is replaced.
    20	  syntax ValSeq ::= incrAcc(ValSeq, ValSeq) [function, total]
    21	  rule incrAcc(ACC:ValSeq, .ValSeq) => ACC
    22	  rule incrAcc(ACC:ValSeq, vCons(V:Val, R:ValSeq))
