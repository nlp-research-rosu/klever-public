+      0 |-> list(vCons(0, .ValSeq))
+      =>
+      0 |-> list(vCons(0, .ValSeq))
+      1 |-> list(vCons(1, .ValSeq))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
