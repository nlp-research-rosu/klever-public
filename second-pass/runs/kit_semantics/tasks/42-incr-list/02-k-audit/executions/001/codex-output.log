+}
+
+echo '$ command -v kup; command -v kompile; command -v krun; command -v kprove'
+command -v kup || true
+command -v kompile
+command -v krun
+command -v kprove
+echo '$ kompile --version; kprove --version'
+kompile --version
+kprove --version
