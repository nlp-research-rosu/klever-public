+             Assign(Name("result"), ListExpr(.Exprs))
+             Assign(Name("x"), Int(0))
+             For(
+               Name("x"),
+               Name("l"),
+               Expr(
+                 Call(
+                   Attribute(Name("result"), "append"),
+                   (BinOp("+", Name("x"), Int(2)), .Exprs)))
+               .Stmts)
+             Return(Name("result"))
+             .Stmts,
+             0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
