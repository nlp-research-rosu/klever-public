    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "f75f569f79b2c115362441fba7806717279c1238ce0191528cc1eb8220a50c99",
      "rationale": "Base equation for the structural definition of allNumeric, defining the empty ValSeq as satisfying the predicate.",
      "source_rule_id": "rule-f75f569f79b2c115362441fba7806717279c1238ce0191528cc1eb8220a50c99",
      "start_line": 15,
      "text": "  rule allNumeric(.ValSeq)                => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "0599900824f5015e8454b006675aebe384009350a1ba7e6c7f893c8f3f2c7fff",
      "rationale": "Recursive constructor equation defining allNumeric on a nonempty ValSeq from the head predicate and the recursively defined tail predicate.",
      "source_rule_id": "rule-0599900824f5015e8454b006675aebe384009350a1ba7e6c7f893c8f3f2c7fff",
      "start_line": 16,
      "text": "  rule allNumeric(vCons(V:Val, R:ValSeq)) => isNumericVal(V) andBool allNumeric(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "dfc5044ec376f017835fd3fb82e8d9f45dd942408b63f2e73bf8d69e88ec62f1",
      "rationale": "Base equation for the incrAcc summary, defining that no remaining elements leave the accumulator unchanged.",
      "source_rule_id": "rule-dfc5044ec376f017835fd3fb82e8d9f45dd942408b63f2e73bf8d69e88ec62f1",
      "start_line": 21,
      "text": "  rule incrAcc(ACC:ValSeq, .ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "2c9fbc7cd6f99b65dbc48f9711be674cb9780c46cb33ec56bd27b7846bb99640",
      "rationale": "Structural recurrence defining incrAcc for one remaining element by appending the fixed applyBin result and recursing on the tail; the loop claim proves its connection to execution, while this rule only defines the summary term.",
      "source_rule_id": "rule-2c9fbc7cd6f99b65dbc48f9711be674cb9780c46cb33ec56bd27b7846bb99640",
      "start_line": 22,
      "text": "  rule incrAcc(ACC:ValSeq, vCons(V:Val, R:ValSeq))\n    => incrAcc(\n         valSeqConcat(ACC, vCons(applyBin(\"+\", V, 1), .ValSeq)),\n         R)"
    }
