/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
output = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(output) == ['schema_version', 'inventory_sha256', 'rules']
assert output['schema_version'] == 2
assert output['inventory_sha256'] == inventory['inventory_sha256']
expected_ids = [rule['source_rule_id'] for rule in inventory['rules']]
actual_ids = [rule['source_rule_id'] for rule in output['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids)) == len(expected_ids)
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for entry in output['rules']:
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
by_id = {entry['source_rule_id']: entry for entry in output['rules']}
for rule in inventory['rules']:
    if 'simplification' in rule['attributes']:
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
assert 'PROVED_DERIVED_LEMMA' not in {entry['classification'] for entry in output['rules']}
print(f\"inventory_sha256={output['inventory_sha256']}\")
print(f\"rules={len(actual_ids)} unique={len(set(actual_ids))} order_match={actual_ids == expected_ids}\")
for classification in sorted(allowed):
    print(f\"{classification}={sum(e['classification'] == classification for e in output['rules'])}\")
PY
python3 -m json.tool trust-boundary.json >/dev/null
test -s DISCOVERY.md
rg -n \"domain-lemma set|PROVED_DERIVED_LEMMA|rule-5cd1e3b\" DISCOVERY.md
