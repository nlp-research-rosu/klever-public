+      "rationale": "This guarded base equation defines sequenceAcc to return the existing accumulator when the loop counter is already above the bound."
+    },
+    {
+      "source_rule_id": "rule-43f49722bb57ff9eafcc5227f4b4353cd12742df4bb56c784efe6e413736cdbf",
+      "classification": "DEFINITION",
+      "rationale": "This guarded recurrence defines one concrete sequenceAcc step by appending a space and the decimal rendering of the current counter, incrementing the counter, and recurring."
+    },
+    {
+      "source_rule_id": "rule-d55499ddc47bd6adf4d30b16fdbd3314a5db1919e0074fd704e4bfe2e4543f7c",
+      "classification": "DEFINITION",
+      "rationale": "This symbolic simplification rule repeats the exact base equation of sequenceAcc so that the defining base case is available during symbolic simplification; it adds no fact beyond that definition."
+    },
+    {
+      "source_rule_id": "rule-5cd1e3b5568df299d3f434281eb340a991725f175ade15ddce1a4febdab6d0fc",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This proof-closing simplification folds an updated successor summary back to the preceding sequenceAcc call. It is the reverse-use consequence of the recurrence, but prove.sh never first proves this exact rule against a module that omits it, so it remains a trusted domain lemma."
+    },
+    {
+      "source_rule_id": "rule-02288b5620299a0a1ac5b02b112560d2ffdd21df6457ef2054ea9f3746dbef3b",
