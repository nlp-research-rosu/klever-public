diff --git a//tmp/lean-hostpid.c b//tmp/lean-hostpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..3925ca354b6e604e86d58560cbadee6f186442c5
--- /dev/null
+++ b//tmp/lean-hostpid.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  FILE *status = fopen("/proc/self/status", "r");
+  if (status == NULL) {
+    return 1;
+  }
+
+  char line[256];
+  while (fgets(line, sizeof line, status) != NULL) {
+    if (strncmp(line, "Pid:", 4) == 0) {
+      long value = strtol(line + 4, NULL, 10);
+      fclose(status);
+      return (pid_t)value;
+    }
+  }
+
+  fclose(status);
+  return 1;
+}
