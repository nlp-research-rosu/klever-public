@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  FILE *status = fopen("/proc/self/status", "r");
+  if (status == NULL) {
+    return 1;
+  }
+
+  char line[256];
+  while (fgets(line, sizeof line, status) != NULL) {
+    if (strncmp(line, "Pid:", 4) == 0) {
+      long value = strtol(line + 4, NULL, 10);
+      fclose(status);
+      return (pid_t)value;
+    }
+  }
+
+  fclose(status);
+  return 1;
+}
