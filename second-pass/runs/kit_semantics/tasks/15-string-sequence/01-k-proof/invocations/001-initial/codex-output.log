diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..dd72e5549d7eb73f06802b60ae0c99a1b955cadb
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // seqSuffix(I, N) is the character-code sequence
+  //   " " + str(I) + ... + " " + str(N)
+  // when I <= N, and the empty sequence otherwise.
+  syntax IntSeq ::= seqSuffix(Int, Int) [function, total]
+
+  rule seqSuffix(I, N) => .IntSeq
+    requires I >Int N
+
+  // This equation gives executable ground evidence while remaining inert on
+  // the symbolic successor in the loop proof.
+  rule seqSuffix(I, N)
+    => seqConcat(
+         iCons(32, strToCodes(Int2String(I))),
+         seqSuffix(I +Int 1, N))
+    requires I <=Int N
+    [concrete]
+
+  // The loop proof uses the defining step in the folding direction.
+  rule seqConcat(
+         iCons(32, strToCodes(Int2String(I))),
+         seqSuffix(I +Int 1, N))
+    => seqSuffix(I, N)
+    requires I <=Int N
+    [simplification]
+
+  // Associativity follows by induction on A from seqConcat's two equations.
+  rule seqConcat(seqConcat(A, B), C)
+    => seqConcat(A, seqConcat(B, C))
+    [simplification]
+
+  // Complete result for every integer input.  The negative case matches
+  // Python's range(n + 1) convention and makes the source contract total.
+  syntax IntSeq ::= stringSequenceCodes(Int) [function, total]
+
+  rule stringSequenceCodes(N) => .IntSeq
+    requires N <Int 0
+
+  rule stringSequenceCodes(N)
+    => seqConcat(iCons(48, .IntSeq), seqSuffix(1, N))
+    requires N >=Int 0
+endmodule

codex
The first symbolic build exposed a K attribute restriction, not a semantic blocker: a function cannot mix a concrete equation with a non-simplification symbolic equation. I’m tightening the summary into two guarded concrete+simplification defining equations and removing the redundant fold axiom; this also leaves a smaller proof-extension surface for Gate A.
apply patch
