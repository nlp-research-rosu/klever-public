diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..29a01601b0ee3f7077b6d0f60023bc75b11ffa0e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,125 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      While(
+        Compare(Name("i"), CmpOp("<=", Name("n"))),
+        Assign(
+          Name("result"),
+          BinOp(
+            "+",
+            BinOp("+", Name("result"), Str(" ")),
+            Call(Name("str"), Name("i"), .Exprs)))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "string_sequence" |->
+          closureVal(
+            "n", .ParamNames,
+            Expr(Str("Return space-delimited integers from 0 through n, inclusive."))
+            If(
+              Compare(Name("n"), CmpOp("<", Int(0))),
+              Return(Str("")) .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str("0"))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"), CmpOp("<=", Name("n"))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  BinOp("+", Name("result"), Str(" ")),
+                  Call(Name("str"), Name("i"), .Exprs)))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+      1  |-> scope(
+        "n"      |-> N
+        "result" |-> (str(ACC) => str(sequenceAcc(ACC, I, N)))
+        "i"      |-> (I => ?J:Int),
+        parent(0))
+    </scopes>
+    requires I >=Int 1 andBool N >=Int 0
+
+  claim [string-sequence]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "string_sequence",
+            Params("n"),
+            Expr(Str("Return space-delimited integers from 0 through n, inclusive."))
+            If(
+              Compare(Name("n"), CmpOp("<", Int(0))),
+              Return(Str("")) .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str("0"))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"), CmpOp("<=", Name("n"))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  BinOp("+", Name("result"), Str(" ")),
+                  Call(Name("str"), Name("i"), .Exprs)))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("string_sequence"), Int(N), .Exprs)
+      => str(stringSequenceCodes(N))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        =>
+        "string_sequence" |->
+          closureVal(
+            "n", .ParamNames,
+            Expr(Str("Return space-delimited integers from 0 through n, inclusive."))
+            If(
+              Compare(Name("n"), CmpOp("<", Int(0))),
+              Return(Str("")) .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str("0"))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"), CmpOp("<=", Name("n"))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  BinOp("+", Name("result"), Str(" ")),
+                  Call(Name("str"), Name("i"), .Exprs)))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
