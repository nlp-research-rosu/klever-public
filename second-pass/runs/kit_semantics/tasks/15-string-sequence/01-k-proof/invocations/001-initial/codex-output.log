+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp("<=", Name("n"))),
+        Assign(
+          Name("result"),
+          BinOp(
+            "+",
+            BinOp("+", Name("result"), Str(" ")),
+            Call(Name("str"), Name("i"), .Exprs)))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "string_sequence" |->
+          closureVal(
+            "n", .ParamNames,
+            Expr(Str("Return space-delimited integers from 0 through n, inclusive."))
+            If(
+              Compare(Name("n"), CmpOp("<", Int(0))),
+              Return(Str("")) .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str("0"))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"), CmpOp("<=", Name("n"))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  BinOp("+", Name("result"), Str(" ")),
+                  Call(Name("str"), Name("i"), .Exprs)))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+      1  |-> scope(
+        "n"      |-> N
+        "result" |-> (str(ACC) => str(sequenceAcc(ACC, I, N)))
+        "i"      |-> (I => ?J:Int),
+        parent(0))
+    </scopes>
+    requires I >=Int 1 andBool N >=Int 0
+
+  claim [string-sequence]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "string_sequence",
+            Params("n"),
+            Expr(Str("Return space-delimited integers from 0 through n, inclusive."))
+            If(
+              Compare(Name("n"), CmpOp("<", Int(0))),
+              Return(Str("")) .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str("0"))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"), CmpOp("<=", Name("n"))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  BinOp("+", Name("result"), Str(" ")),
+                  Call(Name("str"), Name("i"), .Exprs)))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("string_sequence"), Int(N), .Exprs)
+      => str(stringSequenceCodes(N))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        =>
+        "string_sequence" |->
+          closureVal(
+            "n", .ParamNames,
+            Expr(Str("Return space-delimited integers from 0 through n, inclusive."))
+            If(
+              Compare(Name("n"), CmpOp("<", Int(0))),
+              Return(Str("")) .Stmts,
+              .Stmts)
+            Assign(Name("result"), Str("0"))
+            Assign(Name("i"), Int(1))
+            While(
+              Compare(Name("i"), CmpOp("<=", Name("n"))),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  BinOp("+", Name("result"), Str(" ")),
+                  Call(Name("str"), Name("i"), .Exprs)))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+              .Stmts)
+            Return(Name("result"))
+            .Stmts,
+            0),
