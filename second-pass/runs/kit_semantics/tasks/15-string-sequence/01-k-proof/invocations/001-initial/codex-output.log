+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "string_sequence" |->
+          closureVal(
+            "n", .ParamNames,
+            Expr(Str("Return space-delimited integers from 0 through n, inclusive."))
+            If(
+              Compare(Name("n"), CmpOp("<", Int(0))),
+              Return(Str("")) .Stmts,
