+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // seqSuffix(I, N) is the character-code sequence
+  //   " " + str(I) + ... + " " + str(N)
+  // when I <= N, and the empty sequence otherwise.
+  syntax IntSeq ::= seqSuffix(Int, Int) [function, total]
+
+  rule seqSuffix(I, N) => .IntSeq
+    requires I >Int N
+    [concrete, simplification]
+
+  // This equation gives executable ground evidence while remaining inert on
+  // the symbolic successor in the loop proof.
+  rule seqSuffix(I, N)
+    => seqConcat(
+         iCons(32, strToCodes(Int2String(I))),
+         seqSuffix(I +Int 1, N))
+    requires I <=Int N
+    [concrete, simplification]
+
+  // Associativity follows by induction on A from seqConcat's two equations.
+  rule seqConcat(seqConcat(A, B), C)
+    => seqConcat(A, seqConcat(B, C))
+    [simplification]
+
+  // Complete result for every integer input.  The negative case matches
+  // Python's range(n + 1) convention and makes the source contract total.
+  syntax IntSeq ::= stringSequenceCodes(Int) [function, total]
+
+  rule stringSequenceCodes(N) => .IntSeq
+    requires N <Int 0
+
+  rule stringSequenceCodes(N)
+    => seqConcat(iCons(48, .IntSeq), seqSuffix(1, N))
+    requires N >=Int 0
+endmodule

