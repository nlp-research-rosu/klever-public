diff --git a//tmp/audit-work/stage5-fresh/OperationalAudit.lean b//tmp/audit-work/stage5-fresh/OperationalAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..0260ddc89603e8aee3abafff263b357260c89ce4
--- /dev/null
+++ b//tmp/audit-work/stage5-fresh/OperationalAudit.lean
@@ -0,0 +1,66 @@
+import Proof
+
+namespace OperationalAudit
+
+def codes : SortIntSeq → List Int
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => []
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x xs =>
+      x :: codes xs
+
+def fromCodes : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | x :: xs =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (fromCodes xs)
+
+#eval Proof.«_<=Int_» (-3) (-2)
+#eval Proof.«_<=Int_» 7 7
+#eval Proof.«_<=Int_» 2 (-1)
+#eval Proof.«_+Int_» (-9) 4
+#eval Proof.«Int2String(_)_STRING-COMMON_String_Int» (-120)
+#eval codes (Proof.«strToCodes(_)_MPY-STR_IntSeq_String» "Aé😀")
+#eval codes (
+  Proof.«seqConcat(_,_)_MPY-STR_IntSeq_IntSeq_IntSeq»
+    (fromCodes [1, 2])
+    (fromCodes [3, 4])
+)
+#eval codes (
+  Proof.«sequenceAcc(_,_,_)_VERIFICATION_IntSeq_IntSeq_Int_Int»
+    (fromCodes [88])
+    1
+    3
+)
+#eval codes (
+  Proof.«sequenceAcc(_,_,_)_VERIFICATION_IntSeq_IntSeq_Int_Int»
+    (fromCodes [88])
+    3
+    2
+)
+#eval codes (
+  Proof.«sequenceAcc(_,_,_)_VERIFICATION_IntSeq_IntSeq_Int_Int»
+    (fromCodes [])
+    (-2)
+    0
+)
+
+def witnessLhs : SortIntSeq :=
+  Proof.«sequenceAcc(_,_,_)_VERIFICATION_IntSeq_IntSeq_Int_Int»
+    (Proof.«seqConcat(_,_)_MPY-STR_IntSeq_IntSeq_IntSeq»
+      (Proof.«seqConcat(_,_)_MPY-STR_IntSeq_IntSeq_IntSeq»
+        (fromCodes [88])
+        (fromCodes [32]))
+      (Proof.«strToCodes(_)_MPY-STR_IntSeq_String»
+        (Proof.«Int2String(_)_STRING-COMMON_String_Int» 1)))
+    (Proof.«_+Int_» 1 1)
+    3
+
+def witnessRhs : SortIntSeq :=
+  Proof.«sequenceAcc(_,_,_)_VERIFICATION_IntSeq_IntSeq_Int_Int»
+    (fromCodes [88])
+    1
+    3
+
+#eval codes witnessLhs
+#eval codes witnessRhs
+#eval decide (codes witnessLhs = codes witnessRhs)
+
+end OperationalAudit
diff --git a//tmp/audit-work/trace_paths.c b//tmp/audit-work/trace_paths.c
new file mode 100644
index 0000000000000000000000000000000000000000..4d6747c537ede8587b693961f9a64d91d9ecd776
--- /dev/null
+++ b//tmp/audit-work/trace_paths.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  ssize_t result = real_readlink(path, buf, size);
+  size_t length = strlen(path);
+  if (
+      result < 0
+      && strncmp(path, "/proc/", 6) == 0
+      && length >= 10
+      && strcmp(path + length - 4, "/exe") == 0
+  ) {
+    result = real_readlink("/proc/self/exe", buf, size);
+  }
+  fprintf(stderr, "TRACE readlink(%s) = %zd", path, result);
+  if (result >= 0) {
+    fprintf(stderr, " [%.*s]", (int)result, buf);
+  }
+  fputc('\n', stderr);
+  return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+  static char *(*real_realpath)(const char *, char *);
+  if (!real_realpath) {
+    real_realpath = dlsym(RTLD_NEXT, "realpath");
+  }
+  char *result = real_realpath(path, resolved);
+  fprintf(stderr, "TRACE realpath(%s) = %s\n", path, result ? result : "(null)");
+  return result;
+}
