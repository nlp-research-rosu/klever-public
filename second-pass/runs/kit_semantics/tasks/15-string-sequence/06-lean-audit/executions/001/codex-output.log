diff --git a//tmp/audit-work/trace_paths.c b//tmp/audit-work/trace_paths.c
new file mode 100644
index 0000000000000000000000000000000000000000..4d6747c537ede8587b693961f9a64d91d9ecd776
--- /dev/null
+++ b//tmp/audit-work/trace_paths.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  ssize_t result = real_readlink(path, buf, size);
+  size_t length = strlen(path);
+  if (
+      result < 0
+      && strncmp(path, "/proc/", 6) == 0
+      && length >= 10
+      && strcmp(path + length - 4, "/exe") == 0
+  ) {
+    result = real_readlink("/proc/self/exe", buf, size);
+  }
+  fprintf(stderr, "TRACE readlink(%s) = %zd", path, result);
+  if (result >= 0) {
+    fprintf(stderr, " [%.*s]", (int)result, buf);
+  }
+  fputc('\n', stderr);
+  return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+  static char *(*real_realpath)(const char *, char *);
+  if (!real_realpath) {
+    real_realpath = dlsym(RTLD_NEXT, "realpath");
+  }
+  char *result = real_realpath(path, resolved);
+  fprintf(stderr, "TRACE realpath(%s) = %s\n", path, result ? result : "(null)");
+  return result;
+}
