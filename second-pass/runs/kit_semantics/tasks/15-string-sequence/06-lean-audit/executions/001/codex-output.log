+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[4096];
+  ssize_t count = readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+  if (count < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  buffer[count] = '\0';
+  printf("pid=%d exe=%s\n", getpid(), buffer);
+  return 0;
+}
