+        print(f"relevant line={line_number}: {summary}")
+    if len(matched_records) > 40:
+        print("...")
+        for line_number, summary in matched_records[-40:]:
+            print(f"relevant line={line_number}: {summary}")
+    return 1 if malformed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

