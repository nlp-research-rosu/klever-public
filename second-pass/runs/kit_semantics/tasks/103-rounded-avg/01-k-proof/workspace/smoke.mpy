Module(
  FuncDef("rounded_avg", Params("n", "m"),
    If(Compare(Name("n"), CmpOp(">", Name("m"))),
      Return(UnaryOp("-", Int(1))),
      )
    Assign(
      Name("value"),
      BinOp(
        "+",
        BinOp("//", BinOp("+", Name("n"), Name("m")), Int(2)),
        BinOp(
          "*",
          BinOp("%", BinOp("+", Name("n"), Name("m")), Int(2)),
          BinOp(
            "%",
            BinOp("//", BinOp("+", Name("n"), Name("m")), Int(2)),
            Int(2)))))
    Assign(Name("digits"), Str(""))
    While(Compare(Name("value"), CmpOp(">", Int(1))),
      Assign(
        Name("digits"),
        BinOp(
          "+",
          Call(
            Name("chr"),
            BinOp("+", Int(48), BinOp("%", Name("value"), Int(2)))),
          Name("digits")))
      Assign(Name("value"), BinOp("//", Name("value"), Int(2))))
    Assign(Name("digits"), BinOp("+", Str("1"), Name("digits")))
    Return(BinOp("+", Str("0b"), Name("digits"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(1), Int(5)),
      CmpOp("==", Str("0b11"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(7), Int(5)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(10), Int(20)),
      CmpOp("==", Str("0b1111"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(20), Int(33)),
      CmpOp("==", Str("0b11010"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(1), Int(1)),
      CmpOp("==", Str("0b1"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(2), Int(2)),
      CmpOp("==", Str("0b10")))))
