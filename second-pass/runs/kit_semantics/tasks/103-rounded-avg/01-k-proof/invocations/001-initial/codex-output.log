+def rounded_avg(n, m):
+    if n > m:
+        return -1
+    value = (n + m) // 2 + (n + m) % 2 * ((n + m) // 2 % 2)
+    digits = ""
+    while value > 1:
+        digits = chr(48 + value % 2) + digits
+        value = value // 2
+    digits = "1" + digits
+    return "0b" + digits
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..376cd93214413bbef8dd2cfef7a78ce300f5be44
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,145 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [rounded-avg-invalid]:
+    <k>
+      #loadAll(Module(
+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp("+", Name("n"), Name("m")),
+                Int(2)),
+              BinOp(
+                "*",
+                BinOp(
+                  "%",
+                  BinOp("+", Name("n"), Name("m")),
+                  Int(2)),
+                BinOp(
+                  "%",
+                  BinOp(
+                    "//",
+                    BinOp("+", Name("n"), Name("m")),
+                    Int(2)),
+                  Int(2)))))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(1))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Assign(
+            Name("digits"),
+            BinOp("+", Str("1"), Name("digits")))
+          Return(BinOp("+", Str("0b"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0 andBool M >Int 0 andBool N >Int M
+
+  claim [rounded-avg-valid]:
+    <k>
+      #loadAll(Module(
+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp("+", Name("n"), Name("m")),
+                Int(2)),
+              BinOp(
+                "*",
+                BinOp(
+                  "%",
+                  BinOp("+", Name("n"), Name("m")),
+                  Int(2)),
+                BinOp(
+                  "%",
+                  BinOp(
+                    "//",
+                    BinOp("+", Name("n"), Name("m")),
+                    Int(2)),
+                  Int(2)))))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(1))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Assign(
+            Name("digits"),
+            BinOp("+", Str("1"), Name("digits")))
+          Return(BinOp("+", Str("0b"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      =>
+      str(iCons(
+        48,
+        iCons(98, ?D:IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+    ensures bitValue(?D) ==Int roundedInt(N, M)
+      andBool allBits(?D)
+      andBool startsOne(?D)
+endmodule
diff --git a/verification-base.k b/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..c575c60ca486579a49884f05cf52a7364e248ab6
--- /dev/null
+++ b/verification-base.k
@@ -0,0 +1,50 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  syntax Int ::= roundedInt(Int, Int) [function, total]
+  rule roundedInt(N, M)
+    => (N +Int M -Int pyMod(N +Int M, 2)) /Int 2
+       +Int pyMod(N +Int M, 2)
+            *Int pyMod(
+              (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+              2)
+
+  syntax Int ::= bitWeight(IntSeq) [function, total]
+               | bitValue(IntSeq)  [function, total]
+  rule bitWeight(.IntSeq) => 1
+  rule bitWeight(iCons(_:Int, R:IntSeq)) => 2 *Int bitWeight(R)
+  rule bitValue(.IntSeq) => 0
+  rule bitValue(iCons(C:Int, R:IntSeq))
+    => (C -Int 48) *Int bitWeight(R) +Int bitValue(R)
+
+  syntax Bool ::= allBits(IntSeq)   [function, total]
+                | startsOne(IntSeq) [function, total]
+  rule allBits(.IntSeq) => true
+  rule allBits(iCons(C:Int, R:IntSeq))
+    => (C ==Int 48 orBool C ==Int 49) andBool allBits(R)
+  rule startsOne(iCons(49, _:IntSeq)) => true
+  rule startsOne(_:IntSeq) => false [owise]
+
+  syntax IntSeq ::= loopDigits(Int, IntSeq)
+    [function, total, symbol(loopDigits), no-evaluators]
+  rule loopDigits(V, A) => A
+    requires V ==Int 1
+    [simplification]
+  rule loopDigits(Q, iCons(C, A))
+    => loopDigits(2 *Int Q +Int (C -Int 48), A)
+    requires Q >=Int 1
+      andBool C >=Int 48
+      andBool C <=Int 49
+    [simplification(40)]
+
+  rule 2 *Int ((V -Int pyMod(V, 2)) /Int 2) +Int pyMod(V, 2) => V
+    requires V >=Int 0
+    [simplification]
+  rule 2 *Int ((V -Int ((V %Int 2 +Int 2) %Int 2)) /Int 2)
+       +Int ((V %Int 2 +Int 2) %Int 2)
+    => V
+    requires V >=Int 0
+    [simplification]
+endmodule
