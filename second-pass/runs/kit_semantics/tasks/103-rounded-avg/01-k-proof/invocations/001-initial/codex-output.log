new file mode 100644
index 0000000000000000000000000000000000000000..b2d9954d9b0895e8cece600f16628a909a41346d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def rounded_avg(n, m):
+    if n > m:
+        return -1
+    value = (n + m) // 2 + (n + m) % 2 * ((n + m) // 2 % 2)
+    digits = ""
+    while value > 1:
+        digits = chr(48 + value % 2) + digits
+        value = value // 2
+    digits = "1" + digits
+    return "0b" + digits
