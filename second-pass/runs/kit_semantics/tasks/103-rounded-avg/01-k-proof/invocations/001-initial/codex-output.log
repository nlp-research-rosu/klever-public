+      #while(
+        Compare(Name("value"), CmpOp(">", Int(1))),
+        Assign(
+          Name("digits"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              BinOp("+", Int(48), BinOp("%", Name("value"), Int(2)))),
+            Name("digits")))
+        Assign(Name("value"), BinOp("//", Name("value"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "n" |-> NI:Int
+        "m" |-> MI:Int
+        "value" |-> (V:Int => 1)
+        "digits" |-> (str(A:IntSeq) => str(?D:IntSeq)),
+        parent(0))
+    </scopes>
+    requires V >Int 0
+      andBool allBits(A)
+      andBool notBool ("chr" in_keys(MODULE))
+    ensures bitWeight(?D) +Int bitValue(?D) ==Int
+              (V *Int bitWeight(A) +Int bitValue(A))
+      andBool allBits(?D)
+
+  claim [rounded-avg-invalid]:
+    <k>
+      #loadAll(Module(
+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp("+", Name("n"), Name("m")),
+                Int(2)),
+              BinOp(
+                "*",
+                BinOp(
+                  "%",
+                  BinOp("+", Name("n"), Name("m")),
+                  Int(2)),
+                BinOp(
+                  "%",
+                  BinOp(
+                    "//",
+                    BinOp("+", Name("n"), Name("m")),
+                    Int(2)),
+                  Int(2)))))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(1))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Assign(
+            Name("digits"),
+            BinOp("+", Str("1"), Name("digits")))
+          Return(BinOp("+", Str("0b"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0 andBool M >Int 0 andBool N >Int M
+
+  claim [rounded-avg-valid]:
+    <k>
+      #loadAll(Module(
+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp("+", Name("n"), Name("m")),
+                Int(2)),
+              BinOp(
+                "*",
+                BinOp(
+                  "%",
+                  BinOp("+", Name("n"), Name("m")),
+                  Int(2)),
+                BinOp(
+                  "%",
+                  BinOp(
+                    "//",
+                    BinOp("+", Name("n"), Name("m")),
+                    Int(2)),
+                  Int(2)))))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(1))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Assign(
+            Name("digits"),
+            BinOp("+", Str("1"), Name("digits")))
+          Return(BinOp("+", Str("0b"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      =>
+      str(iCons(
+        48,
+        iCons(98, ?D:IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+    ensures bitValue(?D) ==Int roundedInt(N, M)
+      andBool allBits(?D)
+      andBool startsOne(?D)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..98f291c9b8bbfc988a90e702e7ba245645cab0f7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,33 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact integer expression evaluated by solution.py on the valid branch.
+  syntax Int ::= roundedInt(Int, Int) [function, total]
+  rule roundedInt(N, M)
+    => (N +Int M -Int pyMod(N +Int M, 2)) /Int 2
+       +Int pyMod(N +Int M, 2)
+            *Int pyMod(
+              (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+              2)
+
+  // Positional weight and numeric value of an ASCII binary digit sequence.
+  syntax Int ::= bitWeight(IntSeq) [function, total]
+               | bitValue(IntSeq)  [function, total]
+  rule bitWeight(.IntSeq) => 1
+  rule bitWeight(iCons(_:Int, R:IntSeq)) => 2 *Int bitWeight(R)
+  rule bitValue(.IntSeq) => 0
+  rule bitValue(iCons(C:Int, R:IntSeq))
+    => (C -Int 48) *Int bitWeight(R) +Int bitValue(R)
+
+  // Canonical binary digits contain only ASCII 0/1 and have leading digit 1.
+  syntax Bool ::= allBits(IntSeq)   [function, total]
+                | startsOne(IntSeq) [function, total]
+  rule allBits(.IntSeq) => true
+  rule allBits(iCons(C:Int, R:IntSeq))
+    => (C ==Int 48 orBool C ==Int 49) andBool allBits(R)
+  rule startsOne(iCons(49, _:IntSeq)) => true
+  rule startsOne(_:IntSeq) => false [owise]
+
+endmodule

exec
/bin/bash -lc "python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy
python3 - <<'PY'
from solution import rounded_avg
examples = [(1, 5, '0b11'), (7, 5, -1), (10, 20, '0b1111'), (20, 33, '0b11010')]
for n, m, expected in examples:
    assert rounded_avg(n, m) == expected
for n in range(1, 101):
    for m in range(1, 101):
        expected = -1 if n > m else bin(round(sum(range(n, m + 1)) / len(range(n, m + 1))))
        assert rounded_avg(n, m) == expected, (n, m)
print('CPython examples: 4/4; differential grid: 10000/10000')
PY
krun smoke.mpy --definition runtime-kompiled | rg -n '<k>|\\.K|<exc>|NoExc|<exit-code>|>0<'" in /workspace
