+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Assign(
+            Name("digits"),
+            BinOp("+", Str("1"), Name("digits")))
+          Return(BinOp("+", Str("0c"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      =>
+      str(iCons(
+        48,
+        iCons(98, ?D:IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+    ensures bitValue(?D) ==Int roundedInt(N, M)
+      andBool allBits(?D)
+      andBool startsOne(?D)
+endmodule
