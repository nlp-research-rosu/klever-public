+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp("+", Name("n"), Name("m")),
+                Int(2)),
+              BinOp(
+                "*",
+                BinOp(
+                  "%",
+                  BinOp("+", Name("n"), Name("m")),
+                  Int(2)),
+                BinOp(
+                  "%",
+                  BinOp(
+                    "//",
+                    BinOp("+", Name("n"), Name("m")),
+                    Int(2)),
+                  Int(2)))))
+          Assign(Name("digits"), Str(""))
+          While(
