+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [binary-loop]:
+    <k>
+      #while(
+        Compare(Name("value"), CmpOp(">", Int(0))),
+        Assign(
+          Name("digits"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              BinOp("+", Int(48), BinOp("%", Name("value"), Int(2)))),
+            Name("digits")))
+        Assign(Name("value"), BinOp("//", Name("value"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "n" |-> NI:Int
+        "m" |-> MI:Int
+        "value" |-> (V:Int => 0)
+        "digits" |-> (str(A:IntSeq) => str(binaryAcc(V, A))),
+        parent(0))
+    </scopes>
+    requires V >=Int 0
+
+  claim [rounded-avg-invalid]:
+    <k>
+      #loadAll(Module(
+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "//",
+              BinOp(
+                "+",
+                BinOp("+", Name("n"), Name("m")),
+                BinOp(
+                  "%",
+                  BinOp("//", BinOp("+", Name("n"), Name("m")), Int(2)),
+                  Int(2))),
+              Int(2)))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Return(BinOp("+", Str("0b"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0 andBool M >Int 0 andBool N >Int M
+
+  claim [rounded-avg-valid]:
+    <k>
+      #loadAll(Module(
+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "//",
+              BinOp(
+                "+",
+                BinOp("+", Name("n"), Name("m")),
+                BinOp(
+                  "%",
+                  BinOp("//", BinOp("+", Name("n"), Name("m")), Int(2)),
+                  Int(2))),
+              Int(2)))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Return(BinOp("+", Str("0b"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      =>
+      str(iCons(
+        48,
+        iCons(98, binaryAcc(roundedInt(N, M), .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
