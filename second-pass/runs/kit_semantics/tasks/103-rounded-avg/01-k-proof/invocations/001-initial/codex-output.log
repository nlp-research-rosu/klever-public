diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1c766bfb31e1962103be17513ace62fa47bd258
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact integer expression evaluated by solution.py on the valid branch.
+  syntax Int ::= roundedInt(Int, Int) [function, total]
+  rule roundedInt(N, M)
+    => ((N +Int M
+          +Int pyMod(
+            (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+            2)
+         -Int pyMod(
+           N +Int M
+           +Int pyMod(
+             (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+             2),
+           2))
+        /Int 2)
+
+  // A value has exactly the representation produced by the fixed bin rules.
+  // The outer match folds before binCodes is unfolded on a symbolic integer.
+  syntax Bool ::= isBinResult(Int, Val) [function]
+  rule isBinResult(N, str(iCons(48, iCons(98, binCodes(N))))) => true
+endmodule

