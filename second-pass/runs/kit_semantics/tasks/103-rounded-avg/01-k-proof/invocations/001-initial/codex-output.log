diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..35a382c3ef6dd7230461cc53ccd918308cd2c6fe
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,15 @@
+def rounded_avg(n, m):
+    if n > m:
+        return -1
+    value = (n + m + ((n + m) // 2) % 2) // 2
+    digits = ""
+    while value > 0:
+        digits = chr(48 + value % 2) + digits
+        value = value // 2
+    return "0b" + digits
+
+
+assert rounded_avg(1, 5) == "0b11"
+assert rounded_avg(7, 5) == -1
+assert rounded_avg(10, 20) == "0b1111"
+assert rounded_avg(20, 33) == "0b11010"
