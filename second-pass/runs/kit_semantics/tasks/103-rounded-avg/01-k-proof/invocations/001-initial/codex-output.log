new file mode 100644
index 0000000000000000000000000000000000000000..273478f0f91f2a5433d9946a082f3c461a1fc889
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact integer expression evaluated by solution.py on the valid branch.
+  syntax Int ::= roundedInt(Int, Int) [function, total]
+  rule roundedInt(N, M)
+    => ((N +Int M
+          +Int pyMod(
+            (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+            2)
+         -Int pyMod(
+           N +Int M
+           +Int pyMod(
+             (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+             2),
+           2))
+        /Int 2)
+
+  // binaryAcc(N, A) is the binary digit-code sequence for positive N,
+  // followed by the already-built suffix A.  It stays opaque on symbolic N;
+  // the equalities below are its complete base/step definition on N >= 0.
+  syntax IntSeq ::= binaryAcc(Int, IntSeq)
+    [function, total, symbol(binaryAcc), no-evaluators]
+
+  rule binaryAcc(0, A) => A [simplification]
+
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..35a382c3ef6dd7230461cc53ccd918308cd2c6fe
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,15 @@
+def rounded_avg(n, m):
+    if n > m:
+        return -1
+    value = (n + m + ((n + m) // 2) % 2) // 2
+    digits = ""
+    while value > 0:
+        digits = chr(48 + value % 2) + digits
+        value = value // 2
+    return "0b" + digits
+
+
+assert rounded_avg(1, 5) == "0b11"
+assert rounded_avg(7, 5) == -1
+assert rounded_avg(10, 20) == "0b1111"
+assert rounded_avg(20, 33) == "0b11010"
