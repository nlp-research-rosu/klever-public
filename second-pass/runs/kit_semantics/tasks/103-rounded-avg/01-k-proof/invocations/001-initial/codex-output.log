+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp("+", Name("n"), Name("m")),
+                Int(2)),
+              BinOp(
+                "*",
+                BinOp(
+                  "%",
+                  BinOp("+", Name("n"), Name("m")),
+                  Int(2)),
+                BinOp(
+                  "%",
+                  BinOp(
+                    "//",
+                    BinOp("+", Name("n"), Name("m")),
+                    Int(2)),
+                  Int(2)))))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(1))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
