index 0000000000000000000000000000000000000000..aa67424108c308bacd48615101a5a3fb84d5b99c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def rounded_avg(n, m):
+    if n > m:
+        return -1
+    value = (n + m + ((n + m) // 2) % 2) // 2
+    digits = ""
+    while value > 0:
+        digits = chr(48 + value % 2) + digits
+        value = value // 2
+    return "0b" + digits
