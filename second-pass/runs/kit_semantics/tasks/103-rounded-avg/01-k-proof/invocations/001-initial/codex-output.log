+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures bitValue(?D) ==Int roundedInt(1, 1)
+      andBool allBits(?D)
+      andBool startsOne(?D)
+endmodule
