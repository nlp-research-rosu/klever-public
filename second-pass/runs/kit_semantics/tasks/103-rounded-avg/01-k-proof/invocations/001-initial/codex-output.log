+def rounded_avg(n, m):
+    if n > m:
+        return -1
+    value = (n + m) // 2 + (n + m) % 2 * ((n + m) // 2 % 2)
+    digits = ""
+    while value > 1:
+        digits = chr(48 + value % 2) + digits
+        value = value // 2
+    digits = "1" + digits
+    return "0b" + digits
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..324c0ecf1b705f02f8fa67c1d292873ebbcdc653
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,250 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [binary-loop]:
+    <k>
+      #while(
+        Compare(Name("value"), CmpOp(">", Int(1))),
+        Assign(
+          Name("digits"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              BinOp("+", Int(48), BinOp("%", Name("value"), Int(2)))),
+            Name("digits")))
+        Assign(Name("value"), BinOp("//", Name("value"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "n" |-> NI:Int
+        "m" |-> MI:Int
+        "value" |-> (V:Int => 1)
+        "digits" |-> (str(A:IntSeq) => str(?D:IntSeq)),
+        parent(0))
+    </scopes>
+    requires V >Int 0
+      andBool allBits(A)
+      andBool notBool ("chr" in_keys(MODULE))
+    ensures bitWeight(?D) +Int bitValue(?D) ==Int
+              (V *Int bitWeight(A) +Int bitValue(A))
+      andBool allBits(?D)
+
+  claim [binary-loop-exact]:
+    <k>
+      #while(
+        Compare(Name("value"), CmpOp(">", Int(1))),
+        Assign(
+          Name("digits"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              BinOp("+", Int(48), BinOp("%", Name("value"), Int(2)))),
+            Name("digits")))
+        Assign(Name("value"), BinOp("//", Name("value"), Int(2))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "n" |-> NI:Int
+        "m" |-> MI:Int
+        "value" |-> (V:Int => 1)
+        "digits" |-> (str(A:IntSeq) => str(loopDigits(V, A))),
+        parent(0))
+    </scopes>
+    requires V >Int 0
+      andBool allBits(A)
+      andBool notBool ("chr" in_keys(MODULE))
+    ensures bitWeight(loopDigits(V, A))
+              +Int bitValue(loopDigits(V, A))
+            ==Int V *Int bitWeight(A) +Int bitValue(A)
+      andBool allBits(loopDigits(V, A))
+
+  claim [binary-core]:
+    <k>
+      While(
+        Compare(Name("value"), CmpOp(">", Int(1))),
+        Assign(
+          Name("digits"),
+          BinOp(
+            "+",
+            Call(
+              Name("chr"),
+              BinOp("+", Int(48), BinOp("%", Name("value"), Int(2)))),
+            Name("digits")))
+        Assign(Name("value"), BinOp("//", Name("value"), Int(2))))
+      ~> Assign(
+        Name("digits"),
+        BinOp("+", Str("1"), Name("digits")))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "n" |-> NI:Int
+        "m" |-> MI:Int
+        "value" |-> (V:Int => 1)
+        "digits" |-> (str(.IntSeq) => str(?D:IntSeq)),
+        parent(0))
+    </scopes>
+    requires V >Int 0
+      andBool notBool ("chr" in_keys(MODULE))
+    ensures bitValue(?D) ==Int V
+      andBool allBits(?D)
+      andBool startsOne(?D)
+
+  claim [rounded-avg-invalid]:
+    <k>
+      #loadAll(Module(
+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp("+", Name("n"), Name("m")),
+                Int(2)),
+              BinOp(
+                "*",
+                BinOp(
+                  "%",
+                  BinOp("+", Name("n"), Name("m")),
+                  Int(2)),
+                BinOp(
+                  "%",
+                  BinOp(
+                    "//",
+                    BinOp("+", Name("n"), Name("m")),
+                    Int(2)),
+                  Int(2)))))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(1))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Assign(
+            Name("digits"),
+            BinOp("+", Str("1"), Name("digits")))
+          Return(BinOp("+", Str("0b"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0 andBool M >Int 0 andBool N >Int M
+
+  claim [rounded-avg-valid]:
+    <k>
+      #loadAll(Module(
+        FuncDef("rounded_avg", Params("n", "m"),
+          If(Compare(Name("n"), CmpOp(">", Name("m"))),
+            Return(UnaryOp("-", Int(1))),
+            .Stmts)
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp("+", Name("n"), Name("m")),
+                Int(2)),
+              BinOp(
+                "*",
+                BinOp(
+                  "%",
+                  BinOp("+", Name("n"), Name("m")),
+                  Int(2)),
+                BinOp(
+                  "%",
+                  BinOp(
+                    "//",
+                    BinOp("+", Name("n"), Name("m")),
+                    Int(2)),
+                  Int(2)))))
+          Assign(Name("digits"), Str(""))
+          While(
+            Compare(Name("value"), CmpOp(">", Int(1))),
+            Assign(
+              Name("digits"),
+              BinOp(
+                "+",
+                Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    Int(48),
+                    BinOp("%", Name("value"), Int(2)))),
+                Name("digits")))
+            Assign(
+              Name("value"),
+              BinOp("//", Name("value"), Int(2))))
+          Assign(
+            Name("digits"),
+            BinOp("+", Str("1"), Name("digits")))
+          Return(BinOp("+", Str("0b"), Name("digits"))))))
+      ~> Call(Name("rounded_avg"), Int(N), Int(M))
+      =>
+      str(iCons(
+        48,
+        iCons(98, ?D:IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+    ensures bitValue(?D) ==Int roundedInt(N, M)
+      andBool allBits(?D)
+      andBool startsOne(?D)
+endmodule
