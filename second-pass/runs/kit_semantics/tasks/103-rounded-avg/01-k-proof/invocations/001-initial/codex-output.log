@@ -0,0 +1,38 @@
+requires "verification-base.k"
+
+module ROUNDING-SPEC
+  imports VERIFICATION-BASE
+
+  claim [rounded-even-sum]:
+    <k>
+      roundedInt(N, M)
+      =>
+      (N +Int M -Int pyMod(N +Int M, 2)) /Int 2
+    </k>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+      andBool pyMod(N +Int M, 2) ==Int 0
+
+  claim [rounded-odd-even-quotient]:
+    <k>
+      roundedInt(N, M)
+      =>
+      (N +Int M -Int pyMod(N +Int M, 2)) /Int 2
+    </k>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+      andBool pyMod(N +Int M, 2) ==Int 1
+      andBool pyMod(
+        (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+        2) ==Int 0
+
+  claim [rounded-odd-odd-quotient]:
+    <k>
+      roundedInt(N, M)
+      =>
+      (N +Int M -Int pyMod(N +Int M, 2)) /Int 2 +Int 1
+    </k>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+      andBool pyMod(N +Int M, 2) ==Int 1
+      andBool pyMod(
+        (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+        2) ==Int 1
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..d539378b24aa6b6a9273e7292602b61dfb0457ee
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def rounded_avg(n, m):
+    if n > m:
+        return -1
+    value = (n + m) // 2 + (n + m) % 2 * ((n + m) // 2 % 2)
+    digits = ""
+    while value > 1:
+        digits = chr(48 + value % 2) + digits
+        value = value // 2
+    digits = "1" + digits
+    return "0b" + digits
+
+
+assert rounded_avg(1, 5) == "0b11"
+assert rounded_avg(7, 5) == -1
+assert rounded_avg(10, 20) == "0b1111"
+assert rounded_avg(20, 33) == "0b11010"
