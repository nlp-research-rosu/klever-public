tail -n 6 /tmp/spec-body-mutation-final.log
printf '%s\\n' 'Loop-connection mutation probe tail:'
tail -n 6 /tmp/connection-body-mutation-final.log
if [ \""'$vacuity_status" -eq 0 ] || [ "$body_status" -eq 0 ] || [ "$connection_status" -eq 0 ]; then exit 1; fi
