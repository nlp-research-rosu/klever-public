@@ -0,0 +1,47 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact integer expression evaluated by solution.py on the valid branch.
+  syntax Int ::= roundedInt(Int, Int) [function, total]
+  rule roundedInt(N, M)
+    => ((N +Int M
+          +Int pyMod(
+            (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+            2)
+         -Int pyMod(
+           N +Int M
+           +Int pyMod(
+             (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
+             2),
+           2))
+        /Int 2)
+
+  // binaryAcc(N, A) is the binary digit-code sequence for positive N,
+  // followed by the already-built suffix A.  It stays opaque on symbolic N;
+  // the equalities below are its complete base/step definition on N >= 0.
+  syntax IntSeq ::= binaryAcc(Int, IntSeq)
+    [function, total, symbol(binaryAcc), no-evaluators]
+
+  rule binaryAcc(0, A) ==K A => true [simplification]
+  rule A ==K binaryAcc(0, A) => true [simplification]
+
+  rule binaryAcc(N, A)
+       ==K
+       binaryAcc(
+         (N -Int pyMod(N, 2)) /Int 2,
+         iCons(48 +Int pyMod(N, 2), A))
+    => true
+    requires N >Int 0
+    [simplification]
+
+  rule binaryAcc(
+         (N -Int pyMod(N, 2)) /Int 2,
+         iCons(48 +Int pyMod(N, 2), A))
+       ==K
+       binaryAcc(N, A)
+    => true
+    requires N >Int 0
+    [simplification]
+endmodule

