   151	/-
   152	The `List` sort is an ordered collection that may contain duplicate elements.
   153	 -/
   154	
   155	structure listHookSig (T : Type) where
   156	  unit      : List T
   157	  concat    : List T → List T → Option (List T)
   158	  element   : T → List T
   159	  push      : T → List T → List T
   160	  get       : Int → List T → Option T
   161	  updte     : Int → T → List T → Option (List T)
   162	  -- create a List T with `length` elements, each containing  `value`. `Option` return type from `Int` parameter
   163	  make      : Int → T → Option (List T)
   164	  -- create a new `List T` which is equal to `dest` except the  `N` elements starting at `index` are replaced with the   contents of `src`
   165	  -- Having `index + size(src) > size(dest)` is undefined
   166	  -- updateList(dest: List T, index: Int, src: List T)
   167	  updateAll : List T → Int → List T → Option (List T)
   168	  -- create a new `List T` where the `length` elements starting   at `index` are replaced with `value`
   169	  fill      : List T → Int → T → Option (List T)
   170	  -- compute a new `List T` by removing `fromFront` elements from   the front of the list and `fromBack` elements from the back   of the List T
   171	  -- range(List T, fromFront: Int, fromBack: Int)
   172	  range     : List T → Int → Int → Option (List T)
   173	  -- compute whether an element is in a List T
   174	  -- the hook is `in`, but clashes with Lean syntax
   175	  inList    : T → List T → Bool
   176	  size      : List T → Int
   177	  -- split list into prefix, middle and postfix, given prefix and postfix length
   178	  split     : List T → Nat → Nat → Option (List T × List T × List T)
   179	
   180	namespace ListHookDef
   181	  variable (T : Type)
   182	  axiom unitAx      : List T
   183	  axiom concatAx    : List T → List T → Option (List T)
   184	  axiom elementAx   : T → List T
   185	  axiom pushAx      : T → List T → List T
   186	  axiom getAx       : Int → List T → Option T
   187	  axiom updteAx     : Int → T → List T → Option (List T)
   188	  axiom makeAx      : Int → T → Option (List T)
   189	  axiom updateAllAx : List T → Int → List T → Option (List T)
   190	  axiom fillAx      : List T → Int → T → Option (List T)
   191	  axiom rangeAx     : List T → Int → Int → Option (List T)
   192	  axiom inListAx    : T → List T → Bool
   193	  axiom sizeAx      : List T → Int
   194	  axiom splitAx     : List T → Nat → Nat → Option (List T × List T × List T)
   195	end ListHookDef
   196	
   197	noncomputable def ListHook (T : Type) : listHookSig T :=
   198	  { unit      := ListHookDef.unitAx T,
   199	    concat    := ListHookDef.concatAx T,
   200	    element   := ListHookDef.elementAx T,
   201	    push      := ListHookDef.pushAx T,
   202	    get       := ListHookDef.getAx T,
   203	    updte     := ListHookDef.updteAx T,
   204	    make      := ListHookDef.makeAx T,
   205	    updateAll := ListHookDef.updateAllAx T,
   206	    fill      := ListHookDef.fillAx T,
   207	    range     := ListHookDef.rangeAx T,
   208	    inList    := ListHookDef.inListAx T,
   209	    size      := ListHookDef.sizeAx T,
   210	    split     := ListHookDef.splitAx T }
