--- /workspace/Base/Klean103RoundedAvg/Lemmas.lean
     1	import Klean103RoundedAvg.Inj
     2	
     3	/- K trust-boundary goals. The second-pass agent must replace every
     4	   writable opaque stub with an honest definition and prove this
     5	   immutable proposition in the separate Proof.lean workspace. -/
     6	
     7	namespace Klean103RoundedAvg.Lemmas
     8	
     9	def targetStatement
    10	    (_andBool_ : SortBool → SortBool → SortBool)
    11	    («_>Int_» : SortInt → SortInt → SortBool)
    12	    («_+Int_» : SortInt → SortInt → SortInt)
    13	    («_*Int_» : SortInt → SortInt → SortInt)
    14	    («allBits(_)_VERIFICATION-BASE_Bool_IntSeq» : SortIntSeq → SortBool)
    15	    («bitValue(_)_VERIFICATION-BASE_Int_IntSeq» : SortIntSeq → SortInt)
    16	    («bitWeight(_)_VERIFICATION-BASE_Int_IntSeq» : SortIntSeq → SortInt)
    17	    (loopDigits : SortInt → SortIntSeq → SortIntSeq)
    18	    : Prop :=
    19	    (∀ (A : SortIntSeq) (V : SortInt) (h : (_andBool_ («_>Int_» V 0) («allBits(_)_VERIFICATION-BASE_Bool_IntSeq» A)) = true), («_+Int_» («bitWeight(_)_VERIFICATION-BASE_Int_IntSeq» (loopDigits V A)) («bitValue(_)_VERIFICATION-BASE_Int_IntSeq» (loopDigits V A)) : SortInt) = («_+Int_» («_*Int_» V («bitWeight(_)_VERIFICATION-BASE_Int_IntSeq» A)) («bitValue(_)_VERIFICATION-BASE_Int_IntSeq» A) : SortInt))
    20	    ∧ (∀ (A : SortIntSeq) (V : SortInt) (h : (_andBool_ («_>Int_» V 0) («allBits(_)_VERIFICATION-BASE_Bool_IntSeq» A)) = true), («_+Int_» («_*Int_» 1 («bitWeight(_)_VERIFICATION-BASE_Int_IntSeq» (loopDigits V A))) («bitValue(_)_VERIFICATION-BASE_Int_IntSeq» (loopDigits V A)) : SortInt) = («_+Int_» («_*Int_» V («bitWeight(_)_VERIFICATION-BASE_Int_IntSeq» A)) («bitValue(_)_VERIFICATION-BASE_Int_IntSeq» A) : SortInt))
    21	    ∧ (∀ (A : SortIntSeq) (V : SortInt) (h : (_andBool_ («_>Int_» V 0) («allBits(_)_VERIFICATION-BASE_Bool_IntSeq» A)) = true), («allBits(_)_VERIFICATION-BASE_Bool_IntSeq» (loopDigits V A) : SortBool) = (true : SortBool))
    22	
    23	end Klean103RoundedAvg.Lemmas
--- /workspace/Base/Klean103RoundedAvg/Prelude.lean
     1	/-
     2	K Prelude in Lean 4
     3	
     4	Functions with the `hook` attribute need to have a manual implementation in the backends.
     5	This file contains the Lean 4 definitions of the hooked functions in `domains.md`.
     6	
     7	Currently we translate hooked functions as uninterpreted functions together with axioms asserting their behavior.
     8	The current definition can be put into three levels:
     9	
    10	1. Signature Level:
    11	The signature of the hooks, this includes aliases for Sorts and function symbols for hooked functions.
    12	
    13	2. Rule Level:
    14	The behavior of the uninterpreted symbols can be asserted through axioms or theorems.
    15	Inconsistencies can arise from them, so it falls under the user to make sure axioms are consistent and/or theorems provable.
    16	
    17	3. Simplification Level:
    18	With the theory defined through function rules, simplifications can be stated as theorems.
    19	These theorems should be provable directly from the function rules and the semantics of the Sorts.
    20	 -/
    21	
    22	-- Basic K types
    23	abbrev SortBool         : Type := Bool
    24	abbrev SortBytes        : Type := ByteArray
    25	abbrev SortId           : Type := String
    26	abbrev SortFloat        : Type := Float
    27	abbrev SortInt          : Type := Int
    28	abbrev SortString       : Type := String
    29	abbrev SortStringBuffer : Type := String
    30	
    31	/-
    32	The `Map` sort represents a generalized associative array.
    33	Each key can be paired with an arbitrary value, and can be used to reference its associated value.
    34	Multiple bindings for the same key are not allowed.
    35	Note that both keys and values will always be KItems.
    36	 -/
    37	
    38	-- Signature to be instantiated by map implementations
    39	structure MapHookSig (K V : Type) where
    40	  unit       : List (K × V)
    41	  cons       : K → V → List (K × V) → List (K × V)
    42	  lookup     : List (K × V) → K → Option V
    43	  lookup?    : List (K × V) → K → V -- lookup with default
    44	  update     : K → V → List (K × V) → List (K × V)
    45	  delete     : List (K × V) → K → List (K × V)
    46	  concat     : List (K × V) → List (K × V) → Option (List (K × V))
    47	  difference : List (K × V) → List (K × V) → List (K × V)
    48	  updateMap  : List (K × V) → List (K × V) → List (K × V)
    49	  removeAll  : List (K × V) → List K → List (K × V)
    50	  keys       : List (K × V) → List K
    51	  in_keys    : List (K × V) → K → Bool
    52	  values     : List (K × V) → List V
    53	  size       : List (K × V) → Nat
    54	  includes   : List (K × V) → List (K × V) → Bool -- List (K × V) inclusion
    55	  choice     : List (K × V) → K -- arbitrary key from a List (K × V)
    56	  -- nodup is not satisfiable in the current implementation with `List (K × V)`
    57	  -- nodup      : forall al : List (K × V), List.Nodup (keys al)
    58	  split      : List (K × V) → List K → Option (List V × List (K × V))
    59	
    60	-- We use axioms to have uninterpreted functions
    61	namespace MapHookDef
    62	  variable (K V : Type)
    63	  axiom unitAx       : List (K × V)
    64	  axiom consAx       : K → V → List (K × V) → List (K × V)
    65	  axiom lookupAx     : List (K × V) → K → Option V
    66	  axiom lookupAx?    : List (K × V) → K → V -- lookup with default
    67	  axiom updateAx     : K → V → List (K × V) → List (K × V)
    68	  axiom deleteAx     : List (K × V) → K → List (K × V)
    69	  axiom concatAx     : List (K × V) → List (K × V) → Option (List (K × V))
    70	  axiom differenceAx : List (K × V) → List (K × V) → List (K × V)
    71	  axiom updateMapAx  : List (K × V) → List (K × V) → List (K × V)
    72	  axiom removeAllAx  : List (K × V) → List K → List (K × V)
    73	  axiom keysAx       : List (K × V) → List K
