diff --git a//tmp/lean-proc-shim.c b//tmp/lean-proc-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..a1b6fac99a2be45fd6eeae537f710743a2b74a83
--- /dev/null
+++ b//tmp/lean-proc-shim.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  size_t length = strlen(path);
+  if (length >= 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}
