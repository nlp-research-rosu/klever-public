--- /workspace/Base/Klean103RoundedAvg/Func.lean
     1	import Klean103RoundedAvg.Inj
     2	
     3	noncomputable local instance : DecidableEq SortKItem :=
     4	  Classical.typeDecidableEq SortKItem
     5	
     6	private noncomputable def kleanMapLookupModel
     7	    (entries : List (SortKItem × SortKItem))
     8	    (key : SortKItem) : Option SortKItem :=
     9	  match entries with
    10	  | [] => none
    11	  | (candidate, value) :: rest =>
    12	      if candidate = key then some value
    13	      else kleanMapLookupModel rest key
    14	
    15	private noncomputable def kleanMapContainsModel
    16	    (entries : List (SortKItem × SortKItem))
    17	    (key : SortKItem) : Bool :=
    18	  match entries with
    19	  | [] => false
    20	  | (candidate, _) :: rest =>
    21	      if candidate = key then true
    22	      else kleanMapContainsModel rest key
    23	
    24	private noncomputable def kleanMapDisjointModel
    25	    (left right : List (SortKItem × SortKItem)) : Bool :=
    26	  match right with
    27	  | [] => true
    28	  | (key, _) :: rest =>
    29	      if kleanMapContainsModel left key then false
    30	      else kleanMapDisjointModel left rest
    31	
    32	private noncomputable def kleanMapDeleteModel
    33	    (entries : List (SortKItem × SortKItem))
    34	    (key : SortKItem) : List (SortKItem × SortKItem) :=
    35	  match entries with
    36	  | [] => []
    37	  | (candidate, value) :: rest =>
    38	      if candidate = key then kleanMapDeleteModel rest key
    39	      else (candidate, value) :: kleanMapDeleteModel rest key
    40	
    41	private noncomputable def kleanMapUpdateModel
    42	    (entries : List (SortKItem × SortKItem))
    43	    (key value : SortKItem) : List (SortKItem × SortKItem) :=
    44	  match entries with
    45	  | [] => [(key, value)]
    46	  | (candidate, oldValue) :: rest =>
    47	      if candidate = key then (key, value) :: rest
    48	      else (candidate, oldValue) :: kleanMapUpdateModel rest key value
    49	
    50	noncomputable def «.List» : Option SortList := some ⟨[]⟩
    51	
    52	noncomputable def «.Map» : Option SortMap := some ⟨[]⟩
    53	
    54	noncomputable def _List_ (x0 : SortList) (x1 : SortList) : Option SortList := some ⟨x0.coll ++ x1.coll⟩
    55	
    56	noncomputable def _Map_ (x0 : SortMap) (x1 : SortMap) : Option SortMap :=
    57	  if kleanMapDisjointModel x0.coll x1.coll then
    58	    some ⟨x0.coll ++ x1.coll⟩
    59	  else none
    60	
    61	noncomputable def «_|->_» (x0 : SortKItem) (x1 : SortKItem) : Option SortMap :=
    62	  some ⟨[(x0, x1)]⟩
    63	
    64	noncomputable def ListItem (x0 : SortKItem) : Option SortList :=
    65	  some ⟨[x0]⟩
