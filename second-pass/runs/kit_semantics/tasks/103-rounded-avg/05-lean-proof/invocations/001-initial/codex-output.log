   104	/-
   105	Implementation of immutable, associative, commutative sets of `KItem`.
   106	The sets are nilpotent, i.e., the concatenation of two sets containing elements in common is `#False` (note however, this may be silently allowed during concrete execution).
   107	If you intend to add an element to a set that might already be present in the set, use the `|Set` operator instead.
   108	 -/
   109	
   110	structure SetHookSig (T : Type) where
   111	  unit         : List T
   112	  concat       : List T → List T → Option (List T)
   113	  element      : T → List T
   114	  union        : List T → List T → List T
   115	  intersection : List T → List T → List T
   116	  difference   : List T → List T → List T
   117	  inSet        : T → List T → Bool
   118	  inclusion    : List T → List T → Bool
   119	  size         : List T → Int
   120	  choice       : List T → T
   121	  split        : List T → List T → Option (List T)
   122	
   123	namespace SetHookDef
   124	  variable (T : Type)
   125	  axiom unitAx         : List T
   126	  axiom concatAx       : List T → List T → Option (List T)
   127	  axiom elementAx      : T → List T
   128	  axiom unionAx        : List T → List T → List T
   129	  axiom intersectionAx : List T → List T → List T
   130	  axiom differenceAx   : List T → List T → List T
   131	  axiom inSetAx        : T → List T → Bool
   132	  axiom inclusionAx    : List T → List T → Bool
   133	  axiom sizeAx         : List T → Int
   134	  axiom choiceAx       : List T → T
   135	  axiom splitAx        : List T → List T → Option (List T)
   136	end SetHookDef
   137	
   138	noncomputable def SetHook (T : Type) : SetHookSig T :=
   139	  { unit         := SetHookDef.unitAx T,
   140	    concat       := SetHookDef.concatAx T,
   141	    element      := SetHookDef.elementAx T,
   142	    union        := SetHookDef.unionAx T,
   143	    intersection := SetHookDef.intersectionAx T,
   144	    difference   := SetHookDef.differenceAx T,
   145	    inSet        := SetHookDef.inSetAx T,
   146	    inclusion    := SetHookDef.inclusionAx T,
   147	    size         := SetHookDef.sizeAx T,
   148	    choice       := SetHookDef.choiceAx T,
