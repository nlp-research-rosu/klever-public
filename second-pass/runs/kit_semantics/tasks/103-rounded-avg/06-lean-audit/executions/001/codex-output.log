new file mode 100644
index 0000000000000000000000000000000000000000..28b28fdcd300c1dc2894f178730d8b313dbd571f
--- /dev/null
+++ b//tmp/audit-work/rounded-avg-proof-audit/AuditAdversarial.lean
@@ -0,0 +1,83 @@
+import Proof
+
+namespace AuditAdversarial
+
+open Proof
+
+def empty : SortIntSeq :=
+  .«.IntSeq_MPY-CORE_IntSeq»
+
+def cons (head : Int) (tail : SortIntSeq) : SortIntSeq :=
+  .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail
+
+def codes : SortIntSeq → List Int
+  | .«.IntSeq_MPY-CORE_IntSeq» => []
+  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail =>
+      head :: codes tail
+
+def acc10 : SortIntSeq := cons 49 (cons 48 empty)
+
+#eval Proof._andBool_ true false
+#eval Proof.«_>Int_» (-3) (-4)
+#eval Proof.«_+Int_» (-2) 5
+#eval Proof.«_*Int_» (-3) 4
+#eval codes (Proof.loopDigits (-3) acc10)
+#eval codes (Proof.loopDigits 0 acc10)
+#eval codes (Proof.loopDigits 1 acc10)
+#eval codes (Proof.loopDigits 2 empty)
+#eval codes (Proof.loopDigits 3 empty)
+#eval codes (Proof.loopDigits 4 empty)
+#eval codes (Proof.loopDigits 5 acc10)
+#eval «bitWeight(_)_VERIFICATION-BASE_Int_IntSeq» acc10
+#eval «bitValue(_)_VERIFICATION-BASE_Int_IntSeq» acc10
+#eval «allBits(_)_VERIFICATION-BASE_Bool_IntSeq» acc10
+#eval «allBits(_)_VERIFICATION-BASE_Bool_IntSeq» (cons 50 empty)
+
+example :
+    Proof._andBool_
+        (Proof.«_>Int_» 2 0)
+        («allBits(_)_VERIFICATION-BASE_Bool_IntSeq» empty) = true := by
+  native_decide
+
+example :
+    Proof.«_+Int_»
+        («bitWeight(_)_VERIFICATION-BASE_Int_IntSeq» (Proof.loopDigits 2 empty))
+        («bitValue(_)_VERIFICATION-BASE_Int_IntSeq» (Proof.loopDigits 2 empty)) =
+      Proof.«_+Int_»
+        (Proof.«_*Int_» 2
+          («bitWeight(_)_VERIFICATION-BASE_Int_IntSeq» empty))
+        («bitValue(_)_VERIFICATION-BASE_Int_IntSeq» empty) := by
+  native_decide
+
+def identityLoop (_ : SortInt) (acc : SortIntSeq) : SortIntSeq := acc
+
+theorem identityLoop_rejected :
+    ¬ Klean103RoundedAvg.Lemmas.targetStatement
+        Proof._andBool_ Proof.«_>Int_» Proof.«_+Int_» Proof.«_*Int_»
+        «allBits(_)_VERIFICATION-BASE_Bool_IntSeq»
+        «bitValue(_)_VERIFICATION-BASE_Int_IntSeq»
+        «bitWeight(_)_VERIFICATION-BASE_Int_IntSeq»
+        identityLoop := by
+  intro claimed
+  have bad := claimed.1 empty 2 (by native_decide)
+  simp
+    [identityLoop, empty, Proof.«_+Int_», Proof.«_*Int_»,
+     Proof.«bitWeight(_)_VERIFICATION-BASE_Int_IntSeq»,
+     Proof.«bitValue(_)_VERIFICATION-BASE_Int_IntSeq»] at bad
+
+def falseAllBits (_ : SortIntSeq) : SortBool := false
+
+theorem vacuous_counterfeit_accepted :
+    Klean103RoundedAvg.Lemmas.targetStatement
+        Proof._andBool_ Proof.«_>Int_» Proof.«_+Int_» Proof.«_*Int_»
+        falseAllBits
+        «bitValue(_)_VERIFICATION-BASE_Int_IntSeq»
+        «bitWeight(_)_VERIFICATION-BASE_Int_IntSeq»
+        identityLoop := by
+  unfold Klean103RoundedAvg.Lemmas.targetStatement
+  simp [Proof._andBool_, falseAllBits]
+
+#check identityLoop_rejected
+#check vacuous_counterfeit_accepted
+
+end AuditAdversarial
