+requires "/reference/k-proof/verification-base.k"
+
+module OPERATIONAL-EXAMPLES-SPEC
+  imports VERIFICATION-BASE
+
+  claim <k> true andBool false => false </k>
+  claim <k> -3 >Int -4 => true </k>
+  claim <k> -2 +Int 5 => 3 </k>
+  claim <k> -3 *Int 4 => -12 </k>
+
+  claim <k>
+    loopDigits(-3, iCons(49, iCons(48, .IntSeq)))
+    => iCons(49, iCons(48, .IntSeq))
+  </k>
+  claim <k>
+    loopDigits(0, iCons(49, iCons(48, .IntSeq)))
+    => iCons(49, iCons(48, .IntSeq))
+  </k>
+  claim <k>
