+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (!real_readlink) {
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  ssize_t result = real_readlink(path, buffer, size);
+  int saved_errno = errno;
+  long requested_pid = 0;
+  int consumed = 0;
+  if (result < 0 && (saved_errno == ENOENT || saved_errno == EACCES) &&
+      sscanf(path, "/proc/%ld/exe%n", &requested_pid, &consumed) == 1 &&
+      consumed == (int)strlen(path)) {
+    result = real_readlink("/proc/self/exe", buffer, size);
+    saved_errno = errno;
+    fprintf(stderr,
+            "TRACE namespace fallback readlink(%s -> /proc/self/exe) = %zd\n",
+            path, result);
+  }
+  if (result >= 0) {
+    fprintf(stderr, "TRACE readlink(%s) = %zd [%.*s]\n",
+            path, result, (int)result, buffer);
+  } else {
+    fprintf(stderr, "TRACE readlink(%s) = %zd errno=%d\n",
+            path, result, saved_errno);
+  }
+  errno = saved_errno;
+  return result;
+}

