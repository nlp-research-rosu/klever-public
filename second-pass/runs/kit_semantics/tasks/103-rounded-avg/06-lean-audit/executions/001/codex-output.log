diff --git a//tmp/audit-work/operational-examples-spec.k b//tmp/audit-work/operational-examples-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1c45c3cea3320f3eba01930aee0bd2702a2316c1
--- /dev/null
+++ b//tmp/audit-work/operational-examples-spec.k
@@ -0,0 +1,43 @@
+requires "/reference/k-proof/verification-base.k"
+
+module OPERATIONAL-EXAMPLES-SPEC
+  imports VERIFICATION-BASE
+
+  claim <k> true andBool false => false </k>
+  claim <k> -3 >Int -4 => true </k>
+  claim <k> -2 +Int 5 => 3 </k>
+  claim <k> -3 *Int 4 => -12 </k>
+
+  claim <k>
+    loopDigits(-3, iCons(49, iCons(48, .IntSeq)))
+    => iCons(49, iCons(48, .IntSeq))
+  </k>
