    44	    [simplification]
    45	  rule 1 *Int bitWeight(loopDigits(V, A)) +Int bitValue(loopDigits(V, A))
    46	    => V *Int bitWeight(A) +Int bitValue(A)
    47	    requires V >Int 0 andBool allBits(A)
    48	    [simplification]
    49	
    50	  rule allBits(loopDigits(V, A)) => true
    51	    requires V >Int 0 andBool allBits(A)
    52	    [simplification]
    53	endmodule
--- verification-base.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  syntax Int ::= roundedInt(Int, Int) [function, total]
     7	  rule roundedInt(N, M)
     8	    => (N +Int M -Int pyMod(N +Int M, 2)) /Int 2
     9	       +Int pyMod(N +Int M, 2)
    10	            *Int pyMod(
    11	              (N +Int M -Int pyMod(N +Int M, 2)) /Int 2,
    12	              2)
    13	
    14	  syntax Int ::= bitWeight(IntSeq) [function, total]
    15	               | bitValue(IntSeq)  [function, total]
    16	  rule bitWeight(.IntSeq) => 1
    17	  rule bitWeight(iCons(_:Int, R:IntSeq)) => 2 *Int bitWeight(R)
    18	  rule bitValue(.IntSeq) => 0
    19	  rule bitValue(iCons(C:Int, R:IntSeq))
    20	    => (C -Int 48) *Int bitWeight(R) +Int bitValue(R)
    21	
    22	  syntax Bool ::= allBits(IntSeq)   [function, total]
    23	                | startsOne(IntSeq) [function, total]
    24	  rule allBits(.IntSeq) => true
    25	  rule allBits(iCons(C:Int, R:IntSeq))
    26	    => (C ==Int 48 orBool C ==Int 49) andBool allBits(R)
    27	  rule startsOne(iCons(49, _:IntSeq)) => true
    28	  rule startsOne(_:IntSeq) => false [owise]
    29	
    30	  syntax IntSeq ::= loopDigits(Int, IntSeq)
    31	    [function, total, symbol(loopDigits), no-evaluators]
    32	  rule loopDigits(V, A) => A
    33	    requires V <=Int 1
    34	    [concrete]
    35	  rule loopDigits(V, A)
    36	    => loopDigits(
    37	         (V -Int pyMod(V, 2)) /Int 2,
    38	         iCons(48 +Int pyMod(V, 2), A))
    39	    requires V >Int 1
    40	    [concrete]
    41	  rule loopDigits(V, A) => A
    42	    requires V ==Int 1
    43	    [simplification]
    44	  rule loopDigits(Q, iCons(C, A))
    45	    => loopDigits(2 *Int Q +Int (C -Int 48), A)
    46	    requires Q >=Int 1
    47	      andBool C >=Int 48
    48	      andBool C <=Int 49
    49	    [symbolic(Q), simplification(40)]
    50	
    51	  rule 2 *Int ((V -Int pyMod(V, 2)) /Int 2) +Int pyMod(V, 2) => V
    52	    requires V >=Int 0
    53	    [simplification]
    54	  rule 2 *Int ((V -Int ((V %Int 2 +Int 2) %Int 2)) /Int 2)
    55	       +Int ((V %Int 2 +Int 2) %Int 2)
    56	    => V
    57	    requires V >=Int 0
    58	    [simplification]
    59	endmodule
--- connection-spec.k
     1	requires "verification-base.k"
     2	
     3	module LOOP-CONNECTION
     4	  imports VERIFICATION-BASE
     5	
     6	  claim [binary-loop-exact]:
     7	    <k>
     8	      #while(
     9	        Compare(Name("value"), CmpOp(">", Int(1))),
    10	        Assign(
    11	          Name("digits"),
    12	          BinOp(
    13	            "+",
    14	            Call(
    15	              Name("chr"),
    16	              BinOp("+", Int(48), BinOp("%", Name("value"), Int(2)))),
    17	            Name("digits")))
    18	        Assign(Name("value"), BinOp("//", Name("value"), Int(2))))
    19	      => .K
    20	      ...
    21	    </k>
    22	    <env> 1 </env>
    23	    <scopes>
    24	      -1 |-> builtinsScope
    25	      0 |-> scope(MODULE:Map, parent(-1))
    26	      1 |-> scope(
    27	        "n" |-> NI:Int
    28	        "m" |-> MI:Int
    29	        "value" |-> (V:Int => 1)
    30	        "digits" |-> (str(A:IntSeq) => str(loopDigits(V, A))),
    31	        parent(0))
    32	    </scopes>
    33	    requires V >Int 0
    34	      andBool allBits(A)
    35	      andBool notBool ("chr" in_keys(MODULE))
    36	    ensures bitWeight(loopDigits(V, A))
    37	              +Int bitValue(loopDigits(V, A))
    38	            ==Int V *Int bitWeight(A) +Int bitValue(A)
    39	      andBool allBits(loopDigits(V, A))
    40	endmodule
--- arithmetic proof modules
     1	requires "reference-semantics/semantics.k"
     2	
     3	module ARITHMETIC-VERIFICATION
     4	  imports MPY
     5	endmodule
     1	requires "arithmetic-verification.k"
     2	
     3	module ARITHMETIC-SPEC
     4	  imports ARITHMETIC-VERIFICATION
     5	
     6	  claim [euclidean-reconstruction]:
