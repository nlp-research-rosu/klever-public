codex
The launcher failure is caused by the execution sandbox’s PID namespace: Lean asks `/proc/<its-pid>/exe`, but that numeric entry is absent even though `/proc/self` works. I’m applying a temporary runtime-only `readlink` shim from `/tmp` so the unchanged pinned Lean 4.22 binaries can locate themselves. This does not modify the project, Base, toolchain, dependencies, or proof source.
apply patch
patch: completed
/tmp/lean-proc-exe-shim.c
diff --git a//tmp/lean-proc-exe-shim.c b//tmp/lean-proc-exe-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..0c929f14e0e7e36f67cb30f85ceba3f754741257
--- /dev/null
+++ b//tmp/lean-proc-exe-shim.c
@@ -0,0 +1,50 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <libgen.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+static int is_proc_exe(const char *path) {
+  size_t n = strlen(path);
+  return n > 10 && strncmp(path, "/proc/", 6) == 0
+      && strcmp(path + n - 4, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  if (!is_proc_exe(path)) {
+    return syscall(SYS_readlink, path, buf, size);
+  }
+
+  const char *name = program_invocation_name;
+  char absolute[PATH_MAX];
+  if (name == NULL || name[0] == '\0') {
+    errno = ENOENT;
+    return -1;
+  }
+  if (name[0] != '/') {
+    const char *base = strrchr(name, '/');
+    base = base == NULL ? name : base + 1;
+    int written = snprintf(
+        absolute,
+        sizeof(absolute),
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/%s",
+        base);
+    if (written < 0 || (size_t)written >= sizeof(absolute)) {
+      errno = ENAMETOOLONG;
+      return -1;
+    }
+    name = absolute;
+  }
+
+  size_t n = strlen(name);
+  if (n > size) {
+    n = size;
+  }
+  memcpy(buf, name, n);
+  return (ssize_t)n;
+}
