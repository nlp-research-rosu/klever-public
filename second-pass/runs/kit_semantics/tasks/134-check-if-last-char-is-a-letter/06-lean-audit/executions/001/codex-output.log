   144	
   145	  syntax Int ::= upperC(Int) [function, total]
     1	// reference/src/semantics/subscript.k — MPY-SUBSCRIPT
     2	
     3	module MPY-SUBSCRIPT
     4	  imports MPY-CORE
     5	
     6	  // ==== positional access + negative-index normalization (used only here) ===
     7	  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
     8	  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
     9	  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
    10	  // atK. K trusts the [total] annotation; valid programs index in-bounds.
    11	  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
    12	  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
    13	  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
    14	       requires I >Int 0
    15	
    16	  syntax Int ::= intSeqAt(IntSeq, Int) [function]
    17	  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C
    18	  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
    19	       requires I >Int 0
    20	
    21	  syntax Int ::= normIdx(Int, Int) [function, total]
    22	  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
    23	  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0
    24	
    25	  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================
    26	  // contexts (not strict attrs): the Index slot's Slice alternative must never heat
    27	  context Subscript(HOLE, _)
    28	  context Subscript(_:Val, HOLE:Expr)
    29	
    30	  // heap-object deref (covers both the index and slice forms via the Index slot)
    31	  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       [priority(40)]
    34	
    35	  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>
    36	
    37	  syntax Val ::= applyIndex(Val, Int) [function]
    38	  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    39	  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    40	  rule applyIndex(str(IS:IntSeq),   I:Int)
    41	    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))
    42	
    43	  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
    44	  syntax KItem ::= #evalB(Bound) | "#toSome"
    45	                 | #slLo(Val, Bound, Bound)
    46	                 | #slHi(Val, OptInt, Bound)
    47	                 | #slStep(Val, OptInt, OptInt)
    48	
    49	  syntax OptInt ::= "noB" | someB(Int)
    50	  rule <k> #evalB(NoBound)  => noB ... </k>
     1	// reference/src/semantics/int.k — MPY-INT
     2	// Int cases of the operator dispatch; Python // and % are floored (pyMod).
     3	
     4	module MPY-INT
     5	  imports MPY-CORE
     6	
     7	  rule applyUn("-", I:Int) => 0 -Int I
     8	
     9	  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
    10	  // Bool participates in int arithmetic (x += (a == b))
    11	  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
    12	  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
    13	  // bool is a subtype of int: any Bool operand promotes to 0/1 and re-dispatches
    14	  // to the Int cases (the "+" mixed cases above are kept, so "+" is excluded here
    15	  // to avoid a duplicate rule — Bool + Bool still promotes via the Bool x Bool rule).
    16	  rule applyBin(OP:String, B1:Bool, B2:Bool) => applyBin(OP, boolAsInt(B1), boolAsInt(B2))
    17	       requires isArithOp(OP)
    18	  rule applyBin(OP:String, B:Bool, I:Int)    => applyBin(OP, boolAsInt(B), I)
    19	       requires isArithOp(OP) andBool OP =/=String "+"
    20	  rule applyBin(OP:String, I:Int, B:Bool)    => applyBin(OP, I, boolAsInt(B))
    21	       requires isArithOp(OP) andBool OP =/=String "+"
    22	  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
    23	  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
    24	  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
    25	  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
    26	  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
    27	
    28	  syntax Int ::= pyMod(Int, Int) [function]
    29	  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
    30	
    31	  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
    32	  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
    33	  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
    34	  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
    35	  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
    36	  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
    37	endmodule
     1	// reference/src/semantics/str.k — MPY-STR
     2	
     3	module MPY-STR
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	
     7	  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
     8	  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
     9	  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
    10	        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
    11	
    12	  // ==== str literal (ASCII-only) ============================================
    13	  syntax IntSeq ::= strToCodes(String) [function]
    14	  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
    15	  rule strToCodes("") => .IntSeq
    16	  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    17	    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
    18	
    19	  // ==== operators: + / == / != / in =========================================
    20	  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
    21	  rule seqConcat(.IntSeq, T:IntSeq)                => T
    22	  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
    23	
    24	  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
    26	  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
    27	
    28	  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
    29	  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
    30	  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
    31	
    32	  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
    33	  rule strPrefix(.IntSeq, _:IntSeq)               => true
    34	  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
    35	  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)

diff --git a//tmp/audit-work/stage5-review/BridgeAudit.lean b//tmp/audit-work/stage5-review/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..cda700efed6edcdf38f34e30f0485f0ed7629375
--- /dev/null
+++ b//tmp/audit-work/stage5-review/BridgeAudit.lean
@@ -0,0 +1,82 @@
+import Proof
+
+namespace BridgeAudit
+
+def empty : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def cons (head : SortInt) (tail : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail
+
+def asK (value : SortIntSeq) : SortK :=
+  SortK.kseq (SortKItem.inj_SortIntSeq value) SortK.dotk
+
+def asKWithTail (value tail : SortIntSeq) : SortK :=
+  SortK.kseq
+    (SortKItem.inj_SortIntSeq value)
+    (SortK.kseq (SortKItem.inj_SortIntSeq tail) SortK.dotk)
+
+theorem intBridgeExact (x y : SortInt) :
+    Proof.«_==Int_» x y = true ↔ x = y := by
+  simp [Proof.«_==Int_»]
+
+theorem kBridgeExact (x y : SortK) :
+    Proof.«_==K_» x y = true ↔ x = y := by
+  simp [Proof.«_==K_»]
+
+example : Proof.«_==Int_» 65 65 = true := by
+  simp [Proof.«_==Int_»]
+
+example : Proof.«_==Int_» 65 66 = false := by
+  simp [Proof.«_==Int_»]
+
+example : Proof.«_==Int_» (-1) (-1) = true := by
+  simp [Proof.«_==Int_»]
+
+example : Proof.«_==Int_» (-1) 0 = false := by
+  simp [Proof.«_==Int_»]
+
+example : Proof.«_==K_» (asK (cons 65 empty)) (asK empty) = false := by
+  simp [Proof.«_==K_», asK, cons, empty]
+
+example :
+    Proof.«_==K_» (asK (cons 65 empty)) (asK (cons 65 empty)) = true := by
+  simp [Proof.«_==K_», asK, cons, empty]
+
+example :
+    Proof.«_==K_» (asK (cons 65 empty)) (asK (cons 66 empty)) = false := by
+  simp [Proof.«_==K_», asK, cons, empty]
+
+example :
+    Proof.«_==K_»
+      (asK (cons 65 empty))
+      (asKWithTail (cons 65 empty) empty) = false := by
+  simp [Proof.«_==K_», asK, asKWithTail, cons, empty]
+
+/- A deliberately dishonest pair can satisfy the fixed proposition. This
+   witnesses why target closure alone is insufficient and why the candidate
+   definitions must be checked against the K symbols' operational meaning. -/
+def badEqInt (_x _y : SortInt) : SortBool := false
+def badEqK (_x _y : SortK) : SortBool := false
+
+theorem dishonestConstantPairStillProvesTarget :
+    Klean134CheckIfLastCharIsALetter.Lemmas.targetStatement
+      badEqInt badEqK := by
+  unfold Klean134CheckIfLastCharIsALetter.Lemmas.targetStatement
+  constructor
+  · intro _REST _C
+    rfl
+  · intro D C
+    rfl
+
+example : badEqInt 65 65 ≠ Proof.«_==Int_» 65 65 := by
+  simp [badEqInt, Proof.«_==Int_»]
+
+example : badEqK SortK.dotk SortK.dotk ≠ Proof.«_==K_» SortK.dotk SortK.dotk := by
+  simp [badEqK, Proof.«_==K_»]
+
+#check intBridgeExact
+#check kBridgeExact
+#check dishonestConstantPairStillProvesTarget
+
+end BridgeAudit
