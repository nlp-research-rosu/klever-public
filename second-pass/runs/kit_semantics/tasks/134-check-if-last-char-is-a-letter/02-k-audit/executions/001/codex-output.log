+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "check_if_last_char_is_a_letter" |->
+               closureVal(
+                 "txt", .ParamNames,
+                 If(
+                   Compare(Call(Name("len"), Name("txt")),
+                           CmpOp("==", Int(0))),
+                   Return(Bool(false)),
+                   .Stmts)
