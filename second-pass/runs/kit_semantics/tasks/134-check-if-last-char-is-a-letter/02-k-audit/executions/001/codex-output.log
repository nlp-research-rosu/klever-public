+             "check_if_last_char_is_a_letter" |->
+               closureVal(
+                 "txt", .ParamNames,
+                 Return(Bool(true)) .Stmts,
+                 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
