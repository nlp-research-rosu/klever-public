===== sort
     1	// reference/src/semantics/sort.k — MPY-SORT
     2	// Trusted sorted(): sorted(list) as an opaque ascending permutation `sortVS` — opaque symbolic
     3	// for kprove (a trusted primitive, correctness/ordering proved in Lean / notes/sort-probe),
     4	// and a concrete insertion sort for krun. Wrappers verify the logic AROUND the sort (index /
     5	// slice / filter / dedup); indexing an opaque sortVS(VS) carries through as an opaque term, so
     6	// no ordering lemma is needed in K — the trust (sortVS = real sorted) is discharged by each
     7	// problem's differential test. Only int lists (compared by projectIntTotal); keyed / string
     8	// sorts are separate. Fires only via the "sorted" builtin, so inert for non-sorting programs.
     9	
    10	module MPY-SORT
    11	  imports MPY-BUILTINS
    12	  imports MPY-SUBSCRIPT
    13	
    14	  // sortVS(VS): the ascending sort of the Val list VS. Opaque for symbolic VS (no-evaluators);
    15	  // concrete insertion sort for krun.
    16	  // Concrete sort matches Int-sorted elements directly (an int Val IS an Int); projectIntTotal
    17	  // (lemmas-only) is not available in the semantics. Int and str lists.
    18	  syntax ValSeq ::= sortVS(ValSeq) [function, total, symbol(sortVS), no-evaluators]
    19	  syntax ValSeq ::= insVS(Int, ValSeq) [function]
    20	  rule sortVS(.ValSeq)                => .ValSeq          [concrete]
    21	  rule sortVS(vCons(X:Int, R:ValSeq)) => insVS(X, sortVS(R)) [concrete]
    22	  rule insVS(X:Int, .ValSeq)                => vCons(X, .ValSeq) [concrete]
    23	  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(X, vCons(Y, R)) requires X <=Int Y [concrete]
    24	  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(Y, insVS(X, R)) requires X  >Int Y [concrete]
    25	  // v3: mixed-numeric elements (float/bool heads; float/bool tail elements under
    26	  // an Int head) insert via the shared applyCmp dispatch — the exact ltIF/ltFI
    27	  // bridges (float.k) + the bool->int promotion (bool.k), so mixed sorts match
    28	  // CPython bit-exactly. X goes before Y iff not (Y < X) — the same tie rule as
    29	  // insVS's X <=Int Y, so equal keys keep first-seen order (stable insertion
    30	  // from the right). str-vs-numeric has no applyCmp leg and stays stuck
    31	  // (CPython TypeError).
    32	  syntax ValSeq ::= insVSn(Val, ValSeq) [function]
    33	  rule sortVS(vCons(X:Val, R:ValSeq)) => insVSn(X, sortVS(R))
    34	       requires isFloat(X) orBool isBool(X) [concrete]
    35	  rule insVS(X:Int, vCons(Y:Val, R:ValSeq)) => vCons(X, vCons(Y, R))
    36	       requires (isFloat(Y) orBool isBool(Y)) andBool notBool applyCmp("<", Y, X) [concrete]
    37	  rule insVS(X:Int, vCons(Y:Val, R:ValSeq)) => vCons(Y, insVS(X, R))
    38	       requires (isFloat(Y) orBool isBool(Y)) andBool applyCmp("<", Y, X) [concrete]
    39	  rule insVSn(X:Val, .ValSeq) => vCons(X, .ValSeq) [concrete]
    40	  rule insVSn(X:Val, vCons(Y:Val, R:ValSeq)) => vCons(X, vCons(Y, R))
    41	       requires notBool applyCmp("<", Y, X) [concrete]
    42	  rule insVSn(X:Val, vCons(Y:Val, R:ValSeq)) => vCons(Y, insVSn(X, R))
    43	       requires applyCmp("<", Y, X) [concrete]
    44	  // str elements insert by the shared lexicographic strLt (methods.k)
    45	  syntax ValSeq ::= insVSs(IntSeq, ValSeq) [function]
    46	  rule sortVS(vCons(str(CS:IntSeq), R:ValSeq)) => insVSs(CS, sortVS(R)) [concrete]
    47	  rule insVSs(A:IntSeq, .ValSeq) => vCons(str(A), .ValSeq) [concrete]
    48	  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(A), vCons(str(B), R))
    49	       requires strLt(A, B) orBool A ==K B [concrete]
    50	  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))
    51	       requires notBool (strLt(A, B) orBool A ==K B) [concrete]
    52	
    53	  // sorted(list) constructs a NEW object: k-cell pre-dispatch (beats the [owise]
    54	  // applyBuiltin routing in call.k) so the result allocates.
    55	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), .Vals))
    56	        => #alloc(list(sortVS(VS))) ... </k>
    57	
    58	  // mutator: xs.sort() — the in-place heap write over the same trusted sortVS
    59	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "sort")), .Vals) => noneV ... </k>
    60	       <heap> ... H |-> list(VS:ValSeq => sortVS(VS)) ... </heap>
    61	       [priority(40)]
    62	
    63	  // ==== keyed / reversed sorted() (WP2) =====================================
    64	  // sortKeyVS(VS, KV): the stable ascending sort of VS by the key value KV
    65	  // (a closure/builtin/type — anything callable). OPAQUE here; the concrete
    66	  // leg (MPY-CONCRETE, llvm only) computes keys by REAL calls and stable-
    67	  // inserts, at priority(40) over these.
    68	  syntax ValSeq ::= sortKeyVS(ValSeq, Val) [function, total, symbol(sortKeyVS), no-evaluators]
    69	
    70	  syntax ValSeq ::= revVS(ValSeq) [function, total]
    71	                  | revVSAcc(ValSeq, ValSeq) [function, total]
    72	  rule revVS(S:ValSeq) => revVSAcc(S, .ValSeq)
    73	  rule revVSAcc(.ValSeq, A:ValSeq) => A
    74	  rule revVSAcc(vCons(V:Val, R:ValSeq), A:ValSeq) => revVSAcc(R, vCons(V, A))
    75	
    76	  syntax ValSeq ::= condRev(ValSeq, Bool) [function, total]
    77	  rule condRev(S:ValSeq, false) => S
    78	  rule condRev(S:ValSeq, true)  => revVS(S)
    79	
    80	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    81	        => #alloc(list(sortKeyVS(VS, KV))) ... </k>
    82	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    83	        => #alloc(list(condRev(sortKeyVS(VS, KV), RB))) ... </k>
    84	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("reverse", RB:Bool), .Vals))
    85	        => #alloc(list(condRev(sortVS(VS), RB))) ... </k>
    86	
    87	  // Indexing the opaque sorted list: `valSeqAt(sortVS(VS), I)` is DEFINED because valSeqAt is
    88	  // [total] (subscript.k) — it stays an abstract total value for a symbolic sort and reduces
    89	  // over the concrete sort for krun. No separate sortedAt indirection is needed; wrappers write
    90	  // their postcondition directly as valSeqAt(sortVS(VS), …).
    91	endmodule
===== concrete
     1	// reference/src/semantics/concrete.k — MPY-CONCRETE
     2	// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
     3	// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
     4	// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
     5	// backend ([concrete] is not respected on rewrite rules) — probed on
     6	// 26-remove-duplicates, where element compares branched into deepEqVS.
     7	
     8	module MPY-CONCRETE
     9	  imports MPY
    10	
    11	  // deep equality for list compares whose elements are heap objects
    12	  // (list-of-lists): Python == is structural at every depth.
    13	  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
    14	       <heap> HP:Map </heap>
    15	       requires hasRefVS(A) orBool hasRefVS(B)
    16	  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
    17	       <heap> HP:Map </heap>
    18	       requires hasRefVS(A) orBool hasRefVS(B)
    19	
    20	  // ==== keyed sort, concrete leg ============================================
    21	  // Computes each key by a REAL call through the uniform #callee machinery
    22	  // (closures, len, type objects all work), stable-inserts on the key, and
    23	  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
    24	  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
    25	  syntax Val ::= kvP(Val, Val)
    26	  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
    27	                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
    28	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    29	        => #ksort(VS, KV, .ValSeq, false) ... </k>
    30	       [priority(40)]
    31	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    32	        => #ksort(VS, KV, .ValSeq, RB) ... </k>
    33	       [priority(40)]
    34	  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
    35	        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
    36	  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
    37	        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
    38	  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
    39	        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
    40	       requires notBool isKwV(K)
    41	
    42	  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
    43	  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
    44	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    45	    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
    46	       requires kLt(K, K2)
    47	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    48	    => vCons(kvP(K2, V2), insPair(R, K, V))
    49	       requires notBool kLt(K, K2)
    50	
    51	  syntax Bool ::= kLt(Val, Val) [function]
    52	  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
    53	  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
    54	  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    55	  // v3: mixed Int/Float keys via the exact v2 bridges (float.k), bool keys by
    56	  // the bool->int promotion (True==1, False==0). Unordered pairs (int vs str)
    57	  // stay without a leg — stuck, like CPython's TypeError.
    58	  rule kLt(I:Int, F:Float)   => ltIF(I, F)
    59	  rule kLt(F:Float, I:Int)   => ltFI(F, I)
    60	  rule kLt(B:Bool, V:Val)    => kLt(boolAsInt(B), V) requires isInt(V) orBool isFloat(V)
    61	  rule kLt(V:Val, B:Bool)    => kLt(V, boolAsInt(B)) requires isInt(V) orBool isFloat(V)
    62	  rule kLt(B1:Bool, B2:Bool) => boolAsInt(B1) <Int boolAsInt(B2)
    63	
    64	  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
    65	  rule unpairVS(.ValSeq) => .ValSeq
    66	  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
    67	  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
    68	
    69	  // ==== non-keyed reverse sorted(), concrete leg (v3) =======================
    70	  // sort.k's condRev(sortVS(VS), true) reverses equal-key runs — invisible on
    71	  // the all-Int / all-str lists sortVS used to accept, visible once sortVS
    72	  // orders mixed numerics (CPython keeps FIRST-seen order among equal keys
    73	  // under reverse=True). rev-in/rev-out over the same stable ascending sortVS
    74	  // is exactly CPython's stable descending sort, and is output-identical on the
    75	  // old homogeneous domains. krun-only (priority 40; proofs keep sort.k's
    76	  // condRev(sortVS(VS), RB) term unchanged).
    77	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("reverse", true), .Vals))
    78	        => #alloc(list(revVS(sortVS(revVS(VS))))) ... </k>
    79	       [priority(40)]
    80	
    81	  // ==== numeric cross-type membership (Python: 1 == True == 1.0) =============
    82	  // `x in list` / `x not in list` compare elements with ==K in list.k, which does
    83	  // NOT collapse across the numeric types (true =/=K 1, 1 =/=K 1.0). Under krun,
    84	  // override the membership fold with a numeric-aware equality so `in` and
    85	  // unique()-style dedup behave like CPython for mixed int/bool/float elements.
    86	  // (set.k needs no change: setV holds int char codes, compared with ==Int, so a
    87	  // cross-type ==K collapse never arises there.)
    88	  // krun-only (priority 40 beats list.k's default rules); kprove uses the
    89	  // structural ==K rules in list.k unchanged.
    90	  syntax Bool ::= numOrKEq(Val, Val) [function]
    91	  rule numOrKEq(A:Val, B:Val) => applyCmp("==", A, B)
    92	       requires (isInt(A) orBool isBool(A) orBool isFloat(A))
    93	        andBool (isInt(B) orBool isBool(B) orBool isFloat(B))
    94	  rule numOrKEq(A:Val, B:Val) => A ==K B [owise]
    95	
    96	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    97	       requires numOrKEq(E, V) [priority(40)]
    98	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    99	       requires notBool numOrKEq(E, V) [priority(40)]
   100	endmodule

diff --git a/evidence/stage1_integrity.py b/evidence/stage1_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..e29b7700c98f69d724d464c3053eb3de8eb0035a
--- /dev/null
+++ b/evidence/stage1_integrity.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Independent integrity checks for the mounted audit inputs."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+import sys
+from pathlib import Path
+
+
+AUDIT = Path("/audit-input.json")
+LOCK = Path("/audit-campaign-lock.json")
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def inventory(root: Path) -> dict[str, tuple[str, str | None]]:
+    result: dict[str, tuple[str, str | None]] = {}
+    for directory, dirnames, filenames in os.walk(root, followlinks=False):
+        base = Path(directory)
+        for name in sorted(dirnames + filenames):
+            path = base / name
+            rel = path.relative_to(root).as_posix()
+            mode = os.lstat(path).st_mode
+            if stat.S_ISLNK(mode):
+                result[rel] = ("symlink", os.readlink(path))
+            elif stat.S_ISDIR(mode):
+                result[rel] = ("directory", None)
+            elif stat.S_ISREG(mode):
+                result[rel] = ("file", sha256_file(path))
+            else:
+                result[rel] = ("other", oct(mode))
+    return result
+
+
+def main() -> int:
+    failures: list[str] = []
+    audit = json.loads(AUDIT.read_text())
+    lock = json.loads(LOCK.read_text())
+
+    print(f"audit_input_type=regular:{AUDIT.is_file()} symlink:{AUDIT.is_symlink()}")
+    print(f"campaign_lock_type=regular:{LOCK.is_file()} symlink:{LOCK.is_symlink()}")
+    actual_lock_hash = sha256_file(LOCK)
+    expected_lock_hash = audit["hashes"]["audit_campaign_lock_sha256"]
+    print(f"campaign_lock_sha256 expected={expected_lock_hash} actual={actual_lock_hash}")
+    if actual_lock_hash != expected_lock_hash:
+        failures.append("campaign lock hash mismatch")
+    campaign_equal = audit["audit_campaign"] == lock
+    print(f"campaign_json_matches={campaign_equal}")
+    if not campaign_equal:
+        failures.append("campaign JSON differs from audit-input")
+
+    file_hash_checks = {
+        "/reference/canonical.py": "canonical_sha256",
+        "/reference/prompt.py": "trusted_prompt_sha256",
+        "/reference/py2mpy.py": "trusted_translator_sha256",
+        "/candidate/prompt.py": "candidate_prompt_sha256",
+        "/candidate/py2mpy.py": "candidate_translator_sha256",
+        "/run.json": "run_manifest_sha256",
+        "/task.json": "task_manifest_sha256",
+        "/generation-result.json": "stage1_result_sha256",
+        "/generation-evidence/invocation.json": "stage1_invocation_sha256",
+        "/generation-evidence/metrics.json": "generation_metrics_sha256",
+        "/generation-evidence/runtime-metrics.json": "generation_runtime_metrics_sha256",
+        "/generation-evidence/usage.json": "generation_usage_sha256",
+        "/generation-evidence/codex-last.txt": "generation_codex_last_sha256",
+        "/generation-evidence/codex-output.log": "generation_codex_output_sha256",
+        "/generation-evidence/prompt.txt": "generation_prompt_sha256",
+    }
+    for raw_path, key in file_hash_checks.items():
+        path = Path(raw_path)
+        if not path.is_file() or path.is_symlink():
+            print(f"FILE_INVALID {raw_path} exists={path.exists()} symlink={path.is_symlink()}")
+            failures.append(f"missing, mistyped, or symlinked required file {raw_path}")
+            continue
+        actual = sha256_file(path)
+        expected = audit["hashes"][key]
+        print(f"sha256 {raw_path} expected={expected} actual={actual} match={actual == expected}")
+        if actual != expected:
+            failures.append(f"hash mismatch {raw_path}")
+
+    trace_root = Path("/generation-evidence/codex-trace")
+    trace_files = sorted(path for path in trace_root.rglob("*") if path.is_file())
+    trace_bad = [
+        str(path)
+        for path in trace_root.rglob("*")
+        if path.is_symlink() or (not path.is_file() and not path.is_dir())
+    ]
+    print(f"trace_file_count={len(trace_files)} trace_bad_entries={trace_bad}")
+    if not trace_root.is_dir() or trace_root.is_symlink() or not trace_files or trace_bad:
+        failures.append("structured trace missing, mistyped, empty, or symlinked")
+    for path in trace_files:
+        print(f"trace_file_sha256 {path} {sha256_file(path)}")
+
+    trusted = inventory(Path("/reference/reference-semantics"))
+    candidate = inventory(Path("/candidate/reference-semantics"))
+    all_names = sorted(set(trusted) | set(candidate))
+    semantics_diffs = [
+        (name, trusted.get(name), candidate.get(name))
+        for name in all_names
+        if trusted.get(name) != candidate.get(name)
+    ]
+    trusted_bad = [name for name, value in trusted.items() if value[0] not in {"directory", "file"}]
+    candidate_bad = [name for name, value in candidate.items() if value[0] not in {"directory", "file"}]
+    print(
+        "semantics_inventory "
+        f"trusted_entries={len(trusted)} candidate_entries={len(candidate)} "
+        f"diff_count={len(semantics_diffs)} "
+        f"trusted_bad={trusted_bad} candidate_bad={candidate_bad}"
+    )
+    for diff in semantics_diffs:
+        print(f"SEMANTICS_DIFF {diff!r}")
+    if semantics_diffs or trusted_bad or candidate_bad:
+        failures.append("candidate supplied-semantics tree differs from trusted tree")
+
+    byte_pairs = [
+        (Path("/candidate/prompt.py"), Path("/reference/prompt.py")),
+        (Path("/candidate/py2mpy.py"), Path("/reference/py2mpy.py")),
+    ]
+    for left, right in byte_pairs:
+        same = left.read_bytes() == right.read_bytes()
+        print(f"byte_identity {left} {right} match={same}")
+        if not same:
+            failures.append(f"byte mismatch {left} vs {right}")
+
+    declared = audit["container_paths"]
+    for key, raw_path in sorted(declared.items()):
+        path = Path(raw_path)
+        valid = path.exists() and not path.is_symlink()
+        print(
+            f"declared_mount {key}={raw_path} "
+            f"exists={path.exists()} symlink={path.is_symlink()} valid={valid}"
+        )
+        if not valid:
+            failures.append(f"launcher-declared mount invalid: {key}={raw_path}")
+
+    print(f"FAILURE_COUNT={len(failures)}")
+    for failure in failures:
+        print(f"FAILURE {failure}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/evidence/stage2_differential.py b/evidence/stage2_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..4a94268764393d4038b264d9c4d109a4c9349fc3
--- /dev/null
+++ b/evidence/stage2_differential.py
@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+"""Independent docstring-first differential for HumanEval task 134."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import itertools
+import json
+import sys
+from pathlib import Path
+from typing import Callable
+
+
+SCRATCH = Path("/tmp/audit-work/134-check-last-char")
+
+
+def load_entry(path: Path, module_name: str) -> Callable[[str], bool]:
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.check_if_last_char_is_a_letter
+
+
+def docstring_oracle(txt: str) -> bool:
+    """Literal reading: the last space-delimited group must be one letter."""
+    final_group = txt.split(" ")[-1]
+    return len(final_group) == 1 and final_group.isalpha()
+
+
+documented = [
+    ("apple pie", False),
+    ("apple pi e", True),
+    ("apple pi e ", False),
+    ("", False),
+]
+
+branch_boundaries = [
+    "",
+    "a",
+    "Z",
+    "1",
+    "!",
+    " ",
+    " a",
+    "  a",
+    "aa",
+    "a ",
+    "a  ",
+    "a b",
+    "a  b",
+    "ab c",
+    "ab cd",
+    "\ta",
+    "a\tb",
+    "a\nb",
+]
+
+alphabet = (" ", "a", "Z", "1", "!", "\t")
+generated = [
+    "".join(chars)
+    for length in range(0, 6)
+    for chars in itertools.product(alphabet, repeat=length)
+]
+
+unicode_and_exotic = [
+    "é",
+    " É",
+    "α",
+    "x β",
+    "βγ",
+    "xβ",
+    "中",
+    "x 中",
+    "🙂",
+    "x 🙂",
+    "İ",
+    "x İ",
+    "e\u0301",
+    "x e\u0301",
+]
+
+all_inputs = list(
+    dict.fromkeys(
+        [value for value, _expected in documented]
+        + branch_boundaries
+        + generated
+        + unicode_and_exotic
+    )
+)
+
+
+def outcome(function: Callable[[str], bool], value: str) -> tuple[str, object]:
+    try:
+        return ("return", function(value))
+    except Exception as error:  # noqa: BLE001 - differences in exceptions matter
+        return ("exception", f"{type(error).__name__}: {error}")
+
+
+def main() -> int:
+    if len(sys.argv) == 2 and sys.argv[1] == "--inputs-only":
+        json.dump(all_inputs, sys.stdout, ensure_ascii=False, indent=2)
+        print()
+        return 0
+
+    canonical = load_entry(SCRATCH / "canonical.py", "audit_trusted_canonical")
+    candidate = load_entry(SCRATCH / "solution.py", "audit_candidate_solution")
+
+    serialized = json.dumps(all_inputs, ensure_ascii=False, separators=(",", ":")).encode()
+    print(f"input_count={len(all_inputs)}")
+    print(f"input_corpus_sha256={hashlib.sha256(serialized).hexdigest()}")
+    print(f"generated_exhaustive_lengths=0..5 alphabet={alphabet!r}")
+    print(f"unicode_and_exotic_count={len(unicode_and_exotic)}")
+
+    documented_failures: list[tuple[str, object, object]] = []
+    for value, expected in documented:
+        oracle_value = docstring_oracle(value)
+        candidate_value = outcome(candidate, value)
+        print(
+            "DOCUMENTED "
+            f"input={value!r} stated={expected!r} oracle={oracle_value!r} "
+            f"candidate={candidate_value!r} canonical={outcome(canonical, value)!r}"
+        )
+        if oracle_value != expected or candidate_value != ("return", expected):
+            documented_failures.append((value, expected, candidate_value))
+
+    candidate_mismatches: list[tuple[str, object, object]] = []
+    canonical_mismatches: list[tuple[str, object, object]] = []
+    for value in all_inputs:
+        expected = ("return", docstring_oracle(value))
+        candidate_value = outcome(candidate, value)
+        canonical_value = outcome(canonical, value)
+        if candidate_value != expected:
+            candidate_mismatches.append((value, expected, candidate_value))
+        if canonical_value != expected:
+            canonical_mismatches.append((value, expected, canonical_value))
+
+    print(f"documented_failure_count={len(documented_failures)}")
+    print(f"candidate_docstring_mismatch_count={len(candidate_mismatches)}")
+    for mismatch in candidate_mismatches[:25]:
+        print(f"CANDIDATE_MISMATCH {mismatch!r}")
+    print(f"canonical_docstring_mismatch_count={len(canonical_mismatches)}")
+    for mismatch in canonical_mismatches[:25]:
+        print(f"CANONICAL_OBSERVATION {mismatch!r}")
+
+    print("BRANCH_BOUNDARY_RESULTS")
+    for value in branch_boundaries:
+        print(
+            f"input={value!r} oracle={docstring_oracle(value)!r} "
+            f"candidate={outcome(candidate, value)!r} canonical={outcome(canonical, value)!r}"
+        )
+
+    print("UNICODE_AND_EXOTIC_RESULTS")
+    for value in unicode_and_exotic:
+        print(
+            f"input={value!r} oracle={docstring_oracle(value)!r} "
+            f"candidate={outcome(candidate, value)!r} canonical={outcome(canonical, value)!r}"
+        )
+
+    return 1 if documented_failures or candidate_mismatches else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/stage3_smoke.py b/evidence/stage3_smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..5cd6b6cc3a5defc59ba9a8693ff6f916f905ddcc
--- /dev/null
+++ b/evidence/stage3_smoke.py
@@ -0,0 +1,15 @@
+def check_if_last_char_is_a_letter(txt):
+    if len(txt) == 0:
+        return False
+    return txt[-1].isalpha() and (len(txt) == 1 or txt[-2] == " ")
+
+
+assert check_if_last_char_is_a_letter("apple pie") == False
+assert check_if_last_char_is_a_letter("apple pi e") == True
+assert check_if_last_char_is_a_letter("apple pi e ") == False
+assert check_if_last_char_is_a_letter("") == False
+assert check_if_last_char_is_a_letter("A") == True
+assert check_if_last_char_is_a_letter("1") == False
+assert check_if_last_char_is_a_letter("x Y") == True
+assert check_if_last_char_is_a_letter("xy") == False
+assert check_if_last_char_is_a_letter("  z") == True
diff --git a/evidence/stage4_pinning.py b/evidence/stage4_pinning.py
new file mode 100644
index 0000000000000000000000000000000000000000..0fe67f6015980f4459236d98c2518d6302ddc614
--- /dev/null
+++ b/evidence/stage4_pinning.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""Mechanical constructor comparison and concrete precondition witnesses."""
+
+from __future__ import annotations
+
+import importlib.util
+import re
+from pathlib import Path
+from typing import Callable
+
+
+ROOT = Path("/tmp/audit-work/134-check-last-char")
+
+
+def balanced_call(text: str, marker: str, start: int = 0) -> tuple[str, int]:
+    marker_at = text.index(marker, start)
+    open_at = marker_at + len(marker) - 1
+    if text[open_at] != "(":
+        raise ValueError(f"marker must end in opening parenthesis: {marker}")
+    depth = 0
+    quoted = False
+    escaped = False
+    for index in range(open_at, len(text)):
+        char = text[index]
+        if quoted:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+            continue
+        if char == '"':
+            quoted = True
+        elif char == "(":
+            depth += 1
+        elif char == ")":
+            depth -= 1
+            if depth == 0:
+                return text[open_at + 1 : index], index + 1
+    raise ValueError(f"unterminated call: {marker}")
+
+
+def top_level_args(content: str) -> list[str]:
+    args: list[str] = []
+    start = 0
+    depth = 0
+    quoted = False
+    escaped = False
+    for index, char in enumerate(content):
+        if quoted:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+            continue
+        if char == '"':
+            quoted = True
+        elif char == "(":
+            depth += 1
+        elif char == ")":
+            depth -= 1
+        elif char == "," and depth == 0:
+            args.append(content[start:index].strip())
+            start = index + 1
+    args.append(content[start:].strip())
+    return args
+
+
+TOKEN = re.compile(
+    r'"(?:\\.|[^"\\])*"|'
+    r"\.[A-Za-z_][A-Za-z0-9_-]*|"
+    r"[A-Za-z_][A-Za-z0-9_-]*|"
+    r"-?[0-9]+|"
+    r"==|!=|<=|>=|"
+    r"[(),]|"
+    r"\S"
+)
+
+
+def normalized_constructor_tokens(term: str) -> list[str]:
+    tokens = [token for token in TOKEN.findall(term) if token not in {".Exprs", ".Stmts"}]
+    changed = True
+    while changed:
+        changed = False
+        new: list[str] = []
+        for index, token in enumerate(tokens):
+            if token == "," and index + 1 < len(tokens) and tokens[index + 1] == ")":
+                changed = True
+                continue
+            new.append(token)
+        tokens = new
+    return tokens
