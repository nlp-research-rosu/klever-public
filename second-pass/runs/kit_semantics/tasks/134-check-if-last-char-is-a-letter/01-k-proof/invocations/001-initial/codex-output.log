diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..dadfc811291835e32a0d04ad78a73352f81d6c83
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: always return true.  The correct empty-input
+  // destination remains false, so an execution-sensitive proof must reject it.
+  claim [mutated-body-empty]:
+    <k>
+      Call(
+        Name("check_if_last_char_is_a_letter"),
+        str(.IntSeq), .Exprs)
+      => standaloneLastLetter(.IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "check_if_last_char_is_a_letter" |->
+               closureVal(
+                 "txt", .ParamNames,
+                 Return(Bool(true)) .Stmts,
+                 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-model-boundary.k b/spec-model-boundary.k
new file mode 100644
index 0000000000000000000000000000000000000000..27fecff39f4d7da8cd76cf8d5e7c71e2e006e409
--- /dev/null
+++ b/spec-model-boundary.k
@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module SPEC-MODEL-BOUNDARY
+  imports VERIFICATION
+
+  // The supplied model's isalpha is ASCII-only.  Code point 233 ('é' in
+  // CPython text) is therefore nonalphabetic in MPY, unlike CPython.
+  claim [latin-small-e-acute]:
+    <k>
+      Call(
+        Name("check_if_last_char_is_a_letter"),
+        str(iCons(233, .IntSeq)), .Exprs)
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "check_if_last_char_is_a_letter" |->
+               closureVal(
+                 "txt", .ParamNames,
+                 If(
+                   Compare(Call(Name("len"), Name("txt")),
+                           CmpOp("==", Int(0))),
+                   Return(Bool(false)),
+                   .Stmts)
+                 Return(
+                   BoolOp(
+                     "and",
+                     Call(
+                       Attribute(
+                         Subscript(Name("txt"), UnaryOp("-", Int(1))),
+                         "isalpha"),
+                       .Exprs),
+                     BoolOp(
+                       "or",
+                       Compare(Call(Name("len"), Name("txt")),
+                               CmpOp("==", Int(1))),
+                       Compare(
+                         Subscript(Name("txt"), UnaryOp("-", Int(2))),
+                         CmpOp("==", Str(" "))),
+                       .Exprs),
+                     .Exprs)),
+                 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
