new file mode 100644
index 0000000000000000000000000000000000000000..6ed0e914fca67396824158d54c2d28a473ee3e2a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,21 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Definitional summary of the prompt's predicate over the semantics' string
+  // representation.  It does not rewrite or bypass any program computation.
+  syntax Bool ::= standaloneLastLetter(IntSeq) [function, total]
+
+  rule standaloneLastLetter(IS:IntSeq)
+    => #if isLen(IS) ==Int 0
+       #then false
+       #else #if notBool isAlphaC(intSeqAt(IS, isLen(IS) -Int 1))
+             #then false
+             #else #if isLen(IS) ==Int 1
+                   #then true
+                   #else intSeqAt(IS, isLen(IS) -Int 2) ==Int 32
+                   #fi
+             #fi
+       #fi
+endmodule

