+                               CmpOp("==", Int(1))),
+                       Compare(
+                         Subscript(Name("txt"), UnaryOp("-", Int(2))),
+                         CmpOp("==", Str(" "))),
+                       .Exprs),
+                     .Exprs)),
+                 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
