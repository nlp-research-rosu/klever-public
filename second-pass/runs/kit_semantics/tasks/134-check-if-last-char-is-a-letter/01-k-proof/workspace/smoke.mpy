Module(
  FuncDef("check_if_last_char_is_a_letter", Params("txt"),
    If(Compare(Call(Name("len"), Name("txt")), CmpOp("==", Int(0))),
      Return(Bool(false)),
      )
    Return(
      BoolOp(
        "and",
        Call(
          Attribute(
            Subscript(Name("txt"), UnaryOp("-", Int(1))),
            "isalpha"),
          ),
        BoolOp(
          "or",
          Compare(Call(Name("len"), Name("txt")), CmpOp("==", Int(1))),
          Compare(
            Subscript(Name("txt"), UnaryOp("-", Int(2))),
            CmpOp("==", Str(" ")))))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pie")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pi e")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pi e ")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("A")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("1")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("x Y")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("xy")),
      CmpOp("==", Bool(false)))))
