/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv_path='/reference/rule-inventory.json'
out_path='/workspace/trust-boundary.json'
inv=json.load(open(inv_path, encoding='utf-8'))
out=json.load(open(out_path, encoding='utf-8'))
assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
inv_ids=[r['source_rule_id'] for r in inv['rules']]
out_ids=[r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert len(out_ids) == len(set(out_ids)) == 26
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
for row in out['rules']:
    assert list(row.keys()) == ['source_rule_id','classification','rationale']
    assert row['classification'] in allowed
    assert row['rationale'].strip()
by_id={r['source_rule_id']: r for r in out['rules']}
simplified=[]
for r in inv['rules']:
    attrs=r.get('attributes', [])
    if any(a == 'simplification' or a.startswith('simplification(') for a in attrs):
        simplified.append(r['source_rule_id'])
        assert by_id[r['source_rule_id']]['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
domain=[r['source_rule_id'] for r in out['rules'] if r['classification']=='DOMAIN_LEMMA']
md=open('/workspace/DISCOVERY.md', encoding='utf-8').read()
assert all(x in md for x in domain)
assert 'domain-lemma set is **not empty**' in md
assert 'There are no separately proved derived lemmas.' in md
assert 'Lean' not in json.dumps(out)
print('inventory_sha256:', out['inventory_sha256'])
print('rule_count:', len(out_ids))
print('classification_counts:', dict(Counter(r['classification'] for r in out['rules'])))
print('simplification_rules_checked:', len(simplified))
print('final audit: PASS')
PY
