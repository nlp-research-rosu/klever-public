+
+  claim [summary-codes]:
+    <k>
+      runPairCodes(
+        .IntSeq,
+        vCons(2, vCons(3, vCons(4, vCons(5, .ValSeq)))),
+        valSeqConcat(
+          vCons(
+            str(iCons(43, .IntSeq)),
+            vCons(
+              str(iCons(42, .IntSeq)),
+              vCons(str(iCons(45, .IntSeq)), .ValSeq))),
+          vCons(str(.IntSeq), .ValSeq)))
+      =>
+      iCons(
