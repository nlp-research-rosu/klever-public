+          valSeqConcat(
+            vCons(
+              str(iCons(43, .IntSeq)),
+              vCons(
+                str(iCons(42, .IntSeq)),
+                vCons(str(iCons(45, .IntSeq)), .ValSeq))),
+            vCons(str(.IntSeq), .ValSeq))))
+      => 9
+    </k>
