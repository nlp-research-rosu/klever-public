    23	module VERIFICATION
    24	  imports VERIFICATION-SYNTAX
    25	  imports MPY
    26	
    27	  // Guarded total twins of the built-in partial subsort casts.  They let the
    28	  // symbolic backend retain the value of a dynamically sorted list head once
    29	  // validAlgebraLists has established its concrete Python value class.
    30	  rule definedProjectInt(V:Val) => isInt(V)
    31	  rule definedProjectStr(V:Val) => isStrV(V)
    32	
    33	  rule #Ceil({@V:Val}:>Int)
    34	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    35	    [simplification]
    36	  rule #Ceil({@V:Val}:>Str)
    37	    => ({ definedProjectStr(@V) #Equals true } #And #Ceil(@V))
    38	    [simplification]
    39	
    40	  rule projectIntTotal(V:Val) => {V}:>Int
    41	    requires definedProjectInt(V)
    42	    [concrete, simplification(10), preserves-definedness]
    43	  rule {V:Val}:>Int => projectIntTotal(V)
    44	    requires definedProjectInt(V)
    45	    [symbolic(V), simplification, preserves-definedness]
    46	  rule projectIntTotal(I:Int) => I [simplification]
    47	
    48	  rule projectStrTotal(V:Val) => {V}:>Str
    49	    requires definedProjectStr(V)
    50	    [concrete, simplification(10), preserves-definedness]
    51	  rule {V:Val}:>Str => projectStrTotal(V)
    52	    requires definedProjectStr(V)
    53	    [symbolic(V), simplification, preserves-definedness]
    54	  rule projectStrTotal(S:Str) => S [simplification]
    55	
    56	  rule codesOf(str(CS:IntSeq)) => CS
    57	  rule codesProject(V:Val) => codesOf(projectStrTotal(V))
    58	
    59	  // These are guarded dispatch twins of fixed MPY rules:
    60	  //   str(I:Int) and str(A) + str(B).
    61	  // They do not add behavior; the projections above connect each dynamic head
    62	  // to the same partial cast selected by the fixed rule's static subsort.
    63	  rule applyBuiltin("str", V:Val, .Vals)
    64	    => str(strToCodes(Int2String(projectIntTotal(V))))
    65	    requires definedProjectInt(V)
    66	    [simplification]
    67	
    68	  rule applyBin("+", str(A:IntSeq), V:Val)
    69	    => str(seqConcat(A, codesProject(V)))
    70	    requires definedProjectStr(V)
    71	    [simplification]
    72	
    73	  rule allowedOperator(V:Val)
    74	    => V ==K str(iCons(43, .IntSeq))
    75	       orBool V ==K str(iCons(45, .IntSeq))
    76	       orBool V ==K str(iCons(42, .IntSeq))
    77	       orBool V ==K str(iCons(47, iCons(47, .IntSeq)))
    78	       orBool V ==K str(iCons(42, iCons(42, .IntSeq)))
    79	
    80	  // The second list is the operator list after solution.py has appended "".
    81	  // Validate the current pair before inspecting the tails; this exposes the
    82	  // dynamic Int/Str guards as soon as #iterNext reveals one pair.
    83	  rule validAlgebraLists(
    84	         vCons(V:Val, NR:ValSeq),
    85	         vCons(W:Val, OR:ValSeq))
    86	    => definedProjectInt(V)
    87	       andBool projectIntTotal(V) >=Int 0
    88	       andBool definedProjectStr(W)
    89	       andBool validAlgebraRest(NR, OR, W)
    90	
    91	  rule validAlgebraLists(_:ValSeq, _:ValSeq) => false [owise]
    92	
    93	  // The final pair has two empty tails and requires the appended empty string.
    94	  // A non-final pair requires one of the five prompt operators, then recurses.
    95	  rule validAlgebraRest(.ValSeq, OR:ValSeq, W:Val)
    96	    => OR ==K .ValSeq andBool W ==K str(.IntSeq)
    97	  rule validAlgebraRest(
    98	         vCons(V:Val, NR:ValSeq),
