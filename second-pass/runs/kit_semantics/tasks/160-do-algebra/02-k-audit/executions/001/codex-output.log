@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+set -u
+
+inventory=/audit-output/evidence/05_inventory.txt
+echo "COMMAND: python3 /audit-output/evidence/05_inventory.py > $inventory"
+python3 /audit-output/evidence/05_inventory.py > "$inventory"
+status=$?
+echo "INVENTORY_EXIT_STATUS=$status"
+if (( status != 0 )); then
+  exit "$status"
+fi
+wc -l -c "$inventory"
+sha256sum "$inventory"
+head -n 35 "$inventory"
+rg '^TOTALS|PROOF_LOCAL|RELEVANT_FIXED_RULE_ZERO' "$inventory" | tail -n 80
diff --git a/evidence/05_make_eval_cases.py b/evidence/05_make_eval_cases.py
new file mode 100644
index 0000000000000000000000000000000000000000..bea183cf5c6ae195b602465b2e35263f81b28b70
--- /dev/null
+++ b/evidence/05_make_eval_cases.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Generate bounded concrete K-vs-Python evaluator bridge cases in scratch."""
+
+from __future__ import annotations
+
+import json
+import random
+from pathlib import Path
+
+
+scratch = Path("/tmp/audit-work/160-do-algebra")
+rng = random.Random(0x160E0A1)
+alphabet = ["+", "-", "*", "//", "**"]
+cases: list[tuple[list[str], list[int], int]] = [
+    (["+", "*", "-"], [2, 3, 4, 5], 9),
+    (["**", "**"], [2, 3, 2], 512),
+    (["//"], [7, 3], 2),
+    (["-"], [0, 7], -7),
+]
+
+while len(cases) < 44:
+    count = rng.randint(1, 4)
+    operators = [rng.choice(alphabet) for _ in range(count)]
+    if any(left == right == "**" for left, right in zip(operators, operators[1:])):
+        continue
+    operands = [rng.randint(0, 5) for _ in range(count + 1)]
+    expression = str(operands[0])
+    for operator, operand in zip(operators, operands[1:]):
+        expression += operator + str(operand)
+    try:
+        expected = eval(expression)
+    except ZeroDivisionError:
+        continue
+    cases.append((operators, operands, expected))
+
+source_lines = [
+    "def do_algebra(operator, operand):",
+    '    expression = ""',
+    "    oprn = 0",
+    '    oprt = ""',
+    '    for oprn, oprt in zip(operand, operator + [""]):',
+    "        expression += str(oprn) + oprt",
+    "    return eval(expression)",
+    "",
+]
+expected: dict[str, int] = {}
+inputs: dict[str, dict[str, object]] = {}
+for index, (operators, operands, result) in enumerate(cases):
+    name = f"case_{index:03d}"
+    source_lines.append(f"{name} = do_algebra({operators!r}, {operands!r})")
+    expected[name] = result
+    inputs[name] = {"operators": operators, "operands": operands}
+
+(scratch / "05_eval_cases.py").write_text("\n".join(source_lines) + "\n")
+(scratch / "05_eval_expected.json").write_text(
+    json.dumps(expected, indent=2, sort_keys=True) + "\n"
+)
+Path("/audit-output/evidence/05_eval_inputs.json").write_text(
+    json.dumps(inputs, indent=2, sort_keys=True) + "\n"
+)
+print(f"generated_cases={len(cases)}")
diff --git a/evidence/06_false_mutation.k b/evidence/06_false_mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..4f473c306f6faa7361d881124d5c0ff7cad0176f
--- /dev/null
+++ b/evidence/06_false_mutation.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module AUDIT-FALSE-MUTATION
+  imports VERIFICATION
+
+  // The satisfying input is the documented example; both Python executions
+  // and fresh K execution return 9. This deliberately demands 8.
+  claim [false-answer-eight]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "do_algebra",
+          Params("operator", "operand"),
+          Assign(Name("expression"), Str(""))
+          Assign(Name("oprn"), Int(0))
+          Assign(Name("oprt"), Str(""))
+          For(
+            TupleExpr(Name("oprn"), Name("oprt")),
+            Call(
+              Name("zip"),
+              Name("operand"),
+              BinOp("+", Name("operator"), ListExpr(Str("")))),
+            AugAssign(
+              Name("expression"),
+              "+",
+              BinOp(
+                "+",
+                Call(Name("str"), Name("oprn")),
+                Name("oprt"))))
+          Return(Call(Name("eval"), Name("expression"))))
+        Assign(
+          Name("answer"),
+          Call(
+            Name("do_algebra"),
+            list(vCons(
+              str(iCons(43, .IntSeq)),
+              vCons(
+                str(iCons(42, .IntSeq)),
+                vCons(str(iCons(45, .IntSeq)), .ValSeq)))),
+            list(vCons(2, vCons(3, vCons(4, vCons(5, .ValSeq)))))))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "answer" |-> 8
+        "do_algebra" |-> ?FUNCTION:Val,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
