+printf '\n'
+{
+  printf 'COMMAND:'
+  printf ' %q' "${command[@]}"
+  printf '\n'
+} > "$proof_log"
+"${command[@]}" 2>&1 | tee -a "$proof_log"
+proof_status=${PIPESTATUS[0]}
+printf 'KPROVE_EXIT_STATUS=%d\n' "$proof_status" | tee -a "$proof_log"
