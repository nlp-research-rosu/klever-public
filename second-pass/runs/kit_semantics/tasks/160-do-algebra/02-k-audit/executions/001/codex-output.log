   105	  rule validAlgebraRest(_:ValSeq, _:ValSeq, _:Val) => false [owise]
   106	
   107	  // Exact recurrence of expression += str(oprn) + oprt.
   108	  rule runPairCodes(ACC:IntSeq, .ValSeq, _:ValSeq) => ACC
   109	  rule runPairCodes(
   110	         ACC:IntSeq,
   111	         vCons(_:Val, _:ValSeq),
   112	         .ValSeq)
   113	    => ACC
   114	  rule runPairCodes(
   115	         ACC:IntSeq,
   116	         vCons(V:Val, NR:ValSeq),
   117	         vCons(W:Val, OR:ValSeq))
   118	    => runPairCodes(
