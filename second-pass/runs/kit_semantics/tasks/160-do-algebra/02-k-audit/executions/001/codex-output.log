+floor_boundary = do_algebra(["//"], [7, 3])
+power_boundary = do_algebra(["**"], [2, 0])
+precedence = do_algebra(["+", "*"], [2, 3, 4])
+right_power = do_algebra(["**", "**"], [2, 3, 2])
