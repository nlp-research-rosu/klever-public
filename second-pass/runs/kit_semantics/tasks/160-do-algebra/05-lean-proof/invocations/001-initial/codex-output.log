python3 - <<'PY'
from pathlib import Path
rows=[]
for p in sorted(Path('/workspace/Base/Klean160DoAlgebra').glob('*.lean')):
    namespace=[]
    for n,line in enumerate(p.read_text().splitlines(),1):
        s=line.strip()
        if s.startswith('namespace '): namespace.append(s.split(maxsplit=1)[1])
        elif s.startswith('end ') and namespace: namespace.pop()
        elif s.startswith('axiom '): rows.append((p.name,n,'.'.join(namespace),s))
        elif s.startswith('opaque '): rows.append((p.name,n,'.'.join(namespace),s))
print('generated-base trusted declarations:',len(rows))
from collections import Counter
print('by file:',dict(Counter(x[0] for x in rows)))
print('by namespace:',dict(Counter(x[2] for x in rows)))
for p,n,ns,s in rows: print(f'{p}:{n}:{ns}:{s}')
PY
