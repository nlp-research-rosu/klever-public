diff --git a//tmp/lean-procself.c b//tmp/lean-procself.c
new file mode 100644
index 0000000000000000000000000000000000000000..e2c1a4f0c9e2c07cf9708e25de9206b5690ef757
--- /dev/null
+++ b//tmp/lean-procself.c
@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+static const char *fixed_executable_path(const char *path) {
+  size_t length = strlen(path);
+  if (length > 10 &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return "/proc/self/exe";
+  }
+  return path;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*next_readlink)(const char *, char *, size_t);
+  if (next_readlink == NULL) {
+    next_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  return next_readlink(fixed_executable_path(path), buffer, size);
+}
+
+ssize_t readlinkat(int directory, const char *path, char *buffer, size_t size) {
+  static ssize_t (*next_readlinkat)(int, const char *, char *, size_t);
+  if (next_readlinkat == NULL) {
+    next_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  }
+  return next_readlinkat(directory, fixed_executable_path(path), buffer, size);
+}
