+  | "+", SortVal.inj_SortInt first, SortVal.inj_SortFloat second =>
+      modelFloatValue (modelIntegerAsFloat first + second)
+  | "+", SortVal.inj_SortFloat first, SortVal.inj_SortInt second =>
