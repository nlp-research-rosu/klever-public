+def modelFloatFloorInt (value : SortFloat) : SortInt :=
+  modelFloatToTruncatedInt (Float.floor value)
+
+def modelFloatCeilInt (value : SortFloat) : SortInt :=
+  modelFloatToTruncatedInt (Float.ceil value)
