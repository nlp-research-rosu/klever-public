+#eval smokeInt (modelApplyBin "+" (modelIntValue 7) (modelIntValue 5))
+#eval smokeInt (modelApplyBin "+" (modelIntValue 7) (modelBoolValue true))
+#eval smokeInt (modelApplyBin "%" (modelIntValue (-7)) (modelIntValue 3))
+#eval smokeInt (modelApplyBin "//" (modelIntValue (-7)) (modelIntValue 3))
+#eval smokeInt (modelApplyBin "**" (modelIntValue 2) (modelIntValue 10))
+#eval smokeFloat (modelApplyBin "/" (modelIntValue 7) (modelIntValue 2))
+#eval smokeCodes (modelApplyBin "+" (smokeString "ab") (smokeString "cd"))
+
+#eval smokeInt (modelApplyBuiltin "len" (smokeVals [smokeString "abcd"]))
+#eval smokeInt
+  (modelApplyBuiltin "len"
+    (smokeVals [
+      SortVal.inj_SortIterable
+        (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int»
+          2 11 3)]))
+#eval smokeCodes (modelApplyBuiltin "bin" (smokeVals [modelIntValue (-10)]))
+#eval smokeInt
+  (modelApplyBuiltin "max"
+    (smokeVals [modelIntValue 3, modelIntValue 9, modelIntValue 4]))
+#eval smokeInt
+  (modelApplyBuiltin "int" (smokeVals [smokeString "1234"]))
+#eval smokeInt
+  (modelApplyBuiltin "eval" (smokeVals [smokeString "2+3*4**2"]))
+#eval smokeInt
+  (modelApplyBuiltin "eval" (smokeVals [smokeString "20//3-2"]))
+#eval smokeInt
+  (modelApplyBuiltin "eval" (smokeVals [smokeString "2**3**2"]))
+#eval smokeCodes
+  (modelApplyBuiltin "set" (smokeVals [smokeString "abaca"]))
+#eval smokeInt
+  (modelApplyBuiltin "ord" (smokeVals [smokeString "A"]))
+#eval smokeCodes
+  (modelApplyBuiltin "chr" (smokeVals [modelIntValue 65]))
+#eval smokeIterableKind
+  (modelApplyBuiltin "zip" (smokeVals [smokeString "ab", smokeString "xy"]))
+#eval smokeIterableKind
+  (modelApplyBuiltin "range"
+    (smokeVals [modelIntValue 5, modelIntValue 0, modelIntValue (-2)]))
+#eval smokeBool
+  (modelApplyBuiltin "isinstance"
+    (smokeVals [
+      modelIntValue 5,
+      SortVal.«typeV(_)_MPY-CORE_Val_String» "int"]))
+#eval smokeInt
+  (modelApplyBuiltin "int"
+    (smokeVals [modelFloatValue (-2.9)]))
+#eval smokeInt
+  (modelApplyBuiltin "floor"
+    (smokeVals [modelFloatValue (-2.4)]))
+#eval smokeInt
+  (modelApplyBuiltin "ceil"
+    (smokeVals [modelFloatValue (-2.4)]))
+#eval smokeInt
+  (modelApplyBuiltin "round"
+    (smokeVals [modelFloatValue 2.5]))
+#eval smokeFloat
+  (modelApplyBuiltin "float" (smokeVals [smokeString "-12.25"]))
+#eval smokeFloat
+  (modelApplyBin "**" (modelIntValue 9) (modelFloatValue 0.5))
diff --git a//tmp/lean-procself.c b//tmp/lean-procself.c
new file mode 100644
index 0000000000000000000000000000000000000000..e2c1a4f0c9e2c07cf9708e25de9206b5690ef757
--- /dev/null
+++ b//tmp/lean-procself.c
@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+static const char *fixed_executable_path(const char *path) {
+  size_t length = strlen(path);
+  if (length > 10 &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return "/proc/self/exe";
+  }
+  return path;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*next_readlink)(const char *, char *, size_t);
+  if (next_readlink == NULL) {
+    next_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  return next_readlink(fixed_executable_path(path), buffer, size);
+}
+
+ssize_t readlinkat(int directory, const char *path, char *buffer, size_t size) {
+  static ssize_t (*next_readlinkat)(int, const char *, char *, size_t);
+  if (next_readlinkat == NULL) {
+    next_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  }
+  return next_readlinkat(directory, fixed_executable_path(path), buffer, size);
+}
