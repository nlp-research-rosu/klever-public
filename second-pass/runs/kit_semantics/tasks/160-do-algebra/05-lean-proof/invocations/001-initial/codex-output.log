import json
from pathlib import Path
root=Path('/workspace')
sources=[p for p in root.rglob('*.lean') if 'Base' not in p.parts and '.lake' not in p.parts]
text='\\n'.join(p.read_text(encoding='utf-8') for p in sources)
ob=json.load(open('/workspace/Base/obligation-map.json',encoding='utf-8'))
for item in ob['trust_parameters']:
    name=item['name']
