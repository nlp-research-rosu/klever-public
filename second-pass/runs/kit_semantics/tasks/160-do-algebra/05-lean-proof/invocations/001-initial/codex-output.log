+    0
+  else
+    let significant := (2 ^ 52) + fractionBits
+    let unbiased := exponentBits - 1023
+    let magnitude :=
+      if unbiased ≥ 52 then
+        significant * (2 ^ (unbiased - 52))
+      else
+        significant / (2 ^ (52 - unbiased))
+    let integer := Int.ofNat magnitude
+    if signIsNegative then -integer else integer
