+  | "+", SortVal.inj_SortFloat first, SortVal.inj_SortFloat second =>
+      modelFloatValue (first + second)
+  | "-", SortVal.inj_SortFloat first, SortVal.inj_SortFloat second =>
+      modelFloatValue (first - second)
+  | "*", SortVal.inj_SortFloat first, SortVal.inj_SortFloat second =>
+      modelFloatValue (first * second)
+  | "/", SortVal.inj_SortFloat first, SortVal.inj_SortFloat second =>
+      modelFloatValue (first / second)
+  | "%", SortVal.inj_SortFloat first, SortVal.inj_SortFloat second =>
