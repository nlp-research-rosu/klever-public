+def modelFloorDiv (left right : SortInt) : SortInt :=
+  if right = 0 then
+    0
+  else
+    let quotient := modelTruncDiv left right
+    let remainder := left - quotient * right
+    if remainder = 0 then
+      quotient
+    else if (remainder < 0 ∧ right > 0) ∨
+            (remainder > 0 ∧ right < 0) then
+      quotient - 1
+    else
+      quotient
