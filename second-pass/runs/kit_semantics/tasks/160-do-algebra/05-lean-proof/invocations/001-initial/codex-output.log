+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», accumulator => accumulator
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ rest,
+      accumulator =>
+      modelDecimalScaleLoop rest (accumulator * 10)
