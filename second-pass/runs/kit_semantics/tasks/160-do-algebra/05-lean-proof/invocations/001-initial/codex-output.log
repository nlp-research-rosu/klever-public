+def modelFloatToTruncatedInt (value : SortFloat) : SortInt :=
+  let bits := value.toBits.toNat
+  let signIsNegative := bits / (2 ^ 63) = 1
+  let exponentBits := (bits / (2 ^ 52)) % (2 ^ 11)
+  let fractionBits := bits % (2 ^ 52)
