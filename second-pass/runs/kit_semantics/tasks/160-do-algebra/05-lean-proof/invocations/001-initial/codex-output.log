+def modelPowerPass : List SortString → List SortInt →
+    List SortString × List SortInt
+  | [], numbers => ([], numbers)
+  | _ :: _, [] => ([], [])
+  | operator :: operators, number :: numbers =>
+      let processed := modelPowerPass operators numbers
+      if operator = "**" then
+        match processed.2 with
+        | next :: rest =>
