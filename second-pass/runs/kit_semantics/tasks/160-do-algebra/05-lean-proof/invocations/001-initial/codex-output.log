+        match rest with
+        | 42 :: tail => "**" :: modelTokenOperators tail
+        | _ => "*" :: modelTokenOperators rest
+      else if code = 47 then
+        match rest with
+        | 47 :: tail => "//" :: modelTokenOperators tail
+        | _ => "/" :: modelTokenOperators rest
+      else if code = 43 then
+        "+" :: modelTokenOperators rest
+      else if code = 45 then
+        "-" :: modelTokenOperators rest
