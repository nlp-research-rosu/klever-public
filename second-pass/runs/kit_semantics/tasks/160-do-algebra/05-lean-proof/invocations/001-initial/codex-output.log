if rg -n \"("'^|[''^A-Za-z])(sorry|admit|unsafe|axiom|opaque)([''^A-Za-z]|$)" /workspace/Proof.lean /workspace/Proof --glob '"'*.lean'; then exit 1; else echo 'writable forbidden-token audit: PASS'; fi
