+def modelIntSeqToList : SortIntSeq → List SortInt
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => []
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head rest =>
+      head :: modelIntSeqToList rest
