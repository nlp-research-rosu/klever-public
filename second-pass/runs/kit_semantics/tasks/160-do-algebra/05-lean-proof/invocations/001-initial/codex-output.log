+  if digits < 0 then
+    none
+  else
+    let scaleInt := modelIntegerPower 10 digits
+    let scale := modelIntegerAsFloat scaleInt
+    some (modelIntegerAsFloat (modelRoundFloat (value * scale)) / scale)
