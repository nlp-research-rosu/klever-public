+def modelTokenOperatorsFuel : Nat → List SortInt → List SortString
+  | 0, _ => []
+  | _ + 1, [] => []
+  | fuel + 1, 32 :: rest => modelTokenOperatorsFuel fuel rest
+  | fuel + 1, code :: rest =>
+      if modelIsDigit code then
+        modelTokenOperatorsFuel fuel rest
+      else if code = 42 then
