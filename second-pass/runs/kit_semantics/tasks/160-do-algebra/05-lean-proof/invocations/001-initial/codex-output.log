+def modelLevelPass (level : SortString)
+    (input : List SortString × List SortInt) :
+    List SortString × List SortInt :=
+  match input.2 with
+  | [] => (input.1, [])
+  | number :: numbers =>
+      modelLevelLoop level number input.1 numbers [] []
