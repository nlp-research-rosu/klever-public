index 0000000000000000000000000000000000000000..f4e782f4e7e72906a582473b09098b1442960368
--- /dev/null
+++ b/evidence/04_producer-authentication.txt
@@ -0,0 +1,56 @@
+COMMAND
+env PYTHONPATH=/reference python3 - <<'PY'
+import hashlib, json
+from pathlib import Path
+from tools.audit_contract import sha256_tree
+bundle = Path("/reference/generation-tools")
+generation = Path("/reference/klean-generation")
+audit = json.loads(Path("/audit-input.json").read_text())["resolution"]
+generator = json.loads((generation / "generator-manifest.json").read_text())
+source = json.loads((bundle / "source-manifest.json").read_text())
+observed = {
+    "klean_export.py": hashlib.sha256((bundle / "klean_export.py").read_bytes()).hexdigest(),
+    "klean.py": hashlib.sha256((bundle / "klean.py").read_bytes()).hexdigest(),
+}
+print(f"observed_exporter_sha256={observed['klean_export.py']}")
+print(f"generator_exporter_sha256={generator['exporter_sha256']}")
+print(f"source_manifest_exporter_sha256={source['files']['klean_export.py']}")
+print(f"exporter_all_match={observed['klean_export.py'] == generator['exporter_sha256'] == source['files']['klean_export.py']}")
+print(f"observed_klean_py_sha256={observed['klean.py']}")
+print(f"generator_klean_py_sha256={generator['klean_py_sha256']}")
+print(f"source_manifest_klean_py_sha256={source['files']['klean.py']}")
+print(f"klean_py_all_match={observed['klean.py'] == generator['klean_py_sha256'] == source['files']['klean.py']}")
+generator_image = generator["provenance"]["generator_image_id"]
+print(f"generator_image_id={generator_image}")
+print(f"source_manifest_image_id={source['generator_image_id']}")
+print(f"audit_input_bundle_path={audit['generation_producer_sources']}")
+print(f"image_matches_source_manifest={generator_image == source['generator_image_id']}")
+print(f"image_matches_audit_bundle_path={audit['generation_producer_sources'].endswith(generator_image.removeprefix('sha256:'))}")
+tree = sha256_tree(bundle)
+print(f"observed_producer_tree_sha256={tree}")
+print(f"audit_input_producer_tree_sha256={audit['hashes']['generation_producer_sources_sha256']}")
+print(f"producer_tree_matches_audit_input={tree == audit['hashes']['generation_producer_sources_sha256']}")
+print(f"bundle_regular_files={sorted(p.relative_to(bundle).as_posix() for p in bundle.iterdir() if p.is_file())}")
+PY
+
+OUTPUT
