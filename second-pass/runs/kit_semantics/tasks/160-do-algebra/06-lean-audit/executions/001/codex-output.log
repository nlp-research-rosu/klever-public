+33-35 rule-0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43 DOMAIN_LEMMA attrs=['simplification']
+36-38 rule-0dda33275c7cbd1779ea25ffe3285879bf6652eca3210dd703138ffe06f5bf83 DOMAIN_LEMMA attrs=['simplification']
+40-42 rule-ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0 DEFINITION attrs=['concrete', 'simplification(10)', 'preserves-definedness']
+43-45 rule-22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d DEFINITION attrs=['symbolic(V)', 'simplification', 'preserves-definedness']
