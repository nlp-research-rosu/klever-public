diff --git a/evidence/07_stage5-clean-build.txt b/evidence/07_stage5-clean-build.txt
new file mode 100644
index 0000000000000000000000000000000000000000..63cb8d7c7b8f80733143be3f0845bc41899af0ee
--- /dev/null
+++ b/evidence/07_stage5-clean-build.txt
@@ -0,0 +1,45 @@
+COMMAND
+audit_stage5_dir=$(mktemp -d /tmp/audit-work/stage5-audit.XXXXXX)
+cp -a /candidate/. "$audit_stage5_dir"/
+cp -a /reference/klean-generation/generated/. "$audit_stage5_dir"/Base/
+printf 'FRESH_WORKSPACE=%s\n' "$audit_stage5_dir"
+printf '%s\n' 'COMMAND: lake clean'
+(
+  cd "$audit_stage5_dir"
+  env ELAN_HOME=/opt/elan LD_PRELOAD=/tmp/audit-work/proc-exe-shim.so lake clean
+)
+clean_status=$?
+printf 'LAKE_CLEAN_EXIT=%s\n' "$clean_status"
+printf '%s\n' 'COMMAND: lake build'
+(
+  cd "$audit_stage5_dir"
+  env ELAN_HOME=/opt/elan LD_PRELOAD=/tmp/audit-work/proc-exe-shim.so lake build
+)
+build_status=$?
+printf 'LAKE_BUILD_EXIT=%s\n' "$build_status"
