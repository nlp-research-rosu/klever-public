index 0000000000000000000000000000000000000000..a26fb6b03fca35731d473a9830329389d03fee5d
--- /dev/null
+++ b/evidence/10_operational-adversarial-tests.txt
@@ -0,0 +1,42 @@
+COMMAND
+env ELAN_HOME=/opt/elan LD_PRELOAD=/tmp/audit-work/proc-exe-shim.so lake env lean OperationalAudit.lean
+
+WORKDIR
+/tmp/audit-work/stage5-audit.HfRJIU
+
+EXIT_CODE
+0
+
+COMPLETE_STDOUT_STDERR
+"-120"
+"0"
+[45, 49, 50, 48]
+[65, 66]
+true
+false
+true
+-7
+[65, 66, 43, 42]
+[45, 49, 50, 48]
+[49, 50, 43, 51]
+true
+false
+true
+false
+false
+false
+false
+
+INTERPRETATION OF OUTPUT ORDER
+The first fourteen lines exercise negative/zero integer formatting, ASCII
+conversion, string-code projection, both constructor guards, integer total
+projection on its guarded domain, sequence concatenation, the str built-in,
+string addition, and both K-cast projections.  The final four `false` values
+show that constant Int2String, constant codesProject, left-identity
+seqConcat, and constant-none applyBuiltin counterfactuals are observationally
+different on relevant inputs.  The compiled final example additionally proves
+that an always-failing Int projection cannot satisfy the first cast lemma when
+paired with the correct constructor guard.
+
+SOURCE
+/tmp/audit-work/stage5-audit.HfRJIU/OperationalAudit.lean

diff --git a//tmp/audit-work/proc-exe-shim.c b//tmp/audit-work/proc-exe-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..f3d7c8a69be779e82d72582931188e1a109306ac
--- /dev/null
+++ b//tmp/audit-work/proc-exe-shim.c
@@ -0,0 +1,36 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t length;
+    size_t index;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    length = strlen(path);
+    if (length <= (sizeof(prefix) - 1) + (sizeof(suffix) - 1) ||
+        strcmp(path + length - (sizeof(suffix) - 1), suffix) != 0) {
+        return 0;
+    }
+    for (index = sizeof(prefix) - 1;
+         index < length - (sizeof(suffix) - 1);
+         ++index) {
+        if (!isdigit((unsigned char)path[index])) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    const char *resolved = is_proc_pid_exe(path) ? "/proc/self/exe" : path;
+    return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}
