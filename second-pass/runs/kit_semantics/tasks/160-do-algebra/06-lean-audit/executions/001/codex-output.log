diff --git a/evidence/06_stage4-structural-independent.txt b/evidence/06_stage4-structural-independent.txt
new file mode 100644
index 0000000000000000000000000000000000000000..0d6e195b7c0d217470ebdb558b11e7b9c9e2ac4a
--- /dev/null
+++ b/evidence/06_stage4-structural-independent.txt
@@ -0,0 +1,84 @@
+COMMAND
+env PYTHONPATH=/reference python3 - <<'PY'
+import hashlib, json
+from pathlib import Path
+from tools.k_rule_inventory import inventory_verification
+from tools.klean_export import target_statement, tree_digest
+from tools.pipeline_contract import sha256_tree
+workspace = Path("/reference/k-proof")
+generation = Path("/reference/klean-generation")
+generated = generation / "generated"
+inventory = inventory_verification(workspace)
+discovery = json.loads(Path("/reference/lemma-discovery.json").read_text())
+obmap_path = generated / "obligation-map.json"
+obmap = json.loads(obmap_path.read_text())
+generator = json.loads((generation / "generator-manifest.json").read_text())
+input_manifest = json.loads((generation / "input-manifest.json").read_text())
+audit = json.loads(Path("/audit-input.json").read_text())["resolution"]
+domain_ids = [entry["source_rule_id"] for entry in discovery["rules"] if entry["classification"] == "DOMAIN_LEMMA"]
+obligation_ids = [entry["source_rule_id"] for entry in obmap["obligations"]]
+source_ids = [entry["source_rule_id"] for entry in obmap["source_rules"]]
+inventory_by_id = {entry["source_rule_id"]: entry for entry in inventory["rules"]}
+print(f"domain_ids={domain_ids}")
+print(f"obligation_ids={obligation_ids}")
+print(f"source_ids={source_ids}")
+print(f"exact_ordered_bijection={domain_ids == obligation_ids == source_ids}")
+print(f"no_duplicate_obligations={len(obligation_ids) == len(set(obligation_ids))}")
+print(f"source_metadata_exact={all(obmap['source_rules'][i]['text'] == inventory_by_id[rid]['text'] and obmap['source_rules'][i]['start_line'] == inventory_by_id[rid]['start_line'] and obmap['source_rules'][i]['end_line'] == inventory_by_id[rid]['end_line'] and obmap['source_rules'][i]['normalized_sha256'] == inventory_by_id[rid]['normalized_sha256'] for i,rid in enumerate(source_ids))}")
+print(f"conjunct_hashes_exact={all(hashlib.sha256(ob['lean_conjunct'].encode()).hexdigest() == ob['lean_conjunct_sha256'] for ob in obmap['obligations'])}")
+print(f"obligation_map_sha256={hashlib.sha256(obmap_path.read_bytes()).hexdigest()}")
+print(f"manifest_obligation_map_sha256={generator['obligation_map_sha256']}")
+print(f"obligation_map_hash_match={hashlib.sha256(obmap_path.read_bytes()).hexdigest() == generator['obligation_map_sha256']}")
+observed_target = target_statement(generated)
+print(f"observed_target={json.dumps(observed_target, sort_keys=True)}")
+print(f"target_matches_generator={observed_target == generator['target']}")
+print(f"target_matches_audit_input={observed_target == audit['target']}")
+print(f"target_matches_audit_preflight={observed_target == audit['stage4_preflight']['target']}")
+observed_generated = tree_digest(generated)
+print(f"observed_generated_tree_sha256={observed_generated}")
+print(f"generated_tree_matches_generator={observed_generated == generator['generated_tree_sha256']}")
+print(f"generated_tree_matches_audit={observed_generated == audit['hashes']['generated_tree_sha256']}")
+observed_generation = sha256_tree(generation)
+print(f"observed_generation_tree_sha256={observed_generation}")
+print(f"generation_tree_matches_audit={observed_generation == audit['hashes']['klean_generation_sha256']}")
+print(f"stage1_tree_sha256={tree_digest(workspace)}")
+print(f"stage1_tree_matches_input_manifest={tree_digest(workspace) == input_manifest['stage1_workspace_sha256']}")
+print(f"nonempty_domain_set={bool(domain_ids)}")
+print(f"export_status={json.loads((generation / 'export-result.json').read_text())['status']}")
+print("obligations:")
+for obligation in obmap["obligations"]:
+    print(f"{obligation['source_rule_id']} :: {obligation['lean_conjunct']}")
+PY
+
+OUTPUT
