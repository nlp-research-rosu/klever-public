Module(
  FuncDef("do_algebra", Params("operator", "operand"),
    Assign(Name("expression"), Str(""))
    Assign(Name("oprn"), Int(0))
    Assign(Name("oprt"), Str(""))
    For(TupleExpr(Name("oprn"), Name("oprt")), Call(
      Name("zip"),
      Name("operand"),
      BinOp("+", Name("operator"), ListExpr(Str("")))),
      AugAssign(
        Name("expression"),
        "+",
        BinOp("+", Call(Name("str"), Name("oprn")), Name("oprt"))))
    Return(Call(Name("eval"), Name("expression")))))
