+             codesProject(W))),
+         NR,
+         OR)
+
+  rule lastPairValue(
+         vCons(V:Val, .ValSeq),
+         _:ValSeq)
+    => V
+  rule lastPairValue(
+         vCons(_:Val, NR:ValSeq),
+         vCons(_:Val, OR:ValSeq))
+    => lastPairValue(NR, OR)
+    requires validAlgebraLists(NR, OR)
+    [simplification]
+  rule lastPairValue(_:ValSeq, _:ValSeq) => noneV [owise]
+endmodule

