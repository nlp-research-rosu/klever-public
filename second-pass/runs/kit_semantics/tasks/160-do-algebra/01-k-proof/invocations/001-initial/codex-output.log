diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..620ba20d65c8008dab0b3e4c77822d6b2af93db0
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,76 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  // A value of this sort represents both input lists at once.  algLast(N)
+  // contributes the final operand; every other constructor contributes one
+  // operand, one operator, and the recursively represented suffix.
+  syntax AlgInput ::= algLast(Int)
+                    | algAdd(Int, AlgInput)
+                    | algSub(Int, AlgInput)
+                    | algMul(Int, AlgInput)
+                    | algDiv(Int, AlgInput)
+                    | algPow(Int, AlgInput)
+
+  syntax ValSeq ::= algOperands(AlgInput)  [function, total]
+                  | algOperators(AlgInput) [function, total]
+  syntax Bool ::= nonNegative(AlgInput) [function, total]
+  syntax Int ::= lastNumber(AlgInput) [function, total]
+  syntax IntSeq ::= runCodes(IntSeq, AlgInput) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule algOperands(algLast(N:Int))   => vCons(N, .ValSeq)
+  rule algOperands(algAdd(N, R))     => vCons(N, algOperands(R))
+  rule algOperands(algSub(N, R))     => vCons(N, algOperands(R))
+  rule algOperands(algMul(N, R))     => vCons(N, algOperands(R))
+  rule algOperands(algDiv(N, R))     => vCons(N, algOperands(R))
+  rule algOperands(algPow(N, R))     => vCons(N, algOperands(R))
+
+  rule algOperators(algLast(_:Int))  => .ValSeq
+  rule algOperators(algAdd(_, R))    => vCons(str(iCons(43, .IntSeq)), algOperators(R))
+  rule algOperators(algSub(_, R))    => vCons(str(iCons(45, .IntSeq)), algOperators(R))
+  rule algOperators(algMul(_, R))    => vCons(str(iCons(42, .IntSeq)), algOperators(R))
+  rule algOperators(algDiv(_, R))    => vCons(str(iCons(47, iCons(47, .IntSeq))), algOperators(R))
+  rule algOperators(algPow(_, R))    => vCons(str(iCons(42, iCons(42, .IntSeq))), algOperators(R))
+
+  rule nonNegative(algLast(N:Int)) => N >=Int 0
+  rule nonNegative(algAdd(N, R))   => N >=Int 0 andBool nonNegative(R)
+  rule nonNegative(algSub(N, R))   => N >=Int 0 andBool nonNegative(R)
+  rule nonNegative(algMul(N, R))   => N >=Int 0 andBool nonNegative(R)
+  rule nonNegative(algDiv(N, R))   => N >=Int 0 andBool nonNegative(R)
+  rule nonNegative(algPow(N, R))   => N >=Int 0 andBool nonNegative(R)
+
+  rule lastNumber(algLast(N:Int)) => N
+  rule lastNumber(algAdd(_, R))   => lastNumber(R)
+  rule lastNumber(algSub(_, R))   => lastNumber(R)
+  rule lastNumber(algMul(_, R))   => lastNumber(R)
+  rule lastNumber(algDiv(_, R))   => lastNumber(R)
+  rule lastNumber(algPow(_, R))   => lastNumber(R)
+
+  // runCodes(ACC, A) is the exact left-to-right string accumulator produced
+  // by the loop, starting with the already-produced character codes ACC.
+  rule runCodes(ACC:IntSeq, algLast(N:Int))
+    => seqConcat(ACC, strToCodes(Int2String(N)))
+  rule runCodes(ACC:IntSeq, algAdd(N:Int, R:AlgInput))
+    => runCodes(seqConcat(ACC,
+                 seqConcat(strToCodes(Int2String(N)), iCons(43, .IntSeq))), R)
+  rule runCodes(ACC:IntSeq, algSub(N:Int, R:AlgInput))
+    => runCodes(seqConcat(ACC,
+                 seqConcat(strToCodes(Int2String(N)), iCons(45, .IntSeq))), R)
+  rule runCodes(ACC:IntSeq, algMul(N:Int, R:AlgInput))
+    => runCodes(seqConcat(ACC,
+                 seqConcat(strToCodes(Int2String(N)), iCons(42, .IntSeq))), R)
+  rule runCodes(ACC:IntSeq, algDiv(N:Int, R:AlgInput))
+    => runCodes(seqConcat(ACC,
+                 seqConcat(strToCodes(Int2String(N)),
+                           iCons(47, iCons(47, .IntSeq)))), R)
+  rule runCodes(ACC:IntSeq, algPow(N:Int, R:AlgInput))
+    => runCodes(seqConcat(ACC,
+                 seqConcat(strToCodes(Int2String(N)),
+                           iCons(42, iCons(42, .IntSeq)))), R)
+endmodule

