reference-semantics/semantics/list.k-4-  imports MPY-CORE
reference-semantics/semantics/list.k-5-  imports MPY-ITER
reference-semantics/semantics/list.k-6-  imports MPY-OPERATORS
reference-semantics/semantics/list.k-7-
reference-semantics/semantics/list.k-8-  // ==== iteration (the iterator protocol's list case) =======================
reference-semantics/semantics/list.k-9-  rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>
reference-semantics/semantics/list.k-10-  rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>
reference-semantics/semantics/list.k-11-
reference-semantics/semantics/list.k-12-  // ==== ListExpr: [...] literal -> a fresh heap object =======================
reference-semantics/semantics/list.k-13-  syntax ApplyK ::= "toList"
reference-semantics/semantics/list.k:14:  rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>
reference-semantics/semantics/list.k-15-  rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>
reference-semantics/semantics/list.k-16-
reference-semantics/semantics/list.k-17-  // ==== list ops: + / == / != ===============================================
reference-semantics/semantics/list.k-18-  syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]
reference-semantics/semantics/list.k-19-  rule valSeqConcat(.ValSeq, T:ValSeq)                => T
reference-semantics/semantics/list.k-20-  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))
reference-semantics/semantics/list.k-21-
reference-semantics/semantics/list.k-22-  // list + list constructs a NEW object (k-cell — it allocates; operands land here
reference-semantics/semantics/list.k-23-  // already deref'd). priority(45) beats the generic BinOp dispatch.
reference-semantics/semantics/list.k-24-  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
reference-semantics/semantics/list.k-25-       [priority(45)]
