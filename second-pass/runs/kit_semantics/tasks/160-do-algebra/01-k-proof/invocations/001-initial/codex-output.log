+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "expression" |-> (str(ACC:IntSeq) => str(runCodes(ACC, algLast(N))))
+        "oprn" |-> (OLDN:Val => N)
+        "oprt" |-> (OLDO:Val => str(.IntSeq))
+        "operator" |-> OPERATOR:Val
+        "operand" |-> OPERAND:Val,
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0
+
+  claim [algebra-loop-add]:
+    <k>
+      #loop(
+        zipObj(
+          vCons(N:Int, algOperands(R:AlgInput)),
+          vCons(
+            str(iCons(43, .IntSeq)),
+            valSeqConcat(algOperators(R), vCons(str(.IntSeq), .ValSeq)))),
+        TupleExpr(Name("oprn"), Name("oprt")),
+        AugAssign(
+          Name("expression"),
+          "+",
+          BinOp("+", Call(Name("str"), Name("oprn")), Name("oprt"))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "expression" |-> (str(ACC:IntSeq) => str(runCodes(ACC, algAdd(N, R))))
+        "oprn" |-> (OLDN:Val => lastNumber(R))
+        "oprt" |-> (OLDO:Val => str(.IntSeq))
+        "operator" |-> OPERATOR:Val
+        "operand" |-> OPERAND:Val,
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0 andBool nonNegative(R)
+
+  claim [algebra-loop-sub]:
