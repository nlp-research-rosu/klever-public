+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [algebra-loop]:
+    <k>
+      #loop(
+        zipObj(NUMBERS:ValSeq, OPERATIONS:ValSeq),
+        TupleExpr(Name("oprn"), Name("oprt")),
