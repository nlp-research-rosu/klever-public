diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a0fdb67dfbf70df4c9906c34e89db5052a9a6dfd
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,95 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [algebra-loop]:
+    <k>
+      #loop(
+        zipObj(
+          algOperands(A:AlgInput),
+          valSeqConcat(
+            algOperators(A),
+            vCons(str(.IntSeq), .ValSeq))),
+        TupleExpr(Name("oprn"), Name("oprt")),
+        AugAssign(
+          Name("expression"),
+          "+",
+          BinOp(
+            "+",
+            Call(Name("str"), Name("oprn")),
+            Name("oprt"))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "expression" |-> (str(ACC:IntSeq) => str(runCodes(ACC, A)))
+        "oprn" |-> (OLDN:Val => lastNumber(A))
+        "oprt" |-> (OLDO:Val => str(.IntSeq))
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    requires nonNegative(A)
+
+  claim [do-algebra]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "do_algebra",
+          Params("operator", "operand"),
+          Assign(Name("expression"), Str(""))
+          Assign(Name("oprn"), Int(0))
+          Assign(Name("oprt"), Str(""))
+          For(
+            TupleExpr(Name("oprn"), Name("oprt")),
+            Call(
+              Name("zip"),
+              Name("operand"),
+              BinOp("+", Name("operator"), ListExpr(Str("")))),
+            AugAssign(
+              Name("expression"),
+              "+",
+              BinOp(
+                "+",
+                Call(Name("str"), Name("oprn")),
+                Name("oprt"))))
+          Return(Call(Name("eval"), Name("expression"))))
+        Assign(
+          Name("answer"),
+          Call(
+            Name("do_algebra"),
+            list(algOperators(A:AlgInput)),
+            list(algOperands(A)))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "answer" |-> evalArith(runCodes(.IntSeq, A))
+        "do_algebra" |-> ?FUNCTION:Val,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(str(.IntSeq), .ValSeq))
+      1 |-> list(valSeqConcat(
+                   algOperators(A),
+                   vCons(str(.IntSeq), .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires nonNegative(A)
+endmodule
