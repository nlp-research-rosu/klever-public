+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [algebra-loop]:
+    <k>
+      #loop(
+        zipObj(
+          algOperands(A:AlgInput),
+          valSeqConcat(
+            algOperators(A),
+            vCons(str(.IntSeq), .ValSeq))),
+        TupleExpr(Name("oprn"), Name("oprt")),
+        AugAssign(
+          Name("expression"),
+          "+",
+          BinOp(
+            "+",
+            Call(Name("str"), Name("oprn")),
+            Name("oprt"))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "expression" |-> (str(ACC:IntSeq) => str(runCodes(ACC, A)))
+        "oprn" |-> (OLDN:Val => lastNumber(A))
+        "oprt" |-> (OLDO:Val => str(.IntSeq))
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    requires nonNegative(A)
+
+  claim [do-algebra]:
+    <k>
+      #loadAll(Module(
+        FuncDef(
+          "do_algebra",
+          Params("operator", "operand"),
+          Assign(Name("expression"), Str(""))
+          Assign(Name("oprn"), Int(0))
+          Assign(Name("oprt"), Str(""))
+          For(
+            TupleExpr(Name("oprn"), Name("oprt")),
+            Call(
+              Name("zip"),
+              Name("operand"),
+              BinOp("+", Name("operator"), ListExpr(Str("")))),
+            AugAssign(
+              Name("expression"),
+              "+",
+              BinOp(
+                "+",
+                Call(Name("str"), Name("oprn")),
+                Name("oprt"))))
+          Return(Call(Name("eval"), Name("expression")))))
+      ~> Call(
+           Name("do_algebra"),
+           list(algOperators(A:AlgInput)),
+           list(algOperands(A)))
+      => evalArith(runCodes(.IntSeq, A))
+    </k>
+    <env> 0 => ?FINALENV:Int </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?FINALSCOPELOC:Int </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List => ?FINALSTACK:List </stack>
+    <ret> noRet => ?FINALRET:RetState </ret>
+    <exc> NoExc => ?FINALEXC:Exc </exc>
