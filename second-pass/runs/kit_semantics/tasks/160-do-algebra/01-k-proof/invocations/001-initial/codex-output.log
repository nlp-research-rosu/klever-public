--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def do_algebra(operator, operand):
+    expression = ""
+    for oprt, oprn in zip(operator, operand):
+        expression += str(oprn) + oprt
+    expression += str(operand[-1])
+    return eval(expression)

