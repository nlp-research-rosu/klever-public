{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "Base equation defining allInts on the empty ValSeq; it introduces the empty case of a structural domain predicate.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 9,
      "text": "  rule allInts(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "rationale": "Recursive equation defining allInts on a cons cell by testing the head and descending on the tail.",
      "source_rule_id": "rule-bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "start_line": 10,
      "text": "  rule allInts(vCons(V:Val, R:ValSeq))\n    => isInt(V) andBool allInts(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "38cfa4bf2f3dd7588be3d91e547763ed83038a95b0216bd1dd9dfa9acbfe36eb",
      "rationale": "Guarded defining equation for stepMax in the branch where the new integer exceeds the current maximum.",
      "source_rule_id": "rule-38cfa4bf2f3dd7588be3d91e547763ed83038a95b0216bd1dd9dfa9acbfe36eb",
      "start_line": 18,
      "text": "  rule stepMax(M:Int, I:Int) => I requires I >Int M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "8011c32c49e9af8ddd0dcda75effe78567fa6a38f1d2dba1f1b6b34cfffe7908",
      "rationale": "Complementary guarded defining equation for stepMax when the new integer does not exceed the current maximum.",
      "source_rule_id": "rule-8011c32c49e9af8ddd0dcda75effe78567fa6a38f1d2dba1f1b6b34cfffe7908",
      "start_line": 19,
      "text": "  rule stepMax(M:Int, I:Int) => M requires I <=Int M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "100c365a0a34fa6bab18ccf1b55cf5268c6a0f5a224586e56e071b51222694e9",
      "rationale": "Base equation defining rollAcc on an empty remaining sequence as the accumulated result.",
      "source_rule_id": "rule-100c365a0a34fa6bab18ccf1b55cf5268c6a0f5a224586e56e071b51222694e9",
      "start_line": 24,
      "text": "  rule rollAcc(A:ValSeq, _:Int, .ValSeq) => A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "f50a5281c2540ae8a838a20f2b3ace24e1d046d0c78717c1a0620e635c1645f0",
      "rationale": "Recursive rollAcc equation that appends the next prefix maximum and descends on the remaining sequence.",
      "source_rule_id": "rule-f50a5281c2540ae8a838a20f2b3ace24e1d046d0c78717c1a0620e635c1645f0",
      "start_line": 25,
      "text": "  rule rollAcc(A:ValSeq, M:Int, vCons(I:Int, R:ValSeq))\n    => rollAcc(\n         valSeqConcat(A, vCons(stepMax(M, I), .ValSeq)),\n         stepMax(M, I),\n         R)"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "4c672f030e2b7ff039feb3d395bc80c16b5feda2164874a2442e92bbabeb6665",
      "rationale": "Owise totalization equation defining rollAcc for a non-Int head outside the intended allInts domain.",
      "source_rule_id": "rule-4c672f030e2b7ff039feb3d395bc80c16b5feda2164874a2442e92bbabeb6665",
      "start_line": 30,
      "text": "  rule rollAcc(A:ValSeq, _:Int, vCons(_:Val, _:ValSeq)) => A [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "a3e6dfb392eba1c782af8286f6cafcab1e5d931c36b34bf442e91a0427e459cc",
      "rationale": "Base equation defining the rollingMax summary of an empty sequence.",
      "source_rule_id": "rule-a3e6dfb392eba1c782af8286f6cafcab1e5d931c36b34bf442e91a0427e459cc",
      "start_line": 33,
      "text": "  rule rollingMax(.ValSeq) => .ValSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "22140a7ee068b1883d1842ca4a4ed4b8d4ad976228e6e6b0ee13850927d19ac0",
      "rationale": "Defining equation reducing rollingMax of a nonempty integer sequence to rollAcc seeded by its head.",
      "source_rule_id": "rule-22140a7ee068b1883d1842ca4a4ed4b8d4ad976228e6e6b0ee13850927d19ac0",
      "start_line": 34,
      "text": "  rule rollingMax(vCons(H:Int, T:ValSeq))\n    => rollAcc(.ValSeq, H, vCons(H, T))"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "17d7789362fe61b41a4242ac87b79abda9724ee267d969e7074ea8e320a8b0c1",
      "rationale": "Owise totalization equation defining rollingMax for a non-Int head outside the proved input domain.",
      "source_rule_id": "rule-17d7789362fe61b41a4242ac87b79abda9724ee267d969e7074ea8e320a8b0c1",
      "start_line": 36,
      "text": "  rule rollingMax(vCons(_:Val, _:ValSeq)) => .ValSeq [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 40,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "19afab3fc278479ae17705e2d93c69134f1d7a3ab375c214bd20f3aac210fe6f",
      "rationale": "Base equation defining foldMax on an empty remaining sequence.",
      "source_rule_id": "rule-19afab3fc278479ae17705e2d93c69134f1d7a3ab375c214bd20f3aac210fe6f",
      "start_line": 40,
      "text": "  rule foldMax(M:Int, .ValSeq) => M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 42,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "f2af33f382a93ff15ba9dc47cd9aa1377898de1ad808c6a144631b7fe17ffaab",
      "rationale": "Recursive equation defining foldMax by applying stepMax and descending on the tail.",
      "source_rule_id": "rule-f2af33f382a93ff15ba9dc47cd9aa1377898de1ad808c6a144631b7fe17ffaab",
      "start_line": 41,
      "text": "  rule foldMax(M:Int, vCons(I:Int, R:ValSeq))\n    => foldMax(stepMax(M, I), R)"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "444ab56e74feabbf50ac34017c6dd2906040de2ee638a642ce947afe9ada73ac",
      "rationale": "Owise totalization equation defining foldMax for a non-Int head outside the allInts domain.",
      "source_rule_id": "rule-444ab56e74feabbf50ac34017c6dd2906040de2ee638a642ce947afe9ada73ac",
      "start_line": 43,
      "text": "  rule foldMax(M:Int, vCons(_:Val, _:ValSeq)) => M [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 46,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "c18bb726a13b6fb3ece8c34f1491474eb184d29f0dabea331f952c052b1c8327",
      "rationale": "Base equation defining lastOr to retain its default when no elements remain.",
      "source_rule_id": "rule-c18bb726a13b6fb3ece8c34f1491474eb184d29f0dabea331f952c052b1c8327",
      "start_line": 46,
      "text": "  rule lastOr(D:Int, .ValSeq) => D"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "8a4fce0353dde64fc4ad8b8a1b6e8d7370a68523371c2e54426cd101cc18be56",
      "rationale": "Recursive equation defining lastOr by retaining the current head and descending on the tail.",
      "source_rule_id": "rule-8a4fce0353dde64fc4ad8b8a1b6e8d7370a68523371c2e54426cd101cc18be56",
      "start_line": 47,
      "text": "  rule lastOr(_:Int, vCons(I:Int, R:ValSeq)) => lastOr(I, R)"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 48,
      "module": "VERIFICATION-SUMMARIES",
      "normalized_sha256": "b682bd263dbab3b24f01204a6e7747d98c518c1f46915985e2ccf8588d9d1564",
      "rationale": "Owise totalization equation defining lastOr for a non-Int head outside the allInts domain.",
      "source_rule_id": "rule-b682bd263dbab3b24f01204a6e7747d98c518c1f46915985e2ccf8588d9d1564",
      "start_line": 48,
      "text": "  rule lastOr(D:Int, vCons(_:Val, _:ValSeq)) => D [owise]"
    }
  ],
