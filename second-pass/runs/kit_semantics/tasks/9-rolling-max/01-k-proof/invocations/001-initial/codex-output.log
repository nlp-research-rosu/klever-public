+        "number"  |-> (D:Int => lastOr(D, IS))
+        "numbers" |-> list(ORIGINAL:ValSeq)
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> BUILTINS:Scope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
