/bin/bash -lc "sed -n '1,180p' reference-semantics/semantics/list.k; sed -n '1,240p' reference-semantics/semantics/methods.k; sed -n '1,180p' reference-semantics/semantics/subscript.k; sed -n '1,140p' reference-semantics/semantics/operators.k; sed -n '1,120p' reference-semantics/semantics/int.k; sed -n '1,120p' reference-semantics/semantics/bool.k; sed -n '1,100p' reference-semantics/semantics/iter.k; sed -n '1,120p' reference-semantics/semantics/concrete.k" in /workspace
