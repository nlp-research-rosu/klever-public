requires "reference-semantics/semantics.k"

module VERIFICATION-SUMMARIES
  imports MPY
  imports INT

  // Embed every finite IntSeq as an MPY list payload.
  syntax ValSeq ::= intVals(IntSeq) [function, total]
  rule intVals(.IntSeq) => .ValSeq
  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))

  // Execute the mathematical rolling-maximum fold while accumulating the
  // already-produced prefix exactly as list.append does.
  syntax ValSeq ::= rollAcc(ValSeq, Int, IntSeq) [function, total]
  rule rollAcc(A:ValSeq, _:Int, .IntSeq) => A
  rule rollAcc(A:ValSeq, M:Int, iCons(I:Int, R:IntSeq))
    => rollAcc(
         valSeqConcat(A, vCons(maxInt(M, I), .ValSeq)),
         maxInt(M, I),
         R)

  syntax ValSeq ::= rollingMax(IntSeq) [function, total]
  rule rollingMax(.IntSeq) => .ValSeq
  rule rollingMax(iCons(H:Int, T:IntSeq))
    => rollAcc(.ValSeq, H, iCons(H, T))

  // Final scalar locals of the source for-loop.
  syntax Int ::= foldMax(Int, IntSeq) [function, total]
  rule foldMax(M:Int, .IntSeq) => M
  rule foldMax(M:Int, iCons(I:Int, R:IntSeq))
    => foldMax(maxInt(M, I), R)

  syntax Int ::= lastOr(Int, IntSeq) [function, total]
  rule lastOr(D:Int, .IntSeq) => D
  rule lastOr(_:Int, iCons(I:Int, R:IntSeq)) => lastOr(I, R)
endmodule

module VERIFICATION
  imports VERIFICATION-SUMMARIES

  // These two execution accelerators are admitted only after bridge-spec.k
  // proves their exact empty/cons behavior without importing this module.
  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
       [priority(40)]
  rule <k> #iterNext(list(intVals(iCons(I:Int, R:IntSeq))))
        => #iterYield(I, list(intVals(R))) ... </k>
       [priority(40)]
endmodule
