+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Auxiliary fixed-semantics execution lemmas. They expose the two
+  // constructors of IntSeq without replacing the MPY iterator.
+  claim [iter-intvals-empty]:
+    <k>
+      #iterNext(list(intVals(.IntSeq))) ~> CONT:K
+      =>
+      #iterDone ~> CONT
+    </k>
+
