+from typing import List
+
+
+def rolling_max(numbers: List[int]) -> List[int]:
+    """Return the maximum seen at each position in numbers."""
+    result = []
+    if numbers:
+        current = numbers[0]
+        number = current
+        for number in numbers:
+            if number > current:
+                current = number
+            result.append(current)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b09dc57978554425dffe29b494b6e2034e9593c0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,152 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [rolling-loop]:
+    <k>
+      #loop(
+        list(IS:ValSeq),
+        Name("number"),
+        If(
+          Compare(Name("number"), CmpOp(">", Name("current"))),
+          Assign(Name("current"), Name("number")) .Stmts,
+          .Stmts)
+        Expr(Call(
+          Attribute(Name("result"), "append"),
+          (Name("current"), .Exprs))) .Stmts)
+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      Return(Name("result"))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "current" |-> (M:Int => foldMax(M, IS))
+        "number"  |-> (D:Int => lastOr(D, IS))
+        "numbers" |-> list(ORIGINAL:ValSeq)
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(A:ValSeq => rollAcc(A, M, IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(IS)
+
+  claim [rolling-max-empty]:
+    <k>
+      Call(Name("rolling_max"), (list(.ValSeq), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(rollingMax(.ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [rolling-max-nonempty]:
+    <k>
+      Call(
+        Name("rolling_max"),
+        (list(vCons(H:Int, T:ValSeq)), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(rollingMax(vCons(H, T)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(T)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ff797cea92799264344269413e9a4ffc24bb3e1f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,113 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SUMMARIES
+  imports MPY
+  imports INT
+
+  // The complete formal domain: every element of the MPY payload is an Int.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  rule { true #Equals isInt(V:Val) }
+    => #Exists I:Int . { V #Equals I }
+    [simplification]
+
+  syntax Int ::= stepMax(Int, Int) [function, total]
+  rule stepMax(M:Int, I:Int) => I requires I >Int M
+  rule stepMax(M:Int, I:Int) => M requires I <=Int M
+
+  // Execute the mathematical rolling-maximum fold while accumulating the
+  // already-produced prefix exactly as list.append does.
+  syntax ValSeq ::= rollAcc(ValSeq, Int, ValSeq) [function, total]
+  rule rollAcc(A:ValSeq, _:Int, .ValSeq) => A
+  rule rollAcc(A:ValSeq, M:Int, vCons(I:Int, R:ValSeq))
+    => rollAcc(
+         valSeqConcat(A, vCons(stepMax(M, I), .ValSeq)),
+         stepMax(M, I),
+         R)
+  rule rollAcc(A:ValSeq, _:Int, vCons(_:Val, _:ValSeq)) => A [owise]
+
+  syntax ValSeq ::= rollingMax(ValSeq) [function, total]
+  rule rollingMax(.ValSeq) => .ValSeq
+  rule rollingMax(vCons(H:Int, T:ValSeq))
+    => rollAcc(.ValSeq, H, vCons(H, T))
+  rule rollingMax(vCons(_:Val, _:ValSeq)) => .ValSeq [owise]
+
+  // Final scalar locals of the source for-loop.
+  syntax Int ::= foldMax(Int, ValSeq) [function, total]
+  rule foldMax(M:Int, .ValSeq) => M
+  rule foldMax(M:Int, vCons(I:Int, R:ValSeq))
+    => foldMax(stepMax(M, I), R)
+  rule foldMax(M:Int, vCons(_:Val, _:ValSeq)) => M [owise]
+
+  syntax Int ::= lastOr(Int, ValSeq) [function, total]
+  rule lastOr(D:Int, .ValSeq) => D
+  rule lastOr(_:Int, vCons(I:Int, R:ValSeq)) => lastOr(I, R)
+  rule lastOr(D:Int, vCons(_:Val, _:ValSeq)) => D [owise]
+endmodule
+
+module VERIFICATION-CORE
+  imports VERIFICATION-SUMMARIES
+
+  // Exact specialization of MPY-TUPLE's plain-frame target-binding rule.
+  // bind-spec.k proves this transition without importing VERIFICATION.
+  rule <k> #bindTgt(Name(X:String), I:Int) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(M:Map => M [ X <- I ], P:Parent) ...
+       </scopes>
+       requires notBool ("$cells" in_keys(M))
+       [priority(40)]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-CORE
+
+  // Exact loop summary. loop-spec.k proves this complete transition against
+  // VERIFICATION-CORE (fixed MPY execution plus the separately connected
+  // binding specialization) before this rule is used by the entry proof.
+  rule
+    <k>
+      #loop(
+        list(IS:ValSeq),
+        Name("number"),
+        If(
+          Compare(Name("number"), CmpOp(">", Name("current"))),
+          Assign(Name("current"), Name("number")) .Stmts,
+          .Stmts)
+        Expr(Call(
+          Attribute(Name("result"), "append"),
+          (Name("current"), .Exprs))) .Stmts)
+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      Return(Name("result"))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "current" |-> (M:Int => foldMax(M, IS))
+        "number"  |-> (D:Int => lastOr(D, IS))
+        "numbers" |-> list(ORIGINAL:ValSeq)
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(A:ValSeq => rollAcc(A, M, IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(IS)
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell loop-base.k --main-module LOOP-BASE --syntax-module LOOP-BASE --output-definition loop-kompiled && kprove loop-spec.k --definition loop-kompiled --spec-module LOOP-SPEC' in /workspace
