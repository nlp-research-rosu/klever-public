+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SUMMARIES
+  imports MPY
+  imports INT
+
+  // The complete formal domain: every element of the MPY payload is an Int.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // Sort-refinement lemma: MPY-INT already defines this exact comparison for
+  // Int operands; the guard lets the prover cast symbolic Val operands known
+  // by allInts to that fixed-semantics case.
+  rule applyCmp(">", X:Val, Y:Val)
+    => {X}:>Int >Int {Y}:>Int
+    requires isInt(X) andBool isInt(Y)
+    [simplification]
+
+  // Execute the mathematical rolling-maximum fold while accumulating the
+  // already-produced prefix exactly as list.append does.
+  syntax ValSeq ::= rollAcc(ValSeq, Int, ValSeq) [function, total]
+  rule rollAcc(A:ValSeq, _:Int, .ValSeq) => A
+  rule rollAcc(A:ValSeq, M:Int, vCons(V:Val, R:ValSeq))
+    => rollAcc(
+         valSeqConcat(A, vCons(maxInt(M, {V}:>Int), .ValSeq)),
+         maxInt(M, {V}:>Int),
+         R)
+    requires isInt(V)
+  rule rollAcc(A:ValSeq, _:Int, vCons(V:Val, _:ValSeq)) => A
+    requires notBool isInt(V)
+
+  syntax ValSeq ::= rollingMax(ValSeq) [function, total]
+  rule rollingMax(.ValSeq) => .ValSeq
+  rule rollingMax(vCons(V:Val, T:ValSeq))
+    => rollAcc(.ValSeq, {V}:>Int, vCons(V, T))
+    requires isInt(V)
+  rule rollingMax(vCons(V:Val, _:ValSeq)) => .ValSeq
+    requires notBool isInt(V)
+
+  // Final scalar locals of the source for-loop.
+  syntax Int ::= foldMax(Int, ValSeq) [function, total]
+  rule foldMax(M:Int, .ValSeq) => M
+  rule foldMax(M:Int, vCons(V:Val, R:ValSeq))
+    => foldMax(maxInt(M, {V}:>Int), R)
+    requires isInt(V)
+  rule foldMax(M:Int, vCons(V:Val, _:ValSeq)) => M
+    requires notBool isInt(V)
+
+  syntax Int ::= lastOr(Int, ValSeq) [function, total]
+  rule lastOr(D:Int, .ValSeq) => D
+  rule lastOr(_:Int, vCons(V:Val, R:ValSeq)) => lastOr({V}:>Int, R)
+    requires isInt(V)
+  rule lastOr(D:Int, vCons(V:Val, _:ValSeq)) => D
+    requires notBool isInt(V)
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SUMMARIES
+endmodule

