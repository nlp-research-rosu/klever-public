diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c94f35753604b474fbd777500cb6e2630b1baedb
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,154 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [rolling-loop]:
+    <k>
+      #loop(
+        list(IS:ValSeq),
+        Name("number"),
+        If(
+          Compare(Name("number"), CmpOp(">", Name("current"))),
+          Assign(Name("current"), Name("number")) .Stmts,
+          .Stmts)
+        Expr(Call(
+          Attribute(Name("result"), "append"),
+          (Name("current"), .Exprs))) .Stmts)
+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      Return(Name("result"))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "current" |-> (M:Val => foldMaxV(M, IS))
+        "number"  |-> (D:Val => lastOrV(D, IS))
+        "numbers" |-> list(ORIGINAL:ValSeq)
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(A:ValSeq => rollAcc(A, M, IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(IS)
+      andBool isInt(M)
+      andBool isInt(D)
+
+  claim [rolling-max-empty]:
+    <k>
+      Call(Name("rolling_max"), (list(.ValSeq), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(rollingMax(.ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [rolling-max-nonempty]:
+    <k>
+      Call(
+        Name("rolling_max"),
+        (list(vCons(H:Int, T:ValSeq)), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(rollingMax(vCons(H, T)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(T)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ecaffeb34537a71eebf78adcf76bec73d803252e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,65 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SUMMARIES
+  imports MPY
+  imports INT
+
+  // The complete formal domain: every element of the MPY payload is an Int.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // Sort-refinement lemma: MPY-INT already defines this exact comparison for
+  // Int operands; the guard lets the prover cast symbolic Val operands known
+  // by allInts to that fixed-semantics case.
+  rule applyCmp(">", X:Val, Y:Val)
+    => {X}:>Int >Int {Y}:>Int
+    requires isInt(X) andBool isInt(Y)
+    [simplification]
+
+  syntax Val ::= intMaxV(Val, Val) [function, total]
+  rule intMaxV(X:Val, Y:Val) => Y
+    requires isInt(X) andBool isInt(Y)
+      andBool {Y}:>Int >Int {X}:>Int
+  rule intMaxV(X:Val, Y:Val) => X
+    requires isInt(X) andBool isInt(Y)
+      andBool {Y}:>Int <=Int {X}:>Int
+  rule intMaxV(X:Val, Y:Val) => X
+    requires notBool (isInt(X) andBool isInt(Y))
+
+  // Execute the mathematical rolling-maximum fold while accumulating the
+  // already-produced prefix exactly as list.append does.
+  syntax ValSeq ::= rollAcc(ValSeq, Val, ValSeq) [function, total]
+  rule rollAcc(A:ValSeq, _:Val, .ValSeq) => A
+  rule rollAcc(A:ValSeq, M:Val, vCons(V:Val, R:ValSeq))
+    => rollAcc(
+         valSeqConcat(A, vCons(intMaxV(M, V), .ValSeq)),
+         intMaxV(M, V),
+         R)
+    requires isInt(M) andBool isInt(V)
+  rule rollAcc(A:ValSeq, M:Val, vCons(V:Val, _:ValSeq)) => A
+    requires notBool (isInt(M) andBool isInt(V))
+
+  syntax ValSeq ::= rollingMax(ValSeq) [function, total]
+  rule rollingMax(.ValSeq) => .ValSeq
+  rule rollingMax(vCons(V:Val, T:ValSeq))
+    => rollAcc(.ValSeq, V, vCons(V, T))
+
+  // Final scalar locals of the source for-loop.
+  syntax Val ::= foldMaxV(Val, ValSeq) [function, total]
+  rule foldMaxV(M:Val, .ValSeq) => M
+  rule foldMaxV(M:Val, vCons(V:Val, R:ValSeq))
+    => foldMaxV(intMaxV(M, V), R)
+    requires isInt(M) andBool isInt(V)
+  rule foldMaxV(M:Val, vCons(V:Val, _:ValSeq)) => M
+    requires notBool (isInt(M) andBool isInt(V))
+
+  syntax Val ::= lastOrV(Val, ValSeq) [function, total]
+  rule lastOrV(D:Val, .ValSeq) => D
+  rule lastOrV(_:Val, vCons(V:Val, R:ValSeq)) => lastOrV(V, R)
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SUMMARIES
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module VERIFICATION --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.rolling-loop' in /workspace
