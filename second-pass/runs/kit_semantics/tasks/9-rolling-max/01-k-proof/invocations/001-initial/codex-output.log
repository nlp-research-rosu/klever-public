index 0000000000000000000000000000000000000000..0d1c4f478f3ed359c671fdd122ef41846b038882
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+from typing import List
+
+
+def rolling_max(numbers: List[int]) -> List[int]:
+    """Return the maximum seen at each position in numbers."""
+    result = []
+    if numbers:
+        current = numbers[0]
+        number = current
+        for number in numbers:
+            if number > current:
+                current = number
+            result.append(current)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..18d4ec2e7d48787de8d59387323b0dedba111288
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,166 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Auxiliary fixed-semantics execution lemmas. They expose the two
+  // constructors of IntSeq without replacing the MPY iterator.
+  claim [iter-intvals-empty]:
+    <k>
+      #iterNext(list(intVals(.IntSeq))) ~> CONT:K
+      =>
+      #iterDone ~> CONT
+    </k>
+
+  claim [iter-intvals-cons]:
+    <k>
+      #iterNext(list(intVals(iCons(I:Int, R:IntSeq)))) ~> CONT:K
+      =>
+      #iterYield(I, list(intVals(R))) ~> CONT
+    </k>
+
+  claim [rolling-loop]:
+    <k>
+      #loop(
+        list(intVals(IS:IntSeq)),
+        Name("number"),
+        If(
+          Compare(Name("number"), CmpOp(">", Name("current"))),
+          Assign(Name("current"), Name("number")) .Stmts,
+          .Stmts)
+        Expr(Call(
+          Attribute(Name("result"), "append"),
+          (Name("current"), .Exprs))) .Stmts)
+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      Return(Name("result"))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "current" |-> (M:Int => foldMax(M, IS))
+        "number"  |-> (D:Int => lastOr(D, IS))
+        "numbers" |-> list(intVals(ORIGINAL:IntSeq))
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(A:ValSeq => rollAcc(A, M, IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [rolling-max-empty]:
+    <k>
+      Call(Name("rolling_max"), (list(intVals(.IntSeq)), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(rollingMax(.IntSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [rolling-max-nonempty]:
+    <k>
+      Call(
+        Name("rolling_max"),
+        (list(intVals(iCons(H:Int, T:IntSeq))), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(rollingMax(iCons(H, T)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..27793ada618e5b4dada21fc9a2224c452d9e603f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,40 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SUMMARIES
+  imports MPY
+  imports INT
+
+  // Embed every finite mathematical integer sequence as an MPY list payload.
+  syntax ValSeq ::= intVals(IntSeq)
+  rule intVals(.IntSeq) => .ValSeq [anywhere]
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R)) [anywhere]
+
+  // Execute the mathematical rolling-maximum fold while accumulating the
+  // already-produced prefix exactly as list.append does.
+  syntax ValSeq ::= rollAcc(ValSeq, Int, IntSeq) [function, total]
+  rule rollAcc(A:ValSeq, _:Int, .IntSeq) => A
+  rule rollAcc(A:ValSeq, M:Int, iCons(I:Int, R:IntSeq))
+    => rollAcc(
+         valSeqConcat(A, vCons(maxInt(M, I), .ValSeq)),
+         maxInt(M, I),
+         R)
+
+  syntax ValSeq ::= rollingMax(IntSeq) [function, total]
+  rule rollingMax(.IntSeq) => .ValSeq
+  rule rollingMax(iCons(H:Int, T:IntSeq))
+    => rollAcc(.ValSeq, H, iCons(H, T))
+
+  // Final scalar locals of the source for-loop.
+  syntax Int ::= foldMax(Int, IntSeq) [function, total]
+  rule foldMax(M:Int, .IntSeq) => M
+  rule foldMax(M:Int, iCons(I:Int, R:IntSeq))
+    => foldMax(maxInt(M, I), R)
+
+  syntax Int ::= lastOr(Int, IntSeq) [function, total]
+  rule lastOr(D:Int, .IntSeq) => D
+  rule lastOr(_:Int, iCons(I:Int, R:IntSeq)) => lastOr(I, R)
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SUMMARIES
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module VERIFICATION --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.rolling-loop' in /workspace
