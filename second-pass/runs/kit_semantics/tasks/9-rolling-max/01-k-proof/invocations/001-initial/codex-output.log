+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [rolling-loop]:
+    <k>
+      #loop(
+        list(IS:ValSeq),
+        Name("number"),
+        If(
+          Compare(Name("number"), CmpOp(">", Name("current"))),
+          Assign(Name("current"), Name("number")) .Stmts,
+          .Stmts)
+        Expr(Call(
+          Attribute(Name("result"), "append"),
+          (Name("current"), .Exprs))) .Stmts)
+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      Return(Name("result"))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "current" |-> (M:Val => foldMax({M}:>Int, IS))
+        "number"  |-> (D:Val => lastOr({D}:>Int, IS))
+        "numbers" |-> list(ORIGINAL:ValSeq)
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(A:ValSeq => rollAcc(A, {M}:>Int, IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(IS)
+      andBool isInt(M)
+      andBool isInt(D)
+
+  claim [rolling-max-empty]:
+    <k>
+      Call(Name("rolling_max"), (list(.ValSeq), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(rollingMax(.ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [rolling-max-nonempty]:
+    <k>
+      Call(
+        Name("rolling_max"),
+        (list(vCons(H:Int, T:ValSeq)), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(rollingMax(vCons(H, T)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(T)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1de44dec5b0220893fc721131c023b098734bd3c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,61 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SUMMARIES
+  imports MPY
+  imports INT
+
+  // The complete formal domain: every element of the MPY payload is an Int.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // Sort-refinement lemma: MPY-INT already defines this exact comparison for
+  // Int operands; the guard lets the prover cast symbolic Val operands known
+  // by allInts to that fixed-semantics case.
+  rule applyCmp(">", X:Val, Y:Val)
+    => {X}:>Int >Int {Y}:>Int
+    requires isInt(X) andBool isInt(Y)
+    [simplification]
+
+  // Execute the mathematical rolling-maximum fold while accumulating the
+  // already-produced prefix exactly as list.append does.
+  syntax ValSeq ::= rollAcc(ValSeq, Int, ValSeq) [function, total]
+  rule rollAcc(A:ValSeq, _:Int, .ValSeq) => A
+  rule rollAcc(A:ValSeq, M:Int, vCons(V:Val, R:ValSeq))
+    => rollAcc(
+         valSeqConcat(A, vCons(maxInt(M, {V}:>Int), .ValSeq)),
+         maxInt(M, {V}:>Int),
+         R)
+    requires isInt(V)
+  rule rollAcc(A:ValSeq, _:Int, vCons(V:Val, _:ValSeq)) => A
+    requires notBool isInt(V)
+
+  syntax ValSeq ::= rollingMax(ValSeq) [function, total]
+  rule rollingMax(.ValSeq) => .ValSeq
+  rule rollingMax(vCons(V:Val, T:ValSeq))
+    => rollAcc(.ValSeq, {V}:>Int, vCons(V, T))
+    requires isInt(V)
+  rule rollingMax(vCons(V:Val, _:ValSeq)) => .ValSeq
+    requires notBool isInt(V)
+
+  // Final scalar locals of the source for-loop.
+  syntax Int ::= foldMax(Int, ValSeq) [function, total]
+  rule foldMax(M:Int, .ValSeq) => M
+  rule foldMax(M:Int, vCons(V:Val, R:ValSeq))
+    => foldMax(maxInt(M, {V}:>Int), R)
+    requires isInt(V)
+  rule foldMax(M:Int, vCons(V:Val, _:ValSeq)) => M
+    requires notBool isInt(V)
+
+  syntax Int ::= lastOr(Int, ValSeq) [function, total]
+  rule lastOr(D:Int, .ValSeq) => D
+  rule lastOr(_:Int, vCons(V:Val, R:ValSeq)) => lastOr({V}:>Int, R)
+    requires isInt(V)
+  rule lastOr(D:Int, vCons(V:Val, _:ValSeq)) => D
+    requires notBool isInt(V)
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SUMMARIES
+endmodule

