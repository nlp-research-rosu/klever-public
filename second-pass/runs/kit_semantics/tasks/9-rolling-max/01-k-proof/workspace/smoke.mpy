Module(
  ImportFrom("typing", "List")
  FuncDef("rolling_max", Params("numbers"),
    Expr(Str("Return the maximum seen at each position in numbers."))
    Assign(Name("result"), ListExpr())
    If(Name("numbers"),
      Assign(Name("current"), Subscript(Name("numbers"), Int(0)))
      Assign(Name("number"), Name("current"))
      For(Name("number"), Name("numbers"),
        If(Compare(Name("number"), CmpOp(">", Name("current"))),
          Assign(Name("current"), Name("number")),
          )
        Expr(Call(Attribute(Name("result"), "append"), Name("current")))),
      )
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("rolling_max"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("rolling_max"), ListExpr(Int(5))),
      CmpOp("==", ListExpr(Int(5)))))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(Int(1), Int(2), Int(3), Int(2), Int(3), Int(4), Int(2))),
      CmpOp(
        "==",
        ListExpr(Int(1), Int(2), Int(3), Int(3), Int(3), Int(4), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(Int(4), Int(3), Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(4), Int(4), Int(4), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(2)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(2)))))))
