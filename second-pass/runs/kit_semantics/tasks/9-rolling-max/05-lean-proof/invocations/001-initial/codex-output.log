diff --git a//tmp/lean-app-path-probe.c b//tmp/lean-app-path-probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..f7ecda60a6755428e37c18b8a21a7b0e0add6c8b
--- /dev/null
+++ b//tmp/lean-app-path-probe.c
@@ -0,0 +1,39 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <limits.h>
+#include <stdlib.h>
+
+int main(void) {
+  char path[4096];
+  char procpath[128];
+  snprintf(procpath, sizeof(procpath), "/proc/%d/exe", getpid());
+  printf("pid=%d path=%s\n", getpid(), procpath);
+  ssize_t own_n = readlink(procpath, path, sizeof(path) - 1);
+  if (own_n < 0) {
+    fprintf(stderr, "own readlink: %s\n", strerror(errno));
+    return 4;
+  }
+  path[own_n] = '\0';
+  puts(path);
+  ssize_t n = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (n < 0) {
+    fprintf(stderr, "readlink: %s\n", strerror(errno));
+    return 1;
+  }
+  path[n] = '\0';
+  puts(path);
+  char resolved[PATH_MAX];
+  if (!realpath("/proc/self/exe", resolved)) {
+    fprintf(stderr, "realpath proc: %s\n", strerror(errno));
+    return 2;
+  }
+  puts(resolved);
+  if (!realpath("/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean", resolved)) {
+    fprintf(stderr, "realpath lean: %s\n", strerror(errno));
+    return 3;
+  }
+  puts(resolved);
+  return 0;
+}
diff --git a//tmp/lean-proc-self.c b//tmp/lean-proc-self.c
new file mode 100644
index 0000000000000000000000000000000000000000..48df44a060e5fd0107b884c114cebca2f96e05bb
--- /dev/null
+++ b//tmp/lean-proc-self.c
@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_pid_exe_path(const char *path) {
+  const char prefix[] = "/proc/";
+  const char suffix[] = "/exe";
+  size_t length = strlen(path);
+  size_t prefix_length = sizeof(prefix) - 1;
+  size_t suffix_length = sizeof(suffix) - 1;
+  if (length <= prefix_length + suffix_length ||
+      strncmp(path, prefix, prefix_length) != 0 ||
+      strcmp(path + length - suffix_length, suffix) != 0) {
+    return 0;
+  }
+  for (size_t i = prefix_length; i < length - suffix_length; ++i) {
+    if (!isdigit((unsigned char)path[i])) {
+      return 0;
+    }
+  }
+  return 1;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  const char *resolved = is_pid_exe_path(path) ? "/proc/self/exe" : path;
+  return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}
