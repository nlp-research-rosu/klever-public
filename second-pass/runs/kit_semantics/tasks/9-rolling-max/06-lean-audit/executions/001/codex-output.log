solution.py:
     1	from typing import List
     2	
     3	
     4	def rolling_max(numbers: List[int]) -> List[int]:
     5	    """Return the maximum seen at each position in numbers."""
     6	    result = []
     7	    if numbers:
     8	        current = numbers[0]
     9	        number = current
    10	        for number in numbers:
    11	            if number > current:
    12	                current = number
    13	            result.append(current)
    14	    return result
