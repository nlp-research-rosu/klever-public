     2	
     3	module VERIFICATION-SUMMARIES
     4	  imports MPY
     5	  imports INT
     6	
     7	  // The complete formal domain: every element of the MPY payload is an Int.
     8	  syntax Bool ::= allInts(ValSeq) [function, total]
     9	  rule allInts(.ValSeq) => true
    10	  rule allInts(vCons(V:Val, R:ValSeq))
    11	    => isInt(V) andBool allInts(R)
    12	
    13	  rule { true #Equals isInt(V:Val) }
    14	    => #Exists I:Int . { V #Equals I }
    15	    [simplification]
    16	
    17	  syntax Int ::= stepMax(Int, Int) [function, total]
    18	  rule stepMax(M:Int, I:Int) => I requires I >Int M
    19	  rule stepMax(M:Int, I:Int) => M requires I <=Int M
    20	
    21	  // Execute the mathematical rolling-maximum fold while accumulating the
    22	  // already-produced prefix exactly as list.append does.
    23	  syntax ValSeq ::= rollAcc(ValSeq, Int, ValSeq) [function, total]
    24	  rule rollAcc(A:ValSeq, _:Int, .ValSeq) => A
    25	  rule rollAcc(A:ValSeq, M:Int, vCons(I:Int, R:ValSeq))
    26	    => rollAcc(
    27	         valSeqConcat(A, vCons(stepMax(M, I), .ValSeq)),
    28	         stepMax(M, I),
    29	         R)
    30	  rule rollAcc(A:ValSeq, _:Int, vCons(_:Val, _:ValSeq)) => A [owise]
    31	
    32	  syntax ValSeq ::= rollingMax(ValSeq) [function, total]
    33	  rule rollingMax(.ValSeq) => .ValSeq
    34	  rule rollingMax(vCons(H:Int, T:ValSeq))
    35	    => rollAcc(.ValSeq, H, vCons(H, T))
    36	  rule rollingMax(vCons(_:Val, _:ValSeq)) => .ValSeq [owise]
    37	
    38	  // Final scalar locals of the source for-loop.
    39	  syntax Int ::= foldMax(Int, ValSeq) [function, total]
    40	  rule foldMax(M:Int, .ValSeq) => M
    41	  rule foldMax(M:Int, vCons(I:Int, R:ValSeq))
    42	    => foldMax(stepMax(M, I), R)
    43	  rule foldMax(M:Int, vCons(_:Val, _:ValSeq)) => M [owise]
    44	
    45	  syntax Int ::= lastOr(Int, ValSeq) [function, total]
