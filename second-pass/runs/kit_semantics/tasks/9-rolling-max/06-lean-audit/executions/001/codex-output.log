diff --git a//tmp/audit-work/rolling-max-proof-audit/AdversarialBridge.lean b//tmp/audit-work/rolling-max-proof-audit/AdversarialBridge.lean
new file mode 100644
index 0000000000000000000000000000000000000000..d8a3eaf805f91e3baadd56901ddd2c704a409372
--- /dev/null
+++ b//tmp/audit-work/rolling-max-proof-audit/AdversarialBridge.lean
@@ -0,0 +1,64 @@
+import Proof
+
+open Klean9RollingMax
+
+namespace BridgeAudit
+
+example :
+    Proof.isInt
+      (SortK.kseq (SortKItem.inj_SortInt 7) SortK.dotk) = true := rfl
+
+example :
+    Proof.isInt
+      (SortK.kseq (SortKItem.inj_SortBool true) SortK.dotk) = false := rfl
+
+example : Proof.isInt SortK.dotk = false := rfl
+
+example :
+    Proof.isInt
+      (SortK.kseq
+        (SortKItem.inj_SortInt 7)
+        (SortK.kseq (SortKItem.inj_SortBool false) SortK.dotk)) = false := rfl
+
+def constantTrue : SortK → SortBool := fun _ => true
+
+theorem constantTrue_rejected :
+    ¬ Lemmas.targetStatement constantTrue := by
+  intro h
+  have bad := h (SortVal.inj_SortBool false)
+  simp [constantTrue, inj] at bad
+
+def constantFalse : SortK → SortBool := fun _ => false
+
+theorem constantFalse_rejected :
+    ¬ Lemmas.targetStatement constantFalse := by
+  intro h
+  have bad := h (SortVal.inj_SortInt 0)
+  simp [constantFalse, inj] at bad
+
+def singletonAny : SortK → SortBool
+  | SortK.kseq _ SortK.dotk => true
+  | _ => false
+
+theorem singletonAny_rejected :
+    ¬ Lemmas.targetStatement singletonAny := by
+  intro h
+  have bad := h (SortVal.inj_SortBool true)
+  simp [singletonAny, inj] at bad
+
+def onlyZero : SortK → SortBool
+  | SortK.kseq (SortKItem.inj_SortInt 0) SortK.dotk => true
+  | _ => false
+
+theorem onlyZero_rejected :
+    ¬ Lemmas.targetStatement onlyZero := by
+  intro h
+  have bad := h (SortVal.inj_SortInt 1)
+  change
+    (true = onlyZero
+      (SortK.kseq (SortKItem.inj_SortInt 1) SortK.dotk)) ↔
+      (∃ I : SortInt, SortVal.inj_SortInt 1 = SortVal.inj_SortInt I)
+    at bad
+  simp [onlyZero] at bad
+
+end BridgeAudit
