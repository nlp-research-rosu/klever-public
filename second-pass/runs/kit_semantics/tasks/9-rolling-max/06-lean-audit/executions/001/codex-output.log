    52	  values     : List (K × V) → List V
    53	  size       : List (K × V) → Nat
    54	  includes   : List (K × V) → List (K × V) → Bool -- List (K × V) inclusion
    55	  choice     : List (K × V) → K -- arbitrary key from a List (K × V)
    56	  -- nodup is not satisfiable in the current implementation with `List (K × V)`
    57	  -- nodup      : forall al : List (K × V), List.Nodup (keys al)
    58	  split      : List (K × V) → List K → Option (List V × List (K × V))
    59	
    60	-- We use axioms to have uninterpreted functions
    61	namespace MapHookDef
    62	  variable (K V : Type)
    63	  axiom unitAx       : List (K × V)
    64	  axiom consAx       : K → V → List (K × V) → List (K × V)
    65	  axiom lookupAx     : List (K × V) → K → Option V
