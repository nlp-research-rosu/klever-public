diff --git a//tmp/audit-work/rolling-max-20260729/stage4-witness.k b//tmp/audit-work/rolling-max-20260729/stage4-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..3d27d86b3ebf9bc1f094685543d1b42ee2f6f18d
--- /dev/null
+++ b//tmp/audit-work/rolling-max-20260729/stage4-witness.k
@@ -0,0 +1,155 @@
+requires "verification.k"
+
+module STAGE4-WITNESS
+  imports VERIFICATION
+
+  claim [entry-empty-witness]:
+    <k>
+      Call(Name("rolling_max"), (list(.ValSeq), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
