+requires "verification.k"
+
+module STAGE4-WITNESS
+  imports VERIFICATION
+
+  claim [entry-empty-witness]:
+    <k>
+      Call(Name("rolling_max"), (list(.ValSeq), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [entry-nonempty-witness]:
+    <k>
+      Call(
+        Name("rolling_max"),
+        (list(vCons(1, vCons(-2, vCons(3, vCons(2, .ValSeq))))), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "rolling_max" |->
+          closureVal(
+            ("numbers", .ParamNames),
+            Expr(Str("Return the maximum seen at each position in numbers."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            If(
+              Name("numbers"),
+              Assign(
+                Name("current"),
+                Subscript(Name("numbers"), Int(0)))
+              Assign(Name("number"), Name("current"))
+              For(
+                Name("number"),
+                Name("numbers"),
+                If(
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Name("current"))),
+                  Assign(Name("current"), Name("number")) .Stmts,
+                  .Stmts)
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  (Name("current"), .Exprs))) .Stmts)
+              .Stmts,
+              .Stmts)
+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(1, vCons(3, vCons(3, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-witness]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(-1, vCons(3, .ValSeq)))),
+        Name("number"),
+        If(
+          Compare(Name("number"), CmpOp(">", Name("current"))),
+          Assign(Name("current"), Name("number")) .Stmts,
+          .Stmts)
+        Expr(Call(
+          Attribute(Name("result"), "append"),
+          (Name("current"), .Exprs))) .Stmts)
+      ~> .Stmts
+      ~> Return(Name("result")) .Stmts
+      ~> #endcall
+      =>
+      .Stmts
+      ~> Return(Name("result")) .Stmts
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+        "current" |-> (1 => 3)
+        "number"  |-> (1 => 3)
+        "numbers" |-> list(vCons(1, vCons(2, vCons(-1, vCons(3, .ValSeq)))))
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(
+        vCons(1, .ValSeq)
+        =>
+        vCons(1, vCons(2, vCons(2, vCons(3, .ValSeq)))))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..db5d6e22e3777c991356e795b806251ac8ec8bd1
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,28 @@
+from typing import List
+
+
+def rolling_max(numbers: List[int]) -> List[int]:
+    """Return the maximum seen at each position in numbers."""
+    result = []
+    if numbers:
+        current = numbers[0]
+        number = current
+        for number in numbers:
+            if number > current:
+                current = number
+            result.append(current)
+    return result
+
+
+assert rolling_max([]) == []
+assert rolling_max([7]) == [7]
+assert rolling_max([1, 1]) == [1, 1]
+assert rolling_max([2, 1]) == [2, 2]
+assert rolling_max([1, 2]) == [1, 2]
+assert rolling_max([1, 2, 3, 2, 3, 4, 2]) == [1, 2, 3, 3, 3, 4, 4]
+assert rolling_max([-9, -9, -3, -7, 0]) == [-9, -9, -3, -3, 0]
+assert rolling_max([100000000000000000000, -1, 100000000000000000001]) == [
+    100000000000000000000,
+    100000000000000000000,
+    100000000000000000001,
+]
