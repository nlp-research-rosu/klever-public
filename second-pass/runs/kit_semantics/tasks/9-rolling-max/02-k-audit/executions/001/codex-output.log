+        "numbers" |-> list(vCons(1, vCons(2, vCons(-1, vCons(3, .ValSeq)))))
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(
+        vCons(1, .ValSeq)
+        =>
+        vCons(1, vCons(2, vCons(2, vCons(3, .ValSeq)))))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
