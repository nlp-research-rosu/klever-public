from pathlib import Path
import hashlib,itertools,os,stat
pairs=[(Path('/reference/reference-semantics'),'1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de'),(Path('/generation-evidence/codex-trace'),'bb361019a27b57221fdef3fe1d80fb92019da221820bd34333f46dac76c3197e')]

def calc(root, dirs, prefix, pd, mode, fd, size, kind):
 h=hashlib.sha256()
 ps=sorted(root.rglob('*'),key=lambda x:x.relative_to(root).as_posix())
 for p in ps:
  if p.is_dir() and not dirs: continue
  rel=p.relative_to(root).as_posix(); rel=('./'+rel if prefix else rel).encode()
  h.update(rel); h.update(pd)
  if kind: h.update((b'd' if p.is_dir() else b'f')+fd)
  if p.is_file():
   b=p.read_bytes()
   if size: h.update(len(b).to_bytes(8,'big'))
   if mode=='raw': h.update(b)
   elif mode=='hex': h.update(hashlib.sha256(b).hexdigest().encode())
   else: h.update(hashlib.sha256(b).digest())
   h.update(fd)
 return h.hexdigest()
for args in itertools.product([False,True],[False,True],[b'',b'\\0',b'\\n'],['raw','hex','bin'],[b'',b'\\0',b'\\n'],[False,True],[False,True]):
 vals=[calc(r,*args) for r,_ in pairs]
 if any(v==want for v,(_,want) in zip(vals,pairs)):
  print('PARTIAL',args,vals)
 if all(v==want for v,(_,want) in zip(vals,pairs)):
  print('MATCH',args); break
else: print('no full match')
