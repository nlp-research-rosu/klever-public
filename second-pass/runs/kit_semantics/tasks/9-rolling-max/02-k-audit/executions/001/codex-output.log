+        "numbers" |-> list(vCons(1, vCons(2, vCons(-1, vCons(3, .ValSeq)))))
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
