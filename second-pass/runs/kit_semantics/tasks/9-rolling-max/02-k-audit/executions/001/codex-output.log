+            Return(Name("result")) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(1, vCons(3, vCons(3, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [loop-witness]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(-1, vCons(3, .ValSeq)))),
+        Name("number"),
+        If(
+          Compare(Name("number"), CmpOp(">", Name("current"))),
+          Assign(Name("current"), Name("number")) .Stmts,
+          .Stmts)
+        Expr(Call(
+          Attribute(Name("result"), "append"),
+          (Name("current"), .Exprs))) .Stmts)
+      ~> .Stmts
+      ~> Return(Name("result")) .Stmts
+      ~> #endcall
+      =>
+      .Stmts
+      ~> Return(Name("result")) .Stmts
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+        "current" |-> (1 => 3)
+        "number"  |-> (1 => 3)
+        "numbers" |-> list(vCons(1, vCons(2, vCons(-1, vCons(3, .ValSeq)))))
+        "result"  |-> ref(0),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
