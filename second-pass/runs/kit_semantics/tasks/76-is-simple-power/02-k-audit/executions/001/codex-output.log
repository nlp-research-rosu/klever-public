+  python3 py2mpy.py /audit-output/evidence/concrete_program.py > concrete-audit.mpy
+)
+printf '%s\n' '[exit 0]'
+
+printf '%s\n' '$ krun concrete-audit.mpy --definition runtime-audit-kompiled'
+(
