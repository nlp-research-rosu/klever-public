+(push)
+(declare-const x Int)
+(declare-const n Int)
+(assert (or (<= n (- 2)) (>= n 2)))
+(assert (= (pyMod x n) 0))
+(assert (= x 1))
+(check-sat)
+(pop)
+
+(echo "counterexample: nondivisibility guard permits x=0")
+(push)
+(declare-const x Int)
+(declare-const n Int)
+(assert (or (<= n (- 2)) (>= n 2)))
+(assert (not (= (pyMod x n) 0)))
+(assert (= x 0))
+(check-sat)
