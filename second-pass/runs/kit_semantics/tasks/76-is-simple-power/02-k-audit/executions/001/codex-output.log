diff --git a/evidence/used-construct-map.tsv b/evidence/used-construct-map.tsv
new file mode 100644
index 0000000000000000000000000000000000000000..1af66e4dfb34e031096e41b2285794ef299565ad
--- /dev/null
+++ b/evidence/used-construct-map.tsv
@@ -0,0 +1,17 @@
+construct	declaration	evaluation/control rules	assessment
+Module	semantics/syntax.k:61	semantics/core.k:124-127; semantics/functions.k:14-16	Module loading creates the same closure body/capture environment mechanically compared in stage4.
+FuncDef	semantics/syntax.k:53	semantics/functions.k:14-16	Binds closureVal(params,body,current-env); no body summary or interception.
+Params/ParamNames	semantics/syntax.k:57,60	semantics/functions.k:63-75	Two arguments bind left-to-right to x and n in the fresh frame.
+Call	semantics/syntax.k:28	semantics/call.k:18-21,69-74; semantics/core.k:183-191	Evaluates callee then arguments left-to-right, pushes a real frame, and executes BODY.
+Name	semantics/syntax.k:12	semantics/core.k:129-154	Looks up current local frame, then parents; the entry binding pins is_simple_power.
+Int literal	semantics/syntax.k:9	semantics/core.k:193-196	Evaluates to the same unbounded K Int.
+Bool literal	semantics/syntax.k:11	semantics/core.k:193-196	Evaluates to the same K Bool.
+If	semantics/syntax.k:49 [strict(1)]	semantics/controls.k:50-54	Condition evaluates first; truthy Bool selects exactly one branch.
+Compare/CmpOp	semantics/syntax.k:30,32	semantics/operators.k:14-20; semantics/int.k:22-27	Operands evaluate in context and integer comparisons produce Bool.
+UnaryOp "-"	semantics/syntax.k:14 [strict(2)]	semantics/operators.k:10; semantics/int.k:7	Used only to construct the literal -1.
+While	semantics/syntax.k:46	semantics/controls.k:65-91	Guard is reevaluated each iteration; true executes body and loopback, false exits.
+BinOp "%"	semantics/syntax.k:15 [seqstrict(2,3)]	semantics/operators.k:12; semantics/int.k:15,19-20	Left-to-right integer operands; supplied pyMod matches Python modulo for nonzero n.
+BinOp "//"	semantics/syntax.k:15 [seqstrict(2,3)]	semantics/operators.k:12; semantics/int.k:16	Computes (x-pyMod(x,n))/n, Python floor division for nonzero n.
+Assign Name	semantics/syntax.k:41 [strict(2)]	semantics/controls.k:8-18	Evaluates RHS then overwrites only local x.
+Return	semantics/syntax.k:50 [strict]	semantics/functions.k:77-90	Evaluates result, sets retV, discards remaining callee statements, restores caller cells/frame.
+Stmts list	semantics/syntax.k:56	semantics/core.k:123-127	Executes statements in source order and terminates on .Stmts.
diff --git a/evidence/verification-base.k b/evidence/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..a3e3627b7d1d13fba388ddb5012c646a4ec6807e
--- /dev/null
+++ b/evidence/verification-base.k
@@ -0,0 +1,34 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+  imports BOOL
+  imports INT
+
+  syntax Bool ::= simplePower(Int, Int) [function, total]
+
+  rule simplePower(1, _N) => true
+
+  rule simplePower(X, 0) => X ==Int 0
+    requires X =/=Int 1
+
+  rule simplePower(X, 1) => false
+    requires X =/=Int 1
+
+  rule simplePower(X, -1) => X ==Int -1
+    requires X =/=Int 1
+
+  rule simplePower(0, N) => false
+    requires N <=Int -2 orBool N >=Int 2
+
+  rule simplePower(X, N)
+    => simplePower((X -Int pyMod(X, N)) /Int N, N)
+    requires X =/=Int 0 andBool X =/=Int 1
+     andBool (N <=Int -2 orBool N >=Int 2)
+     andBool pyMod(X, N) ==Int 0
+
+  rule simplePower(X, N) => false
+    requires X =/=Int 0 andBool X =/=Int 1
+     andBool (N <=Int -2 orBool N >=Int 2)
+     andBool pyMod(X, N) =/=Int 0
+endmodule

exec
/bin/bash -lc 'set +e
set -o pipefail
{ set -x; kprove /audit-output/evidence/spec-false-result-audit.k -I /tmp/audit-work/76-is-simple-power --definition verification-audit-kompiled --spec-module SPEC-FALSE-RESULT-AUDIT; } 2>&1 | tee /audit-output/evidence/stage6-false-result.log
kprove_rc=${PIPESTATUS[0]}
set +x
printf '"'KPROVE_EXIT_STATUS=%d\\n' \""'$kprove_rc" | tee -a /audit-output/evidence/stage6-false-result.log
grep -q '"'WarnStuckClaimState' /audit-output/evidence/stage6-false-result.log
grep_rc="'$?
printf '"'EXPECTED_STUCK_PRESENT=%d\\n' \""'$((grep_rc == 0))" | tee -a /audit-output/evidence/stage6-false-result.log
if [ "$kprove_rc" -ne 0 ] && [ "$grep_rc" -eq 0 ]; then exit 0; else exit 1; fi' in /tmp/audit-work/76-is-simple-power
diff --git a/evidence/concrete_program.py b/evidence/concrete_program.py
new file mode 100644
index 0000000000000000000000000000000000000000..63c82d50ef4a793d091ea5731f8a73bfab00e4df
--- /dev/null
+++ b/evidence/concrete_program.py
@@ -0,0 +1,34 @@
+def is_simple_power(x, n):
+    if x == 1:
+        return True
+    if n == 0:
+        return x == 0
+    if n == 1:
+        return False
+    if n == -1:
+        return x == -1
+    if x == 0:
+        return False
+    while x % n == 0:
+        x = x // n
+    return x == 1
+
+
+# Documented examples.
+assert is_simple_power(1, 4)
+assert is_simple_power(2, 2)
+assert is_simple_power(8, 2)
+assert not is_simple_power(3, 2)
+assert not is_simple_power(3, 1)
+assert not is_simple_power(5, 3)
+
+# Branch, loop, sign, and magnitude boundaries.
+assert is_simple_power(0, 0)
+assert not is_simple_power(0, 2)
+assert is_simple_power(-1, -1)
+assert is_simple_power(-8, -2)
+assert is_simple_power(16, -2)
+assert not is_simple_power(8, -2)
+assert not is_simple_power(-8, 2)
+assert is_simple_power(1048576, 2)
+assert not is_simple_power(1048575, 2)
diff --git a/evidence/derived-lemma-arithmetic.smt2 b/evidence/derived-lemma-arithmetic.smt2
new file mode 100644
index 0000000000000000000000000000000000000000..fd87ebf73095900440f41a6e5e28f67f5e6752b6
--- /dev/null
+++ b/evidence/derived-lemma-arithmetic.smt2
@@ -0,0 +1,26 @@
+(set-logic NIA)
+
+; K's supplied Python-remainder helper:
+; pyMod(x,n) = ((x %Int n) + n) %Int n.
+(define-fun pyMod ((x Int) (n Int)) Int
+  (mod (+ (mod x n) n) n))
+
+(echo "counterexample: exact-divisibility guard permits x=1")
+(push)
+(declare-const x Int)
+(declare-const n Int)
+(assert (or (<= n (- 2)) (>= n 2)))
+(assert (= (pyMod x n) 0))
+(assert (= x 1))
+(check-sat)
+(pop)
+
+(echo "counterexample: nondivisibility guard permits x=0")
+(push)
+(declare-const x Int)
+(declare-const n Int)
+(assert (or (<= n (- 2)) (>= n 2)))
+(assert (not (= (pyMod x n) 0)))
+(assert (= x 0))
+(check-sat)
+(pop)
