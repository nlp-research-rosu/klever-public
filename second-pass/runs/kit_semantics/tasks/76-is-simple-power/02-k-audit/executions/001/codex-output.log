+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf '[exit %d]\n' "$rc"
+  if [ "$rc" -ne 0 ]; then
+    status=1
+  fi
+}
+
+printf '## Trusted contract and implementations\n'
+for source in \
+  "$scratch/prompt.py" \
+  "$scratch/trusted/canonical.py" \
+  "$scratch/solution.py" \
+  "$scratch/solution.mpy"
+do
