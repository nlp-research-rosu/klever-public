+)
+printf '%s\n' '[exit 0]'
+
+printf '%s\n' '$ krun concrete-audit.mpy --definition runtime-audit-kompiled'
+(
+  cd "$scratch"
+  krun concrete-audit.mpy --definition runtime-audit-kompiled
+)
+printf '%s\n' '[exit 0]'
