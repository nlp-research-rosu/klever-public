+status=0
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf '[exit %d]\n' "$rc"
+  if [ "$rc" -ne 0 ]; then
+    status=1
+  fi
+}
+
+run kast "$scratch/solution.mpy" \
+  --definition "$scratch/runtime-audit-kompiled" \
+  --module MPY-SYNTAX \
+  --output json \
+  --expand-macros \
