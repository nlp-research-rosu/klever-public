+example : Proof.«_<=Int_» (-2) (-2) ≠ false := by decide
+example : «_==Bool_» true true ≠ false := by decide
+example : Proof.«_==Int_» 0 0 ≠ false := by decide
+example : «_=/=Int_» 0 1 ≠ false := by decide
+example : Proof.«_/Int_» 4 2 ≠ 4 := by decide
+example : «pyMod(_,_)_MPY-INT_Int_Int_Int» 3 2 ≠ 0 := by decide
+example :
