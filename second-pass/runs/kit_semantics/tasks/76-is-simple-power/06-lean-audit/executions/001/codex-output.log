@@ -0,0 +1,90 @@
+import Proof
+
+namespace Counterfactuals
+
+def badAnd (_a _b : SortBool) : SortBool := false
+def badOr (_a _b : SortBool) : SortBool := false
+def badEqBool (_a _b : SortBool) : SortBool := true
+def badNe (_a _b : SortInt) : SortBool := false
+def badDiv (a _b : SortInt) : SortInt := a
+
+theorem target_accepts_badAnd :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      badAnd
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  unfold Klean76IsSimplePower.Lemmas.targetStatement
+  constructor <;> intro n x h <;> simp [badAnd] at h
+
+theorem target_accepts_badOr :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      badOr
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  unfold Klean76IsSimplePower.Lemmas.targetStatement
+  constructor <;> intro n x h <;>
+    simp [badOr, Proof._andBool_] at h
+
+theorem target_accepts_badEqBool :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      badEqBool
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  have good := Proof.final
+  unfold Klean76IsSimplePower.Lemmas.targetStatement at good ⊢
+  exact ⟨by intro n x h; rfl, good.2⟩
+
+theorem target_accepts_badNe :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      badNe
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  unfold Klean76IsSimplePower.Lemmas.targetStatement
+  constructor <;> intro n x h <;>
+    simp [badNe, Proof._andBool_] at h
+
+theorem target_accepts_badDiv :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      badDiv
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  have good := Proof.final
+  unfold Klean76IsSimplePower.Lemmas.targetStatement at good ⊢
+  exact ⟨good.1, by intro n x h; rfl⟩
+
+end Counterfactuals
