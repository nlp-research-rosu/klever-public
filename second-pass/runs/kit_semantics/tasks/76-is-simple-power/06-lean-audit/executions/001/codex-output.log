+#eval Proof.«_>=Int_» (-2) (-2)
+#eval Proof.«_>=Int_» (-3) 2
+#eval Proof.«_<=Int_» (-3) (-2)
+#eval Proof.«_<=Int_» 3 2
+#eval «_==Bool_» true false
+#eval «_==Bool_» true true
+#eval Proof.«_==Int_» (-7) (-7)
+#eval Proof.«_==Int_» (-7) 7
+#eval «_=/=Int_» (-7) (-7)
+#eval «_=/=Int_» (-7) 7
+#eval Proof.«_/Int_» (-7) 3
+#eval Proof.«_/Int_» 7 (-3)
+#eval Proof.«_/Int_» (-7) (-3)
+#eval «pyMod(_,_)_MPY-INT_Int_Int_Int» (-7) 3
+#eval «pyMod(_,_)_MPY-INT_Int_Int_Int» 7 (-3)
+#eval «pyMod(_,_)_MPY-INT_Int_Int_Int» (-7) (-3)
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 1 4
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 0 0
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 0 2
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 81 3
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 82 3
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» (-8) (-2)
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 8 (-2)
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 16 (-2)
+
+example : _andBool_ true true ≠ false := by decide
+example : _orBool_ false true ≠ false := by decide
+example : Proof.«_>=Int_» 2 2 ≠ false := by decide
+example : Proof.«_<=Int_» (-2) (-2) ≠ false := by decide
+example : «_==Bool_» true true ≠ false := by decide
+example : Proof.«_==Int_» 0 0 ≠ false := by decide
+example : «_=/=Int_» 0 1 ≠ false := by decide
+example : Proof.«_/Int_» 4 2 ≠ 4 := by decide
+example : «pyMod(_,_)_MPY-INT_Int_Int_Int» 3 2 ≠ 0 := by decide
+example :
