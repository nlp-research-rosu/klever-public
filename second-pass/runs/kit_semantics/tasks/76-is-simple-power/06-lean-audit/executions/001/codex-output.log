+import Proof
+
+open Proof
+
+#eval _andBool_ true false
+#eval _andBool_ true true
+#eval _orBool_ false true
+#eval _orBool_ false false
+#eval Proof.«_>=Int_» (-2) (-2)
+#eval Proof.«_>=Int_» (-3) 2
+#eval Proof.«_<=Int_» (-3) (-2)
+#eval Proof.«_<=Int_» 3 2
+#eval «_==Bool_» true false
+#eval «_==Bool_» true true
+#eval Proof.«_==Int_» (-7) (-7)
+#eval Proof.«_==Int_» (-7) 7
+#eval «_=/=Int_» (-7) (-7)
+#eval «_=/=Int_» (-7) 7
+#eval Proof.«_/Int_» (-7) 3
+#eval Proof.«_/Int_» 7 (-3)
+#eval Proof.«_/Int_» (-7) (-3)
+#eval «pyMod(_,_)_MPY-INT_Int_Int_Int» (-7) 3
+#eval «pyMod(_,_)_MPY-INT_Int_Int_Int» 7 (-3)
+#eval «pyMod(_,_)_MPY-INT_Int_Int_Int» (-7) (-3)
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 1 4
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 0 0
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 0 2
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 81 3
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 82 3
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» (-8) (-2)
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 8 (-2)
+#eval «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 16 (-2)
+
+example : _andBool_ true true ≠ false := by decide
+example : _orBool_ false true ≠ false := by decide
+example : Proof.«_>=Int_» 2 2 ≠ false := by decide
+example : Proof.«_<=Int_» (-2) (-2) ≠ false := by decide
+example : «_==Bool_» true true ≠ false := by decide
+example : Proof.«_==Int_» 0 0 ≠ false := by decide
+example : «_=/=Int_» 0 1 ≠ false := by decide
+example : Proof.«_/Int_» 4 2 ≠ 4 := by decide
+example : «pyMod(_,_)_MPY-INT_Int_Int_Int» 3 2 ≠ 0 := by decide
+example :
+    «simplePower(_,_)_VERIFICATION_Bool_Int_Int» 1 4 ≠ false := by
+  rw [Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int».eq_def]
+  decide
diff --git a//tmp/audit-work/lean-proof-audit/Counterfactuals.lean b//tmp/audit-work/lean-proof-audit/Counterfactuals.lean
new file mode 100644
index 0000000000000000000000000000000000000000..5deebe18085a2774474e2e66997378118b53957c
--- /dev/null
+++ b//tmp/audit-work/lean-proof-audit/Counterfactuals.lean
@@ -0,0 +1,90 @@
+import Proof
+
+namespace Counterfactuals
+
+def badAnd (_a _b : SortBool) : SortBool := false
+def badOr (_a _b : SortBool) : SortBool := false
+def badEqBool (_a _b : SortBool) : SortBool := true
+def badNe (_a _b : SortInt) : SortBool := false
+def badDiv (a _b : SortInt) : SortInt := a
+
+theorem target_accepts_badAnd :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      badAnd
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  unfold Klean76IsSimplePower.Lemmas.targetStatement
+  constructor <;> intro n x h <;> simp [badAnd] at h
+
+theorem target_accepts_badOr :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      badOr
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  unfold Klean76IsSimplePower.Lemmas.targetStatement
+  constructor <;> intro n x h <;>
+    simp [badOr, Proof._andBool_] at h
+
+theorem target_accepts_badEqBool :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      badEqBool
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  have good := Proof.final
+  unfold Klean76IsSimplePower.Lemmas.targetStatement at good ⊢
+  exact ⟨by intro n x h; rfl, good.2⟩
+
+theorem target_accepts_badNe :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      badNe
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  unfold Klean76IsSimplePower.Lemmas.targetStatement
+  constructor <;> intro n x h <;>
+    simp [badNe, Proof._andBool_] at h
+
+theorem target_accepts_badDiv :
+    Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      badDiv
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  have good := Proof.final
+  unfold Klean76IsSimplePower.Lemmas.targetStatement at good ⊢
+  exact ⟨good.1, by intro n x h; rfl⟩
+
+end Counterfactuals
