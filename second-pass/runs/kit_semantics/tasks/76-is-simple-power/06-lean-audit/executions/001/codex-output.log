new file mode 100644
index 0000000000000000000000000000000000000000..d5f04520dcf5965295077992254eb518e496a088
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
