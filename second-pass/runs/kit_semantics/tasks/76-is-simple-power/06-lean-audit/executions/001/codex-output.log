@@ -0,0 +1,71 @@
+import Proof
+
+namespace RejectedCounterfactuals
+
+def badEqInt (_a _b : SortInt) : SortBool := false
+def badMod (_a _b : SortInt) : SortInt := 0
+def badSimplePower (_x _n : SortInt) : SortBool := false
+
+theorem target_rejects_badEqInt :
+    ¬ Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      badEqInt
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  intro alleged
+  unfold Klean76IsSimplePower.Lemmas.targetStatement at alleged
+  have contradiction := alleged.1 2 1 (by native_decide)
+  rw [Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int».eq_def] at contradiction
+  change false = true at contradiction
+  exact Bool.noConfusion contradiction
+
+theorem target_rejects_badMod :
+    ¬ Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      badMod
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» := by
+  intro alleged
+  unfold Klean76IsSimplePower.Lemmas.targetStatement at alleged
+  have contradiction := alleged.2 2 3 (by native_decide)
+  have left_eval :
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int» 3 2 = false := by
+    native_decide
+  have right_eval :
+      Proof.«simplePower(_,_)_VERIFICATION_Bool_Int_Int»
+        (Proof.«_/Int_» 3 2) 2 = true := by
+    native_decide
+  rw [left_eval, right_eval] at contradiction
+  exact Bool.noConfusion contradiction
+
+theorem target_rejects_badSimplePower :
+    ¬ Klean76IsSimplePower.Lemmas.targetStatement
+      Proof._andBool_
+      Proof._orBool_
+      Proof.«_>=Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Bool_»
+      Proof.«_==Int_»
+      Proof.«_=/=Int_»
+      Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int»
+      badSimplePower := by
+  intro alleged
+  unfold Klean76IsSimplePower.Lemmas.targetStatement at alleged
+  have contradiction := alleged.1 2 1 (by native_decide)
+  change false = true at contradiction
+  exact Bool.noConfusion contradiction
+
+end RejectedCounterfactuals
