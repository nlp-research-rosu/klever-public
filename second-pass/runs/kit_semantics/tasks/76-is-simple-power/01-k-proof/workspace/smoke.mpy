Module(
  FuncDef("is_simple_power", Params("x", "n"),
    If(Compare(Name("x"), CmpOp("==", Int(1))),
      Return(Bool(true)),
      )
    If(Compare(Name("n"), CmpOp("==", Int(0))),
      Return(Compare(Name("x"), CmpOp("==", Int(0)))),
      )
    If(Compare(Name("n"), CmpOp("==", Int(1))),
      Return(Bool(false)),
      )
    If(Compare(Name("n"), CmpOp("==", UnaryOp("-", Int(1)))),
      Return(Compare(Name("x"), CmpOp("==", UnaryOp("-", Int(1))))),
      )
    If(Compare(Name("x"), CmpOp("==", Int(0))),
      Return(Bool(false)),
      )
    While(Compare(BinOp("%", Name("x"), Name("n")), CmpOp("==", Int(0))),
      Assign(Name("x"), BinOp("//", Name("x"), Name("n"))))
    Return(Compare(Name("x"), CmpOp("==", Int(1)))))
  Assert(Call(Name("is_simple_power"), Int(1), Int(4)))
  Assert(Call(Name("is_simple_power"), Int(2), Int(2)))
  Assert(Call(Name("is_simple_power"), Int(8), Int(2)))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(3), Int(2))))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(3), Int(1))))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(5), Int(3))))
  Assert(Call(Name("is_simple_power"), Int(0), Int(0)))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(0), Int(2))))
  Assert(
    Call(
      Name("is_simple_power"),
      UnaryOp("-", Int(1)),
      UnaryOp("-", Int(1))))
  Assert(
    Call(
      Name("is_simple_power"),
      UnaryOp("-", Int(8)),
      UnaryOp("-", Int(2))))
  Assert(Call(Name("is_simple_power"), Int(16), UnaryOp("-", Int(2))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("is_simple_power"), Int(8), UnaryOp("-", Int(2))))))
