+def «_<=Int_» (a b : SortInt) : SortBool := decide (a ≤ b)
+def «_==Bool_» (a b : SortBool) : SortBool := a == b
+def «_==Int_» (a b : SortInt) : SortBool := a == b
+def «_=/=Int_» (a b : SortInt) : SortBool := a != b
+def «_/Int_» (a b : SortInt) : SortInt := Int.tdiv a b
