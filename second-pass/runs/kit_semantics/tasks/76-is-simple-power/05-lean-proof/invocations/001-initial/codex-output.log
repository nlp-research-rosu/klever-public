diff --git a//tmp/Test.lean b//tmp/Test.lean
new file mode 100644
index 0000000000000000000000000000000000000000..27d730759c8349c64da9266d7c4c71e88842fa70
--- /dev/null
+++ b//tmp/Test.lean
@@ -0,0 +1,27 @@
+import Klean76IsSimplePower.Lemmas
+
+namespace Test
+
+def pyMod (x n : Int) : Int :=
+  Int.tmod (Int.tmod x n + n) n
+
+def simplePower (x n : Int) : Bool :=
+  if x == 1 then true
+  else if n == 0 then x == 0
+  else if n == 1 then false
+  else if n == -1 then x == -1
+  else if x == 0 then false
+  else if pyMod x n == 0 then simplePower (Int.tdiv x n) n
+  else false
+termination_by x.natAbs
+decreasing_by
+  simp at *
+  apply Nat.div_lt_self
+  · exact Int.natAbs_pos.mpr (by assumption)
+  · have hnabs_ne_one : n.natAbs ≠ 1 := by
+      intro hnabs
+      have hn := Int.natAbs_eq_iff.mp hnabs
+      rcases hn with hn | hn <;> omega
+    omega
+
+end Test
