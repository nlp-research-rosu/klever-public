-- Comparisons
def «_<=Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 <= x1)
def «_>=Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 >= x1)
def «_<Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 < x1)
