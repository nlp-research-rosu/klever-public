+    have hn0 : n ≠ 0 := by rcases hn with hn | hn <;> omega
+    have hn1 : n ≠ 1 := by rcases hn with hn | hn <;> omega
+    have hnm1 : n ≠ -1 := by rcases hn with hn | hn <;> omega
+    rw [«simplePower(_,_)_VERIFICATION_Bool_Int_Int».eq_def]
