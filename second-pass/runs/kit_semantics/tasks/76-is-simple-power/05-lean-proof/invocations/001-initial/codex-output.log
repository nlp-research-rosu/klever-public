diff --git a//tmp/lean-proc-compat.c b//tmp/lean-proc-compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..c97d2cf006b08107bb69cccfa0fae25216b0c5ac
--- /dev/null
+++ b//tmp/lean-proc-compat.c
@@ -0,0 +1,26 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  const char prefix[] = "/proc/";
+  const char suffix[] = "/exe";
+  const char *p = path;
+
+  if (strncmp(p, prefix, sizeof(prefix) - 1) == 0) {
+    p += sizeof(prefix) - 1;
+    if (isdigit((unsigned char)*p)) {
+      while (isdigit((unsigned char)*p)) {
+        ++p;
+      }
+      if (strcmp(p, suffix) == 0) {
+        path = "/proc/self/exe";
+      }
+    }
+  }
+
+  return syscall(SYS_readlink, path, buf, bufsiz);
+}

