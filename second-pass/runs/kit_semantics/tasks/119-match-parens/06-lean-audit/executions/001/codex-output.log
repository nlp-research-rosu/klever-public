codex
The failure is a container `/proc` namespace mismatch: processes see a namespace PID from `getpid()`, while `/proc/<pid>/exe` exposes the host PID; Lean 4.22 resolves its installation through that numeric path. I’m applying a narrowly scoped audit-only shim under `/tmp/audit-work` that retries only a failed `/proc/<digits>/exe` `readlink` as `/proc/self/exe`, then I’ll rerun the unmodified trusted preflight with the pinned toolchain.
apply patch
patch: completed
/tmp/audit-work/proc-self-readlink.c
diff --git a//tmp/audit-work/proc-self-readlink.c b//tmp/audit-work/proc-self-readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..f6e2ac34a93c523ca677e276f84f87e86baf262b
--- /dev/null
+++ b//tmp/audit-work/proc-self-readlink.c
@@ -0,0 +1,43 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_numeric_proc_exe(const char *path) {
+    static const char prefix[] = "/proc/";
+    static const char suffix[] = "/exe";
+    const size_t prefix_len = sizeof(prefix) - 1;
+    const size_t suffix_len = sizeof(suffix) - 1;
+    const size_t path_len = strlen(path);
+
+    if (path_len <= prefix_len + suffix_len ||
+        strncmp(path, prefix, prefix_len) != 0 ||
+        strcmp(path + path_len - suffix_len, suffix) != 0) {
+        return 0;
+    }
+    for (size_t i = prefix_len; i < path_len - suffix_len; ++i) {
+        if (path[i] < '0' || path[i] > '9') {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    ssize_t result = real_readlink(path, buffer, size);
+    if (result < 0 && errno == ENOENT && is_numeric_proc_exe(path)) {
+        result = real_readlink("/proc/self/exe", buffer, size);
+    }
+    return result;
+}

