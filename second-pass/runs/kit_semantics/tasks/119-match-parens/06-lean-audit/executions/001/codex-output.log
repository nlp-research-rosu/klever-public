{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 8,
      "module": "VERIFICATION",
      "normalized_sha256": "4609be74f349b9d2f60faded6251a9fb39d17a009bfd082839b47e4ff1bccab3",
      "rationale": "Base equation defining parenCodes on the empty IntSeq.",
      "source_rule_id": "rule-4609be74f349b9d2f60faded6251a9fb39d17a009bfd082839b47e4ff1bccab3",
      "start_line": 8,
      "text": "  rule parenCodes(.IntSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "c3be2d57bade9daaa3e1441280463209745e19e02f30c04aecd38ee933245179",
      "rationale": "Structural recurrence defining parenCodes on a nonempty IntSeq.",
      "source_rule_id": "rule-c3be2d57bade9daaa3e1441280463209745e19e02f30c04aecd38ee933245179",
      "start_line": 9,
      "text": "  rule parenCodes(iCons(C:Int, CS:IntSeq))\n    => (C ==Int 40 orBool C ==Int 41) andBool parenCodes(CS)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "b6d2de879ce6a42ecc593047f4ecbb0ec29380011af0366e44b95db190aab1f1",
      "rationale": "Guarded defining case of nextBalance for the open-parenthesis code; its simplification attribute implements this definition.",
      "source_rule_id": "rule-b6d2de879ce6a42ecc593047f4ecbb0ec29380011af0366e44b95db190aab1f1",
      "start_line": 15,
      "text": "  rule nextBalance(C:Int, B:Int) => B +Int 1\n    requires C ==Int 40\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 20,
      "module": "VERIFICATION",
      "normalized_sha256": "7843f23248a83aa689c9e2d0c876b9fcddb26a32934caa02f79fb483451a2724",
      "rationale": "Complementary guarded defining case of nextBalance for every non-open-parenthesis code; its simplification attribute implements this definition.",
      "source_rule_id": "rule-7843f23248a83aa689c9e2d0c876b9fcddb26a32934caa02f79fb483451a2724",
      "start_line": 18,
      "text": "  rule nextBalance(C:Int, B:Int) => B -Int 1\n    requires C =/=Int 40\n    [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "0e38846df394779bb3fb4a85476ff4cbf6d43a01cc0fa6f7304963bfcfd968d2",
      "rationale": "Base equation defining scanBalance on the empty sequence.",
      "source_rule_id": "rule-0e38846df394779bb3fb4a85476ff4cbf6d43a01cc0fa6f7304963bfcfd968d2",
      "start_line": 23,
      "text": "  rule scanBalance(.IntSeq, B:Int) => B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "bfca0ed0a7a4870fdf91875932d6b094ee9e5ff3f85af3b8d3e35a86538a6077",
      "rationale": "Structural recurrence defining scanBalance by consuming one character through nextBalance.",
      "source_rule_id": "rule-bfca0ed0a7a4870fdf91875932d6b094ee9e5ff3f85af3b8d3e35a86538a6077",
      "start_line": 24,
      "text": "  rule scanBalance(iCons(C:Int, CS:IntSeq), B:Int)\n    => scanBalance(CS, nextBalance(C, B))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "9bf9f3d91b248daaeed9b993cf6db257840fcdd81e9685be7203fbb05064bb6c",
      "rationale": "Guarded defining case of nextMinimum when the new balance is below the previous minimum.",
      "source_rule_id": "rule-9bf9f3d91b248daaeed9b993cf6db257840fcdd81e9685be7203fbb05064bb6c",
      "start_line": 28,
      "text": "  rule nextMinimum(N:Int, M:Int) => N\n    requires N <Int M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "56e2b296601c10402ad3ec2faa60c6ca2e8f83f7b8e6d7c280c07f13acc7b284",
      "rationale": "Complementary guarded defining case of nextMinimum when the previous minimum is retained.",
      "source_rule_id": "rule-56e2b296601c10402ad3ec2faa60c6ca2e8f83f7b8e6d7c280c07f13acc7b284",
      "start_line": 30,
      "text": "  rule nextMinimum(N:Int, M:Int) => M\n    requires N >=Int M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "a4881d3130bf566fa71aa8905022d2bb5a930239d96807b90ccbb86dc61cc964",
      "rationale": "Base equation defining scanMinimum on the empty sequence.",
      "source_rule_id": "rule-a4881d3130bf566fa71aa8905022d2bb5a930239d96807b90ccbb86dc61cc964",
      "start_line": 34,
      "text": "  rule scanMinimum(.IntSeq, _B:Int, M:Int) => M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "ad70ae191b069a74d8e5ea1ff3c27d4cf53b7e7959ca2e8d196c909a99e5256b",
      "rationale": "Structural recurrence defining scanMinimum from the next balance and next minimum.",
      "source_rule_id": "rule-ad70ae191b069a74d8e5ea1ff3c27d4cf53b7e7959ca2e8d196c909a99e5256b",
      "start_line": 35,
      "text": "  rule scanMinimum(iCons(C:Int, CS:IntSeq), B:Int, M:Int)\n    => scanMinimum(\n         CS,\n         nextBalance(C, B),\n         nextMinimum(nextBalance(C, B), M))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 42,
      "module": "VERIFICATION",
      "normalized_sha256": "f6c2f17e4bd576424ce9d4178d4233bdf70bcf5add1a6b523dc666d81c792da8",
      "rationale": "Base equation defining scanLast to preserve the prior loop-target value for an empty sequence.",
      "source_rule_id": "rule-f6c2f17e4bd576424ce9d4178d4233bdf70bcf5add1a6b523dc666d81c792da8",
      "start_line": 42,
      "text": "  rule scanLast(.IntSeq, OLD:Val) => OLD"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "053a908a90151c59769ed110c5a3c78ab341cc96b9334952ec9317291a96bbd8",
      "rationale": "Structural recurrence defining scanLast by advancing the loop-target value to the current character.",
      "source_rule_id": "rule-053a908a90151c59769ed110c5a3c78ab341cc96b9334952ec9317291a96bbd8",
      "start_line": 43,
      "text": "  rule scanLast(iCons(C:Int, CS:IntSeq), _OLD:Val)\n    => scanLast(CS, str(iCons(C, .IntSeq)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 51,
      "module": "VERIFICATION",
      "normalized_sha256": "7e7b01e588156d9201f6b1aeded3114bb6e4e7e21149c984ffec887313170057",
      "rationale": "Equation defining the named goodParens predicate from final balance and minimum prefix balance.",
      "source_rule_id": "rule-7e7b01e588156d9201f6b1aeded3114bb6e4e7e21149c984ffec887313170057",
      "start_line": 49,
      "text": "  rule goodParens(CS:IntSeq)\n    => scanBalance(CS, 0) ==Int 0\n       andBool scanMinimum(CS, 0, 0) >=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 55,
      "module": "VERIFICATION",
      "normalized_sha256": "d820f60d586a5400f2e5fe283d81a9b43a64f5975fb61a190b68afde83afd19e",
      "rationale": "Equation defining possibleMatch as goodness of either concatenation order.",
      "source_rule_id": "rule-d820f60d586a5400f2e5fe283d81a9b43a64f5975fb61a190b68afde83afd19e",
      "start_line": 54,
      "text": "  rule possibleMatch(A:IntSeq, B:IntSeq)\n    => goodParens(seqConcat(A, B)) orBool goodParens(seqConcat(B, A))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 60,
      "module": "VERIFICATION",
      "normalized_sha256": "c43b7f4d00bca413fc20e062db6926be0ce762e14f9d9bab73a4425960271845",
      "rationale": "Positive guarded defining case of matchAnswer, yielding the code sequence for Yes.",
      "source_rule_id": "rule-c43b7f4d00bca413fc20e062db6926be0ce762e14f9d9bab73a4425960271845",
      "start_line": 58,
      "text": "  rule matchAnswer(A:IntSeq, B:IntSeq)\n    => str(iCons(89, iCons(101, iCons(115, .IntSeq))))\n    requires possibleMatch(A, B)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 63,
      "module": "VERIFICATION",
      "normalized_sha256": "926c4c0bbf4a8924b8e6a0e092377ef7832cf203ca19500a63c8838bfc20c53c",
      "rationale": "Complementary guarded defining case of matchAnswer, yielding the code sequence for No.",
      "source_rule_id": "rule-926c4c0bbf4a8924b8e6a0e092377ef7832cf203ca19500a63c8838bfc20c53c",
      "start_line": 61,
      "text": "  rule matchAnswer(A:IntSeq, B:IntSeq)\n    => str(iCons(78, iCons(111, .IntSeq)))\n    requires notBool possibleMatch(A, B)"
    }
  ],
