 'manifest_rule_count':len(manifest_ids),
 'canonical_unique_count':len(set(canonical_ids)),
 'manifest_unique_count':len(set(manifest_ids)),
 'missing_from_manifest':[x for x in canonical_ids if x not in set(manifest_ids)],
