from itertools import product

def scan(s):
    balance=0
    minimum=0
    last=''
    for ch in s:
        balance = balance + 1 if ord(ch)==40 else balance - 1
        minimum = min(balance,minimum)
        last=ch
    return balance,minimum,last

def source(a,b):
    for text in (a+b,b+a):
        balance=0
        minimum=0
        for ch in text:
            if ch=='(': balance += 1
            else: balance -= 1
            if balance < minimum: minimum=balance
        if balance==0 and minimum>=0: return 'Yes'
    return 'No'

def summary(a,b):
    possible=any((lambda q:q[0]==0 and q[1]>=0)(scan(text)) for text in (a+b,b+a))
    return 'Yes' if possible else 'No'

pairs=0
for la in range(7):
 for lb in range(7):
  for aa in product('()',repeat=la):
   for bb in product('()',repeat=lb):
    a=''.join(aa); b=''.join(bb); pairs+=1
    assert source(a,b)==summary(a,b)
print(f'exhaustive parenthesis pairs lengths 0..6: {pairs}, mismatches: 0')
for a,b in [('', ''),('(',')'),(')','('),(')',')'),('(()',')'),('(','(')]:
 print(repr((a,b)), 'scan(A+B)=',scan(a+b),'scan(B+A)=',scan(b+a),'result=',summary(a,b))
print('counterfactual wrong else +1 witness:', repr(')'), 'correct balance', scan(')')[0], 'mutated balance', 1)
print('counterfactual pre-update minimum witness:', repr(')'), 'correct minimum', scan(')')[1], 'mutated minimum', 0)
print('counterfactual first-order-only witness:', repr((')','(')), 'A+B good', False, 'B+A good', True, 'correct result', summary(')','('))
print('counterfactual constant-Yes witness:', repr((')',')')), 'correct result', summary(')',')'))
