+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-first]:
+    <k>
+      #loop(str(CS:IntSeq), Name("char1"),
+        If(Compare(Name("char1"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance1"), "+", Int(1)),
+          AugAssign(Name("balance1"), "-", Int(1)))
+        If(Compare(Name("balance1"), CmpOp("<", Name("minimum1"))),
+          Assign(Name("minimum1"), Name("balance1")),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "balance1" |-> (B:Int => scanBalance(CS, B))
+        "minimum1" |-> (M:Int => scanMinimum(CS, B, M))
+        "char1" |-> (OLD:Val => scanLast(CS, OLD))
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+
+  claim [loop-second]:
+    <k>
+      #loop(str(CS:IntSeq), Name("char2"),
+        If(Compare(Name("char2"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance2"), "+", Int(1)),
+          AugAssign(Name("balance2"), "-", Int(1)))
+        If(Compare(Name("balance2"), CmpOp("<", Name("minimum2"))),
+          Assign(Name("minimum2"), Name("balance2")),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "balance2" |-> (B:Int => scanBalance(CS, B))
+        "minimum2" |-> (M:Int => scanMinimum(CS, B, M))
+        "char2" |-> (OLD:Val => scanLast(CS, OLD))
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+
+  claim [match-parens]:
+    <k>
+      Call(Name("match_parens"),
+        list(vCons(str(A:IntSeq), vCons(str(B:IntSeq), .ValSeq))))
+      => ?RESULT:Str
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "match_parens" |->
+          closureVal("lst",
+            Assign(
+              Name("first"),
+              BinOp(
+                "+",
+                Subscript(Name("lst"), Int(0)),
+                Subscript(Name("lst"), Int(1))))
+            Assign(Name("balance1"), Int(0))
+            Assign(Name("minimum1"), Int(0))
+            Assign(Name("char1"), Str(""))
+            For(Name("char1"), Name("first"),
+              If(Compare(Name("char1"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance1"), "+", Int(1)),
+                AugAssign(Name("balance1"), "-", Int(1)))
+              If(Compare(Name("balance1"), CmpOp("<", Name("minimum1"))),
+                Assign(Name("minimum1"), Name("balance1")),
+                .Stmts))
+            If(Compare(Name("balance1"), CmpOp("==", Int(0))),
+              If(Compare(Name("minimum1"), CmpOp(">=", Int(0))),
+                Return(Str("Yes")),
+                .Stmts),
+              .Stmts)
+            Assign(
+              Name("second"),
+              BinOp(
+                "+",
+                Subscript(Name("lst"), Int(1)),
+                Subscript(Name("lst"), Int(0))))
+            Assign(Name("balance2"), Int(0))
+            Assign(Name("minimum2"), Int(0))
+            Assign(Name("char2"), Str(""))
+            For(Name("char2"), Name("second"),
+              If(Compare(Name("char2"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance2"), "+", Int(1)),
+                AugAssign(Name("balance2"), "-", Int(1)))
+              If(Compare(Name("balance2"), CmpOp("<", Name("minimum2"))),
+                Assign(Name("minimum2"), Name("balance2")),
+                .Stmts))
+            If(Compare(Name("balance2"), CmpOp("==", Int(0))),
+              If(Compare(Name("minimum2"), CmpOp(">=", Int(0))),
+                Return(Str("Yes")),
+                .Stmts),
+              .Stmts)
+            Return(Str("No")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parenCodes(A) andBool parenCodes(B)
+    ensures ?RESULT ==K matchAnswer(A, B)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..38c22d7538ece00e393ad57c1ffc8dc125951075
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,55 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly for strings in the prompt's input domain.
+  syntax Bool ::= parenCodes(IntSeq) [function, total]
+  rule parenCodes(.IntSeq) => true
+  rule parenCodes(iCons(C:Int, CS:IntSeq))
+    => (C ==Int 40 orBool C ==Int 41) andBool parenCodes(CS)
+
+  // Exact summaries of the source loop's three changing locals.
+  // Code 40 is '('; every other code follows the source program's else branch.
+  syntax Int ::= scanBalance(IntSeq, Int) [function, total]
+  rule scanBalance(.IntSeq, B:Int) => B
+  rule scanBalance(iCons(C:Int, CS:IntSeq), B:Int)
+    => scanBalance(CS, B +Int 1)
+    requires C ==Int 40
+  rule scanBalance(iCons(C:Int, CS:IntSeq), B:Int)
+    => scanBalance(CS, B -Int 1)
+    requires C =/=Int 40
+
+  syntax Int ::= scanMinimum(IntSeq, Int, Int) [function, total]
+  rule scanMinimum(.IntSeq, _B:Int, M:Int) => M
+  rule scanMinimum(iCons(C:Int, CS:IntSeq), B:Int, M:Int)
+    => scanMinimum(CS, B +Int 1, minInt(M, B +Int 1))
+    requires C ==Int 40
+  rule scanMinimum(iCons(C:Int, CS:IntSeq), B:Int, M:Int)
+    => scanMinimum(CS, B -Int 1, minInt(M, B -Int 1))
+    requires C =/=Int 40
+
+  syntax Val ::= scanLast(IntSeq, Val) [function, total]
+  rule scanLast(.IntSeq, OLD:Val) => OLD
+  rule scanLast(iCons(C:Int, CS:IntSeq), _OLD:Val)
+    => scanLast(CS, str(iCons(C, .IntSeq)))
+
+  // A parenthesis string is good iff its final balance is zero and no prefix
+  // has negative balance.
+  syntax Bool ::= goodParens(IntSeq) [function, total]
+  rule goodParens(CS:IntSeq)
+    => scanBalance(CS, 0) ==Int 0
+       andBool scanMinimum(CS, 0, 0) >=Int 0
+
+  syntax Bool ::= possibleMatch(IntSeq, IntSeq) [function, total]
+  rule possibleMatch(A:IntSeq, B:IntSeq)
+    => goodParens(seqConcat(A, B)) orBool goodParens(seqConcat(B, A))
+
+  syntax Str ::= matchAnswer(IntSeq, IntSeq) [function, total]
+  rule matchAnswer(A:IntSeq, B:IntSeq)
+    => str(iCons(89, iCons(101, iCons(115, .IntSeq))))
+    requires possibleMatch(A, B)
+  rule matchAnswer(A:IntSeq, B:IntSeq)
+    => str(iCons(78, iCons(111, .IntSeq)))
+    requires notBool possibleMatch(A, B)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-first' in /workspace
