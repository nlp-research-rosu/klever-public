+    balance2 = 0
+    minimum2 = 0
+    for char2 in second:
+        if char2 == '(':
+            balance2 += 1
+        else:
+            balance2 -= 1
+        if balance2 < minimum2:
+            minimum2 = balance2
+    if balance2 == 0:
+        if minimum2 >= 0:
+            return 'Yes'
+
+    return 'No'
+
+
