+        "first" |-> FIRST:Val
+        "balance1" |-> B1:Int
+        "minimum1" |-> M1:Int
+        "char1" |-> C1:Val
+        "second" |-> SECOND:Val
+        "balance2" |-> (B:Int => scanBalance(CS, B))
+        "minimum2" |-> (M:Int => scanMinimum(CS, B, M))
+        "char2" |-> (OLD:Val => scanLast(CS, OLD)),
+        P:Parent)
+      ...
+    </scopes>
+
+  claim [match-parens]:
+    <k>
+      Call(Name("match_parens"),
+        list(vCons(str(A:IntSeq), vCons(str(B:IntSeq), .ValSeq))))
+      => ?RESULT:Str
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "match_parens" |->
+          closureVal("lst",
+            Assign(
