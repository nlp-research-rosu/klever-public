new file mode 100644
index 0000000000000000000000000000000000000000..6c5c6a441d394493f7fffef70f28f31d330bf7f5
--- /dev/null
+++ b/krun-tests.py
@@ -0,0 +1,40 @@
+def match_parens(lst):
+    first = lst[0] + lst[1]
+    balance1 = 0
+    minimum1 = 0
+    char1 = ''
+    for char1 in first:
+        if char1 == '(':
+            balance1 += 1
+        else:
+            balance1 -= 1
+        if balance1 < minimum1:
+            minimum1 = balance1
+    if balance1 == 0:
+        if minimum1 >= 0:
+            return 'Yes'
+
+    second = lst[1] + lst[0]
+    balance2 = 0
+    minimum2 = 0
+    char2 = ''
+    for char2 in second:
+        if char2 == '(':
+            balance2 += 1
+        else:
+            balance2 -= 1
+        if balance2 < minimum2:
+            minimum2 = balance2
+    if balance2 == 0:
+        if minimum2 >= 0:
+            return 'Yes'
+
+    return 'No'
+
+
+assert match_parens(['()(', ')']) == 'Yes'
+assert match_parens([')', ')']) == 'No'
+assert match_parens(['', '']) == 'Yes'
+assert match_parens(['(', ')']) == 'Yes'
+assert match_parens([')', '(']) == 'Yes'
+assert match_parens(['(()', '(']) == 'No'
