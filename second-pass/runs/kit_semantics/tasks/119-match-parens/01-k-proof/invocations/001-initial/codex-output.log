+            return 'Yes'
+
+    return 'No'
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..54dc8ae8007360b598a7be939c108a8341b0b029
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,121 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-first]:
+    <k>
+      #loop(str(CS:IntSeq), Name("char"),
+        If(Compare(Name("char"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)),
+          AugAssign(Name("balance"), "-", Int(1)))
+        If(Compare(Name("balance"), CmpOp("<", Name("minimum"))),
+          Assign(Name("minimum"), Name("balance")),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "lst" |-> INPUT:Val
+        "text" |-> TEXT:Val
+        "balance" |-> (B:Int => scanBalance(CS, B))
+        "minimum" |-> (M:Int => scanMinimum(CS, B, M))
+        "char" |-> (OLD:Val => scanLast(CS, OLD)),
+        P:Parent)
+      ...
+    </scopes>
+
+  // The source contains a second syntactically identical scan.  This separate
+  // claim records and proves the invariant obligation for that occurrence.
+  claim [loop-second]:
+    <k>
+      #loop(str(CS:IntSeq), Name("char"),
+        If(Compare(Name("char"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)),
+          AugAssign(Name("balance"), "-", Int(1)))
+        If(Compare(Name("balance"), CmpOp("<", Name("minimum"))),
+          Assign(Name("minimum"), Name("balance")),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "lst" |-> INPUT:Val
+        "text" |-> TEXT:Val
+        "balance" |-> (B:Int => scanBalance(CS, B))
+        "minimum" |-> (M:Int => scanMinimum(CS, B, M))
+        "char" |-> (OLD:Val => scanLast(CS, OLD)),
+        P:Parent)
+      ...
+    </scopes>
+
+  claim [match-parens]:
+    <k>
+      Call(Name("match_parens"),
+        list(vCons(str(A:IntSeq), vCons(str(B:IntSeq), .ValSeq))))
+      => ?RESULT:Str
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "match_parens" |->
+          closureVal("lst",
+            Assign(
+              Name("text"),
+              BinOp(
+                "+",
+                Subscript(Name("lst"), Int(0)),
+                Subscript(Name("lst"), Int(1))))
+            Assign(Name("balance"), Int(0))
+            Assign(Name("minimum"), Int(0))
+            Assign(Name("char"), Str(""))
+            For(Name("char"), Name("text"),
+              If(Compare(Name("char"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Name("minimum"))),
+                Assign(Name("minimum"), Name("balance")),
+                .Stmts))
+            If(Compare(Name("balance"), CmpOp("==", Int(0))),
+              If(Compare(Name("minimum"), CmpOp(">=", Int(0))),
+                Return(Str("Yes")),
+                .Stmts),
+              .Stmts)
+            Assign(
+              Name("text"),
+              BinOp(
+                "+",
+                Subscript(Name("lst"), Int(1)),
+                Subscript(Name("lst"), Int(0))))
+            Assign(Name("balance"), Int(0))
+            Assign(Name("minimum"), Int(0))
+            Assign(Name("char"), Str(""))
+            For(Name("char"), Name("text"),
+              If(Compare(Name("char"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Name("minimum"))),
+                Assign(Name("minimum"), Name("balance")),
+                .Stmts))
+            If(Compare(Name("balance"), CmpOp("==", Int(0))),
+              If(Compare(Name("minimum"), CmpOp(">=", Int(0))),
+                Return(Str("Yes")),
+                .Stmts),
+              .Stmts)
+            Return(Str("No")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parenCodes(A) andBool parenCodes(B)
+    ensures ?RESULT ==K matchAnswer(A, B)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..63b5124ea13535a0e18cbea9e2eecb79a2725272
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,64 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly for strings in the prompt's input domain.
+  syntax Bool ::= parenCodes(IntSeq) [function, total]
+  rule parenCodes(.IntSeq) => true
+  rule parenCodes(iCons(C:Int, CS:IntSeq))
+    => (C ==Int 40 orBool C ==Int 41) andBool parenCodes(CS)
+
+  // Exact summaries of the source loop's three changing locals.
+  // Code 40 is '('; every other code follows the source program's else branch.
+  syntax Int ::= nextBalance(Int, Int) [function, total]
+  rule nextBalance(C:Int, B:Int) => B +Int 1
+    requires C ==Int 40
+    [simplification]
+  rule nextBalance(C:Int, B:Int) => B -Int 1
+    requires C =/=Int 40
+    [simplification]
+
+  syntax Int ::= scanBalance(IntSeq, Int) [function, total]
+  rule scanBalance(.IntSeq, B:Int) => B
+  rule scanBalance(iCons(C:Int, CS:IntSeq), B:Int)
+    => scanBalance(CS, nextBalance(C, B))
+
+  syntax Int ::= nextMinimum(Int, Int) [function, total]
+  rule nextMinimum(N:Int, M:Int) => N
+    requires N <Int M
+  rule nextMinimum(N:Int, M:Int) => M
+    requires N >=Int M
+
+  syntax Int ::= scanMinimum(IntSeq, Int, Int) [function, total]
+  rule scanMinimum(.IntSeq, _B:Int, M:Int) => M
+  rule scanMinimum(iCons(C:Int, CS:IntSeq), B:Int, M:Int)
+    => scanMinimum(
+         CS,
+         nextBalance(C, B),
+         nextMinimum(nextBalance(C, B), M))
+
+  syntax Val ::= scanLast(IntSeq, Val) [function, total]
+  rule scanLast(.IntSeq, OLD:Val) => OLD
+  rule scanLast(iCons(C:Int, CS:IntSeq), _OLD:Val)
+    => scanLast(CS, str(iCons(C, .IntSeq)))
+
+  // A parenthesis string is good iff its final balance is zero and no prefix
+  // has negative balance.
+  syntax Bool ::= goodParens(IntSeq) [function, total]
+  rule goodParens(CS:IntSeq)
+    => scanBalance(CS, 0) ==Int 0
+       andBool scanMinimum(CS, 0, 0) >=Int 0
+
+  syntax Bool ::= possibleMatch(IntSeq, IntSeq) [function, total]
+  rule possibleMatch(A:IntSeq, B:IntSeq)
+    => goodParens(seqConcat(A, B)) orBool goodParens(seqConcat(B, A))
+
+  syntax Str ::= matchAnswer(IntSeq, IntSeq) [function, total]
+  rule matchAnswer(A:IntSeq, B:IntSeq)
+    => str(iCons(89, iCons(101, iCons(115, .IntSeq))))
+    requires possibleMatch(A, B)
+  rule matchAnswer(A:IntSeq, B:IntSeq)
+    => str(iCons(78, iCons(111, .IntSeq)))
+    requires notBool possibleMatch(A, B)
+endmodule

diff --git a/check-krun-json.py b/check-krun-json.py
new file mode 100644
index 0000000000000000000000000000000000000000..a7dbf8e2649e2984e701eba6d5c1c0649444ed1b
--- /dev/null
+++ b/check-krun-json.py
@@ -0,0 +1,17 @@
+import json
+import sys
+
+
+document = json.load(sys.stdin)
+top = document['term']
+cells = {
+    argument['label']['name']: argument['args'][0]
+    for argument in top['args']
+    if argument.get('node') == 'KApply'
+}
+
+assert cells['<k>']['node'] == 'KSequence'
+assert cells['<k>']['arity'] == 0
+assert cells['<exc>']['label']['name'].startswith('NoExc')
+assert cells['<exit-code>']['token'] == '0'
+print('krun-json: .K, NoExc, exit-code 0')
diff --git a/differential-test.py b/differential-test.py
new file mode 100644
index 0000000000000000000000000000000000000000..55d83ccf572e38a7cfad0b27e9c516f996bf2e7e
--- /dev/null
+++ b/differential-test.py
@@ -0,0 +1,43 @@
+from itertools import product
+
+from solution import match_parens
+
+
+def is_balanced(text):
+    depth = 0
+    for character in text:
+        if character == '(':
+            depth += 1
+        else:
+            depth -= 1
+        if depth < 0:
+            return False
+    return depth == 0
+
+
+def oracle(pair):
+    left, right = pair
+    if is_balanced(left + right) or is_balanced(right + left):
+        return 'Yes'
+    return 'No'
+
+
+def paren_strings(length):
+    return (''.join(chars) for chars in product('()', repeat=length))
+
+
+checked = 0
+mismatches = []
+for left_length in range(11):
+    for right_length in range(11 - left_length):
+        for left in paren_strings(left_length):
+            for right in paren_strings(right_length):
+                pair = [left, right]
+                expected = oracle(pair)
+                actual = match_parens(pair)
+                checked += 1
+                if actual != expected:
+                    mismatches.append((pair, expected, actual))
+
+assert not mismatches, mismatches[:10]
+print(f'differential: {checked} pairs, {len(mismatches)} mismatches')
diff --git a/krun-tests.py b/krun-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..21a86def92c42f5497bbbc3cbae0a77a96d35500
--- /dev/null
+++ b/krun-tests.py
@@ -0,0 +1,40 @@
+def match_parens(lst):
+    text = lst[0] + lst[1]
+    balance = 0
+    minimum = 0
+    char = ''
+    for char in text:
+        if char == '(':
+            balance += 1
+        else:
+            balance -= 1
+        if balance < minimum:
+            minimum = balance
+    if balance == 0:
+        if minimum >= 0:
+            return 'Yes'
+
+    text = lst[1] + lst[0]
+    balance = 0
+    minimum = 0
+    char = ''
+    for char in text:
+        if char == '(':
+            balance += 1
+        else:
+            balance -= 1
+        if balance < minimum:
+            minimum = balance
+    if balance == 0:
+        if minimum >= 0:
+            return 'Yes'
+
+    return 'No'
+
+
+assert match_parens(['()(', ')']) == 'Yes'
+assert match_parens([')', ')']) == 'No'
+assert match_parens(['', '']) == 'Yes'
+assert match_parens(['(', ')']) == 'Yes'
+assert match_parens([')', '(']) == 'Yes'
+assert match_parens(['(()', '(']) == 'No'
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0f92c3e5572d2a8698c08a997f74cde717e4e451
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+python3 py2mpy.py krun-tests.py > krun-tests.mpy
+python3 - <<'PY'
+import ast
+from pathlib import Path
+
+solution = ast.parse(Path('solution.py').read_text()).body[0]
+harness = ast.parse(Path('krun-tests.py').read_text()).body[0]
+assert ast.dump(solution, include_attributes=False) == ast.dump(
+    harness, include_attributes=False
+)
+print('harness-body-identity: PASS')
+PY
+krun krun-tests.mpy --definition runtime-kompiled --output json \
+  | python3 check-krun-json.py
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-first
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-second
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+python3 differential-test.py
+
+sed \
+  -e 's/^module SPEC$/module SPEC-VACUITY/' \
+  -e 's/ensures ?RESULT ==K matchAnswer(A, B)/ensures ?RESULT ==K str(iCons(88, .IntSeq))/' \
+  spec.k > spec-vacuity.k
+sed \
+  -e 's/^module SPEC$/module SPEC-BODY-MUTATION/' \
+  -e 's/Return(Str("No"))/Return(Str("Yes"))/' \
+  spec.k > spec-body-mutation.k
+
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY 2>&1 | tee vacuity.log
+vacuity_status=${PIPESTATUS[0]}
+set -e
+if [[ ${vacuity_status} -eq 0 ]]; then
+  echo "ERROR: false-result mutation unexpectedly proved" >&2
+  exit 1
+fi
+rg -q 'WarnStuckClaimState' vacuity.log
+echo "vacuity mutation: EXPECTED FAILURE (exit ${vacuity_status})"
+
+set +e
+kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION 2>&1 | tee body-mutation.log
+body_status=${PIPESTATUS[0]}
+set -e
+if [[ ${body_status} -eq 0 ]]; then
+  echo "ERROR: body mutation unexpectedly proved" >&2
+  exit 1
+fi
+rg -q 'WarnStuckClaimState' body-mutation.log
+echo "body mutation: EXPECTED FAILURE (exit ${body_status})"
