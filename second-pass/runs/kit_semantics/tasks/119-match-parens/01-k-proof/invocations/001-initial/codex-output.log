+        "balance1" |-> (B:Int => scanBalance(CS, B))
+        "minimum1" |-> (M:Int => scanMinimum(CS, B, M))
+        "char1" |-> (OLD:Val => scanLast(CS, OLD))
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    requires notBool (
+      "$cells" in_keys(
+        "balance1" |-> B
+        "minimum1" |-> M
+        "char1" |-> OLD
+        REST))
+
+  claim [loop-second]:
+    <k>
