@@ -0,0 +1,121 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-first]:
+    <k>
+      #loop(str(CS:IntSeq), Name("char"),
+        If(Compare(Name("char"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)),
+          AugAssign(Name("balance"), "-", Int(1)))
+        If(Compare(Name("balance"), CmpOp("<", Name("minimum"))),
+          Assign(Name("minimum"), Name("balance")),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "lst" |-> INPUT:Val
+        "text" |-> TEXT:Val
+        "balance" |-> (B:Int => scanBalance(CS, B))
+        "minimum" |-> (M:Int => scanMinimum(CS, B, M))
+        "char" |-> (OLD:Val => scanLast(CS, OLD)),
+        P:Parent)
+      ...
+    </scopes>
+
+  // The source contains a second syntactically identical scan.  This separate
+  // claim records and proves the invariant obligation for that occurrence.
+  claim [loop-second]:
+    <k>
+      #loop(str(CS:IntSeq), Name("char"),
+        If(Compare(Name("char"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)),
+          AugAssign(Name("balance"), "-", Int(1)))
+        If(Compare(Name("balance"), CmpOp("<", Name("minimum"))),
+          Assign(Name("minimum"), Name("balance")),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "lst" |-> INPUT:Val
+        "text" |-> TEXT:Val
+        "balance" |-> (B:Int => scanBalance(CS, B))
+        "minimum" |-> (M:Int => scanMinimum(CS, B, M))
+        "char" |-> (OLD:Val => scanLast(CS, OLD)),
+        P:Parent)
+      ...
+    </scopes>
+
+  claim [match-parens]:
+    <k>
+      Call(Name("match_parens"),
+        list(vCons(str(A:IntSeq), vCons(str(B:IntSeq), .ValSeq))))
+      => ?RESULT:Str
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "match_parens" |->
+          closureVal("lst",
+            Assign(
+              Name("text"),
+              BinOp(
+                "+",
+                Subscript(Name("lst"), Int(0)),
+                Subscript(Name("lst"), Int(1))))
+            Assign(Name("balance"), Int(0))
+            Assign(Name("minimum"), Int(0))
+            Assign(Name("char"), Str(""))
+            For(Name("char"), Name("text"),
+              If(Compare(Name("char"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Name("minimum"))),
+                Assign(Name("minimum"), Name("balance")),
+                .Stmts))
+            If(Compare(Name("balance"), CmpOp("==", Int(0))),
+              If(Compare(Name("minimum"), CmpOp(">=", Int(0))),
+                Return(Str("Yes")),
+                .Stmts),
+              .Stmts)
+            Assign(
+              Name("text"),
+              BinOp(
+                "+",
+                Subscript(Name("lst"), Int(1)),
+                Subscript(Name("lst"), Int(0))))
+            Assign(Name("balance"), Int(0))
+            Assign(Name("minimum"), Int(0))
+            Assign(Name("char"), Str(""))
+            For(Name("char"), Name("text"),
+              If(Compare(Name("char"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Name("minimum"))),
+                Assign(Name("minimum"), Name("balance")),
+                .Stmts))
+            If(Compare(Name("balance"), CmpOp("==", Int(0))),
+              If(Compare(Name("minimum"), CmpOp(">=", Int(0))),
+                Return(Str("Yes")),
+                .Stmts),
+              .Stmts)
+            Return(Str("No")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parenCodes(A) andBool parenCodes(B)
+    ensures ?RESULT ==K matchAnswer(A, B)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..63b5124ea13535a0e18cbea9e2eecb79a2725272
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,64 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // True exactly for strings in the prompt's input domain.
+  syntax Bool ::= parenCodes(IntSeq) [function, total]
+  rule parenCodes(.IntSeq) => true
+  rule parenCodes(iCons(C:Int, CS:IntSeq))
+    => (C ==Int 40 orBool C ==Int 41) andBool parenCodes(CS)
+
+  // Exact summaries of the source loop's three changing locals.
+  // Code 40 is '('; every other code follows the source program's else branch.
+  syntax Int ::= nextBalance(Int, Int) [function, total]
+  rule nextBalance(C:Int, B:Int) => B +Int 1
+    requires C ==Int 40
+    [simplification]
+  rule nextBalance(C:Int, B:Int) => B -Int 1
+    requires C =/=Int 40
+    [simplification]
+
+  syntax Int ::= scanBalance(IntSeq, Int) [function, total]
+  rule scanBalance(.IntSeq, B:Int) => B
+  rule scanBalance(iCons(C:Int, CS:IntSeq), B:Int)
+    => scanBalance(CS, nextBalance(C, B))
+
+  syntax Int ::= nextMinimum(Int, Int) [function, total]
+  rule nextMinimum(N:Int, M:Int) => N
+    requires N <Int M
+  rule nextMinimum(N:Int, M:Int) => M
+    requires N >=Int M
+
+  syntax Int ::= scanMinimum(IntSeq, Int, Int) [function, total]
+  rule scanMinimum(.IntSeq, _B:Int, M:Int) => M
+  rule scanMinimum(iCons(C:Int, CS:IntSeq), B:Int, M:Int)
+    => scanMinimum(
+         CS,
+         nextBalance(C, B),
+         nextMinimum(nextBalance(C, B), M))
+
+  syntax Val ::= scanLast(IntSeq, Val) [function, total]
+  rule scanLast(.IntSeq, OLD:Val) => OLD
+  rule scanLast(iCons(C:Int, CS:IntSeq), _OLD:Val)
+    => scanLast(CS, str(iCons(C, .IntSeq)))
+
+  // A parenthesis string is good iff its final balance is zero and no prefix
+  // has negative balance.
+  syntax Bool ::= goodParens(IntSeq) [function, total]
+  rule goodParens(CS:IntSeq)
+    => scanBalance(CS, 0) ==Int 0
+       andBool scanMinimum(CS, 0, 0) >=Int 0
+
+  syntax Bool ::= possibleMatch(IntSeq, IntSeq) [function, total]
+  rule possibleMatch(A:IntSeq, B:IntSeq)
+    => goodParens(seqConcat(A, B)) orBool goodParens(seqConcat(B, A))
+
+  syntax Str ::= matchAnswer(IntSeq, IntSeq) [function, total]
+  rule matchAnswer(A:IntSeq, B:IntSeq)
+    => str(iCons(89, iCons(101, iCons(115, .IntSeq))))
+    requires possibleMatch(A, B)
+  rule matchAnswer(A:IntSeq, B:IntSeq)
+    => str(iCons(78, iCons(111, .IntSeq)))
+    requires notBool possibleMatch(A, B)
+endmodule

