+def match_parens(lst):
+    first = lst[0] + lst[1]
+    balance1 = 0
+    minimum1 = 0
+    for char1 in first:
+        if char1 == '(':
+            balance1 += 1
+        else:
+            balance1 -= 1
+        if balance1 < minimum1:
+            minimum1 = balance1
+    if balance1 == 0:
