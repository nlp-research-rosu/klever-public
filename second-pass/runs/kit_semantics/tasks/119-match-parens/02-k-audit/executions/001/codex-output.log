find /audit-output/evidence -maxdepth 1 -type f -printf '%f %s bytes\\n' | sort
rg -n '"'^#|''^##|''^VERDICT:|''^LEGITIMACY:'"' /audit-output/REVIEW.md
rg -n '"'^#Top$|EXIT_STATUS'"' /audit-output/evidence/stage3_kprove_*.log
