+generated = import_entry(
+    "scratch_generated", Path("/tmp/audit-work/119-match-parens/solution.py")
+)
+
+named_cases = [
+    ("prompt_yes", ["()(", ")"]),
+    ("prompt_no", [")", ")"]),
+    ("both_empty", ["", ""]),
+    ("first_order_only", ["(", ")"]),
+    ("second_order_only", [")", "("]),
+    ("both_orders_good", ["()", "(())"]),
+    ("positive_final_balance", ["(", "("]),
+    ("negative_final_balance", [")", ")"]),
+    ("zero_balance_bad_prefix_both_orders", [")(", ")("]),
+    ("empty_left_boundary", ["", "()"]),
+    ("empty_right_boundary", ["()", ""]),
+    ("deep_prefix", ["(((", ")))"]),
+]
+
