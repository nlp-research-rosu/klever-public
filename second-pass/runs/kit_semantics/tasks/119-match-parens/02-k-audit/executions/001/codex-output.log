+```bash
+sed -e 's/^module SPEC$/module SPEC-BODY-REVIEW/' \
+  -e 's/            Return(Str("No")),/            Return(Str("Yes")),/' \
+  spec.k > spec-body-review.k
+kprove spec-body-review.k --definition proof-kompiled \
