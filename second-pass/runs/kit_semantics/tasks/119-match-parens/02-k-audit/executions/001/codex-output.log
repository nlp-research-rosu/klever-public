+                actual = generated(pair)
+                assert actual == expected, (pair, expected, actual)
+                outcome_counts[actual] += 1
+                checked += 1
+
+print(
+    f"exhaustive combined_length<=10: {checked} pairs, "
+    f"Yes={outcome_counts['Yes']}, No={outcome_counts['No']}, mismatches=0"
+)
