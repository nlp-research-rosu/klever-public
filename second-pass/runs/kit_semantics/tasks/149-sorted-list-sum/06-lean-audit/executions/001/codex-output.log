diff --git a//tmp/audit-work/OperationalBridgeAudit.lean b//tmp/audit-work/OperationalBridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..2396c5974bbb0b97e6fd2c54d12c7060d66b3de1
--- /dev/null
+++ b//tmp/audit-work/OperationalBridgeAudit.lean
@@ -0,0 +1,114 @@
+import Proof
+
+namespace OperationalBridgeAudit
+
+def emptyIS : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def twoIS : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 65
+    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 66 emptyIS)
+
+def emptyVS : SortValSeq :=
+  SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+def twoVS : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+    SortVal.«noneV_MPY-CORE_Val»
+    (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+      SortVal.«noneV_MPY-CORE_Val» emptyVS)
+
+def directString : SortVal :=
+  SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» twoIS)
+
+def emptyString : SortVal :=
+  SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» emptyIS)
+
+def integerValue : SortVal :=
+  SortVal.inj_SortInt 7
+
+def listValue : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» twoVS)
+
+def tupleValue : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» twoVS)
+
+def setValue : SortVal :=
+  SortVal.«setV(_)_MPY-SET_Val_IntSeq» twoIS
+
+def positiveRange : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 0 5 2)
+
+def negativeRange : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 5 0 (-2))
+
+def emptyPositiveRange : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 5 0 2)
+
+def emptyNegativeRange : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 0 5 (-2))
+
+def zeroStepRange : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» 0 5 0)
+
+-- Raw noncanonical nested injection. The generated Inj instance canonicalizes
+-- this shape to SortVal.inj_SortStr whenever SortIterable is injected to Val.
+def rawNestedString : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.inj_SortStr
+      (SortStr.«str(_)_MPY-CORE_Str_IntSeq» twoIS))
+
+#eval Proof.«isStrV(_)_MPY-BUILTINS_Bool_Val» directString
+#eval Proof.«isStrV(_)_MPY-BUILTINS_Bool_Val» integerValue
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» emptyString
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» directString
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» listValue
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» tupleValue
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» setValue
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» positiveRange
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» negativeRange
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» emptyPositiveRange
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» emptyNegativeRange
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» zeroStepRange
+#eval Proof.«isStrV(_)_MPY-BUILTINS_Bool_Val» rawNestedString
+#eval Proof.«seqLen(_)_MPY-BUILTINS_Int_Val?» rawNestedString
+
+-- Counterfactuals demonstrating why the clean theorem alone cannot validate
+-- the bridge definitions.
+def falseIsStr (_ : SortVal) : SortBool := false
+def noneSeq (_ : SortVal) : Option SortInt := none
+
+theorem false_isStr_makes_target_vacuous :
+    Klean149SortedListSum.Lemmas.targetStatement falseIsStr noneSeq := by
+  intro value impossible
+  exact Bool.noConfusion impossible
+
+def hardcodedStringDefined : SortVal → Option SortInt
+  | SortVal.inj_SortStr _ => some 0
+  | _ => none
+
+theorem hardcoded_string_value_still_passes_definedness_target :
+    Klean149SortedListSum.Lemmas.targetStatement
+      Proof.«isStrV(_)_MPY-BUILTINS_Bool_Val»
+      hardcodedStringDefined := by
+  intro value isString
+  cases value <;> try { exact Bool.noConfusion isString }
+  case inj_SortStr string =>
+    cases string
+    exact ⟨fun _ => True.intro, fun _ => rfl⟩
+
+theorem honest_isStr_with_noneSeq_is_rejected :
+    ¬ Klean149SortedListSum.Lemmas.targetStatement
+      Proof.«isStrV(_)_MPY-BUILTINS_Bool_Val» noneSeq := by
+  intro claimed
+  have result := claimed emptyString rfl
+  simp [noneSeq] at result
+
+end OperationalBridgeAudit
diff --git a//tmp/audit-work/proc_exe_compat.c b//tmp/audit-work/proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..54b3facb2c986a06308623bc7d3dd048cacf0815
--- /dev/null
+++ b//tmp/audit-work/proc_exe_compat.c
@@ -0,0 +1,38 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+  const char *cursor;
+  if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+    return 0;
+  }
+  cursor = path + 6;
+  if (*cursor < '0' || *cursor > '9') {
+    return 0;
+  }
+  while (*cursor >= '0' && *cursor <= '9') {
+    cursor++;
+  }
+  return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    if (real_readlink == NULL) {
+      errno = ENOSYS;
+      return -1;
+    }
+  }
+  if (is_proc_pid_exe(path)) {
+    path = "/proc/self/exe";
+  }
+  return real_readlink(path, buffer, size);
+}
