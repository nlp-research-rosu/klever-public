/reference/k-proof/reference-semantics/semantics/builtins.k-18-
/reference/k-proof/reference-semantics/semantics/builtins.k-19-  // ==== len(obj) — O(1) per kind ============================================
/reference/k-proof/reference-semantics/semantics/builtins.k:20:  syntax Int ::= seqLen(Val) [function]
/reference/k-proof/reference-semantics/semantics/builtins.k:21:  rule applyBuiltin("len", OBJ:Val, .Vals) => seqLen(OBJ)
/reference/k-proof/reference-semantics/semantics/builtins.k:22:  rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
/reference/k-proof/reference-semantics/semantics/builtins.k:23:  rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
/reference/k-proof/reference-semantics/semantics/builtins.k:24:  rule seqLen(str(IS:IntSeq))                   => isLen(IS)
/reference/k-proof/reference-semantics/semantics/builtins.k:25:  rule seqLen(setV(DS:IntSeq))                  => isLen(DS)
/reference/k-proof/reference-semantics/semantics/builtins.k:26:  rule seqLen(rangeObj(LO:Int, HI:Int, ST:Int)) => rangeLen(LO, HI, ST)
