diff --git a//tmp/codex-hostpid.c b//tmp/codex-hostpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..51cf5e945f14db96902f7d1f4c0b9ef49288f28d
--- /dev/null
+++ b//tmp/codex-hostpid.c
@@ -0,0 +1,34 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  char buffer[8192];
+  int fd = open("/proc/self/status", O_RDONLY);
+  if (fd >= 0) {
+    ssize_t size = read(fd, buffer, sizeof(buffer) - 1);
+    close(fd);
+    if (size > 0) {
+      buffer[size] = '\0';
+      for (ssize_t i = 0; i + 6 < size; ++i) {
+        if (buffer[i] == 'N' && buffer[i + 1] == 'S' &&
+            buffer[i + 2] == 'p' && buffer[i + 3] == 'i' &&
+            buffer[i + 4] == 'd' && buffer[i + 5] == ':') {
+          i += 6;
+          while (i < size && (buffer[i] == ' ' || buffer[i] == '\t'))
+            ++i;
+          pid_t result = 0;
+          while (i < size && buffer[i] >= '0' && buffer[i] <= '9') {
+            result = result * 10 + (buffer[i] - '0');
+            ++i;
+          }
+          if (result > 0)
+            return result;
+          break;
+        }
+      }
+    }
+  }
+  return (pid_t)syscall(39);
+}
