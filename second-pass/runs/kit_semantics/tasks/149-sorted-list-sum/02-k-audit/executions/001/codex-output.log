+requires "spec.k"
+
+module REVIEWER-FALSE-SPEC
+  imports SPEC
+
+  // Fresh false mutation.  The satisfying input ["aa"] contains one even
+  // string, but this postcondition duplicates it in the returned list.
+  claim [duplicated-result-is-false]:
+    <k>
+      #loadAll(sortedListSumModule)
+      ~> Call(
+           Name("sorted_list_sum"),
+           list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq)))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "sorted_list_sum"
+                  |-> closureVal(
+                        ("lst", .ParamNames),
+                        sortedListSumBody,
+                        0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      1 |-> list(
+             sortVS(
+               vCons(
+                 str(iCons(97, iCons(97, .IntSeq))),
+                 .ValSeq)))
+      2 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               vCons(
+                 str(iCons(97, iCons(97, .IntSeq))),
+                 .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/149-sorted-list-sum/reviewer_smoke.py b//tmp/audit-work/149-sorted-list-sum/reviewer_smoke.py
