from pathlib import Path

def tree(root):
 root=Path(root); entries=[]
 for p in root.rglob('*'):
  m=p.lstat().st_mode
  k='directory' if stat.S_ISDIR(m) else 'file' if stat.S_ISREG(m) else 'other'
  entries.append((p.relative_to(root).as_posix(),k,p))
 d=hashlib.sha256()
 for r,k,p in sorted(entries):
  d.update(r.encode()+b'\\0'+k.encode()+b'\\0')
  if k=='file': d.update(p.read_bytes())
 print(root,d.hexdigest())
for p in ['/reference/reference-semantics','/candidate','/generation-evidence/codex-trace']:
 tree(p)
