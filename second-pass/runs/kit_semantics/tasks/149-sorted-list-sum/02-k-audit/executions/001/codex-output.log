+             CmpOp("==", Int(0))),
+           Expr(
+             Call(
+               Attribute(Name("result"), "append"),
+               Name("word"))),
+           .Stmts))
+       Return(
+         Call(
+           Name("sorted"),
+           Call(Name("sorted"), Name("result")),
+           KwArg("key", Name("len"))))
+
+  rule sortedListSumModule
+    => Module(
+         FuncDef(
+           "sorted_list_sum",
+           Params("lst"),
+           sortedListSumBody))
+endmodule

