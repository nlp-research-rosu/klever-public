diff --git a//tmp/audit-work/149-sorted-list-sum/reviewer-false-spec.k b//tmp/audit-work/149-sorted-list-sum/reviewer-false-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..33d40cf95af94e569e42b49cdbbb2f344228efff
--- /dev/null
+++ b//tmp/audit-work/149-sorted-list-sum/reviewer-false-spec.k
@@ -0,0 +1,56 @@
+requires "spec.k"
+
+module REVIEWER-FALSE-SPEC
+  imports SPEC
+
+  // Fresh false mutation.  The satisfying input ["aa"] contains one even
+  // string, but this postcondition duplicates it in the returned list.
+  claim [duplicated-result-is-false]:
+    <k>
+      #loadAll(sortedListSumModule)
+      ~> Call(
+           Name("sorted_list_sum"),
+           list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq)))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "sorted_list_sum"
+                  |-> closureVal(
+                        ("lst", .ParamNames),
+                        sortedListSumBody,
+                        0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      1 |-> list(
+             sortVS(
+               vCons(
+                 str(iCons(97, iCons(97, .IntSeq))),
+                 .ValSeq)))
+      2 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               vCons(
+                 str(iCons(97, iCons(97, .IntSeq))),
+                 .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/149-sorted-list-sum/reviewer_smoke.py b//tmp/audit-work/149-sorted-list-sum/reviewer_smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..1ec301a330ebeef8ba34436e52bf44bc179b457b
--- /dev/null
+++ b//tmp/audit-work/149-sorted-list-sum/reviewer_smoke.py
@@ -0,0 +1,21 @@
+def sorted_list_sum(lst):
+    result = []
+    word = ""
+    for word in lst:
+        if len(word) % 2 == 0:
+            result.append(word)
+    return sorted(sorted(result), key=len)
+
+
+# Prompt examples and branch/boundary witnesses.
+assert sorted_list_sum([]) == []
+assert sorted_list_sum(["aa", "a", "aaa"]) == ["aa"]
+assert sorted_list_sum(["ab", "a", "aaa", "cd"]) == ["ab", "cd"]
+assert sorted_list_sum(["", "x", "bb", "aa", "ccc", "dddd", "aa"]) == [
+    "",
+    "aa",
+    "aa",
+    "bb",
+    "dddd",
+]
+assert sorted_list_sum(["x", "yyy"]) == []
