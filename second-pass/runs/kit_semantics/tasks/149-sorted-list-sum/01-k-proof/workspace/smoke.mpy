Module(
  FuncDef("sorted_list_sum", Params("lst"),
    Assign(Name("result"), ListExpr())
    Assign(Name("word"), Str(""))
    For(Name("word"), Name("lst"),
      If(Compare(
        BinOp("%", Call(Name("len"), Name("word")), Int(2)),
        CmpOp("==", Int(0))),
        Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
        ))
    Return(
      Call(
        Name("sorted"),
        Call(Name("sorted"), Name("result")),
        KwArg("key", Name("len")))))
  Assert(
    Compare(
      Call(Name("sorted_list_sum"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("aa"), Str("a"), Str("aaa"))),
      CmpOp("==", ListExpr(Str("aa")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("ab"), Str("a"), Str("aaa"), Str("cd"))),
      CmpOp("==", ListExpr(Str("ab"), Str("cd")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(
          Str("zz"),
          Str("b"),
          Str("aa"),
          Str("cccc"),
          Str("bb"),
          Str("ddd"),
          Str("aa"))),
      CmpOp(
        "==",
        ListExpr(
          Str("aa"),
          Str("aa"),
          Str("bb"),
          Str("zz"),
          Str("cccc")))))
  Assert(
    Compare(
      Call(Name("sorted_list_sum"), ListExpr(Str("x"), Str("yyy"))),
      CmpOp("==", ListExpr()))))
