diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e278f7faaea4e7d017d5e683bd02cbf09fd839f9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,66 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax Bool ::= stringsOnly(ValSeq) [function, total]
+  syntax IntSeq ::= stringCodes(Val) [function, total]
+  syntax ValSeq ::= scanEven(ValSeq, ValSeq) [function]
+
+  // Exact constructor-level abbreviations for solution.mpy.
+  syntax Stmts ::= "sortedListSumBody" [macro]
+  syntax Module ::= "sortedListSumModule" [macro]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule stringsOnly(.ValSeq) => true
+  rule stringsOnly(vCons(V:Val, REST:ValSeq))
+    => isStrV(V) andBool stringsOnly(REST)
+
+  // Constructor inversion for isStrV, used only by symbolic simplification.
+  rule stringCodes(str(CS:IntSeq)) => CS
+  rule stringCodes(_:Val) => .IntSeq [owise]
+  rule isStrV(V:Val) => V ==K str(stringCodes(V)) [simplification]
+
+  // scanEven(ACC, INPUT) is the stable odd-length filter appended to ACC.
+  rule scanEven(ACC:ValSeq, .ValSeq) => ACC
+  rule scanEven(ACC:ValSeq, vCons(str(CS:IntSeq), REST:ValSeq))
+    => scanEven(
+         valSeqConcat(ACC, vCons(str(CS), .ValSeq)),
+         REST)
+    requires pyMod(isLen(CS), 2) ==Int 0
+  rule scanEven(ACC:ValSeq, vCons(str(CS:IntSeq), REST:ValSeq))
+    => scanEven(ACC, REST)
+    requires pyMod(isLen(CS), 2) =/=Int 0
+
+  rule sortedListSumBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("word"), Str(""))
+       For(
+         Name("word"),
+         Name("lst"),
+         If(
+           Compare(
+             BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+             CmpOp("==", Int(0))),
+           Expr(
+             Call(
+               Attribute(Name("result"), "append"),
+               Name("word"))),
+           .Stmts))
+       Return(
+         Call(
+           Name("sorted"),
+           Call(Name("sorted"), Name("result")),
+           KwArg("key", Name("len"))))
+
+  rule sortedListSumModule
+    => Module(
+         FuncDef(
+           "sorted_list_sum",
+           Params("lst"),
+           sortedListSumBody))
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
