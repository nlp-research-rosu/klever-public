diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8be3a5eb36e541b8dea6af28223a0c592487ff8d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,68 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax Bool ::= stringsOnly(ValSeq) [function, total]
+  syntax ValSeq ::= scanEven(ValSeq, ValSeq) [function]
+
+  // Exact constructor-level abbreviations for solution.mpy.
+  syntax Stmts ::= "sortedListSumBody" [macro]
+  syntax Module ::= "sortedListSumModule" [macro]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule stringsOnly(.ValSeq) => true
+  rule stringsOnly(vCons(V:Val, REST:ValSeq))
+    => isStrV(V) andBool stringsOnly(REST)
+
+  // scanEven(ACC, INPUT) is the stable odd-length filter appended to ACC.
+  rule scanEven(ACC:ValSeq, .ValSeq) => ACC
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(
+         valSeqConcat(ACC, vCons(V, .ValSeq)),
+         REST)
+    requires pyMod(seqLen(V), 2) ==Int 0
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(ACC, REST)
+    requires pyMod(seqLen(V), 2) =/=Int 0
+
+  // Definedness consequences of the string-list precondition.
+  rule #Ceil(seqLen(V:Val)) => true
+    requires isStrV(V)
+    [simplification]
+  rule #Ceil(scanEven(_:ValSeq, VS:ValSeq)) => true
+    requires stringsOnly(VS)
+    [simplification]
+
+  rule sortedListSumBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("word"), Str(""))
+       For(
+         Name("word"),
+         Name("lst"),
+         If(
+           Compare(
+             BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+             CmpOp("==", Int(0))),
+           Expr(
+             Call(
+               Attribute(Name("result"), "append"),
+               Name("word"))),
+           .Stmts))
+       Return(
+         Call(
+           Name("sorted"),
+           Call(Name("sorted"), Name("result")),
+           KwArg("key", Name("len"))))
+
+  rule sortedListSumModule
+    => Module(
+         FuncDef(
+           "sorted_list_sum",
+           Params("lst"),
+           sortedListSumBody))
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e6de560c209cefef0b5e69f621ed6b130913378
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def sorted_list_sum(lst):
+    result = []
+    word = ""
+    for word in lst:
+        if len(word) % 2 == 0:
+            result.append(word)
+    return sorted(sorted(result), key=len)
+
+
+assert sorted_list_sum([]) == []
+assert sorted_list_sum(["aa", "a", "aaa"]) == ["aa"]
+assert sorted_list_sum(["ab", "a", "aaa", "cd"]) == ["ab", "cd"]
+assert sorted_list_sum(
+    ["zz", "b", "aa", "cccc", "bb", "ddd", "aa"]
+) == ["aa", "aa", "bb", "zz", "cccc"]
+assert sorted_list_sum(["x", "yyy"]) == []
