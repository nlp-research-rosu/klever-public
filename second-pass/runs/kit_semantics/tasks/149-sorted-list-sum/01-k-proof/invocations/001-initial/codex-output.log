index 0000000000000000000000000000000000000000..9a956659d2269ccb7110b4d9396333565a6e952e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,115 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("word"),
+        If(
+          Compare(
+            BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("word"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "sorted_list_sum"
+              |-> closureVal(
+                    ("lst", .ParamNames),
+                    sortedListSumBody,
+                    0),
+              parent(-1))
+       1 |-> scope(
+              "lst"    |-> list(WHOLE:ValSeq)
+              "result" |-> ref(H:Int)
+              "word"   |-> OLD:Val,
+              parent(0))
+    </scopes>
+    <heap>
+      H |-> list(ACC:ValSeq)
+    </heap>
+
+  claim [filter-loop-cons]:
+    <k>
+      #loop(
+        list(vCons(str(CODES:IntSeq), REST:StrValSeq)),
+        Name("word"),
+        If(
+          Compare(
+            BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("word"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "sorted_list_sum"
+              |-> closureVal(
+                    ("lst", .ParamNames),
+                    sortedListSumBody,
+                    0),
+              parent(-1))
+       1 |-> scope(
+              "lst"    |-> list(WHOLE:ValSeq)
+              "result" |-> ref(H:Int)
+              "word"   |-> (OLD:Val => ?LAST:Val),
+              parent(0))
+    </scopes>
+    <heap>
+      H |-> list(
+             ACC:ValSeq
+             => scanEven(
+                  ACC,
+                  vCons(str(CODES), REST)))
+    </heap>
+  claim [sorted-list-sum]:
+    <k>
+      #loadAll(sortedListSumModule)
+      ~> Call(Name("sorted_list_sum"), list(INPUT:StrValSeq))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "sorted_list_sum"
+                  |-> closureVal(
+                        ("lst", .ParamNames),
+                        sortedListSumBody,
+                        0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(scanEven(.ValSeq, INPUT))
+      1 |-> list(sortVS(scanEven(.ValSeq, INPUT)))
+      2 |-> list(
+             sortKeyVS(
+               sortVS(scanEven(.ValSeq, INPUT)),
+               builtinV("len")))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..257908c5aefee223601aa99256bf559b76ea0521
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax StrValSeq ::= ".ValSeq" | vCons(Str, StrValSeq)
+  syntax StrValSeq < ValSeq
+
+  syntax Bool ::= stringsOnly(ValSeq) [function, total]
+  syntax ValSeq ::= scanEven(ValSeq, ValSeq) [function]
+
+  // Exact constructor-level abbreviations for solution.mpy.
+  syntax Stmts ::= "sortedListSumBody" [macro]
+  syntax Module ::= "sortedListSumModule" [macro]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule stringsOnly(.ValSeq) => true
+  rule stringsOnly(vCons(V:Val, REST:ValSeq))
+    => isStrV(V) andBool stringsOnly(REST)
+
+  // scanEven(ACC, INPUT) is the stable odd-length filter appended to ACC.
+  rule scanEven(ACC:ValSeq, .ValSeq) => ACC
+  rule scanEven(ACC:ValSeq, vCons(str(CS:IntSeq), REST:ValSeq))
+    => scanEven(
+         valSeqConcat(ACC, vCons(str(CS), .ValSeq)),
+         REST)
+    requires pyMod(isLen(CS), 2) ==Int 0
+  rule scanEven(ACC:ValSeq, vCons(str(CS:IntSeq), REST:ValSeq))
+    => scanEven(ACC, REST)
+    requires pyMod(isLen(CS), 2) =/=Int 0
+
+  rule sortedListSumBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("word"), Str(""))
+       For(
+         Name("word"),
+         Name("lst"),
+         If(
+           Compare(
+             BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+             CmpOp("==", Int(0))),
+           Expr(
+             Call(
+               Attribute(Name("result"), "append"),
+               Name("word"))),
+           .Stmts))
+       Return(
+         Call(
+           Name("sorted"),
+           Call(Name("sorted"), Name("result")),
+           KwArg("key", Name("len"))))
+
+  rule sortedListSumModule
+    => Module(
+         FuncDef(
+           "sorted_list_sum",
+           Params("lst"),
+           sortedListSumBody))
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e6de560c209cefef0b5e69f621ed6b130913378
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def sorted_list_sum(lst):
+    result = []
+    word = ""
+    for word in lst:
+        if len(word) % 2 == 0:
+            result.append(word)
+    return sorted(sorted(result), key=len)
+
+
+assert sorted_list_sum([]) == []
+assert sorted_list_sum(["aa", "a", "aaa"]) == ["aa"]
+assert sorted_list_sum(["ab", "a", "aaa", "cd"]) == ["ab", "cd"]
+assert sorted_list_sum(
+    ["zz", "b", "aa", "cccc", "bb", "ddd", "aa"]
+) == ["aa", "aa", "bb", "zz", "cccc"]
+assert sorted_list_sum(["x", "yyy"]) == []
