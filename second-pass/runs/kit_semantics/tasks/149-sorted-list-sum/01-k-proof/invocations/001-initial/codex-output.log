+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax Bool ::= stringsOnly(ValSeq) [function, total]
+  syntax ValSeq ::= scanEven(ValSeq, ValSeq) [function, total]
+
+  // Exact constructor-level abbreviations for solution.mpy.
+  syntax Stmts ::= "sortedListSumBody" [macro]
+  syntax Module ::= "sortedListSumModule" [macro]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule stringsOnly(.ValSeq) => true
+  rule stringsOnly(vCons(V:Val, REST:ValSeq))
+    => isStrV(V) andBool stringsOnly(REST)
+
+  // scanEven(ACC, INPUT) is the stable odd-length filter appended to ACC.
+  rule scanEven(ACC:ValSeq, .ValSeq) => ACC
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(
+         valSeqConcat(ACC, vCons(V, .ValSeq)),
+         REST)
+    requires isStrV(V)
+     andBool pyMod(seqLen(V), 2) ==Int 0
+    [simplification]
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(ACC, REST)
+    requires isStrV(V)
+     andBool pyMod(seqLen(V), 2) =/=Int 0
+    [simplification]
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(ACC, REST)
+    requires notBool isStrV(V)
+
+  // Definedness consequences of the string-list precondition.
+  rule #Ceil(seqLen(V:Val)) => #Top
+    requires isStrV(V)
+    [simplification]
+
+  rule sortedListSumBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("word"), Str(""))
+       For(
+         Name("word"),
+         Name("lst"),
+         If(
+           Compare(
+             BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+             CmpOp("==", Int(0))),
+           Expr(
+             Call(
+               Attribute(Name("result"), "append"),
+               Name("word"))),
+           .Stmts))
+       Return(
+         Call(
+           Name("sorted"),
+           Call(Name("sorted"), Name("result")),
+           KwArg("key", Name("len"))))
+
+  rule sortedListSumModule
+    => Module(
+         FuncDef(
+           "sorted_list_sum",
+           Params("lst"),
+           sortedListSumBody))
+endmodule

diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..43aebf04c4f6552c72ca4c0bc44992a05ca89522
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,76 @@
+from itertools import product
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+
+
+def oracle(words):
+    return sorted(
+        (word for word in words if len(word) % 2 == 0),
+        key=lambda word: (len(word), word),
+    )
+
+
+def load_solution():
+    spec = importlib.util.spec_from_file_location("candidate", "solution.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.sorted_list_sum
+
+
+pool = ["", "a", "ab", "bb", "cccc"]
+cases = [
+    list(items)
+    for size in range(4)
+    for items in product(pool, repeat=size)
+]
+
+candidate = load_solution()
+python_mismatches = [
+    (words, candidate(words), oracle(words))
+    for words in cases
+    if candidate(words) != oracle(words)
+]
+
+solution_source = Path("solution.py").read_text(encoding="utf-8")
+assertions = [
+    f"assert sorted_list_sum({words!r}) == {oracle(words)!r}"
+    for words in cases
+]
+Path("differential-smoke.py").write_text(
+    solution_source + "\n\n" + "\n".join(assertions) + "\n",
+    encoding="utf-8",
+)
+
+translation = subprocess.run(
+    [sys.executable, "py2mpy.py", "differential-smoke.py"],
+    check=True,
+    capture_output=True,
+    text=True,
+)
+Path("differential-smoke.mpy").write_text(
+    translation.stdout,
+    encoding="utf-8",
+)
+krun = subprocess.run(
+    [
+        "krun",
+        "differential-smoke.mpy",
+        "--definition",
+        "runtime-kompiled",
+    ],
+    capture_output=True,
+    text=True,
+)
+
+print(f"cases={len(cases)}")
+print(f"python_mismatches={len(python_mismatches)}")
+print(f"k_exit={krun.returncode}")
+if python_mismatches:
+    print(python_mismatches[:5])
+if krun.returncode != 0:
+    print(krun.stdout[-4000:])
+    print(krun.stderr[-4000:])
+if python_mismatches or krun.returncode != 0:
+    raise SystemExit(1)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3c04eb89cbb28f441391b91897d11c293252ff44
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun smoke.mpy --definition runtime-kompiled
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.filter-loop
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY
+then
+  echo "UNEXPECTED SUCCESS: false-result mutation proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: false-result mutation was rejected"
+fi
+
+if kprove spec-body-mutation.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-BODY-MUTATION
+then
+  echo "UNEXPECTED SUCCESS: changed function body proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: changed function body was rejected"
+fi
+
+python3 differential_test.py
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e6de560c209cefef0b5e69f621ed6b130913378
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,16 @@
+def sorted_list_sum(lst):
+    result = []
+    word = ""
+    for word in lst:
+        if len(word) % 2 == 0:
+            result.append(word)
+    return sorted(sorted(result), key=len)
+
+
+assert sorted_list_sum([]) == []
+assert sorted_list_sum(["aa", "a", "aaa"]) == ["aa"]
+assert sorted_list_sum(["ab", "a", "aaa", "cd"]) == ["ab", "cd"]
+assert sorted_list_sum(
+    ["zz", "b", "aa", "cccc", "bb", "ddd", "aa"]
+) == ["aa", "aa", "bb", "zz", "cccc"]
+assert sorted_list_sum(["x", "yyy"]) == []
