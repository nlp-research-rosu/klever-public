+    requires isStrV(V)
+     andBool pyMod(seqLen(V), 2) ==Int 0
+    [simplification]
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(ACC, REST)
+    requires isStrV(V)
+     andBool pyMod(seqLen(V), 2) =/=Int 0
+    [simplification]
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(ACC, REST)
