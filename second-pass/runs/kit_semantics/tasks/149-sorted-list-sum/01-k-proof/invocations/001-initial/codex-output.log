+      .Map
+      =>
+      0 |-> list(scanEven(.ValSeq, INPUT))
+      1 |-> list(sortVS(scanEven(.ValSeq, INPUT)))
+      2 |-> list(
+             sortKeyVS(
+               sortVS(scanEven(.ValSeq, INPUT)),
+               builtinV("len")))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
