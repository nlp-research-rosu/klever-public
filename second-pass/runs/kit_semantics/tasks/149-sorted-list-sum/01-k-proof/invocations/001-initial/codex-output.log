diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e5a2a864b9140dce39ab6fceb8a2acd7cd2173e7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,118 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq),
+        Name("word"),
+        If(
+          Compare(
+            BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("word"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "sorted_list_sum"
+              |-> closureVal(
+                    ("lst", .ParamNames),
+                    sortedListSumBody,
+                    0),
+              parent(-1))
+       1 |-> scope(
+              "lst"    |-> list(WHOLE:ValSeq)
+              "result" |-> ref(H:Int)
+              "word"   |-> OLD:Val,
+              parent(0))
+    </scopes>
+    <heap>
+      H |-> list(ACC:ValSeq)
+    </heap>
+
+  claim [filter-loop-cons]:
+    <k>
+      #loop(
+        list(vCons(str(CODES:IntSeq), REST:ValSeq)),
+        Name("word"),
+        If(
+          Compare(
+            BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("word"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "sorted_list_sum"
+              |-> closureVal(
+                    ("lst", .ParamNames),
+                    sortedListSumBody,
+                    0),
+              parent(-1))
+       1 |-> scope(
+              "lst"    |-> list(WHOLE:ValSeq)
+              "result" |-> ref(H:Int)
+              "word"   |-> (OLD:Val => ?LAST:Val),
+              parent(0))
+    </scopes>
+    <heap>
+      H |-> list(
+             ACC:ValSeq
+             => scanEven(
+                  ACC,
+                  vCons(str(CODES), REST)))
+    </heap>
+    requires stringsOnly(REST)
+
+  claim [sorted-list-sum]:
+    <k>
+      #loadAll(sortedListSumModule)
+      ~> Call(Name("sorted_list_sum"), list(INPUT:ValSeq))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "sorted_list_sum"
+                  |-> closureVal(
+                        ("lst", .ParamNames),
+                        sortedListSumBody,
+                        0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(scanEven(.ValSeq, INPUT))
+      1 |-> list(sortVS(scanEven(.ValSeq, INPUT)))
+      2 |-> list(
+             sortKeyVS(
+               sortVS(scanEven(.ValSeq, INPUT)),
+               builtinV("len")))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires stringsOnly(INPUT)
+endmodule
