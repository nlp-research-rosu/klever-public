diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..8c869e71e5d6d5a2655611e1963d3cf5fb323ad9
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Body mutation: keep odd lengths instead of even lengths. The original
+  // expected result for ["aa"] must therefore become unprovable.
+  claim [odd-filter-mutant]:
+    <k>
+      Call(
+        Name("sorted_list_sum"),
+        list(
+          vCons(
+            str(iCons(97, iCons(97, .IntSeq))),
+            .ValSeq)))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "sorted_list_sum"
+             |-> closureVal(
+                   ("lst", .ParamNames),
+                   Assign(Name("result"), ListExpr(.Exprs))
+                   Assign(Name("word"), Str(""))
+                   For(
+                     Name("word"),
+                     Name("lst"),
+                     If(
+                       Compare(
+                         BinOp(
+                           "%",
+                           Call(Name("len"), Name("word")),
+                           Int(2)),
+                         CmpOp("!=", Int(0))),
+                       Expr(
+                         Call(
+                           Attribute(Name("result"), "append"),
+                           Name("word"))),
+                       .Stmts))
+                   Return(
+                     Call(
+                       Name("sorted"),
+                       Call(Name("sorted"), Name("result")),
+                       KwArg("key", Name("len")))),
+                   0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      1 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      2 |-> list(
+             sortKeyVS(
+               vCons(
+                 str(iCons(97, iCons(97, .IntSeq))),
+                 .ValSeq),
+               builtinV("len")))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..f36d15eba86bc77c1a925966a94cb936319c3266
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,49 @@
+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Deliberately false: ["aa"] must survive, but this claims an empty result.
+  claim [wrong-result]:
+    <k>
+      #loadAll(sortedListSumModule)
+      ~> Call(
+           Name("sorted_list_sum"),
+           list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq)))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "sorted_list_sum"
+                  |-> closureVal(
+                        ("lst", .ParamNames),
+                        sortedListSumBody,
+                        0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      1 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      2 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..910cbfad6a39eac6cdcf8d1175d11d868218fa22
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,78 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(INPUT:ValSeq),
+        Name("word"),
+        If(
+          Compare(
+            BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("word"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "sorted_list_sum"
+              |-> closureVal(
+                    ("lst", .ParamNames),
+                    sortedListSumBody,
+                    0),
+              parent(-1))
+       1 |-> scope(
+              "lst"    |-> list(WHOLE:ValSeq)
+              "result" |-> ref(H:Int)
+              "word"   |-> (OLD:Val => ?LAST:Val),
+              parent(0))
+    </scopes>
+    <heap>
+      H |-> list(ACC:ValSeq => scanEven(ACC, INPUT))
+    </heap>
+    requires stringsOnly(INPUT)
+
+  claim [sorted-list-sum]:
+    <k>
+      #loadAll(sortedListSumModule)
+      ~> Call(Name("sorted_list_sum"), list(INPUT:ValSeq))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "sorted_list_sum"
+                  |-> closureVal(
+                        ("lst", .ParamNames),
+                        sortedListSumBody,
+                        0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(scanEven(.ValSeq, INPUT))
+      1 |-> list(sortVS(scanEven(.ValSeq, INPUT)))
+      2 |-> list(
+             sortKeyVS(
+               sortVS(scanEven(.ValSeq, INPUT)),
+               builtinV("len")))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires stringsOnly(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..15e65f99897ad9606cb1d4160782e8493086411b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,72 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax Bool ::= stringsOnly(ValSeq) [function, total]
+  syntax ValSeq ::= scanEven(ValSeq, ValSeq) [function, total]
+
+  // Exact constructor-level abbreviations for solution.mpy.
+  syntax Stmts ::= "sortedListSumBody" [macro]
+  syntax Module ::= "sortedListSumModule" [macro]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule stringsOnly(.ValSeq) => true
+  rule stringsOnly(vCons(V:Val, REST:ValSeq))
+    => isStrV(V) andBool stringsOnly(REST)
+
+  // scanEven(ACC, INPUT) is the stable odd-length filter appended to ACC.
+  rule scanEven(ACC:ValSeq, .ValSeq) => ACC
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(
+         valSeqConcat(ACC, vCons(V, .ValSeq)),
+         REST)
+    requires isStrV(V)
+     andBool pyMod(seqLen(V), 2) ==Int 0
+    [simplification]
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(ACC, REST)
+    requires isStrV(V)
+     andBool pyMod(seqLen(V), 2) =/=Int 0
+    [simplification]
+  rule scanEven(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => scanEven(ACC, REST)
+    requires notBool isStrV(V)
+
+  // Definedness consequences of the string-list precondition.
+  rule #Ceil(seqLen(V:Val)) => #Top
+    requires isStrV(V)
+    [simplification]
+
+  rule sortedListSumBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("word"), Str(""))
+       For(
+         Name("word"),
+         Name("lst"),
+         If(
+           Compare(
+             BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+             CmpOp("==", Int(0))),
+           Expr(
+             Call(
+               Attribute(Name("result"), "append"),
+               Name("word"))),
+           .Stmts))
+       Return(
+         Call(
+           Name("sorted"),
+           Call(Name("sorted"), Name("result")),
+           KwArg("key", Name("len"))))
+
+  rule sortedListSumModule
+    => Module(
+         FuncDef(
+           "sorted_list_sum",
+           Params("lst"),
+           sortedListSumBody))
+endmodule

diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..43aebf04c4f6552c72ca4c0bc44992a05ca89522
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,76 @@
+from itertools import product
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+
+
+def oracle(words):
+    return sorted(
+        (word for word in words if len(word) % 2 == 0),
+        key=lambda word: (len(word), word),
+    )
+
+
+def load_solution():
+    spec = importlib.util.spec_from_file_location("candidate", "solution.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.sorted_list_sum
+
+
+pool = ["", "a", "ab", "bb", "cccc"]
+cases = [
+    list(items)
+    for size in range(4)
+    for items in product(pool, repeat=size)
+]
+
+candidate = load_solution()
+python_mismatches = [
+    (words, candidate(words), oracle(words))
+    for words in cases
+    if candidate(words) != oracle(words)
+]
+
+solution_source = Path("solution.py").read_text(encoding="utf-8")
+assertions = [
+    f"assert sorted_list_sum({words!r}) == {oracle(words)!r}"
+    for words in cases
+]
+Path("differential-smoke.py").write_text(
+    solution_source + "\n\n" + "\n".join(assertions) + "\n",
+    encoding="utf-8",
+)
+
+translation = subprocess.run(
+    [sys.executable, "py2mpy.py", "differential-smoke.py"],
+    check=True,
+    capture_output=True,
+    text=True,
+)
+Path("differential-smoke.mpy").write_text(
+    translation.stdout,
+    encoding="utf-8",
+)
+krun = subprocess.run(
+    [
+        "krun",
+        "differential-smoke.mpy",
+        "--definition",
+        "runtime-kompiled",
+    ],
+    capture_output=True,
+    text=True,
+)
+
+print(f"cases={len(cases)}")
+print(f"python_mismatches={len(python_mismatches)}")
+print(f"k_exit={krun.returncode}")
+if python_mismatches:
+    print(python_mismatches[:5])
+if krun.returncode != 0:
+    print(krun.stdout[-4000:])
+    print(krun.stderr[-4000:])
+if python_mismatches or krun.returncode != 0:
+    raise SystemExit(1)
