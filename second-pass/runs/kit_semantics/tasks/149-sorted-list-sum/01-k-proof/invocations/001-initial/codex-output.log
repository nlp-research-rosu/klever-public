+                       .Stmts))
+                   Return(
+                     Call(
+                       Name("sorted"),
+                       Call(Name("sorted"), Name("result")),
+                       KwArg("key", Name("len")))),
+                   0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
