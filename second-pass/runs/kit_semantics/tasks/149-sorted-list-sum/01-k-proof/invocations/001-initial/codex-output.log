diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..8c869e71e5d6d5a2655611e1963d3cf5fb323ad9
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Body mutation: keep odd lengths instead of even lengths. The original
+  // expected result for ["aa"] must therefore become unprovable.
+  claim [odd-filter-mutant]:
+    <k>
+      Call(
+        Name("sorted_list_sum"),
+        list(
+          vCons(
+            str(iCons(97, iCons(97, .IntSeq))),
+            .ValSeq)))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "sorted_list_sum"
+             |-> closureVal(
+                   ("lst", .ParamNames),
+                   Assign(Name("result"), ListExpr(.Exprs))
+                   Assign(Name("word"), Str(""))
+                   For(
+                     Name("word"),
+                     Name("lst"),
+                     If(
+                       Compare(
+                         BinOp(
+                           "%",
+                           Call(Name("len"), Name("word")),
+                           Int(2)),
+                         CmpOp("!=", Int(0))),
+                       Expr(
+                         Call(
+                           Attribute(Name("result"), "append"),
+                           Name("word"))),
+                       .Stmts))
+                   Return(
+                     Call(
+                       Name("sorted"),
+                       Call(Name("sorted"), Name("result")),
+                       KwArg("key", Name("len")))),
+                   0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      1 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      2 |-> list(
+             sortKeyVS(
+               vCons(
+                 str(iCons(97, iCons(97, .IntSeq))),
+                 .ValSeq),
+               builtinV("len")))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..f36d15eba86bc77c1a925966a94cb936319c3266
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,49 @@
+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Deliberately false: ["aa"] must survive, but this claims an empty result.
+  claim [wrong-result]:
+    <k>
+      #loadAll(sortedListSumModule)
+      ~> Call(
+           Name("sorted_list_sum"),
+           list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq)))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "sorted_list_sum"
+                  |-> closureVal(
+                        ("lst", .ParamNames),
+                        sortedListSumBody,
+                        0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      1 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      2 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..910cbfad6a39eac6cdcf8d1175d11d868218fa22
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,78 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(INPUT:ValSeq),
+        Name("word"),
+        If(
+          Compare(
+            BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+            CmpOp("==", Int(0))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Name("word"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "sorted_list_sum"
+              |-> closureVal(
+                    ("lst", .ParamNames),
+                    sortedListSumBody,
+                    0),
+              parent(-1))
+       1 |-> scope(
+              "lst"    |-> list(WHOLE:ValSeq)
+              "result" |-> ref(H:Int)
+              "word"   |-> (OLD:Val => ?LAST:Val),
+              parent(0))
+    </scopes>
+    <heap>
+      H |-> list(ACC:ValSeq => scanEven(ACC, INPUT))
+    </heap>
+    requires stringsOnly(INPUT)
+
+  claim [sorted-list-sum]:
+    <k>
+      #loadAll(sortedListSumModule)
+      ~> Call(Name("sorted_list_sum"), list(INPUT:ValSeq))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (scope(.Map, parent(-1))
+             => scope(
+                  "sorted_list_sum"
+                  |-> closureVal(
+                        ("lst", .ParamNames),
+                        sortedListSumBody,
+                        0),
+                  parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(scanEven(.ValSeq, INPUT))
+      1 |-> list(sortVS(scanEven(.ValSeq, INPUT)))
+      2 |-> list(
+             sortKeyVS(
+               sortVS(scanEven(.ValSeq, INPUT)),
+               builtinV("len")))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires stringsOnly(INPUT)
+endmodule
