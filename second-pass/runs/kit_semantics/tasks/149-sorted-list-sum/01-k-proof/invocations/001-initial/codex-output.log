+     --spec-module SPEC-BODY-MUTATION
+then
+  echo "UNEXPECTED SUCCESS: changed function body proved" >&2
+  exit 1
+else
+  echo "EXPECTED FAILURE: changed function body was rejected"
+fi
+
+python3 differential_test.py
