+               .ValSeq))
+      1 |-> list(
+             vCons(
+               str(iCons(97, iCons(97, .IntSeq))),
+               .ValSeq))
+      2 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
