diff --git a/spec-mutation.k b/spec-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..64182a72f228bff16def3a6adc9e9d5fff508ab9
--- /dev/null
+++ b/spec-mutation.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC-MUTATION
+  imports VERIFICATION-BASE
+
+  // Deliberately false mutation of SPEC-CONNECTION.poly-loop-empty.
+  // The empty loop preserves A, not addF(A, 1.0).
+  claim [wrong-poly-result]:
+    <k>
+      #loop(list(numVals(.NumSeq)), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => addF(A, 1.0)) ]
+          [ "power" <- P:Float ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- C:Val ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4c7d969b095614926be37ed39ca33da7fcc99ea0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,286 @@
+requires "verification.k"
+
+module SPEC-CONNECTION
+  imports VERIFICATION-BASE
+
+  // Constructor-split circularities for the unbounded coefficient fold in
+  // poly.  They preserve an arbitrary continuation and all framed state.
+  claim [poly-loop-empty]:
+    <k>
+      #loop(list(numVals(.NumSeq)), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => polyAcc(.NumSeq, X, A, P)) ]
+          [ "power" <- (P:Float => polyPower(.NumSeq, X, P)) ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- (C:Val => polyLast(.NumSeq, C)) ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+
+  claim [poly-loop-int]:
+    <k>
+      #loop(list(numVals(nInt(I:Int, NS:NumSeq))), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => polyAcc(nInt(I, NS), X, A, P)) ]
+          [ "power" <- (P:Float => polyPower(nInt(I, NS), X, P)) ]
