+      => bisectFrom(NS, B, E)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
