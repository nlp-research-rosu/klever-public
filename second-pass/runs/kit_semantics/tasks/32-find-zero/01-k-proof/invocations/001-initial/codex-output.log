diff --git a/spec-mutation.k b/spec-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..64182a72f228bff16def3a6adc9e9d5fff508ab9
--- /dev/null
+++ b/spec-mutation.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC-MUTATION
+  imports VERIFICATION-BASE
+
+  // Deliberately false mutation of SPEC-CONNECTION.poly-loop-empty.
+  // The empty loop preserves A, not addF(A, 1.0).
+  claim [wrong-poly-result]:
+    <k>
+      #loop(list(numVals(.NumSeq)), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => addF(A, 1.0)) ]
+          [ "power" <- P:Float ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- C:Val ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4c7d969b095614926be37ed39ca33da7fcc99ea0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,286 @@
+requires "verification.k"
+
+module SPEC-CONNECTION
+  imports VERIFICATION-BASE
+
+  // Constructor-split circularities for the unbounded coefficient fold in
+  // poly.  They preserve an arbitrary continuation and all framed state.
+  claim [poly-loop-empty]:
+    <k>
+      #loop(list(numVals(.NumSeq)), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => polyAcc(.NumSeq, X, A, P)) ]
+          [ "power" <- (P:Float => polyPower(.NumSeq, X, P)) ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- (C:Val => polyLast(.NumSeq, C)) ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+
+  claim [poly-loop-int]:
+    <k>
+      #loop(list(numVals(nInt(I:Int, NS:NumSeq))), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => polyAcc(nInt(I, NS), X, A, P)) ]
+          [ "power" <- (P:Float => polyPower(nInt(I, NS), X, P)) ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- (C:Val => polyLast(nInt(I, NS), C)) ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+
+  claim [poly-loop-float]:
+    <k>
+      #loop(list(numVals(nFloat(F:Float, NS:NumSeq))), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => polyAcc(nFloat(F, NS), X, A, P)) ]
+          [ "power" <- (P:Float => polyPower(nFloat(F, NS), X, P)) ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- (C:Val => polyLast(nFloat(F, NS), C)) ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+
+  // Circularity for the root-bracketing loop.  It stops at the exact
+  // fixed-semantics head of the following bisection loop.
+  claim [expand-loop]:
+    <k>
+      #while(expandCond, expandBody)
+      ~> (While(bisectCond, bisectBody)
+          Return(Name("begin")) .Stmts)
+      ~> #endcall
+      =>
+      (While(bisectCond, bisectBody)
+       Return(Name("begin")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "xs" <- list(numVals(NS:NumSeq)) ]
+          [ "begin" <- B:Float ]
+          [ "end" <- E:Float ]
+          [ "center" <- C:Float ],
+        parent(0)))
+      =>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "xs" <- list(numVals(NS)) ]
+          [ "begin" <- bracketBegin(NS, B, E) ]
+          [ "end" <- bracketEnd(NS, B, E) ]
+          [ "center" <- C ],
+        parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validCoeffs(NS)
+
+  // The fixed semantics exposes a statement-list tail one statement at a
+  // time.  This generic connection contains no program summary.
+  claim [bisect-head]:
+    <k>
+      (While(bisectCond, bisectBody)
+       Return(Name("begin")) .Stmts)
+      ~> #endcall
+      =>
+      #while(bisectCond, bisectBody)
+      ~> (Return(Name("begin")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> ENV </env>
+    <scopes> SCOPES </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> STACK </stack>
+    <ret> RET </ret>
+    <exc> EXC </exc>
+    <exit-code> 0 </exit-code>
+
+  // Circularity for the unbounded bisection loop and its exact return suffix.
+  claim [bisect-loop]:
+    <k>
+      #while(bisectCond, bisectBody)
+      ~> (Return(Name("begin")) .Stmts)
+      ~> #endcall
+      => bisectFrom(NS, B, E)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "xs" <- list(numVals(NS:NumSeq)) ]
+          [ "begin" <- B:Float ]
+          [ "end" <- E:Float ]
+          [ "center" <- C:Float ],
+        parent(0)))
+      =>
+         (0 |-> scope(
+           .Map
+             [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+             [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+           parent(-1)))
+         (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validCoeffs(NS)
+
+endmodule
+
+module SPEC
+  imports VERIFICATION-BASE
+
+  // Prefix 1: exact module loading, name resolution, and argument evaluation.
+  claim [find-load]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("find_zero"), (list(numVals(NS:NumSeq)), .Exprs))
+      => #applyK(
+           toCall(closureVal("xs", findZeroBody, 0)),
+           (list(numVals(NS)), .Vals))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validCoeffs(NS)
+
+  // Prefix 2: exact closure application, parameter binding, and initialization
+  // through the loop head used by SPEC-CONNECTION.expand-loop.
+  claim [find-init]:
+    <k>
+      #applyK(
+        toCall(closureVal("xs", findZeroBody, 0)),
+        (list(numVals(NS:NumSeq)), .Vals))
+      =>
+      #while(expandCond, expandBody)
+      ~> (While(bisectCond, bisectBody)
+          Return(Name("begin")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "xs" <- list(numVals(NS)) ]
+          [ "begin" <-
+              divII(vsLen(numVals(NS)), 0 -Int vsLen(numVals(NS))) ]
+          [ "end" <- divII(vsLen(numVals(NS)), vsLen(numVals(NS))) ]
+          [ "center" <- 0.0 ],
+        parent(0)))
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      .List
+      => ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validCoeffs(NS)
+endmodule
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..6590221da439082b546ce8f2677e9b3915913f76
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,39 @@
+import importlib.util
+import math
+import random
+
+
+candidate_spec = importlib.util.spec_from_file_location("candidate", "solution.py")
+candidate = importlib.util.module_from_spec(candidate_spec)
+candidate_spec.loader.exec_module(candidate)
+
+
+def oracle_poly(xs, x):
+    return sum(coeff * (x ** index) for index, coeff in enumerate(xs))
+
+
+assert round(candidate.find_zero([1, 2]), 2) == -0.5
+assert round(candidate.find_zero([-6, 11, -6, 1]), 2) == 1.0
+
+random.seed(20260729)
+for case in range(500):
+    size = random.choice((2, 4, 6, 8))
+    coefficients = [random.uniform(-5.0, 5.0) for _ in range(size)]
+    while abs(coefficients[-1]) < 0.25:
+        coefficients[-1] = random.uniform(-5.0, 5.0)
+
+    root = candidate.find_zero(coefficients)
+    residual = abs(oracle_poly(coefficients, root))
+    scale = 1.0 + sum(
+        abs(coeff * (root ** index))
+        for index, coeff in enumerate(coefficients)
+    )
+    assert math.isfinite(root)
+    assert residual / scale < 1e-8, (
+        case,
+        coefficients,
+        root,
+        residual / scale,
+    )
+
+print("500 randomized odd-degree cases passed normalized residual < 1e-8")
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d4876cd4d68660a4921219baa65e159c3050df24
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,230 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports FLOAT-SYNTAX
+
+  // A proof-domain representation of every finite list of numeric
+  // coefficients.  Its embedding is the actual ValSeq consumed by MPY.
+  syntax NumSeq ::= ".NumSeq"
+                  | nInt(Int, NumSeq)
+                  | nFloat(Float, NumSeq)
+
+  syntax ValSeq ::= numVals(NumSeq) [function, total]
+  syntax Int ::= numLen(NumSeq) [function, total]
+  syntax Bool ::= lastNonZero(NumSeq) [function, total]
+  syntax Bool ::= validCoeffs(NumSeq) [function, total]
+
+  // Exact, non-operational abbreviations for the translated source syntax.
+  syntax Stmts ::= "polyStep" [function, total]
+                 | "polyBody" [function, total]
+                 | "expandBody" [function, total]
+                 | "bisectBody" [function, total]
+                 | "findZeroBody" [function, total]
+  syntax Expr ::= "expandCond" [function, total]
+                | "bisectCond" [function, total]
+  syntax Module ::= "solutionModule" [function, total]
+
+  // Exact mathematical summaries of the three source loops.
+  syntax Float ::= polyAcc(NumSeq, Float, Float, Float)
+                   [function, total, symbol(polyAcc), no-evaluators]
+                 | polyValue(NumSeq, Float)
+                   [function, total, symbol(polyValue), no-evaluators]
+                 | polyPower(NumSeq, Float, Float)
+                   [function, total, symbol(polyPower), no-evaluators]
+                 | bracketBegin(NumSeq, Float, Float)
+                   [function, total, symbol(bracketBegin), no-evaluators]
+                 | bracketEnd(NumSeq, Float, Float)
+                   [function, total, symbol(bracketEnd), no-evaluators]
+                 | solveFrom(NumSeq, Float, Float)
+                   [function, total, symbol(solveFrom), no-evaluators]
+                 | bisectFrom(NumSeq, Float, Float)
+                   [function, total, symbol(bisectFrom), no-evaluators]
+  syntax Val ::= polyLast(NumSeq, Val)
+                 [function, total, symbol(polyLast), no-evaluators]
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule numVals(.NumSeq) => .ValSeq
+  rule numVals(nInt(I, NS)) => vCons(I, numVals(NS))
+  rule numVals(nFloat(F, NS)) => vCons(F, numVals(NS))
+
+  // Injectivity consequences of the three disjoint embedding equations.
+  // These expose the NumSeq constructor selected by MPY's ValSeq iterator.
+  rule { numVals(@NS:NumSeq) #Equals .ValSeq }
+    => { @NS #Equals .NumSeq }
+    [simplification]
+  rule { numVals(@NS1:NumSeq) #Equals numVals(@NS2:NumSeq) }
+    => { @NS1 #Equals @NS2 }
+    [simplification]
+  rule { numVals(@NS:NumSeq)
+         #Equals vCons(@I:Int, numVals(@R:NumSeq)) }
+    => { @NS #Equals nInt(@I, @R) }
+    [simplification]
+  rule { numVals(@NS:NumSeq)
+         #Equals vCons(@F:Float, numVals(@R:NumSeq)) }
+    => { @NS #Equals nFloat(@F, @R) }
+    [simplification]
+
+  rule numLen(.NumSeq) => 0
+  rule numLen(nInt(_, NS)) => 1 +Int numLen(NS)
+  rule numLen(nFloat(_, NS)) => 1 +Int numLen(NS)
+
+  rule lastNonZero(.NumSeq) => false
+  rule lastNonZero(nInt(I, .NumSeq)) => I =/=Int 0
+  rule lastNonZero(nFloat(F, .NumSeq)) => notBool eqF(F, 0.0)
+  rule lastNonZero(nInt(_, NS)) => lastNonZero(NS)
+    requires numLen(NS) >Int 0
+  rule lastNonZero(nFloat(_, NS)) => lastNonZero(NS)
+    requires numLen(NS) >Int 0
+
+  rule validCoeffs(NS)
+    => numLen(NS) >=Int 2
+       andBool numLen(NS) %Int 2 ==Int 0
+       andBool lastNonZero(NS)
+
+  rule polyStep
+    => Assign(
+         Name("value"),
+         BinOp("+", Name("value"),
+                    BinOp("*", Name("coeff"), Name("power"))))
+       Assign(Name("power"), BinOp("*", Name("power"), Name("x")))
+
+  rule polyBody
+    => Assign(Name("value"), Float(0.0))
+       Assign(Name("power"), Float(1.0))
+       Assign(Name("coeff"), Float(0.0))
+       For(Name("coeff"), Name("xs"), polyStep)
+       Return(Name("value"))
+
+  rule expandCond
+    => Compare(
+         BinOp("*",
+           Call(Name("poly"), (Name("xs"), Name("begin"), .Exprs)),
+           Call(Name("poly"), (Name("xs"), Name("end"), .Exprs))),
+         CmpOp(">", Float(0.0)))
+
+  rule expandBody
+    => Assign(Name("begin"), BinOp("*", Name("begin"), Float(2.0)))
+       Assign(Name("end"), BinOp("*", Name("end"), Float(2.0)))
+
+  rule bisectCond
+    => Compare(
+         BinOp("-", Name("end"), Name("begin")),
+         CmpOp(">", Float(1e-10)))
+
+  rule bisectBody
+    => Assign(
+         Name("center"),
+         BinOp("/", BinOp("+", Name("begin"), Name("end")), Float(2.0)))
+       If(
+         Compare(
+           BinOp("*",
+             Call(Name("poly"), (Name("xs"), Name("center"), .Exprs)),
+             Call(Name("poly"), (Name("xs"), Name("begin"), .Exprs))),
+           CmpOp(">", Float(0.0))),
+         Assign(Name("begin"), Name("center")),
+         Assign(Name("end"), Name("center")))
+
+  rule findZeroBody
+    => Assign(
+         Name("begin"),
+         BinOp("/",
+           Call(Name("len"), (Name("xs"), .Exprs)),
+           UnaryOp("-", Call(Name("len"), (Name("xs"), .Exprs)))))
+       Assign(
+         Name("end"),
+         BinOp("/",
+           Call(Name("len"), (Name("xs"), .Exprs)),
+           Call(Name("len"), (Name("xs"), .Exprs))))
+       Assign(Name("center"), Float(0.0))
+       While(expandCond, expandBody)
+       While(bisectCond, bisectBody)
+       Return(Name("begin"))
+
+  rule solutionModule
+    => Module(
+         FuncDef("poly", Params(("xs", "x")), polyBody)
+         FuncDef("find_zero", Params("xs"), findZeroBody))
+
+  // Horner-by-powers fold used by poly.  Both clauses are exact restatements
+  // of one source iteration for the corresponding numeric constructor.
+  rule polyAcc(.NumSeq, _X, A, _P) => A [simplification]
+  rule polyAcc(nInt(I, NS), X, A, P)
+    => polyAcc(NS, X,
+               addF(A, mulF(intToF(I), P)),
+               mulF(P, X))
+    [simplification]
+  rule polyAcc(nFloat(F, NS), X, A, P)
+    => polyAcc(NS, X,
+               addF(A, mulF(F, P)),
+               mulF(P, X))
+    [simplification]
+  rule polyValue(NS, X) => polyAcc(NS, X, 0.0, 1.0)
+    [simplification]
+  rule polyPower(.NumSeq, _X, P) => P [simplification]
+  rule polyPower(nInt(_I, NS), X, P)
+    => polyPower(NS, X, mulF(P, X))
+    [simplification]
+  rule polyPower(nFloat(_F, NS), X, P)
+    => polyPower(NS, X, mulF(P, X))
+    [simplification]
+  rule polyLast(.NumSeq, C) => C [simplification]
+  rule polyLast(nInt(I, NS), _C)
+    => polyLast(NS, I)
+    [simplification]
+  rule polyLast(nFloat(F, NS), _C)
+    => polyLast(NS, F)
+    [simplification]
+
+  // Exact projections of the pair of endpoints produced by the expansion
+  // loop.  Their guards are the source guard and its negation.
+  rule bracketBegin(NS, B, E)
+    => bracketBegin(NS, mulF(B, 2.0), mulF(E, 2.0))
+    requires gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
+    [simplification]
+  rule bracketBegin(NS, B, E) => B
+    requires notBool gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
+    [simplification]
+  rule bracketEnd(NS, B, E)
+    => bracketEnd(NS, mulF(B, 2.0), mulF(E, 2.0))
+    requires gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
+    [simplification]
+  rule bracketEnd(NS, B, E) => E
+    requires notBool gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
+    [simplification]
+
+  // The bisection loop summary.  The outer clauses split on the while guard;
+  // the two recursive clauses then split on the exact source if-condition.
+  rule bisectFrom(NS, B, E)
+    => bisectFrom(NS, divF(addF(B, E), 2.0), E)
+    requires gtF(subF(E, B), 1e-10)
+      andBool gtF(
+        mulF(polyValue(NS, divF(addF(B, E), 2.0)),
+             polyValue(NS, B)),
+        0.0)
+    [simplification]
+  rule bisectFrom(NS, B, E)
+    => bisectFrom(NS, B, divF(addF(B, E), 2.0))
+    requires gtF(subF(E, B), 1e-10)
+      andBool notBool gtF(
+        mulF(polyValue(NS, divF(addF(B, E), 2.0)),
+             polyValue(NS, B)),
+        0.0)
+    [simplification]
+  rule bisectFrom(_NS, B, E)
+    => B
+    requires notBool gtF(subF(E, B), 1e-10)
+    [simplification]
+
+  rule solveFrom(NS, B, E)
+    => bisectFrom(NS, bracketBegin(NS, B, E), bracketEnd(NS, B, E))
+    [simplification]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION-BASE --syntax-module VERIFICATION-SYNTAX --output-definition verification-base-kompiled && kprove spec.k --definition verification-base-kompiled --spec-module SPEC --claims SPEC.find-load,SPEC.find-init' in /workspace
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ff3d134657631d778e943100a33646fe092b1289
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+python3 py2mpy.py solution.py | cmp - solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun smoke.mpy --definition runtime-kompiled
+python3 validate.py
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION-BASE \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition verification-base-kompiled
+
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.find-load,SPEC.find-init
+
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --spec-module SPEC-CONNECTION \
+  --claims SPEC-CONNECTION.poly-loop-empty,SPEC-CONNECTION.poly-loop-int,SPEC-CONNECTION.poly-loop-float
+
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --spec-module SPEC-CONNECTION \
+  --claims SPEC-CONNECTION.poly-loop-empty,SPEC-CONNECTION.poly-loop-int,SPEC-CONNECTION.poly-loop-float,SPEC-CONNECTION.expand-loop
+
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --spec-module SPEC-CONNECTION \
+  --claims SPEC-CONNECTION.bisect-head
+
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --spec-module SPEC-CONNECTION \
+  --claims SPEC-CONNECTION.poly-loop-empty,SPEC-CONNECTION.poly-loop-int,SPEC-CONNECTION.poly-loop-float,SPEC-CONNECTION.bisect-loop
+
+set +e
+mutation_output="$(
+  kprove spec-mutation.k \
+    --definition verification-base-kompiled \
+    --spec-module SPEC-MUTATION \
+    --claims SPEC-MUTATION.wrong-poly-result 2>&1
+)"
+mutation_status=$?
+set -e
+printf '%s\n' "$mutation_output"
+
+if [[ $mutation_status -eq 0 ]]; then
+  echo "ERROR: deliberately false mutation unexpectedly proved" >&2
+  exit 1
+fi
+
+if [[ $mutation_output != *"WarnStuckClaimState"* ]]; then
+  echo "ERROR: mutation failed for an unexpected reason" >&2
+  exit 1
+fi
+
+echo "Expected mutation rejection observed (exit $mutation_status)."
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..e451075ac07cd9a5ad65402f949a83d9d1e02621
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,28 @@
+def poly(xs: list, x: float):
+    value = 0.0
+    power = 1.0
+    coeff = 0.0
+    for coeff in xs:
+        value = value + coeff * power
+        power = power * x
+    return value
+
+
+def find_zero(xs: list):
+    begin = len(xs) / -len(xs)
+    end = len(xs) / len(xs)
+    center = 0.0
+    while poly(xs, begin) * poly(xs, end) > 0.0:
+        begin = begin * 2.0
+        end = end * 2.0
+    while end - begin > 0.0000000001:
+        center = (begin + end) / 2.0
+        if poly(xs, center) * poly(xs, begin) > 0.0:
+            begin = center
+        else:
+            end = center
+    return begin
+
+
+assert round(find_zero([1, 2]), 2) == -0.5
+assert round(find_zero([-6, 11, -6, 1]), 2) == 1.0
