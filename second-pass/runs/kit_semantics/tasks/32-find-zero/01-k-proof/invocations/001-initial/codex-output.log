+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
