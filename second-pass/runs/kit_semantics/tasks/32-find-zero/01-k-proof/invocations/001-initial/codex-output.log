@@ -0,0 +1,24 @@
+def poly(xs: list, x: float):
+    value = 0.0
+    power = 1.0
+    coeff = 0.0
+    for coeff in xs:
+        value = value + coeff * power
+        power = power * x
+    return value
+
+
+def find_zero(xs: list):
+    begin = len(xs) / -len(xs)
+    end = len(xs) / len(xs)
+    center = 0.0
+    while poly(xs, begin) * poly(xs, end) > 0.0:
+        begin = begin * 2.0
+        end = end * 2.0
+    while end - begin > 0.0000000001:
+        center = (begin + end) / 2.0
+        if poly(xs, center) * poly(xs, begin) > 0.0:
+            begin = center
+        else:
+            end = center
+    return begin
diff --git a/spec-mutation.k b/spec-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..64182a72f228bff16def3a6adc9e9d5fff508ab9
--- /dev/null
+++ b/spec-mutation.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC-MUTATION
+  imports VERIFICATION-BASE
+
+  // Deliberately false mutation of SPEC-CONNECTION.poly-loop-empty.
+  // The empty loop preserves A, not addF(A, 1.0).
+  claim [wrong-poly-result]:
+    <k>
+      #loop(list(numVals(.NumSeq)), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => addF(A, 1.0)) ]
+          [ "power" <- P:Float ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- C:Val ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+endmodule
