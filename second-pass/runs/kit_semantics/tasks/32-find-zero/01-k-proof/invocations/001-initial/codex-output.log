+requires "verification.k"
+
+module SPEC-CONNECTION
+  imports VERIFICATION-BASE
+
+  // Circularity for the unbounded coefficient fold in poly.  The claim starts
+  // at the fixed-semantics loop head and includes the exact return/pop suffix.
+  claim [poly-loop-empty]:
+    <k>
+      #loop(list(numVals(.NumSeq)), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => polyAcc(.NumSeq, X, A, P)) ]
+          [ "power" <- (P:Float => polyPower(.NumSeq, X, P)) ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- (C:Val => polyLast(.NumSeq, C)) ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+
+  claim [poly-loop-int]:
+    <k>
+      #loop(list(numVals(nInt(I:Int, NS:NumSeq))), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => polyAcc(nInt(I, NS), X, A, P)) ]
+          [ "power" <- (P:Float => polyPower(nInt(I, NS), X, P)) ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- (C:Val => polyLast(nInt(I, NS), C)) ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+
+  claim [poly-loop-float]:
+    <k>
+      #loop(list(numVals(nFloat(F:Float, NS:NumSeq))), Name("coeff"), polyStep)
+      => .K ...
+    </k>
+    <env> L </env>
+    <scopes>
+      BASE:Map
+      (L |-> scope(
+        .Map
+          [ "xs" <- XSV:Val ]
+          [ "value" <- (A:Float => polyAcc(nFloat(F, NS), X, A, P)) ]
+          [ "power" <- (P:Float => polyPower(nFloat(F, NS), X, P)) ]
+          [ "x" <- X:Float ]
+          [ "coeff" <- (C:Val => polyLast(nFloat(F, NS), C)) ],
+        PAR:Parent))
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> REST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(BASE)
+
+  // Circularity for the root-bracketing loop.  Program-defined poly calls,
+  // the following bisection loop, Return, and frame pop all remain in the
+  // fixed-semantics continuation.
+  claim [expand-loop]:
+    <k>
+      #while(expandCond, expandBody)
+      ~> While(bisectCond, bisectBody)
+      ~> Return(Name("begin")) ~> #endcall
+      => solveFrom(NS, B, E)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "xs" <- list(numVals(NS:NumSeq)) ]
+          [ "begin" <- B:Float ]
+          [ "end" <- E:Float ]
+          [ "center" <- C:Float ],
+        parent(0)))
+      =>
+         (0 |-> scope(
+           .Map
+             [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+             [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+           parent(-1)))
+         (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validCoeffs(NS)
+
+  // Circularity for the unbounded bisection loop and its exact return suffix.
+  claim [bisect-loop]:
+    <k>
+      #while(bisectCond, bisectBody)
+      ~> Return(Name("begin")) ~> #endcall
+      => bisectFrom(NS, B, E)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "xs" <- list(numVals(NS:NumSeq)) ]
+          [ "begin" <- B:Float ]
+          [ "end" <- E:Float ]
+          [ "center" <- C:Float ],
+        parent(0)))
+      =>
+         (0 |-> scope(
+           .Map
+             [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+             [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+           parent(-1)))
+         (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validCoeffs(NS)
+
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  // Required full-domain target: load the exact translated module, resolve the
+  // exact find_zero binding, execute it on any valid finite numeric list, and
+  // return the exact algorithmic root summary.
+  claim [find-zero]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("find_zero"), (list(numVals(NS:NumSeq)), .Exprs))
+      => solveFrom(
+           NS,
+           divII(numLen(NS), 0 -Int numLen(NS)),
+           divII(numLen(NS), numLen(NS)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        .Map
+          [ "poly" <- closureVal(("xs", "x"), polyBody, 0) ]
+          [ "find_zero" <- closureVal("xs", findZeroBody, 0) ],
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validCoeffs(NS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..cededba6f1ef6f49f564a8c5a43b39aa1db1a5ba
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,269 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports FLOAT-SYNTAX
+
+  // A proof-domain representation of every finite list of numeric
+  // coefficients.  Its embedding is the actual ValSeq consumed by MPY.
+  syntax NumSeq ::= ".NumSeq"
+                  | nInt(Int, NumSeq)
+                  | nFloat(Float, NumSeq)
+
+  syntax ValSeq ::= numVals(NumSeq) [function, total]
+  syntax Int ::= numLen(NumSeq) [function, total]
+  syntax Bool ::= lastNonZero(NumSeq) [function, total]
+  syntax Bool ::= validCoeffs(NumSeq) [function, total]
+
+  // Exact, non-operational abbreviations for the translated source syntax.
+  syntax Stmts ::= "polyStep" [function, total]
+                 | "polyBody" [function, total]
+                 | "expandBody" [function, total]
+                 | "bisectBody" [function, total]
+                 | "findZeroBody" [function, total]
+  syntax Expr ::= "expandCond" [function, total]
+                | "bisectCond" [function, total]
+  syntax Module ::= "solutionModule" [function, total]
+
+  // Exact mathematical summaries of the three source loops.
+  syntax Float ::= polyAcc(NumSeq, Float, Float, Float)
+                   [function, total, symbol(polyAcc), no-evaluators]
+                 | polyValue(NumSeq, Float)
+                   [function, total, symbol(polyValue), no-evaluators]
+                 | polyPower(NumSeq, Float, Float)
+                   [function, total, symbol(polyPower), no-evaluators]
+                 | solveFrom(NumSeq, Float, Float)
+                   [function, total, symbol(solveFrom), no-evaluators]
+                 | bisectFrom(NumSeq, Float, Float)
+                   [function, total, symbol(bisectFrom), no-evaluators]
+  syntax Val ::= polyLast(NumSeq, Val)
+                 [function, total, symbol(polyLast), no-evaluators]
+endmodule
+
+module VERIFICATION-BASE
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule numVals(.NumSeq) => .ValSeq
+  rule numVals(nInt(I, NS)) => vCons(I, numVals(NS))
+  rule numVals(nFloat(F, NS)) => vCons(F, numVals(NS))
+
+  // Injectivity consequences of the three disjoint embedding equations.
+  // These expose the NumSeq constructor selected by MPY's ValSeq iterator.
+  rule { numVals(@NS:NumSeq) #Equals .ValSeq }
+    => { @NS #Equals .NumSeq }
+    [simplification]
+  rule { numVals(@NS1:NumSeq) #Equals numVals(@NS2:NumSeq) }
+    => { @NS1 #Equals @NS2 }
+    [simplification]
+  rule { numVals(@NS:NumSeq)
+         #Equals vCons(@I:Int, numVals(@R:NumSeq)) }
+    => { @NS #Equals nInt(@I, @R) }
+    [simplification]
+  rule { numVals(@NS:NumSeq)
+         #Equals vCons(@F:Float, numVals(@R:NumSeq)) }
+    => { @NS #Equals nFloat(@F, @R) }
+    [simplification]
+
+  rule numLen(.NumSeq) => 0
+  rule numLen(nInt(_, NS)) => 1 +Int numLen(NS)
+  rule numLen(nFloat(_, NS)) => 1 +Int numLen(NS)
+  rule vsLen(numVals(NS)) => numLen(NS) [simplification]
+
+  rule lastNonZero(.NumSeq) => false
+  rule lastNonZero(nInt(I, .NumSeq)) => I =/=Int 0
+  rule lastNonZero(nFloat(F, .NumSeq)) => notBool eqF(F, 0.0)
+  rule lastNonZero(nInt(_, NS)) => lastNonZero(NS)
+    requires numLen(NS) >Int 0
+  rule lastNonZero(nFloat(_, NS)) => lastNonZero(NS)
+    requires numLen(NS) >Int 0
+
+  rule validCoeffs(NS)
+    => numLen(NS) >=Int 2
+       andBool numLen(NS) %Int 2 ==Int 0
+       andBool lastNonZero(NS)
+
+  rule polyStep
+    => Assign(
+         Name("value"),
+         BinOp("+", Name("value"),
+                    BinOp("*", Name("coeff"), Name("power"))))
+       Assign(Name("power"), BinOp("*", Name("power"), Name("x")))
+
+  rule polyBody
+    => Assign(Name("value"), Float(0.0))
+       Assign(Name("power"), Float(1.0))
+       Assign(Name("coeff"), Float(0.0))
+       For(Name("coeff"), Name("xs"), polyStep)
+       Return(Name("value"))
+
+  rule expandCond
+    => Compare(
+         BinOp("*",
+           Call(Name("poly"), (Name("xs"), Name("begin"), .Exprs)),
+           Call(Name("poly"), (Name("xs"), Name("end"), .Exprs))),
+         CmpOp(">", Float(0.0)))
+
+  rule expandBody
+    => Assign(Name("begin"), BinOp("*", Name("begin"), Float(2.0)))
+       Assign(Name("end"), BinOp("*", Name("end"), Float(2.0)))
+
+  rule bisectCond
+    => Compare(
+         BinOp("-", Name("end"), Name("begin")),
+         CmpOp(">", Float(1e-10)))
+
+  rule bisectBody
+    => Assign(
+         Name("center"),
+         BinOp("/", BinOp("+", Name("begin"), Name("end")), Float(2.0)))
+       If(
+         Compare(
+           BinOp("*",
+             Call(Name("poly"), (Name("xs"), Name("center"), .Exprs)),
+             Call(Name("poly"), (Name("xs"), Name("begin"), .Exprs))),
+           CmpOp(">", Float(0.0))),
+         Assign(Name("begin"), Name("center")),
+         Assign(Name("end"), Name("center")))
+
+  rule findZeroBody
+    => Assign(
+         Name("begin"),
+         BinOp("/",
+           Call(Name("len"), (Name("xs"), .Exprs)),
+           UnaryOp("-", Call(Name("len"), (Name("xs"), .Exprs)))))
+       Assign(
+         Name("end"),
+         BinOp("/",
+           Call(Name("len"), (Name("xs"), .Exprs)),
+           Call(Name("len"), (Name("xs"), .Exprs))))
+       Assign(Name("center"), Float(0.0))
+       While(expandCond, expandBody)
+       While(bisectCond, bisectBody)
+       Return(Name("begin"))
+
+  rule solutionModule
+    => Module(
+         FuncDef("poly", Params(("xs", "x")), polyBody)
+         FuncDef("find_zero", Params("xs"), findZeroBody))
+
+  // Horner-by-powers fold used by poly.  Both clauses are exact restatements
+  // of one source iteration for the corresponding numeric constructor.
+  rule polyAcc(.NumSeq, _X, A, _P) => A [simplification]
+  rule polyAcc(nInt(I, NS), X, A, P)
+    => polyAcc(NS, X,
+               addF(A, mulF(intToF(I), P)),
+               mulF(P, X))
+    [simplification]
+  rule polyAcc(nFloat(F, NS), X, A, P)
+    => polyAcc(NS, X,
+               addF(A, mulF(F, P)),
+               mulF(P, X))
+    [simplification]
+  rule polyValue(NS, X) => polyAcc(NS, X, 0.0, 1.0)
+    [simplification]
+  rule polyPower(.NumSeq, _X, P) => P [simplification]
+  rule polyPower(nInt(_I, NS), X, P)
+    => polyPower(NS, X, mulF(P, X))
+    [simplification]
+  rule polyPower(nFloat(_F, NS), X, P)
+    => polyPower(NS, X, mulF(P, X))
+    [simplification]
+  rule polyLast(.NumSeq, C) => C [simplification]
+  rule polyLast(nInt(I, NS), C)
+    => polyLast(NS, I)
+    [simplification]
+  rule polyLast(nFloat(F, NS), C)
+    => polyLast(NS, F)
+    [simplification]
+
+  // The expansion loop summary.  Its guards are exactly the source guard and
+  // its negation, so the clauses are exhaustive and disjoint.
+  rule solveFrom(NS, B, E)
+    => solveFrom(NS, mulF(B, 2.0), mulF(E, 2.0))
+    requires gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
+    [simplification]
+  rule solveFrom(NS, B, E)
+    => bisectFrom(NS, B, E)
+    requires notBool gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
+    [simplification]
+
+  // The bisection loop summary.  The outer clauses split on the while guard;
+  // the two recursive clauses then split on the exact source if-condition.
+  rule bisectFrom(NS, B, E)
+    => bisectFrom(NS, divF(addF(B, E), 2.0), E)
+    requires gtF(subF(E, B), 1e-10)
+      andBool gtF(
+        mulF(polyValue(NS, divF(addF(B, E), 2.0)),
+             polyValue(NS, B)),
+        0.0)
+    [simplification]
+  rule bisectFrom(NS, B, E)
+    => bisectFrom(NS, B, divF(addF(B, E), 2.0))
+    requires gtF(subF(E, B), 1e-10)
+      andBool notBool gtF(
+        mulF(polyValue(NS, divF(addF(B, E), 2.0)),
+             polyValue(NS, B)),
+        0.0)
+    [simplification]
+  rule bisectFrom(_NS, B, E)
+    => B
+    requires notBool gtF(subF(E, B), 1e-10)
+    [simplification]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Exact-context acceleration of SPEC-CONNECTION.expand-loop.  This rule is
+  // admitted only after that bridge-free universal claim is proved against a
+  // VERIFICATION-BASE definition.  Every continuation and state cell is the
+  // same as in the connection theorem.
+  rule
+    <k>
+      While(EC:Expr, EB:Stmts)
+      ~> While(BC:Expr, BB:Stmts)
+      ~> Return(Name("begin")) ~> #endcall
+      => solveFrom(NS, B, E)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(
+        "poly" |-> closureVal(("xs", "x"), PB:Stmts, 0)
+        "find_zero" |-> closureVal("xs", FB:Stmts, 0),
+        parent(-1)))
+      (-1 |-> BS:Scope)
+      (1 |-> scope(
+        "xs" |-> list(XSV:ValSeq)
+        "begin" |-> B:Float
+        "end" |-> E:Float
+        "center" |-> C:Float,
+        parent(0)))
+      =>
+      (0 |-> scope(
+        "poly" |-> closureVal(("xs", "x"), PB, 0)
+        "find_zero" |-> closureVal("xs", FB, 0),
+        parent(-1)))
+      (-1 |-> BS)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HL </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validCoeffs(NS)
+     andBool EC ==K expandCond
+     andBool EB ==K expandBody
+     andBool BC ==K bisectCond
+     andBool BB ==K bisectBody
+     andBool PB ==K polyBody
+     andBool FB ==K findZeroBody
+     andBool XSV ==K numVals(NS)
+     andBool BS ==K builtinsScope
+    [priority(40)]
+endmodule

