diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b0339eaeab7939a96b6248bf89478138e21b2c03
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,24 @@
+def poly(xs: list, x: float):
+    value = 0.0
+    power = 1.0
+    coeff = 0.0
+    for coeff in xs:
+        value = value + coeff * power
+        power = power * x
+    return value
+
+
+def find_zero(xs: list):
+    begin = -1.0
+    end = 1.0
+    center = 0.0
+    while poly(xs, begin) * poly(xs, end) > 0.0:
+        begin = begin * 2.0
+        end = end * 2.0
+    while end - begin > 0.0000000001:
+        center = (begin + end) / 2.0
+        if poly(xs, center) * poly(xs, begin) > 0.0:
+            begin = center
+        else:
+            end = center
+    return begin
