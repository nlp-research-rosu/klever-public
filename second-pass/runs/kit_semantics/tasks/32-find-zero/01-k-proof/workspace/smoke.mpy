Module(
  FuncDef("poly", Params("xs", "x"),
    Assign(Name("value"), Float(0.0))
    Assign(Name("power"), Float(1.0))
    Assign(Name("coeff"), Float(0.0))
    For(Name("coeff"), Name("xs"),
      Assign(
        Name("value"),
        BinOp(
          "+",
          Name("value"),
          BinOp("*", Name("coeff"), Name("power"))))
      Assign(Name("power"), BinOp("*", Name("power"), Name("x"))))
    Return(Name("value")))
  FuncDef("find_zero", Params("xs"),
    Assign(
      Name("begin"),
      BinOp(
        "/",
        Call(Name("len"), Name("xs")),
        UnaryOp("-", Call(Name("len"), Name("xs")))))
    Assign(
      Name("end"),
      BinOp(
        "/",
        Call(Name("len"), Name("xs")),
        Call(Name("len"), Name("xs"))))
    Assign(Name("center"), Float(0.0))
    While(Compare(
      BinOp(
        "*",
        Call(Name("poly"), Name("xs"), Name("begin")),
        Call(Name("poly"), Name("xs"), Name("end"))),
      CmpOp(">", Float(0.0))),
      Assign(Name("begin"), BinOp("*", Name("begin"), Float(2.0)))
      Assign(Name("end"), BinOp("*", Name("end"), Float(2.0))))
    While(Compare(
      BinOp("-", Name("end"), Name("begin")),
      CmpOp(">", Float(1e-10))),
      Assign(
        Name("center"),
        BinOp("/", BinOp("+", Name("begin"), Name("end")), Float(2.0)))
      If(Compare(
        BinOp(
          "*",
          Call(Name("poly"), Name("xs"), Name("center")),
          Call(Name("poly"), Name("xs"), Name("begin"))),
        CmpOp(">", Float(0.0))),
        Assign(Name("begin"), Name("center")),
        Assign(Name("end"), Name("center"))))
    Return(Name("begin")))
  Assert(
    Compare(
      Call(
        Name("round"),
        Call(Name("find_zero"), ListExpr(Int(1), Int(2))),
        Int(2)),
      CmpOp("==", UnaryOp("-", Float(0.5)))))
  Assert(
    Compare(
      Call(
        Name("round"),
        Call(
          Name("find_zero"),
          ListExpr(
            UnaryOp("-", Int(6)),
            Int(11),
            UnaryOp("-", Int(6)),
            Int(1))),
        Int(2)),
      CmpOp("==", Float(1.0)))))
