       toCall(closureVal(\"xs\", findZeroBody, 0)),\n-        (list(numVals(NS:NumSeq)), .Vals))\n-      => solveFrom(\n-           NS,\n-           divII(numLen(NS), 0 -Int numLen(NS)),\n-           divII(numLen(NS), numLen(NS)))\n-    </k>\n-    <env> 0 </env>\n-    <scopes>\n-      (0 |-> scope(\n-        .Map\n-          [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ]\n-          [ \"find_zero\" <- closureVal(\"xs\", findZeroBody, 0) ],\n-        parent(-1)))\n-      (-1 |-> builtinsScope)\n-    </scopes>\n-    <scopeLoc> 1 </scopeLoc>\n-    <heap> .Map </heap>\n-    <heapLoc> 0 </heapLoc>\n-    <stack> .List </stack>\n-    <ret> noRet </ret>\n-    <exc> NoExc </exc>\n-    <exit-code> 0 </exit-code>\n-    requires validCoeffs(NS)\n-\n endmodule\n \n module SPEC\n-  imports VERIFICATION\n+  imports VERIFICATION-BASE\n \n-  // Required full-domain target: load the exact translated module, resolve the\n-  // exact find_zero binding, execute it on any valid finite numeric list, and\n-  // return the exact algorithmic root summary.\n-  claim [find-zero]:\n+  // Prefix 1: exact module loading, name resolution, and argument evaluation.\n+  claim [find-load]:\n     <k>\n       #loadAll(solutionModule)\n       ~> Call(Name(\"find_zero\"), (list(numVals(NS:NumSeq)), .Exprs))\n-      => solveFrom(\n-           NS,\n-           divII(numLen(NS), 0 -Int numLen(NS)),\n-           divII(numLen(NS), numLen(NS)))\n+      => #applyK(\n+           toCall(closureVal(\"xs\", findZeroBody, 0)),\n+           (list(numVals(NS)), .Vals))\n@@\n     <exit-code> 0 </exit-code>\n     requires validCoeffs(NS)\n+\n+  // Prefix 2: exact closure application, parameter binding, and initialization\n+  // through the loop head used by SPEC-CONNECTION.find-zero.\n+  claim [find-init]:\n+    <k>\n+      #applyK(\n+        toCall(closureVal(\"xs\", findZeroBody, 0)),\n+        (list(numVals(NS:NumSeq)), .Vals))\n+      =>\n+      #while(expandCond, expandBody)\n+      ~> While(bisectCond, bisectBody)\n+      ~> Return(Name(\"begin\")) ~> #endcall\n+    </k>\n+    <env> 0 => 1 </env>\n+    <scopes>\n+      (0 |-> scope(\n+        .Map\n+          [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ]\n+          [ \"find_zero\" <- closureVal(\"xs\", findZeroBody, 0) ],\n+        parent(-1)))\n+      (-1 |-> builtinsScope)\n+      =>\n+      (0 |-> scope(\n+        .Map\n+          [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ]\n+          [ \"find_zero\" <- closureVal(\"xs\", findZeroBody, 0) ],\n+        parent(-1)))\n+      (-1 |-> builtinsScope)\n+      (1 |-> scope(\n+        .Map\n+          [ \"xs\" <- list(numVals(NS)) ]\n+          [ \"begin\" <- divII(numLen(NS), 0 -Int numLen(NS)) ]\n+          [ \"end\" <- divII(numLen(NS), numLen(NS)) ]\n+          [ \"center\" <- 0.0 ],\n+        parent(0)))\n+    </scopes>\n+    <scopeLoc> 1 => 2 </scopeLoc>\n+    <heap> .Map </heap>\n+    <heapLoc> 0 </heapLoc>\n+    <stack>\n+      .List\n+      => ListItem(frame(.K, 0, 1))\n+    </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires validCoeffs(NS)\n endmodule\n*** End Patch\n", "line": 644, "name": "apply_patch"}
