CALL {"arguments": "*** Begin Patch\n*** Update File: /workspace/verification.k\n@@\n   syntax ValSeq ::= numVals(NumSeq) [function, total]\n+  syntax NumSeq ::= numsOf(ValSeq) [function]\n+  syntax Bool ::= allNumeric(ValSeq) [function, total]\n@@\n   rule numVals(nFloat(F, NS)) => vCons(F, numVals(NS))\n+  rule numsOf(.ValSeq) => .NumSeq\n+  rule numsOf(vCons(I:Int, VS)) => nInt(I, numsOf(VS))\n+  rule numsOf(vCons(F:Float, VS)) => nFloat(F, numsOf(VS))\n+  rule numsOf(numVals(NS)) => NS [simplification]\n+\n+  rule allNumeric(.ValSeq) => true\n+  rule allNumeric(vCons(_:Int, VS)) => allNumeric(VS)\n+  rule allNumeric(vCons(_:Float, VS)) => allNumeric(VS)\n+  rule allNumeric(vCons(_:Val, _VS)) => false [owise]\n+  rule allNumeric(numVals(_NS)) => true [simplification]\n@@\n       #while(EC:Expr, EB:Stmts)\n       ~> While(BC:Expr, BB:Stmts)\n       ~> Return(Name(\"begin\")) ~> #endcall\n-      => solveFrom(NS, B, E)\n+      => solveFrom(numsOf(XSV), B, E)\n@@\n-    requires XSV ==K numVals(NS)\n+    requires allNumeric(XSV)\n+     andBool validCoeffs(numsOf(XSV))\n+     andBool EC ==K expandCond\n+     andBool EB ==K expandBody\n+     andBool BC ==K bisectCond\n+     andBool BB ==K bisectBody\n+     andBool PB ==K polyBody\n+     andBool FB ==K findZeroBody\n+     andBool BS ==K builtinsScope\n     [priority(40)]\n*** End Patch\n", "line": 584, "name": "apply_patch"}
