CALL {"arguments": "*** Begin Patch\n*** Add File: /workspace/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Circularity for the unbounded coefficient fold in poly.  The claim starts\n+  // at the fixed-semantics loop head and includes the exact return/pop suffix.\n+  claim [poly-loop]:\n+    <k>\n+      #loop(list(numVals(NS:NumSeq)), Name(\"coeff\"), polyStep)\n+      ~> Return(Name(\"value\")) ~> #endcall\n+      => polyAcc(NS, X, A, P) ~> CONT\n+    </k>\n+    <env> L => CALLER </env>\n+    <scopes>\n+      BASE:Map\n+      (L |-> scope(\n+        LOCAL:Map\n+          [ \"value\" <- A:Float ]\n+          [ \"power\" <- P:Float ]\n+          [ \"x\" <- X:Float ],\n+        PAR:Parent))\n+      => BASE\n+    </scopes>\n+    <scopeLoc> L +Int 1 => L </scopeLoc>\n+    <heap> HEAP </heap>\n+    <heapLoc> HL </heapLoc>\n+    <stack>\n+      ListItem(frame(CONT:K, CALLER:Int, L:Int)) REST:List\n+      => REST\n+    </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires notBool L in_keys(BASE)\n+\n+  // Circularity for the root-bracketing loop.  Program-defined poly calls,\n+  // the following bisection loop, Return, and frame pop all remain in the\n+  // fixed-semantics continuation.\n+  claim [expand-loop]:\n+    <k>\n+      #while(expandCond, expandBody)\n+      ~> While(bisectCond, bisectBody)\n+      ~> Return(Name(\"begin\")) ~> #endcall\n+      => solveFrom(NS, B, E) ~> CONT\n+    </k>\n+    <env> L => CALLER </env>\n+    <scopes>\n+      BASE:Map\n+      (0 |-> scope(\n+        MOD:Map\n+          [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ],\n+        parent(-1)))\n+      (L |-> scope(\n+        LOCAL:Map\n+          [ \"xs\" <- list(numVals(NS:NumSeq)) ]\n+          [ \"begin\" <- B:Float ]\n+          [ \"end\" <- E:Float ],\n+        parent(0)))\n+      => BASE\n+         (0 |-> scope(\n+           MOD\n+             [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ],\n+           parent(-1)))\n+    </scopes>\n+    <scopeLoc> L +Int 1 => L </scopeLoc>\n+    <heap> HEAP </heap>\n+    <heapLoc> HL </heapLoc>\n+    <stack>\n+      ListItem(frame(CONT:K, CALLER:Int, L:Int)) REST:List\n+      => REST\n+    </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires L =/=Int 0\n+     andBool notBool L in_keys(BASE)\n+     andBool notBool 0 in_keys(BASE)\n+\n+  // Circularity for the unbounded bisection loop and its exact return suffix.\n+  claim [bisect-loop]:\n+    <k>\n+      #while(bisectCond, bisectBody)\n+      ~> Return(Name(\"begin\")) ~> #endcall\n+      => bisectFrom(NS, B, E) ~> CONT\n+    </k>\n+    <env> L => CALLER </env>\n+    <scopes>\n+      BASE:Map\n+      (0 |-> scope(\n+        MOD:Map\n+          [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ],\n+        parent(-1)))\n+      (L |-> scope(\n+        LOCAL:Map\n+          [ \"xs\" <- list(numVals(NS:NumSeq)) ]\n+          [ \"begin\" <- B:Float ]\n+          [ \"end\" <- E:Float ],\n+        parent(0)))\n+      => BASE\n+         (0 |-> scope(\n+           MOD\n+             [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ],\n+           parent(-1)))\n+    </scopes>\n+    <scopeLoc> L +Int 1 => L </scopeLoc>\n+    <heap> HEAP </heap>\n+    <heapLoc> HL </heapLoc>\n+    <stack>\n+      ListItem(frame(CONT:K, CALLER:Int, L:Int)) REST:List\n+      => REST\n+    </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires L =/=Int 0\n+     andBool notBool L in_keys(BASE)\n+     andBool notBool 0 in_keys(BASE)\n+\n+  // Required full-domain target: load the exact translated module, resolve the\n+  // exact find_zero binding, execute it on any valid finite numeric list, and\n+  // return the exact algorithmic root summary.\n+  claim [find-zero]:\n+    <k>\n+      #loadAll(solutionModule)\n+      ~> Call(Name(\"find_zero\"), (list(numVals(NS:NumSeq)), .Exprs))\n+      => solveFrom(NS, -1.0, 1.0)\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1)))\n+      (-1 |-> builtinsScope)\n+      =>\n+      (0 |-> scope(\n+        .Map\n+          [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ]\n+          [ \"find_zero\" <- closureVal(\"xs\", findZeroBody, 0) ],\n+        parent(-1)))\n+      (-1 |-> builtinsScope)\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map </heap>\n+    <heapLoc> 0 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires validCoeffs(NS)\n+endmodule\n*** End Patch\n", "line": 104, "name": "apply_patch"}
