CALL {"arguments": "*** Begin Patch\n*** Update File: /workspace/verification.k\n@@\n                  | polyPower(NumSeq, Float, Float)\n                    [function, total, symbol(polyPower), no-evaluators]\n+                 | bracketBegin(NumSeq, Float, Float)\n+                   [function, total, symbol(bracketBegin), no-evaluators]\n+                 | bracketEnd(NumSeq, Float, Float)\n+                   [function, total, symbol(bracketEnd), no-evaluators]\n                  | solveFrom(NumSeq, Float, Float)\n@@\n-  // The expansion loop summary.  Its guards are exactly the source guard and\n-  // its negation, so the clauses are exhaustive and disjoint.\n-  rule solveFrom(NS, B, E)\n-    => solveFrom(NS, mulF(B, 2.0), mulF(E, 2.0))\n+  // Exact projections of the pair of endpoints produced by the expansion\n+  // loop.  Their guards are the source guard and its negation.\n+  rule bracketBegin(NS, B, E)\n+    => bracketBegin(NS, mulF(B, 2.0), mulF(E, 2.0))\n     requires gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)\n     [simplification]\n-  rule solveFrom(NS, B, E)\n-    => bisectFrom(NS, B, E)\n+  rule bracketBegin(NS, B, E) => B\n     requires notBool gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)\n     [simplification]\n+  rule bracketEnd(NS, B, E)\n+    => bracketEnd(NS, mulF(B, 2.0), mulF(E, 2.0))\n+    requires gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)\n+    [simplification]\n+  rule bracketEnd(NS, B, E) => E\n+    requires notBool gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)\n+    [simplification]\n@@\n   rule bisectFrom(_NS, B, E)\n     => B\n     requires notBool gtF(subF(E, B), 1e-10)\n     [simplification]\n+\n+  rule solveFrom(NS, B, E)\n+    => bisectFrom(NS, bracketBegin(NS, B, E), bracketEnd(NS, B, E))\n+    [simplification]\n endmodule\n*** Update File: /workspace/spec.k\n@@\n-  // Circularity for the root-bracketing loop.  Program-defined poly calls,\n-  // the following bisection loop, Return, and frame pop all remain in the\n-  // fixed-semantics continuation.\n-  claim [find-zero]:\n+  // Circularity for the root-bracketing loop.  It stops at the exact\n+  // fixed-semantics head of the following bisection loop.\n+  claim [expand-loop]:\n     <k>\n       #while(expandCond, expandBody)\n       ~> (While(bisectCond, bisectBody)\n           Return(Name(\"begin\")) .Stmts)\n       ~> #endcall\n-      => solveFrom(NS, B, E)\n+      =>\n+      #while(bisectCond, bisectBody)\n+      ~> Return(Name(\"begin\")) ~> #endcall\n     </k>\n-    <env> 1 => 0 </env>\n+    <env> 1 </env>\n     <scopes>\n       (0 |-> scope(\n@@\n           [ \"begin\" <- B:Float ]\n           [ \"end\" <- E:Float ]\n           [ \"center\" <- C:Float ],\n         parent(0)))\n       =>\n-         (0 |-> scope(\n-           .Map\n-             [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ]\n-             [ \"find_zero\" <- closureVal(\"xs\", findZeroBody, 0) ],\n-           parent(-1)))\n-         (-1 |-> builtinsScope)\n+      (0 |-> scope(\n+        .Map\n+          [ \"poly\" <- closureVal((\"xs\", \"x\"), polyBody, 0) ]\n+          [ \"find_zero\" <- closureVal(\"xs\", findZeroBody, 0) ],\n+        parent(-1)))\n+      (-1 |-> builtinsScope)\n+      (1 |-> scope(\n+        .Map\n+          [ \"xs\" <- list(numVals(NS)) ]\n+          [ \"begin\" <- bracketBegin(NS, B, E) ]\n+          [ \"end\" <- bracketEnd(NS, B, E) ]\n+          [ \"center\" <- C ],\n+        parent(0)))\n     </scopes>\n-    <scopeLoc> 2 => 1 </scopeLoc>\n+    <scopeLoc> 2 </scopeLoc>\n     <heap> HEAP </heap>\n     <heapLoc> HL </heapLoc>\n-    <stack>\n-      ListItem(frame(.K, 0, 1))\n-      => .List\n-    </stack>\n+    <stack> ListItem(frame(.K, 0, 1)) </stack>\n*** End Patch\n", "line": 782, "name": "apply_patch"}
