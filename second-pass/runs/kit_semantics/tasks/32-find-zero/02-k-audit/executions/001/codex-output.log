    54	
    55	  // Injectivity consequences of the three disjoint embedding equations.
    56	  // These expose the NumSeq constructor selected by MPY's ValSeq iterator.
    57	  rule { numVals(@NS:NumSeq) #Equals .ValSeq }
    58	    => { @NS #Equals .NumSeq }
    59	    [simplification]
    60	  rule { numVals(@NS1:NumSeq) #Equals numVals(@NS2:NumSeq) }
    61	    => { @NS1 #Equals @NS2 }
    62	    [simplification]
    63	  rule { numVals(@NS:NumSeq)
    64	         #Equals vCons(@I:Int, numVals(@R:NumSeq)) }
    65	    => { @NS #Equals nInt(@I, @R) }
    66	    [simplification]
    67	  rule { numVals(@NS:NumSeq)
    68	         #Equals vCons(@F:Float, numVals(@R:NumSeq)) }
    69	    => { @NS #Equals nFloat(@F, @R) }
    70	    [simplification]
    71	
    72	  rule numLen(.NumSeq) => 0
