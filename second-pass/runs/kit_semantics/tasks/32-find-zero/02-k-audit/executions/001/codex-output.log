    74	  rule numLen(nFloat(_, NS)) => 1 +Int numLen(NS)
    75	
    76	  rule lastNonZero(.NumSeq) => false
    77	  rule lastNonZero(nInt(I, .NumSeq)) => I =/=Int 0
    78	  rule lastNonZero(nFloat(F, .NumSeq)) => notBool eqF(F, 0.0)
    79	  rule lastNonZero(nInt(_, NS)) => lastNonZero(NS)
    80	    requires numLen(NS) >Int 0
    81	  rule lastNonZero(nFloat(_, NS)) => lastNonZero(NS)
    82	    requires numLen(NS) >Int 0
    83	
    84	  rule validCoeffs(NS)
    85	    => numLen(NS) >=Int 2
    86	       andBool numLen(NS) %Int 2 ==Int 0
    87	       andBool lastNonZero(NS)
    88	
    89	  rule polyStep
    90	    => Assign(
    91	         Name("value"),
    92	         BinOp("+", Name("value"),
    93	                    BinOp("*", Name("coeff"), Name("power"))))
    94	       Assign(Name("power"), BinOp("*", Name("power"), Name("x")))
    95	
    96	  rule polyBody
    97	    => Assign(Name("value"), Float(0.0))
    98	       Assign(Name("power"), Float(1.0))
    99	       Assign(Name("coeff"), Float(0.0))
