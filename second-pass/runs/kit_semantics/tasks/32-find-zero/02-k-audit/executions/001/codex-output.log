   109	
   110	  rule expandBody
   111	    => Assign(Name("begin"), BinOp("*", Name("begin"), Float(2.0)))
   112	       Assign(Name("end"), BinOp("*", Name("end"), Float(2.0)))
   113	
   114	  rule bisectCond
   115	    => Compare(
   116	         BinOp("-", Name("end"), Name("begin")),
   117	         CmpOp(">", Float(1e-10)))
   118	
   119	  rule bisectBody
   120	    => Assign(
   121	         Name("center"),
   122	         BinOp("/", BinOp("+", Name("begin"), Name("end")), Float(2.0)))
   123	       If(
   124	         Compare(
   125	           BinOp("*",
   126	             Call(Name("poly"), (Name("xs"), Name("center"), .Exprs)),
   127	             Call(Name("poly"), (Name("xs"), Name("begin"), .Exprs))),
