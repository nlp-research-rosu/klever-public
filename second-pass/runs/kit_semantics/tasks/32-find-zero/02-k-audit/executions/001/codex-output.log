/bin/bash -lc "cp /audit-output/evidence/stage3/runtime_probe.py /tmp/audit-work/32-find-zero/runtime_probe.py
python3 py2mpy.py runtime_probe.py > /audit-output/evidence/stage3/runtime_probe.mpy
cp /audit-output/evidence/stage3/runtime_probe.mpy /tmp/audit-work/32-find-zero/runtime_probe.mpy
