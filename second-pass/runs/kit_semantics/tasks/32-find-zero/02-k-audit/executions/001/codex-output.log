     7	  // A proof-domain representation of every finite list of numeric
     8	  // coefficients.  Its embedding is the actual ValSeq consumed by MPY.
     9	  syntax NumSeq ::= ".NumSeq"
    10	                  | nInt(Int, NumSeq)
    11	                  | nFloat(Float, NumSeq)
    12	
    13	  syntax ValSeq ::= numVals(NumSeq) [function, total]
    14	  syntax Int ::= numLen(NumSeq) [function, total]
    15	  syntax Bool ::= lastNonZero(NumSeq) [function, total]
    16	  syntax Bool ::= validCoeffs(NumSeq) [function, total]
    17	
    18	  // Exact, non-operational abbreviations for the translated source syntax.
    19	  syntax Stmts ::= "polyStep" [function, total]
    20	                 | "polyBody" [function, total]
    21	                 | "expandBody" [function, total]
    22	                 | "bisectBody" [function, total]
    23	                 | "findZeroBody" [function, total]
    24	  syntax Expr ::= "expandCond" [function, total]
    25	                | "bisectCond" [function, total]
    26	  syntax Module ::= "solutionModule" [function, total]
    27	
    28	  // Exact mathematical summaries of the three source loops.
    29	  syntax Float ::= polyAcc(NumSeq, Float, Float, Float)
    30	                   [function, total, symbol(polyAcc), no-evaluators]
    31	                 | polyValue(NumSeq, Float)
    32	                   [function, total, symbol(polyValue), no-evaluators]
    33	                 | polyPower(NumSeq, Float, Float)
