+#!/usr/bin/env bash
+set -uo pipefail
+
+failures=0
+
+check_status() {
+  local label="$1"
+  shift
+  printf 'COMMAND[%s]:' "$label"
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT[%s]=%d\n' "$label" "$status"
+  if (( status != 0 )); then
+    failures=$((failures + 1))
+  fi
+}
+
+required=(
+  /audit-input.json
+  /audit-campaign-lock.json
+  /run.json
+  /task.json
+  /generation-result.json
+  /generation-evidence/invocation.json
