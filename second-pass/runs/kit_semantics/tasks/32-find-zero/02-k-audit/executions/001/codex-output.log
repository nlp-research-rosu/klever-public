    47	module VERIFICATION-BASE
    48	  imports MPY
    49	  imports VERIFICATION-SYNTAX
    50	
    51	  rule numVals(.NumSeq) => .ValSeq
    52	  rule numVals(nInt(I, NS)) => vCons(I, numVals(NS))
