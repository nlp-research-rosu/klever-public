   129	         Assign(Name("begin"), Name("center")),
   130	         Assign(Name("end"), Name("center")))
   131	
   132	  rule findZeroBody
   133	    => Assign(
   134	         Name("begin"),
   135	         BinOp("/",
   136	           Call(Name("len"), (Name("xs"), .Exprs)),
   137	           UnaryOp("-", Call(Name("len"), (Name("xs"), .Exprs)))))
   138	       Assign(
   139	         Name("end"),
   140	         BinOp("/",
   141	           Call(Name("len"), (Name("xs"), .Exprs)),
   142	           Call(Name("len"), (Name("xs"), .Exprs))))
   143	       Assign(Name("center"), Float(0.0))
   144	       While(expandCond, expandBody)
   145	       While(bisectCond, bisectBody)
   146	       Return(Name("begin"))
   147	
   148	  rule solutionModule
   149	    => Module(
   150	         FuncDef("poly", Params(("xs", "x")), polyBody)
