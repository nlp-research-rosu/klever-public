   152	
   153	  // Horner-by-powers fold used by poly.  Both clauses are exact restatements
   154	  // of one source iteration for the corresponding numeric constructor.
   155	  rule polyAcc(.NumSeq, _X, A, _P) => A [simplification]
   156	  rule polyAcc(nInt(I, NS), X, A, P)
   157	    => polyAcc(NS, X,
   158	               addF(A, mulF(intToF(I), P)),
   159	               mulF(P, X))
   160	    [simplification]
   161	  rule polyAcc(nFloat(F, NS), X, A, P)
   162	    => polyAcc(NS, X,
   163	               addF(A, mulF(F, P)),
   164	               mulF(P, X))
   165	    [simplification]
   166	  rule polyValue(NS, X) => polyAcc(NS, X, 0.0, 1.0)
   167	    [simplification]
   168	  rule polyPower(.NumSeq, _X, P) => P [simplification]
   169	  rule polyPower(nInt(_I, NS), X, P)
   170	    => polyPower(NS, X, mulF(P, X))
   171	    [simplification]
   172	  rule polyPower(nFloat(_F, NS), X, P)
   173	    => polyPower(NS, X, mulF(P, X))
   174	    [simplification]
   175	  rule polyLast(.NumSeq, C) => C [simplification]
   176	  rule polyLast(nInt(I, NS), _C)
   177	    => polyLast(NS, I)
   178	    [simplification]
   179	  rule polyLast(nFloat(F, NS), _C)
   180	    => polyLast(NS, F)
   181	    [simplification]
   182	
   183	  // Exact projections of the pair of endpoints produced by the expansion
   184	  // loop.  Their guards are the source guard and its negation.
   185	  rule bracketBegin(NS, B, E)
   186	    => bracketBegin(NS, mulF(B, 2.0), mulF(E, 2.0))
   187	    requires gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
