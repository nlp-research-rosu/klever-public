/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter

inv = json.load(open('/reference/rule-inventory.json'))
out = json.load(open('/workspace/trust-boundary.json'))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert set(out) == {'schema_version', 'inventory_sha256', 'rules'}, set(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])

inv_ids = [x['source_rule_id'] for x in inv['rules']]
out_ids = [x['source_rule_id'] for x in out['rules']]
assert out_ids == inv_ids
assert len(out_ids) == len(set(out_ids))

for entry in out['rules']:
    assert set(entry) == {'source_rule_id', 'classification', 'rationale'}, entry
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()

by_id = {x['source_rule_id']: x for x in out['rules']}
for rule in inv['rules']:
    if 'simplification' in rule['attributes']:
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

counts = Counter(x['classification'] for x in out['rules'])
print('validated rules:', len(out_ids))
print('inventory_sha256:', out['inventory_sha256'])
for name in sorted(allowed):
    print(f'{name}: {counts[name]}')
print('simplification rules:', sum('simplification' in x['attributes'] for x in inv['rules']))
print('schema/order/coverage/rationales: PASS')
PY
python3 -m json.tool trust-boundary.json >/dev/null
test -s DISCOVERY.md
