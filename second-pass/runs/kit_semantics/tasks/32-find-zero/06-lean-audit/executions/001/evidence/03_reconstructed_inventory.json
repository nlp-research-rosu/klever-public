      "start_line": 89,
      "text": "  rule polyStep\n    => Assign(\n         Name(\"value\"),\n         BinOp(\"+\", Name(\"value\"),\n                    BinOp(\"*\", Name(\"coeff\"), Name(\"power\"))))\n       Assign(Name(\"power\"), BinOp(\"*\", Name(\"power\"), Name(\"x\")))"
    },
    {
      "attributes": [],
