      "start_line": 96,
      "text": "  rule polyBody\n    => Assign(Name(\"value\"), Float(0.0))\n       Assign(Name(\"power\"), Float(1.0))\n       Assign(Name(\"coeff\"), Float(0.0))\n       For(Name(\"coeff\"), Name(\"xs\"), polyStep)\n       Return(Name(\"value\"))"
    },
    {
      "attributes": [],
      "end_line": 108,
