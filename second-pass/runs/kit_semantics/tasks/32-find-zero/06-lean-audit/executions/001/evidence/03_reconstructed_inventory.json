      "start_line": 103,
      "text": "  rule expandCond\n    => Compare(\n         BinOp(\"*\",\n           Call(Name(\"poly\"), (Name(\"xs\"), Name(\"begin\"), .Exprs)),\n           Call(Name(\"poly\"), (Name(\"xs\"), Name(\"end\"), .Exprs))),\n         CmpOp(\">\", Float(0.0)))"
    },
    {
      "attributes": [],
      "end_line": 112,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "4a2641bf30e02bc9eaa65d36c25de544eb41ca0ff5b108f4b76200f16180793b",
      "source_rule_id": "rule-4a2641bf30e02bc9eaa65d36c25de544eb41ca0ff5b108f4b76200f16180793b",
      "start_line": 110,
      "text": "  rule expandBody\n    => Assign(Name(\"begin\"), BinOp(\"*\", Name(\"begin\"), Float(2.0)))\n       Assign(Name(\"end\"), BinOp(\"*\", Name(\"end\"), Float(2.0)))"
    },
    {
      "attributes": [],
      "end_line": 117,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "1702d913ca69945acc4e1e08011d40072e40faa8cb15f65182968d147702462b",
      "source_rule_id": "rule-1702d913ca69945acc4e1e08011d40072e40faa8cb15f65182968d147702462b",
      "start_line": 114,
      "text": "  rule bisectCond\n    => Compare(\n         BinOp(\"-\", Name(\"end\"), Name(\"begin\")),\n         CmpOp(\">\", Float(1e-10)))"
    },
    {
      "attributes": [],
      "end_line": 130,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "e376ec420453399884b387638e6adc5b73f109ad2c5db4c0d4a0855c664fd0d7",
      "source_rule_id": "rule-e376ec420453399884b387638e6adc5b73f109ad2c5db4c0d4a0855c664fd0d7",
      "start_line": 119,
      "text": "  rule bisectBody\n    => Assign(\n         Name(\"center\"),\n         BinOp(\"/\", BinOp(\"+\", Name(\"begin\"), Name(\"end\")), Float(2.0)))\n       If(\n         Compare(\n           BinOp(\"*\",\n             Call(Name(\"poly\"), (Name(\"xs\"), Name(\"center\"), .Exprs)),\n             Call(Name(\"poly\"), (Name(\"xs\"), Name(\"begin\"), .Exprs))),\n           CmpOp(\">\", Float(0.0))),\n         Assign(Name(\"begin\"), Name(\"center\")),\n         Assign(Name(\"end\"), Name(\"center\")))"
    },
    {
      "attributes": [],
      "end_line": 146,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "9a428891c7196c3a76557212f9af4edb2d11e5bac7dc09ac7500f7a486489725",
      "source_rule_id": "rule-9a428891c7196c3a76557212f9af4edb2d11e5bac7dc09ac7500f7a486489725",
      "start_line": 132,
      "text": "  rule findZeroBody\n    => Assign(\n         Name(\"begin\"),\n         BinOp(\"/\",\n           Call(Name(\"len\"), (Name(\"xs\"), .Exprs)),\n           UnaryOp(\"-\", Call(Name(\"len\"), (Name(\"xs\"), .Exprs)))))\n       Assign(\n         Name(\"end\"),\n         BinOp(\"/\",\n           Call(Name(\"len\"), (Name(\"xs\"), .Exprs)),\n           Call(Name(\"len\"), (Name(\"xs\"), .Exprs))))\n       Assign(Name(\"center\"), Float(0.0))\n       While(expandCond, expandBody)\n       While(bisectCond, bisectBody)\n       Return(Name(\"begin\"))"
    },
    {
      "attributes": [],
      "end_line": 151,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "ec9fd3d7aded5525a378fbd530ef51ff67e4e4a655dd4738987c857cd53ff10a",
