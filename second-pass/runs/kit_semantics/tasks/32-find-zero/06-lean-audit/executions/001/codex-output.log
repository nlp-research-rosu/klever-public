  elan toolchain list
  echo '"'$ elan show'"'
  elan show
  echo '"'$ find /opt -path "*/bin/lean" -o -path "*/bin/lake" | sort'"'
  find /opt \\( -path '*/bin/lean' -o -path '*/bin/lake' \\) -type f -o -type l 2>/dev/null | sort
  echo '"'$ find / -path "*/leanprover--lean4---v4.22.0/bin/lean" 2>/dev/null'"'
  find / -path '*/leanprover--lean4---v4.22.0/bin/lean' 2>/dev/null
} 2>&1 | tee -a /audit-output/evidence/11_lake_environment_diagnosis.txt" in /audit-output
