   150	         FuncDef("poly", Params(("xs", "x")), polyBody)
   151	         FuncDef("find_zero", Params("xs"), findZeroBody))
   152	
   153	  // Horner-by-powers fold used by poly.  Both clauses are exact restatements
   154	  // of one source iteration for the corresponding numeric constructor.
   155	  rule polyAcc(.NumSeq, _X, A, _P) => A [simplification]
   156	  rule polyAcc(nInt(I, NS), X, A, P)
   157	    => polyAcc(NS, X,
   158	               addF(A, mulF(intToF(I), P)),
   159	               mulF(P, X))
   160	    [simplification]
   161	  rule polyAcc(nFloat(F, NS), X, A, P)
   162	    => polyAcc(NS, X,
   163	               addF(A, mulF(F, P)),
   164	               mulF(P, X))
   165	    [simplification]
   166	  rule polyValue(NS, X) => polyAcc(NS, X, 0.0, 1.0)
   167	    [simplification]
   168	  rule polyPower(.NumSeq, _X, P) => P [simplification]
   169	  rule polyPower(nInt(_I, NS), X, P)
   170	    => polyPower(NS, X, mulF(P, X))
   171	    [simplification]
   172	  rule polyPower(nFloat(_F, NS), X, P)
   173	    => polyPower(NS, X, mulF(P, X))
   174	    [simplification]
   175	  rule polyLast(.NumSeq, C) => C [simplification]
   176	  rule polyLast(nInt(I, NS), _C)
   177	    => polyLast(NS, I)
   178	    [simplification]
   179	  rule polyLast(nFloat(F, NS), _C)
   180	    => polyLast(NS, F)
   181	    [simplification]
   182	
   183	  // Exact projections of the pair of endpoints produced by the expansion
   184	  // loop.  Their guards are the source guard and its negation.
   185	  rule bracketBegin(NS, B, E)
   186	    => bracketBegin(NS, mulF(B, 2.0), mulF(E, 2.0))
   187	    requires gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
   188	    [simplification]
   189	  rule bracketBegin(NS, B, E) => B
   190	    requires notBool gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
   191	    [simplification]
   192	  rule bracketEnd(NS, B, E)
   193	    => bracketEnd(NS, mulF(B, 2.0), mulF(E, 2.0))
   194	    requires gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
   195	    [simplification]
   196	  rule bracketEnd(NS, B, E) => E
   197	    requires notBool gtF(mulF(polyValue(NS, B), polyValue(NS, E)), 0.0)
   198	    [simplification]
   199	
   200	  // The bisection loop summary.  The outer clauses split on the while guard;
   201	  // the two recursive clauses then split on the exact source if-condition.
   202	  rule bisectFrom(NS, B, E)
   203	    => bisectFrom(NS, divF(addF(B, E), 2.0), E)
   204	    requires gtF(subF(E, B), 1e-10)
   205	      andBool gtF(
   206	        mulF(polyValue(NS, divF(addF(B, E), 2.0)),
   207	             polyValue(NS, B)),
   208	        0.0)
   209	    [simplification]
   210	  rule bisectFrom(NS, B, E)
   211	    => bisectFrom(NS, B, divF(addF(B, E), 2.0))
   212	    requires gtF(subF(E, B), 1e-10)
   213	      andBool notBool gtF(
   214	        mulF(polyValue(NS, divF(addF(B, E), 2.0)),
   215	             polyValue(NS, B)),
   216	        0.0)
   217	    [simplification]
   218	  rule bisectFrom(_NS, B, E)
   219	    => B
   220	    requires notBool gtF(subF(E, B), 1e-10)
   221	    [simplification]
   222	
   223	  rule solveFrom(NS, B, E)
   224	    => bisectFrom(NS, bracketBegin(NS, B, E), bracketEnd(NS, B, E))
   225	    [simplification]
   226	endmodule
