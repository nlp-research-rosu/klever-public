/bin/bash -lc 'set -o pipefail
probe_dir=/tmp/audit-work/lake-env-probe.mHR7Yd
lean_root=/opt/elan/toolchains/leanprover--lean4---v4.22.0
cd "$probe_dir"
{
  echo "PROBE_DIR=$probe_dir"
  echo '"'"'$ LAKE_HOME=$lean_root LEAN_SYSROOT=$lean_root $lean_root/bin/lake clean'"'
  LAKE_HOME=\""'$lean_root" LEAN_SYSROOT="$lean_root" "$lean_root/bin/lake" clean
  echo "LAKE_CLEAN_EXIT=$?"
  echo '"'"'$ LAKE_HOME=$lean_root LEAN_SYSROOT=$lean_root $lean_root/bin/lake build'"'
