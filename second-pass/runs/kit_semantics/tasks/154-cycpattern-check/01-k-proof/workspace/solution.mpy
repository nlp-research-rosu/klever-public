Module(
  FuncDef("cycpattern_check", Params("a", "b"),
    Expr(
      Str(
        "Return whether b or one of its rotations is a substring of a."))
    Assign(Name("result"), Compare(Name("b"), CmpOp("in", Name("a"))))
    Assign(Name("rotation"), Name("b"))
    Assign(Name("c"), Str(""))
    For(Name("c"), Subscript(Name("b"), Slice(NoBound, UnaryOp("-", Int(1)), NoBound)),
      Assign(
        Name("rotation"),
        BinOp(
          "+",
          Subscript(Name("rotation"), Slice(Int(1), NoBound, NoBound)),
          Name("c")))
      Assign(
        Name("result"),
        BoolOp(
          "or",
          Name("result"),
          Compare(Name("rotation"), CmpOp("in", Name("a"))))))
    Return(Name("result"))))
