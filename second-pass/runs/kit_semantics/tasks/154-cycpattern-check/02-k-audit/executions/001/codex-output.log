-    => cycScan(A, withoutLast(B), B, strContains(B, A))
+    => cycScan(
+         A,
+         buildIS(B, 0, clampLo(isLen(B) +Int -1, 1), 1),
+         B,
+         strContains(B, A))
 endmodule
