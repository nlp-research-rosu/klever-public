+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  printf 'usage: %s LOG_NAME COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_name=$1
+shift
