{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "559e566db3b1fe403e430522019764b109978ce18accff4e8fc4c00edfab6ed7",
      "rationale": "This unconditional equation defines rotateWith as the normalized IntSeq value of one rotation update; it introduces a named mathematical summary and does not match or replace an operational configuration.",
      "source_rule_id": "rule-559e566db3b1fe403e430522019764b109978ce18accff4e8fc4c00edfab6ed7",
      "start_line": 10,
      "text": "  rule rotateWith(ROT:IntSeq, C:Int)\n    => seqConcat(\n         buildIS(\n           ROT,\n           clampHi(1, isLen(ROT), 1),\n           isLen(ROT),\n           1),\n         iCons(C, .IntSeq))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "b19680acd78644f18d76a448f2b158b2dc9b290ed3ef4e6f1665f0694ff9b45a",
      "rationale": "This is the empty-sequence base equation for the structurally recursive cycScan summary, returning the accumulated Boolean.",
      "source_rule_id": "rule-b19680acd78644f18d76a448f2b158b2dc9b290ed3ef4e6f1665f0694ff9b45a",
      "start_line": 23,
      "text": "  rule cycScan(_A:IntSeq, .IntSeq, _ROT:IntSeq, FOUND:Bool)\n    => FOUND"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "d280dfa12381c84afad63e46d90ef2f2dac21170864a382830122fb86ba15a04",
      "rationale": "This is the constructor-step recurrence for cycScan, defining the fold by consuming REST and updating the named rotation and Boolean summaries.",
      "source_rule_id": "rule-d280dfa12381c84afad63e46d90ef2f2dac21170864a382830122fb86ba15a04",
      "start_line": 25,
      "text": "  rule cycScan(A:IntSeq, iCons(C:Int, REST:IntSeq), ROT:IntSeq, FOUND:Bool)\n    => cycScan(\n         A,\n         REST,\n         rotateWith(ROT, C),\n         FOUND orBool strContains(rotateWith(ROT, C), A))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "VERIFICATION",
      "normalized_sha256": "acbce82cd11415df09853f747a659e49288044368dc70960b9cda12ac64f5394",
      "rationale": "This equation is the empty-sequence base case defining finalRotation to return the current rotation.",
      "source_rule_id": "rule-acbce82cd11415df09853f747a659e49288044368dc70960b9cda12ac64f5394",
      "start_line": 33,
      "text": "  rule finalRotation(.IntSeq, ROT:IntSeq) => ROT"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "42982e2255d4f887a541b2534f1f2adb8ad67fdf1ccc543cb223c4851b6924a5",
      "rationale": "This equation is the structural recurrence defining finalRotation over a nonempty remaining sequence.",
      "source_rule_id": "rule-42982e2255d4f887a541b2534f1f2adb8ad67fdf1ccc543cb223c4851b6924a5",
      "start_line": 34,
      "text": "  rule finalRotation(iCons(C:Int, REST:IntSeq), ROT:IntSeq)\n    => finalRotation(REST, rotateWith(ROT, C))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 38,
      "module": "VERIFICATION",
      "normalized_sha256": "e209dd690d629457adfb070d37467ab97ac0b807f7ac9e8f4d651cdc65b814e0",
      "rationale": "This equation is the empty-sequence base case defining finalChar to preserve the current character sequence.",
      "source_rule_id": "rule-e209dd690d629457adfb070d37467ab97ac0b807f7ac9e8f4d651cdc65b814e0",
      "start_line": 38,
      "text": "  rule finalChar(.IntSeq, CURRENT:IntSeq) => CURRENT"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 40,
      "module": "VERIFICATION",
      "normalized_sha256": "9ced6a3b7bc4bcc4f1a55e7ce3760972548397312ff6474917ec6dbfc9a31542",
      "rationale": "This equation is the structural recurrence defining finalChar as the last character encountered while consuming REST.",
      "source_rule_id": "rule-9ced6a3b7bc4bcc4f1a55e7ce3760972548397312ff6474917ec6dbfc9a31542",
      "start_line": 39,
      "text": "  rule finalChar(iCons(C:Int, REST:IntSeq), _CURRENT:IntSeq)\n    => finalChar(REST, iCons(C, .IntSeq))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "VERIFICATION",
      "normalized_sha256": "dbc206f58341f9a20282d64086026114a906fa04c84592d51fa174533659cd10",
      "rationale": "This unconditional equation defines the top-level cycPattern summary by initializing cycScan with the normalized B[:-1] sequence, B, and the initial substring result.",
      "source_rule_id": "rule-dbc206f58341f9a20282d64086026114a906fa04c84592d51fa174533659cd10",
      "start_line": 45,
      "text": "  rule cycPattern(A:IntSeq, B:IntSeq)\n    => cycScan(\n         A,\n         buildIS(B, 0, clampLo(isLen(B) +Int -1, 1), 1),\n         B,\n         strContains(B, A))"
    }
  ],
