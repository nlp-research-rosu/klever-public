diff --git a//tmp/audit-work/proc_exe_compat.c b//tmp/audit-work/proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..2567ca829a92489a0b4e45d9010a3211c8b26116
--- /dev/null
+++ b//tmp/audit-work/proc_exe_compat.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  const size_t length = path == NULL ? 0 : strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}
diff --git a//tmp/audit-work/uv_probe.c b//tmp/audit-work/uv_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..8a28ba347bf239645c17dfa40d87fa46cdcb40d6
--- /dev/null
+++ b//tmp/audit-work/uv_probe.c
@@ -0,0 +1,14 @@
+#include <errno.h>
+#include <stddef.h>
+#include <stdio.h>
+
+int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+  char buffer[4096];
+  size_t size = sizeof(buffer);
+  int code = uv_exepath(buffer, &size);
+  printf("code=%d errno=%d size=%zu path=%s\n", code, errno, size,
+         code == 0 ? buffer : "<none>");
+  return code == 0 ? 0 : 1;
+}

