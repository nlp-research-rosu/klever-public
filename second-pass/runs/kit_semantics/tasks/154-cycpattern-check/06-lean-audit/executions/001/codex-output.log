/reference/k-proof/reference-semantics/semantics/subscript.k-37-  syntax Val ::= applyIndex(Val, Int) [function]
/reference/k-proof/reference-semantics/semantics/subscript.k-38-  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
/reference/k-proof/reference-semantics/semantics/subscript.k-39-  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
