index 0000000000000000000000000000000000000000..8a28ba347bf239645c17dfa40d87fa46cdcb40d6
--- /dev/null
+++ b//tmp/audit-work/uv_probe.c
@@ -0,0 +1,14 @@
+#include <errno.h>
+#include <stddef.h>
+#include <stdio.h>
+
+int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+  char buffer[4096];
+  size_t size = sizeof(buffer);
+  int code = uv_exepath(buffer, &size);
+  printf("code=%d errno=%d size=%zu path=%s\n", code, errno, size,
+         code == 0 ? buffer : "<none>");
+  return code == 0 ? 0 : 1;
+}
