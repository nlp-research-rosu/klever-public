requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [cyc-loop]:
    <k>
      #loop(
        str(REMAIN:IntSeq),
        Name("c"),
        Assign(
          Name("rotation"),
          BinOp(
            "+",
            Subscript(
              Name("rotation"),
              Slice(Int(1), NoBound, NoBound)),
            Name("c")))
        Assign(
          Name("result"),
          BoolOp(
            "or",
            Name("result"),
            Compare(Name("rotation"), CmpOp("in", Name("a"))))))
      => .K
      ...
    </k>
    <env> L:Int </env>
    <scopes>
      L |-> scope(
        "a" |-> str(A:IntSeq)
        "b" |-> str(B:IntSeq)
        "c" |-> (str(CURRENT:IntSeq) => str(finalChar(REMAIN, CURRENT)))
        "result" |-> (
          FOUND:Bool
          =>
          cycScan(A, REMAIN, ROT, FOUND))
        "rotation" |-> (
          str(ROT:IntSeq)
          =>
