+    [2.0, 1.0],                   # smallest valid descending case
+    [-3.0, -2.0, 7.0],
+    [-4.0, -4.0, 0.0, 9.0, 9.0],
+    [-0.0, 0.0],
+    [5e-324, 1e-323],
+    [-1e308, 0.0, 1e308],
+    [float("-inf"), 0.0, float("inf")],
+    [float("nan"), 0.0, 1.0],
+]
+
+rng = random.Random(210029)
+pool = [
+    -1000.0,
+    -10.5,
+    -1.0,
+    -0.0,
+    0.0,
+    0.125,
+    1.0,
+    2.5,
+    10.0,
+    1000.0,
+]
