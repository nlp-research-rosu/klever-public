+    json.dumps(
+        {
+            "generator": "random.Random(210029)",
+            "explicit_cases": explicit,
+            "generated_cases": generated,
+        },
+        allow_nan=True,
+        indent=2,
+    )
+    + "\n",
+    encoding="utf-8",
+)
+
