echo 'COMMAND: python3 /audit-output/evidence/program_term_compare.py' | tee /audit-output/evidence/program_term_compare.log
python3 /audit-output/evidence/program_term_compare.py 2>&1 | tee -a /audit-output/evidence/program_term_compare.log
