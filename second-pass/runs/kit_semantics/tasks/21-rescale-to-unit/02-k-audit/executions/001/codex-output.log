+for index in range(2000):
+    length = 2 + rng.randrange(24)
+    if index % 2 == 0:
+        values = [rng.choice(pool) for _ in range(length)]
+    else:
+        values = [rng.uniform(-1e6, 1e6) for _ in range(length)]
+    generated.append(values)
+
+cases = explicit + generated
