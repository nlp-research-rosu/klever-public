     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The source contract's homogeneous float-list domain.
     7	  syntax Bool ::= allFloatVS(ValSeq) [function, total]
     8	  rule allFloatVS(.ValSeq) => true
     9	  rule allFloatVS(vCons(V:Val, REST:ValSeq))
    10	    => isFloat(V) andBool allFloatVS(REST)
    11	
    12	  // A guarded total projection used only after allFloatVS has established that
    13	  // a dynamically sorted Val is a Float.
    14	  syntax Bool ::= definedProjectFloat(Val) [function, total]
    15	  rule definedProjectFloat(V:Val) => isFloat(V)
    16	
    17	  syntax Float ::= projectFloatTotal(Val)
    18	    [function, total, symbol(projectFloatTotal), no-evaluators]
    19	
    20	  rule #Ceil({@V:Val}:>Float)
    21	    => ({ definedProjectFloat(@V) #Equals true } #And #Ceil(@V))
    22	    [simplification]
    23	
    24	  rule projectFloatTotal(F:Float) => F [simplification]
    25	  rule projectFloatTotal(V:Val) => {V}:>Float
    26	    requires definedProjectFloat(V)
    27	    [concrete, simplification(10), preserves-definedness]
    28	  rule {V:Val}:>Float => projectFloatTotal(V)
    29	    requires definedProjectFloat(V)
    30	    [symbolic(V), simplification, preserves-definedness]
    31	
    32	  // This is the fixed MPY-FLOAT subtraction equation restated over the
    33	  // dynamic Val supersort, under exactly its Float-domain guard.
    34	  rule applyBin("-", V:Val, F:Float)
    35	    => subF(projectFloatTotal(V), F)
    36	    requires isFloat(V)
    37	    [simplification]
    38	
    39	  // The Haskell backend has no FLOAT.min/FLOAT.max hooks.  These wrappers
    40	  // isolate exactly those supplied primitives while leaving the surrounding
    41	  // iterator control and state transitions to the fixed semantics.
    42	  syntax Float ::= minFOpaque(Float, Float)
    43	    [function, total, symbol(minFOpaque), no-evaluators]
    44	  syntax Float ::= maxFOpaque(Float, Float)
    45	    [function, total, symbol(maxFOpaque), no-evaluators]
    46	  rule minFloat(F1:Float, F2:Float) => minFOpaque(F1, F2)
    47	    [simplification]
    48	  rule maxFloat(F1:Float, F2:Float) => maxFOpaque(F1, F2)
    49	    [simplification]
    50	
    51	  // Exact accumulator summaries for the fixed-semantics float min/max folds.
    52	  syntax Float ::= minTailF(ValSeq, Float) [function, total]
    53	  rule minTailF(.ValSeq, M:Float) => M
    54	  rule minTailF(vCons(V:Val, REST:ValSeq), M:Float)
    55	    => minTailF(REST, minFOpaque(M, projectFloatTotal(V)))
    56	    requires isFloat(V)
    57	  rule minTailF(vCons(V:Val, _REST:ValSeq), M:Float) => M
    58	    requires notBool isFloat(V)
    59	
    60	  syntax Float ::= maxTailF(ValSeq, Float) [function, total]
    61	  rule maxTailF(.ValSeq, M:Float) => M
    62	  rule maxTailF(vCons(V:Val, REST:ValSeq), M:Float)
    63	    => maxTailF(REST, maxFOpaque(M, projectFloatTotal(V)))
    64	    requires isFloat(V)
    65	  rule maxTailF(vCons(V:Val, _REST:ValSeq), M:Float) => M
    66	    requires notBool isFloat(V)
    67	
    68	  syntax Float ::= minVF(ValSeq) [function, total]
    69	  rule minVF(.ValSeq) => 0.0
    70	  rule minVF(vCons(V:Val, REST:ValSeq))
    71	    => minTailF(REST, projectFloatTotal(V))
    72	    requires isFloat(V)
    73	  rule minVF(vCons(V:Val, _REST:ValSeq)) => 0.0
    74	    requires notBool isFloat(V)
    75	
    76	  syntax Float ::= maxVF(ValSeq) [function, total]
    77	  rule maxVF(.ValSeq) => 0.0
    78	  rule maxVF(vCons(V:Val, REST:ValSeq))
    79	    => maxTailF(REST, projectFloatTotal(V))
    80	    requires isFloat(V)
    81	  rule maxVF(vCons(V:Val, _REST:ValSeq)) => 0.0
    82	    requires notBool isFloat(V)
    83	
    84	  // The source for-loop appends one transformed element at a time.  Keeping
    85	  // the current accumulator explicit makes the loop step definitionally
    86	  // identical to list.append, without needing an associativity axiom.
    87	  syntax ValSeq ::= scaleAcc(ValSeq, ValSeq, Float, Float)
    88	    [function, total]
    89	  rule scaleAcc(ACC:ValSeq, .ValSeq, _LO:Float, _HI:Float) => ACC
    90	  rule scaleAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq),
    91	                LO:Float, HI:Float)
    92	    => scaleAcc(
    93	         valSeqConcat(
    94	           ACC,
    95	           vCons(
    96	             divF(
    97	               subF(projectFloatTotal(V), LO),
    98	               subF(HI, LO)),
    99	             .ValSeq)),
   100	         REST,
   101	         LO,
   102	         HI)
   103	    requires isFloat(V)
   104	  rule scaleAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq),
   105	                LO:Float, HI:Float)
   106	    => scaleAcc(valSeqConcat(ACC, vCons(V, .ValSeq)),
   107	                REST, LO, HI)
   108	    requires notBool isFloat(V)
   109	
   110	  // The loop target remains bound after a Python for-loop.  This summary
   111	  // records that local-state effect even though the callee frame is later
   112	  // popped and is not observable to the caller.
   113	  syntax Val ::= lastVal(ValSeq, Val) [function, total]
   114	  rule lastVal(.ValSeq, CURRENT:Val) => CURRENT
   115	  rule lastVal(vCons(V:Val, REST:ValSeq), _CURRENT:Val)
   116	    => lastVal(REST, V)
   117	endmodule
