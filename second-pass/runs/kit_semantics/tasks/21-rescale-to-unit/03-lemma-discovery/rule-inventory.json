      "text": "  rule scaleAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq),\n                LO:Float, HI:Float)\n    => scaleAcc(valSeqConcat(ACC, vCons(V, .ValSeq)),\n                REST, LO, HI)\n    requires notBool isFloat(V)"
