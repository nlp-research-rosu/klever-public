Module(
  FuncDef("rescale_to_unit", Params("numbers"),
    Assign(Name("min_number"), Call(Name("min"), Name("numbers")))
    Assign(Name("max_number"), Call(Name("max"), Name("numbers")))
    Assign(Name("result"), ListExpr())
    Assign(Name("number"), Subscript(Name("numbers"), Int(0)))
    For(Name("number"), Name("numbers"),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          BinOp(
            "/",
            BinOp("-", Name("number"), Name("min_number")),
            BinOp("-", Name("max_number"), Name("min_number"))))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(3.0),
          Float(4.0),
          Float(5.0))),
      CmpOp(
        "==",
        ListExpr(
          Float(0.0),
          Float(0.25),
          Float(0.5),
          Float(0.75),
          Float(1.0)))))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(UnaryOp("-", Float(3.0)), Float(7.0))),
      CmpOp("==", ListExpr(Float(0.0), Float(1.0)))))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(Float(5.0), Float(1.0), Float(3.0))),
      CmpOp("==", ListExpr(Float(1.0), Float(0.0), Float(0.5)))))
  Assert(
    Compare(
      Call(Name("rescale_to_unit"), ListExpr(Float(4.0), Float(2.0))),
      CmpOp("==", ListExpr(Float(1.0), Float(0.0)))))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(UnaryOp("-", Float(4.0)), Float(0.0), Float(4.0))),
      CmpOp("==", ListExpr(Float(0.0), Float(0.5), Float(1.0)))))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(Float(3.0), Float(1.0), Float(3.0), Float(2.0))),
      CmpOp(
        "==",
        ListExpr(Float(1.0), Float(0.0), Float(1.0), Float(0.5)))))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(
          Float(10.0),
          Float(8.0),
          Float(6.0),
          Float(4.0),
          Float(2.0))),
      CmpOp(
        "==",
        ListExpr(
          Float(1.0),
          Float(0.75),
          Float(0.5),
          Float(0.25),
          Float(0.0))))))
