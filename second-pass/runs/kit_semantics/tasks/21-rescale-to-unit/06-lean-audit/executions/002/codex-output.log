+print()
+print("CHECKS")
+for name, result in checks.items():
+    print(f"{name}: {result}")
+print()
+print("INDEPENDENT_TRUE_DOMAIN_IDS")
+print(json.dumps(independent_true_domain_ids, indent=2))
+print()
