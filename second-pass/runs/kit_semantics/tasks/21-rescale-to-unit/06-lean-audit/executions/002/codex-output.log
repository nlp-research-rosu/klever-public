+#!/usr/bin/env python3
+"""Exact read-only rerun of tools.klean_preflight.check_generation."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from tools.klean_preflight import check_generation
+
+
+result = check_generation(
