+    = SortVal.inj_SortInt (left - right) := by
+  rfl
+
+example (left right : SortInt) :
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "unmodeled"
+      (SortVal.inj_SortInt left)
+      (SortVal.inj_SortInt right)
+    = SortVal.«noneV_MPY-CORE_Val» := by
+  rfl
