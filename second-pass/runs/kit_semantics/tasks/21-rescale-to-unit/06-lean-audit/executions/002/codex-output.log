+      (SortVal.inj_SortFloat value) = true := by
+  rfl
+
+example (value : SortInt) :
+    «definedProjectFloat(_)_VERIFICATION_Bool_Val»
+      (SortVal.inj_SortInt value) = false := by
+  rfl
+
+example (value : SortFloat) :
+    isFloat
+      (SortK.kseq
+        (SortKItem.inj_SortFloat value)
+        SortK.dotk) = true := by
+  rfl
+
+example (value : SortInt) :
+    isFloat
+      (SortK.kseq
+        (SortKItem.inj_SortInt value)
+        SortK.dotk) = false := by
+  rfl
+
+example (value : SortFloat) (suffix : SortKItem) :
+    isFloat
+      (SortK.kseq
+        (SortKItem.inj_SortFloat value)
+        (SortK.kseq suffix SortK.dotk)) = false := by
+  rfl
+
+example (value : SortFloat) :
+    projectFloatTotal (SortVal.inj_SortFloat value) = value := by
+  rfl
+
+example (value : SortFloat) :
+    «project:Float?»
+      (SortK.kseq
+        (SortKItem.inj_SortFloat value)
+        SortK.dotk) = some value := by
+  rfl
+
+example (value : SortInt) :
+    «project:Float?»
+      (SortK.kseq
+        (SortKItem.inj_SortInt value)
+        SortK.dotk) = none := by
+  rfl
+
+example (left right : SortFloat) :
+    subF left right = Float.sub left right := by
+  rfl
+
+example (left right : SortFloat) :
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "-"
+      (SortVal.inj_SortFloat left)
+      (SortVal.inj_SortFloat right)
+    = SortVal.inj_SortFloat (Float.sub left right) := by
+  rfl
+
+example (left right : SortFloat) :
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+"
+      (SortVal.inj_SortFloat left)
+      (SortVal.inj_SortFloat right)
+    = SortVal.inj_SortFloat (Float.add left right) := by
+  rfl
+
+example (left right : SortInt) :
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "-"
+      (SortVal.inj_SortInt left)
+      (SortVal.inj_SortInt right)
+    = SortVal.inj_SortInt (left - right) := by
+  rfl
+
+example (left right : SortInt) :
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "unmodeled"
+      (SortVal.inj_SortInt left)
+      (SortVal.inj_SortInt right)
+    = SortVal.«noneV_MPY-CORE_Val» := by
+  rfl
