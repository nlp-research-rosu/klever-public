-      SortVal.inj_SortFloat (Float.sub left right)
+      SortVal.inj_SortFloat left
   | "/", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
       SortVal.inj_SortFloat (Float.div left right)
