+    ),
+    "preflight_status_and_counts_match": (
+        audit["stage4_preflight"]["status"] == "PASS"
+        and audit["stage4_preflight"]["obligation_count"]
+        == len(obligations)
+    ),
+}
+
+print("HASHES")
+for path in (
