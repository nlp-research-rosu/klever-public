+
+example (value : SortFloat) :
+    projectFloatTotal (SortVal.inj_SortFloat value) = value := by
+  rfl
+
+example (value : SortFloat) :
+    «project:Float?»
+      (SortK.kseq
+        (SortKItem.inj_SortFloat value)
+        SortK.dotk) = some value := by
+  rfl
+
+example (value : SortInt) :
+    «project:Float?»
+      (SortK.kseq
+        (SortKItem.inj_SortInt value)
+        SortK.dotk) = none := by
+  rfl
+
+example (left right : SortFloat) :
+    subF left right = Float.sub left right := by
