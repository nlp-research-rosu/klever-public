+#!/usr/bin/env python3
+"""Read-only candidate source, fixed-Base, and proof-identity checks."""
+
+from __future__ import annotations
+
+import json
+import re
+import stat
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract
