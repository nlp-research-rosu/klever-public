+        and validated["inventory_sha256"] == inventory["inventory_sha256"]
+    ),
+}
+
+print("CHECKS")
+for name, result in checks.items():
+    print(f"{name}: {result}")
+print()
+print("RECONSTRUCTED_INVENTORY")
+print(json.dumps(inventory, indent=2, sort_keys=True, ensure_ascii=False))
