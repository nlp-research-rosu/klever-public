codex
The root cause is now concrete: this sandbox exposes host-PID `/proc`, while processes report namespace PIDs; Lean 4.22 locates itself through `/proc/<getpid()>/exe`, so it cannot find its own binary. I’m applying a narrowly scoped runtime shim in `/tmp/audit-work` that makes `getpid()` match `/proc/self` only for the Lean/preflight process tree. This does not modify any candidate or provenance input, and I’ll preserve the workaround and outputs as audit evidence.
apply patch
patch: completed
/tmp/audit-work/lean-proc-pid-shim.c
diff --git a//tmp/audit-work/lean-proc-pid-shim.c b//tmp/audit-work/lean-proc-pid-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..e5a29a26213f1a4e4f9973b2234e0186e13315a4
--- /dev/null
+++ b//tmp/audit-work/lean-proc-pid-shim.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * Lean 4.22 resolves its executable through /proc/<getpid()>/exe.
+ * In this audit sandbox, getpid() returns the namespace PID while the
+ * read-only /proc mount exposes host PIDs.  /proc/self remains correct.
+ * Return that visible PID so Lean's executable lookup sees the same process.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        errno = ENOSYS;
+        return (pid_t)-1;
+    }
+    target[length] = '\0';
+    char *end = NULL;
+    long value = strtol(target, &end, 10);
+    if (end == target || *end != '\0' || value <= 0 || value > INT_MAX) {
+        errno = ENOSYS;
+        return (pid_t)-1;
+    }
+    return (pid_t)value;
+}

