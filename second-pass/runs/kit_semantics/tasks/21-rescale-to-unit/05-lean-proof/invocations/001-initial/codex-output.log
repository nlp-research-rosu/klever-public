@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn system_readlink;
+  if (system_readlink == NULL) {
+    system_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  size_t length = strlen(path);
+  if (length >= 10 &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return system_readlink("/proc/self/exe", buffer, size);
+  }
+
+  return system_readlink(path, buffer, size);
+}
