+  "+" (SortVal.inj_SortBool true) (SortVal.inj_SortInt 9))
+#eval asInt («applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+  "%" (SortVal.inj_SortInt (-7)) (SortVal.inj_SortInt 3))
+#eval asInt («applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
