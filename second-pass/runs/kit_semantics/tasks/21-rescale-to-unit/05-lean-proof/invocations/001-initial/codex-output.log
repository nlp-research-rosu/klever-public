+import Proof
+
+open Proof
+
+private def asInt : SortVal → Option SortInt
+  | SortVal.inj_SortInt value => some value
+  | _ => none
+
+private def asFloatString : SortVal → Option String
+  | SortVal.inj_SortFloat value => some value.toString
+  | _ => none
