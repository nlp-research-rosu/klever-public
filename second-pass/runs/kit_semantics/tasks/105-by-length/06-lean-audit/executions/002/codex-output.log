new file mode 100644
index 0000000000000000000000000000000000000000..c3dde205a158d20b59d6e0d75b16115dbb17fc0d
--- /dev/null
+++ b//tmp/audit-work/audit_hash_inventory.py
@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import k_rule_inventory, klean_export, pipeline_contract
+from tools import stage6_resolution_contract
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def result(label: str, observed: object, expected: object) -> bool:
+    ok = observed == expected
+    print(f"{label}: {'MATCH' if ok else 'MISMATCH'}")
+    print(f"  observed={observed}")
+    print(f"  expected={expected}")
+    return ok
+
+
+def main() -> int:
+    audit_path = Path("/audit-input.json")
+    audit = json.loads(audit_path.read_text())
+    resolution, resolved_hash = stage6_resolution_contract.verify_audit_input(audit)
+    expected_hashes = resolution["hashes"]
+    all_ok = True
+
+    print("== launcher binding ==")
+    all_ok &= result(
+        "resolved_input_sha256",
+        resolved_hash,
+        audit["resolved_input_sha256"],
+    )
+    all_ok &= result("mode", resolution["mode"], "CLASSIFICATION_AND_PROOF")
+    all_ok &= result("condition", resolution["condition"], "kit-semantics")
+    all_ok &= result("semantics_mode", resolution["semantics_mode"], "SUPPLIED_SEMANTICS")
+
+    print("\n== launcher-bound mounted trees ==")
+    tree_checks = [
+        ("k_workspace_sha256", Path("/reference/k-proof")),
+        ("k_audit_sha256", Path("/reference/k-audit")),
+        ("klean_generation_sha256", Path("/reference/klean-generation")),
+        ("generation_producer_sources_sha256", Path("/reference/generation-tools")),
+        ("lean_workspace_sha256", Path("/candidate")),
+    ]
+    for key, path in tree_checks:
+        observed = pipeline_contract.sha256_tree(path)
+        all_ok &= result(key, observed, expected_hashes[key])
+    all_ok &= result(
+        "stage1_export_sha256",
+        klean_export.tree_digest(Path("/reference/k-proof")),
+        expected_hashes["stage1_export_sha256"],
+    )
+    all_ok &= result(
+        "discovery_manifest_sha256",
+        sha256(Path("/reference/lemma-discovery.json")),
+        expected_hashes["discovery_manifest_sha256"],
+    )
+    all_ok &= result(
+        "generated_tree_sha256",
+        klean_export.tree_digest(Path("/reference/klean-generation/generated")),
+        expected_hashes["generated_tree_sha256"],
+    )
+
+    print("\n== Stage 1 per-file source binding ==")
+    expected_sources = resolution["stage1_source_hashes"]
+    observed_sources: dict[str, str] = {}
+    root = Path("/reference/k-proof")
+    for path in sorted(root.rglob("*")):
+        if path.is_file() and not path.is_symlink():
+            observed_sources[path.relative_to(root).as_posix()] = sha256(path)
+    missing = sorted(set(expected_sources) - set(observed_sources))
+    extra = sorted(set(observed_sources) - set(expected_sources))
+    changed = sorted(
+        key for key in set(expected_sources) & set(observed_sources)
+        if expected_sources[key] != observed_sources[key]
+    )
+    print(f"expected_count={len(expected_sources)} observed_count={len(observed_sources)}")
+    print(f"missing={missing}")
+    print(f"extra={extra}")
+    print(f"changed={changed}")
+    all_ok &= not missing and not extra and not changed
+
+    print("\n== producer source provenance ==")
+    source_manifest_path = Path("/reference/generation-tools/source-manifest.json")
+    source_manifest = json.loads(source_manifest_path.read_text())
+    generator_manifest = json.loads(
+        Path("/reference/klean-generation/generator-manifest.json").read_text()
+    )
+    producer_files = sorted(
+        p.relative_to(source_manifest_path.parent).as_posix()
+        for p in source_manifest_path.parent.iterdir()
+        if p.is_file() and not p.is_symlink()
+    )
+    all_ok &= result(
+        "producer file set",
+        producer_files,
+        ["klean.py", "klean_export.py", "source-manifest.json"],
+    )
+    expected_producer_hashes = {
+        "klean_export.py": generator_manifest["exporter_sha256"],
+        "klean.py": generator_manifest["klean_py_sha256"],
+    }
+    all_ok &= result("source-manifest file hashes", source_manifest["files"], expected_producer_hashes)
+    for name, expected in expected_producer_hashes.items():
+        all_ok &= result(f"producer {name}", sha256(source_manifest_path.parent / name), expected)
+    image_id = generator_manifest["provenance"]["generator_image_id"]
+    all_ok &= result("source-manifest image ID", source_manifest["generator_image_id"], image_id)
+    audit_bundle_key = Path(resolution["generation_producer_sources"]).name
+    all_ok &= result("audit-input producer path/image ID", f"sha256:{audit_bundle_key}", image_id)
+
+    print("\n== trusted local rule inventory reconstruction ==")
+    inventory = k_rule_inventory.inventory_verification(root)
+    discovery = json.loads(Path("/reference/lemma-discovery.json").read_text())
+    print(json.dumps(inventory, indent=2, sort_keys=True))
+    all_ok &= result("inventory schema", inventory["schema_version"], 2)
+    all_ok &= result("verification hash", inventory["verification_sha256"], sha256(root / "verification.k"))
+    all_ok &= result("verification hash/audit source", inventory["verification_sha256"], expected_sources["verification.k"])
+    all_ok &= result("verification module", inventory["verification_module"], "VERIFICATION")
+    all_ok &= result("local module closure", inventory["verification_modules"], ["VERIFICATION"])
+    all_ok &= result("whole inventory hash", inventory["inventory_sha256"], discovery["inventory_sha256"])
+
+    inv_rules = inventory["rules"]
+    disc_rules = discovery["rules"]
+    inv_ids = [rule["source_rule_id"] for rule in inv_rules]
+    disc_ids = [rule["source_rule_id"] for rule in disc_rules]
+    all_ok &= result("rule count", len(disc_rules), len(inv_rules))
+    all_ok &= result("ordered identities", disc_ids, inv_ids)
+    all_ok &= result("inventory identities unique", len(set(inv_ids)), len(inv_ids))
+    all_ok &= result("discovery identities unique", len(set(disc_ids)), len(disc_ids))
+    source_lines = (root / "verification.k").read_text().splitlines()
+    for index, (inv, disc) in enumerate(zip(inv_rules, disc_rules), 1):
+        normalized = " ".join(inv["text"].split())
+        normalized_hash = hashlib.sha256(normalized.encode()).hexdigest()
+        sliced = "\n".join(source_lines[inv["start_line"] - 1:inv["end_line"]])
+        print(f"RULE {index}")
+        print(f"  span={inv['start_line']}-{inv['end_line']} module={inv['module']}")
+        print(f"  source_rule_id={inv['source_rule_id']}")
+        print(f"  normalized_sha256={normalized_hash}")
+        print(f"  attributes={inv['attributes']}")
+        print(f"  discovery_classification={disc['classification']}")
+        print(f"  exact_source_slice={sliced == inv['text']}")
+        print("  text=<<<")
+        print(inv["text"])
+        print("  >>>")
+        rule_ok = (
+            sliced == inv["text"]
+            and normalized_hash == inv["normalized_sha256"]
+            and inv["source_rule_id"] == f"rule-{normalized_hash}"
+            and disc["source_rule_id"] == inv["source_rule_id"]
+        )
+        all_ok &= rule_ok
+
+    allowed = {"DEFINITION", "OPERATIONAL_RULE", "PROVED_DERIVED_LEMMA", "DOMAIN_LEMMA"}
+    classes = [rule["classification"] for rule in disc_rules]
+    all_ok &= result("all classifications accounted", all(c in allowed for c in classes), True)
+    all_ok &= result(
+        "simplification classification policy",
+        all(
+            disc_rules[i]["classification"] in {"DEFINITION", "DOMAIN_LEMMA"}
+            for i, rule in enumerate(inv_rules)
+            if "simplification" in rule["attributes"]
+        ),
+        True,
+    )
+
+    print("\n== target/manifests launcher identity ==")
+    all_ok &= result("generator target/audit target", generator_manifest["target"], resolution["target"])
+    all_ok &= result("preflight target/audit target", resolution["stage4_preflight"]["target"], resolution["target"])
+    all_ok &= result("preflight generated hash", resolution["stage4_preflight"]["generated_tree_sha256"], expected_hashes["generated_tree_sha256"])
+    all_ok &= result("preflight Stage 1 export hash", resolution["stage4_preflight"]["stage1_workspace_sha256"], expected_hashes["stage1_export_sha256"])
+    all_ok &= result("preflight discovery hash", resolution["stage4_preflight"]["stage3_discovery_manifest_sha256"], expected_hashes["discovery_manifest_sha256"])
+
+    print(f"\nOVERALL_MECHANICAL_RESULT={'PASS' if all_ok else 'FAIL'}")
+    return 0 if all_ok else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a//tmp/audit-work/audit_stage4.py b//tmp/audit-work/audit_stage4.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5a3d71dabd61f8decc7fb013503bca7fd30f0d5
--- /dev/null
+++ b//tmp/audit-work/audit_stage4.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from pathlib import Path
+
+from tools import k_rule_inventory, klean_export
+
+
+def sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha_text(text: str) -> str:
+    return sha_bytes(text.encode())
+
+
+def check(label: str, condition: bool, detail: object = "") -> bool:
+    print(f"{label}: {'PASS' if condition else 'FAIL'}")
+    if detail != "":
+        print(f"  {detail}")
+    return condition
+
+
+def main() -> int:
+    root = Path("/reference/k-proof")
+    generation = Path("/reference/klean-generation")
+    generated = generation / "generated"
+    discovery = json.loads(Path("/reference/lemma-discovery.json").read_text())
+    input_manifest = json.loads((generation / "input-manifest.json").read_text())
+    generator_manifest = json.loads((generation / "generator-manifest.json").read_text())
+    obligation_map_path = generated / "obligation-map.json"
+    obligation_map = json.loads(obligation_map_path.read_text())
+    inventory = k_rule_inventory.inventory_verification(root)
+    all_ok = True
+
+    print("== Stage 3 classification partition exported into Stage 4 ==")
+    discovered_by_id = {r["source_rule_id"]: r for r in discovery["rules"]}
+    expected_records = []
+    for rule in inventory["rules"]:
+        d = discovered_by_id[rule["source_rule_id"]]
+        expected_records.append({**rule, "classification": d["classification"], "rationale": d["rationale"]})
+    category_keys = {
+        "DEFINITION": "definitions",
+        "OPERATIONAL_RULE": "operational_rules",
+        "PROVED_DERIVED_LEMMA": "proved_derived_lemmas",
+        "DOMAIN_LEMMA": "source_rules",
+    }
+    exported_by_id = {}
+    exported_count = 0
+    for classification, key in category_keys.items():
+        records = input_manifest[key]
+        print(f"{key}: {len(records)}")
+        for record in records:
+            exported_count += 1
+            rid = record["source_rule_id"]
+            all_ok &= check(f"unique category membership {rid}", rid not in exported_by_id)
+            exported_by_id[rid] = record
+            all_ok &= check(f"category label {rid}", record["classification"] == classification)
+    all_ok &= check("partition count", exported_count == len(expected_records), f"exported={exported_count} inventory={len(expected_records)}")
+    all_ok &= check("partition identities", set(exported_by_id) == {r["source_rule_id"] for r in expected_records})
+    for expected in expected_records:
+        observed = exported_by_id[expected["source_rule_id"]]
+        # Stage 4 adds discovery/inventory provenance to DOMAIN_LEMMA records.
+        common = {k: observed[k] for k in expected}
+        all_ok &= check(f"exact exported record {expected['source_rule_id']}", common == expected)
+
+    print("\n== Stage 4 source/obligation bijection ==")
+    domain = [r for r in expected_records if r["classification"] == "DOMAIN_LEMMA"]
+    mapped_sources = obligation_map["source_rules"]
+    all_ok &= check("domain source order/count", [r["source_rule_id"] for r in mapped_sources] == [r["source_rule_id"] for r in domain])
+    obligations = obligation_map["obligations"]
+    all_ok &= check("one obligation per domain source", len(obligations) == len(domain) == 1)
+    all_ok &= check("obligation IDs unique", len({o["source_rule_id"] for o in obligations}) == len(obligations))
+    for source, obligation in zip(domain, obligations):
+        all_ok &= check("source-rule identity", obligation["source_rule_id"] == source["source_rule_id"])
+        all_ok &= check("source span identity", obligation["source_span"] == {"start_line": source["start_line"], "end_line": source["end_line"]})
+        for key in ("normalized_sha256", "inventory_sha256", "discovery_manifest_sha256"):
+            all_ok &= check(f"obligation {key}", obligation[key] == mapped_sources[0][key])
+        all_ok &= check("Lean conjunct hash", sha_text(obligation["lean_conjunct"]) == obligation["lean_conjunct_sha256"], obligation["lean_conjunct_sha256"])
+        print("LEAN_CONJUNCT=<<<")
+        print(obligation["lean_conjunct"])
+        print(">>>")
+        tokens = obligation["lean_conjunct"]
+        all_ok &= check("conjunct is not literal True/False", tokens.strip() not in {"True", "False"})
+        all_ok &= check("conjunct binds both K rule variables", "(I : SortInt)" in tokens and "(V : SortVal)" in tokens)
+        all_ok &= check("conjunct retains guard", "(h : (isInt" in tokens and ") = true)" in tokens)
+        all_ok &= check("conjunct retains applyCmp equality", "applyCmp" in tokens and "\u00ab_==Int_\u00bb" in tokens and "\u00abproject:Int\u00bb" in tokens)
+        all_ok &= check("conjunct injects right Int into Val", "SortVal.inj_SortInt I" in tokens)
+
+    print("\n== independent recorded-hash checks ==")
+    all_ok &= check("obligation-map SHA-256", sha_bytes(obligation_map_path.read_bytes()) == generator_manifest["obligation_map_sha256"], generator_manifest["obligation_map_sha256"])
+    all_ok &= check("generated tree SHA-256", klean_export.tree_digest(generated) == generator_manifest["generated_tree_sha256"], generator_manifest["generated_tree_sha256"])
