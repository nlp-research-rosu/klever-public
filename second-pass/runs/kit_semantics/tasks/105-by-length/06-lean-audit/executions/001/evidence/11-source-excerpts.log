+ nl -ba /reference/k-proof/solution.py
     1	def collect_digit(arr, digit, name):
     2	    result = []
     3	    value = 0
     4	    for value in arr:
     5	        if value == digit:
     6	            result.append(name)
     7	    return result
     8	
     9	
    10	def by_length(arr):
    11	    return (
    12	        collect_digit(arr, 9, "Nine")
    13	        + collect_digit(arr, 8, "Eight")
    14	        + collect_digit(arr, 7, "Seven")
    15	        + collect_digit(arr, 6, "Six")
    16	        + collect_digit(arr, 5, "Five")
    17	        + collect_digit(arr, 4, "Four")
    18	        + collect_digit(arr, 3, "Three")
    19	        + collect_digit(arr, 2, "Two")
    20	        + collect_digit(arr, 1, "One")
    21	    )
