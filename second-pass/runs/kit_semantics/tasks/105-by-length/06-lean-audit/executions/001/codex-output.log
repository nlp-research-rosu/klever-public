+      "==" emptyString emptyString = true := by
+  rfl
+
+example :
+    Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+      "==" noneValue noneValue = true := by
+  rfl
+
+end OperationalBridgeExpectedSemantics

