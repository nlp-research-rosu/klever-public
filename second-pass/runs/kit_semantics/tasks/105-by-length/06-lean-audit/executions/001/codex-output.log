def _check_imports(generated: Path, sources: list[Path]) -> None:
    for source in sources:
        for line in source.read_text().splitlines():
            stripped = line.strip()
            if not stripped.startswith("import "):
                continue
            imported = stripped.removeprefix("import ").strip()
            if (
                not imported
                or imported.startswith(("/", "."))
                or ".." in imported
                or '"' in imported
                or "\\" in imported
            ):
                raise KleanPreflightError(
                    f"untrusted Lean import in {source}: {imported!r}"
                )
    for name in ("lakefile.toml", "lakefile.lean", "lean-toolchain"):
        path = generated / name
        if path.exists() and (not path.is_file() or path.is_symlink()):
            raise KleanPreflightError(
                f"generated dependency metadata is not regular: {path}"
            )
        if path.is_file():
            text = path.read_text()
            if re.search(r"(?m)^\s*(?:path|dir)\s*=\s*\"/", text):
                raise KleanPreflightError(
                    f"absolute dependency path in generated {name}"
                )


def check_generation(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    *,
    toolchain_lock: Path,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    frozen_input = Path(frozen_input)
    discovery_manifest = Path(discovery_manifest)
    generation = Path(generation)
    generated = generation / "generated"
    if not frozen_input.is_dir() or frozen_input.is_symlink():
        raise KleanPreflightError("frozen K input must be a real directory")
    if not discovery_manifest.is_file() or discovery_manifest.is_symlink():
        raise KleanPreflightError(
            "validated Stage 3 discovery manifest must be a regular file"
        )
    if not generation.is_dir() or generation.is_symlink():
        raise KleanPreflightError("generation must be a real directory")
    if not generated.is_dir() or generated.is_symlink():
        raise KleanPreflightError("generated project must be a real directory")
    # Traversing every entry rejects symlinks/FIFOs before any build command.
    klean_export._tree_entries(generated)
    snapshot = _preflight_snapshot(
        frozen_input, discovery_manifest, generation
    )
    input_manifest = _regular_json(
        generation / "input-manifest.json", "input manifest"
    )
    generator_manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    inventory = _regular_json(
        generation / "trust-inventory.json", "trust inventory"
    )
    export_result = _regular_json(
        generation / "export-result.json", "export result"
    )
    lock = _regular_json(Path(toolchain_lock), "toolchain lock")
    export_status = export_result.get("status")
    if export_result.get("schema_version") != 3:
        raise KleanPreflightError("export result schema version is not 3")
    if export_status not in {"OK", "KLEAN_NO_OBLIGATIONS"}:
        raise KleanPreflightError("export result status is invalid")
    input_hash = snapshot.stage1_workspace_sha256
    discovery_hash = snapshot.stage3_discovery_manifest_sha256
    generated_hash = snapshot.generated_tree_sha256
    sidecar_hashes = dict(snapshot.sidecar_sha256)
    if input_manifest.get("schema_version") != 3:
        raise KleanPreflightError("input manifest schema version is not 3")
    if generator_manifest.get("schema_version") != 3:
        raise KleanPreflightError("generator manifest schema version is not 3")
    if input_manifest.get("frozen_input_sha256") != input_hash:
        raise KleanPreflightError("frozen Stage 1 input hash changed")
    if input_manifest.get("stage1_workspace_sha256") != input_hash:
        raise KleanPreflightError("Stage 1 workspace hash changed")
    if (
        input_manifest.get("stage3_discovery_manifest_sha256")
        != discovery_hash
    ):
        raise KleanPreflightError(
            "validated Stage 3 discovery manifest hash changed"
        )
    if generator_manifest.get("generated_tree_sha256") != generated_hash:
        raise KleanPreflightError("generated project hash changed")
    if generator_manifest.get("toolchain") != lock:
        raise KleanPreflightError("generator toolchain differs from pinned lock")
    provenance = generator_manifest.get("provenance")
    if not isinstance(provenance, dict):
        raise KleanPreflightError("generator provenance is malformed")
    if provenance.get("stage1_workspace_sha256") != input_hash:
        raise KleanPreflightError(
            "Stage 1 provenance differs between generation manifests"
        )
    if provenance.get("stage3_discovery_manifest_sha256") != discovery_hash:
        raise KleanPreflightError(
            "Stage 3 provenance differs between generation manifests"
        )
    if provenance.get("inventory_sha256") != input_manifest.get(
        "inventory_sha256"
    ):
        raise KleanPreflightError(
            "Stage 1/Stage 3 inventory provenance differs"
        )
    _source_rules, obligations = _source_and_obligation_gate(
        frozen_input,
        discovery_manifest,
        generated,
        input_manifest,
        generator_manifest,
    )
    expected_export_status = "OK" if obligations else "KLEAN_NO_OBLIGATIONS"
    if export_status != expected_export_status:
        raise KleanPreflightError(
            "export status disagrees with generated obligation count"
        )
    if export_result.get("obligation_count") != len(obligations):
        raise KleanPreflightError(
            "export result obligation_count does not match generated obligations"
        )

    try:
        target = klean_export.target_statement(generated)
    except klean_export.KleanExportError as error:
        raise KleanPreflightError(str(error)) from error
    expected_target = generator_manifest.get("target")
    if target != expected_target:
        raise KleanPreflightError("target theorem statement or location changed")
    if bool(obligations) != bool(target):
        raise KleanPreflightError(
            "target proposition and obligation inventory disagree"
        )
    sources = _lean_sources(generated)
    sorry_locations: list[str] = []
    for source in sources:
        text = source.read_text()
        for forbidden in (r"\badmit\b", r"\bunsafe\b"):
            if re.search(forbidden, text):
                raise KleanPreflightError(
                    f"forbidden Lean token in {source.relative_to(generated)}"
                )
        for match in re.finditer(r"\bsorry\b", text):
            sorry_locations.append(source.relative_to(generated).as_posix())
    if sorry_locations:
        raise KleanPreflightError("generated immutable project contains sorry")
    if inventory.get("designated_sorries") != 0 or inventory.get(
        "other_sorries"
    ) != 0:
        raise KleanPreflightError("trust inventory has unexpected proof-hole counts")

    declared = _trust_declarations(sources)
    _reject_proposition_trust(generated, sources, declared)
    allowlist = inventory.get("allowlist")
    if not isinstance(allowlist, list):
        raise KleanPreflightError("trust inventory allowlist is malformed")
    expected: dict[str, tuple[str, str]] = {}
    for entry in allowlist:
        if not isinstance(entry, dict):
            raise KleanPreflightError("trust allowlist entry is malformed")
        name = entry.get("name")
        kind = entry.get("kind")
        lean_type = entry.get("type")
        reason = entry.get("reason")
        if not all(
            isinstance(value, str) and value
            for value in (name, kind, lean_type, reason)
        ):
            raise KleanPreflightError("trust allowlist entry is incomplete")
        if name in expected:
            raise KleanPreflightError(
                f"duplicate trust allowlist entry: {name}"
            )
        expected[name] = (kind, lean_type)
    if declared != expected:
        raise KleanPreflightError(
            "generated axiom/opaque declarations differ from trust allowlist"
        )
    _check_imports(generated, sources)
    export_bindings = {
        "frozen_input_sha256": input_hash,
        "stage3_discovery_manifest_sha256": discovery_hash,
        "generated_tree_sha256": generated_hash,
        "trust_inventory_sha256": sidecar_hashes[
            "trust-inventory.json"
        ],
    }
    for field, expected_hash in export_bindings.items():
        if export_result.get(field) != expected_hash:
            label = (
                "trust inventory hash"
                if field == "trust_inventory_sha256"
                else field
            )
            raise KleanPreflightError(
                f"export result {label} does not match immutable inputs"
            )

    with tempfile.TemporaryDirectory(prefix="klean-preflight-") as temporary:
        clean = Path(temporary) / "project"
        shutil.copytree(generated, clean)
        diagnostics: list[dict[str, Any]] = []
        for command in (["lake", "clean"], ["lake", "build"]):
            code, output = run_command(command, cwd=clean, timeout=600)
            diagnostics.append(
                {
                    "command": command,
                    "exit_code": code,
                    "output_sha256": hashlib.sha256(output.encode()).hexdigest(),
                    "output_tail": output[-4000:],
                }
            )
            if code != 0:
                raise KleanPreflightError(
                    f"{' '.join(command)} failed ({code}): {output[-600:]}"
                )
    _require_unchanged_snapshot(
        snapshot, frozen_input, discovery_manifest, generation
    )
    return {
        "schema_version": 3,
        "status": "PASS" if obligations else "KLEAN_NO_OBLIGATIONS",
        "frozen_input_sha256": input_hash,
        "stage1_workspace_sha256": input_hash,
        "stage3_discovery_manifest_sha256": discovery_hash,
        "generated_tree_sha256": generated_hash,
        "target": target,
        "obligation_count": len(obligations),
        "trust_declaration_count": len(declared),
        "designated_sorry_count": 0,
        "diagnostics": diagnostics,
    }


def run_preflight(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    *,
    toolchain_lock: Path,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    frozen_input = Path(frozen_input)
    discovery_manifest = Path(discovery_manifest)
    generation = Path(generation)
    output = generation / "preflight.json"
    if output.exists() or output.is_symlink():
        raise KleanPreflightError(f"preflight result already exists: {output}")

    def error_document(error: KleanPreflightError) -> dict[str, Any]:
        try:
            stage1_hash = klean_export.tree_digest(frozen_input)
        except (OSError, klean_export.KleanExportError):
            stage1_hash = None
        try:
            stage3_hash = hashlib.sha256(
                discovery_manifest.read_bytes()
            ).hexdigest()
        except OSError:
            stage3_hash = None
        return {
            "schema_version": 3,
            "status": "KLEAN_PREFLIGHT_ERROR",
            "error": str(error),
            "stage1_workspace_sha256": stage1_hash,
            "stage3_discovery_manifest_sha256": stage3_hash,
        }

    publication_snapshot: PreflightSnapshot | None = None
    try:
        publication_snapshot = _preflight_snapshot(
            frozen_input, discovery_manifest, generation
        )
        document = check_generation(
            frozen_input,
            discovery_manifest,
            generation,
            toolchain_lock=toolchain_lock,
            run_command=run_command,
        )
        _require_unchanged_snapshot(
            publication_snapshot,
            frozen_input,
            discovery_manifest,
            generation,
        )
    except KleanPreflightError as error:
        document = error_document(error)
    temporary = output.with_name(f".{output.name}.tmp")
    temporary.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n")
    if (
        document.get("status") in {"PASS", "KLEAN_NO_OBLIGATIONS"}
        and publication_snapshot is not None
    ):
        try:
            _require_unchanged_snapshot(
                publication_snapshot,
                frozen_input,
                discovery_manifest,
                generation,
            )
        except KleanPreflightError as error:
            document = error_document(error)
            temporary.write_text(
                json.dumps(document, indent=2, sort_keys=True) + "\n"
            )
    os.replace(temporary, output)
    return document


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input", required=True, type=Path)
    parser.add_argument("--discovery-manifest", required=True, type=Path)
    parser.add_argument("--generation", required=True, type=Path)
    parser.add_argument(
        "--toolchain-lock",
        type=Path,
        default=REPO / "data/klean-toolchain.lock.json",
    )
    arguments = parser.parse_args(argv)
    try:
        result = run_preflight(
            arguments.input,
            arguments.discovery_manifest,
            arguments.generation,
            toolchain_lock=arguments.toolchain_lock,
        )
    except KleanPreflightError as error:
        print(f"Klean preflight failed: {error}", file=sys.stderr)
        return 2
    print(json.dumps(result, sort_keys=True))
    return (
        0
        if result["status"] in {"PASS", "KLEAN_NO_OBLIGATIONS"}
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(main())
        )
    return transformed


def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    modules = _modules(masked_text)
    module = _verification_module(
        modules, _last_verification_main_module(workspace)
    )
    closure = _verification_closure(modules, module)
    rule_documents = _rule_documents(text, closure)
    return {
        "schema_version": 2,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "verification_modules": [module.name for module in closure],
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }
#!/usr/bin/env python3
"""Model-free Stage 6 gate for Klean classification and optional proof."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Callable

REPO = Path(__file__).resolve().parent.parent
if str(REPO) not in sys.path:
    sys.path.insert(0, str(REPO))

from tools import (
    klean_export,
    klean_preflight,
    pipeline_contract,
    stage6_resolution_contract,
)


class KleanFinalGateError(RuntimeError):
    pass


def _run(
    command: list[str],
    *,
    cwd: Path,
    timeout: int,
) -> tuple[int, str]:
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            timeout=timeout,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        return result.returncode, result.stdout
    except subprocess.TimeoutExpired:
        return 124, f"TIMEOUT after {timeout}s"


def _regular_json(path: Path, label: str) -> dict[str, Any]:
    if not path.is_file() or path.is_symlink():
        raise KleanFinalGateError(f"{label} is not a regular file")
    try:
        document = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        raise KleanFinalGateError(f"{label} is malformed") from error
    if not isinstance(document, dict):
        raise KleanFinalGateError(f"{label} must be a JSON object")
    return document


def _candidate_gate(candidate: Path, target: dict[str, Any]) -> None:
    entries = klean_export._tree_entries(candidate)
    proof = candidate / "Proof.lean"
    if not proof.is_file() or proof.is_symlink():
        raise KleanFinalGateError("candidate is missing regular Proof.lean")
    for required in ("lakefile.lean", "lean-toolchain"):
        path = candidate / required
        if not path.is_file() or path.is_symlink():
            raise KleanFinalGateError(f"candidate is missing regular {required}")
    candidate_sources: list[tuple[str, str]] = []
    for relative, kind, path in entries:
        if kind != "file" or path.suffix != ".lean":
            continue
        text = path.read_text()
        if Path(relative).parts[0] != "Base":
            candidate_sources.append((relative, text))
        forbidden = re.search(
            r"\b(?:sorry|admit|unsafe|axiom|opaque)\b", text
        )
        if forbidden is not None:
            raise KleanFinalGateError(
                f"candidate contains forbidden Lean token "
                f"{forbidden.group(0)!r} in {relative}"
            )
    statement = target.get("statement")
    parameters = target.get("parameters")
    if not isinstance(statement, str) or not statement:
        raise KleanFinalGateError("generator target statement is malformed")
    if not isinstance(parameters, list):
        raise KleanFinalGateError("generator target bindings are malformed")
    proof_text = proof.read_text()
    for parameter in parameters:
        if not isinstance(parameter, dict):
            raise KleanFinalGateError("generator target binding is malformed")
        name = parameter.get("name")
        lean_type = parameter.get("type")
        if not isinstance(name, str) or not isinstance(lean_type, str):
            raise KleanFinalGateError("generator target binding is malformed")
        declarations = [
            (relative, match.start())
            for relative, text in candidate_sources
            for match in re.finditer(
                rf"(?m)^\s*(?:@\[[^\n]*\]\s*)*"
                rf"(?:noncomputable\s+)?def\s+{re.escape(name)}"
                rf"\s*(?::|\()",
                text,
            )
        ]
        if len(declarations) != 1:
            raise KleanFinalGateError(
                f"candidate must define exact trust binding {name!r} once"
            )
    theorem_matches = re.findall(
        r"(?ms)^\s*theorem\s+final\s*:\s*(.*?)\s*:=\s*by\b",
        proof_text,
    )
    if len(theorem_matches) != 1:
        raise KleanFinalGateError(
            "candidate must contain exactly one theorem final"
        )
    if " ".join(theorem_matches[0].split()) != " ".join(statement.split()):
        raise KleanFinalGateError(
            "Proof.final does not state the exact generated target"
        )


def _allowed_axioms(inventory: dict[str, Any]) -> set[str]:
    allowlist = inventory.get("allowlist")
    if not isinstance(allowlist, list):
        raise KleanFinalGateError("trust inventory allowlist is malformed")
    names = {"Classical.choice", "propext", "Quot.sound"}
    for entry in allowlist:
        if not isinstance(entry, dict):
            raise KleanFinalGateError("trust inventory entry is malformed")
        name = entry.get("name")
        if not isinstance(name, str) or not name:
            raise KleanFinalGateError("trust inventory name is malformed")
        names.add(name)
    return names


def _parse_axioms(output: str) -> set[str]:
    matches = list(re.finditer(r"depends on axioms:\s*\[", output))
    axiom_free = re.findall(
        r"does not depend on any axioms", output
    )
    if len(matches) + len(axiom_free) != 1:
        raise KleanFinalGateError("#print axioms output is missing or ambiguous")
    if axiom_free:
        return set()
    tokens: list[str] = []
    token: list[str] = []
    quoted = False
    for character in output[matches[0].end() :]:
        if character == "«" and not quoted:
            quoted = True
            token.append(character)
        elif character == "»" and quoted:
            quoted = False
            token.append(character)
        elif character == "," and not quoted:
            name = "".join(token).strip()
            if not name:
                raise KleanFinalGateError(
                    "#print axioms output contains an empty axiom name"
                )
            tokens.append(name)
            token = []
        elif character == "]" and not quoted:
            name = "".join(token).strip()
            if name:
                tokens.append(name)
            return set(tokens)
        else:
            token.append(character)
    raise KleanFinalGateError("#print axioms output has no closing bracket")


def check_proof_candidate(
    generation: Path,
    candidate: Path,
    *,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    """Independently build and axiom-check one immutable Stage 5 proof."""

    generation = Path(generation)
    candidate = Path(candidate)
    manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    target = manifest.get("target")
    if not isinstance(target, dict):
        raise KleanFinalGateError("generator target is malformed")
    before_generation = klean_export.tree_digest(generation)
    before_candidate = klean_export.tree_digest(candidate)
    _candidate_gate(candidate, target)
    inventory = _regular_json(
        generation / "trust-inventory.json", "trust inventory"
    )
    diagnostics: list[dict[str, Any]] = []
    with tempfile.TemporaryDirectory(prefix="klean-proof-check-") as temporary:
        project = Path(temporary) / "project"
        shutil.copytree(candidate, project)
        if klean_export.tree_digest(project) != before_candidate:
            raise KleanFinalGateError(
                "candidate changed while copying for mechanical audit"
            )
        shutil.rmtree(project / ".lake", ignore_errors=True)
        shutil.rmtree(project / "Base", ignore_errors=True)
        shutil.copytree(generation / "generated", project / "Base")
        audit_source = project / "AxiomAudit.lean"
        audit_source.write_text(
            "import Proof\n\n"
            "namespace Proof\n\n"
            f"#check (final : {target['statement']})\n"
            "#print axioms final\n\n"
            "end Proof\n"
        )
        outputs: dict[tuple[str, ...], str] = {}
        commands = (
            ["lake", "clean"],
            ["lake", "build"],
            ["lake", "env", "lean", "AxiomAudit.lean"],
        )
        for command in commands:
            code, output = run_command(command, cwd=project, timeout=600)
            diagnostics.append(
                {
                    "command": command,
                    "exit_code": code,
                    "output_sha256": hashlib.sha256(
                        output.encode()
                    ).hexdigest(),
                    "output_tail": output[-4000:],
                }
            )
            outputs[tuple(command)] = output
            if code != 0:
                raise KleanFinalGateError(
                    f"{' '.join(command)} failed ({code}): {output[-600:]}"
                )
        used_axioms = _parse_axioms(
            outputs[("lake", "env", "lean", "AxiomAudit.lean")]
        )
    if klean_export.tree_digest(generation) != before_generation:
        raise KleanFinalGateError(
            "generation changed during mechanical audit"
        )
    if klean_export.tree_digest(candidate) != before_candidate:
        raise KleanFinalGateError(
            "candidate changed during mechanical audit"
        )
    if "sorryAx" in used_axioms:
        raise KleanFinalGateError("Proof.final depends on forbidden sorryAx")
    allowed = _allowed_axioms(inventory)
    unexpected = sorted(
        axiom for axiom in used_axioms if axiom not in allowed
    )
    if unexpected:
        raise KleanFinalGateError(
            "Proof.final has unrecorded axiom dependencies: "
            + ", ".join(unexpected)
        )
    return {
        "status": "PASS",
        "target": target,
        "generation_sha256": before_generation,
        "candidate_sha256": before_candidate,
        "used_axioms": sorted(used_axioms),
        "diagnostics": diagnostics,
    }


def evaluate_proof_candidate(
    generation: Path,
    candidate: Path,
    *,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    try:
        return check_proof_candidate(
            generation, candidate, run_command=run_command
        )
    except KleanFinalGateError as error:
        return {"status": "FAIL", "error": str(error)}
    except BaseException as error:
        return {
            "status": "AUDIT_ERROR",
            "error": f"{type(error).__name__}: {error}",
        }


def _audit_input_binding(path: Path) -> dict[str, Any]:
    document = _regular_json(path, "Stage 6 audit input")
    try:
        resolution, digest = (
            stage6_resolution_contract.verify_audit_input(document)
        )
    except (
        stage6_resolution_contract.Stage6ResolutionContractError
    ) as error:
        raise KleanFinalGateError(str(error)) from error
    mode = resolution.get("mode")
    hashes = resolution.get("hashes")
    if (
        mode not in {
            "CLASSIFICATION_ONLY",
            "CLASSIFICATION_AND_PROOF",
        }
        or not isinstance(hashes, dict)
    ):
        raise KleanFinalGateError(
            "Stage 6 audit input binding is malformed"
        )
    return {
        "resolution": resolution,
        "resolved_input_sha256": digest,
    }


def _input_hashes(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
) -> dict[str, Any]:
    try:
        return {
            "k_workspace_sha256": pipeline_contract.sha256_tree(
                frozen_input
            ),
            "stage1_export_sha256": klean_export.tree_digest(
                frozen_input
            ),
            "discovery_manifest_sha256": (
                pipeline_contract.sha256_file(discovery_manifest)
            ),
            "klean_generation_sha256": (
                pipeline_contract.sha256_tree(generation)
            ),
            "lean_workspace_sha256": (
                pipeline_contract.sha256_tree(candidate)
                if candidate is not None
                else None
            ),
        }
    except (
        OSError,
        klean_export.KleanExportError,
        pipeline_contract.PipelineContractError,
    ) as error:
        raise KleanFinalGateError(
            "cannot hash Stage 6 mechanical inputs"
        ) from error


def _require_bound_inputs(
    audit_input: dict[str, Any],
    observed: dict[str, Any],
) -> None:
    expected = audit_input["resolution"]["hashes"]
    for key, digest in observed.items():
        if expected.get(key) != digest:
            raise KleanFinalGateError(
                f"Stage 6 {key} differs from audit input"
            )


def _result_binding(audit_input: Path) -> dict[str, Any]:
    try:
        document = _audit_input_binding(Path(audit_input))
    except KleanFinalGateError:
        return {}
    return {
        "mode": document["resolution"]["mode"],
        "resolved_input_sha256": document[
            "resolved_input_sha256"
        ],
        "input_hashes": document["resolution"]["hashes"],
    }


def check_final(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    frozen_input = Path(frozen_input)
    discovery_manifest = Path(discovery_manifest)
    generation = Path(generation)
    candidate = Path(candidate) if candidate is not None else None
    audit_binding = _audit_input_binding(Path(audit_input))
    signed_resolution = audit_binding["resolution"]
    if (
        signed_resolution["mode"] == "CLASSIFICATION_AND_PROOF"
        and candidate is None
    ):
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    if (
        signed_resolution["mode"] == "CLASSIFICATION_ONLY"
        and candidate is not None
    ):
        raise KleanFinalGateError(
            "classification-only audit must not use a Stage 5 Lean "
            "candidate"
        )
    expected_mode = signed_resolution["mode"]
    observed_mode = (
        "CLASSIFICATION_AND_PROOF"
        if candidate is not None
        else "CLASSIFICATION_ONLY"
    )
    if observed_mode != expected_mode:
        raise KleanFinalGateError(
            "Stage 6 mechanical mode differs from audit input"
        )
    before_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    _require_bound_inputs(audit_binding, before_hashes)
    try:
        preflight = klean_preflight.check_generation(
            frozen_input,
            discovery_manifest,
            generation,
            toolchain_lock=toolchain_lock,
            run_command=run_command,
        )
    except klean_preflight.KleanPreflightError as error:
        raise KleanFinalGateError(
            f"deterministic Klean preflight failed: {error}"
        ) from error
    preflight_status = preflight.get("status")
    if preflight_status not in {"PASS", "KLEAN_NO_OBLIGATIONS"}:
        raise KleanFinalGateError(
            "Stage 4 Klean preflight is not mechanically auditable"
        )
    manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    target = manifest.get("target")
    if preflight_status == "KLEAN_NO_OBLIGATIONS":
        if candidate is not None:
            raise KleanFinalGateError(
                "classification-only audit must not use a Stage 5 Lean "
                "candidate"
            )
        if target is not None or preflight.get("obligation_count") != 0:
            raise KleanFinalGateError(
                "KLEAN_NO_OBLIGATIONS has a target or nonempty domain set"
            )
        after_hashes = _input_hashes(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
        )
        if after_hashes != before_hashes:
            raise KleanFinalGateError(
                "resolved inputs changed during mechanical audit"
            )
        _require_bound_inputs(audit_binding, after_hashes)
        return {
            "status": "PASS",
            "mode": "CLASSIFICATION_ONLY",
            "resolved_input_sha256": audit_binding[
                "resolved_input_sha256"
            ],
            "input_hashes": signed_resolution["hashes"],
            "semantic_classification": "NOT_EVALUATED",
            "target": None,
            "klean_preflight": preflight,
            "generation_sha256": klean_export.tree_digest(generation),
            "candidate_sha256": None,
            "used_axioms": [],
            "diagnostics": [],
        }
    if candidate is None:
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    proof_check = check_proof_candidate(
        generation, candidate, run_command=run_command
    )
    after_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    if after_hashes != before_hashes:
        if (
            after_hashes.get("lean_workspace_sha256")
            != before_hashes.get("lean_workspace_sha256")
        ):
            raise KleanFinalGateError(
                "candidate changed during mechanical audit"
            )
        raise KleanFinalGateError(
            "resolved inputs changed during mechanical audit"
        )
    _require_bound_inputs(audit_binding, after_hashes)
    return {
        "status": "PASS",
        "mode": "CLASSIFICATION_AND_PROOF",
        "resolved_input_sha256": audit_binding[
            "resolved_input_sha256"
        ],
        "input_hashes": signed_resolution["hashes"],
        "semantic_classification": "NOT_EVALUATED",
        "target": proof_check["target"],
        "klean_preflight": preflight,
        "generation_sha256": proof_check["generation_sha256"],
        "candidate_sha256": proof_check["candidate_sha256"],
        "used_axioms": proof_check["used_axioms"],
        "diagnostics": proof_check["diagnostics"],
    }


def run_gate(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    output: Path,
) -> dict[str, Any]:
    output = Path(output)
    if output.exists() or output.is_symlink():
        raise KleanFinalGateError(f"output already exists: {output}")
    try:
        document = check_final(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
            toolchain_lock=toolchain_lock,
            audit_input=audit_input,
        )
    except KleanFinalGateError as error:
