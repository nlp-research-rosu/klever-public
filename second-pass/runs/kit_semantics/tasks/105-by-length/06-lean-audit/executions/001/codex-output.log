+        "klean_py_sha256": generator_manifest["klean_py_sha256"],
+        "generator_image_id": manifest_image_id,
+    },
+}
+OUTPUT.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+print(json.dumps(result, indent=2, sort_keys=True))
+if failed_checks:
+    raise SystemExit(1)
