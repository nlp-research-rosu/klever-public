new file mode 100644
index 0000000000000000000000000000000000000000..860e47012d56cdb6b5eb386408c56b452082719f
--- /dev/null
+++ b//tmp/audit-work/fix_proc_exe.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  char expected[64];
+  int length = snprintf(expected, sizeof(expected), "/proc/%ld/exe",
+                        (long)getpid());
+  if (length > 0 && (size_t)length < sizeof(expected) &&
+      strcmp(path, expected) == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}
diff --git a//tmp/audit-work/trace_paths.c b//tmp/audit-work/trace_paths.c
new file mode 100644
index 0000000000000000000000000000000000000000..c2869ee3d924f7b22e704c2d0ab9f87ba79c4b71
--- /dev/null
+++ b//tmp/audit-work/trace_paths.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  errno = 0;
+  ssize_t result = real_readlink(path, buffer, size);
+  int saved_errno = errno;
+  fprintf(stderr, "TRACE readlink(%s) => %zd errno=%d (%s)",
+          path, result, saved_errno, strerror(saved_errno));
+  if (result >= 0) {
+    fprintf(stderr, " value=%.*s", (int)result, buffer);
+  }
+  fputc('\n', stderr);
+  errno = saved_errno;
+  return result;
+}
