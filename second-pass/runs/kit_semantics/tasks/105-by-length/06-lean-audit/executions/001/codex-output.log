+  "${audit_project}/OperationalBridgeAudit.lean"
+cp -a /audit-output/evidence/CounterfactualAudit.lean \
+  "${audit_project}/CounterfactualAudit.lean"
+
+cd "${audit_project}"
+lake clean
+lake build
