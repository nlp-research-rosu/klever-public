diff --git a/evidence/fix_proc_exe.c b/evidence/fix_proc_exe.c
new file mode 100644
index 0000000000000000000000000000000000000000..23300eecf9dc16d683cb9082d33909bea734b4f3
--- /dev/null
+++ b/evidence/fix_proc_exe.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+/*
+ * The audit container exposes /proc from a different PID namespace. Lean
+ * asks for /proc/<getpid()>/exe, which is absent, while /proc/self/exe is
+ * correct. Redirect only that current-process lookup; all other readlink
+ * calls are unchanged.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  char expected[64];
+  int length = snprintf(expected, sizeof(expected), "/proc/%ld/exe",
+                        (long)getpid());
+  if (length > 0 && (size_t)length < sizeof(expected) &&
+      strcmp(path, expected) == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}

The audit report and complete evidence set are written. The final verdict is FAIL/NOT_LEGIT solely because the Stage 5 applyCmp binding contradicts explicit frozen operational rules, despite clean structural and proof checks.
