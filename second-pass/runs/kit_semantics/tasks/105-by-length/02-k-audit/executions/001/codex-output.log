diff --git a/evidence/fixed-semantics-lemma.k b/evidence/fixed-semantics-lemma.k
new file mode 100644
index 0000000000000000000000000000000000000000..0ac1343ff2792569b32107e97fecc628b59e6468
--- /dev/null
+++ b/evidence/fixed-semantics-lemma.k
@@ -0,0 +1,16 @@
+requires "reference-semantics/semantics.k"
+
+module FIXED-SEMANTICS-LEMMA
+  imports MPY
+
+  // Bridge-free fixed-semantics equation underlying verification.k's guarded
+  // sort-refinement simplification.  The additional step from V:Val with
+  // isInt(V) to X:Int is the generated K sort-predicate/cast contract.
+  claim [int-equality]:
+    <k>
+      applyCmp("==", X:Int, I:Int)
+      =>
+      X ==Int I
+      ...
+    </k>
+endmodule
