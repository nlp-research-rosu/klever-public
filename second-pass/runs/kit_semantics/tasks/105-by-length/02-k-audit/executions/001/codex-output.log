+         "by_length"
+           |-> closureVal(
+                 ("arr", .ParamNames),
+                 Return(ListExpr(.Exprs)) .Stmts,
+                 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
