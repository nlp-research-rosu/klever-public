     6	  // Exact syntactic abbreviations for the two translated Python bodies.
     7	  syntax Stmts ::= "collectLoopBody" [macro]
     8	  rule collectLoopBody
     9	    => If(
    10	         Compare(Name("value"), CmpOp("==", Name("digit"))),
    11	         Expr(Call(Attribute(Name("result"), "append"), Name("name"), .Exprs))
    12	           .Stmts,
    13	         .Stmts)
    14	       .Stmts
    15	
    16	  syntax Stmts ::= "collectDigitBody" [macro]
    17	  rule collectDigitBody
    18	    => Assign(Name("result"), ListExpr(.Exprs))
    19	       Assign(Name("value"), Int(0))
    20	       For(Name("value"), Name("arr"), collectLoopBody)
    21	       Return(Name("result"))
    22	       .Stmts
    23	
    24	  syntax Stmts ::= "byLengthBody" [macro]
    25	  rule byLengthBody
    26	    => Return(
    27	         BinOp("+",
    28	           BinOp("+",
    29	             BinOp("+",
    30	               BinOp("+",
    31	                 BinOp("+",
    32	                   BinOp("+",
    33	                     BinOp("+",
    34	                       BinOp("+",
    35	                         Call(Name("collect_digit"),
    36	                              (Name("arr"), Int(9), Str("Nine"), .Exprs)),
    37	                         Call(Name("collect_digit"),
    38	                              (Name("arr"), Int(8), Str("Eight"), .Exprs))),
    39	                       Call(Name("collect_digit"),
    40	                            (Name("arr"), Int(7), Str("Seven"), .Exprs))),
    41	                     Call(Name("collect_digit"),
    42	                          (Name("arr"), Int(6), Str("Six"), .Exprs))),
    43	                   Call(Name("collect_digit"),
    44	                        (Name("arr"), Int(5), Str("Five"), .Exprs))),
    45	                 Call(Name("collect_digit"),
    46	                      (Name("arr"), Int(4), Str("Four"), .Exprs))),
    47	               Call(Name("collect_digit"),
    48	                    (Name("arr"), Int(3), Str("Three"), .Exprs))),
    49	             Call(Name("collect_digit"),
    50	                  (Name("arr"), Int(2), Str("Two"), .Exprs))),
    51	           Call(Name("collect_digit"),
    52	                (Name("arr"), Int(1), Str("One"), .Exprs))))
    53	       .Stmts
    54	
    55	  syntax Module ::= "solutionModule" [macro]
    56	  rule solutionModule
    57	    => Module(
    58	         FuncDef(
    59	           "collect_digit",
    60	           Params("arr", "digit", "name", .ParamNames),
    61	           collectDigitBody)
    62	         FuncDef(
    63	           "by_length",
