    88	         #if {X}:>Int ==Int D
    89	         #then collectAcc(
    90	                 REST,
    91	                 D,
    92	                 N,
    93	                 valSeqConcat(ACC, vCons(N, .ValSeq)))
    94	         #else collectAcc(REST, D, N, ACC)
    95	         #fi
    96	       #else collectAcc(REST, D, N, ACC)
    97	       #fi
    98	
    99	  // The prompt's result: one group per digit, in descending digit order.
