    65	           byLengthBody)
    66	         .Stmts)
    67	
    68	  // True exactly on ValSeq values whose elements are all Python integers.
    69	  syntax Bool ::= allInts(ValSeq) [function, total]
    70	  rule allInts(.ValSeq) => true
    71	  rule allInts(vCons(V:Val, REST:ValSeq))
    72	    => isInt(V) andBool allInts(REST)
    73	
    74	  // Derived sort-refinement lemma for MPY-INT's existing equality equation.
    75	  rule applyCmp("==", V:Val, I:Int)
    76	    => {V}:>Int ==Int I
    77	    requires isInt(V)
    78	    [simplification]
    79	
    80	  // The exact accumulator result of collect_digit's remaining iterations.
    81	  // Its off-domain totalization ignores non-integers; the theorem only uses
    82	  // allInts inputs, where this is exactly the Python helper's behavior.
    83	  syntax ValSeq ::= collectAcc(ValSeq, Int, Val, ValSeq) [function, total]
    84	  rule collectAcc(.ValSeq, _:Int, _:Val, ACC:ValSeq) => ACC
    85	  rule collectAcc(vCons(X:Val, REST:ValSeq), D:Int, N:Val, ACC:ValSeq)
    86	    => #if isInt(X)
