+      "classification": "DOMAIN_LEMMA",
+      "rationale": "Additional guarded simplification fact about applyCmp used to refine an isInt value; Stage 1 compiles this rule before every proof and contains no prior rule-free proof of its exact statement, so it is trusted rather than separately proved."
+    },
+    {
+      "source_rule_id": "rule-71bf531cb528d1347e0a5832ea7e03bbac0c3023754ea73e59f68348ed0f3bae",
+      "classification": "DEFINITION",
+      "rationale": "Base equation defining the collectAcc summary on an empty remaining sequence."
+    },
+    {
+      "source_rule_id": "rule-d0c98c20c0cd5ca4e7da32399bf306e24d37834742a0c41c2baec6f58fd809e7",
+      "classification": "DEFINITION",
+      "rationale": "Structural recurrence defining collectAcc on a nonempty sequence, including its explicit non-integer totalization."
+    },
+    {
+      "source_rule_id": "rule-a37220915a776fe106be230a864954901967f8c85ed0fbb76b60e2233efefb0a",
+      "classification": "DEFINITION",
+      "rationale": "Equation defining byLengthVS as the concatenation of the nine digit-name collection summaries."
+    }
+  ]
+}

