+def collect_digit(arr, digit, name):
+    result = []
+    value = 0
+    for value in arr:
+        if value == digit:
+            result.append(name)
+    return result
+
+
+def by_length(arr):
+    return (
+        collect_digit(arr, 9, "Nine")
+        + collect_digit(arr, 8, "Eight")
+        + collect_digit(arr, 7, "Seven")
+        + collect_digit(arr, 6, "Six")
+        + collect_digit(arr, 5, "Five")
+        + collect_digit(arr, 4, "Four")
+        + collect_digit(arr, 3, "Three")
+        + collect_digit(arr, 2, "Two")
+        + collect_digit(arr, 1, "One")
+    )
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..d6d3415e2ed40de10508e127a47a640074590535
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated target: it returns [] for the realizable input [1].
+  claim [empty-body-is-not-by-length]:
+    <k>
+      Call(
+        Name("by_length"),
+        (list(vCons(1, .ValSeq)), .Exprs))
+      => ref(?H:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("collect_digit"
+           |-> closureVal(
+                 ("arr", "digit", "name", .ParamNames),
+                 collectDigitBody,
+                 0)
+         "by_length"
+           |-> closureVal(
+                 ("arr", .ParamNames),
+                 Return(ListExpr(.Exprs)) .Stmts,
+                 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      (?H |-> list(byLengthVS(vCons(1, .ValSeq)))) ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..ceeaaba124b0fead081cb623a86bb70703b45910
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,41 @@
+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Deliberately false: append an extra "Wrong" element to every result.
+  claim [false-by-length]:
+    <k>
+      Call(Name("by_length"), (list(VS:ValSeq), .Exprs))
+      => ref(?H:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("collect_digit"
+           |-> closureVal(
+                 ("arr", "digit", "name", .ParamNames),
+                 collectDigitBody,
+                 0)
+         "by_length"
+           |-> closureVal(("arr", .ParamNames), byLengthBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      (?H
+        |-> list(
+              valSeqConcat(
+                byLengthVS(VS),
+                vCons(str(strToCodes("Wrong")), .ValSeq))))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allInts(VS)
+endmodule
