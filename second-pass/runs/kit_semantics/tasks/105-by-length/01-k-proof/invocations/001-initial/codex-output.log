                           command that would be executed to stdout.
      --execute-to-branch  Execute until a non-deterministic state is reached, then exit.
                           Requires the --enable-search option to have been passed to kompile
                           on the LLVM backend.
      --haskell-backend-command CMD  use CMD instead of kore-exec to invoke
                                     Haskell backend
  -h, --help               Display this help and exit
      --io [on|off]        Enable/disable reading/writing to actual
                           stdin/stdout via cells with "stream" attribute.
                           Defaults to enabled when performing concrete
                           execution, and disabled when --search is passed.
      --no-expand-macros   Don't expand macros in initial configuration.
                           This assumes that the initial configuration contains
                           no macro terms. Behavior is undefined if this is not
                           true.
      --no-pattern         Skip pattern matching the result of searches on the
                           llvm backend against the default search pattern.
      --no-substitution-filtering  Don't filter conjuncts with anonymous
                                   variables from substitution output
  -o, --output MODE        Select output mode to use when unparsing. Valid
                           values are pretty, program, kast, json,
                           kore, and none.
      --output-file FILE   Print final configuration to FILE
  -pNAME=VALUE             Use VALUE as a command to parse $NAME. For example,
                           if NAME=PGM and VALUE=cat, and the user also passes
                           `-cPGM=foo`, a temporary file containing the word
                           "foo" is created and cat is called on it to provide
                           the value of $PGM as a KORE term.
      --parser VALUE       Use VALUE as parser to parse $PGM. For example,
                           if the user says "krun --parser cat foo.kore", then
                           `cat foo.kore` is invoked and the result on stdout
                           is used as the value of $PGM as a KORE term.
      --pattern PAT        Use PAT as the search pattern with --search. Can
                           also be used without --search to match the output
                           configuration against a pattern and print the
                           substitution. Not supported on LLVM backend.
      --proof-hint         Generate proof hint instead of final configuration.
                           Ignores `--output`.
      --save-temps         Do not delete temporary files when krun terminates.
      --search             Search for all possible output states after
                           rewriting. Only supported on symbolic backends.
      --search-all         Like --search, but also return interim states
      --search-final       Synonym for --search
      --search-one-or-more-steps  Like --search-all, but do not include the
                                  initial state in the result
      --search-one-step    Search for all possible states that are the
                           immediate successor of the input.
      --smt [none|z3]      Enable/disable SMT solver for symbolic execution.
      --smt-prelude FILE   Prepend FILE to all SMT queries during symbolic
                           execution.
      --smt-timeout SMT_TIMEOUT
                           Timeout for calls to the SMT solver, in milliseconds
      --statistics         Print number of steps executed. Currently only
                           supported on LLVM backend.
      --term               Use the value that would otherwise be considered the
                           value for $PGM as the entire input configuration.
                           i.e., skip composing configuration from
                           configuration variables.
      --version            Print version of K
      --                   Interpret all arguments following as positional
                           arguments.

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b75277933dd2c44352d51445cdc800be99920aac
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,21 @@
+def collect_digit(arr, digit, name):
+    result = []
+    value = 0
+    for value in arr:
+        if value == digit:
+            result.append(name)
+    return result
+
+
+def by_length(arr):
+    return (
+        collect_digit(arr, 9, "Nine")
+        + collect_digit(arr, 8, "Eight")
+        + collect_digit(arr, 7, "Seven")
+        + collect_digit(arr, 6, "Six")
+        + collect_digit(arr, 5, "Five")
+        + collect_digit(arr, 4, "Four")
+        + collect_digit(arr, 3, "Three")
+        + collect_digit(arr, 2, "Two")
+        + collect_digit(arr, 1, "One")
+    )
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5d1e24e504ac680e30669f919b32c4a7d9911a03
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,60 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [collect-loop]:
+    <k>
+      #loop(list(VS:ValSeq), Name("value"), collectLoopBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("arr" |-> list(WHOLE:ValSeq)
+         "digit" |-> D:Int
+         "name" |-> N:Val
+         "result" |-> ref(H:Int)
+         "value" |-> (OLD:Val => ?FINAL:Val)),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> (list(ACC:ValSeq) => list(collectAcc(VS, D, N, ACC)))
+      ...
+    </heap>
+    requires allInts(VS)
+
+  claim [by-length]:
+    <k>
+      Call(Name("by_length"), (list(VS:ValSeq), .Exprs))
+      => ref(?H:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("collect_digit"
+           |-> closureVal(
+                 ("arr", "digit", "name", .ParamNames),
+                 collectDigitBody,
+                 0)
+         "by_length"
+           |-> closureVal(("arr", .ParamNames), byLengthBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      (?H |-> list(byLengthVS(VS))) ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allInts(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e7e9916ece9a94eb09abc82ab5b5651757242b5e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,106 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact syntactic abbreviations for the two translated Python bodies.
+  syntax Stmts ::= "collectLoopBody" [macro]
+  rule collectLoopBody
+    => If(
+         Compare(Name("value"), CmpOp("==", Name("digit"))),
+         Expr(Call(Attribute(Name("result"), "append"), Name("name"), .Exprs))
+           .Stmts,
+         .Stmts)
+       .Stmts
+
+  syntax Stmts ::= "collectDigitBody" [macro]
+  rule collectDigitBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("value"), Int(0))
+       For(Name("value"), Name("arr"), collectLoopBody)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Stmts ::= "byLengthBody" [macro]
+  rule byLengthBody
+    => Return(
+         BinOp("+",
+           BinOp("+",
+             BinOp("+",
+               BinOp("+",
+                 BinOp("+",
+                   BinOp("+",
+                     BinOp("+",
+                       BinOp("+",
+                         Call(Name("collect_digit"),
+                              (Name("arr"), Int(9), Str("Nine"), .Exprs)),
+                         Call(Name("collect_digit"),
+                              (Name("arr"), Int(8), Str("Eight"), .Exprs))),
+                       Call(Name("collect_digit"),
+                            (Name("arr"), Int(7), Str("Seven"), .Exprs))),
+                     Call(Name("collect_digit"),
+                          (Name("arr"), Int(6), Str("Six"), .Exprs))),
+                   Call(Name("collect_digit"),
+                        (Name("arr"), Int(5), Str("Five"), .Exprs))),
+                 Call(Name("collect_digit"),
+                      (Name("arr"), Int(4), Str("Four"), .Exprs))),
+               Call(Name("collect_digit"),
+                    (Name("arr"), Int(3), Str("Three"), .Exprs))),
+             Call(Name("collect_digit"),
+                  (Name("arr"), Int(2), Str("Two"), .Exprs))),
+           Call(Name("collect_digit"),
+                (Name("arr"), Int(1), Str("One"), .Exprs))))
+       .Stmts
+
+  // True exactly on ValSeq values whose elements are all Python integers.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+
+  // Derived sort-refinement lemma for MPY-INT's existing equality equation.
+  rule applyCmp("==", V:Val, I:Int)
+    => {V}:>Int ==Int I
+    requires isInt(V)
+    [simplification]
+
+  // The exact accumulator result of collect_digit's remaining iterations.
+  // Its off-domain totalization ignores non-integers; the theorem only uses
+  // allInts inputs, where this is exactly the Python helper's behavior.
+  syntax ValSeq ::= collectAcc(ValSeq, Int, Val, ValSeq) [function, total]
+  rule collectAcc(.ValSeq, _:Int, _:Val, ACC:ValSeq) => ACC
+  rule collectAcc(vCons(X:Val, REST:ValSeq), D:Int, N:Val, ACC:ValSeq)
+    => #if isInt(X)
+       #then
+         #if {X}:>Int ==Int D
+         #then collectAcc(
+                 REST,
+                 D,
+                 N,
+                 valSeqConcat(ACC, vCons(N, .ValSeq)))
+         #else collectAcc(REST, D, N, ACC)
+         #fi
+       #else collectAcc(REST, D, N, ACC)
+       #fi
+
+  // The prompt's result: one group per digit, in descending digit order.
+  syntax ValSeq ::= byLengthVS(ValSeq) [function, total]
+  rule byLengthVS(VS:ValSeq)
+    => valSeqConcat(
+         valSeqConcat(
+           valSeqConcat(
+             valSeqConcat(
+               valSeqConcat(
+                 valSeqConcat(
+                   valSeqConcat(
+                     valSeqConcat(
+                       collectAcc(VS, 9, str(strToCodes("Nine")), .ValSeq),
+                       collectAcc(VS, 8, str(strToCodes("Eight")), .ValSeq)),
+                     collectAcc(VS, 7, str(strToCodes("Seven")), .ValSeq)),
+                   collectAcc(VS, 6, str(strToCodes("Six")), .ValSeq)),
+                 collectAcc(VS, 5, str(strToCodes("Five")), .ValSeq)),
+               collectAcc(VS, 4, str(strToCodes("Four")), .ValSeq)),
+             collectAcc(VS, 3, str(strToCodes("Three")), .ValSeq)),
+           collectAcc(VS, 2, str(strToCodes("Two")), .ValSeq)),
+         collectAcc(VS, 1, str(strToCodes("One")), .ValSeq))
+endmodule

apply patch
patch: completed
/workspace/concrete_tests.py
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..4eb4c28da32c90e045253d12bf9fe2a71f8b44d6
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,41 @@
+def collect_digit(arr, digit, name):
+    result = []
+    value = 0
+    for value in arr:
+        if value == digit:
+            result.append(name)
+    return result
+
+
+def by_length(arr):
+    return (
+        collect_digit(arr, 9, "Nine")
+        + collect_digit(arr, 8, "Eight")
+        + collect_digit(arr, 7, "Seven")
+        + collect_digit(arr, 6, "Six")
+        + collect_digit(arr, 5, "Five")
+        + collect_digit(arr, 4, "Four")
+        + collect_digit(arr, 3, "Three")
+        + collect_digit(arr, 2, "Two")
+        + collect_digit(arr, 1, "One")
+    )
+
+
+assert by_length([2, 1, 1, 4, 5, 8, 2, 3]) == [
+    "Eight",
+    "Five",
+    "Four",
+    "Three",
+    "Two",
+    "Two",
+    "One",
+    "One",
+]
+assert by_length([]) == []
+assert by_length([1, -1, 55]) == ["One"]
+assert by_length([9, 3, 9, 0, 10, -4, 3]) == [
+    "Nine",
+    "Nine",
+    "Three",
+    "Three",
+]
