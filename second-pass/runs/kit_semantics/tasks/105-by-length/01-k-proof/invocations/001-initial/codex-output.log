+      Call(Name("by_length"), (list(VS:ValSeq), .Exprs))
+      => ref(?H:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("collect_digit"
+           |-> closureVal(
+                 ("arr", "digit", "name", .ParamNames),
+                 collectDigitBody,
+                 0)
+         "by_length"
+           |-> closureVal(("arr", .ParamNames), byLengthBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      (?H |-> list(byLengthVS(VS))) ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
