+  rule collectDigitBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("value"), Int(0))
+       For(Name("value"), Name("arr"), collectLoopBody)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Stmts ::= "byLengthBody" [macro]
+  rule byLengthBody
+    => Return(
+         BinOp("+",
+           BinOp("+",
+             BinOp("+",
+               BinOp("+",
+                 BinOp("+",
+                   BinOp("+",
+                     BinOp("+",
+                       BinOp("+",
+                         Call(Name("collect_digit"),
+                              (Name("arr"), Int(9), Str("Nine"), .Exprs)),
+                         Call(Name("collect_digit"),
+                              (Name("arr"), Int(8), Str("Eight"), .Exprs))),
+                       Call(Name("collect_digit"),
+                            (Name("arr"), Int(7), Str("Seven"), .Exprs))),
+                     Call(Name("collect_digit"),
+                          (Name("arr"), Int(6), Str("Six"), .Exprs))),
+                   Call(Name("collect_digit"),
+                        (Name("arr"), Int(5), Str("Five"), .Exprs))),
+                 Call(Name("collect_digit"),
+                      (Name("arr"), Int(4), Str("Four"), .Exprs))),
+               Call(Name("collect_digit"),
+                    (Name("arr"), Int(3), Str("Three"), .Exprs))),
+             Call(Name("collect_digit"),
+                  (Name("arr"), Int(2), Str("Two"), .Exprs))),
+           Call(Name("collect_digit"),
+                (Name("arr"), Int(1), Str("One"), .Exprs))))
+       .Stmts
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule
+    => Module(
+         FuncDef(
+           "collect_digit",
+           Params("arr", "digit", "name", .ParamNames),
+           collectDigitBody)
+         FuncDef(
+           "by_length",
+           Params("arr", .ParamNames),
+           byLengthBody)
+         .Stmts)
+
+  // True exactly on ValSeq values whose elements are all Python integers.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+
+  // Derived sort-refinement lemma for MPY-INT's existing equality equation.
+  rule applyCmp("==", V:Val, I:Int)
+    => {V}:>Int ==Int I
+    requires isInt(V)
+    [simplification]
+
+  // The exact accumulator result of collect_digit's remaining iterations.
+  // Its off-domain totalization ignores non-integers; the theorem only uses
+  // allInts inputs, where this is exactly the Python helper's behavior.
+  syntax ValSeq ::= collectAcc(ValSeq, Int, Val, ValSeq) [function, total]
+  rule collectAcc(.ValSeq, _:Int, _:Val, ACC:ValSeq) => ACC
+  rule collectAcc(vCons(X:Val, REST:ValSeq), D:Int, N:Val, ACC:ValSeq)
+    => #if isInt(X)
+       #then
+         #if {X}:>Int ==Int D
+         #then collectAcc(
+                 REST,
+                 D,
+                 N,
+                 valSeqConcat(ACC, vCons(N, .ValSeq)))
+         #else collectAcc(REST, D, N, ACC)
+         #fi
+       #else collectAcc(REST, D, N, ACC)
+       #fi
+
+  // The prompt's result: one group per digit, in descending digit order.
+  syntax ValSeq ::= byLengthVS(ValSeq) [function, total]
+  rule byLengthVS(VS:ValSeq)
+    => valSeqConcat(
+         valSeqConcat(
+           valSeqConcat(
+             valSeqConcat(
+               valSeqConcat(
+                 valSeqConcat(
+                   valSeqConcat(
+                     valSeqConcat(
+                       collectAcc(VS, 9, str(strToCodes("Nine")), .ValSeq),
+                       collectAcc(VS, 8, str(strToCodes("Eight")), .ValSeq)),
+                     collectAcc(VS, 7, str(strToCodes("Seven")), .ValSeq)),
+                   collectAcc(VS, 6, str(strToCodes("Six")), .ValSeq)),
+                 collectAcc(VS, 5, str(strToCodes("Five")), .ValSeq)),
+               collectAcc(VS, 4, str(strToCodes("Four")), .ValSeq)),
+             collectAcc(VS, 3, str(strToCodes("Three")), .ValSeq)),
+           collectAcc(VS, 2, str(strToCodes("Two")), .ValSeq)),
+         collectAcc(VS, 1, str(strToCodes("One")), .ValSeq))
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..4eb4c28da32c90e045253d12bf9fe2a71f8b44d6
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,41 @@
+def collect_digit(arr, digit, name):
+    result = []
+    value = 0
+    for value in arr:
+        if value == digit:
+            result.append(name)
+    return result
+
+
+def by_length(arr):
+    return (
+        collect_digit(arr, 9, "Nine")
+        + collect_digit(arr, 8, "Eight")
+        + collect_digit(arr, 7, "Seven")
+        + collect_digit(arr, 6, "Six")
+        + collect_digit(arr, 5, "Five")
+        + collect_digit(arr, 4, "Four")
+        + collect_digit(arr, 3, "Three")
+        + collect_digit(arr, 2, "Two")
+        + collect_digit(arr, 1, "One")
+    )
+
+
+assert by_length([2, 1, 1, 4, 5, 8, 2, 3]) == [
+    "Eight",
+    "Five",
+    "Four",
+    "Three",
+    "Two",
+    "Two",
+    "One",
+    "One",
+]
+assert by_length([]) == []
+assert by_length([1, -1, 55]) == ["One"]
+assert by_length([9, 3, 9, 0, 10, -4, 3]) == [
+    "Nine",
+    "Nine",
+    "Three",
+    "Three",
+]
diff --git a/differential_tests.py b/differential_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..152771b83aa6859d828ddd9ea003e2e677d611d8
--- /dev/null
+++ b/differential_tests.py
@@ -0,0 +1,43 @@
+from itertools import product
+from random import Random
+
+from solution import by_length
+
+
+NAMES = {
+    1: "One",
+    2: "Two",
+    3: "Three",
+    4: "Four",
+    5: "Five",
+    6: "Six",
+    7: "Seven",
+    8: "Eight",
+    9: "Nine",
+}
+
+
+def oracle(arr):
+    return [NAMES[value] for value in sorted(arr, reverse=True) if value in NAMES]
+
+
+def cases():
+    boundary_values = (-2, 0, 1, 2, 8, 9, 10)
+    for length in range(5):
+        yield from (list(items) for items in product(boundary_values, repeat=length))
+
+    random = Random(20260725)
+    for _ in range(2000):
+        yield [random.randint(-100, 100) for _ in range(random.randint(0, 30))]
+
+
+checked = 0
+mismatches = 0
+for case in cases():
+    checked += 1
+    if by_length(case) != oracle(case):
+        mismatches += 1
+        print("MISMATCH", case, by_length(case), oracle(case))
+
+print(f"checked={checked} mismatches={mismatches}")
+assert mismatches == 0
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..77a1945435884e1e6eda0b209b0df88547a5e588
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+mkdir -p proof-logs
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+head -n 21 concrete_tests.py | cmp solution.py -
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled \
+  2>&1 | tee proof-logs/kompile-llvm.log
+
+krun concrete_tests.mpy \
+  --definition runtime-kompiled \
+  --output-file concrete-krun.out
+tr -d '[:space:]' < concrete-krun.out \
+  | rg -q '<k>.K</k>.*<exc>NoExc</exc>.*<exit-code>0</exit-code>'
+rg -n -A2 '<exc>|<exit-code>' concrete-krun.out \
+  | tee proof-logs/krun-summary.log
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  2>&1 | tee proof-logs/kompile-haskell.log
+
+kast solution.mpy \
+  --definition verification-kompiled \
+  --module MPY-SYNTAX \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  --output-file solution-parsed.kore
+kast --expression solutionModule \
+  --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  --output-file claimed-solution.kore
+cmp solution-parsed.kore claimed-solution.kore
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.collect-loop \
+  2>&1 | tee proof-logs/kprove-loop.log
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  2>&1 | tee proof-logs/kprove-all.log
+
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY \
+  > proof-logs/kprove-vacuity.log 2>&1
+vacuity_status=$?
+set -e
+test "${vacuity_status}" -ne 0
+rg -m1 'WarnStuckClaimState' proof-logs/kprove-vacuity.log
+
+set +e
+kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION \
+  > proof-logs/kprove-body-mutation.log 2>&1
+body_mutation_status=$?
+set -e
+test "${body_mutation_status}" -ne 0
+rg -m1 'WarnStuckClaimState' proof-logs/kprove-body-mutation.log
+
+python3 differential_tests.py \
+  2>&1 | tee proof-logs/differential.log
