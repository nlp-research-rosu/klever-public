Module(
  FuncDef("collect_digit", Params("arr", "digit", "name"),
    Assign(Name("result"), ListExpr())
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("arr"),
      If(Compare(Name("value"), CmpOp("==", Name("digit"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("name"))),
        ))
    Return(Name("result")))
  FuncDef("by_length", Params("arr"),
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      Call(
                        Name("collect_digit"),
                        Name("arr"),
                        Int(9),
                        Str("Nine")),
                      Call(
                        Name("collect_digit"),
                        Name("arr"),
                        Int(8),
                        Str("Eight"))),
                    Call(
                      Name("collect_digit"),
                      Name("arr"),
                      Int(7),
                      Str("Seven"))),
                  Call(
                    Name("collect_digit"),
                    Name("arr"),
                    Int(6),
                    Str("Six"))),
                Call(
                  Name("collect_digit"),
                  Name("arr"),
                  Int(5),
                  Str("Five"))),
              Call(
                Name("collect_digit"),
                Name("arr"),
                Int(4),
                Str("Four"))),
            Call(
              Name("collect_digit"),
              Name("arr"),
              Int(3),
              Str("Three"))),
          Call(Name("collect_digit"), Name("arr"), Int(2), Str("Two"))),
        Call(Name("collect_digit"), Name("arr"), Int(1), Str("One")))))
  Assert(
    Compare(
      Call(
        Name("by_length"),
        ListExpr(
          Int(2),
          Int(1),
          Int(1),
          Int(4),
          Int(5),
          Int(8),
          Int(2),
          Int(3))),
      CmpOp(
        "==",
        ListExpr(
          Str("Eight"),
          Str("Five"),
          Str("Four"),
          Str("Three"),
          Str("Two"),
          Str("Two"),
          Str("One"),
          Str("One")))))
  Assert(
    Compare(
      Call(Name("by_length"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("by_length"),
        ListExpr(Int(1), UnaryOp("-", Int(1)), Int(55))),
      CmpOp("==", ListExpr(Str("One")))))
  Assert(
    Compare(
      Call(
        Name("by_length"),
        ListExpr(
          Int(9),
          Int(3),
          Int(9),
          Int(0),
          Int(10),
          UnaryOp("-", Int(4)),
          Int(3))),
      CmpOp(
        "==",
        ListExpr(Str("Nine"), Str("Nine"), Str("Three"), Str("Three"))))))
