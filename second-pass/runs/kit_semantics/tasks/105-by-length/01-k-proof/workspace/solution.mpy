Module(
  FuncDef("collect_digit", Params("arr", "digit", "name"),
    Assign(Name("result"), ListExpr())
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("arr"),
      If(Compare(Name("value"), CmpOp("==", Name("digit"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("name"))),
        ))
    Return(Name("result")))
  FuncDef("by_length", Params("arr"),
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      Call(
                        Name("collect_digit"),
                        Name("arr"),
                        Int(9),
                        Str("Nine")),
                      Call(
                        Name("collect_digit"),
                        Name("arr"),
                        Int(8),
                        Str("Eight"))),
                    Call(
                      Name("collect_digit"),
                      Name("arr"),
                      Int(7),
                      Str("Seven"))),
                  Call(
                    Name("collect_digit"),
                    Name("arr"),
                    Int(6),
                    Str("Six"))),
                Call(
                  Name("collect_digit"),
                  Name("arr"),
                  Int(5),
                  Str("Five"))),
              Call(
                Name("collect_digit"),
                Name("arr"),
                Int(4),
                Str("Four"))),
            Call(
              Name("collect_digit"),
              Name("arr"),
              Int(3),
              Str("Three"))),
          Call(Name("collect_digit"), Name("arr"), Int(2), Str("Two"))),
        Call(Name("collect_digit"), Name("arr"), Int(1), Str("One"))))))
