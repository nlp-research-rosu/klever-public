+        if source_rule_id not in manifest_ids
+    ],
+    "extra_in_manifest": [
+        source_rule_id
+        for source_rule_id in manifest_ids
+        if source_rule_id not in canonical_ids
+    ],
+}
+
+print(
+    json.dumps(
+        {"inventory": inventory, "manifest_comparison": comparison},
+        indent=2,
+        sort_keys=True,
+    )
+)
