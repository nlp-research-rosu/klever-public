+def cons (v : SortVal) (rest : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» v rest
+
+def ints : List SortInt → SortValSeq
+  | [] => nil
+  | n :: rest => cons (intVal n) (ints rest)
+
