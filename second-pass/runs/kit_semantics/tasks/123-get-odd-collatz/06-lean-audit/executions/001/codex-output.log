+import Proof
+
+namespace AuditBridge
+
+def nil : SortValSeq :=
+  SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+def intVal (n : SortInt) : SortVal :=
+  SortVal.inj_SortInt n
