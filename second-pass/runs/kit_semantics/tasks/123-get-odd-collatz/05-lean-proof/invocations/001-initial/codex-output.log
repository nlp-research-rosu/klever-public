codex
The remaining launcher failure is a container `/proc` mismatch: Lean 4.22 asks for `/proc/<getpid>/exe`, while this sandbox exposes only `/proc/self/exe`. I’m applying a temporary runtime compatibility shim that redirects only that executable-path lookup; it does not modify or replace the pinned compiler, project, dependencies, or proof sources.
apply patch
patch: completed
/tmp/lean-proc-self.c
diff --git a//tmp/lean-proc-self.c b//tmp/lean-proc-self.c
new file mode 100644
index 0000000000000000000000000000000000000000..206fd684e8c6df3f1eaf2363ddb7d247a939c105
--- /dev/null
+++ b//tmp/lean-proc-self.c
@@ -0,0 +1,16 @@
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *restrict path, char *restrict buf, size_t bufsiz) {
+    const char *effective = path;
+    size_t len = strlen(path);
+    if (len > 10 && strncmp(path, "/proc/", 6) == 0
+        && strcmp(path + len - 4, "/exe") == 0) {
+        effective = "/proc/self/exe";
+    }
+    return syscall(SYS_readlinkat, AT_FDCWD, effective, buf, bufsiz);
+}
