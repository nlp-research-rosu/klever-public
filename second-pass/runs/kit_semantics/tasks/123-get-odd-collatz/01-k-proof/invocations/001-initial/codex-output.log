diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b69b45ec95a845812fdf790e3a22e81b33b2ae80
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  // The odd Collatz values encountered strictly before the terminal 1.
+  syntax ValSeq ::= collatzPrefix(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Definitional summary.  These cases are disjoint and cover every Int:
+  // N <= 1, or N > 1 with Python remainder modulo 2 equal to 0 or 1.
+  rule collatzPrefix(N:Int) => .ValSeq
+    requires N <=Int 1
+
+  rule collatzPrefix(N:Int)
+    => collatzPrefix((N -Int pyMod(N, 2)) /Int 2)
+    requires N >Int 1 andBool pyMod(N, 2) ==Int 0
+
+  rule collatzPrefix(N:Int)
+    => vCons(N, collatzPrefix((3 *Int N) +Int 1))
+    requires N >Int 1 andBool pyMod(N, 2) ==Int 1
+endmodule

