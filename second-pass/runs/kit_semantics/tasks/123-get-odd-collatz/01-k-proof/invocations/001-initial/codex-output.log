+            oddWithoutLast(?TF),
+            vCons(1, .ValSeq))))
+      1 |-> list(?TF:ValSeq)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+    ensures validCollatzTrace(?TF)
+     andBool traceFirstInt(?TF) ==Int N
+     andBool traceLastInt(?TF) ==Int 1
+endmodule
