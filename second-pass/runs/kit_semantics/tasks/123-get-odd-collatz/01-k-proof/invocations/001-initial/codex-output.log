diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..63ea19897a0f440981907dcb16face148e4f5a31
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,120 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // At a loop head, trace is a finite valid trace from start through n, and
+  // odds contains exactly the odd trace elements before the current n.
+  // The RHS existentially describes the finite trace present if the loop
+  // terminates; it does not assert that a terminal trace exists for every n.
+  claim [collatz-loop]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
+          Expr(Call(Attribute(Name("odds"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))))
+        Expr(Call(Attribute(Name("trace"), "append"), Name("n"))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "n"     |-> (N:Int => 1)
+        "odds"  |-> ref(HO:Int)
+        "start" |-> S:Int
+        "trace" |-> ref(HT:Int),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      HO |-> list(A:ValSeq => ?AF:ValSeq)
+      HT |-> list(T:ValSeq => ?TF:ValSeq)
+    </heap>
+    requires N >Int 0
+     andBool validCollatzTrace(T)
+     andBool notBool (T ==K .ValSeq)
+     andBool traceFirstInt(T) ==Int S
+     andBool traceLastInt(T) ==Int N
+     andBool A ==K oddWithoutLast(T)
+    ensures validCollatzTrace(?TF)
+     andBool traceFirstInt(?TF) ==Int S
+     andBool traceLastInt(?TF) ==Int 1
+     andBool ?AF ==K oddWithoutLast(?TF)
+
+  // Exact target invocation: define the translated function in module scope,
+  // resolve that binding, bind N to parameter n, and execute the real body.
+  // The existential trace is an internal finite execution witness.
+  claim [get-odd-collatz]:
+    <k>
+      FuncDef("get_odd_collatz", Params("n"),
+        Assign(Name("odds"), ListExpr(.Exprs))
+        Assign(Name("start"), Name("n"))
+        Assign(Name("trace"), ListExpr(Name("start")))
+        While(Compare(Name("n"), CmpOp(">", Int(1))),
+          If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+            Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
+            Expr(Call(Attribute(Name("odds"), "append"), Name("n")))
+            Assign(
+              Name("n"),
+              BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))))
+          Expr(Call(Attribute(Name("trace"), "append"), Name("n"))))
+        Expr(Call(Attribute(Name("odds"), "append"), Int(1)))
+        Expr(Call(Attribute(Name("odds"), "sort"), .Exprs))
+        Return(Name("odds")))
+      ~> Call(Name("get_odd_collatz"), (N:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "get_odd_collatz" |->
+          closureVal(
+            "n",
+            Assign(Name("odds"), ListExpr(.Exprs))
+            Assign(Name("start"), Name("n"))
+            Assign(Name("trace"), ListExpr(Name("start")))
+            While(Compare(Name("n"), CmpOp(">", Int(1))),
+              If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+                Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
+                Expr(Call(Attribute(Name("odds"), "append"), Name("n")))
+                Assign(
+                  Name("n"),
+                  BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))))
+              Expr(Call(Attribute(Name("trace"), "append"), Name("n"))))
+            Expr(Call(Attribute(Name("odds"), "append"), Int(1)))
+            Expr(Call(Attribute(Name("odds"), "sort"), .Exprs))
+            Return(Name("odds")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        sortVS(
+          valSeqConcat(
+            oddWithoutLast(?TF),
+            vCons(1, .ValSeq))))
+      1 |-> list(?TF:ValSeq)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+    ensures validCollatzTrace(?TF)
+     andBool traceFirstInt(?TF) ==Int N
+     andBool traceLastInt(?TF) ==Int 1
+endmodule
diff --git a/test_differential.py b/test_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc1932330af7ee7aef47a2db2b180a914fd1121a
--- /dev/null
+++ b/test_differential.py
@@ -0,0 +1,33 @@
+from solution import get_odd_collatz
+
+
+def oracle(n):
+    odd_values = []
+    current = n
+    while True:
+        if current % 2 == 1:
+            odd_values.append(current)
+        if current == 1:
+            return sorted(odd_values)
+        if current % 2 == 0:
+            current //= 2
+        else:
+            current = 3 * current + 1
+
+
+def main():
+    inputs = list(range(1, 201)) + [255, 256, 257, 511, 512, 513, 1024]
+    mismatches = []
+    for n in inputs:
+        actual = get_odd_collatz(n)
+        expected = oracle(n)
+        if actual != expected:
+            mismatches.append((n, actual, expected))
+    print(f"checked={len(inputs)} mismatches={len(mismatches)}")
+    if mismatches:
+        print(mismatches[:3])
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9b5597f6645de0a792df09a72238e5799f034c81
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,104 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  syntax Int ::= collatzNext(Int) [function, total]
+  syntax Bool ::= validCollatzTrace(ValSeq) [function, total]
+  syntax Int ::= traceFirstInt(ValSeq) [function, total]
+               | traceLastInt(ValSeq)  [function, total]
+  syntax ValSeq ::= oddWithoutLast(ValSeq) [function, total]
+                  | maybeOdd(Int)             [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // One exact source-level Collatz transition.  Python modulo by 2 is always
+  // 0 or 1, so the equations are disjoint and exhaustive over Int.
+  rule collatzNext(N:Int) => (N -Int pyMod(N, 2)) /Int 2
+    requires pyMod(N, 2) ==Int 0
+  rule collatzNext(N:Int) => (3 *Int N) +Int 1
+    requires pyMod(N, 2) ==Int 1
+
+  // A finite, nonempty Int sequence is a valid trace when every adjacent pair
+  // follows collatzNext.  Recursion is structural on the supplied sequence;
+  // this definition makes no assertion that every positive start reaches 1.
+  rule validCollatzTrace(.ValSeq) => false
+  rule validCollatzTrace(vCons(_:Int, .ValSeq)) => true
+  rule validCollatzTrace(vCons(I:Int, vCons(J:Int, R:ValSeq)))
+    => (J ==Int collatzNext(I))
+       andBool validCollatzTrace(vCons(J, R))
+  rule validCollatzTrace(_:ValSeq) => false [owise]
+
+  rule traceFirstInt(vCons(I:Int, _:ValSeq)) => I
+  rule traceFirstInt(_:ValSeq) => 0 [owise]
+
+  rule traceLastInt(.ValSeq) => 0
+  rule traceLastInt(vCons(I:Int, .ValSeq)) => I
+  rule traceLastInt(vCons(_:Val, vCons(V:Val, R:ValSeq)))
+    => traceLastInt(vCons(V, R))
+  rule traceLastInt(_:ValSeq) => 0 [owise]
+
+  rule maybeOdd(N:Int) => .ValSeq
+    requires pyMod(N, 2) ==Int 0
+  rule maybeOdd(N:Int) => vCons(N, .ValSeq)
+    requires pyMod(N, 2) ==Int 1
+
+  // Odd Int values in all positions except the final trace position.
+  rule oddWithoutLast(.ValSeq) => .ValSeq
+  rule oddWithoutLast(vCons(_:Val, .ValSeq)) => .ValSeq
+  rule oddWithoutLast(vCons(I:Int, vCons(V:Val, R:ValSeq)))
+    => oddWithoutLast(vCons(V, R))
+    requires pyMod(I, 2) ==Int 0
+  rule oddWithoutLast(vCons(I:Int, vCons(V:Val, R:ValSeq)))
+    => vCons(I, oddWithoutLast(vCons(V, R)))
+    requires pyMod(I, 2) ==Int 1
+  rule oddWithoutLast(vCons(_:Val, vCons(V:Val, R:ValSeq)))
+    => oddWithoutLast(vCons(V, R))
+    [owise]
+
+  // Derived from MPY-LIST's two defining equations by structural induction
+  // on A.  These only normalize mathematical sequence expressions.
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+
+  rule valSeqConcat(_:ValSeq, vCons(_:Val, _:ValSeq)) ==K .ValSeq
+    => false
+    [simplification]
+
+  rule .ValSeq ==K valSeqConcat(_:ValSeq, vCons(_:Val, _:ValSeq))
+    => false
+    [simplification]
+
+  // Append laws for the structurally defined finite-trace observers.  Each is
+  // derived by structural induction on T; none replaces program execution.
+  rule traceFirstInt(valSeqConcat(T:ValSeq, vCons(J:Int, .ValSeq)))
+    => traceFirstInt(T)
+    requires notBool (T ==K .ValSeq)
+    [simplification]
+
+  rule traceLastInt(valSeqConcat(_:ValSeq, vCons(J:Int, .ValSeq)))
+    => J
+    [simplification]
+
+  rule validCollatzTrace(
+         valSeqConcat(T:ValSeq, vCons(J:Int, .ValSeq)))
+    => validCollatzTrace(T)
+       andBool (J ==Int collatzNext(traceLastInt(T)))
+    requires notBool (T ==K .ValSeq)
+    [simplification]
+
+  rule oddWithoutLast(
+         valSeqConcat(T:ValSeq, vCons(_:Int, .ValSeq)))
+    => valSeqConcat(
+         oddWithoutLast(T),
+         maybeOdd(traceLastInt(T)))
+    requires validCollatzTrace(T)
+    [simplification]
+endmodule

diff --git a/concrete-smoke.py b/concrete-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..c772e8b9d2b0cb0b24ec716a719386535efa9021
--- /dev/null
+++ b/concrete-smoke.py
@@ -0,0 +1,22 @@
+def get_odd_collatz(n):
+    odds = []
+    start = n
+    trace = [start]
+    while n > 1:
+        if n % 2 == 0:
+            n = n // 2
+        else:
+            odds.append(n)
+            n = 3 * n + 1
+        trace.append(n)
+    odds.append(1)
+    odds.sort()
+    return odds
+
+
+assert get_odd_collatz(1) == [1]
+assert get_odd_collatz(2) == [1]
+assert get_odd_collatz(3) == [1, 3, 5]
+assert get_odd_collatz(5) == [1, 5]
+assert get_odd_collatz(6) == [1, 3, 5]
+assert get_odd_collatz(7) == [1, 5, 7, 11, 13, 17]
