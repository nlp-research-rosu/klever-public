index 0000000000000000000000000000000000000000..b8fb15d26ef4325bd11b0838b69d07193323003d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def get_odd_collatz(n):
+    odds = []
+    while n > 1:
+        if n % 2 == 0:
+            n = n // 2
+        else:
+            odds.append(n)
+            n = 3 * n + 1
+    odds.append(1)
+    odds.sort()
+    return odds
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4bf310ad9b9f9b58b04beaff77b3a4147f5f464a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,95 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // One real loop iteration preserves this invariant.  A is the sequence
+  // already appended to the heap-backed list and collatzPrefix(N) is the
+  // remaining sequence that the loop will append if it terminates.
+  claim [collatz-loop]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
+          Expr(Call(Attribute(Name("odds"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1)))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "n"    |-> (N:Int => 1)
+        "odds" |-> ref(H:Int),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => valSeqConcat(A, collatzPrefix(N)))
+    </heap>
+    requires N >Int 0
+
+  // Exact target invocation: define the translated function in module scope,
+  // resolve that binding, bind N to parameter n, and execute the real body.
+  claim [get-odd-collatz]:
+    <k>
+      FuncDef("get_odd_collatz", Params("n"),
+        Assign(Name("odds"), ListExpr(.Exprs))
+        While(Compare(Name("n"), CmpOp(">", Int(1))),
+          If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+            Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
+            Expr(Call(Attribute(Name("odds"), "append"), Name("n")))
+            Assign(
+              Name("n"),
+              BinOp("+", BinOp("*", Int(3), Name("n")), Int(1)))))
+        Expr(Call(Attribute(Name("odds"), "append"), Int(1)))
+        Expr(Call(Attribute(Name("odds"), "sort"), .Exprs))
+        Return(Name("odds")))
+      ~> Call(Name("get_odd_collatz"), (N:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "get_odd_collatz" |->
+          closureVal(
+            "n",
+            Assign(Name("odds"), ListExpr(.Exprs))
+            While(Compare(Name("n"), CmpOp(">", Int(1))),
+              If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+                Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
+                Expr(Call(Attribute(Name("odds"), "append"), Name("n")))
+                Assign(
+                  Name("n"),
+                  BinOp("+", BinOp("*", Int(3), Name("n")), Int(1)))))
+            Expr(Call(Attribute(Name("odds"), "append"), Int(1)))
+            Expr(Call(Attribute(Name("odds"), "sort"), .Exprs))
+            Return(Name("odds")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        sortVS(
+          valSeqConcat(
+            collatzPrefix(N),
+            vCons(1, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5d63aafc345a81e4b14843cad5635937506080c2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  // The odd Collatz values encountered strictly before the terminal 1.
+  syntax ValSeq ::= collatzPrefix(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Definitional summary.  These cases are disjoint and cover every Int:
+  // N <= 1, or N > 1 with Python remainder modulo 2 equal to 0 or 1.
+  rule collatzPrefix(N:Int) => .ValSeq
+    requires N <=Int 1
+
+  rule collatzPrefix(N:Int)
+    => collatzPrefix((N -Int pyMod(N, 2)) /Int 2)
+    requires N >Int 1 andBool pyMod(N, 2) ==Int 0
+
+  rule collatzPrefix(N:Int)
+    => vCons(N, collatzPrefix((3 *Int N) +Int 1))
+    requires N >Int 1 andBool pyMod(N, 2) ==Int 1
+
+  // Derived from MPY-LIST's two defining equations by structural induction
+  // on A.  These only normalize mathematical sequence expressions.
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module VERIFICATION-SYNTAX --output-definition verification-kompiled' in /workspace
