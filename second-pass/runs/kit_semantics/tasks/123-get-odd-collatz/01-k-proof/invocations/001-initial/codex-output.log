diff --git a/test_differential.py b/test_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc1932330af7ee7aef47a2db2b180a914fd1121a
--- /dev/null
+++ b/test_differential.py
@@ -0,0 +1,33 @@
+from solution import get_odd_collatz
+
+
+def oracle(n):
+    odd_values = []
+    current = n
+    while True:
+        if current % 2 == 1:
+            odd_values.append(current)
+        if current == 1:
+            return sorted(odd_values)
+        if current % 2 == 0:
+            current //= 2
+        else:
+            current = 3 * current + 1
+
+
+def main():
+    inputs = list(range(1, 201)) + [255, 256, 257, 511, 512, 513, 1024]
+    mismatches = []
+    for n in inputs:
+        actual = get_odd_collatz(n)
+        expected = oracle(n)
+        if actual != expected:
+            mismatches.append((n, actual, expected))
+    print(f"checked={len(inputs)} mismatches={len(mismatches)}")
+    if mismatches:
+        print(mismatches[:3])
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5d63aafc345a81e4b14843cad5635937506080c2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  // The odd Collatz values encountered strictly before the terminal 1.
+  syntax ValSeq ::= collatzPrefix(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  // Definitional summary.  These cases are disjoint and cover every Int:
+  // N <= 1, or N > 1 with Python remainder modulo 2 equal to 0 or 1.
+  rule collatzPrefix(N:Int) => .ValSeq
+    requires N <=Int 1
+
+  rule collatzPrefix(N:Int)
+    => collatzPrefix((N -Int pyMod(N, 2)) /Int 2)
+    requires N >Int 1 andBool pyMod(N, 2) ==Int 0
+
+  rule collatzPrefix(N:Int)
+    => vCons(N, collatzPrefix((3 *Int N) +Int 1))
+    requires N >Int 1 andBool pyMod(N, 2) ==Int 1
+
+  // Derived from MPY-LIST's two defining equations by structural induction
+  // on A.  These only normalize mathematical sequence expressions.
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+endmodule

diff --git a/concrete-smoke.py b/concrete-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..8474d8660814650435b1b43b76e685ddeef20443
--- /dev/null
+++ b/concrete-smoke.py
@@ -0,0 +1,19 @@
+def get_odd_collatz(n):
+    odds = []
+    while n > 1:
+        if n % 2 == 0:
+            n = n // 2
+        else:
+            odds.append(n)
+            n = 3 * n + 1
+    odds.append(1)
+    odds.sort()
+    return odds
+
+
+assert get_odd_collatz(1) == [1]
+assert get_odd_collatz(2) == [1]
+assert get_odd_collatz(3) == [1, 3, 5]
+assert get_odd_collatz(5) == [1, 5]
+assert get_odd_collatz(6) == [1, 3, 5]
+assert get_odd_collatz(7) == [1, 5, 7, 11, 13, 17]
