@@ -0,0 +1,11 @@
+def get_odd_collatz(n):
+    odds = []
+    while n > 1:
+        if n % 2 == 0:
+            n = n // 2
+        else:
+            odds.append(n)
+            n = 3 * n + 1
+    odds.append(1)
+    odds.sort()
+    return odds
