Module(
  FuncDef("get_odd_collatz", Params("n"),
    Assign(Name("odds"), ListExpr())
    Assign(Name("start"), Name("n"))
    Assign(Name("trace"), ListExpr(Name("start")))
    While(Compare(Name("n"), CmpOp(">", Int(1))),
      If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
        Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
        Expr(Call(Attribute(Name("odds"), "append"), Name("n")))
        Assign(
          Name("n"),
          BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))))
      Expr(Call(Attribute(Name("trace"), "append"), Name("n"))))
    Expr(Call(Attribute(Name("odds"), "append"), Int(1)))
    Expr(Call(Attribute(Name("odds"), "sort"), ))
    Return(Name("odds")))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(1)),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(2)),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(3)),
      CmpOp("==", ListExpr(Int(1), Int(3), Int(5)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(5)),
      CmpOp("==", ListExpr(Int(1), Int(5)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(6)),
      CmpOp("==", ListExpr(Int(1), Int(3), Int(5)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(7)),
      CmpOp(
        "==",
        ListExpr(Int(1), Int(5), Int(7), Int(11), Int(13), Int(17))))))
