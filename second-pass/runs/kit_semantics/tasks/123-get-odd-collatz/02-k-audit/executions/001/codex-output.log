@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module AUDITOR-FALSE-RESULT
+  imports VERIFICATION
+
+  // Fresh auditor-authored A5 probe. Input 1 satisfies the target domain,
+  // terminates without a loop iteration, and the real function returns [1].
+  // The destination deliberately and falsely requires [2].
+  claim [auditor-false-result]:
+    <k>
+      FuncDef("get_odd_collatz", Params("n"),
+        Assign(Name("odds"), ListExpr(.Exprs))
+        Assign(Name("start"), Name("n"))
+        Assign(Name("trace"), ListExpr(Name("start")))
+        While(Compare(Name("n"), CmpOp(">", Int(1))),
+          If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+            Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
+            Expr(Call(Attribute(Name("odds"), "append"), Name("n")))
+            Assign(
+              Name("n"),
+              BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))))
+          Expr(Call(Attribute(Name("trace"), "append"), Name("n"))))
+        Expr(Call(Attribute(Name("odds"), "append"), Int(1)))
+        Expr(Call(Attribute(Name("odds"), "sort"), .Exprs))
+        Return(Name("odds")))
+      ~> Call(Name("get_odd_collatz"), (1, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?SC:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(2, .ValSeq))
+      1 |-> list(vCons(1, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
diff --git a/evidence/10_non_vacuity.sh b/evidence/10_non_vacuity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3ce549b7d85cffffa111e1e8fe83a783c9fc84b0
--- /dev/null
+++ b/evidence/10_non_vacuity.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -u
+set -o pipefail
+PS4='+ command: '
+set -x
+
+cd /tmp/audit-work/candidate
+cmp -s \
+  auditor-false-result.k \
+  /audit-output/evidence/10_auditor_false_result.k
+printf 'preserved_mutation_cmp_exit=%s\n' "$?"
+
+set +e
+kprove auditor-false-result.k \
+  --definition auditor-verification-kompiled \
+  --spec-module AUDITOR-FALSE-RESULT \
+  > /audit-output/evidence/10_mutation_kprove.raw.log 2>&1
+proof_status=$?
+set -e
+printf 'auditor_false_result_kprove_exit=%s\n' "$proof_status"
+
+rg -n -F 'WarnStuckClaimState' \
+  /audit-output/evidence/10_mutation_kprove.raw.log
+stuck_check=$?
+rg -n -F '0 |-> list ( vCons ( 1 , .ValSeq ) )' \
+  /audit-output/evidence/10_mutation_kprove.raw.log
+actual_result_check=$?
+rg -n -F 'backend terminated because the configuration cannot be' \
+  /audit-output/evidence/10_mutation_kprove.raw.log
+termination_check=$?
+residual_check=$((stuck_check || actual_result_check || termination_check))
+printf 'expected_residual_check_exit=%s\n' "$residual_check"
+
+wc -lc /audit-output/evidence/10_mutation_kprove.raw.log
+tail -n 120 /audit-output/evidence/10_mutation_kprove.raw.log
+
+if [[ "$proof_status" -eq 0 || "$residual_check" -ne 0 ]]; then
+  exit 1
+fi

exec
/bin/bash -lc 'bash /audit-output/evidence/10_non_vacuity.sh > /audit-output/evidence/10_non_vacuity.log 2>&1; status=$?; printf '"'10_non_vacuity_wrapper_exit=%s\\n' \""'$status"; tail -n 150 /audit-output/evidence/10_non_vacuity.log' in /audit-output
