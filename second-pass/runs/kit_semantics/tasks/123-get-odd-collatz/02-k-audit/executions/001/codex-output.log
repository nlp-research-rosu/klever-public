+printf 'stat_exit=%s\n' "$?"
+
+find /candidate /reference /generation-evidence -type l -printf '%p -> %l\n'
+printf 'symlink_scan_exit=%s\n' "$?"
+
+cmp -s /candidate/prompt.py /reference/prompt.py
