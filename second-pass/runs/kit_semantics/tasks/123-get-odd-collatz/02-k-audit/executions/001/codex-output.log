+  --definition auditor-verification-kompiled \
+  --spec-module SPEC
+all_exit=$?
+printf 'all_spec_claims_kprove_exit=%s\n' "$all_exit"
+
+if [[ "$loop_exit" -ne 0 || "$entry_exit" -ne 0 || "$all_exit" -ne 0 ]]; then
+  exit 1
+fi

