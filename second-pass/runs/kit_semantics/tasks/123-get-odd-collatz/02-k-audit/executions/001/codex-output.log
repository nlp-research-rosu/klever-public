+    print(
+        "required_record",
+        raw,
+        "exists=", path.exists(),
+        "file=", path.is_file(),
+        "readable=", path.open("rb").read(1) is not None,
+    )
+PY
+printf 'json_integrity_exit=%s\n' "$?"
