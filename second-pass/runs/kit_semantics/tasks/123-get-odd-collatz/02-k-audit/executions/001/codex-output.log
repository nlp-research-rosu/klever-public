+  /generation-evidence/codex-trace/2026/07/25/rollout-2026-07-25T02-26-36-019f982b-3454-72a0-9280-99e7bcf6de86.jsonl
+printf 'sha256sum_exit=%s\n' "$?"
+
+stat -c '%F %a %s %n' \
+  /audit-input.json \
