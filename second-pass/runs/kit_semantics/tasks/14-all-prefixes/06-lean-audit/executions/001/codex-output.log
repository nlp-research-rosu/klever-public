+    0,
+)
+check(
+    "fresh preflight trust declaration count",
+    rerun_preflight["trust_declaration_count"],
+    len(trust_inventory["allowlist"]),
+)
+
+print(
+    json.dumps(
+        {
+            "status": "PASS",
+            "check_count": len(checks),
+            "checks": checks,
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)

