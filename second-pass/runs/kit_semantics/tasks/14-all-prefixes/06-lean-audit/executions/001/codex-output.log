+independent_classifications = [
+    "DEFINITION",
+    "DEFINITION",
+    "DEFINITION",
+    "DEFINITION",
+    "DEFINITION",
+    "DEFINITION",
+]
+check(
+    "independent classifications versus Stage 3",
