+frozen_digest = tree_digest(ROOT / "k-proof")
+generated_digest = tree_digest(ROOT / "klean-generation/generated")
+check(
+    "input manifest frozen digest",
+    input_manifest["frozen_input_sha256"],
+    frozen_digest,
+)
+check(
+    "input manifest Stage 1 digest",
