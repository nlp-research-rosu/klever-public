+)
+
+canonical_ids = [rule["source_rule_id"] for rule in inventory["rules"]]
+discovery_ids = [rule["source_rule_id"] for rule in discovery["rules"]]
+check("Stage 3 rule count", len(discovery_ids), len(canonical_ids))
