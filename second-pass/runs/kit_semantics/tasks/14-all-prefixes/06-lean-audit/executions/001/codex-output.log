+    return real_readlink(path, buffer, size);
+}
+
+char *realpath(const char *path, char *resolved) {
+    static realpath_fn real_realpath = NULL;
+
+    if (real_realpath == NULL) {
+        real_realpath = (realpath_fn)dlsym(RTLD_NEXT, "realpath");
+    }
+
+    if (is_lean_application_path(path)) {
+        char *output = resolved;
+        if (output == NULL) {
+            output = malloc(512);
+            if (output == NULL) {
+                errno = ENOMEM;
+                return NULL;
+            }
+        }
+        if (audit_app_path(output, 512) == 0) {
+            if (resolved == NULL) {
+                free(output);
+            }
+            return NULL;
+        }
+        return output;
+    }
+
+    if (real_realpath == NULL) {
+        errno = ENOSYS;
+        return NULL;
+    }
+    return real_realpath(path, resolved);
+}
+
+char *__realpath_chk(const char *path, char *resolved, size_t resolved_len) {
+    if (is_lean_application_path(path)) {
+        if (audit_app_path(resolved, resolved_len) == 0) {
+            return NULL;
+        }
+        return resolved;
+    }
+    return realpath(path, resolved);
+}
