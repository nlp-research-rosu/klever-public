     8	  imports MPY-ITER
     9	
    10	  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
    11	
    12	  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
    13	
    14	  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
    15	  context Compare(HOLE, _)
    16	  context Compare(_:Val, CmpOp(_, HOLE))
    17	  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
    18	
    19	  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
    20	  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
    21	
    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule

diff --git a//tmp/audit-work/lean-app-path-shim.c b//tmp/audit-work/lean-app-path-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..be0f0bcfefc158ef70270831b24502203dc18b9d
--- /dev/null
+++ b//tmp/audit-work/lean-app-path-shim.c
@@ -0,0 +1,111 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *program_invocation_short_name;
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+typedef char *(*realpath_fn)(const char *, char *);
+
+static const char toolchain_bin[] =
+    "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/";
+
+static size_t audit_app_path(char *buffer, size_t size) {
+    size_t prefix_len = strlen(toolchain_bin);
+    size_t name_len = strlen(program_invocation_short_name);
+    size_t total = prefix_len + name_len;
+
+    if (size <= total) {
+        errno = ENAMETOOLONG;
+        return 0;
+    }
+    memcpy(buffer, toolchain_bin, prefix_len);
+    memcpy(buffer + prefix_len, program_invocation_short_name, name_len);
+    buffer[total] = '\0';
+    return total;
+}
+
+static int is_lean_application_path(const char *path) {
+    size_t path_len = strlen(path);
+    int is_proc_exe =
+        strncmp(path, "/proc/", 6) == 0 &&
+        path_len >= 10 &&
+        strcmp(path + path_len - 4, "/exe") == 0;
+    return is_proc_exe &&
+           program_invocation_short_name != NULL &&
+           (strcmp(program_invocation_short_name, "lean") == 0 ||
+            strcmp(program_invocation_short_name, "lake") == 0 ||
+            strcmp(program_invocation_short_name, "leanc") == 0);
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    if (is_lean_application_path(path)) {
+        char resolved[512];
+        size_t total = audit_app_path(resolved, sizeof(resolved));
+        if (total == 0 || size < total) {
+            errno = ENAMETOOLONG;
+            return -1;
+        }
+        memcpy(buffer, resolved, total);
+        return (ssize_t)total;
+    }
+
+    if (real_readlink == NULL) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return real_readlink(path, buffer, size);
+}
+
+char *realpath(const char *path, char *resolved) {
+    static realpath_fn real_realpath = NULL;
+
+    if (real_realpath == NULL) {
+        real_realpath = (realpath_fn)dlsym(RTLD_NEXT, "realpath");
+    }
+
+    if (is_lean_application_path(path)) {
+        char *output = resolved;
+        if (output == NULL) {
+            output = malloc(512);
+            if (output == NULL) {
+                errno = ENOMEM;
+                return NULL;
+            }
+        }
+        if (audit_app_path(output, 512) == 0) {
+            if (resolved == NULL) {
+                free(output);
+            }
+            return NULL;
+        }
+        return output;
+    }
+
+    if (real_realpath == NULL) {
+        errno = ENOSYS;
+        return NULL;
+    }
+    return real_realpath(path, resolved);
+}
+
+char *__realpath_chk(const char *path, char *resolved, size_t resolved_len) {
+    if (is_lean_application_path(path)) {
+        if (audit_app_path(resolved, resolved_len) == 0) {
+            return NULL;
+        }
+        return resolved;
+    }
+    return realpath(path, resolved);
+}

