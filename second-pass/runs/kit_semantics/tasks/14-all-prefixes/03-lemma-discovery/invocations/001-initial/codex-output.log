/bin/bash -lc "python3 - <<'PY'
import collections
import json
from pathlib import Path

inventory = json.loads(Path(\"/reference/rule-inventory.json\").read_text())
result = json.loads(Path(\"/workspace/trust-boundary.json\").read_text())

allowed = {\"DEFINITION\", \"OPERATIONAL_RULE\", \"PROVED_DERIVED_LEMMA\", \"DOMAIN_LEMMA\"}
expected_ids = [rule[\"source_rule_id\"] for rule in inventory[\"rules\"]]
actual_ids = [rule[\"source_rule_id\"] for rule in result[\"rules\"]]

assert set(result) == {\"schema_version\", \"inventory_sha256\", \"rules\"}
assert result[\"schema_version\"] == 2
assert result[\"inventory_sha256\"] == inventory[\"inventory_sha256\"]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids))
assert all(set(rule) == {\"source_rule_id\", \"classification\", \"rationale\"} for rule in result[\"rules\"])
assert all(rule[\"classification\"] in allowed for rule in result[\"rules\"])
assert all(isinstance(rule[\"rationale\"], str) and rule[\"rationale\"].strip() for rule in result[\"rules\"])

by_id = {rule[\"source_rule_id\"]: rule for rule in result[\"rules\"]}
for source_rule in inventory[\"rules\"]:
    if \"simplification\" in source_rule[\"attributes\"]:
        assert by_id[source_rule[\"source_rule_id\"]][\"classification\"] in {\"DEFINITION\", \"DOMAIN_LEMMA\"}

counts = collections.Counter(rule[\"classification\"] for rule in result[\"rules\"])
print(f\"schema_version={result['schema_version']}\")
print(f\"inventory_sha256={result['inventory_sha256']}\")
print(f\"inventory_rules={len(expected_ids)} output_rules={len(actual_ids)} unique={len(set(actual_ids))}\")
for classification in sorted(allowed):
    print(f\"{classification}={counts[classification]}\")
print(\"VALIDATION=PASS\")
PY

test \""'$(rg -c '"'The domain-lemma set is empty' DISCOVERY.md)\" -eq 1
test \""'$(rg -c '"'"'^There are no separately proved derived rules'"\\."'$'"' DISCOVERY.md)\" -eq 1
printf '%s\\n' 'DISCOVERY_REQUIRED_STATEMENTS=PASS'" in /workspace
