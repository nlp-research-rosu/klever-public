+from solution import all_prefixes
+
+
+def oracle(string: str):
+    return [string[:end] for end in range(1, len(string) + 1)]
+
+
+CASES = [
+    "",
+    "a",
+    "abc",
+    "xy",
+    "a a",
+    "!?",
+    "prefix",
+    "0123456789",
+]
+
+
