      "normalized_sha256": "c66555fbc7562dc499a559e86f61f18f4641f27b060cdaac63d026c4a6228f4a",
      "rationale": "Base equation for prefixesAcc: when no input characters remain, the named prefix-list summary is exactly the accumulated ValSeq.",
      "source_rule_id": "rule-c66555fbc7562dc499a559e86f61f18f4641f27b060cdaac63d026c4a6228f4a",
      "start_line": 9,
      "text": "  rule prefixesAcc(_P:IntSeq, .IntSeq, ACC:ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "ddc7841337c859b509a00b74a2e0a5b7e6bd9580e358dace34a9474cf5433539",
      "rationale": "Structural recurrence for prefixesAcc: it consumes one IntSeq constructor, appends the newly extended prefix to the accumulator, and defines the summary by recursion on the strict tail.",
      "source_rule_id": "rule-ddc7841337c859b509a00b74a2e0a5b7e6bd9580e358dace34a9474cf5433539",
      "start_line": 10,
      "text": "  rule prefixesAcc(P:IntSeq, iCons(C:Int, R:IntSeq), ACC:ValSeq)\n    => prefixesAcc(\n         seqConcat(P, iCons(C, .IntSeq)),\n         R,\n         valSeqConcat(\n           ACC,\n           vCons(str(seqConcat(P, iCons(C, .IntSeq))), .ValSeq)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "86be445e1c689d1c6ed735a9a647f68ed43460e098ac79c711756a84ec51506c",
      "rationale": "Base equation for finishPrefix: with an empty remaining IntSeq, the named final-prefix summary is the current prefix.",
      "source_rule_id": "rule-86be445e1c689d1c6ed735a9a647f68ed43460e098ac79c711756a84ec51506c",
      "start_line": 21,
      "text": "  rule finishPrefix(P:IntSeq, .IntSeq) => P"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "8cbc95a23d5256ceff710bd39a970d4af1d331ffa290596fe0b2a2bf11fe5e63",
      "rationale": "Structural recurrence for finishPrefix: it extends the current prefix by the next character and defines the final-prefix summary by recursion on the strict tail.",
      "source_rule_id": "rule-8cbc95a23d5256ceff710bd39a970d4af1d331ffa290596fe0b2a2bf11fe5e63",
      "start_line": 22,
      "text": "  rule finishPrefix(P:IntSeq, iCons(C:Int, R:IntSeq))\n    => finishPrefix(seqConcat(P, iCons(C, .IntSeq)), R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "68569d14375a530cd3bc32752b84149ccbaa54ed7ded6be435ffa66ae49a6808",
      "rationale": "Base equation for finishChar: if the remaining IntSeq is empty, the named final loop-target summary retains its current value.",
      "source_rule_id": "rule-68569d14375a530cd3bc32752b84149ccbaa54ed7ded6be435ffa66ae49a6808",
      "start_line": 26,
      "text": "  rule finishChar(CH:Val, .IntSeq) => CH"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "77a2c1942531821ff4fcd1cb2a8c9e380517c3e7efcf1f6ae4048acf2974e2e8",
      "rationale": "Structural recurrence for finishChar: it records the current one-character string and defines the final loop-target summary by recursion on the strict IntSeq tail.",
      "source_rule_id": "rule-77a2c1942531821ff4fcd1cb2a8c9e380517c3e7efcf1f6ae4048acf2974e2e8",
      "start_line": 27,
      "text": "  rule finishChar(_CH:Val, iCons(C:Int, R:IntSeq))\n    => finishChar(str(iCons(C, .IntSeq)), R)"
    }
  ],
