Module(
  FuncDef("all_prefixes", Params("string"),
    Assign(Name("prefixes"), ListExpr())
    Assign(Name("prefix"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("string"),
      Assign(Name("prefix"), BinOp("+", Name("prefix"), Name("char")))
      Expr(Call(Attribute(Name("prefixes"), "append"), Name("prefix"))))
    Return(Name("prefixes")))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("a")),
      CmpOp("==", ListExpr(Str("a")))))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("abc")),
      CmpOp("==", ListExpr(Str("a"), Str("ab"), Str("abc")))))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("xy")),
      CmpOp("==", ListExpr(Str("x"), Str("xy")))))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("a a")),
      CmpOp("==", ListExpr(Str("a"), Str("a "), Str("a a")))))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("!?")),
      CmpOp("==", ListExpr(Str("!"), Str("!?"))))))
