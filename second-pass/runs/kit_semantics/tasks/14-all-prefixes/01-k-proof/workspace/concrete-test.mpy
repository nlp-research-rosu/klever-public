Module(
  FuncDef("all_prefixes", Params("string"),
    Assign(Name("prefixes"), ListExpr())
    Assign(Name("prefix"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("string"),
      Assign(Name("prefix"), BinOp("+", Name("prefix"), Name("char")))
      Expr(Call(Attribute(Name("prefixes"), "append"), Name("prefix"))))
    Return(Name("prefixes")))
  Assign(Name("empty_result"), Call(Name("all_prefixes"), Str("")))
  Assign(Name("abc_result"), Call(Name("all_prefixes"), Str("abc"))))
