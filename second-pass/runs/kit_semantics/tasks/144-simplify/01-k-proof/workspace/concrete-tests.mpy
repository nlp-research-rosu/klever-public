Module(
  FuncDef("simplify", Params("x", "n"),
    Assign(Name("part"), Int(0))
    Assign(Name("a"), Int(0))
    Assign(Name("b"), Int(0))
    Assign(Name("c"), Int(0))
    Assign(Name("d"), Int(0))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), BinOp("+", BinOp("+", Name("x"), Str("/")), Name("n")),
      If(Compare(Name("ch"), CmpOp("==", Str("/"))),
        Assign(Name("part"), BinOp("+", Name("part"), Int(1))),
        If(Compare(Name("part"), CmpOp("==", Int(0))),
          Assign(
            Name("a"),
            BinOp(
              "+",
              BinOp("*", Name("a"), Int(10)),
              BinOp("-", Call(Name("ord"), Name("ch")), Int(48)))),
          If(Compare(Name("part"), CmpOp("==", Int(1))),
            Assign(
              Name("b"),
              BinOp(
                "+",
                BinOp("*", Name("b"), Int(10)),
                BinOp("-", Call(Name("ord"), Name("ch")), Int(48)))),
            If(Compare(Name("part"), CmpOp("==", Int(2))),
              Assign(
                Name("c"),
                BinOp(
                  "+",
                  BinOp("*", Name("c"), Int(10)),
                  BinOp("-", Call(Name("ord"), Name("ch")), Int(48)))),
              Assign(
                Name("d"),
                BinOp(
                  "+",
                  BinOp("*", Name("d"), Int(10)),
                  BinOp("-", Call(Name("ord"), Name("ch")), Int(48)))))))))
    Return(
      Compare(
        BinOp(
          "%",
          BinOp("*", Name("a"), Name("c")),
          BinOp("*", Name("b"), Name("d"))),
        CmpOp("==", Int(0)))))
  Assert(Call(Name("simplify"), Str("1/5"), Str("5/1")))
  Assert(UnaryOp("not", Call(Name("simplify"), Str("1/6"), Str("2/1"))))
  Assert(
    UnaryOp("not", Call(Name("simplify"), Str("7/10"), Str("10/2"))))
  Assert(Call(Name("simplify"), Str("00012/0005"), Str("00015/0004")))
  Assert(
    Call(
      Name("simplify"),
      Str("999999999999999999/7"),
      Str("14/999999999999999999"))))
