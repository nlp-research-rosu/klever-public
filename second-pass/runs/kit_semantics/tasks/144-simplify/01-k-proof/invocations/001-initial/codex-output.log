+    <exc> NoExc </exc>
+    requires validScan(REST, 3, A, B, C, D)
+
+  claim [loop-phase-3]:
+    <k>
+      #loop(str(iCons(CODE, REST)), Name("ch"), simplifyLoopBody)
+      ~> (simplifyReturn .Stmts)
+      ~> #endcall
+      =>
+      scanResult(iCons(CODE, REST), 3, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 3, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(CODE)
+     andBool validScan(
+       REST, 3, A, B, C, D *Int 10 +Int (CODE -Int 48))
+
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2f51800e8bfa8991be82d1da3fd525f391477b43
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def simplify(x, n):
+    part = 0
+    a = 0
+    b = 0
+    c = 0
+    d = 0
+    ch = ""
+    for ch in x + "/" + n:
+        if ch == "/":
+            part = part + 1
+        elif part == 0:
+            a = a * 10 + (ord(ch) - 48)
+        elif part == 1:
+            b = b * 10 + (ord(ch) - 48)
+        elif part == 2:
+            c = c * 10 + (ord(ch) - 48)
+        else:
+            d = d * 10 + (ord(ch) - 48)
+    return (a * c) % (b * d) == 0
