diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..427a569c6b15efee2ee8d3cda49306284782aa51
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,97 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  syntax Stmts ::= "simplifyBody" | "simplifyLoopBody" [function, total]
+  syntax Stmt ::= "simplifyReturn" [function, total]
+  syntax Scope ::= simplifyScope(Val, Val, Int, Int, Int, Int, Int, Val)
+                   [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule simplifyLoopBody =>
+    If(
+      Compare(Name("ch"), CmpOp("==", Str("/"))),
+      Assign(Name("part"), BinOp("+", Name("part"), Int(1))) .Stmts,
+      If(
+        Compare(Name("part"), CmpOp("==", Int(0))),
+        Assign(
+          Name("a"),
+          BinOp(
+            "-",
+            BinOp(
+              "+",
+              BinOp("*", Name("a"), Int(10)),
+              Call(Name("ord"), Name("ch"), .Exprs)),
+            Int(48))) .Stmts,
+        If(
+          Compare(Name("part"), CmpOp("==", Int(1))),
+          Assign(
+            Name("b"),
+            BinOp(
+              "-",
+              BinOp(
+                "+",
+                BinOp("*", Name("b"), Int(10)),
+                Call(Name("ord"), Name("ch"), .Exprs)),
+              Int(48))) .Stmts,
+          If(
+            Compare(Name("part"), CmpOp("==", Int(2))),
+            Assign(
+              Name("c"),
+              BinOp(
+                "-",
+                BinOp(
+                  "+",
+                  BinOp("*", Name("c"), Int(10)),
+                  Call(Name("ord"), Name("ch"), .Exprs)),
+                Int(48))) .Stmts,
+            Assign(
+              Name("d"),
+              BinOp(
+                "-",
+                BinOp(
+                  "+",
+                  BinOp("*", Name("d"), Int(10)),
+                  Call(Name("ord"), Name("ch"), .Exprs)),
+                Int(48))) .Stmts) .Stmts) .Stmts) .Stmts) .Stmts
+
+  rule simplifyReturn =>
+    Return(
+      Compare(
+        BinOp(
+          "%",
+          BinOp("*", Name("a"), Name("c")),
+          BinOp("*", Name("b"), Name("d"))),
+        CmpOp("==", Int(0))))
+
+  rule simplifyBody =>
+    Assign(Name("part"), Int(0))
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(0))
+    Assign(Name("c"), Int(0))
+    Assign(Name("d"), Int(0))
+    Assign(Name("ch"), Str(""))
+    For(
+      Name("ch"),
+      BinOp("+", BinOp("+", Name("x"), Str("/")), Name("n")),
+      simplifyLoopBody)
+    simplifyReturn
+    .Stmts
+
+  rule simplifyScope(X, N, P, A, B, C, D, CH) =>
+    scope(
+      "x" |-> X
+      "n" |-> N
+      "part" |-> P
+      "a" |-> A
+      "b" |-> B
+      "c" |-> C
+      "d" |-> D
+      "ch" |-> CH,
+      parent(0))
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..8924c57ed7c9e31e10ab8466445b987144c280c6
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,26 @@
+def simplify(x, n):
+    part = 0
+    a = 0
+    b = 0
+    c = 0
+    d = 0
+    ch = ""
+    for ch in x + "/" + n:
+        if ch == "/":
+            part = part + 1
+        elif part == 0:
+            a = a * 10 + ord(ch) - 48
+        elif part == 1:
+            b = b * 10 + ord(ch) - 48
+        elif part == 2:
+            c = c * 10 + ord(ch) - 48
+        else:
+            d = d * 10 + ord(ch) - 48
+    return (a * c) % (b * d) == 0
+
+
+assert simplify("1/5", "5/1")
+assert not simplify("1/6", "2/1")
+assert not simplify("7/10", "10/2")
+assert simplify("00012/0005", "00015/0004")
+assert simplify("999999999999999999/7", "14/999999999999999999")
