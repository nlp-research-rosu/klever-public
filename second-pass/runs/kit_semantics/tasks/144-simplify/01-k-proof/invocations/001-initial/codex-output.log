+    requires validScan(REST, 3, A, B, C, D)
+
+  claim [loop-phase-3]:
+    <k>
+      #loop(str(iCons(CODE, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(CODE, REST), 3, A, B, C, D)
+    </k>
