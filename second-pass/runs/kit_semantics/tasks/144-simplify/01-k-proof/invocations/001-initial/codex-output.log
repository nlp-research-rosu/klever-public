+     andBool intDigAcc(iCons(DIGIT, REST), B) >Int 0
+     andBool intDigAcc(NN, 0) >Int 0
+     andBool intDigAcc(ND, 0) >Int 0
+
+  claim [loop-phase-2]:
+    <k>
+      #loop(
+        str(seqConcat(iCons(DIGIT, REST), iCons(47, ND))),
+        Name("ch"),
+        simplifyLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> MODSCOPE
+      1 |-> (
+        simplifyScope(XARG, NARG, 2, A, B, C, 0, OLDCH)
+        =>
+        simplifyScope(
+          XARG,
+          NARG,
+          3,
+          A,
+          B,
+          intDigAcc(iCons(DIGIT, REST), C),
+          intDigAcc(ND, 0),
+          ?CH))
+      -1 |-> builtinsScope
+    </scopes>
+    requires allDigit(iCons(DIGIT, REST)) andBool allDigit(ND)
+     andBool isLen(ND) >Int 0
+     andBool intDigAcc(ND, 0) >Int 0
+
+  claim [loop-phase-3]:
+    <k>
+      #loop(str(iCons(DIGIT, REST)), Name("ch"), simplifyLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> MODSCOPE
+      1 |-> (
+        simplifyScope(XARG, NARG, 3, A, B, C, D, OLDCH)
+        =>
+        simplifyScope(
+          XARG,
+          NARG,
+          3,
+          A,
+          B,
+          C,
+          intDigAcc(iCons(DIGIT, REST), D),
+          ?CH))
+      -1 |-> builtinsScope
+    </scopes>
+    requires allDigit(iCons(DIGIT, REST))
+     andBool intDigAcc(iCons(DIGIT, REST), D) >Int 0
+
+  claim [simplify-full-domain]:
+    <k>
+      #applyK(
+        toCall(closureVal(("x", "n"), simplifyBody, 0)),
+        (str(seqConcat(iCons(XNH, XNT), iCons(47, iCons(XDH, XDT)))),
+         str(seqConcat(iCons(NNH, NNT), iCons(47, iCons(NDH, NDT)))),
+         .Vals))
+      =>
+      pyMod(
+        intDigAcc(iCons(XNH, XNT), 0)
+          *Int intDigAcc(iCons(NNH, NNT), 0),
+        intDigAcc(iCons(XDH, XDT), 0)
+          *Int intDigAcc(iCons(NDH, NDT), 0)) ==Int 0
+    </k>
