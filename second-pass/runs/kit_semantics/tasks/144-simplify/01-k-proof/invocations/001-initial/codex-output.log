/bin/bash -lc 'python3 py2mpy.py solution.py > solution.mpy && python3 py2mpy.py concrete-tests.py > concrete-tests.mpy && python3 concrete-tests.py && kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
