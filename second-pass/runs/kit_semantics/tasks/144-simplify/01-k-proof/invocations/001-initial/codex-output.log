+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(CODE)
+     andBool validScan(
+       REST, 1, A, B *Int 10 +Int (CODE -Int 48), C, D)
+
+  claim [loop-slash-1]:
+    <k>
+      #loop(str(iCons(47, REST)), Name("ch"), simplifyLoopBody)
+      ~> (simplifyReturn .Stmts)
+      ~> #endcall
