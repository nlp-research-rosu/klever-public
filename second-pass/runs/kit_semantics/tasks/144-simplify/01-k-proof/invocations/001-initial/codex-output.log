diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5da010247f9382caf954c0b69206ed07f763ef23
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [concrete-probe]:
+    <k>
+      #applyK(
+        toCall(closureVal(("x", "n"), simplifyBody, 0)),
+        (str(iCons(49, iCons(47, iCons(53, .IntSeq)))),
+         str(iCons(53, iCons(47, iCons(49, .IntSeq)))),
+         .Vals))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?H:Map </heap>
+    <heapLoc> 0 => ?N:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a130295e4f3af9a941c33a7d45f37dc702d03296
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,37 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+
+  syntax Stmts ::= "simplifyBody" [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule simplifyBody =>
+    Assign(
+      Name("x_parts"),
+      Call(Attribute(Name("x"), "split"), Str("/"), .Exprs))
+    Assign(
+      Name("n_parts"),
+      Call(Attribute(Name("n"), "split"), Str("/"), .Exprs))
+    Assign(
+      Name("numerator"),
+      BinOp(
+        "*",
+        Call(Name("int"), Subscript(Name("x_parts"), Int(0)), .Exprs),
+        Call(Name("int"), Subscript(Name("n_parts"), Int(0)), .Exprs)))
+    Assign(
+      Name("denominator"),
+      BinOp(
+        "*",
+        Call(Name("int"), Subscript(Name("x_parts"), Int(1)), .Exprs),
+        Call(Name("int"), Subscript(Name("n_parts"), Int(1)), .Exprs)))
+    Return(
+      Compare(
+        BinOp("%", Name("numerator"), Name("denominator")),
+        CmpOp("==", Int(0))))
+    .Stmts
+endmodule

