+
+  rule simplifyLoopBody =>
+    If(
+      Compare(Name("ch"), CmpOp("==", Str("/"))),
+      Assign(Name("part"), BinOp("+", Name("part"), Int(1))) .Stmts,
+      If(
+        Compare(Name("part"), CmpOp("==", Int(0))),
+        Assign(
+          Name("a"),
+          BinOp(
+            "-",
+            BinOp(
+              "+",
+              BinOp("*", Name("a"), Int(10)),
+              Call(Name("ord"), Name("ch"), .Exprs)),
+            Int(48))) .Stmts,
+        If(
+          Compare(Name("part"), CmpOp("==", Int(1))),
+          Assign(
+            Name("b"),
+            BinOp(
+              "-",
+              BinOp(
+                "+",
+                BinOp("*", Name("b"), Int(10)),
+                Call(Name("ord"), Name("ch"), .Exprs)),
+              Int(48))) .Stmts,
+          If(
+            Compare(Name("part"), CmpOp("==", Int(2))),
+            Assign(
+              Name("c"),
+              BinOp(
+                "-",
+                BinOp(
+                  "+",
+                  BinOp("*", Name("c"), Int(10)),
+                  Call(Name("ord"), Name("ch"), .Exprs)),
+                Int(48))) .Stmts,
+            Assign(
+              Name("d"),
+              BinOp(
+                "-",
+                BinOp(
+                  "+",
+                  BinOp("*", Name("d"), Int(10)),
+                  Call(Name("ord"), Name("ch"), .Exprs)),
+                Int(48))) .Stmts) .Stmts) .Stmts) .Stmts) .Stmts
+
+  rule simplifyReturn =>
+    Return(
+      Compare(
+        BinOp(
+          "%",
+          BinOp("*", Name("a"), Name("c")),
+          BinOp("*", Name("b"), Name("d"))),
+        CmpOp("==", Int(0))))
+
+  rule simplifyBody =>
+    Assign(Name("part"), Int(0))
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(0))
+    Assign(Name("c"), Int(0))
+    Assign(Name("d"), Int(0))
+    Assign(Name("ch"), Str(""))
+    For(
+      Name("ch"),
