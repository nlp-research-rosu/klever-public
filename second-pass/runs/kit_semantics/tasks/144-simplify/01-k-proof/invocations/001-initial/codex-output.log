+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [simplify-full-domain]:
+    <k>
+      #applyK(
+        toCall(closureVal(("x", "n"), simplifyBody, 0)),
+        (str(iCons(XHEAD, XTAIL)),
+         str(iCons(NHEAD, NTAIL)),
+         .Vals))
+      =>
+      scanResult(
+        seqConcat(
+          seqConcat(iCons(XHEAD, XTAIL), iCons(47, .IntSeq)),
+          iCons(NHEAD, NTAIL)),
+        0,
+        0,
+        0,
+        0,
+        0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(XHEAD)
+     andBool validScan(
+      seqConcat(
+        seqConcat(XTAIL, iCons(47, .IntSeq)),
+        iCons(NHEAD, NTAIL)),
+      0,
+      XHEAD -Int 48,
+      0,
+      0,
+      0)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b187ba0520007809b0218a1124ef0f97d9e2629c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,351 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+
+  syntax Stmts ::= "simplifyBody" | "simplifyLoopBody" [function, total]
+  syntax Stmt ::= "simplifyReturn" [function, total]
+  syntax Scope ::= simplifyScope(Val, Val, Int, Int, Int, Int, Int, Val)
+                   [function, total]
+  syntax Bool ::= validScan(IntSeq, Int, Int, Int, Int, Int)
+                  [function, total]
+                | scanResult(IntSeq, Int, Int, Int, Int, Int)
+                  [function]
+endmodule
+
+module VERIFICATION-BASE
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule simplifyLoopBody =>
+    If(
+      Compare(Name("ch"), CmpOp("==", Str("/"))),
+      Assign(Name("part"), BinOp("+", Name("part"), Int(1))) .Stmts,
+      If(
+        Compare(Name("part"), CmpOp("==", Int(0))),
+        Assign(
+          Name("a"),
+          BinOp(
+            "+",
+            BinOp(
+              "*",
+              Name("a"),
+              Int(10)),
+            BinOp(
+              "-",
+              Call(Name("ord"), Name("ch"), .Exprs),
+              Int(48)))) .Stmts,
+        If(
+          Compare(Name("part"), CmpOp("==", Int(1))),
+          Assign(
+            Name("b"),
+            BinOp(
+              "+",
+              BinOp(
+                "*",
+                Name("b"),
+                Int(10)),
+              BinOp(
+                "-",
+                Call(Name("ord"), Name("ch"), .Exprs),
+                Int(48)))) .Stmts,
+          If(
+            Compare(Name("part"), CmpOp("==", Int(2))),
+            Assign(
+              Name("c"),
+              BinOp(
+                "+",
+                BinOp(
+                  "*",
+                  Name("c"),
+                  Int(10)),
+                BinOp(
+                  "-",
+                  Call(Name("ord"), Name("ch"), .Exprs),
+                  Int(48)))) .Stmts,
+            Assign(
+              Name("d"),
+              BinOp(
+                "+",
+                BinOp(
+                  "*",
+                  Name("d"),
+                  Int(10)),
+                BinOp(
+                  "-",
+                  Call(Name("ord"), Name("ch"), .Exprs),
+                  Int(48)))) .Stmts) .Stmts) .Stmts) .Stmts) .Stmts
+
+  rule simplifyReturn =>
+    Return(
+      Compare(
+        BinOp(
+          "%",
+          BinOp("*", Name("a"), Name("c")),
+          BinOp("*", Name("b"), Name("d"))),
+        CmpOp("==", Int(0))))
+
+  rule simplifyBody =>
+    Assign(Name("part"), Int(0))
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(0))
+    Assign(Name("c"), Int(0))
+    Assign(Name("d"), Int(0))
+    Assign(Name("ch"), Str(""))
+    For(
+      Name("ch"),
+      BinOp("+", BinOp("+", Name("x"), Str("/")), Name("n")),
+      simplifyLoopBody)
+    simplifyReturn
+    .Stmts
+
+  rule simplifyScope(X, N, P, A, B, C, D, CH) =>
+    scope(
+      "x" |-> X
+      "n" |-> N
+      "part" |-> P
+      "a" |-> A
+      "b" |-> B
+      "c" |-> C
+      "d" |-> D
+      "ch" |-> CH,
+      parent(0))
+
+  rule validScan(.IntSeq, 0, _:Int, _:Int, _:Int, _:Int) => false
+  rule validScan(.IntSeq, 1, _:Int, _:Int, _:Int, _:Int) => false
+  rule validScan(.IntSeq, 2, _:Int, _:Int, _:Int, _:Int) => false
+  rule validScan(.IntSeq, 3, A, B, C, D) =>
+    A >Int 0 andBool B >Int 0 andBool C >Int 0 andBool D >Int 0
+  rule validScan(iCons(CODE, REST), 0, A, B, C, D) =>
+    (CODE ==Int 47 andBool validScan(REST, 1, A, B, C, D))
+      orBool
+    (isDigitC(CODE)
+      andBool validScan(
+        REST, 0, A *Int 10 +Int (CODE -Int 48), B, C, D))
+  rule validScan(iCons(CODE, REST), 1, A, B, C, D) =>
+    (CODE ==Int 47 andBool validScan(REST, 2, A, B, C, D))
+      orBool
+    (isDigitC(CODE)
+      andBool validScan(
+        REST, 1, A, B *Int 10 +Int (CODE -Int 48), C, D))
+  rule validScan(iCons(CODE, REST), 2, A, B, C, D) =>
+    (CODE ==Int 47 andBool validScan(REST, 3, A, B, C, D))
+      orBool
+    (isDigitC(CODE)
+      andBool validScan(
+        REST, 2, A, B, C *Int 10 +Int (CODE -Int 48), D))
+  rule validScan(iCons(CODE, REST), 3, A, B, C, D) =>
+    isDigitC(CODE)
+      andBool validScan(
+        REST, 3, A, B, C, D *Int 10 +Int (CODE -Int 48))
+  rule validScan(_:IntSeq, _:Int, _:Int, _:Int, _:Int, _:Int) =>
+    false
+    [owise]
+
+  rule scanResult(.IntSeq, 3, A, B, C, D) =>
+    pyMod(A *Int C, B *Int D) ==Int 0
+    requires A >Int 0 andBool B >Int 0
+      andBool C >Int 0 andBool D >Int 0
+  rule scanResult(iCons(47, REST), P, A, B, C, D) =>
+    scanResult(REST, P +Int 1, A, B, C, D)
+    requires 0 <=Int P andBool P <Int 3
+  rule scanResult(iCons(CODE, REST), 0, A, B, C, D) =>
+    scanResult(REST, 0, A *Int 10 +Int (CODE -Int 48), B, C, D)
+    requires isDigitC(CODE)
+  rule scanResult(iCons(CODE, REST), 1, A, B, C, D) =>
+    scanResult(REST, 1, A, B *Int 10 +Int (CODE -Int 48), C, D)
+    requires isDigitC(CODE)
+  rule scanResult(iCons(CODE, REST), 2, A, B, C, D) =>
+    scanResult(REST, 2, A, B, C *Int 10 +Int (CODE -Int 48), D)
+    requires isDigitC(CODE)
+  rule scanResult(iCons(CODE, REST), 3, A, B, C, D) =>
+    scanResult(REST, 3, A, B, C, D *Int 10 +Int (CODE -Int 48))
+    requires isDigitC(CODE)
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  rule [loop-phase-0-bridge]:
+    <k>
+      #loop(str(iCons(CODE, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(CODE, REST), 0, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 0, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(CODE)
+     andBool validScan(
+       REST, 0, A *Int 10 +Int (CODE -Int 48), B, C, D)
+
+  rule [loop-slash-0-bridge]:
+    <k>
+      #loop(str(iCons(47, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(47, REST), 0, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 0, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires validScan(REST, 1, A, B, C, D)
+
+  rule [loop-phase-1-bridge]:
+    <k>
+      #loop(str(iCons(CODE, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(CODE, REST), 1, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 1, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(CODE)
+     andBool validScan(
+       REST, 1, A, B *Int 10 +Int (CODE -Int 48), C, D)
+
+  rule [loop-slash-1-bridge]:
+    <k>
+      #loop(str(iCons(47, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(47, REST), 1, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 1, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires validScan(REST, 2, A, B, C, D)
+
+  rule [loop-phase-2-bridge]:
+    <k>
+      #loop(str(iCons(CODE, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(CODE, REST), 2, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 2, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(CODE)
+     andBool validScan(
+       REST, 2, A, B, C *Int 10 +Int (CODE -Int 48), D)
+
+  rule [loop-slash-2-bridge]:
+    <k>
+      #loop(str(iCons(47, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(47, REST), 2, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 2, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires validScan(REST, 3, A, B, C, D)
+
+  rule [loop-phase-3-bridge]:
+    <k>
+      #loop(str(iCons(CODE, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(CODE, REST), 3, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 3, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(CODE)
+     andBool validScan(
+       REST, 3, A, B, C, D *Int 10 +Int (CODE -Int 48))
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..65e06b041b6ecf05f7cb809f2dc10d1f29d4f13a
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,26 @@
+def simplify(x, n):
+    part = 0
+    a = 0
+    b = 0
+    c = 0
+    d = 0
+    ch = ""
+    for ch in x + "/" + n:
+        if ch == "/":
+            part = part + 1
+        elif part == 0:
+            a = a * 10 + (ord(ch) - 48)
+        elif part == 1:
+            b = b * 10 + (ord(ch) - 48)
+        elif part == 2:
+            c = c * 10 + (ord(ch) - 48)
+        else:
+            d = d * 10 + (ord(ch) - 48)
+    return (a * c) % (b * d) == 0
+
+
+assert simplify("1/5", "5/1")
+assert not simplify("1/6", "2/1")
+assert not simplify("7/10", "10/2")
+assert simplify("00012/0005", "00015/0004")
+assert simplify("999999999999999999/7", "14/999999999999999999")
