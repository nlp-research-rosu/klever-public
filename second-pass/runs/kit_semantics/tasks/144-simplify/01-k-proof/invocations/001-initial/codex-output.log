src=open('solution.py').read();tree=ast.parse(src);py2mpy.SCOPES.clear();py2mpy._walk_symtable(symtable.symtable(src,'solution.py','exec'));a=py2mpy.render(py2mpy.emit_stmt(tree.body[0]).args[-1]);v=open('verification.k').read();loop=re.search(r'  rule simplifyLoopBody =>\\n(.*?)\\n\\n  rule simplifyReturn =>',v,re.S).group(1);ret=re.search(r'  rule simplifyReturn =>\\n(.*?)\\n\\n  rule simplifyBody =>',v,re.S).group(1);b=re.search(r'  rule simplifyBody =>\\n(.*?)\\n\\n  rule simplifyScope',v,re.S).group(1).replace('simplifyLoopBody',loop).replace('simplifyReturn',ret)
