+    <exc> NoExc </exc>
+    requires isDigitC(XHEAD)
+     andBool validScan(
+      seqConcat(
+        seqConcat(XTAIL, iCons(47, .IntSeq)),
+        iCons(NHEAD, NTAIL)),
+      0,
+      XHEAD -Int 48,
+      0,
+      0,
+      0)
+endmodule
