+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+
+  syntax Stmts ::= "simplifyBody" | "simplifyLoopBody" [function, total]
+  syntax Stmt ::= "simplifyReturn" [function, total]
+  syntax Scope ::= simplifyScope(Val, Val, Int, Int, Int, Int, Int, Val)
+                   [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule simplifyLoopBody =>
+    If(
+      Compare(Name("ch"), CmpOp("==", Str("/"))),
+      Assign(Name("part"), BinOp("+", Name("part"), Int(1))) .Stmts,
+      If(
+        Compare(Name("part"), CmpOp("==", Int(0))),
+        Assign(
+          Name("a"),
+          BinOp(
+            "-",
+            BinOp(
+              "+",
+              BinOp("*", Name("a"), Int(10)),
+              Call(Name("ord"), Name("ch"), .Exprs)),
+            Int(48))) .Stmts,
+        If(
+          Compare(Name("part"), CmpOp("==", Int(1))),
+          Assign(
+            Name("b"),
+            BinOp(
+              "-",
+              BinOp(
+                "+",
+                BinOp("*", Name("b"), Int(10)),
+                Call(Name("ord"), Name("ch"), .Exprs)),
+              Int(48))) .Stmts,
+          If(
+            Compare(Name("part"), CmpOp("==", Int(2))),
+            Assign(
+              Name("c"),
+              BinOp(
+                "-",
+                BinOp(
+                  "+",
+                  BinOp("*", Name("c"), Int(10)),
+                  Call(Name("ord"), Name("ch"), .Exprs)),
+                Int(48))) .Stmts,
+            Assign(
+              Name("d"),
+              BinOp(
+                "-",
+                BinOp(
+                  "+",
+                  BinOp("*", Name("d"), Int(10)),
+                  Call(Name("ord"), Name("ch"), .Exprs)),
+                Int(48))) .Stmts) .Stmts) .Stmts) .Stmts) .Stmts
+
+  rule simplifyReturn =>
+    Return(
+      Compare(
+        BinOp(
+          "%",
+          BinOp("*", Name("a"), Name("c")),
+          BinOp("*", Name("b"), Name("d"))),
+        CmpOp("==", Int(0))))
+
+  rule simplifyBody =>
+    Assign(Name("part"), Int(0))
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(0))
+    Assign(Name("c"), Int(0))
+    Assign(Name("d"), Int(0))
+    Assign(Name("ch"), Str(""))
+    For(
+      Name("ch"),
+      BinOp("+", BinOp("+", Name("x"), Str("/")), Name("n")),
+      simplifyLoopBody)
+    simplifyReturn
+    .Stmts
+
+  rule simplifyScope(X, N, P, A, B, C, D, CH) =>
+    scope(
+      "x" |-> X
+      "n" |-> N
+      "part" |-> P
+      "a" |-> A
+      "b" |-> B
+      "c" |-> C
+      "d" |-> D
+      "ch" |-> CH,
+      parent(0))
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
