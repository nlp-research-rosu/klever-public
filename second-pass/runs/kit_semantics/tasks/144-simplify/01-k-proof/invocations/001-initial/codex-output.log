new file mode 100644
index 0000000000000000000000000000000000000000..2f51800e8bfa8991be82d1da3fd525f391477b43
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def simplify(x, n):
+    part = 0
+    a = 0
+    b = 0
+    c = 0
+    d = 0
+    ch = ""
+    for ch in x + "/" + n:
+        if ch == "/":
+            part = part + 1
+        elif part == 0:
+            a = a * 10 + (ord(ch) - 48)
+        elif part == 1:
+            b = b * 10 + (ord(ch) - 48)
+        elif part == 2:
+            c = c * 10 + (ord(ch) - 48)
+        else:
+            d = d * 10 + (ord(ch) - 48)
+    return (a * c) % (b * d) == 0
