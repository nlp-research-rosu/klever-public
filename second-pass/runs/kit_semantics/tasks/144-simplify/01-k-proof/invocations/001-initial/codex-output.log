index 0000000000000000000000000000000000000000..2f51800e8bfa8991be82d1da3fd525f391477b43
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def simplify(x, n):
+    part = 0
+    a = 0
+    b = 0
+    c = 0
+    d = 0
+    ch = ""
+    for ch in x + "/" + n:
+        if ch == "/":
+            part = part + 1
+        elif part == 0:
+            a = a * 10 + (ord(ch) - 48)
+        elif part == 1:
+            b = b * 10 + (ord(ch) - 48)
+        elif part == 2:
+            c = c * 10 + (ord(ch) - 48)
+        else:
+            d = d * 10 + (ord(ch) - 48)
+    return (a * c) % (b * d) == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b04b19f3cd563bbf36334af7a55b927dd331003
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,174 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-phase-0]:
+    <k>
+      #loop(
+        str(
+          seqConcat(
+            seqConcat(
+              seqConcat(iCons(DIGIT, REST), iCons(47, XD)),
+              iCons(47, .IntSeq)),
+            seqConcat(NN, iCons(47, ND)))),
+        Name("ch"),
+        simplifyLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> (
+        simplifyScope(XARG, NARG, 0, A, 0, 0, 0, OLDCH)
+        =>
+        simplifyScope(
+          XARG,
+          NARG,
+          3,
+          intDigAcc(iCons(DIGIT, REST), A),
+          intDigAcc(XD, 0),
+          intDigAcc(NN, 0),
+          intDigAcc(ND, 0),
+          ?CH))
+      -1 |-> builtinsScope
+    </scopes>
+    requires allDigit(iCons(DIGIT, REST))
+     andBool allDigit(XD) andBool allDigit(NN) andBool allDigit(ND)
+     andBool isLen(XD) >Int 0 andBool isLen(NN) >Int 0
+     andBool isLen(ND) >Int 0
+     andBool intDigAcc(XD, 0) >Int 0
+     andBool intDigAcc(NN, 0) >Int 0
+     andBool intDigAcc(ND, 0) >Int 0
+
+  claim [loop-phase-1]:
+    <k>
+      #loop(
+        str(
+          seqConcat(
+            seqConcat(iCons(DIGIT, REST), iCons(47, .IntSeq)),
+            seqConcat(NN, iCons(47, ND)))),
+        Name("ch"),
+        simplifyLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> (
+        simplifyScope(XARG, NARG, 1, A, B, 0, 0, OLDCH)
+        =>
+        simplifyScope(
+          XARG,
+          NARG,
+          3,
+          A,
+          intDigAcc(iCons(DIGIT, REST), B),
+          intDigAcc(NN, 0),
+          intDigAcc(ND, 0),
+          ?CH))
+      -1 |-> builtinsScope
+    </scopes>
+    requires allDigit(iCons(DIGIT, REST))
+     andBool allDigit(NN) andBool allDigit(ND)
+     andBool isLen(NN) >Int 0 andBool isLen(ND) >Int 0
+     andBool intDigAcc(iCons(DIGIT, REST), B) >Int 0
+     andBool intDigAcc(NN, 0) >Int 0
+     andBool intDigAcc(ND, 0) >Int 0
+
+  claim [loop-phase-2]:
+    <k>
+      #loop(
+        str(seqConcat(iCons(DIGIT, REST), iCons(47, ND))),
+        Name("ch"),
+        simplifyLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> (
+        simplifyScope(XARG, NARG, 2, A, B, C, 0, OLDCH)
+        =>
+        simplifyScope(
+          XARG,
+          NARG,
+          3,
+          A,
+          B,
+          intDigAcc(iCons(DIGIT, REST), C),
+          intDigAcc(ND, 0),
+          ?CH))
+      -1 |-> builtinsScope
+    </scopes>
+    requires allDigit(iCons(DIGIT, REST)) andBool allDigit(ND)
+     andBool isLen(ND) >Int 0
+     andBool intDigAcc(ND, 0) >Int 0
+
+  claim [loop-phase-3]:
+    <k>
+      #loop(str(iCons(DIGIT, REST)), Name("ch"), simplifyLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> (
+        simplifyScope(XARG, NARG, 3, A, B, C, D, OLDCH)
+        =>
+        simplifyScope(
+          XARG,
+          NARG,
+          3,
+          A,
+          B,
+          C,
+          intDigAcc(iCons(DIGIT, REST), D),
+          ?CH))
+      -1 |-> builtinsScope
+    </scopes>
+    requires allDigit(iCons(DIGIT, REST))
+     andBool intDigAcc(iCons(DIGIT, REST), D) >Int 0
+
+  claim [simplify-full-domain]:
+    <k>
+      #applyK(
+        toCall(closureVal(("x", "n"), simplifyBody, 0)),
+        (str(seqConcat(iCons(XNH, XNT), iCons(47, iCons(XDH, XDT)))),
+         str(seqConcat(iCons(NNH, NNT), iCons(47, iCons(NDH, NDT)))),
+         .Vals))
+      =>
+      pyMod(
+        intDigAcc(iCons(XNH, XNT), 0)
+          *Int intDigAcc(iCons(NNH, NNT), 0),
+        intDigAcc(iCons(XDH, XDT), 0)
+          *Int intDigAcc(iCons(NDH, NDT), 0)) ==Int 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allDigit(iCons(XNH, XNT))
+     andBool allDigit(iCons(XDH, XDT))
+     andBool allDigit(iCons(NNH, NNT))
+     andBool allDigit(iCons(NDH, NDT))
+     andBool intDigAcc(iCons(XNH, XNT), 0) >Int 0
+     andBool intDigAcc(iCons(XDH, XDT), 0) >Int 0
+     andBool intDigAcc(iCons(NNH, NNT), 0) >Int 0
+     andBool intDigAcc(iCons(NDH, NDT), 0) >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..dba0990e2c32b7c697b1676c4698349231e12036
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,109 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+
+  syntax Stmts ::= "simplifyBody" | "simplifyLoopBody" [function, total]
+  syntax Stmt ::= "simplifyReturn" [function, total]
+  syntax Scope ::= simplifyScope(Val, Val, Int, Int, Int, Int, Int, Val)
+                   [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule simplifyLoopBody =>
+    If(
+      Compare(Name("ch"), CmpOp("==", Str("/"))),
+      Assign(Name("part"), BinOp("+", Name("part"), Int(1))) .Stmts,
+      If(
+        Compare(Name("part"), CmpOp("==", Int(0))),
+        Assign(
+          Name("a"),
+          BinOp(
+            "+",
+            BinOp(
+              "*",
+              Name("a"),
+              Int(10)),
+            BinOp(
+              "-",
+              Call(Name("ord"), Name("ch"), .Exprs),
+              Int(48)))) .Stmts,
+        If(
+          Compare(Name("part"), CmpOp("==", Int(1))),
+          Assign(
+            Name("b"),
+            BinOp(
+              "+",
+              BinOp(
+                "*",
+                Name("b"),
+                Int(10)),
+              BinOp(
+                "-",
+                Call(Name("ord"), Name("ch"), .Exprs),
+                Int(48)))) .Stmts,
+          If(
+            Compare(Name("part"), CmpOp("==", Int(2))),
+            Assign(
+              Name("c"),
+              BinOp(
+                "+",
+                BinOp(
+                  "*",
+                  Name("c"),
+                  Int(10)),
+                BinOp(
+                  "-",
+                  Call(Name("ord"), Name("ch"), .Exprs),
+                  Int(48)))) .Stmts,
+            Assign(
+              Name("d"),
+              BinOp(
+                "+",
+                BinOp(
+                  "*",
+                  Name("d"),
+                  Int(10)),
+                BinOp(
+                  "-",
+                  Call(Name("ord"), Name("ch"), .Exprs),
+                  Int(48)))) .Stmts) .Stmts) .Stmts) .Stmts) .Stmts
+
+  rule simplifyReturn =>
+    Return(
+      Compare(
+        BinOp(
+          "%",
+          BinOp("*", Name("a"), Name("c")),
+          BinOp("*", Name("b"), Name("d"))),
+        CmpOp("==", Int(0))))
+
+  rule simplifyBody =>
+    Assign(Name("part"), Int(0))
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(0))
+    Assign(Name("c"), Int(0))
+    Assign(Name("d"), Int(0))
+    Assign(Name("ch"), Str(""))
+    For(
+      Name("ch"),
+      BinOp("+", BinOp("+", Name("x"), Str("/")), Name("n")),
+      simplifyLoopBody)
+    simplifyReturn
+    .Stmts
+
+  rule simplifyScope(X, N, P, A, B, C, D, CH) =>
+    scope(
+      "x" |-> X
+      "n" |-> N
+      "part" |-> P
+      "a" |-> A
+      "b" |-> B
+      "c" |-> C
+      "d" |-> D
+      "ch" |-> CH,
+      parent(0))
+endmodule

exec
/bin/bash -lc 'timeout 60s kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-phase-3' in /workspace
