+  rule simplifyScope(X, N, P, A, B, C, D, CH) =>
+    scope(
+      "x" |-> X
+      "n" |-> N
+      "part" |-> P
+      "a" |-> A
+      "b" |-> B
+      "c" |-> C
+      "d" |-> D
+      "ch" |-> CH,
+      parent(0))
+endmodule

