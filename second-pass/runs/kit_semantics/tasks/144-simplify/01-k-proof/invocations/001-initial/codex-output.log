+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 2, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
