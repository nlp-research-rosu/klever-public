exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..65e06b041b6ecf05f7cb809f2dc10d1f29d4f13a
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,26 @@
+def simplify(x, n):
+    part = 0
+    a = 0
+    b = 0
+    c = 0
+    d = 0
+    ch = ""
+    for ch in x + "/" + n:
+        if ch == "/":
+            part = part + 1
+        elif part == 0:
+            a = a * 10 + (ord(ch) - 48)
+        elif part == 1:
+            b = b * 10 + (ord(ch) - 48)
+        elif part == 2:
+            c = c * 10 + (ord(ch) - 48)
+        else:
+            d = d * 10 + (ord(ch) - 48)
+    return (a * c) % (b * d) == 0
+
+
+assert simplify("1/5", "5/1")
+assert not simplify("1/6", "2/1")
+assert not simplify("7/10", "10/2")
+assert simplify("00012/0005", "00015/0004")
+assert simplify("999999999999999999/7", "14/999999999999999999")
