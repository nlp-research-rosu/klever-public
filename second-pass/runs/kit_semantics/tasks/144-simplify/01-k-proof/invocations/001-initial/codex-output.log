+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires validScan(REST, 2, A, B, C, D)
+
+  claim [loop-phase-2]:
+    <k>
+      #loop(str(iCons(CODE, REST)), Name("ch"), simplifyLoopBody)
+      ~> simplifyReturn
+      ~> #endcall
+      =>
+      scanResult(iCons(CODE, REST), 2, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
