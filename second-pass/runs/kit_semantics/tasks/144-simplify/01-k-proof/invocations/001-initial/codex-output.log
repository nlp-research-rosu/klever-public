+      scanResult(iCons(CODE, REST), 3, A, B, C, D)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       1 |-> simplifyScope(XARG, NARG, 3, A, B, C, D, OLDCH)
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(CODE)
+     andBool validScan(
+       REST, 3, A, B, C, D *Int 10 +Int (CODE -Int 48))
+
+endmodule
