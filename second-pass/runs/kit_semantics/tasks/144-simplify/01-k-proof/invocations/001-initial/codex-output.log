+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires isDigitC(XHEAD)
+     andBool validScan(
+      seqConcat(
+        seqConcat(XTAIL, iCons(47, .IntSeq)),
+        iCons(NHEAD, NTAIL)),
