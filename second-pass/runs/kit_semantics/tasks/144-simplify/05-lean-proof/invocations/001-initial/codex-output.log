+                          «simplifyScope(_,_,_,_,_,_,_,_)_VERIFICATION-SYNTAX_Scope_Val_Val_Int_Int_Int_Int_Int_Val»]
+                      all_goals repeat (candidateUnfoldMapModels; try simp)
