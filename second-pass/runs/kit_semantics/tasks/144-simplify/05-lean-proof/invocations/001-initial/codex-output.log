+private noncomputable def candidateLoopStart
+    (codes : SortIntSeq) (xarg narg : SortVal)
+    (phase a b c d : SortInt) (oldch : SortVal)
+    (exitCode : SortExitCodeCell) (counter : SortGeneratedCounterCell) :
