+         suffix = "kleanKeyOrderModel" ||
+         suffix = "kleanMapInsertModel" ||
+         suffix = "kleanMapUpdateModel" then
+        try
+          unfoldTarget name
+          changed := true
+        catch _ => pure ()
+    | _ => pure ()
+  if !changed then
+    throwError "no generated private map model could be unfolded"
