+    const char *application = program_invocation_name;
+    if (realpath(program_invocation_name, resolved) != NULL) application = resolved;
+    size_t n = strlen(application); if (n > size) n = size;
+    memcpy(buffer, application, n); return (ssize_t)n;
+  }
+  return system_readlink(path, buffer, size);
+}
