+import Klean144Simplify.Lemmas
+import Lean.Elab.Command
+import Lean.Elab.Tactic.Unfold
+
+open Lean Elab Tactic
+
+elab "unfoldMapPrivates" : tactic => withMainContext do
+  let env ← getEnv
+  for (name, _) in env.constants.toList do
+    match name with
+    | .str _ suffix =>
+      if suffix = "kleanMapLookupModel" ||
+         suffix = "kleanMapContainsModel" ||
+         suffix = "kleanMapDisjointModel" ||
+         suffix = "kleanMapInsertModel" then
+        try unfoldTarget name catch _ => pure ()
+    | _ => pure ()
+
+noncomputable local instance : DecidableEq SortKItem :=
+  Classical.typeDecidableEq SortKItem
+
+example (a : SortInt) :
+    _root_.«Map:lookup»
+      ⟨[(SortKItem.inj_SortString "a", SortKItem.inj_SortInt a)]⟩
+      (SortKItem.inj_SortString "a") =
+      some (SortKItem.inj_SortInt a) := by
+  unfold _root_.«Map:lookup»
+  unfoldMapPrivates
+  simp
+
+example (a : SortInt) :
+    _root_.«_in_keys(_)_MAP_Bool_KItem_Map»
+      (SortKItem.inj_SortString "a")
+      ⟨[(SortKItem.inj_SortString "a", SortKItem.inj_SortInt a)]⟩ =
+      some true := by
+  unfold _root_.«_in_keys(_)_MAP_Bool_KItem_Map»
+  unfoldMapPrivates
+  simp
+
+set_option pp.fullNames true in
+#check _root_.«Map:lookup»
+
+run_cmd
+  for (name, _) in (← get).env.constants.toList do
+    match name with
+    | .str _ suffix =>
+      if suffix = "kleanMapLookupModel" ||
+         suffix = "kleanMapContainsModel" ||
+         suffix = "kleanMapDisjointModel" ||
+         suffix = "kleanMapInsertModel" then
+        Lean.logInfo name.toString
+    | _ => pure ()
