diff --git a//tmp/lean_app_path_shim.c b//tmp/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..c11bc35ed4a8a05aaa2afd2a15e1264ebcc2358a
--- /dev/null
+++ b//tmp/lean_app_path_shim.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+extern char *program_invocation_name;
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*system_readlink)(const char *, char *, size_t) = NULL;
+  if (!system_readlink) system_readlink = dlsym(RTLD_NEXT, "readlink");
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 && strcmp(path + length - 4, "/exe") == 0) {
+    char resolved[PATH_MAX];
+    const char *application = program_invocation_name;
+    if (realpath(program_invocation_name, resolved) != NULL) application = resolved;
+    size_t n = strlen(application); if (n > size) n = size;
+    memcpy(buffer, application, n); return (ssize_t)n;
+  }
+  return system_readlink(path, buffer, size);
+}
