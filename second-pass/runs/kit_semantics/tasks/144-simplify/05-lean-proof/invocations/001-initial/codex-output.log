+                apply Rewrites.tran
+                · apply Rewrites._1f0e78f <;> rfl
+                · apply Rewrites.tran
+                  · apply Rewrites.«MPY_SYNTAX_BinOp(_,_,_)_MPY_SYNTAX_Expr_String_Expr_Expr2_heat» <;> rfl
