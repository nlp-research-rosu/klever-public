+    heapLoc := { val := 0 },
+    stack := { val := (ListItem
+      (SortKItem.«frame(_,_,_)_MPY-FUNCTIONS_KItem_K_Int_Int» SortK.dotk 0 1)) },
+    ret := { val := SortRetState.«noRet_MPY-CORE_RetState» },
