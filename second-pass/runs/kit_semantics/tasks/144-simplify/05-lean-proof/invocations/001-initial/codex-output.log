+        (candidateLoopStart codes xarg narg phase a b c d oldch exitCode counter)
+        (candidateLoopEnd
+          («scanResult(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
