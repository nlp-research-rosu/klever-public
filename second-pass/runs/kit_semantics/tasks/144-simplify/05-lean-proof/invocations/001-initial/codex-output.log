+              SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»))
+      · apply Rewrites.tran
+        · exact Rewrites._7fe18de
+        · apply Rewrites.tran
+          · exact Rewrites._8e90948
+          · apply Rewrites.tran
+            · exact Rewrites._94bd14e
+            · unfold «simplifyReturn_VERIFICATION-SYNTAX_Stmt»
+              apply Rewrites.tran
