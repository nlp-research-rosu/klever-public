+      («_|->_» (SortKItem.inj_SortInt 0)
+        (SortKItem.inj_SortScope
+          (SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent» «.Map»
+            (SortParent.«parent(_)_MPY-CORE_Parent_Int» (-1)))))
+      (candidateCalleeSingleton x n phase a b c d ch))
