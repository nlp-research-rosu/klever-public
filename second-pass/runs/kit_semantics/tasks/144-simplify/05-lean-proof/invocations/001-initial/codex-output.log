+                  · apply Rewrites.«MPY_SYNTAX_BinOp(_,_,_)_MPY_SYNTAX_Expr_String_Expr_Expr2_heat» <;> rfl
+                  · trace_state
+                    candidateReturnRflSteps
+                    apply Rewrites.tran
+                    · apply Rewrites._db779c6
+                      all_goals
