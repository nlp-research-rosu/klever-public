+                        (_Val2 := candidateActiveScopes xarg narg 3 a b c d oldch)
+                        (_Val3 := SortKItem.inj_SortInt a)
+                        (_Val4 := SortVal.inj_SortInt a)
+                        (_Val5 := candidateCalleeSingleton xarg narg 3 a b c d oldch)
+                        (_Val6 := candidateActiveScopes xarg narg 3 a b c d oldch)
+                      all_goals try simp only [_root_.«_|->_», _root_._Map_,
+                          «_in_keys(_)_MAP_Bool_KItem_Map»,
+                          «Map:lookup», «project:Val»,
+                          candidateCanonicalMap, candidateLocalBindings,
+                          candidatePersistentScopes, candidateCalleeSingleton,
+                          candidateActiveScopes, _Map_, «.Map»,
