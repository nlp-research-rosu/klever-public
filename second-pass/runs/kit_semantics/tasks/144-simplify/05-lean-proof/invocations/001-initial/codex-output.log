+      intro xarg narg phase a b c d oldch exitCode counter hValid
+      simp only [«validScan(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»,
+        decide_eq_true_eq] at hValid
