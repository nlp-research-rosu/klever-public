+    rcases hReturn with ⟨hReturn, _⟩
+    rcases hScope with ⟨hScope, _⟩
+    rcases hBuiltins with ⟨hBuiltins, _⟩
+    simpa only [hBody, hReturn, hScope, hBuiltins,
+      candidateLoopStart, candidateLoopEnd] using
