+          (IT := SortIterable.inj_SortStr
+            (SortStr.«str(_)_MPY-CORE_Str_IntSeq»
+              (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» code rest)))
+      · apply Rewrites.tran
