+          (SortK.kseq SortKItem.«#endcall_MPY-FUNCTIONS_KItem» SortK.dotk))) },
+    env := { val := 1 },
+    scopes := { val := candidateActiveScopes xarg narg phase a b c d oldch },
+    scopeLoc := { val := 2 },
