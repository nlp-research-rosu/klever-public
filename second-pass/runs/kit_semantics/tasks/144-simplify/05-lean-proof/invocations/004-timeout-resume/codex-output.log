diff --git a//tmp/lean_app_path_shim.c b//tmp/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..5018e645f27b0dec16623860433e877b0a4aa5ab
--- /dev/null
+++ b//tmp/lean_app_path_shim.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <unistd.h>
+#include <string.h>
+#include <stdlib.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static readlink_fn real_readlink = NULL;
+  if (!real_readlink) real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  if (path && strncmp(path, "/proc/", 6) == 0) {
+    const char *tail = strrchr(path, '/');
+    if (tail && strcmp(tail, "/exe") == 0) {
+      const char *value = getenv("LEAN_REAL_EXE");
+      if (value) {
+        size_t count = strlen(value);
+        if (count > bufsiz) count = bufsiz;
+        memcpy(buf, value, count);
+        return (ssize_t)count;
+      }
+    }
+  }
+  return real_readlink(path, buf, bufsiz);
+}
