exec
/bin/bash -lc "cp -a /audit-output/evidence/verification-body-mutated.k /audit-output/evidence/body-sensitivity-spec.k /tmp/audit-work/144-simplify/
set -o pipefail
{
 echo 'MUTATION: simplifyBody For loop body simplifyLoopBody -> .Stmts'
 echo 'COMMAND: kompile --backend haskell verification-body-mutated.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition audit-body-mutated-kompiled'
 kompile --backend haskell verification-body-mutated.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition audit-body-mutated-kompiled
 status="'$?
