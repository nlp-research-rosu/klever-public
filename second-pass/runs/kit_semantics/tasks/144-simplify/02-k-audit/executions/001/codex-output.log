     3	module VERIFICATION-SYNTAX
     4	  imports MPY-CORE
     5	
     6	  syntax Stmts ::= "simplifyBody" | "simplifyLoopBody" [function, total]
     7	  syntax Stmt ::= "simplifyReturn" [function, total]
     8	  syntax Scope ::= simplifyScope(Val, Val, Int, Int, Int, Int, Int, Val)
     9	                   [function, total]
    10	  syntax Bool ::= validScan(IntSeq, Int, Int, Int, Int, Int)
    11	                  [function, total]
    12	                | scanResult(IntSeq, Int, Int, Int, Int, Int)
    13	                  [function]
    14	endmodule
