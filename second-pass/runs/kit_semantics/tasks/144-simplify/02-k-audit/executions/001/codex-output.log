+++ b/evidence/adequacy-ground-spec.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module ADEQUACY-GROUND-SPEC
+  imports VERIFICATION
+
+  claim [true-witness-precondition]:
+    <k>
+      validScan(
+        iCons(47,
+          iCons(53,
+            iCons(47,
+              iCons(53,
+                iCons(47,
+                  iCons(49, .IntSeq)))))),
+        0, 1, 0, 0, 0)
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes> .Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
