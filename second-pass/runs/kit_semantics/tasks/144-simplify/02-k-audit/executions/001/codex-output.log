    20	  rule simplifyLoopBody =>
    21	    If(
    22	      Compare(Name("ch"), CmpOp("==", Str("/"))),
    23	      Assign(Name("part"), BinOp("+", Name("part"), Int(1))) .Stmts,
    24	      If(
    25	        Compare(Name("part"), CmpOp("==", Int(0))),
    26	        Assign(
    27	          Name("a"),
    28	          BinOp(
    29	            "+",
    30	            BinOp(
    31	              "*",
    32	              Name("a"),
    33	              Int(10)),
    34	            BinOp(
    35	              "-",
    36	              Call(Name("ord"), Name("ch"), .Exprs),
    37	              Int(48)))) .Stmts,
    38	        If(
    39	          Compare(Name("part"), CmpOp("==", Int(1))),
    40	          Assign(
    41	            Name("b"),
    42	            BinOp(
    43	              "+",
    44	              BinOp(
    45	                "*",
    46	                Name("b"),
    47	                Int(10)),
    48	              BinOp(
    49	                "-",
    50	                Call(Name("ord"), Name("ch"), .Exprs),
    51	                Int(48)))) .Stmts,
    52	          If(
    53	            Compare(Name("part"), CmpOp("==", Int(2))),
    54	            Assign(
    55	              Name("c"),
    56	              BinOp(
    57	                "+",
    58	                BinOp(
    59	                  "*",
    60	                  Name("c"),
    61	                  Int(10)),
    62	                BinOp(
    63	                  "-",
    64	                  Call(Name("ord"), Name("ch"), .Exprs),
    65	                  Int(48)))) .Stmts,
    66	            Assign(
    67	              Name("d"),
    68	              BinOp(
    69	                "+",
    70	                BinOp(
    71	                  "*",
    72	                  Name("d"),
    73	                  Int(10)),
    74	                BinOp(
    75	                  "-",
    76	                  Call(Name("ord"), Name("ch"), .Exprs),
    77	                  Int(48)))) .Stmts) .Stmts) .Stmts) .Stmts) .Stmts
    78	
    79	  rule simplifyReturn =>
    80	    Return(
    81	      Compare(
    82	        BinOp(
    83	          "%",
    84	          BinOp("*", Name("a"), Name("c")),
    85	          BinOp("*", Name("b"), Name("d"))),
    86	        CmpOp("==", Int(0))))
    87	
    88	  rule simplifyBody =>
    89	    Assign(Name("part"), Int(0))
    90	    Assign(Name("a"), Int(0))
    91	    Assign(Name("b"), Int(0))
    92	    Assign(Name("c"), Int(0))
    93	    Assign(Name("d"), Int(0))
    94	    Assign(Name("ch"), Str(""))
    95	    For(
    96	      Name("ch"),
    97	      BinOp("+", BinOp("+", Name("x"), Str("/")), Name("n")),
    98	      simplifyLoopBody)
    99	    simplifyReturn
