codex
The root cause is now concrete: this sandbox reports namespace PIDs (the shell sees PID 2) while `/proc` exposes a different PID namespace. Lean 4.22 resolves its executable as `/proc/<getpid>/exe`, so both `lean` and Lake’s installation detection fail even though `/proc/self/exe` works. I’m applying a narrow audit-local compatibility shim that redirects only `/proc/<numeric-pid>/exe` readlinks to `/proc/self/exe`; it does not alter Lean sources, the generated project, or proof behavior.
apply patch
patch: completed
/tmp/audit-work/readlink_self.c
diff --git a//tmp/audit-work/readlink_self.c b//tmp/audit-work/readlink_self.c
new file mode 100644
index 0000000000000000000000000000000000000000..a685668c5092174cffd0f268f4b825c0ec9bd2c1
--- /dev/null
+++ b//tmp/audit-work/readlink_self.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    const char *suffix;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    suffix = path == NULL ? NULL : strrchr(path, '/');
+    if (path != NULL
+        && strncmp(path, "/proc/", 6) == 0
+        && suffix != NULL
+        && strcmp(suffix, "/exe") == 0
+        && strcmp(path, "/proc/self/exe") != 0) {
+        path = "/proc/self/exe";
+    }
+    return real_readlink(path, buffer, size);
+}

