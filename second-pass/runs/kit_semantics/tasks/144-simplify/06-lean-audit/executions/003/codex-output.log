      "rationale": "Defines the fresh simplifyLoopBody symbol by expanding it to the exact loop-body AST; this is an equation of a verification-local named proof term.",
      "source_rule_id": "rule-0536ecbc6d3f76e04fef239eb46e11565972c969524a4846e4bfd312991728fc",
      "start_line": 20,
      "text": "  rule simplifyLoopBody =>\n    If(\n      Compare(Name(\"ch\"), CmpOp(\"==\", Str(\"/\"))),\n      Assign(Name(\"part\"), BinOp(\"+\", Name(\"part\"), Int(1))) .Stmts,\n      If(\n        Compare(Name(\"part\"), CmpOp(\"==\", Int(0))),\n        Assign(\n          Name(\"a\"),\n          BinOp(\n            \"+\",\n            BinOp(\n              \"*\",\n              Name(\"a\"),\n              Int(10)),\n            BinOp(\n              \"-\",\n              Call(Name(\"ord\"), Name(\"ch\"), .Exprs),\n              Int(48)))) .Stmts,\n        If(\n          Compare(Name(\"part\"), CmpOp(\"==\", Int(1))),\n          Assign(\n            Name(\"b\"),\n            BinOp(\n              \"+\",\n              BinOp(\n                \"*\",\n                Name(\"b\"),\n                Int(10)),\n              BinOp(\n                \"-\",\n                Call(Name(\"ord\"), Name(\"ch\"), .Exprs),\n                Int(48)))) .Stmts,\n          If(\n            Compare(Name(\"part\"), CmpOp(\"==\", Int(2))),\n            Assign(\n              Name(\"c\"),\n              BinOp(\n                \"+\",\n                BinOp(\n                  \"*\",\n                  Name(\"c\"),\n                  Int(10)),\n                BinOp(\n                  \"-\",\n                  Call(Name(\"ord\"), Name(\"ch\"), .Exprs),\n                  Int(48)))) .Stmts,\n            Assign(\n              Name(\"d\"),\n              BinOp(\n                \"+\",\n                BinOp(\n                  \"*\",\n                  Name(\"d\"),\n                  Int(10)),\n                BinOp(\n                  \"-\",\n                  Call(Name(\"ord\"), Name(\"ch\"), .Exprs),\n                  Int(48)))) .Stmts) .Stmts) .Stmts) .Stmts) .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 86,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "03341577c42ecf18c19a69fb0d413466667f1e67be8d33e40ec997c8089db425",
      "rationale": "Defines the fresh simplifyReturn symbol by expanding it to the exact return AST; this is an equation of a verification-local named proof term.",
      "source_rule_id": "rule-03341577c42ecf18c19a69fb0d413466667f1e67be8d33e40ec997c8089db425",
      "start_line": 79,
      "text": "  rule simplifyReturn =>\n    Return(\n      Compare(\n        BinOp(\n          \"%\",\n          BinOp(\"*\", Name(\"a\"), Name(\"c\")),\n          BinOp(\"*\", Name(\"b\"), Name(\"d\"))),\n        CmpOp(\"==\", Int(0))))"
