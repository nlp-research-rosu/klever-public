+import Proof
+
+private def codes : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | code :: rest =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» code (codes rest)
+
+private def valid :=
+  Proof.«validScan(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
+
+private def result :=
+  Proof.«scanResult(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
+
+-- Boundary and non-digit probes for the operational isDigitC hook.
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 47
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 48
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 57
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 58
+
+-- Valid complete scans: 1/2 * 3/4 is not integral; 1/5 * 5/1 is integral.
+#eval valid (codes [49, 47, 50, 47, 51, 47, 52]) 0 0 0 0 0
+#eval result (codes [49, 47, 50, 47, 51, 47, 52]) 0 0 0 0 0
+#eval valid (codes [49, 47, 53, 47, 53, 47, 49]) 0 0 0 0 0
+#eval result (codes [49, 47, 53, 47, 53, 47, 49]) 0 0 0 0 0
+
+-- Adversarial malformed inputs and phase/boundary mutations.
+#eval valid (codes [49, 48, 50, 47, 51, 47, 52]) 0 0 0 0 0
+#eval valid (codes [49, 47, 65, 47, 51, 47, 52]) 0 0 0 0 0
+#eval valid (codes [47, 50, 47, 51, 47, 52]) 0 0 0 0 0
+#eval valid (codes [49, 47, 50, 47, 51, 47]) 0 0 0 0 0
+#eval valid (codes [49, 47, 50, 47, 51, 47, 52, 47]) 0 0 0 0 0
+#eval valid (codes [49, 47, 50, 47, 51, 47, 52]) 4 0 0 0 0
+
+-- Counterfactual convenience definitions are observably different.
+private def constantDigit (_ : SortInt) : SortBool := true
+private def constantValid (_ : SortIntSeq) (_ _ _ _ _ : SortInt) : SortBool := true
+private def constantTrueResult (_ : SortIntSeq) (_ _ _ _ _ : SortInt) : SortBool := true
+private def constantFalseResult (_ : SortIntSeq) (_ _ _ _ _ : SortInt) : SortBool := false
+
+example : constantDigit 47 ≠ Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 47 := by decide
+example : constantValid (codes [49, 48, 50, 47, 51, 47, 52]) 0 0 0 0 0 ≠
+    valid (codes [49, 48, 50, 47, 51, 47, 52]) 0 0 0 0 0 := by decide
+example : constantTrueResult (codes [49, 47, 50, 47, 51, 47, 52]) 0 0 0 0 0 ≠
+    result (codes [49, 47, 50, 47, 51, 47, 52]) 0 0 0 0 0 := by decide
+example : constantFalseResult (codes [49, 47, 53, 47, 53, 47, 49]) 0 0 0 0 0 ≠
+    result (codes [49, 47, 53, 47, 53, 47, 49]) 0 0 0 0 0 := by decide
