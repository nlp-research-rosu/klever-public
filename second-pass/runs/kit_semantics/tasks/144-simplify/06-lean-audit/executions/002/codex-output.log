Module(
  FuncDef("simplify", Params("x", "n"),
    Assign(Name("part"), Int(0))
    Assign(Name("a"), Int(0))
    Assign(Name("b"), Int(0))
    Assign(Name("c"), Int(0))
    Assign(Name("d"), Int(0))
    Assign(Name("ch"), Str(""))
