+
+def codes : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | x :: xs => SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (codes xs)
+
+def scopeMapSize : SortScope → Nat
+  | SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent» m _ => m.coll.length
+
+-- Character-class boundary and counterexamples.
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 47
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 48
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 57
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 58
+
+-- Source-program examples, represented as the scan of x ++ "/" ++ n.
+#eval Proof.«validScan(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
+  (codes [49, 47, 53, 47, 53, 47, 49]) 0 0 0 0 0
+#eval Proof.«scanResult(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
+  (codes [49, 47, 53, 47, 53, 47, 49]) 0 0 0 0 0
+#eval Proof.«scanResult(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
+  (codes [49, 47, 54, 47, 50, 47, 49]) 0 0 0 0 0
+
+-- Frozen simplifyScope contains exactly x,n,part,a,b,c,d,ch.
+#eval scopeMapSize
+  (Proof.«simplifyScope(_,_,_,_,_,_,_,_)_VERIFICATION-SYNTAX_Scope_Val_Val_Int_Int_Int_Int_Int_Val»
+    SortVal.«noneV_MPY-CORE_Val» SortVal.«noneV_MPY-CORE_Val» 0 0 0 0 0
+    SortVal.«noneV_MPY-CORE_Val»)
+
+-- A raw-list implementation of K map concatenation is order-sensitive. K's
+-- builtin Map composition is associative-commutative, so this counterexample
+-- records the representation gap on unrestricted parameter inputs.
+def e0 := Proof.«_|->_» (SortKItem.inj_SortInt 0) (SortKItem.inj_SortInt 10)
+def e1 := Proof.«_|->_» (SortKItem.inj_SortInt 1) (SortKItem.inj_SortInt 11)
