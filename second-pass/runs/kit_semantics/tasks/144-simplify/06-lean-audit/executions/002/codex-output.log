diff --git a//tmp/audit-work/reconcile_axioms.py b//tmp/audit-work/reconcile_axioms.py
new file mode 100644
index 0000000000000000000000000000000000000000..6c2f79850b7fa09042ffa3ffd4aa9310085e0d06
--- /dev/null
+++ b//tmp/audit-work/reconcile_axioms.py
@@ -0,0 +1,51 @@
+import json
+import re
+from pathlib import Path
+
+raw_path = Path("/audit-output/evidence/25-print-axioms-Proof-final.txt")
+trust_path = Path("/reference/klean-generation/trust-inventory.json")
+
+raw = raw_path.read_text()
+payload = raw.split("depends on axioms: [", 1)[1].split("]\n", 1)[0]
+names = re.findall(
+    r"«[^»]+»|[A-Za-z_][A-Za-z0-9_?.]*(?:\.[A-Za-z_][A-Za-z0-9_?.]*)*",
+    payload,
+)
+trust = json.loads(trust_path.read_text())
+allowlist = {entry["name"]: entry for entry in trust["allowlist"]}
+core = {"propext", "Classical.choice", "Quot.sound"}
+
+recorded = [name for name in names if name in allowlist]
+core_used = [name for name in names if name in core]
+unrecorded = [name for name in names if name not in allowlist and name not in core]
+
+print("COMMAND: independent parsing of exact #print axioms Proof.final output")
+print(f"raw_output={raw_path}")
+print(f"trust_inventory={trust_path}")
+print(f"parsed_dependency_count={len(names)}")
+print(f"recorded_generated_count={len(recorded)}")
+print(f"lean_core_count={len(core_used)}")
+print(f"unrecorded_count={len(unrecorded)}")
+print(f"sorryAx_present={'sorryAx' in names}")
+print("dependencies:")
+for name in names:
+    if name in allowlist:
+        entry = allowlist[name]
+        print(
+            f"  RECORDED {name} | {entry['source']}:{entry['line']} | "
+            f"{entry['type']} | {entry['reason']}"
+        )
+    elif name in core:
+        print(f"  LEAN_CORE {name}")
+    else:
+        print(f"  UNRECORDED {name}")
+
+choice = allowlist["SetHookDef.choiceAx"]
+print("choiceAx_accounting:")
+print(json.dumps(choice, sort_keys=True))
+print("structural_ledger_reconciliation=" + ("PASS" if not unrecorded and "sorryAx" not in names else "FAIL"))
+print(
+    "semantic_trust_judgment=FAIL: the recorded declaration has polymorphic type "
+    "List T -> T; at T=Empty and [] it supplies Empty, so the candidate uses an "
+    "inconsistent generated axiom as ex-falso rather than proving either target conjunct."
+)
diff --git a//tmp/audit-work/stage5-audit-001/Adversarial.lean b//tmp/audit-work/stage5-audit-001/Adversarial.lean
new file mode 100644
index 0000000000000000000000000000000000000000..da378e036d45b445bf343ad7d88b4d8e34b0ff76
--- /dev/null
+++ b//tmp/audit-work/stage5-audit-001/Adversarial.lean
@@ -0,0 +1,41 @@
+import Proof
+
+namespace Adversarial
+
+-- The exact proof escape used by Proof.final derives a direct contradiction.
+theorem contradiction : False := by
+  exact Empty.elim (SetHookDef.choiceAx Empty [])
+
+theorem zero_eq_one : (0 : Nat) = 1 := by
+  exact Empty.elim (SetHookDef.choiceAx Empty [])
+
+-- Counterfactual mutation test: the same term establishes the fixed generated
+-- target for arbitrary values of every one of its sixteen parameters. Thus no
+-- candidate bridge definition, and neither generated rewrite obligation, is
+-- inspected by the proof.
+theorem target_for_arbitrary_parameters
+    (p01 : SortList)
+    (p02 : SortMap)
+    (p03 : SortMap → SortMap → SortMap)
+    (p04 : SortBool → SortBool → SortBool)
+    (p05 : SortInt → SortInt → SortBool)
+    (p06 : SortInt → SortInt → SortBool)
+    (p07 : SortK → SortK → SortBool)
+    (p08 : SortKItem → SortKItem → SortMap)
+    (p09 : SortKItem → SortList)
+    (p10 : SortScope)
+    (p11 : SortInt → SortBool)
+    (p12 : SortIntSeq → SortInt → SortInt → SortInt → SortInt → SortInt → SortBool)
+    (p13 : SortStmts)
+    (p14 : SortStmt)
+    (p15 : SortVal → SortVal → SortInt → SortInt → SortInt → SortInt → SortInt → SortVal → SortScope)
+    (p16 : SortIntSeq → SortInt → SortInt → SortInt → SortInt → SortInt → SortBool) :
+    Klean144Simplify.Lemmas.targetStatement
+      p01 p02 p03 p04 p05 p06 p07 p08 p09 p10 p11 p12 p13 p14 p15 p16 := by
+  exact Empty.elim (SetHookDef.choiceAx Empty [])
+
+#print axioms Adversarial.contradiction
+#print axioms Adversarial.zero_eq_one
+#print axioms Adversarial.target_for_arbitrary_parameters
+
+end Adversarial
diff --git a//tmp/audit-work/stage5-audit-001/OperationalProbes.lean b//tmp/audit-work/stage5-audit-001/OperationalProbes.lean
new file mode 100644
index 0000000000000000000000000000000000000000..a809004940756f891e932fc7b9996456dc3dc253
--- /dev/null
+++ b//tmp/audit-work/stage5-audit-001/OperationalProbes.lean
@@ -0,0 +1,43 @@
+import Proof
+
+namespace OperationalProbes
+
+def codes : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | x :: xs => SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (codes xs)
+
+def scopeMapSize : SortScope → Nat
+  | SortScope.«scope(_,_)_MPY-CORE_Scope_Map_Parent» m _ => m.coll.length
+
+-- Character-class boundary and counterexamples.
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 47
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 48
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 57
+#eval Proof.«isDigitC(_)_MPY-METHODS_Bool_Int» 58
+
+-- Source-program examples, represented as the scan of x ++ "/" ++ n.
+#eval Proof.«validScan(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
+  (codes [49, 47, 53, 47, 53, 47, 49]) 0 0 0 0 0
+#eval Proof.«scanResult(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
+  (codes [49, 47, 53, 47, 53, 47, 49]) 0 0 0 0 0
+#eval Proof.«scanResult(_,_,_,_,_,_)_VERIFICATION-SYNTAX_Bool_IntSeq_Int_Int_Int_Int_Int»
+  (codes [49, 47, 54, 47, 50, 47, 49]) 0 0 0 0 0
+
+-- Frozen simplifyScope contains exactly x,n,part,a,b,c,d,ch.
+#eval scopeMapSize
+  (Proof.«simplifyScope(_,_,_,_,_,_,_,_)_VERIFICATION-SYNTAX_Scope_Val_Val_Int_Int_Int_Int_Int_Val»
+    SortVal.«noneV_MPY-CORE_Val» SortVal.«noneV_MPY-CORE_Val» 0 0 0 0 0
+    SortVal.«noneV_MPY-CORE_Val»)
+
+-- A raw-list implementation of K map concatenation is order-sensitive. K's
+-- builtin Map composition is associative-commutative, so this counterexample
+-- records the representation gap on unrestricted parameter inputs.
+def e0 := Proof.«_|->_» (SortKItem.inj_SortInt 0) (SortKItem.inj_SortInt 10)
+def e1 := Proof.«_|->_» (SortKItem.inj_SortInt 1) (SortKItem.inj_SortInt 11)
+def firstIntKey : SortMap → Option Int
+  | ⟨(SortKItem.inj_SortInt key, _) :: _⟩ => some key
+  | _ => none
+#eval firstIntKey (Proof._Map_ e0 e1)
+#eval firstIntKey (Proof._Map_ e1 e0)
+
+end OperationalProbes
