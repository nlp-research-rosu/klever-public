    86	// while: sorted-key stuck and comprehension asserted wrong under krun).
    87	module MPY-KRUN
    88	  imports MPY
    89	  imports MPY-CONCRETE
    90	endmodule
     1	// reference/src/semantics/core.k — MPY-CORE
     2	
     3	module MPY-CORE
     4	  imports MPY-SYNTAX
     5	  imports INT
     6	  imports BOOL
     7	  imports STRING
     8	  imports MAP
     9	  imports LIST
    10	  imports K-EQUAL
    11	
    12	  // ==== values, the algebraic lists, and the scope heap =====================
    13	  syntax IntSeq ::= ".IntSeq" | iCons(Int, IntSeq)
    14	  syntax ValSeq ::= ".ValSeq" | vCons(Val, ValSeq)
    15	  syntax Str    ::= str(IntSeq)
    16	
    17	  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)
    18	  syntax Iterable ::= list(ValSeq)
    19	                    | tuple(ValSeq)
    20	                    | Str
    21	                    | rangeObj(Int, Int, Int)
    22	                    | zipObj(ValSeq, ValSeq)
    23	                    | zipObjS(IntSeq, IntSeq)
    24	
    25	  syntax Val      ::= Int
    26	                    | Bool
    27	                    | "noneV"
    28	                    | Iterable
    29	                    | ref(Int)          // a heap object: <heap> holds its list(VS)
    30	                    | cellRef(Int)      // a closure cell: <heap> holds cellV(V)
    31	                    | closureVal(ParamNames, Stmts, Int)
    32	                    | typeV(String)     // a type object (int/str), resolved from the builtins frame
    33	                    | builtinV(String)  // a builtin function, resolved like any name (LEGB fallthrough)
    34	                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method
    35	
    36	  syntax Parent   ::= "root" | parent(Int)
    37	  syntax Scope    ::= scope(Map, Parent)
    38	  syntax KResult  ::= Val
    39	  syntax Expr     ::= Val   // cooling puts results back into expression holes
    40	  syntax Vals     ::= List{Val, ","}
    41	  syntax Exc      ::= "NoExc" | "AssertionError"
    42	  syntax RetState ::= "noRet" | retV(Val)
    43	
    44	  // ==== configuration =======================================================
    45	  // The builtins namespace is a real scope at reserved location -1 (the bottom of every
    46	  // chain; scopeLoc only allocates >=1, so -1 never collides). The module scope (loc 0)
    47	  // has it as parent, so an unbound name resolves there last — exactly LEGB. `int`/`str`
    48	  // resolve to their type objects; any local/global binding shadows them via normal lookup.
    49	  configuration
    50	    <k>       #loadAll($PGM:Module) </k>
    51	    <env>     0 </env>
    52	    <scopes>   0     |-> scope(.Map, parent(-1))
    53	              -1    |-> builtinsScope </scopes>
    54	    <scopeLoc> 1 </scopeLoc>
    55	    <heap>    .Map </heap>
    56	    <heapLoc> 0 </heapLoc>
    57	    <stack>   .List </stack>
    58	    <ret>     noRet </ret>
    59	    <exc>     NoExc </exc>
    60	    <exit-code exit=""> 0 </exit-code>
    61	
    62	  // ==== heap allocation (constructed lists become objects) ==================
    63	  // Cons-form emission with a freshness guard (the heap-list-probe discipline:
    64	  // an update-form H[N <- _] never re-normalizes symbolically). heapLoc is
    65	  // monotonic — it does NOT wind back at #pop: returned lists escape by ref.
    66	  // A bare list(VS) Val stays legal (read-only inputs in claims flow unboxed);
    67	  // only CONSTRUCTORS in program syntax allocate.
    68	  syntax Bool ::= isRefV(Val) [function, total]
    69	  rule isRefV(ref(_:Int)) => true
    70	  rule isRefV(_:Val)      => false [owise]
    71	
    72	  // closure cells (Python-faithful capture): the heap holds cellV(V); a
    73	  // cellRef surfacing as the k-redex reads through (lookup is the only use —
    74	  // cellRefs never escape to user-visible values)
    75	  syntax HeapVal ::= cellV(Val)
    76	  syntax Bool ::= isCellRef(Val) [function, total]
    77	  rule isCellRef(cellRef(_:Int)) => true
    78	  rule isCellRef(_:Val)          => false [owise]
    79	  // k-top deref for cell-bound reads surfacing INSIDE the annotated frame
    80	  // (AugAssign's in-place read and friends). The "$cells" guard keeps this
    81	  // DECIDABLY inapplicable in plain frames — an unguarded rule lets the
    82	  // prover narrow abstract k-top values into cellRef junk (probed on
    83	  // 26-remove-duplicates). Cross-frame reads (a comprehension closure
    84	  // reading the enclosing function's cellvar) deref inside #look instead.
    85	  rule <k> cellRef(H:Int) => V ... </k>
    86	       <env> L:Int </env>
    87	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    88	       <heap> ... H |-> cellV(V:Val) ... </heap>
    89	       requires "$cells" in_keys(M)
    90	       [priority(40)]
    91	
    92	  // write through a cell (Assign / #bindP / #bindTgt dispatch here on
    93	  // cell-bound names)
    94	  // a keyword argument cools to a TAGGED value (consumed by kw-aware builtins)
    95	  syntax Val ::= kwV(String, Val)
    96	  syntax KItem ::= #kwTag(String)
    97	  rule <k> KwArg(N:String, E:Expr) => E ~> #kwTag(N) ... </k>
    98	  rule <k> V:Val ~> #kwTag(N:String) => kwV(N, V) ... </k>
    99	       requires notBool isKwV(V)
   100	  syntax Bool ::= isKwV(Val) [function, total]
   101	  rule isKwV(kwV(_:String, _:Val)) => true
   102	  rule isKwV(_:Val)                => false [owise]
   103	
   104	  // the frame marker carries the CONCRETE cellvar list, so cell-write dispatch
   105	  // decides by pnMember even over an abstract frame rest (no prover branching)
   106	  syntax Val ::= cellsMark(ParamNames)
   107	  syntax ParamNames ::= cellsOf(Val) [function]
   108	  rule cellsOf(cellsMark(CVS:ParamNames)) => CVS
   109	  syntax Bool ::= pnMember(String, ParamNames) [function, total]
   110	  rule pnMember(_:String, .ParamNames) => false
   111	  rule pnMember(X:String, (P:String, R:ParamNames)) => X ==String P orBool pnMember(X, R)
   112	
   113	  syntax KItem ::= #cellW(Val, Val)
   114	  rule <k> #cellW(cellRef(H:Int), V:Val) => .K ... </k>
   115	       <heap> ... H |-> cellV(_:Val => V) ... </heap>
   116	
   117	  syntax KItem ::= #alloc(Val)
   118	  rule <k> #alloc(V:Val) => ref(N) ... </k>
   119	       <heap>    H:Map => (N |-> V) H </heap>
   120	       <heapLoc> N:Int => N +Int 1 </heapLoc>
   121	       requires notBool N in_keys(H)
   122	
   123	  // ==== module load + statement sequencing ==================================
   124	  syntax KItem ::= #loadAll(Module)
   125	  rule <k> #loadAll(Module(SS:Stmts)) => SS ... </k>
   126	  rule <k> (S:Stmt SS:Stmts):Stmts => S ~> SS ... </k>
   127	  rule <k> .Stmts => .K ... </k>
   128	
   129	  // ==== Name lookup (walk the scope chain; builtins live in the -1 scope) ====
   130	  syntax KItem ::= #look(String, Int)
   131	  rule <k> Name(X:String) => #look(X, L) ... </k> <env> L:Int </env>
   132	  rule <k> #look(X:String, L:Int) => {M[X]}:>Val ... </k>
   133	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   134	       requires X in_keys(M)
   135	  // a SYNTACTICALLY cell-bound name reads through the heap cell AT THE
   136	  // LOOKUP (higher priority beats the plain return above on concrete cell
   137	  // bindings; abstract claim values take the plain rule unchanged) — this
   138	  // covers cross-frame cell reads (a comprehension closure reading the
   139	  // enclosing function's cellvar) without a narrowing-prone k-top redex
   140	  // guarded on the FOUND frame's DECLARED cellvars (pnMember over the
   141	  // cellsMark): decidable for every concrete frame pin — plain frames and
   142	  // non-cell names prune outright, so an abstract looked-up value never
   143	  // drags a narrowing cellV heap match along (probed on 5-intersperse and
   144	  // Q4's abstract `numbers` in the annotated frame)
   145	  rule <k> #look(X:String, L:Int) => V ... </k>
   146	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   147	       <heap> ... H |-> cellV(V:Val) ... </heap>
   148	       requires X in_keys(M) andBool "$cells" in_keys(M)
   149	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
   150	        andBool {M[X]}:>Val ==K cellRef(H)
   151	       [priority(40)]
   152	  rule <k> #look(X:String, L:Int) => #look(X, P) ... </k>
   153	       <scopes> ... L |-> scope(M:Map, parent(P:Int)) ... </scopes>
   154	       requires notBool (X in_keys(M))
   155	
   156	  // the ONE predefined builtins scope (the -1 frame; claims write `-1 |-> builtinsScope`)
   157	  syntax Scope ::= "builtinsScope" [function, total]
   158	  rule builtinsScope
   159	    => scope(.Map [ "len"    <- builtinV("len")    ]
   160	                  [ "set"    <- builtinV("set")    ]
   161	                  [ "sum"    <- builtinV("sum")    ]
   162	                  [ "abs"    <- builtinV("abs")    ]
   163	                  [ "min"    <- builtinV("min")    ]
   164	                  [ "max"    <- builtinV("max")    ]
   165	                  [ "ord"    <- builtinV("ord")    ]
   166	                  [ "chr"    <- builtinV("chr")    ]
   167	                  [ "range"  <- builtinV("range")  ]
   168	                  [ "all"    <- builtinV("all")    ]
   169	                  [ "any"    <- builtinV("any")    ]
   170	                  [ "zip"    <- builtinV("zip")    ]
   171	                  [ "isinstance" <- builtinV("isinstance") ]
   172	                  [ "sorted" <- builtinV("sorted") ]
   173	                  [ "list"   <- builtinV("list")   ]
   174	                  [ "round"  <- builtinV("round")  ]
   175	                  [ "bin"    <- builtinV("bin")    ]
   176	                  [ "enumerate" <- builtinV("enumerate") ]
   177	                  [ "map"    <- builtinV("map")    ]
   178	                  [ "eval"   <- builtinV("eval")   ]
   179	                  [ "int"    <- typeV("int")       ]
   180	                  [ "str"    <- typeV("str")       ]
   181	                  [ "float"  <- typeV("float")     ], root)
   182	
   183	  // ==== argument/element evaluation: ONE left-to-right loop, tagged by destination ==
   184	  // (list/tuple literals and calls all use it; modules extend ApplyK with their tags)
   185	  syntax ApplyK ::= toCall(Val)
   186	  syntax KItem  ::= #evalArgs(Exprs, Vals, ApplyK)
   187	                  | #evalArgCont(Exprs, Vals, ApplyK)
   188	                  | #applyK(ApplyK, Vals)
   189	  rule <k> #evalArgs((A:Expr, REST:Exprs), ACC:Vals, K:ApplyK) => A ~> #evalArgCont(REST, ACC, K) ... </k>
   190	  rule <k> V:Val ~> #evalArgCont(REST:Exprs, ACC:Vals, K:ApplyK) => #evalArgs(REST, appendVal(ACC, V), K) ... </k>
   191	  rule <k> #evalArgs(.Exprs, ACC:Vals, K:ApplyK) => #applyK(K, ACC) ... </k>
   192	
   193	  // ==== Int / Bool / None literals ==========================================
   194	  rule <k> Int(I:Int)   => I ... </k>
   195	  rule <k> Bool(B:Bool) => B ... </k>
   196	  rule <k> NoneVal      => noneV ... </k>
   197	
   198	  // ==== truthy (If, Assert, BoolOp, IfExp, not, While) ======================
   199	  syntax Bool ::= truthy(Val) [function]
   200	  rule truthy(B:Bool)          => B
   201	  rule truthy(noneV)           => false
   202	  rule truthy(I:Int)           => I =/=Int 0
   203	  rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)
   204	  rule truthy(list(V:ValSeq))  => notBool (V ==K .ValSeq)
   205	  rule truthy(tuple(V:ValSeq)) => notBool (V ==K .ValSeq)
   206	
   207	  // ==== extensible operator dispatch (cases added by the construct modules) ==
   208	  syntax Val  ::= applyUn(String, Val) [function]
   209	  syntax Val  ::= applyBin(String, Val, Val) [function]
   210	  syntax Bool ::= applyCmp(String, Val, Val) [function]
   211	
   212	  // ==== shared list helpers =================================================
   213	  syntax Vals ::= appendVal(Vals, Val) [function, total]
   214	  rule appendVal(.Vals, V:Val)              => V , .Vals
   215	  rule appendVal((V0:Val, VS:Vals), V:Val)  => V0 , appendVal(VS, V)
   216	
   217	  syntax ValSeq ::= vals2valSeq(Vals) [function, total]
   218	  rule vals2valSeq(.Vals)            => .ValSeq
   219	  rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))
   220	
   221	  // ==== shared sequence length (len / summaries across many modules) ========
   222	  // (positional access valSeqAt/intSeqAt + normIdx live in subscript.k)
   223	  syntax Int ::= vsLen(ValSeq) [function, total]
   224	  rule vsLen(.ValSeq)                => 0
   225	  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
   226	
   227	  syntax Int ::= isLen(IntSeq) [function, total]
   228	  rule isLen(.IntSeq)                => 0
   229	  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
   230	
   231	  // in-bounds positional write (list subscript-assign); OOB leaves the seq unchanged
   232	  // (valid programs write in-bounds — mirrors valSeqAt's total-but-underspecified stance)
   233	  syntax ValSeq ::= setVSAt(ValSeq, Int, Val) [function, total]
   234	  rule setVSAt(.ValSeq, _:Int, _:Val)               => .ValSeq
   235	  rule setVSAt(vCons(_:Val, S:ValSeq), 0, V:Val)    => vCons(V, S)
   236	  rule setVSAt(vCons(W:Val, S:ValSeq), I:Int, V:Val) => vCons(W, setVSAt(S, I -Int 1, V))
   237	       requires I >Int 0
   238	  rule setVSAt(VS:ValSeq, I:Int, _:Val)             => VS
   239	       requires I <Int 0
   240	endmodule
     1	// reference/src/semantics/str.k — MPY-STR
     2	
     3	module MPY-STR
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	
     7	  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
     8	  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
     9	  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
    10	        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
    11	
    12	  // ==== str literal (ASCII-only) ============================================
    13	  syntax IntSeq ::= strToCodes(String) [function]
    14	  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
    15	  rule strToCodes("") => .IntSeq
    16	  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    17	    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
    18	
    19	  // ==== operators: + / == / != / in =========================================
    20	  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
    21	  rule seqConcat(.IntSeq, T:IntSeq)                => T
    22	  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
    23	
    24	  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
    26	  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
    27	
    28	  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
    29	  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
    30	  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
    31	
    32	  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
    33	  rule strPrefix(.IntSeq, _:IntSeq)               => true
    34	  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
    35	  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
    36	
    37	  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
    38	  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
    39	  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
    40	  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
    41	       requires notBool strPrefix(P, iCons(C, Xs))
    42	
    43	  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
    44	  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
    45	  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
    46	  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
    47	  // str </<=/>/>= comparisons.
    48	  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
    49	  rule strLt(.IntSeq, .IntSeq)                => false
    50	  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
    51	  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
    52	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
    53	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
    54	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
    55	
    56	  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    57	  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
    58	  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
    59	  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
    60	endmodule

diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..14f0557a56d7eb7f82be8210930b78875242da0e
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,12 @@
+def fruit_distribution(s, n):
+    return n - int(s.split()[0]) - int(s.split()[3])
+
+
+assert fruit_distribution("5 apples and 6 oranges", 19) == 8
+assert fruit_distribution("0 apples and 1 oranges", 3) == 2
+assert fruit_distribution("2 apples and 3 oranges", 100) == 95
+assert fruit_distribution("100 apples and 1 oranges", 120) == 19
+assert fruit_distribution("0 apples and 0 oranges", 0) == 0
+assert fruit_distribution("7 apples and 8 oranges", 15) == 0
+assert fruit_distribution("  7   apples\tand  8 oranges\n", 20) == 5
+assert fruit_distribution("999999 apples and 1 oranges", 1000000) == 0
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..fbb2a84c7a2152f823b461fdab452ebef863422a
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Independent CPython differential: trusted canonical versus generated entry point."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+from typing import Any, Callable
+
+
+def load_entry(path: Path, module_name: str) -> Callable[[str, int], int]:
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.fruit_distribution
+
+
+canonical = load_entry(Path("/reference/canonical.py"), "trusted_canonical")
+generated = load_entry(Path("/candidate/solution.py"), "generated_solution")
+
+cases: list[tuple[str, int, str, str]] = [
+    ("5 apples and 6 oranges", 19, "prompt-example", "in"),
+    ("0 apples and 1 oranges", 3, "prompt-example", "in"),
+    ("2 apples and 3 oranges", 100, "prompt-example", "in"),
+    ("100 apples and 1 oranges", 120, "prompt-example", "in"),
+    ("0 apples and 0 oranges", 0, "zero-and-equality-boundary", "in"),
+    ("1 apples and 0 oranges", 1, "zero-orange-boundary", "in"),
+    ("0 apples and 1 oranges", 1, "zero-apple-boundary", "in"),
+    ("999999999999999999999999 apples and 1 oranges", 10**24, "unbounded-int-boundary", "in"),
+    ("  7   apples\tand  8 oranges\n", 20, "whitespace-boundary", "in"),
+    ("٠ apples and ١ oranges", 3, "unicode-decimal-digit", "in"),
+    ("", 5, "empty-string-probe", "out"),
+    ("5 apples and oranges", 10, "missing-number-probe", "out"),
+    ("There are 5 apples and 6 oranges", 20, "free-prose-probe", "out"),
+    ("-1 apples and 2 oranges", 5, "negative-count-probe", "out"),
+    ("5 apples and 6 oranges and 2 pears", 20, "extra-number-probe", "out"),
+    ("5 apples and 6 oranges", 3, "inconsistent-total-probe", "out"),
+]
+
+for apples in [0, 1, 9, 10, 99, 100, 10**6]:
+    for oranges in [0, 1, 9, 10, 99, 100, 10**6]:
+        for mangoes in [0, 1, 17]:
+            cases.append(
+                (
+                    f"{apples} apples and {oranges} oranges",
+                    apples + oranges + mangoes,
+                    "generated-valid-grid",
+                    "in",
+                )
+            )
+
+
+def outcome(function: Callable[[str, int], int], text: str, total: int) -> tuple[str, Any]:
+    try:
+        return ("value", function(text, total))
+    except Exception as error:  # Deliberately compare exception classes for probes.
+        return ("exception", type(error).__name__)
+
+
+in_domain_mismatches = 0
+out_domain_divergences = 0
+for index, (text, total, label, domain) in enumerate(cases):
+    trusted = outcome(canonical, text, total)
+    submitted = outcome(generated, text, total)
+    same = trusted == submitted
+    if domain == "in" and not same:
+        in_domain_mismatches += 1
+    if domain == "out" and not same:
+        out_domain_divergences += 1
+    if label != "generated-valid-grid" or not same:
+        print(
+            f"case={index} domain={domain} label={label} "
+            f"text={text!r} total={total} canonical={trusted!r} "
+            f"generated={submitted!r} same={same}"
+        )
+
+print(
+    f"cases={len(cases)} in_domain_mismatches={in_domain_mismatches} "
+    f"out_domain_divergences={out_domain_divergences}"
+)
+raise SystemExit(1 if in_domain_mismatches else 0)
diff --git a/evidence/stage1_integrity.py b/evidence/stage1_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..65325a594addc9da05ef3722ca7204e27e735e3c
--- /dev/null
+++ b/evidence/stage1_integrity.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+"""Independent provenance and mounted-input integrity checks for this audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+from pathlib import Path
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def pipeline_tree_digest(root: Path) -> str:
+    """Reimplementation of the pipeline-v3 length-delimited tree digest."""
+    root_stat = root.lstat()
+    if not stat.S_ISDIR(root_stat.st_mode):
+        raise AssertionError(f"tree root is not a real directory: {root}")
+    digest = hashlib.sha256()
+    pending = [root]
+    entries: list[tuple[str, str, Path]] = []
+    while pending:
+        directory = pending.pop()
+        for child in os.scandir(directory):
+            path = Path(child.path)
+            mode = child.stat(follow_symlinks=False).st_mode
+            relative = path.relative_to(root).as_posix()
+            if stat.S_ISDIR(mode):
+                entries.append((relative, "directory", path))
+                pending.append(path)
+            elif stat.S_ISREG(mode):
+                entries.append((relative, "file", path))
+            else:
+                raise AssertionError(f"linked or unsupported tree entry: {path}")
+    for relative, kind, path in sorted(entries):
+        encoded = relative.encode()
+        digest.update(len(encoded).to_bytes(4, "big"))
+        digest.update(encoded)
+        digest.update(kind.encode() + b"\0")
+        if kind == "file":
+            size = path.stat(follow_symlinks=False).st_size
+            digest.update(size.to_bytes(8, "big"))
+            with path.open("rb") as stream:
+                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                    digest.update(chunk)
+    return digest.hexdigest()
+
+
+def require_regular(path: Path) -> None:
+    mode = path.lstat().st_mode
+    if not stat.S_ISREG(mode):
+        raise AssertionError(f"required regular file is missing/mistyped/symlinked: {path}")
+    with path.open("rb") as stream:
+        stream.read(1)
+
+
+def require_real_directory(path: Path) -> None:
+    if not stat.S_ISDIR(path.lstat().st_mode):
+        raise AssertionError(f"required real directory is missing/mistyped/symlinked: {path}")
+    list(path.iterdir())
+
+
+def tree_entries(root: Path) -> dict[str, tuple[str, str | None]]:
+    result: dict[str, tuple[str, str | None]] = {}
+    pending = [root]
+    while pending:
+        directory = pending.pop()
+        for entry in os.scandir(directory):
+            path = Path(entry.path)
+            relative = path.relative_to(root).as_posix()
+            mode = entry.stat(follow_symlinks=False).st_mode
+            if stat.S_ISDIR(mode):
+                result[relative] = ("directory", None)
+                pending.append(path)
+            elif stat.S_ISREG(mode):
+                result[relative] = ("file", sha256_file(path))
+            else:
+                result[relative] = ("unsupported", None)
+    return result
+
+
+audit = json.loads(AUDIT_INPUT.read_text())
+assert audit["record_layout"] == "pipeline-v3"
+assert audit["semantics_mode"] == "SUPPLIED_SEMANTICS"
+paths = {name: Path(value) for name, value in audit["container_paths"].items()}
+
+required_regular = [
+    AUDIT_INPUT,
+    paths["audit_campaign_lock"],
+    paths["canonical"],
+    paths["translator"],
+    paths["trusted_prompt"],
+    paths["run_manifest"],
+    paths["task_manifest"],
+    paths["stage1_result"],
+    paths["generation_manifest"],
+    paths["generation_metrics"],
+    Path("/generation-evidence/runtime-metrics.json"),
+    Path("/generation-evidence/usage.json"),
+    paths["generation_last"],
+    paths["generation_output"],
+    Path("/generation-evidence/prompt.txt"),
+]
+for required in required_regular:
+    require_regular(required)
+for required in [
+    paths["candidate"],
+    paths["generation_root"],
+    paths["generation_trace"],
+    Path("/reference/reference-semantics"),
+    Path("/candidate/reference-semantics"),
+]:
+    require_real_directory(required)
+
+lock = json.loads(paths["audit_campaign_lock"].read_text())
+assert lock == audit["audit_campaign"], "campaign lock differs from audit campaign block"
+
+hash_checks = {
+    paths["audit_campaign_lock"]: "audit_campaign_lock_sha256",
+    paths["canonical"]: "canonical_sha256",
+    paths["translator"]: "trusted_translator_sha256",
+    paths["trusted_prompt"]: "trusted_prompt_sha256",
+    paths["run_manifest"]: "run_manifest_sha256",
+    paths["task_manifest"]: "task_manifest_sha256",
+    paths["stage1_result"]: "stage1_result_sha256",
+    paths["generation_manifest"]: "stage1_invocation_sha256",
+    paths["generation_metrics"]: "generation_metrics_sha256",
+    Path("/generation-evidence/runtime-metrics.json"): "generation_runtime_metrics_sha256",
+    Path("/generation-evidence/usage.json"): "generation_usage_sha256",
+    paths["generation_last"]: "generation_codex_last_sha256",
+    paths["generation_output"]: "generation_codex_output_sha256",
+    Path("/generation-evidence/prompt.txt"): "generation_prompt_sha256",
+    Path("/candidate/prompt.py"): "candidate_prompt_sha256",
+    Path("/candidate/py2mpy.py"): "candidate_translator_sha256",
+}
+for path, key in hash_checks.items():
+    actual = sha256_file(path)
+    expected = audit["hashes"][key]
+    assert actual == expected, f"{key}: {actual} != {expected}"
+    print(f"FILE_HASH_OK {key} {actual} {path}")
+
+assert Path("/candidate/prompt.py").read_bytes() == paths["trusted_prompt"].read_bytes()
+assert Path("/candidate/py2mpy.py").read_bytes() == paths["translator"].read_bytes()
+trusted_semantics = tree_entries(Path("/reference/reference-semantics"))
+candidate_semantics = tree_entries(Path("/candidate/reference-semantics"))
+assert candidate_semantics == trusted_semantics
+assert all(kind in {"file", "directory"} for kind, _ in trusted_semantics.values())
+print(f"SEMANTICS_RECURSIVE_IDENTITY_OK entries={len(trusted_semantics)}")
+
+run = json.loads(paths["run_manifest"].read_text())
+task = json.loads(paths["task_manifest"].read_text())
+result = json.loads(paths["stage1_result"].read_text())
+invocation = json.loads(paths["generation_manifest"].read_text())
+usage = json.loads(Path("/generation-evidence/usage.json").read_text())
+assert run["condition"]["name"] == audit["condition"]
+for key, value in task.items():
+    assert audit["manifest"][key] == value
+assert audit["manifest"]["config"] == audit["config"]
+assert result["invocation"] == invocation["name"]
+assert result["outputs"] == invocation["outputs"]
+
+candidate_digest = pipeline_tree_digest(paths["candidate"])
+trusted_semantics_digest = pipeline_tree_digest(Path("/reference/reference-semantics"))
+candidate_semantics_digest = pipeline_tree_digest(Path("/candidate/reference-semantics"))
+trace_digest = pipeline_tree_digest(paths["generation_trace"])
+assert candidate_digest == result["outputs"]["workspace_sha256"]
+assert candidate_digest == invocation["outputs"]["workspace_sha256"]
+assert trusted_semantics_digest == task["inputs"]["reference_semantics_sha256"]
+assert candidate_semantics_digest == trusted_semantics_digest
+assert trace_digest == usage["source_trace_sha256"]
+print(f"PIPELINE_TREE_HASH_OK candidate {candidate_digest}")
+print(f"PIPELINE_TREE_HASH_OK trusted_semantics {trusted_semantics_digest}")
+print(f"PIPELINE_TREE_HASH_OK candidate_semantics {candidate_semantics_digest}")
+print(f"PIPELINE_TREE_HASH_OK generation_trace {trace_digest}")
+
+trace_outputs = {
+    key: value
+    for key, value in result["outputs"]["evidence"].items()
+    if key.startswith("codex-trace/")
+}
+actual_trace_files = sorted(paths["generation_trace"].rglob("*"))
+actual_trace_files = [path for path in actual_trace_files if path.is_file()]
+assert len(trace_outputs) == len(actual_trace_files)
+for path in actual_trace_files:
+    relative = path.relative_to(paths["generation_root"]).as_posix()
+    assert relative in trace_outputs
+    actual = sha256_file(path)
+    assert actual == trace_outputs[relative]
+    print(f"TRACE_FILE_HASH_OK {actual} {relative}")
+
+candidate_entries = tree_entries(paths["candidate"])
+unsupported = [path for path, (kind, _) in candidate_entries.items() if kind == "unsupported"]
+assert not unsupported, f"candidate contains symlink/special entries: {unsupported}"
+for name in [
+    "solution.py",
+    "solution.mpy",
+    "verification.k",
+    "spec.k",
+    "prove.sh",
+    "PROOF.md",
+]:
+    assert candidate_entries.get(name, (None,))[0] == "file", f"missing proof artifact: {name}"
+print(f"CANDIDATE_ENTRY_TYPES_OK entries={len(candidate_entries)}")
+print("STAGE1_INTEGRITY=PASS")
