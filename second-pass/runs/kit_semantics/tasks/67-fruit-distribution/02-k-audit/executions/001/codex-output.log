+requires "verification.k"
+
+module BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // Ground witness with a materially changed executed body: add oranges.
+  claim [wrong-executed-body]:
+    <k>
+      Call(
+        closureVal(
+          ("s", "n"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "-",
+                Name("n"),
+                Call(
+                  Name("int"),
+                  Subscript(
+                    Call(Attribute(Name("s"), "split"), .Exprs),
+                    Int(0)),
+                  .Exprs)),
+              Call(
+                Name("int"),
+                Subscript(
+                  Call(Attribute(Name("s"), "split"), .Exprs),
+                  Int(3)),
+                .Exprs)))
+          .Stmts,
+          0),
+        str(strToCodes("5 apples and 6 oranges")),
+        19)
+      => 8
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..14f0557a56d7eb7f82be8210930b78875242da0e
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,12 @@
+def fruit_distribution(s, n):
+    return n - int(s.split()[0]) - int(s.split()[3])
+
+
+assert fruit_distribution("5 apples and 6 oranges", 19) == 8
+assert fruit_distribution("0 apples and 1 oranges", 3) == 2
+assert fruit_distribution("2 apples and 3 oranges", 100) == 95
+assert fruit_distribution("100 apples and 1 oranges", 120) == 19
+assert fruit_distribution("0 apples and 0 oranges", 0) == 0
+assert fruit_distribution("7 apples and 8 oranges", 15) == 0
+assert fruit_distribution("  7   apples\tand  8 oranges\n", 20) == 5
+assert fruit_distribution("999999 apples and 1 oranges", 1000000) == 0
