+          ("s", "n"),
+          Return(
+            BinOp(
+              "-",
+              BinOp(
+                "-",
+                Name("n"),
+                Call(
+                  Name("int"),
+                  Subscript(
+                    Call(Attribute(Name("s"), "split"), .Exprs),
+                    Int(0)),
+                  .Exprs)),
+              Call(
+                Name("int"),
+                Subscript(
+                  Call(Attribute(Name("s"), "split"), .Exprs),
+                  Int(3)),
+                .Exprs)))
+          .Stmts,
