   257	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   258	    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)
   259	       requires inLevelE(L, O)
   260	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   261	    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))
   262	       requires notBool inLevelE(L, O)
   263	  rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)
   264	    => evp(OO, appendIE(ON, CUR)) [owise]
   265	  syntax Bool ::= inLevelE(String, String) [function, total]
   266	  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
   267	  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
   268	  rule inLevelE(_:String, _:String) => false [owise]
   269	  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
   270	  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
   271	  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))
   272	  syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]
   273	  rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)
   274	  rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))
   275	
   276	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   277	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   278	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   279	  syntax KItem ::= "#md5"
   280	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   281	       [priority(40)]
   282	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   283	  syntax Val ::= md5Obj(IntSeq)
   284	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   285	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   286	
   287	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   288	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   289	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   290	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   291	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   292	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   293	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   294	  rule isIntV(_:Int)         => true
   295	  rule isIntV(_:Val)         => false [owise]
   296	  rule isStrV(str(_:IntSeq)) => true
   297	  rule isStrV(_:Val)         => false [owise]
   298	endmodule
     1	// reference/src/semantics/comprehension.k — MPY-COMPREHENSION
     2	
     3	module MPY-COMPREHENSION
     4	  imports MPY-CORE
     5	  imports MPY-OPERATORS
     6	  imports MPY-LIST
     7	  imports MPY-CONTROLS
     8	  imports MPY-FUNCTIONS
     9	
    10	  // A comprehension is pure syntactic sugar
    11	  rule ListComp(ELT:Expr, Gs:CompFors) => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
    12	  rule GenExp(ELT:Expr, Gs:CompFors)   => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
    13	
    14	  syntax Stmts ::= compBody(CompFors, Expr) [macro]
    15	  rule compBody(Gs:CompFors, ELT:Expr)
    16	    => Assign(Name("$acc"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name("$acc"))
    17	
    18	  syntax Stmt ::= compNest(CompFors, Expr) [macro-rec]
    19	  rule compNest(.CompFors, ELT:Expr)
    20	    => Assign(Name("$acc"), BinOp("+", Name("$acc"), ListExpr(ELT)))
    21	  rule compNest((CompFor(T:Expr, ITER:Expr, Fs:Exprs) GRest:CompFors), ELT:Expr)
    22	    => For(T, ITER, If(compGuard(Fs), compNest(GRest, ELT), .Stmts))
    23	
    24	  syntax Expr ::= compGuard(Exprs) [macro]
    25	  rule compGuard(.Exprs)             => Bool(true)
    26	  rule compGuard((F:Expr, Fs:Exprs)) => BoolOp("and", (F, Fs))
    27	endmodule
     1	// reference/src/semantics/controls.k — MPY-CONTROLS
     2	
     3	module MPY-CONTROLS
     4	  imports MPY-CORE
     5	  imports MPY-TUPLE
     6	  imports MPY-ITER
     7	
     8	  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
     9	  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
    10	       <env> L:Int </env>
    11	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
    12	  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
    13	       <env> L:Int </env>
    14	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    15	       requires "$cells" in_keys(M)
    16	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
    17	        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
    18	       [priority(40)]
    19	
    20	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
    21	       <env> L:Int </env>
    22	       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
    23	       requires X in_keys(M)
    24	  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
    25	  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
    26	  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
    27	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
    28	       <env> L:Int </env>
    29	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    30	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    31	       [priority(40)]
    32	
    33	  // ==== import trivia: `from math import floor, ceil` binds the supported
    34	  // names as builtins in the current scope; every other import is a no-op
    35	  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
    36	  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
    37	  syntax KItem ::= #bindImports(ParamNames)
    38	  rule <k> #bindImports(.ParamNames) => .K ... </k>
    39	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    40	       <env> L:Int </env>
    41	       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
    42	       requires N ==String "floor" orBool N ==String "ceil"
    43	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    44	       requires notBool (N ==String "floor" orBool N ==String "ceil")
    45	
    46	  // ==== Expr statement: evaluate for effect, discard the value ===============
    47	  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
    48	  rule <k> Expr(_:Val) => .K ... </k>
    49	
    50	  // ==== If (condition evaluated by strictness) ==============================
    51	  syntax KItem ::= #branch(Bool, Stmts, Stmts)
    52	  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
    53	  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
    54	  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
    55	
    56	  // ==== IfExp: ternary T if C else E ========================================
    57	  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
    58	       requires truthy(V)
    59	  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
    60	       requires notBool truthy(V)
    61	
    62	  // ==== For: one loop, in-cell continuation, over #iterNext =================
    63	  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
    64	  // circularities anchor on #loop and narrowing substitutes the structure)
    65	  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
    66	                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
    67	                 | #loopLbl(K) | "#cont" | "#brk"
    68	
    69	  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
    70	
    71	  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
    72	  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
    73	  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
    74	        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
    75	
    76	  // ==== While ==============================================================
    77	  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
    78	  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
    79	  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
    80	       requires truthy(V)
    81	  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
    82	       requires notBool truthy(V)
    83	
    84	  // ==== loop control (break / continue) =====================================
    85	  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
    86	  rule <k> Continue => #cont ... </k>
    87	  rule <k> Break => #brk ... </k>
    88	  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
    89	  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
    90	  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
    91	  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
    92	
    93	  // ==== heap-object deref at the truthiness/iteration consumers ==============
    94	  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
    95	  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
    96	       <heap> ... H |-> V:Val ... </heap>
    97	       [priority(40)]
    98	  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
    99	       <heap> ... H |-> V:Val ... </heap>
   100	       [priority(40)]
   101	  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
   102	       <heap> ... H |-> V:Val ... </heap>
   103	       [priority(40)]
   104	  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
   105	  // mutating the iterated list inside its own loop is outside the subset)
   106	  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
   107	       <heap> ... H |-> V:Val ... </heap>
   108	       [priority(40)]
   109	endmodule
     1	// reference/src/semantics/concrete.k — MPY-CONCRETE
     2	// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
     3	// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
     4	// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
     5	// backend ([concrete] is not respected on rewrite rules) — probed on
     6	// 26-remove-duplicates, where element compares branched into deepEqVS.
     7	
     8	module MPY-CONCRETE
     9	  imports MPY
    10	
    11	  // deep equality for list compares whose elements are heap objects
    12	  // (list-of-lists): Python == is structural at every depth.
    13	  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
    14	       <heap> HP:Map </heap>
    15	       requires hasRefVS(A) orBool hasRefVS(B)
    16	  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
    17	       <heap> HP:Map </heap>
    18	       requires hasRefVS(A) orBool hasRefVS(B)
    19	
    20	  // ==== keyed sort, concrete leg ============================================
    21	  // Computes each key by a REAL call through the uniform #callee machinery
    22	  // (closures, len, type objects all work), stable-inserts on the key, and
    23	  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
    24	  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
    25	  syntax Val ::= kvP(Val, Val)
    26	  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
    27	                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
    28	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    29	        => #ksort(VS, KV, .ValSeq, false) ... </k>
    30	       [priority(40)]
    31	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    32	        => #ksort(VS, KV, .ValSeq, RB) ... </k>
    33	       [priority(40)]
    34	  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
    35	        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
    36	  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
    37	        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
    38	  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
    39	        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
    40	       requires notBool isKwV(K)
    41	
    42	  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
    43	  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
    44	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    45	    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
    46	       requires kLt(K, K2)
    47	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    48	    => vCons(kvP(K2, V2), insPair(R, K, V))
    49	       requires notBool kLt(K, K2)
    50	
    51	  syntax Bool ::= kLt(Val, Val) [function]
    52	  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
    53	  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
    54	  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    55	
    56	  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
    57	  rule unpairVS(.ValSeq) => .ValSeq
    58	  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
    59	  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
    60	endmodule

diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..14f0557a56d7eb7f82be8210930b78875242da0e
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,12 @@
+def fruit_distribution(s, n):
+    return n - int(s.split()[0]) - int(s.split()[3])
+
+
+assert fruit_distribution("5 apples and 6 oranges", 19) == 8
+assert fruit_distribution("0 apples and 1 oranges", 3) == 2
+assert fruit_distribution("2 apples and 3 oranges", 100) == 95
+assert fruit_distribution("100 apples and 1 oranges", 120) == 19
+assert fruit_distribution("0 apples and 0 oranges", 0) == 0
+assert fruit_distribution("7 apples and 8 oranges", 15) == 0
+assert fruit_distribution("  7   apples\tand  8 oranges\n", 20) == 5
+assert fruit_distribution("999999 apples and 1 oranges", 1000000) == 0
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..fbb2a84c7a2152f823b461fdab452ebef863422a
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Independent CPython differential: trusted canonical versus generated entry point."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+from typing import Any, Callable
+
+
+def load_entry(path: Path, module_name: str) -> Callable[[str, int], int]:
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.fruit_distribution
+
+
+canonical = load_entry(Path("/reference/canonical.py"), "trusted_canonical")
+generated = load_entry(Path("/candidate/solution.py"), "generated_solution")
+
+cases: list[tuple[str, int, str, str]] = [
+    ("5 apples and 6 oranges", 19, "prompt-example", "in"),
+    ("0 apples and 1 oranges", 3, "prompt-example", "in"),
+    ("2 apples and 3 oranges", 100, "prompt-example", "in"),
+    ("100 apples and 1 oranges", 120, "prompt-example", "in"),
+    ("0 apples and 0 oranges", 0, "zero-and-equality-boundary", "in"),
+    ("1 apples and 0 oranges", 1, "zero-orange-boundary", "in"),
+    ("0 apples and 1 oranges", 1, "zero-apple-boundary", "in"),
+    ("999999999999999999999999 apples and 1 oranges", 10**24, "unbounded-int-boundary", "in"),
+    ("  7   apples\tand  8 oranges\n", 20, "whitespace-boundary", "in"),
+    ("٠ apples and ١ oranges", 3, "unicode-decimal-digit", "in"),
+    ("", 5, "empty-string-probe", "out"),
+    ("5 apples and oranges", 10, "missing-number-probe", "out"),
+    ("There are 5 apples and 6 oranges", 20, "free-prose-probe", "out"),
+    ("-1 apples and 2 oranges", 5, "negative-count-probe", "out"),
+    ("5 apples and 6 oranges and 2 pears", 20, "extra-number-probe", "out"),
+    ("5 apples and 6 oranges", 3, "inconsistent-total-probe", "out"),
+]
+
+for apples in [0, 1, 9, 10, 99, 100, 10**6]:
+    for oranges in [0, 1, 9, 10, 99, 100, 10**6]:
+        for mangoes in [0, 1, 17]:
+            cases.append(
+                (
+                    f"{apples} apples and {oranges} oranges",
+                    apples + oranges + mangoes,
+                    "generated-valid-grid",
+                    "in",
+                )
+            )
+
+
+def outcome(function: Callable[[str, int], int], text: str, total: int) -> tuple[str, Any]:
+    try:
+        return ("value", function(text, total))
+    except Exception as error:  # Deliberately compare exception classes for probes.
+        return ("exception", type(error).__name__)
+
+
+in_domain_mismatches = 0
+out_domain_divergences = 0
+for index, (text, total, label, domain) in enumerate(cases):
+    trusted = outcome(canonical, text, total)
+    submitted = outcome(generated, text, total)
+    same = trusted == submitted
+    if domain == "in" and not same:
+        in_domain_mismatches += 1
+    if domain == "out" and not same:
+        out_domain_divergences += 1
+    if label != "generated-valid-grid" or not same:
+        print(
+            f"case={index} domain={domain} label={label} "
+            f"text={text!r} total={total} canonical={trusted!r} "
+            f"generated={submitted!r} same={same}"
+        )
+
+print(
+    f"cases={len(cases)} in_domain_mismatches={in_domain_mismatches} "
+    f"out_domain_divergences={out_domain_divergences}"
+)
+raise SystemExit(1 if in_domain_mismatches else 0)
diff --git a/evidence/ground-witness.k b/evidence/ground-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..9dc5da3607f186ec97b14b1f3b4b90e0a901ede8
--- /dev/null
+++ b/evidence/ground-witness.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [ground-five-six]:
+    <k>
+      Call(
+        closureVal(
+          ("s", "n"),
+          Return(
+            BinOp(
+              "-",
+              BinOp(
+                "-",
+                Name("n"),
+                Call(
+                  Name("int"),
+                  Subscript(
+                    Call(Attribute(Name("s"), "split"), .Exprs),
+                    Int(0)),
+                  .Exprs)),
+              Call(
+                Name("int"),
+                Subscript(
+                  Call(Attribute(Name("s"), "split"), .Exprs),
+                  Int(3)),
+                .Exprs)))
+          .Stmts,
+          0),
+        str(strToCodes("5 apples and 6 oranges")),
+        19)
+      => 8
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/precondition_witness.py b/evidence/precondition_witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8303715128c1ecba9d85b22175804152434c072
--- /dev/null
+++ b/evidence/precondition_witness.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Exhibit and independently evaluate a satisfying ground entry state."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.fruit_distribution
+
+
+text = "5 apples and 6 oranges"
+total = 19
+tokens = text.split()
+apple_codes = tuple(map(ord, tokens[0]))
+orange_codes = tuple(map(ord, tokens[3]))
+apples = int(tokens[0])
+oranges = int(tokens[3])
+conditions = {
+    "split_shape": tokens == ["5", "apples", "and", "6", "oranges"],
+    "apple_nonempty": len(apple_codes) > 0,
+    "orange_nonempty": len(orange_codes) > 0,
+    "apple_ascii_digits": all(48 <= code <= 57 for code in apple_codes),
+    "orange_ascii_digits": all(48 <= code <= 57 for code in orange_codes),
+    "apple_parse": apples == 5,
+    "orange_parse": oranges == 6,
+    "nonnegative_counts": apples >= 0 and oranges >= 0,
+    "consistent_total": total >= apples + oranges,
+}
+assert all(conditions.values())
+expected = total - apples - oranges
+canonical = load(Path("/reference/canonical.py"), "witness_canonical")
+generated = load(Path("/candidate/solution.py"), "witness_generated")
+canonical_result = canonical(text, total)
+generated_result = generated(text, total)
+assert expected == canonical_result == generated_result == 8
+print(f"TEXT={text!r}")
+print(f"CS={tuple(map(ord, text))}")
+print(f"APPLECODES={apple_codes} ORANGECODES={orange_codes}")
+for name, value in conditions.items():
+    print(f"PRECONDITION {name}={value}")
+print(
+    f"POSTCONDITION 19-5-6={expected} "
+    f"canonical={canonical_result} generated={generated_result}"
+)
+print("PRECONDITION_WITNESS=PASS")
