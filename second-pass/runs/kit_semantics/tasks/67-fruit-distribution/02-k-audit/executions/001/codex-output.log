+          Return(
+            BinOp(
+              "-",
+              BinOp(
+                "-",
+                Name("n"),
+                Call(
+                  Name("int"),
+                  Subscript(
+                    Call(Attribute(Name("s"), "split"), .Exprs),
+                    Int(0)),
+                  .Exprs)),
+              Call(
+                Name("int"),
+                Subscript(
+                  Call(Attribute(Name("s"), "split"), .Exprs),
+                  Int(3)),
+                .Exprs)))
+          .Stmts,
+          0),
+        str(strToCodes("5 apples and 6 oranges")),
+        19)
+      => 9
+    </k>
+    <env> 0 </env>
