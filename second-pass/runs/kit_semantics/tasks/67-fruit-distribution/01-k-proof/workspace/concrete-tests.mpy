Module(
  FuncDef("fruit_distribution", Params("s", "n"),
    Return(
      BinOp(
        "-",
        BinOp(
          "-",
          Name("n"),
          Call(
            Name("int"),
            Subscript(Call(Attribute(Name("s"), "split"), ), Int(0)))),
        Call(
          Name("int"),
          Subscript(Call(Attribute(Name("s"), "split"), ), Int(3))))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("5 apples and 6 oranges"),
        Int(19)),
      CmpOp("==", Int(8))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("0 apples and 1 oranges"),
        Int(3)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("2 apples and 3 oranges"),
        Int(100)),
      CmpOp("==", Int(95))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("100 apples and 1 oranges"),
        Int(120)),
      CmpOp("==", Int(19)))))
