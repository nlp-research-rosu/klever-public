diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3f6cb1d1ef926fe0908acb14b93632f2d04e96d0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,62 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [fruit-distribution]:
+    <k>
+      Call(
+        closureVal(
+          ("s", "n"),
+          Return(
+            BinOp(
+              "-",
+              BinOp(
+                "-",
+                Name("n"),
+                Call(
+                  Name("int"),
+                  Subscript(
+                    Call(Attribute(Name("s"), "split"), .Exprs),
+                    Int(0)),
+                  .Exprs)),
+              Call(
+                Name("int"),
+                Subscript(
+                  Call(Attribute(Name("s"), "split"), .Exprs),
+                  Int(3)),
+                .Exprs)))
+          .Stmts,
+          0),
+        str(CS:IntSeq),
+        N:Int)
+      => N -Int APPLES -Int ORANGES
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      splitWS(CS, .IntSeq, .ValSeq)
+        ==K vCons(
+              str(APPLECODES:IntSeq),
+              vCons(
+                str(strToCodes("apples")),
+                vCons(
+                  str(strToCodes("and")),
+                  vCons(
+                    str(ORANGECODES:IntSeq),
+                    vCons(str(strToCodes("oranges")), .ValSeq)))))
+      andBool
+      applyBuiltin("int", str(APPLECODES), .Vals) ==K APPLES:Int
+      andBool
+      applyBuiltin("int", str(ORANGECODES), .Vals) ==K ORANGES:Int
+endmodule
