import json
from pathlib import Path
canonical = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == canonical['inventory_sha256']
source_ids = [r['source_rule_id'] for r in canonical['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == source_ids
assert len(out_ids) == len(set(out_ids))
for entry in out['rules']:
    assert set(entry) == {'source_rule_id', 'classification', 'rationale'}
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
print(f\"schema_keys={list(out)}\")
print(f\"inventory_sha256_match={out['inventory_sha256'] == canonical['inventory_sha256']}\")
print(f\"inventory_rules={len(source_ids)} output_rules={len(out_ids)} order_match={out_ids == source_ids}\")
print(\"classification_counts=\" + str({name: sum(r['classification'] == name for r in out['rules']) for name in sorted(allowed)}))
