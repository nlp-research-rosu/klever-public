Module(
  FuncDef("triangle_area", Params("a", "h"),
    Return(BinOp("/", BinOp("*", Name("a"), Name("h")), Float(2.0))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(5), Int(3)),
      CmpOp("==", Float(7.5))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(0), Int(9)),
      CmpOp("==", Float(0.0))))
  Assert(
    Compare(
      Call(Name("triangle_area"), UnaryOp("-", Int(4)), Int(3)),
      CmpOp("==", UnaryOp("-", Float(6.0)))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Float(2.5), Int(4)),
      CmpOp("==", Float(5.0))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(3), Float(2.5)),
      CmpOp("==", Float(3.75))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Float(2.5), Float(1.5)),
      CmpOp("==", Float(1.875)))))
