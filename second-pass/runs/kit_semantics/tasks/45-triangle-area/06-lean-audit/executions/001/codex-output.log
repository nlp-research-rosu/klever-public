  ✓ Write raw evidence and self-contained REVIEW.md with the final verdict pair
diff --git a//tmp/audit-work/proc_exe_compat.c b//tmp/audit-work/proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..bf361da3c4bfc1a4b6553d6604e66c038ec2b6da
--- /dev/null
+++ b//tmp/audit-work/proc_exe_compat.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_namespaced_proc_exe(const char *path) {
+  const char prefix[] = "/proc/";
+  if (strncmp(path, prefix, sizeof(prefix) - 1) != 0) return 0;
+  path += sizeof(prefix) - 1;
+  if (!isdigit((unsigned char)*path)) return 0;
+  while (isdigit((unsigned char)*path)) path++;
+  return strcmp(path, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*next_readlink)(const char *, char *, size_t) = NULL;
+  if (!next_readlink) next_readlink = dlsym(RTLD_NEXT, "readlink");
+  if (is_namespaced_proc_exe(path)) path = "/proc/self/exe";
+  return next_readlink(path, buf, bufsiz);
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*next_readlinkat)(int, const char *, char *, size_t) = NULL;
+  if (!next_readlinkat) next_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  if (is_namespaced_proc_exe(path)) path = "/proc/self/exe";
+  return next_readlinkat(dirfd, path, buf, bufsiz);
+}
diff --git a//tmp/audit-work/readlink_trace.c b//tmp/audit-work/readlink_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..c61aba472ccefc8453da9375ad3a69f3c4799a66
--- /dev/null
+++ b//tmp/audit-work/readlink_trace.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = real_readlink(path, buf, bufsiz);
+  fprintf(stderr, "TRACE readlink(%s) = %zd\n", path, result);
+  return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t bufsiz) {
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t) = NULL;
+  if (!real_readlinkat) real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  ssize_t result = real_readlinkat(dirfd, path, buf, bufsiz);
+  fprintf(stderr, "TRACE readlinkat(%s) = %zd\n", path, result);
+  return result;
+}
