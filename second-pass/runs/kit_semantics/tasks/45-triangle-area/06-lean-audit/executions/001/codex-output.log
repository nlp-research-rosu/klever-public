+nl -ba /reference/klean-generation/generated/Klean45TriangleArea/Lemmas.lean
+rg -n '(^|[[:space:]])(theorem|lemma|example)[[:space:]]|Proof\.final|def[[:space:]]+target|KleanTarget' \
+  /reference/klean-generation/generated -g '*.lean'
