+assert triangle_area(0, 11) == 0.0
+assert triangle_area(-4, 3) == -6.0
+assert triangle_area(4, -3) == -6.0
+assert triangle_area(2.5, 4) == 5.0
+assert triangle_area(3, 2.5) == 3.75
+assert triangle_area(2.5, 1.5) == 1.875
