     1	from decimal import Decimal
     2	from pathlib import Path
     3	import subprocess
     4	import sys
     5	import tempfile
     6	
     7	from solution import triangle_area
     8	
     9	
    10	ROOT = Path(__file__).resolve().parent
    11	VALUES = (-4, -1.5, 0, 0.5, 2, 3.5, 5)
    12	
    13	
    14	def oracle(a, h):
    15	    # Decimal supplies an implementation independent of Python binary-float
    16	    # multiplication/division and of the K FLOAT hooks.
    17	    return float((Decimal(str(a)) * Decimal(str(h))) / Decimal(2))
    18	
    19	
    20	def main():
    21	    cases = [(a, h, oracle(a, h)) for a in VALUES for h in VALUES]
    22	    mismatches = [
    23	        (a, h, expected, triangle_area(a, h))
    24	        for a, h, expected in cases
    25	        if triangle_area(a, h) != expected
    26	    ]
    27	    if mismatches:
    28	        print(f"python_cases={len(cases)} mismatches={len(mismatches)}")
    29	        for mismatch in mismatches:
    30	            print(mismatch)
    31	        return 1
    32	
    33	    assertions = "\n".join(
    34	        f"assert triangle_area({a!r}, {h!r}) == {expected!r}"
    35	        for a, h, expected in cases
    36	    )
    37	    source = (ROOT / "solution.py").read_text() + "\n\n" + assertions + "\n"
    38	
    39	    with tempfile.TemporaryDirectory(prefix="triangle-area-") as tmp:
    40	        tmp_path = Path(tmp)
    41	        py_path = tmp_path / "differential_smoke.py"
    42	        mpy_path = tmp_path / "differential_smoke.mpy"
    43	        py_path.write_text(source)
    44	
    45	        with mpy_path.open("w") as output:
    46	            translated = subprocess.run(
    47	                [sys.executable, str(ROOT / "py2mpy.py"), str(py_path)],
    48	                stdout=output,
    49	                text=True,
    50	            )
    51	        if translated.returncode != 0:
    52	            return translated.returncode
    53	
    54	        executed = subprocess.run(
    55	            [
    56	                "krun",
    57	                str(mpy_path),
    58	                "--definition",
    59	                str(ROOT / "runtime-kompiled"),
    60	            ],
    61	            capture_output=True,
    62	            text=True,
    63	        )
    64	        if executed.returncode != 0:
    65	            print(executed.stdout)
    66	            print(executed.stderr, file=sys.stderr)
    67	            return executed.returncode
    68	
    69	    print(
    70	        f"python_cases={len(cases)} k_cases={len(cases)} "
    71	        "oracle=Decimal mismatches=0"
    72	    )
    73	    return 0
    74	
    75	
    76	if __name__ == "__main__":
    77	    raise SystemExit(main())
