#!/usr/bin/env bash
set -eu

run_expected_failure() {
  check_name=$1
  shift

  set +e
  "$@"
  check_status=$?
  set -e

  if [ "$check_status" -eq 0 ]; then
    echo "$check_name UNEXPECTED_SUCCESS"
    exit 1
  fi

  echo "$check_name EXPECTED_NONZERO_EXIT=$check_status"
}

