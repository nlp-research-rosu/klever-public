      "text": "  rule\n    <k>\n      #loop(\n        list(intVals(REST:IntSeq)),\n        Name(\"value\"),\n        Assign(Name(\"seen\"), Int(1))\n        Assign(\n          Name(\"total\"),\n          BinOp(\"+\", Name(\"total\"), Call(Name(\"abs\"), Name(\"value\"))))\n        If(\n          Compare(Name(\"value\"), CmpOp(\"<\", Int(0))),\n          Assign(Name(\"sign\"), BinOp(\"-\", Int(0), Name(\"sign\"))),\n          If(\n            Compare(Name(\"value\"), CmpOp(\">\", Int(0))),\n            Assign(Name(\"sign\"), Name(\"sign\")),\n            Assign(Name(\"sign\"), Int(0)))\n          .Stmts)\n        .Stmts)\n      ~> If(\n           Compare(Name(\"seen\"), CmpOp(\"==\", Int(0))),\n           Return(NoneVal) .Stmts,\n           .Stmts)\n         Return(BinOp(\"*\", Name(\"total\"), Name(\"sign\")))\n         .Stmts\n      ~> #endcall\n      => foldResult(REST, TOTAL:Int, SIGN:Int)\n    </k>\n    <env> 1 => 0 </env>\n    <scopes>\n      -1 |-> scope(\n        \"len\" |-> builtinV(\"len\")\n        \"set\" |-> builtinV(\"set\")\n        \"sum\" |-> builtinV(\"sum\")\n        \"abs\" |-> builtinV(\"abs\")\n        \"min\" |-> builtinV(\"min\")\n        \"max\" |-> builtinV(\"max\")\n        \"ord\" |-> builtinV(\"ord\")\n        \"chr\" |-> builtinV(\"chr\")\n        \"range\" |-> builtinV(\"range\")\n        \"all\" |-> builtinV(\"all\")\n        \"any\" |-> builtinV(\"any\")\n        \"zip\" |-> builtinV(\"zip\")\n        \"isinstance\" |-> builtinV(\"isinstance\")\n        \"sorted\" |-> builtinV(\"sorted\")\n        \"list\" |-> builtinV(\"list\")\n        \"round\" |-> builtinV(\"round\")\n        \"bin\" |-> builtinV(\"bin\")\n        \"enumerate\" |-> builtinV(\"enumerate\")\n        \"map\" |-> builtinV(\"map\")\n        \"eval\" |-> builtinV(\"eval\")\n        \"int\" |-> typeV(\"int\")\n        \"str\" |-> typeV(\"str\")\n        \"float\" |-> typeV(\"float\"),\n        root)\n      0 |-> scope(\n        \"prod_signs\" |-> CLOSURE:Val,\n        parent(-1))\n      1 |-> scope(\n        \"arr\" |-> list(intVals(INPUT:IntSeq))\n        \"total\" |-> TOTAL\n        \"sign\" |-> SIGN\n        \"seen\" |-> 1\n        \"value\" |-> OLD:Int,\n        parent(0))\n      =>\n      -1 |-> scope(\n        \"len\" |-> builtinV(\"len\")\n        \"set\" |-> builtinV(\"set\")\n        \"sum\" |-> builtinV(\"sum\")\n        \"abs\" |-> builtinV(\"abs\")\n        \"min\" |-> builtinV(\"min\")\n        \"max\" |-> builtinV(\"max\")\n        \"ord\" |-> builtinV(\"ord\")\n        \"chr\" |-> builtinV(\"chr\")\n        \"range\" |-> builtinV(\"range\")\n        \"all\" |-> builtinV(\"all\")\n        \"any\" |-> builtinV(\"any\")\n        \"zip\" |-> builtinV(\"zip\")\n        \"isinstance\" |-> builtinV(\"isinstance\")\n        \"sorted\" |-> builtinV(\"sorted\")\n        \"list\" |-> builtinV(\"list\")\n        \"round\" |-> builtinV(\"round\")\n        \"bin\" |-> builtinV(\"bin\")\n        \"enumerate\" |-> builtinV(\"enumerate\")\n        \"map\" |-> builtinV(\"map\")\n        \"eval\" |-> builtinV(\"eval\")\n        \"int\" |-> typeV(\"int\")\n        \"str\" |-> typeV(\"str\")\n        \"float\" |-> typeV(\"float\"),\n        root)\n      0 |-> scope(\n        \"prod_signs\" |-> CLOSURE,\n        parent(-1))\n    </scopes>\n    <scopeLoc> 2 => 1 </scopeLoc>\n    <heap> HEAP:Map </heap>\n    <heapLoc> HLOC:Int </heapLoc>\n    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n    <ret> noRet </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    [priority(30)]"
    }
