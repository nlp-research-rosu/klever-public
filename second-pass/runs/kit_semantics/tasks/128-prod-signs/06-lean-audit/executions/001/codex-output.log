cp -a /reference/k-proof/verification.k /tmp/audit-work/stage1-derived-check/verification.k
cp -a /reference/k-proof/spec.k /tmp/audit-work/stage1-derived-check/spec.k
sha256sum /tmp/audit-work/stage1-derived-check/verification.k /reference/k-proof/verification.k /tmp/audit-work/stage1-derived-check/spec.k /reference/k-proof/spec.k | tee /audit-output/evidence/08-later-proof-source-hashes.log
set -o pipefail
(set -x; kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled) 2>&1 | tee /audit-output/evidence/09-later-proof-kompile.log' in /tmp/audit-work/stage1-derived-check
