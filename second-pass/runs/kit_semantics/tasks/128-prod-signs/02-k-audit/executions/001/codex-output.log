diff --git a/loop-connection-spec.k b/loop-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4fb6264c35bd4c0e4cb32b375ca28932e498fe27
--- /dev/null
+++ b/loop-connection-spec.k
@@ -0,0 +1,58 @@
+requires "loop-connection.k"
+
+module LOOP-CONNECTION-SPEC
+  imports LOOP-CONNECTION
+
+  claim [prod-signs-loop]:
+    <k>
+      #loop(
+        list(intVals(REST:IntSeq)),
+        Name("value"),
+        Assign(Name("seen"), Int(1))
+        Assign(
+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
+        If(
+          Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
+          If(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(Name("sign"), Name("sign")),
+            Assign(Name("sign"), Int(0)))
+          .Stmts)
