+assert mutated.count(needle) == 1
+mutated = mutated.replace(
+    needle,
+    "=> 0",
+    1,
+)
+
+scratch = Path("/tmp/audit-work/128-prod-signs/auditor-false-spec.k")
+evidence = Path("/audit-output/evidence/auditor-false-spec.k")
