    15	    >>> prod_signs([0, 1]) == 0
    16	    >>> prod_signs([]) == None
    17	    """
    18	    if not arr: return None
    19	    prod = 0 if 0 in arr else (-1) ** len(list(filter(lambda x: x < 0, arr)))
    20	    return prod * sum([abs(i) for i in arr])
===== /candidate/solution.py
     1	def prod_signs(arr):
     2	    total = 0
     3	    sign = 1
     4	    seen = 0
     5	    for value in arr:
     6	        seen = 1
     7	        total = total + abs(value)
     8	        if value < 0:
     9	            sign = 0 - sign
    10	        elif value > 0:
    11	            sign = sign
    12	        else:
    13	            sign = 0
    14	
    15	    if seen == 0:
    16	        return None
    17	    return total * sign
