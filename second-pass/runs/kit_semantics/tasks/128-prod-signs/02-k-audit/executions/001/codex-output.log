@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -o pipefail
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log_path=$1
+shift
+
+{
