@@ -0,0 +1,18 @@
+requires "connection.k"
+
+module CONNECTION-MUTATION-SPEC
+  imports CONNECTION
+
+  // Deliberately false opposite interpretation of the first represented
+  // element: fixed iteration must yield 4, not 5.
+  claim [typed-iterator-wrong-value]:
+    <k>
+      #iterNext(list(intVals(iCons(4, .IntSeq))))
+      ~> #loopStep(TARGET:Expr, BODY:Stmts)
+      ~> CONT:K
+      =>
+      #iterYield(5, list(intVals(.IntSeq)))
+      ~> #loopStep(TARGET, BODY)
+      ~> CONT
+    </k>
+endmodule
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..00080f5637684695e409206831e2dc5adb575f1d
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,45 @@
+from itertools import product
+
+from solution import prod_signs
+
+
+def independent_oracle(arr):
+    if not arr:
+        return None
+
+    magnitude_sum = sum(abs(value) for value in arr)
+    negative_count = sum(1 for value in arr if value < 0)
+    has_zero = any(value == 0 for value in arr)
+
+    if has_zero:
+        product_of_signs = 0
+    elif negative_count % 2 == 0:
+        product_of_signs = 1
+    else:
+        product_of_signs = -1
+
+    return magnitude_sum * product_of_signs
+
+
+def main():
+    values = range(-3, 4)
+    case_count = 0
+    mismatch_count = 0
+
+    for length in range(6):
+        for values_tuple in product(values, repeat=length):
+            arr = list(values_tuple)
+            case_count += 1
+            if prod_signs(arr) != independent_oracle(arr):
+                mismatch_count += 1
+
+    print(
+        f"DIFFERENTIAL_CASES={case_count} "
+        f"MISMATCHES={mismatch_count}"
+    )
+    if mismatch_count:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/loop-body-mutation-spec.k b/loop-body-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..990f2fb9bd04e860c1e048ebc58fa2d206782ec9
--- /dev/null
+++ b/loop-body-mutation-spec.k
@@ -0,0 +1,61 @@
+requires "loop-connection.k"
+
+module LOOP-BODY-MUTATION-SPEC
+  imports LOOP-CONNECTION
+
+  // The first statement is deliberately changed from `seen = 1` to
+  // `seen = 0`, while the original result summary is retained.
+  claim [prod-signs-mutated-loop]:
+    <k>
+      #loop(
+        list(intVals(REST:IntSeq)),
+        Name("value"),
+        Assign(Name("seen"), Int(0))
+        Assign(
+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
+        If(
+          Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
+          If(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(Name("sign"), Name("sign")),
+            Assign(Name("sign"), Int(0)))
+          .Stmts)
+        .Stmts)
+      ~> If(
+           Compare(Name("seen"), CmpOp("==", Int(0))),
+           Return(NoneVal) .Stmts,
+           .Stmts)
+         Return(BinOp("*", Name("total"), Name("sign")))
+         .Stmts
+      ~> #endcall
+      => foldResult(REST, TOTAL:Int, SIGN:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE:Val,
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "seen" |-> 1
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
