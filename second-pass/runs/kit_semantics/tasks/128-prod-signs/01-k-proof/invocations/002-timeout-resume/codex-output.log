+        "any" |-> builtinV("any")
+        "zip" |-> builtinV("zip")
+        "isinstance" |-> builtinV("isinstance")
+        "sorted" |-> builtinV("sorted")
+        "list" |-> builtinV("list")
+        "round" |-> builtinV("round")
+        "bin" |-> builtinV("bin")
+        "enumerate" |-> builtinV("enumerate")
+        "map" |-> builtinV("map")
+        "eval" |-> builtinV("eval")
+        "int" |-> typeV("int")
+        "str" |-> typeV("str")
+        "float" |-> typeV("float"),
+        root)
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
