+        "eval" |-> builtinV("eval")
+        "int" |-> typeV("int")
+        "str" |-> typeV("str")
+        "float" |-> typeV("float"),
+        root)
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE:Val,
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
