/bin/bash -lc "python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy
sed -n '1,180p' solution.mpy
python3 - <<'PY'
from solution import prod_signs
cases = [([1, 2, 2, -4], -9), ([0, 1], 0), ([], None), ([-1, -2], 3), ([-1, -2, -3], -6), ([5], 5)]
