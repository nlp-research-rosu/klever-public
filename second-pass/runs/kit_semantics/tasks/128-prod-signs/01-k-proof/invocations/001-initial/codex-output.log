diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3a4d3bdaba9212e86b8e2bfa76286fc478162387
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,152 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(intVals(REST:IntSeq)),
+        Name("value"),
+        Assign(Name("seen"), Int(1))
+        Assign(
+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
+        If(
+          Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
+          If(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(Name("sign"), Name("sign")),
+            Assign(Name("sign"), Int(0)))
+          .Stmts)
+        .Stmts)
+      ~> If(
+           Compare(Name("seen"), CmpOp("==", Int(0))),
+           Return(NoneVal) .Stmts,
+           .Stmts)
+      ~> Return(BinOp("*", Name("total"), Name("sign")))
+      ~> #endcall
+      => foldResult(
+           REST,
+           TOTAL:Int,
+           SIGN:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE:Val,
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "seen" |-> 1
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [prod-signs]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "prod_signs",
+            Params("arr"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            Assign(Name("seen"), Int(0))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(Name("seen"), Int(1))
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            If(
+              Compare(Name("seen"), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts)))
+      ~> Call(Name("prod_signs"), list(intVals(INPUT:IntSeq)))
+      => prodSignsResult(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            Assign(Name("seen"), Int(0))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(Name("seen"), Int(1))
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            If(
+              Compare(Name("seen"), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/summaries.k b/summaries.k
new file mode 100644
index 0000000000000000000000000000000000000000..cffbe5dc46e9781c9d1ec0301daafe455ae3f2ec
--- /dev/null
+++ b/summaries.k
@@ -0,0 +1,56 @@
+requires "reference-semantics/semantics.k"
+
+module PROD-SUMMARIES-SYNTAX
+  imports MPY-CORE
+
+  syntax ValSeq ::= intVals(IntSeq) [functional]
+  syntax Int ::= foldResult(IntSeq, Int, Int) [function]
+  syntax Val ::= prodSignsResult(IntSeq) [function, total]
+  syntax KItem ::= #typedNext(IntSeq)
+endmodule
+
+module PROD-SUMMARIES
+  imports MPY
+  imports PROD-SUMMARIES-SYNTAX
+
+  // Concrete materialization documents the representation and supports ground
+  // evaluation.  connection.k supplies the symbolic twin only for Gate A.
+  rule intVals(.IntSeq) => .ValSeq [concrete]
+  rule intVals(iCons(VALUE:Int, REST:IntSeq))
+    => vCons(VALUE, intVals(REST))
+    [concrete]
+
+  rule <k> #typedNext(.IntSeq)
+        => #iterDone ... </k>
+  rule <k> #typedNext(iCons(VALUE:Int, REST:IntSeq))
+        => #iterYield(VALUE, list(intVals(REST))) ... </k>
+
+  rule foldResult(.IntSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+    [simplification]
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0 -Int SIGN)
+    requires VALUE <Int 0
+    [simplification]
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, _SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0)
+    requires notBool (VALUE <Int 0) andBool notBool (VALUE >Int 0)
+    [simplification]
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         SIGN)
+    requires VALUE >Int 0
+    [simplification]
+
+  rule prodSignsResult(.IntSeq) => noneV
+  rule prodSignsResult(iCons(VALUE:Int, REST:IntSeq))
+    => foldResult(iCons(VALUE, REST), 0, 1)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ea522986e9d7bc3739e757a2d172e8420fbdd3ee
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,19 @@
+requires "summaries.k"
+
+module VERIFICATION
+  imports PROD-SUMMARIES
+
+  // Typed-sequence iterator bridge, narrowed to a for-loop continuation.
+  // CONNECTION-SPEC proves both exhaustive fixed-semantics cases without
+  // importing this module.
+  rule <k>
+         #iterNext(list(intVals(IS:IntSeq)))
+         ~> #loopStep(TARGET:Expr, BODY:Stmts)
+         ~> CONT:K
+         =>
+         #typedNext(IS)
+         ~> #loopStep(TARGET, BODY)
+         ~> CONT
+       </k>
+       [priority(40)]
+endmodule

apply patch
patch: completed
/workspace/summaries.k
