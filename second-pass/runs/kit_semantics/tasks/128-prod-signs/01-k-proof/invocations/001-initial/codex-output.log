+def prod_signs(arr):
+    if len(arr) == 0:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        elif value > 0:
+            sign = sign
+        else:
+            sign = 0
+
+    return total * sign
