diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b07c1a78260024c19802366147fa2b52aa0e86fd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+
+  syntax Bool ::= intsOnly(ValSeq) [function, total]
+  syntax Int ::= foldResult(ValSeq, Int, Int) [function]
+  syntax Val ::= prodSignsResult(ValSeq) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule intsOnly(.ValSeq) => true
+  rule intsOnly(vCons(_VALUE:Int, REST:ValSeq)) => intsOnly(REST)
+  rule intsOnly(vCons(_VALUE:Val, _REST:ValSeq)) => false [owise]
+
+  rule foldResult(.ValSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+  rule foldResult(vCons(VALUE:Int, REST:ValSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0 -Int SIGN)
+    requires VALUE <Int 0
+  rule foldResult(vCons(VALUE:Int, REST:ValSeq), TOTAL:Int, _SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0)
+    requires VALUE ==Int 0
+  rule foldResult(vCons(VALUE:Int, REST:ValSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         SIGN)
+    requires notBool (VALUE <Int 0) andBool VALUE =/=Int 0
+
+  rule prodSignsResult(.ValSeq) => noneV
+  rule prodSignsResult(vCons(VALUE:Int, REST:ValSeq))
+    => foldResult(vCons(VALUE, REST), 0, 1)
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..4991d249ab3416ae7405ae202142363cf3c9fe58
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,21 @@
+def prod_signs(arr):
+    if len(arr) == 0:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        if value == 0:
+            sign = 0
+
+    return total * sign
+
+
+assert prod_signs([1, 2, 2, -4]) == -9
+assert prod_signs([0, 1]) == 0
+assert prod_signs([]) is None
+assert prod_signs([-1, -2]) == 3
+assert prod_signs([-1, -2, -3]) == -6
