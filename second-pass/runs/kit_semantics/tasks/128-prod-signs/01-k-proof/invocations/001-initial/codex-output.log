+      ~> Return(BinOp("*", Name("total"), Name("sign")))
+      ~> #endcall
+      => foldResult(
+           vCons(psHead(REST), intVals(psTail(REST))),
+           TOTAL:Int,
+           SIGN:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE:Val,
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "seen" |-> 1
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE,
+        parent(-1))
