+
+  claim [typed-iterator-empty]:
+    <k>
+      #iterNext(list(VS:ValSeq))
+      ~> #loopStep(TARGET:Expr, BODY:Stmts)
+      ~> CONT:K
+      =>
+      #iterDone
+      ~> #loopStep(TARGET, BODY)
+      ~> CONT
+    </k>
+    requires VS ==K intVals(.IntSeq)
+
+  claim [typed-iterator-step]:
+    <k>
+      #iterNext(list(VS:ValSeq))
+      ~> #loopStep(TARGET:Expr, BODY:Stmts)
+      ~> CONT:K
+      =>
+      #iterYield(VALUE, list(intVals(REST)))
+      ~> #loopStep(TARGET, BODY)
+      ~> CONT
+    </k>
+    requires VS ==K intVals(iCons(VALUE:Int, REST:IntSeq))
+endmodule
