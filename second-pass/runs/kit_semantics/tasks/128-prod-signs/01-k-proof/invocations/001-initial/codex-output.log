+assert prod_signs([]) is None
+assert prod_signs([-1, -2]) == 3
+assert prod_signs([-1, -2, -3]) == -6
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2b60db2d6199bd4e3b39e87a20bdaea01a65bcb7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def prod_signs(arr):
+    if len(arr) == 0:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        if value == 0:
+            sign = 0
+
+    return total * sign
