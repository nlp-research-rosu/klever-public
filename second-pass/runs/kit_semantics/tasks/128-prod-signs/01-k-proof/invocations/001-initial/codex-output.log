+def prod_signs(arr):
+    if len(arr) == 0:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        if value == 0:
+            sign = 0
+
+    return total * sign
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b8a749547bc0eed2df50d96a26995a727d9b8ef1
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,204 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(intVals(iCons(VALUE:Int, REST:IntSeq))),
+        Name("value"),
+        Assign(
+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
+        If(
+          Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
+          .Stmts)
+        If(
+          Compare(Name("value"), CmpOp("==", Int(0))),
+          Assign(Name("sign"), Int(0)),
+          .Stmts)
+        .Stmts)
+      ~> Return(BinOp("*", Name("total"), Name("sign")))
+      ~> #endcall
+      => foldResult(
+           iCons(VALUE, REST),
+           TOTAL:Int,
+           SIGN:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                .Stmts)
+              If(
+                Compare(Name("value"), CmpOp("==", Int(0))),
+                Assign(Name("sign"), Int(0)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                .Stmts)
+              If(
+                Compare(Name("value"), CmpOp("==", Int(0))),
+                Assign(Name("sign"), Int(0)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [prod-signs]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "prod_signs",
+            Params("arr"),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                .Stmts)
+              If(
+                Compare(Name("value"), CmpOp("==", Int(0))),
+                Assign(Name("sign"), Int(0)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts)))
+      ~> Call(Name("prod_signs"), list(intVals(INPUT:IntSeq)))
+      => prodSignsResult(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                .Stmts)
+              If(
+                Compare(Name("value"), CmpOp("==", Int(0))),
+                Assign(Name("sign"), Int(0)) .Stmts,
+                .Stmts)
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/summaries.k b/summaries.k
new file mode 100644
index 0000000000000000000000000000000000000000..b08029262ab19f327cc052c73981a1db52f74491
--- /dev/null
+++ b/summaries.k
@@ -0,0 +1,43 @@
+requires "reference-semantics/semantics.k"
+
+module PROD-SUMMARIES-SYNTAX
+  imports MPY-CORE
+
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  syntax Int ::= foldResult(IntSeq, Int, Int) [function]
+  syntax Val ::= prodSignsResult(IntSeq) [function, total]
+endmodule
+
+module PROD-SUMMARIES
+  imports MPY
+  imports PROD-SUMMARIES-SYNTAX
+
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(VALUE:Int, REST:IntSeq))
+    => vCons(VALUE, intVals(REST))
+
+  rule foldResult(.IntSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0 -Int SIGN)
+    requires VALUE <Int 0
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, _SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0)
+    requires VALUE ==Int 0
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         SIGN)
+    requires notBool (VALUE <Int 0) andBool VALUE =/=Int 0
+
+  rule prodSignsResult(.IntSeq) => noneV
+  rule prodSignsResult(iCons(VALUE:Int, REST:IntSeq))
+    => foldResult(iCons(VALUE, REST), 0, 1)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d86343a6bd9a29a8afa71ea04667c403c99f826e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,15 @@
+requires "summaries.k"
+
+module VERIFICATION
+  imports PROD-SUMMARIES
+
+  // Typed-sequence iterator bridge.  Its fixed-semantics connection is proved
+  // independently by CONNECTION-SPEC without importing this module.
+  rule <k> #iterNext(list(intVals(.IntSeq)))
+        => #iterDone ... </k>
+       [priority(40)]
+
+  rule <k> #iterNext(list(intVals(iCons(VALUE:Int, REST:IntSeq))))
+        => #iterYield(VALUE, list(intVals(REST))) ... </k>
+       [priority(40)]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell connection.k --main-module CONNECTION --syntax-module MPY-SYNTAX --output-definition connection-kompiled' in /workspace
