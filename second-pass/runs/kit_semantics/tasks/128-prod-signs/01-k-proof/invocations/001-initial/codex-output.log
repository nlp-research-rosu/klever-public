+       [priority(40)]
+
+  rule <k> #iterNext(list(intVals(iCons(VALUE:Int, REST:IntSeq))))
+        => #iterYield(VALUE, list(intVals(REST))) ... </k>
+       [priority(40)]
+endmodule

