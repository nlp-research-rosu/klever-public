+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
