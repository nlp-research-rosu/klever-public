diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6a1c19a411c586b7bbd9522c8384a20b9f4cc397
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,153 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(intVals(REST:IntSeq)),
+        Name("value"),
+        Assign(Name("seen"), Int(1))
+        Assign(
+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
+        If(
+          Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
+          If(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(Name("sign"), Name("sign")),
+            Assign(Name("sign"), Int(0)))
+          .Stmts)
+        .Stmts)
+      ~> If(
+           Compare(Name("seen"), CmpOp("==", Int(0))),
+           Return(NoneVal) .Stmts,
+           .Stmts)
+      ~> Return(BinOp("*", Name("total"), Name("sign")))
+      ~> #endcall
+      => foldResult(
+           REST,
+           TOTAL:Int,
+           SIGN:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE:Val,
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "seen" |-> 1
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool psEmpty(REST)
+
+  claim [prod-signs]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "prod_signs",
+            Params("arr"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            Assign(Name("seen"), Int(0))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(Name("seen"), Int(1))
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            If(
+              Compare(Name("seen"), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts)))
+      ~> Call(Name("prod_signs"), list(intVals(INPUT:IntSeq)))
+      => prodSignsResult(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            Assign(Name("seen"), Int(0))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(Name("seen"), Int(1))
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            If(
+              Compare(Name("seen"), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/summaries.k b/summaries.k
new file mode 100644
index 0000000000000000000000000000000000000000..0e0b1d1cb182758faa8d556377161e42804fecba
--- /dev/null
+++ b/summaries.k
@@ -0,0 +1,66 @@
+requires "reference-semantics/semantics.k"
+
+module PROD-SUMMARIES-SYNTAX
+  imports MPY-CORE
+
+  syntax Bool ::= psEmpty(IntSeq) [function, total]
+  syntax Int ::= psHead(IntSeq) [function, total]
+               | foldResult(IntSeq, Int, Int) [function]
+  syntax IntSeq ::= psTail(IntSeq) [function, total]
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  syntax Val ::= prodSignsResult(IntSeq) [function, total]
+endmodule
+
+module PROD-SUMMARIES
+  imports MPY
+  imports PROD-SUMMARIES-SYNTAX
+
+  rule psEmpty(.IntSeq) => true
+  rule psEmpty(iCons(_VALUE:Int, _REST:IntSeq)) => false
+
+  rule psHead(.IntSeq) => 0
+  rule psHead(iCons(VALUE:Int, _REST:IntSeq)) => VALUE
+
+  rule psTail(.IntSeq) => .IntSeq
+  rule psTail(iCons(_VALUE:Int, REST:IntSeq)) => REST
+
+  rule intVals(IS:IntSeq) => .ValSeq
+    requires psEmpty(IS)
+  rule intVals(IS:IntSeq)
+    => vCons(psHead(IS), intVals(psTail(IS)))
+    requires notBool psEmpty(IS)
+
+  rule foldResult(IS:IntSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+    requires psEmpty(IS)
+    [simplification]
+  rule foldResult(IS:IntSeq, TOTAL:Int, SIGN:Int)
+    => foldResult(
+         psTail(IS),
+         TOTAL +Int absInt(psHead(IS)),
+         0 -Int SIGN)
+    requires notBool psEmpty(IS) andBool psHead(IS) <Int 0
+    [simplification]
+  rule foldResult(IS:IntSeq, TOTAL:Int, _SIGN:Int)
+    => foldResult(
+         psTail(IS),
+         TOTAL +Int absInt(psHead(IS)),
+         0)
+    requires notBool psEmpty(IS)
+     andBool notBool (psHead(IS) <Int 0)
+     andBool notBool (psHead(IS) >Int 0)
+    [simplification]
+  rule foldResult(IS:IntSeq, TOTAL:Int, SIGN:Int)
+    => foldResult(
+         psTail(IS),
+         TOTAL +Int absInt(psHead(IS)),
+         SIGN)
+    requires notBool psEmpty(IS) andBool psHead(IS) >Int 0
+    [simplification]
+
+  rule prodSignsResult(IS:IntSeq) => noneV
+    requires psEmpty(IS)
+  rule prodSignsResult(IS:IntSeq)
+    => foldResult(IS, 0, 1)
+    requires notBool psEmpty(IS)
+endmodule
