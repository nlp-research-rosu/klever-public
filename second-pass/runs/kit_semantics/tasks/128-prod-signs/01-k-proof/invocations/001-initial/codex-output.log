diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f28aa3a84187259c8527ffe9fc32d20a151787a8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,37 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  syntax Int ::= nextSign(Int, Int) [function, total]
+               | foldResult(IntSeq, Int, Int) [function, total]
+  syntax Val ::= prodSignsResult(IntSeq) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, REST:IntSeq))
+    => vCons(I, intVals(REST))
+
+  rule nextSign(SIGN:Int, VALUE:Int) => 0 -Int SIGN
+    requires VALUE <Int 0
+  rule nextSign(_SIGN:Int, 0) => 0
+  rule nextSign(SIGN:Int, VALUE:Int) => SIGN
+    requires VALUE >Int 0
+
+  rule foldResult(.IntSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         nextSign(SIGN, VALUE))
+
+  rule prodSignsResult(.IntSeq) => noneV
+  rule prodSignsResult(iCons(VALUE:Int, REST:IntSeq))
+    => foldResult(iCons(VALUE, REST), 0, 1)
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..4991d249ab3416ae7405ae202142363cf3c9fe58
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,21 @@
+def prod_signs(arr):
+    if len(arr) == 0:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        if value == 0:
+            sign = 0
+
+    return total * sign
+
+
+assert prod_signs([1, 2, 2, -4]) == -9
+assert prod_signs([0, 1]) == 0
+assert prod_signs([]) is None
+assert prod_signs([-1, -2]) == 3
+assert prod_signs([-1, -2, -3]) == -6
