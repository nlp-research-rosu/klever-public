+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(intVals(REST:IntSeq)),
+        Name("value"),
+        Assign(Name("seen"), Int(1))
+        Assign(
+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
+        If(
+          Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
+          If(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(Name("sign"), Name("sign")),
+            Assign(Name("sign"), Int(0)))
+          .Stmts)
+        .Stmts)
+      ~> If(
+           Compare(Name("seen"), CmpOp("==", Int(0))),
+           Return(NoneVal) .Stmts,
+           .Stmts)
+      ~> Return(BinOp("*", Name("total"), Name("sign")))
+      ~> #endcall
+      => foldResult(
+           REST,
+           TOTAL:Int,
+           SIGN:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE:Val,
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "seen" |-> 1
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool emptyIS(REST)
+
+  claim [prod-signs]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "prod_signs",
+            Params("arr"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            Assign(Name("seen"), Int(0))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(Name("seen"), Int(1))
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            If(
+              Compare(Name("seen"), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts)))
+      ~> Call(Name("prod_signs"), list(intVals(INPUT:IntSeq)))
+      => prodSignsResult(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            Assign(Name("seen"), Int(0))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(Name("seen"), Int(1))
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            If(
+              Compare(Name("seen"), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/summaries.k b/summaries.k
new file mode 100644
index 0000000000000000000000000000000000000000..845a0da353fb40740e8333375ca99618d4f502c6
--- /dev/null
+++ b/summaries.k
@@ -0,0 +1,66 @@
+requires "reference-semantics/semantics.k"
+
+module PROD-SUMMARIES-SYNTAX
+  imports MPY-CORE
+
+  syntax Bool ::= emptyIS(IntSeq) [function, total]
+  syntax Int ::= headIS(IntSeq) [function, total]
+               | foldResult(IntSeq, Int, Int) [function]
+  syntax IntSeq ::= tailIS(IntSeq) [function, total]
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  syntax Val ::= prodSignsResult(IntSeq) [function, total]
+endmodule
+
+module PROD-SUMMARIES
+  imports MPY
+  imports PROD-SUMMARIES-SYNTAX
+
+  rule emptyIS(.IntSeq) => true
+  rule emptyIS(iCons(_VALUE:Int, _REST:IntSeq)) => false
+
+  rule headIS(.IntSeq) => 0
+  rule headIS(iCons(VALUE:Int, _REST:IntSeq)) => VALUE
+
+  rule tailIS(.IntSeq) => .IntSeq
+  rule tailIS(iCons(_VALUE:Int, REST:IntSeq)) => REST
+
+  rule intVals(IS:IntSeq) => .ValSeq
+    requires emptyIS(IS)
+  rule intVals(IS:IntSeq)
+    => vCons(headIS(IS), intVals(tailIS(IS)))
+    requires notBool emptyIS(IS)
+
+  rule foldResult(IS:IntSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+    requires emptyIS(IS)
+    [simplification]
+  rule foldResult(IS:IntSeq, TOTAL:Int, SIGN:Int)
+    => foldResult(
+         tailIS(IS),
+         TOTAL +Int absInt(headIS(IS)),
+         0 -Int SIGN)
+    requires notBool emptyIS(IS) andBool headIS(IS) <Int 0
+    [simplification]
+  rule foldResult(IS:IntSeq, TOTAL:Int, _SIGN:Int)
+    => foldResult(
+         tailIS(IS),
+         TOTAL +Int absInt(headIS(IS)),
+         0)
+    requires notBool emptyIS(IS)
+     andBool notBool (headIS(IS) <Int 0)
+     andBool notBool (headIS(IS) >Int 0)
+    [simplification]
+  rule foldResult(IS:IntSeq, TOTAL:Int, SIGN:Int)
+    => foldResult(
+         tailIS(IS),
+         TOTAL +Int absInt(headIS(IS)),
+         SIGN)
+    requires notBool emptyIS(IS) andBool headIS(IS) >Int 0
+    [simplification]
+
+  rule prodSignsResult(IS:IntSeq) => noneV
+    requires emptyIS(IS)
+  rule prodSignsResult(IS:IntSeq)
+    => foldResult(IS, 0, 1)
+    requires notBool emptyIS(IS)
+endmodule
