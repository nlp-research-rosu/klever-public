+  // independently by CONNECTION-SPEC without importing this module.
+  rule <k> #iterNext(list(intVals(.IntSeq)))
+        => #iterDone ... </k>
+       [priority(40)]
+
+  rule <k> #iterNext(list(intVals(iCons(VALUE:Int, REST:IntSeq))))
+        => #iterYield(VALUE, list(intVals(REST))) ... </k>
+       [priority(40)]
+endmodule

