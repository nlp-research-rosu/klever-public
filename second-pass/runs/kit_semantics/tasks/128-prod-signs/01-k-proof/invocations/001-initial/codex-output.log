+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
+        If(
+          Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
+          If(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(Name("sign"), Name("sign")),
+            Assign(Name("sign"), Int(0)))
+          .Stmts)
+        .Stmts)
+      ~> If(
+           Compare(Name("seen"), CmpOp("==", Int(0))),
+           Return(NoneVal) .Stmts,
+           .Stmts)
+      ~> Return(BinOp("*", Name("total"), Name("sign")))
+      ~> #endcall
+      => foldResult(
+           vCons(psHead(REST), intVals(psTail(REST))),
+           TOTAL:Int,
+           SIGN:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE:Val,
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "seen" |-> 1
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |-> CLOSURE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool psEmpty(REST)
+
+  claim [prod-signs]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "prod_signs",
+            Params("arr"),
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            Assign(Name("seen"), Int(0))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(Name("seen"), Int(1))
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            If(
+              Compare(Name("seen"), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts)))
+      ~> Call(Name("prod_signs"), list(intVals(INPUT:IntSeq)))
+      => prodSignsResult(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            Assign(Name("seen"), Int(0))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(Name("seen"), Int(1))
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            If(
+              Compare(Name("seen"), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/summaries.k b/summaries.k
new file mode 100644
index 0000000000000000000000000000000000000000..5eac338d9364e080b3e63979750c529f4053759e
--- /dev/null
+++ b/summaries.k
@@ -0,0 +1,73 @@
+requires "reference-semantics/semantics.k"
+
+module PROD-SUMMARIES-SYNTAX
+  imports MPY-CORE
+
+  syntax Bool ::= psEmpty(IntSeq) [function, total]
+  syntax Int ::= psHead(IntSeq) [function, total]
+               | foldResult(ValSeq, Int, Int) [function]
+  syntax IntSeq ::= psTail(IntSeq) [function, total]
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  syntax Val ::= prodSignsResult(IntSeq) [function, total]
+endmodule
+
+module PROD-SUMMARIES
+  imports MPY
+  imports PROD-SUMMARIES-SYNTAX
+
+  rule psEmpty(.IntSeq) => true
+  rule psEmpty(iCons(_VALUE:Int, _REST:IntSeq)) => false
+
+  rule psHead(.IntSeq) => 0
+  rule psHead(iCons(VALUE:Int, _REST:IntSeq)) => VALUE
+
+  rule psTail(.IntSeq) => .IntSeq
+  rule psTail(iCons(_VALUE:Int, REST:IntSeq)) => REST
+
+  rule intVals(IS:IntSeq) => .ValSeq
+    requires psEmpty(IS)
+  rule intVals(IS:IntSeq)
+    => vCons(psHead(IS), intVals(psTail(IS)))
+    requires notBool psEmpty(IS)
+
+  rule foldResult(.ValSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+    [simplification]
+  rule foldResult(
+         vCons(VALUE:Int, REST:ValSeq),
+         TOTAL:Int,
+         SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0 -Int SIGN)
+    requires VALUE <Int 0
+    [simplification]
+  rule foldResult(
+         vCons(VALUE:Int, REST:ValSeq),
+         TOTAL:Int,
+         _SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0)
+    requires notBool (VALUE <Int 0)
+     andBool notBool (VALUE >Int 0)
+    [simplification]
+  rule foldResult(
+         vCons(VALUE:Int, REST:ValSeq),
+         TOTAL:Int,
+         SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         SIGN)
+    requires VALUE >Int 0
+    [simplification]
+
+  rule prodSignsResult(IS:IntSeq) => noneV
+    requires psEmpty(IS)
+  rule prodSignsResult(IS:IntSeq)
+    => foldResult(intVals(IS), 0, 1)
+    requires notBool psEmpty(IS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..003bbdf7bdc72b1ffb9f21ce96c14f36f89c4792
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,19 @@
+requires "summaries.k"
+
+module VERIFICATION
+  imports PROD-SUMMARIES
+
+  // Type-preserving specialization of MPY-LIST's iterator step.  The fixed
+  // rule has the same transition with a Val-sorted head; this specialization
+  // prevents the symbolic backend from widening an Int head before abs().
+  rule <k>
+         #iterNext(list(vCons(VALUE:Int, REST:ValSeq)))
+         ~> #loopStep(TARGET:Expr, BODY:Stmts)
+         ~> CONT:K
+         =>
+         #iterYield(VALUE, list(REST))
+         ~> #loopStep(TARGET, BODY)
+         ~> CONT
+       </k>
+       [priority(40)]
+endmodule

