+    <exit-code> 0 </exit-code>
+
+  claim [prod-signs]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "prod_signs",
+            Params("arr"),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
