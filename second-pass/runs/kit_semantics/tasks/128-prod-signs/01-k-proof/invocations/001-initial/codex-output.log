diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0e284216db6cf2f912f2396e6151a624c0cca806
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-CORE
+
+  syntax Bool ::= intsOnly(ValSeq) [function, total]
+  syntax Int ::= foldResult(ValSeq, Int, Int) [function]
+  syntax Val ::= prodSignsResult(ValSeq) [function]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+
+  rule intsOnly(.ValSeq) => true
+  rule intsOnly(vCons(VALUE:Val, REST:ValSeq))
+    => isInt(VALUE) andBool intsOnly(REST)
+
+  rule foldResult(.ValSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+  rule foldResult(vCons(VALUE:Int, REST:ValSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0 -Int SIGN)
+    requires VALUE <Int 0
+  rule foldResult(vCons(VALUE:Int, REST:ValSeq), TOTAL:Int, _SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0)
+    requires VALUE ==Int 0
+  rule foldResult(vCons(VALUE:Int, REST:ValSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         SIGN)
+    requires notBool (VALUE <Int 0) andBool VALUE =/=Int 0
+
+  rule prodSignsResult(.ValSeq) => noneV
+  rule prodSignsResult(vCons(VALUE:Int, REST:ValSeq))
+    => foldResult(vCons(VALUE, REST), 0, 1)
+endmodule

codex
The semantics’ `isInt` predicate can exclude non-integers, but this backend does not refine a symbolic `Val` into the `Int` subsort, so fixed `abs` remains stuck on the spurious untyped branch. The sound repair is a typed-sequence iterator bridge with two exact cases (empty and integer-cons), plus separate bridge-free connection claims proving those cases from the supplied iterator semantics. I’m applying that extension contract now; if either connection claim fails, the bridge will be removed.
apply patch
