+    <k>
+      #iterNext(list(VS:ValSeq))
+      ~> #loopStep(TARGET:Expr, BODY:Stmts)
+      ~> CONT:K
+      =>
+      #iterDone
+      ~> #loopStep(TARGET, BODY)
+      ~> CONT
+    </k>
+    requires VS ==K intVals(.IntSeq)
+
+  claim [typed-iterator-step]:
+    <k>
+      #iterNext(list(VS:ValSeq))
+      ~> #loopStep(TARGET:Expr, BODY:Stmts)
+      ~> CONT:K
+      =>
+      #iterYield(VALUE, list(intVals(REST)))
+      ~> #loopStep(TARGET, BODY)
+      ~> CONT
+    </k>
+    requires VS ==K intVals(iCons(VALUE:Int, REST:IntSeq))
+endmodule
diff --git a/connection.k b/connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..5743c7b74dec8e322016f73eac4de59217a55ca6
--- /dev/null
+++ b/connection.k
@@ -0,0 +1,13 @@
+requires "summaries.k"
+
+module CONNECTION
+  imports PROD-SUMMARIES
+
+  // Symbolic materialization used only to prove the bridge connections.
+  // VERIFICATION does not import this module.
+  rule intVals(.IntSeq) => .ValSeq
+    [simplification]
+  rule intVals(iCons(VALUE:Int, REST:IntSeq))
+    => vCons(VALUE, intVals(REST))
+    [simplification]
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..715e313ffe898d771d272ba4af5e4301955642cb
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,24 @@
+def prod_signs(arr):
+    total = 0
+    sign = 1
+    seen = 0
+    for value in arr:
+        seen = 1
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        elif value > 0:
+            sign = sign
+        else:
+            sign = 0
+
+    if seen == 0:
+        return None
+    return total * sign
+
+
+assert prod_signs([1, 2, 2, -4]) == -9
+assert prod_signs([0, 1]) == 0
+assert prod_signs([]) is None
+assert prod_signs([-1, -2]) == 3
+assert prod_signs([-1, -2, -3]) == -6
