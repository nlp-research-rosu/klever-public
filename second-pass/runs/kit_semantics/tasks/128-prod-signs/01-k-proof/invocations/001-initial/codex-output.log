diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..4991d249ab3416ae7405ae202142363cf3c9fe58
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,21 @@
+def prod_signs(arr):
+    if len(arr) == 0:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        if value == 0:
+            sign = 0
+
+    return total * sign
+
+
+assert prod_signs([1, 2, 2, -4]) == -9
+assert prod_signs([0, 1]) == 0
+assert prod_signs([]) is None
+assert prod_signs([-1, -2]) == 3
+assert prod_signs([-1, -2, -3]) == -6
