+    <k>
+      #iterNext(list(intVals(.IntSeq)))
+      ~> #loopStep(TARGET:Expr, BODY:Stmts)
+      ~> CONT:K
+      =>
+      #iterDone
+      ~> #loopStep(TARGET, BODY)
+      ~> CONT
+    </k>
+
+  claim [typed-iterator-step]:
+    <k>
+      #iterNext(list(intVals(iCons(VALUE:Int, REST:IntSeq))))
+      ~> #loopStep(TARGET:Expr, BODY:Stmts)
+      ~> CONT:K
+      =>
+      #iterYield(VALUE, list(intVals(REST)))
+      ~> #loopStep(TARGET, BODY)
+      ~> CONT
+    </k>
+endmodule
diff --git a/connection.k b/connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..f4be243f2d73f1c7bba0a03e47cea3387cc23205
--- /dev/null
+++ b/connection.k
@@ -0,0 +1,12 @@
+requires "summaries.k"
+
+module CONNECTION
+  imports PROD-SUMMARIES
+
+  // Symbolic materialization used only by the bridge-free connection proofs.
+  rule intVals(.IntSeq) => .ValSeq
+    [anywhere]
+  rule intVals(iCons(VALUE:Int, REST:IntSeq))
+    => vCons(VALUE, intVals(REST))
+    [anywhere]
+endmodule
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..715e313ffe898d771d272ba4af5e4301955642cb
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,24 @@
+def prod_signs(arr):
+    total = 0
+    sign = 1
+    seen = 0
+    for value in arr:
+        seen = 1
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        elif value > 0:
+            sign = sign
+        else:
+            sign = 0
+
+    if seen == 0:
+        return None
+    return total * sign
+
+
+assert prod_signs([1, 2, 2, -4]) == -9
+assert prod_signs([0, 1]) == 0
+assert prod_signs([]) is None
+assert prod_signs([-1, -2]) == 3
+assert prod_signs([-1, -2, -3]) == -6
