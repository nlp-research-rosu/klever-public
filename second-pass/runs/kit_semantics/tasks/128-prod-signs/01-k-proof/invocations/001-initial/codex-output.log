+def prod_signs(arr):
+    if len(arr) == 0:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        elif value > 0:
+            sign = sign
+        else:
+            sign = 0
+
+    return total * sign
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a13f8a4b941a7c796984fe52fb38990772e81827
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,204 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(intVals(iCons(VALUE:Int, REST:IntSeq))),
+        Name("value"),
+        Assign(
+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
+        If(
+          Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
+          If(
+            Compare(Name("value"), CmpOp(">", Int(0))),
+            Assign(Name("sign"), Name("sign")),
+            Assign(Name("sign"), Int(0)))
+          .Stmts)
+        .Stmts)
+      ~> Return(BinOp("*", Name("total"), Name("sign")))
+      ~> #endcall
+      => foldResult(
+           iCons(VALUE, REST),
+           TOTAL:Int,
+           SIGN:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+      1 |-> scope(
+        "arr" |-> list(intVals(INPUT:IntSeq))
+        "total" |-> TOTAL
+        "sign" |-> SIGN
+        "value" |-> OLD:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [prod-signs]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "prod_signs",
+            Params("arr"),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts)))
+      ~> Call(Name("prod_signs"), list(intVals(INPUT:IntSeq)))
+      => prodSignsResult(INPUT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "prod_signs" |->
+          closureVal(
+            ("arr", .ParamNames),
+            If(
+              Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
+              Return(NoneVal) .Stmts,
+              .Stmts)
+            Assign(Name("total"), Int(0))
+            Assign(Name("sign"), Int(1))
+            For(
+              Name("value"),
+              Name("arr"),
+              Assign(
+                Name("total"),
+                BinOp(
+                  "+",
+                  Name("total"),
+                  Call(Name("abs"), Name("value"))))
+              If(
+                Compare(Name("value"), CmpOp("<", Int(0))),
+                Assign(
+                  Name("sign"),
+                  BinOp("-", Int(0), Name("sign"))) .Stmts,
+                If(
+                  Compare(Name("value"), CmpOp(">", Int(0))),
+                  Assign(Name("sign"), Name("sign")) .Stmts,
+                  Assign(Name("sign"), Int(0)) .Stmts)
+                .Stmts)
+              .Stmts)
+            Return(BinOp("*", Name("total"), Name("sign")))
+            .Stmts,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/summaries.k b/summaries.k
new file mode 100644
index 0000000000000000000000000000000000000000..3930ee18f448963c698a4e7624e56a1386909a13
--- /dev/null
+++ b/summaries.k
@@ -0,0 +1,55 @@
+requires "reference-semantics/semantics.k"
+
+module PROD-SUMMARIES-SYNTAX
+  imports MPY-CORE
+
+  syntax ValSeq ::= intVals(IntSeq)
+                    [function, total, no-evaluators]
+  syntax Int ::= foldResult(IntSeq, Int, Int) [function]
+  syntax Val ::= prodSignsResult(IntSeq) [function, total]
+  syntax KItem ::= #typedNext(IntSeq)
+endmodule
+
+module PROD-SUMMARIES
+  imports MPY
+  imports PROD-SUMMARIES-SYNTAX
+
+  rule intVals(.IntSeq) => .ValSeq [concrete]
+  rule intVals(iCons(VALUE:Int, REST:IntSeq))
+    => vCons(VALUE, intVals(REST))
+    [concrete]
+
+  rule <k> #typedNext(.IntSeq)
+        => #iterDone ... </k>
+  rule <k> #typedNext(iCons(VALUE:Int, REST:IntSeq))
+        => #iterYield(VALUE, list(intVals(REST))) ... </k>
+
+  rule foldResult(.IntSeq, TOTAL:Int, SIGN:Int)
+    => TOTAL *Int SIGN
+    [simplification]
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0 -Int SIGN)
+    requires VALUE <Int 0
+    [simplification]
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, _SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         0)
+    requires notBool (VALUE <Int 0) andBool notBool (VALUE >Int 0)
+    [simplification]
+  rule foldResult(iCons(VALUE:Int, REST:IntSeq), TOTAL:Int, SIGN:Int)
+    => foldResult(
+         REST,
+         TOTAL +Int absInt(VALUE),
+         SIGN)
+    requires VALUE >Int 0
+    [simplification]
+
+  rule prodSignsResult(.IntSeq) => noneV
+  rule prodSignsResult(iCons(VALUE:Int, REST:IntSeq))
+    => foldResult(iCons(VALUE, REST), 0, 1)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..982729ee87183712042aa355835333faa5c4e8b6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "summaries.k"
+
+module VERIFICATION
+  imports PROD-SUMMARIES
+
+  // Length connection for the same typed sequence representation.
+  rule vsLen(intVals(IS:IntSeq))
+    => isLen(IS)
+    [simplification]
+
+  // Typed-sequence iterator bridge, narrowed to the for-loop continuation.
+  // Its two exhaustive fixed-semantics cases are proved independently by
+  // CONNECTION-SPEC without importing this module.
+  rule <k>
+         #iterNext(list(VS:ValSeq))
+         ~> #loopStep(TARGET:Expr, BODY:Stmts)
+         ~> CONT:K
+         =>
+         #typedNext(IS:IntSeq)
+         ~> #loopStep(TARGET, BODY)
+         ~> CONT
+       </k>
+       requires VS ==K intVals(IS)
+       [priority(40)]
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell connection.k --main-module CONNECTION --syntax-module MPY-SYNTAX --output-definition connection-kompiled' in /workspace
