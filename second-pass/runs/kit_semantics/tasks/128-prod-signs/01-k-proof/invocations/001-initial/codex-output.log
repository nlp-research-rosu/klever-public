diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..547ba4a0c38778074fb93a059a335f3a35cf163f
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,23 @@
+def prod_signs(arr):
+    if len(arr) == 0:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        total = total + abs(value)
+        if value < 0:
+            sign = 0 - sign
+        elif value > 0:
+            sign = sign
+        else:
+            sign = 0
+
+    return total * sign
+
+
+assert prod_signs([1, 2, 2, -4]) == -9
+assert prod_signs([0, 1]) == 0
+assert prod_signs([]) is None
+assert prod_signs([-1, -2]) == 3
+assert prod_signs([-1, -2, -3]) == -6
