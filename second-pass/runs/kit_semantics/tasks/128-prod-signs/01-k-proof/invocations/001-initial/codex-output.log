+requires "summaries.k"
+
+module VERIFICATION
+  imports PROD-SUMMARIES
+
+  // Typed-sequence iterator bridge.  Its fixed-semantics connection is proved
+  // independently by CONNECTION-SPEC without importing this module.
+  rule <k> #iterNext(list(VS:ValSeq))
+        => #typedNext(IS:IntSeq) ... </k>
+       requires VS ==K intVals(IS)
+       [priority(40)]
+endmodule

