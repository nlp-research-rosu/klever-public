Module(
  FuncDef("prod_signs", Params("arr"),
    Assign(Name("total"), Int(0))
    Assign(Name("sign"), Int(1))
    Assign(Name("seen"), Int(0))
    For(Name("value"), Name("arr"),
      Assign(Name("seen"), Int(1))
      Assign(
        Name("total"),
        BinOp("+", Name("total"), Call(Name("abs"), Name("value"))))
      If(Compare(Name("value"), CmpOp("<", Int(0))),
        Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
        If(Compare(Name("value"), CmpOp(">", Int(0))),
          Assign(Name("sign"), Name("sign")),
          Assign(Name("sign"), Int(0)))))
    If(Compare(Name("seen"), CmpOp("==", Int(0))),
      Return(NoneVal),
      )
    Return(BinOp("*", Name("total"), Name("sign"))))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(Int(1), Int(2), Int(2), UnaryOp("-", Int(4)))),
      CmpOp("==", UnaryOp("-", Int(9)))))
  Assert(
    Compare(
      Call(Name("prod_signs"), ListExpr(Int(0), Int(1))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("prod_signs"), ListExpr()), CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(2)))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(6))))))
