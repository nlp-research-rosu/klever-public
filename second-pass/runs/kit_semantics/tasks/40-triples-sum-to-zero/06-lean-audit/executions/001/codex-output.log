+-- Counterfactual implementations.
+def alwaysFalseAnd (_ _ : SortBool) : SortBool := false
+def zeroIntAt (_ : SortIntSeq) (_ : SortInt) : SortInt := 0
+def emptyIntVals (_ : SortIntSeq) : SortValSeq :=
