+  have bad := claimed.2 0 singleton7 (by rfl)
+  simp [
+    singleton7,
+    emptyIS,
+    zeroIntAt,
+    Proof.«intVals(_)_VERIFICATION_ValSeq_IntSeq»,
+    Proof.«valSeqAt(_,_)_MPY-SUBSCRIPT_Val_ValSeq_Int»
+  ] at bad
