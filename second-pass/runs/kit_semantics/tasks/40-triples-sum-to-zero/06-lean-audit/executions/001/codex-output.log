+        "producer_hashes_match": {
+            name: producer_files[name] == digest
+            for name, digest in source_manifest["files"].items()
+        },
+        "image_ids_match": image_id
+        == source_manifest["generator_image_id"]
+        == f"sha256:{producer_path_image}",
