+    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» (-2)
+      (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 5 emptyIS))
