+      Proof.«_<=Int_»
+      Proof.«intAt(_,_)_VERIFICATION_Int_IntSeq_Int»
+      Proof.«intVals(_)_VERIFICATION_ValSeq_IntSeq»
+      Proof.«isLen(_)_MPY-CORE_Int_IntSeq»
+      Proof.«valSeqAt(_,_)_MPY-SUBSCRIPT_Val_ValSeq_Int»
+      zeroVsLen := by
