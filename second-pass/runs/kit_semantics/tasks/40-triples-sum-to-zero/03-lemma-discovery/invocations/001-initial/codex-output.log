/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv=json.load(open('/reference/rule-inventory.json'))
out=json.load(open('/workspace/trust-boundary.json'))
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert set(out)=={'schema_version','inventory_sha256','rules'}, set(out)
assert out['schema_version']==2
assert out['inventory_sha256']==inv['inventory_sha256']
assert len(out['rules'])==len(inv['rules'])
for i,(a,b) in enumerate(zip(out['rules'],inv['rules'])):
    assert set(a)=={'source_rule_id','classification','rationale'}, (i,set(a))
    assert a['source_rule_id']==b['source_rule_id'], (i,a['source_rule_id'],b['source_rule_id'])
    assert a['classification'] in allowed, (i,a['classification'])
    assert isinstance(a['rationale'],str) and a['rationale'].strip(), i
    if 'simplification' in b.get('attributes',[]):
        assert a['classification'] in {'DEFINITION','DOMAIN_LEMMA'}, (i,a['classification'])
ids=[x['source_rule_id'] for x in out['rules']]
assert len(ids)==len(set(ids))
print('SCHEMA_VERSION',out['schema_version'])
print('INVENTORY_SHA256',out['inventory_sha256'])
print('RULES_VALIDATED',len(ids))
print('CLASSIFICATIONS',dict(Counter(x['classification'] for x in out['rules'])))
print('ORDER_AND_UNIQUENESS_OK')
PY
