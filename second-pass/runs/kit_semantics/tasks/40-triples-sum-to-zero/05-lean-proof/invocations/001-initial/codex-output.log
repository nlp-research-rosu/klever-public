diff --git a/lean_app_path_compat.c b/lean_app_path_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..641bda94d54691c1c880eb288ec5560a264622dd
--- /dev/null
+++ b/lean_app_path_compat.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn system_readlink = NULL;
+  if (system_readlink == NULL) {
+    system_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  size_t length = strlen(path);
+  if (length > 10 &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return system_readlink("/proc/self/exe", buffer, size);
+  }
+
+  return system_readlink(path, buffer, size);
+}

diff --git a/Check.lean b/Check.lean
new file mode 100644
index 0000000000000000000000000000000000000000..7780ee553c750744225210c1fe4da85e55a3ba7c
--- /dev/null
+++ b/Check.lean
@@ -0,0 +1,20 @@
+import Lean.Elab.Tactic.Omega
+import Klean40TriplesSumToZero.Lemmas
+
+example (index : Int) (nonnegative : 0 ≤ index) (zero : ¬ index = 0) :
+    index > 0 := by
+  omega
+
+example (index length : Int) (inBounds : index < 1 + length) :
+    index - 1 < length := by
+  omega
+
+example (index : SortInt) (nonnegative : 0 ≤ index) (zero : ¬ index = 0) :
+    index > 0 := by
+  change Int at index
+  omega
+
+example (index length : SortInt) (inBounds : index < 1 + length) :
+    index - 1 < length := by
+  change Int at index length
+  omega
