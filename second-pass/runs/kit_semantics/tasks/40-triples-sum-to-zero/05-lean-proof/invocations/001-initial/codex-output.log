      return (elan?, ← findLeanInstall?, lake)
    else
      let lean ← LeanInstall.get sysroot (collocated := true)
      let lake := LakeInstall.ofLean lean
      return (elan?, lean, lake)
  else
    return (elan?, ← findLeanInstall?, ← findLakeInstall?)
