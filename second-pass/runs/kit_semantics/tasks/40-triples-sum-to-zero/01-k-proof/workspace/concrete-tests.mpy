Module(
  FuncDef("triples_sum_to_zero", Params("l"),
    Assign(Name("found"), Bool(false))
    Assign(Name("i"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("k"), Int(0))
    While(Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("l")))),
      Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
      While(Compare(Name("j"), CmpOp("<", Call(Name("len"), Name("l")))),
        Assign(Name("k"), BinOp("+", Name("j"), Int(1)))
        While(Compare(Name("k"), CmpOp("<", Call(Name("len"), Name("l")))),
          If(Compare(
            BinOp(
              "+",
              BinOp(
                "+",
                Subscript(Name("l"), Name("i")),
                Subscript(Name("l"), Name("j"))),
              Subscript(Name("l"), Name("k"))),
            CmpOp("==", Int(0))),
            Assign(Name("found"), Bool(true)),
            )
          AugAssign(Name("k"), "+", Int(1)))
        Assign(Name("k"), Int(0))
        AugAssign(Name("j"), "+", Int(1)))
      Assign(Name("j"), Int(0))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("found")))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(Int(1), Int(3), Int(5), Int(0)))))
  Assert(
    Call(
      Name("triples_sum_to_zero"),
      ListExpr(Int(1), Int(3), UnaryOp("-", Int(2)), Int(1))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(Int(1), Int(2), Int(3), Int(7)))))
  Assert(
    Call(
      Name("triples_sum_to_zero"),
      ListExpr(
        Int(2),
        Int(4),
        UnaryOp("-", Int(5)),
        Int(3),
        Int(9),
        Int(7))))
  Assert(
    UnaryOp("not", Call(Name("triples_sum_to_zero"), ListExpr(Int(1)))))
  Assert(
    Call(Name("triples_sum_to_zero"), ListExpr(Int(0), Int(0), Int(0))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("triples_sum_to_zero"), ListExpr(Int(0), Int(0))))))
