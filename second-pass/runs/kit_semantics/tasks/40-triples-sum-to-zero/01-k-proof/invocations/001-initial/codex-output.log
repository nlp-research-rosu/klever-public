+    <env> 0 </env>
+    <scopes>
+        0 |-> scope(
+          "triples_sum_to_zero"
+            |-> closureVal(
+                  ("l", .ParamNames),
+                  Return(Bool(false)) .Stmts,
+                  0),
+          parent(-1))
+       -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      -1 |-> intSeqGhost(iCons(0, iCons(0, iCons(0, .IntSeq))))
+       0 |-> list(intVals(iCons(0, iCons(0, iCons(0, .IntSeq)))))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
