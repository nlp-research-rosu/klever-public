+        -1 |-> builtinsScope
+        1  |-> scope(
+          ( "l"     |-> ref(0)
+            "found" |-> (FOUND:Bool =>
+              FOUND orBool thirdFrom(IS, I, J, K))
+            "i"     |-> I:Int
+            "j"     |-> J:Int
+            "k"     |-> (K:Int => isLen(IS))
