index 0000000000000000000000000000000000000000..cb8b79d39e84ac74f5161da2e7633569e197047f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def triples_sum_to_zero(l: list):
+    found = False
+    i = 0
+    j = 0
+    k = 0
+    while i < len(l):
+        j = i + 1
+        while j < len(l):
+            k = j + 1
+            while k < len(l):
+                if l[i] + l[j] + l[k] == 0:
+                    found = True
+                k += 1
+            k = 0
+            j += 1
+        j = 0
+        i += 1
+    return found
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0e8c347376830256628751c7807477f0947081e8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,140 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Innermost loop circularity: all third indices k >= K.
+  claim [inner-loop]:
+    <k>
+      #while(innerCond(), innerBody())
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+        0  |-> scope(solutionBindings(), parent(-1))
+        -1 |-> builtinsScope
+        1  |-> scope(
+          ( "l"     |-> ref(0)
+            "found" |-> (FOUND:Bool =>
+              FOUND orBool thirdFrom(IS, I, J, K))
+            "i"     |-> I:Int
+            "j"     |-> J:Int
+            "k"     |-> (K:Int => isLen(IS))
+          ),
+          parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      -1 |-> intSeqGhost(IS:IntSeq)
+       0 |-> list(intVals(IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(CONT:K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I
+     andBool I <Int J
+     andBool J <Int K
+     andBool K <=Int isLen(IS)
+
+  // Middle loop circularity: all pairs j < k for one fixed first index i.
+  claim [middle-loop]:
+    <k>
+      #while(middleCond(), middleBody())
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+        0  |-> scope(solutionBindings(), parent(-1))
+        -1 |-> builtinsScope
+        1  |-> scope(
+          ( "l"     |-> ref(0)
+            "found" |-> (FOUND:Bool =>
+              FOUND orBool pairFrom(IS, I, J))
+            "i"     |-> I:Int
+            "j"     |-> (J:Int => isLen(IS))
+            "k"     |-> 0
+          ),
+          parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      -1 |-> intSeqGhost(IS:IntSeq)
+       0 |-> list(intVals(IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(CONT:K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I
+     andBool I <Int J
+     andBool J <=Int isLen(IS)
+
+  // Outer loop circularity: all increasing triples beginning at i >= I.
+  claim [outer-loop]:
+    <k>
+      #while(outerCond(), outerBody())
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+        0  |-> scope(solutionBindings(), parent(-1))
+        -1 |-> builtinsScope
+        1  |-> scope(
+          ( "l"     |-> ref(0)
+            "found" |-> (FOUND:Bool =>
+              FOUND orBool tripleFrom(IS, I))
+            "i"     |-> (I:Int => isLen(IS))
+            "j"     |-> 0
+            "k"     |-> 0
+          ),
+          parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      -1 |-> intSeqGhost(IS:IntSeq)
+       0 |-> list(intVals(IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(CONT:K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int isLen(IS)
+
+  // Required target theorem: the exact public entry call over an arbitrary
+  // finite integer sequence returns the increasing-index triple predicate.
+  claim [triples-sum-to-zero]:
+    <k>
+      Call(
+        Name("triples_sum_to_zero"),
+        (ref(0), .Exprs))
+      => tripleFrom(IS:IntSeq, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+        0  |-> scope(solutionBindings(), parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      -1 |-> intSeqGhost(IS)
+       0 |-> list(intVals(IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..eb3e311b64c5e1df2f8d7b1be7ea3f16535570d4
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,157 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+  imports MAP
+  imports LIST
+
+  // A bijective representation of arbitrary finite Python lists of integers.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq)                => .ValSeq
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
+
+  // Inert proof ghost used only to keep the symbolic IntSeq name stable when
+  // a circularity rematches the extensionally equal embedded heap value.
+  syntax Val ::= intSeqGhost(IntSeq)
+
+  // Total mathematical indexing.  Out-of-bounds cases are totalized to zero;
+  // the only connection to source indexing below is guarded in-bounds.
+  syntax Int ::= intAt(IntSeq, Int) [function, total, no-evaluators]
+  rule intAt(.IntSeq, _:Int) => 0
+  rule intAt(iCons(I:Int, _:IntSeq), 0) => I
+  rule intAt(iCons(_:Int, R:IntSeq), N:Int) => intAt(R, N -Int 1)
+    requires N >Int 0
+  rule intAt(iCons(_:Int, _:IntSeq), N:Int) => 0
+    requires N <Int 0
+
+  // Derived structural equations connecting that representation to the
+  // frozen semantics' length and in-bounds indexing functions.
+  rule vsLen(intVals(IS:IntSeq)) => isLen(IS) [simplification]
+  rule valSeqAt(intVals(IS:IntSeq), I:Int) => intAt(IS, I)
+    requires 0 <=Int I andBool I <Int isLen(IS)
+    [simplification]
+
+  // The result specification as three nested bounded existentials over
+  // strictly increasing indices.
+  syntax Bool ::= thirdFrom(IntSeq, Int, Int, Int) [function, total]
+                | pairFrom(IntSeq, Int, Int)       [function, total]
+                | tripleFrom(IntSeq, Int)          [function, total]
+
+  rule thirdFrom(IS:IntSeq, I:Int, J:Int, K:Int) => false
+    requires I <Int 0
+      orBool J <=Int I
+      orBool K <=Int J
+      orBool I >=Int isLen(IS)
+      orBool J >=Int isLen(IS)
+  rule thirdFrom(IS:IntSeq, I:Int, J:Int, K:Int) => false
+    requires 0 <=Int I
+      andBool I <Int J
+      andBool J <Int K
+      andBool J <Int isLen(IS)
+      andBool K >=Int isLen(IS)
+  rule thirdFrom(IS:IntSeq, I:Int, J:Int, K:Int)
+    => ((intAt(IS, I) +Int intAt(IS, J) +Int intAt(IS, K))
+          ==Int 0)
+       orBool thirdFrom(IS, I, J, K +Int 1)
+    requires 0 <=Int I
+      andBool I <Int J
+      andBool J <Int K
+      andBool K <Int isLen(IS)
+
+  rule pairFrom(IS:IntSeq, I:Int, J:Int) => false
+    requires I <Int 0
+      orBool J <=Int I
+      orBool I >=Int isLen(IS)
+  rule pairFrom(IS:IntSeq, I:Int, J:Int) => false
+    requires 0 <=Int I
+      andBool I <Int J
+      andBool J >=Int isLen(IS)
+  rule pairFrom(IS:IntSeq, I:Int, J:Int)
+    => thirdFrom(IS, I, J, J +Int 1)
+       orBool pairFrom(IS, I, J +Int 1)
+    requires 0 <=Int I
+      andBool I <Int J
+      andBool J <Int isLen(IS)
+
+  rule tripleFrom(_:IntSeq, I:Int) => false
+    requires I <Int 0
+  rule tripleFrom(IS:IntSeq, I:Int) => false
+    requires I >=Int isLen(IS)
+  rule tripleFrom(IS:IntSeq, I:Int)
+    => pairFrom(IS, I, I +Int 1)
+       orBool tripleFrom(IS, I +Int 1)
+    requires 0 <=Int I andBool I <Int isLen(IS)
+
+  // Exact syntax-level abbreviations for the source loop terms and body.
+  syntax Expr ::= innerCond()  [function, total]
+                | middleCond() [function, total]
+                | outerCond()  [function, total]
+  syntax Stmts ::= innerBody()   [function, total]
+                 | middleBody()  [function, total]
+                 | outerBody()   [function, total]
+                 | programBody() [function, total]
+
+  rule innerCond() =>
+    Compare(
+      Name("k"),
+      CmpOp("<", Call(Name("len"), (Name("l"), .Exprs))))
+
+  rule innerBody() =>
+    If(
+      Compare(
+        BinOp(
+          "+",
+          BinOp(
+            "+",
+            Subscript(Name("l"), Name("i")),
+            Subscript(Name("l"), Name("j"))),
+          Subscript(Name("l"), Name("k"))),
+        CmpOp("==", Int(0))),
+      Assign(Name("found"), Bool(true)) .Stmts,
+      .Stmts)
+    AugAssign(Name("k"), "+", Int(1))
+    .Stmts
+
+  rule middleCond() =>
+    Compare(
+      Name("j"),
+      CmpOp("<", Call(Name("len"), (Name("l"), .Exprs))))
+
+  rule middleBody() =>
+    Assign(Name("k"), BinOp("+", Name("j"), Int(1)))
+    While(innerCond(), innerBody())
+    Assign(Name("k"), Int(0))
+    AugAssign(Name("j"), "+", Int(1))
+    .Stmts
+
+  rule outerCond() =>
+    Compare(
+      Name("i"),
+      CmpOp("<", Call(Name("len"), (Name("l"), .Exprs))))
+
+  rule outerBody() =>
+    Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+    While(middleCond(), middleBody())
+    Assign(Name("j"), Int(0))
+    AugAssign(Name("i"), "+", Int(1))
+    .Stmts
+
+  rule programBody() =>
+    Assign(Name("found"), Bool(false))
+    Assign(Name("i"), Int(0))
+    Assign(Name("j"), Int(0))
+    Assign(Name("k"), Int(0))
+    While(outerCond(), outerBody())
+    Return(Name("found"))
+    .Stmts
+
+  syntax Val ::= triplesClosure() [function, total]
+  rule triplesClosure() =>
+    closureVal(("l", .ParamNames), programBody(), 0)
+
+  syntax Map ::= solutionBindings() [function, total]
+  rule solutionBindings() =>
+    "triples_sum_to_zero" |-> triplesClosure()
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..505d1c3db038d458ac5ea2312dd4464290f546f2
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,27 @@
+def triples_sum_to_zero(l: list):
+    found = False
+    i = 0
+    j = 0
+    k = 0
+    while i < len(l):
+        j = i + 1
+        while j < len(l):
+            k = j + 1
+            while k < len(l):
+                if l[i] + l[j] + l[k] == 0:
+                    found = True
+                k += 1
+            k = 0
+            j += 1
+        j = 0
+        i += 1
+    return found
+
+
+assert not triples_sum_to_zero([1, 3, 5, 0])
+assert triples_sum_to_zero([1, 3, -2, 1])
+assert not triples_sum_to_zero([1, 2, 3, 7])
+assert triples_sum_to_zero([2, 4, -5, 3, 9, 7])
+assert not triples_sum_to_zero([1])
+assert triples_sum_to_zero([0, 0, 0])
+assert not triples_sum_to_zero([0, 0])
