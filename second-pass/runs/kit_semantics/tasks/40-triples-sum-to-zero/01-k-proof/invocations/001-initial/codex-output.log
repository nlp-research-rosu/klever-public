diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..816a184b2bdcc5be062ff58bdf9140e6f94c3442
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,160 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+  imports MAP
+  imports LIST
+
+  // A bijective representation of arbitrary finite Python lists of integers.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq)                => .ValSeq
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
+
+  // Derived structural equations connecting that representation to the
+  // frozen semantics' length and in-bounds indexing functions.
+  rule vsLen(intVals(IS:IntSeq)) => isLen(IS) [simplification]
+  rule valSeqAt(intVals(IS:IntSeq), I:Int) => intSeqAt(IS, I)
+    requires 0 <=Int I andBool I <Int isLen(IS)
+    [simplification]
+
+  // The result specification.  The three functions are nested bounded
+  // existentials over increasing indices:
+  //   valueFrom:  exists k >= START with l[k] == TARGET
+  //   pairFrom:   exists START <= j < k with l[j] + l[k] == TARGET
+  //   tripleFrom: exists START <= i < j < k with l[i] + l[j] + l[k] == 0
+  syntax Bool ::= valueFrom(IntSeq, Int, Int) [function, total]
+                | pairFrom(IntSeq, Int, Int)  [function, total]
+                | tripleFrom(IntSeq, Int)     [function, total]
+
+  rule valueFrom(_:IntSeq, START:Int, _:Int) => false
+    requires START <Int 0
+  rule valueFrom(IS:IntSeq, START:Int, _:Int) => false
+    requires START >=Int isLen(IS)
+  rule valueFrom(IS:IntSeq, START:Int, TARGET:Int)
+    => (intSeqAt(IS, START) ==Int TARGET)
+       orBool valueFrom(IS, START +Int 1, TARGET)
+    requires 0 <=Int START andBool START <Int isLen(IS)
+
+  rule pairFrom(_:IntSeq, START:Int, _:Int) => false
+    requires START <Int 0
+  rule pairFrom(IS:IntSeq, START:Int, _:Int) => false
+    requires START >=Int isLen(IS)
+  rule pairFrom(IS:IntSeq, START:Int, TARGET:Int)
+    => valueFrom(IS, START +Int 1, TARGET -Int intSeqAt(IS, START))
+       orBool pairFrom(IS, START +Int 1, TARGET)
+    requires 0 <=Int START andBool START <Int isLen(IS)
+
+  rule tripleFrom(_:IntSeq, START:Int) => false
+    requires START <Int 0
+  rule tripleFrom(IS:IntSeq, START:Int) => false
+    requires START >=Int isLen(IS)
+  rule tripleFrom(IS:IntSeq, START:Int)
+    => pairFrom(IS, START +Int 1, 0 -Int intSeqAt(IS, START))
+       orBool tripleFrom(IS, START +Int 1)
+    requires 0 <=Int START andBool START <Int isLen(IS)
+
+  // Exact syntax-level abbreviations for the four program-defined closures.
+  // These do not replace execution; every body is executed by the claims.
+  syntax Val ::= hasValueClosure() [function, total]
+               | hasPairClosure() [function, total]
+               | hasTripleClosure() [function, total]
+               | triplesClosure() [function, total]
+
+  rule hasValueClosure() =>
+    closureVal(
+      ("l", "start", "target", .ParamNames),
+      If(
+        Compare(
+          Name("start"),
+          CmpOp(">=", Call(Name("len"), (Name("l"), .Exprs)))),
+        Return(Bool(false)) .Stmts,
+        .Stmts)
+      If(
+        Compare(
+          Subscript(Name("l"), Name("start")),
+          CmpOp("==", Name("target"))),
+        Return(Bool(true)) .Stmts,
+        .Stmts)
+      Return(
+        Call(
+          Name("_has_value"),
+          ( Name("l")
+          , BinOp("+", Name("start"), Int(1))
+          , Name("target")
+          , .Exprs))) .Stmts,
+      0)
+
+  rule hasPairClosure() =>
+    closureVal(
+      ("l", "start", "target", .ParamNames),
+      If(
+        Compare(
+          Name("start"),
+          CmpOp(">=", Call(Name("len"), (Name("l"), .Exprs)))),
+        Return(Bool(false)) .Stmts,
+        .Stmts)
+      If(
+        Call(
+          Name("_has_value"),
+          ( Name("l")
+          , BinOp("+", Name("start"), Int(1))
+          , BinOp(
+              "-",
+              Name("target"),
+              Subscript(Name("l"), Name("start")))
+          , .Exprs)),
+        Return(Bool(true)) .Stmts,
+        .Stmts)
+      Return(
+        Call(
+          Name("_has_pair"),
+          ( Name("l")
+          , BinOp("+", Name("start"), Int(1))
+          , Name("target")
+          , .Exprs))) .Stmts,
+      0)
+
+  rule hasTripleClosure() =>
+    closureVal(
+      ("l", "start", .ParamNames),
+      If(
+        Compare(
+          Name("start"),
+          CmpOp(">=", Call(Name("len"), (Name("l"), .Exprs)))),
+        Return(Bool(false)) .Stmts,
+        .Stmts)
+      If(
+        Call(
+          Name("_has_pair"),
+          ( Name("l")
+          , BinOp("+", Name("start"), Int(1))
+          , UnaryOp("-", Subscript(Name("l"), Name("start")))
+          , .Exprs)),
+        Return(Bool(true)) .Stmts,
+        .Stmts)
+      Return(
+        Call(
+          Name("_has_triple"),
+          ( Name("l")
+          , BinOp("+", Name("start"), Int(1))
+          , .Exprs))) .Stmts,
+      0)
+
+  rule triplesClosure() =>
+    closureVal(
+      ("l", .ParamNames),
+      Return(
+        Call(
+          Name("_has_triple"),
+          (Name("l"), Int(0), .Exprs))) .Stmts,
+      0)
+
+  syntax Map ::= solutionBindings() [function, total]
+  rule solutionBindings() =>
+      "_has_value"           |-> hasValueClosure()
+      "_has_pair"            |-> hasPairClosure()
+      "_has_triple"          |-> hasTripleClosure()
+      "triples_sum_to_zero"  |-> triplesClosure()
+endmodule

