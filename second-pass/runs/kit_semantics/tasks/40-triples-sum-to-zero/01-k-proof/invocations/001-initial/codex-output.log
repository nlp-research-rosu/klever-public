+  claim [triples-sum-to-zero]:
+    <k>
+      Call(
+        Name("triples_sum_to_zero"),
+        (ref(0), .Exprs))
+      => tripleFrom(IS:IntSeq, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+        0  |-> scope(solutionBindings(), parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> 0 |-> list(intVals(IS)) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
