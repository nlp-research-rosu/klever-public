+        Return(Bool(true)) .Stmts,
+        .Stmts)
+      Return(
+        Call(
+          Name("_has_triple"),
+          ( Name("l")
+          , BinOp("+", Name("start"), Int(1))
+          , .Exprs))) .Stmts,
