+            "found" |-> (FOUND:Bool =>
+              FOUND orBool pairFrom(IS, I, J))
+            "i"     |-> I:Int
+            "j"     |-> (J:Int => isLen(IS))
+            "k"     |-> 0
+          ),
+          parent(0))
+    </scopes>
