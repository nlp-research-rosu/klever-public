+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+        0  |-> scope(solutionBindings(), parent(-1))
+        -1 |-> builtinsScope
+        1  |-> scope(
+          ( "l"     |-> ref(0)
+            "found" |-> (FOUND:Bool =>
+              FOUND orBool tripleFrom(IS, I))
+            "i"     |-> (I:Int => isLen(IS))
+            "j"     |-> 0
+            "k"     |-> 0
+          ),
+          parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      -1 |-> intSeqGhost(IS:IntSeq)
+       0 |-> list(intVals(IS))
+    </heap>
