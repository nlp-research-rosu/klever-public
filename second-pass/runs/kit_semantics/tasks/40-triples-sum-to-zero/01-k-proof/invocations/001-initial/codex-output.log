+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      -1 |-> intSeqGhost(IS:IntSeq)
+       0 |-> list(intVals(IS))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(CONT:K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I
