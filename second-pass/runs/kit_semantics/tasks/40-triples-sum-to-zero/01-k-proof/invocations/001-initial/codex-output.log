+          , BinOp(
+              "-",
+              Name("target"),
+              Subscript(Name("l"), Name("start")))
+          , .Exprs)),
+        Return(Bool(true)) .Stmts,
+        .Stmts)
+      Return(
+        Call(
+          Name("_has_pair"),
+          ( Name("l")
+          , BinOp("+", Name("start"), Int(1))
+          , Name("target")
+          , .Exprs))) .Stmts,
+      0)
+
+  rule hasTripleClosure() =>
+    closureVal(
+      ("l", "start", .ParamNames),
+      If(
+        Compare(
+          Name("start"),
+          CmpOp(">=", Call(Name("len"), (Name("l"), .Exprs)))),
