+  syntax Bool ::= valueFrom(IntSeq, Int, Int) [function, total]
+                | pairFrom(IntSeq, Int, Int)  [function, total]
+                | tripleFrom(IntSeq, Int)     [function, total]
+
+  rule valueFrom(_:IntSeq, START:Int, _:Int) => false
+    requires START <Int 0
+  rule valueFrom(IS:IntSeq, START:Int, _:Int) => false
+    requires START >=Int isLen(IS)
+  rule valueFrom(IS:IntSeq, START:Int, TARGET:Int)
+    => (intSeqAt(IS, START) ==Int TARGET)
+       orBool valueFrom(IS, START +Int 1, TARGET)
+    requires 0 <=Int START andBool START <Int isLen(IS)
+
+  rule pairFrom(_:IntSeq, START:Int, _:Int) => false
+    requires START <Int 0
+  rule pairFrom(IS:IntSeq, START:Int, _:Int) => false
+    requires START >=Int isLen(IS)
+  rule pairFrom(IS:IntSeq, START:Int, TARGET:Int)
+    => valueFrom(IS, START +Int 1, TARGET -Int intSeqAt(IS, START))
+       orBool pairFrom(IS, START +Int 1, TARGET)
+    requires 0 <=Int START andBool START <Int isLen(IS)
+
+  rule tripleFrom(_:IntSeq, START:Int) => false
