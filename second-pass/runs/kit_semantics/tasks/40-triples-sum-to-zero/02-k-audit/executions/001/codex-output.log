diff --git a/evidence/connection-opposite-spec.k b/evidence/connection-opposite-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7936fc92947d9b6c88ac6a7556805a5e9833e68e
--- /dev/null
+++ b/evidence/connection-opposite-spec.k
@@ -0,0 +1,14 @@
+requires "connection-verification.k"
+
+module CONNECTION-OPPOSITE-SPEC
+  imports CONNECTION-VERIFICATION
