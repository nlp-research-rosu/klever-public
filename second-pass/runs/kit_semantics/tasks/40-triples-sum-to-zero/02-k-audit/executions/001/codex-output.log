+def _has_value(l: list, start: int, target: int):
+    if start >= len(l):
+        return False
+    if l[start] == target:
+        return True
+    return _has_value(l, start + 1, target)
+
+
+def _has_pair(l: list, start: int, target: int):
+    if start >= len(l):
+        return False
+    if _has_value(l, start + 1, target - l[start]):
+        return True
+    return _has_pair(l, start + 1, target)
+
+
+def _has_triple(l: list, start: int):
+    if start >= len(l):
+        return False
+    if _has_pair(l, start + 1, -l[start]):
+        return True
+    return _has_triple(l, start + 1)
+
+
+def triples_sum_to_zero(l: list):
+    return _has_triple(l, 0)
*** End Patch

