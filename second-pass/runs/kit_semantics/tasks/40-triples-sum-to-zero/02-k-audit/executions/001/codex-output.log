     1	def triples_sum_to_zero(l: list):
     2	    found = False
     3	    i = 0
     4	    j = 0
     5	    k = 0
     6	    while i < len(l):
     7	        j = i + 1
     8	        while j < len(l):
     9	            k = j + 1
    10	            while k < len(l):
    11	                if l[i] + l[j] + l[k] == 0:
    12	                    found = True
    13	                k += 1
    14	            k = 0
    15	            j += 1
    16	        j = 0
    17	        i += 1
    18	    return found

