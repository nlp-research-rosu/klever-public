+    <heap>
+      ( 0 |-> list(INPUT:ValSeq)
+        1 |-> list(ACC:ValSeq)
+      =>
+        0 |-> list(INPUT)
+        1 |-> list(dedupFromVS(VS, ACC))
+        2 |-> list(sortVS(dedupFromVS(VS, ACC)))
+      )
+    </heap>
+    <heapLoc> 2 => 3 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
