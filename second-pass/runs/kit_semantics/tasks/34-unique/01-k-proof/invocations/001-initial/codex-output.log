+                    Name("x"))),
+                  .Stmts))
+              Return(Call(Name("sorted"), Name("result")))
+              .Stmts,
+              0) ],
+          parent(-1))
+        1 |-> scope(
+          .Map
+            [ "l"      <- ref(0) ]
+            [ "result" <- ref(1) ]
+            [ "x"      <- X:Val ],
+          parent(0))
+      =>
