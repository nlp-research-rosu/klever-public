+  // The arbitrary VS and ACC make this an unbounded loop circularity.
+  claim [unique-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      ~> Return(Call(Name("sorted"), Name("result")))
+      ~> #endcall
+      => ref(2)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          .Map [
+            "unique" <- closureVal(
+              ("l", .ParamNames),
+              Expr(Str("Return sorted unique elements in a list."))
+              Assign(Name("result"), ListExpr(.Exprs))
+              Assign(Name("x"), NoneVal)
+              For(
+                Name("x"),
+                Name("l"),
+                If(
+                  Compare(Name("x"), CmpOp("not in", Name("result"))),
+                  Expr(Call(
+                    Attribute(Name("result"), "append"),
+                    Name("x"))),
+                  .Stmts))
+              Return(Call(Name("sorted"), Name("result")))
+              .Stmts,
+              0) ],
+          parent(-1))
+        1 |-> scope(
+          .Map
+            [ "l"      <- ref(0) ]
+            [ "result" <- ref(1) ]
+            [ "x"      <- X:Val ],
+          parent(0))
+      =>
+        -1 |-> builtinsScope
+        0 |-> scope(
+          .Map [
+            "unique" <- closureVal(
+              ("l", .ParamNames),
+              Expr(Str("Return sorted unique elements in a list."))
+              Assign(Name("result"), ListExpr(.Exprs))
+              Assign(Name("x"), NoneVal)
+              For(
+                Name("x"),
+                Name("l"),
+                If(
+                  Compare(Name("x"), CmpOp("not in", Name("result"))),
+                  Expr(Call(
+                    Attribute(Name("result"), "append"),
+                    Name("x"))),
+                  .Stmts))
+              Return(Call(Name("sorted"), Name("result")))
+              .Stmts,
+              0) ],
+          parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(INPUT:ValSeq)
+        1 |-> list(ACC:ValSeq)
+      =>
