+                  Attribute(Name("result"), "append"),
+                  Name("x"))),
+                .Stmts))
+            Return(Call(Name("sorted"), Name("result")))
+            .Stmts,
+            0) ],
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(INPUT:ValSeq)
+      =>
+        0 |-> list(INPUT)
+        1 |-> list(dedupFromVS(INPUT, .ValSeq))
+        2 |-> list(sortVS(dedupFromVS(INPUT, .ValSeq)))
+      )
+    </heap>
+    <heapLoc> 1 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
