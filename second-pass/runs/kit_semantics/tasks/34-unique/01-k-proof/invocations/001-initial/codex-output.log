+                  Compare(Name("x"), CmpOp("not in", Name("result"))),
+                  Expr(Call(
+                    Attribute(Name("result"), "append"),
+                    Name("x"))),
+                  .Stmts))
+              Return(Call(Name("sorted"), Name("result")))
+              .Stmts,
+              0) ],
+          parent(-1))
+        1 |-> scope(
+          .Map
+            [ "l"      <- ref(0) ]
+            [ "result" <- ref(1) ]
+            [ "x"      <- X:Val ],
+          parent(0))
+      =>
+        -1 |-> builtinsScope
+        0 |-> scope(
+          .Map [
+            "unique" <- closureVal(
+              ("l", .ParamNames),
