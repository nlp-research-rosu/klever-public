@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutated body: the append statement has been removed, while
+  // the claim still asks for the original result.  The original loop bridge
+  // must not match this body.
+  claim [removed-append]:
+    <k> Call(Name("unique"), ref(0)) => ref(2) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        .Map [
+          "unique" <- closureVal(
+            ("l", .ParamNames),
+            Expr(Str("Return sorted unique elements in a list."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("x"), NoneVal)
+            For(
+              Name("x"),
+              Name("l"),
+              If(
+                Compare(Name("x"), CmpOp("not in", Name("result"))),
+                .Stmts,
+                .Stmts))
+            Return(Call(Name("sorted"), Name("result")))
+            .Stmts,
+            0) ],
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(vCons(2, vCons(1, vCons(2, .ValSeq))))
+      =>
+        0 |-> list(vCons(2, vCons(1, vCons(2, .ValSeq))))
+        1 |-> list(vCons(2, vCons(1, .ValSeq)))
+        2 |-> list(vCons(1, vCons(2, .ValSeq)))
+      )
+    </heap>
+    <heapLoc> 1 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..a2f20556403ae9c56398e5a7943b3505d46ed375
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: unique([2, 1, 2]) is [1, 2], not [2, 1].
+  claim [false-result]:
+    <k> Call(Name("unique"), ref(0)) => ref(2) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        .Map [
+          "unique" <- closureVal(
+            ("l", .ParamNames),
+            Expr(Str("Return sorted unique elements in a list."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("x"), NoneVal)
+            For(
+              Name("x"),
+              Name("l"),
+              If(
+                Compare(Name("x"), CmpOp("not in", Name("result"))),
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  Name("x"))),
+                .Stmts))
+            Return(Call(Name("sorted"), Name("result")))
+            .Stmts,
+            0) ],
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(vCons(2, vCons(1, vCons(2, .ValSeq))))
+      =>
+        0 |-> list(vCons(2, vCons(1, vCons(2, .ValSeq))))
+        1 |-> list(vCons(2, vCons(1, .ValSeq)))
+        2 |-> list(vCons(2, vCons(1, .ValSeq)))
+      )
+    </heap>
+    <heapLoc> 1 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d724326f4c81b2ad8e2853b8970d8ed536f44b1f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,87 @@
+requires "verification.k"
+
+module MEMBER-SPEC
+  imports VERIFICATION-BASE
+
+  // Fixed-semantics execution theorem for list membership.  This is a
+  // circularity over the input sequence, not a rule that replaces execution.
+  claim [member-summary]:
+    <k> #memberAcc(V:Val, list(VS:ValSeq))
+      => memberVS(V, VS) ... </k>
+endmodule
+
+module LOOP-SPEC
+  imports VERIFICATION-MEMBER
+
+  // The exact source for-loop with an arbitrary continuation.  The arbitrary
+  // VS and ACC make this an unbounded loop circularity.
+  claim [unique-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ... 1 |-> scope(
+        ("l" |-> ref(0))
+        ("result" |-> ref(1))
+        ("x" |-> (X:Val => lastFromVS(VS, X))),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ... 1 |-> list(ACC:ValSeq => dedupFromVS(VS, ACC)) ...
+    </heap>
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  // Required target theorem: invoke the exact generated function closure on
+  // an arbitrary finite ValSeq stored as a Python list object.
+  claim [unique-full-domain]:
+    <k> Call(Name("unique"), ref(0)) => ref(2) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        .Map [
+          "unique" <- closureVal(
+            ("l", .ParamNames),
+            Expr(Str("Return sorted unique elements in a list."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("x"), NoneVal)
+            For(
+              Name("x"),
+              Name("l"),
+              If(
+                Compare(Name("x"), CmpOp("not in", Name("result"))),
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  Name("x"))),
+                .Stmts))
+            Return(Call(Name("sorted"), Name("result")))
+            .Stmts,
+            0) ],
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(INPUT:ValSeq)
+      =>
+        0 |-> list(INPUT)
+        1 |-> list(dedupFromVS(INPUT, .ValSeq))
+        2 |-> list(sortVS(dedupFromVS(INPUT, .ValSeq)))
+      )
+    </heap>
+    <heapLoc> 1 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..09b522716e764d7e3ef57086f8d26fc2224a8c3b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,76 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // Exact mathematical summary of MPY-LIST's #memberAcc fold.
+  syntax Bool ::= memberVS(Val, ValSeq) [function, total]
+  rule memberVS(_:Val, .ValSeq) => false
+  rule memberVS(V:Val, vCons(E:Val, R:ValSeq)) => memberVS(V, R)
+    requires notBool (V ==K E)
+    [simplification]
+  rule memberVS(V:Val, vCons(E:Val, _:ValSeq)) => true
+    requires V ==K E
+    [simplification]
+
+  // Append V precisely when it is not already present in ACC.
+  syntax ValSeq ::= appendUnique(ValSeq, Val) [function, total]
+  rule appendUnique(ACC:ValSeq, V:Val) => ACC
+    requires memberVS(V, ACC)
+  rule appendUnique(ACC:ValSeq, V:Val)
+    => valSeqConcat(ACC, vCons(V, .ValSeq))
+    requires notBool memberVS(V, ACC)
+
+  // First-seen-order deduplication, parameterized by the current accumulator.
+  syntax ValSeq ::= dedupFromVS(ValSeq, ValSeq) [function, total]
+  rule dedupFromVS(.ValSeq, ACC:ValSeq) => ACC
+  rule dedupFromVS(vCons(V:Val, R:ValSeq), ACC:ValSeq)
+    => dedupFromVS(R, appendUnique(ACC, V))
+
+  // Value left in the source for-loop target after consuming VS.
+  syntax Val ::= lastFromVS(ValSeq, Val) [function, total]
+  rule lastFromVS(.ValSeq, X:Val) => X
+  rule lastFromVS(vCons(V:Val, R:ValSeq), _:Val) => lastFromVS(R, V)
+endmodule
+
+module VERIFICATION-MEMBER
+  imports VERIFICATION-BASE
+
+  // Operational bridge admitted only after MEMBER-SPEC proves the identical
+  // arbitrary-continuation theorem using VERIFICATION-BASE (without this rule).
+  rule <k> #memberAcc(V:Val, list(VS:ValSeq))
+    => memberVS(V, VS) ... </k>
+    [priority(40)]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-MEMBER
+
+  // Operational bridge admitted only after LOOP-SPEC proves the identical
+  // arbitrary-continuation loop theorem using VERIFICATION-MEMBER (without
+  // this rule).  Return, sorted(), allocation, and frame-pop still execute.
+  rule
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ... 1 |-> scope(
+        ("l" |-> ref(0))
+        ("result" |-> ref(1))
+        ("x" |-> (X:Val => lastFromVS(VS, X))),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ... 1 |-> list(ACC:ValSeq => dedupFromVS(VS, ACC)) ...
+    </heap>
+    [priority(40)]
+endmodule

diff --git a/bridge-probes.k b/bridge-probes.k
new file mode 100644
index 0000000000000000000000000000000000000000..6d6068f0793b3980dc1ed6513d22d73efe681e99
--- /dev/null
+++ b/bridge-probes.k
@@ -0,0 +1,105 @@
+requires "verification.k"
+
+module MEMBER-PROBE-BASE
+  imports VERIFICATION-BASE
+
+  claim [present-continuation]:
+    <k>
+      #memberAcc(
+        2,
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))))
+      ~> #notB
+      => false
+    </k>
+
+  claim [absent-continuation]:
+    <k>
+      #memberAcc(
+        4,
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))))
+      ~> #notB
+      => true
+    </k>
+endmodule
+
+module MEMBER-PROBE-BRIDGED
+  imports VERIFICATION-MEMBER
+
+  claim [present-continuation]:
+    <k>
+      #memberAcc(
+        2,
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))))
+      ~> #notB
+      => false
+    </k>
+
+  claim [absent-continuation]:
+    <k>
+      #memberAcc(
+        4,
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))))
+      ~> #notB
+      => true
+    </k>
+endmodule
+
+module LOOP-PROBE-FIXED
+  imports VERIFICATION-MEMBER
+
+  claim [observable-continuation]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(1, vCons(2, .ValSeq)))),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      ~> Assign(Name("x"), Int(99))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("l" |-> ref(0))
+        ("result" |-> ref(1))
+        ("x" |-> (noneV => 99)),
+        parent(0))
+    </scopes>
+    <heap>
+      1 |-> list(
+        .ValSeq
+        => vCons(2, vCons(1, .ValSeq)))
+    </heap>
+endmodule
+
+module LOOP-PROBE-BRIDGED
+  imports VERIFICATION
+
+  claim [observable-continuation]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(1, vCons(2, .ValSeq)))),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      ~> Assign(Name("x"), Int(99))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("l" |-> ref(0))
+        ("result" |-> ref(1))
+        ("x" |-> (noneV => 99)),
+        parent(0))
+    </scopes>
+    <heap>
+      1 |-> list(
+        .ValSeq
+        => vCons(2, vCons(1, .ValSeq)))
+    </heap>
+endmodule
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..cfa5d24d1469c56e54326a0fd5f703bdff9046ec
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,21 @@
+from solution import unique
+
+
+CASES = [
+    [],
+    [5, 3, 5, 2, 3, 3, 9, 0, 123],
+    ["b", "a", "b", "c", "a"],
+    [True, 1],
+    [True, 1, 0, False, 2],
+    [3.0, 2, 2.0, 3],
+    [-4, 7, -4, 0, 7, -1],
+]
+
+
+for case in CASES:
+    expected = sorted(set(case))
+    actual = unique(case)
+    assert actual == expected, (case, expected, actual)
+    print(f"{case!r} -> {actual!r}")
+
+print(f"CPYTHON_MISMATCHES=0 CASES={len(CASES)}")
diff --git a/concrete_tests_k.py b/concrete_tests_k.py
new file mode 100644
index 0000000000000000000000000000000000000000..1dcad4162de29ead9327acb06e10d8b9e3d5dac2
--- /dev/null
+++ b/concrete_tests_k.py
@@ -0,0 +1,17 @@
+def unique(l: list):
+    """Return sorted unique elements in a list."""
+    result = []
+    x = None
+    for x in l:
+        if x not in result:
+            result.append(x)
+    return sorted(result)
+
+
+assert unique([]) == []
+assert unique([5, 3, 5, 2, 3, 3, 9, 0, 123]) == [0, 2, 3, 5, 9, 123]
+assert unique(["b", "a", "b", "c", "a"]) == ["a", "b", "c"]
+assert unique([True, 1]) == [True]
+assert unique([True, 1, 0, False, 2]) == [0, True, 2]
+assert unique([3.0, 2, 2.0, 3]) == [2, 3.0]
+assert unique([-4, 7, -4, 0, 7, -1]) == [-4, -1, 0, 7]
diff --git a/model-boundary.k b/model-boundary.k
new file mode 100644
index 0000000000000000000000000000000000000000..fdf4892dc9a29a4766a99a29cf3305c606a8a69f
--- /dev/null
+++ b/model-boundary.k
@@ -0,0 +1,16 @@
+requires "verification.k"
+
+module MODEL-BOUNDARY
+  imports VERIFICATION-BASE
+
+  // The symbolic MPY list-membership model uses structural K equality, so
+  // Bool(true) and Int(1) remain distinct here.  MPY-KRUN's concrete-only
+  // numOrKEq rule instead matches CPython and collapses them.
+  claim [symbolic-bool-int-distinct]:
+    <k>
+      dedupFromVS(
+        vCons(true, vCons(1, .ValSeq)),
+        .ValSeq)
+      => vCons(true, vCons(1, .ValSeq))
+    </k>
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..64d87420fe43c84706aac7772856ac98ef4641f4
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,86 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translator identity and concrete execution.
+python3 py2mpy.py solution.py > solution.mpy
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun smoke.mpy --definition runtime-kompiled
+
+# Independent CPython oracle and matching LLVM cases.
+python3 concrete_tests.py
+python3 py2mpy.py concrete_tests_k.py > concrete-tests.mpy
+krun concrete-tests.mpy --definition runtime-kompiled
+
+# Stage 1: prove the membership connection without its bridge.
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION-BASE \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-base-kompiled
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --spec-module MEMBER-SPEC
+
+# Stage 2: use only the proved membership bridge to prove the source loop.
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION-MEMBER \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-member-kompiled
+kprove spec.k \
+  --definition verification-member-kompiled \
+  --spec-module LOOP-SPEC
+
+# Stage 3: use both proved bridges for the full unbounded-domain target.
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+# Fixed-versus-bridged value and continuation probes.
+kprove bridge-probes.k \
+  --definition verification-base-kompiled \
+  --spec-module MEMBER-PROBE-BASE
+kprove bridge-probes.k \
+  --definition verification-member-kompiled \
+  --spec-module MEMBER-PROBE-BRIDGED
+kprove bridge-probes.k \
+  --definition verification-member-kompiled \
+  --spec-module LOOP-PROBE-FIXED
+kprove bridge-probes.k \
+  --definition verification-kompiled \
+  --spec-module LOOP-PROBE-BRIDGED
+
+# Reproducible witness for the symbolic/concrete numeric-equality boundary.
+kprove model-boundary.k \
+  --definition verification-base-kompiled \
+  --spec-module MODEL-BOUNDARY
+
+# Negative validation probes: both commands must fail.
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY > vacuity.log 2>&1
+vacuity_rc=$?
+kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION > body-mutation.log 2>&1
+body_mutation_rc=$?
+set -e
+
+if [[ "$vacuity_rc" -eq 0 ]]; then
+  echo "ERROR: false-result mutation unexpectedly proved"
+  exit 1
+fi
+if [[ "$body_mutation_rc" -eq 0 ]]; then
+  echo "ERROR: removed-append mutation unexpectedly proved"
+  exit 1
+fi
+
+echo "EXPECTED_FAILURE spec-vacuity.k exit=$vacuity_rc"
+echo "EXPECTED_FAILURE spec-body-mutation.k exit=$body_mutation_rc"
