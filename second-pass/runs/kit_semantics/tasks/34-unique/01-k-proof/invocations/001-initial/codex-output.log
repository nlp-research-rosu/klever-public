@@ -0,0 +1,105 @@
+requires "verification.k"
+
+module MEMBER-PROBE-BASE
+  imports VERIFICATION-BASE
+
+  claim [present-continuation]:
+    <k>
+      #memberAcc(
+        2,
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))))
+      ~> #notB
+      => false
+    </k>
+
+  claim [absent-continuation]:
+    <k>
+      #memberAcc(
+        4,
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))))
+      ~> #notB
+      => true
+    </k>
+endmodule
+
+module MEMBER-PROBE-BRIDGED
+  imports VERIFICATION-MEMBER
+
+  claim [present-continuation]:
+    <k>
+      #memberAcc(
+        2,
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))))
+      ~> #notB
+      => false
+    </k>
+
+  claim [absent-continuation]:
+    <k>
+      #memberAcc(
+        4,
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))))
+      ~> #notB
+      => true
+    </k>
+endmodule
+
+module LOOP-PROBE-FIXED
+  imports VERIFICATION-MEMBER
+
+  claim [observable-continuation]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(1, vCons(2, .ValSeq)))),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      ~> Assign(Name("x"), Int(99))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("l" |-> ref(0))
+        ("result" |-> ref(1))
+        ("x" |-> (noneV => 99)),
+        parent(0))
+    </scopes>
+    <heap>
+      1 |-> list(
+        .ValSeq
+        => vCons(2, vCons(1, .ValSeq)))
+    </heap>
+endmodule
+
+module LOOP-PROBE-BRIDGED
+  imports VERIFICATION
+
+  claim [observable-continuation]:
+    <k>
+      #loop(
+        list(vCons(2, vCons(1, vCons(2, .ValSeq)))),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      ~> Assign(Name("x"), Int(99))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("l" |-> ref(0))
+        ("result" |-> ref(1))
+        ("x" |-> (noneV => 99)),
+        parent(0))
+    </scopes>
+    <heap>
+      1 |-> list(
+        .ValSeq
+        => vCons(2, vCons(1, .ValSeq)))
+    </heap>
+endmodule
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..cfa5d24d1469c56e54326a0fd5f703bdff9046ec
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,21 @@
+from solution import unique
+
+
+CASES = [
+    [],
+    [5, 3, 5, 2, 3, 3, 9, 0, 123],
+    ["b", "a", "b", "c", "a"],
+    [True, 1],
+    [True, 1, 0, False, 2],
+    [3.0, 2, 2.0, 3],
+    [-4, 7, -4, 0, 7, -1],
+]
+
+
+for case in CASES:
+    expected = sorted(set(case))
+    actual = unique(case)
+    assert actual == expected, (case, expected, actual)
+    print(f"{case!r} -> {actual!r}")
+
+print(f"CPYTHON_MISMATCHES=0 CASES={len(CASES)}")
diff --git a/concrete_tests_k.py b/concrete_tests_k.py
new file mode 100644
index 0000000000000000000000000000000000000000..1dcad4162de29ead9327acb06e10d8b9e3d5dac2
--- /dev/null
+++ b/concrete_tests_k.py
@@ -0,0 +1,17 @@
+def unique(l: list):
+    """Return sorted unique elements in a list."""
+    result = []
+    x = None
+    for x in l:
+        if x not in result:
+            result.append(x)
+    return sorted(result)
+
+
+assert unique([]) == []
+assert unique([5, 3, 5, 2, 3, 3, 9, 0, 123]) == [0, 2, 3, 5, 9, 123]
+assert unique(["b", "a", "b", "c", "a"]) == ["a", "b", "c"]
+assert unique([True, 1]) == [True]
+assert unique([True, 1, 0, False, 2]) == [0, True, 2]
+assert unique([3.0, 2, 2.0, 3]) == [2, 3.0]
+assert unique([-4, 7, -4, 0, 7, -1]) == [-4, -1, 0, 7]
diff --git a/model-boundary.k b/model-boundary.k
new file mode 100644
index 0000000000000000000000000000000000000000..fdf4892dc9a29a4766a99a29cf3305c606a8a69f
--- /dev/null
+++ b/model-boundary.k
@@ -0,0 +1,16 @@
+requires "verification.k"
+
+module MODEL-BOUNDARY
+  imports VERIFICATION-BASE
+
+  // The symbolic MPY list-membership model uses structural K equality, so
+  // Bool(true) and Int(1) remain distinct here.  MPY-KRUN's concrete-only
+  // numOrKEq rule instead matches CPython and collapses them.
+  claim [symbolic-bool-int-distinct]:
+    <k>
+      dedupFromVS(
+        vCons(true, vCons(1, .ValSeq)),
+        .ValSeq)
+      => vCons(true, vCons(1, .ValSeq))
+    </k>
+endmodule
diff --git a/smoke.mpy b/smoke.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..3186455252b319045193dd250fed1bf6899c6337
--- /dev/null
+++ b/smoke.mpy
@@ -0,0 +1,24 @@
+Module(
+  FuncDef("unique", Params("l"),
+    Expr(Str("Return sorted unique elements in a list."))
+    Assign(Name("result"), ListExpr())
+    Assign(Name("x"), NoneVal)
+    For(Name("x"), Name("l"),
+      If(Compare(Name("x"), CmpOp("not in", Name("result"))),
+        Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+        ))
+    Return(Call(Name("sorted"), Name("result"))))
+  Assign(
+    Name("answer"),
+    Call(
+      Name("unique"),
+      ListExpr(
+        Int(5),
+        Int(3),
+        Int(5),
+        Int(2),
+        Int(3),
+        Int(3),
+        Int(9),
+        Int(0),
+        Int(123)))))
