+    Return(Call(Name("sorted"), Name("result"))))
+  Assign(
+    Name("answer"),
+    Call(
+      Name("unique"),
+      ListExpr(
+        Int(5),
+        Int(3),
+        Int(5),
+        Int(2),
+        Int(3),
+        Int(3),
+        Int(9),
+        Int(0),
+        Int(123)))))
