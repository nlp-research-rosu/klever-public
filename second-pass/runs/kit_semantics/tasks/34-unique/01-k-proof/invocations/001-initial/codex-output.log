+                  Expr(Call(
+                    Attribute(Name("result"), "append"),
+                    Name("x"))),
+                  .Stmts))
+              Return(Call(Name("sorted"), Name("result")))
+              .Stmts,
+              0))
+          GLOBALS:Map,
+          parent(-1))
+        1 |-> scope(
+          ("l" |-> ref(0))
+          ("result" |-> ref(1))
+          ("x" |-> _X:Val)
+          LOCALS:Map,
+          parent(0))
+      =>
