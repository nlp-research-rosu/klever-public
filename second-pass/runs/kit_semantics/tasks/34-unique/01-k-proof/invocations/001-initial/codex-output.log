diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..c742d29ac18dfa43c8060b98ebcfcddf1a277eec
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def unique(l: list):
+    """Return sorted unique elements in a list."""
+    result = []
+    x = None
+    for x in l:
+        if x not in result:
+            result.append(x)
+    return sorted(result)
