diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b032cbd167fbaf8322b15c68ce36abf77000e49c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,87 @@
+requires "verification.k"
+
+module MEMBER-SPEC
+  imports VERIFICATION-BASE
+
+  // Fixed-semantics execution theorem for list membership.  This is a
+  // circularity over the input sequence, not a rule that replaces execution.
+  claim [member-summary]:
+    <k> #memberAcc(V:Val, list(VS:ValSeq))
+      => memberVS(V, VS) ... </k>
+endmodule
+
+module LOOP-SPEC
+  imports VERIFICATION-MEMBER
+
+  // The source for-loop, its return, and its exact function-call context.
+  // The arbitrary VS and ACC make this an unbounded loop circularity.
+  claim [unique-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ... 1 |-> scope(
+        ("l" |-> ref(0))
+        ("result" |-> ref(1))
+        ("x" |-> (X:Val => lastFromVS(VS, X))),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ... 1 |-> list(ACC:ValSeq => dedupFromVS(VS, ACC)) ...
+    </heap>
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  // Required target theorem: invoke the exact generated function closure on
+  // an arbitrary finite ValSeq stored as a Python list object.
+  claim [unique-full-domain]:
+    <k> Call(Name("unique"), ref(0)) => ref(2) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        .Map [
+          "unique" <- closureVal(
+            ("l", .ParamNames),
+            Expr(Str("Return sorted unique elements in a list."))
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("x"), NoneVal)
+            For(
+              Name("x"),
+              Name("l"),
+              If(
+                Compare(Name("x"), CmpOp("not in", Name("result"))),
+                Expr(Call(
+                  Attribute(Name("result"), "append"),
+                  Name("x"))),
+                .Stmts))
+            Return(Call(Name("sorted"), Name("result")))
+            .Stmts,
+            0) ],
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      ( 0 |-> list(INPUT:ValSeq)
+      =>
+        0 |-> list(INPUT)
+        1 |-> list(dedupFromVS(INPUT, .ValSeq))
+        2 |-> list(sortVS(dedupFromVS(INPUT, .ValSeq)))
+      )
+    </heap>
+    <heapLoc> 1 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..85c3d096e2724e5f9901b496b6a898bd78377255
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,74 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // Exact mathematical summary of MPY-LIST's #memberAcc fold.
+  syntax Bool ::= memberVS(Val, ValSeq) [function, total]
+  rule memberVS(_:Val, .ValSeq) => false
+  rule memberVS(V:Val, vCons(E:Val, R:ValSeq)) => memberVS(V, R)
+    requires notBool (V ==K E)
+    [simplification]
+  rule memberVS(V:Val, vCons(E:Val, _:ValSeq)) => true
+    requires V ==K E
+    [simplification]
+
+  // Append V precisely when it is not already present in ACC.
+  syntax ValSeq ::= appendUnique(ValSeq, Val) [function, total]
+  rule appendUnique(ACC:ValSeq, V:Val) => ACC
+    requires memberVS(V, ACC)
+  rule appendUnique(ACC:ValSeq, V:Val)
+    => valSeqConcat(ACC, vCons(V, .ValSeq))
+    requires notBool memberVS(V, ACC)
+
+  // First-seen-order deduplication, parameterized by the current accumulator.
+  syntax ValSeq ::= dedupFromVS(ValSeq, ValSeq) [function, total]
+  rule dedupFromVS(.ValSeq, ACC:ValSeq) => ACC
+  rule dedupFromVS(vCons(V:Val, R:ValSeq), ACC:ValSeq)
+    => dedupFromVS(R, appendUnique(ACC, V))
+
+  // Value left in the source for-loop target after consuming VS.
+  syntax Val ::= lastFromVS(ValSeq, Val) [function, total]
+  rule lastFromVS(.ValSeq, X:Val) => X
+  rule lastFromVS(vCons(V:Val, R:ValSeq), _:Val) => lastFromVS(R, V)
+endmodule
+
+module VERIFICATION-MEMBER
+  imports VERIFICATION-BASE
+
+  // Operational bridge admitted only after MEMBER-SPEC proves the identical
+  // arbitrary-continuation theorem using VERIFICATION-BASE (without this rule).
+  rule <k> #memberAcc(V:Val, list(VS:ValSeq))
+    => memberVS(V, VS) ... </k>
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-MEMBER
+
+  // Operational bridge admitted only after LOOP-SPEC proves the identical
+  // arbitrary-continuation loop theorem using VERIFICATION-MEMBER (without
+  // this rule).  Return, sorted(), allocation, and frame-pop still execute.
+  rule
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("x"),
+        If(
+          Compare(Name("x"), CmpOp("not in", Name("result"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
+          .Stmts))
+      => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ... 1 |-> scope(
+        ("l" |-> ref(0))
+        ("result" |-> ref(1))
+        ("x" |-> (X:Val => lastFromVS(VS, X))),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ... 1 |-> list(ACC:ValSeq => dedupFromVS(VS, ACC)) ...
+    </heap>
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
