Module(
  FuncDef("unique", Params("l"),
    Expr(Str("Return sorted unique elements in a list."))
    Assign(Name("result"), ListExpr())
    Assign(Name("x"), NoneVal)
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp("not in", Name("result"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
        ))
    Return(Call(Name("sorted"), Name("result"))))
  Assign(
    Name("answer"),
    Call(
      Name("unique"),
      ListExpr(
        Int(5),
        Int(3),
        Int(5),
        Int(2),
        Int(3),
        Int(3),
        Int(9),
        Int(0),
        Int(123)))))
