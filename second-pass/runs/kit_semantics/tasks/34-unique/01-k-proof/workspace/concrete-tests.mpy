Module(
  FuncDef("unique", Params("l"),
    Expr(Str("Return sorted unique elements in a list."))
    Assign(Name("result"), ListExpr())
    Assign(Name("x"), NoneVal)
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp("not in", Name("result"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
        ))
    Return(Call(Name("sorted"), Name("result"))))
  Assert(
    Compare(Call(Name("unique"), ListExpr()), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("unique"),
        ListExpr(
          Int(5),
          Int(3),
          Int(5),
          Int(2),
          Int(3),
          Int(3),
          Int(9),
          Int(0),
          Int(123))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(2), Int(3), Int(5), Int(9), Int(123)))))
  Assert(
    Compare(
      Call(
        Name("unique"),
        ListExpr(Str("b"), Str("a"), Str("b"), Str("c"), Str("a"))),
      CmpOp("==", ListExpr(Str("a"), Str("b"), Str("c")))))
  Assert(
    Compare(
      Call(Name("unique"), ListExpr(Bool(true), Int(1))),
      CmpOp("==", ListExpr(Bool(true)))))
  Assert(
    Compare(
      Call(
        Name("unique"),
        ListExpr(Bool(true), Int(1), Int(0), Bool(false), Int(2))),
      CmpOp("==", ListExpr(Int(0), Bool(true), Int(2)))))
  Assert(
    Compare(
      Call(
        Name("unique"),
        ListExpr(Float(3.0), Int(2), Float(2.0), Int(3))),
      CmpOp("==", ListExpr(Int(2), Float(3.0)))))
  Assert(
    Compare(
      Call(
        Name("unique"),
        ListExpr(
          UnaryOp("-", Int(4)),
          Int(7),
          UnaryOp("-", Int(4)),
          Int(0),
          Int(7),
          UnaryOp("-", Int(1)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(1)),
          Int(0),
          Int(7))))))
