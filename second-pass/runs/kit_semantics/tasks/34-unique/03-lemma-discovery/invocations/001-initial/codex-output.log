VERIFICATION.K
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // Exact mathematical summary of MPY-LIST's #memberAcc fold.
     7	  syntax Bool ::= memberVS(Val, ValSeq) [function, total]
     8	  rule memberVS(_:Val, .ValSeq) => false
     9	  rule memberVS(V:Val, vCons(E:Val, R:ValSeq)) => memberVS(V, R)
    10	    requires notBool (V ==K E)
    11	    [simplification]
    12	  rule memberVS(V:Val, vCons(E:Val, _:ValSeq)) => true
    13	    requires V ==K E
    14	    [simplification]
    15	
    16	  // Append V precisely when it is not already present in ACC.
    17	  syntax ValSeq ::= appendUnique(ValSeq, Val) [function, total]
    18	  rule appendUnique(ACC:ValSeq, V:Val) => ACC
    19	    requires memberVS(V, ACC)
    20	  rule appendUnique(ACC:ValSeq, V:Val)
    21	    => valSeqConcat(ACC, vCons(V, .ValSeq))
    22	    requires notBool memberVS(V, ACC)
    23	
    24	  // First-seen-order deduplication, parameterized by the current accumulator.
    25	  syntax ValSeq ::= dedupFromVS(ValSeq, ValSeq) [function, total]
    26	  rule dedupFromVS(.ValSeq, ACC:ValSeq) => ACC
    27	  rule dedupFromVS(vCons(V:Val, R:ValSeq), ACC:ValSeq)
    28	    => dedupFromVS(R, appendUnique(ACC, V))
    29	
    30	  // Value left in the source for-loop target after consuming VS.
    31	  syntax Val ::= lastFromVS(ValSeq, Val) [function, total]
    32	  rule lastFromVS(.ValSeq, X:Val) => X
    33	  rule lastFromVS(vCons(V:Val, R:ValSeq), _:Val) => lastFromVS(R, V)
    34	endmodule
    35	
    36	module VERIFICATION-MEMBER
    37	  imports VERIFICATION-BASE
    38	
    39	  // Operational bridge admitted only after MEMBER-SPEC proves the identical
    40	  // arbitrary-continuation theorem using VERIFICATION-BASE (without this rule).
    41	  rule <k> #memberAcc(V:Val, list(VS:ValSeq))
    42	    => memberVS(V, VS) ... </k>
    43	    [priority(40)]
    44	endmodule
    45	
    46	module VERIFICATION
    47	  imports VERIFICATION-MEMBER
    48	
    49	  // Operational bridge admitted only after LOOP-SPEC proves the identical
    50	  // arbitrary-continuation loop theorem using VERIFICATION-MEMBER (without
    51	  // this rule).  Return, sorted(), allocation, and frame-pop still execute.
    52	  rule
    53	    <k>
    54	      #loop(
    55	        list(VS:ValSeq),
    56	        Name("x"),
    57	        If(
    58	          Compare(Name("x"), CmpOp("not in", Name("result"))),
    59	          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
    60	          .Stmts))
    61	      => .K ...
    62	    </k>
    63	    <env> 1 </env>
    64	    <scopes>
    65	      ... 1 |-> scope(
    66	        ("l" |-> ref(0))
    67	        ("result" |-> ref(1))
    68	        ("x" |-> (X:Val => lastFromVS(VS, X))),
    69	        parent(0))
    70	      ...
    71	    </scopes>
    72	    <heap>
    73	      ... 1 |-> list(ACC:ValSeq => dedupFromVS(VS, ACC)) ...
    74	    </heap>
    75	    [priority(40)]
    76	endmodule

SPEC.K
     1	requires "verification.k"
     2	
     3	module MEMBER-SPEC
     4	  imports VERIFICATION-BASE
     5	
     6	  // Fixed-semantics execution theorem for list membership.  This is a
     7	  // circularity over the input sequence, not a rule that replaces execution.
     8	  claim [member-summary]:
     9	    <k> #memberAcc(V:Val, list(VS:ValSeq))
    10	      => memberVS(V, VS) ... </k>
    11	endmodule
    12	
    13	module LOOP-SPEC
    14	  imports VERIFICATION-MEMBER
    15	
    16	  // The exact source for-loop with an arbitrary continuation.  The arbitrary
    17	  // VS and ACC make this an unbounded loop circularity.
    18	  claim [unique-loop]:
    19	    <k>
    20	      #loop(
    21	        list(VS:ValSeq),
    22	        Name("x"),
    23	        If(
    24	          Compare(Name("x"), CmpOp("not in", Name("result"))),
    25	          Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
    26	          .Stmts))
    27	      => .K ...
    28	    </k>
    29	    <env> 1 </env>
    30	    <scopes>
    31	      ... 1 |-> scope(
    32	        ("l" |-> ref(0))
    33	        ("result" |-> ref(1))
    34	        ("x" |-> (X:Val => lastFromVS(VS, X))),
    35	        parent(0))
    36	      ...
    37	    </scopes>
    38	    <heap>
    39	      ... 1 |-> list(ACC:ValSeq => dedupFromVS(VS, ACC)) ...
    40	    </heap>
    41	endmodule
    42	
    43	module SPEC
    44	  imports VERIFICATION
    45	
    46	  // Required target theorem: invoke the exact generated function closure on
    47	  // an arbitrary finite ValSeq stored as a Python list object.
    48	  claim [unique-full-domain]:
    49	    <k> Call(Name("unique"), ref(0)) => ref(2) </k>
    50	    <env> 0 </env>
    51	    <scopes>
    52	      -1 |-> builtinsScope
    53	      0 |-> scope(
    54	        .Map [
    55	          "unique" <- closureVal(
    56	            ("l", .ParamNames),
    57	            Expr(Str("Return sorted unique elements in a list."))
    58	            Assign(Name("result"), ListExpr(.Exprs))
    59	            Assign(Name("x"), NoneVal)
    60	            For(
    61	              Name("x"),
    62	              Name("l"),
    63	              If(
    64	                Compare(Name("x"), CmpOp("not in", Name("result"))),
    65	                Expr(Call(
    66	                  Attribute(Name("result"), "append"),
    67	                  Name("x"))),
    68	                .Stmts))
    69	            Return(Call(Name("sorted"), Name("result")))
    70	            .Stmts,
    71	            0) ],
    72	        parent(-1))
    73	    </scopes>
    74	    <scopeLoc> 1 </scopeLoc>
    75	    <heap>
    76	      ( 0 |-> list(INPUT:ValSeq)
    77	      =>
    78	        0 |-> list(INPUT)
    79	        1 |-> list(dedupFromVS(INPUT, .ValSeq))
    80	        2 |-> list(sortVS(dedupFromVS(INPUT, .ValSeq)))
    81	      )
    82	    </heap>
    83	    <heapLoc> 1 => 3 </heapLoc>
    84	    <stack> .List </stack>
    85	    <ret> noRet </ret>
    86	    <exc> NoExc </exc>
    87	endmodule

