import json
from collections import Counter
inv_path='/reference/rule-inventory.json'
out_path='/workspace/trust-boundary.json'
with open(inv_path) as f: inv=json.load(f)
with open(out_path) as f: out=json.load(f)
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
inv_ids=[r['source_rule_id'] for r in inv['rules']]
out_ids=[r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert len(set(out_ids)) == len(out_ids)
for row in out['rules']:
    assert list(row.keys()) == ['source_rule_id','classification','rationale'], row
    assert row['classification'] in allowed
    assert isinstance(row['rationale'],str) and row['rationale'].strip()
by_id={r['source_rule_id']:r for r in out['rules']}
for rule in inv['rules']:
    if 'simplification' in rule.get('attributes',[]):
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
counts=Counter(r['classification'] for r in out['rules'])
print('VALID_JSON=1')
print('INVENTORY_SHA256='+out['inventory_sha256'])
print('RULES='+str(len(out_ids)))
for k in sorted(allowed): print(f'{k}={counts[k]}')
print('ORDER_MATCH=1 UNIQUE_COVERAGE=1 ENTRY_KEYS_EXACT=1')
