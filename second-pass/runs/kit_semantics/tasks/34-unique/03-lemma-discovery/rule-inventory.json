      "text": "  rule\n    <k>\n      #loop(\n        list(VS:ValSeq),\n        Name(\"x\"),\n        If(\n          Compare(Name(\"x\"), CmpOp(\"not in\", Name(\"result\"))),\n          Expr(Call(Attribute(Name(\"result\"), \"append\"), Name(\"x\"))),\n          .Stmts))\n      => .K ...\n    </k>\n    <env> 1 </env>\n    <scopes>\n      ... 1 |-> scope(\n        (\"l\" |-> ref(0))\n        (\"result\" |-> ref(1))\n        (\"x\" |-> (X:Val => lastFromVS(VS, X))),\n        parent(0))\n      ...\n    </scopes>\n    <heap>\n      ... 1 |-> list(ACC:ValSeq => dedupFromVS(VS, ACC)) ...\n    </heap>\n    [priority(40)]"
