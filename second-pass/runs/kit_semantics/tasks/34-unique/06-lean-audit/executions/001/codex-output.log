+to /proc/self/exe.
+
+COMMAND: gcc -shared -fPIC -O2 -Wall -Wextra -o /tmp/audit-work/proc_self_shim.so /tmp/audit-work/proc_self_shim.c -ldl; LD_PRELOAD=/tmp/audit-work/proc_self_shim.so lean --version; LD_PRELOAD=/tmp/audit-work/proc_self_shim.so lake --version
+EXIT: 0
