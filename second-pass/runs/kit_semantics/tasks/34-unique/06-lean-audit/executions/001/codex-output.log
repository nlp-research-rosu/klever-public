def normalize(text):
    return ' '.join(text.split())

def compare(name, rule_start, rule_end, claim_start, claim_end, label):
    rule = '\\n'.join(verification[rule_start-1:rule_end])
    claim = '\\n'.join(spec[claim_start-1:claim_end])
    rule_body = re.sub(r'"'^'"\\s*rule\\s*', '', rule)
