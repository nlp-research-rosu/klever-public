index 0000000000000000000000000000000000000000..09034d135446e1ebc5690d89d27f81588655126e
--- /dev/null
+++ b/evidence/stage7_model_gap.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module AUDIT-SYMBOLIC-MODEL-GAP
+  imports VERIFICATION-BASE
+
+  // The bridge-free supplied Haskell semantics uses structural ==K:
+  // 1 is not considered a member of [True].
+  claim [bool-int-structural]:
+    <k>
+      #memberAcc(1, list(vCons(true, .ValSeq)))
+      => false
+    </k>
+endmodule
+
+module AUDIT-SYMBOLIC-MODEL-OPPOSITE
+  imports VERIFICATION-BASE
+
+  // Deliberately asks for CPython's opposite result. The fixed symbolic model
+  // must reject it.
+  claim [bool-int-cpython-result]:
+    <k>
+      #memberAcc(1, list(vCons(true, .ValSeq)))
+      => true
+    </k>
+endmodule
+
diff --git a/evidence/stage7_model_gap_concrete.py b/evidence/stage7_model_gap_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..5372e67d36a65ba339cdb7f1b5b96292219f9c1e
--- /dev/null
+++ b/evidence/stage7_model_gap_concrete.py
@@ -0,0 +1,12 @@
+def unique(l: list):
+    """Return sorted unique elements in a list."""
+    result = []
+    x = None
+    for x in l:
+        if x not in result:
+            result.append(x)
+    return sorted(result)
+
+
+answer = unique([True, 1])
+
