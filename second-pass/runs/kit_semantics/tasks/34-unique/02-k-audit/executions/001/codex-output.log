+    'NR > 1 { n += ("," $6 ",") ~ ("," value ",") } END { print n + 0 }' \
+    /audit-output/evidence/stage5_rule_inventory.tsv)
+  echo "attribute=$attribute count=$count"
+done
+echo "EXIT: 0"
+
+run sha256sum \
