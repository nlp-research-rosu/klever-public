cp /candidate/solution.py /candidate/solution.mpy /candidate/verification.k /candidate/spec.k /candidate/bridge-probes.k /candidate/model-boundary.k /candidate/spec-vacuity.k /candidate/spec-body-mutation.k /candidate/smoke.mpy /tmp/audit-work/review-34-unique/
