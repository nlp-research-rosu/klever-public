+#!/usr/bin/env bash
+set -uo pipefail
+
+log=/audit-output/evidence/stage5_static_review.log
+exec >"$log" 2>&1
+
+run() {
+  echo "COMMAND: $*"
+  "$@"
+  status=$?
+  echo "EXIT: $status"
+  return "$status"
+}
+
+echo "STAGE 5 RULE-BY-RULE STATIC SOUNDNESS REVIEW"
+run python3 /audit-output/evidence/stage5_inventory.py || exit $?
+
+run wc -l /audit-output/evidence/stage5_rule_inventory.tsv
+
+echo "COMMAND: count required inventory categories"
+for pattern in \
+  $'\tsyntax\t' \
+  $'\trule\t' \
+  $'\tcontext\t' \
+  $'\tconfiguration\t' \
+  'function' \
+  'functional' \
+  'total' \
+  'opaque/no-evaluators' \
+  'priority' \
+  'simplification'
+do
+  count=$(grep -c "$pattern" /audit-output/evidence/stage5_rule_inventory.tsv || true)
+  echo "$pattern $count"
+done
+echo "EXIT: 0"
+
+run sha256sum \
+  /audit-output/evidence/stage5_rule_inventory.tsv \
+  /audit-output/evidence/stage5_proof_local_review.md

exec
/bin/bash -lc "rg -n '\\[priority' /tmp/audit-work/review-34-unique/reference-semantics /tmp/audit-work/review-34-unique/verification.k | wc -l
rg -n '\\[simplification' /tmp/audit-work/review-34-unique/reference-semantics /tmp/audit-work/review-34-unique/verification.k | wc -l
rg -n 'no-evaluators' /tmp/audit-work/review-34-unique/reference-semantics /tmp/audit-work/review-34-unique/verification.k | wc -l
