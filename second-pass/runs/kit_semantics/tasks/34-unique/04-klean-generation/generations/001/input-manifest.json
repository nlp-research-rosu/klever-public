      ],
      "classification": "PROVED_DERIVED_LEMMA",
      "end_line": 75,
      "module": "VERIFICATION",
      "normalized_sha256": "e2565529bcc6542c53c8abedee1129bc7ea40552bde63262b79144f437ec36ac",
      "rationale": "Its exact loop body, continuation framing, local-scope update, and heap update are first proved as LOOP-SPEC.unique-loop using VERIFICATION-MEMBER, whose closure does not contain this VERIFICATION rule; prove.sh compiles VERIFICATION only afterward.",
      "source_rule_id": "rule-e2565529bcc6542c53c8abedee1129bc7ea40552bde63262b79144f437ec36ac",
      "start_line": 52,
      "text": "  rule\n    <k>\n      #loop(\n        list(VS:ValSeq),\n        Name(\"x\"),\n        If(\n          Compare(Name(\"x\"), CmpOp(\"not in\", Name(\"result\"))),\n          Expr(Call(Attribute(Name(\"result\"), \"append\"), Name(\"x\"))),\n          .Stmts))\n      => .K ...\n    </k>\n    <env> 1 </env>\n    <scopes>\n      ... 1 |-> scope(\n        (\"l\" |-> ref(0))\n        (\"result\" |-> ref(1))\n        (\"x\" |-> (X:Val => lastFromVS(VS, X))),\n        parent(0))\n      ...\n    </scopes>\n    <heap>\n      ... 1 |-> list(ACC:ValSeq => dedupFromVS(VS, ACC)) ...\n    </heap>\n    [priority(40)]"
    }
