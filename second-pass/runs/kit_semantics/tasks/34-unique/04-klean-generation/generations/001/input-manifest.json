{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 8,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "fecd0d5756dc6e8a5b0329b0886b0dfdf9a066a18e408bf804d51e68b87a25fd",
      "rationale": "Base equation defining memberVS on the empty value sequence as false.",
      "source_rule_id": "rule-fecd0d5756dc6e8a5b0329b0886b0dfdf9a066a18e408bf804d51e68b87a25fd",
      "start_line": 8,
      "text": "  rule memberVS(_:Val, .ValSeq) => false"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "01ca47bdc764e6c63385dc39ed8faa37ea3a1f2a8e45581b158e242a65f57d40",
      "rationale": "Structurally recursive memberVS equation for an unequal head; the simplification attribute exposes this defining case under its guard.",
      "source_rule_id": "rule-01ca47bdc764e6c63385dc39ed8faa37ea3a1f2a8e45581b158e242a65f57d40",
      "start_line": 9,
      "text": "  rule memberVS(V:Val, vCons(E:Val, R:ValSeq)) => memberVS(V, R)\n    requires notBool (V ==K E)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 14,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "5a42fafcb4b21fca4d080e81d9cee27d6ac59bfaad8fc0cef0bbaf3a67812e96",
      "rationale": "Equal-head memberVS equation defining successful membership; its simplification attribute is attached to a guarded defining case.",
      "source_rule_id": "rule-5a42fafcb4b21fca4d080e81d9cee27d6ac59bfaad8fc0cef0bbaf3a67812e96",
      "start_line": 12,
      "text": "  rule memberVS(V:Val, vCons(E:Val, _:ValSeq)) => true\n    requires V ==K E\n    [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "e701b8687cbdb5c33c33c653fdee4ff0f06d4d40a1f595880e447960da741521",
      "rationale": "Defining appendUnique case that preserves the accumulator when memberVS reports the value already present.",
      "source_rule_id": "rule-e701b8687cbdb5c33c33c653fdee4ff0f06d4d40a1f595880e447960da741521",
      "start_line": 18,
      "text": "  rule appendUnique(ACC:ValSeq, V:Val) => ACC\n    requires memberVS(V, ACC)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "f72f44633c07c0398b7261cfe199527c95184082b772241421237255ac3a123b",
      "rationale": "Complementary appendUnique defining case that appends a value when memberVS reports it absent.",
      "source_rule_id": "rule-f72f44633c07c0398b7261cfe199527c95184082b772241421237255ac3a123b",
      "start_line": 20,
      "text": "  rule appendUnique(ACC:ValSeq, V:Val)\n    => valSeqConcat(ACC, vCons(V, .ValSeq))\n    requires notBool memberVS(V, ACC)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "6455f8e69be7a020e502a67d071206795291a4a68aaa2f71ec45dd83c0adb575",
      "rationale": "Base equation for the dedupFromVS recurrence, returning the accumulated sequence when no input remains.",
      "source_rule_id": "rule-6455f8e69be7a020e502a67d071206795291a4a68aaa2f71ec45dd83c0adb575",
      "start_line": 26,
      "text": "  rule dedupFromVS(.ValSeq, ACC:ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "92a60fc3a43490ddafd83b3b7a2ce318020f6aece34ac0196107b26fda02221a",
      "rationale": "Recursive dedupFromVS equation that consumes one input element and threads the appendUnique accumulator.",
      "source_rule_id": "rule-92a60fc3a43490ddafd83b3b7a2ce318020f6aece34ac0196107b26fda02221a",
      "start_line": 27,
      "text": "  rule dedupFromVS(vCons(V:Val, R:ValSeq), ACC:ValSeq)\n    => dedupFromVS(R, appendUnique(ACC, V))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "3d2b32f04a4d08e9fcd40d2c12a5c21b4ac7aede0fa67960dc198cb73fdb3f2f",
      "rationale": "Base equation defining the retained loop-target value when the remaining sequence is empty.",
      "source_rule_id": "rule-3d2b32f04a4d08e9fcd40d2c12a5c21b4ac7aede0fa67960dc198cb73fdb3f2f",
      "start_line": 32,
      "text": "  rule lastFromVS(.ValSeq, X:Val) => X"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "2fc3eb5c4bd624d0101902379b1df4b2bd494b81e546f58a15eb3e494e2866ea",
      "rationale": "Recursive lastFromVS equation that consumes a sequence head and carries it as the current loop-target value.",
      "source_rule_id": "rule-2fc3eb5c4bd624d0101902379b1df4b2bd494b81e546f58a15eb3e494e2866ea",
      "start_line": 33,
      "text": "  rule lastFromVS(vCons(V:Val, R:ValSeq), _:Val) => lastFromVS(R, V)"
    }
  ],
