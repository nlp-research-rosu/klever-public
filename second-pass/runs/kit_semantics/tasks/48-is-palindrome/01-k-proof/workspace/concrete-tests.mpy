Module(
  FuncDef("is_palindrome", Params("text"),
    Return(
      Compare(
        Name("text"),
        CmpOp(
          "==",
          Subscript(
            Name("text"),
            Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
  Assert(
    Compare(
      Call(Name("is_palindrome"), Str("")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_palindrome"), Str("aba")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_palindrome"), Str("aaaaa")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_palindrome"), Str("zbcd")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("is_palindrome"), Str("ab")),
      CmpOp("==", Bool(false)))))
