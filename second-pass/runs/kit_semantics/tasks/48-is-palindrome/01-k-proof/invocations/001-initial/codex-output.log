+            closureVal(
+              ("text", .ParamNames),
+              Return(
+                Compare(
+                  Name("text"),
+                  CmpOp(
+                    "==",
+                    Subscript(
+                      Name("text"),
+                      Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))))
+              .Stmts,
+              0)
+          "__result" |->
+            (S ==K buildIS(S, isLen(S) -Int 1, -1, -1)),
+          parent(-1))
+       -1 |-> builtinsScope)
