+            == audit_input["audit"]["mechanical_checker_lock_sha256"]
+        ),
+        "every_checker_source_hash_matches_lock": all(
+            sha256_file(Path("/reference") / relative) == expected
+            for relative, expected in checker_lock["files"].items()
+        ),
+    }
+
+    output = {
