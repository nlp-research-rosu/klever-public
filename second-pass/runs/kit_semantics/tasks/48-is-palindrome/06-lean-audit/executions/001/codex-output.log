new file mode 100644
index 0000000000000000000000000000000000000000..ccd98ac0cd1e9fa20b851016e766087cfa3f12b9
--- /dev/null
+++ b/evidence/03-source-and-operational-meaning.txt
@@ -0,0 +1,51 @@
+COMMAND
+nl -ba /reference/k-proof/verification.k
+nl -ba /reference/k-proof/solution.py
+nl -ba /reference/k-proof/spec.k
+nl -ba /reference/k-proof/reference-semantics/semantics/subscript.k | sed -n '49,121p'
+nl -ba /reference/k-proof/reference-semantics/semantics/str.k | sed -n '19,26p'
+
+RESULT (relevant exact excerpts)
+     1	requires "reference-semantics/semantics.k"
+     2	
+     3	module VERIFICATION
+     4	  imports MPY
+     5	endmodule
+
+     1	def is_palindrome(text: str):
+     2	    return text == text[::-1]
+
+The exact `spec.k` post-state result binding is:
+    43	          "__result" |->
+    44	            (S ==K buildIS(S, isLen(S) -Int 1, -1, -1)),
+
+The supplied slice semantics for `[::-1]` includes:
+    49	  syntax OptInt ::= "noB" | someB(Int)
+    50	  rule <k> #evalB(NoBound)  => noB ... </k>
+    54	  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>
+    68	  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
+    69	    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))
+    72	  syntax Int ::= slStep(OptInt) [function, total]
+    74	  rule slStep(someB(S:Int)) => S
+    79	  rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1
+    80	       requires slStep(ST) <Int 0
+    86	  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
+    87	       requires slStep(ST) <Int 0
+   116	  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]
+   117	  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
+   118	    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
+   119	       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
+   120	  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
+   121	       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
+
+The supplied string equality rule is:
+    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
+
+JUDGMENT RECORDED WITH THE RAW SOURCE
+The selected local verification-module closure contains only `VERIFICATION`.
+That module has no `rule` sentence, simplification attribute, function
+definition, operational bridge, derived lemma, or domain lemma.  The result
+expression in the reachability claim is the ordinary supplied-semantics
+normal form for equality against the negative-step slice, not a proof-local
+rule.  Therefore the independent classification list and genuine domain set
+are both empty.
