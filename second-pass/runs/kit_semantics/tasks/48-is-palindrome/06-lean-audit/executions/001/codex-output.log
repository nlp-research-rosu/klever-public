+            == {"klean_export.py", "klean.py", "source-manifest.json"}
+        ),
+        "producer_file_hashes_match_manifest_and_source_manifest": (
+            source_manifest["files"]
+            == {
+                "klean_export.py": direct_hashes["klean_export.py"],
+                "klean.py": direct_hashes["klean.py"],
