     1	from itertools import product
     2	
     3	from solution import is_palindrome
     4	
     5	
     6	def oracle(text: str) -> bool:
     7	    left = 0
     8	    right = len(text) - 1
     9	    while left < right:
    10	        if text[left] != text[right]:
    11	            return False
    12	        left += 1
    13	        right -= 1
    14	    return True
    15	
    16	
    17	alphabet = ("a", "b", "é", "🙂")
    18	cases = ["", "aba", "aaaaa", "zbcd"]
    19	for length in range(6):
    20	    cases.extend("".join(chars) for chars in product(alphabet, repeat=length))
    21	
    22	mismatches = [
    23	    (text, is_palindrome(text), oracle(text))
    24	    for text in cases
    25	    if is_palindrome(text) != oracle(text)
    26	]
    27	
    28	print(f"cases={len(cases)} mismatches={len(mismatches)}")
    29	if mismatches:
    30	    print(mismatches[:10])
    31	    raise SystemExit(1)
