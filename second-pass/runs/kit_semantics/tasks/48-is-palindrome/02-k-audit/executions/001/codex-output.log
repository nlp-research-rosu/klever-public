+++ b/evidence/rebuild_and_prove.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/48-is-palindrome-audit
+cd "$work" || exit 90
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS=%s\n' "$status"
+  return "$status"
+}
+
+if [[ -e runtime-review2-kompiled || -L runtime-review2-kompiled ]]; then
+  printf 'ERROR: runtime-review2-kompiled pre-existed\n'
+  exit 91
+fi
+if [[ -e verification-review2-kompiled || -L verification-review2-kompiled ]]; then
