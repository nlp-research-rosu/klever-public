{ bash /audit-output/evidence/run_fresh_mutation.sh; rc=$?; echo "SCRIPT_EXIT_STATUS=$rc"; exit "$rc"; } 2>&1 | tee /audit-output/evidence/10-fresh-non-vacuity.log' in /tmp/audit-work/48-is-palindrome-audit
