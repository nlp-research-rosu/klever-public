+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+          "is_palindrome" |->
+            closureVal(
+              ("text", .ParamNames),
+              Return(Bool(false)) .Stmts,
+              0)
+          "__result" |-> true,
+          parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
