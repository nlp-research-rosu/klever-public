index 0000000000000000000000000000000000000000..49a8ee78234879e02280a0029243d84e56a909a3
--- /dev/null
+++ b/evidence/spec-reviewer-false.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module SPEC-REVIEWER-FALSE
+  imports VERIFICATION
+
+  // Reviewer-authored false result obligation. The entry state is satisfiable:
+  // it calls the exact submitted body on the empty semantic string. The real
+  // result is true, while this destination deliberately requires false.
+  claim [empty-must-be-false]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("is_palindrome", Params("text"),
+            Return(
+              Compare(
+                Name("text"),
+                CmpOp(
+                  "==",
+                  Subscript(
+                    Name("text"),
+                    Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
+          Assign(
+            Name("__result"),
+            Call(Name("is_palindrome"), str(.IntSeq)))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+          "is_palindrome" |->
+            closureVal(
+              ("text", .ParamNames),
+              Return(
+                Compare(
+                  Name("text"),
+                  CmpOp(
+                    "==",
+                    Subscript(
+                      Name("text"),
+                      Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))))
+              .Stmts,
+              0)
+          "__result" |-> false,
+          parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

diff --git a//tmp/audit-work/48-is-palindrome-audit/runtime-audit.py b//tmp/audit-work/48-is-palindrome-audit/runtime-audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..62ea9dfef1222dcc861a69883c1d0b560fec3446
--- /dev/null
+++ b//tmp/audit-work/48-is-palindrome-audit/runtime-audit.py
@@ -0,0 +1,10 @@
+def is_palindrome(text: str):
+    return text == text[::-1]
+
+
+assert is_palindrome("") == True
+assert is_palindrome("x") == True
+assert is_palindrome("xy") == False
+assert is_palindrome("abba") == True
+assert is_palindrome("abca") == False
+assert is_palindrome("racecar") == True
