+++ b/evidence/run_body_sensitivity.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/48-is-palindrome-audit
+cd "$work" || exit 90
+cp /audit-output/evidence/spec-reviewer-body-mutation.k \
