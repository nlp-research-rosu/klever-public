+        "result" |-> ref(0)
+        "s" |-> (S:Val => ?S:Val),
+        parent(0))
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
