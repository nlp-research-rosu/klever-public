+    for s in lst:
+        count = (
+            s.count("1")
+            + s.count("3")
+            + s.count("5")
+            + s.count("7")
+            + s.count("9")
+        )
+        count_string = str(count)
+        result.append(
+            "the number of odd elements "
+            + count_string
+            + "n the str"
+            + count_string
+            + "ng "
+            + count_string
+            + " of the "
+            + count_string
+            + "nput."
+        )
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8afb7abf87d1616f75d11a219bc229b358958b2d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,98 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [outer-loop-cons]:
+    <k>
+      #loop(
+        list(vCons(str(HEAD:IntSeq), REST:ValSeq)),
+        Name("s"),
+        ODD-COUNT-LOOP-BODY)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "count" |-> (COUNT:Int => ?COUNT:Int)
+        "count_string" |-> (str(COUNTSTRING:IntSeq) => str(?COUNTSTRING:IntSeq))
+        "lst" |-> list(INPUT:ValSeq)
+        "result" |-> ref(0)
+        "s" |-> (str(S:IntSeq) => str(?S:IntSeq)),
+        parent(0))
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(
+        ACC:ValSeq
+        =>
+        oddLinesAcc(ACC, vCons(str(HEAD), REST)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allDigit(HEAD) andBool allDigitStrings(REST)
+
+  claim [odd-count-empty]:
+    <k>
+      Call(Name("odd_count"), list(.ValSeq))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [odd-count-cons]:
+    <k>
+      Call(
+        Name("odd_count"),
+        list(vCons(str(HEAD:IntSeq), REST:ValSeq)))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        oddLinesAcc(
+          .ValSeq,
+          vCons(str(HEAD), REST)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allDigit(HEAD) andBool allDigitStrings(REST)
+endmodule
