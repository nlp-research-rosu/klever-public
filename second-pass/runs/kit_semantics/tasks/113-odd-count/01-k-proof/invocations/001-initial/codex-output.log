diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b25c10cc6ad9ef5e49dcd401219881961caf17b0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,92 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [outer-loop-cons]:
+    <k>
+      #loop(
+        list(vCons(str(HEAD:IntSeq), REST:ValSeq)),
+        Name("s"),
+        ODD-COUNT-LOOP-BODY)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (COUNT:Int => ?COUNT:Int)
+        "count_string" |-> (str(COUNTSTRING:IntSeq) => str(?COUNTSTRING:IntSeq))
+        "lst" |-> list(INPUT:ValSeq)
+        "result" |-> ref(H:Int)
+        "s" |-> (str(S:IntSeq) => str(?S:IntSeq)),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(
+        ACC:ValSeq
+        =>
+        oddLinesAcc(ACC, vCons(str(HEAD), REST)))
+      ...
+    </heap>
+    requires allDigit(HEAD) andBool allDigitStrings(REST)
+
+  claim [odd-count-empty]:
+    <k>
+      Call(Name("odd_count"), list(.ValSeq))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [odd-count-cons]:
+    <k>
+      Call(
+        Name("odd_count"),
+        list(vCons(str(HEAD:IntSeq), REST:ValSeq)))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        oddLinesAcc(
+          .ValSeq,
+          vCons(str(HEAD), REST)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allDigit(HEAD) andBool allDigitStrings(REST)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2a69976cf32cb8bf6a25f0ca503d8958ea6332a9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,127 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY
+
+  syntax Stmts ::= "ODD-COUNT-BODY" [macro]
+                 | "ODD-COUNT-LOOP-BODY" [macro]
+
+  syntax Bool ::= isStringVal(Val) [function, total]
+                | allDigitStrings(ValSeq) [function, total]
+
+  syntax Int ::= oddDigitCount(IntSeq) [function, total]
+  syntax Val ::= oddLine(IntSeq) [function, total]
+  syntax ValSeq ::= oddLinesAcc(ValSeq, ValSeq) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule ODD-COUNT-BODY
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("s"), Str(""))
+       Assign(Name("count"), Int(0))
+       Assign(Name("count_string"), Str(""))
+       For(Name("s"), Name("lst"), ODD-COUNT-LOOP-BODY)
+       Return(Name("result"))
+       .Stmts
+
+  rule ODD-COUNT-LOOP-BODY
+    => Assign(
+         Name("count"),
+         BinOp(
+           "+",
+           BinOp(
+             "+",
+             BinOp(
+               "+",
+               BinOp(
+                 "+",
+                 Call(Attribute(Name("s"), "count"), Str("1")),
+                 Call(Attribute(Name("s"), "count"), Str("3"))),
+               Call(Attribute(Name("s"), "count"), Str("5"))),
+             Call(Attribute(Name("s"), "count"), Str("7"))),
+           Call(Attribute(Name("s"), "count"), Str("9"))))
+       Assign(Name("count_string"), Call(Name("str"), Name("count")))
+       Expr(
+         Call(
+           Attribute(Name("result"), "append"),
+           BinOp(
+             "+",
+             BinOp(
+               "+",
+               BinOp(
+                 "+",
+                 BinOp(
+                   "+",
+                   BinOp(
+                     "+",
+                     BinOp(
+                       "+",
+                       BinOp(
+                         "+",
+                         BinOp(
+                           "+",
+                           Str("the number of odd elements "),
+                           Name("count_string")),
+                         Str("n the str")),
+                       Name("count_string")),
+                     Str("ng ")),
+                   Name("count_string")),
+                 Str(" of the ")),
+               Name("count_string")),
+             Str("nput."))))
+       .Stmts
+
+  rule isStringVal(str(_:IntSeq)) => true
+  rule isStringVal(_:Val) => false [owise]
+
+  rule allDigitStrings(.ValSeq) => true
+  rule allDigitStrings(vCons(str(CS:IntSeq), REST:ValSeq))
+    => allDigit(CS) andBool allDigitStrings(REST)
+  rule allDigitStrings(vCons(V:Val, _REST:ValSeq)) => false
+    requires notBool isStringVal(V)
+
+  rule oddDigitCount(CS:IntSeq)
+    => cntSub(CS, iCons(49, .IntSeq))
+       +Int cntSub(CS, iCons(51, .IntSeq))
+       +Int cntSub(CS, iCons(53, .IntSeq))
+       +Int cntSub(CS, iCons(55, .IntSeq))
+       +Int cntSub(CS, iCons(57, .IntSeq))
+
+  rule oddLine(CS:IntSeq)
+    => applyBin(
+         "+",
+         applyBin(
+           "+",
+           applyBin(
+             "+",
+             applyBin(
+               "+",
+               applyBin(
+                 "+",
+                 applyBin(
+                   "+",
+                   applyBin(
+                     "+",
+                     applyBin(
+                       "+",
+                       str(strToCodes("the number of odd elements ")),
+                       str(strToCodes(Int2String(oddDigitCount(CS))))),
+                     str(strToCodes("n the str"))),
+                   str(strToCodes(Int2String(oddDigitCount(CS))))),
+                 str(strToCodes("ng "))),
+               str(strToCodes(Int2String(oddDigitCount(CS))))),
+             str(strToCodes(" of the "))),
+           str(strToCodes(Int2String(oddDigitCount(CS))))),
+         str(strToCodes("nput.")))
+
+  rule oddLinesAcc(ACC:ValSeq, .ValSeq) => ACC
+  rule oddLinesAcc(ACC:ValSeq, vCons(str(CS:IntSeq), REST:ValSeq))
+    => oddLinesAcc(
+         valSeqConcat(ACC, vCons(oddLine(CS), .ValSeq)),
+         REST)
+  rule oddLinesAcc(ACC:ValSeq, vCons(V:Val, _REST:ValSeq)) => ACC
+    requires notBool isStringVal(V)
+endmodule

