+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        oddLinesAcc(
+          .ValSeq,
+          vCons(str(iCons(49, .IntSeq)), .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
