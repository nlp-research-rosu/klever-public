+++ b/spec.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [outer-loop]:
+    <k>
+      #loop(list(VS:ValSeq), Name("s"), ODD-COUNT-LOOP-BODY)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "count" |-> (COUNT:Int => ?COUNT:Int)
+        "count_string" |-> (str(COUNT-STRING:IntSeq) => str(?COUNT-STRING:IntSeq))
+        "lst" |-> list(INPUT:ValSeq)
+        "result" |-> ref(H:Int)
+        "s" |-> (str(S:IntSeq) => str(?S:IntSeq)),
+        parent(0))
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(ACC:ValSeq => oddLinesAcc(ACC, VS))
+      ...
+    </heap>
+    requires allDigitStrings(VS)
+
+  claim [odd-count]:
+    <k>
+      Call(Name("odd_count"), list(VS:ValSeq))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(oddLinesAcc(.ValSeq, VS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allDigitStrings(VS)
+endmodule
