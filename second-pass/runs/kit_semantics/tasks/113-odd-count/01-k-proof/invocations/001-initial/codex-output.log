+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
