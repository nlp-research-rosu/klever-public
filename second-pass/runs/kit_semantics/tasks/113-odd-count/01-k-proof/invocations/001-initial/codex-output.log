@@ -0,0 +1,26 @@
+def odd_count(lst):
+    result = []
+    s = ""
+    count = 0
+    count_string = ""
+    for s in lst:
+        count = (
+            s.count("1")
+            + s.count("3")
+            + s.count("5")
+            + s.count("7")
+            + s.count("9")
+        )
+        count_string = str(count)
+        result.append(
+            "the number of odd elements "
+            + count_string
+            + "n the str"
+            + count_string
+            + "ng "
+            + count_string
+            + " of the "
+            + count_string
+            + "nput."
+        )
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d99fb80e5cb2c3a58c3cf8ea8674faee214719e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,98 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [outer-loop-cons]:
+    <k>
+      #loop(
+        list(vCons(HEAD:Val, REST:ValSeq)),
+        Name("s"),
+        ODD-COUNT-LOOP-BODY)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "count" |-> (COUNT:Int => ?COUNT:Int)
+        "count_string" |-> (str(COUNTSTRING:IntSeq) => str(?COUNTSTRING:IntSeq))
+        "lst" |-> list(INPUT:ValSeq)
+        "result" |-> ref(0)
+        "s" |-> (S:Val => ?S:Val),
+        parent(0))
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(
+        ACC:ValSeq
+        =>
+        oddLinesAcc(ACC, vCons(HEAD, REST)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allDigitStrings(vCons(HEAD, REST))
+
+  claim [odd-count-empty]:
+    <k>
+      Call(Name("odd_count"), list(.ValSeq))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [odd-count-cons]:
+    <k>
+      Call(
+        Name("odd_count"),
+        list(vCons(HEAD:Val, REST:ValSeq)))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        oddLinesAcc(
+          .ValSeq,
+          vCons(HEAD, REST)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allDigitStrings(vCons(HEAD, REST))
+endmodule
