Module(
  FuncDef("odd_count", Params("lst"),
    Assign(Name("result"), ListExpr())
    Assign(Name("s"), Str(""))
    Assign(Name("count"), Int(0))
    Assign(Name("count_string"), Str(""))
    For(Name("s"), Name("lst"),
      Assign(
        Name("count"),
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                Call(Attribute(Name("s"), "count"), Str("1")),
                Call(Attribute(Name("s"), "count"), Str("3"))),
              Call(Attribute(Name("s"), "count"), Str("5"))),
            Call(Attribute(Name("s"), "count"), Str("7"))),
          Call(Attribute(Name("s"), "count"), Str("9"))))
      Assign(Name("count_string"), Call(Name("str"), Name("count")))
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      BinOp(
                        "+",
                        BinOp(
                          "+",
                          Str("the number of odd elements "),
                          Name("count_string")),
                        Str("n the str")),
                      Name("count_string")),
                    Str("ng ")),
                  Name("count_string")),
                Str(" of the ")),
              Name("count_string")),
            Str("nput.")))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr(Str("1234567"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 4n the str4ng 4 of the 4nput.")))))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr(Str("3"), Str("11111111"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 1n the str1ng 1 of the 1nput."),
          Str(
            "the number of odd elements 8n the str8ng 8 of the 8nput.")))))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr(Str(""), Str("135791357913"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 0n the str0ng 0 of the 0nput."),
          Str(
            "the number of odd elements 12n the str12ng 12 of the 12nput."))))))
