   426	  | SortVal.inj_SortIterable
   427	      (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq» values) =>
   428	      if method = "index" then
   429	        match args with
   430	        | SortVals.«_,__MPY-CORE_Vals_Val_Vals» sought
   431	            SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
   432	            match findValueIndex values sought 0 with
   433	            | some index => makeIntegerValue index
   434	            | none => SortVal.«noneV_MPY-CORE_Val»
   435	        | _ => SortVal.«noneV_MPY-CORE_Val»
   436	      else
