   421	            SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
   422	            makeIntegerValue (countValueOccurrences values sought)
   423	        | _ => SortVal.«noneV_MPY-CORE_Val»
