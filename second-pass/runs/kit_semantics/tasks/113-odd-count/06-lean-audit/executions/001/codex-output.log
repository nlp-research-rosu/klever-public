   442	            makeStringValue (md5HexadecimalSequence codes)
   443	        | _ => SortVal.«noneV_MPY-CORE_Val»
   444	      else
   445	        SortVal.«noneV_MPY-CORE_Val»
   446	  | _ => SortVal.«noneV_MPY-CORE_Val»
