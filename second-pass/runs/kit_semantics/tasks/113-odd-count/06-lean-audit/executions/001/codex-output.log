   410	def dispatchMethodMeaning
   411	    (receiver : SortVal) (method : SortString) (args : SortVals) : SortVal :=
   412	  match receiver with
   413	  | SortVal.inj_SortStr
   414	      (SortStr.«str(_)_MPY-CORE_Str_IntSeq» codes) =>
