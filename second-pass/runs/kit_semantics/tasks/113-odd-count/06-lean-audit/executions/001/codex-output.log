@@ -0,0 +1,85 @@
+import Proof
+
+namespace AuditOperational
+
+open Proof
+
+def nil : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def cons (head : SortInt) (tail : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail
+
+def one : SortIntSeq := cons 49 nil
+def two : SortIntSeq := cons 50 nil
+def oneOne : SortIntSeq := cons 49 one
+def oneOneOne : SortIntSeq := cons 49 oneOne
+def oneTwo : SortIntSeq := cons 49 two
+def oneTwoOneTwo : SortIntSeq := cons 49 (cons 50 (cons 49 two))
+
+def stringValue (codes : SortIntSeq) : SortVal :=
+  SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» codes)
+
+def oneStringArgument (codes : SortIntSeq) : SortVals :=
+  SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+    (stringValue codes)
+    SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+
+-- cntSub recurrence: base, empty-pattern, overlap, and two disjoint matches.
+example : «cntSub(_,_)_MPY-METHODS_Int_IntSeq_IntSeq» nil one = 0 := by
+  rfl
+
+example : «cntSub(_,_)_MPY-METHODS_Int_IntSeq_IntSeq» oneOneOne nil = 0 := by
+  rfl
+
+example : «cntSub(_,_)_MPY-METHODS_Int_IntSeq_IntSeq» oneOneOne one = 3 := by
+  rfl
+
+example : «cntSub(_,_)_MPY-METHODS_Int_IntSeq_IntSeq» oneOneOne oneOne = 1 := by
+  rfl
+
+example :
+    «cntSub(_,_)_MPY-METHODS_Int_IntSeq_IntSeq» oneTwoOneTwo oneTwo = 2 := by
+  rfl
+
+-- The recognizer distinguishes the supplied string constructor from values
+-- of other constructors.
+example : «isStringVal(_)_VERIFICATION-SYNTAX_Bool_Val» (stringValue one) = true := by
+  rfl
+
+example :
+    «isStringVal(_)_VERIFICATION-SYNTAX_Bool_Val»
+      (SortVal.inj_SortInt 49) = false := by
+  rfl
+
+-- The projection returns the exact code sequence, not a constant.
+example : stringCodes (stringValue oneTwo) = oneTwo := by
+  rfl
+
+-- The bound applyMethod implements the frozen string-count rule and
+-- distinguishes receivers. Unsupported receivers/methods do not fake count.
+example :
+    «applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals»
+        (stringValue oneTwoOneTwo) "count" (oneStringArgument oneTwo) =
+      SortVal.inj_SortInt 2 := by
+  rfl
+
+example :
+    «applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals»
+        (stringValue oneOneOne) "count" (oneStringArgument one) =
+      SortVal.inj_SortInt 3 := by
+  rfl
+
+example :
+    «applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals»
+        (SortVal.inj_SortInt 49) "count" (oneStringArgument one) =
+      SortVal.«noneV_MPY-CORE_Val» := by
+  rfl
+
+example :
+    «applyMethod(_,_,_)_MPY-METHODS_Val_Val_String_Vals»
+        (stringValue one) "unknown" (oneStringArgument one) =
+      SortVal.«noneV_MPY-CORE_Val» := by
+  rfl
+
+end AuditOperational
diff --git a//tmp/audit-work/proc_pid_shim.c b//tmp/audit-work/proc_pid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..82d190840ce610016326848149d305123300d3fd
--- /dev/null
+++ b//tmp/audit-work/proc_pid_shim.c
@@ -0,0 +1,63 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The command sandbox unshares the PID namespace but exposes the parent
+ * namespace's /proc. Lean 4.22 constructs /proc/<getpid()>/exe, so the normal
+ * namespace-local PID does not exist in the visible /proc. Return the outer
+ * PID reported by /proc/self/status to restore that path lookup.
+ */
+pid_t getpid(void) {
+    static pid_t outer_pid = 0;
+    static pid_t namespace_pid = 0;
+    static int is_lean_process = -1;
+    pid_t current_namespace_pid = (pid_t)syscall(SYS_getpid);
+
+    if (is_lean_process == -1) {
+        char executable[4096];
+        ssize_t length = readlink(
+            "/proc/self/exe", executable, sizeof(executable) - 1);
+        if (length > 0) {
+            executable[length] = '\0';
+            const char *base = strrchr(executable, '/');
+            base = base == NULL ? executable : base + 1;
+            is_lean_process = strcmp(base, "lean") == 0;
+        } else {
+            is_lean_process = 0;
+        }
+    }
+    if (!is_lean_process) {
+        return current_namespace_pid;
+    }
+
+    if (outer_pid != 0 && namespace_pid == current_namespace_pid) {
+        return outer_pid;
+    }
+
+    namespace_pid = current_namespace_pid;
+    outer_pid = 0;
+    FILE *status = fopen("/proc/self/status", "r");
+    if (status != NULL) {
+        char *line = NULL;
+        size_t capacity = 0;
+        while (getline(&line, &capacity, status) != -1) {
+            long parsed = 0;
+            if (sscanf(line, "Pid:\t%ld", &parsed) == 1 && parsed > 0) {
+                outer_pid = (pid_t)parsed;
+                break;
+            }
+        }
+        free(line);
+        fclose(status);
+    }
+
+    if (outer_pid == 0) {
+        outer_pid = current_namespace_pid;
+    }
+    return outer_pid;
+}
