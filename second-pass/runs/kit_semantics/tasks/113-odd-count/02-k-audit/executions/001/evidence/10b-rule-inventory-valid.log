DECL 0235 origin=SUPPLIED_FIXED kind=rule location=reference-semantics/semantics/call.k:80 attributes=-
  rule <k> #applyK(toCall(closureValC(PNS:ParamNames, CVS:ParamNames, BODY:Stmts, CM:Map)), ACC:Vals) ~> CONT
