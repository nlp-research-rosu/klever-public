       requires notBool isNaN(F) andBool notBool isInfinite(F) andBool N >=Int 0
        andBool absFloat(F) <Float 1000000000000.0
        andBool (absFloat(F) *Float Int2Float(10 ^Int N, 53, 11)) <Float 4500000000000000.0
        andBool exponentFloat(F) >Int -900 [concrete]

DECL 0595 origin=SUPPLIED_FIXED kind=rule location=reference-semantics/semantics/float.k:277 attributes=owise
