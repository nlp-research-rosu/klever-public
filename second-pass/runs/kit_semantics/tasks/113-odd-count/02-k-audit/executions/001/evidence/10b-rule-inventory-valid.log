       requires (isInt(A) orBool isBool(A) orBool isFloat(A))
        andBool (isInt(B) orBool isBool(B) orBool isFloat(B))

DECL 0278 origin=SUPPLIED_FIXED kind=rule location=reference-semantics/semantics/concrete.k:94 attributes=owise
