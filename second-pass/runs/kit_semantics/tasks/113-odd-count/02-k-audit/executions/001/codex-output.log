script -q -e -c 'python3 py2mpy.py auditor-concrete.py > auditor-concrete.mpy && kompile --backend llvm reference-semantics/semantics.k --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition fresh-runtime-kompiled' /audit-output/evidence/14-compile-concrete.log" in /tmp/audit-work/rebuild
