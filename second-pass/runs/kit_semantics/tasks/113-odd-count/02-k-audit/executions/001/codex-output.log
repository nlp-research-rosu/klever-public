DECL 0338 origin=SUPPLIED_FIXED kind=rule location=reference-semantics/semantics/core.k:85 attributes=priority
  rule <k> cellRef(H:Int) => V ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
       <heap> ... H |-> cellV(V:Val) ... </heap>
       requires "$cells" in_keys(M)
       [priority(40)]

