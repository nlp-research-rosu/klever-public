@@ -0,0 +1,43 @@
+requires "verification.k"
+
+module AUDITOR-BODY-MUTATION
+  imports VERIFICATION
+
+  // The actually bound and executed closure body now always returns [].
+  // The destination deliberately retains the original ["1"] result.
+  claim [changed-executed-body]:
+    <k>
+      Call(
+        Name("odd_count"),
+        list(vCons(str(iCons(49, .IntSeq)), .ValSeq)))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "odd_count" |->
+          closureVal(
+            "lst",
+            Assign(Name("result"), ListExpr(.Exprs))
+            Return(Name("result"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(
+          oddLine(iCons(49, .IntSeq)),
+          .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/auditor-concrete.py b/evidence/auditor-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..529bfc081b5c1d7bb9037ad428ce1f7f813bf7bb
--- /dev/null
+++ b/evidence/auditor-concrete.py
@@ -0,0 +1,36 @@
+def odd_count(lst):
+    result = []
+    s = ""
+    count = 0
+    count_string = ""
+    for s in lst:
+        count = (
+            s.count("1")
+            + s.count("3")
+            + s.count("5")
+            + s.count("7")
+            + s.count("9")
+        )
+        count_string = str(count)
+        result.append(
+            "the number of odd elements "
+            + count_string
+            + "n the str"
+            + count_string
+            + "ng "
+            + count_string
+            + " of the "
+            + count_string
+            + "nput."
+        )
+    return result
+
+
+assert odd_count([]) == []
+assert odd_count(["1"]) == [
+    "the number of odd elements 1n the str1ng 1 of the 1nput."
+]
+assert odd_count(["02468", "13579"]) == [
+    "the number of odd elements 0n the str0ng 0 of the 0nput.",
+    "the number of odd elements 5n the str5ng 5 of the 5nput.",
+]
diff --git a/evidence/auditor-count-opposite.k b/evidence/auditor-count-opposite.k
new file mode 100644
index 0000000000000000000000000000000000000000..c2200ec3f1c33b6c25dc874909e56d1a39fa673c
--- /dev/null
+++ b/evidence/auditor-count-opposite.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module AUDITOR-COUNT-OPPOSITE
+  imports MPY
+
+  // Fixed semantics says "11".count("1") is 2, not 1.
+  claim [false-count-interpretation]:
+    <k>
+      applyMethod(
+        str(iCons(49, iCons(49, .IntSeq))),
+        "count",
+        str(iCons(49, .IntSeq)),
+        .Vals)
+      =>
+      1
+    </k>
+endmodule
