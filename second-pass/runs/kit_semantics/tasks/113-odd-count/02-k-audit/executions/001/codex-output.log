+    if path.is_symlink()
+]
+print(f"candidate_symlink_count={len(symlinks)}")
+for rel in symlinks:
+    print(f"CANDIDATE_SYMLINK {rel}")
+
+required_candidate = [
+    "prompt.py",
+    "py2mpy.py",
+    "reference-semantics",
+    "solution.py",
+    "solution.mpy",
+    "spec.k",
+    "verification.k",
+]
+for rel in required_candidate:
+    path = candidate_root / rel
+    print(
