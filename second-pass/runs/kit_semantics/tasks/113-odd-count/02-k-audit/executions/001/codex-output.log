     1	# canonical.py — the UNMODIFIED HumanEval/113 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: odd_count
     4	
     5	
     6	def odd_count(lst):
     7	    """Given a list of strings, where each string consists of only digits, return a list.
     8	    Each element i of the output should be "the number of odd elements in the
     9	    string i of the input." where all the i's should be replaced by the number
    10	    of odd digits in the i'th string of the input.
    11	
    12	    >>> odd_count(['1234567'])
    13	    ["the number of odd elements 4n the str4ng 4 of the 4nput."]
    14	    >>> odd_count(['3',"11111111"])
    15	    ["the number of odd elements 1n the str1ng 1 of the 1nput.",
    16	     "the number of odd elements 8n the str8ng 8 of the 8nput."]
    17	    """
    18	    res = []
    19	    for arr in lst:
    20	        n = sum(int(d)%2==1 for d in arr)
    21	        res.append("the number of odd elements " + str(n) + "n the str"+ str(n) +"ng "+ str(n) +" of the "+ str(n) +"nput.")
    22	    return res
