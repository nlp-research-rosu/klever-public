/reference/reference-semantics/semantics/methods.k:44:  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
/reference/reference-semantics/semantics/methods.k:47:  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
/reference/reference-semantics/semantics/methods.k:48:  syntax IntSeq ::= trimWS(IntSeq) [function, total]
