index 0000000000000000000000000000000000000000..5f3de7e29b363151b2955b7e6b26a0a55f1baa96
--- /dev/null
+++ b//tmp/audit-work/odd-count-audit.XOEX9d/audit-bridge-complete-spec.k
@@ -0,0 +1,13 @@
+requires "audit-bridge-base.k"
+
+module AUDIT-BRIDGE-COMPLETE-SPEC
