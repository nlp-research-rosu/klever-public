/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib,itertools

def entries(root,dirs=False):
 r=Path(root); out=[]
 for p in sorted(r.rglob('*')):
  rel=p.relative_to(r).as_posix().encode()
  if p.is_file(): out.append((b'f',rel,p.read_bytes()))
  elif dirs and p.is_dir(): out.append((b'd',rel,b''))
 return out

def candidates(root,target):
 for dirs in [False,True]:
  es=entries(root,dirs)
  for content_kind in ['bytes','hex','raw']:
   for type_mode in ['none','char','word']:
    for pre in [b'',b'\\0',b'\\n']:
     for sep1 in [b'',b'\\0',b'\\n',b' ']:
      for sep2 in [b'',b'\\0',b'\\n',b'  ']:
       chunks=[]
       for typ,path,b in es:
        if content_kind=='hex': c=hashlib.sha256(b).hexdigest().encode()
        elif content_kind=='raw': c=hashlib.sha256(b).digest()
        else: c=b
        t=b'' if type_mode=='none' else (typ if type_mode=='char' else (b'file' if typ==b'f' else b'dir'))
        chunks.append(pre+t+sep1+path+sep2+c)
       h=hashlib.sha256(b''.join(chunks)).hexdigest()
       if h==target:
        print('MATCH',root,dirs,content_kind,type_mode,pre,sep1,sep2)
        return
 print('NO MATCH',root)
