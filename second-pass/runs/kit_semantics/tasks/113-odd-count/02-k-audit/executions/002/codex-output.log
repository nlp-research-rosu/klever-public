   294	  syntax EvPair ::= passMulE(EvPair) [function, total] | passAddE(EvPair) [function, total]
   295	  rule passMulE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("mul", N0, OPS, NDS, .OpSeq, .IntSeq)
   296	  rule passMulE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   297	  rule passAddE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("add", N0, OPS, NDS, .OpSeq, .IntSeq)
   298	  rule passAddE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   299	  syntax EvPair ::= passLGoE(String, Int, OpSeq, IntSeq, OpSeq, IntSeq) [function, total]
   300	  rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))
   301	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   302	    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)
   303	       requires inLevelE(L, O)
   304	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   305	    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))
   306	       requires notBool inLevelE(L, O)
   307	  rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)
   308	    => evp(OO, appendIE(ON, CUR)) [owise]
   309	  syntax Bool ::= inLevelE(String, String) [function, total]
   310	  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
   311	  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
   312	  rule inLevelE(_:String, _:String) => false [owise]
   313	  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
   314	  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
   315	  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))
   316	  syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]
   317	  rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)
   318	  rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))
   319	
   320	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   321	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   322	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   323	  syntax KItem ::= "#md5"
   324	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   325	       [priority(40)]
   326	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   327	  syntax Val ::= md5Obj(IntSeq)
   328	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   329	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   330	
   331	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   332	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   333	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   334	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   335	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   336	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   337	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   338	  rule isIntV(_:Int)         => true
   339	  // bool is a subtype of int in Python: isinstance(True, int) is True
   340	  rule isIntV(_:Bool)        => true
   341	  rule isIntV(_:Val)         => false [owise]
   342	  rule isStrV(str(_:IntSeq)) => true
   343	  rule isStrV(_:Val)         => false [owise]
   344	endmodule

