+#!/usr/bin/env bash
+set -uo pipefail
+
+audit_log=$1
+shift
+
+{
+  printf 'WORKDIR=%q\n' "$PWD"
+  printf 'COMMAND='
+  printf '%q ' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf 'EXIT_STATUS=%d\n' "$audit_status"
+} >"$audit_log" 2>&1
+
+exit "$audit_status"

exec
/bin/bash -lc 'cp audit-nonvacuity.k /audit-output/evidence/06_audit_nonvacuity.k
/audit-output/evidence/record_command.sh /audit-output/evidence/06_nonvacuity_dry_run.log kprove audit-nonvacuity.k --definition audit-verification-kompiled --spec-module AUDIT-NONVACUITY --dry-run' in /tmp/audit-work/odd-count-audit.XOEX9d
