from pathlib import Path
import hashlib,json

def test(root,targets):
    root=Path(root)
    fs=sorted(p for p in root.rglob('*') if p.is_file())
    rel=[p.relative_to(root).as_posix() for p in fs]
    bs=[p.read_bytes() for p in fs]
    hs=[hashlib.sha256(b).hexdigest() for b in bs]
    candidates={
      'concat-bytes':b''.join(bs),
      'concat-raw-digests':b''.join(hashlib.sha256(b).digest() for b in bs),
      'concat-hex-digests':''.join(hs).encode(),
      'lines-path-hash':''.join(f'{r} {h}\\n' for r,h in zip(rel,hs)).encode(),
      'lines-hash-path':''.join(f'{h}  {r}\\n' for r,h in zip(rel,hs)).encode(),
      'null-path-rawhash':b''.join(r.encode()+b'\\0'+hashlib.sha256(b).digest() for r,b in zip(rel,bs)),
      'null-path-hexhash':b''.join(r.encode()+b'\\0'+h.encode() for r,h in zip(rel,hs)),
      'null-path-bytes':b''.join(r.encode()+b'\\0'+b for r,b in zip(rel,bs)),
      'json':json.dumps(dict(zip(rel,hs)),sort_keys=True,separators=(',',':')).encode(),
      'json-list':json.dumps(list(zip(rel,hs)),separators=(',',':')).encode(),
    }
    print(root,len(fs))
    for n,b in candidates.items():
      h=hashlib.sha256(b).hexdigest()
      if h in targets: print('MATCH',n,h)
      else: print(n,h)

