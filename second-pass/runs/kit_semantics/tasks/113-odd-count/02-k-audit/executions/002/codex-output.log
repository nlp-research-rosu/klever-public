/audit-output/evidence/record_command.sh /audit-output/evidence/05_kprove_bridge_false.log kprove audit-bridge-false.k --definition audit-reference-kompiled --spec-module AUDIT-BRIDGE-FALSE' in /tmp/audit-work/odd-count-audit.XOEX9d
