diff --git a//tmp/procself.c b//tmp/procself.c
new file mode 100644
index 0000000000000000000000000000000000000000..c8815fa493623d0b5cd7af7e22d4da928b454f0e
--- /dev/null
+++ b//tmp/procself.c
@@ -0,0 +1,15 @@
+#define _GNU_SOURCE
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  const char *effective = path;
+  if (strncmp(path, "/proc/", 6) == 0) {
+    const char *suffix = strrchr(path, '/');
+    if (suffix != NULL && strcmp(suffix, "/exe") == 0) {
+      effective = "/proc/self/exe";
+    }
+  }
+  return syscall(SYS_readlink, effective, buffer, size);
+}
