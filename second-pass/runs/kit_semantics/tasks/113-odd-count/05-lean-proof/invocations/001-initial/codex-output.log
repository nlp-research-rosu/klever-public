/bin/bash -lc "rg -n '"'^'"\\s*(noncomputable\\s+)?def\\s+.*applyMethod' Proof.lean Proof || true
rg -n '"'^'"\\s*(noncomputable\\s+)?def\\s+.*cntSub' Proof.lean Proof || true
rg -n '"'^'"\\s*(noncomputable\\s+)?def\\s+.*isStringVal' Proof.lean Proof || true
