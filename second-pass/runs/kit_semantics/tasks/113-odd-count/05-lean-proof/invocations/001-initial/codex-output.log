diff --git a/Proof/Check.lean b/Proof/Check.lean
new file mode 100644
index 0000000000000000000000000000000000000000..9967ea9a69220ad0daa0cce4178724f31f891731
--- /dev/null
+++ b/Proof/Check.lean
@@ -0,0 +1,61 @@
+import Proof
+
+open Proof.Operational
+
+def checkToSequence : List Int → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | head :: tail =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+        head (checkToSequence tail)
+
+def checkFromSequence : SortIntSeq → List Int
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => []
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail =>
+      head :: checkFromSequence tail
+
+def checkString (codes : List Int) : SortVal :=
+  SortVal.inj_SortStr
+    (SortStr.«str(_)_MPY-CORE_Str_IntSeq» (checkToSequence codes))
+
+def checkNoArgs : SortVals :=
+  SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+
+def checkArg (value : SortVal) : SortVals :=
+  SortVals.«_,__MPY-CORE_Vals_Val_Vals» value checkNoArgs
+
+def checkValues : List SortVal → SortValSeq
+  | [] => SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+  | head :: tail =>
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+        head (checkValues tail)
+
+example :
+    dispatchMethodMeaning (checkString [65, 98]) "swapcase" checkNoArgs =
+      checkString [97, 66] := by rfl
+
+example :
+    dispatchMethodMeaning (checkString [97, 97, 97, 97]) "count"
+      (checkArg (checkString [97, 97])) = SortVal.inj_SortInt 2 := by
+  rfl
+
+example :
+    dispatchMethodMeaning
+      (SortVal.inj_SortIterable
+        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq»
+          (checkValues [SortVal.inj_SortInt 1, SortVal.inj_SortInt 2,
+            SortVal.inj_SortInt 1])))
+      "count" (checkArg (SortVal.inj_SortInt 1)) =
+      SortVal.inj_SortInt 2 := by
+  rfl
+
+example :
+    dispatchMethodMeaning
+      (SortVal.inj_SortIterable
+        (SortIterable.«tuple(_)_MPY-CORE_Iterable_ValSeq»
+          (checkValues [SortVal.inj_SortInt 4, SortVal.inj_SortInt 5])))
+      "index" (checkArg (SortVal.inj_SortInt 5)) =
+      SortVal.inj_SortInt 1 := by
+  rfl
+
+#eval checkFromSequence (md5HexadecimalSequence (checkToSequence [97, 98, 99]))
+#print axioms Proof.final
