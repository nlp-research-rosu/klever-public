rg -n '"'^'"\\s*rule applyMethod\\(' /reference/k-proof/reference-semantics /reference/k-proof/verification.k --glob '*.k'
rg -n 'method = \"(isupper|islower|isalpha|isdigit|lower|upper|swapcase|join|count|strip|encode|startswith|replace|index|hexdigest)\"' Proof/Operational.lean
