      "rationale": "Base equation for the recursively defined allInts domain predicate on the empty ValSeq.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 11,
      "text": "  rule allInts(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "d1d219f3427f5536073a572ec05d566def4e43ec32fddd6fbff02d536113eb4e",
      "rationale": "Constructor recurrence defining allInts by the head sort predicate and the recursively checked tail.",
      "source_rule_id": "rule-d1d219f3427f5536073a572ec05d566def4e43ec32fddd6fbff02d536113eb4e",
      "start_line": 12,
      "text": "  rule allInts(vCons(V:Val, VS:ValSeq))\n    => isInt(V) andBool allInts(VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
      "rationale": "Alias equation defining the named proof predicate definedProjectInt to be the existing isInt sort predicate.",
      "source_rule_id": "rule-9e2ee339875a1d59e60ef1a09d50617f8c526c60d097a2a486ebed2a648461c5",
      "start_line": 19,
      "text": "  rule definedProjectInt(V:Val) => isInt(V)"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "rationale": "Guarded defining equation for the new named proof term projectIntTotal, identifying it with the partial Val-to-Int cast on its defined domain.",
      "source_rule_id": "rule-ced5adecb9e0d364813f64698375904533f4eeac50b93f2799465c7b5fead6d0",
      "start_line": 28,
      "text": "  rule projectIntTotal(V:Val) => {V}:>Int\n    requires definedProjectInt(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
      "rationale": "Symbolic reverse orientation of the same guarded defining equality for the named projectIntTotal proof term.",
      "source_rule_id": "rule-22fa1e67d4a05b75b5a578312159b0a4e049b756806628df2540b007f43bcb5d",
      "start_line": 32,
      "text": "  rule {V:Val}:>Int => projectIntTotal(V)\n    requires definedProjectInt(V)\n    [symbolic(V), simplification, preserves-definedness]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "VERIFICATION",
      "normalized_sha256": "7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
      "rationale": "Static-sort defining case stating that projectIntTotal is the identity on an Int argument.",
      "source_rule_id": "rule-7191d5f6c9756673cca00b440958222ca4d2d1d3d4e18cbc994313a0f4340442",
      "start_line": 36,
      "text": "  rule projectIntTotal(I:Int) => I [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "72e5eac672dc42c33a08defca9cae94adfeb15589c8e4181a9bc48cdc32e7a63",
      "rationale": "Base equation defining the sumFrom left-fold summary on the empty ValSeq.",
      "source_rule_id": "rule-72e5eac672dc42c33a08defca9cae94adfeb15589c8e4181a9bc48cdc32e7a63",
      "start_line": 56,
      "text": "  rule sumFrom(.ValSeq, A:Int) => A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "7f9611f1ad40bdd1fce4065a2139931095c8d3af173a8dbcb75b95576da67c98",
      "rationale": "Structural recurrence defining sumFrom by adding the projected head to the accumulator and descending on the tail.",
      "source_rule_id": "rule-7f9611f1ad40bdd1fce4065a2139931095c8d3af173a8dbcb75b95576da67c98",
      "start_line": 57,
      "text": "  rule sumFrom(vCons(V:Val, VS:ValSeq), A:Int)\n    => sumFrom(VS, A +Int projectIntTotal(V))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 61,
      "module": "VERIFICATION",
      "normalized_sha256": "421bf17a6cbeb7277fb51e605cd8c239397335231755fe2e0b862ab38281bbc8",
      "rationale": "Base equation defining the productFrom left-fold summary on the empty ValSeq.",
      "source_rule_id": "rule-421bf17a6cbeb7277fb51e605cd8c239397335231755fe2e0b862ab38281bbc8",
      "start_line": 61,
      "text": "  rule productFrom(.ValSeq, A:Int) => A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 63,
      "module": "VERIFICATION",
      "normalized_sha256": "1e836dcf2b1df7f6322a01e54db668a6f35bbb7b27c89af9bd65f887168bade0",
      "rationale": "Structural recurrence defining productFrom by multiplying the accumulator by the projected head and descending on the tail.",
      "source_rule_id": "rule-1e836dcf2b1df7f6322a01e54db668a6f35bbb7b27c89af9bd65f887168bade0",
      "start_line": 62,
      "text": "  rule productFrom(vCons(V:Val, VS:ValSeq), A:Int)\n    => productFrom(VS, A *Int projectIntTotal(V))"
    }
