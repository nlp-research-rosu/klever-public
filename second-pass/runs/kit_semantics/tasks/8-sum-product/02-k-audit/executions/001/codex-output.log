+requires "verification.k"
+
+module SPEC-GROUND-WITNESS
+  imports VERIFICATION
+
+  // Satisfying entry witness: VS = [2, -3, 4], so allInts(VS) is true.
+  // The intended and concrete result is (3, -24).
+  claim [ground-entry-witness]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List", "Tuple")
+        FuncDef("sum_product", Params("numbers"),
+          Assign(Name("total"), Int(0))
+          Assign(Name("product"), Int(1))
+          For(Name("number"), Name("numbers"),
+            AugAssign(Name("total"), "+", Name("number"))
+            AugAssign(Name("product"), "*", Name("number")))
+          Return(TupleExpr(Name("total"), Name("product"))))
+      ))
+      ~> Call(Name("sum_product"),
+              list(vCons(2, vCons(-3, vCons(4, .ValSeq)))))
+      =>
+      tuple(vCons(3, vCons(-24, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        =>
+        "sum_product" |->
+          closureVal(
+            "numbers", .ParamNames,
+            Assign(Name("total"), Int(0))
+            Assign(Name("product"), Int(1))
+            For(Name("number"), Name("numbers"),
+              AugAssign(Name("total"), "+", Name("number"))
+              AugAssign(Name("product"), "*", Name("number")))
+            Return(TupleExpr(Name("total"), Name("product"))),
+            0
+          ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-helper-opposite.k b/evidence/spec-helper-opposite.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d7419c7f9e32b7ca3069a3b79ae5763386994d8
--- /dev/null
+++ b/evidence/spec-helper-opposite.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module SPEC-HELPER-OPPOSITE
