     3	module VERIFICATION
     4	  imports MPY
     5	  imports INT
     6	  imports BOOL
     7	
     8	  // Exact source-domain predicate: every element of the finite ValSeq is an
     9	  // integer.  Its two equations are disjoint and cover all ValSeq values.
    10	  syntax Bool ::= allInts(ValSeq) [function, total]
    11	  rule allInts(.ValSeq) => true
    12	  rule allInts(vCons(V:Val, VS:ValSeq))
    13	    => isInt(V) andBool allInts(VS)
    14	
    15	  // Guarded total twin of K's partial Val-to-Int subsort cast.  The #Ceil
    16	  // characterization and orientation pair make it usable only where isInt
    17	  // establishes definedness; no rule invents a value outside that domain.
    18	  syntax Bool ::= definedProjectInt(Val) [function, total]
    19	  rule definedProjectInt(V:Val) => isInt(V)
    20	
    21	  syntax Int ::= projectIntTotal(Val)
    22	    [function, total, symbol(projectIntTotal), no-evaluators]
    23	
    24	  rule #Ceil({@V:Val}:>Int)
    25	    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    26	    [simplification]
    27	
    28	  rule projectIntTotal(V:Val) => {V}:>Int
    29	    requires definedProjectInt(V)
    30	    [concrete, simplification(10), preserves-definedness]
    31	
    32	  rule {V:Val}:>Int => projectIntTotal(V)
    33	    requires definedProjectInt(V)
    34	    [symbolic(V), simplification, preserves-definedness]
    35	
    36	  rule projectIntTotal(I:Int) => I [simplification]
    37	  rule projectIntTotal(projectIntTotal(V:Val))
    38	    => projectIntTotal(V)
    39	    [simplification]
    40	
    41	  // Static-sort dispatch twins of the supplied MPY-INT equations.  The guards
    42	  // are exactly the original Int/Int match domain expressed dynamically.
    43	  rule applyBin("+", V:Val, W:Val)
    44	    => projectIntTotal(V) +Int projectIntTotal(W)
    45	    requires isInt(V) andBool isInt(W)
    46	    [simplification]
    47	
    48	  rule applyBin("*", V:Val, W:Val)
    49	    => projectIntTotal(V) *Int projectIntTotal(W)
    50	    requires isInt(V) andBool isInt(W)
    51	    [simplification]
    52	
    53	  // Mathematical left folds, including the empty identities.  The summaries
    54	  // are consumed only under allInts; each projected head is therefore defined.
    55	  syntax Int ::= sumFrom(ValSeq, Int) [function, total]
    56	  rule sumFrom(.ValSeq, A:Int) => A
    57	  rule sumFrom(vCons(V:Val, VS:ValSeq), A:Int)
