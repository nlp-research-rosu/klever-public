index 0000000000000000000000000000000000000000..f82c809e87bb31e724cd98d9ae249dd3f5a3e445
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,44 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+  imports BOOL
+
+  // Exact source-domain predicate: every element of the finite ValSeq is an
+  // integer.  Its two equations are disjoint and cover all ValSeq values.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, VS:ValSeq))
+    => isInt(V) andBool allInts(VS)
+
+  // Guarded total projection used only where allInts proves that a dynamic Val
+  // inhabits the Int subsort.  It cannot manufacture an Int for a non-Int Val.
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+  rule projectIntTotal(I:Int) => I [simplification]
+
+  // Static-sort dispatch twins of the supplied MPY-INT equations.  The guards
+  // are exactly the original Int/Int match domain expressed dynamically.
+  rule applyBin("+", V:Val, W:Val)
+    => projectIntTotal(V) +Int projectIntTotal(W)
+    requires isInt(V) andBool isInt(W)
+    [simplification]
+
+  rule applyBin("*", V:Val, W:Val)
+    => projectIntTotal(V) *Int projectIntTotal(W)
+    requires isInt(V) andBool isInt(W)
+    [simplification]
+
+  // Mathematical left folds, including the empty identities.  The summaries
+  // are consumed only under allInts; each projected head is therefore defined.
+  syntax Int ::= sumFrom(ValSeq, Int) [function, total]
+  rule sumFrom(.ValSeq, A:Int) => A
+  rule sumFrom(vCons(V:Val, VS:ValSeq), A:Int)
+    => sumFrom(VS, A +Int projectIntTotal(V))
+
+  syntax Int ::= productFrom(ValSeq, Int) [function, total]
+  rule productFrom(.ValSeq, A:Int) => A
+  rule productFrom(vCons(V:Val, VS:ValSeq), A:Int)
+    => productFrom(VS, A *Int projectIntTotal(V))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-invariant' in /workspace
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..caac84d5990870f77b9f090f5bf9186a09e1b035
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List, Tuple
+
+
+def sum_product(numbers: List[int]) -> Tuple[int, int]:
+    total = 0
+    product = 1
+    for number in numbers:
+        total += number
+        product *= number
+    return (total, product)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8f7d8d8a1c7248414fd6409b8f1a2d1d42c68ae8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,91 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Recurring for-loop head.  "number" is present after the first iteration;
+  // the entry claim executes that first step directly, then uses this
+  // circularity for the arbitrary remaining suffix.
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        AugAssign(Name("total"), "+", Name("number"))
+        AugAssign(Name("product"), "*", Name("number"))
+      )
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "number"  |-> (OLD:Int => ?LAST:Int)
+        "total"   |-> (S:Int => sumFrom(VS, S))
+        "product" |-> (P:Int => productFrom(VS, P))
+        REST:Map,
+        PARENT:Parent
+      )
+      ...
+    </scopes>
+    requires allInts(VS)
+     andBool notBool ("$cells" in_keys(REST))
+     andBool notBool (
+       "$cells" in_keys(
+         "number"  |-> OLD
+         "total"   |-> S
+         "product" |-> P
+         REST
+       )
+     )
+
+  // Full entry theorem.  It starts from the supplied semantics' initial state,
+  // loads the exact translated implementation, invokes the exact binding, and
+  // covers every finite IntSeq (equivalently, every finite list of integers).
+  claim [sum-product]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List", "Tuple")
+        FuncDef("sum_product", Params("numbers"),
+          Assign(Name("total"), Int(0))
+          Assign(Name("product"), Int(1))
+          For(Name("number"), Name("numbers"),
+            AugAssign(Name("total"), "+", Name("number"))
+            AugAssign(Name("product"), "*", Name("number")))
+          Return(TupleExpr(Name("total"), Name("product"))))
+      ))
+      ~> Call(Name("sum_product"), list(VS:ValSeq))
+      =>
+      tuple(vCons(sumFrom(VS, 0),
+            vCons(productFrom(VS, 1), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        =>
+        "sum_product" |->
+          closureVal(
+            "numbers", .ParamNames,
+            Assign(Name("total"), Int(0))
+            Assign(Name("product"), Int(1))
+            For(Name("number"), Name("numbers"),
+              AugAssign(Name("total"), "+", Name("number"))
+              AugAssign(Name("product"), "*", Name("number")))
+            Return(TupleExpr(Name("total"), Name("product"))),
+            0
+          ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
