+  claim [false-postcondition]:
+    <k>
+      Call(
+        Name("sum_product"),
+        list(vCons(2, vCons(3, .ValSeq)))
+      )
+      =>
+      tuple(vCons(6, vCons(6, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "sum_product" |->
+          closureVal(
+            "numbers", .ParamNames,
+            Assign(Name("total"), Int(0))
+            Assign(Name("product"), Int(1))
+            For(Name("number"), Name("numbers"),
+              AugAssign(Name("total"), "+", Name("number"))
+              AugAssign(Name("product"), "*", Name("number")))
+            Return(TupleExpr(Name("total"), Name("product"))),
+            0
+          ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5948d0f518a9e145b95f0632442604a291d1d7a2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,83 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Recurring for-loop head.  "number" is present after the first iteration;
+  // the entry claim executes that first step directly, then uses this
+  // circularity for the arbitrary remaining suffix.
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        AugAssign(Name("total"), "+", Name("number"))
+        AugAssign(Name("product"), "*", Name("number"))
+      )
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "numbers" |-> list(INPUT:ValSeq)
+        "number"  |-> (OLD:Val => ?LAST:Val)
+        "total"   |-> (S:Int => sumFrom(VS, S))
+        "product" |-> (P:Int => productFrom(VS, P))
+        .Map,
+        parent(0)
+      )
+      ...
+    </scopes>
+    requires allInts(VS)
+
+  // Full entry theorem.  It starts from the supplied semantics' initial state,
+  // loads the exact translated implementation, invokes the exact binding, and
+  // covers every finite ValSeq whose elements are all semantic Int values.
+  claim [sum-product]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List", "Tuple")
+        FuncDef("sum_product", Params("numbers"),
+          Assign(Name("total"), Int(0))
+          Assign(Name("product"), Int(1))
+          For(Name("number"), Name("numbers"),
+            AugAssign(Name("total"), "+", Name("number"))
+            AugAssign(Name("product"), "*", Name("number")))
+          Return(TupleExpr(Name("total"), Name("product"))))
+      ))
+      ~> Call(Name("sum_product"), list(VS:ValSeq))
+      =>
+      tuple(vCons(sumFrom(VS, 0),
+            vCons(productFrom(VS, 1), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        =>
+        "sum_product" |->
+          closureVal(
+            "numbers", .ParamNames,
+            Assign(Name("total"), Int(0))
+            Assign(Name("product"), Int(1))
+            For(Name("number"), Name("numbers"),
+              AugAssign(Name("total"), "+", Name("number"))
+              AugAssign(Name("product"), "*", Name("number")))
+            Return(TupleExpr(Name("total"), Name("product"))),
+            0
+          ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..59df2e4f59df4215d4b9621e17ac0aab2f53341f
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,36 @@
+from itertools import product
+from math import prod
+
+from solution import sum_product
+
+
+checked = 0
+mismatches = []
+
+for length in range(6):
+    for values in product(range(-3, 4), repeat=length):
+        numbers = list(values)
+        expected = (sum(numbers), prod(numbers))
+        actual = sum_product(numbers)
+        checked += 1
+        if actual != expected:
+            mismatches.append((numbers, expected, actual))
+
+extra_cases = [
+    [10**30, -(10**30), 7],
+    [-(10**20), -(10**20)],
+    [0, -(10**40), 10**40],
+]
+
+for numbers in extra_cases:
+    expected = (sum(numbers), prod(numbers))
+    actual = sum_product(numbers)
+    checked += 1
+    if actual != expected:
+        mismatches.append((numbers, expected, actual))
+
+print(f"checked={checked} mismatches={len(mismatches)}")
+if mismatches:
+    for mismatch in mismatches[:10]:
+        print(mismatch)
+    raise SystemExit(1)
