diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..84bb625b07f93465107f714957c71b8f6df67250
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,80 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Recurring for-loop head.  "number" is present after the first iteration;
+  // the entry claim executes that first step directly, then uses this
+  // circularity for the arbitrary remaining suffix.
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(intVals(IS:IntSeq)),
+        Name("number"),
+        AugAssign(Name("total"), "+", Name("number"))
+        AugAssign(Name("product"), "*", Name("number"))
+      )
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "number"  |-> (OLD:Int => ?LAST:Int)
+        "total"   |-> (S:Int => sumFrom(IS, S))
+        "product" |-> (P:Int => productFrom(IS, P))
+        REST:Map,
+        PARENT:Parent
+      )
+      ...
+    </scopes>
+
+  // Full entry theorem.  It starts from the supplied semantics' initial state,
+  // loads the exact translated implementation, invokes the exact binding, and
+  // covers every finite IntSeq (equivalently, every finite list of integers).
+  claim [sum-product]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List", "Tuple")
+        FuncDef("sum_product", Params("numbers"),
+          Assign(Name("total"), Int(0))
+          Assign(Name("product"), Int(1))
+          For(Name("number"), Name("numbers"),
+            AugAssign(Name("total"), "+", Name("number"))
+            AugAssign(Name("product"), "*", Name("number")))
+          Return(TupleExpr(Name("total"), Name("product"))))
+      ))
+      ~> Call(Name("sum_product"), list(intVals(IS:IntSeq)))
+      =>
+      tuple(vCons(sumFrom(IS, 0),
+            vCons(productFrom(IS, 1), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        .Map
+        =>
+        "sum_product" |->
+          closureVal(
+            "numbers", .ParamNames,
+            Assign(Name("total"), Int(0))
+            Assign(Name("product"), Int(1))
+            For(Name("number"), Name("numbers"),
+              AugAssign(Name("total"), "+", Name("number"))
+              AugAssign(Name("product"), "*", Name("number")))
+            Return(TupleExpr(Name("total"), Name("product"))),
+            0
+          ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fce0949651386f40d85404e9de8afb980439ca47
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports INT
+
+  // A bijective representation of finite sequences of mathematical integers
+  // as the ValSeq used by the supplied Python list semantics.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS))
+
+  // Left folds specifying the sum and product, including their empty
+  // identities.  Parameterizing by the accumulator makes the loop
+  // circularity's one-step obligation definitional.
+  syntax Int ::= sumFrom(IntSeq, Int) [function, total]
+  rule sumFrom(.IntSeq, A:Int) => A
+  rule sumFrom(iCons(I:Int, IS:IntSeq), A:Int)
+    => sumFrom(IS, A +Int I)
+
+  syntax Int ::= productFrom(IntSeq, Int) [function, total]
+  rule productFrom(.IntSeq, A:Int) => A
+  rule productFrom(iCons(I:Int, IS:IntSeq), A:Int)
+    => productFrom(IS, A *Int I)
+endmodule

