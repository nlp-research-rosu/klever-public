Module(
  ImportFrom("typing", "List", "Tuple")
  FuncDef("sum_product", Params("numbers"),
    Assign(Name("total"), Int(0))
    Assign(Name("product"), Int(1))
    For(Name("number"), Name("numbers"),
      AugAssign(Name("total"), "+", Name("number"))
      AugAssign(Name("product"), "*", Name("number")))
    Return(TupleExpr(Name("total"), Name("product"))))
  Assign(Name("empty_result"), Call(Name("sum_product"), ListExpr()))
  Assign(
    Name("example_result"),
    Call(Name("sum_product"), ListExpr(Int(1), Int(2), Int(3), Int(4))))
  Assign(
    Name("signed_result"),
    Call(
      Name("sum_product"),
      ListExpr(UnaryOp("-", Int(2)), Int(3), UnaryOp("-", Int(4)))))
  Assign(
    Name("zero_result"),
    Call(Name("sum_product"), ListExpr(Int(0), Int(99)))))
