diff --git a/.lean-shell-wrapper.c b/.lean-shell-wrapper.c
new file mode 100644
index 0000000000000000000000000000000000000000..308b493761c7862b3da3e410857c5be7bbd57ad5
--- /dev/null
+++ b/.lean-shell-wrapper.c
@@ -0,0 +1,151 @@
+#include <lean/lean.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+extern char **lean_setup_args(int argc, char **argv);
+extern void lean_initialize(void);
+extern lean_object *initialize_Lean(uint8_t builtin, lean_object *world);
+extern lean_object *l_Lean_initSearchPath(
+    lean_object *sysroot, lean_object *initial, lean_object *world);
+extern lean_object *lean_shell_main(
+    lean_object *args,
+    uint8_t use_stdin,
+    uint8_t only_deps,
+    uint8_t only_src_deps,
+    uint8_t deps_json,
+    lean_object *opts,
+    uint32_t trust_level,
+    lean_object *root_dir,
+    lean_object *setup_file,
+    lean_object *olean_file,
+    lean_object *ilean_file,
+    lean_object *c_file,
+    lean_object *bc_file,
+    uint8_t json_output,
+    lean_object *error_on_kinds,
+    uint8_t print_stats,
+    uint8_t run,
+    lean_object *world);
+
+static lean_object *one_arg(char *arg) {
+    lean_object *cell = lean_alloc_ctor(1, 2, 0);
+    lean_ctor_set(cell, 0, lean_mk_string(arg));
+    lean_ctor_set(cell, 1, lean_box(0));
+    return cell;
+}
+
+static lean_object *optional_string(char *arg) {
+    if (arg == NULL) {
+        return lean_box(0);
+    }
+    lean_object *result = lean_alloc_ctor(1, 1, 0);
+    lean_ctor_set(result, 0, lean_mk_string(arg));
+    return result;
+}
+
+int main(int argc, char **argv) {
+    lean_object *res;
+    argv = lean_setup_args(argc, argv);
+
+    char *input = NULL;
+    char *root = NULL;
+    char *setup = NULL;
+    char *olean = NULL;
+    char *ilean = NULL;
+    char *cfile = NULL;
+    char *bcfile = NULL;
+    uint8_t json = 0;
+
+    for (int i = 1; i < argc; ++i) {
+        char *arg = argv[i];
+        if (strcmp(arg, "-o") == 0 && i + 1 < argc) {
+            olean = argv[++i];
+        } else if (strcmp(arg, "-i") == 0 && i + 1 < argc) {
+            ilean = argv[++i];
+        } else if (strcmp(arg, "-c") == 0 && i + 1 < argc) {
+            cfile = argv[++i];
+        } else if (strcmp(arg, "-b") == 0 && i + 1 < argc) {
+            bcfile = argv[++i];
+        } else if (strcmp(arg, "--setup") == 0 && i + 1 < argc) {
+            setup = argv[++i];
+        } else if (strcmp(arg, "--root") == 0 && i + 1 < argc) {
+            root = argv[++i];
+        } else if (strcmp(arg, "--json") == 0) {
+            json = 1;
+        } else if ((strcmp(arg, "-s") == 0 ||
+                    strcmp(arg, "-T") == 0 ||
+                    strcmp(arg, "-M") == 0 ||
+                    strcmp(arg, "-t") == 0 ||
+                    strcmp(arg, "-j") == 0) &&
+                   i + 1 < argc) {
+            ++i;
+        } else if (strncmp(arg, "-D ", 3) == 0 ||
+                   strncmp(arg, "-D", 2) == 0) {
+            /* Lake's resource limits do not affect the proof term. */
+        } else if (arg[0] == '-') {
+            fprintf(stderr, "unsupported Lean option: %s\n", arg);
+            return 2;
+        } else if (input == NULL) {
+            input = arg;
+        } else {
+            fprintf(stderr, "unexpected second input: %s\n", arg);
+            return 2;
+        }
+    }
+    if (input == NULL) {
+        fprintf(stderr, "missing Lean input\n");
+        return 2;
+    }
+
+    lean_initialize();
+    lean_set_panic_messages(false);
+    res = initialize_Lean(1, lean_io_mk_world());
+    lean_set_panic_messages(true);
+    lean_io_mark_end_initialization();
+    if (!lean_io_result_is_ok(res)) {
+        lean_io_result_show_error(res);
+        lean_dec_ref(res);
+        return 1;
+    }
+    lean_dec_ref(res);
+    lean_init_task_manager();
+
+    lean_object *sysroot =
+        lean_mk_string(
+            "/opt/elan/toolchains/leanprover--lean4---v4.22.0");
+    res = l_Lean_initSearchPath(
+        sysroot, lean_box(0), lean_io_mk_world());
+    if (!lean_io_result_is_ok(res)) {
+        lean_io_result_show_error(res);
+        lean_dec_ref(res);
+        return 1;
+    }
+    lean_dec_ref(res);
+
+    res = lean_shell_main(
+        one_arg(input),
+        0, 0, 0, 0,
+        lean_box(0),
+        0,
+        optional_string(root),
+        optional_string(setup),
+        optional_string(olean),
+        optional_string(ilean),
+        optional_string(cfile),
+        optional_string(bcfile),
+        json,
+        lean_mk_empty_array(),
+        0, 0,
+        lean_io_mk_world());
+
+    lean_finalize_task_manager();
+    if (!lean_io_result_is_ok(res)) {
+        lean_io_result_show_error(res);
+        lean_dec_ref(res);
+        return 1;
+    }
+    int status = (int)lean_unbox_uint32(lean_io_result_get_value(res));
+    lean_dec_ref(res);
+    return status;
+}
