chmod +x /workspace/.lean-cli-shim
mkdir -p /workspace/.lake-install/.lake/build/bin /workspace/.lake-install/.lake/build/lib
ln -sf /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake /workspace/.lake-install/.lake/build/bin/lake
ln -sf /workspace/.lean-cli-shim /workspace/.lake-install/.lake/build/bin/lean
ln -sfn /opt/elan/toolchains/leanprover--lean4---v4.22.0/lib/lean /workspace/.lake-install/.lake/build/lib/lean
LAKE_HOME=/workspace/.lake-install LEAN_SYSROOT=/opt/elan/toolchains/leanprover--lean4---v4.22.0 /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake build
status=$?
echo LAKE_SHIM_PROBE_EXIT=$status
exit 0' in /workspace
