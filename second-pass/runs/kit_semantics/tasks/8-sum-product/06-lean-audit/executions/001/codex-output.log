requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY
  imports INT
  imports BOOL

  // Exact source-domain predicate: every element of the finite ValSeq is an
  // integer.  Its two equations are disjoint and cover all ValSeq values.
  syntax Bool ::= allInts(ValSeq) [function, total]
  rule allInts(.ValSeq) => true
  rule allInts(vCons(V:Val, VS:ValSeq))
    => isInt(V) andBool allInts(VS)

  // Guarded total twin of K's partial Val-to-Int subsort cast.  The #Ceil
  // characterization and orientation pair make it usable only where isInt
  // establishes definedness; no rule invents a value outside that domain.
  syntax Bool ::= definedProjectInt(Val) [function, total]
  rule definedProjectInt(V:Val) => isInt(V)

  syntax Int ::= projectIntTotal(Val)
    [function, total, symbol(projectIntTotal), no-evaluators]

  rule #Ceil({@V:Val}:>Int)
    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
    [simplification]

  rule projectIntTotal(V:Val) => {V}:>Int
    requires definedProjectInt(V)
    [concrete, simplification(10), preserves-definedness]

  rule {V:Val}:>Int => projectIntTotal(V)
    requires definedProjectInt(V)
    [symbolic(V), simplification, preserves-definedness]

  rule projectIntTotal(I:Int) => I [simplification]
  rule projectIntTotal(projectIntTotal(V:Val))
    => projectIntTotal(V)
    [simplification]

  // Static-sort dispatch twins of the supplied MPY-INT equations.  The guards
  // are exactly the original Int/Int match domain expressed dynamically.
  rule applyBin("+", V:Val, W:Val)
    => projectIntTotal(V) +Int projectIntTotal(W)
    requires isInt(V) andBool isInt(W)
    [simplification]

  rule applyBin("*", V:Val, W:Val)
    => projectIntTotal(V) *Int projectIntTotal(W)
    requires isInt(V) andBool isInt(W)
    [simplification]

  // Mathematical left folds, including the empty identities.  The summaries
  // are consumed only under allInts; each projected head is therefore defined.
  syntax Int ::= sumFrom(ValSeq, Int) [function, total]
  rule sumFrom(.ValSeq, A:Int) => A
  rule sumFrom(vCons(V:Val, VS:ValSeq), A:Int)
    => sumFrom(VS, A +Int projectIntTotal(V))

  syntax Int ::= productFrom(ValSeq, Int) [function, total]
  rule productFrom(.ValSeq, A:Int) => A
  rule productFrom(vCons(V:Val, VS:ValSeq), A:Int)
    => productFrom(VS, A *Int projectIntTotal(V))
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Recurring for-loop head.  "number" is present after the first iteration;
  // the entry claim executes that first step directly, then uses this
  // circularity for the arbitrary remaining suffix.
  claim [loop-invariant]:
    <k>
      #loop(
        list(VS:ValSeq),
        Name("number"),
        AugAssign(Name("total"), "+", Name("number"))
        AugAssign(Name("product"), "*", Name("number"))
      )
      => .K
      ...
    </k>
    <env> L:Int </env>
    <scopes>
      ...
      L |-> scope(
        "numbers" |-> list(INPUT:ValSeq)
        "number"  |-> (OLD:Val => ?LAST:Val)
        "total"   |-> (S:Int => sumFrom(VS, S))
        "product" |-> (P:Int => productFrom(VS, P))
        .Map,
        parent(0)
      )
      ...
    </scopes>
    requires allInts(VS)

  // Full entry theorem.  It starts from the supplied semantics' initial state,
  // loads the exact translated implementation, invokes the exact binding, and
  // covers every finite ValSeq whose elements are all semantic Int values.
  claim [sum-product]:
    <k>
      #loadAll(Module(
        ImportFrom("typing", "List", "Tuple")
        FuncDef("sum_product", Params("numbers"),
          Assign(Name("total"), Int(0))
          Assign(Name("product"), Int(1))
          For(Name("number"), Name("numbers"),
            AugAssign(Name("total"), "+", Name("number"))
            AugAssign(Name("product"), "*", Name("number")))
          Return(TupleExpr(Name("total"), Name("product"))))
      ))
      ~> Call(Name("sum_product"), list(VS:ValSeq))
      =>
      tuple(vCons(sumFrom(VS, 0),
            vCons(productFrom(VS, 1), .ValSeq)))
    </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope(
        .Map
        =>
        "sum_product" |->
          closureVal(
            "numbers", .ParamNames,
            Assign(Name("total"), Int(0))
            Assign(Name("product"), Int(1))
            For(Name("number"), Name("numbers"),
              AugAssign(Name("total"), "+", Name("number"))
              AugAssign(Name("product"), "*", Name("number")))
            Return(TupleExpr(Name("total"), Name("product"))),
            0
          ),
        parent(-1)
      )
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(VS)
endmodule
from typing import List, Tuple


def sum_product(numbers: List[int]) -> Tuple[int, int]:
    total = 0
    product = 1
    for number in numbers:
        total += number
        product *= number
    return (total, product)
Module(
  ImportFrom("typing", "List", "Tuple")
  FuncDef("sum_product", Params("numbers"),
    Assign(Name("total"), Int(0))
    Assign(Name("product"), Int(1))
    For(Name("number"), Name("numbers"),
      AugAssign(Name("total"), "+", Name("number"))
      AugAssign(Name("product"), "*", Name("number")))
    Return(TupleExpr(Name("total"), Name("product")))))
from typing import List, Tuple


def sum_product(numbers: List[int]) -> Tuple[int, int]:
    """ For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.
    Empty sum should be equal to 0 and empty product should be equal to 1.
    >>> sum_product([])
    (0, 1)
    >>> sum_product([1, 2, 3, 4])
    (10, 24)
    """
#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

python3 py2mpy.py solution.py > solution.mpy
cmp solution.mpy <(python3 py2mpy.py solution.py)

python3 py2mpy.py smoke.py > smoke.mpy

kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition semantics-kompiled

krun smoke.mpy --definition semantics-kompiled

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

python3 test_solution.py

set +e
kprove spec-vacuity.k \
  --definition verification-kompiled \
  --spec-module SPEC-VACUITY
vacuity_status=$?

kprove spec-body-mutation.k \
  --definition verification-kompiled \
  --spec-module SPEC-BODY-MUTATION
body_mutation_status=$?
set -e

echo "VACUITY_EXIT=$vacuity_status (expected non-zero)"
echo "BODY_MUTATION_EXIT=$body_mutation_status (expected non-zero)"

if [[ $vacuity_status -eq 0 || $body_mutation_status -eq 0 ]]; then
  echo "A negative validation probe unexpectedly proved." >&2
  exit 1
fi

exec
/bin/bash -lc "rg -n -C 4 'project:Int|applyBin\\(\"\\+\"|applyBin\\(\"\\*\"|syntax Val ::= Int|Int\\) \\[|isInt' /reference/k-proof/reference-semantics/semantics /reference/k-proof/reference-semantics/semantics.k | head -320" in /audit-output
