  | "-", SortVal.inj_SortInt a, SortVal.inj_SortFloat b =>
      SortVal.inj_SortFloat (Float.ofInt a - b)
  | "-", SortVal.inj_SortFloat a, SortVal.inj_SortInt b =>
      SortVal.inj_SortFloat (a - Float.ofInt b)
  | "*", SortVal.inj_SortInt a, SortVal.inj_SortFloat b =>
      SortVal.inj_SortFloat (Float.ofInt a * b)
  | "*", SortVal.inj_SortFloat a, SortVal.inj_SortInt b =>
      SortVal.inj_SortFloat (a * Float.ofInt b)
  | "/", SortVal.inj_SortInt a, SortVal.inj_SortFloat b =>
      SortVal.inj_SortFloat (Float.ofInt a / b)
  | "/", SortVal.inj_SortFloat a, SortVal.inj_SortInt b =>
      SortVal.inj_SortFloat (a / Float.ofInt b)
  | "**", SortVal.inj_SortInt a, SortVal.inj_SortFloat b =>
      SortVal.inj_SortFloat (Float.ofInt a ^ b)
