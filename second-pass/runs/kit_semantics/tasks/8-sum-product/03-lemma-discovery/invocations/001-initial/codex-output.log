+      "classification": "DEFINITION",
+      "rationale": "Static-sort defining case stating that projectIntTotal is the identity on an Int argument."
+    },
+    {
+      "source_rule_id": "rule-9e1486b6d25b62bd0949213fd58d7aac97ed89cc3e87b8c5063f915d1d6b7081",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "Idempotence is an additional reusable simplification fact about projectIntTotal, not a constructor case; it is present during all Stage 1 proofs and is never first proved without itself."
+    },
+    {
+      "source_rule_id": "rule-3efffca8ed723c4a95578d5fda655b02240729a8ee1b5bd9b6eaab14655f86c0",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "Trusted widened-sort simplification for applyBin addition under isInt guards; although Stage 1 calls it derived, prove.sh never proves this exact rule against a definition that omits it."
+    },
+    {
+      "source_rule_id": "rule-85c5006f98f122cfdf76b29a11f55cc1643ff616b63512d8cd829b4edc9287c4",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "Trusted widened-sort simplification for applyBin multiplication under isInt guards; it is compiled into the proof definition before kprove and has no separate rule-free proof."
+    },
+    {
+      "source_rule_id": "rule-72e5eac672dc42c33a08defca9cae94adfeb15589c8e4181a9bc48cdc32e7a63",
+      "classification": "DEFINITION",
+      "rationale": "Base equation defining the sumFrom left-fold summary on the empty ValSeq."
+    },
+    {
+      "source_rule_id": "rule-7f9611f1ad40bdd1fce4065a2139931095c8d3af173a8dbcb75b95576da67c98",
+      "classification": "DEFINITION",
+      "rationale": "Structural recurrence defining sumFrom by adding the projected head to the accumulator and descending on the tail."
+    },
+    {
+      "source_rule_id": "rule-421bf17a6cbeb7277fb51e605cd8c239397335231755fe2e0b862ab38281bbc8",
