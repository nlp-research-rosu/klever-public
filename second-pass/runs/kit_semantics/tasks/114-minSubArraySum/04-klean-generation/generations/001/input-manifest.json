      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "Base equation defining the structural predicate allInts on the empty ValSeq.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 9,
      "text": "  rule allInts(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "6316a60ea115abdbe8e03d39d302e43ceea73cd9fedd27a98872c76b5b811b42",
      "rationale": "Recursive equation defining allInts on a cons by testing the head and recursively checking the tail.",
      "source_rule_id": "rule-6316a60ea115abdbe8e03d39d302e43ceea73cd9fedd27a98872c76b5b811b42",
      "start_line": 10,
      "text": "  rule allInts(vCons(V:Val, XS:ValSeq)) => isInt(V) andBool allInts(XS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "537b55658be09522e9ef565d2ec69183fd6fbd782b54c8d1b5dd24667acbd3aa",
      "rationale": "Base equation defining the named kadaneCurrent summary on an empty suffix.",
      "source_rule_id": "rule-537b55658be09522e9ef565d2ec69183fd6fbd782b54c8d1b5dd24667acbd3aa",
      "start_line": 23,
      "text": "  rule kadaneCurrent(.ValSeq, C:Int) => C"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "a4eb647db56262adb78bb0c7a909b63ee0acc886d9d451ca5de28976ba45ea55",
      "rationale": "Recursive equation defining kadaneCurrent by consuming one integer-valued head and updating the running suffix minimum.",
      "source_rule_id": "rule-a4eb647db56262adb78bb0c7a909b63ee0acc886d9d451ca5de28976ba45ea55",
      "start_line": 24,
      "text": "  rule kadaneCurrent(vCons(V:Val, XS:ValSeq), C:Int)\n    => kadaneCurrent(\n         XS,\n         minInt({V}:>Int, C +Int {V}:>Int))\n    requires isInt(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "0fb2ff70d1d771be4491e1d1d3d07c7bb4778cb5ac74c239f4b9ade2421d3d71",
      "rationale": "Base equation defining the named kadaneMinimum summary on an empty suffix.",
      "source_rule_id": "rule-0fb2ff70d1d771be4491e1d1d3d07c7bb4778cb5ac74c239f4b9ade2421d3d71",
      "start_line": 31,
      "text": "  rule kadaneMinimum(.ValSeq, _C:Int, B:Int) => B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 37,
      "module": "VERIFICATION",
      "normalized_sha256": "db274c9f572feeb0ce3aedc0579c3303eb84577ca9baa4e5034eed5a969803f6",
      "rationale": "Recursive equation defining kadaneMinimum by consuming one integer-valued head and updating the current and global minima.",
      "source_rule_id": "rule-db274c9f572feeb0ce3aedc0579c3303eb84577ca9baa4e5034eed5a969803f6",
      "start_line": 32,
      "text": "  rule kadaneMinimum(vCons(V:Val, XS:ValSeq), C:Int, B:Int)\n    => kadaneMinimum(\n         XS,\n         minInt({V}:>Int, C +Int {V}:>Int),\n         minInt(B, minInt({V}:>Int, C +Int {V}:>Int)))\n    requires isInt(V)"
    }
  ],
