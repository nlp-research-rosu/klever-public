+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Embed an IntSeq as the ValSeq used by the Python-list semantics.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS))
+
+  // Exact Kadane-fold summaries for the unprocessed suffix.
+  syntax Int ::= kadaneCurrent(IntSeq, Int) [function, total]
+  rule kadaneCurrent(.IntSeq, C:Int) => C
+  rule kadaneCurrent(iCons(X:Int, XS:IntSeq), C:Int)
+    => kadaneCurrent(XS, minInt(X, C +Int X))
+
+  syntax Int ::= kadaneMinimum(IntSeq, Int, Int) [function, total]
+  rule kadaneMinimum(.IntSeq, _C:Int, B:Int) => B
+  rule kadaneMinimum(iCons(X:Int, XS:IntSeq), C:Int, B:Int)
+    => kadaneMinimum(
+         XS,
+         minInt(X, C +Int X),
+         minInt(B, minInt(X, C +Int X)))
+
+  // The for-loop retains its previous target value if the suffix is empty.
+  syntax Int ::= lastAfter(IntSeq, Int) [function, total]
+  rule lastAfter(.IntSeq, OLD:Int) => OLD
+  rule lastAfter(iCons(X:Int, XS:IntSeq), _OLD:Int)
+    => lastAfter(XS, X)
+endmodule
*** Add File: /workspace/spec.k
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(intVals(IS:IntSeq)),
+        Name("value"),
+        Assign(
+          Name("current"),
+          Call(
+            Name("min"),
+            Name("value"),
+            BinOp("+", Name("current"), Name("value"))))
+        Assign(
+          Name("minimum"),
+          Call(Name("min"), Name("minimum"), Name("current"))))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 
