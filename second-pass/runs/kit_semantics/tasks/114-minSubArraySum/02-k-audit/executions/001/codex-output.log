diff --git a/evidence/audit-fixed-dispatch-spec.k b/evidence/audit-fixed-dispatch-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5431e6cdd0d72c34ac1790a056824043063a6da2
--- /dev/null
+++ b/evidence/audit-fixed-dispatch-spec.k
@@ -0,0 +1,38 @@
+requires "audit-connection-verification.k"
+
+module AUDIT-FIXED-DISPATCH-SPEC
+  imports AUDIT-CONNECTION-VERIFICATION
