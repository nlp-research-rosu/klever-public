     6	  // The formal input domain is exactly the finite ValSeq values whose elements
     7	  // are Python integers.
     8	  syntax Bool ::= allInts(ValSeq) [function, total]
     9	  rule allInts(.ValSeq) => true
    10	  rule allInts(vCons(V:Val, XS:ValSeq)) => isInt(V) andBool allInts(XS)
    11	
    12	  rule applyBin("+", I:Int, V:Val) => I +Int {V}:>Int
    13	    requires isInt(V)
    14	    [simplification]
    15	
    16	  rule applyBuiltin("min", V:Val, I:Int, .Vals)
    17	    => minInt({V}:>Int, I)
    18	    requires isInt(V)
    19	    [simplification]
    20	
    21	  // Exact Kadane-fold summaries for the unprocessed suffix.
    22	  syntax Int ::= kadaneCurrent(ValSeq, Int) [function]
    23	  rule kadaneCurrent(.ValSeq, C:Int) => C
    24	  rule kadaneCurrent(vCons(V:Val, XS:ValSeq), C:Int)
    25	    => kadaneCurrent(
    26	         XS,
    27	         minInt({V}:>Int, C +Int {V}:>Int))
    28	    requires isInt(V)
    29	
    30	  syntax Int ::= kadaneMinimum(ValSeq, Int, Int) [function]
    31	  rule kadaneMinimum(.ValSeq, _C:Int, B:Int) => B
    32	  rule kadaneMinimum(vCons(V:Val, XS:ValSeq), C:Int, B:Int)
    33	    => kadaneMinimum(
    34	         XS,
    35	         minInt({V}:>Int, C +Int {V}:>Int),
    36	         minInt(B, minInt({V}:>Int, C +Int {V}:>Int)))
