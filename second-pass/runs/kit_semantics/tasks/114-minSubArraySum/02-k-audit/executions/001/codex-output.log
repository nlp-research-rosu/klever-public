+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "minSubArraySum" |->
+                closureVal(
+                  "nums", .ParamNames,
+                  Assign(Name("current"), Int(0))
+                  Assign(
+                    Name("minimum"),
+                    Subscript(Name("nums"), Int(0)))
+                  For(
+                    Name("value"),
+                    Name("nums"),
+                    Assign(
