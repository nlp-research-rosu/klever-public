diff --git a/evidence/audit-false-result.k b/evidence/audit-false-result.k
new file mode 100644
index 0000000000000000000000000000000000000000..78d6d61e4267913800b1df118bd5ff3c1186b3b4
--- /dev/null
+++ b/evidence/audit-false-result.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module AUDIT-FALSE-RESULT
+  imports VERIFICATION
+
+  // Reviewer-authored mutation. The satisfying input [3, -4, 2] returns -4;
+  // this deliberately changes only the result obligation to the false value -3.
+  claim [fresh-off-by-one]:
+    <k>
+      Call(
+        Name("minSubArraySum"),
+        list(vCons(3, vCons(-4, vCons(2, .ValSeq)))))
+      => -3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "minSubArraySum" |->
+                closureVal(
+                  "nums", .ParamNames,
+                  Assign(Name("current"), Int(0))
+                  Assign(
+                    Name("minimum"),
+                    Subscript(Name("nums"), Int(0)))
+                  For(
+                    Name("value"),
+                    Name("nums"),
+                    Assign(
+                      Name("current"),
+                      Call(
+                        Name("min"),
+                        Name("value"),
+                        BinOp(
+                          "+",
+                          Name("current"),
+                          Name("value"))))
+                    Assign(
+                      Name("minimum"),
+                      Call(
+                        Name("min"),
+                        Name("minimum"),
+                        Name("current"))))
+                  Return(Name("minimum"))
+                  .Stmts,
+                  0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
