+from itertools import product
+
+from solution import minSubArraySum
+
+
+def brute_force_min_subarray(nums):
+    best = nums[0]
+    for start in range(len(nums)):
+        total = 0
+        for end in range(start, len(nums)):
+            total += nums[end]
+            if total < best:
+                best = total
+    return best
+
