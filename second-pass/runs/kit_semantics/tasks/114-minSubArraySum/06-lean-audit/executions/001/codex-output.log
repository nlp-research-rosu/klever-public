   348	def evalArith (codes : SortIntSeq) : SortInt :=
   349	  let (numbers, operators) := tokenizeEval (intSeqToList codes) none [] []
   350	  let powered := passPower operators numbers
   351	  let multiplied := passLevel true powered
   352	  let added := passLevel false multiplied
   353	  match added.2 with
   354	  | first :: _ => first
   355	  | [] => 0
