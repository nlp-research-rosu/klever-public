new file mode 100644
index 0000000000000000000000000000000000000000..0d40f68e3f96ecbcceff8f4344a7fe4edb0f2b4c
--- /dev/null
+++ b//tmp/audit-work/114-minSubArraySum/proof-audit/AuditBridge.lean
@@ -0,0 +1,152 @@
+import Proof
+
+namespace AuditBridge
+
+open Proof
+
+def kOfVal (value : SortVal) : SortK :=
+  SortK.kseq ((@inj SortVal SortKItem) value) SortK.dotk
+
+def twoArgs (first second : SortVal) : SortVals :=
+  SortVals.«_,__MPY-CORE_Vals_Val_Vals» first
+    (SortVals.«_,__MPY-CORE_Vals_Val_Vals» second
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»)
+
+def intPayload : SortVal → SortInt
+  | SortVal.inj_SortInt value => value
+  | _ => 0
+
+-- Ground and boundary witnesses for every target parameter.
+example : Proof.«_+Int_» (-5) 8 = 3 := by rfl
+example : Proof.«_+Int_» 0 0 = 0 := by rfl
+example : Proof.«_+Int_» 100000000000000000000 7 =
+    100000000000000000007 := by rfl
+
+example : Proof.isInt (kOfVal (SortVal.inj_SortInt (-7))) = true := by rfl
+example : Proof.isInt (kOfVal (SortVal.inj_SortBool true)) = false := by rfl
+example : Proof.isInt SortK.dotk = false := by rfl
+
+example : Proof.«project:Int» (kOfVal (SortVal.inj_SortInt (-7))) = -7 := by rfl
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt (-5)) (SortVal.inj_SortInt 8) =
+      SortVal.inj_SortInt 3 := by rfl
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt 0) (SortVal.inj_SortInt 0) =
+      SortVal.inj_SortInt 0 := by rfl
+
+example : Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int» (-5) 8 = -5 := by rfl
+example : Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int» 8 (-5) = -5 := by rfl
+example : Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int» 4 4 = 4 := by rfl
+
+example :
+    Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+      "min" (twoArgs (SortVal.inj_SortInt (-5)) (SortVal.inj_SortInt 8)) =
+      SortVal.inj_SortInt (-5) := by rfl
+example :
+    Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+      "min" (twoArgs (SortVal.inj_SortInt 8) (SortVal.inj_SortInt (-5))) =
+      SortVal.inj_SortInt (-5) := by rfl
+
+-- Each convenient result-bearing mutation is rejected by a concrete,
+-- satisfiable instance when all other bindings retain their audited meaning.
+def zeroAdd (_left _right : SortInt) : SortInt := 0
+def noneApplyBin (_op : SortString) (_left _right : SortVal) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+def noneApplyBuiltin (_name : SortString) (_args : SortVals) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+def zeroMin (_left _right : SortInt) : SortInt := 0
+def zeroProject (_term : SortK) : SortInt := 0
+
+theorem zeroAddRejected :
+    ¬ Klean114Minsubarraysum.Lemmas.targetStatement
+      zeroAdd
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+      Proof.isInt
+      Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int»
+      Proof.«project:Int» := by
+  intro target
+  have bad := target.1 (SortVal.inj_SortInt 2) 3 rfl
+  change SortVal.inj_SortInt 5 = SortVal.inj_SortInt 0 at bad
+  have intBad := congrArg intPayload bad
+  exact (by decide : (5 : SortInt) ≠ 0) intBad
+
+theorem noneApplyBinRejected :
+    ¬ Klean114Minsubarraysum.Lemmas.targetStatement
+      Proof.«_+Int_»
+      noneApplyBin
+      Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+      Proof.isInt
+      Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int»
+      Proof.«project:Int» := by
+  intro target
+  have bad := target.1 (SortVal.inj_SortInt 2) 3 rfl
+  contradiction
+
+theorem noneApplyBuiltinRejected :
+    ¬ Klean114Minsubarraysum.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      noneApplyBuiltin
+      Proof.isInt
+      Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int»
+      Proof.«project:Int» := by
+  intro target
+  have bad := target.2 3 (SortVal.inj_SortInt 2) rfl
+  contradiction
+
+theorem zeroMinRejected :
+    ¬ Klean114Minsubarraysum.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+      Proof.isInt
+      zeroMin
+      Proof.«project:Int» := by
+  intro target
+  have bad := target.2 3 (SortVal.inj_SortInt 2) rfl
+  change SortVal.inj_SortInt 2 = SortVal.inj_SortInt 0 at bad
+  have intBad := congrArg intPayload bad
+  exact (by decide : (2 : SortInt) ≠ 0) intBad
+
+theorem zeroProjectRejected :
+    ¬ Klean114Minsubarraysum.Lemmas.targetStatement
+      Proof.«_+Int_»
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+      Proof.isInt
+      Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int»
+      zeroProject := by
+  intro target
+  have bad := target.1 (SortVal.inj_SortInt 2) 3 rfl
+  change SortVal.inj_SortInt 5 = SortVal.inj_SortInt 3 at bad
+  have intBad := congrArg intPayload bad
+  exact (by decide : (5 : SortInt) ≠ 3) intBad
+
+-- This adversarial mutation makes both guards false, so the target becomes
+-- vacuous. The candidate's concrete true witness above rules this out.
+def falseIsInt (_term : SortK) : SortBool := false
+
+theorem falseIsIntMakesTargetVacuous :
+    Klean114Minsubarraysum.Lemmas.targetStatement
+      zeroAdd noneApplyBin noneApplyBuiltin falseIsInt zeroMin zeroProject := by
+  constructor
+  · intro _V _I h
+    contradiction
+  · intro _I _V h
+    contradiction
+
+-- The submitted theorem has exactly the immutable generated target type.
+#check (Proof.final :
+  Klean114Minsubarraysum.Lemmas.targetStatement
+    Proof.«_+Int_»
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+    Proof.isInt
+    Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int»
+    Proof.«project:Int»)
+
+end AuditBridge
