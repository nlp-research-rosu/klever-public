   261	def isDigitCode (code : SortInt) : Bool :=
   262	  decide (48 ≤ code ∧ code ≤ 57)
   263	
   264	def flushNumber (current : Option SortInt) (numbersRev : List SortInt) :
   265	    List SortInt :=
   266	  match current with
   267	  | some number => number :: numbersRev
   268	  | none => numbersRev
