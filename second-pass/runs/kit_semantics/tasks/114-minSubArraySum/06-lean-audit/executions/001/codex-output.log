   301	def passPower : List EvalOp → List SortInt → List EvalOp × List SortInt
   302	  | [], numbers => ([], numbers)
   303	  | _, [] => ([], [])
   304	  | operator :: operators, number :: numbers =>
   305	      let (remainingOperators, remainingNumbers) := passPower operators numbers
   306	      match operator, remainingNumbers with
   307	      | EvalOp.pow, next :: rest =>
   308	          (remainingOperators, Int.pow number next.toNat :: rest)
   309	      | EvalOp.pow, [] => (remainingOperators, [number])
   310	      | other, rest => (other :: remainingOperators, number :: rest)
   311	
   312	def atLevel (level : Bool) : EvalOp → Bool
   313	  | EvalOp.mul | EvalOp.floorDiv | EvalOp.div => level
   314	  | EvalOp.add | EvalOp.sub => !level
   315	  | EvalOp.pow => false
   316	
   317	def applyEvalOp (operator : EvalOp) (left right : SortInt) : SortInt :=
   318	  match operator with
   319	  | EvalOp.add => left + right
   320	  | EvalOp.sub => left - right
   321	  | EvalOp.mul => left * right
   322	  | EvalOp.floorDiv => if right == 0 then left else left / right
   323	  | EvalOp.div => left
   324	  | EvalOp.pow => Int.pow left right.toNat
   325	
   326	def passLevelGo (level : Bool) :
   327	    SortInt → List EvalOp → List SortInt → List EvalOp → List SortInt →
   328	      List EvalOp × List SortInt
   329	  | current, [], _, operatorsRev, numbersRev =>
   330	      (operatorsRev.reverse, (current :: numbersRev).reverse)
   331	  | current, _, [], operatorsRev, numbersRev =>
   332	      (operatorsRev.reverse, (current :: numbersRev).reverse)
   333	  | current, operator :: operators, number :: numbers,
   334	      operatorsRev, numbersRev =>
   335	      if atLevel level operator then
   336	        passLevelGo level (applyEvalOp operator current number)
   337	          operators numbers operatorsRev numbersRev
   338	      else
   339	        passLevelGo level number operators numbers
   340	          (operator :: operatorsRev) (current :: numbersRev)
   341	
   342	def passLevel (level : Bool) :
   343	    List EvalOp × List SortInt → List EvalOp × List SortInt
   344	  | (operators, []) => (operators, [])
   345	  | (operators, first :: rest) =>
   346	      passLevelGo level first operators rest [] []
