   110	
   111	def minVals : SortInt → SortVals → Option SortInt
   112	  | current, SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
   113	      some current
   114	  | current,
   115	      SortVals.«_,__MPY-CORE_Vals_Val_Vals» (SortVal.inj_SortInt next) rest =>
