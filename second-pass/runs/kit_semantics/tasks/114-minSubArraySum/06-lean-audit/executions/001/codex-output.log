   441	      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
   442	      match stringCodes object with
   443	      | some codes => SortVal.«setV(_)_MPY-SET_Val_IntSeq» (dedupCodes codes)
