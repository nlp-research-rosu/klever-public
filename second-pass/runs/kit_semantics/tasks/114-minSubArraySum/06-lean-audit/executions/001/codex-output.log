     2	def minSubArraySum(nums):
     3	    """
     4	    Given an array of integers nums, find the minimum sum of any non-empty sub-array
     5	    of nums.
     6	    Example
     7	    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1
     8	    minSubArraySum([-1, -2, -3]) == -6
     9	    """
