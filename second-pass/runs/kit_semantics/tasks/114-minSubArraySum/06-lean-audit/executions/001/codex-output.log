   392	      | none => SortVal.«noneV_MPY-CORE_Val»
   393	  | "/", SortVal.inj_SortInt left, SortVal.inj_SortInt right =>
   394	      SortVal.inj_SortFloat (intToFloat left / intToFloat right)
   395	  | "/", SortVal.inj_SortInt left, SortVal.inj_SortFloat right =>
   396	      SortVal.inj_SortFloat (intToFloat left / right)
   397	  | "/", SortVal.inj_SortFloat left, SortVal.inj_SortInt right =>
   398	      SortVal.inj_SortFloat (left / intToFloat right)
