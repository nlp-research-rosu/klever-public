+def intPayload : SortVal → SortInt
+  | SortVal.inj_SortInt value => value
+  | _ => 0
+
+-- Ground and boundary witnesses for every target parameter.
+example : Proof.«_+Int_» (-5) 8 = 3 := by rfl
+example : Proof.«_+Int_» 0 0 = 0 := by rfl
+example : Proof.«_+Int_» 100000000000000000000 7 =
+    100000000000000000007 := by rfl
+
+example : Proof.isInt (kOfVal (SortVal.inj_SortInt (-7))) = true := by rfl
+example : Proof.isInt (kOfVal (SortVal.inj_SortBool true)) = false := by rfl
+example : Proof.isInt SortK.dotk = false := by rfl
+
+example : Proof.«project:Int» (kOfVal (SortVal.inj_SortInt (-7))) = -7 := by rfl
+
+example :
+    Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt (-5)) (SortVal.inj_SortInt 8) =
+      SortVal.inj_SortInt 3 := by rfl
+example :
