   270	def tokenizeEval :
   271	    List SortInt → Option SortInt → List SortInt → List EvalOp →
   272	      List SortInt × List EvalOp
   273	  | [], current, numbersRev, operatorsRev =>
   274	      ((flushNumber current numbersRev).reverse, operatorsRev.reverse)
   275	  | code :: rest, current, numbersRev, operatorsRev =>
   276	      if isDigitCode code then
   277	        let next :=
   278	          match current with
   279	          | some number => number * 10 + (code - 48)
   280	          | none => code - 48
   281	        tokenizeEval rest (some next) numbersRev operatorsRev
   282	      else if code == 32 then
   283	        tokenizeEval rest none (flushNumber current numbersRev) operatorsRev
   284	      else
   285	        let numbersRev := flushNumber current numbersRev
   286	        match code, rest with
   287	        | 42, 42 :: tail =>
   288	            tokenizeEval tail none numbersRev (EvalOp.pow :: operatorsRev)
   289	        | 47, 47 :: tail =>
   290	            tokenizeEval tail none numbersRev (EvalOp.floorDiv :: operatorsRev)
   291	        | 42, tail =>
   292	            tokenizeEval tail none numbersRev (EvalOp.mul :: operatorsRev)
   293	        | 47, tail =>
   294	            tokenizeEval tail none numbersRev (EvalOp.div :: operatorsRev)
   295	        | 43, tail =>
   296	            tokenizeEval tail none numbersRev (EvalOp.add :: operatorsRev)
   297	        | 45, tail =>
   298	            tokenizeEval tail none numbersRev (EvalOp.sub :: operatorsRev)
   299	        | _, tail => tokenizeEval tail none numbersRev operatorsRev
