+  SortVal.«noneV_MPY-CORE_Val»
+def noneApplyBuiltin (_name : SortString) (_args : SortVals) : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+def zeroMin (_left _right : SortInt) : SortInt := 0
+def zeroProject (_term : SortK) : SortInt := 0
+
+theorem zeroAddRejected :
+    ¬ Klean114Minsubarraysum.Lemmas.targetStatement
+      zeroAdd
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      Proof.«applyBuiltin(_,_)_MPY-BUILTINS_Val_String_Vals»
+      Proof.isInt
+      Proof.«minInt(_,_)_INT-COMMON_Int_Int_Int»
+      Proof.«project:Int» := by
