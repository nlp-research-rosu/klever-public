   364	  if value < 0 then
   365	    SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
   366	      45 (intSeqAppend prefixCodes digits)
   367	  else
   368	    intSeqAppend prefixCodes digits
