   445	  | "abs", SortVals.«_,__MPY-CORE_Vals_Val_Vals»
   446	      (SortVal.inj_SortInt value)
   447	      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
   448	      SortVal.inj_SortInt (absInt value)
   449	  | "abs", SortVals.«_,__MPY-CORE_Vals_Val_Vals»
   450	      (SortVal.inj_SortFloat value)
