   370	def applyBin : SortString → SortVal → SortVal → SortVal
   371	  | "+", SortVal.inj_SortInt left, SortVal.inj_SortInt right =>
   372	      SortVal.inj_SortInt (left + right)
   373	  | "+", SortVal.inj_SortInt left, SortVal.inj_SortBool right =>
