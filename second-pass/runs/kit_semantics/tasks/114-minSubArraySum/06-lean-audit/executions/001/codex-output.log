   143	    0
   144	  else if exponentBits == 2047 then
   145	    0
   146	  else
   147	    let mantissa := 2 ^ 52 + fraction
   148	    let exponent : Int := Int.ofNat exponentBits - 1023 - 52
   149	    let magnitude :=
   150	      if exponent < 0 then
   151	        mantissa / (2 ^ (0 - exponent).toNat)
   152	      else
   153	        mantissa * (2 ^ exponent.toNat)
   154	    if negative then 0 - Int.ofNat magnitude else Int.ofNat magnitude
