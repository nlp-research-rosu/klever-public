   401	  | "-", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
   402	      SortVal.inj_SortFloat (left - right)
   403	  | "/", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
   404	      SortVal.inj_SortFloat (left / right)
   405	  | "+", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
   406	      SortVal.inj_SortFloat (left + right)
   407	  | "*", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
   408	      SortVal.inj_SortFloat (left * right)
   409	  | "**", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
   410	      SortVal.inj_SortFloat (Float.pow left right)
   411	  | "**", SortVal.inj_SortInt left, SortVal.inj_SortFloat right =>
   412	      SortVal.inj_SortFloat (Float.pow (intToFloat left) right)
   413	  | "**", SortVal.inj_SortFloat left, SortVal.inj_SortInt right =>
   414	      SortVal.inj_SortFloat (Float.pow left (intToFloat right))
   415	  | "-", SortVal.inj_SortInt left, SortVal.inj_SortFloat right =>
   416	      SortVal.inj_SortFloat (intToFloat left - right)
   417	  | "-", SortVal.inj_SortFloat left, SortVal.inj_SortInt right =>
   418	      SortVal.inj_SortFloat (left - intToFloat right)
   419	  | "+", SortVal.inj_SortInt left, SortVal.inj_SortFloat right =>
   420	      SortVal.inj_SortFloat (intToFloat left + right)
   421	  | "+", SortVal.inj_SortFloat left, SortVal.inj_SortInt right =>
   422	      SortVal.inj_SortFloat (left + intToFloat right)
   423	  | "*", SortVal.inj_SortInt left, SortVal.inj_SortFloat right =>
   424	      SortVal.inj_SortFloat (intToFloat left * right)
   425	  | "*", SortVal.inj_SortFloat left, SortVal.inj_SortInt right =>
   426	      SortVal.inj_SortFloat (left * intToFloat right)
   427	  | "+", left, right =>
   428	      match stringCodes left, stringCodes right with
   429	      | some leftCodes, some rightCodes =>
   430	          stringVal (intSeqAppend leftCodes rightCodes)
   431	      | _, _ => SortVal.«noneV_MPY-CORE_Val»
   432	  | _, _, _ => SortVal.«noneV_MPY-CORE_Val»
   433	
   434	def applyBuiltin : SortString → SortVals → SortVal
   435	  | "len", SortVals.«_,__MPY-CORE_Vals_Val_Vals» object
