Module(
  FuncDef("minSubArraySum", Params("nums"),
    Assign(Name("current"), Int(0))
    Assign(Name("minimum"), Subscript(Name("nums"), Int(0)))
    For(Name("value"), Name("nums"),
      Assign(
        Name("current"),
        Call(
          Name("min"),
          Name("value"),
          BinOp("+", Name("current"), Name("value"))))
      Assign(
        Name("minimum"),
        Call(Name("min"), Name("minimum"), Name("current"))))
    Return(Name("minimum")))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(Int(2), Int(3), Int(4), Int(1), Int(2), Int(4))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(6)))))
  Assert(
    Compare(
      Call(Name("minSubArraySum"), ListExpr(Int(5))),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(
          Int(3),
          UnaryOp("-", Int(4)),
          Int(2),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(1)),
          Int(7),
          UnaryOp("-", Int(5)))),
      CmpOp("==", UnaryOp("-", Int(6)))))
  Assert(
    Compare(
      Call(Name("minSubArraySum"), ListExpr(Int(0), Int(0))),
      CmpOp("==", Int(0)))))
