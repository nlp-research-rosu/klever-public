+def stringVal (codes : SortIntSeq) : SortVal :=
+  SortVal.«kwV(_,_)_MPY-CORE_Val_String_Val» stringTag
+    (SortVal.«md5Obj(_)_MPY-BUILTINS_Val_IntSeq» codes)
