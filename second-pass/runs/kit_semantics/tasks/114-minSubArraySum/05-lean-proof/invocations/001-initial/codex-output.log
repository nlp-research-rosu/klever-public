+  | current, SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+      some current
+  | current,
+      SortVals.«_,__MPY-CORE_Vals_Val_Vals» (SortVal.inj_SortInt next) rest =>
+      maxVals (maxInt current next) rest
+  | _, _ => none
