+      | EvalOp.pow, next :: rest =>
+          (remainingOperators, Int.pow number next.toNat :: rest)
+      | EvalOp.pow, [] => (remainingOperators, [number])
+      | other, rest => (other :: remainingOperators, number :: rest)
