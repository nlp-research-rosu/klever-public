+def stringCodes : SortVal → Option SortIntSeq
+  | SortVal.«kwV(_,_)_MPY-CORE_Val_String_Val» tag
+      (SortVal.«md5Obj(_)_MPY-BUILTINS_Val_IntSeq» codes) =>
+      if tag == stringTag then some codes else none
+  | _ => none
