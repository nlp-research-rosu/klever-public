+        (stringVal (hostStringToCodes "cd")))
+      == some [97, 98, 99, 100],
+    intResult (applyBuiltin "len" (vals [listValue
+      [SortVal.inj_SortInt 1, SortVal.inj_SortBool false]])) == some 2,
+    intResult (applyBuiltin "len" (vals [stringVal (hostStringToCodes "abc")]))
+      == some 3,
+    setCodes (applyBuiltin "set" (vals [stringVal (hostStringToCodes "abac")]))
+      == some [97, 98, 99],
+    intResult (applyBuiltin "abs" (vals [SortVal.inj_SortInt (-9)])) == some 9,
+    intResult (applyBuiltin "max"
+      (vals [SortVal.inj_SortInt 2, SortVal.inj_SortInt 9,
+        SortVal.inj_SortInt (-1)])) == some 9,
+    intResult (applyBuiltin "min"
+      (vals [SortVal.inj_SortInt 2, SortVal.inj_SortInt 9,
+        SortVal.inj_SortInt (-1)])) == some (-1),
+    codesResult (applyBuiltin "bin" (vals [SortVal.inj_SortInt (-5)]))
+      == some [45, 48, 98, 49, 48, 49],
+    intResult (applyBuiltin "int" (vals [stringVal (hostStringToCodes "42")]))
+      == some 42,
+    intResult (applyBuiltin "ord" (vals [stringVal (hostStringToCodes "A")]))
+      == some 65,
+    codesResult (applyBuiltin "chr" (vals [SortVal.inj_SortInt 65]))
+      == some [65],
+    codesResult (applyBuiltin "str" (vals [SortVal.inj_SortInt (-12)]))
+      == some [45, 49, 50],
+    isRange (applyBuiltin "range"
+      (vals [SortVal.inj_SortInt 2, SortVal.inj_SortInt 9,
+        SortVal.inj_SortInt 3])) 2 9 3,
+    intResult (applyBuiltin "eval"
+      (vals [stringVal (hostStringToCodes "2 + 3 * 4")])) == some 14,
+    intResult (applyBuiltin "eval"
+      (vals [stringVal (hostStringToCodes "2 ** 3 ** 2")])) == some 512,
+    intResult (applyBuiltin "floor"
+      (vals [SortVal.inj_SortFloat (2.7 : Float)])) == some 2,
+    intResult (applyBuiltin "ceil"
+      (vals [SortVal.inj_SortFloat (-2.7 : Float)])) == some (-2),
+    intResult (applyBuiltin "int"
+      (vals [SortVal.inj_SortFloat (-2.7 : Float)])) == some (-2),
+    intResult (applyBuiltin "round"
+      (vals [SortVal.inj_SortFloat (2.5 : Float)])) == some 2,
+    intResult (applyBuiltin "round"
+      (vals [SortVal.inj_SortFloat (3.5 : Float)])) == some 4,
+    floatResult (applyBuiltin "float" (vals [SortVal.inj_SortInt 3]))
+      |>.any fun value => value == (3.0 : Float)
+  ]
+
+def main : IO Unit := do
+  let failures := checks.zipIdx.filterMap fun (passed, index) =>
+    if passed then none else some index
+  if failures.isEmpty then
+    IO.println s!"dispatch checks passed: {checks.length}"
+  else
+    throw (IO.userError s!"dispatch checks failed at indices {failures}")
