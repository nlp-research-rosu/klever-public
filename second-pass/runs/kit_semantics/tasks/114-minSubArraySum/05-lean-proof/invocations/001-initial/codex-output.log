+  | "-", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
+      SortVal.inj_SortFloat (left - right)
+  | "/", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
+      SortVal.inj_SortFloat (left / right)
+  | "+", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
+      SortVal.inj_SortFloat (left + right)
+  | "*", SortVal.inj_SortFloat left, SortVal.inj_SortFloat right =>
