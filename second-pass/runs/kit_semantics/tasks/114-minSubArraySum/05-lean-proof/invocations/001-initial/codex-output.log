+def roundFloatDigits (value : SortFloat) (digits : SortInt) : SortFloat :=
+  let scale :=
+    if digits < 0 then
+      Float.pow (10.0 : Float) (intToFloat digits)
+    else
+      intToFloat (Int.pow 10 digits.toNat)
