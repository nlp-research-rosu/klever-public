+def rangeLength (low high step : SortInt) : Option SortInt :=
+  if step > 0 then
+    if high > low then some ((high - low + step - 1) / step) else some 0
+  else if step < 0 then
+    if high < low then some ((low - high - step - 1) / (0 - step)) else some 0
+  else
+    none
