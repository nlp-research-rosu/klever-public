+def charsToCodes : List Char → SortIntSeq
+  | [] => SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+  | head :: tail =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+        (Int.ofNat head.toNat) (charsToCodes tail)
