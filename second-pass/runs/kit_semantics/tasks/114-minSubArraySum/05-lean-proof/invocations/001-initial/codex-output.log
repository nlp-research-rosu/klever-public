+      (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+        98 SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»)
+  if value < 0 then
+    SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+      45 (intSeqAppend prefix digits)
+  else
+    intSeqAppend prefix digits
