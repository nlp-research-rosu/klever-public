+      some (valSeqLength values)
+  | SortVal.inj_SortIterable
+      (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int»
+        low high step) =>
+      rangeLength low high step
+  | SortVal.«setV(_)_MPY-SET_Val_IntSeq» codes =>
+      some (intSeqLength codes)
