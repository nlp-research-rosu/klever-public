+      SortVal.inj_SortInt ((if left then 1 else 0) + right)
+  | "-", SortVal.inj_SortInt left, SortVal.inj_SortInt right =>
+      SortVal.inj_SortInt (left - right)
+  | "*", SortVal.inj_SortInt left, SortVal.inj_SortInt right =>
