+  | _, _, _ => SortVal.«noneV_MPY-CORE_Val»
+
+def applyBuiltin : SortString → SortVals → SortVal
+  | "len", SortVals.«_,__MPY-CORE_Vals_Val_Vals» object
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
