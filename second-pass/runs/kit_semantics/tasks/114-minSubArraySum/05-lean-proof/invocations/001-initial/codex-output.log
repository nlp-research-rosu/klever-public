+      match stringCodes object with
+      | some codes => SortVal.«setV(_)_MPY-SET_Val_IntSeq» (dedupCodes codes)
+      | none => SortVal.«noneV_MPY-CORE_Val»
+  | "abs", SortVals.«_,__MPY-CORE_Vals_Val_Vals»
