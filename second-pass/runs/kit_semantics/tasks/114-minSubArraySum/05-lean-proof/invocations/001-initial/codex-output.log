+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail,
+      accumulated =>
+      if codeIn head accumulated then
+        dedupFrom tail accumulated
+      else
+        dedupFrom tail (snocCode accumulated head)
