+              | none => SortVal.«noneV_MPY-CORE_Val»
+          | none => SortVal.«noneV_MPY-CORE_Val»
+  | "floor", SortVals.«_,__MPY-CORE_Vals_Val_Vals» value
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
