diff --git a/lean_proc_fix.c b/lean_proc_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..04a39fba89eba9a433a28b1ecc4a12fbe375bd9f
--- /dev/null
+++ b/lean_proc_fix.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0
+      && strcmp(path + length - 4, "/exe") == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}

exec
/bin/bash -lc 'LD_PRELOAD=/workspace/.lake/lean_proc_fix.so lake build
LD_PRELOAD=/workspace/.lake/lean_proc_fix.so lake env lean --run ConversionCheck.lean' in /workspace
diff --git a/ConversionCheck.lean b/ConversionCheck.lean
new file mode 100644
index 0000000000000000000000000000000000000000..f14795286e548cffe09d88ebbb5cefe52a0dfe7c
--- /dev/null
+++ b/ConversionCheck.lean
@@ -0,0 +1,14 @@
+import Proof.FrozenDispatch
+
+open FrozenDispatch
+
+def main : IO Unit := do
+  let actual :=
+    [integralFloatToInt (2.0 : Float),
+     integralFloatToInt (-2.0 : Float),
+     integralFloatToInt (9007199254740992.0 : Float)]
+  let expected : List Int := [2, -2, 9007199254740992]
+  if actual == expected then
+    IO.println "float-to-int checks passed"
+  else
+    throw (IO.userError s!"float-to-int mismatch: {actual}")
