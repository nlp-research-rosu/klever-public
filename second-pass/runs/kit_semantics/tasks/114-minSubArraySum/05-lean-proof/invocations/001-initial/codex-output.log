+def intSeqLength : SortIntSeq → SortInt
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => 0
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ tail =>
+      intSeqLength tail + 1
