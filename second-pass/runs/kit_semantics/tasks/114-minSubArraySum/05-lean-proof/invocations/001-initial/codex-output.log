+def applyBin : SortString → SortVal → SortVal → SortVal
+  | "+", SortVal.inj_SortInt left, SortVal.inj_SortInt right =>
+      SortVal.inj_SortInt (left + right)
+  | "+", SortVal.inj_SortInt left, SortVal.inj_SortBool right =>
