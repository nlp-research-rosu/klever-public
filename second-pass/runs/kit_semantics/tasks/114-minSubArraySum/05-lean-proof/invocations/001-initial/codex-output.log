+def intPartAcc : SortIntSeq → SortInt → SortInt
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq», accumulated => accumulated
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 46 _, accumulated =>
