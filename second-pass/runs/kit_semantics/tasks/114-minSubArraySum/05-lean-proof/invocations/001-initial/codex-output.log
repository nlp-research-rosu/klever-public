+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => none
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 45 tail =>
+      (decimalCodesToFloat tail).map fun value => (0.0 : Float) - value
