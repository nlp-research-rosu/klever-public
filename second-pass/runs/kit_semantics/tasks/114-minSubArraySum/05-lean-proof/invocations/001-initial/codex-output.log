+            (SortIterable.«zipObjS(_,_)_MPY-CORE_Iterable_IntSeq_IntSeq»
+              leftCodes rightCodes)
+      | _, _ => SortVal.«noneV_MPY-CORE_Val»
+  | "range", SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+      (SortVal.inj_SortInt stop)
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+      SortVal.inj_SortIterable
+        (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int»
+          0 stop 1)
+  | "range", SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+      (SortVal.inj_SortInt start)
+      (SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+        (SortVal.inj_SortInt stop)
+        SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals») =>
+      SortVal.inj_SortIterable
+        (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int»
+          start stop 1)
+  | "range", SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+      (SortVal.inj_SortInt start)
+      (SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+        (SortVal.inj_SortInt stop)
+        (SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+          (SortVal.inj_SortInt step)
+          SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»)) =>
+      if step == 0 then SortVal.«noneV_MPY-CORE_Val»
+      else
+        SortVal.inj_SortIterable
+          (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int»
+            start stop step)
+  | "eval", SortVals.«_,__MPY-CORE_Vals_Val_Vals» value
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+      match stringCodes value with
+      | some codes => SortVal.inj_SortInt (evalArith codes)
+      | none => SortVal.«noneV_MPY-CORE_Val»
+  | "isinstance", SortVals.«_,__MPY-CORE_Vals_Val_Vals» value
+      (SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+        (SortVal.«typeV(_)_MPY-CORE_Val_String» typeName)
+        SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals») =>
+      if typeName == "int" then
+        SortVal.inj_SortBool
+          (match value with
+          | SortVal.inj_SortInt _ => true
+          | _ => false)
+      else if typeName == "str" then
+        SortVal.inj_SortBool (stringCodes value).isSome
+      else
+        SortVal.«noneV_MPY-CORE_Val»
+  | "float", SortVals.«_,__MPY-CORE_Vals_Val_Vals» value
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+      match value with
+      | SortVal.inj_SortInt integer =>
+          SortVal.inj_SortFloat (intToFloat integer)
+      | SortVal.inj_SortFloat float => SortVal.inj_SortFloat float
+      | other =>
+          match stringCodes other with
+          | some codes =>
+              match decimalCodesToFloat codes with
+              | some result => SortVal.inj_SortFloat result
+              | none => SortVal.«noneV_MPY-CORE_Val»
+          | none => SortVal.«noneV_MPY-CORE_Val»
+  | "floor", SortVals.«_,__MPY-CORE_Vals_Val_Vals» value
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+      match floorValue value with
+      | some result => SortVal.inj_SortInt result
+      | none => SortVal.«noneV_MPY-CORE_Val»
+  | "ceil", SortVals.«_,__MPY-CORE_Vals_Val_Vals» value
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+      match ceilValue value with
+      | some result => SortVal.inj_SortInt result
+      | none => SortVal.«noneV_MPY-CORE_Val»
+  | "round", SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+      (SortVal.inj_SortFloat value)
+      SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals» =>
+      SortVal.inj_SortInt (roundFloat value)
+  | "round", SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+      (SortVal.inj_SortFloat value)
+      (SortVals.«_,__MPY-CORE_Vals_Val_Vals»
+        (SortVal.inj_SortInt digits)
+        SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals») =>
+      SortVal.inj_SortFloat (roundFloatDigits value digits)
+  | _, _ => SortVal.«noneV_MPY-CORE_Val»
+
+end FrozenDispatch
diff --git a/lean_proc_fix.c b/lean_proc_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..04a39fba89eba9a433a28b1ecc4a12fbe375bd9f
--- /dev/null
+++ b/lean_proc_fix.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0
+      && strcmp(path + length - 4, "/exe") == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}

exec
/bin/bash -lc 'LD_PRELOAD=/workspace/.lake/lean_proc_fix.so lake env lean --run DispatchCheck.lean' in /workspace
diff --git a/DispatchCheck.lean b/DispatchCheck.lean
new file mode 100644
index 0000000000000000000000000000000000000000..f4ce513e579fee752db3ca6ec645a5e1a9eff604
--- /dev/null
+++ b/DispatchCheck.lean
@@ -0,0 +1,115 @@
+import Proof.FrozenDispatch
+
+open FrozenDispatch
+
+def vals : List SortVal → SortVals
+  | [] => SortVals.«.List{"_,__MPY-CORE_Vals_Val_Vals"}_Vals»
+  | head :: tail => SortVals.«_,__MPY-CORE_Vals_Val_Vals» head (vals tail)
+
+def intResult : SortVal → Option SortInt
+  | SortVal.inj_SortInt value => some value
+  | _ => none
+
+def floatResult : SortVal → Option SortFloat
+  | SortVal.inj_SortFloat value => some value
+  | _ => none
+
+def codesResult (value : SortVal) : Option (List SortInt) :=
+  (stringCodes value).map intSeqToList
+
+def setCodes : SortVal → Option (List SortInt)
+  | SortVal.«setV(_)_MPY-SET_Val_IntSeq» codes => some (intSeqToList codes)
+  | _ => none
+
+def listValue (values : List SortVal) : SortVal :=
+  let rec toValSeq : List SortVal → SortValSeq
+    | [] => SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+    | head :: tail =>
+        SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+          head (toValSeq tail)
+  SortVal.inj_SortIterable
+    (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» (toValSeq values))
+
+def isRange : SortVal → SortInt → SortInt → SortInt → Bool
+  | SortVal.inj_SortIterable
+      (SortIterable.«rangeObj(_,_,_)_MPY-CORE_Iterable_Int_Int_Int» a b s),
+      expectedA, expectedB, expectedS =>
+      a == expectedA && b == expectedB && s == expectedS
+  | _, _, _, _ => false
+
+def checks : List Bool :=
+  [
+    intResult (applyBin "+" (SortVal.inj_SortInt 4) (SortVal.inj_SortInt 7))
+      == some 11,
+    intResult (applyBin "+" (SortVal.inj_SortInt 4) (SortVal.inj_SortBool true))
+      == some 5,
+    intResult (applyBin "-" (SortVal.inj_SortInt 4) (SortVal.inj_SortInt 7))
+      == some (-3),
+    intResult (applyBin "*" (SortVal.inj_SortInt 4) (SortVal.inj_SortInt 7))
+      == some 28,
+    intResult (applyBin "%" (SortVal.inj_SortInt (-5)) (SortVal.inj_SortInt 3))
+      == some 1,
+    intResult (applyBin "%" (SortVal.inj_SortInt 5) (SortVal.inj_SortInt (-3)))
+      == some (-1),
+    intResult (applyBin "//" (SortVal.inj_SortInt (-5)) (SortVal.inj_SortInt 3))
+      == some (-2),
+    intResult (applyBin "**" (SortVal.inj_SortInt 3) (SortVal.inj_SortInt 4))
+      == some 81,
+    (floatResult
+      (applyBin "+" (SortVal.inj_SortFloat (1.5 : Float))
+        (SortVal.inj_SortInt 2))).any fun value => value == (3.5 : Float),
+    codesResult
+      (applyBin "+" (stringVal (hostStringToCodes "ab"))
+        (stringVal (hostStringToCodes "cd")))
+      == some [97, 98, 99, 100],
+    intResult (applyBuiltin "len" (vals [listValue
+      [SortVal.inj_SortInt 1, SortVal.inj_SortBool false]])) == some 2,
+    intResult (applyBuiltin "len" (vals [stringVal (hostStringToCodes "abc")]))
+      == some 3,
+    setCodes (applyBuiltin "set" (vals [stringVal (hostStringToCodes "abac")]))
+      == some [97, 98, 99],
+    intResult (applyBuiltin "abs" (vals [SortVal.inj_SortInt (-9)])) == some 9,
+    intResult (applyBuiltin "max"
+      (vals [SortVal.inj_SortInt 2, SortVal.inj_SortInt 9,
+        SortVal.inj_SortInt (-1)])) == some 9,
+    intResult (applyBuiltin "min"
+      (vals [SortVal.inj_SortInt 2, SortVal.inj_SortInt 9,
+        SortVal.inj_SortInt (-1)])) == some (-1),
+    codesResult (applyBuiltin "bin" (vals [SortVal.inj_SortInt (-5)]))
+      == some [45, 48, 98, 49, 48, 49],
+    intResult (applyBuiltin "int" (vals [stringVal (hostStringToCodes "42")]))
+      == some 42,
+    intResult (applyBuiltin "ord" (vals [stringVal (hostStringToCodes "A")]))
+      == some 65,
+    codesResult (applyBuiltin "chr" (vals [SortVal.inj_SortInt 65]))
+      == some [65],
+    codesResult (applyBuiltin "str" (vals [SortVal.inj_SortInt (-12)]))
+      == some [45, 49, 50],
+    isRange (applyBuiltin "range"
+      (vals [SortVal.inj_SortInt 2, SortVal.inj_SortInt 9,
+        SortVal.inj_SortInt 3])) 2 9 3,
+    intResult (applyBuiltin "eval"
+      (vals [stringVal (hostStringToCodes "2 + 3 * 4")])) == some 14,
+    intResult (applyBuiltin "eval"
+      (vals [stringVal (hostStringToCodes "2 ** 3 ** 2")])) == some 512,
+    intResult (applyBuiltin "floor"
+      (vals [SortVal.inj_SortFloat (2.7 : Float)])) == some 2,
+    intResult (applyBuiltin "ceil"
+      (vals [SortVal.inj_SortFloat (-2.7 : Float)])) == some (-2),
+    intResult (applyBuiltin "int"
+      (vals [SortVal.inj_SortFloat (-2.7 : Float)])) == some (-2),
+    intResult (applyBuiltin "round"
+      (vals [SortVal.inj_SortFloat (2.5 : Float)])) == some 2,
+    intResult (applyBuiltin "round"
+      (vals [SortVal.inj_SortFloat (3.5 : Float)])) == some 4,
+    floatResult (applyBuiltin "float" (vals [SortVal.inj_SortInt 3]))
+      |>.any fun value => value == (3.0 : Float)
+  ]
+
+def main : IO Unit := do
+  let failures := checks.zipIdx.filterMap fun (passed, index) =>
+    if passed then none else some index
+  if failures.isEmpty then
+    IO.println s!"dispatch checks passed: {checks.length}"
+  else
+    throw (IO.userError s!"dispatch checks failed at indices {failures}")
