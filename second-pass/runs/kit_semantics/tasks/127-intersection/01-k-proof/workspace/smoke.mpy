Module(
  FuncDef("intersection", Params("interval1", "interval2"),
    Assign(Name("start"), Subscript(Name("interval1"), Int(0)))
    If(Compare(
      Subscript(Name("interval2"), Int(0)),
      CmpOp(">", Name("start"))),
      Assign(Name("start"), Subscript(Name("interval2"), Int(0))),
      )
    Assign(Name("end"), Subscript(Name("interval1"), Int(1)))
    If(Compare(
      Subscript(Name("interval2"), Int(1)),
      CmpOp("<", Name("end"))),
      Assign(Name("end"), Subscript(Name("interval2"), Int(1))),
      )
    Assign(Name("length"), BinOp("-", Name("end"), Name("start")))
    If(Compare(Name("length"), CmpOp("<", Int(2))),
      Return(Str("NO")),
      )
    Assign(Name("divisor"), Int(2))
    Assign(Name("has_divisor"), Bool(false))
    While(Compare(Name("divisor"), CmpOp("<", Name("length"))),
      If(Compare(
        BinOp("%", Name("length"), Name("divisor")),
        CmpOp("==", Int(0))),
        Assign(Name("has_divisor"), Bool(true)),
        )
      Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    If(Name("has_divisor"),
      Return(Str("NO")),
      )
    Return(Str("YES")))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(1), Int(2)),
        TupleExpr(Int(2), Int(3))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(UnaryOp("-", Int(1)), Int(1)),
        TupleExpr(Int(0), Int(4))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(1))),
        TupleExpr(UnaryOp("-", Int(5)), Int(5))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(20)),
        TupleExpr(Int(5), Int(18))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(20)),
        TupleExpr(Int(5), Int(17))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(5), Int(5)),
        TupleExpr(Int(5), Int(5))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(1)),
        TupleExpr(Int(3), Int(4))),
      CmpOp("==", Str("NO")))))
