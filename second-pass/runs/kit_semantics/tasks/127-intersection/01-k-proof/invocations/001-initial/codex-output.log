+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Once a divisor has been seen, every remaining iteration preserves true.
+  claim [divisor-loop-true]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> true
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  // A concrete proper-divisor witness F guarantees that the scan sets the
+  // flag by the time it reaches F.
+  claim [divisor-loop-witness]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> (false => true)
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int F
+         andBool F <Int N andBool pyMod(N, F) ==Int 0
+
+  // If every remaining candidate has nonzero remainder, the scan leaves the
+  // flag false. The matching-logic quantifier is the standard "no divisor"
+  // condition over D <= X < N.
+  claim [divisor-loop-prime]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> false
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires (D >=Int 2 andBool D <=Int N)
+      #And (
+        #Forall X:Int .
+          ({ true #Equals (D <=Int X andBool X <Int N) }
+           #Implies
+           { true #Equals (pyMod(N, X) =/=Int 0) })
+      )
+
+  // Non-prime case 1: intersection length is less than 2.
+  claim [intersection-small]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => str(strToCodes("NO"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+              .Map
+              => "intersection"
+                 |-> closureVal("interval1", "interval2", .ParamNames,
+                                intersectionBody, 0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A0 <=Int A1 andBool B0 <=Int B1
+         andBool overlapLength(A0, A1, B0, B1) <Int 2
+
+  // Non-prime case 2: F is a proper-divisor witness.
+  claim [intersection-composite]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => str(strToCodes("NO"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+              .Map
+              => "intersection"
+                 |-> closureVal("interval1", "interval2", .ParamNames,
+                                intersectionBody, 0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A0 <=Int A1 andBool B0 <=Int B1
+         andBool overlapLength(A0, A1, B0, B1) >=Int 2
+         andBool F >=Int 2
+         andBool F <Int overlapLength(A0, A1, B0, B1)
+         andBool pyMod(overlapLength(A0, A1, B0, B1), F) ==Int 0
+
+  // Prime case: length is at least 2 and has no proper divisor.
+  claim [intersection-prime]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => str(strToCodes("YES"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+              .Map
+              => "intersection"
+                 |-> closureVal("interval1", "interval2", .ParamNames,
+                                intersectionBody, 0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires (A0 <=Int A1 andBool B0 <=Int B1
+              andBool overlapLength(A0, A1, B0, B1) >=Int 2)
+      #And (
+        #Forall X:Int .
+          ({ true
+             #Equals
+             (2 <=Int X
+              andBool X <Int overlapLength(A0, A1, B0, B1)) }
+           #Implies
+           { true
+             #Equals
+             (pyMod(overlapLength(A0, A1, B0, B1), X) =/=Int 0) })
+      )
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..971a91e4fb3b2b67515fdf7b4df74260d6bbddc5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,61 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+
+  // Exact constructor-level abbreviations for solution.mpy.
+  syntax Stmts ::= "intersectionBody" [function, total]
+  syntax Module ::= "solutionModule" [function, total]
+
+  // Mathematical summaries used only in specifications and invariants.
+  syntax Int ::= overlapLength(Int, Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule intersectionBody
+    => Assign(Name("start"), Subscript(Name("interval1"), Int(0)))
+       If(Compare(Subscript(Name("interval2"), Int(0)),
+                  CmpOp(">", Name("start"))),
+          Assign(Name("start"), Subscript(Name("interval2"), Int(0))) .Stmts,
+          .Stmts)
+       Assign(Name("end"), Subscript(Name("interval1"), Int(1)))
+       If(Compare(Subscript(Name("interval2"), Int(1)),
+                  CmpOp("<", Name("end"))),
+          Assign(Name("end"), Subscript(Name("interval2"), Int(1))) .Stmts,
+          .Stmts)
+       Assign(Name("length"), BinOp("-", Name("end"), Name("start")))
+       If(Compare(Name("length"), CmpOp("<", Int(2))),
+          Return(Str("NO")) .Stmts,
+          .Stmts)
+       Assign(Name("divisor"), Int(2))
+       Assign(Name("has_divisor"), Bool(false))
+       While(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+         If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                    CmpOp("==", Int(0))),
+            Assign(Name("has_divisor"), Bool(true)) .Stmts,
+            .Stmts)
+         Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+       If(Name("has_divisor"),
+          Return(Str("NO")) .Stmts,
+          .Stmts)
+       Return(Str("YES"))
+       .Stmts
+
+  rule solutionModule
+    => Module(
+         FuncDef("intersection", Params("interval1", "interval2"),
+                 intersectionBody)
+         .Stmts)
+
+  rule overlapLength(A0, A1, B0, B1)
+    => (#if B1 <Int A1 #then B1 #else A1 #fi)
+       -Int (#if B0 >Int A0 #then B0 #else A0 #fi)
+endmodule

