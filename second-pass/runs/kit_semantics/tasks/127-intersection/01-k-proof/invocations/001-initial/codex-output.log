+  Assert(Compare(
+    scanHasDivisor(false, 3, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 4, 2),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    scanHasDivisor(false, 5, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 25, 2),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    scanHasDivisor(false, 97, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 35, 4),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    scanHasDivisor(false, 35, 6),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    scanHasDivisor(false, 35, 8),
