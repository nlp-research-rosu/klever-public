+def intersection(interval1, interval2):
+    start = interval1[0]
+    if interval2[0] > start:
+        start = interval2[0]
+
+    end = interval1[1]
+    if interval2[1] < end:
+        end = interval2[1]
+
+    length = end - start
+    if length < 2:
