+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 0, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 1, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 2, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 3, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 4, 2),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    scanHasDivisor(false, 5, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 25, 2),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    scanHasDivisor(false, 97, 2),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(false, 35, 4),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    scanHasDivisor(false, 35, 6),
+    CmpOp("==", Bool(true))))
+  Assert(Compare(
+    scanHasDivisor(false, 35, 8),
+    CmpOp("==", Bool(false))))
+  Assert(Compare(
+    scanHasDivisor(true, 97, 2),
+    CmpOp("==", Bool(true)))))
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea32ac2b51a274720ecbba88ffc3834ed63f8a73
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,76 @@
+from math import isqrt
+
+from solution import intersection
+
+
+def oracle_is_prime(n):
+    if n < 2:
+        return False
+    for divisor in range(2, isqrt(n) + 1):
+        if n % divisor == 0:
+            return False
+    return True
+
+
+def oracle_intersection(interval1, interval2):
+    length = min(interval1[1], interval2[1]) - max(
+        interval1[0], interval2[0]
+    )
+    return "YES" if oracle_is_prime(length) else "NO"
+
+
+def proof_equation_scan(seen, n, divisor):
+    if seen:
+        return True
+    if divisor < 2:
+        divisor = 2
+    while divisor < n:
+        if n % divisor == 0:
+            return True
+        divisor += 1
+    return False
+
+
+def independent_scan_oracle(seen, n, divisor):
+    if seen:
+        return True
+    lower = max(2, divisor)
+    return any(n % candidate == 0 for candidate in range(lower, n))
+
+
+intervals = [
+    (start, end)
+    for start in range(-6, 7)
+    for end in range(start, 7)
+]
+program_mismatches = []
+for interval1 in intervals:
+    for interval2 in intervals:
+        actual = intersection(interval1, interval2)
+        expected = oracle_intersection(interval1, interval2)
+        if actual != expected:
+            program_mismatches.append((interval1, interval2, actual, expected))
+
+summary_mismatches = []
+summary_cases = 0
+for seen in (False, True):
+    for n in range(-10, 101):
+        for divisor in range(-3, 104):
+            summary_cases += 1
+            proof_value = proof_equation_scan(seen, n, divisor)
+            oracle_value = independent_scan_oracle(seen, n, divisor)
+            if proof_value != oracle_value:
+                summary_mismatches.append(
+                    (seen, n, divisor, proof_value, oracle_value)
+                )
+
+assert not program_mismatches, program_mismatches[:5]
+assert not summary_mismatches, summary_mismatches[:5]
+
+print(
+    "validation:"
+    f" program_cases={len(intervals) ** 2}"
+    f" program_mismatches={len(program_mismatches)}"
+    f" summary_cases={summary_cases}"
+    f" summary_mismatches={len(summary_mismatches)}"
+)
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0354727543c307c40b7f667b9c9f071dc8aa3350
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "reference-semantics/semantics.k"
+requires "solution-module.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports SOLUTION-MODULE-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+
+  // Mathematical summaries used only in specifications and invariants.
+  syntax Int ::= overlapLength(Int, Int, Int, Int) [function, total]
+  syntax Bool ::= scanHasDivisor(Bool, Int, Int)
+                  [function, total, no-evaluators]
+  syntax Val ::= primeResult(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports SOLUTION-MODULE
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule overlapLength(A0, A1, B0, B1)
+    => (#if B1 <Int A1 #then B1 #else A1 #fi)
+       -Int (#if B0 >Int A0 #then B0 #else A0 #fi)
+
+  // Ground definition. These disjoint cases cover every Bool/Int/Int input.
+  // The only recursive case increases D toward N.
+  rule scanHasDivisor(true, _N, _D) => true [concrete]
+  rule scanHasDivisor(false, N, D) => scanHasDivisor(false, N, 2)
+    requires D <Int 2
+    [concrete]
+  rule scanHasDivisor(false, N, D) => false
+    requires D >=Int 2 andBool D >=Int N
+    [concrete]
+  rule scanHasDivisor(false, N, D) => true
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) ==Int 0
+    [concrete]
+  rule scanHasDivisor(false, N, D)
+    => scanHasDivisor(false, N, D +Int 1)
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) =/=Int 0
+    [concrete]
+
+  // Symbolic consequences used by the loop proof. The fold rule matches only
+  // the syntactic D + 1 created by one iteration and rewrites toward the
+  // invariant's scan-at-D summary.
+  rule scanHasDivisor(true, _N, _D) => true
+    [simplification]
+  rule scanHasDivisor(false, N, D) => false
+    requires D >=Int 2 andBool D >=Int N
+    [simplification]
+  rule scanHasDivisor(false, N, D) => true
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) ==Int 0
+    [simplification]
+  rule scanHasDivisor(false, N, D +Int 1)
+    => scanHasDivisor(false, N, D)
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) =/=Int 0
+    [simplification]
+
+  rule primeResult(N)
+    => #if N <Int 2 orBool scanHasDivisor(false, N, 2)
+       #then str(strToCodes("NO"))
+       #else str(strToCodes("YES"))
+       #fi
+endmodule

