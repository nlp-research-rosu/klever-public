+        "end"         |-> E
+        "has_divisor" |-> true
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
