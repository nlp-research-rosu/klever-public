@@ -0,0 +1,23 @@
+def intersection(interval1, interval2):
+    start = interval1[0]
+    if interval2[0] > start:
+        start = interval2[0]
+
+    end = interval1[1]
+    if interval2[1] < end:
+        end = interval2[1]
+
+    length = end - start
+    if length < 2:
+        return "NO"
+
+    divisor = 2
+    has_divisor = False
+    while divisor < length:
+        if length % divisor == 0:
+            has_divisor = True
+        divisor = divisor + 1
+
+    if has_divisor:
+        return "NO"
+    return "YES"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..87b4f94e637f6cb4a1cfc64dd6fc56499d40d18b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,105 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Once a divisor has been seen, every remaining iteration preserves true.
+  claim [divisor-loop-true]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> true
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  // If no divisor has yet been seen, scanning D .. N-1 returns the exact
+  // recursive Boolean summary scanHasDivisor(false, N, D).
+  claim [divisor-loop-false]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> (false => scanHasDivisor(false, N, D))
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  // Whole-program claim: exact translated definition, exact entry point, all
+  // valid integer intervals, and a result characterized by proper divisors.
+  claim [intersection-correct]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => primeResult(overlapLength(A0, A1, B0, B1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A0 <=Int A1 andBool B0 <=Int B1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0354727543c307c40b7f667b9c9f071dc8aa3350
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "reference-semantics/semantics.k"
+requires "solution-module.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports SOLUTION-MODULE-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+
+  // Mathematical summaries used only in specifications and invariants.
+  syntax Int ::= overlapLength(Int, Int, Int, Int) [function, total]
+  syntax Bool ::= scanHasDivisor(Bool, Int, Int)
+                  [function, total, no-evaluators]
+  syntax Val ::= primeResult(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports SOLUTION-MODULE
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule overlapLength(A0, A1, B0, B1)
+    => (#if B1 <Int A1 #then B1 #else A1 #fi)
+       -Int (#if B0 >Int A0 #then B0 #else A0 #fi)
+
+  // Ground definition. These disjoint cases cover every Bool/Int/Int input.
+  // The only recursive case increases D toward N.
+  rule scanHasDivisor(true, _N, _D) => true [concrete]
+  rule scanHasDivisor(false, N, D) => scanHasDivisor(false, N, 2)
+    requires D <Int 2
+    [concrete]
+  rule scanHasDivisor(false, N, D) => false
+    requires D >=Int 2 andBool D >=Int N
+    [concrete]
+  rule scanHasDivisor(false, N, D) => true
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) ==Int 0
+    [concrete]
+  rule scanHasDivisor(false, N, D)
+    => scanHasDivisor(false, N, D +Int 1)
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) =/=Int 0
+    [concrete]
+
+  // Symbolic consequences used by the loop proof. The fold rule matches only
+  // the syntactic D + 1 created by one iteration and rewrites toward the
+  // invariant's scan-at-D summary.
+  rule scanHasDivisor(true, _N, _D) => true
+    [simplification]
+  rule scanHasDivisor(false, N, D) => false
+    requires D >=Int 2 andBool D >=Int N
+    [simplification]
+  rule scanHasDivisor(false, N, D) => true
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) ==Int 0
+    [simplification]
+  rule scanHasDivisor(false, N, D +Int 1)
+    => scanHasDivisor(false, N, D)
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) =/=Int 0
+    [simplification]
+
+  rule primeResult(N)
+    => #if N <Int 2 orBool scanHasDivisor(false, N, 2)
+       #then str(strToCodes("NO"))
+       #else str(strToCodes("YES"))
+       #fi
+endmodule

diff --git a/make_solution_module.py b/make_solution_module.py
new file mode 100644
index 0000000000000000000000000000000000000000..e04c3aba1661190ee7f263a6894ed7674c43b9f3
--- /dev/null
+++ b/make_solution_module.py
@@ -0,0 +1,21 @@
+from pathlib import Path
+import re
+
+
+term = Path("solution.mpy").read_text(encoding="utf-8").strip()
+# The standalone .mpy parser accepts a trailing empty Stmts argument as blank
+# text. Inside a K rule, spell that same list value explicitly.
+term = re.sub(r",\n(?P<indent> *)\)", r",\n\g<indent>.Stmts)", term)
+
+print('requires "reference-semantics/semantics/syntax.k"')
+print()
+print("module SOLUTION-MODULE-SYNTAX")
+print("  imports MPY-SYNTAX")
+print('  syntax Module ::= "solutionModule" [function, total]')
+print("endmodule")
+print()
+print("module SOLUTION-MODULE")
+print("  imports SOLUTION-MODULE-SYNTAX")
+print("  rule solutionModule")
+print("    => " + term.replace("\n", "\n       "))
+print("endmodule")
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..99e034d62bcd4d4705d0b6429e17605d9263e252
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,32 @@
+def intersection(interval1, interval2):
+    start = interval1[0]
+    if interval2[0] > start:
+        start = interval2[0]
+
+    end = interval1[1]
+    if interval2[1] < end:
+        end = interval2[1]
+
+    length = end - start
+    if length < 2:
+        return "NO"
+
+    divisor = 2
+    has_divisor = False
+    while divisor < length:
+        if length % divisor == 0:
+            has_divisor = True
+        divisor = divisor + 1
+
+    if has_divisor:
+        return "NO"
+    return "YES"
+
+
+assert intersection((1, 2), (2, 3)) == "NO"
+assert intersection((-1, 1), (0, 4)) == "NO"
+assert intersection((-3, -1), (-5, 5)) == "YES"
+assert intersection((0, 20), (5, 18)) == "YES"
+assert intersection((0, 20), (5, 17)) == "NO"
+assert intersection((5, 5), (5, 5)) == "NO"
+assert intersection((0, 1), (3, 4)) == "NO"
