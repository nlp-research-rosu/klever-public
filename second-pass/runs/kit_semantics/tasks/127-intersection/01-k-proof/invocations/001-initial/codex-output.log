diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f717253e441b63bdfa5b4cb24778729a9c4d720e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,109 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Once a divisor has been seen, every remaining iteration preserves true.
+  claim [divisor-loop-true]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> true
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  // If no divisor has yet been seen, scanning D .. N-1 returns the exact
+  // recursive Boolean summary scanHasDivisor(false, N, D).
+  claim [divisor-loop-false]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> (false => scanHasDivisor(false, N, D))
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  // Whole-program claim: load the exact translated definition, invoke its
+  // required entry point, and constrain every operational cell at return.
+  claim [intersection-correct]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => primeResult(overlapLength(A0, A1, B0, B1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+              .Map
+              => "intersection"
+                 |-> closureVal("interval1", "interval2", .ParamNames,
+                                intersectionBody, 0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A0 <=Int A1 andBool B0 <=Int B1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0151dbd8a8851a4708aa13e75d49310612db3941
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,108 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+
+  // Exact constructor-level abbreviations for solution.mpy.
+  syntax Stmts ::= "intersectionBody" [function, total]
+  syntax Module ::= "solutionModule" [function, total]
+
+  // Mathematical summaries used only in specifications and invariants.
+  syntax Int ::= overlapLength(Int, Int, Int, Int) [function, total]
+  syntax Bool ::= scanHasDivisor(Bool, Int, Int)
+                  [function, total, no-evaluators]
+  syntax Val ::= primeResult(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule intersectionBody
+    => Assign(Name("start"), Subscript(Name("interval1"), Int(0)))
+       If(Compare(Subscript(Name("interval2"), Int(0)),
+                  CmpOp(">", Name("start"))),
+          Assign(Name("start"), Subscript(Name("interval2"), Int(0))) .Stmts,
+          .Stmts)
+       Assign(Name("end"), Subscript(Name("interval1"), Int(1)))
+       If(Compare(Subscript(Name("interval2"), Int(1)),
+                  CmpOp("<", Name("end"))),
+          Assign(Name("end"), Subscript(Name("interval2"), Int(1))) .Stmts,
+          .Stmts)
+       Assign(Name("length"), BinOp("-", Name("end"), Name("start")))
+       If(Compare(Name("length"), CmpOp("<", Int(2))),
+          Return(Str("NO")) .Stmts,
+          .Stmts)
+       Assign(Name("divisor"), Int(2))
+       Assign(Name("has_divisor"), Bool(false))
+       While(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+         If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                    CmpOp("==", Int(0))),
+            Assign(Name("has_divisor"), Bool(true)) .Stmts,
+            .Stmts)
+         Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1)))
+         .Stmts)
+       If(Name("has_divisor"),
+          Return(Str("NO")) .Stmts,
+          .Stmts)
+       Return(Str("YES"))
+       .Stmts
+
+  rule solutionModule
+    => Module(
+         FuncDef("intersection", Params("interval1", "interval2"),
+                 intersectionBody)
+         .Stmts)
+
+  rule overlapLength(A0, A1, B0, B1)
+    => (#if B1 <Int A1 #then B1 #else A1 #fi)
+       -Int (#if B0 >Int A0 #then B0 #else A0 #fi)
+
+  // Ground definition. These disjoint cases cover every Bool/Int/Int input.
+  // The only recursive case increases D toward N.
+  rule scanHasDivisor(true, _N, _D) => true [concrete]
+  rule scanHasDivisor(false, N, D) => scanHasDivisor(false, N, 2)
+    requires D <Int 2
+    [concrete]
+  rule scanHasDivisor(false, N, D) => false
+    requires D >=Int 2 andBool D >=Int N
+    [concrete]
+  rule scanHasDivisor(false, N, D) => true
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) ==Int 0
+    [concrete]
+  rule scanHasDivisor(false, N, D)
+    => scanHasDivisor(false, N, D +Int 1)
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) =/=Int 0
+    [concrete]
+
+  // Symbolic consequences of the ground definition. They expose exactly the
+  // base, found-divisor, and one-step non-divisor obligations used by the two
+  // loop claims without recursively unfolding a symbolic scan.
+  rule scanHasDivisor(true, N, D) => true
+    [simplification]
+  rule scanHasDivisor(false, N, D) => false
+    requires D >=Int 2 andBool D >=Int N
+    [simplification]
+  rule scanHasDivisor(false, N, D) => true
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) ==Int 0
+    [simplification]
+  rule scanHasDivisor(false, N, D +Int 1)
+       ==K scanHasDivisor(false, N, D)
+    => true
+    requires D >=Int 2 andBool D <Int N
+         andBool pyMod(N, D) =/=Int 0
+    [simplification]
+
+  rule primeResult(N)
+    => #if N <Int 2 orBool scanHasDivisor(false, N, 2)
+       #then str(strToCodes("NO"))
+       #else str(strToCodes("YES"))
+       #fi
+endmodule

