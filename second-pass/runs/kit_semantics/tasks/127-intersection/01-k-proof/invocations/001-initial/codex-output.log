+++ b/spec-vacuity.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: these intervals intersect in length 2, so the real
+  // result is "YES", not "NO".
+  claim [wrong-prime-result]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(-3), Int(-1)),
+              TupleExpr(Int(-5), Int(5)))
+      => str(strToCodes("NO"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..87b4f94e637f6cb4a1cfc64dd6fc56499d40d18b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,105 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Once a divisor has been seen, every remaining iteration preserves true.
+  claim [divisor-loop-true]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> true
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  // If no divisor has yet been seen, scanning D .. N-1 returns the exact
+  // recursive Boolean summary scanHasDivisor(false, N, D).
+  claim [divisor-loop-false]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> (false => scanHasDivisor(false, N, D))
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  // Whole-program claim: exact translated definition, exact entry point, all
+  // valid integer intervals, and a result characterized by proper divisors.
+  claim [intersection-correct]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => primeResult(overlapLength(A0, A1, B0, B1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A0 <=Int A1 andBool B0 <=Int B1
+endmodule
