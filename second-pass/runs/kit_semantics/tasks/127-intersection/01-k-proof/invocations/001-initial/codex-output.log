diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..237daf555561718b1098f5e07e09a48fdafe3646
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,227 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Once a divisor has been seen, every remaining iteration preserves true.
+  claim [divisor-loop-true]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> true
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int N
+
+  // A concrete proper-divisor witness F guarantees that the scan sets the
+  // flag by the time it reaches F.
+  claim [divisor-loop-witness]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> (false => true)
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires D >=Int 2 andBool D <=Int F
+         andBool F <Int N andBool pyMod(N, F) ==Int 0
+
+  // If every remaining candidate has nonzero remainder, the scan leaves the
+  // flag false. The matching-logic quantifier is the standard "no divisor"
+  // condition over D <= X < N.
+  claim [divisor-loop-prime]:
+    <k>
+      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(BinOp("%", Name("length"), Name("divisor")),
+                        CmpOp("==", Int(0))),
+                Assign(Name("has_divisor"), Bool(true)) .Stmts,
+                .Stmts)
+             Assign(Name("divisor"),
+                    BinOp("+", Name("divisor"), Int(1)))
+             .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        "divisor"     |-> (D => N)
+        "end"         |-> E
+        "has_divisor" |-> false
+        "interval1"   |-> IV1
+        "interval2"   |-> IV2
+        "length"      |-> N
+        "start"       |-> S,
+        PARENT)
+      ...
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT </exit-code>
+    requires (D >=Int 2 andBool D <=Int N)
+      #And (
+        #Forall X:Int .
+          ({ true #Equals (D <=Int X andBool X <Int N) }
+           #Implies
+           { true #Equals (pyMod(N, X) =/=Int 0) })
+      )
+
+  // Non-prime case 1: intersection length is less than 2.
+  claim [intersection-small]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => str(strToCodes("NO"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+              .Map
+              => "intersection"
+                 |-> closureVal("interval1", "interval2", .ParamNames,
+                                intersectionBody, 0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A0 <=Int A1 andBool B0 <=Int B1
+         andBool overlapLength(A0, A1, B0, B1) <Int 2
+
+  // Non-prime case 2: F is a proper-divisor witness.
+  claim [intersection-composite]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => str(strToCodes("NO"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+              .Map
+              => "intersection"
+                 |-> closureVal("interval1", "interval2", .ParamNames,
+                                intersectionBody, 0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A0 <=Int A1 andBool B0 <=Int B1
+         andBool overlapLength(A0, A1, B0, B1) >=Int 2
+         andBool F >=Int 2
+         andBool F <Int overlapLength(A0, A1, B0, B1)
+         andBool pyMod(overlapLength(A0, A1, B0, B1), F) ==Int 0
+
+  // Prime case: length is at least 2 and has no proper divisor.
+  claim [intersection-prime]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(A0), Int(A1)),
+              TupleExpr(Int(B0), Int(B1)))
+      => str(strToCodes("YES"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+              .Map
+              => "intersection"
+                 |-> closureVal("interval1", "interval2", .ParamNames,
+                                intersectionBody, 0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires (A0 <=Int A1 andBool B0 <=Int B1
+              andBool overlapLength(A0, A1, B0, B1) >=Int 2)
+      #And (
+        #Forall X:Int .
+          ({ true
+             #Equals
+             (2 <=Int X
+              andBool X <Int overlapLength(A0, A1, B0, B1)) }
+           #Implies
+           { true
+             #Equals
+             (pyMod(overlapLength(A0, A1, B0, B1), X) =/=Int 0) })
+      )
+endmodule
