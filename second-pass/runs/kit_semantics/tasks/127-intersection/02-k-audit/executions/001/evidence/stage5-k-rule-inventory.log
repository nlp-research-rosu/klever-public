0010:   rule solutionModule
0011:     => Module(
0012:          FuncDef("intersection", Params("interval1", "interval2"),
0013:            Assign(Name("start"), Subscript(Name("interval1"), Int(0)))
0014:            If(Compare(
0015:              Subscript(Name("interval2"), Int(0)),
0016:              CmpOp(">", Name("start"))),
0017:              Assign(Name("start"), Subscript(Name("interval2"), Int(0))),
0018:              .Stmts)
0019:            Assign(Name("end"), Subscript(Name("interval1"), Int(1)))
0020:            If(Compare(
0021:              Subscript(Name("interval2"), Int(1)),
0022:              CmpOp("<", Name("end"))),
0023:              Assign(Name("end"), Subscript(Name("interval2"), Int(1))),
0024:              .Stmts)
0025:            Assign(Name("length"), BinOp("-", Name("end"), Name("start")))
0026:            If(Compare(Name("length"), CmpOp("<", Int(2))),
0027:              Return(Str("NO")),
0028:              .Stmts)
0029:            Assign(Name("divisor"), Int(2))
0030:            Assign(Name("has_divisor"), Bool(false))
0031:            While(Compare(Name("divisor"), CmpOp("<", Name("length"))),
0032:              If(Compare(
0033:                BinOp("%", Name("length"), Name("divisor")),
0034:                CmpOp("==", Int(0))),
0035:                Assign(Name("has_divisor"), Bool(true)),
0036:                .Stmts)
0037:              Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
0038:            If(Name("has_divisor"),
0039:              Return(Str("NO")),
0040:              .Stmts)
0041:            Return(Str("YES"))))

