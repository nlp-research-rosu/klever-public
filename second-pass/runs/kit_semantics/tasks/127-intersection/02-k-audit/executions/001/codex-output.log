+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh auditor mutation: both intervals are valid and their geometric
+  // intersection length is 3, so the candidate and canonical return "YES".
+  // The deliberately mutated result obligation below demands "NO".
+  claim [wrong-length-three-result]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("intersection"),
+              TupleExpr(Int(10), Int(13)),
+              TupleExpr(Int(0), Int(20)))
+      => str(strToCodes("NO"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/body-mutant-solution-module.k b/evidence/body-mutant-solution-module.k
new file mode 100644
index 0000000000000000000000000000000000000000..5b04e98766dabf47bc1c8d1418182f194fa61887
--- /dev/null
+++ b/evidence/body-mutant-solution-module.k
@@ -0,0 +1,42 @@
+requires "reference-semantics/semantics/syntax.k"
+
+module SOLUTION-MODULE-SYNTAX
+  imports MPY-SYNTAX
+  syntax Module ::= "solutionModule" [function, total]
+endmodule
+
+module SOLUTION-MODULE
+  imports SOLUTION-MODULE-SYNTAX
+  rule solutionModule
+    => Module(
+         FuncDef("intersection", Params("interval1", "interval2"),
+           Assign(Name("start"), Subscript(Name("interval1"), Int(0)))
+           If(Compare(
+             Subscript(Name("interval2"), Int(0)),
+             CmpOp(">", Name("start"))),
+             Assign(Name("start"), Subscript(Name("interval2"), Int(0))),
+             .Stmts)
+           Assign(Name("end"), Subscript(Name("interval1"), Int(1)))
+           If(Compare(
+             Subscript(Name("interval2"), Int(1)),
+             CmpOp("<", Name("end"))),
+             Assign(Name("end"), Subscript(Name("interval2"), Int(1))),
+             .Stmts)
+           Assign(Name("length"), BinOp("-", Name("end"), Name("start")))
+           If(Compare(Name("length"), CmpOp("<", Int(2))),
+             Return(Str("NO")),
+             .Stmts)
+           Assign(Name("divisor"), Int(2))
+           Assign(Name("has_divisor"), Bool(false))
+           While(Compare(Name("divisor"), CmpOp("<", Name("length"))),
+             If(Compare(
+               BinOp("%", Name("length"), Name("divisor")),
+               CmpOp("==", Int(0))),
+               Assign(Name("has_divisor"), Bool(true)),
+               .Stmts)
+             Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
+           If(Name("has_divisor"),
+             Return(Str("NO")),
+             .Stmts)
+           Return(Str("NO"))))
+endmodule
