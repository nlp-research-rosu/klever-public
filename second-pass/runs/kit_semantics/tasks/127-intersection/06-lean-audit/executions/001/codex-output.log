+import Proof
+
+namespace BridgeAudit
+
+open Proof
+
+theorem andBool_exact (a b : SortBool) :
+    Proof._andBool_ a b = (a && b) := by
+  rfl
+
+theorem geInt_exact (a b : SortInt) :
+    Proof.«_>=Int_» a b = decide (a ≥ b) := by
+  rfl
+
+theorem ltInt_exact (a b : SortInt) :
+    Proof.«_<Int_» a b = decide (a < b) := by
+  rfl
+
+theorem neInt_exact (a b : SortInt) :
+    Proof.«_=/=Int_» a b = decide (a ≠ b) := by
+  rfl
+
+theorem addInt_exact (a b : SortInt) :
+    Proof.«_+Int_» a b = a + b := by
+  rfl
+
+theorem pyMod_exact (a b : SortInt) :
+    Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» a b =
+      Int.tmod (Int.tmod a b + b) b := by
+  rfl
+
+theorem scan_seen_true (N D : SortInt) :
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»
+      true N D = true := by
+  simp [Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»]
+
+theorem scan_below_two (N D : SortInt) (hD : D < 2) :
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»
+      false N D =
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»
+      false N 2 := by
+  simp [Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int», hD]
+
+theorem scan_empty (N D : SortInt) (hD : D ≥ 2) (hDN : D ≥ N) :
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»
+      false N D = false := by
+  have hstart : ¬D < 2 := Int.not_lt_of_ge hD
+  have hfuel : (N - D).toNat = 0 :=
+    Int.toNat_of_nonpos (Int.sub_nonpos_of_le hDN)
+  simp [Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»,
+    hstart, hfuel, Proof.scanFrom]
+
+theorem scan_found (N D : SortInt)
+    (hD : D ≥ 2) (hDN : D < N)
+    (hmod : Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» N D = 0) :
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»
+      false N D = true := by
+  have hstart : ¬D < 2 := Int.not_lt_of_ge hD
+  have hnextNonnegative : 0 ≤ N - (D + 1) :=
+    Int.sub_nonneg_of_le (Int.add_one_le_of_lt hDN)
+  have hfuel : (N - D).toNat = (N - (D + 1)).toNat + 1 := by
+    rw [show N - D = (N - (D + 1)) + 1 by
+      simp [Int.sub_eq_add_neg, Int.neg_add, Int.add_assoc]]
+    exact Int.toNat_add_nat hnextNonnegative 1
+  simp only [
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»,
+    Bool.false_eq_true, ↓reduceIte, hstart]
+  rw [hfuel]
+  simp [Proof.scanFrom, hmod]
+
+theorem scan_step (N D : SortInt)
+    (hD : D ≥ 2) (hDN : D < N)
+    (hmod : Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» N D ≠ 0) :
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»
+      false N D =
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»
+      false N (D + 1) := by
+  have hstart : ¬D < 2 := Int.not_lt_of_ge hD
+  have hnextStart : ¬D + 1 < 2 :=
+    Int.not_lt_of_ge (Int.le_add_one hD)
+  have hnextNonnegative : 0 ≤ N - (D + 1) :=
+    Int.sub_nonneg_of_le (Int.add_one_le_of_lt hDN)
+  have hfuel : (N - D).toNat = (N - (D + 1)).toNat + 1 := by
+    rw [show N - D = (N - (D + 1)) + 1 by
+      simp [Int.sub_eq_add_neg, Int.neg_add, Int.add_assoc]]
+    exact Int.toNat_add_nat hnextNonnegative 1
+  simp only [
+    Proof.«scanHasDivisor(_,_,_)_VERIFICATION-SYNTAX_Bool_Bool_Int_Int»,
+    Bool.false_eq_true, ↓reduceIte, hstart, hnextStart]
+  rw [hfuel]
+  simp [Proof.scanFrom, hmod]
+
+end BridgeAudit
