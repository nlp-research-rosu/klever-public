+ nl -ba /reference/k-proof/solution.py
     1	def intersection(interval1, interval2):
     2	    start = interval1[0]
     3	    if interval2[0] > start:
     4	        start = interval2[0]
     5	
     6	    end = interval1[1]
     7	    if interval2[1] < end:
     8	        end = interval2[1]
     9	
    10	    length = end - start
    11	    if length < 2:
    12	        return "NO"
    13	
    14	    divisor = 2
    15	    has_divisor = False
    16	    while divisor < length:
    17	        if length % divisor == 0:
    18	            has_divisor = True
    19	        divisor = divisor + 1
    20	
    21	    if has_divisor:
    22	        return "NO"
    23	    return "YES"
