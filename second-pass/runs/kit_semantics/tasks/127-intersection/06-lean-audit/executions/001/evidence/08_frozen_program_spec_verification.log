    10	  // Mathematical summaries used only in specifications and invariants.
    11	  syntax Int ::= overlapLength(Int, Int, Int, Int) [function, total]
    12	  syntax Bool ::= scanHasDivisor(Bool, Int, Int)
    13	                  [function, total, no-evaluators]
    14	  syntax Val ::= primeResult(Int) [function, total]
    15	endmodule
    16	
    17	module VERIFICATION
    18	  imports MPY
    19	  imports SOLUTION-MODULE
    20	  imports VERIFICATION-SYNTAX
    21	  imports INT
    22	  imports BOOL
    23	
    24	  rule overlapLength(A0, A1, B0, B1)
    25	    => (#if B1 <Int A1 #then B1 #else A1 #fi)
    26	       -Int (#if B0 >Int A0 #then B0 #else A0 #fi)
    27	
    28	  // Ground definition. These disjoint cases cover every Bool/Int/Int input.
    29	  // The only recursive case increases D toward N.
    30	  rule scanHasDivisor(true, _N, _D) => true [concrete]
    31	  rule scanHasDivisor(false, N, D) => scanHasDivisor(false, N, 2)
    32	    requires D <Int 2
    33	    [concrete]
    34	  rule scanHasDivisor(false, N, D) => false
    35	    requires D >=Int 2 andBool D >=Int N
    36	    [concrete]
    37	  rule scanHasDivisor(false, N, D) => true
    38	    requires D >=Int 2 andBool D <Int N
    39	         andBool pyMod(N, D) ==Int 0
    40	    [concrete]
    41	  rule scanHasDivisor(false, N, D)
    42	    => scanHasDivisor(false, N, D +Int 1)
    43	    requires D >=Int 2 andBool D <Int N
    44	         andBool pyMod(N, D) =/=Int 0
    45	    [concrete]
    46	
    47	  // Symbolic consequences used by the loop proof. The fold rule matches only
    48	  // the syntactic D + 1 created by one iteration and rewrites toward the
    49	  // invariant's scan-at-D summary.
    50	  rule scanHasDivisor(true, _N, _D) => true
    51	    [simplification]
    52	  rule scanHasDivisor(false, N, D) => false
    53	    requires D >=Int 2 andBool D >=Int N
    54	    [simplification]
    55	  rule scanHasDivisor(false, N, D) => true
    56	    requires D >=Int 2 andBool D <Int N
    57	         andBool pyMod(N, D) ==Int 0
    58	    [simplification]
    59	  rule scanHasDivisor(false, N, D +Int 1)
    60	    => scanHasDivisor(false, N, D)
    61	    requires D >=Int 2 andBool D <Int N
    62	         andBool pyMod(N, D) =/=Int 0
    63	    [simplification]
    64	
    65	  rule primeResult(N)
    66	    => #if N <Int 2 orBool scanHasDivisor(false, N, 2)
    67	       #then str(strToCodes("NO"))
    68	       #else str(strToCodes("YES"))
    69	       #fi
    70	endmodule
