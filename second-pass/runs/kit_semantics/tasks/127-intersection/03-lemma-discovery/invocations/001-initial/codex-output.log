requires "reference-semantics/semantics.k"
requires "solution-module.k"

module VERIFICATION-SYNTAX
  imports MPY-SYNTAX
  imports SOLUTION-MODULE-SYNTAX
  imports INT-SYNTAX
  imports BOOL-SYNTAX

  // Mathematical summaries used only in specifications and invariants.
  syntax Int ::= overlapLength(Int, Int, Int, Int) [function, total]
  syntax Bool ::= scanHasDivisor(Bool, Int, Int)
                  [function, total, no-evaluators]
  syntax Val ::= primeResult(Int) [function, total]
endmodule

module VERIFICATION
  imports MPY
  imports SOLUTION-MODULE
  imports VERIFICATION-SYNTAX
  imports INT
  imports BOOL

  rule overlapLength(A0, A1, B0, B1)
    => (#if B1 <Int A1 #then B1 #else A1 #fi)
       -Int (#if B0 >Int A0 #then B0 #else A0 #fi)

  // Ground definition. These disjoint cases cover every Bool/Int/Int input.
  // The only recursive case increases D toward N.
  rule scanHasDivisor(true, _N, _D) => true [concrete]
  rule scanHasDivisor(false, N, D) => scanHasDivisor(false, N, 2)
    requires D <Int 2
    [concrete]
  rule scanHasDivisor(false, N, D) => false
    requires D >=Int 2 andBool D >=Int N
    [concrete]
  rule scanHasDivisor(false, N, D) => true
    requires D >=Int 2 andBool D <Int N
         andBool pyMod(N, D) ==Int 0
    [concrete]
  rule scanHasDivisor(false, N, D)
    => scanHasDivisor(false, N, D +Int 1)
    requires D >=Int 2 andBool D <Int N
         andBool pyMod(N, D) =/=Int 0
    [concrete]

  // Symbolic consequences used by the loop proof. The fold rule matches only
  // the syntactic D + 1 created by one iteration and rewrites toward the
  // invariant's scan-at-D summary.
  rule scanHasDivisor(true, _N, _D) => true
    [simplification]
  rule scanHasDivisor(false, N, D) => false
    requires D >=Int 2 andBool D >=Int N
    [simplification]
  rule scanHasDivisor(false, N, D) => true
    requires D >=Int 2 andBool D <Int N
         andBool pyMod(N, D) ==Int 0
    [simplification]
  rule scanHasDivisor(false, N, D +Int 1)
    => scanHasDivisor(false, N, D)
    requires D >=Int 2 andBool D <Int N
         andBool pyMod(N, D) =/=Int 0
    [simplification]

  rule primeResult(N)
    => #if N <Int 2 orBool scanHasDivisor(false, N, 2)
       #then str(strToCodes("NO"))
       #else str(strToCodes("YES"))
       #fi
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Once a divisor has been seen, every remaining iteration preserves true.
  claim [divisor-loop-true]:
    <k>
      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
             If(Compare(BinOp("%", Name("length"), Name("divisor")),
                        CmpOp("==", Int(0))),
                Assign(Name("has_divisor"), Bool(true)) .Stmts,
                .Stmts)
             Assign(Name("divisor"),
                    BinOp("+", Name("divisor"), Int(1)))
             .Stmts)
      => .K
      ...
    </k>
    <env> L </env>
    <scopes>
      ...
      L |-> scope(
        "divisor"     |-> (D => N)
        "end"         |-> E
        "has_divisor" |-> true
        "interval1"   |-> IV1
        "interval2"   |-> IV2
        "length"      |-> N
        "start"       |-> S,
        PARENT)
      ...
    </scopes>
    <scopeLoc> NEXT </scopeLoc>
    <heap> HEAP </heap>
    <heapLoc> HNEXT </heapLoc>
    <stack> STACK </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> EXIT </exit-code>
    requires D >=Int 2 andBool D <=Int N

  // If no divisor has yet been seen, scanning D .. N-1 returns the exact
  // recursive Boolean summary scanHasDivisor(false, N, D).
  claim [divisor-loop-false]:
    <k>
      #while(Compare(Name("divisor"), CmpOp("<", Name("length"))),
             If(Compare(BinOp("%", Name("length"), Name("divisor")),
                        CmpOp("==", Int(0))),
                Assign(Name("has_divisor"), Bool(true)) .Stmts,
                .Stmts)
             Assign(Name("divisor"),
                    BinOp("+", Name("divisor"), Int(1)))
             .Stmts)
      => .K
      ...
    </k>
    <env> L </env>
    <scopes>
      ...
      L |-> scope(
        "divisor"     |-> (D => N)
        "end"         |-> E
        "has_divisor" |-> (false => scanHasDivisor(false, N, D))
        "interval1"   |-> IV1
        "interval2"   |-> IV2
        "length"      |-> N
        "start"       |-> S,
        PARENT)
      ...
    </scopes>
    <scopeLoc> NEXT </scopeLoc>
    <heap> HEAP </heap>
    <heapLoc> HNEXT </heapLoc>
    <stack> STACK </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> EXIT </exit-code>
    requires D >=Int 2 andBool D <=Int N

  // Whole-program claim: exact translated definition, exact entry point, all
  // valid integer intervals, and a result characterized by proper divisors.
  claim [intersection-correct]:
    <k>
      #loadAll(solutionModule)
      ~> Call(Name("intersection"),
              TupleExpr(Int(A0), Int(A1)),
              TupleExpr(Int(B0), Int(B1)))
      => primeResult(overlapLength(A0, A1, B0, B1))
    </k>
    <env> 0 </env>
    <scopes>
      (0  |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      => ?FINALSCOPES:Map
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires A0 <=Int A1 andBool B0 <=Int B1
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Generate the exact constructor program and its K source abbreviation.
python3 py2mpy.py solution.py > solution.mpy
python3 make_solution_module.py > solution-module.k

# Required concrete LLVM execution of the supplied, unmodified semantics.
kompile --backend llvm reference-semantics/semantics.k \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
python3 py2mpy.py smoke.py > smoke.mpy
krun smoke.mpy --definition runtime-kompiled

# Symbolic proof: all claims, no depth bound.
kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module VERIFICATION-SYNTAX \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC 2>&1 | tee proof.out

# Ground execution and independent differential evidence.
krun summary-smoke.mpy \
