+      "rationale": "This unguarded equation defines the pure overlapLength summary as the lesser endpoint minus the greater startpoint; it does not execute or replace an MPY configuration."
+    },
+    {
+      "source_rule_id": "rule-9ba556783237da1b35ba406043b46667d41336798e2d73985610f972d35ace31",
+      "classification": "DEFINITION",
+      "rationale": "This is the true-flag base equation of the total scanHasDivisor mathematical summary."
+    },
+    {
+      "source_rule_id": "rule-8c03a8287d60d83cb1f7b1e3e939abef2b3a70e6e9b849b699f9a92c0c04da47",
+      "classification": "DEFINITION",
+      "rationale": "This guarded equation totalizes scanHasDivisor below its trial-divisor domain by normalizing every D below 2 to the defining start index 2."
+    },
+    {
+      "source_rule_id": "rule-cbdf8169fcc3ad7f374ff7043b01e95fdd8553e9e71602765a1cb6bc2be276f6",
+      "classification": "DEFINITION",
+      "rationale": "This is the empty-scan base equation: once D is at least 2 and at least N, the scanHasDivisor summary is false."
+    },
+    {
+      "source_rule_id": "rule-7aa9640fdd3d0a7fae00e8405951aeef3032f94eac83b2986db8444d7a440970",
+      "classification": "DEFINITION",
+      "rationale": "This defining case makes scanHasDivisor true when the current proper trial divisor D divides N."
+    },
+    {
+      "source_rule_id": "rule-9d883d30e3dc643451f9c6b495149a2825d220410cfb6af1b0eaa6667da1097d",
+      "classification": "DEFINITION",
+      "rationale": "This is the recursive defining equation for scanHasDivisor, advancing from a non-divisor D to D plus 1 under the guarded finite scan."
+    },
+    {
+      "source_rule_id": "rule-5464006d80f33f5fc975672d11f260f30dc67367228f691333955f474bcc16f3",
+      "classification": "DEFINITION",
+      "rationale": "This simplification rule restates exactly the existing true-flag defining equation for symbolic use; it adds no distinct mathematical proposition."
+    },
+    {
+      "source_rule_id": "rule-5397c59dca3c3fdbd353b530e08c7ce17c5d56052c9dfc863b7725bda7f01106",
+      "classification": "DEFINITION",
+      "rationale": "This simplification rule restates exactly the existing guarded empty-scan defining equation for symbolic use."
+    },
+    {
+      "source_rule_id": "rule-b538396a9a5a6ab14036d6fd6bbae17ed3358e6c9a6e0611c302001e4e358333",
+      "classification": "DEFINITION",
+      "rationale": "This simplification rule restates exactly the existing guarded divisor-found defining equation for symbolic use."
+    },
+    {
+      "source_rule_id": "rule-7dcc581fc2eb7b71715119443ca2ecc1192932d0a0273a3e90bd21562ae85ff4",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This reverse fold from scan at D plus 1 back to scan at D is an additional mathematical consequence used to close the loop proof; prove.sh compiles it into VERIFICATION before kprove and contains no earlier exact proof against a module that omits it."
+    },
+    {
+      "source_rule_id": "rule-983202dd3d105fa6a5f593a9222e54e761e7c2e4313c4ea910e8029a732a355f",
+      "classification": "DEFINITION",
+      "rationale": "This unguarded equation defines the pure primeResult proof term from the integer bound and scanHasDivisor summary."
+    }
+  ]
+}

