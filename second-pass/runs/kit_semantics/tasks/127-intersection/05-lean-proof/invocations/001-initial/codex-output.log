diff --git a/lean-app-path-shim.c b/lean-app-path-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..69dd7c176a932d87cf5935f8da1327274e0b836e
--- /dev/null
+++ b/lean-app-path-shim.c
@@ -0,0 +1,16 @@
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  const char *resolved = path;
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    resolved = "/proc/self/exe";
+  }
+  return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, size);
+}

