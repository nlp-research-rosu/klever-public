+    == resolution["stage4_preflight"],
+    "inventory_hash_matches_discovery": inventory["inventory_sha256"]
+    == discovery["inventory_sha256"],
+    "inventory_rules_bijectively_match_discovery": inventory["rules"]
+    == discovery["rules"],
+    "inventory_rules_unique": len(
