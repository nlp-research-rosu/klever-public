+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Program boundary: call the exact translated function body through its
+  // module binding.  The two claims partition the prompt's positive-Int domain.
+  claim [starts-one-ends-one-digit]:
+    <k>
+      Call(Name("starts_one_ends"), N:Int)
+      =>
+      1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "starts_one_ends" |->
+          closureVal(
+            "n",
+            Return(
+              IfExp(
+                Compare(Name("n"), CmpOp("==", Int(1))),
+                Int(1),
+                BinOp(
+                  "*",
+                  Int(18),
+                  BinOp("**", Int(10), BinOp("-", Name("n"), Int(2)))
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int 1
+
+  claim [starts-one-ends-multi-digit]:
+    <k>
+      Call(Name("starts_one_ends"), N:Int)
+      =>
+      18 *Int (10 ^Int (N -Int 2))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "starts_one_ends" |->
+          closureVal(
+            "n",
+            Return(
+              IfExp(
+                Compare(Name("n"), CmpOp("==", Int(1))),
+                Int(1),
+                BinOp(
+                  "*",
+                  Int(18),
+                  BinOp("**", Int(10), BinOp("-", Name("n"), Int(2)))
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1
