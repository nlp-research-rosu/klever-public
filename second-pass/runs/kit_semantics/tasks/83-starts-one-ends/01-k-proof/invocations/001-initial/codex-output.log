+        expected = brute_force_count(n)
+        assert actual == expected, (n, actual, expected)
+        checked.append((n, actual))
+    print("validated n=1..6:", checked)
+    print("mismatches: 0")
+
+
+if __name__ == "__main__":
+    main()
