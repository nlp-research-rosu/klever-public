--- /dev/null
+++ b/spec.k
@@ -0,0 +1,83 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Program boundary: call the exact translated function body through its
+  // module binding.  The two claims partition the prompt's positive-Int domain.
+  claim [starts-one-ends-one-digit]:
+    <k>
+      Call(Name("starts_one_ends"), N:Int)
+      =>
+      1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "starts_one_ends" |->
+          closureVal(
+            "n",
+            Return(
+              IfExp(
+                Compare(Name("n"), CmpOp("==", Int(1))),
+                Int(1),
+                BinOp(
+                  "*",
+                  Int(18),
+                  BinOp("**", Int(10), BinOp("-", Name("n"), Int(2)))
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int 1
+
+  claim [starts-one-ends-multi-digit]:
+    <k>
+      Call(Name("starts_one_ends"), N:Int)
+      =>
+      18 *Int (10 ^Int (N -Int 2))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "starts_one_ends" |->
+          closureVal(
+            "n",
+            Return(
+              IfExp(
+                Compare(Name("n"), CmpOp("==", Int(1))),
+                Int(1),
+                BinOp(
+                  "*",
+                  Int(18),
+                  BinOp("**", Int(10), BinOp("-", Name("n"), Int(2)))
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1
+endmodule
diff --git a/validate.py b/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..850cb4755eb46d3ae27c4a4266382d16c578a5a7
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,25 @@
+from solution import starts_one_ends
+
+
+def brute_force_count(n):
+    lower = 10 ** (n - 1)
+    upper = 10 ** n
+    return sum(
+        str(value).startswith("1") or str(value).endswith("1")
+        for value in range(lower, upper)
+    )
+
+
+def main():
+    checked = []
+    for n in range(1, 7):
+        actual = starts_one_ends(n)
+        expected = brute_force_count(n)
+        assert actual == expected, (n, actual, expected)
+        checked.append((n, actual))
+    print("validated n=1..6:", checked)
+    print("mismatches: 0")
+
+
+if __name__ == "__main__":
+    main()
