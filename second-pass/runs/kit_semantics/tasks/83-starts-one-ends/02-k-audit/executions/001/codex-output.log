+    "$scratch_path/trusted-canonical.py" \
+    "$scratch_path/solution.py"
+
+run find "$scratch_path" \
+    -path "$scratch_path/reference-semantics" -prune -o \
+    -printf '%y %P -> %l\n'
+
+printf '\nScript exit: 0 (individual command statuses above)\n'
