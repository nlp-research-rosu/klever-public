+printf '\n$ generate sorted SHA-256 manifest for reviewer evidence\n'
+printf '[exit %d]\n' "$?"
+run wc -l -c "$manifest_path"
+run find /audit-output -maxdepth 3 -type f -printf '%P\n'
+
+printf '\nScript exit: 0 (individual command statuses above)\n'

exec
