+def floatBinaryExponent (f : SortFloat) : Int :=
+  let rawExponent := ((Float.toBits f >>> 52) &&& 0x7ff).toNat
+  if rawExponent == 0 then -1074
+  else (Int.ofNat rawExponent) - 1023 - 52
