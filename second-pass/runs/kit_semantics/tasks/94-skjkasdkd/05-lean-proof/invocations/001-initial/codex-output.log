+def floatSignificand (f : SortFloat) : Nat :=
+  let bits := Float.toBits f
+  let rawExponent := ((bits >>> 52) &&& 0x7ff).toNat
+  let fraction := (bits &&& 0xfffffffffffff).toNat
+  if rawExponent == 0 then fraction else 2 ^ 52 + fraction
