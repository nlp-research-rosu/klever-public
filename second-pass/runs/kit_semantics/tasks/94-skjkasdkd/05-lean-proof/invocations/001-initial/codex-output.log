+import Proof.Operational
+
+example (x : SortInt) :
+    ((@inj SortVal SortKItem) (SortVal.inj_SortInt x)) =
+      SortKItem.inj_SortInt x := by
+  rfl
+
+example (x : SortVal) :
+    match SortK.kseq ((@inj SortVal SortKItem) x) SortK.dotk with
+    | .kseq (.inj_SortInt value) .dotk => some value
+    | _ => none
+    = (match x with | .inj_SortInt value => some value | _ => none) := by
+  cases x <;> rfl
