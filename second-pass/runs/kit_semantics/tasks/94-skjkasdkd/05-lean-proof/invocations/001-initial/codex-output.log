+  else if op == "-" then floatValue (intToFloatModel x - y)
+  else if op == "*" then floatValue (intToFloatModel x * y)
+  else if op == "/" then floatValue (intToFloatModel x / y)
+  else if op == "**" then floatValue (Float.pow (intToFloatModel x) y)
