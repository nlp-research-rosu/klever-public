diff --git a/Scratch.lean b/Scratch.lean
new file mode 100644
index 0000000000000000000000000000000000000000..195a7140f559ac80fec1f903d80724b3d9f467a8
--- /dev/null
+++ b/Scratch.lean
@@ -0,0 +1,29 @@
+import Proof.Operational
+import Std.Tactic
+
+namespace Scratch
+
+theorem pyModPos (n : Int) (h : n > 0) :
+    Operational.pythonModulo n 10 = Int.ofNat (n.toNat % 10) := by
+  have hn : 0 ≤ n := by omega
+  have hr : 0 ≤ n % 10 := Int.emod_nonneg n (by omega)
+  have hrs : 0 ≤ n % 10 + 10 := by omega
+  simp [Operational.pythonModulo, Int.tmod_eq_emod, hn, hrs, Int.max_eq_left hn]
+
+example (n : Int) (h : n > 0) :
+    Int.tdiv (n - Operational.pythonModulo n 10) 10 =
+      Int.ofNat (n.toNat / 10) := by
+  rw [pyModPos n h]
+  have hn : 0 ≤ n := by omega
+  have hr : 0 ≤ n % 10 := Int.emod_nonneg n (by omega)
+  have hrlt : n % 10 < 10 := by
+    have := Int.emod_lt n (show (10 : Int) ≠ 0 by omega)
+    omega
+  have hcast : Int.ofNat (n.toNat % 10) = n % 10 := by
+    simp [Int.natCast_emod, Int.toNat_of_nonneg hn]
+  rw [hcast, Int.tdiv_eq_ediv]
+  simp only [show 0 ≤ n - n % 10 by omega, true_or, ↓reduceIte, Int.add_zero]
+  rw [Int.natCast_ediv, Int.toNat_of_nonneg hn]
+  omega
+
+end Scratch
diff --git a/app_path_override.c b/app_path_override.c
new file mode 100644
index 0000000000000000000000000000000000000000..a4c2c01db11297630b0d2bb866a7d4d909bda436
--- /dev/null
+++ b/app_path_override.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static int is_proc_exe(const char *path) {
+  size_t n = strlen(path);
+  return strncmp(path, "/proc/", 6) == 0 && n >= 4 &&
+         strcmp(path + n - 4, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  if (is_proc_exe(path)) {
+    const char *lean = "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    size_t n = strlen(lean);
+    if (n > size) n = size;
+    memcpy(buf, lean, n);
+    return (ssize_t)n;
+  }
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink)
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  return real_readlink(path, buf, size);
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+  if (is_proc_exe(path)) {
+    const char *lean = "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    size_t n = strlen(lean);
+    if (n > size) n = size;
+    memcpy(buf, lean, n);
+    return (ssize_t)n;
+  }
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (!real_readlinkat)
+    real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  return real_readlinkat(dirfd, path, buf, size);
+}

