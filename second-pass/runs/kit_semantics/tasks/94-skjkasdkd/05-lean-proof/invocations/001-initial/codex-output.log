+def dictionaryEqual
+    (keys₁ values₁ keys₂ values₂ : SortValSeq) : Bool :=
+  valueSequenceLength keys₁ == valueSequenceLength keys₂ &&
+    dictionarySubset keys₁ values₁ keys₂ values₂
