+def valueSequenceLength : SortValSeq → Nat
+  | .«.ValSeq_MPY-CORE_ValSeq» => 0
+  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest =>
+      valueSequenceLength rest + 1
