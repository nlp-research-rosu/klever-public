+  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» key remainingKeys,
+    .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value remainingValues,
+    otherKeys, otherValues =>
