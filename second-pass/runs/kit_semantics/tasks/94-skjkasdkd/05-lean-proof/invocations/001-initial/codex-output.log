+++ b/Scratch.lean
@@ -0,0 +1,69 @@
+import Operational
+import Std.Tactic
+
+namespace Scratch
+
+def pyModModel (x y : Int) : Int :=
+  Int.tmod (Int.tmod x y + y) y
+
+def digitSumNatural : Nat → Int
+  | 0 => 0
+  | n + 1 =>
+      Int.ofNat ((n + 1) % 10) + digitSumNatural ((n + 1) / 10)
+termination_by n => n
+decreasing_by omega
+
+def digitSumModel (n : Int) : Int :=
+  if n > 0 then digitSumNatural n.toNat else 0
+
+#check Int.toNat_of_nonneg
+#check Int.ofNat_toNat
+#check Int.tdiv_ofNat
+#check Int.tmod_ofNat
+
+theorem digitSumNatural_step (n : Nat) (h : 0 < n) :
+    Int.ofNat (n % 10) + digitSumNatural (n / 10) = digitSumNatural n := by
+  conv_rhs => rw [digitSumNatural]
+  simp only
+
+theorem pyMod_pos_ten (n : Int) (h : n > 0) :
+    pyModModel n 10 = Int.ofNat (n.toNat % 10) := by
+  omega
+
+theorem quotient_pos_ten (n : Int) (h : n > 0) :
+    Int.tdiv (n - pyModModel n 10) 10 = Int.ofNat (n.toNat / 10) := by
+  omega
+
+theorem digitSumModel_step (n : Int) (h : n > 0) :
+    pyModModel n 10 +
+        digitSumModel (Int.tdiv (n - pyModModel n 10) 10) =
+      digitSumModel n := by
+  rw [pyMod_pos_ten n h, quotient_pos_ten n h]
+  have hNat : 0 < n.toNat := by omega
+  rw [digitSumModel, digitSumModel]
+  simp only [Int.ofNat_pos, hNat, ↓reduceIte]
+  rw [Int.toNat_ofNat]
+  exact digitSumNatural_step n.toNat hNat
+
+def primeTailModel (n d : Int) : Bool :=
+  if d < 2 then false
+  else if d >= n then true
+  else if pyModModel n d == 0 then false
+  else primeTailModel n (d + 1)
+termination_by (n - d).toNat
+decreasing_by omega
+
+theorem prime_zero (n d : Int)
+    (h : ((d ≥ 2 && d < n) && pyModModel n d == 0) = true) :
+    primeTailModel n d = false := by
+  simp only [Bool.and_eq_true] at h
+  simp [primeTailModel, h.1.1, h.1.2, h.2]
+
+theorem prime_back (n d : Int)
+    (h : ((d > 2 && d ≤ n) && !(pyModModel n (d - 1) == 0)) = true) :
+    primeTailModel n d = primeTailModel n (d - 1) := by
+  simp only [Bool.and_eq_true, Bool.not_eq_true] at h
+  rw [primeTailModel]
+  simp [h.1.1, h.1.2, h.2]
+
+end Scratch
