      "inventory_sha256": "1858c992ef1e9a6b842e6b7d36b1e30b8abe0e686374e68b1766d4f9cb1e3824",
      "module": "VERIFICATION",
      "normalized_sha256": "4175c4aa98cddee27ede99babdafc67baf74a0b86e62935384b5f7edb34d2914",
      "rationale": "Unproved guarded dispatch fact lifting MPY integer less-than when the right operand is a dynamic Val.",
      "source_rule_id": "rule-4175c4aa98cddee27ede99babdafc67baf74a0b86e62935384b5f7edb34d2914",
      "start_line": 103,
      "text": "  rule applyCmp(\"<\", I:Int, V:Val)\n    => I <Int projectIntTotal(V)\n    requires isInt(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "96e36beab2d7540a7fb8eb90be52dc480a387490a00e35df62c753a106123002",
      "end_line": 111,
      "inventory_sha256": "1858c992ef1e9a6b842e6b7d36b1e30b8abe0e686374e68b1766d4f9cb1e3824",
      "module": "VERIFICATION",
      "normalized_sha256": "2dd919bc012c069b3c8fffc3cbdb9c9070068f0c8eca42acdc492a3b3db5315a",
      "rationale": "Unproved guarded dispatch fact equating dynamic-Val modulo with pyMod of its total Int projection.",
      "source_rule_id": "rule-2dd919bc012c069b3c8fffc3cbdb9c9070068f0c8eca42acdc492a3b3db5315a",
      "start_line": 108,
      "text": "  rule applyBin(\"%\", V:Val, I:Int)\n    => pyMod(projectIntTotal(V), I)\n    requires isInt(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "96e36beab2d7540a7fb8eb90be52dc480a387490a00e35df62c753a106123002",
      "end_line": 116,
      "inventory_sha256": "1858c992ef1e9a6b842e6b7d36b1e30b8abe0e686374e68b1766d4f9cb1e3824",
      "module": "VERIFICATION",
      "normalized_sha256": "00073d0ac825d52fc0b1b4501a73dd6bceabdcb61a3f09abaad5a18381411c17",
      "rationale": "Unproved guarded dispatch fact equating dynamic-Val addition with integer addition after projection.",
      "source_rule_id": "rule-00073d0ac825d52fc0b1b4501a73dd6bceabdcb61a3f09abaad5a18381411c17",
      "start_line": 113,
      "text": "  rule applyBin(\"+\", V:Val, I:Int)\n    => projectIntTotal(V) +Int I\n    requires isInt(V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "96e36beab2d7540a7fb8eb90be52dc480a387490a00e35df62c753a106123002",
      "end_line": 137,
      "inventory_sha256": "1858c992ef1e9a6b842e6b7d36b1e30b8abe0e686374e68b1766d4f9cb1e3824",
      "module": "VERIFICATION",
      "normalized_sha256": "ca4e141078b38af84d1adcf7e28052e43ee8b187d3f9e30e56caaee0e604ec91",
      "rationale": "Adds an unproved symbolic shortcut from a zero remainder directly to false rather than serving as a primary recurrence case.",
      "source_rule_id": "rule-ca4e141078b38af84d1adcf7e28052e43ee8b187d3f9e30e56caaee0e604ec91",
      "start_line": 133,
      "text": "  rule primeTail(N:Int, D:Int) => false\n    requires D >=Int 2\n      andBool D <Int N\n      andBool pyMod(N, D) ==Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "symbolic(N, D)",
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "96e36beab2d7540a7fb8eb90be52dc480a387490a00e35df62c753a106123002",
      "end_line": 142,
      "inventory_sha256": "1858c992ef1e9a6b842e6b7d36b1e30b8abe0e686374e68b1766d4f9cb1e3824",
      "module": "VERIFICATION",
      "normalized_sha256": "ea9bd944c022c45e91082fb836fb1130b2cd059d0798ab09baa25e9067fe1c06",
      "rationale": "Adds an unproved backward-fold simplification for primeTail under a nonzero previous divisor.",
      "source_rule_id": "rule-ea9bd944c022c45e91082fb836fb1130b2cd059d0798ab09baa25e9067fe1c06",
      "start_line": 138,
      "text": "  rule primeTail(N:Int, D:Int) => primeTail(N, D -Int 1)\n    requires D >Int 2\n      andBool D <=Int N\n      andBool pyMod(N, D -Int 1) =/=Int 0\n    [symbolic(N, D), simplification]"
    },
    {
      "attributes": [
        "symbolic(N)",
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "96e36beab2d7540a7fb8eb90be52dc480a387490a00e35df62c753a106123002",
      "end_line": 178,
      "inventory_sha256": "1858c992ef1e9a6b842e6b7d36b1e30b8abe0e686374e68b1766d4f9cb1e3824",
      "module": "VERIFICATION",
      "normalized_sha256": "8b14fdbabbebf92572ac3c9cc4db1a74e817b9134daf88acb375104ce54f4c51",
      "rationale": "Adds the unproved reverse symbolic fold of the positive digitSum recurrence.",
      "source_rule_id": "rule-8b14fdbabbebf92572ac3c9cc4db1a74e817b9134daf88acb375104ce54f4c51",
      "start_line": 174,
      "text": "  rule pyMod(N:Int, 10)\n       +Int digitSum((N -Int pyMod(N, 10)) /Int 10)\n    => digitSum(N)\n    requires N >Int 0\n    [symbolic(N), simplification]"
    },
    {
      "attributes": [
        "symbolic(N)",
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "96e36beab2d7540a7fb8eb90be52dc480a387490a00e35df62c753a106123002",
      "end_line": 184,
      "inventory_sha256": "1858c992ef1e9a6b842e6b7d36b1e30b8abe0e686374e68b1766d4f9cb1e3824",
      "module": "VERIFICATION",
      "normalized_sha256": "19a4e23f1d39aa90f74d31468e8e2c52b5780ea7f27054931e8584b720b2bc0a",
      "rationale": "Adds an unproved normalized fold that expands pyMod into the underlying integer remainder expression.",
      "source_rule_id": "rule-19a4e23f1d39aa90f74d31468e8e2c52b5780ea7f27054931e8584b720b2bc0a",
      "start_line": 179,
      "text": "  rule ((N %Int 10 +Int 10) %Int 10)\n       +Int digitSum(\n         (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10)\n    => digitSum(N)\n    requires N >Int 0\n    [symbolic(N), simplification]"
    },
    {
      "attributes": [
        "symbolic(N)",
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "96e36beab2d7540a7fb8eb90be52dc480a387490a00e35df62c753a106123002",
      "end_line": 191,
      "inventory_sha256": "1858c992ef1e9a6b842e6b7d36b1e30b8abe0e686374e68b1766d4f9cb1e3824",
      "module": "VERIFICATION",
      "normalized_sha256": "4e535e9503b7ea5138b6ee785a3c03b7668867ee0f420c22b82e5ec29594b231",
      "rationale": "Adds the unproved accumulator-lifted digitSum fold, relying on the recurrence and integer-addition rearrangement.",
      "source_rule_id": "rule-4e535e9503b7ea5138b6ee785a3c03b7668867ee0f420c22b82e5ec29594b231",
      "start_line": 185,
      "text": "  rule T:Int\n       +Int ((N %Int 10 +Int 10) %Int 10)\n       +Int digitSum(\n         (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10)\n    => T +Int digitSum(N)\n    requires N >Int 0\n    [symbolic(N), simplification]"
    }
