+    (op : SortString) (floating : SortFloat) (integer : SortInt) : SortBool :=
+  if op == "==" then intFloatEqual integer floating
+  else if op == "!=" then !(intFloatEqual integer floating)
+  else if op == "<" then floatLessInteger floating integer
