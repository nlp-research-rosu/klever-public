diff --git a/Scratch.lean b/Scratch.lean
new file mode 100644
index 0000000000000000000000000000000000000000..d4a22f4c581a72ada45517cc1cd0cce915cafdbf
--- /dev/null
+++ b/Scratch.lean
@@ -0,0 +1,31 @@
+import Proof.Operational
+import Std.Tactic
+
+#check Int.tdiv_ofNat
+#check Int.tmod_ofNat
+#check Int.tdiv_eq_ediv
+#check Int.tmod_eq_emod
+#check Int.tdiv_mul_add_tmod
+#check Int.tmod_add_tdiv
+#check Int.ediv
+#check Int.emod
+#check Int.natCast_ediv
+#check Int.natCast_emod
+#check Int.toNat_of_nonneg
+#check Int.ofNat_toNat
+#check Int.toNat_ofNat
+#check Int.ediv_of_nonneg
+#check Int.emod_of_nonneg
+#check Int.tdiv_of_nonneg
+#check Int.tmod_of_nonneg
+#check Int.emod_nonneg
+#check Int.emod_lt
+#check Int.emod_add_ediv
+#check Int.add_emod
+#check Int.emod_emod
+
+example (n : Int) (h : n > 0) :
+    Operational.pythonModulo n 10 = Int.ofNat (n.toNat % 10) := by
+  have hn : 0 ≤ n := by omega
+  have hr : 0 ≤ n % 10 := Int.emod_nonneg n (by omega)
+  simp [Operational.pythonModulo, Int.tmod_eq_emod, hn, hr, Int.add_emod]
diff --git a/app_path_override.c b/app_path_override.c
new file mode 100644
index 0000000000000000000000000000000000000000..a4c2c01db11297630b0d2bb866a7d4d909bda436
--- /dev/null
+++ b/app_path_override.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static int is_proc_exe(const char *path) {
+  size_t n = strlen(path);
+  return strncmp(path, "/proc/", 6) == 0 && n >= 4 &&
+         strcmp(path + n - 4, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  if (is_proc_exe(path)) {
+    const char *lean = "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    size_t n = strlen(lean);
+    if (n > size) n = size;
+    memcpy(buf, lean, n);
+    return (ssize_t)n;
+  }
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink)
+    real_readlink = dlsym(RTLD_NEXT, "readlink");
+  return real_readlink(path, buf, size);
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+  if (is_proc_exe(path)) {
+    const char *lean = "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    size_t n = strlen(lean);
+    if (n > size) n = size;
+    memcpy(buf, lean, n);
+    return (ssize_t)n;
+  }
+  static ssize_t (*real_readlinkat)(int, const char *, char *, size_t);
+  if (!real_readlinkat)
+    real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+  return real_readlinkat(dirfd, path, buf, size);
+}

