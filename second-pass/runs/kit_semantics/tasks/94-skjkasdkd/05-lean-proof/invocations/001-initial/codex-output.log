+  if op == "+" then floatValue (x + y)
+  else if op == "-" then floatValue (x - y)
+  else if op == "*" then floatValue (x * y)
+  else if op == "/" then floatValue (x / y)
+  else if op == "%" then floatValue (x - Float.floor (x / y) * y)
+  else if op == "**" then floatValue (Float.pow x y)
