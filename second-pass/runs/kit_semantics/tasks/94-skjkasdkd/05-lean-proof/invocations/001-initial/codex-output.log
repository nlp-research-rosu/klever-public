+def floatCompare (op : SortString) (x y : SortFloat) : SortBool :=
+  if op == "<" then decide (x < y)
+  else if op == ">" then decide (y < x)
+  else if op == "<=" then !(decide (y < x))
+  else if op == ">=" then !(decide (x < y))
+  else if op == "==" then x == y
+  else if op == "!=" then !(x == y)
+  else false
