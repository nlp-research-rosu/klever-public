+  let qr := floatMagnitudeQuotientRemainder f
+  if floatNegative f then
+    if qr.2 == 0 then -Int.ofNat qr.1 else -Int.ofNat (qr.1 + 1)
+  else
+    Int.ofNat qr.1
+
+def floatCeilingInteger (f : SortFloat) : SortInt :=
+  let qr := floatMagnitudeQuotientRemainder f
+  if floatNegative f then
+    -Int.ofNat qr.1
+  else
+    if qr.2 == 0 then Int.ofNat qr.1 else Int.ofNat (qr.1 + 1)
