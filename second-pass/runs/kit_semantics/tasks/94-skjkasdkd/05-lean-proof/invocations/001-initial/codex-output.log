+def intSequenceLength : SortIntSeq → Nat
+  | .«.IntSeq_MPY-CORE_IntSeq» => 0
+  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ rest =>
+      intSequenceLength rest + 1
