+def integerCompare (op : SortString) (x y : SortInt) : SortBool :=
+  if op == "<" then decide (x < y)
+  else if op == "<=" then decide (x ≤ y)
+  else if op == ">" then decide (x > y)
+  else if op == ">=" then decide (x ≥ y)
+  else if op == "==" then x == y
+  else if op == "!=" then !(x == y)
+  else false
+
+def floatCompare (op : SortString) (x y : SortFloat) : SortBool :=
+  if op == "<" then decide (x < y)
+  else if op == ">" then decide (y < x)
+  else if op == "<=" then !(decide (y < x))
+  else if op == ">=" then !(decide (x < y))
+  else if op == "==" then x == y
+  else if op == "!=" then !(x == y)
+  else false
