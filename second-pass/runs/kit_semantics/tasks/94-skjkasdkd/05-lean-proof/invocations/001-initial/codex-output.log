+  else if op == "-" then floatValue (x - intToFloatModel y)
+  else if op == "*" then floatValue (x * intToFloatModel y)
+  else if op == "/" then floatValue (x / intToFloatModel y)
+  else if op == "**" then floatValue (Float.pow x (intToFloatModel y))
