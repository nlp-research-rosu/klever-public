+def codeMember (code : SortInt) : SortIntSeq → Bool
+  | .«.IntSeq_MPY-CORE_IntSeq» => false
+  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head rest =>
+      code == head || codeMember code rest
