+def codeSubset : SortIntSeq → SortIntSeq → Bool
+  | .«.IntSeq_MPY-CORE_IntSeq», _ => true
+  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head rest, other =>
+      codeMember head other && codeSubset rest other
