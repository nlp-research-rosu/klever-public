+def integerCompare (op : SortString) (x y : SortInt) : SortBool :=
+  if op == "<" then decide (x < y)
+  else if op == "<=" then decide (x ≤ y)
+  else if op == ">" then decide (x > y)
+  else if op == ">=" then decide (x ≥ y)
+  else if op == "==" then x == y
+  else if op == "!=" then !(x == y)
+  else false
