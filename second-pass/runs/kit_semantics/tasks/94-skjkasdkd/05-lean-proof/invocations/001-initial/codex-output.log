+theorem pythonModuloPositiveTen (n : SortInt) (h : n > 0) :
+    Operational.pythonModulo n 10 = Int.ofNat (n.toNat % 10) := by
+  omega
+
+theorem decimalQuotient (n : SortInt) (h : n > 0) :
+    Int.tdiv (n - Operational.pythonModulo n 10) 10 =
+      Int.ofNat (n.toNat / 10) := by
+  omega
+
+theorem digitSumModel_step (n : SortInt) (h : n > 0) :
+    Operational.pythonModulo n 10 +
+        digitSumModel (Int.tdiv (n - Operational.pythonModulo n 10) 10) =
+      digitSumModel n := by
+  rw [pythonModuloPositiveTen n h, decimalQuotient n h]
+  have hNat : 0 < n.toNat := by omega
+  rw [digitSumModel, digitSumModel]
+  simp only [Int.ofNat_pos, hNat, ↓reduceIte]
+  rw [Int.toNat_ofNat]
+  exact digitSumNatural_step n.toNat hNat
