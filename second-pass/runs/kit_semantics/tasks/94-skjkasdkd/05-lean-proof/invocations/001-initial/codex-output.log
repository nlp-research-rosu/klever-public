+  if n > 0 then digitSumNatural n.toNat else 0
+
+theorem digitSumNatural_step (n : Nat) (h : 0 < n) :
+    Int.ofNat (n % 10) + digitSumNatural (n / 10) = digitSumNatural n := by
+  conv_rhs => rw [digitSumNatural]
+  simp only
+
