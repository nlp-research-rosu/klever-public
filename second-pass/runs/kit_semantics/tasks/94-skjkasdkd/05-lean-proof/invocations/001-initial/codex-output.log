+      floatCompare op x y
+  | .inj_SortInt x, .inj_SortFloat y =>
+      integerFloatCompare op x y
+  | .inj_SortFloat x, .inj_SortInt y =>
+      floatIntegerCompare op x y
+  | .inj_SortBool x, .inj_SortFloat y =>
