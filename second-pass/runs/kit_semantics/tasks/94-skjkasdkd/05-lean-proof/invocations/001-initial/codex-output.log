+  | .inj_SortInt x, .inj_SortBool y =>
+      integerBinary op x (boolAsInteger y)
+  | .inj_SortBool x, .inj_SortInt y =>
+      integerBinary op (boolAsInteger x) y
+  | .inj_SortBool x, .inj_SortBool y =>
