+theorem decimalQuotient (n : Int) (h : n > 0) :
+    Int.tdiv (n - Operational.pythonModulo n 10) 10 =
+      Int.ofNat (n.toNat / 10) := by
+  rw [pythonModuloPositiveTen n h]
