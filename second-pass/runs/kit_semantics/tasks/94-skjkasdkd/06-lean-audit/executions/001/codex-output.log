### /reference/klean-generation/input-manifest.json
{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "dd2fa97c98ff9da568d754c34bf8ae33fa6e3cbd8f9981aaa4bd7b6f529748c9",
      "rationale": "Defines the named prime-loop statement body by exact expansion to its MPY statement sequence.",
      "source_rule_id": "rule-dd2fa97c98ff9da568d754c34bf8ae33fa6e3cbd8f9981aaa4bd7b6f529748c9",
      "start_line": 9,
      "text": "  rule primeLoopBody\n    => If(\n         Compare(\n           BinOp(\"%\", Name(\"value\"), Name(\"divisor\")),\n           CmpOp(\"==\", Int(0))),\n         Assign(Name(\"candidate\"), Bool(false)),\n         .Stmts)\n       AugAssign(Name(\"divisor\"), \"+\", Int(1))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "00b808d699e2afd3554db8e520d3ff061fc0668e2ac28206c5d877b11692e1cf",
      "rationale": "Defines the named list-scan body by exact expansion to the translated MPY syntax.",
      "source_rule_id": "rule-00b808d699e2afd3554db8e520d3ff061fc0668e2ac28206c5d877b11692e1cf",
      "start_line": 19,
      "text": "  rule scanBody\n    => If(\n         Compare(Name(\"value\"), CmpOp(\">\", Name(\"largest\"))),\n         Assign(\n           Name(\"candidate\"),\n           Compare(Name(\"value\"), CmpOp(\">=\", Int(2))))\n         Assign(Name(\"divisor\"), Int(2))\n         While(\n           Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"value\"))),\n           primeLoopBody)\n         If(\n           Name(\"candidate\"),\n           Assign(\n             Name(\"largest\"),\n             BinOp(\"+\", Name(\"value\"), Int(0))),\n           .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "59e9ea7317fadd4103ee90f8e6dc3bcb686098eeca881f43b8412ba64af29bbb",
      "rationale": "Defines the named decimal-digit loop body by exact expansion to its two MPY updates.",
      "source_rule_id": "rule-59e9ea7317fadd4103ee90f8e6dc3bcb686098eeca881f43b8412ba64af29bbb",
      "start_line": 38,
      "text": "  rule digitLoopBody\n    => AugAssign(\n         Name(\"total\"),\n         \"+\",\n         BinOp(\"%\", Name(\"largest\"), Int(10)))\n       AugAssign(Name(\"largest\"), \"//\", Int(10))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "c3aa454c3b2e79181e07066aa69428eb616e31841e6d1b1dbcd7500c98c47ec0",
      "rationale": "Defines targetBody as the exact translated function statement sequence used by the target claim.",
      "source_rule_id": "rule-c3aa454c3b2e79181e07066aa69428eb616e31841e6d1b1dbcd7500c98c47ec0",
      "start_line": 46,
      "text": "  rule targetBody\n    => Assign(Name(\"largest\"), Int(0))\n       Assign(Name(\"value\"), Int(0))\n       Assign(Name(\"candidate\"), Bool(false))\n       Assign(Name(\"divisor\"), Int(2))\n       For(Name(\"value\"), Name(\"lst\"), scanBody)\n       Assign(Name(\"total\"), Int(0))\n       While(\n         Compare(Name(\"largest\"), CmpOp(\">\", Int(0))),\n         digitLoopBody)\n       Return(Name(\"total\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 61,
      "module": "VERIFICATION",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "Base equation defining allInts on the empty ValSeq.",
