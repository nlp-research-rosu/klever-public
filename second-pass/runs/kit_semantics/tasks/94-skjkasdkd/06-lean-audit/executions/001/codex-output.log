diff --git a/evidence/08-operational-bridge-probes.sh b/evidence/08-operational-bridge-probes.sh
new file mode 100644
index 0000000000000000000000000000000000000000..6de3d125565e43bb06db100ad380202af7698666
--- /dev/null
+++ b/evidence/08-operational-bridge-probes.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -uo pipefail
+set -x
+
+cc -shared -fPIC -O2 -Wall -Wextra \
+  -o /tmp/audit-work/lean-app-path-shim.so \
+  /audit-output/evidence/lean-app-path-shim.c
+export LD_PRELOAD=/tmp/audit-work/lean-app-path-shim.so
+export PATH=/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin:$PATH
