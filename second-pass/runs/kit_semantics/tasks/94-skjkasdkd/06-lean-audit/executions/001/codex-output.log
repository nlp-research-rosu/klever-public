+printf '%s\n' "$audit_stage5_dir"
+find "$audit_stage5_dir" -maxdepth 2 -type f -printf '%P\n' | sort
+cd "$audit_stage5_dir"
+lake clean
+lake build
+lake env lean ProofAxioms.lean
