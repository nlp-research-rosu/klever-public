      "start_line": 157,
      "text": "  rule largestPrime(.ValSeq, M:Int) => M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 160,
      "module": "VERIFICATION",
      "normalized_sha256": "332a226482b34269d8ccea1f7423a3c2c69d40fbee021d7d672651026f29f285",
      "rationale": "Structural recurrence defining largestPrime for an integer-valued head.",
