      "module": "VERIFICATION",
      "normalized_sha256": "ca4e141078b38af84d1adcf7e28052e43ee8b187d3f9e30e56caaee0e604ec91",
      "rationale": "Adds an unproved symbolic shortcut from a zero remainder directly to false rather than serving as a primary recurrence case.",
      "source_rule_id": "rule-ca4e141078b38af84d1adcf7e28052e43ee8b187d3f9e30e56caaee0e604ec91",
      "start_line": 133,
      "text": "  rule primeTail(N:Int, D:Int) => false\n    requires D >=Int 2\n      andBool D <Int N\n      andBool pyMod(N, D) ==Int 0\n    [simplification]"
    },
