        "text": "  rule primeLoopBody\n    => If(\n         Compare(\n           BinOp(\"%\", Name(\"value\"), Name(\"divisor\")),\n           CmpOp(\"==\", Int(0))),\n         Assign(Name(\"candidate\"), Bool(false)),\n         .Stmts)\n       AugAssign(Name(\"divisor\"), \"+\", Int(1))"
      },
      {
        "attributes": [],
        "end_line": 35,
        "module": "VERIFICATION",
        "normalized_sha256": "00b808d699e2afd3554db8e520d3ff061fc0668e2ac28206c5d877b11692e1cf",
        "source_rule_id": "rule-00b808d699e2afd3554db8e520d3ff061fc0668e2ac28206c5d877b11692e1cf",
        "start_line": 19,
        "text": "  rule scanBody\n    => If(\n         Compare(Name(\"value\"), CmpOp(\">\", Name(\"largest\"))),\n         Assign(\n           Name(\"candidate\"),\n           Compare(Name(\"value\"), CmpOp(\">=\", Int(2))))\n         Assign(Name(\"divisor\"), Int(2))\n         While(\n           Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"value\"))),\n           primeLoopBody)\n         If(\n           Name(\"candidate\"),\n           Assign(\n             Name(\"largest\"),\n             BinOp(\"+\", Name(\"value\"), Int(0))),\n           .Stmts),\n         .Stmts)"
      },
      {
        "attributes": [],
        "end_line": 43,
        "module": "VERIFICATION",
        "normalized_sha256": "59e9ea7317fadd4103ee90f8e6dc3bcb686098eeca881f43b8412ba64af29bbb",
        "source_rule_id": "rule-59e9ea7317fadd4103ee90f8e6dc3bcb686098eeca881f43b8412ba64af29bbb",
        "start_line": 38,
        "text": "  rule digitLoopBody\n    => AugAssign(\n         Name(\"total\"),\n         \"+\",\n         BinOp(\"%\", Name(\"largest\"), Int(10)))\n       AugAssign(Name(\"largest\"), \"//\", Int(10))"
      },
      {
        "attributes": [],
        "end_line": 56,
        "module": "VERIFICATION",
        "normalized_sha256": "c3aa454c3b2e79181e07066aa69428eb616e31841e6d1b1dbcd7500c98c47ec0",
