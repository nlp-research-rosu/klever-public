Module(
  FuncDef("skjkasdkd", Params("lst"),
    Assign(Name("largest"), Int(0))
    Assign(Name("value"), Int(0))
    Assign(Name("candidate"), Bool(false))
    Assign(Name("divisor"), Int(2))
    For(Name("value"), Name("lst"),
      If(Compare(Name("value"), CmpOp(">", Name("largest"))),
        Assign(
          Name("candidate"),
          Compare(Name("value"), CmpOp(">=", Int(2))))
        Assign(Name("divisor"), Int(2))
        While(Compare(Name("divisor"), CmpOp("<", Name("value"))),
          If(Compare(
            BinOp("%", Name("value"), Name("divisor")),
            CmpOp("==", Int(0))),
            Assign(Name("candidate"), Bool(false)),
            )
          AugAssign(Name("divisor"), "+", Int(1)))
        If(Name("candidate"),
          Assign(Name("largest"), BinOp("+", Name("value"), Int(0))),
          ),
        ))
    Assign(Name("total"), Int(0))
    While(Compare(Name("largest"), CmpOp(">", Int(0))),
      AugAssign(
        Name("total"),
        "+",
        BinOp("%", Name("largest"), Int(10)))
      AugAssign(Name("largest"), "//", Int(10)))
    Return(Name("total"))))
+ sed -n 1,240p /reference/k-proof/prompt.py


def skjkasdkd(lst):
    """You are given a list of integers.
    You need to find the largest prime value and return the sum of its digits.

    Examples:
    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10
    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25
    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13
    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11
    For lst = [0,81,12,3,1,21] the output should be 3
    For lst = [0,8,1,2,1,7] the output should be 7
    """
