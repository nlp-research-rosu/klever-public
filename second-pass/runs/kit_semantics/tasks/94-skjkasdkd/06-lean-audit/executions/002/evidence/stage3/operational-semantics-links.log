/reference/k-proof/reference-semantics/semantics/int.k-5-  imports MPY-CORE
/reference/k-proof/reference-semantics/semantics/int.k-6-
/reference/k-proof/reference-semantics/semantics/int.k-7-  rule applyUn("-", I:Int) => 0 -Int I
/reference/k-proof/reference-semantics/semantics/int.k-8-
/reference/k-proof/reference-semantics/semantics/int.k:9:  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
/reference/k-proof/reference-semantics/semantics/int.k-10-  // Bool participates in int arithmetic (x += (a == b))
/reference/k-proof/reference-semantics/semantics/int.k:11:  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
/reference/k-proof/reference-semantics/semantics/int.k:12:  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
/reference/k-proof/reference-semantics/semantics/int.k-13-  // bool is a subtype of int: any Bool operand promotes to 0/1 and re-dispatches
/reference/k-proof/reference-semantics/semantics/int.k-14-  // to the Int cases (the "+" mixed cases above are kept, so "+" is excluded here
/reference/k-proof/reference-semantics/semantics/int.k-15-  // to avoid a duplicate rule — Bool + Bool still promotes via the Bool x Bool rule).
/reference/k-proof/reference-semantics/semantics/int.k:16:  rule applyBin(OP:String, B1:Bool, B2:Bool) => applyBin(OP, boolAsInt(B1), boolAsInt(B2))
/reference/k-proof/reference-semantics/semantics/int.k-17-       requires isArithOp(OP)
/reference/k-proof/reference-semantics/semantics/int.k:18:  rule applyBin(OP:String, B:Bool, I:Int)    => applyBin(OP, boolAsInt(B), I)
/reference/k-proof/reference-semantics/semantics/int.k-19-       requires isArithOp(OP) andBool OP =/=String "+"
/reference/k-proof/reference-semantics/semantics/int.k:20:  rule applyBin(OP:String, I:Int, B:Bool)    => applyBin(OP, I, boolAsInt(B))
/reference/k-proof/reference-semantics/semantics/int.k-21-       requires isArithOp(OP) andBool OP =/=String "+"
/reference/k-proof/reference-semantics/semantics/int.k:22:  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
/reference/k-proof/reference-semantics/semantics/int.k:23:  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
/reference/k-proof/reference-semantics/semantics/int.k:24:  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
/reference/k-proof/reference-semantics/semantics/int.k:25:  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
/reference/k-proof/reference-semantics/semantics/int.k:26:  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
/reference/k-proof/reference-semantics/semantics/int.k-27-
/reference/k-proof/reference-semantics/semantics/int.k:28:  syntax Int ::= pyMod(Int, Int) [function]
/reference/k-proof/reference-semantics/semantics/int.k:29:  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
/reference/k-proof/reference-semantics/semantics/int.k-30-
/reference/k-proof/reference-semantics/semantics/int.k:31:  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
/reference/k-proof/reference-semantics/semantics/int.k:32:  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
/reference/k-proof/reference-semantics/semantics/int.k:33:  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
/reference/k-proof/reference-semantics/semantics/int.k:34:  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
/reference/k-proof/reference-semantics/semantics/int.k:35:  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
/reference/k-proof/reference-semantics/semantics/int.k:36:  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
