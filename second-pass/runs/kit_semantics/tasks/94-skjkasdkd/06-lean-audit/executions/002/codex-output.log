   166	def integerCompare (op : SortString) (x y : SortInt) : SortBool :=
   167	  if op == "<" then decide (x < y)
   168	  else if op == "<=" then decide (x ≤ y)
   169	  else if op == ">" then decide (x > y)
   170	  else if op == ">=" then decide (x ≥ y)
   171	  else if op == "==" then x == y
   172	  else if op == "!=" then !(x == y)
   173	  else false
   174	
   175	def floatCompare (op : SortString) (x y : SortFloat) : SortBool :=
   176	  if op == "<" then decide (x < y)
   177	  else if op == ">" then decide (y < x)
   178	  else if op == "<=" then !(decide (y < x))
   179	  else if op == ">=" then !(decide (x < y))
   180	  else if op == "==" then x == y
   181	  else if op == "!=" then !(x == y)
   182	  else false
   183	
   184	def floatSignificand (f : SortFloat) : Nat :=
   185	  let bits := Float.toBits f
   186	  let rawExponent := ((bits >>> 52) &&& 0x7ff).toNat
   187	  let fraction := (bits &&& 0xfffffffffffff).toNat
   188	  if rawExponent == 0 then fraction else 2 ^ 52 + fraction
   189	
   190	def floatBinaryExponent (f : SortFloat) : Int :=
   191	  let rawExponent := ((Float.toBits f >>> 52) &&& 0x7ff).toNat
   192	  if rawExponent == 0 then -1074
   193	  else (Int.ofNat rawExponent) - 1023 - 52
   194	
   195	def floatNegative (f : SortFloat) : Bool :=
   196	  ((Float.toBits f >>> 63) &&& 1) == 1
   197	
   198	def floatMagnitudeQuotientRemainder (f : SortFloat) : Nat × Nat :=
   199	  let significand := floatSignificand f
   200	  let exponent := floatBinaryExponent f
   201	  if exponent ≥ 0 then
   202	    (significand * 2 ^ exponent.toNat, 0)
   203	  else
   204	    let denominator := 2 ^ (-exponent).toNat
   205	    (significand / denominator, significand % denominator)
   206	
   207	def floatFloorInteger (f : SortFloat) : SortInt :=
   208	  let qr := floatMagnitudeQuotientRemainder f
   209	  if floatNegative f then
   210	    if qr.2 == 0 then -Int.ofNat qr.1 else -Int.ofNat (qr.1 + 1)
   211	  else
   212	    Int.ofNat qr.1
   213	
   214	def floatCeilingInteger (f : SortFloat) : SortInt :=
   215	  let qr := floatMagnitudeQuotientRemainder f
   216	  if floatNegative f then
   217	    -Int.ofNat qr.1
   218	  else
   219	    if qr.2 == 0 then Int.ofNat qr.1 else Int.ofNat (qr.1 + 1)
   220	
   221	def intFloatEqual (integer : SortInt) (floating : SortFloat) : SortBool :=
   222	  if Float.isFinite floating then
   223	    let qr := floatMagnitudeQuotientRemainder floating
   224	    qr.2 == 0 &&
   225	      (if floatNegative floating then -Int.ofNat qr.1 else Int.ofNat qr.1) == integer
   226	  else
   227	    intToFloatModel integer == floating
   228	
   229	def floatLessInteger (floating : SortFloat) (integer : SortInt) : SortBool :=
   230	  if Float.isFinite floating then floatFloorInteger floating < integer
   231	  else decide (floating < intToFloatModel integer)
   232	
   233	def integerLessFloat (integer : SortInt) (floating : SortFloat) : SortBool :=
   234	  if Float.isFinite floating then integer < floatCeilingInteger floating
   235	  else decide (intToFloatModel integer < floating)
   236	
   237	def integerFloatCompare
   238	    (op : SortString) (integer : SortInt) (floating : SortFloat) : SortBool :=
   239	  if op == "==" then intFloatEqual integer floating
   240	  else if op == "!=" then !(intFloatEqual integer floating)
   241	  else if op == "<" then integerLessFloat integer floating
   242	  else if op == ">" then floatLessInteger floating integer
   243	  else if op == "<=" then !(floatLessInteger floating integer)
   244	  else if op == ">=" then !(integerLessFloat integer floating)
   245	  else false
   246	
   247	def floatIntegerCompare
   248	    (op : SortString) (floating : SortFloat) (integer : SortInt) : SortBool :=
   249	  if op == "==" then intFloatEqual integer floating
   250	  else if op == "!=" then !(intFloatEqual integer floating)
   251	  else if op == "<" then floatLessInteger floating integer
   252	  else if op == ">" then integerLessFloat integer floating
   253	  else if op == "<=" then !(integerLessFloat integer floating)
   254	  else if op == ">=" then !(floatLessInteger floating integer)
   255	  else false
   256	
   257	def applyComparisonModel (op : SortString) (left right : SortVal) : SortBool :=
   258	  match left, right with
   259	  | value, .«noneV_MPY-CORE_Val» =>
   260	      if op == "==" || op == "is" then value == noneValue
   261	      else if op == "!=" || op == "is not" then !(value == noneValue)
   262	      else false
   263	  | .inj_SortInt x, .inj_SortInt y =>
   264	      integerCompare op x y
   265	  | .inj_SortInt x, .inj_SortBool y =>
   266	      integerCompare op x (boolAsInteger y)
   267	  | .inj_SortBool x, .inj_SortInt y =>
   268	      integerCompare op (boolAsInteger x) y
   269	  | .inj_SortBool x, .inj_SortBool y =>
   270	      integerCompare op (boolAsInteger x) (boolAsInteger y)
   271	  | .inj_SortFloat x, .inj_SortFloat y =>
   272	      floatCompare op x y
   273	  | .inj_SortInt x, .inj_SortFloat y =>
   274	      integerFloatCompare op x y
   275	  | .inj_SortFloat x, .inj_SortInt y =>
   276	      floatIntegerCompare op x y
   277	  | .inj_SortBool x, .inj_SortFloat y =>
   278	      integerFloatCompare op (boolAsInteger x) y
   279	  | .inj_SortFloat x, .inj_SortBool y =>
   280	      floatIntegerCompare op x (boolAsInteger y)
   281	  | .inj_SortIterable (.«list(_)_MPY-CORE_Iterable_ValSeq» x),
   282	    .inj_SortIterable (.«list(_)_MPY-CORE_Iterable_ValSeq» y) =>
   283	      if op == "==" then x == y
   284	      else if op == "!=" then !(x == y)
   285	      else false
   286	  | .inj_SortIterable (.«tuple(_)_MPY-CORE_Iterable_ValSeq» x),
   287	    .inj_SortIterable (.«tuple(_)_MPY-CORE_Iterable_ValSeq» y) =>
   288	      if op == "==" then x == y
   289	      else if op == "!=" then !(x == y)
   290	      else false
   291	  | .«setV(_)_MPY-SET_Val_IntSeq» x, .«setV(_)_MPY-SET_Val_IntSeq» y =>
   292	      if op == "==" then sameCodeSet x y else false
   293	  | .«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» keys₁ values₁,
   294	    .«dictV(_,_)_MPY-DICT_Val_ValSeq_ValSeq» keys₂ values₂ =>
   295	      if op == "==" then dictionaryEqual keys₁ values₁ keys₂ values₂ else false
   296	  | _, _ => false
   297	
   298	end Operational
