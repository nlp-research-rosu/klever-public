   100	theorem digitSumModel_step (n : Int) (h : n > 0) :
   101	    Operational.pythonModulo n 10 +
   102	        digitSumModel (Int.tdiv (n - Operational.pythonModulo n 10) 10) =
   103	      digitSumModel n := by
   104	  rw [decimalQuotient n h, pythonModuloPositiveTen n h]
   105	  have hNat : 0 < n.toNat := by omega
   106	  rw [digitSumModel_ofNat, digitSumModel, if_pos h]
   107	  exact digitSumNatural_step n.toNat hNat
