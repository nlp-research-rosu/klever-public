index 0000000000000000000000000000000000000000..37602d51dad3d5d1b690de172b2920b42fefba19
--- /dev/null
+++ b//tmp/audit-work/lean_app_path_override.c
@@ -0,0 +1,10 @@
+#include <lean/lean.h>
+
+/* The audit container's /proc mount does not expose /proc/<inner-pid>/exe.
+   Lean 4.22 uses that path rather than /proc/self/exe.  Supply the immutable
+   pinned toolchain executable path so Lean can locate its own sysroot. */
+LEAN_EXPORT lean_obj_res lean_io_app_path(lean_obj_arg world) {
+    (void)world;
+    return lean_io_result_mk_ok(lean_mk_string(
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean"));
+}
