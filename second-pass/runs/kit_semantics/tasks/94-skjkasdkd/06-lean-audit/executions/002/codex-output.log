   119	def intSequenceLength : SortIntSeq → Nat
   120	  | .«.IntSeq_MPY-CORE_IntSeq» => 0
   121	  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» _ rest =>
   122	      intSequenceLength rest + 1
   123	
   124	def codeMember (code : SortInt) : SortIntSeq → Bool
   125	  | .«.IntSeq_MPY-CORE_IntSeq» => false
   126	  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head rest =>
   127	      code == head || codeMember code rest
   128	
   129	def codeSubset : SortIntSeq → SortIntSeq → Bool
   130	  | .«.IntSeq_MPY-CORE_IntSeq», _ => true
   131	  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head rest, other =>
   132	      codeMember head other && codeSubset rest other
   133	
   134	def sameCodeSet (left right : SortIntSeq) : Bool :=
   135	  codeSubset left right && codeSubset right left
   136	
   137	def valueSequenceLength : SortValSeq → Nat
   138	  | .«.ValSeq_MPY-CORE_ValSeq» => 0
   139	  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest =>
   140	      valueSequenceLength rest + 1
   141	
   142	def dictionaryLookup (key : SortVal) : SortValSeq → SortValSeq → Option SortVal
   143	  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» firstKey remainingKeys,
   144	    .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» firstValue remainingValues =>
   145	      if firstKey == key then some firstValue
   146	      else dictionaryLookup key remainingKeys remainingValues
   147	  | _, _ => none
   148	
   149	def dictionarySubset : SortValSeq → SortValSeq → SortValSeq → SortValSeq → Bool
   150	  | .«.ValSeq_MPY-CORE_ValSeq», .«.ValSeq_MPY-CORE_ValSeq», _, _ => true
   151	  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» key remainingKeys,
   152	    .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value remainingValues,
   153	    otherKeys, otherValues =>
   154	      match dictionaryLookup key otherKeys otherValues with
   155	      | some otherValue =>
   156	          otherValue == value &&
   157	            dictionarySubset remainingKeys remainingValues otherKeys otherValues
   158	      | none => false
   159	  | _, _, _, _ => false
   160	
   161	def dictionaryEqual
   162	    (keys₁ values₁ keys₂ values₂ : SortValSeq) : Bool :=
   163	  valueSequenceLength keys₁ == valueSequenceLength keys₂ &&
   164	    dictionarySubset keys₁ values₁ keys₂ values₂
