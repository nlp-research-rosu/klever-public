    57	
    58	def integerBinary (op : SortString) (x y : SortInt) : SortVal :=
    59	  if op == "+" then intValue (x + y)
    60	  else if op == "-" then intValue (x - y)
    61	  else if op == "*" then intValue (x * y)
    62	  else if op == "%" then intValue (pythonModulo x y)
    63	  else if op == "//" then intValue (Int.tdiv (x - pythonModulo x y) y)
    64	  else if op == "/" then floatValue (intToFloatModel x / intToFloatModel y)
    65	  else if op == "**" then integerPower x y
    66	  else noneValue
