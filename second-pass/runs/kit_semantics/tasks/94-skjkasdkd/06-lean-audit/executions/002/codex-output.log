    93	/- The selected generated sort universe contains every MPY value production
    94	used by the target except `Str`; Klean omitted that unreferenced subsort and
    95	there is therefore no Lean constructor on which a string dispatch arm could
    96	match.  All representable arms of the frozen applyBin table are below. -/
    97	def applyBinaryModel (op : SortString) (left right : SortVal) : SortVal :=
    98	  match left, right with
    99	  | .inj_SortInt x, .inj_SortInt y =>
   100	      integerBinary op x y
   101	  | .inj_SortInt x, .inj_SortBool y =>
   102	      integerBinary op x (boolAsInteger y)
   103	  | .inj_SortBool x, .inj_SortInt y =>
   104	      integerBinary op (boolAsInteger x) y
   105	  | .inj_SortBool x, .inj_SortBool y =>
   106	      integerBinary op (boolAsInteger x) (boolAsInteger y)
   107	  | .inj_SortFloat x, .inj_SortFloat y =>
   108	      floatBinary op x y
   109	  | .inj_SortInt x, .inj_SortFloat y =>
   110	      integerFloatBinary op x y
   111	  | .inj_SortFloat x, .inj_SortInt y =>
   112	      floatIntegerBinary op x y
   113	  | .inj_SortBool x, .inj_SortFloat y =>
   114	      integerFloatBinary op (boolAsInteger x) y
   115	  | .inj_SortFloat x, .inj_SortBool y =>
   116	      floatIntegerBinary op x (boolAsInteger y)
   117	  | _, _ => noneValue
