    47	def intToFloatModel : SortInt → SortFloat
    48	  | .ofNat n => Float.ofScientific n false 0
    49	  | .negSucc n => -Float.ofScientific (n + 1) false 0
    50	
    51	def pythonModulo (x y : SortInt) : SortInt :=
