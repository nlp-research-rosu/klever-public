    LEAN_SRC_PATH=/tmp/audit-work/proof-audit-final/Base:/tmp/audit-work/proof-audit-final:/opt/elan/toolchains/leanprover--lean4---v4.22.0/src/lean/lake \\
    /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean OperationalAudit.lean
} 2>&1 | tee /audit-output/evidence/stage5/operational-adversarial-tests.log
status="'${PIPESTATUS[0]}
