diff --git a//tmp/audit-work/proof-audit-final/OperationalAudit.lean b//tmp/audit-work/proof-audit-final/OperationalAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..a1f77f6d8e34eaf7573d870a5da916f2c5e8baa3
--- /dev/null
+++ b//tmp/audit-work/proof-audit-final/OperationalAudit.lean
@@ -0,0 +1,106 @@
+import Proof
+
+open Proof
+
+def intValue (n : Int) : SortVal := SortVal.inj_SortInt n
+def boolValue (b : Bool) : SortVal := SortVal.inj_SortBool b
+
+def intK (n : Int) : SortK :=
+  SortK.kseq ((@inj SortVal SortKItem) (intValue n)) SortK.dotk
+
+def boolK (b : Bool) : SortK :=
+  SortK.kseq ((@inj SortVal SortKItem) (boolValue b)) SortK.dotk
+
+def bridgeChecks : List (String × Bool) :=
+  [ ("minus-positive", Proof.«_-Int_» 7 3 == 4)
+  , ("minus-negative", Proof.«_-Int_» (-7) 3 == -10)
+  , ("and-true-false", Proof._andBool_ true false == false)
+  , ("gt-true", Proof.«_>Int_» 5 3 == true)
+  , ("gt-equal-false", Proof.«_>Int_» 3 3 == false)
+  , ("ge-equal-true", Proof.«_>=Int_» 3 3 == true)
+  , ("lt-negative", Proof.«_<Int_» (-2) 0 == true)
+  , ("le-equal", Proof.«_<=Int_» (-2) (-2) == true)
+  , ("eq-int", Proof.«_==Int_» (-2) (-2) == true)
+  , ("neq-int", Proof.«_=/=Int_» (-2) 2 == true)
+  , ("percent-trunc-negative", Proof.«_%Int_» (-13) 10 == -3)
+  , ("plus-int", Proof.«_+Int_» (-13) 10 == -3)
+  , ("divide-trunc-negative", Proof.«_/Int_» (-13) 10 == -1)
+  , ("applyBin-python-modulo",
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "%" (intValue (-13)) (intValue 10)
+        == intValue 7)
+  , ("applyBin-plus",
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "+" (intValue 5) (intValue 8)
+        == intValue 13)
+  , ("applyCmp-greater",
+      Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">" (intValue 5) (intValue 3)
+        == true)
+  , ("applyCmp-ge-equal",
+      Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">=" (intValue 3) (intValue 3)
+        == true)
+  , ("applyCmp-less",
+      Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» "<" (intValue (-2)) (intValue 0)
+        == true)
+  , ("defined-project-int",
+      Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» (intValue 17) == true)
+  , ("undefined-project-bool",
+      Proof.«definedProjectInt(_)_VERIFICATION_Bool_Val» (boolValue true) == false)
+  , ("digit-sum-zero", Proof.«digitSum(_)_VERIFICATION_Int_Int» 0 == 0)
+  , ("digit-sum-181", Proof.«digitSum(_)_VERIFICATION_Int_Int» 181 == 10)
+  , ("digit-sum-4597", Proof.«digitSum(_)_VERIFICATION_Int_Int» 4597 == 25)
+  , ("digit-sum-negative", Proof.«digitSum(_)_VERIFICATION_Int_Int» (-5) == 0)
+  , ("isInt-int", Proof.isInt (intK 17) == true)
+  , ("isInt-bool", Proof.isInt (boolK true) == false)
+  , ("isInt-non-singleton-kseq",
+      Proof.isInt (SortK.kseq ((@inj SortVal SortKItem) (intValue 17))
+        (SortK.kseq ((@inj SortVal SortKItem) (intValue 4)) SortK.dotk)) == false)
+  , ("primeTail-prime", Proof.«primeTail(_,_)_VERIFICATION_Bool_Int_Int» 7 2 == true)
+  , ("primeTail-composite", Proof.«primeTail(_,_)_VERIFICATION_Bool_Int_Int» 9 2 == false)
+  , ("primeTail-below-domain", Proof.«primeTail(_,_)_VERIFICATION_Bool_Int_Int» 7 1 == false)
+  , ("primeTail-completed", Proof.«primeTail(_,_)_VERIFICATION_Bool_Int_Int» 2 2 == true)
+  , ("project-colon-int", Proof.«project:Int» (intK 17) == 17)
+  , ("project-total-int", Proof.projectIntTotal (intValue 17) == 17)
+  , ("project-total-outside-guard", Proof.projectIntTotal (boolValue true) == 0)
+  , ("python-mod-negative-dividend", Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-13) 10 == 7)
+  , ("python-mod-negative-divisor", Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» 13 (-10) == -7)
+  , ("project-option-int", Proof.«project:Int?» (intK 17) == some 17)
+  , ("project-option-bool", Proof.«project:Int?» (boolK true) == none)
+  ]
+
+#eval bridgeChecks
+#eval bridgeChecks.all (fun item => item.2)
+
+-- Counterfactual convenient bridges. Each comparison is true only because the
+-- candidate's actual definition distinguishes an operationally meaningful
+-- input from the proposed mutation.
+def constantPrimeTail (_n _d : SortInt) : SortBool := false
+def identityDigitSum (n : SortInt) : SortInt := n
+def hardCodedProjection (_term : SortK) : SortInt := 0
+def truncatingInsteadOfPythonModulo (x y : SortInt) : SortInt := Int.tmod x y
+def constantComparison (_op : SortString) (_left _right : SortVal) : SortBool := false
+def leftIdentityBinary (_op : SortString) (left _right : SortVal) : SortVal := left
+def constantIsInt (_term : SortK) : SortBool := false
+
+def counterfactualChecks : List (String × Bool) :=
+  [ ("primeTail-not-constant-false",
+      Proof.«primeTail(_,_)_VERIFICATION_Bool_Int_Int» 7 2 != constantPrimeTail 7 2)
+  , ("digitSum-not-identity",
+      Proof.«digitSum(_)_VERIFICATION_Int_Int» 181 != identityDigitSum 181)
+  , ("projection-not-hard-coded",
+      Proof.«project:Int» (intK 17) != hardCodedProjection (intK 17))
+  , ("python-mod-not-truncating-mod",
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-13) 10 !=
+        truncatingInsteadOfPythonModulo (-13) 10)
+  , ("comparison-not-constant-false",
+      Proof.«applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val» ">" (intValue 5) (intValue 3) !=
+        constantComparison ">" (intValue 5) (intValue 3))
+  , ("binary-not-left-identity",
+      Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val» "+" (intValue 5) (intValue 8) !=
+        leftIdentityBinary "+" (intValue 5) (intValue 8))
+  , ("isInt-not-constant-false", Proof.isInt (intK 17) != constantIsInt (intK 17))
+  ]
+
+#eval counterfactualChecks
+#eval counterfactualChecks.all (fun item => item.2)
+
+example : bridgeChecks.all (fun item => item.2) = true := by native_decide
+example : counterfactualChecks.all (fun item => item.2) = true := by native_decide
diff --git a/evidence/README.md b/evidence/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..fc81b6702cfbb812b379c5c48cb7123840d82fd7
--- /dev/null
+++ b/evidence/README.md
@@ -0,0 +1,11 @@
+# Audit evidence
+
+Each `.log` file records shell tracing (`+ command`), combined standard output/error, and relevant exit-status checks for the independently rerun audit command named by the file. JSON evidence is emitted directly by the trusted checker or by a read-only inspection command recorded in the adjacent log.
+
+Authoritative successful reruns are:
+
+- Stage 3: `reconstructed-inventory.json`, `inventory-bijection.log`, and `independent-classification.md`.
+- Stage 4: `producer-authentication-corrected.log`, `check-generation-proc-compat.log`, `independent-generation-audit.log`, and `mathematical-obligation-review.md`.
+- Stage 5: `fresh-copy-corrected.log`, `lake-clean.log`, `lake-build.log`, `candidate-integrity-check.log`, `print-axioms-direct.log`, `axiom-reconciliation.log`, `operational-adversarial-tests.log`, and `operational-bridge-review.md`.
+
+Earlier Stage 4 app-path experiments and the first `check-generation.log` are deliberately retained as raw diagnostics. They document the container `/proc/<pid>/exe` incompatibility and are superseded by the pinned-toolchain `/proc/self/exe` compatibility rerun. Likewise, `stage5/fresh-copy.log` records a first copy that nested `generated/` under the candidate's pre-existing empty `Base`; `fresh-copy-corrected.log` is the exact corrected copy. `print-axioms.log` records why `lake env` reordering masked the compatibility library; `print-axioms-direct.log` is the exact successful Lean run with Lake's resolved paths. No read-only mounted artifact was modified.
