    87	  else if op == "-" then floatValue (x - intToFloatModel y)
    88	  else if op == "*" then floatValue (x * intToFloatModel y)
    89	  else if op == "/" then floatValue (x / intToFloatModel y)
    90	  else if op == "**" then floatValue (Float.pow x (intToFloatModel y))
