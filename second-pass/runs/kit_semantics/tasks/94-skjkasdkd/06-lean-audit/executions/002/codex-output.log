    58	def integerBinary (op : SortString) (x y : SortInt) : SortVal :=
    59	  if op == "+" then intValue (x + y)
    60	  else if op == "-" then intValue (x - y)
    61	  else if op == "*" then intValue (x * y)
    62	  else if op == "%" then intValue (pythonModulo x y)
    63	  else if op == "//" then intValue (Int.tdiv (x - pythonModulo x y) y)
    64	  else if op == "/" then floatValue (intToFloatModel x / intToFloatModel y)
    65	  else if op == "**" then integerPower x y
    66	  else noneValue
    67	
    68	def floatBinary (op : SortString) (x y : SortFloat) : SortVal :=
    69	  if op == "+" then floatValue (x + y)
    70	  else if op == "-" then floatValue (x - y)
    71	  else if op == "*" then floatValue (x * y)
    72	  else if op == "/" then floatValue (x / y)
    73	  else if op == "%" then floatValue (x - Float.floor (x / y) * y)
    74	  else if op == "**" then floatValue (Float.pow x y)
    75	  else noneValue
    76	
    77	def integerFloatBinary (op : SortString) (x : SortInt) (y : SortFloat) : SortVal :=
