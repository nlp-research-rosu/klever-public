    79	  else if op == "-" then floatValue (intToFloatModel x - y)
    80	  else if op == "*" then floatValue (intToFloatModel x * y)
    81	  else if op == "/" then floatValue (intToFloatModel x / y)
    82	  else if op == "**" then floatValue (Float.pow (intToFloatModel x) y)
