     1	def skjkasdkd(lst):
     2	    largest = 0
     3	    value = 0
     4	    candidate = False
     5	    divisor = 2
     6	    for value in lst:
     7	        if value > largest:
     8	            candidate = value >= 2
     9	            divisor = 2
    10	            while divisor < value:
    11	                if value % divisor == 0:
    12	                    candidate = False
    13	                divisor += 1
    14	            if candidate:
    15	                largest = value + 0
    16	    total = 0
    17	    while largest > 0:
    18	        total += largest % 10
    19	        largest //= 10
    20	    return total
    21	
    22	
    23	def skjkasdkd(lst):
    24	    """You are given a list of integers.
    25	    You need to find the largest prime value and return the sum of its digits.
    26	
    27	    Examples:
    28	    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10
    29	    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25
    30	    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13
    31	    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11
    32	    For lst = [0,81,12,3,1,21] the output should be 3
    33	    For lst = [0,8,1,2,1,7] the output should be 7
    34	    """

