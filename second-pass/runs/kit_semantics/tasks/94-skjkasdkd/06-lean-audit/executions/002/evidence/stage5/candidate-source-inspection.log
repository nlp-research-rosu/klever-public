   117	def primeTailModel (n d : Int) : Bool :=
   118	  if d < 2 then false
   119	  else if d >= n then true
   120	  else if Operational.pythonModulo n d == 0 then false
   121	  else primeTailModel n (d + 1)
   122	termination_by (n - d).toNat
   123	decreasing_by
   124	  simp_wf
