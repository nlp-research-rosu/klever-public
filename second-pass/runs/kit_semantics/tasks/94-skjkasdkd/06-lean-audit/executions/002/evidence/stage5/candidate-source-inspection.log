   166	def integerCompare (op : SortString) (x y : SortInt) : SortBool :=
   167	  if op == "<" then decide (x < y)
   168	  else if op == "<=" then decide (x ≤ y)
   169	  else if op == ">" then decide (x > y)
   170	  else if op == ">=" then decide (x ≥ y)
