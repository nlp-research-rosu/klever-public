    63	theorem digitSumNatural_step (n : Nat) (h : 0 < n) :
    64	    Int.ofNat (n % 10) + digitSumNatural (n / 10) = digitSumNatural n := by
    65	  cases n with
    66	  | zero => omega
    67	  | succ k => rw [digitSumNatural]
