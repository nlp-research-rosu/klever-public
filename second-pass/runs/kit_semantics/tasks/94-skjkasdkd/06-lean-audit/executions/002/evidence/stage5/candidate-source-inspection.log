    75	theorem pythonModuloPositiveTen (n : Int) (h : n > 0) :
    76	    Operational.pythonModulo n 10 = Int.ofNat (n.toNat % 10) := by
    77	  have hn : 0 ≤ n := by omega
    78	  have hr : 0 ≤ n % 10 := Int.emod_nonneg n (by omega)
    79	  have hrs : 0 ≤ n % 10 + 10 := by omega
    80	  simp [Operational.pythonModulo, Int.tmod_eq_emod, hn, hrs, Int.max_eq_left hn]
    81	
    82	theorem decimalQuotient (n : Int) (h : n > 0) :
    83	    Int.tdiv (n - Operational.pythonModulo n 10) 10 =
    84	      Int.ofNat (n.toNat / 10) := by
    85	  rw [pythonModuloPositiveTen n h]
    86	  have hn : 0 ≤ n := by omega
    87	  have hr : 0 ≤ n % 10 := Int.emod_nonneg n (by omega)
    88	  have hrlt : n % 10 < 10 := by
    89	    have bound := Int.emod_lt n (show (10 : Int) ≠ 0 by omega)
    90	    omega
    91	  have hcast : Int.ofNat (n.toNat % 10) = n % 10 := by
    92	    simp [Int.natCast_emod, Int.toNat_of_nonneg hn]
    93	  rw [hcast, Int.tdiv_eq_ediv]
    94	  simp only [show 0 ≤ n - n % 10 by omega, true_or, ↓reduceIte, Int.add_zero]
    95	  have hnatdiv : Int.ofNat (n.toNat / 10) = n / 10 := by
    96	    simpa only [Int.toNat_of_nonneg hn] using (Int.natCast_ediv n.toNat 10)
    97	  rw [hnatdiv]
    98	  omega
