    69	theorem digitSumModel_ofNat (n : Nat) :
    70	    digitSumModel (Int.ofNat n) = digitSumNatural n := by
    71	  cases n with
    72	  | zero => simp [digitSumModel, digitSumNatural]
    73	  | succ k => simp [digitSumModel]
