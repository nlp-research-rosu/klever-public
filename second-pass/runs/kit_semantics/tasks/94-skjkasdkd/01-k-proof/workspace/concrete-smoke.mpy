Module(
  FuncDef("skjkasdkd", Params("lst"),
    Assign(Name("largest"), Int(0))
    Assign(Name("value"), Int(0))
    Assign(Name("candidate"), Bool(false))
    Assign(Name("divisor"), Int(2))
    For(Name("value"), Name("lst"),
      If(Compare(Name("value"), CmpOp(">", Name("largest"))),
        Assign(
          Name("candidate"),
          Compare(Name("value"), CmpOp(">=", Int(2))))
        Assign(Name("divisor"), Int(2))
        While(Compare(Name("divisor"), CmpOp("<", Name("value"))),
          If(Compare(
            BinOp("%", Name("value"), Name("divisor")),
            CmpOp("==", Int(0))),
            Assign(Name("candidate"), Bool(false)),
            )
          AugAssign(Name("divisor"), "+", Int(1)))
        If(Name("candidate"),
          Assign(Name("largest"), BinOp("+", Name("value"), Int(0))),
          ),
        ))
    Assign(Name("total"), Int(0))
    While(Compare(Name("largest"), CmpOp(">", Int(0))),
      AugAssign(
        Name("total"),
        "+",
        BinOp("%", Name("largest"), Int(10)))
      AugAssign(Name("largest"), "//", Int(10)))
    Return(Name("total")))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          Int(0),
          Int(3),
          Int(2),
          Int(1),
          Int(3),
          Int(5),
          Int(7),
          Int(4),
          Int(5),
          Int(5),
          Int(5),
          Int(2),
          Int(181),
          Int(32),
          Int(4),
          Int(32),
          Int(3),
          Int(2),
          Int(32),
          Int(324),
          Int(4),
          Int(3))),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          Int(1),
          Int(0),
          Int(1),
          Int(8),
          Int(2),
          Int(4597),
          Int(2),
          Int(1),
          Int(3),
          Int(40),
          Int(1),
          Int(2),
          Int(1),
          Int(2),
          Int(4),
          Int(2),
          Int(5),
          Int(1))),
      CmpOp("==", Int(25))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          Int(1),
          Int(3),
          Int(1),
          Int(32),
          Int(5107),
          Int(34),
          Int(83278),
          Int(109),
          Int(163),
          Int(23),
          Int(2323),
          Int(32),
          Int(30),
          Int(1),
          Int(9),
          Int(3))),
      CmpOp("==", Int(13))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          Int(0),
          Int(724),
          Int(32),
          Int(71),
          Int(99),
          Int(32),
          Int(6),
          Int(0),
          Int(5),
          Int(91),
          Int(83),
          Int(0),
          Int(5),
          Int(6))),
      CmpOp("==", Int(11))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(Int(0), Int(81), Int(12), Int(3), Int(1), Int(21))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(Int(0), Int(8), Int(1), Int(2), Int(1), Int(7))),
      CmpOp("==", Int(7))))
  Assert(
    Compare(Call(Name("skjkasdkd"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          UnaryOp("-", Int(7)),
          UnaryOp("-", Int(3)),
          Int(0),
          Int(1),
          Int(4))),
      CmpOp("==", Int(0)))))
