+def skjkasdkd(lst):
+    largest = 0
+    value = 0
+    candidate = False
+    divisor = 2
+    for value in lst:
+        if value > largest:
+            candidate = value >= 2
+            divisor = 2
+            while divisor < value:
+                if value % divisor == 0:
+                    candidate = False
+                divisor += 1
+            if candidate:
+                largest = value
+    total = 0
+    while largest > 0:
+        total += largest % 10
+        largest //= 10
+    return total
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..13b90c24dfcf9767e75e38f90cf6da5d7a6684b9
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,115 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The primality loop preserves whether the already-visited divisor prefix
+  // was clean and appends the exact remaining divisor predicate.
+  claim [prime-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("value"))),
+        primeLoopBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ( "value"     |-> V:Val
+          "candidate" |-> (C:Bool
+                           => C andBool
+                              primeTail(projectIntTotal(V), D))
+          "divisor"   |-> (D:Int
+                           => maxInt(D, projectIntTotal(V)))
+          REST:Map ),
+        P:Parent)
+      ...
+    </scopes>
+    requires isInt(V)
+      andBool D >=Int 2
+      andBool notBool ("value" in_keys(REST))
+      andBool notBool ("candidate" in_keys(REST))
+      andBool notBool ("divisor" in_keys(REST))
+
+  // Symbolic, unbounded traversal of the input list.  The three scratch
+  // variables are intentionally existential on exit; only largest is
+  // observable after this loop.
+  claim [scan-loop]:
+    <k>
+      #loop(list(VS:ValSeq), Name("value"), scanBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ( "largest"   |-> (M:Int => largestPrime(VS, M))
+          "value"     |-> (V0:Val => ?VF:Val)
+          "candidate" |-> (C0:Bool => ?CF:Bool)
+          "divisor"   |-> (D0:Int => ?DF:Int)
+          REST:Map ),
+        P:Parent)
+      ...
+    </scopes>
+    requires M >=Int 0
+      andBool allInts(VS)
+      andBool notBool ("largest" in_keys(REST))
+      andBool notBool ("value" in_keys(REST))
+      andBool notBool ("candidate" in_keys(REST))
+      andBool notBool ("divisor" in_keys(REST))
+
+  // Decimal decomposition invariant for every nonnegative value produced by
+  // the list scan.
+  claim [digit-loop]:
+    <k>
+      #while(
+        Compare(Name("largest"), CmpOp(">", Int(0))),
+        digitLoopBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ( "largest" |-> (N:Int => 0)
+          "total"   |-> (T:Int => T +Int digitSum(N))
+          REST:Map ),
+        P:Parent)
+      ...
+    </scopes>
+    requires N >=Int 0
+      andBool notBool ("largest" in_keys(REST))
+      andBool notBool ("total" in_keys(REST))
+
+  // Required target theorem: load the exact translated definition, invoke its
+  // required entry point, and cover every finite ValSeq whose elements are Int.
+  claim [target]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("skjkasdkd", Params("lst"), targetBody)))
+      ~> Call(Name("skjkasdkd"), list(VS:ValSeq))
+      => digitSum(largestPrime(VS, 0))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "skjkasdkd" |->
+             closureVal(("lst", .ParamNames), targetBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bab5abdde6fddafd687df6db4d34c99a89f0a1ff
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,151 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact syntax aliases for the three loop bodies and the translated
+  // function body.  These aliases only keep the claims readable.
+  syntax Stmts ::= "primeLoopBody" [function, total]
+  rule primeLoopBody
+    => If(
+         Compare(
+           BinOp("%", Name("value"), Name("divisor")),
+           CmpOp("==", Int(0))),
+         Assign(Name("candidate"), Bool(false)),
+         .Stmts)
+       AugAssign(Name("divisor"), "+", Int(1))
+
+  syntax Stmts ::= "scanBody" [function, total]
+  rule scanBody
+    => If(
+         Compare(Name("value"), CmpOp(">", Name("largest"))),
+         Assign(
+           Name("candidate"),
+           Compare(Name("value"), CmpOp(">=", Int(2))))
+         Assign(Name("divisor"), Int(2))
+         While(
+           Compare(Name("divisor"), CmpOp("<", Name("value"))),
+           primeLoopBody)
+         If(
+           Name("candidate"),
+           Assign(Name("largest"), Name("value")),
+           .Stmts),
+         .Stmts)
+
+  syntax Stmts ::= "digitLoopBody" [function, total]
+  rule digitLoopBody
+    => AugAssign(
+         Name("total"),
+         "+",
+         BinOp("%", Name("largest"), Int(10)))
+       AugAssign(Name("largest"), "//", Int(10))
+
+  syntax Stmts ::= "targetBody" [function, total]
+  rule targetBody
+    => Assign(Name("largest"), Int(0))
+       Assign(Name("value"), Int(0))
+       Assign(Name("candidate"), Bool(false))
+       Assign(Name("divisor"), Int(2))
+       For(Name("value"), Name("lst"), scanBody)
+       Assign(Name("total"), Int(0))
+       While(
+         Compare(Name("largest"), CmpOp(">", Int(0))),
+         digitLoopBody)
+       Return(Name("total"))
+
+  // The source contract restricts list elements to integers.  This predicate
+  // carries that dynamic-language fact through symbolic ValSeq iteration.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // Guarded total projection of a dynamically sorted Val known to be an Int.
+  // This is the standard total-projection pattern: it does not invent a value;
+  // it is usable only under the exact generated sort predicate.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val))
+    => projectIntTotal(V)
+    [simplification]
+
+  // Guarded dispatch twins of the fixed MPY-INT equations used by the program.
+  // Their match domain is exactly the original Int domain.
+  rule applyCmp(">", V:Val, I:Int)
+    => projectIntTotal(V) >Int I
+    requires isInt(V)
+    [simplification]
+
+  rule applyCmp(">=", V:Val, I:Int)
+    => projectIntTotal(V) >=Int I
+    requires isInt(V)
+    [simplification]
+
+  rule applyCmp("<", I:Int, V:Val)
+    => I <Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  rule applyBin("%", V:Val, I:Int)
+    => pyMod(projectIntTotal(V), I)
+    requires isInt(V)
+    [simplification]
+
+  // No divisor in [D, N) divides N.  D < 2 is an unused totalization case.
+  syntax Bool ::= primeTail(Int, Int) [function, total]
+  rule primeTail(_N:Int, D:Int) => false
+    requires D <Int 2
+  rule primeTail(N:Int, D:Int) => true
+    requires D >=Int 2 andBool D >=Int N
+  rule primeTail(N:Int, D:Int)
+    => notBool (pyMod(N, D) ==Int 0)
+       andBool primeTail(N, D +Int 1)
+    requires D >=Int 2 andBool D <Int N
+
+  syntax Bool ::= isPrime(Int) [function, total]
+  rule isPrime(N:Int)
+    => N >=Int 2 andBool primeTail(N, 2)
+
+  // One scan step: retain M unless X is both larger and prime.
+  syntax Int ::= selectPrime(Int, Int) [function, total]
+  rule selectPrime(M:Int, X:Int) => X
+    requires X >Int M andBool isPrime(X)
+  rule selectPrime(M:Int, X:Int) => M
+    requires notBool (X >Int M andBool isPrime(X))
+
+  // Fold selectPrime across the complete symbolic input list.
+  syntax Int ::= largestPrime(ValSeq, Int) [function, total]
+  rule largestPrime(.ValSeq, M:Int) => M
+  rule largestPrime(vCons(V:Val, R:ValSeq), M:Int)
+    => largestPrime(R, selectPrime(M, projectIntTotal(V)))
+    requires isInt(V)
+  rule largestPrime(vCons(V:Val, R:ValSeq), M:Int)
+    => largestPrime(R, M)
+    requires notBool isInt(V)
+
+  // Decimal digit sum for the nonnegative accumulator produced by the scan.
+  syntax Int ::= digitSum(Int) [function, total]
+  rule digitSum(N:Int) => 0
+    requires N <=Int 0
+  rule digitSum(N:Int)
+    => pyMod(N, 10)
+       +Int digitSum((N -Int pyMod(N, 10)) /Int 10)
+    requires N >Int 0
+endmodule

exec
/bin/bash -lc 'kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /workspace
