diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6476c8364a31548ec17a27b50d06a1b0ffbeb182
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,110 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The primality loop preserves whether the already-visited divisor prefix
+  // was clean and appends the exact remaining divisor predicate.
+  claim [prime-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("value"))),
+        primeLoopBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ( "lst"       |-> list(ALL:ValSeq)
+          "largest"   |-> M:Int
+          "value"     |-> V:Val
+          "candidate" |-> (C:Bool
+                           => C andBool
+                              primeTail(projectIntTotal(V), D))
+          "divisor"   |-> (D:Int
+                           => maxInt(D, projectIntTotal(V))) ),
+        parent(0))
+      ...
+    </scopes>
+    requires isInt(V)
+      andBool D >=Int 2
+
+  // Symbolic, unbounded traversal of the input list.  The three scratch
+  // variables are intentionally existential on exit; only largest is
+  // observable after this loop.
+  claim [scan-loop]:
+    <k>
+      #loop(list(VS:ValSeq), Name("value"), scanBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ( "lst"       |-> list(ALL:ValSeq)
+          "largest"   |-> (M:Int => largestPrime(VS, M))
+          "value"     |-> (V0:Val => ?VF:Val)
+          "candidate" |-> (C0:Bool => ?CF:Bool)
+          "divisor"   |-> (D0:Int => ?DF:Int) ),
+        parent(0))
+      ...
+    </scopes>
+    requires M >=Int 0
+      andBool allInts(VS)
+
+  // Decimal decomposition invariant for every nonnegative value produced by
+  // the list scan.
+  claim [digit-loop]:
+    <k>
+      #while(
+        Compare(Name("largest"), CmpOp(">", Int(0))),
+        digitLoopBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ( "lst"       |-> list(ALL:ValSeq)
+          "largest"   |-> (N:Int => 0)
+          "value"     |-> V:Val
+          "candidate" |-> C:Bool
+          "divisor"   |-> D:Int
+          "total"     |-> (T:Int => T +Int digitSum(N)) ),
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0
+
+  // Required target theorem: load the exact translated definition, invoke its
+  // required entry point, and cover every finite ValSeq whose elements are Int.
+  claim [target]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("skjkasdkd", Params("lst"), targetBody)))
+      ~> Call(Name("skjkasdkd"), list(VS:ValSeq))
+      => digitSum(largestPrime(VS, 0))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "skjkasdkd" |->
+             closureVal(("lst", .ParamNames), targetBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2dfdc7855df745e6073eb23a92c6ff03b5d69490
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,192 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact syntax aliases for the three loop bodies and the translated
+  // function body.  These aliases only keep the claims readable.
+  syntax Stmts ::= "primeLoopBody" [function, total]
+  rule primeLoopBody
+    => If(
+         Compare(
+           BinOp("%", Name("value"), Name("divisor")),
+           CmpOp("==", Int(0))),
+         Assign(Name("candidate"), Bool(false)),
+         .Stmts)
+       AugAssign(Name("divisor"), "+", Int(1))
+
+  syntax Stmts ::= "scanBody" [function, total]
+  rule scanBody
+    => If(
+         Compare(Name("value"), CmpOp(">", Name("largest"))),
+         Assign(
+           Name("candidate"),
+           Compare(Name("value"), CmpOp(">=", Int(2))))
+         Assign(Name("divisor"), Int(2))
+         While(
+           Compare(Name("divisor"), CmpOp("<", Name("value"))),
+           primeLoopBody)
+         If(
+           Name("candidate"),
+           Assign(
+             Name("largest"),
+             BinOp("+", Name("value"), Int(0))),
+           .Stmts),
+         .Stmts)
+
+  syntax Stmts ::= "digitLoopBody" [function, total]
+  rule digitLoopBody
+    => AugAssign(
+         Name("total"),
+         "+",
+         BinOp("%", Name("largest"), Int(10)))
+       AugAssign(Name("largest"), "//", Int(10))
+
+  syntax Stmts ::= "targetBody" [function, total]
+  rule targetBody
+    => Assign(Name("largest"), Int(0))
+       Assign(Name("value"), Int(0))
+       Assign(Name("candidate"), Bool(false))
+       Assign(Name("divisor"), Int(2))
+       For(Name("value"), Name("lst"), scanBody)
+       Assign(Name("total"), Int(0))
+       While(
+         Compare(Name("largest"), CmpOp(">", Int(0))),
+         digitLoopBody)
+       Return(Name("total"))
+
+  // The source contract restricts list elements to integers.  This predicate
+  // carries that dynamic-language fact through symbolic ValSeq iteration.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, R:ValSeq))
+    => isInt(V) andBool allInts(R)
+
+  // Guarded total projection of a dynamically sorted Val known to be an Int.
+  // This is the standard total-projection pattern: it does not invent a value;
+  // it is usable only under the exact generated sort predicate.
+  syntax Bool ::= definedProjectInt(Val) [function, total]
+  rule definedProjectInt(V:Val) => isInt(V)
+
+  syntax Int ::= projectIntTotal(Val)
+    [function, total, symbol(projectIntTotal), no-evaluators]
+
+  rule #Ceil({@V:Val}:>Int)
+    => ({ definedProjectInt(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+
+  rule projectIntTotal(V:Val) => {V}:>Int
+    requires definedProjectInt(V)
+    [concrete, simplification(10), preserves-definedness]
+
+  rule {V:Val}:>Int => projectIntTotal(V)
+    requires definedProjectInt(V)
+    [symbolic(V), simplification, preserves-definedness]
+
+  rule projectIntTotal(I:Int) => I [simplification]
+  rule projectIntTotal(projectIntTotal(V:Val))
+    => projectIntTotal(V)
+    [simplification]
+
+  // Guarded dispatch twins of the fixed MPY-INT equations used by the program.
+  // Their match domain is exactly the original Int domain.
+  rule applyCmp(">", V:Val, I:Int)
+    => projectIntTotal(V) >Int I
+    requires isInt(V)
+    [simplification]
+
+  rule applyCmp(">=", V:Val, I:Int)
+    => projectIntTotal(V) >=Int I
+    requires isInt(V)
+    [simplification]
+
+  rule applyCmp("<", I:Int, V:Val)
+    => I <Int projectIntTotal(V)
+    requires isInt(V)
+    [simplification]
+
+  rule applyBin("%", V:Val, I:Int)
+    => pyMod(projectIntTotal(V), I)
+    requires isInt(V)
+    [simplification]
+
+  rule applyBin("+", V:Val, I:Int)
+    => projectIntTotal(V) +Int I
+    requires isInt(V)
+    [simplification]
+
+  // No divisor in [D, N) divides N.  D < 2 is an unused totalization case.
+  syntax Bool ::= primeTail(Int, Int) [function, total]
+  rule primeTail(_N:Int, D:Int) => false
+    requires D <Int 2
+  rule primeTail(N:Int, D:Int) => true
+    requires D >=Int 2 andBool D >=Int N
+  rule primeTail(N:Int, D:Int)
+    => notBool (pyMod(N, D) ==Int 0)
+       andBool primeTail(N, D +Int 1)
+    requires D >=Int 2 andBool D <Int N
+    [concrete, simplification]
+
+  // The recursive equation is oriented toward the summary during symbolic
+  // proof, so a symbolic divisor does not trigger unbounded evaluator
+  // unfolding.  These are the two disjoint step cases of that equation.
+  rule primeTail(N:Int, D:Int) => false
+    requires D >=Int 2
+      andBool D <Int N
+      andBool pyMod(N, D) ==Int 0
+    [simplification]
+  rule primeTail(N:Int, D:Int) => primeTail(N, D -Int 1)
+    requires D >Int 2
+      andBool D <=Int N
+      andBool pyMod(N, D -Int 1) =/=Int 0
+    [symbolic(N, D), simplification]
+
+  syntax Bool ::= isPrime(Int) [function, total]
+  rule isPrime(N:Int)
+    => N >=Int 2 andBool primeTail(N, 2)
+
+  // One scan step: retain M unless X is both larger and prime.
+  syntax Int ::= selectPrime(Int, Int) [function, total]
+  rule selectPrime(M:Int, X:Int) => X
+    requires X >Int M andBool isPrime(X)
+  rule selectPrime(M:Int, X:Int) => M
+    requires notBool (X >Int M andBool isPrime(X))
+
+  // Fold selectPrime across the complete symbolic input list.
+  syntax Int ::= largestPrime(ValSeq, Int) [function, total]
+  rule largestPrime(.ValSeq, M:Int) => M
+  rule largestPrime(vCons(V:Val, R:ValSeq), M:Int)
+    => largestPrime(R, selectPrime(M, projectIntTotal(V)))
+    requires isInt(V)
+  rule largestPrime(vCons(V:Val, R:ValSeq), M:Int)
+    => largestPrime(R, M)
+    requires notBool isInt(V)
+
+  // Decimal digit sum for the nonnegative accumulator produced by the scan.
+  syntax Int ::= digitSum(Int) [function, total]
+  rule digitSum(N:Int) => 0
+    requires N <=Int 0
+  rule digitSum(N:Int)
+    => pyMod(N, 10)
+       +Int digitSum((N -Int pyMod(N, 10)) /Int 10)
+    requires N >Int 0
+    [concrete, simplification]
+  rule pyMod(N:Int, 10)
+       +Int digitSum((N -Int pyMod(N, 10)) /Int 10)
+    => digitSum(N)
+    requires N >Int 0
+    [symbolic(N), simplification]
+  rule ((N %Int 10 +Int 10) %Int 10)
+       +Int digitSum(
+         (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10)
+    => digitSum(N)
+    requires N >Int 0
+    [symbolic(N), simplification]
+  rule T:Int
+       +Int ((N %Int 10 +Int 10) %Int 10)
+       +Int digitSum(
+         (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10)
+    => T +Int digitSum(N)
+    requires N >Int 0
+    [symbolic(N), simplification]
+endmodule

diff --git a/concrete-smoke.py b/concrete-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..01b5ea1c66e44f9560c61da3f2ebbf6ef9bffe20
--- /dev/null
+++ b/concrete-smoke.py
@@ -0,0 +1,32 @@
+def skjkasdkd(lst):
+    largest = 0
+    value = 0
+    candidate = False
+    divisor = 2
+    for value in lst:
+        if value > largest:
+            candidate = value >= 2
+            divisor = 2
+            while divisor < value:
+                if value % divisor == 0:
+                    candidate = False
+                divisor += 1
+            if candidate:
+                largest = value + 0
+    total = 0
+    while largest > 0:
+        total += largest % 10
+        largest //= 10
+    return total
+
+
+assert skjkasdkd(
+    [0, 3, 2, 1, 3, 5, 7, 4, 5, 5, 5, 2, 181, 32, 4, 32, 3, 2, 32, 324, 4, 3]
+) == 10
+assert skjkasdkd([1, 0, 1, 8, 2, 4597, 2, 1, 3, 40, 1, 2, 1, 2, 4, 2, 5, 1]) == 25
+assert skjkasdkd([1, 3, 1, 32, 5107, 34, 83278, 109, 163, 23, 2323, 32, 30, 1, 9, 3]) == 13
+assert skjkasdkd([0, 724, 32, 71, 99, 32, 6, 0, 5, 91, 83, 0, 5, 6]) == 11
+assert skjkasdkd([0, 81, 12, 3, 1, 21]) == 3
+assert skjkasdkd([0, 8, 1, 2, 1, 7]) == 7
+assert skjkasdkd([]) == 0
+assert skjkasdkd([-7, -3, 0, 1, 4]) == 0
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..538c4e42c7d1efc9b7ad706cd0575d72d979eed9
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,51 @@
+import itertools
+import random
+
+from solution import skjkasdkd
+
+
+def oracle(values):
+    primes = [
+        value
+        for value in values
+        if value >= 2
+        and all(value % divisor for divisor in range(2, value))
+    ]
+    largest = max(primes, default=0)
+    return sum(int(character) for character in str(largest))
+
+
+def main():
+    tested = 0
+    mismatches = []
+
+    alphabet = range(-2, 13)
+    for length in range(5):
+        for values in itertools.product(alphabet, repeat=length):
+            expected = oracle(values)
+            actual = skjkasdkd(list(values))
+            tested += 1
+            if actual != expected:
+                mismatches.append((values, expected, actual))
+
+    generator = random.Random(20260730)
+    for _ in range(500):
+        values = [
+            generator.randint(-100, 6000)
+            for _ in range(generator.randint(0, 12))
+        ]
+        expected = oracle(values)
+        actual = skjkasdkd(values)
+        tested += 1
+        if actual != expected:
+            mismatches.append((values, expected, actual))
+
+    print(f"tested={tested}")
+    print(f"mismatches={len(mismatches)}")
+    if mismatches:
+        print(f"first_mismatch={mismatches[0]}")
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e55a2dd5f2bbf411e1f11eeb8950891e92cda440
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-smoke.py > concrete-smoke.mpy
+python3 concrete-smoke.py
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-smoke.mpy \
+  --definition runtime-kompiled \
+  | tee concrete-smoke.out
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  2>&1 | tee proof-main.out
+
+kprove spec-summary.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-SUMMARY \
+  2>&1 | tee proof-summary.out
+
+if kprove spec-vacuity.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-VACUITY \
+     > proof-vacuity.out 2>&1; then
+  echo "UNEXPECTED SUCCESS: false-postcondition probe"
+  exit 1
+else
+  status=$?
+  echo "EXPECTED FAILURE: false-postcondition probe (exit $status)"
+fi
+
+if kprove spec-body-mutation.k \
+     --definition verification-kompiled \
+     --spec-module SPEC-BODY-MUTATION \
+     > proof-body-mutation.out 2>&1; then
+  echo "UNEXPECTED SUCCESS: body-mutation probe"
+  exit 1
+else
+  status=$?
+  echo "EXPECTED FAILURE: body-mutation probe (exit $status)"
+fi
+
+python3 differential_test.py | tee differential-test.out
