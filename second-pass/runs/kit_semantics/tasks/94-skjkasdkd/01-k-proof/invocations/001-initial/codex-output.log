+    for value in lst:
+        if value > largest:
+            candidate = value >= 2
+            divisor = 2
+            while divisor < value:
+                if value % divisor == 0:
+                    candidate = False
+                divisor += 1
+            if candidate:
+                largest = value
+    total = 0
