diff --git a/concrete-smoke.py b/concrete-smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..8316ee1a2b462c8215e4d48b30f2211b88f9f1e6
--- /dev/null
+++ b/concrete-smoke.py
@@ -0,0 +1,37 @@
+def _is_prime(n):
+    candidate = n >= 2
+    divisor = 2
+    while divisor < n:
+        if n % divisor == 0:
+            candidate = False
+        divisor += 1
+    return candidate
+
+
+def _digit_sum(n):
+    total = 0
+    while n > 0:
+        total += n % 10
+        n //= 10
+    return total
+
+
+def skjkasdkd(lst):
+    largest = 0
+    for value in lst:
+        if value > largest:
+            if _is_prime(value):
+                largest = value
+    return _digit_sum(largest)
+
+
+assert skjkasdkd(
+    [0, 3, 2, 1, 3, 5, 7, 4, 5, 5, 5, 2, 181, 32, 4, 32, 3, 2, 32, 324, 4, 3]
+) == 10
+assert skjkasdkd([1, 0, 1, 8, 2, 4597, 2, 1, 3, 40, 1, 2, 1, 2, 4, 2, 5, 1]) == 25
+assert skjkasdkd([1, 3, 1, 32, 5107, 34, 83278, 109, 163, 23, 2323, 32, 30, 1, 9, 3]) == 13
+assert skjkasdkd([0, 724, 32, 71, 99, 32, 6, 0, 5, 91, 83, 0, 5, 6]) == 11
+assert skjkasdkd([0, 81, 12, 3, 1, 21]) == 3
+assert skjkasdkd([0, 8, 1, 2, 1, 7]) == 7
+assert skjkasdkd([]) == 0
+assert skjkasdkd([-7, -3, 0, 1, 4]) == 0
