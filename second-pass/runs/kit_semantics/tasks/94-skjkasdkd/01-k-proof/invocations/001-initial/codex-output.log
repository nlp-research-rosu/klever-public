+def skjkasdkd(lst):
+    largest = 0
+    value = 0
+    candidate = False
+    divisor = 2
+    for value in lst:
+        if value > largest:
+            candidate = value >= 2
+            divisor = 2
+            while divisor < value:
+                if value % divisor == 0:
+                    candidate = False
+                divisor += 1
