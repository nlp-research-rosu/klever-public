+    divisor = 2
+    for value in lst:
+        if value > largest:
+            candidate = value >= 2
+            divisor = 2
+            while divisor < value:
+                if value % divisor == 0:
+                    candidate = False
+                divisor += 1
+            if candidate:
+                largest = value + 0
+    total = 0
+    while largest > 0:
+        total += largest % 10
+        largest //= 10
+    return total
