+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ( "lst"       |-> list(ALL:ValSeq)
+          "largest"   |-> (N:Int => 0)
+          "value"     |-> V:Val
+          "candidate" |-> C:Bool
+          "divisor"   |-> D:Int
+          "total"     |-> (T:Int => T +Int digitSum(N)) ),
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0
+
+  // Required target theorem: load the exact translated definition, invoke its
