+def _is_prime(n):
+    candidate = n >= 2
+    divisor = 2
+    while divisor < n:
+        if n % divisor == 0:
+            candidate = False
+        divisor += 1
+    return candidate
+
+
+def _digit_sum(n):
+    total = 0
+    while n > 0:
+        total += n % 10
+        n //= 10
+    return total
+
+
+def skjkasdkd(lst):
+    largest = 0
+    for value in lst:
+        if value > largest:
+            if _is_prime(value):
+                largest = value
+    return _digit_sum(largest)

