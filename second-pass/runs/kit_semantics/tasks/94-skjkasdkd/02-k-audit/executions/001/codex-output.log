/bin/bash -lc "/audit-output/evidence/run_logged.sh /audit-output/evidence/static/program-term-comparison.log /audit-output/evidence/static/compare_program_term.py && /audit-output/evidence/run_logged.sh /audit-output/evidence/reconstruction/kprove-summary.log bash -lc 'export PATH=\""'$HOME/.nix-profile/bin:$PATH"; kprove spec-summary.k --definition auditor-verification-kompiled --spec-module SPEC-SUMMARY'"'" in /tmp/audit-work/work
