     7	def skjkasdkd(lst):
     8	    """You are given a list of integers.
     9	    You need to find the largest prime value and return the sum of its digits.
    10	
    11	    Examples:
    12	    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10
    13	    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25
    14	    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13
    15	    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11
    16	    For lst = [0,81,12,3,1,21] the output should be 3
    17	    For lst = [0,8,1,2,1,7] the output should be 7
    18	    """
    19	    def isPrime(n):
    20	        for i in range(2,int(n**0.5)+1):
    21	            if n%i==0:
    22	                return False
    23	
    24	        return True
    25	    maxx = 0
    26	    i = 0
    27	    while i < len(lst):
    28	        if(lst[i] > maxx and isPrime(lst[i])):
    29	            maxx = lst[i]
    30	        i+=1
    31	    result = sum(int(digit) for digit in str(maxx))
    32	    return result
    33	
FILE:/candidate/solution.py
     1	def skjkasdkd(lst):
     2	    largest = 0
     3	    value = 0
     4	    candidate = False
     5	    divisor = 2
     6	    for value in lst:
     7	        if value > largest:
     8	            candidate = value >= 2
     9	            divisor = 2
    10	            while divisor < value:
    11	                if value % divisor == 0:
    12	                    candidate = False
    13	                divisor += 1
    14	            if candidate:
    15	                largest = value + 0
    16	    total = 0
    17	    while largest > 0:
    18	        total += largest % 10
    19	        largest //= 10
    20	    return total
