      "normalized_sha256": "92241e2e54ad3adfe5140246eafc88d12ee532fcfc8c8c2e0d517f63bee4e6d7",
      "rationale": "This simplification rule adds a guarded equality for the pre-existing applyBin operation at the dynamic Val sort; it is not a definition of a fresh symbol, and prove.sh does not establish the exact equality before compiling it.",
      "source_rule_id": "rule-92241e2e54ad3adfe5140246eafc88d12ee532fcfc8c8c2e0d517f63bee4e6d7",
      "start_line": 67,
      "text": "  rule applyBin(\"+\", A:Float, V:Val)\n    => addF(A, projectFloat(V))\n    requires isFloat(V)\n    [simplification]"
    },
