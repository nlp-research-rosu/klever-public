+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [sum-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        Assign(Name("total"),
+               BinOp("+", Name("total"), Name("number"))) .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "mean_absolute_deviation"
+              |-> closureVal(("numbers", .ParamNames), madBody, 0),
+              parent(-1))
+       1 |-> scope(
+              "count"   |-> COUNT:Int
+              "number"  |-> (_OLD:Val => ?FINAL:Val)
+              "numbers" |-> list(ALL:ValSeq)
+              "total"   |-> (ACC:Float => sumFloatVS(VS, ACC)),
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloatVS(VS)
+
+  claim [deviation-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        Assign(
+          Name("deviation"),
+          BinOp(
+            "+",
+            Name("deviation"),
+            Call(Name("abs"),
+                 BinOp("-", Name("number"), Name("mean"))))) .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "mean_absolute_deviation"
+              |-> closureVal(("numbers", .ParamNames), madBody, 0),
+              parent(-1))
+       1 |-> scope(
+              "count"     |-> COUNT:Int
+              "deviation" |-> (ACC:Float
+                                => deviationFloatVS(VS, MEAN, ACC))
+              "mean"      |-> MEAN:Float
+              "number"    |-> (_OLD:Val => ?FINAL:Val)
+              "numbers"   |-> list(ALL:ValSeq)
+              "total"     |-> TOTAL:Float,
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloatVS(VS)
+
+  claim [mean-absolute-deviation]:
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef(
+            "mean_absolute_deviation",
+            Params("numbers"),
+            madBody)))
+      ~> Call(Name("mean_absolute_deviation"), (list(VS:ValSeq), .Exprs))
+      => madResult(VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              .Map
+              => "mean_absolute_deviation"
+                 |-> closureVal(("numbers", .ParamNames), madBody, 0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloatVS(VS)
+endmodule
diff --git a/test_solution.py b/test_solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..01d07aa963dc0d7c727fcb3f9c2b7f100737ad8e
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,37 @@
+import math
+import random
+
+from solution import mean_absolute_deviation
+
+
+def oracle(numbers):
+    if not numbers:
+        return 0.0
+    center = math.fsum(numbers) / len(numbers)
+    return math.fsum(abs(number - center) for number in numbers) / len(numbers)
+
+
+cases = [
+    [],
+    [1.0],
+    [1.0, 2.0, 3.0, 4.0],
+    [-1.0, 1.0],
+    [-3.5, -0.5, 10.0],
+    [1.0e-100, -1.0e-100, 3.0e-100],
+    [1.0e100, 1.0e100, 1.0e100],
+]
+
+rng = random.Random(20260729)
+for size in range(13):
+    for _ in range(20):
+        cases.append([rng.uniform(-1.0e6, 1.0e6) for _ in range(size)])
+
+mismatches = []
+for numbers in cases:
+    actual = mean_absolute_deviation(numbers)
+    expected = oracle(numbers)
+    if not math.isclose(actual, expected, rel_tol=1.0e-12, abs_tol=1.0e-12):
+        mismatches.append((numbers, actual, expected))
+
+assert not mismatches, mismatches[:3]
+print(f"differential-cases={len(cases)} mismatches={len(mismatches)}")
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..eab181bc5f8add26ac4dea91986cd4973819a6b5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,100 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports MPY-SYNTAX
+  imports MPY-CORE
+  imports FLOAT
+
+  syntax Bool ::= allFloatVS(ValSeq) [function, total]
+  syntax Float ::= projectFloat(Val)
+      [function, total, symbol(projectFloat), no-evaluators]
+  syntax Float ::= sumFloatVS(ValSeq, Float) [function, total]
+  syntax Float ::= deviationFloatVS(ValSeq, Float, Float)
+      [function, total]
+  syntax Float ::= madResult(ValSeq) [function, total]
+
+  syntax Stmts ::= "madBody" [macro]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+  imports BOOL
+  imports K-EQUAL
+
+  // The exact translated body of solution.py.
+  rule madBody
+    => Assign(Name("count"), Call(Name("len"), Name("numbers")))
+       If(Compare(Name("count"), CmpOp("==", Int(0))),
+          Return(Float(0.0)),
+          .Stmts)
+       Assign(Name("total"), Float(0.0))
+       Assign(Name("number"), Float(0.0))
+       For(Name("number"), Name("numbers"),
+           Assign(Name("total"),
+                  BinOp("+", Name("total"), Name("number"))))
+       Assign(Name("mean"), BinOp("/", Name("total"), Name("count")))
+       Assign(Name("deviation"), Float(0.0))
+       For(Name("number"), Name("numbers"),
+           Assign(Name("deviation"),
+                  BinOp("+",
+                        Name("deviation"),
+                        Call(Name("abs"),
+                             BinOp("-", Name("number"), Name("mean"))))))
+       Return(BinOp("/", Name("deviation"), Name("count")))
+
+  // A recursive domain predicate for arbitrary finite lists of floats.
+  rule allFloatVS(.ValSeq) => true
+  rule allFloatVS(vCons(V:Val, R:ValSeq))
+    => isFloat(V) andBool allFloatVS(R)
+
+  // Total only to give the backend a static Float term.  On the theorem
+  // domain every use is guarded by allFloatVS/isFloat, and the collapse rule
+  // makes it the identity for an actual Float.
+  rule #Ceil({@V:Val}:>Float)
+    => ({ isFloat(@V) #Equals true } #And #Ceil(@V))
+    [simplification]
+  rule projectFloat(V:Val) => {V}:>Float
+    requires isFloat(V)
+    [concrete, simplification(10), preserves-definedness]
+  rule {V:Val}:>Float => projectFloat(V)
+    requires isFloat(V)
+    [symbolic(V), simplification, preserves-definedness]
+  rule projectFloat(F:Float) => F [simplification]
+
+  // Guarded dispatch twins of MPY-FLOAT's typed rules.  They do not replace
+  // a computation; they restate the same equations after the domain guard.
+  rule applyBin("+", A:Float, V:Val)
+    => addF(A, projectFloat(V))
+    requires isFloat(V)
+    [simplification]
+  rule applyBin("-", V:Val, M:Float)
+    => subF(projectFloat(V), M)
+    requires isFloat(V)
+    [simplification]
+
+  // Exact left folds used by the two loop circularities.
+  rule sumFloatVS(.ValSeq, A:Float) => A
+  rule sumFloatVS(vCons(V:Val, R:ValSeq), A:Float)
+    => sumFloatVS(R, addF(A, projectFloat(V)))
+
+  rule deviationFloatVS(.ValSeq, _:Float, A:Float) => A
+  rule deviationFloatVS(vCons(V:Val, R:ValSeq), M:Float, A:Float)
+    => deviationFloatVS(
+         R,
+         M,
+         addF(A, absF(subF(projectFloat(V), M))))
+
+  rule madResult(VS:ValSeq) => 0.0
+    requires vsLen(VS) ==Int 0
+  rule madResult(VS:ValSeq)
+    => divFloatIntV(
+         deviationFloatVS(
+           VS,
+           divFloatIntV(
+             sumFloatVS(VS, 0.0),
+             vsLen(VS)),
+           0.0),
+         vsLen(VS))
+    requires vsLen(VS) =/=Int 0
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..53a24b9de9da8c68374641ba0469efd628d3b19d
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+export PATH="$HOME/.nix-profile/bin:$PATH"
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled \
+  2>&1 | tee llvm-build.out
+
+krun smoke.mpy --definition runtime-kompiled \
+  2>&1 | tee krun-smoke.out
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  2>&1 | tee haskell-build.out
+
+# This is the required positive target-proof command.  Keeping all claims in
+# the command makes the two loop circularities available to the entry claim.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  2>&1 | tee kprove-positive.out
+
+set +e
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY \
+  2>&1 | tee vacuity.out
+vacuity_status=${PIPESTATUS[0]}
+
+kprove spec-body-mutation.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-BODY-MUTATION \
+  2>&1 | tee body-mutation.out
+body_mutation_status=${PIPESTATUS[0]}
+set -e
+
+if [[ $vacuity_status -eq 0 ]]; then
+  echo "ERROR: false-result mutation unexpectedly proved" >&2
+  exit 1
+fi
+echo "EXPECTED FAILURE: false-result mutation exited $vacuity_status"
+
+if [[ $body_mutation_status -eq 0 ]]; then
+  echo "ERROR: body mutation unexpectedly proved" >&2
+  exit 1
+fi
+echo "EXPECTED FAILURE: body mutation exited $body_mutation_status"
+
+python3 test_solution.py 2>&1 | tee differential.out
