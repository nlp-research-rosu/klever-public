/bin/bash -lc "sed -n '1,260p' reference-semantics/semantics/functions.k && sed -n '1,260p' reference-semantics/semantics/call.k && sed -n '1,190p' reference-semantics/semantics/controls.k" in /workspace
exec
/bin/bash -lc "sed -n '1,220p' reference-semantics/semantics/operators.k && sed -n '1,200p' reference-semantics/semantics/int.k && sed -n '1,220p' reference-semantics/semantics/concrete.k" in /workspace
