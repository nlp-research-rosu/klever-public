+++ b/solution.py
@@ -0,0 +1,19 @@
+from typing import List
+
+
+def mean_absolute_deviation(numbers: List[float]) -> float:
+    count = len(numbers)
+    if count == 0:
+        return 0.0
+
+    total = 0.0
+    number = 0.0
+    for number in numbers:
+        total = total + number
+
+    mean = total / count
+    deviation = 0.0
+    for number in numbers:
+        deviation = deviation + abs(number - mean)
+
+    return deviation / count
diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..c34079330124898c9f2e8c9b162d85d54a1dde77
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Deliberately mutate the empty-list return from 0.0 to 1.0 while retaining
+  // the original expected result.  The connection must no longer close.
