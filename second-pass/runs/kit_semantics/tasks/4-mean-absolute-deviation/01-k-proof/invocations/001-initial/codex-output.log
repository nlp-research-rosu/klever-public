+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloatVS(VS)
+
+  claim [deviation-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        Assign(
+          Name("deviation"),
+          BinOp(
+            "+",
+            Name("deviation"),
+            Call(Name("abs"),
+                 BinOp("-", Name("number"), Name("mean"))))) .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              "mean_absolute_deviation"
+              |-> closureVal(("numbers", .ParamNames), madBody, 0),
+              parent(-1))
+       1 |-> scope(
+              "count"     |-> COUNT:Int
+              "deviation" |-> (ACC:Float
+                                => deviationFloatVS(VS, MEAN, ACC))
+              "mean"      |-> MEAN:Float
+              "number"    |-> (_OLD:Val => ?FINAL:Val)
+              "numbers"   |-> list(ALL:ValSeq)
+              "total"     |-> TOTAL:Float,
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
