+                             Name("deviation"),
+                             Call(
+                               Name("abs"),
+                               BinOp(
+                                 "-",
+                                 Name("number"),
+                                 Name("mean"))))))
+                       Return(
+                         BinOp(
+                           "/",
+                           Name("deviation"),
+                           Name("count"))),
+                       0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
