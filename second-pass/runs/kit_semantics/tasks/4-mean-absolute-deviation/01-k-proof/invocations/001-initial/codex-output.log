+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(MODULE:Map, parent(-1))
+       1 |-> scope(
+              "count"   |-> COUNT:Int
+              "number"  |-> (OLD:Float => lastFloatVS(VS, OLD))
+              "numbers" |-> list(ALL:ValSeq)
+              "total"   |-> (ACC:Float => sumFloatVS(VS, ACC)),
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloatVS(VS)
+
+  claim [deviation-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        Assign(
+          Name("deviation"),
+          BinOp(
+            "+",
+            Name("deviation"),
+            Call(Name("abs"),
+                 BinOp("-", Name("number"), Name("mean"))))) .Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(MODULE:Map, parent(-1))
+       1 |-> scope(
+              "count"     |-> COUNT:Int
+              "deviation" |-> (ACC:Float
+                                => deviationFloatVS(VS, MEAN, ACC))
+              "mean"      |-> MEAN:Float
+              "number"    |-> (OLD:Float => lastFloatVS(VS, OLD))
+              "numbers"   |-> list(ALL:ValSeq)
+              "total"     |-> TOTAL:Float,
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloatVS(VS)
+
+  claim [mean-absolute-deviation]:
+    <k>
+      FuncDef(
+        "mean_absolute_deviation",
+        Params("numbers"),
+        madBody)
+      ~> Call(Name("mean_absolute_deviation"), (list(VS:ValSeq), .Exprs))
+      => madResult(VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+       0 |-> scope(
+              .Map
+              => "mean_absolute_deviation"
