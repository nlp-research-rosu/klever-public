+                                => deviationFloatVS(VS, MEAN, ACC))
+              "mean"      |-> MEAN:Float
+              "number"    |-> (OLD:Float => lastFloatVS(VS, OLD))
+              "numbers"   |-> list(ALL:ValSeq)
+              "total"     |-> TOTAL:Float,
+              parent(0))
+    </scopes>
