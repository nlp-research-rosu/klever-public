+              parent(-1))
+       1 |-> scope(
+              "count"     |-> COUNT:Int
+              "deviation" |-> (ACC:Float
+                                => deviationFloatVS(VS, MEAN, ACC))
+              "mean"      |-> MEAN:Float
+              "number"    |-> (_OLD:Val => ?FINAL:Val)
+              "numbers"   |-> list(ALL:ValSeq)
+              "total"     |-> TOTAL:Float,
+              parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
