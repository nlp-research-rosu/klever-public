/reference/k-proof/reference-semantics/semantics/core.k-2-
/reference/k-proof/reference-semantics/semantics/core.k-3-module MPY-CORE
/reference/k-proof/reference-semantics/semantics/core.k-4-  imports MPY-SYNTAX
/reference/k-proof/reference-semantics/semantics/core.k-5-  imports INT
/reference/k-proof/reference-semantics/semantics/core.k-6-  imports BOOL
/reference/k-proof/reference-semantics/semantics/core.k-7-  imports STRING
/reference/k-proof/reference-semantics/semantics/core.k-8-  imports MAP
/reference/k-proof/reference-semantics/semantics/core.k-9-  imports LIST
