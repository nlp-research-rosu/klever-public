+
+Selected generated Lean output
+------------------------------
+
+$ sed -n '318,337p' /reference/klean-generation/generated/Klean4MeanAbsoluteDeviation/Sorts.lean
+  inductive SortVal : Type where
+    | inj_SortBool (x : SortBool) : SortVal
+    | inj_SortFloat (x : SortFloat) : SortVal
