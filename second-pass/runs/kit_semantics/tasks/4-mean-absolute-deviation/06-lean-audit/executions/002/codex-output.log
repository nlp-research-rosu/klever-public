/reference/k-proof/reference-semantics/semantics/dict.k-89-  // negative-index normalization local to the write (subscript.k's is not imported here)
/reference/k-proof/reference-semantics/semantics/dict.k-90-  syntax Int ::= normIdxD(Int, Int) [function, total]
/reference/k-proof/reference-semantics/semantics/dict.k-91-  rule normIdxD(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
/reference/k-proof/reference-semantics/semantics/dict.k-92-  rule normIdxD(I:Int, _:Int)   => I          requires I >=Int 0
/reference/k-proof/reference-semantics/semantics/dict.k-93-
/reference/k-proof/reference-semantics/semantics/dict.k-94-  // ==== dict == (order-insensitive: same size + same key->value pairs) =======
/reference/k-proof/reference-semantics/semantics/dict.k-95-  rule applyCmp("==", dictV(KS1:ValSeq, VS1:ValSeq), dictV(KS2:ValSeq, VS2:ValSeq))
/reference/k-proof/reference-semantics/semantics/dict.k-96-    => (vsLen(KS1) ==Int vsLen(KS2)) andBool dSubset(KS1, VS1, KS2, VS2)
/reference/k-proof/reference-semantics/semantics/dict.k-97-  syntax Bool ::= dSubset(ValSeq, ValSeq, ValSeq, ValSeq) [function]
/reference/k-proof/reference-semantics/semantics/dict.k-98-  rule dSubset(.ValSeq, .ValSeq, _:ValSeq, _:ValSeq) => true
/reference/k-proof/reference-semantics/semantics/dict.k-99-  rule dSubset(vCons(K:Val, KR:ValSeq), vCons(V:Val, VR:ValSeq), KS2:ValSeq, VS2:ValSeq)
/reference/k-proof/reference-semantics/semantics/dict.k-100-    => dHasKey(KS2, K) andBool (dGet(KS2, VS2, K) ==K V) andBool dSubset(KR, VR, KS2, VS2)
/reference/k-proof/reference-semantics/semantics/dict.k:101:  syntax Val ::= dGet(ValSeq, ValSeq, Val) [function]
/reference/k-proof/reference-semantics/semantics/dict.k-102-  rule dGet(vCons(A:Val, _:ValSeq), vCons(B:Val, _:ValSeq), K:Val) => B                requires A ==K K
/reference/k-proof/reference-semantics/semantics/dict.k-103-  rule dGet(vCons(A:Val, KR:ValSeq), vCons(_:Val, VR:ValSeq), K:Val) => dGet(KR, VR, K) requires notBool (A ==K K)
/reference/k-proof/reference-semantics/semantics/dict.k-104-endmodule
