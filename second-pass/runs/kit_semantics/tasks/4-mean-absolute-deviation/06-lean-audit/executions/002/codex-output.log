/reference/k-proof/reference-semantics/semantics/subscript.k-66-  rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
/reference/k-proof/reference-semantics/semantics/subscript.k-67-    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
/reference/k-proof/reference-semantics/semantics/subscript.k-68-  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
/reference/k-proof/reference-semantics/semantics/subscript.k-69-    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))
/reference/k-proof/reference-semantics/semantics/subscript.k-70-
/reference/k-proof/reference-semantics/semantics/subscript.k-71-  // ==== slice.indices: step / start / stop / clamp ==========================
/reference/k-proof/reference-semantics/semantics/subscript.k-72-  syntax Int ::= slStep(OptInt) [function, total]
/reference/k-proof/reference-semantics/semantics/subscript.k-73-  rule slStep(noB)          => 1
/reference/k-proof/reference-semantics/semantics/subscript.k-74-  rule slStep(someB(S:Int)) => S
/reference/k-proof/reference-semantics/semantics/subscript.k-75-
