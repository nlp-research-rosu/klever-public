+$ nl -ba /reference/klean-generation/generated/Klean4MeanAbsoluteDeviation/Lemmas.lean | sed -n '17,19p'
+    17      (∀ (V : SortVal), ((«project:Float?» (SortK.kseq ((@inj SortVal SortKItem) V) SortK.dotk)).isSome = true) ↔ (((isFloat (SortK.kseq ((@inj SortVal SortKItem) V) SortK.dotk) : SortBool) = (true : SortBool)) ∧ (True)))
