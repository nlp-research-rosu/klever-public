+    LblclosureValC'LParUndsCommUndsCommUndsCommUndsRParUnds'MPY-FUNCTIONS'Unds'Val'Unds'ParamNames'Unds'ParamNames'Unds'Stmts'Unds'Map
+    LbldictV'LParUndsCommUndsRParUnds'MPY-DICT'Unds'Val'Unds'ValSeq'Unds'ValSeq
+    LblkwV'LParUndsCommUndsRParUnds'MPY-CORE'Unds'Val'Unds'String'Unds'Val
+    Lblmd5Obj'LParUndsRParUnds'MPY-BUILTINS'Unds'Val'Unds'IntSeq
+    LblnoneV'Unds'MPY-CORE'Unds'Val
+    Lblref'LParUndsRParUnds'MPY-CORE'Unds'Val'Unds'Int
+    LblsetV'LParUndsRParUnds'MPY-SET'Unds'Val'Unds'IntSeq
+    LbltypeV'LParUndsRParUnds'MPY-CORE'Unds'Val'Unds'String
+  subsorts: ['SortBool', 'SortFloat', 'SortInt', 'SortIterable', 'SortStr']
+SortIterable
+  constructors:
+    Lbllist'LParUndsRParUnds'MPY-CORE'Unds'Iterable'Unds'ValSeq
+    LblrangeObj'LParUndsCommUndsCommUndsRParUnds'MPY-CORE'Unds'Iterable'Unds'Int'Unds'Int'Unds'Int
+    Lbltuple'LParUndsRParUnds'MPY-CORE'Unds'Iterable'Unds'ValSeq
+    LblzipObj'LParUndsCommUndsRParUnds'MPY-CORE'Unds'Iterable'Unds'ValSeq'Unds'ValSeq
+    LblzipObjS'LParUndsCommUndsRParUnds'MPY-CORE'Unds'Iterable'Unds'IntSeq'Unds'IntSeq
+  subsorts: ['SortStr']
+SortStr
