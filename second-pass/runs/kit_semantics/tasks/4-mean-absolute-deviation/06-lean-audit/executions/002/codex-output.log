+Stage 4 carrier-projection audit
+================================
+
+Frozen K source command
+-----------------------
+
+$ nl -ba /reference/k-proof/reference-semantics/semantics/core.k | sed -n '12,35p'
+    12  // ==== values, the algebraic lists, and the scope heap =====================
+    13  syntax IntSeq ::= ".IntSeq" | iCons(Int, IntSeq)
+    14  syntax ValSeq ::= ".ValSeq" | vCons(Val, ValSeq)
+    15  syntax Str    ::= str(IntSeq)
+    16
+    17  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)
+    18  syntax Iterable ::= list(ValSeq)
+    19                    | tuple(ValSeq)
+    20                    | Str
+    21                    | rangeObj(Int, Int, Int)
+    22                    | zipObj(ValSeq, ValSeq)
+    23                    | zipObjS(IntSeq, IntSeq)
+    24
+    25  syntax Val      ::= Int
+    26                    | Bool
+    27                    | "noneV"
+    28                    | Iterable
+    29                    | ref(Int)          // a heap object: <heap> holds its list(VS)
+    30                    | cellRef(Int)      // a closure cell: <heap> holds cellV(V)
+    31                    | closureVal(ParamNames, Stmts, Int)
+    32                    | typeV(String)     // a type object (int/str), resolved from the builtins frame
+    33                    | builtinV(String)  // a builtin function, resolved like any name (LEGB fallthrough)
+    34                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method
+
+The frozen semantics therefore contains the constructor/subsort path
+str(IntSeq) : Str < Iterable < Val.
+
+Frozen compiled-definition query
+--------------------------------
+
+$ PYTHONPATH=/reference python - <<'PY'
+from pathlib import Path
+from pyk.klean.__main__ import _load_defn
+d = _load_defn(Path('/reference/k-proof/verification-kompiled'))
+for sort in ('SortVal','SortIterable','SortStr'):
+    print(sort)
+    print('  constructors:', *d.constructors.get(sort, ()), sep='\n    ')
+    print('  subsorts:', sorted(d.subsorts.get(sort, ())))
+PY
+SortVal
+  constructors:
+    LblboundMethodV'LParUndsCommUndsRParUnds'MPY-CORE'Unds'Val'Unds'Val'Unds'String
+    LblbuiltinV'LParUndsRParUnds'MPY-CORE'Unds'Val'Unds'String
