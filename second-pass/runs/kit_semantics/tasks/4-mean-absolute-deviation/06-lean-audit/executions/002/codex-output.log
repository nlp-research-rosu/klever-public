/reference/k-proof/reference-semantics/semantics/dict.k-8-//
/reference/k-proof/reference-semantics/semantics/dict.k-9-// Only the pieces needed so far: a dict VALUE (so `{}` inside a mixed list evaluates and
/reference/k-proof/reference-semantics/semantics/dict.k-10-// `isinstance(x, int)` rejects it), the `{k: v, ...}` literal, and `.keys()`. More dict ops (subscript
/reference/k-proof/reference-semantics/semantics/dict.k-11-// / `.get()` / `.values()` / dict `==`) are added as dict problems need them — kept minimal + additive.
/reference/k-proof/reference-semantics/semantics/dict.k-12-
/reference/k-proof/reference-semantics/semantics/dict.k-13-module MPY-DICT
/reference/k-proof/reference-semantics/semantics/dict.k-14-  imports MPY-CORE
/reference/k-proof/reference-semantics/semantics/dict.k-15-  imports MPY-ITER
/reference/k-proof/reference-semantics/semantics/dict.k-16-  imports MPY-METHODS
/reference/k-proof/reference-semantics/semantics/dict.k-17-  imports MPY-LIST
/reference/k-proof/reference-semantics/semantics/dict.k-18-
/reference/k-proof/reference-semantics/semantics/dict.k-19-  // dict as PARALLEL ordered key/value ValSeqs (same length; keys distinct).
/reference/k-proof/reference-semantics/semantics/dict.k:20:  syntax Val ::= dictV(ValSeq, ValSeq)
/reference/k-proof/reference-semantics/semantics/dict.k-21-
/reference/k-proof/reference-semantics/semantics/dict.k-22-  // ==== DictExpr: {k: v, ...} literal. Eval each key then value, left to right, insert-with-dedup.
/reference/k-proof/reference-semantics/semantics/dict.k-23-  syntax KItem ::= #dictAcc(Entries, ValSeq, ValSeq)
/reference/k-proof/reference-semantics/semantics/dict.k-24-                 | #dictKey(Expr, Entries, ValSeq, ValSeq)
/reference/k-proof/reference-semantics/semantics/dict.k-25-                 | #dictVal(Val, Entries, ValSeq, ValSeq)
/reference/k-proof/reference-semantics/semantics/dict.k-26-  rule <k> DictExpr(ES:Entries) => #dictAcc(ES, .ValSeq, .ValSeq) ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-27-  rule <k> #dictAcc(.Entries, KS:ValSeq, VS:ValSeq) => dictV(KS, VS) ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-28-  rule <k> #dictAcc((Entry(K:Expr, V:Expr), REST:Entries), KS:ValSeq, VS:ValSeq)
/reference/k-proof/reference-semantics/semantics/dict.k-29-        => K ~> #dictKey(V, REST, KS, VS) ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-30-  rule <k> KV:Val ~> #dictKey(V:Expr, REST:Entries, KS:ValSeq, VS:ValSeq)
/reference/k-proof/reference-semantics/semantics/dict.k-31-        => V ~> #dictVal(KV, REST, KS, VS) ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-32-  rule <k> VV:Val ~> #dictVal(KV:Val, REST:Entries, KS:ValSeq, VS:ValSeq)
/reference/k-proof/reference-semantics/semantics/dict.k-33-        => #dictAcc(REST, dPutK(KS, KV), dPutV(KS, VS, KV, VV)) ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-34-
/reference/k-proof/reference-semantics/semantics/dict.k-35-  // insert-with-dedup helpers (concrete Val key equality via ==K). [total] so buildFold over a dict is
/reference/k-proof/reference-semantics/semantics/dict.k-36-  // total (its #Ceil is #Top) — needed when a symbolic proof carries a built dict as a config value.
/reference/k-proof/reference-semantics/semantics/dict.k-37-  syntax Bool ::= dHasKey(ValSeq, Val) [function, total]
/reference/k-proof/reference-semantics/semantics/dict.k-38-  rule dHasKey(.ValSeq, _:Val)                => false
/reference/k-proof/reference-semantics/semantics/dict.k-39-  rule dHasKey(vCons(A:Val, _:ValSeq), K:Val) => true          requires A ==K K
/reference/k-proof/reference-semantics/semantics/dict.k-40-  rule dHasKey(vCons(A:Val, R:ValSeq), K:Val) => dHasKey(R, K) requires notBool (A ==K K)
/reference/k-proof/reference-semantics/semantics/dict.k-41-
/reference/k-proof/reference-semantics/semantics/dict.k-42-  // dPutK: KS unchanged if K already present, else append K (keep-first-position).
/reference/k-proof/reference-semantics/semantics/dict.k:43:  syntax ValSeq ::= dPutK(ValSeq, Val) [function, total]
/reference/k-proof/reference-semantics/semantics/dict.k-44-  rule dPutK(KS:ValSeq, K:Val) => KS                                  requires dHasKey(KS, K)
/reference/k-proof/reference-semantics/semantics/dict.k-45-  rule dPutK(KS:ValSeq, K:Val) => valSeqConcat(KS, vCons(K, .ValSeq)) requires notBool dHasKey(KS, K)
/reference/k-proof/reference-semantics/semantics/dict.k-46-
/reference/k-proof/reference-semantics/semantics/dict.k-47-  // dPutV: parallel to KS — set the value at K's position if present, else append V at the end. The
/reference/k-proof/reference-semantics/semantics/dict.k-48-  // [owise] catch-all covers the degenerate mismatched-length case (never reached for a well-formed dict).
/reference/k-proof/reference-semantics/semantics/dict.k:49:  syntax ValSeq ::= dPutV(ValSeq, ValSeq, Val, Val) [function, total]
/reference/k-proof/reference-semantics/semantics/dict.k-50-  rule dPutV(vCons(A:Val, _:ValSeq), vCons(_:Val, VR:ValSeq), K:Val, V:Val)  => vCons(V, VR)
/reference/k-proof/reference-semantics/semantics/dict.k-51-       requires A ==K K
/reference/k-proof/reference-semantics/semantics/dict.k-52-  rule dPutV(vCons(A:Val, KR:ValSeq), vCons(B:Val, VR:ValSeq), K:Val, V:Val) => vCons(B, dPutV(KR, VR, K, V))
/reference/k-proof/reference-semantics/semantics/dict.k-53-       requires notBool (A ==K K)
/reference/k-proof/reference-semantics/semantics/dict.k-54-  rule dPutV(_KS:ValSeq, VS:ValSeq, _K:Val, V:Val) => valSeqConcat(VS, vCons(V, .ValSeq)) [owise]
/reference/k-proof/reference-semantics/semantics/dict.k-55-
/reference/k-proof/reference-semantics/semantics/dict.k-56-  // ==== dict methods ========================================================
/reference/k-proof/reference-semantics/semantics/dict.k-57-  // d.keys() -> a FRESH list object of the ordered keys (k-cell: it allocates).
/reference/k-proof/reference-semantics/semantics/dict.k-58-  rule <k> #applyK(toCall(boundMethodV(dictV(KS:ValSeq, _:ValSeq), "keys")), .Vals)
/reference/k-proof/reference-semantics/semantics/dict.k-59-        => #alloc(list(KS)) ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-60-       [priority(40)]
/reference/k-proof/reference-semantics/semantics/dict.k-61-
/reference/k-proof/reference-semantics/semantics/dict.k-62-  // ==== dict subscript READ: d[k] (assoc lookup; KeyError is out of subset) ==
/reference/k-proof/reference-semantics/semantics/dict.k-63-  rule applyIndexD(dictV(KS:ValSeq, VS:ValSeq), K:Val) => dGet(KS, VS, K)
/reference/k-proof/reference-semantics/semantics/dict.k:64:  syntax Val ::= applyIndexD(Val, Val) [function]
/reference/k-proof/reference-semantics/semantics/dict.k-65-  rule <k> Subscript(dictV(KS:ValSeq, VS:ValSeq), K:Val) => applyIndexD(dictV(KS, VS), K) ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-66-       [priority(45)]
/reference/k-proof/reference-semantics/semantics/dict.k-67-
/reference/k-proof/reference-semantics/semantics/dict.k-68-  // ==== dict subscript-assign: d[k] = v (insert/update in place) =============
/reference/k-proof/reference-semantics/semantics/dict.k-69-  // Only for a LOCAL dict variable X (the current scope holds it). Reuses dPutK/dPutV.
/reference/k-proof/reference-semantics/semantics/dict.k:70:  syntax Val ::= dictSet(Val, Val, Val) [function]
/reference/k-proof/reference-semantics/semantics/dict.k-71-  rule dictSet(dictV(KS:ValSeq, VS:ValSeq), K:Val, V:Val) => dictV(dPutK(KS, K), dPutV(KS, VS, K, V))
/reference/k-proof/reference-semantics/semantics/dict.k-72-
/reference/k-proof/reference-semantics/semantics/dict.k-73-  // RHS evaluates first (Assign strictness), then the key. Dispatch on the scope
/reference/k-proof/reference-semantics/semantics/dict.k-74-  // value: a bare dict updates in the scope (dicts stay values); a ref (a heap
/reference/k-proof/reference-semantics/semantics/dict.k-75-  // list — or a heap dict later) writes the heap in place.
/reference/k-proof/reference-semantics/semantics/dict.k-76-  syntax KItem ::= #dsetK(String, Val)
/reference/k-proof/reference-semantics/semantics/dict.k-77-  rule <k> Assign(Subscript(Name(X:String), K:Expr), VV:Val) => K ~> #dsetK(X, VV) ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-78-  rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => .K ... </k>
/reference/k-proof/reference-semantics/semantics/dict.k-79-       <env> L:Int </env>
/reference/k-proof/reference-semantics/semantics/dict.k-80-       <scopes> ... L |-> scope(M:Map => M [ X <- dictSet({M[X]}:>Val, KV, VV) ], _) ... </scopes>
/reference/k-proof/reference-semantics/semantics/dict.k-81-       requires X in_keys(M) andBool notBool isRefV({M[X]}:>Val)
/reference/k-proof/reference-semantics/semantics/dict.k-82-  rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => #dsetV({M[X]}:>Val, KV, VV) ... </k>
