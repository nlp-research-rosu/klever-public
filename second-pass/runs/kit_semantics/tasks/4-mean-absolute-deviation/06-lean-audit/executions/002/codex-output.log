+    Lbltuple'LParUndsRParUnds'MPY-CORE'Unds'Iterable'Unds'ValSeq
+    LblzipObj'LParUndsCommUndsRParUnds'MPY-CORE'Unds'Iterable'Unds'ValSeq'Unds'ValSeq
