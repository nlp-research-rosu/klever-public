+      "-" (SortVal.inj_SortFloat 5.5) (SortVal.inj_SortFloat 2.25)
+  with
+  | SortVal.inj_SortFloat result => some result
+  | _ => none
+
+#eval match
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt 2) (SortVal.inj_SortInt 3)
+  with
