/reference/k-proof/reference-semantics/semantics/subscript.k-97-  rule clampLo(J:Int, _STEP:Int) => J
/reference/k-proof/reference-semantics/semantics/subscript.k-98-       requires J >=Int 0
/reference/k-proof/reference-semantics/semantics/subscript.k-99-  rule clampLo(J:Int, STEP:Int)  => #if STEP <Int 0 #then -1 #else 0 #fi
/reference/k-proof/reference-semantics/semantics/subscript.k-100-       requires J <Int 0
/reference/k-proof/reference-semantics/semantics/subscript.k-101-
/reference/k-proof/reference-semantics/semantics/subscript.k-102-  syntax Int ::= clampHi(Int, Int, Int) [function, total]
/reference/k-proof/reference-semantics/semantics/subscript.k-103-  rule clampHi(I:Int, LEN:Int, _STEP:Int) => I
/reference/k-proof/reference-semantics/semantics/subscript.k-104-       requires I  <Int LEN
/reference/k-proof/reference-semantics/semantics/subscript.k-105-  rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi
/reference/k-proof/reference-semantics/semantics/subscript.k-106-       requires I >=Int LEN
/reference/k-proof/reference-semantics/semantics/subscript.k-107-
/reference/k-proof/reference-semantics/semantics/subscript.k-108-  // ==== build the strided sub-sequence (indices in range by construction) ====
/reference/k-proof/reference-semantics/semantics/subscript.k:109:  syntax ValSeq ::= buildVS(ValSeq, Int, Int, Int) [function]
/reference/k-proof/reference-semantics/semantics/subscript.k-110-  rule buildVS(VS:ValSeq, I:Int, STOP:Int, STEP:Int)
/reference/k-proof/reference-semantics/semantics/subscript.k-111-    => vCons(valSeqAt(VS, I), buildVS(VS, I +Int STEP, STOP, STEP))
/reference/k-proof/reference-semantics/semantics/subscript.k-112-       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
/reference/k-proof/reference-semantics/semantics/subscript.k-113-  rule buildVS(_:ValSeq, I:Int, STOP:Int, STEP:Int) => .ValSeq
/reference/k-proof/reference-semantics/semantics/subscript.k-114-       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
/reference/k-proof/reference-semantics/semantics/subscript.k-115-
/reference/k-proof/reference-semantics/semantics/subscript.k-116-  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]
/reference/k-proof/reference-semantics/semantics/subscript.k-117-  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
/reference/k-proof/reference-semantics/semantics/subscript.k-118-    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
/reference/k-proof/reference-semantics/semantics/subscript.k-119-       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
/reference/k-proof/reference-semantics/semantics/subscript.k-120-  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
/reference/k-proof/reference-semantics/semantics/subscript.k-121-       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
