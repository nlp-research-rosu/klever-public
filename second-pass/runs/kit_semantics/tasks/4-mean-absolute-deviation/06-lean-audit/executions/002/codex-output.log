/reference/k-proof/reference-semantics/semantics/core.k-11-
/reference/k-proof/reference-semantics/semantics/core.k-12-  // ==== values, the algebraic lists, and the scope heap =====================
/reference/k-proof/reference-semantics/semantics/core.k-13-  syntax IntSeq ::= ".IntSeq" | iCons(Int, IntSeq)
/reference/k-proof/reference-semantics/semantics/core.k:14:  syntax ValSeq ::= ".ValSeq" | vCons(Val, ValSeq)
/reference/k-proof/reference-semantics/semantics/core.k-15-  syntax Str    ::= str(IntSeq)
/reference/k-proof/reference-semantics/semantics/core.k-16-
/reference/k-proof/reference-semantics/semantics/core.k-17-  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)
/reference/k-proof/reference-semantics/semantics/core.k-18-  syntax Iterable ::= list(ValSeq)
/reference/k-proof/reference-semantics/semantics/core.k-19-                    | tuple(ValSeq)
/reference/k-proof/reference-semantics/semantics/core.k-20-                    | Str
/reference/k-proof/reference-semantics/semantics/core.k-21-                    | rangeObj(Int, Int, Int)
/reference/k-proof/reference-semantics/semantics/core.k-22-                    | zipObj(ValSeq, ValSeq)
/reference/k-proof/reference-semantics/semantics/core.k-23-                    | zipObjS(IntSeq, IntSeq)
/reference/k-proof/reference-semantics/semantics/core.k-24-
/reference/k-proof/reference-semantics/semantics/core.k:25:  syntax Val      ::= Int
/reference/k-proof/reference-semantics/semantics/core.k-26-                    | Bool
/reference/k-proof/reference-semantics/semantics/core.k-27-                    | "noneV"
/reference/k-proof/reference-semantics/semantics/core.k-28-                    | Iterable
/reference/k-proof/reference-semantics/semantics/core.k-29-                    | ref(Int)          // a heap object: <heap> holds its list(VS)
/reference/k-proof/reference-semantics/semantics/core.k-30-                    | cellRef(Int)      // a closure cell: <heap> holds cellV(V)
/reference/k-proof/reference-semantics/semantics/core.k-31-                    | closureVal(ParamNames, Stmts, Int)
/reference/k-proof/reference-semantics/semantics/core.k-32-                    | typeV(String)     // a type object (int/str), resolved from the builtins frame
/reference/k-proof/reference-semantics/semantics/core.k-33-                    | builtinV(String)  // a builtin function, resolved like any name (LEGB fallthrough)
/reference/k-proof/reference-semantics/semantics/core.k-34-                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method
/reference/k-proof/reference-semantics/semantics/core.k-35-
/reference/k-proof/reference-semantics/semantics/core.k-36-  syntax Parent   ::= "root" | parent(Int)
/reference/k-proof/reference-semantics/semantics/core.k-37-  syntax Scope    ::= scope(Map, Parent)
/reference/k-proof/reference-semantics/semantics/core.k-38-  syntax KResult  ::= Val
/reference/k-proof/reference-semantics/semantics/core.k-39-  syntax Expr     ::= Val   // cooling puts results back into expression holes
/reference/k-proof/reference-semantics/semantics/core.k:40:  syntax Vals     ::= List{Val, ","}
/reference/k-proof/reference-semantics/semantics/core.k-41-  syntax Exc      ::= "NoExc" | "AssertionError"
/reference/k-proof/reference-semantics/semantics/core.k-42-  syntax RetState ::= "noRet" | retV(Val)
/reference/k-proof/reference-semantics/semantics/core.k-43-
/reference/k-proof/reference-semantics/semantics/core.k-44-  // ==== configuration =======================================================
/reference/k-proof/reference-semantics/semantics/core.k-45-  // The builtins namespace is a real scope at reserved location -1 (the bottom of every
/reference/k-proof/reference-semantics/semantics/core.k-46-  // chain; scopeLoc only allocates >=1, so -1 never collides). The module scope (loc 0)
/reference/k-proof/reference-semantics/semantics/core.k-47-  // has it as parent, so an unbound name resolves there last — exactly LEGB. `int`/`str`
/reference/k-proof/reference-semantics/semantics/core.k-48-  // resolve to their type objects; any local/global binding shadows them via normal lookup.
/reference/k-proof/reference-semantics/semantics/core.k-49-  configuration
/reference/k-proof/reference-semantics/semantics/core.k-50-    <k>       #loadAll($PGM:Module) </k>
/reference/k-proof/reference-semantics/semantics/core.k-51-    <env>     0 </env>
/reference/k-proof/reference-semantics/semantics/core.k-52-    <scopes>   0     |-> scope(.Map, parent(-1))
