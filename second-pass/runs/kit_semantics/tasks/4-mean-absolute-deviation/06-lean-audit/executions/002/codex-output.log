@@ -0,0 +1,44 @@
+import Proof
+
+open Proof
+
+def floatK (value : SortFloat) : SortK :=
+  SortK.kseq (SortKItem.inj_SortFloat value) SortK.dotk
+
+def intK (value : SortInt) : SortK :=
+  SortK.kseq (SortKItem.inj_SortInt value) SortK.dotk
+
+#eval addF 1.5 2.25
+
+#eval subF 5.5 2.25
+
+example : isFloat (floatK 1.5) = true := by native_decide
+
+example : isFloat (intK 1) = false := by native_decide
+
+example : projectFloat (SortVal.inj_SortFloat 7.25) = 7.25 := by rfl
+
+example : «project:Float?» (floatK 7.25) = some 7.25 := by rfl
+
+example : «project:Float?» (intK 7) = none := by rfl
+
+#eval match
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortFloat 1.5) (SortVal.inj_SortFloat 2.25)
+  with
+  | SortVal.inj_SortFloat result => some result
+  | _ => none
+
+#eval match
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "-" (SortVal.inj_SortFloat 5.5) (SortVal.inj_SortFloat 2.25)
+  with
+  | SortVal.inj_SortFloat result => some result
+  | _ => none
+
+#eval match
+    «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      "+" (SortVal.inj_SortInt 2) (SortVal.inj_SortInt 3)
+  with
+  | SortVal.inj_SortInt result => some result
+  | _ => none
