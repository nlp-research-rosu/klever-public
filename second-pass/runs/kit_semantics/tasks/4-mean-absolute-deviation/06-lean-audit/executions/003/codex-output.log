      "normalized_sha256": "6f259967cef4b955723deaec2b3a84a45eb80e7f4eaa15e3db1588a7a25c310f",
      "rationale": "This simplification rule adds the analogous guarded subtraction equality for the pre-existing applyBin operation, and no rule-free Stage 1 proof first establishes its exact statement.",
      "source_rule_id": "rule-6f259967cef4b955723deaec2b3a84a45eb80e7f4eaa15e3db1588a7a25c310f",
      "start_line": 71,
      "text": "  rule applyBin(\"-\", V:Val, M:Float)\n    => subF(projectFloat(V), M)\n    requires isFloat(V)\n    [simplification]"
    }
