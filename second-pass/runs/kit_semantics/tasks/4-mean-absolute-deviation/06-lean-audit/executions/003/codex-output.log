{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "0b30d37fcb1fa6f2e9d5602fd000c7184e19e2179cc09da8efcca1f73abb811e",
      "rationale": "This is the macro equation expanding the fresh proof term madBody into the translated statement sequence, so it is a definitional abbreviation rather than an execution rule or additional theorem.",
      "source_rule_id": "rule-0b30d37fcb1fa6f2e9d5602fd000c7184e19e2179cc09da8efcca1f73abb811e",
      "start_line": 26,
      "text": "  rule madBody\n    => Assign(Name(\"count\"), Call(Name(\"len\"), Name(\"numbers\")))\n       If(Compare(Name(\"count\"), CmpOp(\"==\", Int(0))),\n          Return(Float(0.0)),\n          .Stmts)\n       Assign(Name(\"total\"), Float(0.0))\n       Assign(Name(\"number\"), Float(0.0))\n       For(Name(\"number\"), Name(\"numbers\"),\n           Assign(Name(\"total\"),\n                  BinOp(\"+\", Name(\"total\"), Name(\"number\"))))\n       Assign(Name(\"mean\"), BinOp(\"/\", Name(\"total\"), Name(\"count\")))\n       Assign(Name(\"deviation\"), Float(0.0))\n       For(Name(\"number\"), Name(\"numbers\"),\n           Assign(Name(\"deviation\"),\n                  BinOp(\"+\",\n                        Name(\"deviation\"),\n                        Call(Name(\"abs\"),\n                             BinOp(\"-\", Name(\"number\"), Name(\"mean\"))))))\n       Return(BinOp(\"/\", Name(\"deviation\"), Name(\"count\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION",
      "normalized_sha256": "78f2a049ece805815d21e9063a74aff75f3d53f22a84a77fea64ffc91042a363",
      "rationale": "This is the empty-sequence base equation for the newly defined recursive domain predicate allFloatVS.",
      "source_rule_id": "rule-78f2a049ece805815d21e9063a74aff75f3d53f22a84a77fea64ffc91042a363",
      "start_line": 47,
      "text": "  rule allFloatVS(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "2a5f59dcc54d654448c496b86879b657233ccdf91d38545bb4c06ceb1ed40871",
      "rationale": "This is the cons recurrence for the newly defined allFloatVS predicate and structurally descends on the sequence tail.",
      "source_rule_id": "rule-2a5f59dcc54d654448c496b86879b657233ccdf91d38545bb4c06ceb1ed40871",
      "start_line": 48,
      "text": "  rule allFloatVS(vCons(V:Val, R:ValSeq))\n    => isFloat(V) andBool allFloatVS(R)"
    },
    {
      "attributes": [
        "concrete",
        "simplification(10)",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 59,
      "module": "VERIFICATION",
      "normalized_sha256": "f394e6869605ba695d3a1ee914ff52207c3f62e8e1c3c99caa25ea85dac2403e",
      "rationale": "This guarded equation defines the fresh total proof symbol projectFloat in terms of the existing partial cast on the domain where that cast is defined.",
      "source_rule_id": "rule-f394e6869605ba695d3a1ee914ff52207c3f62e8e1c3c99caa25ea85dac2403e",
      "start_line": 57,
      "text": "  rule projectFloat(V:Val) => {V}:>Float\n    requires isFloat(V)\n    [concrete, simplification(10), preserves-definedness]"
    },
    {
      "attributes": [
        "symbolic(V)",
        "simplification",
        "preserves-definedness"
      ],
      "classification": "DEFINITION",
      "end_line": 62,
      "module": "VERIFICATION",
      "normalized_sha256": "004b77064d41c5296c2b9a4939f9183460b9b84c088f3d578b78745808abb257",
      "rationale": "This is the reverse normalization orientation of the same guarded defining equation for the fresh projectFloat proof symbol, making the cast canonicalize to that named term.",
      "source_rule_id": "rule-004b77064d41c5296c2b9a4939f9183460b9b84c088f3d578b78745808abb257",
      "start_line": 60,
      "text": "  rule {V:Val}:>Float => projectFloat(V)\n    requires isFloat(V)\n    [symbolic(V), simplification, preserves-definedness]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 63,
      "module": "VERIFICATION",
      "normalized_sha256": "bd643f181b65c0fe3a82e3f5d4c2d3ba4e8c80c16d39267cbbeb88b6371fbbea",
      "rationale": "This simplification equation gives projectFloat its identity case on values already of sort Float and therefore defines the fresh projection helper.",
      "source_rule_id": "rule-bd643f181b65c0fe3a82e3f5d4c2d3ba4e8c80c16d39267cbbeb88b6371fbbea",
      "start_line": 63,
      "text": "  rule projectFloat(F:Float) => F [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 77,
      "module": "VERIFICATION",
      "normalized_sha256": "07e38f1df5e81d6a854903024c0a7ce85cdf237fa93efbb509e769c262f3bdac",
      "rationale": "This is the empty-sequence base equation defining the fresh left-fold summary sumFloatVS.",
      "source_rule_id": "rule-07e38f1df5e81d6a854903024c0a7ce85cdf237fa93efbb509e769c262f3bdac",
      "start_line": 77,
      "text": "  rule sumFloatVS(.ValSeq, A:Float) => A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 79,
      "module": "VERIFICATION",
      "normalized_sha256": "c262061ba80c2445257ddcd2f041f47b796a7c356c25ccd0abdc0c61f65a8ab4",
      "rationale": "This is the structurally recursive cons equation defining sumFloatVS by one addF step followed by the tail fold.",
      "source_rule_id": "rule-c262061ba80c2445257ddcd2f041f47b796a7c356c25ccd0abdc0c61f65a8ab4",
      "start_line": 78,
      "text": "  rule sumFloatVS(vCons(V:Val, R:ValSeq), A:Float)\n    => sumFloatVS(R, addF(A, projectFloat(V)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 81,
      "module": "VERIFICATION",
      "normalized_sha256": "e05dfca0da35f598226b9eaa3edd9657b842c4ca648929840531db77d9a1cc03",
      "rationale": "This is the empty-sequence base equation defining the fresh deviationFloatVS fold summary.",
      "source_rule_id": "rule-e05dfca0da35f598226b9eaa3edd9657b842c4ca648929840531db77d9a1cc03",
      "start_line": 81,
      "text": "  rule deviationFloatVS(.ValSeq, _:Float, A:Float) => A"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 86,
      "module": "VERIFICATION",
      "normalized_sha256": "86b9970d9f7bc47527162d9e7b2d0edf29e0222f21c615a73606be510fae2a55",
      "rationale": "This is the structurally recursive cons equation defining deviationFloatVS through subtraction, absolute value, addition, and the tail fold.",
      "source_rule_id": "rule-86b9970d9f7bc47527162d9e7b2d0edf29e0222f21c615a73606be510fae2a55",
      "start_line": 82,
      "text": "  rule deviationFloatVS(vCons(V:Val, R:ValSeq), M:Float, A:Float)\n    => deviationFloatVS(\n         R,\n         M,\n         addF(A, absF(subF(projectFloat(V), M))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 89,
      "module": "VERIFICATION",
      "normalized_sha256": "64fc7fe46c4d3d4cba6d1895cec98deeda5e2d85a8aa58929c5d686628e20725",
      "rationale": "This guarded equation defines the zero-length branch of the fresh result summary madResult.",
      "source_rule_id": "rule-64fc7fe46c4d3d4cba6d1895cec98deeda5e2d85a8aa58929c5d686628e20725",
      "start_line": 88,
      "text": "  rule madResult(VS:ValSeq) => 0.0\n    requires vsLen(VS) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 99,
      "module": "VERIFICATION",
      "normalized_sha256": "07a3b4455e03279c9c5f1321b884035b05b44559041506e96c2b2c8559a8ca52",
      "rationale": "This complementary guarded equation defines the nonzero-length branch of madResult using the two fold summaries and the supplied division term.",
      "source_rule_id": "rule-07a3b4455e03279c9c5f1321b884035b05b44559041506e96c2b2c8559a8ca52",
      "start_line": 90,
      "text": "  rule madResult(VS:ValSeq)\n    => divFloatIntV(\n         deviationFloatVS(\n           VS,\n           divFloatIntV(\n             sumFloatVS(VS, 0.0),\n             vsLen(VS)),\n           0.0),\n         vsLen(VS))\n    requires vsLen(VS) =/=Int 0"
    }
  ],
