=== solution.py ===
     1	from typing import List
     2	
     3	
     4	def mean_absolute_deviation(numbers: List[float]) -> float:
     5	    count = len(numbers)
     6	    if count == 0:
     7	        return 0.0
     8	
     9	    total = 0.0
    10	    number = 0.0
    11	    for number in numbers:
    12	        total = total + number
    13	
    14	    mean = total / count
    15	    deviation = 0.0
    16	    for number in numbers:
    17	        deviation = deviation + abs(number - mean)
    18	
    19	    return deviation / count
