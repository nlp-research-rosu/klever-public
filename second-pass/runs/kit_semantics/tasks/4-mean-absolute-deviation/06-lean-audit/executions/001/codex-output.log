    if isinstance(x,dict):
        for k,v in x.items():
            q=f'{p}.{k}' if p else k
            if any(s in k.lower() for s in ('generator','producer','image')):
                print(q,'=',v if not isinstance(v,(dict,list)) else '<container>')
            walk(v,q)
    elif isinstance(x,list):
