diff --git a//tmp/audit-work/lean-audit/Counterfactual.lean b//tmp/audit-work/lean-audit/Counterfactual.lean
new file mode 100644
index 0000000000000000000000000000000000000000..09c2ddd2c6a974a9ce20bdfb60b48ce1bd990376
--- /dev/null
+++ b//tmp/audit-work/lean-audit/Counterfactual.lean
@@ -0,0 +1,48 @@
+import Klean4MeanAbsoluteDeviation.Lemmas
+
+namespace Counterfactual
+
+private def floatProjection : SortK → Option SortFloat
+  | SortK.kseq (SortKItem.inj_SortFloat value) SortK.dotk => some value
+  | _ => none
+
+-- Deliberately false arithmetic interpretations.
+def addF (_left _right : SortFloat) : SortFloat := 0.0
+def subF (_left _right : SortFloat) : SortFloat := 0.0
+
+def applyBin : SortString → SortVal → SortVal → SortVal
+  | "+", SortVal.inj_SortFloat _, SortVal.inj_SortFloat _ =>
+      SortVal.inj_SortFloat 0.0
+  | "-", SortVal.inj_SortFloat _, SortVal.inj_SortFloat _ =>
+      SortVal.inj_SortFloat 0.0
+  | _, _, _ => SortVal.«noneV_MPY-CORE_Val»
+
+def isFloat (term : SortK) : SortBool :=
+  (floatProjection term).isSome
+
+def projectFloat : SortVal → SortFloat
+  | SortVal.inj_SortFloat value => value
+  | _ => 0.0
+
+def projectFloatOption (term : SortK) : Option SortFloat :=
+  floatProjection term
+
+-- The same generated target remains provable because it compares the
+-- freely supplied operations only with each other.
+theorem targetStillCloses :
+    Klean4MeanAbsoluteDeviation.Lemmas.targetStatement
+      addF applyBin isFloat projectFloat subF projectFloatOption := by
+  constructor
+  · intro value
+    cases value <;> simp [projectFloatOption, isFloat, floatProjection]
+  constructor
+  · intro value accumulator isFloatValue
+    cases value <;>
+      simp [isFloat, floatProjection, inj, applyBin, projectFloat, addF]
+        at isFloatValue ⊢
+  · intro mean value isFloatValue
+    cases value <;>
+      simp [isFloat, floatProjection, inj, applyBin, projectFloat, subF]
+        at isFloatValue ⊢
+
+end Counterfactual
