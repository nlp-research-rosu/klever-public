/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path
inv=json.loads(Path('/reference/rule-inventory.json').read_text())
out=json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
canonical=[r['source_rule_id'] for r in inv['rules']]
actual=[r['source_rule_id'] for r in out['rules']]
assert actual == canonical
assert len(actual) == len(set(actual))
by_id={r['source_rule_id']:r for r in inv['rules']}
for entry in out['rules']:
    assert list(entry.keys()) == ['source_rule_id','classification','rationale'], entry
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'],str) and entry['rationale'].strip()
    if any(a.startswith('simplification') for a in by_id[entry['source_rule_id']]['attributes']):
        assert entry['classification'] in {'DEFINITION','DOMAIN_LEMMA'}, entry
counts=Counter(r['classification'] for r in out['rules'])
print('inventory_sha256='+out['inventory_sha256'])
print('rules='+str(len(actual)))
for k in ['DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA']:
    print(f'{k}={counts[k]}')
print('simplification constraint: PASS')
print('schema/order/uniqueness/completeness: PASS')
