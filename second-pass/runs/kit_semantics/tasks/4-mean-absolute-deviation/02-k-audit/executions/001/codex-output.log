</k>\nreference-semantics/semantics/controls.k:3:module MPY-CONTROLS\nreference-semantics/semantics/controls.k:8:  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==\nreference-semantics/semantics/controls.k:33:  // ==== import trivia: `from math import floor, ceil` binds the supported\nreference-semantics/semantics/controls.k:42:       requires N ==String \"floor\" orBool N ==String \"ceil\"\nreference-semantics/semantics/controls.k:44:       requires notBool (N ==String \"floor\" orBool N ==String \"ceil\")\nreference-semantics/semantics/controls.k:46:  // ==== Expr statement: evaluate for effect, discard the value ===============\nreference-semantics/semantics/controls.k:47:  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)\nreference-semantics/semantics/controls.k:50:  // ==== If (condition evaluated by strictness) ==============================\nreference-semantics/semantics/controls.k:56:  // ==== IfExp: ternary T if C else E ========================================\nreference-semantics/semantics/controls.k:62:  // ==== For: one loop, in-cell continuation, over #iterNext =================\nreference-semantics/semantics/controls.k:66:                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)\nreference-semantics/semantics/controls.k:76:  // ==== While ==============================================================\nreference-semantics/semantics/controls.k:77:  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>\nreference-semantics/semantics/controls.k:78:  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>\nreference-semantics/semantics/controls.k:79:  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>\nreference-semantics/semantics/controls.k:81:  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>\nreference-semantics/semantics/controls.k:84:  // ==== loop control (break / continue) =====================================\nreference-semantics/semantics/controls.k:93:  // ==== heap-object deref at the truthiness/iteration consumers ==============\nreference-semantics/semantics/controls.k:101:  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>\nreference-semantics/semantics/tuple.k:3:module MPY-TUPLE\nreference-semantics/semantics/tuple.k:9:  // ==== iteration (the iterator protocol's tuple case) ======================\nreference-semantics/semantics/tuple.k:13:  // ==== TupleExpr: tuple(ValSeq) literal + == != ===========================\nreference-semantics/semantics/tuple.k:18:  rule applyCmp(\"==\", tuple(A:ValSeq), tuple(B:ValSeq)) => A ==K B\nreference-semantics/semantics/tuple.k:24:  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]\nreference-semantics/semantics/tuple.k:25:  rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V\nreference-semantics/semantics/tuple.k:27:       requires notBool (A ==K V)\nreference-semantics/semantics/tuple.k:28:  rule applyCmp(\"!=\", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)\nreference-semantics/semantics/tuple.k:30:  // ==== target binding: bind a Name or a TupleExpr target to a value ========\nreference-semantics/semantics/tuple.k:48:  // ==== unpacking: a, b = <tuple|list> (RHS evaluated by strictness) ========\nreference-semantics/semantics/methods.k:3:module MPY-METHODS\nreference-semantics/semantics/methods.k:9:  // method-call routing + arg-eval live in call.k; this module owns applyMethod.\nreference-semantics/semantics/methods.k:10:  syntax Val ::= applyMethod(Val, String, Vals) [function]\nreference-semantics/semantics/methods.k:12:  // ==== string predicates (Python semantics) =================================\nreference-semantics/semantics/methods.k:15:  rule applyMethod(str(CS:IntSeq), \"isalpha\", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)\nreference-semantics/semantics/methods.k:16:  rule applyMethod(str(CS:IntSeq), \"isdigit\", .Vals) => notBool (CS ==K .