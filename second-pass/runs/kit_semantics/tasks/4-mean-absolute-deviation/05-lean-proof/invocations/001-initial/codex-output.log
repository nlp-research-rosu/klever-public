diff --git a/.lean-app-path.c b/.lean-app-path.c
new file mode 100644
index 0000000000000000000000000000000000000000..2ab072ebbf304352d730bc9b2f59e36a81f3160c
--- /dev/null
+++ b/.lean-app-path.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/auxv.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (strncmp(path, "/proc/", 6) == 0) {
+    const char *application = (const char *)getauxval(AT_EXECFN);
+    if (application) {
+      size_t length = strlen(application);
+      if (length > size) {
+        length = size;
+      }
+      memcpy(buffer, application, length);
+      return (ssize_t)length;
+    }
+  }
+  if (!real_readlink) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (!real_readlink) {
+    errno = ENOSYS;
+    return -1;
+  }
+  return real_readlink(path, buffer, size);
+}
diff --git a/HookWitnesses.lean b/HookWitnesses.lean
new file mode 100644
index 0000000000000000000000000000000000000000..875f13d5baca294a48861228acb637d57debf96a
--- /dev/null
+++ b/HookWitnesses.lean
@@ -0,0 +1,53 @@
+import Proof
+
+private def checkedDispatch
+    (operator : SortString) (left right expected : SortVal) : Bool :=
+  match Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      operator left right, expected with
+  | SortVal.inj_SortBool actual, SortVal.inj_SortBool wanted => actual == wanted
+  | SortVal.inj_SortFloat actual, SortVal.inj_SortFloat wanted => actual == wanted
+  | SortVal.inj_SortInt actual, SortVal.inj_SortInt wanted => actual == wanted
+  | SortVal.«noneV_MPY-CORE_Val», SortVal.«noneV_MPY-CORE_Val» => true
+  | _, _ => false
+
+private def intV (value : Int) : SortVal := SortVal.inj_SortInt value
+private def floatV (value : Float) : SortVal := SortVal.inj_SortFloat value
+private def boolV (value : Bool) : SortVal := SortVal.inj_SortBool value
+
+private def frozenWitnesses : List Bool := [
+  checkedDispatch "+" (intV 2) (intV 3) (intV 5),
+  checkedDispatch "+" (intV 2) (boolV true) (intV 3),
+  checkedDispatch "+" (boolV true) (intV 2) (intV 3),
+  checkedDispatch "-" (intV 7) (intV 3) (intV 4),
+  checkedDispatch "*" (intV 7) (intV 3) (intV 21),
+  checkedDispatch "%" (intV (-5)) (intV 3) (intV 1),
+  checkedDispatch "%" (intV 5) (intV (-3)) (intV (-1)),
+  checkedDispatch "%" (intV (-5)) (intV (-3)) (intV (-2)),
+  checkedDispatch "//" (intV (-5)) (intV 3) (intV (-2)),
+  checkedDispatch "//" (intV 5) (intV (-3)) (intV (-2)),
+  checkedDispatch "//" (intV (-5)) (intV (-3)) (intV 1),
+  checkedDispatch "**" (intV 2) (intV 5) (intV 32),
+  checkedDispatch "/" (intV 3) (floatV 2.0) (floatV 1.5),
+  checkedDispatch "/" (intV 3) (intV 2) (floatV 1.5),
+  checkedDispatch "%" (floatV 3.5) (floatV 1.0) (floatV 0.5),
+  checkedDispatch "%" (floatV (-3.5)) (floatV 1.0) (floatV 0.5),
+  checkedDispatch "-" (floatV 5.5) (floatV 2.0) (floatV 3.5),
+  checkedDispatch "/" (floatV 5.0) (floatV 2.0) (floatV 2.5),
+  checkedDispatch "+" (floatV 2.0) (floatV 3.5) (floatV 5.5),
+  checkedDispatch "*" (floatV 2.0) (floatV 3.5) (floatV 7.0),
+  checkedDispatch "**" (floatV 2.0) (floatV 3.0) (floatV 8.0),
+  checkedDispatch "**" (intV 2) (floatV 3.0) (floatV 8.0),
+  checkedDispatch "**" (floatV 2.0) (intV 3) (floatV 8.0),
+  checkedDispatch "-" (intV 5) (floatV 1.5) (floatV 3.5),
+  checkedDispatch "-" (floatV 5.5) (intV 2) (floatV 3.5),
+  checkedDispatch "+" (intV 2) (floatV 3.5) (floatV 5.5),
+  checkedDispatch "+" (floatV 2.5) (intV 3) (floatV 5.5),
+  checkedDispatch "*" (intV 2) (floatV 3.5) (floatV 7.0),
+  checkedDispatch "*" (floatV 2.5) (intV 3) (floatV 7.5),
+  checkedDispatch "/" (floatV 5.0) (intV 2) (floatV 2.5),
+  checkedDispatch "%" (intV 7) (intV 0) SortVal.«noneV_MPY-CORE_Val»,
+  checkedDispatch "//" (intV 7) (intV 0) SortVal.«noneV_MPY-CORE_Val»,
+  checkedDispatch "**" (intV 2) (intV (-1)) SortVal.«noneV_MPY-CORE_Val»
+]
+
+#eval frozenWitnesses.all id
