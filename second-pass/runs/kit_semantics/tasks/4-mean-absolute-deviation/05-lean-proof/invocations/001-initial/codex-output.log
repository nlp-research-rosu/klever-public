--- /dev/null
+++ b/.hook-witnesses.py
@@ -0,0 +1,30 @@
+assert 2 + 3 == 5
+assert 2 + True == 3
+assert True + 2 == 3
+assert 7 - 3 == 4
+assert 7 * 3 == 21
+assert -5 % 3 == 1
+assert 5 % -3 == -1
+assert -5 % -3 == -2
+assert -5 // 3 == -2
+assert 5 // -3 == -2
+assert -5 // -3 == 1
+assert 2 ** 5 == 32
+assert 3 / 2.0 == 1.5
+assert 3 / 2 == 1.5
+assert 3.5 % 1.0 == 0.5
+assert -3.5 % 1.0 == 0.5
+assert 5.5 - 2.0 == 3.5
+assert 5.0 / 2.0 == 2.5
+assert 2.0 + 3.5 == 5.5
+assert 2.0 * 3.5 == 7.0
+assert 2.0 ** 3.0 == 8.0
+assert 2 ** 3.0 == 8.0
+assert 2.0 ** 3 == 8.0
+assert 5 - 1.5 == 3.5
+assert 5.5 - 2 == 3.5
+assert 2 + 3.5 == 5.5
+assert 2.5 + 3 == 5.5
+assert 2 * 3.5 == 7.0
+assert 2.5 * 3 == 7.5
+assert 5.0 / 2 == 2.5
diff --git a/.lean-app-path.c b/.lean-app-path.c
new file mode 100644
index 0000000000000000000000000000000000000000..2ab072ebbf304352d730bc9b2f59e36a81f3160c
--- /dev/null
+++ b/.lean-app-path.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/auxv.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (strncmp(path, "/proc/", 6) == 0) {
+    const char *application = (const char *)getauxval(AT_EXECFN);
+    if (application) {
+      size_t length = strlen(application);
+      if (length > size) {
+        length = size;
+      }
+      memcpy(buffer, application, length);
+      return (ssize_t)length;
+    }
+  }
+  if (!real_readlink) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (!real_readlink) {
+    errno = ENOSYS;
+    return -1;
+  }
+  return real_readlink(path, buffer, size);
+}
