+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» leftHead leftTail,
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» rightHead rightTail =>
+      leftHead == rightHead && checkedCodes leftTail rightTail
+  | _, _ => false
+
+private def checkedDispatch
+    (operator : SortString) (left right expected : SortVal) : Bool :=
+  match Proof.«applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+      operator left right, expected with
+  | SortVal.inj_SortBool actual, SortVal.inj_SortBool wanted => actual == wanted
+  | SortVal.inj_SortFloat actual, SortVal.inj_SortFloat wanted => actual == wanted
+  | SortVal.inj_SortInt actual, SortVal.inj_SortInt wanted => actual == wanted
+  | SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» actual),
+      SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» wanted) =>
+      checkedCodes actual wanted
+  | SortVal.«noneV_MPY-CORE_Val», SortVal.«noneV_MPY-CORE_Val» => true
+  | _, _ => false
+
+private def intV (value : Int) : SortVal := SortVal.inj_SortInt value
+private def floatV (value : Float) : SortVal := SortVal.inj_SortFloat value
+private def boolV (value : Bool) : SortVal := SortVal.inj_SortBool value
+private def emptyCodes : SortIntSeq := SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+private def codeCons (head : Int) (tail : SortIntSeq) : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» head tail
+private def strV (codes : SortIntSeq) : SortVal :=
+  SortVal.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» codes)
+private def nestedStrV (codes : SortIntSeq) : SortVal :=
+  SortVal.inj_SortIterable
+    (SortIterable.inj_SortStr (SortStr.«str(_)_MPY-CORE_Str_IntSeq» codes))
+
+private def abCodes := codeCons 97 (codeCons 98 emptyCodes)
+private def cdCodes := codeCons 99 (codeCons 100 emptyCodes)
+private def abcdCodes :=
+  codeCons 97 (codeCons 98 (codeCons 99 (codeCons 100 emptyCodes)))
+
+private def frozenWitnesses : List Bool := [
