      "start_line": 44,
      "text": "  rule applyCmp(\">=\", V:Val, W:Val)\n    => projectIntTotal(V) >=Int projectIntTotal(W)\n    requires isIntVal(V) andBool isIntVal(W)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 52,
      "module": "VERIFICATION",
      "normalized_sha256": "3e1ce8e4b12d8d2bae33238dc22c1575ab618c72afa918828d490765e79c8c2c",
      "source_rule_id": "rule-3e1ce8e4b12d8d2bae33238dc22c1575ab618c72afa918828d490765e79c8c2c",
      "start_line": 49,
      "text": "  rule applyCmp(\">\", V:Val, W:Val)\n    => projectIntTotal(V) >Int projectIntTotal(W)\n    requires isIntVal(V) andBool isIntVal(W)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 57,
      "module": "VERIFICATION",
      "normalized_sha256": "45c3bb147f4e28b3f60623a84ce2306b2a8b697607e4388f59b32c4585d29c66",
