      "start_line": 15,
      "text": "  rule definedProjectInt(V:Val) => isIntVal(V)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "0312858a8718cb93d212cdb7b679a2875534dc14191dff8edf7bccf9a96d8b43",
