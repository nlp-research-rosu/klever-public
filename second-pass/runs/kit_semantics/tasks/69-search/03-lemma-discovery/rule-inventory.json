      "start_line": 90,
      "text": "  rule searchSummary(\n         vCons(V:Val, REST:ValSeq),\n         FULL:ValSeq,\n         A:Int)\n    => searchSummary(\n         REST,\n         FULL,\n         updateAnswer(\n           A,\n           projectIntTotal(V),\n           frequencyOf(projectIntTotal(V), FULL)))\n    requires isIntVal(V)"
    },
