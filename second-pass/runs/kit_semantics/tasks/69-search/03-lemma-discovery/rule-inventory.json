      "start_line": 39,
      "text": "  rule applyCmp(\"==\", V:Val, W:Val)\n    => projectIntTotal(V) ==Int projectIntTotal(W)\n    requires isIntVal(V) andBool isIntVal(W)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
