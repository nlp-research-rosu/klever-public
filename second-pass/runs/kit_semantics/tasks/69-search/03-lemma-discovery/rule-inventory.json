      "start_line": 54,
      "text": "  rule applyBin(\"+\", V:Val, W:Val)\n    => projectIntTotal(V) +Int projectIntTotal(W)\n    requires isIntVal(V) andBool isIntVal(W)\n    [simplification]"
    },
    {
      "attributes": [],
      "end_line": 61,
      "module": "VERIFICATION",
      "normalized_sha256": "332de7605ea6aa1e510f40ded7182caba877f3081adf123c12192f6f51e58863",
