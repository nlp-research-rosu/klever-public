Module(
  FuncDef("search", Params("lst"),
    Assign(Name("answer"), UnaryOp("-", Int(1)))
    Assign(Name("candidate"), Int(1))
    Assign(Name("frequency"), Int(0))
    Assign(Name("item"), Int(1))
    For(Name("candidate"), Name("lst"),
      Assign(Name("frequency"), Int(0))
      For(Name("item"), Name("lst"),
        If(Compare(Name("item"), CmpOp("==", Name("candidate"))),
          Assign(
            Name("frequency"),
            BinOp("+", Name("frequency"), Int(1))),
          ))
      If(Compare(Name("frequency"), CmpOp(">=", Name("candidate"))),
        If(Compare(Name("candidate"), CmpOp(">", Name("answer"))),
          Assign(Name("answer"), BinOp("+", Name("candidate"), Int(0))),
          ),
        ))
    Return(Name("answer")))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(Int(4), Int(1), Int(2), Int(2), Int(3), Int(1))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(
          Int(1),
          Int(2),
          Int(2),
          Int(3),
          Int(3),
          Int(3),
          Int(4),
          Int(4),
          Int(4))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(Int(5), Int(5), Int(4), Int(4), Int(4))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(Call(Name("search"), ListExpr(Int(1))), CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("search"), ListExpr(Int(2))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(
          Int(7),
          Int(7),
          Int(7),
          Int(7),
          Int(7),
          Int(7),
          Int(7),
          Int(1))),
      CmpOp("==", Int(7)))))
