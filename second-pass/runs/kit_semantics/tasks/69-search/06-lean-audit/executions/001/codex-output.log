+import Proof
+
+open Proof
+
+def isInt7 : SortVal → Bool
+  | SortVal.inj_SortInt 7 => true
+  | _ => false
+
+def isInt3 : SortVal → Bool
+  | SortVal.inj_SortInt 3 => true
+  | _ => false
+
+def isNoneV : SortVal → Bool
+  | SortVal.«noneV_MPY-CORE_Val» => true
+  | _ => false
+
+-- Positive controls from the four source-program dispatch obligations.
+#eval isInt7 <|
+  «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "+"
+    (SortVal.inj_SortInt 5)
+    (SortVal.inj_SortInt 2)
+#eval «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+  ">"
+  (SortVal.inj_SortInt 5)
+  (SortVal.inj_SortInt 2)
+
+-- Adversarial cases in the frozen operational domain of the same KORE symbols.
+-- MPY-INT says applyBin("-", 5, 2) rewrites to 3.
+#eval isInt3 <|
+  «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "-"
+    (SortVal.inj_SortInt 5)
+    (SortVal.inj_SortInt 2)
+#eval isNoneV <|
+  «applyBin(_,_,_)_MPY-CORE_Val_String_Val_Val»
+    "-"
+    (SortVal.inj_SortInt 5)
+    (SortVal.inj_SortInt 2)
+
+-- MPY-OPERATORS says applyCmp("is", noneV, noneV) rewrites to true.
+#eval «applyCmp(_,_,_)_MPY-CORE_Bool_String_Val_Val»
+  "is"
+  SortVal.«noneV_MPY-CORE_Val»
+  SortVal.«noneV_MPY-CORE_Val»
