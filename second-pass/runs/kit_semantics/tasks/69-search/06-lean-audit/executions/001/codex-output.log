+#!/usr/bin/env bash
+set -euo pipefail
+
+bridge_root=/tmp/audit-work/lean-bridge
+real_toolchain=/opt/elan/toolchains/leanprover--lean4---v4.22.0
+compile_bridge=/tmp/audit-work/lean-compile-bridge.lean
+
+case "${1-}" in
+  --print-prefix)
+    printf '%s\n' "$bridge_root"
+    exit 0
+    ;;
+  --githash)
+    printf '%s\n' ba2cbbf
+    exit 0
+    ;;
+  --version|-v)
+    printf '%s\n' 'Lean (version 4.22.0)'
+    exit 0
+    ;;
+esac
+
+if [[ -n "${LEAN_PATH-}" ]]; then
+  bridge_lean_path="${LEAN_PATH}:$real_toolchain/lib/lean"
+else
+  bridge_lean_path="$real_toolchain/lib/lean"
+fi
+
+export LAKE_HOME="$real_toolchain/src/lean/lake"
+export LEAN_SYSROOT="$real_toolchain"
+export LEAN_PATH="$bridge_lean_path"
+
+exec "$real_toolchain/bin/lake" \
+  --file="$compile_bridge" \
+  script run compile -- "$@"
diff --git a//tmp/audit-work/lean-compile-bridge.lean b//tmp/audit-work/lean-compile-bridge.lean
new file mode 100644
index 0000000000000000000000000000000000000000..06b96733dbcfe2e74683cdade69388f1b79d06ec
--- /dev/null
+++ b//tmp/audit-work/lean-compile-bridge.lean
@@ -0,0 +1,62 @@
+import Lake
+import Lean.Elab.Frontend
+import Lean.Compiler.IR.EmitC
+
+open Lake DSL
+open System
+
+package audit_compile_bridge
+
+private structure CompileArgs where
+  source : Option FilePath := none
+  olean : Option FilePath := none
+  ilean : Option FilePath := none
+  cFile : Option FilePath := none
+  setup : Option FilePath := none
+
+private def parseCompileArgs (args : List String) : Except String CompileArgs := do
+  let rec go (remaining : List String) (result : CompileArgs) :
+      Except String CompileArgs := do
+    match remaining with
+    | [] => pure result
+    | "-o" :: path :: rest => go rest { result with olean := some path }
+    | "-i" :: path :: rest => go rest { result with ilean := some path }
+    | "-c" :: path :: rest => go rest { result with cFile := some path }
+    | "--setup" :: path :: rest => go rest { result with setup := some path }
+    | "-D" :: _ :: rest => go rest result
+    | "-s" :: _ :: rest => go rest result
+    | "--json" :: rest => go rest result
+    | arg :: rest =>
+      if arg.endsWith ".lean" then
+        go rest { result with source := some arg }
+      else
+        go rest result
+  go args {}
+
+script compile args do
+  let parsed ← IO.ofExcept <| parseCompileArgs args
+  let source ←
+    match parsed.source with
+    | some value => pure value
+    | none => throw <| IO.userError "missing Lean source"
+  let setupFile ←
+    match parsed.setup with
+    | some value => pure value
+    | none => throw <| IO.userError "missing module setup"
+  let setup ← Lean.ModuleSetup.load setupFile
+  let input ← IO.FS.readFile source
+  let options : Lean.Options :=
+    ({} : Lean.Options)
+      |>.setNat `maxHeartbeats 10000000
+      |>.setNat `maxRecDepth 100000
+  let environment? ← Lean.Elab.runFrontend
+    input options source.toString setup.name 0 parsed.olean parsed.ilean
+    false #[] #[] false (some setup)
+  let environment ←
+    match environment? with
+    | some value => pure value
+    | none => throw <| IO.userError s!"elaboration failed: {source}"
+  if let some cFile := parsed.cFile then
+    IO.FS.writeFile cFile <| ← IO.ofExcept <|
+      Lean.IR.emitC environment setup.name
+  return 0
