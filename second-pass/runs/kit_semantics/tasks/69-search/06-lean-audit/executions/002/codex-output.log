   100	                Name("item"),
   101	                Name("lst"),
   102	                If(
   103	                  Compare(
   104	                    Name("item"),
   105	                    CmpOp("==", Name("candidate"))),
   106	                  Assign(
   107	                    Name("frequency"),
   108	                    BinOp("+", Name("frequency"), Int(1))),
   109	                  .Stmts))
   110	              If(
   111	                Compare(
   112	                  Name("frequency"),
   113	                  CmpOp(">=", Name("candidate"))),
   114	                If(
   115	                  Compare(
   116	                    Name("candidate"),
   117	                    CmpOp(">", Name("answer"))),
   118	                  Assign(
