    20	/- Exact models of the hooked integer operations used by MPY-INT. -/
    21	def frozenKRem (left right : SortInt) : SortInt :=
    22	  if right = 0 then 0 else Int.emod left right
    23	
    24	def frozenPyMod (left right : SortInt) : SortInt :=
    25	  if right = 0 then 0
    26	  else frozenKRem (frozenKRem left right + right) right
    27	
    28	def frozenFloorDiv (left right : SortInt) : SortInt :=
    29	  if right = 0 then 0
    30	  else Int.tdiv (left - frozenPyMod left right) right
    31	
    32	def frozenIntPow (base exponent : SortInt) : Option SortInt :=
    33	  if exponent < 0 then none else some (Int.pow base exponent.toNat)
