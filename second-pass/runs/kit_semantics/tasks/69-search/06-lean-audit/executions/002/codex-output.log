+import Proof
+
+open Proof
+
+/- Boolean hook: complete truth table, excluding constant/identity versions. -/
+#guard _andBool_ true true
+#guard !(_andBool_ true false)
+#guard !(_andBool_ false true)
+#guard !(_andBool_ false false)
