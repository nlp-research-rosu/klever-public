/bin/bash -lc "script -qefc 'env PYTHONPATH=/reference python /audit-output/evidence/10_axiom_and_source_reconcile.py' /audit-output/evidence/10_axiom_and_source_reconcile.log; rc="'$?; printf '"'EXIT_CODE=%s\\n' \""'$rc"; exit "$rc"' in /audit-output
