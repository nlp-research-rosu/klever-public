--- prompt/source solution ---

def search(lst):
    '''
    You are given a non-empty list of positive integers. Return the greatest integer that is greater than 
    zero, and has a frequency greater than or equal to the value of the integer itself. 
    The frequency of an integer is the number of times it appears in the list.
    If no such a value exist, return -1.
    Examples:
        search([4, 1, 2, 2, 3, 1]) == 2
        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3
        search([5, 5, 4, 4, 4]) == -1
    '''
def search(lst):
    answer = -1
    candidate = 1
    frequency = 0
    item = 1
    for candidate in lst:
        frequency = 0
        for item in lst:
            if item == candidate:
                frequency = frequency + 1
        if frequency >= candidate:
            if candidate > answer:
                answer = candidate + 0
    return answer
--- lowered solution ---
Module(
  FuncDef("search", Params("lst"),
    Assign(Name("answer"), UnaryOp("-", Int(1)))
    Assign(Name("candidate"), Int(1))
    Assign(Name("frequency"), Int(0))
    Assign(Name("item"), Int(1))
    For(Name("candidate"), Name("lst"),
      Assign(Name("frequency"), Int(0))
      For(Name("item"), Name("lst"),
        If(Compare(Name("item"), CmpOp("==", Name("candidate"))),
          Assign(
            Name("frequency"),
            BinOp("+", Name("frequency"), Int(1))),
          ))
      If(Compare(Name("frequency"), CmpOp(">=", Name("candidate"))),
        If(Compare(Name("candidate"), CmpOp(">", Name("answer"))),
          Assign(Name("answer"), BinOp("+", Name("candidate"), Int(0))),
          ),
        ))
    Return(Name("answer"))))
