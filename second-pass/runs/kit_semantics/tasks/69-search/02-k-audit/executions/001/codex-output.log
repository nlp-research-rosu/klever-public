+if [[ "$mutation_exit" == 0 ]] ||
+   grep -qx '#Top' /audit-output/evidence/stage4_body_mutation_bounded.log ||
+   ! grep -q 'WarnStuckClaimState' /audit-output/evidence/stage4_body_mutation_bounded.log; then
+  status=1
+fi
+
+printf 'stage4_body_sensitivity_exit=%s\n' "$status"
+exit "$status"
