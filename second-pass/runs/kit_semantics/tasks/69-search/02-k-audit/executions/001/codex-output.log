     1	import ast
     2	from pathlib import Path
     3	
     4	
     5	def compact_k(text):
     6	    output = []
     7	    quoted = False
     8	    escaped = False
     9	    for char in text:
    10	        if quoted:
    11	            output.append(char)
    12	            if escaped:
    13	                escaped = False
    14	            elif char == "\\":
    15	                escaped = True
    16	            elif char == '"':
    17	                quoted = False
    18	        elif char == '"':
    19	            quoted = True
    20	            output.append(char)
    21	        elif not char.isspace():
    22	            output.append(char)
    23	    # The translator prints an empty statement sequence as the empty field
    24	    # between a comma and ")", while K pretty syntax also accepts `.Stmts`.
    25	    return "".join(output).replace(",.Stmts)", ",)")
    26	
    27	
    28	translated = Path("solution.mpy").read_text(encoding="utf-8").strip()
    29	specification = Path("spec.k").read_text(encoding="utf-8")
    30	marker = "#loadAll("
    31	start = specification.index(marker) + len(marker)
    32	
    33	depth = 1
    34	quoted = False
    35	escaped = False
    36	end = None
    37	for offset, char in enumerate(specification[start:], start=start):
    38	    if quoted:
    39	        if escaped:
    40	            escaped = False
    41	        elif char == "\\":
    42	            escaped = True
    43	        elif char == '"':
    44	            quoted = False
    45	        continue
    46	    if char == '"':
    47	        quoted = True
    48	    elif char == "(":
    49	        depth += 1
    50	    elif char == ")":
    51	        depth -= 1
    52	        if depth == 0:
    53	            end = offset
    54	            break
    55	
    56	if end is None:
    57	    raise SystemExit("program identity: unmatched #loadAll parenthesis")
    58	
    59	embedded = specification[start:end]
    60	if compact_k(translated) != compact_k(embedded):
    61	    raise SystemExit("program identity: solution.mpy differs from spec.k")
    62	
    63	solution_ast = ast.parse(Path("solution.py").read_text(encoding="utf-8"))
    64	tests_ast = ast.parse(Path("concrete_tests.py").read_text(encoding="utf-8"))
    65	solution_function = next(
    66	    node for node in solution_ast.body if isinstance(node, ast.FunctionDef)
    67	)
    68	tests_function = next(
    69	    node for node in tests_ast.body if isinstance(node, ast.FunctionDef)
    70	)
    71	if ast.dump(solution_function) != ast.dump(tests_function):
    72	    raise SystemExit(
    73	        "program identity: concrete_tests.py has a different search body"
    74	    )
    75	
    76	print("program identity: PASS")
