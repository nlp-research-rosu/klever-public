     7	def contract_oracle(values):
     8	    qualifying = [
     9	        value
    10	        for value in set(values)
    11	        if values.count(value) >= value
    12	    ]
    13	    return max(qualifying) if qualifying else -1
    14	
    15	
    16	cases = []
    17	for length in range(1, 7):
    18	    cases.extend(list(values) for values in product(range(1, 6), repeat=length))
