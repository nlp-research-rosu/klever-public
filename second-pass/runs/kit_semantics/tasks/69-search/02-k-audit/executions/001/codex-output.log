+#!/usr/bin/env bash
+set -uo pipefail
+set -x
+
+cd /tmp/audit-work/reconstruction
+status=0
+
+python3 /audit-output/evidence/extract_spec_program.py
+extract_exit=$?
+printf 'extract_exit=%s\n' "$extract_exit"
+if [[ "$extract_exit" != 0 ]]; then
+  status=1
