+    2>&1 |
+    tail -n 200 |
+    tee "/audit-output/evidence/stage5_${label}_bounded.log"
+  false_exit="${PIPESTATUS[0]}"
+  printf 'false_claim=%s exit=%s\n' "$label" "$false_exit"
