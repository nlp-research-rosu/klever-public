    20	rng = Random(20260729)
    21	for _ in range(500):
    22	    length = rng.randint(1, 30)
    23	    cases.append([rng.randint(1, 30) for _ in range(length)])
    24	
    25	mismatches = []
    26	for values in cases:
    27	    expected = contract_oracle(values)
    28	    actual = search(values)
    29	    if actual != expected:
    30	        mismatches.append((values, expected, actual))
    31	
    32	print(f"cases={len(cases)} mismatches={len(mismatches)}")
