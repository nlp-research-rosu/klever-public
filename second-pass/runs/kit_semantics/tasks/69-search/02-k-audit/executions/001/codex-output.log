+#!/usr/bin/env bash
+set -uo pipefail
+set -x
+
+cd /tmp/audit-work/reconstruction
+status=0
+
+for label in inner-loop outer-loop search-program; do
+  kprove spec.k \
+    --definition audit-verification-kompiled \
+    --spec-module SPEC \
+    --claims "SPEC.$label" \
+    2>&1 |
+    tail -n 200 |
+    tee "/audit-output/evidence/stage3_kprove_${label}_bounded.log"
+  claim_exit="${PIPESTATUS[0]}"
+  printf 'claim=%s exit=%s\n' "$label" "$claim_exit"
+  if [[ "$claim_exit" != 0 ]] ||
+     ! grep -qx '#Top' "/audit-output/evidence/stage3_kprove_${label}_bounded.log"; then
+    status=1
+  fi
+done
+
+printf 'stage3_individual_claims_exit=%s\n' "$status"
+exit "$status"
