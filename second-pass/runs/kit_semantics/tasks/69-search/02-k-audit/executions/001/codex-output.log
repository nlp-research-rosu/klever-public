index 0000000000000000000000000000000000000000..f524eeaf42bc9f4a87a58868a792a5d4ed167700
--- /dev/null
+++ b/evidence/stage5_inventory.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -uo pipefail
+set -x
+
+python3 /audit-output/evidence/rule_inventory.py \
+  > /audit-output/evidence/rule_inventory.md
+inventory_exit=$?
