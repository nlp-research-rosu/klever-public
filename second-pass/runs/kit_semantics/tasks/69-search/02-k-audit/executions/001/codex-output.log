+    --definition audit-verification-kompiled \
+    --spec-module SPEC \
+    --claims "SPEC.$label" \
+    2>&1 |
+    tail -n 200 |
+    tee "/audit-output/evidence/stage3_kprove_${label}_bounded.log"
+  claim_exit="${PIPESTATUS[0]}"
+  printf 'claim=%s exit=%s\n' "$label" "$claim_exit"
+  if [[ "$claim_exit" != 0 ]] ||
+     ! grep -qx '#Top' "/audit-output/evidence/stage3_kprove_${label}_bounded.log"; then
+    status=1
