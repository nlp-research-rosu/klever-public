+  --definition audit-verification-kompiled \
+  --spec-module EXTENSION-GROUND \
+  2>&1 |
+  tail -n 200 |
+  tee /audit-output/evidence/stage5_extension_ground_bounded.log
+ground_exit="${PIPESTATUS[0]}"
