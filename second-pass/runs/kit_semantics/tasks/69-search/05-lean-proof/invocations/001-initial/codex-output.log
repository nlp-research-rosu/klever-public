+def frozenIntIntBin
+    (operator : SortString) (left right : SortInt) : Option SortVal :=
+  if operator = "+" then
+    some (SortVal.inj_SortInt (left + right))
+  else if operator = "-" then
+    some (SortVal.inj_SortInt (left - right))
+  else if operator = "*" then
+    some (SortVal.inj_SortInt (left * right))
+  else if operator = "%" then
+    if right = 0 then none
