+
+def frozenFloatFloatBin
+    (operator : SortString) (left right : SortFloat) : Option SortVal :=
+  if operator = "-" then
+    some (SortVal.inj_SortFloat (left - right))
+  else if operator = "/" then
+    some (SortVal.inj_SortFloat (left / right))
+  else if operator = "+" then
