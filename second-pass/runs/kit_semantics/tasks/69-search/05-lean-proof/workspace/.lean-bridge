#!/bin/sh
set -eu

real_toolchain=/opt/elan/toolchains/leanprover--lean4---v4.22.0

case "${1-}" in
  --print-prefix)
    printf '%s\n' /tmp/lean-bridge
    exit 0
    ;;
  --githash)
    printf '%s\n' ba2cbbf
    exit 0
    ;;
  --version|-v)
    printf '%s\n' 'Lean (version 4.22.0)'
    exit 0
    ;;
esac

if [ -n "${LEAN_PATH-}" ]; then
  bridge_lean_path="${LEAN_PATH}:$real_toolchain/lib/lean"
else
  bridge_lean_path="$real_toolchain/lib/lean"
fi

export LAKE_HOME="$real_toolchain/src/lean/lake"
export LEAN_SYSROOT="$real_toolchain"
export LEAN_PATH="$bridge_lean_path"

exec "$real_toolchain/bin/lake" \
  --file=/workspace/.toolchain-lake.lean \
  script run compile -- "$@"
