fi
echo "audit metrics: model_exit=$MODEL_EXIT_CODE harness_exit=$HARNESS_EXIT_CODE timed_out=$TIMED_OUT mem_peak=$MEM_PEAK" >&2
exit "$FINAL_EXIT_CODE"

