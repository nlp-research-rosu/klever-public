new file mode 100644
index 0000000000000000000000000000000000000000..8b00815373fe7f96333ad23513a26cd9d68c928e
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def fib(n: int):
+    a = 0
+    b = 1
+    while n > 0:
+        b = a + b
+        a = b - a
+        n = n - 1
+    return a
+
+
+assert fib(0) == 0
+assert fib(1) == 1
+assert fib(2) == 1
+assert fib(8) == 21
