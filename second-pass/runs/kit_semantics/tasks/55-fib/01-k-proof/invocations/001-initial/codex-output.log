+from functools import lru_cache
+
+from solution import fib
+
+
+@lru_cache(maxsize=None)
+def recursive_oracle(n: int) -> int:
+    if n < 2:
+        return n
+    return recursive_oracle(n - 1) + recursive_oracle(n - 2)
+
+
+cases = list(range(31))
