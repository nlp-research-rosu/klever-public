+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the exact program returns 0 for the realizable input 0.
+  claim [fib-zero-is-one]:
+    <k> Call(Name("fib"), Int(0)) => 1 </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "fib" |-> closureVal(
+          "n", .ParamNames,
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(1))
+          While(
+            Compare(Name("n"), CmpOp(">", Int(0))),
+            Assign(Name("b"), BinOp("+", Name("a"), Name("b")))
+            Assign(Name("a"), BinOp("-", Name("b"), Name("a")))
+            Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+          )
+          Return(Name("a"))
+          .Stmts,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..527bbc9381991e4ac0682a48762a5b246eef100e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">", Int(0))),
+        Assign(Name("b"), BinOp("+", Name("a"), Name("b")))
+        Assign(Name("a"), BinOp("-", Name("b"), Name("a")))
+        Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+      )
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      SC:Map
+      1 |-> scope(
+        "n" |-> (N:Int => 0)
+        "a" |-> (A:Int => fibFrom(A, B, N))
+        "b" |-> (B:Int => ?BFinal:Int),
+        parent(0)
+      )
+    </scopes>
+    requires N >=Int 0
+
+  claim [fib-call]:
+    <k>
+      Call(Name("fib"), Int(N:Int))
+      => fibFrom(0, 1, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "fib" |-> closureVal(
+          "n", .ParamNames,
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(1))
+          While(
+            Compare(Name("n"), CmpOp(">", Int(0))),
+            Assign(Name("b"), BinOp("+", Name("a"), Name("b")))
+            Assign(Name("a"), BinOp("-", Name("b"), Name("a")))
+            Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+          )
+          Return(Name("a"))
+          .Stmts,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5d443989ef855c8536c0b9c36634f83d25a8ba49
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports INT
+
+  // The first component after N applications of
+  // (A, B) |-> (B, A + B).  The N <= 0 branch totalizes the helper;
+  // proof claims use it only for N >= 0.
+  syntax Int ::= fibFrom(Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule fibFrom(A, _B, N) => A
+    requires N <=Int 0
+
+  rule fibFrom(A, B, N) => fibFrom(B, A +Int B, N -Int 1)
+    requires N >Int 0
+
+  rule (A:Int +Int B:Int) -Int A => B [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b00815373fe7f96333ad23513a26cd9d68c928e
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def fib(n: int):
+    a = 0
+    b = 1
+    while n > 0:
+        b = a + b
+        a = b - a
+        n = n - 1
+    return a
+
+
+assert fib(0) == 0
+assert fib(1) == 1
+assert fib(2) == 1
+assert fib(8) == 21
+assert fib(10) == 55
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..8512639b44f7db54216e43addf0faaeb6081819f
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,24 @@
+from functools import lru_cache
+
+from solution import fib
+
+
+@lru_cache(maxsize=None)
+def recursive_oracle(n: int) -> int:
+    if n < 2:
+        return n
+    return recursive_oracle(n - 1) + recursive_oracle(n - 2)
+
+
+cases = list(range(31))
+mismatches = [
+    (n, fib(n), recursive_oracle(n))
+    for n in cases
+    if fib(n) != recursive_oracle(n)
+]
+
+print(f"cases={cases[0]}..{cases[-1]}")
+print(f"mismatches={len(mismatches)}")
+if mismatches:
+    print(mismatches)
+    raise SystemExit(1)
