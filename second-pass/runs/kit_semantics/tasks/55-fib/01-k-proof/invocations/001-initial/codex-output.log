diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5d443989ef855c8536c0b9c36634f83d25a8ba49
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports INT
+
+  // The first component after N applications of
+  // (A, B) |-> (B, A + B).  The N <= 0 branch totalizes the helper;
+  // proof claims use it only for N >= 0.
+  syntax Int ::= fibFrom(Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule fibFrom(A, _B, N) => A
+    requires N <=Int 0
+
+  rule fibFrom(A, B, N) => fibFrom(B, A +Int B, N -Int 1)
+    requires N >Int 0
+
+  rule (A:Int +Int B:Int) -Int A => B [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b00815373fe7f96333ad23513a26cd9d68c928e
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def fib(n: int):
+    a = 0
+    b = 1
+    while n > 0:
+        b = a + b
+        a = b - a
+        n = n - 1
+    return a
+
+
+assert fib(0) == 0
+assert fib(1) == 1
+assert fib(2) == 1
+assert fib(8) == 21
+assert fib(10) == 55
diff --git a/differential_test.py b/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..8512639b44f7db54216e43addf0faaeb6081819f
--- /dev/null
+++ b/differential_test.py
@@ -0,0 +1,24 @@
+from functools import lru_cache
+
+from solution import fib
+
+
+@lru_cache(maxsize=None)
+def recursive_oracle(n: int) -> int:
+    if n < 2:
+        return n
+    return recursive_oracle(n - 1) + recursive_oracle(n - 2)
+
+
+cases = list(range(31))
+mismatches = [
+    (n, fib(n), recursive_oracle(n))
+    for n in cases
+    if fib(n) != recursive_oracle(n)
+]
+
+print(f"cases={cases[0]}..{cases[-1]}")
+print(f"mismatches={len(mismatches)}")
+if mismatches:
+    print(mismatches)
+    raise SystemExit(1)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5011defcfc0576a93e797b2d0d3d79297415e776
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+python3 differential_test.py
+
+kompile --backend llvm reference-semantics/semantics.k \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy \
+  --definition runtime-kompiled \
+  --output none
+echo "KRUN_TESTS_PASSED"
+
+kompile --backend haskell verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-inv
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+if kprove spec-vacuity.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY; then
+  echo "ERROR: false-postcondition probe unexpectedly passed" >&2
+  exit 1
+else
+  echo "EXPECTED_FAILURE: false-postcondition probe"
+fi
+
+if kprove spec-body-mutation.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-BODY-MUTATION; then
+  echo "ERROR: body-mutation probe unexpectedly passed" >&2
+  exit 1
+else
+  echo "EXPECTED_FAILURE: body-mutation probe"
+fi
