+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the exact program returns 0 for the realizable input 0.
+  claim [fib-zero-is-one]:
+    <k> Call(Name("fib"), Int(0)) => 1 </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "fib" |-> closureVal(
+          "n", .ParamNames,
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(1))
+          While(
+            Compare(Name("n"), CmpOp(">", Int(0))),
+            Assign(Name("b"), BinOp("+", Name("a"), Name("b")))
+            Assign(Name("a"), BinOp("-", Name("b"), Name("a")))
+            Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+          )
+          Return(Name("a"))
+          .Stmts,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
