+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-inv]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">", Int(0))),
+        Assign(Name("b"), BinOp("+", Name("a"), Name("b")))
+        Assign(Name("a"), BinOp("-", Name("b"), Name("a")))
+        Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+      )
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      SC:Map
+      1 |-> scope(
+        "n" |-> (N:Int => 0)
+        "a" |-> (A:Int => fibFrom(A, B, N))
+        "b" |-> (B:Int => ?BFinal:Int),
+        parent(0)
+      )
+    </scopes>
+    requires N >=Int 0
+
+  claim [fib-call]:
+    <k>
+      Call(Name("fib"), Int(N:Int))
+      => fibFrom(0, 1, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "fib" |-> closureVal(
+          "n", .ParamNames,
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(1))
+          While(
+            Compare(Name("n"), CmpOp(">", Int(0))),
+            Assign(Name("b"), BinOp("+", Name("a"), Name("b")))
+            Assign(Name("a"), BinOp("-", Name("b"), Name("a")))
+            Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+          )
+          Return(Name("a"))
+          .Stmts,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..41807e6ffe683a456a2a55d64427ca98a193247d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports INT
+
+  // The first component after N applications of
+  // (A, B) |-> (B, A + B).  The N <= 0 branch totalizes the helper;
+  // proof claims use it only for N >= 0.
+  syntax Int ::= fibFrom(Int, Int, Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports MPY
+  imports VERIFICATION-SYNTAX
+  imports INT
+  imports BOOL
+
+  rule fibFrom(A, _B, N) => A
+    requires N <=Int 0
+
+  rule fibFrom(A, B, N) => fibFrom(B, A +Int B, N -Int 1)
+    requires N >Int 0
+endmodule

