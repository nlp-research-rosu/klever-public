Module(
  FuncDef("fib", Params("n"),
    Assign(Name("a"), Int(0))
    Assign(Name("b"), Int(1))
    While(Compare(Name("n"), CmpOp(">", Int(0))),
      Assign(Name("b"), BinOp("+", Name("a"), Name("b")))
      Assign(Name("a"), BinOp("-", Name("b"), Name("a")))
      Assign(Name("n"), BinOp("-", Name("n"), Int(1))))
    Return(Name("a")))
  Assert(Compare(Call(Name("fib"), Int(0)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("fib"), Int(1)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("fib"), Int(2)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("fib"), Int(8)), CmpOp("==", Int(21))))
  Assert(Compare(Call(Name("fib"), Int(10)), CmpOp("==", Int(55)))))
