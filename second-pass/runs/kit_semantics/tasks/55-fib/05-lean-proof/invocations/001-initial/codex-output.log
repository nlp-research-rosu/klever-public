codex
The root cause is environmental: processes receive namespace PIDs that do not exist in the mounted `/proc`, while this Lean runtime resolves its executable through `/proc/<getpid()>/exe`. I’ll use a temporary preload shim that redirects only that self-executable lookup to `/proc/self/exe`; it does not alter the Lean toolchain, project, dependencies, or proof.
apply patch
patch: completed
/tmp/lean-proc-self-shim.c
diff --git a//tmp/lean-proc-self-shim.c b//tmp/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..f702f2d49a46f01dd0f1a9fe11c494c456418187
--- /dev/null
+++ b//tmp/lean-proc-self-shim.c
@@ -0,0 +1,33 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static const char *normalize_proc_exe(const char *path) {
+  static const char prefix[] = "/proc/";
+  const char *cursor;
+
+  if (strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+    return path;
+  }
+
+  cursor = path + sizeof(prefix) - 1;
+  if (!isdigit((unsigned char)*cursor)) {
+    return path;
+  }
+  while (isdigit((unsigned char)*cursor)) {
+    ++cursor;
+  }
+  return strcmp(cursor, "/exe") == 0 ? "/proc/self/exe" : path;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  return syscall(SYS_readlink, normalize_proc_exe(path), buffer, size);
+}
+
+ssize_t readlinkat(int directory, const char *path, char *buffer, size_t size) {
+  return syscall(
+      SYS_readlinkat, directory, normalize_proc_exe(path), buffer, size);
+}
