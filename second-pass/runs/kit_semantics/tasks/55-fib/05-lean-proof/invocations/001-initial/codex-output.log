+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  return syscall(SYS_readlink, normalize_proc_exe(path), buffer, size);
+}
+
+ssize_t readlinkat(int directory, const char *path, char *buffer, size_t size) {
+  return syscall(
+      SYS_readlinkat, directory, normalize_proc_exe(path), buffer, size);
+}
