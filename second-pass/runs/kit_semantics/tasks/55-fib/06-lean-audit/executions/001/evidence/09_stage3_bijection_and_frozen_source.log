$ nl -ba /reference/k-proof/solution.py
     1	def fib(n: int):
     2	    a = 0
     3	    b = 1
     4	    while n > 0:
     5	        b = a + b
     6	        a = b - a
     7	        n = n - 1
     8	    return a
$ nl -ba /reference/k-proof/solution.mpy
     1	Module(
     2	  FuncDef("fib", Params("n"),
     3	    Assign(Name("a"), Int(0))
     4	    Assign(Name("b"), Int(1))
     5	    While(Compare(Name("n"), CmpOp(">", Int(0))),
     6	      Assign(Name("b"), BinOp("+", Name("a"), Name("b")))
     7	      Assign(Name("a"), BinOp("-", Name("b"), Name("a")))
     8	      Assign(Name("n"), BinOp("-", Name("n"), Int(1))))
     9	    Return(Name("a"))))
