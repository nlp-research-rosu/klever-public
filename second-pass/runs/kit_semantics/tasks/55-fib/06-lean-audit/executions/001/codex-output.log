    if isinstance(x, dict):
        print(path or '<root>', 'keys=', sorted(x))
        for k,v in x.items():
            p=f'{path}.{k}' if path else k
            if isinstance(v, dict): walk(v,p)
            elif isinstance(v,list):
                print(p, f'list(len={len(v)})')
                if v and len(v) <= 10 and all(not isinstance(i,(dict,list)) for i in v): print(' ', v)
            elif any(s in p.lower() for s in ('mode','problem','condition','path','status','image','producer','generator','sha256','tree')):
                print(p, '=', repr(v))
walk(obj)
PY
