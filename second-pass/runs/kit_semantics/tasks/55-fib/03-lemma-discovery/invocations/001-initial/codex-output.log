allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for i, (got, src) in enumerate(zip(out['rules'], canonical['rules'])):
    assert set(got) == {'source_rule_id', 'classification', 'rationale'}, (i, got.keys())
    assert got['source_rule_id'] == src['source_rule_id'], (i, got['source_rule_id'], src['source_rule_id'])
    assert got['classification'] in allowed
    assert isinstance(got['rationale'], str) and got['rationale'].strip()
    if 'simplification' in src.get('attributes', []):
        assert got['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
assert len({x['source_rule_id'] for x in out['rules']}) == len(canonical['rules'])
print('schema=valid')
print('inventory_sha256=match')
print('rule_count=' + str(len(out['rules'])))
print('order=match')
