allowed = {\"DEFINITION\", \"OPERATIONAL_RULE\", \"PROVED_DERIVED_LEMMA\", \"DOMAIN_LEMMA\"}
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
canonical_ids = [r['source_rule_id'] for r in inv['rules']]
output_ids = [r['source_rule_id'] for r in out['rules']]
assert output_ids == canonical_ids
assert len(output_ids) == len(set(output_ids))
for entry in out['rules']:
    assert list(entry.keys()) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
for source, entry in zip(inv['rules'], out['rules']):
    if 'simplification' in source.get('attributes', []):
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
verification_hash = hashlib.sha256(Path('/reference/k-proof/verification.k').read_bytes()).hexdigest()
assert verification_hash == inv['verification_sha256']
discovery = Path('/workspace/DISCOVERY.md').read_text()
assert 'There are no separately proved derived lemmas.' in discovery
assert 'The domain-lemma set is empty.' in discovery
print(f\"schema=PASS rules={len(output_ids)} unique={len(set(output_ids))}\")
print(f\"inventory_sha256={out['inventory_sha256']}\")
print(\"classifications=\" + json.dumps({c: sum(e['classification']==c for e in out['rules']) for c in sorted(allowed)}, sort_keys=True))
print(f\"verification_sha256={verification_hash}\")
