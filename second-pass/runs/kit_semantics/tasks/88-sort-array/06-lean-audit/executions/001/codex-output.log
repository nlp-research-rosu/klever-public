+#include <stdio.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  char proc[4096];
+  snprintf(proc, sizeof(proc), "/proc/%d/exe", getpid());
+  ssize_t n = readlink(proc, path, sizeof(path) - 1);
+  if (n < 0) {
+    perror("readlink");
+    return 1;
+  }
+  path[n] = '\0';
+  puts(path);
+  return 0;
+}
