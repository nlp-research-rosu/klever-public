codex
I isolated the tool failure: this sandbox exposes `/proc/self/exe` but not `/proc/<own-pid>/exe`; Lean 4.22’s runtime uses the latter to locate itself. I’m applying a narrowly scoped local compatibility shim under `/tmp/audit-work` that rewrites only that self-executable lookup. It does not alter or interpret any candidate/provenance input, and I’ll preserve the shim source and its use as evidence.
apply patch
patch: completed
/tmp/audit-work/lean-proc-self-shim.c
diff --git a//tmp/audit-work/apptest.c b//tmp/audit-work/apptest.c
new file mode 100644
index 0000000000000000000000000000000000000000..66ae4100760cf76fc6a9aa2d4923cb19ba04c893
--- /dev/null
+++ b//tmp/audit-work/apptest.c
@@ -0,0 +1,16 @@
+#include <stdio.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  char proc[4096];
+  snprintf(proc, sizeof(proc), "/proc/%d/exe", getpid());
+  ssize_t n = readlink(proc, path, sizeof(path) - 1);
+  if (n < 0) {
+    perror("readlink");
+    return 1;
+  }
+  path[n] = '\0';
+  puts(path);
+  return 0;
+}
diff --git a//tmp/audit-work/lean-proc-self-shim.c b//tmp/audit-work/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..88eebc702264aaab44788bbd7fa97a5ce42a8dd6
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,34 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    if (real_readlink == NULL) {
+      errno = ENOSYS;
+      return -1;
+    }
+  }
+
+  if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+    const char *cursor = path + 6;
+    if (*cursor >= '0' && *cursor <= '9') {
+      while (*cursor >= '0' && *cursor <= '9') {
+        cursor++;
+      }
+      if (strcmp(cursor, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+      }
+    }
+  }
+
+  return real_readlink(path, buffer, size);
+}

