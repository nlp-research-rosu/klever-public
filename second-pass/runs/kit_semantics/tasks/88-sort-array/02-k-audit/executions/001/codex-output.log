+                    CmpOp("==", Int(0)))))) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      (0 |-> list(vCons(0, vCons(2, .ValSeq))))
+      =>
+      (0 |-> list(vCons(0, vCons(2, .ValSeq)))
