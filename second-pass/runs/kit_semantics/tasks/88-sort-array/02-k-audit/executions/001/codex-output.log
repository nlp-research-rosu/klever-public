+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      (0 |-> list(vCons(0, vCons(2, .ValSeq))))
+      =>
+      (0 |-> list(vCons(0, vCons(2, .ValSeq)))
+       1 |-> list(vCons(0, vCons(2, .ValSeq))))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
