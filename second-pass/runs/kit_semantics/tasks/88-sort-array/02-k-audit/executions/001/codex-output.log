+++ b/evidence/concrete_cases.py
@@ -0,0 +1,21 @@
+def sort_array(array):
+    if not array:
+        return sorted(array)
+    return sorted(
+        array,
+        reverse=(array[0] + array[-1]) % 2 == 0,
+    )
+
+
+assert sort_array([]) == []
+assert sort_array([5]) == [5]
+assert sort_array([2, 4, 3, 0, 1, 5]) == [0, 1, 2, 3, 4, 5]
+assert sort_array([2, 4, 3, 0, 1, 5, 6]) == [6, 5, 4, 3, 2, 1, 0]
+assert sort_array([0, 1]) == [0, 1]
+assert sort_array([1, 1]) == [1, 1]
+assert sort_array([3, 1, 2, 1]) == [3, 2, 1, 1]
+
+original = [2, 4, 3, 0, 1, 5, 6]
+result = sort_array(original)
+assert original == [2, 4, 3, 0, 1, 5, 6]
+assert result == [6, 5, 4, 3, 2, 1, 0]

exec
/bin/bash -lc "set -o pipefail
{
  printf '%s\\n' 'COMMAND: kast solution.mpy --definition fresh-verification-kompiled --output json --output-file solution-kast.json'
  kast solution.mpy --definition fresh-verification-kompiled --output json --output-file solution-kast.json
  kast_status="'$?
  printf '"'KAST_EXIT %s\\n' \""'$kast_status"
  printf '"'%s\\n' 'COMMAND: kprove spec.k --definition fresh-verification-kompiled --spec-module SPEC --dry-run --emit-json-spec spec-all.json'
  kprove spec.k --definition fresh-verification-kompiled --spec-module SPEC --dry-run --emit-json-spec spec-all.json
  dry_status="'$?
  printf '"'DRY_RUN_EXIT %s\\n' \""'$dry_status"
  printf '"'%s\\n' 'COMMAND: python3 /audit-output/evidence/audit_pinning.py'
