new file mode 100644
index 0000000000000000000000000000000000000000..18c2e6d65ac0c6e514fb96000f8b655dfc775b96
--- /dev/null
+++ b/evidence/spec-audit-false.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module AUDIT-FALSE-SPEC
+  imports VERIFICATION
+
+  // Fresh auditor mutation: [0, 2] has even endpoint sum and therefore
+  // returns [2, 0]. This deliberately false destination demands [0, 2].
+  claim [audit-false-even-branch]:
+    <k> Call(Name("sort_array"), ref(0)) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "sort_array" |->
+          closureVal(
+            "array",
+            If(
+              UnaryOp("not", Name("array")),
+              Return(Call(Name("sorted"), Name("array"))) .Stmts,
+              .Stmts)
+            Return(
+              Call(
+                Name("sorted"),
+                Name("array"),
+                KwArg(
+                  "reverse",
+                  Compare(
+                    BinOp(
+                      "%",
+                      BinOp(
+                        "+",
+                        Subscript(Name("array"), Int(0)),
+                        Subscript(Name("array"), UnaryOp("-", Int(1)))),
+                      Int(2)),
+                    CmpOp("==", Int(0)))))) .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      (0 |-> list(vCons(0, vCons(2, .ValSeq))))
+      =>
+      (0 |-> list(vCons(0, vCons(2, .ValSeq)))
+       1 |-> list(vCons(0, vCons(2, .ValSeq))))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

exec
/bin/bash -lc 'set -o pipefail
python3 /audit-output/evidence/audit_k_differential.py 2>&1 | tee /audit-output/evidence/stage7-k-differential.log
status=${PIPESTATUS[0]}
printf '"'COMMAND_EXIT audit_k_differential.py %s\\n' \""'$status" | tee -a /audit-output/evidence/stage7-k-differential.log
exit "$status"' in /tmp/audit-work/reconstruction
