kompile --backend haskell verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition fresh-verification-kompiled 2>&1 | tee /audit-output/evidence/stage3-kompile-haskell.log
status=${PIPESTATUS[0]}
printf '"'COMMAND_EXIT kompile_haskell %s\\n' \""'$status" | tee -a /audit-output/evidence/stage3-kompile-haskell.log
exit "$status"' in /tmp/audit-work/reconstruction
