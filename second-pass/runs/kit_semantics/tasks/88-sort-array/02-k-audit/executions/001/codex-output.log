+    print(
+        f"TRACE_OK files={len(list(trace_root.rglob('*.jsonl')))} "
+        f"lines={trace_lines} pipeline_sha256={trace_digest}"
+    )
+
+    print("INTEGRITY_RESULT PASS")
+
+
+if __name__ == "__main__":
+    main()
