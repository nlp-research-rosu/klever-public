Module(
  FuncDef("_column_desc", Params("coordinate"),
    Return(UnaryOp("-", Subscript(Name("coordinate"), Int(1)))))
  FuncDef("_row_asc", Params("coordinate"),
    Return(Subscript(Name("coordinate"), Int(0))))
  FuncDef("get_row", Params("lst", "x"),
    Assign(Name("coordinates"), ListExpr())
    Assign(Name("row_index"), Int(0))
    Assign(Name("row"), NoneVal)
    Assign(Name("column_index"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("row"), Name("lst"),
      Assign(Name("column_index"), Int(0))
      Assign(Name("value"), Int(0))
      For(Name("value"), Name("row"),
        If(Compare(Name("value"), CmpOp("in", TupleExpr(Name("x")))),
          Expr(
            Call(
              Attribute(Name("coordinates"), "append"),
              TupleExpr(Name("row_index"), Name("column_index")))),
          )
        AugAssign(Name("column_index"), "+", Int(1)))
      AugAssign(Name("row_index"), "+", Int(1)))
    Assign(
      Name("coordinates"),
      Call(
        Name("sorted"),
        Name("coordinates"),
        KwArg("key", Name("_column_desc"))))
    Return(
      Call(
        Name("sorted"),
        Name("coordinates"),
        KwArg("key", Name("_row_asc"))))))
