#!/usr/bin/env bash
set -euo pipefail

expect_failure() {
  local label="$1"
  shift

  set +e
  "$@"
  local status=$?
  set -e

  if [[ $status -eq 0 ]]; then
    echo "UNEXPECTED SUCCESS: $label"
    exit 1
  fi
  echo "EXPECTED FAILURE: $label (exit $status)"
}

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py smoke.py > smoke.mpy
python3 -m py_compile solution.py smoke.py differential_test.py
python3 smoke.py
python3 differential_test.py

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun smoke.mpy --definition runtime-kompiled > krun-smoke.out
rg -q '^    \.K$' krun-smoke.out

kompile --backend haskell shape-connection.k \
  --main-module SHAPE-CONNECTION \
  --syntax-module ROW-MODEL-SYNTAX \
  --output-definition shape-connection-kompiled
kprove shape-connection-spec.k \
  --definition shape-connection-kompiled \
  --spec-module SHAPE-CONNECTION-SPEC

kompile --backend haskell verification.k \
  --main-module VERIFICATION \
  --syntax-module VERIFICATION-SYNTAX \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

kompile --backend haskell mutation.k \
  --main-module MUTATION \
  --syntax-module MUTATION-SYNTAX \
  --output-definition mutation-kompiled

expect_failure "wrong returned reference" \
  kprove spec-vacuity.k \
    --definition verification-kompiled \
    --spec-module SPEC-VACUITY
expect_failure "coordinate-append body mutation" \
  kprove spec-body-mutation.k \
    --definition mutation-kompiled \
    --spec-module SPEC-BODY-MUTATION
expect_failure "incorrect For bridge result" \
  kprove shape-connection-bad-spec.k \
    --definition shape-connection-kompiled \
    --spec-module SHAPE-CONNECTION-BAD-SPEC

echo "All positive proofs passed and all negative probes failed as expected."
requires "row-model.k"

module VERIFICATION-SYNTAX
  imports ROW-MODEL-SYNTAX

  syntax ValSeq ::= scanAppend(ValSeq, ValSeq, Int, Int, Int) [function, total]
                  | rowsAppend(ValSeq, ValSeq, Int, Int) [function]
  syntax Int ::= advanceIndex(Int, ValSeq) [function, total]

  syntax Stmts ::= "INNERBODY"  [macro]
                 | "OUTERBODY"  [macro]
                 | "GETROWBODY" [macro]
  syntax Val ::= "COLUMNCLOSURE" [macro]
               | "ROWCLOSURE"    [macro]
endmodule

module VERIFICATION
  imports ROW-MODEL
  imports VERIFICATION-SYNTAX

  rule <k> For(T:Expr, V:Val, B:Stmts)
        => #loop(list(rowContents(V)), T, B) ... </k>
       requires V ==K list(rowContents(V))
       [priority(40)]

  rule advanceIndex(I:Int, .ValSeq) => I
  rule advanceIndex(I:Int, vCons(_:Val, VS:ValSeq))
    => advanceIndex(I +Int 1, VS)

  rule scanAppend(ACC:ValSeq, .ValSeq, _:Int, _:Int, _:Int) => ACC
  rule scanAppend(ACC:ValSeq, vCons(V:Val, VS:ValSeq),
                  X:Int, RI:Int, CI:Int)
    => scanAppend(
         valSeqConcat(
           ACC,
           vCons(tuple(vCons(RI, vCons(CI, .ValSeq))), .ValSeq)),
         VS, X, RI, CI +Int 1)
    requires V ==K X
    [simplification]
  rule scanAppend(ACC:ValSeq, vCons(V:Val, VS:ValSeq),
                  X:Int, RI:Int, CI:Int)
    => scanAppend(ACC, VS, X, RI, CI +Int 1)
    requires notBool (V ==K X)
    [simplification]

  rule rowsAppend(ACC:ValSeq, .ValSeq, _:Int, _:Int) => ACC
  rule rowsAppend(ACC:ValSeq,
                  vCons(V:Val, RS:ValSeq),
                  X:Int, RI:Int)
    => rowsAppend(scanAppend(ACC, rowContents(V), X, RI, 0),
                  RS, X, RI +Int 1)
    requires V ==K list(rowContents(V))
    [simplification]

  rule INNERBODY
    => If(Compare(Name("value"),
                  CmpOp("in", TupleExpr((Name("x"), .Exprs)))),
          Expr(Call(Attribute(Name("coordinates"), "append"),
                    (TupleExpr((Name("row_index"), Name("column_index"), .Exprs)),
                     .Exprs)))
          .Stmts,
          .Stmts)
       AugAssign(Name("column_index"), "+", Int(1))
       .Stmts

  rule OUTERBODY
    => Assign(Name("column_index"), Int(0))
       Assign(Name("value"), Int(0))
       For(Name("value"), Name("row"), INNERBODY)
       AugAssign(Name("row_index"), "+", Int(1))
       .Stmts

  rule GETROWBODY
    => Assign(Name("coordinates"), ListExpr(.Exprs))
       Assign(Name("row_index"), Int(0))
       Assign(Name("row"), NoneVal)
       Assign(Name("column_index"), Int(0))
       Assign(Name("value"), Int(0))
       For(Name("row"), Name("lst"), OUTERBODY)
       Assign(Name("coordinates"),
              Call(Name("sorted"),
                   (Name("coordinates"),
                    KwArg("key", Name("_column_desc")),
                    .Exprs)))
       Return(Call(Name("sorted"),
                   (Name("coordinates"),
                    KwArg("key", Name("_row_asc")),
                    .Exprs)))
       .Stmts

  rule COLUMNCLOSURE
    => closureVal(("coordinate", .ParamNames),
                  Return(UnaryOp("-", Subscript(Name("coordinate"), Int(1))))
                  .Stmts,
                  0)

  rule ROWCLOSURE
    => closureVal(("coordinate", .ParamNames),
                  Return(Subscript(Name("coordinate"), Int(0)))
                  .Stmts,
                  0)
endmodule
requires "reference-semantics/semantics.k"

module ROW-MODEL-SYNTAX
  imports MPY-CORE

  syntax ValSeq ::= rowContents(Val) [function, total]
  syntax Bool ::= listRows(ValSeq) [function, total]
endmodule

module ROW-MODEL
  imports MPY
  imports ROW-MODEL-SYNTAX

  rule rowContents(list(VS:ValSeq)) => VS
  rule rowContents(_:Val) => .ValSeq [owise]

  rule listRows(.ValSeq) => true
  rule listRows(vCons(V:Val, VS:ValSeq))
    => (V ==K list(rowContents(V))) andBool listRows(VS)
endmodule
requires "row-model.k"

module SHAPE-CONNECTION
  imports ROW-MODEL
endmodule
requires "shape-connection.k"

module SHAPE-CONNECTION-SPEC
  imports SHAPE-CONNECTION

  claim [for-list-shape]:
    <k> For(T:Expr, V:Val, B:Stmts)
        => #loop(list(rowContents(V)), T, B) ... </k>
    requires V ==K list(rowContents(V))
endmodule
