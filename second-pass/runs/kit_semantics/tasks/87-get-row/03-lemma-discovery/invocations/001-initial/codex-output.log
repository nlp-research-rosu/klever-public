import json
from collections import Counter
from pathlib import Path
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
expected_ids = [r['source_rule_id'] for r in inv['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids))
for src, entry in zip(inv['rules'], out['rules']):
    assert list(entry) == ['source_rule_id', 'classification', 'rationale'], entry
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
    if 'simplification' in src.get('attributes', []):
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}, entry
counts = Counter(e['classification'] for e in out['rules'])
print('VALID schema_version=2')
print('VALID inventory_sha256=' + out['inventory_sha256'])
print('VALID ordered_unique_coverage=' + str(len(actual_ids)))
print('VALID exact_entry_keys_and_nonempty_rationales')
print('VALID simplification_constraint')
for k in sorted(allowed):
    print(k, counts[k])
