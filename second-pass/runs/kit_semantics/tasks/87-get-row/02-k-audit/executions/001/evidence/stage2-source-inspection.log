     6	def get_row(lst, x):
     7	    """
     8	    You are given a 2 dimensional data, as a nested lists,
     9	    which is similar to matrix, however, unlike matrices,
    10	    each row may contain a different number of columns.
    11	    Given lst, and integer x, find integers x in the list,
    12	    and return list of tuples, [(x1, y1), (x2, y2) ...] such that
    13	    each tuple is a coordinate - (row, columns), starting with 0.
    14	    Sort coordinates initially by rows in ascending order.
    15	    Also, sort coordinates of the row by columns in descending order.
    16	    
    17	    Examples:
    18	    get_row([
    19	      [1,2,3,4,5,6],
    20	      [1,2,3,4,1,6],
    21	      [1,2,3,4,5,1]
    22	    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]
    23	    get_row([], 1) == []
    24	    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]
    25	    """
    26	    coords = [(i, j) for i in range(len(lst)) for j in range(len(lst[i])) if lst[i][j] == x]
    27	    return sorted(sorted(coords, key=lambda x: x[1], reverse=True), key=lambda x: x[0])
