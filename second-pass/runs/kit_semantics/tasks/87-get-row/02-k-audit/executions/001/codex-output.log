+        "_column_desc" |-> COLUMNCLOSURE
+        "_row_asc" |-> ROWCLOSURE
+        "get_row" |-> closureVal(("lst", "x", .ParamNames),
+                                  GETROWBODY,
+                                  0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(rowsAppend(
+                      .ValSeq,
+                      vCons(list(vCons(5, vCons(5, .ValSeq))), .ValSeq),
+                      5,
+                      0))
+         1 |-> list(sortKeyVS(
+                      rowsAppend(
+                        .ValSeq,
+                        vCons(list(vCons(5, vCons(5, .ValSeq))), .ValSeq),
+                        5,
+                        0),
+                      COLUMNCLOSURE))
+         2 |-> list(sortKeyVS(
+                      sortKeyVS(
+                        rowsAppend(
+                          .ValSeq,
