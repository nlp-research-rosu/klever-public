     coordinates = sorted(coordinates, key=_column_desc)
     return sorted(coordinates, key=_row_asc)
+
+
+assert get_row([], 1) == []
+assert get_row([[]], 0) == []
+assert get_row([[0]], 0) == [(0, 0)]
+assert get_row([[0]], 1) == []
+assert get_row([[1, 1, 1]], 1) == [(0, 2), (0, 1), (0, 0)]
+assert get_row([[2, 1, 2], [2], [1, 2, 1, 2]], 2) == [
+    (0, 2),
+    (0, 0),
+    (1, 0),
+    (2, 3),
+    (2, 1),
+]
