+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(rowsAppend(
+                      .ValSeq,
+                      vCons(list(vCons(5, vCons(5, .ValSeq))), .ValSeq),
+                      5,
