new file mode 100644
index 0000000000000000000000000000000000000000..7e31c5522de82215629b2f5731df82d79c4f89ba
--- /dev/null
+++ b/evidence/record-command.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf 'EXIT STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee -a "$log_file"
+
+exit "${PIPESTATUS[0]}"
