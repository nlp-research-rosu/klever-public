+        for matrix_tuple in itertools.product(rows, repeat=row_count):
+            matrix = [list(row) for row in matrix_tuple]
+            for x in (-1, 0, 1, 2):
+                run_case(
+                    f"exhaustive-{exhaustive_count}",
+                    matrix,
+                    x,
+                    canonical,
+                    generated,
+                )
+                exhaustive_count += 1
+                count += 1
+
+    rng = random.Random(870087)
