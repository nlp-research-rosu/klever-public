===== prove.sh =====
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	expect_failure() {
     5	  local label="$1"
     6	  shift
     7	
     8	  set +e
     9	  "$@"
    10	  local status=$?
    11	  set -e
    12	
    13	  if [[ $status -eq 0 ]]; then
    14	    echo "UNEXPECTED SUCCESS: $label"
    15	    exit 1
    16	  fi
    17	  echo "EXPECTED FAILURE: $label (exit $status)"
    18	}
    19	
    20	python3 py2mpy.py solution.py > solution.mpy
    21	python3 py2mpy.py smoke.py > smoke.mpy
    22	python3 -m py_compile solution.py smoke.py differential_test.py
    23	python3 smoke.py
    24	python3 differential_test.py
    25	
    26	kompile reference-semantics/semantics.k \
    27	  --backend llvm \
    28	  --main-module MPY-KRUN \
    29	  --syntax-module MPY-SYNTAX \
    30	  --output-definition runtime-kompiled
    31	krun smoke.mpy --definition runtime-kompiled > krun-smoke.out
    32	rg -q '^    \.K$' krun-smoke.out
    33	
    34	kompile --backend haskell shape-connection.k \
