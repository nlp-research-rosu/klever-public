    44	  --syntax-module VERIFICATION-SYNTAX \
    45	  --output-definition verification-kompiled
    46	kprove spec.k \
    47	  --definition verification-kompiled \
    48	  --spec-module SPEC
    49	
    50	kompile --backend haskell mutation.k \
    51	  --main-module MUTATION \
    52	  --syntax-module MUTATION-SYNTAX \
    53	  --output-definition mutation-kompiled
    54	
    55	expect_failure "wrong returned reference" \
    56	  kprove spec-vacuity.k \
    57	    --definition verification-kompiled \
    58	    --spec-module SPEC-VACUITY
    59	expect_failure "coordinate-append body mutation" \
