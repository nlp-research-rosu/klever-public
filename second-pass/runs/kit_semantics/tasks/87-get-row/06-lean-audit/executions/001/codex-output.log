### /reference/k-proof/solution.py:1-25
    1	def _column_desc(coordinate):
    2	    return -coordinate[1]
    3	
    4	
    5	def _row_asc(coordinate):
    6	    return coordinate[0]
    7	
    8	
    9	def get_row(lst, x):
   10	    coordinates = []
   11	    row_index = 0
   12	    row = None
   13	    column_index = 0
   14	    value = 0
   15	    for row in lst:
   16	        column_index = 0
   17	        value = 0
   18	        for value in row:
   19	            if value in (x,):
   20	                coordinates.append((row_index, column_index))
   21	            column_index += 1
   22	        row_index += 1
   23	
   24	    coordinates = sorted(coordinates, key=_column_desc)
   25	    return sorted(coordinates, key=_row_asc)
