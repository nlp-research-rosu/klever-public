+            raise RuntimeError(f"symlink in immutable tree: {path}")
+        if path.is_file():
+            result[path.relative_to(root).as_posix()] = sha256_file(path)
+        elif not path.is_dir():
+            raise RuntimeError(f"unsupported entry in immutable tree: {path}")
+    return result
