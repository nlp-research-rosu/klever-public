+    for rule in inventory["rules"]:
+        source_slice = "\n".join(
+            verification_lines[rule["start_line"] - 1 : rule["end_line"]]
+        ).rstrip(" \t\r\n")
+        normalized = " ".join(source_slice.split())
+        normalized_sha256 = hashlib.sha256(normalized.encode()).hexdigest()
