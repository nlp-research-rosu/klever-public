+{
+  "schema_version": 1,
+  "inventory_sha256": "341c239f750211e8fd0165f2fec51a0237792c9f2ecb13194dc5a1c10de5135c",
+  "rules": [
+    {
+      "source_rule_id": "rule-884ba37529d334ff1536a797b79c37b0c1aec1517e50018bbcdd7e37dc667f49",
+      "classification": "PROVED_DERIVED_LEMMA",
+      "judgment": "The rule is an exact derived one-step For rewrite, not an assumed domain fact. SHAPE-CONNECTION-SPEC.for-list-shape has the identical LHS, RHS, arbitrary continuation, framed cells, and guard; SHAPE-CONNECTION imports ROW-MODEL and fixed MPY but not VERIFICATION. prove.sh proves that claim before compiling VERIFICATION and its proof log records the first #Top before the later verification #Top. The fixed rule For(T, OBJ, B) => #loop(OBJ,T,B), together with V ==K list(rowContents(V)), yields exactly the installed RHS."
+    },
+    {
+      "source_rule_id": "rule-61639aeb3e4eded394e1d4b26f9ee1295448bf3ece5ac65e09a909061f5802ed",
+      "classification": "DEFINITION",
+      "judgment": "Base equation for the named structural recurrence advanceIndex; it returns the accumulator on the empty sequence and states no source-result property."
+    },
+    {
+      "source_rule_id": "rule-66ce320138cf211431fb75578ddb97ab1ae42b0641cbe44f60c87c594342d78b",
+      "classification": "DEFINITION",
+      "judgment": "Cons equation for advanceIndex; it increments once and structurally descends on the tail, exactly summarizing one completed loop iteration."
+    },
+    {
+      "source_rule_id": "rule-c194ab0b0d5b805678184ae23956c929962cbe0d80d58f6329b819af01736b5b",
+      "classification": "DEFINITION",
+      "judgment": "Base equation for the named scanAppend summary; an empty row preserves the accumulator."
+    },
+    {
+      "source_rule_id": "rule-f34eeff932b7abe8c16eabf63b849ff14abedadb470e8cc2afef3c5432725a54",
+      "classification": "DEFINITION",
+      "judgment": "Guarded matching case of the scanAppend recurrence. It appends the current (row,column) coordinate, increments the column, and descends on the row tail, matching the fixed membership, append, and AugAssign semantics. Its simplification attribute is therefore attached to a definition, not a domain lemma."
+    },
+    {
+      "source_rule_id": "rule-4e4b59f2ee8e8937c5779283b3c612d56db07d5a6665f7d3c5cd3081cfe4c1ff",
+      "classification": "DEFINITION",
+      "judgment": "Complementary nonmatching case of scanAppend. The guard is the Boolean complement of equality; it omits the append, increments the column, and descends. Its simplification attribute is attached to a definition."
+    },
+    {
+      "source_rule_id": "rule-4812be0f87480004ec1d88555dc42724de85607ba560b55f59cc783b411b4b54",
+      "classification": "DEFINITION",
+      "judgment": "Base equation for the named rowsAppend summary; an empty row sequence preserves the accumulator."
+    },
+    {
+      "source_rule_id": "rule-ca82d2906a1a64f2f30d91c523b1da3a97bdc91d39bf996607ba4b0eb8dedf1f",
+      "classification": "DEFINITION",
+      "judgment": "Guarded cons equation for rowsAppend. For a list-shaped row it invokes the already defined per-row scan at column zero, increments the row index, and structurally descends. The listRows precondition covers every proof use. Its simplification attribute is attached to a definition."
+    },
+    {
+      "source_rule_id": "rule-513effea58452b129f11e969f69b8b1ba4753f0475e7adccd0435ef28aa12dc3",
+      "classification": "DEFINITION",
+      "judgment": "Macro equation naming the exact inner-loop source AST, including membership, append, and column increment; it is a named proof term rather than a result property."
+    },
+    {
+      "source_rule_id": "rule-a5d752033c107eb7ed24b3bd20619e493bc116b42cee0b9c358ddef4a7846bce",
+      "classification": "DEFINITION",
+      "judgment": "Macro equation naming the exact outer-loop source AST, including resets, inner loop, and row increment."
+    },
+    {
+      "source_rule_id": "rule-f1c7c2f7e079aec7d74121119086f5ce9b88d758dc886ab637c02f5d1a3efff4",
+      "classification": "DEFINITION",
+      "judgment": "Macro equation naming the exact get_row body AST, including both source sort calls and return."
+    },
+    {
+      "source_rule_id": "rule-f673c7a1de0fb731d8b8b9003d5b2dc47528b1ed6b2c77eea115e579be27e7f5",
+      "classification": "DEFINITION",
+      "judgment": "Named closure value for the exact _column_desc proof term, with parameter, body, and defining environment."
