   h.update(csep.join(comps)+rsep)
  if h.digest()==target:
   print('MATCH',include_dirs,path_style,kind_style,mode_style,size_style,data_style,repr(csep),repr(rsep));raise SystemExit
print('no match')
PY" in /audit-output
