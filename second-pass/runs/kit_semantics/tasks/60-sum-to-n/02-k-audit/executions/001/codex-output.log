import hashlib,itertools,stat
root=Path('/reference/reference-semantics'); target=bytes.fromhex('1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de')
allents=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
seps=[b'',b'\\0',b'\\n',b' ',b':']
for include_dirs in [False,True]:
 ents=allents if include_dirs else [p for p in allents if p.is_file()]
 for path_style,kind_style,mode_style,size_style,data_style,csep,rsep in itertools.product(range(3),range(4),range(4),range(4),range(4),seps,seps):
  h=hashlib.sha256()
  for p in ents:
   rel=p.relative_to(root).as_posix()
   if path_style==1: rel='./'+rel
   if path_style==2 and p.is_dir(): rel=rel+'/'
   comps=[rel.encode()]
   if kind_style==1: comps.append((b'directory' if p.is_dir() else b'file'))
   elif kind_style==2: comps.append((b'dir' if p.is_dir() else b'file'))
