  echo '"'COMMAND: kompile reference-semantics/semantics.k --backend llvm --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition runtime-kompiled'
  kompile reference-semantics/semantics.k --backend llvm --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition runtime-kompiled
  rc="'$?
  echo "LLVM_KOMPILE_EXIT_STATUS: $rc"
} 2>&1 | tee /audit-output/evidence/stage3_llvm_build.log
exit ${PIPESTATUS[0]}' in /tmp/audit-work/reconstruction
