  echo "DRY_RUN_EXIT_STATUS: $rc"
} 2>&1 | tee /audit-output/evidence/stage5_body_sensitivity_dry_run.log
exit ${PIPESTATUS[0]}' in /tmp/audit-work/reconstruction
