   if mode_style==1: comps.append(oct(p.lstat().st_mode & 0o777).encode())
   elif mode_style==2: comps.append(str(p.lstat().st_mode & 0o777).encode())
   elif mode_style==3: comps.append((p.lstat().st_mode & 0o777).to_bytes(4,'big'))
   if size_style==1: comps.append(str(p.stat().st_size if p.is_file() else 0).encode())
   elif size_style==2: comps.append((p.stat().st_size if p.is_file() else 0).to_bytes(8,'big'))
   elif size_style==3 and p.is_file(): comps.append(str(p.stat().st_size).encode())
   if p.is_file():
