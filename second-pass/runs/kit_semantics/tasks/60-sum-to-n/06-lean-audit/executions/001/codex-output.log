  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0

  syntax Int ::= pyMod(Int, Int) [function]
  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2

  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
endmodule

diff --git a//tmp/audit-work/check_sum_summary.py b//tmp/audit-work/check_sum_summary.py
new file mode 100644
index 0000000000000000000000000000000000000000..38d5630b153fcdd5912175a840b577c211a641db
--- /dev/null
+++ b//tmp/audit-work/check_sum_summary.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+
+
+def summary(n: int) -> int:
+    return n * (n + 1) // 2 if n >= 0 else 0
+
+
+def source(n: int) -> int:
+    total = 0
+    while n > 0:
+        total += n
+        n -= 1
+    return total
+
+
+witnesses = [-100, -3, -1, 0, 1, 2, 5, 10, 30, 100]
+print("witnesses=", [(n, source(n), summary(n)) for n in witnesses])
+print("witness_mismatches=", [n for n in witnesses if source(n) != summary(n)])
+print(
+    "recurrence_mismatches=",
+    [n for n in range(1, 1001) if summary(n) != n + summary(n - 1)],
+)
+
+# Counterfactual operational mutations should not implement the frozen summary.
+def increment_mutation(n: int) -> int:
+    total = 0
+    while n > 0:
+        total += n + 1
+        n -= 1
+    return total
+
+
+def decrement_mutation(n: int) -> int:
+    total = 0
+    while n > 0:
+        total += n
+        n -= 2
+    return total
+
+
+print("increment_mutation_n5=", increment_mutation(5), "expected_summary=", summary(5))
+print("decrement_mutation_n5=", decrement_mutation(5), "expected_summary=", summary(5))
diff --git a//tmp/audit-work/proc_visible_getpid.c b//tmp/audit-work/proc_visible_getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..899dc6bdc55fc2370ee8444d3a85690d2b68c1f0
--- /dev/null
+++ b//tmp/audit-work/proc_visible_getpid.c
@@ -0,0 +1,35 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit command sandbox exposes /proc/self but not /proc/<namespace-pid>.
+ * Lean 4.22 resolves its executable through /proc/<getpid()>/exe.  Return the
+ * proc-visible numeric target of /proc/self so that lookup reaches the same
+ * executable.  This shim is loaded only for the independent preflight build.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t count = readlink("/proc/self", target, sizeof(target) - 1);
+    long value = 0;
+
+    if (count <= 0 || count >= (ssize_t)sizeof(target)) {
+        return (pid_t)1;
+    }
+    target[count] = '\0';
+    for (ssize_t index = 0; index < count; ++index) {
+        if (target[index] < '0' || target[index] > '9') {
+            errno = EINVAL;
+            return (pid_t)1;
+        }
+        value = value * 10 + (target[index] - '0');
+        if (value > INT_MAX) {
+            errno = ERANGE;
+            return (pid_t)1;
+        }
+    }
+    return (pid_t)value;
+}
diff --git a//tmp/audit-work/verify_audit_hashes.py b//tmp/audit-work/verify_audit_hashes.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc5d80365e333684659a957c27f9bc846c229f92
--- /dev/null
+++ b//tmp/audit-work/verify_audit_hashes.py
@@ -0,0 +1,188 @@
+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import klean_export, lemma_discovery_contract, pipeline_contract
+
+
+def read_json(path: Path):
+    return json.loads(path.read_text())
+
+
+def file_sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def emit(label: str, observed, expected) -> None:
+    print(f"{label}: {'MATCH' if observed == expected else 'MISMATCH'}")
+    print(f"  observed={json.dumps(observed, sort_keys=True)}")
+    print(f"  expected={json.dumps(expected, sort_keys=True)}")
+
+
+audit = read_json(Path("/audit-input.json"))["resolution"]
+hashes = audit["hashes"]
+generator_dir = Path("/reference/klean-generation")
+generated = generator_dir / "generated"
+generator = read_json(generator_dir / "generator-manifest.json")
+input_manifest = read_json(generator_dir / "input-manifest.json")
+export_result = read_json(generator_dir / "export-result.json")
+recorded_preflight = read_json(generator_dir / "preflight.json")
+trust_inventory = generator_dir / "trust-inventory.json"
+obligation_map_path = generated / "obligation-map.json"
+obligation_map = read_json(obligation_map_path)
+source_manifest = read_json(Path("/reference/generation-tools/source-manifest.json"))
+toolchain_lock = read_json(Path("/reference/klean-toolchain.lock.json"))
+
+emit(
+    "audit k_workspace_sha256",
+    pipeline_contract.sha256_tree(Path("/reference/k-proof")),
+    hashes["k_workspace_sha256"],
+)
+emit(
+    "audit stage1_export_sha256",
+    klean_export.tree_digest(Path("/reference/k-proof")),
+    hashes["stage1_export_sha256"],
+)
+emit(
+    "audit discovery_manifest_sha256",
+    file_sha(Path("/reference/lemma-discovery.json")),
+    hashes["discovery_manifest_sha256"],
+)
+emit(
+    "audit k_audit_sha256",
+    pipeline_contract.sha256_tree(Path("/reference/k-audit")),
+    hashes["k_audit_sha256"],
+)
+emit(
+    "audit klean_generation_sha256",
+    pipeline_contract.sha256_tree(generator_dir),
+    hashes["klean_generation_sha256"],
+)
+emit(
+    "audit generation_producer_sources_sha256",
+    pipeline_contract.sha256_tree(Path("/reference/generation-tools")),
+    hashes["generation_producer_sources_sha256"],
+)
+emit(
+    "audit generated_tree_sha256",
+    klean_export.tree_digest(generated),
+    hashes["generated_tree_sha256"],
+)
+emit("audit lean_workspace_sha256", None, hashes["lean_workspace_sha256"])
+emit("audit lean_invocation_sha256", None, hashes["lean_invocation_sha256"])
+
+expected_source_hashes = audit["stage1_source_hashes"]
+observed_source_hashes = {
+    path.relative_to(Path("/reference/k-proof")).as_posix(): file_sha(path)
+    for path in pipeline_contract._walk_regular_files(
+        Path("/reference/k-proof"), "Stage 1 source workspace"
+    )
+}
+print(f"stage1_source_hash_count_observed={len(observed_source_hashes)}")
+print(f"stage1_source_hash_count_expected={len(expected_source_hashes)}")
+print(
+    "stage1_source_hash_missing="
+    + json.dumps(sorted(set(expected_source_hashes) - set(observed_source_hashes)))
+)
+print(
+    "stage1_source_hash_extra="
+    + json.dumps(sorted(set(observed_source_hashes) - set(expected_source_hashes)))
+)
+print(
+    "stage1_source_hash_mismatches="
+    + json.dumps(
+        sorted(
+            name
+            for name in set(observed_source_hashes) & set(expected_source_hashes)
+            if observed_source_hashes[name] != expected_source_hashes[name]
+        )
+    )
+)
+
+producer_hashes = {
+    name: file_sha(Path("/reference/generation-tools") / name)
+    for name in ("klean_export.py", "klean.py")
+}
+emit("producer source-manifest file map", producer_hashes, source_manifest["files"])
+emit("producer exporter hash", producer_hashes["klean_export.py"], generator["exporter_sha256"])
+emit("producer klean.py hash", producer_hashes["klean.py"], generator["klean_py_sha256"])
+emit(
+    "producer generator image ID across manifests",
+    source_manifest["generator_image_id"],
+    generator["provenance"]["generator_image_id"],
+)
+emit(
+    "producer generator image ID against audit bundle path",
+    source_manifest["generator_image_id"].removeprefix("sha256:"),
+    Path(audit["generation_producer_sources"]).name,
+)
+emit(
+    "producer bundle file set",
+    sorted(path.name for path in Path("/reference/generation-tools").iterdir()),
+    ["klean.py", "klean_export.py", "source-manifest.json"],
+)
+
+emit("generator toolchain lock", generator["toolchain"], toolchain_lock)
+emit("generator generated tree", generator["generated_tree_sha256"], hashes["generated_tree_sha256"])
+emit(
+    "generator Stage 1 provenance",
+    generator["provenance"]["stage1_workspace_sha256"],
+    hashes["stage1_export_sha256"],
+)
+emit(
+    "generator Stage 3 provenance",
+    generator["provenance"]["stage3_discovery_manifest_sha256"],
+    hashes["discovery_manifest_sha256"],
+)
+emit(
+    "generator obligation-map hash",
+    generator["obligation_map_sha256"],
+    file_sha(obligation_map_path),
+)
+emit(
+    "export trust-inventory hash",
+    export_result["trust_inventory_sha256"],
+    file_sha(trust_inventory),
+)
+
+validated = lemma_discovery_contract.validate_trust_boundary(
+    Path("/reference/k-proof"), Path("/reference/lemma-discovery.json")
+)
+emit("input-manifest inventory hash", input_manifest["inventory_sha256"], validated["inventory_sha256"])
+emit("generator inventory provenance", generator["provenance"]["inventory_sha256"], validated["inventory_sha256"])
+emit("input-manifest verification hash", input_manifest["verification_sha256"], validated["verification_sha256"])
+emit("input-manifest definitions", input_manifest["definitions"], validated["definitions"])
+emit("input-manifest operational rules", input_manifest["operational_rules"], validated["operational_rules"])
+emit(
+    "input-manifest proved derived lemmas",
+    input_manifest["proved_derived_lemmas"],
+    validated["proved_derived_lemmas"],
+)
+manifest_rule_ids = [
+    entry["source_rule_id"]
+    for entry in read_json(Path("/reference/lemma-discovery.json"))["rules"]
+]
+inventory_rule_ids = [entry["source_rule_id"] for entry in validated["rules"]]
+emit("Stage 3 source-rule ordering", manifest_rule_ids, inventory_rule_ids)
+
+discovery_sha = file_sha(Path("/reference/lemma-discovery.json"))
+domain_source_rules = klean_export._domain_source_rules(validated, discovery_sha)
+emit("input-manifest domain source rules", input_manifest["source_rules"], domain_source_rules)
+emit("obligation-map domain source rules", obligation_map["source_rules"], domain_source_rules)
+emit("obligation count", len(obligation_map["obligations"]), generator["obligation_count"])
+emit("export obligation count", export_result["obligation_count"], generator["obligation_count"])
+emit("recorded preflight obligation count", recorded_preflight["obligation_count"], generator["obligation_count"])
+emit("generated target statement", klean_export.target_statement(generated), generator["target"])
+emit("recorded preflight target", recorded_preflight["target"], generator["target"])
+emit("audit target", audit.get("target"), generator["target"])
+emit("classification mode", audit["mode"], "CLASSIFICATION_ONLY")
+emit("candidate directory absent", Path("/candidate").exists(), False)
+
+print("domain_lemma_ids=" + json.dumps([entry["source_rule_id"] for entry in validated["domain_lemmas"]]))
+print("definition_ids=" + json.dumps([entry["source_rule_id"] for entry in validated["definitions"]]))
+print("obligations=" + json.dumps(obligation_map["obligations"], sort_keys=True))
+print("target=" + json.dumps(klean_export.target_statement(generated), sort_keys=True))

