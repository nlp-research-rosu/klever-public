@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+
+
+def summary(n: int) -> int:
+    return n * (n + 1) // 2 if n >= 0 else 0
+
+
+def source(n: int) -> int:
+    total = 0
+    while n > 0:
+        total += n
+        n -= 1
+    return total
+
+
+witnesses = [-100, -3, -1, 0, 1, 2, 5, 10, 30, 100]
+print("witnesses=", [(n, source(n), summary(n)) for n in witnesses])
+print("witness_mismatches=", [n for n in witnesses if source(n) != summary(n)])
+print(
+    "recurrence_mismatches=",
+    [n for n in range(1, 1001) if summary(n) != n + summary(n - 1)],
+)
+
+# Counterfactual operational mutations should not implement the frozen summary.
+def increment_mutation(n: int) -> int:
+    total = 0
+    while n > 0:
+        total += n + 1
+        n -= 1
+    return total
+
+
+def decrement_mutation(n: int) -> int:
+    total = 0
+    while n > 0:
+        total += n
+        n -= 2
+    return total
+
+
+print("increment_mutation_n5=", increment_mutation(5), "expected_summary=", summary(5))
+print("decrement_mutation_n5=", decrement_mutation(5), "expected_summary=", summary(5))
diff --git a//tmp/audit-work/proc_visible_getpid.c b//tmp/audit-work/proc_visible_getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..899dc6bdc55fc2370ee8444d3a85690d2b68c1f0
--- /dev/null
+++ b//tmp/audit-work/proc_visible_getpid.c
@@ -0,0 +1,35 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit command sandbox exposes /proc/self but not /proc/<namespace-pid>.
+ * Lean 4.22 resolves its executable through /proc/<getpid()>/exe.  Return the
+ * proc-visible numeric target of /proc/self so that lookup reaches the same
+ * executable.  This shim is loaded only for the independent preflight build.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t count = readlink("/proc/self", target, sizeof(target) - 1);
+    long value = 0;
+
+    if (count <= 0 || count >= (ssize_t)sizeof(target)) {
+        return (pid_t)1;
+    }
+    target[count] = '\0';
+    for (ssize_t index = 0; index < count; ++index) {
+        if (target[index] < '0' || target[index] > '9') {
+            errno = EINVAL;
+            return (pid_t)1;
+        }
+        value = value * 10 + (target[index] - '0');
+        if (value > INT_MAX) {
+            errno = ERANGE;
+            return (pid_t)1;
+        }
+    }
+    return (pid_t)value;
+}
