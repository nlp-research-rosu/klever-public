+
+
+def file_sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def emit(label: str, observed, expected) -> None:
+    print(f"{label}: {'MATCH' if observed == expected else 'MISMATCH'}")
+    print(f"  observed={json.dumps(observed, sort_keys=True)}")
+    print(f"  expected={json.dumps(expected, sort_keys=True)}")
+
+
+audit = read_json(Path("/audit-input.json"))["resolution"]
+hashes = audit["hashes"]
