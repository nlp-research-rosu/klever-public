     2	  FuncDef("sum_to_n", Params("n"),
     3	    Assign(Name("total"), Int(0))
     4	    While(Compare(Name("n"), CmpOp(">", Int(0))),
     5	      AugAssign(Name("total"), "+", Name("n"))
     6	      AugAssign(Name("n"), "-", Int(1)))
     7	    Return(Name("total"))))
