diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5785c28bcd32ef3401c23fd5094d684e6d0d7c36
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports INT
+
+  syntax Int ::= sumToN(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule sumToN(N) => N *Int (N +Int 1) /Int 2
+    requires N >=Int 0
+  rule sumToN(N) => 0
+    requires N <Int 0
+endmodule

