+    </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |-> scope(
+        ("n" |-> (N:Int => 0)
+         "total" |-> (S:Int => S +Int sumToN(N))),
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0
