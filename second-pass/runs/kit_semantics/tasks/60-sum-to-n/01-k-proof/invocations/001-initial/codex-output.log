+         "sum_to_n" |-> closureVal(
+           "n", .ParamNames,
+           Assign(Name("total"), Int(1))
+           While(Compare(Name("n"), CmpOp(">", Int(0))),
+             AugAssign(Name("total"), "+", Name("n"))
+             AugAssign(Name("n"), "-", Int(1)))
+           Return(Name("total")),
+           0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures ?R ==Int 1
+endmodule
