+           While(Compare(Name("n"), CmpOp(">", Int(0))),
+             AugAssign(Name("total"), "+", Name("n"))
+             AugAssign(Name("n"), "-", Int(1)))
+           Return(Name("total")),
+           0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
