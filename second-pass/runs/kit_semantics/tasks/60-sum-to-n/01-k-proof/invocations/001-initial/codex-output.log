index 0000000000000000000000000000000000000000..5785c28bcd32ef3401c23fd5094d684e6d0d7c36
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-SYNTAX
+  imports INT
+
+  syntax Int ::= sumToN(Int) [function, total]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-SYNTAX
+  imports MPY
+
+  rule sumToN(N) => N *Int (N +Int 1) /Int 2
+    requires N >=Int 0
+  rule sumToN(N) => 0
+    requires N <Int 0
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1daa16393088abb93cc0f6a11c1d50b6b8d0b6e4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def sum_to_n(n: int):
+    total = 0
+    while n > 0:
+        total += n
+        n -= 1
+    return total
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..32d7a82b9d5a6f1aff649c73ee9c8a8c88ecfbb5
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [sum-loop]:
+    <k>
+      #while(Compare(Name("n"), CmpOp(">", Int(0))),
+        AugAssign(Name("total"), "+", Name("n"))
+        AugAssign(Name("n"), "-", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |-> scope(
+        ("n" |-> (N:Int => 0)
+         "total" |-> (S:Int => S +Int sumToN(N))),
+        parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0
+
+  claim [sum-to-n-empty-range]:
+    <k>
+      Call(Name("sum_to_n"), Int(N))
+      => ?R:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+         "sum_to_n" |-> closureVal(
+           "n", .ParamNames,
+           Assign(Name("total"), Int(0))
+           While(Compare(Name("n"), CmpOp(">", Int(0))),
+             AugAssign(Name("total"), "+", Name("n"))
+             AugAssign(Name("n"), "-", Int(1)))
+           Return(Name("total")),
+           0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N <=Int 0
+    ensures ?R ==Int 0
+
+  claim [sum-to-n-positive]:
+    <k>
+      Call(Name("sum_to_n"), Int(N))
+      => ?R:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+         "sum_to_n" |-> closureVal(
+           "n", .ParamNames,
+           Assign(Name("total"), Int(0))
+           While(Compare(Name("n"), CmpOp(">", Int(0))),
+             AugAssign(Name("total"), "+", Name("n"))
+             AugAssign(Name("n"), "-", Int(1)))
+           Return(Name("total")),
+           0),
+         parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1
+    ensures ?R ==Int sumToN(N)
+endmodule
