/bin/bash -lc '/audit-output/evidence/run_logged.sh stage6-mutation-dry-run kprove audit-spec-vacuity.k --definition audit-verification-kompiled --spec-module AUDIT-SPEC-VACUITY --dry-run' in /tmp/audit-work/111-histogram-audit
