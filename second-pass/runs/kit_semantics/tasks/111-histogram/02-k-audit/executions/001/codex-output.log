+sha256sum \
+  /audit-campaign-lock.json \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /run.json \
+  /task.json \
