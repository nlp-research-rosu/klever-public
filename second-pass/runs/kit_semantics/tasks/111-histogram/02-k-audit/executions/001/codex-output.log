/bin/bash -lc '/audit-output/evidence/run_logged.sh stage4-ground-valid kprove ground-witness.k --definition audit-verification-kompiled --spec-module GROUND-WITNESS --claims GROUND-WITNESS.valid-a' in /tmp/audit-work/111-histogram-audit
