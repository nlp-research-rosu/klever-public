/bin/bash -lc '/audit-output/evidence/run_logged.sh stage3-kompile-llvm kompile reference-semantics/semantics.k --backend llvm --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition audit-runtime-kompiled' in /tmp/audit-work/111-histogram-audit
