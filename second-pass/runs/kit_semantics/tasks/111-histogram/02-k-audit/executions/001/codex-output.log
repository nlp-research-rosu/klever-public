+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} > "$log_path"
+
+"$@" >> "$log_path" 2>&1
+command_status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT STATUS: %s\n' "$command_status"
+} >> "$log_path"
+
+cat "$log_path"
+exit "$command_status"
