     2	def histogram(test):
     3	    """Given a string representing a space separated lowercase letters, return a dictionary
     4	    of the letter with the most repetition and containing the corresponding count.
     5	    If several letters have the same occurrence, return all of them.
     6	    
     7	    Example:
     8	    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}
     9	    histogram('a b b a') == {'a': 2, 'b': 2}
    10	    histogram('a b c a b') == {'a': 2, 'b': 2}
    11	    histogram('b b b b a') == {'b': 4}
    12	    histogram('') == {}
    13	
    14	    """
