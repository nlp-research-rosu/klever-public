     5	
     6	def histogram(test):
     7	    """Given a string representing a space separated lowercase letters, return a dictionary
     8	    of the letter with the most repetition and containing the corresponding count.
     9	    If several letters have the same occurrence, return all of them.
    10	    
    11	    Example:
    12	    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}
    13	    histogram('a b b a') == {'a': 2, 'b': 2}
    14	    histogram('a b c a b') == {'a': 2, 'b': 2}
    15	    histogram('b b b b a') == {'b': 4}
    16	    histogram('') == {}
    17	
    18	    """
    19	    dict1={}
    20	    list1=test.split(" ")
    21	    t=0
    22	
    23	    for i in list1:
    24	        if(list1.count(i)>t) and i!='':
    25	            t=list1.count(i)
    26	    if t>0:
    27	        for i in list1:
    28	            if(list1.count(i)==t):
    29	                
    30	                dict1[i]=t
    31	    return dict1
===== /candidate/solution.py =====
     1	def histogram(test):
     2	    result = {}
     3	    max_count = 0
     4	    letter = ""
     5	    candidate = ""
     6	    count = 0
     7	    phase = 1
     8	
     9	    for letter in test:
    10	        if letter != " ":
    11	            count = 0
    12	            for candidate in test:
    13	                if candidate == letter:
    14	                    count = count + 1
    15	            if count > max_count:
    16	                max_count = count
    17	
    18	    phase = 2
    19	    for letter in test:
    20	        if letter != " ":
    21	            count = 0
    22	            for candidate in test:
    23	                if candidate == letter:
    24	                    count = count + 1
    25	            if count == max_count:
    26	                result[letter] = count
    27	
    28	    return result
