     3	module COUNT-SUMMARY
     4	  imports MPY
     5	
     6	  // Exact accumulator fold performed by each inner source loop.
     7	  syntax Int ::= countHistogramCode(IntSeq, Int, Int) [function, total]
     8	  rule countHistogramCode(.IntSeq, _TARGET:Int, N:Int) => N
     9	  rule countHistogramCode(
    10	         iCons(H:Int, R:IntSeq),
    11	         TARGET:Int,
    12	         N:Int)
    13	    => #if H ==Int TARGET
    14	       #then countHistogramCode(R, TARGET, N +Int 1)
    15	       #else countHistogramCode(R, TARGET, N)
    16	       #fi
    17	
    18	  // The prompt domain: zero or more ASCII lowercase letters and ASCII spaces.
    19	  syntax Bool ::= validHistogramInput(IntSeq) [function, total]
    20	  rule validHistogramInput(.IntSeq) => true
    21	  rule validHistogramInput(iCons(C:Int, R:IntSeq))
    22	    => (C ==Int 32 orBool (97 <=Int C andBool C <=Int 122))
    23	       andBool validHistogramInput(R)
    24	endmodule
    25	
    26	module VERIFICATION
    27	  imports COUNT-SUMMARY
    28	
    29	  // Exact fold performed by the first source loop.  The second argument is
    30	  // the complete original input used by str.count; the first is the suffix
    31	  // still to be visited.
    32	  syntax Int ::= maxHistogramCount(IntSeq, IntSeq, Int) [function, total]
    33	  rule maxHistogramCount(.IntSeq, _ORIG:IntSeq, M:Int) => M
    34	  rule maxHistogramCount(iCons(C:Int, R:IntSeq), ORIG:IntSeq, M:Int)
    35	    => #if C ==Int 32
    36	       #then maxHistogramCount(R, ORIG, M)
    37	       #else
    38	         #if countHistogramCode(ORIG, C, 0) >Int M
    39	         #then
    40	           maxHistogramCount(
    41	             R,
    42	             ORIG,
    43	             countHistogramCode(ORIG, C, 0))
    44	         #else maxHistogramCount(R, ORIG, M)
    45	         #fi
    46	       #fi
    47	
    48	  // Exact fold performed by the second source loop.  Carrying the dictionary's
    49	  // two sequences explicitly makes the function total without assuming that
    50	  // an arbitrary Val is a dictionary.
    51	  syntax Val ::= buildHistogram(
    52	                   IntSeq, IntSeq, Int, ValSeq, ValSeq)
    53	                 [function, total]
    54	  rule buildHistogram(
    55	         .IntSeq,
    56	         _ORIG:IntSeq,
    57	         _M:Int,
    58	         KS:ValSeq,
    59	         VS:ValSeq)
    60	    => dictV(KS, VS)
    61	  rule buildHistogram(
    62	         iCons(C:Int, R:IntSeq),
    63	         ORIG:IntSeq,
    64	         M:Int,
    65	         KS:ValSeq,
    66	         VS:ValSeq)
    67	    => #if C ==Int 32
    68	       #then buildHistogram(R, ORIG, M, KS, VS)
    69	       #else
    70	         #if countHistogramCode(ORIG, C, 0) ==Int M
    71	         #then
    72	           buildHistogram(
    73	             R,
    74	             ORIG,
    75	             M,
    76	             dPutK(KS, str(iCons(C, .IntSeq))),
    77	             dPutV(
    78	               KS,
    79	               VS,
    80	               str(iCons(C, .IntSeq)),
    81	               countHistogramCode(ORIG, C, 0)))
    82	         #else buildHistogram(R, ORIG, M, KS, VS)
    83	         #fi
    84	       #fi
    85	
    86	  syntax Val ::= histogramResult(IntSeq) [function, total]
    87	  rule histogramResult(CS:IntSeq)
    88	    => buildHistogram(
    89	         CS,
    90	         CS,
    91	         maxHistogramCount(CS, CS, 0),
    92	         .ValSeq,
    93	         .ValSeq)
    94	endmodule
