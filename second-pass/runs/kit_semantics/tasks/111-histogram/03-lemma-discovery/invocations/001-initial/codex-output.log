requires "reference-semantics/semantics.k"

module COUNT-SUMMARY
  imports MPY

  // Exact accumulator fold performed by each inner source loop.
  syntax Int ::= countHistogramCode(IntSeq, Int, Int) [function, total]
  rule countHistogramCode(.IntSeq, _TARGET:Int, N:Int) => N
  rule countHistogramCode(
         iCons(H:Int, R:IntSeq),
         TARGET:Int,
         N:Int)
    => #if H ==Int TARGET
       #then countHistogramCode(R, TARGET, N +Int 1)
       #else countHistogramCode(R, TARGET, N)
       #fi

  // The prompt domain: zero or more ASCII lowercase letters and ASCII spaces.
  syntax Bool ::= validHistogramInput(IntSeq) [function, total]
  rule validHistogramInput(.IntSeq) => true
  rule validHistogramInput(iCons(C:Int, R:IntSeq))
    => (C ==Int 32 orBool (97 <=Int C andBool C <=Int 122))
       andBool validHistogramInput(R)
endmodule

module VERIFICATION
  imports COUNT-SUMMARY

  // Exact fold performed by the first source loop.  The second argument is
  // the complete original input used by str.count; the first is the suffix
  // still to be visited.
  syntax Int ::= maxHistogramCount(IntSeq, IntSeq, Int) [function, total]
  rule maxHistogramCount(.IntSeq, _ORIG:IntSeq, M:Int) => M
  rule maxHistogramCount(iCons(C:Int, R:IntSeq), ORIG:IntSeq, M:Int)
    => #if C ==Int 32
       #then maxHistogramCount(R, ORIG, M)
       #else
         #if countHistogramCode(ORIG, C, 0) >Int M
         #then
           maxHistogramCount(
             R,
             ORIG,
             countHistogramCode(ORIG, C, 0))
         #else maxHistogramCount(R, ORIG, M)
         #fi
       #fi

  // Exact fold performed by the second source loop.  Carrying the dictionary's
  // two sequences explicitly makes the function total without assuming that
  // an arbitrary Val is a dictionary.
  syntax Val ::= buildHistogram(
                   IntSeq, IntSeq, Int, ValSeq, ValSeq)
                 [function, total]
  rule buildHistogram(
         .IntSeq,
         _ORIG:IntSeq,
         _M:Int,
         KS:ValSeq,
         VS:ValSeq)
    => dictV(KS, VS)
  rule buildHistogram(
         iCons(C:Int, R:IntSeq),
         ORIG:IntSeq,
         M:Int,
         KS:ValSeq,
         VS:ValSeq)
    => #if C ==Int 32
       #then buildHistogram(R, ORIG, M, KS, VS)
       #else
         #if countHistogramCode(ORIG, C, 0) ==Int M
         #then
           buildHistogram(
             R,
             ORIG,
             M,
             dPutK(KS, str(iCons(C, .IntSeq))),
             dPutV(
               KS,
               VS,
               str(iCons(C, .IntSeq)),
               countHistogramCode(ORIG, C, 0)))
         #else buildHistogram(R, ORIG, M, KS, VS)
         #fi
       #fi

  syntax Val ::= histogramResult(IntSeq) [function, total]
  rule histogramResult(CS:IntSeq)
    => buildHistogram(
         CS,
         CS,
         maxHistogramCount(CS, CS, 0),
         .ValSeq,
         .ValSeq)
endmodule
