+      "rationale": "This is the cons-sequence structural recurrence for maxHistogramCount, defining the fold's space-skip and strict-maximum update cases before recurring on the tail."
+    },
+    {
+      "source_rule_id": "rule-0547ef9d878306e0708cee9245a6b3126d85c893b76a24cf3d2ccc4522c9ba63",
+      "classification": "DEFINITION",
+      "rationale": "This is the empty-sequence base equation for the total buildHistogram fold, defining its result from the accumulated key and value sequences."
+    },
+    {
+      "source_rule_id": "rule-873fc726e8c4c1db886845f8ff0875b9c7bb782452d1d8f3d3e5667015b23e6b",
+      "classification": "DEFINITION",
+      "rationale": "This is the cons-sequence structural recurrence for buildHistogram, defining when to skip a code or update the accumulated dictionary sequences and then recur on the tail."
+    },
+    {
+      "source_rule_id": "rule-385829d23edb7fb14f9b963a8ed360edd5ebb107deade4c540203c41b439e4a4",
+      "classification": "DEFINITION",
+      "rationale": "This unconditional equation defines the named histogramResult proof term by composing the maximum-count and dictionary-building folds with their initial accumulators."
+    }
+  ]
+}

