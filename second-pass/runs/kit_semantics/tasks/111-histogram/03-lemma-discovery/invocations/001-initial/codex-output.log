/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
inv=json.loads(Path('/reference/rule-inventory.json').read_text())
out=json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out)==['schema_version','inventory_sha256','rules'], list(out)
assert out['schema_version']==2
assert out['inventory_sha256']==inv['inventory_sha256']
assert len(out['rules'])==len(inv['rules'])
expected=[r['source_rule_id'] for r in inv['rules']]
actual=[r['source_rule_id'] for r in out['rules']]
assert actual==expected
assert len(actual)==len(set(actual))
for i,(src,item) in enumerate(zip(inv['rules'],out['rules'])):
    assert list(item)==['source_rule_id','classification','rationale'], (i,list(item))
    assert item['classification'] in allowed
    assert isinstance(item['rationale'],str) and item['rationale'].strip()
    if 'simplification' in src['attributes']:
        assert item['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print('schema/order/coverage: PASS')
print('inventory rules:',len(expected))
print('unique output ids:',len(set(actual)))
print('inventory sha256:',out['inventory_sha256'])
print('class counts:')
for c in sorted(allowed):
    print(c, sum(x['classification']==c for x in out['rules']))
print('simplification rules:',sum('simplification' in r['attributes'] for r in inv['rules']))
