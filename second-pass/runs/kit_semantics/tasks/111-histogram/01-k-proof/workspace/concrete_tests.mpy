Module(
  FuncDef("histogram", Params("test"),
    Assign(Name("result"), DictExpr())
    Assign(Name("max_count"), Int(0))
    Assign(Name("letter"), Str(""))
    Assign(Name("candidate"), Str(""))
    Assign(Name("count"), Int(0))
    Assign(Name("phase"), Int(1))
    For(Name("letter"), Name("test"),
      If(Compare(Name("letter"), CmpOp("!=", Str(" "))),
        Assign(Name("count"), Int(0))
        For(Name("candidate"), Name("test"),
          If(Compare(Name("candidate"), CmpOp("==", Name("letter"))),
            Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
            ))
        If(Compare(Name("count"), CmpOp(">", Name("max_count"))),
          Assign(Name("max_count"), Name("count")),
          ),
        ))
    Assign(Name("phase"), Int(2))
    For(Name("letter"), Name("test"),
      If(Compare(Name("letter"), CmpOp("!=", Str(" "))),
        Assign(Name("count"), Int(0))
        For(Name("candidate"), Name("test"),
          If(Compare(Name("candidate"), CmpOp("==", Name("letter"))),
            Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
            ))
        If(Compare(Name("count"), CmpOp("==", Name("max_count"))),
          Assign(
            Subscript(Name("result"), Name("letter")),
            Name("count")),
          ),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("histogram"), Str("a b c")),
      CmpOp(
        "==",
        DictExpr(
          Entry(Str("a"), Int(1)),
          Entry(Str("b"), Int(1)),
          Entry(Str("c"), Int(1))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("a b b a")),
      CmpOp(
        "==",
        DictExpr(Entry(Str("a"), Int(2)), Entry(Str("b"), Int(2))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("a b c a b")),
      CmpOp(
        "==",
        DictExpr(Entry(Str("a"), Int(2)), Entry(Str("b"), Int(2))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("b b b b a")),
      CmpOp("==", DictExpr(Entry(Str("b"), Int(4))))))
  Assert(
    Compare(Call(Name("histogram"), Str("")), CmpOp("==", DictExpr()))))
