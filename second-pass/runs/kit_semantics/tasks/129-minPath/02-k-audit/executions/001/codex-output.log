+    print(f"brute_force_checks={brute_checks}")
+    print(f"brute_force_mismatches={len(brute_mismatches)}")
+    print(f"brute_force_mismatch_details={brute_mismatches[:10]}")
+    print("out_of_contract_boundary_observations:")
