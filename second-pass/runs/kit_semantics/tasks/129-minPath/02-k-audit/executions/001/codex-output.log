     1	def minPath(grid, k):
     2	    n = len(grid)
     3	
     4	    row = 0
     5	    col = 0
     6	    i = 0
     7	    while i < n:
     8	        j = 0
     9	        while j < n:
    10	            if grid[i][j] == 1:
    11	                row = i
    12	                col = j
    13	            j = j + 1
    14	        i = i + 1
    15	
    16	    neighbor = n * n + 1
    17	    if row > 0:
    18	        if grid[row - 1][col] < neighbor:
    19	            neighbor = grid[row - 1][col]
    20	    if row + 1 < n:
    21	        if grid[row + 1][col] < neighbor:
    22	            neighbor = grid[row + 1][col]
    23	    if col > 0:
    24	        if grid[row][col - 1] < neighbor:
    25	            neighbor = grid[row][col - 1]
    26	    if col + 1 < n:
    27	        if grid[row][col + 1] < neighbor:
    28	            neighbor = grid[row][col + 1]
    29	
    30	    result = []
    31	    pairs = k // 2
    32	    while pairs > 0:
    33	        result.append(1)
    34	        result.append(neighbor)
    35	        pairs = pairs - 1
    36	    if k % 2 == 1:
    37	        result.append(1)
    38	    return result
