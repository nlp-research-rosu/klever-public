python3 - <<'PY'
from pathlib import Path
import re
text=Path('REVIEW.md').read_text()
links=re.findall(r'\\[["'^'"\\]]+\\]\\((/audit-output/["'^)]+)'"\\)', text)
missing=[p for p in links if not Path(p).exists()]
print('absolute_evidence_links',len(links),'missing',missing)
