@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -o pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} >"$log_file" 2>&1
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..155f9e85f5c7785a23cbcf6f9a73bac6f3aa8562
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: this satisfying input returns [1,2,1], not [1,3,1].
+  claim [ground-n2-k3-false-result]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(iCons(1, iCons(2, iCons(3, iCons(4, .IntSeq)))), 2)),
+            3, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("$perm" |-> str(iCons(1, iCons(2, iCons(3, iCons(4, .IntSeq))))))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
