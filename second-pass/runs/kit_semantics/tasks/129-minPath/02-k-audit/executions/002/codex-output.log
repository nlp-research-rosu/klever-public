@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -o pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
