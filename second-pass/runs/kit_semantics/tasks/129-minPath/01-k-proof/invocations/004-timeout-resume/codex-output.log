-    </scopes>
-    <heap>
-      H |-> list(
-        PREFIX:ValSeq => ?OUT:ValSeq)
-    </heap>
-    requires K >Int 0
-      andBool pairDone(.ValSeq, PREFIX,
-                       (K -Int pyMod(K, 2)) /Int 2, M)
