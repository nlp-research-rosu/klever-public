  // Exact result of executing R remaining pair iterations from an arbitrary
  // native list prefix A.  The recursive equation mirrors the two append
  // writes made by one loop body; the off-domain branch makes it total.
  syntax ValSeq ::= completePairs(ValSeq, Int, Int)
    [function, total, symbol(completePairs), no-evaluators]
  rule completePairs(A:ValSeq, R:Int, _:Int) => A
    requires R <=Int 0
    [simplification]
