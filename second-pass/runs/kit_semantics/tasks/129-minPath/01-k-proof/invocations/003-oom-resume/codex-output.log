apply patch
patch: completed
/workspace/spec.k
diff --git a/spec.k b/spec.k
index 4cab59b331cbb6501bfed27b4a1c49a0c9fdeefe..cb123da2dd44bdf600f6a9d53dfa1fb4f559aaed
--- a/spec.k
+++ b/spec.k
@@ -254,6 +254,59 @@
       H |-> list(A:ValSeq => snocVS(snocVS(A, 1), M))
     </heap>
 
+  // Header-to-exit summary.  Allocation and k // 2 remain ordinary fixed-
+  // semantics steps in the full target; this claim begins with their result.
+  claim [result-entry]:
+    <k> resultLoop => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> G:Val)
+        ("k" |-> K:Int)
+        ("n" |-> NV:Val)
+        ("row" |-> RV:Val)
+        ("col" |-> CV:Val)
+        ("i" |-> IV:Val)
+        ("j" |-> JV:Val)
+        ("pairs" |-> (C:Int => 0))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(0)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      0 |-> list(.ValSeq => ?PREFIX:ValSeq)
+    </heap>
+    requires C >=Int 0
+    ensures pairDone(.ValSeq, ?PREFIX, C, M)
+
+  claim [result-tail]:
+    <k> oddTail => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> G:Val)
+        ("k" |-> K:Int)
+        ("n" |-> NV:Val)
+        ("row" |-> RV:Val)
+        ("col" |-> CV:Val)
+        ("i" |-> IV:Val)
+        ("j" |-> JV:Val)
+        ("pairs" |-> 0)
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(0)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      0 |-> list(
+        PREFIX:ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires K >Int 0
+      andBool pairDone(.ValSeq, PREFIX,
+                       (K -Int pyMod(K, 2)) /Int 2, M)
+    ensures pathRel(?OUT, K, M)
+
   // Required full-domain target: exact call binding and exact solution body,
   // for every N>=2 permutation grid and every positive K.
   claim [minpath-full-contract]:
@@ -273,7 +326,7 @@
     </scopes>
     <scopeLoc> 1 </scopeLoc>
     <heap>
-      .Map => 0 |-> list(minPathValue(P, N, K))
+      .Map => 0 |-> list(?OUT:ValSeq)
     </heap>
     <heapLoc> 0 => 1 </heapLoc>
     <stack> .List </stack>
@@ -284,5 +337,9 @@
       andBool validPerm(P, N *Int N)
       andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
       andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+    ensures pathRel(
+      ?OUT,
+      K,
+      neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
 
 endmodule
diff --git a/verification.k b/verification.k
index 8400ee2868e95210c9cd14538a58e6b528d338b7..b277701c9f2be309c06150aaafefe01e84661e28
--- a/verification.k
+++ b/verification.k
@@ -202,30 +202,56 @@
     requires R >Int 0
     [simplification]
 
-  // Connection used only after the real loop starts from Python's empty list.
-  // It is the functional induction theorem shared by pairDone and
-  // completePairs; the generalized loop claim above does not depend on it.
-  rule pairDone(.ValSeq, O:ValSeq, R:Int, M:Int)
-    => (O ==K completePairs(.ValSeq, R, M))
+  // Odd-length counterpart: R pairs followed by the final 1.
+  syntax Bool ::= oddDone(ValSeq, ValSeq, Int, Int)
+    [function, total, symbol(oddDone), no-evaluators]
+  rule oddDone(A:ValSeq, O:ValSeq, R:Int, _:Int)
+    => (O ==K snocVS(A, 1))
+    requires R <=Int 0
+    [simplification]
+  rule oddDone(A:ValSeq, O:ValSeq, R:Int, M:Int)
+    => oddDone(snocVS(snocVS(A, 1), M), O, R -Int 1, M)
+    requires R >Int 0
+    [simplification]
+
+  // Appending the odd tail to a completed pair prefix connects the two exact
+  // recursive relations without solving backward through a summary function.
+  rule oddDone(A:ValSeq, snocVS(P:ValSeq, 1), R:Int, M:Int)
+    => pairDone(A, P, R, M)
     requires R >=Int 0
     [simplification]
 
-  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
-  rule minPathValue(P:IntSeq, N:Int, K:Int)
+  syntax Bool ::= pathRel(ValSeq, Int, Int)
+    [function, total, symbol(pathRel), no-evaluators]
+  rule pathRel(O:ValSeq, K:Int, M:Int)
+    => oddDone(.ValSeq, O, (K -Int pyMod(K, 2)) /Int 2, M)
+    requires pyMod(K, 2) ==Int 1
+    [simplification]
+  rule pathRel(O:ValSeq, K:Int, M:Int)
+    => pairDone(.ValSeq, O, (K -Int pyMod(K, 2)) /Int 2, M)
+    requires pyMod(K, 2) =/=Int 1
+    [simplification]
+
+  syntax ValSeq ::= pathValue(Int, Int) [function, total]
+  rule pathValue(K:Int, M:Int)
     => completePairs(
          .ValSeq,
          (K -Int pyMod(K, 2)) /Int 2,
-         neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+         M)
     requires pyMod(K, 2) ==Int 0
-  rule minPathValue(P:IntSeq, N:Int, K:Int)
-    => valSeqConcat(
+  rule pathValue(K:Int, M:Int)
+    => snocVS(
          completePairs(
            .ValSeq,
            (K -Int pyMod(K, 2)) /Int 2,
-           neighborMin(P, N, oneRow(P, N), oneCol(P, N))),
-         vCons(1, .ValSeq))
+           M),
+         1)
     requires pyMod(K, 2) =/=Int 0
 
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pathValue(K, neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+
   // -----------------------------------------------------------------------
   // Exact AST abbreviations for solution.py.  These are syntax macros only.
   // -----------------------------------------------------------------------
@@ -331,6 +357,12 @@
   rule resultWhile =>
     #while(Compare(Name("pairs"), CmpOp(">", Int(0))), resultBody)
 
+  syntax Stmt ::= "oddTail" [macro]
+  rule oddTail =>
+    If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(1))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+      .Stmts)
+
   syntax Stmts ::= "minPathBody" [macro]
   rule minPathBody =>
     Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
@@ -347,9 +379,7 @@
     Assign(Name("result"), ListExpr(.Exprs))
     Assign(Name("pairs"), BinOp("//", Name("k"), Int(2)))
     resultLoop
-    If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(1))),
-      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
-      .Stmts)
+    oddTail
     Return(Name("result"))
 
 endmodule

