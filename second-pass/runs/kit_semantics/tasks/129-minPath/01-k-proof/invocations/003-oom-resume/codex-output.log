  syntax ValSeq ::= pathValue(Int, Int) [function, total]
  rule pathValue(K:Int, M:Int)
    => completePairs(
         .ValSeq,
         (K -Int pyMod(K, 2)) /Int 2,
         M)
    requires pyMod(K, 2) ==Int 0
