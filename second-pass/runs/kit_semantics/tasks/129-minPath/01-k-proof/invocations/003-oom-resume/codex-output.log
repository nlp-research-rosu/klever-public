        ("row" |-> R:Int) ("col" |-> C:Int)
        ("i" |-> N) ("j" |-> _J:Int)
        ("neighbor" |-> (B:Int => afterLeft(B, P, N, R, C))),
        parent(0))
      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
      RESTSCOPES:Map
    </scopes>
    requires N >=Int 2 andBool validPerm(P, N *Int N)
      andBool R >=Int 0 andBool R <Int N
      andBool C >=Int 0 andBool C <Int N

  claim [neighbor-right]:
    <k> rightIf => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
        ("k" |-> _K:Int) ("n" |-> N)
        ("row" |-> R:Int) ("col" |-> C:Int)
        ("i" |-> N) ("j" |-> _J:Int)
        ("neighbor" |-> (B:Int => afterRight(B, P, N, R, C))),
        parent(0))
      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
