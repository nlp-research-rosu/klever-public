    </scopes>
    requires N >=Int 2 andBool validPerm(P, N *Int N)
      andBool R >=Int 0 andBool R <Int N
      andBool C >=Int 0 andBool C <Int N

  // Sequential cut for the complete neighbor phase.  It is itself a
  // reachability claim derived from the four exact update claims above.
  claim [neighbor-finish]:
    <k> neighborUpdates => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
        ("k" |-> K:Int) ("n" |-> N)
        ("row" |-> R:Int) ("col" |-> C:Int)
        ("i" |-> N) ("j" |-> _J:Int)
        ("neighbor" |->
          (N *Int N +Int 1 => neighborMin(P, N, R, C))),
        parent(0))
      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
      RESTSCOPES:Map
    </scopes>
    requires N >=Int 2 andBool validPerm(P, N *Int N)
      andBool R ==Int oneRow(P, N) andBool C ==Int oneCol(P, N)
      andBool R >=Int 0 andBool R <Int N
      andBool C >=Int 0 andBool C <Int N

  // The final loop is generalized over its native ValSeq prefix A.  One
  // iteration therefore recurs with the exact two append writes applied to A.
  claim [result-base]:
    <k> resultWhile => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
        ("k" |-> _K:Int)
        ("n" |-> N)
        ("row" |-> oneRow(PSEQ, N))
        ("col" |-> oneCol(PSEQ, N))
        ("i" |-> N)
        ("j" |-> _J:Int)
        ("pairs" |-> 0)
        ("neighbor" |-> M:Int)
        ("result" |-> ref(H:Int)),
        parent(0))
      0 |-> scope(("$perm" |-> str(PSEQ)) GLOBALS:Map, parent(-1))
      RESTSCOPES:Map
    </scopes>
    <heap>
      H |-> list(A:ValSeq)
    </heap>

  claim [result-loop]:
    <k>
    <k>
      resultBody ~> #loopLbl(resultWhile ~> .K)
      => .K
      ...
    </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> _GRID:Val)
        ("k" |-> _KV:Val)
        ("n" |-> _NV:Val)
        ("row" |-> _ROWV:Val)
        ("col" |-> _COLV:Val)
        ("i" |-> _IV:Val)
        ("j" |-> _JV:Val)
