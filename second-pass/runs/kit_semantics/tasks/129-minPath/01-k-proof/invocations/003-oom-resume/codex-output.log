  claim [neighbor-down]:
    <k> downIf => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
        ("k" |-> _K:Int) ("n" |-> N)
        ("row" |-> R:Int) ("col" |-> C:Int)
        ("i" |-> N) ("j" |-> _J:Int)
        ("neighbor" |-> (B:Int => afterDown(B, P, N, R, C))),
        parent(0))
      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
      RESTSCOPES:Map
    </scopes>
    requires N >=Int 2 andBool validPerm(P, N *Int N)
      andBool R >=Int 0 andBool R <Int N
      andBool C >=Int 0 andBool C <Int N

  claim [neighbor-left]:
    <k> leftIf => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
        ("k" |-> _K:Int) ("n" |-> N)
        ("row" |-> R:Int) ("col" |-> C:Int)
        ("i" |-> N) ("j" |-> _J:Int)
        ("neighbor" |-> (B:Int => afterLeft(B, P, N, R, C))),
        parent(0))
      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
      RESTSCOPES:Map
    </scopes>
    requires N >=Int 2 andBool validPerm(P, N *Int N)
      andBool R >=Int 0 andBool R <Int N
      andBool C >=Int 0 andBool C <Int N

  claim [neighbor-right]:
    <k> rightIf => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
        ("k" |-> _K:Int) ("n" |-> N)
        ("row" |-> R:Int) ("col" |-> C:Int)
        ("i" |-> N) ("j" |-> _J:Int)
        ("neighbor" |-> (B:Int => afterRight(B, P, N, R, C))),
        parent(0))
      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
      RESTSCOPES:Map
    </scopes>
    requires N >=Int 2 andBool validPerm(P, N *Int N)
      andBool R >=Int 0 andBool R <Int N
      andBool C >=Int 0 andBool C <Int N

  // The final loop is generalized over its native ValSeq prefix A.  One
  // iteration therefore recurs with the exact two append writes applied to A.
  claim [result-base]:
    <k> resultWhile => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
        ("k" |-> _K:Int)
        ("n" |-> N)
        ("row" |-> oneRow(PSEQ, N))
        ("col" |-> oneCol(PSEQ, N))
        ("i" |-> N)
        ("j" |-> _J:Int)
        ("pairs" |-> 0)
        ("neighbor" |-> M:Int)
        ("result" |-> ref(H:Int)),
        parent(0))
      0 |-> scope(("$perm" |-> str(PSEQ)) GLOBALS:Map, parent(-1))
      RESTSCOPES:Map
    </scopes>
    <heap>
      H |-> list(A:ValSeq)
    </heap>

  claim [result-loop]:
    <k>
      resultBody ~> #loopLbl(resultWhile ~> .K)
      => .K
      ...
    </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> _GRID:Val)
        ("k" |-> _KV:Val)
        ("n" |-> _NV:Val)
        ("row" |-> _ROWV:Val)
        ("col" |-> _COLV:Val)
        ("i" |-> _IV:Val)
        ("j" |-> _JV:Val)
        ("pairs" |-> (R:Int => 0))
        ("neighbor" |-> M:Int)
        ("result" |-> ref(H:Int)),
        parent(0))
      RESTSCOPES:Map
    </scopes>
    <heap>
      H |-> list(A:ValSeq => ?OUT:ValSeq)
    </heap>
    requires R >Int 0
    ensures pairDone(A, ?OUT, R, M)

  claim [result-loop-tail]:
    <k>
      resultBody
      ~> #loopLbl(resultWhile ~> .K)
      ~> (oddTail TAIL:Stmts)
      => TAIL
      ...
    </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> _GRID:Val)
        ("k" |-> K:Int)
        ("n" |-> _NV:Val)
        ("row" |-> _ROWV:Val)
        ("col" |-> _COLV:Val)
        ("i" |-> _IV:Val)
        ("j" |-> _JV:Val)
        ("pairs" |-> (R:Int => 0))
        ("neighbor" |-> M:Int)
        ("result" |-> ref(H:Int)),
        parent(0))
      RESTSCOPES:Map
    </scopes>
    <heap>
      H |-> list(A:ValSeq => ?OUT:ValSeq)
    </heap>
    requires R >Int 0
    ensures finishRel(A, ?OUT, R, M, K)

  claim [result-one]:
    <k> resultLoop => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
        ("k" |-> _K:Int)
        ("n" |-> N)
        ("row" |-> oneRow(PSEQ, N))
        ("col" |-> oneCol(PSEQ, N))
        ("i" |-> N)
        ("j" |-> _J:Int)
        ("pairs" |-> (1 => 0))
        ("neighbor" |-> M:Int)
        ("result" |-> ref(H:Int)),
        parent(0))
      0 |-> scope(
        ("$perm" |-> str(PSEQ))
        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
                                   minPathBody, 0)),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <heap>
      H |-> list(A:ValSeq => snocVS(snocVS(A, 1), M))
    </heap>

  claim [result-tail]:
    <k> oddTail => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> G:Val)
        ("k" |-> K:Int)
        ("n" |-> NV:Val)
        ("row" |-> RV:Val)
        ("col" |-> CV:Val)
        ("i" |-> IV:Val)
        ("j" |-> JV:Val)
        ("pairs" |-> 0)
        ("neighbor" |-> M:Int)
        ("result" |-> ref(0)),
        parent(0))
      RESTSCOPES:Map
    </scopes>
    <heap>
      0 |-> list(
        PREFIX:ValSeq => ?OUT:ValSeq)
    </heap>
    requires K >Int 0
      andBool pairDone(.ValSeq, PREFIX,
                       (K -Int pyMod(K, 2)) /Int 2, M)
    ensures pathRel(?OUT, K, M)

  // Required full-domain target: exact call binding and exact solution body,
  // for every N>=2 permutation grid and every positive K.
  claim [minpath-full-contract]:
    <k>
      Call(Name("minPath"),
           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        ("$perm" |-> str(P))
        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
                                   minPathBody, 0)),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map => 0 |-> list(?OUT:ValSeq)
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 2 andBool K >Int 0
      andBool validPerm(P, N *Int N)
      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
    ensures pathRel(
      ?OUT,
      K,
      neighborMin(P, N, oneRow(P, N), oneCol(P, N)))

endmodule
  // native list prefix A.  The recursive equation mirrors the two append
  // writes made by one loop body; the off-domain branch makes it total.
  syntax ValSeq ::= completePairs(ValSeq, Int, Int)
    [function, total, symbol(completePairs), no-evaluators]
  rule completePairs(A:ValSeq, R:Int, _:Int) => A
    requires R <=Int 0
    [simplification]
  rule completePairs(A:ValSeq, R:Int, M:Int)
    => completePairs(
         snocVS(snocVS(A, 1), M),
         R -Int 1,
         M)
    requires R >Int 0
    [simplification]

  syntax Bool ::= pairDone(ValSeq, ValSeq, Int, Int)
    [function, total, symbol(pairDone), no-evaluators]
  rule pairDone(A:ValSeq, O:ValSeq, R:Int, _:Int) => A ==K O
    requires R <=Int 0
    [simplification]
  rule pairDone(A:ValSeq, O:ValSeq, R:Int, M:Int)
    => pairDone(snocVS(snocVS(A, 1), M), O, R -Int 1, M)
    requires R >Int 0
    [simplification]

  // Odd-length counterpart: R pairs followed by the final 1.
  syntax Bool ::= oddDone(ValSeq, ValSeq, Int, Int)
    [function, total, symbol(oddDone), no-evaluators]
  rule oddDone(A:ValSeq, O:ValSeq, R:Int, _:Int)
    => (O ==K snocVS(A, 1))
    requires R <=Int 0
    [simplification]
  rule oddDone(A:ValSeq, O:ValSeq, R:Int, M:Int)
    => oddDone(snocVS(snocVS(A, 1), M), O, R -Int 1, M)
    requires R >Int 0
    [simplification]

  // Appending the odd tail to a completed pair prefix connects the two exact
  // recursive relations without solving backward through a summary function.
  rule oddDone(A:ValSeq, snocVS(P:ValSeq, 1), R:Int, M:Int)
    => pairDone(A, P, R, M)
    requires R >=Int 0
    [simplification]

  syntax Bool ::= finishRel(ValSeq, ValSeq, Int, Int, Int)
    [function, total, symbol(finishRel), no-evaluators]
  rule finishRel(A:ValSeq, O:ValSeq, R:Int, M:Int, K:Int)
    => oddDone(A, O, R, M)
    requires pyMod(K, 2) ==Int 1
    [simplification]
  rule finishRel(A:ValSeq, O:ValSeq, R:Int, M:Int, K:Int)
    => pairDone(A, O, R, M)
    requires pyMod(K, 2) =/=Int 1
    [simplification]

  syntax Bool ::= pathRel(ValSeq, Int, Int)
    [function, total, symbol(pathRel), no-evaluators]
  rule pathRel(O:ValSeq, K:Int, M:Int)
    => finishRel(.ValSeq, O,
                 (K -Int pyMod(K, 2)) /Int 2, M, K)
    [simplification]

  syntax ValSeq ::= pathValue(Int, Int) [function, total]
  rule pathValue(K:Int, M:Int)
    => completePairs(
         .ValSeq,
         (K -Int pyMod(K, 2)) /Int 2,
         M)
    requires pyMod(K, 2) ==Int 0
  rule pathValue(K:Int, M:Int)
    => snocVS(
         completePairs(
           .ValSeq,
           (K -Int pyMod(K, 2)) /Int 2,
           M),
         1)
    requires pyMod(K, 2) =/=Int 0

  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
  rule minPathValue(P:IntSeq, N:Int, K:Int)
    => pathValue(K, neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
def minPath(grid, k):
    n = len(grid)

    row = 0
    col = 0
    i = 0
    while i < n:
        j = 0
        while j < n:
            if grid[i][j] == 1:
                row = i
                col = j
            j = j + 1
        i = i + 1

    neighbor = n * n + 1
    if row > 0:
        if grid[row - 1][col] < neighbor:
            neighbor = grid[row - 1][col]
    if row + 1 < n:
        if grid[row + 1][col] < neighbor:
            neighbor = grid[row + 1][col]
    if col > 0:
        if grid[row][col - 1] < neighbor:
            neighbor = grid[row][col - 1]
    if col + 1 < n:
        if grid[row][col + 1] < neighbor:
            neighbor = grid[row][col + 1]

    result = []
    pairs = k // 2
    while pairs > 0:
        result.append(1)
        result.append(neighbor)
        pairs = pairs - 1
    if k % 2 == 1:
        result.append(1)
    return result

def minPath(grid, k):
    """
    Given a grid with N rows and N columns (N >= 2) and a positive integer k, 
    each cell of the grid contains a value. Every integer in the range [1, N * N]
    inclusive appears exactly once on the cells of the grid.

    You have to find the minimum path of length k in the grid. You can start
    from any cell, and in each step you can move to any of the neighbor cells,
    in other words, you can go to cells which share an edge with you current
    cell.
    Please note that a path of length k means visiting exactly k cells (not
    necessarily distinct).
    You CANNOT go off the grid.
    A path A (of length k) is considered less than a path B (of length k) if
    after making the ordered lists of the values on the cells that A and B go
    through (let's call them lst_A and lst_B), lst_A is lexicographically less
    than lst_B, in other words, there exist an integer index i (1 <= i <= k)
    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have
    lst_A[j] = lst_B[j].
    It is guaranteed that the answer is unique.
    Return an ordered list of the values on the cells that the minimum path go through.

    Examples:

        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3
        Output: [1, 2, 1]

        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1
        Output: [1]
    """

