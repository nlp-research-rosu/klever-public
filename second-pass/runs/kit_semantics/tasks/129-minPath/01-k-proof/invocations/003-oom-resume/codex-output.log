+      Assign(Name("result"), ListExpr(.Exprs))
+      ~> (Assign(Name("pairs"), BinOp("//", Name("k"), Int(2)))
+          resultLoop
+          oddTail
+          TAIL:Stmts)
+      => TAIL
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        (("grid" |-> G:Val)
+         ("k" |-> K:Int)
+         ("n" |-> NV:Val)
+         ("row" |-> RV:Val)
+         ("col" |-> CV:Val)
+         ("i" |-> IV:Val)
+         ("j" |-> JV:Val)
+         ("neighbor" |-> M:Int)
