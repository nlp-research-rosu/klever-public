        ("row" |-> _ROWV:Val)
        ("col" |-> _COLV:Val)
        ("i" |-> _IV:Val)
        ("j" |-> _JV:Val)
        ("pairs" |-> (R:Int => 0))
        ("neighbor" |-> M:Int)
        ("result" |-> ref(H:Int)),
