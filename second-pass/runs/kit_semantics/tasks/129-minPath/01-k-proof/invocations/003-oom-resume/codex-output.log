+         ("n" |-> NV)
+         ("row" |-> RV)
+         ("col" |-> CV)
+         ("i" |-> IV)
+         ("j" |-> JV)
+         ("pairs" |-> 0)
+         ("neighbor" |-> M)
+         ("result" |-> ref(0))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      .Map => 0 |-> list(pathValue(K, M))
