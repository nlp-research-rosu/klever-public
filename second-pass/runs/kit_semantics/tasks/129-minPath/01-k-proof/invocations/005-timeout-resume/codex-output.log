+            neighbor = grid[row][col + 1]
+    result = []
+    pairs = k // 2
+    while pairs > 0:
+        result.append(1)
+        result.append(neighbor)
+        pairs = pairs - 1
+    if k % 2 == 1:
+        result.append(1)
+    return result
