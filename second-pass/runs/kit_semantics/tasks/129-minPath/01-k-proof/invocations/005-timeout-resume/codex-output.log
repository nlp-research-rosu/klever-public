diff --git a/spec.k b/spec.k
index 1a9e68c0aadaced9d04cf2b90459c9289837f072..4ee354ea23dadc4babe53fd6ecfa427eef50ea93
--- a/spec.k
+++ b/spec.k
@@ -157,7 +157,8 @@
   // only to this loop, while the base branch executes the odd tail and return.
   claim [result-loop-tail]:
     <k>
-      resultWhile ~> oddTail ~> Return(Name("result")) .Stmts ~> #endcall
+      #while(Compare(Name("pairs"), CmpOp(">", Int(0))), resultBody)
+      ~> oddTail ~> Return(Name("result")) .Stmts ~> #endcall
       => Return(Name("result")) .Stmts ~> #endcall
     </k>
     <env> 1 </env>
@@ -192,7 +193,7 @@
       andBool validPerm(P, N *Int N)
       andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
       andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
-      andBool R >Int 0
+      andBool R >=Int 0
     ensures finishRel(
       A, ?OUT, R,
       neighborMin(P, N, oneRow(P, N), oneCol(P, N)), K)
@@ -201,17 +202,17 @@
   claim [result-phase-return]:
     <k>
       resultLoop oddTail Return(Name("result")) .Stmts ~> #endcall
-      => ref(0)
+      => Return(Name("result")) .Stmts ~> #endcall
     </k>
-    <env> 1 => 0 </env>
+    <env> 1 </env>
     <scopes>
-      (0 |-> scope(
+      0 |-> scope(
         ("$perm" |-> str(P:IntSeq))
         ("minPath" |-> closureVal(("grid", "k", .ParamNames),
                                    minPathBody, 0)),
         parent(-1))
-       -1 |-> builtinsScope
-       1 |-> scope(
+      -1 |-> builtinsScope
+      1 |-> scope(
         ("grid" |-> list(gridRows(P, N:Int)))
         ("k" |-> K:Int)
         ("n" |-> N)
@@ -221,20 +222,14 @@
         ("j" |-> N)
         ("neighbor" |-> neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
         ("result" |-> ref(0))
-        ("pairs" |-> (K -Int pyMod(K, 2)) /Int 2),
+        ("pairs" |->
+          ((K -Int pyMod(K, 2)) /Int 2 => 0)),
         parent(0))
-       =>
-       0 |-> scope(
-        ("$perm" |-> str(P))
-        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
-                                   minPathBody, 0)),
-        parent(-1))
-       -1 |-> builtinsScope)
     </scopes>
-    <scopeLoc> 2 => 1 </scopeLoc>
+    <scopeLoc> 2 </scopeLoc>
     <heap> 0 |-> list(.ValSeq => ?OUT:ValSeq) </heap>
     <heapLoc> 1 </heapLoc>
-    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
     <ret> noRet </ret>
     <exc> NoExc </exc>
     <exit-code> 0 </exit-code>
diff --git a/verification.k b/verification.k
index 22f21f750947323d82514745751ef605921d6d68..f31f3fe4c4f7cac62690e7f9b0e1149d2d928874
--- a/verification.k
+++ b/verification.k
@@ -126,6 +126,13 @@
       andBool J >=Int 0 andBool J <Int N
     [simplification]
 
+  rule (gridAt(P:IntSeq, N:Int, I:Int, J:Int) <Int N *Int N +Int 1)
+    => true
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
   // -----------------------------------------------------------------------
   // Pure summaries used by the loop claims and final postcondition.
   // -----------------------------------------------------------------------
@@ -161,18 +168,15 @@
     => afterDown(bestUp(P, N, R, C), P, N, R, C)
   rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
     => afterLeft(bestDown(P, N, R, C), P, N, R, C)
+  // Definitional expansion of the four conditional minima.  This is a
+  // functional data equation only: it exposes the same guarded selectors as
+  // the source conditionals and never rewrites program control.
   rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
-    => afterRight(bestLeft(P, N, R, C), P, N, R, C)
-    [concrete]
-
-  // Fixed evaluation exposes all four conditional minima.  On a valid grid
-  // this guarded functional lemma folds that exact data term back to the
-  // specification selector; it does not rewrite program control.
-  rule chooseMin(
+    => chooseMin(
          chooseMin(
            chooseMin(
-             chooseMin(N:Int *Int N +Int 1,
-                       gridAt(P:IntSeq, N, R:Int -Int 1, C:Int),
+             chooseMin(N *Int N +Int 1,
+                       gridAt(P, N, R -Int 1, C),
                        R >Int 0),
              gridAt(P, N, R +Int 1, C),
              R +Int 1 <Int N),
@@ -180,7 +184,6 @@
            C >Int 0),
          gridAt(P, N, R, C +Int 1),
          C +Int 1 <Int N)
-    => neighborMin(P, N, R, C)
     requires N >=Int 2 andBool validPerm(P, N *Int N)
       andBool R >=Int 0 andBool R <Int N
       andBool C >=Int 0 andBool C <Int N

