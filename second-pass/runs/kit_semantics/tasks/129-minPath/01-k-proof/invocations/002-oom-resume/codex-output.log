78:      Assign(Name("pairs"), BinOp("-", Name("pairs"), Int(1))))
80:      Expr(Call(Attribute(Name("result"), "append"), Int(1))),
      Assign(Name("j"), Int(0))
      innerLoop
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))

  syntax KItem ::= "outerWhile" [macro]
  rule outerWhile =>
    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
      Assign(Name("j"), Int(0))
      innerLoop
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))

  syntax Stmt ::= "resultLoop" [macro]
  rule resultLoop =>
    While(Compare(Name("pairs"), CmpOp(">", Int(0))),
      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
      Expr(Call(Attribute(Name("result"), "append"),
                (Name("neighbor"), .Exprs)))
      Assign(Name("pairs"), BinOp("-", Name("pairs"), Int(1))))

  syntax KItem ::= "resultWhile" [macro]
  rule resultWhile =>
    #while(Compare(Name("pairs"), CmpOp(">", Int(0))),
      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
      Expr(Call(Attribute(Name("result"), "append"),
                (Name("neighbor"), .Exprs)))
      Assign(Name("pairs"), BinOp("-", Name("pairs"), Int(1))))

  syntax Stmts ::= "minPathBody" [macro]
  rule minPathBody =>
    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
    Assign(Name("row"), Int(0))
    Assign(Name("col"), Int(0))
    Assign(Name("i"), Int(0))
    outerLoop
    Assign(Name("neighbor"),
           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
    If(Compare(Name("row"), CmpOp(">", Int(0))),
      If(Compare(Subscript(Subscript(Name("grid"),
                                      BinOp("-", Name("row"), Int(1))),
                            Name("col")),
                 CmpOp("<", Name("neighbor"))),
        Assign(Name("neighbor"),
               Subscript(Subscript(Name("grid"),
                                   BinOp("-", Name("row"), Int(1))),
                         Name("col"))),
        .Stmts),
      .Stmts)
    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
      If(Compare(Subscript(Subscript(Name("grid"),
                                      BinOp("+", Name("row"), Int(1))),
                            Name("col")),
                 CmpOp("<", Name("neighbor"))),
        Assign(Name("neighbor"),
               Subscript(Subscript(Name("grid"),
                                   BinOp("+", Name("row"), Int(1))),
                         Name("col"))),
        .Stmts),
      .Stmts)
    If(Compare(Name("col"), CmpOp(">", Int(0))),
      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
                            BinOp("-", Name("col"), Int(1))),
                 CmpOp("<", Name("neighbor"))),
        Assign(Name("neighbor"),
               Subscript(Subscript(Name("grid"), Name("row")),
                         BinOp("-", Name("col"), Int(1)))),
        .Stmts),
      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N

  // The final loop is generalized over its native ValSeq prefix A.  One
  // iteration therefore recurs with the exact two append writes applied to A.
  claim [result-base]:
    <k> resultWhile => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
        ("k" |-> _K:Int)
        ("n" |-> N)
        ("row" |-> oneRow(PSEQ, N))
        ("col" |-> oneCol(PSEQ, N))
        ("i" |-> N)
        ("j" |-> _J:Int)
        ("pairs" |-> 0)
        ("neighbor" |-> M:Int)
        ("result" |-> ref(H:Int)),
        parent(0))
      0 |-> scope(
        ("$perm" |-> str(PSEQ))
        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
                                   minPathBody, 0)),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <heap>
      H |-> list(A:ValSeq)
    </heap>

  claim [result-loop]:
    <k> resultWhile => .K ... </k>
    <env> 1 </env>
    <scopes>
      1 |-> scope(
        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
        ("k" |-> _K:Int)
        ("n" |-> N)
        ("row" |-> oneRow(PSEQ, N))
        ("col" |-> oneCol(PSEQ, N))
        ("i" |-> N)
        ("j" |-> _J:Int)
        ("pairs" |-> (R:Int => 0))
        ("neighbor" |-> M:Int)
        ("result" |-> ref(H:Int)),
        parent(0))
      0 |-> scope(
        ("$perm" |-> str(PSEQ))
        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
                                   minPathBody, 0)),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <heap>
      H |-> list(A:ValSeq => completePairs(A, R, M))
    </heap>
    requires R >Int 0

  // Required full-domain target: exact call binding and exact solution body,
  // for every N>=2 permutation grid and every positive K.
  claim [minpath-full-contract]:
    <k>
      Call(Name("minPath"),
           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        ("$perm" |-> str(P))
        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
                                   minPathBody, 0)),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>

