+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
