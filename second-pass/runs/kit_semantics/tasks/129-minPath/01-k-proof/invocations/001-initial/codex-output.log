+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
