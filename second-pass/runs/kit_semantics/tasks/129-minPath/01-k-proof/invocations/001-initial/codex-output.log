+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    pairs = k // 2
+    p = 0
+    while p < pairs:
+        result.append(1)
+        result.append(neighbor)
+        p = p + 1
+    if k % 2 == 1:
+        result.append(1)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95edbb42af8bda1bcd850a7a82b284d70be7cc08
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,224 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-one-ahead]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool I ==Int oneRow(P, N) andBool J <=Int oneCol(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [inner-no-one]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool notBool (I ==Int oneRow(P, N)
+                       andBool J <=Int oneCol(P, N))
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-one-ahead]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I <=Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [outer-one-past]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I >Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The final loop preserves the exact list object.  The guarded claims split
+  // the empty prefix from the injective positivePairs(P,M) summary.
+  claim [result-zero]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> 0)
+        ("p" |-> 0)
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq)
+    </heap>
+
+  claim [result-start]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (0 => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires C >Int 0
+    ensures ?OUT ==K positivePairs(C, M)
+
+  claim [result-positive]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (P:Int => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires P >=Int 1 andBool P <=Int C
+      andBool (A ==K positivePairs(P, M))
+    ensures ?OUT ==K positivePairs(C, M)
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("$perm" |-> str(P))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..edb60ed425ada3b091d1947874929c358054ae79
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,326 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  syntax Int ::= findOne(IntSeq, Int) [function, total]
+  rule findOne(.IntSeq, _:Int) => -1
+  rule findOne(iCons(1, _:IntSeq), A:Int) => A
+  rule findOne(iCons(X:Int, R:IntSeq), A:Int) => findOne(R, A +Int 1)
+    requires X =/=Int 1
+
+  syntax Int ::= oneIndex(IntSeq)
+    [function, total, symbol(oneIndex), no-evaluators]
+  rule oneIndex(P:IntSeq) => findOne(P, 0) [concrete]
+
+  syntax Int ::= oneRow(IntSeq, Int)
+    [function, total, symbol(oneRow), no-evaluators]
+  syntax Int ::= oneCol(IntSeq, Int)
+    [function, total, symbol(oneCol), no-evaluators]
+  rule oneRow(P:IntSeq, N:Int) => oneIndex(P) /Int N
+    requires N >Int 0
+    [concrete]
+  rule oneRow(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+  rule oneCol(P:IntSeq, N:Int) => pyMod(oneIndex(P), N)
+    requires N >Int 0
+    [concrete]
+  rule oneCol(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  rule (gridAt(P:IntSeq, N:Int, I:Int, J:Int) ==Int 1)
+    => (I ==Int oneRow(P, N) andBool J ==Int oneCol(P, N))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= snocVS(ValSeq, Val)
+    [function, total, symbol(snocVS), no-evaluators]
+  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq) [concrete]
+  rule snocVS(vCons(X:Val, R:ValSeq), V:Val)
+    => vCons(X, snocVS(R, V))
+    [concrete]
+
+  syntax ValSeq ::= positivePairs(Int, Int)
+    [function, total, injective, symbol(positivePairs), no-evaluators]
+  syntax ValSeq ::= positiveHalf(Int, Int)
+    [function, total, symbol(positiveHalf), no-evaluators]
+
+  rule positivePairs(P:Int, M:Int)
+    => vCons(false, vCons(P, vCons(M, .ValSeq)))
+    requires P <=Int 0
+    [concrete]
+  rule positivePairs(1, M:Int) => vCons(1, vCons(M, .ValSeq))
+    [concrete]
+  rule positivePairs(P:Int, M:Int)
+    => snocVS(snocVS(positivePairs(P -Int 1, M), 1), M)
+    requires P >Int 1
+    [concrete]
+  rule positiveHalf(P:Int, M:Int) => snocVS(positivePairs(P, M), 1)
+    [concrete]
+
+  rule valSeqConcat(vCons(1, .ValSeq), vCons(M:Int, .ValSeq))
+    => positivePairs(1, M)
+    [simplification]
+  rule valSeqConcat(positivePairs(P:Int, M:Int), vCons(1, .ValSeq))
+    => positiveHalf(P, M)
+    requires P >=Int 1
+    [simplification]
+  rule valSeqConcat(positiveHalf(P:Int, M:Int), vCons(M, .ValSeq))
+    => positivePairs(P +Int 1, M)
+    requires P >=Int 1
+    [simplification]
+
+  syntax ValSeq ::= pairsDone(Int, Int) [function, total]
+  syntax ValSeq ::= pairsTail(Int, Int) [function, total]
+  rule pairsDone(C:Int, _:Int) => .ValSeq requires C <=Int 0
+  rule pairsDone(C:Int, M:Int) => positivePairs(C, M) requires C >Int 0
+  rule pairsTail(C:Int, _:Int) => vCons(1, .ValSeq) requires C <=Int 0
+  rule pairsTail(C:Int, M:Int) => positiveHalf(C, M) requires C >Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsDone((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) ==Int 0
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsTail((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) =/=Int 0
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("pairs"), BinOp("//", Name("k"), Int(2)))
+    Assign(Name("p"), Int(0))
+    resultLoop
+    If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(1))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+      .Stmts)
+    Return(Name("result"))
+
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68c62111e60d1346c623cc0298a157c0224466e7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,39 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    pairs = k // 2
+    p = 0
+    while p < pairs:
+        result.append(1)
+        result.append(neighbor)
+        p = p + 1
+    if k % 2 == 1:
+        result.append(1)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95edbb42af8bda1bcd850a7a82b284d70be7cc08
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,224 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-one-ahead]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool I ==Int oneRow(P, N) andBool J <=Int oneCol(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [inner-no-one]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool notBool (I ==Int oneRow(P, N)
+                       andBool J <=Int oneCol(P, N))
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-one-ahead]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I <=Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [outer-one-past]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I >Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The final loop preserves the exact list object.  The guarded claims split
+  // the empty prefix from the injective positivePairs(P,M) summary.
+  claim [result-zero]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> 0)
+        ("p" |-> 0)
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq)
+    </heap>
+
+  claim [result-start]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (0 => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires C >Int 0
+    ensures ?OUT ==K positivePairs(C, M)
+
+  claim [result-positive]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (P:Int => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires P >=Int 1 andBool P <=Int C
+      andBool (A ==K positivePairs(P, M))
+    ensures ?OUT ==K positivePairs(C, M)
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("$perm" |-> str(P))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..edb60ed425ada3b091d1947874929c358054ae79
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,326 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  syntax Int ::= findOne(IntSeq, Int) [function, total]
+  rule findOne(.IntSeq, _:Int) => -1
+  rule findOne(iCons(1, _:IntSeq), A:Int) => A
+  rule findOne(iCons(X:Int, R:IntSeq), A:Int) => findOne(R, A +Int 1)
+    requires X =/=Int 1
+
+  syntax Int ::= oneIndex(IntSeq)
+    [function, total, symbol(oneIndex), no-evaluators]
+  rule oneIndex(P:IntSeq) => findOne(P, 0) [concrete]
+
+  syntax Int ::= oneRow(IntSeq, Int)
+    [function, total, symbol(oneRow), no-evaluators]
+  syntax Int ::= oneCol(IntSeq, Int)
+    [function, total, symbol(oneCol), no-evaluators]
+  rule oneRow(P:IntSeq, N:Int) => oneIndex(P) /Int N
+    requires N >Int 0
+    [concrete]
+  rule oneRow(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+  rule oneCol(P:IntSeq, N:Int) => pyMod(oneIndex(P), N)
+    requires N >Int 0
+    [concrete]
+  rule oneCol(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  rule (gridAt(P:IntSeq, N:Int, I:Int, J:Int) ==Int 1)
+    => (I ==Int oneRow(P, N) andBool J ==Int oneCol(P, N))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= snocVS(ValSeq, Val)
+    [function, total, symbol(snocVS), no-evaluators]
+  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq) [concrete]
+  rule snocVS(vCons(X:Val, R:ValSeq), V:Val)
+    => vCons(X, snocVS(R, V))
+    [concrete]
+
+  syntax ValSeq ::= positivePairs(Int, Int)
+    [function, total, injective, symbol(positivePairs), no-evaluators]
+  syntax ValSeq ::= positiveHalf(Int, Int)
+    [function, total, symbol(positiveHalf), no-evaluators]
+
+  rule positivePairs(P:Int, M:Int)
+    => vCons(false, vCons(P, vCons(M, .ValSeq)))
+    requires P <=Int 0
+    [concrete]
+  rule positivePairs(1, M:Int) => vCons(1, vCons(M, .ValSeq))
+    [concrete]
+  rule positivePairs(P:Int, M:Int)
+    => snocVS(snocVS(positivePairs(P -Int 1, M), 1), M)
+    requires P >Int 1
+    [concrete]
+  rule positiveHalf(P:Int, M:Int) => snocVS(positivePairs(P, M), 1)
+    [concrete]
+
+  rule valSeqConcat(vCons(1, .ValSeq), vCons(M:Int, .ValSeq))
+    => positivePairs(1, M)
+    [simplification]
+  rule valSeqConcat(positivePairs(P:Int, M:Int), vCons(1, .ValSeq))
+    => positiveHalf(P, M)
+    requires P >=Int 1
+    [simplification]
+  rule valSeqConcat(positiveHalf(P:Int, M:Int), vCons(M, .ValSeq))
+    => positivePairs(P +Int 1, M)
+    requires P >=Int 1
+    [simplification]
+
+  syntax ValSeq ::= pairsDone(Int, Int) [function, total]
+  syntax ValSeq ::= pairsTail(Int, Int) [function, total]
+  rule pairsDone(C:Int, _:Int) => .ValSeq requires C <=Int 0
+  rule pairsDone(C:Int, M:Int) => positivePairs(C, M) requires C >Int 0
+  rule pairsTail(C:Int, _:Int) => vCons(1, .ValSeq) requires C <=Int 0
+  rule pairsTail(C:Int, M:Int) => positiveHalf(C, M) requires C >Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsDone((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) ==Int 0
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsTail((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) =/=Int 0
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("pairs"), BinOp("//", Name("k"), Int(2)))
+    Assign(Name("p"), Int(0))
+    resultLoop
+    If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(1))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+      .Stmts)
+    Return(Name("result"))
+
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.result-positive' in /workspace
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68c62111e60d1346c623cc0298a157c0224466e7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,39 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    pairs = k // 2
+    p = 0
+    while p < pairs:
+        result.append(1)
+        result.append(neighbor)
+        p = p + 1
+    if k % 2 == 1:
+        result.append(1)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95edbb42af8bda1bcd850a7a82b284d70be7cc08
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,224 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-one-ahead]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool I ==Int oneRow(P, N) andBool J <=Int oneCol(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [inner-no-one]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool notBool (I ==Int oneRow(P, N)
+                       andBool J <=Int oneCol(P, N))
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-one-ahead]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I <=Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [outer-one-past]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I >Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The final loop preserves the exact list object.  The guarded claims split
+  // the empty prefix from the injective positivePairs(P,M) summary.
+  claim [result-zero]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> 0)
+        ("p" |-> 0)
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq)
+    </heap>
+
+  claim [result-start]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (0 => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires C >Int 0
+    ensures ?OUT ==K positivePairs(C, M)
+
+  claim [result-positive]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (P:Int => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires P >=Int 1 andBool P <=Int C
+      andBool (A ==K positivePairs(P, M))
+    ensures ?OUT ==K positivePairs(C, M)
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("$perm" |-> str(P))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..edb60ed425ada3b091d1947874929c358054ae79
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,326 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  syntax Int ::= findOne(IntSeq, Int) [function, total]
+  rule findOne(.IntSeq, _:Int) => -1
+  rule findOne(iCons(1, _:IntSeq), A:Int) => A
+  rule findOne(iCons(X:Int, R:IntSeq), A:Int) => findOne(R, A +Int 1)
+    requires X =/=Int 1
+
+  syntax Int ::= oneIndex(IntSeq)
+    [function, total, symbol(oneIndex), no-evaluators]
+  rule oneIndex(P:IntSeq) => findOne(P, 0) [concrete]
+
+  syntax Int ::= oneRow(IntSeq, Int)
+    [function, total, symbol(oneRow), no-evaluators]
+  syntax Int ::= oneCol(IntSeq, Int)
+    [function, total, symbol(oneCol), no-evaluators]
+  rule oneRow(P:IntSeq, N:Int) => oneIndex(P) /Int N
+    requires N >Int 0
+    [concrete]
+  rule oneRow(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+  rule oneCol(P:IntSeq, N:Int) => pyMod(oneIndex(P), N)
+    requires N >Int 0
+    [concrete]
+  rule oneCol(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  rule (gridAt(P:IntSeq, N:Int, I:Int, J:Int) ==Int 1)
+    => (I ==Int oneRow(P, N) andBool J ==Int oneCol(P, N))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= snocVS(ValSeq, Val)
+    [function, total, symbol(snocVS), no-evaluators]
+  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq) [concrete]
+  rule snocVS(vCons(X:Val, R:ValSeq), V:Val)
+    => vCons(X, snocVS(R, V))
+    [concrete]
+
+  syntax ValSeq ::= positivePairs(Int, Int)
+    [function, total, injective, symbol(positivePairs), no-evaluators]
+  syntax ValSeq ::= positiveHalf(Int, Int)
+    [function, total, symbol(positiveHalf), no-evaluators]
+
+  rule positivePairs(P:Int, M:Int)
+    => vCons(false, vCons(P, vCons(M, .ValSeq)))
+    requires P <=Int 0
+    [concrete]
+  rule positivePairs(1, M:Int) => vCons(1, vCons(M, .ValSeq))
+    [concrete]
+  rule positivePairs(P:Int, M:Int)
+    => snocVS(snocVS(positivePairs(P -Int 1, M), 1), M)
+    requires P >Int 1
+    [concrete]
+  rule positiveHalf(P:Int, M:Int) => snocVS(positivePairs(P, M), 1)
+    [concrete]
+
+  rule valSeqConcat(vCons(1, .ValSeq), vCons(M:Int, .ValSeq))
+    => positivePairs(1, M)
+    [simplification]
+  rule valSeqConcat(positivePairs(P:Int, M:Int), vCons(1, .ValSeq))
+    => positiveHalf(P, M)
+    requires P >=Int 1
+    [simplification]
+  rule valSeqConcat(positiveHalf(P:Int, M:Int), vCons(M, .ValSeq))
+    => positivePairs(P +Int 1, M)
+    requires P >=Int 1
+    [simplification]
+
+  syntax ValSeq ::= pairsDone(Int, Int) [function, total]
+  syntax ValSeq ::= pairsTail(Int, Int) [function, total]
+  rule pairsDone(C:Int, _:Int) => .ValSeq requires C <=Int 0
+  rule pairsDone(C:Int, M:Int) => positivePairs(C, M) requires C >Int 0
+  rule pairsTail(C:Int, _:Int) => vCons(1, .ValSeq) requires C <=Int 0
+  rule pairsTail(C:Int, M:Int) => positiveHalf(C, M) requires C >Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsDone((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) ==Int 0
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsTail((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) =/=Int 0
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("pairs"), BinOp("//", Name("k"), Int(2)))
+    Assign(Name("p"), Int(0))
+    resultLoop
+    If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(1))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+      .Stmts)
+    Return(Name("result"))
+
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68c62111e60d1346c623cc0298a157c0224466e7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,39 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    pairs = k // 2
+    p = 0
+    while p < pairs:
+        result.append(1)
+        result.append(neighbor)
+        p = p + 1
+    if k % 2 == 1:
+        result.append(1)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95edbb42af8bda1bcd850a7a82b284d70be7cc08
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,224 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-one-ahead]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool I ==Int oneRow(P, N) andBool J <=Int oneCol(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [inner-no-one]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool notBool (I ==Int oneRow(P, N)
+                       andBool J <=Int oneCol(P, N))
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-one-ahead]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I <=Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [outer-one-past]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I >Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The final loop preserves the exact list object.  The guarded claims split
+  // the empty prefix from the injective positivePairs(P,M) summary.
+  claim [result-zero]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> 0)
+        ("p" |-> 0)
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq)
+    </heap>
+
+  claim [result-start]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (0 => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires C >Int 0
+    ensures ?OUT ==K positivePairs(C, M)
+
+  claim [result-positive]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (P:Int => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires P >=Int 1 andBool P <=Int C
+      andBool (A ==K positivePairs(P, M))
+    ensures ?OUT ==K positivePairs(C, M)
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("$perm" |-> str(P))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..edb60ed425ada3b091d1947874929c358054ae79
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,326 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  syntax Int ::= findOne(IntSeq, Int) [function, total]
+  rule findOne(.IntSeq, _:Int) => -1
+  rule findOne(iCons(1, _:IntSeq), A:Int) => A
+  rule findOne(iCons(X:Int, R:IntSeq), A:Int) => findOne(R, A +Int 1)
+    requires X =/=Int 1
+
+  syntax Int ::= oneIndex(IntSeq)
+    [function, total, symbol(oneIndex), no-evaluators]
+  rule oneIndex(P:IntSeq) => findOne(P, 0) [concrete]
+
+  syntax Int ::= oneRow(IntSeq, Int)
+    [function, total, symbol(oneRow), no-evaluators]
+  syntax Int ::= oneCol(IntSeq, Int)
+    [function, total, symbol(oneCol), no-evaluators]
+  rule oneRow(P:IntSeq, N:Int) => oneIndex(P) /Int N
+    requires N >Int 0
+    [concrete]
+  rule oneRow(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+  rule oneCol(P:IntSeq, N:Int) => pyMod(oneIndex(P), N)
+    requires N >Int 0
+    [concrete]
+  rule oneCol(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  rule (gridAt(P:IntSeq, N:Int, I:Int, J:Int) ==Int 1)
+    => (I ==Int oneRow(P, N) andBool J ==Int oneCol(P, N))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= snocVS(ValSeq, Val)
+    [function, total, symbol(snocVS), no-evaluators]
+  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq) [concrete]
+  rule snocVS(vCons(X:Val, R:ValSeq), V:Val)
+    => vCons(X, snocVS(R, V))
+    [concrete]
+
+  syntax ValSeq ::= positivePairs(Int, Int)
+    [function, total, injective, symbol(positivePairs), no-evaluators]
+  syntax ValSeq ::= positiveHalf(Int, Int)
+    [function, total, symbol(positiveHalf), no-evaluators]
+
+  rule positivePairs(P:Int, M:Int)
+    => vCons(false, vCons(P, vCons(M, .ValSeq)))
+    requires P <=Int 0
+    [concrete]
+  rule positivePairs(1, M:Int) => vCons(1, vCons(M, .ValSeq))
+    [concrete]
+  rule positivePairs(P:Int, M:Int)
+    => snocVS(snocVS(positivePairs(P -Int 1, M), 1), M)
+    requires P >Int 1
+    [concrete]
+  rule positiveHalf(P:Int, M:Int) => snocVS(positivePairs(P, M), 1)
+    [concrete]
+
+  rule valSeqConcat(vCons(1, .ValSeq), vCons(M:Int, .ValSeq))
+    => positivePairs(1, M)
+    [simplification]
+  rule valSeqConcat(positivePairs(P:Int, M:Int), vCons(1, .ValSeq))
+    => positiveHalf(P, M)
+    requires P >=Int 1
+    [simplification]
+  rule valSeqConcat(positiveHalf(P:Int, M:Int), vCons(M, .ValSeq))
+    => positivePairs(P +Int 1, M)
+    requires P >=Int 1
+    [simplification]
+
+  syntax ValSeq ::= pairsDone(Int, Int) [function, total]
+  syntax ValSeq ::= pairsTail(Int, Int) [function, total]
+  rule pairsDone(C:Int, _:Int) => .ValSeq requires C <=Int 0
+  rule pairsDone(C:Int, M:Int) => positivePairs(C, M) requires C >Int 0
+  rule pairsTail(C:Int, _:Int) => vCons(1, .ValSeq) requires C <=Int 0
+  rule pairsTail(C:Int, M:Int) => positiveHalf(C, M) requires C >Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsDone((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) ==Int 0
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsTail((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) =/=Int 0
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("pairs"), BinOp("//", Name("k"), Int(2)))
+    Assign(Name("p"), Int(0))
+    resultLoop
+    If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(1))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+      .Stmts)
+    Return(Name("result"))
+
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68c62111e60d1346c623cc0298a157c0224466e7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,39 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    pairs = k // 2
+    p = 0
+    while p < pairs:
+        result.append(1)
+        result.append(neighbor)
+        p = p + 1
+    if k % 2 == 1:
+        result.append(1)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95edbb42af8bda1bcd850a7a82b284d70be7cc08
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,224 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-one-ahead]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool I ==Int oneRow(P, N) andBool J <=Int oneCol(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [inner-no-one]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool notBool (I ==Int oneRow(P, N)
+                       andBool J <=Int oneCol(P, N))
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-one-ahead]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I <=Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [outer-one-past]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I >Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The final loop preserves the exact list object.  The guarded claims split
+  // the empty prefix from the injective positivePairs(P,M) summary.
+  claim [result-zero]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> 0)
+        ("p" |-> 0)
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq)
+    </heap>
+
+  claim [result-start]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (0 => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires C >Int 0
+    ensures ?OUT ==K positivePairs(C, M)
+
+  claim [result-positive]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (P:Int => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires P >=Int 1 andBool P <=Int C
+      andBool (A ==K positivePairs(P, M))
+    ensures ?OUT ==K positivePairs(C, M)
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("$perm" |-> str(P))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..edb60ed425ada3b091d1947874929c358054ae79
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,326 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  syntax Int ::= findOne(IntSeq, Int) [function, total]
+  rule findOne(.IntSeq, _:Int) => -1
+  rule findOne(iCons(1, _:IntSeq), A:Int) => A
+  rule findOne(iCons(X:Int, R:IntSeq), A:Int) => findOne(R, A +Int 1)
+    requires X =/=Int 1
+
+  syntax Int ::= oneIndex(IntSeq)
+    [function, total, symbol(oneIndex), no-evaluators]
+  rule oneIndex(P:IntSeq) => findOne(P, 0) [concrete]
+
+  syntax Int ::= oneRow(IntSeq, Int)
+    [function, total, symbol(oneRow), no-evaluators]
+  syntax Int ::= oneCol(IntSeq, Int)
+    [function, total, symbol(oneCol), no-evaluators]
+  rule oneRow(P:IntSeq, N:Int) => oneIndex(P) /Int N
+    requires N >Int 0
+    [concrete]
+  rule oneRow(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+  rule oneCol(P:IntSeq, N:Int) => pyMod(oneIndex(P), N)
+    requires N >Int 0
+    [concrete]
+  rule oneCol(_:IntSeq, N:Int) => 0
+    requires N <=Int 0
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  rule (gridAt(P:IntSeq, N:Int, I:Int, J:Int) ==Int 1)
+    => (I ==Int oneRow(P, N) andBool J ==Int oneCol(P, N))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= snocVS(ValSeq, Val)
+    [function, total, symbol(snocVS), no-evaluators]
+  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq) [concrete]
+  rule snocVS(vCons(X:Val, R:ValSeq), V:Val)
+    => vCons(X, snocVS(R, V))
+    [concrete]
+
+  syntax ValSeq ::= positivePairs(Int, Int)
+    [function, total, injective, symbol(positivePairs), no-evaluators]
+  syntax ValSeq ::= positiveHalf(Int, Int)
+    [function, total, symbol(positiveHalf), no-evaluators]
+
+  rule positivePairs(P:Int, M:Int)
+    => vCons(false, vCons(P, vCons(M, .ValSeq)))
+    requires P <=Int 0
+    [concrete]
+  rule positivePairs(1, M:Int) => vCons(1, vCons(M, .ValSeq))
+    [concrete]
+  rule positivePairs(P:Int, M:Int)
+    => snocVS(snocVS(positivePairs(P -Int 1, M), 1), M)
+    requires P >Int 1
+    [concrete]
+  rule positiveHalf(P:Int, M:Int) => snocVS(positivePairs(P, M), 1)
+    [concrete]
+
+  rule valSeqConcat(vCons(1, .ValSeq), vCons(M:Int, .ValSeq))
+    => positivePairs(1, M)
+    [simplification]
+  rule valSeqConcat(positivePairs(P:Int, M:Int), vCons(1, .ValSeq))
+    => positiveHalf(P, M)
+    requires P >=Int 1
+    [simplification]
+  rule valSeqConcat(positiveHalf(P:Int, M:Int), vCons(M, .ValSeq))
+    => positivePairs(P +Int 1, M)
+    requires P >=Int 1
+    [simplification]
+
+  syntax ValSeq ::= pairsDone(Int, Int) [function, total]
+  syntax ValSeq ::= pairsTail(Int, Int) [function, total]
+  rule pairsDone(C:Int, _:Int) => .ValSeq requires C <=Int 0
+  rule pairsDone(C:Int, M:Int) => positivePairs(C, M) requires C >Int 0
+  rule pairsTail(C:Int, _:Int) => vCons(1, .ValSeq) requires C <=Int 0
+  rule pairsTail(C:Int, M:Int) => positiveHalf(C, M) requires C >Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsDone((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) ==Int 0
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pairsTail((K -Int pyMod(K, 2)) /Int 2,
+                 neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+    requires pyMod(K, 2) =/=Int 0
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("p"), CmpOp("<", Name("pairs"))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs)))
+      Expr(Call(Attribute(Name("result"), "append"),
+                (Name("neighbor"), .Exprs)))
+      Assign(Name("p"), BinOp("+", Name("p"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("pairs"), BinOp("//", Name("k"), Int(2)))
+    Assign(Name("p"), Int(0))
+    resultLoop
+    If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(1))),
+      Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+      .Stmts)
+    Return(Name("result"))
+
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68c62111e60d1346c623cc0298a157c0224466e7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,39 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    pairs = k // 2
+    p = 0
+    while p < pairs:
+        result.append(1)
+        result.append(neighbor)
+        p = p + 1
+    if k % 2 == 1:
+        result.append(1)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95edbb42af8bda1bcd850a7a82b284d70be7cc08
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,224 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-one-ahead]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool I ==Int oneRow(P, N) andBool J <=Int oneCol(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [inner-no-one]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool notBool (I ==Int oneRow(P, N)
+                       andBool J <=Int oneCol(P, N))
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-one-ahead]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I <=Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [outer-one-past]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I >Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The final loop preserves the exact list object.  The guarded claims split
+  // the empty prefix from the injective positivePairs(P,M) summary.
+  claim [result-zero]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> 0)
+        ("p" |-> 0)
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq)
+    </heap>
+
+  claim [result-start]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (0 => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(.ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires C >Int 0
+    ensures ?OUT ==K positivePairs(C, M)
+
+  claim [result-positive]:
+    <k> resultWhile => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("grid" |-> list(gridRows(PSEQ:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("row" |-> oneRow(PSEQ, N))
+        ("col" |-> oneCol(PSEQ, N))
+        ("i" |-> N)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (P:Int => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(
+        ("$perm" |-> str(PSEQ))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => ?OUT:ValSeq)
+    </heap>
+    requires P >=Int 1 andBool P <=Int C
+      andBool (A ==K positivePairs(P, M))
+    ensures ?OUT ==K positivePairs(C, M)
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("$perm" |-> str(P))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..edb60ed425ada3b091d1947874929c358054ae79
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,326 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
