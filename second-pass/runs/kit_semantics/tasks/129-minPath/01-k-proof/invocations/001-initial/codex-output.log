+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= innerRowAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+  syntax Int ::= innerColAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+
+  rule innerRowAfter(_:IntSeq, N:Int, _:Int, J:Int, R:Int) => R
+    requires J >=Int N
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerRowAfter(P, N, I, J +Int 1, I)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, R:Int)
+    => innerRowAfter(P, N, I, J +Int 1, R)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  rule innerColAfter(_:IntSeq, N:Int, _:Int, J:Int, C:Int) => C
+    requires J >=Int N
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerColAfter(P, N, I, J +Int 1, J)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, C:Int)
+    => innerColAfter(P, N, I, J +Int 1, C)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  syntax Int ::= outerRowAfter(IntSeq, Int, Int, Int)
+    [function, total]
+  syntax Int ::= outerColAfter(IntSeq, Int, Int, Int)
+    [function, total]
+
+  rule outerRowAfter(_:IntSeq, N:Int, I:Int, R:Int) => R
+    requires I >=Int N
+  rule outerRowAfter(P:IntSeq, N:Int, I:Int, R:Int)
+    => outerRowAfter(P, N, I +Int 1,
+                     innerRowAfter(P, N, I, 0, R))
+    requires I <Int N
+
+  rule outerColAfter(_:IntSeq, N:Int, I:Int, C:Int) => C
+    requires I >=Int N
+  rule outerColAfter(P:IntSeq, N:Int, I:Int, C:Int)
+    => outerColAfter(P, N, I +Int 1,
+                     innerColAfter(P, N, I, 0, C))
+    requires I <Int N
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= pathFrom(Int, Int, Int) [function, total]
+  rule pathFrom(T:Int, K:Int, _:Int) => .ValSeq
+    requires T >=Int K
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(1, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) ==Int 0
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(M, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) =/=Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pathFrom(0, K,
+         neighborMin(P, N,
+           outerRowAfter(P, N, 0, 0),
+           outerColAfter(P, N, 0, 0)))
+
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A [simplification]
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("t"), Int(0))
+    resultLoop
+    Return(Name("result"))
+
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.result-loop' in /workspace
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68d8538190beba7722a588e420288d9931a39608
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,38 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    t = 0
+    while t < k:
+        if t % 2 == 0:
+            result.append(1)
+        else:
+            result.append(neighbor)
+        t = t + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9852400407b11704e7f3b3b309f3456a4ff3c3cc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-loop]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (R:Int => innerRowAfter(P, N, I, J, R)))
+        ("col" |-> (C:Int => innerColAfter(P, N, I, J, C))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-loop]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => N))
+        ("row" |-> (R:Int => outerRowAfter(P, N, I, R)))
+        ("col" |-> (C:Int => outerColAfter(P, N, I, C))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+
+  // The final loop preserves the exact list object and appends the alternating
+  // suffix beginning at symbolic counter T.  A is a fully symbolic prefix.
+  claim [result-loop]:
+    <k> resultWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> _GRID:Val)
+        ("k" |-> K:Int)
+        ("n" |-> _N:Int)
+        ("row" |-> _R:Int)
+        ("col" |-> _C:Int)
+        ("i" |-> _I:Int)
+        ("j" |-> _J:Int)
+        ("t" |-> (T:Int => K))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => valSeqConcat(A, pathFrom(T, K, M)))
+      RESTHEAP:Map
+    </heap>
+    requires T >=Int 0 andBool T <=Int K
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                  minPathBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c6c66499146b99264fe53498eb50bca6a3ce95b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,297 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= innerRowAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+  syntax Int ::= innerColAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+
+  rule innerRowAfter(_:IntSeq, N:Int, _:Int, J:Int, R:Int) => R
+    requires J >=Int N
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerRowAfter(P, N, I, J +Int 1, I)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, R:Int)
+    => innerRowAfter(P, N, I, J +Int 1, R)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  rule innerColAfter(_:IntSeq, N:Int, _:Int, J:Int, C:Int) => C
+    requires J >=Int N
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerColAfter(P, N, I, J +Int 1, J)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, C:Int)
+    => innerColAfter(P, N, I, J +Int 1, C)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  syntax Int ::= outerRowAfter(IntSeq, Int, Int, Int)
+    [function, total]
+  syntax Int ::= outerColAfter(IntSeq, Int, Int, Int)
+    [function, total]
+
+  rule outerRowAfter(_:IntSeq, N:Int, I:Int, R:Int) => R
+    requires I >=Int N
+  rule outerRowAfter(P:IntSeq, N:Int, I:Int, R:Int)
+    => outerRowAfter(P, N, I +Int 1,
+                     innerRowAfter(P, N, I, 0, R))
+    requires I <Int N
+
+  rule outerColAfter(_:IntSeq, N:Int, I:Int, C:Int) => C
+    requires I >=Int N
+  rule outerColAfter(P:IntSeq, N:Int, I:Int, C:Int)
+    => outerColAfter(P, N, I +Int 1,
+                     innerColAfter(P, N, I, 0, C))
+    requires I <Int N
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= pathFrom(Int, Int, Int) [function, total]
+  rule pathFrom(T:Int, K:Int, _:Int) => .ValSeq
+    requires T >=Int K
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(1, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) ==Int 0
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(M, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) =/=Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pathFrom(0, K,
+         neighborMin(P, N,
+           outerRowAfter(P, N, 0, 0),
+           outerColAfter(P, N, 0, 0)))
+
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A [simplification]
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("t"), Int(0))
+    resultLoop
+    Return(Name("result"))
+
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68d8538190beba7722a588e420288d9931a39608
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,38 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    t = 0
+    while t < k:
+        if t % 2 == 0:
+            result.append(1)
+        else:
+            result.append(neighbor)
+        t = t + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9852400407b11704e7f3b3b309f3456a4ff3c3cc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-loop]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (R:Int => innerRowAfter(P, N, I, J, R)))
+        ("col" |-> (C:Int => innerColAfter(P, N, I, J, C))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-loop]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => N))
+        ("row" |-> (R:Int => outerRowAfter(P, N, I, R)))
+        ("col" |-> (C:Int => outerColAfter(P, N, I, C))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+
+  // The final loop preserves the exact list object and appends the alternating
+  // suffix beginning at symbolic counter T.  A is a fully symbolic prefix.
+  claim [result-loop]:
+    <k> resultWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> _GRID:Val)
+        ("k" |-> K:Int)
+        ("n" |-> _N:Int)
+        ("row" |-> _R:Int)
+        ("col" |-> _C:Int)
+        ("i" |-> _I:Int)
+        ("j" |-> _J:Int)
+        ("t" |-> (T:Int => K))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => valSeqConcat(A, pathFrom(T, K, M)))
+      RESTHEAP:Map
+    </heap>
+    requires T >=Int 0 andBool T <=Int K
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                  minPathBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c6c66499146b99264fe53498eb50bca6a3ce95b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,297 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= innerRowAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+  syntax Int ::= innerColAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+
+  rule innerRowAfter(_:IntSeq, N:Int, _:Int, J:Int, R:Int) => R
+    requires J >=Int N
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerRowAfter(P, N, I, J +Int 1, I)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, R:Int)
+    => innerRowAfter(P, N, I, J +Int 1, R)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  rule innerColAfter(_:IntSeq, N:Int, _:Int, J:Int, C:Int) => C
+    requires J >=Int N
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerColAfter(P, N, I, J +Int 1, J)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, C:Int)
+    => innerColAfter(P, N, I, J +Int 1, C)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  syntax Int ::= outerRowAfter(IntSeq, Int, Int, Int)
+    [function, total]
+  syntax Int ::= outerColAfter(IntSeq, Int, Int, Int)
+    [function, total]
+
+  rule outerRowAfter(_:IntSeq, N:Int, I:Int, R:Int) => R
+    requires I >=Int N
+  rule outerRowAfter(P:IntSeq, N:Int, I:Int, R:Int)
+    => outerRowAfter(P, N, I +Int 1,
+                     innerRowAfter(P, N, I, 0, R))
+    requires I <Int N
+
+  rule outerColAfter(_:IntSeq, N:Int, I:Int, C:Int) => C
+    requires I >=Int N
+  rule outerColAfter(P:IntSeq, N:Int, I:Int, C:Int)
+    => outerColAfter(P, N, I +Int 1,
+                     innerColAfter(P, N, I, 0, C))
+    requires I <Int N
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= pathFrom(Int, Int, Int) [function, total]
+  rule pathFrom(T:Int, K:Int, _:Int) => .ValSeq
+    requires T >=Int K
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(1, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) ==Int 0
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(M, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) =/=Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pathFrom(0, K,
+         neighborMin(P, N,
+           outerRowAfter(P, N, 0, 0),
+           outerColAfter(P, N, 0, 0)))
+
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A [simplification]
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("t"), Int(0))
+    resultLoop
+    Return(Name("result"))
+
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68d8538190beba7722a588e420288d9931a39608
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,38 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    t = 0
+    while t < k:
+        if t % 2 == 0:
+            result.append(1)
+        else:
+            result.append(neighbor)
+        t = t + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9852400407b11704e7f3b3b309f3456a4ff3c3cc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-loop]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (R:Int => innerRowAfter(P, N, I, J, R)))
+        ("col" |-> (C:Int => innerColAfter(P, N, I, J, C))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-loop]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => N))
+        ("row" |-> (R:Int => outerRowAfter(P, N, I, R)))
+        ("col" |-> (C:Int => outerColAfter(P, N, I, C))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+
+  // The final loop preserves the exact list object and appends the alternating
+  // suffix beginning at symbolic counter T.  A is a fully symbolic prefix.
+  claim [result-loop]:
+    <k> resultWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> _GRID:Val)
+        ("k" |-> K:Int)
+        ("n" |-> _N:Int)
+        ("row" |-> _R:Int)
+        ("col" |-> _C:Int)
+        ("i" |-> _I:Int)
+        ("j" |-> _J:Int)
+        ("t" |-> (T:Int => K))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => valSeqConcat(A, pathFrom(T, K, M)))
+      RESTHEAP:Map
+    </heap>
+    requires T >=Int 0 andBool T <=Int K
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                  minPathBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c6c66499146b99264fe53498eb50bca6a3ce95b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,297 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= innerRowAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+  syntax Int ::= innerColAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+
+  rule innerRowAfter(_:IntSeq, N:Int, _:Int, J:Int, R:Int) => R
+    requires J >=Int N
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerRowAfter(P, N, I, J +Int 1, I)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, R:Int)
+    => innerRowAfter(P, N, I, J +Int 1, R)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  rule innerColAfter(_:IntSeq, N:Int, _:Int, J:Int, C:Int) => C
+    requires J >=Int N
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerColAfter(P, N, I, J +Int 1, J)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, C:Int)
+    => innerColAfter(P, N, I, J +Int 1, C)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  syntax Int ::= outerRowAfter(IntSeq, Int, Int, Int)
+    [function, total]
+  syntax Int ::= outerColAfter(IntSeq, Int, Int, Int)
+    [function, total]
+
+  rule outerRowAfter(_:IntSeq, N:Int, I:Int, R:Int) => R
+    requires I >=Int N
+  rule outerRowAfter(P:IntSeq, N:Int, I:Int, R:Int)
+    => outerRowAfter(P, N, I +Int 1,
+                     innerRowAfter(P, N, I, 0, R))
+    requires I <Int N
+
+  rule outerColAfter(_:IntSeq, N:Int, I:Int, C:Int) => C
+    requires I >=Int N
+  rule outerColAfter(P:IntSeq, N:Int, I:Int, C:Int)
+    => outerColAfter(P, N, I +Int 1,
+                     innerColAfter(P, N, I, 0, C))
+    requires I <Int N
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= pathFrom(Int, Int, Int) [function, total]
+  rule pathFrom(T:Int, K:Int, _:Int) => .ValSeq
+    requires T >=Int K
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(1, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) ==Int 0
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(M, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) =/=Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pathFrom(0, K,
+         neighborMin(P, N,
+           outerRowAfter(P, N, 0, 0),
+           outerColAfter(P, N, 0, 0)))
+
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A [simplification]
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("t"), Int(0))
+    resultLoop
+    Return(Name("result"))
+
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68d8538190beba7722a588e420288d9931a39608
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,38 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    t = 0
+    while t < k:
+        if t % 2 == 0:
+            result.append(1)
+        else:
+            result.append(neighbor)
+        t = t + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9852400407b11704e7f3b3b309f3456a4ff3c3cc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-loop]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (R:Int => innerRowAfter(P, N, I, J, R)))
+        ("col" |-> (C:Int => innerColAfter(P, N, I, J, C))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-loop]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => N))
+        ("row" |-> (R:Int => outerRowAfter(P, N, I, R)))
+        ("col" |-> (C:Int => outerColAfter(P, N, I, C))),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+
+  // The final loop preserves the exact list object and appends the alternating
+  // suffix beginning at symbolic counter T.  A is a fully symbolic prefix.
+  claim [result-loop]:
+    <k> resultWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> _GRID:Val)
+        ("k" |-> K:Int)
+        ("n" |-> _N:Int)
+        ("row" |-> _R:Int)
+        ("col" |-> _C:Int)
+        ("i" |-> _I:Int)
+        ("j" |-> _J:Int)
+        ("t" |-> (T:Int => K))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => valSeqConcat(A, pathFrom(T, K, M)))
+      RESTHEAP:Map
+    </heap>
+    requires T >=Int 0 andBool T <=Int K
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                  minPathBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c6c66499146b99264fe53498eb50bca6a3ce95b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,297 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // -----------------------------------------------------------------------
+  // A row-major mathematical representation of every valid input grid.
+  // The [concrete] equations give the selectors a fixed denotation without
+  // forcing symbolic P or N to unroll during proof.
+  // -----------------------------------------------------------------------
+
+  syntax Bool ::= intMember(Int, IntSeq) [function, total]
+  rule intMember(_:Int, .IntSeq) => false
+  rule intMember(X:Int, iCons(Y:Int, R:IntSeq))
+    => (X ==Int Y) orBool intMember(X, R)
+
+  syntax Bool ::= allInRange(IntSeq, Int) [function, total]
+  rule allInRange(.IntSeq, _:Int) => true
+  rule allInRange(iCons(X:Int, R:IntSeq), M:Int)
+    => (1 <=Int X andBool X <=Int M) andBool allInRange(R, M)
+
+  syntax Bool ::= uniqueInts(IntSeq) [function, total]
+  rule uniqueInts(.IntSeq) => true
+  rule uniqueInts(iCons(X:Int, R:IntSeq))
+    => notBool intMember(X, R) andBool uniqueInts(R)
+
+  syntax Bool ::= validPerm(IntSeq, Int)
+    [function, total, symbol(validPerm), no-evaluators]
+  rule validPerm(P:IntSeq, M:Int)
+    => (isLen(P) ==Int M) andBool allInRange(P, M) andBool uniqueInts(P)
+    [concrete]
+
+  syntax ValSeq ::= gridRows(IntSeq, Int)
+    [function, total, symbol(gridRows), no-evaluators]
+  syntax ValSeq ::= gridRowsFrom(IntSeq, Int, Int)
+    [function, total, symbol(gridRowsFrom), no-evaluators]
+  syntax ValSeq ::= gridRow(IntSeq, Int, Int)
+    [function, total, symbol(gridRow), no-evaluators]
+  syntax ValSeq ::= gridRowFrom(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridRowFrom), no-evaluators]
+
+  syntax Int ::= pAtTotal(IntSeq, Int) [function, total]
+  rule pAtTotal(.IntSeq, _:Int) => 0
+  rule pAtTotal(iCons(X:Int, _:IntSeq), 0) => X
+  rule pAtTotal(iCons(_:Int, R:IntSeq), I:Int) => pAtTotal(R, I -Int 1)
+    requires I >Int 0
+  rule pAtTotal(iCons(_:Int, _:IntSeq), I:Int) => 0
+    requires I <Int 0
+
+  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]
+  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+    [concrete]
+  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)
+    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))
+    requires I <Int N
+    [concrete]
+
+  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)
+    [concrete]
+  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq
+    requires J >=Int N
+    [concrete]
+  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)
+    => vCons(pAtTotal(P, I *Int N +Int J),
+             gridRowFrom(P, N, I, J +Int 1))
+    requires J <Int N
+    [concrete]
+
+  syntax Int ::= gridAt(IntSeq, Int, Int, Int)
+    [function, total, symbol(gridAt), no-evaluators]
+  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)
+    => pAtTotal(P, I *Int N +Int J)
+    [concrete]
+
+  // Guarded functional access lemmas.  They expose only the fixed grid
+  // selectors at valid indices; Python's evaluation and control remain intact.
+  rule vsLen(gridRows(P:IntSeq, N:Int)) => N
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+    [simplification]
+
+  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)
+    => list(gridRow(P, N, I))
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+    [simplification]
+
+  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)
+    => gridAt(P, N, I, J)
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <Int N
+    [simplification]
+
+  // -----------------------------------------------------------------------
+  // Pure summaries used by the loop claims and final postcondition.
+  // -----------------------------------------------------------------------
+
+  syntax Int ::= innerRowAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+  syntax Int ::= innerColAfter(IntSeq, Int, Int, Int, Int)
+    [function, total]
+
+  rule innerRowAfter(_:IntSeq, N:Int, _:Int, J:Int, R:Int) => R
+    requires J >=Int N
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerRowAfter(P, N, I, J +Int 1, I)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerRowAfter(P:IntSeq, N:Int, I:Int, J:Int, R:Int)
+    => innerRowAfter(P, N, I, J +Int 1, R)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  rule innerColAfter(_:IntSeq, N:Int, _:Int, J:Int, C:Int) => C
+    requires J >=Int N
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, _:Int)
+    => innerColAfter(P, N, I, J +Int 1, J)
+    requires J <Int N andBool gridAt(P, N, I, J) ==Int 1
+  rule innerColAfter(P:IntSeq, N:Int, I:Int, J:Int, C:Int)
+    => innerColAfter(P, N, I, J +Int 1, C)
+    requires J <Int N andBool gridAt(P, N, I, J) =/=Int 1
+
+  syntax Int ::= outerRowAfter(IntSeq, Int, Int, Int)
+    [function, total]
+  syntax Int ::= outerColAfter(IntSeq, Int, Int, Int)
+    [function, total]
+
+  rule outerRowAfter(_:IntSeq, N:Int, I:Int, R:Int) => R
+    requires I >=Int N
+  rule outerRowAfter(P:IntSeq, N:Int, I:Int, R:Int)
+    => outerRowAfter(P, N, I +Int 1,
+                     innerRowAfter(P, N, I, 0, R))
+    requires I <Int N
+
+  rule outerColAfter(_:IntSeq, N:Int, I:Int, C:Int) => C
+    requires I >=Int N
+  rule outerColAfter(P:IntSeq, N:Int, I:Int, C:Int)
+    => outerColAfter(P, N, I +Int 1,
+                     innerColAfter(P, N, I, 0, C))
+    requires I <Int N
+
+  syntax Int ::= chooseMin(Int, Int, Bool) [function, total]
+  rule chooseMin(B:Int, _:Int, false) => B
+  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B
+  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B
+
+  syntax Int ::= bestUp(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestDown(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= bestLeft(IntSeq, Int, Int, Int) [function, total]
+  syntax Int ::= neighborMin(IntSeq, Int, Int, Int) [function, total]
+
+  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(N *Int N +Int 1,
+                 gridAt(P, N, R -Int 1, C),
+                 R >Int 0)
+  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestUp(P, N, R, C),
+                 gridAt(P, N, R +Int 1, C),
+                 R +Int 1 <Int N)
+  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestDown(P, N, R, C),
+                 gridAt(P, N, R, C -Int 1),
+                 C >Int 0)
+  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)
+    => chooseMin(bestLeft(P, N, R, C),
+                 gridAt(P, N, R, C +Int 1),
+                 C +Int 1 <Int N)
+
+  syntax ValSeq ::= pathFrom(Int, Int, Int) [function, total]
+  rule pathFrom(T:Int, K:Int, _:Int) => .ValSeq
+    requires T >=Int K
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(1, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) ==Int 0
+  rule pathFrom(T:Int, K:Int, M:Int)
+    => vCons(M, pathFrom(T +Int 1, K, M))
+    requires T <Int K andBool pyMod(T, 2) =/=Int 0
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pathFrom(0, K,
+         neighborMin(P, N,
+           outerRowAfter(P, N, 0, 0),
+           outerColAfter(P, N, 0, 0)))
+
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A [simplification]
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
+
+  syntax Stmt ::= "innerLoop" [macro]
+  rule innerLoop =>
+    While(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax KItem ::= "innerWhile" [macro]
+  rule innerWhile =>
+    #while(Compare(Name("j"), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+                 CmpOp("==", Int(1))),
+        Assign(Name("row"), Name("i"))
+        Assign(Name("col"), Name("j")),
+        .Stmts)
+      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+
+  syntax Stmt ::= "outerLoop" [macro]
+  rule outerLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax KItem ::= "outerWhile" [macro]
+  rule outerWhile =>
+    #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(Name("j"), Int(0))
+      innerLoop
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Stmt ::= "resultLoop" [macro]
+  rule resultLoop =>
+    While(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax KItem ::= "resultWhile" [macro]
+  rule resultWhile =>
+    #while(Compare(Name("t"), CmpOp("<", Name("k"))),
+      If(Compare(BinOp("%", Name("t"), Int(2)), CmpOp("==", Int(0))),
+        Expr(Call(Attribute(Name("result"), "append"), (Int(1), .Exprs))),
+        Expr(Call(Attribute(Name("result"), "append"),
+                  (Name("neighbor"), .Exprs))))
+      Assign(Name("t"), BinOp("+", Name("t"), Int(1))))
+
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), (Name("grid"), .Exprs)))
+    Assign(Name("row"), Int(0))
+    Assign(Name("col"), Int(0))
+    Assign(Name("i"), Int(0))
+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("t"), Int(0))
+    resultLoop
+    Return(Name("result"))
+
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..68d8538190beba7722a588e420288d9931a39608
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,38 @@
+def minPath(grid, k):
+    n = len(grid)
+
+    row = 0
+    col = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                row = i
+                col = j
+            j = j + 1
+        i = i + 1
+
+    neighbor = n * n + 1
+    if row > 0:
+        if grid[row - 1][col] < neighbor:
+            neighbor = grid[row - 1][col]
+    if row + 1 < n:
+        if grid[row + 1][col] < neighbor:
+            neighbor = grid[row + 1][col]
+    if col > 0:
+        if grid[row][col - 1] < neighbor:
+            neighbor = grid[row][col - 1]
+    if col + 1 < n:
+        if grid[row][col + 1] < neighbor:
+            neighbor = grid[row][col + 1]
+
+    result = []
+    t = 0
+    while t < k:
+        if t % 2 == 0:
+            result.append(1)
+        else:
+            result.append(neighbor)
+        t = t + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9852400407b11704e7f3b3b309f3456a4ff3c3cc
