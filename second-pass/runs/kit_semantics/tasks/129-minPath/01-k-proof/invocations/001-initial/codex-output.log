+    [concrete]
+
+  rule pathOther(snocVS(A:ValSeq, 1), T:Int +Int 1, K:Int, M:Int)
+    => pathOne(A, T, K, M)
+    requires T <Int K
+    [simplification]
+  rule pathOne(snocVS(A:ValSeq, M:Int), T:Int +Int 1, K:Int, M)
+    => pathOther(A, T, K, M)
+    requires T <Int K
+    [simplification]
+
+  syntax ValSeq ::= minPathValue(IntSeq, Int, Int) [function, total]
+  rule minPathValue(P:IntSeq, N:Int, K:Int)
+    => pathOne(.ValSeq, 0, K,
+         neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
+
+  // -----------------------------------------------------------------------
+  // Exact AST abbreviations for solution.py.  These are syntax macros only.
+  // -----------------------------------------------------------------------
