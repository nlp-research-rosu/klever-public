+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
