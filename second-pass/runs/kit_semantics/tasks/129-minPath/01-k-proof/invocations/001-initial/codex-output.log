+  claim [result-loop]:
+    <k> resultWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> _GRID:Val)
+        ("k" |-> K:Int)
+        ("n" |-> _N:Int)
+        ("row" |-> _R:Int)
+        ("col" |-> _C:Int)
+        ("i" |-> _I:Int)
+        ("j" |-> _J:Int)
+        ("t" |-> (T:Int => K))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
