+        ("n" |-> _N:Int)
+        ("row" |-> _R:Int)
+        ("col" |-> _C:Int)
+        ("i" |-> _I:Int)
+        ("j" |-> _J:Int)
+        ("pairs" |-> C:Int)
+        ("p" |-> (P:Int => C))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      -1 |-> builtinsScope
