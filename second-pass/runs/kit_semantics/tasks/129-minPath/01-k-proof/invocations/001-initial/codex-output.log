+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The inner loop scans the suffix j..N-1 of one row.  Its continuation is
+  // framed, so the claim can be used both by the outer loop and by itself at
+  // the exact while back-edge.
+  claim [inner-one-ahead]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool I ==Int oneRow(P, N) andBool J <=Int oneCol(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [inner-no-one]:
+    <k> innerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> I:Int)
+        ("j" |-> (J:Int => N))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <Int N
+      andBool J >=Int 0 andBool J <=Int N
+      andBool notBool (I ==Int oneRow(P, N)
+                       andBool J <=Int oneCol(P, N))
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The outer loop scans rows I..N-1.  The inner-loop claim supplies the
+  // exact effect of each row scan before the outer circularity advances I.
+  claim [outer-one-ahead]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> (_R:Int => oneRow(P, N)))
+        ("col" |-> (_C:Int => oneCol(P, N))),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I <=Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  claim [outer-one-past]:
+    <k> outerWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> list(gridRows(P:IntSeq, N:Int)))
+        ("k" |-> _K:Int)
+        ("n" |-> N)
+        ("i" |-> (I:Int => N))
+        ("j" |-> (_J:Int => ?JF:Int))
+        ("row" |-> R:Int)
+        ("col" |-> C:Int),
+        parent(0))
+      0 |-> scope(("$perm" |-> str(P)) GLOBALS:Map, parent(-1))
+      RESTSCOPES:Map
+    </scopes>
+    requires N >=Int 2 andBool validPerm(P, N *Int N)
+      andBool I >=Int 0 andBool I <=Int N
+      andBool I >Int oneRow(P, N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+  // The final loop preserves the exact list object and appends the alternating
+  // suffix beginning at symbolic counter T.  A is a fully symbolic prefix.
+  claim [result-one]:
+    <k> resultWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> _GRID:Val)
+        ("k" |-> K:Int)
+        ("n" |-> _N:Int)
+        ("row" |-> _R:Int)
+        ("col" |-> _C:Int)
+        ("i" |-> _I:Int)
+        ("j" |-> _J:Int)
+        ("t" |-> (T:Int => K))
+        ("take_one" |-> (true => ?B:Bool))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => pathOne(A, T, K, M))
+      RESTHEAP:Map
+    </heap>
+    requires T >=Int 0 andBool T <=Int K
+
+  claim [result-other]:
+    <k> resultWhile => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        ("grid" |-> _GRID:Val)
+        ("k" |-> K:Int)
+        ("n" |-> _N:Int)
+        ("row" |-> _R:Int)
+        ("col" |-> _C:Int)
+        ("i" |-> _I:Int)
+        ("j" |-> _J:Int)
+        ("t" |-> (T:Int => K))
+        ("take_one" |-> (false => ?B:Bool))
+        ("neighbor" |-> M:Int)
+        ("result" |-> ref(H:Int)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      H |-> list(A:ValSeq => pathOther(A, T, K, M))
+      RESTHEAP:Map
+    </heap>
+    requires T >=Int 0 andBool T <=Int K
+
+  // Required full-domain target: exact call binding and exact solution body,
+  // for every N>=2 permutation grid and every positive K.
+  claim [minpath-full-contract]:
+    <k>
+      Call(Name("minPath"),
+           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("$perm" |-> str(P))
+        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
+                                   minPathBody, 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(minPathValue(P, N, K))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2 andBool K >Int 0
+      andBool validPerm(P, N *Int N)
+      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
+      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
+
+endmodule
