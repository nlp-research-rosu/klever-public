+    outerLoop
+    Assign(Name("neighbor"),
+           BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("-", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("-", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"),
+                                      BinOp("+", Name("row"), Int(1))),
+                            Name("col")),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"),
+                                   BinOp("+", Name("row"), Int(1))),
+                         Name("col"))),
+        .Stmts),
+      .Stmts)
+    If(Compare(Name("col"), CmpOp(">", Int(0))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("-", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("-", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
+      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),
+                            BinOp("+", Name("col"), Int(1))),
+                 CmpOp("<", Name("neighbor"))),
+        Assign(Name("neighbor"),
+               Subscript(Subscript(Name("grid"), Name("row")),
+                         BinOp("+", Name("col"), Int(1)))),
+        .Stmts),
+      .Stmts)
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("t"), Int(0))
+    resultLoop
+    Return(Name("result"))
+
+endmodule

codex
The result-loop base case is now the only failure: after destination unification, the simplifier sees `appendPath(A,T,T,M)` but does not revisit the guarded `T >= K` equation. I’m adding exact-equality specializations for each summary’s base case. They are overlapping instances of the existing equations with identical right-hand sides, included solely for post-unification normalization.
