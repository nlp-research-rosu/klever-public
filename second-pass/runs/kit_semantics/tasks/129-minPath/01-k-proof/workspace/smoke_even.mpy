Module(
  FuncDef("minPath", Params("grid", "k"),
    Assign(Name("n"), Call(Name("len"), Name("grid")))
    Assign(Name("row"), Int(0))
    Assign(Name("col"), Int(0))
    Assign(Name("i"), Int(0))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      Assign(Name("j"), Int(0))
      While(Compare(Name("j"), CmpOp("<", Name("n"))),
        If(Compare(
          Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
          CmpOp("==", Int(1))),
          Assign(Name("row"), Name("i"))
          Assign(Name("col"), Name("j")),
          )
        Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Assign(
      Name("neighbor"),
      BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
    If(Compare(Name("row"), CmpOp(">", Int(0))),
      If(Compare(
        Subscript(
          Subscript(Name("grid"), BinOp("-", Name("row"), Int(1))),
          Name("col")),
        CmpOp("<", Name("neighbor"))),
        Assign(
          Name("neighbor"),
          Subscript(
            Subscript(Name("grid"), BinOp("-", Name("row"), Int(1))),
            Name("col"))),
        ),
      )
    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
      If(Compare(
        Subscript(
          Subscript(Name("grid"), BinOp("+", Name("row"), Int(1))),
          Name("col")),
        CmpOp("<", Name("neighbor"))),
        Assign(
          Name("neighbor"),
          Subscript(
            Subscript(Name("grid"), BinOp("+", Name("row"), Int(1))),
            Name("col"))),
        ),
      )
    If(Compare(Name("col"), CmpOp(">", Int(0))),
      If(Compare(
        Subscript(
          Subscript(Name("grid"), Name("row")),
          BinOp("-", Name("col"), Int(1))),
        CmpOp("<", Name("neighbor"))),
        Assign(
          Name("neighbor"),
          Subscript(
            Subscript(Name("grid"), Name("row")),
            BinOp("-", Name("col"), Int(1)))),
        ),
      )
    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),
      If(Compare(
        Subscript(
          Subscript(Name("grid"), Name("row")),
          BinOp("+", Name("col"), Int(1))),
        CmpOp("<", Name("neighbor"))),
        Assign(
          Name("neighbor"),
          Subscript(
            Subscript(Name("grid"), Name("row")),
            BinOp("+", Name("col"), Int(1)))),
        ),
      )
    Assign(Name("result"), ListExpr())
    Assign(Name("pairs"), BinOp("//", Name("k"), Int(2)))
    While(Compare(Name("pairs"), CmpOp(">", Int(0))),
      Expr(Call(Attribute(Name("result"), "append"), Int(1)))
      Expr(Call(Attribute(Name("result"), "append"), Name("neighbor")))
      Assign(Name("pairs"), BinOp("-", Name("pairs"), Int(1))))
    If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(1))),
      Expr(Call(Attribute(Name("result"), "append"), Int(1))),
      )
    Return(Name("result")))
  Expr(
    Call(
      Name("minPath"),
      ListExpr(
        ListExpr(Int(5), Int(9), Int(3)),
        ListExpr(Int(4), Int(1), Int(6)),
        ListExpr(Int(7), Int(8), Int(2))),
      Int(4))))
