+private theorem expectedValues_mem_bounds {m x : Int} (hm : 0 ≤ m)
+    (hx : x ∈ expectedValues m) : 0 < x ∧ x < m + 1 := by
+  unfold expectedValues at hx
+  rw [List.mem_map] at hx
