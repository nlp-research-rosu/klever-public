+private theorem flat_toNat {i n j : Int} (hi : 0 ≤ i) (hn : 0 ≤ n)
+    (hj : 0 ≤ j) :
+    (i * n + j).toNat = i.toNat * n.toNat + j.toNat := by
+  rw [Int.toNat_add (Int.mul_nonneg hi hn) hj, Int.toNat_mul hi hn]
+
