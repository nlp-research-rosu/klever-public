+private theorem int_idxOf?_eq_some_idxOf {xs : List Int} (h : 1 ∈ xs) :
+    xs.idxOf? 1 = some (xs.idxOf 1) := by
+  induction xs with
+  | nil => simp at h
+  | cons x xs ih =>
+      by_cases hx : x = 1
+      · subst x
+        simp [List.idxOf?_cons]
