+private def valSeqList : SortValSeq → List SortVal
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq» => []
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» x xs => x :: valSeqList xs
