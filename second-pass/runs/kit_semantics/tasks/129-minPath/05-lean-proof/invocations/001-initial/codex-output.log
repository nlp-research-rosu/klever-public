+    | some k => Int.ofNat (k / n.toNat)
+    | none => Int.tdiv (-1) n
+  else 0
+
+private def oneColModel (p : SortIntSeq) (n : Int) : Int :=
+  if 0 < n then
+    match (intSeqList p).idxOf? 1 with
+    | some k => Int.ofNat (k % n.toNat)
+    | none => pyModModel (-1) n
+  else 0
