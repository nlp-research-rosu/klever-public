+private theorem one_mem_expectedValues {m : Int} (hm : 0 < m) :
+    1 ∈ expectedValues m := by
+  unfold expectedValues
+  rw [List.mem_map]
+  refine ⟨0, List.mem_range.mpr ?_, by simp⟩
+  omega
