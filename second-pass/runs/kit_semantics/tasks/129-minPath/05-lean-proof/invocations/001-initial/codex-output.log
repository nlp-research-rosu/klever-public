+          have hnd' := List.nodup_cons.mp hnd
+          have hne : x ≠ 1 := by
+            intro hx
+            subst x
+            exact hnd'.1 (mem_of_get?_eq_some hget)
+          have hbeq : (x == (1 : Int)) = false := beq_eq_false_iff_ne.mpr hne
+          simp [List.idxOf_cons, hbeq, ih hnd'.2 hget]
