+private def snocModel (xs : SortValSeq) (x : SortVal) : SortValSeq :=
+  listValSeq (valSeqList xs ++ [x])
+
+private def pairPrefixModel (a : SortValSeq) (m : Int) : Nat → SortValSeq
+  | 0 => a
+  | r + 1 =>
