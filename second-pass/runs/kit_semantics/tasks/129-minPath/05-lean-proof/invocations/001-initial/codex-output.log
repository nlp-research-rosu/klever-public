+private def intSeqList : SortIntSeq → List Int
+  | SortIntSeq.«.IntSeq_MPY-CORE_IntSeq» => []
+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x xs => x :: intSeqList xs
