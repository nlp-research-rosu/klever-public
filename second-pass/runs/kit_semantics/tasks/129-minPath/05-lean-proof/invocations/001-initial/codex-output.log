+private theorem flat_nonneg {i n j : Int} (hi : 0 ≤ i) (hn : 0 ≤ n)
+    (hj : 0 ≤ j) : 0 ≤ i * n + j :=
+  Int.add_nonneg (Int.mul_nonneg hi hn) hj
