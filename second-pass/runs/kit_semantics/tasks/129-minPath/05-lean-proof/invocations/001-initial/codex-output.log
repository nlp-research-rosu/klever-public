+      · have hx' : 1 ≠ x := fun heq => hx heq.symm
+        have ht : 1 ∈ xs := by simpa [hx'] using h
+        have hbeq : (x == (1 : Int)) = false := beq_eq_false_iff_ne.mpr hx
+        simp [List.idxOf_cons, hbeq, ih ht]
