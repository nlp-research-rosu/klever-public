codex
The sandbox does not expose `/proc/<pid>/exe`, which Lean 4.22 uses to locate its own installation; that is why even `lean --version` currently fails before reading the project. I’ve identified a non-project workaround: supply the executable path through a temporary `uv_exepath` shim during builds. This leaves the pinned toolchain, Base, and proof artifacts unchanged.
apply patch
patch: completed
/tmp/lean_exepath_shim.c
diff --git a//tmp/lean_exepath_shim.c b//tmp/lean_exepath_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..9b0195dbc8614219543887564f3e5659aca5e065
--- /dev/null
+++ b//tmp/lean_exepath_shim.c
@@ -0,0 +1,15 @@
+#include <stddef.h>
+#include <string.h>
+
+int uv_exepath(char *buffer, size_t *size) {
+  static const char path[] =
+      "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+  const size_t len = sizeof(path) - 1;
+  if (buffer == NULL || size == NULL || *size <= len) {
+    if (size != NULL) *size = len + 1;
+    return -105;
+  }
+  memcpy(buffer, path, len + 1);
+  *size = len;
+  return 0;
+}
