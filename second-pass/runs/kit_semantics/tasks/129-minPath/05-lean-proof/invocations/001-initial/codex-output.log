+private theorem mem_of_get?_eq_some {xs : List α} {k : Nat} {a : α}
+    (h : xs[k]? = some a) : a ∈ xs := by
+  induction xs generalizing k with
+  | nil => simp at h
+  | cons x xs ih =>
+      cases k with
+      | zero =>
+          simp at h
+          subst x
+          simp
+      | succ k =>
+          simp at h
+          exact List.mem_cons_of_mem _ (ih h)
