+      intro a b hab heq
+      apply hab
+      apply Int.ofNat_inj.mp
+      exact Int.add_left_cancel (a := (1 : Int)) (b := (a : Int)) (c := (b : Int))
+        (by simpa [Int.add_comm] using heq)) List.nodup_range
