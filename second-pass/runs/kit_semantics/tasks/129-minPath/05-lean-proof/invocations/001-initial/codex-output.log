+private theorem flat_lt_square {i n j : Int} (hn : 0 ≤ n) (hi : i < n)
+    (hj : j < n) : i * n + j < n * n := by
+  have h₁ : i * n + j < i * n + n := Int.add_lt_add_left hj (i * n)
