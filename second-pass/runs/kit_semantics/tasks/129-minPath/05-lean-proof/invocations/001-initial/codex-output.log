+  | nil => simp at h
+  | cons x xs ih =>
+      by_cases hx : x = 1
+      · subst x
+        simp
+      · have hx' : 1 ≠ x := fun heq => hx heq.symm
+        have ht : 1 ∈ xs := by simpa [hx'] using h
