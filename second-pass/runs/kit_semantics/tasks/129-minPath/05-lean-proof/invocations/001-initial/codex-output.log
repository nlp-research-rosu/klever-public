+private theorem int_idxOf_eq_of_get? {xs : List Int} {k : Nat}
+    (hnd : xs.Nodup) (hget : xs[k]? = some 1) : xs.idxOf 1 = k := by
+  induction xs generalizing k with
+  | nil => simp at hget
+  | cons x xs ih =>
