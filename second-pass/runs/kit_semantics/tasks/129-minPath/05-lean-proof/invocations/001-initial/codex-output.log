+private def valSeqAtModel (xs : SortValSeq) (i : Int) : SortVal :=
+  if i < 0 then SortVal.«noneV_MPY-CORE_Val»
+  else (valSeqList xs).get? i.toNat |>.getD SortVal.«noneV_MPY-CORE_Val»
+
