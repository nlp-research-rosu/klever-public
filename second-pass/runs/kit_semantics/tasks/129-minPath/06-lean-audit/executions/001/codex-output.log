exec
/bin/bash -lc "{
  echo '=== verification relevant rules ==='
  sed -n '1,255p' /reference/k-proof/verification.k
  echo '=== core semantics ==='
  rg -n -C 5 \"vsLen|ValSeq|IntSeq|noneV\" /reference/k-proof/reference-semantics/semantics/core.k
  echo '=== subscript semantics ==='
  rg -n -C 8 \"valSeqAt|noneV\" /reference/k-proof/reference-semantics/semantics/subscript.k
  echo '=== list semantics ==='
  rg -n -C 8 \"valSeqConcat\" /reference/k-proof/reference-semantics/semantics/list.k
  echo '=== int semantics ==='
  rg -n -C 6 \"pyMod|/Int|tdiv\" /reference/k-proof/reference-semantics/semantics/int.k
  echo '=== frozen solution ==='
  sed -n '1,160p' /reference/k-proof/solution.py
  echo '=== full-contract and source macros ==='
