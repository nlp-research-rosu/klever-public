ification]'}, {'source_rule_id': 'rule-b1bda544ef9b4f71186338fba4667904c2ea2f7439eeb2489e7cc0ff2a6790b4', 'module': 'VERIFICATION', 'start_line': 264, 'end_line': 267, 'normalized_sha256': 'b1bda544ef9b4f71186338fba4667904c2ea2f7439eeb2489e7cc0ff2a6790b4', 'attributes': ['simplification'], 'text': '  rule pathRel(O:ValSeq, K:Int, M:Int)\n    => finishRel(.ValSeq, O,\n                 (K -Int pyMod(K, 2)) /Int 2, M, K)\n    [simplification]'}, {'source_rule_id': 'rule-5e91d5878b05b36a225b4ca094e0d132a11ea5a75ec25646c5c2693ad7e1d665', 'module': 'VERIFICATION', 'start_line': 274, 'end_line': 281, 'normalized_sha256': '5e91d5878b05b36a225b4ca094e0d132a11ea5a75ec25646c5c2693ad7e1d665', 'attributes': [], 'text': '  rule innerLoop =>\n    While(Compare(Name("j"), CmpOp("<", Name("n"))),\n      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),\n                 CmpOp("==", Int(1))),\n        Assign(Name("row"), Name("i"))\n        Assign(Name("col"), Name("j")),\n        .Stmts)\n      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))'}, {'source_rule_id': 'rule-f796f1738d7e9178c66280212afbf48dafbd6e6337965746aee66533f1b39599', 'module': 'VERIFICATION', 'start_line': 284, 'end_line': 291, 'normalized_sha256': 'f796f1738d7e9178c66280212afbf48dafbd6e6337965746aee66533f1b39599', 'attributes': [], 'text': '  rule innerWhile =>\n    #while(Compare(Name("j"), CmpOp("<", Name("n"))),\n      If(Compare(Subscript(Subscript(Name("grid"), Name("i")), Name("j")),\n                 CmpOp("==", Int(1))),\n        Assign(Name("row"), Name("i"))\n        Assign(Name("col"), Name("j")),\n        .Stmts)\n      Assign(Name("j"), BinOp("+", Name("j"), Int(1))))'}, {'source_rule_id': 'rule-0c55062d2f73635031204ba06cad589bd55bc5d0d731e5085c713c78cfb60c0c', 'module': 'VERIFICATION', 'start_line': 294, 'end_line': 298, 'normalized_sha256': '0c55062d2f73635031204ba06cad589bd55bc5d0d731e5085c713c78cfb60c0c', 'attributes': [], 'text': '  rule outerLoop =>\n    While(Compare(Name("i"), CmpOp("<", Name("n"))),\n      Assign(Name("j"), Int(0))\n      innerLoop\n      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))'}, {'source_rule_id': 'rule-e84773f9c1de78213d37b3f8341c1fb365935b9211f50e5a64b19781358ed9d3', 'module': 'VERIFICATION', 'start_line': 301, 'end_line': 305, 'normalized_sha256': 'e84773f9c1de78213d37b3f8341c1fb365935b9211f50e5a64b19781358ed9d3', 'attributes': [], 'text': '  rule outerWhile =>\n    #while(Compare(Name("i"), CmpOp("<", Name("n"))),\n      Assign(Name("j"), Int(0))\n      innerLoop\n      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))'}, {'source_rule_id': 'rule-fd46566a19f94a079dd3bdd236e8f18d1595c7089df071b87a6692321193d280', 'module': 'VERIFICATION', 'start_line': 308, 'end_line': 319, 'normalized_sha256': 'fd46566a19f94a079dd3bdd236e8f18d1595c7089df071b87a6692321193d280', 'attributes': [], 'text': '  rule upIf =>\n    If(Compare(Name("row"), CmpOp(">", Int(0))),\n      If(Compare(Subscript(Subscript(Name("grid"),\n                                      BinOp("-", Name("row"), Int(1))),\n                            Name("col")),\n                 CmpOp("<", Name("neighbor"))),\n        Assign(Name("neighbor"),\n               Subscript(Subscript(Name("grid"),\n                                   BinOp("-", Name("row"), Int(1))),\n                         Name("col"))),\n        .Stmts),\n      .Stmts)'}, {'source_rule_id': 'rule-1c3819c6162ca774675f45087a80fd055d59979f9e26a5df1f43e43e628b382f', 'module': 'VERIFICATION', 'start_line': 322, 'end_line': 333, 'normalized_sha256': '1c3819c6162ca774675f45087a80fd055d59979f9e26a5df1f43e43e628b382f', 'attributes': [], 'text': '  rule downIf =>\n    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),\n      If(Compare(Subscript(Subscript(Name("grid"),\n                                      BinOp("+", Name("row"), Int(1))),\n                            Name("col")),\n                 CmpOp("<", Name("neighbor"))),\n        Assign(Name("neighbor"),\n               Subscript(Subscript(Name("grid"),\n                                   BinOp("+", Name("row"), Int(1))),\n                         Name("col"))),\n        .Stmts),\n      .Stmts)'}, {'source_rule_id': 'rule-157d34006be9f7c9582b1911d7fba01121181e8319a82ab246f7e7049a216897', 'module': 'VERIFICATION', 'start_line': 336, 'end_line': 345, 'normalized_sha256': '157d34006be9f7c9582b1911d7fba01121181e8319a82ab246f7e7049a216897', 'attributes': [], 'text': '  rule leftIf =>\n    If(Compare(Name("col"), CmpOp(">", Int(0))),\n      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),\n                            BinOp("-", Name("col"), Int(1))),\n                 CmpOp("<", Name("neighbor"))),\n        Assign(Name("neighbor"),\n               Subscript(Subscript(Name("grid"), Name("row")),\n                         BinOp("-", Name("col"), Int(1)))),\n        .Stmts),\n      .Stmts)'}, {'source_rule_id': 'rule-0804c153b600b6747ed9f6f46e0d63125d16993d666a588b4557273589aac289', 'module': 'VERIFICATION', 'start_line': 348, 'end_line': 357, 'normalized_sha256': '0804c153b600b6747ed9f6f46e0d63125d16993d666a588b4557273589aac289', 'attributes': [], 'text': '  rule rightIf =>\n    If(Compare(BinOp("+", Name("col"), Int(1)), CmpOp("<", Name("n"))),\n      If(Compare(Subscript(Subscript(Name("grid"), Name("row")),\n                            BinOp("+", Name("col"), Int(1))),\n                 CmpOp("<", Name("neighbor"))),\n        Assign(Name("neighbor"),\n               Subscript(Subscript(Name("grid"), Name("row")),\n                         BinOp("+", Name("col"), Int(1)))),\n        .Stmts),\n      .Stmts)'}, {'source_rule_id': 'rule-5059cd0eda52a24992558074cef1dcaad9a65b965e11693893deede9ba08a1bf', 'module': 'VERIFICATION', 'start_line': 360, 'end_line': 364, 'normalized_sha256': '5059cd0eda52a24992558074cef1dcaad9a65b965e11693893deede9ba08a1bf', 'attributes': [], 'text': '  rule neighborUpdates =>\n    upIf\n    downIf\n    leftIf\n    rightIf'}, {'source_rule_id': 'rule