--- /dev/null
+++ b//tmp/audit-work/lean-launcher/path_probe.c
@@ -0,0 +1,15 @@
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+int main(int argc, char **argv) {
+    char buf[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+    if (n >= 0) { buf[n] = 0; printf("proc=%s\n", buf); }
+    else { perror("readlink"); }
+    char *resolved = realpath(argv[0], NULL);
+    if (resolved) { printf("argv0=%s\n", resolved); free(resolved); }
+    else { perror("realpath"); }
+    return 0;
+}
diff --git a//tmp/audit-work/lean-probe/lean b//tmp/audit-work/lean-probe/lean
new file mode 100644
index 0000000000000000000000000000000000000000..9972f970ad4a2bdd2be2bc45a11d3459a4389177
--- /dev/null
+++ b//tmp/audit-work/lean-probe/lean
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -u
+{
+  printf 'lean'
+  printf ' %q' "$@"
+  printf '\n'
+} >> /tmp/audit-work/lean-probe/invocations.log
+case "${1:-}" in
+  --version|-v)
+    printf '%s\n' 'Lean (version 4.22.0, x86_64-unknown-linux-gnu, commit ba2cbbf09d4978f416e0ebd1fceeebc2c4138c05, Release)'
+    ;;
+  --print-prefix)
+    printf '%s\n' '/opt/elan/toolchains/leanprover--lean4---v4.22.0'
+    ;;
+  --print-libdir)
+    printf '%s\n' '/opt/elan/toolchains/leanprover--lean4---v4.22.0/lib/lean'
+    ;;
+  *)
+    /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean "$@"
+    ;;
+esac
diff --git a//tmp/audit-work/lean-proc-shim/proc_self_readlink.c b//tmp/audit-work/lean-proc-shim/proc_self_readlink.c
new file mode 100644
index 0000000000000000000000000000000000000000..9698f826233219a864c3fdb3b60f59d4d9610574
--- /dev/null
+++ b//tmp/audit-work/lean-proc-shim/proc_self_readlink.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (path && strncmp(path, "/proc/", 6) == 0) {
+        const char *suffix = strrchr(path, '/');
+        if (suffix && strcmp(suffix, "/exe") == 0) {
+            return real_readlink("/proc/self/exe", buf, size);
+        }
+    }
+    return real_readlink(path, buf, size);
+}

diff --git a//tmp/audit-work/lean-launcher/lean_app_path_probe.c b//tmp/audit-work/lean-launcher/lean_app_path_probe.c
