        parent(-1))
      -1 |-> builtinsScope
      1 |-> scope(
        ("grid" |-> list(gridRows(P, N:Int)))
        ("k" |-> K:Int)
        ("n" |-> N)
        ("row" |-> oneRow(P, N))
        ("col" |-> oneCol(P, N))
        ("i" |-> N)
        ("j" |-> N)
        ("neighbor" |-> neighborMin(P, N, oneRow(P, N), oneCol(P, N)))
        ("result" |-> ref(0))
        ("pairs" |-> (R:Int => 0)),
        parent(0))
    </scopes>
    <scopeLoc> 2 </scopeLoc>
    <heap> 0 |-> list(A:ValSeq => ?OUT:ValSeq) </heap>
    <heapLoc> 1 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 2 andBool K >Int 0
      andBool validPerm(P, N *Int N)
      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
      andBool R >Int 0
    ensures finishRel(
      A, ?OUT, R,
      neighborMin(P, N, oneRow(P, N), oneCol(P, N)), K)

  // Required full-domain target: exact call binding and exact solution body,
  // for every N>=2 permutation grid and every positive K.
  claim [minpath-full-contract]:
    <k>
      Call(Name("minPath"),
           (list(gridRows(P:IntSeq, N:Int)), K:Int, .Exprs))
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        ("$perm" |-> str(P))
        ("minPath" |-> closureVal(("grid", "k", .ParamNames),
                                   minPathBody, 0)),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map => 0 |-> list(?OUT:ValSeq)
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 2 andBool K >Int 0
      andBool validPerm(P, N *Int N)
      andBool oneRow(P, N) >=Int 0 andBool oneRow(P, N) <Int N
      andBool oneCol(P, N) >=Int 0 andBool oneCol(P, N) <Int N
    ensures finishRel(
      .ValSeq,
      ?OUT,
      (K -Int pyMod(K, 2)) /Int 2,
      neighborMin(P, N, oneRow(P, N), oneCol(P, N)),
      K)

endmodule
def minPath(grid, k):
    n = len(grid)

    row = 0
    col = 0
    i = 0
    while i < n:
        j = 0
        while j < n:
            if grid[i][j] == 1:
                row = i
                col = j
            j = j + 1
        i = i + 1

    neighbor = n * n + 1
    if row > 0:
        if grid[row - 1][col] < neighbor:
            neighbor = grid[row - 1][col]
    if row + 1 < n:
        if grid[row + 1][col] < neighbor:
            neighbor = grid[row + 1][col]
    if col > 0:
        if grid[row][col - 1] < neighbor:
            neighbor = grid[row][col - 1]
    if col + 1 < n:
        if grid[row][col + 1] < neighbor:
            neighbor = grid[row][col + 1]

    result = []
    pairs = k // 2
    while pairs > 0:
        result.append(1)
        result.append(neighbor)
        pairs = pairs - 1
    if k % 2 == 1:
        result.append(1)
    return result
