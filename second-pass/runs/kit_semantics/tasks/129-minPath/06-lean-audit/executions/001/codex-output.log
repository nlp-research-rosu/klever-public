/bin/bash -lc "script -q -e -c 'PYTHONPATH=/reference python3 - <<\"PY\"
import hashlib,json
from pathlib import Path
from tools.klean_export import tree_digest
ai=json.loads(Path(\"/audit-input.json\").read_text())
gm=json.loads(Path(\"/reference/klean-generation/generator-manifest.json\").read_text())
sm=json.loads(Path(\"/reference/generation-tools/source-manifest.json\").read_text())
res=ai[\"resolution\"]
# Recursively collect every generator_image_id recorded in audit input.
def collect(x,path=\"\"):
 out=[]
 if isinstance(x,dict):
  for k,v in x.items():
   p=f\"{path}.{k}\" if path else k
   if k==\"generator_image_id\": out.append((p,v))
   out += collect(v,p)
 elif isinstance(x,list):
