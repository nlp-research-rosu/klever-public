+import Proof
+
+def p1234 : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 1 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 2 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 3 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 4 <|
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def p4213 : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 4 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 2 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 1 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 3 <|
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def p1123 : SortIntSeq :=
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 1 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 1 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 2 <|
+  SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 3 <|
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+def emptyVS : SortValSeq := SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+def oneVS : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+    (SortVal.inj_SortInt 1) emptyVS
+
+#eval Proof.gridAt p1234 2 0 0
+#eval Proof.gridAt p1234 2 1 1
+#eval Proof.gridAt p1234 2 (-1) 0
+#eval Proof.oneRow p4213 2
+#eval Proof.oneCol p4213 2
+#eval Proof.validPerm p1234 4
+#eval Proof.validPerm p1123 4
+#eval Proof.validPerm p1234 (-1)
+#eval Proof.«vsLen(_)_MPY-CORE_Int_ValSeq» (Proof.gridRows p1234 2)
+
+example :
+    Proof.«valSeqAt(_,_)_MPY-SUBSCRIPT_Val_ValSeq_Int»
+      (Proof.gridRow p1234 2 1) 1 = SortVal.inj_SortInt 4 := by
+  native_decide
+
+example :
+    Proof.snocVS emptyVS (SortVal.inj_SortInt 7) =
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+        (SortVal.inj_SortInt 7) emptyVS := by
+  native_decide
+
+example :
+    Proof.«valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» oneVS oneVS =
+      SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+        (SortVal.inj_SortInt 1) oneVS := by
+  native_decide
diff --git a//tmp/audit-work/verify_stage4.py b//tmp/audit-work/verify_stage4.py
