diff --git a//tmp/audit-work/lean-launcher/lean_app_path_probe.c b//tmp/audit-work/lean-launcher/lean_app_path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..1ae60a74930954bf0c127d065fd5af024f410957
--- /dev/null
+++ b//tmp/audit-work/lean-launcher/lean_app_path_probe.c
@@ -0,0 +1,16 @@
+#include <lean/lean.h>
+#include <stdio.h>
+
+extern lean_object * lean_io_app_path(lean_object * world);
+
+int main(void) {
+    lean_initialize_runtime_module();
+    lean_object *r = lean_io_app_path(lean_io_mk_world());
+    if (lean_io_result_is_error(r)) {
+        lean_io_result_show_error(r);
+        return 1;
+    }
+    lean_object *s = lean_io_result_get_value(r);
+    printf("%s\n", lean_string_cstr(s));
+    return 0;
+}
diff --git a//tmp/audit-work/lean-launcher/lean_launcher.c b//tmp/audit-work/lean-launcher/lean_launcher.c
new file mode 100644
index 0000000000000000000000000000000000000000..3230050d991288791b2620851d7a72f81c9e10fc
--- /dev/null
+++ b//tmp/audit-work/lean-launcher/lean_launcher.c
@@ -0,0 +1,17 @@
+#include <lean/lean.h>
+
+/*
+ * The pinned distribution's lean executable was linked without the
+ * application anchor that Lean uses to locate its installation prefix.
+ * lean_main implements the real, pinned CLI; this anchor only gives its
+ * executable-location probe a symbol in the launcher image.
+ */
+LEAN_EXPORT lean_object * _lean_main(void) {
+    return lean_box(0);
+}
+
+extern int lean_main(int argc, char ** argv);
+
+int main(int argc, char ** argv) {
+    return lean_main(argc, argv);
+}
diff --git a//tmp/audit-work/lean-launcher/path_probe.c b//tmp/audit-work/lean-launcher/path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..57526cfb83b28367712a4b7755e274605b2d43b4
--- /dev/null
+++ b//tmp/audit-work/lean-launcher/path_probe.c
@@ -0,0 +1,15 @@
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+int main(int argc, char **argv) {
+    char buf[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+    if (n >= 0) { buf[n] = 0; printf("proc=%s\n", buf); }
+    else { perror("readlink"); }
+    char *resolved = realpath(argv[0], NULL);
+    if (resolved) { printf("argv0=%s\n", resolved); free(resolved); }
+    else { perror("realpath"); }
+    return 0;
+}
diff --git a//tmp/audit-work/lean-probe/lean b//tmp/audit-work/lean-probe/lean
new file mode 100644
index 0000000000000000000000000000000000000000..9972f970ad4a2bdd2be2bc45a11d3459a4389177
--- /dev/null
+++ b//tmp/audit-work/lean-probe/lean
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -u
+{
+  printf 'lean'
+  printf ' %q' "$@"
+  printf '\n'
+} >> /tmp/audit-work/lean-probe/invocations.log
+case "${1:-}" in
+  --version|-v)
+    printf '%s\n' 'Lean (version 4.22.0, x86_64-unknown-linux-gnu, commit ba2cbbf09d4978f416e0ebd1fceeebc2c4138c05, Release)'
+    ;;
+  --print-prefix)
+    printf '%s\n' '/opt/elan/toolchains/leanprover--lean4---v4.22.0'
+    ;;
+  --print-libdir)
+    printf '%s\n' '/opt/elan/toolchains/leanprover--lean4---v4.22.0/lib/lean'
+    ;;
+  *)
+    /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean "$@"
+    ;;
+esac

exec
/bin/bash -lc "bash -c 'p="'$$; printf "pid=%s'"\\n\" \""'$p"; readlink "/proc/$p/exe"; readlink /proc/self/exe; ls -l "/proc/$p/exe" /proc/self/exe'"'" in /audit-output
 exited 2 in 0ms:
pid=2
/usr/bin/readlink
ls: cannot access '/proc/2/exe': No such file or directory
lrwxrwxrwx 1 agent agent 0 Aug  1 04:20 /proc/self/exe -> /usr/bin/ls

