--- /dev/null
+++ b//tmp/audit-work/lean-launcher/lean_launcher.c
@@ -0,0 +1,17 @@
+#include <lean/lean.h>
+
+/*
+ * The pinned distribution's lean executable was linked without the
+ * application anchor that Lean uses to locate its installation prefix.
+ * lean_main implements the real, pinned CLI; this anchor only gives its
+ * executable-location probe a symbol in the launcher image.
+ */
+LEAN_EXPORT lean_object * _lean_main(void) {
+    return lean_box(0);
+}
+
+extern int lean_main(int argc, char ** argv);
+
+int main(int argc, char ** argv) {
+    return lean_main(argc, argv);
+}
diff --git a//tmp/audit-work/lean-launcher/path_probe.c b//tmp/audit-work/lean-launcher/path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..57526cfb83b28367712a4b7755e274605b2d43b4
--- /dev/null
+++ b//tmp/audit-work/lean-launcher/path_probe.c
@@ -0,0 +1,15 @@
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+int main(int argc, char **argv) {
+    char buf[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+    if (n >= 0) { buf[n] = 0; printf("proc=%s\n", buf); }
+    else { perror("readlink"); }
+    char *resolved = realpath(argv[0], NULL);
+    if (resolved) { printf("argv0=%s\n", resolved); free(resolved); }
+    else { perror("realpath"); }
+    return 0;
+}
