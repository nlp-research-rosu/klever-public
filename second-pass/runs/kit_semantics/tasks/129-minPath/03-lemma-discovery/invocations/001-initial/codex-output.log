b5be75d2fcfbf0d695afdb0d55b3625e2e781eeadfa9", "source_rule_id": "rule-2897b75ec239c3a14e64b5be75d2fcfbf0d695afdb0d55b3625e2e781eeadfa9", "start_line": 50, "text": "  rule gridRows(P:IntSeq, N:Int) => gridRowsFrom(P, N, 0) [concrete]"}, {"attributes": ["concrete"], "end_line": 53, "module": "VERIFICATION", "normalized_sha256": "c30a566b51b019859a75269b24d23021048e0738dc0c594100dabc514dd5b61c", "source_rule_id": "rule-c30a566b51b019859a75269b24d23021048e0738dc0c594100dabc514dd5b61c", "start_line": 51, "text": "  rule gridRowsFrom(_:IntSeq, N:Int, I:Int) => .ValSeq\n    requires I >=Int N\n    [concrete]"}, {"attributes": ["concrete"], "end_line": 57, "module": "VERIFICATION", "normalized_sha256": "778f2096d63f4ce8f7575f1ed318b61a6f8796cf80c249d43fe2f4c76c266f6f", "source_rule_id": "rule-778f2096d63f4ce8f7575f1ed318b61a6f8796cf80c249d43fe2f4c76c266f6f", "start_line": 54, "text": "  rule gridRowsFrom(P:IntSeq, N:Int, I:Int)\n    => vCons(list(gridRow(P, N, I)), gridRowsFrom(P, N, I +Int 1))\n    requires I <Int N\n    [concrete]"}, {"attributes": ["concrete"], "end_line": 60, "module": "VERIFICATION", "normalized_sha256": "65e6905f889ab17ca4aa82c494370ff934c0c9f84eab6eb9a33190a832ada295", "source_rule_id": "rule-65e6905f889ab17ca4aa82c494370ff934c0c9f84eab6eb9a33190a832ada295", "start_line": 59, "text": "  rule gridRow(P:IntSeq, N:Int, I:Int) => gridRowFrom(P, N, I, 0)\n    [concrete]"}, {"attributes": ["concrete"], "end_line": 63, "module": "VERIFICATION", "normalized_sha256": "910dd8c53451c0e9c10802521a96d475749f5e0a453f29528629b9a0021081f6", "source_rule_id": "rule-910dd8c53451c0e9c10802521a96d475749f5e0a453f29528629b9a0021081f6", "start_line": 61, "text": "  rule gridRowFrom(_:IntSeq, N:Int, _:Int, J:Int) => .ValSeq\n    requires J >=Int N\n    [concrete]"}, {"attributes": ["concrete"], "end_line": 68, "module": "VERIFICATION", "normalized_sha256": "6a2add44d53adc3a54e08be82bfffa6611f4a97eee8082b0c8284c2ea42f90ab", "source_rule_id": "rule-6a2add44d53adc3a54e08be82bfffa6611f4a97eee8082b0c8284c2ea42f90ab", "start_line": 64, "text": "  rule gridRowFrom(P:IntSeq, N:Int, I:Int, J:Int)\n    => vCons(pAtTotal(P, I *Int N +Int J),\n             gridRowFrom(P, N, I, J +Int 1))\n    requires J <Int N\n    [concrete]"}, {"attributes": ["concrete"], "end_line": 74, "module": "VERIFICATION", "normalized_sha256": "fb791cfc19aa094edefedba97734114cc2e98186d703392cad665123b446b9ea", "source_rule_id": "rule-fb791cfc19aa094edefedba97734114cc2e98186d703392cad665123b446b9ea", "start_line": 72, "text": "  rule gridAt(P:IntSeq, N:Int, I:Int, J:Int)\n    => pAtTotal(P, I *Int N +Int J)\n    [concrete]"}, {"attributes": [], "end_line": 77, "module": "VERIFICATION", "normalized_sha256": "9a39af5e3eca2448ca4a824f2d03f27a751266db0d526bbe59039c3b28cb330a", "source_rule_id": "rule-9a39af5e3eca2448ca4a824f2d03f27a751266db0d526bbe59039c3b28cb330a", "start_line": 77, "text": "  rule findOne(.IntSeq, _:Int) => -1"}, {"attributes": [], "end_line": 78, "module": "VERIFICATION", "normalized_sha256": "9d8bcf283153b01dcf3118cd5f4e2db239e30fa9a183000bff24ec802374b604", "source_rule_id": "rule-9d8bcf283153b01dcf3118cd5f4e2db239e30fa9a183000bff24ec802374b604", "start_line": 78, "text": "  rule findOne(iCons(1, _:IntSeq), A:Int) => A"}, {"attributes": [], "end_line": 80, "module": "VERIFICATION", "normalized_sha256": "75ee8fa32c9e2a59e247b2d8eaa7c5c83c8873c8cb30e97a776488e7c6399082", "source_rule_id": "rule-75ee8fa32c9e2a59e247b2d8eaa7c5c83c8873c8cb30e97a776488e7c6399082", "start_line": 79, "text": "  rule findOne(iCons(X:Int, R:IntSeq), A:Int) => findOne(R, A +Int 1)\n    requires X =/=Int 1"}, {"attributes": ["concrete"], "end_line": 84, "module": "VERIFICATION", "normalized_sha256": "6d0c3c0af2af74f1a678adf85e410cf1c326eea91e8a9bd2cd285672677e32a5", "source_rule_id": "rule-6d0c3c0af2af74f1a678adf85e410cf1c326eea91e8a9bd2cd285672677e32a5", "start_line": 84, "text": "  rule oneIndex(P:IntSeq) => findOne(P, 0) [concrete]"}, {"attributes": ["concrete"], "end_line": 92, "module": "VERIFICATION", "normalized_sha256": "edf33e36acd93144245ce557995b04bdce196724fb5d4ece6f46da10705bc75e", "source_rule_id": "rule-edf33e36acd93144245ce557995b04bdce196724fb5d4ece6f46da10705bc75e", "start_line": 90, "text": "  rule oneRow(P:IntSeq, N:Int) => oneIndex(P) /Int N\n    requires N >Int 0\n    [concrete]"}, {"attributes": ["concrete"], "end_line": 95, "module": "VERIFICATION", "normalized_sha256": "fba5c775a127c232410a72bf023c80063ae1d5628a7411453dc8b0a58f81d8af", "source_rule_id": "rule-fba5c775a127c232410a72bf023c80063ae1d5628a7411453dc8b0a58f81d8af", "start_line": 93, "text": "  rule oneRow(_:IntSeq, N:Int) => 0\n    requires N <=Int 0\n    [concrete]"}, {"attributes": ["concrete"], "end_line": 98, "module": "VERIFICATION", "normalized_sha256": "7902bceab811b3fa52cc0dd3876b3709c5cab699bac08c9cd2afceafb2e46261", "source_rule_id": "rule-7902bceab811b3fa52cc0dd3876b3709c5cab699bac08c9cd2afceafb2e46261", "start_line": 96, "text": "  rule oneCol(P:IntSeq, N:Int) => pyMod(oneIndex(P), N)\n    requires N >Int 0\n    [concrete]"}, {"attributes": ["concrete"], "end_line": 101, "module": "VERIFICATION", "normalized_sha256": "fe3def8e0160f92b2aa1a738bebfde7315e857b887d736139ab22db1ecbff292", "source_rule_id": "rule-fe3def8e0160f92b2aa1a738bebfde7315e857b887d736139ab22db1ecbff292", "start_line": 99, "text": "  rule oneCol(_:IntSeq, N:Int) => 0\n    requires N <=Int 0\n    [concrete]"}, {"attributes": ["simplification"], "end_line": 107, "module": "VERIFICATION", "normalized_sha256": "c542bea0ad56e556c87d2f0a1f3b92b8ebc7ede934ee79e3380edd4c8eec4a70", "source_rule_id": "rule-c542bea0ad56e556c87d2f0a1f3b92b8ebc7ede934ee79e3380edd4c8eec4a70", "start_line": 105, "text": "  rule vsLen(gridRows(P:IntSeq, N:Int)) => N\n    requires N >=Int 2 andBool validPerm(P, N *Int N)\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 113, "module": "VERIFICATION", "normalized_sha256": "97b792417dedc7de0727ca3c557d6c412015002a77809892b5d5cc700a2fd149", "source_rule_id": "rule-97b792417dedc7de0727ca3c557d6c412015002a77809892b5d5cc700a2fd149", "start_line": 109, "text": "  rule valSeqAt(gridRows(P:IntSeq, N:Int), I:Int)\n    => list(gridRow(P, N, I))\n    requires N >=Int 2 andBool validPerm(P, N *Int N)\n      andBool I >=Int 0 andBool I <Int N\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 120, "module": "VERIFICATION", "normalized_sha256": "cf5a0acce1b2eb580bfbacadd2e910a549de9a696af1ebfcf37925160d22a22b", "source_rule_id": "rule-cf5a0acce1b2eb580bfbacadd2e910a549de9a696af1ebfcf37925160d22a22b", "start_line": 115, "text": "  rule valSeqAt(gridRow(P:IntSeq, N:Int, I:Int), J:Int)\n    => gridAt(P, N, I, J)\n    requires N >=Int 2 andBool validPerm(P, N *Int N)\n      andBool I >=Int 0 andBool I <Int N\n      andBool J >=Int 0 andBool J <Int N\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 127, "module": "VERIFICATION", "normalized_sha256": "6239181de49e2422109895baef3c3011f33d8b5f0ae6785549600addc1a5cfc1", "source_rule_id": "rule-6239181de49e2422109895baef3c3011f33d8b5f0ae6785549600addc1a5cfc1", "start_line": 122, "text": "  rule (gridAt(P:IntSeq, N:Int, I:Int, J:Int) ==Int 1)\n    => (I ==Int oneRow(P, N) andBool J ==Int oneCol(P, N))\n    requires N >=Int 2 andBool validPerm(P, N *Int N)\n      andBool I >=Int 0 andBool I <Int N\n      andBool J >=Int 0 andBool J <Int N\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 134, "module": "VERIFICATION", "normalized_sha256": "b8a75762e8baeaf13b848647832cf0455607cbda75166ad623cdc8ded53ef987", "source_rule_id": "rule-b8a75762e8baeaf13b848647832cf0455607cbda75166ad623cdc8ded53ef987", "start_line": 129, "text": "  rule (gridAt(P:IntSeq, N:Int, I:Int, J:Int) <Int N *Int N +Int 1)\n    => true\n    requires N >=Int 2 andBool validPerm(P, N *Int N)\n      andBool I >=Int 0 andBool I <Int N\n      andBool J >=Int 0 andBool J <Int N\n    [simplification]"}, {"attributes": [], "end_line": 141, "module": "VERIFICATION", "normalized_sha256": "a2ab50d9e6f57db0d17ec863644b724fa0745aba6e77b55ba83ff1b12a6bcabf", "source_rule_id": "rule-a2ab50d9e6f57db0d17ec863644b724fa0745aba6e77b55ba83ff1b12a6bcabf", "start_line": 141, "text": "  rule chooseMin(B:Int, _:Int, false) => B"}, {"attributes": [], "end_line": 142, "module": "VERIFICATION", "normalized_sha256": "9c417a2b6f753e1e1eaca18a1e42b3536c7ceffa3c67b2b559d6469641f185cd", "source_rule_id": "rule-9c417a2b6f753e1e1eaca18a1e42b3536c7ceffa3c67b2b559d6469641f185cd", "start_line": 142, "text": "  rule chooseMin(B:Int, V:Int, true) => V requires V <Int B"}, {"attributes": [], "end_line": 143, "module": "VERIFICATION", "normalized_sha256": "6a2ef899924a9d9837057a07cc6e0df5f9523cde1081cc7672346dd4558b2d64", "source_rule_id": "rule-6a2ef899924a9d9837057a07cc6e0df5f9523cde1081cc7672346dd4558b2d64", "start_line": 143, "text": "  rule chooseMin(B:Int, V:Int, true) => B requires V >=Int B"}, {"attributes": [], "end_line": 157, "module": "VERIFICATION", "normalized_sha256": "f90710390be853fe3550037d9e82f6d813d9bf78adf74eb57156fdcdad767f70", "source_rule_id": "rule-f90710390be853fe3550037d9e82f6d813d9bf78adf74eb57156fdcdad767f70", "start_line": 156, "text": "  rule afterUp(B:Int, P:IntSeq, N:Int, R:Int, C:Int)\n    => chooseMin(B, gridAt(P, N, R -Int 1, C), R >Int 0)"}, {"attributes": [], "end_line": 159, "module": "VERIFICATION", "normalized_sha256": "e4694662834c6d824a7236e2b57927f413e5214be46ae3fdb09cdd5b62453d26", "source_rule_id": "rule-e4694662834c6d824a7236e2b57927f413e5214be46ae3fdb09cdd5b62453d26", "start_line": 158, "text": "  rule afterDown(B:Int, P:IntSeq, N:Int, R:Int, C:Int)\n    => chooseMin(B, gridAt(P, N, R +Int 1, C), R +Int 1 <Int N)"}, {"attributes": [], "end_line": 161, "module": "VERIFICATION", "normalized_sha256": "d6b112d9eb5addc18dbe86d8b4ebabbb100fdc7b27f6265568a6cce59140611b", "source_rule_id": "rule-d6b112d9eb5addc18dbe86d8b4ebabbb100fdc7b27f6265568a6cce59140611b", "start_line": 160, "text": "  rule afterLeft(B:Int, P:IntSeq, N:Int, R:Int, C:Int)\n    => chooseMin(B, gridAt(P, N, R, C -Int 1), C >Int 0)"}, {"attributes": [], "end_line": 163, "module": "VERIFICATION", "normalized_sha256": "6e7c7e4f1cb7ccf82580fd832803e63b2c0c422886d6e840cb16a3702c3faa64", "source_rule_id": "rule-6e7c7e4f1cb7ccf82580fd832803e63b2c0c422886d6e840cb16a3702c3faa64", "start_line": 162, "text": "  rule afterRight(B:Int, P:IntSeq, N:Int, R:Int, C:Int)\n    => chooseMin(B, gridAt(P, N, R, C +Int 1), C +Int 1 <Int N)"}, {"attributes": [], "end_line": 166, "module": "VERIFICATION", "normalized_sha256": "e4afaf69e78c7fdc5cd463d32497d56f3c418ab28231d8c89dab88596d2b96cf", "source_rule_id": "rule-e4afaf69e78c7fdc5cd463d32497d56f3c418ab28231d8c89dab88596d2b96cf", "start_line": 165, "text": "  rule bestUp(P:IntSeq, N:Int, R:Int, C:Int)\n    => afterUp(N *Int N +Int 1, P, N, R, C)"}, {"attributes": [], "end_line": 168, "module": "VERIFICATION", "normalized_sha256": "61226121aa5d2c03b5a2e2ef43232ce16e5ae72a385f81b6c0d30ff2a87dabba", "source_rule_id": "rule-61226121aa5d2c03b5a2e2ef43232ce16e5ae72a385f81b6c0d30ff2a87dabba", "start_line": 167, "text": "  rule bestDown(P:IntSeq, N:Int, R:Int, C:Int)\n    => afterDown(bestUp(P, N, R, C), P, N, R, C)"}, {"attributes": [], "end_line": 170, "module": "VERIFICATION", "normalized_sha256": "9541ca8cfeb2c269bedc20a7a1f9596d1f53c3d6124825c8b1d9b9a8198ae4f1", "source_rule_id": "rule-9541ca8cfeb2c269bedc20a7a1f9596d1f53c3d6124825c8b1d9b9a8198ae4f1", "start_line": 169, "text": "  rule bestLeft(P:IntSeq, N:Int, R:Int, C:Int)\n    => afterLeft(bestDown(P, N, R, C), P, N, R, C)"}, {"attributes": ["simplification"], "end_line": 190, "module": "VERIFICATION", "normalized_sha256": "8dd9980f25bf38e80094168d71491dff6197d13b47229fe0950ef7e9f16f1fd7", "source_rule_id": "rule-8dd9980f25bf38e80094168d71491dff6197d13b47229fe0950ef7e9f16f1fd7", "start_line": 174, "text": "  rule neighborMin(P:IntSeq, N:Int, R:Int, C:Int)\n    => chooseMin(\n         chooseMin(\n           chooseMin(\n             chooseMin(N *Int N +Int 1,\n                       gridAt(P, N, R -Int 1, C),\n                       R >Int 0),\n             gridAt(P, N, R +Int 1, C),\n             R +Int 1 <Int N),\n           gridAt(P, N, R, C -Int 1),\n           C >Int 0),\n         gridAt(P, N, R, C +Int 1),\n         C +Int 1 <Int N)\n    requires N >=Int 2 andBool validPerm(P, N *Int N)\n      andBool R >=Int 0 andBool R <Int N\n      andBool C >=Int 0 andBool C <Int N\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 197, "module": "VERIFICATION", "normalized_sha256": "202e61b719f94165f5c38515ceee3351accf7a7d67005d0850146cb4595f11c6", "source_rule_id": "rule-202e61b719f94165f5c38515ceee3351accf7a7d67005d0850146cb4595f11c6", "start_line": 197, "text": "  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq) [simplification]"}, {"attributes": ["concrete"], "end_line": 200, "module": "VERIFICATION", "normalized_sha256": "889a077b3e19b3893f77b2a69c9b5673e401ad39f8a9df8dd56e98b877cec186", "source_rule_id": "rule-889a077b3e19b3893f77b2a69c9b5673e401ad39f8a9df8dd56e98b877cec186", "start_line": 198, "text": "  rule snocVS(vCons(X:Val, R:ValSeq), V:Val)\n    => vCons(X, snocVS(R, V))\n    [concrete]"}, {"attributes": ["simplification"], "end_line": 207, "module": "VERIFICATION", "normalized_sha256": "bd68fcea8923a00f63f0fec35cd499f3496426b1a631d4081a7ddd9dc1de42df", "source_rule_id": "rule-bd68fcea8923a00f63f0fec35cd499f3496426b1a631d4081a7ddd9dc1de42df", "start_line": 205, "text": "  rule snocVS(vCons(X:Val, .ValSeq), V:Val)\n    => vCons(X, vCons(V, .ValSeq))\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 210, "module": "VERIFICATION", "normalized_sha256": "1d2d0e52ae268a3eeee0ed1e4157ddea23537b5d12824bf2d566e5af704d05e4", "source_rule_id": "rule-1d2d0e52ae268a3eeee0ed1e4157ddea23537b5d12824bf2d566e5af704d05e4", "start_line": 208, "text": "  rule snocVS(vCons(X:Val, vCons(Y:Val, .ValSeq)), V:Val)\n    => vCons(X, vCons(Y, vCons(V, .ValSeq)))\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 213, "module": "VERIFICATION", "normalized_sha256": "79cc3308597d2aedf94188a46aa45b9302edb4bd5dc309fcd4bc218ec8dc5894", "source_rule_id": "rule-79cc3308597d2aedf94188a46aa45b9302edb4bd5dc309fcd4bc218ec8dc5894", "start_line": 212, "text": "  rule valSeqConcat(A:ValSeq, vCons(V:Val, .ValSeq)) => snocVS(A, V)\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 219, "module": "VERIFICATION", "normalized_sha256": "622ed68eb8d758f8c3c568b6fbb671e3eb2424669f9b758ccb5c4d477512f45a", "source_rule_id": "rule-622ed68eb8d758f8c3c568b6fbb671e3eb2424669f9b758ccb5c4d477512f45a", "start_line": 217, "text": "  rule pairDone(A:ValSeq, O:ValSeq, R:Int, _:Int) => A ==K O\n    requires R <=Int 0\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 223, "module": "VERIFICATION", "normalized_sha256": "4e1856693adeacc04f7e70e9524d0775f5e5e4f297f2f5d4fb5e11ab4fc3407a", "source_rule_id": "rule-4e1856693adeacc04f7e70e9524d0775f5e5e4f297f2f5d4fb5e11ab4fc3407a", "start_line": 220, "text": "  rule pairDone(A:ValSeq, O:ValSeq, R:Int, M:Int)\n    => pairDone(snocVS(snocVS(A, 1), M), O, R -Int 1, M)\n    requires R >Int 0\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 231, "module": "VERIFICATION", "normalized_sha256": "105680d542ad2648685c27bf239601a1115a7706009b2c534dc0871ba63203da", "source_rule_id": "rule-105680d542ad2648685c27bf239601a1115a7706009b2c534dc0871ba63203da", "start_line": 228, "text": "  rule oddDone(A:ValSeq, O:ValSeq, R:Int, _:Int)\n    => (O ==K snocVS(A, 1))\n    requires R <=Int 0\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 235, "module": "VERIFICATION", "normalized_sha256": "5eb6c7759fff9f5ea7b9f30d67d3d23184dd27739c8ed4d7be89e16384495f71", "source_rule_id": "rule-5eb6c7759fff9f5ea7b9f30d67d3d23184dd27739c8ed4d7be89e16384495f71", "start_line": 232, "text": "  rule oddDone(A:ValSeq, O:ValSeq, R:Int, M:Int)\n    => oddDone(snocVS(snocVS(A, 1), M), O, R -Int 1, M)\n    requires R >Int 0\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 242, "module": "VERIFICATION", "normalized_sha256": "9b8ee50fdbbf692e2fa2c6bc4aa68e73f5759ff24a19c85fc3e0de3519dd9348", "source_rule_id": "rule-9b8ee50fdbbf692e2fa2c6bc4aa68e73f5759ff24a19c85fc3e0de3519dd9348", "start_line": 239, "text": "  rule oddDone(A:ValSeq, snocVS(P:ValSeq, 1), R:Int, M:Int)\n    => pairDone(A, P, R, M)\n    requires R >=Int 0\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 252, "module": "VERIFICATION", "normalized_sha256": "a5ebd1d4f3b419e4c2c43d85b4e6635f83c4690767dd79f4cc70a7978a7a0868", "source_rule_id": "rule-a5ebd1d4f3b419e4c2c43d85b4e6635f83c4690767dd79f4cc70a7978a7a0868", "start_line": 249, "text": "  rule finishRel(A:ValSeq, O:ValSeq, R:Int, M:Int, K:Int)\n    => finishRel(snocVS(snocVS(A, 1), M), O, R -Int 1, M, K)\n    requires R >Int 0\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 256, "module": "VERIFICATION", "normalized_sha256": "c7278af29a3c60c871f7ff3a7c3952c49774e12971562f4587ee777e8641c36c", "source_rule_id": "rule-c7278af29a3c60c871f7ff3a7c3952c49774e12971562f4587ee777e8641c36c", "start_line": 253, "text": "  rule finishRel(A:ValSeq, O:ValSeq, R:Int, M:Int, K:Int)\n    => oddDone(A, O, R, M)\n    requires R <=Int 0 andBool pyMod(K, 2) ==Int 1\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 260, "module": "VERIFICATION", "normalized_sha256": "cc3c34d053c8b23f6e6cf08ebd52396cf1603b7f998c2537b215b81aec429a77", "source_rule_id": "rule-cc3c34d053c8b23f6e6cf08ebd52396cf1603b7f998c2537b215b81aec429a77", "start_line": 257, "text": "  rule finishRel(A:ValSeq, O:ValSeq, R:Int, M:Int, K:Int)\n    => pairDone(A, O, R, M)\n    requires R <=Int 0 andBool pyMod(K, 2) =/=Int 1\n    [simplification]"}, {"attributes": ["simplification"], "end_line": 267, "module": "VERIFICATION", "normalized_sha256": "b1bda544ef9b4f71186338fba4667904c2ea2f7439eeb2489e7cc0ff2a6790b4", "source_rule_id": "rule-b1bda544ef9b4f71186338fba4667904c2ea2f7439eeb2489e7cc0ff2a6790b4", "start_line": 264, "text": "  rule pathRel(O:ValSeq, K:Int, M:Int)\n    => finishRel(.ValSeq, O,\n                 (K -Int pyMod(K, 2)) /Int 2, M, K)\n    [simplification]"}, {"attributes": [], "end_line": 281, "module": "VERIFICATION", "normalized_sha256": "5e91d5878b05b36a225b4ca094e0d132a11ea5a75ec25646c5c2693ad7e1d665", "source_rule_id": "rule-5e91d5878b05b36a225b4ca094e0d132a11ea5a75ec25646c5c2693ad7e1d665", "start_line": 274, "text": "  rule innerLoop =>\n    While(Compare(Name(\"j\"), CmpOp(\"<\", Name(\"n\"))),\n      If(Compare(Subscript(Subscript(Name(\"grid\"), Name(\"i\")), Name(\"j\")),\n                 CmpOp(\"==\", Int(1))),\n        Assign(Name(\"row\"), Name(\"i\"))\n        Assign(Name(\"col\"), Name(\"j\")),\n        .Stmts)\n      Assign(Name(\"j\"), BinOp(\"+\", Name(\"j\"), Int(1))))"}, {"attributes": [], "end_line": 291, "module": "VERIFICATION", "normalized_sha256": "f796f1738d7e9178c66280212afbf48dafbd6e6337965746aee66533f1b39599", "source_rule_id": "rule-f796f1738d7e9178c66280212afbf48dafbd6e6337965746aee66533f1b39599", "start_line": 284, "text": "  rule innerWhile =>\n    #while(Compare(Name(\"j\"), CmpOp(\"<\", Name(\"n\"))),\n      If(Compare(Subscript(Subscript(Name(\"grid\"), Name(\"i\")), Name(\"j\")),\n                 CmpOp(\"==\", Int(1))),\n        Assign(Name(\"row\"), Name(\"i\"))\n        Assign(Name(\"col\"), Name(\"j\")),\n        .Stmts)\n      Assign(Name(\"j\"), BinOp(\"+\", Name(\"j\"), Int(1))))"}, {"attributes": [], "end_line": 298, "module": "VERIFICATION", "normalized_sha256": "0c55062d2f73635031204ba06cad589bd55bc5d0d731e5085c713c78cfb60c0c", "source_rule_id": "rule-0c55062d2f73635031204ba06cad589bd55bc5d0d731e5085c713c78cfb60c0c", "start_line": 294, "text": "  rule outerLoop =>\n    While(Compare(Name(\"i\"), CmpOp(\"<\", Name(\"n\"))),\n      Assign(Name(\"j\"), Int(0))\n      innerLoop\n      Assign(Name(\"i\"), BinOp(\"+\", Name(\"i\"), Int(1))))"}, {"attributes": [], "end_line": 305, "module": "VERIFICATION", "normalized_sha256": "e84773f9c1de78213d37b3f8341c1fb365935b9211f50e5a64b19781358ed9d3", "source_rule_id": "rule-e84773f9c1de78213d37b3f8341c1fb365935b9211f50e5a64b19781358ed9d3", "start_line": 301, "text": "  rule outerWhile =>\n    #while(Compare(Name(\"i\"), CmpOp(\"<\", Name(\"n\"))),\n      Assign(Name(\"j\"), Int(0))\n      innerLoop\n      Assign(Name(\"i\"), BinOp(\"+\", Name(\"i\"), Int(1))))"}, {"attributes": [], "end_line": 319, "module": "VERIFICATION", "normalized_sha256": "fd46566a19f94a079dd3bdd236e8f18d1595c7089df071b87a6692321193d280", "source_rule_id": "rule-fd46566a19f94a079dd3bdd236e8f18d1595c7089df071b87a6692321193d280", "start_line": 308, "text": "  rule upIf =>\n    If(Compare(Name(\"row\"), CmpOp(\">\", Int(0))),\n      If(Compare(Subscript(Subscript(Name(\"grid\"),\n                                      BinOp(\"-\", Name(\"row\"), Int(1))),\n                            Name(\"col\")),\n                 CmpOp(\"<\", Name(\"neighbor\"))),\n        Assign(Name(\"neighbor\"),\n               Subscript(Subscript(Name(\"grid\"),\n                                   BinOp(\"-\", Name(\"row\"), Int(1))),\n                         Name(\"col\"))),\n        .Stmts),\n      .Stmts)"}, {"attributes": [], "end_line": 333, "module": "VERIFICATION", "normalized_sha256": "1c3819c6162ca774675f45087a80fd055d59979f9e26a5df1f43e43e628b382f", "source_rule_id": "rule-1c3819c6162ca774675f45087a80fd055d59979f9e26a5df1f43e43e628b382f", "start_line": 322, "text": "  rule downIf =>\n    If(Compare(BinOp(\"+\", Name(\"row\"), Int(1)), CmpOp(\"<\", Name(\"n\"))),\n      If(Compare(Subscript(Subscript(Name(\"grid\"),\n                                      BinOp(\"+\", Name(\"row\"), Int(1))),\n                            Name(\"col\")),\n                 CmpOp(\"<\", Name(\"neighbor\"))),\n        Assign(Name(\"neighbor\"),\n               Subscript(Subscript(Name(\"grid\"),\n                                   BinOp(\"+\", Name(\"row\"), Int(1))),\n                         Name(\"col\"))),\n        .Stmts),\n      .Stmts)"}, {"attributes": [], "end_line": 345, "module": "VERIFICATION", "normalized_sha256": "157d34006be9f7c9582b1911d7fba01121181e8319a82ab246f7e7049a216897", "source_rule_id": "rule-157d34006be9f7c9582b1911d7fba01121181e8319a82ab246f7e7049a216897", "start_line": 336, "text": "  rule leftIf =>\n    If(Compare(Name(\"col\"), CmpOp(\">\", Int(0))),\n      If(Compare(Subscript(Subscript(Name(\"grid\"), Name(\"row\")),\n                            BinOp(\"-\", Name(\"col\"), Int(1))),\n                 CmpOp(\"<\", Name(\"neighbor\"))),\n        Assign(Name(\"neighbor\"),\n               Subscript(Subscript(Name(\"grid\"), Name(\"row\")),\n                         BinOp(\"-\", Name(\"col\"), Int(1)))),\n        .Stmts),\n      .Stmts)"}, {"attributes": [], "end_line": 357, "module": "VERIFICATION", "normalized_sha256": "0804c153b600b6747ed9f6f46e0d63125d16993d666a588b4557273589aac289", "source_rule_id": "rule-0804c153b600b6747ed9f6f46e0d63125d16993d666a588b4557273589aac289", "start_line": 348, "text": "  rule rightIf =>\n    If(Compare(BinOp(\"+\", Name(\"col\"), Int(1)), CmpOp(\"<\", Name(\"n\"))),\n      If(Compare(Subscript(Subscript(Name(\"grid\"), Name(\"row\")),\n                            BinOp(\"+\", Name(\"col\"), Int(1))),\n                 CmpOp(\"<\", Name(\"neighbor\"))),\n        Assign(Name(\"neighbor\"),\n               Subscript(Subscript(Name(\"grid\"), Name(\"row\")),\n                         BinOp(\"+\", Name(\"col\"), Int(1)))),\n        .Stmts),\n      .Stmts)"}, {"attributes": [], "end_line": 364, "module": "VERIFICATION", "normalized_sha256": "5059cd0eda52a24992558074cef1dcaad9a65b965e11693893deede9ba08a1bf", "source_rule_id": "rule-5059cd0eda52a24992558074cef1dcaad9a65b965e11693893deede9ba08a1bf", "start_line": 360, "text": "  rule neighborUpdates =>\n    upIf\n    downIf\n    leftIf\n    rightIf"}, {"attributes": [], "end_line": 371, "module": "VERIFICATION", "normalized_sha256": "b609b812b74289db560441458b74ec8da99c65b380aa0c8ff1e2ae94524679fc", "source_rule_id": "rule-b609b812b74289db560441458b74ec8da99c65b380aa0c8ff1e2ae94524679fc", "start_line": 367, "text": "  rule resultBody =>\n    Expr(Call(Attribute(Name(\"result\"), \"append\"), (Int(1), .Exprs)))\n    Expr(Call(Attribute(Name(\"result\"), \"append\"),\n              (Name(\"neighbor\"), .Exprs)))\n    Assign(Name(\"pairs\"), BinOp(\"-\", Name(\"pairs\"), Int(1)))"}, {"attributes": [], "end_line": 375, "module": "VERIFICATION", "normalized_sha256": "9186e6e6cc36e846fe464ebbc4255d49c2b3fb4ef624e27f63ff85e5acec5bd7", "source_rule_id": "rule-9186e6e6cc36e846fe464ebbc4255d49c2b3fb4ef624e27f63ff85e5acec5bd7", "start_line": 374, "text": "  rule resultLoop =>\n    While(Compare(Name(\"pairs\"), CmpOp(\">\", Int(0))), resultBody)"}, {"attributes": [], "end_line": 379, "module": "VERIFICATION", "normalized_sha256": "263e6212dff5f9a87aa5ab3b3447717360279bef526c83944173395be406a97f", "source_rule_id": "rule-263e6212dff5f9a87aa5ab3b3447717360279bef526c83944173395be406a97f", "start_line": 378, "text": "  rule resultWhile =>\n    #while(Compare(Name(\"pairs\"), CmpOp(\">\", Int(0))), resultBody)"}, {"attributes": [], "end_line": 385, "module": "VERIFICATION", "normalized_sha256": "d125023c9f5ddd546c4a307a3c1bf0615b9f6b55d18fd7b8e18c8d987724ff53", "source_rule_id": "rule-d125023c9f5ddd546c4a307a3c1bf0615b9f6b55d18fd7b8e18c8d987724ff53", "start_line": 382, "text": "  rule oddTail =>\n    If(Compare(BinOp(\"%\", Name(\"k\"), Int(2)), CmpOp(\"==\", Int(1))),\n      Expr(Call(Attribute(Name(\"result\"), \"append\"), (Int(1), .Exprs))),\n      .Stmts)"}, {"attributes": [], "end_line": 390, "module": "VERIFICATION", "normalized_sha256": "4a3876c65455812dea56f88050c9ccafa314b7af437efaf1f1b34c33f79fbfca", "source_rule_id": "rule-4a3876c65455812dea56f88050c9ccafa314b7af437efaf1f1b34c33f79fbfca", "start_line": 388, "text": "  rule resultFinish =>\n    resultLoop\n    oddTail"}, {"attributes": [], "end_line": 409, "module": "VERIFICATION", "normalized_sha256": "a577ce69054ad399097fe92ce75108021677c41662dd8b01c504458209ab62ef", "source_rule_id": "rule-a577ce69054ad399097fe92ce75108021677c41662dd8b01c504458209ab62ef", "start_line": 393, "text": "  rule minPathBody =>\n    Assign(Name(\"n\"), Call(Name(\"len\"), (Name(\"grid\"), .Exprs)))\n    Assign(Name(\"row\"), Int(0))\n    Assign(Name(\"col\"), Int(0))\n    Assign(Name(\"i\"), Int(0))\n    outerLoop\n    Assign(Name(\"neighbor\"),\n           BinOp(\"+\", BinOp(\"*\", Name(\"n\"), Name(\"n\")), Int(1)))\n    upIf\n    downIf\n    leftIf\n    rightIf\n    Assign(Name(\"result\"), ListExpr(.Exprs))\n    Assign(Name(\"pairs\"), BinOp(\"//\", Name(\"k\"), Int(2)))\n    resultLoop\n    oddTail\n    Return(Name(\"result\"))"}], "schema_version": 2, "verification_file": "verification.k", "verification_module": "VERIFICATION", "verification_modules": ["VERIFICATION"], "verification_sha256": "2834fcdd963685cbed1873b2aa802b5f508d1028eeee72007f4e7001c223fb76"}

