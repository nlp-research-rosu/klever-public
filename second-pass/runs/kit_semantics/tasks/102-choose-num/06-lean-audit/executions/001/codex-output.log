+input-manifest.json selected   = 574efc934b5c52ee1cf99af692f0e4f3a47d7ebd41de00d122fe57176351dca0
+input-manifest.json reproduced = 2e2ab8e90c17813ad85015ca7537cc968cedf12f4cd4cd5c396ec13839b8aee1
+generator-manifest.json both   = a0a22cbc24c259ae9deb323ae9c23fc61b7be3ef254fdf5fe95680c06e8f3581
+trust-inventory.json both      = c799b6ed2f89b8ae9a9315501c366064a40db694a9caeabd51e40b197f781ace
