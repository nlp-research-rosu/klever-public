+  "stage1_workspace_sha256": "5af15dab0d5e0a6edfaa9cd7937b6f7391b760ca38e4a5628571f0e8761f31a2",
+  "stage3_discovery_manifest_sha256": "608d1a5cf80908fa99b1147aa71fc764f7731132eee2a71138c4b722ef483870",
