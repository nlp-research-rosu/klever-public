Module(
  FuncDef("is_sorted", Params("lst"),
    Assign(
      Name("result"),
      Compare(
        Name("lst"),
        CmpOp("==", Call(Name("sorted"), Name("lst")))))
    Assign(Name("previous"), TupleExpr(UnaryOp("-", Int(1))))
    Assign(Name("repeated"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Compare(TupleExpr(Name("value")), CmpOp("==", Name("previous"))),
        AugAssign(Name("repeated"), "+", Int(1)),
        Assign(Name("repeated"), Int(1)))
      If(Compare(Name("repeated"), CmpOp(">", Int(2))),
        Assign(Name("result"), Bool(false)),
        )
      Assign(Name("previous"), TupleExpr(Name("value"))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr()),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("is_sorted"), ListExpr(Int(5))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(3), Int(2), Int(4), Int(5))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6), Int(7))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(3), Int(2), Int(4), Int(5), Int(6), Int(7))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(2), Int(2), Int(3), Int(3), Int(4))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(2), Int(2), Int(2), Int(3), Int(4))),
      CmpOp("==", Bool(false)))))
