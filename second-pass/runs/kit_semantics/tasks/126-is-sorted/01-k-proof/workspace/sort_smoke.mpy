Module(
  Assert(
    Compare(Call(Name("sorted"), ListExpr()), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sorted"), ListExpr(Int(0))),
      CmpOp("==", ListExpr(Int(0)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(0), Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(4), Int(3), Int(2), Int(1), Int(0))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(2), Int(0), Int(4), Int(1), Int(3))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(2), Int(2), Int(1), Int(1), Int(0), Int(0))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(0), Int(1), Int(1), Int(2), Int(2)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(3), Int(1), Int(3), Int(2), Int(3), Int(0))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(1), Int(2), Int(3), Int(3), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(9), Int(0), Int(9), Int(1), Int(8), Int(2))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(1), Int(2), Int(8), Int(9), Int(9)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(1000000), Int(0), Int(999999), Int(1))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(999999), Int(1000000))))))
