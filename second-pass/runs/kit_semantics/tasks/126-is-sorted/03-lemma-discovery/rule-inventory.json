      "source_rule_id": "rule-9da19620601eda09007ce7a8cc8d06741af23816ce9c753e25d2ce83590d2a08",
      "start_line": 39,
      "text": "  rule duplicateOK(_P:Val, _C:Int, .ValSeq) => true"
    },
    {
      "attributes": [],
      "end_line": 42,
      "module": "VERIFICATION",
      "normalized_sha256": "e014a635d87cea6d62e6e287295fa3bc107f43474eed3ad82736a19c19a9a445",
