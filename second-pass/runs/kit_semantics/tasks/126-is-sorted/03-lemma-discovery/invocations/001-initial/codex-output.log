/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
output = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert set(output) == {'schema_version', 'inventory_sha256', 'rules'}
assert output['schema_version'] == 2
assert output['inventory_sha256'] == inventory['inventory_sha256']
assert len(output['rules']) == len(inventory['rules'])
canonical_ids = [rule['source_rule_id'] for rule in inventory['rules']]
output_ids = [rule['source_rule_id'] for rule in output['rules']]
assert output_ids == canonical_ids
assert len(output_ids) == len(set(output_ids))
for source, classified in zip(inventory['rules'], output['rules']):
    assert set(classified) == {'source_rule_id', 'classification', 'rationale'}
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if 'simplification' in source.get('attributes', []):
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = {name: 0 for name in sorted(allowed)}
for rule in output['rules']:
    counts[rule['classification']] += 1
print(f\"validated_rules={len(output_ids)} unique={len(set(output_ids))} order_match=true\")
print(f\"inventory_sha256={output['inventory_sha256']}\")
print('classification_counts=' + json.dumps(counts, sort_keys=True))
PY
