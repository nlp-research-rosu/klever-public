{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "beaad117ffc7adde1bfa718b5ed4c2c4c11c96b96269e20ef3cf0721687562c7",
      "rationale": "Base equation defining the nonNegativeVals domain predicate on the empty value sequence.",
      "source_rule_id": "rule-beaad117ffc7adde1bfa718b5ed4c2c4c11c96b96269e20ef3cf0721687562c7",
      "start_line": 10,
      "text": "  rule nonNegativeVals(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "VERIFICATION",
      "normalized_sha256": "169ca13222aba516610f2f3333afb45ac672487dd5eedf7cba1b372b032ad84e",
      "rationale": "Structural recurrence defining nonNegativeVals for an integer head and the remaining sequence.",
      "source_rule_id": "rule-169ca13222aba516610f2f3333afb45ac672487dd5eedf7cba1b372b032ad84e",
      "start_line": 11,
      "text": "  rule nonNegativeVals(vCons(I:Int, R:ValSeq))\n    => I >=Int 0 andBool nonNegativeVals(R)"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "f71898f519952d4b619a231b65ef25f5c3bf08470985c0d59323c2f952a2b38c",
      "rationale": "Fallback equation completing the definition of nonNegativeVals by rejecting non-integer-headed sequences.",
      "source_rule_id": "rule-f71898f519952d4b619a231b65ef25f5c3bf08470985c0d59323c2f952a2b38c",
      "start_line": 13,
      "text": "  rule nonNegativeVals(vCons(_V:Val, _R:ValSeq)) => false [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "0d5d6f36eef5a945a5bd65092a43ff9917c565acc59aab6f035bb0f2716643ce",
      "rationale": "Guarded defining equation for the next repetition count when the current value equals the previous value.",
      "source_rule_id": "rule-0d5d6f36eef5a945a5bd65092a43ff9917c565acc59aab6f035bb0f2716643ce",
      "start_line": 18,
      "text": "  rule nextRepeated(P:Val, C:Int, V:Val) => C +Int 1\n    requires V ==K P"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "fd1ec1a90c0403ded5044dde282230cfd2792e04c450da74d55dbe7843ee3a77",
      "rationale": "Complementary guarded defining equation that resets the repetition count when the values differ.",
      "source_rule_id": "rule-fd1ec1a90c0403ded5044dde282230cfd2792e04c450da74d55dbe7843ee3a77",
      "start_line": 20,
      "text": "  rule nextRepeated(P:Val, _C:Int, V:Val) => 1\n    requires notBool (V ==K P)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "90687f0a502170fb78b442fd1a63401f4a4e1b9300364483ac0c6efe89733f09",
      "rationale": "Base equation defining the final previous value after scanning an empty suffix.",
      "source_rule_id": "rule-90687f0a502170fb78b442fd1a63401f4a4e1b9300364483ac0c6efe89733f09",
      "start_line": 24,
      "text": "  rule scanPrevious(P:Val, .ValSeq) => P"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "d8677c6fccec9429df6d61abb94bc59dc5f5e384f7da2b58aa818059a9de6df3",
      "rationale": "Structural recurrence defining the final previous value by advancing through the sequence.",
      "source_rule_id": "rule-d8677c6fccec9429df6d61abb94bc59dc5f5e384f7da2b58aa818059a9de6df3",
      "start_line": 25,
      "text": "  rule scanPrevious(_P:Val, vCons(V:Val, R:ValSeq))\n    => scanPrevious(V, R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "2266aab20abc82eb3484be14fc44e3034e9399d1d7eff22376bd50d8e01e499e",
      "rationale": "Base equation defining the final repetition count after scanning an empty suffix.",
      "source_rule_id": "rule-2266aab20abc82eb3484be14fc44e3034e9399d1d7eff22376bd50d8e01e499e",
      "start_line": 29,
      "text": "  rule scanRepeated(_P:Val, C:Int, .ValSeq) => C"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "VERIFICATION",
      "normalized_sha256": "42ed6c0a5951c9c02e751ce2b80700dc83a31a2d3b20cf17d16bbb4466746134",
      "rationale": "Structural recurrence defining the final repetition count using nextRepeated on each sequence element.",
      "source_rule_id": "rule-42ed6c0a5951c9c02e751ce2b80700dc83a31a2d3b20cf17d16bbb4466746134",
      "start_line": 30,
      "text": "  rule scanRepeated(P:Val, C:Int, vCons(V:Val, R:ValSeq))\n    => scanRepeated(V, nextRepeated(P, C, V), R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "040eac744343330f6cdb903efd25145f7c99b00aaf03b845011d6673d3921347",
      "rationale": "Base equation defining the final loop value after scanning an empty suffix.",
      "source_rule_id": "rule-040eac744343330f6cdb903efd25145f7c99b00aaf03b845011d6673d3921347",
      "start_line": 34,
      "text": "  rule scanValue(V:Val, .ValSeq) => V"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "VERIFICATION",
      "normalized_sha256": "d2e79fd3f793529c7593003c61390654e154872a4587b7641deb227e8704e75b",
      "rationale": "Structural recurrence defining the final loop value by retaining the last scanned element.",
      "source_rule_id": "rule-d2e79fd3f793529c7593003c61390654e154872a4587b7641deb227e8704e75b",
      "start_line": 35,
      "text": "  rule scanValue(_V:Val, vCons(V:Val, R:ValSeq))\n    => scanValue(V, R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "9da19620601eda09007ce7a8cc8d06741af23816ce9c753e25d2ce83590d2a08",
      "rationale": "Base equation defining duplicateOK as true when no values remain to be scanned.",
      "source_rule_id": "rule-9da19620601eda09007ce7a8cc8d06741af23816ce9c753e25d2ce83590d2a08",
      "start_line": 39,
      "text": "  rule duplicateOK(_P:Val, _C:Int, .ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 42,
      "module": "VERIFICATION",
      "normalized_sha256": "e014a635d87cea6d62e6e287295fa3bc107f43474eed3ad82736a19c19a9a445",
      "rationale": "Structural recurrence defining duplicateOK by checking the next run count and descending on the tail.",
      "source_rule_id": "rule-e014a635d87cea6d62e6e287295fa3bc107f43474eed3ad82736a19c19a9a445",
      "start_line": 40,
      "text": "  rule duplicateOK(P:Val, C:Int, vCons(V:Val, R:ValSeq))\n    => notBool (nextRepeated(P, C, V) >Int 2)\n       andBool duplicateOK(V, nextRepeated(P, C, V), R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 47,
      "module": "VERIFICATION",
      "normalized_sha256": "a2dd1a77bad40a260a9f17e7ff3caebe2f28fb6d59ed71f0e6de2b67306156a7",
      "rationale": "Defining equation for the accumulated duplicate-scan result as the prior Boolean conjoined with duplicateOK.",
      "source_rule_id": "rule-a2dd1a77bad40a260a9f17e7ff3caebe2f28fb6d59ed71f0e6de2b67306156a7",
      "start_line": 46,
      "text": "  rule scanDuplicates(P:Val, C:Int, B:Bool, VS:ValSeq)\n    => B andBool duplicateOK(P, C, VS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "db33becc1595a9eed4b2f89061098fc8333d517497cc1e6ba7985fddc622f98c",
      "rationale": "Guarded equation defining the named contract predicate from sortVS equality and the duplicate-scan summary.",
      "source_rule_id": "rule-db33becc1595a9eed4b2f89061098fc8333d517497cc1e6ba7985fddc622f98c",
      "start_line": 53,
      "text": "  rule sortedWithAtMostTwo(VS:ValSeq)\n    => (VS ==K sortVS(VS))\n       andBool scanDuplicates(-1, 0, true, VS)\n    requires nonNegativeVals(VS)"
    }
  ],
