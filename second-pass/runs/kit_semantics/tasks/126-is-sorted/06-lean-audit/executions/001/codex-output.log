{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "beaad117ffc7adde1bfa718b5ed4c2c4c11c96b96269e20ef3cf0721687562c7",
      "rationale": "Base equation defining the nonNegativeVals domain predicate on the empty value sequence.",
      "source_rule_id": "rule-beaad117ffc7adde1bfa718b5ed4c2c4c11c96b96269e20ef3cf0721687562c7",
      "start_line": 10,
      "text": "  rule nonNegativeVals(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "VERIFICATION",
      "normalized_sha256": "169ca13222aba516610f2f3333afb45ac672487dd5eedf7cba1b372b032ad84e",
      "rationale": "Structural recurrence defining nonNegativeVals for an integer head and the remaining sequence.",
      "source_rule_id": "rule-169ca13222aba516610f2f3333afb45ac672487dd5eedf7cba1b372b032ad84e",
      "start_line": 11,
      "text": "  rule nonNegativeVals(vCons(I:Int, R:ValSeq))\n    => I >=Int 0 andBool nonNegativeVals(R)"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "f71898f519952d4b619a231b65ef25f5c3bf08470985c0d59323c2f952a2b38c",
      "rationale": "Fallback equation completing the definition of nonNegativeVals by rejecting non-integer-headed sequences.",
      "source_rule_id": "rule-f71898f519952d4b619a231b65ef25f5c3bf08470985c0d59323c2f952a2b38c",
      "start_line": 13,
      "text": "  rule nonNegativeVals(vCons(_V:Val, _R:ValSeq)) => false [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "0d5d6f36eef5a945a5bd65092a43ff9917c565acc59aab6f035bb0f2716643ce",
      "rationale": "Guarded defining equation for the next repetition count when the current value equals the previous value.",
      "source_rule_id": "rule-0d5d6f36eef5a945a5bd65092a43ff9917c565acc59aab6f035bb0f2716643ce",
      "start_line": 18,
      "text": "  rule nextRepeated(P:Val, C:Int, V:Val) => C +Int 1\n    requires V ==K P"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "fd1ec1a90c0403ded5044dde282230cfd2792e04c450da74d55dbe7843ee3a77",
      "rationale": "Complementary guarded defining equation that resets the repetition count when the values differ.",
      "source_rule_id": "rule-fd1ec1a90c0403ded5044dde282230cfd2792e04c450da74d55dbe7843ee3a77",
      "start_line": 20,
      "text": "  rule nextRepeated(P:Val, _C:Int, V:Val) => 1\n    requires notBool (V ==K P)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "90687f0a502170fb78b442fd1a63401f4a4e1b9300364483ac0c6efe89733f09",
      "rationale": "Base equation defining the final previous value after scanning an empty suffix.",
      "source_rule_id": "rule-90687f0a502170fb78b442fd1a63401f4a4e1b9300364483ac0c6efe89733f09",
      "start_line": 24,
      "text": "  rule scanPrevious(P:Val, .ValSeq) => P"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "d8677c6fccec9429df6d61abb94bc59dc5f5e384f7da2b58aa818059a9de6df3",
      "rationale": "Structural recurrence defining the final previous value by advancing through the sequence.",
