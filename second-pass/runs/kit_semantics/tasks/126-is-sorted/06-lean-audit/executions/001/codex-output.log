codex
The failure is caused by the audit sandbox’s PID namespace: Lean 4.22 asks for `/proc/<namespace-pid>/exe`, while this container’s `/proc` exposes host PIDs, so the path does not exist. I’m applying a narrowly scoped preload shim that redirects only that executable-path lookup to `/proc/self/exe`; the trusted checker and generated project remain unchanged.
apply patch
patch: completed
/tmp/audit-work/lean-proc-self-shim.c
diff --git a//tmp/audit-work/lean-proc-self-shim.c b//tmp/audit-work/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..ad58f247b3bbd06b4bfc7a9f4c851ae0ceff9cdb
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    const char *suffix = "/exe";
+    size_t length;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    length = strlen(path);
+    if (strncmp(path, "/proc/", 6) == 0
+        && length >= strlen(suffix)
+        && strcmp(path + length - strlen(suffix), suffix) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

