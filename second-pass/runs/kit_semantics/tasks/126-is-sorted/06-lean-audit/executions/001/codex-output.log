/bin/bash -lc "python - <<'PY'
def equations(xs):
    previous=-1; count=0; ok=True
    for value in xs:
        count = count + 1 if value == previous else 1
        ok = ok and not (count > 2)
        previous=value
    return (xs == sorted(xs)) and ok

def source_operational(xs):
    result = xs == sorted(xs)
    previous=(-1,); repeated=0
    for value in xs:
        if (value,) == previous: repeated += 1
        else: repeated = 1
        if repeated > 2: result=False
        previous=(value,)
    return result

def expected(xs):
    return all(xs[i] <= xs[i+1] for i in range(len(xs)-1)) and all(xs.count(x) <= 2 for x in set(xs))

cases=[[],[0],[0,0],[0,0,0],[0,1,1,2],[0,1,1,1,2],[0,2,1],[0,1,0],[1,1,2,2],[1,1,2,2,2],[0,0,1,2,2,3],[4,3,3]]
print('case\\tequations\\toperational\\texpected\\tmatch')
for xs in cases:
    a,b,c=equations(xs),source_operational(xs),expected(xs)
    print(f'{xs}\\t{a}\\t{b}\\t{c}\\t{a==b==c}')
print('all_cases_match=',all(equations(xs)==source_operational(xs)==expected(xs) for xs in cases))
