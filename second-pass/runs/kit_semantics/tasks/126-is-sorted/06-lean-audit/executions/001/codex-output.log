check('input verification hash', im['verification_sha256'], sha(K/'verification.k'))
check('generator generated tree', gm['generated_tree_sha256'], a['hashes']['generated_tree_sha256'])
check('export generated tree', er['generated_tree_sha256'], a['hashes']['generated_tree_sha256'])
check('obligation map sha256', gm['obligation_map_sha256'], sha(G/'generated/obligation-map.json'))
check('trust inventory sha256', er['trust_inventory_sha256'], sha(G/'trust-inventory.json'))
check('obligation count generator-vs-map', gm['obligation_count'], len(om['obligations']))
check('obligation count export-vs-map', er['obligation_count'], len(om['obligations']))
