/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
allowed = {'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert isinstance(out['rules'], list)
assert len(out['rules']) == len(inv['rules'])
expected_ids = [r['source_rule_id'] for r in inv['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids, (actual_ids, expected_ids)
assert len(actual_ids) == len(set(actual_ids))
for canonical, classified in zip(inv['rules'], out['rules']):
    assert list(classified) == ['source_rule_id', 'classification', 'rationale'], list(classified)
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if 'simplification' in canonical.get('attributes', []):
        assert classified['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print(f\"SCHEMA_OK: {len(actual_ids)} rules, exact order, no duplicates, SHA copied\")
from collections import Counter
print('CLASS_COUNTS:', dict(Counter(r['classification'] for r in out['rules'])))
PY
