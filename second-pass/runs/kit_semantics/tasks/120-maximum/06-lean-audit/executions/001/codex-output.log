print(f\"ordered_ids_match={[r['\"'\"'source_rule_id'\"'\"'] for r in inv['\"'\"'rules'\"'\"']]==[r['\"'\"'source_rule_id'\"'\"'] for r in disc['\"'\"'rules'\"'\"']]}\")
print(f\"canonical_ids_unique={len({r['\"'\"'source_rule_id'\"'\"'] for r in inv['\"'\"'rules'\"'\"']})==len(inv['\"'\"'rules'\"'\"'])}\")
print(f\"classified_ids_unique={len({r['\"'\"'source_rule_id'\"'\"'] for r in disc['\"'\"'rules'\"'\"']})==len(disc['\"'\"'rules'\"'\"'])}\")
