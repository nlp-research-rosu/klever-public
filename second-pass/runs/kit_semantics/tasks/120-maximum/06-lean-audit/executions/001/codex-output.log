index 0000000000000000000000000000000000000000..d34eaaa02ea4101f338756d7f56f06a971e1bcb5
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+/*
+ * The Codex audit sandbox uses a private PID namespace with the host /proc
+ * mount. Lean 4.22 asks readlink("/proc/<inner-pid>/exe"), which therefore
+ * fails with ENOENT. Preserve normal readlink behavior and retry only that
+ * failed executable-path lookup through the kernel's /proc/self alias.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+        if (real_readlink == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+
+    ssize_t result = real_readlink(path, buffer, size);
+    if (result >= 0 || errno != ENOENT) {
+        return result;
+    }
+
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t length = strlen(path);
+    if (length > sizeof(prefix) - 1 + sizeof(suffix) - 1 &&
+        strncmp(path, prefix, sizeof(prefix) - 1) == 0 &&
+        strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return result;
+}
diff --git a//tmp/audit-work/run_required_preflight.py b//tmp/audit-work/run_required_preflight.py
new file mode 100644
index 0000000000000000000000000000000000000000..376cdc9df25760877b01aa317b55fde2d3e8b470
--- /dev/null
+++ b//tmp/audit-work/run_required_preflight.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+
+import json
+import os
+import subprocess
+from pathlib import Path
+
+from tools.klean_preflight import check_generation
+
+
+EVIDENCE = Path("/audit-output/evidence")
+SHIM = "/tmp/audit-work/lean-proc-self-shim.so"
+ELAN_HOME = "/opt/elan"
+command_index = 0
+
+
+def recorded_run(command: list[str], *, cwd: Path, timeout: int) -> tuple[int, str]:
+    global command_index
+    command_index += 1
+    environment = dict(os.environ)
+    environment["LD_PRELOAD"] = SHIM
+    environment["ELAN_HOME"] = ELAN_HOME
+    try:
+        result = subprocess.run(
+            command,
+            cwd=cwd,
+            timeout=timeout,
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            env=environment,
+        )
+        code = result.returncode
+        output = result.stdout
+    except subprocess.TimeoutExpired as error:
+        code = 124
+        output = (
+            (error.stdout or "")
+            + (error.stderr or "")
+            + f"\nTIMEOUT after {timeout}s\n"
+        )
+    transcript = (
+        f"COMMAND: {' '.join(command)}\n"
+        f"CWD: {cwd}\n"
+        f"LD_PRELOAD: {SHIM}\n"
+        f"ELAN_HOME: {ELAN_HOME}\n"
+        f"EXIT_CODE: {code}\n"
+        "OUTPUT:\n"
+        f"{output}"
+    )
+    (EVIDENCE / f"preflight-command-{command_index:02d}.txt").write_text(
+        transcript
+    )
+    return code, output
+
+
+result = check_generation(
+    Path("/reference/k-proof"),
+    Path("/reference/lemma-discovery.json"),
+    Path("/reference/klean-generation"),
+    toolchain_lock=Path("/reference/klean-toolchain.lock.json"),
+    run_command=recorded_run,
+)
+print(json.dumps(result, indent=2, sort_keys=True))

