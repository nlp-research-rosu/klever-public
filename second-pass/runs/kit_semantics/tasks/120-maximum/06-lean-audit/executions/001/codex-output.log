+++ b//tmp/audit-work/run_required_preflight.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+
+import json
+import os
+import subprocess
+from pathlib import Path
+
+from tools.klean_preflight import check_generation
+
+
+EVIDENCE = Path("/audit-output/evidence")
+SHIM = "/tmp/audit-work/lean-proc-self-shim.so"
+ELAN_HOME = "/opt/elan"
+command_index = 0
+
+
+def recorded_run(command: list[str], *, cwd: Path, timeout: int) -> tuple[int, str]:
+    global command_index
+    command_index += 1
+    environment = dict(os.environ)
+    environment["LD_PRELOAD"] = SHIM
+    environment["ELAN_HOME"] = ELAN_HOME
+    try:
+        result = subprocess.run(
+            command,
+            cwd=cwd,
+            timeout=timeout,
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            env=environment,
+        )
+        code = result.returncode
+        output = result.stdout
+    except subprocess.TimeoutExpired as error:
+        code = 124
+        output = (
+            (error.stdout or "")
+            + (error.stderr or "")
+            + f"\nTIMEOUT after {timeout}s\n"
+        )
+    transcript = (
+        f"COMMAND: {' '.join(command)}\n"
+        f"CWD: {cwd}\n"
+        f"LD_PRELOAD: {SHIM}\n"
+        f"ELAN_HOME: {ELAN_HOME}\n"
+        f"EXIT_CODE: {code}\n"
+        "OUTPUT:\n"
+        f"{output}"
+    )
+    (EVIDENCE / f"preflight-command-{command_index:02d}.txt").write_text(
+        transcript
+    )
+    return code, output
+
+
+result = check_generation(
+    Path("/reference/k-proof"),
+    Path("/reference/lemma-discovery.json"),
+    Path("/reference/klean-generation"),
+    toolchain_lock=Path("/reference/klean-toolchain.lock.json"),
+    run_command=recorded_run,
+)
+print(json.dumps(result, indent=2, sort_keys=True))

