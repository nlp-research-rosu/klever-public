source_recorded=res[\"stage1_source_hashes\"]
print(f\"stage1_source_hashes: recorded_count={len(source_recorded)} actual_count={len(source_actual)} exact_map_match={source_recorded==source_actual}\")
print(f\"stage1_source_missing={sorted(set(source_recorded)-set(source_actual))}\")
print(f\"stage1_source_extra={sorted(set(source_actual)-set(source_recorded))}\")
print(f\"stage1_source_mismatches={sorted(k for k in set(source_actual)&set(source_recorded) if source_actual[k]"'!=source_recorded[k])}")
inv=inventory_verification(Path("/reference/k-proof"))
