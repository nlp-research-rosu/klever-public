 normalized=\" \".join(span.split())
 digest=hashlib.sha256(normalized.encode()).hexdigest()
 print(f\"rule[{index}] module={rule['\"'\"'module'\"'\"']} span={rule['\"'\"'start_line'\"'\"']}-{rule['\"'\"'end_line'\"'\"']} text_exact={span==rule['\"'\"'text'\"'\"']} normalized_sha256={digest} hash_match={digest==rule['\"'\"'normalized_sha256'\"'\"']} id_match={rule['\"'\"'source_rule_id'\"'\"']==('\"'\"'rule-'\"'\"'+digest)}\")
print(f\"inventory_hash_recomputed={canonical_json_sha256(inv['\"'\"'rules'\"'\"'])}\")
print(f\"inventory_hash_matches_inventory={canonical_json_sha256(inv['\"'\"'rules'\"'\"'])==inv['\"'\"'inventory_sha256'\"'\"']}\")
print(f\"inventory_hash_matches_discovery={canonical_json_sha256(inv['\"'\"'rules'\"'\"'])==disc['\"'\"'inventory_sha256'\"'\"']}\")
'
  audit_status="'$?
