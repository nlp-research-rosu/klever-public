+          closureVal(
+            ("arr", "k"),
+            Return(
+              Subscript(
+                Call(Name("sorted"), Name("arr")),
+                Slice(
+                  BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                  NoBound,
+                  NoBound))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(vCons(1, vCons(2, .ValSeq))))
+      1 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
