+                    "-",
+                    BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                    Int(1)),
+                  NoBound,
+                  NoBound))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(vCons(1, vCons(2, .ValSeq))))
