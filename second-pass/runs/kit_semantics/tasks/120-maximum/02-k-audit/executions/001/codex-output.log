+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "maximum",
+            Params("arr", "k"),
+            Return(
+              Subscript(
+                Call(Name("sorted"), Name("arr")),
+                Slice(
+                  BinOp(
+                    "-",
+                    BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                    Int(1)),
+                  NoBound,
+                  NoBound))))))
+      ~>
+      Call(Name("maximum"), list(vCons(1, vCons(2, .ValSeq))), 1)
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "maximum" |->
+          closureVal(
+            ("arr", "k"),
+            Return(
+              Subscript(
