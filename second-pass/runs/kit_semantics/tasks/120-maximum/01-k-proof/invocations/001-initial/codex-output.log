+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "maximum" |->
+          closureVal(
+            ("arr", "k"),
+            Return(
+              Subscript(
+                Call(Name("sorted"), Name("arr")),
+                Slice(
+                  BinOp(
+                    "-",
+                    BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                    Int(1)),
+                  NoBound,
+                  NoBound))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(2, .ValSeq)))
+      1 |-> maximumResult(vCons(1, vCons(2, .ValSeq)), 1)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
