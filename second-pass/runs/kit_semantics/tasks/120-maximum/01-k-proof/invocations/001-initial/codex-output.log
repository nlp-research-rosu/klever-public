diff --git a/spec-body-mutation.k b/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..d34c7c6cd2cfefc1c4b8ddfba8a4ec9d655b7bf8
--- /dev/null
+++ b/spec-body-mutation.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // The source lower bound is deliberately mutated from len(arr) - k to
+  // len(arr) - k - 1 while the correct postcondition is retained.
+  claim [mutated-body-rejected]:
+    <k>
+      Call(
+        Name("maximum"),
+        list(vCons(1, vCons(2, .ValSeq))),
+        1)
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "maximum" |->
+          closureVal(
+            ("arr", "k"),
+            Return(
+              Subscript(
+                Call(Name("sorted"), Name("arr")),
+                Slice(
+                  BinOp(
+                    "-",
+                    BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                    Int(1)),
+                  NoBound,
+                  NoBound))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(2, .ValSeq)))
+      1 |-> maximumResult(vCons(1, vCons(2, .ValSeq)), 1)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec-vacuity.k b/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..7eb19052c78741a973d46508dc6860138fac2126
--- /dev/null
+++ b/spec-vacuity.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false for the realizable witness arr = [1, 2], k = 1:
+  // the returned list is [2], not [].
+  claim [false-result]:
+    <k>
+      Call(
+        Name("maximum"),
+        list(vCons(1, vCons(2, .ValSeq))),
+        1)
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "maximum" |->
+          closureVal(
+            ("arr", "k"),
+            Return(
+              Subscript(
+                Call(Name("sorted"), Name("arr")),
+                Slice(
+                  BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                  NoBound,
+                  NoBound))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(2, .ValSeq)))
+      1 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2a4510f0102764c18e49c15f0014380241f233df
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,60 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [maximum-correct]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "maximum",
+            Params("arr", "k"),
+            Return(
+              Subscript(
+                Call(Name("sorted"), Name("arr")),
+                Slice(
+                  BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                  NoBound,
+                  NoBound))))))
+      ~>
+      Call(Name("maximum"), list(VS:ValSeq), K:Int)
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "maximum" |->
+          closureVal(
+            ("arr", "k"),
+            Return(
+              Subscript(
+                Call(Name("sorted"), Name("arr")),
+                Slice(
+                  BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                  NoBound,
+                  NoBound))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(VS))
+      1 |-> maximumResult(VS, K)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 1 <=Int vsLen(VS)
+     andBool vsLen(VS) <=Int 1000
+     andBool 0 <=Int K
+     andBool K <=Int vsLen(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4573576b36e5a6f2c41e12e679e314d38feb8651
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,15 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A definitional name for the value produced by the source expression
+  // sorted(arr)[len(arr) - k:].  This does not rewrite source execution.
+  syntax Val ::= maximumResult(ValSeq, Int) [function, total]
+  rule maximumResult(VS, K)
+    => doSlice(
+         list(sortVS(VS)),
+         someB(vsLen(VS) -Int K),
+         noB,
+         noB)
+endmodule

