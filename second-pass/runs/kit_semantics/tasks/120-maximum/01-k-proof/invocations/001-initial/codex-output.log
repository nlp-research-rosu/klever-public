+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(VS))
+      1 |-> maximumResult(VS, K)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 1 <=Int vsLen(VS)
+     andBool vsLen(VS) <=Int 1000
+     andBool 0 <=Int K
+     andBool K <=Int vsLen(VS)
+endmodule
