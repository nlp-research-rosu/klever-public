Module(
  FuncDef("maximum", Params("arr", "k"),
    Return(
      Subscript(
        Call(Name("sorted"), Name("arr")),
        Slice(
          BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
          NoBound,
          NoBound))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(4)), Int(5)),
        Int(3)),
      CmpOp(
        "==",
        ListExpr(UnaryOp("-", Int(4)), UnaryOp("-", Int(3)), Int(5)))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(Int(4), UnaryOp("-", Int(4)), Int(4)),
        Int(2)),
      CmpOp("==", ListExpr(Int(4), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(
          UnaryOp("-", Int(3)),
          Int(2),
          Int(1),
          Int(2),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          Int(1)),
        Int(1)),
      CmpOp("==", ListExpr(Int(2)))))
  Assert(
    Compare(
      Call(Name("maximum"), ListExpr(Int(7)), Int(0)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("maximum"), ListExpr(Int(7)), Int(1)),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(
          UnaryOp("-", Int(1000)),
          Int(0),
          Int(1000),
          UnaryOp("-", Int(1000)),
          Int(1000)),
        Int(4)),
      CmpOp(
        "==",
        ListExpr(UnaryOp("-", Int(1000)), Int(0), Int(1000), Int(1000))))))
