Module(
  FuncDef("maximum", Params("arr", "k"),
    Return(
      Subscript(
        Call(Name("sorted"), Name("arr")),
        Slice(
          BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
          NoBound,
          NoBound))))
  Assign(
    Name("arr"),
    ListComp(Int(0),
      CompFor(Name("i"), Call(Name("range"), Int(1000)), Bool(true))))
  Assign(Name("result"), Call(Name("maximum"), Name("arr"), Int(1000)))
  Assert(
    Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(1000))))
  Assert(
    Compare(Call(Name("len"), Name("result")), CmpOp("==", Int(1000))))
  Assert(
    Compare(Subscript(Name("result"), Int(0)), CmpOp("==", Int(0))))
  Assert(
    Compare(Subscript(Name("result"), Int(999)), CmpOp("==", Int(0)))))
