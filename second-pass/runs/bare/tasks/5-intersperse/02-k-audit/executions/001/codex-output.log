+#!/usr/bin/env bash
+set -u
+
+log="/audit-output/evidence/stage5-static-and-sensitivity.log"
+scratch="/tmp/audit-work/reconstruction"
+exec >"$log" 2>&1
+
+run() {
+  printf '\n$'
