+#!/usr/bin/env bash
+set -u
+
+log="/audit-output/evidence/stage4-pinning.log"
+scratch="/tmp/audit-work/reconstruction"
+exec >"$log" 2>&1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+run python3 /audit-output/evidence/program_pinning.py
+run kast "$scratch/solution.mpy" --definition "$scratch/semantic-fresh-kompiled" --module MPY-SYNTAX --sort Pgm --output kore --output-file /audit-output/evidence/submitted-program.kore
+run kast "$scratch/claimed-program.mpy" --definition "$scratch/semantic-fresh-kompiled" --module MPY-SYNTAX --sort Pgm --output kore --output-file /audit-output/evidence/claimed-program.kore
+run cmp -s /audit-output/evidence/submitted-program.kore /audit-output/evidence/claimed-program.kore
+run sha256sum /audit-output/evidence/submitted-program.kore /audit-output/evidence/claimed-program.kore
+run rg -n '^[[:space:]]*claim([[:space:]]|$)' "$scratch/spec.k"
+run kprove "$scratch/spec-ground.k" --definition "$scratch/verification-fresh-kompiled" --spec-module SPEC-GROUND
+run bash -c 'cd /tmp/audit-work/reconstruction && python3 -c '"'"'import canonical, solution; x=[7,8]; d=99; print("input=",x,"delimiter=",d,"spec_result=",[7,99,8],"canonical=",canonical.intersperse(list(x),d),"solution=",solution.intersperse(list(x),d))'"'"

exec
/bin/bash -lc '/audit-output/evidence/run_stage4.sh
runner_status=$?
printf '"'stage4_runner_exit=%d\\n' \""'$runner_status"
sed -n '"'1,320p' /audit-output/evidence/stage4-pinning.log" in /audit-output
