index 0000000000000000000000000000000000000000..3dda10a4e76fdac929c2728701c1998b09a66715
--- /dev/null
+++ b//tmp/audit-work/reconstruction/claimed-program.mpy
@@ -0,0 +1,14 @@
+Module(
+  ImportFrom("typing", "List")
+  FuncDef("intersperse", Params("numbers", "delimeter"),
+    If(Compare(Call(Name("len"), Name("numbers")), CmpOp("<=", Int(1))),
+      Return(Name("numbers")),
+      .Stmts)
+    Return(
+      BinOp(
+        "+",
+        ListExpr(Subscript(Name("numbers"), Int(0)), Name("delimeter")),
+        Call(
+          Name("intersperse"),
+          Subscript(Name("numbers"), Slice(Int(1), NoBound, NoBound)),
+          Name("delimeter"))))))
