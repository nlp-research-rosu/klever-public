+}
+
+run date -u
+run pwd
+run kompile --version
+run kprove --version
+run ls -ld /reference /reference/reference-semantics /candidate
+run find /reference -maxdepth 2 -printf '%y %p -> %l\n'
+run find /candidate -maxdepth 6 -printf '%y %p -> %l\n'
