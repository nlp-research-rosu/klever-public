+#!/usr/bin/env bash
+set -u
+
+log="/audit-output/evidence/final-checks.log"
+scratch="/tmp/audit-work/reconstruction"
+exec >"$log" 2>&1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+for source in solution.py solution.mpy semantic.k verification.k spec.k; do
