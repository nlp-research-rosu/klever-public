+#!/usr/bin/env bash
+set -u
+
+log="/audit-output/evidence/stage6-nonvacuity.log"
+scratch="/tmp/audit-work/reconstruction"
+exec >"$log" 2>&1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
