diff --git a//tmp/audit-work/reconstruction/pinning-spec.k b//tmp/audit-work/reconstruction/pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6816ba77fe44c8b3dbbf01222601aecfda5c800d
--- /dev/null
+++ b//tmp/audit-work/reconstruction/pinning-spec.k
@@ -0,0 +1,40 @@
+requires "pinning-verification.k"
+
+module PINNING-SPEC
+  imports PINNING-VERIFICATION
+
+  // First term uses the translator's blank spelling for the empty else Stmts.
+  // Second term uses SPEC's explicit .Stmts spelling.
+  claim <k>
+    CheckProgram(
+      Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          If(Compare(Call(Name("len"), Name("numbers")), CmpOp("<=", Int(1))),
+            Return(Name("numbers")),
+            )
+          Return(
+            BinOp(
+              "+",
+              ListExpr(Subscript(Name("numbers"), Int(0)), Name("delimeter")),
+              Call(
+                Name("intersperse"),
+                Subscript(Name("numbers"), Slice(Int(1), NoBound, NoBound)),
+                Name("delimeter")))))),
+      Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          If(Compare(Call(Name("len"), Name("numbers")), CmpOp("<=", Int(1))),
+            Return(Name("numbers")),
+            .Stmts)
+          Return(
+            BinOp(
