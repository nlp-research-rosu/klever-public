COMMAND: bash -lc set\ -o\ pipefail\;\ export\ PATH=\"/home/agent/.nix-profile/bin:\$PATH\"\;\ for\ p\ in\ fresh-empty.mpy\ fresh-singleton.mpy\ fresh-pair.mpy\ fresh-example.mpy\;\ do\ echo\ RUN:\$p\;\ krun\ \"\$p\"\ --definition\ semantic-kompiled-fresh\;\ echo\ KRUN_STATUS:\$\?\;\ done
RUN:fresh-empty.mpy
<k>
  VList ( [ .Ints ] ) ~> .K
</k>
KRUN_STATUS:0
RUN:fresh-singleton.mpy
<k>
  VList ( [ -7 , .Ints ] ) ~> .K
</k>
KRUN_STATUS:0
RUN:fresh-pair.mpy
<k>
  VList ( [ -7 , -3 , 5 , .Ints ] ) ~> .K
</k>
KRUN_STATUS:0
RUN:fresh-example.mpy
<k>
  VList ( [ 1 , 4 , 2 , 4 , 3 , .Ints ] ) ~> .K
</k>
KRUN_STATUS:0
EXIT_STATUS: 0
