     1	# canonical.py — the UNMODIFIED HumanEval/5 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: intersperse
     4	
     5	from typing import List
     6	
     7	
     8	def intersperse(numbers: List[int], delimeter: int) -> List[int]:
     9	    """ Insert a number 'delimeter' between every two consecutive elements of input list `numbers'
    10	    >>> intersperse([], 4)
    11	    []
    12	    >>> intersperse([1, 2, 3], 4)
    13	    [1, 4, 2, 4, 3]
    14	    """
    15	    if not numbers:
    16	        return []
    17	
    18	    result = []
    19	
    20	    for n in numbers[:-1]:
    21	        result.append(n)
    22	        result.append(delimeter)
    23	
    24	    result.append(numbers[-1])
    25	
    26	    return result
FILE:/candidate/solution.py
     1	from typing import List
     2	
     3	
     4	def intersperse(numbers: List[int], delimeter: int) -> List[int]:
     5	    if len(numbers) <= 1:
     6	        return numbers
     7	    return [numbers[0], delimeter] + intersperse(numbers[1:], delimeter)
