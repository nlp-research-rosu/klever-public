     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Independent recursive contract used only on the right-hand side of proof
     7	  // claims: retain every input integer and put D between adjacent elements.
     8	  syntax Ints ::= intersperseSpec(Ints, Int) [function, total]
     9	  rule intersperseSpec(.Ints, _D) => .Ints
    10	  rule intersperseSpec(I, .Ints, _D) => I, .Ints
    11	  rule intersperseSpec(I, J, REST, D)
    12	    => I, D, intersperseSpec(J, REST, D)
    13	endmodule
FILE:/candidate/spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Total functional correctness for every finite integer list and delimiter.
     7	  claim <k>
     8	    Invoke(
     9	      Module(
    10	        ImportFrom("typing", "List")
    11	        FuncDef("intersperse", Params("numbers", "delimeter"),
    12	          If(Compare(Call(Name("len"), Name("numbers")), CmpOp("<=", Int(1))),
    13	            Return(Name("numbers")),
    14	            .Stmts)
    15	          Return(
    16	            BinOp(
    17	              "+",
    18	              ListExpr(Subscript(Name("numbers"), Int(0)), Name("delimeter")),
    19	              Call(
    20	                Name("intersperse"),
    21	                Subscript(Name("numbers"), Slice(Int(1), NoBound, NoBound)),
    22	                Name("delimeter")))))),
    23	      "intersperse",
    24	      VList([IS]), VInt(D)) ~> KONT:K
    25	    => VList([intersperseSpec(IS, D)]) ~> KONT
    26	  </k>
    27	endmodule
FILE:/candidate/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	set -x
     4	
     5	# The committed constructor term must be exactly the fixed translator's output.
     6	python3 py2mpy.py solution.py | cmp - solution.mpy
     7	
     8	# Concrete execution backend and both contract boundary/example runs.
     9	kompile semantic.k --backend llvm --main-module MPY --syntax-module MPY-SYNTAX
    10	krun run-empty.mpy --definition semantic-kompiled \
    11	  | grep -F 'VList ( [ .Ints ] )'
    12	krun run-example.mpy --definition semantic-kompiled \
    13	  | grep -F 'VList ( [ 1 , 4 , 2 , 4 , 3 , .Ints ] )'
    14	
    15	# Symbolic backend and the universally quantified reachability proof.
    16	kompile verification.k --backend haskell \
    17	  --main-module VERIFICATION --syntax-module MPY-SYNTAX
    18	kprove spec.k --definition verification-kompiled
