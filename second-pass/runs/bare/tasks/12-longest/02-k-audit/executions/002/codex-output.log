/audit-output/evidence/run_logged.sh /audit-output/evidence/stage2-differential.log /audit-output/evidence/differential_test.py /reference/canonical.py /tmp/audit-work/12-longest/source/solution.py
diff_status=$?
printf '"'translation_status=%s differential_status=%s\\n' \""'$translate_status" "$diff_status"
