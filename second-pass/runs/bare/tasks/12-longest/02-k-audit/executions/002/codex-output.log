@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG_FILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_file"
+
+"$@" >>"$log_file" 2>&1
+status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$log_file"
+
+exit "$status"
diff --git a/evidence/run_positive_claims.sh b/evidence/run_positive_claims.sh
new file mode 100644
index 0000000000000000000000000000000000000000..73bdf4ae3a3ec8aa799a41737983b5b3a61e5b1e
--- /dev/null
+++ b/evidence/run_positive_claims.sh
@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -ne 3 ]]; then
+  echo "usage: $0 SPEC.k DEFINITION OUTPUT_DIR" >&2
+  exit 64
+fi
+
+spec=$1
+definition=$2
+output_dir=$3
+mkdir -p "$output_dir"
+
+claims=(
+  longest-loop
+  longest-empty
+  longest-nonempty
+  concrete-empty
+  concrete-first-tie
+  concrete-increasing
+  concrete-late-tie
+)
+
+failures=0
+for claim in "${claims[@]}"; do
+  log="$output_dir/$claim.log"
+  claim_filter="SPEC.$claim"
+  expected_top_count=1
+  # The nonempty entry theorem uses longest-loop as its circularity. Keep only
+  # that exact helper alongside the independently selected entry target.
+  if [[ "$claim" == "longest-nonempty" ]]; then
+    claim_filter="SPEC.longest-loop,SPEC.longest-nonempty"
+    expected_top_count=2
+  fi
+  command=(
+    kprove "$spec"
+    --definition "$definition"
+    --spec-module SPEC
+    --claims "$claim_filter"
+    --output pretty
+    --warnings none
+    --haskell-backend-command "kore-exec --log-level error"
+  )
+  {
+    printf 'COMMAND:'
+    printf ' %q' "${command[@]}"
+    printf '\nWORKDIR: %s\n--- OUTPUT ---\n' "$PWD"
+  } >"$log"
+  "${command[@]}" >>"$log" 2>&1
+  status=$?
+  {
+    printf '%s\n' '--- END OUTPUT ---'
+    printf 'EXIT_STATUS: %d\n' "$status"
+  } >>"$log"
+  top_count=$(grep -c '^#Top$' "$log" || true)
+  printf 'CLAIM %s EXIT_STATUS %d TOP_COUNT %d LOG %s\n' \
+    "$claim" "$status" "$top_count" "$log"
+  if [[ $status -ne 0 || $top_count -ne $expected_top_count ]]; then
+    failures=$((failures + 1))
+  fi
+done
+
+printf 'claims=%d\n' "${#claims[@]}"
+printf 'failures=%d\n' "$failures"
+exit "$failures"

exec
/bin/bash -lc 'mv /audit-output/evidence/proof/longest-nonempty.log /audit-output/evidence/proof/longest-nonempty-without-circularity-diagnostic.log
/audit-output/evidence/run_logged.sh /audit-output/evidence/stage3-positive-claims-summary.log /audit-output/evidence/run_positive_claims.sh spec.k verification-kompiled /audit-output/evidence/proof
