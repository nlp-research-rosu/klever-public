new file mode 100644
index 0000000000000000000000000000000000000000..ab0fe308d44658174ae51d1aaf331e3e0940d090
--- /dev/null
+++ b/evidence/run_positive_claims.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -ne 3 ]]; then
+  echo "usage: $0 SPEC.k DEFINITION OUTPUT_DIR" >&2
+  exit 64
+fi
+
+spec=$1
+definition=$2
+output_dir=$3
+mkdir -p "$output_dir"
+
+claims=(
+  longest-loop
+  longest-empty
+  longest-nonempty
+  concrete-empty
+  concrete-first-tie
+  concrete-increasing
+  concrete-late-tie
+)
+
+failures=0
+for claim in "${claims[@]}"; do
+  log="$output_dir/$claim.log"
+  command=(
+    kprove "$spec"
+    --definition "$definition"
+    --spec-module SPEC
+    --claims "SPEC.$claim"
+    --output pretty
+    --warnings none
+    --haskell-backend-command "kore-exec --log-level error"
+  )
+  {
+    printf 'COMMAND:'
+    printf ' %q' "${command[@]}"
+    printf '\nWORKDIR: %s\n--- OUTPUT ---\n' "$PWD"
+  } >"$log"
+  "${command[@]}" >>"$log" 2>&1
+  status=$?
+  {
+    printf '%s\n' '--- END OUTPUT ---'
+    printf 'EXIT_STATUS: %d\n' "$status"
+  } >>"$log"
+  top_count=$(grep -c '^#Top$' "$log" || true)
+  printf 'CLAIM %s EXIT_STATUS %d TOP_COUNT %d LOG %s\n' \
+    "$claim" "$status" "$top_count" "$log"
+  if [[ $status -ne 0 || $top_count -ne 1 ]]; then
+    failures=$((failures + 1))
+  fi
+done
+
+printf 'claims=%d\n' "${#claims[@]}"
+printf 'failures=%d\n' "$failures"
+exit "$failures"

codex
Several symbolic runs are slower than the candidate’s combined replay, but they remain within the normal backend path and are producing per-claim logs. I’m continuing the fresh reconstruction rather than treating elapsed time as evidence either way.
