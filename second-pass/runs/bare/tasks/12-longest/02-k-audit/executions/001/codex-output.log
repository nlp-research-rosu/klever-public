+echo '$ rule/declaration counts'
+printf 'semantic_rules='
+rg -c '^[[:space:]]*rule' semantic.k
+printf 'verification_rules='
+rg -c '^[[:space:]]*rule' verification.k
+printf 'spec_claims='
+rg -c '^[[:space:]]*claim' spec.k
