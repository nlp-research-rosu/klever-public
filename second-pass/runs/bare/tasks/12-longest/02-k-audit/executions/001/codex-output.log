+cp /audit-output/evidence/showlen-ascii.mpy showlen-ascii.mpy
+cp /audit-output/evidence/showlen-bmp.mpy showlen-bmp.mpy
+cp /audit-output/evidence/showlen-nonbmp.mpy showlen-nonbmp.mpy
