     3	
     4	def longest(strings: List[str]) -> Optional[str]:
     5	    if len(strings) == 0:
     6	        return None
     7	
     8	    result = strings[0]
     9	    for string in strings:
    10	        if len(string) > len(result):
    11	            result = string
    12	
    13	    return result
