+  syntax Expr ::= "NoneVal"
+                | "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "Name" "(" String ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
