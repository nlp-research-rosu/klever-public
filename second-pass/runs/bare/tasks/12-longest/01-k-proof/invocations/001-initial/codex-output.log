+                | "Name" "(" String ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "ListExpr" "(" Exprs ")"
+
+  syntax Stmt ::= "Module" "(" Stmts ")"
+                | "ImportFrom" "(" String "," Strings ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
