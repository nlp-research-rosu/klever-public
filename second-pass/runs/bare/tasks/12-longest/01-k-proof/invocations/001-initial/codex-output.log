index 0000000000000000000000000000000000000000..9fa3c8241cd5e73de6cc43c50886db8997c15882
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,135 @@
+module MPY-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax Expr
+  syntax Exprs   ::= List{Expr, ","}
+  syntax CmpOp   ::= "CmpOp" "(" String "," Expr ")"
+  syntax CmpOps  ::= List{CmpOp, ","}
+  syntax Strings ::= List{String, ","}
+  syntax Params  ::= "Params" "(" Strings ")"
+  syntax Stmt
+  syntax Stmts   ::= List{Stmt, ""}
+
+  syntax Expr ::= "NoneVal"
+                | "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "Name" "(" String ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "ListExpr" "(" Exprs ")"
+
+  syntax Stmt ::= "Module" "(" Stmts ")"
+                | "ImportFrom" "(" String "," Strings ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Return" "(" ")"
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports BOOL
+  imports MAP
+
+  syntax Value
+  syntax Values ::= List{Value, ","}
+  syntax Value ::= "noneVal"
+                 | "intVal" "(" Int ")"
+                 | "strVal" "(" String ")"
+                 | "boolVal" "(" Bool ")"
+                 | "listVal" "(" Values ")"
+
+  syntax Output ::= "noOutput" | Value
+  syntax Function ::= "noFunction"
+                    | "function" "(" Params "," Stmts ")"
+
+  configuration
+    <mpy>
+      <k> $PGM:Stmt </k>
+      <args> $ARGS:Value </args>
+      <env> .Map </env>
+      <function> noFunction </function>
+      <out> noOutput </out>
+    </mpy>
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "execStmt" "(" Stmt ")"
+                 | "invokeEntry"
+                 | "functionEnd"
+                 | "branch" "(" Value "," Stmts "," Stmts ")"
+                 | "forValues" "(" String "," Value "," Stmts ")"
+                 | "returning" "(" Value ")"
+
+  syntax Value ::= eval(Expr, Map)       [function]
+                 | lookup(String, Map)   [function]
+                 | pyLen(Value)          [function]
+                 | compare(String, Value, Value) [function]
+                 | head(Value)           [function]
+
+  rule <k> Module(SS) => exec(SS) ~> invokeEntry ... </k>
+
+  rule exec(.Stmts) => .
+  rule exec(S:Stmt SS:Stmts) => execStmt(S) ~> exec(SS)
+
+  rule execStmt(ImportFrom(_, _)) => .
+  rule <k> execStmt(FuncDef(_, P, BODY)) => . ... </k>
+       <function> _ => function(P, BODY) </function>
+
+  rule <k> invokeEntry => exec(BODY) ~> functionEnd ... </k>
+       <args> V </args>
+       <env> _ => X |-> V </env>
+       <function> function(Params(X:String, .Strings), BODY) </function>
+
+  rule <k> execStmt(Assign(Name(X), E)) => . ... </k>
+       <env> ENV => ENV [ X <- eval(E, ENV) ] </env>
+
+  rule <k> execStmt(If(E, THEN, ELSE))
+            => branch(eval(E, ENV), THEN, ELSE) ... </k>
+       <env> ENV </env>
+  rule branch(boolVal(true),  THEN, _) => exec(THEN)
+  rule branch(boolVal(false), _, ELSE) => exec(ELSE)
+
+  rule <k> execStmt(For(Name(X), E, BODY))
+            => forValues(X, eval(E, ENV), BODY) ... </k>
+       <env> ENV </env>
+  rule forValues(_, listVal(.Values), _) => .
+  rule <k> forValues(X, listVal(V, VS), BODY)
+            => exec(BODY) ~> forValues(X, listVal(VS), BODY) ... </k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule <k> execStmt(Return(E)) => returning(eval(E, ENV)) ... </k>
+       <env> ENV </env>
+  rule <k> execStmt(Return()) => returning(noneVal) ... </k>
+
+  rule returning(V) ~> exec(_) => returning(V)
+  rule returning(V) ~> forValues(_, _, _) => returning(V)
+  rule <k> returning(V) ~> functionEnd => . ... </k>
+       <out> _ => V </out>
+
+  rule eval(NoneVal, _) => noneVal
+  rule eval(Int(I), _) => intVal(I)
+  rule eval(Str(S), _) => strVal(S)
+  rule eval(Name(X), ENV) => lookup(X, ENV)
+  rule eval(Call(Name("len"), E), ENV) => pyLen(eval(E, ENV))
+  rule eval(Compare(L, CmpOp(OP, R)), ENV)
+       => compare(OP, eval(L, ENV), eval(R, ENV))
+  rule eval(Subscript(E, Int(0)), ENV) => head(eval(E, ENV))
+
+  rule lookup(X, (X |-> V) REST) => V
+
+  rule pyLen(strVal(S)) => intVal(lengthString(S))
+  rule pyLen(listVal(VS)) => intVal(sizeValues(VS))
+
+  syntax Int ::= sizeValues(Values) [function]
+  rule sizeValues(.Values) => 0
+  rule sizeValues(_V, VS) => 1 +Int sizeValues(VS)
+
+  rule compare("==", intVal(I), intVal(J)) => boolVal(I ==Int J)
+  rule compare(">", intVal(I), intVal(J)) => boolVal(I >Int J)
+
+  rule head(listVal(V, _)) => V
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b20dc73cae053a5083ce2d6d7395a9b99db1eb15
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+from typing import List, Optional
+
+
+def longest(strings: List[str]) -> Optional[str]:
+    if len(strings) == 0:
+        return None
+
+    result = strings[0]
+    for string in strings:
+        if len(string) > len(result):
+            result = string
+
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..479cb602c89104bf013af01d9b7b7876e6e20227
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [longest-empty]:
+      <k> longestProgram </k>
+      <args> listVal(stringValues(.Strings)) </args>
+      <env> .Map </env>
+      <function> noFunction </function>
+      <out> noOutput </out>
+  =>
+      <k> .K </k>
+      <args> listVal(stringValues(.Strings)) </args>
+      <env> ?FINALENV:Map </env>
+      <function> ?FINALFUNCTION:Function </function>
+      <out> expectedLongest(.Strings) </out>
+
+  claim [longest-nonempty]:
+      <k> longestProgram </k>
+      <args> listVal(stringValues(S:String, SS:Strings)) </args>
+      <env> .Map </env>
+      <function> noFunction </function>
+      <out> noOutput </out>
+  =>
+      <k> .K </k>
+      <args> listVal(stringValues(S, SS)) </args>
+      <env> ?FINALENV:Map </env>
+      <function> ?FINALFUNCTION:Function </function>
+      <out> expectedLongest(S, SS) </out>
+endmodule
diff --git a/test-spec.k b/test-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b8bfbeb0ee0cfc76450379bb3ab325e48399e872
--- /dev/null
+++ b/test-spec.k
@@ -0,0 +1,9 @@
+requires "verification.k"
+module TEST-SPEC
+  imports VERIFICATION
+  claim <k> longestProgram => .K </k>
+        <args> listVal(.Values) </args>
+        <env> .Map => "strings" |-> listVal(.Values) </env>
+        <function> noFunction => ?F:Function </function>
+        <out> noOutput => noneVal </out>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..57ff31adbbd7dccfe9614c3776c80aee477df211
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,52 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTICS
+
+  // These macros are an exact K rendering of solution.mpy.  Naming the
+  // repeated loop body also makes the inductive proof claim readable.
+  syntax Stmts ::= "longestLoopBody"
+  rule longestLoopBody =>
+    If(Compare(
+         Call(Name("len"), Name("string")),
+         CmpOp(">", Call(Name("len"), Name("result")))),
+       Assign(Name("result"), Name("string")),
+       .Stmts)
+
+  syntax Stmt ::= "longestProgram"
+  rule longestProgram =>
+    Module(
+      ImportFrom("typing", "List", "Optional")
+      FuncDef("longest", Params("strings"),
+        If(Compare(Call(Name("len"), Name("strings")),
+                   CmpOp("==", Int(0))),
+          Return(NoneVal),
+          .Stmts)
+        Assign(Name("result"), Subscript(Name("strings"), Int(0)))
+        For(Name("string"), Name("strings"), longestLoopBody)
+        Return(Name("result"))))
+
+  // Convert a mathematical list of K strings to the corresponding runtime
+  // list.  Restricting the input this way formalizes the List[str] precondition.
+  syntax Values ::= stringValues(Strings) [function]
+  rule stringValues(.Strings) => .Values
+  rule stringValues(S:String, SS:Strings)
+       => strVal(S), stringValues(SS)
+
+  // Independent contract model: keep the old string on equal lengths, hence
+  // this returns the first string among all maximum-length strings.
+  syntax Value ::= expectedLongest(Strings) [function]
+  syntax String ::= firstLongest(String, Strings) [function]
+
+  rule expectedLongest(.Strings) => noneVal
+  rule expectedLongest(S:String, SS:Strings)
+       => strVal(firstLongest(S, SS))
+
+  rule firstLongest(BEST, .Strings) => BEST
+  rule firstLongest(BEST, S:String, SS:Strings)
+       => firstLongest(S, SS)
+       requires lengthString(S) >Int lengthString(BEST)
+  rule firstLongest(BEST, S:String, SS:Strings)
+       => firstLongest(BEST, SS)
+       requires lengthString(S) <=Int lengthString(BEST)
+endmodule

