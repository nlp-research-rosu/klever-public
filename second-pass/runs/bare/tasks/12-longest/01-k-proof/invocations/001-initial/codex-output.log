+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports BOOL
+  imports MAP
+
+  syntax Value
+  syntax Values ::= List{Value, ","}
+  syntax Value ::= "noneVal"
+                 | "intVal" "(" Int ")"
+                 | "strVal" "(" String ")"
+                 | "boolVal" "(" Bool ")"
