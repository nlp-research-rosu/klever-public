codex
I found the failure is environmental, not artifact-related: this sandbox exposes `/proc/self/exe` but not `/proc/<getpid>/exe`, while Lean 4.22 hard-codes the latter for executable discovery. I’m applying a narrow local preload shim in `/tmp/audit-work` that redirects only that self-executable lookup; it does not alter the mounted inputs or checker logic.
apply patch
patch: completed
/tmp/audit-work/proc-exe-shim.c
diff --git a//tmp/audit-work/proc-exe-shim.c b//tmp/audit-work/proc-exe-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..34766c4742e4dfa3f3ce2cba6f779c3ae89c258c
--- /dev/null
+++ b//tmp/audit-work/proc-exe-shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    size_t length = strlen(path);
+    if (strncmp(path, "/proc/", 6) == 0
+        && strcmp(path, "/proc/self/exe") != 0
+        && length >= 4
+        && strcmp(path + length - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

