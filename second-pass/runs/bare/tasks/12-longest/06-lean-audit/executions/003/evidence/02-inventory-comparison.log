COMMAND
PYTHONPATH=/reference python - <<'PY'
import json
from pathlib import Path
from tools.k_rule_inventory import inventory_verification
inventory = inventory_verification(Path('/reference/k-proof'))
manifest = json.loads(Path('/reference/lemma-discovery.json').read_text())
canonical_ids = [r['source_rule_id'] for r in inventory['rules']]
manifest_ids = [r['source_rule_id'] for r in manifest['rules']]
print('CANONICAL_RULE_COUNT', len(canonical_ids))
print('MANIFEST_RULE_COUNT', len(manifest_ids))
print('UNIQUE_MANIFEST_RULE_COUNT', len(set(manifest_ids)))
print('ORDERED_IDENTITIES_EQUAL', canonical_ids == manifest_ids)
print('OMITTED', sorted(set(canonical_ids) - set(manifest_ids)))
print('EXTRA', sorted(set(manifest_ids) - set(canonical_ids)))
print('INVENTORY_HASH_EQUAL',
      manifest.get('inventory_sha256') == inventory['inventory_sha256'])
PY

