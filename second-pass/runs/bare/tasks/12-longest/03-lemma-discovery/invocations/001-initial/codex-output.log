/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert set(out) == {'schema_version', 'inventory_sha256', 'rules'}
assert len(out) == 3
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
assert len(out['rules']) == len(inventory['rules'])

inventory_ids = [r['source_rule_id'] for r in inventory['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == inventory_ids
assert len(out_ids) == len(set(out_ids))

by_id = {r['source_rule_id']: r for r in out['rules']}
for entry in out['rules']:
    assert set(entry) == {'source_rule_id', 'classification', 'rationale'}
    assert len(entry) == 3
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()

for source in inventory['rules']:
    if 'simplification' in source.get('attributes', []):
        assert by_id[source['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

counts = Counter(r['classification'] for r in out['rules'])
assert counts == Counter({'DEFINITION': 13, 'OPERATIONAL_RULE': 5})

text = Path('/workspace/DISCOVERY.md').read_text()
assert 'There are no "'`PROVED_DERIVED_LEMMA` entries.'"' in text
assert 'domain-lemma set is explicitly empty' in text

print('validation: passed')
print('rules:', len(out_ids))
print('classifications:', dict(counts))
print('inventory_sha256:', out['inventory_sha256'])
PY
