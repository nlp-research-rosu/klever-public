new file mode 100644
index 0000000000000000000000000000000000000000..e62c83c67f9877a48f869d3e55eeb8c8e30e5176
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def insert_sorted(word, words):
+    if len(words) == 0:
+        return [word]
+    if len(word) < len(words[0]):
+        return [word] + words
+    if len(word) == len(words[0]) and word < words[0]:
+        return [word] + words
+    return [words[0]] + insert_sorted(word, words[1:])
+
+
+def sorted_list_sum(lst):
+    if len(lst) == 0:
+        return []
+    if len(lst[0]) % 2 == 1:
+        return sorted_list_sum(lst[1:])
+    return insert_sorted(lst[0], sorted_list_sum(lst[1:]))
