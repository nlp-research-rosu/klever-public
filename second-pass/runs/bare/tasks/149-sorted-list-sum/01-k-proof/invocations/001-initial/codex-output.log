+++ b/solution.py
@@ -0,0 +1,5 @@
+def sorted_list_sum(lst):
+    return sorted(
+        [word for word in lst if len(word) % 2 == 0],
+        key=lambda word: (len(word), word),
+    )
diff --git a/spec.k b/spec.k
