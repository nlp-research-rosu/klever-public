+#!/usr/bin/env bash
+set -euo pipefail
+
+scratch=/tmp/audit-work/reconstruction
+run_file="$scratch/reviewer-unicode-single.run"
+out_file="$scratch/reviewer-unicode-single.out"
+
+python3 - <<'PY'
+import importlib.util
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.sorted_list_sum
+
+canonical = load("unicode_canonical", "/reference/canonical.py")
+candidate = load("unicode_candidate", "/tmp/audit-work/reconstruction/solution.py")
+value = ["😀"]
+print(f"PYTHON_CODEPOINT_LENGTH={len(value[0])}")
+print(f"CANONICAL_RESULT={canonical(list(value))!r}")
+print(f"CANDIDATE_RESULT={candidate(list(value))!r}")
+PY
+
+(
+  cd "$scratch"
+  python3 make_run.py 'Call(Name("sorted_list_sum"), ListExpr(Str("😀")))'
+) > "$run_file"
+krun "$run_file" --definition "$scratch/concrete-kompiled" --output pretty > "$out_file"
+sed -n '1,20p' "$out_file"
+grep -Fq 'VList ( "\xf0\x9f\x98\x80" , .Words )' "$out_file"
+printf 'EXPECTED_MISMATCH_CONFIRMED=true\n'

