diff --git a/evidence/unicode_semantics_mismatch.sh b/evidence/unicode_semantics_mismatch.sh
new file mode 100644
index 0000000000000000000000000000000000000000..6fed522d0dab17bd3991dc1717be98c74b50a18b
--- /dev/null
+++ b/evidence/unicode_semantics_mismatch.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
