     8	term = pathlib.Path("solution.mpy").read_text(encoding="utf-8").strip()
     9	
    10	# Empty constructor lists are accepted by the runtime parser (`ListExpr()` and
    11	# a blank final Stmts argument), while K definition source spells their units.
    12	term = term.replace("ListExpr()", "ListExpr(.Exprs)")
    13	term = term.replace("CellVars()", "CellVars(.Strings)")
    14	term = term.replace("FreeVars()", "FreeVars(.Strings)")
    15	term = re.sub(r",\n(?P<indent>[ ]*)\)", r",\n\g<indent>.Stmts)", term)
    16	term = "\n".join("    " + line for line in term.splitlines())
