     6	def sorted_list_sum(lst):
     7	    """Write a function that accepts a list of strings as a parameter,
     8	    deletes the strings that have odd lengths from it,
     9	    and returns the resulted list with a sorted order,
    10	    The list is always a list of strings and never an array of numbers,
    11	    and it may contain duplicates.
    12	    The order of the list should be ascending by length of each word, and you
    13	    should return the list sorted by that rule.
    14	    If two words have the same length, sort the list alphabetically.
    15	    The function should return a list of strings in sorted order.
    16	    You may assume that all words will have the same length.
    17	    For example:
    18	    assert list_sort(["aa", "a", "aaa"]) => ["aa"]
    19	    assert list_sort(["ab", "a", "aaa", "cd"]) => ["ab", "cd"]
    20	    """
    21	    lst.sort()
    22	    new_lst = []
    23	    for i in lst:
    24	        if len(i)%2 == 0:
    25	            new_lst.append(i)
    26	    return sorted(new_lst, key=len)
