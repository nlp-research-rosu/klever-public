diff --git a/evidence/spec-unicode-false-conclusion.k b/evidence/spec-unicode-false-conclusion.k
new file mode 100644
index 0000000000000000000000000000000000000000..3aadedf0276669e17e6a29813fdef029a3ed5b6c
--- /dev/null
+++ b/evidence/spec-unicode-false-conclusion.k
@@ -0,0 +1,16 @@
+requires "verification.k"
+
