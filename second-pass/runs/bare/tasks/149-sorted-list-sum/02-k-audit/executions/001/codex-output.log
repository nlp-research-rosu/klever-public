+#!/usr/bin/env bash
+set -u
+set -o pipefail
+trap 'status=$?; printf "SCRIPT_EXIT=%s\n" "$status"' EXIT
+set -x
+
+sed -n '1,220p' /candidate/run-input.json
+sed -n '1,180p' /candidate/metrics.json
+sed -n '1,180p' /candidate/codex-last.txt
+wc -l -c \
+  /candidate/codex-output.log \
