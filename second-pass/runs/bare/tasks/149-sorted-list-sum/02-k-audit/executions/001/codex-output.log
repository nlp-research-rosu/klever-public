+
+required_candidate_files=(
+  run-input.json
+  metrics.json
+  codex-last.txt
+  codex-output.log
+  prompt.py
+  py2mpy.py
+  solution.py
+  solution.mpy
+  semantic.k
+  solution-program.k
+  verification.k
+  spec.k
+)
+for artifact in "${required_candidate_files[@]}"; do
+  test -f "/candidate/$artifact"
+  test ! -L "/candidate/$artifact"
