semantic.k:1:module MPY-SYNTAX
semantic.k:2:  imports INT-SYNTAX
semantic.k:3:  imports STRING-SYNTAX
semantic.k:4:  imports BOOL-SYNTAX
semantic.k:6:  syntax #Layout ::= r"[ \n\r\t]+"
semantic.k:8:  syntax Pgm ::= "Module" "(" Stmts ")"
semantic.k:10:  syntax Stmts ::= Stmt
semantic.k:12:  syntax Exprs ::= List{Expr, ","}
semantic.k:14:  syntax Params ::= "Params" "(" String ")"
semantic.k:15:  syntax CmpPart ::= "CmpOp" "(" String "," Expr ")"
semantic.k:17:  syntax Stmt ::= "ImportFrom" "(" String "," String ")"
semantic.k:24:  syntax Expr ::= "Name" "(" String ")"
semantic.k:32:endmodule
semantic.k:34:module MPY
semantic.k:35:  imports MPY-SYNTAX
semantic.k:36:  imports INT
semantic.k:37:  imports STRING
semantic.k:38:  imports BOOL
semantic.k:39:  imports MAP
semantic.k:40:  imports LIST
semantic.k:42:  syntax PyValue ::= "pyInt" "(" Int ")"
semantic.k:48:  syntax Function ::= "function" "(" String "," Stmts ")"
semantic.k:50:  syntax KItem ::= "invoke" "(" String "," PyValue ")"
semantic.k:64:  configuration
semantic.k:73:  rule <k> Module(SS) => SS ... </k>
semantic.k:74:  rule <k> S:Stmt SS:Stmts => S ~> SS ... </k>
semantic.k:76:  rule <k> ImportFrom(_, _) => .K ... </k>
semantic.k:77:  rule <k> FuncDef(F, Params(P), BODY) => .K ... </k>
semantic.k:80:  rule <k> invoke(F, ARG) => BODY ... </k>
semantic.k:85:  rule <k> Assign(Name(X), E) => E ~> store(X) ... </k>
semantic.k:86:  rule <k> V:PyValue ~> store(X) => .K ... </k>
semantic.k:89:  rule <k> Return(E) => E ~> finishReturn ... </k>
semantic.k:90:  rule <k> V:PyValue ~> finishReturn => .K ... </k>
semantic.k:93:  rule <k> If(COND, THEN, ELSE) => COND ~> choose(THEN, ELSE) ... </k>
semantic.k:94:  rule <k> pyBool(true) ~> choose(THEN, _) => THEN ... </k>
semantic.k:95:  rule <k> pyBool(false) ~> choose(_, ELSE) => ELSE ... </k>
semantic.k:97:  rule <k> For(Name(X), ITER, BODY) => ITER ~> startFor(X, BODY) ... </k>
semantic.k:98:  rule <k> pyList(L) ~> startFor(X, BODY) => loop(X, L, BODY) ... </k>
semantic.k:99:  rule <k> loop(_, .List, _) => .K ... </k>
semantic.k:100:  rule <k> loop(X, ListItem(V:PyValue) REST, BODY)
semantic.k:102:  rule <k> bind(X, V) => .K ... </k>
semantic.k:106:  rule <k> Int(I) => pyInt(I) ... </k>
semantic.k:107:  rule <k> Str(S) => pyStr(S) ... </k>
semantic.k:108:  rule <k> Name(X) => V ... </k>
semantic.k:110:  rule <k> ListExpr(.Exprs) => pyList(.List) ... </k>
semantic.k:111:  rule <k> ListExpr(Int(I)) => pyList(ListItem(pyInt(I))) ... </k>
semantic.k:115:  syntax List ::= "splitWords" "(" String ")" [function]
semantic.k:119:  rule splitWords("o " +String S) =>
semantic.k:121:  rule splitWords("o| " +String S) =>
semantic.k:123:  rule splitWords(".| " +String S) =>
semantic.k:125:  rule splitWords(S) => ListItem(pyStr(S))
semantic.k:126:       requires findString(S, " ", 0) ==Int -1
semantic.k:127:  rule splitWords(S) =>
semantic.k:131:       requires findString(S, " ", 0) >=Int 0
semantic.k:133:  rule <k> Call(Attribute(E, "split"), ARG) =>
semantic.k:135:  rule <k> RECEIVER:PyValue ~> prepareMethod(METHOD, ARG) =>
semantic.k:137:  rule <k> pyStr(" ") ~> applyMethod("split", pyStr(S)) =>
semantic.k:141:  rule <k> Compare(E1, CmpOp(OP, E2)) =>
semantic.k:143:  rule <k> LEFT:PyValue ~> compareRight(OP, E2) =>
semantic.k:145:  rule <k> pyStr(RIGHT) ~> compareApply("==", pyStr(LEFT)) =>
semantic.k:148:  rule <k> BinOp(OP, E1, E2) => E1 ~> binRight(OP, E2) ... </k>
semantic.k:149:  rule <k> LEFT:PyValue ~> binRight(OP, E2) =>
semantic.k:151:  rule <k> pyList(RIGHT) ~> binApply("+", pyList(LEFT)) =>
semantic.k:153:endmodule
