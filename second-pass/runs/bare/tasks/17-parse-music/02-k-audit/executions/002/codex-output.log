+++ b/evidence/03_concrete_compare.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Execute the fresh LLVM semantics and compare results with both Python programs."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+SCRATCH = Path("/tmp/audit-work/reconstruction")
+
+
+def load_function(path: Path, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.parse_music
+
+
+canonical = load_function(SCRATCH / "trusted-canonical.py", "trusted_canonical_k")
+submitted = load_function(SCRATCH / "solution.py", "submitted_solution_k")
+
+inputs = [
+    "o o| .| o| o| .| .| .| .| o o",
+    "o",
+    "o|",
+    ".|",
+    "",
+    " ",
+    "o  o|",
+    " o| .| ",
+]
+
+for input_string in inputs:
+    command = [
+        "krun",
+        "solution.mpy",
+        "--definition",
+        "audit-semantic-kompiled",
+        f"-cINPUT={json.dumps(input_string)}",
+    ]
+    print(f"COMMAND: {shlex.join(command)}")
+    completed = subprocess.run(
+        command,
+        cwd=SCRATCH,
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+    combined = completed.stdout + completed.stderr
+    result_match = re.search(r"<result>\s*(.*?)\s*</result>", combined, re.S)
+    assert result_match is not None, combined
+    result_text = result_match.group(1)
+    k_result = [
+        int(value)
+        for value in re.findall(r"pyInt\s*\(\s*(-?\d+)\s*\)", result_text)
+    ]
+    submitted_result = submitted(input_string)
+    canonical_result = canonical(input_string)
+    print(
+        f"input={input_string!r} exit={completed.returncode} "
+        f"K={k_result!r} submitted_python={submitted_result!r} "
+        f"canonical_python={canonical_result!r}"
+    )
+    assert completed.returncode == 0
+    assert k_result == submitted_result
+
+print("K_VS_SUBMITTED_PYTHON=PASS")
diff --git a/evidence/03_run_each_claim.sh b/evidence/03_run_each_claim.sh
new file mode 100644
index 0000000000000000000000000000000000000000..cb515d7d1ddce39dd2d497cc4e4d23dc5ad66556
--- /dev/null
+++ b/evidence/03_run_each_claim.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/reconstruction
+
+labels=(
+  entry-o
+  entry-example
+  entry-half
+  entry-quarter
+  loop-o
+  loop-half
+  loop-quarter
+  loop-base
+  bridge-o
+  bridge-half
+  bridge-quarter
+)
+
+overall_rc=0
+for label in "${labels[@]}"; do
+  full_label="SPEC-LABELED.label(${label})"
+  echo "COMMAND: kprove spec-labeled.k --definition audit-verification-kompiled --spec-module SPEC-LABELED --claims '$full_label'"
+  output="$(
+    kprove spec-labeled.k \
+      --definition audit-verification-kompiled \
+      --spec-module SPEC-LABELED \
+      --claims "$full_label" 2>&1
+  )"
+  claim_rc=$?
+  printf '%s\n' "$output"
+  echo "CLAIM=$label EXIT_STATUS=$claim_rc"
+  if [[ "$claim_rc" -ne 0 || "$output" != *"#Top"* ]]; then
+    overall_rc=1
+  fi
+done
+
+echo "ALL_INDIVIDUAL_CLAIMS_EXIT_STATUS=$overall_rc"
+exit "$overall_rc"

diff --git a//tmp/audit-work/reconstruction/program-identity-spec.k b//tmp/audit-work/reconstruction/program-identity-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..68da15360b5064d654811522c666c196099ec727
--- /dev/null
+++ b//tmp/audit-work/reconstruction/program-identity-spec.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module PROGRAM-IDENTITY-SPEC
+  imports MPY-VERIFICATION
+
+  // The right-hand term is copied from the trusted translator's regenerated
+  // solution.mpy. This claim checks the proof-side program macro against it.
+  claim
+    <mpy>
+      <k>
+        theProgram
+        =>
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef("parse_music", Params("music_string"),
+            Assign(Name("beats"), ListExpr())
+            For(Name("note"),
+                Call(Attribute(Name("music_string"), "split"), Str(" ")),
+              If(Compare(Name("note"), CmpOp("==", Str("o"))),
+                Assign(
+                  Name("beats"),
+                  BinOp("+", Name("beats"), ListExpr(Int(4)))),
+                If(Compare(Name("note"), CmpOp("==", Str("o|"))),
+                  Assign(
+                    Name("beats"),
+                    BinOp("+", Name("beats"), ListExpr(Int(2)))),
+                  Assign(
+                    Name("beats"),
+                    BinOp("+", Name("beats"), ListExpr(Int(1)))))))
+            Return(Name("beats"))))
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+endmodule
