  echo \"COMMAND: kprove spec-vacuity.k --definition audit-verification-kompiled --spec-module SPEC-VACUITY --claims 'SPEC-VACUITY.label(entry-o)' --dry-run\"
  kprove spec-vacuity.k --definition audit-verification-kompiled --spec-module SPEC-VACUITY --claims 'SPEC-VACUITY.label(entry-o)' --dry-run
  dry_rc="'$?
  echo "EXIT_STATUS=$dry_rc"
