from pathlib import Path
from hashlib import sha256
import os,stat,itertools
roots=[Path('/candidate'),Path('/generation-evidence/codex-trace')]
targets=['127fb6fd9caa8e442fc3ee4457762ada48c4a31786b04f5f938826e57e507730','10963cc47d19b9395cd8d362e83c73ae27453c51c1ab415037afb1f1796c9010']
# Test pipeline-like with root item and path prefix choices.
for prefixkind in ['none','dot','rootname','absolute','slashrel']:
 for rootitem in [False,True]:
  for length_endian in ['big','little']:
   for pathlen in [0,4,8]:
    for sizelen in [0,4,8]:
     for modefmt in ['none','oct','bin4','bin8']:
      outs=[]
      for root in roots:
       entries=[]
       if rootitem: entries.append((root,'directory'))
       entries += [(p,'directory' if p.is_dir() else 'file') for p in root.rglob('*')]
       def relf(p):
        rel='.' if p==root else p.relative_to(root).as_posix()
        if prefixkind=='rootname': return root.name+('/'+rel if rel"'!='"'.' else '')
        if prefixkind=='absolute': return str(p)
        if prefixkind=='slashrel': return '/'+rel
        return rel
       entries=sorted(entries,key=lambda pk:relf(pk[0]))
       d=sha256()
       for p,k in entries:
        rel=relf(p); e=rel.encode()
        if pathlen:d.update(len(e).to_bytes(pathlen,length_endian))
        d.update(e); d.update(k.encode()+b'\\0')
        if modefmt"'!='"'none':
         mode=p.stat(follow_symlinks=False).st_mode
         if modefmt=='oct':d.update(oct(mode).encode()+b'\\0')
         elif modefmt=='bin4':d.update(mode.to_bytes(4,length_endian))
         else:d.update(mode.to_bytes(8,length_endian))
        if k=='file':
         b=p.read_bytes()
         if sizelen:d.update(len(b).to_bytes(sizelen,length_endian))
         d.update(b)
       outs.append(d.hexdigest())
      if outs==targets: print('MATCH',prefixkind,rootitem,length_endian,pathlen,sizelen,modefmt)
