     1	Module(
     2	  ImportFrom("typing", "List")
     3	  FuncDef("parse_music", Params("music_string"),
     4	    Assign(Name("beats"), ListExpr())
     5	    For(Name("note"), Call(Attribute(Name("music_string"), "split"), Str(" ")),
     6	      If(Compare(Name("note"), CmpOp("==", Str("o"))),
     7	        Assign(
     8	          Name("beats"),
     9	          BinOp("+", Name("beats"), ListExpr(Int(4)))),
    10	        If(Compare(Name("note"), CmpOp("==", Str("o|"))),
    11	          Assign(
    12	            Name("beats"),
    13	            BinOp("+", Name("beats"), ListExpr(Int(2)))),
    14	          Assign(
    15	            Name("beats"),
    16	            BinOp("+", Name("beats"), ListExpr(Int(1)))))))
    17	    Return(Name("beats"))))
