     1	# canonical.py — the UNMODIFIED HumanEval/17 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: parse_music
     4	
     5	from typing import List
     6	
     7	
     8	def parse_music(music_string: str) -> List[int]:
     9	    """ Input to this function is a string representing musical notes in a special ASCII format.
    10	    Your task is to parse this string and return list of integers corresponding to how many beats does each
    11	    not last.
    12	
    13	    Here is a legend:
    14	    'o' - whole note, lasts four beats
    15	    'o|' - half note, lasts two beats
    16	    '.|' - quater note, lasts one beat
    17	
    18	    >>> parse_music('o o| .| o| o| .| .| .| .| o o')
    19	    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]
    20	    """
    21	    note_map = {'o': 4, 'o|': 2, '.|': 1}
    22	    return [note_map[x] for x in music_string.split(' ') if x]
===== /candidate/solution.py =====
     1	from typing import List
     2	
     3	
     4	def parse_music(music_string: str) -> List[int]:
     5	    beats = []
     6	    for note in music_string.split(" "):
     7	        if note == "o":
     8	            beats = beats + [4]
     9	        elif note == "o|":
    10	            beats = beats + [2]
    11	        else:
    12	            beats = beats + [1]
    13	    return beats
