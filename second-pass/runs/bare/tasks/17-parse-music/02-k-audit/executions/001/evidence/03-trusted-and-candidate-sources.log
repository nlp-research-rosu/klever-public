   113	  // Python's explicit-separator str.split(" "). This preserves empty fields,
   114	  // exactly as CPython does for an explicit separator.
   115	  syntax List ::= "splitWords" "(" String ")" [function]
   116	  // Constructor-prefix equations make the behavior on each legal token
   117	  // symbolic as well as concrete. They are instances of the general rules
   118	  // below because the first separator is at the displayed position.
   119	  rule splitWords("o " +String S) =>
   120	       ListItem(pyStr("o")) splitWords(S) [simplification]
   121	  rule splitWords("o| " +String S) =>
   122	       ListItem(pyStr("o|")) splitWords(S) [simplification]
   123	  rule splitWords(".| " +String S) =>
   124	       ListItem(pyStr(".|")) splitWords(S) [simplification]
   125	  rule splitWords(S) => ListItem(pyStr(S))
   126	       requires findString(S, " ", 0) ==Int -1
   127	  rule splitWords(S) =>
   128	       ListItem(pyStr(substrString(S, 0, findString(S, " ", 0))))
   129	       splitWords(substrString(S, findString(S, " ", 0) +Int 1,
   130	                               lengthString(S)))
   131	       requires findString(S, " ", 0) >=Int 0
   132	
   133	  rule <k> Call(Attribute(E, "split"), ARG) =>
   134	             E ~> prepareMethod("split", ARG) ... </k>
   135	  rule <k> RECEIVER:PyValue ~> prepareMethod(METHOD, ARG) =>
   136	             ARG ~> applyMethod(METHOD, RECEIVER) ... </k>
   137	  rule <k> pyStr(" ") ~> applyMethod("split", pyStr(S)) =>
   138	             pyList(splitWords(S)) ... </k>
   139	
   140	  // Equality and list concatenation.
   141	  rule <k> Compare(E1, CmpOp(OP, E2)) =>
   142	             E1 ~> compareRight(OP, E2) ... </k>
   143	  rule <k> LEFT:PyValue ~> compareRight(OP, E2) =>
   144	             E2 ~> compareApply(OP, LEFT) ... </k>
   145	  rule <k> pyStr(RIGHT) ~> compareApply("==", pyStr(LEFT)) =>
   146	             pyBool(LEFT ==String RIGHT) ... </k>
   147	
   148	  rule <k> BinOp(OP, E1, E2) => E1 ~> binRight(OP, E2) ... </k>
   149	  rule <k> LEFT:PyValue ~> binRight(OP, E2) =>
   150	             E2 ~> binApply(OP, LEFT) ... </k>
   151	  rule <k> pyList(RIGHT) ~> binApply("+", pyList(LEFT)) =>
   152	             pyList(LEFT RIGHT) ... </k>
   153	endmodule
