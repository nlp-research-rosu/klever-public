from pathlib import Path
import hashlib,itertools,struct
cases=[(Path('/candidate'),'bca81e0754a747091c3e356af4c17559873104169b55b5148854d8269e469595'),(Path('/generation-evidence/codex-trace'),'4ea3afad402973fc4dc999b56b59f110ce3aa55c647c523a7633a31709028507')]

def entries(root,dirs):
 return sorted([p for p in root.rglob('*') if (p.is_file() or (dirs and p.is_dir()))],key=lambda p:p.relative_to(root).as_posix())
pathprefixes=['','./']
seps=[b'',b'\\0',b'\\n',b' ',b':',b'  ']
kindopts=[None,('file','directory'),('f','d'),('F','D'),('blob','tree')]
sizeopts=['none','ascii','8be','4be']
dataopts=['raw','hexdigest','digest']
lenopts=['none','4be','8be','ascii_colon']
for dirs in (False,True):
 for pp,sep1,sep2,sep3,kindopt,sizeopt,dataopt,lenopt in itertools.product(pathprefixes,seps,seps,seps,kindopts,sizeopts,dataopts,lenopts):
  oks=[]
  for root,target in cases:
   h=hashlib.sha256()
   for p in entries(root,dirs):
    r=(pp+p.relative_to(root).as_posix()).encode()
    if lenopt=='4be':h.update(len(r).to_bytes(4,'big'))
    elif lenopt=='8be':h.update(len(r).to_bytes(8,'big'))
    elif lenopt=='ascii_colon':h.update(str(len(r)).encode()+b':')
    h.update(r);h.update(sep1)
    isf=p.is_file()
    if kindopt: h.update((kindopt[0] if isf else kindopt[1]).encode());h.update(sep2)
    if isf:
     b=p.read_bytes()
     if sizeopt=='ascii':h.update(str(len(b)).encode());h.update(sep3)
     elif sizeopt=='8be':h.update(len(b).to_bytes(8,'big'))
     elif sizeopt=='4be':h.update(len(b).to_bytes(4,'big'))
     if dataopt=='raw': h.update(b)
     elif dataopt=='hexdigest': h.update(hashlib.sha256(b).hexdigest().encode())
     else:h.update(hashlib.sha256(b).digest())
    h.update(sep3)
   oks.append(h.hexdigest()==target)
  if all(oks):
   print('MATCH',dirs,pp,sep1,sep2,sep3,kindopt,sizeopt,dataopt,lenopt);raise SystemExit
print('none')
PY" in /audit-output
