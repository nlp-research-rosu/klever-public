diff --git a/evidence/stage3-claim-3-example-12-1.k b/evidence/stage3-claim-3-example-12-1.k
new file mode 100644
index 0000000000000000000000000000000000000000..12cd0b84a72d2c30ea0d2e567422fa3190dec180
--- /dev/null
+++ b/evidence/stage3-claim-3-example-12-1.k
@@ -0,0 +1,12 @@
