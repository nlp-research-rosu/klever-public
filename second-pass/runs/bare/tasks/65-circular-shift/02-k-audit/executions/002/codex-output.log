+  printf '\n'
+} | tee "$log_path"
+
+"$@" 2>&1 | tee -a "$log_path"
+status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %s\n' "$status" | tee -a "$log_path"
+exit "$status"
