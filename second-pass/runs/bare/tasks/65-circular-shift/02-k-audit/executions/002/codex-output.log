index 0000000000000000000000000000000000000000..c2f127cedd8f103348ce305856d06365a1d5d0b4
--- /dev/null
+++ b/evidence/stage3-claim-6-oversized-1234-5.k
@@ -0,0 +1,12 @@
+requires "verification.k"
+
+module AUDIT-CLAIM-6-OVERSIZED-1234-5
+  imports VERIFICATION
+
+  claim <mpy>
+          <k> solutionProgram => .K </k>
+          <entry> "circular_shift" </entry>
+          <args> (VInt(1234), VInt(5)) </args>
+          <result> VNone => VString("4321") </result>
+        </mpy>
+endmodule
