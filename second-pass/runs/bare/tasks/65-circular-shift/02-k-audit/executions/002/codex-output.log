    23	            BinOp("-", Call(Name("len"), Name("s")), Name("shift")),
    24	            NoBound))))))
     1	module MPY-SYNTAX
     2	  imports DOMAINS
     3	
     4	  syntax Program ::= "Module" "(" Stmts ")" [symbol(Module)]
     5	  syntax Stmts   ::= List{Stmt, ""}
     6	
     7	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
     8	                | "Assign" "(" Expr "," Expr ")"                 [symbol(Assign)]
     9	                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(If)]
    10	                | "Return" "(" Expr ")"                         [symbol(Return)]
    11	
    12	  syntax Params     ::= "Params" "(" ParamNames ")" [symbol(Params)]
    13	  syntax ParamNames ::= List{String, ","}
    14	
    15	  syntax Expr ::= "Name" "(" String ")"                         [symbol(Name)]
    16	                | "Int" "(" Int ")"                             [symbol(Int)]
    17	                | "BinOp" "(" String "," Expr "," Expr ")"    [symbol(BinOp)]
    18	                | "UnaryOp" "(" String "," Expr ")"            [symbol(UnaryOp)]
    19	                | "Compare" "(" Expr "," CmpOp ")"             [symbol(Compare)]
    20	                | "Call" "(" Expr "," Exprs ")"                [symbol(Call)]
    21	                | "Subscript" "(" Expr "," Slice ")"           [symbol(Subscript)]
    22	
    23	  syntax Exprs ::= List{Expr, ","}
    24	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
    25	  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol(Slice)]
    26	  syntax Bound ::= Expr | "NoBound"
    27	endmodule
    28	
    29	module MPY
    30	  imports MPY-SYNTAX
    31	
    32	  syntax Val ::= "VInt" "(" Int ")"
    33	               | "VString" "(" String ")"
    34	               | "VBool" "(" Bool ")"
    35	               | "VNone"
    36	  syntax Vals ::= List{Val, ","}
    37	
    38	  configuration
    39	    <mpy>
    40	      <k> $PGM:Program </k>
    41	      <entry> $ENTRY:String </entry>
    42	      <args> $ARGS:Vals </args>
    43	      <result> VNone </result>
    44	    </mpy>
    45	
    46	  rule <k> P:Program => .K </k>
    47	       <entry> F:String </entry>
    48	       <args> A:Vals </args>
    49	       <result> _ => runProgram(P, F, A) </result>
    50	
    51	  // Top-level definition lookup and positional parameter binding.
    52	  syntax Val ::= runProgram(Program, String, Vals) [function]
    53	  rule runProgram(Module(FuncDef(F, PS, BODY) _REST), F, ARGS)
    54	    => resultOf(exec(BODY, bind(PS, ARGS)))
    55	  rule runProgram(Module(FuncDef(F0, _, _) REST), F, ARGS)
    56	    => runProgram(Module(REST), F, ARGS)
    57	    requires F0 =/=String F
    58	
    59	  syntax Map ::= bind(Params, Vals) [function]
    60	  rule bind(Params(.ParamNames), .Vals) => .Map
    61	  rule bind(Params((N:String, NS:ParamNames)), (V:Val, VS:Vals))
    62	    => (N |-> V) bind(Params(NS), VS)
    63	
    64	  // Statement execution returns early exactly when a Return is encountered.
    65	  syntax ExecResult ::= returned(Val) | normal(Map)
    66	  syntax ExecResult ::= exec(Stmts, Map) [function]
    67	  syntax ExecResult ::= branch(Val, Stmts, Stmts, Stmts, Map) [function]
    68	  syntax ExecResult ::= continue(ExecResult, Stmts) [function]
    69	  syntax Val ::= resultOf(ExecResult) [function]
    70	
    71	  rule exec(.Stmts, ENV) => normal(ENV)
    72	  rule exec(Assign(Name(N), E) REST, ENV)
    73	    => exec(REST, ENV [ N <- eval(E, ENV) ])
    74	  rule exec(If(COND, THEN, ELSE) REST, ENV)
    75	    => branch(eval(COND, ENV), THEN, ELSE, REST, ENV)
    76	  rule exec(Return(E) _REST, ENV) => returned(eval(E, ENV))
    77	
    78	  rule branch(VBool(B), THEN, _, REST, ENV)
    79	    => continue(exec(THEN, ENV), REST)
    80	    requires B
    81	  rule branch(VBool(B), _, ELSE, REST, ENV)
    82	    => continue(exec(ELSE, ENV), REST)
    83	    requires notBool B
    84	  rule continue(returned(V), _) => returned(V)
    85	  rule continue(normal(ENV), REST) => exec(REST, ENV)
    86	  rule resultOf(returned(V)) => V
    87	  rule resultOf(normal(_)) => VNone
    88	
    89	  // Expression semantics needed by solution.mpy.
    90	  syntax Val ::= eval(Expr, Map) [function]
    91	               | lookupVal(Map, String) [function]
    92	               | pyStr(Val) [function]
    93	               | pyLen(Val) [function]
    94	               | unary(String, Val) [function]
    95	               | binary(String, Val, Val) [function]
    96	               | compare(String, Val, Val) [function]
    97	               | sliceFrom(Val, Val) [function]
    98	               | sliceTo(Val, Val) [function]
    99	               | reverseValue(Val) [function]
   100	
   101	  rule eval(Name(N), ENV) => lookupVal(ENV, N)
   102	  rule lookupVal((N |-> V) _REST, N) => V
   103	  rule eval(Int(I), _) => VInt(I)
   104	  rule eval(UnaryOp(OP, E), ENV) => unary(OP, eval(E, ENV))
   105	  rule eval(BinOp(OP, L, R), ENV) => binary(OP, eval(L, ENV), eval(R, ENV))
   106	  rule eval(Compare(L, CmpOp(OP, R)), ENV)
   107	    => compare(OP, eval(L, ENV), eval(R, ENV))
   108	  rule eval(Call(Name("str"), E), ENV) => pyStr(eval(E, ENV))
   109	  rule eval(Call(Name("len"), E), ENV) => pyLen(eval(E, ENV))
   110	  rule eval(Subscript(E, Slice(NoBound, NoBound, UnaryOp("-", Int(1)))), ENV)
   111	    => reverseValue(eval(E, ENV))
   112	  rule eval(Subscript(E, Slice(LOWER:Expr, NoBound, NoBound)), ENV)
   113	    => sliceFrom(eval(E, ENV), eval(LOWER, ENV))
   114	  rule eval(Subscript(E, Slice(NoBound, UPPER:Expr, NoBound)), ENV)
   115	    => sliceTo(eval(E, ENV), eval(UPPER, ENV))
   116	
   117	  rule pyStr(VInt(I)) => VString(Int2String(I))
   118	  rule pyLen(VString(S)) => VInt(lengthString(S))
   119	  rule unary("-", VInt(I)) => VInt(0 -Int I)
   120	  rule binary("-", VInt(I), VInt(J)) => VInt(I -Int J)
   121	  rule binary("+", VString(S), VString(T)) => VString(S +String T)
   122	  rule compare(">", VInt(I), VInt(J)) => VBool(I >Int J)
   123	
   124	  // Python clamps ordinary slice endpoints into [0, length].
   125	  syntax Int ::= clipIndex(Int, Int) [function, total]
   126	  rule clipIndex(I, L) => 0 requires I <Int (0 -Int L)
   127	  rule clipIndex(I, L) => I +Int L
   128	    requires (0 -Int L) <=Int I andBool I <Int 0
   129	  rule clipIndex(I, L) => I requires 0 <=Int I andBool I <=Int L
   130	  rule clipIndex(I, L) => L requires L <Int I
   131	
   132	  rule sliceFrom(VString(S), VInt(I))
