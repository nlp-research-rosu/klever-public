index 0000000000000000000000000000000000000000..7ba4196b60a8d30d8e83c448e695696f1faa5277
--- /dev/null
+++ b/evidence/stage5-clip-overlap.k
@@ -0,0 +1,10 @@
+requires "verification.k"
+
+module AUDIT-CLIP-OVERLAP
+  imports VERIFICATION
+
+  // Outside every actual program call (whose L is a string length), L = -1
+  // makes the first and fourth clipIndex guards overlap with different RHSs.
+  claim clipIndex(0, 0 -Int 1) => 0
+  claim clipIndex(0, 0 -Int 1) => (0 -Int 1)
+endmodule
