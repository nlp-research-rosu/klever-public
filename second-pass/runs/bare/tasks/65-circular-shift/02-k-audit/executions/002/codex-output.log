+          <entry> "" </entry>
+          <args> .Vals </args>
+          <result> VInt(clipIndex(0, 0 -Int 1)) => VInt(0) </result>
+        </mpy>
+  claim <mpy>
+          <k> .K </k>
+          <entry> "" </entry>
+          <args> .Vals </args>
+          <result>
+            VInt(clipIndex(0, 0 -Int 1)) => VInt(0 -Int 1)
+          </result>
+        </mpy>
+endmodule
