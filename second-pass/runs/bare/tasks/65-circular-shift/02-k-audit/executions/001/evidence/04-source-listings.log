     6	def circular_shift(x, shift):
     7	    """Circular shift the digits of the integer x, shift the digits right by shift
     8	    and return the result as a string.
     9	    If shift > number of digits, return digits reversed.
    10	    >>> circular_shift(12, 1)
    11	    "21"
    12	    >>> circular_shift(12, 2)
    13	    "12"
    14	    """
    15	    s = str(x)
    16	    if shift > len(s):
    17	        return s[::-1]
    18	    else:
    19	        return s[len(s) - shift:] + s[:len(s) - shift]
