@@ -0,0 +1,6 @@
+def circular_shift(x, shift):
+    s = str(x)
+    if shift > len(s):
+        return s[::-1]
+    # Deliberately preserve the two slices in their original order.
+    return s[:len(s) - shift] + s[len(s) - shift:]
