@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  "$@"
+  audit_rc=$?
+  printf 'EXIT_STATUS: %d\n' "$audit_rc"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  exit "$audit_rc"
+} 2>&1 | tee "$audit_log"
+
+exit "${PIPESTATUS[0]}"
diff --git a/evidence/solution-body-mutant.py b/evidence/solution-body-mutant.py
new file mode 100644
index 0000000000000000000000000000000000000000..ba679ea6f7af9d2d44500a8ced53a5ef3cf49f95
--- /dev/null
+++ b/evidence/solution-body-mutant.py
@@ -0,0 +1,6 @@
+def circular_shift(x, shift):
+    s = str(x)
+    if shift > len(s):
+        return s[::-1]
+    # Deliberately preserve the two slices in their original order.
+    return s[:len(s) - shift] + s[len(s) - shift:]
