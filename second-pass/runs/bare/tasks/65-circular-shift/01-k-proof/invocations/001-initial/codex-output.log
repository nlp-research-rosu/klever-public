+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // All nonnegative inputs in the ordinary rotation branch.
+  claim runSolution(VInt(X), VInt(SHIFT))
+      => VString(normalCircularShift(Int2String(X), SHIFT))
+    requires 0 <=Int X
+     andBool 0 <=Int SHIFT
+     andBool SHIFT <=Int lengthString(Int2String(X))
+
+  // All nonnegative inputs in the contract's oversized-shift branch.
+  claim runSolution(VInt(X), VInt(SHIFT))
+      => VString(reverseString(Int2String(X)))
+    requires 0 <=Int X
+     andBool lengthString(Int2String(X)) <Int SHIFT
+
+  // The two examples are retained as concrete regression proofs.
+  claim runSolution(VInt(12), VInt(1)) => VString("21")
+  claim runSolution(VInt(12), VInt(2)) => VString("12")
+endmodule
