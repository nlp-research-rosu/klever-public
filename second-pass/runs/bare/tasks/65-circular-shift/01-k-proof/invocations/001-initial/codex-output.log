+  --module VERIFICATION --sort Program \
+  --expression 'solutionProgram' --expand-macros)"
+if [[ "$actual_ast" != "$proof_ast" ]]; then
+  echo "proof/program constructor trees differ" >&2
+  exit 1
+fi
+
+run_case() {
+  local x="$1"
+  local shift="$2"
+  local expected="$3"
+  local output
+  output="$(krun solution.mpy \
+    --definition verification-kompiled \
+    -cENTRY='"circular_shift"' \
+    -cARGS="VInt($x), VInt($shift)")"
+  printf '%s\n' "$output"
+  grep -Fq "VString ( \"$expected\" )" <<<"$output"
+}
+
+# krun exercises equality, ordinary rotation, and oversized reversal paths.
+run_case 12 1 21
+run_case 12 2 12
+run_case 1234 2 3412
+run_case 1234 5 4321
+
+# This is the required positive target proof. It proves every claim in spec.k
+# and must print #Top and exit zero.
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..7ac246bbbadfd13180f169890ef063e77e25ec77
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,145 @@
+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Program ::= "Module" "(" Stmts ")" [symbol(Module)]
+  syntax Stmts   ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                | "Assign" "(" Expr "," Expr ")"                 [symbol(Assign)]
+                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(If)]
+                | "Return" "(" Expr ")"                         [symbol(Return)]
+
+  syntax Params     ::= "Params" "(" ParamNames ")" [symbol(Params)]
+  syntax ParamNames ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"                         [symbol(Name)]
+                | "Int" "(" Int ")"                             [symbol(Int)]
+                | "BinOp" "(" String "," Expr "," Expr ")"    [symbol(BinOp)]
+                | "UnaryOp" "(" String "," Expr ")"            [symbol(UnaryOp)]
+                | "Compare" "(" Expr "," CmpOp ")"             [symbol(Compare)]
+                | "Call" "(" Expr "," Exprs ")"                [symbol(Call)]
+                | "Subscript" "(" Expr "," Slice ")"           [symbol(Subscript)]
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol(Slice)]
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+
+  syntax Val ::= "VInt" "(" Int ")"
+               | "VString" "(" String ")"
+               | "VBool" "(" Bool ")"
+               | "VNone"
+  syntax Vals ::= List{Val, ","}
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <entry> $ENTRY:String </entry>
+      <args> $ARGS:Vals </args>
+      <result> VNone </result>
+    </mpy>
+
+  rule <k> P:Program => .K </k>
+       <entry> F:String </entry>
+       <args> A:Vals </args>
+       <result> _ => runProgram(P, F, A) </result>
+
+  // Top-level definition lookup and positional parameter binding.
+  syntax Val ::= runProgram(Program, String, Vals) [function]
+  rule runProgram(Module(FuncDef(F, PS, BODY) _REST), F, ARGS)
+    => resultOf(exec(BODY, bind(PS, ARGS)))
+  rule runProgram(Module(FuncDef(F0, _, _) REST), F, ARGS)
+    => runProgram(Module(REST), F, ARGS)
+    requires F0 =/=String F
+
+  syntax Map ::= bind(Params, Vals) [function]
+  rule bind(Params(.ParamNames), .Vals) => .Map
+  rule bind(Params((N:String, NS:ParamNames)), (V:Val, VS:Vals))
+    => (N |-> V) bind(Params(NS), VS)
+
+  // Statement execution returns early exactly when a Return is encountered.
+  syntax ExecResult ::= returned(Val) | normal(Map)
+  syntax ExecResult ::= exec(Stmts, Map) [function]
+  syntax ExecResult ::= branch(Val, Stmts, Stmts, Stmts, Map) [function]
+  syntax ExecResult ::= continue(ExecResult, Stmts) [function]
+  syntax Val ::= resultOf(ExecResult) [function]
+
+  rule exec(.Stmts, ENV) => normal(ENV)
+  rule exec(Assign(Name(N), E) REST, ENV)
+    => exec(REST, ENV [ N <- eval(E, ENV) ])
+  rule exec(If(COND, THEN, ELSE) REST, ENV)
+    => branch(eval(COND, ENV), THEN, ELSE, REST, ENV)
+  rule exec(Return(E) _REST, ENV) => returned(eval(E, ENV))
+
+  rule branch(VBool(B), THEN, _, REST, ENV)
+    => continue(exec(THEN, ENV), REST)
+    requires B
+  rule branch(VBool(B), _, ELSE, REST, ENV)
+    => continue(exec(ELSE, ENV), REST)
+    requires notBool B
+  rule continue(returned(V), _) => returned(V)
+  rule continue(normal(ENV), REST) => exec(REST, ENV)
+  rule resultOf(returned(V)) => V
+  rule resultOf(normal(_)) => VNone
+
+  // Expression semantics needed by solution.mpy.
+  syntax Val ::= eval(Expr, Map) [function]
+               | lookupVal(Map, String) [function]
+               | pyStr(Val) [function]
+               | pyLen(Val) [function]
+               | unary(String, Val) [function]
+               | binary(String, Val, Val) [function]
+               | compare(String, Val, Val) [function]
+               | sliceFrom(Val, Val) [function]
+               | sliceTo(Val, Val) [function]
+               | reverseValue(Val) [function]
+
+  rule eval(Name(N), ENV) => lookupVal(ENV, N)
+  rule lookupVal((N |-> V) _REST, N) => V
+  rule eval(Int(I), _) => VInt(I)
+  rule eval(UnaryOp(OP, E), ENV) => unary(OP, eval(E, ENV))
+  rule eval(BinOp(OP, L, R), ENV) => binary(OP, eval(L, ENV), eval(R, ENV))
+  rule eval(Compare(L, CmpOp(OP, R)), ENV)
+    => compare(OP, eval(L, ENV), eval(R, ENV))
+  rule eval(Call(Name("str"), E), ENV) => pyStr(eval(E, ENV))
+  rule eval(Call(Name("len"), E), ENV) => pyLen(eval(E, ENV))
+  rule eval(Subscript(E, Slice(NoBound, NoBound, UnaryOp("-", Int(1)))), ENV)
+    => reverseValue(eval(E, ENV))
+  rule eval(Subscript(E, Slice(LOWER:Expr, NoBound, NoBound)), ENV)
+    => sliceFrom(eval(E, ENV), eval(LOWER, ENV))
+  rule eval(Subscript(E, Slice(NoBound, UPPER:Expr, NoBound)), ENV)
+    => sliceTo(eval(E, ENV), eval(UPPER, ENV))
+
+  rule pyStr(VInt(I)) => VString(Int2String(I))
+  rule pyLen(VString(S)) => VInt(lengthString(S))
+  rule unary("-", VInt(I)) => VInt(0 -Int I)
+  rule binary("-", VInt(I), VInt(J)) => VInt(I -Int J)
+  rule binary("+", VString(S), VString(T)) => VString(S +String T)
+  rule compare(">", VInt(I), VInt(J)) => VBool(I >Int J)
+
+  // Python clamps ordinary slice endpoints into [0, length].
+  syntax Int ::= clipIndex(Int, Int) [function, total]
+  rule clipIndex(I, L) => 0 requires I <Int (0 -Int L)
+  rule clipIndex(I, L) => I +Int L
+    requires (0 -Int L) <=Int I andBool I <Int 0
+  rule clipIndex(I, L) => I requires 0 <=Int I andBool I <=Int L
+  rule clipIndex(I, L) => L requires L <Int I
+
+  rule sliceFrom(VString(S), VInt(I))
+    => VString(substrString(S, clipIndex(I, lengthString(S)), lengthString(S)))
+  rule sliceTo(VString(S), VInt(I))
+    => VString(substrString(S, 0, clipIndex(I, lengthString(S))))
+
+  syntax String ::= reverseString(String) [function]
+                  | reverseFrom(String, Int) [function]
+  rule reverseValue(VString(S)) => VString(reverseString(S))
+  rule reverseString(S) => reverseFrom(S, lengthString(S) -Int 1)
+  rule reverseFrom(_, I) => "" requires I <Int 0
+  rule reverseFrom(S, I)
+    => substrString(S, I, I +Int 1) +String reverseFrom(S, I -Int 1)
+    requires 0 <=Int I
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9cb5f25d0329450ec8fa15a111d381dca849bd13
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,5 @@
+def circular_shift(x, shift):
+    s = str(x)
+    if shift > len(s):
+        return s[::-1]
+    return s[len(s) - shift:] + s[:len(s) - shift]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1de42a83fe8cb05d769c022342b7900594a26ce8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Every integer x and every nonnegative shift in the ordinary branch.
+  claim <mpy>
+          <k> solutionProgram => .K </k>
+          <entry> "circular_shift" </entry>
+          <args> (VInt(X), VInt(SHIFT)) </args>
+          <result> VNone => VString(normalCircularShift(Int2String(X), SHIFT)) </result>
+        </mpy>
+    requires 0 <=Int SHIFT
+     andBool SHIFT <=Int lengthString(Int2String(X))
+
+  // Every integer x and every shift in the contract's oversized branch.
+  claim <mpy>
+          <k> solutionProgram => .K </k>
+          <entry> "circular_shift" </entry>
+          <args> (VInt(X), VInt(SHIFT)) </args>
+          <result> VNone => VString(reverseString(Int2String(X))) </result>
+        </mpy>
+    requires lengthString(Int2String(X)) <Int SHIFT
+
+  // The two examples are retained as concrete regression proofs.
+  claim <mpy>
+          <k> solutionProgram => .K </k>
+          <entry> "circular_shift" </entry>
+          <args> (VInt(12), VInt(1)) </args>
+          <result> VNone => VString("21") </result>
+        </mpy>
+  claim <mpy>
+          <k> solutionProgram => .K </k>
+          <entry> "circular_shift" </entry>
+          <args> (VInt(12), VInt(2)) </args>
+          <result> VNone => VString("12") </result>
+        </mpy>
+  claim <mpy>
+          <k> solutionProgram => .K </k>
+          <entry> "circular_shift" </entry>
+          <args> (VInt(1234), VInt(2)) </args>
+          <result> VNone => VString("3412") </result>
+        </mpy>
+  claim <mpy>
+          <k> solutionProgram => .K </k>
+          <entry> "circular_shift" </entry>
+          <args> (VInt(1234), VInt(5)) </args>
+          <result> VNone => VString("4321") </result>
+        </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..72363ba2dde9304dad451b87b9cf53edcb3e5bd4
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,38 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A named copy of the exact constructor tree emitted in solution.mpy.
+  // Keeping it here makes proof claims readable while krun independently parses
+  // and executes the generated solution.mpy file.
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("circular_shift", Params("x", "shift"),
+        Assign(Name("s"), Call(Name("str"), Name("x")))
+        If(
+          Compare(Name("shift"), CmpOp(">", Call(Name("len"), Name("s")))),
+          Return(Subscript(Name("s"),
+            Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
+          .Stmts)
+        Return(
+          BinOp("+",
+            Subscript(Name("s"),
+              Slice(BinOp("-", Call(Name("len"), Name("s")), Name("shift")),
+                    NoBound, NoBound)),
+            Subscript(Name("s"),
+              Slice(NoBound,
+                    BinOp("-", Call(Name("len"), Name("s")), Name("shift")),
+                    NoBound))))))
+
+  syntax Val ::= runSolution(Val, Val) [function]
+  rule runSolution(X, SHIFT)
+    => runProgram(solutionProgram, "circular_shift", (X, SHIFT))
+
+  // Independent mathematical rendering of the two clauses in the contract.
+  syntax String ::= normalCircularShift(String, Int) [function]
+  rule normalCircularShift(S, SHIFT)
+    => substrString(S, lengthString(S) -Int SHIFT, lengthString(S))
+       +String substrString(S, 0, lengthString(S) -Int SHIFT)
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a408adcb6b27c19e53bf151c39b4b3bfe10f2572
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the required constructor program from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+# Sanity-check the implementation with CPython before exercising our K semantics.
+python3 - <<'PY'
+from solution import circular_shift
+
+assert circular_shift(12, 1) == "21"
+assert circular_shift(12, 2) == "12"
+assert circular_shift(1234, 0) == "1234"
+assert circular_shift(1234, 2) == "3412"
+assert circular_shift(1234, 5) == "4321"
+PY
+
+# verification.k imports semantic.k, so this compiles the semantics, proof
+# vocabulary, and the parser for solution.mpy into one Haskell definition.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+# Prove that the constructor tree mentioned by the claims is byte-for-byte the
+# same canonical K AST as the freshly translated solution.mpy program.
+actual_ast="$(kast --definition verification-kompiled solution.mpy)"
+proof_ast="$(kast --definition verification-kompiled \
+  --module VERIFICATION --sort Program \
+  --expression 'solutionProgram' --expand-macros)"
+if [[ "$actual_ast" != "$proof_ast" ]]; then
+  echo "proof/program constructor trees differ" >&2
+  exit 1
+fi
+
+run_case() {
+  local x="$1"
+  local shift="$2"
+  local expected="$3"
+  local output
+  output="$(krun solution.mpy \
+    --definition verification-kompiled \
+    -cENTRY='"circular_shift"' \
+    -cARGS="VInt($x), VInt($shift)")"
+  printf '%s\n' "$output"
+  grep -Fq "VString ( \"$expected\" )" <<<"$output"
+}
+
+# krun exercises equality, ordinary rotation, and oversized reversal paths.
+run_case 12 1 21
+run_case 12 2 12
+run_case 1234 2 3412
+run_case 1234 5 4321
+
+# This is the required positive target proof. It proves every claim in spec.k
+# and must print #Top and exit zero.
+kprove spec.k --definition verification-kompiled
