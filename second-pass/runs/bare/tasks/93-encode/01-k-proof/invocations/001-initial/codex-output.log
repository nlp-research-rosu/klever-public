+    => encodeSpecChar(substrString(S, 0, 1))
+       +String encodeSpec(substrString(S, 1, lengthString(S)))
+    requires lengthString(S) =/=Int 0
+
+  rule encodeSpecChar(C) =>
+    #if findString("aeiouAEIOU", C, 0) >=Int 0
+    #then swapCaseChar(chrChar(ordChar(C) +Int 2))
+    #else swapCaseChar(C)
+    #fi
+
+  // Normalize the one associativity shape introduced by accumulator updates.
+  rule S +String "" => S [simplification]
+  rule "" +String S => S [simplification]
+  rule (S1 +String S2) +String S3 => S1 +String (S2 +String S3)
+    [simplification]
+
+  // The exact tree generated from solution.py.  Keeping it here ties the
+  // proofs to the submitted program rather than to a hand-written surrogate.
+  syntax Stmts ::= encodeBody() [function]
+                   | encodeLoopBody() [function]
+  syntax Pgm ::= encodeProgram() [function]
+
+  rule encodeLoopBody() =>
+    If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
+      Assign(
+        Name("char"),
+        Call(
+          Name("chr"),
+          BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
+    .Stmts)
+    AugAssign(
+      Name("result"),
+      "+",
+      Call(Attribute(Name("char"), "swapcase"), .Exprs))
+
+  rule encodeBody() =>
+    Assign(Name("result"), Str(""))
+    For(Name("char"), Name("message"), encodeLoopBody())
+    Return(Name("result"))
+
+  rule encodeProgram() =>
+    Module(
+      FuncDef("encode", Params("message"), encodeBody()))
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled --spec-module SPEC' in /work
