+requires "verification.k"
+requires "concrete.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant: starting with accumulator R, executing the translated
+  // loop body over S appends exactly the reference encoding of S.
+  claim [encode-loop-correct]:
+    <k> loopString("char", S, encodeLoopBody()) => .K </k>
+    <env>
+      "char"    |-> pyStr(C)
+      "message" |-> pyStr(M)
+      "result"  |-> pyStr(R)
+    =>
+      "char"    |-> pyStr(?C)
+      "message" |-> pyStr(M)
+      "result"  |-> pyStr(R +String encodeSpec(S))
+    </env>
+    <functions> FS </functions>
+    <result> RES </result>
+
+endmodule
+
+module CONCRETE-SPEC
+  imports CONCRETE
+  imports VERIFICATION
+
+  // The prompt's examples are retained as concrete end-to-end theorems.
+  claim [example-test]:
+    <k> encodeProgram() ~> invoke("encode", pyStr("test")) => .K </k>
+    <env> .Map => ?RHO </env>
+    <functions> .Map => ?FS </functions>
+    <result> noResult => returned(pyStr("TGST")) </result>
+
+  claim [example-message]:
+    <k> encodeProgram() ~> invoke("encode", pyStr("This is a message")) => .K </k>
+    <env> .Map => ?RHO </env>
+    <functions> .Map => ?FS </functions>
+    <result> noResult => returned(pyStr("tHKS KS C MGSSCGG")) </result>
+
+  // Covers every allowed upper- and lower-case English letter, plus the
+  // whitespace behavior exhibited by the prompt.
+  claim [ascii-domain]:
+    <k> encodeProgram()
+      ~> invoke(
+           "encode",
+           pyStr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "))
+      => .K
+    </k>
+    <env> .Map => ?RHO </env>
+    <functions> .Map => ?FS </functions>
+    <result> noResult
+      => returned(pyStr("CBCDGFGHKJKLMNQPQRSTWVWXYZcbcdgfghkjklmnqpqrstwvwxyz "))
+    </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4bc5e0a9c500295a01270e79578e2bb4b3f7474d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A mathematical reference encoder, deliberately separate from the AST
+  // interpreter.  It consumes one character per recursive call.
+  syntax String ::= encodeSpec(String) [function]
+
+  rule encodeSpec(S) => "" requires lengthString(S) ==Int 0
+  rule encodeSpec(S)
+    => encodedChar(substrString(S, 0, 1))
+       +String encodeSpec(substrString(S, 1, lengthString(S)))
+    requires lengthString(S) =/=Int 0
+
+  // Normalize the one associativity shape introduced by accumulator updates.
+  rule S +String "" => S [simplification]
+  rule "" +String S => S [simplification]
+  rule (S1 +String S2) +String S3 => S1 +String (S2 +String S3)
+    [simplification]
+
+  // The exact tree generated from solution.py.  Keeping it here ties the
+  // proofs to the submitted program rather than to a hand-written surrogate.
+  syntax Stmts ::= encodeBody() [function]
+  syntax Pgm ::= encodeProgram() [function]
+
+  rule encodeBody() =>
+    Assign(Name("result"), Str(""))
+    For(Name("char"), Name("message"), encodeLoopBody())
+    Return(Name("result"))
+
+  rule encodeProgram() =>
+    Module(
+      FuncDef("encode", Params("message"), encodeBody()))
+endmodule

exec
/bin/bash -lc 'kompile concrete-verification.k --backend haskell --main-module CONCRETE-VERIFICATION --syntax-module MPY-SYNTAX --output-definition concrete-verification-kompiled && kprove spec.k --definition concrete-verification-kompiled --spec-module CONCRETE-SPEC --warnings none' in /work
