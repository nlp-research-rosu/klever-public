+  syntax Stmts ::= encodeBody() [function]
+                   | encodeLoopBody() [function]
+  syntax Pgm ::= encodeProgram() [function]
+
+  rule encodeLoopBody() =>
+    If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
+      Assign(
+        Name("char"),
+        Call(
+          Name("chr"),
+          BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
+    .Stmts)
+    AugAssign(
+      Name("result"),
+      "+",
+      Call(Attribute(Name("char"), "swapcase"), .Exprs))
+
+  rule encodeBody() =>
+    Assign(Name("result"), Str(""))
+    For(Name("char"), Name("message"), encodeLoopBody())
+    Return(Name("result"))
+
+  rule encodeProgram() =>
+    Module(
+      FuncDef("encode", Params("message"), encodeBody()))
+endmodule

