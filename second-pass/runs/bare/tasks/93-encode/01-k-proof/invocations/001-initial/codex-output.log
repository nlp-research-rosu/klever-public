+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports STRING
+  imports INT
+  imports BOOL
+  imports MAP
+  imports K-EQUAL
+
+  syntax PyValue ::= pyStr(String) | pyInt(Int) | pyBool(Bool)
+  syntax FunValue ::= closure(Params, Stmts)
+  syntax Result ::= noResult | returned(PyValue)
+
+  syntax KItem ::= Pgm | Stmt | PyValue | FunValue
+                 | execStmts(Stmts)
+                 | invoke(String, PyValue)
+                 | startFor(String, KItem, Stmts)
+                 | loopString(String, String, Stmts)
+
+  configuration
+    <python>
+      <k> $PGM:Pgm ~> invoke("encode", pyStr($MESSAGE:String)) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </python>
+
+  rule <k> Module(SS) => execStmts(SS) ... </k>
+
+  rule <k> execStmts(.Stmts) => .K ... </k>
+  rule <k> execStmts(S:Stmt SS:Stmts) => S ~> execStmts(SS) ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
+       <functions> FS => FS [ F <- closure(PS, BODY) ] </functions>
+
+  rule <k> invoke(F, V) => execStmts(BODY) ... </k>
+       <env> RHO => RHO [ P <- V ] </env>
+       <functions> ... F |-> closure(Params(P:String), BODY) ... </functions>
+
+  rule <k> Assign(Name(X), E) => .K ... </k>
+       <env> RHO => RHO [ X <- eval(E, RHO) ] </env>
+
+  rule <k> AugAssign(Name(X), "+", E) => .K ... </k>
+       <env> RHO => RHO [ X <- plusValue(RHO [ X ], eval(E, RHO)) ] </env>
+
+  rule <k> If(E, THEN, _ELSE) => execStmts(THEN) ... </k>
+       <env> RHO </env>
+       requires eval(E, RHO) ==K pyBool(true)
+
+  rule <k> If(E, _THEN, ELSE) => execStmts(ELSE) ... </k>
+       <env> RHO </env>
+       requires eval(E, RHO) ==K pyBool(false)
+
+  rule <k> For(Name(X), E, BODY) => startFor(X, eval(E, RHO), BODY) ... </k>
+       <env> RHO </env>
+
+  rule startFor(X, pyStr(S), BODY) => loopString(X, S, BODY)
+
+  rule <k> loopString(_X, S, _BODY) => .K ... </k>
+       requires lengthString(S) ==Int 0
+
+  rule <k> loopString(X, S, BODY)
+        => execStmts(BODY)
+        ~> loopString(X, substrString(S, 1, lengthString(S)), BODY) ... </k>
+       <env> RHO
+          => RHO [ X <- pyStr(substrString(S, 0, 1)) ]
+       </env>
+       requires lengthString(S) >Int 0
+
+  rule <k> Return(E) => .K ... </k>
+       <env> RHO </env>
+       <result> noResult => returned(eval(E, RHO)) </result>
+
+  syntax KItem ::= eval(Expr, Map) [function]
+                 | plusValue(KItem, KItem) [function]
+                 | inValue(KItem, KItem) [function]
+                 | ordValue(KItem) [function]
+                 | chrValue(KItem) [function]
+                 | swapCaseValue(KItem) [function]
+
+  rule eval(Name(X), RHO) => RHO [ X ]
+  rule eval(Str(S), _RHO) => pyStr(S)
+  rule eval(Int(I), _RHO) => pyInt(I)
+  rule eval(BinOp("+", E1, E2), RHO)
+    => plusValue(eval(E1, RHO), eval(E2, RHO))
+  rule eval(Compare(E1, CmpOp("in", E2)), RHO)
+    => inValue(eval(E1, RHO), eval(E2, RHO))
+  rule eval(Call(Name("ord"), E:Expr), RHO) => ordValue(eval(E, RHO))
+  rule eval(Call(Name("chr"), E:Expr), RHO) => chrValue(eval(E, RHO))
+  rule eval(Call(Attribute(E, "swapcase"), .Exprs), RHO)
+    => swapCaseValue(eval(E, RHO))
+
+  rule plusValue(pyInt(I1), pyInt(I2)) => pyInt(I1 +Int I2)
+  rule plusValue(pyStr(S1), pyStr(S2)) => pyStr(S1 +String S2)
+  rule inValue(pyStr(NEEDLE), pyStr(HAYSTACK))
+    => pyBool(findString(HAYSTACK, NEEDLE, 0) >=Int 0)
+  rule ordValue(pyStr(C)) => pyInt(ordChar(C))
+  rule chrValue(pyInt(I)) => pyStr(chrChar(I))
+  rule swapCaseValue(pyStr(C)) => pyStr(swapCaseChar(C))
+
+  syntax String ::= swapCaseChar(String) [function]
+  rule swapCaseChar(C)
+    => chrChar(ordChar(C) +Int 32)
+    requires ordChar(C) >=Int 65 andBool ordChar(C) <=Int 90
+  rule swapCaseChar(C)
+    => chrChar(ordChar(C) -Int 32)
+    requires ordChar(C) >=Int 97 andBool ordChar(C) <=Int 122
+  rule swapCaseChar(C) => C
+    requires (ordChar(C) <Int 65 orBool ordChar(C) >Int 90)
+     andBool (ordChar(C) <Int 97 orBool ordChar(C) >Int 122)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..82819d07e55e3a37c73b08b223428c9e830ebeea
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def encode(message):
+    result = ""
+    for char in message:
+        if char in "aeiouAEIOU":
+            char = chr(ord(char) + 2)
+        result += char.swapcase()
+    return result
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a3c3e8f8ba4d2e7f8d01e996c7a0e016c92f3c56
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A mathematical reference encoder, deliberately separate from the AST
+  // interpreter.  It consumes one character per recursive call.
+  syntax String ::= encodeSpec(String) [function]
+                  | encodeSpecChar(String) [function]
+
+  rule encodeSpec("") => ""
+  rule encodeSpec(S)
+    => encodeSpecChar(substrString(S, 0, 1))
+       +String encodeSpec(substrString(S, 1, lengthString(S)))
+    requires lengthString(S) >Int 0
+
+  rule encodeSpecChar(C)
+    => swapCaseChar(chrChar(ordChar(C) +Int 2))
+    requires findString("aeiouAEIOU", C, 0) >=Int 0
+  rule encodeSpecChar(C) => swapCaseChar(C)
+    requires findString("aeiouAEIOU", C, 0) <Int 0
+
+  // The exact tree generated from solution.py.  Keeping it here ties the
+  // proofs to the submitted program rather than to a hand-written surrogate.
+  syntax Pgm ::= encodeProgram() [function]
+  rule encodeProgram() =>
+    Module(
+      FuncDef("encode", Params("message"),
+        Assign(Name("result"), Str(""))
+        For(Name("char"), Name("message"),
+          If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
+            Assign(
+              Name("char"),
+              Call(
+                Name("chr"),
+                BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
+          )
+          AugAssign(
+            Name("result"),
+            "+",
+            Call(Attribute(Name("char"), "swapcase"), )))
+        Return(Name("result"))))
+endmodule

