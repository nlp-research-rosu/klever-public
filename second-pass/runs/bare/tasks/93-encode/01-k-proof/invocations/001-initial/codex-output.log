+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "AugAssign" "(" Expr "," String "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+endmodule
