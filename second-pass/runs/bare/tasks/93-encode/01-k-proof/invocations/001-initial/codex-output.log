--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def encode(message):
+    result = ""
+    for char in message:
+        if char in "aeiouAEIOU":
+            char = chr(ord(char) + 2)
+        result += char.swapcase()
+    return result
