Module(
  FuncDef("encode", Params("message"),
    Assign(Name("result"), Str(""))
    For(Name("char"), Name("message"),
      If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
        Assign(
          Name("char"),
          Call(
            Name("chr"),
            BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
        )
      AugAssign(
        Name("result"),
        "+",
        Call(Attribute(Name("char"), "swapcase"), )))
    Return(Name("result"))))
