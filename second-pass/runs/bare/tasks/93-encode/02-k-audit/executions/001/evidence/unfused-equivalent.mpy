Module(
  FuncDef("encode", Params("message"),
    Assign(Name("result"), Str(""))
    For(Name("c"), Name("message"),
      If(Compare(Name("c"), CmpOp("in", Str("aeiouAEIOU"))),
        Assign(
          Name("c"),
          Call(
            Name("chr"),
            BinOp("+", Call(Name("ord"), Name("c")), Int(2)))),
        )
      AugAssign(
        Name("result"),
        "+",
        Call(Attribute(Name("c"), "swapcase"), )))
    Return(Name("result"))))
