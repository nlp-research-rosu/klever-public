TRUSTED CANONICAL
# canonical.py — the UNMODIFIED HumanEval/93 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: encode


def encode(message):
    """
    Write a function that takes a message, and encodes in such a 
    way that it swaps case of all letters, replaces all vowels in 
    the message with the letter that appears 2 places ahead of that 
    vowel in the english alphabet. 
    Assume only letters. 
    
    Examples:
    >>> encode('test')
    'TGST'
    >>> encode('This is a message')
    'tHKS KS C MGSSCGG'
    """
    vowels = "aeiouAEIOU"
    vowels_replace = dict([(i, chr(ord(i) + 2)) for i in vowels])
    message = message.swapcase()
    return ''.join([vowels_replace[i] if i in vowels else i for i in message])
SOLUTION.PY
def encode(message):
    result = ""
    for char in message:
        if char in "aeiouAEIOU":
            char = chr(ord(char) + 2)
        result += char.swapcase()
    return result
SOLUTION.MPY
Module(
  FuncDef("encode", Params("message"),
    Assign(Name("result"), Str(""))
    For(Name("char"), Name("message"),
      If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
        Assign(
          Name("char"),
          Call(
            Name("chr"),
            BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
        )
      AugAssign(
        Name("result"),
        "+",
        Call(Attribute(Name("char"), "swapcase"), )))
    Return(Name("result"))))
