module CONCRETE
  imports SEMANTIC

  // Ground implementation of the three total string primitives abstracted by
  // SEMANTIC.  Universal control-flow proofs can keep them opaque, while krun
  // and the concrete contract claims evaluate these equations.
  rule swapCaseChar(C) =>
    #if ordChar(C) >=Int 65 andBool ordChar(C) <=Int 90
    #then chrChar(ordChar(C) +Int 32)
    #else
      #if ordChar(C) >=Int 97 andBool ordChar(C) <=Int 122
      #then chrChar(ordChar(C) -Int 32)
      #else C
      #fi
    #fi

  rule advancedVowel(C) =>
    #if C ==String "a" orBool C ==String "e"
      orBool C ==String "i" orBool C ==String "o"
      orBool C ==String "u" orBool C ==String "A"
      orBool C ==String "E" orBool C ==String "I"
      orBool C ==String "O" orBool C ==String "U"
    #then chrChar(ordChar(C) +Int 2)
    #else C
    #fi

  rule encodedChar(C) => swapCaseChar(advancedVowel(C))
endmodule
CONCRETE-VERIFICATION.K
requires "concrete.k"
requires "verification.k"

module CONCRETE-VERIFICATION
  imports CONCRETE
  imports VERIFICATION
endmodule
VERIFICATION.K
requires "semantic.k"

module VERIFICATION
  imports SEMANTIC

  // A mathematical reference encoder, deliberately separate from the AST
  // interpreter.  It consumes one character per recursive call.
  syntax String ::= encodeSpec(String) [function]

  rule encodeSpec(S) => "" requires lengthString(S) ==Int 0
  rule encodeSpec(S)
    => encodedChar(substrString(S, 0, 1))
       +String encodeSpec(substrString(S, 1, lengthString(S)))
    requires lengthString(S) =/=Int 0

  // Normalize the one associativity shape introduced by accumulator updates.
  rule S +String "" => S [simplification]
  rule "" +String S => S [simplification]
  rule (S1 +String S2) +String S3 => S1 +String (S2 +String S3)
    [simplification]

  // The exact tree generated from solution.py.  Keeping it here ties the
  // proofs to the submitted program rather than to a hand-written surrogate.
  syntax Stmts ::= encodeBody() [function]
  syntax Pgm ::= encodeProgram() [function]

  rule encodeBody() =>
    Assign(Name("result"), Str(""))
    For(Name("char"), Name("message"), encodeLoopBody())
    Return(Name("result"))

  rule encodeProgram() =>
    Module(
      FuncDef("encode", Params("message"), encodeBody()))
endmodule
SPEC.K
requires "verification.k"
requires "concrete.k"

module SPEC
  imports VERIFICATION

  // Loop invariant: starting with accumulator R, executing the translated
  // loop body over S appends exactly the reference encoding of S.
  claim [encode-loop-correct]:
    <k> loopString("char", S, encodeLoopBody()) => .K </k>
    <env>
      "char"    |-> pyStr(C)
      "message" |-> pyStr(M)
      "result"  |-> pyStr(R)
    =>
      "char"    |-> pyStr(?C)
      "message" |-> pyStr(M)
      "result"  |-> pyStr(R +String encodeSpec(S))
    </env>
    <functions> FS </functions>
    <result> RES </result>

endmodule

module CONCRETE-SPEC
  imports CONCRETE
  imports VERIFICATION

  // The prompt's examples are retained as concrete end-to-end theorems.
  claim [example-test]:
    <k> encodeProgram() ~> invoke("encode", pyStr("test")) => .K </k>
    <env> .Map => ?RHO </env>
    <functions> .Map => ?FS </functions>
    <result> noResult => returned(pyStr("TGST")) </result>

  claim [example-message]:
    <k> encodeProgram() ~> invoke("encode", pyStr("This is a message")) => .K </k>
    <env> .Map => ?RHO </env>
    <functions> .Map => ?FS </functions>
    <result> noResult => returned(pyStr("tHKS KS C MGSSCGG")) </result>

  // Covers every allowed upper- and lower-case English letter, plus the
  // whitespace behavior exhibited by the prompt.
  claim [ascii-domain]:
    <k> encodeProgram()
      ~> invoke(
           "encode",
           pyStr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "))
      => .K
    </k>
    <env> .Map => ?RHO </env>
    <functions> .Map => ?FS </functions>
    <result> noResult
      => returned(pyStr("CBCDGFGHKJKLMNQPQRSTWVWXYZcbcdgfghkjklmnqpqrstwvwxyz "))
    </result>
endmodule
PROVE.SH
#!/usr/bin/env bash
set -euo pipefail

# Recreate the submitted constructor tree from the Python source.
python3 py2mpy.py solution.py > solution.mpy

# Abstract definition: keeps the exhaustively implemented character primitive
# opaque so the recursive loop invariant is a small induction proof.
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

# Executable definition: supplies the ground character equations used by krun
# and by the concrete end-to-end proof claims.
kompile concrete-verification.k \
  --backend haskell \
  --main-module CONCRETE-VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition concrete-verification-kompiled

# Exercise the generated solution.mpy, including both examples in prompt.py.
krun solution.mpy \
  --definition concrete-verification-kompiled \
  -cMESSAGE='"test"'
krun solution.mpy \
  --definition concrete-verification-kompiled \
  -cMESSAGE='"This is a message"'

# Positive proof 1: universal recursive invariant for the exact translated
# loop body.  This must print #Top and exit 0.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.encode-loop-correct \
  --warnings none

# Positive proof 2: all concrete end-to-end claims (the two prompt examples
# and one exhaustive ASCII-letter/domain claim).  This must print #Top and
# exit 0.
kprove spec.k \
  --definition concrete-verification-kompiled \
  --spec-module CONCRETE-SPEC \
  --warnings none

