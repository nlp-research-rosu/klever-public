+    <k> loopString("char", S, encodeLoopBody()) => .K </k>
+    <env>
+      "char"    |-> pyStr(C)
+      "message" |-> pyStr(M)
+      "result"  |-> pyStr(R)
+    =>
+      "char"    |-> pyStr(?C)
+      "message" |-> pyStr(M)
+      "result"  |-> pyStr((R +String encodeSpec(S)) +String "X")
+    </env>
+    <functions> FS </functions>
+    <result> RES </result>
+endmodule
diff --git a//tmp/audit-work/93-encode/unfused-equivalent.py b//tmp/audit-work/93-encode/unfused-equivalent.py
