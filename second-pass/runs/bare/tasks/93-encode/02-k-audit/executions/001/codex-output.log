index 0000000000000000000000000000000000000000..8b2aa9b1476c7ae34ace2b68f2b6fa3a39bdcef9
--- /dev/null
+++ b//tmp/audit-work/93-encode/unfused-equivalent.py
@@ -0,0 +1,7 @@
+def encode(message):
+    result = ""
+    for c in message:
+        if c in "aeiouAEIOU":
+            c = chr(ord(c) + 2)
+        result += c.swapcase()
+    return result
