+      "message" |-> pyStr("a")
+      "result"  |-> pyStr("")
+    =>
+      "char"    |-> pyStr(?C)
+      "message" |-> pyStr("a")
+      "result"  |-> pyStr("X")
+    </env>
+    <functions> .Map </functions>
+    <result> noResult </result>
