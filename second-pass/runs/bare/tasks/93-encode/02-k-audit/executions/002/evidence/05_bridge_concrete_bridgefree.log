COMMAND: kompile concrete-verification.k --backend haskell --main-module CONCRETE-VERIFICATION --syntax-module MPY-SYNTAX --output-definition concrete-bridgefree-kompiled
BUILD_EXIT_STATUS: 0
COMMAND: krun solution.mpy --definition concrete-bridgefree-kompiled -cMESSAGE=\"aA bB\"
<python>
  <k>
    .K
  </k>
  <env>
    "char" |-> pyStr ( "B" )
    "message" |-> pyStr ( "aA bB" )
    "result" |-> pyStr ( "Cc Bb" )
  </env>
  <functions>
    "encode" |-> closure ( Params ( "message" , .Strings ) , Assign ( Name ( "result" ) , Str ( "" ) )  For ( Name ( "char" ) , Name ( "message" ) , If ( Compare ( Name ( "char" ) , CmpOp ( "in" , Str ( "aeiouAEIOU" ) ) , .CmpOps ) , Assign ( Name ( "char" ) , Call ( Name ( "chr" ) , BinOp ( "+" , Call ( Name ( "ord" ) , Name ( "char" ) , .Exprs ) , Int ( 2 ) ) , .Exprs ) )  .Stmts , .Stmts )  AugAssign ( Name ( "result" ) , "+" , Call ( Attribute ( Name ( "char" ) , "swapcase" ) , .Exprs ) )  .Stmts )  Return ( Name ( "result" ) )  .Stmts )
  </functions>
  <result>
    returned ( pyStr ( "Cc Bb" ) )
  </result>
</python>
RUN_EXIT_STATUS: 0
