COMMAND: krun solution.mpy --definition concrete-verification-kompiled -cMESSAGE=\"\"
<python>
  <k>
    .K
  </k>
  <env>
    "message" |-> pyStr ( "" )
    "result" |-> pyStr ( "" )
  </env>
  <functions>
    "encode" |-> closure ( Params ( "message" , .Strings ) , Assign ( Name ( "result" ) , Str ( "" ) )  For ( Name ( "char" ) , Name ( "message" ) , If ( Compare ( Name ( "char" ) , CmpOp ( "in" , Str ( "aeiouAEIOU" ) ) , .CmpOps ) , Assign ( Name ( "char" ) , Call ( Name ( "chr" ) , BinOp ( "+" , Call ( Name ( "ord" ) , Name ( "char" ) , .Exprs ) , Int ( 2 ) ) , .Exprs ) )  .Stmts , .Stmts )  AugAssign ( Name ( "result" ) , "+" , Call ( Attribute ( Name ( "char" ) , "swapcase" ) , .Exprs ) )  .Stmts )  Return ( Name ( "result" ) )  .Stmts )
  </functions>
  <result>
    returned ( pyStr ( "" ) )
  </result>
</python>
EXIT_STATUS: 0
