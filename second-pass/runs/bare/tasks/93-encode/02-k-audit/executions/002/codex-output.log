@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // RHS is the constructor term in trusted-regenerated solution.mpy.
+  claim
+    <k>
+      encodeProgram()
+      =>
+      Module(
+        FuncDef("encode", Params("message"),
+          Assign(Name("result"), Str(""))
+          For(Name("char"), Name("message"),
+            If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
+              Assign(
+                Name("char"),
+                Call(
+                  Name("chr"),
+                  BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
+              .Stmts)
+            AugAssign(
+              Name("result"),
+              "+",
+              Call(Attribute(Name("char"), "swapcase"), .Exprs)))
+          Return(Name("result"))))
+    </k>
+    <env> RHO </env>
+    <functions> FS </functions>
+    <result> RES </result>
+endmodule
