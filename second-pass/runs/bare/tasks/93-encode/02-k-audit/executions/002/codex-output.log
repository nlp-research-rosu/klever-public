@@ -0,0 +1,21 @@
+requires "verification.k"
+requires "concrete.k"
+
+module GROUND-WITNESS-SPEC
+  imports CONCRETE
+  imports VERIFICATION
+
+  claim [loop-a-witness]:
+    <k> loopString("char", "a", encodeLoopBody()) => .K </k>
+    <env>
+      "char"    |-> pyStr("x")
+      "message" |-> pyStr("a")
+      "result"  |-> pyStr("")
+    =>
+      "char"    |-> pyStr("c")
+      "message" |-> pyStr("a")
+      "result"  |-> pyStr("C")
+    </env>
+    <functions> .Map </functions>
+    <result> noResult </result>
+endmodule
diff --git a/evidence/04_pinning_spec.k b/evidence/04_pinning_spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..70447f6b32e39e9955ce3fc1fa628f24de6f059e
--- /dev/null
+++ b/evidence/04_pinning_spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // RHS is the constructor term in trusted-regenerated solution.mpy.
+  claim
+    <k>
+      encodeProgram()
+      =>
+      Module(
+        FuncDef("encode", Params("message"),
+          Assign(Name("result"), Str(""))
+          For(Name("char"), Name("message"),
+            If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
+              Assign(
+                Name("char"),
+                Call(
+                  Name("chr"),
+                  BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
+              .Stmts)
+            AugAssign(
+              Name("result"),
+              "+",
+              Call(Attribute(Name("char"), "swapcase"), .Exprs)))
+          Return(Name("result"))))
+    </k>
+    <env> RHO </env>
+    <functions> FS </functions>
+    <result> RES </result>
+endmodule
