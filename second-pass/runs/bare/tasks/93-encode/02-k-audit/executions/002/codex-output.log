  krun solution.mpy --definition opposite-kompiled -cMESSAGE='\"a\"'
  s2="'$?
  echo "RUN_EXIT_STATUS: $s2"
  test "$s1" -eq 0 -a "$s2" -eq 0
} 2>&1 | tee /audit-output/evidence/05_bridge_opposite_fused.log' in /tmp/audit-work/93-encode-audit/candidate
