diff --git a/evidence/05_remove_fused_bridge.diff b/evidence/05_remove_fused_bridge.diff
new file mode 100644
index 0000000000000000000000000000000000000000..5a24ef889b76d99c8b7d2113651040763293badb
--- /dev/null
+++ b/evidence/05_remove_fused_bridge.diff
@@ -0,0 +1,31 @@
+--- semantic.k
++++ semantic.k (bridge-free audit copy)
+@@
+-  rule <k> loopString(
+-             "char",
+-             S,
+-             If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
+-               Assign(
+-                 Name("char"),
+-                 Call(
+-                   Name("chr"),
+-                   BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
+-             .Stmts)
+-             AugAssign(
+-               Name("result"),
+-               "+",
+-               Call(Attribute(Name("char"), "swapcase"), .Exprs)))
+-        => loopString(
+-             "char",
+-             substrString(S, 1, lengthString(S)),
+-             encodeLoopBody()) ... </k>
+-       <env>
+-         "result" |-> pyStr(R) RHO
+-       =>
+-         ("result" |-> pyStr(
+-            R +String encodedChar(substrString(S, 0, 1))) RHO)
+-         [ "char" <- pyStr(advancedVowel(substrString(S, 0, 1))) ]
+-       </env>
+-       requires lengthString(S) =/=Int 0
+-       [priority(40)]
+-
diff --git a/evidence/05_rule_inventory.md b/evidence/05_rule_inventory.md
