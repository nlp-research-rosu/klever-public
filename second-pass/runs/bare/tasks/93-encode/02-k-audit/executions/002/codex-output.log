diff --git a//tmp/audit-work/93-encode-audit/candidate/opposite.k b//tmp/audit-work/93-encode-audit/candidate/opposite.k
new file mode 100644
index 0000000000000000000000000000000000000000..6beca324ed494861af6bee74b713311b8002751c
--- /dev/null
+++ b//tmp/audit-work/93-encode-audit/candidate/opposite.k
@@ -0,0 +1,11 @@
+requires "verification.k"
+
+module OPPOSITE
+  imports VERIFICATION
+
+  // A legal interpretation of the otherwise equation-free abstract functions.
+  // It deliberately makes encodedChar disagree with fixed body execution.
+  rule encodedChar(_C) => "!"
+  rule advancedVowel(C) => C
+  rule swapCaseChar(C) => C
+endmodule
diff --git a//tmp/audit-work/93-encode-audit/candidate/pinning-spec.k b//tmp/audit-work/93-encode-audit/candidate/pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..70447f6b32e39e9955ce3fc1fa628f24de6f059e
--- /dev/null
+++ b//tmp/audit-work/93-encode-audit/candidate/pinning-spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // RHS is the constructor term in trusted-regenerated solution.mpy.
+  claim
+    <k>
+      encodeProgram()
+      =>
+      Module(
+        FuncDef("encode", Params("message"),
+          Assign(Name("result"), Str(""))
+          For(Name("char"), Name("message"),
+            If(Compare(Name("char"), CmpOp("in", Str("aeiouAEIOU"))),
+              Assign(
+                Name("char"),
+                Call(
+                  Name("chr"),
+                  BinOp("+", Call(Name("ord"), Name("char")), Int(2)))),
+              .Stmts)
+            AugAssign(
+              Name("result"),
+              "+",
+              Call(Attribute(Name("char"), "swapcase"), .Exprs)))
+          Return(Name("result"))))
+    </k>
+    <env> RHO </env>
+    <functions> FS </functions>
+    <result> RES </result>
+endmodule
diff --git a//tmp/audit-work/93-encode-audit/candidate/spec-vacuity-audit.k b//tmp/audit-work/93-encode-audit/candidate/spec-vacuity-audit.k
