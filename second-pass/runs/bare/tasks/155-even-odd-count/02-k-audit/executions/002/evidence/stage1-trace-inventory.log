tool_call line=134 name=exec args_length=4291 args_sha256=bf47996d771749182e29f2800a335d66d39f06ab4e12377a34b6aca43c89694e args=const patch = "*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports SEMANTIC\n+\n+  // Mathematical reference model, defined independently of the program AST.\n+  syntax Int ::= absNum(Int) [function, total]\n+               | evenDigits(Int) [function, total]\n+               | oddDigits(Int) [function, total]\n+               | isEvenDigit(Int) [function, total]\n+               | isOddDigit(Int) [function, total]\n+  syntax Val ::= expected(Int) [function, total]\n+\n+  rule absNum(N) => 0 -Int N requires N <Int 0\n+  rule absNum(N) => N requires N >=Int 0\n+\n+  rule isEvenDigit(N) => 1 requires N %Int 2 ==Int 0\n+  rule isEvenDigit(N) => 0 requires N %Int 2 =/=Int 0\n+  rule isOddDigit(N) => 0 requires N %Int 2 ==Int 0\n+  rule isOddDigit(N) => 1 requires N %Int 2 =/=Int 0\n+\n+  rule evenDigits(N) => 0 requires N <=Int 0\n+  rule evenDigits(N) => isEvenDigit(N) +Int evenDigits(N /Int 10)\n+    requires N >Int 0\n+  rule oddDigits(N) => 0 requires N <=Int 0\n+  rule oddDigits(N) => isOddDigit(N) +Int oddDigits(N /Int 10)\n+    requires N >Int 0\n+\n+  rule expected(N) => pairVal(\n+                          intVal(evenDigits(absNum(N))),\n+                          intVal(oddDigits(absNum(N))))\n+\n+  // Names for exact subtrees occurring in solution.mpy.  They are functions,\n+  // so the proof expands them to the same constructors consumed by SEMANTIC.\n+  syntax Expr ::= numPositive() [function, total]\n+                | numNegative() [function, total]\n+                | digitIsEven() [function, total]\n+                | returnedCounts() [function, total]\n+  syntax Stmts ::= digitBody() [function, total]\n+                 | functionBody() [function, total]\n+                 | returnCounts() [function, total]\n+  syntax Pgm ::= solutionProgram() [function, total]\n+\n+  rule numPositive() => Compare(Name(\"num\"), CmpOp(\">\", Int(0)))\n+  rule numNegative() => Compare(Name(\"num\"), CmpOp(\"<\", Int(0)))\n+  rule digitIsEven() => Compare(\n+                          BinOp(\"%\", Name(\"num\"), Int(2)),\n+                          CmpOp(\"==\", Int(0)))\n+  rule returnedCounts() => TupleExpr(Name(\"even\"), Name(\"odd\"))\n+\n+  rule digitBody() =>\n+    If(digitIsEven(),\n+      AugAssign(Name(\"even\"), \"+\", Int(1)),\n+      AugAssign(Name(\"odd\"), \"+\", Int(1)))\n+    Assign(Name(\"num\"), BinOp(\"//\", Name(\"num\"), Int(10)))\n+\n+  rule returnCounts() => Return(returnedCounts())\n+\n+  rule functionBody() =>\n+    If(numNegative(),\n+      Assign(Name(\"num\"), UnaryOp(\"-\", Name(\"num\"))),\n+      .Stmts)\n+    Assign(Name(\"even\"), Int(0))\n+    Assign(Name(\"odd\"), Int(0))\n+    While(numPositive(), digitBody())\n+    Return(returnedCounts())\n+\n+  rule solutionProgram() =>\n+    Module(FuncDef(\"even_odd_count\", Params(\"num\"), functionBody()))\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // The loop invariant: E and O are the counts accumulated so far, while N\n+  // is the nonnegative suffix of digits still to consume.\n+  claim <mpy>\n+          <k> loop(numPositive(), digitBody()) ~> exec(returnCounts())\n+              => .K </k>\n+          <env> (\"num\" |-> intVal(N)\n+                 \"even\" |-> intVal(E)\n+                 \"odd\" |-> intVal(O))\n+              => (\"num\" |-> intVal(0)\n+                  \"even\" |-> intVal(E +Int evenDigits(N))\n+                  \"odd\" |-> intVal(O +Int oddDigits(N))) </env>\n+          <input> INPUT </input>\n+          <result> noResult\n+                => pairVal(intVal(E +Int evenDigits(N)),\n+                           intVal(O +Int oddDigits(N))) </result>\n+        </mpy>\n+    requires N >=Int 0\n+\n+  // End-to-end correctness for every mathematical integer input.\n+  claim <mpy>\n+          <k> solutionProgram() => .K </k>\n+          <env> .Map\n+              => (\"num\" |-> intVal(0)\n+                  \"even\" |-> intVal(evenDigits(absNum(N)))\n+                  \"odd\" |-> intVal(oddDigits(absNum(N)))) </env>\n+          <input> N </input>\n+          <result> noResult => expected(N) </result>\n+        </mpy>\n+endmodule\n*** End Patch";\ntext(await tools.apply_patch(patch));\n
