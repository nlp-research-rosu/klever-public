tool_call line=60 name=exec args_length=4509 args_sha256=3559c2a02250735f1a51fee2b47bcc738c99fd1d7d0b99ee64c06e09bcb88249 args=const patch = "*** Begin Patch\n*** Add File: /work/semantic.k\n+module MPY-SYNTAX\n+  imports INT-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  syntax Pgm ::= \"Module\" \"(\" Stmts \")\"\n+\n+  syntax Stmts ::= List{Stmt, \"\"}\n+  syntax Stmt ::= \"FuncDef\" \"(\" String \",\" Params \",\" Stmts \")\"\n+                | \"Assign\" \"(\" Expr \",\" Expr \")\"\n+                | \"AugAssign\" \"(\" Expr \",\" String \",\" Expr \")\"\n+                | \"If\" \"(\" Expr \",\" Stmts \",\" Stmts \")\"\n+                | \"While\" \"(\" Expr \",\" Stmts \")\"\n+                | \"Return\" \"(\" Expr \")\"\n+\n+  syntax Params ::= \"Params\" \"(\" Strings \")\"\n+  syntax Strings ::= List{String, \",\"}\n+\n+  syntax Expr ::= \"Int\" \"(\" Int \")\"\n+                | \"Name\" \"(\" String \")\"\n+                | \"UnaryOp\" \"(\" String \",\" Expr \")\"\n+                | \"BinOp\" \"(\" String \",\" Expr \",\" Expr \")\"\n+                | \"Compare\" \"(\" Expr \",\" CmpOps \")\"\n+                | \"TupleExpr\" \"(\" Exprs \")\"\n+  syntax Exprs ::= List{Expr, \",\"}\n+  syntax CmpOp ::= \"CmpOp\" \"(\" String \",\" Expr \")\"\n+  syntax CmpOps ::= List{CmpOp, \",\"}\n+endmodule\n+\n+module SEMANTIC\n+  imports MPY-SYNTAX\n+  imports INT\n+  imports BOOL\n+  imports MAP\n+\n+  syntax Val ::= \"intVal\" \"(\" Int \")\"\n+               | \"boolVal\" \"(\" Bool \")\"\n+               | \"pairVal\" \"(\" Val \",\" Val \")\"\n+               | \"noResult\"\n+\n+  syntax Val ::= eval(Expr, Map) [function]\n+               | envGet(Map, String) [function]\n+  syntax KItem ::= exec(Stmts)\n+                 | loop(Expr, Stmts)\n+\n+  configuration\n+    <mpy>\n+      <k> $PGM:Pgm </k>\n+      <env> .Map </env>\n+      <input> $NUM:Int </input>\n+      <result> noResult </result>\n+    </mpy>\n+\n+  rule envGet((X |-> V:Val) REST, X) => V\n+\n+  rule eval(Int(I), _) => intVal(I)\n+  rule eval(Name(X), ENV) => envGet(ENV, X)\n+  rule eval(UnaryOp(\"-\", E), ENV) => intVal(0 -Int I)\n+    requires eval(E, ENV) ==K intVal(I)\n+  rule eval(BinOp(\"+\", E1, E2), ENV) => intVal(I1 +Int I2)\n+    requires eval(E1, ENV) ==K intVal(I1)\n+     andBool eval(E2, ENV) ==K intVal(I2)\n+  rule eval(BinOp(\"%\", E1, E2), ENV) => intVal(I1 %Int I2)\n+    requires eval(E1, ENV) ==K intVal(I1)\n+     andBool eval(E2, ENV) ==K intVal(I2)\n+  rule eval(BinOp(\"//\", E1, E2), ENV) => intVal(I1 /Int I2)\n+    requires eval(E1, ENV) ==K intVal(I1)\n+     andBool eval(E2, ENV) ==K intVal(I2)\n+  rule eval(Compare(E, CmpOp(\"<\", E2)), ENV) => boolVal(I <Int I2)\n+    requires eval(E, ENV) ==K intVal(I)\n+     andBool eval(E2, ENV) ==K intVal(I2)\n+  rule eval(Compare(E, CmpOp(\">\", E2)), ENV) => boolVal(I >Int I2)\n+    requires eval(E, ENV) ==K intVal(I)\n+     andBool eval(E2, ENV) ==K intVal(I2)\n+  rule eval(Compare(E, CmpOp(\"==\", E2)), ENV) => boolVal(I ==Int I2)\n+    requires eval(E, ENV) ==K intVal(I)\n+     andBool eval(E2, ENV) ==K intVal(I2)\n+  rule eval(TupleExpr(E1, E2), ENV) => pairVal(eval(E1, ENV), eval(E2, ENV))\n+\n+  rule <k> Module(FuncDef(\"even_odd_count\", Params(\"num\"), BODY)) => exec(BODY) ... </k>\n+       <env> .Map => (\"num\" |-> intVal(N)\n+                      \"even\" |-> intVal(0)\n+                      \"odd\" |-> intVal(0)) </env>\n+       <input> N </input>\n+\n+  rule <k> exec(.Stmts) => .K ... </k>\n+  rule <k> exec((S:Stmt REST:Stmts)) => S ~> exec(REST) ... </k>\n+\n+  rule <k> Assign(Name(X), E) => .K ... </k>\n+       <env> ENV => ENV [ X <- eval(E, ENV) ] </env>\n+\n+  rule <k> AugAssign(Name(X), \"+\", E) => .K ... </k>\n+       <env> ENV => ENV [ X <- intVal(I1 +Int I2) ] </env>\n+    requires envGet(ENV, X) ==K intVal(I1)\n+     andBool eval(E, ENV) ==K intVal(I2)\n+\n+  rule <k> If(E, THEN, _) => exec(THEN) ... </k>\n+       <env> ENV </env>\n+    requires eval(E, ENV) ==K boolVal(true)\n+  rule <k> If(E, _, ELSE) => exec(ELSE) ... </k>\n+       <env> ENV </env>\n+    requires eval(E, ENV) ==K boolVal(false)\n+\n+  rule <k> While(E, BODY) => loop(E, BODY) ... </k>\n+  rule <k> loop(E, BODY) => exec(BODY) ~> loop(E, BODY) ... </k>\n+       <env> ENV </env>\n+    requires eval(E, ENV) ==K boolVal(true)\n+  rule <k> loop(E, _) => .K ... </k>\n+       <env> ENV </env>\n+    requires eval(E, ENV) ==K boolVal(false)\n+\n+  rule <k> Return(E) ~> _REST => .K </k>\n+       <env> ENV </env>\n+       <result> noResult => eval(E, ENV) </result>\n+endmodule\n*** End Patch";\ntext(await tools.apply_patch(patch));\n
