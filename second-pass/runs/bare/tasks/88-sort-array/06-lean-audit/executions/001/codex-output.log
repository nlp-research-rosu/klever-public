diff --git a/evidence/readlink_app_path_override.c b/evidence/readlink_app_path_override.c
new file mode 100644
index 0000000000000000000000000000000000000000..468c8e735f3e5b0e570cd687d95f1de53d26d459
--- /dev/null
+++ b/evidence/readlink_app_path_override.c
@@ -0,0 +1,35 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox denies the readlink(2) call Lean 4.22 uses for
