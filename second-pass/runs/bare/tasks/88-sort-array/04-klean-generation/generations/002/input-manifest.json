      "module": "MPY-VERIFICATION",
      "normalized_sha256": "dd9e126e7b15037a32418def4247e20c13f15b186f245e4cf3f72e858e1234bb",
      "rationale": "Base equation defining the ascending-order predicate on a singleton list.",
      "source_rule_id": "rule-dd9e126e7b15037a32418def4247e20c13f15b186f245e4cf3f72e858e1234bb",
      "start_line": 27,
      "text": "  rule ascending(cons(_, nil)) => true"
