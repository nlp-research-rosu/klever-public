      "rationale": "Base equation defining the expected sorting result for the empty list.",
      "source_rule_id": "rule-c2b2b55c5a051e3b473faf14cc2c00e514b3eeeb6e5757b2914e2d712619b9ac",
      "start_line": 9,
      "text": "  rule expectedSort(nil) => nil"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "30d9fe0f571cb4082ba4a4f2d3f51fc7f9f7b4708f8711834b55fe75c9311827",
      "rationale": "Structural equation defining the expected result for a nonempty list by composing endpoint parity with the already defined sort-direction function.",
      "source_rule_id": "rule-30d9fe0f571cb4082ba4a4f2d3f51fc7f9f7b4708f8711834b55fe75c9311827",
      "start_line": 10,
      "text": "  rule expectedSort(cons(I, IS))\n    => sortFlag(cons(I, IS), endpointEven(cons(I, IS)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "f5702210bf86e215f20c3f58c7c1da4bb2cba74f7e6ef7e732213fba55f57c64",
      "rationale": "Equation defining the endpointEven summary as the parity test on the first and last elements.",
      "source_rule_id": "rule-f5702210bf86e215f20c3f58c7c1da4bb2cba74f7e6ef7e732213fba55f57c64",
      "start_line": 14,
      "text": "  rule endpointEven(cons(I, IS))\n    => ((I +Int ilast(cons(I, IS))) %Int 2) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "6df70917499ffd9fdcc153aa1102ebe68ef413d62a3167f4b3c82fba4683b876",
      "rationale": "Base equation defining the nonnegative domain predicate on the empty list.",
      "source_rule_id": "rule-6df70917499ffd9fdcc153aa1102ebe68ef413d62a3167f4b3c82fba4683b876",
      "start_line": 23,
      "text": "  rule nonnegative(nil) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "a2823ef797070908ec96f5ce7385cb549877694bba07b6afa992e9ec9476222f",
      "rationale": "Structural recurrence defining the nonnegative domain predicate element by element.",
      "source_rule_id": "rule-a2823ef797070908ec96f5ce7385cb549877694bba07b6afa992e9ec9476222f",
      "start_line": 24,
      "text": "  rule nonnegative(cons(I, IS)) => (I >=Int 0) andBool nonnegative(IS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "5c6659c94cef69749de734a0988bbe3002d81c4219e8712bb66bd04fe7584f7f",
      "rationale": "Base equation defining the ascending-order predicate on the empty list.",
      "source_rule_id": "rule-5c6659c94cef69749de734a0988bbe3002d81c4219e8712bb66bd04fe7584f7f",
      "start_line": 26,
      "text": "  rule ascending(nil) => true"
    },
