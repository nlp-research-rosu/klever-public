      "module": "MPY-VERIFICATION",
      "normalized_sha256": "7e8143e4605f740885b75e8c74f1bae3bb305f4f7d03c283ca4c4fd046452d8f",
      "rationale": "Structural recurrence defining ascending order through an adjacent comparison and the predicate on the remaining suffix.",
      "source_rule_id": "rule-7e8143e4605f740885b75e8c74f1bae3bb305f4f7d03c283ca4c4fd046452d8f",
      "start_line": 28,
      "text": "  rule ascending(cons(I, cons(J, JS)))\n    => (I <=Int J) andBool ascending(cons(J, JS))"
    },
    {
