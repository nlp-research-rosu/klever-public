+print(f"INFO trace payload types {dict(payload_types)}")
+print(
+    "INFO generation text sizes "
+    f"prompt={len(generation_prompt.encode())} "
+    f"output={len(generation_log.encode())} "
+    f"last={len(generation_last.encode())}"
+)
