    36	krun solution.mpy -d semantic-kompiled \
    37	  -cINPUT='cons(2, cons(4, cons(3, cons(0, cons(1, cons(5, cons(6, nil)))))))'
    38	
    39	# This single positive target command proves every claim in SPEC.  pipefail
    40	# preserves kprove's status, and the final check requires its success marker.
    41	proof_output="$(mktemp)"
    42	trap 'rm -f "$proof_output"' EXIT
    43	kprove spec.k --definition semantic-kompiled --spec-module SPEC | tee "$proof_output"
    44	grep -qx '#Top' "$proof_output"
