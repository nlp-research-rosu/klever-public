     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Recreate the exact constructor term from the submitted Python source.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Check the prompt examples in CPython and assert the non-mutation clause.
     8	python3 - <<'PY'
     9	from solution import sort_array
    10	
    11	cases = [
    12	    ([], []),
    13	    ([5], [5]),
    14	    ([2, 4, 3, 0, 1, 5], [0, 1, 2, 3, 4, 5]),
    15	    ([2, 4, 3, 0, 1, 5, 6], [6, 5, 4, 3, 2, 1, 0]),
    16	]
    17	for source, expected in cases:
    18	    before = source.copy()
    19	    result = sort_array(source)
    20	    assert result == expected
    21	    assert source == before
    22	    assert result is not source
    23	PY
    24	
    25	# Compile the semantics together with its executable verification observers.
    26	kompile semantic.k \
    27	  --backend haskell \
    28	  --main-module MPY-VERIFICATION \
    29	  --syntax-module MPY-SYNTAX
    30	
    31	# Exercise all prompt examples through the semantics.
    32	krun solution.mpy -d semantic-kompiled -cINPUT='nil'
    33	krun solution.mpy -d semantic-kompiled -cINPUT='cons(5, nil)'
    34	krun solution.mpy -d semantic-kompiled \
