+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmt ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Expr "," Expr ")"
+                | "KwArg" "(" String "," Expr ")"
+                | "BoolOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," Expr ")"
+                | "CmpOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "Subscript" "(" Expr "," Expr ")"
+
+  syntax IntList ::= "nil"
+                   | "cons" "(" Int "," IntList ")"
+
+  syntax Val ::= "ListVal" "(" IntList ")"
+               | "IntVal" "(" Int ")"
+               | "BoolVal" "(" Bool ")"
+               | "NoneVal"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
