diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5ff72fb77341bd09d04d850ccbc36ecca9414066
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,131 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+  imports MPY-VERIFICATION
+
+  // Empty-list case.  In particular, short-circuit `and` prevents either
+  // subscript from being evaluated.
+  claim
+    <k>
+      Module(
+        FuncDef("sort_array", Params("array"),
+          Return(
+            Call(
+              Name("sorted"),
+              Name("array"),
+              KwArg(
+                "reverse",
+                BoolOp(
+                  "and",
+                  Compare(
+                    Call(Name("len"), Name("array")),
+                    CmpOp(">", Int(0))),
+                  Compare(
+                    BinOp(
+                      "%",
+                      BinOp(
+                        "+",
+                        Subscript(Name("array"), Int(0)),
+                        Subscript(Name("array"), UnaryOp("-", Int(1)))),
+                      Int(2)),
+                    CmpOp("==", Int(0)))))))))
+      ~> invoke("sort_array", ListVal(nil))
+      => .K
+    </k>
+    <input> ListVal(nil) </input>
+    <result> NoneVal => ListVal(nil) </result>
+
+  // Complete nonempty case, symbolic in the first element and arbitrary
+  // tail.  expectedSort independently states the endpoint-parity contract.
+  // The unchanged input cell is part of the postcondition.
+  claim
+    <k>
+      Module(
+        FuncDef("sort_array", Params("array"),
+          Return(
+            Call(
+              Name("sorted"),
+              Name("array"),
+              KwArg(
+                "reverse",
+                BoolOp(
+                  "and",
+                  Compare(
+                    Call(Name("len"), Name("array")),
+                    CmpOp(">", Int(0))),
+                  Compare(
+                    BinOp(
+                      "%",
+                      BinOp(
+                        "+",
+                        Subscript(Name("array"), Int(0)),
+                        Subscript(Name("array"), UnaryOp("-", Int(1)))),
+                      Int(2)),
+                    CmpOp("==", Int(0)))))))))
+      ~> invoke("sort_array", ListVal(cons(F, REST)))
+      => .K
+    </k>
+    <input> ListVal(cons(F, REST)) </input>
+    <result> NoneVal => ListVal(expectedSort(cons(F, REST))) </result>
+    requires nonnegative(cons(F, REST))
+
+  // Prompt examples are also executable proof claims.  These make the two
+  // parity branches and the concrete insertion-sort behavior immediately
+  // inspectable in proof output.
+  claim
+    <k>
+      Module(
+        FuncDef("sort_array", Params("array"),
+          Return(
+            Call(
+              Name("sorted"), Name("array"),
+              KwArg("reverse",
+                BoolOp("and",
+                  Compare(Call(Name("len"), Name("array")), CmpOp(">", Int(0))),
+                  Compare(
+                    BinOp("%",
+                      BinOp("+", Subscript(Name("array"), Int(0)),
+                        Subscript(Name("array"), UnaryOp("-", Int(1)))),
+                      Int(2)),
+                    CmpOp("==", Int(0)))))))))
+      ~> invoke("sort_array",
+           ListVal(cons(2, cons(4, cons(3, cons(0, cons(1, cons(5, nil))))))))
+      => .K
+    </k>
+    <input>
+      ListVal(cons(2, cons(4, cons(3, cons(0, cons(1, cons(5, nil)))))))
+    </input>
+    <result>
+      NoneVal
+      => ListVal(cons(0, cons(1, cons(2, cons(3, cons(4, cons(5, nil)))))))
+    </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef("sort_array", Params("array"),
+          Return(
+            Call(
+              Name("sorted"), Name("array"),
+              KwArg("reverse",
+                BoolOp("and",
+                  Compare(Call(Name("len"), Name("array")), CmpOp(">", Int(0))),
+                  Compare(
+                    BinOp("%",
+                      BinOp("+", Subscript(Name("array"), Int(0)),
+                        Subscript(Name("array"), UnaryOp("-", Int(1)))),
+                      Int(2)),
+                    CmpOp("==", Int(0)))))))))
+      ~> invoke("sort_array",
+           ListVal(cons(2, cons(4, cons(3, cons(0, cons(1, cons(5, cons(6, nil)))))))))
+      => .K
+    </k>
+    <input>
+      ListVal(cons(2, cons(4, cons(3, cons(0, cons(1, cons(5, cons(6, nil))))))))
+    </input>
+    <result>
+      NoneVal
+      => ListVal(cons(6, cons(5, cons(4, cons(3, cons(2, cons(1, cons(0, nil))))))))
+    </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b20c2fd627a3cc3e881a4e0d59342aa33e7aa21c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,33 @@
+module MPY-VERIFICATION
+  imports MPY
+
+  // The postcondition is stated separately from expression evaluation.
+  // Empty input is fixed; nonempty input selects ascending or descending
+  // according to the parity of its first and last elements.
+  syntax IntList ::= expectedSort(IntList) [function, total]
+
+  rule expectedSort(nil) => nil
+  rule expectedSort(cons(I, IS))
+    => sortFlag(cons(I, IS), endpointEven(cons(I, IS)))
+
+  syntax Bool ::= endpointEven(IntList) [function]
+  rule endpointEven(cons(I, IS))
+    => ((I +Int ilast(cons(I, IS))) %Int 2) ==Int 0
+
+  // Executable contract observers used by the specification's sanity claims.
+  syntax Bool ::= nonnegative(IntList) [function, total]
+                | ascending(IntList) [function, total]
+                | descending(IntList) [function, total]
+  rule nonnegative(nil) => true
+  rule nonnegative(cons(I, IS)) => (I >=Int 0) andBool nonnegative(IS)
+
+  rule ascending(nil) => true
+  rule ascending(cons(_, nil)) => true
+  rule ascending(cons(I, cons(J, JS)))
+    => (I <=Int J) andBool ascending(cons(J, JS))
+
+  rule descending(nil) => true
+  rule descending(cons(_, nil)) => true
+  rule descending(cons(I, cons(J, JS)))
+    => (I >=Int J) andBool descending(cons(J, JS))
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh && ./prove.sh' in /work
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8ec497766def8c3bfe4c43bee62124b41d604de4
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the exact constructor term from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Check the prompt examples in CPython and assert the non-mutation clause.
+python3 - <<'PY'
+from solution import sort_array
+
+cases = [
+    ([], []),
+    ([5], [5]),
+    ([2, 4, 3, 0, 1, 5], [0, 1, 2, 3, 4, 5]),
+    ([2, 4, 3, 0, 1, 5, 6], [6, 5, 4, 3, 2, 1, 0]),
+]
+for source, expected in cases:
+    before = source.copy()
+    result = sort_array(source)
+    assert result == expected
+    assert source == before
+    assert result is not source
+PY
+
+# Compile the semantics together with its executable verification observers.
+kompile semantic.k \
+  --backend haskell \
+  --main-module MPY-VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+# Exercise all prompt examples through the semantics.
+krun solution.mpy -d semantic-kompiled -cINPUT='nil'
+krun solution.mpy -d semantic-kompiled -cINPUT='cons(5, nil)'
+krun solution.mpy -d semantic-kompiled \
+  -cINPUT='cons(2, cons(4, cons(3, cons(0, cons(1, cons(5, nil))))))'
+krun solution.mpy -d semantic-kompiled \
+  -cINPUT='cons(2, cons(4, cons(3, cons(0, cons(1, cons(5, cons(6, nil)))))))'
+
+# This single positive target command proves every claim in SPEC.  pipefail
+# preserves kprove's status, and the final check requires its success marker.
+proof_output="$(mktemp)"
+trap 'rm -f "$proof_output"' EXIT
+kprove spec.k --definition semantic-kompiled --spec-module SPEC | tee "$proof_output"
+grep -qx '#Top' "$proof_output"
