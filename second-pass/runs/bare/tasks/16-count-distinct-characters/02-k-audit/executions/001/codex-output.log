+echo "exit=$?"
+
+echo '$ find /candidate -maxdepth 1 -mindepth 1 -printf "%f\t%y\t%l\n" | sort'
+find /candidate -maxdepth 1 -mindepth 1 -printf '%f\t%y\t%l\n' | sort
