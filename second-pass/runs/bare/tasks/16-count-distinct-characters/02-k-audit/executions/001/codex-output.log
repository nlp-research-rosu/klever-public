+jerry=$?
+
+run kprove spec-empty.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-EMPTY
+empty=$?
+
+echo "summary llvm_build=$llvm_build haskell_build=$haskell_build universal=$universal xyz=$xyz jerry=$jerry empty=$empty"
