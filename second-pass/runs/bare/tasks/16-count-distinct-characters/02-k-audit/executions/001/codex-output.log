+++ b/evidence/05-unsound-witnesses.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+set +e
+cd /tmp/audit-work/build || exit 90
+
+run() {
+  echo "$ $*"
+  "$@"
+  status=$?
+  echo "exit=$status"
