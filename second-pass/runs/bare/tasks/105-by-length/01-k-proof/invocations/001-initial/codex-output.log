+          BinOp("+",
+            BinOp("+",
+              BinOp("+",
+                BinOp("+",
+                  BinOp("+",
+                    BinOp("+",
+                      BinOp("+",
+                        BinOp("+",
+                          BinOp("*", ListExpr(Str("Nine")),
+                            Call(Attribute(Name("arr"), "count"), Int(9))),
+                          BinOp("*", ListExpr(Str("Eight")),
+                            Call(Attribute(Name("arr"), "count"), Int(8)))),
+                        BinOp("*", ListExpr(Str("Seven")),
+                          Call(Attribute(Name("arr"), "count"), Int(7)))),
+                      BinOp("*", ListExpr(Str("Six")),
