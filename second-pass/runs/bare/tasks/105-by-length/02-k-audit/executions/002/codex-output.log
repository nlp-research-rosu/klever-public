    42	  syntax Value ::= "#byLength" "(" PyVals ")" [function]
    43	  rule #byLength(XS) =>
    44	    #add(
    45	      #add(
    46	        #add(
    47	          #add(
    48	            #add(
    49	              #add(
    50	                #add(
    51	                  #add(
