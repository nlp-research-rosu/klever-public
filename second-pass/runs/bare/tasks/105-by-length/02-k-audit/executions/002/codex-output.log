+def input_term(values: list[int]) -> str:
+    if not values:
+        return "pyList(.PyVals)"
+    return "pyList(" + " :: ".join(map(str, values)) + " :: .PyVals)"
+
+
+def expected_term(values: list[str]) -> str:
+    if not values:
+        return "pyList ( .PyVals )"
+    quoted = [f'"{value}"' for value in values]
+    return "pyList ( " + " :: ".join(quoted) + " :: .PyVals )"
+
+
