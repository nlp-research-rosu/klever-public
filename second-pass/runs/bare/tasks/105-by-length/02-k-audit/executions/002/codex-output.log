    80	    requires N >Int 0
    81	
    82	  rule #count(pyList(.PyVals), _N:Int) => 0
    83	  rule #count(pyList(I:Int :: XS), N:Int)
    84	    => 1 +Int (#count(pyList(XS), N))
    85	    requires I ==Int N
    86	  rule #count(pyList(I:Int :: XS), N:Int)
    87	    => #count(pyList(XS), N)
    88	    requires I =/=Int N
    89	endmodule
