+/audit-campaign-lock.json|ro,nosuid,nodev,relatime
+/run.json|ro,nosuid,nodev,relatime
+/task.json|ro,nosuid,nodev,relatime
+/generation-result.json|ro,nosuid,nodev,relatime
+/reference/canonical.py|ro,nosuid,nodev,relatime
