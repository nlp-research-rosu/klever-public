    42	      <input> $INPUT:PyList </input>
    43	      <result> noResult </result>
    44	    </mpy>
    45	
    46	  syntax KItem ::= "init" "(" Program ")" [symbol(initProgram)]
    47	                 | "noResult" [symbol(noResult)]
    48	
    49	  // Calling the one module-level function binds its sole parameter and
    50	  // evaluates the return expression.  The function name is not special here.
    51	  rule <k> init(Module(FuncDef(_F, Params(X), Return(E)))) => .K </k>
    52	       <input> V </input>
    53	       <result> noResult => #eval(E, X |-> V) </result>
    54	
    55	  syntax Value ::= "#eval" "(" Expr "," Map ")" [function]
    56	  rule #eval(Int(I), _ENV) => I
    57	  rule #eval(Str(S), _ENV) => S
    58	  rule #eval(Name(X), X |-> V) => V
    59	  rule #eval(ListExpr(E), ENV) => pyList(#eval(E, ENV) :: .PyVals)
    60	  rule #eval(BinOp("+", L, R), ENV)
