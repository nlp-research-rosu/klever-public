    72	
    73	  rule #add(pyList(XS), pyList(YS)) => pyList(#appendVals(XS, YS))
    74	  rule #appendVals(.PyVals, YS) => YS
    75	  rule #appendVals(X :: XS, YS) => X :: #appendVals(XS, YS)
    76	
    77	  rule #multiply(pyList(XS), N:Int) => pyList(#repeatVals(XS, N))
    78	  rule #repeatVals(_XS, N) => .PyVals requires N <=Int 0
