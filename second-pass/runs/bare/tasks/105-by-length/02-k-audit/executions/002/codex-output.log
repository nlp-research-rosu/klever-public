     1	module BY-LENGTH-SPEC
     2	  imports MPY-VERIFICATION
     3	
     4	  // Symbolic total-correctness claim for every finite array of integers XS.
     5	  // #byLength is the prompt's count/multiplicity characterization: nine down
     6	  // to one, with each name occurring exactly as often as its digit in XS.
     7	  claim
     8	    <k> init(#solutionProgram) => .K </k>
     9	    <program> #solutionProgram </program>
    10	    <input> pyList(XS:PyVals) </input>
    11	    <result> noResult => #byLength(XS) </result>
    12	endmodule
     1	module BY-LENGTH-MUTATION-SPEC
     2	  imports MPY-VERIFICATION
     3	
     4	  // Deliberately false: by_length([1]) is ["One"], never ["Two"].
     5	  claim
     6	    <k> init(#solutionProgram) => .K </k>
     7	    <program> #solutionProgram </program>
     8	    <input> pyList(1 :: .PyVals) </input>
     9	    <result> noResult => pyList("Two" :: .PyVals) </result>
    10	endmodule
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Recreate the submitted constructor term from the fixed translator.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Check the original Python examples before entering the K semantics.
     8	python3 - <<'PY'
     9	from solution import by_length
    10	
    11	assert by_length([2, 1, 1, 4, 5, 8, 2, 3]) == [
    12	    "Eight", "Five", "Four", "Three", "Two", "Two", "One", "One"
    13	]
    14	assert by_length([]) == []
    15	assert by_length([1, -1, 55]) == ["One"]
    16	print("Python examples: passed")
    17	PY
    18	
    19	# Compile the semantics and its verification vocabulary for symbolic execution.
    20	definition_dir=.kbuild
    21	rm -rf -- "$definition_dir"
    22	kompile semantic.k \
    23	  --backend haskell \
    24	  --main-module MPY-COMPILED \
    25	  --syntax-module MPY-SYNTAX \
    26	  -o "$definition_dir"
    27	
    28	# Exercise the translated program on every example from prompt.py.
    29	krun solution.mpy -d "$definition_dir" \
    30	  -cINPUT='pyList(2 :: 1 :: 1 :: 4 :: 5 :: 8 :: 2 :: 3 :: .PyVals)' \
    31	  --output pretty
    32	krun solution.mpy -d "$definition_dir" \
    33	  -cINPUT='pyList(.PyVals)' \
    34	  --output pretty
    35	krun solution.mpy -d "$definition_dir" \
    36	  -cINPUT='pyList(1 :: -1 :: 55 :: .PyVals)' \
    37	  --output pretty
    38	
    39	# Sanity check: a deliberately false postcondition must not prove.
    40	if kprove mutation-spec.k -d "$definition_dir" \
    41	    --spec-module BY-LENGTH-MUTATION-SPEC; then
    42	  echo "ERROR: the deliberately false mutation unexpectedly proved" >&2
    43	  exit 1
    44	else
    45	  echo "Mutation probe: rejected as expected"
    46	fi
    47	
    48	# Required positive target proof.  Success prints #Top and exits zero.
    49	kprove spec.k -d "$definition_dir" --spec-module BY-LENGTH-SPEC

