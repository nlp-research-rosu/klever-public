+for p in /candidate /generation-evidence /audit-input.json /audit-campaign-lock.json /run.json /task.json /generation-result.json /reference/canonical.py /reference/prompt.py /reference/py2mpy.py; do printf '%s|' "$p"; findmnt -T "$p" -n -o OPTIONS; done
+
