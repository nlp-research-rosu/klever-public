     7	
     8	  // The concrete constructor grammar emitted by py2mpy.py for solution.py.
     9	  syntax Program ::= "Module" "(" Stmt ")" [symbol(moduleProgram)]
    10	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
    11	                  [symbol(functionDefinition)]
    12	                | "Return" "(" Expr ")" [symbol(returnStatement)]
    13	  syntax Params ::= "Params" "(" String ")" [symbol(parameters)]
    14	
    15	  syntax Expr ::= "Int" "(" Int ")" [symbol(integerExpression)]
    16	                | "Str" "(" String ")" [symbol(stringExpression)]
    17	                | "Name" "(" String ")" [symbol(nameExpression)]
    18	                | "ListExpr" "(" Expr ")" [symbol(listExpression)]
    19	                | "Attribute" "(" Expr "," String ")"
    20	                  [symbol(attributeExpression)]
