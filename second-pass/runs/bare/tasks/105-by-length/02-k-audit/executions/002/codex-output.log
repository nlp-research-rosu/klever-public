    22	                | "BinOp" "(" String "," Expr "," Expr ")"
    23	                  [symbol(binaryExpression)]
    24	
    25	  // Python values used by this task.  PyVals is deliberately explicit rather
    26	  // than K's builtin List so symbolic list tails remain easy to quantify over.
    27	  syntax Value ::= Int | String | PyList
    28	  syntax PyList ::= "pyList" "(" PyVals ")" [symbol(pyList)]
    29	  syntax PyVals ::= ".PyVals" [symbol(emptyPyVals)]
