+
+test ! -e /tmp/audit-work/concrete-kompiled
+printf 'fresh concrete output path check exit: %s\n' "$?"
+test ! -e /tmp/audit-work/proof-kompiled
+printf 'fresh proof output path check exit: %s\n' "$?"
+
+kompile semantic.k \
+  --backend llvm \
+  --main-module MPY-COMPILED \
