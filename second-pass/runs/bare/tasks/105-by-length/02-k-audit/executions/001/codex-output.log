    39	  // A contract-level characterization of the prompt: for each valid digit,
    40	  // descending from 9 to 1, emit its name once per occurrence in the input.
    41	  // Values outside 1..9 never contribute a block.
    42	  syntax Value ::= "#byLength" "(" PyVals ")" [function]
    43	  rule #byLength(XS) =>
    44	    #add(
    45	      #add(
    46	        #add(
    47	          #add(
    48	            #add(
    49	              #add(
