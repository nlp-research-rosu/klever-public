    30	  -cINPUT='pyList(2 :: 1 :: 1 :: 4 :: 5 :: 8 :: 2 :: 3 :: .PyVals)' \
    31	  --output pretty
    32	krun solution.mpy -d "$definition_dir" \
    33	  -cINPUT='pyList(.PyVals)' \
    34	  --output pretty
    35	krun solution.mpy -d "$definition_dir" \
    36	  -cINPUT='pyList(1 :: -1 :: 55 :: .PyVals)' \
    37	  --output pretty
    38	
    39	# Sanity check: a deliberately false postcondition must not prove.
    40	if kprove mutation-spec.k -d "$definition_dir" \
    41	    --spec-module BY-LENGTH-MUTATION-SPEC; then
    42	  echo "ERROR: the deliberately false mutation unexpectedly proved" >&2
    43	  exit 1
    44	else
    45	  echo "Mutation probe: rejected as expected"
    46	fi
    47	
    48	# Required positive target proof.  Success prints #Top and exits zero.
    49	kprove spec.k -d "$definition_dir" --spec-module BY-LENGTH-SPEC

===== /candidate/mutation-spec.k =====
     1	module BY-LENGTH-MUTATION-SPEC
     2	  imports MPY-VERIFICATION
     3	
     4	  // Deliberately false: by_length([1]) is ["One"], never ["Two"].
     5	  claim
     6	    <k> init(#solutionProgram) => .K </k>
     7	    <program> #solutionProgram </program>
     8	    <input> pyList(1 :: .PyVals) </input>
     9	    <result> noResult => pyList("Two" :: .PyVals) </result>
    10	endmodule

