    32	                BinOp("*", ListExpr(Str("Three")),
    33	                  Call(Attribute(Name("arr"), "count"), Int(3)))),
    34	              BinOp("*", ListExpr(Str("Two")),
    35	                Call(Attribute(Name("arr"), "count"), Int(2)))),
    36	            BinOp("*", ListExpr(Str("One")),
    37	              Call(Attribute(Name("arr"), "count"), Int(1)))))))
