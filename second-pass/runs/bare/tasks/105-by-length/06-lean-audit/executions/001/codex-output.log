program=[(n,int(d)) for n,d in re.findall(r'ListExpr\\(Str\\(\"([A-Za-z]+)\"\\)\\),\\s*\\n?\\s*Call\\(Attribute\\(Name\\(\"arr\"\\), \"count\"\\), Int\\((\\d)\\)\\)',inv['rules'][0]['text'])]
