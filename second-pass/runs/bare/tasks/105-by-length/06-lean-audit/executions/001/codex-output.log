import ast,json,re
from pathlib import Path
from tools.k_rule_inventory import inventory_verification

tree=ast.parse(Path('/reference/k-proof/solution.py').read_text())
fn=tree.body[0]
expr=fn.body[0].value
terms=[]
def flatten_add(node):
 if isinstance(node,ast.BinOp) and isinstance(node.op,ast.Add):
  flatten_add(node.left); flatten_add(node.right)
 else: terms.append(node)
flatten_add(expr)
pairs=[]
valid=True
for t in terms:
 try:
  assert isinstance(t,ast.BinOp) and isinstance(t.op,ast.Mult)
  assert isinstance(t.left,ast.List) and len(t.left.elts)==1 and isinstance(t.left.elts[0],ast.Constant)
  call=t.right
  assert isinstance(call,ast.Call) and isinstance(call.func,ast.Attribute) and call.func.attr=='count'
  assert isinstance(call.func.value,ast.Name) and call.func.value.id=='arr'
  assert len(call.args)==1 and isinstance(call.args[0],ast.Constant)
  pairs.append((t.left.elts[0].value,call.args[0].value))
 except AssertionError: valid=False
