print(json.dumps({'source_shape_valid':valid,'source_pairs':pairs,'program_term_pairs':program,'summary_pairs':summary,'all_pair_sequences_equal':pairs==program==summary,'source_parameter':fn.args.args[0].arg,'source_function':fn.name},indent=2))
