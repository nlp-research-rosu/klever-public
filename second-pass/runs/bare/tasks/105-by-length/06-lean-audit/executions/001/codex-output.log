def _rule_documents(
    text: str, modules: tuple[_Module, ...]
) -> list[dict[str, Any]]:
    spans = [span for module in modules for span in _rule_spans(text, module)]
    spans.sort(key=lambda span: span.start_offset)
    return [dataclasses.asdict(span.rule) for span in spans]


def _attribute_token_spans(
    text: str,
    masked_text: str,
) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            spans.append(
                (
                    start,
                    index,
                    _without_comments(text[start:index]).strip(),
                )
            )
            start = index + 1
    spans.append(
        (
            start,
            len(text),
            _without_comments(text[start:]).strip(),
        )
    )
    return spans


def _blank_non_newlines(text: str) -> str:
    return "".join(
        character if character in "\r\n" else " "
        for character in text
    )


def desimplify_rule_ids(
    text: str,
    source_rule_ids: list[str],
) -> str:
    """Remove simplification from exactly the selected canonical rule IDs."""

    if len(source_rule_ids) != len(set(source_rule_ids)):
        raise KRuleInventoryError(
            "exact rule transformation contains a duplicate source rule ID"
        )
    selected = set(source_rule_ids)
    modules = _modules(_mask_non_code(text))
    spans = [
        span
        for local_module in modules
        for span in _rule_spans(text, local_module)
    ]
    by_id = {span.rule.source_rule_id: span for span in spans}
    unknown = sorted(selected - set(by_id))
    if unknown:
        raise KRuleInventoryError(
            "exact rule transformation names an unknown source rule ID: "
            + ", ".join(unknown)
        )

    edits: list[tuple[int, int]] = []
    for source_rule_id in source_rule_ids:
        span = by_id[source_rule_id]
        if span.attribute_start is None or span.attribute_end is None:
            raise KRuleInventoryError(
                "selected source rule has no simplification attribute: "
                f"{source_rule_id}"
            )
        attribute_text = text[
            span.attribute_start + 1 : span.attribute_end - 1
        ]
        masked_attributes = _mask_non_code(attribute_text)
        tokens = _attribute_token_spans(
            attribute_text,
            masked_attributes,
        )
        matches = [
            index
            for index, (_start, _end, token) in enumerate(tokens)
            if token == "simplification"
        ]
        if len(matches) != 1:
            raise KRuleInventoryError(
                "selected source rule has ambiguous simplification "
                f"attributes: {source_rule_id}"
            )
        token_index = matches[0]
        if len(tokens) == 1:
            edit_start = span.attribute_start
            edit_end = span.attribute_end
        elif token_index < len(tokens) - 1:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index][0]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index + 1][0]
            )
        else:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index - 1][1]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index][1]
            )
        edits.append((edit_start, edit_end))

    transformed = text
    for start, end in sorted(edits, reverse=True):
        transformed = (
            transformed[:start]
            + _blank_non_newlines(transformed[start:end])
            + transformed[end:]
        )
    return transformed


def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    modules = _modules(masked_text)
    module = _verification_module(
        modules, _last_verification_main_module(workspace)
    )
    closure = _verification_closure(modules, module)
    rule_documents = _rule_documents(text, closure)
    return {
        "schema_version": 2,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "verification_modules": [module.name for module in closure],
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }
module MPY-VERIFICATION
  imports MPY-SEMANTICS

  // The exact AST generated in solution.mpy.  Keeping it as a named function
  // makes the quantified claims readable while still proving the translated
  // program, rather than a hand-written shortcut command.
  syntax Program ::= "#solutionProgram" [function]
  rule #solutionProgram =>
    Module(
      FuncDef("by_length", Params("arr"),
        Return(
          BinOp("+",
            BinOp("+",
              BinOp("+",
                BinOp("+",
                  BinOp("+",
                    BinOp("+",
                      BinOp("+",
                        BinOp("+",
                          BinOp("*", ListExpr(Str("Nine")),
                            Call(Attribute(Name("arr"), "count"), Int(9))),
                          BinOp("*", ListExpr(Str("Eight")),
                            Call(Attribute(Name("arr"), "count"), Int(8)))),
                        BinOp("*", ListExpr(Str("Seven")),
                          Call(Attribute(Name("arr"), "count"), Int(7)))),
                      BinOp("*", ListExpr(Str("Six")),
                        Call(Attribute(Name("arr"), "count"), Int(6)))),
                    BinOp("*", ListExpr(Str("Five")),
                      Call(Attribute(Name("arr"), "count"), Int(5)))),
                  BinOp("*", ListExpr(Str("Four")),
                    Call(Attribute(Name("arr"), "count"), Int(4)))),
                BinOp("*", ListExpr(Str("Three")),
                  Call(Attribute(Name("arr"), "count"), Int(3)))),
              BinOp("*", ListExpr(Str("Two")),
                Call(Attribute(Name("arr"), "count"), Int(2)))),
            BinOp("*", ListExpr(Str("One")),
              Call(Attribute(Name("arr"), "count"), Int(1)))))))

  // A contract-level characterization of the prompt: for each valid digit,
  // descending from 9 to 1, emit its name once per occurrence in the input.
  // Values outside 1..9 never contribute a block.
  syntax Value ::= "#byLength" "(" PyVals ")" [function]
  rule #byLength(XS) =>
    #add(
      #add(
        #add(
          #add(
            #add(
              #add(
                #add(
                  #add(
                    #multiply(pyList("Nine" :: .PyVals), #count(pyList(XS), 9)),
                    #multiply(pyList("Eight" :: .PyVals), #count(pyList(XS), 8))),
                  #multiply(pyList("Seven" :: .PyVals), #count(pyList(XS), 7))),
                #multiply(pyList("Six" :: .PyVals), #count(pyList(XS), 6))),
              #multiply(pyList("Five" :: .PyVals), #count(pyList(XS), 5))),
            #multiply(pyList("Four" :: .PyVals), #count(pyList(XS), 4))),
          #multiply(pyList("Three" :: .PyVals), #count(pyList(XS), 3))),
        #multiply(pyList("Two" :: .PyVals), #count(pyList(XS), 2))),
      #multiply(pyList("One" :: .PyVals), #count(pyList(XS), 1)))
endmodule
requires "verification.k"

module MPY-SYNTAX
  imports INT-SYNTAX
  imports STRING-SYNTAX
  imports MAP

  // The concrete constructor grammar emitted by py2mpy.py for solution.py.
  syntax Program ::= "Module" "(" Stmt ")" [symbol(moduleProgram)]
  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
                  [symbol(functionDefinition)]
                | "Return" "(" Expr ")" [symbol(returnStatement)]
  syntax Params ::= "Params" "(" String ")" [symbol(parameters)]

  syntax Expr ::= "Int" "(" Int ")" [symbol(integerExpression)]
                | "Str" "(" String ")" [symbol(stringExpression)]
                | "Name" "(" String ")" [symbol(nameExpression)]
                | "ListExpr" "(" Expr ")" [symbol(listExpression)]
                | "Attribute" "(" Expr "," String ")"
                  [symbol(attributeExpression)]
                | "Call" "(" Expr "," Expr ")" [symbol(callExpression)]
                | "BinOp" "(" String "," Expr "," Expr ")"
                  [symbol(binaryExpression)]

  // Python values used by this task.  PyVals is deliberately explicit rather
  // than K's builtin List so symbolic list tails remain easy to quantify over.
  syntax Value ::= Int | String | PyList
  syntax PyList ::= "pyList" "(" PyVals ")" [symbol(pyList)]
  syntax PyVals ::= ".PyVals" [symbol(emptyPyVals)]
                  | Value "::" PyVals [symbol(consPyVals)]
endmodule

module MPY-SEMANTICS
  imports MPY-SYNTAX
  imports INT
  imports BOOL

  configuration
    <mpy>
      <k> init($PGM) </k>
      <program> $PGM:Program </program>
      <input> $INPUT:PyList </input>
      <result> noResult </result>
    </mpy>

  syntax KItem ::= "init" "(" Program ")" [symbol(initProgram)]
                 | "noResult" [symbol(noResult)]

  // Calling the one module-level function binds its sole parameter and
  // evaluates the return expression.  The function name is not special here.
  rule <k> init(Module(FuncDef(_F, Params(X), Return(E)))) => .K </k>
       <input> V </input>
       <result> noResult => #eval(E, X |-> V) </result>

  syntax Value ::= "#eval" "(" Expr "," Map ")" [function]
  rule #eval(Int(I), _ENV) => I
  rule #eval(Str(S), _ENV) => S
  rule #eval(Name(X), X |-> V) => V
  rule #eval(ListExpr(E), ENV) => pyList(#eval(E, ENV) :: .PyVals)
  rule #eval(BinOp("+", L, R), ENV)
    => #add(#eval(L, ENV), #eval(R, ENV))
  rule #eval(BinOp("*", L, R), ENV)
    => #multiply(#eval(L, ENV), #eval(R, ENV))
  rule #eval(Call(Attribute(BASE, "count"), ARG), ENV)
    => #count(#eval(BASE, ENV), #eval(ARG, ENV))

  syntax Value ::= "#add" "(" Value "," Value ")" [function]
                 | "#multiply" "(" Value "," Value ")" [function]
  syntax Int ::= "#count" "(" Value "," Value ")" [function]
  syntax PyVals ::= "#appendVals" "(" PyVals "," PyVals ")" [function]
                  | "#repeatVals" "(" PyVals "," Int ")" [function]

  rule #add(pyList(XS), pyList(YS)) => pyList(#appendVals(XS, YS))
  rule #appendVals(.PyVals, YS) => YS
  rule #appendVals(X :: XS, YS) => X :: #appendVals(XS, YS)

  rule #multiply(pyList(XS), N:Int) => pyList(#repeatVals(XS, N))
  rule #repeatVals(_XS, N) => .PyVals requires N <=Int 0
  rule #repeatVals(XS, N) => #appendVals(XS, #repeatVals(XS, N -Int 1))
    requires N >Int 0

  rule #count(pyList(.PyVals), _N:Int) => 0
  rule #count(pyList(I:Int :: XS), N:Int)
    => 1 +Int (#count(pyList(XS), N))
    requires I ==Int N
  rule #count(pyList(I:Int :: XS), N:Int)
    => #count(pyList(XS), N)
    requires I =/=Int N
endmodule

// Compilation root: retain the executable semantics and its verification
// vocabulary in the compiled definition used by both krun and kprove.
module MPY-COMPILED
  imports MPY-SEMANTICS
  imports MPY-VERIFICATION
endmodule
module BY-LENGTH-SPEC
  imports MPY-VERIFICATION

  // Symbolic total-correctness claim for every finite array of integers XS.
  // #byLength is the prompt's count/multiplicity characterization: nine down
  // to one, with each name occurring exactly as often as its digit in XS.
  claim
    <k> init(#solutionProgram) => .K </k>
    <program> #solutionProgram </program>
    <input> pyList(XS:PyVals) </input>
    <result> noResult => #byLength(XS) </result>
endmodule
def by_length(arr):
    return (
        ["Nine"] * arr.count(9)
        + ["Eight"] * arr.count(8)
        + ["Seven"] * arr.count(7)
        + ["Six"] * arr.count(6)
        + ["Five"] * arr.count(5)
        + ["Four"] * arr.count(4)
        + ["Three"] * arr.count(3)
        + ["Two"] * arr.count(2)
        + ["One"] * arr.count(1)
    )
Module(
  FuncDef("by_length", Params("arr"),
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      BinOp(
                        "*",
                        ListExpr(Str("Nine")),
                        Call(Attribute(Name("arr"), "count"), Int(9))),
                      BinOp(
                        "*",
                        ListExpr(Str("Eight")),
                        Call(Attribute(Name("arr"), "count"), Int(8)))),
                    BinOp(
                      "*",
                      ListExpr(Str("Seven")),
                      Call(Attribute(Name("arr"), "count"), Int(7)))),
                  BinOp(
                    "*",
                    ListExpr(Str("Six")),
                    Call(Attribute(Name("arr"), "count"), Int(6)))),
                BinOp(
                  "*",
                  ListExpr(Str("Five")),
                  Call(Attribute(Name("arr"), "count"), Int(5)))),
              BinOp(
                "*",
                ListExpr(Str("Four")),
                Call(Attribute(Name("arr"), "count"), Int(4)))),
            BinOp(
              "*",
              ListExpr(Str("Three")),
              Call(Attribute(Name("arr"), "count"), Int(3)))),
          BinOp(
            "*",
            ListExpr(Str("Two")),
            Call(Attribute(Name("arr"), "count"), Int(2)))),
        BinOp(
          "*",
          ListExpr(Str("One")),
          Call(Attribute(Name("arr"), "count"), Int(1)))))))
#!/usr/bin/env bash
set -euo pipefail

# Recreate the submitted constructor term from the fixed translator.
python3 py2mpy.py solution.py > solution.mpy

# Check the original Python examples before entering the K semantics.
python3 - <<'PY'
from solution import by_length

assert by_length([2, 1, 1, 4, 5, 8, 2, 3]) == [
    "Eight", "Five", "Four", "Three", "Two", "Two", "One", "One"
]
assert by_length([]) == []
assert by_length([1, -1, 55]) == ["One"]
print("Python examples: passed")
PY

# Compile the semantics and its verification vocabulary for symbolic execution.
definition_dir=.kbuild
rm -rf -- "$definition_dir"
kompile semantic.k \
  --backend haskell \
  --main-module MPY-COMPILED \
  --syntax-module MPY-SYNTAX \
  -o "$definition_dir"

# Exercise the translated program on every example from prompt.py.
krun solution.mpy -d "$definition_dir" \
  -cINPUT='pyList(2 :: 1 :: 1 :: 4 :: 5 :: 8 :: 2 :: 3 :: .PyVals)' \
  --output pretty
krun solution.mpy -d "$definition_dir" \
  -cINPUT='pyList(.PyVals)' \
  --output pretty
krun solution.mpy -d "$definition_dir" \
  -cINPUT='pyList(1 :: -1 :: 55 :: .PyVals)' \
  --output pretty

# Sanity check: a deliberately false postcondition must not prove.
if kprove mutation-spec.k -d "$definition_dir" \
    --spec-module BY-LENGTH-MUTATION-SPEC; then
  echo "ERROR: the deliberately false mutation unexpectedly proved" >&2
  exit 1
else
  echo "Mutation probe: rejected as expected"
fi

# Required positive target proof.  Success prints #Top and exits zero.
kprove spec.k -d "$definition_dir" --spec-module BY-LENGTH-SPEC
