+}
+
+actual_stage1 = {
+    path.relative_to("/reference/k-proof").as_posix(): hashlib.sha256(
+        path.read_bytes()
+    ).hexdigest()
+    for path in sorted(Path("/reference/k-proof").rglob("*"))
