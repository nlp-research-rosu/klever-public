+```sh
+rg -n '^\s*def\s+targetStatement\b|\bsorry\b|\badmit\b|\bunsafe\b' \
+  /reference/klean-generation/generated --glob '*.lean'
+test -e /candidate
+sha256sum \
+  /reference/klean-generation/generated/Klean105ByLength/Lemmas.lean
