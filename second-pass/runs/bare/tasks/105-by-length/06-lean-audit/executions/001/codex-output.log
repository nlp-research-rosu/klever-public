codex
I found the cause: this sandbox virtualizes `getpid()` but exposes `/proc` under different host PIDs; Lean 4.22 resolves its executable through `/proc/<getpid()>/exe`, so both Lean and Lake fail before checking the project. I’m applying a narrow local runtime shim under `/tmp/audit-work` that makes `getpid()` return `/proc/self`’s visible PID, then I’ll rerun the unmodified trusted preflight. This changes neither candidate/provenance inputs nor the generated sources.
apply patch
patch: completed
/tmp/audit-work/getpid_host.c
diff --git a//tmp/audit-work/getpid_host.c b//tmp/audit-work/getpid_host.c
new file mode 100644
index 0000000000000000000000000000000000000000..48843984fb7c86f9c3ac3f8ea6bc3630ae789055
--- /dev/null
+++ b//tmp/audit-work/getpid_host.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char path[64];
+    ssize_t length = readlink("/proc/self", path, sizeof(path) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(path)) {
+        return (pid_t)-1;
+    }
+    path[length] = '\0';
+
+    pid_t pid = 0;
+    for (ssize_t index = 0; index < length; ++index) {
+        if (path[index] < '0' || path[index] > '9') {
+            return (pid_t)-1;
+        }
+        pid = (pid_t)(pid * 10 + (path[index] - '0'));
+    }
+    return pid;
+}

