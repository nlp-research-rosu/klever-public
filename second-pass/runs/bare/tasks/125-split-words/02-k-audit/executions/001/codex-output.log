diff --git a/evidence/whitespace_inventory_check.py b/evidence/whitespace_inventory_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..3404af11b5c462bd476b0e04dc18aaf7124561e2
--- /dev/null
+++ b/evidence/whitespace_inventory_check.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Check the generated semantics' one-character whitespace table exhaustively."""
+
+from __future__ import annotations
+
+import ast
+import re
+from pathlib import Path
+
+
+SEMANTICS = Path("/tmp/audit-work/fresh/candidate/semantic.k")
+
+
+def codepoints(values: set[str]) -> list[str]:
+    return [f"U+{ord(value):04X}" for value in sorted(values, key=ord)]
+
+
+def main() -> int:
+    source = SEMANTICS.read_text(encoding="utf-8")
+    block_match = re.search(
+        r"rule\s+isWhitespace\(C\).*?findString\(\s*"
+        r'("(?:\\.|[^"\\])*")\s*,\s*C\s*,\s*0\s*\)',
+        source,
+        re.DOTALL,
+    )
+    if block_match is None:
+        print("ERROR: could not locate isWhitespace table")
+        return 2
+    literal = ast.literal_eval(block_match.group(1))
+    actual = set(literal)
+    expected = {
+        chr(codepoint)
+        for codepoint in range(0x110000)
+        if chr(codepoint).isspace()
+    }
+    print("SEMANTICS:", SEMANTICS)
+    print("TABLE_LENGTH:", len(literal))
+    print("TABLE_UNIQUE_COUNT:", len(actual))
+    print("PYTHON_ISSPACE_COUNT:", len(expected))
+    print("TABLE_CODEPOINTS:", " ".join(codepoints(actual)))
+    print("PYTHON_CODEPOINTS:", " ".join(codepoints(expected)))
+    print("MISSING:", " ".join(codepoints(expected - actual)))
+    print("ADDITIONAL:", " ".join(codepoints(actual - expected)))
+    print("DUPLICATES:", len(literal) - len(actual))
+    return 0 if actual == expected and len(literal) == len(actual) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a//tmp/audit-work/fresh/candidate/pinning-spec.k b//tmp/audit-work/fresh/candidate/pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9ad59da53b708d45755842d7436e3e890f7cc4dd
--- /dev/null
+++ b//tmp/audit-work/fresh/candidate/pinning-spec.k
@@ -0,0 +1,65 @@
+requires "verification.k"
+
+module AUDIT-PINNING-SPEC
+  imports MPY-VERIFICATION
+
+  // RHS is the byte-regenerated solution.mpy constructor term.
+  claim <k> solutionAST =>
+    Module(
+      FuncDef("split_words", Params("txt"),
+        Assign(Name("words"), Call(Attribute(Name("txt"), "split"), .Exprs))
+        If(Compare(
+          Call(Attribute(Str(""), "join"), Name("words")),
+          CmpOp("!=", Name("txt"))),
+          Return(Name("words")),
+          .Stmts)
+        If(Compare(Str(","), CmpOp("in", Name("txt"))),
+          Return(Call(Attribute(Name("txt"), "split"), Str(","))),
+          .Stmts)
+        Return(
+          BinOp(
+            "+",
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          BinOp(
+                            "+",
+                            BinOp(
+                              "+",
+                              BinOp(
+                                "+",
+                                BinOp(
+                                  "+",
+                                  Call(
+                                    Attribute(Name("txt"), "count"),
+                                    Str("b")),
+                                  Call(
+                                    Attribute(Name("txt"), "count"),
+                                    Str("d"))),
+                                Call(
+                                  Attribute(Name("txt"), "count"),
+                                  Str("f"))),
+                              Call(
+                                Attribute(Name("txt"), "count"),
+                                Str("h"))),
+                            Call(Attribute(Name("txt"), "count"), Str("j"))),
+                          Call(Attribute(Name("txt"), "count"), Str("l"))),
+                        Call(Attribute(Name("txt"), "count"), Str("n"))),
+                      Call(Attribute(Name("txt"), "count"), Str("p"))),
+                    Call(Attribute(Name("txt"), "count"), Str("r"))),
+                  Call(Attribute(Name("txt"), "count"), Str("t"))),
+                Call(Attribute(Name("txt"), "count"), Str("v"))),
+              Call(Attribute(Name("txt"), "count"), Str("x"))),
+            Call(Attribute(Name("txt"), "count"), Str("z")))))) </k>
+endmodule
