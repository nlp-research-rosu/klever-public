     1	def split_words(txt):
     2	    words = txt.split()
     3	    if "".join(words) != txt:
     4	        return words
     5	    if "," in txt:
     6	        return txt.split(",")
     7	    return (
     8	        txt.count("b")
     9	        + txt.count("d")
    10	        + txt.count("f")
    11	        + txt.count("h")
    12	        + txt.count("j")
    13	        + txt.count("l")
    14	        + txt.count("n")
    15	        + txt.count("p")
    16	        + txt.count("r")
    17	        + txt.count("t")
    18	        + txt.count("v")
    19	        + txt.count("x")
    20	        + txt.count("z")
