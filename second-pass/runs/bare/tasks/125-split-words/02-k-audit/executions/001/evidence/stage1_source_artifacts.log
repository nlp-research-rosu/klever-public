    72	  rule asBool(VBool(B)) => B
    73	  rule iteValue(true, THEN, _) => THEN
    74	  rule iteValue(false, _, ELSE) => ELSE
    75	
    76	  // Big-step statement execution with explicit return propagation.
    77	  syntax Outcome ::= "normal" "(" Map ")"
    78	                   | "returned" "(" Value ")"
    79	  syntax Outcome ::= "iteOutcome" "(" Bool "," Outcome "," Outcome ")"
    80	  syntax Outcome ::= "exec" "(" Stmts "," Map ")" [function]
    81	                   | "execStmt" "(" Stmt "," Map ")" [function]
    82	                   | "execRest" "(" Outcome "," Stmts ")" [function]
    83	
    84	  rule exec(.Stmts, ENV) => normal(ENV)
    85	  rule exec(S:Stmt SS:Stmts, ENV) => execRest(execStmt(S, ENV), SS)
    86	
    87	  rule execRest(normal(ENV), SS) => exec(SS, ENV)
    88	  rule execRest(returned(V), _) => returned(V)
    89	  rule execRest(iteOutcome(B, THEN, ELSE), SS)
    90	    => iteOutcome(B, execRest(THEN, SS), execRest(ELSE, SS))
    91	
    92	  rule execStmt(Assign(Name(X), E), ENV) => normal(ENV [ X <- eval(E, ENV) ])
    93	  rule execStmt(Return(E), ENV) => returned(eval(E, ENV))
    94	  rule execStmt(If(COND, THEN, ELSE), ENV)
    95	    => iteOutcome(
    96	         asBool(eval(COND, ENV)), exec(THEN, ENV), exec(ELSE, ENV))
    97	
    98	  // Python str.split() with no separator: collapse whitespace runs and omit
    99	  // empty fields. This is the whitespace set recognized by CPython isspace().
   100	  syntax Bool ::= "isWhitespace" "(" String ")" [function, total]
   101	  rule isWhitespace(C)
   102	    => findString(
   103	         " \t\n\r\f\x0b\x1c\x1d\x1e\x1f\x85\xa0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000",
   104	         C, 0) >=Int 0
   105	
   106	  syntax List ::= "pySplitWhitespace" "(" String ")" [function]
   107	                | "splitWhitespaceAt" "(" String "," Int "," String "," List ")" [function]
   108	  rule pySplitWhitespace(S) => splitWhitespaceAt(S, 0, "", .List)
   109	  rule splitWhitespaceAt(S, I, "", OUT) => OUT
   110	    requires I >=Int lengthString(S)
   111	  rule splitWhitespaceAt(S, I, WORD, OUT) => OUT ListItem(VStr(WORD))
   112	    requires I >=Int lengthString(S) andBool WORD =/=String ""
   113	  rule splitWhitespaceAt(S, I, "", OUT)
   114	    => splitWhitespaceAt(S, I +Int 1, "", OUT)
   115	    requires I <Int lengthString(S)
   116	      andBool isWhitespace(substrString(S, I, I +Int 1))
   117	  rule splitWhitespaceAt(S, I, WORD, OUT)
   118	    => splitWhitespaceAt(S, I +Int 1, "", OUT ListItem(VStr(WORD)))
   119	    requires I <Int lengthString(S)
   120	      andBool WORD =/=String ""
   121	      andBool isWhitespace(substrString(S, I, I +Int 1))
   122	  rule splitWhitespaceAt(S, I, WORD, OUT)
   123	    => splitWhitespaceAt(
   124	         S, I +Int 1,
   125	         WORD +String substrString(S, I, I +Int 1), OUT)
   126	    requires I <Int lengthString(S)
   127	      andBool notBool isWhitespace(substrString(S, I, I +Int 1))
   128	
   129	  syntax String ::= "joinValues" "(" String "," List ")" [function]
   130	                  | "joinValuesTail" "(" String "," List ")" [function]
   131	  rule joinValues(_, .List) => ""
   132	  rule joinValues(SEP, ListItem(VStr(S)) REST:List)
   133	    => S +String joinValuesTail(SEP, REST)
   134	  rule joinValuesTail(_, .List) => ""
   135	  rule joinValuesTail(SEP, ListItem(VStr(S)) REST:List)
   136	    => SEP +String S +String joinValuesTail(SEP, REST)
   137	
   138	  // Python str.split(separator), including leading, trailing, and repeated
   139	  // separators. The program calls this only with the nonempty string ",".
   140	  syntax List ::= "pySplitOn" "(" String "," String ")" [function]
   141	  rule pySplitOn(S, SEP) => ListItem(VStr(S))
   142	    requires findString(S, SEP, 0) <Int 0
   143	  rule pySplitOn(S, SEP)
   144	    => ListItem(VStr(substrString(S, 0, findString(S, SEP, 0))))
   145	       pySplitOn(
   146	         substrString(
   147	           S,
   148	           findString(S, SEP, 0) +Int lengthString(SEP),
   149	           lengthString(S)),
   150	         SEP)
   151	    requires findString(S, SEP, 0) >=Int 0
   152	      andBool lengthString(SEP) >Int 0
   153	endmodule
