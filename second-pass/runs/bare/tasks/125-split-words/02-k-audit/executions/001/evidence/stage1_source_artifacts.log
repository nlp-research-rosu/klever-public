    21	  rule outcomeValue(returned(V)) => V
    22	  rule outcomeValue(iteOutcome(B, THEN, ELSE))
    23	    => iteValue(B, outcomeValue(THEN), outcomeValue(ELSE))
    24	  rule runProgram(Module(STMTS), S)
