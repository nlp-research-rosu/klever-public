    32	module MPY-SEMANTIC
    33	  imports MPY-SYNTAX
    34	  imports DOMAINS
    35	
    36	  // Runtime values. Lists contain Value elements wrapped with ListItem.
    37	  syntax Value ::= "VStr" "(" String ")"
    38	                 | "VInt" "(" Int ")"
    39	                 | "VBool" "(" Bool ")"
    40	                 | "VList" "(" List ")"
    41	                 | "VAttr" "(" Value "," String ")"
    42	  syntax Value ::= "iteValue" "(" Bool "," Value "," Value ")" [function]
    43	
    44	  syntax Value ::= "eval" "(" Expr "," Map ")" [function]
