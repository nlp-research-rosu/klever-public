    20	
    21	  syntax Expr ::= "Name" "(" String ")"
    22	                | "Str" "(" String ")"
    23	                | "Int" "(" Int ")"
    24	                | "Attribute" "(" Expr "," String ")"
    25	                | "Call" "(" Expr "," Exprs ")"
    26	                | "Compare" "(" Expr "," CmpOps ")"
    27	                | "BinOp" "(" String "," Expr "," Expr ")"
    28	
    29	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    30	endmodule
