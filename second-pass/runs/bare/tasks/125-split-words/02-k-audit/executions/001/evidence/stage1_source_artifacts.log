    47	  syntax Value ::= "compare" "(" Value "," String "," Value ")" [function]
    48	  syntax Bool  ::= "asBool" "(" Value ")" [function]
    49	
    50	  rule eval(Name(X), (X |-> V:Value) _REST:Map) => V
    51	  rule eval(Str(S), _) => VStr(S)
