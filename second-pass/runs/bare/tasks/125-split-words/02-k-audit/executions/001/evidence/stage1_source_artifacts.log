===== candidate/spec.k =====
     1	requires "verification.k"
     2	
     3	module SPLIT-WORDS-SPEC
     4	  imports MPY-VERIFICATION
     5	
     6	  // One total symbolic claim states the contract for every String. The nested
     7	  // conditional encodes the three exhaustive branches and their precedence.
     8	  claim <k> runProgram(solutionAST, S:String)
     9	          => iteValue(
    10	               containsWhitespace(S),
    11	               VList(pySplitWhitespace(S)),
    12	               iteValue(
    13	                 findString(S, ",", 0) >=Int 0,
    14	                 VList(pySplitOn(S, ",")),
    15	                 VInt(oddLetterCount(S)))) ... </k>
    16	
    17	  // Original prompt examples.
    18	  claim <k> runProgram(solutionAST, "Hello world!")
    19	          => VList(ListItem(VStr("Hello")) ListItem(VStr("world!"))) ... </k>
    20	
    21	  claim <k> runProgram(solutionAST, "Hello,world!")
    22	          => VList(ListItem(VStr("Hello")) ListItem(VStr("world!"))) ... </k>
    23	
    24	  claim <k> runProgram(solutionAST, "abcdef") => VInt(3) ... </k>
    25	
    26	  // Edge cases: empty input, whitespace precedence, and preserved empty comma
    27	  // fields.
    28	  claim <k> runProgram(solutionAST, "") => VInt(0) ... </k>
    29	
    30	  claim <k> runProgram(solutionAST, "a,b c")
    31	          => VList(ListItem(VStr("a,b")) ListItem(VStr("c"))) ... </k>
    32	
    33	  claim <k> runProgram(solutionAST, "left\u2003right")
    34	          => VList(ListItem(VStr("left")) ListItem(VStr("right"))) ... </k>
    35	
    36	  claim <k> runProgram(solutionAST, "a,,b,")
    37	          => VList(
    38	               ListItem(VStr("a"))
    39	               ListItem(VStr(""))
    40	               ListItem(VStr("b"))
    41	               ListItem(VStr(""))) ... </k>
    42	endmodule
===== candidate/prove.sh =====
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Regenerate the constructor program from the submitted Python source.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Build the hand-written semantics with the symbolic Haskell backend.
     8	kompile verification.k \
     9	  --backend haskell \
    10	  --main-module MPY-VERIFICATION \
    11	  --syntax-module MPY-SYNTAX
    12	
    13	# Exercise all three contract branches and two precedence/edge cases using the
    14	# actual translated program as $PGM.
    15	krun solution.mpy -cINPUT='"Hello world!"'
    16	krun solution.mpy -cINPUT='"Hello,world!"'
    17	krun solution.mpy -cINPUT='"abcdef"'
    18	krun solution.mpy -cINPUT='"a,b c"'
    19	krun solution.mpy -cINPUT='"a,,b,"'
    20	
    21	# Prove the total symbolic contract and every concrete claim in spec.k.
    22	kprove spec.k \
    23	  --definition verification-kompiled \
    24	  --spec-module SPLIT-WORDS-SPEC
