     6	def split_words(txt):
     7	    '''
     8	    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you
     9	    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the
    10	    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25
    11	    Examples
    12	    split_words("Hello world!") ➞ ["Hello", "world!"]
    13	    split_words("Hello,world!") ➞ ["Hello", "world!"]
    14	    split_words("abcdef") == 3 
    15	    '''
    16	    if " " in txt:
    17	        return txt.split()
    18	    elif "," in txt:
    19	        return txt.replace(',',' ').split()
    20	    else:
    21	        return len([i for i in txt if i.islower() and ord(i)%2 == 0])
