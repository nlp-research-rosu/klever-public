diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6625e81d98d1351f599d4feb4fca7894985356a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,104 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTIC
+
+  // A generic one-argument function invocation layer over the translated AST.
+  syntax Function ::= "closure" "(" Params "," Stmts ")"
+  syntax Function ::= "findFunction" "(" String "," Stmts ")" [function]
+  syntax Value ::= "invoke" "(" Function "," Value ")" [function]
+                 | "outcomeValue" "(" Outcome ")" [function]
+                 | "runProgram" "(" Module "," String ")" [function]
+
+  rule findFunction(F, FuncDef(F, PARAMS, BODY) _REST:Stmts)
+    => closure(PARAMS, BODY)
+  rule findFunction(F, FuncDef(G, _, _) REST:Stmts)
+    => findFunction(F, REST)
+    requires F =/=String G
+
+  rule invoke(closure(Params(P:String), BODY), V)
+    => outcomeValue(exec(BODY, P |-> V))
+  rule outcomeValue(returned(V)) => V
+  rule outcomeValue(iteOutcome(B, THEN, ELSE))
+    => iteValue(B, outcomeValue(THEN), outcomeValue(ELSE))
+  rule runProgram(Module(STMTS), S)
+    => invoke(findFunction("split_words", STMTS), VStr(S))
+
+  // This nullary term expands to the exact constructor tree in solution.mpy.
+  // Keeping it here makes every symbolic claim explicitly about the submitted
+  // implementation rather than about a hand-written summary of the function.
+  syntax Module ::= "solutionAST" [function]
+  rule solutionAST =>
+    Module(
+      FuncDef("split_words", Params("txt"),
+        Assign(Name("words"), Call(Attribute(Name("txt"), "split"), .Exprs))
+        If(Compare(
+          Call(Attribute(Str(""), "join"), Name("words")),
+          CmpOp("!=", Name("txt"))),
+          Return(Name("words")),
+          .Stmts)
+        If(Compare(Str(","), CmpOp("in", Name("txt"))),
+          Return(Call(Attribute(Name("txt"), "split"), Str(","))),
+          .Stmts)
+        Return(
+          BinOp(
+            "+",
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          BinOp(
+                            "+",
+                            BinOp(
+                              "+",
+                              BinOp(
+                                "+",
+                                BinOp(
+                                  "+",
+                                  Call(Attribute(Name("txt"), "count"), Str("b")),
+                                  Call(Attribute(Name("txt"), "count"), Str("d"))),
+                                Call(Attribute(Name("txt"), "count"), Str("f"))),
+                              Call(Attribute(Name("txt"), "count"), Str("h"))),
+                            Call(Attribute(Name("txt"), "count"), Str("j"))),
+                          Call(Attribute(Name("txt"), "count"), Str("l"))),
+                        Call(Attribute(Name("txt"), "count"), Str("n"))),
+                      Call(Attribute(Name("txt"), "count"), Str("p"))),
+                    Call(Attribute(Name("txt"), "count"), Str("r"))),
+                  Call(Attribute(Name("txt"), "count"), Str("t"))),
+                Call(Attribute(Name("txt"), "count"), Str("v"))),
+              Call(Attribute(Name("txt"), "count"), Str("x"))),
+            Call(Attribute(Name("txt"), "count"), Str("z"))))))
+
+  // The mathematical value required by the third branch of the prompt.
+  syntax Int ::= "oddLetterCount" "(" String ")" [function, total]
+  rule oddLetterCount(S) =>
+    ((((((((((((countAllOccurrences(S, "b")
+      +Int countAllOccurrences(S, "d"))
+      +Int countAllOccurrences(S, "f"))
+      +Int countAllOccurrences(S, "h"))
+      +Int countAllOccurrences(S, "j"))
+      +Int countAllOccurrences(S, "l"))
+      +Int countAllOccurrences(S, "n"))
+      +Int countAllOccurrences(S, "p"))
+      +Int countAllOccurrences(S, "r"))
+      +Int countAllOccurrences(S, "t"))
+      +Int countAllOccurrences(S, "v"))
+      +Int countAllOccurrences(S, "x"))
+      +Int countAllOccurrences(S, "z"))
+
+  syntax Bool ::= "containsWhitespace" "(" String ")" [function, total]
+  rule containsWhitespace(S)
+    => joinValues("", pySplitWhitespace(S)) =/=String S
+
+  configuration <k> runProgram($PGM:Module, $INPUT:String) </k>
+endmodule

exec
/bin/bash -lc "kompile verification.k --backend haskell --main-module MPY-VERIFICATION --syntax-module MPY-SYNTAX
krun solution.mpy -cINPUT='\"a,b c\"'
krun solution.mpy -cINPUT='\"a,,b,\"'
kprove spec.k --definition verification-kompiled --spec-module SPLIT-WORDS-SPEC" in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6830191eaf9f9ecf4db757866b30465c9a841050
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,150 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports STRING-SYNTAX
+  imports INT-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports DOMAINS
+
+  // Runtime values. Lists contain Value elements wrapped with ListItem.
+  syntax Value ::= "VStr" "(" String ")"
+                 | "VInt" "(" Int ")"
+                 | "VBool" "(" Bool ")"
+                 | "VList" "(" List ")"
+                 | "VAttr" "(" Value "," String ")"
+  syntax Value ::= "iteValue" "(" Bool "," Value "," Value ")" [function]
+
+  syntax Value ::= "eval" "(" Expr "," Map ")" [function]
+  syntax Value ::= "call" "(" Value "," List ")" [function]
+  syntax Value ::= "add" "(" Value "," Value ")" [function]
+  syntax Value ::= "compare" "(" Value "," String "," Value ")" [function]
+  syntax Bool  ::= "asBool" "(" Value ")" [function]
+
+  rule eval(Name(X), (X |-> V:Value) REST:Map) => V
+  rule eval(Str(S), _) => VStr(S)
+  rule eval(Int(I), _) => VInt(I)
+  rule eval(Attribute(E, A), ENV) => VAttr(eval(E, ENV), A)
+  rule eval(Call(F, .Exprs), ENV) => call(eval(F, ENV), .List)
+  rule eval(Call(F, A:Expr), ENV) => call(eval(F, ENV), ListItem(eval(A, ENV)))
+  rule eval(BinOp("+", L, R), ENV) => add(eval(L, ENV), eval(R, ENV))
+  rule eval(Compare(L, CmpOp(OP, R)), ENV)
+    => compare(eval(L, ENV), OP, eval(R, ENV))
+
+  rule call(VAttr(VStr(S), "split"), .List) => VList(pySplitWhitespace(S))
+  rule call(VAttr(VStr(S), "split"), ListItem(VStr(SEP)))
+    => VList(pySplitOn(S, SEP))
+  rule call(VAttr(VStr(SEP), "join"), ListItem(VList(VS)))
+    => VStr(joinValues(SEP, VS))
+  rule call(VAttr(VStr(S), "count"), ListItem(VStr(NEEDLE)))
+    => VInt(countAllOccurrences(S, NEEDLE))
+
+  rule add(VInt(I), VInt(J)) => VInt(I +Int J)
+  rule compare(VStr(A), "!=", VStr(B)) => VBool(A =/=String B)
+  rule compare(VStr(A), "in", VStr(B))
+    => VBool(findString(B, A, 0) >=Int 0)
+  rule asBool(VBool(B)) => B
+  rule iteValue(true, THEN, _) => THEN
+  rule iteValue(false, _, ELSE) => ELSE
+
+  // Big-step statement execution with explicit return propagation.
+  syntax Outcome ::= "normal" "(" Map ")"
+                   | "returned" "(" Value ")"
+  syntax Outcome ::= "iteOutcome" "(" Bool "," Outcome "," Outcome ")" [function]
+  syntax Outcome ::= "exec" "(" Stmts "," Map ")" [function]
+                   | "execStmt" "(" Stmt "," Map ")" [function]
+                   | "execRest" "(" Outcome "," Stmts ")" [function]
+
+  rule exec(.Stmts, ENV) => normal(ENV)
+  rule exec(S:Stmt SS:Stmts, ENV) => execRest(execStmt(S, ENV), SS)
+
+  rule execRest(normal(ENV), SS) => exec(SS, ENV)
+  rule execRest(returned(V), _) => returned(V)
+  rule execRest(iteOutcome(B, THEN, ELSE), SS)
+    => iteOutcome(B, execRest(THEN, SS), execRest(ELSE, SS))
+
+  rule execStmt(Assign(Name(X), E), ENV) => normal(ENV [ X <- eval(E, ENV) ])
+  rule execStmt(Return(E), ENV) => returned(eval(E, ENV))
+  rule execStmt(If(COND, THEN, ELSE), ENV)
+    => iteOutcome(
+         asBool(eval(COND, ENV)), exec(THEN, ENV), exec(ELSE, ENV))
+
+  // Python str.split() with no separator: collapse whitespace runs and omit
+  // empty fields. The whitespace set is Python's ASCII whitespace set.
+  syntax Bool ::= "isWhitespace" "(" String ")" [function, total]
+  rule isWhitespace(C) => findString(" \t\n\r\f\x0b", C, 0) >=Int 0
+
+  syntax List ::= "pySplitWhitespace" "(" String ")" [function]
+                | "splitWhitespaceAt" "(" String "," Int "," String "," List ")" [function]
+  rule pySplitWhitespace(S) => splitWhitespaceAt(S, 0, "", .List)
+  rule splitWhitespaceAt(S, I, "", OUT) => OUT
+    requires I >=Int lengthString(S)
+  rule splitWhitespaceAt(S, I, WORD, OUT) => OUT ListItem(VStr(WORD))
+    requires I >=Int lengthString(S) andBool WORD =/=String ""
+  rule splitWhitespaceAt(S, I, "", OUT)
+    => splitWhitespaceAt(S, I +Int 1, "", OUT)
+    requires I <Int lengthString(S)
+      andBool isWhitespace(substrString(S, I, I +Int 1))
+  rule splitWhitespaceAt(S, I, WORD, OUT)
+    => splitWhitespaceAt(S, I +Int 1, "", OUT ListItem(VStr(WORD)))
+    requires I <Int lengthString(S)
+      andBool WORD =/=String ""
+      andBool isWhitespace(substrString(S, I, I +Int 1))
+  rule splitWhitespaceAt(S, I, WORD, OUT)
+    => splitWhitespaceAt(
+         S, I +Int 1,
+         WORD +String substrString(S, I, I +Int 1), OUT)
+    requires I <Int lengthString(S)
+      andBool notBool isWhitespace(substrString(S, I, I +Int 1))
+
+  syntax String ::= "joinValues" "(" String "," List ")" [function]
+                  | "joinValuesTail" "(" String "," List ")" [function]
+  rule joinValues(_, .List) => ""
+  rule joinValues(SEP, ListItem(VStr(S)) REST:List)
+    => S +String joinValuesTail(SEP, REST)
+  rule joinValuesTail(_, .List) => ""
+  rule joinValuesTail(SEP, ListItem(VStr(S)) REST:List)
+    => SEP +String S +String joinValuesTail(SEP, REST)
+
+  // Python str.split(separator), including leading, trailing, and repeated
+  // separators. The program calls this only with the nonempty string ",".
+  syntax List ::= "pySplitOn" "(" String "," String ")" [function]
+  rule pySplitOn(S, SEP) => ListItem(VStr(S))
+    requires findString(S, SEP, 0) <Int 0
+  rule pySplitOn(S, SEP)
+    => ListItem(VStr(substrString(S, 0, findString(S, SEP, 0))))
+       pySplitOn(
+         substrString(
+           S,
+           findString(S, SEP, 0) +Int lengthString(SEP),
+           lengthString(S)),
+         SEP)
+    requires findString(S, SEP, 0) >=Int 0
+      andBool lengthString(SEP) >Int 0
+endmodule
