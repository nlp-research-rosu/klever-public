     1	// Contract vocabulary kept separate from the execution semantics.  The
     2	// contract says: retain, in order, exactly the characters of s which do not
     3	// occur in c, and report whether that retained string equals its reversal.
     4	
     5	requires "semantic.k"
     6	
     7	module VERIFICATION
     8	  imports SEMANTIC
     9	
    10	  // A named copy of the transliterated program keeps proof claims readable.
    11	  // prove.sh regenerates solution.mpy and checks its SHA-256 before proof, so
    12	  // this constructor tree is pinned to the submitted translated artifact.
    13	  syntax Pgm ::= "solutionPgm" [function]
    14	  rule solutionPgm =>
    15	    Module(
    16	      FuncDef("reverse_delete", Params("s", "c"),
    17	        Assign(Name("result"), Str(""))
    18	        For(Name("ch"), Name("s"),
    19	          If(Compare(Name("ch"), CmpOp("not in", Name("c"))),
    20	            Assign(Name("result"), BinOp("+", Name("result"), Name("ch"))),
    21	            .Stmts))
    22	        Return(
    23	          TupleExpr(
    24	            Name("result"),
    25	            Compare(
    26	              Name("result"),
    27	              CmpOp(
    28	                "==",
    29	                Subscript(
    30	                  Name("result"),
    31	                  Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))))
    32	
    33	  syntax Val ::= expectedResult(String, String) [function]
    34	  rule expectedResult(S, C)
    35	    => tupleVal(
    36	         strVal(deleteChars(S, C)),
    37	         boolVal(deleteChars(S, C)
    38	                 ==String reverseString(deleteChars(S, C))))
    39	endmodule

