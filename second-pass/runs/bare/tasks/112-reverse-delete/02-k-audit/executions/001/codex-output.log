+                    Assign(Name("result"),
+                      BinOp("+", Name("result"), Name("ch"))),
+                    .Stmts))
+                Return(
+                  TupleExpr(
+                    Name("result"),
+                    Compare(
+                      Name("result"),
+                      CmpOp(
+                        "==",
+                        Subscript(
+                          Name("result"),
+                          Slice(
+                            NoBound,
+                            NoBound,
+                            UnaryOp("-", Int(1)))))))))),
+            S:String,
+            C:String)
+          => returned(expectedResult(S, C))
+        </k>
+endmodule
