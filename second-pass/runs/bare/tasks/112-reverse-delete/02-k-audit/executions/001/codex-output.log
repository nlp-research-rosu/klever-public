+#!/usr/bin/env python3
+"""Run one command and preserve a bounded, self-describing audit log."""
+
+from __future__ import annotations
+
+import argparse
+import datetime
+import os
+import shlex
+import subprocess
+import sys
+
+
+def bounded(data: bytes, limit: int) -> bytes:
+    if len(data) <= limit:
+        return data
+    half = limit // 2
+    marker = (
+        b"\n\n[AUDIT LOG TRUNCATED: "
+        + str(len(data) - 2 * half).encode("ascii")
+        + b" BYTES OMITTED]\n\n"
+    )
