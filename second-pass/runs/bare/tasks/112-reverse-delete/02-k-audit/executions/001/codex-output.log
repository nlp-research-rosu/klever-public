diff --git a//tmp/audit-work/112-reverse-delete/spec-audit.k b//tmp/audit-work/112-reverse-delete/spec-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..b65ce342be268e7742694e0a24d5094c3b8f81d4
--- /dev/null
+++ b//tmp/audit-work/112-reverse-delete/spec-audit.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC-AUDIT
+  imports VERIFICATION
+
+  claim [universal]:
+        <k>
+          execute(solutionPgm, S:String, C:String)
+          => returned(expectedResult(S, C))
+        </k>
+
+  claim [example-1]:
+        <k>
+          execute(solutionPgm, "abcde", "ae")
+          => returned(tupleVal(strVal("bcd"), boolVal(false)))
+        </k>
+
+  claim [example-2]:
+        <k>
+          execute(solutionPgm, "abcdef", "b")
+          => returned(tupleVal(strVal("acdef"), boolVal(false)))
+        </k>
+
+  claim [example-3]:
+        <k>
+          execute(solutionPgm, "abcdedcba", "ab")
+          => returned(tupleVal(strVal("cdedc"), boolVal(true)))
+        </k>
+endmodule
diff --git a//tmp/audit-work/112-reverse-delete/spec-direct.k b//tmp/audit-work/112-reverse-delete/spec-direct.k
new file mode 100644
index 0000000000000000000000000000000000000000..b04f8d4057d6127e16b154aeb91ccb237ded8bc0
--- /dev/null
+++ b//tmp/audit-work/112-reverse-delete/spec-direct.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module SPEC-DIRECT
+  imports VERIFICATION
+
+  // Directly embeds the exact constructor tree regenerated into solution.mpy.
+  claim [direct-program]:
+        <k>
+          execute(
+            Module(
+              FuncDef("reverse_delete", Params("s", "c"),
+                Assign(Name("result"), Str(""))
+                For(Name("ch"), Name("s"),
+                  If(Compare(Name("ch"), CmpOp("not in", Name("c"))),
+                    Assign(Name("result"),
+                      BinOp("+", Name("result"), Name("ch"))),
+                    .Stmts))
+                Return(
+                  TupleExpr(
+                    Name("result"),
+                    Compare(
+                      Name("result"),
+                      CmpOp(
+                        "==",
+                        Subscript(
+                          Name("result"),
+                          Slice(
+                            NoBound,
+                            NoBound,
+                            UnaryOp("-", Int(1)))))))))),
+            S:String,
+            C:String)
+          => returned(expectedResult(S, C))
+        </k>
+endmodule
