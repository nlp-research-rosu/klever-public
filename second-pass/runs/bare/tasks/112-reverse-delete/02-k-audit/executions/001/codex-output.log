diff --git a/evidence/loop_rule_alias_witness.py b/evidence/loop_rule_alias_witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e3e76ac0f2d462c69c52132f159f400320716dd
--- /dev/null
+++ b/evidence/loop_rule_alias_witness.py
@@ -0,0 +1,14 @@
+#!/usr/bin/env python3
+"""Real-Python behavior for the semantic loop rule's aliasing witness."""
+
+
+def reverse_delete(s, c):
+    result = ""
+    for ch in s:
+        if ch not in result:
+            result = result + ch
+    return (result, result == result[::-1])
+
+
+if __name__ == "__main__":
+    print(reverse_delete("aba", ""))
