CALL/OUTPUT line=72 call=(70, 'exec', 'const patch = "*** Begin Patch\\n*** Add File: /work/verification.k\\n+// Contract vocabulary kept separate from the execution semantics.  The\\n+// contract says: retain, in order, exactly the characters of s which do not\\n+// occur in c, and report whether that retained string equals its reversal.\\n+\\n+requires \\"semantic.k\\"\\n+\\n+module VERIFICATION\\n+  imports SEMANTIC\\n+\\n+  syntax Val ::= expectedResult(String, String) [function]\\n+  rule expectedResult(S, C)\\n+    => tupleVal(\\n+         strVal(deleteChars(S, C)),\\n+         boolVal(deleteChars(S, C)\\n+                 ==String reverseString(deleteChars(S, C))))\\n+endmodule\\n*** Add File: /work/spec.k\\n+requires \\"verification.k\\"\\n+\\n+module SPEC\\n+  imports VERIFICATION\\n+\\n+  // Universal functional-correctness theorem.  This is the exact constructor\\n+  // tree in solution.mpy, with only the two input strings left symbolic.\\n+  claim <k>\\n+          execute(\\n+            Module(\\n+              FuncDef(\\"reverse_delete\\", Params(\\"s\\", \\"c\\"),\\n+                Assign(Name(\\"result\\"), Str(\\"\\"))\\n+                For(Name(\\"ch\\"), Name(\\"s\\"),\\n+                  If(Compare(Name(\\"ch\\"),\\n+                       CmpOp(\\"not in\\", Name(\\"c\\"))),\\n+                    Assign(Name(\\"result\\"),\\n+                      BinOp(\\"+\\", Name(\\"result\\"), Name(\\"ch\\"))),\\n+                    .Stmts))\\n+                Return(\\n+                  TupleExpr(\\n+                    Name(\\"result\\"),\\n+                    Compare(\\n+                      Name(\\"result\\"),\\n+                      CmpOp(\\"==\\",\\n+                        Subscript(\\n+                          Name(\\"result\\"),\\n+                          Slice(NoBound, NoBound,\\n+                            UnaryOp(\\"-\\", Int(1))))))))))),\\n+            S, C)\\n+          => returned(expectedResult(S, C))\\n+        </k>\\n+\\n+  /