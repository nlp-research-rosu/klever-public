+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG_PATH COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
