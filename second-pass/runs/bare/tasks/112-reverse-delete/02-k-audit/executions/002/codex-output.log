+requires "semantic.k"
+
+module VERIFICATION-BODY-MUTATED
+  imports SEMANTIC
+
+  syntax Pgm ::= "mutatedSolutionPgm" [function]
+  rule mutatedSolutionPgm =>
+    Module(
+      FuncDef("reverse_delete", Params("s", "c"),
+        // Deliberate body mutation: the submitted program initializes with "".
+        Assign(Name("result"), Str("X"))
+        For(Name("ch"), Name("s"),
+          If(Compare(Name("ch"), CmpOp("not in", Name("c"))),
+            Assign(Name("result"), BinOp("+", Name("result"), Name("ch"))),
+            .Stmts))
+        Return(
+          TupleExpr(
+            Name("result"),
+            Compare(
+              Name("result"),
+              CmpOp(
+                "==",
+                Subscript(
+                  Name("result"),
+                  Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))))
+
+  syntax Val ::= expectedMutatedResult(String, String) [function]
+  rule expectedMutatedResult(S, C)
+    => tupleVal(
+         strVal(deleteChars(S, C)),
+         boolVal(deleteChars(S, C)
+                 ==String reverseString(deleteChars(S, C))))
+endmodule

codex
The claim is mechanically pinned to the submitted constructor tree (identical parsed KAST after normalizing K’s explicit empty-list unit), and a real body mutation makes the universal claim stick as expected. The deeper issue is execution: the `For` rule consumes the entire loop idiom in one answer-bearing rewrite. I’m now testing that rule’s full matched context and the Unicode string bridge with concrete counterexamples before completing the declaration-by-declaration inventory.
