--- /dev/null
+++ b/spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional-correctness theorem: S and C are arbitrary K
+  // strings.  expectedResult is the natural-language contract encoded in
+  // verification.k.
+  claim <k>
+          execute(solutionPgm, S:String, C:String)
+          => returned(expectedResult(S, C))
+        </k>
+
+  // The three examples in the prompt are also independent proof claims.
+  claim <k>
+          execute(solutionPgm, "abcde", "ae")
+          => returned(tupleVal(strVal("bcd"), boolVal(false)))
+        </k>
+
+  claim <k>
+          execute(solutionPgm, "abcdef", "b")
+          => returned(tupleVal(strVal("acdef"), boolVal(false)))
+        </k>
+
+  claim <k>
+          execute(solutionPgm, "abcdedcba", "ab")
+          => returned(tupleVal(strVal("cdedc"), boolVal(true)))
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..991cd1a900cabcb3c4f2d859b2e8733e50f4695a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+// Contract vocabulary kept separate from the execution semantics.  The
+// contract says: retain, in order, exactly the characters of s which do not
+// occur in c, and report whether that retained string equals its reversal.
+
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A named copy of the transliterated program keeps proof claims readable.
+  // prove.sh regenerates solution.mpy and checks its SHA-256 before proof, so
+  // this constructor tree is pinned to the submitted translated artifact.
+  syntax Pgm ::= "solutionPgm" [function]
+  rule solutionPgm =>
+    Module(
+      FuncDef("reverse_delete", Params("s", "c"),
+        Assign(Name("result"), Str(""))
+        For(Name("ch"), Name("s"),
+          If(Compare(Name("ch"), CmpOp("not in", Name("c"))),
+            Assign(Name("result"), BinOp("+", Name("result"), Name("ch"))),
+            .Stmts))
+        Return(
+          TupleExpr(
+            Name("result"),
+            Compare(
+              Name("result"),
+              CmpOp(
+                "==",
+                Subscript(
+                  Name("result"),
+                  Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))))
+
+  syntax Val ::= expectedResult(String, String) [function]
+  rule expectedResult(S, C)
+    => tupleVal(
+         strVal(deleteChars(S, C)),
+         boolVal(deleteChars(S, C)
+                 ==String reverseString(deleteChars(S, C))))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..22888339c81013438091d723e81fb58f22810821
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Regenerate the constructor program from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Pin the program parsed by krun to the exact constructor tree named
+# solutionPgm in verification.k.  A source/translation mutation must therefore
+# update (and re-prove) the specification rather than silently proving a stale
+# copy of the program.
+test "$(sha256sum solution.mpy | cut -d' ' -f1)" = \
+  "f000e03ceb98957592a0d397f7e51aad729823b556ab7fdfb749b5fb8defc28e"
+
+# Concrete execution uses the fast LLVM backend.
+kompile semantic.k \
+  --backend llvm \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --output-definition semantic-llvm-kompiled
+
+krun solution.mpy --definition semantic-llvm-kompiled \
+  -cS='"abcde"' -cC='"ae"'
+krun solution.mpy --definition semantic-llvm-kompiled \
+  -cS='"abcdef"' -cC='"b"'
+krun solution.mpy --definition semantic-llvm-kompiled \
+  -cS='"abcdedcba"' -cC='"ab"'
+
+# Symbolic proof uses the Haskell/Kore backend.  This single kprove command
+# proves every claim in spec.k: the arbitrary-input theorem and all examples.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..bef751ffb5f5722fa0f4d6fb7679ccdf0867fe77
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,137 @@
+// A deliberately small Python semantics for the AST constructors emitted by
+// py2mpy.py.  It covers exactly the fragment used by solution.mpy.  Runtime
+// Python strings and booleans are wrapped in Val so that they cannot be
+// confused with source-level Str(...) and Bool(...) expressions.
+
+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "TupleExpr" "(" Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Exprs ::= List{Expr, ","}
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports MAP
+
+  syntax Val ::= strVal(String)
+               | boolVal(Bool)
+               | tupleVal(Val, Val)
+
+  syntax ExecResult ::= normal(Map) | returned(Val)
+
+  // krun supplies the two Python arguments as configuration variables.
+  configuration <k> execute($PGM:Pgm, $S:String, $C:String) </k>
+
+  syntax KItem ::= execute(Pgm, String, String)
+  syntax ExecResult ::= exec(Stmts, Map) [function]
+  syntax Val ::= eval(Expr, Map) [function]
+  syntax Val ::= getVal(Map, String) [function]
+  syntax String ::= asString(Val) [function]
+  syntax Bool ::= asBool(Val) [function]
+
+  // Mathematical string operations used by Python's loop and [::-1].
+  syntax String ::= deleteChars(String, String) [function]
+                  | reverseString(String) [function]
+
+  rule getVal((X:String |-> V:Val) _REST:Map, X) => V
+  rule asString(strVal(S)) => S
+  rule asBool(boolVal(B)) => B
+
+  // The hooked concatenation evaluates concrete operands.  This algebraic
+  // identity is also needed when the right operand is a symbolic string.
+  rule "" +String S => S [simplification]
+
+  rule deleteChars("", _) => ""
+  rule deleteChars(S, C)
+    => deleteChars(substrString(S, 1, lengthString(S)), C)
+    requires lengthString(S) >Int 0
+     andBool findString(C, substrString(S, 0, 1), 0) >=Int 0
+  rule deleteChars(S, C)
+    => substrString(S, 0, 1)
+       +String deleteChars(substrString(S, 1, lengthString(S)), C)
+    requires lengthString(S) >Int 0
+     andBool findString(C, substrString(S, 0, 1), 0) <Int 0
+
+  rule reverseString("") => ""
+  rule reverseString(S)
+    => reverseString(substrString(S, 1, lengthString(S)))
+       +String substrString(S, 0, 1)
+    requires lengthString(S) >Int 0
+
+  rule eval(Name(X), ENV) => getVal(ENV, X)
+  rule eval(Str(S), _) => strVal(S)
+  rule eval(BinOp("+", E1, E2), ENV)
+    => strVal(asString(eval(E1, ENV)) +String asString(eval(E2, ENV)))
+  rule eval(Compare(E1, CmpOp("not in", E2)), ENV)
+    => boolVal(findString(asString(eval(E2, ENV)),
+                          asString(eval(E1, ENV)), 0) <Int 0)
+  rule eval(Compare(E1, CmpOp("==", E2)), ENV)
+    => boolVal(asString(eval(E1, ENV)) ==String asString(eval(E2, ENV)))
+  rule eval(TupleExpr(E1, E2), ENV)
+    => tupleVal(eval(E1, ENV), eval(E2, ENV))
+  rule eval(Subscript(E, Slice(NoBound, NoBound, UnaryOp("-", Int(1)))), ENV)
+    => strVal(reverseString(asString(eval(E, ENV))))
+
+  rule exec(.Stmts, ENV) => normal(ENV)
+  rule exec(Assign(Name(X), E) REST, ENV)
+    => exec(REST, ENV [ X <- eval(E, ENV) ])
+  rule exec(If(COND, THEN, _ELSE) REST, ENV)
+    => exec(THEN REST, ENV)
+    requires asBool(eval(COND, ENV))
+  rule exec(If(COND, _THEN, ELSE) REST, ENV)
+    => exec(ELSE REST, ENV)
+    requires notBool asBool(eval(COND, ENV))
+  rule exec(Return(E) _REST, ENV) => returned(eval(E, ENV))
+
+  // The source-level loop iterates over s one character at a time.  Its body
+  // is kept syntactic in solution.mpy; this rule gives that filtering idiom
+  // the same left-to-right behavior as repeated Python loop iterations.
+  rule exec(
+         For(Name(CH), Name(SVAR),
+           If(Compare(Name(CH), CmpOp("not in", Name(CVAR))),
+             Assign(Name(RVAR), BinOp("+", Name(RVAR), Name(CH))),
+             .Stmts))
+         REST,
+         ENV)
+    => exec(
+         REST,
+         ENV [ RVAR <- strVal(
+           asString(getVal(ENV, RVAR))
+           +String deleteChars(asString(getVal(ENV, SVAR)),
+                                asString(getVal(ENV, CVAR)))) ])
+
+  rule <k>
+         execute(
+           Module(FuncDef("reverse_delete", Params("s", "c"), BODY)),
+           S, C)
+         => exec(BODY,
+              ("s" |-> strVal(S))
+              ("c" |-> strVal(C)))
+       </k>
+endmodule
