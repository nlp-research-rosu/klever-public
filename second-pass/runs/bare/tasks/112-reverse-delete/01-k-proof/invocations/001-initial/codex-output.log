diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..83f8ab9aa4d3cc05de947098ddaa0dba75f62d9f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,110 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional-correctness theorem.  This is the exact constructor
+  // tree in solution.mpy, with only the two input strings left symbolic.
+  claim <k>
+          execute(
+            Module(
+              FuncDef("reverse_delete", Params("s", "c"),
+                Assign(Name("result"), Str(""))
+                For(Name("ch"), Name("s"),
+                  If(Compare(Name("ch"),
+                       CmpOp("not in", Name("c"))),
+                    Assign(Name("result"),
+                      BinOp("+", Name("result"), Name("ch"))),
+                    .Stmts))
+                Return(
+                  TupleExpr(
+                    Name("result"),
+                    Compare(
+                      Name("result"),
+                      CmpOp("==",
+                        Subscript(
+                          Name("result"),
+                          Slice(NoBound, NoBound,
+                            UnaryOp("-", Int(1))))))))))),
+            S, C)
+          => returned(expectedResult(S, C))
+        </k>
+
+  // The prompt examples are separate executable proof claims.  Besides being
+  // useful regression tests, they force the recursive string equations down
+  // both the deleting and retaining branches.
+  claim <k>
+          execute(
+            Module(
+              FuncDef("reverse_delete", Params("s", "c"),
+                Assign(Name("result"), Str(""))
+                For(Name("ch"), Name("s"),
+                  If(Compare(Name("ch"),
+                       CmpOp("not in", Name("c"))),
+                    Assign(Name("result"),
+                      BinOp("+", Name("result"), Name("ch"))),
+                    .Stmts))
+                Return(
+                  TupleExpr(
+                    Name("result"),
+                    Compare(
+                      Name("result"),
+                      CmpOp("==",
+                        Subscript(
+                          Name("result"),
+                          Slice(NoBound, NoBound,
+                            UnaryOp("-", Int(1))))))))))),
+            "abcde", "ae")
+          => returned(tupleVal(strVal("bcd"), boolVal(false)))
+        </k>
+
+  claim <k>
+          execute(
+            Module(
+              FuncDef("reverse_delete", Params("s", "c"),
+                Assign(Name("result"), Str(""))
+                For(Name("ch"), Name("s"),
+                  If(Compare(Name("ch"),
+                       CmpOp("not in", Name("c"))),
+                    Assign(Name("result"),
+                      BinOp("+", Name("result"), Name("ch"))),
+                    .Stmts))
+                Return(
+                  TupleExpr(
+                    Name("result"),
+                    Compare(
+                      Name("result"),
+                      CmpOp("==",
+                        Subscript(
+                          Name("result"),
+                          Slice(NoBound, NoBound,
+                            UnaryOp("-", Int(1))))))))))),
+            "abcdef", "b")
+          => returned(tupleVal(strVal("acdef"), boolVal(false)))
+        </k>
+
+  claim <k>
+          execute(
+            Module(
+              FuncDef("reverse_delete", Params("s", "c"),
+                Assign(Name("result"), Str(""))
+                For(Name("ch"), Name("s"),
+                  If(Compare(Name("ch"),
+                       CmpOp("not in", Name("c"))),
+                    Assign(Name("result"),
+                      BinOp("+", Name("result"), Name("ch"))),
+                    .Stmts))
+                Return(
+                  TupleExpr(
+                    Name("result"),
+                    Compare(
+                      Name("result"),
+                      CmpOp("==",
+                        Subscript(
+                          Name("result"),
+                          Slice(NoBound, NoBound,
+                            UnaryOp("-", Int(1))))))))))),
+            "abcdedcba", "ab")
+          => returned(tupleVal(strVal("cdedc"), boolVal(true)))
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9d4be1725fe19b48059d57e2315a6d7ce4eeec68
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,16 @@
+// Contract vocabulary kept separate from the execution semantics.  The
+// contract says: retain, in order, exactly the characters of s which do not
+// occur in c, and report whether that retained string equals its reversal.
+
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Val ::= expectedResult(String, String) [function]
+  rule expectedResult(S, C)
+    => tupleVal(
+         strVal(deleteChars(S, C)),
+         boolVal(deleteChars(S, C)
+                 ==String reverseString(deleteChars(S, C))))
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module MPY-SYNTAX' in /work
