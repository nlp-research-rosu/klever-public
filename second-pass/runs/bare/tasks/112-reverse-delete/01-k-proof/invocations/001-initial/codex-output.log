+  rule <k>
+         execute(
+           Module(FuncDef("reverse_delete", Params("s", "c"), BODY)),
+           S, C)
+         => exec(BODY,
+              ("s" |-> strVal(S))
+              ("c" |-> strVal(C)))
+       </k>
+endmodule
