index 0000000000000000000000000000000000000000..7a43851c340a55b6951df6db7d63baeaa35fa352
--- /dev/null
+++ b//tmp/audit-work/fresh/audit-specs.k
@@ -0,0 +1,80 @@
+requires "verification.k"
+
+module AUDIT-SPEC-GENERAL
+  imports MODP-VERIFICATION
+  claim <k>
+          Module(FuncDef("modp", Params("n", "p"),
+            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+        => .K
+        </k>
+        <n> N </n>
+        <p> P </p>
+        <formals> noFormals => formals("n", "p") </formals>
+        <result> noResult => result(expectedModp(N, P)) </result>
+    requires (N >=Int 0) andBool (P >Int 0)
+endmodule
+
+module AUDIT-SPEC-EXAMPLE-3-5
+  imports MODP-VERIFICATION
+  claim <k>
+          Module(FuncDef("modp", Params("n", "p"),
+            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+        => .K
+        </k>
+        <n> 3 </n>
+        <p> 5 </p>
+        <formals> noFormals => formals("n", "p") </formals>
