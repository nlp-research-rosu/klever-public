diff --git a/evidence/05_body-mutation.k b/evidence/05_body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..6b5c8df669c27db6fa0f5e06b75a30116aee24ad
--- /dev/null
+++ b/evidence/05_body-mutation.k
@@ -0,0 +1,17 @@
+requires "verification.k"
+
+module AUDIT-BODY-MUTATION
+  imports MODP-VERIFICATION
+
+  // Body sensitivity witness: the base is changed from 2 to 3.
+  // At n = 1 and p = 5 the mutated execution returns 3, not 2.
+  claim <k>
+          Module(FuncDef("modp", Params("n", "p"),
+            Return(Call(Name("pow"), Int(3), Name("n"), Name("p")))))
+        => .K
+        </k>
+        <n> 1 </n>
+        <p> 5 </p>
+        <formals> noFormals => formals("n", "p") </formals>
+        <result> noResult => result(2) </result>
+endmodule
diff --git a/evidence/06_spec-vacuity.k b/evidence/06_spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..543643de4d15321ca6dd5120b178b78653d36393
--- /dev/null
+++ b/evidence/06_spec-vacuity.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY
+  imports MODP-VERIFICATION
+
+  // Fresh off-by-one mutation of the result-constraining general obligation.
+  // The precondition is satisfiable, for example at N = 3 and P = 5, where
+  // execution returns 3 but this destination requires 4.
+  claim <k>
+          Module(FuncDef("modp", Params("n", "p"),
+            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+        => .K
+        </k>
+        <n> N </n>
+        <p> P </p>
+        <formals> noFormals => formals("n", "p") </formals>
+        <result>
+          noResult => result(expectedModp(N, P) +Int 1)
+        </result>
+    requires (N >=Int 0) andBool (P >Int 0)
+endmodule

