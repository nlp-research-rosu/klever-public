status="'$?
printf '"'[exit %d]\\n' \""'$status" >> /audit-output/evidence/02_intent_oracle.log
printf '"'intent_oracle_exit=%s\\n' \""'$status"
cat /audit-output/evidence/02_intent_oracle.log' in /audit-output
