+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m doctest -v prompt.py
+python3 - <<'PY'
+from solution import modp
+
+assert modp(3, 5) == 3
+assert modp(1101, 101) == 2
+assert modp(0, 101) == 1
+assert modp(3, 11) == 8
+assert modp(100, 101) == 1
+PY
+
+kompile verification.k \
+  --backend haskell \
+  --main-module MODP-VERIFICATION \
+  --syntax-module MODP-SYNTAX
+
+krun solution.mpy --definition verification-kompiled -cN=3 -cP=5
+krun solution.mpy --definition verification-kompiled -cN=1101 -cP=101
+krun solution.mpy --definition verification-kompiled -cN=0 -cP=101
+krun solution.mpy --definition verification-kompiled -cN=3 -cP=11
+krun solution.mpy --definition verification-kompiled -cN=100 -cP=101
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MODP-SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6bd8d21479fa3cdc313a927e45c7b8b886869d84
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,53 @@
+module MODP-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "Call" "(" Expr "," Expr "," Expr "," Expr ")"
+
+  syntax Params ::= "Params" "(" String "," String ")"
+
+  syntax Stmt ::= "Return" "(" Expr ")"
+                | "FuncDef" "(" String "," Params "," Stmt ")"
+
+  syntax Program ::= "Module" "(" Stmt ")"
+endmodule
+
+module MODP-SEMANTIC
+  imports MODP-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax Formals ::= "noFormals" | formals(String, String)
+  syntax Result ::= "noResult" | result(Int)
+
+  configuration
+    <modp>
+      <k> $PGM:Program </k>
+      <n> $N:Int </n>
+      <p> $P:Int </p>
+      <formals> noFormals </formals>
+      <result> noResult </result>
+    </modp>
+
+  syntax Int ::= evalInt(Expr, String, String, Int, Int) [function]
+
+  rule evalInt(Int(I), X, Y, N, P) => I
+  rule evalInt(Name(X), X, Y, N, P) => N
+  rule evalInt(Name(Y), X, Y, N, P) => P
+    requires X =/=String Y
+  rule evalInt(Call(Name("pow"), BASE, EXP, MOD), X, Y, N, P)
+    => evalInt(BASE, X, Y, N, P)
+       ^%Int evalInt(EXP, X, Y, N, P)
+             evalInt(MOD, X, Y, N, P)
+
+  rule <k> Module(FuncDef(F, Params(X, Y), BODY)) => BODY </k>
+       <formals> noFormals => formals(X, Y) </formals>
+
+  rule <k> Return(E) => .K </k>
+       <n> N </n>
+       <p> P </p>
+       <formals> formals(X, Y) </formals>
+       <result> noResult => result(evalInt(E, X, Y, N, P)) </result>
+endmodule
