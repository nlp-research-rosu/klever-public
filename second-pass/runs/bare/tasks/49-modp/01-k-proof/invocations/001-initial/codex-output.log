codex
I’m using Python’s three-argument `pow(2, n, p)`: it is the efficient arbitrary-precision modular-exponentiation operation the prompt is hinting at. The K model will still interpret the translated AST (module, function definition, parameters, return, names, literals, and the built-in call) and the main claim will quantify over all `n ≥ 0` and `p > 0`.
apply patch
patch: completed
/work/prove.sh
/work/semantic.k
/work/solution.py
/work/spec.k
/work/verification.k
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8d6746d85c05f70ee83c0c0a1da94c37821511ca
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m doctest -v prompt.py
+python3 - <<'PY'
+from solution import modp
+
+assert modp(3, 5) == 3
+assert modp(1101, 101) == 2
+assert modp(0, 101) == 1
+assert modp(3, 11) == 8
+assert modp(100, 101) == 1
+PY
+
+kompile verification.k \
+  --backend haskell \
+  --main-module MODP-VERIFICATION \
+  --syntax-module MODP-SYNTAX
+
+krun solution.mpy --definition verification-kompiled -cN=3 -cP=5
+krun solution.mpy --definition verification-kompiled -cN=1101 -cP=101
+krun solution.mpy --definition verification-kompiled -cN=0 -cP=101
+krun solution.mpy --definition verification-kompiled -cN=3 -cP=11
+krun solution.mpy --definition verification-kompiled -cN=100 -cP=101
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MODP-SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..795818a3b1f99751ac2d3c393abb77f286ec4c8a
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,52 @@
+module MODP-SYNTAX
+  imports INT-SYNTAX
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "Call" "(" Expr "," Expr "," Expr "," Expr ")"
+
+  syntax Params ::= "Params" "(" String "," String ")"
+
+  syntax Stmt ::= "Return" "(" Expr ")"
+                | "FuncDef" "(" String "," Params "," Stmt ")"
+
+  syntax Program ::= "Module" "(" Stmt ")"
+endmodule
+
+module MODP-SEMANTIC
+  imports MODP-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax Formals ::= noFormals | formals(String, String)
+  syntax Result ::= noResult | result(Int)
+
+  configuration
+    <modp>
+      <k> $PGM:Program </k>
+      <n> $N:Int </n>
+      <p> $P:Int </p>
+      <formals> noFormals </formals>
+      <result> noResult </result>
+    </modp>
+
+  syntax Int ::= evalInt(Expr, String, String, Int, Int) [function]
+
+  rule evalInt(Int(I), X, Y, N, P) => I
+  rule evalInt(Name(X), X, Y, N, P) => N
+  rule evalInt(Name(Y), X, Y, N, P) => P
+    requires X =/=String Y
+  rule evalInt(Call(Name("pow"), BASE, EXP, MOD), X, Y, N, P)
+    => evalInt(BASE, X, Y, N, P)
+       ^%Int evalInt(EXP, X, Y, N, P)
+             evalInt(MOD, X, Y, N, P)
+
+  rule <k> Module(FuncDef(F, Params(X, Y), BODY)) => BODY </k>
+       <formals> noFormals => formals(X, Y) </formals>
+
+  rule <k> Return(E) => .K </k>
+       <n> N </n>
+       <p> P </p>
+       <formals> formals(X, Y) </formals>
+       <result> noResult => result(evalInt(E, X, Y, N, P)) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..e4273d31ab02746128b11d06351248760d712841
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def modp(n: int, p: int):
+    return pow(2, n, p)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c33eea69370ed5d602588ce2b9cd0afa91deae54
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,126 @@
+requires "verification.k"
+
+module MODP-SPEC
+  imports MODP-VERIFICATION
+
+  claim
+    <modp>
+      <k>
+        Module(FuncDef("modp", Params("n", "p"),
+          Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+      </k>
+      <n> N </n>
+      <p> P </p>
+      <formals> noFormals </formals>
+      <result> noResult </result>
+    </modp>
+  =>
+    <modp>
+      <k> .K </k>
+      <n> N </n>
+      <p> P </p>
+      <formals> formals("n", "p") </formals>
+      <result> result(expectedModp(N, P)) </result>
+    </modp>
+    requires N >=Int 0 andBool P >Int 0
+
+  claim
+    <modp>
+      <k>
+        Module(FuncDef("modp", Params("n", "p"),
+          Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+      </k>
+      <n> 3 </n>
+      <p> 5 </p>
+      <formals> noFormals </formals>
+      <result> noResult </result>
+    </modp>
+  =>
+    <modp>
+      <k> .K </k>
+      <n> 3 </n>
+      <p> 5 </p>
+      <formals> formals("n", "p") </formals>
+      <result> result(3) </result>
+    </modp>
+
+  claim
+    <modp>
+      <k>
+        Module(FuncDef("modp", Params("n", "p"),
+          Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+      </k>
+      <n> 1101 </n>
+      <p> 101 </p>
+      <formals> noFormals </formals>
+      <result> noResult </result>
+    </modp>
+  =>
+    <modp>
+      <k> .K </k>
+      <n> 1101 </n>
+      <p> 101 </p>
+      <formals> formals("n", "p") </formals>
+      <result> result(2) </result>
+    </modp>
+
+  claim
+    <modp>
+      <k>
+        Module(FuncDef("modp", Params("n", "p"),
+          Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+      </k>
+      <n> 0 </n>
+      <p> 101 </p>
+      <formals> noFormals </formals>
+      <result> noResult </result>
+    </modp>
+  =>
+    <modp>
+      <k> .K </k>
+      <n> 0 </n>
+      <p> 101 </p>
+      <formals> formals("n", "p") </formals>
+      <result> result(1) </result>
+    </modp>
+
+  claim
+    <modp>
+      <k>
+        Module(FuncDef("modp", Params("n", "p"),
+          Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+      </k>
+      <n> 3 </n>
+      <p> 11 </p>
