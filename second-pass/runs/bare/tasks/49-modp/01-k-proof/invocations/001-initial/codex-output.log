+      <p> 101 </p>
+      <formals> formals("n", "p") </formals>
+      <result> result(1) </result>
+    </modp>
+
+  claim
+    <modp>
+      <k>
+        Module(FuncDef("modp", Params("n", "p"),
+          Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+      </k>
+      <n> 3 </n>
+      <p> 11 </p>
+      <formals> noFormals </formals>
+      <result> noResult </result>
+    </modp>
+  =>
+    <modp>
+      <k> .K </k>
+      <n> 3 </n>
+      <p> 11 </p>
+      <formals> formals("n", "p") </formals>
+      <result> result(8) </result>
+    </modp>
+
+  claim
+    <modp>
+      <k>
+        Module(FuncDef("modp", Params("n", "p"),
+          Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
+      </k>
+      <n> 100 </n>
+      <p> 101 </p>
+      <formals> noFormals </formals>
+      <result> noResult </result>
+    </modp>
+  =>
+    <modp>
+      <k> .K </k>
+      <n> 100 </n>
+      <p> 101 </p>
+      <formals> formals("n", "p") </formals>
+      <result> result(1) </result>
+    </modp>
+endmodule
