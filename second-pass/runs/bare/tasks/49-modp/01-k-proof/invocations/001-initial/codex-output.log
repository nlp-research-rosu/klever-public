module MODP-SYNTAX
  imports INT-SYNTAX
  imports STRING-SYNTAX

  syntax Expr ::= "Int" "(" Int ")"
                | "Name" "(" String ")"
                | "Call" "(" Expr "," Expr "," Expr "," Expr ")"

  syntax Params ::= "Params" "(" String "," String ")"

  syntax Stmt ::= "Return" "(" Expr ")"
                | "FuncDef" "(" String "," Params "," Stmt ")"

  syntax Program ::= "Module" "(" Stmt ")"
endmodule

module MODP-SEMANTIC
  imports MODP-SYNTAX
  imports BOOL
  imports INT
  imports STRING

  syntax Formals ::= "noFormals" | formals(String, String)
  syntax Result ::= "noResult" | result(Int)

  configuration
    <modp>
      <k> $PGM:Program </k>
      <n> $N:Int </n>
      <p> $P:Int </p>
      <formals> noFormals </formals>
      <result> noResult </result>
    </modp>

  syntax Int ::= evalInt(Expr, String, String, Int, Int) [function]

  rule evalInt(Int(I), _X, _Y, _N, _P) => I
  rule evalInt(Name(X), X, _Y, N, _P) => N
  rule evalInt(Name(Y), X, Y, _N, P) => P
    requires X =/=String Y
  rule evalInt(Call(Name("pow"), BASE, EXP, MOD), X, Y, N, P)
    => evalInt(BASE, X, Y, N, P)
       ^%Int evalInt(EXP, X, Y, N, P)
             evalInt(MOD, X, Y, N, P)

  rule <k> Module(FuncDef(_F, Params(X, Y), BODY)) => BODY </k>
       <formals> noFormals => formals(X, Y) </formals>

  rule <k> Return(E) => .K </k>
       <n> N </n>
       <p> P </p>
       <formals> formals(X, Y) </formals>
       <result> noResult => result(evalInt(E, X, Y, N, P)) </result>
endmodule
requires "semantic.k"

module MODP-VERIFICATION
  imports MODP-SEMANTIC

  // The mathematical contract, using K's unbounded-integer modular power.
  syntax Int ::= expectedModp(Int, Int) [function]
  rule expectedModp(N, P) => 2 ^%Int N P
endmodule
requires "verification.k"

module MODP-SPEC
  imports MODP-VERIFICATION

  // General functional correctness on the task's natural modular-arithmetic
  // domain: every nonnegative exponent and every positive modulus.
  claim <k>
          Module(FuncDef("modp", Params("n", "p"),
            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
        => .K
        </k>
        <n> N </n>
        <p> P </p>
        <formals> noFormals => formals("n", "p") </formals>
        <result> noResult => result(expectedModp(N, P)) </result>
    requires (N >=Int 0) andBool (P >Int 0)

  // The five examples from prompt.py are also independent ground claims.
  claim <k>
          Module(FuncDef("modp", Params("n", "p"),
            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
        => .K
        </k>
        <n> 3 </n>
        <p> 5 </p>
        <formals> noFormals => formals("n", "p") </formals>
        <result> noResult => result(3) </result>

  claim <k>
          Module(FuncDef("modp", Params("n", "p"),
            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
        => .K
        </k>
        <n> 1101 </n>
        <p> 101 </p>
        <formals> noFormals => formals("n", "p") </formals>
        <result> noResult => result(2) </result>

  claim <k>
          Module(FuncDef("modp", Params("n", "p"),
            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
        => .K
        </k>
        <n> 0 </n>
        <p> 101 </p>
        <formals> noFormals => formals("n", "p") </formals>
        <result> noResult => result(1) </result>

  claim <k>
          Module(FuncDef("modp", Params("n", "p"),
            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
        => .K
        </k>
        <n> 3 </n>
        <p> 11 </p>
        <formals> noFormals => formals("n", "p") </formals>
        <result> noResult => result(8) </result>

  claim <k>
          Module(FuncDef("modp", Params("n", "p"),
            Return(Call(Name("pow"), Int(2), Name("n"), Name("p")))))
        => .K
        </k>
        <n> 100 </n>
        <p> 101 </p>
        <formals> noFormals => formals("n", "p") </formals>
        <result> noResult => result(1) </result>
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 - <<'PY'
from solution import modp

assert modp(3, 5) == 3
assert modp(1101, 101) == 2
assert modp(0, 101) == 1
assert modp(3, 11) == 8
assert modp(100, 101) == 1
PY

kompile verification.k \
  --backend haskell \
  --main-module MODP-VERIFICATION \
  --syntax-module MODP-SYNTAX

krun solution.mpy --definition verification-kompiled -cN=3 -cP=5
krun solution.mpy --definition verification-kompiled -cN=1101 -cP=101
krun solution.mpy --definition verification-kompiled -cN=0 -cP=101
krun solution.mpy --definition verification-kompiled -cN=3 -cP=11
krun solution.mpy --definition verification-kompiled -cN=100 -cP=101

kprove spec.k \
  --definition verification-kompiled \
  --spec-module MODP-SPEC

