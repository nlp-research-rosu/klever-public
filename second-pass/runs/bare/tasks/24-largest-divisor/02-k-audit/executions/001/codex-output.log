+  cp "${tmp_log}" "${log_path}"
+else
+  {
+    sed -n '1,260p' "${tmp_log}"
+    printf '... OMITTED %d INTERIOR LINES ...\n' "$((line_count - 500))"
+    tail -n 240 "${tmp_log}"
+  } >"${log_path}"
+fi
+
+unlink "${tmp_log}"
+exit "${command_status}"
