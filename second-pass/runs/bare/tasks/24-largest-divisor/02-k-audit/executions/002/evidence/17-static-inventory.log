COMMAND: bash -lc for\ f\ in\ semantic.k\ verification.k\ spec.k\;\ do\ echo\ \"FILE=\$f\"\;\ rg\ -n\ \"\^\[\[:space:\]\]\*\(syntax\|configuration\|rule\|claim\|imports\|requires\|module\|endmodule\)\"\ \"\$f\"\;\ done\;\ echo\ ATTRIBUTES\;\ rg\ -n\ \"\\\[\(function\|total\|functional\|simplification\|concrete\|priority\|owise\|symbol\|strict\|seqstrict\)\"\ semantic.k\ verification.k\ spec.k\ \|\|\ true\;\ echo\ USED_CONSTRUCTORS\;\ sed\ -n\ \"1\,120p\"\ solution.mpy
WORKDIR: /tmp/audit-work/src
--- OUTPUT ---
FILE=semantic.k
1:module MPY-SYNTAX
2:  imports INT-SYNTAX
3:  imports STRING-SYNTAX
8:  syntax Pgm    ::= "Module" "(" Stmts ")"                     [symbol(Module)]
9:  syntax Params ::= "Params" "(" String ")"                    [symbol(Params)]
10:  syntax Expr   ::= "Int" "(" Int ")"                          [symbol(IntExpr)]
14:  syntax CmpOp  ::= "CmpOp" "(" String "," Expr ")"           [symbol(CmpOp)]
15:  syntax Stmt   ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
20:  syntax Stmts ::= List{Stmt, ""}
21:endmodule
23:module MPY
24:  imports MPY-SYNTAX
25:  imports BOOL
26:  imports INT
27:  imports MAP
29:  syntax KItem ::= "noResult"
31:  configuration
40:  syntax Int ::= envInt(Map, String) [function]
41:  rule envInt(ENV, X) => {ENV [ X ]}:>Int
43:  syntax Int ::= evalInt(Expr, Map) [function]
44:  rule evalInt(Int(I),             _)   => I
45:  rule evalInt(Name(X),            ENV) => envInt(ENV, X)
46:  rule evalInt(BinOp("-", A, B),   ENV) => evalInt(A, ENV) -Int  evalInt(B, ENV)
47:  rule evalInt(BinOp("%", A, B),   ENV) => evalInt(A, ENV) modInt evalInt(B, ENV)
49:  syntax Bool ::= evalBool(Expr, Map) [function]
50:  rule evalBool(Compare(A, CmpOp("!=", B)), ENV)
52:  rule evalBool(Compare(A, CmpOp("==", B)), ENV)
54:  rule evalBool(Compare(A, CmpOp(">", B)), ENV)
59:  rule <k> Module(FuncDef(_, Params(P), BODY)) => BODY ... </k>
63:  rule <k> S:Stmt REST:Stmts => S ~> REST ... </k>
64:  rule <k> .Stmts => .K ... </k>
66:  rule <k> Assign(Name(X), E) => .K ... </k>
72:  syntax KItem ::= "whileBranch" "(" Expr "," Stmts ")"
73:  rule <k> While(COND, BODY) => evalBool(COND, ENV) ~> whileBranch(COND, BODY) ... </k>
75:  rule <k> true  ~> whileBranch(COND, BODY) => BODY ~> While(COND, BODY) ... </k>
76:  rule <k> false ~> whileBranch(_, _) => .K ... </k>
78:  syntax KItem ::= "branch" "(" Stmts "," Stmts ")"
79:  rule <k> If(COND, THEN, ELSE) => evalBool(COND, ENV) ~> branch(THEN, ELSE) ... </k>
81:  rule <k> true  ~> branch(THEN, _) => THEN ... </k>
82:  rule <k> false ~> branch(_, ELSE) => ELSE ... </k>
84:  rule <k> Return(E) ~> _:K => .K </k>
87:endmodule
FILE=verification.k
1:requires "semantic.k"
3:module VERIFICATION
4:  imports MPY
8:  syntax Bool ::= noDivisorFrom(Int, Int, Int) [function]
9:  rule noDivisorFrom(_, LO, HI) => true
10:    requires LO >Int HI
11:  rule noDivisorFrom(N, LO, HI)
13:    requires LO <=Int HI
15:  syntax Bool ::= isLargestThrough(Int, Int, Int) [function]
16:  rule isLargestThrough(N, D, UPPER)
22:  syntax Bool ::= isLargestProperDivisor(Int, Int) [function]
23:  rule isLargestProperDivisor(N, D)
25:endmodule
FILE=spec.k
1:requires "verification.k"
3:module SPEC
4:  imports VERIFICATION
