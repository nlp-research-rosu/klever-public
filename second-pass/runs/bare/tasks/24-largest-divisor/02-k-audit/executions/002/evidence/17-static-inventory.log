semantic.k:14:  syntax CmpOp  ::= "CmpOp" "(" String "," Expr ")"           [symbol(CmpOp)]
semantic.k:15:  syntax Stmt   ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
semantic.k:16:                  | "Assign" "(" Expr "," Expr ")"             [symbol(Assign)]
semantic.k:17:                  | "While" "(" Expr "," Stmts ")"             [symbol(While)]
semantic.k:18:                  | "If" "(" Expr "," Stmts "," Stmts ")"      [symbol(If)]
