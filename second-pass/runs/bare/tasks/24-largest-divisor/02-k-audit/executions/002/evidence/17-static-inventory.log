semantic.k:40:  syntax Int ::= envInt(Map, String) [function]
semantic.k:43:  syntax Int ::= evalInt(Expr, Map) [function]
semantic.k:49:  syntax Bool ::= evalBool(Expr, Map) [function]
USED_CONSTRUCTORS
Module(
  FuncDef("largest_divisor", Params("n"),
    Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
    While(Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
      Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
    Return(Name("divisor"))))
