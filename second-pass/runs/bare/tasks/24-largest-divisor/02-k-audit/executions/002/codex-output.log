@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+mkdir -p "$(dirname "$log")"
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
