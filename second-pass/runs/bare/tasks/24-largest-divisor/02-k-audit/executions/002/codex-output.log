+
+
+path = Path("/generation-evidence/codex-output.log")
+raw = path.read_bytes()
+text = raw.decode("utf-8", errors="replace")
+lines = text.splitlines()
+needles = (
+    "kprove",
+    "#Top",
+    "WarnStuckClaimState",
+    "RESULT:",
