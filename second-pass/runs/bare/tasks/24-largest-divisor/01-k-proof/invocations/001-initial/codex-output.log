+
+  // Independent executable contract: inspect candidates downward, returning
+  // the first positive divisor.  Because candidates are visited in descending
+  // order, largestBelow(N, N - 1) is the largest divisor below N.
+  syntax Int ::= largestBelow(Int, Int) [function]
