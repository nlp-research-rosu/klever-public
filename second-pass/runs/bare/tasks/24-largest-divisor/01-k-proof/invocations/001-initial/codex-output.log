diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5970feb373be9e0d0df10a6ae42b6c62c4132c47
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity: starting at any positive candidate D, the
+  // concrete loop and return compute the same descending-search result.
+  claim [largest-divisor-loop]:
+    <k>
+      While(
+        Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
+        Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
+      ~> (Return(Name("divisor")) .Stmts)
+      ~> .K
+    => .K
+    </k>
+    <arg> N </arg>
+    <env>
+      ("n" |-> N) ("divisor" |-> D)
+    => ("n" |-> N) ("divisor" |-> largestBelow(N, D))
+    </env>
+    <result> noResult => largestBelow(N, D) </result>
+    requires N >Int 1 andBool D >Int 0
+
+  // End-to-end claim over the exact constructor tree in solution.mpy.
+  claim [largest-divisor-correct]:
+    <k>
+      Module(
+        FuncDef("largest_divisor", Params("n"),
+          Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
+          While(
+            Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
+            Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
+          Return(Name("divisor"))))
+    => .K
+    </k>
+    <arg> N </arg>
+    <env>
+      .Map
+    => ("n" |-> N) ("divisor" |-> largestBelow(N, N -Int 1))
+    </env>
+    <result> noResult => largestBelow(N, N -Int 1) </result>
+    requires N >Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9cdf7db7e0bcc70a64696b553459c68856bbb3cc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,14 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Independent executable contract: inspect candidates downward, returning
+  // the first positive divisor.  Because candidates are visited in descending
+  // order, largestBelow(N, N - 1) is the largest divisor below N.
+  syntax Int ::= largestBelow(Int, Int) [function]
+  rule largestBelow(N, D) => D
+    requires D >Int 0 andBool N modInt D ==Int 0
+  rule largestBelow(N, D) => largestBelow(N, D -Int 1)
+    requires D >Int 0 andBool N modInt D =/=Int 0
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..543bc554d4fdaa964a37e7937327113fb5cf18f8
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,80 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The concrete constructor syntax emitted by py2mpy.py for the subset used
+  // by solution.py.  Statement lists use juxtaposition, exactly as the
+  // translator prints them.
+  syntax Pgm    ::= "Module" "(" Stmts ")"                     [symbol(Module)]
+  syntax Params ::= "Params" "(" String ")"                    [symbol(Params)]
+  syntax Expr   ::= "Int" "(" Int ")"                          [symbol(IntExpr)]
+                  | "Name" "(" String ")"                      [symbol(Name)]
+                  | "BinOp" "(" String "," Expr "," Expr ")" [symbol(BinOp)]
+                  | "Compare" "(" Expr "," CmpOp ")"          [symbol(Compare)]
+  syntax CmpOp  ::= "CmpOp" "(" String "," Expr ")"           [symbol(CmpOp)]
+  syntax Stmt   ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                  | "Assign" "(" Expr "," Expr ")"             [symbol(Assign)]
+                  | "While" "(" Expr "," Stmts ")"             [symbol(While)]
+                  | "If" "(" Expr "," Stmts "," Stmts ")"      [symbol(If)]
+                  | "Return" "(" Expr ")"                       [symbol(Return)]
+  syntax Stmts ::= List{Stmt, ""}
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports MAP
+
+  syntax KItem ::= "noResult"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <arg> $ARG:Int </arg>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+
+  // Environment lookup and expression evaluation are semantic functions.
+  syntax Int ::= envInt(Map, String) [function]
+  rule envInt(ENV, X) => {ENV [ X ]}:>Int
+
+  syntax Int ::= evalInt(Expr, Map) [function]
+  rule evalInt(Int(I),             _)   => I
+  rule evalInt(Name(X),            ENV) => envInt(ENV, X)
+  rule evalInt(BinOp("-", A, B),   ENV) => evalInt(A, ENV) -Int  evalInt(B, ENV)
+  rule evalInt(BinOp("%", A, B),   ENV) => evalInt(A, ENV) modInt evalInt(B, ENV)
+
+  syntax Bool ::= evalBool(Expr, Map) [function]
+  rule evalBool(Compare(A, CmpOp("!=", B)), ENV)
+    => evalInt(A, ENV) =/=Int evalInt(B, ENV)
+  rule evalBool(Compare(A, CmpOp("==", B)), ENV)
+    => evalInt(A, ENV) ==Int evalInt(B, ENV)
+  rule evalBool(Compare(A, CmpOp(">", B)), ENV)
+    => evalInt(A, ENV) >Int evalInt(B, ENV)
+
+  // A module containing one entry point is invoked with the configured
+  // integer argument.  The remaining rules are ordinary small-step rules.
+  rule <k> Module(FuncDef(_, Params(P), BODY)) => BODY ... </k>
+       <arg> N </arg>
+       <env> .Map => P |-> N </env>
+
+  rule <k> S:Stmt REST:Stmts => S ~> REST ... </k>
+  rule <k> .Stmts => . ... </k>
+
+  rule <k> Assign(Name(X), E) => . ... </k>
+       <env> ENV => ENV [ X <- evalInt(E, ENV) ] </env>
+
+  rule <k> While(COND, BODY) => If(COND, BODY While(COND, BODY), .Stmts) ... </k>
+
+  syntax KItem ::= "branch" "(" Stmts "," Stmts ")"
+  rule <k> If(COND, THEN, ELSE) => evalBool(COND, ENV) ~> branch(THEN, ELSE) ... </k>
+       <env> ENV </env>
+  rule <k> true  ~> branch(THEN, _) => THEN ... </k>
+  rule <k> false ~> branch(_, ELSE) => ELSE ... </k>
+
+  rule <k> Return(E) ~> _:K => .K </k>
+       <env> ENV </env>
+       <result> noResult => evalInt(E, ENV) </result>
+endmodule
