diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1e89c2810d002ee5cb0a06986a62e1e3bfaa70d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,34 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Independent executable contract: inspect candidates downward, returning
+  // the first positive divisor.  Because candidates are visited in descending
+  // order, largestBelow(N, N - 1) is the largest divisor below N.
+  syntax Int ::= largestBelow(Int, Int) [function]
+  rule largestBelow(N, D) => D
+    requires D >Int 0 andBool N modInt D ==Int 0
+  rule largestBelow(N, D) => largestBelow(N, D -Int 1)
+    requires D >Int 0 andBool N modInt D =/=Int 0
+
+  // Declarative maximality check over a finite interval.  It says that every
+  // candidate from LO through HI fails to divide N.
+  syntax Bool ::= noDivisorFrom(Int, Int, Int) [function]
+  rule noDivisorFrom(_, LO, HI) => true
+    requires LO >Int HI
+  rule noDivisorFrom(N, LO, HI)
+    => (N modInt LO =/=Int 0) andBool noDivisorFrom(N, LO +Int 1, HI)
+    requires LO <=Int HI
+
+  syntax Bool ::= isLargestThrough(Int, Int, Int) [function]
+  rule isLargestThrough(N, D, UPPER)
+    => D >Int 0
+       andBool D <=Int UPPER
+       andBool N modInt D ==Int 0
+       andBool noDivisorFrom(N, D +Int 1, UPPER)
+
+  syntax Bool ::= isLargestProperDivisor(Int, Int) [function]
+  rule isLargestProperDivisor(N, D)
+    => D <Int N andBool isLargestThrough(N, D, N -Int 1)
+endmodule

