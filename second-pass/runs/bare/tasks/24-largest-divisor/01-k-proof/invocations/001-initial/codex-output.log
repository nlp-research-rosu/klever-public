diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5970feb373be9e0d0df10a6ae42b6c62c4132c47
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity: starting at any positive candidate D, the
+  // concrete loop and return compute the same descending-search result.
+  claim [largest-divisor-loop]:
+    <k>
+      While(
+        Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
+        Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
+      ~> (Return(Name("divisor")) .Stmts)
+      ~> .K
+    => .K
+    </k>
+    <arg> N </arg>
+    <env>
+      ("n" |-> N) ("divisor" |-> D)
+    => ("n" |-> N) ("divisor" |-> largestBelow(N, D))
+    </env>
+    <result> noResult => largestBelow(N, D) </result>
+    requires N >Int 1 andBool D >Int 0
+
+  // End-to-end claim over the exact constructor tree in solution.mpy.
+  claim [largest-divisor-correct]:
+    <k>
+      Module(
+        FuncDef("largest_divisor", Params("n"),
+          Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
+          While(
+            Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
+            Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
+          Return(Name("divisor"))))
+    => .K
+    </k>
+    <arg> N </arg>
+    <env>
+      .Map
+    => ("n" |-> N) ("divisor" |-> largestBelow(N, N -Int 1))
+    </env>
+    <result> noResult => largestBelow(N, N -Int 1) </result>
+    requires N >Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9cdf7db7e0bcc70a64696b553459c68856bbb3cc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,14 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Independent executable contract: inspect candidates downward, returning
+  // the first positive divisor.  Because candidates are visited in descending
+  // order, largestBelow(N, N - 1) is the largest divisor below N.
+  syntax Int ::= largestBelow(Int, Int) [function]
+  rule largestBelow(N, D) => D
+    requires D >Int 0 andBool N modInt D ==Int 0
+  rule largestBelow(N, D) => largestBelow(N, D -Int 1)
+    requires D >Int 0 andBool N modInt D =/=Int 0
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX' in /work
