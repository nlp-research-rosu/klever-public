--- /dev/null
+++ b/spec.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity: starting at any positive candidate D, the
+  // concrete loop and return compute the same descending-search result.
+  claim [largest-divisor-loop]:
+    <k>
+      While(
+        Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
+        Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
+      ~> (Return(Name("divisor")) .Stmts)
+      ~> .K
+    => .K
+    </k>
+    <arg> N </arg>
+    <env>
+      ("n" |-> N) ("divisor" |-> D)
+    => ("n" |-> N) ("divisor" |-> largestBelow(N, D))
+    </env>
+    <result> noResult => largestBelow(N, D) </result>
+    requires N >Int 1 andBool D >Int 0
+
+  // A descending search result is not merely some divisor: assuming all
+  // already-skipped candidates above D are non-divisors, it satisfies the
+  // declarative greatest-divisor predicate through UPPER.
+  claim [descending-search-is-largest]:
+    isLargestThrough(N, largestBelow(N, D), UPPER)
+    => true
+    requires N >Int 1
+         andBool D >Int 0
+         andBool D <=Int UPPER
+         andBool UPPER <Int N
+         andBool noDivisorFrom(N, D +Int 1, UPPER)
+
+  claim [largest-below-satisfies-contract]:
+    isLargestProperDivisor(N, largestBelow(N, N -Int 1))
+    => true
+    requires N >Int 1
+
+  // End-to-end claim over the exact constructor tree in solution.mpy.
+  claim [largest-divisor-correct]:
+    <k>
+      Module(
+        FuncDef("largest_divisor", Params("n"),
+          Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
+          While(
+            Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
+            Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
+          Return(Name("divisor"))))
+    => .K
+    </k>
+    <arg> N </arg>
+    <env>
+      .Map
+    => ("n" |-> N) ("divisor" |-> largestBelow(N, N -Int 1))
+    </env>
+    <result> noResult => largestBelow(N, N -Int 1) </result>
+    requires N >Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1e89c2810d002ee5cb0a06986a62e1e3bfaa70d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,34 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Independent executable contract: inspect candidates downward, returning
+  // the first positive divisor.  Because candidates are visited in descending
+  // order, largestBelow(N, N - 1) is the largest divisor below N.
+  syntax Int ::= largestBelow(Int, Int) [function]
+  rule largestBelow(N, D) => D
+    requires D >Int 0 andBool N modInt D ==Int 0
+  rule largestBelow(N, D) => largestBelow(N, D -Int 1)
+    requires D >Int 0 andBool N modInt D =/=Int 0
+
+  // Declarative maximality check over a finite interval.  It says that every
+  // candidate from LO through HI fails to divide N.
+  syntax Bool ::= noDivisorFrom(Int, Int, Int) [function]
+  rule noDivisorFrom(_, LO, HI) => true
+    requires LO >Int HI
+  rule noDivisorFrom(N, LO, HI)
+    => (N modInt LO =/=Int 0) andBool noDivisorFrom(N, LO +Int 1, HI)
+    requires LO <=Int HI
+
+  syntax Bool ::= isLargestThrough(Int, Int, Int) [function]
+  rule isLargestThrough(N, D, UPPER)
+    => D >Int 0
+       andBool D <=Int UPPER
+       andBool N modInt D ==Int 0
+       andBool noDivisorFrom(N, D +Int 1, UPPER)
+
+  syntax Bool ::= isLargestProperDivisor(Int, Int) [function]
+  rule isLargestProperDivisor(N, D)
+    => D <Int N andBool isLargestThrough(N, D, N -Int 1)
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX && timeout 60s kprove spec.k --definition verification-kompiled --spec-module SPEC --output pretty' in /work
