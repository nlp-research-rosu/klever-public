+                  | "If" "(" Expr "," Stmts "," Stmts ")"      [symbol(If)]
+                  | "Return" "(" Expr ")"                       [symbol(Return)]
+  syntax Stmts ::= List{Stmt, ""}
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports MAP
+
+  syntax KItem ::= "noResult"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <arg> $ARG:Int </arg>
+      <env> .Map </env>
+      <result> noResult </result>
