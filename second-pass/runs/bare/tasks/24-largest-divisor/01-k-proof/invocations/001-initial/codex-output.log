+    while n % divisor != 0:
+        divisor = divisor - 1
+    return divisor
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d3d76e3351782bed602247336c9813dc74443737
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Direct loop contract.  The precondition records that candidates already
+  // skipped above D are non-divisors; the existential result must satisfy the
+  // declarative natural-language contract.
+  claim [largest-divisor-loop-contract]:
+    <k>
+      While(
+        Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
+        Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
+      ~> (Return(Name("divisor")) .Stmts)
+      ~> .K
+    => .K
+    </k>
+    <arg> N </arg>
+    <env>
+      ("n" |-> N) ("divisor" |-> D)
+    => ("n" |-> N) ("divisor" |-> ?RESULT)
+    </env>
+    <result> noResult => ?RESULT </result>
+    requires N >Int 1
+         andBool D >Int 0
+         andBool D <Int N
+         andBool noDivisorFrom(N, D +Int 1, N -Int 1)
+    ensures isLargestProperDivisor(N, ?RESULT)
+
+  // End-to-end proof of the exact constructor tree in solution.mpy against
+  // the declarative contract.
+  claim [largest-divisor-natural-contract]:
+    <k>
+      Module(
+        FuncDef("largest_divisor", Params("n"),
+          Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
+          While(
+            Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
+            Assign(Name("divisor"), BinOp("-", Name("divisor"), Int(1))))
+          Return(Name("divisor"))))
+    => .K
+    </k>
+    <arg> N </arg>
+    <env>
+      .Map
+    => ("n" |-> N) ("divisor" |-> ?RESULT)
+    </env>
+    <result> noResult => ?RESULT </result>
+    requires N >Int 1
+    ensures isLargestProperDivisor(N, ?RESULT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..352a86d6e0e4f31c3629d8f671e4904ced58e545
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Declarative maximality check over a finite interval.  It says that every
+  // candidate from LO through HI fails to divide N.
+  syntax Bool ::= noDivisorFrom(Int, Int, Int) [function]
+  rule noDivisorFrom(_, LO, HI) => true
+    requires LO >Int HI
+  rule noDivisorFrom(N, LO, HI)
+    => (N modInt LO =/=Int 0) andBool noDivisorFrom(N, LO +Int 1, HI)
+    requires LO <=Int HI
+
+  syntax Bool ::= isLargestThrough(Int, Int, Int) [function]
+  rule isLargestThrough(N, D, UPPER)
+    => D >Int 0
+       andBool D <=Int UPPER
+       andBool N modInt D ==Int 0
+       andBool noDivisorFrom(N, D +Int 1, UPPER)
+
+  syntax Bool ::= isLargestProperDivisor(Int, Int) [function]
+  rule isLargestProperDivisor(N, D)
+    => D <Int N andBool isLargestThrough(N, D, N -Int 1)
+endmodule

