+      <input> IN </input>
+      <functions> FS </functions>
+      <env>
+        ("n" |-> vi(2 *Int M) "odds" |-> vl(OS))
+        => ("n" |-> vi(M) "odds" |-> vl(OS))
+      </env>
+      <result> R </result>
+    </python>
+    requires M >Int 0
+endmodule
