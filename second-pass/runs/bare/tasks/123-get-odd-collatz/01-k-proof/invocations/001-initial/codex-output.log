+def get_odd_collatz(n):
+    odds = []
+    while n != 1:
+        if n % 2 == 1:
+            odds = odds + [n]
+            n = 3 * n + 1
+        else:
+            n = n // 2
+    return sorted(odds + [1])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fd03c5f68fe1d2e70499eb95fba1ddea39047edc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,143 @@
+requires "verification.k"
