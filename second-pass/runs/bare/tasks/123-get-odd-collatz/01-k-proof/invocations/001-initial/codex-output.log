+      </env>
+      <result> R </result>
+    </python>
+    requires M >Int 0
+
+  // Symbolic one-step correctness for every odd term greater than one.
+  claim [odd-step]:
+    <python>
+      <k> exec(collatzLoop .Stmts) => exec(collatzLoop .Stmts) </k>
+      <input> IN </input>
+      <functions> FS </functions>
+      <env>
+        ("n" |-> vi(2 *Int M +Int 1) "odds" |-> vl(OS))
+        => ("n" |-> vi(6 *Int M +Int 4)
