index 0000000000000000000000000000000000000000..bff2c625fe8a1e8e226abe4efa6786e694136569
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,143 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // End-to-end executions through loading, environments, control flow,
+  // arithmetic, collection, and sorting.
+  claim
+    <python>
+      <k> run(solutionProgram) => .K </k>
+      <input> 1 </input>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult => result(vl(1 :: .Ints)) </result>
+    </python>
+
+  claim
+    <python>
+      <k> run(solutionProgram) => .K </k>
+      <input> 2 </input>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult => result(vl(1 :: .Ints)) </result>
