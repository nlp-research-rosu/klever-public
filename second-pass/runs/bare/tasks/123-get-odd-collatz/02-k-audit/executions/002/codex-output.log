from pathlib import Path
import hashlib,itertools,stat,os
roots=[Path('/candidate'),Path('/generation-evidence/codex-trace')]
targets=['8dadf34694ad5b9d31e6553d92d0aeabb1db9ab0dccbf49102015120bf12c29d','5738b2e4744ad472b731b2cc858beb2d67421581a89a453a6d2863cae0e0392c']
allents=[]
for root in roots:
 es=[]
 for p in sorted(root.rglob('*')):
  kind='d' if p.is_dir() else 'f';b=p.read_bytes() if kind=='f' else b''
  es.append(dict(rel=p.relative_to(root).as_posix(),kind=kind,b=b,size=len(b),mode=stat.S_IMODE(p.lstat().st_mode)))
 allents.append(es)
seps=[b'',b'\\0',b'\\n',b' ',b':',b'\\t']
typestyles=['none','letter','word','upper','slash']
contentstyles=['raw','hex','rawhash','none']
pathstyles=['rel','dotrel','slashrel']
orders=[('type','path'),('path','type')]
sizeopts=[False,True]
modeopts=[False,True]
trailopts=seps
matches=[]
for incdirs,sep,typestyle,contentstyle,pathstyle,order,usesize,usemode,trail in itertools.product([False,True],seps,typestyles,contentstyles,pathstyles,orders,sizeopts,modeopts,trailopts):
 outs=[]
 for es in allents:
  h=hashlib.sha256()
  for e in es:
   if e['kind']=='d' and not incdirs:continue
   if typestyle=='none':t=b''
   elif typestyle=='letter':t=e['kind'].encode()
   elif typestyle=='word':t=('file' if e['kind']=='f' else 'directory').encode()
   elif typestyle=='upper':t=e['kind'].upper().encode()
   else:t=(b'/' if e['kind']=='d' else b'')
   p=e['rel'].encode()
   if pathstyle=='dotrel':p=b'./'+p
   elif pathstyle=='slashrel':p=b'/'+p
   vals={'type':t,'path':p}
   fields=[vals[x] for x in order if vals[x]]
   if usemode:fields.append(oct(e['mode']).encode())
   if usesize:fields.append(str(e['size']).encode())
   if fields:h.update(sep.join(fields));h.update(sep)
   if e['kind']=='f':
    if contentstyle=='raw':h.update(e['b'])
    elif contentstyle=='hex':h.update(hashlib.sha256(e['b']).hexdigest().encode())
    elif contentstyle=='rawhash':h.update(hashlib.sha256(e['b']).digest())
   h.update(trail)
  outs.append(h.hexdigest())
 if outs==targets:
  matches.append((incdirs,sep,typestyle,contentstyle,pathstyle,order,usesize,usemode,trail))
  print('MATCH',matches[-1])
print('done',len(matches))
