+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 3 ]]; then
+  echo "usage: run_logged.sh LOG WORKDIR COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+workdir=$2
+shift 2
+
+{
