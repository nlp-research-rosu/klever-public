     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // These three definitions spell the translated submission once for use in
     7	  // claims.  They are equations over the very same AST constructors parsed
     8	  // from solution.mpy; they do not bypass the operational semantics.
     9	  syntax Stmt ::= "collatzBranch" [function, total]
    10	  rule collatzBranch =>
    11	    If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1)), .CmpOps),
    12	       Assign(Name("odds"),
    13	              BinOp("+", Name("odds"), ListExpr(Name("n"), .Exprs)))
    14	       Assign(Name("n"),
    15	              BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
    16	       Assign(Name("n"), BinOp("//", Name("n"), Int(2))))
    17	
    18	  syntax Stmt ::= "collatzLoop" [function, total]
    19	  rule collatzLoop =>
    20	    While(Compare(Name("n"), CmpOp("!=", Int(1)), .CmpOps), collatzBranch)
    21	
    22	  syntax Pgm ::= "solutionProgram" [function, total]
    23	  rule solutionProgram =>
    24	    Module(
    25	      FuncDef("get_odd_collatz", Params("n", .Ids),
    26	        Assign(Name("odds"), ListExpr(.Exprs))
    27	        collatzLoop
    28	        Return(Call(Name("sorted"),
    29	                    BinOp("+", Name("odds"), ListExpr(Int(1), .Exprs)),
    30	                    .Exprs))))
    31	
    32	  // Executable observers used by validation claims.
    33	  syntax Bool ::= isSorted(Ints) [function, total]
    34	  rule isSorted(.Ints) => true
    35	  rule isSorted(_I :: .Ints) => true
    36	  rule isSorted(I :: J :: JS) =>
    37	       (I <=Int J andBool isSorted(J :: JS))
    38	
    39	  syntax Bool ::= allOdd(Ints) [function, total]
    40	  rule allOdd(.Ints) => true
    41	  rule allOdd(I :: IS) =>
    42	       ((I %Int 2) ==Int 1 andBool allOdd(IS))
    43	
    44	  // Non-functional wrappers ensure observer claims take an operational proof
    45	  // step instead of being normalized while the claim itself is parsed.
    46	  syntax KItem ::= "checkSorted" "(" Ints ")"
    47	                 | "checkAllOdd" "(" Ints ")"
    48	  rule <k> checkSorted(IS) => isSorted(sortInts(IS)) ... </k>
    49	  rule <k> checkAllOdd(IS) => allOdd(IS) ... </k>
    50	endmodule
