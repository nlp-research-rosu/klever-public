+if (( proof_rc == 0 || stuck_warning_rc != 0 )); then
+  echo 'UNEXPECTED: false reachable result was not rejected by a stuck claim'
+  exit 1
+fi
+
+echo 'EXPECTED: mutation built, reached the result obligation, and failed with a stuck claim.'

