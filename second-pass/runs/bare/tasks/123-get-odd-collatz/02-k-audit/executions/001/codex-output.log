+
+echo 'COMMAND: rg -n local declarations and attributes'
+rg -n \
+  '^[[:space:]]*(syntax|configuration|rule|claim)|\[[^]]*(function|total|functional|simplification|priority|priorities|opaque)[^]]*\]' \
+  semantic.k verification.k spec.k
+inventory_rc=$?
