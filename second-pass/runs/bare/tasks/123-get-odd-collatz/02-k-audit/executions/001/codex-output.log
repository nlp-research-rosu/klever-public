diff --git a/evidence/05-static-inventory.sh b/evidence/05-static-inventory.sh
new file mode 100644
index 0000000000000000000000000000000000000000..892616b5706de35c93bc6492009ae84f6131b07e
--- /dev/null
+++ b/evidence/05-static-inventory.sh
