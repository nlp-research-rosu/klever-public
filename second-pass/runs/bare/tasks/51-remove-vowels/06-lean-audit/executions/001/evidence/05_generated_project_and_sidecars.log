--- Klean51RemoveVowels/Prelude.lean ---
     1	/-
     2	K Prelude in Lean 4
     3	
     4	Functions with the `hook` attribute need to have a manual implementation in the backends.
     5	This file contains the Lean 4 definitions of the hooked functions in `domains.md`.
     6	
     7	Currently we translate hooked functions as uninterpreted functions together with axioms asserting their behavior.
     8	The current definition can be put into three levels:
     9	
    10	1. Signature Level:
    11	The signature of the hooks, this includes aliases for Sorts and function symbols for hooked functions.
    12	
    13	2. Rule Level:
    14	The behavior of the uninterpreted symbols can be asserted through axioms or theorems.
    15	Inconsistencies can arise from them, so it falls under the user to make sure axioms are consistent and/or theorems provable.
    16	
    17	3. Simplification Level:
    18	With the theory defined through function rules, simplifications can be stated as theorems.
    19	These theorems should be provable directly from the function rules and the semantics of the Sorts.
    20	 -/
    21	
    22	-- Basic K types
    23	abbrev SortBool         : Type := Bool
    24	abbrev SortBytes        : Type := ByteArray
    25	abbrev SortId           : Type := String
    26	abbrev SortFloat        : Type := Float
    27	abbrev SortInt          : Type := Int
    28	abbrev SortString       : Type := String
    29	abbrev SortStringBuffer : Type := String
    30	
    31	/-
    32	The `Map` sort represents a generalized associative array.
    33	Each key can be paired with an arbitrary value, and can be used to reference its associated value.
    34	Multiple bindings for the same key are not allowed.
    35	Note that both keys and values will always be KItems.
    36	 -/
    37	
    38	-- Signature to be instantiated by map implementations
    39	structure MapHookSig (K V : Type) where
    40	  unit       : List (K × V)
    41	  cons       : K → V → List (K × V) → List (K × V)
    42	  lookup     : List (K × V) → K → Option V
    43	  lookup?    : List (K × V) → K → V -- lookup with default
    44	  update     : K → V → List (K × V) → List (K × V)
    45	  delete     : List (K × V) → K → List (K × V)
    46	  concat     : List (K × V) → List (K × V) → Option (List (K × V))
    47	  difference : List (K × V) → List (K × V) → List (K × V)
    48	  updateMap  : List (K × V) → List (K × V) → List (K × V)
    49	  removeAll  : List (K × V) → List K → List (K × V)
    50	  keys       : List (K × V) → List K
    51	  in_keys    : List (K × V) → K → Bool
    52	  values     : List (K × V) → List V
    53	  size       : List (K × V) → Nat
    54	  includes   : List (K × V) → List (K × V) → Bool -- List (K × V) inclusion
    55	  choice     : List (K × V) → K -- arbitrary key from a List (K × V)
    56	  -- nodup is not satisfiable in the current implementation with `List (K × V)`
    57	  -- nodup      : forall al : List (K × V), List.Nodup (keys al)
    58	  split      : List (K × V) → List K → Option (List V × List (K × V))
    59	
    60	-- We use axioms to have uninterpreted functions
    61	namespace MapHookDef
    62	  variable (K V : Type)
    63	  axiom unitAx       : List (K × V)
    64	  axiom consAx       : K → V → List (K × V) → List (K × V)
    65	  axiom lookupAx     : List (K × V) → K → Option V
    66	  axiom lookupAx?    : List (K × V) → K → V -- lookup with default
    67	  axiom updateAx     : K → V → List (K × V) → List (K × V)
    68	  axiom deleteAx     : List (K × V) → K → List (K × V)
    69	  axiom concatAx     : List (K × V) → List (K × V) → Option (List (K × V))
    70	  axiom differenceAx : List (K × V) → List (K × V) → List (K × V)
    71	  axiom updateMapAx  : List (K × V) → List (K × V) → List (K × V)
    72	  axiom removeAllAx  : List (K × V) → List K → List (K × V)
    73	  axiom keysAx       : List (K × V) → List K
    74	  axiom in_keysAx    : List (K × V) → K → Bool
    75	  axiom valuesAx     : List (K × V) → List V
    76	  axiom sizeAx       : List (K × V) → Nat
    77	  axiom includesAx   : List (K × V) → List (K × V) → Bool -- map inclusion
    78	  axiom choiceAx     : List (K × V) → K -- arbitrary key from a map
    79	  -- axiom nodupAx      : forall m, List.Nodup (keysAx K V m)
    80	  axiom splitAx      : List (K × V) → List K → Option (List V × List (K × V))
    81	end MapHookDef
    82	
    83	-- Uninterpreted Map implementation
    84	noncomputable def MapHook (K V : Type) : MapHookSig K V :=
    85	  { unit       := MapHookDef.unitAx K V,
    86	    cons       := MapHookDef.consAx K V,
    87	    lookup     := MapHookDef.lookupAx K V,
    88	    lookup?    := MapHookDef.lookupAx? K V,
    89	    update     := MapHookDef.updateAx K V,
    90	    delete     := MapHookDef.deleteAx K V,
    91	    concat     := MapHookDef.concatAx K V,
    92	    difference := MapHookDef.differenceAx K V,
    93	    updateMap  := MapHookDef.updateMapAx K V,
    94	    removeAll  := MapHookDef.removeAllAx K V,
    95	    keys       := MapHookDef.keysAx K V,
    96	    in_keys    := MapHookDef.in_keysAx K V,
    97	    values     := MapHookDef.valuesAx K V,
    98	    size       := MapHookDef.sizeAx K V,
    99	    includes   := MapHookDef.includesAx K V,
   100	    choice     := MapHookDef.choiceAx K V,
   101	    -- nodup      := MapHookDef.nodupAx K V,
   102	    split      := MapHookDef.splitAx K V }
   103	
   104	/-
   105	Implementation of immutable, associative, commutative sets of `KItem`.
   106	The sets are nilpotent, i.e., the concatenation of two sets containing elements in common is `#False` (note however, this may be silently allowed during concrete execution).
   107	If you intend to add an element to a set that might already be present in the set, use the `|Set` operator instead.
   108	 -/
   109	
   110	structure SetHookSig (T : Type) where
   111	  unit         : List T
   112	  concat       : List T → List T → Option (List T)
   113	  element      : T → List T
   114	  union        : List T → List T → List T
   115	  intersection : List T → List T → List T
   116	  difference   : List T → List T → List T
   117	  inSet        : T → List T → Bool
   118	  inclusion    : List T → List T → Bool
   119	  size         : List T → Int
   120	  choice       : List T → T
   121	  split        : List T → List T → Option (List T)
   122	
   123	namespace SetHookDef
   124	  variable (T : Type)
   125	  axiom unitAx         : List T
   126	  axiom concatAx       : List T → List T → Option (List T)
   127	  axiom elementAx      : T → List T
   128	  axiom unionAx        : List T → List T → List T
   129	  axiom intersectionAx : List T → List T → List T
   130	  axiom differenceAx   : List T → List T → List T
   131	  axiom inSetAx        : T → List T → Bool
   132	  axiom inclusionAx    : List T → List T → Bool
   133	  axiom sizeAx         : List T → Int
   134	  axiom choiceAx       : List T → T
   135	  axiom splitAx        : List T → List T → Option (List T)
   136	end SetHookDef
   137	
   138	noncomputable def SetHook (T : Type) : SetHookSig T :=
   139	  { unit         := SetHookDef.unitAx T,
   140	    concat       := SetHookDef.concatAx T,
   141	    element      := SetHookDef.elementAx T,
   142	    union        := SetHookDef.unionAx T,
   143	    intersection := SetHookDef.intersectionAx T,
   144	    difference   := SetHookDef.differenceAx T,
   145	    inSet        := SetHookDef.inSetAx T,
   146	    inclusion    := SetHookDef.inclusionAx T,
   147	    size         := SetHookDef.sizeAx T,
   148	    choice       := SetHookDef.choiceAx T,
   149	    split        := SetHookDef.splitAx T }
   150	
   151	/-
   152	The `List` sort is an ordered collection that may contain duplicate elements.
   153	 -/
   154	
   155	structure listHookSig (T : Type) where
   156	  unit      : List T
   157	  concat    : List T → List T → Option (List T)
   158	  element   : T → List T
   159	  push      : T → List T → List T
   160	  get       : Int → List T → Option T
   161	  updte     : Int → T → List T → Option (List T)
   162	  -- create a List T with `length` elements, each containing  `value`. `Option` return type from `Int` parameter
   163	  make      : Int → T → Option (List T)
   164	  -- create a new `List T` which is equal to `dest` except the  `N` elements starting at `index` are replaced with the   contents of `src`
   165	  -- Having `index + size(src) > size(dest)` is undefined
   166	  -- updateList(dest: List T, index: Int, src: List T)
   167	  updateAll : List T → Int → List T → Option (List T)
   168	  -- create a new `List T` where the `length` elements starting   at `index` are replaced with `value`
   169	  fill      : List T → Int → T → Option (List T)
   170	  -- compute a new `List T` by removing `fromFront` elements from   the front of the list and `fromBack` elements from the back   of the List T
   171	  -- range(List T, fromFront: Int, fromBack: Int)
   172	  range     : List T → Int → Int → Option (List T)
   173	  -- compute whether an element is in a List T
   174	  -- the hook is `in`, but clashes with Lean syntax
   175	  inList    : T → List T → Bool
   176	  size      : List T → Int
   177	  -- split list into prefix, middle and postfix, given prefix and postfix length
   178	  split     : List T → Nat → Nat → Option (List T × List T × List T)
   179	
   180	namespace ListHookDef
   181	  variable (T : Type)
   182	  axiom unitAx      : List T
   183	  axiom concatAx    : List T → List T → Option (List T)
   184	  axiom elementAx   : T → List T
   185	  axiom pushAx      : T → List T → List T
   186	  axiom getAx       : Int → List T → Option T
   187	  axiom updteAx     : Int → T → List T → Option (List T)
   188	  axiom makeAx      : Int → T → Option (List T)
   189	  axiom updateAllAx : List T → Int → List T → Option (List T)
   190	  axiom fillAx      : List T → Int → T → Option (List T)
   191	  axiom rangeAx     : List T → Int → Int → Option (List T)
   192	  axiom inListAx    : T → List T → Bool
   193	  axiom sizeAx      : List T → Int
   194	  axiom splitAx     : List T → Nat → Nat → Option (List T × List T × List T)
   195	end ListHookDef
   196	
   197	noncomputable def ListHook (T : Type) : listHookSig T :=
   198	  { unit      := ListHookDef.unitAx T,
   199	    concat    := ListHookDef.concatAx T,
   200	    element   := ListHookDef.elementAx T,
   201	    push      := ListHookDef.pushAx T,
   202	    get       := ListHookDef.getAx T,
   203	    updte     := ListHookDef.updteAx T,
   204	    make      := ListHookDef.makeAx T,
   205	    updateAll := ListHookDef.updateAllAx T,
   206	    fill      := ListHookDef.fillAx T,
   207	    range     := ListHookDef.rangeAx T,
   208	    inList    := ListHookDef.inListAx T,
   209	    size      := ListHookDef.sizeAx T,
   210	    split     := ListHookDef.splitAx T }
   211	
   212	class Inj (From To : Type) : Type where
   213	  inj (x : From) : To
   214	  retr (x : To) : Option From
   215	
   216	def inj {From To : Type} [inst : Inj From To] := inst.inj
   217	def retr {From To : Type} [inst : Inj From To] := inst.retr
   218	
   219	-- Instances
   220	
   221	instance: BEq UInt8 where
   222	  beq a b := decide (Eq a b)
   223	
   224	instance: BEq SortBytes where
   225	  beq a b := (ByteArray.toList a) == (ByteArray.toList b)
   226	
   227	def ByteArray.decEq (a b : ByteArray) : Decidable (Eq a b) :=
   228	  match a, b with
   229	  | ⟨⟨al⟩⟩, ⟨⟨bl⟩⟩ => match List.hasDecEq al bl with
   230	    | isTrue t => isTrue (by rw [t])
   231	    | isFalse f => isFalse (by simp [f])
   232	
   233	instance: DecidableEq SortBytes := ByteArray.decEq
   234	
   235	/-! ### Function Implementations -/
   236	
   237	-- `SortInt`
   238	
   239	-- Operations
   240	def «_+Int_» (x0 x1 : SortInt) : Option SortInt := some (x0 + x1)
   241	def «_-Int_» (x0 x1 : SortInt) : Option SortInt := some (x0 - x1)
   242	def «_*Int_» (x0 x1 : SortInt) : Option SortInt := some (x0 * x1)
   243	def «_/Int_» (x0 x1 : SortInt) : Option SortInt :=
   244	  ite (x1 == 0) none (Int.tdiv x0 x1)
   245	def _modInt_ (x0 x1 : SortInt) : Option SortInt :=
   246	  ite (x1 == 0) none (Int.emod x0 x1)
   247	def «_^%Int__» (x0 x1 x2 : SortInt) : Option SortInt :=
   248	   if x2 == 0 then none else
   249	   match x1 with -- TODO: Revisit this implementation
   250	   | .ofNat n => some (Int.emod (Int.pow x0 n) x2)
   251	   | _ => none
   252	def «maxInt(_,_)_INT-COMMON_Int_Int_Int» (x0 x1 : SortInt) :=
   253	  some (ite (x0 < x1) x1 x0)
   254	def «log2Int(_)_INT-COMMON_Int_Int» (x0 : SortInt) : Option SortInt :=
   255	  ite (0 < x0) ((Nat.log2 x0.toNat) : Int) none
   256	def «~Int_» (x0 : SortInt) : Option SortInt := some (.not x0)
   257	
   258	-- Comparisons
   259	def «_<=Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 <= x1)
   260	def «_>=Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 >= x1)
   261	def «_<Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 < x1)
   262	def «_>Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 > x1)
   263	def «_==Int_» (x0 x1 : SortInt) : Option SortBool := some (x0 == x1)
   264	
   265	-- `SortBytes`
   266	
   267	inductive SortEndianness : Type where
   268	  | bigEndianBytes : SortEndianness
   269	  | littleEndianBytes : SortEndianness
   270	  deriving BEq, DecidableEq
   271	
   272	inductive SortSignedness : Type where
   273	  | signedBytes : SortSignedness
   274	  | unsignedBytes : SortSignedness
   275	  deriving BEq, DecidableEq
   276	
   277	def «.Bytes_BYTES-HOOKED_Bytes» : Option SortBytes := some .empty
   278	
   279	-- Adapted from https://github.com/runtimeverification/haskell-backend/blob/362dab30d6435ec117862fea722be67373572034/kore/src/Kore/Builtin/InternalBytes.hs#L496-L511
   280	def «Int2Bytes(_,_,_)_BYTES-HOOKED_Bytes_Int_Int_Endianness» (x0 x1 : SortInt) (x2 : SortEndianness) : Option SortBytes :=
   281	  match x2 with
   282	  | .littleEndianBytes => some littleEndian.toByteArray
   283	  | .bigEndianBytes => some littleEndian.reverse.toByteArray
   284	  where
   285	  littleEndian : List UInt8 :=
   286	    let pad := ite (x1 < 0) 0xFF 0x00
   287	    let rec bytes (len : Nat) (n : Int) : List UInt8 :=
   288	      match len, n with
   289	      | 0, _ => []
   290	      | .succ l, 0 => pad :: bytes l 0
   291	      | .succ l, n => ⟨(n % 256).toNat⟩ :: bytes l (n / 256)
   292	    bytes x0.toNat x1
   293	
   294	-- Adapted from
   295	-- https://github.com/runtimeverification/haskell-backend/blob/362dab30d6435ec117862fea722be67373572034/kore/src/Kore/Builtin/InternalBytes.hs#L527-L543
   296	-- Note that we use `List.foldl` and not `ByteArray.foldl` for ease of reasoning
   297	def «Bytes2Int(_,_,_)_BYTES-HOOKED_Int_Bytes_Endianness_Signedness» (bytes : SortBytes) (endian : SortEndianness) (sign : SortSignedness) : Option SortInt :=
   298	  match sign with
   299	  | .unsignedBytes => Int.ofNat unsigned
   300	  | .signedBytes => if 2 * unsigned >= modulus then (Int.ofNat unsigned) - (Int.ofNat modulus)
   301	                    else Int.ofNat unsigned
   302	  where
   303	  modulus : Nat := res.1
   304	  unsigned : Nat := res.2
   305	  res : Nat×Nat :=
   306	    let littleEndian := match endian with
   307	                        | .littleEndianBytes => bytes.toList
   308	                            --match bytes with |⟨⟨l⟩⟩ => l
   309	                        | .bigEndianBytes => bytes.toList.reverse
   310	                            --match bytes with |⟨⟨l⟩⟩ => l.reverse
   311	    let go (res : Nat×Nat) (b : UInt8) : Nat×Nat :=
   312	      -- `place` is `res.1`
   313	      -- `acc` is `res.2`
   314	      let place := res.1 * 0x100
   315	      let acc := res.2 + res.1 * b.toNat
   316	      ⟨place, acc⟩
   317	    List.foldl go (1, 0) littleEndian
   318	
   319	/--
   320	Pads to the right `len - b.length` bytes with specified `val` value
   321	-/
   322	def «padRightBytes(_,_,_)_BYTES-HOOKED_Bytes_Bytes_Int_Int» (b : SortBytes) (len val : SortInt) : Option SortBytes :=
   323	  if val < 0 ∨ 255 < val then none else
   324	  some { data := (Array.rightpad len.toNat (⟨val.toNat⟩ : UInt8) b.data)}
   325	
   326	/--
   327	Pads to the left `len - b.length` bytes with specified `val` value
   328	-/
   329	def «padLeftBytes(_,_,_)_BYTES-HOOKED_Bytes_Bytes_Int_Int» (b : SortBytes) (len val : SortInt) : Option SortBytes :=
   330	  if val < 0 ∨ 255 < val then none else
   331	  some { data := (Array.leftpad len.toNat (⟨val.toNat⟩ : UInt8) b.data)}
   332	
   333	def «lengthBytes(_)_BYTES-HOOKED_Int_Bytes» (x0 : SortBytes) : Option SortInt :=
   334	  Int.ofNat x0.size
   335	
   336	/--
   337	Replaces the contents of `dest` from index `index` with the contents of `src`
   338	If `dest.size < index + src.size` the result is `none`
   339	-/
   340	def «replaceAtBytes(_,_,_)_BYTES-HOOKED_Bytes_Bytes_Int_Bytes» (dest : SortBytes) (index : SortInt) (src : SortBytes) : Option SortBytes :=
   341	  if index < 0 then none else
   342	  if dest.size < index + src.size then none else
   343	  let init := dest.data.extract 0 index.toNat
   344	  let rem := dest.data.extract (index.toNat + src.size) dest.size
   345	  some { data := init ++ src.data ++ rem }
   346	
   347	/--
   348	Get a new `Bytes` object containing a range of bytes from the input `Bytes`
   349	-/
   350	def «substrBytes(_,_,_)_BYTES-HOOKED_Bytes_Bytes_Int_Int» (b : SortBytes) (startIndex : SortInt) (endIndex : SortInt) : Option SortBytes :=
   351	  if startIndex < 0 then none else
   352	  if endIndex < startIndex then none else
   353	  if b.size < endIndex then none else
   354	  b.extract startIndex.toNat endIndex.toNat

