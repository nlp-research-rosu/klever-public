diff --git a/evidence/capture.sh b/evidence/capture.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9c065195d3e6c3525b9b96475a8521dbca8d645d
--- /dev/null
+++ b/evidence/capture.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s OUTPUT COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+output=$1
+shift
+
+set +e
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n\n'
+  "$@"
+  status=$?
+  printf '\nEXIT_CODE: %d\n' "$status"
+  exit "$status"
+} 2>&1 | tee "$output"
+status=${PIPESTATUS[0]}
+exit "$status"
diff --git a/evidence/proc_self_readlink_fix.c b/evidence/proc_self_readlink_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..1823b1b4b608694fdc9558eed08d3b202c98e77f
--- /dev/null
+++ b/evidence/proc_self_readlink_fix.c
@@ -0,0 +1,33 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    char broken_self_path[64];
+    int length = snprintf(
+        broken_self_path,
+        sizeof(broken_self_path),
+        "/proc/%d/exe",
+        getpid()
+    );
+    const char *effective_path = path;
+    if (
+        length > 0
+        && (size_t)length < sizeof(broken_self_path)
+        && strcmp(path, broken_self_path) == 0
+    ) {
+        effective_path = "/proc/self/exe";
+    }
+    return syscall(
+        SYS_readlinkat,
+        AT_FDCWD,
+        effective_path,
+        buffer,
+        size
+    );
+}

diff --git a//tmp/audit-work/readlink_probe.c b//tmp/audit-work/readlink_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..61aa2d6e68d66f2236303524760aad09d5836f99
--- /dev/null
+++ b//tmp/audit-work/readlink_probe.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    ssize_t result = syscall(SYS_readlinkat, AT_FDCWD, path, buffer, size);
+    int saved_errno = errno;
+    dprintf(
+        STDERR_FILENO,
+        "READLINK_PROBE path=%s result=%zd errno=%d\n",
+        path,
+        result,
+        saved_errno
+    );
+    errno = saved_errno;
+    return result;
+}
