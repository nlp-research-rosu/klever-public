  ✓ Reconstruct trusted K rule inventory and audit Stage 3 classifications
  ✓ Authenticate Stage 4 producer sources and rerun deterministic preflight
  ✓ Audit generated obligations, target identity, and mathematical fidelity
  ✓ If proof mode, clean-build candidate and audit Lean proof/trust/operational bridge
  ✓ Write evidence and self-contained REVIEW.md with the required final pair
diff --git a//tmp/audit-work/readlink_probe.c b//tmp/audit-work/readlink_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..61aa2d6e68d66f2236303524760aad09d5836f99
--- /dev/null
+++ b//tmp/audit-work/readlink_probe.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    ssize_t result = syscall(SYS_readlinkat, AT_FDCWD, path, buffer, size);
+    int saved_errno = errno;
+    dprintf(
+        STDERR_FILENO,
+        "READLINK_PROBE path=%s result=%zd errno=%d\n",
+        path,
+        result,
+        saved_errno
+    );
+    errno = saved_errno;
+    return result;
+}
