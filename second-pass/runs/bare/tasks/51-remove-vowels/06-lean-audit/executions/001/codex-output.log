index 0000000000000000000000000000000000000000..9c065195d3e6c3525b9b96475a8521dbca8d645d
--- /dev/null
+++ b/evidence/capture.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s OUTPUT COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+output=$1
+shift
+
+set +e
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n\n'
+  "$@"
+  status=$?
+  printf '\nEXIT_CODE: %d\n' "$status"
+  exit "$status"
+} 2>&1 | tee "$output"
+status=${PIPESTATUS[0]}
+exit "$status"
