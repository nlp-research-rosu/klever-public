+  exit 64
+fi
+
+output=$1
+shift
+
+set +e
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n\n'
+  "$@"
+  status=$?
+  printf '\nEXIT_CODE: %d\n' "$status"
+  exit "$status"
+} 2>&1 | tee "$output"
+status=${PIPESTATUS[0]}
+exit "$status"

