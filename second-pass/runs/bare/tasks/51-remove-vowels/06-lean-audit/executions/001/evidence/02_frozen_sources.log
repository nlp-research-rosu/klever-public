     3	def remove_vowels(text):
     4	    """
     5	    remove_vowels is a function that takes string and returns string without vowels.
     6	    >>> remove_vowels('')
     7	    ''
     8	    >>> remove_vowels("abcdef\nghijklm")
     9	    'bcdf\nghjklm'
    10	    >>> remove_vowels('abcdef')
    11	    'bcdf'
    12	    >>> remove_vowels('aaaaa')
    13	    ''
    14	    >>> remove_vowels('aaBAA')
    15	    'B'
    16	    >>> remove_vowels('zbcd')
    17	    'zbcd'
    18	    """

===== solution.py =====
     1	def remove_vowels(text):
     2	    return text.replace("a", "").replace("e", "").replace("i", "").replace("o", "").replace("u", "").replace("A", "").replace("E", "").replace("I", "").replace("O", "").replace("U", "")

