===== semantic.k =====
     1	module MPY-SYNTAX
     2	  imports STRING-SYNTAX
     3	
     4	  syntax Program ::= "Module" "(" Stmt ")"
     5	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
     6	                | "Return" "(" Expr ")"
     7	  syntax Params ::= "Params" "(" String ")"
     8	
     9	  syntax Expr ::= "Name" "(" String ")"
    10	                | "Str" "(" String ")"
    11	                | "Attribute" "(" Expr "," String ")"
    12	                | "Call" "(" Expr "," Expr "," Expr ")"
    13	endmodule
    14	
    15	module MPY
    16	  imports MPY-SYNTAX
    17	  imports STRING
    18	
    19	  // A literal substring deletion primitive.  The concrete attribute keeps
    20	  // K's replaceAll hook executable for krun while leaving symbolic strings
    21	  // represented by deleteAll during proofs.
    22	  syntax String ::= deleteAll(String, String) [function]
    23	  rule deleteAll(S, NEEDLE) => replaceAll(S, NEEDLE, "")
    24	    [concrete(S, NEEDLE), simplification]
    25	
    26	  syntax Value ::= strVal(String)
    27	  syntax Value ::= eval(Expr, String, String) [function]
    28	  syntax Value ::= replaceValue(Value, String, String) [function]
    29	  syntax Result ::= "noResult" | result(String)
    30	  syntax KItem ::= "done"
    31	
    32	  rule eval(Name(X), P, I) => strVal(I)
    33	    requires X ==String P
    34	  rule eval(Str(S), _, _) => strVal(S)
    35	  rule eval(Call(Attribute(E, "replace"), Str(OLD), Str(NEW)), P, I)
    36	    => replaceValue(eval(E, P, I), OLD, NEW)
    37	  rule replaceValue(strVal(S), OLD, "") => strVal(deleteAll(S, OLD))
    38	
    39	  configuration
    40	    <mpy>
    41	      <k> $PGM:K </k>
    42	      <input> $INPUT:String </input>
    43	      <result> noResult </result>
    44	    </mpy>
    45	
    46	  rule <k> Module(FuncDef(_, Params(P), Return(E)))
    47	         => eval(E, P, I) ...</k>
    48	       <input> I </input>
    49	
    50	  rule <k> strVal(S) => done </k>
    51	       <result> noResult => result(S) </result>
    52	endmodule

===== verification.k =====
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // This is the contract in executable mathematical form: delete every
     7	  // occurrence of each of the ten one-character English vowel strings.
     8	  syntax String ::= removeLowerVowels(String) [function, total]
     9	                  | removeUpperVowels(String) [function, total]
    10	                  | removeVowelsSpec(String)  [function, total]
    11	
    12	  rule removeLowerVowels(S)
    13	    => deleteAll(
    14	         deleteAll(
    15	           deleteAll(
    16	             deleteAll(
    17	               deleteAll(S, "a"),
    18	             "e"),
    19	           "i"),
    20	         "o"),
    21	       "u")
    22	
    23	  rule removeUpperVowels(S)
    24	    => deleteAll(
    25	         deleteAll(
    26	           deleteAll(
    27	             deleteAll(
    28	               deleteAll(S, "A"),
    29	             "E"),
    30	           "I"),
    31	         "O"),
    32	       "U")
    33	
    34	  rule removeVowelsSpec(S) => removeUpperVowels(removeLowerVowels(S))
    35	endmodule

