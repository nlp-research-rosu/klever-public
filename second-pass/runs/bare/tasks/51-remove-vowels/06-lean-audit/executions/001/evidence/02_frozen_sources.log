===== prove.sh =====
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Regenerate the constructor term from the submitted implementation.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Compile the semantics together with its verification definitions.
     8	kompile verification.k \
     9	  --syntax-module MPY-SYNTAX \
    10	  --main-module VERIFICATION \
    11	  --backend haskell
    12	
    13	# Exercise every example from prompt.py through the K semantics.
    14	krun solution.mpy -cINPUT='""' --definition verification-kompiled
    15	krun solution.mpy -cINPUT='"abcdef\nghijklm"' --definition verification-kompiled
    16	krun solution.mpy -cINPUT='"abcdef"' --definition verification-kompiled
    17	krun solution.mpy -cINPUT='"aaaaa"' --definition verification-kompiled
    18	krun solution.mpy -cINPUT='"aaBAA"' --definition verification-kompiled
    19	krun solution.mpy -cINPUT='"zbcd"' --definition verification-kompiled
    20	
    21	# Prove the universally quantified refinement claim in spec.k.
    22	kprove spec.k --definition verification-kompiled --spec-module SPEC

