+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal refinement claim: for every K String, executing the translated
+  // program reaches exactly the independently named contract function.
+  claim
+    <mpy>
+      <k>
+        Module(
+          FuncDef("remove_vowels", Params("text"),
+            Return(
+              Call(
+                Attribute(
+                  Call(
+                    Attribute(
+                      Call(
+                        Attribute(
+                          Call(
+                            Attribute(
+                              Call(
+                                Attribute(
+                                  Call(
+                                    Attribute(
+                                      Call(
+                                        Attribute(
+                                          Call(
+                                            Attribute(
+                                              Call(
+                                                Attribute(
+                                                  Call(
+                                                    Attribute(
+                                                      Name("text"),
+                                                    "replace"),
+                                                  Str("a"), Str("")),
+                                                "replace"),
+                                              Str("e"), Str("")),
+                                            "replace"),
+                                          Str("i"), Str("")),
+                                        "replace"),
+                                      Str("o"), Str("")),
+                                    "replace"),
