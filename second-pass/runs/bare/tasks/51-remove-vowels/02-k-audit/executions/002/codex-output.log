+                        "replace"),
+                      Str("I"), Str("")),
+                    "replace"),
+                  Str("O"), Str("")),
+                "replace"),
+              Str("U"), Str("")))))
+        => done
+      </k>
+      <input> INPUT:String </input>
+      <result> noResult => result("") </result>
+    </mpy>
+endmodule
