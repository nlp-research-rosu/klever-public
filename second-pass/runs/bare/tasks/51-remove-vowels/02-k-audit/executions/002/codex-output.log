+                                                  Str("a"), Str("")),
+                                                "replace"),
+                                              Str("e"), Str("")),
+                                            "replace"),
+                                          Str("i"), Str("")),
+                                        "replace"),
+                                      Str("o"), Str("")),
+                                    "replace"),
+                                  Str("u"), Str("")),
+                                "replace"),
+                              Str("A"), Str("")),
+                            "replace"),
+                          Str("E"), Str("")),
+                        "replace"),
+                      Str("I"), Str("")),
+                    "replace"),
+                  Str("O"), Str("")),
+                "replace"),
+              Str("X"), Str("")))))
