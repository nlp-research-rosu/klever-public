+  printf '\n'
+} > "$audit_log"
+
+"$@" >> "$audit_log" 2>&1
+audit_status=$?
+printf 'EXIT_STATUS: %d\n' "$audit_status" >> "$audit_log"
+
+cat "$audit_log"
+exit "$audit_status"
