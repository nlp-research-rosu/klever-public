+                                            Attribute(
+                                              Call(
+                                                Attribute(
+                                                  Name("text"),
+                                                "replace"),
+                                              Str("a"), Str("")),
+                                            "replace"),
+                                          Str("e"), Str("")),
+                                        "replace"),
+                                      Str("i"), Str("")),
+                                    "replace"),
