new file mode 100644
index 0000000000000000000000000000000000000000..0807293eaec3aa10a3a434fe7f3a7d64a9e05075
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'WORKING_DIRECTORY: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$audit_log"
+
+"$@" >> "$audit_log" 2>&1
+audit_status=$?
+printf 'EXIT_STATUS: %d\n' "$audit_status" >> "$audit_log"
+
+cat "$audit_log"
+exit "$audit_status"
