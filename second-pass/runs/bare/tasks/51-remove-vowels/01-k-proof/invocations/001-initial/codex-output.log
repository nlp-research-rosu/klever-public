diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..5223cf42cb1a121064c8dddd145f60df7fbb4e4c
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,43 @@
+module MPY-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmt ")" [symbol]
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")" [symbol]
+                | "Return" "(" Expr ")"                        [symbol]
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Expr ::= "Name" "(" String ")"                         [symbol]
+                | "Str" "(" String ")"                          [symbol]
+                | "Attribute" "(" Expr "," String ")"          [symbol]
+                | "Call" "(" Expr "," Expr "," Expr ")"       [symbol]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports STRING
+
+  syntax Value ::= strVal(String) [symbol]
+  syntax Value ::= eval(Expr, String, String) [function, total]
+  syntax Value ::= replaceValue(Value, String, String) [function, total]
+
+  rule eval(Name(X), P, I) => strVal(I)
+    requires X ==String P
+  rule eval(Str(S), _, _) => strVal(S)
+  rule eval(Call(Attribute(E, "replace"), Str(OLD), Str(NEW)), P, I)
+    => replaceValue(eval(E, P, I), OLD, NEW)
+  rule replaceValue(strVal(S), OLD, NEW) => strVal(replaceAll(S, OLD, NEW))
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <input> $INPUT:String </input>
+      <result> .K </result>
+    </mpy>
+
+  rule <k> Module(FuncDef(_, Params(P), Return(E)))
+         => eval(E, P, I) ...</k>
+       <input> I </input>
+
+  rule <k> strVal(S) => .K </k>
+       <result> .K => S </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..17eb65da1b150929548b1597f8aba1db28a23a5e
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,5 @@
+def remove_vowels(text):
+    """
+    Return text with every lower- and upper-case English vowel removed.
+    """
+    return text.replace("a", "").replace("e", "").replace("i", "").replace("o", "").replace("u", "").replace("A", "").replace("E", "").replace("I", "").replace("O", "").replace("U", "")

exec
/bin/bash -lc 'python3 py2mpy.py solution.py > solution.mpy
cat solution.mpy
kompile semantic.k --syntax-module MPY-SYNTAX --main-module MPY --backend llvm' in /work
