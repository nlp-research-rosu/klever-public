+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal refinement claim: for every K String, executing the translated
+  // program reaches exactly the independently named contract function.
+  claim
+    <mpy>
+      <k>
+        Module(
+          FuncDef("remove_vowels", Params("text"),
+            Return(
+              Call(
+                Attribute(
+                  Call(
+                    Attribute(
+                      Call(
+                        Attribute(
+                          Call(
+                            Attribute(
+                              Call(
+                                Attribute(
+                                  Call(
+                                    Attribute(
+                                      Call(
+                                        Attribute(
+                                          Call(
+                                            Attribute(
+                                              Call(
+                                                Attribute(
+                                                  Call(
+                                                    Attribute(
+                                                      Name("text"),
+                                                    "replace"),
+                                                  Str("a"), Str("")),
+                                                "replace"),
+                                              Str("e"), Str("")),
+                                            "replace"),
+                                          Str("i"), Str("")),
+                                        "replace"),
+                                      Str("o"), Str("")),
+                                    "replace"),
+                                  Str("u"), Str("")),
+                                "replace"),
+                              Str("A"), Str("")),
+                            "replace"),
+                          Str("E"), Str("")),
+                        "replace"),
+                      Str("I"), Str("")),
+                    "replace"),
+                  Str("O"), Str("")),
+                "replace"),
+              Str("U"), Str(""))))
+        => .K
+      </k>
+      <input> INPUT:String </input>
+      <result> noResult => result(removeVowelsSpec(INPUT)) </result>
+    </mpy>
+
+  // The prompt examples also pin the contract to concrete expected values.
+  claim removeVowelsSpec("") => ""
+  claim removeVowelsSpec("abcdef\nghijklm") => "bcdf\nghjklm"
+  claim removeVowelsSpec("abcdef") => "bcdf"
+  claim removeVowelsSpec("aaaaa") => ""
+  claim removeVowelsSpec("aaBAA") => "B"
+  claim removeVowelsSpec("zbcd") => "zbcd"
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..12a2ea0d32243f32f7dda77bf2b47e931a87cb57
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // This is the contract in executable mathematical form: delete every
+  // occurrence of each of the ten one-character English vowel strings.
+  syntax String ::= removeLowerVowels(String) [function, total]
+                  | removeUpperVowels(String) [function, total]
+                  | removeVowelsSpec(String)  [function, total]
+
+  rule removeLowerVowels(S)
+    => replaceAll(
+         replaceAll(
+           replaceAll(
+             replaceAll(
+               replaceAll(S, "a", ""),
+             "e", ""),
+           "i", ""),
+         "o", ""),
+       "u", "")
+
+  rule removeUpperVowels(S)
+    => replaceAll(
+         replaceAll(
+           replaceAll(
+             replaceAll(
+               replaceAll(S, "A", ""),
+             "E", ""),
+           "I", ""),
+         "O", ""),
+       "U", "")
+
+  rule removeVowelsSpec(S) => removeUpperVowels(removeLowerVowels(S))
+endmodule

