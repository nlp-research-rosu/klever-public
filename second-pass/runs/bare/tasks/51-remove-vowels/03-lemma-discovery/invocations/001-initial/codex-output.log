#!/usr/bin/env bash
set -euo pipefail

# Regenerate the constructor term from the submitted implementation.
python3 py2mpy.py solution.py > solution.mpy

# Compile the semantics together with its verification definitions.
kompile verification.k \
  --syntax-module MPY-SYNTAX \
  --main-module VERIFICATION \
  --backend haskell

# Exercise every example from prompt.py through the K semantics.
krun solution.mpy -cINPUT='""' --definition verification-kompiled
krun solution.mpy -cINPUT='"abcdef\nghijklm"' --definition verification-kompiled
krun solution.mpy -cINPUT='"abcdef"' --definition verification-kompiled
krun solution.mpy -cINPUT='"aaaaa"' --definition verification-kompiled
krun solution.mpy -cINPUT='"aaBAA"' --definition verification-kompiled
krun solution.mpy -cINPUT='"zbcd"' --definition verification-kompiled

# Prove the universally quantified refinement claim in spec.k.
kprove spec.k --definition verification-kompiled --spec-module SPEC
module MPY-SYNTAX
  imports STRING-SYNTAX

  syntax Program ::= "Module" "(" Stmt ")"
  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
                | "Return" "(" Expr ")"
  syntax Params ::= "Params" "(" String ")"

  syntax Expr ::= "Name" "(" String ")"
                | "Str" "(" String ")"
                | "Attribute" "(" Expr "," String ")"
                | "Call" "(" Expr "," Expr "," Expr ")"
endmodule

module MPY
  imports MPY-SYNTAX
  imports STRING

  // A literal substring deletion primitive.  The concrete attribute keeps
  // K's replaceAll hook executable for krun while leaving symbolic strings
  // represented by deleteAll during proofs.
  syntax String ::= deleteAll(String, String) [function]
  rule deleteAll(S, NEEDLE) => replaceAll(S, NEEDLE, "")
    [concrete(S, NEEDLE), simplification]

  syntax Value ::= strVal(String)
  syntax Value ::= eval(Expr, String, String) [function]
  syntax Value ::= replaceValue(Value, String, String) [function]
  syntax Result ::= "noResult" | result(String)
  syntax KItem ::= "done"

  rule eval(Name(X), P, I) => strVal(I)
    requires X ==String P
  rule eval(Str(S), _, _) => strVal(S)
  rule eval(Call(Attribute(E, "replace"), Str(OLD), Str(NEW)), P, I)
    => replaceValue(eval(E, P, I), OLD, NEW)
  rule replaceValue(strVal(S), OLD, "") => strVal(deleteAll(S, OLD))

  configuration
    <mpy>
      <k> $PGM:K </k>
      <input> $INPUT:String </input>
      <result> noResult </result>
    </mpy>

  rule <k> Module(FuncDef(_, Params(P), Return(E)))
         => eval(E, P, I) ...</k>
       <input> I </input>

  rule <k> strVal(S) => done </k>
       <result> noResult => result(S) </result>
endmodule
requires "semantic.k"

module VERIFICATION
  imports MPY

  // This is the contract in executable mathematical form: delete every
  // occurrence of each of the ten one-character English vowel strings.
  syntax String ::= removeLowerVowels(String) [function, total]
                  | removeUpperVowels(String) [function, total]
                  | removeVowelsSpec(String)  [function, total]

  rule removeLowerVowels(S)
    => deleteAll(
         deleteAll(
           deleteAll(
             deleteAll(
               deleteAll(S, "a"),
             "e"),
           "i"),
         "o"),
       "u")

  rule removeUpperVowels(S)
    => deleteAll(
         deleteAll(
           deleteAll(
             deleteAll(
               deleteAll(S, "A"),
             "E"),
           "I"),
         "O"),
       "U")

  rule removeVowelsSpec(S) => removeUpperVowels(removeLowerVowels(S))
endmodule
requires "verification.k"

module SPEC
