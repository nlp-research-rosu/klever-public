      "start_line": 23,
      "text": "  rule removeUpperVowels(S)\n    => deleteAll(\n         deleteAll(\n           deleteAll(\n             deleteAll(\n               deleteAll(S, \"A\"),\n             \"E\"),\n           \"I\"),\n         \"O\"),\n       \"U\")"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "cdf7c02d83c3928a7f8b88a45691a3681e2a79a579a8503bd2c19f81bb514a86",
      "rationale": "This equation defines the complete removeVowelsSpec summary as the composition of the lowercase- and uppercase-vowel removal summaries.",
      "source_rule_id": "rule-cdf7c02d83c3928a7f8b88a45691a3681e2a79a579a8503bd2c19f81bb514a86",
      "start_line": 34,
      "text": "  rule removeVowelsSpec(S) => removeUpperVowels(removeLowerVowels(S))"
