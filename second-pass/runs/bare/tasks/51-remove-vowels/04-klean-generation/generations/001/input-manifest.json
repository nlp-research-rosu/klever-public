      "start_line": 12,
      "text": "  rule removeLowerVowels(S)\n    => deleteAll(\n         deleteAll(\n           deleteAll(\n             deleteAll(\n               deleteAll(S, \"a\"),\n             \"e\"),\n           \"i\"),\n         \"o\"),\n       \"u\")"
    },
