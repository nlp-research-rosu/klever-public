index 0000000000000000000000000000000000000000..bf8e985a0a7591ed4476a3d171e12b37fe69aa1e
--- /dev/null
+++ b//tmp/audit-work/candidate/spec-body-mutation.k
@@ -0,0 +1,23 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // The executed program body is materially changed to `return string`, while
+  // retaining the original "Hello" result obligation.
+  claim
+    <k>
+      Module(
+        FuncDef("flip_case", Params("string"),
+          Return(Name("string"))))
+      => strVal("hELLO")
+    </k>
+    <arg> "Hello" </arg>
+    <functions>
+      .Map
+      =>
+      "flip_case" |->
