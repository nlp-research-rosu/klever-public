diff --git a//tmp/audit-work/candidate/solution-body-mutated.py b//tmp/audit-work/candidate/solution-body-mutated.py
new file mode 100644
index 0000000000000000000000000000000000000000..bd9f0abfc556d327f4512965c531b185f925142a
--- /dev/null
+++ b//tmp/audit-work/candidate/solution-body-mutated.py
@@ -0,0 +1,2 @@
+def flip_case(string: str) -> str:
+    return string
