+            parts.append(chr(byte))
+        elif byte == 0x22:
+            parts.append(r"\"")
+        elif byte == 0x5C:
+            parts.append(r"\\")
+        else:
+            parts.append(rf"\x{byte:02x}")
+    parts.append('"')
+    return "".join(parts)
