diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..e7142a97fa0363e26ac6f25344028da18046aa12
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,102 @@
+module MPY-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= Stmt
+                 | Stmt Stmts
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Str" "(" String ")"
+                | "Name" "(" String ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Exprs ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports MAP
+  imports STRING
+
+  // Values needed by this program.  Functions retain their untranslated AST
+  // body, and a method value retains both its name and its receiver.
+  syntax Value ::= strVal(String)
+                 | function(Params, Stmts)
+                 | boundStringMethod(String, String)
+  syntax KResult ::= Value
+
+  syntax KItem ::= "#invoke" "(" String "," Value ")"
+                 | "#attribute" "(" String ")"
+                 | "#callNoArgs"
+                 | "#return"
+                 | "#endCall"
+
+  configuration
+    <mpy>
+      <k> $PGM:Module </k>
+      <arg> $ARG:String </arg>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </mpy>
+
+  // Loading a module installs its definitions, then invokes the HumanEval
+  // entry point on the symbolic/configuration-provided argument.
+  rule <k> Module(BODY) => BODY ~> #invoke("flip_case", strVal(ARG)) ...</k>
+       <arg> ARG </arg>
+
+  rule <k> S:Stmt REST:Stmts => S ~> REST ...</k>
+
+  rule <k> FuncDef(F, PARAMS, BODY) => .K ...</k>
+       <functions> FUNS => FUNS[F <- function(PARAMS, BODY)] </functions>
+
+  rule <k> #invoke(F, V) => BODY ~> #endCall ...</k>
+       <functions>... F |-> function(Params(P:String), BODY) ...</functions>
+       <env> .Map => P |-> V </env>
+
+  rule <k> Return(E) => E ~> #return ...</k>
+
+  rule <k> Name(N) => V ...</k>
+       <env>... N |-> V ...</env>
+
+  rule <k> Str(S) => strVal(S) ...</k>
+
+  rule <k> Attribute(E, NAME) => E ~> #attribute(NAME) ...</k>
+  rule <k> strVal(S) ~> #attribute(NAME)
+        => boundStringMethod(NAME, S) ...</k>
+
+  rule <k> Call(F, .Exprs) => F ~> #callNoArgs ...</k>
+  rule <k> boundStringMethod("swapcase", S) ~> #callNoArgs
+        => strVal(pySwapCase(S)) ...</k>
+
+  rule <k> V:Value ~> #return ~> #endCall => V ...</k>
+       <env> _ => .Map </env>
+
+  // Python's str.swapcase is represented as a semantic primitive.  These
+  // equations make the primitive executable for ASCII, which is the character
+  // domain used by HumanEval's tests.  Its abstract name is retained for a
+  // symbolic String, so universal reachability claims do not enumerate input.
+  syntax String ::= pySwapCase(String) [function]
+                  | pySwapChar(String) [function, total]
+
+  rule pySwapCase("") => ""
+  rule pySwapCase(S) =>
+         pySwapChar(substrString(S, 0, 1))
+         +String pySwapCase(substrString(S, 1, lengthString(S)))
+    requires S =/=String ""
+
+  rule pySwapChar(C) => chrChar(ordChar(C) -Int 32)
+    requires 97 <=Int ordChar(C) andBool ordChar(C) <=Int 122
+  rule pySwapChar(C) => chrChar(ordChar(C) +Int 32)
+    requires 65 <=Int ordChar(C) andBool ordChar(C) <=Int 90
+  rule pySwapChar(C) => C
+    requires notBool (97 <=Int ordChar(C) andBool ordChar(C) <=Int 122)
+     andBool notBool (65 <=Int ordChar(C) andBool ordChar(C) <=Int 90)
+endmodule
