Strings
-------

Provided here is the syntax of an implementation of Unicode strings in K. This
type is hooked to an implementation of strings provided by the backend. The
implementation is currently incomplete and does not fully support encodings
and code points beyond the initial 256 code points of the Basic Latin and
Latin-1 Supplement blocks. In the future, there may be breaking changes to
the semantics of this module in order to support this functionality.

The syntax of strings in K is delineated by double quotes. Inside the double
quotes, any character can appear verbatim except double quotes, backslash,
newline, and carriage return. K also supports the following escape sequences:

* \" - the " character
* \\ - the \ character
* \n - newline character
* \r - carriage return character
* \t - tab character
* \f - form feed character
* \xFF - \x followed by two hexadecimal characters indicates a code point
  between 0x00 and 0xff
* \uFFFF - \u followed by four hexadecimal characters indicates a code point
  between 0x0000 and 0xffff
* \UFFFFFFFF - \U followed by eight hexadecimal characters indicates a code
  point between 0x000000 and 0x10ffff

```k
module STRING-SYNTAX
  syntax String [hook(STRING.String)]
  syntax String ::= r"[\\\"](([^\\\"\\n\\r\\\\])|([\\\\][nrtf\\\"\\\\])|([\\\\][x][0-9a-fA-F]{2})|([\\\\][u][0-9a-fA-F]{4})|([\\\\][U][0-9a-fA-F]{8}))*[\\\"]"      [token]
endmodule

module STRING-COMMON
  imports STRING-SYNTAX
  imports private INT
  imports private FLOAT-SYNTAX
  imports private K-EQUAL
  imports private BOOL
```

### String concatenation

You can concatenate two strings in O(N) time. For successive concatenation
operations, it may be better to use the `STRING-BUFFER` module.

```k
  syntax String ::= String "+String" String    [function, total, left, hook(STRING.concat)]
```

### String length

You can get the length of a string in O(1) time.

```k
  syntax Int ::= lengthString ( String ) [function, total, hook(STRING.length)]
```

### Character and integer conversion

You can convert between a character (as represented by a string containing
a single code point) and an integer in O(1) time.

```k
  syntax String ::= chrChar ( Int )      [function, hook(STRING.chr)]
  syntax Int ::= ordChar ( String )      [function, hook(STRING.ord)]
```

### String substring

You can compute a substring of a string in O(N) time (where N is the
length of the substring). There are two important facts to note:

1.  the range generated includes the character at `startIndex` but excludes the
    character at `endIndex`, i.e., the range is `[startIndex..endIndex)`.
2.  this function is only defined on valid indices (i.e., it is defined when
    `startIndex < endIndex` and `endIndex` is less than or equal to the string
    length).

```k
  syntax String ::= substrString ( String , startIndex: Int , endIndex: Int ) [function, total, hook(STRING.substr)]
```

### String search

You can find the first (respectively, last) occurrence of a substring, starting
at a certain `index`, in another string in O(N*M) time.
Returns `-1` if the substring is not found.

```k
  syntax Int ::= findString ( haystack: String , needle: String , index: Int )   [function, hook(STRING.find)]
  syntax Int ::= rfindString ( haystack: String , needle: String , index: Int )  [function, hook(STRING.rfind)]
```

diff --git a/gen_unicode_case.py b/gen_unicode_case.py
new file mode 100644
index 0000000000000000000000000000000000000000..46198efa7c9740a2a3e71371e71db5469442ccd7
--- /dev/null
+++ b/gen_unicode_case.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""Generate K equations for CPython's per-code-point str.swapcase mapping."""
+
+from pathlib import Path
+import platform
+import unicodedata
+
+
+def k_string(value: str) -> str:
+    pieces = []
+    escapes = {
+        '"': r'\"',
+        "\\": r"\\",
+        "\n": r"\n",
+        "\r": r"\r",
+        "\t": r"\t",
+        "\f": r"\f",
+    }
+    for character in value:
+        codepoint = ord(character)
+        if character in escapes:
+            pieces.append(escapes[character])
+        elif 0x20 <= codepoint <= 0x7E:
+            pieces.append(character)
+        elif codepoint <= 0xFF:
+            pieces.append(f"\\x{codepoint:02x}")
+        elif codepoint <= 0xFFFF:
+            pieces.append(f"\\u{codepoint:04x}")
+        else:
+            pieces.append(f"\\U{codepoint:08x}")
+    return '"' + "".join(pieces) + '"'
+
+
+lines = [
+    "// Generated by gen_unicode_case.py; do not edit by hand.",
+    f"// Python {platform.python_version()}, Unicode {unicodedata.unidata_version}.",
+    "module PYTHON-UNICODE-CASE",
+    "  imports STRING",
+    "",
+    "  syntax String ::= pySwapChar(String) [function, total]",
+]
+
+for codepoint in range(0x110000):
+    character = chr(codepoint)
+    swapped = character.swapcase()
+    if swapped != character:
+        lines.append(
+            f"  rule pySwapChar({k_string(character)}) => {k_string(swapped)}"
+        )
+
+lines.extend(
+    [
+        "  rule pySwapChar(C) => C [owise]",
+        "endmodule",
+        "",
+    ]
+)
+
+Path("unicode-case.k").write_text("\n".join(lines), encoding="utf-8")
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..41300d17b796a6e2ac74ed2d4dc7370570f39b28
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,96 @@
+requires "unicode-case.k"
+
+module MPY-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= Stmt
+                 | Stmt Stmts
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Str" "(" String ")"
+                | "Name" "(" String ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Exprs ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports MAP
+  imports PYTHON-UNICODE-CASE
+  imports STRING
+
+  // Values needed by this program.  Functions retain their untranslated AST
+  // body, and a method value retains both its name and its receiver.
+  syntax Value ::= strVal(String)
+                 | function(Params, Stmts)
+                 | boundStringMethod(String, String)
+  syntax KResult ::= Value
+
+  syntax KItem ::= "#invoke" "(" String "," Value ")"
+                 | "#attribute" "(" String ")"
+                 | "#callNoArgs"
+                 | "#return"
+                 | "#endCall"
+
+  configuration
+    <mpy>
+      <k> $PGM:Module </k>
+      <arg> $ARG:String </arg>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </mpy>
+
+  // Loading a module installs its definitions, then invokes the HumanEval
+  // entry point on the symbolic/configuration-provided argument.
+  rule <k> Module(BODY) => BODY ~> #invoke("flip_case", strVal(ARG)) ...</k>
+       <arg> ARG </arg>
+
+  rule <k> S:Stmt REST:Stmts => S ~> REST ...</k>
+
+  rule <k> FuncDef(F, PARAMS, BODY) => .K ...</k>
+       <functions> FUNS => FUNS[F <- function(PARAMS, BODY)] </functions>
+
+  rule <k> #invoke(F, V) => BODY ~> #endCall ...</k>
+       <functions>... F |-> function(Params(P:String), BODY) ...</functions>
+       <env> .Map => P |-> V </env>
+
+  rule <k> Return(E) => E ~> #return ...</k>
+
+  rule <k> Name(N) => V ...</k>
+       <env>... N |-> V ...</env>
+
+  rule <k> Str(S) => strVal(S) ...</k>
+
+  rule <k> Attribute(E, NAME) => E ~> #attribute(NAME) ...</k>
+  rule <k> strVal(S) ~> #attribute(NAME)
+        => boundStringMethod(NAME, S) ...</k>
+
+  rule <k> Call(F, .Exprs) => F ~> #callNoArgs ...</k>
+  rule <k> boundStringMethod("swapcase", S) ~> #callNoArgs
+        => strVal(pySwapCase(S)) ...</k>
+
+  rule <k> V:Value ~> #return ~> #endCall => V ...</k>
+       <env> _ => .Map </env>
+
+  // Python's str.swapcase is defined character-by-character.  pySwapChar is
+  // supplied by the generated helper module, including every mapping (and
+  // multi-code-point expansion) in the local CPython Unicode database.
+  syntax String ::= pySwapCase(String) [function]
+
+  rule pySwapCase("") => ""
+  rule pySwapCase(S) =>
+         pySwapChar(substrString(S, 0, 1))
+         +String pySwapCase(substrString(S, 1, lengthString(S)))
+    requires S =/=String ""
+
+endmodule
