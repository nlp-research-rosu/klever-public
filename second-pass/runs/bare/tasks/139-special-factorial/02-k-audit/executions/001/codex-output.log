+            "krun",
+            str(args.program),
+            f"-cN={n}",
+            "--definition",
+            str(args.definition),
+            "--output",
+            "pretty",
+        ]
+        print("COMMAND:", shlex.join(command))
+        completed = subprocess.run(command, text=True, capture_output=True)
+        print(f"EXIT_STATUS: {completed.returncode}")
