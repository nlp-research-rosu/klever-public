     5	
     6	def special_factorial(n):
     7	    """The Brazilian factorial is defined as:
     8	    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!
     9	    where n > 0
    10	
    11	    For example:
    12	    >>> special_factorial(4)
    13	    288
    14	
    15	    The function will receive an integer as input and should return the special
    16	    factorial of this integer.
    17	    """
    18	    fact_i = 1
    19	    special_fact = 1
    20	    for i in range(1, n+1):
    21	        fact_i *= i
    22	        special_fact *= fact_i
    23	    return special_fact
