    "special_factorial" |-> function ( "n" , If ( Compare ( Name ( "n" ) , CmpOp ( "<=" , Int ( 1 ) ) ) , Return ( Int ( 1 ) )  .Stmts , .Stmts )  Assign ( Name ( "factorial_n" ) , Call ( Name ( "factorial" ) , Name ( "n" ) ) )  Assign ( Name ( "n" ) , BinOp ( "-" , Name ( "n" ) , Int ( 1 ) ) )  Return ( BinOp ( "*" , Name ( "factorial_n" ) , Call ( Name ( "special_factorial" ) , Name ( "n" ) ) ) )  .Stmts )
