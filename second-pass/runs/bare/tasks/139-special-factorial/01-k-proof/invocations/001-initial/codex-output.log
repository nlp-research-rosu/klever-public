index 0000000000000000000000000000000000000000..5f15cfd87c7540cb2fc94bb67523fd9c7d31a0a1
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,31 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  claim [factorial-call]:
+    <k> eval(Call(Name("factorial"), Int(N))) ~> KONT:K
+      => continueInt(factorialSpec(N), KONT) </k>
+    <functions> solutionFunctions </functions>
+    <env> ENV:Map </env>
+    <stack> STACK:List </stack>
+    <result> R:Result </result>
+    requires N >=Int 0
+
+  claim [special-factorial-call]:
+    <k> eval(Call(Name("special_factorial"), Int(N))) ~> KONT:K
+      => continueInt(specialFactorialSpec(N), KONT) </k>
+    <functions> solutionFunctions </functions>
+    <env> ENV:Map </env>
+    <stack> STACK:List </stack>
+    <result> R:Result </result>
+    requires N >Int 0
+
+  claim [program-correct]:
+    <k> init(solutionProgram, N) => .K </k>
+    <functions> .Map => solutionFunctions </functions>
+    <env> .Map </env>
+    <stack> .List </stack>
+    <result> noResult => result(specialFactorialSpec(N)) </result>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9b65870e5a1d8b369834f6efbe8e07f61e9b9d84
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,55 @@
+module MPY-VERIFICATION
+  imports INT
+  imports MAP
+  imports MPY-SYNTAX
+
+  syntax Int ::= "factorialSpec" "(" Int ")" [function, total, symbol(factorialSpec)]
+               | "specialFactorialSpec" "(" Int ")"
+                   [function, total, symbol(specialFactorialSpec)]
+
+  rule factorialSpec(N) => 1
+    requires N <=Int 1
+  rule factorialSpec(N) => N *Int factorialSpec(N -Int 1)
+    requires N >Int 1
+
+  rule specialFactorialSpec(N) => 1
+    requires N <=Int 1
+  rule specialFactorialSpec(N)
+    => factorialSpec(N) *Int specialFactorialSpec(N -Int 1)
+    requires N >Int 1
+
+  syntax Map ::= "solutionFunctions" [macro]
+  rule solutionFunctions
+    => ("factorial" |-> function("n",
+          If(Compare(Name("n"), CmpOp("<=", Int(1))),
+            Return(Int(1)),
+            .Stmts)
+          Return(BinOp("*", Name("n"),
+            Call(Name("factorial"), BinOp("-", Name("n"), Int(1)))))))
+       ("special_factorial" |-> function("n",
+          If(Compare(Name("n"), CmpOp("<=", Int(1))),
+            Return(Int(1)),
+            .Stmts)
+          Return(BinOp("*",
+            Call(Name("factorial"), Name("n")),
+            Call(Name("special_factorial"),
+              BinOp("-", Name("n"), Int(1)))))))
+
+  syntax Pgm ::= "solutionProgram" [macro]
+  rule solutionProgram
+    => Module(
+         FuncDef("factorial", Params("n"),
+           If(Compare(Name("n"), CmpOp("<=", Int(1))),
+             Return(Int(1)),
+             .Stmts)
+           Return(BinOp("*", Name("n"),
+             Call(Name("factorial"), BinOp("-", Name("n"), Int(1))))))
+         FuncDef("special_factorial", Params("n"),
+           If(Compare(Name("n"), CmpOp("<=", Int(1))),
+             Return(Int(1)),
+             .Stmts)
+           Return(BinOp("*",
+             Call(Name("factorial"), Name("n")),
+             Call(Name("special_factorial"),
+               BinOp("-", Name("n"), Int(1)))))))
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module MPY --syntax-module MPY-SYNTAX --output-definition semantic-proof3-kompiled && krun solution.mpy -cN=4 --definition semantic-proof3-kompiled --output pretty && kprove spec.k --definition semantic-proof3-kompiled --claims SPEC.factorial-call --output pretty' in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..a50360dc8abc5a12e842ec9960d4fb9d883f49d0
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,119 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")" [symbol(Module)]
+
+  syntax Stmts ::= List{Stmt, ""} [symbol(Stmts)]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                | "Return" "(" Expr ")"                         [symbol(Return)]
+                | "If" "(" Expr "," Stmts "," Stmts ")"      [symbol(If)]
+
+  syntax Params ::= "Params" "(" String ")" [symbol(Params)]
+
+  syntax Expr ::= "Int" "(" Int ")"                            [symbol(IntExpr)]
+                | "Name" "(" String ")"                        [symbol(Name)]
+                | "BinOp" "(" String "," Expr "," Expr ")"   [symbol(BinOp)]
+                | "Compare" "(" Expr "," CmpOp ")"            [symbol(Compare)]
+                | "Call" "(" Expr "," Expr ")"                [symbol(Call)]
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+  syntax Function ::= "function" "(" String "," Stmts ")" [symbol(function)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports MPY-VERIFICATION
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Result ::= "noResult" | "result" "(" Int ")" [symbol(result)]
+  syntax Frame ::= "frame" "(" Map "," K ")" [symbol(frame)]
+
+  syntax KItem ::= "init" "(" Pgm "," Int ")"              [symbol(init)]
+                 | "load" "(" Stmts ")"                    [symbol(load)]
+                 | "start" "(" Int ")"                     [symbol(start)]
+                 | "eval" "(" Expr ")"                     [symbol(eval)]
+                 | "exec" "(" Stmts ")"                    [symbol(exec)]
+                 | "execStmt" "(" Stmt ")"                 [symbol(execStmt)]
+                 | "binLeft" "(" String "," Expr ")"       [symbol(binLeft)]
+                 | "binRight" "(" String "," Int ")"       [symbol(binRight)]
+                 | "cmpLeft" "(" String "," Expr ")"       [symbol(cmpLeft)]
+                 | "cmpRight" "(" String "," Int ")"       [symbol(cmpRight)]
+                 | "branch" "(" Stmts "," Stmts ")"        [symbol(branch)]
+                 | "enter" "(" String ")"                  [symbol(enter)]
+                 | "continueInt" "(" Int "," K ")"         [symbol(continueInt)]
+                 | "continueBool" "(" Bool "," K ")"       [symbol(continueBool)]
+                 | "returning"                               [symbol(returning)]
+                 | "finish"                                  [symbol(finish)]
+
+  configuration
+    <mpy>
+      <k> init($PGM:Pgm, $N:Int) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <stack> .List </stack>
+      <result> noResult </result>
+    </mpy>
+
+  rule <k> init(Module(SS), N) => load(SS) ~> start(N) ... </k>
+
+  rule <k> load(.Stmts) => . ... </k>
+  rule <k> load(FuncDef(F, Params(P), BODY) REST)
+        => load(REST) ... </k>
+       <functions> FUNS => FUNS [ F <- function(P, BODY) ] </functions>
+
+  rule <k> start(N)
+        => eval(Call(Name("special_factorial"), Int(N))) ~> finish ... </k>
+
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S REST) => execStmt(S) ~> exec(REST) ... </k>
+
+  rule <k> execStmt(If(E, THEN, ELSE)) => eval(E) ~> branch(THEN, ELSE) ... </k>
+  rule <k> continueBool(true, branch(THEN, _ELSE) ~> KONT)
+        => exec(THEN) ~> KONT </k>
+  rule <k> continueBool(false, branch(_THEN, ELSE) ~> KONT)
+        => exec(ELSE) ~> KONT </k>
+
+  rule <k> execStmt(Return(E)) => eval(E) ~> returning ... </k>
+
+  rule <k> eval(Int(I)) ~> KONT:K => continueInt(I, KONT) </k>
+  rule <k> eval(Name(X)) ~> KONT:K => continueInt(I, KONT) </k>
+       <env>... X |-> I:Int ...</env>
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT))
+        => eval(LEFT) ~> binLeft(OP, RIGHT) ... </k>
+  rule <k> continueInt(I, binLeft(OP, RIGHT) ~> KONT)
+        => eval(RIGHT) ~> binRight(OP, I) ~> KONT </k>
+  rule <k> continueInt(J, binRight("*", I) ~> KONT)
+        => continueInt(I *Int J, KONT) </k>
+  rule <k> continueInt(J, binRight("-", I) ~> KONT)
+        => continueInt(I -Int J, KONT) </k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+        => eval(LEFT) ~> cmpLeft(OP, RIGHT) ... </k>
+  rule <k> continueInt(I, cmpLeft(OP, RIGHT) ~> KONT)
+        => eval(RIGHT) ~> cmpRight(OP, I) ~> KONT </k>
+  rule <k> continueInt(J, cmpRight("<=", I) ~> KONT)
+        => continueBool(I <=Int J, KONT) </k>
+
+  rule <k> eval(Call(Name(F), ARG)) => eval(ARG) ~> enter(F) ... </k>
+  rule <k> continueInt(V, enter(F) ~> KONT) => exec(BODY) </k>
+       <functions>... F |-> function(P, BODY) ...</functions>
+       <env> ENV => P |-> V </env>
+       <stack> STACK => ListItem(frame(ENV, KONT)) STACK </stack>
+
+  rule <k> continueInt(V, returning ~> _REST:K) => continueInt(V, KONT) </k>
+       <env> _ => ENV </env>
+       <stack> ListItem(frame(ENV, KONT)) STACK => STACK </stack>
+
+  rule <k> continueInt(V, finish) => .K </k>
+       <result> noResult => result(V) </result>
+endmodule
