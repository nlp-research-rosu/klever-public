+       <env> _ => ENV </env>
+       <stack> push(frame(F, ENV, KONT), STACK) => STACK </stack>
+
+  rule <k> returned(_F, V, KONT) => continueInt(V, KONT) </k>
+
+  rule <k> continueInt(V, finish) => .K </k>
+       <result> noResult => result(V) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd199a090bdc5668e006317b0790f1fb61913ee4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def factorial(n):
+    if n <= 1:
+        return 1
+    old_n = n
+    n = n - 1
+    return old_n * factorial(n)
+
+
+def special_factorial(n):
+    if n <= 1:
+        return 1
+    factorial_n = factorial(n)
+    n = n - 1
+    return factorial_n * special_factorial(n)
