diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd199a090bdc5668e006317b0790f1fb61913ee4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def factorial(n):
+    if n <= 1:
+        return 1
+    old_n = n
+    n = n - 1
+    return old_n * factorial(n)
+
+
+def special_factorial(n):
+    if n <= 1:
+        return 1
+    factorial_n = factorial(n)
+    n = n - 1
+    return factorial_n * special_factorial(n)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..257eb8e49d5b75fea386444f00fabf5a62814429
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,36 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  claim [cmp-symbolic]:
+    <k> continueInt(N, cmpLeft("<=", Int(1)) ~> .K)
+      => continueBool(N <=Int 1, .K) </k>
+    requires N >Int 0
+
+  claim [factorial-call]:
+    <k> eval(Call(Name("factorial"), Name("n"))) ~> KONT:K
+      => returned("factorial", factorialSpec(N), KONT) </k>
+    <functions> solutionFunctions </functions>
+    <env> "n" |-> N ENV:Map </env>
+    <stack> STACK:CallStack </stack>
+    <result> R:Result </result>
+    requires N >Int 0
+
+  claim [special-factorial-call]:
+    <k> eval(Call(Name("special_factorial"), Name("n"))) ~> KONT:K
+      => returned("special_factorial", specialFactorialSpec(N), KONT) </k>
+    <functions> solutionFunctions </functions>
+    <env> "n" |-> N ENV:Map </env>
+    <stack> STACK:CallStack </stack>
+    <result> R:Result </result>
+    requires N >Int 0
+
+  claim [program-correct]:
+    <k> init(solutionProgram, N) => .K </k>
+    <functions> .Map => solutionFunctions </functions>
+    <env> .Map </env>
+    <stack> .CallStack </stack>
+    <result> noResult => result(specialFactorialSpec(N)) </result>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2a652a7dbf48c1b719b2a5b6283e30fb84980852
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,61 @@
+module MPY-VERIFICATION
+  imports INT
+  imports MAP
+  imports MPY-SYNTAX
+
+  syntax Int ::= "factorialSpec" "(" Int ")" [function, total, symbol(factorialSpec)]
+               | "specialFactorialSpec" "(" Int ")"
+                   [function, total, symbol(specialFactorialSpec)]
+
+  rule factorialSpec(N) => 1
+    requires N <=Int 1
+  rule factorialSpec(N) => N *Int factorialSpec(N -Int 1)
+    requires N >Int 1
+
+  rule specialFactorialSpec(N) => 1
+    requires N <=Int 1
+  rule specialFactorialSpec(N)
+    => factorialSpec(N) *Int specialFactorialSpec(N -Int 1)
+    requires N >Int 1
+
+  syntax Map ::= "solutionFunctions" [macro]
+  rule solutionFunctions
+    => ("factorial" |-> function("n",
+          If(Compare(Name("n"), CmpOp("<=", Int(1))),
+            Return(Int(1)),
+            .Stmts)
+          Assign(Name("old_n"), Name("n"))
+          Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+          Return(BinOp("*", Name("old_n"),
+            Call(Name("factorial"), Name("n")))))
+       ("special_factorial" |-> function("n",
+          If(Compare(Name("n"), CmpOp("<=", Int(1))),
+            Return(Int(1)),
+            .Stmts)
+          Assign(Name("factorial_n"),
+            Call(Name("factorial"), Name("n")))
+          Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+          Return(BinOp("*", Name("factorial_n"),
+            Call(Name("special_factorial"), Name("n")))))))
+
+  syntax Pgm ::= "solutionProgram" [macro]
+  rule solutionProgram
+    => Module(
+         FuncDef("factorial", Params("n"),
+           If(Compare(Name("n"), CmpOp("<=", Int(1))),
+             Return(Int(1)),
+             .Stmts)
+           Assign(Name("old_n"), Name("n"))
+           Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+           Return(BinOp("*", Name("old_n"),
+             Call(Name("factorial"), Name("n"))))
+         FuncDef("special_factorial", Params("n"),
+           If(Compare(Name("n"), CmpOp("<=", Int(1))),
+             Return(Int(1)),
+             .Stmts)
+           Assign(Name("factorial_n"),
+             Call(Name("factorial"), Name("n")))
+           Assign(Name("n"), BinOp("-", Name("n"), Int(1)))
+           Return(BinOp("*", Name("factorial_n"),
+             Call(Name("special_factorial"), Name("n")))))))
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module MPY --syntax-module MPY-SYNTAX --output-definition semantic-proof10-kompiled && krun solution.mpy -cN=4 --definition semantic-proof10-kompiled --output pretty && timeout 60s kprove spec.k --definition semantic-proof10-kompiled --claims SPEC.factorial-call --output pretty' in /work
