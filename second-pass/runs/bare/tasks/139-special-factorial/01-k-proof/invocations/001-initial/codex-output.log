+def factorial(n):
+    if n <= 1:
+        return 1
+    return n * factorial(n - 1)
+
+
+def special_factorial(n):
+    if n <= 1:
+        return 1
+    return factorial(n) * special_factorial(n - 1)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3eeca65b9cf9393ee54f5f3689793df0590074c5
