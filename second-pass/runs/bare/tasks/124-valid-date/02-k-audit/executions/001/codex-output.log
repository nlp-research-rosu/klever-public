     6	def valid_date(date):
     7	    """You have to write a function which validates a given date string and
     8	    returns True if the date is valid otherwise False.
     9	    The date is valid if all of the following rules are satisfied:
    10	    1. The date string is not empty.
    11	    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.
    12	    3. The months should not be less than 1 or higher than 12.
    13	    4. The date should be in the format: mm-dd-yyyy
    14	
    15	    for example: 
    16	    valid_date('03-11-2000') => True
    17	
    18	    valid_date('15-01-2012') => False
    19	
    20	    valid_date('04-0-2040') => False
    21	
    22	    valid_date('06-04-2020') => True
    23	
    24	    valid_date('06/04/2020') => False
    25	    """
    26	    try:
    27	        date = date.strip()
    28	        month, day, year = date.split('-')
    29	        month, day, year = int(month), int(day), int(year)
    30	        if month < 1 or month > 12:
    31	            return False
    32	        if month in [1,3,5,7,8,10,12] and day < 1 or day > 31:
    33	            return False
    34	        if month in [4,6,9,11] and day < 1 or day > 30:
    35	            return False
    36	        if month == 2 and day < 1 or day > 29:
    37	            return False
    38	    except:
    39	        return False
    40	
    41	    return True
