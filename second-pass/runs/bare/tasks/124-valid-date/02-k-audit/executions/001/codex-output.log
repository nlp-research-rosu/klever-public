     1	def valid_date(date):
     2	    if len(date) != 10:
     3	        return False
     4	
     5	    if date[2] != "-" or date[5] != "-":
     6	        return False
     7	
     8	    month_text = date[0:2]
     9	    day_text = date[3:5]
    10	    year_text = date[6:10]
    11	
    12	    if not (month_text.isdigit() and day_text.isdigit() and year_text.isdigit()):
    13	        return False
    14	
    15	    month = int(month_text)
    16	    day = int(day_text)
    17	
    18	    if month < 1 or month > 12:
    19	        return False
    20	
    21	    if month == 2:
    22	        return day >= 1 and day <= 29
    23	
    24	    if month == 4 or month == 6 or month == 9 or month == 11:
    25	        return day >= 1 and day <= 30
    26	
    27	    return day >= 1 and day <= 31
