diff --git a//tmp/audit-work/68-pluck-audit/opposite-interpretation.k b//tmp/audit-work/68-pluck-audit/opposite-interpretation.k
new file mode 100644
index 0000000000000000000000000000000000000000..bd433fb6c181e520140aaf28f6ec56f56113f4c7
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/opposite-interpretation.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+module OPPOSITE-INTERPRETATION
+  imports SEMANTIC
+
+  // A ground completion admitted by semantic.k's otherwise unconstrained
+  // result-bearing minEvenArray symbol.  It is deliberately wrong for the
+  // intended concrete list [2].
+  rule minEvenArray(69, 0, 1) => VList(.Ints)
+  rule arrayAt(69, 0) => 2
+endmodule
diff --git a//tmp/audit-work/68-pluck-audit/pinning-spec.k b//tmp/audit-work/68-pluck-audit/pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a1c95e21d286e62ff529bf2440d483be22606494
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/pinning-spec.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // Mechanical constructor equality between the claim's solutionProgram
+  // abbreviation and the trusted-regenerated solution.mpy term.
+  claim
+    <py>
+      <k>
+        solutionProgram
+        =>
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Return(
+              Call(
+                Name("min"),
+                ListComp(ListExpr(Name("value"), Name("index")),
+                  CompFor(
+                    TupleExpr(Name("index"), Name("value")),
+                    Call(Name("enumerate"), Name("arr")),
+                    Compare(
+                      BinOp("%", Name("value"), Int(2)),
+                      CmpOp("==", Int(0))))),
+                KwArg("default", ListExpr(.Exprs))))))
+      </k>
+      <args> VNone </args>
+      <env> .Map </env>
+      <funs> .Map </funs>
+      <stack> .List </stack>
+      <result> VNone </result>
+    </py>
+endmodule
diff --git a//tmp/audit-work/68-pluck-audit/spec-body-mutation.k b//tmp/audit-work/68-pluck-audit/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..57182b9d865fcb5b70e039584a2460115acdec9b
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/spec-body-mutation.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // False body sensitivity probe: execute a function that always returns []
+  // while retaining the real target result.  LENGTH=1 and arrayAt(ID,0)=2 is
+  // a satisfying counterexample.
+  claim
+    <py>
+      <k>
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Return(ListExpr(.Exprs))))
+        ~> start
+        => .K
+      </k>
+      <args> VArray(ID, 0, LENGTH) </args>
+      <env> .Map => .Map </env>
+      <funs> .Map
+        => "pluck" |->
+             fun(Params("arr"), Return(ListExpr(.Exprs))) </funs>
+      <stack> .List => .List </stack>
+      <result> VNone
+        => specScanArray(ID, 0, LENGTH, 0, 0, 0, 0) </result>
+    </py>
+    requires LENGTH >=Int 0
+endmodule
+
diff --git a//tmp/audit-work/68-pluck-audit/spec-no-bridge.k b//tmp/audit-work/68-pluck-audit/spec-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..09b5d1d4486f54c1b8c9727037d08bc5d69a22ef
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/spec-no-bridge.k
@@ -0,0 +1,18 @@
+requires "verification-no-bridge.k"
+
+module SPEC-NO-BRIDGE
+  imports VERIFICATION-NO-BRIDGE
+
+  claim
+    <py>
+      <k> solutionProgram ~> start => .K </k>
+      <args> VArray(ID, 0, LENGTH) </args>
+      <env> .Map => .Map </env>
+      <funs> .Map => solutionFunctions </funs>
+      <stack> .List => .List </stack>
+      <result> VNone
+        => specScanArray(ID, 0, LENGTH, 0, 0, 0, 0) </result>
+    </py>
+    requires LENGTH >=Int 0
+endmodule
+
diff --git a//tmp/audit-work/68-pluck-audit/verification-no-bridge.k b//tmp/audit-work/68-pluck-audit/verification-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..a9b33fc8538b3c4306e3e65b89d202526f02f909
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/verification-no-bridge.k
@@ -0,0 +1,80 @@
+requires "semantic.k"
+
+module VERIFICATION-NO-BRIDGE
+  imports SEMANTIC
+
+  syntax Val ::= "specScanArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+               | "specFinish" "(" Int "," Int "," Int ")"
+                   [function, total]
+               | "specConsiderArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+               | "specEvenArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+
+  rule specScanArray(_ID, _OFFSET, LENGTH, _INDEX, BEST, BESTINDEX, FOUND)
+       => specFinish(BEST, BESTINDEX, FOUND)
+       requires LENGTH ==Int 0
+  rule specScanArray(ID, OFFSET, LENGTH, INDEX, BEST, BESTINDEX, FOUND)
+       => specConsiderArray(arrayAt(ID, OFFSET), ID, OFFSET, LENGTH,
+                            INDEX, BEST, BESTINDEX, FOUND)
+       requires LENGTH >Int 0
+
+  rule specFinish(_BEST, _BESTINDEX, FOUND) => VList(.Ints)
+       requires FOUND ==Int 0
+  rule specFinish(BEST, BESTINDEX, FOUND) => VList(BEST, BESTINDEX)
+       requires FOUND =/=Int 0
+
+  rule specConsiderArray(HEAD, ID, OFFSET, LENGTH,
+                         INDEX, BEST, BESTINDEX, FOUND)
+       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
+                        INDEX +Int 1, BEST, BESTINDEX, FOUND)
+       requires HEAD modInt 2 =/=Int 0
+  rule specConsiderArray(HEAD, ID, OFFSET, LENGTH,
+                         INDEX, BEST, BESTINDEX, FOUND)
+       => specEvenArray(HEAD, ID, OFFSET, LENGTH,
+                        INDEX, BEST, BESTINDEX, FOUND)
+       requires HEAD modInt 2 ==Int 0
+
+  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
+                     INDEX, _BEST, _BESTINDEX, FOUND)
+       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
+                        INDEX +Int 1, HEAD, INDEX, 1)
+       requires FOUND ==Int 0
+  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
+                     INDEX, BEST, _BESTINDEX, FOUND)
+       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
+                        INDEX +Int 1, HEAD, INDEX, FOUND)
+       requires FOUND =/=Int 0 andBool HEAD <Int BEST
+  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
+                     INDEX, BEST, BESTINDEX, FOUND)
+       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
+                        INDEX +Int 1, BEST, BESTINDEX, FOUND)
+       requires FOUND =/=Int 0 andBool HEAD >=Int BEST
+
+  // Intentionally no minEvenArray equation.
+
+  syntax Stmts ::= "pluckBody" [function, total]
+  syntax Program ::= "solutionProgram" [function, total]
+  syntax Map ::= "solutionFunctions" [function, total]
+
+  rule pluckBody =>
+    Return(Call(
+      Name("min"),
+      ListComp(
+        ListExpr(Name("value"), Name("index")),
+        CompFor(
+          TupleExpr(Name("index"), Name("value")),
+          Call(Name("enumerate"), Name("arr")),
+          Compare(
+            BinOp("%", Name("value"), Int(2)),
+            CmpOp("==", Int(0))))),
+      KwArg("default", ListExpr(.Exprs))))
+
+  rule solutionProgram =>
+    Module(FuncDef("pluck", Params("arr"), pluckBody))
+
+  rule solutionFunctions =>
+    "pluck" |-> fun(Params("arr"), pluckBody)
+endmodule
+
diff --git a//tmp/audit-work/68-pluck-audit/witness.k b//tmp/audit-work/68-pluck-audit/witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..a2bababce7ca64fd17c83d12846186de8f7c4360
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/witness.k
@@ -0,0 +1,10 @@
+requires "verification.k"
+
+module WITNESS
+  imports VERIFICATION
+
+  // Ground interpretation representing the concrete list [4, 2, 3].
+  rule arrayAt(68, 0) => 4
+  rule arrayAt(68, 1) => 2
+  rule arrayAt(68, 2) => 3
+endmodule
diff --git a/evidence/adequacy_checks.sh b/evidence/adequacy_checks.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b74343fa029d8b673ba9773e038e1597240b8933
--- /dev/null
+++ b/evidence/adequacy_checks.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/68-pluck-audit
+proof_definition="$scratch/proof-audit-kompiled"
+concrete_definition="$scratch/concrete-audit-kompiled"
+witness_definition="$scratch/witness-audit2-kompiled"
+
+echo '$ kprove pinning-spec.k --definition proof-audit-kompiled --spec-module PINNING-SPEC'
+pinning_output=$(
+  kprove "$scratch/pinning-spec.k" \
+    --definition "$proof_definition" \
+    --spec-module PINNING-SPEC 2>&1
+)
+pinning_status=$?
+printf '%s\n' "$pinning_output"
+echo "constructor pinning kprove exit=$pinning_status"
+[[ "$pinning_output" == *"#Top"* ]]
+pinning_top=$?
+echo "constructor pinning #Top check exit=$pinning_top"
+
+echo '$ krun solution.mpy --definition concrete-audit-kompiled -cARGS=VArray(68,0,3)'
+baseline_output=$(
+  krun "$scratch/solution.mpy" \
+    --definition "$concrete_definition" \
+    -cARGS='VArray(68,0,3)' 2>&1
+)
+baseline_status=$?
+printf '%s\n' "$baseline_output"
+echo "fixed semantic.k symbolic-array krun exit=$baseline_status"
+[[ "$baseline_output" == *"minEvenArray ( 68 , 0 , 3 )"* ]]
+baseline_residual=$?
+echo "fixed semantic.k residual minEvenArray check exit=$baseline_residual"
+
+echo '$ test ! -e witness-audit2-kompiled'
+test ! -e "$witness_definition"
+witness_clean=$?
+echo "witness clean-start exit=$witness_clean"
+
+echo '$ kompile --backend llvm witness.k --main-module WITNESS --syntax-module MPY-SYNTAX --output-definition witness-audit2-kompiled'
+kompile \
+  --backend llvm \
+  "$scratch/witness.k" \
+  --main-module WITNESS \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$witness_definition"
+witness_build=$?
+echo "witness kompile exit=$witness_build"
+
+echo '$ krun solution.mpy --definition witness-audit2-kompiled -cARGS=VArray(68,0,3)'
+witness_output=$(
+  krun "$scratch/solution.mpy" \
+    --definition "$witness_definition" \
+    -cARGS='VArray(68,0,3)' 2>&1
+)
+witness_run=$?
+printf '%s\n' "$witness_output"
+echo "witness krun exit=$witness_run"
+grep -Fq '    VList ( 2 , 1 , .Ints )' <<<"$witness_output"
+witness_result=$?
+echo "witness expected result [2,1] check exit=$witness_result"
+
+echo '$ trusted canonical and submitted Python on [4,2,3]'
+python3 - "$scratch/trusted-canonical.py" "$scratch/solution.py" <<'PY'
+import importlib.util
+import sys
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.pluck
+
+canonical = load(sys.argv[1], "canonical_witness")
+submitted = load(sys.argv[2], "submitted_witness")
+arr = [4, 2, 3]
+print(f"input={arr}")
+print(f"canonical={canonical(arr)}")
+print(f"submitted={submitted(arr)}")
+raise SystemExit(0 if canonical(arr) == submitted(arr) == [2, 1] else 1)
+PY
+python_witness=$?
+echo "Python witness comparison exit=$python_witness"
+
+overall=$((pinning_status || pinning_top || baseline_residual || witness_clean || witness_build || witness_run || witness_result || python_witness))
+echo "adequacy mechanical checks aggregate exit=$overall"
+exit "$overall"
diff --git a/evidence/body_sensitivity.sh b/evidence/body_sensitivity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..7960eb8db4f44edc235feab55c06df899cd2410e
