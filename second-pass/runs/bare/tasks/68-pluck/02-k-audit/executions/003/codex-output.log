     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Independent contract over an arbitrary finite integer array.  ID names
     7	  // an unconstrained element oracle, OFFSET is its current position, and
     8	  // LENGTH is the remaining length.  FOUND = 0 means no even value has been
     9	  // seen; otherwise BEST/BESTINDEX retain the smallest value and first index.
    10	  syntax Val ::= "specScanArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
    11	                   [function, total]
    12	               | "specFinish" "(" Int "," Int "," Int ")"
    13	                   [function, total]
    14	               | "specConsiderArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
    15	                   [function, total]
    16	               | "specEvenArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
    17	                   [function, total]
    18	
    19	  rule specScanArray(_ID, _OFFSET, LENGTH, _INDEX, BEST, BESTINDEX, FOUND)
    20	       => specFinish(BEST, BESTINDEX, FOUND)
    21	       requires LENGTH ==Int 0
    22	  rule specScanArray(ID, OFFSET, LENGTH, INDEX, BEST, BESTINDEX, FOUND)
    23	       => specConsiderArray(arrayAt(ID, OFFSET), ID, OFFSET, LENGTH,
    24	                            INDEX, BEST, BESTINDEX, FOUND)
    25	       requires LENGTH >Int 0
    26	
    27	  rule specFinish(_BEST, _BESTINDEX, FOUND) => VList(.Ints)
    28	       requires FOUND ==Int 0
    29	  rule specFinish(BEST, BESTINDEX, FOUND) => VList(BEST, BESTINDEX)
    30	       requires FOUND =/=Int 0
    31	
    32	  rule specConsiderArray(HEAD, ID, OFFSET, LENGTH,
    33	                         INDEX, BEST, BESTINDEX, FOUND)
    34	       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
    35	                        INDEX +Int 1, BEST, BESTINDEX, FOUND)
    36	       requires HEAD modInt 2 =/=Int 0
    37	  rule specConsiderArray(HEAD, ID, OFFSET, LENGTH,
    38	                         INDEX, BEST, BESTINDEX, FOUND)
    39	       => specEvenArray(HEAD, ID, OFFSET, LENGTH,
    40	                        INDEX, BEST, BESTINDEX, FOUND)
    41	       requires HEAD modInt 2 ==Int 0
    42	
    43	  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
    44	                     INDEX, _BEST, _BESTINDEX, FOUND)
    45	       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
    46	                        INDEX +Int 1, HEAD, INDEX, 1)
    47	       requires FOUND ==Int 0
    48	  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
    49	                     INDEX, BEST, _BESTINDEX, FOUND)
    50	       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
    51	                        INDEX +Int 1, HEAD, INDEX, FOUND)
    52	       requires FOUND =/=Int 0 andBool HEAD <Int BEST
    53	  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
    54	                     INDEX, BEST, BESTINDEX, FOUND)
    55	       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
    56	                        INDEX +Int 1, BEST, BESTINDEX, FOUND)
    57	       requires FOUND =/=Int 0 andBool HEAD >=Int BEST
    58	
    59	  // The abstract result of Python's enumerate/filter/min composition is tied
    60	  // to the same scan contract.  arrayAt is uninterpreted, so this equation
    61	  // makes no assumptions about the array's elements.
    62	  rule minEvenArray(ID, OFFSET, LENGTH)
    63	       => specScanArray(ID, OFFSET, LENGTH, 0, 0, 0, 0)
    64	
    65	  // Exact constructor form generated in solution.mpy.
    66	  syntax Stmts ::= "pluckBody" [function, total]
    67	  syntax Program ::= "solutionProgram" [function, total]
    68	  syntax Map ::= "solutionFunctions" [function, total]
    69	
    70	  rule pluckBody =>
    71	    Return(Call(
    72	      Name("min"),
    73	      ListComp(
    74	        ListExpr(Name("value"), Name("index")),
    75	        CompFor(
    76	          TupleExpr(Name("index"), Name("value")),
    77	          Call(Name("enumerate"), Name("arr")),
    78	          Compare(
    79	            BinOp("%", Name("value"), Int(2)),
    80	            CmpOp("==", Int(0))))),
    81	      KwArg("default", ListExpr(.Exprs))))
    82	
    83	  rule solutionProgram =>
    84	    Module(FuncDef("pluck", Params("arr"), pluckBody))
    85	
    86	  rule solutionFunctions =>
    87	    "pluck" |-> fun(Params("arr"), pluckBody)
    88	endmodule

===== /candidate/spec.k =====
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // End-to-end theorem for every finite integer array.  The program syntax is
     7	  // the exact py2mpy translation, while the destination is the independent
     8	  // minimum-even/first-index scan contract above.
     9	  claim
    10	    <py>
    11	      <k> solutionProgram ~> start => .K </k>
    12	      <args> VArray(ID, 0, LENGTH) </args>
    13	      <env> .Map => .Map </env>
    14	      <funs> .Map => solutionFunctions </funs>
    15	      <stack> .List => .List </stack>
    16	      <result> VNone
    17	        => specScanArray(ID, 0, LENGTH, 0, 0, 0, 0) </result>
    18	    </py>
    19	    requires LENGTH >=Int 0
    20	endmodule

===== /candidate/prove.sh =====
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Recreate the translated program from the fixed translator.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# The LLVM definition is used only for ordinary concrete execution.
     8	kompile semantic.k \
     9	  --backend llvm \
    10	  --main-module SEMANTIC \
    11	  --syntax-module MPY-SYNTAX
    12	
    13	# Exercise every example from prompt.py with the operational semantics.
    14	krun solution.mpy --definition semantic-kompiled -cARGS='VList(4, 2, 3)'
    15	krun solution.mpy --definition semantic-kompiled -cARGS='VList(1, 2, 3)'
    16	krun solution.mpy --definition semantic-kompiled -cARGS='VList()'
    17	krun solution.mpy --definition semantic-kompiled -cARGS='VList(5, 0, 3, 0, 4, 2)'
    18	krun solution.mpy --definition semantic-kompiled -cARGS='VList(7, 5, 9)'
    19	krun solution.mpy --definition semantic-kompiled -cARGS='VList(2, 2)'
    20	
    21	# The Haskell backend proves the universal claim in spec.k.  The final command
    22	# prints #Top and exits 0.
    23	kompile verification.k \
    24	  --backend haskell \
    25	  --main-module VERIFICATION \
    26	  --syntax-module MPY-SYNTAX
    27	kprove spec.k --definition verification-kompiled

