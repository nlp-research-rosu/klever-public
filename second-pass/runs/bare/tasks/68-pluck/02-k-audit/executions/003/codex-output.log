+echo "false mutation kprove exit=$mutation_status"
+
+if (( mutation_status == 0 )); then
+  echo 'UNEXPECTED: false result mutation proved'
+  exit 1
+fi
+[[ "$mutation_output" == *"WarnStuckClaimState"* ]]
