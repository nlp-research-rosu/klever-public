+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // Mechanical constructor equality between the claim's solutionProgram
+  // abbreviation and the trusted-regenerated solution.mpy term.
+  claim
+    <py>
+      <k>
+        solutionProgram
+        =>
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Return(
+              Call(
+                Name("min"),
+                ListComp(ListExpr(Name("value"), Name("index")),
+                  CompFor(
+                    TupleExpr(Name("index"), Name("value")),
+                    Call(Name("enumerate"), Name("arr")),
+                    Compare(
+                      BinOp("%", Name("value"), Int(2)),
+                      CmpOp("==", Int(0))))),
+                KwArg("default", ListExpr(.Exprs))))))
+      </k>
+      <args> VNone </args>
+      <env> .Map </env>
+      <funs> .Map </funs>
+      <stack> .List </stack>
+      <result> VNone </result>
+    </py>
+endmodule
diff --git a//tmp/audit-work/68-pluck-audit/shadow-enumerate.py b//tmp/audit-work/68-pluck-audit/shadow-enumerate.py
new file mode 100644
index 0000000000000000000000000000000000000000..eb5848b7afaa78e80cc4177f5599dd19299093f8
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/shadow-enumerate.py
@@ -0,0 +1,9 @@
+def enumerate(arr):
+    return []
+
+
+def pluck(arr):
+    return min(
+        [[value, index] for index, value in enumerate(arr) if value % 2 == 0],
+        default=[],
+    )
