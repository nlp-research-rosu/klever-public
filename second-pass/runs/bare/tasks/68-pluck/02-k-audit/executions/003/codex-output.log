@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // Mechanical constructor equality between the claim's solutionProgram
+  // abbreviation and the trusted-regenerated solution.mpy term.
+  claim solutionProgram
+    =>
+    Module(
+      FuncDef("pluck", Params("arr"),
+        Return(
+          Call(
+            Name("min"),
+            ListComp(ListExpr(Name("value"), Name("index")),
+              CompFor(
+                TupleExpr(Name("index"), Name("value")),
+                Call(Name("enumerate"), Name("arr")),
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))))),
+            KwArg("default", ListExpr(.Exprs))))))
+endmodule
+
diff --git a//tmp/audit-work/68-pluck-audit/spec-body-mutation.k b//tmp/audit-work/68-pluck-audit/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..57182b9d865fcb5b70e039584a2460115acdec9b
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/spec-body-mutation.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // False body sensitivity probe: execute a function that always returns []
+  // while retaining the real target result.  LENGTH=1 and arrayAt(ID,0)=2 is
+  // a satisfying counterexample.
+  claim
+    <py>
+      <k>
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Return(ListExpr(.Exprs))))
+        ~> start
+        => .K
+      </k>
+      <args> VArray(ID, 0, LENGTH) </args>
+      <env> .Map => .Map </env>
+      <funs> .Map
+        => "pluck" |->
+             fun(Params("arr"), Return(ListExpr(.Exprs))) </funs>
+      <stack> .List => .List </stack>
+      <result> VNone
+        => specScanArray(ID, 0, LENGTH, 0, 0, 0, 0) </result>
+    </py>
+    requires LENGTH >=Int 0
+endmodule
+
