diff --git a//tmp/audit-work/68-pluck-audit/opposite-interpretation.k b//tmp/audit-work/68-pluck-audit/opposite-interpretation.k
new file mode 100644
index 0000000000000000000000000000000000000000..bd433fb6c181e520140aaf28f6ec56f56113f4c7
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/opposite-interpretation.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+module OPPOSITE-INTERPRETATION
+  imports SEMANTIC
+
+  // A ground completion admitted by semantic.k's otherwise unconstrained
+  // result-bearing minEvenArray symbol.  It is deliberately wrong for the
+  // intended concrete list [2].
+  rule minEvenArray(69, 0, 1) => VList(.Ints)
+  rule arrayAt(69, 0) => 2
+endmodule
diff --git a//tmp/audit-work/68-pluck-audit/pinning-spec.k b//tmp/audit-work/68-pluck-audit/pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a1c95e21d286e62ff529bf2440d483be22606494
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/pinning-spec.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // Mechanical constructor equality between the claim's solutionProgram
+  // abbreviation and the trusted-regenerated solution.mpy term.
+  claim
+    <py>
+      <k>
+        solutionProgram
+        =>
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Return(
+              Call(
+                Name("min"),
+                ListComp(ListExpr(Name("value"), Name("index")),
+                  CompFor(
+                    TupleExpr(Name("index"), Name("value")),
+                    Call(Name("enumerate"), Name("arr")),
+                    Compare(
+                      BinOp("%", Name("value"), Int(2)),
+                      CmpOp("==", Int(0))))),
+                KwArg("default", ListExpr(.Exprs))))))
+      </k>
+      <args> VNone </args>
+      <env> .Map </env>
+      <funs> .Map </funs>
+      <stack> .List </stack>
+      <result> VNone </result>
+    </py>
+endmodule
diff --git a//tmp/audit-work/68-pluck-audit/spec-body-mutation.k b//tmp/audit-work/68-pluck-audit/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..57182b9d865fcb5b70e039584a2460115acdec9b
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/spec-body-mutation.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // False body sensitivity probe: execute a function that always returns []
+  // while retaining the real target result.  LENGTH=1 and arrayAt(ID,0)=2 is
+  // a satisfying counterexample.
+  claim
+    <py>
+      <k>
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Return(ListExpr(.Exprs))))
+        ~> start
+        => .K
+      </k>
+      <args> VArray(ID, 0, LENGTH) </args>
+      <env> .Map => .Map </env>
+      <funs> .Map
+        => "pluck" |->
+             fun(Params("arr"), Return(ListExpr(.Exprs))) </funs>
+      <stack> .List => .List </stack>
+      <result> VNone
+        => specScanArray(ID, 0, LENGTH, 0, 0, 0, 0) </result>
+    </py>
+    requires LENGTH >=Int 0
+endmodule
+
diff --git a//tmp/audit-work/68-pluck-audit/spec-no-bridge.k b//tmp/audit-work/68-pluck-audit/spec-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..09b5d1d4486f54c1b8c9727037d08bc5d69a22ef
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/spec-no-bridge.k
@@ -0,0 +1,18 @@
+requires "verification-no-bridge.k"
+
+module SPEC-NO-BRIDGE
+  imports VERIFICATION-NO-BRIDGE
+
+  claim
+    <py>
+      <k> solutionProgram ~> start => .K </k>
+      <args> VArray(ID, 0, LENGTH) </args>
+      <env> .Map => .Map </env>
+      <funs> .Map => solutionFunctions </funs>
+      <stack> .List => .List </stack>
+      <result> VNone
+        => specScanArray(ID, 0, LENGTH, 0, 0, 0, 0) </result>
+    </py>
+    requires LENGTH >=Int 0
+endmodule
+
diff --git a//tmp/audit-work/68-pluck-audit/verification-no-bridge.k b//tmp/audit-work/68-pluck-audit/verification-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..a9b33fc8538b3c4306e3e65b89d202526f02f909
--- /dev/null
+++ b//tmp/audit-work/68-pluck-audit/verification-no-bridge.k
@@ -0,0 +1,80 @@
+requires "semantic.k"
+
+module VERIFICATION-NO-BRIDGE
+  imports SEMANTIC
+
+  syntax Val ::= "specScanArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+               | "specFinish" "(" Int "," Int "," Int ")"
+                   [function, total]
+               | "specConsiderArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+               | "specEvenArray" "(" Int "," Int "," Int "," Int "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+
+  rule specScanArray(_ID, _OFFSET, LENGTH, _INDEX, BEST, BESTINDEX, FOUND)
+       => specFinish(BEST, BESTINDEX, FOUND)
+       requires LENGTH ==Int 0
+  rule specScanArray(ID, OFFSET, LENGTH, INDEX, BEST, BESTINDEX, FOUND)
+       => specConsiderArray(arrayAt(ID, OFFSET), ID, OFFSET, LENGTH,
+                            INDEX, BEST, BESTINDEX, FOUND)
+       requires LENGTH >Int 0
+
+  rule specFinish(_BEST, _BESTINDEX, FOUND) => VList(.Ints)
+       requires FOUND ==Int 0
+  rule specFinish(BEST, BESTINDEX, FOUND) => VList(BEST, BESTINDEX)
+       requires FOUND =/=Int 0
+
+  rule specConsiderArray(HEAD, ID, OFFSET, LENGTH,
+                         INDEX, BEST, BESTINDEX, FOUND)
+       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
+                        INDEX +Int 1, BEST, BESTINDEX, FOUND)
+       requires HEAD modInt 2 =/=Int 0
+  rule specConsiderArray(HEAD, ID, OFFSET, LENGTH,
+                         INDEX, BEST, BESTINDEX, FOUND)
+       => specEvenArray(HEAD, ID, OFFSET, LENGTH,
+                        INDEX, BEST, BESTINDEX, FOUND)
+       requires HEAD modInt 2 ==Int 0
+
+  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
+                     INDEX, _BEST, _BESTINDEX, FOUND)
+       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
+                        INDEX +Int 1, HEAD, INDEX, 1)
+       requires FOUND ==Int 0
+  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
+                     INDEX, BEST, _BESTINDEX, FOUND)
+       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
+                        INDEX +Int 1, HEAD, INDEX, FOUND)
+       requires FOUND =/=Int 0 andBool HEAD <Int BEST
+  rule specEvenArray(HEAD, ID, OFFSET, LENGTH,
+                     INDEX, BEST, BESTINDEX, FOUND)
+       => specScanArray(ID, OFFSET +Int 1, LENGTH -Int 1,
+                        INDEX +Int 1, BEST, BESTINDEX, FOUND)
+       requires FOUND =/=Int 0 andBool HEAD >=Int BEST
+
+  // Intentionally no minEvenArray equation.
+
+  syntax Stmts ::= "pluckBody" [function, total]
+  syntax Program ::= "solutionProgram" [function, total]
+  syntax Map ::= "solutionFunctions" [function, total]
+
+  rule pluckBody =>
+    Return(Call(
+      Name("min"),
+      ListComp(
+        ListExpr(Name("value"), Name("index")),
+        CompFor(
+          TupleExpr(Name("index"), Name("value")),
+          Call(Name("enumerate"), Name("arr")),
+          Compare(
+            BinOp("%", Name("value"), Int(2)),
+            CmpOp("==", Int(0))))),
+      KwArg("default", ListExpr(.Exprs))))
+
+  rule solutionProgram =>
+    Module(FuncDef("pluck", Params("arr"), pluckBody))
+
+  rule solutionFunctions =>
+    "pluck" |-> fun(Params("arr"), pluckBody)
+endmodule
+
