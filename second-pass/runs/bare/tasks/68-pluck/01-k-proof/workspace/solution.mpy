Module(
  FuncDef("pluck", Params("arr"),
    Return(
      Call(
        Name("min"),
        ListComp(ListExpr(Name("value"), Name("index")),
          CompFor(
            TupleExpr(Name("index"), Name("value")),
            Call(Name("enumerate"), Name("arr")),
            Compare(
              BinOp("%", Name("value"), Int(2)),
              CmpOp("==", Int(0))))),
        KwArg("default", ListExpr())))))
