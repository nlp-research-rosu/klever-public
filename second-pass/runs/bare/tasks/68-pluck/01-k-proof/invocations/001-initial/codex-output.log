@@ -0,0 +1,21 @@
+def pluck_from(arr, index, best, best_index, found):
+    if arr == []:
+        if found == 0:
+            return []
+        return [best, best_index]
+
+    value = arr[0]
+    if arr[0] % 2 == 0:
+        if found == 0:
+            best = value
+            best_index = index
+            found = 1
+        else:
+            if value < best:
+                best = value
+                best_index = index
+    return pluck_from(arr[1:], index + 1, best, best_index, found)
+
+
+def pluck(arr):
+    return pluck_from(arr, 0, 0, 0, 0)
