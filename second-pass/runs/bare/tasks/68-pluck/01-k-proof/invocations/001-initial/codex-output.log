diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..14ef681de2f069329f4d045937fdf53d16beb8f5
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,188 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "Call" "(" Expr "," Exprs ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports K-EQUAL
+  imports MAP
+  imports LIST
+
+  // Values are deliberately limited to the data used by this HumanEval task:
+  // integers, lists of integers, booleans, and Python's None result.
+  syntax Ints ::= List{Int, ","}
+  syntax Val ::= "VInt" "(" Int ")"
+               | "VList" "(" Ints ")"
+               | "VBool" "(" Bool ")"
+               | "VNone"
+  syntax Vals ::= List{Val, ","}
+
+  // Symbolic observers for a non-empty translated integer list.  Constructor
+  // equations execute concretely; on an opaque symbolic list they remain
+  // typed terms, with non-emptiness carried by the path condition.
+  syntax Int ::= "headInt" "(" Ints ")" [function, total]
+  syntax Ints ::= "tailInts" "(" Ints ")" [function, total]
+  rule headInt(I, _IS) => I
+  rule tailInts(_I, IS) => IS
+
+  syntax Fun ::= "fun" "(" Params "," Stmts ")"
+  syntax Frame ::= "frame" "(" Map "," K ")"
+  syntax ArgPack ::= "argPack" "(" Vals ")"
+
+  syntax KItem ::= "start" | "done"
+                 | "exec" "(" Stmts ")" | "execStmt" "(" Stmt ")"
+                 | "eval" "(" Expr ")" | "evalExprs" "(" Exprs ")"
+                 | "evalArgs" "(" Exprs ")"
+                 | "assignName" "(" String ")"
+                 | "select" "(" Stmts "," Stmts ")"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "cmpLeft" "(" String "," Expr ")"
+                 | "cmpRight" "(" String "," Val ")"
+                 | "collectExprs" "(" Exprs ")"
+                 | "prependInt" "(" Int ")"
+                 | "collectArgs" "(" Exprs ")"
+                 | "prependArg" "(" Val ")"
+                 | "takeTail" | "subBase" "(" Expr ")"
+                 | "subIndex" "(" Ints ")"
+                 | "callNamed" "(" String ")"
+                 | "invoke" "(" String "," Vals ")"
+                 | "functionReturn" | "implicitReturn"
+
+  syntax Map ::= "bindParams" "(" Params "," Vals ")" [function, total]
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start </k>
+      <args> $ARGS:Val </args>
+      <env> .Map </env>
+      <funs> .Map </funs>
+      <stack> .List </stack>
+      <result> VNone </result>
+    </py>
+
+  // Module loading retains the translated function bodies as syntax.  No
+  // special case for pluck or pluck_from occurs in the operational semantics.
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule exec(.Stmts) => .
+  rule exec(S SS) => execStmt(S) ~> exec(SS)
+
+  rule <k> execStmt(FuncDef(F, P, BODY)) => . ... </k>
+       <funs> FS => FS [ F <- fun(P, BODY) ] </funs>
+
+  rule <k> start => invoke("pluck", A) ~> done ... </k>
+       <args> A </args>
+  rule <k> V:Val ~> done => . ... </k>
+       <result> _ => V </result>
+
+  // Statements and early return.
+  rule execStmt(Assign(Name(X), E)) => eval(E) ~> assignName(X)
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule execStmt(If(E, THEN, ELSE)) => eval(E) ~> select(THEN, ELSE)
+  rule VBool(B) ~> select(THEN, _ELSE) => exec(THEN)
+       requires B
+  rule VBool(B) ~> select(_THEN, ELSE) => exec(ELSE)
+       requires notBool B
+
+  rule execStmt(Return(E)) => eval(E) ~> functionReturn
+
+  // Expression evaluation is left-to-right, including call arguments.
+  rule eval(Int(I)) => VInt(I)
+  rule <k> eval(Name(X)) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule eval(BinOp(OP, LEFT, RIGHT))
+       => eval(LEFT) ~> binLeft(OP, RIGHT)
+  rule V:Val ~> binLeft(OP, RIGHT)
+       => eval(RIGHT) ~> binRight(OP, V)
+  rule VInt(J) ~> binRight("+", VInt(I)) => VInt(I +Int J)
+  rule VInt(J) ~> binRight("%", VInt(I)) => VInt(I modInt J)
+
+  // The translated solution only uses one-element comparison chains.
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+       => eval(LEFT) ~> cmpLeft(OP, RIGHT)
+  rule V:Val ~> cmpLeft(OP, RIGHT)
+       => eval(RIGHT) ~> cmpRight(OP, V)
+  rule VList(IS) ~> cmpLeft(OP, RIGHT)
+       => eval(RIGHT) ~> cmpRight(OP, VList(IS))
+  rule VInt(J) ~> cmpRight("==", VInt(I)) => VBool(I ==Int J)
+  rule VInt(J) ~> cmpRight("<=", VInt(I)) => VBool(I <=Int J)
+  rule VInt(J) ~> cmpRight("<", VInt(I)) => VBool(I <Int J)
+  rule VList(IS) ~> cmpRight("==", VList(.Ints))
+       => VBool(IS ==K .Ints)
+  rule VList(.Ints) ~> cmpRight("==", VList(IS))
+       => VBool(IS ==K .Ints)
+
+  rule eval(ListExpr(ES)) => evalExprs(ES)
+  rule evalExprs(.Exprs) => VList(.Ints)
+  rule evalExprs(E, ES) => eval(E) ~> collectExprs(ES)
+  rule VInt(I) ~> collectExprs(ES)
+       => evalExprs(ES) ~> prependInt(I)
+  rule VList(IS) ~> prependInt(I) => VList(I, IS)
+
+  rule eval(Subscript(E, Slice(Int(1), NoBound, NoBound)))
+       => eval(E) ~> takeTail
+  rule VList(IS) ~> takeTail => VList(tailInts(IS))
+  rule eval(Subscript(E, IDX:Expr)) => eval(E) ~> subBase(IDX)
+  rule VList(IS) ~> subBase(IDX) => eval(IDX) ~> subIndex(IS)
+  rule VInt(0) ~> subIndex(IS) => VInt(headInt(IS))
+
+  rule eval(Call(Name(F), ES)) => evalArgs(ES) ~> callNamed(F)
+  rule evalArgs(.Exprs) => argPack(.Vals)
+  rule evalArgs(E, ES) => eval(E) ~> collectArgs(ES)
+  rule V:Val ~> collectArgs(ES) => evalArgs(ES) ~> prependArg(V)
+  rule argPack(VS) ~> prependArg(V) => argPack(V, VS)
+  rule argPack(VS) ~> callNamed(F) => invoke(F, VS)
+
+  rule bindParams(Params(.Strings), .Vals) => .Map
+  rule bindParams(Params(X, XS), V, VS)
+       => (X |-> V) bindParams(Params(XS), VS)
+
+  // A frame saves both the caller's local environment and its continuation.
+  rule <k> invoke(F, VS) ~> CONT
+            => exec(BODY) ~> implicitReturn </k>
+       <env> CALLER => bindParams(P, VS) </env>
+       <funs> ... F |-> fun(P, BODY) ... </funs>
+       <stack> STACK => ListItem(frame(CALLER, CONT)) STACK </stack>
+
+  rule <k> V:Val ~> functionReturn ~> _CURRENT
+            => V ~> CONT </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(frame(CALLER, CONT)) STACK => STACK </stack>
+
+  rule <k> implicitReturn ~> _CURRENT => VNone ~> CONT </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(frame(CALLER, CONT)) STACK => STACK </stack>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d6e3dacc4971747e62fd77c4867417e8aea723f3
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,21 @@
+def pluck_from(arr, index, best, best_index, found):
+    if arr == []:
+        if found == 0:
+            return []
+        return [best, best_index]
+
+    value = arr[0]
+    if arr[0] % 2 == 0:
+        if found == 0:
+            best = value
+            best_index = index
+            found = 1
+        else:
+            if value < best:
+                best = value
+                best_index = index
+    return pluck_from(arr[1:], index + 1, best, best_index, found)
+
+
+def pluck(arr):
+    return pluck_from(arr, 0, 0, 0, 0)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..217ed18d13df373cf180c82ff97f1908d32efe94
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive helper theorem.  Besides its returned value, it proves that a
+  // call preserves the caller's locals, continuation, arguments, result cell,
+  // function table, and pre-existing call stack.
+  claim
+    <py>
+      <k> invoke("pluck_from",
+            VList(INPUT), VInt(INDEX), VInt(BEST),
+            VInt(BESTINDEX), VInt(FOUND)) ~> CONT
+        => specScan(INPUT, INDEX, BEST, BESTINDEX, FOUND) ~> CONT </k>
+      <args> ARG </args>
+      <env> CALLER => CALLER </env>
+      <funs> solutionFunctions </funs>
+      <stack> STACK => STACK </stack>
+      <result> RESULT </result>
+    </py>
+
+  // End-to-end theorem for every finite integer input list (stronger than the
+  // prompt's non-negative-input restriction).
+  claim
+    <py>
+      <k> solutionProgram ~> start => .K </k>
+      <args> VList(INPUT) </args>
+      <env> .Map => .Map </env>
+      <funs> .Map => solutionFunctions </funs>
+      <stack> .List => .List </stack>
+      <result> VNone => specScan(INPUT, 0, 0, 0, 0) </result>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a69b20e86d820b59b516e0811da8c17211eb8377
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,101 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Independent executable contract for a left-to-right scan.  FOUND = 0
+  // denotes no candidate; otherwise BEST/BESTINDEX are the smallest even
+  // value and its first index in the consumed prefix.  A strict comparison
+  // on update is what preserves the first index when values tie.
+  syntax Val ::= "specScan" "(" Ints "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+               | "specFinish" "(" Int "," Int "," Int ")"
+                   [function, total]
+               | "specConsider" "(" Int "," Ints "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+               | "specEven" "(" Int "," Ints "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+
+  rule specScan(INPUT, _INDEX, BEST, BESTINDEX, FOUND)
+       => specFinish(BEST, BESTINDEX, FOUND)
+       requires INPUT ==K .Ints
+  rule specScan(INPUT, INDEX, BEST, BESTINDEX, FOUND)
+       => specConsider(headInt(INPUT), tailInts(INPUT),
+                       INDEX, BEST, BESTINDEX, FOUND)
+       requires INPUT =/=K .Ints
+
+  rule specFinish(_BEST, _BESTINDEX, FOUND) => VList(.Ints)
+       requires FOUND ==Int 0
+  rule specFinish(BEST, BESTINDEX, FOUND) => VList(BEST, BESTINDEX)
+       requires FOUND =/=Int 0
+
+  rule specConsider(HEAD, TAIL, INDEX, BEST, BESTINDEX, FOUND)
+       => specScan(TAIL, INDEX +Int 1, BEST, BESTINDEX, FOUND)
+       requires HEAD modInt 2 =/=Int 0
+  rule specConsider(HEAD, TAIL, INDEX, BEST, BESTINDEX, FOUND)
+       => specEven(HEAD, TAIL, INDEX, BEST, BESTINDEX, FOUND)
+       requires HEAD modInt 2 ==Int 0
+
+  rule specEven(HEAD, TAIL, INDEX, _BEST, _BESTINDEX, FOUND)
+       => specScan(TAIL, INDEX +Int 1, HEAD, INDEX, 1)
+       requires FOUND ==Int 0
+  rule specEven(HEAD, TAIL, INDEX, BEST, _BESTINDEX, FOUND)
+       => specScan(TAIL, INDEX +Int 1, HEAD, INDEX, FOUND)
+       requires FOUND =/=Int 0 andBool HEAD <Int BEST
+  rule specEven(HEAD, TAIL, INDEX, BEST, BESTINDEX, FOUND)
+       => specScan(TAIL, INDEX +Int 1, BEST, BESTINDEX, FOUND)
+       requires FOUND =/=Int 0 andBool HEAD >=Int BEST
+
+  // These constants spell out exactly the constructors emitted in
+  // solution.mpy.  They let the claims stay readable without granting the
+  // operational semantics any task-specific rewrite rule.
+  syntax Stmts ::= "pluckFromBody" [function, total]
+                 | "pluckBody" [function, total]
+  syntax Program ::= "solutionProgram" [function, total]
+  syntax Map ::= "solutionFunctions" [function, total]
+
+  rule pluckFromBody =>
+    If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+      If(Compare(Name("found"), CmpOp("==", Int(0))),
+        Return(ListExpr(.Exprs)),
+        .Stmts)
+      Return(ListExpr(Name("best"), Name("best_index"))),
+      .Stmts)
+    Assign(Name("value"), Subscript(Name("arr"), Int(0)))
+    If(Compare(
+      BinOp("%", Subscript(Name("arr"), Int(0)), Int(2)),
+      CmpOp("==", Int(0))),
+      If(Compare(Name("found"), CmpOp("==", Int(0))),
+        Assign(Name("best"), Name("value"))
+        Assign(Name("best_index"), Name("index"))
+        Assign(Name("found"), Int(1)),
+        If(Compare(Name("value"), CmpOp("<", Name("best"))),
+          Assign(Name("best"), Name("value"))
+          Assign(Name("best_index"), Name("index")),
+          .Stmts)),
+      .Stmts)
+    Return(Call(
+      Name("pluck_from"),
+      Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound)),
+      BinOp("+", Name("index"), Int(1)),
+      Name("best"),
+      Name("best_index"),
+      Name("found")))
+
+  rule pluckBody =>
+    Return(Call(
+      Name("pluck_from"), Name("arr"), Int(0), Int(0), Int(0), Int(0)))
+
+  rule solutionProgram =>
+    Module(
+      FuncDef("pluck_from",
+        Params("arr", "index", "best", "best_index", "found"),
+        pluckFromBody)
+      FuncDef("pluck", Params("arr"), pluckBody))
+
+  rule solutionFunctions =>
+    ("pluck_from" |-> fun(
+      Params("arr", "index", "best", "best_index", "found"),
+      pluckFromBody))
+    ("pluck" |-> fun(Params("arr"), pluckBody))
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX && kprove spec.k --definition verification-kompiled' in /work
