+  rule VList(_I, _IS) ~> cmpRight("==", VList(.Ints)) => VBool(false)
+  rule VList(.Ints) ~> cmpRight("==", VList(_I, _IS)) => VBool(false)
+
+  rule eval(ListExpr(ES)) => evalExprs(ES)
+  rule evalExprs(.Exprs) => VList(.Ints)
+  rule evalExprs(E, ES) => eval(E) ~> collectExprs(ES)
+  rule VInt(I) ~> collectExprs(ES)
+       => evalExprs(ES) ~> prependInt(I)
+  rule VList(IS) ~> prependInt(I) => VList(I, IS)
+
+  rule eval(Subscript(E, Slice(Int(1), NoBound, NoBound)))
+       => eval(E) ~> takeTail
+  rule VList(_I, IS) ~> takeTail => VList(IS)
+  rule eval(Subscript(E, IDX:Expr)) => eval(E) ~> subBase(IDX)
+  rule VList(IS) ~> subBase(IDX) => eval(IDX) ~> subIndex(IS)
+  rule VInt(0) ~> subIndex(I, _IS) => VInt(I)
+
+  rule eval(Call(Name(F), ES)) => evalArgs(ES) ~> callNamed(F)
+  rule evalArgs(.Exprs) => argPack(.Vals)
+  rule evalArgs(E, ES) => eval(E) ~> collectArgs(ES)
+  rule V:Val ~> collectArgs(ES) => evalArgs(ES) ~> prependArg(V)
+  rule argPack(VS) ~> prependArg(V) => argPack(V, VS)
+  rule argPack(VS) ~> callNamed(F) => invoke(F, VS)
+
+  rule bindParams(Params(.Strings), .Vals) => .Map
+  rule bindParams(Params(X, XS), V, VS)
+       => (X |-> V) bindParams(Params(XS), VS)
+
+  // A frame saves both the caller's local environment and its continuation.
+  rule <k> invoke(F, VS) ~> CONT
+            => exec(BODY) ~> implicitReturn </k>
+       <env> CALLER => bindParams(P, VS) </env>
+       <funs> ... F |-> fun(P, BODY) ... </funs>
+       <stack> STACK => ListItem(frame(CALLER, CONT)) STACK </stack>
+
+  rule <k> V:Val ~> functionReturn ~> _CURRENT
+            => V ~> CONT </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(frame(CALLER, CONT)) STACK => STACK </stack>
+
+  rule <k> implicitReturn ~> _CURRENT => VNone ~> CONT </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(frame(CALLER, CONT)) STACK => STACK </stack>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..176f6286b0942d70aa9ddf5b48af60da1aefffda
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,15 @@
+def pluck_from(arr, index):
+    if arr == []:
+        return []
+
+    rest = pluck_from(arr[1:], index + 1)
+    if arr[0] % 2 == 0:
+        if rest == []:
+            return [arr[0], index]
+        if arr[0] <= rest[0]:
+            return [arr[0], index]
+    return rest
+
+
+def pluck(arr):
+    return pluck_from(arr, 0)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..17c09efb78053e26e0c6821bdf854a34c2734917
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive helper theorem.  Besides its returned value, it proves that a
+  // call preserves the caller's locals, continuation, arguments, result cell,
+  // function table, and pre-existing call stack.
+  claim
+    <py>
+      <k> invoke("pluck_from", VList(INPUT), VInt(INDEX)) ~> CONT
+        => specPluck(INPUT, INDEX) ~> CONT </k>
+      <args> ARG </args>
+      <env> CALLER => CALLER </env>
+      <funs> solutionFunctions </funs>
+      <stack> STACK => STACK </stack>
+      <result> RESULT </result>
+    </py>
+
+  // End-to-end theorem for every finite integer input list (stronger than the
+  // prompt's non-negative-input restriction).
+  claim
+    <py>
+      <k> solutionProgram ~> start => .K </k>
+      <args> VList(INPUT) </args>
+      <env> .Map => .Map </env>
+      <funs> .Map => solutionFunctions </funs>
+      <stack> .List => .List </stack>
+      <result> VNone => specPluck(INPUT, 0) </result>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..17d1980eb2bfcf5fd007c3c86f3447368128c7e7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,72 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Independent executable contract.  It scans left-to-right conceptually:
+  // the suffix provides its best candidate, and an even head replaces it iff
+  // it is no larger.  Equality therefore chooses the earlier (head) index.
+  syntax Val ::= "specPluck" "(" Ints "," Int ")" [function, total]
+               | "selectCandidate" "(" Int "," Int "," Val ")"
+                   [function, total]
+
+  rule specPluck(.Ints, _INDEX) => VList(.Ints)
+  rule specPluck(HEAD, TAIL, INDEX)
+       => selectCandidate(HEAD, INDEX, specPluck(TAIL, INDEX +Int 1))
+
+  rule selectCandidate(HEAD, _INDEX, REST) => REST
+       requires HEAD modInt 2 =/=Int 0
+  rule selectCandidate(HEAD, INDEX, VList(.Ints))
+       => VList(HEAD, INDEX)
+       requires HEAD modInt 2 ==Int 0
+  rule selectCandidate(HEAD, INDEX, VList(BEST, _BESTINDEX))
+       => VList(HEAD, INDEX)
+       requires HEAD modInt 2 ==Int 0 andBool HEAD <=Int BEST
+  rule selectCandidate(HEAD, _INDEX, VList(BEST, BESTINDEX))
+       => VList(BEST, BESTINDEX)
+       requires HEAD modInt 2 ==Int 0 andBool HEAD >Int BEST
+
+  // These constants spell out exactly the constructors emitted in
+  // solution.mpy.  They let the claims stay readable without granting the
+  // operational semantics any task-specific rewrite rule.
+  syntax Stmts ::= "pluckFromBody" [function, total]
+                 | "pluckBody" [function, total]
+  syntax Program ::= "solutionProgram" [function, total]
+  syntax Map ::= "solutionFunctions" [function, total]
+
+  rule pluckFromBody =>
+    If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+      Return(ListExpr(.Exprs)),
+      .Stmts)
+    Assign(
+      Name("rest"),
+      Call(
+        Name("pluck_from"),
+        Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound)),
+        BinOp("+", Name("index"), Int(1))))
+    If(Compare(
+      BinOp("%", Subscript(Name("arr"), Int(0)), Int(2)),
+      CmpOp("==", Int(0))),
+      If(Compare(Name("rest"), CmpOp("==", ListExpr(.Exprs))),
+        Return(ListExpr(Subscript(Name("arr"), Int(0)), Name("index"))),
+        .Stmts)
+      If(Compare(
+        Subscript(Name("arr"), Int(0)),
+        CmpOp("<=", Subscript(Name("rest"), Int(0)))),
+        Return(ListExpr(Subscript(Name("arr"), Int(0)), Name("index"))),
+        .Stmts),
+      .Stmts)
+    Return(Name("rest"))
+
+  rule pluckBody =>
+    Return(Call(Name("pluck_from"), Name("arr"), Int(0)))
+
+  rule solutionProgram =>
+    Module(
+      FuncDef("pluck_from", Params("arr", "index"), pluckFromBody)
+      FuncDef("pluck", Params("arr"), pluckBody))
+
+  rule solutionFunctions =>
+    ("pluck_from" |-> fun(Params("arr", "index"), pluckFromBody))
+    ("pluck" |-> fun(Params("arr"), pluckBody))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition semantic-kompiled --dry-run' in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..418907f83169e71ce3f4b2e26dd5c65420cf7d36
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,173 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "Call" "(" Expr "," Exprs ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  // Values are deliberately limited to the data used by this HumanEval task:
+  // integers, lists of integers, booleans, and Python's None result.
+  syntax Ints ::= List{Int, ","}
+  syntax Val ::= "VInt" "(" Int ")"
+               | "VList" "(" Ints ")"
+               | "VBool" "(" Bool ")"
+               | "VNone"
+  syntax Vals ::= List{Val, ","}
+
+  syntax Fun ::= "fun" "(" Params "," Stmts ")"
+  syntax Frame ::= "frame" "(" Map "," K ")"
+  syntax ArgPack ::= "argPack" "(" Vals ")"
+
+  syntax KItem ::= "start" | "done"
+                 | "exec" "(" Stmts ")" | "execStmt" "(" Stmt ")"
+                 | "eval" "(" Expr ")" | "evalExprs" "(" Exprs ")"
+                 | "evalArgs" "(" Exprs ")"
+                 | "assignName" "(" String ")"
+                 | "select" "(" Stmts "," Stmts ")"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "cmpLeft" "(" String "," Expr ")"
+                 | "cmpRight" "(" String "," Val ")"
+                 | "collectExprs" "(" Exprs ")"
+                 | "prependInt" "(" Int ")"
+                 | "collectArgs" "(" Exprs ")"
+                 | "prependArg" "(" Val ")"
+                 | "takeTail" | "subBase" "(" Expr ")"
+                 | "subIndex" "(" Ints ")"
+                 | "callNamed" "(" String ")"
+                 | "invoke" "(" String "," Vals ")"
+                 | "functionReturn" | "implicitReturn"
+
+  syntax Map ::= "bindParams" "(" Params "," Vals ")" [function, total]
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start </k>
+      <args> $ARGS:Val </args>
+      <env> .Map </env>
+      <funs> .Map </funs>
+      <stack> .List </stack>
+      <result> VNone </result>
+    </py>
+
+  // Module loading retains the translated function bodies as syntax.  No
+  // special case for pluck or pluck_from occurs in the operational semantics.
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule exec(.Stmts) => .
+  rule exec(S SS) => execStmt(S) ~> exec(SS)
+
+  rule <k> execStmt(FuncDef(F, P, BODY)) => . ... </k>
+       <funs> FS => FS [ F <- fun(P, BODY) ] </funs>
+
+  rule <k> start => invoke("pluck", A) ~> done ... </k>
+       <args> A </args>
+  rule <k> V:Val ~> done => . ... </k>
+       <result> _ => V </result>
+
+  // Statements and early return.
+  rule execStmt(Assign(Name(X), E)) => eval(E) ~> assignName(X)
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule execStmt(If(E, THEN, ELSE)) => eval(E) ~> select(THEN, ELSE)
+  rule VBool(true) ~> select(THEN, _ELSE) => exec(THEN)
+  rule VBool(false) ~> select(_THEN, ELSE) => exec(ELSE)
+
+  rule execStmt(Return(E)) => eval(E) ~> functionReturn
+
+  // Expression evaluation is left-to-right, including call arguments.
+  rule eval(Int(I)) => VInt(I)
+  rule <k> eval(Name(X)) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule eval(BinOp(OP, LEFT, RIGHT))
+       => eval(LEFT) ~> binLeft(OP, RIGHT)
+  rule V:Val ~> binLeft(OP, RIGHT)
+       => eval(RIGHT) ~> binRight(OP, V)
+  rule VInt(J) ~> binRight("+", VInt(I)) => VInt(I +Int J)
+  rule VInt(J) ~> binRight("%", VInt(I)) => VInt(I modInt J)
+
+  // The translated solution only uses one-element comparison chains.
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+       => eval(LEFT) ~> cmpLeft(OP, RIGHT)
+  rule V:Val ~> cmpLeft(OP, RIGHT)
+       => eval(RIGHT) ~> cmpRight(OP, V)
+  rule VInt(J) ~> cmpRight("==", VInt(I)) => VBool(I ==Int J)
+  rule VInt(J) ~> cmpRight("<=", VInt(I)) => VBool(I <=Int J)
+  rule VList(.Ints) ~> cmpRight("==", VList(.Ints)) => VBool(true)
+  rule VList(_I, _IS) ~> cmpRight("==", VList(.Ints)) => VBool(false)
+  rule VList(.Ints) ~> cmpRight("==", VList(_I, _IS)) => VBool(false)
+
+  rule eval(ListExpr(ES)) => evalExprs(ES)
+  rule evalExprs(.Exprs) => VList(.Ints)
+  rule evalExprs(E, ES) => eval(E) ~> collectExprs(ES)
+  rule VInt(I) ~> collectExprs(ES)
+       => evalExprs(ES) ~> prependInt(I)
+  rule VList(IS) ~> prependInt(I) => VList(I, IS)
+
+  rule eval(Subscript(E, Slice(Int(1), NoBound, NoBound)))
+       => eval(E) ~> takeTail
+  rule VList(_I, IS) ~> takeTail => VList(IS)
+  rule eval(Subscript(E, IDX:Expr)) => eval(E) ~> subBase(IDX)
+  rule VList(IS) ~> subBase(IDX) => eval(IDX) ~> subIndex(IS)
+  rule VInt(0) ~> subIndex(I, _IS) => VInt(I)
+
+  rule eval(Call(Name(F), ES)) => evalArgs(ES) ~> callNamed(F)
+  rule evalArgs(.Exprs) => argPack(.Vals)
+  rule evalArgs(E, ES) => eval(E) ~> collectArgs(ES)
+  rule V:Val ~> collectArgs(ES) => evalArgs(ES) ~> prependArg(V)
+  rule argPack(VS) ~> prependArg(V) => argPack(V, VS)
+  rule argPack(VS) ~> callNamed(F) => invoke(F, VS)
+
+  rule bindParams(Params(.Strings), .Vals) => .Map
+  rule bindParams(Params(X, XS), V, VS)
+       => (X |-> V) bindParams(Params(XS), VS)
+
+  // A frame saves both the caller's local environment and its continuation.
+  rule <k> invoke(F, VS) ~> CONT
+            => exec(BODY) ~> implicitReturn </k>
+       <env> CALLER => bindParams(P, VS) </env>
+       <funs> ... F |-> fun(P, BODY) ... </funs>
+       <stack> STACK => ListItem(frame(CALLER, CONT)) STACK </stack>
+
+  rule <k> V:Val ~> functionReturn ~> _CURRENT
+            => V ~> CONT </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(frame(CALLER, CONT)) STACK => STACK </stack>
+
+  rule <k> implicitReturn ~> _CURRENT => VNone ~> CONT </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(frame(CALLER, CONT)) STACK => STACK </stack>
+endmodule
