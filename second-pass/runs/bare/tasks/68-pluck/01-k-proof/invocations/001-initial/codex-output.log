new file mode 100644
index 0000000000000000000000000000000000000000..a69b20e86d820b59b516e0811da8c17211eb8377
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,101 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Independent executable contract for a left-to-right scan.  FOUND = 0
+  // denotes no candidate; otherwise BEST/BESTINDEX are the smallest even
+  // value and its first index in the consumed prefix.  A strict comparison
+  // on update is what preserves the first index when values tie.
+  syntax Val ::= "specScan" "(" Ints "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+               | "specFinish" "(" Int "," Int "," Int ")"
+                   [function, total]
+               | "specConsider" "(" Int "," Ints "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+               | "specEven" "(" Int "," Ints "," Int "," Int "," Int "," Int ")"
+                   [function, total]
+
+  rule specScan(INPUT, _INDEX, BEST, BESTINDEX, FOUND)
+       => specFinish(BEST, BESTINDEX, FOUND)
+       requires INPUT ==K .Ints
+  rule specScan(INPUT, INDEX, BEST, BESTINDEX, FOUND)
+       => specConsider(headInt(INPUT), tailInts(INPUT),
+                       INDEX, BEST, BESTINDEX, FOUND)
+       requires INPUT =/=K .Ints
+
+  rule specFinish(_BEST, _BESTINDEX, FOUND) => VList(.Ints)
+       requires FOUND ==Int 0
+  rule specFinish(BEST, BESTINDEX, FOUND) => VList(BEST, BESTINDEX)
+       requires FOUND =/=Int 0
+
+  rule specConsider(HEAD, TAIL, INDEX, BEST, BESTINDEX, FOUND)
+       => specScan(TAIL, INDEX +Int 1, BEST, BESTINDEX, FOUND)
+       requires HEAD modInt 2 =/=Int 0
+  rule specConsider(HEAD, TAIL, INDEX, BEST, BESTINDEX, FOUND)
+       => specEven(HEAD, TAIL, INDEX, BEST, BESTINDEX, FOUND)
+       requires HEAD modInt 2 ==Int 0
+
+  rule specEven(HEAD, TAIL, INDEX, _BEST, _BESTINDEX, FOUND)
+       => specScan(TAIL, INDEX +Int 1, HEAD, INDEX, 1)
+       requires FOUND ==Int 0
+  rule specEven(HEAD, TAIL, INDEX, BEST, _BESTINDEX, FOUND)
+       => specScan(TAIL, INDEX +Int 1, HEAD, INDEX, FOUND)
+       requires FOUND =/=Int 0 andBool HEAD <Int BEST
+  rule specEven(HEAD, TAIL, INDEX, BEST, BESTINDEX, FOUND)
+       => specScan(TAIL, INDEX +Int 1, BEST, BESTINDEX, FOUND)
+       requires FOUND =/=Int 0 andBool HEAD >=Int BEST
+
+  // These constants spell out exactly the constructors emitted in
+  // solution.mpy.  They let the claims stay readable without granting the
+  // operational semantics any task-specific rewrite rule.
+  syntax Stmts ::= "pluckFromBody" [function, total]
+                 | "pluckBody" [function, total]
+  syntax Program ::= "solutionProgram" [function, total]
+  syntax Map ::= "solutionFunctions" [function, total]
+
+  rule pluckFromBody =>
+    If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+      If(Compare(Name("found"), CmpOp("==", Int(0))),
+        Return(ListExpr(.Exprs)),
+        .Stmts)
+      Return(ListExpr(Name("best"), Name("best_index"))),
+      .Stmts)
+    Assign(Name("value"), Subscript(Name("arr"), Int(0)))
+    If(Compare(
+      BinOp("%", Subscript(Name("arr"), Int(0)), Int(2)),
+      CmpOp("==", Int(0))),
+      If(Compare(Name("found"), CmpOp("==", Int(0))),
+        Assign(Name("best"), Name("value"))
+        Assign(Name("best_index"), Name("index"))
+        Assign(Name("found"), Int(1)),
+        If(Compare(Name("value"), CmpOp("<", Name("best"))),
+          Assign(Name("best"), Name("value"))
+          Assign(Name("best_index"), Name("index")),
+          .Stmts)),
+      .Stmts)
+    Return(Call(
+      Name("pluck_from"),
+      Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound)),
+      BinOp("+", Name("index"), Int(1)),
+      Name("best"),
+      Name("best_index"),
+      Name("found")))
+
+  rule pluckBody =>
+    Return(Call(
+      Name("pluck_from"), Name("arr"), Int(0), Int(0), Int(0), Int(0)))
+
+  rule solutionProgram =>
+    Module(
+      FuncDef("pluck_from",
+        Params("arr", "index", "best", "best_index", "found"),
+        pluckFromBody)
+      FuncDef("pluck", Params("arr"), pluckBody))
+
+  rule solutionFunctions =>
+    ("pluck_from" |-> fun(
+      Params("arr", "index", "best", "best_index", "found"),
+      pluckFromBody))
+    ("pluck" |-> fun(Params("arr"), pluckBody))
+endmodule

