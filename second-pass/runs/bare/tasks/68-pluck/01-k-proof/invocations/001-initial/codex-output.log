      "index" |-> VInt ( INDEX ) , select ( If ( Compare ( Name ( "found" ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) , Return ( ListExpr ( .Exprs ) )  .Stmts , .Stmts )  Return ( ListExpr ( Name ( "best" ) , Name ( "best_index" ) , .Exprs ) )  .Stmts , .Stmts ) ~> exec ( Assign ( Name ( "value" ) , Subscript ( Name ( "arr" ) , Int ( 0 ) ) )  If ( Compare ( BinOp ( "%" , Subscript ( Name ( "arr" ) , Int ( 0 ) ) , Int ( 2 ) ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) , If ( Compare ( Name ( "found" ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) , Assign ( Name ( "best" ) , Name ( "value" ) )  Assign ( Name ( "best_index" ) , Name ( "index" ) )  Assign ( Name ( "found" ) , Int ( 1 ) )  .Stmts , If ( Compare ( Name ( "value" ) , CmpOp ( "<" , Name ( "best" ) ) , .CmpOps ) , Assign ( Name ( "best" ) , Name ( "value" ) )  Assign ( Name ( "best_index" ) , Name ( "index" ) )  .Stmts , .Stmts )  .Stmts )  .Stmts , .Stmts )  Return ( Call ( Name ( "pluck_from" ) , Subscript ( Name ( "arr" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , BinOp ( "+" , Name ( "index" ) , Int ( 1 ) ) , Name ( "best" ) , Name ( "best_index" ) , Name ( "found" ) , .Exprs ) )  .Stmts ) ~> implicitReturn ~> .K ) )
      STACK
    }
  #And
    {
      VBool ( LENGTH ==Int 0 )
    #Equals
      specScanArray ( ID , OFFSET , LENGTH , INDEX , BEST , BESTINDEX , FOUND )
    } )
#And
  <py>
    <k>
      VBool ( LENGTH ==Int 0 ) ~> select ( If ( Compare ( Name ( "found" ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) , Return ( ListExpr ( .Exprs ) )  .Stmts , .Stmts )  Return ( ListExpr ( Name ( "best" ) , Name ( "best_index" ) , .Exprs ) )  .Stmts , .Stmts ) ~> exec ( Assign ( Name ( "value" ) , Subscript ( Name ( "arr" ) , Int ( 0 ) ) )  If ( Compare ( BinOp ( "%" , Subscript ( Name ( "arr" ) , Int ( 0 ) ) , Int ( 2 ) ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) , If ( Compare ( Name ( "found" ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) , Assign ( Name ( "best" ) , Name ( "value" ) )  Assign ( Name ( "best_index" ) , Name ( "index" ) )  Assign ( Name ( "found" ) , Int ( 1 ) )  .Stmts , If ( Compare ( Name ( "value" ) , CmpOp ( "<" , Name ( "best" ) ) , .CmpOps ) , Assign ( Name ( "best" ) , Name ( "value" ) )  Assign ( Name ( "best_index" ) , Name ( "index" ) )  .Stmts , .Stmts )  .Stmts )  .Stmts , .Stmts )  Return ( Call ( Name ( "pluck_from" ) , Subscript ( Name ( "arr" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , BinOp ( "+" , Name ( "index" ) , Int ( 1 ) ) , Name ( "best" ) , Name ( "best_index" ) , Name ( "found" ) , .Exprs ) )  .Stmts ) ~> implicitReturn ~> .K
    </k>
    <args>
      ARG
    </args>
    <env>
      "arr" |-> VArray ( ID , OFFSET , LENGTH )
      "best" |-> VInt ( BEST )
      "best_index" |-> VInt ( BESTINDEX )
      "found" |-> VInt ( FOUND )
      "index" |-> VInt ( INDEX )
    </env>
