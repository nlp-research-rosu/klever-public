+                 | "cmpLeft" "(" String "," Expr ")"
+                 | "cmpRight" "(" String "," Val ")"
+                 | "collectExprs" "(" Exprs ")"
+                 | "prependInt" "(" Int ")"
+                 | "collectArgs" "(" Exprs ")"
+                 | "prependArg" "(" Val ")"
+                 | "takeTail" | "subBase" "(" Expr ")"
+                 | "subIndex" "(" Ints ")"
+                 | "callNamed" "(" String ")"
+                 | "invoke" "(" String "," Vals ")"
+                 | "functionReturn" | "implicitReturn"
+
