+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+  imports K-EQUAL
+
+  syntax Value ::= intVal(Int)
+                 | strVal(String)
+                 | boolVal(Bool)
+                 | listVal(Values)
+                 | "noneVal"
+  syntax Values ::= "vnil" | vcons(Value, Values)
+
+  syntax Env ::= "emptyEnv" | bind(String, Value, Env)
+  syntax Function ::= function(String, Stmts)
+  syntax FEnv ::= "emptyFEnv" | fbind(String, Function, FEnv)
+
+  syntax KItem ::= exec(Stmts)
+                 | loop(Expr, Stmts)
+                 | restoreEnv(Env)
+                 | returning(Value)
+                 | invoke(Function, Value, Env)
+
+  syntax Value ::= lookup(String, Env) [function]
+  rule lookup(X, bind(X, V, _)) => V
+  rule lookup(X, bind(Y, _, REST)) => lookup(X, REST)
+    requires X =/=String Y
+
+  syntax Env ::= update(String, Value, Env) [function]
+  rule update(X, V, emptyEnv) => bind(X, V, emptyEnv)
+  rule update(X, V, bind(X, _, REST)) => bind(X, V, REST)
+  rule update(X, V, bind(Y, W, REST)) => bind(Y, W, update(X, V, REST))
+    requires X =/=String Y
+
+  syntax Function ::= flookup(String, FEnv) [function]
+  rule flookup(X, fbind(X, FN, _)) => FN
+  rule flookup(X, fbind(Y, _, REST)) => flookup(X, REST)
+    requires X =/=String Y
+
+  syntax Values ::= snoc(Values, Value) [function]
+  rule snoc(vnil, V) => vcons(V, vnil)
+  rule snoc(vcons(H, T), V) => vcons(H, snoc(T, V))
+
+  syntax Value ::= eval(Expr, Env) [function]
+  rule eval(Int(I), _) => intVal(I)
+  rule eval(Str(S), _) => strVal(S)
+  rule eval(Name(X), ENV) => lookup(X, ENV)
+  rule eval(ListExpr(), _) => listVal(vnil)
+  rule eval(BinOp("+", A, B), ENV) => addVal(eval(A, ENV), eval(B, ENV))
+  rule eval(Call(Name("len"), E), ENV) => lenVal(eval(E, ENV))
+  rule eval(Compare(A, CmpOp("<=", B)), ENV)
+    => lessEqVal(eval(A, ENV), eval(B, ENV))
+  rule eval(Subscript(E, Slice(NoBound, HI, NoBound)), ENV)
+    => prefixVal(eval(E, ENV), eval(HI, ENV))
+
+  syntax Value ::= addVal(Value, Value) [function]
+                 | lenVal(Value) [function]
+                 | lessEqVal(Value, Value) [function]
+                 | prefixVal(Value, Value) [function]
+                 | appendVal(Value, Value) [function]
+  rule addVal(intVal(I), intVal(J)) => intVal(I +Int J)
+  rule lenVal(strVal(S)) => intVal(lengthString(S))
+  rule lessEqVal(intVal(I), intVal(J)) => boolVal(I <=Int J)
+  rule prefixVal(strVal(S), intVal(I)) => strVal(substrString(S, 0, I))
+  rule appendVal(listVal(VS), V) => listVal(snoc(VS, V))
+
+  syntax Bool ::= truth(Value) [function]
+  rule truth(boolVal(B)) => B
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <env> emptyEnv </env>
+      <functions> emptyFEnv </functions>
+    </mpy>
+
+  rule <k> Run(Module(SS), E) => exec(SS) ~> E ... </k>
+  rule <k> Module(SS) => exec(SS) ... </k>
+
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> ImportFrom(_, _) => . ... </k>
+  rule <k> FuncDef(F, Params(P), BODY) => . ... </k>
+       <functions> FUNS => fbind(F, function(P, BODY), FUNS) </functions>
+  rule <k> Assign(Name(X), E) => . ... </k>
+       <env> ENV => update(X, eval(E, ENV), ENV) </env>
+  rule <k> Expr(Call(Attribute(Name(X), "append"), E)) => . ... </k>
+       <env> ENV => update(X, appendVal(lookup(X, ENV), eval(E, ENV)), ENV) </env>
+  rule <k> While(COND, BODY) => loop(COND, BODY) ... </k>
+  rule <k> loop(COND, BODY) => exec(BODY) ~> loop(COND, BODY) ... </k>
+       <env> ENV </env>
+    requires truth(eval(COND, ENV))
+  rule <k> loop(COND, _) => . ... </k>
+       <env> ENV </env>
+    requires notBool truth(eval(COND, ENV))
+
+  rule <k> Call(Name(F), ARG) => invoke(flookup(F, FUNS), eval(ARG, ENV), ENV) ... </k>
+       <env> ENV </env>
+       <functions> FUNS </functions>
+  rule <k> invoke(function(P, BODY), V, OLD) => exec(BODY) ~> restoreEnv(OLD) ... </k>
+       <env> _ => bind(P, V, emptyEnv) </env>
+
+  rule <k> Return(E) => returning(eval(E, ENV)) ... </k>
+       <env> ENV </env>
+  rule <k> returning(V) ~> exec(_) => returning(V) ... </k>
+  rule <k> returning(V) ~> restoreEnv(OLD) => V ... </k>
+       <env> _ => OLD </env>
+endmodule
+
+module SEMANTIC
+  imports MPY
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b95a96c4a28efbe75699e6cdf33650d8bdae1fc
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def all_prefixes(string: str) -> List[str]:
+    result = []
+    i = 1
+    while i <= len(string):
+        result.append(string[:i])
+        i = i + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1de5621c505efea6a6bf5b148bc3a1a4ce1531db
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,13 @@
+requires "verified-lemma.k"
+
+module SPEC
+  imports VERIFIED-LEMMA
+
+  claim <mpy>
+          <k> Run(solutionProgram,
+                   Call(Name("all_prefixes"), Str(S)))
+            => listVal(allPrefixes(S)) </k>
+          <env> emptyEnv => emptyEnv </env>
+          <functions> emptyFEnv => ?_:FEnv </functions>
+        </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..20686b9bc2dbb381aa172e27982a0e316b1ae3af
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,27 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("all_prefixes", Params("string"),
+        Assign(Name("result"), ListExpr())
+        Assign(Name("i"), Int(1))
+        While(Compare(Name("i"), CmpOp("<=", Call(Name("len"), Name("string")))),
+          Expr(Call(Attribute(Name("result"), "append"),
+            Subscript(Name("string"), Slice(NoBound, Name("i"), NoBound))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("result"))))
+
+  syntax Values ::= prefixes(String, Int) [function]
+  rule prefixes(_, N) => vnil requires N <=Int 0
+  rule prefixes(S, N) => snoc(prefixes(S, N -Int 1),
+                               strVal(substrString(S, 0, N)))
+    requires N >Int 0
+
+  syntax Values ::= allPrefixes(String) [function]
+  rule allPrefixes(S) => prefixes(S, lengthString(S))
+endmodule
diff --git a/verified-lemma.k b/verified-lemma.k
new file mode 100644
index 0000000000000000000000000000000000000000..950881924f874a92e4461077743f02320573fc34
--- /dev/null
+++ b/verified-lemma.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module VERIFIED-LEMMA
+  imports VERIFICATION
+
+  // This rule is exactly the LOOP-SPEC claim, which prove.sh proves first
+  // against the unsummarized operational semantics.
+  rule <k>
+         loop(
+           Compare(Name("i"),
+             CmpOp("<=", Call(Name("len"), Name("string")))),
+           Expr(Call(Attribute(Name("result"), "append"),
+             Subscript(Name("string"),
+               Slice(NoBound, Name("i"), NoBound))))
+           Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+         ~> exec(Return(Name("result")))
+         ~> restoreEnv(OLD)
+         => listVal(allPrefixes(S))
+       </k>
+       <env>
+         bind("string", strVal(S),
+           bind("result", listVal(VS),
+             bind("i", intVal(I), emptyEnv)))
+         => OLD
+       </env>
+    requires 0 <=Int lengthString(S)
+     andBool 1 <=Int I
+     andBool I <=Int lengthString(S) +Int 1
+     andBool VS ==K prefixes(S, I -Int 1)
+    [priority(30)]
+endmodule

diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ba92995fc99148ea9308a26595efba77eb567e24
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  claim <mpy>
+          <k>
+            loop(
+              Compare(Name("i"),
+                CmpOp("<=", Call(Name("len"), Name("string")))),
+              Expr(Call(Attribute(Name("result"), "append"),
+                Subscript(Name("string"),
+                  Slice(NoBound, Name("i"), NoBound))))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+            ~> exec(Return(Name("result")))
+            ~> restoreEnv(OLD)
+            => listVal(allPrefixes(S))
+          </k>
+          <env>
+            bind("string", strVal(S),
+              bind("result", listVal(VS),
+                bind("i", intVal(I), emptyEnv)))
+            => OLD
+          </env>
+          <functions> FUNS </functions>
+        </mpy>
+    requires 0 <=Int lengthString(S)
+     andBool 1 <=Int I
+     andBool I <=Int lengthString(S) +Int 1
+     andBool VS ==K prefixes(S, I -Int 1)
+endmodule
