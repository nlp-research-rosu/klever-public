                    emit_stmts(node.body), emit_stmts(node.orelse))

    if isinstance(node, ast.For):
        if node.orelse:
            raise Unsupported("for-else")
        return Ctor("For", emit_expr(node.target), emit_expr(node.iter),
                    emit_stmts(node.body))

