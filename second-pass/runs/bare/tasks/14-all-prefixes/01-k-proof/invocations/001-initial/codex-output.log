@@ -0,0 +1,14 @@
+#!/usr/bin/env python3
+"""Embed the freshly translated program as the K proof target."""
+
+from pathlib import Path
+
+
+term = Path("solution.mpy").read_text(encoding="utf-8").strip()
+indented = "\n".join("    " + line for line in term.splitlines())
+print('module SOLUTION-PROGRAM')
+print('  imports MPY')
+print('  syntax Program ::= "solutionProgram" [function]')
+print('  rule solutionProgram =>')
+print(indented)
+print('endmodule')
diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..65da6602be277af6f5525feb6c743cb78f02d36d
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  claim <mpy>
+          <k>
+            loop(
+              Compare(Name("i"),
+                CmpOp("<=", Call(Name("len"), Name("string")))),
+              Expr(Call(Attribute(Name("result"), "append"),
+                Subscript(Name("string"),
+                  Slice(NoBound, Name("i"), NoBound))))
+              Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+            ~> exec(Return(Name("result")))
+            ~> restoreEnv(OLD)
+            => listVal(allPrefixes(S))
+          </k>
+          <env>
+            bind("string", strVal(S),
+              bind("result", listVal(pacc(S, N)),
+                bind("i", intVal(I), emptyEnv)))
+            => OLD
+          </env>
+          <functions> FUNS </functions>
+        </mpy>
+    requires 0 <=Int lengthString(S)
+     andBool 0 <=Int N
+     andBool N <=Int lengthString(S)
+     andBool I ==Int N +Int 1
+endmodule
