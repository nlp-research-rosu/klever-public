@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module VERIFIED-LEMMA
+  imports VERIFICATION
+
+  // This is the N=0 instance of the inductive claim proved in LOOP-SPEC.
+  rule <k>
+         loop(
+           Compare(Name("i"),
+             CmpOp("<=", Call(Name("len"), Name("string")))),
+           Expr(Call(Attribute(Name("result"), "append"),
+             Subscript(Name("string"),
+               Slice(NoBound, Name("i"), NoBound))))
+           Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+         ~> exec(Return(Name("result")))
+         ~> restoreEnv(OLD)
+         => listVal(allPrefixes(S))
+       </k>
+       <env>
+         bind("string", strVal(S),
+           bind("result", listVal(vnil),
+             bind("i", intVal(1), emptyEnv)))
+         => OLD
+       </env>
+    requires 0 <=Int lengthString(S)
+    [priority(30)]
+endmodule

codex
The proof target is now generated from the fresh translator output on every run. The final script will therefore fail if `solution.py` changes into a program that no longer reaches the proven loop shape. I’m running `prove.sh` from a clean command sequence now and will inspect both `#Top` results and all exit statuses.
exec
/bin/bash -lc ./prove.sh in /work
diff --git a/embed_mpy.py b/embed_mpy.py
new file mode 100644
index 0000000000000000000000000000000000000000..451dbecef6dbec2abbc093a98e7bc9188443ef0f
--- /dev/null
+++ b/embed_mpy.py
@@ -0,0 +1,14 @@
+#!/usr/bin/env python3
+"""Embed the freshly translated program as the K proof target."""
+
+from pathlib import Path
+
+
+term = Path("solution.mpy").read_text(encoding="utf-8").strip()
+indented = "\n".join("    " + line for line in term.splitlines())
+print('module SOLUTION-PROGRAM')
+print('  imports MPY')
+print('  syntax Program ::= "solutionProgram" [function]')
+print('  rule solutionProgram =>')
+print(indented)
+print('endmodule')
