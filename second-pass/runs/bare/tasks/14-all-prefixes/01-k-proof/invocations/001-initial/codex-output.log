+    [priority(30)]
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX && kprove loop-spec.k --definition verification-kompiled --spec-module LOOP-SPEC' in /work
