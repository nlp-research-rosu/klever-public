+          <k> Run(solutionProgram,
+                   Call(Name("all_prefixes"), Str(S)))
+            => listVal(allPrefixes(S)) </k>
+          <env> emptyEnv => emptyEnv </env>
+          <functions> emptyFEnv => ?_:FEnv </functions>
+        </mpy>
+    requires 0 <=Int lengthString(S)
