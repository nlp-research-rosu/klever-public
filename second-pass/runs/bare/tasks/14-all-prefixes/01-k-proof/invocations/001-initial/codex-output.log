diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b95a96c4a28efbe75699e6cdf33650d8bdae1fc
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def all_prefixes(string: str) -> List[str]:
+    result = []
+    i = 1
+    while i <= len(string):
+        result.append(string[:i])
+        i = i + 1
+    return result
