--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+  "$@"
+  command_status=$?
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+} >"$log_file" 2>&1
+
+exit "$command_status"
