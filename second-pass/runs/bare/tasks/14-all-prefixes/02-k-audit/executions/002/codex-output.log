diff --git a//tmp/audit-work/rebuild/body-mutation-verification.k b//tmp/audit-work/rebuild/body-mutation-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2d0c8c0892fe95ef091e552aaa5b9ad8f1790292
--- /dev/null
+++ b//tmp/audit-work/rebuild/body-mutation-verification.k
@@ -0,0 +1,20 @@
+requires "verified-lemma.k"
+
+module BODY-MUTATION-VERIFICATION
+  imports VERIFIED-LEMMA
+
+  syntax Program ::= "mutatedProgram" [function]
+  rule mutatedProgram =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("all_prefixes", Params("string"),
+        Assign(Name("result"), ListExpr())
+        Assign(Name("i"), Int(2))
+        While(Compare(Name("i"), CmpOp("<=", Call(Name("len"), Name("string")))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              Subscript(Name("string"), Slice(NoBound, Name("i"), NoBound))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("result"))))
+endmodule
