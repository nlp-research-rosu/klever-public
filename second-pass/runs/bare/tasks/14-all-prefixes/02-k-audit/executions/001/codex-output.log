===== /candidate/solution-program.k =====
     1	module SOLUTION-PROGRAM
     2	  imports MPY
     3	  syntax Program ::= "solutionProgram" [function]
     4	  rule solutionProgram =>
     5	    Module(
     6	      ImportFrom("typing", "List")
     7	      FuncDef("all_prefixes", Params("string"),
     8	        Assign(Name("result"), ListExpr())
     9	        Assign(Name("i"), Int(1))
    10	        While(Compare(Name("i"), CmpOp("<=", Call(Name("len"), Name("string")))),
    11	          Expr(
    12	            Call(
    13	              Attribute(Name("result"), "append"),
    14	              Subscript(Name("string"), Slice(NoBound, Name("i"), NoBound))))
    15	          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    16	        Return(Name("result"))))
    17	endmodule

===== /candidate/spec.k =====
     1	requires "verified-lemma.k"
     2	
     3	module SPEC
     4	  imports VERIFIED-LEMMA
     5	
     6	  claim <mpy>
     7	          <k> Run(solutionProgram,
     8	                   Call(Name("all_prefixes"), Str(S)))
     9	            => listVal(allPrefixes(S)) </k>
    10	          <env> emptyEnv => emptyEnv </env>
    11	          <functions> emptyFEnv => ?_:FEnv </functions>
    12	        </mpy>
    13	    requires 0 <=Int lengthString(S)
    14	endmodule

===== /candidate/loop-spec.k =====
     1	requires "verification.k"
     2	
     3	module LOOP-SPEC
     4	  imports VERIFICATION
     5	
     6	  claim <mpy>
     7	          <k>
     8	            loop(
     9	              Compare(Name("i"),
    10	                CmpOp("<=", Call(Name("len"), Name("string")))),
    11	              Expr(Call(Attribute(Name("result"), "append"),
    12	                Subscript(Name("string"),
    13	                  Slice(NoBound, Name("i"), NoBound))))
    14	              Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    15	            ~> exec(Return(Name("result")))
    16	            ~> restoreEnv(OLD)
    17	            => listVal(allPrefixes(S))
    18	          </k>
    19	          <env>
    20	            bind("string", strVal(S),
    21	              bind("result", listVal(pacc(S, N)),
    22	                bind("i", intVal(I), emptyEnv)))
    23	            => OLD
    24	          </env>
    25	          <functions> _FUNS </functions>
    26	        </mpy>
    27	    requires 0 <=Int lengthString(S)
    28	     andBool 0 <=Int N
    29	     andBool N <=Int lengthString(S)
    30	     andBool I ==Int N +Int 1
    31	endmodule

===== /candidate/verification.k =====
     1	requires "semantic.k"
     2	requires "solution-program.k"
     3	
     4	module VERIFICATION
     5	  imports MPY
     6	  imports SOLUTION-PROGRAM
     7	
     8	  // pacc(S,N) is the abstract list of the first N nonempty prefixes of S.
     9	  // These two equations establish its base case and its induction step.
    10	  syntax Values ::= pacc(String, Int)
    11	  rule pacc(_, 0) => vnil
    12	  rule snoc(pacc(S, N), strVal(substrString(S, 0, I)))
    13	    => pacc(S, N +Int 1)
    14	    requires I ==Int N +Int 1
    15	    [simplification]
    16	
    17	  syntax Values ::= allPrefixes(String) [function]
    18	  rule allPrefixes(S) => pacc(S, lengthString(S))
    19	endmodule

===== /candidate/verified-lemma.k =====
     1	requires "verification.k"
     2	
     3	module VERIFIED-LEMMA
     4	  imports VERIFICATION
     5	
     6	  // This is the N=0 instance of the inductive claim proved in LOOP-SPEC.
     7	  rule <k>
     8	         loop(
     9	           Compare(Name("i"),
    10	             CmpOp("<=", Call(Name("len"), Name("string")))),
    11	           Expr(Call(Attribute(Name("result"), "append"),
    12	             Subscript(Name("string"),
    13	               Slice(NoBound, Name("i"), NoBound))))
    14	           Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    15	         ~> exec(Return(Name("result")))
    16	         ~> restoreEnv(OLD)
    17	         => listVal(allPrefixes(S))
    18	       </k>
    19	       <env>
    20	         bind("string", strVal(S),
    21	           bind("result", listVal(vnil),
    22	             bind("i", intVal(1), emptyEnv)))
    23	         => OLD
    24	       </env>
    25	    requires 0 <=Int lengthString(S)
    26	    [priority(30)]
    27	endmodule

===== /candidate/embed_mpy.py =====
     1	#!/usr/bin/env python3
     2	"""Embed the freshly translated program as the K proof target."""
     3	
     4	from pathlib import Path
     5	
     6	
     7	term = Path("solution.mpy").read_text(encoding="utf-8").strip()
     8	indented = "\n".join("    " + line for line in term.splitlines())
     9	print('module SOLUTION-PROGRAM')
    10	print('  imports MPY')
    11	print('  syntax Program ::= "solutionProgram" [function]')
    12	print('  rule solutionProgram =>')
    13	print(indented)
    14	print('endmodule')

===== /candidate/prove.sh =====
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
     5	cd "$SCRIPT_DIR"
     6	
     7	# Recreate the translated program and bind that exact AST into the proof.
     8	python3 py2mpy.py solution.py > solution.mpy
     9	python3 embed_mpy.py > solution-program.k
    10	
    11	# Check the executable Python and exercise the operational K semantics.
    12	python3 -c 'from solution import all_prefixes; assert all_prefixes("") == []; assert all_prefixes("abc") == ["a", "ab", "abc"]'
    13	kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX
    14	krun solution.mpy --definition verification-kompiled
    15	krun run-empty.mpy --definition verification-kompiled
    16	krun run-abc.mpy --definition verification-kompiled
    17	
    18	# Prove the loop invariant without a summary rule.
    19	kprove loop-spec.k --definition verification-kompiled --spec-module LOOP-SPEC
    20	
    21	# Compile the proven invariant as a verification lemma, then prove the target.
    22	kompile verified-lemma.k --backend haskell --main-module VERIFIED-LEMMA --syntax-module MPY-SYNTAX
    23	kprove spec.k --definition verified-lemma-kompiled --spec-module SPEC

