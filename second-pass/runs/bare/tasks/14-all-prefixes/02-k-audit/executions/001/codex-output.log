     5	from typing import List
     6	
     7	
     8	def all_prefixes(string: str) -> List[str]:
     9	    """ Return list of all prefixes from shortest to longest of the input string
    10	    >>> all_prefixes('abc')
    11	    ['a', 'ab', 'abc']
    12	    """
    13	    result = []
    14	
    15	    for i in range(len(string)):
    16	        result.append(string[:i+1])
    17	    return result

