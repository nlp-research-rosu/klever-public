+++ b/spec.k
@@ -0,0 +1,81 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [generate-integers-correct]:
+   <py>
+    <k>
+      Module(
+        FuncDef("generate_integers", Params("a", "b"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          If(Compare(Name("a"), CmpOp("<=", Name("b"))),
+            If(Compare(Name("a"), CmpOp("<=", Int(2))),
+              If(Compare(Int(2), CmpOp("<=", Name("b"))),
+                Assign(
+                  Name("result"),
+                  BinOp("+", Name("result"), ListExpr(Int(2)))),
+                .Stmts),
+              .Stmts)
+            If(Compare(Name("a"), CmpOp("<=", Int(4))),
+              If(Compare(Int(4), CmpOp("<=", Name("b"))),
+                Assign(
+                  Name("result"),
+                  BinOp("+", Name("result"), ListExpr(Int(4)))),
+                .Stmts),
+              .Stmts)
+            If(Compare(Name("a"), CmpOp("<=", Int(6))),
+              If(Compare(Int(6), CmpOp("<=", Name("b"))),
+                Assign(
+                  Name("result"),
+                  BinOp("+", Name("result"), ListExpr(Int(6)))),
+                .Stmts),
+              .Stmts)
+            If(Compare(Name("a"), CmpOp("<=", Int(8))),
+              If(Compare(Int(8), CmpOp("<=", Name("b"))),
+                Assign(
+                  Name("result"),
+                  BinOp("+", Name("result"), ListExpr(Int(8)))),
+                .Stmts),
+              .Stmts),
+            If(Compare(Name("b"), CmpOp("<=", Int(2))),
+              If(Compare(Int(2), CmpOp("<=", Name("a"))),
+                Assign(
+                  Name("result"),
+                  BinOp("+", Name("result"), ListExpr(Int(2)))),
+                .Stmts),
+              .Stmts)
+            If(Compare(Name("b"), CmpOp("<=", Int(4))),
+              If(Compare(Int(4), CmpOp("<=", Name("a"))),
+                Assign(
+                  Name("result"),
+                  BinOp("+", Name("result"), ListExpr(Int(4)))),
+                .Stmts),
+              .Stmts)
+            If(Compare(Name("b"), CmpOp("<=", Int(6))),
+              If(Compare(Int(6), CmpOp("<=", Name("a"))),
+                Assign(
+                  Name("result"),
+                  BinOp("+", Name("result"), ListExpr(Int(6)))),
+                .Stmts),
+              .Stmts)
+            If(Compare(Name("b"), CmpOp("<=", Int(8))),
+              If(Compare(Int(8), CmpOp("<=", Name("a"))),
+                Assign(
+                  Name("result"),
+                  BinOp("+", Name("result"), ListExpr(Int(8)))),
+                .Stmts),
+              .Stmts))
+          Return(Name("result"))))
+      => .K
+    </k>
+    <input> pair(A, B) </input>
+    <env> .Map =>
+      "a" |-> intVal(A)
+      "b" |-> intVal(B)
+      "result" |-> listVal(expected(A, B))
+    </env>
+    <result> noResult => listVal(expected(A, B)) </result>
+   </py>
+  requires A >Int 0 andBool B >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..865c3408630aac5dfa6cb8909bccd15df64d05ae
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax List ::= expectedDigit(Int, Int, Int) [function]
+  syntax List ::= expected(Int, Int) [function]
+
+  rule expectedDigit(A, B, D) => ListItem(D)
+    requires (A <=Int D andBool D <=Int B)
+      orBool (B <=Int D andBool D <=Int A)
+  rule expectedDigit(A, B, D) => .List
+    requires notBool (
+      (A <=Int D andBool D <=Int B)
+        orBool (B <=Int D andBool D <=Int A))
+
+  rule expected(A, B)
+    => expectedDigit(A, B, 2)
+       expectedDigit(A, B, 4)
+       expectedDigit(A, B, 6)
+       expectedDigit(A, B, 8)
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5b0de72dae6bd29084efc21137d163a1a3a0527b
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd -- "$(dirname -- "$0")"
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile semantic.k \
+  --backend llvm \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy --definition semantic-kompiled -cA=2 -cB=8
+krun solution.mpy --definition semantic-kompiled -cA=8 -cB=2
+krun solution.mpy --definition semantic-kompiled -cA=10 -cB=14
+krun solution.mpy --definition semantic-kompiled -cA=3 -cB=7
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..bde5196e5118f77ae96492e82a8015d3c50f9a24
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,105 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= Module(Stmts)
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= FuncDef(String, Params, Stmts)
+                | Assign(Expr, Expr)
+                | If(Expr, Stmts, Stmts)
+                | Return(Expr)
+
+  syntax Params ::= Params(Strings)
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= Name(String)
+                | Int(Int)
+                | ListExpr(Exprs)
+                | Compare(Expr, CmpOps)
+                | BinOp(String, Expr, Expr)
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= CmpOp(String, Expr)
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports LIST
+  imports MAP
+
+  syntax Input ::= pair(Int, Int)
+  syntax Value ::= intVal(Int) | boolVal(Bool) | listVal(List)
+  syntax Result ::= "noResult" | Value
+
+  syntax KItem ::= exec(Stmts)
+                 | execStmt(Stmt)
+                 | eval(Expr)
+                 | assignTo(String)
+                 | binRight(String, Value)
+                 | cmpLeft(String, Expr)
+                 | cmpRight(String, Value)
+                 | choose(Stmts, Stmts)
+                 | "returnValue"
+
+  configuration
+    <py>
+      <k> $PGM:Program </k>
+      <input> pair($A:Int, $B:Int) </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+
+  rule <k> Module(FuncDef("generate_integers", Params("a", "b"), BODY))
+        => exec(BODY) ... </k>
+       <input> pair(A, B) </input>
+       <env> .Map => ("a" |-> intVal(A)) ("b" |-> intVal(B)) </env>
+
+  rule exec(.Stmts) => .K
+  rule exec((S:Stmt REST:Stmts)) => execStmt(S) ~> exec(REST)
+
+  rule execStmt(Assign(Name(X), E)) => eval(E) ~> assignTo(X)
+  rule <k> V:Value ~> assignTo(X) => .K ... </k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule execStmt(If(COND, THEN, ELSE))
+    => eval(COND) ~> choose(THEN, ELSE)
+  rule boolVal(true) ~> choose(THEN, _) => exec(THEN)
+  rule boolVal(false) ~> choose(_, ELSE) => exec(ELSE)
+
+  rule execStmt(Return(E)) => eval(E) ~> returnValue
+  rule <k> V:Value ~> returnValue => .K ... </k>
+       <result> _ => V </result>
+
+  rule eval(Int(I)) => intVal(I)
+  rule <k> eval(Name(X)) => V ... </k>
+       <env>... X |-> V ...</env>
+  rule eval(ListExpr(.Exprs)) => listVal(.List)
+  rule eval(ListExpr(Int(I))) => listVal(ListItem(I))
+
+  rule eval(BinOp(OP, LEFT, RIGHT))
+    => eval(LEFT) ~> binRight(OP, evalPlaceholder(RIGHT))
+
+  syntax Value ::= evalPlaceholder(Expr)
+  rule V:Value ~> binRight(OP, evalPlaceholder(RIGHT))
+    => eval(RIGHT) ~> binRight(OP, V)
+  rule listVal(RIGHT) ~> binRight("+", listVal(LEFT))
+    => listVal(LEFT RIGHT)
+
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+    => eval(LEFT) ~> cmpLeft(OP, RIGHT)
+  rule V:Value ~> cmpLeft(OP, RIGHT)
+    => eval(RIGHT) ~> cmpRight(OP, V)
+  rule intVal(RIGHT) ~> cmpRight("<=", intVal(LEFT))
+    => boolVal(true)
+    requires LEFT <=Int RIGHT
+  rule intVal(RIGHT) ~> cmpRight("<=", intVal(LEFT))
+    => boolVal(false)
+    requires notBool (LEFT <=Int RIGHT)
+endmodule
