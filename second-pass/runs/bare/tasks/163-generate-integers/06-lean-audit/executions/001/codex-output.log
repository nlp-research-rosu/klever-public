+    for rule in reconstructed_rules
+):
+    raise SystemExit("rule reconstruction failed")
+if resolution["mode"] == "CLASSIFICATION_ONLY" and candidate.exists():
+    raise SystemExit("candidate exists in CLASSIFICATION_ONLY mode")
