diff --git a/evidence/01_trusted_tool_inspection_commands.sh b/evidence/01_trusted_tool_inspection_commands.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3975d808a7ced3955bb5c0c152ceee873b69177f
