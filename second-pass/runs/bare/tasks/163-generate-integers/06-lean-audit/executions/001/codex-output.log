+
+target_definitions: list[str] = []
+lean_files: list[str] = []
+for relative, kind, path in klean_export._tree_entries(generated):
+    if kind == "file" and path.suffix == ".lean":
+        lean_files.append(relative)
+        for match in re.finditer(
