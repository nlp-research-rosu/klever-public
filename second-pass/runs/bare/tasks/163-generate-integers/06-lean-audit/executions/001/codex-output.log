@@ -0,0 +1,16 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  ssize_t size = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (size < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  path[size] = '\0';
+  printf("%s\n", path);
+  return 0;
+}
