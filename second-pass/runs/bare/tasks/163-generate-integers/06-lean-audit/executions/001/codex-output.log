diff --git a//tmp/audit-work/read_self_exe.c b//tmp/audit-work/read_self_exe.c
new file mode 100644
index 0000000000000000000000000000000000000000..565880eff6eb32c34119b3b9a76a59197cd2b2f8
--- /dev/null
+++ b//tmp/audit-work/read_self_exe.c
@@ -0,0 +1,16 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[4096];
+  ssize_t size = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (size < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  path[size] = '\0';
+  printf("%s\n", path);
+  return 0;
+}
diff --git a//tmp/audit-work/trace_paths.c b//tmp/audit-work/trace_paths.c
new file mode 100644
index 0000000000000000000000000000000000000000..f97e3384196dc7a181e4282733f61673d702e2a7
--- /dev/null
+++ b//tmp/audit-work/trace_paths.c
@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+typedef char *(*realpath_fn)(const char *, char *);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn original;
+  if (!original) original = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = original(path, buffer, size);
+  int saved = errno;
+  dprintf(2, "TRACE readlink(%s)=%zd errno=%d\n", path, result, saved);
+  errno = saved;
+  return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+  static realpath_fn original;
+  if (!original) original = (realpath_fn)dlsym(RTLD_NEXT, "realpath");
+  char *result = original(path, resolved);
+  int saved = errno;
+  dprintf(2, "TRACE realpath(%s)=%s errno=%d\n", path,
+          result ? result : "<null>", saved);
+  errno = saved;
+  return result;
+}
