index 0000000000000000000000000000000000000000..d23dab2d9c32f400095427debb4bab5f824cbdd4
--- /dev/null
+++ b/evidence/05_check_generation_attempt1_commands.sh
@@ -0,0 +1,6 @@
+#!/usr/bin/env bash
+set -uo pipefail
+trap 'rc=$?; printf "\nEXIT_CODE=%s\n" "$rc"' EXIT
