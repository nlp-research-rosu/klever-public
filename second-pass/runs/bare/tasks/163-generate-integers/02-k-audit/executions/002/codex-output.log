+#!/usr/bin/env bash
+set -u
+cd /tmp/audit-work/candidate
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
