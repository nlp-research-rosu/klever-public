+mkdir -p /tmp/audit-work/candidate /tmp/audit-work/reference
+cp -a \
+  /candidate/prompt.py \
+  /candidate/prove.sh \
+  /candidate/py2mpy.py \
+  /candidate/semantic.k \
+  /candidate/solution.mpy \
+  /candidate/solution.py \
+  /candidate/spec.k \
+  /candidate/verification.k \
