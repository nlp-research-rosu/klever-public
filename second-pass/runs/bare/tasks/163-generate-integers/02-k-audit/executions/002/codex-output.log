+sha256sum /tmp/audit-work/spec-vacuity-dry-run.kore
+
+proof_command=(
+  kprove spec-vacuity.k
+  --definition /tmp/audit-work/candidate/verification-kompiled
+  --spec-module SPEC-VACUITY
+)
+printf 'COMMAND:'
