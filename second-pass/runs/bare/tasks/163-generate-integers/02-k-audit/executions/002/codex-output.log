+}
+
+run kompile --version || exit $?
+run kprove --version || exit $?
+run krun --version || exit $?
+
+run kompile semantic.k \
+  --backend llvm \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --output-definition /tmp/audit-work/candidate/semantic-kompiled || exit $?
