index 0000000000000000000000000000000000000000..2eb937baf41c629ed67b744e72795361c37df2a3
--- /dev/null
+++ b/evidence/run_stage12.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
+  return "$status"
+}
+
+run_capture() {
+  output=$1
+  shift
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf ' > %q\n' "$output"
+  "$@" > "$output"
+  status=$?
