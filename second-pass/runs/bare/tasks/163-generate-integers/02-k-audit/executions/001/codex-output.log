--- trusted canonical ---
# canonical.py — the UNMODIFIED HumanEval/163 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: generate_integers


def generate_integers(a, b):
    """
    Given two positive integers a and b, return the even digits between a
    and b, in ascending order.

    For example:
    generate_integers(2, 8) => [2, 4, 6, 8]
    generate_integers(8, 2) => [2, 4, 6, 8]
    generate_integers(10, 14) => []
    """
    lower = max(2, min(a, b))
    upper = min(8, max(a, b))

    return [i for i in range(lower, upper+1) if i % 2 == 0]

--- candidate solution.py ---
def generate_integers(a, b):
    result = []
    if a <= b:
        if a <= 2:
            if 2 <= b:
                result = result + [2]
        if a <= 4:
            if 4 <= b:
                result = result + [4]
        if a <= 6:
            if 6 <= b:
                result = result + [6]
        if a <= 8:
            if 8 <= b:
                result = result + [8]
    else:
        if b <= 2:
            if 2 <= a:
                result = result + [2]
        if b <= 4:
            if 4 <= a:
                result = result + [4]
        if b <= 6:
            if 6 <= a:
                result = result + [6]
        if b <= 8:
            if 8 <= a:
                result = result + [8]
    return result

