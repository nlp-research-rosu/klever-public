+++ b/prove.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd -- "$(dirname -- "$0")"
+
+# Regenerate the constructor program with the fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# VERIFICATION imports SEMANTIC, so this compiles both the interpreter and the
+# concrete observer used by the specifications.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+# Exercise the translated artifact itself on every example from prompt.py.
+krun solution.mpy --definition verification-kompiled -cN=1 -cM=5 \
+  | grep -F 'result ( binVal ( 3 ) )'
+krun solution.mpy --definition verification-kompiled -cN=7 -cM=5 \
+  | grep -F 'result ( intVal ( -1 ) )'
+krun solution.mpy --definition verification-kompiled -cN=10 -cM=20 \
+  | grep -F 'result ( binVal ( 15 ) )'
+krun solution.mpy --definition verification-kompiled -cN=20 -cM=33 \
+  | grep -F 'result ( binVal ( 26 ) )'
+
+# Prove all universal partition claims, prompt examples, and rendering claims.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --output pretty
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..f93f375049f15703005e5d12c6ba899fc081b9a1
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,116 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // Concrete syntax emitted by the fixed py2mpy.py translator.  This task
+  // uses only the constructors below; unsupported Python constructs cannot
+  // silently acquire a meaning in this semantics.
+  syntax Module ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  // A binVal(I) is the canonical semantic representation of the Python
+  // string bin(I).  Keeping its integer payload preserves exact symbolic
+  // equality while VERIFICATION supplies a concrete string observer.
+  syntax PyVal ::= "intVal" "(" Int ")"
+                 | "boolVal" "(" Bool ")"
+                 | "ratVal" "(" Int "," Int ")"
+                 | "binVal" "(" Int ")"
+  syntax Result ::= "noResult" | "result" "(" PyVal ")"
+
+  syntax KItem ::= "boot" "(" Module "," Int "," Int ")"
+                 | "exec" "(" Stmts ")"
+                 | "execStmt" "(" Stmt ")"
+                 | "choose" "(" Stmts "," Stmts ")"
+                 | "doReturn"
+
+  syntax PyVal ::= "eval" "(" Expr "," Map ")" [function]
+                 | "unary" "(" String "," PyVal ")" [function]
+                 | "binary" "(" String "," PyVal "," PyVal ")" [function]
+                 | "compare" "(" String "," PyVal "," PyVal ")" [function]
+                 | "callBuiltin" "(" String "," PyVal ")" [function]
+                 | "roundValue" "(" PyVal ")" [function]
+
+  configuration
+    <py>
+      <k> boot($PGM:Module, $N:Int, $M:Int) </k>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+
+  // Loading the one public, two-argument function binds its formal names to
+  // the two concrete/symbolic inputs and starts its body.
+  rule <k> boot(Module(FuncDef("rounded_avg", Params(X:String, Y:String), BODY)), N, M)
+        => exec(BODY) ... </k>
+       <env> .Map => (X |-> intVal(N)) (Y |-> intVal(M)) </env>
+
+  rule exec(.Stmts) => .K
+  rule exec(S REST) => execStmt(S) ~> exec(REST)
+
+  rule <k> execStmt(If(COND, THEN, ELSE))
+        => eval(COND, ENV) ~> choose(THEN, ELSE) ... </k>
+       <env> ENV </env>
+  rule boolVal(true)  ~> choose(THEN, _) => exec(THEN)
+  rule boolVal(false) ~> choose(_, ELSE) => exec(ELSE)
+
+  rule <k> execStmt(Return(E)) => eval(E, ENV) ~> doReturn ... </k>
+       <env> ENV </env>
+  rule <k> V:PyVal ~> doReturn ~> _REST => .K </k>
+       <result> noResult => result(V) </result>
+
+  rule eval(Int(I), _) => intVal(I)
+  rule eval(Name(X), (X |-> V) _REST) => V
+  rule eval(UnaryOp(OP, E), ENV) => unary(OP, eval(E, ENV))
+  rule eval(BinOp(OP, L, R), ENV)
+    => binary(OP, eval(L, ENV), eval(R, ENV))
+  rule eval(Compare(L, CmpOp(OP, R)), ENV)
+    => compare(OP, eval(L, ENV), eval(R, ENV))
+  rule eval(Call(Name(F), E), ENV) => callBuiltin(F, eval(E, ENV))
+
+  rule unary("-", intVal(I)) => intVal(0 -Int I)
+  rule binary("+", intVal(I), intVal(J)) => intVal(I +Int J)
+  rule binary("/", intVal(I), intVal(J)) => ratVal(I, J)
+    requires J =/=Int 0
+  rule compare(">", intVal(I), intVal(J)) => boolVal(I >Int J)
+  rule callBuiltin("round", V) => roundValue(V)
+  rule callBuiltin("bin", intVal(I)) => binVal(I)
+
+  // Python 3 round on an exact rational: nearest integer, ties to even.
+  // The task reaches these rules with a positive numerator and denominator 2.
+  rule roundValue(ratVal(I, D)) => intVal(I /Int D)
+    requires D >Int 0 andBool 2 *Int (I %Int D) <Int D
+  rule roundValue(ratVal(I, D)) => intVal((I /Int D) +Int 1)
+    requires D >Int 0 andBool 2 *Int (I %Int D) >Int D
+  rule roundValue(ratVal(I, D)) => intVal(I /Int D)
+    requires D >Int 0
+     andBool 2 *Int (I %Int D) ==Int D
+     andBool (I /Int D) %Int 2 ==Int 0
+  rule roundValue(ratVal(I, D)) => intVal((I /Int D) +Int 1)
+    requires D >Int 0
+     andBool 2 *Int (I %Int D) ==Int D
+     andBool (I /Int D) %Int 2 =/=Int 0
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f8642d75ac5afd1396c5fd11ad1d2fe6e8b20087
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,4 @@
+def rounded_avg(n, m):
+    if n > m:
+        return -1
+    return bin(round((n + m) / 2))
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9abb2bbd6b76fcaeef03d5538b0a40b833118542
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,100 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Invalid interval.
+  claim [reversed]:
+    <py>
+      <k> boot(roundedAvgProgram, N, M) => .K </k>
+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult => result(intVal(-1)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0 andBool N >Int M
+
+  // Valid intervals with an integral midpoint.
+  claim [integral-midpoint]:
+    <py>
+      <k> boot(roundedAvgProgram, N, M) => .K </k>
+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult => result(binVal((N +Int M) /Int 2)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0
+     andBool N <=Int M
+     andBool (N +Int M) %Int 2 ==Int 0
+
+  // Half-integral midpoint whose lower neighbor is even: ties round down.
+  claim [half-even-down]:
+    <py>
+      <k> boot(roundedAvgProgram, N, M) => .K </k>
+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult => result(binVal((N +Int M) /Int 2)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0
+     andBool N <=Int M
+     andBool (N +Int M) %Int 2 ==Int 1
+     andBool ((N +Int M) /Int 2) %Int 2 ==Int 0
+
+  // Half-integral midpoint whose lower neighbor is odd: ties round up.
+  claim [half-even-up]:
+    <py>
+      <k> boot(roundedAvgProgram, N, M) => .K </k>
+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult
+        => result(binVal(((N +Int M) /Int 2) +Int 1)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0
+     andBool N <=Int M
+     andBool (N +Int M) %Int 2 ==Int 1
+     andBool ((N +Int M) /Int 2) %Int 2 ==Int 1
+
+  // The prompt's examples are also executable proof obligations.
+  claim [example-1-5]:
+    <py>
+      <k> boot(roundedAvgProgram, 1, 5) => .K </k>
+      <env> .Map => ("n" |-> intVal(1)) ("m" |-> intVal(5)) </env>
+      <result> noResult => result(binVal(3)) </result>
+    </py>
+
+  claim [example-7-5]:
+    <py>
+      <k> boot(roundedAvgProgram, 7, 5) => .K </k>
+      <env> .Map => ("n" |-> intVal(7)) ("m" |-> intVal(5)) </env>
+      <result> noResult => result(intVal(-1)) </result>
+    </py>
+
+  claim [example-10-20]:
+    <py>
+      <k> boot(roundedAvgProgram, 10, 20) => .K </k>
+      <env> .Map => ("n" |-> intVal(10)) ("m" |-> intVal(20)) </env>
+      <result> noResult => result(binVal(15)) </result>
+    </py>
+
+  claim [example-20-33]:
+    <py>
+      <k> boot(roundedAvgProgram, 20, 33) => .K </k>
+      <env> .Map => ("n" |-> intVal(20)) ("m" |-> intVal(33)) </env>
+      <result> noResult => result(binVal(26)) </result>
+    </py>
+
+  claim [render-3]:
+    <py>
+      <k> renderBinary(binVal(3)) => "0b11" </k>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+
+  claim [render-15]:
+    <py>
+      <k> renderBinary(binVal(15)) => "0b1111" </k>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+
+  claim [render-26]:
+    <py>
+      <k> renderBinary(binVal(26)) => "0b11010" </k>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+endmodule
