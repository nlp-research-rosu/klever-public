+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Invalid interval.
+  claim [reversed]:
+    <py>
+      <k> boot(roundedAvgProgram, N, M) => .K </k>
+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult => result(intVal(-1)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0 andBool N >Int M
+
+  // Valid intervals with an integral midpoint.
+  claim [integral-midpoint]:
+    <py>
+      <k> boot(roundedAvgProgram, N, M) => .K </k>
+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult => result(binVal((N +Int M) /Int 2)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0
+     andBool N <=Int M
+     andBool (N +Int M) %Int 2 ==Int 0
+
+  // Half-integral midpoint whose lower neighbor is even: ties round down.
+  claim [half-even-down]:
+    <py>
+      <k> boot(roundedAvgProgram, N, M) => .K </k>
+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult => result(binVal((N +Int M) /Int 2)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0
+     andBool N <=Int M
+     andBool (N +Int M) %Int 2 ==Int 1
+     andBool ((N +Int M) /Int 2) %Int 2 ==Int 0
+
+  // Half-integral midpoint whose lower neighbor is odd: ties round up.
+  claim [half-even-up]:
+    <py>
+      <k> boot(roundedAvgProgram, N, M) => .K </k>
+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult
+        => result(binVal(((N +Int M) /Int 2) +Int 1)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0
+     andBool N <=Int M
+     andBool (N +Int M) %Int 2 ==Int 1
+     andBool ((N +Int M) /Int 2) %Int 2 ==Int 1
+
+  // The prompt's examples are also executable proof obligations.
+  claim [example-1-5]:
+    <py>
+      <k> boot(roundedAvgProgram, 1, 5) => .K </k>
+      <env> .Map => ("n" |-> intVal(1)) ("m" |-> intVal(5)) </env>
+      <result> noResult => result(binVal(3)) </result>
+    </py>
+
+  claim [example-7-5]:
+    <py>
+      <k> boot(roundedAvgProgram, 7, 5) => .K </k>
+      <env> .Map => ("n" |-> intVal(7)) ("m" |-> intVal(5)) </env>
+      <result> noResult => result(intVal(-1)) </result>
+    </py>
+
+  claim [example-10-20]:
+    <py>
+      <k> boot(roundedAvgProgram, 10, 20) => .K </k>
+      <env> .Map => ("n" |-> intVal(10)) ("m" |-> intVal(20)) </env>
+      <result> noResult => result(binVal(15)) </result>
+    </py>
+
+  claim [example-20-33]:
+    <py>
+      <k> boot(roundedAvgProgram, 20, 33) => .K </k>
+      <env> .Map => ("n" |-> intVal(20)) ("m" |-> intVal(33)) </env>
+      <result> noResult => result(binVal(26)) </result>
+    </py>
+
+  claim [render-3]: renderBinary(binVal(3)) => "0b11"
+  claim [render-15]: renderBinary(binVal(15)) => "0b1111"
+  claim [render-26]: renderBinary(binVal(26)) => "0b11010"
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9e7b882fcaadaf127d75bcf84d0b2a76f9a38817
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,34 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This constant is deliberately the exact constructor tree generated in
+  // solution.mpy.  Specs execute it through SEMANTIC rather than replacing
+  // the program with a mathematical shortcut.
+  syntax Module ::= roundedAvgProgram [function]
+  rule roundedAvgProgram =>
+    Module(
+      FuncDef("rounded_avg", Params("n", "m"),
+        If(Compare(Name("n"), CmpOp(">", Name("m"))),
+          Return(UnaryOp("-", Int(1))),
+          .Stmts)
+        Return(
+          Call(
+            Name("bin"),
+            Call(
+              Name("round"),
+              BinOp("/", BinOp("+", Name("n"), Name("m")), Int(2)))))))
+
+  // Concrete observer for the abstract binary-string value.  It is kept out
+  // of symbolic program execution so an unbounded integer proof does not try
+  // to unfold an unbounded number of output bits.
+  syntax String ::= renderBinary(PyVal) [function]
+                  | unsignedBits(Int) [function]
+  rule renderBinary(binVal(I)) => "0b" +String unsignedBits(I)
+    requires I >=Int 0
+  rule unsignedBits(0) => "0"
+  rule unsignedBits(1) => "1"
+  rule unsignedBits(I) => unsignedBits(I /Int 2) +String Int2String(I %Int 2)
+    requires I >=Int 2
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module MPY-SYNTAX' in /work
