+      <env> .Map => ("n" |-> intVal(N)) ("m" |-> intVal(M)) </env>
+      <result> noResult => result(binVal((N +Int M) /Int 2)) </result>
+    </py>
+    requires N >Int 0 andBool M >Int 0
