56\": \"5de714e9c454f50254529fd85558b76f582017b5faf06ce06dae33ad6829ffcf\",\n    \"run_manifest_sha256\": \"16ab5496e5b7251ecd747d4b58693a614cb2f6d680317214f597d0437ab39c24\",\n    \"stage1_invocation_sha256\": \"30004a0b2d790a4705621ab97c17618e0feadc52453f1998cda1cfe0e71c30c6\",\n    \"stage1_result_sha256\": \"a3b23b841b25e34af5c2d7a0df3a4e29aa8f0de39106a39ab551e9892ad0e499\",\n    \"task_manifest_sha256\": \"5de714e9c454f50254529fd85558b76f582017b5faf06ce06dae33ad6829ffcf\",\n    \"trusted_prompt_sha256\": \"60808c911a60e25f559e0f929c49206062eb742f0e32ab431f5ba9daf280a694\",\n    \"trusted_reference_semantics_sha256\": null,\n    \"trusted_translator_sha256\": \"406485eac118431c08ef59f30f79dfa6aa9d5825408917fc5ce7c806e664db16\"\n  },\n  \"integrity\": {\n    \"candidate_prompt_matches_trusted\": true,\n    \"candidate_reference_semantics_matches_trusted\": null,\n    \"candidate_translator_matches_trusted\": true,\n    \"manifest_prompt_hash_matches_trusted\": true,\n    \"manifest_reference_semantics_hash_matches_trusted\": null,\n    \"manifest_translator_hash_matches_trusted\": true\n  },\n  \"manifest\": {\n    \"condition\": {\n      \"kit\": false,\n      \"name\": \"bare\",\n      \"semantics\": false\n    },\n    \"config\": \"codex-gpt-5.6-sol-xhigh-bare\",\n    \"current_stage\": \"01-k-proof\",\n    \"input_provenance\": \"COMPLETE\",\n    \"inputs\": {\n      \"instruction_prompt_sha256\": \"4fbd8d83152646045c82c9b1c86a3c0c9bf686de949fcbf8c3eff6755a261d9e\",\n      \"problem_prompt_sha256\": \"60808c911a60e25f559e0f929c49206062eb742f0e32ab431f5ba9daf280a694\",\n      \"translator_sha256\": \"406485eac118431c08ef59f30f79dfa6aa9d5825408917fc5ce7c806e664db16\"\n    },\n    \"problem_id\": \"103-rounded-avg\",\n    \"schema_version\": 2\n  },\n  \"manifest_config\": \"codex-gpt-5.6-sol-xhigh-bare\",\n  \"mount_reference_semantics\": false,\n  \"problem_id\": \"103-rounded-avg\",\n  \"record_layout\": \"legacy-selected-stage1\",\n  \"reference_semantics\": null,\n  \"repo\": \"/home/yuqing/Documents/Code/humaneval-benchmark\",\n  \"run_id\": \"codex-gpt-5.6-sol-xhigh-bare\",\n  \"run_manifest\": \"/home/yuqing/Documents/Code/humaneval-benchmark/runs/codex-gpt-5.6-sol-xhigh-bare/run.json\",\n  \"semantics_mode\": \"GENERATED_SEMANTICS\",\n  \"stage1_invocation\": \"/home/yuqing/Documents/Code/humaneval-benchmark/runs/codex-gpt-5.6-sol-xhigh-bare/tasks/103-rounded-avg/01-k-proof/invocations/001-initial\",\n  \"stage1_result\": \"/home/yuqing/Documents/Code/humaneval-benchmark/runs/codex-gpt-5.6-sol-xhigh-bare/tasks/103-rounded-avg/01-k-proof/result.json\",\n  \"task_manifest\": \"/home/yuqing/Documents/Code/humaneval-benchmark/runs/codex-gpt-5.6-sol-xhigh-bare/tasks/103-rounded-avg/task.json\",\n  \"translator\": \"/home/yuqing/Documents/Code/humaneval-benchmark/tools/py2mpy.py\",\n  \"trusted_prompt\": \"/home/yuqing/Documents/Code/humaneval-benchmark/data/questions/103-rounded-avg/prompt.py\"\n}\n===== audit-campaign-lock.json =====\n{\n  \"audit_image\": \"humaneval-codex-runner\",\n  \"audit_image_id\": \"sha256:60f2253eeda460995d1f6d18e0f20a7f040daac70a198e312d7b8e38d1e5814e\",\n  \"audit_prompt_sha256\": \"999526823ad89bcd9b6e77db8f5f1189f629c86c9ecb308094b84c7161c04e5a\",\n  \"campaign_id\": \"bare-semantics-audit-20260726\",\n  \"codex_cli_version\": \"0.144.6\",\n  \"k_version\": \"7.1.293\",\n  \"kit_commit\": \"b9135325caf193f3db60f4ae425dc862a4cd5d5d\",\n  \"kit_lock_sha256\": \"e8babd066f519044ade6429a70c6475c14a7243343405cb743a8a533510ed5a7\",\n  \"kit_plugin_version\": \"0.2.0\",\n  \"kit_skills_tree\": \"4b0437eba376335ce13e26cc33b964a3f890b07c\",\n  \"lean_toolchain\": \"leanprover/lean4:v4.22.0\",\n  \"pyk_version\": \"7.1.293\",\n  \"schema_version\": 1,\n  \"toolchain_lock_sha256\": \"a3dc0270ff7cab64550e91f605d8f2b5f6076b75f4ec49629a0e13894455fa9f\"\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f9efe-24a0-7f61-a0a9-7557b2f24968"}}}
