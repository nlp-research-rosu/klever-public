from pathlib import Path
import hashlib,itertools,json,os,stat
roots=[(Path('/generation-evidence/codex-trace'),'226bff36d0d8f4fb6a9a2af8308751d948644c84eb97d4d04f7d4c3e9227f8f6'),(Path('/candidate'),'189f493083eb18226ebb7c2595e2b555ba28d8f1b5edb974ebfe58676c37256e')]
