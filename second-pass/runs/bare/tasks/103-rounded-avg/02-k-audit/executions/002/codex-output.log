+#!/usr/bin/env python3
+"""Compare a freshly built generated K semantics with independent Python execution."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import re
+import subprocess
+
+
+WORK = Path("/tmp/audit-work/reconstruction")
