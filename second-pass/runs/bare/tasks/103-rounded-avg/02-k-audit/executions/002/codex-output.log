  "input": "const patch = \"*** Begin Patch\\n*** Add File: /work/semantic.k\\n+module MPY-SYNTAX\\n+  imports INT-SYNTAX\\n+  imports BOOL-SYNTAX\\n+  imports STRING-SYNTAX\\n+\\n+  // Concrete syntax emitted by the fixed py2mpy.py translator.  This task\\n+  // uses only the constructors below; unsupported Python constructs cannot\\n+  // silently acquire a meaning in this semantics.\\n+  syntax Module ::= \\\"Module\\\" \\\"(\\\" Stmts \\\")\\\"\\n+  syntax Stmts ::= List{Stmt, \\\"\\\"}\\n+  syntax Stmt ::= \\\"FuncDef\\\" \\\"(\\\" String \\\",\\\" Params \\\",\\\" Stmts \\\")\\\"\\n+                | \\\"If\\\" \\\"(\\\" Expr \\\",\\\" Stmts \\\",\\\" Stmts \\\")\\\"\\n+                | \\\"Return\\\" \\\"(\\\" Expr \\\")\\\"\\n+\\n+  syntax Params ::= \\\"Params\\\" \\\"(\\\" Strings \\\")\\\"\\n+  syntax Strings ::= List{String, \\\",\\\"}\\n+\\n+  syntax Expr ::= \\\"Int\\\" \\\"(\\\" Int \\\")\\\"\\n+                | \\\"Name\\\" \\\"(\\\" String \\\")\\\"\\n+                | \\\"UnaryOp\\\" \\\"(\\\" String \\\",\\\" Expr \\\")\\\"\\n+                | \\\"BinOp\\\" \\\"(\\\" String \\\",\\\" Expr \\\",\\\" Expr \\\")\\\"\\n+                | \\\"Compare\\\" \\\"(\\\" Expr \\\",\\\" CmpOps \\\")\\\"\\n+                | \\\"Call\\\" \\\"(\\\" Expr \\\",\\\" Exprs \\\")\\\"\\n+  syntax Exprs ::= List{Expr, \\\",\\\"}\\n+  syntax CmpOp ::= \\\"CmpOp\\\" \\\"(\\\" String \\\",\\\" Expr \\\")\\\"\\n+  syntax CmpOps ::= List{CmpOp, \\\",\\\"}\\n+endmodule\\n+\\n+module SEMANTIC\\n+  imports MPY-SYNTAX\\n+  imports INT\\n+  imports BOOL\\n+  imports STRING\\n+  imports MAP\\n+\\n+  // A binVal(I) is the canonical semantic representation of the Python\\n+  // string bin(I).  Keeping its integer payload preserves exact symbolic\\n+  // equality while VERIFICATION supplies a concrete string observer.\\n+  syntax PyVal ::= intVal(Int)\\n+                 | boolVal(Bool)\\n+                 | ratVal(Int, Int)\\n+                 | binVal(Int)\\n+  syntax Result ::= noResult | result(PyVal)\\n+\\n+  syntax KItem ::= boot(Module, Int, Int)\\n+                 | exec(Stmts)\\n+                 | execStmt(Stmt)\\n+                 | choose(Stmts, Stmts)\\n+                 | doReturn\\n+\\n+  syntax PyVal ::= eval(Expr, Map) [function]\\n+                 | unary(String, PyVal) [function]\\n+                 | binary(String, PyVal, PyVal) [function]\\n+                 | compare(String, PyVal, PyVal) [function]\\n+                 | callBuiltin(String, PyVal) [function]\\n+                 | roundValue(PyVal) [function]\\n+\\n+  configuration\\n+    <py>\\n+      <k> boot($PGM:Module, $N:Int, $M:Int) </k>\\n+      <env> .Map </env>\\n+      <result> noResult </result>\\n+    </py>\\n+\\n+  // Loading the one public, two-argument function binds its formal names to\\n+  // the two concrete/symbolic inputs and starts its body.\\n+  rule <k> boot(Module(FuncDef(\\\"rounded_avg\\\", Params(X, Y), BODY)), N, M)\\n+        => exec(BODY) ... </k>\\n+       <env> .Map => (X |-> intVal(N)) (Y |-> intVal(M)) </env>\\n+\\n+  rule exec(.Stmts) => .K\\n+  rule exec(S REST) => execStmt(S) ~> exec(REST)\\n+\\n+  rule <k> execStmt(If(COND, THEN, ELSE))\\n+        => eval(COND, ENV) ~> choose(THEN, ELSE) ... </k>\\n+       <env> ENV </env>\\n+  rule boolVal(true)  ~> choose(THEN, _) => exec(THEN)\\n+  rule boolVal(false) ~> choose(_, ELSE) => exec(ELSE)\\n+\\n+  rule <k> execStmt(Return(E)) => eval(E, ENV) ~> doReturn ... </k>\\n+       <env> ENV </env>\\n+  rule <k> V:PyVal ~> doReturn ~> _REST => .K </k>\\n+       <result> noResult => result(V) </result>\\n+\\n+  rule eval(Int(I), _) => intVal(I)\\n+  rule eval(Name(X), (X |-> V) _REST) => V\\n+  rule eval(UnaryOp(OP, E), ENV) => unary(OP, eval(E, ENV))\\n+  rule eval(BinOp(OP, L, R), ENV)\\n+    => binary(OP, eval(L, ENV), eval(R, ENV))\\n+  rule eval(Compare(L, CmpOp(OP, R)), ENV)\\n+    => compare(OP, eval(L, ENV), eval(R, ENV))\\n+  rule eval(Call(Name(F), E), ENV) => callBuiltin(F, eval(E, ENV))\\n+\\n+  rule unary(\\\"-\\\", intVal(I)) => intVal(-Int I)\\n+  rule binary(\\\"+\\\", intVal(I), intVal(J)) => intVal(I +Int J)\\n+  rule binary(\\\"/\\\", intVal(I), intVal(J)) => ratVal(I, J)\\n+    requires J =/=Int 0\\n+  rule compare(\\\">\\\", intVal(I), intVal(J)) => boolVal(I >Int J)\\n+  rule callBuiltin(\\\"round\\\", V) => roundValue(V)\\n+  rule callBuiltin(\\\"bin\\\", intVal(I)) => binVal(I)\\n+\\n+  // Python 3 round on an exact rational: nearest integer, ties to even.\\n+  // The task reaches these rules with a positive numerator and denominator 2.\\n+  rule roundValue(ratVal(I, D)) => intVal(I /Int D)\\n+    requires D >Int 0 andBool 2 *Int (I %Int D) <Int D\\n+  rule roundValue(ratVal(I, D)) => intVal((I /Int D) +Int 1)\\n+    requires D >Int 0 andBool 2 *Int (I %Int D) >Int D\\n+  rule roundValue(ratVal(I, D)) => intVal(I /Int D)\\n+    requires D >Int 0\\n+     andBool 2 *Int (I %Int D) ==Int D\\n+     andBool (I /Int D) %Int 2 ==Int 0\\n+  rule roundValue(ratVal(I, D)) => intVal((I /Int D) +Int 1)\\n+    requires D >Int 0\\n+     andBool 2 *Int (I %Int D) ==Int D\\n+     andBool (I /Int D) %Int 2 =/=Int 0\\n+endmodule\\n*** Add File: /work/verification.k\\n+requires \\\"semantic.k\\\"\\n+\\n+module VERIFICATION\\n+  imports SEMANTIC\\n+\\n+  // This constant is deliberately the exact constructor tree generated in\\n+  // solution.mpy.  Specs execute it through SEMANTIC rather than replacing\\n+  // the program with a mathematical shortcut.\\n+  syntax Module ::= roundedAvgProgram [function]\\n+  rule roundedAvgProgram =>\\n+    Module(\\n+      FuncDef(\\\"rounded_avg\\\", Params(\\\"n\\\", \\\"m\\\"),\\n+        If(Compare(Name(\\\"n\\\"), CmpOp(\\\">\\\", Name(\\\"m\\\"))),\\n+          Return(UnaryOp(\\\"-\\\", Int(1))),\\n+          .Stmts)\\n+        Return(\\n+          Call(\\n+            Name(\\\"bin\\\"),\\n+            Call(\\n+              Name(\\\"round\\\"),\\n+              BinOp(\\\"/\\\", BinOp(\\\"+\\\", Name(\\\"n\\\"), Name(\\\"m\\\")), Int(2)))))))\\n+\\n+  // Concrete observer for the abstract binary-string value.  It is kept out\\n+  // of symbolic program execution so an unbounded integer proof does not try\\n+  // to unfold an unbounded number of output bits.\\n+  syntax String ::= renderBinary(PyVal) [function]\\n+                  | unsignedBits(Int) [function]\\n+  rule renderBinary(binVal(I)) => \\\"0b\\\" +String unsignedBits(I)\\n+    requires I >=Int 0\\n+  rule unsignedBits(0) => \\\"0\\\"\\n+  rule unsignedBits(1) => \\\"1\\\"\\n+  rule unsignedBits(I) => unsignedBits(I /Int 2) +String Int2String(I %Int 2)\\n+    requires I >=Int 2\\n+endmodule\\n*** Add File: /work/spec.k\\n+requires \\\"verification.k\\\"\\n+\\n+module SPEC\\n+  imports VERIFICATION\\n+\\n+  // Invalid interval.\\n+  claim [reversed]:\\n+    <py>\\n+      <k> boot(roundedAvgProgram, N, M) => .K </k>\\n+      <env> .Map => (\\\"n\\\" |-> intVal(N)) (\\\"m\\\" |-> intVal(M)) </env>\\n+      <result> noResult => result(intVal(-1)) </result>\\n+    </py>\\n+    requires N >Int 0 andBool M >Int 0 andBool N >Int M\\n+\\n+  // Valid intervals with an integral midpoint.\\n+  claim [integral-midpoint]:\\n+    <py>\\n+      <k> boot(roundedAvgProgram, N, M) => .K </k>\\n+      <env> .Map => (\\\"n\\\" |-> intVal(N)) (\\\"m\\\" |-> intVal(M)) </env>\\n+      <result> noResult => result(binVal((N +Int M) /Int 2)) </result>\\n+    </py>\\n+    requires N >Int 0 andBool M >Int 0\\n+     andBool N <=Int M\\n+     andBool (N +Int M) %Int 2 ==Int 0\\n+\\n+  // Half-integral midpoint whose lower neighbor is even: ties round down.\\n+  claim [half-even-down]:\\n+    <py>\\n+      <k> boot(roundedAvgProgram, N, M) => .K </k>\\n+      <env> .Map => (\\\"n\\\" |-> intVal(N)) (\\\"m\\\" |-> intVal(M)) </env>\\n+      <result> noResult => result(binVal((N +Int M) /Int 2)) </result>\\n+    </py>\\n+    requires N >Int 0 andBool M >Int 0\\n+     andBool N <=Int M\\n+     andBool (N +Int M) %Int 2 ==Int 1\\n+     andBool ((N +Int M) /Int 2) %Int 2 ==Int 0\\n+\\n+  // Half-integral midpoint whose lower neighbor is odd: ties round up.\\n+  claim [half-even-up]:\\n+    <py>\\n+      <k> boot(roundedAvgProgram, N, M) => .K </k>\\n+      <env> .Map => (\\\"n\\\" |-> intVal(N)) (\\\"m\\\" |-> intVal(M)) </env>\\n+      <result> noResult\\n+        => result(binVal(((N +Int M) /Int 2) +Int 1)) </result>\\n+    </py>\\n+    requires N >Int 0 andBool M >Int 0\\n+     andBool N <=Int M\\n+     andBool (N +Int M) %Int 2 ==Int 1\\n+     andBool ((N +Int M) /Int 2) %Int 2 ==Int 1\\n+\\n+  // The prompt's examples are also executable proof obligations.\\n+  claim [example-1-5]:\\n+    <py>\\n+      <k> boot(roundedAvgProgram, 1, 5) => .K </k>\\n+      <env> .Map => (\\\"n\\\" |-> intVal(1)) (\\\"m\\\" |-> intVal(5)) </env>\\n+      <result> noResult => result(binVal(3)) </result>\\n+    </py>\\n+\\n+  claim [example-7-5]:\\n+    <py>\\n+      <k> boot(roundedAvgProgram, 7, 5) => .K </k>\\n+      <env> .Map => (\\\"n\\\" |-> intVal(7)) (\\\"m\\\" |-> intVal(5)) </env>\\n+      <result> noResult => result(intVal(-1)) </result>\\n+    </py>\\n+\\n+  claim [example-10-20]:\\n+    <py>\\n+      <k> boot(roundedAvgProgram, 10, 20) => .K </k>\\n+      <env> .Map => (\\\"n\\\" |-> intVal(10)) (\\\"m\\\" |-> intVal(20)) </env>\\n+      <result> noResult => result(binVal(15)) </result>\\n+    </py>\\n+\\n+  claim [example-20-33]:\\n+    <py>\\n+      <k> boot(roundedAvgProgram, 20, 33) => .K </k>\\n+      <env> .Map => (\\\"n\\\" |-> intVal(20)) (\\\"m\\\" |-> intVal(33)) </env>\\n+      <result> noResult => result(binVal(26)) </result>\\n+    </py>\\n+\\n+  claim [render-3]: renderBinary(binVal(3)) => \\\"0b11\\\"\\n+  claim [render-15]: renderBinary(binVal(15)) => \\\"0b1111\\\"\\n+  claim [render-26]: renderBinary(binVal(26)) => \\\"0b11010\\\"\\n+endmodule\\n*** End Patch\";\nconst a = await tools.apply_patch(patch);\nconst r = await tools.exec_command({cmd:\"kompile semantic.k --backend haskell --ma