+        completed.stdout,
+    )
+    if completed.returncode != 0:
+        return ("krun-failure", completed.returncode)
+    if match is None:
+        return ("unparsed", completed.stdout)
+    return ("return", match.group(1), int(match.group(2)))
+
+
+cases = [
+    (1, 5),
+    (7, 5),
+    (1, 1),
+    (1, 2),
+    (2, 3),
+    (3, 4),
+    (4, 5),
+    (2**53 - 1, 2**53 - 1),
+    (2**53, 2**53),
+    (2**53 + 1, 2**53 + 1),
+    (2**53 + 3, 2**53 + 3),
+    (10**309, 10**309),
+]
+
+mismatches = 0
+for n, m in cases:
+    py = python_outcome(n, m)
+    kval = k_outcome(n, m)
+    equal = py == kval
