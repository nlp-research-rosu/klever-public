  kprove spec.k --definition body-mutated-kompiled --spec-module SPEC --claims SPEC.example-1-5 --output pretty
  prove_rc="'$?
  echo "PROVE_EXIT_STATUS=$prove_rc"
  if test "$build_rc" -eq 0 && test "$prove_rc" -ne 0; then exit 0; else exit 1; fi
} 2>&1 | tee /audit-output/evidence/12-body-sensitivity.log' in /tmp/audit-work/body-mutation
