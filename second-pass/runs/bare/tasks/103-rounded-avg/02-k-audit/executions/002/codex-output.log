+        if path.is_symlink():
+            kind = "SYMLINK"
+        suffix = f" {sha256_file(path)}" if kind == "FILE" else ""
+        print(f"CANDIDATE_{kind} {path.relative_to(candidate)}{suffix}")
+        assert kind != "SYMLINK"
+
+    print("INTEGRITY_CHECK PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
