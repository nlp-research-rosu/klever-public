       rel=p.relative_to(root).as_posix()
       return {'rel':rel,'dotrel':'./'+rel,'abs':str(p),'basename':p.name}[prefix]
      for kindfmt in ('none','word','letter','slash'):
       def kindval(p):
        if kindfmt=='none': return b''
        if kindfmt=='word': return b'directory' if p.is_dir() else b'file'
        if kindfmt=='letter': return b'd' if p.is_dir() else b'f'
        return b'/' if p.is_dir() else b''
       for sep in (b'',b'\\0',b'\\n',b':',b' '):
