== verification.k ==
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // This constant is deliberately the exact constructor tree generated in
     7	  // solution.mpy.  Specs execute it through SEMANTIC rather than replacing
     8	  // the program with a mathematical shortcut.
     9	  syntax Module ::= "roundedAvgProgram" [function]
    10	  rule roundedAvgProgram =>
    11	    Module(
    12	      FuncDef("rounded_avg", Params("n", "m"),
    13	        If(Compare(Name("n"), CmpOp(">", Name("m"))),
    14	          Return(UnaryOp("-", Int(1))),
    15	          .Stmts)
    16	        Return(
    17	          Call(
    18	            Name("bin"),
    19	            Call(
    20	              Name("round"),
    21	              BinOp("/", BinOp("+", Name("n"), Name("m")), Int(2)))))))
    22	
    23	  // Concrete observer for the abstract binary-string value.  It is kept out
    24	  // of symbolic program execution so an unbounded integer proof does not try
    25	  // to unfold an unbounded number of output bits.
    26	  syntax String ::= "renderBinary" "(" PyVal ")" [function]
    27	                  | "unsignedBits" "(" Int ")" [function]
    28	  rule renderBinary(binVal(I)) => "0b" +String unsignedBits(I)
    29	    requires I >=Int 0
    30	  rule unsignedBits(0) => "0"
    31	  rule unsignedBits(1) => "1"
    32	  rule unsignedBits(I) => unsignedBits(I /Int 2) +String Int2String(I %Int 2)
    33	    requires I >=Int 2
    34	endmodule
