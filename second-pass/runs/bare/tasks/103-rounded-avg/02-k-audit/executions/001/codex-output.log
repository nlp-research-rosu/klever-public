     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd -- "$(dirname -- "$0")"
     5	
     6	# Regenerate the constructor program with the fixed translator.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# VERIFICATION imports SEMANTIC, so this compiles both the interpreter and the
    10	# concrete observer used by the specifications.
    11	kompile verification.k \
    12	  --backend haskell \
    13	  --main-module VERIFICATION \
    14	  --syntax-module MPY-SYNTAX
    15	
    16	# Exercise the translated artifact itself on every example from prompt.py.
    17	krun solution.mpy --definition verification-kompiled -cN=1 -cM=5 \
    18	  | grep -F 'result ( binVal ( 3 ) )'
    19	krun solution.mpy --definition verification-kompiled -cN=7 -cM=5 \
    20	  | grep -F 'result ( intVal ( -1 ) )'
    21	krun solution.mpy --definition verification-kompiled -cN=10 -cM=20 \
    22	  | grep -F 'result ( binVal ( 15 ) )'
    23	krun solution.mpy --definition verification-kompiled -cN=20 -cM=33 \
    24	  | grep -F 'result ( binVal ( 26 ) )'
    25	
    26	# Prove all universal partition claims, prompt examples, and rendering claims.
