kast /audit-output/evidence/artifacts/roundedAvgProgram-rhs.kterm --definition /tmp/audit-work/103-rounded-avg/verification-audit-kompiled --module VERIFICATION --sort Module --output kore > /audit-output/evidence/artifacts/roundedAvgProgram-rhs.kore 2>>\""'$LOG"
