+
+printf '\nToolchain:\n'
+run command -v kompile
+run command -v krun
+run command -v kprove
+run kompile --version
+run kprove --version
+
+printf '\nSTAGE1_SCRIPT_STATUS=%d\n' "$status"
+exit "$status"
