+else
+  printf 'Concrete comparison skipped because the fresh concrete build failed.\n'
+  overall=1
+fi
+
+claims=(
+  reversed
+  integral-midpoint
+  half-even-down
+  half-even-up
+  example-1-5
+  example-7-5
+  example-10-20
+  example-20-33
