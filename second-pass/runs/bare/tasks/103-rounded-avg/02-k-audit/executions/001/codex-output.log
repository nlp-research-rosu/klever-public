kast /tmp/audit-work/103-rounded-avg/candidate-src/solution.mpy --definition /tmp/audit-work/103-rounded-avg/verification-audit-kompiled --module VERIFICATION --sort Module --output kore > /audit-output/evidence/artifacts/submitted-solution.kore 2>>\""'$LOG"
