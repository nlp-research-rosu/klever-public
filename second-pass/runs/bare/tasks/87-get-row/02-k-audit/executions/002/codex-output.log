+printf '%s\n' \
+  'MUTATION: require returned [(0,0)] instead of returned [].'
+
+printf '%s\n' \
+  'COMMAND: kprove spec-vacuity.k --definition proof-kompiled --spec-module SPEC-VACUITY --dry-run'
