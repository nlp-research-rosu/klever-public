+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/87-get-row-review
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT: %d\n' "$status"
+  return "$status"
+}
+
+cd "$work" || exit 1
+printf 'COMMAND: python3 trusted_py2mpy.py solution.py > regenerated-solution.mpy\n'
