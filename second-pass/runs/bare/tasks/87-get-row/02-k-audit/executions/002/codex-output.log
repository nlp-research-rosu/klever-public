     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Recreate the translated program and check the ordinary Python examples.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	python3 - <<'PY'
     7	from solution import get_row
     8	
     9	assert get_row([
    10	    [1, 2, 3, 4, 5, 6],
    11	    [1, 2, 3, 4, 1, 6],
    12	    [1, 2, 3, 4, 5, 1],
    13	], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]
    14	assert get_row([], 1) == []
    15	assert get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]
    16	PY
    17	
    18	# Compile the executable semantics and exercise the translated solution.
    19	kompile semantic.k --main-module SEMANTIC --syntax-module MPY-SYNTAX --backend llvm
    20	krun solution.mpy \
    21	  --definition semantic-kompiled \
    22	  -cLST='pyList(vcons(pyList(vcons(pyInt(1),vcons(pyInt(2),vcons(pyInt(1),vnil)))),vcons(pyList(vcons(pyInt(1),vnil)),vnil)))' \
    23	  -cX='pyInt(1)' --output pretty
    24	krun solution.mpy --definition semantic-kompiled \
    25	  -cLST='pyList(vnil)' -cX='pyInt(1)' --output pretty
    26	
    27	# Compile the proof definition and prove every claim in spec.k.
    28	kompile verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --backend haskell
    29	translated_term="$(mktemp)"
    30	proved_term="$(mktemp)"
    31	kast solution.mpy --definition verification-kompiled \
    32	  --module MPY-SYNTAX --sort Program --output kore > "$translated_term"
    33	kast --expression solutionProgram --definition verification-kompiled \
    34	  --module VERIFICATION --sort Program --expand-macros --output kore > "$proved_term"
    35	cmp "$translated_term" "$proved_term"
    36	kprove spec.k --definition verification-kompiled --spec-module SPEC
