     3	module VERIFICATION
     4	  imports MPY-SEMANTIC
     5	
     6	  // These macros are the exact constructor tree emitted in solution.mpy.
     7	  syntax Program ::= "solutionProgram" [macro]
     8	  syntax Stmts ::= "getRowBody" [macro]
     9	
    10	  rule solutionProgram =>
    11	    Module(FuncDef("get_row", Params("lst", "x", .Strings), getRowBody))
    12	
    13	  rule getRowBody =>
    14	    Assign(Name("result"), ListExpr(.Exprs))
    15	    Assign(Name("row"), Int(0))
    16	    For(Name("values"), Name("lst"),
    17	      Assign(Name("col"),
    18	        BinOp("-", Call(Name("len"), Name("values"), .Exprs), Int(1)))
    19	      While(Compare(Name("col"), CmpOp(">=", Int(0)), .CmpOps),
    20	        If(Compare(Subscript(Name("values"), Name("col")),
    21	                   CmpOp("==", Name("x")), .CmpOps),
    22	          Assign(Name("result"),
    23	            BinOp("+", Name("result"),
    24	              ListExpr(TupleExpr(Name("row"), Name("col"), .Exprs), .Exprs))),
    25	          .Stmts)
    26	        Assign(Name("col"), BinOp("-", Name("col"), Int(1))))
    27	      Assign(Name("row"), BinOp("+", Name("row"), Int(1))))
    28	    Return(Name("result"))
    29	
    30	  // A mathematical input domain: finite matrices whose elements are integers.
    31	  syntax IntList ::= "inil" | "icons" "(" Int "," IntList ")"
    32	  syntax Matrix ::= "mnil" | "mcons" "(" IntList "," Matrix ")"
    33	
    34	  syntax VList ::= "encodeInts" "(" IntList ")" [function]
    35	  rule encodeInts(inil) => vnil
    36	  rule encodeInts(icons(I, IS)) => vcons(pyInt(I), encodeInts(IS))
    37	
    38	  syntax VList ::= "encodeMatrix" "(" Matrix ")" [function]
    39	  rule encodeMatrix(mnil) => vnil
    40	  rule encodeMatrix(mcons(IS, MS)) =>
    41	    vcons(pyList(encodeInts(IS)), encodeMatrix(MS))
    42	
    43	  // Independent extensional contract. rowCoords returns matching columns in
    44	  // descending order; matrixCoords concatenates rows in ascending order.
    45	  syntax VList ::= "rowCoords" "(" IntList "," Int "," Int "," Int ")" [function, total]
    46	  rule rowCoords(inil, _, _, _) => vnil
    47	  rule rowCoords(icons(I, IS), X, R, C) =>
    48	    coordStep(I ==Int X, IS, X, R, C)
    49	
    50	  syntax VList ::= "coordStep" "(" Bool "," IntList "," Int "," Int "," Int ")" [function, total]
    51	  rule coordStep(true, IS, X, R, C) =>
    52	    vconcat(rowCoords(IS, X, R, C +Int 1),
    53	            vcons(pyTuple(vcons(pyInt(R), vcons(pyInt(C), vnil))), vnil))
    54	  rule coordStep(false, IS, X, R, C) => rowCoords(IS, X, R, C +Int 1)
    55	
    56	  syntax VList ::= "matrixCoords" "(" Matrix "," Int "," Int ")" [function]
    57	  rule matrixCoords(mnil, _, _) => vnil
    58	  rule matrixCoords(mcons(IS, MS), X, R) =>
    59	    vconcat(rowCoords(IS, X, R, 0), matrixCoords(MS, X, R +Int 1))
    60	
    61	  syntax Matrix ::= "promptMatrix" [macro]
    62	  syntax Matrix ::= "thirdMatrix" [macro]
    63	  syntax Value ::= "promptInput" [macro]
    64	  syntax Value ::= "thirdInput" [macro]
    65	
    66	  rule promptMatrix =>
    67	    mcons(icons(1, icons(2, icons(3, icons(4, icons(5, icons(6, inil)))))),
    68	    mcons(icons(1, icons(2, icons(3, icons(4, icons(1, icons(6, inil)))))),
    69	    mcons(icons(1, icons(2, icons(3, icons(4, icons(5, icons(1, inil)))))),
    70	    mnil)))
    71	
    72	  rule promptInput => pyList(encodeMatrix(promptMatrix))
    73	
    74	  rule thirdMatrix =>
    75	    mcons(inil, mcons(icons(1, inil),
    76	      mcons(icons(1, icons(2, icons(3, inil))), mnil)))
    77	
    78	  rule thirdInput => pyList(encodeMatrix(thirdMatrix))
    79	
    80	  // Expected coordinates for the symbolic matrix [[A, B], [C]].  The flags
    81	  // are ordered by source elements, while coordinates are emitted B, A, C.
    82	  syntax VList ::= "addCoord" "(" Bool "," Value "," VList ")" [function, total]
    83	  rule addCoord(true, V, VS) => vcons(V, VS)
    84	  rule addCoord(false, _, VS) => VS
    85	
    86	  syntax VList ::= "expectedFlags" "(" Bool "," Bool "," Bool ")" [function, total]
    87	  rule expectedFlags(AH, BH, CH) =>
    88	    addCoord(BH, pyTuple(vcons(pyInt(0), vcons(pyInt(1), vnil))),
    89	      addCoord(AH, pyTuple(vcons(pyInt(0), vcons(pyInt(0), vnil))),
    90	        addCoord(CH, pyTuple(vcons(pyInt(1), vcons(pyInt(0), vnil))), vnil)))
    91	endmodule
