+test ! -e /reference/reference-semantics && test ! -L /reference/reference-semantics
+rc=$?
+printf 'exit=%d\n' "$rc"
+(( rc == 0 )) || status=1
+
+printf '%s\n' '$ stat required trusted and candidate artifacts'
