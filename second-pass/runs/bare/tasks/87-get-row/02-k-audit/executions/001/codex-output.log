+
+printf '%s\n' '$ structured generation trace hashes and record-type counts'
+find /candidate/codex-trace -type f -print0 | sort -z | xargs -0 sha256sum
+rc=$?
+printf 'trace_hash_exit=%d\n' "$rc"
+(( rc == 0 )) || status=1
+python3 - <<'PY'
+import json
