+        "pretty",
+    ]
+    print(f"CASE {name}")
+    print("$", shlex.join(command))
+    completed = subprocess.run(command, text=True, capture_output=True)
+    normalized = compact(completed.stdout)
+    match = re.search(r"<result>.*?</result>", normalized)
