+
+printf '%s\n' '$ stat required trusted and candidate artifacts'
+for path in \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/run-input.json \
+  /candidate/metrics.json \
