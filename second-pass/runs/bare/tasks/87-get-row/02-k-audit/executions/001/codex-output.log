--- candidate solution.py ---
     1	def get_row(lst, x):
     2	    result = []
     3	    row = 0
     4	    for values in lst:
     5	        col = len(values) - 1
     6	        while col >= 0:
     7	            if values[col] == x:
     8	                result = result + [(row, col)]
     9	            col = col - 1
    10	        row = row + 1
    11	    return result
