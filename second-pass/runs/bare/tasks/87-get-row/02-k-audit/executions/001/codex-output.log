+  rc=$?
+  printf 'exit=%d path=%s\n' "$rc" "$path"
+  if (( rc != 0 )); then status=1; fi
+done
+
+printf '%s\n' '$ find candidate source/provenance scope for symlinks'
+find /candidate -maxdepth 1 -type l -printf '%p -> %l\n'
+rc=$?
+printf 'exit=%d\n' "$rc"
