+                | "Bool" "(" Bool ")"
+                | "ListExpr" "(" Exprs ")"
+                | "TupleExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
