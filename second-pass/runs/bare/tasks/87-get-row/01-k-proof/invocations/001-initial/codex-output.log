+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Exprs  ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "ListExpr" "(" Exprs ")"
+                | "TupleExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
