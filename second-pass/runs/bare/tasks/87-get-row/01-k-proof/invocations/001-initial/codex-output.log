diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e7e1d01a5fb76c3439228ccb1a128a0723ce21d4
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,41 @@
+module SPEC
+  imports VERIFICATION
+
+  claim
+      <k> solutionProgram ~> start => .K </k>
+      <args> pyArgs(promptInput, pyInt(1)) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => returned(promptExpected) </result>
+
+  claim
+      <k> solutionProgram ~> start => .K </k>
+      <args> pyArgs(pyList(vnil), pyInt(1)) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => returned(pyList(vnil)) </result>
+
+  claim
