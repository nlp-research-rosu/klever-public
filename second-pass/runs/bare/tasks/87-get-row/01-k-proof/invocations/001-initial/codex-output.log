+  rule <k> pyList(VS) ~> forReady(N, BODY) => forLoop(N, VS, BODY) ... </k>
+  rule <k> forLoop(_, vnil, _) => .K ... </k>
+  rule <k> forLoop(N, vcons(V, VS), BODY) => exec(BODY) ~> forLoop(N, VS, BODY) ... </k>
+       <env> ENV => ENV [ N <- V ] </env>
+
+  rule <k> execStmt(While(COND, BODY)) => whileLoop(COND, BODY) ... </k>
+  rule <k> whileLoop(COND, BODY) => eval(COND) ~> whileGuard(COND, BODY) ... </k>
+  rule <k> pyBool(true) ~> whileGuard(COND, BODY) => exec(BODY) ~> whileLoop(COND, BODY) ... </k>
+  rule <k> pyBool(false) ~> whileGuard(_, _) => .K ... </k>
+
+  rule <k> execStmt(If(COND, THEN, ELSE)) => eval(COND) ~> ifGuard(THEN, ELSE) ... </k>
+  rule <k> pyBool(true) ~> ifGuard(THEN, _) => exec(THEN) ... </k>
+  rule <k> pyBool(false) ~> ifGuard(_, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> execStmt(Return(E)) => eval(E) ~> doReturn ... </k>
+  rule <k> V:Value ~> doReturn ~> _REST:K => .K </k>
+       <result> noResult => returned(V) </result>
+       <env> _ => .Map </env>
+       <functions> _ => .Map </functions>
+
+  rule <k> eval(Int(I)) => pyInt(I) ... </k>
+  rule <k> eval(Bool(B)) => pyBool(B) ... </k>
+  rule <k> eval(Name(N)) => V ... </k>
+       <env> ... N |-> V:Value ... </env>
+
+  rule <k> eval(ListExpr(ES)) => evalExprs(ES) ... </k>
+  rule <k> eval(TupleExpr(ES)) => evalExprs(ES) ~> asTuple ... </k>
+  rule <k> pyList(VS) ~> asTuple => pyTuple(VS) ... </k>
+
+  rule <k> evalExprs(.Exprs) => pyList(vnil) ... </k>
+  rule <k> evalExprs(E:Expr, ES:Exprs) => eval(E) ~> evalExprsTail(ES) ... </k>
+  rule <k> V:Value ~> evalExprsTail(ES) => evalExprs(ES) ~> prependValue(V) ... </k>
+  rule <k> pyList(VS) ~> prependValue(V) => pyList(vcons(V, VS)) ... </k>
+
+  rule <k> eval(BinOp(OP, L, R)) => eval(L) ~> binLeft(OP, R) ... </k>
+  rule <k> LV:Value ~> binLeft(OP, R) => eval(R) ~> binRight(OP, LV) ... </k>
+  rule <k> pyInt(R) ~> binRight("-", pyInt(L)) => pyInt(L -Int R) ... </k>
+  rule <k> pyInt(R) ~> binRight("+", pyInt(L)) => pyInt(L +Int R) ... </k>
+  rule <k> pyList(R) ~> binRight("+", pyList(L)) => pyList(vconcat(L, R)) ... </k>
+
+  rule <k> eval(Compare(L, CmpOp(OP, R))) => eval(L) ~> cmpLeft(OP, R) ... </k>
+  rule <k> LV:Value ~> cmpLeft(OP, R) => eval(R) ~> cmpRight(OP, LV) ... </k>
+  rule <k> pyInt(R) ~> cmpRight(">=", pyInt(L)) => pyBool(L >=Int R) ... </k>
+  rule <k> pyInt(R) ~> cmpRight("==", pyInt(L)) => pyBool(L ==Int R) ... </k>
+
+  rule <k> eval(Subscript(BASE, INDEX)) => eval(BASE) ~> subscriptBase(INDEX) ... </k>
+  rule <k> BV:Value ~> subscriptBase(INDEX) => eval(INDEX) ~> subscriptIndex(BV) ... </k>
+  rule <k> pyInt(I) ~> subscriptIndex(pyList(VS)) => vnth(VS, I) ... </k>
+
+  rule <k> eval(Call(Name("len"), E)) => eval(E) ~> doLen ... </k>
+  rule <k> pyList(VS) ~> doLen => pyInt(vlen(VS)) ... </k>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTIC
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..c46cfd69c5c8d6ca16ab9b775f972fee488c5ed2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def get_row(lst, x):
+    result = []
+    row = 0
+    for values in lst:
+        col = len(values) - 1
+        while col >= 0:
+            if values[col] == x:
+                result = result + [(row, col)]
+            col = col - 1
+        row = row + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f055130b11c858f0960a9e79c1db8604c6e4372c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,54 @@
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <py>
+      <k> solutionProgram ~> start </k>
+      <args> pyArgs(promptInput, pyInt(1)) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </py>
+  =>
+    <py>
+      <k> .K </k>
+      <args> pyArgs(promptInput, pyInt(1)) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> returned(promptExpected) </result>
+    </py>
+
+  claim
+    <py>
+      <k> solutionProgram ~> start </k>
+      <args> pyArgs(pyList(vnil), pyInt(1)) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </py>
+  =>
+    <py>
+      <k> .K </k>
+      <args> pyArgs(pyList(vnil), pyInt(1)) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> returned(pyList(vnil)) </result>
+    </py>
+
+  claim
+    <py>
+      <k> solutionProgram ~> start </k>
+      <args> pyArgs(thirdInput, pyInt(3)) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </py>
+  =>
+    <py>
+      <k> .K </k>
+      <args> pyArgs(thirdInput, pyInt(3)) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> returned(thirdExpected) </result>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..442c35593a0a15644cef14d016aa1a45a6bb76b4
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,81 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // These macros are the exact constructor tree emitted in solution.mpy.
+  syntax Program ::= "solutionProgram"
+  syntax Stmts ::= "getRowBody"
+
+  rule solutionProgram =>
+    Module(FuncDef("get_row", Params("lst", "x", .Strings), getRowBody))
+
+  rule getRowBody =>
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("row"), Int(0))
+    For(Name("values"), Name("lst"),
+      Assign(Name("col"),
+        BinOp("-", Call(Name("len"), Name("values"), .Exprs), Int(1)))
+      While(Compare(Name("col"), CmpOp(">=", Int(0)), .CmpOps),
+        If(Compare(Subscript(Name("values"), Name("col")),
+                   CmpOp("==", Name("x")), .CmpOps),
+          Assign(Name("result"),
+            BinOp("+", Name("result"),
+              ListExpr(TupleExpr(Name("row"), Name("col"), .Exprs), .Exprs))),
+          .Stmts)
+        Assign(Name("col"), BinOp("-", Name("col"), Int(1))))
+      Assign(Name("row"), BinOp("+", Name("row"), Int(1))))
+    Return(Name("result"))
+
+  // A mathematical input domain: finite matrices whose elements are integers.
+  syntax IntList ::= "inil" | "icons" "(" Int "," IntList ")"
+  syntax Matrix ::= "mnil" | "mcons" "(" IntList "," Matrix ")"
+
+  syntax VList ::= "encodeInts" "(" IntList ")" [function]
+  rule encodeInts(inil) => vnil
+  rule encodeInts(icons(I, IS)) => vcons(pyInt(I), encodeInts(IS))
+
+  syntax VList ::= "encodeMatrix" "(" Matrix ")" [function]
+  rule encodeMatrix(mnil) => vnil
+  rule encodeMatrix(mcons(IS, MS)) =>
+    vcons(pyList(encodeInts(IS)), encodeMatrix(MS))
+
+  // Independent extensional contract. rowCoords returns matching columns in
+  // descending order; matrixCoords concatenates rows in ascending order.
+  syntax VList ::= "rowCoords" "(" IntList "," Int "," Int "," Int ")" [function]
+  rule rowCoords(inil, _, _, _) => vnil
+  rule rowCoords(icons(I, IS), X, R, C) =>
+    vconcat(rowCoords(IS, X, R, C +Int 1),
+            vcons(pyTuple(vcons(pyInt(R), vcons(pyInt(C), vnil))), vnil))
+    requires I ==Int X
+  rule rowCoords(icons(I, IS), X, R, C) => rowCoords(IS, X, R, C +Int 1)
+    requires I =/=Int X
+
+  syntax VList ::= "matrixCoords" "(" Matrix "," Int "," Int ")" [function]
+  rule matrixCoords(mnil, _, _) => vnil
+  rule matrixCoords(mcons(IS, MS), X, R) =>
+    vconcat(rowCoords(IS, X, R, 0), matrixCoords(MS, X, R +Int 1))
+
+  syntax Value ::= "promptInput" | "promptExpected"
+                 | "thirdInput" | "thirdExpected"
+
+  rule promptInput => pyList(encodeMatrix(
+    mcons(icons(1, icons(2, icons(3, icons(4, icons(5, icons(6, inil)))))),
+    mcons(icons(1, icons(2, icons(3, icons(4, icons(1, icons(6, inil)))))),
+    mcons(icons(1, icons(2, icons(3, icons(4, icons(5, icons(1, inil)))))),
+    mnil)))))
+
+  rule promptExpected => pyList(
+    vcons(pyTuple(vcons(pyInt(0), vcons(pyInt(0), vnil))),
+    vcons(pyTuple(vcons(pyInt(1), vcons(pyInt(4), vnil))),
+    vcons(pyTuple(vcons(pyInt(1), vcons(pyInt(0), vnil))),
+    vcons(pyTuple(vcons(pyInt(2), vcons(pyInt(5), vnil))),
+    vcons(pyTuple(vcons(pyInt(2), vcons(pyInt(0), vnil))), vnil))))))
+
+  rule thirdInput => pyList(encodeMatrix(
+    mcons(inil, mcons(icons(1, inil),
+      mcons(icons(1, icons(2, icons(3, inil))), mnil)))))
+
+  rule thirdExpected => pyList(
+    vcons(pyTuple(vcons(pyInt(2), vcons(pyInt(2), vnil))), vnil))
+endmodule

