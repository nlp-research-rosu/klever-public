+                 | "prependValue" "(" Value ")"
+                 | "asTuple"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Value ")"
+                 | "cmpLeft" "(" String "," Expr ")"
+                 | "cmpRight" "(" String "," Value ")"
+                 | "subscriptBase" "(" Expr ")"
