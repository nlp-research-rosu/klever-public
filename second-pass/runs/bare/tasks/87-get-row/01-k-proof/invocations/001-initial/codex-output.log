diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ab4fb4a4978fef65700929a4a12314bd3df17625
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,97 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // These macros are the exact constructor tree emitted in solution.mpy.
+  syntax Program ::= "solutionProgram" [macro]
+  syntax Stmts ::= "getRowBody" [macro]
+
+  rule solutionProgram =>
+    Module(FuncDef("get_row", Params("lst", "x", .Strings), getRowBody))
+
+  rule getRowBody =>
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("row"), Int(0))
+    For(Name("values"), Name("lst"),
+      Assign(Name("col"),
+        BinOp("-", Call(Name("len"), Name("values"), .Exprs), Int(1)))
+      While(Compare(Name("col"), CmpOp(">=", Int(0)), .CmpOps),
+        If(Compare(Subscript(Name("values"), Name("col")),
+                   CmpOp("==", Name("x")), .CmpOps),
+          Assign(Name("result"),
+            BinOp("+", Name("result"),
+              ListExpr(TupleExpr(Name("row"), Name("col"), .Exprs), .Exprs))),
+          .Stmts)
+        Assign(Name("col"), BinOp("-", Name("col"), Int(1))))
+      Assign(Name("row"), BinOp("+", Name("row"), Int(1))))
+    Return(Name("result"))
+
+  // A mathematical input domain: finite matrices whose elements are integers.
+  syntax IntList ::= "inil" | "icons" "(" Int "," IntList ")"
+  syntax Matrix ::= "mnil" | "mcons" "(" IntList "," Matrix ")"
+
+  syntax VList ::= "encodeInts" "(" IntList ")" [function]
+  rule encodeInts(inil) => vnil
+  rule encodeInts(icons(I, IS)) => vcons(pyInt(I), encodeInts(IS))
+
+  syntax VList ::= "encodeMatrix" "(" Matrix ")" [function]
+  rule encodeMatrix(mnil) => vnil
+  rule encodeMatrix(mcons(IS, MS)) =>
+    vcons(pyList(encodeInts(IS)), encodeMatrix(MS))
+
+  // Independent extensional contract. rowCoords returns matching columns in
+  // descending order; matrixCoords concatenates rows in ascending order.
+  syntax VList ::= "rowCoords" "(" IntList "," Int "," Int "," Int ")" [function, total]
+  rule rowCoords(inil, _, _, _) => vnil
+  rule rowCoords(icons(I, IS), X, R, C) =>
+    coordStep(I ==Int X, IS, X, R, C)
+
+  syntax VList ::= "coordStep" "(" Bool "," IntList "," Int "," Int "," Int ")" [function, total]
+  rule coordStep(true, IS, X, R, C) =>
+    vconcat(rowCoords(IS, X, R, C +Int 1),
+            vcons(pyTuple(vcons(pyInt(R), vcons(pyInt(C), vnil))), vnil))
+  rule coordStep(false, IS, X, R, C) => rowCoords(IS, X, R, C +Int 1)
+
+  syntax VList ::= "matrixCoords" "(" Matrix "," Int "," Int ")" [function]
+  rule matrixCoords(mnil, _, _) => vnil
+  rule matrixCoords(mcons(IS, MS), X, R) =>
+    vconcat(rowCoords(IS, X, R, 0), matrixCoords(MS, X, R +Int 1))
+
+  syntax Value ::= "promptInput" [macro]
+  syntax Value ::= "promptExpected" [macro]
+  syntax Value ::= "thirdInput" [macro]
+  syntax Value ::= "thirdExpected" [macro]
+
+  rule promptInput => pyList(encodeMatrix(
+    mcons(icons(1, icons(2, icons(3, icons(4, icons(5, icons(6, inil)))))),
+    mcons(icons(1, icons(2, icons(3, icons(4, icons(1, icons(6, inil)))))),
+    mcons(icons(1, icons(2, icons(3, icons(4, icons(5, icons(1, inil)))))),
+    mnil)))))
+
+  rule promptExpected => pyList(
+    vcons(pyTuple(vcons(pyInt(0), vcons(pyInt(0), vnil))),
+    vcons(pyTuple(vcons(pyInt(1), vcons(pyInt(4), vnil))),
+    vcons(pyTuple(vcons(pyInt(1), vcons(pyInt(0), vnil))),
+    vcons(pyTuple(vcons(pyInt(2), vcons(pyInt(5), vnil))),
+    vcons(pyTuple(vcons(pyInt(2), vcons(pyInt(0), vnil))), vnil))))))
+
+  rule thirdInput => pyList(encodeMatrix(
+    mcons(inil, mcons(icons(1, inil),
+      mcons(icons(1, icons(2, icons(3, inil))), mnil)))))
+
+  rule thirdExpected => pyList(
+    vcons(pyTuple(vcons(pyInt(2), vcons(pyInt(2), vnil))), vnil))
+
+  // Expected coordinates for the symbolic matrix [[A, B], [C]].  The flags
+  // are ordered by source elements, while coordinates are emitted B, A, C.
+  syntax VList ::= "addCoord" "(" Bool "," Value "," VList ")" [function, total]
+  rule addCoord(true, V, VS) => vcons(V, VS)
+  rule addCoord(false, _, VS) => VS
+
+  syntax VList ::= "expectedFlags" "(" Bool "," Bool "," Bool ")" [function, total]
+  rule expectedFlags(AH, BH, CH) =>
+    addCoord(BH, pyTuple(vcons(pyInt(0), vcons(pyInt(1), vnil))),
+      addCoord(AH, pyTuple(vcons(pyInt(0), vcons(pyInt(0), vnil))),
+        addCoord(CH, pyTuple(vcons(pyInt(1), vcons(pyInt(0), vnil))), vnil)))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3481fc08e55e2539b7a85c1b035f6b434be50558
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the translated program and check the ordinary Python examples.
+python3 py2mpy.py solution.py > solution.mpy
+python3 - <<'PY'
+from solution import get_row
+
+assert get_row([
+    [1, 2, 3, 4, 5, 6],
+    [1, 2, 3, 4, 1, 6],
+    [1, 2, 3, 4, 5, 1],
+], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]
+assert get_row([], 1) == []
+assert get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]
+PY
+
+# Compile the executable semantics and exercise the translated solution.
+kompile semantic.k --main-module SEMANTIC --syntax-module MPY-SYNTAX --backend llvm
+krun solution.mpy \
+  -cLST='pyList(vcons(pyList(vcons(pyInt(1),vcons(pyInt(2),vcons(pyInt(1),vnil)))),vcons(pyList(vcons(pyInt(1),vnil)),vnil)))' \
+  -cX='pyInt(1)' --output pretty
+krun solution.mpy -cLST='pyList(vnil)' -cX='pyInt(1)' --output pretty
+
+# Compile the proof definition and prove every claim in spec.k.
+kompile verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --backend haskell
+kprove spec.k --definition verification-kompiled --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..902f3fefa4f3d716ddbfc84b521cc306c3c393ce
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,165 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Exprs  ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "ListExpr" "(" Exprs ")"
+                | "TupleExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax VList ::= "vnil" | "vcons" "(" Value "," VList ")"
+  syntax Value ::= "pyInt" "(" Int ")"
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" VList ")"
+                 | "pyTuple" "(" VList ")"
+
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+  syntax Result ::= "noResult" | "returned" "(" Value ")"
+  syntax Args ::= "pyArgs" "(" Value "," Value ")"
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start </k>
+      <args> pyArgs($LST:Value, $X:Value) </args>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </py>
+
+  syntax KItem ::= "start"
+                 | "exec" "(" Stmts ")"
+                 | "execStmt" "(" Stmt ")"
+                 | "eval" "(" Expr ")"
+                 | "assignTo" "(" String ")"
+                 | "forReady" "(" String "," Stmts ")"
+                 | "forLoop" "(" String "," VList "," Stmts ")"
+                 | "whileLoop" "(" Expr "," Stmts ")"
+                 | "whileGuard" "(" Expr "," Stmts ")"
+                 | "ifGuard" "(" Stmts "," Stmts ")"
+                 | "evalExprs" "(" Exprs ")"
+                 | "evalExprsTail" "(" Exprs ")"
+                 | "prependValue" "(" Value ")"
+                 | "asTuple"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Value ")"
+                 | "cmpLeft" "(" String "," Expr ")"
+                 | "cmpRight" "(" String "," Value ")"
+                 | "subscriptBase" "(" Expr ")"
+                 | "subscriptIndex" "(" Value ")"
+                 | "doLen"
+                 | "doReturn"
+
+  syntax Int ::= "vlen" "(" VList ")" [function]
+  rule vlen(vnil) => 0
+  rule vlen(vcons(_, VS)) => 1 +Int vlen(VS)
+
+  syntax VList ::= "vconcat" "(" VList "," VList ")" [function]
+  rule vconcat(vnil, VS) => VS
+  rule vconcat(vcons(V, VS), WS) => vcons(V, vconcat(VS, WS))
+
+  syntax Value ::= "vnth" "(" VList "," Int ")" [function]
+  rule vnth(vcons(V, _), 0) => V
+  rule vnth(vcons(_, VS), I) => vnth(VS, I -Int 1) requires I >Int 0
+
+  rule <k> Module(SS) => exec(SS) ... </k>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S:Stmt SS:Stmts) => execStmt(S) ~> exec(SS) ... </k>
+
+  rule <k> execStmt(FuncDef(F, P, SS)) => .K ... </k>
+       <functions> FS => FS [ F <- function(P, SS) ] </functions>
+
+  rule <k> start => exec(SS) ... </k>
+       <args> pyArgs(LST, X) </args>
+       <functions> ... "get_row" |-> function(Params("lst", "x"), SS) ... </functions>
+       <env> _ => "lst" |-> LST  "x" |-> X </env>
+
+  rule <k> execStmt(Assign(Name(N), E)) => eval(E) ~> assignTo(N) ... </k>
+  rule <k> V:Value ~> assignTo(N) => .K ... </k>
+       <env> ENV => ENV [ N <- V ] </env>
+
+  rule <k> execStmt(For(Name(N), E, BODY)) => eval(E) ~> forReady(N, BODY) ... </k>
+  rule <k> pyList(VS) ~> forReady(N, BODY) => forLoop(N, VS, BODY) ... </k>
+  rule <k> forLoop(_, vnil, _) => .K ... </k>
+  rule <k> forLoop(N, vcons(V, VS), BODY) => exec(BODY) ~> forLoop(N, VS, BODY) ... </k>
+       <env> ENV => ENV [ N <- V ] </env>
+
+  rule <k> execStmt(While(COND, BODY)) => whileLoop(COND, BODY) ... </k>
+  rule <k> whileLoop(COND, BODY) => eval(COND) ~> whileGuard(COND, BODY) ... </k>
+  rule <k> pyBool(true) ~> whileGuard(COND, BODY) => exec(BODY) ~> whileLoop(COND, BODY) ... </k>
+  rule <k> pyBool(false) ~> whileGuard(_, _) => .K ... </k>
+
+  rule <k> execStmt(If(COND, THEN, ELSE)) => eval(COND) ~> ifGuard(THEN, ELSE) ... </k>
+  rule <k> pyBool(true) ~> ifGuard(THEN, _) => exec(THEN) ... </k>
+  rule <k> pyBool(false) ~> ifGuard(_, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> execStmt(Return(E)) => eval(E) ~> doReturn ... </k>
+  rule <k> V:Value ~> doReturn ~> _REST:K => .K </k>
+       <result> noResult => returned(V) </result>
+       <env> _ => .Map </env>
+       <functions> _ => .Map </functions>
+
+  rule <k> eval(Int(I)) => pyInt(I) ... </k>
+  rule <k> eval(Bool(B)) => pyBool(B) ... </k>
+  rule <k> eval(Name(N)) => V ... </k>
+       <env> ... N |-> V:Value ... </env>
+
+  rule <k> eval(ListExpr(ES)) => evalExprs(ES) ... </k>
+  rule <k> eval(TupleExpr(ES)) => evalExprs(ES) ~> asTuple ... </k>
+  rule <k> pyList(VS) ~> asTuple => pyTuple(VS) ... </k>
+
+  rule <k> evalExprs(.Exprs) => pyList(vnil) ... </k>
+  rule <k> evalExprs(E:Expr, ES:Exprs) => eval(E) ~> evalExprsTail(ES) ... </k>
+  rule <k> V:Value ~> evalExprsTail(ES) => evalExprs(ES) ~> prependValue(V) ... </k>
+  rule <k> pyList(VS) ~> prependValue(V) => pyList(vcons(V, VS)) ... </k>
+
+  rule <k> eval(BinOp(OP, L, R)) => eval(L) ~> binLeft(OP, R) ... </k>
+  rule <k> LV:Value ~> binLeft(OP, R) => eval(R) ~> binRight(OP, LV) ... </k>
+  rule <k> pyInt(R) ~> binRight("-", pyInt(L)) => pyInt(L -Int R) ... </k>
+  rule <k> pyInt(R) ~> binRight("+", pyInt(L)) => pyInt(L +Int R) ... </k>
+  rule <k> pyList(R) ~> binRight("+", pyList(L)) => pyList(vconcat(L, R)) ... </k>
+
+  rule <k> eval(Compare(L, CmpOp(OP, R))) => eval(L) ~> cmpLeft(OP, R) ... </k>
+  rule <k> LV:Value ~> cmpLeft(OP, R) => eval(R) ~> cmpRight(OP, LV) ... </k>
+  rule <k> pyInt(R) ~> cmpRight(">=", pyInt(L)) => pyBool(L >=Int R) ... </k>
+  rule <k> pyInt(R) ~> cmpRight("==", pyInt(L)) => pyBool(L ==Int R) ... </k>
+
+  rule <k> eval(Subscript(BASE, INDEX)) => eval(BASE) ~> subscriptBase(INDEX) ... </k>
+  rule <k> BV:Value ~> subscriptBase(INDEX) => eval(INDEX) ~> subscriptIndex(BV) ... </k>
+  rule <k> pyInt(I) ~> subscriptIndex(pyList(VS)) => vnth(VS, I) ... </k>
+
+  rule <k> eval(Call(Name("len"), E)) => eval(E) ~> doLen ... </k>
+  rule <k> pyList(VS) ~> doLen => pyInt(vlen(VS)) ... </k>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTIC
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..c46cfd69c5c8d6ca16ab9b775f972fee488c5ed2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def get_row(lst, x):
+    result = []
+    row = 0
+    for values in lst:
+        col = len(values) - 1
+        while col >= 0:
+            if values[col] == x:
+                result = result + [(row, col)]
+            col = col - 1
+        row = row + 1
+    return result
