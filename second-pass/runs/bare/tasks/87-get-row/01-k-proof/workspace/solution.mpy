Module(
  FuncDef("get_row", Params("lst", "x"),
    Assign(Name("result"), ListExpr())
    Assign(Name("row"), Int(0))
    For(Name("values"), Name("lst"),
      Assign(
        Name("col"),
        BinOp("-", Call(Name("len"), Name("values")), Int(1)))
      While(Compare(Name("col"), CmpOp(">=", Int(0))),
        If(Compare(
          Subscript(Name("values"), Name("col")),
          CmpOp("==", Name("x"))),
          Assign(
            Name("result"),
            BinOp(
              "+",
              Name("result"),
              ListExpr(TupleExpr(Name("row"), Name("col"))))),
          )
        Assign(Name("col"), BinOp("-", Name("col"), Int(1))))
      Assign(Name("row"), BinOp("+", Name("row"), Int(1))))
    Return(Name("result"))))
