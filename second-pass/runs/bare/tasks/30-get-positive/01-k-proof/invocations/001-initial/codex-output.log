diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b9fb023e618e6f9362c17d1b6e7caa24f3732604
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional-correctness summary: execution of the translated
+  // program returns the stable strict-positive projection for every input.
+  claim <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => filterGt(INPUT, 0) </k>
+          <input> INPUT:PyList </input>
+        </py>
+
+  // Symbolic boundary obligations: arbitrary positive heads are retained and
+  // arbitrary zero/negative heads are discarded, with the tail left general.
+  claim filterGt(cons(I, REST), 0)
+     => cons(I, filterGt(REST, 0))
+    requires I >Int 0
+
+  claim filterGt(cons(I, REST), 0)
+     => filterGt(REST, 0)
+    requires I <=Int 0
+
+  // The two examples from prompt.py, plus empty and all-nonpositive edges.
+  claim <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => cons(2, cons(5, cons(6, nil))) </k>
+          <input> cons(-1, cons(2, cons(-4, cons(5, cons(6, nil))))) </input>
+        </py>
+
+  claim <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => cons(5, cons(3, cons(2, cons(3, cons(9, cons(123, cons(1, nil))))))) </k>
+          <input> cons(5, cons(3, cons(-5, cons(2, cons(-3, cons(3, cons(9, cons(0, cons(123, cons(1, cons(-10, nil))))))))))) </input>
+        </py>
+
+  claim filterGt(nil, 0) => nil
+  claim filterGt(cons(0, cons(-1, cons(-2, nil))), 0) => nil
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c996b8ef47efeff07d8e476b30b9b0e159c4ffbf
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // An independently named contract relation.  Keeping it symbolic lets a
+  // correctness claim quantify over lists of arbitrary finite length.
+  syntax Bool ::= "isPositiveProjection" "(" PyList "," PyList ")" [function, symbol(isPositiveProjection)]
+  rule isPositiveProjection(INPUT, filterGt(INPUT, 0)) => true
+  rule isPositiveProjection(INPUT, OUTPUT) => false [owise]
+endmodule

