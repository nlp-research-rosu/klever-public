@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/30-get-positive
+proof_file="$scratch/spec-audit-labeled.k"
+definition="$scratch/proof-kompiled"
+
+targets=(
+  "AUDIT-VERIFICATION helper-positive-head"
+  "AUDIT-VERIFICATION helper-nonpositive-head"
+  "AUDIT-VERIFICATION helper-empty"
+  "AUDIT-SPEC spec-universal"
+  "AUDIT-SPEC spec-example-1"
+  "AUDIT-SPEC spec-example-2"
+  "AUDIT-SPEC spec-empty"
+  "AUDIT-SPEC spec-all-nonpositive"
+)
+
+failures=0
+for target in "${targets[@]}"; do
+  read -r module label <<< "$target"
+  command=(
+    /usr/bin/kprove
+    "$proof_file"
+    --definition "$definition"
+    --spec-module "$module"
+    --claims "$module.label($label)"
+  )
+  printf 'COMMAND:'
+  printf ' %q' "${command[@]}"
+  printf '\n'
+  "${command[@]}"
+  status=$?
+  printf 'CLAIM_RESULT module=%s label=%s exit=%d\n' "$module" "$label" "$status"
+  if [[ "$status" -ne 0 ]]; then
+    failures=$((failures + 1))
+  fi
+done
+
+printf 'SUMMARY targets=%d failures=%d\n' "${#targets[@]}" "$failures"
+exit "$failures"
diff --git a/evidence/spec-audit-labeled.k b/evidence/spec-audit-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..4ec1a9ac5fb09a7759a0d6dfd45cf0bd1dd3b12b
--- /dev/null
+++ b/evidence/spec-audit-labeled.k
@@ -0,0 +1,109 @@
+requires "verification.k"
+
+// Reviewer-authored label-only duplicate of every candidate positive claim.
+// Labels permit one kprove invocation per original claim.
+module AUDIT-VERIFICATION
+  imports SEMANTIC
+
+  claim [label(helper-positive-head)]:
+        <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => cons(I, filterGt(REST, 0)) </k>
+          <input> cons(I, REST) </input>
+        </py>
+    requires I >Int 0
+
+  claim [label(helper-nonpositive-head)]:
+        <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => filterGt(REST, 0) </k>
+          <input> cons(I, REST) </input>
+        </py>
+    requires I <=Int 0
+
+  claim [label(helper-empty)]:
+        <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => nil </k>
+          <input> nil </input>
+        </py>
+endmodule
+
+module AUDIT-SPEC
+  imports VERIFICATION
+
+  claim [label(spec-universal)]:
+        <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => filterGt(INPUT, 0) </k>
+          <input> INPUT:PyList </input>
+        </py>
+
+  claim [label(spec-example-1)]:
+        <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => cons(2, cons(5, cons(6, nil))) </k>
+          <input> cons(-1, cons(2, cons(-4, cons(5, cons(6, nil))))) </input>
+        </py>
+
+  claim [label(spec-example-2)]:
+        <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => cons(5, cons(3, cons(2, cons(3, cons(9, cons(123, cons(1, nil))))))) </k>
+          <input> cons(5, cons(3, cons(-5, cons(2, cons(-3, cons(3, cons(9, cons(0, cons(123, cons(1, cons(-10, nil))))))))))) </input>
+        </py>
+
+  claim [label(spec-empty)]:
+        <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => nil </k>
+          <input> nil </input>
+        </py>
+
+  claim [label(spec-all-nonpositive)]:
+        <py>
+          <k> Module(
+                FuncDef("get_positive", Params("l"),
+                  Return(
+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => nil </k>
+          <input> cons(0, cons(-1, cons(-2, nil))) </input>
+        </py>
+endmodule
