+                    ListComp(Name("x"),
+                      CompFor(Name("x"), Name("l"),
+                        Compare(Name("x"), CmpOp(">", Int(0))))))))
+            => nil </k>
+          <input> nil </input>
+        </py>
+endmodule
+
+module AUDIT-SPEC
