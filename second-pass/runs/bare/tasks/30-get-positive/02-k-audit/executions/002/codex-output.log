line=51 call name=exec status=completed args=const patch = "*** Begin Patch\n*** Add File: /work/semantic.k\n+module MPY-SYNTAX\n+  imports INT-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  // The constructor grammar needed by the translated solution.  These are\n+  // syntax trees, not built-in K computations.\n+  syntax Pgm ::= \"Module\" \"(\" Function \")\" [symbol(moduleAst)]\n+  syntax Function ::= \"FuncDef\" \"(\" String \",\" Params \",\" Stmt \")\" [symbol(funcDefAst)]\n+  syntax Params ::= \"Params\" \"(\" String \")\" [symbol(paramsAst)]\n+  syntax Stmt ::= \"Return\" \"(\" Expr \")\" [symbol(returnAst)]\n+\n+  syntax Expr ::= \"Name\" \"(\" String \")\" [symbol(nameAst)]\n+                | \"Int\" \"(\" Int \")\" [symbol(intAst)]\n+                | \"ListComp\" \"(\" Expr \",\" CompFor \")\" [symbol(listCompAst)]\n+                | \"Compare\" \"(\" Expr \",\" CmpOp \")\" [symbol(compareAst)]\n+  syntax CompFor ::= \"CompFor\" \"(\" Expr \",\" Expr \",\" Expr \")\" [symbol(compForAst)]\n+  syntax CmpOp ::= \"CmpOp\" \"(\" String \",\" Expr \")\" [symbol(cmpOpAst)]\n+\n+  // A free, inductive representation of Python lists of mathematical ints.\n+  syntax PyList ::= \"nil\" [symbol(nil), constructor]\n+                  | \"cons\" \"(\" Int \",\" PyList \")\" [symbol(cons), constructor]\n+endmodule\n+\n+module SEMANTIC\n+  imports MPY-SYNTAX\n+  imports MAP\n+  imports INT\n+\n+  configuration\n+    <py>\n+      <k> $PGM:Pgm </k>\n+      <input> $INPUT:PyList </input>\n+    </py>\n+\n+  // Function entry binds the sole formal argument to the external input.\n+  syntax KItem ::= \"eval\" \"(\" Expr \",\" Map \")\" [symbol(eval)]\n+  rule <k> Module(FuncDef(\"get_positive\", Params(P), Return(E)))\n+         => eval(E, P |-> L) ... </k>\n+       <input> L </input>\n+\n+  // Typed projection from the untyped payload of a K Map.\n+  syntax PyList ::= \"asList\" \"(\" KItem \")\" [function, symbol(asList)]\n+  rule asList(L:PyList) => L\n+\n+  // A one-generator comprehension evaluates its iterable in the environment.\n+  // Reusing X in all three positions enforces Python's bound-name relationship.\n+  rule <k> eval(\n+              ListComp(Name(X),\n+                CompFor(Name(X), Name(P),\n+                  Compare(Name(X), CmpOp(\">\", Int(N))))),\n+              RHO)\n+         => filterGt(asList(RHO [ P ]), N) ... </k>\n+\n+  // Mathematical meaning of stable filtering: preserve order and duplicates,\n+  // retaining an element exactly when the comparison is true.\n+  syntax PyList ::= \"filterGt\" \"(\" PyList \",\" Int \")\" [function, symbol(filterGt)]\n+  rule filterGt(nil, N) => nil\n+  rule filterGt(cons(I, IS), N) => cons(I, filterGt(IS, N))\n+    requires I >Int N\n+  rule filterGt(cons(I, IS), N) => filterGt(IS, N)\n+    requires I <=Int N\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports SEMANTIC\n+\n+  // An independently named contract relation.  Keeping it symbolic lets a\n+  // correctness claim quantify over lists of arbitrary finite length.\n+  syntax Bool ::= \"isPositiveProjection\" \"(\" PyList \",\" PyList \")\" [function, symbol(isPositiveProjection)]\n+  rule isPositiveProjection(INPUT, filterGt(INPUT, 0)) => true\n+  rule isPositiveProjection(INPUT, OUTPUT) => false [owise]\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Universal functional-correctness summary: execution of the translated\n+  // program returns the stable strict-positive projection for every input.\n+  claim <py>\n+          <k> Module(\n+                FuncDef(\"get_positive\", Params(\"l\"),\n+                  Return(\n+                    ListComp(Name(\"x\"),\n+                      CompFor(Name(\"x\"), Name(\"l\"),\n+                        Compare(Name(\"x\"), CmpOp(\">\", Int(0))))))))\n+            => filterGt(INPUT, 0) </k>\n+          <input> INPUT:PyList </input>\n+        </py>\n+\n+  // Symbolic boundary obligations: arbitrary positive heads are retained and\n+  // arbitrary zero/negative heads are discarded, with the tail left general.\n+  claim filterGt(cons(I, REST), 0)\n+     => cons(I, filterGt(REST, 0))\n+    requires I >Int 0\n+\n+  claim filterGt(cons(I, REST), 0)\n+     => filterGt(REST, 0)\n+    requires I <=Int 0\n+\n+  // The two examples from prompt.py, plus empty and all-nonpositive edges.\n+  claim <py>\n+          <k> Module(\n+                FuncDef(\"get_positive\", Params(\"l\"),\n+                  Return(\n+                    ListComp(Name(\"x\"),\n+                      CompFor(Name(\"x\"), Name(\"l\"),\n+                        Compare(Name(\"x\"), CmpOp(\">\", Int(0))))))))\n+            => cons(2, cons(5, cons(6, nil))) </k>\n+          <input> cons(-1, cons(2, cons(-4, cons(5, cons(6, nil))))) </input>\n+        </py>\n+\n+  claim <py>\n+          <k> Module(\n+                FuncDef(\"get_positive\", Params(\"l\"),\n+                  Return(\n+                    ListComp(Name(\"x\"),\n+                      CompFor(Name(\"x\"), Name(\"l\"),\n+                        Compare(Name(\"x\"), CmpOp(\">\", Int(0))))))))\n+            => cons(5, cons(3, cons(2, cons(3, cons(9, cons(123, cons(1, nil))))))) </k>\n+          <input> cons(5, cons(3, cons(-5, cons(2, cons(-3, cons(3, cons(9, cons(0, cons(123, cons(1, cons(-10, nil))))))))))) </input>\n+        </py>\n+\n+  claim filterGt(nil, 0) => nil\n+  claim filterGt(cons(0, cons(-1, cons(-2, nil))), 0) => nil\n+endmodule\n*** End Patch";
