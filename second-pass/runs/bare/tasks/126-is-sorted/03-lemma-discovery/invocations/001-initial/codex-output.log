                    Compare(
                      Call(Attribute(Name("lst"), "count"), Name("x")),
                      CmpOp("<=", Int(3))),
                    CompFor(Name("x"), Name("lst"), Bool(true)))))))),
        PyList(Cons(2, Cons(2, Cons(2, Nil)))))
      => BoolVal(isSortedContract(Cons(2, Cons(2, Cons(2, Nil)))))
    </k>
endmodule

