from pathlib import Path
import hashlib,itertools,stat
roots=[Path('/candidate'),Path('/generation-evidence/codex-trace')]
targets=['bb3a6e0bcddb9d9a851d06bdc766cef2b8bb02276a607788aa62b7568046a927','2322a48e9ccb0009104898b539cc5fdd0fad9c84641029d0a3e5058617757247']
entries=[]
for root in roots:
 es=[]
 for p in sorted(root.rglob('*')):
  isf=p.is_file(); isd=p.is_dir()
  if not(isf or isd):continue
  es.append((p,isf))
 entries.append(es)

def tok(name,root,p,isf):
 rel=p.relative_to(root).as_posix()
 if name=='rel':return rel.encode()
 if name=='dotrel':return ('./'+rel).encode()
 if name=='abs':return str(p).encode()
 if name=='base':return (root.name+'/'+rel).encode()
 if name=='kindlong':return (b'file' if isf else b'directory')
 if name=='kindshort':return (b'f' if isf else b'd')
 if name=='typechar':return (b'-' if isf else b'd')
 if name=='modeoct':return oct(p.lstat().st_mode).encode()
 if name=='modeperm':return oct(stat.S_IMODE(p.lstat().st_mode)).encode()
 if name=='sizedec':return (str(p.stat().st_size) if isf else '0').encode()
 if name=='size8':return (p.stat().st_size if isf else 0).to_bytes(8,'big')
 if name=='fhhex':return hashlib.sha256(p.read_bytes()).hexdigest().encode() if isf else b''
 if name=='fhbin':return hashlib.sha256(p.read_bytes()).digest() if isf else b''
 if name=='content':return p.read_bytes() if isf else b''
 names='bad'

pathnames=['rel','dotrel','abs','base']; rest=['kindlong','kindshort','typechar','modeoct','modeperm','sizedec','size8','fhhex','fhbin','content']
seps=[b'',b'\\0',b'\\n',b' ',b'  ',b':']
found=[]; tested=0
for pn in pathnames:
 for n in range(1,5):
  for others in itertools.permutations(rest,n):
   names=(pn,)+others
   if not any(x in names for x in ('fhhex','fhbin','content')):continue
   for sep in seps:
    for end in seps:
     outs=[]
     for root,es in zip(roots,entries):
      h=hashlib.sha256()
      for p,isf in es:
       h.update(sep.join(tok(x,root,p,isf) for x in names)+end)
      outs.append(h.hexdigest())
     tested+=1
     if outs==targets:
      found.append((names,repr(sep),repr(end)))
      print('FOUND',found[-1])
      raise SystemExit
print('tested',tested,'none')
