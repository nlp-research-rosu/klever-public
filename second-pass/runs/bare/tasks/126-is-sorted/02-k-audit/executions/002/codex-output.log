+    require_directory(paths["generation_root"], "generation root", failures)
+    require_directory(paths["generation_trace"], "generation trace", failures)
+
+    candidate_required = [
+        "prompt.py",
+        "py2mpy.py",
+        "solution.py",
+        "solution.mpy",
+        "semantic.k",
+        "verification.k",
+        "spec.k",
+        "prove.sh",
+    ]
+    for name in candidate_required:
