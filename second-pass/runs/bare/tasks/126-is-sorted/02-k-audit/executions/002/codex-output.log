+    print(f"{label}: {status}\n  expected={expected}\n  actual  ={actual}")
+    if actual != expected:
+        failures.append(f"{label}: hash mismatch")
+
+
+def main() -> int:
+    failures: list[str] = []
+    require_regular(AUDIT_INPUT, "audit input", failures)
+    document = json.loads(AUDIT_INPUT.read_text())
