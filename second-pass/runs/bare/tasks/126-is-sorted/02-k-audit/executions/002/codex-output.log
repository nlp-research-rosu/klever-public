+    candidate_digest = tree_hash(paths["candidate"])
+    print(
+        "candidate_tree_sha256:"
+        f" {'MATCH' if candidate_digest == recorded['candidate_tree_sha256'] else 'MISMATCH'}"
+        f"\n  expected={recorded['candidate_tree_sha256']}"
