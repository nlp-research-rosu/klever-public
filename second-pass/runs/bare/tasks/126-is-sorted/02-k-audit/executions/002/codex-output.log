+    else:
+        failures.append("campaign block differs from mounted lock")
+
+    prompt_equal = (
+        (paths["candidate"] / "prompt.py").read_bytes()
+        == paths["trusted_prompt"].read_bytes()
+    )
+    translator_equal = (
+        (paths["candidate"] / "py2mpy.py").read_bytes()
