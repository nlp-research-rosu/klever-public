Module(
  FuncDef("is_sorted", Params("lst"), CellVars("lst"), FreeVars(),
    Return(
      BoolOp(
        "and",
        Call(
          Name("all"),
          GenExp(Compare(
            Call(Attribute(Name("lst"), "count"), Name("lst")),
            CmpOp("<=", Int(2))),
            CompFor(Name("lst"), Name("lst"), Bool(true)))),
        Call(
          Name("all"),
          GenExp(Compare(
            Call(Attribute(Name("lst"), "count"), Name("x")),
            CmpOp("<=", Int(2))),
            CompFor(Name("x"), Name("lst"), Bool(true))))))))
