index 0000000000000000000000000000000000000000..117709a8ae1bee2dc546e5190af159432dd4244c
--- /dev/null
+++ b/mutation-spec.k
@@ -0,0 +1,29 @@
+requires "semantic.k"
+
+module MUTATION-SPEC
+  imports MPY
+  imports VERIFICATION
+
+  // Expected to fail: three equal values expose the weakened <= 3 mutation.
+  claim
+    <k>
+      Run(
+        Module(
+          FuncDef("is_sorted", Params("lst"), CellVars("lst"), FreeVars(),
+            Return(
+              BoolOp(
+                "and",
+                Compare(
+                  Name("lst"),
+                  CmpOp("==", Call(Name("sorted"), Name("lst")))),
+                Call(
+                  Name("all"),
+                  GenExp(
+                    Compare(
+                      Call(Attribute(Name("lst"), "count"), Name("x")),
+                      CmpOp("<=", Int(3))),
+                    CompFor(Name("x"), Name("lst"), Bool(true)))))))),
+        PyList(Cons(2, Cons(2, Cons(2, Nil)))))
+      => BoolVal(isSortedContract(Cons(2, Cons(2, Cons(2, Nil)))))
+    </k>
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0484169973c0b4e16281364c9556878d31c89fa2
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+kompile semantic.k --backend haskell --main-module MPY --syntax-module MPY-SYNTAX
+
+run_expect() {
+  local list_value="$1"
+  local expected_bool="$2"
+  local actual_output
+  actual_output="$(krun solution.mpy --definition semantic-kompiled -cARGS="$list_value")"
+  printf '%s\n' "$actual_output"
+  printf '%s\n' "$actual_output" | rg -q "BoolVal \\( $expected_bool \\)"
+}
+
+# The eight examples in prompt.py, plus the empty-list boundary case.
+run_expect 'PyList(Cons(5, Nil))' true
+run_expect 'PyList(Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Nil))))))' true
+run_expect 'PyList(Cons(1, Cons(3, Cons(2, Cons(4, Cons(5, Nil))))))' false
+run_expect 'PyList(Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Cons(6, Nil)))))))' true
+run_expect 'PyList(Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Cons(6, Cons(7, Nil))))))))' true
+run_expect 'PyList(Cons(1, Cons(3, Cons(2, Cons(4, Cons(5, Cons(6, Cons(7, Nil))))))))' false
+run_expect 'PyList(Cons(1, Cons(2, Cons(2, Cons(3, Cons(3, Cons(4, Nil)))))))' true
+run_expect 'PyList(Cons(1, Cons(2, Cons(2, Cons(2, Cons(3, Cons(4, Nil)))))))' false
+run_expect 'PyList(Nil)' true
+
+# Required positive target: this must print #Top and exit zero.
+kprove spec.k --definition semantic-kompiled --spec-module SPEC
+
+# Negative validation: weakening <= 2 to <= 3 must be rejected on [2, 2, 2].
+if kprove mutation-spec.k --definition semantic-kompiled --spec-module MUTATION-SPEC; then
+  printf '%s\n' 'error: the expected-failure mutation was incorrectly proved' >&2
+  exit 1
+fi
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..c47315af936f2f80b6e359f809fc68ac694ee27a
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,93 @@
+requires "list-domain.k"
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports VERIFICATION
+  imports STRING
+  imports MAP
+
+  syntax Pgm ::= "Module" "(" Stmt ")" [symbol(module)]
+
+  syntax Params ::= "Params" "(" String ")" [symbol(params1)]
+  syntax CellVars ::= "CellVars" "(" String ")" [symbol(cellVars1)]
+  syntax FreeVars ::= "FreeVars" "(" ")" [symbol(freeVars0)]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," CellVars ","
+                                  FreeVars "," Stmt ")" [symbol(funcDef)]
+                | "Return" "(" Expr ")" [symbol(returnStmt)]
+
+  syntax Expr ::= "Name" "(" String ")" [symbol(name)]
+                | "Int" "(" Int ")" [symbol(intExpr)]
+                | "Bool" "(" Bool ")" [symbol(boolExpr)]
+                | "Attribute" "(" Expr "," String ")" [symbol(attribute)]
+                | "Call" "(" Expr "," Expr ")" [symbol(call1)]
+                | "BoolOp" "(" String "," Expr "," Expr ")" [symbol(boolOp2)]
+                | "Compare" "(" Expr "," CmpOp ")" [symbol(compare1)]
+                | "GenExp" "(" Expr "," CompFor ")" [symbol(genExp1)]
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(cmpOp)]
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Expr ")"
+                     [symbol(compFor)]
+
+  syntax Value ::= "IntVal" "(" Int ")" [symbol(intVal)]
+                 | "BoolVal" "(" Bool ")" [symbol(boolVal)]
+                 | "PyList" "(" IntList ")" [symbol(pyList)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+
+  syntax Value ::= "Run" "(" Pgm "," Value ")" [function, symbol(run)]
+                 | "EvalStmt" "(" Stmt "," Map ")"
+                   [function, symbol(evalStmt)]
+
+  configuration
+    <k> Run($PGM:Pgm, $ARGS:Value) </k>
+
+  // Loading a capture-free one-argument function and immediately invoking it.
+  // CellVars is present because CPython classifies lst as captured by the
+  // generator expression; the generator evaluator below reads that binding.
+  rule Run(Module(FuncDef("is_sorted", Params(X), _CV, _FV, BODY)), V)
+    => EvalStmt(BODY, X |-> V)
+
+  rule EvalStmt(Return(E), RHO) => eval(E, RHO)
+
+  syntax Value ::= eval(Expr, Map) [function]
+  rule eval(Int(I), _) => IntVal(I)
+  rule eval(Bool(B), _) => BoolVal(B)
+  rule eval(Name(X), (X |-> V) _RHO) => V
+
+  syntax IntList ::= asList(Value) [function]
+  rule asList(PyList(IS)) => IS
+
+  syntax Bool ::= asBool(Value) [function]
+  rule asBool(BoolVal(B)) => B
+
+  syntax Bool ::= eqValue(Value, Value) [function]
+  rule eqValue(PyList(IS), PyList(JS)) => eqIntLists(IS, JS)
+  rule eqValue(IntVal(I), IntVal(J)) => I ==Int J
+  rule eqValue(BoolVal(B), BoolVal(C)) => B ==Bool C
+
+  // Pure expression rules. Both BoolOp operands in this accepted subset are
+  // booleans, so the denotation agrees with Python's short-circuit result.
+  rule eval(BoolOp("and", E1, E2), RHO)
+    => BoolVal(asBool(eval(E1, RHO)) andBool asBool(eval(E2, RHO)))
+
+  rule eval(Compare(E1, CmpOp("==", E2)), RHO)
+    => BoolVal(eqValue(eval(E1, RHO), eval(E2, RHO)))
+
+  rule eval(Call(Name("sorted"), E), RHO)
+    => PyList(sortInts(asList(eval(E, RHO))))
+
+  // Denotation of all(source.count(x) <= 2 for x in source).  This fused rule
+  // is equivalent to constructing the pure generator and folding Python all;
+  // it also leaves a compact symbolic term for proof.
+  rule eval(
+         Call(Name("all"),
+           GenExp(
+             Compare(
+               Call(Attribute(Name(SOURCE), "count"), Name(X)),
+               CmpOp("<=", Int(LIMIT))),
+             CompFor(Name(X), Name(SOURCE), Bool(true)))),
+         (SOURCE |-> PyList(IS)) _RHO)
+    => BoolVal(countsAtMost(IS, IS, LIMIT))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ecc6ed5dcdc2f49a153d9f4aee94d17f98f8a459
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def is_sorted(lst):
+    return lst == sorted(lst) and all(lst.count(x) <= 2 for x in lst)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2e54a1c6173ccb7698e00337f85bdaefe0229b63
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,30 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+  imports VERIFICATION
+
+  // Universal functional-correctness claim: IS is an arbitrary integer list.
+  // The left side is the exact constructor tree emitted in solution.mpy.
+  claim
+    <k>
+      Run(
+        Module(
+          FuncDef("is_sorted", Params("lst"), CellVars("lst"), FreeVars(),
+            Return(
+              BoolOp(
+                "and",
+                Compare(
+                  Name("lst"),
+                  CmpOp("==", Call(Name("sorted"), Name("lst")))),
+                Call(
+                  Name("all"),
+                  GenExp(
+                    Compare(
+                      Call(Attribute(Name("lst"), "count"), Name("x")),
+                      CmpOp("<=", Int(2))),
+                    CompFor(Name("x"), Name("lst"), Bool(true)))))))),
+        PyList(IS))
+      => BoolVal(isSortedContract(IS))
+    </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0edb261cc7f51be01af9b6768ed597d86630f797
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "list-domain.k"
+
+module VERIFICATION
+  imports PY-LIST-DOMAIN
+
+  // For integer lists, equality with the ascending sort is equivalent to
+  // nondecreasing order.  The second conjunct is the prompt's duplicate bound:
+  // every value occurring in the list has multiplicity at most two.
+  syntax Bool ::= ascending(IntList) [function]
+  rule ascending(IS) => eqIntLists(IS, sortInts(IS))
+
+  syntax Bool ::= duplicateBound(IntList) [function]
+  rule duplicateBound(IS) => countsAtMostTwo(IS, IS)
+
+  syntax Bool ::= isSortedContract(IntList) [function]
+  rule isSortedContract(IS) => ascending(IS) andBool duplicateBound(IS)
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh
./prove.sh' in /work
diff --git a/list-domain.k b/list-domain.k
new file mode 100644
index 0000000000000000000000000000000000000000..f20f94151c472d4d7dd91e528619bb5a0ac025af
--- /dev/null
+++ b/list-domain.k
@@ -0,0 +1,43 @@
+module PY-LIST-DOMAIN
+  imports INT
+  imports BOOL
+
+  // A deliberately explicit value representation keeps symbolic list tails
+  // constructor-based and makes concrete krun input unambiguous.
+  syntax IntList ::= "Nil" [symbol(nil)]
+                   | "Cons" "(" Int "," IntList ")" [symbol(cons)]
+
+  syntax IntList ::= insertInt(Int, IntList) [function]
+  rule insertInt(I, Nil) => Cons(I, Nil)
+  rule insertInt(I, Cons(J, JS)) => Cons(I, Cons(J, JS)) requires I <=Int J
+  rule insertInt(I, Cons(J, JS)) => Cons(J, insertInt(I, JS)) requires I >Int J
+
+  syntax IntList ::= sortInts(IntList) [function]
+  rule sortInts(Nil) => Nil
+  rule sortInts(Cons(I, IS)) => insertInt(I, sortInts(IS))
+
+  syntax Bool ::= eqIntLists(IntList, IntList) [function]
+  rule eqIntLists(Nil, Nil) => true
+  rule eqIntLists(Nil, Cons(_, _)) => false
+  rule eqIntLists(Cons(_, _), Nil) => false
+  rule eqIntLists(Cons(I, IS), Cons(J, JS))
+    => (I ==Int J) andBool eqIntLists(IS, JS)
+
+  syntax Int ::= countInt(Int, IntList) [function]
+  rule countInt(_, Nil) => 0
+  rule countInt(I, Cons(J, JS)) => 1 +Int countInt(I, JS)
+    requires I ==Int J
+  rule countInt(I, Cons(J, JS)) => countInt(I, JS)
+    requires I =/=Int J
+
+  // countsAtMost(SOURCE, ITEMS, LIMIT) checks each item drawn from ITEMS in
+  // SOURCE. Calling it with the same list twice models Python's all over count.
+  syntax Bool ::= countsAtMost(IntList, IntList, Int) [function]
+  rule countsAtMost(_, Nil, _) => true
+  rule countsAtMost(SOURCE, Cons(I, IS), LIMIT)
+    => (countInt(I, SOURCE) <=Int LIMIT)
+       andBool countsAtMost(SOURCE, IS, LIMIT)
+
+  syntax Bool ::= countsAtMostTwo(IntList, IntList) [function]
+  rule countsAtMostTwo(SOURCE, ITEMS) => countsAtMost(SOURCE, ITEMS, 2)
+endmodule
