+requires "semantic.k"
+
+module SPEC
+  imports MPY
+  imports VERIFICATION
+
+  // Universal functional-correctness claim: IS is an arbitrary integer list.
+  // The left side is the exact constructor tree emitted in solution.mpy.
+  claim
+    <k>
+      Run(
+        Module(
+          FuncDef("is_sorted", Params("lst"), CellVars("lst"), FreeVars(),
+            Return(
+              BoolOp(
+                "and",
+                Compare(
+                  Name("lst"),
+                  CmpOp("==", Call(Name("sorted"), Name("lst")))),
+                Call(
+                  Name("all"),
+                  GenExp(
+                    Compare(
+                      Call(Attribute(Name("lst"), "count"), Name("x")),
+                      CmpOp("<=", Int(2))),
+                    CompFor(Name("x"), Name("lst"), Bool(true)))))))),
+        PyList(IS))
+      => BoolVal(isSortedContract(IS))
+    </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0edb261cc7f51be01af9b6768ed597d86630f797
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "list-domain.k"
+
+module VERIFICATION
+  imports PY-LIST-DOMAIN
+
+  // For integer lists, equality with the ascending sort is equivalent to
+  // nondecreasing order.  The second conjunct is the prompt's duplicate bound:
+  // every value occurring in the list has multiplicity at most two.
+  syntax Bool ::= ascending(IntList) [function]
+  rule ascending(IS) => eqIntLists(IS, sortInts(IS))
+
+  syntax Bool ::= duplicateBound(IntList) [function]
+  rule duplicateBound(IS) => countsAtMostTwo(IS, IS)
+
+  syntax Bool ::= isSortedContract(IntList) [function]
+  rule isSortedContract(IS) => ascending(IS) andBool duplicateBound(IS)
+endmodule

