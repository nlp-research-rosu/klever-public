codex
The root cause is now concrete: this sandbox reports container PIDs (for example `3`) while `/proc/3` is absent; Lean 4.22 resolves its executable via `/proc/<getpid>/exe`, so both Lean and Lake fail before reading the project. I’m applying a narrowly scoped local shim that maps only that equivalent lookup to `/proc/self/exe`, preserving the pinned binaries and leaving all mounted evidence untouched. I’ll record the shim source, compilation, and diagnostic before rerunning preflight.
apply patch
patch: completed
/audit-output/evidence/proc-self-readlink-shim.c
diff --git a/evidence/proc-self-readlink-shim.c b/evidence/proc-self-readlink-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..49093602a4e3bf4991269ae695e928307f488789
--- /dev/null
+++ b/evidence/proc-self-readlink-shim.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    const char *cursor;
+
+    if (strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    cursor = path + sizeof(prefix) - 1;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, suffix) == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_proc_pid_exe(path)) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

