     6	def add_elements(arr, k):
     7	    """
     8	    Given a non-empty array of integers arr and an integer k, return
     9	    the sum of the elements with at most two digits from the first k elements of arr.
    10	
    11	    Example:
    12	
    13	        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4
    14	        Output: 24 # sum of 21 + 3
    15	
    16	    Constraints:
    17	        1. 1 <= len(arr) <= 100
    18	        2. 1 <= k <= len(arr)
    19	    """
