+    return " ".join(f"ListItem({value})" for value in values) or ".List"
+
+
+canonical = load("trusted_canonical_for_k", SCRATCH / "canonical.py")
+candidate = load("candidate_for_k", SCRATCH / "solution.py")
+cases = [
