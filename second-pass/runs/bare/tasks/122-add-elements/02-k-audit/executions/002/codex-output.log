+    (
+        "all-branch-boundaries",
+        [-101, -100, -99, -10, -9, -1, 0, 9, 10, 99, 100, 101],
+        12,
+        True,
+    ),
+    ("length-100", list(range(-50, 50)), 100, True),
+]
+
+failures = 0
