import hashlib, os, stat
from pathlib import Path

def pipeline_tree(root):
    root=Path(root)
    h=hashlib.sha256(); pending=[root]; entries=[]
    while pending:
      d=pending.pop()
      for child in os.scandir(d):
        p=Path(child.path); mode=child.stat(follow_symlinks=False).st_mode; rel=p.relative_to(root).as_posix()
        if stat.S_ISDIR(mode): entries.append((rel,'directory',p)); pending.append(p)
        elif stat.S_ISREG(mode): entries.append((rel,'file',p))
        else: raise ValueError(p)
    for rel,kind,p in sorted(entries):
      e=rel.encode(); h.update(len(e).to_bytes(4,'big')); h.update(e); h.update(kind.encode()+b'\\0')
      if kind=='file': h.update(p.stat(follow_symlinks=False).st_size.to_bytes(8,'big')); h.update(p.read_bytes())
    return h.hexdigest()

def legacy_tree(root):
 h=hashlib.sha256(); root=Path(root); es=[]
 for p in root.rglob('*'):
  mode=p.lstat().st_mode; rel=p.relative_to(root).as_posix(); kind='directory' if stat.S_ISDIR(mode) else 'file'
  es.append((rel,kind,p))
 for rel,kind,p in sorted(es):
  h.update(rel.encode()+b'\\0'+kind.encode()+b'\\0')
  if kind=='file': h.update(p.read_bytes())
 return h.hexdigest()
