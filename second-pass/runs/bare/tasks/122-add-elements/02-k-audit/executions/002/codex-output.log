+    k_value = int(matches[-1]) if matches else None
+    candidate_value = candidate.add_elements(arr, k)
+    canonical_value = canonical.add_elements(arr, k)
+    print(
+        f"comparison {name}: K={k_value} candidate_python={candidate_value} "
