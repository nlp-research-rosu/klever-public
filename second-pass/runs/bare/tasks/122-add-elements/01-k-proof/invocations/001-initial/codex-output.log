new file mode 100644
index 0000000000000000000000000000000000000000..6c559ab8ab45270d2cb90c746c4edefba3d0c436
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module ADD-ELEMENTS-SPEC
+  imports MPY-VERIFICATION
+
+  // Loop invariant: from any legal index I, the current total plus the
+  // mathematical sum over the remaining range is the eventual return value.
+  claim [loop-invariant]:
+    <k> solutionLoop ~> exec(Return(Name("total")) .Stmts) => .K </k>
+    <env>
+      "arr" |-> A:List
+      "k" |-> K:Int
+      "total" |-> T:Int
+      "i" |-> I:Int
+      "value" |-> V:Int
+      => ?FINAL:Map
+    </env>
+    <arr> A </arr>
+    <n> K </n>
+    <result> noResult => result(T +Int sumRange(A, I, K)) </result>
+    requires 0 <=Int I andBool I <=Int K andBool K <=Int size(A)
+
+  // Full contract for every integer array and every k satisfying the prompt.
+  claim [add-elements-contract]:
+    <k> solutionProgram => .K </k>
+    <env> .Map => ?FINAL:Map </env>
+    <arr> A:List </arr>
+    <n> K:Int </n>
+    <result> noResult => result(sumRange(A, 0, K)) </result>
+    requires 1 <=Int K
+     andBool K <=Int size(A)
+     andBool size(A) <=Int 100
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..30381cab6acbec14c0332ddcbac4d9ba76368157
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,45 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTICS
+  imports MAP-SYMBOLIC
+
+  // A compact name for the exact AST emitted in solution.mpy.  Both krun and
+  // kprove therefore execute the same constructor-level program.
+  syntax Stmt ::= "solutionLoop" [macro]
+  rule solutionLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("k"))),
+      Assign(Name("value"), Subscript(Name("arr"), Name("i")))
+      If(BoolOp(
+        "and",
+        Compare(UnaryOp("-", Int(100)), CmpOp("<", Name("value"))),
+        Compare(Name("value"), CmpOp("<", Int(100)))),
+        Assign(Name("total"), BinOp("+", Name("total"), Name("value"))),
+        .Stmts)
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(FuncDef("add_elements", Params("arr", "k"),
+      Assign(Name("total"), Int(0))
+      Assign(Name("i"), Int(0))
+      Assign(Name("value"), Int(0))
+      solutionLoop
+      Return(Name("total"))))
+
+  // Mathematical contract: the contribution of one integer, followed by the
+  // sum of contributions at positions [I, K).  These equations are independent
+  // of the implementation's loop and conditional control flow.
+  syntax Int ::= "smallContribution" "(" Int ")" [function, total]
+  rule smallContribution(I) => I
+    requires -100 <Int I andBool I <Int 100
+  rule smallContribution(I) => 0
+    requires I <=Int -100 orBool I >=Int 100
+
+  syntax Int ::= "sumRange" "(" List "," Int "," Int ")" [function, total]
+  rule sumRange(_A, I, K) => 0
+    requires I >=Int K
+  rule sumRange(A, I, K) =>
+    smallContribution(intAt(A, I)) +Int sumRange(A, I +Int 1, K)
+    requires I <Int K
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module MPY-VERIFICATION --syntax-module MPY-SYNTAX && kprove spec.k --definition verification-kompiled --spec-module ADD-ELEMENTS-SPEC' in /work
