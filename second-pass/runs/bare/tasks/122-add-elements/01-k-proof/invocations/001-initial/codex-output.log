+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile semantic.k \
+  --backend haskell \
+  --main-module MPY-SEMANTICS \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cARR='ListItem(111) ListItem(21) ListItem(3) ListItem(4000) ListItem(5) ListItem(6) ListItem(7) ListItem(8) ListItem(9)' \
+  -cN=4 \
+  | grep -F 'result ( 24 )'
+
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cARR='ListItem(-100) ListItem(-99) ListItem(-1) ListItem(0) ListItem(9) ListItem(10) ListItem(99) ListItem(100)' \
+  -cN=8 \
+  | grep -F 'result ( 18 )'
+
+kompile verification.k \
+  --backend haskell \
+  --main-module MPY-VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module ADD-ELEMENTS-SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..e5121000ab58129cd82d84c39a557b97cc319098
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,117 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Params  ::= "Params" "(" String "," String ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt  ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                 | "Assign" "(" Expr "," Expr ")"
+                 | "While" "(" Expr "," Stmts ")"
+                 | "If" "(" Expr "," Stmts "," Stmts ")"
+                 | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports LIST
+  imports MAP
+
+  syntax Value ::= Int | Bool | List
+  syntax KResult ::= Value
+  syntax Result ::= "noResult" | "result" "(" Value ")"
+
+  // Python arrays are lists of integers for this task.  Keeping lookup as a
+  // typed function makes the contract's element type explicit to the prover.
+  syntax Int ::= "intAt" "(" List "," Int ")" [function, total]
+  rule intAt(ListItem(I:Int) _REST, 0) => I
+  rule intAt(ListItem(_I:Int) REST, N) => intAt(REST, N -Int 1)
+    requires N >Int 0
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "setVar" "(" String ")"
+                 | "ifBranches" "(" Stmts "," Stmts ")"
+                 | "whileBody" "(" Expr "," Stmts ")"
+                 | "negate"
+                 | "addRight" "(" Expr ")"
+                 | "addLeft" "(" Int ")"
+                 | "andRight" "(" Expr ")"
+                 | "compareRight" "(" Expr ")"
+                 | "lessThanLeft" "(" Int ")"
+                 | "subscriptIndex" "(" Expr ")"
+                 | "getAt" "(" List ")"
+                 | "doReturn"
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <env> .Map </env>
+      <input>
+        <arr> $ARR:List </arr>
+        <n> $N:Int </n>
+      </input>
+      <result> noResult </result>
+    </mpy>
+
+  rule <k> Module(FuncDef("add_elements", Params("arr", "k"), BODY))
+         => exec(BODY) ... </k>
+       <env> .Map => "arr" |-> A "k" |-> N </env>
+       <arr> A </arr>
+       <n> N </n>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> Assign(Name(X), E) => E ~> setVar(X) ... </k>
+  rule <k> V:Value ~> setVar(X) => .K ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifBranches(THEN, ELSE) ... </k>
+  rule <k> true  ~> ifBranches(THEN, _ELSE) => exec(THEN) ... </k>
+  rule <k> false ~> ifBranches(_THEN, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileBody(E, BODY) ... </k>
+  rule <k> true  ~> whileBody(E, BODY) => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> false ~> whileBody(_E, _BODY) => .K ... </k>
+
+  rule <k> Return(E) => E ~> doReturn ... </k>
+  rule <k> V:Value ~> doReturn ~> _REST:K => .K </k>
+       <result> noResult => result(V) </result>
+
+  rule <k> Int(I) => I ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V:Value ... </env>
+
+  rule <k> UnaryOp("-", E) => E ~> negate ... </k>
+  rule <k> I:Int ~> negate => 0 -Int I ... </k>
+
+  rule <k> BinOp("+", E1, E2) => E1 ~> addRight(E2) ... </k>
+  rule <k> I:Int ~> addRight(E2) => E2 ~> addLeft(I) ... </k>
+  rule <k> J:Int ~> addLeft(I) => I +Int J ... </k>
+
+  rule <k> BoolOp("and", E1, E2) => E1 ~> andRight(E2) ... </k>
+  rule <k> true  ~> andRight(E2) => E2 ... </k>
+  rule <k> false ~> andRight(_E2) => false ... </k>
+
+  rule <k> Compare(E1, CmpOp("<", E2)) => E1 ~> compareRight(E2) ... </k>
+  rule <k> I:Int ~> compareRight(E2) => E2 ~> lessThanLeft(I) ... </k>
+  rule <k> J:Int ~> lessThanLeft(I) => I <Int J ... </k>
+
+  rule <k> Subscript(E1, E2) => E1 ~> subscriptIndex(E2) ... </k>
+  rule <k> A:List ~> subscriptIndex(E2) => E2 ~> getAt(A) ... </k>
+  rule <k> I:Int ~> getAt(A) => intAt(A, I) ... </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b444a510b0d22be7eea990d4050cf0366674f33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def add_elements(arr, k):
+    total = 0
+    i = 0
+    value = 0
+    while i < k:
+        value = arr[i]
+        if -100 < value and value < 100:
+            total = total + value
+        i = i + 1
+    return total
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cb4a1d99bf3c0dabc4b346ec96db7195a3b211e5
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module ADD-ELEMENTS-SPEC
+  imports MPY-VERIFICATION
+
+  // Loop invariant: from any legal index I, the current total plus the
+  // mathematical sum over the remaining range is the eventual return value.
+  claim [loop-invariant]:
+    <k> solutionLoop ~> exec(Return(Name("total")) .Stmts) => .K </k>
+    <env>
+      "arr" |-> A:List
+      "k" |-> K:Int
+      "total" |-> T:Int
+      "i" |-> I:Int
+      "value" |-> _V:Int
+      => ?_:Map
+    </env>
+    <arr> A </arr>
+    <n> K </n>
+    <result> noResult => result(T +Int sumRange(A, I, K)) </result>
+    requires 0 <=Int I andBool I <=Int K andBool K <=Int size(A)
+
+  // Full contract for every integer array and every k satisfying the prompt.
+  claim [add-elements-contract]:
+    <k> solutionProgram => .K </k>
+    <env> .Map => ?_:Map </env>
+    <arr> A:List </arr>
+    <n> K:Int </n>
+    <result> noResult => result(sumRange(A, 0, K)) </result>
+    requires 1 <=Int K
+     andBool K <=Int size(A)
+     andBool size(A) <=Int 100
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..30381cab6acbec14c0332ddcbac4d9ba76368157
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,45 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTICS
+  imports MAP-SYMBOLIC
+
+  // A compact name for the exact AST emitted in solution.mpy.  Both krun and
+  // kprove therefore execute the same constructor-level program.
+  syntax Stmt ::= "solutionLoop" [macro]
+  rule solutionLoop =>
+    While(Compare(Name("i"), CmpOp("<", Name("k"))),
+      Assign(Name("value"), Subscript(Name("arr"), Name("i")))
+      If(BoolOp(
+        "and",
+        Compare(UnaryOp("-", Int(100)), CmpOp("<", Name("value"))),
+        Compare(Name("value"), CmpOp("<", Int(100)))),
+        Assign(Name("total"), BinOp("+", Name("total"), Name("value"))),
+        .Stmts)
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(FuncDef("add_elements", Params("arr", "k"),
+      Assign(Name("total"), Int(0))
+      Assign(Name("i"), Int(0))
+      Assign(Name("value"), Int(0))
+      solutionLoop
+      Return(Name("total"))))
+
+  // Mathematical contract: the contribution of one integer, followed by the
+  // sum of contributions at positions [I, K).  These equations are independent
+  // of the implementation's loop and conditional control flow.
+  syntax Int ::= "smallContribution" "(" Int ")" [function, total]
+  rule smallContribution(I) => I
+    requires -100 <Int I andBool I <Int 100
+  rule smallContribution(I) => 0
+    requires I <=Int -100 orBool I >=Int 100
+
+  syntax Int ::= "sumRange" "(" List "," Int "," Int ")" [function, total]
+  rule sumRange(_A, I, K) => 0
+    requires I >=Int K
+  rule sumRange(A, I, K) =>
+    smallContribution(intAt(A, I)) +Int sumRange(A, I +Int 1, K)
+    requires I <Int K
+endmodule

