    47	      => bool(true)
    48	    </k>
    49	    <env> .Map </env>
    50	    <functions> .Map </functions>
    51	    <stack> .List </stack>
    52	
    53	  // x^3 - 8: both initial endpoint values are negative, so the bracket grows.
    54	  claim
    55	    <k>
    56	      solution ;;
    57	      VerifyRoot(
    58	        ListItem(rat(-8, 1)) ListItem(rat(0, 1))
    59	          ListItem(rat(0, 1)) ListItem(rat(1, 1)),
    60	        Invoke("find_zero", list(
    61	          ListItem(rat(-8, 1)) ListItem(rat(0, 1))
    62	            ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
    63	        rat(1, 100000000))
    64	      => bool(true)
    65	    </k>
    66	    <env> .Map </env>
    67	    <functions> .Map </functions>
    68	    <stack> .List </stack>
    69	
    70	  // x^3 + 8: symmetric expansion to a negative root.
    71	  claim
    72	    <k>
    73	      solution ;;
    74	      VerifyRoot(
    75	        ListItem(rat(8, 1)) ListItem(rat(0, 1))
    76	          ListItem(rat(0, 1)) ListItem(rat(1, 1)),
    77	        Invoke("find_zero", list(
    78	          ListItem(rat(8, 1)) ListItem(rat(0, 1))
    79	            ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
    80	        rat(1, 100000000))
    81	      => bool(true)
    82	    </k>
    83	    <env> .Map </env>
    84	    <functions> .Map </functions>
    85	    <stack> .List </stack>
    86	endmodule
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // This constant is the exact constructor tree emitted in solution.mpy.
     7	  // Keeping it as a macro lets both krun and kprove execute the submitted AST.
     8	  syntax Program ::= "solution" [macro]
     9	  rule solution =>
    10	    Module(
    11	      FuncDef("evaluate_polynomial", Params("xs", "x"),
    12	        Assign(Name("value"), Int(0))
    13	        Assign(Name("power"), Int(1))
    14	        For(Name("coefficient"), Name("xs"),
    15	          Assign(
    16	            Name("value"),
    17	            BinOp(
    18	              "+",
    19	              Name("value"),
    20	              BinOp("*", Name("coefficient"), Name("power"))))
    21	          Assign(Name("power"), BinOp("*", Name("power"), Name("x"))))
    22	        Return(Name("value")))
    23	      FuncDef("find_zero", Params("xs"),
    24	        Assign(Name("left"), UnaryOp("-", Int(1)))
    25	        Assign(Name("right"), Int(1))
    26	        While(Compare(
    27	          BinOp(
    28	            "*",
    29	            Call(Name("evaluate_polynomial"), Name("xs"), Name("left")),
    30	            Call(Name("evaluate_polynomial"), Name("xs"), Name("right"))),
    31	          CmpOp(">", Int(0))),
    32	          Assign(Name("left"), BinOp("*", Name("left"), Int(2)))
    33	          Assign(Name("right"), BinOp("*", Name("right"), Int(2))))
    34	        While(Compare(
    35	          BinOp("-", Name("right"), Name("left")),
    36	          CmpOp(">", BinOp("/", Int(1), Int(10000000000)))),
    37	          Assign(
    38	            Name("middle"),
    39	            BinOp("/", BinOp("+", Name("left"), Name("right")), Int(2)))
    40	          If(Compare(
    41	            BinOp(
    42	              "*",
    43	              Call(Name("evaluate_polynomial"), Name("xs"), Name("middle")),
    44	              Call(Name("evaluate_polynomial"), Name("xs"), Name("left"))),
    45	            CmpOp(">", Int(0))),
    46	            Assign(Name("left"), Name("middle")),
    47	            Assign(Name("right"), Name("middle"))))
    48	        Return(BinOp("/", BinOp("+", Name("left"), Name("right")), Int(2)))))
    49	
    50	  // Independent postcondition machinery.  Coefficients are in ascending order,
    51	  // so this is Horner evaluation from the head: c0 + x * (c1 + x * ...).
    52	  syntax Val ::= polyValue(List, Val) [function]
    53	               | absRat(Val) [function, total]
    54	  syntax Bool ::= leRat(Val, Val) [function, total]
    55	
    56	  rule polyValue(.List, _X) => rat(0, 1) [simplification]
    57	  rule polyValue(ListItem(C:Val) REST, X)
    58	    => addRat(C, mulRat(X, polyValue(REST, X))) [simplification]
    59	
    60	  rule absRat(rat(N, D)) => rat(0 -Int N, D)
    61	    requires N <Int 0 [simplification]
    62	  rule absRat(rat(N, D)) => rat(N, D)
    63	    requires N >=Int 0 [simplification]
    64	  rule leRat(rat(A, B), rat(C, D)) => A *Int D <=Int C *Int B
    65	    [simplification]
    66	
    67	  syntax Expr ::= "VerifyRoot" "(" List "," Expr "," Val ")" [strict(2)]
    68	  rule VerifyRoot(COEFFS, ROOT:Val, TOLERANCE)
    69	    => bool(leRat(absRat(polyValue(COEFFS, ROOT)), TOLERANCE))
    70	endmodule
     1	requires "domains.md"
     2	
     3	module SEMANTIC-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports BOOL-SYNTAX
     6	  imports STRING-SYNTAX
     7	  imports MAP
     8	  imports LIST
     9	
    10	  syntax Strings ::= List{String, ","}
    11	  syntax Params ::= "Params" "(" Strings ")"
    12	
    13	  syntax Exprs ::= List{Expr, ","}
    14	  syntax Expr ::= "Int" "(" Int ")"
    15	                | "Name" "(" String ")"
    16	                | "UnaryOp" "(" String "," Expr ")"
    17	                | "BinOp" "(" String "," Expr "," Expr ")"
    18	                | "Compare" "(" Expr "," CmpOp ")"
    19	                | "Call" "(" Expr "," Expr ")"
    20	                | "Call" "(" Expr "," Expr "," Expr ")"
    21	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    22	
    23	  syntax Stmts ::= List{Stmt, ""}
    24	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    25	                | "Assign" "(" Expr "," Expr ")" [strict(2)]
    26	                | "Return" "(" Expr ")" [strict]
    27	                | "For" "(" Expr "," Expr "," Stmts ")"
    28	                | "While" "(" Expr "," Stmts ")"
    29	                | "If" "(" Expr "," Stmts "," Stmts ")"
    30	
    31	  syntax Program ::= "Module" "(" Stmts ")"
    32	                   | Program ";;" Expr
    33	
    34	  // Values are exact rationals.  All rules maintain a positive denominator.
    35	  syntax Val ::= "rat" "(" Int "," Int ")"
    36	               | "bool" "(" Bool ")"
    37	               | "list" "(" List ")"
    38	  syntax Expr ::= Val
    39	  syntax KResult ::= Val
    40	
    41	  // A convenient external entry point used by runners and specifications.
    42	  syntax Expr ::= "Invoke" "(" String "," Val ")"
    43	endmodule
    44	
    45	module SEMANTIC
    46	  imports SEMANTIC-SYNTAX
    47	  imports INT
    48	  imports BOOL
    49	  imports STRING
    50	  imports MAP
    51	  imports LIST
    52	
    53	  configuration
    54	    <T>
    55	      <k> $PGM:Program </k>
    56	      <env> .Map </env>
    57	      <functions> .Map </functions>
    58	      <stack> .List </stack>
    59	    </T>
    60	
    61	  // Runtime data kept outside the translated language.
    62	  syntax Fun ::= function1(String, Stmts)
    63	               | function2(String, String, Stmts)
    64	  syntax Frame ::= frame(K, Map)
    65	
    66	  syntax KItem ::= exec(Stmts)
    67	                 | "cleanup"
    68	                 | forStart(String, Stmts)
    69	                 | forLoop(String, List, Stmts)
    70	                 | whileTest(Expr, Stmts)
    71	                 | ifTest(Stmts, Stmts)
    72	                 | compareLeft(String, Expr)
    73	                 | compareRight(String, Val)
    74	                 | call1(String)
    75	                 | callArg1(String, Expr)
    76	                 | callArg2(String, Val)
    77	                 | invoke1(String, Val)
    78	                 | invoke2(String, Val, Val)
    79	
    80	  // Rational helpers reduce after every operation to keep execution compact.
    81	  syntax Int ::= gcdInt(Int, Int) [function, total]
    82	  rule gcdInt(A, 0) => absInt(A) [simplification]
    83	  rule gcdInt(A, B) => gcdInt(B, A modInt B)
    84	    requires B =/=Int 0 [simplification]
    85	
    86	  syntax Val ::= makeRat(Int, Int) [function, total]
    87	               | addRat(Val, Val) [function, total]
    88	               | subRat(Val, Val) [function, total]
    89	               | mulRat(Val, Val) [function, total]
    90	               | divRat(Val, Val) [function, total]
    91	               | negRat(Val) [function, total]
    92	
    93	  rule makeRat(0, D) => rat(0, 1)
    94	    requires D =/=Int 0 [simplification]
    95	  rule makeRat(N, D) => makeRat(0 -Int N, 0 -Int D)
    96	    requires D <Int 0 [simplification]
    97	  rule makeRat(N, D)
    98	    => rat(N divInt gcdInt(absInt(N), D), D divInt gcdInt(absInt(N), D))
    99	    requires N =/=Int 0 andBool D >Int 0 [simplification]
   100	
   101	  rule addRat(rat(A, B), rat(C, D))
   102	    => makeRat(A *Int D +Int C *Int B, B *Int D) [simplification]
   103	  rule subRat(rat(A, B), rat(C, D))
   104	    => makeRat(A *Int D -Int C *Int B, B *Int D) [simplification]
   105	  rule mulRat(rat(A, B), rat(C, D))
   106	    => makeRat(A *Int C, B *Int D) [simplification]
   107	  rule divRat(rat(A, B), rat(C, D))
   108	    => makeRat(A *Int D, B *Int C)
   109	    requires C =/=Int 0 [simplification]
   110	  rule negRat(rat(A, B)) => rat(0 -Int A, B) [simplification]
   111	
   112	  // Module loading, execution of statement lists, and cleanup.
   113	  rule <k> Module(SS) ;; E => exec(SS) ~> E ~> cleanup ...</k>
   114	  rule exec(.Stmts) => .K
   115	  rule exec(S SS) => S ~> exec(SS)
   116	
   117	  rule <k> V:Val ~> cleanup => V ...</k>
   118	       <env> _ => .Map </env>
   119	       <functions> _ => .Map </functions>
   120	       <stack> .List </stack>
   121	
   122	  // Function definitions are immutable for this translated program.
   123	  rule <k> FuncDef(F, Params(P), BODY) => .K ...</k>
   124	       <functions> M => M [ F <- function1(P, BODY) ] </functions>
   125	  rule <k> FuncDef(F, Params(P1, P2), BODY) => .K ...</k>
   126	       <functions> M => M [ F <- function2(P1, P2, BODY) ] </functions>
   127	
   128	  // Variables and primitive expressions.
   129	  rule <k> Int(I) => rat(I, 1) ...</k>
   130	  rule <k> Name(X) => V ...</k>
   131	       <env>... X |-> V:Val ...</env>
   132	
   133	  rule UnaryOp("-", V:Val) => negRat(V)
   134	  rule BinOp("+", A:Val, B:Val) => addRat(A, B)
   135	  rule BinOp("-", A:Val, B:Val) => subRat(A, B)
   136	  rule BinOp("*", A:Val, B:Val) => mulRat(A, B)
   137	  rule BinOp("/", A:Val, B:Val) => divRat(A, B)
   138	
   139	  context UnaryOp(_, HOLE)
   140	  context BinOp(_, HOLE, _)
   141	  context BinOp(_, _V:Val, HOLE)
   142	
   143	  // The generated program uses single comparisons, kept faithful to the AST.
   144	  rule Compare(E, CmpOp(OP, R)) => E ~> compareLeft(OP, R)
   145	  rule V:Val ~> compareLeft(OP, R) => R ~> compareRight(OP, V)
   146	  rule rat(B, DB) ~> compareRight(">", rat(A, DA))
   147	    => bool(A *Int DB >Int B *Int DA)
   148	
   149	  // Assignment and structured control flow.
   150	  rule <k> Assign(Name(X), V:Val) => .K ...</k>
   151	       <env> RHO => RHO [ X <- V ] </env>
   152	
   153	  rule For(Name(X), E, BODY) => E ~> forStart(X, BODY)
   154	  rule list(L) ~> forStart(X, BODY) => forLoop(X, L, BODY)
   155	  rule forLoop(_X, .List, _BODY) => .K
   156	  rule forLoop(X, ListItem(V:Val) REST, BODY)
   157	    => Assign(Name(X), V) ~> exec(BODY) ~> forLoop(X, REST, BODY)
   158	
   159	  rule While(COND, BODY) => COND ~> whileTest(COND, BODY)
   160	  rule bool(true) ~> whileTest(COND, BODY)
   161	    => exec(BODY) ~> While(COND, BODY)
   162	  rule bool(false) ~> whileTest(_COND, _BODY) => .K
   163	
   164	  rule If(COND, YES, NO) => COND ~> ifTest(YES, NO)
   165	  rule bool(true) ~> ifTest(YES, _NO) => exec(YES)
   166	  rule bool(false) ~> ifTest(_YES, NO) => exec(NO)
   167	
   168	  // Evaluate call arguments left-to-right before changing the local frame.
   169	  rule Call(Name(F), E) => E ~> call1(F)
   170	  rule V:Val ~> call1(F) => invoke1(F, V)
   171	  rule Call(Name(F), E1, E2) => E1 ~> callArg1(F, E2)
   172	  rule V:Val ~> callArg1(F, E2) => E2 ~> callArg2(F, V)
   173	  rule V2:Val ~> callArg2(F, V1) => invoke2(F, V1, V2)
   174	  rule Invoke(F, V) => invoke1(F, V)
   175	
   176	  rule <k> invoke1(F, V) ~> CALLER => exec(BODY) </k>
   177	       <env> RHO => P |-> V </env>
   178	       <functions>... F |-> function1(P, BODY) ...</functions>
   179	       <stack> S => ListItem(frame(CALLER, RHO)) S </stack>
   180	
   181	  rule <k> invoke2(F, V1, V2) ~> CALLER => exec(BODY) </k>
   182	       <env> RHO => P1 |-> V1 P2 |-> V2 </env>
   183	       <functions>... F |-> function2(P1, P2, BODY) ...</functions>
   184	       <stack> S => ListItem(frame(CALLER, RHO)) S </stack>
   185	
   186	  // Return abandons the rest of the callee and resumes its saved continuation.
   187	  rule <k> Return(V:Val) ~> _CURRENT => V ~> CALLER </k>
   188	       <env> _ => RHO </env>
   189	       <stack> ListItem(frame(CALLER, RHO)) S => S </stack>
   190	endmodule

diff --git a/evidence/provenance_audit.py b/evidence/provenance_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..c1ab2e32dbf05401cd80d220dba21424a97b90fc
--- /dev/null
+++ b/evidence/provenance_audit.py
@@ -0,0 +1,237 @@
+#!/usr/bin/env python3
+"""Independent, read-only integrity checks for the mounted audit inputs."""
+
+from __future__ import annotations
+
+from collections import Counter
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+AUDIT_LOCK = Path("/audit-campaign-lock.json")
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def pipeline_tree_digest(root: Path) -> str:
+    """Reimplement the pipeline-v2 tree digest over names, types, sizes, bytes."""
+    root = root.resolve(strict=True)
+    digest = hashlib.sha256()
+    pending = [root]
+    entries: list[tuple[str, str, Path]] = []
+    while pending:
+        directory = pending.pop()
+        for child in os.scandir(directory):
+            mode = child.stat(follow_symlinks=False).st_mode
+            path = Path(child.path)
+            relative = path.relative_to(root).as_posix()
+            if stat.S_ISDIR(mode):
+                entries.append((relative, "directory", path))
+                pending.append(path)
+            elif stat.S_ISREG(mode):
+                entries.append((relative, "file", path))
+            else:
+                raise RuntimeError(f"linked/unsupported tree entry: {path}")
+    for relative, kind, path in sorted(entries):
+        encoded = relative.encode()
+        digest.update(len(encoded).to_bytes(4, "big"))
+        digest.update(encoded)
+        digest.update(kind.encode() + b"\0")
+        if kind == "file":
+            size = path.stat(follow_symlinks=False).st_size
+            digest.update(size.to_bytes(8, "big"))
+            with path.open("rb") as stream:
+                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                    digest.update(chunk)
+    return digest.hexdigest()
+
+
+def require_regular(path: Path) -> None:
+    mode = path.lstat().st_mode
+    if not stat.S_ISREG(mode):
+        raise RuntimeError(f"not a real regular file: {path}")
+
+
+def require_directory(path: Path) -> None:
+    mode = path.lstat().st_mode
+    if not stat.S_ISDIR(mode):
+        raise RuntimeError(f"not a real directory: {path}")
+
+
+audit_input = json.loads(AUDIT_INPUT.read_text(encoding="utf-8"))
+lock = json.loads(AUDIT_LOCK.read_text(encoding="utf-8"))
+result = json.loads(Path("/generation-result.json").read_text(encoding="utf-8"))
+invocation = json.loads(
+    Path("/generation-evidence/invocation.json").read_text(encoding="utf-8")
+)
+usage = json.loads(
+    Path("/generation-evidence/usage.json").read_text(encoding="utf-8")
+)
+
+print(f"record_layout={audit_input['record_layout']}")
+print(f"semantics_mode={audit_input['semantics_mode']}")
+assert audit_input["record_layout"] == "legacy-selected-stage1"
+assert audit_input["semantics_mode"] == "GENERATED_SEMANTICS"
+
+required_files = [
+    Path("/audit-input.json"),
+    Path("/audit-campaign-lock.json"),
+    Path("/run.json"),
+    Path("/task.json"),
+    Path("/generation-result.json"),
+    Path("/reference/canonical.py"),
+    Path("/reference/prompt.py"),
+    Path("/reference/py2mpy.py"),
+    Path("/generation-evidence/invocation.json"),
+    Path("/generation-evidence/metrics.json"),
+    Path("/generation-evidence/codex-last.txt"),
+    Path("/generation-evidence/codex-output.log"),
+    Path("/generation-evidence/prompt.txt"),
+]
+required_directories = [
+    Path("/candidate"),
+    Path("/generation-evidence"),
+    Path("/generation-evidence/codex-trace"),
+]
+for path in required_files:
+    require_regular(path)
+for path in required_directories:
+    require_directory(path)
+print(f"required_real_files={len(required_files)} OK")
+print(f"required_real_directories={len(required_directories)} OK")
+
+assert audit_input["audit_campaign"] == lock
+assert (
+    sha256_file(AUDIT_LOCK)
+    == audit_input["hashes"]["audit_campaign_lock_sha256"]
+)
+print("campaign_block_equals_lock=true")
+print("campaign_lock_hash_matches=true")
+
+direct_hashes = {
+    "/audit-campaign-lock.json": "audit_campaign_lock_sha256",
+    "/candidate/prompt.py": "candidate_prompt_sha256",
+    "/candidate/py2mpy.py": "candidate_translator_sha256",
+    "/reference/canonical.py": "canonical_sha256",
+    "/reference/prompt.py": "trusted_prompt_sha256",
+    "/reference/py2mpy.py": "trusted_translator_sha256",
+    "/run.json": "run_manifest_sha256",
+    "/task.json": "task_manifest_sha256",
+    "/generation-result.json": "stage1_result_sha256",
+    "/generation-evidence/invocation.json": "stage1_invocation_sha256",
+    "/generation-evidence/metrics.json": "generation_metrics_sha256",
+    "/generation-evidence/usage.json": "generation_usage_sha256",
+    "/generation-evidence/codex-last.txt": "generation_codex_last_sha256",
+    "/generation-evidence/codex-output.log": "generation_codex_output_sha256",
+    "/generation-evidence/prompt.txt": "generation_prompt_sha256",
+}
+for path_text, key in direct_hashes.items():
+    actual = sha256_file(Path(path_text))
+    expected = audit_input["hashes"][key]
+    assert actual == expected, (path_text, actual, expected)
+    print(f"hash OK {key}={actual}")
+
+assert Path("/candidate/prompt.py").read_bytes() == Path(
+    "/reference/prompt.py"
+).read_bytes()
+assert Path("/candidate/py2mpy.py").read_bytes() == Path(
+    "/reference/py2mpy.py"
+).read_bytes()
+assert not Path("/reference/reference-semantics").exists()
+print("candidate_prompt_byte_identical=true")
+print("candidate_translator_byte_identical=true")
+print("trusted_reference_semantics_absent=true")
+
+for root in (Path("/candidate"), Path("/generation-evidence")):
+    for path in root.rglob("*"):
+        mode = path.lstat().st_mode
+        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
+            raise RuntimeError(f"linked/unsupported entry: {path}")
+print("candidate_and_generation_trees_have_only_real_files_and_directories=true")
+
+candidate_digest = pipeline_tree_digest(Path("/candidate"))
+expected_workspace = result["outputs"]["workspace_sha256"]
+assert candidate_digest == expected_workspace
+assert candidate_digest == invocation["retained_workspace_sha256"]
+print(f"candidate_pipeline_tree_digest={candidate_digest}")
+print("candidate_tree_matches_generation_workspace=true")
+print(
+    "audit_input_candidate_tree_record="
+    + audit_input["hashes"]["candidate_tree_sha256"]
+    + " (launcher-specific aggregate; all mounted files are independently hashed above)"
+)
+
+trace_root = Path("/generation-evidence/codex-trace")
+trace_digest = pipeline_tree_digest(trace_root)
+assert trace_digest == usage["source_trace_sha256"]
+print(f"trace_pipeline_tree_digest={trace_digest}")
+print("trace_tree_matches_usage_source_trace=true")
+
+evidence_hashes = result["outputs"]["evidence"]
+for relative, expected in sorted(evidence_hashes.items()):
+    path = Path("/generation-evidence") / relative
+    require_regular(path)
+    actual = sha256_file(path)
+    assert actual == expected, (relative, actual, expected)
+    print(f"result-evidence-hash OK {relative}={actual}")
+
+json_records = [
+    "/run.json",
+    "/task.json",
+    "/generation-result.json",
+    "/generation-evidence/invocation.json",
+    "/generation-evidence/metrics.json",
+    "/generation-evidence/usage.json",
+]
+for path_text in json_records:
+    document = json.loads(Path(path_text).read_text(encoding="utf-8"))
+    print(
+        f"json-read OK {path_text} keys={','.join(sorted(document.keys()))}"
+    )
+
+trace_files = sorted(trace_root.rglob("*.jsonl"))
+assert trace_files
+outer_types: Counter[str] = Counter()
+payload_types: Counter[str] = Counter()
+roles: Counter[str] = Counter()
+trace_lines = 0
+for trace_file in trace_files:
+    with trace_file.open(encoding="utf-8") as stream:
+        for line_number, line in enumerate(stream, 1):
+            record = json.loads(line)
+            trace_lines += 1
