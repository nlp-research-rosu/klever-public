+        "candidate": str(CANDIDATE_PATH),
+        "seed": 320032,
+        "case_count": len(cases),
+        "intended_domain": (
+            "nonempty even-length numeric coefficient lists with a nonzero "
+            "highest-degree (last) coefficient"
+        ),
