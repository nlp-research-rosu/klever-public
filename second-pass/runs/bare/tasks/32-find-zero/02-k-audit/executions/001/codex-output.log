     8	def poly(xs: list, x: float):
     9	    """
    10	    Evaluates polynomial with coefficients xs at point x.
    11	    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n
    12	    """
    13	    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])
