on]\n446:  rule K1 in_keys(M [ K2 <- _ ]) => true requires K1 ==K K2 orBool K1 in_keys(M) [simplification]\n447:  rule K1 in_keys(M [ K2 <- _ ]) => K1 in_keys(M) requires K1 =/=K K2 [simplification]\n449:  rule {false #Equals @Key in_keys(.Map)} => #Ceil(@Key) [simplification]\n450:  rule {@Key in_keys(.Map) #Equals false} => #Ceil(@Key) [simplification]\n451:  rule {false #Equals @Key in_keys(Key' |-> Val @M)} => #Ceil(@Key) #And #Ceil(Key' |-> Val @M) #And #Not({@Key #Equals Key'}) #And {false #Equals @Key in_keys(@M)} [simplification]\n452:  rule {@Key in_keys(Key' |-> Val @M) #Equals false} => #Ceil(@Key) #And #Ceil(Key' |-> Val @M) #And #Not({@Key #Equals Key'}) #And {@Key in_keys(@M) #Equals false} [simplification]\n458:  rule #Ceil(@M:Map (@K:KItem |-> @V:KItem)) => {(@K in_keys(@M)) #Equals false} #And #Ceil(@M) #And #Ceil(@K) #And #Ceil(@V)\n569:  syntax RangeMap ::= RangeMap \"[\" keyRange: Range \"<-\" value: KItem \"]\"           [function, symbol(RangeMap:update), hook(RANGEMAP.updateRng), prefer]\n579:  syntax RangeMap ::= RangeMap \"[\" Range \"<-\" \"undef\" \"]\"     [function, hook(RANGEMAP.removeRng), symbol(_r[_<-undef])]\n643:  syntax Bool ::= KItem \"in_keys\" \"(\" RangeMap \")\"       [function, total, hook(RANGEMAP.in_keys)]\n978:  syntax List ::= List \"[\" index: Int \"<-\" value: KItem \"]\" [function, hook(LIST.update), symbol(List:set)]\n979:  syntax {Width} List ::= List \"[\" index: MInt{Width} \"<-\" value: KItem \"]\" [function, hook(LIST.updateMInt), symbol(List:setMInt)]\n2108:  syntax Bytes ::= Bytes \"[\" index: Int \"<-\" value: Int \"]\" [function, hook(BYTES.update)]\n2109:  syntax {Width} Bytes ::= Bytes \"[\" index: MInt{Width} \"<-\" value: MInt{Width} \"]\" [function, hook(BYTES.updateMInt)]\n", "type": "input_text"}], "type": "custom_tool_call_output"}

