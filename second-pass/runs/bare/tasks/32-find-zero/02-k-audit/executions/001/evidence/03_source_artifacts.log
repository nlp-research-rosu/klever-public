    12	def find_zero(xs: list):
    13	    """ xs are coefficients of a polynomial.
    14	    find_zero find x such that poly(x) = 0.
    15	    find_zero returns only only zero point, even if there are many.
    16	    Moreover, find_zero only takes list xs having even number of coefficients
    17	    and largest non zero coefficient as it guarantees
    18	    a solution.
    19	    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x
    20	    -0.5
    21	    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3
    22	    1.0
    23	    """

