    23	    <k>
    24	      solution ;;
    25	      VerifyRoot(
    26	        ListItem(rat(-6, 1)) ListItem(rat(11, 1))
    27	          ListItem(rat(-6, 1)) ListItem(rat(1, 1)),
    28	        Invoke("find_zero", list(
