     1	def evaluate_polynomial(xs: list, x):
     2	    value = 0
     3	    power = 1
     4	    for coefficient in xs:
     5	        value = value + coefficient * power
     6	        power = power * x
     7	    return value
     8	
     9	
    10	def find_zero(xs: list):
    11	    left = -1
    12	    right = 1
    13	
    14	    while evaluate_polynomial(xs, left) * evaluate_polynomial(xs, right) > 0:
    15	        left = left * 2
    16	        right = right * 2
    17	
    18	    while right - left > 1 / 10000000000:
    19	        middle = (left + right) / 2
    20	        if evaluate_polynomial(xs, middle) * evaluate_polynomial(xs, left) > 0:
    21	            left = middle
    22	        else:
    23	            right = middle
    24	
    25	    return (left + right) / 2

FILE /candidate/solution.mpy
     1	Module(
     2	  FuncDef("evaluate_polynomial", Params("xs", "x"),
     3	    Assign(Name("value"), Int(0))
     4	    Assign(Name("power"), Int(1))
     5	    For(Name("coefficient"), Name("xs"),
     6	      Assign(
     7	        Name("value"),
     8	        BinOp(
     9	          "+",
    10	          Name("value"),
    11	          BinOp("*", Name("coefficient"), Name("power"))))
    12	      Assign(Name("power"), BinOp("*", Name("power"), Name("x"))))
    13	    Return(Name("value")))
    14	  FuncDef("find_zero", Params("xs"),
    15	    Assign(Name("left"), UnaryOp("-", Int(1)))
    16	    Assign(Name("right"), Int(1))
    17	    While(Compare(
    18	      BinOp(
    19	        "*",
    20	        Call(Name("evaluate_polynomial"), Name("xs"), Name("left")),
    21	        Call(Name("evaluate_polynomial"), Name("xs"), Name("right"))),
    22	      CmpOp(">", Int(0))),
    23	      Assign(Name("left"), BinOp("*", Name("left"), Int(2)))
    24	      Assign(Name("right"), BinOp("*", Name("right"), Int(2))))
    25	    While(Compare(
    26	      BinOp("-", Name("right"), Name("left")),
    27	      CmpOp(">", BinOp("/", Int(1), Int(10000000000)))),
    28	      Assign(
    29	        Name("middle"),
    30	        BinOp("/", BinOp("+", Name("left"), Name("right")), Int(2)))
    31	      If(Compare(
    32	        BinOp(
    33	          "*",
    34	          Call(Name("evaluate_polynomial"), Name("xs"), Name("middle")),
    35	          Call(Name("evaluate_polynomial"), Name("xs"), Name("left"))),
    36	        CmpOp(">", Int(0))),
    37	        Assign(Name("left"), Name("middle")),
    38	        Assign(Name("right"), Name("middle"))))
    39	    Return(BinOp("/", BinOp("+", Name("left"), Name("right")), Int(2)))))

FILE /candidate/semantic.k
     1	requires "domains.md"
     2	
     3	module SEMANTIC-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports BOOL-SYNTAX
     6	  imports STRING-SYNTAX
     7	  imports MAP
     8	  imports LIST
     9	
    10	  syntax Strings ::= List{String, ","}
    11	  syntax Params ::= "Params" "(" Strings ")"
    12	
    13	  syntax Exprs ::= List{Expr, ","}
    14	  syntax Expr ::= "Int" "(" Int ")"
    15	                | "Name" "(" String ")"
    16	                | "UnaryOp" "(" String "," Expr ")"
    17	                | "BinOp" "(" String "," Expr "," Expr ")"
    18	                | "Compare" "(" Expr "," CmpOp ")"
    19	                | "Call" "(" Expr "," Expr ")"
    20	                | "Call" "(" Expr "," Expr "," Expr ")"
    21	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    22	
    23	  syntax Stmts ::= List{Stmt, ""}
    24	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    25	                | "Assign" "(" Expr "," Expr ")" [strict(2)]
    26	                | "Return" "(" Expr ")" [strict]
    27	                | "For" "(" Expr "," Expr "," Stmts ")"
    28	                | "While" "(" Expr "," Stmts ")"
    29	                | "If" "(" Expr "," Stmts "," Stmts ")"
    30	
    31	  syntax Program ::= "Module" "(" Stmts ")"
    32	                   | Program ";;" Expr
    33	
    34	  // Values are exact rationals.  All rules maintain a positive denominator.
    35	  syntax Val ::= "rat" "(" Int "," Int ")"
    36	               | "bool" "(" Bool ")"
    37	               | "list" "(" List ")"
    38	  syntax Expr ::= Val
    39	  syntax KResult ::= Val
    40	
    41	  // A convenient external entry point used by runners and specifications.
    42	  syntax Expr ::= "Invoke" "(" String "," Val ")"
    43	endmodule
    44	
    45	module SEMANTIC
    46	  imports SEMANTIC-SYNTAX
    47	  imports INT
    48	  imports BOOL
    49	  imports STRING
    50	  imports MAP
    51	  imports LIST
    52	
    53	  configuration
    54	    <T>
    55	      <k> $PGM:Program </k>
    56	      <env> .Map </env>
    57	      <functions> .Map </functions>
    58	      <stack> .List </stack>
    59	    </T>
    60	
    61	  // Runtime data kept outside the translated language.
    62	  syntax Fun ::= function1(String, Stmts)
    63	               | function2(String, String, Stmts)
    64	  syntax Frame ::= frame(K, Map)
    65	
    66	  syntax KItem ::= exec(Stmts)
    67	                 | "cleanup"
    68	                 | forStart(String, Stmts)
    69	                 | forLoop(String, List, Stmts)
    70	                 | whileTest(Expr, Stmts)
    71	                 | ifTest(Stmts, Stmts)
    72	                 | compareLeft(String, Expr)
    73	                 | compareRight(String, Val)
    74	                 | call1(String)
    75	                 | callArg1(String, Expr)
    76	                 | callArg2(String, Val)
    77	                 | invoke1(String, Val)
    78	                 | invoke2(String, Val, Val)
    79	
    80	  // Rational helpers reduce after every operation to keep execution compact.
    81	  syntax Int ::= gcdInt(Int, Int) [function, total]
    82	  rule gcdInt(A, 0) => absInt(A) [simplification]
    83	  rule gcdInt(A, B) => gcdInt(B, A modInt B)
    84	    requires B =/=Int 0 [simplification]
    85	
    86	  syntax Val ::= makeRat(Int, Int) [function, total]
    87	               | addRat(Val, Val) [function, total]
    88	               | subRat(Val, Val) [function, total]
    89	               | mulRat(Val, Val) [function, total]
    90	               | divRat(Val, Val) [function, total]
    91	               | negRat(Val) [function, total]
    92	
    93	  rule makeRat(0, D) => rat(0, 1)
    94	    requires D =/=Int 0 [simplification]
    95	  rule makeRat(N, D) => makeRat(0 -Int N, 0 -Int D)
    96	    requires D <Int 0 [simplification]
    97	  rule makeRat(N, D)
    98	    => rat(N divInt gcdInt(absInt(N), D), D divInt gcdInt(absInt(N), D))
    99	    requires N =/=Int 0 andBool D >Int 0 [simplification]
   100	
   101	  rule addRat(rat(A, B), rat(C, D))
   102	    => makeRat(A *Int D +Int C *Int B, B *Int D) [simplification]
   103	  rule subRat(rat(A, B), rat(C, D))
   104	    => makeRat(A *Int D -Int C *Int B, B *Int D) [simplification]
   105	  rule mulRat(rat(A, B), rat(C, D))
   106	    => makeRat(A *Int C, B *Int D) [simplification]
   107	  rule divRat(rat(A, B), rat(C, D))
   108	    => makeRat(A *Int D, B *Int C)
   109	    requires C =/=Int 0 [simplification]
   110	  rule negRat(rat(A, B)) => rat(0 -Int A, B) [simplification]
   111	
   112	  // Module loading, execution of statement lists, and cleanup.
   113	  rule <k> Module(SS) ;; E => exec(SS) ~> E ~> cleanup ...</k>
   114	  rule exec(.Stmts) => .K
   115	  rule exec(S SS) => S ~> exec(SS)
   116	
   117	  rule <k> V:Val ~> cleanup => V ...</k>
   118	       <env> _ => .Map </env>
   119	       <functions> _ => .Map </functions>
   120	       <stack> .List </stack>
   121	
   122	  // Function definitions are immutable for this translated program.
   123	  rule <k> FuncDef(F, Params(P), BODY) => .K ...</k>
   124	       <functions> M => M [ F <- function1(P, BODY) ] </functions>
   125	  rule <k> FuncDef(F, Params(P1, P2), BODY) => .K ...</k>
   126	       <functions> M => M [ F <- function2(P1, P2, BODY) ] </functions>
   127	
   128	  // Variables and primitive expressions.
   129	  rule <k> Int(I) => rat(I, 1) ...</k>
   130	  rule <k> Name(X) => V ...</k>
   131	       <env>... X |-> V:Val ...</env>
   132	
   133	  rule UnaryOp("-", V:Val) => negRat(V)
   134	  rule BinOp("+", A:Val, B:Val) => addRat(A, B)
   135	  rule BinOp("-", A:Val, B:Val) => subRat(A, B)
   136	  rule BinOp("*", A:Val, B:Val) => mulRat(A, B)
   137	  rule BinOp("/", A:Val, B:Val) => divRat(A, B)
   138	
   139	  context UnaryOp(_, HOLE)
   140	  context BinOp(_, HOLE, _)
   141	  context BinOp(_, _V:Val, HOLE)
   142	
   143	  // The generated program uses single comparisons, kept faithful to the AST.
   144	  rule Compare(E, CmpOp(OP, R)) => E ~> compareLeft(OP, R)
   145	  rule V:Val ~> compareLeft(OP, R) => R ~> compareRight(OP, V)
   146	  rule rat(B, DB) ~> compareRight(">", rat(A, DA))
   147	    => bool(A *Int DB >Int B *Int DA)
   148	
   149	  // Assignment and structured control flow.
   150	  rule <k> Assign(Name(X), V:Val) => .K ...</k>
   151	       <env> RHO => RHO [ X <- V ] </env>
   152	
   153	  rule For(Name(X), E, BODY) => E ~> forStart(X, BODY)
   154	  rule list(L) ~> forStart(X, BODY) => forLoop(X, L, BODY)
   155	  rule forLoop(_X, .List, _BODY) => .K
   156	  rule forLoop(X, ListItem(V:Val) REST, BODY)
   157	    => Assign(Name(X), V) ~> exec(BODY) ~> forLoop(X, REST, BODY)
   158	
   159	  rule While(COND, BODY) => COND ~> whileTest(COND, BODY)
   160	  rule bool(true) ~> whileTest(COND, BODY)
   161	    => exec(BODY) ~> While(COND, BODY)
   162	  rule bool(false) ~> whileTest(_COND, _BODY) => .K
   163	
   164	  rule If(COND, YES, NO) => COND ~> ifTest(YES, NO)
   165	  rule bool(true) ~> ifTest(YES, _NO) => exec(YES)
   166	  rule bool(false) ~> ifTest(_YES, NO) => exec(NO)
   167	
   168	  // Evaluate call arguments left-to-right before changing the local frame.
   169	  rule Call(Name(F), E) => E ~> call1(F)
   170	  rule V:Val ~> call1(F) => invoke1(F, V)
   171	  rule Call(Name(F), E1, E2) => E1 ~> callArg1(F, E2)
   172	  rule V:Val ~> callArg1(F, E2) => E2 ~> callArg2(F, V)
   173	  rule V2:Val ~> callArg2(F, V1) => invoke2(F, V1, V2)
   174	  rule Invoke(F, V) => invoke1(F, V)
   175	
   176	  rule <k> invoke1(F, V) ~> CALLER => exec(BODY) </k>
   177	       <env> RHO => P |-> V </env>
   178	       <functions>... F |-> function1(P, BODY) ...</functions>
   179	       <stack> S => ListItem(frame(CALLER, RHO)) S </stack>
   180	
   181	  rule <k> invoke2(F, V1, V2) ~> CALLER => exec(BODY) </k>
   182	       <env> RHO => P1 |-> V1 P2 |-> V2 </env>
   183	       <functions>... F |-> function2(P1, P2, BODY) ...</functions>
   184	       <stack> S => ListItem(frame(CALLER, RHO)) S </stack>
   185	
   186	  // Return abandons the rest of the callee and resumes its saved continuation.
   187	  rule <k> Return(V:Val) ~> _CURRENT => V ~> CALLER </k>
   188	       <env> _ => RHO </env>
   189	       <stack> ListItem(frame(CALLER, RHO)) S => S </stack>
   190	endmodule

FILE /candidate/verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // This constant is the exact constructor tree emitted in solution.mpy.
     7	  // Keeping it as a macro lets both krun and kprove execute the submitted AST.
     8	  syntax Program ::= "solution" [macro]
     9	  rule solution =>
    10	    Module(
    11	      FuncDef("evaluate_polynomial", Params("xs", "x"),
    12	        Assign(Name("value"), Int(0))
    13	        Assign(Name("power"), Int(1))
    14	        For(Name("coefficient"), Name("xs"),
    15	          Assign(
    16	            Name("value"),
    17	            BinOp(
    18	              "+",
    19	              Name("value"),
    20	              BinOp("*", Name("coefficient"), Name("power"))))
    21	          Assign(Name("power"), BinOp("*", Name("power"), Name("x"))))
    22	        Return(Name("value")))
    23	      FuncDef("find_zero", Params("xs"),
    24	        Assign(Name("left"), UnaryOp("-", Int(1)))
    25	        Assign(Name("right"), Int(1))
    26	        While(Compare(
    27	          BinOp(
    28	            "*",
    29	            Call(Name("evaluate_polynomial"), Name("xs"), Name("left")),
    30	            Call(Name("evaluate_polynomial"), Name("xs"), Name("right"))),
    31	          CmpOp(">", Int(0))),
    32	          Assign(Name("left"), BinOp("*", Name("left"), Int(2)))
    33	          Assign(Name("right"), BinOp("*", Name("right"), Int(2))))
    34	        While(Compare(
    35	          BinOp("-", Name("right"), Name("left")),
    36	          CmpOp(">", BinOp("/", Int(1), Int(10000000000)))),
    37	          Assign(
    38	            Name("middle"),
    39	            BinOp("/", BinOp("+", Name("left"), Name("right")), Int(2)))
    40	          If(Compare(
    41	            BinOp(
    42	              "*",
    43	              Call(Name("evaluate_polynomial"), Name("xs"), Name("middle")),
    44	              Call(Name("evaluate_polynomial"), Name("xs"), Name("left"))),
    45	            CmpOp(">", Int(0))),
    46	            Assign(Name("left"), Name("middle")),
    47	            Assign(Name("right"), Name("middle"))))
    48	        Return(BinOp("/", BinOp("+", Name("left"), Name("right")), Int(2)))))
    49	
    50	  // Independent postcondition machinery.  Coefficients are in ascending order,
    51	  // so this is Horner evaluation from the head: c0 + x * (c1 + x * ...).
    52	  syntax Val ::= polyValue(List, Val) [function]
    53	               | absRat(Val) [function, total]
    54	  syntax Bool ::= leRat(Val, Val) [function, total]
    55	
    56	  rule polyValue(.List, _X) => rat(0, 1) [simplification]
    57	  rule polyValue(ListItem(C:Val) REST, X)
    58	    => addRat(C, mulRat(X, polyValue(REST, X))) [simplification]
    59	
    60	  rule absRat(rat(N, D)) => rat(0 -Int N, D)
    61	    requires N <Int 0 [simplification]
    62	  rule absRat(rat(N, D)) => rat(N, D)
    63	    requires N >=Int 0 [simplification]
    64	  rule leRat(rat(A, B), rat(C, D)) => A *Int D <=Int C *Int B
    65	    [simplification]
    66	
    67	  syntax Expr ::= "VerifyRoot" "(" List "," Expr "," Val ")" [strict(2)]
    68	  rule VerifyRoot(COEFFS, ROOT:Val, TOLERANCE)
    69	    => bool(leRat(absRat(polyValue(COEFFS, ROOT)), TOLERANCE))
    70	endmodule

