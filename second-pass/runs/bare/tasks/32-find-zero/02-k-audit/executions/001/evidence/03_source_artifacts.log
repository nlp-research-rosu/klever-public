    56	      solution ;;
    57	      VerifyRoot(
    58	        ListItem(rat(-8, 1)) ListItem(rat(0, 1))
    59	          ListItem(rat(0, 1)) ListItem(rat(1, 1)),
    60	        Invoke("find_zero", list(
    61	          ListItem(rat(-8, 1)) ListItem(rat(0, 1))
    62	            ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
