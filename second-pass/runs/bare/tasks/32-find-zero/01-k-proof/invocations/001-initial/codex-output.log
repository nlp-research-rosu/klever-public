new file mode 100644
index 0000000000000000000000000000000000000000..c8da3ea69e9f457e3bc944a87610a332d3bc0142
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,86 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Prompt example: 1 + 2x.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(1, 1)) ListItem(rat(2, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(1, 1)) ListItem(rat(2, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+
+  // Prompt example: -6 + 11x - 6x^2 + x^3.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(-6, 1)) ListItem(rat(11, 1))
+          ListItem(rat(-6, 1)) ListItem(rat(1, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(-6, 1)) ListItem(rat(11, 1))
+            ListItem(rat(-6, 1)) ListItem(rat(1, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+
+  // The root is the initial midpoint; this exercises the zero-product branch.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(0, 1)) ListItem(rat(1, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+
+  // x^3 - 8: both initial endpoint values are negative, so the bracket grows.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(-8, 1)) ListItem(rat(0, 1))
+          ListItem(rat(0, 1)) ListItem(rat(1, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(-8, 1)) ListItem(rat(0, 1))
+            ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+
+  // x^3 + 8: symmetric expansion to a negative root.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(8, 1)) ListItem(rat(0, 1))
+          ListItem(rat(0, 1)) ListItem(rat(1, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(8, 1)) ListItem(rat(0, 1))
+            ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..99137ad9e348af3f929d515ca59ca470f78d6a1e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This constant is the exact constructor tree emitted in solution.mpy.
+  // Keeping it as a macro lets both krun and kprove execute the submitted AST.
+  syntax Program ::= "solution" [macro]
+  rule solution =>
+    Module(
+      FuncDef("evaluate_polynomial", Params("xs", "x"),
+        Assign(Name("value"), Int(0))
+        Assign(Name("power"), Int(1))
+        For(Name("coefficient"), Name("xs"),
+          Assign(
+            Name("value"),
+            BinOp(
+              "+",
+              Name("value"),
+              BinOp("*", Name("coefficient"), Name("power"))))
+          Assign(Name("power"), BinOp("*", Name("power"), Name("x"))))
+        Return(Name("value")))
+      FuncDef("find_zero", Params("xs"),
+        Assign(Name("left"), UnaryOp("-", Int(1)))
+        Assign(Name("right"), Int(1))
+        While(Compare(
+          BinOp(
+            "*",
+            Call(Name("evaluate_polynomial"), Name("xs"), Name("left")),
+            Call(Name("evaluate_polynomial"), Name("xs"), Name("right"))),
+          CmpOp(">", Int(0))),
+          Assign(Name("left"), BinOp("*", Name("left"), Int(2)))
+          Assign(Name("right"), BinOp("*", Name("right"), Int(2))))
+        While(Compare(
+          BinOp("-", Name("right"), Name("left")),
+          CmpOp(">", BinOp("/", Int(1), Int(10000000000)))),
+          Assign(
+            Name("middle"),
+            BinOp("/", BinOp("+", Name("left"), Name("right")), Int(2)))
+          If(Compare(
+            BinOp(
+              "*",
+              Call(Name("evaluate_polynomial"), Name("xs"), Name("middle")),
+              Call(Name("evaluate_polynomial"), Name("xs"), Name("left"))),
+            CmpOp(">", Int(0))),
+            Assign(Name("left"), Name("middle")),
+            Assign(Name("right"), Name("middle"))))
+        Return(BinOp("/", BinOp("+", Name("left"), Name("right")), Int(2)))))
+
+  // Independent postcondition machinery.  Coefficients are in ascending order,
+  // so this is Horner evaluation from the head: c0 + x * (c1 + x * ...).
+  syntax Val ::= polyValue(List, Val) [function]
+               | absRat(Val) [function, total]
+  syntax Bool ::= leRat(Val, Val) [function, total]
+
+  rule polyValue(.List, _X) => rat(0, 1) [simplification]
+  rule polyValue(ListItem(C:Val) REST, X)
+    => addRat(C, mulRat(X, polyValue(REST, X))) [simplification]
+
+  rule absRat(rat(N, D)) => rat(0 -Int N, D)
+    requires N <Int 0 [simplification]
+  rule absRat(rat(N, D)) => rat(N, D)
+    requires N >=Int 0 [simplification]
+  rule leRat(rat(A, B), rat(C, D)) => A *Int D <=Int C *Int B
+    [simplification]
+
+  syntax Expr ::= "VerifyRoot" "(" List "," Expr "," Val ")" [strict(2)]
+  rule VerifyRoot(COEFFS, ROOT:Val, TOLERANCE)
+    => bool(leRat(absRat(polyValue(COEFFS, ROOT)), TOLERANCE))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..22c6ed7a883cfc34b658191257dc8e250cf53570
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the constructor tree from the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the standalone semantics, then the semantics plus proof utilities.
+kompile semantic.k \
+  --backend haskell \
+  --main-module SEMANTIC \
+  --syntax-module SEMANTIC-SYNTAX
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION
+
+# Exercise the actual freshly generated solution.mpy term with the prompt's
+# linear example.  The exact rational result is approximately -0.5.
+TRANSLATED_PROGRAM="$(< solution.mpy)"
+krun --definition verification-kompiled \
+  -cPGM="$TRANSLATED_PROGRAM ;; Invoke(\"find_zero\", list(ListItem(rat(1, 1)) ListItem(rat(2, 1))))" \
+  --output pretty
+
+# Exercise the second prompt example and independently check its residual.
+krun --definition verification-kompiled \
+  -cPGM="$TRANSLATED_PROGRAM ;; VerifyRoot(ListItem(rat(-6, 1)) ListItem(rat(11, 1)) ListItem(rat(-6, 1)) ListItem(rat(1, 1)), Invoke(\"find_zero\", list(ListItem(rat(-6, 1)) ListItem(rat(11, 1)) ListItem(rat(-6, 1)) ListItem(rat(1, 1)))), rat(1, 100000000))" \
+  --output pretty
+
+# This is the required positive target-proof command.  It proves every claim
+# in spec.k and must print #Top and exit zero.
+kprove spec.k \
+  --definition verification-kompiled \
+  --output pretty
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..bd957c1756db6c52c49cc5fa97ef093787a74198
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,190 @@
+requires "domains.md"
+
+module SEMANTIC-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+  imports LIST
+
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")" [strict(2)]
+                | "Return" "(" Expr ")" [strict]
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Program ::= "Module" "(" Stmts ")"
+                   | Program ";;" Expr
+
+  // Values are exact rationals.  All rules maintain a positive denominator.
+  syntax Val ::= "rat" "(" Int "," Int ")"
+               | "bool" "(" Bool ")"
+               | "list" "(" List ")"
+  syntax Expr ::= Val
+  syntax KResult ::= Val
+
+  // A convenient external entry point used by runners and specifications.
+  syntax Expr ::= "Invoke" "(" String "," Val ")"
+endmodule
+
+module SEMANTIC
+  imports SEMANTIC-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <T>
+      <k> $PGM:Program </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <stack> .List </stack>
+    </T>
+
+  // Runtime data kept outside the translated language.
+  syntax Fun ::= function1(String, Stmts)
+               | function2(String, String, Stmts)
+  syntax Frame ::= frame(K, Map)
+
+  syntax KItem ::= exec(Stmts)
+                 | "cleanup"
+                 | forStart(String, Stmts)
+                 | forLoop(String, List, Stmts)
+                 | whileTest(Expr, Stmts)
+                 | ifTest(Stmts, Stmts)
+                 | compareLeft(String, Expr)
+                 | compareRight(String, Val)
+                 | call1(String)
+                 | callArg1(String, Expr)
+                 | callArg2(String, Val)
+                 | invoke1(String, Val)
+                 | invoke2(String, Val, Val)
+
+  // Rational helpers reduce after every operation to keep execution compact.
+  syntax Int ::= gcdInt(Int, Int) [function, total]
+  rule gcdInt(A, 0) => absInt(A) [simplification]
+  rule gcdInt(A, B) => gcdInt(B, A modInt B)
+    requires B =/=Int 0 [simplification]
+
+  syntax Val ::= makeRat(Int, Int) [function, total]
+               | addRat(Val, Val) [function, total]
+               | subRat(Val, Val) [function, total]
+               | mulRat(Val, Val) [function, total]
+               | divRat(Val, Val) [function, total]
+               | negRat(Val) [function, total]
+
+  rule makeRat(0, D) => rat(0, 1)
+    requires D =/=Int 0 [simplification]
+  rule makeRat(N, D) => makeRat(0 -Int N, 0 -Int D)
+    requires D <Int 0 [simplification]
+  rule makeRat(N, D)
+    => rat(N divInt gcdInt(absInt(N), D), D divInt gcdInt(absInt(N), D))
+    requires N =/=Int 0 andBool D >Int 0 [simplification]
+
+  rule addRat(rat(A, B), rat(C, D))
+    => makeRat(A *Int D +Int C *Int B, B *Int D) [simplification]
+  rule subRat(rat(A, B), rat(C, D))
+    => makeRat(A *Int D -Int C *Int B, B *Int D) [simplification]
+  rule mulRat(rat(A, B), rat(C, D))
+    => makeRat(A *Int C, B *Int D) [simplification]
+  rule divRat(rat(A, B), rat(C, D))
+    => makeRat(A *Int D, B *Int C)
+    requires C =/=Int 0 [simplification]
+  rule negRat(rat(A, B)) => rat(0 -Int A, B) [simplification]
+
+  // Module loading, execution of statement lists, and cleanup.
+  rule <k> Module(SS) ;; E => exec(SS) ~> E ~> cleanup ...</k>
+  rule exec(.Stmts) => .K
+  rule exec(S SS) => S ~> exec(SS)
+
+  rule <k> V:Val ~> cleanup => V ...</k>
+       <env> _ => .Map </env>
+       <functions> _ => .Map </functions>
+       <stack> .List </stack>
+
+  // Function definitions are immutable for this translated program.
+  rule <k> FuncDef(F, Params(P), BODY) => .K ...</k>
+       <functions> M => M [ F <- function1(P, BODY) ] </functions>
+  rule <k> FuncDef(F, Params(P1, P2), BODY) => .K ...</k>
+       <functions> M => M [ F <- function2(P1, P2, BODY) ] </functions>
+
+  // Variables and primitive expressions.
+  rule <k> Int(I) => rat(I, 1) ...</k>
+  rule <k> Name(X) => V ...</k>
+       <env>... X |-> V:Val ...</env>
+
+  rule UnaryOp("-", V:Val) => negRat(V)
+  rule BinOp("+", A:Val, B:Val) => addRat(A, B)
+  rule BinOp("-", A:Val, B:Val) => subRat(A, B)
+  rule BinOp("*", A:Val, B:Val) => mulRat(A, B)
+  rule BinOp("/", A:Val, B:Val) => divRat(A, B)
+
+  context UnaryOp(_, HOLE)
+  context BinOp(_, HOLE, _)
+  context BinOp(_, _V:Val, HOLE)
+
+  // The generated program uses single comparisons, kept faithful to the AST.
+  rule Compare(E, CmpOp(OP, R)) => E ~> compareLeft(OP, R)
+  rule V:Val ~> compareLeft(OP, R) => R ~> compareRight(OP, V)
+  rule rat(B, DB) ~> compareRight(">", rat(A, DA))
+    => bool(A *Int DB >Int B *Int DA)
+
+  // Assignment and structured control flow.
+  rule <k> Assign(Name(X), V:Val) => .K ...</k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule For(Name(X), E, BODY) => E ~> forStart(X, BODY)
+  rule list(L) ~> forStart(X, BODY) => forLoop(X, L, BODY)
+  rule forLoop(_X, .List, _BODY) => .K
+  rule forLoop(X, ListItem(V:Val) REST, BODY)
+    => Assign(Name(X), V) ~> exec(BODY) ~> forLoop(X, REST, BODY)
+
+  rule While(COND, BODY) => COND ~> whileTest(COND, BODY)
+  rule bool(true) ~> whileTest(COND, BODY)
+    => exec(BODY) ~> While(COND, BODY)
+  rule bool(false) ~> whileTest(_COND, _BODY) => .K
+
+  rule If(COND, YES, NO) => COND ~> ifTest(YES, NO)
+  rule bool(true) ~> ifTest(YES, _NO) => exec(YES)
+  rule bool(false) ~> ifTest(_YES, NO) => exec(NO)
+
+  // Evaluate call arguments left-to-right before changing the local frame.
+  rule Call(Name(F), E) => E ~> call1(F)
+  rule V:Val ~> call1(F) => invoke1(F, V)
+  rule Call(Name(F), E1, E2) => E1 ~> callArg1(F, E2)
+  rule V:Val ~> callArg1(F, E2) => E2 ~> callArg2(F, V)
+  rule V2:Val ~> callArg2(F, V1) => invoke2(F, V1, V2)
+  rule Invoke(F, V) => invoke1(F, V)
+
+  rule <k> invoke1(F, V) ~> CALLER => exec(BODY) </k>
+       <env> RHO => P |-> V </env>
+       <functions>... F |-> function1(P, BODY) ...</functions>
+       <stack> S => ListItem(frame(CALLER, RHO)) S </stack>
+
+  rule <k> invoke2(F, V1, V2) ~> CALLER => exec(BODY) </k>
+       <env> RHO => P1 |-> V1 P2 |-> V2 </env>
+       <functions>... F |-> function2(P1, P2, BODY) ...</functions>
+       <stack> S => ListItem(frame(CALLER, RHO)) S </stack>
+
+  // Return abandons the rest of the callee and resumes its saved continuation.
+  rule <k> Return(V:Val) ~> _CURRENT => V ~> CALLER </k>
+       <env> _ => RHO </env>
+       <stack> ListItem(frame(CALLER, RHO)) S => S </stack>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6404e8233aed66d265b89b09ef4d2258a5396003
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,25 @@
+def evaluate_polynomial(xs: list, x):
+    value = 0
+    power = 1
+    for coefficient in xs:
+        value = value + coefficient * power
+        power = power * x
+    return value
+
+
+def find_zero(xs: list):
+    left = -1
+    right = 1
+
+    while evaluate_polynomial(xs, left) * evaluate_polynomial(xs, right) > 0:
+        left = left * 2
+        right = right * 2
+
+    while right - left > 1 / 10000000000:
+        middle = (left + right) / 2
+        if evaluate_polynomial(xs, middle) * evaluate_polynomial(xs, left) > 0:
+            left = middle
+        else:
+            right = middle
+
+    return (left + right) / 2
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c8da3ea69e9f457e3bc944a87610a332d3bc0142
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,86 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Prompt example: 1 + 2x.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(1, 1)) ListItem(rat(2, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(1, 1)) ListItem(rat(2, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+
+  // Prompt example: -6 + 11x - 6x^2 + x^3.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(-6, 1)) ListItem(rat(11, 1))
+          ListItem(rat(-6, 1)) ListItem(rat(1, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(-6, 1)) ListItem(rat(11, 1))
+            ListItem(rat(-6, 1)) ListItem(rat(1, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+
+  // The root is the initial midpoint; this exercises the zero-product branch.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(0, 1)) ListItem(rat(1, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+
+  // x^3 - 8: both initial endpoint values are negative, so the bracket grows.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(-8, 1)) ListItem(rat(0, 1))
+          ListItem(rat(0, 1)) ListItem(rat(1, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(-8, 1)) ListItem(rat(0, 1))
+            ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+
+  // x^3 + 8: symmetric expansion to a negative root.
+  claim
+    <k>
+      solution ;;
+      VerifyRoot(
+        ListItem(rat(8, 1)) ListItem(rat(0, 1))
+          ListItem(rat(0, 1)) ListItem(rat(1, 1)),
+        Invoke("find_zero", list(
+          ListItem(rat(8, 1)) ListItem(rat(0, 1))
+            ListItem(rat(0, 1)) ListItem(rat(1, 1)))),
+        rat(1, 100000000))
+      => bool(true)
+    </k>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <stack> .List </stack>
+endmodule
