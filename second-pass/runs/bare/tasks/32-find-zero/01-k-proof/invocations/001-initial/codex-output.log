+  syntax Expr ::= "Invoke" "(" String "," Val ")"
+endmodule
+
+module SEMANTIC
+  imports SEMANTIC-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <T>
+      <k> $PGM:Program </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <stack> .List </stack>
+    </T>
+
