    54	                 | CompareRight(Expr)
    55	                 | GreaterThan(Int)
    56	                 | AppendTo(String)
    57	                 | StartLoop(String, Stmts)
    58	                 | Loop(String, Stmts, List)
    59	                 | Bind(String, Val)
    60	
    61	  syntax List ::= intsToList(Ints) [function, total]
    62	endmodule
    63	
    64	module MPY
    65	  imports MPY-SYNTAX
    66	  imports INT
    67	  imports BOOL
    68	  imports STRING
    69	  imports MAP
    70	  imports LIST
    71	
    72	  configuration
    73	    <py>
    74	      <k> $PGM:Program </k>
    75	      <functions> .Map </functions>
    76	      <env> .Map </env>
    77	      <stack> .List </stack>
    78	    </py>
    79	
    80	  // The concrete command-line harness supplies a list of machine integers.
    81	  rule intsToList(.Ints) => .List
    82	  rule intsToList(I:Int) => ListItem(I)
    83	  rule intsToList(I:Int, IS:Ints) => ListItem(I) intsToList(IS)
    84	
    85	  rule <k> Run(M, [ IS ]) => M ~> Invoke("rolling_max", ListVal(intsToList(IS))) ~> Cleanup ... </k>
    86	  rule <k> Module(SS) => SS ... </k>
    87	  rule <k> S:Stmt SS:Stmts => S ~> SS ... </k>
    88	  rule <k> .Stmts => .K ... </k>
    89	  rule <k> V:Val ~> .Stmts => V ... </k>
    90	
    91	  rule <k> ImportFrom(_, _) => .K ... </k>
    92	  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
    93	       <functions> FS => FS [ F <- Function(PS, BODY) ] </functions>
    94	
    95	  // Calls use a fresh local environment and restore the caller at EndCall.
    96	  rule <k> Call(Name(F), E:Expr, .Exprs) => E ~> CallKont(F) ... </k>
    97	  rule <k> V:Val ~> CallKont(F) => Invoke(F, V) ... </k>
    98	  rule <k> Invoke(F, V) => BODY ~> EndCall ... </k>
    99	       <functions>... F |-> Function(Params(P:String, .Strings), BODY) ...</functions>
   100	       <env> OLD => P |-> V </env>
   101	       <stack> .List => ListItem(Frame(OLD)) </stack>
   102	  rule <k> V:Val ~> EndCall => V ... </k>
   103	       <env> _ => OLD </env>
   104	       <stack> ListItem(Frame(OLD)) => .List </stack>
   105	
   106	  rule <k> V:Val ~> Cleanup => V ... </k>
   107	       <functions> _ => .Map </functions>
   108	
   109	  // Literals and lookup.
   110	  rule <k> Int(I) => IntVal(I) ... </k>
   111	  rule <k> Bool(B) => BoolVal(B) ... </k>
   112	  rule <k> ListExpr(.Exprs) => ListVal(.List) ... </k>
   113	  rule <k> Name(X) => V ... </k> <env>... X |-> V ...</env>
   114	
   115	  // Assignment, return, and expression statements.
   116	  rule <k> Assign(Name(X), E) => E ~> Store(X) ... </k>
   117	  rule <k> V:Val ~> Store(X) => .K ... </k>
   118	       <env> RHO => RHO [ X <- V ] </env>
   119	  rule <k> Return(E) => E ... </k>
   120	  rule <k> Expr(E) => E ~> Discard ... </k>
   121	  rule <k> _:Val ~> Discard => .K ... </k>
   122	
   123	  // The only comparison needed by the submitted program.
   124	  rule <k> Compare(L, CmpOp(">", R), .CmpOps) => L ~> CompareRight(R) ... </k>
   125	  rule <k> IntVal(I) ~> CompareRight(R) => R ~> GreaterThan(I) ... </k>
   126	  rule <k> IntVal(J) ~> GreaterThan(I) => BoolVal(I >Int J) ... </k>
   127	
   128	  // Conditionals evaluate their guard before selecting a statement block.
   129	  rule <k> If(E, THEN, ELSE) => E ~> Branch(THEN, ELSE) ... </k>
   130	  rule <k> BoolVal(true) ~> Branch(THEN, _) => THEN ... </k>
   131	  rule <k> BoolVal(false) ~> Branch(_, ELSE) => ELSE ... </k>
   132	
   133	  // list.append mutates the named list and evaluates to None.
   134	  rule <k> Call(Attribute(Name(X), "append"), E:Expr, .Exprs) => E ~> AppendTo(X) ... </k>
   135	  rule <k> IntVal(I) ~> AppendTo(X) => NoneVal ... </k>
   136	       <env>... X |-> ListVal(ITEMS) => X |-> ListVal(ITEMS ListItem(I)) ...</env>
   137	
   138	  // A for-loop binds each integer in order and executes its body sequentially.
   139	  rule <k> For(Name(X), E, BODY) => E ~> StartLoop(X, BODY) ... </k>
   140	  rule <k> ListVal(ITEMS) ~> StartLoop(X, BODY) => Loop(X, BODY, ITEMS) ... </k>
   141	  rule <k> Loop(_, _, .List) => .K ... </k>
   142	  rule <k> Loop(X, BODY, ListItem(I) REST) => Bind(X, IntVal(I)) ~> BODY ~> Loop(X, BODY, REST) ... </k>
   143	  rule <k> Bind(X, V) => .K ... </k>
   144	       <env> RHO => RHO [ X <- V ] </env>
