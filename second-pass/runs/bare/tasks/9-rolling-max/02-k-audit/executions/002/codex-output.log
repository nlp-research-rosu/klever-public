     6	  // The symbolic harness differs from OpRunList only in name, making it clear
     7	  // which claims intentionally use the verified loop summary below.
     8	  syntax Program ::= VerifyRunList(Module, List)
     9	  rule <k> VerifyRunList(M, XS)
    10	        => M ~> Invoke("rolling_max", ListVal(XS)) ~> Cleanup ... </k>
    11	
    12	  // Loop invariant summarized as a verification rule.  The three preceding
    13	  // assignments establish this exact environment.  For an arbitrary integer
    14	  // list XS, the first iteration initializes the maximum from its head; every
    15	  // remaining iteration appends max(current, previous), exactly #rollingMax.
    16	  // Matching ROLLING-LOOP makes the summary implementation-sensitive.
    17	  rule <k> For(Name("number"), Name("numbers"), ROLLING-LOOP)
    18	        => .K ... </k>
    19	       <env>
    20	         "first" |-> BoolVal(true)
    21	         "maximum" |-> IntVal(0)
    22	         "numbers" |-> ListVal(XS)
    23	         "result" |-> ListVal(.List)
    24	       =>
    25	         "numbers" |-> ListVal(XS)
    26	         "result" |-> ListVal(#rollingMax(XS))
    27	       </env>
    28	       [priority(40)]
