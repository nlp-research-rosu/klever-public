     1	requires "semantic.k"
     2	
     3	module SOLUTION-AST
     4	  imports MPY
     5	
     6	  // Value-level operational harness used by proofs.  Run in semantic.k is
     7	  // the corresponding concrete parser harness for command-line examples.
     8	  syntax Program ::= OpRunList(Module, List)
     9	  rule <k> OpRunList(M, XS)
    10	        => M ~> Invoke("rolling_max", ListVal(XS)) ~> Cleanup ... </k>
    11	
    12	  // Constructor-for-constructor transcription of solution.mpy.
    13	  syntax Stmts ::= "ROLLING-LOOP" [macro]
    14	  rule ROLLING-LOOP =>
    15	    If(Name("first"),
    16	      Assign(Name("maximum"), Name("number"))
    17	      Assign(Name("first"), Bool(false)),
    18	      If(Compare(Name("number"), CmpOp(">", Name("maximum"))),
    19	        Assign(Name("maximum"), Name("number")),
    20	        .Stmts))
    21	    Expr(Call(Attribute(Name("result"), "append"), Name("maximum")))
    22	
    23	  syntax Stmts ::= "ROLLING-BODY" [macro]
    24	  rule ROLLING-BODY =>
    25	    Assign(Name("result"), ListExpr(.Exprs))
    26	    Assign(Name("first"), Bool(true))
    27	    Assign(Name("maximum"), Int(0))
    28	    For(Name("number"), Name("numbers"), ROLLING-LOOP)
    29	    Return(Name("result"))
    30	
    31	  syntax Module ::= "SOLUTION" [macro]
    32	  rule SOLUTION => Module(
    33	    ImportFrom("typing", "List", "Tuple")
    34	    FuncDef("rolling_max", Params("numbers"), ROLLING-BODY))
    35	
    36	  // Independent mathematical specification: emit the head, then scan the
    37	  // tail while carrying the largest integer observed so far.
    38	  syntax List ::= "#rollingMax" "(" List ")" [function]
    39	                | "#scanMax" "(" Int "," List ")" [function]
    40	
    41	  rule #rollingMax(.List) => .List
    42	  rule #rollingMax(ListItem(I:Int) REST) => ListItem(I) #scanMax(I, REST)
    43	
    44	  rule #scanMax(_, .List) => .List
    45	  rule #scanMax(M, ListItem(I:Int) REST)
    46	    => ListItem(I) #scanMax(I, REST)
    47	    requires I >Int M
    48	  rule #scanMax(M, ListItem(I:Int) REST)
    49	    => ListItem(M) #scanMax(M, REST)
    50	    requires notBool(I >Int M)
    51	endmodule

