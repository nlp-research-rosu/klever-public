     1	from typing import List, Tuple
     2	
     3	
     4	def rolling_max(numbers: List[int]) -> List[int]:
     5	    result = []
     6	    first = True
     7	    maximum = 0
     8	    for number in numbers:
     9	        if first:
    10	            maximum = number
    11	            first = False
    12	        else:
    13	            if number > maximum:
    14	                maximum = number
    15	        result.append(maximum)
    16	    return result

