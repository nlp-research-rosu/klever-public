+    }
+    for path, expected in expected_hashes.items():
+        actual = sha256_file(path)
+        assert actual == expected, f"hash mismatch: {path}: {actual} != {expected}"
+
+    assert (CANDIDATE / "prompt.py").read_bytes() == (
+        REFERENCE / "prompt.py"
+    ).read_bytes()
+    assert (CANDIDATE / "py2mpy.py").read_bytes() == (
+        REFERENCE / "py2mpy.py"
