@@ -0,0 +1,17 @@
+requires "/tmp/audit-work/9-rolling-max/build/verification.k"
+
+module FRESH-VACUITY
+  imports VERIFICATION
+
+  // Fresh result mutation: the true rolling maximum for [2,1] is [2,2],
