done < <(rg -o '"'\\(evidence/["'^)]+'"\\)' /audit-output/REVIEW.md | tr -d '()' | sort -u)
printf 'missing_link_count=%d\\n' \""'$review_missing_count"
printf '"'verdict_marker_count='; rg -c '"'^VERDICT: (PASS|CONCERNS|FAIL)$'"' /audit-output/REVIEW.md
