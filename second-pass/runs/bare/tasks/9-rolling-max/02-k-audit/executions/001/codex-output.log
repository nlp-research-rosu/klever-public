+                ~> Return(Name("result")) ~> EndCall ~> Cleanup
+            => Return(Name("result")) ~> EndCall ~> Cleanup </k>
+          <functions>
+            "rolling_max" |->
+              Function(Params("numbers", .Strings), ROLLING-BODY)
+          </functions>
+          <env>
+            "first"   |-> BoolVal(true)
+            "maximum" |-> IntVal(0)
+            "numbers" |-> ListVal(ListItem(2) ListItem(1))
+            "result"  |-> ListVal(.List)
+            =>
+            "numbers" |-> ListVal(ListItem(2) ListItem(1))
+            "result"  |-> ListVal(ListItem(2) ListItem(2))
+          </env>
+          <stack> ListItem(Frame(.Map)) </stack>
+        </py>
+endmodule
