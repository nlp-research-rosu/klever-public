===== /reference/canonical.py =====
     1	# canonical.py — the UNMODIFIED HumanEval/82 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: prime_length
     4	
     5	
     6	def prime_length(string):
     7	    """Write a function that takes a string and returns True if the string
     8	    length is a prime number or False otherwise
     9	    Examples
    10	    prime_length('Hello') == True
    11	    prime_length('abcdcba') == True
    12	    prime_length('kittens') == True
    13	    prime_length('orange') == False
    14	    """
    15	    l = len(string)
    16	    if l == 0 or l == 1:
    17	        return False
    18	    for i in range(2, l):
    19	        if l % i == 0:
    20	            return False
    21	    return True

