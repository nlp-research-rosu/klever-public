     8	  // verification.k, applied to the K builtin string length.
     9	  claim
    10	    <py>
    11	      <k>
    12	        run(solutionProgram, VStr(S))
    13	        => .K
    14	      </k>
    15	      <env>
    16	        .Map
    17	        => ("string" |-> VStr(S)
    18	            "n" |-> VInt(lengthString(S)))
    19	      </env>
    20	      <return>
    21	        noResult => VBool(isPrime(lengthString(S)))
    22	      </return>
    23	    </py>
    24	endmodule
