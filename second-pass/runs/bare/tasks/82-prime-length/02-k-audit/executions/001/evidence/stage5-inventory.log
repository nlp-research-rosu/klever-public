   106	  // `all(n % i != 0 for i in range(lo, hi))` denotes that every candidate
   107	  // in the half-open integer range is a non-divisor.  The source AST is kept
   108	  // intact by py2mpy; this semantic rule gives that AST its meaning.
   109	  rule eval(
   110	         Call(Name("all"),
   111	           GenExp(
   112	             Compare(BinOp("%", Name(NX), Name(IX)), CmpOp("!=", Int(0))),
   113	             CompFor(Name(IX),
   114	               Call(Name("range"), Int(LO), Name(HX)),
   115	               Bool(true)))),
   116	         ENV)
   117	    => VBool(noDivisors(asInt({ENV[NX]}:>Value),
   118	                        LO,
   119	                        asInt({ENV[HX]}:>Value)))
   120	    requires NX =/=String IX
   121	     andBool NX in_keys(ENV)
   122	     andBool HX in_keys(ENV)
   123	
   124	  // Executable, ground definition of universal non-divisibility on [D, HI).
   125	  // concrete(...) deliberately keeps the recursive range opaque during a
   126	  // symbolic proof while evaluating it completely for every concrete run.
   127	  syntax Bool ::= noDivisors(Int, Int, Int) [function, total]
   128	  rule noDivisors(_N, D, HI) => true
   129	    requires D >=Int HI
   130	    [concrete(D, HI), simplification]
   131	  rule noDivisors(N, D, HI) => false
   132	    requires D <Int HI andBool N %Int D ==Int 0
   133	    [concrete(N, D, HI), simplification]
   134	  rule noDivisors(N, D, HI) => noDivisors(N, D +Int 1, HI)
   135	    requires D <Int HI andBool N %Int D =/=Int 0
   136	    [concrete(N, D, HI), simplification]
