     9	  syntax Program ::= "solutionProgram" [macro]
    10	  rule solutionProgram =>
    11	    Module(
    12	      FuncDef("prime_length", Params("string"), CellVars("n"), FreeVars(.Strings),
    13	        Assign(Name("n"), Call(Name("len"), Name("string")))
    14	        Return(
    15	          BoolOp(
    16	            "and",
    17	            Compare(Name("n"), CmpOp(">=", Int(2))),
    18	            Call(
    19	              Name("all"),
    20	              GenExp(
    21	                Compare(
    22	                  BinOp("%", Name("n"), Name("i")),
    23	                  CmpOp("!=", Int(0))),
    24	                CompFor(
    25	                  Name("i"),
    26	                  Call(Name("range"), Int(2), Name("n")),
    27	                  Bool(true))))))))
    28	
    29	  // Mathematical contract used by the reachability specification.  For
    30	  // N >= 2, N is prime exactly when no integer in [2, N) divides it.
    31	  syntax Bool ::= isPrime(Int) [function, total]
    32	  rule isPrime(N) => (N >=Int 2 andBool noDivisors(N, 2, N))
    33	endmodule
