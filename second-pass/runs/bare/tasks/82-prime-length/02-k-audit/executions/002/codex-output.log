    47	kast solution.mpy \
    48	  --definition verification-kompiled \
    49	  --expand-macros \
    50	  --output kore > solution.kore
    51	kast \
    52	  --definition verification-kompiled \
    53	  --module VERIFICATION \
    54	  --sort Program \
    55	  --expression solutionProgram \
    56	  --expand-macros \
    57	  --output kore > specified-solution.kore
    58	cmp solution.kore specified-solution.kore
    59	
    60	kprove spec.k \
    61	  --definition verification-kompiled \
    62	  --spec-module SPEC

