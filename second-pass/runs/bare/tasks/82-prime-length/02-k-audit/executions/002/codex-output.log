    13	  --main-module SEMANTIC \
    14	  --syntax-module MPY-SYNTAX
    15	
    16	check_krun() {
    17	  local arg="$1"
    18	  local expected="$2"
    19	  local output
    20	  output="$(krun solution.mpy --definition semantic-kompiled -cARG="$arg")"
    21	  printf '%s\n' "$output"
    22	  if ! grep -Fq "VBool ( $expected )" <<<"$output"; then
    23	    printf 'krun result mismatch for %s (expected %s)\n' "$arg" "$expected" >&2
    24	    return 1
    25	  fi
    26	}
    27	
    28	check_krun 'VStr("Hello")' true
    29	check_krun 'VStr("abcdcba")' true
    30	check_krun 'VStr("kittens")' true
    31	check_krun 'VStr("orange")' false
    32	check_krun 'VStr("")' false
    33	check_krun 'VStr("a")' false
    34	check_krun 'VStr("ab")' true
    35	check_krun 'VStr("abc")' true
    36	check_krun 'VStr("abcdefgh")' false
