   101	  // the same result as Python's short-circuiting `and` for the accepted AST.
   102	
   103	  syntax Bool ::= asBool(Value) [function, total]
   104	  rule asBool(VBool(B)) => B
   105	
   106	  // `all(n % i != 0 for i in range(lo, hi))` denotes that every candidate
   107	  // in the half-open integer range is a non-divisor.  The source AST is kept
   108	  // intact by py2mpy; this semantic rule gives that AST its meaning.
   109	  rule eval(
   110	         Call(Name("all"),
   111	           GenExp(
   112	             Compare(BinOp("%", Name(NX), Name(IX)), CmpOp("!=", Int(0))),
   113	             CompFor(Name(IX),
   114	               Call(Name("range"), Int(LO), Name(HX)),
   115	               Bool(true)))),
   116	         ENV)
   117	    => VBool(noDivisors(asInt({ENV[NX]}:>Value),
   118	                        LO,
   119	                        asInt({ENV[HX]}:>Value)))
   120	    requires NX =/=String IX
   121	     andBool NX in_keys(ENV)
   122	     andBool HX in_keys(ENV)
   123	
   124	  // Executable, ground definition of universal non-divisibility on [D, HI).
   125	  // concrete(...) deliberately keeps the recursive range opaque during a
   126	  // symbolic proof while evaluating it completely for every concrete run.
   127	  syntax Bool ::= noDivisors(Int, Int, Int) [function, total]
   128	  rule noDivisors(_N, D, HI) => true
   129	    requires D >=Int HI
   130	    [concrete(D, HI), simplification]
   131	  rule noDivisors(N, D, HI) => false
   132	    requires D <Int HI andBool N %Int D ==Int 0
   133	    [concrete(N, D, HI), simplification]
   134	  rule noDivisors(N, D, HI) => noDivisors(N, D +Int 1, HI)
   135	    requires D <Int HI andBool N %Int D =/=Int 0
   136	    [concrete(N, D, HI), simplification]
   137	endmodule

===== /candidate/verification.k =====
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Canonical program term used by spec.k.  prove.sh macro-expands this term
     7	  // and solution.mpy and compares their canonical KAST, binding the proof to
     8	  // the freshly translated implementation rather than to a stale copy.
     9	  syntax Program ::= "solutionProgram" [macro]
    10	  rule solutionProgram =>
    11	    Module(
    12	      FuncDef("prime_length", Params("string"), CellVars("n"), FreeVars(.Strings),
    13	        Assign(Name("n"), Call(Name("len"), Name("string")))
    14	        Return(
    15	          BoolOp(
    16	            "and",
    17	            Compare(Name("n"), CmpOp(">=", Int(2))),
    18	            Call(
    19	              Name("all"),
    20	              GenExp(
    21	                Compare(
    22	                  BinOp("%", Name("n"), Name("i")),
    23	                  CmpOp("!=", Int(0))),
    24	                CompFor(
    25	                  Name("i"),
    26	                  Call(Name("range"), Int(2), Name("n")),
    27	                  Bool(true))))))))
    28	
    29	  // Mathematical contract used by the reachability specification.  For
    30	  // N >= 2, N is prime exactly when no integer in [2, N) divides it.
    31	  syntax Bool ::= isPrime(Int) [function, total]
    32	  rule isPrime(N) => (N >=Int 2 andBool noDivisors(N, 2, N))
    33	endmodule

===== /candidate/spec.k =====
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // One symbolic reachability claim covers every possible input string.
     7	  // Its postcondition is the independently named primality predicate from
     8	  // verification.k, applied to the K builtin string length.
     9	  claim
    10	    <py>
    11	      <k>
    12	        run(solutionProgram, VStr(S))
    13	        => .K
    14	      </k>
    15	      <env>
    16	        .Map
    17	        => ("string" |-> VStr(S)
    18	            "n" |-> VInt(lengthString(S)))
    19	      </env>
    20	      <return>
    21	        noResult => VBool(isPrime(lengthString(S)))
    22	      </return>
    23	    </py>
    24	endmodule

