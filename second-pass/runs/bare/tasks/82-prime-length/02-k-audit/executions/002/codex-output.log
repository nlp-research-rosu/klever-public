+    ok = True
+    print(f"INVENTORY {root}")
+    for path in sorted(root.rglob("*"), key=lambda p: p.as_posix()):
+        mode = path.lstat().st_mode
+        kind = (
+            "symlink"
+            if stat.S_ISLNK(mode)
+            else "file"
+            if stat.S_ISREG(mode)
+            else "dir"
+            if stat.S_ISDIR(mode)
+            else "other"
+        )
