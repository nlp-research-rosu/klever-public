     6	# Rebuild the translator output from the implementation.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# Compile the operational semantics and exercise both prompt examples and
    10	# boundary cases.  Each run is checked against the expected final K value.
    11	kompile semantic.k \
