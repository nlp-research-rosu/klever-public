Module(
  FuncDef("prime_length", Params("string"), CellVars("n"), FreeVars(),
    Assign(Name("n"), Call(Name("len"), Name("string")))
    Return(
      BoolOp(
        "and",
        Compare(Name("n"), CmpOp(">=", Int(2))),
        Call(
          Name("all"),
          GenExp(Compare(BinOp("%", Name("n"), Name("i")), CmpOp("!=", Int(0))),
            CompFor(
              Name("i"),
              Call(Name("range"), Int(2), Name("n")),
              Bool(true))))))))
