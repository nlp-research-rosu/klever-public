COMMAND: rg -n '^[[:space:]]*(syntax|configuration|rule|claim|imports|requires)' semantic.k verification.k spec.k
spec.k:1:requires "verification.k"
spec.k:4:  imports VERIFICATION
spec.k:8:  claim [positive-n-one]:
spec.k:45:  claim [positive-n-gt-one]:
spec.k:81:    requires N >Int 1
verification.k:1:requires "semantic.k"
verification.k:4:  imports MPY
verification.k:10:  syntax Int ::= decimalMiddles(Int) [function]
verification.k:16:  rule decimalMiddles(K) => 10 ^Int K requires K >=Int 0
verification.k:17:  rule startsWithOne(N) => 10 *Int decimalMiddles(N -Int 2)
verification.k:18:    requires N >Int 1
verification.k:19:  rule endsWithOne(N) => 9 *Int decimalMiddles(N -Int 2)
verification.k:20:    requires N >Int 1
verification.k:21:  rule startsAndEndsWithOne(N) => decimalMiddles(N -Int 2)
verification.k:22:    requires N >Int 1
verification.k:24:  rule qualifyingCount(1) => 1
verification.k:25:  rule qualifyingCount(N)
verification.k:27:    requires N >Int 1
semantic.k:2:  imports INT-SYNTAX
semantic.k:3:  imports STRING-SYNTAX
semantic.k:7:  syntax Pgm ::= "Module" "(" Stmts ")" [symbol(Module)]
semantic.k:9:  syntax Stmts ::= List{Stmt, ""}
semantic.k:10:  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
semantic.k:15:  syntax Params ::= "Params" "(" String ")" [symbol(Params)]
semantic.k:17:  syntax Expr ::= "Int" "(" Int ")"                            [symbol(IntExpr)]
semantic.k:23:  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
semantic.k:27:  imports MPY-SYNTAX
semantic.k:28:  imports BOOL
semantic.k:29:  imports INT
semantic.k:30:  imports MAP
semantic.k:32:  syntax FunctionValue ::= "noFunction"
semantic.k:34:  syntax Control ::= "normal" | "returned"
semantic.k:35:  syntax Result ::= "noResult" | "result" "(" Int ")"
semantic.k:37:  syntax KItem ::= "exec" "(" Stmts ")"
semantic.k:41:  configuration
semantic.k:52:  rule <k> Module(SS) => exec(SS) ... </k>
semantic.k:53:  rule <k> exec(.Stmts) => .K ... </k>
semantic.k:54:  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
semantic.k:56:  rule <k> exec(_SS) => .K ... </k>
semantic.k:59:  rule <k> FuncDef(F, Params(P), BODY) => .K ... </k>
semantic.k:62:  rule <k> entry(F, N) => exec(BODY) ~> endCall ... </k>
semantic.k:68:  rule <k> endCall => .K ... </k>
semantic.k:73:  rule <k> Expr(_E) => .K ... </k>
semantic.k:75:  rule <k> If(COND, THEN, _ELSE) => exec(THEN) ... </k>
semantic.k:77:    requires evalBool(COND, ENV)
semantic.k:78:  rule <k> If(COND, _THEN, ELSE) => exec(ELSE) ... </k>
semantic.k:80:    requires notBool evalBool(COND, ENV)
semantic.k:82:  rule <k> Return(E) => .K ... </k>
semantic.k:89:  syntax Int ::= evalInt(Expr, Map) [function]
semantic.k:90:  rule evalInt(Int(I), _ENV) => I
semantic.k:91:  rule evalInt(Name(X), (X |-> I) M) => I
semantic.k:92:    requires notBool (X in_keys(M))
semantic.k:93:  rule evalInt(BinOp("+", A, B), ENV) => evalInt(A, ENV) +Int evalInt(B, ENV)
semantic.k:94:  rule evalInt(BinOp("-", A, B), ENV) => evalInt(A, ENV) -Int evalInt(B, ENV)
semantic.k:95:  rule evalInt(BinOp("*", A, B), ENV) => evalInt(A, ENV) *Int evalInt(B, ENV)
semantic.k:96:  rule evalInt(BinOp("**", A, B), ENV) => evalInt(A, ENV) ^Int evalInt(B, ENV)
semantic.k:98:  syntax Bool ::= evalBool(Expr, Map) [function]
semantic.k:99:  rule evalBool(Compare(A, CmpOp("==", B)), ENV)
COMMAND: rg -n 'simplification|total|functional|opaque|priority|owise' semantic.k verification.k spec.k
SEMANTIC_RULE_COUNT: 18
VERIFICATION_RULE_COUNT: 6
ENTRY_CLAIM_COUNT: 2
EXIT_STATUS: 0
