CALL (61, 'exec', 'const patch = "*** Begin Patch\\n*** Add File: /work/semantic.k\\n+module MPY-SYNTAX\\n+  imports INT-SYNTAX\\n+  imports STRING-SYNTAX\\n+\\n+  // The constructor grammar needed by solution.mpy.  Constructor names and\\n+  // argument order deliberately match py2mpy.py exactly.\\n+  syntax Pgm ::= \\"Module\\" \\"(\\" Stmts \\")\\" [symbol(Module)]\\n+\\n+  syntax Stmts ::= List{Stmt, \\"\\"}\\n+  syntax Stmt ::= \\"FuncDef\\" \\"(\\" String \\",\\" Params \\",\\" Stmts \\")\\" [symbol(FuncDef)]\\n+                | \\"Return\\" \\"(\\" Expr \\")\\"                         [symbol(Return)]\\n+                | \\"If\\" \\"(\\" Expr \\",\\" Stmts \\",\\" Stmts \\")\\"       [symbol(If)]\\n+                | \\"Expr\\" \\"(\\" Expr \\")\\"                           [symbol(ExprStmt)]\\n+\\n+  syntax Params ::= \\"Params\\" \\"(\\" String \\")\\" [symbol(Params)]\\n+\\n+  syntax Expr ::= \\"Int\\" \\"(\\" Int \\")\\"                            [symbol(IntExpr)]\\n+                | \\"Str\\" \\"(\\" String \\")\\"                          [symbol(StrExpr)]\\n+                | \\"Name\\" \\"(\\" String \\")\\"                         [symbol(NameExpr)]\\n+                | \\"BinOp\\" \\"(\\" String \\",\\" Expr \\",\\" Expr \\")\\"    [symbol(BinOp)]\\n+                | \\"Compare\\" \\"(\\" Expr \\",\\" CmpOp \\")\\"             [symbol(Compare)]\\n+\\n+  syntax CmpOp ::= \\"CmpOp\\" \\"(\\" String \\",\\" Expr \\")\\" [symbol(CmpOp)]\\n+endmodule\\n+\\n+module MPY\\n+  imports MPY-SYNTAX\\n+  imports BOOL\\n+  imports INT\\n+  imports MAP\\n+\\n+  syntax FunctionValue ::= \\"noFunction\\"\\n+                         | \\"function\\" \\"(\\" String \\",\\" String \\",\\" Stmts \\")\\"\\n+  syntax Control ::= \\"normal\\" | \\"returned\\"\\n+  syntax Result ::= \\"noResult\\" | \\"result\\" \\"(\\" Int \\")\\"\\n+\\n+  syntax KItem ::= \\"exec\\" \\"(\\" Stmts \\")\\"\\n+                 | \\"entry\\" \\"(\\" String \\",\\" Int \\")\\"\\n+                 | \\"endCall\\"\\n+\\n+  configuration\\n+    <mpy>\\n+      <k> $PGM:Pgm ~> entry(\\"starts_one_ends\\", $N:Int) </k>\\n+      <function> noFunction </function>\\n+      <env> .Map </env>\\n+      <control> normal </control>\\n+      <result> noResult </result>\\n+    </mpy>\\n+\\n+  // Module evaluation registers top-level functions before the configured\\n+  // entry call is made.\\n+  rule <k> Module(SS) => exec(SS) ... </k>\\n+  rule <k> exec(.Stmts) => . ... </k>\\n+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>\\n+       <control> normal </control>\\n+  rule <k> exec(_SS) => . ... </k>\\n+       <control> returned </control>\\n+\\n+  rule <k> FuncDef(F, Params(P), BODY) => . ... </k>\\n+       <function> _ => function(F, P, BODY) </function>\\n+\\n+  rule <k> entry(F, N) => exec(BODY) ~> endCall ... </k>\\n+       <function> function(F, P, BODY) </function>\\n+       <env> _ => P |-> N </env>\\n+       <control> normal </control>\\n+       <result> noResult </result>\\n+\\n+  rule <k> endCall => . ... </k>\\n+       <control> returned => normal </control>\\n+\\n+  // A standalone expression (the function docstring here) has no externally\\n+  // observable effect in this integer-only fragment.\\n+  rule <k> ExprStmt(_E) => . ... </k>\\n+\\n+  rule <k> If(COND, THEN, _ELSE) => exec(THEN) ... </k>\\n+       <env> ENV </env>\\n+    requires evalBool(COND, ENV)\\n+  rule <k> If(COND, _THEN, ELSE) => exec(ELSE) ... </k>\\n+       <env> ENV </env>\\n+    requires notBool evalBool(COND, ENV)\\n+\\n+  rule <k> Return(E) => . ... </k>\\n+       <env> ENV </env>\\n+       <control> normal => returned </control>\\n+       <result> noResult => result(evalInt(E, ENV)) </result>\\n+\\n+  // Pure expression semantics.  Keeping this layer independent of statement\\n+  // control makes it directly simplifiable in both execution and proofs.\\n+  syntax Int ::= evalInt(Expr, Map) [function]\\n+  rule evalInt(IntExpr(I), _ENV) => I\\n+  rule evalInt(NameExpr(X), X |-> I M) => I\\n+    requires notBool (X in_keys(M))\\n+  rule evalInt(BinOp(\\"+\\", A, B), ENV) => evalInt(A, ENV) +Int evalInt(B, ENV)\\n+  rule evalInt(BinOp(\\"-\\", A, B), ENV) => evalInt(A, ENV) -Int evalInt(B, ENV)\\n+  rule evalInt(BinOp(\\"*\\", A, B), ENV) => evalInt(A, ENV) *Int evalInt(B, ENV)\\n+  rule evalInt(BinOp(\\"**\\", A, B), ENV) => evalInt(A, ENV) ^Int evalInt(B, ENV)\\n+\\n+  syntax Bool ::= evalBool(Expr, Map) [function]\\n+  rule evalBool(Compare(A, CmpOp(\\"==\\", B)), ENV)\\n+    => evalInt(A, ENV) ==Int evalInt(B, ENV)\\n+endmodule\\n*** Add File: /work/verification.k\\n+requires \\"semantic.k\\"\\n+\\n+module VERIFICATION\\n+  imports MPY\\n+\\n+  // Mathematical specification by inclusion-exclusion.  For N > 1, fixing\\n+  // the first digit leaves 10 * 10^(N-2) choices; fixing the last leaves\\n+  // 9 * 10^(N-2), since the first digit cannot be zero; fixing both leaves\\n+  // 10^(N-2).  The union is starts + ends - overlap.\\n+  syntax Int ::= decimalMiddles(Int) [function]\\n+               | startsWithOne(Int) [function]\\n+               | endsWithOne(Int) [function]\\n+               | startsAndEndsWithOne(Int) [function]\\n+               | qualifyingCount(Int) [function]\\n+\\n+  rule decimalMiddles(K) => 10 ^Int K requires K >=Int 0\\n+  rule startsWithOne(N) => 10 *Int decimalMiddles(N -Int 2)\\n+    requires N >Int 1\\n+  rule endsWithOne(N) => 9 *Int decimalMiddles(N -Int 2)\\n+    requires N >Int 1\\n+  rule startsAndEndsWithOne(N) => decimalMiddles(N -Int 2)\\n+    requires N >Int 1\\n+\\n+  rule qualifyingCount(1) => 1\\n+  rule qualifyingCount(N)\\n+    => startsWithOne(N) +Int endsWithOne(N) -Int startsAndEndsWithOne(N)\\n+    requires N >Int 1\\n+endmodule\\n*** Add File: /work/spec.k\\n+requires \\"verification.k\\"\\n+\\n+module SPEC\\n+  imports VERIFICATION\\n+\\n+  // The generated solution.mpy term appears literally in each claim.  The\\n+  // two claims partition precisely the prompt\'s positive-integer domain.\\n+  claim\\n+    <mpy>\\n+      <k>\\n+        Module(\\n+          FuncDef(\\"starts_one_ends\\", Params(\\"n\\"),\\n+            ExprStmt(\\n+              StrExpr(\\n+                \\"\\\\n    Given a positive integer n, return the count of the numbers of n-digit\\\\n    positive integers that start or end with 1.\\\\n    \\"))\\n+            If(Compare(NameExpr(\\"n\\"), CmpOp(\\"==\\", IntExpr(1))),\\n+              Return(IntExpr(1)),\\n+              Return(\\n+                BinOp(\\n+                  \\"*\\",\\n+                  IntExpr(18),\\n+                  BinOp(\\"**\\", IntExpr(10), BinOp(\\"-\\", NameExpr(\\"n\\"), IntExpr(2))))))))\\n+        ~> entry(\\"starts_one_ends\\", 1)\\n+      => .K\\n+      </k>\\n+      <result> noResult => result(qualifyingCount(1)) </result>\\n+      ...\\n+    </mpy>\\n+\\n+  claim [positive-n-gt-one]:\\n+    <mpy>\\n+      <k>\\n+        Module(\\n+          FuncDef(\\"starts_one_ends\\", Params(\\"n\\"),\\n+            ExprStmt(\\n+              StrExpr(\\n+                \\"\\\\n    Given a positive integer n, return the count of the numbers of n-digit\\\\n    positive integers that start or end with 1.\\\\n    \\"))\\n+            If(Compare(NameExpr(\\"n\\"), CmpOp(\\"==\\", IntExpr(1))),\\n+              Return(IntExpr(1)),\\n+              Return(\\n+                BinOp(\\n+                  \\"*\\",\\n+                  IntExpr(18),\\n+                  BinOp(\\"**\\", IntExpr(10), BinOp(\\"-\\", NameExpr(\\"n\\"), IntExpr(2))))))))\\n+        ~> entry(\\"starts_one_ends\\", N)\\n+      => .K\\n+      </k>\\n+      <result> noResult => result(qualifyingCount(N)) </result>\\n+      ...\\n+    </mpy>\\n+    requires N >Int 1\\n+endmodule\\n*** End Patch";\ntext(await tools.apply_patch(patch));\n')
