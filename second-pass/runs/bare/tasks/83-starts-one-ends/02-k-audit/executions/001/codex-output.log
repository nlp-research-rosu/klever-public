+
+echo "command: python3 /audit-output/evidence/ground_witness.py"
+python3 /audit-output/evidence/ground_witness.py
+rc=$?
+echo "exit: $rc"
+if (( rc != 0 )); then status=1; fi
+
+echo "script_exit: $status"
