+  echo "exit: $rc"
+  expected=$(python3 -c 'import solution, sys; print(solution.starts_one_ends(int(sys.argv[1])))' "$n")
+  py_rc=$?
+  echo "python command: python3 -c import-solution-and-call $n"
+  echo "python exit: $py_rc"
