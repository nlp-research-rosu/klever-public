+sed \
+  -e 's/module SPEC$/module SPEC-VACUITY/' \
+  -e 's/result(qualifyingCount(1))/result(qualifyingCount(1) +Int 1)/' \
+  -e 's/result(qualifyingCount(N))/result(qualifyingCount(N) +Int 1)/' \
+  /candidate/spec.k \
+  > /audit-output/evidence/spec-vacuity.k
+rc=$?
+echo "exit: $rc"
