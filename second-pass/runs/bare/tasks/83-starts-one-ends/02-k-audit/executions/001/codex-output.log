echo "invocation: bash /audit-output/evidence/stage6-nonvacuity.sh" | tee -a /audit-output/evidence/stage6-nonvacuity.log
echo "invocation_exit: $rc" | tee -a /audit-output/evidence/stage6-nonvacuity.log
