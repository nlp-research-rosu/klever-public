+#!/usr/bin/env bash
+set -u
+
+status=0
+
+echo "command: find /candidate -maxdepth 1 -type f -name *.k"
+find /candidate -maxdepth 1 -type f -name '*.k' -printf '%f\n' | sort
+rc=$?
+echo "exit: $rc"
