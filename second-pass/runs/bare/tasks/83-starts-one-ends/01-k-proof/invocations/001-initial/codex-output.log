diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fe9ca2fba8d09e65a6b82a2eea88c1c1eac95943
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,28 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical specification by inclusion-exclusion.  For N > 1, fixing
+  // the first digit leaves 10 * 10^(N-2) choices; fixing the last leaves
+  // 9 * 10^(N-2), since the first digit cannot be zero; fixing both leaves
+  // 10^(N-2).  The union is starts + ends - overlap.
+  syntax Int ::= decimalMiddles(Int) [function]
+               | startsWithOne(Int) [function]
+               | endsWithOne(Int) [function]
+               | startsAndEndsWithOne(Int) [function]
+               | qualifyingCount(Int) [function]
+
+  rule decimalMiddles(K) => 10 ^Int K requires K >=Int 0
+  rule startsWithOne(N) => 10 *Int decimalMiddles(N -Int 2)
+    requires N >Int 1
+  rule endsWithOne(N) => 9 *Int decimalMiddles(N -Int 2)
+    requires N >Int 1
+  rule startsAndEndsWithOne(N) => decimalMiddles(N -Int 2)
+    requires N >Int 1
+
+  rule qualifyingCount(1) => 1
+  rule qualifyingCount(N)
+    => startsWithOne(N) +Int endsWithOne(N) -Int startsAndEndsWithOne(N)
+    requires N >Int 1
+endmodule

apply patch
patch: completed
/work/semantic.k
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d86fe38827424a39a35c6108d22697e2c2015839
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the K constructor program from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the executable semantics and exercise both branches (plus larger
+# concrete instances) through the actual generated solution.mpy term.
+kompile semantic.k \
+  --backend llvm \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --output-definition semantic-kompiled
+krun solution.mpy --definition semantic-kompiled -cN=1
+krun solution.mpy --definition semantic-kompiled -cN=2
+krun solution.mpy --definition semantic-kompiled -cN=3
+krun solution.mpy --definition semantic-kompiled -cN=5
+
+# Compile the verification layer and prove every claim in spec.k.  This is the
+# required positive target-proof command; success prints #Top and exits zero.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..a4178b5420021ffe05e29d2dfd582cd05e3be3e3
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,101 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor grammar needed by solution.mpy.  Constructor names and
+  // argument order deliberately match py2mpy.py exactly.
+  syntax Pgm ::= "Module" "(" Stmts ")" [symbol(Module)]
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                | "Return" "(" Expr ")"                         [symbol(Return)]
+                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(If)]
+                | "Expr" "(" Expr ")"                           [symbol(ExprStmt)]
+
+  syntax Params ::= "Params" "(" String ")" [symbol(Params)]
+
+  syntax Expr ::= "Int" "(" Int ")"                            [symbol(IntExpr)]
+                | "Str" "(" String ")"                          [symbol(StrExpr)]
+                | "Name" "(" String ")"                         [symbol(NameExpr)]
+                | "BinOp" "(" String "," Expr "," Expr ")"    [symbol(BinOp)]
+                | "Compare" "(" Expr "," CmpOp ")"             [symbol(Compare)]
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports MAP
+
+  syntax FunctionValue ::= "noFunction"
+                         | "function" "(" String "," String "," Stmts ")"
+  syntax Control ::= "normal" | "returned"
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "entry" "(" String "," Int ")"
+                 | "endCall"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> entry("starts_one_ends", $N:Int) </k>
+      <function> noFunction </function>
+      <env> .Map </env>
+      <control> normal </control>
+      <result> noResult </result>
+    </mpy>
+
+  // Module evaluation registers top-level functions before the configured
+  // entry call is made.
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+       <control> normal </control>
+  rule <k> exec(_SS) => .K ... </k>
+       <control> returned </control>
+
+  rule <k> FuncDef(F, Params(P), BODY) => .K ... </k>
+       <function> _ => function(F, P, BODY) </function>
+
+  rule <k> entry(F, N) => exec(BODY) ~> endCall ... </k>
+       <function> function(F, P, BODY) </function>
+       <env> _ => P |-> N </env>
+       <control> normal </control>
+       <result> noResult </result>
+
+  rule <k> endCall => .K ... </k>
+       <control> returned => normal </control>
+
+  // A standalone expression (the function docstring here) has no externally
+  // observable effect in this integer-only fragment.
+  rule <k> Expr(_E) => .K ... </k>
+
+  rule <k> If(COND, THEN, _ELSE) => exec(THEN) ... </k>
+       <env> ENV </env>
+    requires evalBool(COND, ENV)
+  rule <k> If(COND, _THEN, ELSE) => exec(ELSE) ... </k>
+       <env> ENV </env>
+    requires notBool evalBool(COND, ENV)
+
+  rule <k> Return(E) => .K ... </k>
+       <env> ENV </env>
+       <control> normal => returned </control>
+       <result> noResult => result(evalInt(E, ENV)) </result>
+
+  // Pure expression semantics.  Keeping this layer independent of statement
+  // control makes it directly simplifiable in both execution and proofs.
+  syntax Int ::= evalInt(Expr, Map) [function]
+  rule evalInt(Int(I), _ENV) => I
+  rule evalInt(Name(X), (X |-> I) M) => I
+    requires notBool (X in_keys(M))
+  rule evalInt(BinOp("+", A, B), ENV) => evalInt(A, ENV) +Int evalInt(B, ENV)
+  rule evalInt(BinOp("-", A, B), ENV) => evalInt(A, ENV) -Int evalInt(B, ENV)
+  rule evalInt(BinOp("*", A, B), ENV) => evalInt(A, ENV) *Int evalInt(B, ENV)
+  rule evalInt(BinOp("**", A, B), ENV) => evalInt(A, ENV) ^Int evalInt(B, ENV)
+
+  syntax Bool ::= evalBool(Expr, Map) [function]
+  rule evalBool(Compare(A, CmpOp("==", B)), ENV)
+    => evalInt(A, ENV) ==Int evalInt(B, ENV)
+endmodule
