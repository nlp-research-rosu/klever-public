{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "6bfa896627657f1a7db8b47ce47b179a54d8fd758509fe97bf7a3ce73c03de68",
      "rationale": "This equation defines the named decimalMiddles summary as 10 raised to the nonnegative number of middle digit positions.",
      "source_rule_id": "rule-6bfa896627657f1a7db8b47ce47b179a54d8fd758509fe97bf7a3ce73c03de68",
      "start_line": 16,
      "text": "  rule decimalMiddles(K) => 10 ^Int K requires K >=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "900178d8e3d641d23088309b6f97b2e1ba72acc705ca5cef173a811620073c2e",
      "rationale": "This conditional equation defines the startsWithOne counting summary for multi-digit inputs in terms of decimalMiddles.",
      "source_rule_id": "rule-900178d8e3d641d23088309b6f97b2e1ba72acc705ca5cef173a811620073c2e",
      "start_line": 17,
      "text": "  rule startsWithOne(N) => 10 *Int decimalMiddles(N -Int 2)\n    requires N >Int 1"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 20,
      "module": "VERIFICATION",
      "normalized_sha256": "5dc8417368bc588fc6a024fbf8fcd66df9d65abff8a26efb5914cc28f7b3afdf",
      "rationale": "This conditional equation defines the endsWithOne counting summary for multi-digit inputs in terms of decimalMiddles.",
      "source_rule_id": "rule-5dc8417368bc588fc6a024fbf8fcd66df9d65abff8a26efb5914cc28f7b3afdf",
      "start_line": 19,
      "text": "  rule endsWithOne(N) => 9 *Int decimalMiddles(N -Int 2)\n    requires N >Int 1"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "e1973b68bd55ec1aee34975f8190d8904f9801ea819c77bc8458834d86548d92",
      "rationale": "This conditional equation defines the overlap summary startsAndEndsWithOne for multi-digit inputs.",
      "source_rule_id": "rule-e1973b68bd55ec1aee34975f8190d8904f9801ea819c77bc8458834d86548d92",
      "start_line": 21,
      "text": "  rule startsAndEndsWithOne(N) => decimalMiddles(N -Int 2)\n    requires N >Int 1"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "64e2ba1944740284efdfe861cce87ab814bafe93ef385139684238c5d2c0c9dd",
      "rationale": "This is the base-case equation defining qualifyingCount at the one-digit boundary.",
      "source_rule_id": "rule-64e2ba1944740284efdfe861cce87ab814bafe93ef385139684238c5d2c0c9dd",
      "start_line": 24,
      "text": "  rule qualifyingCount(1) => 1"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "0f5f78a079edc8e1768e03a4620c5a4efb5ed7021a834b19876e366334085298",
      "rationale": "This conditional equation defines qualifyingCount for multi-digit inputs by inclusion-exclusion over the three named counting summaries.",
      "source_rule_id": "rule-0f5f78a079edc8e1768e03a4620c5a4efb5ed7021a834b19876e366334085298",
      "start_line": 25,
      "text": "  rule qualifyingCount(N)\n    => startsWithOne(N) +Int endsWithOne(N) -Int startsAndEndsWithOne(N)\n    requires N >Int 1"
    }
  ],
