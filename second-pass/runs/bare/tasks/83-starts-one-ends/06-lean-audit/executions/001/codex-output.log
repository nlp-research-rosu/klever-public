diff --git a/evidence/proc_self_readlink_shim.c b/evidence/proc_self_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..3b5e5ae221b3aff2171f04aeedf406b4c0a97e51
--- /dev/null
+++ b/evidence/proc_self_readlink_shim.c
@@ -0,0 +1,37 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t index = sizeof(prefix) - 1;
+
+    if (strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    if (!isdigit((unsigned char)path[index])) {
+        return 0;
+    }
+    while (isdigit((unsigned char)path[index])) {
+        index++;
