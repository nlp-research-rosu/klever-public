+    for key in ("canonical", "translator", "trusted_prompt"):
+        require_regular(Path(audit["container_paths"][key]))
+
+    recorded = audit["hashes"]
+    direct_hashes = {
+        "audit_campaign_lock_sha256": lock_path,
