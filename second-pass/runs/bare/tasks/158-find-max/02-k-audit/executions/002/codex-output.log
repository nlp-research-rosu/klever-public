+    candidate = load_module("candidate_solution", CANDIDATE)
+
+    fixed = [
+        ("example-1", ["name", "of", "string"]),
+        ("example-2", ["name", "enam", "game"]),
+        ("example-3", ["aaaaaaa", "bb", "cc"]),
+        ("empty-boundary", []),
+        ("singleton-empty-word", [""]),
