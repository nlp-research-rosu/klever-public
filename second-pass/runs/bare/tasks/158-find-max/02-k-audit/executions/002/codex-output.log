+        ("unicode", ["😀a", "東京", "λλ"]),
+        ("nul-character", ["\x00a", "\x00"]),
+    ]
+    mismatches: list[tuple[str, list[str], tuple[str, str], tuple[str, str]]] = []
+    for label, words in fixed:
+        expected = outcome(canonical.find_max, words)
+        actual = outcome(candidate.find_max, words)
+        print(
+            json.dumps(
+                {
+                    "label": label,
+                    "words": words,
