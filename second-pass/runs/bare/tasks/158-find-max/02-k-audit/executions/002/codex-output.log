+
+def generated_cases() -> list[list[str]]:
+    rng = random.Random(158)
+    alphabet = ["", "a", "b", "c", "aa", "ab", "ba", "abc", "cba", "aaaa"]
+    unicode_pool = ["é", "e\u0301", "λ", "😀", "😀a", "\x00", "𐐀", "ß", "東京"]
