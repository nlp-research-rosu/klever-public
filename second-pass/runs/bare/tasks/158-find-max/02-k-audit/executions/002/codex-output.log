+    print(f"response item types={dict(sorted(response_item_types.items()))}")
+    print(f"tool calls={dict(sorted(tool_calls.items()))}")
+    print("PROVENANCE_CHECK_OK")
+    return 0
+
+
+if __name__ == "__main__":
