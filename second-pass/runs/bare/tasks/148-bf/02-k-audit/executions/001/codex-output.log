new file mode 100644
index 0000000000000000000000000000000000000000..12e0ec21e0388d46d4650ff582fbca52c6b34b27
--- /dev/null
+++ b/evidence/stage3_rebuild.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -euo pipefail
+set -x
+
+command -v kompile
+command -v krun
+command -v kprove
+kompile --version
+krun --version
+kprove --version
+
+python3 /reference/py2mpy.py solution.py > solution-audit-regenerated.mpy
+cmp solution.mpy solution-audit-regenerated.mpy
+
+sha256sum solution-program.k spec.k mutation-spec.k
+python3 generate_proof_artifacts.py
+cmp solution-program.k /tmp/audit-work/candidate-src/solution-program.k
+cmp spec.k /tmp/audit-work/candidate-src/spec.k
+cmp mutation-spec.k /tmp/audit-work/candidate-src/mutation-spec.k
+sha256sum solution-program.k spec.k mutation-spec.k
+
+kompile semantic.k \
+  --backend llvm \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --output-definition semantic-audit-kompiled
+
+python3 /audit-output/evidence/concrete_compare.py
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --output-definition verification-audit-kompiled
+
+test "$(rg -c '^  claim$' spec.k)" -eq 73
+rg -c '^  claim$' spec.k
+
+kprove spec.k \
+  --definition verification-audit-kompiled \
+  --spec-module BF-SPEC

exec
/bin/bash -lc "mkdir -p /tmp/audit-work/body-mutation
cp /tmp/audit-work/candidate-src/*.k /tmp/audit-work/candidate-src/*.py /tmp/audit-work/candidate-src/*.mpy /tmp/audit-work/candidate-src/*.sh /tmp/audit-work/body-mutation/
find /tmp/audit-work/body-mutation -maxdepth 1 -type f -printf '%f\\n' | sort" in /audit-output
 succeeded in 0ms:
generate_proof_artifacts.py
mutation-spec.k
prompt.py
prove.sh
py2mpy.py
semantic.k
solution-program.k
solution.mpy
solution.py
spec.k
verification.k

