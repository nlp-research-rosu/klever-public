+            return ("Jupiter",)
+        if planet2 == "Uranus":
+            return ("Jupiter", "Saturn")
+        if planet2 == "Neptune":
+            return ("Jupiter", "Saturn", "Uranus")
+        return ()
+
+    if planet1 == "Jupiter":
+        if planet2 == "Mercury":
+            return ("Venus", "Earth", "Mars")
+        if planet2 == "Venus":
+            return ("Earth", "Mars")
+        if planet2 == "Earth":
+            return ("Mars",)
