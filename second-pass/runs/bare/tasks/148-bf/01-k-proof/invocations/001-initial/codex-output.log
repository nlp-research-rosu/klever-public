+# The standalone program parser infers an empty Stmts list from `, )`. Inside
+# a K rule, the term parser requires the explicit list unit.
+for index, line in enumerate(mpy_lines):
+    if (
+        line.strip() == ")"
+        and index > 0
+        and mpy_lines[index - 1].rstrip().endswith(",")
+    ):
+        mpy_lines[index] = line[: len(line) - len(line.lstrip())] + ".Stmts)"
+mpy = "\n".join(mpy_lines).replace("TupleExpr()", "TupleExpr(.Exprs)")
+program_module = (
+    'requires "semantic.k"\n\n'
+    "module SOLUTION-PROGRAM\n"
+    "  imports MPY-SYNTAX\n\n"
+    '  syntax Program ::= "solutionProgram"\n'
+    "  rule solutionProgram =>\n"
+    + "\n".join("    " + line for line in mpy.splitlines())
+    + "\n"
+    "endmodule\n"
+)
+Path("solution-program.k").write_text(program_module, encoding="utf-8")
+
+claims = []
+for first_index, first in enumerate(PLANETS):
+    for second_index, second in enumerate(PLANETS):
+        lo = min(first_index, second_index) + 1
+        hi = max(first_index, second_index)
+        claims.append(
+            claim(
+                k_string(first),
+                k_string(second),
+                PLANETS[lo:hi],
+            )
+        )
+
+not_a_planet_1 = " andBool ".join(
+    "P1 =/=String " + k_string(planet) for planet in PLANETS
+)
+claims.append(claim("P1", "P2", (), not_a_planet_1))
+
+not_a_planet_2 = " andBool ".join(
+    "P2 =/=String " + k_string(planet) for planet in PLANETS
+)
+for first in PLANETS:
+    claims.append(claim(k_string(first), "P2", (), not_a_planet_2))
+
+spec = (
+    'requires "verification.k"\n\n'
+    "module BF-SPEC\n"
+    "  imports VERIFICATION\n\n"
+    + "\n\n".join(claims)
+    + "\nendmodule\n"
+)
+Path("spec.k").write_text(spec, encoding="utf-8")
+
+mutation_spec = (
+    'requires "verification.k"\n\n'
+    "module MUTATION-SPEC\n"
+    "  imports VERIFICATION\n\n"
+    + claim(
+        k_string("Mercury"),
+        k_string("Neptune"),
+        (),
+    )
+    + "\nendmodule\n"
+)
+Path("mutation-spec.k").write_text(mutation_spec, encoding="utf-8")
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..23c06aa610995bcca5091d8aa4f00880f2d35c75
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 generate_proof_artifacts.py
+
+python3 - <<'PY'
+from solution import bf
+
+planets = (
+    "Mercury",
+    "Venus",
+    "Earth",
+    "Mars",
+    "Jupiter",
+    "Saturn",
+    "Uranus",
+    "Neptune",
+)
+samples = planets + ("Pluto", "", "mercury")
+for first in samples:
+    for second in samples:
+        if first in planets and second in planets:
+            lo = min(planets.index(first), planets.index(second)) + 1
+            hi = max(planets.index(first), planets.index(second))
+            expected = planets[lo:hi]
+        else:
+            expected = ()
+        assert bf(first, second) == expected
+print("Python reference partition: passed")
+PY
+
+kompile semantic.k \
+  --backend llvm \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --output-definition semantic-kompiled
+
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cPLANET1='"Jupiter"' \
+  -cPLANET2='"Neptune"'
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cPLANET1='"Earth"' \
+  -cPLANET2='"Mercury"'
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cPLANET1='"Mercury"' \
+  -cPLANET2='"Uranus"'
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cPLANET1='"Pluto"' \
+  -cPLANET2='"Earth"'
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module BF-SPEC
+
+if kprove mutation-spec.k \
+  --definition verification-kompiled \
+  --spec-module MUTATION-SPEC
+then
+  echo "ERROR: deliberately false mutation claim unexpectedly proved" >&2
+  exit 1
+else
+  echo "Mutation probe: rejected as expected"
+fi
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..a67dc32bb2475138d0eb0cfd47b34d9bd3bcea51
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,115 @@
+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Names ")"
+  syntax Names ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "TupleExpr" "(" Exprs ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Exprs ::= List{Expr, ","}
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+
+  syntax KItem ::= "invokeBF" "(" String "," String ")"
+                 | "execStmt" "(" Stmt ")"
+  syntax Result ::= "noResult"
+                  | "tupleValue" "(" StringValues ")"
+  syntax StringValues ::= List{String, ","}
+
+  configuration
+    <bf>
+      <k> $PGM:Program ~> invokeBF($PLANET1:String, $PLANET2:String) </k>
+      <planet1> "" </planet1>
+      <planet2> "" </planet2>
+      <result> noResult </result>
+    </bf>
+
+  rule <k> Module(FuncDef("bf", Params("planet1", "planet2"), BODY))
+             ~> invokeBF(P1, P2)
+          => BODY
+       ... </k>
+       <planet1> "" => P1 </planet1>
+       <planet2> "" => P2 </planet2>
+
+  rule <k> (S:Stmt REST:Stmts) => execStmt(S) ~> REST ... </k>
+  rule <k> .Stmts => .K ... </k>
+
+  rule <k> execStmt(
+             If(Compare(Name("planet1"), CmpOp("==", Str(S))), THEN, _ELSE))
+          => THEN
+       ... </k>
+       <planet1> P1 </planet1>
+    requires P1 ==String S
+
+  rule <k> execStmt(
+             If(Compare(Name("planet1"), CmpOp("==", Str(S))), _THEN, ELSE))
+          => ELSE
+       ... </k>
+       <planet1> P1 </planet1>
+    requires P1 =/=String S
+
+  rule <k> execStmt(
+             If(Compare(Name("planet2"), CmpOp("==", Str(S))), THEN, _ELSE))
+          => THEN
+       ... </k>
+       <planet2> P2 </planet2>
+    requires P2 ==String S
+
+  rule <k> execStmt(
+             If(Compare(Name("planet2"), CmpOp("==", Str(S))), _THEN, ELSE))
+          => ELSE
+       ... </k>
+       <planet2> P2 </planet2>
+    requires P2 =/=String S
+
+  rule <k> execStmt(Return(TupleExpr(.Exprs))) ~> _REST => .K </k>
+       <result> noResult => tupleValue(.StringValues) </result>
+
+  rule <k> execStmt(Return(TupleExpr(Str(S1)))) ~> _REST => .K </k>
+       <result> noResult => tupleValue(S1) </result>
+
+  rule <k> execStmt(Return(TupleExpr(Str(S1), Str(S2)))) ~> _REST => .K </k>
+       <result> noResult => tupleValue(S1, S2) </result>
+
+  rule <k> execStmt(Return(TupleExpr(Str(S1), Str(S2), Str(S3))))
+          ~> _REST
+          => .K
+       </k>
+       <result> noResult => tupleValue(S1, S2, S3) </result>
+
+  rule <k> execStmt(
+             Return(TupleExpr(Str(S1), Str(S2), Str(S3), Str(S4))))
+          ~> _REST
+          => .K
+       </k>
+       <result> noResult => tupleValue(S1, S2, S3, S4) </result>
+
+  rule <k> execStmt(
+             Return(
+               TupleExpr(Str(S1), Str(S2), Str(S3), Str(S4), Str(S5))))
+          ~> _REST
+          => .K
+       </k>
+       <result> noResult => tupleValue(S1, S2, S3, S4, S5) </result>
+
+  rule <k> execStmt(
+             Return(
+               TupleExpr(
+                 Str(S1), Str(S2), Str(S3), Str(S4), Str(S5), Str(S6))))
+          ~> _REST
+          => .K
+       </k>
+       <result> noResult => tupleValue(S1, S2, S3, S4, S5, S6) </result>
+endmodule
