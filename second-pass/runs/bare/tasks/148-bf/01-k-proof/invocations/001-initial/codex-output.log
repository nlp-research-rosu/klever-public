+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Names ")"
+  syntax Names ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "TupleExpr" "(" Exprs ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Exprs ::= List{Expr, ","}
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+
+  syntax KItem ::= "invokeBF" "(" String "," String ")"
+  syntax Result ::= "noResult"
+                  | Expr
+
+  configuration
+    <bf>
+      <k> $PGM:Program ~> invokeBF($PLANET1:String, $PLANET2:String) </k>
+      <planet1> "" </planet1>
+      <planet2> "" </planet2>
+      <result> noResult </result>
+    </bf>
+
+  rule <k> Module(FuncDef("bf", Params("planet1", "planet2"), BODY))
+             ~> invokeBF(P1, P2)
+          => BODY
+       ... </k>
+       <planet1> "" => P1 </planet1>
+       <planet2> "" => P2 </planet2>
+
+  rule <k> (S:Stmt REST:Stmts) => S ~> REST ... </k>
+  rule <k> .Stmts => .K ... </k>
+
+  rule <k> If(Compare(Name("planet1"), CmpOp("==", Str(S))), THEN, _ELSE)
+          => THEN
+       ... </k>
+       <planet1> P1 </planet1>
+    requires P1 ==String S
+
+  rule <k> If(Compare(Name("planet1"), CmpOp("==", Str(S))), _THEN, ELSE)
+          => ELSE
+       ... </k>
+       <planet1> P1 </planet1>
+    requires P1 =/=String S
+
+  rule <k> If(Compare(Name("planet2"), CmpOp("==", Str(S))), THEN, _ELSE)
+          => THEN
+       ... </k>
+       <planet2> P2 </planet2>
+    requires P2 ==String S
+
+  rule <k> If(Compare(Name("planet2"), CmpOp("==", Str(S))), _THEN, ELSE)
+          => ELSE
+       ... </k>
+       <planet2> P2 </planet2>
+    requires P2 =/=String S
+
+  rule <k> Return(E) ~> _REST => .K </k>
+       <result> noResult => E </result>
+endmodule
