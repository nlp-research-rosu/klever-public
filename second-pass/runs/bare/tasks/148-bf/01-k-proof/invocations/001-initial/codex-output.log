+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cPLANET1='"Jupiter"' \
+  -cPLANET2='"Neptune"'
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cPLANET1='"Earth"' \
+  -cPLANET2='"Mercury"'
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cPLANET1='"Mercury"' \
+  -cPLANET2='"Uranus"'
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cPLANET1='"Pluto"' \
+  -cPLANET2='"Earth"'
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module BF-SPEC
+
+if kprove mutation-spec.k \
