     1	module MPY-SYNTAX
     2	  imports DOMAINS
     3	
     4	  syntax Program ::= "Module" "(" Stmts ")"
     5	
     6	  syntax Stmts ::= List{Stmt, ""}
     7	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
     8	                | "If" "(" Expr "," Stmts "," Stmts ")"
     9	                | "Return" "(" Expr ")"
    10	
    11	  syntax Params ::= "Params" "(" Names ")"
    12	  syntax Names ::= List{String, ","}
    13	
    14	  syntax Expr ::= "Name" "(" String ")"
    15	                | "Str" "(" String ")"
    16	                | "Compare" "(" Expr "," CmpOp ")"
    17	                | "TupleExpr" "(" Exprs ")"
    18	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    19	  syntax Exprs ::= List{Expr, ","}
    20	endmodule
    21	
    22	module MPY
    23	  imports MPY-SYNTAX
    24	
    25	  syntax KItem ::= "invokeBF" "(" String "," String ")"
    26	                 | "execStmt" "(" Stmt ")"
    27	  syntax Result ::= "noResult"
    28	                  | "tupleValue" "(" StringValues ")"
    29	  syntax StringValues ::= List{String, ","}
    30	
    31	  configuration
    32	    <bf>
    33	      <k> $PGM:Program ~> invokeBF($PLANET1:String, $PLANET2:String) </k>
    34	      <planet1> "" </planet1>
    35	      <planet2> "" </planet2>
    36	      <result> noResult </result>
    37	    </bf>
    38	
    39	  rule <k> Module(FuncDef("bf", Params("planet1", "planet2"), BODY))
    40	             ~> invokeBF(P1, P2)
    41	          => BODY
    42	       ... </k>
    43	       <planet1> "" => P1 </planet1>
    44	       <planet2> "" => P2 </planet2>
    45	
    46	  rule <k> (S:Stmt REST:Stmts) => execStmt(S) ~> REST ... </k>
    47	  rule <k> .Stmts => .K ... </k>
    48	
    49	  rule <k> execStmt(
    50	             If(Compare(Name("planet1"), CmpOp("==", Str(S))), THEN, _ELSE))
    51	          => THEN
    52	       ... </k>
    53	       <planet1> P1 </planet1>
    54	    requires P1 ==String S
    55	
    56	  rule <k> execStmt(
    57	             If(Compare(Name("planet1"), CmpOp("==", Str(S))), _THEN, ELSE))
    58	          => ELSE
    59	       ... </k>
    60	       <planet1> P1 </planet1>
    61	    requires P1 =/=String S
    62	
    63	  rule <k> execStmt(
    64	             If(Compare(Name("planet2"), CmpOp("==", Str(S))), THEN, _ELSE))
    65	          => THEN
    66	       ... </k>
    67	       <planet2> P2 </planet2>
    68	    requires P2 ==String S
    69	
    70	  rule <k> execStmt(
    71	             If(Compare(Name("planet2"), CmpOp("==", Str(S))), _THEN, ELSE))
    72	          => ELSE
    73	       ... </k>
    74	       <planet2> P2 </planet2>
    75	    requires P2 =/=String S
    76	
    77	  rule <k> execStmt(Return(TupleExpr(.Exprs))) ~> _REST => .K </k>
    78	       <result> noResult => tupleValue(.StringValues) </result>
    79	
    80	  rule <k> execStmt(Return(TupleExpr(Str(S1)))) ~> _REST => .K </k>
    81	       <result> noResult => tupleValue(S1) </result>
    82	
    83	  rule <k> execStmt(Return(TupleExpr(Str(S1), Str(S2)))) ~> _REST => .K </k>
    84	       <result> noResult => tupleValue(S1, S2) </result>
    85	
    86	  rule <k> execStmt(Return(TupleExpr(Str(S1), Str(S2), Str(S3))))
    87	          ~> _REST
    88	          => .K
    89	       </k>
    90	       <result> noResult => tupleValue(S1, S2, S3) </result>
    91	
    92	  rule <k> execStmt(
    93	             Return(TupleExpr(Str(S1), Str(S2), Str(S3), Str(S4))))
    94	          ~> _REST
    95	          => .K
    96	       </k>
    97	       <result> noResult => tupleValue(S1, S2, S3, S4) </result>
    98	
    99	  rule <k> execStmt(
   100	             Return(
   101	               TupleExpr(Str(S1), Str(S2), Str(S3), Str(S4), Str(S5))))
   102	          ~> _REST
   103	          => .K
   104	       </k>
   105	       <result> noResult => tupleValue(S1, S2, S3, S4, S5) </result>
   106	
   107	  rule <k> execStmt(
   108	             Return(
   109	               TupleExpr(
   110	                 Str(S1), Str(S2), Str(S3), Str(S4), Str(S5), Str(S6))))
   111	          ~> _REST
   112	          => .K
   113	       </k>
   114	       <result> noResult => tupleValue(S1, S2, S3, S4, S5, S6) </result>
   115	endmodule
