Traceback (most recent call last):
  File "<string>", line 1, in <module>
FileNotFoundError: [Errno 2] No such file or directory: '/proc/3/exe'

codex
The root cause is a PID-namespace/procfs mismatch: Lean asks for `/proc/<namespace-pid>/exe`, while this container’s procfs exposes that process only through `/proc/self/exe`. I’m applying a narrow audit-local runtime shim that rewrites only `/proc/<digits>/exe` `readlink` calls to `/proc/self/exe`; it does not alter the project or verification inputs. This lets the pinned Lean binary identify itself normally.
apply patch
patch: completed
/audit-output/evidence/procfs-readlink-shim.c
diff --git a/evidence/procfs-readlink-shim.c b/evidence/procfs-readlink-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..1d5169f360ab1f2c7e96480e86c201e96d724180
--- /dev/null
+++ b/evidence/procfs-readlink-shim.c
@@ -0,0 +1,44 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    static const char prefix[] = "/proc/";
+    static const char suffix[] = "/exe";
+    const char *cursor;
+    size_t length;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    length = strlen(path);
+    if (length <= sizeof(prefix) - 1 + sizeof(suffix) - 1
+        || strcmp(path + length - (sizeof(suffix) - 1), suffix) != 0) {
+        return 0;
+    }
+    cursor = path + sizeof(prefix) - 1;
+    while (cursor < path + length - (sizeof(suffix) - 1)) {
+        if (*cursor < '0' || *cursor > '9') {
+            return 0;
+        }
+        ++cursor;
+    }
+    return 1;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_proc_pid_exe(path)) {
+        path = "/proc/self/exe";
+    }
+    return real_readlink(path, buffer, size);
+}

