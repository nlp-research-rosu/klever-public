+            Compare(Name("a"), CmpOp("==", Int(50))),
+            Compare(Name("a"), CmpOp("==", Int(52))),
+            Compare(Name("a"), CmpOp("==", Int(63))),
+            Compare(Name("a"), CmpOp("==", Int(66))),
+            Compare(Name("a"), CmpOp("==", Int(68))),
+            Compare(Name("a"), CmpOp("==", Int(70))),
