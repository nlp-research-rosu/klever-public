diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..aedbadf339785bdaafc2f9c82a83ef8d5a985445
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the fixed translator output and ensure it is exactly the program
+# term embedded by solution-program.k.
+python3 py2mpy.py solution.py > solution.mpy
+printf '%s  %s\n' \
+  '2ed20f37c9f9cc534ea932248a2599788f3e6de80cc7303669d627aef0439709' \
+  'solution.mpy' | sha256sum --check --status
+
+# Build the hand-written semantics plus its verification helpers.
+kompile definition.k \
+  --backend haskell \
+  --main-module DEFINITION \
+  --syntax-module MPY-SYNTAX
+
+# Exercise positive, negative, boundary, and out-of-domain inputs.
+krun solution.mpy --definition definition-kompiled -cARG=30
+krun solution.mpy --definition definition-kompiled -cARG=10
+krun solution.mpy --definition definition-kompiled -cARG=99
+krun solution.mpy --definition definition-kompiled -cARG=-7
+
+# This is the required positive target proof.  The explicit check makes any
+# non-#Top result fail the script even if a backend ever exits successfully.
+proof_output="$({
+  kprove spec.k \
+    --definition definition-kompiled \
+    --spec-module SPEC
+})"
+printf '%s\n' "$proof_output"
+[[ "$proof_output" == '#Top' ]]
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..fc982d54a532aded5bc06aeb184101638cff77fa
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,71 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // Concrete syntax emitted by py2mpy.py for the subset used by solution.py.
+  syntax Pgm
+  syntax Stmt
+  syntax Expr
+  syntax Params
+  syntax CmpOp
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Exprs ::= List{Expr, ","}
+  syntax Strings ::= List{String, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports MAP
+  imports INT
+  imports BOOL
+
+  syntax Result ::= "noResult" | Expr
+  syntax KItem ::= "execute" "(" Stmts ")"
+
+  // Big-step expression evaluators.  The rules implement Python equality and
+  // short-circuit `or` for the expression forms present in the translated AST.
+  syntax Bool ::= evalBool(Expr, Map) [function]
+  syntax Bool ::= evalOr(Exprs, Map) [function]
+
+  rule evalBool(Bool(B), _) => B
+  rule evalBool(
+         Compare(Name(X), (CmpOp("==", Int(I)), .CmpOps)),
+         X |-> Int(A))
+    => A ==Int I
+  rule evalBool(BoolOp("or", ES), ENV) => evalOr(ES, ENV)
+
+  rule evalOr(.Exprs, _) => false
+  rule evalOr((E:Expr, ES:Exprs), ENV)
+    => evalBool(E, ENV) orElseBool evalOr(ES, ENV)
+
+  configuration
+    <k> $PGM:Pgm </k>
+    <arg> $ARG:Int </arg>
+    <env> .Map </env>
+    <result> noResult </result>
+
+  // The task has one module-level, unary entry point.  Loading the module binds
+  // its formal to the supplied <arg> and executes its body.
+  rule <k> Module(FuncDef(_F, Params(P:String), BODY)) => execute(BODY) </k>
+       <arg> A </arg>
+       <env> .Map => P |-> Int(A) </env>
+
+  rule <k> execute(Return(E)) => .K </k>
+       <env> ENV => .Map </env>
+       <result> noResult => Bool(evalBool(E, ENV)) </result>
+endmodule
