+    )
+    == generator["obligation_map_sha256"],
+    {
+        "actual": sha256_file(
+            Path(
+                "/reference/klean-generation/generated/obligation-map.json"
+            )
+        ),
+        "recorded": generator["obligation_map_sha256"],
+    },
+)
+actual_target = target_statement(
