+    and "isThreePrimeProductBelow100" not in rule["text"].split("=>", 1)[1],
+    {
+        "has_k_cell": "<k>" in rule["text"],
+        "recursive_rhs": "isThreePrimeProductBelow100"
+        in rule["text"].split("=>", 1)[1],
+    },
+)
+
+print("\nSTAGE 4 OBLIGATION AND TARGET IDENTITY")
+require(
