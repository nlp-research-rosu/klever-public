+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    if (!real_readlink)
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    ssize_t result = real_readlink(path, buf, size);
