+        "actual": canonical_json_sha256(canonical_rules),
+        "recorded": inventory["inventory_sha256"],
+    },
+)
+require(
+    "ordered source-rule identity bijection",
+    canonical_ids == manifest_ids
+    and len(manifest_ids) == len(set(manifest_ids)),
