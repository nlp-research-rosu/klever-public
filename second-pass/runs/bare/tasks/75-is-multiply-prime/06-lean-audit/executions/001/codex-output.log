+    },
+)
+
+print("\nINDEPENDENT MATHEMATICAL ADEQUACY")
+primes = [number for number in range(2, 100) if is_prime(number)]
+oracle_products = sorted(
+    {
+        p * q * r
+        for i, p in enumerate(primes)
+        for j, q in enumerate(primes[i:], start=i)
