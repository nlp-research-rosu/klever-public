+    == resolution["hashes"]["generated_tree_sha256"]
+    == generator["generated_tree_sha256"]
+    == export_result["generated_tree_sha256"],
+    {
+        "actual": generated_hash,
+        "launcher": resolution["hashes"]["generated_tree_sha256"],
+    },
+)
+require(
