index 0000000000000000000000000000000000000000..8d959da2184e2d6839e2afd311b37cdc9b46d354
--- /dev/null
+++ b/evidence/spec-ground.k
@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  // Satisfying witness: 30 < 100, empty environment, no initial result.
+  claim
+    <k> solutionProgram => .K </k>
+    <arg> 30 </arg>
+    <env> .Map </env>
+    <result> noResult => Bool(true) </result>
+
+  // A second satisfying witness exercises the false result.
+  claim
+    <k> solutionProgram => .K </k>
+    <arg> 10 </arg>
+    <env> .Map </env>
+    <result> noResult => Bool(false) </result>
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..462b85af8d1f7febc7fd795742be045eeec2d105
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,17 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh false mutation: demand the logical complement of the real result.
+  // Satisfying counterexample A=30: the program returns true, but this demands
+  // false because isThreePrimeProductBelow100(30) is true.
+  claim
+    <k> solutionProgram => .K </k>
+    <arg> A </arg>
+    <env> .Map </env>
+    <result>
+      noResult => Bool(notBool isThreePrimeProductBelow100(A))
+    </result>
+    requires A <Int 100
+endmodule
