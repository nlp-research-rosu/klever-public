FILE /tmp/audit-work/rebuild/verification.k
     1	requires "solution-program.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	  imports SOLUTION-PROGRAM
     6	
     7	  // A finite mathematical characterization of the contract.  Each disjunct
     8	  // is p*q*r for one nondecreasing prime triple p<=q<=r whose product is below
     9	  // 100.  Ordering loses nothing because multiplication is commutative.
    10	  syntax Bool ::= isThreePrimeProductBelow100(Int) [function]
    11	  rule isThreePrimeProductBelow100(A) =>
    12	       A ==Int (2 *Int 2 *Int 2)
    13	    orBool A ==Int (2 *Int 2 *Int 3)
    14	    orBool A ==Int (2 *Int 3 *Int 3)
    15	    orBool A ==Int (2 *Int 2 *Int 5)
    16	    orBool A ==Int (3 *Int 3 *Int 3)
    17	    orBool A ==Int (2 *Int 2 *Int 7)
    18	    orBool A ==Int (2 *Int 3 *Int 5)
    19	    orBool A ==Int (2 *Int 3 *Int 7)
    20	    orBool A ==Int (2 *Int 2 *Int 11)
    21	    orBool A ==Int (3 *Int 3 *Int 5)
    22	    orBool A ==Int (2 *Int 5 *Int 5)
    23	    orBool A ==Int (2 *Int 2 *Int 13)
    24	    orBool A ==Int (3 *Int 3 *Int 7)
    25	    orBool A ==Int (2 *Int 3 *Int 11)
    26	    orBool A ==Int (2 *Int 2 *Int 17)
    27	    orBool A ==Int (2 *Int 5 *Int 7)
    28	    orBool A ==Int (3 *Int 5 *Int 5)
    29	    orBool A ==Int (2 *Int 2 *Int 19)
    30	    orBool A ==Int (2 *Int 3 *Int 13)
    31	    orBool A ==Int (2 *Int 2 *Int 23)
    32	    orBool A ==Int (2 *Int 7 *Int 7)
    33	    orBool A ==Int (3 *Int 3 *Int 11)
    34	    [simplification]
    35	endmodule
