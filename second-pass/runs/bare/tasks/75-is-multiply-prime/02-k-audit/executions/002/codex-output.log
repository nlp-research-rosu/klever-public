+generated_sample = [rng.randint(-10**9, 99) for _ in range(40)]
+exhaustive_small = list(range(-250, 100))
+inputs = sorted(
+    set(documented_and_boundary + branch_boundaries + generated_sample + exhaustive_small)
+)
