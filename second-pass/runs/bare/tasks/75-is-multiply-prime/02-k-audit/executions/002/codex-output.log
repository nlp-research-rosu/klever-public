new file mode 100644
index 0000000000000000000000000000000000000000..d31b10718a7bbe4c2175098bffa1dc4e28aa6cf6
--- /dev/null
+++ b/evidence/solution-program-body-mutation.k
@@ -0,0 +1,37 @@
+requires "semantic.k"
+
+module SOLUTION-PROGRAM
+  imports MPY-SYNTAX
+
+  // Reviewer body-sensitivity mutation: the first executable comparison is
+  // deliberately changed from a == 8 to a == 9.
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
