+krun /audit-output/evidence/short-circuit-true.mpy \
+  --definition concrete-kompiled \
+  -cARG=0 | tee short-circuit-true.out
+rg -U '<result>[[:space:]]*Bool \( true \)[[:space:]]*</result>' \
