diff --git a/evidence/stage5_short_circuit.sh b/evidence/stage5_short_circuit.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0a2a5f7d0d88ed37440b6d6e2adbc0c9bb0bce82
