   212	class Inj (From To : Type) : Type where
   213	  inj (x : From) : To
   214	  retr (x : To) : Option From
   215	
   216	def inj {From To : Type} [inst : Inj From To] := inst.inj
   217	def retr {From To : Type} [inst : Inj From To] := inst.retr
