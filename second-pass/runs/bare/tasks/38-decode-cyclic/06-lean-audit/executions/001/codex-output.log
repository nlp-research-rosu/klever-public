+import Proof
+
+#eval Proof.«_<=Int_» (-3) (-4)
+#eval Proof.«_<=Int_» (-3) 0
+#eval Proof.«lengthString(_)_STRING-COMMON_Int_String» "A😀éZ"
+#eval Proof.«substrString(_,_,_)_STRING-COMMON_String_String_Int_Int» "A😀éZ" 1 3
+#eval Proof.«substrString(_,_,_)_STRING-COMMON_String_String_Int_Int» "A😀éZ" 2 2
+
+example (old new other : SortKItem) :
+    (Proof.«Map:update»
+      ⟨[(SortKItem.inj_SortInt 1, old), (SortKItem.inj_SortInt 2, other)]⟩
+      (SortKItem.inj_SortInt 1) new).coll =
+    [(SortKItem.inj_SortInt 1, new), (SortKItem.inj_SortInt 2, other)] := by
+  simp [Proof.«Map:update»]
+
+example (new : SortKItem) :
+    (Proof.«Map:update» ⟨[]⟩ (SortKItem.inj_SortInt 3) new).coll =
+    [(SortKItem.inj_SortInt 3, new)] := by
+  simp [Proof.«Map:update»]
