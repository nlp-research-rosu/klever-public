{ set -x; PYTHONPATH=/reference python /audit-output/evidence/independent_checks.py; code=$?; printf '"'FINAL_RERUN_EXIT_CODE=%s\\n' \""'$code"; exit "$code"; } 2>&1 | tee -a /audit-output/evidence/independent-checks.log' in /audit-output
