+)
+print(
+    "INFO lean_invocation_sha256 cannot be re-hashed: "
+    "the Stage 5 invocation directory is recorded but is not mounted; "
+    f"recorded={hashes['lean_invocation_sha256']}"
+)
+print("ALL INDEPENDENT STRUCTURAL CHECKS PASSED")

