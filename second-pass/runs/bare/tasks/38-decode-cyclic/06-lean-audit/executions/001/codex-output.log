+import Proof
+
+#eval Proof.«_<=Int_» (-3) (-4)
+#eval Proof.«_<=Int_» (-3) 0
+#eval Proof.«lengthString(_)_STRING-COMMON_Int_String» "A😀éZ"
+#eval Proof.«substrString(_,_,_)_STRING-COMMON_String_String_Int_Int» "A😀éZ" 1 3
+#eval Proof.«substrString(_,_,_)_STRING-COMMON_String_String_Int_Int» "A😀éZ" 2 2
+
+example (old new other : SortKItem) :
+    (Proof.«Map:update»
+      ⟨[(SortKItem.inj_SortInt 1, old), (SortKItem.inj_SortInt 2, other)]⟩
+      (SortKItem.inj_SortInt 1) new).coll =
+    [(SortKItem.inj_SortInt 1, new), (SortKItem.inj_SortInt 2, other)] := by
+  simp [Proof.«Map:update»]
+
+example (new : SortKItem) :
+    (Proof.«Map:update» ⟨[]⟩ (SortKItem.inj_SortInt 3) new).coll =
+    [(SortKItem.inj_SortInt 3, new)] := by
+  simp [Proof.«Map:update»]
diff --git a//tmp/audit-work/stage5-fresh/Counterfactual.lean b//tmp/audit-work/stage5-fresh/Counterfactual.lean
new file mode 100644
index 0000000000000000000000000000000000000000..f2f3e13aa7ac71a6b70b96d4fc2067daf067c072
--- /dev/null
+++ b//tmp/audit-work/stage5-fresh/Counterfactual.lean
@@ -0,0 +1,26 @@
+import Klean38DecodeCyclic.Lemmas
+
+namespace Counterfactual
+
+def badLE (_ _ : SortInt) : SortBool := true
+
+def badUpdate (_ : SortMap) (key value : SortKItem) : SortMap :=
+  ⟨[(key, value)]⟩
+
+def badLength (_ : SortString) : SortInt := 0
+
+def badSubstring (s : SortString) (_ _ : SortInt) : SortString := s
+
+theorem badFinal :
+    Klean38DecodeCyclic.Lemmas.targetStatement
+      badLE badUpdate badLength badSubstring := by
+  constructor
+  · intro V' K M V
+    simp [badUpdate]
+  constructor
+  · intro S
+    rfl
+  · intro S
+    rfl
+
+end Counterfactual
