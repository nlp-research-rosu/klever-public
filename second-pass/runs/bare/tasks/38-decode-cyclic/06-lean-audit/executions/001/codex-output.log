+        == {
+            "start_line": rule["start_line"],
+            "end_line": rule["end_line"],
+        },
+        obligation["source_span"],
+    )
+    for field in (
+        "source_rule_id",
+        "normalized_sha256",
+        "inventory_sha256",
+        "discovery_manifest_sha256",
+    ):
+        check(
+            f"obligation {index} {field}",
