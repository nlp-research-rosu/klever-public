+example (old new other : SortKItem) :
+    (Proof.«Map:update»
+      ⟨[(SortKItem.inj_SortInt 1, old), (SortKItem.inj_SortInt 2, other)]⟩
+      (SortKItem.inj_SortInt 1) new).coll =
