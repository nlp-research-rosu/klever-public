diff --git a//tmp/audit-work/stage5-fresh/Counterfactual.lean b//tmp/audit-work/stage5-fresh/Counterfactual.lean
new file mode 100644
index 0000000000000000000000000000000000000000..f2f3e13aa7ac71a6b70b96d4fc2067daf067c072
--- /dev/null
+++ b//tmp/audit-work/stage5-fresh/Counterfactual.lean
@@ -0,0 +1,26 @@
+import Klean38DecodeCyclic.Lemmas
+
+namespace Counterfactual
+
+def badLE (_ _ : SortInt) : SortBool := true
+
+def badUpdate (_ : SortMap) (key value : SortKItem) : SortMap :=
+  ⟨[(key, value)]⟩
+
+def badLength (_ : SortString) : SortInt := 0
+
+def badSubstring (s : SortString) (_ _ : SortInt) : SortString := s
+
+theorem badFinal :
+    Klean38DecodeCyclic.Lemmas.targetStatement
+      badLE badUpdate badLength badSubstring := by
+  constructor
+  · intro V' K M V
+    simp [badUpdate]
+  constructor
+  · intro S
+    rfl
+  · intro S
+    rfl
+
+end Counterfactual
