+LAKE_OVERRIDE_LEAN=true
+
+EXIT
+0
+
+EXACT OUTPUT
+Proof.final :
+  Klean38DecodeCyclic.Lemmas.targetStatement Proof.«_<=Int_» Proof.«Map:update»
+    Proof.«lengthString(_)_STRING-COMMON_Int_String» Proof.«substrString(_,_,_)_STRING-COMMON_String_String_Int_Int»
+theorem Proof.final : Klean38DecodeCyclic.Lemmas.targetStatement Proof.«_<=Int_» Proof.«Map:update»
+  Proof.«lengthString(_)_STRING-COMMON_Int_String» Proof.«substrString(_,_,_)_STRING-COMMON_String_String_Int_Int» :=
+⟨fun V' K M V =>
+  {
+    mp := fun h =>
+      have hcoll := congrArg SortMap.coll h;
+      Eq.mp
+        (Eq.trans
+          (Eq.trans
+            (congr
+              (congrArg (fun x => Eq { coll := (K, V) :: List.filter x M.coll }.coll)
+                (funext fun entry => Classical.decide_not (entry.fst = K)))
+              (congrArg (fun x => { coll := (K, V') :: List.filter x M.coll }.coll)
+                (funext fun entry => Classical.decide_not (entry.fst = K))))
+            (List.cons.injEq (K, V) (List.filter (fun entry => !decide (entry.fst = K)) M.coll) (K, V')
+              (List.filter (fun entry => !decide (entry.fst = K)) M.coll)))
+          (Eq.trans
+            (congr
+              (congrArg And
+                (Eq.trans (Prod.mk.injEq K V K V')
+                  (Eq.trans (congrArg (fun x => x ∧ V = V') (eq_self K)) (true_and (V = V')))))
+              (eq_self (List.filter (fun entry => !decide (entry.fst = K)) M.coll)))
+            (and_true (V = V'))))
+        hcoll,
+    mpr := fun h => h ▸ Eq.refl (Proof.«Map:update» M K V) },
+  ⟨fun S =>
+    of_eq_true
+      (Eq.trans
+        (congrArg (fun x => x = true)
+          (Eq.trans
+            ((fun p p_1 e_p =>
+                @Eq.rec Prop p (fun p_2 e_p => ∀ {h : Decidable p} [h_1 : Decidable p_2], decide p = decide p_2)
+                  (fun {h} [h_1 : Decidable p] => Subsingleton.elim h h_1 ▸ Eq.refl (decide p)) p_1 e_p)
+              (0 ≤ Proof.«lengthString(_)_STRING-COMMON_Int_String» S) True
+              (Int.ofNat_zero_le._simp_1 (String.length S)))
+            (decide_true instDecidableTrue)))
+        (eq_self true)),
+    fun S =>
+    String.casesOn (motive := fun t =>
+      S = t →
+        Proof.«substrString(_,_,_)_STRING-COMMON_String_String_Int_Int» S 0
+            (Proof.«lengthString(_)_STRING-COMMON_Int_String» S) =
+          S)
+      S
+      (fun data h =>
+        Eq.symm h ▸
+          of_eq_true
+            (Eq.trans
+              (congrArg (fun x => { data := x } = { data := data })
+                (Eq.trans (congrArg (fun x => List.take x.toNat data) (Int.sub_zero ↑data.length)) List.take_length))
+              (eq_self { data := data })))
+      (Eq.refl S)⟩⟩
