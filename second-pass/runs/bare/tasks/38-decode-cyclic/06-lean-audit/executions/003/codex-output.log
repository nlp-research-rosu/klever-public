@@ -0,0 +1,32 @@
+requires "domains.md"
+
+module STRING-PROBE
+  imports STRING
+  imports INT
+
+  syntax KItem ::= "probeLen" "(" String ")"
+                 | "probeSub" "(" String "," Int "," Int ")"
+                 | "lenEmpty"
+                 | "lenAscii"
