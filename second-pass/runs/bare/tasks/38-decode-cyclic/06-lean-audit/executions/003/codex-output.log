index 0000000000000000000000000000000000000000..81bc2da2deb2791e1139f6afc1859068a5f5d0ee
--- /dev/null
+++ b/evidence/02-classification-relevance.log
@@ -0,0 +1,69 @@
+BASELINE COMMAND
+kprove spec.k --definition semantic-kompiled --spec-module SPEC
+
+WORKING DIRECTORY
+/tmp/audit-work/k-relevance-base
+
+EXIT
+0
+
+OUTPUT
+#Top
+
+RULE-REMOVAL COMMAND
+kprove spec.k --definition /tmp/audit-work/k-relevance-base/semantic-kompiled --spec-module SPEC
+
+VARIANT no-map
+Removed verification.k lines 9-11.
+EXIT 0
+OUTPUT
+#Top
+
+VARIANT no-length
+Removed verification.k line 13.
+EXIT 1
+OUTPUT
+kore-exec: [1626802] Warning (WarnStuckClaimState):
+    The configuration's term doesn't unify with the destination's term and the configuration cannot be rewritten further. Location: /tmp/audit-work/no-length/spec.k:26:5-28:63
+Context:
+    (InfoReachability) while checking the implication
+  #Not ( {
+    true
+  #Equals
+    0 <=Int lengthString ( S )
+  } )
+#And
+  <generatedTop>
+    <k>
+      pyInt ( 0 ) ~> tailApply ( S ) ~> binApply ( "+" , pyStr ( "" ) ) ~> doReturn ~> exec ( .Stmts ) ~> .K
+    </k>
+    <env>
+      "i" |-> pyInt ( 0 )
+      "result" |-> pyStr ( "" )
+      "s" |-> pyStr ( S )
+    </env>
+    <result>
+      noResult
+    </result>
+  </generatedTop>
+#And
+  {
+    true
+  #Equals
+    2 >=Int lengthString ( S )
+  }
+[Error] Prover: backend terminated because the configuration cannot be
+rewritten further. See output for more details.
+
+VARIANT no-substr
+Removed verification.k line 14.
+EXIT 0
+OUTPUT
+#Top
+
+INTERPRETATION
+The length lemma is demonstrably necessary in this toolchain. The map-update
+and full-substring rules are redundant with imported builtin/symbolic
+simplification, but are still semantically relevant: the program's assignment
+rule uses the exact Map update operation, while its tail slice uses the exact
+full-range substring operation. Redundancy is not reclassification.
