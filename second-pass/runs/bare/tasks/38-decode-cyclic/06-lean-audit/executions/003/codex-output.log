diff --git a//tmp/audit-work/no-map/verification.k b//tmp/audit-work/no-map/verification.k
index 96a359b22f78a06e897d341c0ef3ba9d98e080e8..10744dfadfd143ef65e3b4c27a7c01a033048cb6
--- a//tmp/audit-work/no-map/verification.k
