     1	def decode_cyclic(s: str):
     2	    result = ""
     3	    i = 0
     4	    while i + 2 < len(s):
     5	        result = result + s[i + 2] + s[i:i + 2]
     6	        i = i + 3
     7	    return result + s[i:]
