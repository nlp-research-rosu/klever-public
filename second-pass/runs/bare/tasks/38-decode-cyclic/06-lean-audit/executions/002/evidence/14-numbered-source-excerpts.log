$ nl -ba /reference/k-proof/spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Loop invariant/circularity: ACC is exactly the already-decoded prefix,
     7	  // and decodeFrom specifies the remaining work from index I.
     8	  claim [loop-correct]:
     9	    <k>
    10	      whileLoop(decodeTest, decodeBody) ~> exec(decodeReturn)
    11	      => .K
    12	    </k>
    13	    <env>
    14	      "s" |-> pyStr(S)
    15	      "i" |-> pyInt(I)
    16	      "result" |-> pyStr(ACC)
    17	      => .Map
    18	    </env>
    19	    <result>
    20	      noResult => pyStr(decodeFrom(S, I, ACC))
    21	    </result>
    22	    requires 0 <=Int I andBool I <=Int lengthString(S)
    23	
    24	  // End-to-end theorem for every input string.
    25	  claim [program-correct]:
    26	    <k> run(solutionProgram, S) => .K </k>
    27	    <env> .Map => .Map </env>
    28	    <result> noResult => pyStr(decodeFrom(S, 0, "")) </result>
    29	endmodule

$ nl -ba /reference/k-proof/solution.py
     1	def decode_cyclic(s: str):
     2	    result = ""
     3	    i = 0
     4	    while i + 2 < len(s):
     5	        result = result + s[i + 2] + s[i:i + 2]
     6	        i = i + 3
     7	    return result + s[i:]

