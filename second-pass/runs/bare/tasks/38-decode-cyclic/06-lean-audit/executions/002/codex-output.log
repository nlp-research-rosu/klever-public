+requires "domains.md"
+
+module PROBE-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+
+  syntax Pgm ::= "len" "(" String ")"
+               | "sub" "(" String "," Int "," Int ")"
+               | "upd" "(" Map "," Int "," Int ")"
+endmodule
+
+module PROBE
+  imports PROBE-SYNTAX
+  imports INT
+  imports STRING
+  imports MAP
+
+  configuration <k> $PGM:Pgm </k>
+
+  rule len(S) => lengthString(S)
+  rule sub(S, START, END) => substrString(S, START, END)
+  rule upd(M, KEY, VALUE) => M [ KEY <- VALUE ]
+endmodule
diff --git a//tmp/audit-work/proc-self-getpid.c b//tmp/audit-work/proc-self-getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..ffb96a395ceec4adc820101a0360f733b747b7db
--- /dev/null
+++ b//tmp/audit-work/proc-self-getpid.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox virtualizes getpid() but exposes host-side process
+ * directories through /proc. Lean 4.22 formats /proc/<getpid()>/exe when
+ * implementing IO.appPath, so return the identifier named by /proc/self.
+ */
+pid_t getpid(void) {
+  char buffer[64];
+  ssize_t length = readlink("/proc/self", buffer, sizeof(buffer) - 1);
+  if (length <= 0 || length >= (ssize_t)sizeof(buffer)) {
+    return (pid_t)1;
+  }
+  buffer[length] = '\0';
+  return (pid_t)strtol(buffer, NULL, 10);
+}
