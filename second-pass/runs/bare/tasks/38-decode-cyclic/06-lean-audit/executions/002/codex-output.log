diff --git a//tmp/audit-work/app-path-probe.c b//tmp/audit-work/app-path-probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..07a80cfb9dfc608b295354decbb353c1498e3cf0
--- /dev/null
+++ b//tmp/audit-work/app-path-probe.c
@@ -0,0 +1,21 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+  char proc_path[64];
+  char target[PATH_MAX];
+  pid_t pid = getpid();
+  snprintf(proc_path, sizeof(proc_path), "/proc/%d/exe", (int)pid);
+  ssize_t n = readlink(proc_path, target, sizeof(target) - 1);
+  if (n < 0) {
+    printf("pid=%d path=%s error=%s\n", (int)pid, proc_path, strerror(errno));
+    return 1;
+  }
+  target[n] = '\0';
+  printf("pid=%d path=%s target=%s\n", (int)pid, proc_path, target);
+  return 0;
+}
diff --git a//tmp/audit-work/proc-self-getpid.c b//tmp/audit-work/proc-self-getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..ffb96a395ceec4adc820101a0360f733b747b7db
--- /dev/null
+++ b//tmp/audit-work/proc-self-getpid.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox virtualizes getpid() but exposes host-side process
+ * directories through /proc. Lean 4.22 formats /proc/<getpid()>/exe when
+ * implementing IO.appPath, so return the identifier named by /proc/self.
+ */
+pid_t getpid(void) {
+  char buffer[64];
+  ssize_t length = readlink("/proc/self", buffer, sizeof(buffer) - 1);
+  if (length <= 0 || length >= (ssize_t)sizeof(buffer)) {
+    return (pid_t)1;
+  }
+  buffer[length] = '\0';
+  return (pid_t)strtol(buffer, NULL, 10);
+}

