diff --git a//tmp/audit-work/app-path-probe.c b//tmp/audit-work/app-path-probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..07a80cfb9dfc608b295354decbb353c1498e3cf0
--- /dev/null
+++ b//tmp/audit-work/app-path-probe.c
@@ -0,0 +1,21 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+  char proc_path[64];
+  char target[PATH_MAX];
+  pid_t pid = getpid();
+  snprintf(proc_path, sizeof(proc_path), "/proc/%d/exe", (int)pid);
+  ssize_t n = readlink(proc_path, target, sizeof(target) - 1);
+  if (n < 0) {
+    printf("pid=%d path=%s error=%s\n", (int)pid, proc_path, strerror(errno));
+    return 1;
+  }
+  target[n] = '\0';
+  printf("pid=%d path=%s target=%s\n", (int)pid, proc_path, target);
+  return 0;
+}
