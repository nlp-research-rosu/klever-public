+requires "domains.md"
+
+module PROBE-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+
+  syntax Pgm ::= "len" "(" String ")"
+               | "sub" "(" String "," Int "," Int ")"
+               | "upd" "(" Map "," Int "," Int ")"
+endmodule
+
