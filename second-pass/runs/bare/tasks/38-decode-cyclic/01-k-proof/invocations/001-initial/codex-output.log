new file mode 100644
index 0000000000000000000000000000000000000000..3cf22526d048d2d81d51d08121611d8a36b5c0b9
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity: ACC is exactly the already-decoded prefix,
+  // and decodeFrom specifies the remaining work from index I.
+  claim [loop-correct]:
+    <k>
+      whileLoop(decodeTest, decodeBody) ~> exec(decodeReturn)
+      => .K
+    </k>
+    <env>
+      "s" |-> pyStr(S)
+      "i" |-> pyInt(I)
+      "result" |-> pyStr(ACC)
+      => .Map
+    </env>
+    <result>
+      noResult => pyStr(decodeFrom(S, I, ACC))
+    </result>
+    requires 0 <=Int I andBool I <=Int lengthString(S)
+
+  // End-to-end theorem for every input string.
+  claim [program-correct]:
+    <k> run(solutionProgram, S) => .K </k>
+    <env> .Map => .Map </env>
+    <result> noResult => pyStr(decodeFrom(S, 0, "")) </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..96a359b22f78a06e897d341c0ef3ba9d98e080e8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,15 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  // Proof-only symbolic support.  The executable rules remain in MPY;
+  // MAP-SYMBOLIC supplies map reasoning needed by reachability claims.
+  rule { M:Map [ K <- V ] #Equals M [ K <- V' ] }
+    => { V #Equals V' }
+    [simplification]
+
+  rule 0 <=Int lengthString(_S) => true [simplification]
+  rule substrString(S, 0, lengthString(S)) => S [simplification]
+endmodule

exec
/bin/bash -lc ./prove.sh in /work
