+    [simplification]
+
+  rule 0 <=Int lengthString(S) => true [simplification]
+  rule substrString(S, 0, lengthString(S)) => S [simplification]
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition semantic-kompiled --spec-module SPEC' in /work
