+
+  syntax Expr ::= "decodeTest" [function, total]
+  rule decodeTest =>
+    Compare(
+      BinOp("+", Name("i"), Int(2)),
+      CmpOp("<", Call(Name("len"), Name("s"))))
+
+  syntax Stmts ::= "decodeReturn" [function, total]
+  rule decodeReturn =>
+    Return(
+      BinOp(
+        "+",
+        Name("result"),
+        Subscript(Name("s"), Slice(Name("i"), NoBound, NoBound))))
+endmodule
