diff --git a//tmp/lean-hostpid.c b//tmp/lean-hostpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..845fb143f2c1202bb4e15db4953b9d453602d428
--- /dev/null
+++ b//tmp/lean-hostpid.c
@@ -0,0 +1,38 @@
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  static pid_t host_pid = 0;
+  if (host_pid != 0) {
+    return host_pid;
+  }
+
+  char status[4096];
+  int fd = open("/proc/self/status", O_RDONLY);
+  if (fd < 0) {
+    return 1;
+  }
+  ssize_t count = read(fd, status, sizeof(status) - 1);
+  close(fd);
+  if (count <= 0) {
+    return 1;
+  }
+  status[count] = '\0';
+
+  char *line = strstr(status, "\nPid:");
+  if (line == NULL) {
+    line = status;
+  } else {
+    line++;
+  }
+  char *number = strchr(line, ':');
+  if (number == NULL) {
+    return 1;
+  }
+  host_pid = (pid_t)strtol(number + 1, NULL, 10);
+  return host_pid;
+}
