+#!/usr/bin/env bash
+set -u
+
+src=/tmp/audit-work/38-decode-cyclic-audit/candidate-src
+proof=/tmp/audit-work/38-decode-cyclic-audit/build-proof/verification-kompiled
+overall=0
+
+prove_one() {
+  label=$1
+  logfile=$2
+  printf '\n$ kprove %q --definition %q --spec-module SPEC --claims %q\n' \
+    "$src/spec.k" "$proof" "$label"
+  kprove "$src/spec.k" \
+    --definition "$proof" \
+    --spec-module SPEC \
+    --claims "$label" 2>&1 | tee "$logfile"
+  status=${PIPESTATUS[0]}
+  printf '[exit %d]\n' "$status"
+  if [ "$status" -ne 0 ] || ! grep -Fxq '#Top' "$logfile"; then
+    printf '[closure check failed: requires exit 0 and an exact #Top line]\n'
+    overall=1
+  else
+    printf '[closure check passed]\n'
+  fi
+}
+
+printf 'Each declared positive target is invoked separately against the fresh proof definition.\n'
+prove_one SPEC.loop-correct /audit-output/evidence/04-loop-correct.raw.log
+prove_one SPEC.program-correct /audit-output/evidence/04-program-correct.raw.log
+
+printf '\nOverall independent-positive-proof status: %d\n' "$overall"
+exit "$overall"

