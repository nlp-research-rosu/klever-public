  if ! prepare_destination "$destination" "$label"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! mv -fT -- "$temporary" "$destination"; then
    error "cannot atomically publish $label to $destination"
    rm -f -- "$temporary"
    return 1
  fi
}

