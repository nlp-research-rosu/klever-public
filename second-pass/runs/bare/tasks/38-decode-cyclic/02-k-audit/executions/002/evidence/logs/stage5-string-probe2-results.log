COMMAND: bash -lc for\ probe\ in\ probeLen\ probeIndex\ probeAlphaLen\ probeEmojiLen\ probeAlphaIndex\;\ do\ printf\ \"PROBE\ %s\\n\"\ \"\$probe\"\;\ krun\ \<\(printf\ %s\ \"\$probe\"\)\ --definition\ string-probe2-kompiled\;\ done
PROBE probeLen
<k>
  1 ~> .K
</k>
PROBE probeIndex
<k>
  "\xe9" ~> .K
</k>
PROBE probeAlphaLen
<k>
  1 ~> .K
</k>
PROBE probeEmojiLen
<k>
  1 ~> .K
</k>
PROBE probeAlphaIndex
<k>
  "\xce\xb1" ~> .K
</k>

EXIT_STATUS: 0
