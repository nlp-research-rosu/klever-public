     3	module VERIFICATION
     4	  imports MPY
     5	  imports MAP-SYMBOLIC
     6	
     7	  // Proof-only symbolic support.  The executable rules remain in MPY;
     8	  // MAP-SYMBOLIC supplies map reasoning needed by reachability claims.
     9	  rule { M:Map [ K <- V ] #Equals M [ K <- V' ] }
    10	    => { V #Equals V' }
    11	    [simplification]
    12	
    13	  rule 0 <=Int lengthString(_S) => true [simplification]
    14	  rule substrString(S, 0, lengthString(S)) => S [simplification]
    15	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Loop invariant/circularity: ACC is exactly the already-decoded prefix,
     7	  // and decodeFrom specifies the remaining work from index I.
     8	  claim [loop-correct]:
     9	    <k>
    10	      whileLoop(decodeTest, decodeBody) ~> exec(decodeReturn)
    11	      => .K
    12	    </k>
    13	    <env>
    14	      "s" |-> pyStr(S)
    15	      "i" |-> pyInt(I)
    16	      "result" |-> pyStr(ACC)
    17	      => .Map
    18	    </env>
    19	    <result>
    20	      noResult => pyStr(decodeFrom(S, I, ACC))
    21	    </result>
    22	    requires 0 <=Int I andBool I <=Int lengthString(S)
    23	
    24	  // End-to-end theorem for every input string.
    25	  claim [program-correct]:
    26	    <k> run(solutionProgram, S) => .K </k>
    27	    <env> .Map => .Map </env>
    28	    <result> noResult => pyStr(decodeFrom(S, 0, "")) </result>
    29	endmodule

