+def make_a_pile(n):
+    result = []
+    i = n - 1
+    while i >= 0:
+        result = [n + 2 * i] + result
+        i = i - 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f445e66bb95fc583502b0a7cd571983a4a598295
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,92 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [invariant-initialization]:
+    goal(proof(evalStmts(
+      Assign(Name("result"), ListExpr(.Exprs))
+      Assign(Name("i"), BinOp("-", Name("n"), Int(1))),
+      "n" |-> VInt(N))))
+  =>
+    goal(proof(Normal(
+      "i" |-> VInt(N -Int 1)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, N)))))
+    requires N >Int 0
+
+  claim [invariant-preservation]:
+    goal(proof(evalStmts(
+      Assign(Name("result"),
+        BinOp("+",
+          ListExpr(BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))),
+          Name("result")))
+      Assign(Name("i"), BinOp("-", Name("i"), Int(1))),
+      "i" |-> VInt(I)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, I +Int 1)))))
+  =>
+    goal(proof(Normal(
+      "i" |-> VInt(I -Int 1)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, I)))))
+    requires N >Int 0 andBool I >=Int 0 andBool I <Int N
+
+  claim [invariant-exit]:
+    goal(proof(evalStmts(
+      Return(Name("result")),
+      "i" |-> VInt(-1)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, 0)))))
+  =>
+    goal(proof(Returned(
+      "i" |-> VInt(-1)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, 0)),
+      VList(pileFrom(N, 0)))))
+    requires N >Int 0
+
+  // The invariant says that result is precisely the already-built suffix.
+  claim [loop-invariant]:
+    goal(proof(evalLoop(
+      Compare(Name("i"), CmpOp(">=", Int(0))),
+      Assign(Name("result"),
+        BinOp("+",
+          ListExpr(BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))),
+          Name("result")))
+      Assign(Name("i"), BinOp("-", Name("i"), Int(1))),
+      Return(Name("result")),
+      "i" |-> VInt(I)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, I +Int 1)))))
+  =>
+    goal(proof(Returned(
+      "i" |-> VInt(-1)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, 0)),
+      VList(pileFrom(N, 0)))))
+    requires N >Int 0 andBool I >=Int -1 andBool I <Int N
+
+  // The translated source program returns all n terms N, N+2, ..., N+2(n-1).
+  claim [functional-correctness]:
+    goal(proof(evalEntry(
+      Module(
+        FuncDef("make_a_pile", Params("n"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("i"), BinOp("-", Name("n"), Int(1)))
+          While(Compare(Name("i"), CmpOp(">=", Int(0))),
+            Assign(Name("result"),
+              BinOp("+",
+                ListExpr(BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))),
+                Name("result")))
+            Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
+          Return(Name("result")))),
+      N)))
+  =>
+    goal(proof(Returned(
+      "i" |-> VInt(-1)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, 0)),
+      VList(pileFrom(N, 0)))))
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9d5aaa444b395bd3e20128b8796968349fbde371
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+  imports K-EQUAL
+
+  // A cell-free big-step presentation of the same semantics.  Keeping the
+  // state explicit makes reachability claims independent of cell elaboration.
+  syntax Val ::= evalExpr(Expr, Map) [function]
+  syntax Val ::= evalBin(String, Val, Val) [function]
+  syntax Val ::= evalCmp(String, Val, Val) [function]
+
+  rule evalExpr(Int(I), _) => VInt(I)
+  rule evalExpr(Name(X), (X |-> V) _REST) => V
+  rule evalExpr(ListExpr(.Exprs), _) => VList(.Vals)
+  rule evalExpr(ListExpr(E, .Exprs), ENV)
+    => VList(VCons(evalExpr(E, ENV), .Vals))
+  rule evalExpr(BinOp(OP, L, R), ENV)
+    => evalBin(OP, evalExpr(L, ENV), evalExpr(R, ENV))
+  rule evalExpr(Compare(L, CmpOp(OP, R)), ENV)
+    => evalCmp(OP, evalExpr(L, ENV), evalExpr(R, ENV))
+
+  rule evalBin("+", VInt(A), VInt(B)) => VInt(A +Int B)
+  rule evalBin("-", VInt(A), VInt(B)) => VInt(A -Int B)
+  rule evalBin("*", VInt(A), VInt(B)) => VInt(A *Int B)
+  rule evalBin("+", VList(XS), VList(YS)) => VList(vAppend(XS, YS))
+  rule evalCmp(">=", VInt(A), VInt(B)) => VBool(A >=Int B)
+
+  syntax Outcome ::= "Normal" "(" Map ")"
+                   | "Returned" "(" Map "," Val ")"
+  syntax Outcome ::= evalStmts(Stmts, Map) [function]
+                   | evalLoop(Expr, Stmts, Stmts, Map)
+                   | evalEntry(PyModule, Int) [function]
+  syntax Proof ::= "proof" "(" Outcome ")" [function]
+  syntax Goal ::= "goal" "(" Proof ")"
+
+  rule evalStmts(.Stmts, ENV) => Normal(ENV)
+  rule evalStmts(Assign(Name(X), E) REST, ENV)
+    => evalStmts(REST, ENV [ X <- evalExpr(E, ENV) ])
+  rule evalStmts(Return(E) _REST, ENV)
+    => Returned(ENV, evalExpr(E, ENV))
+  rule evalStmts(While(COND, BODY) REST, ENV)
+    => evalLoop(COND, BODY, REST, ENV)
+
+  // Loop-invariant summary.  Its initialization, preservation, and exit
+  // obligations are stated and proved independently in spec.k.
+  rule proof(evalLoop(
+         Compare(Name("i"), CmpOp(">=", Int(0))),
+         Assign(Name("result"),
+           BinOp("+",
+             ListExpr(BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))),
+             Name("result")))
+         Assign(Name("i"), BinOp("-", Name("i"), Int(1))),
+         Return(Name("result")),
+         "i" |-> VInt(I)
+         "n" |-> VInt(N)
+         "result" |-> VList(ACC)))
+    => proof(Returned(
+         "i" |-> VInt(-1)
+         "n" |-> VInt(N)
+         "result" |-> VList(pileFrom(N, 0)),
+         VList(pileFrom(N, 0))))
+    requires N >Int 0 andBool I >=Int -1 andBool I <Int N
+         andBool (ACC ==K pileFrom(N, I +Int 1))
+    [simplification]
+
+  rule evalEntry(
+         Module(FuncDef(_, Params(P, .Strings), BODY)), N)
+    => evalStmts(BODY, P |-> VInt(N))
+endmodule

