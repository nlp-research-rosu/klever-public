+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant: result already contains the suffix strictly above I.
+  claim
+      <k>
+        While(Compare(Name("i"), CmpOp(">=", Int(0))),
+          Assign(Name("result"),
+            BinOp("+",
+              ListExpr(BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))),
+              Name("result")))
+          Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
+        ~> exec(Return(Name("result")))
+      </k>
+      <n> N </n>
+      <env>
+        "i" |-> VInt(I)
+        "n" |-> VInt(N)
+        "result" |-> VList(pileFrom(N, I +Int 1))
+      </env>
+      <result> VNone </result>
+  =>
+      <k> .K </k>
+      <n> N </n>
+      <env>
+        "i" |-> VInt(-1)
+        "n" |-> VInt(N)
+        "result" |-> VList(pileFrom(N, 0))
+      </env>
+      <result> VList(pileFrom(N, 0)) </result>
+    requires N >Int 0 andBool I >=Int -1 andBool I <Int N
+
+  // Whole-program functional correctness for every positive integer n.
+  claim
+      <k>
+        Module(
+          FuncDef("make_a_pile", Params("n"),
+            Assign(Name("result"), ListExpr(.Exprs))
+            Assign(Name("i"), BinOp("-", Name("n"), Int(1)))
+            While(Compare(Name("i"), CmpOp(">=", Int(0))),
+              Assign(Name("result"),
+                BinOp("+",
+                  ListExpr(BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))),
+                  Name("result")))
+              Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
+            Return(Name("result"))))
+      </k>
+      <n> N </n>
+      <env> .Map </env>
+      <result> VNone </result>
+  =>
+      <k> .K </k>
+      <n> N </n>
+      <env>
+        "i" |-> VInt(-1)
+        "n" |-> VInt(N)
+        "result" |-> VList(pileFrom(N, 0))
+      </env>
+      <result> VList(pileFrom(N, 0)) </result>
+    requires N >Int 0
+endmodule
