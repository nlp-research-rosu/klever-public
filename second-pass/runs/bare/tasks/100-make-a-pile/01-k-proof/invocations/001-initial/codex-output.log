+  syntax Outcome ::= "Normal" "(" Map ")"
+                   | "Returned" "(" Map "," Val ")"
+  syntax Outcome ::= evalStmts(Stmts, Map) [function]
+                   | evalLoop(Expr, Stmts, Stmts, Map) [function]
+                   | decideLoop(Val, Expr, Stmts, Stmts, Map) [function]
+                   | afterBody(Outcome, Expr, Stmts, Stmts) [function]
+                   | evalEntry(PyModule, Int) [function]
