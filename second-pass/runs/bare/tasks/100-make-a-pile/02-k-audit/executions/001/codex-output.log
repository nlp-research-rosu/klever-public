@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Auditor mutation: the real result is pileFrom(N, 0), but this claim
+  // deliberately drops the first level from the returned value.
+  claim [false-functional-off-by-one]:
+    goal(proof(evalEntry(
+      Module(
+        FuncDef("make_a_pile", Params("n"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("i"), BinOp("-", Name("n"), Int(1)))
+          While(Compare(Name("i"), CmpOp(">=", Int(0))),
+            Assign(Name("result"),
+              BinOp("+",
+                ListExpr(BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))),
+                Name("result")))
+            Assign(Name("i"), BinOp("-", Name("i"), Int(1))))
+          Return(Name("result")))),
+      N)))
+  =>
+    goal(proof(Returned(
+      "i" |-> VInt(-1)
+      "n" |-> VInt(N)
+      "result" |-> VList(pileFrom(N, 0)),
+      VList(pileFrom(N, 1)))))
+    requires N >Int 0
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2ed12ef76319b74f5fca6aeae44baed4fc2dffe3
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+tmp_log=$(mktemp /tmp/audit-work/command-log.XXXXXX)
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$log_path"
+
+"$@" >"$tmp_log" 2>&1
+command_status=$?
+line_count=$(wc -l <"$tmp_log")
+
+{
+  printf 'OUTPUT_LINES: %s\n' "$line_count"
+  if [[ "$line_count" -le 500 ]]; then
+    cat "$tmp_log"
+  else
+    sed -n '1,250p' "$tmp_log"
+    printf '\n[... bounded log: middle omitted ...]\n\n'
+    tail -n 250 "$tmp_log"
+  fi
+  printf 'EXIT_STATUS: %s\n' "$command_status"
+} >>"$log_path"
+
+rm -f -- "$tmp_log"
+exit "$command_status"

