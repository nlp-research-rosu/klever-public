+                    "task_complete",
+                    "token_count",
+                }:
+                    if payload_type == "token_count":
+                        last_usage = (line_count, payload)
+                    else:
+                        selected.append((line_count, payload_type, payload))
+
+    print(f"TRACE={path}")
+    print(f"PARSED_LINES={line_count}")
+    print("TOP_LEVEL_TYPES")
+    for key, count in sorted(top_types.items()):
