+                        "custom_tool_call_output",
+                        "message",
+                    }:
+                        if payload_type == "message":
+                            role = str(payload.get("role", ""))
+                            if role in {"assistant", "user"}:
+                                selected.append((line_count, f"message/{role}", payload))
+                        else:
