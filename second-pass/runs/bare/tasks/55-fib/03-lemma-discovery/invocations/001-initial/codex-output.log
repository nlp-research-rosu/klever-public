--- prove.sh ---
#!/usr/bin/env bash
set -euo pipefail

# Regenerate the constructor term from the submitted Python implementation.
python3 py2mpy.py solution.py > solution.mpy

# Sanity-check CPython behavior against the prompt examples and base cases.
python3 - <<'PY'
from solution import fib

for n, expected in [(0, 0), (1, 1), (2, 1), (8, 21), (10, 55)]:
    actual = fib(n)
    assert actual == expected, (n, actual, expected)
    print(f"CPython: fib({n}) = {actual}")
PY

# Compile the hand-written semantics together with the mathematical oracle.
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

# Exercise the translated program in the K semantics.
run_case() {
  local n="$1"
  local expected="$2"
  local output
  output="$(krun solution.mpy -d verification-kompiled -cARG="$n" --output pretty)"
  printf '%s\n' "$output"
  grep -Fq "    $expected ~> .K" <<<"$output"
  echo "K: fib($n) = $expected"
}

run_case 0 0
run_case 1 1
run_case 2 1
run_case 8 21
run_case 10 55

# Positive target proof 1: independently prove the recursive invocation lemma.
kprove spec.k \
  -d verification-kompiled \
  --spec-module SPEC \
  --claims SPEC.fib-invoke \
  --output pretty 2>&1 | tee kprove-invoke.out
grep -qx '#Top' kprove-invoke.out

# Positive target proof 2: prove the full spec, including the exact module.
kprove spec.k \
  -d verification-kompiled \
  --spec-module SPEC \
  --output pretty 2>&1 | tee kprove-module.out
grep -qx '#Top' kprove-module.out

# Negative validation: an off-by-one postcondition must not prove.
if kprove mutation-spec.k \
    -d verification-kompiled \
    --spec-module MUTATION-SPEC \
    --output pretty 2>&1 | tee kprove-mutation.out; then
  echo "ERROR: the deliberately false mutation unexpectedly proved" >&2
  exit 1
else
  echo "Expected failure: the off-by-one mutation was rejected"
fi

--- semantic.k ---
module MPY-SYNTAX
  imports INT-SYNTAX
  imports STRING-SYNTAX

  syntax Program ::= "Module" "(" Stmts ")"

  syntax Stmts ::= List{Stmt, ""}
  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
                | "If" "(" Expr "," Stmts "," Stmts ")"
                | "Return" "(" Expr ")"

  syntax Params ::= "Params" "(" String ")"

  syntax Expr ::= "Int" "(" Int ")"
                | "Name" "(" String ")"
                | "BinOp" "(" String "," Expr "," Expr ")"
                | "Compare" "(" Expr "," CmpOp ")"
                | "Call" "(" Expr "," Expr ")"

  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
endmodule

module SEMANTIC
  imports MPY-SYNTAX
  imports INT
  imports BOOL
  imports MAP

  configuration
    <python>
      <k> $PGM:Program </k>
      <arg> $ARG:Int </arg>
      <env> .Map </env>
      <functions> .Map </functions>
    </python>

  syntax Function ::= "function" "(" String "," Stmts ")"

  syntax KItem ::= "exec" "(" Stmts ")"
                 | "topCall"
                 | "eval" "(" Expr ")"
                 | "evalRight" "(" String "," Expr ")"
                 | "applyBin" "(" String "," Int ")"
                 | "finishCompare" "(" String "," Expr ")"
                 | "applyCompare" "(" String "," Int ")"
                 | "prepareCall" "(" String ")"
                 | "invoke" "(" String "," Int ")"
                 | "functionEnd" "(" Map ")"
                 | "makeReturn"
                 | "returned" "(" Int ")"

  rule <k> Module(SS) => exec(SS) ~> topCall ... </k>

  rule exec(.Stmts) => .K
  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)

  rule <k> FuncDef(F, Params(P), BODY) => .K ... </k>
       <functions> FS => (F |-> function(P, BODY)) FS </functions>
    requires notBool (F in_keys(FS))

  rule <k> topCall => eval(Call(Name("fib"), Int(N))) ... </k>
       <arg> N </arg>

  rule eval(Int(I)) => I
  rule <k> eval(Name(X)) => I ... </k>
       <env>... X |-> I:Int ...</env>

  rule eval(BinOp(OP, LEFT, RIGHT))
    => eval(LEFT) ~> evalRight(OP, RIGHT)
  rule I:Int ~> evalRight(OP, RIGHT)
    => eval(RIGHT) ~> applyBin(OP, I)
  rule J:Int ~> applyBin("+", I) => I +Int J
  rule J:Int ~> applyBin("-", I) => I -Int J

  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
    => eval(LEFT) ~> finishCompare(OP, RIGHT)
  rule I:Int ~> finishCompare(OP, RIGHT)
    => eval(RIGHT) ~> applyCompare(OP, I)
  rule J:Int ~> applyCompare("<=", I) => I <=Int J

  rule true  ~> finishIf(THEN, _ELSE) => exec(THEN)
  rule false ~> finishIf(_THEN, ELSE) => exec(ELSE)
  syntax KItem ::= "finishIf" "(" Stmts "," Stmts ")"
  rule If(TEST, THEN, ELSE) => eval(TEST) ~> finishIf(THEN, ELSE)

  rule eval(Call(Name(F), ARG)) => eval(ARG) ~> prepareCall(F)
  rule I:Int ~> prepareCall(F) => invoke(F, I)

  rule <k> invoke(F, I) => exec(BODY) ~> functionEnd(RHO) ... </k>
       <env> RHO => P |-> I </env>
       <functions>... F |-> function(P, BODY) ...</functions>

  rule Return(E) => eval(E) ~> makeReturn
  rule I:Int ~> makeReturn => returned(I)
  rule returned(I) ~> exec(_SS) => returned(I)
  rule <k> returned(I) ~> functionEnd(RHO) => I ... </k>
       <env> _ => RHO </env>
endmodule

--- verification.k ---
requires "semantic.k"

module VERIFICATION
  imports SEMANTIC

  syntax Int ::= fibMath(Int) [function]

  rule fibMath(N) => N
    requires 0 <=Int N andBool N <=Int 1
  rule fibMath(N) => fibMath(N -Int 1) +Int fibMath(N -Int 2)
    requires N >Int 1
endmodule

--- spec.k ---
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [fib-invoke]:
    <k> invoke("fib", N) ~> REST => fibMath(N) ~> REST </k>
    <arg> _A </arg>
    <env> _RHO </env>
    <functions>
      "fib" |-> function("n",
        If(Compare(Name("n"), CmpOp("<=", Int(1))),
          Return(Name("n")),
          .Stmts)
        Return(BinOp("+",
          Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
          Call(Name("fib"), BinOp("-", Name("n"), Int(2))))))
    </functions>
    requires N >=Int 0
    [all-path]

  claim [fib-module]:
    <k>
      Module(
        FuncDef("fib", Params("n"),
          If(Compare(Name("n"), CmpOp("<=", Int(1))),
            Return(Name("n")),
            .Stmts)
          Return(BinOp("+",
            Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
            Call(Name("fib"), BinOp("-", Name("n"), Int(2)))))))
      => fibMath(N)
    </k>
    <arg> N </arg>
    <env> .Map </env>
    <functions>
      .Map
      => "fib" |-> function("n",
           If(Compare(Name("n"), CmpOp("<=", Int(1))),
             Return(Name("n")),
             .Stmts)
           Return(BinOp("+",
             Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
             Call(Name("fib"), BinOp("-", Name("n"), Int(2))))))
    </functions>
    requires N >=Int 0
    [all-path]
endmodule

