+            .Stmts)
+          Return(BinOp("+",
+            Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+            Call(Name("fib"), BinOp("-", Name("n"), Int(2)))))))
+      => 21
+    </k>
+    <arg> 8 </arg>
+    <env> .Map </env>
+    <functions>
+      .Map
+      => "fib" |-> function("n",
