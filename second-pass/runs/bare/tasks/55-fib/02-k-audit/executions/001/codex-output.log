/audit-output/evidence/run_logged.sh /audit-output/evidence/04-parsed-program-pinning.log env PATH=/home/agent/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin /audit-output/evidence/pinning_check.sh' in /tmp/audit-work/src
