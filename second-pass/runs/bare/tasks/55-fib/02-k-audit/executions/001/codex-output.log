+          If(Compare(Name("n"), CmpOp("<=", Int(1))),
+            Return(Name("n")),
+            .Stmts)
+          Return(BinOp("+",
+            Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+            Call(Name("fib"), BinOp("-", Name("n"), Int(2)))))))
+      => fibMath(N) +Int 1
+    </k>
+    <arg> N </arg>
+    <env> .Map </env>
+    <functions>
+      .Map
+      => "fib" |-> function("n",
+           If(Compare(Name("n"), CmpOp("<=", Int(1))),
+             Return(Name("n")),
+             .Stmts)
+           Return(BinOp("+",
+             Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+             Call(Name("fib"), BinOp("-", Name("n"), Int(2))))))
+    </functions>
+    requires N >=Int 0
+    [all-path]
+endmodule
