+set -e
+printf 'ATTRIBUTE_SCAN_EXIT_STATUS=%s EXPECTED_1_FOR_NO_MATCH=true\n' "$scan_status"
+test "$scan_status" -eq 1
+
+printf 'EXIT_STATUS=0\n'
