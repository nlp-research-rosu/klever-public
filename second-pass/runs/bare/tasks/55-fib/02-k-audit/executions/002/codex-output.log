diff --git a//tmp/audit-work/55-fib-independent-audit/body-mutation-spec.k b//tmp/audit-work/55-fib-independent-audit/body-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..762317ea1e8cfc8aa1b72c125e6e772af2210739
--- /dev/null
+++ b//tmp/audit-work/55-fib-independent-audit/body-mutation-spec.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module BODY-MUTATION-SPEC
+  imports VERIFICATION
+
+  // The executed module itself has a changed base case and is false at ARG=0.
+  claim [changed-body-must-fail]:
+    <k>
+      Module(
+        FuncDef("fib", Params("n"),
+          If(Compare(Name("n"), CmpOp("<=", Int(1))),
+            Return(BinOp("+", Name("n"), Int(1))),
+            .Stmts)
+          Return(BinOp("+",
+            Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+            Call(Name("fib"), BinOp("-", Name("n"), Int(2)))))))
+      => fibMath(0)
+    </k>
+    <arg> 0 </arg>
+    <env> .Map </env>
+    <functions>
+      .Map
+      => "fib" |-> function("n",
+           If(Compare(Name("n"), CmpOp("<=", Int(1))),
+             Return(BinOp("+", Name("n"), Int(1))),
+             .Stmts)
+           Return(BinOp("+",
+             Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+             Call(Name("fib"), BinOp("-", Name("n"), Int(2))))))
+    </functions>
+    [all-path]
+endmodule
diff --git a//tmp/audit-work/55-fib-independent-audit/context-spec.k b//tmp/audit-work/55-fib-independent-audit/context-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..418142ab510d7eeca7526d31cfb206a88f60884c
--- /dev/null
+++ b//tmp/audit-work/55-fib-independent-audit/context-spec.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module CONTEXT-SPEC
+  imports VERIFICATION
+
+  // Ground, bridge-free fixed-semantics witness with an observable continuation.
+  claim [ground-continuation]:
+    <k> invoke("fib", 5) ~> applyBin("+", 100) => 105 </k>
+    <arg> 99 </arg>
+    <env> "sentinel" |-> 42 </env>
+    <functions>
+      "fib" |-> function("n",
+        If(Compare(Name("n"), CmpOp("<=", Int(1))),
+          Return(Name("n")),
+          .Stmts)
+        Return(BinOp("+",
+          Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+          Call(Name("fib"), BinOp("-", Name("n"), Int(2))))))
+    </functions>
+    [all-path]
+endmodule
diff --git a//tmp/audit-work/55-fib-independent-audit/false-result-spec.k b//tmp/audit-work/55-fib-independent-audit/false-result-spec.k
