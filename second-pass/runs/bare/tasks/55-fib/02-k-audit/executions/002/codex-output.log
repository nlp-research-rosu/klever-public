+test "$scan_status" -eq 1
+
+printf 'EXIT_STATUS=0\n'

diff --git a//tmp/audit-work/55-fib-independent-audit/body-mutation-spec.k b//tmp/audit-work/55-fib-independent-audit/body-mutation-spec.k
