--- /dev/null
+++ b//tmp/audit-work/55-fib-independent-audit/mutated-solution.py
@@ -0,0 +1,4 @@
+def fib(n: int):
+    if n <= 1:
+        return n + 1
+    return fib(n - 1) + fib(n - 2)
