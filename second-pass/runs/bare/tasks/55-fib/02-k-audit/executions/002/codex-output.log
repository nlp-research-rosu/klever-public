+rg -n '^[[:space:]]*(configuration|syntax|rule|claim|requires|imports)' \
+  /candidate/semantic.k \
+  /candidate/verification.k \
+  /candidate/spec.k
+
+printf '%s\n' 'COMMAND: scan trust-sensitive attributes and markers'
+set +e
