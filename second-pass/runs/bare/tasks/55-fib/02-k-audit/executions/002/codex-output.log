+
+printf '%s\n' 'COMMAND: python3 py2mpy.py mutated-solution.py > mutated-solution.mpy'
+python3 py2mpy.py mutated-solution.py > mutated-solution.mpy
+printf 'EXIT_STATUS mutated_translation=0\n'
