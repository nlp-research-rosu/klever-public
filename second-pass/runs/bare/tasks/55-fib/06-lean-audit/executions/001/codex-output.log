+        for name, observed in pipeline_tree_hashes.items()
+    ),
+    "audit_stage1_export_hash": audit_hashes["stage1_export_sha256"]
+    == klean_stage1_hash,
+    "audit_discovery_hash": audit_hashes["discovery_manifest_sha256"]
