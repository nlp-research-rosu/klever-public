diff --git a//tmp/audit-work/proc_pid_shim.c b//tmp/audit-work/proc_pid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..07ae74d48d1aa6d7b636d3b02bad5a1ba5ccce17
--- /dev/null
+++ b//tmp/audit-work/proc_pid_shim.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox exposes host PIDs in /proc while getpid() returns the
+ * nested namespace PID. Lean 4.22 resolves /proc/<getpid()>/exe, so return
+ * the host-visible /proc/self PID to restore executable-path discovery.
+ */
+pid_t getpid(void) {
+    char buffer[64];
+    ssize_t length = readlink("/proc/self", buffer, sizeof(buffer) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(buffer)) {
+        return (pid_t)1;
+    }
+    buffer[length] = '\0';
+    char *end = NULL;
+    errno = 0;
+    long value = strtol(buffer, &end, 10);
+    if (errno != 0 || end == buffer || *end != '\0' || value <= 0
+        || value > INT_MAX) {
+        return (pid_t)1;
+    }
+    return (pid_t)value;
+}
