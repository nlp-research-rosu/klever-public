diff --git a/gcd-spec.k b/gcd-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b45d757933799817df5dd713dc60eca94c3f772b
--- /dev/null
+++ b/gcd-spec.k
@@ -0,0 +1,11 @@
+module GCD-SPEC
+  imports INT
+
+  // A terminating Euclidean characterization of mathematical GCD on
+  // nonnegative inputs.  This is the reference function used by the claims.
+  syntax Int ::= "gcdSpec" "(" Int "," Int ")" [function]
+  rule gcdSpec(A, 0) => A
+    requires A >=Int 0
+  rule gcdSpec(A, B) => gcdSpec(B, A %Int B)
+    requires (A >=Int 0) andBool (B >Int 0)
+endmodule
diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..aca4237f905fff0529485da40c36b037eefbcbe3
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,21 @@
+requires "loop-verification.k"
+
+module LOOP-SPEC
+  imports LOOP-VERIFICATION
+
+  claim
+    <k>
+      execStmt(While(
+        Compare(Name("b"), CmpOp("!=", Int(0))),
+        Assign(Name("r"), BinOp("%", Name("a"), Name("b")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("r"))
+      ))
+      => .K
+    </k>
+    <env>
+      ("a" |-> A) ("b" |-> B) ("r" |-> 0)
+      => ("a" |-> gcdSpec(A, B)) ("b" |-> 0) ("r" |-> 0)
+    </env>
+    requires (A >=Int 0) andBool (B >=Int 0)
+endmodule
