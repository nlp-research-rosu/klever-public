exec
/bin/bash -lc 'kompile loop-verification.k --main-module LOOP-VERIFICATION --syntax-module MPY-SYNTAX --backend haskell -o loop-kompiled && kprove loop-spec.k --definition loop-kompiled && kompile verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --backend haskell -o verification-kompiled && kprove spec.k --definition verification-kompiled' in /work
