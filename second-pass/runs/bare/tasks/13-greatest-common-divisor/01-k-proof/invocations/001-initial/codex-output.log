new file mode 100644
index 0000000000000000000000000000000000000000..8476856f7f9ff342b013b06ab41246116ed1a9f5
--- /dev/null
+++ b/loop-verification.k
@@ -0,0 +1,7 @@
+requires "semantic.k"
