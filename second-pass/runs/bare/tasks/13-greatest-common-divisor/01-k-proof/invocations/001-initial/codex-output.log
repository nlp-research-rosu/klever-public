+  rule <k> Module(FuncDef("greatest_common_divisor", Params(X, Y), BODY))
+            => execStmts(BODY) ... </k>
+       <env> .Map => (X |-> A) (Y |-> B) </env>
+       <inputA> A </inputA>
+       <inputB> B </inputB>
