+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("r"))
+      ))
+      => .K
+    </k>
+    <env>
+      ("a" |-> A) ("b" |-> B) ("r" |-> R0:Int)
+      => ("a" |-> gcdSpec(A, B)) ("b" |-> 0)
+         ("r" |-> finalR(B, R0))
+    </env>
