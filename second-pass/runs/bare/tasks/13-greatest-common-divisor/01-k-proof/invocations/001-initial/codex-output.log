diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..021b7b50774166f7ac91be40122b790435498872
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,13 @@
+# Verification notes
+
+`semantic.k` is a small operational semantics for precisely the translated
+Python subset used by `solution.mpy`: function entry, statement sequencing,
+integer/name evaluation, assignment, conditionals, `while`, `%`, unary minus,
+comparisons, and return.
+
+The proof is intentionally staged. `loop-spec.k` first proves the Euclidean
+loop theorem directly against the operational rules. Only after that command
+succeeds does `verification.k` install the theorem as a higher-priority proof
+summary. `spec.k` then proves the full translated function for arbitrary
+integer inputs, with `normInt` specifying sign normalization and `gcdSpec`
+specified by the Euclidean equations.
diff --git a/gcd-spec.k b/gcd-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5b45d4f27164645f999184d1768add5a3d9e2ba8
--- /dev/null
+++ b/gcd-spec.k
@@ -0,0 +1,40 @@
+module GCD-SPEC
+  imports INT
+  imports BOOL
+
+  // Mathematical GCD is characterized by the Euclidean equations below.
+  // Keeping gcdSpec constructor-valued makes the equations logical lemmas;
+  // it also avoids asking the simplifier to evaluate a symbolic recursion.
+  syntax Int ::= "gcdSpec" "(" Int "," Int ")" [function, total]
+  syntax Int ::= "finalR" "(" Int "," Int ")" [function, total]
+  syntax Int ::= "normInt" "(" Int ")" [function, total]
+
+  // Concrete equations make the reference function executable; symbolic
+  // reasoning uses the Euclidean equality simplifications below.
+  rule gcdSpec(A, 0) => A
+    requires A >=Int 0
+  rule gcdSpec(A, B) => gcdSpec(B, A %Int B)
+    requires (A >=Int 0) andBool (B >Int 0) [simplification, concrete]
+
+  rule normInt(A) => 0 -Int A
+    requires A <Int 0
+  rule normInt(A) => A
+    requires A >=Int 0
+
+  rule finalR(R, R) => 0 [simplification]
+  rule finalR(_B, 0) => 0 [simplification]
+  rule finalR(0, R) => R
+  rule finalR(B, _R) => 0
+    requires B =/=Int 0
+
+  rule { gcdSpec(A, 0) #Equals A } => #Top
+    requires A >=Int 0 [simplification]
+  rule { A #Equals gcdSpec(A, 0) } => #Top
+    requires A >=Int 0 [simplification]
+  rule { gcdSpec(A, B) #Equals gcdSpec(B, R) } => #Top
+    requires (A >=Int 0) andBool (B >Int 0)
+      andBool (R ==Int (A %Int B)) [simplification]
+  rule { gcdSpec(B, R) #Equals gcdSpec(A, B) } => #Top
+    requires (A >=Int 0) andBool (B >Int 0)
+      andBool (R ==Int (A %Int B)) [simplification]
+endmodule
diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e9f6138f0462ececb5abba15bd2774ba568a0205
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,22 @@
+requires "loop-verification.k"
+
+module LOOP-SPEC
+  imports LOOP-VERIFICATION
+
+  claim
+    <k>
+      execStmt(While(
+        Compare(Name("b"), CmpOp("!=", Int(0))),
+        Assign(Name("r"), BinOp("%", Name("a"), Name("b")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("r"))
+      ))
+      => .K
+    </k>
+    <env>
+      ("a" |-> A) ("b" |-> B) ("r" |-> R0:Int)
+      => ("a" |-> gcdSpec(A, B)) ("b" |-> 0)
+         ("r" |-> finalR(B, R0))
+    </env>
+    requires (A >=Int 0) andBool (B >=Int 0)
+endmodule
