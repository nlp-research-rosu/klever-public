+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
