diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5269ffb858a5c9e597c2acb5e7d0d6085707fff2
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Recreate the fixed translator's exact program term.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Exercise the actual translated program with the executable semantics.
+kompile semantic.k \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm \
+  -o semantic-llvm-kompiled
+krun solution.mpy -d semantic-llvm-kompiled -cA=3 -cB=5 \
+  | grep -F "result ( 1 )"
+krun solution.mpy -d semantic-llvm-kompiled -cA=25 -cB=15 \
+  | grep -F "result ( 5 )"
+krun solution.mpy -d semantic-llvm-kompiled -cA=-25 -cB=15 \
+  | grep -F "result ( 5 )"
+krun solution.mpy -d semantic-llvm-kompiled -cA=0 -cB=0 \
+  | grep -F "result ( 0 )"
+
+# First prove the symbolic Euclidean-loop theorem against semantic.k alone.
+kompile loop-verification.k \
+  --main-module LOOP-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  -o loop-kompiled
+kprove loop-spec.k --definition loop-kompiled
+
+# Compile that discharged theorem as the verification lemma, then prove the
+# universal whole-program claim in spec.k.
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  -o verification-kompiled
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b9468b44b5d97df4527b997daf6d5e0c0d531b9
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,90 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
+  configuration
+    <gcd-program>
+      <k> $PGM:Pgm </k>
+      <env> .Map </env>
+      <inputA> $A:Int </inputA>
+      <inputB> $B:Int </inputB>
+      <result> noResult </result>
+    </gcd-program>
+
+  syntax KItem ::= "execStmts" "(" Stmts ")"
+                 | "execStmt" "(" Stmt ")"
+
+  syntax Int ::= "evalInt" "(" Expr "," Map ")" [function]
+  syntax Bool ::= "evalBool" "(" Expr "," Map ")" [function]
+
+  rule evalInt(Int(I), _ENV) => I
+  rule evalInt(Name(X), (X |-> I) _REST) => I
+  rule evalInt(UnaryOp("-", E), ENV) => 0 -Int evalInt(E, ENV)
+  rule evalInt(BinOp("%", E1, E2), ENV)
+    => evalInt(E1, ENV) %Int evalInt(E2, ENV)
+
+  rule evalBool(Compare(E1, CmpOp("<", E2)), ENV)
+    => evalInt(E1, ENV) <Int evalInt(E2, ENV)
+  rule evalBool(Compare(E1, CmpOp("!=", E2)), ENV)
+    => evalInt(E1, ENV) =/=Int evalInt(E2, ENV)
+
+  rule <k> Module(FuncDef("greatest_common_divisor", Params(X:String, Y:String), BODY))
+            => execStmts(BODY) ... </k>
+       <env> .Map => (X |-> A) (Y |-> B) </env>
+       <inputA> A </inputA>
+       <inputB> B </inputB>
+
+  rule <k> execStmts(.Stmts) => .K ... </k>
+  rule <k> execStmts(S SS) => execStmt(S) ~> execStmts(SS) ... </k>
+
+  rule <k> execStmt(Assign(Name(X), E)) => .K ... </k>
+       <env> ENV => ENV [ X <- evalInt(E, ENV) ] </env>
+
+  rule <k> execStmt(If(COND, THEN, _ELSE)) => execStmts(THEN) ... </k>
+       <env> ENV </env>
+    requires evalBool(COND, ENV)
+  rule <k> execStmt(If(COND, _THEN, ELSE)) => execStmts(ELSE) ... </k>
+       <env> ENV </env>
+    requires notBool evalBool(COND, ENV)
+
+  rule <k> execStmt(While(COND, BODY))
+            => execStmts(BODY) ~> execStmt(While(COND, BODY)) ... </k>
+       <env> ENV </env>
+    requires evalBool(COND, ENV)
+  rule <k> execStmt(While(COND, _BODY)) => .K ... </k>
+       <env> ENV </env>
+    requires notBool evalBool(COND, ENV)
+
+  rule <k> execStmt(Return(E)) ~> _REST:K => .K </k>
+       <env> ENV </env>
+       <result> noResult => result(evalInt(E, ENV)) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ba6ce9f893b48445d2d91cbe648391daca370649
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def greatest_common_divisor(a: int, b: int) -> int:
+    if a < 0:
+        a = -a
+    if b < 0:
+        b = -b
+    r = 0
+    while b != 0:
+        r = a % b
+        a = b
+        b = r
+    return a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..382af7bb29cac993987e14d96847e067ec803703
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Whole-program functional correctness for every pair of mathematical
+  // integers, including negative arguments and zero.
+  claim [gcd-correct]:
+    <k>
+      Module(
+        FuncDef("greatest_common_divisor", Params("a", "b"),
+          If(Compare(Name("a"), CmpOp("<", Int(0))),
+            Assign(Name("a"), UnaryOp("-", Name("a"))),
+            .Stmts)
+          If(Compare(Name("b"), CmpOp("<", Int(0))),
+            Assign(Name("b"), UnaryOp("-", Name("b"))),
+            .Stmts)
+          Assign(Name("r"), Int(0))
+          While(Compare(Name("b"), CmpOp("!=", Int(0))),
+            Assign(Name("r"), BinOp("%", Name("a"), Name("b")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("r"))
+          )
+          Return(Name("a"))
+        )
+      )
+      => .K
+    </k>
+    <env>
+      .Map
+      => ("a" |-> gcdSpec(normInt(A), normInt(B)))
+         ("b" |-> 0) ("r" |-> 0)
+    </env>
+    <inputA> A </inputA>
+    <inputB> B </inputB>
+    <result>
+      noResult => result(gcdSpec(normInt(A), normInt(B)))
+    </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ee6b290b38c8976ac5421b11f08456f075d3c6e2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "semantic.k"
+requires "gcd-spec.k"
+
+module VERIFICATION
+  imports MPY
+  imports GCD-SPEC
+
+  // This rule is the loop theorem discharged independently by loop-spec.k.
+  // It is compiled into the verification definition only after that proof.
+  rule
+    <k>
+      execStmt(While(
+        Compare(Name("b"), CmpOp("!=", Int(0))),
+        Assign(Name("r"), BinOp("%", Name("a"), Name("b")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("r"))
+      ))
+      => .K ...
+    </k>
+    <env>
+      ("a" |-> A) ("b" |-> B) ("r" |-> R0:Int)
+      => ("a" |-> gcdSpec(A, B)) ("b" |-> 0)
+         ("r" |-> finalR(B, R0))
+    </env>
+    requires (A >=Int 0) andBool (B >=Int 0) [priority(40)]
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh && bash -n prove.sh && bash prove.sh' in /work
diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..021b7b50774166f7ac91be40122b790435498872
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,13 @@
+# Verification notes
+
+`semantic.k` is a small operational semantics for precisely the translated
+Python subset used by `solution.mpy`: function entry, statement sequencing,
+integer/name evaluation, assignment, conditionals, `while`, `%`, unary minus,
+comparisons, and return.
+
+The proof is intentionally staged. `loop-spec.k` first proves the Euclidean
+loop theorem directly against the operational rules. Only after that command
+succeeds does `verification.k` install the theorem as a higher-priority proof
+summary. `spec.k` then proves the full translated function for arbitrary
+integer inputs, with `normInt` specifying sign normalization and `gcdSpec`
+specified by the Euclidean equations.
diff --git a/gcd-spec.k b/gcd-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5b45d4f27164645f999184d1768add5a3d9e2ba8
--- /dev/null
+++ b/gcd-spec.k
@@ -0,0 +1,40 @@
+module GCD-SPEC
+  imports INT
+  imports BOOL
+
+  // Mathematical GCD is characterized by the Euclidean equations below.
+  // Keeping gcdSpec constructor-valued makes the equations logical lemmas;
+  // it also avoids asking the simplifier to evaluate a symbolic recursion.
+  syntax Int ::= "gcdSpec" "(" Int "," Int ")" [function, total]
+  syntax Int ::= "finalR" "(" Int "," Int ")" [function, total]
+  syntax Int ::= "normInt" "(" Int ")" [function, total]
+
+  // Concrete equations make the reference function executable; symbolic
+  // reasoning uses the Euclidean equality simplifications below.
+  rule gcdSpec(A, 0) => A
+    requires A >=Int 0
+  rule gcdSpec(A, B) => gcdSpec(B, A %Int B)
+    requires (A >=Int 0) andBool (B >Int 0) [simplification, concrete]
+
+  rule normInt(A) => 0 -Int A
+    requires A <Int 0
+  rule normInt(A) => A
+    requires A >=Int 0
+
+  rule finalR(R, R) => 0 [simplification]
+  rule finalR(_B, 0) => 0 [simplification]
+  rule finalR(0, R) => R
+  rule finalR(B, _R) => 0
+    requires B =/=Int 0
+
+  rule { gcdSpec(A, 0) #Equals A } => #Top
+    requires A >=Int 0 [simplification]
+  rule { A #Equals gcdSpec(A, 0) } => #Top
+    requires A >=Int 0 [simplification]
+  rule { gcdSpec(A, B) #Equals gcdSpec(B, R) } => #Top
+    requires (A >=Int 0) andBool (B >Int 0)
+      andBool (R ==Int (A %Int B)) [simplification]
+  rule { gcdSpec(B, R) #Equals gcdSpec(A, B) } => #Top
+    requires (A >=Int 0) andBool (B >Int 0)
+      andBool (R ==Int (A %Int B)) [simplification]
+endmodule
