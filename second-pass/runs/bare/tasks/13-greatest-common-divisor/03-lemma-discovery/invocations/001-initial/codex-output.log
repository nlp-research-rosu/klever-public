assert len({x['source_rule_id'] for x in out['rules']}) == len(out['rules'])
for x in out['rules']:
    assert list(x) == ['source_rule_id', 'classification', 'rationale']
    assert x['classification'] in allowed
    assert isinstance(x['rationale'], str) and x['rationale'].strip()
inv_by_id = {x['source_rule_id']: x for x in inv['rules']}
for x in out['rules']:
    if 'simplification' in inv_by_id[x['source_rule_id']]['attributes']:
        assert x['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print(f\"validated schema v2: {len(out['rules'])} rule, domain lemmas: {sum(x['classification'] == 'DOMAIN_LEMMA' for x in out['rules'])}\")
