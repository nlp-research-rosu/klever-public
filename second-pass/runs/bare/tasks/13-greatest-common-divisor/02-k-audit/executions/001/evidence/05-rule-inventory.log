FILE /tmp/audit-work/source/spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Whole-program functional correctness for every pair of mathematical
     7	  // integers, including negative arguments and zero.
     8	  claim [gcd-correct]:
     9	    <k>
    10	      Module(
    11	        FuncDef("greatest_common_divisor", Params("a", "b"),
    12	          If(Compare(Name("a"), CmpOp("<", Int(0))),
    13	            Assign(Name("a"), UnaryOp("-", Name("a"))),
    14	            .Stmts)
    15	          If(Compare(Name("b"), CmpOp("<", Int(0))),
    16	            Assign(Name("b"), UnaryOp("-", Name("b"))),
    17	            .Stmts)
    18	          Assign(Name("r"), Int(0))
    19	          While(Compare(Name("b"), CmpOp("!=", Int(0))),
    20	            Assign(Name("r"), BinOp("%", Name("a"), Name("b")))
    21	            Assign(Name("a"), Name("b"))
    22	            Assign(Name("b"), Name("r"))
    23	          )
    24	          Return(Name("a"))
    25	        )
    26	      )
    27	      => .K
    28	    </k>
    29	    <env>
    30	      .Map
    31	      => ("a" |-> gcdSpec(normInt(A), normInt(B)))
    32	         ("b" |-> 0) ("r" |-> 0)
    33	    </env>
    34	    <inputA> A </inputA>
    35	    <inputB> B </inputB>
    36	    <result>
    37	      noResult => result(gcdSpec(normInt(A), normInt(B)))
    38	    </result>
    39	endmodule
