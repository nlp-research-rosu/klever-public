FILE /tmp/audit-work/source/gcd-spec.k
     1	module GCD-SPEC
     2	  imports INT
     3	  imports BOOL
     4	
     5	  // Mathematical GCD is characterized by the Euclidean equations below.
     6	  // Keeping gcdSpec constructor-valued makes the equations logical lemmas;
     7	  // it also avoids asking the simplifier to evaluate a symbolic recursion.
     8	  syntax Int ::= "gcdSpec" "(" Int "," Int ")" [function, total]
     9	  syntax Int ::= "finalR" "(" Int "," Int ")" [function, total]
    10	  syntax Int ::= "normInt" "(" Int ")" [function, total]
    11	
    12	  // Concrete equations make the reference function executable; symbolic
    13	  // reasoning uses the Euclidean equality simplifications below.
    14	  rule gcdSpec(A, 0) => A
    15	    requires A >=Int 0
    16	  rule gcdSpec(A, B) => gcdSpec(B, A %Int B)
    17	    requires (A >=Int 0) andBool (B >Int 0) [simplification, concrete]
    18	
    19	  rule normInt(A) => 0 -Int A
    20	    requires A <Int 0
    21	  rule normInt(A) => A
    22	    requires A >=Int 0
    23	
    24	  rule finalR(R, R) => 0 [simplification]
    25	  rule finalR(_B, 0) => 0 [simplification]
    26	  rule finalR(0, R) => R
    27	  rule finalR(B, _R) => 0
    28	    requires B =/=Int 0
    29	
    30	  rule { gcdSpec(A, 0) #Equals A } => #Top
    31	    requires A >=Int 0 [simplification]
    32	  rule { A #Equals gcdSpec(A, 0) } => #Top
    33	    requires A >=Int 0 [simplification]
    34	  rule { gcdSpec(A, B) #Equals gcdSpec(B, R) } => #Top
    35	    requires (A >=Int 0) andBool (B >Int 0)
    36	      andBool (R ==Int (A %Int B)) [simplification]
    37	  rule { gcdSpec(B, R) #Equals gcdSpec(A, B) } => #Top
    38	    requires (A >=Int 0) andBool (B >Int 0)
    39	      andBool (R ==Int (A %Int B)) [simplification]
    40	endmodule
FILE /tmp/audit-work/source/verification.k
     1	requires "semantic.k"
     2	requires "gcd-spec.k"
     3	
     4	module VERIFICATION
     5	  imports MPY
     6	  imports GCD-SPEC
     7	
     8	  // This rule is the loop theorem discharged independently by loop-spec.k.
     9	  // It is compiled into the verification definition only after that proof.
    10	  rule
    11	    <k>
    12	      execStmt(While(
    13	        Compare(Name("b"), CmpOp("!=", Int(0))),
    14	        Assign(Name("r"), BinOp("%", Name("a"), Name("b")))
    15	        Assign(Name("a"), Name("b"))
    16	        Assign(Name("b"), Name("r"))
    17	      ))
    18	      => .K ...
    19	    </k>
    20	    <env>
    21	      ("a" |-> A) ("b" |-> B) ("r" |-> R0:Int)
    22	      => ("a" |-> gcdSpec(A, B)) ("b" |-> 0)
    23	         ("r" |-> finalR(B, R0))
    24	    </env>
    25	    requires (A >=Int 0) andBool (B >=Int 0) [priority(40)]
    26	endmodule
