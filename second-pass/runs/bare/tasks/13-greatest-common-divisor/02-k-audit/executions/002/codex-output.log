     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Recreate the fixed translator's exact program term.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# Exercise the actual translated program with the executable semantics.
    10	kompile semantic.k \
    11	  --main-module MPY \
    12	  --syntax-module MPY-SYNTAX \
    13	  --backend llvm \
    14	  -o semantic-llvm-kompiled
    15	krun solution.mpy -d semantic-llvm-kompiled -cA=3 -cB=5 \
    16	  | grep -F "result ( 1 )"
    17	krun solution.mpy -d semantic-llvm-kompiled -cA=25 -cB=15 \
    18	  | grep -F "result ( 5 )"
    19	krun solution.mpy -d semantic-llvm-kompiled -cA=-25 -cB=15 \
    20	  | grep -F "result ( 5 )"
    21	krun solution.mpy -d semantic-llvm-kompiled -cA=0 -cB=0 \
    22	  | grep -F "result ( 0 )"
    23	
    24	# First prove the symbolic Euclidean-loop theorem against semantic.k alone.
    25	kompile loop-verification.k \
    26	  --main-module LOOP-VERIFICATION \
    27	  --syntax-module MPY-SYNTAX \
    28	  --backend haskell \
    29	  -o loop-kompiled
    30	kprove loop-spec.k --definition loop-kompiled
    31	
    32	# Compile that discharged theorem as the verification lemma, then prove the
    33	# universal whole-program claim in spec.k.
    34	kompile verification.k \
    35	  --main-module VERIFICATION \
    36	  --syntax-module MPY-SYNTAX \
    37	  --backend haskell \
    38	  -o verification-kompiled
    39	kprove spec.k --definition verification-kompiled
FILE /candidate/NOTES.md
     1	# Verification notes
     2	
     3	`semantic.k` is a small operational semantics for precisely the translated
     4	Python subset used by `solution.mpy`: function entry, statement sequencing,
     5	integer/name evaluation, assignment, conditionals, `while`, `%`, unary minus,
     6	comparisons, and return.
     7	
     8	The proof is intentionally staged. `loop-spec.k` first proves the Euclidean
     9	loop theorem directly against the operational rules. Only after that command
    10	succeeds does `verification.k` install the theorem as a higher-priority proof
    11	summary. `spec.k` then proves the full translated function for arbitrary
    12	integer inputs, with `normInt` specifying sign normalization and `gcdSpec`
    13	specified by the Euclidean equations.

