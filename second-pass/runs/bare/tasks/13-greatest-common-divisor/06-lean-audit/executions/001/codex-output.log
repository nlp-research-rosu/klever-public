FILE /reference/k-proof/solution.py
     1	def greatest_common_divisor(a: int, b: int) -> int:
     2	    if a < 0:
     3	        a = -a
     4	    if b < 0:
     5	        b = -b
     6	    r = 0
     7	    while b != 0:
     8	        r = a % b
     9	        a = b
    10	        b = r
    11	    return a
FILE /reference/k-proof/solution.mpy
     1	Module(
     2	  FuncDef("greatest_common_divisor", Params("a", "b"),
     3	    If(Compare(Name("a"), CmpOp("<", Int(0))),
     4	      Assign(Name("a"), UnaryOp("-", Name("a"))),
     5	      )
     6	    If(Compare(Name("b"), CmpOp("<", Int(0))),
     7	      Assign(Name("b"), UnaryOp("-", Name("b"))),
     8	      )
     9	    Assign(Name("r"), Int(0))
    10	    While(Compare(Name("b"), CmpOp("!=", Int(0))),
    11	      Assign(Name("r"), BinOp("%", Name("a"), Name("b")))
    12	      Assign(Name("a"), Name("b"))
    13	      Assign(Name("b"), Name("r")))
    14	    Return(Name("a"))))
