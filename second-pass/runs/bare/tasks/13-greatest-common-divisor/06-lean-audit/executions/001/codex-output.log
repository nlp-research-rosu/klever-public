new file mode 100644
index 0000000000000000000000000000000000000000..1d3de6029c1d987db4ea563aa571badc29910934
--- /dev/null
+++ b//tmp/audit-work/k-stage1.hBhFeB/loop-spec-framed-audit.k
@@ -0,0 +1,22 @@
+requires "loop-verification.k"
+
+module LOOP-SPEC-FRAMED-AUDIT
+  imports LOOP-VERIFICATION
+
+  claim
+    <k>
+      execStmt(While(
+        Compare(Name("b"), CmpOp("!=", Int(0))),
+        Assign(Name("r"), BinOp("%", Name("a"), Name("b")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("r"))
+      )) ~> REST:K
+      => REST
+    </k>
+    <env>
+      ("a" |-> A) ("b" |-> B) ("r" |-> R0:Int)
+      => ("a" |-> gcdSpec(A, B)) ("b" |-> 0)
+         ("r" |-> finalR(B, R0))
+    </env>
+    requires (A >=Int 0) andBool (B >=Int 0)
+endmodule
diff --git a/evidence/proc_exe_shim.c b/evidence/proc_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..f55151794d197b12873723195c34eab7ac12bc33
--- /dev/null
+++ b/evidence/proc_exe_shim.c
@@ -0,0 +1,33 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    const char *cursor;
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    cursor = path + 6;
+    if (*cursor < '0' || *cursor > '9') {
+        return 0;
+    }
+    while (*cursor >= '0' && *cursor <= '9') {
+        cursor++;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_proc_pid_exe(path)) {
+        path = "/proc/self/exe";
+    }
+    return real_readlink(path, buffer, size);
+}

