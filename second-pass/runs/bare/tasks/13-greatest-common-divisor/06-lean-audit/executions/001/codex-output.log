/bin/bash -lc "script -q -e -c 'python3 - <<\"PY\"
import json, hashlib
from pathlib import Path

def sentences(path, suffix, node):
    doc=json.loads(Path(path).read_text())
    out=[]
    def walk(x):
        if isinstance(x, dict):
            att=x.get(\"att\",{}).get(\"att\",{}) if isinstance(x.get(\"att\"),dict) else {}
            source=att.get(\"org.kframework.attributes.Source\")
            if x.get(\"node\")==node and isinstance(source,str) and source.endswith(suffix):
                out.append(x)
            for v in x.values(): walk(v)
        elif isinstance(x,list):
            for v in x: walk(v)
    walk(doc)
    return out

def cell(body,label):
    found=[]
    def walk(x):
        if isinstance(x,dict):
            if x.get(\"node\")==\"KApply\" and x.get(\"label\",{}).get(\"name\")==label:
                found.append(x)
            for v in x.values(): walk(v)
        elif isinstance(x,list):
            for v in x: walk(v)
    walk(body)
    return found

claim=sentences(\"/audit-output/evidence/loop-spec-compiled.json\",\"/loop-spec.k\",\"KClaim\")
rule=sentences(\"/tmp/audit-work/k-stage1.hBhFeB/verification-kompiled/compiled.json\",\"/verification.k\",\"KRule\")
print(\"claim_count\",len(claim),\"rule_count\",len(rule))
for label,items in ((\"CLAIM\",claim),(\"RULE\",rule)):
    for i,item in enumerate(items):
        att=item[\"att\"][\"att\"]
        body=item[\"body\"]
        canonical=json.dumps(body,sort_keys=True,separators=(\",\",\":\"))
        print(label,i,\"location\",att.get(\"org.kframework.attributes.Location\"),\"body_sha256\",hashlib.sha256(canonical.encode()).hexdigest())
        for cell_label in (\"<k>\",\"<env>\"):
            matches=cell(body,cell_label)
            print(label,cell_label,\"count\",len(matches))
            for match in matches:
                print(json.dumps(match,indent=2,sort_keys=True))
