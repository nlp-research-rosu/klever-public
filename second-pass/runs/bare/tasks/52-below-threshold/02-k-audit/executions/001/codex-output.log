+  /candidate/run-input.json \
+  /candidate/metrics.json \
+  /candidate/codex-last.txt; do
+  echo "===== $path ====="
+  nl -ba "$path"
+done
+
+path=/candidate/codex-output.log
+echo "===== $path metadata ====="
+wc -l -c "$path"
+sha256sum "$path"
