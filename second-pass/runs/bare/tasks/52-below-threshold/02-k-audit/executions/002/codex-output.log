+#!/usr/bin/env python3
+"""Validate and inventory every structured generation-trace record."""
+
+from __future__ import annotations
+
+import collections
+import json
+from pathlib import Path
+
+
+def main() -> int:
+    root = Path("/generation-evidence/codex-trace")
