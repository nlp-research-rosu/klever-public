+    assert files, "no structured trace"
+    outer = collections.Counter()
+    payload = collections.Counter()
+    roles = collections.Counter()
+    commands: list[str] = []
+    malformed = 0
+    lines = 0
+
+    for path in files:
+        with path.open(encoding="utf-8") as stream:
+            for line_number, line in enumerate(stream, 1):
