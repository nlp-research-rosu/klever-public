@@ -0,0 +1,5 @@
+def below_threshold(l: list, t: int):
+    for x in l:
+        if x >= t:
+            return False
+    return True
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d6837607263c8abdddbb6130817ba750f488aab1
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [below-threshold-correct]:
+    <bt>
+      <k> boot => .K </k>
+      <program> solutionProgram </program>
+      <input> XS:IntSeq </input>
+      <threshold> T:Int </threshold>
+      <env> .Map => ?_FINAL_ENV:Map </env>
+      <result> noResult => result(allBelow(XS, T)) </result>
+    </bt>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b585c85babc224d19f8bbb0e5271277e679099f6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical contract: every element is strictly below the threshold.
+  syntax Bool ::= allBelow(IntSeq, Int) [function, total]
+  rule allBelow(nil, _T) => true
+  rule allBelow(cons(I, XS), T)
+    => (I <Int T) andBool allBelow(XS, T)
+
+  // One canonical spelling of the exact translated solution, shared by claims.
+  syntax Pgm ::= "solutionProgram" [macro]
+  rule solutionProgram
+    => Module(
+         FuncDef("below_threshold", Params("l", "t"),
+           For(Name("x"), Name("l"),
+             If(Compare(Name("x"), CmpOp(">=", Name("t"))),
+               Return(Bool(false)),
+               .Stmts))
+           Return(Bool(true))))
+endmodule

codex
The prover accepted the universal claim’s shape and is now symbolically exploring it. This is the substantive step: it must account for both list constructors and both comparison outcomes, not merely replay the concrete examples.
