+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  If the suffix XS remains to be scanned, the
+  // eventual answer is exactly the mathematical predicate on that suffix.
+  claim [loop-invariant]:
+    <bt>
+      <k>
+        loop(Name("x"), XS:IntSeq,
+          If(Compare(Name("x"), CmpOp(">=", Name("t"))),
+            Return(Bool(false)),
+            .Stmts))
+        ~> exec(Return(Bool(true)) .Stmts)
+        => .K
+      </k>
+      <program> solutionProgram </program>
+      <input> INPUT:IntSeq </input>
+      <threshold> T:Int </threshold>
+      <l> slot(VList(INPUT)) </l>
+      <t> slot(VInt(T)) </t>
+      <x> _INITIAL_X:Slot => ?_FINAL_LOOP_X:Slot </x>
+      <result> noResult => result(allBelow(XS, T)) </result>
+    </bt>
+
+  claim [below-threshold-correct]:
+    <bt>
+      <k> boot => .K </k>
+      <program> solutionProgram </program>
+      <input> XS:IntSeq </input>
+      <threshold> T:Int </threshold>
+      <l> unbound => slot(VList(XS)) </l>
+      <t> unbound => slot(VInt(T)) </t>
+      <x> unbound => ?_FINAL_X:Slot </x>
+      <result> noResult => result(allBelow(XS, T)) </result>
+    </bt>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b585c85babc224d19f8bbb0e5271277e679099f6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical contract: every element is strictly below the threshold.
+  syntax Bool ::= allBelow(IntSeq, Int) [function, total]
+  rule allBelow(nil, _T) => true
+  rule allBelow(cons(I, XS), T)
+    => (I <Int T) andBool allBelow(XS, T)
+
+  // One canonical spelling of the exact translated solution, shared by claims.
+  syntax Pgm ::= "solutionProgram" [macro]
+  rule solutionProgram
+    => Module(
+         FuncDef("below_threshold", Params("l", "t"),
+           For(Name("x"), Name("l"),
+             If(Compare(Name("x"), CmpOp(">=", Name("t"))),
+               Return(Bool(false)),
+               .Stmts))
+           Return(Bool(true))))
+endmodule

