+                 | "exec" "(" Stmts ")"
+                 | "eval" "(" Expr ")"
+                 | "ifK" "(" Stmts "," Stmts ")"
+                 | "forK" "(" Expr "," Stmts ")"
+                 | "loop" "(" Expr "," IntSeq "," Stmts ")"
+                 | "cmpRight" "(" Expr ")"
+                 | "cmpValues" "(" Value "," String ")"
+                 | "returnK"
