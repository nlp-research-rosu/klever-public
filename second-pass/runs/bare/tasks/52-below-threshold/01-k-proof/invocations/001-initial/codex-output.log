+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // The source subset emitted by py2mpy.py for solution.py.
+  syntax Pgm    ::= "Module" "(" Stmts ")"                   [symbol]
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Stmt   ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                  | "For" "(" Expr "," Expr "," Stmts ")"          [symbol]
+                  | "If" "(" Expr "," Stmts "," Stmts ")"          [symbol]
+                  | "Return" "(" Expr ")"                            [symbol]
+  syntax ParamItems ::= List{String, ","}
+  syntax Params ::= "Params" "(" ParamItems ")"              [symbol]
+  syntax Expr   ::= "Name" "(" String ")"                   [symbol]
+                  | "Bool" "(" Bool ")"                     [symbol]
+                  | "Compare" "(" Expr "," CmpOp ")"       [symbol]
+  syntax CmpOp  ::= "CmpOp" "(" String "," Expr ")"        [symbol]
+
+  // A recursive input representation gives the prover an inductive shape.
+  syntax IntSeq ::= "nil"                                     [symbol]
+                  | "cons" "(" Int "," IntSeq ")"          [symbol]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Value ::= VInt(Int) | VBool(Bool) | VList(IntSeq)
+  syntax Result ::= "noResult" | "result" "(" Bool ")"
+
+  syntax KItem ::= "boot"
+                 | "exec" "(" Stmts ")"
+                 | "eval" "(" Expr ")"
+                 | "ifK" "(" Stmts "," Stmts ")"
+                 | "forK" "(" Expr "," Stmts ")"
+                 | "loop" "(" Expr "," IntSeq "," Stmts ")"
+                 | "cmpRight" "(" Expr ")"
+                 | "cmpValues" "(" Value "," String ")"
+                 | "returnK"
+
+  configuration
+    <bt>
+      <k> boot </k>
+      <program> $PGM:Pgm </program>
+      <input> $INPUT:IntSeq </input>
+      <threshold> $THRESHOLD:Int </threshold>
+      <env> .Map </env>
+      <result> noResult </result>
+    </bt>
+
+  // Loading the module and invoking its required two-argument entry point.
+  rule <k> boot => exec(BODY) ... </k>
+       <program>
+         Module(FuncDef("below_threshold", Params("l", "t"), BODY))
+       </program>
+       <input> XS </input>
+       <threshold> T </threshold>
+       <env> .Map => "l" |-> VList(XS) "t" |-> VInt(T) </env>
+
+  // Sequential statement execution.
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
+
+  // Expression evaluation and environment lookup.
+  rule <k> eval(Bool(B)) => VBool(B) ... </k>
+  rule <k> eval(Name(X)) => V ... </k>
+       <env>... X |-> V ...</env>
+
+  // The comparison shape used by the implementation, evaluated left-to-right.
+  rule <k> eval(Compare(E1, CmpOp(">=", E2)))
+        => eval(E1) ~> cmpRight(E2) ... </k>
+  rule <k> V1:Value ~> cmpRight(E2)
+        => eval(E2) ~> cmpValues(V1, ">=") ... </k>
+  rule <k> VInt(I2) ~> cmpValues(VInt(I1), ">=")
+        => VBool(I1 >=Int I2) ... </k>
+
+  // Conditional statements execute exactly one branch.
+  rule <k> If(COND, THEN, ELSE)
+        => eval(COND) ~> ifK(THEN, ELSE) ... </k>
+  rule <k> VBool(true) ~> ifK(THEN, _ELSE)
+        => exec(THEN) ... </k>
+  rule <k> VBool(false) ~> ifK(_THEN, ELSE)
+        => exec(ELSE) ... </k>
+
+  // For loops consume the iterable from left to right and bind the target.
+  rule <k> For(TARGET, ITER, BODY)
+        => eval(ITER) ~> forK(TARGET, BODY) ... </k>
+  rule <k> VList(XS) ~> forK(TARGET, BODY)
+        => loop(TARGET, XS, BODY) ... </k>
+  rule <k> loop(_TARGET, nil, _BODY) => .K ... </k>
+  rule <k> loop(Name(X), cons(I, XS), BODY)
+        => exec(BODY) ~> loop(Name(X), XS, BODY) ... </k>
+       <env> ENV => ENV [ X <- VInt(I) ] </env>
+
+  // Return discards the rest of the current function computation.
+  rule <k> Return(E) ~> _REST => eval(E) ~> returnK </k>
+  rule <k> VBool(B) ~> returnK => .K </k>
+       <result> noResult => result(B) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f1e22ff1b52d02c241a82e7d207a51b14090821
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,5 @@
+def below_threshold(l: list, t: int):
+    for x in l:
+        if x >= t:
+            return False
+    return True
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..be858b1a00946da76e6cb965504c905372b9e781
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [below-threshold-correct]:
+    <bt>
+      <k> boot </k>
+      <program> solutionProgram </program>
+      <input> XS:IntSeq </input>
+      <threshold> T:Int </threshold>
+      <env> .Map </env>
+      <result> noResult </result>
+    </bt>
+  =>
+    <bt>
+      <k> .K </k>
+      <program> solutionProgram </program>
+      <input> XS:IntSeq </input>
+      <threshold> T:Int </threshold>
+      <env> _FINAL_ENV:Map </env>
+      <result> result(allBelow(XS, T)) </result>
+    </bt>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..50c2ee98bf81e78019f7804c42d84934505ab812
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical contract: every element is strictly below the threshold.
+  syntax Bool ::= allBelow(IntSeq, Int) [function, total, symbol]
+  rule allBelow(nil, _T) => true
+  rule allBelow(cons(I, XS), T)
+    => (I <Int T) andBool allBelow(XS, T)
+
+  // One canonical spelling of the exact translated solution, shared by claims.
+  syntax Pgm ::= "solutionProgram" [macro]
+  rule solutionProgram
+    => Module(
+         FuncDef("below_threshold", Params("l", "t"),
+           For(Name("x"), Name("l"),
+             If(Compare(Name("x"), CmpOp(">=", Name("t"))),
+               Return(Bool(false)),
+               .Stmts))
+           Return(Bool(true))))
+    [macro]
+endmodule

