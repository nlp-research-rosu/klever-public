/tmp/audit-work/proc-self-shim.c
diff --git a//tmp/audit-work/proc-self-shim.c b//tmp/audit-work/proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..45c01f96374720ecd33b1a6eda3d1c7c3bfcf4f0
--- /dev/null
+++ b//tmp/audit-work/proc-self-shim.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_function)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t buffer_size) {
+    static readlink_function real_readlink;
+    const char *selected_path = path;
+    size_t length;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_function)dlsym(RTLD_NEXT, "readlink");
+    }
+    length = strlen(path);
+    if (length > 10
+        && strncmp(path, "/proc/", 6) == 0
+        && strcmp(path + length - 4, "/exe") == 0) {
+        selected_path = "/proc/self/exe";
+    }
+    return real_readlink(selected_path, buffer, buffer_size);
+}
