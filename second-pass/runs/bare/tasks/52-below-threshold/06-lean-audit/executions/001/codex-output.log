+  PYTHONPATH=/reference python -c 'import hashlib,json; from pathlib import Path; from tools.stage6_resolution_contract import verify_audit_input; audit=json.loads(Path("/audit-input.json").read_text()); resolution,digest=verify_audit_input(audit); print(json.dumps({"resolved_input_sha256":digest,"result":"PASS"},sort_keys=True)); lock=json.loads(Path("/opt/humaneval/data/klean-audit-tools.lock.json").read_text()); observed={name:hashlib.sha256((Path("/reference")/name).read_bytes()).hexdigest() for name in lock["files"]}; print(json.dumps({"expected":lock["files"],"observed":observed,"result":"PASS" if observed==lock["files"] else "FAIL"},indent=2,sort_keys=True)); raise SystemExit(0 if observed==lock["files"] else 1)'
