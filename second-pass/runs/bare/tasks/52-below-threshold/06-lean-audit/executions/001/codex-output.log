/bin/bash -lc "script -q -e -c 'cc -shared -fPIC -O2 -Wall -Wextra -o /tmp/audit-work/proc-self-shim.so /tmp/audit-work/proc-self-shim.c -ldl; sha256sum /tmp/audit-work/proc-self-shim.c /tmp/audit-work/proc-self-shim.so; export LD_PRELOAD=/tmp/audit-work/proc-self-shim.so; export ELAN_HOME=/opt/elan; lean --version; lake --version; test_project="'$(mktemp -d /tmp/audit-work/lean-smoke.XXXXXX); cp -a /reference/klean-generation/generated/. "$test_project"; cd "$test_project"; lake clean; lake build'"' /audit-output/evidence/07-toolchain-shim-smoke-test.txt" in /audit-output
