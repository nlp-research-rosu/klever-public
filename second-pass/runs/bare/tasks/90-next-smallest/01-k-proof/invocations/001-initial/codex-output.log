+def next_smallest(lst):
+    smallest = None
+    second = None
+    for value in lst:
+        if smallest is None:
+            smallest = value
+        else:
+            if value < smallest:
+                second = smallest
+                smallest = value
+            else:
+                if value != smallest:
+                    if second is None:
+                        second = value
+                    else:
+                        if value < second:
+                            second = value
+    return second

