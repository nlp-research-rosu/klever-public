     6	def next_smallest(lst):
     7	    """
     8	    You are given a list of integers.
     9	    Write a function next_smallest() that returns the 2nd smallest element of the list.
    10	    Return None if there is no such element.
    11	    
    12	    next_smallest([1, 2, 3, 4, 5]) == 2
    13	    next_smallest([5, 1, 4, 3, 2]) == 2
    14	    next_smallest([]) == None
