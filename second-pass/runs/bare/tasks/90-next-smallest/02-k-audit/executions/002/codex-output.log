  variants['rel_nl_bytes']=b''.join(r.encode()+b'\\n'+b for r,a,h,b in rows)
  variants['rel_nul_bytes']=b''.join(r.encode()+b'\\0'+b for r,a,h,b in rows)
  variants['hashes_concat']=''.join(h for r,a,h,b in rows).encode()
  variants['bytes_concat']=b''.join(b for r,a,h,b in rows)
  print(root)
  for k,v in variants.items(): print(k,hashlib.sha256(v).hexdigest())
