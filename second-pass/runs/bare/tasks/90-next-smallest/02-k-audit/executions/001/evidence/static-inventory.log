     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Declarative contract: after duplicate elimination and ascending sort,
     7	  // return position 1 when present, and Python None otherwise.
     8	  syntax PyVal ::= "secondSmallest" "(" IntList ")" [function, total]
     9	  rule secondSmallest(L)
    10	    => iteVal(lenInt(uniqueSort(L)) >Int 1,
    11	              itemAt(uniqueSort(L), 1),
