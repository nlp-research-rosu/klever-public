+run kprove "$MUTATION" \
+  --definition "$DEFINITION" \
+  --spec-module SPEC-BODY-MUTATION-AUDIT \
+  --claims index-body-sensitivity \
+  --dry-run \
+  --output pretty || exit $?
+
