+status=$?
+printf '[exit %d]\n' "$status"
+
+run cmp "$SCRATCH/source/solution.regenerated.mpy" /candidate/solution.mpy
+run sha256sum \
+  "$SCRATCH/source/solution.regenerated.mpy" \
