+++ b/evidence/static_inventory.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+SOURCE=/tmp/audit-work/90-next-smallest/source
+
+run rg -n \
+  '^[[:space:]]*(requires|module|imports|syntax|configuration|rule|claim)|\\[(function|total|functional|concrete|simplification|priority|owise)' \
+  "$SOURCE/semantic.k" "$SOURCE/verification.k" "$SOURCE/spec.k"
+
+run rg -c '^[[:space:]]*rule ' \
