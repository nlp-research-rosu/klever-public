+)
+check(
+    "generator_discovery_sha256",
+    generator_manifest["provenance"][
+        "stage3_discovery_manifest_sha256"
+    ],
+    resolution_hashes["discovery_manifest_sha256"],
+)
+check(
+    "export_frozen_tree_sha256",
