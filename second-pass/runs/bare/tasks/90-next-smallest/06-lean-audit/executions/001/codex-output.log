+    resolution_hashes["discovery_manifest_sha256"],
+)
+check(
+    "klean_generation_pipeline_tree_sha256",
+    pipeline_contract.sha256_tree(Path("/reference/klean-generation")),
+    resolution_hashes["klean_generation_sha256"],
+)
+check(
