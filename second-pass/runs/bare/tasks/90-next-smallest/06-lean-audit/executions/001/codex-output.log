+)
+check(
+    "input_stage1_tree_sha256",
+    input_manifest["stage1_workspace_sha256"],
+    resolution_hashes["stage1_export_sha256"],
+)
+check(
+    "generator_stage1_tree_sha256",
+    generator_manifest["provenance"]["stage1_workspace_sha256"],
