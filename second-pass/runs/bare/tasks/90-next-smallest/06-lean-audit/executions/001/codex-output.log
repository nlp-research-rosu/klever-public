def _verification_module(
    modules: tuple[_Module, ...], selected_name: str | None = None
) -> _Module:
    if selected_name is not None:
        selected = [module for module in modules if module.name == selected_name]
        if len(selected) != 1:
            raise KRuleInventoryError(
                "prove.sh selects an unknown verification main module: "
                + selected_name
            )
        return selected[0]
    candidates = [
        module
        for module in modules
        if module.name.endswith("VERIFICATION")
        and not module.name.endswith("-SYNTAX")
    ]
    if len(candidates) != 1:
        raise KRuleInventoryError(
            "verification.k must contain exactly one verification module"
        )
    return candidates[0]


def _last_verification_main_module(workspace: Path) -> str | None:
    script = workspace / "prove.sh"
    if not script.exists() and not script.is_symlink():
        return None
    try:
        mode = script.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(f"cannot inspect prove.sh: {script}") from error
    if not stat.S_ISREG(mode):
        raise KRuleInventoryError(f"prove.sh must be a regular file: {script}")
    try:
        text = script.read_text()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(f"cannot read prove.sh: {script}") from error
    logical = re.sub(r"\\\r?\n", " ", text)
    selected: str | None = None
    for line in logical.splitlines():
        code = line.split("#", 1)[0]
        if not re.search(r"(?:^|[;&|]\s*)kompile\s+", code):
            continue
        if re.search(r"(?:^|\s)(?:\./)?verification\.k(?:\s|$)", code) is None:
            continue
        match = re.search(
            r"(?:^|\s)--main-module(?:=|\s+)([A-Za-z][A-Za-z0-9_'-]*)",
            code,
        )
        if match is not None:
            selected = match.group(1)
    return selected


def _verification_closure(
    modules: tuple[_Module, ...], verification: _Module
) -> tuple[_Module, ...]:
    by_name = {module.name: module for module in modules}
    reached: set[str] = set()
    pending = [verification.name]
    while pending:
        name = pending.pop()
        if name in reached:
            continue
        reached.add(name)
        module = by_name.get(name)
        if module is not None:
            pending.extend(module.imports)
    return tuple(module for module in modules if module.name in reached)


def _without_comments(text: str) -> str:
    """Remove K comments while preserving strings and their exact contents."""

    output: list[str] = []
    index = 0
    block_depth = 0
    state = "code"
    while index < len(text):
        character = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if state == "line-comment":
            if character in "\r\n":
                output.append(character)
                state = "code"
            index += 1
            continue
        if state == "string":
            output.append(character)
            if character == "\\" and following:
                output.append(following)
                index += 2
                continue
            if character == '"':
                state = "code"
            index += 1
            continue
        if state == "block-comment":
            if character == "/" and following == "*":
                block_depth += 1
                index += 2
                continue
            if character == "*" and following == "/":
                block_depth -= 1
                index += 2
                if block_depth == 0:
                    state = "code"
                continue
            if character in "\r\n":
                output.append(character)
            index += 1
            continue
        if character == "/" and following == "/":
            output.append(" ")
            state = "line-comment"
            index += 2
            continue
        if character == "/" and following == "*":
            output.append(" ")
            state = "block-comment"
            block_depth = 1
            index += 2
            continue
        output.append(character)
        if character == '"':
            state = "string"
        index += 1
    return "".join(output)


def _attribute_tokens(text: str, masked_text: str) -> list[str]:
    tokens: list[str] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            token = _without_comments(text[start:index]).strip()
            if token:
                tokens.append(token)
            start = index + 1
    final = _without_comments(text[start:]).strip()
    if final:
        tokens.append(final)
    return tokens


def _rule_spans(text: str, module: _Module) -> list[_RuleSpan]:
    masked_text = _mask_non_code(text)
    sentences = module.sentences
    rules: list[_RuleSpan] = []
    seen_hashes: set[str] = set()
    for index, sentence in enumerate(sentences):
        if sentence.keyword != "rule":
            continue
        end_offset = (
            sentences[index + 1].start
            if index + 1 < len(sentences)
            else module.content_end
        )
        start_offset = sentence.start
        raw_segment = text[start_offset:end_offset]
        masked_segment = masked_text[start_offset:end_offset]
        logical_length = len(masked_segment.rstrip(" \t\r\n"))
        if logical_length == 0:
            continue
        rule_text = raw_segment[:logical_length].rstrip(" \t\r\n")
        masked_rule = _mask_non_code(rule_text)
        attribute_match = _TRAILING_ATTRIBUTES_RE.search(masked_rule)
        attribute_start = None
        attribute_end = None
        attributes: list[str] = []
        if attribute_match is not None:
            attribute_start = attribute_match.start("attributes")
            attribute_end = attribute_match.end("attributes")
            attributes = _attribute_tokens(
                rule_text[attribute_start:attribute_end],
                masked_rule[attribute_start:attribute_end],
            )
        normalized = " ".join(rule_text.split())
        digest = hashlib.sha256(normalized.encode()).hexdigest()
        if digest in seen_hashes:
            raise KRuleInventoryError(
                f"duplicate normalized simplification rule hash: {digest}"
            )
        seen_hashes.add(digest)
        start_line = text.count("\n", 0, start_offset) + 1
        end_line = start_line + rule_text.count("\n")
        rule = KRule(
            source_rule_id=f"rule-{digest}",
            module=module.name,
            start_line=start_line,
            end_line=end_line,
            normalized_sha256=digest,
            attributes=attributes,
            text=rule_text,
        )
        rules.append(
            _RuleSpan(
                rule=rule,
                start_offset=start_offset,
                end_offset=start_offset + len(rule_text),
                attribute_start=(
                    None
                    if attribute_match is None
                    else start_offset + attribute_match.start()
                ),
                attribute_end=(
                    None
                    if attribute_match is None
                    else start_offset + attribute_match.end()
                ),
            )
        )
    return rules


def _rule_documents(
    text: str, modules: tuple[_Module, ...]
) -> list[dict[str, Any]]:
    spans = [span for module in modules for span in _rule_spans(text, module)]
    spans.sort(key=lambda span: span.start_offset)
    return [dataclasses.asdict(span.rule) for span in spans]


def _attribute_token_spans(
    text: str,
    masked_text: str,
) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            spans.append(
                (
                    start,
                    index,
                    _without_comments(text[start:index]).strip(),
                )
            )
            start = index + 1
    spans.append(
        (
            start,
            len(text),
            _without_comments(text[start:]).strip(),
        )
    )
    return spans


def _blank_non_newlines(text: str) -> str:
    return "".join(
        character if character in "\r\n" else " "
        for character in text
    )


def desimplify_rule_ids(
    text: str,
    source_rule_ids: list[str],
) -> str:
    """Remove simplification from exactly the selected canonical rule IDs."""

    if len(source_rule_ids) != len(set(source_rule_ids)):
        raise KRuleInventoryError(
            "exact rule transformation contains a duplicate source rule ID"
        )
    selected = set(source_rule_ids)
    modules = _modules(_mask_non_code(text))
    spans = [
        span
        for local_module in modules
        for span in _rule_spans(text, local_module)
    ]
    by_id = {span.rule.source_rule_id: span for span in spans}
    unknown = sorted(selected - set(by_id))
    if unknown:
        raise KRuleInventoryError(
            "exact rule transformation names an unknown source rule ID: "
            + ", ".join(unknown)
        )

    edits: list[tuple[int, int]] = []
    for source_rule_id in source_rule_ids:
        span = by_id[source_rule_id]
        if span.attribute_start is None or span.attribute_end is None:
            raise KRuleInventoryError(
                "selected source rule has no simplification attribute: "
                f"{source_rule_id}"
            )
        attribute_text = text[
            span.attribute_start + 1 : span.attribute_end - 1
        ]
        masked_attributes = _mask_non_code(attribute_text)
        tokens = _attribute_token_spans(
            attribute_text,
            masked_attributes,
        )
        matches = [
            index
            for index, (_start, _end, token) in enumerate(tokens)
            if token == "simplification"
        ]
        if len(matches) != 1:
            raise KRuleInventoryError(
                "selected source rule has ambiguous simplification "
                f"attributes: {source_rule_id}"
            )
        token_index = matches[0]
        if len(tokens) == 1:
            edit_start = span.attribute_start
            edit_end = span.attribute_end
        elif token_index < len(tokens) - 1:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index][0]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index + 1][0]
            )
        else:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index - 1][1]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index][1]
            )
        edits.append((edit_start, edit_end))

    transformed = text
    for start, end in sorted(edits, reverse=True):
        transformed = (
            transformed[:start]
            + _blank_non_newlines(transformed[start:end])
            + transformed[end:]
        )
    return transformed


def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    modules = _modules(masked_text)
    module = _verification_module(
        modules, _last_verification_main_module(workspace)
    )
    closure = _verification_closure(modules, module)
    rule_documents = _rule_documents(text, closure)
    return {
        "schema_version": 2,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "verification_modules": [module.name for module in closure],
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }
    if marker in text:
        text = text.replace(marker, setting + "\n" + marker, 1)
    else:
        text = text.rstrip() + "\n" + setting
    lakefile.write_text(text)


def _tree_entries(root: Path) -> list[tuple[str, str, Path]]:
    if not root.is_dir() or root.is_symlink():
        raise KleanExportError(f"tree root must be a real directory: {root}")
    entries: list[tuple[str, str, Path]] = []
    pending = [root]
    while pending:
        directory = pending.pop()
        for child in os.scandir(directory):
            path = Path(child.path)
            mode = child.stat(follow_symlinks=False).st_mode
            relative = path.relative_to(root).as_posix()
            if stat.S_ISDIR(mode):
                entries.append((relative, "directory", path))
                pending.append(path)
            elif stat.S_ISREG(mode):
                entries.append((relative, "file", path))
            else:
                raise KleanExportError(
                    f"tree contains linked or unsupported entry: {path}"
                )
    return sorted(entries)


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for relative, kind, path in _tree_entries(Path(root)):
        digest.update(relative.encode() + b"\0" + kind.encode() + b"\0")
        if kind == "file":
            digest.update(path.read_bytes())
    return digest.hexdigest()


def _regular_json(path: Path) -> dict[str, Any]:
    if not path.is_file() or path.is_symlink():
        raise KleanExportError(f"required JSON is not a regular file: {path}")
    try:
        document = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        raise KleanExportError(f"malformed JSON: {path}") from error
    if not isinstance(document, dict):
        raise KleanExportError(f"JSON must be an object: {path}")
    return document


def _run_command(
    command: list[str] | str,
    *,
    cwd: Path | None,
    timeout: int,
    env: dict[str, str],
    shell: bool = False,
) -> tuple[int, str]:
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            timeout=timeout,
            shell=shell,
            env=env,
        for declaration in lean_trust_declarations(path):
            name = declaration["name"]
            declaration_name = declaration["declaration_name"]
            kind = declaration["kind"]
            if kind == "axiom":
                axioms.add(name)
            allowlist[name] = {
                "name": name,
                "declaration_name": declaration_name,
                "kind": kind,
                "type": declaration["type"],
                "source": path.relative_to(package).as_posix(),
                "line": declaration["line"],
                "reason": (
                    "deterministic Klean definition repair"
                    if declaration_name in axiomatized
                    else (
                        "Klean-generated opaque definition"
                        if kind == "opaque"
                        else "Klean-generated trust boundary"
                    )
                ),
            }
        noncomputable.update(_NONCOMPUTABLE_RE.findall(text))
        count = len(re.findall(r"\bsorry\b", text))
        if path.name == "Lemmas.lean":
            designated_sorries += count
        else:
            other_sorries += count
    return {
        "axioms": sorted(axioms),
        "automatic_axiomatization": sorted(axiomatized),
        "noncomputable_definitions": sorted(noncomputable),
        "automatic_noncomputable_repair": noncomputable_repair,
        "designated_sorries": designated_sorries,
        "other_sorries": other_sorries,
        "allowlist": [allowlist[name] for name in sorted(allowlist)],
    }


def target_statement(generated: Path) -> dict[str, Any] | None:
    obligation_map = _regular_json(generated / "obligation-map.json")
    obligations = obligation_map.get("obligations")
    parameters = obligation_map.get("trust_parameters")
    if not isinstance(obligations, list) or not isinstance(parameters, list):
        raise KleanExportError("generated obligation map is malformed")
    candidates: list[tuple[Path, str]] = []
    raw_count = 0
    for relative, kind, path in _tree_entries(generated):
        if kind != "file" or path.suffix != ".lean":
            continue
        text = path.read_text()
        raw_count += len(
            re.findall(r"(?m)^\s*def\s+targetStatement\b", text)
        )
        for match in re.finditer(
            r"(?ms)^\s*def\s+targetStatement\b.*?"
            r"(?=^\s*end\s+\S+\s*$)",
            text,
        ):
            candidates.append((path, match.group(0).strip()))
    if not obligations:
        if raw_count != 0:
            raise KleanExportError(
                "zero obligations must not generate a target proposition"
            )
        return None
    if raw_count != 1 or len(candidates) != 1:
        raise KleanExportError(
            "generated project must contain exactly one target proposition; "
            f"found {raw_count}"
        )
    path, definition = candidates[0]
    names: list[str] = []
    normalized_parameters: list[dict[str, Any]] = []
    for parameter in parameters:
        if not isinstance(parameter, dict):
            raise KleanExportError("target parameter is malformed")
        name = parameter.get("name")
        lean_type = parameter.get("type")
        kore_symbol = parameter.get("kore_symbol")
        source_rule_ids = parameter.get("source_rule_ids")
        binding_sha256 = parameter.get("binding_sha256")
        if not isinstance(name, str) or not name:
            raise KleanExportError("target parameter name is malformed")
        if not isinstance(lean_type, str) or not lean_type:
            raise KleanExportError("target parameter type is malformed")
        if not isinstance(kore_symbol, str) or not kore_symbol:
            raise KleanExportError("target KORE symbol binding is malformed")
        if (
            not isinstance(source_rule_ids, list)
            or not source_rule_ids
            or not all(
                isinstance(source_rule_id, str) and source_rule_id
                for source_rule_id in source_rule_ids
            )
        ):
            raise KleanExportError("target source-rule binding is malformed")
        binding = {
            "kore_symbol": kore_symbol,
            "name": name,
            "type": lean_type,
            "source_rule_ids": source_rule_ids,
        }
        expected_binding_sha256 = sha256_text(
            json.dumps(binding, sort_keys=True, separators=(",", ":"))
        )
        if binding_sha256 != expected_binding_sha256:
            raise KleanExportError("target parameter binding hash changed")
        names.append(name)
        normalized_parameters.append(
            {**binding, "binding_sha256": binding_sha256}
        )
    declaration = f"{path.parent.name}.Lemmas.targetStatement"
    statement = " ".join((declaration, *names))
    return {
        "declaration": declaration,
        "file": path.relative_to(generated).as_posix(),
        "statement": statement,
        "statement_sha256": sha256_text(statement),
        "definition_sha256": sha256_text(definition),
        "parameters": normalized_parameters,
    }


def expected_target_definition(obligation_map: dict[str, Any]) -> str | None:
    obligations = obligation_map.get("obligations")
    parameters = obligation_map.get("trust_parameters")
    if not isinstance(obligations, list) or not isinstance(parameters, list):
        raise KleanExportError("generated obligation map is malformed")
    if not obligations:
        return None
    lines = ["def targetStatement"]
    for parameter in parameters:
        if not isinstance(parameter, dict):
            raise KleanExportError("target parameter is malformed")
        name = parameter.get("name")
        lean_type = parameter.get("type")
        if not isinstance(name, str) or not isinstance(lean_type, str):
            raise KleanExportError("target parameter is malformed")
        lines.append(f"    ({name} : {lean_type})")
    conjuncts: list[str] = []
    for obligation in obligations:
        if not isinstance(obligation, dict):
            raise KleanExportError("generated obligation is malformed")
        conjunct = obligation.get("lean_conjunct")
        if not isinstance(conjunct, str) or not conjunct:
            raise KleanExportError("generated Lean conjunct is malformed")
        conjuncts.append(f"({conjunct})")
    lines.extend(("    : Prop :=", "    " + "\n    ∧ ".join(conjuncts)))
    return "\n".join(lines)
