+)
+
+check("audit_mode_env", os.environ.get("AUDIT_MODE"), resolution["mode"])
+check(
+    "audit_input_copy_sha256",
+    file_sha256("/audit-output/audit-input.json"),
+    file_sha256("/audit-input.json"),
+)
+check(
+    "resolved_input_sha256",
+    resolved_digest,
