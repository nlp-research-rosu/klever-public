+        obligation.get("source_rule_id")
+        for obligation in obligation_map["obligations"]
+    ],
+    [rule["source_rule_id"] for rule in expected_domain_source_rules],
+)
+check(
+    "obligation_source_rule_identity_uniqueness",
+    len(
+        {
+            obligation.get("source_rule_id")
+            for obligation in obligation_map["obligations"]
