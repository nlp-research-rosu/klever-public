from math import isqrt
from solution import largest_prime_factor

def oracle(n):
    factors = []
    d = 2
    while d * d <= n:
        while n % d == 0:
            factors.append(d)
            n //= d
        d += 1
    if n > 1:
        factors.append(n)
    return max(factors)

for n in range(4, 5000):
    if any(n % d == 0 for d in range(2, isqrt(n) + 1)):
