diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..3661f1222f892ad2774267fffa04e3f07f7e5e81
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,94 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax PyModule ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
+  configuration
+    <py>
+      <k> $PGM:PyModule </k>
+      <input> $N:Int </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+
+  // This task only needs integers, integer arithmetic, comparisons,
+  // assignment, conditionals, while, return, and one top-level function.
+  syntax Int ::= evalInt(Expr, Map) [function]
+  rule evalInt(Int(I), _) => I
+  rule evalInt(Name(X), X |-> I _M) => I
+  rule evalInt(BinOp("+", A, B), M) => evalInt(A, M) +Int evalInt(B, M)
+  rule evalInt(BinOp("*", A, B), M) => evalInt(A, M) *Int evalInt(B, M)
+  rule evalInt(BinOp("//", A, B), M) => evalInt(A, M) /Int evalInt(B, M)
+    requires evalInt(B, M) =/=Int 0
+  rule evalInt(BinOp("%", A, B), M) => evalInt(A, M) %Int evalInt(B, M)
+    requires evalInt(B, M) =/=Int 0
+
+  syntax Bool ::= evalBool(Expr, Map) [function]
+  rule evalBool(Compare(A, CmpOp("<=", B)), M)
+    => evalInt(A, M) <=Int evalInt(B, M)
+  rule evalBool(Compare(A, CmpOp("==", B)), M)
+    => evalInt(A, M) ==Int evalInt(B, M)
+
+  syntax KItem ::= exec(Stmts)
+                 | execStmt(Stmt)
+                 | setVar(String, Int)
+
+  // Loading the translated module invokes its required entry point with N.
+  rule <k> Module(FuncDef("largest_prime_factor", Params("n"), BODY))
+            => exec(BODY) ... </k>
+       <input> N </input>
+       <env> .Map => "n" |-> N </env>
+
+  rule exec(.Stmts) => .K
+  rule exec(S SS) => execStmt(S) ~> exec(SS)
+
+  rule <k> execStmt(Assign(Name(X), E)) => setVar(X, evalInt(E, M)) ... </k>
+       <env> M </env>
+  rule <k> setVar(X, I) => .K ... </k>
+       <env> M => M [ X <- I ] </env>
+
+  rule <k> execStmt(If(COND, THEN, _ELSE)) => exec(THEN) ... </k>
+       <env> M </env>
+    requires evalBool(COND, M)
+  rule <k> execStmt(If(COND, _THEN, ELSE)) => exec(ELSE) ... </k>
+       <env> M </env>
+    requires notBool evalBool(COND, M)
+
+  rule <k> execStmt(While(COND, BODY))
+            => exec(BODY) ~> execStmt(While(COND, BODY)) ... </k>
+       <env> M </env>
+    requires evalBool(COND, M)
+  rule <k> execStmt(While(COND, _BODY)) => .K ... </k>
+       <env> M </env>
+    requires notBool evalBool(COND, M)
+
+  rule <k> execStmt(Return(E)) => .K ... </k>
+       <env> M </env>
+       <result> noResult => result(evalInt(E, M)) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1d5a25f4d6bb2fb5b88541b39d49a303f5b3e3ad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def largest_prime_factor(n: int):
+    factor = 2
+    while factor * factor <= n:
+        if n % factor == 0:
+            n = n // factor
+        else:
+            factor = factor + 1
+    return n
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..46b35337153ef3cd03f28c26c7717f093ce4c124
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant/refinement: at any positive residual N and candidate F,
+  // executing the translated loop and return computes the pure lpfSpec value.
+  claim [loop-refines-lpf]:
+    <py>
+      <k> execStmt(factorLoop) ~> exec(Return(Name("n")) .Stmts)
+        => .K </k>
+      <input> _INPUT </input>
+      <env> "factor" |-> F "n" |-> N
+        => "factor" |-> ?_:Int "n" |-> lpfSpec(N, F) </env>
+      <result> noResult => result(lpfSpec(N, F)) </result>
+    </py>
+    requires N >Int 1 andBool F >=Int 2
+
+  // Universal end-to-end theorem.  This is stronger than the prompt's domain:
+  // it holds for every N > 1, including prime inputs.
+  claim [largest-prime-factor-correct]:
+    <py>
+      <k> solutionModule => .K </k>
+      <input> N </input>
+      <env> .Map
+        => "factor" |-> ?_:Int "n" |-> lpfSpec(N, 2) </env>
+      <result> noResult => result(lpfSpec(N, 2)) </result>
+    </py>
+    requires N >Int 1
+
+  claim [prompt-example-13195]:
+    <py>
+      <k> solutionModule => .K </k>
+      <input> 13195 </input>
+      <env> .Map => ?_:Map </env>
+      <result> noResult => result(29) </result>
+    </py>
+
+  claim [prompt-example-2048]:
+    <py>
+      <k> solutionModule => .K </k>
+      <input> 2048 </input>
+      <env> .Map => ?_:Map </env>
+      <result> noResult => result(2) </result>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c6315ef34afb80495fc739f503d92441b0751703
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Pure reference model.  Starting at candidate F, remove every occurrence
+  // of a factor while F * F can still fit in N; otherwise advance F.  At
+  // termination N is the greatest prime factor of the original input.
+  syntax Int ::= lpfSpec(Int, Int) [function]
+  rule lpfSpec(N, F) => N
+    requires F *Int F >Int N
+  rule lpfSpec(N, F) => lpfSpec(N /Int F, F)
+    requires F *Int F <=Int N andBool N %Int F ==Int 0
+  rule lpfSpec(N, F) => lpfSpec(N, F +Int 1)
+    requires F *Int F <=Int N andBool N %Int F =/=Int 0
+
+  // Named AST fragments are macros only: after kompilation the claims contain
+  // exactly the constructors emitted into solution.mpy.
+  syntax Stmt ::= "factorLoop" [macro]
+  rule factorLoop
+    => While(
+         Compare(BinOp("*", Name("factor"), Name("factor")),
+                 CmpOp("<=", Name("n"))),
+         If(Compare(BinOp("%", Name("n"), Name("factor")),
+                    CmpOp("==", Int(0))),
+            Assign(Name("n"), BinOp("//", Name("n"), Name("factor"))),
+            Assign(Name("factor"), BinOp("+", Name("factor"), Int(1)))))
+
+  syntax PyModule ::= "solutionModule" [macro]
+  rule solutionModule
+    => Module(
+         FuncDef("largest_prime_factor", Params("n"),
+           Assign(Name("factor"), Int(2))
+           factorLoop
+           Return(Name("n"))))
+endmodule

