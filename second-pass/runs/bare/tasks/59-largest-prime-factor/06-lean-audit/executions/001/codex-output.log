        ]:
            raise KleanFinalGateError(
                "candidate changed while copying for mechanical audit"
            )
        shutil.rmtree(project / ".lake", ignore_errors=True)
        shutil.rmtree(project / "Base", ignore_errors=True)
        shutil.copytree(generation / "generated", project / "Base")
        audit_source = project / "AxiomAudit.lean"
        audit_source.write_text(
            "import Proof\n\n"
            "namespace Proof\n\n"
            f"#check (final : {target['statement']})\n"
            "#print axioms final\n\n"
            "end Proof\n"
        )
        outputs: dict[tuple[str, ...], str] = {}
        commands = (
            ["lake", "clean"],
            ["lake", "build"],
            ["lake", "env", "lean", "AxiomAudit.lean"],
        )
        for command in commands:
            code, output = run_command(command, cwd=project, timeout=600)
            diagnostics.append(
                {
                    "command": command,
                    "exit_code": code,
                    "output_sha256": hashlib.sha256(
                        output.encode()
                    ).hexdigest(),
                    "output_tail": output[-4000:],
                }
            )
            outputs[tuple(command)] = output
            if code != 0:
                raise KleanFinalGateError(
                    f"{' '.join(command)} failed ({code}): {output[-600:]}"
                )
        used_axioms = _parse_axioms(
            outputs[("lake", "env", "lean", "AxiomAudit.lean")]
        )
    after_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    if after_hashes != before_hashes:
        if (
            after_hashes.get("lean_workspace_sha256")
            != before_hashes.get("lean_workspace_sha256")
        ):
            raise KleanFinalGateError(
                "candidate changed during mechanical audit"
            )
        raise KleanFinalGateError(
            "resolved inputs changed during mechanical audit"
        )
    _require_bound_inputs(audit_binding, after_hashes)
    if "sorryAx" in used_axioms:
        raise KleanFinalGateError("Proof.final depends on forbidden sorryAx")
    allowed = _allowed_axioms(inventory)
    unexpected = sorted(
        axiom
        for axiom in used_axioms
        if axiom not in allowed
    )
    if unexpected:
        raise KleanFinalGateError(
            "Proof.final has unrecorded axiom dependencies: "
            + ", ".join(unexpected)
        )
    return {
        "status": "PASS",
        "mode": "CLASSIFICATION_AND_PROOF",
        "resolved_input_sha256": audit_binding[
            "resolved_input_sha256"
        ],
        "input_hashes": signed_resolution["hashes"],
        "semantic_classification": "NOT_EVALUATED",
        "target": target,
        "klean_preflight": preflight,
        "generation_sha256": klean_export.tree_digest(generation),
        "candidate_sha256": klean_export.tree_digest(candidate),
        "used_axioms": sorted(used_axioms),
        "diagnostics": diagnostics,
    }


def run_gate(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    output: Path,
) -> dict[str, Any]:
    output = Path(output)
    if output.exists() or output.is_symlink():
        raise KleanFinalGateError(f"output already exists: {output}")
    try:
        document = check_final(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
            toolchain_lock=toolchain_lock,
            audit_input=audit_input,
        )
    except KleanFinalGateError as error:
        document = {
            "status": "FAIL",
            "error": str(error),
            **_result_binding(audit_input),
        }
    except BaseException as error:
        document = {
            "status": "AUDIT_ERROR",
            "error": f"{type(error).__name__}: {error}",
            **_result_binding(audit_input),
        }
    temporary = output.with_name(f".{output.name}.tmp")
    temporary.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n")
    os.replace(temporary, output)
    return document


def evaluate_gate(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
) -> dict[str, Any]:
    try:
        return check_final(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
            toolchain_lock=toolchain_lock,
            audit_input=audit_input,
        )
    except KleanFinalGateError as error:
        return {
            "status": "FAIL",
            "error": str(error),
            **_result_binding(audit_input),
        }
    except BaseException as error:
        return {
            "status": "AUDIT_ERROR",
            "error": f"{type(error).__name__}: {error}",
            **_result_binding(audit_input),
        }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--frozen-k", required=True, type=Path)
    parser.add_argument(
        "--discovery-manifest", required=True, type=Path
    )
    parser.add_argument("--generation", required=True, type=Path)
    parser.add_argument("--candidate", type=Path)
    parser.add_argument("--toolchain-lock", required=True, type=Path)
    parser.add_argument("--audit-input", required=True, type=Path)
    parser.add_argument("--output", type=Path)
    arguments = parser.parse_args(argv)
    try:
        if arguments.output is None:
            result = evaluate_gate(
                arguments.frozen_k,
                arguments.discovery_manifest,
                arguments.generation,
                arguments.candidate,
                toolchain_lock=arguments.toolchain_lock,
                audit_input=arguments.audit_input,
            )
        else:
            result = run_gate(
                arguments.frozen_k,
                arguments.discovery_manifest,
                arguments.generation,
                arguments.candidate,
                toolchain_lock=arguments.toolchain_lock,
                audit_input=arguments.audit_input,
                output=arguments.output,
            )
    except KleanFinalGateError as error:
        print(f"Klean final gate failed: {error}", file=sys.stderr)
        return 2
    print(json.dumps(result, sort_keys=True))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

diff --git a//tmp/audit-work/proc-visible-getpid.c b//tmp/audit-work/proc-visible-getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..77cdaa5b8108a60069243ab24b651574f520a0c7
--- /dev/null
+++ b//tmp/audit-work/proc-visible-getpid.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length > 0 && length < (ssize_t)sizeof(target)) {
+    target[length] = '\0';
+    char *end = NULL;
+    long visible = strtol(target, &end, 10);
+    if (end != target && *end == '\0' && visible > 0 && visible <= INT_MAX) {
+      return (pid_t)visible;
+    }
+  }
+  static pid_t (*real_getpid)(void);
+  if (!real_getpid) {
+    real_getpid = (pid_t (*)(void))dlsym(RTLD_NEXT, "getpid");
+  }
+  return real_getpid ? real_getpid() : (pid_t)-1;
+}
