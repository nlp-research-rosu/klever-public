codex
I found the audit-container defect precisely: this sandbox’s `getpid()` returns the inner PID, while `/proc/<pid>/exe` exposes only the outer PID; Lean 4.22 reads the numeric `/proc/<pid>/exe` path and therefore cannot find itself. I’m applying a narrow preload shim in `/tmp/audit-work` that makes `getpid()` return the PID exposed by `/proc/self`. This changes no mounted input or Lean artifact; it only repairs executable-path discovery so the required clean build can run.
apply patch
patch: completed
/tmp/audit-work/proc-visible-getpid.c
diff --git a//tmp/audit-work/proc-visible-getpid.c b//tmp/audit-work/proc-visible-getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..77cdaa5b8108a60069243ab24b651574f520a0c7
--- /dev/null
+++ b//tmp/audit-work/proc-visible-getpid.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length > 0 && length < (ssize_t)sizeof(target)) {
+    target[length] = '\0';
+    char *end = NULL;
+    long visible = strtol(target, &end, 10);
+    if (end != target && *end == '\0' && visible > 0 && visible <= INT_MAX) {
+      return (pid_t)visible;
+    }
+  }
+  static pid_t (*real_getpid)(void);
+  if (!real_getpid) {
+    real_getpid = (pid_t (*)(void))dlsym(RTLD_NEXT, "getpid");
+  }
+  return real_getpid ? real_getpid() : (pid_t)-1;
+}
