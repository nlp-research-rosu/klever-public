semantic.k
     1	module MPY-SYNTAX
     2	  imports INT-SYNTAX
     3	  imports STRING-SYNTAX
     4	
     5	  syntax PyModule ::= "Module" "(" Stmts ")"
     6	  syntax Stmts ::= List{Stmt, ""}
     7	  syntax Strings ::= List{String, ","}
     8	  syntax Params ::= "Params" "(" Strings ")"
     9	
    10	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    11	                | "Assign" "(" Expr "," Expr ")"
    12	                | "While" "(" Expr "," Stmts ")"
    13	                | "If" "(" Expr "," Stmts "," Stmts ")"
    14	                | "Return" "(" Expr ")"
    15	
    16	  syntax Expr ::= "Int" "(" Int ")"
    17	                | "Name" "(" String ")"
    18	                | "BinOp" "(" String "," Expr "," Expr ")"
    19	                | "Compare" "(" Expr "," CmpOps ")"
    20	  syntax CmpOps ::= List{CmpOp, ","}
    21	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    22	endmodule
    23	
    24	module SEMANTIC
    25	  imports MPY-SYNTAX
    26	  imports INT
    27	  imports BOOL
    28	  imports MAP
    29	
    30	  syntax Result ::= "noResult" | "result" "(" Int ")"
    31	
    32	  configuration
    33	    <py>
    34	      <k> $PGM:PyModule </k>
    35	      <input> $N:Int </input>
    36	      <env> .Map </env>
    37	      <result> noResult </result>
    38	    </py>
    39	
    40	  // This task only needs integers, integer arithmetic, comparisons,
    41	  // assignment, conditionals, while, return, and one top-level function.
    42	  syntax Int ::= evalInt(Expr, Map) [function]
    43	  rule evalInt(Int(I), _) => I
    44	  rule evalInt(Name(X), X |-> I _M) => I
    45	  rule evalInt(BinOp("+", A, B), M) => evalInt(A, M) +Int evalInt(B, M)
    46	  rule evalInt(BinOp("*", A, B), M) => evalInt(A, M) *Int evalInt(B, M)
    47	  rule evalInt(BinOp("//", A, B), M) => evalInt(A, M) /Int evalInt(B, M)
    48	    requires evalInt(B, M) =/=Int 0
    49	  rule evalInt(BinOp("%", A, B), M) => evalInt(A, M) %Int evalInt(B, M)
    50	    requires evalInt(B, M) =/=Int 0
    51	
    52	  syntax Bool ::= evalBool(Expr, Map) [function]
    53	  rule evalBool(Compare(A, CmpOp("<=", B)), M)
    54	    => evalInt(A, M) <=Int evalInt(B, M)
    55	  rule evalBool(Compare(A, CmpOp("==", B)), M)
    56	    => evalInt(A, M) ==Int evalInt(B, M)
    57	
    58	  syntax KItem ::= exec(Stmts)
    59	                 | execStmt(Stmt)
    60	                 | setVar(String, Int)
    61	
    62	  // Loading the translated module invokes its required entry point with N.
    63	  rule <k> Module(FuncDef("largest_prime_factor", Params("n"), BODY))
    64	            => exec(BODY) ... </k>
    65	       <input> N </input>
    66	       <env> .Map => "n" |-> N </env>
    67	
    68	  rule exec(.Stmts) => .K
    69	  rule exec(S SS) => execStmt(S) ~> exec(SS)
    70	
    71	  rule <k> execStmt(Assign(Name(X), E)) => setVar(X, evalInt(E, M)) ... </k>
    72	       <env> M </env>
    73	  rule <k> setVar(X, I) => .K ... </k>
    74	       <env> M => M [ X <- I ] </env>
    75	
    76	  rule <k> execStmt(If(COND, THEN, _ELSE)) => exec(THEN) ... </k>
    77	       <env> M </env>
    78	    requires evalBool(COND, M)
    79	  rule <k> execStmt(If(COND, _THEN, ELSE)) => exec(ELSE) ... </k>
    80	       <env> M </env>
    81	    requires notBool evalBool(COND, M)
    82	
    83	  rule <k> execStmt(While(COND, BODY))
    84	            => exec(BODY) ~> execStmt(While(COND, BODY)) ... </k>
    85	       <env> M </env>
