def recording_run(command, *, cwd, timeout):
    result = subprocess.run(command, cwd=cwd, timeout=timeout, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    record = {'command': command, 'cwd': str(cwd), 'timeout': timeout, 'exit_code': result.returncode, 'output_sha256': hashlib.sha256(result.stdout.encode()).hexdigest(), 'output': result.stdout}
    runs.append(record)
    print('NESTED COMMAND:', ' '.join(command))
    print('NESTED CWD:', cwd)
    print('NESTED EXIT:', result.returncode)
