diff --git a//tmp/audit-work/proc-visible-getpid.c b//tmp/audit-work/proc-visible-getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..77cdaa5b8108a60069243ab24b651574f520a0c7
--- /dev/null
+++ b//tmp/audit-work/proc-visible-getpid.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+  char target[64];
+  ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+  if (length > 0 && length < (ssize_t)sizeof(target)) {
+    target[length] = '\0';
+    char *end = NULL;
+    long visible = strtol(target, &end, 10);
+    if (end != target && *end == '\0' && visible > 0 && visible <= INT_MAX) {
+      return (pid_t)visible;
+    }
+  }
+  static pid_t (*real_getpid)(void);
+  if (!real_getpid) {
+    real_getpid = (pid_t (*)(void))dlsym(RTLD_NEXT, "getpid");
+  }
+  return real_getpid ? real_getpid() : (pid_t)-1;
+}
diff --git a//tmp/audit-work/uv-exepath-probe.c b//tmp/audit-work/uv-exepath-probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..3dbaf4409cf2036b0aba35a8fb435ca0d97078a3
--- /dev/null
+++ b//tmp/audit-work/uv-exepath-probe.c
@@ -0,0 +1,14 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+extern int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+  char buffer[4096];
+  size_t size = sizeof(buffer);
+  int result = uv_exepath(buffer, &size);
+  printf("result=%d errno=%d (%s) size=%zu path=%s\n",
+         result, errno, strerror(errno), size, result == 0 ? buffer : "");
+  return result == 0 ? 0 : 1;
+}
