index 0000000000000000000000000000000000000000..b9f45b239375c514891d09918244d0db47fd0a9e
--- /dev/null
+++ b/evidence/run_pinning_check.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/59-largest-prime-factor
+definition="$work/build-stage3-fresh/verification-kompiled"
