diff --git a//tmp/audit-work/59-largest-prime-factor/source/solution-body-mut.mpy b//tmp/audit-work/59-largest-prime-factor/source/solution-body-mut.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..e62bb63196632d498d50bb8ea4ed5c18dc3ce3fc
--- /dev/null
+++ b//tmp/audit-work/59-largest-prime-factor/source/solution-body-mut.mpy
@@ -0,0 +1,12 @@
+Module(
+  FuncDef("largest_prime_factor", Params("n"),
+    Assign(Name("factor"), Int(2))
+    While(Compare(
+      BinOp("*", Name("factor"), Name("factor")),
+      CmpOp("<=", Name("n"))),
+      If(Compare(
+        BinOp("%", Name("n"), Name("factor")),
+        CmpOp("==", Int(0))),
+        Assign(Name("n"), BinOp("//", Name("n"), Name("factor"))),
+        Assign(Name("factor"), BinOp("+", Name("factor"), Int(2)))))
+    Return(Name("n"))))
