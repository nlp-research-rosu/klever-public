new file mode 100644
index 0000000000000000000000000000000000000000..6b92b9e2f7e57009d92502c511da19b71269d411
--- /dev/null
+++ b/evidence/spec-witness.k
@@ -0,0 +1,25 @@
+requires "verification.k"
+
+module SPEC-WITNESS
+  imports VERIFICATION
+
+  // Ground witness for the universal entry precondition N > 1.
+  claim [entry-n4]:
+    <py>
+      <k> solutionModule => .K </k>
+      <input> 4 </input>
+      <env> .Map => "factor" |-> 2 "n" |-> 2 </env>
+      <result> noResult => result(2) </result>
+    </py>
+
+  // Ground witness for the loop precondition N > 1 and F >= 2.
+  claim [loop-n4-f2]:
+    <py>
+      <k> execStmt(factorLoop) ~> exec(Return(Name("n")) .Stmts)
+        => .K </k>
+      <input> 4 </input>
+      <env> "factor" |-> 2 "n" |-> 4
+        => "factor" |-> 2 "n" |-> 2 </env>
+      <result> noResult => result(2) </result>
+    </py>
+endmodule

