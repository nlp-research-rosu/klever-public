+requires "verification.k"
+
+module SPEC-WITNESS
+  imports VERIFICATION
+
+  // Ground witness for the universal entry precondition N > 1.
+  claim [entry-n4]:
+    <py>
+      <k> solutionModule => .K </k>
+      <input> 4 </input>
+      <env> .Map => "factor" |-> 2 "n" |-> 2 </env>
