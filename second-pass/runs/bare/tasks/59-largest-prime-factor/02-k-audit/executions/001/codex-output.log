+        => .K </k>
+      <input> 4 </input>
+      <env> "factor" |-> 2 "n" |-> 4
+        => "factor" |-> 2 "n" |-> 2 </env>
+      <result> noResult => result(2) </result>
+    </py>
+endmodule

