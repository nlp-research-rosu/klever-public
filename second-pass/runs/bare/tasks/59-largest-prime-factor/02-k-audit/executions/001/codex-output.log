+    </py>
+
+  // Ground witness for the loop precondition N > 1 and F >= 2.
+  claim [loop-n4-f2]:
+    <py>
+      <k> execStmt(factorLoop) ~> exec(Return(Name("n")) .Stmts)
+        => .K </k>
+      <input> 4 </input>
