+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A separately named reference definition: remove later duplicates, then
+  // insertion-sort the retained representatives.
+  syntax List ::= uniqueSpec(List) [function]
+  rule uniqueSpec(.List) => .List
+  rule uniqueSpec(ListItem(VInt(I)) REST)
+    => insertSpec(I, uniqueSpec(removeSpec(I, REST)))
+
+  syntax List ::= removeSpec(Int, List) [function]
+  rule removeSpec(_, .List) => .List
+  rule removeSpec(I, ListItem(VInt(I)) REST) => removeSpec(I, REST)
+  rule removeSpec(I, ListItem(VInt(J)) REST)
+    => ListItem(VInt(J)) removeSpec(I, REST)
+    requires I =/=Int J
+
+  syntax List ::= insertSpec(Int, List) [function]
+  rule insertSpec(I, .List) => ListItem(VInt(I))
+  rule insertSpec(I, ListItem(VInt(J)) REST)
+    => ListItem(VInt(I)) ListItem(VInt(J)) REST
+    requires I <=Int J
+  rule insertSpec(I, ListItem(VInt(J)) REST)
+    => ListItem(VInt(J)) insertSpec(I, REST)
+    requires I >Int J
+
+  // Quotes a runtime integer list as the AST list accepted by the semantics.
+  syntax Expr ::= quoteList(List) [function]
+  syntax Exprs ::= quoteExprs(List) [function]
+  rule quoteList(L) => ListExpr(quoteExprs(L))
+  rule quoteExprs(.List) => .Exprs
+  rule quoteExprs(ListItem(VInt(I)) REST)
+    => Int(I), quoteExprs(REST)
+endmodule

