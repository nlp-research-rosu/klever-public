+printf 'MUTATED_BODY_KRUN_EXIT_STATUS=%s\n' "$krun_status"
+printf 'MUTATED_BODY_PROOF_EXIT_STATUS=%s\n' "$proof_status"
+if (( translate_status || krun_status || proof_status == 0 )); then
+  exit 1
+fi
+exit 0
