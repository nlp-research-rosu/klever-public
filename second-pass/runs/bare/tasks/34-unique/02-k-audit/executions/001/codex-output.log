+#!/usr/bin/env bash
+set -uo pipefail
+PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '
+set -x
+
+cmp -s /candidate/prompt.py /reference/prompt.py
+prompt_status=$?
+cmp -s /candidate/py2mpy.py /reference/py2mpy.py
