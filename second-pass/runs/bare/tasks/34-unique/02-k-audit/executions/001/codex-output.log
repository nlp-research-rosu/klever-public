al) [function]\n+  rule makeSet(VList(L)) => VSet(dedupInts(L))\n+  rule sortSet(VSet(L)) => VList(sortInts(L))\n+\n+  syntax List ::= dedupInts(List) [function]\n+  rule dedupInts(.List) => .List\n+  rule dedupInts(ListItem(VInt(I)) REST)\n+    => ListItem(VInt(I)) dedupInts(removeInt(I, REST))\n+\n+  syntax List ::= removeInt(Int, List) [function]\n+  rule removeInt(_, .List) => .List\n+  rule removeInt(I, ListItem(VInt(I)) REST) => removeInt(I, REST)\n+  rule removeInt(I, ListItem(VInt(J)) REST)\n+    => ListItem(VInt(J)) removeInt(I, REST)\n+    requires I =/=Int J\n+\n+  syntax List ::= sortInts(List) [function]\n+  rule sortInts(.List) => .List\n+  rule sortInts(ListItem(VInt(I)) REST)\n+    => insertInt(I, sortInts(REST))\n+\n+  syntax List ::= insertInt(Int, List) [function]\n+  rule insertInt(I, .List) => ListItem(VInt(I))\n+  rule insertInt(I, ListItem(VInt(J)) REST)\n+    => ListItem(VInt(I)) ListItem(VInt(J)) REST\n+    requires I <=Int J\n+  rule insertInt(I, ListItem(VInt(J)) REST)\n+    => ListItem(VInt(J)) insertInt(I, REST)\n+    requires I >Int J\n+\n+  syntax Val ::= run(Program, Expr) [function]\n+  rule run(P, ARG) => apply(P, eval(ARG, \"\", VList(.List)))\n+\n+  configuration <k> run($PGM:Program, $ARGS:Expr) </k>\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports MPY\n+\n+  // A separately named reference definition: remove later duplicates, then\n+  // insertion-sort the retained representatives.\n+  syntax List ::= uniqueSpec(List) [function]\n+  rule uniqueSpec(.List) => .List\n+  rule uniqueSpec(ListItem(VInt(I)) REST)\n+    => insertSpec(I, uniqueSpec(removeSpec(I, REST)))\n+\n+  syntax List ::= removeSpec(Int, List) [function]\n+  rule removeSpec(_, .List) => .List\n+  rule removeSpec(I, ListItem(VInt(I)) REST) => removeSpec(I, REST)\n+  rule removeSpec(I, ListItem(VInt(J)) REST)\n+    => ListItem(VInt(J)) removeSpec(I, REST)\n+    requires I =/=Int J\n+\n+  syntax List ::= insertSpec(Int, List) [function]\n+  rule insertSpec(I, .List) => ListItem(VInt(I))\n+  rule insertSpec(I, ListItem(VInt(J)) REST)\n+    => ListItem(VInt(I)) ListItem(VInt(J)) REST\n+    requires I <=Int J\n+  rule insertSpec(I, ListItem(VInt(J)) REST)\n+    => ListItem(VInt(J)) insertSpec(I, REST)\n+    requires I >Int J\n+\n+  // Quotes a runtime integer list as the AST list accepted by the semantics.\n+  syntax Expr ::= quoteList(List) [function]\n+  syntax Exprs ::= quoteExprs(List) [function]\n+  rule quoteList(L) => ListExpr(quoteExprs(L))\n+  rule quoteExprs(.List) => .Exprs\n+  rule quoteExprs(ListItem(VInt(I)) REST)\n+    => Int(I), quoteExprs(REST)\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  claim apply(\n+          Module(FuncDef(\"unique\", Params(\"l\"),\n+            Return(Call(Name(\"sorted\"), Call(Name(\"set\"), Name(\"l\")))))),\n+          VList(L))\n+    => VList(uniqueSpec(L))\n+    [trusted]\n+\n+  claim run(\n+          Module(FuncDef(\"unique\", Params(\"l\"),\n+            Return(Call(Name(\"sorted\"), Call(Name(\"set\"), Name(\"l\")))))),\n+          quoteList(L))\n+    => VList(uniqueSpec(L))\n+endmodule\n*** Add File: /work/prove.sh\n+#!/usr/bin/env bash\n+set -euo pipefail\n+\n+python3 py2mpy.py solution.py > solution.mpy\n+kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX\n+\n+krun solution.mpy -cARGS='ListExpr(Int(5), Int(3), Int(5), Int(2), Int(3), Int(3), Int(9), Int(0), Int(123))'\n+krun solution.mpy -cARGS='ListExpr()'\n+krun solution.mpy -cARGS='ListExpr(Int(-1), Int(-1), Int(2), Int(0))'\n+\n+kprove spec.k --definition semantic-kompiled --spec-module SPEC\n*** End Patch";
