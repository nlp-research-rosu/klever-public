+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    INPUT:PyList,
+                    SUBSTRING:String)
+          => filterRef(INPUT, SUBSTRING)
+        </k>
+    [label(UNIVERSAL)]
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    Nil,
+                    "a")
+          => Nil
+        </k>
+    [label(EMPTY-EXAMPLE)]
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    Cons("abc", Cons("bacd", Cons("cde", Cons("array", Nil)))),
+                    "a")
+          => Cons("abc", Cons("bacd", Cons("array", Nil)))
+        </k>
+    [label(PROMPT-EXAMPLE)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..28547e3bf1f6924205010bdf7751b792829dae0f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("filter_by_substring",
+        Params("strings", "substring"),
+        CellVars("substring"),
+        FreeVars(.Ids),
+        Return(
+          ListComp(Name("string"),
+            CompFor(
+              Name("string"),
+              Name("strings"),
+              Compare(Name("substring"), CmpOp("in", Name("string"))))))))
+
+  syntax PyList ::= filterRef(PyList, String) [function]
+  rule filterRef(Nil, _SUBSTRING) => Nil
+  rule filterRef(Cons(HEAD, TAIL), SUBSTRING)
+    => Cons(HEAD, filterRef(TAIL, SUBSTRING))
+    requires containsString(HEAD, SUBSTRING)
+  rule filterRef(Cons(HEAD, TAIL), SUBSTRING)
+    => filterRef(TAIL, SUBSTRING)
+    requires notBool containsString(HEAD, SUBSTRING)
+endmodule

 succeeded in 5858ms:
<k>
  Nil ~> .K
</k>
<k>
  evalComp ( Cons ( "abc" , Cons ( "bacd" , Cons ( "cde" , Cons ( "array" , Nil ) ) ) ) , Name ( "string" ) , "string" , Compare ( Name ( "substring" ) , CmpOp ( "in" , Name ( "string" ) ) , .CmpOps ) , "strings" |-> Cons ( "abc" , Cons ( "bacd" , Cons ( "cde" , Cons ( "array" , Nil ) ) ) )
  "substring" , .Ids |-> "a" ) ~> .K
</k>

codex
`krun` now fully executes the empty case. The non-empty case exposed a sort-binding issue from using a variadic identifier list for a fixed two-parameter constructor: the second map key included the list terminator. Because this program’s translated constructor has fixed arities (`Params` two, `CellVars` one, `FreeVars` zero, `ImportFrom` one imported name), I’m making those arities explicit so environment keys are ordinary strings.
apply patch
patch: completed
