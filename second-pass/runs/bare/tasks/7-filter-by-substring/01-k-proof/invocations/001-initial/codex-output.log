+++ b/docs/superpowers/specs/2026-07-22-filter-by-substring-k-design.md
@@ -0,0 +1,40 @@
+# Filter by Substring K Verification Design
+
+## Goal
+
+Implement the HumanEval `filter_by_substring` function in the translator's Python subset, execute the translated constructor term with a locally written K semantics, and prove the function's universal filtering contract with `kprove`.
+
+## Python implementation
+
+`solution.py` preserves the prompt's import, signature, type annotations, and docstring. Its body returns a list comprehension that keeps each `string` from `strings` exactly when Python's `substring in string` predicate holds. This deliberately limits the translated term to `FuncDef`, `Params`, `Return`, `ListComp`, `CompFor`, `Name`, `Compare`, and `CmpOp` constructors.
+
+`solution.mpy` is always regenerated from `solution.py` by the immutable `py2mpy.py`; it is not hand-authored.
+
+## K architecture
+
+`semantic.k` owns the constructor syntax and its meaning. It provides a compact big-step evaluator over a map environment. Definitions are installed in a function map, parameters are bound to argument values, returns evaluate their expression, names look up their binding, string membership uses K's string operation, and a one-generator list comprehension recursively traverses its source list while preserving order and duplicates.
+
+The semantics is generic over the constructor patterns used by this solution rather than matching the function name or the exact complete program. Unsupported constructors remain outside this intentionally small semantics.
+
+`verification.k` imports the semantics, defines the top-level execution configuration consumed by `krun` and `kprove`, and defines an independent recursive `filterRef` function on K lists. The reference retains a head exactly when the substring occurs in it.
+
+`spec.k` imports verification support and states:
+
+1. A universal symbolic claim for arbitrary `List` input `STRINGS` and arbitrary `String` `SUBSTRING`: interpreting `solution.mpy` and calling `filter_by_substring` yields `filterRef(STRINGS, SUBSTRING)`.
+2. A claim for the empty-list prompt example.
+3. A claim for the four-element prompt example, including order preservation.
+
+## Execution and proof flow
+
+`prove.sh` uses strict shell settings. It regenerates `solution.mpy`, compiles the semantics, runs both prompt examples through `krun`, then invokes `kprove` once per positive claim so every required proof command has an independently visible exit status and `#Top` result. Build products go in `.kbuild/` inside the current directory.
+
+## Validation and failure handling
+
+Development follows a red/green sequence: first create claims that cannot compile or close without the implementation/semantics, observe the expected failure, then add the minimum semantics needed to close them. The final gate reruns translation, Python examples, K compilation, K execution, every positive proof, and shell syntax checking. If a proof cannot close after concrete diagnostics, the best artifacts and exact blocker are recorded in `NOTES.md`.
+
+## Constraints
+
+- Do not modify `prompt.py` or `py2mpy.py`.
+- Keep every generated artifact under `/work`.
+- Do not substitute finite testing for the universal contract claim.
+- Claim success only when every positive `kprove` invocation prints `#Top` and exits zero.
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..0da74f563eb5cde7076aa3b6ae39f213b5edc359
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,103 @@
+module SEMANTIC-SYNTAX
+  imports STRING-SYNTAX
+  imports BOOL-SYNTAX
+  imports MAP
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "ImportFrom" "(" String "," Ids ")"
+                | "FuncDef" "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Ids ::= List{String, ","}
+  syntax Params ::= "Params" "(" Ids ")"
+  syntax CellVars ::= "CellVars" "(" Ids ")"
+  syntax FreeVars ::= "FreeVars" "(" Ids ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "ListComp" "(" Expr "," CompFors ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+  syntax CompFors ::= List{CompFor, ""}
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax PyList ::= "Nil"
+                  | "Cons" "(" String "," PyList ")"
+
+  syntax KItem ::= execute(Pgm, String, PyList, String)
+endmodule
+
+module SEMANTIC
+  imports SEMANTIC-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP
+
+  configuration <k> execute($PGM:Pgm,
+                             $FUNCTION:String,
+                             $INPUT:PyList,
+                             $SUBSTRING:String)
+                </k>
+
+  syntax Function ::= function(Params, Stmts)
+  syntax Function ::= lookupFunction(String, Stmts) [function]
+
+  rule lookupFunction(FUNCTION,
+         ImportFrom(_MODULE, _NAMES) REST)
+    => lookupFunction(FUNCTION, REST)
+  rule lookupFunction(FUNCTION,
+         FuncDef(FUNCTION, PARAMS, _CELLS, _FREES, BODY) _REST)
+    => function(PARAMS, BODY)
+  rule lookupFunction(FUNCTION,
+         FuncDef(OTHER, _PARAMS, _CELLS, _FREES, _BODY) REST)
+    => lookupFunction(FUNCTION, REST)
+    requires FUNCTION =/=String OTHER
+
+  syntax Expr ::= returnExpr(Stmts) [function]
+  rule returnExpr(Return(EXPRESSION) _REST) => EXPRESSION
+
+  syntax PyList ::= invoke(Function, PyList, String) [function]
+  syntax PyList ::= evalList(Expr, Map) [function]
+  syntax PyList ::= evalComp(PyList, Expr, String, Expr, Map) [function]
+  syntax String ::= evalString(Expr, Map) [function]
+  syntax Bool ::= evalBool(Expr, Map) [function]
+  syntax Bool ::= containsString(String, String) [function]
+
+  rule <k> execute(Module(STATEMENTS), FUNCTION, INPUT, SUBSTRING)
+        => invoke(lookupFunction(FUNCTION, STATEMENTS), INPUT, SUBSTRING)
+       </k>
+
+  rule invoke(function(Params(INPUTNAME, SUBSTRINGNAME), BODY),
+              INPUT, SUBSTRING)
+    => evalList(returnExpr(BODY),
+                (INPUTNAME |-> INPUT) (SUBSTRINGNAME |-> SUBSTRING))
+
+  rule evalList(Name(NAME), (NAME |-> VALUE:PyList) _REST) => VALUE
+  rule evalString(Name(NAME), (NAME |-> VALUE:String) _REST) => VALUE
+
+  rule evalList(
+         ListComp(ELEMENT,
+           CompFor(Name(TARGET), ITERABLE, CONDITION)),
+         ENV)
+    => evalComp(evalList(ITERABLE, ENV),
+                ELEMENT, TARGET, CONDITION, ENV)
+
+  rule evalComp(Nil, _ELEMENT, _TARGET, _CONDITION, _ENV) => Nil
+  rule evalComp(Cons(HEAD, TAIL), ELEMENT, TARGET, CONDITION, ENV)
+    => Cons(evalString(ELEMENT, ENV [ TARGET <- HEAD ]),
+            evalComp(TAIL, ELEMENT, TARGET, CONDITION, ENV))
+    requires evalBool(CONDITION, ENV [ TARGET <- HEAD ])
+  rule evalComp(Cons(HEAD, TAIL), ELEMENT, TARGET, CONDITION, ENV)
+    => evalComp(TAIL, ELEMENT, TARGET, CONDITION, ENV)
+    requires notBool evalBool(CONDITION, ENV [ TARGET <- HEAD ])
+
+  rule evalBool(Compare(NEEDLE, CmpOp("in", HAYSTACK)), ENV)
+    => containsString(evalString(HAYSTACK, ENV),
+                      evalString(NEEDLE, ENV))
+
+  rule containsString(HAYSTACK, NEEDLE)
+    => findString(HAYSTACK, NEEDLE, 0) >=Int 0
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..93a2828bc69ba61fc952237489f5da7190e90eb2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,5 @@
+from typing import List
+
+
+def filter_by_substring(strings: List[str], substring: str) -> List[str]:
+    return [string for string in strings if substring in string]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..eddb2edff374446efca9d3a2a9329d787b5241fd
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    INPUT:PyList,
+                    SUBSTRING:String)
+          => filterRef(INPUT, SUBSTRING)
+        </k>
+    [label(UNIVERSAL)]
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    Nil,
+                    "a")
+          => Nil
+        </k>
+    [label(EMPTY-EXAMPLE)]
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    Cons("abc", Cons("bacd", Cons("cde", Cons("array", Nil)))),
+                    "a")
+          => Cons("abc", Cons("bacd", Cons("array", Nil)))
+        </k>
+    [label(PROMPT-EXAMPLE)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..28547e3bf1f6924205010bdf7751b792829dae0f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("filter_by_substring",
+        Params("strings", "substring"),
+        CellVars("substring"),
+        FreeVars(.Ids),
+        Return(
+          ListComp(Name("string"),
+            CompFor(
+              Name("string"),
+              Name("strings"),
+              Compare(Name("substring"), CmpOp("in", Name("string"))))))))
+
+  syntax PyList ::= filterRef(PyList, String) [function]
+  rule filterRef(Nil, _SUBSTRING) => Nil
+  rule filterRef(Cons(HEAD, TAIL), SUBSTRING)
+    => Cons(HEAD, filterRef(TAIL, SUBSTRING))
+    requires containsString(HEAD, SUBSTRING)
+  rule filterRef(Cons(HEAD, TAIL), SUBSTRING)
+    => filterRef(TAIL, SUBSTRING)
+    requires notBool containsString(HEAD, SUBSTRING)
+endmodule

