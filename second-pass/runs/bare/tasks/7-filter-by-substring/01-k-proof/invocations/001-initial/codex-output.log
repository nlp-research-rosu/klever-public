+krun solution.mpy --definition .kbuild/semantic-kompiled -cFUNCTION='"filter_by_substring"' -cINPUT='Cons("abc",Cons("bacd",Cons("cde",Cons("array",Nil))))' -cSUBSTRING='"a"'
