+                    "filter_by_substring",
+                    Nil,
+                    "a")
+          => Nil
+        </k>
+    [label(EMPTY-EXAMPLE)]
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    Cons("abc", Cons("bacd", Cons("cde", Cons("array", Nil)))),
+                    "a")
+          => Cons("abc", Cons("bacd", Cons("array", Nil)))
+        </k>
+    [label(PROMPT-EXAMPLE)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f09287a93027f42f50d75aa7350ab1cbae8ecf65
--- /dev/null
