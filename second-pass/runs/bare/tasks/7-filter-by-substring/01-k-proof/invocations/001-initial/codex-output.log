--- /dev/null
+++ b/spec.k
@@ -0,0 +1,91 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The exact translated program reduces, for arbitrary inputs, to the
+  // generic list-comprehension evaluator.  The following two claims prove
+  // that evaluator equal to filterRef by structural induction on PyList.
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    INPUT:PyList,
+                    SUBSTRING:String)
+          => evalComp(INPUT,
+                      Name("string"),
+                      "string",
+                      Compare(Name("substring"),
+                              CmpOp("in", Name("string"))),
+                      ("strings" |-> INPUT)
+                      ("substring" |-> SUBSTRING))
+        </k>
+    [label(UNIVERSAL-PROGRAM-REDUCTION)]
+
+  claim <k> evalComp(Nil,
+                     Name("string"),
+                     "string",
+                     Compare(Name("substring"),
+                             CmpOp("in", Name("string"))),
+                     ("strings" |-> _SOURCE:PyList)
+                     ("substring" |-> SUBSTRING:String))
+          => filterRef(Nil, SUBSTRING)
+        </k>
+    [label(UNIVERSAL-BASE)]
+
+  claim <k> evalComp(Cons(HEAD:String, TAIL:PyList),
+                     Name("string"),
+                     "string",
+                     Compare(Name("substring"),
+                             CmpOp("in", Name("string"))),
+                     ("strings" |-> SOURCE:PyList)
+                     ("substring" |-> SUBSTRING:String))
+          => filterRef(Cons(HEAD, TAIL), SUBSTRING)
+        </k>
+    requires containsString(HEAD, SUBSTRING)
+             andBool
+             (evalComp(TAIL,
+                       Name("string"),
+                       "string",
+                       Compare(Name("substring"),
+                               CmpOp("in", Name("string"))),
+                       ("strings" |-> SOURCE)
+                       ("substring" |-> SUBSTRING))
+              ==K filterRef(TAIL, SUBSTRING))
+    [label(UNIVERSAL-STEP-KEEP)]
+
+  claim <k> evalComp(Cons(HEAD:String, TAIL:PyList),
+                     Name("string"),
+                     "string",
+                     Compare(Name("substring"),
+                             CmpOp("in", Name("string"))),
+                     ("strings" |-> SOURCE:PyList)
+                     ("substring" |-> SUBSTRING:String))
+          => filterRef(Cons(HEAD, TAIL), SUBSTRING)
+        </k>
+    requires notBool containsString(HEAD, SUBSTRING)
+             andBool
+             (evalComp(TAIL,
+                       Name("string"),
+                       "string",
+                       Compare(Name("substring"),
+                               CmpOp("in", Name("string"))),
+                       ("strings" |-> SOURCE)
+                       ("substring" |-> SUBSTRING))
+              ==K filterRef(TAIL, SUBSTRING))
+    [label(UNIVERSAL-STEP-DROP)]
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    Nil,
+                    "a")
+          => Nil
+        </k>
+    [label(EMPTY-EXAMPLE)]
+
+  claim <k> execute(solutionProgram,
+                    "filter_by_substring",
+                    Cons("abc", Cons("bacd", Cons("cde", Cons("array", Nil)))),
+                    "a")
+          => Cons("abc", Cons("bacd", Cons("array", Nil)))
+        </k>
+    [label(PROMPT-EXAMPLE)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2b46d7838f88cb35febd52325d591de55cce6a47
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,30 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+  imports K-EQUAL
+
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("filter_by_substring",
+        Params("strings", "substring"),
+        CellVars("substring"),
+        FreeVars(),
+        Return(
+          ListComp(Name("string"),
+            CompFor(
+              Name("string"),
+              Name("strings"),
+              Compare(Name("substring"), CmpOp("in", Name("string"))))))))
+
+  syntax PyList ::= filterRef(PyList, String) [function, total]
+  rule filterRef(Nil, _SUBSTRING) => Nil
+  rule filterRef(Cons(HEAD, TAIL), SUBSTRING)
+    => Cons(HEAD, filterRef(TAIL, SUBSTRING))
+    requires containsString(HEAD, SUBSTRING)
+  rule filterRef(Cons(HEAD, TAIL), SUBSTRING)
+    => filterRef(TAIL, SUBSTRING)
+    requires notBool containsString(HEAD, SUBSTRING)
+endmodule

