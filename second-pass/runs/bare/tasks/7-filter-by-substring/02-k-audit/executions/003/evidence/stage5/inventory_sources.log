     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	  imports K-EQUAL
     6	
     7	  syntax Pgm ::= "solutionProgram" [function]
     8	  rule solutionProgram =>
     9	    Module(
    10	      ImportFrom("typing", "List")
    11	      FuncDef("filter_by_substring",
    12	        Params("strings", "substring"),
    13	        CellVars("substring"),
    14	        FreeVars(),
    15	        Return(
    16	          ListComp(Name("string"),
    17	            CompFor(
    18	              Name("string"),
    19	              Name("strings"),
    20	              Compare(Name("substring"), CmpOp("in", Name("string"))))))))
    21	
    22	  syntax PyList ::= filterRef(PyList, String) [function, total]
    23	  rule filterRef(Nil, _SUBSTRING) => Nil
    24	  rule filterRef(Cons(HEAD, TAIL), SUBSTRING)
    25	    => Cons(HEAD, filterRef(TAIL, SUBSTRING))
    26	    requires containsString(HEAD, SUBSTRING)
    27	  rule filterRef(Cons(HEAD, TAIL), SUBSTRING)
    28	    => filterRef(TAIL, SUBSTRING)
    29	    requires notBool containsString(HEAD, SUBSTRING)
    30	endmodule
