$ nl -ba /candidate/spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // The exact translated program reduces, for arbitrary inputs, to the
     7	  // generic list-comprehension evaluator.  The base and two exhaustive step
     8	  // claims prove that evaluator equal to filterRef by induction on PyList.
     9	  claim <k> execute(solutionProgram,
    10	                    "filter_by_substring",
    11	                    INPUT:PyList,
    12	                    SUBSTRING:String)
    13	          => evalComp(INPUT,
    14	                      substringFilter(SUBSTRING))
    15	        </k>
    16	    [label(UNIVERSAL-PROGRAM-REDUCTION)]
    17	
    18	  claim <k> evalComp(Nil,
    19	                     substringFilter(SUBSTRING:String))
    20	          => filterRef(Nil, SUBSTRING)
    21	        </k>
    22	    [label(UNIVERSAL-BASE)]
    23	
    24	  claim <k> evalComp(Cons(HEAD:String, TAIL:PyList),
    25	                     substringFilter(SUBSTRING:String))
    26	          => filterRef(Cons(HEAD, TAIL), SUBSTRING)
    27	        </k>
    28	    requires containsString(HEAD, SUBSTRING)
    29	             andBool
    30	             (evalComp(TAIL,
    31	                       substringFilter(SUBSTRING))
    32	              ==K filterRef(TAIL, SUBSTRING))
    33	    [label(UNIVERSAL-STEP-KEEP)]
    34	
    35	  claim <k> evalComp(Cons(HEAD:String, TAIL:PyList),
    36	                     substringFilter(SUBSTRING:String))
    37	          => filterRef(Cons(HEAD, TAIL), SUBSTRING)
    38	        </k>
    39	    requires notBool containsString(HEAD, SUBSTRING)
    40	             andBool
    41	             (evalComp(TAIL,
    42	                       substringFilter(SUBSTRING))
    43	              ==K filterRef(TAIL, SUBSTRING))
    44	    [label(UNIVERSAL-STEP-DROP)]
    45	
    46	  claim <k> execute(solutionProgram,
    47	                    "filter_by_substring",
    48	                    Nil,
    49	                    "a")
    50	          => Nil
    51	        </k>
    52	    [label(EMPTY-EXAMPLE)]
    53	
    54	  claim <k> execute(solutionProgram,
    55	                    "filter_by_substring",
    56	                    Cons("abc", Cons("bacd", Cons("cde", Cons("array", Nil)))),
    57	                    "a")
    58	          => Cons("abc", Cons("bacd", Cons("array", Nil)))
    59	        </k>
    60	    [label(PROMPT-EXAMPLE)]
    61	endmodule
EXIT: 0
