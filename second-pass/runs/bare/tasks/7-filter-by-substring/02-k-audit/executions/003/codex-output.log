+#!/usr/bin/env bash
+set -u
+
+status=0
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf 'EXIT: %d\n' "$rc"
+  if [[ "$rc" -ne 0 ]]; then
+    status=1
+  fi
+}
