import hashlib,json,itertools
from pathlib import Path
roots=[(Path('/generation-evidence/codex-trace'),'e6698dec549b28fe4ea87b3ba31ad151cc1daaa78532a20dc246cb3da1defc44'),(Path('/candidate'),'00c4f720e8708a2fc4efc9a96857656c381d44a81454e9916caf6c1be9aec0f5')]

def ents(root,dirs):
 out=[]
 for p in sorted(root.rglob('*')):
  rel=p.relative_to(root).as_posix()
  if p.is_dir():
   if dirs: out.append((rel,'directory',None,0,p.stat().st_mode & 0o777))
  else:
   b=p.read_bytes();out.append((rel,'file',hashlib.sha256(b).hexdigest(),len(b),p.stat().st_mode & 0o777))
 return out

for dirs in (False,True):
 for include in itertools.product((0,1), repeat=4): # kind sha size mode
  if not include[1]: continue
  for shape in ('mapping','tuples','dicts'):
   for rootprefix in ('','.'):
    for newline in (False,True):
     for compact in (False,True):
      docs=[]
      for root,target in roots:
       es=ents(root,dirs)
       if shape=='mapping':
        doc={rootprefix+e[0]:([e[i+1] for i,v in enumerate(include) if v]) for e in es}
       elif shape=='tuples':
        doc=[[rootprefix+e[0]]+[e[i+1] for i,v in enumerate(include) if v] for e in es]
       else:
        keys=['kind','sha256','size','mode']
        doc=[]
        for e in es:
         d={'path':rootprefix+e[0]}
         d.update({keys[i]:e[i+1] for i,v in enumerate(include) if v})
         doc.append(d)
       kw={'sort_keys':True}
       if compact:kw['separators']=(',',':')
       s=json.dumps(doc,**kw)+('\\n' if newline else '')
       docs.append(hashlib.sha256(s.encode()).hexdigest()==target)
      if all(docs):
       print('FOUND',dirs,include,shape,rootprefix,newline,compact);raise SystemExit
print('no json match')
PY" in /audit-output
