+assert actual == expected
+PY
+rc=$?
+printf 'EXIT: %d\n' "$rc"
+if [[ "$rc" -ne 0 ]]; then
+  status=1
+fi
+
+printf '%s\n' '$ find /audit-output/evidence -type f -printf "%s %p\\n" | sort -k2'
+find /audit-output/evidence -type f -printf '%s %p\n' | sort -k2
+rc=$?
+printf 'EXIT: %d\n' "$rc"
+if [[ "$rc" -ne 0 ]]; then
+  status=1
+fi
+
+exit "$status"

