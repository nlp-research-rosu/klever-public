      if hashlib.sha256(blob).hexdigest()==target:
       ok.append(trail)
    if len(ok)==2 and ok[0]==ok[1]:
     print('found',names,inner,outer,ok);raise SystemExit
print('no file-manifest simple match')
PY" in /audit-output
