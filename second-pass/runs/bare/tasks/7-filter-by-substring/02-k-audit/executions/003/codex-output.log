+printf '%s\n' '$ cp /tmp/audit-work/source/semantic.k /tmp/audit-work/tests/false-postcondition/semantic.k'
+cp -- /tmp/audit-work/source/semantic.k "$mutation_dir/semantic.k"
+rc=$?
+printf 'EXIT: %d\n' "$rc"
