  if 'p' not in names and 'dotp' not in names: continue
  if 'h' not in names and 'r' not in names: continue
  for inner in seps:
   for outer in seps:
    ok=[]
    for root,target in roots:
     parts=[inner.join(t[n] for n in names) for t in toks(root)]
     for trail in (False,True):
