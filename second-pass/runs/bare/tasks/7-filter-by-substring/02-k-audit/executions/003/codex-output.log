+kprove "$mutation_dir/spec-vacuity.k" \
+  --definition "$definition" \
+  --spec-module SPEC-VACUITY \
+  --claims FALSE-PROMPT-RESULT \
+  --dry-run > "$mutation_dir/dry-run.kore" 2>&1
+rc=$?
