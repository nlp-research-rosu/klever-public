import hashlib,itertools
from pathlib import Path
roots=[(Path('/generation-evidence/codex-trace'),'e6698dec549b28fe4ea87b3ba31ad151cc1daaa78532a20dc246cb3da1defc44'),(Path('/candidate'),'00c4f720e8708a2fc4efc9a96857656c381d44a81454e9916caf6c1be9aec0f5')]
seps=[b'',b'\\0',b'\\n',b' ',b'  ',b':',b'|']

def toks(root):
 out=[]
 for p in sorted(q for q in root.rglob('*') if q.is_file()):
  rel=p.relative_to(root).as_posix().encode();data=p.read_bytes();sha=hashlib.sha256(data)
