+#!/usr/bin/env bash
+set -u
+
+LOG=/audit-output/evidence/stage4-5-static.log
+exec > >(tee "$LOG") 2>&1
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
