    if test "$claim_status" -ne 0; then overall=1; fi
  done
  printf '"'OVERALL_EXIT_STATUS: %s\\n' \""'$overall"
  exit "$overall"
} 2>&1 | tee /audit-output/evidence/09-kprove-individual-claims.log
status=${PIPESTATUS[0]}
exit "$status"' in /tmp/audit-work/candidate-src
