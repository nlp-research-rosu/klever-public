    26	
    27	  // If R is not the sentinel, Y < R+2 says that the next even integer after
    28	  // R is outside the interval; together with evenness and the range bounds,
    29	  // this characterizes the greatest even member of [X,Y].
    30	  syntax Bool ::= "chooseNumContract" "(" Int "," Int "," Int ")" [function]
    31	  rule chooseNumContract(X, Y, R)
    32	    => (R ==Int -1 andBool noEvenInRange(X, Y))
    33	       orBool
    34	       (R =/=Int -1
