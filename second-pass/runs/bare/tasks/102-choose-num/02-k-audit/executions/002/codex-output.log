     1	requires "semantic.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Empty interval: there is no integer, and hence no even integer, in [X,Y].
     7	  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(-1) </k>
     8	    requires 0 <Int X andBool 0 <Int Y andBool X >Int Y
     9	
    10	  // Nonempty interval with an even upper endpoint: Y itself is the maximum.
    11	  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(Y) </k>
    12	    requires 0 <Int X andBool 0 <Int Y
    13	     andBool X <=Int Y andBool Y %Int 2 ==Int 0
    14	
    15	  // An odd upper endpoint with room below it: Y-1 is in range and is the
    16	  // greatest even integer because it is immediately below Y.
    17	  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(Y -Int 1) </k>
    18	    requires 0 <Int X andBool 0 <Int Y
    19	     andBool X <Int Y andBool Y %Int 2 =/=Int 0
    20	
    21	  // The only nonempty interval without an even candidate is [odd, odd].
    22	  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(-1) </k>
    23	    requires 0 <Int X andBool 0 <Int Y
