python3 /audit-output/evidence/concrete_semantics_test.py 2>&1 | tee /audit-output/evidence/07-concrete-execution.log
status=${PIPESTATUS[0]}
printf '"'COMMAND: python3 /audit-output/evidence/concrete_semantics_test.py\\nEXIT_STATUS: %s\\n' \""'$status" | tee -a /audit-output/evidence/07-concrete-execution.log
