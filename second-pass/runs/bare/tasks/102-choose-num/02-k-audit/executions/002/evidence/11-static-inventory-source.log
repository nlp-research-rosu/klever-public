semantic.k:51:  syntax Val ::= "modulo" "(" Val "," Val ")" [function]
semantic.k:54:  syntax Val ::= "compare" "(" String "," Val "," Val ")" [function]
semantic.k:58:  syntax Bool ::= "truth" "(" Val ")" [function]
semantic.k:61:  syntax Val ::= "eval" "(" Expr "," Env ")" [function]
