COMMAND: rg -n '^\s*(module|imports|configuration|syntax|rule|claim)' semantic.k verification.k spec.k
spec.k:3:module SPEC
spec.k:4:  imports VERIFICATION
spec.k:7:  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(-1) </k>
spec.k:11:  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(Y) </k>
spec.k:17:  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(Y -Int 1) </k>
spec.k:22:  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(-1) </k>
spec.k:29:  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
spec.k:33:  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
spec.k:38:  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
spec.k:43:  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
verification.k:1:module VERIFICATION
verification.k:2:  imports MPY
verification.k:4:  syntax Program ::= "chooseNumProgram" [function]
verification.k:5:  rule chooseNumProgram
verification.k:22:  syntax Bool ::= "noEvenInRange" "(" Int "," Int ")" [function]
verification.k:23:  rule noEvenInRange(X, Y)
verification.k:30:  syntax Bool ::= "chooseNumContract" "(" Int "," Int "," Int ")" [function]
verification.k:31:  rule chooseNumContract(X, Y, R)
verification.k:40:  syntax KItem ::= "checkChooseNum" "(" Int "," Int ")"
verification.k:41:  rule <k> VInt(R) ~> checkChooseNum(X, Y)
semantic.k:3:module MPY-SYNTAX
semantic.k:4:  imports INT-SYNTAX
semantic.k:5:  imports BOOL-SYNTAX
semantic.k:6:  imports STRING-SYNTAX
semantic.k:8:  syntax Program ::= "Module" "(" Stmts ")"
semantic.k:12:  syntax Stmts ::= List{Stmt, ""}
semantic.k:13:  syntax Strings ::= List{String, ","}
semantic.k:14:  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
semantic.k:16:  syntax Params ::= "Params" "(" Strings ")"
semantic.k:18:  syntax Expr ::= "Int" "(" Int ")"
semantic.k:25:  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
semantic.k:28:module MPY
semantic.k:29:  imports MPY-SYNTAX
semantic.k:30:  imports INT
semantic.k:31:  imports BOOL
semantic.k:32:  imports STRING
semantic.k:34:  configuration <k> $PGM:Program </k>
semantic.k:36:  syntax Val ::= "VInt" "(" Int ")" | "VBool" "(" Bool ")"
semantic.k:37:  syntax Env ::= "emptyEnv"
semantic.k:40:  syntax Val ::= "lookup" "(" Env "," String ")" [function]
semantic.k:41:  rule lookup(bind(_ENV, NAME, VALUE), NAME) => VALUE
semantic.k:42:  rule lookup(bind(ENV, BOUND, _VALUE), NAME) => lookup(ENV, NAME)
semantic.k:45:  syntax Val ::= "negate" "(" Val ")" [function]
semantic.k:46:  rule negate(VInt(I)) => VInt(0 -Int I)
semantic.k:48:  syntax Val ::= "subtract" "(" Val "," Val ")" [function]
semantic.k:49:  rule subtract(VInt(I), VInt(J)) => VInt(I -Int J)
semantic.k:51:  syntax Val ::= "modulo" "(" Val "," Val ")" [function]
semantic.k:52:  rule modulo(VInt(I), VInt(J)) => VInt(I %Int J)
semantic.k:54:  syntax Val ::= "compare" "(" String "," Val "," Val ")" [function]
semantic.k:55:  rule compare(">",  VInt(I), VInt(J)) => VBool(I >Int J)
semantic.k:56:  rule compare("==", VInt(I), VInt(J)) => VBool(I ==Int J)
semantic.k:58:  syntax Bool ::= "truth" "(" Val ")" [function]
semantic.k:59:  rule truth(VBool(B)) => B
semantic.k:61:  syntax Val ::= "eval" "(" Expr "," Env ")" [function]
semantic.k:62:  rule eval(Int(I), _ENV) => VInt(I)
semantic.k:63:  rule eval(Bool(B), _ENV) => VBool(B)
semantic.k:64:  rule eval(Name(NAME), ENV) => lookup(ENV, NAME)
semantic.k:65:  rule eval(UnaryOp("-", E), ENV) => negate(eval(E, ENV))
semantic.k:66:  rule eval(BinOp("-", E1, E2), ENV)
semantic.k:68:  rule eval(BinOp("%", E1, E2), ENV)
semantic.k:70:  rule eval(Compare(E1, CmpOp(OP, E2)), ENV)
semantic.k:72:  rule eval(IfExp(COND, THEN, _ELSE), ENV) => eval(THEN, ENV)
semantic.k:74:  rule eval(IfExp(COND, _THEN, ELSE), ENV) => eval(ELSE, ENV)
semantic.k:80:  rule <k>
RG_EXIT_STATUS: 0
