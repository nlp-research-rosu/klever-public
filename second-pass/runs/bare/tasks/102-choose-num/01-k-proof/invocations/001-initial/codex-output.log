requires "verification.k"

module MPY-SYNTAX
  imports INT-SYNTAX
  imports BOOL-SYNTAX
  imports STRING-SYNTAX

  syntax Program ::= "Module" "(" Stmts ")"
                   | "Run" "(" Program "," Expr "," Expr ")"

  // The translator prints statement sequences by juxtaposition.
  syntax Stmts ::= List{Stmt, ""}
  syntax Strings ::= List{String, ","}
  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
                | "Return" "(" Expr ")"
  syntax Params ::= "Params" "(" Strings ")"

  syntax Expr ::= "Int" "(" Int ")"
                | "Bool" "(" Bool ")"
                | "Name" "(" String ")"
                | "UnaryOp" "(" String "," Expr ")"
                | "BinOp" "(" String "," Expr "," Expr ")"
                | "Compare" "(" Expr "," CmpOp ")"
                | "IfExp" "(" Expr "," Expr "," Expr ")"
  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
endmodule

module MPY
  imports MPY-SYNTAX
  imports INT
  imports BOOL
  imports STRING

  configuration <k> $PGM:Program </k>

  syntax Val ::= "VInt" "(" Int ")" | "VBool" "(" Bool ")"
  syntax Env ::= "emptyEnv"
               | "bind" "(" Env "," String "," Val ")"

  syntax Val ::= "lookup" "(" Env "," String ")" [function]
  rule lookup(bind(_ENV, NAME, VALUE), NAME) => VALUE
  rule lookup(bind(ENV, BOUND, _VALUE), NAME) => lookup(ENV, NAME)
    requires BOUND =/=String NAME

  syntax Val ::= "negate" "(" Val ")" [function]
  rule negate(VInt(I)) => VInt(0 -Int I)

  syntax Val ::= "subtract" "(" Val "," Val ")" [function]
  rule subtract(VInt(I), VInt(J)) => VInt(I -Int J)

  syntax Val ::= "modulo" "(" Val "," Val ")" [function]
  rule modulo(VInt(I), VInt(J)) => VInt(I %Int J)

  syntax Val ::= "compare" "(" String "," Val "," Val ")" [function]
  rule compare(">",  VInt(I), VInt(J)) => VBool(I >Int J)
  rule compare("==", VInt(I), VInt(J)) => VBool(I ==Int J)

  syntax Bool ::= "truth" "(" Val ")" [function]
  rule truth(VBool(B)) => B

  syntax Val ::= "eval" "(" Expr "," Env ")" [function]
  rule eval(Int(I), _ENV) => VInt(I)
  rule eval(Bool(B), _ENV) => VBool(B)
  rule eval(Name(NAME), ENV) => lookup(ENV, NAME)
  rule eval(UnaryOp("-", E), ENV) => negate(eval(E, ENV))
  rule eval(BinOp("-", E1, E2), ENV)
    => subtract(eval(E1, ENV), eval(E2, ENV))
  rule eval(BinOp("%", E1, E2), ENV)
    => modulo(eval(E1, ENV), eval(E2, ENV))
  rule eval(Compare(E1, CmpOp(OP, E2)), ENV)
    => compare(OP, eval(E1, ENV), eval(E2, ENV))
  rule eval(IfExp(COND, THEN, _ELSE), ENV) => eval(THEN, ENV)
    requires truth(eval(COND, ENV))
  rule eval(IfExp(COND, _THEN, ELSE), ENV) => eval(ELSE, ENV)
    requires notBool truth(eval(COND, ENV))

  // This condition's programs contain one two-argument function whose body is
  // a return expression. Run supplies its two arguments and evaluates that
  // translated body in an environment named by the translated parameters.
  rule <k>
         Run(Module(FuncDef(_FNAME, Params(P1, P2), Return(E))), Int(X), Int(Y))
      => eval(E, bind(bind(emptyEnv, P1, VInt(X)), P2, VInt(Y)))
         ...
       </k>
endmodule
module VERIFICATION
  imports MPY

  syntax Program ::= "chooseNumProgram" [function]
  rule chooseNumProgram
    => Module(
         FuncDef("choose_num", Params("x", "y"),
           Return(
             IfExp(
               Compare(Name("x"), CmpOp(">", Name("y"))),
               UnaryOp("-", Int(1)),
               IfExp(
                 Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
                 Name("y"),
                 IfExp(
                   Compare(Name("x"), CmpOp("==", Name("y"))),
                   UnaryOp("-", Int(1)),
                   BinOp("-", Name("y"), Int(1))))))))

  // For integer endpoints, an interval has no even member exactly when it is
  // empty, or when it is a one-element interval containing an odd integer.
  syntax Bool ::= "noEvenInRange" "(" Int "," Int ")" [function]
  rule noEvenInRange(X, Y)
    => X >Int Y
       orBool (X ==Int Y andBool X %Int 2 =/=Int 0)

  // If R is not the sentinel, Y < R+2 says that the next even integer after
  // R is outside the interval; together with evenness and the range bounds,
  // this characterizes the greatest even member of [X,Y].
  syntax Bool ::= "chooseNumContract" "(" Int "," Int "," Int ")" [function]
  rule chooseNumContract(X, Y, R)
    => (R ==Int -1 andBool noEvenInRange(X, Y))
       orBool
       (R =/=Int -1
        andBool X <=Int R
        andBool R <=Int Y
        andBool R %Int 2 ==Int 0
        andBool Y <Int R +Int 2)

  syntax KItem ::= "checkChooseNum" "(" Int "," Int ")"
  rule <k> VInt(R) ~> checkChooseNum(X, Y)
        => VBool(chooseNumContract(X, Y, R)) ... </k>
endmodule
requires "semantic.k"

module SPEC
  imports VERIFICATION

  // Empty interval: there is no integer, and hence no even integer, in [X,Y].
  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(-1) </k>
    requires 0 <Int X andBool 0 <Int Y andBool X >Int Y

  // Nonempty interval with an even upper endpoint: Y itself is the maximum.
  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(Y) </k>
    requires 0 <Int X andBool 0 <Int Y
     andBool X <=Int Y andBool Y %Int 2 ==Int 0

  // An odd upper endpoint with room below it: Y-1 is in range and is the
  // greatest even integer because it is immediately below Y.
  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(Y -Int 1) </k>
    requires 0 <Int X andBool 0 <Int Y
     andBool X <Int Y andBool Y %Int 2 =/=Int 0

  // The only nonempty interval without an even candidate is [odd, odd].
  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(-1) </k>
    requires 0 <Int X andBool 0 <Int Y
     andBool X ==Int Y andBool Y %Int 2 =/=Int 0

  // End-to-end contract over the same exhaustive partition: execution
  // produces either the required sentinel, or an in-range even result whose
  // next possible even successor exceeds Y.
  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
             ~> checkChooseNum(X, Y) => VBool(true) </k>
    requires 0 <Int X andBool 0 <Int Y andBool X >Int Y

  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
             ~> checkChooseNum(X, Y) => VBool(true) </k>
    requires 0 <Int X andBool 0 <Int Y
     andBool X <=Int Y andBool Y %Int 2 ==Int 0

  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
             ~> checkChooseNum(X, Y) => VBool(true) </k>
    requires 0 <Int X andBool 0 <Int Y
     andBool X <Int Y andBool Y %Int 2 =/=Int 0

  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
             ~> checkChooseNum(X, Y) => VBool(true) </k>
    requires 0 <Int X andBool 0 <Int Y
     andBool X ==Int Y andBool Y %Int 2 =/=Int 0
endmodule
#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Recreate the submitted constructor term from the unmodified translator.
python3 py2mpy.py solution.py > solution.mpy

# A finite oracle check complements (but does not replace) the symbolic proof.
python3 - <<'PY'
from solution import choose_num

for x in range(1, 41):
    for y in range(1, 41):
        evens = [n for n in range(x, y + 1) if n % 2 == 0]
        expected = max(evens) if evens else -1
        assert choose_num(x, y) == expected, (x, y)
PY

# The verification module is included in the compiled definition because its
# chooseNumProgram term is the exact constructor tree emitted in solution.mpy.
kompile semantic.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX

# Execute the translated program on the prompt example and the odd singleton
# boundary case. Fail if either final value is not the expected one.
example_output="$(krun run-12-15.mpy --definition semantic-kompiled)"
printf '%s\n' "$example_output"
grep -Fq 'VInt ( 14 )' <<<"$example_output"

boundary_output="$(krun run-13-13.mpy --definition semantic-kompiled)"
printf '%s\n' "$boundary_output"
grep -Fq 'VInt ( -1 )' <<<"$boundary_output"

# Prove all eight claims: four exact-result claims over an exhaustive input
# partition and four corresponding end-to-end contract claims.
kprove spec.k \
  --definition semantic-kompiled \
  --spec-module SPEC

