+requires "semantic.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Empty interval: there is no integer, and hence no even integer, in [X,Y].
+  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(-1) </k>
+    requires 0 <Int X andBool 0 <Int Y andBool X >Int Y
+
+  // Nonempty interval with an even upper endpoint: Y itself is the maximum.
+  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(Y) </k>
+    requires 0 <Int X andBool 0 <Int Y
+     andBool X <=Int Y andBool Y %Int 2 ==Int 0
+
+  // An odd upper endpoint with room below it: Y-1 is in range and is the
+  // greatest even integer because it is immediately below Y.
+  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(Y -Int 1) </k>
+    requires 0 <Int X andBool 0 <Int Y
+     andBool X <Int Y andBool Y %Int 2 =/=Int 0
+
+  // The only nonempty interval without an even candidate is [odd, odd].
+  claim <k> Run(chooseNumProgram, Int(X), Int(Y)) => VInt(-1) </k>
+    requires 0 <Int X andBool 0 <Int Y
+     andBool X ==Int Y andBool Y %Int 2 =/=Int 0
+
+  // End-to-end contract over the same exhaustive partition: execution
+  // produces either the required sentinel, or an in-range even result whose
+  // next possible even successor exceeds Y.
+  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
+             ~> checkChooseNum(X, Y) => VBool(true) </k>
+    requires 0 <Int X andBool 0 <Int Y andBool X >Int Y
+
+  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
+             ~> checkChooseNum(X, Y) => VBool(true) </k>
+    requires 0 <Int X andBool 0 <Int Y
+     andBool X <=Int Y andBool Y %Int 2 ==Int 0
+
+  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
+             ~> checkChooseNum(X, Y) => VBool(true) </k>
+    requires 0 <Int X andBool 0 <Int Y
+     andBool X <Int Y andBool Y %Int 2 =/=Int 0
+
+  claim <k> Run(chooseNumProgram, Int(X), Int(Y))
+             ~> checkChooseNum(X, Y) => VBool(true) </k>
+    requires 0 <Int X andBool 0 <Int Y
+     andBool X ==Int Y andBool Y %Int 2 =/=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2c79acb2b8829d3afd2ad893758283b37e412418
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+module VERIFICATION
+  imports MPY
+
+  syntax Program ::= "chooseNumProgram" [function]
+  rule chooseNumProgram
+    => Module(
+         FuncDef("choose_num", Params("x", "y"),
+           Return(
+             IfExp(
+               Compare(Name("x"), CmpOp(">", Name("y"))),
+               UnaryOp("-", Int(1)),
+               IfExp(
+                 Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
+                 Name("y"),
+                 IfExp(
+                   Compare(Name("x"), CmpOp("==", Name("y"))),
+                   UnaryOp("-", Int(1)),
+                   BinOp("-", Name("y"), Int(1))))))))
+
+  // For integer endpoints, an interval has no even member exactly when it is
+  // empty, or when it is a one-element interval containing an odd integer.
+  syntax Bool ::= "noEvenInRange" "(" Int "," Int ")" [function]
+  rule noEvenInRange(X, Y)
+    => X >Int Y
+       orBool (X ==Int Y andBool X %Int 2 =/=Int 0)
+
+  // If R is not the sentinel, Y < R+2 says that the next even integer after
+  // R is outside the interval; together with evenness and the range bounds,
+  // this characterizes the greatest even member of [X,Y].
+  syntax Bool ::= "chooseNumContract" "(" Int "," Int "," Int ")" [function]
+  rule chooseNumContract(X, Y, R)
+    => (R ==Int -1 andBool noEvenInRange(X, Y))
+       orBool
+       (R =/=Int -1
+        andBool X <=Int R
+        andBool R <=Int Y
+        andBool R %Int 2 ==Int 0
+        andBool Y <Int R +Int 2)
+
+  syntax KItem ::= "checkChooseNum" "(" Int "," Int ")"
+  rule <k> VInt(R) ~> checkChooseNum(X, Y)
+        => VBool(chooseNumContract(X, Y, R)) ... </k>
+endmodule

