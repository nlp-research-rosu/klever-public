diff --git a//tmp/audit-work/lean_proc_exe_shim.c b//tmp/audit-work/lean_proc_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..38d04b9e772554be8ba75f21a3de6a91c7166f69
--- /dev/null
+++ b//tmp/audit-work/lean_proc_exe_shim.c
@@ -0,0 +1,86 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_numeric_proc_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    const char *cursor;
+    size_t length;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    cursor = path + sizeof(prefix) - 1;
+    if (*cursor < '0' || *cursor > '9') {
+        return 0;
+    }
+    while (*cursor >= '0' && *cursor <= '9') {
+        cursor++;
+    }
+    length = strlen(cursor);
+    return length == sizeof(suffix) - 1
+        && strcmp(cursor, suffix) == 0;
+}
+
+static ssize_t copy_target(char *buffer, size_t size) {
+    const char target[] =
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    const size_t length = sizeof(target) - 1;
+
+    if (size == 0) {
+        return 0;
+    }
+    if (length > size) {
+        memcpy(buffer, target, size);
+        return (ssize_t) size;
+    }
+    memcpy(buffer, target, length);
+    return (ssize_t) length;
+}
+
+ssize_t readlink(const char *restrict path, char *restrict buffer, size_t size) {
+    static ssize_t (*real_readlink)(
+        const char *restrict, char *restrict, size_t
+    ) = NULL;
+
+    if (is_numeric_proc_exe(path)) {
+        return copy_target(buffer, size);
+    }
+    if (real_readlink == NULL) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+        if (real_readlink == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+    return real_readlink(path, buffer, size);
+}
+
+ssize_t readlinkat(
+    int directory,
+    const char *restrict path,
+    char *restrict buffer,
+    size_t size
+) {
+    static ssize_t (*real_readlinkat)(
+        int, const char *restrict, char *restrict, size_t
+    ) = NULL;
+
+    if (is_numeric_proc_exe(path)) {
+        return copy_target(buffer, size);
+    }
+    if (real_readlinkat == NULL) {
+        real_readlinkat = dlsym(RTLD_NEXT, "readlinkat");
+        if (real_readlinkat == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+    return real_readlinkat(directory, path, buffer, size);
+}
