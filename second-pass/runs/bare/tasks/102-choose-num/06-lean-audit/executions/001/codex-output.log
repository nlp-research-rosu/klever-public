+            "oracle": source_oracle(1, 5),
+        },
+    )
+    assert mutated_odd_branch(1, 5) != source_oracle(1, 5)
+
+    print("semantic_checks", "PASS")
+
+
+if __name__ == "__main__":
+    main()

