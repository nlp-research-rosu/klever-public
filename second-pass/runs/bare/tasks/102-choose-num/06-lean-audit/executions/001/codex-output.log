+                        "kind": "contract_rejects_program",
+                        "x": x,
+                        "y": y,
+                        "result": observed,
+                    }
+                )
+    print("tested_pairs", 101 * 101)
+    print("mismatch_count", len(mismatches))
+    if mismatches:
+        print("first_mismatches", json.dumps(mismatches[:10], sort_keys=True))
+    assert not mismatches
+
+    witnesses = [
