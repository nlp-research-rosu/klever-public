+            "x": 1,
+            "y": 4,
+            "result": -1,
+        },
+        {
+            "name": "nonmaximal_even",
+            "x": 1,
+            "y": 4,
+            "result": 2,
+        },
+        {
+            "name": "odd_in_range",
