+requires "semantic.k"
+
+module AUDIT-RUNTIME
+  imports VERIFICATION
+
+  syntax Program ::= "RunChecked" "(" Program "," Expr "," Expr "," Int "," Int ")"
+                   | "CheckValue" "(" Int "," Int "," Int ")"
+
+  rule <k> RunChecked(PGM, XARG, YARG, X, Y)
+        => Run(PGM, XARG, YARG) ~> checkChooseNum(X, Y) ... </k>
+
+  rule <k> CheckValue(R, X, Y)
+        => VInt(R) ~> checkChooseNum(X, Y) ... </k>
+endmodule
