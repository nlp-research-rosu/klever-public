allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
expected_ids = [r['source_rule_id'] for r in inventory['rules']]
actual_ids = []
for entry in out['rules']:
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
    actual_ids.append(entry['source_rule_id'])
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids))
for inv, entry in zip(inventory['rules'], out['rules']):
    if 'simplification' in inv['attributes']:
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
assert 'The domain-lemma set is empty.' in Path('/workspace/DISCOVERY.md').read_text()
print(f\"validated {len(actual_ids)} rules in canonical order\")
print(f\"inventory_sha256={out['inventory_sha256']}\")
print('classifications=' + ','.join(e['classification'] for e in out['rules']))
