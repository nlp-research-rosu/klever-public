--- /dev/null
+++ b/evidence/spec-body-mutation.k
@@ -0,0 +1,22 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Body-sensitivity probe: mutated source body returns 0 but retains square postcondition.
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "car_race_collision",
+          Params("n"),
+          Return(Int(0))
+        )
+      ) ~> run("car_race_collision", N)
+      => .K
+    </k>
+    <functions> .Map => "car_race_collision" |-> definition("n", Return(Int(0))) </functions>
+    <environment> .Map => "n" |-> N </environment>
+    <result> 0 => N *Int N </result>
+    requires N >=Int 0
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec3239ea3458c2ea27be50679272eb4fac8a2688
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,22 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false at every satisfying input: the result is not n*n + 1.
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "car_race_collision",
+          Params("n"),
+          Return(BinOp("*", Name("n"), Name("n")))
+        )
+      ) ~> run("car_race_collision", N)
+      => .K
+    </k>
+    <functions> .Map => "car_race_collision" |-> definition("n", Return(BinOp("*", Name("n"), Name("n")))) </functions>
+    <environment> .Map => "n" |-> N </environment>
+    <result> 0 => (N *Int N) +Int 1 </result>
+    requires N >=Int 0
+endmodule
