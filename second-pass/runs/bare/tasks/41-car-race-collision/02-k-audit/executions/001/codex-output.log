                                 '    if isinstance(node, ast.Subscript):\n'
                                 '        return Ctor("Subscript", emit_expr(node.value), emit_index(node.slice))\n'
                                 '\n'
                                 '    if isinstance(node, ast.Attribute):\n'
                                 '        return Ctor("Attribute", emit_expr(node.value), q(node.attr))\n'
                                 '\n'
                                 '    if isinstance(node, ast.Call):\n'
                                 '        if any(isinstance(a, ast.Starred) for a in node.args):\n'
                                 '            raise Unsupported("*args unpacking")\n'
                                 '        if any(kw.arg is None for kw in node.keywords):\n'
                                 '            raise Unsupported("**kwargs unpacking")\n'
                                 '        # Call grammar is `Call(Expr, Exprs)` — the comma is mandatory, so a '
                                 'zero-arg\n'
                                 "        # call must render as `Call(f, )` (empty Exprs), NOT `Call(f)` (which won't "
                                 'parse).\n'
                                 '        args = [emit_expr(a) for a in node.args]\n'
                                 '        args += [Ctor("KwArg", q(kw.arg), emit_expr(kw.value)) for kw in '
                                 'node.keywords]\n'
                                 '        args = args or [""]\n'
                                 '        return Ctor("Call", emit_expr(node.func), *args)\n'
                                 '\n'
                                 '    if isinstance(node, ast.IfExp):\n'
                                 '        # AST field order: test, body, orelse — kept verbatim.\n'
                                 '        return Ctor("IfExp", emit_expr(node.test),\n'
                                 '                    emit_expr(node.body), emit_expr(node.orelse))\n'
                                 '\n'
                                 '    if isinstance(node, ast.ListComp):\n'
                                 '        return Ctor("ListComp", emit_expr(node.elt), _gens(node.generators))\n'
                                 '    if isinstance(node, ast.SetComp):\n'
                                 '        return Ctor("SetComp", emit_expr(node.elt), _gens(node.generators))\n'
                                 '    if isinstance(node, ast.GeneratorExp):\n'
                                 '        return Ctor("GenExp", emit_expr(node.elt), _gens(node.generators))\n'
                                 '    if isinstance(node, ast.DictComp):\n'
                                 '        return Ctor("DictComp", emit_expr(node.key), emit_expr(node.value),\n'
                                 '                    _gens(node.generators))\n'
                                 '\n'
                                 '    raise Unsupported(f"Expr {type(node).__name__}")\n'
                                 '\n'
                                 '\n'
                                 'def _op_or_raise(table, op, label):\n'
                                 '    spelled = table.get(type(op))\n'
                                 '    if spelled is None:\n'
                                 '        raise Unsupported(f"{label} {type(op).__name__}")\n'
                                 '    return spelled\n'
                                 '\n'
                                 '\n'
                                 'def _compfor(g):\n'
                                 '    """A single generator -> CompFor(target, iter, <ifs as Exprs; .Exprs if '
