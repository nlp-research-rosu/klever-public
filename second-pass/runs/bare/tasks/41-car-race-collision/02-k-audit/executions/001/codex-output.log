                                 'def car_race_collision(n: int):\n'
                                 '    """\n'
                                 "    Imagine a road that's a perfectly straight infinitely long line.\n"
                                 '    n cars are driving left to right;  simultaneously, a different set of n cars\n'
                                 '    are driving right to left.   The two sets of cars start out being very far from\n'
                                 '    each other.  All cars move in the same speed.  Two cars are said to collide\n'
                                 "    when a car that's moving left to right hits a car that's moving right to left.\n"
                                 '    However, the cars are infinitely sturdy and strong; as a result, they continue '
                                 'moving\n'
                                 '    in their trajectory as if they did not collide.\n'
                                 '\n'
                                 '    This function outputs the number of such collisions.\n'
                                 '    """\n'
                                 '#!/usr/bin/env python3\n'
                                 '"""py2mpy — a *pure* CPython-AST -> K-constructor transliterator.\n'
                                 '\n'
                                 'Reads a .py file and prints the matching `.mpy` term: a Lisp-indented tree of K\n'
                                 'constructors that a (future) K semantics will parse. The design rule is strict:\n'
                                 '\n'
                                 '    PURE TRANSLITERATION. Every Python AST node maps to exactly one K\n'
                                 '    constructor with the same structure. The front-end makes NO semantic\n'
                                 '    decisions — it does not desugar, simplify, normalize, or "interpret"\n'
                                 '    anything. All meaning lives in the K semantics that consumes the term.\n'
                                 '\n'
                                 'Consequences of that rule (vs. a "helpful" front-end):\n'
                                 '\n'
                                 '  * `is` / `is not` transliterate to `CmpOp("is", ...)` / `CmpOp("is not", ...)`\n'
                                 '    — NOT to `==` / `!=`. K decides what identity means.\n'
                                 '  * a chained comparison `a < b < c` stays a single `Compare` carrying the\n'
                                 '    chain (`Compare(a, CmpOp("<", b), CmpOp("<", c))`) — it is NOT pre-expanded\n'
                                 '    into `a < b and b < c`.\n'
                                 '  * a method call `x.append(v)` stays `Call(Attribute(Name("x"), "append"), v)`\n'
                                 '    — there is no special `MethodCall` constructor folding the receiver in.\n'
                                 '  * `a[i] = v` stays `Assign(Subscript(Name("a"), Name("i")), v)` — the target\n'
                                 '    is just an expression in store position; no special `SubscriptAssign`.\n'
                                 '\n'
                                 'The only choices the transliterator makes are unavoidably *syntactic* — e.g. a\n'
                                 "`bool` literal becomes `Bool(...)` not `Int(...)`, because that is the literal's\n"
                                 'actual Python type as read off the AST, not a semantic judgement.\n'
                                 '\n'
                                 'Anything outside the covered subset raises `Unsupported`, naming the node, so\n'
                                 'coverage gaps fail loudly instead of being silently dropped.\n'
                                 '\n'
                                 'Usage:\n'
                                 '    python scripts/py2mpy.py FILE.py          # print the .mpy term (default)\n'
                                 '    python scripts/py2mpy.py FILE.py --ast    # print the Python AST (ast.dump)\n'
                                 '"""\n'
                                 'from __future__ import annotations\n'
                                 '\n'
                                 'import argparse\n'
                                 'import symtable\n'
                                 'import ast\n'
                                 'import json\n'
                                 'import sys\n'
                                 '\n'
                                 '\n'
                                 'class Unsupported(Exception):\n'
                                 '    """Raised for any AST node the transliterator does not cover."""\n'
                                 '\n'
                                 '\n'
                                 '# ---------------------------------------------------------------------------\n'
                                 '# Term model: a .mpy term is a tree of these three node kinds.\n'
                                 '#   Ctor(name, *args)  -> `name(arg, arg, ...)`  (comma-separated args)\n'
                                 '#   Seq([item, ...])   -> a statement list: juxtaposed, no parens, no commas\n'
                                 '#   str                -> a leaf token already in K surface form\n'
                                 '#                         (a quoted string `"op"`, a number `0`, `true`, `Break`)\n'
                                 '# ---------------------------------------------------------------------------\n'
                                 'class Ctor:\n'
                                 '    __slots__ = ("name", "args")\n'
                                 '\n'
                                 '    def __init__(self, name: str, *args):\n'
                                 '        self.name = name\n'
                                 '        self.args = list(args)\n'
                                 '\n'
                                 '\n'
                                 'class Seq:\n'
                                 '    __slots__ = ("items",)\n'
                                 '\n'
                                 '    def __init__(self, items):\n'
                                 '        self.items = list(items)\n'
                                 '\n'
                                 '\n'
                                 'def q(s: str) -> str:\n'
                                 '    """A Python string as a K String token (double-quoted, escaped)."""\n'
                                 '    return json.dumps(s)\n'
                                 '\n'
                                 '\n'
                                 '# --- Operator spellings (string tokens carried inside constructors) ----------\n'
                                 '# These are transliterations of the operator *symbol*, not its meaning.\n'
                                 '_BINOP = {\n'
                                 '    ast.Add: "+", ast.Sub: "-", ast.Mult: "*", ast.Div: "/",\n'
                                 '    ast.FloorDiv: "//", ast.Mod: "%", ast.Pow: "**",\n'
                                 '    ast.BitOr: "|", ast.BitAnd: "&", ast.BitXor: "^",\n'
                                 '    ast.LShift: "<<", ast.RShift: ">>", ast.MatMult: "@",\n'
                                 '}\n'
                                 '_UNARY = {ast.USub: "-", ast.UAdd: "+", ast.Not: "not", ast.Invert: "~"}\n'
                                 '_BOOLOP = {ast.And: "and", ast.Or: "or"}\n'
                                 '_CMPOP = {\n'
                                 '    ast.Eq: "==", ast.NotEq: "!=", ast.Lt: "<", ast.LtE: "<=",\n'
                                 '    ast.Gt: ">", ast.GtE: ">=", ast.Is: "is", ast.IsNot: "is not",\n'
                                 '    ast.In: "in", ast.NotIn: "not in",\n'
                                 '}\n'
                                 '\n'
                                 '\n'
                                 '# ---------------------------------------------------------------------------\n'
                                 "# Closure scopes (Python's own symtable, faithfully exposed)\n"
                                 '# ---------------------------------------------------------------------------\n'
                                 '# (name, lineno) -> (cellvars, freevars, nested). A def/lambda gets the\n'
                                 '# ANNOTATED node form iff it is nested inside a function or has cells/frees;\n'
                                 '# module-level capture-free defs keep the old shape (zero churn).\n'
                                 'SCOPES: dict = {}\n'
                                 '\n'
                                 '\n'
                                 'def _frees(table):\n'
                                 '    return set(table.get_frees()) if isinstance(table, symtable.Function) else '
                                 'set()\n'
                                 '\n'
                                 '\n'
                                 'def _deep_frees(table):\n'
                                 '    out = _frees(table)\n'
                                 '    for g in table.get_children():\n'
                                 '        out |= _deep_frees(g) - set(table.get_locals())\n'
                                 '    return out\n'
                                 '\n'
                                 '\n'
                                 'def _walk_symtable(table, depth=0):\n'
                                 '    for child in table.get_children():\n'
                                 '        if child.get_type() in ("function", "lambda"):\n'
                                 '            frees = sorted(_frees(child))\n'
                                 '            cells = sorted(\n'
                                 '                s for s in child.get_locals()\n'
                                 '                if any(s in _deep_frees(g) for g in child.get_children())\n'
                                 '            )\n'
                                 '            SCOPES[(child.get_name(), child.get_lineno())] = (\n'
                                 '                cells, frees, depth > 0 or table.get_type() != "module")\n'
                                 '        _walk_symtable(child, depth + (1 if child.get_type() in ("function", '
                                 '"lambda") else 0))\n'
                                 '\n'
                                 '\n'
                                 'def scope_info(name, lineno):\n'
                                 '    return SCOPES.get((name, lineno))\n'
                                 '\n'
                                 '\n'
                                 '# ---------------------------------------------------------------------------\n'
                                 '# Expressions\n'
                                 '# ---------------------------------------------------------------------------\n'
                                 'def emit_expr(node: ast.expr):\n'
                                 '    if isinstance(node, ast.Constant):\n'
                                 '        v = node.value\n'
                                 '        if v is None:\n'
                                 '            return "NoneVal"\n'
                                 '        if isinstance(v, bool):                 # MUST precede int (bool ⊂ int)\n'
                                 '            return Ctor("Bool", "true" if v else "false")\n'
                                 '        if isinstance(v, int):\n'
                                 '            return Ctor("Int", str(v))\n'
                                 '        if isinstance(v, float):\n'
                                 '            return Ctor("Float", repr(v))\n'
                                 '        if isinstance(v, str):\n'
                                 '            return Ctor("Str", q(v))\n'
                                 '        raise Unsupported(f"Constant {type(v).__name__}")\n'
                                 '\n'
                                 '    if isinstance(node, ast.Name):\n'
                                 '        return Ctor("Name", q(node.id))\n'
                                 '\n'
                                 '    if isinstance(node, ast.Lambda):\n'
                                 '        a = node.args\n'
                                 '        if a.vararg or a.kwarg or a.kwonlyargs or a.defaults or a.kw_defaults:\n'
                                 '            raise Unsupported("complex lambda signature")\n'
                                 '        names = [p.arg for p in (a.posonlyargs + a.args)]\n'
                                 '        params = Ctor("Params", *(q(n) for n in names))\n'
                                 '        info = scope_info("lambda", node.lineno)\n'
                                 '        if info and (info[0] or info[1] or info[2]):\n'
                                 '            cells, frees, _ = info\n'
                                 '            return Ctor("Lambda", params,\n'
                                 '                        Ctor("CellVars", *(q(n) for n in cells)),\n'
                                 '                        Ctor("FreeVars", *(q(n) for n in frees)),\n'
                                 '                        emit_expr(node.body))\n'
                                 '        return Ctor("Lambda", params, emit_expr(node.body))\n'
                                 '\n'
                                 '    if isinstance(node, ast.BinOp):\n'
                                 '        op = _BINOP.get(type(node.op))\n'
                                 '        if op is None:\n'
                                 '            raise Unsupported(f"BinOp {type(node.op).__name__}")\n'
                                 '        return Ctor("BinOp", q(op), emit_expr(node.left), emit_expr(node.right))\n'
                                 '\n'
                                 '    if isinstance(node, ast.UnaryOp):\n'
                                 '        op = _UNARY.get(type(node.op))\n'
                                 '        if op is None:\n'
                                 '            raise Unsupported(f"UnaryOp {type(node.op).__name__}")\n'
                                 '        return Ctor("UnaryOp", q(op), emit_expr(node.operand))\n'
                                 '\n'
                                 '    if isinstance(node, ast.BoolOp):\n'
                                 '        op = _BOOLOP[type(node.op)]\n'
                                 '        return Ctor("BoolOp", q(op), *(emit_expr(v) for v in node.values))\n'
                                 '\n'
                                 '    if isinstance(node, ast.Compare):\n'
                                 '        # Faithful, non-desugared: left operand + a chain of (op, comparator).\n'
                                 '        # Single comparison => one CmpOp; `a < b < c` => two CmpOps.\n'
                                 '        chain = [\n'
                                 '            Ctor("CmpOp", q(_op_or_raise(_CMPOP, op, "Compare")), emit_expr(c))\n'
                                 '            for op, c in zip(node.ops, node.comparators)\n'
                                 '        ]\n'
                                 '        return Ctor("Compare", emit_expr(node.left), *chain)\n'
                                 '\n'
                                 '    if isinstance(node, ast.List):\n'
                                 '        return Ctor("ListExpr", *(emit_expr(e) for e in node.elts))\n'
                                 '\n'
                                 '    if isinstance(node, ast.Tuple):\n'
                                 '        return Ctor("TupleExpr", *(emit_expr(e) for e in node.elts))\n'
                                 '\n'
                                 '    if isinstance(node, ast.Set):\n'
                                 '        return Ctor("SetExpr", *(emit_expr(e) for e in node.elts))\n'
                                 '\n'
                                 '    if isinstance(node, ast.Dict):\n'
                                 '        entries = []\n'
                                 '        for k, v in zip(node.keys, node.values):\n'
