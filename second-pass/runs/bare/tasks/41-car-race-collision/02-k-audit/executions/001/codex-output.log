                                 '    if getattr(g, "is_async", 0):\n'
                                 '        raise Unsupported("async comprehension")\n'
                                 '    ifs = [emit_expr(c) for c in g.ifs] or [Ctor("Bool", "true")]\n'
                                 '    return Ctor("CompFor", emit_expr(g.target), emit_expr(g.iter), *ifs)\n'
                                 '\n'
                                 '\n'
                                 'def _gens(generators):\n'
                                 '    """The generator list -> a juxtaposed CompFors (a Seq of CompFor)."""\n'
                                 '    return Seq([_compfor(g) for g in generators])\n'
                                 '\n'
                                 '\n'
                                 'def emit_index(node: ast.expr):\n'
                                 '    """Subscript index position: an `ast.Slice` -> `Slice(...)`, else the expr."""\n'
                                 '    # Python <3.9 wrapped the index in ast.Index; unwrap if present.\n'
                                 '    inner = getattr(ast, "Index", None)\n'
                                 '    if inner is not None and isinstance(node, inner):\n'
                                 '        node = node.value\n'
                                 '    if isinstance(node, ast.Slice):\n'
                                 '        def bound(b):\n'
                                 '            # omitted bound (absent field) OR an explicit None constant -> NoBound.\n'
                                 '            # Python treats `a[None:5]` exactly like `a[:5]`; only a *value* None\n'
                                 '            # (Constant(None) outside a slice) becomes NoneVal. Keeping the two\n'
                                 '            # distinct lets NoneVal be a real value without perturbing slices.\n'
                                 '            if b is None or (isinstance(b, ast.Constant) and b.value is None):\n'
                                 '                return "NoBound"\n'
                                 '            return emit_expr(b)\n'
                                 '        return Ctor("Slice", bound(node.lower), bound(node.upper), '
                                 'bound(node.step))\n'
                                 '    return emit_expr(node)\n'
                                 '\n'}],
