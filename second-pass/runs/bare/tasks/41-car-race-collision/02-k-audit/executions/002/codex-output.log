diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ef9182f07650a1a2433c0d3b10c166b2c6d204e2
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module SEMANTIC-SYNTAX
+
+krun solution.mpy --definition verification-kompiled -cN=0
+krun solution.mpy --definition verification-kompiled -cN=3
+krun solution.mpy --definition verification-kompiled -cN=10
