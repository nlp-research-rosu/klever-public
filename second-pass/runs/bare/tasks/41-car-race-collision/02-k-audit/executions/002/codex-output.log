+status=$?
+echo "[exit $status]"
+
+run cmp \
+  /tmp/audit-work/candidate/solution.mpy \
+  /tmp/audit-work/regenerated-solution.mpy
+run sha256sum \
+  /tmp/audit-work/candidate/solution.mpy \
+  /tmp/audit-work/regenerated-solution.mpy
+run python3 /audit-output/evidence/differential_test.py

