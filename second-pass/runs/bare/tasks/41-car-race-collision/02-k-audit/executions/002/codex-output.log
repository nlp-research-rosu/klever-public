from pathlib import Path
import hashlib,stat

def obj(kind,data): return hashlib.sha256(kind.encode()+b' '+str(len(data)).encode()+b'\\0'+data).digest()
def tree(p):
 out=b''
 for c in sorted(p.iterdir(),key=lambda q:q.name.encode()):
