+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def check(label: str, observed: object, expected: object) -> dict[str, object]:
+    return {
+        "label": label,
+        "observed": observed,
+        "expected": expected,
+        "match": observed == expected,
+    }
+
+
