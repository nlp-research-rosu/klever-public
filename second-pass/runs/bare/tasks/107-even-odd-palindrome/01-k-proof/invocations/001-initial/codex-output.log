+  // each palindrome by parity.  These equations cover exactly 1..1000.
+  syntax Int ::= "reverseDigits" "(" Int ")" [function]
+               | "evenPalindrome" "(" Int ")" [function]
+               | "oddPalindrome" "(" Int ")" [function]
+
+  rule reverseDigits(N) => N
+    requires 0 <=Int N andBool N <Int 10
+  rule reverseDigits(N) => (N %Int 10) *Int 10 +Int (N /Int 10)
+    requires 10 <=Int N andBool N <Int 100
+  rule reverseDigits(N) => (N %Int 10) *Int 100
+                           +Int ((N /Int 10) %Int 10) *Int 10
+                           +Int (N /Int 100)
+    requires 100 <=Int N andBool N <Int 1000
+  rule reverseDigits(1000) => 1
+
+  rule evenPalindrome(N) => 1
+    requires reverseDigits(N) ==Int N andBool (N %Int 2 ==Int 0)
+  rule evenPalindrome(N) => 0
+    requires notBool (reverseDigits(N) ==Int N andBool (N %Int 2 ==Int 0))
+  rule oddPalindrome(N) => 1
+    requires reverseDigits(N) ==Int N andBool (N %Int 2 ==Int 1)
+  rule oddPalindrome(N) => 0
+    requires notBool (reverseDigits(N) ==Int N andBool (N %Int 2 ==Int 1))
+
+  syntax KItem ::= "verifyRange" "(" Pgm "," Int "," Int "," Int "," Int ")" [symbol]
+                 | "expect" "(" Int "," Int ")" [symbol]
+                 | "verified" [symbol]
+
+  rule <k> verifyRange(P, N, MAX, EVENS, ODDS)
+        => run(P, N)
+        ~> expect(EVENS +Int evenPalindrome(N), ODDS +Int oddPalindrome(N))
+        ~> verifyRange(P, N +Int 1, MAX,
+                       EVENS +Int evenPalindrome(N),
+                       ODDS +Int oddPalindrome(N)) ... </k>
+    requires N <=Int MAX
+
+  rule verifyRange(_, N, MAX, _, _) => verified
+    requires N >Int MAX
+
+  rule <k> VTuple(VInt(E), VInt(O)) ~> expect(E, O) => . ... </k>
+       <env> _ => .Map </env>
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..9c2d613150d8e77a21d72999500c88d19341e542
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,115 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")" [symbol]
+
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Expr ::= "Int" "(" Int ")" [symbol]
+                | "Name" "(" String ")" [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
+                | "Compare" "(" Expr "," CmpOp ")" [symbol]
+                | "TupleExpr" "(" Expr "," Expr ")" [symbol]
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")" [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")" [symbol]
+                | "Return" "(" Expr ")" [symbol]
+  syntax Stmts ::= List{Stmt, ""}
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Value ::= "VInt" "(" Int ")" [symbol]
+                 | "VBool" "(" Bool ")" [symbol]
+                 | "VTuple" "(" Value "," Value ")" [symbol]
+
+  syntax ReturnState ::= "noReturn" [symbol]
+                       | "returned" "(" Value ")" [symbol]
+
+  syntax KItem ::= "run" "(" Pgm "," Int ")" [symbol]
+                 | "exec" "(" Stmts ")" [symbol]
+                 | "finish" [symbol]
+
+  configuration
+    <mpy>
+      <k> run($PGM:Pgm, $N:Int) </k>
+      <env> .Map </env>
+      <return> noReturn </return>
+    </mpy>
+
+  syntax Value ::= "eval" "(" Expr "," Map ")" [function]
+                 | "lookupValue" "(" Map "," String ")" [function]
+  syntax Int ::= "getInt" "(" Value ")" [function]
+  syntax Bool ::= "getBool" "(" Value ")" [function]
+
+  rule getInt(VInt(I)) => I
+  rule getBool(VBool(B)) => B
+
+  rule eval(Int(I), _) => VInt(I)
+  rule lookupValue((X |-> V:Value) REST, X) => V
+  rule eval(Name(X), ENV) => lookupValue(ENV, X)
+
+  rule eval(BinOp("+", A, B), ENV)
+    => VInt(getInt(eval(A, ENV)) +Int getInt(eval(B, ENV)))
+  rule eval(BinOp("-", A, B), ENV)
+    => VInt(getInt(eval(A, ENV)) -Int getInt(eval(B, ENV)))
+  rule eval(BinOp("*", A, B), ENV)
+    => VInt(getInt(eval(A, ENV)) *Int getInt(eval(B, ENV)))
+  rule eval(BinOp("//", A, B), ENV)
+    => VInt(getInt(eval(A, ENV)) /Int getInt(eval(B, ENV)))
+  rule eval(BinOp("%", A, B), ENV)
+    => VInt(getInt(eval(A, ENV)) %Int getInt(eval(B, ENV)))
+
+  rule eval(Compare(A, CmpOp("<", B)), ENV)
+    => VBool(getInt(eval(A, ENV)) <Int getInt(eval(B, ENV)))
+  rule eval(Compare(A, CmpOp("<=", B)), ENV)
+    => VBool(getInt(eval(A, ENV)) <=Int getInt(eval(B, ENV)))
+  rule eval(Compare(A, CmpOp(">", B)), ENV)
+    => VBool(getInt(eval(A, ENV)) >Int getInt(eval(B, ENV)))
+  rule eval(Compare(A, CmpOp(">=", B)), ENV)
+    => VBool(getInt(eval(A, ENV)) >=Int getInt(eval(B, ENV)))
+  rule eval(Compare(A, CmpOp("==", B)), ENV)
+    => VBool(getInt(eval(A, ENV)) ==Int getInt(eval(B, ENV)))
+
+  rule eval(TupleExpr(A, B), ENV) => VTuple(eval(A, ENV), eval(B, ENV))
+
+  rule <k> run(Module(FuncDef("even_odd_palindrome", Params("n"), BODY)), N)
+        => exec(BODY) ~> finish ... </k>
+       <env> _ => "n" |-> VInt(N) </env>
+       <return> _ => noReturn </return>
+
+  rule exec(.Stmts) => .
+  rule <k> exec(_:Stmts) => . ... </k>
+       <return> returned(_) </return>
+
+  rule <k> exec(Assign(Name(X), E) REST) => exec(REST) ... </k>
+       <env> ENV => ENV [ X <- eval(E, ENV) ] </env>
+       <return> noReturn </return>
+
+  rule <k> exec(If(COND, THEN, ELSE) REST)
+        => exec(THEN) ~> exec(REST) ... </k>
+       <env> ENV </env>
+       <return> noReturn </return>
+    requires getBool(eval(COND, ENV))
+  rule <k> exec(If(COND, THEN, ELSE) REST)
+        => exec(ELSE) ~> exec(REST) ... </k>
+       <env> ENV </env>
+       <return> noReturn </return>
+    requires notBool getBool(eval(COND, ENV))
+
+  rule <k> exec(Return(E) _REST) => . ... </k>
+       <env> ENV </env>
+       <return> noReturn => returned(eval(E, ENV)) </return>
+
+  rule <k> finish => V ... </k>
+       <return> returned(V) => noReturn </return>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..0b281401adf58b19b1743b9b1be4f7344b262e31
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,38 @@
+def even_odd_palindrome(n):
+    if n < 10:
+        even = n // 2
+        odd = n - even
+        return (even, odd)
+
+    even = 4
+    odd = 5
+
+    pairs = n // 11
+    if pairs > 9:
+        pairs = 9
+    even = even + pairs // 2
+    odd = odd + pairs - pairs // 2
+
+    if n >= 101:
+        lead = n // 100
+        if lead > 9:
+            lead = 9
+            extra = 10
+        else:
+            middle = (n // 10) % 10
+            candidate = lead * 101 + middle * 10
+            extra = middle
+            if candidate <= n:
+                extra = extra + 1
+
+        previous = lead - 1
+        even_leads = previous // 2
+        odd_leads = previous - even_leads
+        even = even + even_leads * 10
+        odd = odd + odd_leads * 10
+        if lead % 2 == 0:
+            even = even + extra
+        else:
+            odd = odd + extra
+
+    return (even, odd)
