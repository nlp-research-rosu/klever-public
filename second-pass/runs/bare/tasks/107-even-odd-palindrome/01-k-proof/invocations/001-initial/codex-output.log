+        else:
+            middle = (n // 10) % 10
+            candidate = lead * 101 + middle * 10
+            extra = middle
+            if candidate <= n:
+                extra = extra + 1
+
+        previous = lead - 1
+        even_leads = previous // 2
+        odd_leads = previous - even_leads
+        even = even + even_leads * 10
+        odd = odd + odd_leads * 10
+        if lead % 2 == 0:
+            even = even + extra
+        else:
+            odd = odd + extra
+
+    return (even, odd)
