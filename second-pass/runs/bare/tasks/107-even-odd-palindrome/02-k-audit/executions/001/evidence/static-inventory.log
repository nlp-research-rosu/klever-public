     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  syntax Pgm ::= "solutionProgram" [function]
     7	
     8	  rule solutionProgram =>
     9	    Module(
    10	      FuncDef("even_odd_palindrome", Params("n"),
    11	        If(Compare(Name("n"), CmpOp("<", Int(10))),
    12	          Assign(Name("even"), BinOp("//", Name("n"), Int(2)))
    13	          Assign(Name("odd"), BinOp("-", Name("n"), Name("even")))
    14	          Return(TupleExpr(Name("even"), Name("odd"))),
    15	          .Stmts)
    16	        Assign(Name("even"), Int(4))
    17	        Assign(Name("odd"), Int(5))
    18	        Assign(Name("pairs"), BinOp("//", Name("n"), Int(11)))
    19	        If(Compare(Name("pairs"), CmpOp(">", Int(9))),
    20	          Assign(Name("pairs"), Int(9)),
    21	          .Stmts)
    22	        Assign(
    23	          Name("even"),
    24	          BinOp("+", Name("even"), BinOp("//", Name("pairs"), Int(2))))
    25	        Assign(
    26	          Name("odd"),
    27	          BinOp(
    28	            "-",
    29	            BinOp("+", Name("odd"), Name("pairs")),
    30	            BinOp("//", Name("pairs"), Int(2))))
    31	        If(Compare(Name("n"), CmpOp(">=", Int(101))),
    32	          Assign(Name("lead"), BinOp("//", Name("n"), Int(100)))
    33	          If(Compare(Name("lead"), CmpOp(">", Int(9))),
    34	            Assign(Name("lead"), Int(9))
    35	            Assign(Name("extra"), Int(10)),
    36	            Assign(
    37	              Name("middle"),
    38	              BinOp("%", BinOp("//", Name("n"), Int(10)), Int(10)))
    39	            Assign(
    40	              Name("candidate"),
    41	              BinOp(
    42	                "+",
    43	                BinOp("*", Name("lead"), Int(101)),
    44	                BinOp("*", Name("middle"), Int(10))))
    45	            Assign(Name("extra"), Name("middle"))
    46	            If(Compare(Name("candidate"), CmpOp("<=", Name("n"))),
    47	              Assign(Name("extra"), BinOp("+", Name("extra"), Int(1))),
    48	              .Stmts))
    49	          Assign(Name("previous"), BinOp("-", Name("lead"), Int(1)))
    50	          Assign(Name("even_leads"), BinOp("//", Name("previous"), Int(2)))
    51	          Assign(
    52	            Name("odd_leads"),
    53	            BinOp("-", Name("previous"), Name("even_leads")))
    54	          Assign(
    55	            Name("even"),
    56	            BinOp(
    57	              "+",
    58	              Name("even"),
    59	              BinOp("*", Name("even_leads"), Int(10))))
    60	          Assign(
    61	            Name("odd"),
    62	            BinOp("+", Name("odd"), BinOp("*", Name("odd_leads"), Int(10))))
    63	          If(Compare(BinOp("%", Name("lead"), Int(2)), CmpOp("==", Int(0))),
    64	            Assign(Name("even"), BinOp("+", Name("even"), Name("extra"))),
    65	            Assign(Name("odd"), BinOp("+", Name("odd"), Name("extra")))),
    66	          .Stmts)
    67	        Return(TupleExpr(Name("even"), Name("odd")))))
    68	
    69	  // Independent reference model: reverse the decimal digits, then classify
    70	  // each palindrome by parity.  These equations cover exactly 1..1000.
    71	  syntax Int ::= "reverseDigits" "(" Int ")" [function]
    72	               | "evenPalindrome" "(" Int ")" [function]
    73	               | "oddPalindrome" "(" Int ")" [function]
    74	
    75	  rule reverseDigits(N) => N
    76	    requires 0 <=Int N andBool N <Int 10
    77	  rule reverseDigits(N) => (N %Int 10) *Int 10 +Int (N /Int 10)
    78	    requires 10 <=Int N andBool N <Int 100
    79	  rule reverseDigits(N) => (N %Int 10) *Int 100
    80	                           +Int ((N /Int 10) %Int 10) *Int 10
    81	                           +Int (N /Int 100)
    82	    requires 100 <=Int N andBool N <Int 1000
    83	  rule reverseDigits(1000) => 1
    84	
    85	  rule evenPalindrome(N) => 1
    86	    requires reverseDigits(N) ==Int N andBool (N %Int 2 ==Int 0)
    87	  rule evenPalindrome(N) => 0
    88	    requires notBool (reverseDigits(N) ==Int N andBool (N %Int 2 ==Int 0))
    89	  rule oddPalindrome(N) => 1
    90	    requires reverseDigits(N) ==Int N andBool (N %Int 2 ==Int 1)
    91	  rule oddPalindrome(N) => 0
    92	    requires notBool (reverseDigits(N) ==Int N andBool (N %Int 2 ==Int 1))
    93	
    94	  syntax KItem ::= "verifyRange" "(" Pgm "," Int "," Int "," Int "," Int ")" [symbol]
    95	                 | "expect" "(" Int "," Int ")" [symbol]
    96	                 | "verified" [symbol]
    97	
    98	  rule <k> verifyRange(P, N, MAX, EVENS, ODDS)
    99	        => run(P, N)
   100	        ~> expect(EVENS +Int evenPalindrome(N), ODDS +Int oddPalindrome(N))
   101	        ~> verifyRange(P, N +Int 1, MAX,
   102	                       EVENS +Int evenPalindrome(N),
   103	                       ODDS +Int oddPalindrome(N)) ... </k>
   104	    requires N <=Int MAX
   105	
   106	  rule verifyRange(_, N, MAX, _, _) => verified
   107	    requires N >Int MAX
   108	
   109	  rule <k> VTuple(VInt(E), VInt(O)) ~> expect(E, O) => . ... </k>
   110	       <env> _ => .Map </env>
   111	endmodule
