+
+branch_coverage = {
+    "n_lt_10": set(),
+    "pairs_gt_9": set(),
+    "n_ge_101": set(),
+    "lead_gt_9": set(),
+    "candidate_le_n": set(),
+    "lead_even": set(),
+}
