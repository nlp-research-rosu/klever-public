+requires "verification.k"
+
+module PROGRAM-IDENTITY
+  imports VERIFICATION
+
+  // The right-hand term below is copied from the trusted-translator output
+  // regenerated from solution.py and byte-compared with submitted-solution.mpy.
+  claim solutionProgram =>
+    Module(
+      FuncDef("even_odd_palindrome", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(10))),
+          Assign(Name("even"), BinOp("//", Name("n"), Int(2)))
+          Assign(Name("odd"), BinOp("-", Name("n"), Name("even")))
+          Return(TupleExpr(Name("even"), Name("odd"))),
+          .Stmts)
+        Assign(Name("even"), Int(4))
+        Assign(Name("odd"), Int(5))
+        Assign(Name("pairs"), BinOp("//", Name("n"), Int(11)))
+        If(Compare(Name("pairs"), CmpOp(">", Int(9))),
+          Assign(Name("pairs"), Int(9)),
+          .Stmts)
+        Assign(
+          Name("even"),
+          BinOp("+", Name("even"), BinOp("//", Name("pairs"), Int(2))))
+        Assign(
+          Name("odd"),
+          BinOp(
+            "-",
+            BinOp("+", Name("odd"), Name("pairs")),
+            BinOp("//", Name("pairs"), Int(2))))
+        If(Compare(Name("n"), CmpOp(">=", Int(101))),
+          Assign(Name("lead"), BinOp("//", Name("n"), Int(100)))
+          If(Compare(Name("lead"), CmpOp(">", Int(9))),
+            Assign(Name("lead"), Int(9))
+            Assign(Name("extra"), Int(10)),
+            Assign(
+              Name("middle"),
+              BinOp("%", BinOp("//", Name("n"), Int(10)), Int(10)))
+            Assign(
+              Name("candidate"),
+              BinOp(
+                "+",
+                BinOp("*", Name("lead"), Int(101)),
+                BinOp("*", Name("middle"), Int(10))))
+            Assign(Name("extra"), Name("middle"))
+            If(Compare(Name("candidate"), CmpOp("<=", Name("n"))),
+              Assign(Name("extra"), BinOp("+", Name("extra"), Int(1))),
+              .Stmts))
+          Assign(Name("previous"), BinOp("-", Name("lead"), Int(1)))
+          Assign(Name("even_leads"), BinOp("//", Name("previous"), Int(2)))
+          Assign(
+            Name("odd_leads"),
+            BinOp("-", Name("previous"), Name("even_leads")))
+          Assign(
+            Name("even"),
+            BinOp(
+              "+",
+              Name("even"),
+              BinOp("*", Name("even_leads"), Int(10))))
+          Assign(
+            Name("odd"),
+            BinOp("+", Name("odd"), BinOp("*", Name("odd_leads"), Int(10))))
+          If(Compare(BinOp("%", Name("lead"), Int(2)), CmpOp("==", Int(0))),
+            Assign(Name("even"), BinOp("+", Name("even"), Name("extra"))),
+            Assign(Name("odd"), BinOp("+", Name("odd"), Name("extra")))),
+          .Stmts)
+        Return(TupleExpr(Name("even"), Name("odd")))))
+endmodule
diff --git a/evidence/program_identity_check.sh b/evidence/program_identity_check.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8a3a095dc35b7d842ab1a1b20b5083e6abbeb109
--- /dev/null
+++ b/evidence/program_identity_check.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -e
+set -u
+set -o pipefail
+PS4='+ ${BASH_SOURCE}:${LINENO}: '
+set -x
+
+# Lines 9--67 are the complete Pgm right-hand side of solutionProgram.
+sed -n '9,67p' verification.k > extracted-solution-program.mpy
+# `.Stmts` is K's internal empty-list spelling inside a rule; the concrete
+# MPY surface syntax represents that same list with no token.
+sed -i 's/\.Stmts//g' extracted-solution-program.mpy
+
+kast submitted-solution.mpy \
+  --definition audit-verification-kompiled \
+  --sort Pgm --output kore > submitted-solution.kore
+kast extracted-solution-program.mpy \
+  --definition audit-verification-kompiled \
+  --sort Pgm --output kore > verification-solution.kore
+
+cmp submitted-solution.kore verification-solution.kore
+sha256sum \
+  submitted-solution.mpy extracted-solution-program.mpy \
+  submitted-solution.kore verification-solution.kore
+printf 'structural_kore_identity=yes\n'
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5b38de362d27d00a6da6e97a50a61dadcf772108
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_path"
+
+"$@" >>"$log_path" 2>&1
+status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$log_path"
+
+exit "$status"
