assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
want=[r['source_rule_id'] for r in inv['rules']]
got=[r['source_rule_id'] for r in out['rules']]
assert got == want
assert len(got) == len(set(got))
for r in out['rules']:
    assert set(r) == {'source_rule_id','classification','rationale'}
    assert r['classification'] in allowed
    assert isinstance(r['rationale'],str) and r['rationale'].strip()
for ir,orule in zip(inv['rules'],out['rules']):
    if 'simplification' in ir.get('attributes',[]):
        assert orule['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print('validation: PASS')
print('inventory_sha256:', out['inventory_sha256'])
print('rule count:', len(got))
print('classifications:', dict(Counter(r['classification'] for r in out['rules'])))
