/bin/bash -lc "set -o pipefail
{
  echo '"'$ python3 /audit-output/evidence/concrete_semantics_test.py'"'
  python3 /audit-output/evidence/concrete_semantics_test.py
  status="'$?
  echo "EXIT_STATUS: $status"
} 2>&1 | tee /audit-output/evidence/concrete-semantics-test.log
exit 0' in /audit-output
