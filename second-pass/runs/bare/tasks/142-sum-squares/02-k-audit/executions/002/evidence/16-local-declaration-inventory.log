COMMAND: bash -lc for\ f\ in\ semantic.k\ verification.k\ spec.k\;\ do\ printf\ \"FILE\ %s\\n\"\ \"\$f\"\;\ rg\ -n\ \"\^\[\[:space:\]\]\*\(configuration\|syntax\|rule\|claim\|imports\|requires\|module\|endmodule\)\|\\\[\(function\|total\|functional\|simplification\|concrete\|priority\|owise\|macro\)\"\ \"\$f\"\;\ done\;\ printf\ \"COUNTS\\n\"\;\ for\ f\ in\ semantic.k\ verification.k\ spec.k\;\ do\ printf\ \"%s\ syntax=%s\ rule=%s\ claim=%s\ simplification=%s\ function=%s\ total=%s\ functional=%s\ priority=%s\\n\"\ \"\$f\"\ \"\$\(rg\ -c\ \"\^\[\[:space:\]\]\*syntax\"\ \"\$f\"\)\"\ \"\$\(rg\ -c\ \"\^\[\[:space:\]\]\*rule\"\ \"\$f\"\)\"\ \"\$\(rg\ -c\ \"\^\[\[:space:\]\]\*claim\"\ \"\$f\"\)\"\ \"\$\(rg\ -c\ \"\\\[simplification\"\ \"\$f\"\ \|\|\ true\)\"\ \"\$\(rg\ -c\ \"\\\[function\"\ \"\$f\"\ \|\|\ true\)\"\ \"\$\(rg\ -c\ \"\\btotal\\b\"\ \"\$f\"\ \|\|\ true\)\"\ \"\$\(rg\ -c\ \"\\bfunctional\\b\"\ \"\$f\"\ \|\|\ true\)\"\ \"\$\(rg\ -c\ \"priority\|\\\[owise\|\\\[concrete\"\ \"\$f\"\ \|\|\ true\)\"\;\ done
FILE semantic.k
1:module MPY-SYNTAX
2:  imports INT-SYNTAX
3:  imports BOOL-SYNTAX
4:  imports STRING-SYNTAX
6:  syntax Pgm ::= "Module" "(" Stmts ")"
8:  syntax Stmts ::= List{Stmt, ""}
9:  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
14:  syntax Params ::= "Params" "(" Strings ")"
15:  syntax Strings ::= List{String, ","}
17:  syntax Exprs ::= List{Expr, ","}
18:  syntax Expr ::= "Int" "(" Int ")"
26:  syntax CmpOps ::= List{CmpOp, ","}
27:  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
28:  syntax Index ::= Expr
30:  syntax Bound ::= Expr | "NoBound"
37:  syntax Ints ::= ".Ints"
38:  syntax Ints ::= Int
39:  syntax Ints ::= Ints "," Int
40:  syntax Value ::= "VInt" "(" Int ")"
44:endmodule
46:module MPY-SEMANTICS
47:  imports MPY-SYNTAX
48:  imports INT
49:  imports BOOL
50:  imports STRING
51:  imports MAP
52:  imports K-EQUAL
54:  configuration
59:  syntax Function ::= "function1" "(" String "," Stmts ")"
61:  syntax Outcome ::= "normal" | "returned" "(" Value ")"
63:  syntax KItem ::= "load" "(" Stmts ")"
84:  rule <k> Module(SS) => load(SS) ... </k>
85:  rule <k> load(.Stmts) => .K ... </k>
86:  rule <k> load(FuncDef(F, Params(P), BODY) REST)
90:  rule <k> run(ARG) => invoke1("sum_squares", ARG) ... </k>
94:  rule <k> invoke1(F, V) => exec(BODY) ~> finishCall ~> restoreEnv(OLD) ... </k>
97:  rule <k> normal ~> finishCall => NoneVal ... </k>
98:  rule <k> returned(V) ~> finishCall => V ... </k>
99:  rule <k> V:Value ~> restoreEnv(OLD) => V ... </k>
104:  rule <k> exec(.Stmts) => normal ... </k>
105:  rule <k> exec(Return(E) _REST) => eval(E) ~> makeReturned ... </k>
106:  rule <k> exec(Assign(Name(X), E) REST)
108:  rule <k> V:Value ~> assignTo(X, REST) => exec(REST) ... </k>
110:  rule <k> exec(If(COND, THEN, ELSE) REST)
112:  rule <k> VBool(true) ~> choose(THEN:Stmts, _ELSE:Stmts, REST:Stmts)
114:  rule <k> VBool(false) ~> choose(_THEN:Stmts, ELSE:Stmts, REST:Stmts)
116:  rule <k> normal ~> afterBranch(REST) => exec(REST) ... </k>
117:  rule <k> returned(V) ~> afterBranch(_) => returned(V) ... </k>
119:  syntax KItem ::= "makeReturned"
120:  rule <k> V:Value ~> makeReturned => returned(V) ... </k>
123:  rule <k> eval(Int(N)) => VInt(N) ... </k>
124:  rule <k> eval(Name(X)) => V ... </k>
126:  rule <k> eval(ListExpr(.Exprs)) => ListVal(.Ints) ... </k>
128:  rule <k> eval(BinOp(OP, LEFT, RIGHT))
130:  rule <k> V:Value ~> binLeft(OP, RIGHT)
132:  rule <k> V2:Value ~> binRight(OP, V1)
135:  rule <k> eval(UnaryOp("-", E)) => eval(E) ~> negateResult ... </k>
136:  syntax KItem ::= "negateResult"
137:  rule <k> VInt(N) ~> negateResult => VInt(0 -Int N) ... </k>
139:  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
141:  rule <k> V:Value ~> compareLeft(OP, RIGHT)
143:  rule <k> V2:Value ~> compareRight(OP, V1)
146:  rule <k> eval(Call(Name("len"), E)) => eval(E) ~> lengthResult ... </k>
147:  rule <k> ListVal(IS) ~> lengthResult => VInt(lengthInts(IS)) ... </k>
148:  rule <k> eval(Call(Name(F), E)) => eval(E) ~> callOne(F) ... </k>
149:       requires F =/=String "len"
150:  rule <k> V:Value ~> callOne(F) => invoke1(F, V) ... </k>
154:  rule <k> eval(Subscript(E, UnaryOp("-", Int(1))))
156:  rule <k> ListVal(IS) ~> lastResult => VInt(lastInt(IS)) ... </k>
157:  rule <k> eval(Subscript(E, Slice(NoBound, UnaryOp("-", Int(1)), NoBound)))
159:  rule <k> ListVal(IS) ~> initResult => ListVal(initInts(IS)) ... </k>
161:  syntax Value ::= "binResult" "(" String "," Value "," Value ")" [function]
162:  rule binResult("+", VInt(A), VInt(B)) => VInt(A +Int B)
163:  rule binResult("-", VInt(A), VInt(B)) => VInt(A -Int B)
164:  rule binResult("*", VInt(A), VInt(B)) => VInt(A *Int B)
165:  rule binResult("%", VInt(A), VInt(B)) => VInt(A %Int B)
167:  syntax Value ::= "compareResult" "(" String "," Value "," Value ")" [function]
168:  rule compareResult("==", VInt(A), VInt(B)) => VBool(A ==Int B)
169:  rule compareResult("==", ListVal(IS), ListVal(.Ints))
172:  syntax Int ::= "lengthInts" "(" Ints ")" [function]
173:  rule lengthInts(.Ints) => 0
174:  rule lengthInts(_:Int) => 1
175:  rule lengthInts(PREFIX:Ints, _:Int) => lengthInts(PREFIX) +Int 1
177:  syntax Int ::= "lastInt" "(" Ints ")" [function]
178:  rule lastInt(N:Int) => N
179:  rule lastInt(_PREFIX:Ints, N:Int) => N
181:  syntax Ints ::= "initInts" "(" Ints ")" [function]
182:  rule initInts(_:Int) => .Ints
183:  rule initInts(PREFIX:Ints, _N:Int) => PREFIX
184:endmodule
FILE verification.k
