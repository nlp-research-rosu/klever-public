+    [(-index if index % 2 else index + 1) for index in range(length)]
+    for length in range(5, 14)
+])
+cases.extend([
+    [0, 0, 0, 0, 0, 0, 0, 0, -11],
+    [10**20, -(10**20), 7, -9, 4],
+])
+
+pattern = re.compile(r"VInt\\s*\\(\\s*(-?\\d+)\\s*\\)\\s*~>\\s*\\.K")
+mismatches = []
+for ordinal, case in enumerate(cases):
