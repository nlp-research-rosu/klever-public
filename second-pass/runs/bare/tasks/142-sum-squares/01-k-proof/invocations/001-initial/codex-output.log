diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..08917a0c3f71926fef09809d7992d937c940dafc
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def sum_squares(lst):
+    if lst == []:
+        return 0
+    else:
+        index = len(lst) - 1
+        value = lst[-1]
+        if index % 3 == 0:
+            contribution = value * value
+        else:
+            if index % 4 == 0:
+                contribution = value * value * value
+            else:
+                contribution = value
+        return sum_squares(lst[:-1]) + contribution
