+       <env> OLD => P |-> V </env>
+  rule <k> normal ~> finishCall => NoneVal ... </k>
+  rule <k> returned(V) ~> finishCall => V ... </k>
+  rule <k> V:Value ~> restoreEnv(OLD) => V ... </k>
+       <env> _ => OLD </env>
