+
+def print_json(label: str, value: object) -> None:
+    print(label)
+    print(json.dumps(value, indent=2, sort_keys=True))
+
+
+audit_input = json.loads(Path("/audit-input.json").read_text())
+resolution = audit_input["resolution"]
