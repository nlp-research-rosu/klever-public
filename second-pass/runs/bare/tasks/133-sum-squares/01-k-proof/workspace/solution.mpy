Module(
  ImportFrom("math", "ceil")
  FuncDef("sum_squares", Params("lst"),
    Assign(Name("total"), Int(0))
    For(Name("number"), Name("lst"),
      Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
      AugAssign(
        Name("total"),
        "+",
        BinOp("*", Name("rounded"), Name("rounded"))))
    Return(Name("total"))))
