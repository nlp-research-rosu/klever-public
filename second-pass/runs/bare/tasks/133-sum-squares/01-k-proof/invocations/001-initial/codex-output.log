+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(intVal(1), cons(intVal(2), cons(intVal(3), nil)))))
+      =>* intVal(14)
+    </k>
+    <functions> .Map => _:Map </functions>
+    <env> .Map => _:Map </env>
+
+  claim
