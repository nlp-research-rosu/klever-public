+module VERIFICATION
+  imports INT
+  imports FLOAT
+
+  syntax PList ::= "nil" [symbol(nil)]
+                 | "cons" "(" PValue "," PList ")" [symbol(cons)]
+
+  syntax PValue ::= "intVal" "(" Int ")" [symbol(intVal)]
+                  | "floatVal" "(" Float ")" [symbol(floatVal)]
+                  | "listVal" "(" PList ")" [symbol(listVal)]
+
+  syntax Int ::= ceilInt(PValue) [function, total]
+               | squareCeil(PValue) [function, total]
+               | sumSquares(PList) [function, total]
+
+  rule ceilInt(intVal(I)) => I
+  rule ceilInt(floatVal(F)) => Float2Int(ceilFloat(F))
+
+  rule squareCeil(V) => ceilInt(V) *Int ceilInt(V)
+
+  rule sumSquares(nil) => 0
+  rule sumSquares(cons(V, VS)) => squareCeil(V) +Int sumSquares(VS)
+endmodule

