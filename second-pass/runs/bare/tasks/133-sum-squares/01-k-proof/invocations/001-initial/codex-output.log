+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(intVal(1), cons(intVal(2), cons(intVal(3), nil)))))
+      => intVal(14)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Map => ?ENV:Map </env>
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(floatVal(1.4), cons(floatVal(4.2), cons(intVal(0), nil)))))
+      => intVal(29)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Map => ?ENV:Map </env>
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(floatVal(-2.4), cons(intVal(1), cons(intVal(1), nil)))))
+      => intVal(6)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Map => ?ENV:Map </env>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e28b8d6e238af70057fcad724dfc5c65901d9083
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+module VERIFICATION
+  imports INT
+  imports FLOAT
+
+  syntax PList ::= "nil" [symbol(nil)]
+                 | "cons" "(" PValue "," PList ")" [symbol(cons)]
+
+  syntax PValue ::= "intVal" "(" Int ")" [symbol(intVal)]
+                  | "floatVal" "(" Float ")" [symbol(floatVal)]
+                  | "listVal" "(" PList ")" [symbol(listVal)]
+
+  syntax Int ::= ceilInt(PValue) [function, total]
+               | squareCeil(PValue) [function, total]
+               | sumSquares(PList) [function, total]
+
+  rule ceilInt(intVal(I)) => I
+  rule ceilInt(floatVal(F)) => Float2Int(ceilFloat(F))
+
+  rule squareCeil(V) => ceilInt(V) *Int ceilInt(V)
+
+  rule sumSquares(nil) => 0
+  rule sumSquares(cons(V, VS)) => squareCeil(V) +Int sumSquares(VS)
+endmodule

