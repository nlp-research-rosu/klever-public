+
+  rule <k> exec(Return(E) SS) => evalExpr(E, RHO) ... </k>
+       <env> RHO </env>
+
+  rule <k> loop(_, listVal(nil), _) => . ... </k>
+  rule <k> loop(X, listVal(cons(V, VS)), BODY)
+        => bind(X, V) ~> exec(BODY) ~> loop(X, listVal(VS), BODY) ... </k>
+
