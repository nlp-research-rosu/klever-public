find /work/__pycache__ -depth -delete
unlink /work/kore-exec.tar.gz
krun solution.mpy --definition semantic-kompiled -cARGS='listVal(cons(intVal(1), cons(intVal(2), cons(intVal(3), nil))))' | sed -n '/<k>/,/<\\/k>/p'
krun solution.mpy --definition semantic-kompiled -cARGS='listVal(cons(ratVal(14, ten), cons(ratVal(42, ten), cons(intVal(0), nil))))' | sed -n '/<k>/,/<\\/k>/p'
krun solution.mpy --definition semantic-kompiled -cARGS='listVal(cons(ratVal(-24, ten), cons(intVal(1), cons(intVal(1), nil))))' | sed -n '/<k>/,/<\\/k>/p'" in /work
