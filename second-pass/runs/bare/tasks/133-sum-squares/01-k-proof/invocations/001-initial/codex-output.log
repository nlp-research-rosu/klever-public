+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(intVal(1), cons(intVal(2), cons(intVal(3), nil)))))
+      => intVal(14)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Map => ?ENV:Map </env>
+
+  claim [all-numeric-lists]:
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(L:PList))
+      => intVal(sumSquares(L))
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Map => ?ENV:Map </env>
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(ratVal(14, 10), cons(ratVal(42, 10), cons(intVal(0), nil)))))
+      => intVal(29)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Map => ?ENV:Map </env>
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(ratVal(-24, 10), cons(intVal(1), cons(intVal(1), nil)))))
+      => intVal(6)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Map => ?ENV:Map </env>
