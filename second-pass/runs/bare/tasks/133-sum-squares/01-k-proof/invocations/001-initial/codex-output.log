+from math import ceil
+
+
+def sum_squares(lst):
+    total = 0
+    for number in lst:
+        rounded = ceil(number)
+        total += rounded * rounded
+    return total
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d5803c1c16fb36dd09991612ed25e60773658380
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,95 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(intVal(1), cons(intVal(2), cons(intVal(3), nil)))))
+      => intVal(14)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+
+  claim [all-numeric-lists]:
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(L:PList))
+      => intVal(sumSquares(L))
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+
+  claim [loop-invariant]:
+    <k>
+      loop("number", listVal(L:PList),
+        Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+        AugAssign(Name("total"), "+",
+          BinOp("*", Name("rounded"), Name("rounded")))
+        .PyStmts)
+      ~> exec(Return(Name("total")) .PyStmts)
+      => intVal(sumSquaresFrom(A:Int, L))
+    </k>
+    <functions> FUNS:Map </functions>
+    <env>
+      (binding("total", intVal(A)) REST:Env) => ?ENV:Env
+    </env>
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(ratVal(14, ten), cons(ratVal(42, ten), cons(intVal(0), nil)))))
+      => intVal(29)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(ratVal(-24, ten), cons(intVal(1), cons(intVal(1), nil)))))
+      => intVal(6)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..388c2038c1e224246c8ff145dae1f8dedaaa0d6e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,16 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax Int ::= squareCeil(NumValue) [function]
+               | sumSquares(PList) [function, total]
+               | sumSquaresFrom(Int, PList) [function, total]
+
+  rule squareCeil(V) => ceilInt(V) *Int ceilInt(V)
+
+  rule sumSquares(VS) => sumSquaresFrom(0, VS)
+  rule sumSquaresFrom(A, nil) => A
+  rule sumSquaresFrom(A, cons(V, VS))
+    => sumSquaresFrom(A +Int squareCeil(V), VS)
+endmodule

exec
/bin/bash -lc ./prove.sh in /work
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8eea7f07444652783366fbee0c207f937cd4d09b
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile semantic.k \
+  --backend llvm \
+  --syntax-module MPY-SYNTAX \
+  --main-module MPY
+
+run_case() {
+  local expected="$1"
+  local args="$2"
+  local output
+  local k_cell
+
+  output="$(krun solution.mpy --definition semantic-kompiled -cARGS="$args")"
+  printf '%s\n' "$output"
+  k_cell="$(printf '%s\n' "$output" | sed -n '/<k>/,/<\/k>/p' | tr -d '[:space:]')"
+  test "$k_cell" = "<k>intVal($expected)~>.K</k>"
+}
+
+run_case 14 'listVal(cons(intVal(1), cons(intVal(2), cons(intVal(3), nil))))'
+run_case 98 'listVal(cons(intVal(1), cons(intVal(4), cons(intVal(9), nil))))'
+run_case 84 'listVal(cons(intVal(1), cons(intVal(3), cons(intVal(5), cons(intVal(7), nil)))))'
+run_case 29 'listVal(cons(ratVal(14, ten), cons(ratVal(42, ten), cons(intVal(0), nil))))'
+run_case 6 'listVal(cons(ratVal(-24, ten), cons(intVal(1), cons(intVal(1), nil))))'
+
+kompile verification.k \
+  --backend haskell \
+  --syntax-module MPY-SYNTAX \
+  --main-module VERIFICATION
+
+proof_output="$(kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC)"
+printf '%s\n' "$proof_output"
+test "$(printf '%s\n' "$proof_output" | tr -d '[:space:]')" = '#Top'
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6f4bd65374a6e7029ce858f1f2792ba3a1b63f3d
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,131 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax PyModule ::= "Module" "(" PyStmts ")" [symbol(Module)]
+
+  syntax PyStmts ::= List{PyStmt, ""}
+
+  syntax PyStmt ::= "ImportFrom" "(" String "," String ")" [symbol(ImportFrom)]
+                  | "FuncDef" "(" String "," "Params" "(" String ")" "," PyStmts ")" [symbol(FuncDef)]
+                  | "Assign" "(" PyExpr "," PyExpr ")" [symbol(Assign)]
+                  | "AugAssign" "(" PyExpr "," String "," PyExpr ")" [symbol(AugAssign)]
+                  | "For" "(" PyExpr "," PyExpr "," PyStmts ")" [symbol(For)]
+                  | "Return" "(" PyExpr ")" [symbol(Return)]
+
+  syntax PyExpr ::= "Name" "(" String ")" [symbol(Name)]
+                  | "Int" "(" Int ")" [symbol(IntExpr)]
+                  | "Call" "(" PyExpr "," PyExpr ")" [symbol(Call)]
+                  | "BinOp" "(" String "," PyExpr "," PyExpr ")" [symbol(BinOp)]
+endmodule
+
+module MPY-DOMAIN
+  imports INT
+
+  // Exact rationals model numeric inputs without relying on backend-specific
+  // floating-point hooks.  PosNat makes every denominator positive.
+  syntax PosNat ::= "one" [symbol(one)]
+                  | "next" "(" PosNat ")" [symbol(next)]
+                  | "ten" [symbol(ten)]
+
+  syntax Int ::= posInt(PosNat) [function, total]
+
+  rule posInt(one) => 1
+  rule posInt(next(P)) => 1 +Int posInt(P)
+  rule posInt(ten) => 10
+
+  syntax NumValue ::= "intVal" "(" Int ")" [symbol(intVal)]
+                    | "ratVal" "(" Int "," PosNat ")" [symbol(ratVal)]
+
+  syntax PList ::= "nil" [symbol(nil)]
+                 | "cons" "(" NumValue "," PList ")" [symbol(cons)]
+
+  syntax PValue ::= NumValue
+                  | "listVal" "(" PList ")" [symbol(listVal)]
+
+  syntax Int ::= ceilInt(NumValue) [function]
+
+  rule ceilInt(intVal(I)) => I
+  rule ceilInt(ratVal(N, D))
+    => 0 -Int ((0 -Int N) divInt posInt(D))
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports MPY-DOMAIN
+  imports MAP
+  imports STRING
+
+  syntax Function ::= "function" "(" String "," PyStmts ")" [symbol(function)]
+  syntax Env ::= ".Env" [symbol(emptyEnv)]
+               | "binding" "(" String "," PValue ")" Env [symbol(binding)]
+
+  syntax PValue ::= evalExpr(PyExpr, Env) [function]
+                  | lookupValue(Env, String) [function]
+                  | ceilValue(PValue) [function]
+                  | addValue(PValue, PValue) [function]
+                  | mulValue(PValue, PValue) [function]
+
+  rule evalExpr(Int(I), _) => intVal(I)
+  rule lookupValue(binding(X, V) _, X) => V
+  rule lookupValue(binding(Y, _) RHO, X) => lookupValue(RHO, X)
+    requires X =/=String Y
+  rule evalExpr(Name(X), RHO) => lookupValue(RHO, X)
+  rule evalExpr(Call(Name("ceil"), E), RHO) => ceilValue(evalExpr(E, RHO))
+  rule evalExpr(BinOp("*", E1, E2), RHO)
+    => mulValue(evalExpr(E1, RHO), evalExpr(E2, RHO))
+  rule evalExpr(BinOp("+", E1, E2), RHO)
+    => addValue(evalExpr(E1, RHO), evalExpr(E2, RHO))
+
+  rule ceilValue(V:NumValue) => intVal(ceilInt(V))
+  rule addValue(intVal(I1), intVal(I2)) => intVal(I1 +Int I2)
+  rule mulValue(intVal(I1), intVal(I2)) => intVal(I1 *Int I2)
+
+  syntax KItem ::= load(PyStmts) [symbol(load)]
+                 | loadStmt(PyStmt) [symbol(loadStmt)]
+                 | callEntry(PValue) [symbol(callEntry)]
+                 | exec(PyStmts) [symbol(exec)]
+                 | loop(String, PValue, PyStmts) [symbol(loop)]
+                 | bind(String, PValue) [symbol(bind)]
+
+  configuration
+    <python>
+      <k> $PGM:PyModule ~> callEntry($ARGS:PValue) </k>
+      <functions> .Map </functions>
+      <env> .Env </env>
+    </python>
+
+  rule <k> Module(SS) => load(SS) ... </k>
+
+  rule <k> load(.PyStmts) => .K ... </k>
+  rule <k> load(S:PyStmt SS:PyStmts) => loadStmt(S) ~> load(SS) ... </k>
+
+  rule <k> loadStmt(ImportFrom(_, _)) => .K ... </k>
+  rule <k> loadStmt(FuncDef(F, Params(P), BODY)) => .K ... </k>
+       <functions> FUNS => FUNS [ F <- function(P, BODY) ] </functions>
+
+  rule <k> callEntry(V) => exec(BODY) ... </k>
+       <functions> ... "sum_squares" |-> function(P, BODY) ... </functions>
+       <env> _ => binding(P, V) .Env </env>
+
+  rule <k> exec(.PyStmts) => .K ... </k>
+
+  rule <k> exec(Assign(Name(X), E) SS) => exec(SS) ... </k>
+       <env> RHO => binding(X, evalExpr(E, RHO)) RHO </env>
+
+  rule <k> exec(AugAssign(Name(X), "+", E) SS) => exec(SS) ... </k>
+       <env> RHO => binding(X, addValue(lookupValue(RHO, X), evalExpr(E, RHO))) RHO </env>
+
+  rule <k> exec(For(Name(X), E, BODY) SS) => loop(X, evalExpr(E, RHO), BODY) ~> exec(SS) ... </k>
+       <env> RHO </env>
+
+  rule <k> exec(Return(E) _SS) => evalExpr(E, RHO) ... </k>
+       <env> RHO </env>
+
+  rule <k> loop(_, listVal(nil), _) => .K ... </k>
+  rule <k> loop(X, listVal(cons(V, VS)), BODY)
+        => bind(X, V) ~> exec(BODY) ~> loop(X, listVal(VS), BODY) ... </k>
+
+  rule <k> bind(X, V) => .K ... </k>
+       <env> RHO => binding(X, V) RHO </env>
+endmodule
