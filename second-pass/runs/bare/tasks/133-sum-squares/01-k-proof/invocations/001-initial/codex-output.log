+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(intVal(1), cons(intVal(2), cons(intVal(3), nil)))))
+      => intVal(14)
