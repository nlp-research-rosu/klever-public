+run test "$(rg -c '^VERDICT:' /audit-output/REVIEW.md)" = 1
+run test "$(rg -c '^LEGITIMACY:' /audit-output/REVIEW.md)" = 1
+run wc -lc /audit-output/REVIEW.md
+run find /audit-output/evidence -maxdepth 1 -type f -printf '%f %s bytes\n'
