+  --backend llvm \
+  --syntax-module MPY-SYNTAX \
+  --main-module MPY \
+  --output-definition audit-semantic-kompiled
+run_bounded kompile verification.k \
+  --backend haskell \
+  --syntax-module MPY-SYNTAX \
+  --main-module VERIFICATION \
+  --output-definition audit-verification-kompiled
+
