+
+run_bounded() {
+  printf '\nCOMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" >"$capture" 2>&1
+  status=$?
+  lines=$(wc -l <"$capture")
+  bytes=$(wc -c <"$capture")
+  printf 'OUTPUT_LINES: %d OUTPUT_BYTES: %d\n' "$lines" "$bytes"
+  if (( lines <= 260 )); then
+    sed -n '1,260p' "$capture"
