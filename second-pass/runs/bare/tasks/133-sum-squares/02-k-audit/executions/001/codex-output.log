+  '-cARGS=listVal(cons(intVal(1), cons(intVal(2), cons(intVal(3), nil))))'
+run_bounded krun unsupported-operator.mpy \
+  --definition audit-semantic-kompiled \
+  '-cARGS=listVal(nil)'
