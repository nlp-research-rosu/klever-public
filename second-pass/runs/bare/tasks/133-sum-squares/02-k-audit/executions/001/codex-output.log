diff --git a/evidence/06_adequacy_witnesses.py b/evidence/06_adequacy_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..225d832e30805b23d517ea205ca5f0cbc6e06aa4
--- /dev/null
+++ b/evidence/06_adequacy_witnesses.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Concrete satisfying inputs for every entry/helper claim."""
+
+from __future__ import annotations
+
+from fractions import Fraction
+import importlib.util
+from pathlib import Path
+from typing import Callable
+
+
+SCRATCH = Path("/tmp/audit-work/133-sum-squares")
+
+
+def load_entry(path: Path, module_name: str) -> Callable[[list[object]], int]:
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.sum_squares
+
+
+canonical = load_entry(SCRATCH / "trusted/canonical.py", "witness_canonical")
+candidate = load_entry(SCRATCH / "solution.py", "witness_candidate")
+
+witnesses = [
+    ("ground-14", [1, 2, 3], 14),
+    ("universal-empty", [], 0),
+    (
+        "universal-rational",
+        [Fraction(14, 10), Fraction(-24, 10)],
+        8,
+    ),
+    ("ground-29", [Fraction(14, 10), Fraction(42, 10), 0], 29),
+    ("ground-6", [Fraction(-24, 10), 1, 1], 6),
+]
+
+print("ENTRY_CLAIM_WITNESSES")
+failures = 0
+for claim, values, formal_result in witnesses:
+    oracle = canonical(values)
+    actual = candidate(values)
+    print(
+        f"claim={claim} input={values!r} formal={formal_result} "
+        f"canonical={oracle} candidate={actual}"
+    )
+    failures += int(formal_result != oracle or formal_result != actual)
+
+values = [Fraction(14, 10), Fraction(-24, 10)]
+accumulator = 5
+formal_loop_result = 13
+oracle_adjusted = accumulator + canonical(values)
+candidate_adjusted = accumulator + candidate(values)
+print("LOOP_CLAIM_WITNESS")
+print(
+    "state=<functions>.Map</functions>, "
+    "<env>binding(\"total\",intVal(5)).Env</env>, "
+    "L=cons(ratVal(14,ten),cons(ratVal(-24,ten),nil))"
+)
+print(
+    f"A={accumulator} input={values!r} formal={formal_loop_result} "
+    f"A+canonical={oracle_adjusted} A+candidate={candidate_adjusted}"
+)
+failures += int(
+    formal_loop_result != oracle_adjusted
+    or formal_loop_result != candidate_adjusted
+)
+
+print(f"SUMMARY: witnesses=6 failures={failures}")
+raise SystemExit(1 if failures else 0)

exec
/bin/bash -lc 'bash /audit-output/evidence/06_adequacy_and_pinning.sh' in /audit-output
diff --git a//tmp/audit-work/133-sum-squares/spec-claim-1.k b//tmp/audit-work/133-sum-squares/spec-claim-1.k
new file mode 100644
index 0000000000000000000000000000000000000000..7560e350bff851ad3a9c74067e8dc56cd2aea434
--- /dev/null
+++ b//tmp/audit-work/133-sum-squares/spec-claim-1.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module SPEC-CLAIM-1
+  imports VERIFICATION
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(intVal(1), cons(intVal(2), cons(intVal(3), nil)))))
+      => intVal(14)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+endmodule
diff --git a//tmp/audit-work/133-sum-squares/spec-claim-2.k b//tmp/audit-work/133-sum-squares/spec-claim-2.k
new file mode 100644
index 0000000000000000000000000000000000000000..92c19126346ab8d109cf3c9d64813614eed61227
--- /dev/null
+++ b//tmp/audit-work/133-sum-squares/spec-claim-2.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module SPEC-CLAIM-2
+  imports VERIFICATION
+
+  claim [all-numeric-lists]:
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(L:PList))
+      => intVal(sumSquares(L))
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+
+  // The target's circularity dependency, copied exactly from spec.k.
+  claim [loop-invariant]:
+    <k>
+      loop("number", listVal(L:PList),
+        Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+        AugAssign(Name("total"), "+",
+          BinOp("*", Name("rounded"), Name("rounded")))
+        .PyStmts)
+      ~> exec(Return(Name("total")) .PyStmts)
+      => intVal(sumSquaresFrom(A:Int, L))
+    </k>
+    <functions> FUNS:Map </functions>
+    <env>
+      (binding("total", intVal(A)) REST:Env) => ?ENV:Env
+    </env>
+endmodule
