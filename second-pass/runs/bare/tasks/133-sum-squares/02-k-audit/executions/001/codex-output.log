diff --git a//tmp/audit-work/133-sum-squares/spec-claim-1.k b//tmp/audit-work/133-sum-squares/spec-claim-1.k
new file mode 100644
index 0000000000000000000000000000000000000000..7560e350bff851ad3a9c74067e8dc56cd2aea434
--- /dev/null
+++ b//tmp/audit-work/133-sum-squares/spec-claim-1.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module SPEC-CLAIM-1
+  imports VERIFICATION
+
+  claim
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(intVal(1), cons(intVal(2), cons(intVal(3), nil)))))
+      => intVal(14)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+endmodule
diff --git a//tmp/audit-work/133-sum-squares/spec-claim-2.k b//tmp/audit-work/133-sum-squares/spec-claim-2.k
new file mode 100644
index 0000000000000000000000000000000000000000..92c19126346ab8d109cf3c9d64813614eed61227
--- /dev/null
+++ b//tmp/audit-work/133-sum-squares/spec-claim-2.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module SPEC-CLAIM-2
+  imports VERIFICATION
+
+  claim [all-numeric-lists]:
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("*", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(L:PList))
+      => intVal(sumSquares(L))
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+
+  // The target's circularity dependency, copied exactly from spec.k.
+  claim [loop-invariant]:
+    <k>
+      loop("number", listVal(L:PList),
+        Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+        AugAssign(Name("total"), "+",
+          BinOp("*", Name("rounded"), Name("rounded")))
+        .PyStmts)
+      ~> exec(Return(Name("total")) .PyStmts)
+      => intVal(sumSquaresFrom(A:Int, L))
+    </k>
+    <functions> FUNS:Map </functions>
+    <env>
+      (binding("total", intVal(A)) REST:Env) => ?ENV:Env
+    </env>
+endmodule
