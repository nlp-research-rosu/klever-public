diff --git a//tmp/audit-work/candidate/spec-body-mutation.k b//tmp/audit-work/candidate/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..b53d4788e80d5639a2cb5752f07316af90cccf82
--- /dev/null
+++ b//tmp/audit-work/candidate/spec-body-mutation.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // The claim term itself is materially changed: multiplication becomes addition.
+  // On [1,2,3], this program returns 12, so retaining postcondition 14 is false.
+  claim [mutated-body-ground-witness]:
+    <k>
+      Module(
+        ImportFrom("math", "ceil")
+        FuncDef("sum_squares", Params("lst"),
+          Assign(Name("total"), Int(0))
+          For(Name("number"), Name("lst"),
+            Assign(Name("rounded"), Call(Name("ceil"), Name("number")))
+            AugAssign(Name("total"), "+",
+              BinOp("+", Name("rounded"), Name("rounded"))))
+          Return(Name("total")))
+        .PyStmts)
+      ~> callEntry(listVal(
+           cons(intVal(1), cons(intVal(2), cons(intVal(3), nil)))))
+      => intVal(14)
+    </k>
+    <functions> .Map => ?FUNS:Map </functions>
+    <env> .Env => ?ENV:Env </env>
+endmodule
