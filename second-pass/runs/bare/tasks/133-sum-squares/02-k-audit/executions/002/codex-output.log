/bin/bash -lc "/audit-output/evidence/run_logged.sh 14-constructor-program-pinning /tmp/audit-work/candidate bash -c 'kast --definition semantic-fresh-kompiled --sort PyModule --output kore solution.mpy > submitted-program.kore && kast --definition semantic-fresh-kompiled --sort PyModule --output kore claimed-program.mpy > claimed-program.kore && sha256sum submitted-program.kore claimed-program.kore && cmp -s submitted-program.kore claimed-program.kore'" in /audit-output
