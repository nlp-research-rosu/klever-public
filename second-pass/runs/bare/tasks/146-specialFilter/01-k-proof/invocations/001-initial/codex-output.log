+  syntax Stmt ::= FuncDef ( String , Params , Stmts )
+                | Assign ( Expr , Expr )
+                | AugAssign ( Expr , String , Expr )
+                | If ( Expr , Stmts , Stmts )
+                | For ( Expr , Expr , Stmts )
+                | While ( Expr , Stmts )
+                | Return ( Expr )
+
+  syntax Expr ::= Int ( Int )
+                | Bool ( Bool )
+                | Name ( String )
+                | ListExpr ( Exprs )
