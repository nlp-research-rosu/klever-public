diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b00568556207269ebfb93b9525f3b544aebe326
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,69 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Symbolic integer-list input and an independent bounded-domain oracle.
+  // IntList is verification-only input notation; the function still receives
+  // the same listVal runtime value produced by an ordinary ListExpr.
+  syntax IntVals ::= ".IntVals"
+                   | iVals ( Int , IntVals )
+  syntax Expr ::= IntList ( IntVals )
+  syntax Values ::= #values ( IntVals ) [function]
+  rule #values(.IntVals) => .Values
+  rule #values(iVals(N, NS)) => intVal(N), #values(NS)
+  rule IntList(NS) => listVal(#values(NS))
+
+  syntax Int ::= #qualifies99 ( Int ) [function]
+               | #count99 ( IntVals ) [function]
+               | #countValues99 ( Values ) [function]
+  syntax Bool ::= #bounded99 ( IntVals ) [function]
+                | #boundedValues99 ( Values ) [function]
+
+  rule #qualifies99(N) => 0
+    requires N <=Int 10
+  rule #qualifies99(N) => 1
+    requires 11 <=Int N andBool N <=Int 99
+      andBool N %Int 2 ==Int 1
+      andBool (N /Int 10) %Int 2 ==Int 1
+  rule #qualifies99(N) => 0
+    requires 11 <=Int N andBool N <=Int 99
+      andBool notBool (N %Int 2 ==Int 1
+        andBool (N /Int 10) %Int 2 ==Int 1)
+
+  rule #count99(.IntVals) => 0
+  rule #count99(iVals(N, NS)) => #qualifies99(N) +Int #count99(NS)
+  rule #countValues99(.Values) => 0
+  rule #countValues99(intVal(N), VS) => #qualifies99(N) +Int #countValues99(VS)
+
+  rule #bounded99(.IntVals) => true
+  rule #bounded99(iVals(N, NS)) => N <=Int 99 andBool #bounded99(NS)
+  rule #boundedValues99(.Values) => true
+  rule #boundedValues99(intVal(N), VS) => N <=Int 99 andBool #boundedValues99(VS)
+
+  // This macro is the exact tree emitted in solution.mpy, with ARG supplied
+  // as the call argument.  It keeps specifications readable without adding a
+  // semantic shortcut for specialFilter.
+  syntax Program ::= SFTest ( Expr )
+  syntax KItem ::= "clearFunctions"
+  rule <k> SFTest(ARG) => Run(
+    Module(
+      FuncDef("specialFilter", Params("nums"),
+        Assign(Name("count"), Int(0))
+        For(Name("num"), Name("nums"),
+          If(Compare(Name("num"), CmpOp(">", Int(10))),
+            Assign(Name("first"), Name("num"))
+            While(Compare(Name("first"), CmpOp(">=", Int(10))),
+              Assign(Name("first"), BinOp("//", Name("first"), Int(10))))
+            If(Compare(BinOp("%", Name("first"), Int(2)), CmpOp("==", Int(1))),
+              If(Compare(BinOp("%", Name("num"), Int(2)), CmpOp("==", Int(1))),
+                AugAssign(Name("count"), "+", Int(1)),
+                .Stmts),
+              .Stmts),
+            .Stmts))
+        Return(Name("count")))),
+    Call(Name("specialFilter"), ARG)) ~> clearFunctions ... </k>
+
+  rule <k> V:Value ~> clearFunctions => V ... </k>
+       <functions> _ => .Map </functions>
+endmodule

