+assert module.startswith("Module(") and module.endswith(")")
+items = ", ".join(f"Int({integer})" for integer in args.integers)
+list_term = f"ListExpr({items})"
+print(f'Run({module}, Call(Name("specialFilter"), {list_term}))')

