+        print("usage: exec_log.py LOGFILE COMMAND [ARG ...]", file=sys.stderr)
+        return 2
+
+    log_path = Path(sys.argv[1])
+    command = sys.argv[2:]
+    started = datetime.now(timezone.utc)
+    result = subprocess.run(
+        command,
+        cwd=os.getcwd(),
+        env=os.environ.copy(),
+        stdout=subprocess.PIPE,
