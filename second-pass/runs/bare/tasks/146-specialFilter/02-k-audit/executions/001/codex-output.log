+        label = kind(path)
+        suffix = f" sha256={digest(path)}" if label == "regular-file" else ""
+        print(f"required {rel}: {label}{suffix}")
+
+    traces = sorted(CANDIDATE.glob("codex-trace/**/*.jsonl"))
