import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
assert len(out['rules']) == len(inventory['rules'])
assert [x['source_rule_id'] for x in out['rules']] == [x['source_rule_id'] for x in inventory['rules']]
assert len({x['source_rule_id'] for x in out['rules']}) == len(out['rules'])
for source, classified in zip(inventory['rules'], out['rules']):
    assert list(classified) == ['source_rule_id', 'classification', 'rationale']
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'], str) and classified['rationale'].strip()
    if 'simplification' in source['attributes']:
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

discovery = Path('/workspace/DISCOVERY.md').read_text().lower()
assert 'no separately proved derived lemmas' in discovery
assert 'domain-lemma set is empty' in discovery

print('schema_version:', out['schema_version'])
print('inventory_sha256:', out['inventory_sha256'])
print('rules:', len(out['rules']))
for item in out['rules']:
    print(item['source_rule_id'], item['classification'])
print('domain lemmas:', sum(x['classification'] == 'DOMAIN_LEMMA' for x in out['rules']))
print('proved derived lemmas:', sum(x['classification'] == 'PROVED_DERIVED_LEMMA' for x in out['rules']))
