prove.sh:
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy

kompile semantic.k \
  --backend haskell \
  --syntax-module FIBFIB-SYNTAX \
  --main-module FIBFIB

run_case() {
  local n="$1"
  local expected="$2"
  local output
  local actual

  output="$(krun solution.mpy -cN="$n")"
  actual="$(printf '%s\n' "$output" | sed -n '/<result>/ { n; s/[[:space:]]//g; p; }')"
  printf 'krun fibfib(%s) => %s\n' "$n" "$actual"
  test "$actual" = "$expected"
}

run_case 0 0
run_case 1 0
run_case 2 1
run_case 5 4
run_case 8 24
run_case 10 81

proof_output="$(
  kprove spec.k \
    --definition semantic-kompiled \
    --spec-module FIBFIB-SPEC \
    -w none
)"
printf '%s\n' "$proof_output"
printf '%s\n' "$proof_output" | grep -qx '#Top'

verification.k:
module FIBFIB-VERIFICATION
  imports FIBFIB-SYNTAX
  imports INT

  syntax Int ::= fibfibMath(Int) [function, total]
  syntax Pgm ::= "fibfibProgram" [macro]
  syntax Expr ::= "loopCondition" [macro]
  syntax Stmts ::= "loopBody" [macro]

  rule loopCondition
    => Compare(Name("i"), CmpOp("<", Name("n")))

  rule loopBody
    => Assign(
         TupleExpr(Name("a"), Name("b"), Name("c")),
         TupleExpr(Name("b"), Name("c"),
           BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c"))))
       Assign(Name("i"), BinOp("+", Name("i"), Int(1)))

  rule fibfibProgram
    => Module(
         FuncDef("fibfib", Params("n"),
           Assign(Name("a"), Int(0))
           Assign(Name("b"), Int(0))
           Assign(Name("c"), Int(1))
           Assign(Name("i"), Int(0))
           While(loopCondition, loopBody)
           Return(Name("a"))))

  rule fibfibMath(N) => 0 requires N <=Int 1
  rule fibfibMath(2) => 1
  rule fibfibMath(N) => fibfibMath(N -Int 1)
                         +Int fibfibMath(N -Int 2)
                         +Int fibfibMath(N -Int 3)
    requires N >=Int 3
endmodule

spec.k:
requires "semantic.k"

module FIBFIB-SPEC
  imports FIBFIB
  imports FIBFIB-VERIFICATION

  claim [program-correct]:
    <k> fibfibProgram ~> invoke(N) => .K </k>
    <env>
      .Map
      =>
      "a" |-> fibfibMath(N)
      "b" |-> fibfibMath(N +Int 1)
      "c" |-> fibfibMath(N +Int 2)
      "i" |-> N
      "n" |-> N
    </env>
    <result> 0 => fibfibMath(N) </result>
    requires 0 <=Int N

  claim [loop-invariant]:
    <k> While(loopCondition, loopBody)
         ~> (Return(Name("a")) .Stmts)
         ~> finish
      => .K
    </k>
    <env>
      "a" |-> fibfibMath(I)
      "b" |-> fibfibMath(I +Int 1)
      "c" |-> fibfibMath(I +Int 2)
      "i" |-> I
      "n" |-> N
      =>
      "a" |-> fibfibMath(N)
      "b" |-> fibfibMath(N +Int 1)
      "c" |-> fibfibMath(N +Int 2)
      "i" |-> N
      "n" |-> N
    </env>
    <result> _R => fibfibMath(N) </result>
    requires 0 <=Int I andBool I <=Int N
endmodule

