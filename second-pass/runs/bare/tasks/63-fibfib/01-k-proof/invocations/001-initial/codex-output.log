+++ b/verification.k
@@ -0,0 +1,36 @@
+module FIBFIB-VERIFICATION
+  imports FIBFIB-SYNTAX
+  imports INT
+
+  syntax Int ::= fibfibMath(Int) [function, total, symbol]
+  syntax Pgm ::= "fibfibProgram" [macro]
+  syntax Expr ::= "loopCondition" [macro]
+  syntax Stmts ::= "loopBody" [macro]
+
+  rule loopCondition
+    => Compare(Name("i"), CmpOp("<", Name("n")))
+
+  rule loopBody
+    => Assign(
+         TupleExpr(Name("a"), Name("b"), Name("c")),
+         TupleExpr(Name("b"), Name("c"),
+           BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c"))))
+       Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+
+  rule fibfibProgram
+    => Module(
+         FuncDef("fibfib", Params("n"),
+           Assign(Name("a"), Int(0))
+           Assign(Name("b"), Int(0))
+           Assign(Name("c"), Int(1))
+           Assign(Name("i"), Int(0))
+           While(loopCondition, loopBody)
+           Return(Name("a"))))
+
+  rule fibfibMath(N) => 0 requires N <=Int 1
+  rule fibfibMath(2) => 1
+  rule fibfibMath(N) => fibfibMath(N -Int 1)
+                         +Int fibfibMath(N -Int 2)
+                         +Int fibfibMath(N -Int 3)
+    requires N >=Int 3
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..188e5b4c3b2bccf8057a5796ad33fc4dffbb096e
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,101 @@
+requires "verification.k"
+
+module FIBFIB-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")" [symbol(moduleAst)]
+
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(funcDefAst)]
+                | "Assign" "(" Expr "," Expr ")" [symbol(assignAst)]
+                | "While" "(" Expr "," Stmts ")" [symbol(whileAst)]
+                | "Return" "(" Expr ")" [symbol(returnAst)]
+
+  syntax Params ::= "Params" "(" Strings ")" [symbol(paramsAst)]
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")" [symbol(nameAst)]
+                | "Int" "(" Int ")" [symbol(intAst)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(binOpAst)]
+                | "Compare" "(" Expr "," CmpOps ")" [symbol(compareAst)]
+                | "TupleExpr" "(" Exprs ")" [symbol(tupleExprAst)]
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(cmpOpAst)]
+  syntax CmpOps ::= List{CmpOp, ","}
+endmodule
+
+module FIBFIB
+  imports FIBFIB-SYNTAX
+  imports FIBFIB-VERIFICATION
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax KItem ::= "invoke" "(" Int ")" [symbol]
+                 | "finish" [symbol]
+                 | "assignTo" "(" String ")" [symbol]
+                 | "binRhs" "(" String "," Expr ")" [symbol]
+                 | "applyBin" "(" String "," Int ")" [symbol]
+                 | "compareRhs" "(" String "," Expr ")" [symbol]
+                 | "applyCompare" "(" String "," Int ")" [symbol]
+                 | "tupleSecond" "(" String "," String "," String "," Expr "," Expr ")" [symbol]
+                 | "tupleThird" "(" String "," String "," String "," Int "," Expr ")" [symbol]
+                 | "tupleStore" "(" String "," String "," String "," Int "," Int ")" [symbol]
+                 | "whileDecision" "(" Expr "," Stmts ")" [symbol]
+                 | "returnValue" [symbol]
+
+  syntax KResult ::= Int | Bool
+
+  configuration
+    <fibfib>
+      <k> $PGM:Pgm ~> invoke($N:Int) </k>
+      <env> .Map </env>
+      <result> 0 </result>
+    </fibfib>
+
+  rule <k> Module(FuncDef("fibfib", Params("n"), BODY)) ~> invoke(N)
+        => BODY ~> finish ... </k>
+       <env> .Map => "n" |-> N </env>
+
+  rule <k> (S:Stmt REST:Stmts => S ~> REST) ... </k>
+  rule <k> .Stmts => .K ... </k>
+
+  rule <k> Int(I) => I ... </k>
+  rule <k> Name(X) => I ... </k>
+       <env>... X |-> I ...</env>
+
+  rule <k> BinOp(OP, E1, E2) => E1 ~> binRhs(OP, E2) ... </k>
+  rule <k> I:Int ~> binRhs(OP, E2) => E2 ~> applyBin(OP, I) ... </k>
+  rule <k> I2:Int ~> applyBin("+", I1) => I1 +Int I2 ... </k>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareRhs(OP, E2) ... </k>
+  rule <k> I1:Int ~> compareRhs(OP, E2) => E2 ~> applyCompare(OP, I1) ... </k>
+  rule <k> I2:Int ~> applyCompare("<", I1) => I1 <Int I2 ... </k>
+
+  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ... </k>
+  rule <k> I:Int ~> assignTo(X) => .K ... </k>
+       <env> M => M [ X <- I ] </env>
+
+  rule <k> Assign(TupleExpr(Name(A), Name(B), Name(C)), TupleExpr(E1, E2, E3))
+        => E1 ~> tupleSecond(A, B, C, E2, E3) ... </k>
+  rule <k> I1:Int ~> tupleSecond(A, B, C, E2, E3)
+        => E2 ~> tupleThird(A, B, C, I1, E3) ... </k>
+  rule <k> I2:Int ~> tupleThird(A, B, C, I1, E3)
+        => E3 ~> tupleStore(A, B, C, I1, I2) ... </k>
+  rule <k> I3:Int ~> tupleStore(A, B, C, I1, I2) => .K ... </k>
+       <env> M => M [ A <- I1 ] [ B <- I2 ] [ C <- I3 ] </env>
+
+  rule <k> While(COND, BODY) => COND ~> whileDecision(COND, BODY) ... </k>
+  rule <k> true ~> whileDecision(COND, BODY)
+        => BODY ~> While(COND, BODY) ... </k>
+  rule <k> false ~> whileDecision(_, _) => .K ... </k>
+
+  rule <k> Return(E) => E ~> returnValue ... </k>
+  rule <k> I:Int ~> returnValue ~> .Stmts ~> finish => .K </k>
+       <result> _ => I </result>
+  rule <k> I:Int ~> returnValue ~> finish => .K </k>
+       <result> _ => I </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ccda77de5beeff9181929da687fc41025f347f1a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def fibfib(n: int):
+    a = 0
+    b = 0
+    c = 1
+    i = 0
+    while i < n:
+        a, b, c = b, c, a + b + c
+        i = i + 1
+    return a
