$ nl -ba verification.k
     1	module FIBFIB-VERIFICATION
     2	  imports FIBFIB-SYNTAX
     3	  imports INT
     4	
     5	  syntax Int ::= fibfibMath(Int) [function, total]
     6	  syntax Pgm ::= "fibfibProgram" [macro]
     7	  syntax Expr ::= "loopCondition" [macro]
     8	  syntax Stmts ::= "loopBody" [macro]
     9	
    10	  rule loopCondition
    11	    => Compare(Name("i"), CmpOp("<", Name("n")))
    12	
    13	  rule loopBody
    14	    => Assign(
    15	         TupleExpr(Name("a"), Name("b"), Name("c")),
    16	         TupleExpr(Name("b"), Name("c"),
    17	           BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c"))))
    18	       Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
    19	
    20	  rule fibfibProgram
    21	    => Module(
    22	         FuncDef("fibfib", Params("n"),
    23	           Assign(Name("a"), Int(0))
    24	           Assign(Name("b"), Int(0))
    25	           Assign(Name("c"), Int(1))
    26	           Assign(Name("i"), Int(0))
    27	           While(loopCondition, loopBody)
    28	           Return(Name("a"))))
    29	
    30	  rule fibfibMath(N) => 0 requires N <=Int 1
    31	  rule fibfibMath(2) => 1
    32	  rule fibfibMath(N) => fibfibMath(N -Int 1)
    33	                         +Int fibfibMath(N -Int 2)
    34	                         +Int fibfibMath(N -Int 3)
    35	    requires N >=Int 3
    36	endmodule
$ nl -ba spec.k
     1	requires "semantic.k"
     2	
     3	module FIBFIB-SPEC
     4	  imports FIBFIB
     5	  imports FIBFIB-VERIFICATION
     6	
     7	  claim [program-correct]:
     8	    <k> fibfibProgram ~> invoke(N) => .K </k>
     9	    <env>
    10	      .Map
    11	      =>
    12	      "a" |-> fibfibMath(N)
    13	      "b" |-> fibfibMath(N +Int 1)
    14	      "c" |-> fibfibMath(N +Int 2)
    15	      "i" |-> N
    16	      "n" |-> N
    17	    </env>
    18	    <result> 0 => fibfibMath(N) </result>
    19	    requires 0 <=Int N
    20	
    21	  claim [loop-invariant]:
    22	    <k> While(loopCondition, loopBody)
    23	         ~> (Return(Name("a")) .Stmts)
    24	         ~> finish
    25	      => .K
    26	    </k>
    27	    <env>
    28	      "a" |-> fibfibMath(I)
    29	      "b" |-> fibfibMath(I +Int 1)
    30	      "c" |-> fibfibMath(I +Int 2)
    31	      "i" |-> I
    32	      "n" |-> N
    33	      =>
    34	      "a" |-> fibfibMath(N)
    35	      "b" |-> fibfibMath(N +Int 1)
    36	      "c" |-> fibfibMath(N +Int 2)
    37	      "i" |-> N
    38	      "n" |-> N
    39	    </env>
    40	    <result> _R => fibfibMath(N) </result>
    41	    requires 0 <=Int I andBool I <=Int N
    42	endmodule
