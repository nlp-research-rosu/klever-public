+#!/usr/bin/env bash
+set -u
+
+status=0
+mutation_dir=/tmp/audit-work/body-mutation
+trusted_translator=/tmp/audit-work/reference-src/py2mpy.py
+definition=/tmp/audit-work/rebuild/concrete-kompiled
+
