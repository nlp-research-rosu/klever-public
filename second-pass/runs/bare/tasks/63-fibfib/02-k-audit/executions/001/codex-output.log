+}
+for key, value in checks.items():
+    print(f"{key}={value}")
+if not all(checks.values()):
+    raise SystemExit(1)
+PY
+rc=$?
+echo "exit=$rc"
+(( rc == 0 )) || status=1
+
+echo '$ validate every structured trace line is JSON and count record kinds'
+python3 - <<'PY'
+import collections
+import glob
+import json
+
+paths = glob.glob("/candidate/codex-trace/**/*.jsonl", recursive=True)
