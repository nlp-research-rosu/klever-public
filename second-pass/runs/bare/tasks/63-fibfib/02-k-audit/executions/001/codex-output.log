index 0000000000000000000000000000000000000000..68f4eb0bc30ab29772e13ef30ebfcfab16c714a2
--- /dev/null
+++ b//tmp/audit-work/body-mutation/solution-return-b.py
@@ -0,0 +1,9 @@
+def fibfib(n: int):
+    a = 0
+    b = 0
+    c = 1
+    i = 0
+    while i < n:
+        a, b, c = b, c, a + b + c
+        i = i + 1
+    return b
