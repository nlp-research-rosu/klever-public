+actual="$(
+  printf '%s\n' "$output" |
+    sed -n '/<result>/ { n; s/[[:space:]]//g; p; }'
+)"
+echo "mutated_k_result=$actual"
+echo "original_k_result=4"
+if [[ "$actual" == 7 && "$actual" != 4 ]]; then
+  echo 'body_sensitivity=PASS'
+else
