+fi
+
+echo '$ kast mutated program and compare to the claim macro KORE'
+kast "$mutation_dir/solution-return-b.mpy" \
+  --definition /tmp/audit-work/rebuild/proof-kompiled \
+  --module FIBFIB \
+  --sort Pgm \
+  --expand-macros \
