Module(
  FuncDef("fibfib", Params("n"),
    Assign(Name("a"), Int(0))
    Assign(Name("b"), Int(0))
    Assign(Name("c"), Int(1))
    Assign(Name("i"), Int(0))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      Assign(
        TupleExpr(Name("a"), Name("b"), Name("c")),
        TupleExpr(
          Name("b"),
          Name("c"),
          BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c"))))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("b"))))
