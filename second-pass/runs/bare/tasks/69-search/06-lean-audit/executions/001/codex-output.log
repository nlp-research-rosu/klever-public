/bin/bash -lc '/audit-output/evidence/run_logged.sh 14-reject-false-derived-lemma.log kprove loop-lemma-mutated.k --definition verification-core-kompiled --spec-module LOOP-LEMMA-MUTATED' in /tmp/audit-work/stage1-recheck
