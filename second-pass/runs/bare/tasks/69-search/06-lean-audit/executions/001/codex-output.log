+    comparison["ordered_ids_equal"]
+    and comparison["identity_sets_equal"]
+    and comparison["inventory_hashes_equal"]
+    and not comparison["manifest_has_duplicate_ids"]
+    and not comparison["inventory_has_duplicate_ids"]
