cp -a /reference/klean-generation/generated/. "$temporary_project/"
/audit-output/evidence/run_logged.sh 11-lake-project-diagnostics.log bash -lc '"'set -x; cd \""'$1"; lake --version; lake clean; env LEAN_SYSROOT=/opt/elan/toolchains/leanprover--lean4---v4.22.0 /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake --version; env LEAN_SYSROOT=/opt/elan/toolchains/leanprover--lean4---v4.22.0 /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake clean'"' _ \""'$temporary_project"' in /audit-output
