index 0000000000000000000000000000000000000000..cc824a6f12fea5d9fcb21c486fa53c8360613828
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run_logged.sh LOG_NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}"
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf '\nEXIT_CODE: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+exit "${PIPESTATUS[0]}"
diff --git a/evidence/verify_provenance.py b/evidence/verify_provenance.py
new file mode 100644
index 0000000000000000000000000000000000000000..07595b0301b76d65747f6e7bae71b2970c2b90b7
