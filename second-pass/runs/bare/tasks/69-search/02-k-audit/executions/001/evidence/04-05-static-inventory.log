===== verification-core.k =====
     1	requires "semantic.k"
     2	
     3	module VERIFICATION-CORE
     4	  imports MPY
     5	
     6	  // A readable name for the exact constructor tree generated from solution.py.
     7	  syntax Module ::= "searchProgram" [macro]
     8	  syntax Stmts ::= "searchBody" [macro]
     9	  syntax Stmts ::= "searchLoopBody" [macro]
    10	  rule searchProgram => Module(FuncDef("search", Params("lst"), searchBody))
    11	  rule searchBody =>
    12	    Assign(Name("answer"), UnaryOp("-", Int(1)))
    13	    For(Name("value"), Name("lst"), searchLoopBody)
    14	    Return(Name("answer"))
    15	  rule searchLoopBody =>
    16	    If(Compare(
    17	         Call(Attribute(Name("lst"), "count"), Name("value")),
    18	         CmpOp(">=", Name("value"))),
    19	       If(Compare(Name("value"), CmpOp(">", Name("answer"))),
    20	          Assign(Name("answer"), Name("value")),
    21	          .Stmts),
    22	       .Stmts)
    23	
    24	  // Mathematical reference model.  promote retains the current answer unless
    25	  // the candidate occurs at least candidate-many times and is strictly larger.
    26	  // searchSpec is therefore the greatest qualifying integer, or -1 if absent.
    27	  syntax Int ::= promote(IntSeq, Int, Int) [function, total]
    28	  rule promote(L, I, A) => I
    29	    requires count(I, L) >=Int I andBool I >Int A
    30	  rule promote(L, I, A) => A
    31	    requires notBool (count(I, L) >=Int I andBool I >Int A)
    32	
    33	  syntax Int ::= scan(IntSeq, IntSeq, Int) [function, total]
    34	  rule scan(_, .Ints, A) => A
    35	  rule scan(L, cons(I, IS), A) => scan(L, IS, promote(L, I, A))
    36	
    37	  syntax Int ::= searchSpec(IntSeq) [function, total]
    38	  rule searchSpec(L) => scan(L, L, -1)
    39	
    40	  syntax Bool ::= positive(IntSeq) [function, total]
    41	  rule positive(.Ints) => true
    42	  rule positive(cons(I, IS)) => (I >Int 0) andBool positive(IS)
    43	endmodule

===== verification.k =====
     1	requires "verification-core.k"
     2	
     3	module VERIFICATION
     4	  imports VERIFICATION-CORE
     5	
     6	  // Derived summary rule.  loop-lemma-spec.k proves this exact reachability
     7	  // step against the raw small-step semantics before this module is compiled.
     8	  rule <k> loop("value", IS, searchLoopBody)
     9	            ~> exec(Return(Name("answer")) .Stmts) => .K </k>
    10	       <program> searchProgram </program>
    11	       <input> VList(L) </input>
    12	       <env> ("answer" |-> VInt(A)
    13	              "lst" |-> VList(L)
    14	              "value" |-> VInt(_PREV)) => .Map </env>
    15	       <result> noResult => VInt(scan(L, IS, A)) </result>
    16	       [priority(40)]
    17	endmodule

===== loop-lemma-spec.k =====
     1	requires "verification-core.k"
     2	
     3	module LOOP-LEMMA-SPEC
     4	  imports VERIFICATION-CORE
     5	
     6	  // Inductive loop invariant after at least one iteration.  PREV is
     7	  // intentionally irrelevant: the next semantic loop step overwrites it.
     8	  claim [loop-invariant]:
     9	        <k> loop("value", IS, searchLoopBody)
    10	             ~> exec(Return(Name("answer")) .Stmts) => .K </k>
    11	        <program> searchProgram </program>
    12	        <input> VList(L) </input>
    13	        <env> ("answer" |-> VInt(A)
    14	               "lst" |-> VList(L)
    15	               "value" |-> VInt(_PREV)) => .Map </env>
    16	        <result> noResult => VInt(scan(L, IS, A)) </result>
    17	endmodule

===== spec.k =====
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // The three examples from prompt.py.
     7	  claim [example-one]: <k> boot => .K </k>
     8	        <program> searchProgram </program>
     9	        <input> VList(cons(4, cons(1, cons(2, cons(2, cons(3, cons(1, .Ints))))))) </input>
    10	        <env> .Map </env>
    11	        <result> noResult => VInt(2) </result>
    12	
    13	  claim [example-two]: <k> boot => .K </k>
    14	        <program> searchProgram </program>
    15	        <input> VList(cons(1, cons(2, cons(2, cons(3, cons(3, cons(3,
    16	                 cons(4, cons(4, cons(4, .Ints)))))))))) </input>
    17	        <env> .Map </env>
    18	        <result> noResult => VInt(3) </result>
    19	
    20	  claim [example-three]: <k> boot => .K </k>
    21	        <program> searchProgram </program>
    22	        <input> VList(cons(5, cons(5, cons(4, cons(4, cons(4, .Ints)))))) </input>
    23	        <env> .Map </env>
    24	        <result> noResult => VInt(-1) </result>
    25	
    26	  // Universal functional-correctness theorem for every non-empty integer
    27	  // list (and hence the prompt's positive-list domain).  searchSpec is the
    28	  // recursive maximum-by-frequency contract.
