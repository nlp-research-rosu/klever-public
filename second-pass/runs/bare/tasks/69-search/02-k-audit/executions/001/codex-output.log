    48	      <result> noResult </result>
    49	    </mpy>
    50	
    51	  // Pure expression evaluation.  The covered operations are exactly those
    52	  // emitted for solution.py; unsupported Python constructs cannot silently run.
    53	  syntax Value ::= eval(Expr, Map) [function]
    54	  syntax Value ::= negate(Value) [function]
    55	  syntax Int ::= asInt(Value) [function]
    56	  syntax IntSeq ::= asInts(Value) [function]
    57	
    58	  rule eval(Int(I), _) => VInt(I)
    59	  rule eval(Name(X), RHO) => {RHO[X]}:>Value
    60	    requires X in_keys(RHO)
    61	  rule eval(UnaryOp("-", E), RHO) => negate(eval(E, RHO))
    62	  rule eval(Call(Attribute(E, "count"), ARG), RHO)
