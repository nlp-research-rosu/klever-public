    68	
    69	  rule negate(VInt(I)) => VInt(0 -Int I)
    70	  rule asInt(VInt(I)) => I
    71	  rule asInts(VList(IS)) => IS
    72	
    73	  syntax Int ::= count(Int, IntSeq) [function, total]
    74	  rule count(_, .Ints) => 0
    75	  rule count(I, cons(I, IS)) => 1 +Int count(I, IS)
    76	  rule count(I, cons(J, IS)) => count(I, IS)
    77	    requires I =/=Int J
    78	
    79	  // Small-step statement execution.
    80	  syntax KItem ::= exec(Stmts)
