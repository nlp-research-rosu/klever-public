+  > /tmp/audit-work/69-search-audit/build/solution.regenerated.mpy
+translate_status=$?
+
+cmp -s \
+  /tmp/audit-work/69-search-audit/build/solution.regenerated.mpy \
+  /tmp/audit-work/69-search-audit/src/solution.mpy
+cmp_status=$?
+
+sha256sum \
+  /tmp/audit-work/69-search-audit/build/solution.regenerated.mpy \
+  /tmp/audit-work/69-search-audit/src/solution.mpy
+printf 'translator exit status: %d\n' "$translate_status"
