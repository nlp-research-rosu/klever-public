+  "$audit_src/spec.k"
+
+printf '\nComplete numbered K sources\n'
+for file in "${files[@]}"; do
+  printf '\n===== %s =====\n' "$file"
+  nl -ba "$audit_src/$file"
+done
diff --git a/evidence/translation_identity.sh b/evidence/translation_identity.sh
