+  {"name": "permuted_mixed", "input": [3, 1, 3, 2, 3, 2], "in_domain": true},
+  {"name": "large_value_fails", "input": [1000000], "in_domain": true},
+  {"name": "empty_diagnostic", "input": [], "in_domain": false},
+  {"name": "zero_diagnostic", "input": [0], "in_domain": false}
+]
