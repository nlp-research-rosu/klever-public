    35	                  | "cons" "(" Int "," IntSeq ")"
    36	  syntax Value ::= "VInt" "(" Int ")"
    37	                 | "VBool" "(" Bool ")"
    38	                 | "VList" "(" IntSeq ")"
    39	  syntax Result ::= "noResult" | Value
    40	  syntax KItem ::= "boot"
    41	
    42	  configuration
    43	    <mpy>
    44	      <k> boot </k>
    45	      <program> $PGM:Module </program>
