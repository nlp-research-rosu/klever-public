    95	
    96	  rule <k> execStmt(If(E, THEN, ELSE)) => choose(eval(E, RHO), THEN, ELSE) ... </k>
    97	       <env> RHO </env>
    98	  rule choose(VBool(true), THEN, _) => exec(THEN)
    99	  rule choose(VBool(false), _, ELSE) => exec(ELSE)
