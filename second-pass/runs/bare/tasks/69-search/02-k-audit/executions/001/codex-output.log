     9	
    10	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    11	                | "Assign" "(" Expr "," Expr ")"
    12	                | "For" "(" Expr "," Expr "," Stmts ")"
    13	                | "If" "(" Expr "," Stmts "," Stmts ")"
    14	                | "Return" "(" Expr ")"
    15	
    16	  syntax Expr ::= "Int" "(" Int ")"
    17	                | "Name" "(" String ")"
    18	                | "UnaryOp" "(" String "," Expr ")"
    19	                | "Attribute" "(" Expr "," String ")"
    20	                | "Call" "(" Expr "," Exprs ")"
    21	                | "Compare" "(" Expr "," CmpOps ")"
    22	  syntax Exprs ::= List{Expr, ","}
    23	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    24	  syntax CmpOps ::= List{CmpOp, ","}
    25	endmodule
    26	
    27	module MPY
    28	  imports MPY-SYNTAX
    29	  imports INT
    30	  imports BOOL
    31	  imports MAP
    32	
    33	  // Values used by this task's executable Mini-Python semantics.
