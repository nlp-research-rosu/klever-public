new file mode 100644
index 0000000000000000000000000000000000000000..0cf93477cc81ddd1fb17705fdd3c5323574cf84b
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def search(lst):
+    answer = -1
+    for value in lst:
+        if lst.count(value) >= value:
+            if value > answer:
+                answer = value
+    return answer
