+                | "Call" "(" Expr "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
