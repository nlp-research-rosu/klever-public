+  syntax IntSeq ::= ".Ints"
+                  | "cons" "(" Int "," IntSeq ")"
+  syntax Value ::= "VInt" "(" Int ")"
+                 | "VBool" "(" Bool ")"
+                 | "VList" "(" IntSeq ")"
+  syntax Result ::= "noResult" | Value
