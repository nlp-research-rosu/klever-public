#!/usr/bin/env bash
set -euo pipefail

# Regenerate the constructor program from the unmodified translator.
python3 py2mpy.py solution.py > solution.mpy

# Build the executable semantics and exercise the empty edge case and every
# example from prompt.py.
kompile semantic.k --backend haskell --main-module MPY --syntax-module MPY-SYNTAX
krun solution.mpy -d semantic-kompiled -cINPUT='""' --output pretty
krun solution.mpy -d semantic-kompiled -cINPUT='"AB"' --output pretty
krun solution.mpy -d semantic-kompiled -cINPUT='"1077E"' --output pretty
krun solution.mpy -d semantic-kompiled -cINPUT='"ABED1A33"' --output pretty
krun solution.mpy -d semantic-kompiled -cINPUT='"123456789ABCDEF0"' --output pretty
krun solution.mpy -d semantic-kompiled -cINPUT='"2020"' --output pretty

# Compile the mathematical contract helper into the definition, then prove
# every claim in spec.k (one universal all-String functional-correctness claim).
kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX
kprove spec.k --definition verification-kompiled --spec-module HEX-KEY-SPEC
module MPY-SYNTAX
  imports STRING-SYNTAX

  // The source grammar is intentionally the executable py2mpy fragment used
  // by solution.mpy.  Every constructor below is emitted directly from the
  // corresponding CPython AST node; no source-level desugaring is assumed.
  syntax Program ::= "Module" "(" FunctionDef ")"
  syntax FunctionDef ::= "FuncDef" "(" String "," Params "," Stmt ")"
  syntax Params ::= "Params" "(" String ")"

  syntax Stmt ::= "Return" "(" Expr ")"

  syntax Expr ::= "Name"      "(" String ")"
                | "Str"       "(" String ")"
                | "BinOp"     "(" String "," Expr "," Expr ")"
                | "Attribute" "(" Expr "," String ")"
                | "Call"      "(" Expr "," Expr ")"
endmodule

module MPY
  imports MPY-SYNTAX
  imports INT
  imports STRING
  imports MAP

  syntax Val ::= strVal(String)
               | intVal(Int)
               | countMethod(String)
  syntax Result ::= "noResult" | Val
  syntax KItem ::= "#invoke" "(" String "," String ")"

  // A minimal environment-based expression semantics.  Attribute evaluation
  // binds Python's str.count method to its receiver; Call then applies it.
  syntax Val ::= eval(Expr, Map) [function]
  syntax String ::= asString(Val) [function]
  syntax String ::= countReceiver(Val) [function]
  syntax Int ::= asInt(Val) [function]

  rule eval(Name(X), X |-> V) => V
  rule eval(Str(S), _) => strVal(S)
  rule eval(Attribute(E, "count"), ENV)
    => countMethod(asString(eval(E, ENV)))
  rule eval(Call(F, A), ENV)
    => intVal(countAllOccurrences(countReceiver(eval(F, ENV)),
                                  asString(eval(A, ENV))))
  rule eval(BinOp("+", L, R), ENV)
    => intVal(asInt(eval(L, ENV)) +Int asInt(eval(R, ENV)))

  rule asString(strVal(S)) => S
  rule countReceiver(countMethod(S)) => S
  rule asInt(intVal(I)) => I

  configuration
    <hexKey>
      <k> $PGM:Program ~> #invoke("hex_key", $INPUT:String) </k>
      <env> .Map </env>
      <result> noResult </result>
    </hexKey>

  // Loading a one-argument definition and invoking it establishes its local
  // environment.  Return evaluates the expression and terminates the frame.
  rule <k> Module(FuncDef(F, Params(P), BODY)) ~> #invoke(F, ARG)
        => BODY </k>
       <env> .Map => P |-> strVal(ARG) </env>

  rule <k> Return(E) => .K </k>
       <env> ENV </env>
       <result> noResult => eval(E, ENV) </result>
endmodule
requires "semantic.k"

module VERIFICATION
  imports MPY

  // Independent mathematical contract for prime hexadecimal digits.  Since
  // each target is a distinct one-character string, summing the six counts is
  // exactly the number of characters in {2, 3, 5, 7, B, D}.
  syntax Int ::= primeHexCount(String) [function, total]
  rule primeHexCount(S) =>
       countAllOccurrences(S, "2")
    +Int countAllOccurrences(S, "3")
    +Int countAllOccurrences(S, "5")
    +Int countAllOccurrences(S, "7")
    +Int countAllOccurrences(S, "B")
    +Int countAllOccurrences(S, "D")
endmodule
requires "verification.k"

module HEX-KEY-SPEC
  imports VERIFICATION

  // Total functional correctness for every valid input (the prompt says every
  // input is an uppercase hexadecimal String or the empty String).  Proving a
  // stronger all-String statement is harmless and covers that precondition.
  claim
    <hexKey>
      <k>
        Module(
          FuncDef("hex_key", Params("num"),
            Return(
              BinOp("+",
                BinOp("+",
                  BinOp("+",
                    BinOp("+",
                      BinOp("+",
                        Call(Attribute(Name("num"), "count"), Str("2")),
                        Call(Attribute(Name("num"), "count"), Str("3"))),
                      Call(Attribute(Name("num"), "count"), Str("5"))),
                    Call(Attribute(Name("num"), "count"), Str("7"))),
                  Call(Attribute(Name("num"), "count"), Str("B"))),
                Call(Attribute(Name("num"), "count"), Str("D"))))))
        ~> #invoke("hex_key", S:String)
        => .K
      </k>
      <env> .Map => "num" |-> strVal(S) </env>
      <result> noResult => intVal(primeHexCount(S)) </result>
    </hexKey>
endmodule

