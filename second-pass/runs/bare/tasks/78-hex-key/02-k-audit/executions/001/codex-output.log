+  exit 64
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}"
+
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n--- OUTPUT ---\n'
+} > "$log_path"
+
+"$@" >> "$log_path" 2>&1
+command_status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT STATUS: %d\n' "$command_status"
+} >> "$log_path"
+
+cat "$log_path"
+exit "$command_status"

