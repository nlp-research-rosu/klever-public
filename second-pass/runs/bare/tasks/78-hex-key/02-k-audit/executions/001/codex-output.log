+  countAllOccurrences(S, "2")
+  + countAllOccurrences(S, "3")
+  + countAllOccurrences(S, "5")
+  + countAllOccurrences(S, "7")
+  + countAllOccurrences(S, "B")
+  + countAllOccurrences(S, "D")
