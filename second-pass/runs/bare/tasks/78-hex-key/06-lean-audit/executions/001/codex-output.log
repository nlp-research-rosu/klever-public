+    )
+    for label, document in (
+        ("input manifest", input_manifest),
+        ("generator provenance", generator_manifest["provenance"]),
+        ("export result", export_result),
+        ("recorded preflight", preflight),
+    ):
+        same(
+            f"{label} Stage 1 export hash",
+            document.get(
+                "frozen_input_sha256",
