codex
I found the precise sandbox defect: Lean 4.22 resolves its executable through `/proc/<getpid>/exe`, while this audit sandbox exposes the host PID in `/proc` but returns a nested PID from `getpid()`. I’m applying a narrow `LD_PRELOAD` shim that redirects only those `/proc/*/exe` `readlink` calls to `/proc/self/exe`; it does not touch generated sources, theorem data, or filesystem inputs. I’ll retain the shim source and its validation output as evidence.
apply patch
patch: completed
/audit-output/evidence/pinned-lake-wrapper
/audit-output/evidence/proc_exe_readlink_fix.c
diff --git a/evidence/pinned-lake-wrapper b/evidence/pinned-lake-wrapper
new file mode 100644
index 0000000000000000000000000000000000000000..92a58eaadfa995d788b7899ff74364daf2be0ffc
--- /dev/null
+++ b/evidence/pinned-lake-wrapper
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+toolchain=/opt/elan/toolchains/leanprover--lean4---v4.22.0
+export LAKE_HOME="$toolchain"
+export LEAN_SYSROOT="$toolchain"
+export LD_PRELOAD=/tmp/audit-work/proc_exe_readlink_fix.so
+exec "$toolchain/bin/lake" "$@"
diff --git a/evidence/proc_exe_readlink_fix.c b/evidence/proc_exe_readlink_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..cf4253aca27423d69ed4b9789c806bee553852b7
--- /dev/null
+++ b/evidence/proc_exe_readlink_fix.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t length;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    length = strlen(path);
+    return length > sizeof(prefix) + sizeof(suffix) - 2
+        && strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0;
+}
+
+ssize_t readlink(const char *restrict path,
+                 char *restrict buffer,
+                 size_t buffer_size) {
+    const char *resolved = is_proc_pid_exe(path) ? "/proc/self/exe" : path;
+    return syscall(SYS_readlinkat, AT_FDCWD, resolved, buffer, buffer_size);
+}
+
+ssize_t readlinkat(int directory_fd,
+                   const char *restrict path,
+                   char *restrict buffer,
+                   size_t buffer_size) {
+    if (is_proc_pid_exe(path)) {
+        directory_fd = AT_FDCWD;
+        path = "/proc/self/exe";
+    }
+    return syscall(SYS_readlinkat, directory_fd, path, buffer, buffer_size);
+}

