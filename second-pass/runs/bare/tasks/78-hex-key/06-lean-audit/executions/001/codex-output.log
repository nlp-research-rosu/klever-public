+echo "exit_code=$?"
+
+expect_failure() {
+  local spec=$1
+  local module=$2
+  local code
+
+  echo "COMMAND kprove $spec --definition verification-kompiled --spec-module $module"
+  set +e
+  kprove "$spec" \
