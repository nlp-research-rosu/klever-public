+        image_id.removeprefix("sha256:"),
+        results,
+    )
+
+    print(
+        json.dumps(
+            {
+                "status": "PASS",
+                "check_count": len(results),
+                "results": results,
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
