    12	krun solution.mpy -d semantic-kompiled -cINPUT='"1077E"' --output pretty
    13	krun solution.mpy -d semantic-kompiled -cINPUT='"ABED1A33"' --output pretty
    14	krun solution.mpy -d semantic-kompiled -cINPUT='"123456789ABCDEF0"' --output pretty
    15	krun solution.mpy -d semantic-kompiled -cINPUT='"2020"' --output pretty
    16	
    17	# Compile the mathematical contract helper into the definition, then prove
