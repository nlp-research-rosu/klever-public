     4	  // The source grammar is intentionally the executable py2mpy fragment used
     5	  // by solution.mpy.  Every constructor below is emitted directly from the
     6	  // corresponding CPython AST node; no source-level desugaring is assumed.
     7	  syntax Program ::= "Module" "(" FunctionDef ")"
     8	  syntax FunctionDef ::= "FuncDef" "(" String "," Params "," Stmt ")"
     9	  syntax Params ::= "Params" "(" String ")"
    10	
    11	  syntax Stmt ::= "Return" "(" Expr ")"
    12	
    13	  syntax Expr ::= "Name"      "(" String ")"
    14	                | "Str"       "(" String ")"
    15	                | "BinOp"     "(" String "," Expr "," Expr ")"
    16	                | "Attribute" "(" Expr "," String ")"
    17	                | "Call"      "(" Expr "," Expr ")"
    18	endmodule
    19	
    20	module MPY
    21	  imports MPY-SYNTAX
    22	  imports INT
    23	  imports STRING
    24	  imports MAP
    25	
    26	  syntax Val ::= strVal(String)
    27	               | intVal(Int)
    28	               | countMethod(String)
    29	  syntax Result ::= "noResult" | Val
    30	  syntax KItem ::= "#invoke" "(" String "," String ")"
    31	
    32	  // A minimal environment-based expression semantics.  Attribute evaluation
    33	  // binds Python's str.count method to its receiver; Call then applies it.
    34	  syntax Val ::= eval(Expr, Map) [function]
    35	  syntax String ::= asString(Val) [function]
    36	  syntax String ::= countReceiver(Val) [function]
    37	  syntax Int ::= asInt(Val) [function]
    38	
    39	  rule eval(Name(X), X |-> V) => V
    40	  rule eval(Str(S), _) => strVal(S)
    41	  rule eval(Attribute(E, "count"), ENV)
    42	    => countMethod(asString(eval(E, ENV)))
    43	  rule eval(Call(F, A), ENV)
    44	    => intVal(countAllOccurrences(countReceiver(eval(F, ENV)),
    45	                                  asString(eval(A, ENV))))
    46	  rule eval(BinOp("+", L, R), ENV)
    47	    => intVal(asInt(eval(L, ENV)) +Int asInt(eval(R, ENV)))
    48	
    49	  rule asString(strVal(S)) => S
    50	  rule countReceiver(countMethod(S)) => S
    51	  rule asInt(intVal(I)) => I
