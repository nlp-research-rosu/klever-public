     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Independent mathematical contract for prime hexadecimal digits.  Since
     7	  // each target is a distinct one-character string, summing the six counts is
     8	  // exactly the number of characters in {2, 3, 5, 7, B, D}.
     9	  syntax Int ::= primeHexCount(String) [function, total]
    10	  rule primeHexCount(S) =>
    11	       countAllOccurrences(S, "2")
    12	    +Int countAllOccurrences(S, "3")
    13	    +Int countAllOccurrences(S, "5")
    14	    +Int countAllOccurrences(S, "7")
    15	    +Int countAllOccurrences(S, "B")
    16	    +Int countAllOccurrences(S, "D")
    17	endmodule
