diff --git a//tmp/audit-work/app-path-probe.c b//tmp/audit-work/app-path-probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..3ec5e7eb1fee6523a3d9e5639220d1bc766481b2
--- /dev/null
+++ b//tmp/audit-work/app-path-probe.c
@@ -0,0 +1,17 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[PATH_MAX + 1];
+  ssize_t n = readlink("/proc/self/exe", path, PATH_MAX);
+  if (n < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  path[n] = '\0';
+  printf("%s\n", path);
+  return 0;
+}
