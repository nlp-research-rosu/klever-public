+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[PATH_MAX + 1];
+  ssize_t n = readlink("/proc/self/exe", path, PATH_MAX);
+  if (n < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  path[n] = '\0';
+  printf("%s\n", path);
+  return 0;
