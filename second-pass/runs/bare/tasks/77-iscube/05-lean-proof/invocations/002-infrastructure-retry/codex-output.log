diff --git a//tmp/lean-readlink-fix.c b//tmp/lean-readlink-fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..cebe8c093f153c9ad7f556421a88d6f95987e266
--- /dev/null
+++ b//tmp/lean-readlink-fix.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/*
+ * This runner places the process in a PID namespace but exposes a /proc mount
+ * from another namespace. Lean asks readlink("/proc/<getpid()>/exe", ...), so
+ * redirect precisely that lookup through /proc/self/exe, whose magic symlink
+ * is namespace-independent for the calling process.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  size_t length = strlen(path);
+  const char suffix[] = "/exe";
+
+  if (strncmp(path, "/proc/", 6) == 0 &&
+      length >= sizeof(suffix) - 1 &&
+      strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0) {
+    return syscall(SYS_readlinkat, AT_FDCWD, "/proc/self/exe", buffer, size);
+  }
+
+  return syscall(SYS_readlinkat, AT_FDCWD, path, buffer, size);
+}
