{
    "definitions": [
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 24,
            "module": "VERIFICATION",
            "normalized_sha256": "de3f9727c1b2c9f19559bcf49d9facf57997eb3c9d4715f670ff6644a77098f9",
            "rationale": "This structural abbreviation expands the named iscubeProgram proof term into the exact MPY constructor tree; it defines a named program representation rather than asserting an additional mathematical fact.",
            "source_rule_id": "rule-de3f9727c1b2c9f19559bcf49d9facf57997eb3c9d4715f670ff6644a77098f9",
            "start_line": 11,
            "text": "  rule iscubeProgram =>\n    Module(\n      FuncDef(\"iscube\", Params(\"a\"),\n        If(Compare(Name(\"a\"), CmpOp(\"<\", Int(0))),\n          Assign(Name(\"a\"), UnaryOp(\"-\", Name(\"a\"))),\n          .Stmts)\n        Assign(Name(\"n\"), Int(0))\n        While(Compare(\n          BinOp(\"*\", BinOp(\"*\", Name(\"n\"), Name(\"n\")), Name(\"n\")),\n          CmpOp(\"<\", Name(\"a\"))),\n          Assign(Name(\"n\"), BinOp(\"+\", Name(\"n\"), Int(1))))\n        Return(Compare(\n          BinOp(\"*\", BinOp(\"*\", Name(\"n\"), Name(\"n\")), Name(\"n\")),\n          CmpOp(\"==\", Name(\"a\"))))))"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 27,
            "module": "VERIFICATION",
            "normalized_sha256": "b88003e929c70fa00f8441eaf77e74ba66845261dacd5efbb19e5da9b5a59865",
            "rationale": "This equation defines the verification helper cube(I) to mean I *Int I *Int I.",
            "source_rule_id": "rule-b88003e929c70fa00f8441eaf77e74ba66845261dacd5efbb19e5da9b5a59865",
            "start_line": 27,
            "text": "  rule cube(I) => I *Int I *Int I"
        }
    ],
