            "inventory_sha256": "768c6d425e02156c7113c418107467c11510230db45758138d0307d7efd017c9",
            "module": "GAP-VERIFICATION",
            "normalized_sha256": "71fab8be3031badfbb8efe37c8587b786b455d6670cf74a013dbf65634d49027",
            "rationale": "This simplification rule supplies a nontrivial open-cube-gap arithmetic implication. Stage 1 compiles GAP-VERIFICATION with the rule already present before proving GAP-SPEC, so its exact statement is not separately proved against a module that omits it.",
            "source_rule_id": "rule-71fab8be3031badfbb8efe37c8587b786b455d6670cf74a013dbf65634d49027",
            "start_line": 36,
            "text": "  rule I <Int N +Int 1 => true\n    requires 0 <=Int I\n     andBool I <=Int N +Int 1\n     andBool 0 <=Int N\n     andBool 0 <Int D\n     andBool D <Int ((N +Int 1) *Int (N +Int 1) *Int (N +Int 1))\n                       -Int (N *Int N *Int N)\n     andBool (I *Int I *Int I) <Int (N *Int N *Int N) +Int D\n    [simplification]"
        },
        {
            "attributes": [
                "simplification"
            ],
            "classification": "DOMAIN_LEMMA",
            "discovery_manifest_sha256": "15dc8f8202c2f2bba0a6043e762654a6ecbc4ebdd979765a531e7635eb0888b3",
            "end_line": 54,
            "inventory_sha256": "768c6d425e02156c7113c418107467c11510230db45758138d0307d7efd017c9",
            "module": "GAP-VERIFICATION",
            "normalized_sha256": "5cd618327b17d41867b4a5cadea7277532d58e8066be05ee8bd76b5c99b6690f",
            "rationale": "This simplification rule supplies the nontrivial arithmetic fact that the stopped loop index equals N +Int 1 under the open-gap hypotheses. Stage 1 includes the rule in GAP-VERIFICATION before proving GAP-SPEC and provides no prior proof of this exact rule in a module without it.",
            "source_rule_id": "rule-5cd618327b17d41867b4a5cadea7277532d58e8066be05ee8bd76b5c99b6690f",
            "start_line": 46,
            "text": "  rule I ==Int N +Int 1 => true\n    requires 0 <=Int I\n     andBool I <=Int N +Int 1\n     andBool 0 <=Int N\n     andBool 0 <Int D\n     andBool D <Int ((N +Int 1) *Int (N +Int 1) *Int (N +Int 1))\n                       -Int (N *Int N *Int N)\n     andBool (I *Int I *Int I) >=Int (N *Int N *Int N) +Int D\n    [simplification]"
        }
    ],
