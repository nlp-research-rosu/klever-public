+  --backend llvm \
+  --main-module K-BRIDGE-AUDIT \
+  --syntax-module K-BRIDGE-AUDIT-SYNTAX \
+  --output-definition KBridgeAudit-kompiled
+krun --definition KBridgeAudit-kompiled --output pretty /dev/stdin <<'EOF'
+check(5,2)
+EOF
+krun --definition KBridgeAudit-kompiled --output pretty /dev/stdin <<'EOF'
+check(2,5)
+EOF
