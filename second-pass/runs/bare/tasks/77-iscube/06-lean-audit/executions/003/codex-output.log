diff --git a//tmp/audit-work/77-iscube-proof-audit/OperationalBridgeAudit.lean b//tmp/audit-work/77-iscube-proof-audit/OperationalBridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..7660e599aeaf6080721a0315d164dacbc43c7b73
--- /dev/null
+++ b//tmp/audit-work/77-iscube-proof-audit/OperationalBridgeAudit.lean
@@ -0,0 +1,98 @@
+import Proof
+
+namespace OperationalBridgeAudit
+
+-- Universal definitional comparisons with the intended Lean realizations of
+-- the frozen K hooks.
+example (x y : SortInt) : Proof.«_-Int_» x y = x - y := rfl
+example (x y : SortBool) : Proof._andBool_ x y = (x && y) := rfl
+example (x y : SortInt) : Proof.«_>=Int_» x y = decide (x >= y) := rfl
+example (x y : SortInt) : Proof.«_<Int_» x y = decide (x < y) := rfl
+example (x y : SortInt) : Proof.«_<=Int_» x y = decide (x <= y) := rfl
+example (x y : SortInt) : Proof.«_==Int_» x y = decide (x = y) := rfl
+example (x y : SortInt) : Proof.«_+Int_» x y = x + y := rfl
+example (x y : SortInt) : Proof.«_*Int_» x y = x * y := rfl
+
+-- Exhaustive Boolean witnesses.
+example : Proof._andBool_ false false = false := rfl
+example : Proof._andBool_ false true = false := rfl
+example : Proof._andBool_ true false = false := rfl
+example : Proof._andBool_ true true = true := rfl
+
+-- Deliberately convenient but wrong counterfactual implementations.
+def subIdentity (x _y : SortInt) : SortInt := x
+def andAsOr (x y : SortBool) : SortBool := x || y
+def geAsStrict (x y : SortInt) : SortBool := decide (x > y)
+def ltAsNonStrict (x y : SortInt) : SortBool := decide (x <= y)
+def leAsStrict (x y : SortInt) : SortBool := decide (x < y)
+def eqAlwaysTrue (_x _y : SortInt) : SortBool := true
+def addIdentity (x _y : SortInt) : SortInt := x
+def mulAsAdd (x y : SortInt) : SortInt := x + y
+
+example : subIdentity 5 2 ≠ Proof.«_-Int_» 5 2 := by decide
+example : andAsOr false true ≠ Proof._andBool_ false true := by decide
+example : geAsStrict 3 3 ≠ Proof.«_>=Int_» 3 3 := by decide
+example : ltAsNonStrict 3 3 ≠ Proof.«_<Int_» 3 3 := by decide
+example : leAsStrict 3 3 ≠ Proof.«_<=Int_» 3 3 := by decide
+example : eqAlwaysTrue 2 3 ≠ Proof.«_==Int_» 2 3 := by decide
+example : addIdentity 2 3 ≠ Proof.«_+Int_» 2 3 := by decide
+example : mulAsAdd 2 3 ≠ Proof.«_*Int_» 2 3 := by decide
+
+def premise1 (N I D : SortInt) : SortBool :=
+  Proof._andBool_
+    (Proof._andBool_
+      (Proof._andBool_
+        (Proof._andBool_
+          (Proof._andBool_
+            (Proof.«_<=Int_» 0 I)
+            (Proof.«_<=Int_» I (Proof.«_+Int_» N 1)))
+          (Proof.«_<=Int_» 0 N))
+        (Proof.«_<Int_» 0 D))
+      (Proof.«_<Int_» D
+        (Proof.«_-Int_»
+          (Proof.«_*Int_»
+            (Proof.«_*Int_» (Proof.«_+Int_» N 1) (Proof.«_+Int_» N 1))
+            (Proof.«_+Int_» N 1))
+          (Proof.«_*Int_» (Proof.«_*Int_» N N) N))))
+    (Proof.«_<Int_»
+      (Proof.«_*Int_» (Proof.«_*Int_» I I) I)
+      (Proof.«_+Int_» (Proof.«_*Int_» (Proof.«_*Int_» N N) N) D))
+
+def premise2 (N I D : SortInt) : SortBool :=
+  Proof._andBool_
+    (Proof._andBool_
+      (Proof._andBool_
+        (Proof._andBool_
+          (Proof._andBool_
+            (Proof.«_<=Int_» 0 I)
+            (Proof.«_<=Int_» I (Proof.«_+Int_» N 1)))
+          (Proof.«_<=Int_» 0 N))
+        (Proof.«_<Int_» 0 D))
+      (Proof.«_<Int_» D
+        (Proof.«_-Int_»
+          (Proof.«_*Int_»
+            (Proof.«_*Int_» (Proof.«_+Int_» N 1) (Proof.«_+Int_» N 1))
+            (Proof.«_+Int_» N 1))
+          (Proof.«_*Int_» (Proof.«_*Int_» N N) N))))
+    (Proof.«_>=Int_»
+      (Proof.«_*Int_» (Proof.«_*Int_» I I) I)
+      (Proof.«_+Int_» (Proof.«_*Int_» (Proof.«_*Int_» N N) N) D))
+
+-- Satisfiable premise witnesses and false strengthened/counterfactual
+-- conclusions.  Both generated conjuncts therefore discriminate.
+example : premise1 1 1 1 = true := by decide
+example : Proof.«_<Int_» 1 (Proof.«_+Int_» 1 1) = true := by decide
+example : Proof.«_<Int_» 1 1 = false := by decide
+example : premise2 1 2 1 = true := by decide
+example : Proof.«_==Int_» 2 (Proof.«_+Int_» 1 1) = true := by decide
+example : Proof.«_==Int_» 2 1 = false := by decide
+
+#eval s!"sub(5,2)={Proof.«_-Int_» 5 2}; sub(2,5)={Proof.«_-Int_» 2 5}; sub(-3,2)={Proof.«_-Int_» (-3) 2}"
+#eval s!"and truth table={Proof._andBool_ false false},{Proof._andBool_ false true},{Proof._andBool_ true false},{Proof._andBool_ true true}"
+#eval s!"cmp(-3,-3): ge={Proof.«_>=Int_» (-3) (-3)}, lt={Proof.«_<Int_» (-3) (-3)}, le={Proof.«_<=Int_» (-3) (-3)}, eq={Proof.«_==Int_» (-3) (-3)}"
+#eval s!"cmp(-3,2): ge={Proof.«_>=Int_» (-3) 2}, lt={Proof.«_<Int_» (-3) 2}, le={Proof.«_<=Int_» (-3) 2}, eq={Proof.«_==Int_» (-3) 2}"
+#eval s!"arith(-3,2): add={Proof.«_+Int_» (-3) 2}, mul={Proof.«_*Int_» (-3) 2}; large mul={Proof.«_*Int_» 1000000000000 (-3)}"
+#eval s!"rule1 N=1,I=1,D=1 premise={premise1 1 1 1}, conclusion={Proof.«_<Int_» 1 2}, strengthened-false={Proof.«_<Int_» 1 1}"
+#eval s!"rule2 N=1,I=2,D=1 premise={premise2 1 2 1}, conclusion={Proof.«_==Int_» 2 2}, counterfactual-false={Proof.«_==Int_» 2 1}"
+
+end OperationalBridgeAudit
