diff --git a//tmp/audit-work/KBridgeAudit.k b//tmp/audit-work/KBridgeAudit.k
new file mode 100644
index 0000000000000000000000000000000000000000..0a523f74981bfa807d66d4b554401c77d93d2da5
--- /dev/null
+++ b//tmp/audit-work/KBridgeAudit.k
@@ -0,0 +1,28 @@
+requires "domains.md"
+
+module K-BRIDGE-AUDIT-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+
+  syntax Exp ::= "check" "(" Int "," Int ")"
+               | "report" "(" Int "," Bool "," Bool "," Bool "," Bool "," Bool "," Int "," Int ")"
+endmodule
+
+module K-BRIDGE-AUDIT
+  imports K-BRIDGE-AUDIT-SYNTAX
+  imports INT
+  imports BOOL
+
+  configuration <k> $PGM:Exp </k>
+
+  rule check(X, Y) =>
+    report(
+      X -Int Y,
+      (X <Int 0) andBool (Y <Int 0),
+      X >=Int Y,
+      X <Int Y,
+      X <=Int Y,
+      X ==Int Y,
+      X +Int Y,
+      X *Int Y)
+endmodule
