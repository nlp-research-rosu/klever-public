     3	module CUBE-SPEC
     4	  imports VERIFICATION
     5	
     6	  // Inductive loop invariant when the normalized input is exactly N^3.
     7	  claim [cube-loop]:
     8	    <k>
     9	      While(Compare(
    10	        BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
    11	        CmpOp("<", Name("a"))),
    12	        Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
    13	      => .K
    14	      ...
    15	    </k>
    16	    <env>
    17	      "a" |-> IntVal(cube(N))
    18	      "n" |-> (IntVal(I) => IntVal(N))
    19	    </env>
    20	    requires 0 <=Int I andBool I <=Int N
    21	
    22	  // Every nonnegative cube is accepted by the translated program.
    23	  claim [nonnegative-cube]:
    24	    <k>
    25	      iscubeProgram ~> invoke(IntVal(cube(N))) => .K
    26	    </k>
    27	    <funs> .Map => ?_ </funs>
    28	    <env> .Map => ?_ </env>
    29	    <result> .K => BoolVal(true) ~> .K </result>
    30	    requires 0 <=Int N
    31	
    32	  // Negative cubes normalize to their positive magnitude and are accepted.
    33	  claim [negative-cube]:
    34	    <k>
    35	      iscubeProgram ~> invoke(IntVal(0 -Int cube(N))) => .K
    36	    </k>
    37	    <funs> .Map => ?_ </funs>
    38	    <env> .Map => ?_ </env>
    39	    <result> .K => BoolVal(true) ~> .K </result>
    40	    requires 0 <Int N
    41	endmodule
    42	
    43	module GAP-SPEC
    44	  imports GAP-VERIFICATION
    45	
    46	  // The loop stops at N+1 for an input strictly between N^3 and (N+1)^3.
    47	  claim [gap-loop]:
    48	    <k>
    49	      While(Compare(
    50	        BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
    51	        CmpOp("<", Name("a"))),
    52	        Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
    53	      => .K
    54	      ...
    55	    </k>
    56	    <env>
    57	      "a" |-> IntVal(cube(N) +Int D)
    58	      "n" |-> (IntVal(I) => IntVal(N +Int 1))
    59	    </env>
    60	    requires 0 <=Int I
    61	     andBool I <=Int N +Int 1
    62	     andBool 0 <=Int N
    63	     andBool 0 <Int D
    64	     andBool D <Int cube(N +Int 1) -Int cube(N)
    65	
    66	  // Every positive non-cube lies strictly between two consecutive cubes.
    67	  claim [positive-noncube]:
    68	    <k>
    69	      iscubeProgram ~> invoke(IntVal(cube(N) +Int D)) => .K
    70	    </k>
    71	    <funs> .Map => ?_ </funs>
    72	    <env> .Map => ?_ </env>
    73	    <result> .K => BoolVal(false) ~> .K </result>
    74	    requires 0 <=Int N
    75	     andBool 0 <Int D
    76	     andBool D <Int cube(N +Int 1) -Int cube(N)
    77	
    78	  // The corresponding negative non-cubes normalize to the same magnitude.
    79	  claim [negative-noncube]:
