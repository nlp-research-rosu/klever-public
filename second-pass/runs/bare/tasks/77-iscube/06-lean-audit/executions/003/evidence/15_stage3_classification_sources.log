    18	  local output
    19	  output="$(krun solution.mpy -cN="$input" --definition semantic-kompiled)"
    20	  rg -q "BoolVal \\( $expected \\)" <<<"$output"
    21	  printf 'krun iscube(%s) = %s\n' "$input" "$expected"
    22	}
