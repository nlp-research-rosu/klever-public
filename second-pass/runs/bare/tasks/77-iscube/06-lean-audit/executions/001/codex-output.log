new file mode 100644
index 0000000000000000000000000000000000000000..456317cb1d592433406004e29c74b9181165c3dc
--- /dev/null
+++ b//tmp/audit-work/77-iscube-proof-audit/BridgeAudit.lean
@@ -0,0 +1,122 @@
+import Proof
+
+namespace AuditBridge
+
+open Klean77Iscube.Lemmas
+
+/- Adversarial ground cases for every target parameter. -/
+#eval Proof.«_-Int_» 5 9
+#eval Proof._andBool_ true false
+#eval Proof._andBool_ true true
+#eval Proof.«_>=Int_» (-3) (-2)
+#eval Proof.«_>=Int_» (-2) (-3)
+#eval Proof.«_<Int_» (-3) (-2)
+#eval Proof.«_<Int_» (-2) (-3)
+#eval Proof.«_<=Int_» 4 4
+#eval Proof.«_<=Int_» 1 0
+#eval Proof.«_==Int_» (-7) (-7)
+#eval Proof.«_==Int_» (-7) 7
+#eval Proof.«_+Int_» 5 (-9)
+#eval Proof.«_*Int_» (-3) 4
+
+example : Proof.«_-Int_» 5 9 = (-4 : SortInt) := by decide
+example : Proof._andBool_ true false = false := by decide
+example : Proof._andBool_ true true = true := by decide
+example : Proof.«_>=Int_» (-3) (-2) = false := by decide
+example : Proof.«_>=Int_» (-2) (-3) = true := by decide
+example : Proof.«_<Int_» (-3) (-2) = true := by decide
+example : Proof.«_<Int_» (-2) (-3) = false := by decide
+example : Proof.«_<=Int_» 4 4 = true := by decide
+example : Proof.«_<=Int_» 1 0 = false := by decide
+example : Proof.«_==Int_» (-7) (-7) = true := by decide
+example : Proof.«_==Int_» (-7) 7 = false := by decide
+example : Proof.«_+Int_» 5 (-9) = (-4 : SortInt) := by decide
+example : Proof.«_*Int_» (-3) 4 = (-12 : SortInt) := by decide
+
+/- Independently satisfiable antecedents for both generated conjuncts. -/
+def firstGuard (N I D : SortInt) : SortBool :=
+  Proof._andBool_
+    (Proof._andBool_
+      (Proof._andBool_
+        (Proof._andBool_
+          (Proof._andBool_
+            (Proof.«_<=Int_» 0 I)
+            (Proof.«_<=Int_» I (Proof.«_+Int_» N 1)))
+          (Proof.«_<=Int_» 0 N))
+        (Proof.«_<Int_» 0 D))
+      (Proof.«_<Int_» D
+        (Proof.«_-Int_»
+          (Proof.«_*Int_»
+            (Proof.«_*Int_»
+              (Proof.«_+Int_» N 1)
+              (Proof.«_+Int_» N 1))
+            (Proof.«_+Int_» N 1))
+          (Proof.«_*Int_» (Proof.«_*Int_» N N) N))))
+    (Proof.«_<Int_»
+      (Proof.«_*Int_» (Proof.«_*Int_» I I) I)
+      (Proof.«_+Int_» (Proof.«_*Int_» (Proof.«_*Int_» N N) N) D))
+
+def secondGuard (N I D : SortInt) : SortBool :=
+  Proof._andBool_
+    (Proof._andBool_
+      (Proof._andBool_
+        (Proof._andBool_
+          (Proof._andBool_
+            (Proof.«_<=Int_» 0 I)
+            (Proof.«_<=Int_» I (Proof.«_+Int_» N 1)))
+          (Proof.«_<=Int_» 0 N))
+        (Proof.«_<Int_» 0 D))
+      (Proof.«_<Int_» D
+        (Proof.«_-Int_»
+          (Proof.«_*Int_»
+            (Proof.«_*Int_»
+              (Proof.«_+Int_» N 1)
+              (Proof.«_+Int_» N 1))
+            (Proof.«_+Int_» N 1))
+          (Proof.«_*Int_» (Proof.«_*Int_» N N) N))))
+    (Proof.«_>=Int_»
+      (Proof.«_*Int_» (Proof.«_*Int_» I I) I)
+      (Proof.«_+Int_» (Proof.«_*Int_» (Proof.«_*Int_» N N) N) D))
+
+#eval firstGuard 1 1 1
+#eval secondGuard 1 2 1
+
+example : firstGuard 1 1 1 = true := by decide
+example : Proof.«_<Int_» 1 (Proof.«_+Int_» 1 1) = true := by decide
+example : secondGuard 1 2 1 = true := by decide
+example : Proof.«_==Int_» 2 (Proof.«_+Int_» 1 1) = true := by decide
+
+/- Counterfactual meanings are separated by concrete operational witnesses. -/
+def badSub (x _y : SortInt) : SortInt := x
+def badAnd (_x _y : SortBool) : SortBool := false
+def badGe (_x _y : SortInt) : SortBool := true
+def badLt (_x _y : SortInt) : SortBool := false
+def badLe (_x _y : SortInt) : SortBool := true
+def badEq (_x _y : SortInt) : SortBool := true
+def badAdd (x _y : SortInt) : SortInt := x
+def badMul (x _y : SortInt) : SortInt := x
+
+example : badSub 5 9 ≠ Proof.«_-Int_» 5 9 := by decide
+example : badAnd true true ≠ Proof._andBool_ true true := by decide
+example : badGe (-3) (-2) ≠ Proof.«_>=Int_» (-3) (-2) := by decide
+example : badLt (-3) (-2) ≠ Proof.«_<Int_» (-3) (-2) := by decide
+example : badLe 1 0 ≠ Proof.«_<=Int_» 1 0 := by decide
+example : badEq (-7) 7 ≠ Proof.«_==Int_» (-7) 7 := by decide
+example : badAdd 5 (-9) ≠ Proof.«_+Int_» 5 (-9) := by decide
+example : badMul (-3) 4 ≠ Proof.«_*Int_» (-3) 4 := by decide
+
+/- The fixed target alone admits a vacuous bad conjunction interpretation.
+   This is why the operational bridge check is independently mandatory. -/
+theorem vacuousBadAnd :
+    targetStatement
+      Proof.«_-Int_»
+      badAnd
+      Proof.«_>=Int_»
+      Proof.«_<Int_»
+      Proof.«_<=Int_»
+      Proof.«_==Int_»
+      Proof.«_+Int_»
+      Proof.«_*Int_» := by
+  constructor <;> intro N I D h <;> simp [badAnd] at h
+
+end AuditBridge
diff --git a/evidence/readlink_self_shim.c b/evidence/readlink_self_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..a91f71cc834b2d94459ff18db2da98dc5df2aa01
--- /dev/null
+++ b/evidence/readlink_self_shim.c
@@ -0,0 +1,53 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+/*
+ * The audit sandbox denies Lean's /proc/<own-pid>/exe readlink. Preserve the
+ * real syscall everywhere, and use the current process invocation path only
+ * for that one failed self lookup.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    ssize_t result = syscall(SYS_readlink, path, buffer, size);
+    if (result >= 0) {
+        return result;
+    }
+
+    char expected[64];
+    int length = snprintf(
+        expected, sizeof(expected), "/proc/%ld/exe", (long)getpid()
+    );
+    if (
+        length <= 0
+        || (size_t)length >= sizeof(expected)
+        || strcmp(path, expected) != 0
+        || program_invocation_name == NULL
+    ) {
+        return result;
+    }
+
+    const char *invocation = program_invocation_name;
+    if (strcmp(invocation, "lean") == 0) {
+        invocation =
+            "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    } else if (strcmp(invocation, "lake") == 0) {
+        invocation =
+            "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lake";
+    }
+
+    size_t invocation_length = strlen(invocation);
+    if (invocation_length > size) {
+        invocation_length = size;
+    }
+    memcpy(buffer, invocation, invocation_length);
+    errno = 0;
+    return (ssize_t)invocation_length;
+}
