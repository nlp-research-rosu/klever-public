+        "omitted_from_manifest": sorted(inventory_id_set - manifest_id_set),
+        "extra_in_manifest": sorted(manifest_id_set - inventory_id_set),
+        "per_rule": per_rule_checks,
+    },
+}
+
+print(json.dumps(result, indent=2, sort_keys=True))
