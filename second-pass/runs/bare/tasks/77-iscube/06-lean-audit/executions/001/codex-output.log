   670	def tree_digest(root: Path) -> str:
   671	    digest = hashlib.sha256()
   672	    for relative, kind, path in _tree_entries(Path(root)):
   673	        digest.update(relative.encode() + b"\0" + kind.encode() + b"\0")
   674	        if kind == "file":
   675	            digest.update(path.read_bytes())
   676	    return digest.hexdigest()
