   647	def _tree_entries(root: Path) -> list[tuple[str, str, Path]]:
   648	    if not root.is_dir() or root.is_symlink():
   649	        raise KleanExportError(f"tree root must be a real directory: {root}")
   650	    entries: list[tuple[str, str, Path]] = []
   651	    pending = [root]
   652	    while pending:
   653	        directory = pending.pop()
   654	        for child in os.scandir(directory):
   655	            path = Path(child.path)
   656	            mode = child.stat(follow_symlinks=False).st_mode
   657	            relative = path.relative_to(root).as_posix()
   658	            if stat.S_ISDIR(mode):
   659	                entries.append((relative, "directory", path))
   660	                pending.append(path)
   661	            elif stat.S_ISREG(mode):
   662	                entries.append((relative, "file", path))
   663	            else:
   664	                raise KleanExportError(
   665	                    f"tree contains linked or unsupported entry: {path}"
   666	                )
   667	    return sorted(entries)
