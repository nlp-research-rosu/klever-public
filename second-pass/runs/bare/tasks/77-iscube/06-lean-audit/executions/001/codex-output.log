+        used & generated_allowlist
+    ),
+    "used_core_allowed_axioms": sorted(
+        used & {"Classical.choice", "propext", "Quot.sound"}
+    ),
+    "generated_trust_declaration_count": len(generated_allowlist),
+}
+print(json.dumps(result, indent=2, sort_keys=True))
