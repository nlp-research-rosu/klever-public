    82	    </k>
    83	    <funs> .Map => ?_ </funs>
    84	    <env> .Map => ?_ </env>
    85	    <result> .K => BoolVal(false) ~> .K </result>
    86	    requires 0 <=Int N
    87	     andBool 0 <Int D
    88	     andBool D <Int cube(N +Int 1) -Int cube(N)
    89	endmodule
     1	def iscube(a):
     2	    if a < 0:
     3	        a = -a
     4	    n = 0
     5	    while n * n * n < a:
     6	        n = n + 1
     7	    return n * n * n == a
