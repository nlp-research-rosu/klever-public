   411	                namespaces.pop()
   412	            continue
   413	        declaration = _LEAN_TRUST_DECL_RE.match(line)
   414	        if declaration is None:
   415	            continue
   416	        kind, name, signature = declaration.groups()
   417	        lean_type = signature.strip()
   418	        if lean_type.startswith(":"):
   419	            lean_type = lean_type[1:].strip()
   420	        qualified_name = ".".join((*namespaces, name))
   421	        declarations.append(
   422	            {
   423	                "name": qualified_name,
   424	                "declaration_name": name,
   425	                "kind": kind,
   426	                "type": lean_type,
   427	                "line": str(line_number),
   428	            }
   429	        )
   430	    return declarations
