+  Proof.«_<Int_» 4 (-3))
+#eval ("le-signed-boundaries",
+  Proof.«_<=Int_» (-4) (-3),
+  Proof.«_<=Int_» (-3) (-3),
+  Proof.«_<=Int_» 4 (-3))
+#eval ("eq-signed-boundaries",
+  Proof.«_==Int_» (-3) (-3),
+  Proof.«_==Int_» (-3) 3)
+#eval ("add-signed-zero",
+  Proof.«_+Int_» (-7) 5,
+  Proof.«_+Int_» (-7) 7,
+  Proof.«_+Int_» 7 (-5))
+#eval ("mul-signs-zero",
+  Proof.«_*Int_» (-7) 5,
