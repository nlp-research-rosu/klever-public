diff --git a//tmp/audit-work/proof-audit/BridgeAudit.lean b//tmp/audit-work/proof-audit/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..bd96410ea9fdc51e6a2a382b98e54e392f22f610
--- /dev/null
+++ b//tmp/audit-work/proof-audit/BridgeAudit.lean
@@ -0,0 +1,126 @@
+import Proof
+import Klean77Iscube.Func
+
+namespace BridgeAudit
+
+theorem sub_bridge (x y : SortInt) :
+    _root_.«_-Int_» x y = some (Proof.«_-Int_» x y) := by
+  rfl
+
+theorem and_bridge (x y : SortBool) :
+    _root_._andBool_ x y = some (Proof._andBool_ x y) := by
+  cases x <;> cases y <;> rfl
+
+theorem ge_bridge (x y : SortInt) :
+    _root_.«_>=Int_» x y = some (Proof.«_>=Int_» x y) := by
+  rfl
+
+theorem lt_bridge (x y : SortInt) :
+    _root_.«_<Int_» x y = some (Proof.«_<Int_» x y) := by
+  rfl
+
+theorem le_bridge (x y : SortInt) :
+    _root_.«_<=Int_» x y = some (Proof.«_<=Int_» x y) := by
+  rfl
+
+theorem eq_bridge (x y : SortInt) :
+    _root_.«_==Int_» x y = some (Proof.«_==Int_» x y) := by
+  rfl
+
+theorem add_bridge (x y : SortInt) :
+    _root_.«_+Int_» x y = some (Proof.«_+Int_» x y) := by
+  rfl
+
+theorem mul_bridge (x y : SortInt) :
+    _root_.«_*Int_» x y = some (Proof.«_*Int_» x y) := by
+  rfl
+
+def cube (x : SortInt) : SortInt :=
+  Proof.«_*Int_» (Proof.«_*Int_» x x) x
+
+def commonGuard (N I D : SortInt) : SortBool :=
+  Proof._andBool_
+    (Proof._andBool_
+      (Proof._andBool_
+        (Proof._andBool_
+          (Proof.«_<=Int_» 0 I)
+          (Proof.«_<=Int_» I (Proof.«_+Int_» N 1)))
+        (Proof.«_<=Int_» 0 N))
+      (Proof.«_<Int_» 0 D))
+    (Proof.«_<Int_» D
+      (Proof.«_-Int_» (cube (Proof.«_+Int_» N 1)) (cube N)))
+
+def firstGuard (N I D : SortInt) : SortBool :=
+  Proof._andBool_ (commonGuard N I D)
+    (Proof.«_<Int_» (cube I) (Proof.«_+Int_» (cube N) D))
+
+def secondGuard (N I D : SortInt) : SortBool :=
+  Proof._andBool_ (commonGuard N I D)
+    (Proof.«_>=Int_» (cube I) (Proof.«_+Int_» (cube N) D))
+
+#eval ("sub-negative", Proof.«_-Int_» (-7) 5)
+#eval ("sub-negative-rhs", Proof.«_-Int_» 7 (-5))
+#eval ("and-truth-table",
+  Proof._andBool_ false false,
+  Proof._andBool_ false true,
+  Proof._andBool_ true false,
+  Proof._andBool_ true true)
+#eval ("ge-signed-boundaries",
+  Proof.«_>=Int_» (-2) (-3),
+  Proof.«_>=Int_» (-3) (-3),
+  Proof.«_>=Int_» (-4) (-3))
+#eval ("lt-signed-boundaries",
+  Proof.«_<Int_» (-4) (-3),
+  Proof.«_<Int_» (-3) (-3),
+  Proof.«_<Int_» 4 (-3))
+#eval ("le-signed-boundaries",
+  Proof.«_<=Int_» (-4) (-3),
+  Proof.«_<=Int_» (-3) (-3),
+  Proof.«_<=Int_» 4 (-3))
+#eval ("eq-signed-boundaries",
+  Proof.«_==Int_» (-3) (-3),
+  Proof.«_==Int_» (-3) 3)
+#eval ("add-signed-zero",
+  Proof.«_+Int_» (-7) 5,
+  Proof.«_+Int_» (-7) 7,
+  Proof.«_+Int_» 7 (-5))
+#eval ("mul-signs-zero",
+  Proof.«_*Int_» (-7) 5,
+  Proof.«_*Int_» (-7) (-5),
+  Proof.«_*Int_» 7 0)
+#eval ("first-obligation-satisfiable",
+  firstGuard 1 1 1,
+  Proof.«_<Int_» 1 (Proof.«_+Int_» 1 1))
+#eval ("second-obligation-satisfiable",
+  secondGuard 1 2 1,
+  Proof.«_==Int_» 2 (Proof.«_+Int_» 1 1))
+
+end BridgeAudit
+
+namespace Counterfactual
+
+def badSub (_x _y : SortInt) : SortInt := 0
+def badAnd (_x _y : SortBool) : SortBool := false
+def badGe (_x _y : SortInt) : SortBool := false
+def badLt (_x _y : SortInt) : SortBool := false
+def badLe (_x _y : SortInt) : SortBool := false
+def badEq (_x _y : SortInt) : SortBool := false
+def badAdd (_x _y : SortInt) : SortInt := 0
+def badMul (_x _y : SortInt) : SortInt := 0
+
+theorem vacuousCounterfactual :
+    Klean77Iscube.Lemmas.targetStatement
+      badSub badAnd badGe badLt badLe badEq badAdd badMul := by
+  constructor <;> intro N I D h <;> simp [badAnd] at h
+
+#eval ("counterfactual-differs",
+  badSub (-7) 5,
+  badAnd true true,
+  badGe (-2) (-3),
+  badLt (-4) (-3),
+  badLe (-3) (-3),
+  badEq (-3) (-3),
+  badAdd (-7) 5,
+  badMul (-7) (-5))
+
+end Counterfactual
