    (jsonOutput : Bool := false)
    (errorOnKinds : Array Name := #[])
    (printStats : Bool := false)
    (run : Bool := false)
    : IO UInt32 := do
  if onlyDeps && depsJson then
    let fns ←
      if useStdin then
        (← IO.getStdin).lines
      else
        pure args.toArray
    printImportsJson fns
    return 0
  let (fileName?, args) :=
    match args with
  let out ← getStderr
  out.putStr <| toString s

/--
