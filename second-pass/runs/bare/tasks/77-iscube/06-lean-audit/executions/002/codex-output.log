diff --git a//tmp/audit-work/independent_checks.py b//tmp/audit-work/independent_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..00ff2fea5d7ca23e1a83abdebc4df10e29df1df6
--- /dev/null
+++ b//tmp/audit-work/independent_checks.py
@@ -0,0 +1,445 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+import os
+import re
+import stat
+from pathlib import Path
+
+AUDIT = json.loads(Path("/audit-input.json").read_text())
+RESOLUTION = AUDIT["resolution"]
+EXPECTED_HASHES = RESOLUTION["hashes"]
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha256_file(path: Path) -> str:
+    return sha256_bytes(path.read_bytes())
+
+
+def regular_tree_entries(root: Path):
+    entries = []
+    pending = [root]
+    while pending:
+        directory = pending.pop()
+        for child in os.scandir(directory):
+            path = Path(child.path)
+            mode = child.stat(follow_symlinks=False).st_mode
+            relative = path.relative_to(root).as_posix()
+            if stat.S_ISDIR(mode):
+                entries.append((relative, "directory", path))
+                pending.append(path)
+            elif stat.S_ISREG(mode):
+                entries.append((relative, "file", path))
+            else:
+                raise AssertionError(f"unsupported tree entry: {path}")
+    return sorted(entries)
+
+
+def pipeline_tree_digest(root: Path) -> str:
+    digest = hashlib.sha256()
+    for relative, kind, path in regular_tree_entries(root):
+        encoded = relative.encode()
+        digest.update(len(encoded).to_bytes(4, "big"))
+        digest.update(encoded)
+        digest.update(kind.encode() + b"\0")
+        if kind == "file":
+            data = path.read_bytes()
+            digest.update(len(data).to_bytes(8, "big"))
+            digest.update(data)
+    return digest.hexdigest()
+
+
+def export_tree_digest(root: Path) -> str:
+    digest = hashlib.sha256()
+    for relative, kind, path in regular_tree_entries(root):
+        digest.update(relative.encode() + b"\0" + kind.encode() + b"\0")
+        if kind == "file":
+            digest.update(path.read_bytes())
+    return digest.hexdigest()
+
+
+def check(label, observed, expected):
+    ok = observed == expected
+    print(f"{label}: {'OK' if ok else 'MISMATCH'}")
+    print(f"  observed={observed!r}")
+    print(f"  expected={expected!r}")
+    if not ok:
+        raise AssertionError(label)
+
+
+def canonical_json_sha256(document) -> str:
+    encoded = json.dumps(
+        document, sort_keys=True, separators=(",", ":"), ensure_ascii=False
+    ).encode()
+    return sha256_bytes(encoded)
+
+
+print("== Mounted provenance hashes ==")
+check(
+    "pipeline Stage 1 workspace tree",
+    pipeline_tree_digest(Path("/reference/k-proof")),
+    EXPECTED_HASHES["k_workspace_sha256"],
+)
+check(
+    "export Stage 1 workspace tree",
+    export_tree_digest(Path("/reference/k-proof")),
+    EXPECTED_HASHES["stage1_export_sha256"],
+)
+check(
+    "Stage 3 discovery manifest",
+    sha256_file(Path("/reference/lemma-discovery.json")),
+    EXPECTED_HASHES["discovery_manifest_sha256"],
+)
+check(
+    "Stage 2 K audit tree",
+    pipeline_tree_digest(Path("/reference/k-audit")),
+    EXPECTED_HASHES["k_audit_sha256"],
+)
+check(
+    "Stage 4 generation tree",
+    pipeline_tree_digest(Path("/reference/klean-generation")),
+    EXPECTED_HASHES["klean_generation_sha256"],
+)
+check(
+    "Stage 4 generated project tree",
+    export_tree_digest(Path("/reference/klean-generation/generated")),
+    EXPECTED_HASHES["generated_tree_sha256"],
+)
+check(
+    "Stage 5 candidate workspace tree",
+    pipeline_tree_digest(Path("/candidate")),
+    EXPECTED_HASHES["lean_workspace_sha256"],
+)
+check(
+    "selected Stage 2 artifact",
+    EXPECTED_HASHES["k_audit_sha256"],
+    RESOLUTION["selections"]["k_audit"]["artifact_sha256"],
+)
+check(
+    "selected Stage 4 artifact",
+    EXPECTED_HASHES["klean_generation_sha256"],
+    RESOLUTION["selections"]["klean_generation"]["artifact_sha256"],
+)
+check(
+    "Stage 5 result workspace",
+    EXPECTED_HASHES["lean_workspace_sha256"],
+    RESOLUTION["stage5_result"]["outputs"]["workspace_sha256"],
+)
+print(
+    "Lean invocation tree is launcher-recorded but not mounted for this audit: "
+    + EXPECTED_HASHES["lean_invocation_sha256"]
+)
+
+print("\n== Frozen Stage 1 source hashes ==")
+for relative, expected in sorted(RESOLUTION["stage1_source_hashes"].items()):
+    check(
+        relative,
+        sha256_file(Path("/reference/k-proof") / relative),
+        expected,
+    )
+
+print("\n== Independent local rule reconstruction ==")
+verification_path = Path("/reference/k-proof/verification.k")
+verification_bytes = verification_path.read_bytes()
+verification_text = verification_bytes.decode()
+lines = verification_text.splitlines()
+rule_specs = [
+    ("VERIFICATION", 11, 24, []),
+    ("VERIFICATION", 27, 27, []),
+    ("GAP-VERIFICATION", 36, 44, ["simplification"]),
+    ("GAP-VERIFICATION", 46, 54, ["simplification"]),
+]
+rules = []
+for module, start, end, attributes in rule_specs:
+    text = "\n".join(lines[start - 1 : end])
+    normalized_sha256 = sha256_bytes(" ".join(text.split()).encode())
+    rule = {
+        "source_rule_id": f"rule-{normalized_sha256}",
+        "module": module,
+        "start_line": start,
+        "end_line": end,
+        "normalized_sha256": normalized_sha256,
+        "attributes": attributes,
+        "text": text,
+    }
+    rules.append(rule)
+    print(
+        f"{module}:{start}-{end} {rule['source_rule_id']} "
+        f"attributes={attributes}"
+    )
+inventory_sha256 = canonical_json_sha256(rules)
+check("verification source SHA-256", sha256_bytes(verification_bytes), "c941d95f59a2ddb57298abbb42ad637dfc84c7753c2907462ce4ebc3cd966659")
+check("whole inventory SHA-256", inventory_sha256, "768c6d425e02156c7113c418107467c11510230db45758138d0307d7efd017c9")
+
+discovery_path = Path("/reference/lemma-discovery.json")
+discovery = json.loads(discovery_path.read_text())
+check("Stage 3 exact top-level keys", set(discovery), {"schema_version", "inventory_sha256", "rules"})
+check("Stage 3 schema", discovery["schema_version"], 2)
+check("Stage 3 inventory hash", discovery["inventory_sha256"], inventory_sha256)
+manifest_ids = [entry["source_rule_id"] for entry in discovery["rules"]]
+canonical_ids = [rule["source_rule_id"] for rule in rules]
+check("ordered rule identities", manifest_ids, canonical_ids)
+check("no duplicate manifest identities", len(set(manifest_ids)), len(manifest_ids))
+for index, (entry, rule) in enumerate(zip(discovery["rules"], rules)):
+    check(
+        f"Stage 3 rule {index} exact keys",
+        set(entry),
+        {"source_rule_id", "classification", "rationale"},
+    )
+    if not isinstance(entry["rationale"], str) or not entry["rationale"].strip():
+        raise AssertionError(f"empty rationale at Stage 3 rule {index}")
+    if "simplification" in rule["attributes"]:
+        if entry["classification"] not in {"DEFINITION", "DOMAIN_LEMMA"}:
+            raise AssertionError(f"bad simplification classification at {index}")
+print("Stage 3 manifest is an ordered bijection with the reconstructed inventory.")
+
+expected_classifications = [
+    "DEFINITION",
+    "DEFINITION",
+    "DOMAIN_LEMMA",
+    "DOMAIN_LEMMA",
+]
+check(
+    "independent classifications",
+    [entry["classification"] for entry in discovery["rules"]],
+    expected_classifications,
+)
+
+print("\n== Stage 4 source/obligation bijection and target ==")
+generation = Path("/reference/klean-generation")
+generated = generation / "generated"
+input_manifest = json.loads((generation / "input-manifest.json").read_text())
+generator_manifest = json.loads((generation / "generator-manifest.json").read_text())
+export_result = json.loads((generation / "export-result.json").read_text())
+preflight = json.loads((generation / "preflight.json").read_text())
+trust_inventory = json.loads((generation / "trust-inventory.json").read_text())
+obligation_map_path = generated / "obligation-map.json"
+obligation_map = json.loads(obligation_map_path.read_text())
+discovery_hash = sha256_file(discovery_path)
+domain_rules = []
+for rule, entry in zip(rules, discovery["rules"]):
+    if entry["classification"] == "DOMAIN_LEMMA":
+        domain_rules.append(
+            {
+                **rule,
+                **entry,
+                "inventory_sha256": inventory_sha256,
+                "discovery_manifest_sha256": discovery_hash,
+            }
+        )
+check("input manifest source rules", input_manifest["source_rules"], domain_rules)
+check("obligation map source rules", obligation_map["source_rules"], domain_rules)
+obligations = obligation_map["obligations"]
+check(
+    "obligation ordered identities",
+    [obligation["source_rule_id"] for obligation in obligations],
+    [rule["source_rule_id"] for rule in domain_rules],
+)
+check("obligation count", len(obligations), 2)
+check("no duplicate obligation identities", len({o["source_rule_id"] for o in obligations}), len(obligations))
+for obligation, source_rule in zip(obligations, domain_rules):
+    check(
+        f"{obligation['source_rule_id']} source span",
+        obligation["source_span"],
+        {
+            "start_line": source_rule["start_line"],
+            "end_line": source_rule["end_line"],
+        },
+    )
+    for key in ("normalized_sha256", "inventory_sha256", "discovery_manifest_sha256"):
+        check(
+            f"{obligation['source_rule_id']} {key}",
+            obligation[key],
+            source_rule[key],
+        )
+    check(
+        f"{obligation['source_rule_id']} Lean conjunct hash",
+        sha256_bytes(obligation["lean_conjunct"].encode()),
+        obligation["lean_conjunct_sha256"],
+    )
+    if "(h :" not in obligation["lean_conjunct"] or not obligation["lean_conjunct"].endswith("= true"):
+        raise AssertionError("obligation lost guarded rule shape")
+
+parameters = obligation_map["trust_parameters"]
+for parameter in parameters:
+    binding = {
+        "kore_symbol": parameter["kore_symbol"],
+        "name": parameter["name"],
+        "type": parameter["type"],
+        "source_rule_ids": parameter["source_rule_ids"],
+    }
+    check(
+        f"parameter binding {parameter['name']}",
+        parameter["binding_sha256"],
+        sha256_bytes(
+            json.dumps(binding, sort_keys=True, separators=(",", ":")).encode()
+        ),
+    )
+
+definition_lines = ["def targetStatement"]
+for parameter in parameters:
+    definition_lines.append(f"    ({parameter['name']} : {parameter['type']})")
+definition_lines.extend(
+    (
+        "    : Prop :=",
+        "    " + "\n    ∧ ".join(f"({o['lean_conjunct']})" for o in obligations),
+    )
+)
+expected_definition = "\n".join(definition_lines)
+lemmas_text = (generated / "Klean77Iscube/Lemmas.lean").read_text()
+match = re.search(
+    r"(?ms)^\s*def\s+targetStatement\b.*?(?=^\s*end\s+\S+\s*$)",
+    lemmas_text,
+)
+if match is None:
+    raise AssertionError("targetStatement not found")
