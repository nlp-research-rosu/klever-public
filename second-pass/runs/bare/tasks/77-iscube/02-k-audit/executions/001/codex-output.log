+
+  run kprove "$src/spec.k" \
+    --definition "$gapdef" \
+    --spec-module GAP-SPEC \
+    --exclude GAP-SPEC.negative-noncube
+
+  run kprove "$src/spec.k" \
+    --definition "$gapdef" \
+    --spec-module GAP-SPEC \
+    --exclude GAP-SPEC.positive-noncube
+fi
