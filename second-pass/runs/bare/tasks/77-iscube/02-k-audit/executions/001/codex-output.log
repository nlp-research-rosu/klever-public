+printf '\nOptional candidate artifacts:\n'
+for artifact in PROOF.md spec-vacuity.k; do
+  if [[ -e "/candidate/$artifact" ]]; then
+    run stat -c '%F %s bytes %n' "/candidate/$artifact"
+  else
+    printf '%s: absent\n' "$artifact"
+  fi
+done
