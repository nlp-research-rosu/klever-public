+  --syntax-module GAP-VERIFICATION \
+  --backend haskell \
+  --output-definition "$gapdef"
+gap_build_status=$?
+
+if (( gap_build_status == 0 )); then
+  run kprove "$src/spec.k" \
+    --definition "$gapdef" \
+    --spec-module GAP-SPEC
+
+  run kprove "$src/spec.k" \
