+      --definition "$cubedef" \
+      --spec-module CUBE-SPEC \
+      --claims "CUBE-SPEC.$label"
+  done
+fi
+
+run kompile "$src/verification.k" \
+  --main-module GAP-VERIFICATION \
+  --syntax-module GAP-VERIFICATION \
+  --backend haskell \
+  --output-definition "$gapdef"
+gap_build_status=$?
+
+if (( gap_build_status == 0 )); then
