+    --definition "$gapdef" \
+    --spec-module GAP-SPEC
+
+  for label in gap-loop positive-noncube negative-noncube; do
+    run kprove "$src/spec.k" \
+      --definition "$gapdef" \
+      --spec-module GAP-SPEC \
+      --claims "GAP-SPEC.$label"
+  done
+fi
