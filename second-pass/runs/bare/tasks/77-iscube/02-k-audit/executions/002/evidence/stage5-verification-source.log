COMMAND: nl -ba verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	  imports K-EQUAL
     6	  imports MAP-SYMBOLIC
     7	
     8	  // A compact name for exactly the constructor tree in solution.mpy.  The
     9	  // rule only abbreviates that tree; execution still uses the MPY rules.
    10	  syntax Pgm ::= "iscubeProgram"
    11	  rule iscubeProgram =>
    12	    Module(
    13	      FuncDef("iscube", Params("a"),
    14	        If(Compare(Name("a"), CmpOp("<", Int(0))),
    15	          Assign(Name("a"), UnaryOp("-", Name("a"))),
    16	          .Stmts)
    17	        Assign(Name("n"), Int(0))
    18	        While(Compare(
    19	          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
    20	          CmpOp("<", Name("a"))),
    21	          Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
    22	        Return(Compare(
    23	          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
    24	          CmpOp("==", Name("a"))))))
    25	
    26	  syntax Int ::= "cube" "(" Int ")" [function, total]
    27	  rule cube(I) => I *Int I *Int I
    28	endmodule
    29	
    30	module GAP-VERIFICATION
    31	  imports VERIFICATION
    32	
    33	  // Nonlinear integer arithmetic is incomplete in SMT solvers.  These two
    34	  // valid monotonic-cube lemmas supply exactly the missing induction facts for
    35	  // the open interval N^3 < A < (N+1)^3; they do not summarize the loop.
    36	  rule I <Int N +Int 1 => true
    37	    requires 0 <=Int I
    38	     andBool I <=Int N +Int 1
    39	     andBool 0 <=Int N
    40	     andBool 0 <Int D
    41	     andBool D <Int ((N +Int 1) *Int (N +Int 1) *Int (N +Int 1))
    42	                       -Int (N *Int N *Int N)
    43	     andBool (I *Int I *Int I) <Int (N *Int N *Int N) +Int D
    44	    [simplification]
    45	
    46	  rule I ==Int N +Int 1 => true
    47	    requires 0 <=Int I
    48	     andBool I <=Int N +Int 1
    49	     andBool 0 <=Int N
    50	     andBool 0 <Int D
    51	     andBool D <Int ((N +Int 1) *Int (N +Int 1) *Int (N +Int 1))
    52	                       -Int (N *Int N *Int N)
    53	     andBool (I *Int I *Int I) >=Int (N *Int N *Int N) +Int D
    54	    [simplification]
    55	endmodule
EXIT_STATUS: 0
