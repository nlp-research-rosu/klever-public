+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path="$1"
+shift
+
+: >"$log_path"
+printf 'COMMAND:' >>"$log_path"
+printf ' %q' "$@" >>"$log_path"
+printf '\n' >>"$log_path"
+
+set +e
+"$@" 2>&1 |
+  awk 'NR <= 800 { print; next } NR == 801 { print "[OUTPUT TRUNCATED AFTER 800 LINES]" }' |
+  tee -a "$log_path"
+command_status="${PIPESTATUS[0]}"
+set -e
+
+printf 'EXIT_STATUS: %s\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"

All seven audit stages completed. Fresh builds and all claims passed, constructor pinning and body sensitivity succeeded, static rules were sound, and the fresh false-result mutation failed as expected. REVIEW.md ends with the required verdict pair.
