diff --git a//tmp/audit-work/rebuild/body-mutant-verification.k b//tmp/audit-work/rebuild/body-mutant-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..829fd8b24225fa0ce8f8c244a5ea1c63c1fce0af
--- /dev/null
+++ b//tmp/audit-work/rebuild/body-mutant-verification.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module BODY-MUTANT-VERIFICATION
+  imports VERIFICATION
+
+  syntax Pgm ::= "iscubeProgramMutated"
+  rule iscubeProgramMutated =>
+    Module(
+      FuncDef("iscube", Params("a"),
+        If(Compare(Name("a"), CmpOp("<", Int(0))),
+          Assign(Name("a"), UnaryOp("-", Name("a"))),
+          .Stmts)
+        Assign(Name("n"), Int(0))
+        While(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("<", Name("a"))),
+          Assign(Name("n"), BinOp("+", Name("n"), Int(2))))
+        Return(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("==", Name("a"))))))
+endmodule
