COMMAND: krun solution.mpy -cN=2 --definition concrete-kompiled
<mpy>
  <k>
    .K
  </k>
  <funs>
    "iscube" |-> function ( "a" , If ( Compare ( Name ( "a" ) , CmpOp ( "<" , Int ( 0 ) ) ) , Assign ( Name ( "a" ) , UnaryOp ( "-" , Name ( "a" ) ) )  .Stmts , .Stmts )  Assign ( Name ( "n" ) , Int ( 0 ) )  While ( Compare ( BinOp ( "*" , BinOp ( "*" , Name ( "n" ) , Name ( "n" ) ) , Name ( "n" ) ) , CmpOp ( "<" , Name ( "a" ) ) ) , Assign ( Name ( "n" ) , BinOp ( "+" , Name ( "n" ) , Int ( 1 ) ) )  .Stmts )  Return ( Compare ( BinOp ( "*" , BinOp ( "*" , Name ( "n" ) , Name ( "n" ) ) , Name ( "n" ) ) , CmpOp ( "==" , Name ( "a" ) ) ) )  .Stmts )
  </funs>
  <env>
    "a" |-> IntVal ( 2 )
    "n" |-> IntVal ( 2 )
  </env>
  <result>
    BoolVal ( false ) ~> .K
  </result>
</mpy>
EXIT_STATUS: 0
