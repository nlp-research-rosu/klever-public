+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant for an exact nonnegative cube.  I is the current search
+  // index and N is the target root.
+  claim [cube-loop]:
+    <mpy>
+      <k>
+        While(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("<", Name("a"))),
+          Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+        ~> KREST
+      </k>
+      <funs> FUNS </funs>
+      <env>
+        "a" |-> IntVal(N *Int N *Int N)
+        "n" |-> IntVal(I)
+      </env>
+      <result> RESULT </result>
+    </mpy>
+  =>
+    <mpy>
+      <k> KREST </k>
+      <funs> FUNS </funs>
+      <env>
+        "a" |-> IntVal(N *Int N *Int N)
+        "n" |-> IntVal(N)
+      </env>
+      <result> RESULT </result>
+    </mpy>
+    requires 0 <=Int I andBool I <=Int N
+
+  claim [nonnegative-cube]:
+    <mpy>
+      <k> iscubeProgram ~> invoke(IntVal(N *Int N *Int N)) </k>
+      <funs> .Map </funs>
+      <env> .Map </env>
+      <result> .K </result>
+    </mpy>
+  =>
+    <mpy>
+      <k> .K </k>
+      <funs> ?FINALFUNS </funs>
+      <env> ?FINALENV </env>
+      <result> BoolVal(true) ~> .K </result>
+    </mpy>
+    requires 0 <=Int N
+endmodule
