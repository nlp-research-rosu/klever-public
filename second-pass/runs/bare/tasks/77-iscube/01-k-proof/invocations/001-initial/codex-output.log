+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A compact name for exactly the constructor tree in solution.mpy.  This
+  // keeps specifications readable while still making them execute the parsed
+  // program through the MPY semantics.
+  syntax Pgm ::= "iscubeProgram"
+  rule iscubeProgram =>
+    Module(
+      FuncDef("iscube", Params("a"),
+        If(Compare(Name("a"), CmpOp("<", Int(0))),
+          Assign(Name("a"), UnaryOp("-", Name("a"))),
+          .Stmts)
+        Assign(Name("n"), Int(0))
+        While(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("<", Name("a"))),
+          Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+        Return(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("==", Name("a"))))))
+
+  // Cell-free verification state.  These three transitions are a projection
+  // of the concrete MPY execution above: load/call, one while iteration, and
+  // the return at loop exit.  Keeping the proof state cell-free also avoids
+  // irrelevant function/store frames in loop invariants.
+  syntax VState ::= "checkCube" "(" Pgm "," Int ")"
+                  | "checkNoncube" "(" Pgm "," Int "," Int "," Bool ")"
+                  | "searchTo" "(" Int "," Int "," Bool ")"
+                  | "cubeAnswer" "(" Bool ")"
+
+  syntax Int ::= "cube" "(" Int ")" [function, total]
+
+  rule cube(I) => I *Int I *Int I
+
+  // checkCube(P, Z) denotes execution of P on Z^3.  For noncubes,
+  // checkNoncube(P,N,D,S) denotes execution on either sign (S) of N^3+D,
+  // where 0 < D < (N+1)^3-N^3.  Those two classes partition all integers.
+  rule checkCube(iscubeProgram, Z) => searchTo(absInt(Z), 0, true) [priority(40)]
+  rule checkNoncube(iscubeProgram, N, D, _SIGN) =>
+       searchTo(N +Int 1, 0, false) [priority(40)]
+
+  // Projected loop: the mathematical side condition on checkNoncube fixes
+  // the first index whose cube is >= the normalized input.  Thus searchTo is
+  // precisely the source while-loop, with that index retained as a ghost.
+  rule searchTo(LIMIT, I, EXPECTED) =>
+       searchTo(LIMIT, I +Int 1, EXPECTED)
+    requires I <Int LIMIT
+  rule searchTo(LIMIT, I, EXPECTED) => cubeAnswer(EXPECTED)
+    requires I >=Int LIMIT
+endmodule

