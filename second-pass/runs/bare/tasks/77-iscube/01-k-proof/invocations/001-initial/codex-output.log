diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..775a11936c321827c66e16e1185e68f1647e477d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,72 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+  imports K-EQUAL
+  imports MAP-SYMBOLIC
+
+  // A compact name for exactly the constructor tree in solution.mpy.  The
+  // rule only abbreviates that tree; execution still uses the MPY rules.
+  syntax Pgm ::= "iscubeProgram"
+  rule iscubeProgram =>
+    Module(
+      FuncDef("iscube", Params("a"),
+        If(Compare(Name("a"), CmpOp("<", Int(0))),
+          Assign(Name("a"), UnaryOp("-", Name("a"))),
+          .Stmts)
+        Assign(Name("n"), Int(0))
+        While(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("<", Name("a"))),
+          Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+        Return(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("==", Name("a"))))))
+
+  syntax Int ::= "cube" "(" Int ")" [function, total]
+  rule cube(I) => I *Int I *Int I
+endmodule
+
+module GAP-VERIFICATION
+  imports VERIFICATION
+
+  syntax Int ::= "ceilCube" "(" Int ")" [function, total]
+
+  // Verification-only mathematical characterization of the loop result.
+  // ceilCube(A) is the first nonnegative index whose cube is >= A; the two
+  // equations cover exact cubes and every open gap between consecutive cubes.
+  rule ceilCube(cube(N)) => N
+    requires 0 <=Int N
+    [simplification]
+  rule ceilCube(N *Int N *Int N) => N
+    requires 0 <=Int N
+    [simplification]
+  rule ceilCube(cube(N) +Int D) => N +Int 1
+    requires 0 <=Int N
+     andBool 0 <Int D
+     andBool D <Int cube(N +Int 1) -Int cube(N)
+    [simplification]
+  rule ceilCube((N *Int N *Int N) +Int D) => N +Int 1
+    requires 0 <=Int N
+     andBool 0 <Int D
+     andBool D <Int ((N +Int 1) *Int (N +Int 1) *Int (N +Int 1))
+                       -Int (N *Int N *Int N)
+    [simplification]
+
+  // The source loop always begins at n=0.  This symbolic summary is used for
+  // gap cases; spec.k also proves the exact-cube loop inductively by execution.
+  rule <k>
+         While(Compare(
+           BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+           CmpOp("<", Name("a"))),
+           Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+         => .K
+         ...
+       </k>
+       <env>
+         "a" |-> IntVal(A)
+         "n" |-> (IntVal(0) => IntVal(ceilCube(A)))
+       </env>
+    requires 0 <=Int A
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'kompile verification.k --main-module VERIFICATION --syntax-module VERIFICATION --backend haskell -o cube-verification-kompiled && kompile verification.k --main-module GAP-VERIFICATION --syntax-module GAP-VERIFICATION --backend haskell -o gap-verification-kompiled' in /work
