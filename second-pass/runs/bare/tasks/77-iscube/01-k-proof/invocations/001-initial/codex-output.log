diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..c931c6bc951613d2f5ccc68a170d842a767de097
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,102 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  // Statement lists are juxtaposed by py2mpy.py; the separator is empty.
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")" [strict(2)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [strict(2,3)]
+                | "Compare" "(" Expr "," CmpOp ")" [strict(1)]
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Return" "(" Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Value ::= "IntVal" "(" Int ")"
+                 | "BoolVal" "(" Bool ")"
+  syntax KResult ::= Value
+  syntax Expr ::= Value
+
+  syntax Function ::= "function" "(" String "," Stmts ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "invoke" "(" Value ")"
+                 | "assignTo" "(" String ")"
+                 | "ifKont" "(" Stmts "," Stmts ")"
+                 | "whileKont" "(" Expr "," Stmts ")"
+                 | "compareKont" "(" String "," Int ")"
+                 | "returnKont"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> invoke(IntVal($N:Int)) </k>
+      <funs> .Map </funs>
+      <env> .Map </env>
+      <result> .K </result>
+    </mpy>
+
+  // Module loading and the single-argument function call used by this task.
+  rule Module(STMTS) => exec(STMTS)
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt REST:Stmts) => S ~> exec(REST)
+
+  rule <k> FuncDef(F, Params(P), BODY) => .K ...</k>
+       <funs> .Map => F |-> function(P, BODY) </funs>
+
+  rule <k> invoke(IntVal(A)) => exec(BODY) ...</k>
+       <funs> ... "iscube" |-> function(P, BODY) ...</funs>
+       <env> .Map => P |-> IntVal(A) </env>
+
+  // Expression evaluation.  Strictness gives left-to-right evaluation for
+  // unary and binary operators; comparisons explicitly evaluate their RHS.
+  rule <k> Int(I) => IntVal(I) ...</k>
+  rule <k> Name(X) => V ...</k>
+       <env> ... X |-> V:Value ...</env>
+
+  rule UnaryOp("-", IntVal(I)) => IntVal(0 -Int I)
+  rule BinOp("+", IntVal(I), IntVal(J)) => IntVal(I +Int J)
+  rule BinOp("*", IntVal(I), IntVal(J)) => IntVal(I *Int J)
+
+  rule Compare(IntVal(I), CmpOp(OP, E)) => E ~> compareKont(OP, I)
+
+  rule IntVal(J) ~> compareKont("<", I) => BoolVal(I <Int J)
+  rule IntVal(J) ~> compareKont("==", I) => BoolVal(I ==Int J)
+
+  // Statements and control flow.
+  rule Assign(Name(X), E) => E ~> assignTo(X)
+  rule <k> V:Value ~> assignTo(X) => .K ...</k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule If(COND, THEN, ELSE) => COND ~> ifKont(THEN, ELSE)
+  rule BoolVal(true)  ~> ifKont(THEN, _ELSE) => exec(THEN)
+  rule BoolVal(false) ~> ifKont(_THEN, ELSE) => exec(ELSE)
+
+  rule While(COND, BODY) => COND ~> whileKont(COND, BODY)
+  rule BoolVal(true)  ~> whileKont(COND, BODY) => exec(BODY) ~> While(COND, BODY)
+  rule BoolVal(false) ~> whileKont(_COND, _BODY) => .K
+
+  rule Return(E) => E ~> returnKont
+  rule <k> V:Value ~> returnKont ~> _REST => .K </k>
+       <result> .K => V </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4ca51f9c02dc3ee971833c2c4192d826e6e304cd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def iscube(a):
+    if a < 0:
+        a = -a
+    n = 0
+    while n * n * n < a:
+        n = n + 1
+    return n * n * n == a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e18a807b53ca7d2e2570b257e16bfdff4925f520
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,85 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant when the normalized input is exactly N^3.
+  claim [cube-loop]:
+    <k>
+      While(Compare(
+        BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+        CmpOp("<", Name("a"))),
+        Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env>
+      "a" |-> IntVal(cube(N))
+      "n" |-> (IntVal(I) => IntVal(N))
+    </env>
+    requires 0 <=Int I andBool I <=Int N
+
+  // Every nonnegative cube is accepted by the translated program.
+  claim [nonnegative-cube]:
+    <k>
+      iscubeProgram ~> invoke(IntVal(cube(N))) => .K
+    </k>
+    <funs> .Map => ?_ </funs>
+    <env> .Map => ?_ </env>
+    <result> .K => BoolVal(true) ~> .K </result>
+    requires 0 <=Int N
+
+  // Loop invariant for an input strictly between N^3 and (N+1)^3.
+  claim [gap-loop]:
+    <k>
+      While(Compare(
+        BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+        CmpOp("<", Name("a"))),
+        Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env>
+      "a" |-> IntVal(cube(N) +Int D)
+      "n" |-> (IntVal(I) => IntVal(N +Int 1))
+    </env>
+    requires 0 <=Int I
+     andBool I <=Int N
+     andBool 0 <=Int N
+     andBool 0 <Int D
+     andBool D <Int cube(N +Int 1) -Int cube(N)
+
+  // Negative cubes normalize to their positive magnitude and are accepted.
+  claim [negative-cube]:
+    <k>
+      iscubeProgram ~> invoke(IntVal(0 -Int cube(N))) => .K
+    </k>
+    <funs> .Map => ?_ </funs>
+    <env> .Map => ?_ </env>
+    <result> .K => BoolVal(true) ~> .K </result>
+    requires 0 <Int N
+
+  // Every positive non-cube lies strictly between two consecutive cubes.
+  claim [positive-noncube]:
+    <k>
+      iscubeProgram ~> invoke(IntVal(cube(N) +Int D)) => .K
+    </k>
+    <funs> .Map => ?_ </funs>
+    <env> .Map => ?_ </env>
+    <result> .K => BoolVal(false) ~> .K </result>
+    requires 0 <=Int N
+     andBool 0 <Int D
+     andBool D <Int cube(N +Int 1) -Int cube(N)
+
+  // The corresponding negative non-cubes normalize to the same magnitude.
+  claim [negative-noncube]:
+    <k>
+      iscubeProgram ~> invoke(IntVal(0 -Int (cube(N) +Int D))) => .K
+    </k>
+    <funs> .Map => ?_ </funs>
+    <env> .Map => ?_ </env>
+    <result> .K => BoolVal(false) ~> .K </result>
+    requires 0 <=Int N
+     andBool 0 <Int D
+     andBool D <Int cube(N +Int 1) -Int cube(N)
+endmodule
