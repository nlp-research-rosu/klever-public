+                 | "invoke" "(" Value ")"
+                 | "assignTo" "(" String ")"
+                 | "ifKont" "(" Stmts "," Stmts ")"
+                 | "whileKont" "(" Expr "," Stmts ")"
+                 | "compareKont" "(" String "," Int ")"
+                 | "returnKont"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> invoke(IntVal($N:Int)) </k>
+      <funs> .Map </funs>
+      <env> .Map </env>
+      <result> .K </result>
+    </mpy>
