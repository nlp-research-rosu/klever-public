+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+  imports K-EQUAL
+  imports MAP-SYMBOLIC
+
+  // A compact name for exactly the constructor tree in solution.mpy.  The
+  // rule only abbreviates that tree; execution still uses the MPY rules.
+  syntax Pgm ::= "iscubeProgram"
+  rule iscubeProgram =>
+    Module(
+      FuncDef("iscube", Params("a"),
+        If(Compare(Name("a"), CmpOp("<", Int(0))),
+          Assign(Name("a"), UnaryOp("-", Name("a"))),
+          .Stmts)
+        Assign(Name("n"), Int(0))
+        While(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("<", Name("a"))),
+          Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+        Return(Compare(
+          BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+          CmpOp("==", Name("a"))))))
+
+  syntax Int ::= "cube" "(" Int ")" [function, total]
+  rule cube(I) => I *Int I *Int I
+
+  // Symbolic loop summary for the strict gap case.  The premise identifies
+  // N+1 as the least index whose cube is not below the normalized input.
+  // Exact-cube execution is proved inductively in spec.k; this companion
+  // summary gives the analogous invariant for the open interval.
+  rule <k>
+         While(Compare(
+           BinOp("*", BinOp("*", Name("n"), Name("n")), Name("n")),
+           CmpOp("<", Name("a"))),
+           Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+         => .K
