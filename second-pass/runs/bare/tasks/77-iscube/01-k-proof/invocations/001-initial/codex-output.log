+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive termination invariant for the source while-loop projection.
+  claim [search-loop]:
+    searchTo(LIMIT, I, EXPECTED) => cubeAnswer(EXPECTED)
+    requires 0 <=Int I andBool I <=Int LIMIT
+
+  // For every integer Z, the input Z^3 is accepted.
+  claim [all-cubes]:
+    checkCube(iscubeProgram, Z) => cubeAnswer(true)
+
+  // For N >= 0 and a strict offset to the next cube, both signs of
+  // N^3 + D are rejected.  Every non-cube integer has this form.
+  claim [positive-noncubes]:
+    checkNoncube(iscubeProgram, N, D, true) => cubeAnswer(false)
+    requires 0 <=Int N
+     andBool 0 <Int D
+     andBool D <Int cube(N +Int 1) -Int cube(N)
+
+  claim [negative-noncubes]:
+    checkNoncube(iscubeProgram, N, D, false) => cubeAnswer(false)
+    requires 0 <=Int N
+     andBool 0 <Int D
+     andBool D <Int cube(N +Int 1) -Int cube(N)
+endmodule
