+          CmpOp("<", Name("a"))),
+          Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
+        ~> KREST
+      </k>
+      <funs> FUNS </funs>
+      <env>
+        "a" |-> IntVal(N *Int N *Int N)
+        "n" |-> IntVal(I)
+      </env>
+      <result> RESULT </result>
