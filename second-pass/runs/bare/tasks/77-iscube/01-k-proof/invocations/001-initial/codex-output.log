+    </k>
+    <funs> .Map => ?_ </funs>
+    <env> .Map => ?_ </env>
+    <result> .K => BoolVal(false) ~> .K </result>
+    requires 0 <=Int N
+     andBool 0 <Int D
+     andBool D <Int cube(N +Int 1) -Int cube(N)
+endmodule
