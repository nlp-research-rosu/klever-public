    66	    <env> .Map => ?_ </env>
    67	    <result> .K => BoolVal(false) ~> .K </result>
    68	    requires 0 <=Int N
    69	     andBool 0 <Int D
    70	     andBool D <Int cube(N +Int 1) -Int cube(N)
    71	
    72	  // The corresponding negative non-cubes normalize to the same magnitude.
    73	  claim [negative-noncube]:
    74	    <k>
    75	      iscubeProgram ~> invoke(IntVal(0 -Int (cube(N) +Int D))) => .K
    76	    </k>
    77	    <funs> .Map => ?_ </funs>
    78	    <env> .Map => ?_ </env>
    79	    <result> .K => BoolVal(false) ~> .K </result>
    80	    requires 0 <=Int N
    81	     andBool 0 <Int D
    82	     andBool D <Int cube(N +Int 1) -Int cube(N)
