new file mode 100644
index 0000000000000000000000000000000000000000..4ca51f9c02dc3ee971833c2c4192d826e6e304cd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def iscube(a):
+    if a < 0:
+        a = -a
+    n = 0
+    while n * n * n < a:
+        n = n + 1
+    return n * n * n == a
