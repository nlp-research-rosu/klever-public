+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Value ::= "IntVal" "(" Int ")"
+                 | "BoolVal" "(" Bool ")"
+  syntax KResult ::= Value
+  syntax Expr ::= Value
+
+  syntax Function ::= "function" "(" String "," Stmts ")"
+
