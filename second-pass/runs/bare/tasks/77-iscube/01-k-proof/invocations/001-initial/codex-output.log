+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant for an exact nonnegative cube.
+  claim [cube-loop]:
+    searchCube(cube(N), I) => cubeAnswer(true)
+    requires 0 <=Int I andBool I <=Int N
+
+  // Every nonnegative integer cube is accepted.
+  claim [nonnegative-cube]:
+    verify(iscubeProgram, cube(N)) => cubeAnswer(true)
+    requires 0 <=Int N
+
+  // Every negative integer cube is accepted as well.
+  claim [negative-cube]:
+    verify(iscubeProgram, 0 -Int cube(N)) => cubeAnswer(true)
+    requires 0 <Int N
+endmodule
