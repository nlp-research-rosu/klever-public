diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..073129a96b044922e9426871418e7ce9611e2530
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd -- "$(dirname -- "$0")"
+
+# Translate the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Build and exercise the concrete semantics on every example in prompt.py.
+kompile semantic.k \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm
+
+check_krun() {
+  local input="$1"
+  local expected="$2"
+  local output
+  output="$(krun solution.mpy -cN="$input" --definition semantic-kompiled)"
+  rg -q "BoolVal \\( $expected \\)" <<<"$output"
+  printf 'krun iscube(%s) = %s\n' "$input" "$expected"
+}
+
+check_krun 1 true
+check_krun 2 false
+check_krun -1 true
+check_krun 64 true
+check_krun 0 true
+check_krun 180 false
+
+# Exact cubes: prove the small-step loop invariant and both input signs.
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --backend haskell \
+  -o cube-verification-kompiled
+kprove spec.k \
+  --definition cube-verification-kompiled \
+  --spec-module CUBE-SPEC
+
+# Non-cubes: prove the open-interval loop invariant and both input signs.
+kompile verification.k \
+  --main-module GAP-VERIFICATION \
+  --syntax-module GAP-VERIFICATION \
+  --backend haskell \
+  -o gap-verification-kompiled
+kprove spec.k \
+  --definition gap-verification-kompiled \
+  --spec-module GAP-SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..c931c6bc951613d2f5ccc68a170d842a767de097
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,102 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  // Statement lists are juxtaposed by py2mpy.py; the separator is empty.
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")" [strict(2)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [strict(2,3)]
+                | "Compare" "(" Expr "," CmpOp ")" [strict(1)]
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Return" "(" Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Value ::= "IntVal" "(" Int ")"
+                 | "BoolVal" "(" Bool ")"
+  syntax KResult ::= Value
+  syntax Expr ::= Value
+
+  syntax Function ::= "function" "(" String "," Stmts ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "invoke" "(" Value ")"
+                 | "assignTo" "(" String ")"
+                 | "ifKont" "(" Stmts "," Stmts ")"
+                 | "whileKont" "(" Expr "," Stmts ")"
+                 | "compareKont" "(" String "," Int ")"
+                 | "returnKont"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> invoke(IntVal($N:Int)) </k>
+      <funs> .Map </funs>
+      <env> .Map </env>
+      <result> .K </result>
+    </mpy>
+
+  // Module loading and the single-argument function call used by this task.
+  rule Module(STMTS) => exec(STMTS)
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt REST:Stmts) => S ~> exec(REST)
+
+  rule <k> FuncDef(F, Params(P), BODY) => .K ...</k>
+       <funs> .Map => F |-> function(P, BODY) </funs>
+
+  rule <k> invoke(IntVal(A)) => exec(BODY) ...</k>
+       <funs> ... "iscube" |-> function(P, BODY) ...</funs>
+       <env> .Map => P |-> IntVal(A) </env>
+
+  // Expression evaluation.  Strictness gives left-to-right evaluation for
+  // unary and binary operators; comparisons explicitly evaluate their RHS.
+  rule <k> Int(I) => IntVal(I) ...</k>
+  rule <k> Name(X) => V ...</k>
+       <env> ... X |-> V:Value ...</env>
+
+  rule UnaryOp("-", IntVal(I)) => IntVal(0 -Int I)
+  rule BinOp("+", IntVal(I), IntVal(J)) => IntVal(I +Int J)
+  rule BinOp("*", IntVal(I), IntVal(J)) => IntVal(I *Int J)
+
+  rule Compare(IntVal(I), CmpOp(OP, E)) => E ~> compareKont(OP, I)
+
+  rule IntVal(J) ~> compareKont("<", I) => BoolVal(I <Int J)
+  rule IntVal(J) ~> compareKont("==", I) => BoolVal(I ==Int J)
+
+  // Statements and control flow.
+  rule Assign(Name(X), E) => E ~> assignTo(X)
+  rule <k> V:Value ~> assignTo(X) => .K ...</k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule If(COND, THEN, ELSE) => COND ~> ifKont(THEN, ELSE)
+  rule BoolVal(true)  ~> ifKont(THEN, _ELSE) => exec(THEN)
+  rule BoolVal(false) ~> ifKont(_THEN, ELSE) => exec(ELSE)
+
+  rule While(COND, BODY) => COND ~> whileKont(COND, BODY)
+  rule BoolVal(true)  ~> whileKont(COND, BODY) => exec(BODY) ~> While(COND, BODY)
+  rule BoolVal(false) ~> whileKont(_COND, _BODY) => .K
+
+  rule Return(E) => E ~> returnKont
+  rule <k> V:Value ~> returnKont ~> _REST => .K </k>
+       <result> .K => V </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4ca51f9c02dc3ee971833c2c4192d826e6e304cd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def iscube(a):
+    if a < 0:
+        a = -a
+    n = 0
+    while n * n * n < a:
+        n = n + 1
+    return n * n * n == a
