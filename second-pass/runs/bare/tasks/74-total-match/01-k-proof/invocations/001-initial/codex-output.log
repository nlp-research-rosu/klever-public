diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..0f15e0636a2f855e55483d6b728f0f7bf3ac8351
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,104 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmt ")"
+
+  syntax Params ::= "Params" "(" String "," String ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Expr "," Expr ")"
+                | "IfExp" "(" Expr "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+
+  // Runtime values for the Python subset used by solution.py.
+  syntax PyString ::= "pyStr" "(" String ")"
+  syntax StrVals ::= ".StrVals"
+                   | PyString "::" StrVals
+  syntax IntVals ::= ".IntVals"
+                   | IntVal "::" IntVals
+  syntax IntVal ::= "pyInt" "(" Int ")"
+  syntax Value ::= PyString
+                 | IntVal
+                 | "pyList" "(" StrVals ")"
+                 | "pyInts" "(" IntVals ")"
+                 | "pyBool" "(" Bool ")"
+                 | "builtin" "(" String ")"
+
+  syntax Args ::= "args" "(" Value "," Value ")"
+  syntax Env ::= "env" "(" Value "," Value ")"
+
+  // Pure evaluator functions.  The source program has no side effects, so
+  // its expression semantics can be given compositionally.
+  syntax Value ::= eval(Expr, Env) [function]
+                 | apply1(Value, Value) [function]
+                 | apply2(Value, Value, Value) [function]
+                 | lessEqual(Value, Value) [function]
+                 | ifValue(Value, Value, Value) [function]
+  syntax IntVals ::= mapLengths(StrVals) [function]
+  syntax Int ::= sumInts(IntVals) [function]
+
+  rule eval(Name("lst1"), env(V1, V2)) => V1
+  rule eval(Name("lst2"), env(V1, V2)) => V2
+  rule eval(Name("len"),  ENV) => builtin("len")
+  rule eval(Name("map"),  ENV) => builtin("map")
+  rule eval(Name("sum"),  ENV) => builtin("sum")
+
+  rule eval(Call(F, A), ENV)
+    => apply1(eval(F, ENV), eval(A, ENV))
+  rule eval(Call(F, A, B), ENV)
+    => apply2(eval(F, ENV), eval(A, ENV), eval(B, ENV))
+  rule eval(Compare(L, CmpOp("<=", R)), ENV)
+    => lessEqual(eval(L, ENV), eval(R, ENV))
+  rule eval(IfExp(COND, THEN, ELSE), ENV)
+    => ifValue(eval(COND, ENV), eval(THEN, ENV), eval(ELSE, ENV))
+
+  rule apply1(builtin("len"), pyStr(S)) => pyInt(lengthString(S))
+  rule apply1(builtin("sum"), pyInts(IS)) => pyInt(sumInts(IS))
+  rule apply2(builtin("map"), builtin("len"), pyList(SS))
+    => pyInts(mapLengths(SS))
+
+  rule mapLengths(.StrVals) => .IntVals
+  rule mapLengths(pyStr(S) :: REST)
+    => pyInt(lengthString(S)) :: mapLengths(REST)
+
+  rule sumInts(.IntVals) => 0
+  rule sumInts(pyInt(I) :: REST) => I +Int sumInts(REST)
+
+  rule lessEqual(pyInt(I), pyInt(J)) => pyBool(true)
+    requires I <=Int J
+  rule lessEqual(pyInt(I), pyInt(J)) => pyBool(false)
+    requires I >Int J
+  rule ifValue(pyBool(true),  THEN, _ELSE) => THEN
+  rule ifValue(pyBool(false), _THEN, ELSE) => ELSE
+
+  // A module is executed by invoking its translated two-argument function.
+  syntax KItem ::= run(Program, Args)
+  rule run(
+         Module(FuncDef("total_match", Params("lst1", "lst2"), Return(BODY))),
+         args(V1, V2))
+    => eval(BODY, env(V1, V2))
+
+  configuration <k> run($PGM:Program, $ARGS:Args) </k>
+endmodule
+
+module SEMANTIC-SYNTAX
+  imports MPY-SYNTAX
+  imports SEMANTIC
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..004ed507020435755795bc79d116d971980fb85a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def total_match(lst1, lst2):
+    return lst1 if sum(map(len, lst1)) <= sum(map(len, lst2)) else lst2
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f5092687ff27607bdced95d9188d94ce7717a2b2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // sum(map(len, ...)) is precisely the sum of every string's length.
+  claim <k> totalChars(.StrVals) => 0 </k>
+
+  claim <k>
+          totalChars(pyStr(S) :: REST)
+        => lengthString(S) +Int totalChars(REST)
+        </k>
+
+  // If the first total is no greater, total_match returns the first list.
+  claim <k>
+          run(solutionProgram,
+              args(pyList(LIST1), pyList(LIST2)))
+        => pyList(LIST1)
+        </k>
+    requires totalChars(LIST1) <=Int totalChars(LIST2)
+
+  // If the second total is strictly smaller, it is returned.
+  claim <k>
+          run(solutionProgram,
+              args(pyList(LIST1), pyList(LIST2)))
+        => pyList(LIST2)
+        </k>
+    requires totalChars(LIST1) >Int totalChars(LIST2)
+
+  // The tie behavior from the natural-language contract is explicit.
+  claim <k>
+          run(solutionProgram,
+              args(pyList(LIST1), pyList(LIST2)))
+        => pyList(LIST1)
+        </k>
+    requires totalChars(LIST1) ==Int totalChars(LIST2)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..85d5e030669c70669c79b71c92a04207b27421ff
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // The exact AST emitted into solution.mpy, named for readable claims.
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("total_match", Params("lst1", "lst2"),
+        Return(
+          IfExp(
+            Compare(
+              Call(Name("sum"), Call(Name("map"), Name("len"), Name("lst1"))),
+              CmpOp("<=",
+                Call(Name("sum"), Call(Name("map"), Name("len"), Name("lst2"))))),
+            Name("lst1"),
+            Name("lst2")))))
+
+  // Mathematical character-count measure used by the contract.
+  syntax Int ::= totalChars(StrVals) [function]
+  rule totalChars(SS) => sumInts(mapLengths(SS))
+endmodule

exec
/bin/bash -lc 'kprove spec.k -d verification-kompiled' in /work
