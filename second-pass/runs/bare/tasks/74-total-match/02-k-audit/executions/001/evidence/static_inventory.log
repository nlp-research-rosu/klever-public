     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // The exact AST emitted into solution.mpy, named for readable claims.
     7	  syntax Program ::= "solutionProgram" [macro]
     8	  rule solutionProgram =>
     9	    Module(
    10	      FuncDef("total_match", Params("lst1", "lst2"),
    11	        Return(
    12	          IfExp(
    13	            Compare(
    14	              Call(Name("sum"), Call(Name("map"), Name("len"), Name("lst1"))),
    15	              CmpOp("<=",
    16	                Call(Name("sum"), Call(Name("map"), Name("len"), Name("lst2"))))),
    17	            Name("lst1"),
    18	            Name("lst2")))))
    19	
    20	  // Mathematical character-count measure used by the contract.
    21	  syntax Int ::= totalChars(StrVals) [function]
