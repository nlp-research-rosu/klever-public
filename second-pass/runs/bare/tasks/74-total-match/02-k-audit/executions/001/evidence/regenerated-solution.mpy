Module(
  FuncDef("total_match", Params("lst1", "lst2"),
    Return(
      IfExp(
        Compare(
          Call(
            Name("sum"),
            Call(Name("map"), Name("len"), Name("lst1"))),
          CmpOp(
            "<=",
            Call(
              Name("sum"),
              Call(Name("map"), Name("len"), Name("lst2"))))),
        Name("lst1"),
        Name("lst2")))))
