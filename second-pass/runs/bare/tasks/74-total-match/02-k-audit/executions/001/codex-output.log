n+                 | ifValue(Value, Value, Value) [function]\n+  syntax IntVals ::= mapLengths(StrVals) [function]\n+  syntax Int ::= sumInts(IntVals) [function]\n+\n+  rule eval(Name(\"lst1\"), env(V1, V2)) => V1\n+  rule eval(Name(\"lst2\"), env(V1, V2)) => V2\n+  rule eval(Name(\"len\"),  ENV) => builtin(\"len\")\n+  rule eval(Name(\"map\"),  ENV) => builtin(\"map\")\n+  rule eval(Name(\"sum\"),  ENV) => builtin(\"sum\")\n+\n+  rule eval(Call(F, A), ENV)\n+    => apply1(eval(F, ENV), eval(A, ENV))\n+  rule eval(Call(F, A, B), ENV)\n+    => apply2(eval(F, ENV), eval(A, ENV), eval(B, ENV))\n+  rule eval(Compare(L, CmpOp(\"<=\", R)), ENV)\n+    => lessEqual(eval(L, ENV), eval(R, ENV))\n+  rule eval(IfExp(COND, THEN, ELSE), ENV)\n+    => ifValue(eval(COND, ENV), eval(THEN, ENV), eval(ELSE, ENV))\n+\n+  rule apply1(builtin(\"len\"), pyStr(S)) => pyInt(lengthString(S))\n+  rule apply1(builtin(\"sum\"), pyInts(IS)) => pyInt(sumInts(IS))\n+  rule apply2(builtin(\"map\"), builtin(\"len\"), pyList(SS))\n+    => pyInts(mapLengths(SS))\n+\n+  rule mapLengths(.StrVals) => .IntVals\n+  rule mapLengths(pyStr(S) :: REST)\n+    => pyInt(lengthString(S)) :: mapLengths(REST)\n+\n+  rule sumInts(.IntVals) => 0\n+  rule sumInts(pyInt(I) :: REST) => I +Int sumInts(REST)\n+\n+  rule lessEqual(pyInt(I), pyInt(J)) => pyBool(I <=Int J)\n+  rule ifValue(pyBool(true),  THEN, ELSE) => THEN\n+  rule ifValue(pyBool(false), THEN, ELSE) => ELSE\n+\n+  // A module is executed by invoking its translated two-argument function.\n+  syntax KItem ::= run(Program, Args)\n+  rule run(\n+         Module(FuncDef(\"total_match\", Params(\"lst1\", \"lst2\"), Return(BODY))),\n+         args(V1, V2))\n+    => eval(BODY, env(V1, V2))\n+\n+  configuration <k> run($PGM:Program, $ARGS:Args) </k>\n+endmodule\n+\n+module SEMANTIC-SYNTAX\n+  imports MPY-SYNTAX\n+  imports SEMANTIC\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports SEMANTIC\n+\n+  // The exact AST emitted into solution.mpy, named for readable claims.\n+  syntax Program ::= \"solutionProgram\" [macro]\n+  rule solutionProgram =>\n+    Module(\n+      FuncDef(\"total_match\", Params(\"lst1\", \"lst2\"),\n+        Return(\n+          IfExp(\n+            Compare(\n+              Call(Name(\"sum\"), Call(Name(\"map\"), Name(\"len\"), Name(\"lst1\"))),\n+              CmpOp(\"<=\",\n+                Call(Name(\"sum\"), Call(Name(\"map\"), Name(\"len\"), Name(\"lst2\"))))),\n+            Name(\"lst1\"),\n+            Name(\"lst2\")))))\n+\n+  // Mathematical character-count measure used by the contract.\n+  syntax Int ::= totalChars(StrVals) [function]\n+  rule totalChars(SS) => sumInts(mapLengths(SS))\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // sum(map(len, ...)) is precisely the sum of every string's length.\n+  claim totalChars(.StrVals) => 0\n+\n+  claim totalChars(pyStr(S) :: REST)\n+      => lengthString(S) +Int totalChars(REST)\n+\n+  // If the first total is no greater, total_match returns the first list.\n+  claim <k>\n+          run(solutionProgram,\n+              args(pyList(LIST1), pyList(LIST2)))\n+        => pyList(LIST1)\n+        </k>\n+    requires totalChars(LIST1) <=Int totalChars(LIST2)\n+\n+  // If the second total is strictly smaller, it is returned.\n+  claim <k>\n+          run(solutionProgram,\n+              args(pyList(LIST1), pyList(LIST2)))\n+        => pyList(LIST2)\n+        </k>\n+    requires totalChars(LIST1) >Int totalChars(LIST2)\n+\n+  // The tie behavior from the natural-language contract is explicit.\n+  claim <k>\n+          run(solutionProgram,\n+              args(pyList(LIST1), pyList(LIST2)))\n+        => pyList(LIST1)\n+        </k>\n+    requires totalChars(LIST1) ==Int totalChars(LIST2)\n+endmodule\n*** End Patch";
