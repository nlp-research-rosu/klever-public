+#!/usr/bin/env bash
+set -uo pipefail
+
+for source in \
+  /tmp/audit-work/src/solution.mpy \
+  /tmp/audit-work/src/semantic.k \
+  /tmp/audit-work/src/verification.k \
+  /tmp/audit-work/src/spec.k
+do
+  echo "SOURCE: $source"
+  nl -ba "$source"
+done
+
+echo "DECLARATION/RULE ATTRIBUTE SEARCH"
+rg -n \
+  'syntax|rule|claim|configuration|function|functional|total|opaque|priority|simplification|macro' \
+  /tmp/audit-work/src/semantic.k \
+  /tmp/audit-work/src/verification.k \
+  /tmp/audit-work/src/spec.k
diff --git a/evidence/unicode_bridge_witness.sh b/evidence/unicode_bridge_witness.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ece3c939a8335f415cd4ad2c4e9535c6ae4d91df
--- /dev/null
+++ b/evidence/unicode_bridge_witness.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+echo "Python executions for lst1=['🙂'], lst2=['ab']"
+python3 - <<'PY'
+import importlib.util
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.total_match
+
+canonical = load("/tmp/audit-work/reference/canonical.py", "unicode_canonical")
+generated = load("/tmp/audit-work/src/solution.py", "unicode_generated")
+left = ["🙂"]
+right = ["ab"]
+print("lengths:", sum(map(len, left)), sum(map(len, right)))
+print("canonical:", canonical(left, right))
+print("generated:", generated(left, right))
+PY
+
+k_args='args(pyList(pyStr("\U0001f642") :: .StrVals),pyList(pyStr("ab") :: .StrVals))'
+
+echo "Fresh LLVM semantics execution"
