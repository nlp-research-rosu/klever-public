+  'syntax|rule|claim|configuration|function|functional|total|opaque|priority|simplification|macro' \
+  /tmp/audit-work/src/semantic.k \
+  /tmp/audit-work/src/verification.k \
+  /tmp/audit-work/src/spec.k

exec
/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/stage6_vacuity_dry_run.log kprove spec-vacuity-audit.k --definition /tmp/audit-work/build/verification-kompiled --spec-module SPEC-VACUITY-AUDIT --dry-run --output none
