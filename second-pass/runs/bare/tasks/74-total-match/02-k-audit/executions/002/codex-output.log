/bin/bash -lc "python3 - <<'PY'
import hashlib,json,itertools,os,stat
from pathlib import Path
targets={'/candidate':'26ea8ec3f6a07be9444c048e84874460418d4186ea99e1e6330830df104ff690','/generation-evidence/codex-trace':'e259223294fd3a1d5c1a3920ede2f5ebfe1e2bbe46d8e4545e1d75db6ed5d506'}

def data(root,dirs):
 R=Path(root); out=[]
 for p in sorted(R.rglob('*')):
  typ='directory' if p.is_dir() else 'file'
  if typ=='directory' and not dirs: continue
  rel=p.relative_to(R).as_posix(); row={'path':rel,'type':typ,'size':p.stat().st_size,'mode':stat.S_IMODE(p.stat().st_mode)}
  if typ=='file': row['sha256']=hashlib.sha256(p.read_bytes()).hexdigest()
  out.append(row)
 return out

serializers=[]
for sort in [False,True]:
 for sep in [None,(',',':'),(', ',': ')]:
  for indent in [None,2]:
   serializers.append((sort,sep,indent))

fieldsets=[('path','sha256'),('path','type','sha256'),('path','size','sha256'),('path','type','size','sha256'),('path','mode','sha256'),('path','type','mode','size','sha256')]
for dirs,shape,fields,(sort,sep,indent),newline in itertools.product([False,True],['listdict','listtuple','dictsha','dicttype'],fieldsets,serializers,[False,True]):
 ok=True
 for root,target in targets.items():
  rows=data(root,dirs)
  if shape=='listdict': obj=[{k:r[k] for k in fields if k in r} for r in rows]
  elif shape=='listtuple': obj=[[r[k] for k in fields if k in r] for r in rows]
  elif shape=='dictsha': obj={r['path']:r.get('sha256') for r in rows}
  else: obj={r['path']:{k:r[k] for k in fields if k"'!='"'path' and k in r} for r in rows}
  s=json.dumps(obj,sort_keys=sort,separators=sep,indent=indent)
  if newline:s+='\\n'
  if hashlib.sha256(s.encode()).hexdigest()"'!=target:ok=False;break
 if ok: print('"'MATCH',dirs,shape,fields,sort,sep,indent,newline);break
else: print('no json match')
PY" in /audit-output
