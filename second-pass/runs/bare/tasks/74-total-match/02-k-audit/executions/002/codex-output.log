+cases = [
+    ([], []),
+    (["hi", "admin"], ["hI", "Hi"]),
+    ([""], ["a"]),
+    (["ab"], ["c"]),
+    (["", "ab"], ["a", "b"]),
+    (["é"], ["e\u0301"]),
