+  printf '\n'
+  "$@"
+  local rc=$?
+  printf 'EXIT: %d\n' "$rc"
+  return "$rc"
+}
+
+run kprove "$work/spec.k" \
+  --definition "$definition" \
+  --spec-module SPEC || exit $?
+
