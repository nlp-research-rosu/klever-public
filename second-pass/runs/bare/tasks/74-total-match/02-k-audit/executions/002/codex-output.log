+printf '%s\n' 'COMMAND: python3 /tmp/audit-work/reference/py2mpy.py /tmp/audit-work/candidate/solution.py > /tmp/audit-work/candidate/regenerated.mpy'
+python3 /tmp/audit-work/reference/py2mpy.py \
