--- /dev/null
+++ b//tmp/audit-work/candidate/spec-labeled.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [total-empty]:
+    <k> totalChars(.StrVals) => 0 </k>
+
+  claim [total-step]:
+    <k>
+      totalChars(pyStr(S) :: REST)
+      => lengthString(S) +Int totalChars(REST)
+    </k>
+
+  claim [first-le]:
+    <k>
+      run(solutionProgram, args(pyList(LIST1), pyList(LIST2)))
+      => pyList(LIST1)
+    </k>
+    requires totalChars(LIST1) <=Int totalChars(LIST2)
+
+  claim [second-lt]:
+    <k>
+      run(solutionProgram, args(pyList(LIST1), pyList(LIST2)))
+      => pyList(LIST2)
+    </k>
+    requires totalChars(LIST1) >Int totalChars(LIST2)
+
+  claim [tie-first]:
+    <k>
+      run(solutionProgram, args(pyList(LIST1), pyList(LIST2)))
+      => pyList(LIST1)
+    </k>
+    requires totalChars(LIST1) ==Int totalChars(LIST2)
+endmodule
diff --git a//tmp/audit-work/candidate/verification-body-mut.k b//tmp/audit-work/candidate/verification-body-mut.k
new file mode 100644
index 0000000000000000000000000000000000000000..a0f38569ee55198183e3878bf6e30252d3548969
--- /dev/null
+++ b//tmp/audit-work/candidate/verification-body-mut.k
@@ -0,0 +1,22 @@
+requires "semantic.k"
+
+module VERIFICATION-BODY-MUT
+  imports SEMANTIC
+
+  // Material body mutation: swap the conditional's returned branches.
+  syntax Program ::= "mutatedSolutionProgram" [macro]
+  rule mutatedSolutionProgram =>
+    Module(
+      FuncDef("total_match", Params("lst1", "lst2"),
+        Return(
+          IfExp(
+            Compare(
+              Call(Name("sum"), Call(Name("map"), Name("len"), Name("lst1"))),
+              CmpOp("<=",
+                Call(Name("sum"), Call(Name("map"), Name("len"), Name("lst2"))))),
+            Name("lst2"),
+            Name("lst1")))))
+
+  syntax Int ::= totalCharsMut(StrVals) [function]
+  rule totalCharsMut(SS) => sumInts(mapLengths(SS))
+endmodule
diff --git a/evidence/body_sensitivity.sh b/evidence/body_sensitivity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..77a4df9b3ea6ecaa811d8ee98d7828ec0f4c69b9
--- /dev/null
+++ b/evidence/body_sensitivity.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+set -u
+export PATH="/home/agent/.nix-profile/bin:$PATH"
+work=/tmp/audit-work/candidate
+definition="$work/verification-body-mut-kompiled"
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local rc=$?
+  printf 'EXIT: %d\n' "$rc"
+  return "$rc"
+}
+
+run test ! -e "$definition" || exit $?
+run kompile "$work/verification-body-mut.k" \
+  --backend haskell \
+  --main-module VERIFICATION-BODY-MUT \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$definition" || exit $?
+printf '%s\n' 'SATISFYING WITNESS: LIST1 = pyStr("") :: .StrVals; LIST2 = pyStr("a") :: .StrVals; totals 0 < 1.'
+run kprove "$work/spec-body-mut.k" \
+  --definition "$definition" \
+  --spec-module SPEC-BODY-MUT \
+  --claims SPEC-BODY-MUT.mutated-first-lt
+proof_rc=$?
+if [[ "$proof_rc" -eq 0 ]]; then
+  printf '%s\n' 'UNEXPECTED: body-mutated false claim closed'
+  exit 1
+fi
+printf '%s\n' 'EXPECTED_BODY_SENSITIVITY_FAILURE'
