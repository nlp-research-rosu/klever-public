@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local rc=$?
+  printf 'EXIT: %d\n' "$rc"
+  return 0
+}
+
+run rg -n '^[[:space:]]*(requires|module|endmodule|imports|syntax|rule|configuration|claim)' \
