diff --git a//tmp/audit-work/candidate/spec-labeled.k b//tmp/audit-work/candidate/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..57ea44ed84214cba1c1e7ce146ec134300ab89a4
--- /dev/null
+++ b//tmp/audit-work/candidate/spec-labeled.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [total-empty]:
+    <k> totalChars(.StrVals) => 0 </k>
+
+  claim [total-step]:
+    <k>
+      totalChars(pyStr(S) :: REST)
+      => lengthString(S) +Int totalChars(REST)
+    </k>
+
+  claim [first-le]:
+    <k>
+      run(solutionProgram, args(pyList(LIST1), pyList(LIST2)))
+      => pyList(LIST1)
+    </k>
+    requires totalChars(LIST1) <=Int totalChars(LIST2)
+
+  claim [second-lt]:
+    <k>
+      run(solutionProgram, args(pyList(LIST1), pyList(LIST2)))
+      => pyList(LIST2)
+    </k>
+    requires totalChars(LIST1) >Int totalChars(LIST2)
+
+  claim [tie-first]:
+    <k>
+      run(solutionProgram, args(pyList(LIST1), pyList(LIST2)))
+      => pyList(LIST1)
+    </k>
+    requires totalChars(LIST1) ==Int totalChars(LIST2)
+endmodule
