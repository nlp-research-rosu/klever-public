+definition="$work/verification-audit-kompiled"
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local rc=$?
+  printf 'EXIT: %d\n' "$rc"
