+  --definition "$definition" \
+  --spec-module SPEC-VACUITY-AUDIT \
+  --claims SPEC-VACUITY-AUDIT.false-first-result
+proof_rc=$?
+if [[ "$proof_rc" -eq 0 ]]; then
+  printf '%s\n' 'UNEXPECTED: false result mutation closed'
