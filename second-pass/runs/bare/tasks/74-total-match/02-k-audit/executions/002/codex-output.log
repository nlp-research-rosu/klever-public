import os,stat,hashlib,itertools
from pathlib import Path

targets={'/candidate':'26ea8ec3f6a07be9444c048e84874460418d4186ea99e1e6330830df104ff690','/generation-evidence/codex-trace':'e259223294fd3a1d5c1a3920ede2f5ebfe1e2bbe46d8e4545e1d75db6ed5d506'}

def entries(root, dirs):
    R=Path(root); xs=[]
    for p in sorted(R.rglob('*')):
      if p.is_symlink(): typ='symlink'
      elif p.is_dir(): typ='dir'
      elif p.is_file(): typ='file'
      else: typ='other'
      if typ=='dir' and not dirs: continue
      xs.append((p.relative_to(R).as_posix(),typ,p))
    return xs

def item(kind, p):
    if kind=='none': return b''
    if kind=='raw': return p.read_bytes()
    d=hashlib.sha256(p.read_bytes()).digest()
    if kind=='hex': return d.hex().encode()
    if kind=='bin': return d
    if kind=='size': return str(p.stat().st_size).encode()
    if kind=='size8': return p.stat().st_size.to_bytes(8,'big')

seps=[b'',b'\\0',b'\\n',b' ',b':']
types=[('none',lambda t:b''),('word',lambda t:t.encode()),('char',lambda t:{'file':b'f','dir':b'd'}[t])]
for dirs,content_kind,pathprefix,typeinfo,sep1,sep2,endrecord in itertools.product([False,True],['raw','hex','bin','size','size8'],[False,True],types,seps,seps,seps):
  ok=True
  for root,target in targets.items():
    h=hashlib.sha256()
    for rel,typ,p in entries(root,dirs):
      path=('/'+rel if pathprefix else rel).encode()
      h.update(path); h.update(sep1); h.update(typeinfo[1](typ)); h.update(sep2)
      if typ=='file': h.update(item(content_kind,p))
      h.update(endrecord)
    if h.hexdigest()"'!=target: ok=False; break
  if ok:
    print('"'MATCH',dirs,content_kind,pathprefix,typeinfo[0],sep1,sep2,endrecord); raise SystemExit
print('no simple match')
