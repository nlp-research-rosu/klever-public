+      => pyList(LIST2)
+    </k>
+    requires totalChars(LIST1) >Int totalChars(LIST2)
+
+  claim [tie-first]:
+    <k>
+      run(solutionProgram, args(pyList(LIST1), pyList(LIST2)))
+      => pyList(LIST1)
+    </k>
+    requires totalChars(LIST1) ==Int totalChars(LIST2)
+endmodule
diff --git a//tmp/audit-work/candidate/spec-vacuity-audit.k b//tmp/audit-work/candidate/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..42726b046af2c1562c4ff33b0af6d4bca0a1ef50
--- /dev/null
+++ b//tmp/audit-work/candidate/spec-vacuity-audit.k
@@ -0,0 +1,13 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Deliberately false: under a strict smaller-first total, demand list2.
+  claim [false-first-result]:
+    <k>
+      run(solutionProgram, args(pyList(LIST1), pyList(LIST2)))
+      => pyList(LIST2)
