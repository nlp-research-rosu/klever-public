COMMAND: nl -ba /candidate/spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // sum(map(len, ...)) is precisely the sum of every string's length.
     7	  claim <k> totalChars(.StrVals) => 0 </k>
     8	
     9	  claim <k>
    10	          totalChars(pyStr(S) :: REST)
    11	        => lengthString(S) +Int totalChars(REST)
    12	        </k>
    13	
    14	  // If the first total is no greater, total_match returns the first list.
    15	  claim <k>
    16	          run(solutionProgram,
    17	              args(pyList(LIST1), pyList(LIST2)))
    18	        => pyList(LIST1)
    19	        </k>
    20	    requires totalChars(LIST1) <=Int totalChars(LIST2)
    21	
    22	  // If the second total is strictly smaller, it is returned.
    23	  claim <k>
    24	          run(solutionProgram,
    25	              args(pyList(LIST1), pyList(LIST2)))
    26	        => pyList(LIST2)
    27	        </k>
    28	    requires totalChars(LIST1) >Int totalChars(LIST2)
    29	
    30	  // The tie behavior from the natural-language contract is explicit.
    31	  claim <k>
    32	          run(solutionProgram,
    33	              args(pyList(LIST1), pyList(LIST2)))
    34	        => pyList(LIST1)
    35	        </k>
    36	    requires totalChars(LIST1) ==Int totalChars(LIST2)
    37	endmodule
