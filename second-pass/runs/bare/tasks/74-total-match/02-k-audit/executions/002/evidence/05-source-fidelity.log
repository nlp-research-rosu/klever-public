     6	def total_match(lst1, lst2):
     7	    '''
     8	    Write a function that accepts two lists of strings and returns the list that has 
     9	    total number of chars in the all strings of the list less than the other list.
    10	
    11	    if the two lists have the same number of chars, return the first list.
    12	
    13	    Examples
    14	    total_match([], []) ➞ []
    15	    total_match(['hi', 'admin'], ['hI', 'Hi']) ➞ ['hI', 'Hi']
    16	    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) ➞ ['hi', 'admin']
    17	    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) ➞ ['hI', 'hi', 'hi']
    18	    total_match(['4'], ['1', '2', '3', '4', '5']) ➞ ['4']
    19	    '''
    20	    l1 = 0
    21	    for st in lst1:
    22	        l1 += len(st)
    23	    
    24	    l2 = 0
    25	    for st in lst2:
    26	        l2 += len(st)
    27	    
    28	    if l1 <= l2:
    29	        return lst1
    30	    else:
    31	        return lst2
