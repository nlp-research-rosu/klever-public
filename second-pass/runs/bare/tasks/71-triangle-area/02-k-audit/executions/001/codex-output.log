+run kprove "$scratch/precision-witness-spec.k" \
+  --definition "$proof" \
+  --spec-module PRECISION-WITNESS-SPEC \
+  --claims PRECISION-WITNESS-SPEC.precision-loss-valid \
+  --smt-timeout 10000 || overall=1
+
+printf '\n[script_exit_status] %d\n' "$overall"
+exit "$overall"
