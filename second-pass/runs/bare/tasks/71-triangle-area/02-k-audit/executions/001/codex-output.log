+status=$?
+printf '[exit_status] %d\n' "$status"
+(( status == 0 )) || overall=1
+
+run cmp -s "$scratch/regenerated.mpy" "$scratch/solution.mpy" || overall=1
+run sha256sum "$scratch/regenerated.mpy" "$scratch/solution.mpy"
+
