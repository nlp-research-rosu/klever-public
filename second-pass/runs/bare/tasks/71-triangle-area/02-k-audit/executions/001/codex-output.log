+          Args(VInt(10000000000000000), VInt(10000000000000000), VInt(1))
+        ) => .K
+      </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult => VRounded(500000000000000000) </result>
+    </triangle>
+endmodule
