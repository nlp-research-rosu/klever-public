+overall=0
+
+printf 'Generated-semantics Haskell reconstruction and false-conclusion witness\n'
+
+run kompile \
+  --backend haskell \
+  "$scratch/semantic.k" \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$concrete" || overall=1
+
+run krun "$scratch/solution.mpy" \
