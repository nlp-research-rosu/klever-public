+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the actual result lacks the added one hundredth.
+  // (A,B,C)=(3,4,5) satisfies the precondition and yields 600, not 601.
+  claim
+    <triangle>
+      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result>
+        NoResult =>
+          VRounded(sqrtHundredths(heronRadicand(A, B, C)) +Int 1)
+      </result>
+    </triangle>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C >Int A
+endmodule
diff --git a/evidence/verification-body-mutation.k b/evidence/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..f8eb6f5a72294f9f4275b441aa58644ac576af83
--- /dev/null
+++ b/evidence/verification-body-mutation.k
@@ -0,0 +1,51 @@
+// Reviewer body-sensitivity mutation of the proof's executed program term:
+// only the first invalid return changes from -1 to -2.
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Program ::= "solutionProgram" [function]
+  syntax Rat ::= heronRadicand(Int, Int, Int) [function]
+
+  rule heronRadicand(A, B, C) =>
+    (((A +Int B +Int C) /Rat 2)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat A)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat B)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat C))
+
+  rule solutionProgram =>
+    Module(
+      FuncDef("triangle_area", Params("a", "b", "c"),
+        If(Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
+          Return(UnaryOp("-", Int(2))),
+          )
+        If(Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
+          Return(UnaryOp("-", Int(1))),
+          )
+        If(Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a"))),
+          Return(UnaryOp("-", Int(1))),
+          )
+        Assign(
+          Name("semiperimeter"),
+          BinOp(
+            "/",
+            BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+            Int(2)))
+        Assign(
+          Name("area"),
+          BinOp(
+            "**",
+            BinOp(
+              "*",
+              BinOp(
+                "*",
+                BinOp(
+                  "*",
+                  Name("semiperimeter"),
+                  BinOp("-", Name("semiperimeter"), Name("a"))),
+                BinOp("-", Name("semiperimeter"), Name("b"))),
+              BinOp("-", Name("semiperimeter"), Name("c"))),
+            Float(0.5)))
+        Return(Call(Name("round"), Name("area"), Int(2)))))
+endmodule

exec
