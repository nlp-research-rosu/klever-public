import random, math, time

def exact_cents(a,b,c):
 t=a+b+c
 # R = t(t-2a)(t-2b)(t-2c)/16
 num=t*(t-2*a)*(t-2*b)*(t-2*c)*10000
 q=16
 L=math.isqrt(num//q)
 while (L+1)*(L+1)*q<=num: L+=1
 left=4*num; right=(2*L+1)**2*q
 return L+1 if left>right or (left==right and L%2) else L

def pyf(a,b,c):
 s=(a+b+c)/2
 return round((s*(s-a)*(s-b)*(s-c))**.5,2)

