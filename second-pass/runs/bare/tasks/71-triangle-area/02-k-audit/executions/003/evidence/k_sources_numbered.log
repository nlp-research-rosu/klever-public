     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // The prompt's valid example: 6.00 is represented as 600 hundredths.
     7	  claim
     8	    <triangle>
     9	      <k> launch(solutionProgram, Args(VInt(3), VInt(4), VInt(5))) => .K </k>
    10	      <env> .Map </env>
    11	      <functions> .Map </functions>
    12	      <result> NoResult => VRounded(600) </result>
    13	    </triangle>
    14	
    15	  // A second exact Heron case exercises the complete valid path.
    16	  claim
    17	    <triangle>
    18	      <k> launch(solutionProgram, Args(VInt(5), VInt(12), VInt(13))) => .K </k>
    19	      <env> .Map </env>
    20	      <functions> .Map </functions>
    21	      <result> NoResult => VRounded(3000) </result>
    22	    </triangle>
    23	
    24	  // This case exercises square-root approximation and decimal rounding.
    25	  claim
    26	    <triangle>
    27	      <k> launch(solutionProgram, Args(VInt(2), VInt(2), VInt(2))) => .K </k>
    28	      <env> .Map </env>
    29	      <functions> .Map </functions>
    30	      <result> NoResult => VRounded(173) </result>
    31	    </triangle>
    32	
    33	  // For every valid integer triangle, symbolic execution establishes that the
    34	  // implementation returns the rounded square root of Heron's radicand.
    35	  claim
    36	    <triangle>
    37	      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
    38	      <env> .Map </env>
    39	      <functions> .Map </functions>
    40	      <result>
    41	        NoResult => VRounded(sqrtHundredths(heronRadicand(A, B, C)))
    42	      </result>
    43	    </triangle>
    44	    requires A +Int B >Int C
    45	     andBool A +Int C >Int B
    46	     andBool B +Int C >Int A
    47	
    48	  // Every invalid integer triangle reaches exactly one of these three claims,
    49	  // according to the source program's left-to-right guard order.
    50	  claim
    51	    <triangle>
    52	      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
    53	      <env> .Map </env>
    54	      <functions> .Map </functions>
    55	      <result> NoResult => VInt(-1) </result>
    56	    </triangle>
    57	    requires A +Int B <=Int C
    58	
    59	  claim
    60	    <triangle>
    61	      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
    62	      <env> .Map </env>
    63	      <functions> .Map </functions>
    64	      <result> NoResult => VInt(-1) </result>
    65	    </triangle>
    66	    requires A +Int B >Int C
    67	     andBool A +Int C <=Int B
    68	
    69	  claim
    70	    <triangle>
    71	      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
    72	      <env> .Map </env>
    73	      <functions> .Map </functions>
    74	      <result> NoResult => VInt(-1) </result>
    75	    </triangle>
    76	    requires A +Int B >Int C
    77	     andBool A +Int C >Int B
    78	     andBool B +Int C <=Int A
    79	endmodule
