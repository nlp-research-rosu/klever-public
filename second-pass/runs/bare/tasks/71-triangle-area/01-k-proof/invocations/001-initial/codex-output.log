+++ b/solution.py
@@ -0,0 +1,16 @@
+def triangle_area(a, b, c):
+    if a + b <= c:
+        return -1
+    if a + c <= b:
+        return -1
+    if b + c <= a:
+        return -1
+
+    semiperimeter = (a + b + c) / 2
+    area = (
+        semiperimeter
+        * (semiperimeter - a)
+        * (semiperimeter - b)
+        * (semiperimeter - c)
+    ) ** 0.5
+    return round(area, 2)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9e693a468d07dfab43368d76113d8ed2a117171d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module SPEC
