@@ -0,0 +1,53 @@
+// Verification harness: this constant is a literal copy of solution.mpy.
+// Keeping the translated AST visible makes the link between source and proof
+// auditable; prove.sh checks that the translator output remains unchanged.
+
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Program ::= "solutionProgram" [function]
+  syntax Rat ::= heronRadicand(Int, Int, Int) [function]
+
+  rule heronRadicand(A, B, C) =>
+    (((A +Int B +Int C) /Rat 2)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat A)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat B)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat C))
+
+  rule solutionProgram =>
+    Module(
+      FuncDef("triangle_area", Params("a", "b", "c"),
+        If(Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
+          Return(UnaryOp("-", Int(1))),
+          )
+        If(Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
+          Return(UnaryOp("-", Int(1))),
+          )
+        If(Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a"))),
+          Return(UnaryOp("-", Int(1))),
+          )
+        Assign(
+          Name("semiperimeter"),
+          BinOp(
+            "/",
+            BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+            Int(2)))
+        Assign(
+          Name("area"),
+          BinOp(
+            "**",
+            BinOp(
+              "*",
+              BinOp(
+                "*",
+                BinOp(
+                  "*",
+                  Name("semiperimeter"),
+                  BinOp("-", Name("semiperimeter"), Name("a"))),
+                BinOp("-", Name("semiperimeter"), Name("b"))),
+              BinOp("-", Name("semiperimeter"), Name("c"))),
+            Float(0.5)))
+        Return(Call(Name("round"), Name("area"), Int(2)))))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..55164144f80236347598aeb568d36614ad4aa874
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+cd "$SCRIPT_DIR"
+
+# Recreate the fixed translator output and require the checked-in AST to match.
+cmp solution.mpy <(python3 py2mpy.py solution.py)
+
+# Sanity-check the executable Python implementation against the prompt examples
+# and the additional valid cases used by the K claims.
+python3 - <<'PY'
+from solution import triangle_area
+
+assert triangle_area(3, 4, 5) == 6.00
+assert triangle_area(1, 2, 10) == -1
+assert triangle_area(5, 12, 13) == 30.00
+assert triangle_area(2, 2, 2) == 1.73
+PY
+
+PROOF_BUILD="$(mktemp -d "$SCRIPT_DIR/.prove-build.XXXXXX")"
+cleanup() {
+  rm -rf -- "$PROOF_BUILD"
+}
+trap cleanup EXIT
+
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --backend haskell \
+  -o "$PROOF_BUILD/verification-kompiled"
+
+# Exercise both contract outcomes and the rounding algorithm via krun.
+valid_output="$(krun solution.mpy \
+  -cARGS='Args(VInt(3), VInt(4), VInt(5))' \
+  -d "$PROOF_BUILD/verification-kompiled" --output pretty)"
+printf '%s\n' "$valid_output"
+grep -Fq 'VRounded ( 600 )' <<<"$valid_output"
+
+invalid_output="$(krun solution.mpy \
+  -cARGS='Args(VInt(1), VInt(2), VInt(10))' \
+  -d "$PROOF_BUILD/verification-kompiled" --output pretty)"
+printf '%s\n' "$invalid_output"
+grep -Fq 'VInt ( -1 )' <<<"$invalid_output"
+
+rounded_output="$(krun solution.mpy \
+  -cARGS='Args(VInt(2), VInt(2), VInt(2))' \
+  -d "$PROOF_BUILD/verification-kompiled" --output pretty)"
+printf '%s\n' "$rounded_output"
+grep -Fq 'VRounded ( 173 )' <<<"$rounded_output"
+
+# This is the required positive target-proof command.  It proves every claim
+# in spec.k in one invocation and must print #Top.
+kprove spec.k \
+  -d "$PROOF_BUILD/verification-kompiled" \
+  --smt-timeout 10000
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..5e23caa6b897c774b84d064df8561b82dad3c37a
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,193 @@
+// A small, executable semantics for exactly the Python-AST constructors used by
+// solution.mpy.  The source translator is purely syntactic; all computation is
+// defined here.
+
+requires "rat.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports FLOAT-SYNTAX
+  imports RAT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= Module(Stmts)
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Stmt   ::= FuncDef(String, Params, Stmts)
+                  | "If" "(" Exp "," Stmts "," ")"
+                  | Assign(Exp, Exp)
+                  | Return(Exp)
+
+  syntax Params  ::= Params(Strings)
+  syntax Strings ::= List{String, ","}
+
+  syntax Exp ::= Int(Int)
+               | Float(Float)
+               | Name(String)
+               | Call(Exp, Exprs)
+  syntax Exp ::= UnaryOp(String, Exp) [strict(2)]
+               | BinOp(String, Exp, Exp) [seqstrict(2, 3)]
+               | Compare(Exp, CmpOp) [strict(1)]
+  syntax CmpOp ::= CmpOp(String, Exp)
+  syntax Exprs ::= List{Exp, ","}
+
+  syntax NumValue ::= VInt(Int) | VRat(Rat)
+  syntax Value  ::= NumValue
+                  | VFloat(Float)
+                  | VSqrt(Rat)
+                  | VRounded(Int)
+                  | VBool(Bool)
+  syntax Values ::= List{Value, ","}
+  syntax Args   ::= Args(Values)
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports RAT
+  imports BOOL
+  imports MAP
+
+  configuration
+    <triangle>
+      <k> launch($PGM:Program, $ARGS:Args) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult </result>
+    </triangle>
+
+  syntax Result ::= "NoResult" | Value
+  syntax Exp ::= Value
+  syntax KResult ::= Value
+
+  syntax Function ::= function(Strings, Stmts)
+  syntax KItem ::= launch(Program, Args)
+                 | exec(Stmts)
+                 | invoke(String, Values)
+                 | bind(Strings, Values)
+                 | branch(Stmts)
+                 | assignTo(String)
+                 | "returnValue"
+                 | compareLE(Value)
+                 | "round2"
+
+  // Module loading and entry-point invocation.
+  rule launch(Module(SS), Args(VS))
+    => exec(SS) ~> invoke("triangle_area", VS)
+
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
+
+  rule <k> FuncDef(F, Params(PS), BODY) => .K ...</k>
+       <functions> FS => FS [ F <- function(PS, BODY) ] </functions>
+
+  rule <k> invoke(F, VS) => bind(PS, VS) ~> exec(BODY) ...</k>
+       <functions>... F |-> function(PS, BODY) ...</functions>
+
+  rule bind(.Strings, .Values) => .K
+  rule <k> bind((P, PS), (V, VS)) => bind(PS, VS) ...</k>
+       <env> RHO => RHO [ P <- V ] </env>
+
+  // Statements and non-local return from the one active function call.
+  rule If(E, THEN,) => E ~> branch(THEN)
+  rule VBool(true)  ~> branch(THEN) => exec(THEN)
+  rule VBool(false) ~> branch(_) => .K
+
+  rule Assign(Name(X), E) => E ~> assignTo(X)
+  rule <k> V:Value ~> assignTo(X) => .K ...</k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule Return(E) => E ~> returnValue
+  rule <k> V:Value ~> returnValue ~> _REST:K => .K </k>
+       <env> _ => .Map </env>
+       <functions> _ => .Map </functions>
+       <result> NoResult => V </result>
+
+  // Literals, variables, and unary negation.
+  rule Int(I) => VInt(I)
+  rule Float(F) => VFloat(F)
+  rule <k> Name(X) => V ...</k>
+       <env>... X |-> V ...</env>
+
+  rule UnaryOp("-", VInt(I))   => VInt(0 -Int I)
+  rule UnaryOp("-", VRat(R)) => VRat(0 -Rat R)
+
+  // Python numeric promotion for the arithmetic needed by this program.
+  syntax Rat ::= asRat(NumValue) [function, total]
+  rule asRat(VInt(I)) => I
+  rule asRat(VRat(R)) => R
+
+  rule BinOp("+", VInt(I), VInt(J)) => VInt(I +Int J)
+  rule BinOp("+", V:NumValue, W:NumValue)
+    => VRat(asRat(V) +Rat asRat(W))
+    [owise]
+
+  rule BinOp("-", VInt(I), VInt(J)) => VInt(I -Int J)
+  rule BinOp("-", V:NumValue, W:NumValue)
+    => VRat(asRat(V) -Rat asRat(W))
+    [owise]
+
+  rule BinOp("*", VInt(I), VInt(J)) => VInt(I *Int J)
+  rule BinOp("*", V:NumValue, W:NumValue)
+    => VRat(asRat(V) *Rat asRat(W))
+    [owise]
+
+  rule BinOp("/", V:NumValue, W:NumValue)
+    => VRat(asRat(V) /Rat asRat(W))
+  rule BinOp("**", V:NumValue, VFloat(0.5))
+    => VSqrt(asRat(V))
+
+  // The emitted comparisons are single-link chains.  The continuation keeps
+  // Python's left-to-right expression evaluation explicit.
+  rule Compare(V:Value, CmpOp("<=", E)) => E ~> compareLE(V)
+  rule VInt(J) ~> compareLE(VInt(I))
+    => VBool(I <=Int J)
+  rule W:NumValue ~> compareLE(V:NumValue)
+    => VBool(asRat(V) <=Rat asRat(W))
+    [owise]
+
+  // round(sqrt(x), 2), represented exactly as an integer count of hundredths.
+  // The integer/rational algorithm avoids relying on backend floating-point
+  // hooks, so the same semantics is executable and symbolically provable.
+  rule Call(Name("round"), E, Int(2)) => E ~> round2
+  rule VSqrt(R) ~> round2 => VRounded(sqrtHundredths(R))
+  rule VInt(I) ~> round2 => VInt(I)
+
+  syntax Int ::= sqrtHundredths(Rat) [function]
+               | findSqrtUpper(Rat, Int) [function]
+               | bisectSqrt(Rat, Int, Int) [function]
+               | finishSqrtRound(Rat, Int) [function]
+
+  rule sqrtHundredths(R)
+    => findSqrtUpper(R *Rat 10000, 1)
+    [concrete(R), simplification]
+
+  rule findSqrtUpper(R, H)
+    => finishSqrtRound(R, bisectSqrt(R, H /Int 2, H))
+    requires R <Rat (H *Int H)
+  rule findSqrtUpper(R, H)
+    => findSqrtUpper(R, H *Int 2)
+    requires R >=Rat (H *Int H)
+
+  rule bisectSqrt(_, L, H) => L
+    requires H -Int L <=Int 1
+  rule bisectSqrt(R, L, H)
+    => bisectSqrt(R, (L +Int H) /Int 2, H)
+    requires H -Int L >Int 1
+     andBool (((L +Int H) /Int 2) *Int ((L +Int H) /Int 2) <=Rat R)
+  rule bisectSqrt(R, L, H)
+    => bisectSqrt(R, L, (L +Int H) /Int 2)
+    requires H -Int L >Int 1
+     andBool (R <Rat ((L +Int H) /Int 2) *Int ((L +Int H) /Int 2))
+
+  rule finishSqrtRound(R, L) => L +Int 1
+    requires (4 *Rat R) >Rat ((2 *Int L +Int 1) *Int (2 *Int L +Int 1))
+  rule finishSqrtRound(R, L) => L
+    requires (4 *Rat R) <Rat ((2 *Int L +Int 1) *Int (2 *Int L +Int 1))
+  rule finishSqrtRound(R, L) => L
+    requires (4 *Rat R) ==Rat ((2 *Int L +Int 1) *Int (2 *Int L +Int 1))
+     andBool L %Int 2 ==Int 0
+  rule finishSqrtRound(R, L) => L +Int 1
+    requires (4 *Rat R) ==Rat ((2 *Int L +Int 1) *Int (2 *Int L +Int 1))
+     andBool L %Int 2 =/=Int 0
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a0b553ba06a6f198e461d17099f7b8d1e1609278
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def triangle_area(a, b, c):
+    if a + b <= c:
+        return -1
+    if a + c <= b:
+        return -1
+    if b + c <= a:
+        return -1
+
+    semiperimeter = (a + b + c) / 2
+    area = (
+        semiperimeter
+        * (semiperimeter - a)
+        * (semiperimeter - b)
+        * (semiperimeter - c)
+    ) ** 0.5
+    return round(area, 2)
