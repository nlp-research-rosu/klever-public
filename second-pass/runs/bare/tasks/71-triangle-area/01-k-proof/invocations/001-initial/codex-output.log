@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The prompt's valid example: 6.00 is represented as 600 hundredths.
+  claim
+    <triangle>
+      <k> launch(solutionProgram, Args(VInt(3), VInt(4), VInt(5))) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult => VRounded(600) </result>
+    </triangle>
+
+  // A second exact Heron case exercises the complete valid path.
+  claim
+    <triangle>
+      <k> launch(solutionProgram, Args(VInt(5), VInt(12), VInt(13))) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult => VRounded(3000) </result>
+    </triangle>
+
+  // This case exercises square-root approximation and decimal rounding.
+  claim
+    <triangle>
+      <k> launch(solutionProgram, Args(VInt(2), VInt(2), VInt(2))) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult => VRounded(173) </result>
+    </triangle>
+
+  // For every valid integer triangle, symbolic execution establishes that the
+  // implementation returns the rounded square root of Heron's radicand.
+  claim
+    <triangle>
+      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result>
+        NoResult => VRounded(sqrtHundredths(heronRadicand(A, B, C)))
+      </result>
+    </triangle>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C >Int A
+
+  // Every invalid integer triangle reaches exactly one of these three claims,
+  // according to the source program's left-to-right guard order.
+  claim
+    <triangle>
+      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult => VInt(-1) </result>
+    </triangle>
+    requires A +Int B <=Int C
+
+  claim
+    <triangle>
+      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult => VInt(-1) </result>
+    </triangle>
+    requires A +Int B >Int C
+     andBool A +Int C <=Int B
+
+  claim
+    <triangle>
+      <k> launch(solutionProgram, Args(VInt(A), VInt(B), VInt(C))) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult => VInt(-1) </result>
+    </triangle>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C <=Int A
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f3ac4ac1b23089cbaa4a1c00eb23fd583f539d33
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+// Verification harness: this constant is a literal copy of solution.mpy.
+// Keeping the translated AST visible makes the link between source and proof
+// auditable; prove.sh checks that the translator output remains unchanged.
+
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Program ::= "solutionProgram" [function]
+  syntax Rat ::= heronRadicand(Int, Int, Int) [function]
+
+  rule heronRadicand(A, B, C) =>
+    (((A +Int B +Int C) /Rat 2)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat A)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat B)
+      *Rat (((A +Int B +Int C) /Rat 2) -Rat C))
+
+  rule solutionProgram =>
+    Module(
+      FuncDef("triangle_area", Params("a", "b", "c"),
+        If(Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
+          Return(UnaryOp("-", Int(1))),
+          )
+        If(Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
+          Return(UnaryOp("-", Int(1))),
+          )
+        If(Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a"))),
+          Return(UnaryOp("-", Int(1))),
+          )
+        Assign(
+          Name("semiperimeter"),
+          BinOp(
+            "/",
+            BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+            Int(2)))
+        Assign(
+          Name("area"),
+          BinOp(
+            "**",
+            BinOp(
+              "*",
+              BinOp(
+                "*",
+                BinOp(
+                  "*",
+                  Name("semiperimeter"),
+                  BinOp("-", Name("semiperimeter"), Name("a"))),
+                BinOp("-", Name("semiperimeter"), Name("b"))),
+              BinOp("-", Name("semiperimeter"), Name("c"))),
+            Float(0.5)))
+        Return(Call(Name("round"), Name("area"), Int(2)))))
+endmodule

exec
/bin/bash -lc "find /work/.kbuild -depth -delete
find /work/__pycache__ -depth -delete
unlink /work/kore-exec.tar.gz
find . -maxdepth 2 -mindepth 1 -printf '%M %P\\n' | sort
stat -c '%A %n' prove.sh" in /work
