    VInt ( 7 ) ~> #freezerCompare(_,_)_MPY-SYNTAX_Exp_Exp_CmpOp0_ ( CmpOp ( "<=" , Name ( "c" ) ) ~> .K ) ~> branch ( Return ( UnaryOp ( "-" , Int ( 1 ) ) )  .Stmts ) ~> exec ( If ( Compare ( BinOp ( "+" , Name ( "a" ) , Name ( "c" ) ) , CmpOp ( "<=" , Name ( "b" ) ) ) , Return ( UnaryOp ( "-" , Int ( 1 ) ) )  .Stmts , )  If ( Compare ( BinOp ( "+" , Name ( "b" ) , Name ( "c" ) ) , CmpOp ( "<=" , Name ( "a" ) ) ) , Return ( UnaryOp ( "-" , Int ( 1 ) ) )  .Stmts , )  Assign ( Name ( "semiperimeter" ) , BinOp ( "/" , BinOp ( "+" , BinOp ( "+" , Name ( "a" ) , Name ( "b" ) ) , Name ( "c" ) ) , Int ( 2 ) ) )  Assign ( Name ( "area" ) , BinOp ( "**" , BinOp ( "*" , BinOp ( "*" , BinOp ( "*" , Name ( "semiperimeter" ) , BinOp ( "-" , Name ( "semiperimeter" ) , Name ( "a" ) ) ) , BinOp ( "-" , Name ( "semiperimeter" ) , Name ( "b" ) ) ) , BinOp ( "-" , Name ( "semiperimeter" ) , Name ( "c" ) ) ) , Float ( 0.5 ) ) )  Return ( Call ( Name ( "round" ) , Name ( "area" ) , Int ( 2 ) , .Exprs ) )  .Stmts ) ~> .K
  </k>
  <env>
    "a" |-> VInt ( 3 )
    "b" |-> VInt ( 4 )
    "c" |-> VInt ( 5 )
  </env>
  <functions>
    "triangle_area" |-> function ( "a" , "b" , "c" , .Strings , If ( Compare ( BinOp ( "+" , Name ( "a" ) , Name ( "b" ) ) , CmpOp ( "<=" , Name ( "c" ) ) ) , Return ( UnaryOp ( "-" , Int ( 1 ) ) )  .Stmts , )  If ( Compare ( BinOp ( "+" , Name ( "a" ) , Name ( "c" ) ) , CmpOp ( "<=" , Name ( "b" ) ) ) , Return ( UnaryOp ( "-" , Int ( 1 ) ) )  .Stmts , )  If ( Compare ( BinOp ( "+" , Name ( "b" ) , Name ( "c" ) ) , CmpOp ( "<=" , Name ( "a" ) ) ) , Return ( UnaryOp ( "-" , Int ( 1 ) ) )  .Stmts , )  Assign ( Name ( "semiperimeter" ) , BinOp ( "/" , BinOp ( "+" , BinOp ( "+" , Name ( "a" ) , Name ( "b" ) ) , Name ( "c" ) ) , Int ( 2 ) ) )  Assign ( Name ( "area" ) , BinOp ( "**" , BinOp ( "*" , BinOp ( "*" , BinOp ( "*" , Name ( "semiperimeter" ) , BinOp ( "-" , Name ( "semiperimeter" ) , Name ( "a" ) ) ) , BinOp ( "-" , Name ( "semiperimeter" ) , Name ( "b" ) ) ) , BinOp ( "-" , Name ( "semiperimeter" ) , Name ( "c" ) ) ) , Float ( 0.5 ) ) )  Return ( Call ( Name ( "round" ) , Name ( "area" ) , Int ( 2 ) , .Exprs ) )  .Stmts )
  </functions>
  <result>
    NoResult
  </result>
</triangle>

exec
/bin/bash -lc 'krun run-345.input -d .kbuild/verification-rat-kompiled --depth 100 --output pretty' in /work
