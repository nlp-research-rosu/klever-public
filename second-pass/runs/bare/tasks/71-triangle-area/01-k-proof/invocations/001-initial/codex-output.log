+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports FLOAT
+  imports BOOL
+  imports MAP
+
+  configuration
+    <triangle>
+      <k> $PGM:Input </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> NoResult </result>
+    </triangle>
+
+  syntax Result ::= "NoResult" | Value
+  syntax Exp ::= Value
+  syntax KResult ::= Value
+
+  syntax Function ::= function(Strings, Stmts)
