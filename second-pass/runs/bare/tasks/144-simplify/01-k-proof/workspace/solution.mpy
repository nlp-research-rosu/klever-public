Module(
  FuncDef("simplify", Params("x", "n"),
    Assign(
      Name("x_parts"),
      Call(Attribute(Name("x"), "split"), Str("/")))
    Assign(
      Name("n_parts"),
      Call(Attribute(Name("n"), "split"), Str("/")))
    Assign(
      Name("numerator"),
      BinOp(
        "*",
        Call(Name("int"), Subscript(Name("x_parts"), Int(0))),
        Call(Name("int"), Subscript(Name("n_parts"), Int(0)))))
    Assign(
      Name("denominator"),
      BinOp(
        "*",
        Call(Name("int"), Subscript(Name("x_parts"), Int(1))),
        Call(Name("int"), Subscript(Name("n_parts"), Int(1)))))
    Return(
      Compare(
        BinOp("%", Name("numerator"), Name("denominator")),
        CmpOp("==", Int(0))))))
