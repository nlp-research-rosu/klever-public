+++ b//tmp/audit-work/body-mutation/verification.k
@@ -28,7 +28,7 @@
         Return(
           Compare(
             BinOp("%", Name("numerator"), Name("denominator")),
-            CmpOp("==", Int(0))))))
+            CmpOp("==", Int(1))))))
 
   // Sound symbolic instances of split and int for the canonical decimal
   // strings generated by Int2String.  The concrete semantics above handles
diff --git a//tmp/audit-work/reconstruction/bridge-check.k b//tmp/audit-work/reconstruction/bridge-check.k
new file mode 100644
index 0000000000000000000000000000000000000000..8fea02646b57db5cc70e2545b2aad029ea98ba57
--- /dev/null
+++ b//tmp/audit-work/reconstruction/bridge-check.k
@@ -0,0 +1,32 @@
+requires "semantic.k"
+
+module BRIDGE-CHECK
+  imports SEMANTIC
+
+  claim [slash-split-connection]:
+    <simplify>
+      <k>
+        slashSplit(Int2String(A) +String "/" +String Int2String(B))
+        => pairList(strVal(Int2String(A)), strVal(Int2String(B)))
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </simplify>
+
+  claim [decimal-value-connection]:
+    <simplify>
+      <k> decimalValue(Int2String(I)) => I </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </simplify>
+
+  claim [string-int-inverse]:
+    <simplify>
+      <k> String2Int(Int2String(I)) => I </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </simplify>
+endmodule
