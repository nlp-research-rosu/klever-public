candidate_prompt_sha256: expected=2a0addf544cd38216f359d1e48649ae659b89cd25c4f7fa72060ee8cbb404735 actual=2a0addf544cd38216f359d1e48649ae659b89cd25c4f7fa72060ee8cbb404735 match=True
