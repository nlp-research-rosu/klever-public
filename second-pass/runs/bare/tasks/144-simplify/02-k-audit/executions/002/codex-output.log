diff --git a/evidence/run_stage3_build.sh b/evidence/run_stage3_build.sh
new file mode 100644
index 0000000000000000000000000000000000000000..64f0ca877fbafcefe1e4b087d836b6ee324304d5
--- /dev/null
+++ b/evidence/run_stage3_build.sh
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+set -euxo pipefail
+
+cd /tmp/audit-work/reconstruction
+kompile --version
+kompile --backend haskell semantic.k \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --output-definition audit-semantic-kompiled
+kompile --backend haskell verification.k \
