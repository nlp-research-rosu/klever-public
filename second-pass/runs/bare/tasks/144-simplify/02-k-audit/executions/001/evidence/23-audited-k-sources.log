     5	
     6	  claim [simplify-general]:
     7	    <simplify>
     8	      <k> simplifyProgram ~>
     9	          invoke("simplify",
    10	            strVal(Int2String(A) +String "/" +String Int2String(B)),
    11	            strVal(Int2String(C) +String "/" +String Int2String(D)))
    12	          => .K </k>
    13	      <functions> .Map => ?FS:Map </functions>
    14	      <env> .Map => ?RHO:Map </env>
    15	      <result> noResult =>
    16	        result(boolVal(((A *Int C) %Int (B *Int D)) ==Int 0))
    17	      </result>
    18	    </simplify>
    19	    requires A >Int 0 andBool B >Int 0
    20	     andBool C >Int 0 andBool D >Int 0
