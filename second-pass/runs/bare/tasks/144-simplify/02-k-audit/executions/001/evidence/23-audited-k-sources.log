     1	module MPY-SYNTAX
     2	  imports INT
     3	  imports STRING
     4	
     5	  syntax ParamList ::= List{String, ","}
     6	  syntax Params ::= "Params" "(" ParamList ")"
     7	
     8	  syntax Expr ::= "Name" "(" String ")"
     9	                | "Int" "(" Int ")"
    10	                | "Str" "(" String ")"
    11	                | "Attribute" "(" Expr "," String ")"
    12	                | "Call" "(" Expr "," Expr ")"
    13	                | "Subscript" "(" Expr "," Expr ")"
    14	                | "BinOp" "(" String "," Expr "," Expr ")"
    15	                | "Compare" "(" Expr "," CmpOp ")"
    16	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    17	
    18	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    19	                | "Assign" "(" Expr "," Expr ")"
    20	                | "Return" "(" Expr ")"
    21	  syntax Stmts ::= List{Stmt, ""}
    22	  syntax Module ::= "Module" "(" Stmts ")"
    23	
    24	  syntax PyVal ::= "intVal" "(" Int ")"
    25	                 | "boolVal" "(" Bool ")"
    26	                 | "strVal" "(" String ")"
    27	                 | "pairList" "(" PyVal "," PyVal ")"
    28	                 | "builtinInt"
    29	                 | "splitMethod" "(" PyVal ")"
    30	                 | "slashSplit" "(" String ")" [function]
    31	  syntax Int ::= "decimalValue" "(" String ")" [function]
    32	  syntax Expr ::= PyVal
    33	  syntax PyVals ::= List{PyVal, ","}
    34	
    35	  syntax Function ::= "function" "(" Params "," Stmts ")"
    36	  syntax Result ::= "noResult" | "result" "(" PyVal ")"
    37	endmodule
    38	
    39	module SEMANTIC
    40	  imports MPY-SYNTAX
    41	  imports BOOL
    42	  imports MAP
    43	
    44	  configuration
    45	    <simplify>
    46	      <k> $PGM:Module ~> invoke("simplify", $ARGS:PyVals) </k>
    47	      <functions> .Map </functions>
    48	      <env> .Map </env>
    49	      <result> noResult </result>
    50	    </simplify>
    51	
    52	  syntax KItem ::= "exec" "(" Stmts ")"
    53	                 | "invoke" "(" String "," PyVals ")"
    54	                 | "bind" "(" String ")"
    55	                 | "finishReturn"
    56	                 | "getAttribute" "(" String ")"
    57	                 | "callWith" "(" Expr ")"
    58	                 | "apply" "(" PyVal ")"
    59	                 | "indexWith" "(" Expr ")"
    60	                 | "indexApply" "(" PyVal ")"
    61	                 | "binRight" "(" String "," Expr ")"
    62	                 | "binApply" "(" String "," PyVal ")"
    63	                 | "compareRight" "(" String "," Expr ")"
    64	                 | "compareApply" "(" String "," PyVal ")"
    65	
    66	  rule <k> Module(SS) => exec(SS) ... </k>
    67	  rule <k> exec(.Stmts) => .K ... </k>
    68	  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
    69	
    70	  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
    71	       <functions> FS => FS [ F <- function(PS, BODY) ] </functions>
    72	
    73	  rule <k> invoke(F, V1:PyVal, V2:PyVal) => exec(BODY) ... </k>
    74	       <functions> ... F |-> function(Params(X:String, Y:String), BODY) ... </functions>
    75	       <env> _ => (X |-> V1) (Y |-> V2) </env>
    76	
    77	  rule <k> Assign(Name(X), E) => E ~> bind(X) ... </k>
    78	  rule <k> V:PyVal ~> bind(X) => .K ... </k>
    79	       <env> RHO => RHO [ X <- V ] </env>
    80	
    81	  rule <k> Return(E) => E ~> finishReturn ... </k>
    82	  rule <k> V:PyVal ~> finishReturn ~> _REST => .K </k>
    83	       <result> _ => result(V) </result>
    84	
    85	  rule <k> Int(I) => intVal(I) ... </k>
    86	  rule <k> Str(S) => strVal(S) ... </k>
    87	  rule <k> Name("int") => builtinInt ... </k>
    88	  rule <k> Name(X) => V ... </k>
    89	       <env> ... X |-> V:PyVal ... </env>
    90	
    91	  rule <k> Attribute(E, A) => E ~> getAttribute(A) ... </k>
    92	  rule <k> V:PyVal ~> getAttribute("split") => splitMethod(V) ... </k>
    93	
    94	  rule <k> Call(F, E) => F ~> callWith(E) ... </k>
    95	  rule <k> V:PyVal ~> callWith(E) => E ~> apply(V) ... </k>
    96	  rule <k> strVal("/") ~> apply(splitMethod(strVal(S)))
    97	        => slashSplit(S) ... </k>
    98	  rule slashSplit(S) =>
    99	         pairList(
   100	           strVal(substrString(S, 0, findString(S, "/", 0))),
   101	           strVal(substrString(S, findString(S, "/", 0) +Int 1, lengthString(S))))
   102	       requires findString(S, "/", 0) >=Int 0
   103	       [owise]
   104	  rule <k> strVal(S) ~> apply(builtinInt) => intVal(decimalValue(S)) ... </k>
   105	  rule decimalValue(S) => String2Int(S) [owise]
   106	
   107	  rule <k> Subscript(BASE, INDEX) => BASE ~> indexWith(INDEX) ... </k>
   108	  rule <k> V:PyVal ~> indexWith(INDEX) => INDEX ~> indexApply(V) ... </k>
   109	  rule <k> intVal(0) ~> indexApply(pairList(V0, _)) => V0 ... </k>
   110	  rule <k> intVal(1) ~> indexApply(pairList(_, V1)) => V1 ... </k>
   111	
   112	  rule <k> BinOp(OP, L, R) => L ~> binRight(OP, R) ... </k>
   113	  rule <k> V:PyVal ~> binRight(OP, R) => R ~> binApply(OP, V) ... </k>
   114	  rule <k> intVal(B) ~> binApply("*", intVal(A)) => intVal(A *Int B) ... </k>
   115	  rule <k> intVal(B) ~> binApply("%", intVal(A)) => intVal(A %Int B) ... </k>
   116	       requires B =/=Int 0
   117	
   118	  rule <k> Compare(L, CmpOp(OP, R)) => L ~> compareRight(OP, R) ... </k>
   119	  rule <k> V:PyVal ~> compareRight(OP, R) => R ~> compareApply(OP, V) ... </k>
   120	  rule <k> intVal(B) ~> compareApply("==", intVal(A))
   121	        => boolVal(A ==Int B) ... </k>
   122	endmodule
     1	requires "semantic.k"
