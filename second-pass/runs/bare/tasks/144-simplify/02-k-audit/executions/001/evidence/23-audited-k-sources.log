     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  syntax Module ::= "simplifyProgram"
     7	  rule simplifyProgram =>
     8	    Module(
     9	      FuncDef("simplify", Params("x", "n"),
    10	        Assign(
    11	          Name("x_parts"),
    12	          Call(Attribute(Name("x"), "split"), Str("/")))
    13	        Assign(
    14	          Name("n_parts"),
    15	          Call(Attribute(Name("n"), "split"), Str("/")))
    16	        Assign(
    17	          Name("numerator"),
    18	          BinOp(
    19	            "*",
    20	            Call(Name("int"), Subscript(Name("x_parts"), Int(0))),
    21	            Call(Name("int"), Subscript(Name("n_parts"), Int(0)))))
    22	        Assign(
    23	          Name("denominator"),
    24	          BinOp(
    25	            "*",
    26	            Call(Name("int"), Subscript(Name("x_parts"), Int(1))),
    27	            Call(Name("int"), Subscript(Name("n_parts"), Int(1)))))
    28	        Return(
    29	          Compare(
    30	            BinOp("%", Name("numerator"), Name("denominator")),
    31	            CmpOp("==", Int(0))))))
    32	
    33	  // Sound symbolic instances of split and int for the canonical decimal
    34	  // strings generated by Int2String.  The concrete semantics above handles
    35	  // arbitrary literal valid fractions with findString/substrString/String2Int.
    36	  rule slashSplit(Int2String(A) +String "/" +String Int2String(B))
    37	        => pairList(strVal(Int2String(A)), strVal(Int2String(B)))
    38	       [simplification]
    39	  rule decimalValue(Int2String(I)) => I [simplification]
    40	  rule String2Int(Int2String(I)) => I [simplification]
    41	endmodule
     1	requires "verification.k"
