@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'cwd: %q\n' "$PWD"
+  printf 'command:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$log_path"
+
+set +e
+"$@" > >(tee -a "$log_path") 2> >(tee -a "$log_path" >&2)
+command_status=$?
+set -e
+
+printf 'exit_status: %d\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"

exec
/bin/bash -lc 'chmod +x /audit-output/evidence/differential_test.py /audit-output/evidence/concrete_semantics_test.py /audit-output/evidence/claim_witness.py /audit-output/evidence/extension_sensitivity_test.py && tail -2 /audit-output/REVIEW.md && test "$(tail -2 /audit-output/REVIEW.md | sed -n '"'1p')\" = 'VERDICT: CONCERNS' && test \""'$(tail -1 /audit-output/REVIEW.md)" = '"'LEGITIMACY: LEGIT' && printf 'final_marker_check=ok\\n'" in /audit-output
 succeeded in 0ms:
VERDICT: CONCERNS
LEGITIMACY: LEGIT
final_marker_check=ok

