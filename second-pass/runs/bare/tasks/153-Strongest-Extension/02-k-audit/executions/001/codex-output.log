     1	// A small executable semantics for the py2mpy constructors used by solution.py.
     2	// It models Python integers, strings, lists, local variables, sequencing,
     3	// conditionals, for-loops, method calls to str.isupper/islower, and return.
     4	
     5	requires "domains.md"
     6	
     7	module MPY-SYNTAX
     8	  imports INT-SYNTAX
     9	  imports STRING-SYNTAX
    10	  imports BOOL-SYNTAX
    11	
    12	  syntax Program ::= Module ( Stmts )
    13	
    14	  syntax Stmts ::= List{Stmt, ""}
    15	  syntax Params ::= Params ( String , String )
    16	  syntax Exprs ::= List{Expr,","}
    17	  syntax CmpOps ::= List{CmpOp,","}
    18	
    19	  syntax Stmt ::= FuncDef ( String , Params , Stmts )
    20	                | Assign ( Expr , Expr ) [strict(2)]
    21	                | AugAssign ( Expr , String , Expr ) [strict(3)]
    22	                | If ( Expr , Stmts , Stmts ) [strict(1)]
    23	                | For ( Expr , Expr , Stmts ) [strict(2)]
    24	                | Return ( Expr ) [strict]
    25	
    26	  syntax Expr ::= Int ( Int )
    27	                | Str ( String )
    28	                | Name ( String )
    29	                | BinOp ( String , Expr , Expr ) [strict(2,3)]
    30	                | Compare ( Expr , CmpOps ) [strict(1)]
    31	                | Subscript ( Expr , Expr ) [strict(1)]
    32	                | Slice ( Bound , Bound , Bound )
    33	                | Attribute ( Expr , String ) [strict(1)]
    34	                | Call ( Expr , Exprs ) [strict(1)]
    35	
    36	  syntax CmpOp ::= CmpOp ( String , Expr )
    37	  syntax Bound ::= Expr | "NoBound"
    38	endmodule
    39	
    40	module MPY-SEMANTIC
    41	  imports MPY-SYNTAX
    42	  imports INT
    43	  imports STRING
    44	  imports BOOL
    45	  imports MAP
    46	
    47	  // Runtime values.  A semicolon deliberately separates Values so this list
    48	  // syntax cannot be confused with constructor argument commas.
    49	  syntax Value ::= "intVal" "(" Int ")"
    50	                 | "strVal" "(" String ")"
    51	                 | "listVal" "(" Values ")"
    52	                 | "boolVal" "(" Bool ")"
    53	                 | "boundStringMethod" "(" String "," String ")"
    54	  syntax Values ::= List{Value,";"}
    55	  syntax KResult ::= Value
    56	  syntax Expr ::= Value
    57	
    58	  syntax Function ::= "function" "(" Params "," Stmts ")"
    59	  syntax Result ::= "noResult" | "returned" "(" Value ")"
    60	
    61	  configuration
    62	    <py>
    63	      <k> $PGM:Program ~> #start </k>
    64	      <env> .Map </env>
    65	      <functions> .Map </functions>
    66	      <inputClass> $CLASS:String </inputClass>
    67	      <inputExtensions> $EXTENSIONS:Values </inputExtensions>
    68	      <result> noResult </result>
    69	    </py>
    70	
    71	  syntax KItem ::= "exec" "(" Stmts ")"
    72	                 | "setVar" "(" String "," Value ")"
    73	                 | "loopValues" "(" String "," Values "," Stmts ")"
    74	                 | "loopString" "(" String "," String "," Int "," Stmts ")"
    75	                 | "#start"
    76	
    77	  // Module loading and ordinary statement sequencing.
    78	  rule <k> Module(S) => exec(S) ... </k>
    79	  rule <k> exec(.Stmts) => .K ... </k>
    80	  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
    81	
    82	  rule <k> FuncDef(F, P, BODY) => .K ... </k>
    83	       <functions> FS => FS [ F <- function(P, BODY) ] </functions>
    84	
    85	  // This task's required entry point is called after the translated module
    86	  // has installed its definition.  Parameters are bound by their source names.
    87	  rule <k> #start => exec(BODY) ... </k>
    88	       <functions> ... "Strongest_Extension" |-> function(Params("class_name", "extensions"), BODY) ... </functions>
    89	       <inputClass> C </inputClass>
    90	       <inputExtensions> ES </inputExtensions>
    91	       <env> _ => "class_name" |-> strVal(C)
    92	                  "extensions" |-> listVal(ES) </env>
    93	
    94	  // Literals, lookup, and assignment.
    95	  rule Int(I) => intVal(I)
    96	  rule Str(S) => strVal(S)
    97	  rule <k> Name(X) => V ... </k>
    98	       <env> ... X |-> V:Value ... </env>
    99	
   100	  rule <k> Assign(Name(X), V:Value) => .K ... </k>
   101	       <env> ENV => ENV [ X <- V ] </env>
   102	  rule <k> setVar(X, V) => .K ... </k>
   103	       <env> ENV => ENV [ X <- V ] </env>
   104	
   105	  rule <k> AugAssign(Name(X), "+", intVal(I)) => .K ... </k>
   106	       <env> X |-> intVal(J) ENV => X |-> intVal(J +Int I) ENV </env>
   107	  rule <k> AugAssign(Name(X), "-", intVal(I)) => .K ... </k>
   108	       <env> X |-> intVal(J) ENV => X |-> intVal(J -Int I) ENV </env>
   109	
   110	  // The two subscript forms emitted by this solution: [0] and [1:].
   111	  rule Subscript(listVal(V ; _), Int(0)) => V
   112	  rule Subscript(listVal(_ ; VS), Slice(Int(1), NoBound, NoBound))
   113	    => listVal(VS)
   114	
   115	  // List and string iteration.  The string loop exposes one Unicode code
   116	  // point at a time through K's String hooks.
   117	  rule <k> For(Name(X), listVal(VS), BODY) => loopValues(X, VS, BODY) ... </k>
   118	  rule <k> loopValues(_, .Values, _) => .K ... </k>
   119	  rule <k> loopValues(X, V ; VS, BODY)
   120	        => setVar(X, V) ~> exec(BODY) ~> loopValues(X, VS, BODY) ... </k>
   121	
   122	  rule <k> For(Name(X), strVal(S), BODY) => loopString(X, S, 0, BODY) ... </k>
   123	  rule <k> loopString(_, S, I, _) => .K ... </k>
   124	       requires I >=Int lengthString(S)
   125	  rule <k> loopString(X, S, I, BODY)
   126	        => setVar(X, strVal(substrString(S, I, I +Int 1)))
   127	           ~> exec(BODY) ~> loopString(X, S, I +Int 1, BODY) ... </k>
   128	       requires I <Int lengthString(S)
   129	
   130	  // String methods needed by the program.  For one-character strings,
   131	  // CPython's ASCII upper/lower cases coincide with these code-point ranges.
   132	  syntax Bool ::= "isUpperChar" "(" String ")" [function, total]
   133	                | "isLowerChar" "(" String ")" [function, total]
   134	  rule isUpperChar(S) => (65 <=Int ordChar(S)) andBool (ordChar(S) <=Int 90)
   135	  rule isLowerChar(S) => (97 <=Int ordChar(S)) andBool (ordChar(S) <=Int 122)
   136	
   137	  rule Attribute(strVal(S), METHOD) => boundStringMethod(S, METHOD)
   138	  rule Call(boundStringMethod(S, "isupper"), .Exprs)
   139	    => boolVal(isUpperChar(S))
   140	  rule Call(boundStringMethod(S, "islower"), .Exprs)
   141	    => boolVal(isLowerChar(S))
   142	
   143	  rule If(boolVal(true), THEN, _) => exec(THEN)
   144	  rule If(boolVal(false), _, ELSE) => exec(ELSE)
   145	
   146	  rule BinOp("+", intVal(I), intVal(J)) => intVal(I +Int J)
   147	  rule BinOp("+", strVal(S), strVal(T)) => strVal(S +String T)
   148	  rule <k> Compare(intVal(I), CmpOp(">", Name(X))) => boolVal(I >Int J) ... </k>
   149	       <env> ... X |-> intVal(J) ... </env>
   150	
   151	  rule <k> Return(V:Value) => .K ... </k>
   152	       <result> noResult => returned(V) </result>
   153	endmodule
   154	
   155	module SEMANTIC
   156	  imports MPY-SEMANTIC
   157	endmodule
