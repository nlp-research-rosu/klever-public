    31	              AugAssign(Name("extension_strength"), "-", Int(1)),
    32	              .Stmts))
    33	          If(Compare(Name("extension_strength"),
    34	                     CmpOp(">", Name("strongest_strength"))),
    35	            Assign(Name("strongest"), Name("extension"))
    36	            Assign(Name("strongest_strength"), Name("extension_strength")),
