bash /audit-output/evidence/stage3_reconstruct.sh 2>&1 | tee /audit-output/evidence/stage3_reconstruct.log
rc=${PIPESTATUS[0]}
echo "wrapper_exit=$rc" | tee -a /audit-output/evidence/stage3_reconstruct.log
exit "$rc"' in /audit-output
