tring ::= Float2String ( Float , format: String )     [function, symbol(FloatFormat), hook(STRING.floatFormat)]\n1815:  syntax Float  ::= String2Float ( String )             [function, hook(STRING.string2float)]\n1818:### String and integer conversions\n1820:You can convert between a `String` and an `Int`. The String will be represented\n1822:optionally prefixed by a sign). When converting from an `Int` to a `String`,\n1825:You can also convert between a `String` and an `Int` in a particular radix.\n1829:and lowercase letters are supported by `String2Base`. Whether the letters\n1830:returned by `Base2String` are upper or lowercase is determined by the backend,\n1834:  syntax Int    ::= String2Int   ( String )             [function, hook(STRING.string2int)]\n1835:  syntax String ::= Int2String   ( Int )                [function, total, hook(STRING.int2string)]\n1836:  syntax String ::= Base2String  ( Int , base: Int )          [function, hook(STRING.base2string)]\n1837:  syntax Int    ::= String2Base  ( String , base: Int )       [function, hook(STRING.string2base)]\n1840:### String count and replace\n1852:  syntax String ::= \"replaceAll\" \"(\" haystack: String \",\" needle: String \",\" replacement: String \")\"      [function, total, hook(STRING.replaceAll)]\n1853:  syntax String ::= \"replace\" \"(\" haystack: String \",\" needle: String \",\" replacement: String \",\" times: Int \")\" [function, hook(STRING.replace)]\n1854:  syntax String ::= \"replaceFirst\" \"(\" haystack: String \",\" needle: String \",\" replacement: String \")\"    [function, total, hook(STRING.replaceFirst)]\n1855:  syntax Int ::= \"countAllOccurrences\" \"(\" haystack: String \",\" needle: String \")\"            [function, total, hook(STRING.countAllOccurrences)]\n1858:### String equality and lexicographic comparison\n1862:another according to the natural lexicographic ordering of strings.\n1865:  syntax Bool ::= String \"==String\" String  [function, total, comm, hook(STRING.eq)]\n1866:                | String \"=/=String\" String [function, total, comm, hook(STRING.ne)]\n1867:  rule S1:String =/=String S2:String => notBool (S1 ==String S2)\n1869:  syntax Bool ::= String  \"<String\" String [function, total, hook(STRING.lt)]\n1870:                | String \"<=String\" String [function, total, hook(STRING.le)]\n1871:                | String  \">String\" String [function, total, hook(STRING.gt)]\n1872:                | String \">=String\" String [function, total, hook(STRING.ge)]\n1875:### Implementation of Strings\n1877:What follows is a few String hooks which are deprecated and only are supported\n1882:  syntax String ::= categoryChar(String)       [function, hook(STRING.category)]\n1883:                  | directionalityChar(String) [function, hook(STRING.directionality)]\n1885:  syntax String ::= \"newUUID\" [function, hook(STRING.uuid), impure]\n1887:  rule S1:String <=String S2:String => notBool (S2 <String S1)\n1888:  rule S1:String >String S2:String => S2 <String S1\n1889:  rule S1:String >=String S2:String => notBool (S1 <String S2)\n1891:  rule findChar(S1:String, S2:String, I:Int) => #if findString(S1, substrString(S2, 0, 1), I) ==Int -1 #then findChar(S1, substrString(S2, 1, lengthString(S2)), I) #else #if findChar(S1, substrString(S2, 1, lengthString(S2)), I) ==Int -1 #then findString(S1, substrString(S2, 0, 1), I) #else minInt(findString(S1, substrString(S2, 0, 1), I), findChar(S1, substrString(S2, 1, lengthString(S2)), I)) #fi #fi requires S2 =/=String \"\"\n1893:  rule rfindChar(S1:String, S2:String, I:Int) => maxInt(rfindString(S1, substrString(S2, 0, 1), I), rfindChar(S1, substrString(S2, 1, lengthString(S2)), I)) requires S2 =/=String \"\"\n1896:  rule countAllOccurrences(Source:String, ToCount:String) => 0\n1897:            requires findString(Source, ToCount, 0) <Int 0\n1898:  rule countAllOccurrences(Source:String, ToCount:String) => 1 +Int countAllOccurrences(substrString(Source, findString(Source, ToCount, 0) +Int lengthString(ToCount), lengthString(Source)), ToCount)\n1899:            requires findString(Source, ToCount, 0) >=Int 0\n1901:  rule replaceFirst(Source:String, ToReplace:String, Replacement:String) => substrString(Source, 0, findString(Source, ToReplace, 0))\n1902:                +String Replacement +String substrString(Source, findString(Source, ToReplace, 0) +Int lengthString(ToReplace), lengthString(Source))\n1903:                requires findString(Source, ToReplace, 0) >=Int 0\n1904:  rule replaceFirst(Source:String, ToReplace:String, _:String) => Source\n1905:        requires findString(Source, ToReplace, 0) <Int 0\n1911:  rule replace(Source:String, ToReplace:String, Replacement:String, Count:Int) =>\n1912:       substrString(Source, 0, findString(Source, ToReplace, 0)) +String Replacement +String\n1913:       replace(substrString(Source, findString(Source, ToReplace, 0) +Int lengthString(ToReplace), lengthString(Source)), ToReplace, Replacement, Count -Int 1)\n1914:        requires Count >Int 0 andBool findString(Source, ToReplace, 0) >=Int 0\n1915:  rule replace(Source:String, _, _, Count) => Source\n1917:  rule replaceAll(Source:String, ToReplace:String, Replacement:String) => replace(Source, ToReplace, Replacement, countAllOccurrences(Source, ToReplace))\n1921:module STRING-KORE [symbolic]\n1925:  rule S1:String ==K S2:String => S1 ==String S2 [simplification]\n1929:module STRING\n1935:String Buffers\n1940:can yield linear performance. We thus provide such a sort, the `StringBuffer`\n1942:`String` module. However, on concrete backends it provides an efficient\n1945:* `.StringBuffer` creates a new `StringBuffer` with current content equal\n1947:* `+String` takes a `StringBuffer` and a `String` and appends the `String` to\n1948:  the end of the `StringBuffer`\n1949:* `StringBuffer2String` converts a `StringBuffer` to a `String`. This operation\n1950:  copies the string so that subsequent modifications to the `StringBuffer`\n1951:  will not change the value of the `String` returned by this function.\n1954:module STRING-BUFFER-IN-K [symbolic]\n1958:  syntax StringBuffer ::= \".StringBuffer\" [function, total]\n1959:  syntax StringBuffer ::= StringBuffer \"+String\" String [function, total, avoid]\n1960:  syntax StringBuffer ::= String\n1961:  syntax String ::= StringBuffer2String ( StringBuffer ) [function, total]\n1963:  rule {SB:String +String S:String}::StringBuffer => (SB +String S)::String\n1964:  rule .StringBuffer => \"\"\n1965:  rule StringBuffer2String(S:String) => S\n1968:module STRING-BUFFER-HOOKED [concrete]\n1972:  syntax StringBuffer [hook(BUFFER.StringBuffer)]\n1973:  syntax StringBuffer ::= \".StringBuffer\" [function, total, hook(BUFFER.empty), impure]\n1974:  syntax StringBuffer ::= StringBuffer \"+String\" String [function, total, hook(BUFFER.concat), avoid]\n1975:  syntax String ::= StringBuffer2String ( StringBuffer ) [function, total, hook(BUFFER.toString)]\n1978:module STRING-BUFFER\n2010:### Encoding/decoding between Bytes and String\n2012:You can encode/decode between Bytes and String using `UTF-8`, `UTF-16LE`, `UTF-16BE`, `UTF-32LE`, and `UTF-32BE`\n2015:    syntax String ::= decodeBytes ( encoding: String , contents: Bytes ) [function, hook(BYTES.decodeBytes)]\n2016:    syntax Bytes ::= encodeBytes ( encoding: String , contents: String ) [function, hook(BYTES.encodeBytes)]\n2059:You can convert from a `Bytes` to an `Int`. In order to do this, the endianness\n2063:byte order.\n2077:via `Bytes2Int`. In other words, if the highest bit set in the magnitude of the\n2087:### String and Bytes conversion\n2089:You can convert between a `Bytes` and a `String` in O(N) time. The resulting\n2094:  syntax String ::= Bytes2String(Bytes) [function, total, hook(BYTES.bytes2string)]\n2096:  syntax Bytes ::= String2Bytes(String) [function, total, hook(BYTES.string2bytes)]\n2274:* `Id2String` - Convert an `Id` to a `String` containing its name\n2275:* `String2Id` - Convert a `String` to an `Id` with the specified name\n2295:  syntax String ::= Id2String ( Id )    [function, total, hook(STRING.token2string)]\n2296:  syntax Id ::= String2Id (String) [function, total, hook(STRING.string2token)]\n2299:  rule freshId(I:Int) => String2Id(\"_\" +String Int2String(I))\n2381:  syntax String ::= #sort(K) [function, hook(KREFLECTION.sort)]\n2382:  syntax KItem ::= #fresh(String)   [function, hook(KREFLECTION.fresh), impure]\n2385:  syntax K ::= #getenv(String) [function, impure, hook(KREFLECTION.getenv)]\n2387:  syntax String ::= #kompiledDirectory() [function, hook(KREFLECTION.kompiledDir)]\n2393:  syntax {Sort} String ::= #unparseKORE(Sort) [function, hook(KREFLECTION.printKORE)]\n2394:  syntax IOError ::= \"#noParse\" \"(\" String \")\" [symbol(#noParse)]\n2506:either a `String` or an `IOError`. These sorts are used to implement the\n2513:  syntax IOString ::= String | IOError\n2523:  syntax IOInt ::= \"#open\" \"(\" path: String \")\" [function]\n2524:               | \"#open\" \"(\" path: String \",\" mode: String \")\" [function, hook(IO.open), impure]\n2526:  rule #open(S:String) => #open(S:String, \"r+\")\n2554:  syntax IOString ::= \"#read\" \"(\" fd: Int \",\" length: Int \")\"    [function, hook(IO.read), impure]\n2564:             | \"#write\" \"(\" fd: Int \",\" value: String \")\" [function, hook(IO.write), impure]\n2593:in order to support creating stateful request/response servers where the\n2635:  syntax KItem ::= #system ( String ) [function, hook(IO.system), impure]\n2636:                 | \"#systemResult\" \"(\" Int /* exit code */ \",\" String /* stdout */ \",\" String /* stderr */ \")\" [symbol(#systemResult)]\n2646:  syntax IOFile ::= #mkstemp(template: String) [function, hook(IO.mkstemp), impure]\n2648:                  | \"#tempFile\" \"(\" path: String \",\" fd: Int \")\" [symbol(#tempFile)]\n2657:  syntax K ::= #remove(path: String) [function, total, hook(IO.remove), impure]\n2669:  syntax K ::= #logToFile(name: String, value: String) [function, total, hook(IO.log