+(( rc == 0 )) || status=1
+
+echo '$ submitted MPY and proof macro KORE identity (recheck)'
+cmp -s /tmp/audit-work/submitted.kore /tmp/audit-work/macro.kore
+rc=$?
+echo "cmp_exit=$rc"
+(( rc == 0 )) || status=1
+sha256sum /tmp/audit-work/submitted.kore /tmp/audit-work/macro.kore
