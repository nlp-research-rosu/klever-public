    "strongest" |-> strVal ( "SErviNGSliCes" )
    "strongest_strength" |-> intVal ( -1 )
  </env>
  <functions>
    "Strongest_Extension" |-> function ( Params ( "class_name" , "extensions" ) , Assign ( Name ( "strongest" ) , Subscript ( Name ( "extensions" ) , Int ( 0 ) ) )  Assign ( Name ( "strongest_strength" ) , Int ( 0 ) )  For ( Name ( "character" ) , Name ( "strongest" ) , If ( Call ( Attribute ( Name ( "character" ) , "isupper" ) , .Exprs ) , AugAssign ( Name ( "strongest_strength" ) , "+" , Int ( 1 ) )  .Stmts , .Stmts )  If ( Call ( Attribute ( Name ( "character" ) , "islower" ) , .Exprs ) , AugAssign ( Name ( "strongest_strength" ) , "-" , Int ( 1 ) )  .Stmts , .Stmts )  .Stmts )  For ( Name ( "extension" ) , Subscript ( Name ( "extensions" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , Assign ( Name ( "extension_strength" ) , Int ( 0 ) )  For ( Name ( "character" ) , Name ( "extension" ) , If ( Call ( Attribute ( Name ( "character" ) , "isupper" ) , .Exprs ) , AugAssign ( Name ( "extension_strength" ) , "+" , Int ( 1 ) )  .Stmts , .Stmts )  If ( Call ( Attribute ( Name ( "character" ) , "islower" ) , .Exprs ) , AugAssign ( Name ( "extension_strength" ) , "-" , Int ( 1 ) )  .Stmts , .Stmts )  .Stmts )  If ( Compare ( Name ( "extension_strength" ) , CmpOp ( ">" , Name ( "strongest_strength" ) ) , .CmpOps ) , Assign ( Name ( "strongest" ) , Name ( "extension" ) )  Assign ( Name ( "strongest_strength" ) , Name ( "extension_strength" ) )  .Stmts , .Stmts )  .Stmts )  Return ( BinOp ( "+" , BinOp ( "+" , Name ( "class_name" ) , Str ( "." ) ) , Name ( "strongest" ) ) )  .Stmts )
  </functions>
  <inputClass>
    "Slices"
  </inputClass>
  <inputExtensions>
    strVal ( "SErviNGSliCes" ) ; strVal ( "Cheese" ) ; strVal ( "StuFfed" ) ; .Values
