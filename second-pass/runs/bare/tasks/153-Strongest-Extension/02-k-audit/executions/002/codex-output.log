+  "$scratch/canonical.py" "$scratch/solution.py"
+diff_status=$?
+echo "exit_status=$diff_status (nonzero means a semantic mismatch was found)"
+
+if [[ $regen_status -ne 0 || $cmp_status -ne 0 || $hash_status -ne 0 ]]; then
+  exit 2
+fi
+exit "$diff_status"
