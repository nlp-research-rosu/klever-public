     7	module MPY-SYNTAX
     8	  imports INT-SYNTAX
     9	  imports STRING-SYNTAX
    10	  imports BOOL-SYNTAX
    11	
    12	  syntax Program ::= Module ( Stmts )
    13	
    14	  syntax Stmts ::= List{Stmt, ""}
    15	  syntax Params ::= Params ( String , String )
    16	  syntax Exprs ::= List{Expr,","}
    17	  syntax CmpOps ::= List{CmpOp,","}
    18	
    19	  syntax Stmt ::= FuncDef ( String , Params , Stmts )
    20	                | Assign ( Expr , Expr ) [strict(2)]
    21	                | AugAssign ( Expr , String , Expr ) [strict(3)]
    22	                | If ( Expr , Stmts , Stmts ) [strict(1)]
    23	                | For ( Expr , Expr , Stmts ) [strict(2)]
    24	                | Return ( Expr ) [strict]
    25	
    26	  syntax Expr ::= Int ( Int )
    27	                | Str ( String )
    28	                | Name ( String )
    29	                | BinOp ( String , Expr , Expr ) [strict(2,3)]
    30	                | Compare ( Expr , CmpOps ) [strict(1)]
    31	                | Subscript ( Expr , Expr ) [strict(1)]
    32	                | Slice ( Bound , Bound , Bound )
    33	                | Attribute ( Expr , String ) [strict(1)]
    34	                | Call ( Expr , Exprs ) [strict(1)]
    35	
    36	  syntax CmpOp ::= CmpOp ( String , Expr )
    37	  syntax Bound ::= Expr | "NoBound"
    38	endmodule
    39	
    40	module MPY-SEMANTIC
    41	  imports MPY-SYNTAX
    42	  imports INT
    43	  imports STRING
    44	  imports BOOL
    45	  imports MAP
    46	
    47	  // Runtime values.  A semicolon deliberately separates Values so this list
    48	  // syntax cannot be confused with constructor argument commas.
    49	  syntax Value ::= "intVal" "(" Int ")"
    50	                 | "strVal" "(" String ")"
    51	                 | "listVal" "(" Values ")"
    52	                 | "boolVal" "(" Bool ")"
    53	                 | "boundStringMethod" "(" String "," String ")"
    54	  syntax Values ::= List{Value,";"}
    55	  syntax KResult ::= Value
    56	  syntax Expr ::= Value
    57	
    58	  syntax Function ::= "function" "(" Params "," Stmts ")"
    59	  syntax Result ::= "noResult" | "returned" "(" Value ")"
    60	
    61	  configuration
    62	    <py>
    63	      <k> $PGM:Program ~> #start </k>
    64	      <env> .Map </env>
    65	      <functions> .Map </functions>
    66	      <inputClass> $CLASS:String </inputClass>
    67	      <inputExtensions> $EXTENSIONS:Values </inputExtensions>
    68	      <result> noResult </result>
    69	    </py>
    70	
    71	  syntax KItem ::= "exec" "(" Stmts ")"
    72	                 | "setVar" "(" String "," Value ")"
    73	                 | "loopValues" "(" String "," Values "," Stmts ")"
    74	                 | "loopString" "(" String "," String "," Int "," Stmts ")"
    75	                 | "#start"
    76	
    77	  // Module loading and ordinary statement sequencing.
    78	  rule <k> Module(S) => exec(S) ... </k>
    79	  rule <k> exec(.Stmts) => .K ... </k>
    80	  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
    81	
    82	  rule <k> FuncDef(F, P, BODY) => .K ... </k>
