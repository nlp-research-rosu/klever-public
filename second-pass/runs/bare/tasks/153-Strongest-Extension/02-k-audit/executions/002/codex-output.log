import hashlib,os

def variants(root, exclude_cache=False):
    root=Path(root)
    files=sorted(p for p in root.rglob('*') if p.is_file() and not (exclude_cache and '__pycache__' in p.parts))
    dirs=sorted(p for p in root.rglob('*') if p.is_dir() and not (exclude_cache and '__pycache__' in p.parts))
    rel=lambda p:p.relative_to(root).as_posix()
