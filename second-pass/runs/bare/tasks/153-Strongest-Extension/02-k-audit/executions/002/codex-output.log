     3	// Verification-only name for the exact constructor tree in solution.mpy.
     4	// Keeping it as a macro makes claims readable; macro expansion removes the
     5	// name before proving, so all execution uses MPY-SEMANTIC's source rules.
     6	module VERIFICATION
     7	  imports MPY-SEMANTIC
     8	
     9	  syntax Program ::= "StrongestProgram" [macro]
    10	
    11	  rule StrongestProgram =>
    12	    Module(
    13	      FuncDef("Strongest_Extension", Params("class_name", "extensions"),
    14	        Assign(Name("strongest"), Subscript(Name("extensions"), Int(0)))
    15	        Assign(Name("strongest_strength"), Int(0))
    16	        For(Name("character"), Name("strongest"),
    17	          If(Call(Attribute(Name("character"), "isupper"), .Exprs),
    18	            AugAssign(Name("strongest_strength"), "+", Int(1)),
    19	            .Stmts)
    20	          If(Call(Attribute(Name("character"), "islower"), .Exprs),
    21	            AugAssign(Name("strongest_strength"), "-", Int(1)),
    22	            .Stmts))
    23	        For(Name("extension"),
    24	            Subscript(Name("extensions"), Slice(Int(1), NoBound, NoBound)),
    25	          Assign(Name("extension_strength"), Int(0))
    26	          For(Name("character"), Name("extension"),
    27	            If(Call(Attribute(Name("character"), "isupper"), .Exprs),
    28	              AugAssign(Name("extension_strength"), "+", Int(1)),
    29	              .Stmts)
    30	            If(Call(Attribute(Name("character"), "islower"), .Exprs),
    31	              AugAssign(Name("extension_strength"), "-", Int(1)),
    32	              .Stmts))
    33	          If(Compare(Name("extension_strength"),
    34	                     CmpOp(">", Name("strongest_strength"))),
    35	            Assign(Name("strongest"), Name("extension"))
    36	            Assign(Name("strongest_strength"), Name("extension_strength")),
    37	            .Stmts))
    38	        Return(BinOp("+",
    39	          BinOp("+", Name("class_name"), Str(".")),
    40	          Name("strongest")))))
    41	
    42	  // A verification-only mathematical rendering of the contract.  It is
    43	  // independent of statement execution: refStrength counts character classes,
    44	  // and refSelect performs a left fold whose strict comparison preserves the
    45	  // first candidate on ties.
    46	  syntax Int ::= "refDelta" "(" String ")" [function]
    47	               | "refStrength" "(" String ")" [function]
    48	               | "refStrengthAt" "(" String "," Int ")" [function]
    49	  syntax String ::= "refStrongest" "(" Values ")" [function]
    50	                  | "refSelect" "(" String "," Int "," Values ")" [function]
    51	
    52	  rule refDelta(S) => 1
    53	       requires isUpperChar(S)
    54	  rule refDelta(S) => -1
    55	       requires notBool isUpperChar(S) andBool isLowerChar(S)
    56	  rule refDelta(S) => 0
    57	       requires notBool isUpperChar(S) andBool notBool isLowerChar(S)
    58	
    59	  rule refStrength(S) => refStrengthAt(S, 0)
    60	  rule refStrengthAt(S, I) => 0
    61	       requires I >=Int lengthString(S)
    62	  rule refStrengthAt(S, I)
    63	    => refDelta(substrString(S, I, I +Int 1))
    64	       +Int refStrengthAt(S, I +Int 1)
    65	       requires I <Int lengthString(S)
    66	
    67	  rule refStrongest(strVal(S) ; REST)
    68	    => refSelect(S, refStrength(S), REST)
    69	  rule refSelect(BEST, _, .Values) => BEST
    70	  rule refSelect(_, BESTSCORE, strVal(S) ; REST)
    71	    => refSelect(S, refStrength(S), REST)
    72	       requires refStrength(S) >Int BESTSCORE
    73	  rule refSelect(BEST, BESTSCORE, strVal(S) ; REST)
    74	    => refSelect(BEST, BESTSCORE, REST)
    75	       requires refStrength(S) <=Int BESTSCORE
    76	endmodule
