+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/153-strongest-extension
+labels=(
+  prompt_worked
+  prompt_tie
+  later_stronger
+  uncased_characters
+  empty_first
+  all_negative
+  singleton
+)
+overall=0
+
