diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2771620af476a57e1bde9d9a5043c688e1006307
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,76 @@
+requires "semantic.k"
+
+// Verification-only name for the exact constructor tree in solution.mpy.
+// Keeping it as a macro makes claims readable; macro expansion removes the
+// name before proving, so all execution uses MPY-SEMANTIC's source rules.
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  syntax Program ::= "StrongestProgram" [macro]
+
+  rule StrongestProgram =>
+    Module(
+      FuncDef("Strongest_Extension", Params("class_name", "extensions"),
+        Assign(Name("strongest"), Subscript(Name("extensions"), Int(0)))
+        Assign(Name("strongest_strength"), Int(0))
+        For(Name("character"), Name("strongest"),
+          If(Call(Attribute(Name("character"), "isupper"), .Exprs),
+            AugAssign(Name("strongest_strength"), "+", Int(1)),
+            .Stmts)
+          If(Call(Attribute(Name("character"), "islower"), .Exprs),
+            AugAssign(Name("strongest_strength"), "-", Int(1)),
+            .Stmts))
+        For(Name("extension"),
+            Subscript(Name("extensions"), Slice(Int(1), NoBound, NoBound)),
+          Assign(Name("extension_strength"), Int(0))
+          For(Name("character"), Name("extension"),
+            If(Call(Attribute(Name("character"), "isupper"), .Exprs),
+              AugAssign(Name("extension_strength"), "+", Int(1)),
+              .Stmts)
+            If(Call(Attribute(Name("character"), "islower"), .Exprs),
+              AugAssign(Name("extension_strength"), "-", Int(1)),
+              .Stmts))
+          If(Compare(Name("extension_strength"),
+                     CmpOp(">", Name("strongest_strength"))),
+            Assign(Name("strongest"), Name("extension"))
+            Assign(Name("strongest_strength"), Name("extension_strength")),
+            .Stmts))
+        Return(BinOp("+",
+          BinOp("+", Name("class_name"), Str(".")),
+          Name("strongest")))))
+
+  // A verification-only mathematical rendering of the contract.  It is
+  // independent of statement execution: refStrength counts character classes,
+  // and refSelect performs a left fold whose strict comparison preserves the
+  // first candidate on ties.
+  syntax Int ::= "refDelta" "(" String ")" [function]
+               | "refStrength" "(" String ")" [function]
+               | "refStrengthAt" "(" String "," Int ")" [function]
+  syntax String ::= "refStrongest" "(" Values ")" [function]
+                  | "refSelect" "(" String "," Int "," Values ")" [function]
+
+  rule refDelta(S) => 1
+       requires isUpperChar(S)
+  rule refDelta(S) => -1
+       requires notBool isUpperChar(S) andBool isLowerChar(S)
+  rule refDelta(S) => 0
+       requires notBool isUpperChar(S) andBool notBool isLowerChar(S)
+
+  rule refStrength(S) => refStrengthAt(S, 0)
+  rule refStrengthAt(S, I) => 0
+       requires I >=Int lengthString(S)
+  rule refStrengthAt(S, I)
+    => refDelta(substrString(S, I, I +Int 1))
+       +Int refStrengthAt(S, I +Int 1)
+       requires I <Int lengthString(S)
+
+  rule refStrongest(strVal(S) ; REST)
+    => refSelect(S, refStrength(S), REST)
+  rule refSelect(BEST, _, .Values) => BEST
+  rule refSelect(_, BESTSCORE, strVal(S) ; REST)
+    => refSelect(S, refStrength(S), REST)
+       requires refStrength(S) >Int BESTSCORE
+  rule refSelect(BEST, BESTSCORE, strVal(S) ; REST)
+    => refSelect(BEST, BESTSCORE, REST)
+       requires refStrength(S) <=Int BESTSCORE
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..4de95842c3983954e85591c2181c9e6fa2b65990
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,157 @@
+// A small executable semantics for the py2mpy constructors used by solution.py.
+// It models Python integers, strings, lists, local variables, sequencing,
+// conditionals, for-loops, method calls to str.isupper/islower, and return.
+
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports BOOL-SYNTAX
+
+  syntax Program ::= Module ( Stmts )
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= Params ( String , String )
+  syntax Exprs ::= List{Expr,","}
+  syntax CmpOps ::= List{CmpOp,","}
+
+  syntax Stmt ::= FuncDef ( String , Params , Stmts )
+                | Assign ( Expr , Expr ) [strict(2)]
+                | AugAssign ( Expr , String , Expr ) [strict(3)]
+                | If ( Expr , Stmts , Stmts ) [strict(1)]
+                | For ( Expr , Expr , Stmts ) [strict(2)]
+                | Return ( Expr ) [strict]
+
+  syntax Expr ::= Int ( Int )
+                | Str ( String )
+                | Name ( String )
+                | BinOp ( String , Expr , Expr ) [strict(2,3)]
+                | Compare ( Expr , CmpOps ) [strict(1)]
+                | Subscript ( Expr , Expr ) [strict(1)]
+                | Slice ( Bound , Bound , Bound )
+                | Attribute ( Expr , String ) [strict(1)]
+                | Call ( Expr , Exprs ) [strict(1)]
+
+  syntax CmpOp ::= CmpOp ( String , Expr )
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+  imports MAP
+
+  // Runtime values.  A semicolon deliberately separates Values so this list
+  // syntax cannot be confused with constructor argument commas.
+  syntax Value ::= "intVal" "(" Int ")"
+                 | "strVal" "(" String ")"
+                 | "listVal" "(" Values ")"
+                 | "boolVal" "(" Bool ")"
+                 | "boundStringMethod" "(" String "," String ")"
+  syntax Values ::= List{Value,";"}
+  syntax KResult ::= Value
+  syntax Expr ::= Value
+
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+  syntax Result ::= "noResult" | "returned" "(" Value ")"
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> #start </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <inputClass> $CLASS:String </inputClass>
+      <inputExtensions> $EXTENSIONS:Values </inputExtensions>
+      <result> noResult </result>
+    </py>
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "setVar" "(" String "," Value ")"
+                 | "loopValues" "(" String "," Values "," Stmts ")"
+                 | "loopString" "(" String "," String "," Int "," Stmts ")"
+                 | "#start"
+
+  // Module loading and ordinary statement sequencing.
+  rule <k> Module(S) => exec(S) ... </k>
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
+
+  rule <k> FuncDef(F, P, BODY) => .K ... </k>
+       <functions> FS => FS [ F <- function(P, BODY) ] </functions>
+
+  // This task's required entry point is called after the translated module
+  // has installed its definition.  Parameters are bound by their source names.
+  rule <k> #start => exec(BODY) ... </k>
+       <functions> ... "Strongest_Extension" |-> function(Params("class_name", "extensions"), BODY) ... </functions>
+       <inputClass> C </inputClass>
+       <inputExtensions> ES </inputExtensions>
+       <env> _ => "class_name" |-> strVal(C)
+                  "extensions" |-> listVal(ES) </env>
+
+  // Literals, lookup, and assignment.
+  rule Int(I) => intVal(I)
+  rule Str(S) => strVal(S)
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V:Value ... </env>
+
+  rule <k> Assign(Name(X), V:Value) => .K ... </k>
+       <env> ENV => ENV [ X <- V ] </env>
+  rule <k> setVar(X, V) => .K ... </k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule <k> AugAssign(Name(X), "+", intVal(I)) => .K ... </k>
+       <env> X |-> intVal(J) ENV => X |-> intVal(J +Int I) ENV </env>
+  rule <k> AugAssign(Name(X), "-", intVal(I)) => .K ... </k>
+       <env> X |-> intVal(J) ENV => X |-> intVal(J -Int I) ENV </env>
+
+  // The two subscript forms emitted by this solution: [0] and [1:].
+  rule Subscript(listVal(V ; _), Int(0)) => V
+  rule Subscript(listVal(_ ; VS), Slice(Int(1), NoBound, NoBound))
+    => listVal(VS)
+
+  // List and string iteration.  The string loop exposes one Unicode code
+  // point at a time through K's String hooks.
+  rule <k> For(Name(X), listVal(VS), BODY) => loopValues(X, VS, BODY) ... </k>
+  rule <k> loopValues(_, .Values, _) => .K ... </k>
+  rule <k> loopValues(X, V ; VS, BODY)
+        => setVar(X, V) ~> exec(BODY) ~> loopValues(X, VS, BODY) ... </k>
+
+  rule <k> For(Name(X), strVal(S), BODY) => loopString(X, S, 0, BODY) ... </k>
+  rule <k> loopString(_, S, I, _) => .K ... </k>
+       requires I >=Int lengthString(S)
+  rule <k> loopString(X, S, I, BODY)
+        => setVar(X, strVal(substrString(S, I, I +Int 1)))
+           ~> exec(BODY) ~> loopString(X, S, I +Int 1, BODY) ... </k>
+       requires I <Int lengthString(S)
+
+  // String methods needed by the program.  For one-character strings,
+  // CPython's ASCII upper/lower cases coincide with these code-point ranges.
+  syntax Bool ::= "isUpperChar" "(" String ")" [function, total]
+                | "isLowerChar" "(" String ")" [function, total]
+  rule isUpperChar(S) => (65 <=Int ordChar(S)) andBool (ordChar(S) <=Int 90)
+  rule isLowerChar(S) => (97 <=Int ordChar(S)) andBool (ordChar(S) <=Int 122)
+
+  rule Attribute(strVal(S), METHOD) => boundStringMethod(S, METHOD)
+  rule Call(boundStringMethod(S, "isupper"), .Exprs)
+    => boolVal(isUpperChar(S))
+  rule Call(boundStringMethod(S, "islower"), .Exprs)
+    => boolVal(isLowerChar(S))
+
+  rule If(boolVal(true), THEN, _) => exec(THEN)
+  rule If(boolVal(false), _, ELSE) => exec(ELSE)
+
+  rule BinOp("+", intVal(I), intVal(J)) => intVal(I +Int J)
+  rule BinOp("+", strVal(S), strVal(T)) => strVal(S +String T)
+  rule <k> Compare(intVal(I), CmpOp(">", Name(X))) => boolVal(I >Int J) ... </k>
+       <env> ... X |-> intVal(J) ... </env>
+
+  rule <k> Return(V:Value) => .K ... </k>
+       <result> noResult => returned(V) </result>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTIC
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..78fc34cd35855be90230d8f17b0a81de2c83c4d3
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,21 @@
+def Strongest_Extension(class_name, extensions):
+    strongest = extensions[0]
+    strongest_strength = 0
+    for character in strongest:
+        if character.isupper():
+            strongest_strength += 1
+        if character.islower():
+            strongest_strength -= 1
+
+    for extension in extensions[1:]:
+        extension_strength = 0
+        for character in extension:
+            if character.isupper():
+                extension_strength += 1
+            if character.islower():
+                extension_strength -= 1
+        if extension_strength > strongest_strength:
+            strongest = extension
+            strongest_strength = extension_strength
+
+    return class_name + "." + strongest
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..be2d963641bd3787df43a6f6744327dddc186f49
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,88 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The prompt's worked example.
+  claim
+    <py>
+      <k> StrongestProgram ~> #start => .K </k>
+      <env> .Map => ?_:Map </env>
+      <functions> .Map => ?_:Map </functions>
+      <inputClass> "Slices" </inputClass>
+      <inputExtensions>
+        strVal("SErviNGSliCes") ; strVal("Cheese") ; strVal("StuFfed")
+      </inputExtensions>
+      <result> noResult => returned(strVal("Slices.SErviNGSliCes")) </result>
+    </py>
+
+  // Equal strengths retain the earliest extension.  The class name is
+  // symbolic here, so this claim covers every class-name string.
+  claim
+    <py>
+      <k> StrongestProgram ~> #start => .K </k>
+      <env> .Map => ?_:Map </env>
+      <functions> .Map => ?_:Map </functions>
+      <inputClass> C:String </inputClass>
+      <inputExtensions> strVal("AA") ; strVal("Be") ; strVal("CC") </inputExtensions>
+      <result> noResult => returned(strVal((C +String ".") +String "AA")) </result>
+    </py>
+
+  // A later extension replaces the current one only when its score is
+  // strictly greater.
+  claim
+    <py>
+      <k> StrongestProgram ~> #start => .K </k>
+      <env> .Map => ?_:Map </env>
+      <functions> .Map => ?_:Map </functions>
+      <inputClass> C:String </inputClass>
+      <inputExtensions> strVal("abc") ; strVal("AB") ; strVal("A-b") </inputExtensions>
+      <result> noResult => returned(strVal((C +String ".") +String "AB")) </result>
+    </py>
+
+  // Digits and punctuation contribute zero; uppercase contributes +1 and
+  // lowercase contributes -1.
+  claim
+    <py>
+      <k> StrongestProgram ~> #start => .K </k>
+      <env> .Map => ?_:Map </env>
+      <functions> .Map => ?_:Map </functions>
+      <inputClass> C:String </inputClass>
+      <inputExtensions> strVal("a-1") ; strVal("--") ; strVal("A!") </inputExtensions>
+      <result> noResult => returned(strVal((C +String ".") +String "A!")) </result>
+    </py>
+
+  // Empty and uncased extension names all have score zero, so the empty
+  // first element wins the tie.
+  claim
+    <py>
+      <k> StrongestProgram ~> #start => .K </k>
+      <env> .Map => ?_:Map </env>
+      <functions> .Map => ?_:Map </functions>
+      <inputClass> C:String </inputClass>
+      <inputExtensions> strVal("") ; strVal("123") ; strVal("!") </inputExtensions>
+      <result> noResult => returned(strVal((C +String ".") +String "")) </result>
+    </py>
+
+  // Scores may all be negative; the least-negative candidate still wins.
+  claim
+    <py>
+      <k> StrongestProgram ~> #start => .K </k>
+      <env> .Map => ?_:Map </env>
+      <functions> .Map => ?_:Map </functions>
+      <inputClass> C:String </inputClass>
+      <inputExtensions> strVal("abcd") ; strVal("a") ; strVal("xy") </inputExtensions>
+      <result> noResult => returned(strVal((C +String ".") +String "a")) </result>
+    </py>
+
+  // The nonempty-list boundary case.
+  claim
+    <py>
+      <k> StrongestProgram ~> #start => .K </k>
+      <env> .Map => ?_:Map </env>
+      <functions> .Map => ?_:Map </functions>
+      <inputClass> C:String </inputClass>
+      <inputExtensions> strVal("Zz") </inputExtensions>
+      <result> noResult => returned(strVal((C +String ".") +String "Zz")) </result>
+    </py>
+endmodule
