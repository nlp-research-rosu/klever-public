(LblCmpOp'LParUndsCommUndsRParUnds'MPY-SYNTAX'Unds'CmpOp'Unds'String'Unds'Expr{}(\dv{SortString{}}(">"),LblName'LParUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String{}(\dv{SortString{}}("strongest_strength"))),Lbl'Stop'List'LBraQuotUndsCommUndsUnds'MPY-SYNTAX'Unds'CmpOps'Unds'CmpOp'Unds'CmpOps'QuotRBraUnds'CmpOps{}())),Lbl'UndsUndsUnds'MPY-SYNTAX'Unds'Stmts'Unds'Stmt'Unds'Stmts{}(LblAssign'LParUndsCommUndsRParUnds'MPY-SYNTAX'Unds'Stmt'Unds'Expr'Unds'Expr{}(LblName'LParUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String{}(\dv{SortString{}}("strongest")),LblName'LParUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String{}(\dv{SortString{}}("extension"))),Lbl'UndsUndsUnds'MPY-SYNTAX'Unds'Stmts'Unds'Stmt'Unds'Stmts{}(LblAssign'LParUndsCommUndsRParUnds'MPY-SYNTAX'Unds'Stmt'Unds'Expr'Unds'Expr{}(LblName'LParUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String{}(\dv{SortString{}}("strongest_strength")),LblName'LParUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String{}(\dv{SortString{}}("extension_strength"))),Lbl'Stop'List'LBraQuotUndsUndsUnds'MPY-SYNTAX'Unds'Stmts'Unds'Stmt'Unds'Stmts'QuotRBraUnds'Stmts{}())),Lbl'Stop'List'LBraQuotUndsUndsUnds'MPY-SYNTAX'Unds'Stmts'Unds'Stmt'Unds'Stmts'QuotRBraUnds'Stmts{}()),Lbl'Stop'List'LBraQuotUndsUndsUnds'MPY-SYNTAX'Unds'Stmts'Unds'Stmt'Unds'Stmts'QuotRBraUnds'Stmts{}())))),Lbl'UndsUndsUnds'MPY-SYNTAX'Unds'Stmts'Unds'Stmt'Unds'Stmts{}(LblReturn'LParUndsRParUnds'MPY-SYNTAX'Unds'Stmt'Unds'Expr{}(LblBinOp'LParUndsCommUndsCommUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String'Unds'Expr'Unds'Expr{}(\dv{SortString{}}("+"),LblBinOp'LParUndsCommUndsCommUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String'Unds'Expr'Unds'Expr{}(\dv{SortString{}}("+"),LblName'LParUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String{}(\dv{SortString{}}("class_name")),LblStr'LParUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String{}(\dv{SortString{}}("."))),LblName'LParUndsRParUnds'MPY-SYNTAX'Unds'Expr'Unds'String{}(\dv{SortString{}}("strongest")))),Lbl'Stop'List'LBraQuotUndsUndsUnds'MPY-SYNTAX'Unds'Stmts'Unds'Stmt'Unds'