      "module": "VERIFICATION",
      "normalized_sha256": "d4ef40fe9e72b4a01ee701f6d6971ab3c47b2cb15ab743e809966b320fa2025e",
      "rationale": "Defines the per-character decoding summary as subtraction by five modulo the 26 lowercase character codes.",
      "source_rule_id": "rule-d4ef40fe9e72b4a01ee701f6d6971ab3c47b2cb15ab743e809966b320fa2025e",
      "start_line": 11,
      "text": "  rule decodeCode(C) => ((C -Int 5 -Int 97) modInt 26) +Int 97"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 14,
      "module": "VERIFICATION",
      "normalized_sha256": "1ea18c24cdb3a1935f7d7f77f6fb4e066945fe3501b1b600338f893826670097",
      "rationale": "Defines the empty-sequence base case of the recursive decodeSpec mathematical summary.",
      "source_rule_id": "rule-1ea18c24cdb3a1935f7d7f77f6fb4e066945fe3501b1b600338f893826670097",
      "start_line": 14,
      "text": "  rule decodeSpec(nil) => nil"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "52973ed25e536e8d1b46be38eaf35edbdd02e2dd02c53d61ef885e05950035ac",
      "rationale": "Defines decodeSpec recursively by decoding the head character and then the remaining sequence.",
      "source_rule_id": "rule-52973ed25e536e8d1b46be38eaf35edbdd02e2dd02c53d61ef885e05950035ac",
      "start_line": 15,
      "text": "  rule decodeSpec(cons(C, CS)) => cons(decodeCode(C), decodeSpec(CS))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "bf869afd467d96c7f40ef972137daeb64051501927c30f112761f5bd7afa6625",
      "rationale": "Defines the per-character encoding summary as addition by five modulo the 26 lowercase character codes.",
      "source_rule_id": "rule-bf869afd467d96c7f40ef972137daeb64051501927c30f112761f5bd7afa6625",
      "start_line": 18,
      "text": "  rule encodeCode(C) => ((C +Int 5 -Int 97) modInt 26) +Int 97"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "f469c289252f391f79088f48b68022ee3475b8af3a4512cab3b85b8bd546dd25",
      "rationale": "Defines the empty-sequence base case of the recursive encodeSpec mathematical summary.",
      "source_rule_id": "rule-f469c289252f391f79088f48b68022ee3475b8af3a4512cab3b85b8bd546dd25",
      "start_line": 21,
      "text": "  rule encodeSpec(nil) => nil"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "98869a9efb7f8a08b961eb88933575887fe7cd8cdeda236cf56a7f98486d94b8",
      "rationale": "Defines encodeSpec recursively by encoding the head character and then the remaining sequence.",
      "source_rule_id": "rule-98869a9efb7f8a08b961eb88933575887fe7cd8cdeda236cf56a7f98486d94b8",
      "start_line": 22,
      "text": "  rule encodeSpec(cons(C, CS)) => cons(encodeCode(C), encodeSpec(CS))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "14730e10b61f875e28e467d4f0865be99395d197f927b3331e5dc6459521473c",
      "rationale": "Defines the named lowercase-code predicate as the inclusive integer range from 97 through 122.",
      "source_rule_id": "rule-14730e10b61f875e28e467d4f0865be99395d197f927b3331e5dc6459521473c",
      "start_line": 25,
      "text": "  rule isLowerCode(C) => 97 <=Int C andBool C <=Int 122"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "a54b1751451da8cc52a08176b0c06449f46d52d2528695a22dc27bd2e131c092",
      "rationale": "Defines the empty-sequence base case of the recursive allLower domain predicate.",
      "source_rule_id": "rule-a54b1751451da8cc52a08176b0c06449f46d52d2528695a22dc27bd2e131c092",
      "start_line": 28,
      "text": "  rule allLower(nil) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "88e0dd7c4b09699c6346cfbedbf81edeb318cc01d7c0826676cdb7529dabad2f",
      "rationale": "Defines allLower recursively as lowercase membership of the head conjoined with allLower on the tail.",
      "source_rule_id": "rule-88e0dd7c4b09699c6346cfbedbf81edeb318cc01d7c0826676cdb7529dabad2f",
      "start_line": 29,
      "text": "  rule allLower(cons(C, CS)) => isLowerCode(C) andBool allLower(CS)"
    }
  ],
