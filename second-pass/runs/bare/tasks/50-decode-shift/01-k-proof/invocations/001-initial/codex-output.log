+requires "semantic.k"
+module DEBUG-SPEC
+  imports SEMANTIC
+  claim <k>
+    Module(FuncDef("decode_shift", Params("s"), Return(
+      Call(Attribute(Str(""), "join"),
+        ListComp(Call(Name("chr"), BinOp("+",
+          BinOp("%", BinOp("-",
+            BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+            Call(Name("ord"), Str("a"))), Int(26)),
+          Call(Name("ord"), Str("a")))),
+          CompFor(Name("ch"), Name("s"), Bool(true)))))))
+    =>
+    Module(FuncDef("decode_shift", Params("s"), Return(
+      Call(Attribute(Str(""), "join"),
+        ListComp(Call(Name("chr"), BinOp("+",
+          BinOp("%", BinOp("-",
+            BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+            Call(Name("ord"), Str("a"))), Int(26)),
+          Call(Name("ord"), Str("a")))),
+          CompFor(Name("ch"), Name("s"), Bool(true)))))))
+  </k>
+        <env> .Map => .Map </env>
+        <input> CS:Chars => CS </input>
+        <result> VChars(decodeSpec(CS)) => VChars(decodeSpec(CS)) </result>
+  requires allLower(CS)
+endmodule
