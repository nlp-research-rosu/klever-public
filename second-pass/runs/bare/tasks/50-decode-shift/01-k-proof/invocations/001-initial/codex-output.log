+        Module(
+          FuncDef("decode_shift", Params("s"),
+            Return(
+              Call(
+                Attribute(Str(""), "join"),
+                ListComp(Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "%",
+                      BinOp(
+                        "-",
+                        BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+                        Call(Name("ord"), Str("a"))),
+                      Int(26)),
+                    Call(Name("ord"), Str("a")))),
+                  CompFor(Name("ch"), Name("s"), Bool(true)))))))
+      </k>
+      <env> .Map </env>
+      <input> CS:Chars </input>
+      <result> .K </result>
+  =>
+      <k> .K </k>
+      <env> .Map </env>
+      <input> CS </input>
+      <result> VChars(decodeSpec(CS)) </result>
+  requires allLower(CS)
+endmodule
