+                      BinOp(
+                        "-",
+                        BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+                        Call(Name("ord"), Str("a"))),
+                      Int(26)),
+                    Call(Name("ord"), Str("a")))),
+                  CompFor(Name("ch"), Name("s"), Bool(true)))))))
+      </k>
+      <env> .Map </env>
+      <input> CS:Chars </input>
+      <result> .K </result>
+    </m>
+  =>
+    <m>
+      <k> .K </k>
+      <env> .Map </env>
