module VERIFICATION
  imports INT
  imports BOOL

  // Inductive character sequences make the string traversal explicit.
  syntax Chars ::= "nil" [constructor]
                 | "cons" "(" Int "," Chars ")" [constructor]

  // The contract-level decoder is independent of the AST evaluator.
  syntax Int ::= decodeCode(Int) [function, total]
  rule decodeCode(C) => ((C -Int 5 -Int 97) modInt 26) +Int 97

  syntax Chars ::= decodeSpec(Chars) [function, total]
  rule decodeSpec(nil) => nil
  rule decodeSpec(cons(C, CS)) => cons(decodeCode(C), decodeSpec(CS))

  syntax Int ::= encodeCode(Int) [function, total]
  rule encodeCode(C) => ((C +Int 5 -Int 97) modInt 26) +Int 97

  syntax Chars ::= encodeSpec(Chars) [function, total]
  rule encodeSpec(nil) => nil
  rule encodeSpec(cons(C, CS)) => cons(encodeCode(C), encodeSpec(CS))

  syntax Bool ::= isLowerCode(Int) [function, total]
  rule isLowerCode(C) => 97 <=Int C andBool C <=Int 122

  syntax Bool ::= allLower(Chars) [function, total]
  rule allLower(nil) => true
  rule allLower(cons(C, CS)) => isLowerCode(C) andBool allLower(CS)
endmodule
requires "verification.k"

module MPY-SYNTAX
  imports INT-SYNTAX
  imports STRING-SYNTAX
  imports BOOL-SYNTAX

  syntax PyModule ::= "Module" "(" Stmts ")"
  syntax Stmts ::= List{Stmt, ""}

  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
                | "Expr" "(" Expr ")"
                | "Return" "(" Expr ")"

  syntax Params ::= "Params" "(" String ")"

  syntax Expr ::= "Str" "(" String ")"
                | "Int" "(" Int ")"
                | "Bool" "(" Bool ")"
                | "Name" "(" String ")"
                | "BinOp" "(" String "," Expr "," Expr ")"
                | "Attribute" "(" Expr "," String ")"
                | "Call" "(" Expr "," Expr ")"
                | "ListComp" "(" Expr "," CompFor ")"

  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Expr ")"
endmodule

module MPY-SEMANTIC
  imports MPY-SYNTAX
  imports INT
  imports STRING
  imports BOOL
  imports VERIFICATION

  syntax Value ::= VInt(Int) [constructor]
                 | VBool(Bool) [constructor]
                 | VText(String) [constructor]
                 | VChar(Int) [constructor]
                 | VChars(Chars) [constructor]
                 | VList(Chars) [constructor]

  syntax KItem ::= exec(Stmts)
                 | eval(Expr)
                 | "discard"
                 | "finish"
                 | binLeft(String, Expr)
                 | binRight(String, Value)
                 | "doOrd"
                 | "doChr"
                 | "doJoin"
                 | comp(String, Expr, Chars)
                 | compTail(String, Expr, Chars, Int)
                 | prepend(Int)

  configuration
    <m>
      <k> $PGM:PyModule </k>
      <s> nil </s>
      <ch> 0 </ch>
      <input> $INPUT:Chars </input>
      <result> .K </result>
    </m>

  // Loading the translated definition also invokes its required entry point.
  rule <k> Module(FuncDef("decode_shift", Params("s"), BODY)) => exec(BODY) </k>
       <s> _ => CS </s>
       <input> CS </input>

  rule <k> exec(.Stmts) => .K </k>
  rule exec(Expr(E) REST) => eval(E) ~> discard ~> exec(REST)
  rule exec(Return(E) _REST) => eval(E) ~> finish

  rule _V:Value ~> discard => .K
  rule <k> V:Value ~> finish => .K </k>
       <result> .K => V </result>

  rule eval(Int(I)) => VInt(I)
  rule eval(Bool(B)) => VBool(B)
  rule eval(Str("")) => VChars(nil)
  rule eval(Str(S)) => VText(S) requires S =/=String ""
  rule <k> eval(Name("s")) => VChars(CS) ...</k>
       <s> CS </s>
  rule <k> eval(Name("ch")) => VChar(C) ...</k>
       <ch> C </ch>

  rule eval(BinOp(OP, LEFT, RIGHT))
    => eval(LEFT) ~> binLeft(OP, RIGHT)
  rule V:Value ~> binLeft(OP, RIGHT)
    => eval(RIGHT) ~> binRight(OP, V)
  rule VInt(J) ~> binRight("+", VInt(I)) => VInt(I +Int J)
  rule VInt(J) ~> binRight("-", VInt(I)) => VInt(I -Int J)
  rule VInt(J) ~> binRight("%", VInt(I)) => VInt(I modInt J)

  rule eval(Call(Name("ord"), ARG)) => eval(ARG) ~> doOrd
  rule VChar(C) ~> doOrd => VInt(C)
  rule VText(S) ~> doOrd => VInt(ordChar(S))

  rule eval(Call(Name("chr"), ARG)) => eval(ARG) ~> doChr
  rule VInt(C) ~> doChr => VChar(C)

  rule eval(Call(Attribute(Str(""), "join"), ARG))
    => eval(ARG) ~> doJoin
  rule VList(CS) ~> doJoin => VChars(CS)

  // A single-generator, unfiltered comprehension over a character sequence.
  // The translator supplies Bool(true) when the Python comprehension has no ifs.
  rule <k> eval(ListComp(E, CompFor(Name(X), Name(Y), Bool(true))))
          => comp(X, E, CS) ...</k>
       <s> CS </s>
    requires Y ==String "s"

  rule comp(_X, _E, nil) => VList(nil)
  rule <k> comp(X, E, cons(C, CS))
          => eval(E) ~> compTail(X, E, CS, OLD) ...</k>
       <ch> OLD => C </ch>
    requires X ==String "ch"
  rule <k> VChar(D) ~> compTail(X, E, CS, SAVED)
          => comp(X, E, CS) ~> prepend(D) ...</k>
       <ch> _CURRENT => SAVED </ch>
  rule VList(DS) ~> prepend(D) => VList(cons(D, DS))
endmodule

module SEMANTIC
  imports MPY-SEMANTIC
endmodule
requires "semantic.k"

module SPEC
  imports SEMANTIC

  // The arithmetic used by decode_shift is the inverse of the prompt's
  // encode_shift arithmetic for every lowercase character code.
  claim <k> decodeCode(encodeCode(C:Int)) => C ...</k>
    requires isLowerCode(C)
  [label(code-inverse)]

  // Loop invariant for the translated comprehension. The environment is
  // restored after each character, so the invariant composes inductively.
  claim
    <k>
      comp("ch",
        Call(
          Name("chr"),
          BinOp(
            "+",
            BinOp(
              "%",
              BinOp(
                "-",
                BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
                Call(Name("ord"), Str("a"))),
              Int(26)),
            Call(Name("ord"), Str("a")))),
        CS:Chars) ~> KONT:K
      => VList(decodeSpec(CS)) ~> KONT
    </k>
    <ch> OLD:Int => OLD </ch>
  requires allLower(CS)
  [label(loop-correct)]

  // For every lowercase input string, execution of the translated solution
  // returns the independently specified per-character Caesar decoding.
  claim
      <k>
        Module(
          FuncDef("decode_shift", Params("s"),
            Return(
              Call(
                Attribute(Str(""), "join"),
                ListComp(Call(
                  Name("chr"),
                  BinOp(
                    "+",
                    BinOp(
                      "%",
                      BinOp(
                        "-",
                        BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
                        Call(Name("ord"), Str("a"))),
                      Int(26)),
                    Call(Name("ord"), Str("a")))),
                  CompFor(Name("ch"), Name("s"), Bool(true)))))))
        => .K
      </k>
      <s> nil => CS </s>
      <ch> 0 => 0 </ch>
      <input> CS:Chars => CS </input>
      <result> .K => VChars(decodeSpec(CS)) </result>
  requires allLower(CS)
  [label(program-correct)]
endmodule
