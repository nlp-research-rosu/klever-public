+    assert observed_ids == expected_ids == []
+    assert len(observed_ids) == len(set(observed_ids))
+    assert generator_manifest["obligation_count"] == len(observed_ids) == 0
+    assert file_sha256(GENERATED / "obligation-map.json") == (
