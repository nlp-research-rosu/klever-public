+requires "semantic.k"
+
+module SPEC-BODY-SENSITIVITY
+  imports SEMANTIC
+
+  // This is the real loop term with its subtraction constant materially
+  // changed from Int(5) to Int(4), while retaining the original decodeSpec
+  // obligation. For CS=cons(102,nil), actual code 98 differs from expected 97.
+  claim
+    <k>
+      comp("ch",
+        Call(
+          Name("chr"),
+          BinOp(
+            "+",
+            BinOp(
+              "%",
+              BinOp(
+                "-",
+                BinOp("-", Call(Name("ord"), Name("ch")), Int(4)),
+                Call(Name("ord"), Str("a"))),
+              Int(26)),
+            Call(Name("ord"), Str("a")))),
+        CS:Chars) ~> KONT:K
+      => VList(decodeSpec(CS)) ~> KONT
+    </k>
+    <ch> OLD:Int => OLD </ch>
+  requires allLower(CS)
+  [label(loop-wrong-body)]
+endmodule
diff --git a//tmp/audit-work/candidate/spec-vacuity-audit.k b//tmp/audit-work/candidate/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..6fbd15bf5be5186af96c0135d71fecd72344024c
--- /dev/null
+++ b//tmp/audit-work/candidate/spec-vacuity-audit.k
@@ -0,0 +1,63 @@
+requires "semantic.k"
+
+module SPEC-VACUITY-AUDIT
+  imports SEMANTIC
+
+  claim <k> decodeCode(encodeCode(C:Int)) => C ...</k>
+    requires isLowerCode(C)
+  [label(code-inverse)]
+
+  claim
+    <k>
+      comp("ch",
+        Call(
+          Name("chr"),
+          BinOp(
+            "+",
+            BinOp(
+              "%",
+              BinOp(
+                "-",
+                BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+                Call(Name("ord"), Str("a"))),
+              Int(26)),
+            Call(Name("ord"), Str("a")))),
+        CS:Chars) ~> KONT:K
+      => VList(decodeSpec(CS)) ~> KONT
+    </k>
+    <ch> OLD:Int => OLD </ch>
+  requires allLower(CS)
+  [label(loop-correct)]
+
+  // Deliberately false: the real program decodes, but this mutation requires
+  // the result to be the forward encoding. Satisfying witness CS = cons(97,nil)
+  // yields VChars(cons(118,nil)), not VChars(cons(102,nil)).
+  claim
+      <k>
+        Module(
+          FuncDef("decode_shift", Params("s"),
+            Return(
+              Call(
+                Attribute(Str(""), "join"),
+                ListComp(Call(
+                  Name("chr"),
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "%",
+                      BinOp(
+                        "-",
+                        BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+                        Call(Name("ord"), Str("a"))),
+                      Int(26)),
+                    Call(Name("ord"), Str("a")))),
+                  CompFor(Name("ch"), Name("s"), Bool(true)))))))
+        => .K
+      </k>
+      <s> nil => CS </s>
+      <ch> 0 => 0 </ch>
+      <input> CS:Chars => CS </input>
+      <result> .K => VChars(encodeSpec(CS)) </result>
+  requires allLower(CS)
+  [label(program-false-encode-result)]
+endmodule
