+  [label(code-inverse)]
+
+  claim
+    <k>
+      comp("ch",
+        Call(
+          Name("chr"),
+          BinOp(
+            "+",
+            BinOp(
+              "%",
+              BinOp(
+                "-",
+                BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+                Call(Name("ord"), Str("a"))),
+              Int(26)),
+            Call(Name("ord"), Str("a")))),
+        CS:Chars) ~> KONT:K
+      => VList(decodeSpec(CS)) ~> KONT
+    </k>
+    <ch> OLD:Int => OLD </ch>
+  requires allLower(CS)
+  [label(loop-correct)]
+
+  // Deliberately false: the real program decodes, but this mutation requires
