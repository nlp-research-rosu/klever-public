+        Call(
+          Name("chr"),
+          BinOp(
+            "+",
+            BinOp(
+              "%",
+              BinOp(
+                "-",
+                BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+                Call(Name("ord"), Str("a"))),
+              Int(26)),
+            Call(Name("ord"), Str("a")))),
+        CS:Chars) ~> KONT:K
+      => VList(decodeSpec(CS)) ~> KONT
