+                BinOp("-", Call(Name("ord"), Name("ch")), Int(4)),
+                Call(Name("ord"), Str("a"))),
+              Int(26)),
+            Call(Name("ord"), Str("a")))),
+        CS:Chars) ~> KONT:K
+      => VList(decodeSpec(CS)) ~> KONT
+    </k>
