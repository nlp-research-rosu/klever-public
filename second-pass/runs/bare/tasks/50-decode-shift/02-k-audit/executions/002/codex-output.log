new file mode 100644
index 0000000000000000000000000000000000000000..da76ddeffd60bd375e971cfc34f6864ea272398b
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: run_logged.sh LOG COMMAND..." >&2
+  exit 64
+fi
+
+log="$1"
+shift
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log"
+
+set +e
+"$@" >>"$log" 2>&1
+status=$?
+set -e
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$log"
+
+cat "$log"
+exit "$status"

