/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import os,stat,hashlib,itertools
roots=[Path('/candidate'),Path('/generation-evidence/codex-trace')]
targets=['d5cf8c06f4fe3553d320b9430031197507d0bb4532ebc3d8fa52f362f0cce4e4','438791988d19b8a303f4ffc3cc9661713fc33a5e5ce8a198fd4f541d68611365']

def ents(root, dirs):
 out=[]
 for p in root.rglob('*'):
  if p.is_file() or (dirs and p.is_dir()): out.append(p)
 return sorted(out,key=lambda p:p.relative_to(root).as_posix())

def comp(p,root,name):
 b=p.read_bytes() if p.is_file() else b''; rel=p.relative_to(root).as_posix().encode(); typ=b'file' if p.is_file() else b'directory'; mode=p.stat(follow_symlinks=False).st_mode
 return {'r':rel,'rdot':b'./'+rel,'t':typ,'t1':b'f' if p.is_file() else b'd','m':oct(mode&0o777).encode(),'md':str(mode&0o777).encode(),'s':str(len(b)).encode(),'s8':len(b).to_bytes(8,'big'),'h':hashlib.sha256(b).hexdigest().encode(),'hb':hashlib.sha256(b).digest(),'b':b}[name]
