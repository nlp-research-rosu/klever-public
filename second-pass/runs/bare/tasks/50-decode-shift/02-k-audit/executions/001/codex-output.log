+
+cp -- "$source_mutation" "$scratch_mutation"
+cmp -s "$source_mutation" "$scratch_mutation"
+status=$?
+printf 'COPY_BYTE_IDENTITY_STATUS\t%s\n' "$status"
+sha256sum "$source_mutation" "$scratch_mutation"
