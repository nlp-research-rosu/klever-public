+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOGFILE COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+  exit "$audit_status"
+} 2>&1 | tee "$audit_log"
+
+exit "${PIPESTATUS[0]}"

exec
/bin/bash -lc 'bash /audit-output/evidence/run_logged.sh /audit-output/evidence/adequacy/body-sensitivity-dry-run.log kprove /tmp/audit-work/mutations/body-sensitivity.k --definition /tmp/audit-work/build/proof-kompiled --spec-module BODY-SENSITIVITY --dry-run --emit-json-spec /tmp/audit-work/body-sensitivity.json' in /tmp/audit-work/candidate
