+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOGFILE COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+  exit "$audit_status"
+} 2>&1 | tee "$audit_log"
+
+exit "${PIPESTATUS[0]}"

diff --git a//tmp/audit-work/mutations/body-sensitivity.k b//tmp/audit-work/mutations/body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..257cb365048fdc73831879d1e7251bbda11df663
--- /dev/null
+++ b//tmp/audit-work/mutations/body-sensitivity.k
@@ -0,0 +1,33 @@
+requires "../candidate/semantic.k"
+
+module BODY-SENSITIVITY
+  imports SEMANTIC
+
+  // Mutation: the executed program replaces semicolons, not commas.
+  // For input "a,b", this returns ["a,b"], while wordsContract requires ["a","b"].
+  claim [changed-program-body]:
+    <k>
+      Module(
+        FuncDef("words_string", Params("s"),
+          Return(
+            Call(
+              Attribute(
+                Call(Attribute(Name("s"), "replace"), Str(";"), Str(" ")),
+                "split"),
+              .Exprs))))
+      ~> invoke("words_string", "a,b")
+    =>
+      ListVal(wordsContract("a,b"))
+    </k>
+    <functions>
+      .Map
+    =>
+      "words_string" |-> function("s",
+        Return(
+          Call(
+            Attribute(
+              Call(Attribute(Name("s"), "replace"), Str(";"), Str(" ")),
+              "split"),
+            .Exprs)))
+    </functions>
+endmodule
