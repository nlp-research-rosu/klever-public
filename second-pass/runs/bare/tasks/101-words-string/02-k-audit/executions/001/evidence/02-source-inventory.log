## candidate-prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Translate the submitted Python source with the fixed front end.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Build the semantics with the proof-capable backend.
     8	kompile semantic.k \
     9	  --main-module SEMANTIC \
    10	  --syntax-module SEMANTIC-SYNTAX \
    11	  --backend haskell
    12	
    13	# Exercise both prompt examples and a delimiter edge case concretely.
    14	krun solution.mpy -cINPUT='"Hi, my name is John"'
    15	krun solution.mpy -cINPUT='"One, two, three, four, five, six"'
    16	krun solution.mpy -cINPUT='"  alpha,,beta   gamma, "'
    17	
    18	# Prove every claim in spec.k, including the universal correctness claim.
    19	kprove \
    20	  --definition semantic-kompiled \
    21	  --spec-module SPEC \
    22	  spec.k
