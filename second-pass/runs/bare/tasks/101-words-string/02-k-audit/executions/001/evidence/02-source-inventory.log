## reference-prompt
     1	
     2	def words_string(s):
     3	    """
     4	    You will be given a string of words separated by commas or spaces. Your task is
     5	    to split the string into words and return an array of the words.
     6	    
     7	    For example:
     8	    words_string("Hi, my name is John") == ["Hi", "my", "name", "is", "John"]
     9	    words_string("One, two, three, four, five, six") == ["One", "two", "three", "four", "five", "six"]
    10	    """
## reference-canonical
     1	# canonical.py — the UNMODIFIED HumanEval/101 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: words_string
     4	
     5	
     6	def words_string(s):
     7	    """
     8	    You will be given a string of words separated by commas or spaces. Your task is
     9	    to split the string into words and return an array of the words.
    10	    
    11	    For example:
    12	    words_string("Hi, my name is John") == ["Hi", "my", "name", "is", "John"]
    13	    words_string("One, two, three, four, five, six") == ["One", "two", "three", "four", "five", "six"]
    14	    """
    15	    if not s:
    16	        return []
    17	
    18	    s_list = []
    19	
    20	    for letter in s:
    21	        if letter == ',':
    22	            s_list.append(' ')
    23	        else:
    24	            s_list.append(letter)
    25	
    26	    s_list = "".join(s_list)
    27	    return s_list.split()
## candidate-solution.py
     1	def words_string(s):
     2	    return s.replace(",", " ").split()
