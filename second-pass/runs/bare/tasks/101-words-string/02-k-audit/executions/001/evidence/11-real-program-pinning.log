COMMAND: bash -lc $'\nset -u\ncd /tmp/audit-work/reconstruction\nnormalize() { tr -d "[:space:]"; }\nnormalize < solution.mpy > /tmp/audit-work/solution.normalized\nfor entry in "general:9:16" "hi:35:42" "numbers:62:69"; do\n  IFS=: read -r name first last <<< "$entry"\n  sed -n "${first},${last}p" spec.k | normalize > "/tmp/audit-work/${name}.normalized"\n  cmp -s /tmp/audit-work/solution.normalized "/tmp/audit-work/${name}.normalized"\n  status=$?\n  printf "CLAIM_PROGRAM_%s_CMP=%d\\n" "$name" "$status"\n  sha256sum "/tmp/audit-work/${name}.normalized"\ndone\nprintf "SUBSTITUTION_INPUT=%q\\n" "a,,b"\npython3 - <<\'PY\'\nimport importlib.util\n\ndef load(path, name):\n    spec = importlib.util.spec_from_file_location(name, path)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module.words_string\n\nvalue = "a,,b"\ncanonical = load("/reference/canonical.py", "canonical_pin")\ncandidate = load("/tmp/audit-work/reconstruction/solution.py", "candidate_pin")\nprint("canonical:", canonical(value))\nprint("candidate:", candidate(value))\nprint("claimed wordsContract by equations: replace commas -> spaces; splitSpaces ->", ["a", "b"])\nassert canonical(value) == candidate(value) == ["a", "b"]\nPY\n'
