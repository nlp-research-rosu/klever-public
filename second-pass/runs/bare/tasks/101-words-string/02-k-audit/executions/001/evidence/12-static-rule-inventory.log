    14	                Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
    15	                "split"),
    16	              .Exprs))))
    17	      ~> invoke("words_string", S)
    18	    => ListVal(wordsContract(S))
    19	    </k>
    20	    <functions>
    21	      .Map
    22	    =>
    23	      "words_string" |-> function("s",
    24	        Return(
    25	          Call(
    26	            Attribute(
    27	              Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
    28	              "split"),
    29	            .Exprs)))
    30	    </functions>
    31	
