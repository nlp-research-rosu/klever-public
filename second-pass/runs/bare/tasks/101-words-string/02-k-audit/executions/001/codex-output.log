index 0000000000000000000000000000000000000000..629b9e02253b0bd71481d1f5ea39f143fdfcbb82
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,32 @@
+requires "semantic.k"
+
+module SPEC-VACUITY
+  imports SEMANTIC
+
+  // Fresh audit mutation: prepend an extra word to the result for every input.
+  // This is false for the satisfying ground input S = "", whose real result is [].
