diff --git a//tmp/audit-work/proc_self_fix.c b//tmp/audit-work/proc_self_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..09d34e37a5308ee7600d0cb6b39900b4d807f137
--- /dev/null
+++ b//tmp/audit-work/proc_self_fix.c
@@ -0,0 +1,34 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static const char *fix_self_exe(const char *path) {
+  const char prefix[] = "/proc/";
+  const char suffix[] = "/exe";
+  if (strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+    return path;
+  }
+  const char *cursor = path + sizeof(prefix) - 1;
+  if (!isdigit((unsigned char)*cursor)) {
+    return path;
+  }
+  while (isdigit((unsigned char)*cursor)) {
+    cursor++;
+  }
+  return strcmp(cursor, suffix) == 0 ? "/proc/self/exe" : path;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  return syscall(SYS_readlink, fix_self_exe(path), buffer, size);
+}
+
+ssize_t readlinkat(
+    int directory, const char *path, char *buffer, size_t size
+) {
+  return syscall(
+      SYS_readlinkat, directory, fix_self_exe(path), buffer, size
+  );
+}
diff --git a//tmp/audit-work/readlink_self.c b//tmp/audit-work/readlink_self.c
new file mode 100644
index 0000000000000000000000000000000000000000..4a332abae7accd2ebc7c7feb1cdd26efb227fb61
--- /dev/null
+++ b//tmp/audit-work/readlink_self.c
@@ -0,0 +1,18 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buf[4096];
+  char proc_path[128];
+  snprintf(proc_path, sizeof(proc_path), "/proc/%d/exe", getpid());
+  ssize_t n = readlink(proc_path, buf, sizeof(buf) - 1);
+  if (n < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  buf[n] = '\0';
+  puts(buf);
+  return 0;
+}
