+  krun solution.mpy -cINPUT='""'
+  krun solution.mpy -cINPUT='" ,  ,"'
+  krun solution.mpy -cINPUT='"  alpha,,beta   gamma, "'
+  krun solution.mpy -cINPUT='"alpha"'
+  krun solution.mpy -cINPUT='",a, b,,c "'
