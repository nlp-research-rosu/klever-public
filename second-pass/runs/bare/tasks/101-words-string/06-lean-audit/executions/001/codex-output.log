+print(json.dumps(checks, indent=2, sort_keys=True))
+
+if not all(
+    checks[key]
+    for key in (
+        "all_individual_hashes_match",
+        "tree_hash_matches_audit_input",
+        "all_image_ids_match",
+    )
+):
+    raise SystemExit(1)
