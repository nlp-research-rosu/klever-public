   382	
   383	    # Ctor
   384	    cind = ind + 1
   385	    cpad = "  " * cind
   386	    has_block = any(isinstance(a, Seq) for a in node.args)
   387	
   388	    if not has_block:
   389	        inline = node.name + "(" + ", ".join(render(a, ind) for a in node.args) + ")"
   390	        if "\n" not in inline and len("  " * ind) + len(inline) <= WIDTH:
   391	            return inline
   392	        parts = [render(a, cind) for a in node.args]
   393	        return node.name + "(\n" + cpad + (",\n" + cpad).join(parts) + ")"
   394	
   395	    # Has a statement block: inline the args before the first block, then put
   396	    # each remaining arg (blocks included) on its own indented line.
   397	    first = next(i for i, a in enumerate(node.args) if isinstance(a, Seq))
   398	    head = node.args[:first]
   399	    rest = node.args[first:]
   400	    open_line = node.name + "(" + ", ".join(render(a, ind) for a in head) + ("," if head else "")
   401	    lines = []
   402	    for k, a in enumerate(rest):
   403	        comma = "," if k < len(rest) - 1 else ""
   404	        lines.append(cpad + render(a, cind) + comma)
   405	    return open_line + "\n" + "\n".join(lines) + ")"
   406	
   407	
   408	# ---------------------------------------------------------------------------
   409	# CLI
   410	# ---------------------------------------------------------------------------
   411	def main(argv=None) -> int:
   412	    ap = argparse.ArgumentParser(
   413	        prog="py2mpy",
   414	        description="Pure CPython-AST -> K-constructor transliterator.",
   415	    )
   416	    ap.add_argument("file", help="Python source file")
   417	    ap.add_argument("--ast", action="store_true",
   418	                    help="print the Python AST (ast.dump) instead of the .mpy term")
   419	    args = ap.parse_args(argv)
   420	
   421	    with open(args.file, "r", encoding="utf-8") as fh:
   422	        src = fh.read()
   423	    tree = ast.parse(src, filename=args.file)
   424	    _walk_symtable(symtable.symtable(src, args.file, "exec"))
   425	
   426	    if args.ast:
   427	        print(ast.dump(tree, indent=2))
   428	    else:
   429	        print(render(emit_module(tree)))
   430	    return 0
   431	
   432	
   433	if __name__ == "__main__":
   434	    sys.exit(main())

diff --git a//tmp/audit-work/proc_self_fix.c b//tmp/audit-work/proc_self_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..09d34e37a5308ee7600d0cb6b39900b4d807f137
--- /dev/null
+++ b//tmp/audit-work/proc_self_fix.c
@@ -0,0 +1,34 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static const char *fix_self_exe(const char *path) {
+  const char prefix[] = "/proc/";
+  const char suffix[] = "/exe";
+  if (strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+    return path;
+  }
+  const char *cursor = path + sizeof(prefix) - 1;
+  if (!isdigit((unsigned char)*cursor)) {
+    return path;
+  }
+  while (isdigit((unsigned char)*cursor)) {
+    cursor++;
+  }
+  return strcmp(cursor, suffix) == 0 ? "/proc/self/exe" : path;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  return syscall(SYS_readlink, fix_self_exe(path), buffer, size);
+}
+
+ssize_t readlinkat(
+    int directory, const char *path, char *buffer, size_t size
+) {
+  return syscall(
+      SYS_readlinkat, directory, fix_self_exe(path), buffer, size
+  );
+}
diff --git a//tmp/audit-work/readlink_self.c b//tmp/audit-work/readlink_self.c
new file mode 100644
index 0000000000000000000000000000000000000000..4a332abae7accd2ebc7c7feb1cdd26efb227fb61
--- /dev/null
+++ b//tmp/audit-work/readlink_self.c
@@ -0,0 +1,18 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buf[4096];
+  char proc_path[128];
+  snprintf(proc_path, sizeof(proc_path), "/proc/%d/exe", getpid());
+  ssize_t n = readlink(proc_path, buf, sizeof(buf) - 1);
+  if (n < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  buf[n] = '\0';
+  puts(buf);
+  return 0;
+}
