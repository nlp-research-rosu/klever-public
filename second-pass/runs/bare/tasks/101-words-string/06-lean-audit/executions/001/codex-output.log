diff --git a//tmp/audit-work/readlink_self.c b//tmp/audit-work/readlink_self.c
new file mode 100644
index 0000000000000000000000000000000000000000..f551680e147db65c3d2cc613e68cff9319fe1f40
--- /dev/null
+++ b//tmp/audit-work/readlink_self.c
@@ -0,0 +1,16 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buf[4096];
+  ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+  if (n < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  buf[n] = '\0';
+  puts(buf);
+  return 0;
+}
