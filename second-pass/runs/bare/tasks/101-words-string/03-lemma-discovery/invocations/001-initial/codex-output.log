#!/usr/bin/env bash
set -euo pipefail

# Translate the submitted Python source with the fixed front end.
python3 py2mpy.py solution.py > solution.mpy

# Build the semantics with the proof-capable backend.
kompile semantic.k \
  --main-module SEMANTIC \
  --syntax-module SEMANTIC-SYNTAX \
  --backend haskell

# Exercise both prompt examples and a delimiter edge case concretely.
krun solution.mpy -cINPUT='"Hi, my name is John"'
krun solution.mpy -cINPUT='"One, two, three, four, five, six"'
krun solution.mpy -cINPUT='"  alpha,,beta   gamma, "'

# Prove every claim in spec.k, including the universal correctness claim.
kprove \
  --definition semantic-kompiled \
  --spec-module SPEC \
  spec.k
requires "semantic.k"

module SPEC
  imports SEMANTIC

  // Universal functional-correctness claim for every input string.
  claim [words-string-general]:
    <k>
      Module(
        FuncDef("words_string", Params("s"),
          Return(
            Call(
              Attribute(
                Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
                "split"),
              .Exprs))))
      ~> invoke("words_string", S)
    => ListVal(wordsContract(S))
    </k>
    <functions>
      .Map
    =>
      "words_string" |-> function("s",
        Return(
          Call(
            Attribute(
              Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
              "split"),
            .Exprs)))
    </functions>

  // The two examples from prompt.py are also executable proof obligations.
  claim [prompt-example-hi]:
    <k>
      Module(
        FuncDef("words_string", Params("s"),
          Return(
            Call(
              Attribute(
                Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
                "split"),
              .Exprs))))
      ~> invoke("words_string", "Hi, my name is John")
    =>
      ListVal(ListItem("Hi") ListItem("my") ListItem("name")
              ListItem("is") ListItem("John"))
    </k>
    <functions>
      .Map
    =>
      "words_string" |-> function("s",
        Return(
          Call(
            Attribute(
              Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
              "split"),
            .Exprs)))
    </functions>

  claim [prompt-example-numbers]:
    <k>
      Module(
        FuncDef("words_string", Params("s"),
          Return(
            Call(
              Attribute(
                Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
                "split"),
              .Exprs))))
      ~> invoke("words_string", "One, two, three, four, five, six")
    =>
      ListVal(ListItem("One") ListItem("two") ListItem("three")
              ListItem("four") ListItem("five") ListItem("six"))
    </k>
    <functions>
      .Map
    =>
      "words_string" |-> function("s",
        Return(
          Call(
            Attribute(
              Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
              "split"),
            .Exprs)))
    </functions>
endmodule
module VERIFICATION
  imports STRING
  imports LIST
  imports INT
  imports BOOL

  // splitSpaces is a mathematical model of splitting on runs of spaces.
  // The prompt's input alphabet uses commas and spaces as its separators.
  syntax List ::= splitSpaces(String) [function]

  rule splitSpaces("") => .List
  rule splitSpaces(S) => splitSpaces(substrString(S, 1, lengthString(S)))
    requires lengthString(S) >Int 0
     andBool substrString(S, 0, 1) ==String " "
  rule splitSpaces(S) => ListItem(S)
    requires lengthString(S) >Int 0
     andBool findString(S, " ", 0) ==Int -1
  rule splitSpaces(S)
    => ListItem(substrString(S, 0, findString(S, " ", 0)))
       splitSpaces(substrString(S, findString(S, " ", 0) +Int 1,
                                  lengthString(S)))
    requires findString(S, " ", 0) >Int 0

  // Formal statement of the HumanEval contract: commas and spaces delimit
  // words, consecutive/edge separators contribute no empty strings.
  syntax List ::= wordsContract(String) [function, total]
  rule wordsContract(S) => splitSpaces(replaceAll(S, ",", " "))
endmodule
requires "verification.k"

module SEMANTIC-SYNTAX
  imports STRING-SYNTAX

  // The concrete syntax emitted by py2mpy.py for the subset used here.
  syntax Program ::= "Module" "(" Stmts ")"

  syntax Stmts ::= List{Stmt, ""}
  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
                | "Return" "(" Expr ")"

  syntax Ids    ::= List{String, ","}
  syntax Params ::= "Params" "(" Ids ")"
  syntax Exprs  ::= List{Expr, ","}
  syntax Expr ::= "Name" "(" String ")"
                | "Str" "(" String ")"
                | "Attribute" "(" Expr "," String ")"
                | "Call" "(" Expr "," Exprs ")"
endmodule

module SEMANTIC
  imports SEMANTIC-SYNTAX
  imports VERIFICATION
  imports MAP

  syntax Function ::= function(String, Stmts)
  syntax PyVal ::= StrVal(String) | ListVal(List)

  syntax KItem ::= invoke(String, String)
                 | execute(Stmts, Map)

  syntax PyVal ::= eval(Expr, Map) [function]
  syntax String ::= asString(PyVal) [function]

  configuration
    <k> $PGM:Program ~> invoke("words_string", $INPUT:String) </k>
    <functions> .Map </functions>

  // Loading a module installs its (single, capture-free) function definition.
  rule <k> Module(FuncDef(F, Params(P), BODY)) => .K ... </k>
       <functions> .Map => F |-> function(P, BODY) </functions>

  // Invocation creates a fresh one-variable local environment.
  rule <k> invoke(F, S) => execute(BODY, P |-> StrVal(S)) ... </k>
       <functions>... F |-> function(P, BODY) ...</functions>

  rule <k> execute(Return(E), ENV) => eval(E, ENV) ... </k>

  rule eval(Name(X), X |-> V:PyVal) => V
  rule eval(Str(S), _) => StrVal(S)

  // Python str.replace(old, new) with no count replaces every occurrence.
  rule eval(Call(Attribute(RECV, "replace"), Str(OLD), Str(NEW)), ENV)
    => StrVal(replaceAll(asString(eval(RECV, ENV)), OLD, NEW))

  // Python str.split() without an explicit separator returns maximal words.
  rule eval(Call(Attribute(RECV, "split"), .Exprs), ENV)
    => ListVal(splitSpaces(asString(eval(RECV, ENV))))

  rule asString(StrVal(S)) => S
endmodule

