KIT_SKILLS_DIR="${AUDIT_KIT_SKILLS_DIR:-/kit-skills}"
PROMPT_FILE="${AUDIT_PROMPT_FILE:-/audit-prompt.md}"
OUTPUT_DIR="${AUDIT_OUTPUT_DIR:-/audit-output}"
