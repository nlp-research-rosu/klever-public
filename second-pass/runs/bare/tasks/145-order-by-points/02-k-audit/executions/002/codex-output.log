+
+  claim [label(c06-sort-empty)]:
+        <py>
+          <k> sortWith(.Vals, PointKey, solutionDefs) => specSort(.Vals) </k>
+          <program> solutionProgram </program>
+          <input> ListExpr(.Exprs) </input>
+          <output> NoValue </output>
+        </py>
+
+  claim [label(c07-sort-single)]:
+        <py>
+          <k>
+            sortWith(IntVal(N:Int), PointKey, solutionDefs)
+            => specSort(IntVal(N))
+          </k>
+          <program> solutionProgram </program>
+          <input> ListExpr(.Exprs) </input>
+          <output> NoValue </output>
+        </py>
+
+  claim [label(c08-insert-le)]:
+        <py>
+          <k>
+            insertWith(
+              IntVal(N:Int), (IntVal(M:Int), .Vals), PointKey, solutionDefs)
+            => specInsert(IntVal(N), (IntVal(M), .Vals))
+          </k>
+          <program> solutionProgram </program>
+          <input> ListExpr(.Exprs) </input>
+          <output> NoValue </output>
+        </py>
+    requires pointScore(N) <=Int pointScore(M)
+
+  claim [label(c09-insert-gt)]:
+        <py>
+          <k>
+            insertWith(
+              IntVal(N:Int), (IntVal(M:Int), .Vals), PointKey, solutionDefs)
+            => specInsert(IntVal(N), (IntVal(M), .Vals))
+          </k>
+          <program> solutionProgram </program>
+          <input> ListExpr(.Exprs) </input>
+          <output> NoValue </output>
+        </py>
+    requires pointScore(N) >Int pointScore(M)
+
+  claim [label(c10-example)]:
+        <py>
+          <k> init => .K </k>
+          <program> solutionProgram </program>
+          <input>
+            ListExpr(Int(1), Int(11), Int(-1), Int(-11), Int(-12))
+          </input>
+          <output>
+            NoValue =>
+            ListVal(IntVal(-1), IntVal(-11), IntVal(1), IntVal(-12), IntVal(11))
+          </output>
+        </py>
+
+  claim [label(c11-empty)]:
+        <py>
+          <k> init => .K </k>
+          <program> solutionProgram </program>
+          <input> ListExpr(.Exprs) </input>
+          <output> NoValue => ListVal(.Vals) </output>
+        </py>
+
+  claim [label(c12-stability)]:
+        <py>
+          <k> init => .K </k>
+          <program> solutionProgram </program>
+          <input> ListExpr(Int(12), Int(21), Int(-12), Int(3)) </input>
+          <output>
+            NoValue => ListVal(IntVal(-12), IntVal(12), IntVal(21), IntVal(3))
+          </output>
+        </py>
+
+  claim [label(c13-is-ordered)]:
+        <py>
+          <k>
+            isOrdered(
+              IntVal(-1), IntVal(-11), IntVal(1), IntVal(-12), IntVal(11))
+            => true
+          </k>
+          <program> solutionProgram </program>
+          <input> ListExpr(.Exprs) </input>
+          <output> NoValue </output>
+        </py>
+endmodule
diff --git a/evidence/trace_extract.py b/evidence/trace_extract.py
new file mode 100644
index 0000000000000000000000000000000000000000..026347391f5c506f7442f505b8c634a2e08e60e9
--- /dev/null
+++ b/evidence/trace_extract.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Render the complete JSONL generation trace into a compact textual ledger."""
+
+from __future__ import annotations
+
+import json
+from collections import Counter
+from pathlib import Path
+
+
+TRACE = Path(
+    "/generation-evidence/codex-trace/2026/07/22/"
+    "rollout-2026-07-22T07-31-48-019f89cf-8c90-7a01-99ba-8a917ae7dcf0.jsonl"
+)
+
+
+def truncate(text: str, limit: int = 1600) -> str:
+    text = text.replace("\x1b", "<ESC>")
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n...[{len(text) - limit} characters omitted]..."
+
+
+def main() -> int:
+    outer = Counter()
+    payload_types = Counter()
+    total = 0
+    with TRACE.open("r", encoding="utf-8") as stream:
+        for line_number, line in enumerate(stream, 1):
+            total += 1
+            item = json.loads(line)
+            outer[item.get("type", "<missing>")] += 1
+            payload = item.get("payload", {})
+            payload_type = payload.get("type", "<missing>")
+            payload_types[payload_type] += 1
+            print(
+                f"LINE {line_number} outer={item.get('type')} "
+                f"payload={payload_type} time={item.get('timestamp')}"
+            )
+
+            if item.get("type") == "response_item":
+                role = payload.get("role")
+                if role:
+                    print(f"  role={role}")
+                if payload_type == "message":
+                    chunks = payload.get("content", [])
+                    texts = [
+                        chunk.get("text", "")
+                        for chunk in chunks
+                        if isinstance(chunk, dict)
+                        and chunk.get("type") in {"input_text", "output_text"}
+                    ]
+                    if role in {"user", "assistant"}:
+                        print(truncate("\n".join(texts)))
