+                Return(
+                  Call(
+                    Name("sorted"),
+                    Name("nums"),
+                    KwArg(
+                      "key",
+                      Lambda(
+                        Params("n"),
+                        CellVars(.Ids),
+                        FreeVars(.Ids),
+                        BinOp(
+                          "-",
+                          Call(
+                            Name("sum"),
+                            Call(
+                              Name("map"),
+                              Name("int"),
+                              Call(
+                                Name("str"),
+                                Call(Name("abs"), Name("n"))))),
