     3	module VERIFICATION
     4	  imports MPY-SEMANTICS
     5	  imports K-EQUAL
     6	
     7	  // A closed K representation of the AST emitted in solution.mpy.  The
     8	  // execution claims use this term, while prove.sh separately regenerates and
