@@ -0,0 +1,133 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [label(c01-score-neg12)]:
+        <py>
+          <k> pointScore(-12) => 1 </k>
+          <program> solutionProgram </program>
+          <input> ListExpr(.Exprs) </input>
