+  && test "$copy_translator_rc" -eq 0 \
+  && test "$regen_rc" -eq 0 \
+  && test "$cmp_rc" -eq 0 \
+  && test "$sha_rc" -eq 0 \
+  && test "$diff_rc" -eq 0
