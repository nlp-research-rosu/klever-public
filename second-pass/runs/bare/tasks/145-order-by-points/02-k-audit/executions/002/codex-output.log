+                     BinOp(
+                       "*", Int(3),
+                       Call(
+                         Name("int"),
+                         Subscript(
+                           Call(
+                             Name("str"), Call(Name("abs"), Name("n"))),
+                           Int(0)))),
+                     Int(0))))))))
