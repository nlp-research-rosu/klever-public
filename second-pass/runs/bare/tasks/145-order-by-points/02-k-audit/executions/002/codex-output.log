diff --git a/evidence/body-mutation.k b/evidence/body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..d867b025ca7d3b6fab1191f5ea5823ae93fa28ab
--- /dev/null
+++ b/evidence/body-mutation.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module BODY-MUTATION
+  imports VERIFICATION
+
+  syntax Pgm ::= "mutatedProgram" [function]
+  syntax Stmts ::= "mutatedDefs" [function]
+
+  rule mutatedProgram => Module(mutatedDefs)
+
+  // Material body mutation: multiplier 2 becomes 3 in the term that executes.
+  rule mutatedDefs
+    => FuncDef(
+         "order_by_points", Params("nums"),
+         Return(
+           Call(
+             Name("sorted"),
+             Name("nums"),
+             KwArg(
+               "key",
+               Lambda(
+                 Params("n"), CellVars(.Ids), FreeVars(.Ids),
+                 BinOp(
+                   "-",
+                   Call(
+                     Name("sum"),
+                     Call(
+                       Name("map"), Name("int"),
+                       Call(Name("str"), Call(Name("abs"), Name("n"))))),
+                   IfExp(
+                     Compare(Name("n"), CmpOp("<", Int(0))),
+                     BinOp(
+                       "*", Int(3),
+                       Call(
+                         Name("int"),
+                         Subscript(
+                           Call(
+                             Name("str"), Call(Name("abs"), Name("n"))),
+                           Int(0)))),
+                     Int(0))))))))
+endmodule
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
