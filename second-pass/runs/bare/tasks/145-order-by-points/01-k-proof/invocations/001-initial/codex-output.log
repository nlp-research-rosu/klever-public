index 0000000000000000000000000000000000000000..7dbbbcae2c3a42864baf93f90db18aaf7238be51
--- /dev/null
+++ b/tmp-spec4.k
@@ -0,0 +1,10 @@
+requires "verification.k"
+module TMP-SPEC4
+  imports VERIFICATION
+  claim <py>
