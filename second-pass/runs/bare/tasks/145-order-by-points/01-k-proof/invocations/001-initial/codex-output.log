+                  KwArg("key", Lambda(Params("n"), CellVars(.Ids), FreeVars(.Ids),
+                    BinOp("-",
+                      Call(Name("sum"), Call(Name("map"), Name("int"),
+                        Call(Name("str"), Call(Name("abs"), Name("n"))))),
+                      IfExp(Compare(Name("n"), CmpOp("<", Int(0))),
+                        BinOp("*", Int(2), Call(Name("int"),
