Module(
  FuncDef("order_by_points", Params("nums"),
    Return(
      Call(
        Name("sorted"),
        Name("nums"),
        KwArg(
          "key",
          Lambda(
            Params("n"),
            CellVars(),
            FreeVars(),
            BinOp(
              "-",
              Call(
                Name("sum"),
                Call(
                  Name("map"),
                  Name("int"),
                  Call(Name("str"), Call(Name("abs"), Name("n"))))),
              IfExp(
                Compare(Name("n"), CmpOp("<", Int(0))),
                BinOp(
                  "*",
                  Int(2),
                  Call(
                    Name("int"),
                    Subscript(
                      Call(Name("str"), Call(Name("abs"), Name("n"))),
                      Int(0)))),
                Int(0)))))))))
