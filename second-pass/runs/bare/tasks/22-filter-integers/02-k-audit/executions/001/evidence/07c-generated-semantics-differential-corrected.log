  </functions>
  <env>
    bind ( "values" , VList ( VString ( "a" ) , VFloat ( "3.14" ) , VInt ( 5 ) , .PyVals ) , .Env )
  </env>
  <return>
    result ( VList ( VInt ( 5 ) , .PyVals ) )
