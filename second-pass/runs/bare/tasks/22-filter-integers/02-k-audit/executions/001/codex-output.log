+        return {"type": "complex", "real": value.real, "imag": value.imag}
+    return {"type": type(value).__name__, "value": value}
+
+
+atoms: list[Any] = [
+    -10**100,
+    -2,
+    -1,
+    0,
+    1,
+    2,
+    10**100,
+    True,
+    False,
+    IntSubclass(-7),
+    IntSubclass(0),
