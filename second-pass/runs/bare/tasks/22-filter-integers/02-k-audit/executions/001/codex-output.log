proof_status=$?
printf '"'dry_run=%d false_proof=%d\\n' \""'$dry_status" "$proof_status"
cat /audit-output/evidence/11a-vacuity-dry-run.log
cat /audit-output/evidence/11b-vacuity-proof.log
if (( dry_status != 0 || proof_status == 0 )); then exit 1; fi
exit 0' in /audit-output
