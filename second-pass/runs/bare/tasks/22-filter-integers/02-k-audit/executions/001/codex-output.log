/audit-output/evidence/run_logged.sh 12a-mutated-body-krun /tmp/audit-work/22-filter-integers/src krun solution.mpy --definition fresh-semantic-kompiled -cINPUT='VList(VString(\"a\"), VFloat(\"3.14\"), VInt(5))'
