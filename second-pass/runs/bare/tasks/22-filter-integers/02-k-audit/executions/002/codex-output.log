+  > /tmp/audit-work/candidate-src/regenerated.mpy
+translate_status=$?
+echo "TRANSLATOR_EXIT_STATUS=$translate_status"
+
+echo '$ cmp -s /tmp/audit-work/candidate-src/regenerated.mpy /tmp/audit-work/candidate-src/solution.mpy'
