diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..54e5c525e6116eb8ed5d01183b1ef2145bb42b87
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the constructor term from the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Check the executable Python against the prompt examples and boundary cases.
+python3 - <<'PY'
+from solution import filter_integers
+
+cases = [
+    (["a", 3.14, 5], [5]),
+    ([1, 2, 3, "abc", {}, []], [1, 2, 3]),
+    ([True, False, 0, -4, 2.0], [True, False, 0, -4]),
+    ([], []),
+]
+for values, expected in cases:
+    assert filter_integers(values) == expected
+PY
+
+# Compile the executable semantics and check the exact final K results.
+kompile semantic.k \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm \
+  --output-definition semantic-kompiled
+
+krun solution.mpy -d semantic-kompiled \
+  -cINPUT='VList(VString("a"), VFloat("3.14"), VInt(5))' \
+  | tr -d '[:space:]' \
+  | rg --fixed-strings --quiet 'result(VList(VInt(5),.PyVals))'
+
+krun solution.mpy -d semantic-kompiled \
+  -cINPUT='VList(VInt(1), VInt(2), VInt(3), VString("abc"), VDict, VList())' \
+  | tr -d '[:space:]' \
+  | rg --fixed-strings --quiet \
+      'result(VList(VInt(1),VInt(2),VInt(3),.PyVals))'
+
+krun solution.mpy -d semantic-kompiled \
+  -cINPUT='VList(VBool(true), VBool(false), VInt(0), VInt(-4), VFloat("2.0"))' \
+  | tr -d '[:space:]' \
+  | rg --fixed-strings --quiet \
+      'result(VList(VBool(true),VBool(false),VInt(0),VInt(-4),.PyVals))'
+
+krun solution.mpy -d semantic-kompiled -cINPUT='VList()' \
+  | tr -d '[:space:]' \
+  | rg --fixed-strings --quiet 'result(VList(.PyVals))'
+
+# Include verification helpers in the Haskell definition, then prove every
+# claim in spec.k in one positive target-proof command.
+kompile verification.k \
+  --main-module MPY-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..b6968153935433eefbb828291c208e27a7658b01
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,120 @@
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructors emitted by py2mpy.py for this program.  Statement and
+  // comprehension lists use juxtaposition, exactly as the translator does.
+  syntax Module ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Str" "(" String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "ListComp" "(" Expr "," CompFors ")"
+  syntax Exprs ::= List{Expr, ","}
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
+  syntax CompFors ::= List{CompFor, ""}
+
+  // Runtime values are deliberately distinct from source expressions.
+  // VBool is an instance of int in Python, a detail captured by isInt below.
+  syntax PyVal ::= "VInt" "(" Int ")"
+                 | "VBool" "(" Bool ")"
+                 | "VString" "(" String ")"
+                 | "VFloat" "(" String ")"
+                 | "VList" "(" PyVals ")"
+                 | "VDict"
+                 | "VNone"
+                 | "VOpaque" "(" String ")"
+  syntax PyVals ::= List{PyVal, ","}
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports STRING
+
+  syntax RuntimeFunction ::= "function" "(" String "," Stmts ")"
+  syntax Functions ::= ".Functions"
+                     | "bindFunction" "(" String "," RuntimeFunction "," Functions ")"
+  syntax Env ::= ".Env"
+               | "bind" "(" String "," PyVal "," Env ")"
+  syntax Result ::= "noResult"
+                  | "result" "(" PyVal ")"
+
+  syntax KItem ::= "bootstrap"
+                 | "load" "(" Stmts ")"
+                 | "invoke" "(" String "," PyVal ")"
+                 | "exec" "(" Stmts ")"
+                 | "finish" "(" PyVal ")"
+
+  configuration
+    <mpy>
+      <k> bootstrap ~> invoke("filter_integers", $INPUT:PyVal) </k>
+      <program> $PGM:Module </program>
+      <functions> .Functions </functions>
+      <env> .Env </env>
+      <return> noResult </return>
+    </mpy>
+
+  rule <k> bootstrap => load(SS) ... </k>
+       <program> Module(SS) </program>
+
+  rule <k> load(.Stmts) => .K ... </k>
+  rule <k> load(ImportFrom(_, _) SS) => load(SS) ... </k>
+  rule <k> load(FuncDef(F, Params(P), BODY) SS) => load(SS) ... </k>
+       <functions> FUNS => bindFunction(F, function(P, BODY), FUNS) </functions>
+
+  rule <k> invoke(F, V) => exec(BODY) ... </k>
+       <functions> bindFunction(F, function(P, BODY), _) </functions>
+       <env> _ => bind(P, V, .Env) </env>
+
+  rule <k> exec(Return(E)) => finish(eval(E, ENV)) ... </k>
+       <env> ENV </env>
+
+  rule <k> finish(V) => .K ... </k>
+       <return> _ => result(V) </return>
+
+  syntax PyVal ::= eval(Expr, Env) [function]
+  rule eval(Int(I), _) => VInt(I)
+  rule eval(Bool(B), _) => VBool(B)
+  rule eval(Str(S), _) => VString(S)
+  rule eval(Name(X), bind(X, V, _)) => V
+  rule eval(Name(X), bind(Y, _, ENV)) => eval(Name(X), ENV)
+    requires X =/=String Y
+  rule eval(ListExpr(.Exprs), _) => VList(.PyVals)
+  rule eval(Call(Name("isinstance"), E, Name("int")), ENV)
+    => VBool(pythonIsInteger(eval(E, ENV)))
+  rule eval(ListComp(E, CompFor(Name(X), ITER, COND)), ENV)
+    => comprehend(eval(ITER, ENV), X, E, COND, ENV)
+
+  syntax Bool ::= pythonIsInteger(PyVal) [function, total]
+  rule pythonIsInteger(VInt(_)) => true
+  rule pythonIsInteger(VBool(_)) => true
+  rule pythonIsInteger(_) => false [owise]
+
+  syntax PyVal ::= comprehend(PyVal, String, Expr, Expr, Env)
+                   [function]
+  rule comprehend(VList(.PyVals), _, _, _, _) => VList(.PyVals)
+  rule comprehend(VList(V, VS), X, E, C, ENV)
+    => keepIf(eval(C, bind(X, V, ENV)),
+              eval(E, bind(X, V, ENV)),
+              comprehend(VList(VS), X, E, C, ENV))
+
+  syntax PyVal ::= keepIf(PyVal, PyVal, PyVal) [function]
+  rule keepIf(VBool(true), V, TAIL) => prepend(V, TAIL)
+  rule keepIf(VBool(false), _, TAIL) => TAIL
+
+  // Prepending is kept separate so symbolic proofs can expose one filtering
+  // step without first having to evaluate an arbitrary list tail.
+  syntax PyVal ::= prepend(PyVal, PyVal) [function]
+  rule prepend(V, VList(VS)) => VList(V, VS)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7eb1013a5035c137b668d4b50e9daf0d37a4459d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,5 @@
+from typing import List, Any
+
+
+def filter_integers(values: List[Any]) -> List[int]:
+    return [value for value in values if isinstance(value, int)]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ce05fec5fcdac83bcaeae1ba8ca0b20dca26913e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,101 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // Semantic lemma: the list-comprehension evaluator agrees with an
+  // independently defined stable-filter model on a heterogeneous example.
+  claim <k>
+          eval(filterExpression(),
+            bind("values",
+              VList(VString("a"), VFloat("3.14"), VInt(5)), .Env))
+          => VList(onlyIntegerInstances(
+               VString("a"), VFloat("3.14"), VInt(5)))
+        </k>
+
+  // The two examples in the HumanEval prompt, proved through module loading,
+  // name binding, function invocation, and comprehension evaluation.
+  claim
+      <k> bootstrap ~> invoke("filter_integers",
+            VList(VString("a"), VFloat("3.14"), VInt(5))) => .K </k>
+      <program> solutionModule() </program>
+      <functions>
+        .Functions
+        =>
+        bindFunction("filter_integers",
+          function("values", Return(filterExpression())), .Functions)
+      </functions>
+      <env>
+        .Env
+        =>
+        bind("values",
+          VList(VString("a"), VFloat("3.14"), VInt(5)), .Env)
+      </env>
+      <return> noResult => result(VList(VInt(5))) </return>
+
+  claim
+      <k> bootstrap ~> invoke("filter_integers",
+            VList(VInt(1), VInt(2), VInt(3), VString("abc"),
+                  VDict, VList(.PyVals))) => .K </k>
+      <program> solutionModule() </program>
+      <functions>
+        .Functions
+        =>
+        bindFunction("filter_integers",
+          function("values", Return(filterExpression())), .Functions)
+      </functions>
+      <env>
+        .Env
+        =>
+        bind("values",
+          VList(VInt(1), VInt(2), VInt(3), VString("abc"),
+                VDict, VList(.PyVals)), .Env)
+      </env>
+      <return>
+        noResult => result(VList(VInt(1), VInt(2), VInt(3)))
+      </return>
+
+  // Boundary cases: empty input and Python's bool-is-an-int behavior.
+  claim <k>
+          eval(filterExpression(), bind("values", VList(.PyVals), .Env))
+          => VList(.PyVals)
+        </k>
+
+  claim <k>
+          eval(filterExpression(),
+            bind("values",
+              VList(VBool(true), VBool(false), VInt(0),
+                    VInt(-4), VFloat("2.0")), .Env))
+          => VList(VBool(true), VBool(false), VInt(0), VInt(-4))
+        </k>
+
+  // Symbolic payloads cover every runtime value constructor.  This checks
+  // type selection independently of particular integer/string contents.
+  claim <k>
+          eval(filterExpression(),
+            bind("values",
+              VList(VString(S), VFloat(F), VInt(I), VBool(B),
+                    VList(INNER), VDict, VNone, VOpaque(O), VInt(J)),
+              .Env))
+          => VList(onlyIntegerInstances(
+               VString(S), VFloat(F), VInt(I), VBool(B),
+               VList(INNER), VDict, VNone, VOpaque(O), VInt(J)))
+        </k>
+
+  // Postcondition witnesses: every value in each computed result is an int
+  // instance, while order and duplicates are retained by the model.
+  claim <k>
+          containsOnlyIntegerInstances(
+            onlyIntegerInstances(
+              VString("x"), VInt(2), VInt(2), VDict,
+              VBool(true), VFloat("2.0"), VInt(-1)))
+          => true
+        </k>
+
+  claim <k>
+          onlyIntegerInstances(
+            VString("x"), VInt(2), VInt(2), VDict,
+            VBool(true), VFloat("2.0"), VInt(-1))
+          => VInt(2), VInt(2), VBool(true), VInt(-1)
+        </k>
+endmodule
