+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // Semantic lemma: the list-comprehension evaluator agrees with an
+  // independently defined stable-filter model on a heterogeneous example.
+  claim <k>
+          eval(filterExpression(),
+            bind("values",
+              VList(VString("a"), VFloat("3.14"), VInt(5)), .Env))
+          => VList(VInt(5))
+        </k>
+
+  // The two examples in the HumanEval prompt, proved through module loading,
+  // name binding, function invocation, and comprehension evaluation.
+  claim
+    <mpy>
+      <k> bootstrap ~> invoke("filter_integers",
+            VList(VString("a"), VFloat("3.14"), VInt(5))) </k>
+      <program> solutionModule() </program>
+      <functions> .Functions </functions>
+      <env> .Env </env>
+      <return> noResult </return>
+    </mpy>
+  =>
+    <mpy>
+      <k> .K </k>
+      <program> solutionModule() </program>
+      <functions>
+        bindFunction("filter_integers",
+          function("values", Return(filterExpression())), .Functions)
+      </functions>
+      <env>
+        bind("values",
+          VList(VString("a"), VFloat("3.14"), VInt(5)), .Env)
+      </env>
+      <return> result(VList(VInt(5))) </return>
+    </mpy>
+
+  claim
+    <mpy>
+      <k> bootstrap ~> invoke("filter_integers",
+            VList(VInt(1), VInt(2), VInt(3), VString("abc"),
+                  VDict, VList(.PyVals))) </k>
+      <program> solutionModule() </program>
+      <functions> .Functions </functions>
+      <env> .Env </env>
+      <return> noResult </return>
+    </mpy>
+  =>
+    <mpy>
+      <k> .K </k>
+      <program> solutionModule() </program>
+      <functions>
+        bindFunction("filter_integers",
+          function("values", Return(filterExpression())), .Functions)
+      </functions>
+      <env>
+        bind("values",
+          VList(VInt(1), VInt(2), VInt(3), VString("abc"),
+                VDict, VList(.PyVals)), .Env)
+      </env>
+      <return> result(VList(VInt(1), VInt(2), VInt(3))) </return>
+    </mpy>
+
+  // Boundary cases: empty input and Python's bool-is-an-int behavior.
+  claim <k>
+          eval(filterExpression(), bind("values", VList(.PyVals), .Env))
+          => VList(.PyVals)
+        </k>
+
+  claim <k>
+          eval(filterExpression(),
+            bind("values",
+              VList(VBool(true), VBool(false), VInt(0),
+                    VInt(-4), VFloat("2.0")), .Env))
+          => VList(VBool(true), VBool(false), VInt(0), VInt(-4))
+        </k>
+
+  // Postcondition witnesses: every value in each computed result is an int
+  // instance, while order and duplicates are retained by the model.
+  claim <k>
+          containsOnlyIntegerInstances(
+            onlyIntegerInstances(
+              VString("x"), VInt(2), VInt(2), VDict,
+              VBool(true), VFloat("2.0"), VInt(-1)))
+          => true
+        </k>
+
+  claim <k>
+          onlyIntegerInstances(
+            VString("x"), VInt(2), VInt(2), VDict,
+            VBool(true), VFloat("2.0"), VInt(-1))
+          => VInt(2), VInt(2), VBool(true), VInt(-1)
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d6f1fa4e45b0c724311dfd5a68ae51446688e09
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY
+
+  // A closed term for the translated solution.  The same constructors appear
+  // in solution.mpy; prove.sh regenerates that file before either execution or
+  // proof, so parser drift is caught before the claims are attempted.
+  syntax Module ::= solutionModule() [function]
+  rule solutionModule()
+    => Module(
+         ImportFrom("typing", "List", "Any")
+         FuncDef("filter_integers", Params("values"),
+           Return(
+             ListComp(Name("value"),
+               CompFor(Name("value"), Name("values"),
+                 Call(Name("isinstance"), Name("value"), Name("int")))))))
+
+  syntax Expr ::= filterExpression() [function]
+  rule filterExpression()
+    => ListComp(Name("value"),
+         CompFor(Name("value"), Name("values"),
+           Call(Name("isinstance"), Name("value"), Name("int"))))
+
+  // Independent mathematical model of stable filtering.  VBool is retained:
+  // bool is a subclass of int, hence isinstance(True, int) in Python.
+  syntax PyVals ::= onlyIntegerInstances(PyVals) [function, total]
+  rule onlyIntegerInstances(.PyVals) => .PyVals
+  rule onlyIntegerInstances(VInt(I), VS)
+    => VInt(I), onlyIntegerInstances(VS)
+  rule onlyIntegerInstances(VBool(B), VS)
+    => VBool(B), onlyIntegerInstances(VS)
+  rule onlyIntegerInstances(VString(_), VS)
+    => onlyIntegerInstances(VS)
+  rule onlyIntegerInstances(VFloat(_), VS)
+    => onlyIntegerInstances(VS)
+  rule onlyIntegerInstances(VList(_), VS)
+    => onlyIntegerInstances(VS)
+  rule onlyIntegerInstances(VDict, VS)
+    => onlyIntegerInstances(VS)
+  rule onlyIntegerInstances(VNone, VS)
+    => onlyIntegerInstances(VS)
+  rule onlyIntegerInstances(VOpaque(_), VS)
+    => onlyIntegerInstances(VS)
+
+  syntax Bool ::= containsOnlyIntegerInstances(PyVals) [function, total]
+  rule containsOnlyIntegerInstances(.PyVals) => true
+  rule containsOnlyIntegerInstances(VInt(_), VS)
+    => containsOnlyIntegerInstances(VS)
+  rule containsOnlyIntegerInstances(VBool(_), VS)
+    => containsOnlyIntegerInstances(VS)
+  rule containsOnlyIntegerInstances(_, _) => false [owise]
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..771165f205f778d6f43d1d2c9266a89a0ef06a75
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,115 @@
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructors emitted by py2mpy.py for this program.  Statement and
+  // comprehension lists use juxtaposition, exactly as the translator does.
+  syntax Module ::= "Module" "(" Stmts ")" [symbol]
+  syntax Stmts ::= List{Stmt, ""} [symbol]
+  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")" [symbol]
+                | "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Return" "(" Expr ")" [symbol]
+
+  syntax Params ::= "Params" "(" Strings ")" [symbol]
+  syntax Strings ::= List{String, ","} [symbol]
+
+  syntax Expr ::= "Name" "(" String ")" [symbol]
+                | "Int" "(" Int ")" [symbol]
+                | "Bool" "(" Bool ")" [symbol]
+                | "Str" "(" String ")" [symbol]
+                | "ListExpr" "(" Exprs ")" [symbol]
+                | "Call" "(" Expr "," Exprs ")" [symbol]
+                | "ListComp" "(" Expr "," CompFors ")" [symbol]
+  syntax Exprs ::= List{Expr, ","} [symbol]
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Exprs ")" [symbol]
+  syntax CompFors ::= List{CompFor, ""} [symbol]
+
+  // Runtime values are deliberately distinct from source expressions.
+  // VBool is an instance of int in Python, a detail captured by isInt below.
+  syntax PyVal ::= "VInt" "(" Int ")" [symbol]
+                 | "VBool" "(" Bool ")" [symbol]
+                 | "VString" "(" String ")" [symbol]
+                 | "VFloat" "(" String ")" [symbol]
+                 | "VList" "(" PyVals ")" [symbol]
+                 | "VDict" [symbol]
+                 | "VNone" [symbol]
+                 | "VOpaque" "(" String ")" [symbol]
+  syntax PyVals ::= List{PyVal, ","} [symbol]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports STRING
+
+  syntax RuntimeFunction ::= "function" "(" String "," Stmts ")" [symbol]
+  syntax Functions ::= ".Functions" [symbol]
+                     | "bindFunction" "(" String "," RuntimeFunction "," Functions ")" [symbol]
+  syntax Env ::= ".Env" [symbol]
+               | "bind" "(" String "," PyVal "," Env ")" [symbol]
+  syntax Result ::= "noResult" [symbol]
+                  | "result" "(" PyVal ")" [symbol]
+
+  syntax KItem ::= "bootstrap" [symbol]
+                 | "load" "(" Stmts ")" [symbol]
+                 | "invoke" "(" String "," PyVal ")" [symbol]
+                 | "exec" "(" Stmts ")" [symbol]
+                 | "finish" "(" PyVal ")" [symbol]
+
+  configuration
+    <mpy>
+      <k> bootstrap ~> invoke("filter_integers", $INPUT:PyVal) </k>
+      <program> $PGM:Module </program>
+      <functions> .Functions </functions>
+      <env> .Env </env>
+      <return> noResult </return>
+    </mpy>
+
+  rule <k> bootstrap => load(SS) ... </k>
+       <program> Module(SS) </program>
+
+  rule <k> load(.Stmts) => . ... </k>
+  rule <k> load(ImportFrom(_, _) SS) => load(SS) ... </k>
+  rule <k> load(FuncDef(F, Params(P), BODY) SS) => load(SS) ... </k>
+       <functions> FUNS => bindFunction(F, function(P, BODY), FUNS) </functions>
+
+  rule <k> invoke(F, V) => exec(BODY) ... </k>
+       <functions> bindFunction(F, function(P, BODY), _) </functions>
+       <env> _ => bind(P, V, .Env) </env>
+
+  rule <k> exec(Return(E)) => finish(eval(E, ENV)) ... </k>
+       <env> ENV </env>
+
+  rule <k> finish(V) => . ... </k>
+       <return> _ => result(V) </return>
+
+  syntax PyVal ::= eval(Expr, Env) [function, symbol]
+  rule eval(Int(I), _) => VInt(I)
+  rule eval(Bool(B), _) => VBool(B)
+  rule eval(Str(S), _) => VString(S)
+  rule eval(Name(X), bind(X, V, _)) => V
+  rule eval(Name(X), bind(Y, _, ENV)) => eval(Name(X), ENV)
+    requires X =/=String Y
+  rule eval(ListExpr(.Exprs), _) => VList(.PyVals)
+  rule eval(Call(Name("isinstance"), E, Name("int")), ENV)
+    => VBool(pythonIsInteger(eval(E, ENV)))
+  rule eval(ListComp(E, CompFor(Name(X), ITER, COND)), ENV)
+    => comprehend(eval(ITER, ENV), X, E, COND, ENV)
+
+  syntax Bool ::= pythonIsInteger(PyVal) [function, total, symbol]
+  rule pythonIsInteger(VInt(_)) => true
+  rule pythonIsInteger(VBool(_)) => true
+  rule pythonIsInteger(_) => false [owise]
+
+  syntax PyVal ::= comprehend(PyVal, String, Expr, Expr, Env)
+                   [function, total, symbol]
+  rule comprehend(VList(.PyVals), _, _, _, _) => VList(.PyVals)
+  rule comprehend(VList(V, VS), X, E, C, ENV)
+    => keepIf(eval(C, bind(X, V, ENV)),
+              eval(E, bind(X, V, ENV)),
+              comprehend(VList(VS), X, E, C, ENV))
+
+  syntax PyVal ::= keepIf(PyVal, PyVal, PyVal) [function, total, symbol]
+  rule keepIf(VBool(true), V, VList(VS)) => VList(V, VS)
+  rule keepIf(VBool(false), _, VList(VS)) => VList(VS)
+endmodule
