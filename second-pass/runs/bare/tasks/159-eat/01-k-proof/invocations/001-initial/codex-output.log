+         args(NUMBER, NEED, REMAINING)
+       )
+    => resultOf(evalStmts(
+         BODY,
+         ("number" |-> intVal(NUMBER))
+         ("need" |-> intVal(NEED))
+         ("remaining" |-> intVal(REMAINING))
+       ))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d9ffc8d1f6c4d1a35eb76c3cb387ee107fad23b1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,4 @@
+def eat(number, need, remaining):
+    if need <= remaining:
+        return [number + need, remaining - need]
+    return [number + remaining, 0]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95bf8150f863aa3966cc25aa6efc7aacb01c72ed
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <mpy>
+          <k> run(solutionProgram, args(NUMBER, NEED, REMAINING))
+            => carrotContract(NUMBER, NEED, REMAINING)
+          </k>
+        </mpy>
+    requires validInput(NUMBER, NEED, REMAINING)
+             andBool NEED <=Int REMAINING
+
+  claim <mpy>
+          <k> run(solutionProgram, args(NUMBER, NEED, REMAINING))
+            => carrotContract(NUMBER, NEED, REMAINING)
+          </k>
+        </mpy>
+    requires validInput(NUMBER, NEED, REMAINING)
+             andBool REMAINING <Int NEED
+
+  claim <mpy>
+          <k> run(solutionProgram, args(5, 6, 10))
+            => result(11, 4)
+          </k>
+        </mpy>
+
+  claim <mpy>
+          <k> run(solutionProgram, args(4, 8, 9))
+            => result(12, 1)
+          </k>
+        </mpy>
+
+  claim <mpy>
+          <k> run(solutionProgram, args(1, 10, 10))
+            => result(11, 0)
+          </k>
+        </mpy>
+
+  claim <mpy>
+          <k> run(solutionProgram, args(2, 11, 5))
+            => result(7, 0)
+          </k>
+        </mpy>
+endmodule
