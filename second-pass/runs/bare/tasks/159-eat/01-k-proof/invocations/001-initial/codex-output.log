    10	
    11	/**
    12	 * Apply the configuration concretization process. The implicit {@code <k>} cell is added by another
    13	 * stage, AddImplicitComputationCell.
    14	 *
    15	 * <p>The input may freely use various configuration abstractions and Full K flexibilites. See
    16	 * {@link IncompleteCellUtils} for a description of the expected term structure. The output will
    17	 * represent cells in strict accordance with their declared fixed-arity productions.
    18	 *
    19	 * <p>This is a simple composition of the {@link AddTopCellToRules}, {@link AddParentCells}, {@link
    20	 * CloseCells}, and {@link SortCells} passes, see their documentation for details on the
    21	 * transformations.
    22	 */
    23	public class ConcretizeCells {
    24	  final ConfigurationInfo configurationInfo;
    25	  final LabelInfo labelInfo;
    26	  final SortInfo sortInfo;
    27	  final Module module;
    28	
    29	  final AddParentCells addParentCells;
    30	  final CloseCells closeCells;
    31	  final SortCells sortCells;
    32	  private final AddTopCellToRules addRootCell;
    33	
    34	  public static Definition transformDefinition(Definition input) {
    35	    ConfigurationInfoFromModule configInfo = new ConfigurationInfoFromModule(input.mainModule());
    36	    LabelInfo labelInfo = new LabelInfoFromModule(input.mainModule());
    37	    SortInfo sortInfo = SortInfo.fromModule(input.mainModule());
    38	    return DefinitionTransformer.fromSentenceTransformer(
    39	            new ConcretizeCells(configInfo, labelInfo, sortInfo, input.mainModule())::concretize,
    40	            "concretizing configuration")
    41	        .apply(input);
    42	  }
    43	
    44	  public ConcretizeCells(
    45	      ConfigurationInfo configurationInfo, LabelInfo labelInfo, SortInfo sortInfo, Module module) {
    46	    this.configurationInfo = configurationInfo;
    47	    this.labelInfo = labelInfo;
    48	    this.sortInfo = sortInfo;
    49	    this.module = module;
    50	    addRootCell = new AddTopCellToRules(configurationInfo, labelInfo);
    51	    addParentCells = new AddParentCells(configurationInfo, labelInfo);
    52	    closeCells = new CloseCells(configurationInfo, sortInfo, labelInfo);
    53	    sortCells = new SortCells(configurationInfo, labelInfo, module);
    54	  }
    55	
    56	  public Sentence concretize(Module m, Sentence s) {
    57	    if (s instanceof Claim c && !hasCells(c.body())) {
    58	      return s;
    59	    }
    60	    s = addRootCell.addImplicitCells(s, m);
    61	    s = addParentCells.concretize(s);
    62	    s = closeCells.close(s);
    63	
    64	    s = sortCells.preprocess(s);
    65	    s = sortCells.sortCells(s);
    66	    s = sortCells.postprocess(s);
    67	    return s;
    68	  }
    69	
    70	  public static boolean hasCells(K item) {
    71	    if (IncompleteCellUtils.flattenCells(item).stream()
    72	        .anyMatch(
    73	            k -> k.att().get(Att.PRODUCTION(), Production.class).att().contains(Att.CELL()))) {
    74	      return true;
    75	    }
    76	
    77	    if (item instanceof KRewrite rew) {
    78	      return Stream.concat(
    79	              IncompleteCellUtils.flattenCells(rew.left()).stream(),
    80	              IncompleteCellUtils.flattenCells(rew.right()).stream())
    81	          .anyMatch(ConcretizeCells::hasCells);
    82	    }
    83	
    84	    return false;
    85	  }
