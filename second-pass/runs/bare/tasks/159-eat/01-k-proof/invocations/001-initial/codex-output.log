+    return [number + remaining, 0]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95bf8150f863aa3966cc25aa6efc7aacb01c72ed
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <mpy>
+          <k> run(solutionProgram, args(NUMBER, NEED, REMAINING))
+            => carrotContract(NUMBER, NEED, REMAINING)
+          </k>
+        </mpy>
+    requires validInput(NUMBER, NEED, REMAINING)
+             andBool NEED <=Int REMAINING
+
+  claim <mpy>
+          <k> run(solutionProgram, args(NUMBER, NEED, REMAINING))
+            => carrotContract(NUMBER, NEED, REMAINING)
+          </k>
+        </mpy>
+    requires validInput(NUMBER, NEED, REMAINING)
+             andBool REMAINING <Int NEED
+
+  claim <mpy>
+          <k> run(solutionProgram, args(5, 6, 10))
+            => result(11, 4)
+          </k>
+        </mpy>
+
+  claim <mpy>
+          <k> run(solutionProgram, args(4, 8, 9))
+            => result(12, 1)
+          </k>
+        </mpy>
+
+  claim <mpy>
+          <k> run(solutionProgram, args(1, 10, 10))
+            => result(11, 0)
+          </k>
+        </mpy>
+
+  claim <mpy>
+          <k> run(solutionProgram, args(2, 11, 5))
+            => result(7, 0)
+          </k>
+        </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1b1d7427ebf4d9d96aea4c93ed770846ebac2723
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // The independently stated mathematical contract for the rabbit task.
+  rule carrotContract(NUMBER, NEED, REMAINING)
+    => result(NUMBER +Int NEED, REMAINING -Int NEED)
+    requires NEED <=Int REMAINING
+  rule carrotContract(NUMBER, NEED, REMAINING)
+    => result(NUMBER +Int REMAINING, 0)
+    requires REMAINING <Int NEED
+
+  rule validInput(NUMBER, NEED, REMAINING)
+    => (0 <=Int NUMBER andBool NUMBER <=Int 1000)
+       andBool (0 <=Int NEED andBool NEED <=Int 1000)
+       andBool (0 <=Int REMAINING andBool REMAINING <=Int 1000)
+
+  // This is exactly the constructor tree generated in solution.mpy.
+  rule solutionProgram
+    => Module(
+         FuncDef("eat", Params("number", "need", "remaining"),
+           If(Compare(Name("need"), CmpOp("<=", Name("remaining"))),
+             Return(ListExpr(
+               BinOp("+", Name("number"), Name("need")),
+               BinOp("-", Name("remaining"), Name("need"))
+             )),
+             .Stmts
+           )
+           Return(ListExpr(
+             BinOp("+", Name("number"), Name("remaining")),
+             Int(0)
+           ))
+         )
+       )
+endmodule

