    84	  rule evalStmt(Return(E), RHO) => returned(evalExpr(E, RHO))
    85	  rule evalStmt(If(COND, THEN, ELSE), RHO)
    86	    => chooseBranch(evalExpr(COND, RHO), THEN, ELSE, RHO)
    87	  rule chooseBranch(boolVal(true), THEN, _, RHO) => evalStmts(THEN, RHO)
    88	  rule chooseBranch(boolVal(false), _, ELSE, RHO) => evalStmts(ELSE, RHO)
    89	
    90	  syntax Result ::= resultOf(Outcome) [function, total]
    91	  rule resultOf(returned(listVal(intVal(A), intVal(B)))) => result(A, B)
    92	
    93	  configuration
    94	    <mpy>
    95	      <k> run($PGM:Pgm, $ARGS:Args) </k>
    96	    </mpy>
    97	
    98	  rule run(
    99	         Module(FuncDef("eat", Params("number", "need", "remaining"), BODY)),
   100	         args(NUMBER, NEED, REMAINING)
   101	       )
   102	    => resultOf(evalStmts(
   103	         BODY,
   104	         ("number" |-> intVal(NUMBER))
   105	         ("need" |-> intVal(NEED))
   106	         ("remaining" |-> intVal(REMAINING))
   107	       ))
   108	endmodule
