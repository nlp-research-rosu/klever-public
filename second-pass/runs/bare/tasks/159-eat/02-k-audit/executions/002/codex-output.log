+  output="$(kprove "$spec" --definition proof-kompiled --spec-module "$module" 2>&1)"
+  status=$?
+  printf '%s\n' "$output"
+  printf '[exit=%d]\n' "$status"
+  if [[ "$status" -ne 0 || "$output" != *"#Top"* ]]; then
+    overall=1
+  fi
+done
+
+printf 'individual_claims=6 overall=%d\n' "$overall"
+exit "$overall"
