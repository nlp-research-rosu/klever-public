  scan_status="'$?
  printf '"'[declaration-scan-exit=%d]\\n' \""'$scan_status"
  printf '"'%s\\n' '"'$ rg -n "simplification|functional|opaque|priority|owise|anywhere|concrete" semantic.k verification.k spec.k'"'
  set +e
  extra_output=\""'$(rg -n '"'simplification|functional|opaque|priority|owise|anywhere|concrete' semantic.k verification.k spec.k 2>&1)\"
  extra_status="'$?
  set -e
  printf '"'%s\\n' \""'$extra_output"
  printf '"'[special-attribute-scan-exit=%d expected=1-for-no-matches]\\n' \""'$extra_status"
  test "$scan_status" -eq 0 -a "$extra_status" -eq 1
} 2>&1 | tee /audit-output/evidence/05-static-declaration-scan.log
status=${PIPESTATUS[0]}
printf '"'pipeline_status=%d\\n' \""'$status"
exit "$status"' in /tmp/audit-work/159-eat-audit/rebuild
