    16	       andBool (0 <=Int NEED andBool NEED <=Int 1000)
    17	       andBool (0 <=Int REMAINING andBool REMAINING <=Int 1000)
    18	
    19	  // This is exactly the constructor tree generated in solution.mpy.
    20	  rule solutionProgram
    21	    => Module(
    22	         FuncDef("eat", Params("number", "need", "remaining"),
    23	           If(Compare(Name("need"), CmpOp("<=", Name("remaining"))),
    24	             Return(ListExpr(
    25	               BinOp("+", Name("number"), Name("need")),
    26	               BinOp("-", Name("remaining"), Name("need"))
    27	             )),
    28	             .Stmts
    29	           )
    30	           Return(ListExpr(
    31	             BinOp("+", Name("number"), Name("remaining")),
    32	             Int(0)
    33	           ))
    34	         )
    35	       )
