new file mode 100644
index 0000000000000000000000000000000000000000..b5b3d73a03afe8e5e2a5b120241a5b83474c7ce0
--- /dev/null
+++ b/evidence/solution-body-mutated.py
@@ -0,0 +1,4 @@
+def eat(number, need, remaining):
+    if need <= remaining:
+        return [number + need + 1, remaining - need]
+    return [number + remaining, 0]
