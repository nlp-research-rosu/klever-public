--- /dev/null
+++ b/evidence/solution-body-mutated.py
@@ -0,0 +1,4 @@
+def eat(number, need, remaining):
+    if need <= remaining:
+        return [number + need + 1, remaining - need]
+    return [number + remaining, 0]
