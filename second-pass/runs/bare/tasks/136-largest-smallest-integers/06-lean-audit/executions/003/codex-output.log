+        "checks": checks,
+    }
+    print(json.dumps(report, indent=2, sort_keys=True))
+
+    bool_checks = {
+        key: value
+        for key, value in checks.items()
+        if isinstance(value, bool)
+    }
+    if not all(bool_checks.values()):
