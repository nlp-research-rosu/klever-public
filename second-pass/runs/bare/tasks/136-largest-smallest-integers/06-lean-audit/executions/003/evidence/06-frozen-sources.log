     1	def largest_smallest_integers(lst):
     2	    largest_negative = None
     3	    smallest_positive = None
     4	
     5	    for value in lst:
     6	        if value < 0:
     7	            if largest_negative is None:
     8	                largest_negative = value
     9	            else:
    10	                if value > largest_negative:
    11	                    largest_negative = value
    12	
    13	        if value > 0:
    14	            if smallest_positive is None:
    15	                smallest_positive = value
    16	            else:
    17	                if value < smallest_positive:
    18	                    smallest_positive = value
    19	
    20	    return (largest_negative, smallest_positive)
