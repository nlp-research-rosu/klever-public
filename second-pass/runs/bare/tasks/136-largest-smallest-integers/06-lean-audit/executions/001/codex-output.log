     5	    For(Name("value"), Name("lst"),
     6	      If(Compare(Name("value"), CmpOp("<", Int(0))),
     7	        If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
     8	          Assign(Name("largest_negative"), Name("value")),
     9	          If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
