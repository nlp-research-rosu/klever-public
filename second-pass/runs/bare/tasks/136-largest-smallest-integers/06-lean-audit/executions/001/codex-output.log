+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+  char link_path[4096];
+  char target[4096] = {0};
+  snprintf(link_path, sizeof(link_path), "/proc/%d/exe", getpid());
+  ssize_t count = readlink(link_path, target, sizeof(target));
