     5	
     6	  /*
     7	   * The translated module initializes both sentinels and reaches the loop
     8	   * with the arbitrary integer input unchanged.
     9	   */
    10	  claim
    11	    <k> run(solutionProgram, Value(pyIntList(IS)))
    12	      => iterateIntSeq("value", IS,
    13	           If(Compare(Name("value"), CmpOp("<", Int(0))),
    14	             If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
    15	               Assign(Name("largest_negative"), Name("value")),
    16	               If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
    17	                 Assign(Name("largest_negative"), Name("value")),
    18	                 .Stmts)),
    19	             .Stmts)
    20	           If(Compare(Name("value"), CmpOp(">", Int(0))),
    21	             If(Compare(Name("smallest_positive"), CmpOp("is", NoneVal)),
    22	               Assign(Name("smallest_positive"), Name("value")),
    23	               If(Compare(Name("value"), CmpOp("<", Name("smallest_positive"))),
    24	                 Assign(Name("smallest_positive"), Name("value")),
    25	                 .Stmts)),
    26	             .Stmts))
    27	         ~> exec(Return(
    28	              TupleExpr(Name("largest_negative"), Name("smallest_positive"))))
    29	    </k>
    30	    <env> .Map
    31	      => "largest_negative" |-> pyNone
    32	         "lst" |-> pyIntList(IS)
    33	         "smallest_positive" |-> pyNone
    34	    </env>
    35	    <steps> 0 </steps>
    36	
    37	  /*
    38	   * Generalized loop invariant.  K proves this claim circularly: nil is the
    39	   * base case; icon(I, IS) executes one operational iteration and reuses the
    40	   * claim on the strictly smaller tail IS.  Instantiating N and P with pyNone
    41	   * gives the HumanEval contract after the setup claim above.
    42	   */
    43	  claim
    44	    <k> iterateIntSeq("value", IS,
    45	          If(Compare(Name("value"), CmpOp("<", Int(0))),
    46	            If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
    47	              Assign(Name("largest_negative"), Name("value")),
    48	              If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
    49	                Assign(Name("largest_negative"), Name("value")),
    50	                .Stmts)),
    51	            .Stmts)
    52	          If(Compare(Name("value"), CmpOp(">", Int(0))),
    53	            If(Compare(Name("smallest_positive"), CmpOp("is", NoneVal)),
    54	              Assign(Name("smallest_positive"), Name("value")),
    55	              If(Compare(Name("value"), CmpOp("<", Name("smallest_positive"))),
    56	                Assign(Name("smallest_positive"), Name("value")),
    57	                .Stmts)),
    58	            .Stmts))
    59	        ~> exec(Return(
    60	             TupleExpr(Name("largest_negative"), Name("smallest_positive"))))
    61	      => pyTuple(#negFold(IS, N), #posFold(IS, P)) </k>
    62	    <env>
    63	      "largest_negative" |-> N
    64	      "smallest_positive" |-> P
    65	      "value" |-> _OLD
    66	      _REST:Map
    67	      => ?_
    68	    </env>
    69	    <steps> _S => ?_ </steps>
    70	
    71	  /*
    72	   * End-to-end correctness for every finite integer sequence.  The empty
    73	   * branch executes directly.  The nonempty branch executes its first real
    74	   * iteration, establishing the value binding required by the generalized
    75	   * loop invariant above, which then discharges the arbitrary tail.
    76	   */
    77	  claim
    78	    <k> run(solutionProgram, Value(pyIntList(IS)))
    79	      => pyTuple(#negFold(IS, pyNone), #posFold(IS, pyNone)) </k>
    80	    <env> .Map => ?_ </env>
    81	    <steps> 0 => ?_ </steps>
    82	endmodule

===== /reference/k-proof/solution.py =====
     1	def largest_smallest_integers(lst):
     2	    largest_negative = None
     3	    smallest_positive = None
     4	
     5	    for value in lst:
     6	        if value < 0:
     7	            if largest_negative is None:
     8	                largest_negative = value
     9	            else:
    10	                if value > largest_negative:
    11	                    largest_negative = value
    12	
    13	        if value > 0:
    14	            if smallest_positive is None:
    15	                smallest_positive = value
    16	            else:
    17	                if value < smallest_positive:
    18	                    smallest_positive = value
    19	
    20	    return (largest_negative, smallest_positive)

