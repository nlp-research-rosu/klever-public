+        checks,
+    )
+    check(
+        input_manifest["inventory_sha256"] == inventory["inventory_sha256"],
+        "Stage 4 inventory binding",
+        checks,
+    )
+    check(
+        input_manifest["verification_sha256"]
+        == inventory["verification_sha256"],
