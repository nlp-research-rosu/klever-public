+        checks,
+    )
+    check(
+        generator_manifest["exporter_sha256"]
+        == sha256_file(Path("/reference/tools/klean_export.py")),
+        "generator exporter source hash",
+        checks,
+    )
+    check(
+        generator_manifest["klean_py_sha256"]
+        == sha256_file(Path("/reference/tools/klean.py")),
