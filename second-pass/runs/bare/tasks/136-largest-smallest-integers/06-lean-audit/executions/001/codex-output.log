index 0000000000000000000000000000000000000000..eee0574a61f318903eab29431c1bad4345c5985b
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  const char prefix[] = "/proc/";
+  const char suffix[] = "/exe";
+  size_t length = strlen(path);
+  if (length > sizeof(prefix) - 1 + sizeof(suffix) - 1
+      && strncmp(path, prefix, sizeof(prefix) - 1) == 0
+      && strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}
diff --git a//tmp/audit-work/readlink_self.c b//tmp/audit-work/readlink_self.c
new file mode 100644
index 0000000000000000000000000000000000000000..ff2f7eb6717bd9a344c734343d741c30ee528de6
--- /dev/null
+++ b//tmp/audit-work/readlink_self.c
@@ -0,0 +1,20 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+  char link_path[4096];
+  char target[4096] = {0};
+  snprintf(link_path, sizeof(link_path), "/proc/%d/exe", getpid());
+  ssize_t count = readlink(link_path, target, sizeof(target));
+  if (count < 0) {
+    fprintf(stderr, "readlink(%s) failed: errno=%d (%s)\n",
+            link_path, errno, strerror(errno));
+    return 1;
+  }
+  printf("readlink(%s) -> %.*s (%zd bytes)\n",
+         link_path, (int)count, target, count);
+  return 0;
+}
