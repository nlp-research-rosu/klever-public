+    validated = validate_trust_boundary(K_WORKSPACE, DISCOVERY)
+    rules = inventory["rules"]
+    classified_entries = protected["rules"]
+    source_lines = (K_WORKSPACE / "verification.k").read_text().splitlines()
+
+    check(
