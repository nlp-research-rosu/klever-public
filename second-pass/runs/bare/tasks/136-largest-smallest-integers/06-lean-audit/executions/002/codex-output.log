+        and generator_manifest["klean_py_sha256"]
+        == sha256_file(Path("/reference/tools/klean.py")),
+        "recorded generator source hashes match trusted tools",
+        checks,
+    )
+    check(
+        klean_export.target_statement(GENERATED) is None,
+        "generated project has no target declaration",
+        checks,
+    )
+    check(
