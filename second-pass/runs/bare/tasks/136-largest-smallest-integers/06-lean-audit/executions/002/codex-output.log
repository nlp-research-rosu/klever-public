+    check(
+        resolution["selections"]["klean_generation"]["artifact_sha256"]
+        == pipeline_generation_hash
+        and resolution["selections"]["k_audit"]["artifact_sha256"]
+        == pipeline_audit_hash,
+        "selected artifact hashes match reconstructed tree hashes",
+        checks,
+    )
+
+    result = {
+        "audit_identity": {
