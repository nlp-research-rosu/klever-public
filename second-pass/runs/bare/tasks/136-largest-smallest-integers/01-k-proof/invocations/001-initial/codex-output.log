+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
