+  -cINPUT='ListExpr(Int(2), Int(4), Int(1), Int(3), Int(5), Int(7))'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr()'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr(Int(0))'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr(Int(-6), Int(-1), Int(-9), Int(4), Int(2))'
+
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..b0935ba6cae5ea690fae70f4e8e3261970faf8d2
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,170 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Exprs ::= List{Expr, ","}
+
+  syntax Params ::= "Params" "(" String ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax IntSeq ::= "nil"
+                  | "icon" "(" Int "," IntSeq ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "NoneVal"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "ListExpr" "(" Exprs ")"
+                | "TupleExpr" "(" Expr "," Expr ")"
+                | "Value" "(" PyVal ")"
+
+  syntax OptInt ::= "pyInt" "(" Int ")"
+                  | "pyNone"
+
+  syntax PyVal ::= OptInt
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" List ")"
+                 | "pyIntList" "(" IntSeq ")"
+                 | "pyTuple" "(" PyVal "," PyVal ")"
+
+  syntax KResult ::= PyVal
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:Expr) </k>
+      <env> .Map </env>
+      <steps> 0 </steps>
+    </mpy>
+
+  syntax KItem ::= "run" "(" Program "," Expr ")"
+                 | "start" "(" Program ")"
+                 | "exec" "(" Stmts ")"
+                 | "bind" "(" String "," PyVal ")"
+                 | "store" "(" String ")"
+                 | "branch" "(" Stmts "," Stmts ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," PyVal ")"
+                 | "tupleLeft" "(" Expr ")"
+                 | "tupleRight" "(" PyVal ")"
+                 | "makeList" "(" Exprs "," List ")"
+                 | "listValue" "(" Exprs "," List ")"
+                 | "loop" "(" String "," Stmts ")"
+                 | "iterate" "(" String "," List "," Stmts ")"
+                 | "iterateIntSeq" "(" String "," IntSeq "," Stmts ")"
+                 | "bindIteration" "(" String "," PyVal ")"
+                 | "iterationDone"
+
+  rule <k> run(P, E) => E ~> start(P) ... </k>
+  rule <k> V:PyVal ~> start(
+              Module(FuncDef(F, Params(X), BODY))
+            )
+         => bind(X, V) ~> exec(BODY) ... </k>
+
+  rule <k> bind(X, V) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> bind(X, V) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
+
+  rule <k> Int(I) => pyInt(I) ... </k>
+  rule <k> NoneVal => pyNone ... </k>
+  rule <k> Value(V) => V ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule <k> Assign(Name(X), E) => E ~> store(X) ... </k>
+  rule <k> V:PyVal ~> store(X) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> V:PyVal ~> store(X) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+
+  rule <k> Compare(E1, CmpOp(OP, E2))
+         => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:PyVal ~> compareLeft(OP, E2)
+         => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> pyInt(I2) ~> compareRight("<", pyInt(I1))
+         => pyBool(I1 <Int I2) ... </k>
+  rule <k> pyInt(I2) ~> compareRight(">", pyInt(I1))
+         => pyBool(I1 >Int I2) ... </k>
+  rule <k> pyNone ~> compareRight("is", pyNone)
+         => pyBool(true) ... </k>
+  rule <k> pyNone ~> compareRight("is", pyInt(I))
+         => pyBool(false) ... </k>
+
+  rule <k> If(E, THEN, ELSE)
+         => E ~> branch(THEN, ELSE) ... </k>
+  rule <k> pyBool(true) ~> branch(THEN, ELSE)
+         => exec(THEN) ... </k>
+  rule <k> pyBool(false) ~> branch(THEN, ELSE)
+         => exec(ELSE) ... </k>
+
+  rule <k> TupleExpr(E1, E2) => E1 ~> tupleLeft(E2) ... </k>
+  rule <k> V1:PyVal ~> tupleLeft(E2)
+         => E2 ~> tupleRight(V1) ... </k>
+  rule <k> V2:PyVal ~> tupleRight(V1)
+         => pyTuple(V1, V2) ... </k>
+
+  rule <k> ListExpr(ES) => makeList(ES, .List) ... </k>
+  rule <k> makeList(.Exprs, VS) => pyList(VS) ... </k>
+  rule <k> makeList(E:Expr, VS)
+         => E ~> listValue(.Exprs, VS) ... </k>
+  rule <k> makeList(E:Expr, ES:Exprs, VS)
+         => E ~> listValue(ES, VS) ... </k>
+  rule <k> V:PyVal ~> listValue(ES, VS)
+         => makeList(ES, VS ListItem(V)) ... </k>
+
+  rule <k> For(Name(X), E, BODY)
+         => E ~> loop(X, BODY) ... </k>
+  rule <k> pyList(VS) ~> loop(X, BODY)
+         => iterate(X, VS, BODY) ... </k>
+  rule <k> pyIntList(IS) ~> loop(X, BODY)
+         => iterateIntSeq(X, IS, BODY) ... </k>
+  rule <k> iterate(X, .List, BODY) => .K ... </k>
+  rule <k> iterate(X, ListItem(V) REST, BODY)
+         => bindIteration(X, V)
+         ~> exec(BODY)
+         ~> iterationDone
+         ~> iterate(X, REST, BODY) ... </k>
+  rule <k> iterateIntSeq(X, nil, BODY) => .K ... </k>
+  rule <k> iterateIntSeq(X, icon(I, IS), BODY)
+         => bindIteration(X, pyInt(I))
+         ~> exec(BODY)
+         ~> iterationDone
+         ~> iterateIntSeq(X, IS, BODY) ... </k>
+  rule <k> bindIteration(X, V) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> bindIteration(X, V) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+  rule <k> iterationDone => .K ... </k>
+       <steps> S => S +Int 1 </steps>
+
+  // A return abandons the remaining statement sequence in its function.
+  rule <k> Return(E) ~> exec(SS) => E ... </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..20db8bad66b4c2f508bc6b38b9b4048a6850be33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def largest_smallest_integers(lst):
+    largest_negative = None
+    smallest_positive = None
+
+    for value in lst:
+        if value < 0:
+            if largest_negative is None:
+                largest_negative = value
+            else:
+                if value > largest_negative:
+                    largest_negative = value
+
+        if value > 0:
+            if smallest_positive is None:
+                smallest_positive = value
+            else:
+                if value < smallest_positive:
+                    smallest_positive = value
+
+    return (largest_negative, smallest_positive)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4abf98ab9b493262d01bebea33f61b7c79c92ebd
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  /*
+   * The translated module initializes both sentinels and reaches the loop
+   * with the arbitrary integer input unchanged.
+   */
+  claim
+    <k> run(solutionProgram, Value(pyIntList(IS)))
+      => iterateIntSeq("value", IS,
+           If(Compare(Name("value"), CmpOp("<", Int(0))),
+             If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
+               Assign(Name("largest_negative"), Name("value")),
+               If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
+                 Assign(Name("largest_negative"), Name("value")),
+                 .Stmts)),
+             .Stmts)
+           If(Compare(Name("value"), CmpOp(">", Int(0))),
+             If(Compare(Name("smallest_positive"), CmpOp("is", NoneVal)),
+               Assign(Name("smallest_positive"), Name("value")),
+               If(Compare(Name("value"), CmpOp("<", Name("smallest_positive"))),
+                 Assign(Name("smallest_positive"), Name("value")),
+                 .Stmts)),
+             .Stmts))
+         ~> exec(Return(
+              TupleExpr(Name("largest_negative"), Name("smallest_positive"))))
+    </k>
+    <env> .Map
+      => "largest_negative" |-> pyNone
+         "lst" |-> pyIntList(IS)
+         "smallest_positive" |-> pyNone
+    </env>
+    <steps> 0 </steps>
+
+  /*
+   * Generalized loop invariant.  K proves this claim circularly: nil is the
+   * base case; icon(I, IS) executes one operational iteration and reuses the
+   * claim on the strictly smaller tail IS.  Instantiating N and P with pyNone
+   * gives the HumanEval contract after the setup claim above.
+   */
+  claim
+    <k> iterateIntSeq("value", IS,
+          If(Compare(Name("value"), CmpOp("<", Int(0))),
+            If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
+              Assign(Name("largest_negative"), Name("value")),
+              If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
+                Assign(Name("largest_negative"), Name("value")),
+                .Stmts)),
+            .Stmts)
+          If(Compare(Name("value"), CmpOp(">", Int(0))),
+            If(Compare(Name("smallest_positive"), CmpOp("is", NoneVal)),
+              Assign(Name("smallest_positive"), Name("value")),
+              If(Compare(Name("value"), CmpOp("<", Name("smallest_positive"))),
+                Assign(Name("smallest_positive"), Name("value")),
+                .Stmts)),
+            .Stmts))
+        ~> exec(Return(
+             TupleExpr(Name("largest_negative"), Name("smallest_positive"))))
+      => pyTuple(#negFold(IS, N), #posFold(IS, P)) </k>
+    <env>
+      "largest_negative" |-> N
+      "smallest_positive" |-> P
+      "value" |-> OLD
+      REST:Map
+      => ?_
+    </env>
+    <steps> S => ?_ </steps>
+
+  /*
+   * End-to-end correctness for every finite integer sequence.  The empty
+   * branch executes directly.  The nonempty branch executes its first real
+   * iteration, establishing the value binding required by the generalized
+   * loop invariant above, which then discharges the arbitrary tail.
+   */
+  claim
+    <k> run(solutionProgram, Value(pyIntList(IS)))
+      => pyTuple(#negFold(IS, pyNone), #posFold(IS, pyNone)) </k>
+    <env> .Map => ?_ </env>
+    <steps> 0 => ?_ </steps>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..41e86eeac45a148587fab32f37fdc9670138490a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,69 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+  imports K-EQUAL
+
+  // Independent mathematical folds for the two extrema.
+  syntax OptInt ::= "#negFold" "(" IntSeq "," OptInt ")" [function, total]
+                  | "#posFold" "(" IntSeq "," OptInt ")" [function, total]
+                  | "#negStep" "(" Int "," OptInt ")" [function, total]
+                  | "#posStep" "(" Int "," OptInt ")" [function, total]
+                  | "#negCandidate" "(" Int "," OptInt ")" [function, total]
+                  | "#posCandidate" "(" Int "," OptInt ")" [function, total]
+
+  rule #negFold(nil, N) => N
+  rule #negFold(icon(I, IS), N)
+    => #negFold(IS, #negStep(I, N))
+  rule #posFold(nil, P) => P
+  rule #posFold(icon(I, IS), P)
+    => #posFold(IS, #posStep(I, P))
+
+  rule #negStep(I, N)
+    => #if I <Int 0
+       #then #negCandidate(I, N)
+       #else N
+       #fi
+  rule #negCandidate(I, pyNone) => pyInt(I)
+  rule #negCandidate(I, pyInt(N))
+    => #if I >Int N
+       #then pyInt(I)
+       #else pyInt(N)
+       #fi
+
+  rule #posStep(I, P)
+    => #if I >Int 0
+       #then #posCandidate(I, P)
+       #else P
+       #fi
+  rule #posCandidate(I, pyNone) => pyInt(I)
+  rule #posCandidate(I, pyInt(P))
+    => #if I <Int P
+       #then pyInt(I)
+       #else pyInt(P)
+       #fi
+
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram => Module(
+    FuncDef("largest_smallest_integers", Params("lst"),
+      Assign(Name("largest_negative"), NoneVal)
+      Assign(Name("smallest_positive"), NoneVal)
+      For(Name("value"), Name("lst"),
+        If(Compare(Name("value"), CmpOp("<", Int(0))),
+          If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
+            Assign(Name("largest_negative"), Name("value")),
+            If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
+              Assign(Name("largest_negative"), Name("value")),
+              .Stmts)),
+          .Stmts)
+        If(Compare(Name("value"), CmpOp(">", Int(0))),
+          If(Compare(Name("smallest_positive"), CmpOp("is", NoneVal)),
+            Assign(Name("smallest_positive"), Name("value")),
+            If(Compare(Name("value"), CmpOp("<", Name("smallest_positive"))),
+              Assign(Name("smallest_positive"), Name("value")),
+              .Stmts)),
+          .Stmts))
+      Return(
+        TupleExpr(Name("largest_negative"), Name("smallest_positive")))))
+
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3cf6dd950516b2f8b48942958e869c92a2ef58b3
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr(Int(2), Int(4), Int(1), Int(3), Int(5), Int(7))'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr()'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr(Int(0))'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr(Int(-6), Int(-1), Int(-9), Int(4), Int(2))'
+
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..b0935ba6cae5ea690fae70f4e8e3261970faf8d2
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,170 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Exprs ::= List{Expr, ","}
+
+  syntax Params ::= "Params" "(" String ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax IntSeq ::= "nil"
+                  | "icon" "(" Int "," IntSeq ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "NoneVal"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "ListExpr" "(" Exprs ")"
+                | "TupleExpr" "(" Expr "," Expr ")"
+                | "Value" "(" PyVal ")"
+
+  syntax OptInt ::= "pyInt" "(" Int ")"
+                  | "pyNone"
+
+  syntax PyVal ::= OptInt
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" List ")"
+                 | "pyIntList" "(" IntSeq ")"
+                 | "pyTuple" "(" PyVal "," PyVal ")"
+
+  syntax KResult ::= PyVal
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:Expr) </k>
+      <env> .Map </env>
+      <steps> 0 </steps>
+    </mpy>
+
+  syntax KItem ::= "run" "(" Program "," Expr ")"
+                 | "start" "(" Program ")"
+                 | "exec" "(" Stmts ")"
+                 | "bind" "(" String "," PyVal ")"
+                 | "store" "(" String ")"
+                 | "branch" "(" Stmts "," Stmts ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," PyVal ")"
+                 | "tupleLeft" "(" Expr ")"
+                 | "tupleRight" "(" PyVal ")"
+                 | "makeList" "(" Exprs "," List ")"
+                 | "listValue" "(" Exprs "," List ")"
+                 | "loop" "(" String "," Stmts ")"
+                 | "iterate" "(" String "," List "," Stmts ")"
+                 | "iterateIntSeq" "(" String "," IntSeq "," Stmts ")"
+                 | "bindIteration" "(" String "," PyVal ")"
+                 | "iterationDone"
+
+  rule <k> run(P, E) => E ~> start(P) ... </k>
+  rule <k> V:PyVal ~> start(
+              Module(FuncDef(F, Params(X), BODY))
+            )
+         => bind(X, V) ~> exec(BODY) ... </k>
+
+  rule <k> bind(X, V) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> bind(X, V) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
+
+  rule <k> Int(I) => pyInt(I) ... </k>
+  rule <k> NoneVal => pyNone ... </k>
+  rule <k> Value(V) => V ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule <k> Assign(Name(X), E) => E ~> store(X) ... </k>
+  rule <k> V:PyVal ~> store(X) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> V:PyVal ~> store(X) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+
+  rule <k> Compare(E1, CmpOp(OP, E2))
+         => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:PyVal ~> compareLeft(OP, E2)
+         => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> pyInt(I2) ~> compareRight("<", pyInt(I1))
+         => pyBool(I1 <Int I2) ... </k>
+  rule <k> pyInt(I2) ~> compareRight(">", pyInt(I1))
+         => pyBool(I1 >Int I2) ... </k>
+  rule <k> pyNone ~> compareRight("is", pyNone)
+         => pyBool(true) ... </k>
+  rule <k> pyNone ~> compareRight("is", pyInt(I))
+         => pyBool(false) ... </k>
+
+  rule <k> If(E, THEN, ELSE)
+         => E ~> branch(THEN, ELSE) ... </k>
+  rule <k> pyBool(true) ~> branch(THEN, ELSE)
+         => exec(THEN) ... </k>
+  rule <k> pyBool(false) ~> branch(THEN, ELSE)
+         => exec(ELSE) ... </k>
+
+  rule <k> TupleExpr(E1, E2) => E1 ~> tupleLeft(E2) ... </k>
+  rule <k> V1:PyVal ~> tupleLeft(E2)
+         => E2 ~> tupleRight(V1) ... </k>
+  rule <k> V2:PyVal ~> tupleRight(V1)
+         => pyTuple(V1, V2) ... </k>
+
+  rule <k> ListExpr(ES) => makeList(ES, .List) ... </k>
+  rule <k> makeList(.Exprs, VS) => pyList(VS) ... </k>
+  rule <k> makeList(E:Expr, VS)
+         => E ~> listValue(.Exprs, VS) ... </k>
+  rule <k> makeList(E:Expr, ES:Exprs, VS)
+         => E ~> listValue(ES, VS) ... </k>
+  rule <k> V:PyVal ~> listValue(ES, VS)
+         => makeList(ES, VS ListItem(V)) ... </k>
+
+  rule <k> For(Name(X), E, BODY)
+         => E ~> loop(X, BODY) ... </k>
+  rule <k> pyList(VS) ~> loop(X, BODY)
+         => iterate(X, VS, BODY) ... </k>
+  rule <k> pyIntList(IS) ~> loop(X, BODY)
+         => iterateIntSeq(X, IS, BODY) ... </k>
+  rule <k> iterate(X, .List, BODY) => .K ... </k>
+  rule <k> iterate(X, ListItem(V) REST, BODY)
+         => bindIteration(X, V)
+         ~> exec(BODY)
+         ~> iterationDone
+         ~> iterate(X, REST, BODY) ... </k>
+  rule <k> iterateIntSeq(X, nil, BODY) => .K ... </k>
+  rule <k> iterateIntSeq(X, icon(I, IS), BODY)
+         => bindIteration(X, pyInt(I))
+         ~> exec(BODY)
+         ~> iterationDone
+         ~> iterateIntSeq(X, IS, BODY) ... </k>
+  rule <k> bindIteration(X, V) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> bindIteration(X, V) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+  rule <k> iterationDone => .K ... </k>
+       <steps> S => S +Int 1 </steps>
+
+  // A return abandons the remaining statement sequence in its function.
+  rule <k> Return(E) ~> exec(SS) => E ... </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..20db8bad66b4c2f508bc6b38b9b4048a6850be33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def largest_smallest_integers(lst):
+    largest_negative = None
+    smallest_positive = None
+
+    for value in lst:
+        if value < 0:
+            if largest_negative is None:
+                largest_negative = value
+            else:
+                if value > largest_negative:
+                    largest_negative = value
+
+        if value > 0:
+            if smallest_positive is None:
+                smallest_positive = value
+            else:
+                if value < smallest_positive:
+                    smallest_positive = value
+
+    return (largest_negative, smallest_positive)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4abf98ab9b493262d01bebea33f61b7c79c92ebd
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  /*
+   * The translated module initializes both sentinels and reaches the loop
+   * with the arbitrary integer input unchanged.
+   */
+  claim
+    <k> run(solutionProgram, Value(pyIntList(IS)))
+      => iterateIntSeq("value", IS,
+           If(Compare(Name("value"), CmpOp("<", Int(0))),
+             If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
+               Assign(Name("largest_negative"), Name("value")),
+               If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
+                 Assign(Name("largest_negative"), Name("value")),
+                 .Stmts)),
+             .Stmts)
+           If(Compare(Name("value"), CmpOp(">", Int(0))),
+             If(Compare(Name("smallest_positive"), CmpOp("is", NoneVal)),
+               Assign(Name("smallest_positive"), Name("value")),
+               If(Compare(Name("value"), CmpOp("<", Name("smallest_positive"))),
+                 Assign(Name("smallest_positive"), Name("value")),
+                 .Stmts)),
+             .Stmts))
+         ~> exec(Return(
+              TupleExpr(Name("largest_negative"), Name("smallest_positive"))))
+    </k>
+    <env> .Map
+      => "largest_negative" |-> pyNone
+         "lst" |-> pyIntList(IS)
+         "smallest_positive" |-> pyNone
+    </env>
+    <steps> 0 </steps>
+
+  /*
+   * Generalized loop invariant.  K proves this claim circularly: nil is the
+   * base case; icon(I, IS) executes one operational iteration and reuses the
+   * claim on the strictly smaller tail IS.  Instantiating N and P with pyNone
+   * gives the HumanEval contract after the setup claim above.
+   */
+  claim
+    <k> iterateIntSeq("value", IS,
+          If(Compare(Name("value"), CmpOp("<", Int(0))),
+            If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
+              Assign(Name("largest_negative"), Name("value")),
+              If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
+                Assign(Name("largest_negative"), Name("value")),
+                .Stmts)),
+            .Stmts)
+          If(Compare(Name("value"), CmpOp(">", Int(0))),
+            If(Compare(Name("smallest_positive"), CmpOp("is", NoneVal)),
+              Assign(Name("smallest_positive"), Name("value")),
+              If(Compare(Name("value"), CmpOp("<", Name("smallest_positive"))),
+                Assign(Name("smallest_positive"), Name("value")),
+                .Stmts)),
+            .Stmts))
+        ~> exec(Return(
+             TupleExpr(Name("largest_negative"), Name("smallest_positive"))))
+      => pyTuple(#negFold(IS, N), #posFold(IS, P)) </k>
+    <env>
+      "largest_negative" |-> N
+      "smallest_positive" |-> P
+      "value" |-> OLD
+      REST:Map
+      => ?_
+    </env>
+    <steps> S => ?_ </steps>
+
+  /*
+   * End-to-end correctness for every finite integer sequence.  The empty
+   * branch executes directly.  The nonempty branch executes its first real
+   * iteration, establishing the value binding required by the generalized
+   * loop invariant above, which then discharges the arbitrary tail.
+   */
+  claim
+    <k> run(solutionProgram, Value(pyIntList(IS)))
+      => pyTuple(#negFold(IS, pyNone), #posFold(IS, pyNone)) </k>
+    <env> .Map => ?_ </env>
+    <steps> 0 => ?_ </steps>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..41e86eeac45a148587fab32f37fdc9670138490a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,69 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+  imports K-EQUAL
+
+  // Independent mathematical folds for the two extrema.
+  syntax OptInt ::= "#negFold" "(" IntSeq "," OptInt ")" [function, total]
+                  | "#posFold" "(" IntSeq "," OptInt ")" [function, total]
+                  | "#negStep" "(" Int "," OptInt ")" [function, total]
+                  | "#posStep" "(" Int "," OptInt ")" [function, total]
+                  | "#negCandidate" "(" Int "," OptInt ")" [function, total]
+                  | "#posCandidate" "(" Int "," OptInt ")" [function, total]
+
+  rule #negFold(nil, N) => N
+  rule #negFold(icon(I, IS), N)
+    => #negFold(IS, #negStep(I, N))
+  rule #posFold(nil, P) => P
+  rule #posFold(icon(I, IS), P)
+    => #posFold(IS, #posStep(I, P))
+
+  rule #negStep(I, N)
+    => #if I <Int 0
+       #then #negCandidate(I, N)
+       #else N
+       #fi
+  rule #negCandidate(I, pyNone) => pyInt(I)
+  rule #negCandidate(I, pyInt(N))
+    => #if I >Int N
+       #then pyInt(I)
+       #else pyInt(N)
+       #fi
+
+  rule #posStep(I, P)
+    => #if I >Int 0
+       #then #posCandidate(I, P)
+       #else P
+       #fi
+  rule #posCandidate(I, pyNone) => pyInt(I)
+  rule #posCandidate(I, pyInt(P))
+    => #if I <Int P
+       #then pyInt(I)
+       #else pyInt(P)
+       #fi
+
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram => Module(
+    FuncDef("largest_smallest_integers", Params("lst"),
+      Assign(Name("largest_negative"), NoneVal)
+      Assign(Name("smallest_positive"), NoneVal)
+      For(Name("value"), Name("lst"),
+        If(Compare(Name("value"), CmpOp("<", Int(0))),
+          If(Compare(Name("largest_negative"), CmpOp("is", NoneVal)),
+            Assign(Name("largest_negative"), Name("value")),
+            If(Compare(Name("value"), CmpOp(">", Name("largest_negative"))),
+              Assign(Name("largest_negative"), Name("value")),
+              .Stmts)),
+          .Stmts)
+        If(Compare(Name("value"), CmpOp(">", Int(0))),
+          If(Compare(Name("smallest_positive"), CmpOp("is", NoneVal)),
+            Assign(Name("smallest_positive"), Name("value")),
+            If(Compare(Name("value"), CmpOp("<", Name("smallest_positive"))),
+              Assign(Name("smallest_positive"), Name("value")),
+              .Stmts)),
+          .Stmts))
+      Return(
+        TupleExpr(Name("largest_negative"), Name("smallest_positive")))))
+
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3cf6dd950516b2f8b48942958e869c92a2ef58b3
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr(Int(2), Int(4), Int(1), Int(3), Int(5), Int(7))'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr()'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr(Int(0))'
+krun solution.mpy \
+  --definition verification-kompiled \
+  -cINPUT='ListExpr(Int(-6), Int(-1), Int(-9), Int(4), Int(2))'
+
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..b0935ba6cae5ea690fae70f4e8e3261970faf8d2
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,170 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Exprs ::= List{Expr, ","}
+
+  syntax Params ::= "Params" "(" String ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax IntSeq ::= "nil"
+                  | "icon" "(" Int "," IntSeq ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "NoneVal"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "ListExpr" "(" Exprs ")"
+                | "TupleExpr" "(" Expr "," Expr ")"
+                | "Value" "(" PyVal ")"
+
+  syntax OptInt ::= "pyInt" "(" Int ")"
+                  | "pyNone"
+
+  syntax PyVal ::= OptInt
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" List ")"
+                 | "pyIntList" "(" IntSeq ")"
+                 | "pyTuple" "(" PyVal "," PyVal ")"
+
+  syntax KResult ::= PyVal
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:Expr) </k>
+      <env> .Map </env>
+      <steps> 0 </steps>
+    </mpy>
+
+  syntax KItem ::= "run" "(" Program "," Expr ")"
+                 | "start" "(" Program ")"
+                 | "exec" "(" Stmts ")"
+                 | "bind" "(" String "," PyVal ")"
+                 | "store" "(" String ")"
+                 | "branch" "(" Stmts "," Stmts ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," PyVal ")"
+                 | "tupleLeft" "(" Expr ")"
+                 | "tupleRight" "(" PyVal ")"
+                 | "makeList" "(" Exprs "," List ")"
+                 | "listValue" "(" Exprs "," List ")"
+                 | "loop" "(" String "," Stmts ")"
+                 | "iterate" "(" String "," List "," Stmts ")"
+                 | "iterateIntSeq" "(" String "," IntSeq "," Stmts ")"
+                 | "bindIteration" "(" String "," PyVal ")"
+                 | "iterationDone"
+
+  rule <k> run(P, E) => E ~> start(P) ... </k>
+  rule <k> V:PyVal ~> start(
+              Module(FuncDef(F, Params(X), BODY))
+            )
+         => bind(X, V) ~> exec(BODY) ... </k>
+
+  rule <k> bind(X, V) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> bind(X, V) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
+
+  rule <k> Int(I) => pyInt(I) ... </k>
+  rule <k> NoneVal => pyNone ... </k>
+  rule <k> Value(V) => V ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule <k> Assign(Name(X), E) => E ~> store(X) ... </k>
+  rule <k> V:PyVal ~> store(X) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> V:PyVal ~> store(X) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+
+  rule <k> Compare(E1, CmpOp(OP, E2))
+         => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:PyVal ~> compareLeft(OP, E2)
+         => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> pyInt(I2) ~> compareRight("<", pyInt(I1))
+         => pyBool(I1 <Int I2) ... </k>
+  rule <k> pyInt(I2) ~> compareRight(">", pyInt(I1))
+         => pyBool(I1 >Int I2) ... </k>
+  rule <k> pyNone ~> compareRight("is", pyNone)
+         => pyBool(true) ... </k>
+  rule <k> pyNone ~> compareRight("is", pyInt(I))
+         => pyBool(false) ... </k>
+
+  rule <k> If(E, THEN, ELSE)
+         => E ~> branch(THEN, ELSE) ... </k>
+  rule <k> pyBool(true) ~> branch(THEN, ELSE)
+         => exec(THEN) ... </k>
+  rule <k> pyBool(false) ~> branch(THEN, ELSE)
+         => exec(ELSE) ... </k>
+
+  rule <k> TupleExpr(E1, E2) => E1 ~> tupleLeft(E2) ... </k>
+  rule <k> V1:PyVal ~> tupleLeft(E2)
+         => E2 ~> tupleRight(V1) ... </k>
+  rule <k> V2:PyVal ~> tupleRight(V1)
+         => pyTuple(V1, V2) ... </k>
+
+  rule <k> ListExpr(ES) => makeList(ES, .List) ... </k>
+  rule <k> makeList(.Exprs, VS) => pyList(VS) ... </k>
+  rule <k> makeList(E:Expr, VS)
+         => E ~> listValue(.Exprs, VS) ... </k>
+  rule <k> makeList(E:Expr, ES:Exprs, VS)
+         => E ~> listValue(ES, VS) ... </k>
+  rule <k> V:PyVal ~> listValue(ES, VS)
+         => makeList(ES, VS ListItem(V)) ... </k>
+
+  rule <k> For(Name(X), E, BODY)
+         => E ~> loop(X, BODY) ... </k>
+  rule <k> pyList(VS) ~> loop(X, BODY)
+         => iterate(X, VS, BODY) ... </k>
+  rule <k> pyIntList(IS) ~> loop(X, BODY)
+         => iterateIntSeq(X, IS, BODY) ... </k>
+  rule <k> iterate(X, .List, BODY) => .K ... </k>
+  rule <k> iterate(X, ListItem(V) REST, BODY)
+         => bindIteration(X, V)
+         ~> exec(BODY)
+         ~> iterationDone
+         ~> iterate(X, REST, BODY) ... </k>
+  rule <k> iterateIntSeq(X, nil, BODY) => .K ... </k>
+  rule <k> iterateIntSeq(X, icon(I, IS), BODY)
+         => bindIteration(X, pyInt(I))
+         ~> exec(BODY)
+         ~> iterationDone
+         ~> iterateIntSeq(X, IS, BODY) ... </k>
+  rule <k> bindIteration(X, V) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> bindIteration(X, V) => .K ... </k>
+       <env> M => M [ X <- V ] </env>
+    requires notBool (X in_keys(M))
+  rule <k> iterationDone => .K ... </k>
+       <steps> S => S +Int 1 </steps>
+
+  // A return abandons the remaining statement sequence in its function.
+  rule <k> Return(E) ~> exec(SS) => E ... </k>
+endmodule
