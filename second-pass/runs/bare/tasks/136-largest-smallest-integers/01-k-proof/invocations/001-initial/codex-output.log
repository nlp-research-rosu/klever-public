+                | "ListExpr" "(" Exprs ")"
+                | "TupleExpr" "(" Expr "," Expr ")"
+                | "Value" "(" PyVal ")"
+
+  syntax OptInt ::= "pyInt" "(" Int ")"
+                  | "pyNone"
+
+  syntax PyVal ::= OptInt
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" List ")"
+                 | "pyIntList" "(" IntSeq ")"
+                 | "pyTuple" "(" PyVal "," PyVal ")"
+
+  syntax KResult ::= PyVal
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:Expr) </k>
+      <env> .Map </env>
+      <steps> 0 </steps>
+    </mpy>
+
+  syntax KItem ::= "run" "(" Program "," Expr ")"
+                 | "start" "(" Program ")"
+                 | "exec" "(" Stmts ")"
+                 | "bind" "(" String "," PyVal ")"
