import json
from collections import Counter
inv_path='/reference/rule-inventory.json'
out_path='/workspace/trust-boundary.json'
with open(inv_path) as f: inv=json.load(f)
with open(out_path) as f: out=json.load(f)
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
expected=[r['source_rule_id'] for r in inv['rules']]
actual=[r['source_rule_id'] for r in out['rules']]
assert actual == expected
assert len(actual) == len(set(actual)) == len(expected)
for i,r in enumerate(out['rules']):
    assert list(r.keys()) == ['source_rule_id','classification','rationale'], (i,list(r))
    assert r['classification'] in allowed
    assert isinstance(r['rationale'],str) and r['rationale'].strip()
for src, dst in zip(inv['rules'], out['rules']):
    if 'simplification' in src.get('attributes',[]):
        assert dst['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
counts=Counter(r['classification'] for r in out['rules'])
print('Validated inventory hash:', out['inventory_sha256'])
print('Validated ordered unique rule coverage:', len(actual), '/', len(expected))
print('Classification counts:', dict(counts))
print('Simplification-attributed rules:', sum('simplification' in r.get('attributes',[]) for r in inv['rules']))
