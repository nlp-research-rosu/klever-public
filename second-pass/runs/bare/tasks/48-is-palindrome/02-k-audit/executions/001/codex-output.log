+}
+
+scratch=/tmp/audit-work/48-is-palindrome
+probe_dir="$scratch/probes"
+definition="$scratch/build-final/semantic-llvm-kompiled"
+
+printf '$ python3 %q %q > %q\n' \
+  "$scratch/trusted/py2mpy.py" \
+  "$probe_dir/reverse_solution.py" \
