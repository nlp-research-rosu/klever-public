+               CmpOp(
+                 "==",
+                 Subscript(
+                   Name("text"),
+                   Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
+      </functions>
+      <env> .Map </env>
+    </py>
+endmodule
