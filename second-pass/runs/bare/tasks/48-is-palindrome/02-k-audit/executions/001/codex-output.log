+  printf '\n'
+  "$@" 2>&1
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+run find -P /candidate -maxdepth 1 -printf '%y\t%s\t%f\t%l\n'
+run find -P /reference -maxdepth 1 -printf '%y\t%s\t%f\t%l\n'
