+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" 2>&1
+  local status=$?
+  printf '[exit %d]\n' "$status"
