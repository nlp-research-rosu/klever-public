@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" 2>&1
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+scratch=/tmp/audit-work/48-is-palindrome
+mkdir -p "$scratch/source" "$scratch/trusted"
+
+for artifact in \
