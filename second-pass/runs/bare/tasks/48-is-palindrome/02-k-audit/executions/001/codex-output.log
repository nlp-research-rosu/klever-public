+  'Module|FuncDef|#invoke|isPalindrome|reverseString' \
+  "$scratch/source/solution.mpy" \
+  "$scratch/source/spec.k" \
+  "$scratch/source/verification.k" \
+  "$scratch/source/semantic.k" \
+  || exit $?
