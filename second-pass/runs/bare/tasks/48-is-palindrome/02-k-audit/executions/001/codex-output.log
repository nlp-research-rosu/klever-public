+status=$?
+sed -n '1,120p' "$probe_dir/reverse_translate.stderr"
+printf '[exit %d]\n' "$status"
+test "$status" -eq 0 || exit "$status"
+
+run sed -n 1,160p "$probe_dir/reverse_solution.mpy" || exit $?
+
+for arg in '"aba"' '"ab"' '"éaé"' '"🙂a🙂"' '"áa"'
