+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" 2>&1
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+scratch=/tmp/audit-work/48-is-palindrome
+definition="$scratch/build-final/verification-haskell-kompiled"
+witness_dir="$scratch/witnesses"
+
+run nl -ba "$scratch/source/semantic.k" || exit $?
+run nl -ba "$scratch/source/verification.k" || exit $?
+run nl -ba "$scratch/source/spec.k" || exit $?
+run sed -n 1681,1765p /usr/include/kframework/builtin/domains.md || exit $?
+run rg -n \
+  '^[[:space:]]*(syntax|rule|claim|configuration)\b|\[(function|total|functional|simplification|priority|anywhere|macro)' \
+  "$scratch/source/semantic.k" \
+  "$scratch/source/verification.k" \
+  "$scratch/source/spec.k" \
+  || exit $?
+
+run cmp -s \
+  "$witness_dir/spec-unicode-candidate-result.k" \
+  /audit-output/evidence/spec-unicode-candidate-result.k \
+  || exit $?
+run cmp -s \
+  "$witness_dir/spec-unicode-python-expected.k" \
+  /audit-output/evidence/spec-unicode-python-expected.k \
+  || exit $?
+
+run kprove "$witness_dir/spec-unicode-candidate-result.k" \
+  --definition "$definition" \
+  --spec-module SPEC-UNICODE-CANDIDATE-RESULT \
+  --dry-run \
+  || exit $?
+run kprove "$witness_dir/spec-unicode-candidate-result.k" \
+  --definition "$definition" \
+  --spec-module SPEC-UNICODE-CANDIDATE-RESULT \
+  || exit $?
+
+run kprove "$witness_dir/spec-unicode-python-expected.k" \
+  --definition "$definition" \
+  --spec-module SPEC-UNICODE-PYTHON-EXPECTED \
+  --dry-run \
+  || exit $?
+
+printf '$ kprove %q --definition %q --spec-module %q\n' \
+  "$witness_dir/spec-unicode-python-expected.k" \
+  "$definition" \
+  SPEC-UNICODE-PYTHON-EXPECTED
+set -o pipefail
+kprove "$witness_dir/spec-unicode-python-expected.k" \
+  --definition "$definition" \
+  --spec-module SPEC-UNICODE-PYTHON-EXPECTED \
+  2>&1 | tee "$scratch/witnesses/unicode-python-expected-proof.out"
+expected_status=${PIPESTATUS[0]}
+printf '[exit %d]\n' "$expected_status"
+
+run rg -n \
+  'WarnStuckClaimState|implication check|cannot be rewritten further|PyBool' \
+  "$scratch/witnesses/unicode-python-expected-proof.out" \
+  || exit $?
+
+if test "$expected_status" -eq 0
+then
+  printf 'unexpected_success=true\n'
+  exit 1
+fi
+printf 'expected_failure=true\n'

