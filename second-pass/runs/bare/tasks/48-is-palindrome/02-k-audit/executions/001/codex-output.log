+  /candidate/codex-output.log
+run python3 /audit-output/evidence/inspect_generation_trace.py \
+  /candidate/codex-trace/2026/07/22/rollout-2026-07-22T05-00-02-019f8944-9a29-7571-b7ea-8c931ba796a8.jsonl
