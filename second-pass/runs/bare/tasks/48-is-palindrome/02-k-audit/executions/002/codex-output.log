rg -n '"'\"case_count\"|\"failure_count\"|\"input\"|\"k_result\"|\"match\"|EXIT_STATUS' /audit-output/evidence/07-k-semantics-differential.log | sed -n '1,180p'
exit \""'$status"' in /tmp/audit-work/source
