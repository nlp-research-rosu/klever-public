--- /dev/null
+++ b/verification.k
@@ -0,0 +1,9 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Mathematical postcondition used by the reachability claim.
+  syntax Bool ::= isPalindrome(String) [function]
+  rule isPalindrome(S) => S ==String reverseString(S)
+endmodule

