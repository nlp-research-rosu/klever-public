+                 | "#return" | "#returnFrame" "(" Map ")"
+                 | "#compareRight" "(" CmpOp ")"
+                 | "#compareValues" "(" PyVal "," String ")"
+                 | "#applySlice" "(" Slice ")"
+                 | "#unaryMinus"
+
+  configuration
