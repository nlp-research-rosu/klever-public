new file mode 100644
index 0000000000000000000000000000000000000000..8b2dcba6ac8ac83b18f7bab7e96cae5298f0741f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <py>
+      <k>
+        Module(
+          FuncDef("is_palindrome", Params("text"),
+            Return(
+              Compare(
+                Name("text"),
+                CmpOp(
+                  "==",
+                  Subscript(
+                    Name("text"),
+                    Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))))))
+        ~> #invoke("is_palindrome", PyString(S:String))
+      => PyBool(isPalindrome(S))
+      </k>
+      <functions>
+        .Map
+      => "is_palindrome" |-> #function(
+           "text",
+           Return(
+             Compare(
+               Name("text"),
+               CmpOp(
+                 "==",
+                 Subscript(
+                   Name("text"),
+                   Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
+      </functions>
+      <env> .Map </env>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
