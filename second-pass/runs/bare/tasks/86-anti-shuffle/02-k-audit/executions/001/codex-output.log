@@ -0,0 +1,14 @@
+module UNICODE-FIDELITY-SPEC
+  imports VERIFICATION
+
+  // UTF-8 bytes for U+03A9. The identity baseline preserves CE A9, and both
+  // real Python implementations preserve the single code point, but the
+  // submitted semantics splits and sorts the bytes to A9 CE.
+  claim [python-unicode-result]:
+    <python>
+      <k> run(solutionProgram, "\xce\xa9") => .K </k>
+      <functions> .Stmts => solutionFunctions </functions>
+      <env> .Map </env>
+      <result> "" => "\xce\xa9" </result>
+    </python>
+endmodule

exec
/bin/bash -lc 'bash /audit-output/evidence/run_logged.sh /audit-output/evidence/unicode-fidelity-build.log timeout 120s kprove /audit-output/evidence/unicode-fidelity-spec.k --definition verification-fresh-kompiled --spec-module UNICODE-FIDELITY-SPEC --dry-run && bash /audit-output/evidence/run_logged.sh /audit-output/evidence/unicode-fidelity-proof.log timeout 120s kprove /audit-output/evidence/unicode-fidelity-spec.k --definition verification-fresh-kompiled --spec-module UNICODE-FIDELITY-SPEC; status=$?; sed -n '"'1,180p' /audit-output/evidence/unicode-fidelity-build.log; sed -n '1,280p' /audit-output/evidence/unicode-fidelity-proof.log; exit \""'$status"' in /tmp/audit-work/reconstruction
