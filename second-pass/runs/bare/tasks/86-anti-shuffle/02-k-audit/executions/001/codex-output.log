+    </python>
+
+  // Deliberately false: the satisfying input "ba" actually returns "ab".
+  claim [false-result]:
+    <python>
+      <k> run(solutionProgram, "ba") => .K </k>
+      <functions> .Stmts => solutionFunctions </functions>
+      <env> .Map </env>
+      <result> "" => "ba" </result>
+    </python>
+endmodule
diff --git a/evidence/unicode-fidelity-spec.k b/evidence/unicode-fidelity-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1a94da3d439a3ed8d181c2d433e06403a487d8b9
--- /dev/null
+++ b/evidence/unicode-fidelity-spec.k
@@ -0,0 +1,14 @@
+module UNICODE-FIDELITY-SPEC
+  imports VERIFICATION
+
+  // UTF-8 bytes for U+03A9. The identity baseline preserves CE A9, and both
+  // real Python implementations preserve the single code point, but the
+  // submitted semantics splits and sorts the bytes to A9 CE.
+  claim [python-unicode-result]:
+    <python>
+      <k> run(solutionProgram, "\xce\xa9") => .K </k>
+      <functions> .Stmts => solutionFunctions </functions>
+      <env> .Map </env>
+      <result> "" => "\xce\xa9" </result>
+    </python>
+endmodule
