index 0000000000000000000000000000000000000000..2ae1ed2a35d3e043ef5a46efabbb1102eae33aa0
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '\nEXIT_STATUS: %d\n' "$status"
+} >"$log" 2>&1
+
+exit "$status"
