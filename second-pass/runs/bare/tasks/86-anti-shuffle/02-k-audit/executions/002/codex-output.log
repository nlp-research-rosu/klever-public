@@ -0,0 +1,12 @@
+module UNICODE-INTENDED-SPEC
+  imports VERIFICATION
+
+  // Python treats Ω as one character; sorting a one-character word is identity.
+  claim [unicode-single-character]:
+    <python>
+      <k> run(solutionProgram, "Ω") => .K </k>
+      <functions> .Stmts => solutionFunctions </functions>
+      <env> .Map </env>
+      <result> "" => "Ω" </result>
+    </python>
+endmodule
diff --git a/evidence/audit-run.sh b/evidence/audit-run.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a3fde99c0cc65d419edd496b087a9fa75f800b1f
--- /dev/null
+++ b/evidence/audit-run.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: audit-run.sh LOG_NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}.log"
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_path"
+
+"$@" >>"$log_path" 2>&1
+status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$log_path"
+
+cat "$log_path"
+exit "$status"
