     1	def insert_char(char, word, before):
     2	    if word == "":
     3	        return before + char
     4	    if char <= word[0]:
     5	        return before + char + word
     6	    return insert_char(char, word[1:], before + word[0])
     7	
     8	
     9	def process_words(text, word, result):
    10	    if text == "":
    11	        return result + word
    12	    if text[0] == " ":
    13	        return process_words(text[1:], "", result + word + " ")
    14	    return process_words(
    15	        text[1:], insert_char(text[0], word, ""), result
    16	    )
    17	
    18	
    19	def anti_shuffle(s):
    20	    return process_words(s, "", "")
