diff --git a//tmp/audit-work/anti-shuffle/spec-unicode-intended.k b//tmp/audit-work/anti-shuffle/spec-unicode-intended.k
new file mode 100644
index 0000000000000000000000000000000000000000..a9a96338a892416c0402c6a2cb23624358c07e4f
--- /dev/null
+++ b//tmp/audit-work/anti-shuffle/spec-unicode-intended.k
@@ -0,0 +1,12 @@
+module UNICODE-INTENDED-SPEC
+  imports VERIFICATION
+
+  // Python treats Ω as one character; sorting a one-character word is identity.
+  claim [unicode-single-character]:
+    <python>
+      <k> run(solutionProgram, "Ω") => .K </k>
+      <functions> .Stmts => solutionFunctions </functions>
+      <env> .Map </env>
+      <result> "" => "Ω" </result>
+    </python>
+endmodule
diff --git a//tmp/audit-work/anti-shuffle/spec-unicode-probes.k b//tmp/audit-work/anti-shuffle/spec-unicode-probes.k
new file mode 100644
index 0000000000000000000000000000000000000000..596819958b27ae9ec145e37d73a26e942d48db97
--- /dev/null
+++ b//tmp/audit-work/anti-shuffle/spec-unicode-probes.k
@@ -0,0 +1,27 @@
+module UNICODE-PROBES
+  imports VERIFICATION
+
+  claim [escaped-identity]:
+    <python>
+      <k> run(solutionProgram, "\u03a9") => .K </k>
+      <functions> .Stmts => solutionFunctions </functions>
+      <env> .Map </env>
+      <result> "" => "\u03a9" </result>
+    </python>
+
+  claim [escaped-byte-reversal]:
+    <python>
+      <k> run(solutionProgram, "\u03a9") => .K </k>
+      <functions> .Stmts => solutionFunctions </functions>
+      <env> .Map </env>
+      <result> "" => "\xa9\xce" </result>
+    </python>
+
+  claim [escaped-empty-false]:
+    <python>
+      <k> run(solutionProgram, "\u03a9") => .K </k>
+      <functions> .Stmts => solutionFunctions </functions>
+      <env> .Map </env>
+      <result> "" => "" </result>
+    </python>
+endmodule
diff --git a/evidence/audit-run.sh b/evidence/audit-run.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a3fde99c0cc65d419edd496b087a9fa75f800b1f
--- /dev/null
+++ b/evidence/audit-run.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: audit-run.sh LOG_NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}.log"
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_path"
+
+"$@" >>"$log_path" 2>&1
+status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$log_path"
+
+cat "$log_path"
+exit "$status"
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..c8ceef052b9d4ef5555fd4cbaac40ce4758730d9
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""Independent differential test: trusted canonical.py vs submitted solution.py."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import itertools
+import random
+from pathlib import Path
+from types import ModuleType
+
+
+CANONICAL_PATH = Path("/tmp/audit-work/anti-shuffle/trusted/canonical.py")
+GENERATED_PATH = Path("/tmp/audit-work/anti-shuffle/solution.py")
+
+
+def load_module(name: str, path: Path) -> ModuleType:
+    spec = importlib.util.spec_from_file_location(name, path)
