+def insert_char(char, word):
+    if word == "":
+        return char
+    if char <= word[0]:
+        return char + word
+    return word[0] + insert_char(char, word[1:])
+
+
+def process_words(text, word):
+    if text == "":
+        return word
+    if text[0] == " ":
+        return word + " " + process_words(text[1:], "")
+    return process_words(text[1:], insert_char(text[0], word))
+
+
+def anti_shuffle(s):
+    return process_words(s, "")

