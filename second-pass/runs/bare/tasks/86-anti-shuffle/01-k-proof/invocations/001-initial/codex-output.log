+                 | compareRight ( String , String )
+                 | callOne ( String )
+                 | callSecond ( String , Expr , Expr )
+                 | callThird ( String , String , Expr )
+                 | callInvoke ( String , String , String )
+
+  configuration
+    <python>
+      <k> run($PGM, $INPUT) </k>
+      <functions> .Stmts </functions>
+      <env> .Map </env>
+      <result> "" </result>
+    </python>
+
+  rule <k> run(Module(FS), INPUT) => invoke("anti_shuffle", vals(INPUT)) </k>
+       <functions> _ => FS </functions>
+
+  rule <k> invoke(N, VS) => invokeFound(findFun(N, FS), VS) ... </k>
+       <functions> FS </functions>
+  rule <k> invokeFound(fun(P, B), VS) => exec(B) ~> restore(OLD) ... </k>
+       <env> OLD => bindParams(P, VS) </env>
+  rule <k> val(V) ~> restore(OLD) => val(V) ... </k>
+       <env> _ => OLD </env>
+
+  rule <k> exec(Return(E) REST) => eval(E) ~> returnValue ... </k>
+  rule <k> val(V) ~> returnValue => val(V) ... </k>
+  rule <k> exec(If(C, THEN, ELSE) REST) =>
+             eval(C) ~> ifKont(THEN, ELSE, REST) ...
+       </k>
+  rule <k> boolVal(B) ~> ifKont(THEN, _, REST) =>
+             exec(appendStmts(THEN, REST)) ...
+       </k>
+    requires B ==Bool true
+  rule <k> boolVal(B) ~> ifKont(_, ELSE, REST) =>
+             exec(appendStmts(ELSE, REST)) ...
+       </k>
+    requires B ==Bool false
+
+  rule <k> eval(Str(S)) => val(S) ... </k>
+  rule <k> eval(Name(N)) => val(V) ... </k>
+       <env> (N |-> V:String) _ </env>
+
+  rule <k> eval(BinOp("+", L, R)) => eval(L) ~> plusLeft(R) ... </k>
+  rule <k> val(L) ~> plusLeft(R) => eval(R) ~> plusRight(L) ... </k>
+  rule <k> val(R) ~> plusRight(L) => val(L +String R) ... </k>
+
+  rule <k> eval(Subscript(E, Int(I))) => eval(E) ~> indexKont(I) ... </k>
+  rule <k> val(S) ~> indexKont(I) => val(substrString(S, I, I +Int 1)) ... </k>
+  rule <k> eval(Subscript(E, Slice(Int(I), NoBound, NoBound))) =>
+             eval(E) ~> sliceKont(I) ...
+       </k>
+  rule <k> val(S) ~> sliceKont(I) =>
+             val(substrString(S, I, lengthString(S))) ...
+       </k>
+
+  rule <k> eval(Compare(L, CmpOp(OP, R))) =>
+             eval(L) ~> compareLeft(OP, R) ...
+       </k>
+  rule <k> val(L) ~> compareLeft(OP, R) =>
+             eval(R) ~> compareRight(OP, L) ...
+       </k>
+  rule <k> val(R) ~> compareRight("==", L) => boolVal(L ==String R) ... </k>
+  rule <k> val(R) ~> compareRight("<=", L) => boolVal(L <=String R) ... </k>
+
+  rule <k> eval(Call(Name(N), A)) => eval(A) ~> callOne(N) ... </k>
+  rule <k> val(A) ~> callOne(N) => invoke(N, vals(A)) ... </k>
+  rule <k> eval(Call(Name(N), A1, A2, A3)) =>
+             eval(A1) ~> callSecond(N, A2, A3) ...
+       </k>
+  rule <k> val(A1) ~> callSecond(N, A2, A3) =>
+             eval(A2) ~> callThird(N, A1, A3) ...
+       </k>
+  rule <k> val(A2) ~> callThird(N, A1, A3) =>
+             eval(A3) ~> callInvoke(N, A1, A2) ...
+       </k>
+  rule <k> val(A3) ~> callInvoke(N, A1, A2) =>
+             invoke(N, vals(A1, A2, A3)) ...
+       </k>
+
+  rule <k> val(V) => .K </k>
+       <result> _ => V </result>
+endmodule
diff --git a/solution.mpy b/solution.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..57672a1cb0749a9a4eec88af78122e0fc96bc6d9
--- /dev/null
+++ b/solution.mpy
@@ -0,0 +1,42 @@
+Module(
+  FuncDef("insert_char", Params("char", "word", "before"),
+    If(Compare(Name("word"), CmpOp("==", Str(""))),
+      Return(BinOp("+", Name("before"), Name("char"))),
+      )
+    If(Compare(Name("char"), CmpOp("<=", Subscript(Name("word"), Int(0)))),
+      Return(
+        BinOp(
+          "+",
+          BinOp("+", Name("before"), Name("char")),
+          Name("word"))),
+      )
+    Return(
+      Call(
+        Name("insert_char"),
+        Name("char"),
+        Subscript(Name("word"), Slice(Int(1), NoBound, NoBound)),
+        BinOp("+", Name("before"), Subscript(Name("word"), Int(0))))))
+  FuncDef("process_words", Params("text", "word", "result"),
+    If(Compare(Name("text"), CmpOp("==", Str(""))),
+      Return(BinOp("+", Name("result"), Name("word"))),
+      )
+    If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
+      Return(
+        Call(
+          Name("process_words"),
+          Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)),
+          Str(""),
+          BinOp("+", BinOp("+", Name("result"), Name("word")), Str(" ")))),
+      )
+    Return(
+      Call(
+        Name("process_words"),
+        Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)),
+        Call(
+          Name("insert_char"),
+          Subscript(Name("text"), Int(0)),
+          Name("word"),
+          Str("")),
+        Name("result"))))
+  FuncDef("anti_shuffle", Params("s"),
+    Return(Call(Name("process_words"), Name("s"), Str(""), Str("")))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f9ddc51f3dcd23138f73ad61b686f4ba70e340e1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def insert_char(char, word, before):
+    if word == "":
+        return before + char
+    if char <= word[0]:
+        return before + char + word
+    return insert_char(char, word[1:], before + word[0])
+
+
+def process_words(text, word, result):
+    if text == "":
+        return result + word
+    if text[0] == " ":
+        return process_words(text[1:], "", result + word + " ")
+    return process_words(
+        text[1:], insert_char(text[0], word, ""), result
+    )
+
+
+def anti_shuffle(s):
+    return process_words(s, "", "")
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0dbc8abd8a4623f24f15e4cd0fc5ebb9fa74a6c0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,35 @@
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional-correctness claim for every input string.
+  claim
+    <python>
+      <k> run(solutionProgram, S:String) => .K </k>
+      <result> "" => antiShuffleSpec(S) </result>
+    </python>
+
+  // Contract examples, plus explicit coverage of repeated/edge spaces.
+  claim
+    <python>
+      <k> run(solutionProgram, "Hi") => .K </k>
+      <result> "" => "Hi" </result>
+    </python>
+
+  claim
+    <python>
+      <k> run(solutionProgram, "hello") => .K </k>
+      <result> "" => "ehllo" </result>
+    </python>
+
+  claim
+    <python>
+      <k> run(solutionProgram, "Hello World!!!") => .K </k>
+      <result> "" => "Hello !!!Wdlor" </result>
+    </python>
+
+  claim
+    <python>
+      <k> run(solutionProgram, "  ba  dc ") => .K </k>
+      <result> "" => "  ab  cd " </result>
+    </python>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a0721fb0ff8d6756e16d71e43e1decd85d420e61
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,91 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact constructor term generated from solution.py.  Keeping it as a
+  // named constant makes the claims readable without adding behavior to it.
+  syntax Pgm ::= "solutionProgram" [function, total]
+  rule solutionProgram =>
+    Module(
+      FuncDef("insert_char", Params("char", "word", "before"),
+        If(Compare(Name("word"), CmpOp("==", Str(""))),
+          Return(BinOp("+", Name("before"), Name("char"))),
+          .Stmts)
+        If(Compare(Name("char"), CmpOp("<=", Subscript(Name("word"), Int(0)))),
+          Return(
+            BinOp(
+              "+",
+              BinOp("+", Name("before"), Name("char")),
+              Name("word"))),
+          .Stmts)
+        Return(
+          Call(
+            Name("insert_char"),
+            Name("char"),
+            Subscript(Name("word"), Slice(Int(1), NoBound, NoBound)),
+            BinOp("+", Name("before"), Subscript(Name("word"), Int(0))))))
+      FuncDef("process_words", Params("text", "word", "result"),
+        If(Compare(Name("text"), CmpOp("==", Str(""))),
+          Return(BinOp("+", Name("result"), Name("word"))),
+          .Stmts)
+        If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
+          Return(
+            Call(
+              Name("process_words"),
+              Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)),
+              Str(""),
+              BinOp("+", BinOp("+", Name("result"), Name("word")), Str(" ")))),
+          .Stmts)
+        Return(
+          Call(
+            Name("process_words"),
+            Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)),
+            Call(
+              Name("insert_char"),
+              Subscript(Name("text"), Int(0)),
+              Name("word"),
+              Str("")),
+            Name("result"))))
+      FuncDef("anti_shuffle", Params("s"),
+        Return(Call(Name("process_words"), Name("s"), Str(""), Str("")))))
+
+  // Mathematical reference: insert a character into an already sorted word.
+  // BEFORE is the prefix already known to be smaller than the character.
+  syntax String ::= refInsert ( String , String , String ) [function]
+
+  rule refInsert(C, "", BEFORE) => BEFORE +String C
+  rule refInsert(C, WORD, BEFORE) =>
+    BEFORE +String C +String WORD
+    requires WORD =/=String ""
+     andBool C <=String substrString(WORD, 0, 1)
+  rule refInsert(C, WORD, BEFORE) =>
+    refInsert(C,
+      substrString(WORD, 1, lengthString(WORD)),
+      BEFORE +String substrString(WORD, 0, 1))
+    requires WORD =/=String ""
+     andBool notBool (C <=String substrString(WORD, 0, 1))
+
+  // Mathematical reference: scan left-to-right, sorting one word at a time.
+  // RESULT contains all complete words and their original separating spaces.
+  syntax String ::= refProcess ( String , String , String ) [function]
+  syntax String ::= antiShuffleSpec ( String ) [function, total]
+
+  rule refProcess("", WORD, RESULT) => RESULT +String WORD
+  rule refProcess(TEXT, WORD, RESULT) =>
+    refProcess(
+      substrString(TEXT, 1, lengthString(TEXT)),
+      "",
+      RESULT +String WORD +String " ")
+    requires TEXT =/=String ""
+     andBool substrString(TEXT, 0, 1) ==String " "
+  rule refProcess(TEXT, WORD, RESULT) =>
+    refProcess(
+      substrString(TEXT, 1, lengthString(TEXT)),
+      refInsert(substrString(TEXT, 0, 1), WORD, ""),
+      RESULT)
+    requires TEXT =/=String ""
+     andBool substrString(TEXT, 0, 1) =/=String " "
+
+  rule antiShuffleSpec(S) => refProcess(S, "", "")
+endmodule

exec
/bin/bash -lc "krun solution.mpy --definition semantic-kompiled -cINPUT='\"Hello World"'!!!"'"' && krun solution.mpy --definition semantic-kompiled -cINPUT='\"  ba  dc \"' && krun solution.mpy --definition semantic-kompiled -cINPUT='\"\"'" in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6bda176f16bd2af2e2d51019bb3eaaf9070b25da
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,149 @@
+module MPY-SYNTAX
+  imports STRING-SYNTAX
+  imports INT-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" String ")"
+                  | "Params" "(" String "," String "," String ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Expr "," Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr
+                 | "Slice" "(" Expr "," "NoBound" "," "NoBound" ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports DOMAINS
+
+  syntax StrVals ::= "vals" "(" String ")"
+                   | "vals" "(" String "," String "," String ")"
+
+  syntax Function ::= "fun" "(" Params "," Stmts ")"
+  syntax Function ::= findFun ( String , Stmts ) [function]
+  syntax Map ::= bindParams ( Params , StrVals ) [function, total]
+  syntax Stmts ::= appendStmts ( Stmts , Stmts ) [function]
+
+  rule findFun(N, FuncDef(N, P, B) REST) => fun(P, B)
+  rule findFun(N, FuncDef(M, _, _) REST) => findFun(N, REST)
+    requires N =/=String M
+
+  rule bindParams(Params(P), vals(V)) => P |-> V
+  rule bindParams(Params(P1, P2, P3), vals(V1, V2, V3)) =>
+    (P1 |-> V1) (P2 |-> V2) (P3 |-> V3)
+
+  rule appendStmts(.Stmts, SECOND) => SECOND
+  rule appendStmts(S:Stmt REST, SECOND) => S appendStmts(REST, SECOND)
+
+  syntax KItem ::= run ( Pgm , String )
+                 | invoke ( String , StrVals )
+                 | invokeFound ( Function , StrVals )
+                 | exec ( Stmts )
+                 | eval ( Expr )
+                 | val ( String )
+                 | boolVal ( Bool )
+                 | restore ( Map )
+                 | "returnValue"
+                 | ifKont ( Stmts , Stmts , Stmts )
+                 | plusLeft ( Expr )
+                 | plusRight ( String )
+                 | indexKont ( Int )
+                 | sliceKont ( Int )
+                 | compareLeft ( String , Expr )
+                 | compareRight ( String , String )
+                 | callOne ( String )
+                 | callSecond ( String , Expr , Expr )
+                 | callThird ( String , String , Expr )
+                 | callInvoke ( String , String , String )
+
+  configuration
+    <python>
+      <k> run($PGM, $INPUT) </k>
+      <functions> .Stmts </functions>
+      <env> .Map </env>
+      <result> "" </result>
+    </python>
+
+  rule <k> run(Module(FS), INPUT) => invoke("anti_shuffle", vals(INPUT)) </k>
+       <functions> _ => FS </functions>
+
+  rule <k> invoke(N, VS) => invokeFound(findFun(N, FS), VS) ... </k>
+       <functions> FS </functions>
+  rule <k> invokeFound(fun(P, B), VS) => exec(B) ~> restore(OLD) ... </k>
+       <env> OLD => bindParams(P, VS) </env>
+  rule <k> val(V) ~> restore(OLD) => val(V) ... </k>
+       <env> _ => OLD </env>
+
+  rule <k> exec(Return(E) REST) => eval(E) ~> returnValue ... </k>
+  rule <k> val(V) ~> returnValue => val(V) ... </k>
+  rule <k> exec(If(C, THEN, ELSE) REST) =>
+             eval(C) ~> ifKont(THEN, ELSE, REST) ...
+       </k>
+  rule <k> boolVal(B) ~> ifKont(THEN, _, REST) =>
+             exec(appendStmts(THEN, REST)) ...
+       </k>
+    requires B ==Bool true
+  rule <k> boolVal(B) ~> ifKont(_, ELSE, REST) =>
+             exec(appendStmts(ELSE, REST)) ...
+       </k>
+    requires B ==Bool false
+
+  rule <k> eval(Str(S)) => val(S) ... </k>
+  rule <k> eval(Name(N)) => val(V) ... </k>
+       <env> (N |-> V:String) _ </env>
+
+  rule <k> eval(BinOp("+", L, R)) => eval(L) ~> plusLeft(R) ... </k>
+  rule <k> val(L) ~> plusLeft(R) => eval(R) ~> plusRight(L) ... </k>
+  rule <k> val(R) ~> plusRight(L) => val(L +String R) ... </k>
+
+  rule <k> eval(Subscript(E, Int(I))) => eval(E) ~> indexKont(I) ... </k>
+  rule <k> val(S) ~> indexKont(I) => val(substrString(S, I, I +Int 1)) ... </k>
+  rule <k> eval(Subscript(E, Slice(Int(I), NoBound, NoBound))) =>
+             eval(E) ~> sliceKont(I) ...
+       </k>
+  rule <k> val(S) ~> sliceKont(I) =>
+             val(substrString(S, I, lengthString(S))) ...
+       </k>
+
+  rule <k> eval(Compare(L, CmpOp(OP, R))) =>
+             eval(L) ~> compareLeft(OP, R) ...
+       </k>
+  rule <k> val(L) ~> compareLeft(OP, R) =>
+             eval(R) ~> compareRight(OP, L) ...
+       </k>
+  rule <k> val(R) ~> compareRight("==", L) => boolVal(L ==String R) ... </k>
+  rule <k> val(R) ~> compareRight("<=", L) => boolVal(L <=String R) ... </k>
+
+  rule <k> eval(Call(Name(N), A)) => eval(A) ~> callOne(N) ... </k>
+  rule <k> val(A) ~> callOne(N) => invoke(N, vals(A)) ... </k>
+  rule <k> eval(Call(Name(N), A1, A2, A3)) =>
+             eval(A1) ~> callSecond(N, A2, A3) ...
+       </k>
+  rule <k> val(A1) ~> callSecond(N, A2, A3) =>
+             eval(A2) ~> callThird(N, A1, A3) ...
+       </k>
+  rule <k> val(A2) ~> callThird(N, A1, A3) =>
+             eval(A3) ~> callInvoke(N, A1, A2) ...
+       </k>
+  rule <k> val(A3) ~> callInvoke(N, A1, A2) =>
+             invoke(N, vals(A1, A2, A3)) ...
+       </k>
+
+  rule <k> val(V) => .K </k>
+       <result> _ => V </result>
+endmodule
