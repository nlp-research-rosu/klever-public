+Module(
+  FuncDef("insert_char", Params("char", "word", "before"),
+    If(Compare(Name("word"), CmpOp("==", Str(""))),
+      Return(BinOp("+", Name("before"), Name("char"))),
+      )
+    If(Compare(Name("char"), CmpOp("<=", Subscript(Name("word"), Int(0)))),
+      Return(
+        BinOp(
+          "+",
+          BinOp("+", Name("before"), Name("char")),
+          Name("word"))),
+      )
+    Return(
+      Call(
+        Name("insert_char"),
+        Name("char"),
+        Subscript(Name("word"), Slice(Int(1), NoBound, NoBound)),
+        BinOp("+", Name("before"), Subscript(Name("word"), Int(0))))))
+  FuncDef("process_words", Params("text", "word", "result"),
+    If(Compare(Name("text"), CmpOp("==", Str(""))),
+      Return(BinOp("+", Name("result"), Name("word"))),
+      )
+    If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
+      Return(
+        Call(
+          Name("process_words"),
+          Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)),
+          Str(""),
+          BinOp("+", BinOp("+", Name("result"), Name("word")), Str(" ")))),
+      )
+    Return(
+      Call(
+        Name("process_words"),
+        Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)),
+        Call(
+          Name("insert_char"),
+          Subscript(Name("text"), Int(0)),
+          Name("word"),
+          Str("")),
+        Name("result"))))
+  FuncDef("anti_shuffle", Params("s"),
+    Return(Call(Name("process_words"), Name("s"), Str(""), Str("")))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f9ddc51f3dcd23138f73ad61b686f4ba70e340e1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def insert_char(char, word, before):
+    if word == "":
+        return before + char
+    if char <= word[0]:
+        return before + char + word
+    return insert_char(char, word[1:], before + word[0])
+
+
+def process_words(text, word, result):
+    if text == "":
+        return result + word
+    if text[0] == " ":
+        return process_words(text[1:], "", result + word + " ")
+    return process_words(
+        text[1:], insert_char(text[0], word, ""), result
+    )
+
+
+def anti_shuffle(s):
+    return process_words(s, "", "")
