+module MPY-SYNTAX
+  imports STRING-SYNTAX
+  imports INT-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" String ")"
+                  | "Params" "(" String "," String "," String ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Expr "," Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr
+                 | "Slice" "(" Expr "," "NoBound" "," "NoBound" ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports DOMAINS
+
+  syntax StrVals ::= "vals" "(" String ")"
+                   | "vals" "(" String "," String "," String ")"
+
+  syntax Function ::= "fun" "(" Params "," Stmts ")"
+  syntax Function ::= findFun ( String , Stmts ) [function]
+  syntax Map ::= bindParams ( Params , StrVals ) [function, total]
+  syntax Stmts ::= appendStmts ( Stmts , Stmts ) [function]
+
+  syntax String ::= evalString ( Expr , Map , Stmts ) [function]
+                  | callFunc ( String , StrVals , Stmts ) [function]
+                  | applyFun ( Function , StrVals , Stmts ) [function]
+                  | execBody ( Stmts , Map , Stmts )
+  syntax Bool ::= evalBool ( Expr , Map , Stmts ) [function]
+
+  rule findFun(N, FuncDef(N, P, B) REST) => fun(P, B)
+  rule findFun(N, FuncDef(M, _, _) REST) => findFun(N, REST)
+    requires N =/=String M
+
+  rule bindParams(Params(P), vals(V)) => P |-> V
+  rule bindParams(Params(P1, P2, P3), vals(V1, V2, V3)) =>
+    (P1 |-> V1) (P2 |-> V2) (P3 |-> V3)
+
+  rule callFunc(N, VS, FS) => applyFun(findFun(N, FS), VS, FS)
+  rule applyFun(fun(P, B), VS, FS) => execBody(B, bindParams(P, VS), FS)
+
+  rule appendStmts(.Stmts, SECOND) => SECOND
+  rule appendStmts(S:Stmt REST, SECOND) => S appendStmts(REST, SECOND)
+
+  rule execBody(Return(E) REST, ENV, FS) => evalString(E, ENV, FS)
+  rule execBody(If(C, THEN, ELSE) REST, ENV, FS) =>
+    execBody(appendStmts(THEN, REST), ENV, FS)
+    requires evalBool(C, ENV, FS) ==Bool true
+  rule execBody(If(C, THEN, ELSE) REST, ENV, FS) =>
+    execBody(appendStmts(ELSE, REST), ENV, FS)
+    requires evalBool(C, ENV, FS) ==Bool false
+
+  rule evalString(Str(S), _, _) => S
+  rule evalString(Name(N), (N |-> V:String) ENV, _) => V
+  rule evalString(BinOp("+", L, R), ENV, FS) =>
+    evalString(L, ENV, FS) +String evalString(R, ENV, FS)
+  rule evalString(Subscript(E, Int(I)), ENV, FS) =>
+    substrString(evalString(E, ENV, FS), I, I +Int 1)
+  rule evalString(Subscript(E, Slice(Int(I), NoBound, NoBound)), ENV, FS) =>
+    substrString(evalString(E, ENV, FS), I, lengthString(evalString(E, ENV, FS)))
+  rule evalString(Call(Name(N), A), ENV, FS) =>
+    callFunc(N, vals(evalString(A, ENV, FS)), FS)
+  rule evalString(Call(Name(N), A1, A2, A3), ENV, FS) =>
+    callFunc(N,
+      vals(evalString(A1, ENV, FS),
+           evalString(A2, ENV, FS),
+           evalString(A3, ENV, FS)),
+      FS)
+
+  rule evalBool(Compare(L, CmpOp("==", R)), ENV, FS) =>
+    evalString(L, ENV, FS) ==String evalString(R, ENV, FS)
+  rule evalBool(Compare(L, CmpOp("<=", R)), ENV, FS) =>
+    evalString(L, ENV, FS) <=String evalString(R, ENV, FS)
+
+  syntax KItem ::= run ( Pgm , String )
+
+  configuration
+    <python>
+      <k> run($PGM, $INPUT) </k>
+      <result> "" </result>
+    </python>
+
+  rule <k> run(Module(FS), INPUT) => .K </k>
+       <result> _ => callFunc("anti_shuffle", vals(INPUT), FS) </result>
+endmodule
