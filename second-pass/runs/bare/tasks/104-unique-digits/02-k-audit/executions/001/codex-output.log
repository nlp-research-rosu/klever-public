def unique_digits(x):
    """Given a list of positive integers x. return a sorted list of all 
    elements that hasn't any even digit.

    Note: Returned list should be sorted in increasing order.
    
    For example:
    >>> unique_digits([15, 33, 1422, 1])
    [1, 15, 33]
    >>> unique_digits([152, 323, 1422, 10])
    []
    """
#!/usr/bin/env python3
"""py2mpy — a *pure* CPython-AST -> K-constructor transliterator.

Reads a .py file and prints the matching `.mpy` term: a Lisp-indented tree of K
constructors that a (future) K semantics will parse. The design rule is strict:

    PURE TRANSLITERATION. Every Python AST node maps to exactly one K
    constructor with the same structure. The front-end makes NO semantic
    decisions — it does not desugar, simplify, normalize, or "interpret"
    anything. All meaning lives in the K semantics that consumes the term.

Consequences of that rule (vs. a "helpful" front-end):

  * `is` / `is not` transliterate to `CmpOp("is", ...)` / `CmpOp("is not", ...)`
    — NOT to `==` / `!=`. K decides what identity means.
  * a chained comparison `a < b < c` stays a single `Compare` carrying the
    chain (`Compare(a, CmpOp("<", b), CmpOp("<", c))`) — it is NOT pre-expanded
    into `a < b and b < c`.
  * a method call `x.append(v)` stays `Call(Attribute(Name("x"), "append"), v)`
    — there is no special `MethodCall` constructor folding the receiver in.
  * `a[i] = v` stays `Assign(Subscript(Name("a"), Name("i")), v)` — the target
    is just an expression in store position; no special `SubscriptAssign`.

The only choices the transliterator makes are unavoidably *syntactic* — e.g. a
`bool` literal becomes `Bool(...)` not `Int(...)`, because that is the literal's
actual Python type as read off the AST, not a semantic judgement.

+               .Stmts)
+             If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+               Return(Bool(false)),
+               .Stmts)
+             Return(Call(Name("no_even_digit"),
+               BinOp("//", Name("n"), Int(10)))))
+           FuncDef("unique_digits", Params("x"),
+             Return(Call(Name("sorted"),
+               ListComp(Name("n"),
+                 CompFor(Name("n"), Name("x"),
+                   Call(Name("no_even_digit"), Name("n"))))))))
+
+  syntax Bool ::= "isUniqueDigitsProgram" "(" Program ")" [function]
+  rule isUniqueDigitsProgram(
+         Module(
+           FuncDef("no_even_digit", Params("n"),
+             If(Compare(Name("n"), CmpOp("==", Int(0))),
+               Return(Bool(true)),
+               .Stmts)
+             If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+               Return(Bool(false)),
+               .Stmts)
+             Return(Call(Name("no_even_digit"),
+               BinOp("//", Name("n"), Int(10)))))
+           FuncDef("unique_digits", Params("x"),
+             Return(Call(Name("sorted"),
+               ListComp(Name("n"),
+                 CompFor(Name("n"), Name("x"),
+                   Call(Name("no_even_digit"), Name("n")))))))))
+       => true
+
+  // Executable meaning of the source constructs used above.  no_even_digit
+  // scans base-10 digits; the comprehension filters without changing
+  // multiplicity; sorted performs insertion sort.
+  syntax Bool ::= "oddDigits" "(" Int ")" [function, total]
+  rule oddDigits(N) => false requires N <Int 0
+  rule oddDigits(0) => true
+  rule oddDigits(N) => false
+    requires N >Int 0 andBool N %Int 2 ==Int 0
+  rule oddDigits(N) => oddDigits(N /Int 10)
+    requires N >Int 0 andBool N %Int 2 =/=Int 0
+
+  syntax IntSeq ::= "filterOddDigits" "(" IntSeq ")" [function, total]
+  rule filterOddDigits(.Ints) => .Ints
+  rule filterOddDigits(cons(N, NS)) => cons(N, filterOddDigits(NS))
+    requires oddDigits(N)
+  rule filterOddDigits(cons(N, NS)) => filterOddDigits(NS)
+    requires notBool oddDigits(N)
+
+  syntax IntSeq ::= "insertSorted" "(" Int "," IntSeq ")" [function, total]
+  rule insertSorted(N, .Ints) => cons(N, .Ints)
+  rule insertSorted(N, cons(M, MS)) => cons(N, cons(M, MS))
+    requires N <=Int M
+  rule insertSorted(N, cons(M, MS)) => cons(M, insertSorted(N, MS))
+    requires N >Int M
+
+  syntax IntSeq ::= "sortInts" "(" IntSeq ")" [function, total]
+  rule sortInts(.Ints) => .Ints
