     1	def no_even_digit(n):
     2	    if n == 0:
     3	        return True
     4	    if n % 2 == 0:
     5	        return False
     6	    return no_even_digit(n // 10)
     7	
     8	
     9	def unique_digits(x):
    10	    return sorted([n for n in x if no_even_digit(n)])

