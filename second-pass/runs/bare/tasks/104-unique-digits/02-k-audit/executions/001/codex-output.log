+printf '%s\n' 'TRUSTED/CANDIDATE TYPES AND SYMLINK TARGETS'
+find /reference -maxdepth 3 -printf '%y %m %p -> %l\n' | sort
+find /candidate -maxdepth 6 -printf '%y %m %p -> %l\n' | sort
+
+printf '%s\n' 'REQUIRED SOURCE ARTIFACTS'
+required=(
+  prompt.py
+  py2mpy.py
+  solution.py
+  solution.mpy
