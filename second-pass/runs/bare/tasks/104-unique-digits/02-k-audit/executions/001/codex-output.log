index 0000000000000000000000000000000000000000..9ddfc5e104ba4ab20ab8bd31bc3acc6cfeddc2dc
--- /dev/null
+++ b/evidence/mutated_solution.py
@@ -0,0 +1,10 @@
+def no_even_digit(n):
+    if n == 0:
+        return True
+    if n % 2 == 0:
+        return True
+    return no_even_digit(n // 10)
+
+
+def unique_digits(x):
+    return sorted([n for n in x if no_even_digit(n)])
