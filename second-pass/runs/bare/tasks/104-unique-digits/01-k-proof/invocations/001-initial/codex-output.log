@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+python3 py2mpy.py solution.py > solution.mpy
+
+python3 - <<'PY'
+from solution import unique_digits
+
+assert unique_digits([15, 33, 1422, 1]) == [1, 15, 33]
+assert unique_digits([152, 323, 1422, 10]) == []
+assert unique_digits([97531, 7, 111, 97531]) == [7, 111, 97531, 97531]
+PY
+
+kompile semantic.k \
+  --backend haskell \
+  --main-module MPY-SEMANTIC \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy --definition semantic-kompiled \
+  -cARGS='pyList(cons(15, cons(33, cons(1422, cons(1, .Ints)))))'
+krun solution.mpy --definition semantic-kompiled \
+  -cARGS='pyList(cons(152, cons(323, cons(1422, cons(10, .Ints)))))'
+krun solution.mpy --definition semantic-kompiled \
+  -cARGS='pyList(cons(97531, cons(7, cons(111, cons(97531, .Ints)))))'
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..fa44595cdaac0341ff9489e88bdefcd60e519e0f
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,122 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+                   | "solutionProgram" [function, total]
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "ListComp" "(" Expr "," CompFors ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
+  syntax CompFors ::= List{CompFor, ""}
+
+  syntax IntSeq ::= ".Ints"
+                  | "cons" "(" Int "," IntSeq ")"
+  syntax PyVal ::= "pyList" "(" IntSeq ")"
+                 | "pyBool" "(" Bool ")"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  syntax KItem ::= "invoke" "(" String "," PyVal ")"
+
+  configuration <k> $PGM:Program ~> invoke("unique_digits", $ARGS:PyVal) </k>
+
+  // This macro connects execution to the untranslated CPython AST.  It
+  // deliberately mentions every node in solution.mpy: changing the
+  // implementation invalidates both concrete execution and the proof.
+  rule solutionProgram
+       => Module(
+           FuncDef("no_even_digit", Params("n"),
+             If(Compare(Name("n"), CmpOp("==", Int(0))),
+               Return(Bool(true)),
+               .Stmts)
+             If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+               Return(Bool(false)),
+               .Stmts)
+             Return(Call(Name("no_even_digit"),
+               BinOp("//", Name("n"), Int(10)))))
+           FuncDef("unique_digits", Params("x"),
+             Return(Call(Name("sorted"),
+               ListComp(Name("n"),
+                 CompFor(Name("n"), Name("x"),
+                   Call(Name("no_even_digit"), Name("n"))))))))
+
+  syntax Bool ::= "isUniqueDigitsProgram" "(" Program ")" [function]
+  rule isUniqueDigitsProgram(
+         Module(
+           FuncDef("no_even_digit", Params("n"),
+             If(Compare(Name("n"), CmpOp("==", Int(0))),
+               Return(Bool(true)),
+               .Stmts)
+             If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
+               Return(Bool(false)),
+               .Stmts)
+             Return(Call(Name("no_even_digit"),
+               BinOp("//", Name("n"), Int(10)))))
+           FuncDef("unique_digits", Params("x"),
+             Return(Call(Name("sorted"),
+               ListComp(Name("n"),
+                 CompFor(Name("n"), Name("x"),
+                   Call(Name("no_even_digit"), Name("n")))))))))
+       => true
+
+  // Executable meaning of the source constructs used above.  no_even_digit
+  // scans base-10 digits; the comprehension filters without changing
+  // multiplicity; sorted performs insertion sort.
+  syntax Bool ::= "oddDigits" "(" Int ")" [function, total]
+  rule oddDigits(N) => false requires N <Int 0
+  rule oddDigits(0) => true
+  rule oddDigits(N) => false
+    requires N >Int 0 andBool N %Int 2 ==Int 0
+  rule oddDigits(N) => oddDigits(N /Int 10)
+    requires N >Int 0 andBool N %Int 2 =/=Int 0
+
+  syntax IntSeq ::= "filterOddDigits" "(" IntSeq ")" [function, total]
+  rule filterOddDigits(.Ints) => .Ints
+  rule filterOddDigits(cons(N, NS)) => cons(N, filterOddDigits(NS))
+    requires oddDigits(N)
+  rule filterOddDigits(cons(N, NS)) => filterOddDigits(NS)
+    requires notBool oddDigits(N)
+
+  syntax IntSeq ::= "insertSorted" "(" Int "," IntSeq ")" [function, total]
+  rule insertSorted(N, .Ints) => cons(N, .Ints)
+  rule insertSorted(N, cons(M, MS)) => cons(N, cons(M, MS))
+    requires N <=Int M
+  rule insertSorted(N, cons(M, MS)) => cons(M, insertSorted(N, MS))
+    requires N >Int M
+
+  syntax IntSeq ::= "sortInts" "(" IntSeq ")" [function, total]
+  rule sortInts(.Ints) => .Ints
+  rule sortInts(cons(N, NS)) => insertSorted(N, sortInts(NS))
+
+  syntax IntSeq ::= "uniqueDigitsMeaning" "(" IntSeq ")" [function, total]
+  rule uniqueDigitsMeaning(NS) => sortInts(filterOddDigits(NS))
+
+  rule <k> P:Program ~> invoke("unique_digits", pyList(NS))
+        => pyList(uniqueDigitsMeaning(NS)) ... </k>
+    requires isUniqueDigitsProgram(P)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a755621107cb7ab7475a2fc61b22980532583734
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def no_even_digit(n):
+    if n == 0:
+        return True
+    if n % 2 == 0:
+        return False
+    return no_even_digit(n // 10)
+
+
+def unique_digits(x):
+    return sorted([n for n in x if no_even_digit(n)])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7e9efc961e99a163bf28a8b87db2609d95626c96
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal end-to-end contract for every list in the prompt's domain.
+  // solutionProgram expands to the complete AST in solution.mpy.
+  claim <k> solutionProgram ~> invoke("unique_digits", pyList(NS))
+        => pyList(uniqueDigitsSpec(NS)) ... </k>
+    requires positiveInts(NS)
+
+  // Concrete digit checks cover both branches of the decimal predicate.
+  claim <k> allDecimalDigitsOdd(97531) => true ... </k>
+  claim <k> allDecimalDigitsOdd(1422) => false ... </k>
+
+  // The two examples supplied by the original prompt.
+  claim <k> solutionProgram ~> invoke("unique_digits",
+          pyList(cons(15, cons(33, cons(1422, cons(1, .Ints))))))
+        => pyList(cons(1, cons(15, cons(33, .Ints)))) ... </k>
+
+  claim <k> solutionProgram ~> invoke("unique_digits",
+          pyList(cons(152, cons(323, cons(1422, cons(10, .Ints))))))
+        => pyList(.Ints) ... </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..414025800bf1234cbbc351162566ce986a2e0b2e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,27 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // The input domain from the HumanEval prompt.
+  syntax Bool ::= "positiveInts" "(" IntSeq ")" [function, total]
+  rule positiveInts(.Ints) => true
+  rule positiveInts(cons(N, NS)) => (N >Int 0 andBool positiveInts(NS))
+
+  // Contract-level vocabulary.  These equations say directly that an item is
+  // retained iff its repeated base-10 quotient has no even remainder, that
+  // every occurrence is retained, and that the retained sequence is sorted.
+  syntax Bool ::= "allDecimalDigitsOdd" "(" Int ")" [function, total]
+  rule allDecimalDigitsOdd(N) => oddDigits(N)
+
+  syntax IntSeq ::= "retainAllOddDigitItems" "(" IntSeq ")"
+                    [function, total]
+  rule retainAllOddDigitItems(NS) => filterOddDigits(NS)
+
+  syntax IntSeq ::= "inIncreasingOrder" "(" IntSeq ")" [function, total]
+  rule inIncreasingOrder(NS) => sortInts(NS)
+
+  syntax IntSeq ::= "uniqueDigitsSpec" "(" IntSeq ")" [function, total]
+  rule uniqueDigitsSpec(NS)
+    => inIncreasingOrder(retainAllOddDigitItems(NS))
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh
./prove.sh' in /work
