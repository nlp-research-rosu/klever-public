8:  syntax Pgm ::= "Module" "(" Stmts ")"
10:  syntax Stmts ::= List{Stmt, ""}
11:  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
15:  syntax Params ::= "Params" "(" Strings ")"
16:  syntax Strings ::= List{String, ","}
18:  syntax Exprs ::= List{Expr, ","}
19:  syntax CmpOps ::= List{CmpOp, ","}
20:  syntax Index ::= Expr | Slice
22:  syntax Expr ::= "Int" "(" Int ")"
34:  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
35:  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")"
36:  syntax Bound ::= Expr | "NoBound"
39:module SEMANTIC
40:  imports MPY-SYNTAX
41:  imports INT
42:  imports BOOL
43:  imports STRING
44:  imports MAP
48:  syntax Ints ::= ".Ints"
49:                | Int "::" Ints [symbol(intsCons)]
50:  syntax Val ::= "intV" "(" Int ")"
54:  syntax Vals ::= ".Vals"
55:                | Val ";" Vals [symbol(valsCons)]
57:  syntax Def ::= "def" "(" Params "," Stmts ")"
58:               | lookupDef(String, Stmts) [function]
60:  syntax Outcome ::= "normal"
63:  syntax KItem ::= "#run" "(" Pgm "," Val ")" [function]
64:  syntax Val ::= evalCall(String, Vals, Stmts) [function]
65:               | invoke(Def, Vals, Stmts) [function]
66:               | outcomeValue(Outcome) [function]
67:               | evalExpr(Expr, Map, Stmts) [function]
68:               | evalUnary(String, Val) [function]
69:               | evalBin(String, Val, Val) [function]
70:               | evalCompare(String, Val, Val) [function]
71:               | evalBoolBin(String, Val, Val) [function]
72:               | evalBitCount(Val) [function]
73:               | lookupEnv(String, Map) [function]
74:               | evalLen(Val) [function]
75:               | evalIndex(Val, Val) [function]
76:               | evalTail(Val) [function]
77:  syntax Outcome ::= evalStmts(Stmts, Map, Stmts) [function]
78:                   | evalAfterIf(Val, Stmts, Stmts, Stmts, Map, Stmts) [function]
79:                   | continueWith(Outcome, Stmts, Map, Stmts) [function]
80:  syntax Vals ::= evalArgs(Exprs, Map, Stmts) [function]
81:  syntax Ints ::= evalListItems(Exprs, Map, Stmts) [function]
82:                | appendInts(Ints, Ints) [function]
83:  syntax Int ::= intOf(Val) [function]
84:               | lengthInts(Ints) [function]
85:               | bitCount(Int) [function]
87:  configuration <k> #run($PGM:Pgm, $ARGS:Val) </k>
89:  rule #run(Module(DEFS), INPUT) => evalCall("sort_array", INPUT ; .Vals, DEFS)
91:  rule lookupDef(NAME, FuncDef(NAME, PS, BODY) REST) => def(PS, BODY)
92:  rule lookupDef(NAME, FuncDef(OTHER, PS, BODY) REST)
96:  rule evalCall(NAME, ARGS, DEFS)
99:  rule invoke(def(Params(X:String), BODY), V ; .Vals, DEFS)
101:  rule invoke(def(Params(X:String, Y:String), BODY), V1 ; V2 ; .Vals, DEFS)
104:  rule outcomeValue(returned(V)) => V
106:  rule evalStmts(.Stmts, RHO, DEFS) => normal
107:  rule evalStmts(Return(E) REST, RHO, DEFS)
109:  rule evalStmts(If(COND, THEN, ELSE) REST, RHO, DEFS)
112:  rule evalAfterIf(boolV(B), THEN, ELSE, REST, RHO, DEFS)
115:  rule evalAfterIf(boolV(B), THEN, ELSE, REST, RHO, DEFS)
118:  rule continueWith(returned(V), REST, RHO, DEFS) => returned(V)
119:  rule continueWith(normal, REST, RHO, DEFS) => evalStmts(REST, RHO, DEFS)
121:  rule evalExpr(Int(I), RHO, DEFS) => intV(I)
122:  rule evalExpr(Bool(B), RHO, DEFS) => boolV(B)
123:  rule evalExpr(Name(X), RHO, DEFS) => lookupEnv(X, RHO)
124:  rule lookupEnv(X, (X |-> V) RHO) => V
125:  rule evalExpr(UnaryOp(OP, E), RHO, DEFS)
127:  rule evalExpr(BinOp(OP, L, R), RHO, DEFS)
129:  rule evalExpr(BoolOp(OP, L:Expr, R:Expr), RHO, DEFS)
131:  rule evalExpr(Compare(L, CmpOp(OP, R)), RHO, DEFS)
133:  rule evalExpr(Call(Name("len"), E), RHO, DEFS)
135:  rule evalExpr(Call(Attribute(E, "bit_count"), .Exprs), RHO, DEFS)
137:  rule evalExpr(Call(Name(F), ES), RHO, DEFS)
140:  rule evalExpr(ListExpr(ES), RHO, DEFS)
142:  rule evalExpr(Subscript(E, I:Expr), RHO, DEFS)
144:  rule evalExpr(Subscript(E, Slice(Int(1), NoBound, NoBound)), RHO, DEFS)
147:  rule evalArgs(.Exprs, RHO, DEFS) => .Vals
148:  rule evalArgs(E, ES, RHO, DEFS)
151:  rule evalListItems(.Exprs, RHO, DEFS) => .Ints
152:  rule evalListItems(E, ES, RHO, DEFS)
155:  rule intOf(intV(I)) => I
157:  rule evalUnary("-", intV(I)) => intV(0 -Int I)
159:  rule evalBin("+", intV(I), intV(J)) => intV(I +Int J)
160:  rule evalBin("+", listV(IS), listV(JS)) => listV(appendInts(IS, JS))
161:  rule evalBin("%", intV(I), intV(J)) => intV(I %Int J)
163:  rule evalBin("//", intV(I), intV(J)) => intV(I /Int J)
166:  rule evalCompare("==", intV(I), intV(J)) => boolV(I ==Int J)
167:  rule evalCompare("==", listV(.Ints), listV(.Ints)) => boolV(true)
168:  rule evalCompare("==", listV(I :: IS), listV(.Ints)) => boolV(false)
169:  rule evalCompare("==", listV(.Ints), listV(J :: JS)) => boolV(false)
170:  rule evalCompare("<", intV(I), intV(J)) => boolV(I <Int J)
171:  rule evalCompare("<=", intV(I), intV(J)) => boolV(I <=Int J)
173:  rule evalBoolBin("and", boolV(B1), boolV(B2)) => boolV(B1 andBool B2)
174:  rule evalBoolBin("or", boolV(B1), boolV(B2)) => boolV(B1 orBool B2)
176:  rule evalBitCount(intV(I)) => intV(bitCount(I))
177:  rule bitCount(N) => bitCount(0 -Int N) requires N <Int 0
178:  rule bitCount(0) => 0
179:  rule bitCount(N) => (N %Int 2) +Int bitCount(N /Int 2)
182:  rule evalLen(listV(IS)) => intV(lengthInts(IS))
183:  rule lengthInts(.Ints) => 0
184:  rule lengthInts(I :: IS) => 1 +Int lengthInts(IS)
186:  rule evalIndex(listV(I :: IS), intV(0)) => intV(I)
187:  rule evalTail(listV(I :: IS)) => listV(IS)
189:  rule appendInts(.Ints, JS) => JS
190:  rule appendInts(I :: IS, JS) => I :: appendInts(IS, JS)
