COMMAND: /audit-output/evidence/concrete_compare.py
CASE empty
COMMAND: krun solution.mpy '-cARGS=listV(.Ints)' --definition semantic-concrete-kompiled
EXIT_STATUS: 0
STDOUT:
<k>
  listV ( .Ints ) ~> .K
</k>
PYTHON_EXPECTED: []
K_ACTUAL: []
MATCH: True
CASE singleton-zero
COMMAND: krun solution.mpy '-cARGS=listV(0 :: .Ints)' --definition semantic-concrete-kompiled
EXIT_STATUS: 0
STDOUT:
<k>
  listV ( 0 :: .Ints ) ~> .K
</k>
PYTHON_EXPECTED: [0]
K_ACTUAL: [0]
MATCH: True
CASE pair-tie-break
COMMAND: krun solution.mpy '-cARGS=listV(5 :: 3 :: .Ints)' --definition semantic-concrete-kompiled
EXIT_STATUS: 0
STDOUT:
<k>
  listV ( 3 :: 5 :: .Ints ) ~> .K
</k>
PYTHON_EXPECTED: [3, 5]
K_ACTUAL: [3, 5]
MATCH: True
CASE normal
COMMAND: krun solution.mpy '-cARGS=listV(1 :: 5 :: 2 :: 3 :: 4 :: .Ints)' --definition semantic-concrete-kompiled
EXIT_STATUS: 0
STDOUT:
<k>
  listV ( 1 :: 2 :: 4 :: 3 :: 5 :: .Ints ) ~> .K
</k>
PYTHON_EXPECTED: [1, 2, 4, 3, 5]
K_ACTUAL: [1, 2, 4, 3, 5]
MATCH: True
CASE duplicates
COMMAND: krun solution.mpy '-cARGS=listV(3 :: 1 :: 3 :: 0 :: 1 :: .Ints)' --definition semantic-concrete-kompiled
