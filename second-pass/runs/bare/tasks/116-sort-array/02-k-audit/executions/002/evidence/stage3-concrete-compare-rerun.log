</k>
PYTHON_EXPECTED: [0, 8, 3, 7]
K_ACTUAL: [0, 8, 3, 7]
MATCH: True
CASE long-boundary
COMMAND: krun solution.mpy '-cARGS=listV(9223372036854775808 :: 9223372036854775807 :: 0 :: 3 :: 1 :: 2 :: 4 :: .Ints)' --definition semantic-concrete-kompiled
EXIT_STATUS: 0
STDOUT:
<k>
