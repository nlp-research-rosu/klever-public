is_real_regular_file() {
  [[ -f "$1" && ! -L "$1" ]]
}

is_real_directory() {
  [[ -d "$1" && ! -L "$1" ]]
}

terminate_model_group() {
  local pgid="$1"
  if [[ "$pgid" =~ ^[0-9]+$ ]] && kill -0 -- "-$pgid" 2>/dev/null; then
    kill -TERM -- "-$pgid" 2>/dev/null || true
    kill -KILL -- "-$pgid" 2>/dev/null || true
