===== /candidate/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Recreate the translated constructor term and reject syntax drift.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	python3 -m py_compile solution.py
     9	
    10	# verification.k imports semantic.k; this produces one definition used by
    11	# concrete execution, KORE-level source linkage, and proof.
    12	kompile verification.k \
    13	  --main-module VERIFICATION \
    14	  --syntax-module MPY-SYNTAX \
    15	  --backend haskell \
    16	  --warnings none
    17	
    18	# Prove that solutionProgram (the compact term used in spec.k) expands to the
    19	# exact same KORE tree as the current py2mpy.py output.
    20	actual_kore="$(mktemp)"
    21	named_kore="$(mktemp)"
    22	cleanup() {
    23	  rm -f -- "$actual_kore" "$named_kore"
    24	}
    25	trap cleanup EXIT
    26	
    27	kast solution.mpy \
    28	  --definition verification-kompiled \
    29	  --module VERIFICATION \
    30	  --sort Pgm \
    31	  --output kore \
    32	  --expand-macros > "$actual_kore"
    33	kast --expression solutionProgram \
    34	  --definition verification-kompiled \
    35	  --module VERIFICATION \
    36	  --sort Pgm \
    37	  --output kore \
    38	  --expand-macros > "$named_kore"
    39	cmp "$actual_kore" "$named_kore"
    40	
    41	# Concrete executions through the semantics (including cases that distinguish
    42	# the prose contract from ordinary numeric sorting).
    43	krun solution.mpy \
    44	  -cARGS='listV(1 :: 5 :: 2 :: 3 :: 4 :: .Ints)' \
    45	  --definition verification-kompiled
    46	krun solution.mpy \
    47	  -cARGS='listV(1 :: 0 :: 2 :: 3 :: 4 :: .Ints)' \
    48	  --definition verification-kompiled
    49	krun solution.mpy \
    50	  -cARGS='listV(3 :: 1 :: 3 :: 0 :: 1 :: .Ints)' \
    51	  --definition verification-kompiled
    52	krun solution.mpy \
    53	  -cARGS='listV(-2 :: -3 :: -4 :: -5 :: -6 :: .Ints)' \
    54	  --definition verification-kompiled
    55	
    56	# This is the sole positive target-proof command.  It proves every claim in
    57	# SPEC and must print #Top and exit zero.
    58	kprove spec.k \
    59	  --definition verification-kompiled \
    60	  --spec-module SPEC \
    61	  --warnings none
===== /candidate/NOTES.md
     1	# Verification notes
     2	
     3	The prose contract says to order by `(number of 1 bits, decimal value)`, but
     4	the three examples display ordinary numeric sorting.  Those conflict: for
     5	example, the prose requires `[1, 5, 2, 3, 4]` to become
     6	`[1, 2, 4, 3, 5]`.  The implementation and formal reference model follow the
     7	prose because it defines the requested algorithm.  `spec.k` includes cases
     8	that deliberately distinguish the two interpretations.
     9	
    10	For negative integers (outside the stated non-negative domain), `int.bit_count`
    11	counts bits in the magnitude.  Thus the documented negative example evaluates
    12	to `[-4, -2, -6, -5, -3]` under the bit-count contract, not ordinary numeric
    13	order.
    14	
    15	The proof links the exact translated AST to an independent K reference model.
    16	It proves popcount and comparator agreement for arbitrary integers, proves all
    17	execution paths for symbolic arrays through length three, proves longer
    18	representative end-to-end cases (including duplicates and negatives), and
    19	checks ordering plus multiplicity preservation for the distinguishing example.
    20	The six length-three claims partition every possible comparator path.  The
    21	KORE equality check in `prove.sh` prevents the named AST used by the claims
    22	from drifting away from freshly generated `solution.mpy`.

