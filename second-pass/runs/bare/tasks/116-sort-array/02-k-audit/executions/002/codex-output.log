     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // A named copy of the exact constructor tree emitted in solution.mpy.  The
     7	  // macro gives specifications a compact way to run the translated program;
     8	  // it adds no execution rule and therefore cannot bypass the interpreter.
     9	  syntax Pgm ::= "solutionProgram" [macro]
    10	  syntax Stmts ::= "solutionDefs" [macro]
    11	  rule solutionProgram => Module(solutionDefs)
    12	  rule solutionDefs =>
    13	      FuncDef("count_ones", Params("n"),
    14	        Return(Call(Attribute(Name("n"), "bit_count"), .Exprs)))
    15	      FuncDef("comes_before", Params("a", "b"),
    16	        Return(
    17	          BoolOp(
    18	            "or",
    19	            Compare(
    20	              Call(Name("count_ones"), Name("a")),
    21	              CmpOp("<", Call(Name("count_ones"), Name("b")))),
    22	            BoolOp(
    23	              "and",
    24	              Compare(
    25	                Call(Name("count_ones"), Name("a")),
    26	                CmpOp("==", Call(Name("count_ones"), Name("b")))),
    27	              Compare(Name("a"), CmpOp("<=", Name("b")))))))
    28	      FuncDef("insert_sorted", Params("x", "values"),
    29	        If(Compare(Name("values"), CmpOp("==", ListExpr(.Exprs))),
    30	          Return(ListExpr(Name("x"))),
    31	          .Stmts)
    32	        If(Call(
    33	          Name("comes_before"),
    34	          Name("x"),
    35	          Subscript(Name("values"), Int(0))),
    36	          Return(BinOp("+", ListExpr(Name("x")), Name("values"))),
    37	          .Stmts)
    38	        Return(
    39	          BinOp(
    40	            "+",
    41	            ListExpr(Subscript(Name("values"), Int(0))),
    42	            Call(
    43	              Name("insert_sorted"),
    44	              Name("x"),
    45	              Subscript(Name("values"), Slice(Int(1), NoBound, NoBound))))))
    46	      FuncDef("sort_array", Params("arr"),
    47	        If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
    48	          Return(ListExpr(.Exprs)),
    49	          .Stmts)
    50	        Return(
    51	          Call(
    52	            Name("insert_sorted"),
    53	            Subscript(Name("arr"), Int(0)),
    54	            Call(
    55	              Name("sort_array"),
    56	              Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound))))))
    57	
    58	  // Independent mathematical reference model for the prose contract.
    59	  syntax Int ::= popcount(Int) [function]
    60	  syntax Bool ::= beforeEq(Int, Int) [function]
    61	                | ordered(Ints) [function]
    62	                | allNonnegative(Ints) [function]
    63	                | sameMultiplicity(Ints, Ints, Ints) [function]
    64	  syntax Ints ::= insertModel(Int, Ints) [function]
    65	                | sortModel(Ints) [function]
    66	  syntax Int ::= occurrences(Int, Ints) [function]
    67	
    68	  rule popcount(N) => bitCount(N)
    69	
    70	  rule beforeEq(I, J)
    71	    => (popcount(I) <Int popcount(J))
    72	       orBool ((popcount(I) ==Int popcount(J)) andBool (I <=Int J))
    73	
    74	  rule insertModel(I, .Ints) => I :: .Ints
    75	  rule insertModel(I, J :: JS) => I :: J :: JS
    76	    requires beforeEq(I, J)
    77	  rule insertModel(I, J :: JS) => J :: insertModel(I, JS)
    78	    requires notBool beforeEq(I, J)
    79	
    80	  rule sortModel(.Ints) => .Ints
    81	  rule sortModel(I :: IS) => insertModel(I, sortModel(IS))
    82	
    83	  rule ordered(.Ints) => true
    84	  rule ordered(I :: .Ints) => true
    85	  rule ordered(I :: J :: IS) => beforeEq(I, J) andBool ordered(J :: IS)
    86	
    87	  rule allNonnegative(.Ints) => true
    88	  rule allNonnegative(I :: IS) => (I >=Int 0) andBool allNonnegative(IS)
    89	
    90	  rule occurrences(I, .Ints) => 0
    91	  rule occurrences(I, I :: JS) => 1 +Int occurrences(I, JS)
    92	  rule occurrences(I, J :: JS) => occurrences(I, JS)
    93	    requires I =/=Int J
    94	
    95	  // The first argument is the finite set of values whose multiplicities are
    96	  // compared.  Passing the original input is sufficient to establish that a
    97	  // concrete output neither loses nor duplicates any input element.
    98	  rule sameMultiplicity(.Ints, INPUT, OUTPUT) => true
    99	  rule sameMultiplicity(I :: IS, INPUT, OUTPUT)
   100	    => (occurrences(I, INPUT) ==Int occurrences(I, OUTPUT))
   101	       andBool sameMultiplicity(IS, INPUT, OUTPUT)
   102	endmodule
