+    "candidate_translator_matches_trusted_bytes="
+    f"{Path('/candidate/py2mpy.py').read_bytes() == Path('/reference/py2mpy.py').read_bytes()}"
+)
+reference_semantics = Path("/reference/reference-semantics")
