    44	      => listV(sortModel(A :: B :: .Ints)) </k>
    45	    requires beforeEq(A, B)
    46	
    47	  claim [sort-pair-after]:
    48	    <k> #run(solutionProgram, listV(A :: B :: .Ints))
    49	      => listV(sortModel(A :: B :: .Ints)) </k>
    50	    requires notBool beforeEq(A, B)
    51	
    52	  // For length three, the six claims are the six insertion-sort paths.  Their
