     6	  // Interpreter-to-model lemmas for the key functions.  They are parametric
     7	  // in arbitrary mathematical integers, not bounded test values.
     8	  claim [count-correct]:
     9	    <k> evalCall("count_ones", intV(N) ; .Vals, solutionDefs)
    10	      => intV(popcount(N)) </k>
    11	
    12	  claim [comparator-correct]:
    13	    <k> evalCall("comes_before", intV(A) ; intV(B) ; .Vals, solutionDefs)
    14	      => boolV(beforeEq(A, B)) </k>
    15	    requires A >=Int 0 andBool B >=Int 0
    16	
    17	  claim [insert-empty]:
    18	    <k> evalCall(
    19	          "insert_sorted",
    20	          intV(X) ; listV(.Ints) ; .Vals,
    21	          solutionDefs)
    22	      => listV(insertModel(X, .Ints)) </k>
    23	
    24	  claim [insert-at-front]:
    25	    <k> evalCall(
    26	          "insert_sorted",
    27	          intV(X) ; listV(Y :: YS) ; .Vals,
    28	          solutionDefs)
    29	      => listV(insertModel(X, Y :: YS)) </k>
    30	    requires beforeEq(X, Y)
    31	
    32	  // Exhaustive symbolic proof for every list of length at most two.  The pair
    33	  // claims cover both possible comparator outcomes for arbitrary A and B.
    34	  claim [sort-empty-symbolic]:
    35	    <k> #run(solutionProgram, listV(.Ints))
    36	      => listV(sortModel(.Ints)) </k>
    37	
    38	  claim [sort-singleton-symbolic]:
    39	    <k> #run(solutionProgram, listV(A :: .Ints))
    40	      => listV(sortModel(A :: .Ints)) </k>
    41	
    42	  claim [sort-pair-before]:
