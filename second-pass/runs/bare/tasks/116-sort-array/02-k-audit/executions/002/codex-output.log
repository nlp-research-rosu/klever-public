new file mode 100644
index 0000000000000000000000000000000000000000..a00ab6ecd45792e08d60dab37e0d074061c2edb5
--- /dev/null
+++ b/evidence/record_cmd.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: record_cmd.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$command_status"
+} >"$log_path" 2>&1
+
+exit "$command_status"
