+log_dir=$4
+runner=/audit-output/evidence/run_logged.sh
+
+claims=(
+  count-correct
+  comparator-correct
+  insert-empty
+  insert-at-front
+  sort-empty-symbolic
+  sort-singleton-symbolic
+  sort-pair-before
+  sort-pair-after
+  sort-triple-abc
+  sort-triple-bac
+  sort-triple-bca
+  sort-triple-acb
+  sort-triple-cab
+  sort-triple-cba
