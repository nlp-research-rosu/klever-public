+def count_ones(n):
+    if n < 0:
+        return count_ones(-n)
+    if n == 0:
+        return 0
+    return n % 2 + count_ones(n // 2)
+
+
+def comes_before(a, b):
+    if count_ones(a) < count_ones(b):
+        return True
+    if count_ones(a) == count_ones(b):
+        return a <= b
+    return False
