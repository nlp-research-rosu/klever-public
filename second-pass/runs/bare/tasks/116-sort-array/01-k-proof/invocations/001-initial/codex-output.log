      Enable specific warning categories. Values: [non-exhaustive-match|undeleted-temp-dir|missing-hook-java|missing-syntax-module|invalid-exit-code|deprecated-backend|invalid-config-var|future-error|unused-var|proof-lint|useless-rule|unresolved-function-symbol|malformed-markdown|invalidated-cache|unused-symbol|removed-anywhere]
      Default: []
    -Wno <warning>
      Disable specific warning categories.
      Default: []


exec
/bin/bash -lc 'actual_term=$(mktemp) && named_term=$(mktemp) && kast solution.mpy --definition verification-kompiled --module VERIFICATION --sort Pgm --output kore --expand-macros > "$actual_term" && kast --expression solutionProgram --definition verification-kompiled --module VERIFICATION --sort Pgm --output kore --expand-macros > "$named_term" && cmp "$actual_term" "$named_term" && wc -c "$actual_term" "$named_term" && rm "$actual_term" "$named_term"' in /work
