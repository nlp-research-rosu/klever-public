        Call(Name("count_ones"), BinOp("//", Name("n"), Int(2))))))
  FuncDef("comes_before", Params("a", "b"),
    If(Compare(
      Call(Name("count_ones"), Name("a")),
      CmpOp("<", Call(Name("count_ones"), Name("b")))),
      Return(Bool(true)),
      )
    If(Compare(
      Call(Name("count_ones"), Name("a")),
      CmpOp("==", Call(Name("count_ones"), Name("b")))),
      Return(Compare(Name("a"), CmpOp("<=", Name("b")))),
      )
    Return(Bool(false)))
  FuncDef("insert_sorted", Params("x", "values"),
    If(Compare(Call(Name("len"), Name("values")), CmpOp("==", Int(0))),
      Return(ListExpr(Name("x"))),
      )
    If(Call(
      Name("comes_before"),
      Name("x"),
      Subscript(Name("values"), Int(0))),
      Return(BinOp("+", ListExpr(Name("x")), Name("values"))),
      )
    Return(
      BinOp(
        "+",
        ListExpr(Subscript(Name("values"), Int(0))),
        Call(
          Name("insert_sorted"),
          Name("x"),
          Subscript(Name("values"), Slice(Int(1), NoBound, NoBound))))))
  FuncDef("sort_array", Params("arr"),
    If(Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
      Return(ListExpr()),
      )
    Return(
      Call(
        Name("insert_sorted"),
        Subscript(Name("arr"), Int(0)),
        Call(
          Name("sort_array"),
          Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound)))))))

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..62a8709f08fbcd4d0383566ad3213764170244a7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,26 @@
+def count_ones(n):
+    if n == 0:
+        return 0
+    return n % 2 + count_ones(n // 2)
+
+
+def comes_before(a, b):
+    if count_ones(a) < count_ones(b):
+        return True
+    if count_ones(a) == count_ones(b):
+        return a <= b
+    return False
+
+
+def insert_sorted(x, values):
+    if len(values) == 0:
+        return [x]
+    if comes_before(x, values[0]):
+        return [x] + values
+    return [values[0]] + insert_sorted(x, values[1:])
+
+
+def sort_array(arr):
+    if len(arr) == 0:
+        return []
+    return insert_sorted(arr[0], sort_array(arr[1:]))

apply patch
