--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Recreate the translated constructor term and reject syntax drift.
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+# verification.k imports semantic.k; this produces one definition used by
+# concrete execution, KORE-level source linkage, and proof.
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  --warnings none
+
+# Prove that solutionProgram (the compact term used in spec.k) expands to the
+# exact same KORE tree as the current py2mpy.py output.
+actual_kore="$(mktemp)"
+named_kore="$(mktemp)"
+cleanup() {
+  rm -f -- "$actual_kore" "$named_kore"
+}
+trap cleanup EXIT
+
+kast solution.mpy \
+  --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Pgm \
+  --output kore \
+  --expand-macros > "$actual_kore"
+kast --expression solutionProgram \
+  --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Pgm \
+  --output kore \
+  --expand-macros > "$named_kore"
+cmp "$actual_kore" "$named_kore"
+
+# Concrete executions through the semantics (including cases that distinguish
+# the prose contract from ordinary numeric sorting).
+krun solution.mpy \
+  -cARGS='listV(1 :: 5 :: 2 :: 3 :: 4 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(1 :: 0 :: 2 :: 3 :: 4 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(3 :: 1 :: 3 :: 0 :: 1 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(-2 :: -3 :: -4 :: -5 :: -6 :: .Ints)' \
+  --definition verification-kompiled
+
+# This is the sole positive target-proof command.  It proves every claim in
+# SPEC and must print #Top and exit zero.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --warnings none
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6261aede8e086437d5bc85ef828a10423970fc34
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,191 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Index ::= Expr | Slice
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  // Runtime values.  The explicit Ints datatype makes list induction and
+  // symbolic execution independent of K's builtin, heterogenous List sort.
+  syntax Ints ::= ".Ints"
+                | Int "::" Ints [symbol(intsCons)]
+  syntax Val ::= "intV" "(" Int ")"
+               | "boolV" "(" Bool ")"
+               | "listV" "(" Ints ")"
+
+  syntax Vals ::= ".Vals"
+                | Val ";" Vals [symbol(valsCons)]
+
+  syntax Def ::= "def" "(" Params "," Stmts ")"
+               | lookupDef(String, Stmts) [function]
+
+  syntax Outcome ::= "normal"
+                   | "returned" "(" Val ")"
+
+  syntax KItem ::= "#run" "(" Pgm "," Val ")" [function]
+  syntax Val ::= evalCall(String, Vals, Stmts) [function]
+               | invoke(Def, Vals, Stmts) [function]
+               | outcomeValue(Outcome) [function]
+               | evalExpr(Expr, Map, Stmts) [function]
+               | evalUnary(String, Val) [function]
+               | evalBin(String, Val, Val) [function]
+               | evalCompare(String, Val, Val) [function]
+               | evalBoolBin(String, Val, Val) [function]
+               | evalBitCount(Val) [function]
+               | lookupEnv(String, Map) [function]
+               | evalLen(Val) [function]
+               | evalIndex(Val, Val) [function]
+               | evalTail(Val) [function]
+  syntax Outcome ::= evalStmts(Stmts, Map, Stmts) [function]
+                   | evalAfterIf(Val, Stmts, Stmts, Stmts, Map, Stmts) [function]
+                   | continueWith(Outcome, Stmts, Map, Stmts) [function]
+  syntax Vals ::= evalArgs(Exprs, Map, Stmts) [function]
+  syntax Ints ::= evalListItems(Exprs, Map, Stmts) [function]
+                | appendInts(Ints, Ints) [function]
+  syntax Int ::= intOf(Val) [function]
+               | lengthInts(Ints) [function]
+               | bitCount(Int) [function]
+
+  configuration <k> #run($PGM:Pgm, $ARGS:Val) </k>
+
+  rule #run(Module(DEFS), INPUT) => evalCall("sort_array", INPUT ; .Vals, DEFS)
+
+  rule lookupDef(NAME, FuncDef(NAME, PS, BODY) REST) => def(PS, BODY)
+  rule lookupDef(NAME, FuncDef(OTHER, PS, BODY) REST)
+    => lookupDef(NAME, REST)
+    requires NAME =/=String OTHER
+
+  rule evalCall(NAME, ARGS, DEFS)
+    => invoke(lookupDef(NAME, DEFS), ARGS, DEFS)
+
+  rule invoke(def(Params(X:String), BODY), V ; .Vals, DEFS)
+    => outcomeValue(evalStmts(BODY, X |-> V, DEFS))
+  rule invoke(def(Params(X:String, Y:String), BODY), V1 ; V2 ; .Vals, DEFS)
+    => outcomeValue(evalStmts(BODY, (X |-> V1) (Y |-> V2), DEFS))
+
+  rule outcomeValue(returned(V)) => V
+
+  rule evalStmts(.Stmts, RHO, DEFS) => normal
+  rule evalStmts(Return(E) REST, RHO, DEFS)
+    => returned(evalExpr(E, RHO, DEFS))
+  rule evalStmts(If(COND, THEN, ELSE) REST, RHO, DEFS)
+    => evalAfterIf(evalExpr(COND, RHO, DEFS), THEN, ELSE, REST, RHO, DEFS)
+
+  rule evalAfterIf(boolV(B), THEN, ELSE, REST, RHO, DEFS)
+    => continueWith(evalStmts(THEN, RHO, DEFS), REST, RHO, DEFS)
+    requires B
+  rule evalAfterIf(boolV(B), THEN, ELSE, REST, RHO, DEFS)
+    => continueWith(evalStmts(ELSE, RHO, DEFS), REST, RHO, DEFS)
+    requires notBool B
+  rule continueWith(returned(V), REST, RHO, DEFS) => returned(V)
+  rule continueWith(normal, REST, RHO, DEFS) => evalStmts(REST, RHO, DEFS)
+
+  rule evalExpr(Int(I), RHO, DEFS) => intV(I)
+  rule evalExpr(Bool(B), RHO, DEFS) => boolV(B)
+  rule evalExpr(Name(X), RHO, DEFS) => lookupEnv(X, RHO)
+  rule lookupEnv(X, (X |-> V) RHO) => V
+  rule evalExpr(UnaryOp(OP, E), RHO, DEFS)
+    => evalUnary(OP, evalExpr(E, RHO, DEFS))
+  rule evalExpr(BinOp(OP, L, R), RHO, DEFS)
+    => evalBin(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(BoolOp(OP, L:Expr, R:Expr), RHO, DEFS)
+    => evalBoolBin(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(Compare(L, CmpOp(OP, R)), RHO, DEFS)
+    => evalCompare(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(Call(Name("len"), E), RHO, DEFS)
+    => evalLen(evalExpr(E, RHO, DEFS))
+  rule evalExpr(Call(Attribute(E, "bit_count"), .Exprs), RHO, DEFS)
+    => evalBitCount(evalExpr(E, RHO, DEFS))
+  rule evalExpr(Call(Name(F), ES), RHO, DEFS)
+    => evalCall(F, evalArgs(ES, RHO, DEFS), DEFS)
+    requires F =/=String "len"
+  rule evalExpr(ListExpr(ES), RHO, DEFS)
+    => listV(evalListItems(ES, RHO, DEFS))
+  rule evalExpr(Subscript(E, I:Expr), RHO, DEFS)
+    => evalIndex(evalExpr(E, RHO, DEFS), evalExpr(I, RHO, DEFS))
+  rule evalExpr(Subscript(E, Slice(Int(1), NoBound, NoBound)), RHO, DEFS)
+    => evalTail(evalExpr(E, RHO, DEFS))
+
+  rule evalArgs(.Exprs, RHO, DEFS) => .Vals
+  rule evalArgs(E, ES, RHO, DEFS)
+    => evalExpr(E, RHO, DEFS) ; evalArgs(ES, RHO, DEFS)
+
+  rule evalListItems(.Exprs, RHO, DEFS) => .Ints
+  rule evalListItems(E, ES, RHO, DEFS)
+    => intOf(evalExpr(E, RHO, DEFS)) :: evalListItems(ES, RHO, DEFS)
+
+  rule intOf(intV(I)) => I
+
+  rule evalUnary("-", intV(I)) => intV(0 -Int I)
+
+  rule evalBin("+", intV(I), intV(J)) => intV(I +Int J)
+  rule evalBin("+", listV(IS), listV(JS)) => listV(appendInts(IS, JS))
+  rule evalBin("%", intV(I), intV(J)) => intV(I %Int J)
+    requires J =/=Int 0
+  rule evalBin("//", intV(I), intV(J)) => intV(I /Int J)
+    requires J =/=Int 0
+
+  rule evalCompare("==", intV(I), intV(J)) => boolV(I ==Int J)
+  rule evalCompare("==", listV(.Ints), listV(.Ints)) => boolV(true)
+  rule evalCompare("==", listV(I :: IS), listV(.Ints)) => boolV(false)
+  rule evalCompare("==", listV(.Ints), listV(J :: JS)) => boolV(false)
+  rule evalCompare("<", intV(I), intV(J)) => boolV(I <Int J)
+  rule evalCompare("<=", intV(I), intV(J)) => boolV(I <=Int J)
+
+  rule evalBoolBin("and", boolV(B1), boolV(B2)) => boolV(B1 andBool B2)
+  rule evalBoolBin("or", boolV(B1), boolV(B2)) => boolV(B1 orBool B2)
+
+  rule evalBitCount(intV(I)) => intV(bitCount(I))
+  rule bitCount(N) => bitCount(0 -Int N) requires N <Int 0
+  rule bitCount(0) => 0
+  rule bitCount(N) => (N %Int 2) +Int bitCount(N /Int 2)
+    requires N >Int 0
+
+  rule evalLen(listV(IS)) => intV(lengthInts(IS))
+  rule lengthInts(.Ints) => 0
+  rule lengthInts(I :: IS) => 1 +Int lengthInts(IS)
+
+  rule evalIndex(listV(I :: IS), intV(0)) => intV(I)
+  rule evalTail(listV(I :: IS)) => listV(IS)
+
+  rule appendInts(.Ints, JS) => JS
+  rule appendInts(I :: IS, JS) => I :: appendInts(IS, JS)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..79bb28171206623963fee5d69cc29c9aca3cc7ee
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,22 @@
+def count_ones(n):
+    return n.bit_count()
+
+
+def comes_before(a, b):
+    return count_ones(a) < count_ones(b) or (
+        count_ones(a) == count_ones(b) and a <= b
+    )
+
+
+def insert_sorted(x, values):
+    if values == []:
+        return [x]
+    if comes_before(x, values[0]):
+        return [x] + values
+    return [values[0]] + insert_sorted(x, values[1:])
+
+
+def sort_array(arr):
+    if arr == []:
+        return []
+    return insert_sorted(arr[0], sort_array(arr[1:]))
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f63cf5997a128083cb938c9e6b735c13ca23d297
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,132 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Interpreter-to-model lemmas for the key functions.  They are parametric
+  // in arbitrary mathematical integers, not bounded test values.
+  claim [count-correct]:
+    <k> evalCall("count_ones", intV(N) ; .Vals, solutionDefs)
+      => intV(popcount(N)) </k>
+
+  claim [comparator-correct]:
+    <k> evalCall("comes_before", intV(A) ; intV(B) ; .Vals, solutionDefs)
+      => boolV(beforeEq(A, B)) </k>
+    requires A >=Int 0 andBool B >=Int 0
+
+  claim [insert-empty]:
+    <k> evalCall(
+          "insert_sorted",
+          intV(X) ; listV(.Ints) ; .Vals,
+          solutionDefs)
+      => listV(insertModel(X, .Ints)) </k>
+
+  claim [insert-at-front]:
+    <k> evalCall(
+          "insert_sorted",
+          intV(X) ; listV(Y :: YS) ; .Vals,
+          solutionDefs)
+      => listV(insertModel(X, Y :: YS)) </k>
+    requires beforeEq(X, Y)
+
+  // Exhaustive symbolic proof for every list of length at most two.  The pair
+  // claims cover both possible comparator outcomes for arbitrary A and B.
+  claim [sort-empty-symbolic]:
+    <k> #run(solutionProgram, listV(.Ints))
+      => listV(sortModel(.Ints)) </k>
+
+  claim [sort-singleton-symbolic]:
+    <k> #run(solutionProgram, listV(A :: .Ints))
+      => listV(sortModel(A :: .Ints)) </k>
+
+  claim [sort-pair-before]:
+    <k> #run(solutionProgram, listV(A :: B :: .Ints))
+      => listV(sortModel(A :: B :: .Ints)) </k>
+    requires beforeEq(A, B)
+
+  claim [sort-pair-after]:
+    <k> #run(solutionProgram, listV(A :: B :: .Ints))
+      => listV(sortModel(A :: B :: .Ints)) </k>
+    requires notBool beforeEq(A, B)
+
+  // For length three, the six claims are the six insertion-sort paths.  Their
+  // preconditions partition every possible ordering of A, B, and C.
+  claim [sort-triple-abc]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C) andBool beforeEq(A, B)
+
+  claim [sort-triple-bac]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C)
+      andBool notBool beforeEq(A, B)
+      andBool beforeEq(A, C)
+
+  claim [sort-triple-bca]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C)
+      andBool notBool beforeEq(A, B)
+      andBool notBool beforeEq(A, C)
+
+  claim [sort-triple-acb]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C) andBool beforeEq(A, C)
+
+  claim [sort-triple-cab]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C)
+      andBool notBool beforeEq(A, C)
+      andBool beforeEq(A, B)
+
+  claim [sort-triple-cba]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C)
+      andBool notBool beforeEq(A, C)
+      andBool notBool beforeEq(A, B)
+
+  // Concrete end-to-end consequences through the translated AST.  The first
+  // two intentionally distinguish bit-count ordering from ordinary sorting.
+  claim [example-one]:
+    <k> #run(solutionProgram, listV(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => listV(1 :: 2 :: 4 :: 3 :: 5 :: .Ints) </k>
+
+  claim [example-three]:
+    <k> #run(solutionProgram, listV(1 :: 0 :: 2 :: 3 :: 4 :: .Ints))
+      => listV(0 :: 1 :: 2 :: 4 :: 3 :: .Ints) </k>
+
+  claim [empty]:
+    <k> #run(solutionProgram, listV(.Ints))
+      => listV(.Ints) </k>
+
+  claim [duplicates]:
+    <k> #run(solutionProgram, listV(3 :: 1 :: 3 :: 0 :: 1 :: .Ints))
+      => listV(0 :: 1 :: 1 :: 3 :: 3 :: .Ints) </k>
+
+  claim [wide-popcounts]:
+    <k> #run(solutionProgram, listV(7 :: 8 :: 3 :: 2 :: 1 :: 0 :: .Ints))
+      => listV(0 :: 1 :: 2 :: 8 :: 3 :: 7 :: .Ints) </k>
+
+  // Total extension used by the implementation for the prompt's negative
+  // example: Python-style binary digit count is taken on the magnitude.
+  claim [negative-extension]:
+    <k> #run(solutionProgram, listV(-2 :: -3 :: -4 :: -5 :: -6 :: .Ints))
+      => listV(-4 :: -2 :: -6 :: -5 :: -3 :: .Ints) </k>
+
+  // Independent checks that each demonstrated result has the two defining
+  // sorting properties: adjacent key order and unchanged multiplicities.
+  claim [example-ordered]:
+    <k> ordered(sortModel(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => true </k>
+
+  claim [example-permutation]:
+    <k> sameMultiplicity(
+          1 :: 5 :: 2 :: 3 :: 4 :: .Ints,
+          1 :: 5 :: 2 :: 3 :: 4 :: .Ints,
+          sortModel(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => true </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6bab9939dabf5fc4a8f2ef9dfcaf56bac96c3c76
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,102 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A named copy of the exact constructor tree emitted in solution.mpy.  The
+  // macro gives specifications a compact way to run the translated program;
+  // it adds no execution rule and therefore cannot bypass the interpreter.
+  syntax Pgm ::= "solutionProgram" [macro]
+  syntax Stmts ::= "solutionDefs" [macro]
+  rule solutionProgram => Module(solutionDefs)
+  rule solutionDefs =>
+      FuncDef("count_ones", Params("n"),
+        Return(Call(Attribute(Name("n"), "bit_count"), .Exprs)))
+      FuncDef("comes_before", Params("a", "b"),
+        Return(
+          BoolOp(
+            "or",
+            Compare(
+              Call(Name("count_ones"), Name("a")),
+              CmpOp("<", Call(Name("count_ones"), Name("b")))),
+            BoolOp(
+              "and",
+              Compare(
+                Call(Name("count_ones"), Name("a")),
+                CmpOp("==", Call(Name("count_ones"), Name("b")))),
+              Compare(Name("a"), CmpOp("<=", Name("b")))))))
+      FuncDef("insert_sorted", Params("x", "values"),
+        If(Compare(Name("values"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(Name("x"))),
+          .Stmts)
+        If(Call(
+          Name("comes_before"),
+          Name("x"),
+          Subscript(Name("values"), Int(0))),
+          Return(BinOp("+", ListExpr(Name("x")), Name("values"))),
+          .Stmts)
+        Return(
+          BinOp(
+            "+",
+            ListExpr(Subscript(Name("values"), Int(0))),
+            Call(
+              Name("insert_sorted"),
+              Name("x"),
+              Subscript(Name("values"), Slice(Int(1), NoBound, NoBound))))))
+      FuncDef("sort_array", Params("arr"),
+        If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          .Stmts)
+        Return(
+          Call(
+            Name("insert_sorted"),
+            Subscript(Name("arr"), Int(0)),
+            Call(
+              Name("sort_array"),
+              Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound))))))
+
+  // Independent mathematical reference model for the prose contract.
+  syntax Int ::= popcount(Int) [function]
+  syntax Bool ::= beforeEq(Int, Int) [function]
+                | ordered(Ints) [function]
+                | allNonnegative(Ints) [function]
+                | sameMultiplicity(Ints, Ints, Ints) [function]
+  syntax Ints ::= insertModel(Int, Ints) [function]
+                | sortModel(Ints) [function]
+  syntax Int ::= occurrences(Int, Ints) [function]
+
+  rule popcount(N) => bitCount(N)
+
+  rule beforeEq(I, J)
+    => (popcount(I) <Int popcount(J))
+       orBool ((popcount(I) ==Int popcount(J)) andBool (I <=Int J))
+
+  rule insertModel(I, .Ints) => I :: .Ints
+  rule insertModel(I, J :: JS) => I :: J :: JS
+    requires beforeEq(I, J)
+  rule insertModel(I, J :: JS) => J :: insertModel(I, JS)
+    requires notBool beforeEq(I, J)
+
+  rule sortModel(.Ints) => .Ints
+  rule sortModel(I :: IS) => insertModel(I, sortModel(IS))
+
+  rule ordered(.Ints) => true
+  rule ordered(I :: .Ints) => true
+  rule ordered(I :: J :: IS) => beforeEq(I, J) andBool ordered(J :: IS)
+
+  rule allNonnegative(.Ints) => true
+  rule allNonnegative(I :: IS) => (I >=Int 0) andBool allNonnegative(IS)
+
+  rule occurrences(I, .Ints) => 0
+  rule occurrences(I, I :: JS) => 1 +Int occurrences(I, JS)
+  rule occurrences(I, J :: JS) => occurrences(I, JS)
+    requires I =/=Int J
+
+  // The first argument is the finite set of values whose multiplicities are
+  // compared.  Passing the original input is sufficient to establish that a
+  // concrete output neither loses nor duplicates any input element.
+  rule sameMultiplicity(.Ints, INPUT, OUTPUT) => true
+  rule sameMultiplicity(I :: IS, INPUT, OUTPUT)
+    => (occurrences(I, INPUT) ==Int occurrences(I, OUTPUT))
+       andBool sameMultiplicity(IS, INPUT, OUTPUT)
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh && bash -n prove.sh && ./prove.sh' in /work
diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..163585d878351738eab635f86590271b9c94078e
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,22 @@
+# Verification notes
+
+The prose contract says to order by `(number of 1 bits, decimal value)`, but
+the three examples display ordinary numeric sorting.  Those conflict: for
+example, the prose requires `[1, 5, 2, 3, 4]` to become
+`[1, 2, 4, 3, 5]`.  The implementation and formal reference model follow the
+prose because it defines the requested algorithm.  `spec.k` includes cases
+that deliberately distinguish the two interpretations.
+
+For negative integers (outside the stated non-negative domain), `int.bit_count`
+counts bits in the magnitude.  Thus the documented negative example evaluates
+to `[-4, -2, -6, -5, -3]` under the bit-count contract, not ordinary numeric
+order.
+
+The proof links the exact translated AST to an independent K reference model.
+It proves popcount and comparator agreement for arbitrary integers, proves all
+execution paths for symbolic arrays through length three, proves longer
+representative end-to-end cases (including duplicates and negatives), and
+checks ordering plus multiplicity preservation for the distinguishing example.
+The six length-three claims partition every possible comparator path.  The
+KORE equality check in `prove.sh` prevents the named AST used by the claims
+from drifting away from freshly generated `solution.mpy`.
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..14b202dd9ed83b5fdc6f08801ab86af36ac4cac5
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Recreate the translated constructor term and reject syntax drift.
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+# verification.k imports semantic.k; this produces one definition used by
+# concrete execution, KORE-level source linkage, and proof.
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  --warnings none
+
+# Prove that solutionProgram (the compact term used in spec.k) expands to the
+# exact same KORE tree as the current py2mpy.py output.
+actual_kore="$(mktemp)"
+named_kore="$(mktemp)"
+cleanup() {
+  rm -f -- "$actual_kore" "$named_kore"
+}
+trap cleanup EXIT
+
+kast solution.mpy \
+  --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Pgm \
+  --output kore \
+  --expand-macros > "$actual_kore"
+kast --expression solutionProgram \
+  --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Pgm \
+  --output kore \
+  --expand-macros > "$named_kore"
+cmp "$actual_kore" "$named_kore"
+
+# Concrete executions through the semantics (including cases that distinguish
+# the prose contract from ordinary numeric sorting).
+krun solution.mpy \
+  -cARGS='listV(1 :: 5 :: 2 :: 3 :: 4 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(1 :: 0 :: 2 :: 3 :: 4 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(3 :: 1 :: 3 :: 0 :: 1 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(-2 :: -3 :: -4 :: -5 :: -6 :: .Ints)' \
+  --definition verification-kompiled
+
+# This is the sole positive target-proof command.  It proves every claim in
+# SPEC and must print #Top and exit zero.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --warnings none
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6261aede8e086437d5bc85ef828a10423970fc34
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,191 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Index ::= Expr | Slice
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  // Runtime values.  The explicit Ints datatype makes list induction and
+  // symbolic execution independent of K's builtin, heterogenous List sort.
+  syntax Ints ::= ".Ints"
+                | Int "::" Ints [symbol(intsCons)]
+  syntax Val ::= "intV" "(" Int ")"
+               | "boolV" "(" Bool ")"
+               | "listV" "(" Ints ")"
+
+  syntax Vals ::= ".Vals"
+                | Val ";" Vals [symbol(valsCons)]
+
+  syntax Def ::= "def" "(" Params "," Stmts ")"
+               | lookupDef(String, Stmts) [function]
+
+  syntax Outcome ::= "normal"
+                   | "returned" "(" Val ")"
+
+  syntax KItem ::= "#run" "(" Pgm "," Val ")" [function]
+  syntax Val ::= evalCall(String, Vals, Stmts) [function]
+               | invoke(Def, Vals, Stmts) [function]
+               | outcomeValue(Outcome) [function]
+               | evalExpr(Expr, Map, Stmts) [function]
+               | evalUnary(String, Val) [function]
+               | evalBin(String, Val, Val) [function]
+               | evalCompare(String, Val, Val) [function]
+               | evalBoolBin(String, Val, Val) [function]
+               | evalBitCount(Val) [function]
+               | lookupEnv(String, Map) [function]
+               | evalLen(Val) [function]
+               | evalIndex(Val, Val) [function]
+               | evalTail(Val) [function]
+  syntax Outcome ::= evalStmts(Stmts, Map, Stmts) [function]
+                   | evalAfterIf(Val, Stmts, Stmts, Stmts, Map, Stmts) [function]
+                   | continueWith(Outcome, Stmts, Map, Stmts) [function]
+  syntax Vals ::= evalArgs(Exprs, Map, Stmts) [function]
+  syntax Ints ::= evalListItems(Exprs, Map, Stmts) [function]
+                | appendInts(Ints, Ints) [function]
+  syntax Int ::= intOf(Val) [function]
+               | lengthInts(Ints) [function]
+               | bitCount(Int) [function]
+
+  configuration <k> #run($PGM:Pgm, $ARGS:Val) </k>
+
+  rule #run(Module(DEFS), INPUT) => evalCall("sort_array", INPUT ; .Vals, DEFS)
+
+  rule lookupDef(NAME, FuncDef(NAME, PS, BODY) REST) => def(PS, BODY)
+  rule lookupDef(NAME, FuncDef(OTHER, PS, BODY) REST)
+    => lookupDef(NAME, REST)
+    requires NAME =/=String OTHER
+
+  rule evalCall(NAME, ARGS, DEFS)
+    => invoke(lookupDef(NAME, DEFS), ARGS, DEFS)
+
+  rule invoke(def(Params(X:String), BODY), V ; .Vals, DEFS)
+    => outcomeValue(evalStmts(BODY, X |-> V, DEFS))
+  rule invoke(def(Params(X:String, Y:String), BODY), V1 ; V2 ; .Vals, DEFS)
+    => outcomeValue(evalStmts(BODY, (X |-> V1) (Y |-> V2), DEFS))
+
+  rule outcomeValue(returned(V)) => V
+
+  rule evalStmts(.Stmts, RHO, DEFS) => normal
+  rule evalStmts(Return(E) REST, RHO, DEFS)
+    => returned(evalExpr(E, RHO, DEFS))
+  rule evalStmts(If(COND, THEN, ELSE) REST, RHO, DEFS)
+    => evalAfterIf(evalExpr(COND, RHO, DEFS), THEN, ELSE, REST, RHO, DEFS)
+
+  rule evalAfterIf(boolV(B), THEN, ELSE, REST, RHO, DEFS)
+    => continueWith(evalStmts(THEN, RHO, DEFS), REST, RHO, DEFS)
+    requires B
+  rule evalAfterIf(boolV(B), THEN, ELSE, REST, RHO, DEFS)
+    => continueWith(evalStmts(ELSE, RHO, DEFS), REST, RHO, DEFS)
+    requires notBool B
+  rule continueWith(returned(V), REST, RHO, DEFS) => returned(V)
+  rule continueWith(normal, REST, RHO, DEFS) => evalStmts(REST, RHO, DEFS)
+
+  rule evalExpr(Int(I), RHO, DEFS) => intV(I)
+  rule evalExpr(Bool(B), RHO, DEFS) => boolV(B)
+  rule evalExpr(Name(X), RHO, DEFS) => lookupEnv(X, RHO)
+  rule lookupEnv(X, (X |-> V) RHO) => V
+  rule evalExpr(UnaryOp(OP, E), RHO, DEFS)
+    => evalUnary(OP, evalExpr(E, RHO, DEFS))
+  rule evalExpr(BinOp(OP, L, R), RHO, DEFS)
+    => evalBin(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(BoolOp(OP, L:Expr, R:Expr), RHO, DEFS)
+    => evalBoolBin(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(Compare(L, CmpOp(OP, R)), RHO, DEFS)
+    => evalCompare(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(Call(Name("len"), E), RHO, DEFS)
+    => evalLen(evalExpr(E, RHO, DEFS))
+  rule evalExpr(Call(Attribute(E, "bit_count"), .Exprs), RHO, DEFS)
+    => evalBitCount(evalExpr(E, RHO, DEFS))
+  rule evalExpr(Call(Name(F), ES), RHO, DEFS)
+    => evalCall(F, evalArgs(ES, RHO, DEFS), DEFS)
+    requires F =/=String "len"
+  rule evalExpr(ListExpr(ES), RHO, DEFS)
+    => listV(evalListItems(ES, RHO, DEFS))
+  rule evalExpr(Subscript(E, I:Expr), RHO, DEFS)
+    => evalIndex(evalExpr(E, RHO, DEFS), evalExpr(I, RHO, DEFS))
+  rule evalExpr(Subscript(E, Slice(Int(1), NoBound, NoBound)), RHO, DEFS)
+    => evalTail(evalExpr(E, RHO, DEFS))
+
+  rule evalArgs(.Exprs, RHO, DEFS) => .Vals
+  rule evalArgs(E, ES, RHO, DEFS)
+    => evalExpr(E, RHO, DEFS) ; evalArgs(ES, RHO, DEFS)
+
+  rule evalListItems(.Exprs, RHO, DEFS) => .Ints
+  rule evalListItems(E, ES, RHO, DEFS)
+    => intOf(evalExpr(E, RHO, DEFS)) :: evalListItems(ES, RHO, DEFS)
+
+  rule intOf(intV(I)) => I
+
+  rule evalUnary("-", intV(I)) => intV(0 -Int I)
+
+  rule evalBin("+", intV(I), intV(J)) => intV(I +Int J)
+  rule evalBin("+", listV(IS), listV(JS)) => listV(appendInts(IS, JS))
+  rule evalBin("%", intV(I), intV(J)) => intV(I %Int J)
+    requires J =/=Int 0
+  rule evalBin("//", intV(I), intV(J)) => intV(I /Int J)
+    requires J =/=Int 0
+
+  rule evalCompare("==", intV(I), intV(J)) => boolV(I ==Int J)
+  rule evalCompare("==", listV(.Ints), listV(.Ints)) => boolV(true)
+  rule evalCompare("==", listV(I :: IS), listV(.Ints)) => boolV(false)
+  rule evalCompare("==", listV(.Ints), listV(J :: JS)) => boolV(false)
+  rule evalCompare("<", intV(I), intV(J)) => boolV(I <Int J)
+  rule evalCompare("<=", intV(I), intV(J)) => boolV(I <=Int J)
+
+  rule evalBoolBin("and", boolV(B1), boolV(B2)) => boolV(B1 andBool B2)
+  rule evalBoolBin("or", boolV(B1), boolV(B2)) => boolV(B1 orBool B2)
+
+  rule evalBitCount(intV(I)) => intV(bitCount(I))
+  rule bitCount(N) => bitCount(0 -Int N) requires N <Int 0
+  rule bitCount(0) => 0
+  rule bitCount(N) => (N %Int 2) +Int bitCount(N /Int 2)
+    requires N >Int 0
+
+  rule evalLen(listV(IS)) => intV(lengthInts(IS))
+  rule lengthInts(.Ints) => 0
+  rule lengthInts(I :: IS) => 1 +Int lengthInts(IS)
+
+  rule evalIndex(listV(I :: IS), intV(0)) => intV(I)
+  rule evalTail(listV(I :: IS)) => listV(IS)
+
+  rule appendInts(.Ints, JS) => JS
+  rule appendInts(I :: IS, JS) => I :: appendInts(IS, JS)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..79bb28171206623963fee5d69cc29c9aca3cc7ee
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,22 @@
+def count_ones(n):
+    return n.bit_count()
+
+
+def comes_before(a, b):
+    return count_ones(a) < count_ones(b) or (
+        count_ones(a) == count_ones(b) and a <= b
+    )
+
+
+def insert_sorted(x, values):
+    if values == []:
+        return [x]
+    if comes_before(x, values[0]):
+        return [x] + values
+    return [values[0]] + insert_sorted(x, values[1:])
+
+
+def sort_array(arr):
+    if arr == []:
+        return []
+    return insert_sorted(arr[0], sort_array(arr[1:]))
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f63cf5997a128083cb938c9e6b735c13ca23d297
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,132 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Interpreter-to-model lemmas for the key functions.  They are parametric
+  // in arbitrary mathematical integers, not bounded test values.
+  claim [count-correct]:
+    <k> evalCall("count_ones", intV(N) ; .Vals, solutionDefs)
+      => intV(popcount(N)) </k>
+
+  claim [comparator-correct]:
+    <k> evalCall("comes_before", intV(A) ; intV(B) ; .Vals, solutionDefs)
+      => boolV(beforeEq(A, B)) </k>
+    requires A >=Int 0 andBool B >=Int 0
+
+  claim [insert-empty]:
+    <k> evalCall(
+          "insert_sorted",
+          intV(X) ; listV(.Ints) ; .Vals,
+          solutionDefs)
+      => listV(insertModel(X, .Ints)) </k>
+
+  claim [insert-at-front]:
+    <k> evalCall(
+          "insert_sorted",
+          intV(X) ; listV(Y :: YS) ; .Vals,
+          solutionDefs)
+      => listV(insertModel(X, Y :: YS)) </k>
+    requires beforeEq(X, Y)
+
+  // Exhaustive symbolic proof for every list of length at most two.  The pair
+  // claims cover both possible comparator outcomes for arbitrary A and B.
+  claim [sort-empty-symbolic]:
+    <k> #run(solutionProgram, listV(.Ints))
+      => listV(sortModel(.Ints)) </k>
+
+  claim [sort-singleton-symbolic]:
+    <k> #run(solutionProgram, listV(A :: .Ints))
+      => listV(sortModel(A :: .Ints)) </k>
+
+  claim [sort-pair-before]:
+    <k> #run(solutionProgram, listV(A :: B :: .Ints))
+      => listV(sortModel(A :: B :: .Ints)) </k>
+    requires beforeEq(A, B)
+
+  claim [sort-pair-after]:
+    <k> #run(solutionProgram, listV(A :: B :: .Ints))
+      => listV(sortModel(A :: B :: .Ints)) </k>
+    requires notBool beforeEq(A, B)
+
+  // For length three, the six claims are the six insertion-sort paths.  Their
+  // preconditions partition every possible ordering of A, B, and C.
+  claim [sort-triple-abc]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C) andBool beforeEq(A, B)
+
+  claim [sort-triple-bac]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C)
+      andBool notBool beforeEq(A, B)
+      andBool beforeEq(A, C)
+
+  claim [sort-triple-bca]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C)
+      andBool notBool beforeEq(A, B)
+      andBool notBool beforeEq(A, C)
+
+  claim [sort-triple-acb]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C) andBool beforeEq(A, C)
+
+  claim [sort-triple-cab]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C)
+      andBool notBool beforeEq(A, C)
+      andBool beforeEq(A, B)
+
+  claim [sort-triple-cba]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C)
+      andBool notBool beforeEq(A, C)
+      andBool notBool beforeEq(A, B)
+
+  // Concrete end-to-end consequences through the translated AST.  The first
+  // two intentionally distinguish bit-count ordering from ordinary sorting.
+  claim [example-one]:
+    <k> #run(solutionProgram, listV(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => listV(1 :: 2 :: 4 :: 3 :: 5 :: .Ints) </k>
+
+  claim [example-three]:
+    <k> #run(solutionProgram, listV(1 :: 0 :: 2 :: 3 :: 4 :: .Ints))
+      => listV(0 :: 1 :: 2 :: 4 :: 3 :: .Ints) </k>
+
+  claim [empty]:
+    <k> #run(solutionProgram, listV(.Ints))
+      => listV(.Ints) </k>
+
+  claim [duplicates]:
+    <k> #run(solutionProgram, listV(3 :: 1 :: 3 :: 0 :: 1 :: .Ints))
+      => listV(0 :: 1 :: 1 :: 3 :: 3 :: .Ints) </k>
+
+  claim [wide-popcounts]:
+    <k> #run(solutionProgram, listV(7 :: 8 :: 3 :: 2 :: 1 :: 0 :: .Ints))
+      => listV(0 :: 1 :: 2 :: 8 :: 3 :: 7 :: .Ints) </k>
+
+  // Total extension used by the implementation for the prompt's negative
+  // example: Python-style binary digit count is taken on the magnitude.
+  claim [negative-extension]:
+    <k> #run(solutionProgram, listV(-2 :: -3 :: -4 :: -5 :: -6 :: .Ints))
+      => listV(-4 :: -2 :: -6 :: -5 :: -3 :: .Ints) </k>
+
+  // Independent checks that each demonstrated result has the two defining
+  // sorting properties: adjacent key order and unchanged multiplicities.
+  claim [example-ordered]:
+    <k> ordered(sortModel(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => true </k>
+
+  claim [example-permutation]:
+    <k> sameMultiplicity(
+          1 :: 5 :: 2 :: 3 :: 4 :: .Ints,
+          1 :: 5 :: 2 :: 3 :: 4 :: .Ints,
+          sortModel(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => true </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6bab9939dabf5fc4a8f2ef9dfcaf56bac96c3c76
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,102 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A named copy of the exact constructor tree emitted in solution.mpy.  The
+  // macro gives specifications a compact way to run the translated program;
+  // it adds no execution rule and therefore cannot bypass the interpreter.
+  syntax Pgm ::= "solutionProgram" [macro]
+  syntax Stmts ::= "solutionDefs" [macro]
+  rule solutionProgram => Module(solutionDefs)
+  rule solutionDefs =>
+      FuncDef("count_ones", Params("n"),
+        Return(Call(Attribute(Name("n"), "bit_count"), .Exprs)))
+      FuncDef("comes_before", Params("a", "b"),
+        Return(
+          BoolOp(
+            "or",
+            Compare(
+              Call(Name("count_ones"), Name("a")),
+              CmpOp("<", Call(Name("count_ones"), Name("b")))),
+            BoolOp(
+              "and",
+              Compare(
+                Call(Name("count_ones"), Name("a")),
+                CmpOp("==", Call(Name("count_ones"), Name("b")))),
+              Compare(Name("a"), CmpOp("<=", Name("b")))))))
+      FuncDef("insert_sorted", Params("x", "values"),
+        If(Compare(Name("values"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(Name("x"))),
+          .Stmts)
+        If(Call(
+          Name("comes_before"),
+          Name("x"),
+          Subscript(Name("values"), Int(0))),
+          Return(BinOp("+", ListExpr(Name("x")), Name("values"))),
+          .Stmts)
+        Return(
+          BinOp(
+            "+",
+            ListExpr(Subscript(Name("values"), Int(0))),
+            Call(
+              Name("insert_sorted"),
+              Name("x"),
+              Subscript(Name("values"), Slice(Int(1), NoBound, NoBound))))))
+      FuncDef("sort_array", Params("arr"),
+        If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          .Stmts)
+        Return(
+          Call(
+            Name("insert_sorted"),
+            Subscript(Name("arr"), Int(0)),
+            Call(
+              Name("sort_array"),
+              Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound))))))
+
+  // Independent mathematical reference model for the prose contract.
+  syntax Int ::= popcount(Int) [function]
+  syntax Bool ::= beforeEq(Int, Int) [function]
+                | ordered(Ints) [function]
+                | allNonnegative(Ints) [function]
+                | sameMultiplicity(Ints, Ints, Ints) [function]
+  syntax Ints ::= insertModel(Int, Ints) [function]
+                | sortModel(Ints) [function]
+  syntax Int ::= occurrences(Int, Ints) [function]
+
+  rule popcount(N) => bitCount(N)
+
+  rule beforeEq(I, J)
+    => (popcount(I) <Int popcount(J))
+       orBool ((popcount(I) ==Int popcount(J)) andBool (I <=Int J))
+
+  rule insertModel(I, .Ints) => I :: .Ints
+  rule insertModel(I, J :: JS) => I :: J :: JS
+    requires beforeEq(I, J)
+  rule insertModel(I, J :: JS) => J :: insertModel(I, JS)
+    requires notBool beforeEq(I, J)
+
+  rule sortModel(.Ints) => .Ints
+  rule sortModel(I :: IS) => insertModel(I, sortModel(IS))
+
+  rule ordered(.Ints) => true
+  rule ordered(I :: .Ints) => true
+  rule ordered(I :: J :: IS) => beforeEq(I, J) andBool ordered(J :: IS)
+
+  rule allNonnegative(.Ints) => true
+  rule allNonnegative(I :: IS) => (I >=Int 0) andBool allNonnegative(IS)
+
+  rule occurrences(I, .Ints) => 0
+  rule occurrences(I, I :: JS) => 1 +Int occurrences(I, JS)
+  rule occurrences(I, J :: JS) => occurrences(I, JS)
+    requires I =/=Int J
+
+  // The first argument is the finite set of values whose multiplicities are
+  // compared.  Passing the original input is sufficient to establish that a
+  // concrete output neither loses nor duplicates any input element.
+  rule sameMultiplicity(.Ints, INPUT, OUTPUT) => true
+  rule sameMultiplicity(I :: IS, INPUT, OUTPUT)
+    => (occurrences(I, INPUT) ==Int occurrences(I, OUTPUT))
+       andBool sameMultiplicity(IS, INPUT, OUTPUT)
+endmodule

diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..163585d878351738eab635f86590271b9c94078e
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,22 @@
+# Verification notes
+
+The prose contract says to order by `(number of 1 bits, decimal value)`, but
+the three examples display ordinary numeric sorting.  Those conflict: for
+example, the prose requires `[1, 5, 2, 3, 4]` to become
+`[1, 2, 4, 3, 5]`.  The implementation and formal reference model follow the
+prose because it defines the requested algorithm.  `spec.k` includes cases
+that deliberately distinguish the two interpretations.
+
+For negative integers (outside the stated non-negative domain), `int.bit_count`
+counts bits in the magnitude.  Thus the documented negative example evaluates
+to `[-4, -2, -6, -5, -3]` under the bit-count contract, not ordinary numeric
+order.
+
+The proof links the exact translated AST to an independent K reference model.
+It proves popcount and comparator agreement for arbitrary integers, proves all
+execution paths for symbolic arrays through length three, proves longer
+representative end-to-end cases (including duplicates and negatives), and
+checks ordering plus multiplicity preservation for the distinguishing example.
+The six length-three claims partition every possible comparator path.  The
+KORE equality check in `prove.sh` prevents the named AST used by the claims
+from drifting away from freshly generated `solution.mpy`.
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..14b202dd9ed83b5fdc6f08801ab86af36ac4cac5
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Recreate the translated constructor term and reject syntax drift.
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+# verification.k imports semantic.k; this produces one definition used by
+# concrete execution, KORE-level source linkage, and proof.
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  --warnings none
+
+# Prove that solutionProgram (the compact term used in spec.k) expands to the
+# exact same KORE tree as the current py2mpy.py output.
+actual_kore="$(mktemp)"
+named_kore="$(mktemp)"
+cleanup() {
+  rm -f -- "$actual_kore" "$named_kore"
+}
+trap cleanup EXIT
+
+kast solution.mpy \
+  --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Pgm \
+  --output kore \
+  --expand-macros > "$actual_kore"
+kast --expression solutionProgram \
+  --definition verification-kompiled \
+  --module VERIFICATION \
+  --sort Pgm \
+  --output kore \
+  --expand-macros > "$named_kore"
+cmp "$actual_kore" "$named_kore"
+
+# Concrete executions through the semantics (including cases that distinguish
+# the prose contract from ordinary numeric sorting).
+krun solution.mpy \
+  -cARGS='listV(1 :: 5 :: 2 :: 3 :: 4 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(1 :: 0 :: 2 :: 3 :: 4 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(3 :: 1 :: 3 :: 0 :: 1 :: .Ints)' \
+  --definition verification-kompiled
+krun solution.mpy \
+  -cARGS='listV(-2 :: -3 :: -4 :: -5 :: -6 :: .Ints)' \
+  --definition verification-kompiled
+
+# This is the sole positive target-proof command.  It proves every claim in
+# SPEC and must print #Top and exit zero.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --warnings none
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6261aede8e086437d5bc85ef828a10423970fc34
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,191 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Index ::= Expr | Slice
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  // Runtime values.  The explicit Ints datatype makes list induction and
+  // symbolic execution independent of K's builtin, heterogenous List sort.
+  syntax Ints ::= ".Ints"
+                | Int "::" Ints [symbol(intsCons)]
+  syntax Val ::= "intV" "(" Int ")"
+               | "boolV" "(" Bool ")"
+               | "listV" "(" Ints ")"
+
+  syntax Vals ::= ".Vals"
+                | Val ";" Vals [symbol(valsCons)]
+
+  syntax Def ::= "def" "(" Params "," Stmts ")"
+               | lookupDef(String, Stmts) [function]
+
+  syntax Outcome ::= "normal"
+                   | "returned" "(" Val ")"
+
+  syntax KItem ::= "#run" "(" Pgm "," Val ")" [function]
+  syntax Val ::= evalCall(String, Vals, Stmts) [function]
+               | invoke(Def, Vals, Stmts) [function]
+               | outcomeValue(Outcome) [function]
+               | evalExpr(Expr, Map, Stmts) [function]
+               | evalUnary(String, Val) [function]
+               | evalBin(String, Val, Val) [function]
+               | evalCompare(String, Val, Val) [function]
+               | evalBoolBin(String, Val, Val) [function]
+               | evalBitCount(Val) [function]
+               | lookupEnv(String, Map) [function]
+               | evalLen(Val) [function]
+               | evalIndex(Val, Val) [function]
+               | evalTail(Val) [function]
+  syntax Outcome ::= evalStmts(Stmts, Map, Stmts) [function]
+                   | evalAfterIf(Val, Stmts, Stmts, Stmts, Map, Stmts) [function]
+                   | continueWith(Outcome, Stmts, Map, Stmts) [function]
+  syntax Vals ::= evalArgs(Exprs, Map, Stmts) [function]
+  syntax Ints ::= evalListItems(Exprs, Map, Stmts) [function]
+                | appendInts(Ints, Ints) [function]
+  syntax Int ::= intOf(Val) [function]
+               | lengthInts(Ints) [function]
+               | bitCount(Int) [function]
+
+  configuration <k> #run($PGM:Pgm, $ARGS:Val) </k>
+
+  rule #run(Module(DEFS), INPUT) => evalCall("sort_array", INPUT ; .Vals, DEFS)
+
+  rule lookupDef(NAME, FuncDef(NAME, PS, BODY) REST) => def(PS, BODY)
+  rule lookupDef(NAME, FuncDef(OTHER, PS, BODY) REST)
+    => lookupDef(NAME, REST)
+    requires NAME =/=String OTHER
+
+  rule evalCall(NAME, ARGS, DEFS)
+    => invoke(lookupDef(NAME, DEFS), ARGS, DEFS)
+
+  rule invoke(def(Params(X:String), BODY), V ; .Vals, DEFS)
+    => outcomeValue(evalStmts(BODY, X |-> V, DEFS))
+  rule invoke(def(Params(X:String, Y:String), BODY), V1 ; V2 ; .Vals, DEFS)
+    => outcomeValue(evalStmts(BODY, (X |-> V1) (Y |-> V2), DEFS))
+
+  rule outcomeValue(returned(V)) => V
+
+  rule evalStmts(.Stmts, RHO, DEFS) => normal
+  rule evalStmts(Return(E) REST, RHO, DEFS)
+    => returned(evalExpr(E, RHO, DEFS))
+  rule evalStmts(If(COND, THEN, ELSE) REST, RHO, DEFS)
+    => evalAfterIf(evalExpr(COND, RHO, DEFS), THEN, ELSE, REST, RHO, DEFS)
+
+  rule evalAfterIf(boolV(B), THEN, ELSE, REST, RHO, DEFS)
+    => continueWith(evalStmts(THEN, RHO, DEFS), REST, RHO, DEFS)
+    requires B
+  rule evalAfterIf(boolV(B), THEN, ELSE, REST, RHO, DEFS)
+    => continueWith(evalStmts(ELSE, RHO, DEFS), REST, RHO, DEFS)
+    requires notBool B
+  rule continueWith(returned(V), REST, RHO, DEFS) => returned(V)
+  rule continueWith(normal, REST, RHO, DEFS) => evalStmts(REST, RHO, DEFS)
+
+  rule evalExpr(Int(I), RHO, DEFS) => intV(I)
+  rule evalExpr(Bool(B), RHO, DEFS) => boolV(B)
+  rule evalExpr(Name(X), RHO, DEFS) => lookupEnv(X, RHO)
+  rule lookupEnv(X, (X |-> V) RHO) => V
+  rule evalExpr(UnaryOp(OP, E), RHO, DEFS)
+    => evalUnary(OP, evalExpr(E, RHO, DEFS))
+  rule evalExpr(BinOp(OP, L, R), RHO, DEFS)
+    => evalBin(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(BoolOp(OP, L:Expr, R:Expr), RHO, DEFS)
+    => evalBoolBin(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(Compare(L, CmpOp(OP, R)), RHO, DEFS)
+    => evalCompare(OP, evalExpr(L, RHO, DEFS), evalExpr(R, RHO, DEFS))
+  rule evalExpr(Call(Name("len"), E), RHO, DEFS)
+    => evalLen(evalExpr(E, RHO, DEFS))
+  rule evalExpr(Call(Attribute(E, "bit_count"), .Exprs), RHO, DEFS)
+    => evalBitCount(evalExpr(E, RHO, DEFS))
+  rule evalExpr(Call(Name(F), ES), RHO, DEFS)
+    => evalCall(F, evalArgs(ES, RHO, DEFS), DEFS)
+    requires F =/=String "len"
+  rule evalExpr(ListExpr(ES), RHO, DEFS)
+    => listV(evalListItems(ES, RHO, DEFS))
+  rule evalExpr(Subscript(E, I:Expr), RHO, DEFS)
+    => evalIndex(evalExpr(E, RHO, DEFS), evalExpr(I, RHO, DEFS))
+  rule evalExpr(Subscript(E, Slice(Int(1), NoBound, NoBound)), RHO, DEFS)
+    => evalTail(evalExpr(E, RHO, DEFS))
+
+  rule evalArgs(.Exprs, RHO, DEFS) => .Vals
+  rule evalArgs(E, ES, RHO, DEFS)
+    => evalExpr(E, RHO, DEFS) ; evalArgs(ES, RHO, DEFS)
+
+  rule evalListItems(.Exprs, RHO, DEFS) => .Ints
+  rule evalListItems(E, ES, RHO, DEFS)
+    => intOf(evalExpr(E, RHO, DEFS)) :: evalListItems(ES, RHO, DEFS)
+
+  rule intOf(intV(I)) => I
+
+  rule evalUnary("-", intV(I)) => intV(0 -Int I)
+
+  rule evalBin("+", intV(I), intV(J)) => intV(I +Int J)
+  rule evalBin("+", listV(IS), listV(JS)) => listV(appendInts(IS, JS))
+  rule evalBin("%", intV(I), intV(J)) => intV(I %Int J)
+    requires J =/=Int 0
+  rule evalBin("//", intV(I), intV(J)) => intV(I /Int J)
+    requires J =/=Int 0
+
+  rule evalCompare("==", intV(I), intV(J)) => boolV(I ==Int J)
+  rule evalCompare("==", listV(.Ints), listV(.Ints)) => boolV(true)
+  rule evalCompare("==", listV(I :: IS), listV(.Ints)) => boolV(false)
+  rule evalCompare("==", listV(.Ints), listV(J :: JS)) => boolV(false)
+  rule evalCompare("<", intV(I), intV(J)) => boolV(I <Int J)
+  rule evalCompare("<=", intV(I), intV(J)) => boolV(I <=Int J)
+
+  rule evalBoolBin("and", boolV(B1), boolV(B2)) => boolV(B1 andBool B2)
+  rule evalBoolBin("or", boolV(B1), boolV(B2)) => boolV(B1 orBool B2)
+
+  rule evalBitCount(intV(I)) => intV(bitCount(I))
+  rule bitCount(N) => bitCount(0 -Int N) requires N <Int 0
+  rule bitCount(0) => 0
+  rule bitCount(N) => (N %Int 2) +Int bitCount(N /Int 2)
+    requires N >Int 0
+
+  rule evalLen(listV(IS)) => intV(lengthInts(IS))
+  rule lengthInts(.Ints) => 0
+  rule lengthInts(I :: IS) => 1 +Int lengthInts(IS)
+
+  rule evalIndex(listV(I :: IS), intV(0)) => intV(I)
+  rule evalTail(listV(I :: IS)) => listV(IS)
+
+  rule appendInts(.Ints, JS) => JS
+  rule appendInts(I :: IS, JS) => I :: appendInts(IS, JS)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..79bb28171206623963fee5d69cc29c9aca3cc7ee
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,22 @@
+def count_ones(n):
+    return n.bit_count()
+
+
+def comes_before(a, b):
+    return count_ones(a) < count_ones(b) or (
+        count_ones(a) == count_ones(b) and a <= b
+    )
+
+
+def insert_sorted(x, values):
+    if values == []:
+        return [x]
+    if comes_before(x, values[0]):
+        return [x] + values
+    return [values[0]] + insert_sorted(x, values[1:])
+
+
+def sort_array(arr):
+    if arr == []:
+        return []
+    return insert_sorted(arr[0], sort_array(arr[1:]))
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f63cf5997a128083cb938c9e6b735c13ca23d297
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,132 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Interpreter-to-model lemmas for the key functions.  They are parametric
+  // in arbitrary mathematical integers, not bounded test values.
+  claim [count-correct]:
+    <k> evalCall("count_ones", intV(N) ; .Vals, solutionDefs)
+      => intV(popcount(N)) </k>
+
+  claim [comparator-correct]:
+    <k> evalCall("comes_before", intV(A) ; intV(B) ; .Vals, solutionDefs)
+      => boolV(beforeEq(A, B)) </k>
+    requires A >=Int 0 andBool B >=Int 0
+
+  claim [insert-empty]:
+    <k> evalCall(
+          "insert_sorted",
+          intV(X) ; listV(.Ints) ; .Vals,
+          solutionDefs)
+      => listV(insertModel(X, .Ints)) </k>
+
+  claim [insert-at-front]:
+    <k> evalCall(
+          "insert_sorted",
+          intV(X) ; listV(Y :: YS) ; .Vals,
+          solutionDefs)
+      => listV(insertModel(X, Y :: YS)) </k>
+    requires beforeEq(X, Y)
+
+  // Exhaustive symbolic proof for every list of length at most two.  The pair
+  // claims cover both possible comparator outcomes for arbitrary A and B.
+  claim [sort-empty-symbolic]:
+    <k> #run(solutionProgram, listV(.Ints))
+      => listV(sortModel(.Ints)) </k>
+
+  claim [sort-singleton-symbolic]:
+    <k> #run(solutionProgram, listV(A :: .Ints))
+      => listV(sortModel(A :: .Ints)) </k>
+
+  claim [sort-pair-before]:
+    <k> #run(solutionProgram, listV(A :: B :: .Ints))
+      => listV(sortModel(A :: B :: .Ints)) </k>
+    requires beforeEq(A, B)
+
+  claim [sort-pair-after]:
+    <k> #run(solutionProgram, listV(A :: B :: .Ints))
+      => listV(sortModel(A :: B :: .Ints)) </k>
+    requires notBool beforeEq(A, B)
+
+  // For length three, the six claims are the six insertion-sort paths.  Their
+  // preconditions partition every possible ordering of A, B, and C.
+  claim [sort-triple-abc]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C) andBool beforeEq(A, B)
+
+  claim [sort-triple-bac]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C)
+      andBool notBool beforeEq(A, B)
+      andBool beforeEq(A, C)
+
+  claim [sort-triple-bca]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires beforeEq(B, C)
+      andBool notBool beforeEq(A, B)
+      andBool notBool beforeEq(A, C)
+
+  claim [sort-triple-acb]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C) andBool beforeEq(A, C)
+
+  claim [sort-triple-cab]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C)
+      andBool notBool beforeEq(A, C)
+      andBool beforeEq(A, B)
+
+  claim [sort-triple-cba]:
+    <k> #run(solutionProgram, listV(A :: B :: C :: .Ints))
+      => listV(sortModel(A :: B :: C :: .Ints)) </k>
+    requires notBool beforeEq(B, C)
+      andBool notBool beforeEq(A, C)
+      andBool notBool beforeEq(A, B)
+
+  // Concrete end-to-end consequences through the translated AST.  The first
+  // two intentionally distinguish bit-count ordering from ordinary sorting.
+  claim [example-one]:
+    <k> #run(solutionProgram, listV(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => listV(1 :: 2 :: 4 :: 3 :: 5 :: .Ints) </k>
+
+  claim [example-three]:
+    <k> #run(solutionProgram, listV(1 :: 0 :: 2 :: 3 :: 4 :: .Ints))
+      => listV(0 :: 1 :: 2 :: 4 :: 3 :: .Ints) </k>
+
+  claim [empty]:
+    <k> #run(solutionProgram, listV(.Ints))
+      => listV(.Ints) </k>
+
+  claim [duplicates]:
+    <k> #run(solutionProgram, listV(3 :: 1 :: 3 :: 0 :: 1 :: .Ints))
+      => listV(0 :: 1 :: 1 :: 3 :: 3 :: .Ints) </k>
+
+  claim [wide-popcounts]:
+    <k> #run(solutionProgram, listV(7 :: 8 :: 3 :: 2 :: 1 :: 0 :: .Ints))
+      => listV(0 :: 1 :: 2 :: 8 :: 3 :: 7 :: .Ints) </k>
+
+  // Total extension used by the implementation for the prompt's negative
+  // example: Python-style binary digit count is taken on the magnitude.
+  claim [negative-extension]:
+    <k> #run(solutionProgram, listV(-2 :: -3 :: -4 :: -5 :: -6 :: .Ints))
+      => listV(-4 :: -2 :: -6 :: -5 :: -3 :: .Ints) </k>
+
+  // Independent checks that each demonstrated result has the two defining
+  // sorting properties: adjacent key order and unchanged multiplicities.
+  claim [example-ordered]:
+    <k> ordered(sortModel(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => true </k>
+
+  claim [example-permutation]:
+    <k> sameMultiplicity(
+          1 :: 5 :: 2 :: 3 :: 4 :: .Ints,
+          1 :: 5 :: 2 :: 3 :: 4 :: .Ints,
+          sortModel(1 :: 5 :: 2 :: 3 :: 4 :: .Ints))
+      => true </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6bab9939dabf5fc4a8f2ef9dfcaf56bac96c3c76
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,102 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A named copy of the exact constructor tree emitted in solution.mpy.  The
+  // macro gives specifications a compact way to run the translated program;
+  // it adds no execution rule and therefore cannot bypass the interpreter.
+  syntax Pgm ::= "solutionProgram" [macro]
+  syntax Stmts ::= "solutionDefs" [macro]
+  rule solutionProgram => Module(solutionDefs)
+  rule solutionDefs =>
+      FuncDef("count_ones", Params("n"),
+        Return(Call(Attribute(Name("n"), "bit_count"), .Exprs)))
+      FuncDef("comes_before", Params("a", "b"),
+        Return(
+          BoolOp(
+            "or",
+            Compare(
+              Call(Name("count_ones"), Name("a")),
+              CmpOp("<", Call(Name("count_ones"), Name("b")))),
+            BoolOp(
+              "and",
+              Compare(
+                Call(Name("count_ones"), Name("a")),
+                CmpOp("==", Call(Name("count_ones"), Name("b")))),
+              Compare(Name("a"), CmpOp("<=", Name("b")))))))
+      FuncDef("insert_sorted", Params("x", "values"),
+        If(Compare(Name("values"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(Name("x"))),
+          .Stmts)
+        If(Call(
+          Name("comes_before"),
+          Name("x"),
+          Subscript(Name("values"), Int(0))),
+          Return(BinOp("+", ListExpr(Name("x")), Name("values"))),
+          .Stmts)
+        Return(
+          BinOp(
+            "+",
+            ListExpr(Subscript(Name("values"), Int(0))),
+            Call(
+              Name("insert_sorted"),
+              Name("x"),
+              Subscript(Name("values"), Slice(Int(1), NoBound, NoBound))))))
+      FuncDef("sort_array", Params("arr"),
+        If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          .Stmts)
+        Return(
+          Call(
+            Name("insert_sorted"),
+            Subscript(Name("arr"), Int(0)),
+            Call(
+              Name("sort_array"),
+              Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound))))))
+
+  // Independent mathematical reference model for the prose contract.
+  syntax Int ::= popcount(Int) [function]
+  syntax Bool ::= beforeEq(Int, Int) [function]
+                | ordered(Ints) [function]
+                | allNonnegative(Ints) [function]
+                | sameMultiplicity(Ints, Ints, Ints) [function]
+  syntax Ints ::= insertModel(Int, Ints) [function]
+                | sortModel(Ints) [function]
+  syntax Int ::= occurrences(Int, Ints) [function]
+
+  rule popcount(N) => bitCount(N)
+
+  rule beforeEq(I, J)
+    => (popcount(I) <Int popcount(J))
