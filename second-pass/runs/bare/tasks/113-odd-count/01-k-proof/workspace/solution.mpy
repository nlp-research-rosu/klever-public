Module(
  FuncDef("odd_count", Params("lst"),
    Assign(Name("result"), ListExpr())
    For(Name("s"), Name("lst"),
      Assign(Name("count"), Int(0))
      For(Name("c"), Name("s"),
        If(Compare(Name("c"), CmpOp("in", Str("13579"))),
          Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
          ))
      Assign(
        Name("result"),
        BinOp(
          "+",
          Name("result"),
          ListExpr(
            BinOp(
              "+",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      BinOp(
                        "+",
                        BinOp(
                          "+",
                          BinOp(
                            "+",
                            Str("the number of odd elements "),
                            Call(Name("str"), Name("count"))),
                          Str("n the str")),
                        Call(Name("str"), Name("count"))),
                      Str("ng ")),
                    Call(Name("str"), Name("count"))),
                  Str(" of the ")),
                Call(Name("str"), Name("count"))),
              Str("nput."))))))
    Return(Name("result"))))
