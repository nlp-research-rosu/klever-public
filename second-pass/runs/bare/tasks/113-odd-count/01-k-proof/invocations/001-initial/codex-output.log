+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit, noDigits))))))))),
+         noValues))) </output>
+
+  claim [prompt-example-two]:
+    <k> solutionProgram => .K </k>
+    <input> pyList(
+        value(pyString(inputDigits(digit(oddDigit, noDigits))),
+        value(pyString(inputDigits(
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit, noDigits)))))))))),
+        noValues))) </input>
+    <output> noValue => pyList(expected(
+         value(pyString(inputDigits(digit(oddDigit, noDigits))),
+         value(pyString(inputDigits(
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit, noDigits)))))))))),
+         noValues)))) </output>
+
+  // For every integer N, the source expression constructs exactly the
+  // contract's sentence with N substituted at all four occurrences of "i".
+  claim [format-all-counts]:
+    <k> evaluate(
+      BinOp(
+        "+",
+        BinOp(
