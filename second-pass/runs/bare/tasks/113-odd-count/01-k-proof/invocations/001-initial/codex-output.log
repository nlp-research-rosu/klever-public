diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..352d1992332f945846b04aff9614984c034277d4
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,113 @@
+requires "verification.k"
+
+module ODD-COUNT-SPEC
+  imports ODD-COUNT-VERIFICATION
+
+  // The empty list is the outer-loop base case.
+  claim [empty-list]:
+    <k> solutionProgram => .K </k>
+    <input> pyList(noValues) </input>
+    <output> noValue => pyList(expected(noValues)) </output>
+
+  // Exact examples from prompt.py (digits are represented by their parity).
+  claim [prompt-example-one]:
+    <k> solutionProgram => .K </k>
+    <input> pyList(value(
+        pyString(inputDigits(
+          digit(oddDigit,
+          digit(evenDigit,
+          digit(oddDigit,
+          digit(evenDigit,
+          digit(oddDigit,
+          digit(evenDigit,
+          digit(oddDigit, noDigits))))))))),
+        noValues)) </input>
+    <output> noValue => pyList(expected(value(
+         pyString(inputDigits(
+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit, noDigits))))))))),
+         noValues))) </output>
+
+  claim [prompt-example-two]:
+    <k> solutionProgram => .K </k>
+    <input> pyList(
+        value(pyString(inputDigits(digit(oddDigit, noDigits))),
+        value(pyString(inputDigits(
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit, noDigits)))))))))),
+        noValues))) </input>
+    <output> noValue => pyList(expected(
+         value(pyString(inputDigits(digit(oddDigit, noDigits))),
+         value(pyString(inputDigits(
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit, noDigits)))))))))),
+         noValues)))) </output>
+
+  // For every integer N, the source expression constructs exactly the
+  // contract's sentence with N substituted at all four occurrences of "i".
+  claim [format-all-counts]:
+    <k> evaluate(
+      BinOp(
+        "+",
+        BinOp(
+          "+",
+          BinOp(
+            "+",
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      Str("the number of odd elements "),
+                      Call(Name("str"), Name("count"))),
+                    Str("n the str")),
+                  Call(Name("str"), Name("count"))),
+                Str("ng ")),
+              Call(Name("str"), Name("count"))),
+            Str(" of the ")),
+          Call(Name("str"), Name("count"))),
+        Str("nput.")),
+      "count" |-> pyInt(N))
+        => pyString(message(N)) </k>
+
+  // These claims are the two universal character-step cases.  Together with
+  // digitValues(noDigits) => noValues, they exhaust valid digit strings.
+  claim [even-character-step]:
+    <k> executeFor(
+      digitValues(digit(evenDigit, DS)), "c", innerBody, REST,
+      ("count" |-> pyInt(N)) ENV)
+        => executeFor(
+         digitValues(DS), "c", innerBody, REST,
+         (("count" |-> pyInt(N)) ENV)["c" <- pyString(oneDigit(evenDigit))]) </k>
+
+  claim [odd-character-step]:
+    <k> executeFor(
+      digitValues(digit(oddDigit, DS)), "c", innerBody, REST,
+      ("count" |-> pyInt(N)) ENV)
+        => executeFor(
+         digitValues(DS), "c", innerBody, REST,
+         ((("count" |-> pyInt(N)) ENV)["c" <- pyString(oneDigit(oddDigit))])
+           ["count" <- pyInt(N +Int 1)]) </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..63af8181261cf8476c1ce0b62c64735c1ef43405
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,92 @@
+requires "semantic.k"
+
+// Program text and a mathematical oracle used only by the proof.
+// The three statement macros are a readable factorization of solution.mpy.
+
+module ODD-COUNT-VERIFICATION
+  imports MPY-SEMANTICS
+
+  syntax Stmts ::= "innerBody" [macro]
+                 | "outerBody" [macro]
+                 | "functionBody" [macro]
+  syntax Module ::= "solutionProgram" [macro]
+
+  rule innerBody
+    => If(Compare(Name("c"), CmpOp("in", Str("13579"))),
+          Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
+          .Stmts)
+
+  rule outerBody
+    => Assign(Name("count"), Int(0))
+       For(Name("c"), Name("s"), innerBody)
+       Assign(
+         Name("result"),
+         BinOp(
+           "+", Name("result"),
+           ListExpr(
+             BinOp(
+               "+",
+               BinOp(
+                 "+",
+                 BinOp(
+                   "+",
+                   BinOp(
+                     "+",
+                     BinOp(
+                       "+",
+                       BinOp(
+                         "+",
+                         BinOp(
+                           "+",
+                           BinOp(
+                             "+",
+                             Str("the number of odd elements "),
+                             Call(Name("str"), Name("count"))),
+                           Str("n the str")),
+                         Call(Name("str"), Name("count"))),
+                       Str("ng ")),
+                     Call(Name("str"), Name("count"))),
+                   Str(" of the ")),
+                 Call(Name("str"), Name("count"))),
+               Str("nput.")))))
+
+  rule functionBody
+    => Assign(Name("result"), ListExpr())
+       For(Name("s"), Name("lst"), outerBody)
+       Return(Name("result"))
+
+  rule solutionProgram
+    => Module(FuncDef("odd_count", Params("lst"), functionBody))
+
+  syntax Int ::= oddCount ( Digits ) [function]
+  rule oddCount(noDigits) => 0
+  rule oddCount(digit(evenDigit, DS)) => oddCount(DS)
+  rule oddCount(digit(oddDigit, DS)) => 1 +Int oddCount(DS)
+
+  syntax Text ::= message ( Int ) [function]
+  rule message(N)
+    => concat(
+         concat(
+           concat(
+             concat(
+               concat(
+                 concat(
+                   concat(
+                     concat(literal("the number of odd elements "), number(N)),
+                     literal("n the str")),
+                   number(N)),
+                 literal("ng ")),
+               number(N)),
+             literal(" of the ")),
+           number(N)),
+         literal("nput."))
+
+  syntax Values ::= expected ( Values ) [function]
+  rule expected(noValues) => noValues
+  rule expected(value(pyString(inputDigits(DS)), REST))
+    => value(pyString(message(oddCount(DS))), expected(REST))
+
+  syntax Value ::= runProgram ( Module , Value ) [function]
+  rule runProgram(Module(FuncDef("odd_count", Params("lst"), BODY)), IN)
+    => resultValue(execute(BODY, "lst" |-> IN))
+endmodule

apply patch
