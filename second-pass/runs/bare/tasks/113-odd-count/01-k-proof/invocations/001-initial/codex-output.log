diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..82296f1fc25936accd230a737ab43d7a63fc709b
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,71 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Recreate the exact translator artifact and sanity-check the CPython program.
+python3 py2mpy.py solution.py > solution.mpy
+python3 - <<'PY'
+from solution import odd_count
+
+assert odd_count(["1234567"]) == [
+    "the number of odd elements 4n the str4ng 4 of the 4nput."
+]
+assert odd_count(["3", "11111111"]) == [
+    "the number of odd elements 1n the str1ng 1 of the 1nput.",
+    "the number of odd elements 8n the str8ng 8 of the 8nput.",
+]
+PY
+
+# Compile the executable semantics and run the translated first prompt example.
+kompile semantic.k \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm \
+  -o semantic-kompiled
+
+krun solution.mpy \
+  -cINPUT='pyList(value(pyString(inputDigits(digit(oddDigit, digit(evenDigit, digit(oddDigit, digit(evenDigit, digit(oddDigit, digit(evenDigit, digit(oddDigit, noDigits))))))))), noValues))' \
+  --definition semantic-kompiled \
+  --output pretty
+
+# Compile the proof definition.  The KAST comparison guarantees that the
+# readable solutionProgram macro proved below is exactly solution.mpy.
+kompile verification.k \
+  --main-module ODD-COUNT-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  -o verification-kompiled
+
+cmp \
+  <(kast solution.mpy \
+      --definition verification-kompiled \
+      --module MPY-SYNTAX \
+      --sort Module \
+      --expand-macros \
+      --output kore) \
+  <(kast \
+      --expression solutionProgram \
+      --definition verification-kompiled \
+      --module ODD-COUNT-VERIFICATION \
+      --sort Module \
+      --expand-macros \
+      --output kore)
+
+# The deliberately false claim must be rejected; this guards against a
+# vacuous proof harness.  Its expected non-zero result is handled explicitly.
+if kprove mutation.k \
+     --definition verification-kompiled \
+     --spec-module ODD-COUNT-MUTATION \
+     --output pretty; then
+  echo "error: mutation.k unexpectedly proved" >&2
+  exit 1
+else
+  echo "mutation.k rejected as expected"
+fi
+
+# Positive target proof: every claim in spec.k must close and print #Top.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module ODD-COUNT-SPEC \
+  --output pretty
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..9bd07090b94be932821504210bcab63f0edc8cfc
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,165 @@
+// A small, executable semantics for the py2mpy fragment used by solution.py.
+// Digit strings retain precisely the information observable by odd_count:
+// whether each character is odd or even.  Text concatenation remains
+// structural, so symbolic decimal conversion does not depend on a host hook.
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Params ::= "Params" "(" String ")"
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "ListExpr" "(" ")"
+                | "ListExpr" "(" Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Call" "(" Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  // Valid input strings contain only digits.  This quotient records exactly
+  // their parity, the only property this task observes.
+  syntax Digit ::= "evenDigit" | "oddDigit"
+  syntax Digits ::= "noDigits"
+                  | "digit" "(" Digit "," Digits ")"
+
+  // Text is a denotation of a Python string.  concat and number denote exact
+  // string concatenation and decimal rendering, respectively.
+  syntax Text ::= "literal" "(" String ")"
+                | "inputDigits" "(" Digits ")"
+                | "oneDigit" "(" Digit ")"
+                | "number" "(" Int ")"
+                | "concat" "(" Text "," Text ")"
+
+  syntax Values ::= "noValues"
+                  | "value" "(" Value "," Values ")"
+  syntax Value ::= "noValue"
+                 | "pyInt" "(" Int ")"
+                 | "pyBool" "(" Bool ")"
+                 | "pyString" "(" Text ")"
+                 | "pyList" "(" Values ")"
+
+  // A newest-binding-first environment.  Assignment adds a shadowing entry;
+  // this avoids imposing any host-map reasoning on symbolic proofs.
+  syntax Env ::= "emptyEnv"
+               | "store" "(" String "," Value "," Env ")"
+
+  syntax ExecResult ::= "normal" "(" Env ")"
+                      | "returned" "(" Value ")"
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+
+  configuration
+    <py>
+      <k> $PGM:Module </k>
+      <input> $INPUT:Value </input>
+      <output> noValue </output>
+    </py>
+
+  syntax Value ::= evaluate ( Expr , Env ) [function]
+                 | lookup ( String , Env ) [function]
+  syntax Value ::= addValue ( Value , Value ) [function]
+                 | containsValue ( Value , Value ) [function]
+                 | builtinStr ( Value ) [function]
+  syntax Values ::= appendValues ( Values , Values ) [function]
+                  | iterableValues ( Value ) [function]
+                  | digitValues ( Digits ) [function]
+
+  rule evaluate(Name(X), ENV) => lookup(X, ENV)
+  rule lookup(X, store(X, V, _ENV)) => V
+  rule lookup(X, store(Y, _V, ENV)) => lookup(X, ENV)
+    requires X =/=String Y
+  rule evaluate(Int(I), _) => pyInt(I)
+  rule evaluate(Str(S), _) => pyString(literal(S))
+  rule evaluate(ListExpr(), _) => pyList(noValues)
+  rule evaluate(ListExpr(E), ENV) => pyList(value(evaluate(E, ENV), noValues))
+  rule evaluate(BinOp("+", LEFT, RIGHT), ENV)
+    => addValue(evaluate(LEFT, ENV), evaluate(RIGHT, ENV))
+  rule evaluate(Compare(LEFT, CmpOp("in", RIGHT)), ENV)
+    => containsValue(evaluate(LEFT, ENV), evaluate(RIGHT, ENV))
+  rule evaluate(Call(Name("str"), ARG), ENV)
+    => builtinStr(evaluate(ARG, ENV))
+
+  rule addValue(pyInt(I), pyInt(J)) => pyInt(I +Int J)
+  rule addValue(pyString(A), pyString(B)) => pyString(concat(A, B))
+  rule addValue(pyList(A), pyList(B)) => pyList(appendValues(A, B))
+
+  rule appendValues(noValues, B) => B
+  rule appendValues(value(V, VS), B) => value(V, appendValues(VS, B))
+
+  rule builtinStr(pyInt(I)) => pyString(number(I))
+
+  rule containsValue(pyString(oneDigit(oddDigit)),
+                     pyString(literal("13579"))) => pyBool(true)
+  rule containsValue(pyString(oneDigit(evenDigit)),
+                     pyString(literal("13579"))) => pyBool(false)
+
+  rule iterableValues(pyList(VS)) => VS
+  rule iterableValues(pyString(inputDigits(DS))) => digitValues(DS)
+  rule digitValues(noDigits) => noValues
+  rule digitValues(digit(D, DS))
+    => value(pyString(oneDigit(D)), digitValues(DS))
+
+  syntax ExecResult ::= execute ( Stmts , Env ) [function]
+                      | afterBlock ( ExecResult , Stmts ) [function]
+                      | executeFor ( Values , String , Stmts , Stmts , Env ) [function]
+                      | afterIteration ( ExecResult , Values , String , Stmts , Stmts ) [function]
+
+  rule execute(.Stmts, ENV) => normal(ENV)
+
+  rule execute(Assign(Name(X), E) REST, ENV)
+    => execute(REST, store(X, evaluate(E, ENV), ENV))
+
+  rule execute(If(COND, YES, NO) REST, ENV)
+    => executeIf(evaluate(COND, ENV), YES, NO, REST, ENV)
+
+  syntax ExecResult ::= executeIf ( Value , Stmts , Stmts , Stmts , Env ) [function]
+  rule executeIf(pyBool(true), YES, _, REST, ENV)
+    => afterBlock(execute(YES, ENV), REST)
+  rule executeIf(pyBool(false), _, NO, REST, ENV)
+    => afterBlock(execute(NO, ENV), REST)
+
+  rule afterBlock(normal(ENV), REST) => execute(REST, ENV)
+  rule afterBlock(returned(V), _) => returned(V)
+
+  rule execute(For(Name(X), ITER, BODY) REST, ENV)
+    => executeFor(iterableValues(evaluate(ITER, ENV)), X, BODY, REST, ENV)
+
+  rule executeFor(noValues, _, _, REST, ENV) => execute(REST, ENV)
+  rule executeFor(value(V, VS), X, BODY, REST, ENV)
+    => afterIteration(execute(BODY, store(X, V, ENV)), VS, X, BODY, REST)
+
+  rule afterIteration(normal(ENV), VS, X, BODY, REST)
+    => executeFor(VS, X, BODY, REST, ENV)
+  rule afterIteration(returned(V), _, _, _, _) => returned(V)
+
+  rule execute(Return(E) _REST, ENV) => returned(evaluate(E, ENV))
+
+  syntax Value ::= resultValue ( ExecResult ) [function]
+  rule resultValue(returned(V)) => V
+
+  rule <k> Module(FuncDef("odd_count", Params("lst"), BODY))
+        => .K ...</k>
+       <input> IN </input>
+       <output> noValue => resultValue(execute(BODY, store("lst", IN, emptyEnv))) </output>
+endmodule
+
+module MPY
+  imports MPY-SEMANTICS
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc03d9105532236a732c3a4fdebfe7db365a46a8
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def odd_count(lst):
+    result = []
+    for s in lst:
+        count = 0
+        for c in s:
+            if c in "13579":
+                count = count + 1
+        result = result + ["the number of odd elements " + str(count) + "n the str" + str(count) + "ng " + str(count) + " of the " + str(count) + "nput."]
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cd9dd5265d95fdb90dd42024a0d856109272d440
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,135 @@
+requires "verification.k"
+
+module ODD-COUNT-SPEC
+  imports ODD-COUNT-VERIFICATION
+
+  // The empty list is the outer-loop base case.
+  claim [empty-list]:
+    <k> solutionProgram => .K </k>
+    <input> pyList(noValues) </input>
+    <output> noValue => pyList(expected(noValues)) </output>
+
+  // Exact examples from prompt.py (digits are represented by their parity).
+  claim [prompt-example-one]:
+    <k> solutionProgram => .K </k>
+    <input> pyList(value(
+        pyString(inputDigits(
+          digit(oddDigit,
+          digit(evenDigit,
+          digit(oddDigit,
+          digit(evenDigit,
+          digit(oddDigit,
+          digit(evenDigit,
+          digit(oddDigit, noDigits))))))))),
+        noValues)) </input>
+    <output> noValue => pyList(expected(value(
+         pyString(inputDigits(
+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit,
+           digit(evenDigit,
+           digit(oddDigit, noDigits))))))))),
+         noValues))) </output>
+
+  claim [prompt-example-two]:
+    <k> solutionProgram => .K </k>
+    <input> pyList(
+        value(pyString(inputDigits(digit(oddDigit, noDigits))),
+        value(pyString(inputDigits(
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit, noDigits)))))))))),
+        noValues))) </input>
+    <output> noValue => pyList(expected(
+         value(pyString(inputDigits(digit(oddDigit, noDigits))),
+         value(pyString(inputDigits(
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit,
+           digit(oddDigit, noDigits)))))))))),
+         noValues)))) </output>
+
+  // For every integer N, the source expression constructs exactly the
+  // contract's sentence with N substituted at all four occurrences of "i".
+  claim [format-all-counts]:
+    <k> evaluate(
+      BinOp(
+        "+",
+        BinOp(
+          "+",
+          BinOp(
+            "+",
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      Str("the number of odd elements "),
+                      Call(Name("str"), Name("count"))),
+                    Str("n the str")),
+                  Call(Name("str"), Name("count"))),
+                Str("ng ")),
+              Call(Name("str"), Name("count"))),
+            Str(" of the ")),
+          Call(Name("str"), Name("count"))),
+        Str("nput.")),
+      store("count", pyInt(N), emptyEnv))
+        => pyString(message(N)) </k>
+
+  // These claims are the two universal character-step cases.  Together with
+  // digitValues(noDigits) => noValues, they exhaust valid digit strings.
+  claim [character-loop-base]:
+    <k> executeFor(noValues, "c", innerBody, REST, ENV)
+        => execute(REST, ENV) </k>
+
+  claim [even-character-step]:
+    <k> executeFor(
+      digitValues(digit(evenDigit, DS)), "c", innerBody, REST,
+      ENV)
+        => executeFor(
+         digitValues(DS), "c", innerBody, REST,
+         store("c", pyString(oneDigit(evenDigit)), ENV)) </k>
+
+  claim [odd-character-step]:
+    <k> executeFor(
+      digitValues(digit(oddDigit, DS)), "c", innerBody, REST,
+      ENV)
+        => executeFor(
+         digitValues(DS), "c", innerBody, REST,
+         store(
+           "count",
+           addValue(
+             evaluate(Name("count"),
+               store("c", pyString(oneDigit(oddDigit)), ENV)),
+             pyInt(1)),
+           store("c", pyString(oneDigit(oddDigit)), ENV))) </k>
+
+  // The list-loop base and the two append equations complete the structural
+  // cases used by the outer loop, for arbitrary values and continuations.
+  claim [list-loop-base]:
+    <k> executeFor(noValues, "s", outerBody, REST, ENV)
+        => execute(REST, ENV) </k>
+
+  claim [append-base]:
+    <k> appendValues(noValues, VS) => VS </k>
+
+  claim [append-step]:
+    <k> appendValues(value(V, VS), WS)
+        => value(V, appendValues(VS, WS)) </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..07d9646a2770c9dd0f87d27a48e88b5294a1aecc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,92 @@
+requires "semantic.k"
+
+// Program text and a mathematical oracle used only by the proof.
+// The three statement macros are a readable factorization of solution.mpy.
+
+module ODD-COUNT-VERIFICATION
+  imports MPY-SEMANTICS
+
+  syntax Stmts ::= "innerBody" [macro]
+                 | "outerBody" [macro]
+                 | "functionBody" [macro]
+  syntax Module ::= "solutionProgram" [macro]
+
+  rule innerBody
+    => If(Compare(Name("c"), CmpOp("in", Str("13579"))),
+          Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
+          .Stmts)
+
+  rule outerBody
+    => Assign(Name("count"), Int(0))
+       For(Name("c"), Name("s"), innerBody)
+       Assign(
+         Name("result"),
+         BinOp(
+           "+", Name("result"),
+           ListExpr(
+             BinOp(
+               "+",
+               BinOp(
+                 "+",
+                 BinOp(
+                   "+",
+                   BinOp(
+                     "+",
+                     BinOp(
+                       "+",
+                       BinOp(
+                         "+",
+                         BinOp(
+                           "+",
+                           BinOp(
+                             "+",
+                             Str("the number of odd elements "),
+                             Call(Name("str"), Name("count"))),
+                           Str("n the str")),
+                         Call(Name("str"), Name("count"))),
+                       Str("ng ")),
+                     Call(Name("str"), Name("count"))),
+                   Str(" of the ")),
+                 Call(Name("str"), Name("count"))),
+               Str("nput.")))))
+
+  rule functionBody
+    => Assign(Name("result"), ListExpr())
+       For(Name("s"), Name("lst"), outerBody)
+       Return(Name("result"))
+
+  rule solutionProgram
+    => Module(FuncDef("odd_count", Params("lst"), functionBody))
+
+  syntax Int ::= oddCount ( Digits ) [function]
+  rule oddCount(noDigits) => 0
+  rule oddCount(digit(evenDigit, DS)) => oddCount(DS)
+  rule oddCount(digit(oddDigit, DS)) => 1 +Int oddCount(DS)
+
+  syntax Text ::= message ( Int ) [function]
+  rule message(N)
+    => concat(
+         concat(
+           concat(
+             concat(
+               concat(
+                 concat(
+                   concat(
+                     concat(literal("the number of odd elements "), number(N)),
+                     literal("n the str")),
+                   number(N)),
+                 literal("ng ")),
+               number(N)),
+             literal(" of the ")),
+           number(N)),
+         literal("nput."))
+
+  syntax Values ::= expected ( Values ) [function]
+  rule expected(noValues) => noValues
+  rule expected(value(pyString(inputDigits(DS)), REST))
+    => value(pyString(message(oddCount(DS))), expected(REST))
+
+  syntax Value ::= runProgram ( Module , Value ) [function]
+  rule runProgram(Module(FuncDef("odd_count", Params("lst"), BODY)), IN)
+    => resultValue(execute(BODY, store("lst", IN, emptyEnv)))
+endmodule

