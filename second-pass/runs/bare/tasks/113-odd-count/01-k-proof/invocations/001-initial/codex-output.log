+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit,
+          digit(oddDigit, noDigits)))))))))),
+        noValues))))
+        => pyList(expected(
