+                "formal_input_abbreviation": abbreviated_k_input,
+                "canonical_result": canonical_result,
+                "generated_result": generated_result,
+                "matches": canonical_result == generated_result,
+            },
+            sort_keys=True,
+        )
+    )
+    if canonical_result != generated_result:
+        raise SystemExit(1)

