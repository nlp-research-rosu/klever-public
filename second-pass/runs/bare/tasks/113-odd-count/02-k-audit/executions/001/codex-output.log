+        "value(pyString(inputDigits(O,O,O,O,O,O,O,O)),noValues)))",
+    ),
+]
+
+for claim, concrete_input, abbreviated_k_input in witnesses:
+    canonical_result = canonical(concrete_input)
+    generated_result = generated(concrete_input)
+    print(
+        json.dumps(
