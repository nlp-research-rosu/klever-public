    45	          digit(oddDigit,
    46	          digit(oddDigit,
    47	          digit(oddDigit,
    48	          digit(oddDigit, noDigits)))))))))),
    49	        noValues))) </input>
    50	    <output> noValue => pyList(expected(
    51	         value(pyString(inputDigits(digit(oddDigit, noDigits))),
    52	         value(pyString(inputDigits(
    53	           digit(oddDigit,
    54	           digit(oddDigit,
    55	           digit(oddDigit,
    56	           digit(oddDigit,
    57	           digit(oddDigit,
    58	           digit(oddDigit,
    59	           digit(oddDigit,
    60	           digit(oddDigit, noDigits)))))))))),
    61	         noValues)))) </output>
    62	
    63	  // For every integer N, the source expression constructs exactly the
    64	  // contract's sentence with N substituted at all four occurrences of "i".
    65	  claim [format-all-counts]:
    66	    <k> evaluate(
    67	      BinOp(
    68	        "+",
    69	        BinOp(
    70	          "+",
    71	          BinOp(
    72	            "+",
    73	            BinOp(
    74	              "+",
    75	              BinOp(
    76	                "+",
    77	                BinOp(
    78	                  "+",
    79	                  BinOp(
    80	                    "+",
    81	                    BinOp(
    82	                      "+",
    83	                      Str("the number of odd elements "),
    84	                      Call(Name("str"), Name("count"))),
    85	                    Str("n the str")),
    86	                  Call(Name("str"), Name("count"))),
    87	                Str("ng ")),
    88	              Call(Name("str"), Name("count"))),
    89	            Str(" of the ")),
    90	          Call(Name("str"), Name("count"))),
    91	        Str("nput.")),
    92	      store("count", pyInt(N), emptyEnv))
    93	        => pyString(message(N)) </k>
    94	
    95	  // These claims are the two universal character-step cases.  Together with
    96	  // digitValues(noDigits) => noValues, they exhaust valid digit strings.
    97	  claim [character-loop-base]:
    98	    <k> executeFor(noValues, "c", innerBody, REST, ENV)
    99	        => execute(REST, ENV) </k>
   100	
   101	  claim [even-character-step]:
   102	    <k> executeFor(
   103	      digitValues(digit(evenDigit, DS)), "c", innerBody, REST,
   104	      ENV)
   105	        => executeFor(
   106	         digitValues(DS), "c", innerBody, REST,
   107	         store("c", pyString(oneDigit(evenDigit)), ENV)) </k>
   108	
   109	  claim [odd-character-step]:
   110	    <k> executeFor(
   111	      digitValues(digit(oddDigit, DS)), "c", innerBody, REST,
   112	      ENV)
   113	        => executeFor(
   114	         digitValues(DS), "c", innerBody, REST,
   115	         store(
   116	           "count",
   117	           addValue(
   118	             evaluate(Name("count"),
   119	               store("c", pyString(oneDigit(oddDigit)), ENV)),
   120	             pyInt(1)),
   121	           store("c", pyString(oneDigit(oddDigit)), ENV))) </k>
   122	
   123	  // The list-loop base and the two append equations complete the structural
   124	  // cases used by the outer loop, for arbitrary values and continuations.
   125	  claim [list-loop-base]:
   126	    <k> executeFor(noValues, "s", outerBody, REST, ENV)
   127	        => execute(REST, ENV) </k>
   128	
   129	  claim [append-base]:
   130	    <k> appendValues(noValues, VS) => VS </k>
   131	
   132	  claim [append-step]:
   133	    <k> appendValues(value(V, VS), WS)
   134	        => value(V, appendValues(VS, WS)) </k>
   135	endmodule
     1	requires "verification.k"
     2	
     3	// Negative validation: the empty input must not produce a spurious item.
     4	module ODD-COUNT-MUTATION
     5	  imports ODD-COUNT-VERIFICATION
     6	
     7	  claim [wrong-empty-result]:
     8	    <k> solutionProgram => .K </k>
     9	    <input> pyList(noValues) </input>
    10	    <output>
    11	      noValue
    12	      => pyList(value(pyString(literal("incorrect")), noValues))
    13	    </output>
    14	endmodule
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Recreate the exact translator artifact and sanity-check the CPython program.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	python3 - <<'PY'
     9	from solution import odd_count
    10	
    11	assert odd_count(["1234567"]) == [
    12	    "the number of odd elements 4n the str4ng 4 of the 4nput."
    13	]
    14	assert odd_count(["3", "11111111"]) == [
    15	    "the number of odd elements 1n the str1ng 1 of the 1nput.",
    16	    "the number of odd elements 8n the str8ng 8 of the 8nput.",
    17	]
    18	PY
    19	
    20	# Compile the executable semantics and run the translated first prompt example.
    21	kompile semantic.k \
    22	  --main-module MPY \
    23	  --syntax-module MPY-SYNTAX \
    24	  --backend llvm \
    25	  -o semantic-kompiled
    26	
    27	krun solution.mpy \
    28	  -cINPUT='pyList(value(pyString(inputDigits(digit(oddDigit, digit(evenDigit, digit(oddDigit, digit(evenDigit, digit(oddDigit, digit(evenDigit, digit(oddDigit, noDigits))))))))), noValues))' \
    29	  --definition semantic-kompiled \
    30	  --output pretty
    31	
    32	# Compile the proof definition.  The KAST comparison guarantees that the
    33	# readable solutionProgram macro proved below is exactly solution.mpy.
    34	kompile verification.k \
    35	  --main-module ODD-COUNT-VERIFICATION \
    36	  --syntax-module MPY-SYNTAX \
    37	  --backend haskell \
    38	  -o verification-kompiled
    39	
    40	cmp \
    41	  <(kast solution.mpy \
    42	      --definition verification-kompiled \
    43	      --module MPY-SYNTAX \
    44	      --sort Module \
    45	      --expand-macros \
    46	      --output kore) \
    47	  <(kast \
    48	      --expression solutionProgram \
    49	      --definition verification-kompiled \
    50	      --module ODD-COUNT-VERIFICATION \
    51	      --sort Module \
    52	      --expand-macros \
    53	      --output kore)
    54	
    55	# The deliberately false claim must be rejected; this guards against a
    56	# vacuous proof harness.  Its expected non-zero result is handled explicitly.
    57	if kprove mutation.k \
    58	     --definition verification-kompiled \
    59	     --spec-module ODD-COUNT-MUTATION \
    60	     --output pretty; then
    61	  echo "error: mutation.k unexpectedly proved" >&2
    62	  exit 1
    63	else
    64	  echo "mutation.k rejected as expected"
    65	fi
    66	
    67	# Positive target proof: every claim in spec.k must close and print #Top.
    68	kprove spec.k \
    69	  --definition verification-kompiled \
    70	  --spec-module ODD-COUNT-SPEC \
    71	  --output pretty

diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..581b3fb547562495749ad205c09a730b2056fccc
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  echo "PWD: $(pwd)"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  echo
+  echo "BEGIN OUTPUT"
+} > "$log_file"
+
+"$@" >> "$log_file" 2>&1
+command_status=$?
+
+{
+  echo "END OUTPUT"
+  echo "EXIT STATUS: $command_status"
+} >> "$log_file"
+
+exit "$command_status"
diff --git a/evidence/stage1_generation_record_review.py b/evidence/stage1_generation_record_review.py
new file mode 100644
index 0000000000000000000000000000000000000000..bfad570618ff762ad198b54d7b83ea161ec44cea
--- /dev/null
+++ b/evidence/stage1_generation_record_review.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Read every generation trace/log record and emit a bounded audit summary."""
+
+from __future__ import annotations
+
+import json
+import re
+from collections import Counter
+from pathlib import Path
+
+
+trace_root = Path("/generation-evidence/codex-trace")
+trace_files = sorted(path for path in trace_root.rglob("*") if path.is_file())
+
+calls: dict[str, tuple[str, str]] = {}
+call_outputs: dict[str, str] = {}
+messages: list[tuple[str, str]] = []
+payload_counts: Counter[str] = Counter()
+
+for trace_file in trace_files:
+    with trace_file.open(encoding="utf-8") as stream:
+        for line in stream:
+            record = json.loads(line)
+            payload = record.get("payload")
+            if not isinstance(payload, dict):
+                continue
+            payload_type = str(payload.get("type"))
+            payload_counts[payload_type] += 1
+            if payload_type == "custom_tool_call":
+                calls[str(payload.get("call_id"))] = (
+                    str(payload.get("name")),
+                    str(payload.get("input")),
+                )
+            elif payload_type == "custom_tool_call_output":
+                output = payload.get("output")
+                call_outputs[str(payload.get("call_id"))] = json.dumps(
+                    output, sort_keys=True
+                )
+            elif payload_type in {"agent_message", "user_message"}:
+                messages.append((payload_type, str(payload.get("message"))))
+            elif payload_type == "message":
+                text_parts = []
+                for item in payload.get("content", []):
+                    if isinstance(item, dict) and "text" in item:
+                        text_parts.append(str(item["text"]))
+                messages.append((f"message:{payload.get('role')}", "\n".join(text_parts)))
+
+print(f"trace_files={len(trace_files)}")
+print(f"payload_counts={dict(sorted(payload_counts.items()))}")
+print(f"tool_calls={len(calls)} tool_outputs={len(call_outputs)}")
+print("TRACE MESSAGES")
+for index, (kind, message) in enumerate(messages, 1):
+    collapsed = re.sub(r"\s+", " ", message).strip()
+    print(f"{index:03d} {kind}: {collapsed[:1000]}")
+
+print("TRACE TOOL-CALL INVENTORY")
+for index, (call_id, (name, call_input)) in enumerate(calls.items(), 1):
+    output = call_outputs.get(call_id, "<missing>")
+    input_collapsed = re.sub(r"\s+", " ", call_input).strip()
+    output_collapsed = re.sub(r"\s+", " ", output).strip()
+    print(
+        f"{index:03d} {name} id={call_id} "
+        f"input={input_collapsed[:1600]} output={output_collapsed[:1000]}"
+    )
+
+log_path = Path("/generation-evidence/codex-output.log")
+patterns = {
+    "kprove": re.compile(rb"kprove", re.IGNORECASE),
+    "krun": re.compile(rb"\bkrun\b", re.IGNORECASE),
+    "kompile": re.compile(rb"kompile", re.IGNORECASE),
+    "top": re.compile(rb"#Top"),
+    "stuck": re.compile(rb"WarnStuckClaimState"),
+    "result_marker": re.compile(rb"KPROVE_PASSED"),
+    "error": re.compile(rb"\berror\b", re.IGNORECASE),
+}
+counts = Counter()
+selected: list[tuple[int, str]] = []
+with log_path.open("rb") as stream:
+    for line_number, line in enumerate(stream, 1):
+        matched = []
+        for name, pattern in patterns.items():
+            if pattern.search(line):
+                counts[name] += 1
+                matched.append(name)
+        if matched and len(selected) < 160:
+            text = line.decode("utf-8", errors="replace")
+            text = re.sub(r"\s+", " ", text).strip()
+            selected.append((line_number, text[:1200]))
+print(f"codex_output_pattern_counts={dict(sorted(counts.items()))}")
+print("CODEX OUTPUT SELECTED LINES (bounded)")
+for line_number, text in selected:
+    print(f"{line_number}: {text}")
+
+print("GENERATION_RECORD_REVIEW=COMPLETE")
