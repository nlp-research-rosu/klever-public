new file mode 100644
index 0000000000000000000000000000000000000000..581b3fb547562495749ad205c09a730b2056fccc
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  echo "PWD: $(pwd)"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  echo
+  echo "BEGIN OUTPUT"
+} > "$log_file"
+
+"$@" >> "$log_file" 2>&1
+command_status=$?
+
+{
+  echo "END OUTPUT"
+  echo "EXIT STATUS: $command_status"
+} >> "$log_file"
+
+exit "$command_status"
