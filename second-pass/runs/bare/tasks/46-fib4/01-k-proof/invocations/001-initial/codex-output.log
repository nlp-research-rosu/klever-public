+module VERIFICATION
+  imports INT
+
+  // Mathematical result of taking R rolling-window steps.  This is separate
+  // from the Python AST semantics: it is the functional specification used by
+  // the loop invariant.
+  syntax Int ::= "advanceD" "(" Int "," Int "," Int "," Int "," Int ")"
+                 [function, total]
+  rule advanceD(A, B, C, D, R) => D
+    requires R <=Int 0
+  rule advanceD(A, B, C, D, R)
+    => advanceD(B, C, D, A +Int B +Int C +Int D, R -Int 1)
+    requires R >Int 0
+
+  // The HumanEval recurrence, expressed by the rolling mathematical model.
+  // N - 3 is precisely the number of updates from the base window at indices
+  // 0..3 to the value at index N.
+  syntax Int ::= "fib4Spec" "(" Int ")" [function, total]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+  rule fib4Spec(N) => advanceD(0, 0, 2, 0, N -Int 3)
+    requires N >=Int 4
+endmodule

