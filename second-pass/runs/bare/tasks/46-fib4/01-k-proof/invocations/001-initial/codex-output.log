diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c754b7a785953fa28f7e4ce3ae925ea4daed3a6d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,28 @@
+module VERIFICATION
+  imports INT
+
+  // Mathematical Fib4, independent of the program state.  The recurrence is
+  // oriented toward smaller nonnegative arguments and is used in specs.
+  syntax Int ::= "fib4Spec" "(" Int ")" [function, total]
+  syntax Int ::= "loopIndex" "(" Int "," Int ")" [function, total]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+
+  // The invariant's newest window index is i-1 while another iteration is
+  // possible, and n at loop exit.  This conditional normal form lets K's
+  // simplifier expose the same final index without needing congruence over an
+  // opaque mathematical function.
+  rule loopIndex(I, N) => I -Int 1 requires I <=Int N
+  rule loopIndex(I, N) => N        requires I >Int N
+
+  // Contract a recurrence sum to its mathematical sequence value.  Keeping
+  // fib4Spec opaque in the other direction prevents symbolic expansion from
+  // diverging while proving a loop whose bound is symbolic.
+  rule fib4Spec(N -Int 4) +Int fib4Spec(N -Int 3)
+     +Int fib4Spec(N -Int 2) +Int fib4Spec(N -Int 1)
+    => fib4Spec(N)
+    requires N >=Int 4
+    [anywhere]
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module SEMANTIC-SYNTAX && kprove spec.k --definition semantic-kompiled --spec-module SPEC --claims SPEC.loop-correct' in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..667109c0637054fe1f5e72b0a1764b7c1cb97a33
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,118 @@
+requires "verification.k"
+
+module SEMANTIC-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= Module(Stmts)
+                   | "solutionProgram"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt  ::= FuncDef(String, Params, Stmts)
+                 | Return(Exp)
+                 | Assign(Exp, Exp)
+                 | If(Exp, Stmts, Stmts)
+                 | While(Exp, Stmts)
+
+  syntax Params ::= Params(String)
+
+  syntax Exp ::= Int(Int)
+               | Name(String)
+               | BinOp(String, Exp, Exp)
+               | Compare(Exp, CmpOp)
+  syntax CmpOp ::= CmpOp(String, Exp)
+endmodule
+
+module SEMANTIC
+  imports SEMANTIC-SYNTAX
+  imports VERIFICATION
+  imports MAP
+  imports BOOL
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+  syntax KItem ::= "exec" "(" Stmts ")"
+
+  configuration
+    <fib4>
+      <k> $PGM:Program </k>
+      <arg> $ARG:Int </arg>
+      <env> .Map </env>
+      <result> noResult </result>
+    </fib4>
+
+  // Exact constructor tree emitted by py2mpy.py for solution.py.  The proof
+  // claims use this name; concrete krun commands consume solution.mpy itself.
+  rule solutionProgram =>
+    Module(
+      FuncDef("fib4", Params("n"),
+        If(Compare(Name("n"), CmpOp("==", Int(0))),
+          Return(Int(0)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(1))),
+          Return(Int(0)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(2))),
+          Return(Int(2)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(3))),
+          Return(Int(0)), .Stmts)
+        Assign(Name("a"), Int(0))
+        Assign(Name("b"), Int(0))
+        Assign(Name("c"), Int(2))
+        Assign(Name("d"), Int(0))
+        Assign(Name("e"), Int(0))
+        Assign(Name("i"), Int(4))
+        While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+          Assign(Name("e"),
+            BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")),
+                                      Name("c")), Name("d")))
+          Assign(Name("a"), Name("b"))
+          Assign(Name("b"), Name("c"))
+          Assign(Name("c"), Name("d"))
+          Assign(Name("d"), Name("e"))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("d"))))
+
+  // The module contains one entry point.  Loading it binds its sole argument
+  // and schedules the function body.
+  rule <k> Module(FuncDef(_, Params(X), BODY)) => exec(BODY) ... </k>
+       <arg> N </arg>
+       <env> .Map => X |-> N </env>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+
+  rule <k> exec(Assign(Name(X), E) REST) => exec(REST) ... </k>
+       <env> M => M [ X <- evalInt(E, M) ] </env>
+
+  rule <k> exec(If(Compare(Name(X), CmpOp("==", Int(J))), THEN, _) REST)
+        => exec(THEN) ~> exec(REST) ... </k>
+       <env> (X |-> I) _ </env>
+    requires I ==Int J
+  rule <k> exec(If(Compare(Name(X), CmpOp("==", Int(J))), _, ELSE) REST)
+        => exec(ELSE) ~> exec(REST) ... </k>
+       <env> (X |-> I) _ </env>
+    requires I =/=Int J
+
+  rule <k> exec(While(Compare(Name(X), CmpOp("<=", Name(Y))), BODY) REST)
+        => exec(BODY)
+        ~> exec(While(Compare(Name(X), CmpOp("<=", Name(Y))), BODY) REST) ... </k>
+       <env> (X |-> I) (Y |-> J) _ </env>
+    requires I <=Int J
+  rule <k> exec(While(Compare(Name(X), CmpOp("<=", Name(Y))), _) REST)
+        => exec(REST) ... </k>
+       <env> (X |-> I) (Y |-> J) _ </env>
+    requires I >Int J
+
+  rule <k> exec(Return(E) REST) ~> _:K => .K </k>
+       <env> M </env>
+       <result> noResult => result(evalInt(E, M)) </result>
+
+  syntax Int ::= "evalInt" "(" Exp "," Map ")" [function, total]
+  rule evalInt(Int(I), _) => I
+  rule evalInt(Name(X), (X |-> I) M) => I
+  rule evalInt(BinOp("+", L, R), M) => evalInt(L, M) +Int evalInt(R, M)
+
+  syntax Bool ::= "evalBool" "(" Exp "," Map ")" [function, total]
+  rule evalBool(Compare(L, CmpOp("==", R)), M)
+    => evalInt(L, M) ==Int evalInt(R, M)
+  rule evalBool(Compare(L, CmpOp("<=", R)), M)
+    => evalInt(L, M) <=Int evalInt(R, M)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad034a7b2251c721bc55f32d17ad4f33cc78dd56
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,24 @@
+def fib4(n: int):
+    if n == 0:
+        return 0
+    if n == 1:
+        return 0
+    if n == 2:
+        return 2
+    if n == 3:
+        return 0
+
+    a = 0
+    b = 0
+    c = 2
+    d = 0
+    e = 0
+    i = 4
+    while i <= n:
+        e = a + b + c + d
+        a = b
+        b = c
+        c = d
+        d = e
+        i = i + 1
+    return d
