+             Return(Name("d")))
+      </k>
+      <arg> N </arg>
+      <env>
+        .Map
+        => "n" |-> N
+           "a" |-> 0
+           "b" |-> 0
+           "c" |-> 2
+           "d" |-> 0
+           "e" |-> 0
+           "i" |-> 4
+      </env>
+      <result> noResult </result>
+    </fib4>
+    requires N >=Int 4
+
+  claim [fib4-base-0]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 0 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(0)) </result>
+    </fib4>
+
+  claim [fib4-base-1]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 1 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(1)) </result>
+    </fib4>
+
+  claim [fib4-base-2]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 2 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(2)) </result>
+    </fib4>
+
+  claim [fib4-base-3]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 3 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(3)) </result>
+    </fib4>
+
+  claim [fib4-seven]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 7 </arg>
+      <env> .Map => ?FINAL:Map </env>
