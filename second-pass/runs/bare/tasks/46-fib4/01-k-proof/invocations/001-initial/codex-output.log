+
+  // Mathematical Fib4, independent of the program state.  The recurrence is
+  // oriented toward smaller nonnegative arguments and is used in specs.
+  syntax Int ::= "fib4Spec" "(" Int ")"
+  rule fib4Spec(0) => 0 [simplification]
+  rule fib4Spec(1) => 0 [simplification]
+  rule fib4Spec(2) => 2 [simplification]
+  rule fib4Spec(3) => 0 [simplification]
