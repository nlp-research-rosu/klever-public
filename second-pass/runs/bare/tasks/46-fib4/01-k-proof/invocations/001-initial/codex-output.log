+  imports MAP
+  imports BOOL
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+  syntax KItem ::= "exec" "(" Stmts ")"
+
+  configuration
+    <fib4>
+      <k> $PGM:Program </k>
+      <arg> $ARG:Int </arg>
+      <env> .Map </env>
+      <result> noResult </result>
+    </fib4>
+
+  // Exact constructor tree emitted by py2mpy.py for solution.py.  The proof
+  // claims use this name; concrete krun commands consume solution.mpy itself.
+  rule solutionProgram =>
+    Module(
+      FuncDef("fib4", Params("n"),
+        If(Compare(Name("n"), CmpOp("==", Int(0))),
+          Return(Int(0)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(1))),
+          Return(Int(0)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(2))),
+          Return(Int(2)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(3))),
+          Return(Int(0)), .Stmts)
+        Assign(Name("a"), Int(0))
+        Assign(Name("b"), Int(0))
+        Assign(Name("c"), Int(2))
+        Assign(Name("d"), Int(0))
+        Assign(Name("e"), Int(0))
+        Assign(Name("i"), Int(4))
+        While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+          Assign(Name("e"),
+            BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")),
+                                      Name("c")), Name("d")))
+          Assign(Name("a"), Name("b"))
+          Assign(Name("b"), Name("c"))
+          Assign(Name("c"), Name("d"))
+          Assign(Name("d"), Name("e"))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("d"))))
+
+  // The module contains one entry point.  Loading it binds its sole argument
+  // and schedules the function body.
+  rule <k> Module(FuncDef(_, Params(X), BODY)) => exec(BODY) ... </k>
+       <arg> N </arg>
+       <env> .Map => X |-> N </env>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+
+  rule <k> exec(Assign(Name(X), E) REST) => exec(REST) ... </k>
+       <env> M => M [ X <- evalInt(E, M) ] </env>
+
+  rule <k> exec(If(Compare(Name(X), CmpOp("==", Int(J))), THEN, _) REST)
+        => exec(THEN) ~> exec(REST) ... </k>
+       <env> (X |-> I) _ </env>
+    requires I ==Int J
+  rule <k> exec(If(Compare(Name(X), CmpOp("==", Int(J))), _, ELSE) REST)
+        => exec(ELSE) ~> exec(REST) ... </k>
+       <env> (X |-> I) _ </env>
+    requires I =/=Int J
+
+  rule <k> exec(While(Compare(Name(X), CmpOp("<=", Name(Y))), BODY) REST)
+        => exec(BODY)
+        ~> exec(While(Compare(Name(X), CmpOp("<=", Name(Y))), BODY) REST) ... </k>
+       <env> (X |-> I) (Y |-> J) _ </env>
+    requires I <=Int J
+  rule <k> exec(While(Compare(Name(X), CmpOp("<=", Name(Y))), _) REST)
+        => exec(REST) ... </k>
+       <env> (X |-> I) (Y |-> J) _ </env>
+    requires I >Int J
+
+  rule <k> exec(Return(E) _REST) ~> _:K => .K </k>
+       <env> M </env>
+       <result> noResult => result(evalInt(E, M)) </result>
+
+  syntax Int ::= "evalInt" "(" Exp "," Map ")" [function, total]
+  rule evalInt(Int(I), _) => I
+  rule evalInt(Name(X), (X |-> I) _M) => I
+  rule evalInt(BinOp("+", L, R), M) => evalInt(L, M) +Int evalInt(R, M)
+
+  syntax Bool ::= "evalBool" "(" Exp "," Map ")" [function, total]
+  rule evalBool(Compare(L, CmpOp("==", R)), M)
+    => evalInt(L, M) ==Int evalInt(R, M)
+  rule evalBool(Compare(L, CmpOp("<=", R)), M)
+    => evalInt(L, M) <=Int evalInt(R, M)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad034a7b2251c721bc55f32d17ad4f33cc78dd56
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,24 @@
+def fib4(n: int):
+    if n == 0:
+        return 0
+    if n == 1:
+        return 0
+    if n == 2:
+        return 2
+    if n == 3:
+        return 0
+
+    a = 0
+    b = 0
+    c = 2
+    d = 0
+    e = 0
+    i = 4
+    while i <= n:
+        e = a + b + c + d
+        a = b
+        b = c
+        c = d
+        d = e
+        i = i + 1
+    return d
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5a741d23c1cd05829bb3bd45454c4670ef868ac1
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,128 @@
+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+
+  // The recurrence model used below has this definitional form on n >= 4.
+  // This small claim makes the link used when composing initialization with
+  // loop-correct explicit in the proof suite.
+  claim [fib4-spec-link]:
+    <fib4>
+      <k> .K </k>
+      <arg> N </arg>
+      <env> _M:Map </env>
+      <result>
+        result(fib4Spec(N)) => result(advanceTo(0, 0, 2, 0, 4, N))
+      </result>
+    </fib4>
+    requires N >=Int 4
+
+  claim [loop-correct]:
+    <fib4>
+      <k>
+        exec(
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            Assign(Name("e"),
+              BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")),
+                                        Name("c")), Name("d")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("d"), Name("e"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("d")))
+        => .K
+      </k>
+      <arg> N </arg>
+      <env>
+          "n" |-> N
+          "a" |-> A
+          "b" |-> B
+          "c" |-> C
+          "d" |-> D
+          "e" |-> _E
+          "i" |-> I
+        => ?_FINAL:Map
+      </env>
+      <result>
+        noResult => result(advanceTo(A, B, C, D, I, N))
+      </result>
+    </fib4>
+    requires N >=Int 4 andBool I >=Int 4
+         andBool (I <=Int N orBool I ==Int N +Int 1)
+    [circularity]
+
+  // The finite initialization half of the n >= 4 proof.  Its target is exactly
+  // the A=0,B=0,C=2,D=0,I=4 instance of loop-correct above.  Thus these two
+  // reachability claims compose to result(fib4Spec(N)).
+  claim [fib4-inductive-init]:
+    <fib4>
+      <k>
+        solutionProgram
+        => exec(
+             While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+               Assign(Name("e"),
+                 BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")),
+                                           Name("c")), Name("d")))
+               Assign(Name("a"), Name("b"))
+               Assign(Name("b"), Name("c"))
+               Assign(Name("c"), Name("d"))
+               Assign(Name("d"), Name("e"))
+               Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+             Return(Name("d")))
+      </k>
+      <arg> N </arg>
+      <env>
+        .Map
+        => "n" |-> N
+           "a" |-> 0
+           "b" |-> 0
+           "c" |-> 2
+           "d" |-> 0
+           "e" |-> 0
+           "i" |-> 4
+      </env>
+      <result> noResult </result>
+    </fib4>
+    requires N >=Int 4
+
+  claim [fib4-base-0]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 0 </arg>
+      <env> .Map => ?_FINAL:Map </env>
+      <result> noResult => result(fib4Spec(0)) </result>
+    </fib4>
+
+  claim [fib4-base-1]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 1 </arg>
+      <env> .Map => ?_FINAL:Map </env>
+      <result> noResult => result(fib4Spec(1)) </result>
+    </fib4>
+
+  claim [fib4-base-2]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 2 </arg>
+      <env> .Map => ?_FINAL:Map </env>
+      <result> noResult => result(fib4Spec(2)) </result>
+    </fib4>
+
+  claim [fib4-base-3]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 3 </arg>
+      <env> .Map => ?_FINAL:Map </env>
+      <result> noResult => result(fib4Spec(3)) </result>
+    </fib4>
+
+  claim [fib4-seven]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 7 </arg>
+      <env> .Map => ?_FINAL:Map </env>
+      <result> noResult => result(14) </result>
+    </fib4>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..982a7c2a5c49fcf5532222bfab7702ad43d34111
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,24 @@
+module VERIFICATION
+  imports INT
+
+  // Mathematical result of rolling the window from loop index I through N.
+  // This is separate from the Python AST semantics: it is the functional
+  // specification used by the loop invariant.
+  syntax Int ::= "advanceTo" "(" Int "," Int "," Int "," Int "," Int "," Int ")"
+                 [function, total]
+  rule advanceTo(_A, _B, _C, D, I, N) => D
+    requires I >Int N
+  rule advanceTo(A, B, C, D, I, N)
+    => advanceTo(B, C, D, A +Int B +Int C +Int D, I +Int 1, N)
+    requires I <=Int N
+
+  // The HumanEval recurrence, expressed by the rolling mathematical model.
+  // Index 4 is the first update from the base window at indices 0..3.
+  syntax Int ::= "fib4Spec" "(" Int ")" [function, total]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+  rule fib4Spec(N) => advanceTo(0, 0, 2, 0, 4, N)
+    requires N >=Int 4
+endmodule

