new file mode 100644
index 0000000000000000000000000000000000000000..1c0ea36cf18eadb2e7d8ab170e83a9b68268510f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,28 @@
+module VERIFICATION
+  imports INT
+
+  // Mathematical Fib4, independent of the program state.  The recurrence is
+  // oriented toward smaller nonnegative arguments and is used in specs.
+  syntax Int ::= "fib4Spec" "(" Int ")" [function, total]
+  syntax Int ::= "loopIndex" "(" Int "," Int ")" [function, total]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+
+  // The invariant's newest window index is i-1 while another iteration is
+  // possible, and n at loop exit.  This conditional normal form lets K's
+  // simplifier expose the same final index without needing congruence over an
+  // opaque mathematical function.
+  rule loopIndex(I, N) => I -Int 1 requires I <=Int N
+  rule loopIndex(I, N) => N        requires I >Int N
+
+  // Contract a recurrence sum to its mathematical sequence value.  Keeping
+  // fib4Spec opaque in the other direction prevents symbolic expansion from
+  // diverging while proving a loop whose bound is symbolic.
+  rule fib4Spec(N -Int 4) +Int fib4Spec(N -Int 3)
+     +Int fib4Spec(N -Int 2) +Int fib4Spec(N -Int 1)
+    => fib4Spec(N)
+    requires N >=Int 4
+    [simplification]
+endmodule

