new file mode 100644
index 0000000000000000000000000000000000000000..a486a09f777a6f3b28b162e449cfd27e2800497e
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,85 @@
+requires "verification.k"
+
+module SEMANTIC-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= Module(Stmts)
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt  ::= FuncDef(String, Params, Stmts)
+                 | Return(Exp)
+                 | Assign(Exp, Exp)
+                 | If(Exp, Stmts, Stmts)
+                 | While(Exp, Stmts)
+
+  syntax Params ::= Params(String)
+
+  syntax Exp ::= Int(Int)
+               | Name(String)
+               | BinOp(String, Exp, Exp)
+               | Compare(Exp, CmpOp)
+  syntax CmpOp ::= CmpOp(String, Exp)
+endmodule
+
+module SEMANTIC
+  imports SEMANTIC-SYNTAX
+  imports VERIFICATION
+  imports MAP
+  imports BOOL
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
+  configuration
+    <fib4>
+      <k> $PGM:Program </k>
+      <arg> $ARG:Int </arg>
+      <env> .Map </env>
+      <result> noResult </result>
+    </fib4>
+
+  // The module contains one entry point.  Loading it binds its sole argument
+  // and schedules the function body.
+  rule <k> Module(FuncDef(_, Params(X), BODY)) => BODY ... </k>
+       <arg> N </arg>
+       <env> .Map => X |-> N </env>
+
+  // Statement lists are syntax, so expose one statement at a time to <k>.
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
+  rule <k> .Stmts => . ... </k>
+
+  rule <k> Assign(Name(X), E) => . ... </k>
+       <env> M => M [ X <- evalInt(E, M) ] </env>
+
+  rule <k> If(Compare(Name(X), CmpOp("==", Int(J))), THEN, _) => THEN ... </k>
+       <env> (X |-> I) _ </env>
+    requires I ==Int J
+  rule <k> If(Compare(Name(X), CmpOp("==", Int(J))), _, ELSE) => ELSE ... </k>
+       <env> (X |-> I) _ </env>
+    requires I =/=Int J
+  rule <k> If(Compare(Name(_), CmpOp("==", Int(_))), THEN, _) => THEN ... </k>
+
+  rule <k> While(Compare(Name(X), CmpOp("<=", Name(Y))), BODY)
+        => BODY ~> While(Compare(Name(X), CmpOp("<=", Name(Y))), BODY) ... </k>
+       <env> (X |-> I) (Y |-> J) _ </env>
+    requires I <=Int J
+  rule <k> While(Compare(Name(X), CmpOp("<=", Name(Y))), _) => . ... </k>
+       <env> (X |-> I) (Y |-> J) _ </env>
+    requires I >Int J
+
+  rule <k> Return(E) ~> _:K => .K </k>
+       <env> M </env>
+       <result> noResult => result(evalInt(E, M)) </result>
+
+  syntax Int ::= "evalInt" "(" Exp "," Map ")" [function, total]
+  rule evalInt(Int(I), _) => I
+  rule evalInt(Name(X), (X |-> I) M) => I
+  rule evalInt(BinOp("+", L, R), M) => evalInt(L, M) +Int evalInt(R, M)
+
+  syntax Bool ::= "evalBool" "(" Exp "," Map ")" [function, total]
+  rule evalBool(Compare(L, CmpOp("==", R)), M)
+    => evalInt(L, M) ==Int evalInt(R, M)
+  rule evalBool(Compare(L, CmpOp("<=", R)), M)
+    => evalInt(L, M) <=Int evalInt(R, M)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..dfcbabecb7a7b5a23ac46377803e2b60cb4c3a41
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,23 @@
+def fib4(n: int):
+    if n == 0:
+        return 0
+    if n == 1:
+        return 0
+    if n == 2:
+        return 2
+    if n == 3:
+        return 0
+
+    a = 0
+    b = 0
+    c = 2
+    d = 0
+    i = 4
+    while i <= n:
+        e = a + b + c + d
+        a = b
+        b = c
+        c = d
+        d = e
+        i = i + 1
+    return d
