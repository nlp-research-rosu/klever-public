+                 | Return(Exp)
+                 | Assign(Exp, Exp)
+                 | If(Exp, Stmts, Stmts)
+                 | While(Exp, Stmts)
+
+  syntax Params ::= Params(String)
+
+  syntax Exp ::= Int(Int)
+               | Name(String)
+               | BinOp(String, Exp, Exp)
+               | Compare(Exp, CmpOp)
+  syntax CmpOp ::= CmpOp(String, Exp)
+endmodule
+
