+module VERIFICATION
+  imports INT
+
+  // Mathematical Fib4, independent of the program state.  The recurrence is
+  // oriented toward smaller nonnegative arguments and is used in specs.
+  syntax Int ::= fib4Spec(Int) [function]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+  rule fib4Spec(N) => fib4Spec(N -Int 1) +Int fib4Spec(N -Int 2)
+                    +Int fib4Spec(N -Int 3) +Int fib4Spec(N -Int 4)
+    requires N >=Int 4
+endmodule

