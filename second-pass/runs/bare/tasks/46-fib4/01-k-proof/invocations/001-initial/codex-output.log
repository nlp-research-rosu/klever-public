new file mode 100644
index 0000000000000000000000000000000000000000..2fb8feedab58ecd69c026bce54b05d1b078a0eb6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,92 @@
+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+
+  claim [loop-correct]:
+    <fib4>
+      <k>
+        exec(
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            Assign(Name("e"),
+              BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")),
+                                        Name("c")), Name("d")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("d"), Name("e"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("d")))
+        => .K
+      </k>
+      <arg> N </arg>
+      <env>
+          "n" |-> N
+          "a" |-> A
+          "b" |-> B
+          "c" |-> C
+          "d" |-> D
+          "e" |-> E
+          "i" |-> I
+        => ?FINAL:Map
+      </env>
+      <result>
+        noResult => result(advanceTo(A, B, C, D, I, N))
+      </result>
+    </fib4>
+    requires N >=Int 4 andBool I >=Int 4
+         andBool (I <=Int N orBool I ==Int N +Int 1)
+    [circularity]
+
+  // The unbounded part of the input domain.  Together with the four base
+  // claims below, this covers every nonnegative integer.  prove.sh reuses the
+  // separately proved loop circularity as a lemma for this target.
+  claim [fib4-inductive]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> N </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(N)) </result>
+    </fib4>
+    requires N >=Int 4
+
+  claim [fib4-base-0]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 0 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(0)) </result>
+    </fib4>
+
+  claim [fib4-base-1]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 1 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(1)) </result>
+    </fib4>
+
+  claim [fib4-base-2]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 2 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(2)) </result>
+    </fib4>
+
+  claim [fib4-base-3]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 3 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(3)) </result>
+    </fib4>
+
+  claim [fib4-seven]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 7 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(14) </result>
+    </fib4>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ced855af87eba38c3ea6d280a936987bfdae27f2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,24 @@
+module VERIFICATION
+  imports INT
+
+  // Mathematical result of rolling the window from loop index I through N.
+  // This is separate from the Python AST semantics: it is the functional
+  // specification used by the loop invariant.
+  syntax Int ::= "advanceTo" "(" Int "," Int "," Int "," Int "," Int "," Int ")"
+                 [function, total]
+  rule advanceTo(A, B, C, D, I, N) => D
+    requires I >Int N
+  rule advanceTo(A, B, C, D, I, N)
+    => advanceTo(B, C, D, A +Int B +Int C +Int D, I +Int 1, N)
+    requires I <=Int N
+
+  // The HumanEval recurrence, expressed by the rolling mathematical model.
+  // Index 4 is the first update from the base window at indices 0..3.
+  syntax Int ::= "fib4Spec" "(" Int ")" [function, total]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+  rule fib4Spec(N) => advanceTo(0, 0, 2, 0, 4, N)
+    requires N >=Int 4
+endmodule

apply patch
