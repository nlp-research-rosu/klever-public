+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+
+  claim [loop-correct]:
+    <fib4>
+      <k>
+        exec(
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            Assign(Name("e"),
+              BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")),
+                                        Name("c")), Name("d")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("d"), Name("e"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("d")))
+        => .K
+      </k>
+      <arg> N </arg>
+      <env>
+          "n" |-> N
+          "a" |-> fib4Spec(I -Int 4)
+          "b" |-> fib4Spec(I -Int 3)
+          "c" |-> fib4Spec(I -Int 2)
+          "d" |-> fib4Spec(I -Int 1)
+          "e" |-> E
+          "i" |-> I
+        => ?FINAL:Map
+      </env>
+      <result> noResult => result(fib4Spec(N)) </result>
+    </fib4>
+    requires N >=Int 4 andBool I >=Int 4 andBool I <=Int N +Int 1
+    [circularity]
+
+  claim [fib4-seven]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 7 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(14) </result>
+    </fib4>
+endmodule
