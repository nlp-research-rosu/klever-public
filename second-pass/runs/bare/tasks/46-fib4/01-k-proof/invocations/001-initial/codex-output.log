diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f60597848f63812dbec3d17e64579db9cdda8442
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+
+  // This macro is the exact constructor tree emitted in solution.mpy.  Keeping
+  // it as a Program term lets reachability claims start from the translated
+  // artifact, rather than from a handwritten pseudo-command.
+  syntax Program ::= "solutionProgram"
+  rule solutionProgram =>
+    Module(
+      FuncDef("fib4", Params("n"),
+        If(Compare(Name("n"), CmpOp("==", Int(0))),
+          Return(Int(0)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(1))),
+          Return(Int(0)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(2))),
+          Return(Int(2)), .Stmts)
+        If(Compare(Name("n"), CmpOp("==", Int(3))),
+          Return(Int(0)), .Stmts)
+        Assign(Name("a"), Int(0))
+        Assign(Name("b"), Int(0))
+        Assign(Name("c"), Int(2))
+        Assign(Name("d"), Int(0))
+        Assign(Name("i"), Int(4))
+        While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+          Assign(Name("e"),
+            BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")),
+                                      Name("c")), Name("d")))
+          Assign(Name("a"), Name("b"))
+          Assign(Name("b"), Name("c"))
+          Assign(Name("c"), Name("d"))
+          Assign(Name("d"), Name("e"))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("d"))))
+    [macro]
+
+  claim [fib4-seven]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 7 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(14) </result>
+    </fib4>
+endmodule
