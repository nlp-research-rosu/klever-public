+  rule evalBool(Compare(L, CmpOp("==", R)), M)
+    => evalInt(L, M) ==Int evalInt(R, M)
+  rule evalBool(Compare(L, CmpOp("<=", R)), M)
+    => evalInt(L, M) <=Int evalInt(R, M)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad034a7b2251c721bc55f32d17ad4f33cc78dd56
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,24 @@
+def fib4(n: int):
+    if n == 0:
+        return 0
+    if n == 1:
+        return 0
+    if n == 2:
+        return 2
+    if n == 3:
+        return 0
+
+    a = 0
+    b = 0
+    c = 2
+    d = 0
+    e = 0
+    i = 4
+    while i <= n:
+        e = a + b + c + d
+        a = b
+        b = c
+        c = d
+        d = e
+        i = i + 1
+    return d
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6187350a8dfcbaebdeeae53b52c889909b0a856
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+
+  claim [loop-correct]:
+    <fib4>
+      <k>
+        exec(
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            Assign(Name("e"),
+              BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")),
+                                        Name("c")), Name("d")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("d"), Name("e"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("d")))
+        => .K
+      </k>
+      <arg> N </arg>
+      <env>
+          "n" |-> N
+          "a" |-> fib4Spec(I -Int 4)
+          "b" |-> fib4Spec(I -Int 3)
+          "c" |-> fib4Spec(I -Int 2)
+          "d" |-> fib4Spec(I -Int 1)
+          "e" |-> E
+          "i" |-> I
+        => ?FINAL:Map
+      </env>
+      <result> noResult => result(fib4Spec(N)) </result>
+    </fib4>
+    requires N >=Int 4 andBool I >=Int 4 andBool I <=Int N +Int 1
+    [circularity]
+
+  claim [fib4-seven]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 7 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(14) </result>
+    </fib4>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d6604a3af1f09d02a29f7156d5b3e62b889e001b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,20 @@
+module VERIFICATION
+  imports INT
+
+  // Mathematical Fib4, independent of the program state.  The recurrence is
+  // oriented toward smaller nonnegative arguments and is used in specs.
+  syntax Int ::= "fib4Spec" "(" Int ")" [function, total]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+
+  // Contract a recurrence sum to its mathematical sequence value.  Keeping
+  // fib4Spec opaque in the other direction prevents symbolic expansion from
+  // diverging while proving a loop whose bound is symbolic.
+  rule fib4Spec(N -Int 4) +Int fib4Spec(N -Int 3)
+     +Int fib4Spec(N -Int 2) +Int fib4Spec(N -Int 1)
+    => fib4Spec(N)
+    requires N >=Int 4
+    [simplification]
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module SEMANTIC-SYNTAX && kprove spec.k --definition semantic-kompiled --spec-module SPEC --claims SPEC.loop-correct' in /work
