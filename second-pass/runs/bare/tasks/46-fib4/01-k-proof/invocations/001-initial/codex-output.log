+requires "verification.k"
+
+module SEMANTIC-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= Module(Stmts)
+                   | "solutionProgram"
