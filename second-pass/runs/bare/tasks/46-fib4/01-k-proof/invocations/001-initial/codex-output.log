+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(N)) </result>
+    </fib4>
+    requires N >=Int 4
+
+  claim [fib4-base-0]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 0 </arg>
+      <env> .Map => ?FINAL:Map </env>
+      <result> noResult => result(fib4Spec(0)) </result>
+    </fib4>
