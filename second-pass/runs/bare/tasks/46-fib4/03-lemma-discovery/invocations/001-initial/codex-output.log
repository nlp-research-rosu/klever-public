import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
output = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert list(output) == ['schema_version', 'inventory_sha256', 'rules']
assert output['schema_version'] == 2
assert output['inventory_sha256'] == inventory['inventory_sha256']
assert len(output['rules']) == len(inventory['rules'])
assert [r['source_rule_id'] for r in output['rules']] == [r['source_rule_id'] for r in inventory['rules']]
assert len({r['source_rule_id'] for r in output['rules']}) == len(output['rules'])

by_id = {r['source_rule_id']: r for r in inventory['rules']}
for entry in output['rules']:
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
    attrs = by_id[entry['source_rule_id']]['attributes']
    if 'simplification' in attrs:
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

text = Path('/workspace/DISCOVERY.md').read_text()
assert 'domain-lemma set is empty' in text.lower()
assert 'no "'`proved_derived_lemma` entries'"' in text.lower()
print(f\"validated schema v{output['schema_version']}: {len(output['rules'])} rules, exact order and coverage\")
print('classifications:', {c: sum(r['classification'] == c for r in output['rules']) for c in sorted(allowed)})
PY
