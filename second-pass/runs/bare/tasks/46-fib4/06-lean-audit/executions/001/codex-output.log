   179	def sha256_file(path: Path) -> str:
   180	    digest = hashlib.sha256()
   181	    try:
   182	        with path.open("rb") as stream:
   183	            for chunk in iter(lambda: stream.read(_HASH_CHUNK_SIZE), b""):
   184	                digest.update(chunk)
   185	    except OSError as error:
   186	        raise PipelineContractError(f"cannot hash file {path}: {error}") from error
   187	    return digest.hexdigest()
