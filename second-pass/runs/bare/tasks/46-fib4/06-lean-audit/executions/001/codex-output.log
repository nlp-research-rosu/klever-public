   190	def sha256_tree(root: Path) -> str:
   191	    root = require_real_directory(root, "tree root")
   192	    digest = hashlib.sha256()
   193	    pending = [root]
   194	    entries: list[tuple[str, str, Path]] = []
   195	    while pending:
   196	        directory = pending.pop()
   197	        try:
   198	            children = list(os.scandir(directory))
   199	        except OSError as error:
   200	            raise PipelineContractError(f"cannot scan tree {directory}: {error}") from error
   201	        for child in children:
   202	            path = Path(child.path)
   203	            try:
   204	                mode = child.stat(follow_symlinks=False).st_mode
   205	            except OSError as error:
   206	                raise PipelineContractError(
   207	                    f"cannot inspect tree entry {path}: {error}"
   208	                ) from error
   209	            relative = path.relative_to(root).as_posix()
   210	            if stat.S_ISDIR(mode):
   211	                entries.append((relative, "directory", path))
   212	                pending.append(path)
   213	            elif stat.S_ISREG(mode):
   214	                entries.append((relative, "file", path))
   215	            else:
   216	                raise PipelineContractError(
   217	                    f"tree contains linked or unsupported entry: {path}"
   218	                )
   219	    for relative, kind, path in sorted(entries):
   220	        encoded = relative.encode()
   221	        digest.update(len(encoded).to_bytes(4, "big"))
   222	        digest.update(encoded)
   223	        digest.update(kind.encode() + b"\0")
   224	        if kind == "file":
   225	            try:
   226	                size = path.stat(follow_symlinks=False).st_size
   227	                digest.update(size.to_bytes(8, "big"))
   228	                with path.open("rb") as stream:
   229	                    for chunk in iter(lambda: stream.read(_HASH_CHUNK_SIZE), b""):
   230	                        digest.update(chunk)
   231	            except OSError as error:
   232	                raise PipelineContractError(
   233	                    f"cannot hash tree file {path}: {error}"
   234	                ) from error
   235	    return digest.hexdigest()
