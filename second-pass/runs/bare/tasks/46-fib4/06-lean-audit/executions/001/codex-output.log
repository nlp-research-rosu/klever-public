diff --git a//tmp/audit-work/lean_proc_self_shim.c b//tmp/audit-work/lean_proc_self_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..d793decb4d88818e054ab9aae26e1dffae03b371
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_shim.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    size_t length;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (path != NULL) {
+        length = strlen(path);
+        if (
+            length > sizeof(prefix) - 1 + sizeof(suffix) - 1
+            && strncmp(path, prefix, sizeof(prefix) - 1) == 0
+            && strcmp(path + length - (sizeof(suffix) - 1), suffix) == 0
+        ) {
+            return real_readlink("/proc/self/exe", buffer, size);
+        }
+    }
+    return real_readlink(path, buffer, size);
+}
