diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..2c3e93a81f1c4e43af706bbc331ea454d0470f24
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,15 @@
+requires "semantic.k"
+
+module SPEC-VACUITY
+  imports SEMANTIC
+
+  // Fresh audit mutation: fib4(7) is 14, so requiring 15 is meaningful,
+  // reachable, result-constraining, and false.
+  claim [false-fib4-seven]:
+    <fib4>
+      <k> solutionProgram => .K </k>
+      <arg> 7 </arg>
+      <env> .Map => ?_FINAL:Map </env>
+      <result> noResult => result(15) </result>
+    </fib4>
+endmodule

