const patch = "*** Begin Patch\n*** Delete File: /work/verification.k\n*** Add File: /work/verification.k\n+module VERIFICATION\n+  imports INT\n+\n+  // Mathematical result of taking R rolling-window steps.  This is separate\n+  // from the Python AST semantics: it is the functional specification used by\n+  // the loop invariant.\n+  syntax Int ::= \"advanceD\" \"(\" Int \",\" Int \",\" Int \",\" Int \",\" Int \")\"\n+                 [function, total]\n+  rule advanceD(A, B, C, D, R) => D\n+    requires R <=Int 0\n+  rule advanceD(A, B, C, D, R)\n+    => advanceD(B, C, D, A +Int B +Int C +Int D, R -Int 1)\n+    requires R >Int 0\n+\n+  // The HumanEval recurrence, expressed by the rolling mathematical model.\n+  // N - 3 is precisely the number of updates from the base window at indices\n+  // 0..3 to the value at index N.\n+  syntax Int ::= \"fib4Spec\" \"(\" Int \")\" [function, total]\n+  rule fib4Spec(0) => 0\n+  rule fib4Spec(1) => 0\n+  rule fib4Spec(2) => 2\n+  rule fib4Spec(3) => 0\n+  rule fib4Spec(N) => advanceD(0, 0, 2, 0, N -Int 3)\n+    requires N >=Int 4\n+endmodule\n*** Update File: /work/spec.k\n@@\n       <arg> N </arg>\n       <env>\n           \"n\" |-> N\n-          \"a\" |-> fib4Spec(I -Int 4)\n-          \"b\" |-> fib4Spec(I -Int 3)\n-          \"c\" |-> fib4Spec(I -Int 2)\n-          \"d\" |-> fib4Spec(loopIndex(I, N))\n+          \"a\" |-> A\n+          \"b\" |-> B\n+          \"c\" |-> C\n+          \"d\" |-> D\n           \"e\" |-> E\n           \"i\" |-> I\n         => ?FINAL:Map\n       </env>\n-      <result> noResult => result(fib4Spec(N)) </result>\n+      <result>\n+        noResult => result(advanceD(A, B, C, D, N -Int I +Int 1))\n+      </result>\n*** End Patch";
text(await tools.apply_patch(patch));
const r = await tools.exec_command({cmd:"kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module SEMANTIC-SYNTAX && kprove spec.k --definition semantic-kompiled --spec-module SPEC --claims SPEC.loop-correct","workdir":"/work","yield_time_ms":30000,"max_output_tokens":30000});
