const patch = "*** Begin Patch\n*** Add File: /work/semantic.k\n+requires \"verification.k\"\n+\n+module SEMANTIC-SYNTAX\n+  imports INT-SYNTAX\n+  imports BOOL-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  syntax Program ::= Module(Stmts)\n+\n+  syntax Stmts ::= List{Stmt, \"\"}\n+  syntax Stmt  ::= FuncDef(String, Params, Stmts)\n+                 | Return(Exp)\n+                 | Assign(Exp, Exp)\n+                 | If(Exp, Stmts, Stmts)\n+                 | While(Exp, Stmts)\n+\n+  syntax Params ::= Params(String)\n+\n+  syntax Exp ::= Int(Int)\n+               | Name(String)\n+               | BinOp(String, Exp, Exp)\n+               | Compare(Exp, CmpOp)\n+  syntax CmpOp ::= CmpOp(String, Exp)\n+endmodule\n+\n+module SEMANTIC\n+  imports SEMANTIC-SYNTAX\n+  imports VERIFICATION\n+  imports MAP\n+\n+  syntax Result ::= noResult | result(Int)\n+\n+  configuration\n+    <fib4>\n+      <k> $PGM:Program </k>\n+      <arg> $ARG:Int </arg>\n+      <env> .Map </env>\n+      <result> noResult </result>\n+    </fib4>\n+\n+  // The module contains one entry point.  Loading it binds its sole argument\n+  // and schedules the function body.\n+  rule <k> Module(FuncDef(_, Params(X), BODY)) => BODY ... </k>\n+       <arg> N </arg>\n+       <env> .Map => X |-> N </env>\n+\n+  // Statement lists are syntax, so expose one statement at a time to <k>.\n+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>\n+  rule <k> .Stmts => . ... </k>\n+\n+  rule <k> Assign(Name(X), E) => . ... </k>\n+       <env> M => M [ X <- evalInt(E, M) ] </env>\n+\n+  rule <k> If(C, THEN, _) => THEN ... </k>\n+       <env> M </env>\n+    requires evalBool(C, M)\n+  rule <k> If(C, _, ELSE) => ELSE ... </k>\n+       <env> M </env>\n+    requires notBool evalBool(C, M)\n+\n+  rule <k> While(C, BODY) => BODY ~> While(C, BODY) ... </k>\n+       <env> M </env>\n+    requires evalBool(C, M)\n+  rule <k> While(C, _) => . ... </k>\n+       <env> M </env>\n+    requires notBool evalBool(C, M)\n+\n+  rule <k> Return(E) ~> _:K => .K </k>\n+       <env> M </env>\n+       <result> noResult => result(evalInt(E, M)) </result>\n+\n+  syntax Int ::= evalInt(Exp, Map) [function, total]\n+  rule evalInt(Int(I), _) => I\n+  rule evalInt(Name(X), M) => {M[X]}:>Int\n+  rule evalInt(BinOp(\"+\", L, R), M) => evalInt(L, M) +Int evalInt(R, M)\n+\n+  syntax Bool ::= evalBool(Exp, Map) [function, total]\n+  rule evalBool(Compare(L, CmpOp(\"==\", R)), M)\n+    => evalInt(L, M) ==Int evalInt(R, M)\n+  rule evalBool(Compare(L, CmpOp(\"<=\", R)), M)\n+    => evalInt(L, M) <=Int evalInt(R, M)\n+endmodule\n*** Add File: /work/verification.k\n+module VERIFICATION\n+  imports INT\n+\n+  // Mathematical Fib4, independent of the program state.  The recurrence is\n+  // oriented toward smaller nonnegative arguments and is used in specs.\n+  syntax Int ::= fib4Spec(Int) [function]\n+  rule fib4Spec(0) => 0\n+  rule fib4Spec(1) => 0\n+  rule fib4Spec(2) => 2\n+  rule fib4Spec(3) => 0\n+  rule fib4Spec(N) => fib4Spec(N -Int 1) +Int fib4Spec(N -Int 2)\n+                    +Int fib4Spec(N -Int 3) +Int fib4Spec(N -Int 4)\n+    requires N >=Int 4\n+endmodule\n*** End Patch";
text(await tools.apply_patch(patch));
const r = await tools.exec_command({cmd:"kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module SEMANTIC-SYNTAX","workdir":"/work","yield_time_ms":30000,"max_output_tokens":30000});
text(r);


