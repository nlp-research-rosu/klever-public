root=pathlib.Path(\"/candidate\"); entries=[]
for p in root.rglob(\"*\"):
 rel=p.relative_to(root).as_posix(); kind=\"directory\" if p.is_dir() else \"file\"; entries.append((rel,kind,p))
target=\"83afbca84a509e4a1c51bbbf4ebc20318b75b66a5998ddfea6212ffea6545e72\"
def h(es):
 d=hashlib.sha256()
 for rel,kind,p in sorted(es):
  d.update(rel.encode()+b\"\\0\"+kind.encode()+b\"\\0\")
  if kind==\"file\":d.update(p.read_bytes())
 return d.hexdigest()
for mask in range(1<<len(entries)):
 if len(entries)>20:break
 es=[e for i,e in enumerate(entries) if mask>>i&1]
 if h(es)==target: print(\"MATCH\",[e[0] for e in es])
print(\"count\",len(entries),\"all\",h(entries))'" in /audit-output
