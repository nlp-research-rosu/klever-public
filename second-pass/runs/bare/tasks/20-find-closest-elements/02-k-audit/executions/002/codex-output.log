     4	def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:
     5	    closest_a = numbers[0]
     6	    closest_b = numbers[1]
     7	    if closest_b < closest_a:
     8	        temporary = closest_a
     9	        closest_a = closest_b
    10	        closest_b = temporary
    11	    best_gap = closest_b - closest_a
    12	    i = 0
    13	    while i < len(numbers):
    14	        j = i + 1
    15	        while j < len(numbers):
    16	            a = numbers[i]
    17	            b = numbers[j]
    18	            if b < a:
    19	                temporary = a
    20	                a = b
    21	                b = temporary
    22	            gap = b - a
    23	            if gap < best_gap:
    24	                best_gap = gap
    25	                closest_a = a
    26	                closest_b = b
    27	            j = j + 1
    28	        i = i + 1
    29	    return (closest_a, closest_b)
