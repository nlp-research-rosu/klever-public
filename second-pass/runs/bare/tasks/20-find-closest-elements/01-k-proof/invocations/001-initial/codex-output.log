+                | "Subscript" "(" Expr "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "TupleExpr" "(" Expr "," Expr ")"
