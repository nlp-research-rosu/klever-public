+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports RAT
+  imports MAP
+
+  syntax Result ::= "noResult" | Value
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+  configuration
+    <mpy>
+      <k> $PGM:Input </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </mpy>
+
+  // Control items.
+  syntax KItem ::= exec(Stmts)
+                 | invoke(String, Value)
+                 | bindAndExec(String, Stmts, Value)
+                 | eval(Expr)
