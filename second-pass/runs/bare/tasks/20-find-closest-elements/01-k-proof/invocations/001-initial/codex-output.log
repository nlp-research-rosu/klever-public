+  rule valueLess(vfloat(F), vfloat(G)) => F <Float G
+  rule valueLess(vint(I), vfloat(F)) => Int2Float(I, 53, 11) <Float F
+  rule valueLess(vfloat(F), vint(I)) => F <Float Int2Float(I, 53, 11)
