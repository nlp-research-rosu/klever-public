+requires "rat.md"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports RAT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor grammar emitted by py2mpy.py for solution.py.
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" String ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "TupleExpr" "(" Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  // Runtime values. Lists are explicit cons lists so that symbolic lookup and
+  // length are defined by this semantics, rather than delegated to a host.
+  syntax Value ::= "vint" "(" Int ")"
+                 | "vnum" "(" Rat ")"
+                 | "vbool" "(" Bool ")"
+                 | "vnil"
+                 | "vlist" "(" Value "," Value ")"
+                 | "vtuple" "(" Value "," Value ")"
+
+  syntax Input ::= Program
+                 | "run" "(" Program "," Value ")"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports RAT
+  imports MAP
+
+  syntax Result ::= "noResult" | Value
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+  configuration
+    <mpy>
+      <k> $PGM:Input </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </mpy>
+
+  // Control items.
+  syntax KItem ::= exec(Stmts)
+                 | invoke(String, Value)
+                 | bindAndExec(String, Stmts, Value)
+                 | eval(Expr)
+                 | assignTo(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Value)
+                 | subscriptLeft(Expr)
+                 | subscriptRight(Value)
+                 | compareLeft(String, Expr)
+                 | compareRight(String, Value)
+                 | callOne(Value)
+                 | tupleLeft(Expr)
+                 | tupleRight(Value)
+                 | choose(Stmts, Stmts)
+                 | whileChoose(Expr, Stmts)
+                 | "finishReturn"
+
+  // Pure helpers implementing the relevant Python value operations.
+  syntax Int ::= valueLength(Value) [function, total]
+  rule valueLength(vnil) => 0
+  rule valueLength(vlist(_, T)) => 1 +Int valueLength(T)
+
+  syntax Value ::= valueAt(Value, Int) [function]
+  rule valueAt(vlist(H, _), 0) => H
+  rule valueAt(vlist(_, T), I) => valueAt(T, I -Int 1)
+    requires I >Int 0
+
+  syntax Value ::= valuePlus(Value, Value) [function]
+                 | valueMinus(Value, Value) [function]
+  rule valuePlus(vint(I), vint(J)) => vint(I +Int J)
+  rule valuePlus(vnum(R), vnum(S)) => vnum(R +Rat S)
+  rule valuePlus(vint(I), vnum(R)) => vnum(I +Rat R)
+  rule valuePlus(vnum(R), vint(I)) => vnum(R +Rat I)
+  rule valueMinus(vint(I), vint(J)) => vint(I -Int J)
+  rule valueMinus(vnum(R), vnum(S)) => vnum(R -Rat S)
+  rule valueMinus(vint(I), vnum(R)) => vnum(I -Rat R)
+  rule valueMinus(vnum(R), vint(I)) => vnum(R -Rat I)
+
+  syntax Bool ::= valueLess(Value, Value) [function]
+  rule valueLess(vint(I), vint(J)) => I <Int J
+  rule valueLess(vnum(R), vnum(S)) => R <Rat S
+  rule valueLess(vint(I), vnum(R)) => I <Rat R
+  rule valueLess(vnum(R), vint(I)) => R <Rat I
+
+  // Load a module, then optionally invoke its entry point.
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> run(Module(SS), ARG) => exec(SS) ~> invoke("find_closest_elements", ARG) ... </k>
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> ImportFrom(_, _) => . ... </k>
+  rule <k> FuncDef(F, P, BODY) => . ... </k>
+       <functions> FS => FS [ F <- function(P, BODY) ] </functions>
+
+  rule <k> invoke(F, ARG) => bindAndExec(PNAME, BODY, ARG) ... </k>
+       <functions> ... F |-> function(Params(PNAME), BODY) ... </functions>
+  rule <k> bindAndExec(PNAME, BODY, ARG) => exec(BODY) ... </k>
+       <env> _ => PNAME |-> ARG </env>
+
+  // Statements.
+  rule <k> Assign(Name(X), E) => eval(E) ~> assignTo(X) ... </k>
+  rule <k> V:Value ~> assignTo(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> If(COND, YES, NO) => eval(COND) ~> choose(YES, NO) ... </k>
+  rule <k> vbool(true) ~> choose(YES, _) => exec(YES) ... </k>
+  rule <k> vbool(false) ~> choose(_, NO) => exec(NO) ... </k>
+
+  rule <k> While(COND, BODY) => eval(COND) ~> whileChoose(COND, BODY) ... </k>
+  rule <k> vbool(true) ~> whileChoose(COND, BODY)
+        => exec(BODY) ~> While(COND, BODY) ... </k>
+  rule <k> vbool(false) ~> whileChoose(_, _) => . ... </k>
+
+  rule <k> Return(E) => eval(E) ~> finishReturn ... </k>
+  rule <k> V:Value ~> finishReturn ~> _:K => .K </k>
+       <env> _ => .Map </env>
+       <functions> _ => .Map </functions>
+       <result> _ => V </result>
+
+  // Expressions and their left-to-right evaluation contexts.
+  rule <k> eval(Name(X)) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> eval(Int(I)) => vint(I) ... </k>
+
+  rule <k> eval(BinOp(OP, L, R)) => eval(L) ~> binLeft(OP, R) ... </k>
+  rule <k> V:Value ~> binLeft(OP, R) => eval(R) ~> binRight(OP, V) ... </k>
+  rule <k> W:Value ~> binRight("+", V) => valuePlus(V, W) ... </k>
+  rule <k> W:Value ~> binRight("-", V) => valueMinus(V, W) ... </k>
+
+  rule <k> eval(Subscript(L, I)) => eval(L) ~> subscriptLeft(I) ... </k>
+  rule <k> V:Value ~> subscriptLeft(I) => eval(I) ~> subscriptRight(V) ... </k>
+  rule <k> vint(I) ~> subscriptRight(V) => valueAt(V, I) ... </k>
+
+  rule <k> eval(Compare(L, CmpOp(OP, R)))
+        => eval(L) ~> compareLeft(OP, R) ... </k>
+  rule <k> V:Value ~> compareLeft(OP, R)
+        => eval(R) ~> compareRight(OP, V) ... </k>
+  rule <k> W:Value ~> compareRight("<", V)
+        => vbool(valueLess(V, W)) ... </k>
+
+  // `len` is the only callable needed here. Keeping the callable as a value is
+  // unnecessary, so recognize its AST name before normal name lookup.
+  rule <k> eval(Call(Name("len"), ARG)) => eval(ARG) ~> callOne(vnil) ... </k>
+  rule <k> V:Value ~> callOne(vnil) => vint(valueLength(V)) ... </k>
+
+  rule <k> eval(TupleExpr(A, B)) => eval(A) ~> tupleLeft(B) ... </k>
+  rule <k> V:Value ~> tupleLeft(B) => eval(B) ~> tupleRight(V) ... </k>
+  rule <k> W:Value ~> tupleRight(V) => vtuple(V, W) ... </k>
+endmodule
+
+module MPY
+  imports MPY-SEMANTIC
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..557fa47fd5e01c717f7c57ee83b439fb4bbef795
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,29 @@
+from typing import List, Tuple
+
+
+def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:
+    closest_a = numbers[0]
+    closest_b = numbers[1]
+    if closest_b < closest_a:
+        temporary = closest_a
+        closest_a = closest_b
+        closest_b = temporary
+    best_gap = closest_b - closest_a
+    i = 0
+    while i < len(numbers):
+        j = i + 1
+        while j < len(numbers):
+            a = numbers[i]
+            b = numbers[j]
+            if b < a:
+                temporary = a
+                a = b
+                b = temporary
+            gap = b - a
+            if gap < best_gap:
+                best_gap = gap
+                closest_a = a
+                closest_b = b
+            j = j + 1
+        i = i + 1
+    return (closest_a, closest_b)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec2433c8de2585f2a5e313af1db7d5b29ba821fb
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // The two examples from the HumanEval contract.
+  claim
+    <mpy>
+      <k> run(solution, nums(1, 2, 3, 4, 5, 11 /Rat 5)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vnum(2), vnum(11 /Rat 5)) </result>
+    </mpy>
+
+  claim
+    <mpy>
+      <k> run(solution, nums(1, 2, 3, 4, 5, 2)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vnum(2), vnum(2)) </result>
+    </mpy>
+
+  // Symbolic length-two cases prove ordering and duplicate behavior for all
+  // exact rational inputs satisfying the stated relation.
+  claim
+    <mpy>
+      <k> run(solution, nums(A, B)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vnum(A), vnum(B)) </result>
+    </mpy>
+    requires A <Rat B
+
+  claim
+    <mpy>
+      <k> run(solution, nums(A, B)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vnum(B), vnum(A)) </result>
+    </mpy>
+    requires B <Rat A
+
+  claim
+    <mpy>
+      <k> run(solution, nums(A, B)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vnum(A), vnum(B)) </result>
+    </mpy>
+    requires A ==Rat B
+
+  // A negative-valued concrete case exercises normalization away from the
+  // prompt's examples.
+  claim
+    <mpy>
+      <k> run(solution, nums(-10, -3, -7 /Rat 2, 9)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vnum(-7 /Rat 2), vnum(-3)) </result>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..83f1e1b8226daedae69da34927187dc2fedc3ce5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,55 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTIC
+
+  // This is the exact constructor tree generated in solution.mpy, exposed as
+  // a function so claims do not have to duplicate the program text.
+  syntax Program ::= "solution" [function]
+  rule solution =>
+    Module(
+      ImportFrom("typing", "List", "Tuple")
+      FuncDef("find_closest_elements", Params("numbers"),
+        Assign(Name("closest_a"), Subscript(Name("numbers"), Int(0)))
+        Assign(Name("closest_b"), Subscript(Name("numbers"), Int(1)))
+        If(Compare(Name("closest_b"), CmpOp("<", Name("closest_a"))),
+          Assign(Name("temporary"), Name("closest_a"))
+          Assign(Name("closest_a"), Name("closest_b"))
+          Assign(Name("closest_b"), Name("temporary")),
+          .Stmts)
+        Assign(Name("best_gap"),
+          BinOp("-", Name("closest_b"), Name("closest_a")))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"),
+              CmpOp("<", Call(Name("len"), Name("numbers")))),
+          Assign(Name("j"), BinOp("+", Name("i"), Int(1)))
+          While(Compare(Name("j"),
+                CmpOp("<", Call(Name("len"), Name("numbers")))),
+            Assign(Name("a"), Subscript(Name("numbers"), Name("i")))
+            Assign(Name("b"), Subscript(Name("numbers"), Name("j")))
+            If(Compare(Name("b"), CmpOp("<", Name("a"))),
+              Assign(Name("temporary"), Name("a"))
+              Assign(Name("a"), Name("b"))
+              Assign(Name("b"), Name("temporary")),
+              .Stmts)
+            Assign(Name("gap"), BinOp("-", Name("b"), Name("a")))
+            If(Compare(Name("gap"), CmpOp("<", Name("best_gap"))),
+              Assign(Name("best_gap"), Name("gap"))
+              Assign(Name("closest_a"), Name("a"))
+              Assign(Name("closest_b"), Name("b")),
+              .Stmts)
+            Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(TupleExpr(Name("closest_a"), Name("closest_b")))))
+
+  // Readable constructors for proof inputs.
+  syntax Value ::= nums(Rat, Rat) [function]
+                 | nums(Rat, Rat, Rat, Rat) [function]
+                 | nums(Rat, Rat, Rat, Rat, Rat, Rat) [function]
+  rule nums(A, B) => vlist(vnum(A), vlist(vnum(B), vnil))
+  rule nums(A, B, C, D) =>
+    vlist(vnum(A), vlist(vnum(B), vlist(vnum(C), vlist(vnum(D), vnil))))
+  rule nums(A, B, C, D, E, F) =>
+    vlist(vnum(A), vlist(vnum(B), vlist(vnum(C),
+      vlist(vnum(D), vlist(vnum(E), vlist(vnum(F), vnil))))))
+endmodule

apply patch
patch: completed
/work/spec.k
