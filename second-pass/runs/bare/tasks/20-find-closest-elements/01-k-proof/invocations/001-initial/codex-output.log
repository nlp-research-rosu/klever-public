+    </mpy>
+    requires A <Float B
+
+  claim
+    <mpy>
+      <k> run(solution, floats(A, B)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vfloat(B), vfloat(A)) </result>
+    </mpy>
+    requires B <Float A
+
+  claim
+    <mpy>
+      <k> run(solution, floats(A, B)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vfloat(A), vfloat(B)) </result>
+    </mpy>
+    requires A ==Float B
+
+  // A negative-valued concrete case exercises normalization away from the
+  // prompt's examples.
+  claim
+    <mpy>
+      <k> run(solution, floats(-10.0, -3.0, -3.5, 9.0)) => .K </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult => vtuple(vfloat(-3.5), vfloat(-3.0)) </result>
+    </mpy>
+endmodule
