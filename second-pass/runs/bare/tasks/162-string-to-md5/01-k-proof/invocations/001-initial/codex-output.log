+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [label(empty)]:
+    <py>
+      <k> #load(solutionProgram) </k>
+      <input> "" </input>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+  =>
+    <py>
+      <k> .K </k>
+      <input> "" </input>
+      <functions>
+        "string_to_md5" |-> fn("text", solutionBody)
+      </functions>
+      <env> "text" |-> pyString("") </env>
+      <result> pyNone </result>
+    </py>
+
+  claim [label(nonempty-symbolic)]:
+    <py>
+      <k> #load(solutionProgram) </k>
+      <input> S:String </input>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+  =>
+    <py>
+      <k> .K </k>
+      <input> S </input>
+      <functions>
+        "string_to_md5" |-> fn("text", solutionBody)
+      </functions>
+      <env> "text" |-> pyString(S) </env>
+      <result> expectedMd5(S) </result>
+    </py>
+    requires S =/=String ""
+
+  claim [label(prompt-example)]:
+    <py>
+      <k> #load(solutionProgram) </k>
+      <input> "Hello world" </input>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+  =>
+    <py>
+      <k> .K </k>
+      <input> "Hello world" </input>
+      <functions>
+        "string_to_md5" |-> fn("text", solutionBody)
+      </functions>
+      <env> "text" |-> pyString("Hello world") </env>
+      <result> pyString("3e25960a79dbc69b674cd4ec67a72c62") </result>
+    </py>
+
+  claim [label(unicode-utf8)]:
+    <py>
+      <k> #load(solutionProgram) </k>
+      <input> "π" </input>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </py>
+  =>
+    <py>
+      <k> .K </k>
+      <input> "π" </input>
+      <functions>
+        "string_to_md5" |-> fn("text", solutionBody)
+      </functions>
+      <env> "text" |-> pyString("π") </env>
+      <result> pyString("31bf0b12546409e15021243132fc7574") </result>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a8a171434b9d51339cc12a218f694f47086ceab9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This is the exact constructor tree emitted in solution.mpy, factored out
+  // so every claim verifies the same translated program.
+  syntax Stmts ::= "solutionBody" [function]
+  rule solutionBody =>
+    Return(
+      IfExp(
+        Compare(Name("text"), CmpOp("==", Str(""))),
+        NoneVal,
+        Call(
+          Attribute(
+            Call(
+              Attribute(Name("hashlib"), "md5"),
+              Call(Attribute(Name("text"), "encode"), )),
+            "hexdigest"),
+          )))
+    .Stmts
+
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      Import("hashlib")
+      FuncDef("string_to_md5", Params("text"), solutionBody))
+
+  // Mathematical result used by the symbolic non-empty contract.
+  syntax PyValue ::= "expectedMd5" "(" String ")" [function]
+  rule expectedMd5(S) => pyString(md5String(S))
+endmodule

