+import hashlib
+
+
+def string_to_md5(text):
+    return None if text == "" else hashlib.md5(text.encode()).hexdigest()

exec
/bin/bash -lc "krun solution.mpy --definition semantic-kompiled -cTEXT='\"\"'
krun solution.mpy --definition semantic-kompiled -cTEXT='\"Hello world\"'
krun solution.mpy --definition semantic-kompiled -cTEXT='\"abc\"'
krun solution.mpy --definition semantic-kompiled -cTEXT='\"π\"'" in /workspace
