+    hexByte((W >>Int 8) &Int 255) +String
+    hexByte((W >>Int 16) &Int 255) +String
+    hexByte((W >>Int 24) &Int 255)
+  rule hexByte(B) =>
+    hexNibble(B divInt 16) +String hexNibble(B modInt 16)
+  rule hexNibble(0)  => "0"
+  rule hexNibble(1)  => "1"
+  rule hexNibble(2)  => "2"
+  rule hexNibble(3)  => "3"
+  rule hexNibble(4)  => "4"
+  rule hexNibble(5)  => "5"
+  rule hexNibble(6)  => "6"
+  rule hexNibble(7)  => "7"
+  rule hexNibble(8)  => "8"
+  rule hexNibble(9)  => "9"
+  rule hexNibble(10) => "a"
+  rule hexNibble(11) => "b"
+  rule hexNibble(12) => "c"
+  rule hexNibble(13) => "d"
+  rule hexNibble(14) => "e"
+  rule hexNibble(15) => "f"
+
+  rule md5Word(P, OFFSET, G) =>
+    Bytes2Int(
+      substrBytes(
+        P,
+        OFFSET +Int (4 *Int G),
+        OFFSET +Int (4 *Int G) +Int 4),
+      LE,
+      Unsigned)
+
+  rule add32(X, Y) => (X +Int Y) modInt 4294967296
+  rule add32(W, X, Y, Z) =>
+    (W +Int X +Int Y +Int Z) modInt 4294967296
+  rule rotl32(X, S) =>
+    ((X <<Int S) |Int (X >>Int (32 -Int S))) &Int 4294967295
