+  rule hexWordLE(W) =>
+    hexByte(W &Int 255) +String
+    hexByte((W >>Int 8) &Int 255) +String
+    hexByte((W >>Int 16) &Int 255) +String
+    hexByte((W >>Int 24) &Int 255)
+  rule hexByte(B) =>
+    hexNibble(B divInt 16) +String hexNibble(B modInt 16)
+  rule hexNibble(0)  => "0"
+  rule hexNibble(1)  => "1"
+  rule hexNibble(2)  => "2"
+  rule hexNibble(3)  => "3"
+  rule hexNibble(4)  => "4"
+  rule hexNibble(5)  => "5"
+  rule hexNibble(6)  => "6"
+  rule hexNibble(7)  => "7"
+  rule hexNibble(8)  => "8"
+  rule hexNibble(9)  => "9"
+  rule hexNibble(10) => "a"
+  rule hexNibble(11) => "b"
+  rule hexNibble(12) => "c"
+  rule hexNibble(13) => "d"
+  rule hexNibble(14) => "e"
+  rule hexNibble(15) => "f"
