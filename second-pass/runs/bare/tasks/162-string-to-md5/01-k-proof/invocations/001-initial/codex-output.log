+                | "Call" "(" Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+
+  syntax PyValue ::= "pyNone"
+                   | "pyBool" "(" Bool ")"
+                   | "pyString" "(" String ")"
+                   | "pyBytes" "(" Bytes ")"
+                   | "pyModule" "(" String ")"
+                   | "pyBuiltin" "(" String ")"
+                   | "pyMethod" "(" String "," PyValue ")"
