Module(
  Import("hashlib")
  FuncDef("string_to_md5", Params("text"),
    Return(
      IfExp(
        Compare(Name("text"), CmpOp("==", Str(""))),
        NoneVal,
        Call(
          Attribute(
            Call(
              Attribute(Name("hashlib"), "md5"),
              Call(Attribute(Name("text"), "encode"), )),
            "hexdigest"),
          )))))
