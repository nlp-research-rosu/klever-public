#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy

kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

krun solution.mpy --definition verification-kompiled -cTEXT='""'
krun solution.mpy --definition verification-kompiled -cTEXT='"Hello world"'
krun solution.mpy --definition verification-kompiled \
  -cTEXT='"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"'

kprove spec.k --definition verification-kompiled
requires "semantic.k"

module VERIFICATION
  imports SEMANTIC

  // This is the exact constructor tree emitted in solution.mpy, factored out
  // so every claim verifies the same translated program.
  syntax Stmts ::= "solutionBody" [function]
  rule solutionBody =>
    Return(
      IfExp(
        Compare(Name("text"), CmpOp("==", Str(""))),
        NoneVal,
        Call(
          Attribute(
            Call(
              Attribute(Name("hashlib"), "md5"),
              Call(Attribute(Name("text"), "encode"), )),
            "hexdigest"),
          )))
    .Stmts

  syntax Program ::= "solutionProgram" [function]
  rule solutionProgram =>
    Module(
      Import("hashlib")
      FuncDef("string_to_md5", Params("text"), solutionBody))

  // Mathematical result used by the symbolic non-empty contract.
  syntax PyValue ::= "expectedMd5" "(" String ")" [function]
  rule expectedMd5(S) => pyString(md5String(S))
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [label(empty)]:
    <py>
      <k> #load(solutionProgram) => .K </k>
      <input> "" </input>
      <functions>
        .Map => "string_to_md5" |-> fn("text", solutionBody)
      </functions>
      <env> .Map => "text" |-> pyString("") </env>
      <result> noResult => pyNone </result>
    </py>

  claim [label(nonempty-symbolic)]:
    <py>
      <k> #load(solutionProgram) => .K </k>
      <input> S:String </input>
      <functions>
        .Map => "string_to_md5" |-> fn("text", solutionBody)
      </functions>
      <env> .Map => "text" |-> pyString(S) </env>
      <result> noResult => expectedMd5(S) </result>
    </py>
    requires S =/=String ""

  claim [label(prompt-example)]:
