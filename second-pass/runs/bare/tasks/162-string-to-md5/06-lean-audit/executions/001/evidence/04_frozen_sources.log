     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // This is the exact constructor tree emitted in solution.mpy, factored out
     7	  // so every claim verifies the same translated program.
     8	  syntax Stmts ::= "solutionBody" [function]
     9	  rule solutionBody =>
    10	    Return(
    11	      IfExp(
    12	        Compare(Name("text"), CmpOp("==", Str(""))),
    13	        NoneVal,
    14	        Call(
    15	          Attribute(
    16	            Call(
    17	              Attribute(Name("hashlib"), "md5"),
    18	              Call(Attribute(Name("text"), "encode"), )),
    19	            "hexdigest"),
    20	          )))
    21	    .Stmts
    22	
    23	  syntax Program ::= "solutionProgram" [function]
    24	  rule solutionProgram =>
    25	    Module(
    26	      Import("hashlib")
    27	      FuncDef("string_to_md5", Params("text"), solutionBody))
    28	
    29	  // Mathematical result used by the symbolic non-empty contract.
    30	  syntax PyValue ::= "expectedMd5" "(" String ")" [function]
    31	  rule expectedMd5(S) => pyString(md5String(S))
    32	endmodule
