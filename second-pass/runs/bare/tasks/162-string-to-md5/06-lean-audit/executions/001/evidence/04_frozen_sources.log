     1	module MPY-SYNTAX
     2	  imports DOMAINS
     3	  imports BYTES
     4	
     5	  syntax Program ::= "Module" "(" Stmts ")"
     6	
     7	  syntax Stmts ::= List{Stmt, ""}
     8	  syntax Stmt  ::= "Import" "(" String ")"
     9	                 | "FuncDef" "(" String "," Params "," Stmts ")"
    10	                 | "Return" "(" Expr ")"
    11	
    12	  syntax Params ::= "Params" "(" String ")"
    13	
    14	  syntax Expr ::= "NoneVal"
    15	                | "Str" "(" String ")"
    16	                | "Name" "(" String ")"
    17	                | "Compare" "(" Expr "," CmpOp ")"
    18	                | "IfExp" "(" Expr "," Expr "," Expr ")"
    19	                | "Attribute" "(" Expr "," String ")"
    20	                | "Call" "(" Expr "," ")"
    21	                | "Call" "(" Expr "," Expr ")"
    22	
    23	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    24	endmodule
    25	
    26	module SEMANTIC
    27	  imports MPY-SYNTAX
    28	
    29	  syntax PyValue ::= "pyNone"
    30	                   | "pyBool" "(" Bool ")"
    31	                   | "pyString" "(" String ")"
    32	                   | "pyBytes" "(" Bytes ")"
    33	                   | "pyModule" "(" String ")"
    34	                   | "pyBuiltin" "(" String ")"
    35	                   | "pyMethod" "(" String "," PyValue ")"
    36	
    37	  syntax Function ::= "fn" "(" String "," Stmts ")"
    38	  syntax Result ::= "noResult" | PyValue
    39	
    40	  syntax KItem ::= "#load" "(" Program ")"
    41	                 | "#loadStmts" "(" Stmts ")"
    42	                 | "#start"
    43	                 | "#invoke" "(" String "," PyValue ")"
    44	                 | "#functionEnd"
    45	                 | "#eval" "(" Expr ")"
    46	                 | "#compareLeft" "(" String "," Expr ")"
    47	                 | "#compareRight" "(" String "," PyValue ")"
    48	                 | "#ifExp" "(" Expr "," Expr ")"
    49	                 | "#attribute" "(" String ")"
    50	                 | "#call0"
    51	                 | "#call1" "(" Expr ")"
    52	                 | "#apply1" "(" PyValue ")"
    53	
    54	  configuration
    55	    <py>
    56	      <k> #load($PGM:Program) </k>
    57	      <input> $TEXT:String </input>
    58	      <functions> .Map </functions>
    59	      <env> .Map </env>
    60	      <result> noResult </result>
    61	    </py>
    62	
    63	  // Module loading records function syntax without executing its body.
    64	  rule <k> #load(Module(SS)) => #loadStmts(SS) ~> #start ... </k>
    65	  rule <k> #loadStmts(.Stmts) => .K ... </k>
    66	  rule <k> #loadStmts(Import(_) REST) => #loadStmts(REST) ... </k>
    67	  rule <k> #loadStmts(FuncDef(F, Params(P), BODY) REST)
    68	        => #loadStmts(REST) ... </k>
    69	       <functions> FS => FS [ F <- fn(P, BODY) ] </functions>
    70	
    71	  // The configured input is passed to the HumanEval entry point.
    72	  rule <k> #start => #invoke("string_to_md5", pyString(S)) ... </k>
    73	       <input> S </input>
    74	
    75	  rule <k> #invoke(F, V) => BODY ~> #functionEnd ... </k>
    76	       <functions> F |-> fn(P, BODY) </functions>
    77	       <env> _ => P |-> V </env>
    78	
    79	  rule <k> (Return(E) _REST) ~> #functionEnd
    80	        => #eval(E) ~> #functionEnd ... </k>
    81	
    82	  rule <k> V:PyValue ~> #functionEnd => .K ... </k>
    83	       <result> _ => V </result>
    84	
    85	  // Expression evaluation is explicit: the AST translator performs no
    86	  // desugaring and each constructor gets its meaning here.
    87	  rule <k> #eval(NoneVal) => pyNone ... </k>
    88	  rule <k> #eval(Str(S)) => pyString(S) ... </k>
    89	  rule <k> #eval(Name("hashlib")) => pyModule("hashlib") ... </k>
    90	  rule <k> #eval(Name(N)) => V ... </k>
    91	       <env> N |-> V </env>
    92	
    93	  rule <k> #eval(Compare(LEFT, CmpOp(OP, RIGHT)))
    94	        => #eval(LEFT) ~> #compareLeft(OP, RIGHT) ... </k>
    95	  rule <k> V:PyValue ~> #compareLeft(OP, RIGHT)
    96	        => #eval(RIGHT) ~> #compareRight(OP, V) ... </k>
    97	  rule <k> pyString(S2) ~> #compareRight("==", pyString(S1))
    98	        => pyBool(S1 ==String S2) ... </k>
    99	
   100	  rule <k> #eval(IfExp(TEST, YES, NO))
   101	        => #eval(TEST) ~> #ifExp(YES, NO) ... </k>
   102	  rule <k> pyBool(true) ~> #ifExp(YES, _NO) => #eval(YES) ... </k>
   103	  rule <k> pyBool(false) ~> #ifExp(_YES, NO) => #eval(NO) ... </k>
   104	
   105	  rule <k> #eval(Attribute(RECEIVER, ATTR))
   106	        => #eval(RECEIVER) ~> #attribute(ATTR) ... </k>
   107	  rule <k> pyModule("hashlib") ~> #attribute("md5")
   108	        => pyBuiltin("hashlib.md5") ... </k>
   109	  rule <k> pyString(S) ~> #attribute("encode")
   110	        => pyMethod("str.encode", pyString(S)) ... </k>
   111	  rule <k> pyBytes(B) ~> #attribute("hexdigest")
   112	        => pyMethod("md5.hexdigest", pyBytes(B)) ... </k>
   113	
   114	  rule <k> #eval(Call(F, )) => #eval(F) ~> #call0 ... </k>
   115	  rule <k> FUN:PyValue ~> #call0 => #apply0(FUN) ... </k>
   116	  syntax KItem ::= "#apply0" "(" PyValue ")"
   117	  rule <k> #apply0(pyMethod("str.encode", pyString(S)))
   118	        => pyBytes(utf8Bytes(S)) ... </k>
   119	  rule <k> #apply0(pyMethod("md5.hexdigest", pyBytes(B)))
   120	        => pyString(md5Bytes(B)) ... </k>
   121	
   122	  rule <k> #eval(Call(F, ARG))
   123	        => #eval(F) ~> #call1(ARG) ... </k>
   124	  rule <k> FUN:PyValue ~> #call1(ARG)
   125	        => #eval(ARG) ~> #apply1(FUN) ... </k>
   126	  rule <k> pyBytes(B) ~> #apply1(pyBuiltin("hashlib.md5"))
   127	        => pyBytes(B) ... </k>
   128	
   129	  // -----------------------------------------------------------------------
   130	  // A self-contained RFC 1321 MD5 implementation over K's byte primitives.
   131	  // Python's str.encode() defaults to UTF-8, captured by the rule above.
   132	  // -----------------------------------------------------------------------
   133	
   134	  syntax String ::= "md5String" "(" String ")" [function]
   135	  syntax String ::= "md5Bytes" "(" Bytes ")" [function]
   136	  syntax Bytes ::= "utf8Bytes" "(" String ")" [function]
   137	                 | "utf8CodePoint" "(" Int ")" [function]
   138	  syntax Bytes ::= "md5Pad" "(" Bytes ")" [function]
   139	  syntax Md5State ::= "md5State" "(" Int "," Int "," Int "," Int ")"
   140	  syntax Md5State ::= "md5Blocks" "(" Bytes "," Int "," Md5State ")" [function]
   141	  syntax Md5State ::= "md5Rounds"
   142	      "(" Bytes "," Int "," Int "," Md5State "," Md5State ")" [function]
   143	  syntax Md5State ::= "md5AddState" "(" Md5State "," Md5State ")" [function]
   144	  syntax String ::= "md5StateHex" "(" Md5State ")" [function]
   145	                  | "hexWordLE" "(" Int ")" [function]
   146	                  | "hexByte" "(" Int ")" [function]
   147	                  | "hexNibble" "(" Int ")" [function]
   148	  syntax Int ::= "md5F" "(" Int "," Int "," Int "," Int ")" [function]
   149	               | "md5G" "(" Int ")" [function]
   150	               | "md5Shift" "(" Int ")" [function]
   151	               | "md5K" "(" Int ")" [function]
   152	               | "md5Word" "(" Bytes "," Int "," Int ")" [function]
   153	               | "add32" "(" Int "," Int ")" [function]
   154	               | "add32" "(" Int "," Int "," Int "," Int ")" [function]
   155	               | "rotl32" "(" Int "," Int ")" [function]
   156	
   157	  rule md5String(S) => md5Bytes(utf8Bytes(S))
   158	  rule utf8Bytes("") => .Bytes [simplification]
   159	  rule utf8Bytes(S) =>
   160	    utf8CodePoint(ordChar(substrString(S, 0, 1)))
   161	    +Bytes utf8Bytes(substrString(S, 1, lengthString(S)))
   162	    requires S =/=String ""
   163	    [concrete(S), simplification]
   164	
   165	  rule utf8CodePoint(C) => Int2Bytes(1, C, BE)
   166	    requires C >=Int 0 andBool C <=Int 127
   167	  rule utf8CodePoint(C) =>
   168	    Int2Bytes(1, 192 |Int (C >>Int 6), BE)
   169	    +Bytes Int2Bytes(1, 128 |Int (C &Int 63), BE)
   170	    requires C >=Int 128 andBool C <=Int 2047
   171	  rule utf8CodePoint(C) =>
   172	    Int2Bytes(1, 224 |Int (C >>Int 12), BE)
   173	    +Bytes Int2Bytes(1, 128 |Int ((C >>Int 6) &Int 63), BE)
   174	    +Bytes Int2Bytes(1, 128 |Int (C &Int 63), BE)
   175	    requires C >=Int 2048 andBool C <=Int 65535
   176	  rule utf8CodePoint(C) =>
   177	    Int2Bytes(1, 240 |Int (C >>Int 18), BE)
   178	    +Bytes Int2Bytes(1, 128 |Int ((C >>Int 12) &Int 63), BE)
   179	    +Bytes Int2Bytes(1, 128 |Int ((C >>Int 6) &Int 63), BE)
   180	    +Bytes Int2Bytes(1, 128 |Int (C &Int 63), BE)
   181	    requires C >=Int 65536 andBool C <=Int 1114111
   182	  rule md5Bytes(B) =>
   183	    md5StateHex(md5Blocks(
   184	      md5Pad(B),
   185	      0,
   186	      md5State(1732584193, 4023233417, 2562383102, 271733878)))
   187	    [concrete(B), simplification]
   188	
   189	  rule md5Pad(B) =>
   190	    padRightBytes(
   191	      B +Bytes b"\x80",
   192	      (((lengthBytes(B) +Int 72) divInt 64) *Int 64) -Int 8,
   193	      0)
   194	    +Bytes Int2Bytes(8, lengthBytes(B) *Int 8, LE)
   195	
   196	  rule md5Blocks(P, OFFSET, STATE) => STATE
   197	    requires OFFSET >=Int lengthBytes(P)
   198	  rule md5Blocks(P, OFFSET, STATE) =>
   199	    md5Blocks(P, OFFSET +Int 64, md5Rounds(P, OFFSET, 0, STATE, STATE))
   200	    requires OFFSET <Int lengthBytes(P)
   201	
   202	  rule md5Rounds(_P, _OFFSET, 64, STATE, ORIGINAL) =>
   203	    md5AddState(STATE, ORIGINAL)
   204	  rule md5Rounds(P, OFFSET, I, md5State(A, B, C, D), ORIGINAL) =>
   205	    md5Rounds(
   206	      P,
   207	      OFFSET,
   208	      I +Int 1,
   209	      md5State(
   210	        D,
   211	        add32(B,
   212	          rotl32(
   213	            add32(A, md5F(I, B, C, D), md5K(I), md5Word(P, OFFSET, md5G(I))),
   214	            md5Shift(I))),
   215	        B,
   216	        C),
   217	      ORIGINAL)
   218	    requires I >=Int 0 andBool I <Int 64
   219	
   220	  rule md5AddState(
   221	      md5State(A, B, C, D),
   222	      md5State(A0, B0, C0, D0)) =>
   223	    md5State(add32(A, A0), add32(B, B0), add32(C, C0), add32(D, D0))
   224	
   225	  rule md5StateHex(md5State(A, B, C, D)) =>
   226	    hexWordLE(A) +String hexWordLE(B) +String
   227	    hexWordLE(C) +String hexWordLE(D)
   228	
   229	  rule hexWordLE(W) =>
   230	    hexByte(W &Int 255) +String
   231	    hexByte((W >>Int 8) &Int 255) +String
   232	    hexByte((W >>Int 16) &Int 255) +String
   233	    hexByte((W >>Int 24) &Int 255)
   234	  rule hexByte(B) =>
   235	    hexNibble(B divInt 16) +String hexNibble(B modInt 16)
   236	  rule hexNibble(0)  => "0"
   237	  rule hexNibble(1)  => "1"
   238	  rule hexNibble(2)  => "2"
   239	  rule hexNibble(3)  => "3"
   240	  rule hexNibble(4)  => "4"
   241	  rule hexNibble(5)  => "5"
   242	  rule hexNibble(6)  => "6"
   243	  rule hexNibble(7)  => "7"
   244	  rule hexNibble(8)  => "8"
   245	  rule hexNibble(9)  => "9"
   246	  rule hexNibble(10) => "a"
   247	  rule hexNibble(11) => "b"
   248	  rule hexNibble(12) => "c"
   249	  rule hexNibble(13) => "d"
   250	  rule hexNibble(14) => "e"
   251	  rule hexNibble(15) => "f"
   252	
   253	  rule md5Word(P, OFFSET, G) =>
   254	    Bytes2Int(
   255	      substrBytes(
   256	        P,
   257	        OFFSET +Int (4 *Int G),
   258	        OFFSET +Int (4 *Int G) +Int 4),
   259	      LE,
   260	      Unsigned)
   261	
   262	  rule add32(X, Y) => (X +Int Y) modInt 4294967296
   263	  rule add32(W, X, Y, Z) =>
   264	    (W +Int X +Int Y +Int Z) modInt 4294967296
   265	  rule rotl32(X, S) =>
   266	    ((X <<Int S) |Int (X >>Int (32 -Int S))) &Int 4294967295
   267	
   268	  rule md5F(I, B, C, D) => (B &Int C) |Int ((~Int B) &Int D)
   269	    requires I >=Int 0 andBool I <Int 16
   270	  rule md5F(I, B, C, D) => (D &Int B) |Int ((~Int D) &Int C)
   271	    requires I >=Int 16 andBool I <Int 32
   272	  rule md5F(I, B, C, D) => B xorInt C xorInt D
   273	    requires I >=Int 32 andBool I <Int 48
   274	  rule md5F(I, B, C, D) => C xorInt (B |Int (~Int D))
   275	    requires I >=Int 48 andBool I <Int 64
   276	
   277	  rule md5G(I) => I requires I >=Int 0 andBool I <Int 16
   278	  rule md5G(I) => (5 *Int I +Int 1) modInt 16
   279	    requires I >=Int 16 andBool I <Int 32
   280	  rule md5G(I) => (3 *Int I +Int 5) modInt 16
   281	    requires I >=Int 32 andBool I <Int 48
   282	  rule md5G(I) => (7 *Int I) modInt 16
   283	    requires I >=Int 48 andBool I <Int 64
   284	
   285	  rule md5Shift(I) => 7  requires I >=Int 0  andBool I <Int 16 andBool I modInt 4 ==Int 0
   286	  rule md5Shift(I) => 12 requires I >=Int 0  andBool I <Int 16 andBool I modInt 4 ==Int 1
   287	  rule md5Shift(I) => 17 requires I >=Int 0  andBool I <Int 16 andBool I modInt 4 ==Int 2
   288	  rule md5Shift(I) => 22 requires I >=Int 0  andBool I <Int 16 andBool I modInt 4 ==Int 3
   289	  rule md5Shift(I) => 5  requires I >=Int 16 andBool I <Int 32 andBool I modInt 4 ==Int 0
   290	  rule md5Shift(I) => 9  requires I >=Int 16 andBool I <Int 32 andBool I modInt 4 ==Int 1
   291	  rule md5Shift(I) => 14 requires I >=Int 16 andBool I <Int 32 andBool I modInt 4 ==Int 2
   292	  rule md5Shift(I) => 20 requires I >=Int 16 andBool I <Int 32 andBool I modInt 4 ==Int 3
   293	  rule md5Shift(I) => 4  requires I >=Int 32 andBool I <Int 48 andBool I modInt 4 ==Int 0
   294	  rule md5Shift(I) => 11 requires I >=Int 32 andBool I <Int 48 andBool I modInt 4 ==Int 1
   295	  rule md5Shift(I) => 16 requires I >=Int 32 andBool I <Int 48 andBool I modInt 4 ==Int 2
   296	  rule md5Shift(I) => 23 requires I >=Int 32 andBool I <Int 48 andBool I modInt 4 ==Int 3
   297	  rule md5Shift(I) => 6  requires I >=Int 48 andBool I <Int 64 andBool I modInt 4 ==Int 0
   298	  rule md5Shift(I) => 10 requires I >=Int 48 andBool I <Int 64 andBool I modInt 4 ==Int 1
   299	  rule md5Shift(I) => 15 requires I >=Int 48 andBool I <Int 64 andBool I modInt 4 ==Int 2
   300	  rule md5Shift(I) => 21 requires I >=Int 48 andBool I <Int 64 andBool I modInt 4 ==Int 3
