+++ b/solution.py
@@ -0,0 +1,6 @@
+def tri(n):
+    if n == 0:
+        return [1]
+    if n % 2 == 0:
+        return tri(n - 1) + [1 + n // 2]
+    return tri(n - 1) + [((n + 1) // 2) * ((n + 5) // 2)]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..dd42f08cd87dadf26296a0b0cd8ce086338515b8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,25 @@
+requires "verification.k"
+
+module TRI-SPEC
+  imports TRI-VERIFICATION
+
+  // End-to-end functional correctness of the translated Python constructor
+  // program for every input allowed by the prompt.
+  claim <k> evalCall(solutionProgram, "tri", N)
+          => returned(LVal(triPrefix(N))) ... </k>
+    requires N >=Int 0
+
+  // The returned prefix has exactly n + 1 elements.
+  claim <k> seqLength(triPrefix(N)) => N +Int 1 ... </k>
+    requires N >=Int 0
+
+  // Base values and both branches of the stated recurrence.
+  claim <k> triValue(0) => 1 ... </k>
+  claim <k> triValue(1) => 3 ... </k>
+  claim <k> triValue(N) => 1 +Int (N /Int 2) ... </k>
+    requires N >=Int 2 andBool N %Int 2 ==Int 0
+  claim <k> triValue(N)
+          => triValue(N -Int 1) +Int triValue(N -Int 2) +Int triValue(N +Int 1)
+        ... </k>
+    requires N >=Int 3 andBool N %Int 2 =/=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fb12fabc156249f90403d391ef4b90163e4c3ead
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+requires "semantic.k"
+
+module TRI-VERIFICATION
+  imports TRI-SEMANTIC
+
+  // This macro is the exact constructor tree emitted in solution.mpy.
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("tri", Params("n"),
+        If(Compare(Name("n"), CmpOp("==", Int(0))),
+          Return(ListExpr(Int(1))),
+          .Stmts)
+        If(Compare(BinOp("%", Name("n"), Int(2)),
+                   CmpOp("==", Int(0))),
+          Return(
+            BinOp("+",
+              Call(Name("tri"), BinOp("-", Name("n"), Int(1))),
+              ListExpr(BinOp("+", Int(1),
+                             BinOp("//", Name("n"), Int(2)))))),
+          .Stmts)
+        Return(
+          BinOp("+",
+            Call(Name("tri"), BinOp("-", Name("n"), Int(1))),
+            ListExpr(
+              BinOp("*",
+                BinOp("//", BinOp("+", Name("n"), Int(1)), Int(2)),
+                BinOp("//", BinOp("+", Name("n"), Int(5)), Int(2))))))))
+
+  // Mathematical sequence value.  The odd clause is the closed form of the
+  // prompt's recurrence; the two rules are exhaustive for N >= 0.
+  syntax Int ::= triValue ( Int ) [function]
+  rule triValue(N) => 1 +Int (N /Int 2)
+    requires N >=Int 0 andBool N %Int 2 ==Int 0
+  rule triValue(N) => ((N +Int 1) /Int 2) *Int ((N +Int 5) /Int 2)
+    requires N >=Int 0 andBool N %Int 2 =/=Int 0
+
+  syntax IntSeq ::= triPrefix ( Int ) [function]
+  rule triPrefix(0) => cons(1, nil)
+  rule triPrefix(N) => append(triPrefix(N -Int 1), cons(triValue(N), nil))
+    requires N >Int 0
+
+  syntax Int ::= seqLength ( IntSeq ) [function]
+  rule seqLength(nil) => 0
+  rule seqLength(cons(I, IS)) => 1 +Int seqLength(IS)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module TRI-SPEC' in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..e8359d441d0045d42c1f271cc4dd64ac46a77581
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,115 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef(" String "," Params "," Stmts ")"
+                | "If(" Expr "," Stmts "," Stmts ")"
+                | "Return(" Expr ")"
+
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params(" Strings ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Expr ::= "Int(" Int ")"
+                | "Name(" String ")"
+                | "BinOp(" String "," Expr "," Expr ")"
+                | "Compare(" Expr "," CmpOps ")"
+                | "ListExpr(" Exprs ")"
+                | "Call(" Expr "," Exprs ")"
+  syntax CmpOp ::= "CmpOp(" String "," Expr ")"
+endmodule
+
+module TRI-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+
+  syntax IntSeq ::= "nil"
+                  | "cons" "(" Int "," IntSeq ")"
+
+  syntax Value ::= "IVal" "(" Int ")"
+                 | "BVal" "(" Bool ")"
+                 | "LVal" "(" IntSeq ")"
+
+  syntax Result ::= "returned" "(" Value ")"
+                  | "fellThrough"
+
+  configuration <k> run($PGM:Program, $N:Int) </k>
+
+  syntax KItem ::= "run" "(" Program "," Int ")"
+  syntax Result ::= evalCall ( Program , String , Int ) [function]
+                  | findCall ( Stmts , String , Int , Program ) [function]
+                  | evalStmts ( Stmts , Int , Program ) [function]
+                  | evalBranch ( Bool , Stmts , Stmts , Stmts , Int , Program ) [function]
+                  | evalAfter ( Result , Stmts , Int , Program ) [function]
+  syntax Value ::= eval ( Expr , Int , Program ) [function]
+                 | bin ( String , Value , Value ) [function]
+                 | compare ( Value , CmpOps , Int , Program ) [function]
+  syntax Bool ::= asBool ( Value ) [function]
+  syntax IntSeq ::= append ( IntSeq , IntSeq ) [function]
+                  | evalExprs ( Exprs , Int , Program ) [function]
+
+  rule <k> run(P, N) => evalCall(P, "tri", N) ... </k>
+
+  rule evalCall(Module(DEFS), F, N)
+    => findCall(DEFS, F, N, Module(DEFS))
+
+  rule findCall(FuncDef(F, Params(X), BODY) REST, F, N, P)
+    => evalStmts(BODY, N, P)
+  rule findCall(FuncDef(G, Params(X), BODY) REST, F, N, P)
+    => findCall(REST, F, N, P)
+    requires G =/=String F
+
+  rule evalStmts(.Stmts, N, P) => fellThrough
+  rule evalStmts(Return(E) REST, N, P) => returned(eval(E, N, P))
+  rule evalStmts(If(C, THEN, ELSE) REST, N, P)
+    => evalBranch(asBool(eval(C, N, P)), THEN, ELSE, REST, N, P)
+
+  rule evalBranch(true,  THEN, ELSE, REST, N, P)
+    => evalAfter(evalStmts(THEN, N, P), REST, N, P)
+  rule evalBranch(false, THEN, ELSE, REST, N, P)
+    => evalAfter(evalStmts(ELSE, N, P), REST, N, P)
+
+  rule evalAfter(returned(V), REST, N, P) => returned(V)
+  rule evalAfter(fellThrough, REST, N, P) => evalStmts(REST, N, P)
+
+  rule eval(Int(I), N, P) => IVal(I)
+  rule eval(Name("n"), N, P) => IVal(N)
+  rule eval(BinOp(OP, L, R), N, P)
+    => bin(OP, eval(L, N, P), eval(R, N, P))
+  rule eval(Compare(L, OPS), N, P)
+    => compare(eval(L, N, P), OPS, N, P)
+  rule eval(ListExpr(ES), N, P) => LVal(evalExprs(ES, N, P))
+  rule eval(Call(Name(F), ARG), N, P)
+    => asValue(evalCall(P, F, asInt(eval(ARG, N, P))))
+
+  syntax Int ::= asInt ( Value ) [function]
+  syntax Value ::= asValue ( Result ) [function]
+  rule asInt(IVal(I)) => I
+  rule asValue(returned(V)) => V
+  rule asBool(BVal(B)) => B
+
+  rule bin("+", IVal(A), IVal(B)) => IVal(A +Int B)
+  rule bin("-", IVal(A), IVal(B)) => IVal(A -Int B)
+  rule bin("*", IVal(A), IVal(B)) => IVal(A *Int B)
+  rule bin("%", IVal(A), IVal(B)) => IVal(A %Int B)
+  rule bin("//", IVal(A), IVal(B)) => IVal(A /Int B)
+  rule bin("+", LVal(XS), LVal(YS)) => LVal(append(XS, YS))
+
+  rule compare(IVal(A), CmpOp("==", R), N, P)
+    => BVal(A ==Int asInt(eval(R, N, P)))
+
+  rule evalExprs(.Exprs, N, P) => nil
+  rule evalExprs(E, N, P) => cons(asInt(eval(E, N, P)), nil)
+  rule evalExprs((E, ES), N, P)
+    => cons(asInt(eval(E, N, P)), evalExprs(ES, N, P))
+
+  rule append(nil, YS) => YS
+  rule append(cons(X, XS), YS) => cons(X, append(XS, YS))
+endmodule
