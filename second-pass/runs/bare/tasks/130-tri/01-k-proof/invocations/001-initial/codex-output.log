new file mode 100644
index 0000000000000000000000000000000000000000..f49aa40cc247fbbc586bb239f9b6814c3e8cfb00
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def tri(n):
+    if n == 0:
+        return [1]
+    if n % 2 == 0:
+        return tri(n - 1) + [1 + n // 2]
+    return tri(n - 1) + [((n + 1) // 2) * ((n + 5) // 2)]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..dd42f08cd87dadf26296a0b0cd8ce086338515b8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,25 @@
+requires "verification.k"
+
+module TRI-SPEC
+  imports TRI-VERIFICATION
+
+  // End-to-end functional correctness of the translated Python constructor
+  // program for every input allowed by the prompt.
+  claim <k> evalCall(solutionProgram, "tri", N)
+          => returned(LVal(triPrefix(N))) ... </k>
+    requires N >=Int 0
+
+  // The returned prefix has exactly n + 1 elements.
+  claim <k> seqLength(triPrefix(N)) => N +Int 1 ... </k>
+    requires N >=Int 0
+
+  // Base values and both branches of the stated recurrence.
+  claim <k> triValue(0) => 1 ... </k>
+  claim <k> triValue(1) => 3 ... </k>
+  claim <k> triValue(N) => 1 +Int (N /Int 2) ... </k>
+    requires N >=Int 2 andBool N %Int 2 ==Int 0
+  claim <k> triValue(N)
+          => triValue(N -Int 1) +Int triValue(N -Int 2) +Int triValue(N +Int 1)
+        ... </k>
+    requires N >=Int 3 andBool N %Int 2 =/=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fb12fabc156249f90403d391ef4b90163e4c3ead
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+requires "semantic.k"
+
+module TRI-VERIFICATION
+  imports TRI-SEMANTIC
+
+  // This macro is the exact constructor tree emitted in solution.mpy.
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("tri", Params("n"),
+        If(Compare(Name("n"), CmpOp("==", Int(0))),
+          Return(ListExpr(Int(1))),
+          .Stmts)
+        If(Compare(BinOp("%", Name("n"), Int(2)),
+                   CmpOp("==", Int(0))),
+          Return(
+            BinOp("+",
+              Call(Name("tri"), BinOp("-", Name("n"), Int(1))),
+              ListExpr(BinOp("+", Int(1),
+                             BinOp("//", Name("n"), Int(2)))))),
+          .Stmts)
+        Return(
+          BinOp("+",
+            Call(Name("tri"), BinOp("-", Name("n"), Int(1))),
+            ListExpr(
+              BinOp("*",
+                BinOp("//", BinOp("+", Name("n"), Int(1)), Int(2)),
+                BinOp("//", BinOp("+", Name("n"), Int(5)), Int(2))))))))
+
+  // Mathematical sequence value.  The odd clause is the closed form of the
+  // prompt's recurrence; the two rules are exhaustive for N >= 0.
+  syntax Int ::= triValue ( Int ) [function]
+  rule triValue(N) => 1 +Int (N /Int 2)
+    requires N >=Int 0 andBool N %Int 2 ==Int 0
+  rule triValue(N) => ((N +Int 1) /Int 2) *Int ((N +Int 5) /Int 2)
+    requires N >=Int 0 andBool N %Int 2 =/=Int 0
+
+  syntax IntSeq ::= triPrefix ( Int ) [function]
+  rule triPrefix(0) => cons(1, nil)
+  rule triPrefix(N) => append(triPrefix(N -Int 1), cons(triValue(N), nil))
+    requires N >Int 0
+
+  syntax Int ::= seqLength ( IntSeq ) [function]
+  rule seqLength(nil) => 0
+  rule seqLength(cons(I, IS)) => 1 +Int seqLength(IS)
+endmodule

apply patch
