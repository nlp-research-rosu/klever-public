    assert len(xs) == n + 1
    assert xs[0] == 1
    for i in range(1, n + 1):
        if i % 2 == 0:
            assert xs[i] == 1 + i // 2
        elif i == 1:
            assert xs[i] == 3
        else:
            assert xs[i] == xs[i - 1] + xs[i - 2] + (1 + (i + 1) // 2)
    print(n, xs)
