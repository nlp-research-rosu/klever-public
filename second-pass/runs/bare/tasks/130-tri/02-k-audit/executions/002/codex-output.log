diff --git a/evidence/positive-claims/value-one.k b/evidence/positive-claims/value-one.k
new file mode 100644
index 0000000000000000000000000000000000000000..8d4a9a3c8f2c142e1b3983c2c4718eab621224bc
--- /dev/null
+++ b/evidence/positive-claims/value-one.k
@@ -0,0 +1,6 @@
+requires "verification.k"
+
+module AUDIT-VALUE-ONE
+  imports TRI-VERIFICATION
