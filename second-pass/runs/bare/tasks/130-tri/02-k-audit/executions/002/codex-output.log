e ) [function]\n+                 | compare ( Value , CmpOps , Int , Program ) [function]\n+  syntax Bool ::= asBool ( Value ) [function]\n+  syntax IntSeq ::= append ( IntSeq , IntSeq ) [function]\n+                  | evalExprs ( Exprs , Int , Program ) [function]\n+\n+  rule <k> run(P, N) => evalCall(P, \"tri\", N) ... </k>\n+\n+  rule evalCall(Module(DEFS), F, N)\n+    => findCall(DEFS, F, N, Module(DEFS))\n+\n+  rule findCall(FuncDef(F, Params(X), BODY) REST, F, N, P)\n+    => evalStmts(BODY, N, P)\n+  rule findCall(FuncDef(G, Params(X), BODY) REST, F, N, P)\n+    => findCall(REST, F, N, P)\n+    requires G =/=String F\n+\n+  rule evalStmts(.Stmts, N, P) => fellThrough\n+  rule evalStmts(Return(E) REST, N, P) => returned(eval(E, N, P))\n+  rule evalStmts(If(C, THEN, ELSE) REST, N, P)\n+    => evalBranch(asBool(eval(C, N, P)), THEN, ELSE, REST, N, P)\n+\n+  rule evalBranch(true,  THEN, ELSE, REST, N, P)\n+    => evalAfter(evalStmts(THEN, N, P), REST, N, P)\n+  rule evalBranch(false, THEN, ELSE, REST, N, P)\n+    => evalAfter(evalStmts(ELSE, N, P), REST, N, P)\n+\n+  rule evalAfter(returned(V), REST, N, P) => returned(V)\n+  rule evalAfter(fellThrough, REST, N, P) => evalStmts(REST, N, P)\n+\n+  rule eval(Int(I), N, P) => IVal(I)\n+  rule eval(Name(\"n\"), N, P) => IVal(N)\n+  rule eval(BinOp(OP, L, R), N, P)\n+    => bin(OP, eval(L, N, P), eval(R, N, P))\n+  rule eval(Compare(L, OPS), N, P)\n+    => compare(eval(L, N, P), OPS, N, P)\n+  rule eval(ListExpr(ES), N, P) => LVal(evalExprs(ES, N, P))\n+  rule eval(Call(Name(F), ARG), N, P)\n+    => evalCall(P, F, asInt(eval(ARG, N, P)))\n+\n+  syntax Int ::= asInt ( Value ) [function]\n+  rule asInt(IVal(I)) => I\n+  rule asBool(BVal(B)) => B\n+\n+  rule bin(\"+\", IVal(A), IVal(B)) => IVal(A +Int B)\n+  rule bin(\"-\", IVal(A), IVal(B)) => IVal(A -Int B)\n+  rule bin(\"*\", IVal(A), IVal(B)) => IVal(A *Int B)\n+  rule bin(\"%\", IVal(A), IVal(B)) => IVal(A %Int B)\n+  rule bin(\"//\", IVal(A), IVal(B)) => IVal(A /Int B)\n+  rule bin(\"+\", LVal(XS), LVal(YS)) => LVal(append(XS, YS))\n+\n+  rule compare(IVal(A), CmpOp(\"==\", R), N, P)\n+    => BVal(A ==Int asInt(eval(R, N, P)))\n+\n+  rule evalExprs(.Exprs, N, P) => nil\n+  rule evalExprs(E, N, P) => cons(asInt(eval(E, N, P)), nil)\n+  rule evalExprs((E, ES), N, P)\n+    => cons(asInt(eval(E, N, P)), evalExprs(ES, N, P))\n+\n+  rule append(nil, YS) => YS\n+  rule append(cons(X, XS), YS) => cons(X, append(XS, YS))\n+endmodule\n*** End Patch";
