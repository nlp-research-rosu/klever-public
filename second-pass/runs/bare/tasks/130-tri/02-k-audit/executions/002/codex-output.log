const patch = "*** Begin Patch\n*** Update File: /work/semantic.k\n@@\n   syntax Result ::= evalCall ( Program , String , Int ) [function]\n                   | findCall ( Stmts , String , Int , Program ) [function]\n                   | evalStmts ( Stmts , Int , Program ) [function]\n-                  | evalBranch ( Bool , Stmts , Stmts , Stmts , Int , Program ) [function]\n                   | evalAfter ( Result , Stmts , Int , Program ) [function]\n@@\n-  rule evalStmts(If(C, THEN, ELSE) REST, N, P)\n-    => evalBranch(asBool(eval(C, N, P)), THEN, ELSE, REST, N, P)\n-\n-  rule evalBranch(true,  THEN, ELSE, REST, N, P)\n+  rule evalStmts(If(C, THEN, ELSE) REST, N, P)\n     => evalAfter(evalStmts(THEN, N, P), REST, N, P)\n-  rule evalBranch(false, THEN, ELSE, REST, N, P)\n+    requires asBool(eval(C, N, P))\n+  rule evalStmts(If(C, THEN, ELSE) REST, N, P)\n     => evalAfter(evalStmts(ELSE, N, P), REST, N, P)\n+    requires notBool asBool(eval(C, N, P))\n*** End Patch";
text(await tools.apply_patch(patch));
