const patch = "*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module TRI-VERIFICATION\n+  imports TRI-SEMANTIC\n+\n+  // This macro is the exact constructor tree emitted in solution.mpy.\n+  syntax Program ::= \"solutionProgram\" [macro]\n+  rule solutionProgram =>\n+    Module(\n+      FuncDef(\"tri\", Params(\"n\"),\n+        If(Compare(Name(\"n\"), CmpOp(\"==\", Int(0))),\n+          Return(ListExpr(Int(1))),\n+          .Stmts)\n+        If(Compare(BinOp(\"%\", Name(\"n\"), Int(2)),\n+                   CmpOp(\"==\", Int(0))),\n+          Return(\n+            BinOp(\"+\",\n+              Call(Name(\"tri\"), BinOp(\"-\", Name(\"n\"), Int(1))),\n+              ListExpr(BinOp(\"+\", Int(1),\n+                             BinOp(\"//\", Name(\"n\"), Int(2)))))),\n+          .Stmts)\n+        Return(\n+          BinOp(\"+\",\n+            Call(Name(\"tri\"), BinOp(\"-\", Name(\"n\"), Int(1))),\n+            ListExpr(\n+              BinOp(\"*\",\n+                BinOp(\"//\", BinOp(\"+\", Name(\"n\"), Int(1)), Int(2)),\n+                BinOp(\"//\", BinOp(\"+\", Name(\"n\"), Int(5)), Int(2))))))))\n+    [macro]\n+\n+  // Mathematical sequence value.  The odd clause is the closed form of the\n+  // prompt's recurrence; the two rules are exhaustive for N >= 0.\n+  syntax Int ::= triValue ( Int ) [function]\n+  rule triValue(N) => 1 +Int (N /Int 2)\n+    requires N >=Int 0 andBool N %Int 2 ==Int 0\n+  rule triValue(N) => ((N +Int 1) /Int 2) *Int ((N +Int 5) /Int 2)\n+    requires N >=Int 0 andBool N %Int 2 =/=Int 0\n+\n+  syntax IntSeq ::= triPrefix ( Int ) [function]\n+  rule triPrefix(0) => cons(1, nil)\n+  rule triPrefix(N) => append(triPrefix(N -Int 1), cons(triValue(N), nil))\n+    requires N >Int 0\n+\n+  syntax Int ::= seqLength ( IntSeq ) [function]\n+  rule seqLength(nil) => 0\n+  rule seqLength(cons(I, IS)) => 1 +Int seqLength(IS)\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module TRI-SPEC\n+  imports TRI-VERIFICATION\n+\n+  // End-to-end functional correctness of the translated Python constructor\n+  // program for every input allowed by the prompt.\n+  claim evalCall(solutionProgram, \"tri\", N)\n+      => returned(LVal(triPrefix(N)))\n+    requires N >=Int 0\n+\n+  // The returned prefix has exactly n + 1 elements.\n+  claim seqLength(triPrefix(N)) => N +Int 1\n+    requires N >=Int 0\n+\n+  // Base values and both branches of the stated recurrence.\n+  claim triValue(0) => 1\n+  claim triValue(1) => 3\n+  claim triValue(N) => 1 +Int (N /Int 2)\n+    requires N >=Int 2 andBool N %Int 2 ==Int 0\n+  claim triValue(N)\n+      => triValue(N -Int 1) +Int triValue(N -Int 2) +Int triValue(N +Int 1)\n+    requires N >=Int 3 andBool N %Int 2 =/=Int 0\n+endmodule\n*** End Patch";
