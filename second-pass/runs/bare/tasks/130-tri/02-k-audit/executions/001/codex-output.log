diff --git a/evidence/positive-claims/spec-value-even.k b/evidence/positive-claims/spec-value-even.k
new file mode 100644
index 0000000000000000000000000000000000000000..32d6806f8386207beaaf03e92f75a7f0aa08643a
--- /dev/null
+++ b/evidence/positive-claims/spec-value-even.k
@@ -0,0 +1,7 @@
+requires "/tmp/audit-work/130-tri/candidate/verification.k"
+
