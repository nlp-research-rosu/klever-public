+  /candidate/verification.k \
+  /candidate/spec.k \
+  /candidate/prove.sh \
+  "$scratch/candidate/"
+
+cp -a \
+  /reference/prompt.py \
+  /reference/canonical.py \
+  /reference/py2mpy.py \
+  "$scratch/reference/"
+
+find "$scratch" -maxdepth 3 -printf '%y %p -> %l\n' | sort
