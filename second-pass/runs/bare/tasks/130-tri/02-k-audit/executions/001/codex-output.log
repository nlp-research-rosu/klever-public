+#!/usr/bin/env bash
+set -euo pipefail
+trap 'status=$?; printf "[audit] exit_status=%s\n" "$status"' EXIT
+set -x
+
+scratch=/tmp/audit-work/130-tri
+test ! -e "$scratch"
+mkdir -p "$scratch/candidate" "$scratch/reference" "$scratch/build"
+
