+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Ints ::= ".Ints"
+                | Int ";" Ints
+
+  syntax PyVal ::= "VInt" "(" Int ")"
+                 | "VBool" "(" Bool ")"
+                 | "VList" "(" Ints ")"
+
+  syntax Result ::= "noResult" | "result" "(" PyVal ")"
+  syntax Fun ::= "function" "(" Params "," Stmts ")"
+
+  syntax Expr ::= "Value" "(" PyVal ")"
+
+  syntax KItem ::= "load" "(" Stmts ")"
+                 | "start"
+                 | "eval" "(" Expr "," Map ")"
+                 | "unaryK" "(" String ")"
+                 | "binLeftK" "(" String "," Expr "," Map ")"
+                 | "binRightK" "(" String "," PyVal ")"
+                 | "subscriptLeftK" "(" Expr "," Map ")"
+                 | "subscriptRightK" "(" PyVal ")"
+                 | "compareLeftK" "(" String "," Expr "," Map ")"
+                 | "compareRightK" "(" String "," PyVal ")"
+                 | "call1K" "(" String ")"
+                 | "call2LeftK" "(" String "," Expr "," Map ")"
+                 | "call2RightK" "(" String "," PyVal ")"
+                 | "invoke1" "(" String "," PyVal ")"
+                 | "invoke2" "(" String "," PyVal "," PyVal ")"
+                 | "exec" "(" Stmts "," Map ")"
+                 | "ifK" "(" Stmts "," Stmts "," Stmts "," Map ")"
+                 | "finish"
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <funs> .Map </funs>
+      <env> .Map </env>
+      <input> $INPUT:PyVal </input>
+      <result> noResult </result>
+    </mpy>
+
+  rule <k> Module(SS) => load(SS) ... </k>
+
+  rule <k> load(FuncDef(F, PS, BODY) REST) => load(REST) ... </k>
+       <funs> FUNS => FUNS [ F <- function(PS, BODY) ] </funs>
+
+  rule <k> load(.Stmts) => start ... </k>
+
+  rule <k> start => eval(Call(Name("triples_sum_to_zero"), Value(V)), .Map)
+                    ~> finish ... </k>
+       <input> V </input>
+
+  rule <k> V:PyVal ~> finish => .K </k>
+       <result> noResult => result(V) </result>
+
+  rule eval(Value(V), _) => V
+  rule eval(Bool(B), _) => VBool(B)
+  rule eval(Int(I), _) => VInt(I)
+  rule eval(Name(X), RHO) => RHO [ X ]
+
+  rule eval(UnaryOp(OP, E), RHO) => eval(E, RHO) ~> unaryK(OP)
+  rule VList(.Ints) ~> unaryK("not") => VBool(true)
+  rule VList(_ ; _) ~> unaryK("not") => VBool(false)
+  rule VBool(B) ~> unaryK("not") => VBool(notBool B)
+
+  rule eval(BinOp(OP, E1, E2), RHO)
+    => eval(E1, RHO) ~> binLeftK(OP, E2, RHO)
+  rule V1:PyVal ~> binLeftK(OP, E2, RHO)
+    => eval(E2, RHO) ~> binRightK(OP, V1)
+  rule VInt(I2) ~> binRightK("-", VInt(I1)) => VInt(I1 -Int I2)
+  rule VInt(I2) ~> binRightK("+", VInt(I1)) => VInt(I1 +Int I2)
+
+  rule eval(Subscript(BASE, INDEX), RHO)
+    => eval(BASE, RHO) ~> subscriptLeftK(INDEX, RHO)
+  rule V:PyVal ~> subscriptLeftK(INDEX, RHO)
+    => eval(INDEX, RHO) ~> subscriptRightK(V)
+  rule VInt(0) ~> subscriptRightK(VList(I ; _)) => VInt(I)
+  rule eval(Slice(Int(1), NoBound, NoBound), _) => VInt(1)
+  rule VInt(1) ~> subscriptRightK(VList(_ ; IS)) => VList(IS)
+
+  rule eval(Compare(E1, CmpOp(OP, E2)), RHO)
+    => eval(E1, RHO) ~> compareLeftK(OP, E2, RHO)
+  rule V1:PyVal ~> compareLeftK(OP, E2, RHO)
+    => eval(E2, RHO) ~> compareRightK(OP, V1)
+  rule VList(IS) ~> compareRightK("in", VInt(I))
+    => VBool(memberInt(I, IS))
+
+  syntax Bool ::= memberInt(Int, Ints) [function, total]
+  rule memberInt(_, .Ints) => false
+  rule memberInt(I, J ; IS)
+    => (I ==Int J) orBool memberInt(I, IS)
+
+  rule eval(Call(Name(F), E), RHO)
+    => eval(E, RHO) ~> call1K(F)
+  rule V:PyVal ~> call1K(F) => invoke1(F, V)
+
+  rule eval(Call(Name(F), E1, E2), RHO)
+    => eval(E1, RHO) ~> call2LeftK(F, E2, RHO)
+  rule V1:PyVal ~> call2LeftK(F, E2, RHO)
+    => eval(E2, RHO) ~> call2RightK(F, V1)
+  rule V2:PyVal ~> call2RightK(F, V1) => invoke2(F, V1, V2)
+
+  rule <k> invoke1(F, V) => exec(BODY, X |-> V) ... </k>
+       <funs> ... F |-> function(Params(X, .Ids), BODY) ... </funs>
+
+  rule <k> invoke2(F, V1, V2)
+            => exec(BODY, (X |-> V1) (Y |-> V2)) ... </k>
+       <funs> ... F |-> function(Params(X, Y, .Ids), BODY) ... </funs>
+
+  rule exec(Return(E) _, RHO) => eval(E, RHO)
+
+  rule exec(If(E, THEN, ELSE) REST, RHO)
+    => eval(E, RHO) ~> ifK(THEN, ELSE, REST, RHO)
+  rule VBool(B) ~> ifK(Return(E) .Stmts, .Stmts, _REST:Stmts, RHO:Map)
+    => eval(E, RHO)
+    requires B
+  rule VBool(B) ~> ifK(_THEN:Stmts, .Stmts, REST:Stmts, RHO:Map)
+    => exec(REST, RHO)
+    requires notBool B
+  rule exec(.Stmts, _) => VBool(false)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cd92a29e53a9d3d8fc00abeede0e9726798102bd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def _has_pair_sum(first: int, rest: list):
+    if not rest:
+        return False
+    if 0 - first - rest[0] in rest[1:]:
+        return True
+    return _has_pair_sum(first, rest[1:])
+
+
+def triples_sum_to_zero(l: list):
+    if not l:
+        return False
+    if _has_pair_sum(l[0], l[1:]):
+        return True
+    return triples_sum_to_zero(l[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f83816047a22cbd3758ff48574a08122e366d083
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Lemma 1: the helper exhaustively checks all pairs following FIRST.
+  claim [pair-correct]:
+    <mpy>
+      <k> invoke2("_has_pair_sum", VInt(FIRST), VList(IS)) ~> RESTK
+        => VBool(hasPairWith(FIRST, IS)) ~> RESTK </k>
+      <funs> solutionFunctions </funs>
+      <env> ENV </env>
+      <input> INPUT </input>
+      <result> RESULT </result>
+    </mpy>
+
+  // Lemma 2: the entry point exhaustively checks every possible first
+  // position, using pair-correct for the remaining two positions.
+  claim [triples-correct]:
+    <mpy>
+      <k> invoke1("triples_sum_to_zero", VList(IS)) ~> RESTK
+        => VBool(hasZeroTriple(IS)) ~> RESTK </k>
+      <funs> solutionFunctions </funs>
+      <env> ENV </env>
+      <input> INPUT </input>
+      <result> RESULT </result>
+    </mpy>
+
+  // The exact solution.mpy tree, from a fresh semantics configuration, meets
+  // the HumanEval contract for every finite list of mathematical integers.
+  claim [program-correct]:
+    <mpy>
+      <k> solutionProgram => .K </k>
+      <funs> .Map => solutionFunctions </funs>
+      <env> .Map </env>
+      <input> VList(IS) </input>
+      <result> noResult => result(VBool(hasZeroTriple(IS))) </result>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..84588474a69ae43d76ae3d66c0345ac3d55333ce
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,81 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // These three constants quote the exact source tree.  They let helper
+  // claims name execution states without weakening the program pattern.
+  syntax Stmts ::= "pairBody" [function]
+                 | "tripleBody" [function]
+  syntax Program ::= "solutionProgram" [function]
+  syntax Map ::= "solutionFunctions" [function]
+
+  rule pairBody =>
+    If(UnaryOp("not", Name("rest")),
+      Return(Bool(false)) .Stmts,
+      .Stmts)
+    If(Compare(
+      BinOp(
+        "-",
+        BinOp("-", Int(0), Name("first")),
+        Subscript(Name("rest"), Int(0))),
+      CmpOp(
+        "in",
+        Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound))),
+      .CmpOps),
+      Return(Bool(true)) .Stmts,
+      .Stmts)
+    Return(
+      Call(
+        Name("_has_pair_sum"),
+        Name("first"),
+        Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound)),
+        .Exprs))
+    .Stmts
+
+  rule tripleBody =>
+    If(UnaryOp("not", Name("l")),
+      Return(Bool(false)) .Stmts,
+      .Stmts)
+    If(Call(
+      Name("_has_pair_sum"),
+      Subscript(Name("l"), Int(0)),
+      Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+      .Exprs),
+      Return(Bool(true)) .Stmts,
+      .Stmts)
+    Return(
+      Call(
+        Name("triples_sum_to_zero"),
+        Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+        .Exprs))
+    .Stmts
+
+  rule solutionProgram =>
+    Module(
+      FuncDef(
+        "_has_pair_sum", Params("first", "rest", .Ids), pairBody)
+      FuncDef(
+        "triples_sum_to_zero", Params("l", .Ids), tripleBody)
+      .Stmts)
+
+  rule solutionFunctions =>
+    ("_has_pair_sum" |->
+      function(Params("first", "rest", .Ids), pairBody))
+    ("triples_sum_to_zero" |->
+      function(Params("l", .Ids), tripleBody))
+
+  // Independent mathematical specification: choose a first position, then a
+  // later second position, then test for the required value at a later third
+  // position.  Thus the three positions are necessarily distinct.
+  syntax Bool ::= hasPairWith(Int, Ints) [function, total]
+                | hasZeroTriple(Ints) [function, total]
+
+  rule hasPairWith(_, .Ints) => false
+  rule hasPairWith(I, J ; IS)
+    => memberInt(0 -Int I -Int J, IS) orBool hasPairWith(I, IS)
+
+  rule hasZeroTriple(.Ints) => false
+  rule hasZeroTriple(I ; IS)
+    => hasPairWith(I, IS) orBool hasZeroTriple(IS)
+endmodule

exec
/bin/bash -lc 'kompile verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --backend haskell -o .kprove && kprove spec.k --definition .kprove --spec-module SPEC --output pretty' in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..7d1a0e20755bcbd29f8e056ad4ea252ed45367df
