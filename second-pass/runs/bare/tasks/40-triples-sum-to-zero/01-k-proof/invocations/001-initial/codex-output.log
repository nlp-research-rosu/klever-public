+  rule exec(If(E, THEN, ELSE) REST, RHO)
+    => eval(E, RHO) ~> ifK(THEN, ELSE, REST, RHO)
+  rule VBool(true) ~> ifK(Return(E) .Stmts, .Stmts, _REST:Stmts, RHO:Map)
+    => eval(E, RHO)
+  rule VBool(false) ~> ifK(_THEN:Stmts, .Stmts, REST:Stmts, RHO:Map)
+    => exec(REST, RHO)
+  rule exec(.Stmts, _) => VBool(false)
+endmodule
