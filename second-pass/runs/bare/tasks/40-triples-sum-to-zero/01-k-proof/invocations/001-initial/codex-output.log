diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cd92a29e53a9d3d8fc00abeede0e9726798102bd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def _has_pair_sum(first: int, rest: list):
+    if not rest:
+        return False
+    if 0 - first - rest[0] in rest[1:]:
+        return True
+    return _has_pair_sum(first, rest[1:])
+
+
+def triples_sum_to_zero(l: list):
+    if not l:
+        return False
+    if _has_pair_sum(l[0], l[1:]):
+        return True
+    return triples_sum_to_zero(l[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d80dd3539794f8ed92dbb167c4a9abb44ffc500e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,58 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Full functional correctness for every finite integer sequence IS.  The
+  // left-hand program is the exact constructor tree emitted in solution.mpy.
+  claim <mpy>
+    <k>
+      Module(
+        FuncDef("_has_pair_sum", Params("first", "rest", .Ids),
+          If(UnaryOp("not", Name("rest")),
+            Return(Bool(false)) .Stmts,
+            .Stmts)
+          If(Compare(
+            BinOp(
+              "-",
+              BinOp("-", Int(0), Name("first")),
+              Subscript(Name("rest"), Int(0))),
+            CmpOp(
+              "in",
+              Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound))),
+              .CmpOps),
+            Return(Bool(true)) .Stmts,
+            .Stmts)
+          Return(
+            Call(
+              Name("_has_pair_sum"),
+              Name("first"),
+              Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound)),
+              .Exprs))
+          .Stmts)
+        FuncDef("triples_sum_to_zero", Params("l", .Ids),
+          If(UnaryOp("not", Name("l")),
+            Return(Bool(false)) .Stmts,
+            .Stmts)
+          If(Call(
+            Name("_has_pair_sum"),
+            Subscript(Name("l"), Int(0)),
+            Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+            .Exprs),
+            Return(Bool(true)) .Stmts,
+            .Stmts)
+          Return(
+            Call(
+              Name("triples_sum_to_zero"),
+              Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+              .Exprs))
+          .Stmts)
+        .Stmts)
+      => .K
+    </k>
+    <funs> .Map => ?FUNS </funs>
+    <env> .Map </env>
+    <input> VList(IS) </input>
+    <result> noResult => result(VBool(hasZeroTriple(IS))) </result>
+  </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f29566bf979927010e91b9715672421e1629639b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,24 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The mathematical specification chooses three positions in increasing
+  // order.  Each recursive call discards one earlier position, so repeated
+  // integer values at distinct positions remain available independently.
+  syntax Bool ::= containsInt(Int, Ints) [function]
+                | hasPairWith(Int, Ints) [function]
+                | hasZeroTriple(Ints) [function]
+
+  rule containsInt(_, .Ints) => false
+  rule containsInt(I, J ; IS)
+    => (I ==Int J) orBool containsInt(I, IS)
+
+  rule hasPairWith(_, .Ints) => false
+  rule hasPairWith(I, J ; IS)
+    => containsInt(0 -Int I -Int J, IS) orBool hasPairWith(I, IS)
+
+  rule hasZeroTriple(.Ints) => false
+  rule hasZeroTriple(I ; IS)
+    => hasPairWith(I, IS) orBool hasZeroTriple(IS)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition .kprove --spec-module SPEC --output pretty' in /work
