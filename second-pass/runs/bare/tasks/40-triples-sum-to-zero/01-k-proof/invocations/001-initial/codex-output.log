/bin/bash -lc "kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm -o .kbuild && for input in '1 ; 3 ; 5 ; 0 ; .Ints' '1 ; 3 ; -2 ; 1 ; .Ints' '1 ; 2 ; 3 ; 7 ; .Ints' '2 ; 4 ; -5 ; 3 ; 9 ; 7 ; .Ints' '1 ; .Ints' '.Ints' '0 ; 0 ; 0 ; .Ints' '0 ; 0 ; .Ints'; do echo INPUT="'$input; krun solution.mpy --definition .kbuild -cINPUT="VList($input)" --output pretty | rg -A2 '"'<result>'; done" in /work
