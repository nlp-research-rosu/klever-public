+  syntax Bool ::= containsInt(Int, Ints) [function]
+                | hasPairWith(Int, Ints) [function]
+                | hasZeroTriple(Ints) [function]
+
+  rule containsInt(_, .Ints) => false
+  rule containsInt(I, J ; IS)
+    => (I ==Int J) orBool containsInt(I, IS)
+
+  rule hasPairWith(_, .Ints) => false
+  rule hasPairWith(I, J ; IS)
+    => containsInt(0 -Int I -Int J, IS) orBool hasPairWith(I, IS)
+
+  rule hasZeroTriple(.Ints) => false
+  rule hasZeroTriple(I ; IS)
+    => hasPairWith(I, IS) orBool hasZeroTriple(IS)
+endmodule

