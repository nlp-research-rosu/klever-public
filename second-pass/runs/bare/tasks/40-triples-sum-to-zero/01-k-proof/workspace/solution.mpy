Module(
  FuncDef("_has_pair_sum", Params("first", "rest"),
    If(UnaryOp("not", Name("rest")),
      Return(Bool(false)),
      )
    If(Compare(
      BinOp(
        "-",
        BinOp("-", Int(0), Name("first")),
        Subscript(Name("rest"), Int(0))),
      CmpOp(
        "in",
        Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound)))),
      Return(Bool(true)),
      )
    Return(
      Call(
        Name("_has_pair_sum"),
        Name("first"),
        Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound)))))
  FuncDef("triples_sum_to_zero", Params("l"),
    If(UnaryOp("not", Name("l")),
      Return(Bool(false)),
      )
    If(Call(
      Name("_has_pair_sum"),
      Subscript(Name("l"), Int(0)),
      Subscript(Name("l"), Slice(Int(1), NoBound, NoBound))),
      Return(Bool(true)),
      )
    Return(
      Call(
        Name("triples_sum_to_zero"),
        Subscript(Name("l"), Slice(Int(1), NoBound, NoBound))))))
