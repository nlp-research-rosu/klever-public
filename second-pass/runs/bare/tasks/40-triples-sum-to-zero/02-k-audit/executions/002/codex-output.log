+
+  claim
+    <mpy>
+      <k> VBool(hasZeroTriple(.Ints)) => VBool(false) </k>
+      <funs> _FUNS </funs>
+      <env> _ENV </env>
+      <input> _INPUT </input>
+      <result> _RESULT </result>
+    </mpy>
+
+  claim
+    <mpy>
