+        f"python={python_result!r} k={k_result!r} same={same}"
+    )
+    print(f"krun_command={shlex.join(command)}")
+
+print(f"case_count={len(cases)} mismatch_count={mismatches}")
+raise SystemExit(1 if mismatches else 0)
