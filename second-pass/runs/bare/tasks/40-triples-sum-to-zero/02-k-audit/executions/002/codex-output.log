diff --git a/evidence/invalid-filter-diagnostic-note.md b/evidence/invalid-filter-diagnostic-note.md
new file mode 100644
index 0000000000000000000000000000000000000000..24217b24564faa3efbb2723f31f733ec7bf7ebfc
--- /dev/null
+++ b/evidence/invalid-filter-diagnostic-note.md
@@ -0,0 +1,17 @@
+# Invalid filtered-claim diagnostic
+
+Two exploratory commands selected only `SPEC.triples-correct` or only
+`SPEC.program-correct` with `--claims`. That filtering also removed the
+preceding circularities on which each selected claim depends, so the commands
+unrolled recursion instead of testing the candidate's dependency-preserving
+proof. They were abandoned and are not proof evidence. Their command headers
+are retained in `invalid-filter-triples-correct.log` and
+`invalid-filter-program-correct.log`.
+
+The valid independent runs are:
+
+- `kprove-pair-correct.log`: pair claim alone;
+- `kprove-pair-and-triples.log`: pair and triples claims together, excluding
+  only the program claim; and
+- `kprove-all-positive.log`: all three claims together, including every
+  needed circularity.
diff --git a/evidence/pinning-spec.k b/evidence/pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..649953602a8d60f5559df927cc6ed20f70441468
--- /dev/null
+++ b/evidence/pinning-spec.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // The right-hand side is the trusted-translator output in
+  // regenerated-solution.mpy, represented with explicit empty-list tails.
+  claim
+    <mpy>
+      <k> solutionProgram =>
+        Module(
+      FuncDef("_has_pair_sum", Params("first", "rest", .Ids),
+        If(UnaryOp("not", Name("rest")),
+          Return(Bool(false)) .Stmts,
+          .Stmts)
+        If(Compare(
+          BinOp(
+            "-",
+            BinOp("-", Int(0), Name("first")),
+            Subscript(Name("rest"), Int(0))),
+          CmpOp(
+            "in",
+            Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound))),
+          .CmpOps),
+          Return(Bool(true)) .Stmts,
+          .Stmts)
+        Return(
+          Call(
+            Name("_has_pair_sum"),
+            Name("first"),
+            Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound)),
+            .Exprs))
+        .Stmts)
+      FuncDef("triples_sum_to_zero", Params("l", .Ids),
+        If(UnaryOp("not", Name("l")),
+          Return(Bool(false)) .Stmts,
+          .Stmts)
+        If(Call(
+          Name("_has_pair_sum"),
+          Subscript(Name("l"), Int(0)),
+          Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+          .Exprs),
+          Return(Bool(true)) .Stmts,
+          .Stmts)
+        Return(
+          Call(
+            Name("triples_sum_to_zero"),
+            Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+            .Exprs))
+        .Stmts)
+        .Stmts) </k>
+      <funs> _FUNS </funs>
+      <env> _ENV </env>
+      <input> _INPUT </input>
+      <result> _RESULT </result>
+    </mpy>
+endmodule
