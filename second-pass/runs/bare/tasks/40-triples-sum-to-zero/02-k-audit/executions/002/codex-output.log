diff --git a/evidence/pinning-spec.k b/evidence/pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..649953602a8d60f5559df927cc6ed20f70441468
--- /dev/null
+++ b/evidence/pinning-spec.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // The right-hand side is the trusted-translator output in
+  // regenerated-solution.mpy, represented with explicit empty-list tails.
+  claim
+    <mpy>
+      <k> solutionProgram =>
+        Module(
+      FuncDef("_has_pair_sum", Params("first", "rest", .Ids),
+        If(UnaryOp("not", Name("rest")),
+          Return(Bool(false)) .Stmts,
+          .Stmts)
+        If(Compare(
+          BinOp(
+            "-",
+            BinOp("-", Int(0), Name("first")),
+            Subscript(Name("rest"), Int(0))),
+          CmpOp(
+            "in",
+            Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound))),
+          .CmpOps),
+          Return(Bool(true)) .Stmts,
+          .Stmts)
+        Return(
+          Call(
+            Name("_has_pair_sum"),
+            Name("first"),
+            Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound)),
+            .Exprs))
+        .Stmts)
+      FuncDef("triples_sum_to_zero", Params("l", .Ids),
+        If(UnaryOp("not", Name("l")),
+          Return(Bool(false)) .Stmts,
+          .Stmts)
+        If(Call(
+          Name("_has_pair_sum"),
+          Subscript(Name("l"), Int(0)),
+          Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+          .Exprs),
+          Return(Bool(true)) .Stmts,
+          .Stmts)
+        Return(
+          Call(
+            Name("triples_sum_to_zero"),
+            Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+            .Exprs))
+        .Stmts)
+        .Stmts) </k>
+      <funs> _FUNS </funs>
+      <env> _ENV </env>
+      <input> _INPUT </input>
+      <result> _RESULT </result>
+    </mpy>
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d2c0bd3b6d8351db861c91b4e387f3be0bf6712a
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path="$1"
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_path"
+
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %d\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..8f2311d10322b4f3dedb521a1c0bc2976bdaef7b
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  claim [pair-correct]:
+    <mpy>
+      <k> invoke2("_has_pair_sum", VInt(FIRST), VList(IS)) ~> RESTK
+        => VBool(hasPairWith(FIRST, IS)) ~> RESTK </k>
+      <funs> solutionFunctions </funs>
+      <env> _ENV </env>
+      <input> _INPUT </input>
+      <result> _RESULT </result>
+    </mpy>
+
+  claim [triples-correct]:
+    <mpy>
+      <k> invoke1("triples_sum_to_zero", VList(IS)) ~> RESTK
+        => VBool(hasZeroTriple(IS)) ~> RESTK </k>
+      <funs> solutionFunctions </funs>
+      <env> _ENV </env>
+      <input> _INPUT </input>
+      <result> _RESULT </result>
+    </mpy>
+
+  // Fresh false mutation: require the opposite Boolean result.  Empty input
+  // is a satisfying witness: execution returns false, while this asks true.
+  claim [program-false-opposite]:
+    <mpy>
+      <k> solutionProgram => .K </k>
+      <funs> .Map => solutionFunctions </funs>
+      <env> .Map </env>
+      <input> VList(IS) </input>
+      <result> noResult
+        => result(VBool(notBool hasZeroTriple(IS))) </result>
+    </mpy>
+endmodule
