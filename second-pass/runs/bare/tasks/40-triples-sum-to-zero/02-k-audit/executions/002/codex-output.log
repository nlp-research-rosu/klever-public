+    </mpy>
+
+  claim
+    <mpy>
+      <k> VBool(hasZeroTriple(1 ; 2 ; 3 ; 7 ; .Ints))
+        => VBool(false) </k>
+      <funs> _FUNS </funs>
+      <env> _ENV </env>
+      <input> _INPUT </input>
+      <result> _RESULT </result>
