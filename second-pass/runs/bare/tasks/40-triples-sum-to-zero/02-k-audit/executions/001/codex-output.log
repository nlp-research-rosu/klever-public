efinition .kprove\n\nkprove spec.k \\\n  --definition .kprove \\\n  --spec-module SPEC \\\n  --output pretty\n"},"/work/spec.k":{"type":"update","unified_diff":"@@ -11,5 +11,5 @@\n       <funs> solutionFunctions </funs>\n-      <env> ENV </env>\n-      <input> INPUT </input>\n-      <result> RESULT </result>\n+      <env> _ENV </env>\n+      <input> _INPUT </input>\n+      <result> _RESULT </result>\n     </mpy>\n@@ -23,5 +23,5 @@\n       <funs> solutionFunctions </funs>\n-      <env> ENV </env>\n-      <input> INPUT </input>\n-      <result> RESULT </result>\n+      <env> _ENV </env>\n+      <input> _INPUT </input>\n+      <result> _RESULT </result>\n     </mpy>\n","move_path":null}},"status":"completed"}}
