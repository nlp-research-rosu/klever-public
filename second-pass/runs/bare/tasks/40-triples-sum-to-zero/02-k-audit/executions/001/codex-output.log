+        Name("first"),
+        Subscript(
+          Name("rest"),
+          Slice(Int(1), NoBound, NoBound)),
+        .Exprs))
+    .Stmts)
+  FuncDef(
+    "triples_sum_to_zero",
+    Params("l", .Ids),
+    If(
+      UnaryOp("not", Name("l")),
+      Return(Bool(false)) .Stmts,
+      .Stmts)
+    If(
+      Call(
+        Name("_has_pair_sum"),
+        Subscript(Name("l"), Int(0)),
+        Subscript(
+          Name("l"),
+          Slice(Int(1), NoBound, NoBound)),
+        .Exprs),
+      Return(Bool(true)) .Stmts,
+      .Stmts)
+    Return(
+      Call(
+        Name("triples_sum_to_zero"),
+        Subscript(
+          Name("l"),
+          Slice(Int(1), NoBound, NoBound)),
+        .Exprs))
+    .Stmts)
+  .Stmts)
