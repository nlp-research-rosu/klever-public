     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // These three constants quote the exact source tree.  They let helper
     7	  // claims name execution states without weakening the program pattern.
     8	  syntax Stmts ::= "pairBody" [function]
     9	                 | "tripleBody" [function]
    10	  syntax Program ::= "solutionProgram" [function]
    11	  syntax Map ::= "solutionFunctions" [function]
    12	
    13	  rule pairBody =>
    14	    If(UnaryOp("not", Name("rest")),
    15	      Return(Bool(false)) .Stmts,
    16	      .Stmts)
    17	    If(Compare(
    18	      BinOp(
    19	        "-",
    20	        BinOp("-", Int(0), Name("first")),
    21	        Subscript(Name("rest"), Int(0))),
    22	      CmpOp(
    23	        "in",
    24	        Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound))),
    25	      .CmpOps),
    26	      Return(Bool(true)) .Stmts,
    27	      .Stmts)
    28	    Return(
    29	      Call(
    30	        Name("_has_pair_sum"),
    31	        Name("first"),
    32	        Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound)),
    33	        .Exprs))
    34	    .Stmts
    35	
    36	  rule tripleBody =>
    37	    If(UnaryOp("not", Name("l")),
    38	      Return(Bool(false)) .Stmts,
    39	      .Stmts)
    40	    If(Call(
    41	      Name("_has_pair_sum"),
    42	      Subscript(Name("l"), Int(0)),
    43	      Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
    44	      .Exprs),
    45	      Return(Bool(true)) .Stmts,
    46	      .Stmts)
    47	    Return(
    48	      Call(
    49	        Name("triples_sum_to_zero"),
    50	        Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
    51	        .Exprs))
    52	    .Stmts
    53	
    54	  rule solutionProgram =>
    55	    Module(
    56	      FuncDef(
    57	        "_has_pair_sum", Params("first", "rest", .Ids), pairBody)
    58	      FuncDef(
    59	        "triples_sum_to_zero", Params("l", .Ids), tripleBody)
    60	      .Stmts)
    61	
    62	  rule solutionFunctions =>
    63	    ("_has_pair_sum" |->
    64	      function(Params("first", "rest", .Ids), pairBody))
    65	    ("triples_sum_to_zero" |->
    66	      function(Params("l", .Ids), tripleBody))
    67	
    68	  // Independent mathematical specification: choose a first position, then a
    69	  // later second position, then test for the required value at a later third
    70	  // position.  Thus the three positions are necessarily distinct.
    71	  syntax Bool ::= hasPairWith(Int, Ints) [function, total]
    72	                | hasZeroTriple(Ints) [function, total]
    73	
    74	  rule hasPairWith(_, .Ints) => false
    75	  rule hasPairWith(I, J ; IS)
    76	    => memberInt(0 -Int I -Int J, IS) orBool hasPairWith(I, IS)
    77	
    78	  rule hasZeroTriple(.Ints) => false
    79	  rule hasZeroTriple(I ; IS)
    80	    => hasPairWith(I, IS) orBool hasZeroTriple(IS)
