#!/usr/bin/env python3
"""Model-free Stage 6 gate for Klean classification and optional proof."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Callable

REPO = Path(__file__).resolve().parent.parent
if str(REPO) not in sys.path:
    sys.path.insert(0, str(REPO))

from tools import (
    klean_export,
    klean_preflight,
    pipeline_contract,
    stage6_resolution_contract,
)


class KleanFinalGateError(RuntimeError):
    pass


def _run(
    command: list[str],
    *,
    cwd: Path,
    timeout: int,
) -> tuple[int, str]:
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            timeout=timeout,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        return result.returncode, result.stdout
    except subprocess.TimeoutExpired:
        return 124, f"TIMEOUT after {timeout}s"


def _regular_json(path: Path, label: str) -> dict[str, Any]:
    if not path.is_file() or path.is_symlink():
        raise KleanFinalGateError(f"{label} is not a regular file")
    try:
        document = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        raise KleanFinalGateError(f"{label} is malformed") from error
    if not isinstance(document, dict):
        raise KleanFinalGateError(f"{label} must be a JSON object")
    return document


def _candidate_gate(candidate: Path, target: dict[str, Any]) -> None:
    entries = klean_export._tree_entries(candidate)
    proof = candidate / "Proof.lean"
    if not proof.is_file() or proof.is_symlink():
        raise KleanFinalGateError("candidate is missing regular Proof.lean")
    for required in ("lakefile.lean", "lean-toolchain"):
        path = candidate / required
        if not path.is_file() or path.is_symlink():
            raise KleanFinalGateError(f"candidate is missing regular {required}")
    for relative, kind, path in entries:
        if kind != "file" or path.suffix != ".lean":
            continue
        text = path.read_text()
        forbidden = re.search(
            r"\b(?:sorry|admit|unsafe|axiom|opaque)\b", text
        )
        if forbidden is not None:
            raise KleanFinalGateError(
                f"candidate contains forbidden Lean token "
                f"{forbidden.group(0)!r} in {relative}"
            )
    statement = target.get("statement")
    parameters = target.get("parameters")
    if not isinstance(statement, str) or not statement:
        raise KleanFinalGateError("generator target statement is malformed")
    if not isinstance(parameters, list):
        raise KleanFinalGateError("generator target bindings are malformed")
    proof_text = proof.read_text()
    for parameter in parameters:
        if not isinstance(parameter, dict):
            raise KleanFinalGateError("generator target binding is malformed")
        name = parameter.get("name")
        lean_type = parameter.get("type")
        if not isinstance(name, str) or not isinstance(lean_type, str):
            raise KleanFinalGateError("generator target binding is malformed")
        declarations = re.findall(
            rf"(?m)^\s*(?:noncomputable\s+)?def\s+{re.escape(name)}"
            rf"\s*(?::|\()",
            proof_text,
        )
        if len(declarations) != 1:
            raise KleanFinalGateError(
                f"candidate must define exact trust binding {name!r} once"
            )
    theorem_matches = re.findall(
        r"(?ms)^\s*theorem\s+final\s*:\s*(.*?)\s*:=\s*by\b",
        proof_text,
    )
    if len(theorem_matches) != 1:
        raise KleanFinalGateError(
            "candidate must contain exactly one theorem final"
        )
    if " ".join(theorem_matches[0].split()) != " ".join(statement.split()):
        raise KleanFinalGateError(
            "Proof.final does not state the exact generated target"
        )


def _allowed_axioms(inventory: dict[str, Any]) -> set[str]:
    allowlist = inventory.get("allowlist")
    if not isinstance(allowlist, list):
        raise KleanFinalGateError("trust inventory allowlist is malformed")
    names = {"Classical.choice", "propext", "Quot.sound"}
    for entry in allowlist:
        if not isinstance(entry, dict):
            raise KleanFinalGateError("trust inventory entry is malformed")
        name = entry.get("name")
        if not isinstance(name, str) or not name:
            raise KleanFinalGateError("trust inventory name is malformed")
        names.add(name)
    return names


def _parse_axioms(output: str) -> set[str]:
    matches = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", output)
    if len(matches) != 1:
        raise KleanFinalGateError("#print axioms output is missing or ambiguous")
    return {
        token.strip()
        for token in matches[0].split(",")
        if token.strip()
    }


def _audit_input_binding(path: Path) -> dict[str, Any]:
    document = _regular_json(path, "Stage 6 audit input")
    try:
        resolution, digest = (
            stage6_resolution_contract.verify_audit_input(document)
        )
    except (
        stage6_resolution_contract.Stage6ResolutionContractError
    ) as error:
        raise KleanFinalGateError(str(error)) from error
    mode = resolution.get("mode")
    hashes = resolution.get("hashes")
    if (
        mode not in {
            "CLASSIFICATION_ONLY",
            "CLASSIFICATION_AND_PROOF",
        }
        or not isinstance(hashes, dict)
    ):
        raise KleanFinalGateError(
            "Stage 6 audit input binding is malformed"
        )
    return {
        "resolution": resolution,
        "resolved_input_sha256": digest,
    }


def _input_hashes(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
) -> dict[str, Any]:
    try:
        return {
            "k_workspace_sha256": pipeline_contract.sha256_tree(
                frozen_input
            ),
            "stage1_export_sha256": klean_export.tree_digest(
                frozen_input
            ),
            "discovery_manifest_sha256": (
                pipeline_contract.sha256_file(discovery_manifest)
            ),
            "klean_generation_sha256": (
                pipeline_contract.sha256_tree(generation)
            ),
            "lean_workspace_sha256": (
                pipeline_contract.sha256_tree(candidate)
                if candidate is not None
                else None
            ),
        }
    except (
        OSError,
        klean_export.KleanExportError,
        pipeline_contract.PipelineContractError,
    ) as error:
        raise KleanFinalGateError(
            "cannot hash Stage 6 mechanical inputs"
        ) from error


def _require_bound_inputs(
    audit_input: dict[str, Any],
    observed: dict[str, Any],
) -> None:
    expected = audit_input["resolution"]["hashes"]
    for key, digest in observed.items():
        if expected.get(key) != digest:
            raise KleanFinalGateError(
                f"Stage 6 {key} differs from audit input"
            )


def _result_binding(audit_input: Path) -> dict[str, Any]:
    try:
        document = _audit_input_binding(Path(audit_input))
    except KleanFinalGateError:
        return {}
    return {
        "mode": document["resolution"]["mode"],
        "resolved_input_sha256": document[
            "resolved_input_sha256"
        ],
        "input_hashes": document["resolution"]["hashes"],
    }


def check_final(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    frozen_input = Path(frozen_input)
    discovery_manifest = Path(discovery_manifest)
    generation = Path(generation)
    candidate = Path(candidate) if candidate is not None else None
    audit_binding = _audit_input_binding(Path(audit_input))
    signed_resolution = audit_binding["resolution"]
    if (
        signed_resolution["mode"] == "CLASSIFICATION_AND_PROOF"
        and candidate is None
    ):
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    if (
        signed_resolution["mode"] == "CLASSIFICATION_ONLY"
        and candidate is not None
    ):
        raise KleanFinalGateError(
            "classification-only audit must not use a Stage 5 Lean "
            "candidate"
        )
    expected_mode = signed_resolution["mode"]
    observed_mode = (
        "CLASSIFICATION_AND_PROOF"
        if candidate is not None
        else "CLASSIFICATION_ONLY"
    )
    if observed_mode != expected_mode:
        raise KleanFinalGateError(
            "Stage 6 mechanical mode differs from audit input"
        )
    before_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    _require_bound_inputs(audit_binding, before_hashes)
    try:
        preflight = klean_preflight.check_generation(
            frozen_input,
            discovery_manifest,
            generation,
            toolchain_lock=toolchain_lock,
            run_command=run_command,
        )
    except klean_preflight.KleanPreflightError as error:
        raise KleanFinalGateError(
            f"deterministic Klean preflight failed: {error}"
        ) from error
    preflight_status = preflight.get("status")
    if preflight_status not in {"PASS", "KLEAN_NO_OBLIGATIONS"}:
        raise KleanFinalGateError(
            "Stage 4 Klean preflight is not mechanically auditable"
        )
    manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    target = manifest.get("target")
    if preflight_status == "KLEAN_NO_OBLIGATIONS":
        if candidate is not None:
            raise KleanFinalGateError(
                "classification-only audit must not use a Stage 5 Lean "
                "candidate"
            )
        if target is not None or preflight.get("obligation_count") != 0:
            raise KleanFinalGateError(
                "KLEAN_NO_OBLIGATIONS has a target or nonempty domain set"
            )
        after_hashes = _input_hashes(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
        )
        if after_hashes != before_hashes:
            raise KleanFinalGateError(
                "resolved inputs changed during mechanical audit"
            )
        _require_bound_inputs(audit_binding, after_hashes)
        return {
            "status": "PASS",
            "mode": "CLASSIFICATION_ONLY",
            "resolved_input_sha256": audit_binding[
                "resolved_input_sha256"
            ],
            "input_hashes": signed_resolution["hashes"],
            "semantic_classification": "NOT_EVALUATED",
            "target": None,
            "klean_preflight": preflight,
            "generation_sha256": klean_export.tree_digest(generation),
            "candidate_sha256": None,
            "used_axioms": [],
            "diagnostics": [],
        }
    if candidate is None:
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    if not isinstance(target, dict):
        raise KleanFinalGateError("generator target is malformed")
    _candidate_gate(candidate, target)
    inventory = _regular_json(
        generation / "trust-inventory.json", "trust inventory"
    )

    diagnostics: list[dict[str, Any]] = []
    with tempfile.TemporaryDirectory(prefix="klean-final-gate-") as temporary:
        project = Path(temporary) / "project"
        shutil.copytree(candidate, project)
        if pipeline_contract.sha256_tree(project) != before_hashes[
            "lean_workspace_sha256"
        ]:
            raise KleanFinalGateError(
                "candidate changed while copying for mechanical audit"
            )
        shutil.rmtree(project / ".lake", ignore_errors=True)
        shutil.rmtree(project / "Base", ignore_errors=True)
        shutil.copytree(generation / "generated", project / "Base")
        audit_source = project / "AxiomAudit.lean"
        audit_source.write_text(
            "import Proof\n\n"
            "namespace Proof\n\n"
            f"#check (final : {target['statement']})\n"
            "#print axioms final\n\n"
            "end Proof\n"
        )
        outputs: dict[tuple[str, ...], str] = {}
        commands = (
            ["lake", "clean"],
            ["lake", "build"],
            ["lake", "env", "lean", "AxiomAudit.lean"],
        )
        for command in commands:
            code, output = run_command(command, cwd=project, timeout=600)
            diagnostics.append(
                {
                    "command": command,
                    "exit_code": code,
                    "output_sha256": hashlib.sha256(
                        output.encode()
                    ).hexdigest(),
                    "output_tail": output[-4000:],
                }
            )
            outputs[tuple(command)] = output
            if code != 0:
                raise KleanFinalGateError(
                    f"{' '.join(command)} failed ({code}): {output[-600:]}"
                )
        used_axioms = _parse_axioms(
            outputs[("lake", "env", "lean", "AxiomAudit.lean")]
        )
    after_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    if after_hashes != before_hashes:
        if (
            after_hashes.get("lean_workspace_sha256")
            != before_hashes.get("lean_workspace_sha256")
        ):
            raise KleanFinalGateError(
                "candidate changed during mechanical audit"
            )
        raise KleanFinalGateError(
            "resolved inputs changed during mechanical audit"
        )
    _require_bound_inputs(audit_binding, after_hashes)
    if "sorryAx" in used_axioms:
        raise KleanFinalGateError("Proof.final depends on forbidden sorryAx")
    allowed = _allowed_axioms(inventory)
    unexpected = sorted(
        axiom
        for axiom in used_axioms
        if axiom not in allowed
    )
    if unexpected:
        raise KleanFinalGateError(
            "Proof.final has unrecorded axiom dependencies: "
            + ", ".join(unexpected)
        )
    return {
        "status": "PASS",
        "mode": "CLASSIFICATION_AND_PROOF",
        "resolved_input_sha256": audit_binding[
            "resolved_input_sha256"
        ],
        "input_hashes": signed_resolution["hashes"],
        "semantic_classification": "NOT_EVALUATED",
        "target": target,
        "klean_preflight": preflight,
        "generation_sha256": klean_export.tree_digest(generation),
        "candidate_sha256": klean_export.tree_digest(candidate),
        "used_axioms": sorted(used_axioms),
        "diagnostics": diagnostics,
    }


def run_gate(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    output: Path,
) -> dict[str, Any]:
    output = Path(output)
    if output.exists() or output.is_symlink():
        raise KleanFinalGateError(f"output already exists: {output}")
    try:
        document = check_final(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
            toolchain_lock=toolchain_lock,
            audit_input=audit_input,
        )
    except KleanFinalGateError as error:
        document = {
            "status": "FAIL",
            "error": str(error),
            **_result_binding(audit_input),
        }
    except BaseException as error:
        document = {
            "status": "AUDIT_ERROR",
            "error": f"{type(error).__name__}: {error}",
            **_result_binding(audit_input),
        }
    temporary = output.with_name(f".{output.name}.tmp")
    temporary.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n")
    os.replace(temporary, output)
    return document


def evaluate_gate(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
) -> dict[str, Any]:
    try:
        return check_final(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
            toolchain_lock=toolchain_lock,
            audit_input=audit_input,
        )
    except KleanFinalGateError as error:
        return {
            "status": "FAIL",
            "error": str(error),
            **_result_binding(audit_input),
        }
    except BaseException as error:
        return {
            "status": "AUDIT_ERROR",
            "error": f"{type(error).__name__}: {error}",
            **_result_binding(audit_input),
        }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--frozen-k", required=True, type=Path)
    parser.add_argument(
        "--discovery-manifest", required=True, type=Path
    )
    parser.add_argument("--generation", required=True, type=Path)
    parser.add_argument("--candidate", type=Path)
    parser.add_argument("--toolchain-lock", required=True, type=Path)
    parser.add_argument("--audit-input", required=True, type=Path)
    parser.add_argument("--output", type=Path)
    arguments = parser.parse_args(argv)
    try:
        if arguments.output is None:
            result = evaluate_gate(
                arguments.frozen_k,
                arguments.discovery_manifest,
                arguments.generation,
                arguments.candidate,
                toolchain_lock=arguments.toolchain_lock,
                audit_input=arguments.audit_input,
            )
        else:
            result = run_gate(
                arguments.frozen_k,
                arguments.discovery_manifest,
                arguments.generation,
                arguments.candidate,
                toolchain_lock=arguments.toolchain_lock,
                audit_input=arguments.audit_input,
                output=arguments.output,
            )
    except KleanFinalGateError as error:
        print(f"Klean final gate failed: {error}", file=sys.stderr)
        return 2
    print(json.dumps(result, sort_keys=True))
    return 0 if result["status"] == "PASS" else 1


diff --git a//tmp/audit-work/fix_proc_exe.c b//tmp/audit-work/fix_proc_exe.c
new file mode 100644
index 0000000000000000000000000000000000000000..99ed1e2f531f055edd81245a91c8f67563d00255
--- /dev/null
+++ b//tmp/audit-work/fix_proc_exe.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_numeric_proc_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    if (!path || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    const char *cursor = path + sizeof(prefix) - 1;
+    if (!isdigit((unsigned char)*cursor)) {
+        return 0;
+    }
+    while (isdigit((unsigned char)*cursor)) {
+        cursor++;
+    }
+    return strcmp(cursor, suffix) == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    if (!real_readlink) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    if (is_numeric_proc_exe(path)) {
+        path = "/proc/self/exe";
+    }
+    return real_readlink(path, buf, size);
+}
diff --git a//tmp/audit-work/trace_paths.c b//tmp/audit-work/trace_paths.c
new file mode 100644
index 0000000000000000000000000000000000000000..eda722ac86c553b6816acbfb1dc4d90e511d50e2
--- /dev/null
+++ b//tmp/audit-work/trace_paths.c
@@ -0,0 +1,39 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    if (!real_readlink) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    errno = 0;
+    ssize_t result = real_readlink(path, buf, size);
+    int saved = errno;
+    fprintf(stderr, "TRACE readlink(%s, size=%zu) => %zd errno=%d",
+            path ? path : "(null)", size, result, saved);
+    if (result >= 0) {
+        fprintf(stderr, " value=%.*s", (int)result, buf);
+    }
+    fputc('\n', stderr);
+    errno = saved;
+    return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+    static char *(*real_realpath)(const char *, char *);
+    if (!real_realpath) {
+        real_realpath = dlsym(RTLD_NEXT, "realpath");
+    }
+    errno = 0;
+    char *result = real_realpath(path, resolved);
+    int saved = errno;
+    fprintf(stderr, "TRACE realpath(%s) => %s errno=%d\n",
+            path ? path : "(null)", result ? result : "(null)", saved);
+    errno = saved;
+    return result;
+}
diff --git a/evidence/check_hashes.py b/evidence/check_hashes.py
new file mode 100644
index 0000000000000000000000000000000000000000..d7b5f638d06c2fe87f738b308c199ca019e50776
--- /dev/null
+++ b/evidence/check_hashes.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Read-only hash and provenance reconciliation for this audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract
+
+
+def load(path: str) -> dict:
+    return json.loads(Path(path).read_text())
+
+
+def file_sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+audit = load("/audit-input.json")
+resolution = audit["resolution"]
+generator = load("/reference/klean-generation/generator-manifest.json")
+source = load("/reference/generation-tools/source-manifest.json")
+input_manifest = load("/reference/klean-generation/input-manifest.json")
+preflight = load("/reference/klean-generation/preflight.json")
+
+producer = Path("/reference/generation-tools")
+producer_files = sorted(
+    path.relative_to(producer).as_posix()
+    for path in pipeline_contract._walk_regular_files(
+        producer, "mounted producer bundle"
+    )
+)
+producer_observed = {
+    name: file_sha256(producer / name)
+    for name in ("klean.py", "klean_export.py")
+}
+image_id = generator["provenance"]["generator_image_id"]
+
+stage1 = Path("/reference/k-proof")
+stage1_files = {
+    path.relative_to(stage1).as_posix(): file_sha256(path)
+    for path in pipeline_contract._walk_regular_files(
+        stage1, "mounted Stage 1 workspace"
+    )
+}
+
+checks = {
+    "audit_mode_environment_matches_input": (
+        os.environ.get("AUDIT_MODE") == resolution["mode"]
+    ),
+    "problem_condition_semantics_match_request": (
+        resolution["problem_id"] == "79-decimal-to-binary"
+        and resolution["condition"] == "bare"
+        and resolution["semantics_mode"] == "GENERATED_SEMANTICS"
+    ),
+    "producer_bundle_exact_file_set": producer_files
+    == ["klean.py", "klean_export.py", "source-manifest.json"],
+    "producer_file_hashes_match_source_manifest": (
+        producer_observed == source["files"]
+    ),
+    "producer_file_hashes_match_generator_manifest": (
+        producer_observed["klean_export.py"] == generator["exporter_sha256"]
+        and producer_observed["klean.py"] == generator["klean_py_sha256"]
+    ),
+    "producer_image_matches_source_and_generator_manifests": (
+        source["generator_image_id"] == image_id
+    ),
+    "producer_image_matches_audit_input_bundle_identity": (
+        Path(resolution["generation_producer_sources"]).name
+        == image_id.removeprefix("sha256:")
+    ),
+    "producer_bundle_pipeline_hash_matches_audit_input": (
+        pipeline_contract.sha256_tree(producer)
+        == resolution["hashes"]["generation_producer_sources_sha256"]
+    ),
+    "stage1_exact_file_hash_map_matches_audit_input": (
+        stage1_files == resolution["stage1_source_hashes"]
+    ),
+    "stage1_pipeline_tree_hash_matches_audit_input": (
+        pipeline_contract.sha256_tree(stage1)
+        == resolution["hashes"]["k_workspace_sha256"]
+    ),
+    "stage1_export_tree_hash_matches_audit_and_manifests": (
+        klean_export.tree_digest(stage1)
+        == resolution["hashes"]["stage1_export_sha256"]
+        == input_manifest["stage1_workspace_sha256"]
+        == input_manifest["frozen_input_sha256"]
+        == generator["provenance"]["stage1_workspace_sha256"]
+    ),
+    "stage3_file_hash_matches_audit_and_manifests": (
+        file_sha256(Path("/reference/lemma-discovery.json"))
+        == resolution["hashes"]["discovery_manifest_sha256"]
+        == input_manifest["stage3_discovery_manifest_sha256"]
+        == generator["provenance"]["stage3_discovery_manifest_sha256"]
+    ),
+    "selected_stage2_pipeline_hash_matches_audit_input": (
+        pipeline_contract.sha256_tree(Path("/reference/k-audit"))
+        == resolution["hashes"]["k_audit_sha256"]
+    ),
+    "selected_stage4_pipeline_hash_matches_audit_input": (
+        pipeline_contract.sha256_tree(Path("/reference/klean-generation"))
+        == resolution["hashes"]["klean_generation_sha256"]
+    ),
+    "generated_export_tree_hash_matches_audit_and_generator": (
+        klean_export.tree_digest(
+            Path("/reference/klean-generation/generated")
+        )
+        == resolution["hashes"]["generated_tree_sha256"]
+        == generator["generated_tree_sha256"]
+        == preflight["generated_tree_sha256"]
+    ),
+    "inventory_hash_consistent_across_manifests": (
+        input_manifest["inventory_sha256"]
+        == generator["provenance"]["inventory_sha256"]
+    ),
+    "stage4_status_target_and_count_consistent": (
+        resolution["selections"]["klean_generation"]["status"]
+        == preflight["status"]
+        == "KLEAN_NO_OBLIGATIONS"
+        and generator["obligation_count"] == preflight["obligation_count"] == 0
+        and resolution["target"] is None
+        and generator["target"] is None
+        and preflight["target"] is None
+    ),
+    "launcher_preflight_evidence_matches_sidecar": (
+        resolution["stage4_preflight"] == preflight
+    ),
+    "classification_only_has_no_stage5_paths_or_result": (
+        resolution["lean_workspace"] is None
+        and resolution["lean_invocation"] is None
+        and resolution["stage5_result"] is None
+        and not Path("/candidate").exists()
+    ),
+}
+
+details = {
+    "checks": checks,
+    "all_checks_pass": all(checks.values()),
+    "producer_files": producer_files,
+    "producer_observed_sha256": producer_observed,
+    "producer_pipeline_tree_sha256": pipeline_contract.sha256_tree(producer),
+    "stage1_pipeline_tree_sha256": pipeline_contract.sha256_tree(stage1),
+    "stage1_export_tree_sha256": klean_export.tree_digest(stage1),
+    "stage3_manifest_sha256": file_sha256(
+        Path("/reference/lemma-discovery.json")
+    ),
+    "stage2_pipeline_tree_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/k-audit")
+    ),
+    "stage4_pipeline_tree_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/klean-generation")
+    ),
+    "generated_export_tree_sha256": klean_export.tree_digest(
+        Path("/reference/klean-generation/generated")
+    ),
+}
+print(json.dumps(details, indent=2, sort_keys=True))
