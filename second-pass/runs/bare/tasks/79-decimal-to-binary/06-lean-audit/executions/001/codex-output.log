        "replaces": previous.get("relative_path") if previous else None,
    }
    write_json_atomic(selected_path, document)
    _append_ledger(
        state,
        {
            "event": "stage_output_selected",
            "stage": stage,
            "relative_path": document["relative_path"],
            "status": status,
        },
    )
    return document


