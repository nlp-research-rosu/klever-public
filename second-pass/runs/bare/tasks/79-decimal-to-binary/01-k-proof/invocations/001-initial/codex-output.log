diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..37d152ce739f621c23427034cc355f1b20c204da
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,87 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> I:Int </arg>
+    <result> .K => strVal(decimalToBinarySpec(I)) </result>
+    requires I >=Int 0
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> 15 </arg>
+    <result> .K => strVal("db1111db") </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> 32 </arg>
+    <result> .K => strVal("db100000db") </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1e759751103875ace3e6f37154a0861264060a22
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,14 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A mathematical presentation of the required wrapper around the usual
+  // base-two digit expansion.  Keeping it separate from expression evaluation
+  // makes the reachability claim state the contract rather than an AST result.
+  syntax String ::= decimalToBinarySpec(Int) [function]
+
+  rule decimalToBinarySpec(I)
+    => "db" +String binDigits(I) +String "db"
+    requires I >=Int 0
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --output-definition .kbuild' in /work
