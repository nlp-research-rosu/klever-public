new file mode 100644
index 0000000000000000000000000000000000000000..e648269bac1b9dc7d20a32f35992a1d42cd42df2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,142 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> I:Int </arg>
+    <result> .K => strVal(decimalToBinarySpec(I)) </result>
+    requires I >=Int 0
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> I:Int </arg>
+    <result> .K => strVal(decimalToBinarySpec(I)) </result>
+    requires I <Int 0
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> 15 </arg>
+    <result> .K => strVal("db1111db") </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> 32 </arg>
+    <result> .K => strVal("db100000db") </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> -5 </arg>
+    <result> .K => strVal("dbb101db") </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9a2dc35f3411bf226d1951127d6f8ca2d6f5174f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A mathematical presentation of the required wrapper around the usual
+  // base-two digit expansion.  Keeping it separate from expression evaluation
+  // makes the reachability claim state the contract rather than an AST result.
+  syntax String ::= decimalToBinarySpec(Int) [function]
+
+  rule decimalToBinarySpec(I)
+    => "db" +String binDigits(I) +String "db"
+    requires I >=Int 0
+  rule decimalToBinarySpec(I)
+    => ("db" +String ("b" +String binDigits(0 -Int I))) +String "db"
+    requires I <Int 0
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --syntax-module SEMANTIC-SYNTAX --output-definition .kbuild' in /work
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3cdcafac3882cfe50a1b4db6c2c618f8f3008f37
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+kompile verification.k --backend haskell --output-definition .kbuild
+krun solution.mpy --definition .kbuild -cARG=0
+krun solution.mpy --definition .kbuild -cARG=-5
+krun solution.mpy --definition .kbuild -cARG=15
+krun solution.mpy --definition .kbuild -cARG=32
+kprove spec.k --definition .kbuild
