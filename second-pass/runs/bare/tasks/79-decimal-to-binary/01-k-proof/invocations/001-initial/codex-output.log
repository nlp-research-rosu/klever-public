+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> I:Int </arg>
+    <result> .K => strVal(decimalToBinarySpec(I)) </result>
+    requires I >=Int 0
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> I:Int </arg>
+    <result> .K => strVal(decimalToBinarySpec(I)) </result>
+    requires I <Int 0
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> 15 </arg>
+    <result> .K => strVal("db1111db") </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> 32 </arg>
+    <result> .K => strVal("db100000db") </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> -5 </arg>
+    <result> .K => strVal("dbb101db") </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0a0bb40422663fd6daeb3580a96e43b65578ebc1
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A mathematical presentation of the required wrapper around the usual
+  // base-two digit expansion.  Keeping it separate from expression evaluation
+  // makes the reachability claim state the contract rather than an AST result.
+  syntax String ::= decimalToBinarySpec(Int) [function]
+
+  rule decimalToBinarySpec(I)
+    => "db" +String binDigits(I) +String "db"
+    requires I >=Int 0
+  rule decimalToBinarySpec(I)
+    => "dbb" +String binDigits(0 -Int I) +String "db"
+    requires I <Int 0
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --output-definition .kbuild' in /work
