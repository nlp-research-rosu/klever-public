+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
+              ),
+              Str("db")
+            )
+          )
+        )
+      )
+    => .K
+    </k>
+    <arg> 32 </arg>
+    <result> .K => strVal("db100000db") </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef(
+          "decimal_to_binary",
+          Params("decimal"),
+          Return(
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                Str("db"),
+                Subscript(
+                  Call(Name("bin"), Name("decimal")),
+                  Slice(Int(2), NoBound, NoBound)
+                )
