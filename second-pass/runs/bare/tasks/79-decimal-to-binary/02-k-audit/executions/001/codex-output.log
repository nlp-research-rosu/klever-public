+  --spec-module AUDIT-SPEC-FALSE-RESULT
+false_status=$?
+printf '[exit %d; expected nonzero]\n' "$false_status"
+if [ "$false_status" -eq 0 ]; then overall=1; fi
+
+run python3 -c \
