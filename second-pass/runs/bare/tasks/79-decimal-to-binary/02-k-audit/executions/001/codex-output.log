+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  if [ "$status" -ne 0 ]; then
+    overall=1
+  fi
+}
+
+run kompile --version
+run kprove --version
+run krun --version
+run test ! -e /tmp/audit-work/build-concrete/concrete-kompiled
+run test ! -e /tmp/audit-work/build-proof/verification-kompiled
