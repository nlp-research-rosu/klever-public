+requires "verification.k"
+
+module AUDIT-SPEC-GROUND-SUMMARIES
+  imports VERIFICATION
+
+  // Concrete substitutions witnessing every entry-claim precondition.
+  claim decimalToBinarySpec(0) => "db0db"
+  claim decimalToBinarySpec(-1) => "dbb1db"
+  claim decimalToBinarySpec(15) => "db1111db"
+  claim decimalToBinarySpec(32) => "db100000db"
