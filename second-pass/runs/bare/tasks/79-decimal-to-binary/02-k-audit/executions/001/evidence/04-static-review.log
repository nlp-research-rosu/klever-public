    35	  syntax Env ::= "bind" "(" String "," Int ")" [symbol(bind)]
    36	
    37	  syntax Val ::= "intVal" "(" Int ")" [symbol(intVal)]
    38	               | "strVal" "(" String ")" [symbol(strVal)]
    39	               | "binVal" "(" String ")" [symbol(binVal)]
    40	               | "negativeBinVal" "(" String ")" [symbol(negativeBinVal)]
    41	
    42	  syntax Val ::= eval(Expr, Env) [function]
    43	               | addValues(Val, Val) [function]
    44	               | callBin(Val) [function]
    45	               | suffixFrom(Val, Int) [function]
    46	
    47	  syntax String ::= binDigits(Int) [function]
