$ nl -ba /tmp/audit-work/source/verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // A mathematical presentation of the required wrapper around the usual
     7	  // base-two digit expansion.  Keeping it separate from expression evaluation
     8	  // makes the reachability claim state the contract rather than an AST result.
     9	  syntax String ::= decimalToBinarySpec(Int) [function]
    10	
    11	  rule decimalToBinarySpec(I)
    12	    => "db" +String binDigits(I) +String "db"
    13	    requires I >=Int 0
    14	  rule decimalToBinarySpec(I)
    15	    => ("db" +String ("b" +String binDigits(0 -Int I))) +String "db"
    16	    requires I <Int 0
    17	endmodule
