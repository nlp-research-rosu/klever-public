    64	
    65	  rule eval(Int(I), _) => intVal(I)
    66	  rule eval(Str(S), _) => strVal(S)
    67	  rule eval(Name(X), bind(X, I)) => intVal(I)
    68	  rule eval(BinOp("+", LEFT, RIGHT), RHO)
    69	    => addValues(eval(LEFT, RHO), eval(RIGHT, RHO))
    70	  rule eval(Call(Name("bin"), ARG), RHO) => callBin(eval(ARG, RHO))
    71	  rule eval(Subscript(BASE, Slice(Int(START), NoBound, NoBound)), RHO)
    72	    => suffixFrom(eval(BASE, RHO), START)
    73	
    74	  rule addValues(intVal(I), intVal(J)) => intVal(I +Int J)
    75	  rule addValues(strVal(S), strVal(T)) => strVal(S +String T)
    76	
    77	  // binVal(S) is the internal value denoting Python's string "0b" + S.
    78	  rule callBin(intVal(I)) => binVal(binDigits(I))
    79	    requires I >=Int 0
    80	  // Python renders a negative input as "-0b" + digits.
    81	  rule callBin(intVal(I)) => negativeBinVal(binDigits(0 -Int I))
    82	    requires I <Int 0
    83	
    84	  rule suffixFrom(binVal(S), 2) => strVal(S)
    85	  rule suffixFrom(negativeBinVal(S), 2) => strVal("b" +String S)
    86	
    87	  rule binDigits(I) => Int2String(I)
    88	    requires (0 <=Int I) andBool (I <Int 2)
    89	  rule binDigits(I) => binDigits(I /Int 2) +String Int2String(I %Int 2)
    90	    requires I >=Int 2
    91	endmodule
