+        + file_name.count("5")
+        + file_name.count("6")
+        + file_name.count("7")
+        + file_name.count("8")
+        + file_name.count("9")
+    )
+    if file_name.count(".") != 1:
+        return "No"
+    if digits > 3:
+        return "No"
+    if len(file_name) == 0:
+        return "No"
+    first = file_name[0]
+    if not (("a" <= first and first <= "z") or ("A" <= first and first <= "Z")):
+        return "No"
+    if (
+        file_name.endswith(".txt")
+        or file_name.endswith(".exe")
+        or file_name.endswith(".dll")
+    ):
+        return "Yes"
+    return "No"
