+        + file_name.count("5")
+        + file_name.count("6")
+        + file_name.count("7")
+        + file_name.count("8")
+        + file_name.count("9")
+    )
+    if file_name.count(".") != 1:
+        return "No"
+    if digits > 3:
+        return "No"
+    if len(file_name) == 0:
+        return "No"
+    first = file_name[0]
