+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Program ::= "solutionProgram" [function, total, symbol]
+  syntax Int ::= digitCount(String) [function, total, symbol]
+  syntax Bool ::= startsWithAsciiLetter(String) [function, total, symbol]
+                | hasAcceptedSuffix(String) [function, total, symbol]
+                | validFileName(String) [function, total, symbol]
+  syntax PyVal ::= contractResult(String) [function, total, symbol]
+
+  rule digitCount(S) =>
+       countAllOccurrences(S, "0")
+    +Int countAllOccurrences(S, "1")
+    +Int countAllOccurrences(S, "2")
+    +Int countAllOccurrences(S, "3")
+    +Int countAllOccurrences(S, "4")
+    +Int countAllOccurrences(S, "5")
+    +Int countAllOccurrences(S, "6")
+    +Int countAllOccurrences(S, "7")
+    +Int countAllOccurrences(S, "8")
