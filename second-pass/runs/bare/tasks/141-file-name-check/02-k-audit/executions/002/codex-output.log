+diff_status=$?
+printf '[exit %d; expected difference]\n' "$diff_status"
+
+run kompile \
+  --backend haskell \
+  verification-body-mutated.k \
+  --main-module VERIFICATION-BODY-MUTATED \
+  --syntax-module MPY-SYNTAX \
