+
+run python3 -c '
+import re
+from collections import Counter
+from pathlib import Path
+
+text = Path("solution.mpy").read_text()
+constructors = re.findall(r"\b([A-Z][A-Za-z0-9]*)\s*\(", text)
+for name, count in sorted(Counter(constructors).items()):
+    print(name, count)
+'
