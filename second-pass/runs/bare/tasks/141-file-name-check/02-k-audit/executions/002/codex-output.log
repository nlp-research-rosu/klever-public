+}
+
+run python3 /audit-output/evidence/04-compare-constructors.py || exit $?
+
+run kprove \
+  pinning-spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module PINNING-SPEC \
+  --warnings all || exit $?
+
+run kprove \
+  ground-validation-spec.k \
