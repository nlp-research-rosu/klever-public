diff --git a//tmp/audit-work/141-file-name-check/fresh-vacuity-spec.k b//tmp/audit-work/141-file-name-check/fresh-vacuity-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..15fa1dc9e43232e597e97f5e6c6ca6ae418b3f0a
--- /dev/null
+++ b//tmp/audit-work/141-file-name-check/fresh-vacuity-spec.k
@@ -0,0 +1,11 @@
+requires "verification.k"
+
+module FRESH-VACUITY-SPEC
+  imports VERIFICATION
+
+  // "a123.txt" satisfies the prompt with exactly three ASCII digits.
+  // The real generated program returns "Yes", so "No" is deliberately false.
+  claim <k> runProgram(solutionProgram, "a123.txt")
+          => VStr("No")
+        </k>
+endmodule
