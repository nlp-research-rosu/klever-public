    93	  rule continue(Normal(RHO), SS) => exec(SS, RHO)
    94	  rule continue(Returned(V), _SS) => Returned(V)
    95	  rule continue(IfExec(B, R1, R2), SS)
    96	    => IfExec(B, continue(R1, SS), continue(R2, SS))
    97	
    98	  rule eval(Name(X), RHO) => lookupVal(X, RHO)
