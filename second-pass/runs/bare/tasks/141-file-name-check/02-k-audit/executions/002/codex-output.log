+  /reference/prompt.py \
+  /reference/py2mpy.py
+
+run sha256sum \
+  /audit-campaign-lock.json \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /reference/canonical.py \
+  /reference/prompt.py \
