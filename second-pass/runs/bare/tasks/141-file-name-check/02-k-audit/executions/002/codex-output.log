+  rule digitCount(S) =>
+       occurrences(S, "0")
+    +Int occurrences(S, "1")
+    +Int occurrences(S, "2")
+    +Int occurrences(S, "3")
+    +Int occurrences(S, "4")
+    +Int occurrences(S, "5")
+    +Int occurrences(S, "6")
+    +Int occurrences(S, "7")
