+#!/usr/bin/env bash
+set -u
+
+SCRATCH=/tmp/audit-work/141-file-name-check
+cd "$SCRATCH" || exit 1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
