+if [ "$haskell_status" -eq 0 ] && [ "$llvm_status" -ne 0 ]; then
+  printf 'BACKEND DIVERGENCE REPRODUCED\n'
+  exit 0
+fi
+printf 'EXPECTED DIVERGENCE NOT REPRODUCED\n'
+exit 1
