+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          Call(
+                            Attribute(Name("file_name"), "count"),
+                            Str("0")),
+                          Call(
+                            Attribute(Name("file_name"), "count"),
+                            Str("1"))),
