$ nl -ba verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  syntax Program ::= "solutionProgram" [function, total, symbol]
     7	  syntax Int ::= digitCount(String) [function, total, symbol]
     8	  syntax Bool ::= startsWithAsciiLetter(String) [function, total, symbol]
     9	                | hasAcceptedSuffix(String) [function, total, symbol]
    10	                | validFileName(String) [function, total, symbol]
    11	  syntax PyVal ::= contractResult(String) [function, total, symbol]
    12	
    13	  rule digitCount(S) =>
    14	       occurrences(S, "0")
    15	    +Int occurrences(S, "1")
    16	    +Int occurrences(S, "2")
    17	    +Int occurrences(S, "3")
    18	    +Int occurrences(S, "4")
    19	    +Int occurrences(S, "5")
    20	    +Int occurrences(S, "6")
    21	    +Int occurrences(S, "7")
    22	    +Int occurrences(S, "8")
    23	    +Int occurrences(S, "9")
    24	
    25	  rule startsWithAsciiLetter(S) =>
    26	       ("a" <=String substrString(S, 0, 1)
    27	         andBool substrString(S, 0, 1) <=String "z")
    28	    orBool
    29	       ("A" <=String substrString(S, 0, 1)
    30	         andBool substrString(S, 0, 1) <=String "Z")
    31	
    32	  rule hasAcceptedSuffix(S) =>
    33	       endsWith(S, ".txt")
    34	    orBool endsWith(S, ".exe")
    35	    orBool endsWith(S, ".dll")
    36	
    37	  // This is the prompt's contract, stated independently of the AST evaluator.
    38	  // Exactly one dot plus an accepted final suffix makes the text after that
    39	  // unique dot exactly txt/exe/dll. A nonempty name makes character 0 defined.
    40	  rule validFileName(S) =>
    41	       occurrences(S, ".") ==Int 1
    42	    andBool digitCount(S) <=Int 3
    43	    andBool lengthString(S) >Int 0
    44	    andBool startsWithAsciiLetter(S)
    45	    andBool hasAcceptedSuffix(S)
    46	
    47	  // The same contract as a total result-valued decision tree. Each rejection
    48	  // node is the negation of one conjunct of validFileName, in prompt order.
    49	  rule contractResult(S) =>
    50	    IteVal(occurrences(S, ".") =/=Int 1,
    51	      VStr("No"),
    52	      IteVal(digitCount(S) >Int 3,
    53	        VStr("No"),
    54	        IteVal(lengthString(S) ==Int 0,
    55	          VStr("No"),
    56	          IteVal(notBool startsWithAsciiLetter(S),
    57	            VStr("No"),
    58	            IteVal(hasAcceptedSuffix(S), VStr("Yes"), VStr("No"))))))
    59	
    60	  // A checked-in AST constant connects the proof to solution.mpy. prove.sh
    61	  // regenerates solution.mpy and checks its recorded digest before kprove.
    62	  rule solutionProgram =>
    63	    Module(
    64	      FuncDef("file_name_check", Params("file_name"),
    65	        Assign(
    66	          Name("digits"),
    67	          BinOp(
    68	            "+",
    69	            BinOp(
    70	              "+",
    71	              BinOp(
    72	                "+",
    73	                BinOp(
    74	                  "+",
    75	                  BinOp(
    76	                    "+",
    77	                    BinOp(
    78	                      "+",
    79	                      BinOp(
    80	                        "+",
    81	                        BinOp(
    82	                          "+",
    83	                          BinOp(
    84	                            "+",
    85	                            Call(
    86	                              Attribute(Name("file_name"), "count"),
    87	                              Str("0")),
    88	                            Call(
    89	                              Attribute(Name("file_name"), "count"),
    90	                              Str("1"))),
    91	                          Call(
    92	                            Attribute(Name("file_name"), "count"),
    93	                            Str("2"))),
    94	                        Call(
    95	                          Attribute(Name("file_name"), "count"),
    96	                          Str("3"))),
    97	                      Call(Attribute(Name("file_name"), "count"), Str("4"))),
    98	                    Call(Attribute(Name("file_name"), "count"), Str("5"))),
    99	                  Call(Attribute(Name("file_name"), "count"), Str("6"))),
   100	                Call(Attribute(Name("file_name"), "count"), Str("7"))),
   101	              Call(Attribute(Name("file_name"), "count"), Str("8"))),
   102	            Call(Attribute(Name("file_name"), "count"), Str("9"))))
   103	        If(Compare(
   104	          Call(Attribute(Name("file_name"), "count"), Str(".")),
   105	          CmpOp("!=", Int(1))),
   106	          Return(Str("No")),
   107	          .Stmts)
   108	        If(Compare(Name("digits"), CmpOp(">", Int(3))),
   109	          Return(Str("No")),
   110	          .Stmts)
   111	        If(Compare(Call(Name("len"), Name("file_name")), CmpOp("==", Int(0))),
   112	          Return(Str("No")),
   113	          .Stmts)
   114	        Assign(Name("first"), Subscript(Name("file_name"), Int(0)))
   115	        If(UnaryOp(
   116	          "not",
   117	          BoolOp(
   118	            "or",
   119	            BoolOp(
   120	              "and",
   121	              Compare(Str("a"), CmpOp("<=", Name("first"))),
   122	              Compare(Name("first"), CmpOp("<=", Str("z")))),
   123	            BoolOp(
   124	              "and",
   125	              Compare(Str("A"), CmpOp("<=", Name("first"))),
   126	              Compare(Name("first"), CmpOp("<=", Str("Z")))))),
   127	          Return(Str("No")),
   128	          .Stmts)
   129	        If(BoolOp(
   130	          "or",
   131	          Call(Attribute(Name("file_name"), "endswith"), Str(".txt")),
   132	          Call(Attribute(Name("file_name"), "endswith"), Str(".exe")),
   133	          Call(Attribute(Name("file_name"), "endswith"), Str(".dll"))),
   134	          Return(Str("Yes")),
   135	          .Stmts)
   136	        Return(Str("No"))))
   137	endmodule
[exit 0]

