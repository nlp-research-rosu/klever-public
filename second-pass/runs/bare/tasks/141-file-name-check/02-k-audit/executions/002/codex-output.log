   100	  rule lookupVal(X, Bind(Y, _V, RHO)) => lookupVal(X, RHO)
   101	    requires X =/=String Y
   102	  rule eval(Int(I), _RHO) => VInt(I)
   103	  rule eval(Str(S), _RHO) => VStr(S)
   104	  rule eval(Bool(B), _RHO) => VBool(B)
   105	  rule eval(BinOp("+", E1, E2), RHO)
   106	    => addVals(eval(E1, RHO), eval(E2, RHO))
   107	  rule eval(UnaryOp("not", E), RHO) => VBool(notBool asBool(eval(E, RHO)))
   108	  rule eval(BoolOp(OP, ES), RHO) => VBool(boolOp(OP, ES, RHO))
   109	  rule eval(Compare(E1, CmpOp(OP, E2)), RHO)
   110	    => VBool(compareVals(OP, eval(E1, RHO), eval(E2, RHO)))
   111	  rule eval(Subscript(E1, E2), RHO)
   112	    => subscriptVal(eval(E1, RHO), eval(E2, RHO))
