   114	  syntax String ::= getString(PyVal) [function, total, symbol]
   115	  rule getString(VStr(S)) => S
   116	
   117	  rule eval(Call(Name("len"), E), RHO)
   118	    => VInt(lengthString(getString(eval(E, RHO))))
   119	  rule eval(Call(Attribute(E, "count"), Str(NEEDLE)), RHO)
   120	    => VInt(occurrences(getString(eval(E, RHO)), NEEDLE))
   121	  rule eval(Call(Attribute(E, "endswith"), Str(SUFFIX)), RHO)
   122	    => VBool(endsWith(getString(eval(E, RHO)), SUFFIX))
   123	
   124	  rule addVals(VInt(I1), VInt(I2)) => VInt(I1 +Int I2)
   125	  rule subscriptVal(VStr(S), VInt(I))
   126	    => VStr(substrString(S, I, I +Int 1))
   127	
   128	  rule asBool(VBool(B)) => B
   129	
   130	  rule boolOp("and", E1:Expr, E2:Expr, RHO)
   131	    => asBool(eval(E1, RHO)) andBool asBool(eval(E2, RHO))
   132	  rule boolOp("or", E1:Expr, E2:Expr, RHO)
   133	    => asBool(eval(E1, RHO)) orBool asBool(eval(E2, RHO))
   134	  rule boolOp("or", E1:Expr, E2:Expr, E3:Expr, RHO)
   135	    => asBool(eval(E1, RHO))
   136	       orBool asBool(eval(E2, RHO))
   137	       orBool asBool(eval(E3, RHO))
   138	
   139	  rule compareVals("==", VInt(I1), VInt(I2)) => I1 ==Int I2
   140	  rule compareVals("!=", VInt(I1), VInt(I2)) => I1 =/=Int I2
   141	  rule compareVals(">", VInt(I1), VInt(I2)) => I1 >Int I2
   142	  rule compareVals("<=", VStr(S1), VStr(S2)) => S1 <=String S2
   143	
   144	  rule endsWith(S, SUFFIX)
   145	    => substrString(
   146	         S,
   147	         lengthString(S) -Int lengthString(SUFFIX),
   148	         lengthString(S)
   149	       ) ==String SUFFIX
   150	    requires lengthString(S) >=Int lengthString(SUFFIX)
   151	  rule endsWith(S, SUFFIX) => false
   152	    requires lengthString(S) <Int lengthString(SUFFIX)
   153	endmodule
