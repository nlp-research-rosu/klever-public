     5	
     6	def file_name_check(file_name):
     7	    """Create a function which takes a string representing a file's name, and returns
     8	    'Yes' if the the file's name is valid, and returns 'No' otherwise.
     9	    A file's name is considered to be valid if and only if all the following conditions 
    10	    are met:
    11	    - There should not be more than three digits ('0'-'9') in the file's name.
    12	    - The file's name contains exactly one dot '.'
    13	    - The substring before the dot should not be empty, and it starts with a letter from 
    14	    the latin alphapet ('a'-'z' and 'A'-'Z').
    15	    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']
    16	    Examples:
    17	    file_name_check("example.txt") # => 'Yes'
    18	    file_name_check("1example.dll") # => 'No' (the name should start with a latin alphapet letter)
    19	    """
    20	    suf = ['txt', 'exe', 'dll']
    21	    lst = file_name.split(sep='.')
    22	    if len(lst) != 2:
    23	        return 'No'
    24	    if not lst[1] in suf:
    25	        return 'No'
    26	    if len(lst[0]) == 0:
    27	        return 'No'
    28	    if not lst[0][0].isalpha():
    29	        return 'No'
    30	    t = len([x for x in lst[0] if x.isdigit()])
    31	    if t > 3:
    32	        return 'No'
    33	    return 'Yes'
