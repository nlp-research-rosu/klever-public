     1	def file_name_check(file_name):
     2	    digits = (
     3	        file_name.count("0")
     4	        + file_name.count("1")
     5	        + file_name.count("2")
     6	        + file_name.count("3")
     7	        + file_name.count("4")
     8	        + file_name.count("5")
     9	        + file_name.count("6")
    10	        + file_name.count("7")
    11	        + file_name.count("8")
    12	        + file_name.count("9")
    13	    )
    14	    if file_name.count(".") != 1:
    15	        return "No"
    16	    if digits > 3:
    17	        return "No"
    18	    if len(file_name) == 0:
    19	        return "No"
    20	    first = file_name[0]
    21	    if not (("a" <= first and first <= "z") or ("A" <= first and first <= "Z")):
    22	        return "No"
    23	    if (
    24	        file_name.endswith(".txt")
    25	        or file_name.endswith(".exe")
    26	        or file_name.endswith(".dll")
    27	    ):
    28	        return "Yes"
    29	    return "No"
