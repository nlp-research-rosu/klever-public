+cp "$evidence/concrete_semantics_test.py" "$scratch/concrete_semantics_test.py"
+
+{
+  printf '%s\n' \
+    "COMMAND: python3 $scratch/concrete_semantics_test.py $source_dir/solution.py $source_dir/solution.mpy $proof_definition"
