+
+def show(label, fn):
+    try:
+        print(label, ("return", fn(1_000_003)))
+    except BaseException as error:
+        print(label, ("raise", type(error).__name__, str(error)))
+
+print("sys.getrecursionlimit()", sys.getrecursionlimit())
+show(
+    "trusted canonical",
