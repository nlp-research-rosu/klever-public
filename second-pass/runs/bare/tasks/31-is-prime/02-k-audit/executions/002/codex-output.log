  rule 0 <<Int Y => 0 requires 0 <=Int Y [simplification, preserves-definedness]
  rule X >>Int 0 => X                    [simplification, preserves-definedness]
  rule 0 >>Int Y => 0 requires 0 <=Int Y [simplification, preserves-definedness]
