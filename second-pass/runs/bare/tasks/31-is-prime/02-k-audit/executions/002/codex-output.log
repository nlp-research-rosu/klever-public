+  "$mutant_kore" "$claimed_kore"
+cmp -s "$mutant_kore" "$claimed_kore"
+mutant_cmp_rc=$?
+printf 'EXIT: %d\n' "$mutant_cmp_rc"
+if [[ "$mutant_cmp_rc" -eq 0 ]]; then
+  overall=1
+fi
+sha256sum "$mutant_kore" "$claimed_kore"
+
+printf 'STAGE4_OVERALL=%d\n' "$overall"
+exit "$overall"
