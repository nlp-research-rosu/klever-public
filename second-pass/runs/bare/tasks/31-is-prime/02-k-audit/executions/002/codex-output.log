+(
+  cd "$scratch/candidate" &&
+  krun solution.mpy \
+    --definition "$scratch/semantic-concrete-kompiled" \
+    -cN=1000003
+) | sed -n '/<result>/,/<\/result>/p'
+rc=${PIPESTATUS[0]}
+printf 'EXIT: %d\n' "$rc"
+if [[ "$rc" -ne 0 ]]; then overall=1; fi
+
+printf 'STAGE5_WITNESS_OVERALL=%d\n' "$overall"
+exit "$overall"
