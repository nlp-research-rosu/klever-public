+  overall=1
+fi
+
+printf 'BUILD_EXIT=%d EXPECTED_PROOF_FAILURE_EXIT=%d STAGE6_OVERALL=%d\n' \
+  "$build_rc" "$proof_rc" "$overall"
+exit "$overall"
