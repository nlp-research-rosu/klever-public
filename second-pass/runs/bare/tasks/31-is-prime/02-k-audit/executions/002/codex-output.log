    command: list[str] | str,
    *,
    cwd: Path | None,
    timeout: int,
    env: dict[str, str],
    shell: bool = False,
) -> tuple[int, str]:
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            timeout=timeout,
            shell=shell,
            env=env,
            text=True,
    allowed = _allowed_axioms(inventory)
    unexpected = sorted(
        axiom
        for axiom in used_axioms
        if axiom not in allowed
    )
    if unexpected:
        raise KleanFinalGateError(
            "Proof.final has unrecorded axiom dependencies: "
            + ", ".join(unexpected)
        )
    return {
        "status": "PASS",
