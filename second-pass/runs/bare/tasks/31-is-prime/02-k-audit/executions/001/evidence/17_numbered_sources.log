     1	module MPY-SYNTAX
     2	  imports INT-SYNTAX
     3	  imports BOOL-SYNTAX
     4	  imports STRING-SYNTAX
     5	
     6	  syntax Program ::= Module(Stmts)
     7	
     8	  // The translator represents statement blocks by juxtaposition.
     9	  syntax Stmts ::= List{Stmt, ""}
    10	  syntax Stmt ::= FuncDef(String, Params, Stmts)
    11	                | Return(Expr)
    12	                | If(Expr, Stmts, Stmts)
    13	
    14	  syntax Params ::= Params(Ids)
    15	  syntax Ids ::= List{String, ","}
    16	
    17	  syntax Expr ::= Int(Int)
    18	                | Bool(Bool)
    19	                | Name(String)
    20	                | BinOp(String, Expr, Expr)
    21	                | Compare(Expr, CmpOp)
    22	                | Call(Expr, Exprs)
    23	  syntax CmpOp ::= CmpOp(String, Expr)
    24	  syntax Exprs ::= List{Expr, ","}
    25	endmodule
    26	
    27	module SEMANTIC
    28	  imports MPY-SYNTAX
    29	  imports MAP
    30	  imports INT
    31	  imports BOOL
    32	
    33	  syntax Function ::= function(Params, Stmts)
    34	
    35	  syntax KItem ::= #invoke(String, Exprs)
    36	                 | #branch(Expr, Stmts, Stmts)
    37	                 | #finish(Expr)
    38	
    39	  syntax Expr ::= #eval(Expr, Map) [function]
    40	                | #lookup(String, Map) [function]
    41	                | #bin(String, Expr, Expr) [function]
    42	                | #cmp(String, Expr, Expr) [function]
    43	  syntax Exprs ::= #evalArgs(Exprs, Map) [function]
    44	  syntax Map ::= #bind(Params, Exprs) [function]
