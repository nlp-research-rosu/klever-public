     1	def no_divisor(n, d):
     2	    if d * d > n:
     3	        return True
     4	    if n % d == 0:
     5	        return False
     6	    return no_divisor(n, d + 1)
     7	
     8	
     9	def is_prime(n):
    10	    if n < 2:
    11	        return False
    12	    return no_divisor(n, 2)
