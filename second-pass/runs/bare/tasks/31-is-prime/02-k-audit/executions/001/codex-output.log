+requires "verification.k"
+
+module GROUND-WITNESSES
+  imports VERIFICATION
+
+  // A concrete state satisfying the universal entry claim (which has no
+  // requires-clause) and yielding the asserted prime(31) result.
+  claim [entry-31]:
+    <k> solutionProgram() ~> #invoke("is_prime", Int(31)) => .K </k>
+    <functions>
+      .Map
+      => "no_divisor" |-> noDivisorFunction()
+         "is_prime" |-> isPrimeFunction()
+    </functions>
+    <env> .Map => ?_FINALENV </env>
+    <result> Bool(false) => Bool(true) </result>
+
+  // A second entry witness takes the divisor-found branch.
+  claim [entry-4]:
+    <k> solutionProgram() ~> #invoke("is_prime", Int(4)) => .K </k>
+    <functions>
+      .Map
+      => "no_divisor" |-> noDivisorFunction()
+         "is_prime" |-> isPrimeFunction()
+    </functions>
+    <env> .Map => ?_FINALENV </env>
+    <result> Bool(false) => Bool(false) </result>
+
+  // N=31,D=2 satisfies N>=2 and D>=2 in the helper claim.
+  claim [helper-31-2]:
+    <k> #invoke("no_divisor", (Int(31), Int(2))) => .K </k>
+    <functions>
+      "no_divisor" |-> noDivisorFunction() _REST
+    </functions>
+    <env> .Map => ?_FINALENV </env>
+    <result> Bool(false) => Bool(true) </result>
+endmodule
diff --git a/evidence/python_case.py b/evidence/python_case.py
new file mode 100644
index 0000000000000000000000000000000000000000..b90cd557e50326ffdeef08f526ffd8e3c3bb4bfa
--- /dev/null
+++ b/evidence/python_case.py
@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+"""Run one integer case against both scratch-copied Python implementations."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+
+def load_entry(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.is_prime
+
+
+n = int(sys.argv[1])
+canonical = load_entry(
+    "trusted_canonical_case", Path("/tmp/audit-work/trusted/canonical.py")
+)
+generated = load_entry(
+    "submitted_generated_case", Path("/tmp/audit-work/candidate-src/solution.py")
+)
+left = canonical(n)
+right = generated(n)
+print(json.dumps({"input": n, "canonical": left, "generated": right}))
+raise SystemExit(0 if left == right else 1)
