+    echo "K_OUTPUT_BEGIN"
+    printf '%s\n' "$k_output"
+    echo "K_OUTPUT_END"
+    mismatches=$((mismatches + 1))
+  fi
+done
+
+echo "CASE_COUNT=${#cases[@]}"
+echo "MISMATCH_COUNT=$mismatches"
+exit "$mismatches"
