ect'Coln'ResultCellOpt.yaml\nsemantic-kompiled/dt/Lblproject'Coln'Set.yaml\nsemantic-kompiled/dt/Lblproject'Coln'Stmt.yaml\nsemantic-kompiled/dt/Lblproject'Coln'Stmts.yaml\nsemantic-kompiled/dt/Lblproject'Coln'String.yaml\nsemantic-kompiled/dt/LblpushList.yaml\nsemantic-kompiled/dt/LblremoveAll'LParUndsCommUndsRParUnds'MAP'Unds'Map'Unds'Map'Unds'Set.yaml\nsemantic-kompiled/dt/LblsignExtendBitRangeInt'LParUndsCommUndsCommUndsRParUnds'INT-COMMON'Unds'Int'Unds'Int'Unds'Int'Unds'Int.yaml\nsemantic-kompiled/dt/Lblsize'LParUndsRParUnds'SET'Unds'Int'Unds'Set.yaml\nsemantic-kompiled/dt/LblsizeList.yaml\nsemantic-kompiled/dt/LblsizeMap.yaml\nsemantic-kompiled/dt/LblupdateMap'LParUndsCommUndsRParUnds'MAP'Unds'Map'Unds'Map'Unds'Map.yaml\nsemantic-kompiled/dt/append.yaml\nsemantic-kompiled/dt/dt-search.yaml\nsemantic-kompiled/dt/dt.yaml\nsemantic-kompiled/dt/index.txt\nsemantic-kompiled/dt/match_276.yaml\nsemantic-kompiled/dt/match_277.yaml\nsemantic-kompiled/dt/match_278.yaml\nsemantic-kompiled/dt/match_279.yaml\nsemantic-kompiled/dt/match_280.yaml\nsemantic-kompiled/dt/match_281.yaml\nsemantic-kompiled/dt/match_282.yaml\nsemantic-kompiled/dt/match_283.yaml\nsemantic-kompiled/dt/match_284.yaml\nsemantic-kompiled/dt/match_285.yaml\nsemantic-kompiled/dt/match_286.yaml\nsemantic-kompiled/haskellDefinition.bin\nsemantic-kompiled/interpreter\nsemantic-kompiled/macros.kore\nsemantic-kompiled/mainModule.txt\nsemantic-kompiled/mainSyntaxModule.txt\nsemantic-kompiled/parsed.txt\nsemantic-kompiled/scanner\nsemantic-kompiled/syntaxDefinition.kore\nsemantic-kompiled/timestamp\nsemantic.k\nsolution.mpy\nsolution.py\nspec.k\nverification-kompiled/README.md\nverification-kompiled/allRules.txt\nverification-kompiled/backend.txt\nverification-kompiled/cache.bin\nverification-kompiled/compiled.bin\nverification-kompiled/compiled.txt\nverification-kompiled/configVars.sh\nverification-kompiled/definition.kore\nverification-kompiled/haskellDefinition.bin\nverification-kompiled/macros.kore\nverification-kompiled/mainModule.txt\nverification-kompiled/mainSyntaxModule.txt\nverification-kompiled/parsed.txt\nverification-kompiled/scanner\nverification-kompiled/syntaxDefinition.kore\nverification-kompiled/timestamp\nverification.k\nmodule MPY-SYNTAX\n  imports INT-SYNTAX\n  imports BOOL-SYNTAX\n  imports STRING-SYNTAX\n\n  syntax Program ::= Module(Stmts)\n\n  // The translator represents statement blocks by juxtaposition.\n  syntax Stmts ::= List{Stmt, \"\"}\n  syntax Stmt ::= FuncDef(String, Params, Stmts)\n                | Return(Expr)\n                | If(Expr, Stmts, Stmts)\n\n  syntax Params ::= Params(Ids)\n  syntax Ids ::= List{String, \",\"}\n\n  syntax Expr ::= Int(Int)\n                | Bool(Bool)\n                | Name(String)\n                | BinOp(String, Expr, Expr)\n                | Compare(Expr, CmpOp)\n                | Call(Expr, Exprs)\n  syntax CmpOp ::= CmpOp(String, Expr)\n  syntax Exprs ::= List{Expr, \",\"}\nendmodule\n\nmodule SEMANTIC\n  imports MPY-SYNTAX\n  imports MAP\n  imports INT\n  imports BOOL\n\n  syntax Function ::= function(Params, Stmts)\n\n  syntax KItem ::= #invoke(String, Exprs)\n                 | #branch(Expr, Stmts, Stmts)\n                 | #finish(Expr)\n\n  syntax Expr ::= #eval(Expr, Map) [function]\n                | #lookup(String, Map) [function]\n                | #bin(String, Expr, Expr) [function]\n                | #cmp(String, Expr, Expr) [function]\n  syntax Exprs ::= #evalArgs(Exprs, Map) [function]\n  syntax Map ::= #bind(Params, Exprs) [function]\n\n  configuration\n    <py>\n      <k> $PGM:Program ~> #invoke(\"is_prime\", Int($N:Int)) </k>\n      <functions> .Map </functions>\n      <env> .Map </env>\n      <result> Bool(false) </result>\n    </py>\n\n  rule <k> Module(SS) => SS ... </k>\n\n  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>\n  rule <k> .Stmts => .K ... </k>\n\n  rule <k> FuncDef(F, P, B) => .K ... </k>\n       <functions> FS => FS [ F <- function(P, B) ] </functions>\n\n  rule <k> #invoke(F, VS) => B ... </k>\n       <functions> ... F |-> function(P, B) ... </functions>\n       <env> _ => #bind(P, VS) </env>\n\n  rule <k> If(E, THEN, ELSE) => #branch(#eval(E, RHO), THEN, ELSE) ... </k>\n       <env> RHO </env>\n  rule <k> #branch(Bool(true),  THEN, _) => THEN ... </k>\n  rule <k> #branch(Bool(false), _, ELSE) => ELSE ... </k>\n\n  // Calls in solution.py are tail calls.  Return discards the rest of the\n  // current block, exactly as Python does.\n  rule <k> Return(Call(Name(F), ES)) ~> _ => #invoke(F, #evalArgs(ES, RHO)) </k>\n       <env> RHO </env> [priority(40)]\n  rule <k> Return(E) ~> _ => #finish(#eval(E, RHO)) </k>\n       <env> RHO </env>\n  rule <k> #finish(V) => .K </k>\n       <result> _ => V </result>\n\n  rule #lookup(X, (X |-> V:Expr) REST) => V\n\n  rule #eval(Int(I),    _)   => Int(I)\n  rule #eval(Bool(B),   _)   => Bool(B)\n  rule #eval(Name(X),   RHO) => #lookup(X, RHO)\n  rule #eval(BinOp(OP, L, R), RHO)\n    => #bin(OP, #eval(L, RHO), #eval(R, RHO))\n  rule #eval(Compare(L, CmpOp(OP, R)), RHO)\n    => #cmp(OP, #eval(L, RHO), #eval(R, RHO))\n\n  rule #bin(\"+\", Int(I), Int(J)) => Int(I +Int J)\n  rule #bin(\"*\", Int(I), Int(J)) => Int(I *Int J)\n  rule #bin(\"%\", Int(I), Int(J)) => Int(I %Int J)\n    requires J =/=Int 0\n\n  rule #cmp(\"<\",  Int(I), Int(J)) => Bool(I <Int J)\n  rule #cmp(\">\",  Int(I), Int(J)) => Bool(I >Int J)\n  rule #cmp(\"==\", Int(I), Int(J)) => Bool(I ==Int J)\n\n  rule #evalArgs((E:Expr), RHO) => #eval(E, RHO)\n  rule #evalArgs((E1:Expr, E2:Expr), RHO)\n    => (#eval(E1, RHO), #eval(E2, RHO))\n\n  rule #bind(Params(X:String), V:Expr) => X |-> V\n  rule #bind(Params(X:String, Y:String), (V1:Expr, V2:Expr))\n    => X |-> V1 Y |-> V2\nendmodule\nrequires \"semantic.k\"\n\nmodule VERIFICATION\n  imports SEMANTIC\n\n  // A mathematical reference predicate.  noDivisor(N,D) searches the finite\n  // interval D .. floor(sqrt(N)); hence prime(N) says N >= 2 and has no\n  // divisor in 2 .. floor(sqrt(N)), the standard characterization of primes.\n  syntax Bool ::= noDivisor(Int, Int) [function]\n                | prime(Int) [function]\n\n  rule noDivisor(N, D) => true\n    requires D *Int D >Int N\n  rule noDivisor(N, D) => false\n    requires D *Int D <=Int N andBool N %Int D ==Int 0\n  rule noDivisor(N, D) => noDivisor(N, D +Int 1)\n    requires D *Int D <=Int N andBool N %Int D =/=Int 0\n\n  rule prime(N) => false\n    requires N <Int 2\n  rule prime(N) => noDivisor(N, 2)\n    requires N >=Int 2\n\n  // Canonical terms for the two definitions translated from solution.py.\n  // Naming them keeps the claims readable; these are equations, not shortcuts\n  // in the execution semantics.\n  syntax Function ::= noDivisorFunction() [function]\n                    | isPrimeFunction() [function]\n  syntax Program ::= solutionProgram() [function]\n\n  rule noDivisorFunction() =>\n    function(\n      Params(\"n\", \"d\"),\n      If(\n        Compare(BinOp(\"*\", Name(\"d\"), Name(\"d\")), CmpOp(\">\", Name(\"n\"))),\n        Return(Bool(true)),\n        .Stmts)\n      If(\n        Compare(BinOp(\"%\", Name(\"n\"), Name(\"d\")), CmpOp(\"==\", Int(0))),\n        Return(Bool(false)),\n        .Stmts)\n      Return(Call(Name(\"no_divisor\"), Name(\"n\"), BinOp(\"+\", Name(\"d\"), Int(1))))\n    )\n\n  rule isPrimeFunction() =>\n    function(\n      Params(\"n\"),\n      If(\n        Compare(Name(\"n\"), CmpOp(\"<\", Int(2))),\n        Return(Bool(false)),\n        .Stmts)\n      Return(Call(Name(\"no_divisor\"), Name(\"n\"), Int(2)))\n    )\n\n  rule solutionProgram() =>\n    Module(\n      FuncDef(\"no_divisor\", Params(\"n\", \"d\"),\n        If(\n          Compare(BinOp(\"*\", Name(\"d\"), Name(\"d\")), CmpOp(\">\", Name(\"n\"))),\n          Return(Bool(true)),\n          .Stmts)\n        If(\n          Compare(BinOp(\"%\", Name(\"n\"), Name(\"d\")), CmpOp(\"==\", Int(0))),\n          Return(Bool(false)),\n          .Stmts)\n        Return(Call(Name(\"no_divisor\"), Name(\"n\"), BinOp(\"+\", Name(\"d\"), Int(1)))))\n      FuncDef(\"is_prime\", Params(\"n\"),\n        If(\n          Compare(Name(\"n\"), CmpOp(\"<\", Int(2))),\n          Return(Bool(false)),\n          .Stmts)\n        Return(Call(Name(\"no_divisor\"), Name(\"n\"), Int(2))))\n    )\nendmodule\nrequires \"verification.k\"\n\nmodule SPEC\n  imports VERIFICATION\n\n  // Tail-recursive invariant: for any search position D >= 2, executing the\n  // helper computes exactly the finite divisor search in verification.k.\n  claim\n    <k> #invoke(\"no_divisor\", (Int(N), Int(D))) => .K </k>\n    <functions>\n      \"no_divisor\" |-> noDivisorFunction() REST\n    </functions>\n    <env> RHO => ?FINALENV </env>\n    <result> R => Bool(noDivisor(N, D)) </result>\n    requires N >=Int 2 andBool D >=Int 2\n    [label(helper-correct)]\n\n  // Universal target theorem for the required entry point.\n  claim\n    <k> solutionProgram() ~> #invoke(\"is_prime\", Int(N)) => .K </k>\n    <functions>\n      .Map\n      => \"no_divisor\" |-> noDivisorFunction()\n         \"is_prime\" |-> isPrimeFunction()\n    </functions>\n    <env> .Map => ?FINALENV </env>\n    <result> Bool(false) => Bool(prime(N)) </result>\n    [label(is-prime-correct)]\nendmodule\n453ca5e2c63fdbba8afa4208d797faeb371744b7de1e5c401d89664050bcc613  prompt.py\n406485eac118431c08ef59f30f79dfa6aa9d5825408917fc5ce7c806e664db16  py2mpy.py\nde0ee20fa0e2b3e88644ba29a4a96b47b5dbb0ef00569b3d7bcd998a7e21d0fd  solution.py\n00b29828350d9010ed35873d1f9bea77917fb78d7e196128343103f6806c7bff  solution.mpy\n0c5219929ccdd057e62492bd669edea26e1622cdfb9dc45d1ed92430cf9b170e  semantic.k\n04138b47103e47ed5e8921591b171907626a0f9ff29f62df303ce38e4aab1154  verification.k\nd3c3d46ddd0d34a66dc17ee92ad7a6d83f95139d399c0a4faf72ab61e8e23569  spec.k\n9ebaa81360888d14e11ad1f5f18c699a25f670c9da640c7f272f853a32e45133  prove.sh\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f892c-9b50-7ad1-b9a6-0cafc7401fc6"}}}
