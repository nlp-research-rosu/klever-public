80:{"timestamp":"2026-07-22T09:38:41.625Z","type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_gwZ4lNh4dEsd2ZgV1fX004bh","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"Usage: kprove [options] <file>\n  Options:\n    --branching-allowed <number>\n      Number of branching events allowed before a forcible stop.\n      Default: 2147483647\n    --claims <labels>\n      Only keep this comma separated list of claims\n    --color <mode>\n      Use colors in output. Default is on.\n      Possible Values: [OFF, ON, EXTENDED]\n    --debug\n      Print debugging output messages and error stack traces\n      Default: false\n    --debug-script <file>\n      Run script passed in specified file when the debugger starts. Used with \n      --debugger. \n    --debug-warnings\n      Print debugging output messages and error/warning stack traces\n      Default: false\n    --debugger\n      Launch proof in an interactive debugger. Currently only supported by the \n      Haskell backend.\n      Default: false\n    --default-claim-type <type>\n      Default type for claims. Values: [all-path|one-path].\n      Default: ALL_PATH\n      Possible Values: [REWRITE_RULE, ONE_PATH, ALL_PATH]\n    --definition <path>, -d <path>\n      Exact path to the kompiled directory.\n    --depth <number>\n      The maximum number of computational steps to prove\n    --dry-run\n      Compile program into KORE format but do not run. Only used in Haskell \n      and LLVM backend.\n      Default: false\n    --emit-json\n      Emit JSON serialized main definition for proving.\n      Default: false\n    --emit-json-spec <file>\n      If set, emit the JSON serialization of the spec module to the specified \n      file. \n    --exclude <labels>\n      Exclude this comma separated list of claims\n    --help, -h\n      Print this help message\n    --help-hidden, -hh\n      Print advanced options help message\n    --md-selector <expression>\n      Preprocessor: for .md files, select only the md code blocks that match \n      the selector expression. Ex:'k&(!a|b)'.\n      Default: k\n    --no-alpha-renaming\n      Do not alpha rename anonymous variables in output.\n      Default: false\n    --no-sort-collections\n      Do not sort collections before printing (for speed).\n      Default: false\n    --no-substitution-filtering\n      Do not remove conjuncts of anonymous variables from substitution in \n      output. \n      Default: false\n    --output <mode>, -o <mode>\n      How to display krun results. <mode> is either \n      [pretty|program|kast|binary|json|kore|none]. \n      Default: PRETTY\n      Possible Values: [PRETTY, PROGRAM, KAST, JSON, KORE, NONE]\n    --output-file <file>\n      Store output in the file instead of displaying it.\n    --output-flatten <KLabels>\n      (Assoc) KLabels to flatten into one list.\n      Default: []\n    --output-omit <KLabels>\n      KLabels to omit from the output.\n      Default: []\n    --output-tokast <KLabels>\n      KLabels to output as KAST tokens.\n      Default: []\n    --output-tokenize <KLabels>\n      KLabels to tokenize underneath (reducing output size).\n      Default: []\n    --spec-module <name>, -sm <name>\n      Name of module containing specification to prove\n    --temp-dir <path>\n      Put temp files in this location. Default is /tmp/.<tool>-xxx\n    --trusted <labels>\n      Mark this comma separated list of claims as [trusted]\n    --verbose, -v\n      Print verbose output messages\n      Default: false\n    --version\n      Print version information\n      Default: false\n    --warnings <level>, -w <level>\n      Warning level. Values: [all|normal|none]\n      Default: NORMAL\n      Possible Values: [ALL, NORMAL, NONE]\n    --warnings-to-errors, -w2e\n      Convert warnings to errors.\n      Default: false\n    -I <path>\n      Add a directory to the search path for requires statements.\n      Default: []\n    -W <warning>\n      Enable specific warning categories. Values: [non-exhaustive-match|undeleted-temp-dir|missing-hook-java|missing-syntax-module|invalid-exit-code|deprecated-backend|invalid-config-var|future-error|unused-var|proof-lint|useless-rule|unresolved-function-symbol|malformed-markdown|invalidated-cache|unused-symbol|removed-anywhere]\n      Default: []\n    -Wno <warning>\n      Disable specific warning categories.\n      Default: []\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f892c-9b50-7ad1-b9a6-0cafc7401fc6"}}}
