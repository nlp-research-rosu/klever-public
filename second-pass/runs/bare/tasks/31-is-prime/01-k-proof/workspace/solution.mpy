Module(
  FuncDef("no_divisor", Params("n", "d"),
    If(Compare(BinOp("*", Name("d"), Name("d")), CmpOp(">", Name("n"))),
      Return(Bool(true)),
      )
    If(Compare(BinOp("%", Name("n"), Name("d")), CmpOp("==", Int(0))),
      Return(Bool(false)),
      )
    Return(
      Call(Name("no_divisor"), Name("n"), BinOp("+", Name("d"), Int(1)))))
  FuncDef("is_prime", Params("n"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Bool(false)),
      )
    Return(Call(Name("no_divisor"), Name("n"), Int(2)))))
