new file mode 100644
index 0000000000000000000000000000000000000000..bd138c678382e54d47f69263446a31f3ad4f79cb
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def no_divisor(n, d):
+    if d * d > n:
+        return True
+    if n % d == 0:
+        return False
+    return no_divisor(n, d + 1)
+
+
+def is_prime(n):
+    if n < 2:
+        return False
+    return no_divisor(n, 2)
