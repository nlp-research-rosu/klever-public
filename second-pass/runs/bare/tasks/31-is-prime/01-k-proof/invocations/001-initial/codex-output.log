+    return no_divisor(n, d + 1)
+
+
+def is_prime(n):
+    if n < 2:
+        return False
+    return no_divisor(n, 2)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fc3b176df3b3d2cfb803015cd83e77285f61a565
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Tail-recursive invariant: for any search position D >= 2, executing the
+  // helper computes exactly the finite divisor search in verification.k.
+  claim
+    <k> #invoke("no_divisor", (Int(N), Int(D))) => .K </k>
+    <functions>
+      "no_divisor" |-> noDivisorFunction() REST
+    </functions>
+    <env> RHO => ?FINALENV </env>
+    <result> R => Bool(noDivisor(N, D)) </result>
+    requires N >=Int 2 andBool D >=Int 2
+    [label(helper-correct)]
+
+  // Universal target theorem for the required entry point.
+  claim
+    <k> solutionProgram() ~> #invoke("is_prime", Int(N)) => .K </k>
+    <functions>
+      .Map
+      => "no_divisor" |-> noDivisorFunction()
+         "is_prime" |-> isPrimeFunction()
+    </functions>
+    <env> .Map => ?FINALENV </env>
+    <result> Bool(false) => Bool(prime(N)) </result>
+    [label(is-prime-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a3951ad3a4392648a3597ed3829be8233465ef7f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,74 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A mathematical reference predicate.  noDivisor(N,D) searches the finite
+  // interval D .. floor(sqrt(N)); hence prime(N) says N >= 2 and has no
+  // divisor in 2 .. floor(sqrt(N)), the standard characterization of primes.
+  syntax Bool ::= noDivisor(Int, Int) [function]
+                | prime(Int) [function]
+
+  rule noDivisor(N, D) => true
+    requires D *Int D >Int N
+  rule noDivisor(N, D) => false
+    requires D *Int D <=Int N andBool D dividesInt N
+  rule noDivisor(N, D) => noDivisor(N, D +Int 1)
+    requires D *Int D <=Int N andBool notBool (D dividesInt N)
+
+  rule prime(N) => false
+    requires N <Int 2
+  rule prime(N) => noDivisor(N, 2)
+    requires N >=Int 2
+
+  // Canonical terms for the two definitions translated from solution.py.
+  // Naming them keeps the claims readable; these are equations, not shortcuts
+  // in the execution semantics.
+  syntax Function ::= noDivisorFunction() [function]
+                    | isPrimeFunction() [function]
+  syntax Program ::= solutionProgram() [function]
+
+  rule noDivisorFunction() =>
+    function(
+      Params("n", "d"),
+      If(
+        Compare(BinOp("*", Name("d"), Name("d")), CmpOp(">", Name("n"))),
+        Return(Bool(true)),
+        .Stmts)
+      If(
+        Compare(BinOp("%", Name("n"), Name("d")), CmpOp("==", Int(0))),
+        Return(Bool(false)),
+        .Stmts)
+      Return(Call(Name("no_divisor"), Name("n"), BinOp("+", Name("d"), Int(1))))
+    )
+
+  rule isPrimeFunction() =>
+    function(
+      Params("n"),
+      If(
+        Compare(Name("n"), CmpOp("<", Int(2))),
+        Return(Bool(false)),
+        .Stmts)
+      Return(Call(Name("no_divisor"), Name("n"), Int(2)))
+    )
+
+  rule solutionProgram() =>
+    Module(
+      FuncDef("no_divisor", Params("n", "d"),
+        If(
+          Compare(BinOp("*", Name("d"), Name("d")), CmpOp(">", Name("n"))),
+          Return(Bool(true)),
+          .Stmts)
+        If(
+          Compare(BinOp("%", Name("n"), Name("d")), CmpOp("==", Int(0))),
+          Return(Bool(false)),
+          .Stmts)
+        Return(Call(Name("no_divisor"), Name("n"), BinOp("+", Name("d"), Int(1)))))
+      FuncDef("is_prime", Params("n"),
+        If(
+          Compare(Name("n"), CmpOp("<", Int(2))),
+          Return(Bool(false)),
+          .Stmts)
+        Return(Call(Name("no_divisor"), Name("n"), Int(2))))
+    )
+endmodule

exec
/bin/bash -lc ./prove.sh in /work
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8d851fa2504a692a62b1b5b320693d6ae0d9c065
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the translated program from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the semantics together with its mathematical verification helpers.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+# Exercise the translated term under the K semantics.  The comparison strips
+# only layout whitespace from the isolated <result> cell.
+check_case() {
+  local n="$1"
+  local expected="$2"
+  local actual
+  actual="$(
+    krun solution.mpy --definition verification-kompiled -cN="$n" \
+      | sed -n '/<result>/,/<\/result>/p' \
+      | tr -d '[:space:]'
+  )"
+  test "$actual" = "<result>Bool($expected)</result>"
+  printf 'krun is_prime(%s) = %s\n' "$n" "$expected"
+}
+
+check_case 6 false
+check_case 101 true
+check_case 11 true
+check_case 13441 true
+check_case 61 true
+check_case 4 false
+check_case 1 false
+check_case 2 true
+check_case 49 false
+
+# This single positive target command proves every claim in SPEC.  Capture and
+# check stdout as well as relying on kprove's exit status.
+proof_output="$(
+  kprove \
+    --definition verification-kompiled \
+    --spec-module SPEC \
+    spec.k
+)"
+printf '%s\n' "$proof_output"
+test "$proof_output" = "#Top"
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..28a5c913f14aa0dfdbe1fb1ee5774ffad4e59dc1
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,106 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= Module(Stmts)
+
+  // The translator represents statement blocks by juxtaposition.
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= FuncDef(String, Params, Stmts)
+                | Return(Expr)
+                | If(Expr, Stmts, Stmts)
+
+  syntax Params ::= Params(Ids)
+  syntax Ids ::= List{String, ","}
+
+  syntax Expr ::= Int(Int)
+                | Bool(Bool)
+                | Name(String)
+                | BinOp(String, Expr, Expr)
+                | Compare(Expr, CmpOp)
+                | Call(Expr, Exprs)
+  syntax CmpOp ::= CmpOp(String, Expr)
+  syntax Exprs ::= List{Expr, ","}
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports MAP
+  imports INT
+  imports BOOL
+
+  syntax Function ::= function(Params, Stmts)
+
+  syntax KItem ::= #invoke(String, Exprs)
+                 | #branch(Expr, Stmts, Stmts)
+                 | #finish(Expr)
+
+  syntax Expr ::= #eval(Expr, Map) [function]
+                | #lookup(String, Map) [function]
+                | #bin(String, Expr, Expr) [function]
+                | #cmp(String, Expr, Expr) [function]
+  syntax Exprs ::= #evalArgs(Exprs, Map) [function]
+  syntax Map ::= #bind(Params, Exprs) [function]
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> #invoke("is_prime", Int($N:Int)) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> Bool(false) </result>
+    </py>
+
+  rule <k> Module(SS) => SS ... </k>
+
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
+  rule <k> .Stmts => .K ... </k>
+
+  rule <k> FuncDef(F, P, B) => .K ... </k>
+       <functions> FS => FS [ F <- function(P, B) ] </functions>
+
+  rule <k> #invoke(F, VS) => B ... </k>
+       <functions> ... F |-> function(P, B) ... </functions>
+       <env> _ => #bind(P, VS) </env>
+
+  rule <k> If(E, THEN, ELSE) => #branch(#eval(E, RHO), THEN, ELSE) ... </k>
+       <env> RHO </env>
+  rule <k> #branch(Bool(true),  THEN, _) => THEN ... </k>
+  rule <k> #branch(Bool(false), _, ELSE) => ELSE ... </k>
+
+  // Calls in solution.py are tail calls.  Return discards the rest of the
+  // current block, exactly as Python does.
+  rule <k> Return(Call(Name(F), ES)) ~> _ => #invoke(F, #evalArgs(ES, RHO)) </k>
+       <env> RHO </env> [priority(40)]
+  rule <k> Return(E) ~> _ => #finish(#eval(E, RHO)) </k>
+       <env> RHO </env>
+  rule <k> #finish(V) => .K </k>
+       <result> _ => V </result>
+
+  rule #lookup(X, (X |-> V:Expr) REST) => V
+
+  rule #eval(Int(I),    _)   => Int(I)
+  rule #eval(Bool(B),   _)   => Bool(B)
+  rule #eval(Name(X),   RHO) => #lookup(X, RHO)
+  rule #eval(BinOp(OP, L, R), RHO)
+    => #bin(OP, #eval(L, RHO), #eval(R, RHO))
+  rule #eval(Compare(L, CmpOp(OP, R)), RHO)
+    => #cmp(OP, #eval(L, RHO), #eval(R, RHO))
+
+  rule #bin("+", Int(I), Int(J)) => Int(I +Int J)
+  rule #bin("*", Int(I), Int(J)) => Int(I *Int J)
+  rule #bin("%", Int(I), Int(J)) => Int(I %Int J)
+    requires J =/=Int 0
+
+  rule #cmp("<",  Int(I), Int(J)) => Bool(I <Int J)
+  rule #cmp(">",  Int(I), Int(J)) => Bool(I >Int J)
+  rule #cmp("==", Int(I), Int(J)) => Bool(I ==Int J)
+
+  rule #evalArgs((E:Expr), RHO) => #eval(E, RHO)
+  rule #evalArgs((E1:Expr, E2:Expr), RHO)
+    => (#eval(E1, RHO), #eval(E2, RHO))
+
+  rule #bind(Params(X:String), V:Expr) => X |-> V
+  rule #bind(Params(X:String, Y:String), (V1:Expr, V2:Expr))
+    => X |-> V1 Y |-> V2
+endmodule
