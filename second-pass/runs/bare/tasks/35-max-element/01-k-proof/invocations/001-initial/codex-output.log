diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..21cd49c8d73e817229636b58216c7caa8b6cef2e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // Universal functional-correctness theorem: for every non-empty integer
+  // list, executing the translated function returns its mathematical maximum.
+  claim
+    <mpy>
+      <k> solutionProgram ~> invoke("max_element", IS:IntSeq) => .K </k>
+      <functions> .Map =>
+        "max_element" |-> closure(
+          Params("l"), Return(Call(Name("max"), Name("l"))))
+      </functions>
+      <env> .Map => "l" |-> IS </env>
+      <result> noResult => result(expectedMaximum(IS)) </result>
+    </mpy>
+
+  // The two examples from prompt.py are retained as concrete regression
+  // theorems in addition to the universal theorem above.
+  claim
+    <mpy>
+      <k> solutionProgram ~> invoke("max_element", [1, 2, 3]) => .K </k>
+      <functions> .Map =>
+        "max_element" |-> closure(
+          Params("l"), Return(Call(Name("max"), Name("l"))))
+      </functions>
+      <env> .Map => "l" |-> [1, 2, 3] </env>
+      <result> noResult => result(3) </result>
+    </mpy>
+
+  claim
+    <mpy>
+      <k>
+        solutionProgram ~> invoke(
+          "max_element", [5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]
+        )
+        => .K
+      </k>
+      <functions> .Map =>
+        "max_element" |-> closure(
+          Params("l"), Return(Call(Name("max"), Name("l"))))
+      </functions>
+      <env> .Map =>
+        "l" |-> [5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]
+      </env>
+      <result> noResult => result(123) </result>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e067c2d320d0232fe95467dba769ddc1c10f7c5f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,19 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTICS
+
+  // This nullary function expands to the exact AST in solution.mpy.  Keeping
+  // it here makes each reachability claim visibly about the translated code.
+  syntax Program ::= "solutionProgram" [function, total]
+  rule solutionProgram =>
+    Module(
+      FuncDef("max_element", Params("l"),
+        Return(Call(Name("max"), Name("l")))))
+
+  // The postcondition is stated at the contract level, independently of the
+  // interpreter's result cell.  maxInts is the mathematical maximum defined
+  // over the semantics' non-empty integer-list domain.
+  syntax Int ::= expectedMaximum(IntSeq) [function, total]
+  rule expectedMaximum(IS) => maxInts(IS)
+endmodule

