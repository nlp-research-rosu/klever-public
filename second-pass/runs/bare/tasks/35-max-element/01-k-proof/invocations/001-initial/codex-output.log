diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6456cbfc203832bc2bfd2d42b7a553a2868363ae
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,88 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor grammar consumed by py2mpy.py for this program.
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax Exprs ::= List{Expr, ","}
+
+  // A deliberately inductive, non-empty input domain.  The HumanEval
+  // contract has no result for an empty list, so empty lists are not inputs.
+  syntax IntSeq ::= "[" NonEmptyInts "]"
+  syntax NonEmptyInts ::= Int
+                        | Int "," NonEmptyInts
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+  imports MAP
+
+  syntax Function ::= "closure" "(" Params "," Stmts ")"
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "invoke" "(" String "," IntSeq ")"
+                 | "eval" "(" Expr ")"
+                 | "intVal" "(" Int ")"
+                 | "doReturn"
+
+  // Mathematical meaning of Python's max on a non-empty integer list.
+  syntax Int ::= maxInts(IntSeq) [function, total]
+  syntax Int ::= imax(Int, Int) [function, total]
+
+  rule maxInts([ I:Int ]) => I
+  rule maxInts([ I:Int, IS:NonEmptyInts ]) => imax(I, maxInts([ IS ]))
+
+  rule imax(I, J) => I requires I >=Int J
+  rule imax(I, J) => J requires I <Int J
+
+  configuration
+    <mpy>
+      <k> $PGM:Program ~> invoke("max_element", $ARGS:IntSeq) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+
+  // Module and statement-list execution.
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S:Stmt) => S ... </k>
+  rule <k> exec(S:Stmt REST:Stmts) => S ~> exec(REST) ... </k>
+
+  // Function definitions are closures.  This task has no free variables, so
+  // the function body and its parameter list are the entire closure value.
+  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
+       <functions> FUNS => FUNS [ F <- closure(PS, BODY) ] </functions>
+
+  // The requested entry point has one argument.  A fresh function environment
+  // is installed when it is invoked.
+  rule <k> invoke(F, ARG) => exec(BODY) ... </k>
+       <functions> ... F |-> closure(Params(P), BODY) ... </functions>
+       <env> _ => P |-> ARG </env>
+
+  rule <k> Return(E) => eval(E) ~> doReturn ... </k>
+
+  // Expression evaluation needed by solution.mpy.  Name lookup is modeled
+  // separately from the max call so the environment is explicit in the state.
+  rule <k> eval(Name(X)) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule <k> eval(Call(Name("max"), Name(X))) => intVal(maxInts(IS)) ... </k>
+       <env> ... X |-> IS:IntSeq ... </env>
+
+  rule <k> intVal(I) ~> doReturn => .K ... </k>
+       <result> noResult => result(I) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b43ba8ed89ff9c74010721ff9224745aaefce7c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def max_element(l: list):
+    return max(l)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..21cd49c8d73e817229636b58216c7caa8b6cef2e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // Universal functional-correctness theorem: for every non-empty integer
+  // list, executing the translated function returns its mathematical maximum.
+  claim
+    <mpy>
+      <k> solutionProgram ~> invoke("max_element", IS:IntSeq) => .K </k>
+      <functions> .Map =>
+        "max_element" |-> closure(
+          Params("l"), Return(Call(Name("max"), Name("l"))))
+      </functions>
+      <env> .Map => "l" |-> IS </env>
+      <result> noResult => result(expectedMaximum(IS)) </result>
+    </mpy>
+
+  // The two examples from prompt.py are retained as concrete regression
+  // theorems in addition to the universal theorem above.
+  claim
+    <mpy>
+      <k> solutionProgram ~> invoke("max_element", [1, 2, 3]) => .K </k>
+      <functions> .Map =>
+        "max_element" |-> closure(
+          Params("l"), Return(Call(Name("max"), Name("l"))))
+      </functions>
+      <env> .Map => "l" |-> [1, 2, 3] </env>
+      <result> noResult => result(3) </result>
+    </mpy>
+
+  claim
+    <mpy>
+      <k>
+        solutionProgram ~> invoke(
+          "max_element", [5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]
+        )
+        => .K
+      </k>
+      <functions> .Map =>
+        "max_element" |-> closure(
+          Params("l"), Return(Call(Name("max"), Name("l"))))
+      </functions>
+      <env> .Map =>
+        "l" |-> [5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]
+      </env>
+      <result> noResult => result(123) </result>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e067c2d320d0232fe95467dba769ddc1c10f7c5f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,19 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTICS
+
+  // This nullary function expands to the exact AST in solution.mpy.  Keeping
+  // it here makes each reachability claim visibly about the translated code.
+  syntax Program ::= "solutionProgram" [function, total]
+  rule solutionProgram =>
+    Module(
+      FuncDef("max_element", Params("l"),
+        Return(Call(Name("max"), Name("l")))))
+
+  // The postcondition is stated at the contract level, independently of the
+  // interpreter's result cell.  maxInts is the mathematical maximum defined
+  // over the semantics' non-empty integer-list domain.
+  syntax Int ::= expectedMaximum(IntSeq) [function, total]
+  rule expectedMaximum(IS) => maxInts(IS)
+endmodule

