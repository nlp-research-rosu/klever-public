new file mode 100644
index 0000000000000000000000000000000000000000..e067c2d320d0232fe95467dba769ddc1c10f7c5f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,19 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTICS
+
+  // This nullary function expands to the exact AST in solution.mpy.  Keeping
+  // it here makes each reachability claim visibly about the translated code.
+  syntax Program ::= "solutionProgram" [function, total]
+  rule solutionProgram =>
+    Module(
+      FuncDef("max_element", Params("l"),
+        Return(Call(Name("max"), Name("l")))))
+
+  // The postcondition is stated at the contract level, independently of the
+  // interpreter's result cell.  maxInts is the mathematical maximum defined
+  // over the semantics' non-empty integer-list domain.
+  syntax Int ::= expectedMaximum(IntSeq) [function, total]
+  rule expectedMaximum(IS) => maxInts(IS)
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2ff94a292df03188a12138fe5c5c9dd9d4e8eccc
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile semantic.k \
+  --backend haskell \
+  --main-module MPY-SEMANTICS \
+  --syntax-module MPY-SYNTAX \
+  --output-definition semantic-kompiled
+
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cARGS='[1, 2, 3]'
+
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cARGS='[5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]'
+
+kompile verification.k \
+  --backend haskell \
+  --main-module MPY-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
