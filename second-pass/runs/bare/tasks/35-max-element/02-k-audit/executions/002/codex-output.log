+      </functions>
+      <env> .Map => "l" |-> IS </env>
+      <result> noResult => result(expectedMaximum(IS)) </result>
+    </mpy>
+endmodule
diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
