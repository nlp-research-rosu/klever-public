diff --git a//tmp/audit-work/35-max-element/spec-body-mutated.k b//tmp/audit-work/35-max-element/spec-body-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..454e21c73538dfddf7b08d2e357bc7b96ae268fa
--- /dev/null
+++ b//tmp/audit-work/35-max-element/spec-body-mutated.k
@@ -0,0 +1,16 @@
+requires "verification-body-mutated.k"
+
+module SPEC-BODY-MUTATED
+  imports MPY-VERIFICATION
+
+  claim
+    <mpy>
