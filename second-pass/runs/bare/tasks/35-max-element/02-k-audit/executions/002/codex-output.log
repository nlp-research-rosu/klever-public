+print(f"CANDIDATE_WITNESS_RESULT={candidate(witness.copy())}")
+PY
+krun solution.mpy \
+  --definition audit-semantic-kompiled \
+  --color off \
+  -cARGS='[2, -5, 2]'
+
+test ! -e audit-body-mutated-kompiled
