+  --definition audit-semantic-kompiled \
+  --color off \
+  -cARGS='[1, 2]'
+python3 - <<'PY'
+def max_element(l):
+    return max(l)
+    return max(l)
+
+print(f"TRAILING_RETURN_PYTHON_RESULT={max_element([1, 2])}")
+PY
