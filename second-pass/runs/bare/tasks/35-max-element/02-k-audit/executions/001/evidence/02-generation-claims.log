8: const patch = "*** Begin Patch\n*** Add File: /work/semantic.k\n+requires \"domains.md\"\n+\n+module MPY-SYNTAX\n+  imports INT-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  // The constructor grammar consumed by py2mpy.py for this program.\n+  syntax Program ::= \"Module\" \"(\" Stmts \")\"\n+  syntax Stmts ::= List{Stmt, \"\"}\n+  syntax Stmt ::= \"FuncDef\" \"(\" String \",\" Params \",\" Stmts \")\"\n+                | \"Return\" \"(\" Expr \")\"\n+\n+  syntax Params ::= \"Params\" \"(\" Strings \")\"\n+  syntax Strings ::= List{String, \",\"}\n+\n+  syntax Expr ::= \"Name\" \"(\" String \")\"\n+                | \"Call\" \"(\" Expr \",\" Exprs \")\"\n+  syntax Exprs ::= List{Expr, \",\"}\n+\n+  // A deliberately inductive, non-empty input domain.  The HumanEval\n+  // contract has no result for an empty list, so empty lists are not inputs.\n+  syntax IntSeq ::= \"[\" NonEmptyInts \"]\"\n+  syntax NonEmptyInts ::= Int\n+                        | Int \",\" NonEmptyInts [right]\n+endmodule\n+\n+module MPY-SEMANTICS\n+  imports MPY-SYNTAX\n+  imports INT\n+  imports MAP\n+\n+  syntax Function ::= \"closure\" \"(\" Params \",\" Stmts \")\"\n+  syntax Result ::= \"noResult\" | \"result\" \"(\" Int \")\"\n+\n+  syntax KItem ::= \"exec\" \"(\" Stmts \")\"\n+                 | \"invoke\" \"(\" String \",\" IntSeq \")\"\n+                 | \"eval\" \"(\" Expr \")\"\n+                 | \"intVal\" \"(\" Int \")\"\n+                 | \"doReturn\"\n+\n+  // Mathematical meaning of Python's max on a non-empty integer list.\n+  syntax Int ::= maxInts(IntSeq) [function, total]\n+  syntax Int ::= imax(Int, Int) [function, total]\n+\n+  rule maxInts([ I:Int ]) => I\n+  rule maxInts([ I:Int, IS:NonEmptyInts ]) => imax(I, maxInts([ IS ]))\n+\n+  rule imax(I, J) => I requires I >=Int J\n+  rule imax(I, J) => J requires I <Int J\n+\n+  configuration\n+    <mpy>\n+      <k> $PGM:Program ~> invoke(\"max_element\", $ARGS:IntSeq) </k>\n+      <functions> .Map </functions>\n+      <env> .Map </env>\n+      <result> noResult </result>\n+    </mpy>\n+\n+  // Module and statement-list execution.\n+  rule <k> Module(SS) => exec(SS) ... </k>\n+  rule <k> exec(.Stmts) => .K ... </k>\n+  rule <k> exec(S:Stmt) => S ... </k>\n+  rule <k> exec(S:Stmt REST:Stmts) => S ~> exec(REST) ... </k>\n+\n+  // Function definitions are closures.  This task has no free variables, so\n+  // the function body and its parameter list are the entire closure value.\n+  rule <k> FuncDef(F, PS, BODY) => .K ... </k>\n+       <functions> FUNS => FUNS [ F <- closure(PS, BODY) ] </functions>\n+\n+  // The requested entry point has one argument.  A fresh function environment\n+  // is installed when it is invoked.\n+  rule <k> invoke(F, ARG) => exec(BODY) ... </k>\n+       <functions> ... F |-> closure(Params(P), BODY) ... </functions>\n+       <env> _ => P |-> ARG </env>\n+\n+  rule <k> Return(E) => eval(E) ~> doReturn ... </k>\n+\n+  // Expression evaluation needed by solution.mpy.  Name lookup is modeled\n+  // separately from the max call so the environment is explicit in the state.\n+  rule <k> eval(Name(X)) => V ... </k>\n+       <env> ... X |-> V ... </env>\n+\n+  rule <k> eval(Call(Name(\"max\"), Name(X))) => intVal(maxInts(IS)) ... </k>\n+       <env> ... X |-> IS:IntSeq ... </env>\n+\n+  rule <k> intVal(I) ~> doReturn => .K ... </k>\n+       <result> noResult => result(I) </result>\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module MPY-VERIFICATION\n+  imports MPY-SEMANTICS\n+\n+  // This nullary function expands to the exact AST in solution.mpy.  Keeping\n+  // it here makes each reachability claim visibly about the translated code.\n+  syntax Program ::= \"solutionProgram\" [function, total]\n+  rule solutionProgram =>\n+    Module(\n+      FuncDef(\"max_element\", Params(\"l\"),\n+        Return(Call(Name(\"max\"), Name(\"l\")))))\n+\n+  // The postcondition is stated at the contract level, independently of the\n+  // interpreter's result cell.  maxInts is the mathematical maximum defined\n+  // over the semantics' non-empty integer-list domain.\n+  syntax Int ::= expectedMaximum(IntSeq) [function, total]\n+  rule expectedMaximum(IS) => maxInts(IS)\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports MPY-VERIFICATION\n+\n+  // Universal functional-correctness theorem: for every non-empty integer\n+  // list, executing the translated function returns its mathematical maximum.\n+  claim\n+    <mpy>\n+      <k> solutionProgram ~> invoke(\"max_element\", IS:IntSeq) => .K </k>\n+      <functions> .Map =>\n+        \"max_element\" |-> closure(\n+          Params(\"l\"), Return(Call(Name(\"max\"), Name(\"l\"))))\n+      </functions>\n+      <env> .Map => \"l\" |-> IS </env>\n+      <result> noResult => result(expectedMaximum(IS)) </result>\n+    </mpy>\n+\n+  // The two examples from prompt.py are retained as concrete regression\n+  // theorems in addition to the universal theorem above.\n+  claim\n+    <mpy>\n+      <k> solutionProgram ~> invoke(\"max_element\", [1, 2, 3]) => .K </k>\n+      <functions> .Map =>\n+        \"max_element\" |-> closure(\n+          Params(\"l\"), Return(Call(Name(\"max\"), Name(\"l\"))))\n+      </functions>\n+      <env> .Map => \"l\" |-> [1, 2, 3] </env>\n+      <result> noResult => result(3) </result>\n+    </mpy>\n+\n+  claim\n+    <mpy>\n+      <k>\n+        solutionProgram ~> invoke(\n+          \"max_element\", [5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]\n+        )\n+        => .K\n+      </k>\n+      <functions> .Map =>\n+        \"max_element\" |-> closure(\n+          Params(\"l\"), Return(Call(Name(\"max\"), Name(\"l\"))))\n+      </functions>\n+      <env> .Map =>\n+        \"l\" |-> [5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]\n+      </env>\n+      <result> noResult => result(123) </result>\n+    </mpy>\n+endmodule\n*** End Patch";\ntext(await tools.apply_patch(patch));\n
