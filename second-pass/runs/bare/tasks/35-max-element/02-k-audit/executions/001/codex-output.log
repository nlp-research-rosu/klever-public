+    return "[" + ", ".join(str(value) for value in values) + "]"
+
+
+def run_krun(values: list[int]) -> subprocess.CompletedProcess[str]:
+    command = [
+        "krun",
+        str(PROGRAM),
+        "--definition",
+        str(DEFINITION),
+        f"-cARGS={k_list(values)}",
