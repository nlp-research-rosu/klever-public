+        + "four " * numbers.count("four")
+        + "five " * numbers.count("five")
+        + "six " * numbers.count("six")
+        + "seven " * numbers.count("seven")
+        + "eight " * numbers.count("eight")
+        + "nine " * numbers.count("nine")
+    ).strip()
