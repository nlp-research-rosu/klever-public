diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9a374a70c9bad63679bf845c43f1c82f33347fbd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,54 @@
+requires "solution-program.k"
+
+module VERIFICATION
+  imports SOLUTION-PROGRAM
+
+  // Independent executable statement of the required ordering: the result
+  // has one block per numeral, arranged from zero through nine.  On valid
+  // inputs no numeral word is a substring of another numeral word, so K's
+  // non-overlapping occurrence count equals that token's multiplicity.
+  syntax String ::= sortSpec(String) [function]
+  rule sortSpec(S) => trimTrailingSpace(
+       repeatString("zero ",  countAllOccurrences(S, "zero"))
+    +String repeatString("one ",   countAllOccurrences(S, "one"))
+    +String repeatString("two ",   countAllOccurrences(S, "two"))
+    +String repeatString("three ", countAllOccurrences(S, "three"))
+    +String repeatString("four ",  countAllOccurrences(S, "four"))
+    +String repeatString("five ",  countAllOccurrences(S, "five"))
+    +String repeatString("six ",   countAllOccurrences(S, "six"))
+    +String repeatString("seven ", countAllOccurrences(S, "seven"))
+    +String repeatString("eight ", countAllOccurrences(S, "eight"))
+    +String repeatString("nine ",  countAllOccurrences(S, "nine"))
+  )
+
+  syntax Bool ::= isNumeral(String) [function, total]
+  rule isNumeral("zero")  => true
+  rule isNumeral("one")   => true
+  rule isNumeral("two")   => true
+  rule isNumeral("three") => true
+  rule isNumeral("four")  => true
+  rule isNumeral("five")  => true
+  rule isNumeral("six")   => true
+  rule isNumeral("seven") => true
+  rule isNumeral("eight") => true
+  rule isNumeral("nine")  => true
+  rule isNumeral(_)        => false [owise]
+
+  // Recognizes exactly the contract's canonical space-delimited inputs,
+  // plus the empty input (which the reference tests conventionally admit).
+  syntax Bool ::= validNumerals(String) [function]
+  rule validNumerals("") => true
+  rule validNumerals(S) => isNumeral(S)
+    requires S =/=String ""
+     andBool findString(S, " ", 0) ==Int -1
+  rule validNumerals(S) =>
+       isNumeral(substrString(S, 0, findString(S, " ", 0)))
+    andBool validNumerals(substrString(
+              S,
+              findString(S, " ", 0) +Int 1,
+              lengthString(S)))
+    requires findString(S, " ", 0) >=Int 0
+     andBool findString(S, " ", 0) <Int lengthString(S) -Int 1
+  rule validNumerals(S) => false
+    requires findString(S, " ", 0) ==Int lengthString(S) -Int 1
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..59316735a2948ecdfbc0e1fb810f2f964b14ea19
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd -- "$(dirname -- "$0")"
+
+# Recreate the translator artifact from the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Check the implementation under CPython as an independent executable sanity
+# check before invoking the K model.
+python3 - <<'PY'
+from solution import sort_numbers
+
+assert sort_numbers("three one five") == "one three five"
+assert sort_numbers("two two one zero two") == "zero one two two two"
+assert sort_numbers(
+    "nine eight seven six five four three two one zero"
+) == "zero one two three four five six seven eight nine"
+assert sort_numbers("") == ""
+PY
+
+# Compile the semantics together with its proof-only verification functions.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+# Execute the actual translator output, not the compact proof abbreviation.
+krun solution.mpy --definition verification-kompiled \
+  -cARG='"three one five"'
+krun solution.mpy --definition verification-kompiled \
+  -cARG='"two two one zero two"'
+krun solution.mpy --definition verification-kompiled \
+  -cARG='"nine eight seven six five four three two one zero"'
+krun solution.mpy --definition verification-kompiled -cARG='""'
+
+# This single invocation proves every claim in spec.k and must print #Top.
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..9cc8a2acfbf72b88704b32d818d6ff194ebb343b
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,83 @@
+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Ids    ::= List{String, ","}
+  syntax Exprs  ::= List{Expr, ","}
+  syntax Stmts  ::= List{Stmt, ""}
+
+  syntax Params ::= "Params" "(" Ids ")"
+
+  syntax Expr ::= "Name"      "(" String ")"
+                | "Str"       "(" String ")"
+                | "Int"       "(" Int ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call"      "(" Expr "," Exprs ")"
+                | "BinOp"     "(" String "," Expr "," Expr ")"
+
+  syntax Stmt ::= "Return"  "(" Expr ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Val ::= VStr(String) | VInt(Int)
+  syntax KItem ::= invoke(String)
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+
+  configuration <k> $PGM:Program ~> invoke($ARG:String) </k>
+
+  syntax Val ::= evalProgram(Program, String) [function]
+  syntax Val ::= eval(Expr, String)            [function]
+  syntax Val ::= addVals(Val, Val)             [function]
+  syntax Val ::= multiplyVals(Val, Val)        [function]
+  syntax Val ::= countVal(Val, String)         [function]
+  syntax Val ::= stripVal(Val)                 [function]
+
+  // This condition's Python subset only needs one top-level, one-argument
+  // function whose body is a return.  Expressions below are compositional.
+  rule evalProgram(
+         Module(FuncDef("sort_numbers", Params("numbers"), Return(E))),
+         S
+       ) => eval(E, S)
+
+  rule eval(Name("numbers"), S) => VStr(S)
+  rule eval(Str(S), _)           => VStr(S)
+  rule eval(Int(I), _)           => VInt(I)
+
+  rule eval(BinOp("+", E1, E2), S)
+    => addVals(eval(E1, S), eval(E2, S))
+  rule eval(BinOp("*", E1, E2), S)
+    => multiplyVals(eval(E1, S), eval(E2, S))
+
+  rule eval(Call(Attribute(E, "count"), Str(Needle)), S)
+    => countVal(eval(E, S), Needle)
+  rule eval(Call(Attribute(E, "strip"), .Exprs), S)
+    => stripVal(eval(E, S))
+
+  rule addVals(VStr(S1), VStr(S2)) => VStr(S1 +String S2)
+  rule multiplyVals(VStr(S), VInt(N)) => VStr(repeatString(S, N))
+  rule countVal(VStr(S), Needle) => VInt(countAllOccurrences(S, Needle))
+  rule stripVal(VStr(S)) => VStr(trimTrailingSpace(S))
+
+  // Concrete helpers for the two Python string operations not directly
+  // hooked by K.  The value passed to strip is produced by concatenating
+  // zero or more "word " blocks, so removing its one trailing space is exact.
+  syntax String ::= repeatString(String, Int) [function]
+  rule repeatString(_, N) => ""
+    requires N <=Int 0
+    [concrete(N), simplification]
+  rule repeatString(S, N) => S +String repeatString(S, N -Int 1)
+    requires N >Int 0
+    [concrete(N), simplification]
+
+  syntax String ::= trimTrailingSpace(String) [function]
+  rule trimTrailingSpace("") => ""
+  rule trimTrailingSpace(S)
+    => substrString(S, 0, lengthString(S) -Int 1)
+    requires lengthString(S) >Int 0
+    [concrete(S), simplification]
+
+  rule <k> P:Program ~> invoke(S) => evalProgram(P, S) ... </k>
+endmodule
diff --git a/solution-program.k b/solution-program.k
new file mode 100644
index 0000000000000000000000000000000000000000..2c38ef5b081a4d6a71dc52a10d3083356b0def91
--- /dev/null
+++ b/solution-program.k
@@ -0,0 +1,49 @@
+requires "semantic.k"
+
+module SOLUTION-PROGRAM
+  imports MPY
+
+  // A compact K spelling of the exact constructor tree in solution.mpy.
+  // block(Word, Printed) is the AST for:
+  //     "Printed" * numbers.count("Word")
+  syntax Expr ::= block(String, String) [function]
+  rule block(Word, Printed) =>
+    BinOp(
+      "*",
+      Str(Printed),
+      Call(Attribute(Name("numbers"), "count"), Str(Word)))
+
+  syntax Expr ::= "solutionBody" [function]
+  rule solutionBody =>
+    Call(
+      Attribute(
+        BinOp("+",
+          BinOp("+",
+            BinOp("+",
+              BinOp("+",
+                BinOp("+",
+                  BinOp("+",
+                    BinOp("+",
+                      BinOp("+",
+                        BinOp("+",
+                          block("zero", "zero "),
+                          block("one", "one ")),
+                        block("two", "two ")),
+                      block("three", "three ")),
+                    block("four", "four ")),
+                  block("five", "five ")),
+                block("six", "six ")),
+              block("seven", "seven ")),
+            block("eight", "eight ")),
+          block("nine", "nine ")),
+        "strip"),
+      .Exprs)
+
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef(
+        "sort_numbers",
+        Params("numbers"),
+        Return(solutionBody)))
+endmodule
