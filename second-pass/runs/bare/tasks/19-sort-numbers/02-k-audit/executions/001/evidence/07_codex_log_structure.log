+def sort_numbers(numbers: str) -> str:
+    return (
+        "zero " * numbers.count("zero")
+        + "one " * numbers.count("one")
+        + "two " * numbers.count("two")
+        + "three " * numbers.count("three")
+        + "four " * numbers.count("four")
+        + "five " * numbers.count("five")
+        + "six " * numbers.count("six")
