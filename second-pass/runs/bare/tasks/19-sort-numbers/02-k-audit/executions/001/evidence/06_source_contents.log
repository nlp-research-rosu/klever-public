=== /candidate/semantic.k ===
     1	module MPY-SYNTAX
     2	  imports DOMAINS
     3	
     4	  syntax Ids    ::= List{String, ","}
     5	  syntax Exprs  ::= List{Expr, ","}
     6	  syntax Stmts  ::= List{Stmt, ""}
     7	
     8	  syntax Params ::= "Params" "(" Ids ")"
     9	
    10	  syntax Expr ::= "Name"      "(" String ")"
    11	                | "Str"       "(" String ")"
    12	                | "Int"       "(" Int ")"
    13	                | "Attribute" "(" Expr "," String ")"
    14	                | "Call"      "(" Expr "," Exprs ")"
    15	                | "BinOp"     "(" String "," Expr "," Expr ")"
    16	
    17	  syntax Stmt ::= "Return"  "(" Expr ")"
    18	                | "FuncDef" "(" String "," Params "," Stmts ")"
    19	
    20	  syntax Program ::= "Module" "(" Stmts ")"
    21	
    22	  syntax Val ::= VStr(String) | VInt(Int)
    23	  syntax KItem ::= invoke(String)
    24	endmodule
    25	
    26	module MPY
    27	  imports MPY-SYNTAX
    28	
    29	  configuration <k> $PGM:Program ~> invoke($ARG:String) </k>
    30	
    31	  syntax Val ::= evalProgram(Program, String) [function]
    32	  syntax Val ::= eval(Expr, String)            [function]
    33	  syntax Val ::= addVals(Val, Val)             [function]
    34	  syntax Val ::= multiplyVals(Val, Val)        [function]
    35	  syntax Val ::= countVal(Val, String)         [function]
    36	  syntax Val ::= stripVal(Val)                 [function]
    37	
    38	  // This condition's Python subset only needs one top-level, one-argument
    39	  // function whose body is a return.  Expressions below are compositional.
    40	  rule evalProgram(
    41	         Module(FuncDef("sort_numbers", Params("numbers"), Return(E))),
    42	         S
    43	       ) => eval(E, S)
    44	
    45	  rule eval(Name("numbers"), S) => VStr(S)
    46	  rule eval(Str(S), _)           => VStr(S)
    47	  rule eval(Int(I), _)           => VInt(I)
    48	
    49	  rule eval(BinOp("+", E1, E2), S)
    50	    => addVals(eval(E1, S), eval(E2, S))
    51	  rule eval(BinOp("*", E1, E2), S)
    52	    => multiplyVals(eval(E1, S), eval(E2, S))
    53	
    54	  rule eval(Call(Attribute(E, "count"), Str(Needle)), S)
    55	    => countVal(eval(E, S), Needle)
    56	  rule eval(Call(Attribute(E, "strip"), .Exprs), S)
    57	    => stripVal(eval(E, S))
    58	
    59	  rule addVals(VStr(S1), VStr(S2)) => VStr(S1 +String S2)
    60	  rule multiplyVals(VStr(S), VInt(N)) => VStr(repeatString(S, N))
    61	  rule countVal(VStr(S), Needle) => VInt(countAllOccurrences(S, Needle))
    62	  rule stripVal(VStr(S)) => VStr(trimTrailingSpace(S))
    63	
    64	  // Concrete helpers for the two Python string operations not directly
    65	  // hooked by K.  The value passed to strip is produced by concatenating
    66	  // zero or more "word " blocks, so removing its one trailing space is exact.
    67	  syntax String ::= repeatString(String, Int) [function]
    68	  rule repeatString(_, N) => ""
    69	    requires N <=Int 0
    70	    [concrete(N), simplification]
    71	  rule repeatString(S, N) => S +String repeatString(S, N -Int 1)
    72	    requires N >Int 0
    73	    [concrete(N), simplification]
    74	
    75	  syntax String ::= trimTrailingSpace(String) [function]
    76	  rule trimTrailingSpace("") => ""
    77	  rule trimTrailingSpace(S)
    78	    => substrString(S, 0, lengthString(S) -Int 1)
    79	    requires lengthString(S) >Int 0
    80	    [concrete(S), simplification]
    81	
    82	  rule <k> P:Program ~> invoke(S) => evalProgram(P, S) ... </k>
    83	endmodule

=== /candidate/verification.k ===
     1	requires "solution-program.k"
     2	
     3	module VERIFICATION
     4	  imports SOLUTION-PROGRAM
     5	
     6	  // Independent executable statement of the required ordering: the result
     7	  // has one block per numeral, arranged from zero through nine.  On valid
     8	  // inputs no numeral word is a substring of another numeral word, so K's
     9	  // non-overlapping occurrence count equals that token's multiplicity.
    10	  syntax String ::= sortSpec(String) [function]
    11	  rule sortSpec(S) => trimTrailingSpace(
    12	       repeatString("zero ",  countAllOccurrences(S, "zero"))
    13	    +String repeatString("one ",   countAllOccurrences(S, "one"))
    14	    +String repeatString("two ",   countAllOccurrences(S, "two"))
    15	    +String repeatString("three ", countAllOccurrences(S, "three"))
    16	    +String repeatString("four ",  countAllOccurrences(S, "four"))
    17	    +String repeatString("five ",  countAllOccurrences(S, "five"))
    18	    +String repeatString("six ",   countAllOccurrences(S, "six"))
    19	    +String repeatString("seven ", countAllOccurrences(S, "seven"))
    20	    +String repeatString("eight ", countAllOccurrences(S, "eight"))
    21	    +String repeatString("nine ",  countAllOccurrences(S, "nine"))
    22	  )
    23	
    24	  syntax Bool ::= isNumeral(String) [function, total]
    25	  rule isNumeral("zero")  => true
    26	  rule isNumeral("one")   => true
    27	  rule isNumeral("two")   => true
    28	  rule isNumeral("three") => true
    29	  rule isNumeral("four")  => true
    30	  rule isNumeral("five")  => true
    31	  rule isNumeral("six")   => true
    32	  rule isNumeral("seven") => true
    33	  rule isNumeral("eight") => true
    34	  rule isNumeral("nine")  => true
    35	  rule isNumeral(_)        => false [owise]
    36	
    37	  // Recognizes exactly the contract's canonical space-delimited inputs,
    38	  // plus the empty input (which the reference tests conventionally admit).
    39	  syntax Bool ::= validNumerals(String) [function]
    40	  rule validNumerals("") => true
    41	  rule validNumerals(S) => isNumeral(S)
    42	    requires S =/=String ""
    43	     andBool findString(S, " ", 0) ==Int -1
    44	  rule validNumerals(S) =>
    45	       isNumeral(substrString(S, 0, findString(S, " ", 0)))
    46	    andBool validNumerals(substrString(
    47	              S,
    48	              findString(S, " ", 0) +Int 1,
    49	              lengthString(S)))
    50	    requires findString(S, " ", 0) >=Int 0
    51	     andBool findString(S, " ", 0) <Int lengthString(S) -Int 1
    52	  rule validNumerals(S) => false
    53	    requires findString(S, " ", 0) ==Int lengthString(S) -Int 1
    54	endmodule

=== /candidate/spec.k ===
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Main theorem: for every String (and hence every input admitted by the
     7	  // prompt), executing the translated implementation returns the canonical
     8	  // ascending rendering with multiplicities preserved.
     9	  claim <k> solutionProgram ~> invoke(S) => VStr(sortSpec(S)) </k>
    10	
    11	  // Ground instances make the prompt example, multiplicities, all ten words,
    12	  // and the empty boundary case independently visible in proof output.
    13	  claim <k> solutionProgram ~> invoke("three one five")
    14	         => VStr("one three five") </k>
    15	
    16	  claim <k> solutionProgram ~> invoke("two two one zero two")
    17	         => VStr("zero one two two two") </k>
    18	
    19	  claim <k> solutionProgram ~> invoke(
    20	           "nine eight seven six five four three two one zero")
    21	         => VStr(
    22	           "zero one two three four five six seven eight nine") </k>
    23	
    24	  claim <k> solutionProgram ~> invoke("") => VStr("") </k>
    25	endmodule

