     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd -- "$(dirname -- "$0")"
     5	
     6	# Recreate the translator artifact from the submitted Python implementation.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# Check the implementation under CPython as an independent executable sanity
    10	# check before invoking the K model.
    11	python3 - <<'PY'
    12	from solution import sort_numbers
    13	
    14	assert sort_numbers("three one five") == "one three five"
    15	assert sort_numbers("two two one zero two") == "zero one two two two"
    16	assert sort_numbers(
    17	    "nine eight seven six five four three two one zero"
    18	) == "zero one two three four five six seven eight nine"
    19	assert sort_numbers("") == ""
    20	PY
    21	
    22	# Compile the semantics together with its proof-only verification functions.
    23	kompile verification.k \
    24	  --backend haskell \
    25	  --main-module VERIFICATION \
    26	  --syntax-module MPY-SYNTAX
    27	
    28	# Execute the actual translator output, not the compact proof abbreviation.
    29	krun solution.mpy --definition verification-kompiled \
    30	  -cARG='"three one five"'
    31	krun solution.mpy --definition verification-kompiled \
    32	  -cARG='"two two one zero two"'
    33	krun solution.mpy --definition verification-kompiled \
    34	  -cARG='"nine eight seven six five four three two one zero"'
    35	krun solution.mpy --definition verification-kompiled -cARG='""'
    36	
    37	# This single invocation proves every claim in spec.k and must print #Top.
    38	kprove spec.k --definition verification-kompiled
