     1	def sort_numbers(numbers: str) -> str:
     2	    return (
     3	        "zero " * numbers.count("zero")
     4	        + "one " * numbers.count("one")
     5	        + "two " * numbers.count("two")
     6	        + "three " * numbers.count("three")
     7	        + "four " * numbers.count("four")
     8	        + "five " * numbers.count("five")
     9	        + "six " * numbers.count("six")
    10	        + "seven " * numbers.count("seven")
    11	        + "eight " * numbers.count("eight")
    12	        + "nine " * numbers.count("nine")
    13	    ).strip()

