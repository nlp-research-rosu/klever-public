diff --git a//tmp/audit-work/candidate-src/audit-actual-program.k b//tmp/audit-work/candidate-src/audit-actual-program.k
new file mode 100644
index 0000000000000000000000000000000000000000..b8508662fab55a931738a164e3f9e03f355e0468
--- /dev/null
+++ b//tmp/audit-work/candidate-src/audit-actual-program.k
@@ -0,0 +1,91 @@
+requires "semantic.k"
+
+module AUDIT-ACTUAL-PROGRAM
+  imports MPY
+
+  syntax Program ::= "auditActualSolutionProgram" [function]
+  rule auditActualSolutionProgram =>
+    // AUDIT_AST_BEGIN
+    Module(
+      FuncDef("sort_numbers", Params("numbers"),
+        Return(
+          Call(
+            Attribute(
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          BinOp(
+                            "+",
+                            BinOp(
+                              "+",
+                              BinOp(
+                                "+",
+                                BinOp(
+                                  "*",
+                                  Str("zero "),
+                                  Call(
+                                    Attribute(Name("numbers"), "count"),
+                                    Str("zero"))),
+                                BinOp(
+                                  "*",
+                                  Str("one "),
+                                  Call(
+                                    Attribute(Name("numbers"), "count"),
+                                    Str("one")))),
+                              BinOp(
+                                "*",
+                                Str("two "),
+                                Call(
+                                  Attribute(Name("numbers"), "count"),
+                                  Str("two")))),
+                            BinOp(
+                              "*",
+                              Str("three "),
+                              Call(
+                                Attribute(Name("numbers"), "count"),
+                                Str("three")))),
+                          BinOp(
+                            "*",
+                            Str("four "),
+                            Call(
+                              Attribute(Name("numbers"), "count"),
+                              Str("four")))),
+                        BinOp(
+                          "*",
+                          Str("five "),
+                          Call(
+                            Attribute(Name("numbers"), "count"),
+                            Str("five")))),
+                      BinOp(
+                        "*",
+                        Str("six "),
+                        Call(
+                          Attribute(Name("numbers"), "count"),
+                          Str("six")))),
+                    BinOp(
+                      "*",
+                      Str("seven "),
+                      Call(
+                        Attribute(Name("numbers"), "count"),
+                        Str("seven")))),
+                  BinOp(
+                    "*",
+                    Str("eight "),
+                    Call(Attribute(Name("numbers"), "count"), Str("eight")))),
+                BinOp(
+                  "*",
+                  Str("nine "),
+                  Call(Attribute(Name("numbers"), "count"), Str("nine")))),
+              "strip"),
+            .Exprs))))
+    // AUDIT_AST_END
+endmodule
