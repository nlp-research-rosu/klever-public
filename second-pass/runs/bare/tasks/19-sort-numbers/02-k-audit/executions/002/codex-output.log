    --add-dir "$WORK_DIR" \
    --ignore-user-config \
    --skip-git-repo-check \
    -C "$OUTPUT_DIR" \
    -m "$MODEL" \
    -c model_reasoning_effort="$EFFORT" \
    --output-last-message "$LAST_BUFFER" \
    - < "$PROMPT_BUFFER" \
