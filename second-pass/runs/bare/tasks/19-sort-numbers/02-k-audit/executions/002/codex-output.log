{
  "agent": "codex",
  "model": "$MODEL",
  "effort": "$EFFORT",
  "timeout_s": $TIMEOUT_S,
  "start_epoch": $START_EPOCH,
  "end_epoch": $END_EPOCH,
  "duration_s": $((END_EPOCH - START_EPOCH)),
  "exit_code": $FINAL_EXIT_CODE,
  "model_exit_code": $MODEL_EXIT_CODE,
  "harness_exit_code": $HARNESS_EXIT_CODE,
  "timed_out": $TIMED_OUT,
  "mem_peak_bytes": $MEM_PEAK
}
EOF
then
