  || mark_harness_error "rendered audit prompt publication failed"
publish_regular_file \
  "$LOG_BUFFER" "$OUTPUT_DIR/codex-output.log" "Codex output log" \
  || mark_harness_error "Codex output log publication failed"
publish_regular_file \
