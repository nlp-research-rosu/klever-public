+requires "verification.k"
+
+module BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // Material body mutation: the zero block prints "WRONG " while still
+  // counting occurrences of "zero". The program term below is executed.
+  claim [mutated-body]:
+    <k>
+      Module(
+        FuncDef(
+          "sort_numbers",
+          Params("numbers"),
+          Return(
+            Call(
+              Attribute(
+                BinOp("+",
+                  BinOp("+",
+                    BinOp("+",
+                      BinOp("+",
+                        BinOp("+",
+                          BinOp("+",
+                            BinOp("+",
+                              BinOp("+",
+                                BinOp("+",
+                                  block("zero", "WRONG "),
+                                  block("one", "one ")),
+                                block("two", "two ")),
+                              block("three", "three ")),
+                            block("four", "four ")),
+                          block("five", "five ")),
+                        block("six", "six ")),
+                      block("seven", "seven ")),
+                    block("eight", "eight ")),
+                  block("nine", "nine ")),
+                "strip"),
+              .Exprs))))
+      ~> invoke("zero")
+      => VStr("zero")
+    </k>
+endmodule
diff --git a//tmp/audit-work/19-sort-numbers/pinning-spec.k b//tmp/audit-work/19-sort-numbers/pinning-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2ca4a1a81270c98bbc73ec5ee393f2176bd550ba
--- /dev/null
+++ b//tmp/audit-work/19-sort-numbers/pinning-spec.k
@@ -0,0 +1,90 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // RHS is the byte-regenerated solution.mpy constructor tree.
+  claim <k> solutionProgram ~> invoke(S) =>
+    Module(
+      FuncDef("sort_numbers", Params("numbers"),
+        Return(
+          Call(
+            Attribute(
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          BinOp(
+                            "+",
+                            BinOp(
+                              "+",
+                              BinOp(
+                                "+",
+                                BinOp(
+                                  "*",
+                                  Str("zero "),
+                                  Call(
+                                    Attribute(Name("numbers"), "count"),
+                                    Str("zero"))),
+                                BinOp(
+                                  "*",
+                                  Str("one "),
+                                  Call(
+                                    Attribute(Name("numbers"), "count"),
+                                    Str("one")))),
+                              BinOp(
+                                "*",
+                                Str("two "),
+                                Call(
+                                  Attribute(Name("numbers"), "count"),
+                                  Str("two")))),
+                            BinOp(
+                              "*",
+                              Str("three "),
+                              Call(
+                                Attribute(Name("numbers"), "count"),
+                                Str("three")))),
+                          BinOp(
+                            "*",
+                            Str("four "),
+                            Call(
+                              Attribute(Name("numbers"), "count"),
+                              Str("four")))),
+                        BinOp(
+                          "*",
+                          Str("five "),
+                          Call(
+                            Attribute(Name("numbers"), "count"),
+                            Str("five")))),
+                      BinOp(
+                        "*",
+                        Str("six "),
+                        Call(
+                          Attribute(Name("numbers"), "count"),
+                          Str("six")))),
+                    BinOp(
+                      "*",
+                      Str("seven "),
+                      Call(
+                        Attribute(Name("numbers"), "count"),
+                        Str("seven")))),
+                  BinOp(
+                    "*",
+                    Str("eight "),
+                    Call(
+                      Attribute(Name("numbers"), "count"), Str("eight")))),
+                BinOp(
+                  "*",
+                  Str("nine "),
+                  Call(Attribute(Name("numbers"), "count"), Str("nine")))),
+              "strip"),
+            .Exprs)))) ~> invoke(S) </k>
+endmodule
