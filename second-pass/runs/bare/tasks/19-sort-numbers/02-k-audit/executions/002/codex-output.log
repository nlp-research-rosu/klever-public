index 0000000000000000000000000000000000000000..2c38ef5b081a4d6a71dc52a10d3083356b0def91
--- /dev/null
+++ b/solution-program.k
@@ -0,0 +1,49 @@
+requires "semantic.k"
+
+module SOLUTION-PROGRAM
+  imports MPY
+
+  // A compact K spelling of the exact constructor tree in solution.mpy.
+  // block(Word, Printed) is the AST for:
+  //     "Printed" * numbers.count("Word")
+  syntax Expr ::= block(String, String) [function]
+  rule block(Word, Printed) =>
+    BinOp(
+      "*",
+      Str(Printed),
+      Call(Attribute(Name("numbers"), "count"), Str(Word)))
+
+  syntax Expr ::= "solutionBody" [function]
+  rule solutionBody =>
+    Call(
+      Attribute(
+        BinOp("+",
+          BinOp("+",
+            BinOp("+",
+              BinOp("+",
+                BinOp("+",
+                  BinOp("+",
+                    BinOp("+",
+                      BinOp("+",
+                        BinOp("+",
+                          block("zero", "zero "),
+                          block("one", "one ")),
+                        block("two", "two ")),
+                      block("three", "three ")),
+                    block("four", "four ")),
+                  block("five", "five ")),
+                block("six", "six ")),
+              block("seven", "seven ")),
+            block("eight", "eight ")),
+          block("nine", "nine ")),
+        "strip"),
+      .Exprs)
+
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef(
+        "sort_numbers",
+        Params("numbers"),
+        Return(solutionBody)))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b7dc7d738e665c316080c132b19fdc90a7b0bfa
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def sort_numbers(numbers: str) -> str:
+    return (
+        "zero " * numbers.count("zero")
+        + "one " * numbers.count("one")
+        + "two " * numbers.count("two")
+        + "three " * numbers.count("three")
+        + "four " * numbers.count("four")
+        + "five " * numbers.count("five")
+        + "six " * numbers.count("six")
+        + "seven " * numbers.count("seven")
+        + "eight " * numbers.count("eight")
+        + "nine " * numbers.count("nine")
+    ).strip()
diff --git a/spec.k b/spec.k
