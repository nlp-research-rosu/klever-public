@@ -0,0 +1,90 @@
+requires "verification.k"
+
+module PINNING-SPEC
+  imports VERIFICATION
+
+  // RHS is the byte-regenerated solution.mpy constructor tree.
+  claim <k> solutionProgram ~> invoke(S) =>
+    Module(
+      FuncDef("sort_numbers", Params("numbers"),
+        Return(
+          Call(
+            Attribute(
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          BinOp(
+                            "+",
+                            BinOp(
+                              "+",
+                              BinOp(
+                                "+",
+                                BinOp(
+                                  "*",
+                                  Str("zero "),
+                                  Call(
