+  // counting occurrences of "zero". The program term below is executed.
+  claim [mutated-body]:
+    <k>
+      Module(
+        FuncDef(
+          "sort_numbers",
+          Params("numbers"),
+          Return(
+            Call(
+              Attribute(
+                BinOp("+",
