+                            block("four", "four ")),
+                          block("five", "five ")),
+                        block("six", "six ")),
+                      block("seven", "seven ")),
+                    block("eight", "eight ")),
+                  block("nine", "nine ")),
+                "strip"),
+              .Exprs))))
+      ~> invoke("zero")
+      => VStr("zero")
+    </k>
+endmodule
