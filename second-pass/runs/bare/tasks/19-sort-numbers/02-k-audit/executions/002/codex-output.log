+        FuncDef(
+          "sort_numbers",
+          Params("numbers"),
+          Return(
+            Call(
+              Attribute(
+                BinOp("+",
+                  BinOp("+",
+                    BinOp("+",
+                      BinOp("+",
+                        BinOp("+",
+                          BinOp("+",
+                            BinOp("+",
+                              BinOp("+",
+                                BinOp("+",
