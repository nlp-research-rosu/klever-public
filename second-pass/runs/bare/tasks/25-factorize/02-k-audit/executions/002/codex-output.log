    31	  imports INT
    32	  imports BOOL
    33	  imports STRING
    34	  imports MAP
    35	  imports LIST
    36	
    37	  syntax Val ::= IntVal(Int)
    38	               | BoolVal(Bool)
    39	               | ListVal(List)
    40	
    41	  syntax Closure ::= Closure(Params, Stmts)
    42	
    43	  syntax Frame ::= Frame(K, Map)
    44	
    45	  syntax Result ::= "noResult"
    46	                  | Val
    47	
    48	  configuration
    49	    <k> $PGM:Module </k>
    50	    <input> $INPUT:Int </input>
    51	    <result> noResult </result>
    52	
    53	  syntax MachineState ::= Machine(K, Map, Map, List, Result) [function]
    54	                        | Halted(Map, Map, List, Val)
    55	  syntax ProofState ::= Run(MachineState)
    56	
    57	  rule <k> Module(SS)
