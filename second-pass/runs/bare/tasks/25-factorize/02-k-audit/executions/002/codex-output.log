     8	def factorize(n: int) -> List[int]:
     9	    """ Return list of prime factors of given integer in the order from smallest to largest.
    10	    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.
    11	    Input number should be equal to the product of all factors
    12	    >>> factorize(8)
    13	    [2, 2, 2]
    14	    >>> factorize(25)
    15	    [5, 5]
    16	    >>> factorize(70)
    17	    [2, 5, 7]
    18	    """
    19	    import math
    20	    fact = []
    21	    i = 2
    22	    while i <= int(math.sqrt(n) + 1):
    23	        if n % i == 0:
    24	            fact.append(i)
    25	            n //= i
    26	        else:
    27	            i += 1
    28	
    29	    if n > 1:
    30	        fact.append(n)
    31	    return fact
