     3	
     4	def factorize_from(n: int, divisor: int) -> List[int]:
     5	    if n < 2:
     6	        return []
     7	    if divisor * divisor > n:
     8	        return [n]
     9	    if n % divisor == 0:
    10	        return [divisor] + factorize_from(n // divisor, divisor)
    11	    return factorize_from(n, divisor + 1)
    12	
    13	
    14	def factorize(n: int) -> List[int]:
    15	    return factorize_from(n, 2)
