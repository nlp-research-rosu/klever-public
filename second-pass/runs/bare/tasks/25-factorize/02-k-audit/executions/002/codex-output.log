   124	  rule Machine(V:Val ~> MakeList ~> KREST, ENV, FS, STACK, R)
   125	    => Machine(ListVal(ListItem(V)) ~> KREST, ENV, FS, STACK, R)
   126	
   127	  rule Machine(Eval(BinOp(OP, LEFT, RIGHT)) ~> KREST,
   128	               ENV, FS, STACK, R)
   129	    => Machine(Eval(LEFT) ~> BinLeft(OP, RIGHT) ~> KREST,
   130	               ENV, FS, STACK, R)
   131	  rule Machine(V:Val ~> BinLeft(OP, RIGHT) ~> KREST,
   132	               ENV, FS, STACK, R)
   133	    => Machine(Eval(RIGHT) ~> BinRight(OP, V) ~> KREST,
   134	               ENV, FS, STACK, R)
   135	  rule Machine(V2:Val ~> BinRight(OP, V1) ~> KREST,
   136	               ENV, FS, STACK, R)
   137	    => Machine(evalBinOp(OP, V1, V2) ~> KREST, ENV, FS, STACK, R)
   138	
   139	  rule Machine(Eval(Compare(LEFT, CmpOp(OP, RIGHT))) ~> KREST,
   140	               ENV, FS, STACK, R)
   141	    => Machine(Eval(LEFT) ~> CompareLeft(OP, RIGHT) ~> KREST,
   142	               ENV, FS, STACK, R)
   143	  rule Machine(V:Val ~> CompareLeft(OP, RIGHT) ~> KREST,
   144	               ENV, FS, STACK, R)
   145	    => Machine(Eval(RIGHT) ~> CompareRight(OP, V) ~> KREST,
   146	               ENV, FS, STACK, R)
   147	  rule Machine(V2:Val ~> CompareRight(OP, V1) ~> KREST,
   148	               ENV, FS, STACK, R)
   149	    => Machine(evalCompare(OP, V1, V2) ~> KREST, ENV, FS, STACK, R)
   150	
   151	  rule Machine(Eval(Call(Name(F), E)) ~> KREST, ENV, FS, STACK, R)
   152	    => Machine(Eval(E) ~> CallOne(F) ~> KREST, ENV, FS, STACK, R)
   153	  rule Machine(V:Val ~> CallOne(F) ~> KREST, ENV, FS, STACK, R)
   154	    => Machine(Invoke(F, ListItem(V)) ~> KREST, ENV, FS, STACK, R)
   155	  rule Machine(Eval(Call(Name(F), E1, E2)) ~> KREST,
   156	               ENV, FS, STACK, R)
   157	    => Machine(Eval(E1) ~> CallTwoLeft(F, E2) ~> KREST,
   158	               ENV, FS, STACK, R)
   159	  rule Machine(V:Val ~> CallTwoLeft(F, E2) ~> KREST,
   160	               ENV, FS, STACK, R)
   161	    => Machine(Eval(E2) ~> CallTwoRight(F, V) ~> KREST,
   162	               ENV, FS, STACK, R)
   163	  rule Machine(V2:Val ~> CallTwoRight(F, V1) ~> KREST,
   164	               ENV, FS, STACK, R)
   165	    => Machine(Invoke(F, ListItem(V1) ListItem(V2)) ~> KREST,
   166	               ENV, FS, STACK, R)
   167	
   168	  syntax Map ::= collect(Stmts) [function]
   169	  rule collect(.Stmts) => .Map
   170	  rule collect(ImportFrom(_, _) REST) => collect(REST)
   171	  rule collect(FuncDef(F, PS, BODY) REST)
   172	    => collect(REST)[F <- Closure(PS, BODY)]
   173	
   174	  syntax Map ::= bind(Params, List) [function]
   175	  rule bind(Params(PS), VS) => bindLists(PS, VS)
   176	
   177	  syntax Map ::= bindLists(Strings, List) [function]
   178	  rule bindLists(.Strings, .List) => .Map
   179	  rule bindLists(P, PS, ListItem(V) VS)
   180	    => (P |-> V) bindLists(PS, VS)
   181	
   182	  syntax Val ::= evalBinOp(String, Val, Val) [function]
   183	  rule evalBinOp("+", IntVal(A), IntVal(B)) => IntVal(A +Int B)
   184	  rule evalBinOp("*", IntVal(A), IntVal(B)) => IntVal(A *Int B)
   185	  rule evalBinOp("+", ListVal(A), ListVal(B)) => ListVal(A B)
   186	  rule evalBinOp("%", IntVal(A), IntVal(B)) => IntVal(A %Int B)
   187	    requires B =/=Int 0
   188	  rule evalBinOp("//", IntVal(A), IntVal(B)) => IntVal(A /Int B)
   189	    requires B =/=Int 0
   190	
   191	  syntax Val ::= evalCompare(String, Val, Val) [function]
   192	  rule evalCompare("<", IntVal(A), IntVal(B)) => BoolVal(A <Int B)
   193	  rule evalCompare(">", IntVal(A), IntVal(B)) => BoolVal(A >Int B)
   194	  rule evalCompare("==", IntVal(A), IntVal(B)) => BoolVal(A ==Int B)
   195	endmodule
