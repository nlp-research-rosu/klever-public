import itertools, os, stat
cases=[(Path('/candidate'),'300f0e7adac697306d537be2d6d5cf6329bd48f7604c5b2e1d5dd432be4e5d25'),(Path('/generation-evidence/codex-trace'),'f7eeee4c038890bd7d8b6951419ba09c468f96eb9a139a84d20ebbcf07e0547e')]
seps=[b'',b'\\0',b'\\n',b' ',b'  ',b':']
for include_dirs in (False,True):
 for pathstyle in range(4):
  for contentstyle in range(5):
   for metadata in range(6):
