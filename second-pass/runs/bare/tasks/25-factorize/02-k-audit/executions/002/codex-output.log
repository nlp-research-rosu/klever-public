+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT STATUS: %d\n' "$status"
+  return "$status"
+}
+
