+    spec.loader.exec_module(module)
+    return module
+
+
+EXPECTED = {
+    1: [],
+    2: [2],
+    3: [3],
+    4: [2, 2],
+    8: [2, 2, 2],
+    9: [3, 3],
+    13: [13],
+    25: [5, 5],
