+  --backend haskell \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --output-definition fresh-semantic-kompiled
+semantic_status=$?
+
+run kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
