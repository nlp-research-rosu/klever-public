+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+
+KEYWORDS = (
+    "kompile",
+    "kprove",
+    "krun",
+    "#Top",
+    "WarnStuckClaimState",
+    "solution.mpy",
+    "semantic.k",
+    "verification.k",
+    "spec.k",
