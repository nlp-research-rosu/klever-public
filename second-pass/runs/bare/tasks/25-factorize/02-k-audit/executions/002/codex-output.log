     3	module SOLUTION-PROGRAM
     4	  imports SEMANTIC
     5	
     6	  // This is the parsed term emitted in solution.mpy.  Keeping it as a K term
     7	  // makes the proof about the translator's output, not about Python source text.
     8	  syntax Module ::= SolutionModule() [function]
     9	  rule SolutionModule() =>
    10	    Module(
    11	      ImportFrom("typing", "List")
    12	      FuncDef("factorize_from", Params("n", "divisor"),
    13	        If(Compare(Name("n"), CmpOp("<", Int(2))),
    14	          Return(ListExpr(.Exprs)),
    15	          .Stmts)
    16	        If(Compare(BinOp("*", Name("divisor"), Name("divisor")),
    17	                   CmpOp(">", Name("n"))),
    18	          Return(ListExpr(Name("n"))),
    19	          .Stmts)
    20	        If(Compare(BinOp("%", Name("n"), Name("divisor")),
    21	                   CmpOp("==", Int(0))),
    22	          Return(BinOp("+",
    23	            ListExpr(Name("divisor")),
    24	            Call(Name("factorize_from"),
    25	              BinOp("//", Name("n"), Name("divisor")),
    26	              Name("divisor")))),
    27	          .Stmts)
    28	        Return(Call(Name("factorize_from"),
    29	          Name("n"), BinOp("+", Name("divisor"), Int(1)))))
    30	      FuncDef("factorize", Params("n"),
    31	        Return(Call(Name("factorize_from"), Name("n"), Int(2)))))
    32	
    33	  syntax Map ::= SolutionFunctions() [function]
    34	  rule SolutionFunctions() => collectStmts(SolutionModule())
    35	
    36	  syntax MachineState ::= SolutionMachine(Int) [function]
    37	  rule SolutionMachine(N) =>
    38	    Machine(Invoke("factorize", ListItem(IntVal(N))) ~> Finish,
    39	            .Map, SolutionFunctions(), .List, noResult)
    40	
    41	  syntax Map ::= collectStmts(Module) [function]
    42	  rule collectStmts(Module(SS)) => collect(SS)
    43	endmodule
    44	
    45	module VERIFICATION
    46	  imports SOLUTION-PROGRAM
    47	
    48	  // Mathematical trial-division specification.  D is the next candidate.
    49	  // The first rule covers the conventional factorization of 1 as the empty
    50	  // list.  The other rules either emit a divisor or advance the candidate.
    51	  syntax Val ::= FactorFrom(Int, Int) [function]
    52	  rule FactorFrom(N, _) => ListVal(.List)
    53	    requires N <Int 2
    54	  rule FactorFrom(N, D) => ListVal(ListItem(IntVal(N)))
    55	    requires N >=Int 2 andBool D >=Int 2 andBool D *Int D >Int N
    56	  rule FactorFrom(N, D)
    57	    => PrependFactor(D, FactorFrom(N /Int D, D))
    58	    requires N >=Int 2 andBool D >=Int 2
    59	             andBool D *Int D <=Int N andBool N %Int D ==Int 0
    60	  rule FactorFrom(N, D)
    61	    => FactorFrom(N, D +Int 1)
    62	    requires N >=Int 2 andBool D >=Int 2
    63	             andBool D *Int D <=Int N andBool N %Int D =/=Int 0
    64	
    65	  syntax Val ::= FactorizeSpec(Int) [function]
    66	  rule FactorizeSpec(N) => FactorFrom(N, 2)
    67	
    68	  syntax Val ::= PrependFactor(Int, Val) [function]
    69	  rule PrependFactor(D, ListVal(L))
    70	    => ListVal(ListItem(IntVal(D)) L)
    71	
    72	  // Observable contract helpers used by claims in spec.k.
    73	  syntax Int ::= Product(Val) [function]
    74	  rule Product(ListVal(.List)) => 1
    75	  rule Product(ListVal(ListItem(IntVal(X)) REST))
    76	    => X *Int Product(ListVal(REST))
    77	
    78	  // OrderedFrom(V, L) says that V's integer elements are nondecreasing and
    79	  // that its first element, if present, is at least L.
    80	  syntax Bool ::= OrderedFrom(Val, Int) [function]
    81	  rule OrderedFrom(ListVal(.List), _) => true
    82	  rule OrderedFrom(ListVal(ListItem(IntVal(X)) REST), L)
    83	    => (L <=Int X) andBool OrderedFrom(ListVal(REST), X)
    84	
    85	  syntax Val ::= MachineValue(MachineState) [function]
    86	  rule MachineValue(Halted(_, _, _, V)) => V
    87	
    88	  syntax Bool ::= HasDivisor(Int, Int) [function]
    89	  rule HasDivisor(N, D) => false
    90	    requires D *Int D >Int N
    91	  rule HasDivisor(N, D) => true
    92	    requires D *Int D <=Int N andBool N %Int D ==Int 0
    93	  rule HasDivisor(N, D) => HasDivisor(N, D +Int 1)
    94	    requires D *Int D <=Int N andBool N %Int D =/=Int 0
    95	
    96	  syntax Bool ::= IsPrime(Int) [function]
    97	  rule IsPrime(N) => (N >=Int 2) andBool notBool HasDivisor(N, 2)
    98	
    99	  syntax Bool ::= AllPrime(Val) [function]
   100	  rule AllPrime(ListVal(.List)) => true
   101	  rule AllPrime(ListVal(ListItem(IntVal(X)) REST))
   102	    => IsPrime(X) andBool AllPrime(ListVal(REST))
   103	
   104	  syntax Bool ::= ValidFactorization(Int, Val) [function]
   105	  rule ValidFactorization(N, V)
   106	    => (Product(V) ==Int N)
   107	       andBool OrderedFrom(V, 2)
   108	       andBool AllPrime(V)
   109	
   110	  syntax Observation ::= Observe(Bool)
   111	endmodule
