+
+import json
+from pathlib import Path
+
+
+KEYWORDS = (
+    "kompile",
+    "kprove",
+    "krun",
+    "#Top",
+    "WarnStuckClaimState",
+    "solution.mpy",
+    "semantic.k",
+    "verification.k",
+    "spec.k",
+    "mutation",
+)
+MAX_MATCHES = 160
+MAX_CHARS = 1200
+
+
+def clip(value: str) -> str:
+    flattened = value.replace("\n", "\\n")
+    if len(flattened) > MAX_CHARS:
