+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT STATUS: %d\n' "$status"
+  if (( status != 0 )); then
+    overall_status=1
+  fi
+  return 0
+}
+
+run python3 /audit-output/evidence/stage1_integrity.py
+run findmnt -T /candidate -n -o TARGET,OPTIONS
+run findmnt -T /generation-evidence -n -o TARGET,OPTIONS
