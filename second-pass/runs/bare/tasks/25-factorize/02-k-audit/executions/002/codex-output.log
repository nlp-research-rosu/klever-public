    62	  rule <k> Halted(_, _, _, V:Val) => .K </k>
    63	       <result> noResult => V </result>
    64	
    65	  // An explicit call machine is used for execution.  Capturing the caller's
    66	  // continuation and environment in Frame gives Python calls local scope and
    67	  // gives reachability proofs a sound induction point at recursive calls.
    68	  syntax KItem ::= Invoke(String, List)
    69	                 | Exec(Stmts)
    70	                 | Eval(Expr)
    71	                 | BinLeft(String, Expr)
    72	                 | BinRight(String, Val)
    73	                 | CompareLeft(String, Expr)
    74	                 | CompareRight(String, Val)
    75	                 | "MakeList"
    76	                 | CallOne(String)
    77	                 | CallTwoLeft(String, Expr)
    78	                 | CallTwoRight(String, Val)
    79	                 | Choose(Stmts, Stmts)
    80	                 | "DoReturn"
    81	                 | "Finish"
    82	
    83	  rule Machine(Invoke(F, VS) ~> KREST,
    84	               OLD, (F |-> Closure(PS, BODY)) FS, STACK, R)
    85	    => Machine(Exec(BODY), bind(PS, VS),
    86	               (F |-> Closure(PS, BODY)) FS,
    87	               ListItem(Frame(KREST, OLD)) STACK, R)
    88	
    89	  rule Machine(Exec(.Stmts) ~> KREST, ENV, FS, STACK, R)
    90	    => Machine(KREST, ENV, FS, STACK, R)
    91	  rule Machine(Exec(Return(E) _REST) ~> KREST, ENV, FS, STACK, R)
    92	    => Machine(Eval(E) ~> DoReturn ~> KREST, ENV, FS, STACK, R)
    93	  rule Machine(Exec(If(COND, THEN, ELSE) REST) ~> KREST,
    94	               ENV, FS, STACK, R)
    95	    => Machine(Eval(COND) ~> Choose(THEN, ELSE) ~> Exec(REST) ~> KREST,
    96	               ENV, FS, STACK, R)
    97	
    98	  rule Machine(BoolVal(B) ~> Choose(THEN, _) ~> KREST,
    99	               ENV, FS, STACK, R)
   100	    => Machine(Exec(THEN) ~> KREST, ENV, FS, STACK, R)
   101	    requires B
   102	  rule Machine(BoolVal(B) ~> Choose(_, ELSE) ~> KREST,
   103	               ENV, FS, STACK, R)
   104	    => Machine(Exec(ELSE) ~> KREST, ENV, FS, STACK, R)
   105	    requires notBool B
   106	
   107	  rule Machine(V:Val ~> DoReturn ~> _CURRENT,
   108	               _, FS, ListItem(Frame(KREST, OLD)) STACK, R)
   109	    => Machine(V ~> KREST, OLD, FS, STACK, R)
   110	
   111	  rule Machine(V:Val ~> Finish, ENV, FS, STACK, noResult)
   112	    => Halted(ENV, FS, STACK, V)
   113	
   114	  rule Machine(Eval(Int(I)) ~> KREST, ENV, FS, STACK, R)
   115	    => Machine(IntVal(I) ~> KREST, ENV, FS, STACK, R)
   116	  rule Machine(Eval(Name(X)) ~> KREST,
   117	               (X |-> V) ENV, FS, STACK, R)
   118	    => Machine(V ~> KREST, (X |-> V) ENV, FS, STACK, R)
   119	
   120	  rule Machine(Eval(ListExpr(.Exprs)) ~> KREST, ENV, FS, STACK, R)
   121	    => Machine(ListVal(.List) ~> KREST, ENV, FS, STACK, R)
   122	  rule Machine(Eval(ListExpr(E)) ~> KREST, ENV, FS, STACK, R)
