     2	  ImportFrom("typing", "List")
     3	  FuncDef("factorize_from", Params("n", "divisor"),
     4	    If(Compare(Name("n"), CmpOp("<", Int(2))),
     5	      Return(ListExpr()),
     6	      )
     7	    If(Compare(
     8	      BinOp("*", Name("divisor"), Name("divisor")),
     9	      CmpOp(">", Name("n"))),
    10	      Return(ListExpr(Name("n"))),
    11	      )
    12	    If(Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("==", Int(0))),
    13	      Return(
    14	        BinOp(
    15	          "+",
    16	          ListExpr(Name("divisor")),
    17	          Call(
    18	            Name("factorize_from"),
    19	            BinOp("//", Name("n"), Name("divisor")),
    20	            Name("divisor")))),
    21	      )
    22	    Return(
    23	      Call(
    24	        Name("factorize_from"),
    25	        Name("n"),
    26	        BinOp("+", Name("divisor"), Int(1)))))
    27	  FuncDef("factorize", Params("n"),
    28	    Return(Call(Name("factorize_from"), Name("n"), Int(2)))))
