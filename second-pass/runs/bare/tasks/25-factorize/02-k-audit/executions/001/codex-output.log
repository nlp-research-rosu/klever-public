+printf '[exit_status=%d]\n' "$?"
+
+echo '$ python3 -c "parse every JSONL record" TRACE >/dev/null'
+python3 -c 'import json, pathlib, sys; [json.loads(line) for line in pathlib.Path(sys.argv[1]).open()]' \
