+
+cd "$mutation_dir" || exit 1
+
+echo "$ python3 $trusted_translator $mutation_dir/solution.py > $regenerated_mpy"
+python3 "$trusted_translator" "$mutation_dir/solution.py" > "$regenerated_mpy"
+status=$?
