+empty_and_public_boundaries = [0, 1, 2, 3, 4, 5]
+branch_representatives = [7, 8, 9, 15, 16, 24, 25, 26, 48, 49, 50]
+other_fixed = [97, 100, 121, 360, 997, 999, 1024, 65537]
