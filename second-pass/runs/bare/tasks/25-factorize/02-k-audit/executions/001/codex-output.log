+if (( status != 0 )); then
+  exit "$status"
+fi
+
+echo "$ kprove $source_spec --definition $definition --spec-module AUDIT-FACTORFROM-WITNESS"
+kprove "$source_spec" \
+  --definition "$definition" \
+  --spec-module AUDIT-FACTORFROM-WITNESS
+status=$?
+printf '[exit_status=%d]\n' "$status"
+exit "$status"
