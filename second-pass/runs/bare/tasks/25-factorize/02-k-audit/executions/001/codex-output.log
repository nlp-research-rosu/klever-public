+++ b/evidence/05_run_factorfrom_witness.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+source_spec=/tmp/audit-work/25-factorize-audit/source/audit-factorfrom-witness.k
+preserved_spec=/audit-output/evidence/05_factorfrom_witness.k
