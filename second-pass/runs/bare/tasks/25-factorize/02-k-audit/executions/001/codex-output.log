+python3 "$trusted_translator" "$python_source" > "$regenerated_mpy"
+status=$?
+printf '[exit_status=%d]\n' "$status"
+if (( status != 0 )); then
+  exit "$status"
+fi
+
+echo "$ cmp $submitted_mpy $regenerated_mpy"
+cmp "$submitted_mpy" "$regenerated_mpy"
+status=$?
+printf '[exit_status=%d]\n' "$status"
+
+sha256sum "$submitted_mpy" "$regenerated_mpy"
+exit "$status"
