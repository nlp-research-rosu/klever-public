+run date -u '+%Y-%m-%dT%H:%M:%SZ'
+run kompile --version
+run kprove --version
+run find -P /candidate -maxdepth 8 -printf '%y %s %p\n'
+run find -P /reference -maxdepth 4 -printf '%y %s %p\n'
+run sha256sum \
+  /reference/prompt.py /candidate/prompt.py \
+  /reference/py2mpy.py /candidate/py2mpy.py \
