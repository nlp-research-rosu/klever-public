+echo "$ python3 $trusted_translator $python_source > $regenerated_mpy"
+python3 "$trusted_translator" "$python_source" > "$regenerated_mpy"
+status=$?
+printf '[exit_status=%d]\n' "$status"
+if (( status != 0 )); then
+  exit "$status"
+fi
