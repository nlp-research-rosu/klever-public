diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..875b2c9f30b8e6ae82e328fdb8af2e03eb5677c3
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,241 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports BOOL-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Call" "(" Expr "," Exprs ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= IntVal(Int)
+               | BoolVal(Bool)
+               | ListVal(List)
+
+  syntax Closure ::= Closure(Params, Stmts)
+
+  syntax ExecResult ::= Normal(Map)
+                      | Returned(Val)
+
+  syntax Frame ::= Frame(K, Map)
+
+  syntax Result ::= "noResult"
+                  | Val
+
+  configuration
+    <k> $PGM:Module </k>
+    <input> $INPUT:Int </input>
+    <result> noResult </result>
+
+  syntax MachineState ::= Machine(K, Map, Map, List, Result) [function]
+                        | Halted(Map, Map, List, Val)
+  syntax ProofState ::= Run(MachineState)
+
+  rule <k> Module(SS)
+        => Machine(Invoke("factorize", ListItem(IntVal(N))) ~> Finish,
+                   .Map, collect(SS), .List, noResult) </k>
+       <input> N:Int </input>
+
+  rule <k> Halted(_, _, _, V:Val) => .K </k>
+       <result> noResult => V </result>
+
+  // An explicit call machine is used for execution.  Capturing the caller's
+  // continuation and environment in Frame gives Python calls local scope and
+  // gives reachability proofs a sound induction point at recursive calls.
+  syntax KItem ::= Invoke(String, List)
+                 | Exec(Stmts)
+                 | Eval(Expr)
+                 | BinLeft(String, Expr)
+                 | BinRight(String, Val)
+                 | CompareLeft(String, Expr)
+                 | CompareRight(String, Val)
+                 | "MakeList"
+                 | CallOne(String)
+                 | CallTwoLeft(String, Expr)
+                 | CallTwoRight(String, Val)
+                 | Choose(Stmts, Stmts)
+                 | "DoReturn"
+                 | "Finish"
+
+  rule Machine(Invoke(F, VS) ~> KREST,
+               OLD, (F |-> Closure(PS, BODY)) FS, STACK, R)
+    => Machine(Exec(BODY), bind(PS, VS),
+               (F |-> Closure(PS, BODY)) FS,
+               ListItem(Frame(KREST, OLD)) STACK, R)
+
+  rule Machine(Exec(.Stmts) ~> KREST, ENV, FS, STACK, R)
+    => Machine(KREST, ENV, FS, STACK, R)
+  rule Machine(Exec(Return(E) _REST) ~> KREST, ENV, FS, STACK, R)
+    => Machine(Eval(E) ~> DoReturn ~> KREST, ENV, FS, STACK, R)
+  rule Machine(Exec(If(COND, THEN, ELSE) REST) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Eval(COND) ~> Choose(THEN, ELSE) ~> Exec(REST) ~> KREST,
+               ENV, FS, STACK, R)
+
+  rule Machine(BoolVal(B) ~> Choose(THEN, _) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Exec(THEN) ~> KREST, ENV, FS, STACK, R)
+    requires B
+  rule Machine(BoolVal(B) ~> Choose(_, ELSE) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Exec(ELSE) ~> KREST, ENV, FS, STACK, R)
+    requires notBool B
+
+  rule Machine(V:Val ~> DoReturn ~> _CURRENT,
+               _, FS, ListItem(Frame(KREST, OLD)) STACK, R)
+    => Machine(V ~> KREST, OLD, FS, STACK, R)
+
+  rule Machine(V:Val ~> Finish, ENV, FS, STACK, noResult)
+    => Halted(ENV, FS, STACK, V)
+
+  rule Machine(Eval(Int(I)) ~> KREST, ENV, FS, STACK, R)
+    => Machine(IntVal(I) ~> KREST, ENV, FS, STACK, R)
+  rule Machine(Eval(Name(X)) ~> KREST,
+               (X |-> V) ENV, FS, STACK, R)
+    => Machine(V ~> KREST, (X |-> V) ENV, FS, STACK, R)
+
+  rule Machine(Eval(ListExpr(.Exprs)) ~> KREST, ENV, FS, STACK, R)
+    => Machine(ListVal(.List) ~> KREST, ENV, FS, STACK, R)
+  rule Machine(Eval(ListExpr(E)) ~> KREST, ENV, FS, STACK, R)
+    => Machine(Eval(E) ~> MakeList ~> KREST, ENV, FS, STACK, R)
+  rule Machine(V:Val ~> MakeList ~> KREST, ENV, FS, STACK, R)
+    => Machine(ListVal(ListItem(V)) ~> KREST, ENV, FS, STACK, R)
+
+  rule Machine(Eval(BinOp(OP, LEFT, RIGHT)) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Eval(LEFT) ~> BinLeft(OP, RIGHT) ~> KREST,
+               ENV, FS, STACK, R)
+  rule Machine(V:Val ~> BinLeft(OP, RIGHT) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Eval(RIGHT) ~> BinRight(OP, V) ~> KREST,
+               ENV, FS, STACK, R)
+  rule Machine(V2:Val ~> BinRight(OP, V1) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(evalBinOp(OP, V1, V2) ~> KREST, ENV, FS, STACK, R)
+
+  rule Machine(Eval(Compare(LEFT, CmpOp(OP, RIGHT))) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Eval(LEFT) ~> CompareLeft(OP, RIGHT) ~> KREST,
+               ENV, FS, STACK, R)
+  rule Machine(V:Val ~> CompareLeft(OP, RIGHT) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Eval(RIGHT) ~> CompareRight(OP, V) ~> KREST,
+               ENV, FS, STACK, R)
+  rule Machine(V2:Val ~> CompareRight(OP, V1) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(evalCompare(OP, V1, V2) ~> KREST, ENV, FS, STACK, R)
+
+  rule Machine(Eval(Call(Name(F), E)) ~> KREST, ENV, FS, STACK, R)
+    => Machine(Eval(E) ~> CallOne(F) ~> KREST, ENV, FS, STACK, R)
+  rule Machine(V:Val ~> CallOne(F) ~> KREST, ENV, FS, STACK, R)
+    => Machine(Invoke(F, ListItem(V)) ~> KREST, ENV, FS, STACK, R)
+  rule Machine(Eval(Call(Name(F), E1, E2)) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Eval(E1) ~> CallTwoLeft(F, E2) ~> KREST,
+               ENV, FS, STACK, R)
+  rule Machine(V:Val ~> CallTwoLeft(F, E2) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Eval(E2) ~> CallTwoRight(F, V) ~> KREST,
+               ENV, FS, STACK, R)
+  rule Machine(V2:Val ~> CallTwoRight(F, V1) ~> KREST,
+               ENV, FS, STACK, R)
+    => Machine(Invoke(F, ListItem(V1) ListItem(V2)) ~> KREST,
+               ENV, FS, STACK, R)
+
+  syntax Val ::= evalModule(Module, Int) [function]
+  rule evalModule(Module(SS), N)
+    => callDef("factorize", ListItem(IntVal(N)), collect(SS))
+
+  syntax Map ::= collect(Stmts) [function]
+  rule collect(.Stmts) => .Map
+  rule collect(ImportFrom(_, _) REST) => collect(REST)
+  rule collect(FuncDef(F, PS, BODY) REST)
+    => collect(REST)[F <- Closure(PS, BODY)]
+
+  syntax Val ::= callDef(String, List, Map) [function]
+  rule callDef(F, VS, (F |-> Closure(PS, BODY)) REST)
+    => returnedValue(execBlock(BODY, bind(PS, VS),
+                               (F |-> Closure(PS, BODY)) REST))
+
+  syntax Map ::= bind(Params, List) [function]
+  rule bind(Params(PS), VS) => bindLists(PS, VS)
+
+  syntax Map ::= bindLists(Strings, List) [function]
+  rule bindLists(.Strings, .List) => .Map
+  rule bindLists(P, PS, ListItem(V) VS)
+    => (P |-> V) bindLists(PS, VS)
+
+  syntax ExecResult ::= execBlock(Stmts, Map, Map) [function]
+  rule execBlock(.Stmts, ENV, _) => Normal(ENV)
+  rule execBlock(Return(E) REST, ENV, FS)
+    => Returned(evalExpr(E, ENV, FS))
+  rule execBlock(If(COND, THEN, ELSE) REST, ENV, FS)
+    => resume(execBlock(selectBranch(evalExpr(COND, ENV, FS), THEN, ELSE),
+                        ENV, FS), REST, FS)
+
+  syntax Stmts ::= selectBranch(Val, Stmts, Stmts) [function]
+  rule selectBranch(BoolVal(B), THEN, _) => THEN requires B
+  rule selectBranch(BoolVal(B), _, ELSE) => ELSE requires notBool B
+
+  syntax ExecResult ::= resume(ExecResult, Stmts, Map) [function]
+  rule resume(Normal(ENV), REST, FS) => execBlock(REST, ENV, FS)
+  rule resume(Returned(V), _, _) => Returned(V)
+
+  syntax Val ::= returnedValue(ExecResult) [function]
+  rule returnedValue(Returned(V)) => V
+
+  syntax Val ::= evalExpr(Expr, Map, Map) [function]
+  rule evalExpr(Int(I), _, _) => IntVal(I)
+  rule evalExpr(Name(X), (X |-> V) REST, _) => V
+  rule evalExpr(ListExpr(ES), ENV, FS)
+    => ListVal(evalExprs(ES, ENV, FS))
+  rule evalExpr(BinOp(OP, LEFT, RIGHT), ENV, FS)
+    => evalBinOp(OP, evalExpr(LEFT, ENV, FS), evalExpr(RIGHT, ENV, FS))
+  rule evalExpr(Compare(LEFT, CmpOp(OP, RIGHT)), ENV, FS)
+    => evalCompare(OP, evalExpr(LEFT, ENV, FS), evalExpr(RIGHT, ENV, FS))
+  rule evalExpr(Call(Name(F), ARGS), ENV, FS)
+    => callDef(F, evalExprs(ARGS, ENV, FS), FS)
+
+  syntax List ::= evalExprs(Exprs, Map, Map) [function]
+  rule evalExprs(.Exprs, _, _) => .List
+  rule evalExprs(E, ES, ENV, FS)
+    => ListItem(evalExpr(E, ENV, FS)) evalExprs(ES, ENV, FS)
+
+  syntax Val ::= evalBinOp(String, Val, Val) [function]
+  rule evalBinOp("+", IntVal(A), IntVal(B)) => IntVal(A +Int B)
+  rule evalBinOp("+", ListVal(A), ListVal(B)) => ListVal(A B)
+  rule evalBinOp("%", IntVal(A), IntVal(B)) => IntVal(A %Int B)
+    requires B =/=Int 0
+  rule evalBinOp("//", IntVal(A), IntVal(B)) => IntVal(A /Int B)
+    requires B =/=Int 0
+
+  syntax Val ::= evalCompare(String, Val, Val) [function]
+  rule evalCompare("<", IntVal(A), IntVal(B)) => BoolVal(A <Int B)
+  rule evalCompare("==", IntVal(A), IntVal(B)) => BoolVal(A ==Int B)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..022d9cffcba2342436b7bc58f84fb212a3af5afd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+from typing import List
+
+
+def factorize_from(n: int, divisor: int) -> List[int]:
+    if n < 2:
+        return []
+    if n % divisor == 0:
+        return [divisor] + factorize_from(n // divisor, divisor)
+    return factorize_from(n, divisor + 1)
+
+
+def factorize(n: int) -> List[int]:
+    return factorize_from(n, 2)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c0b657342db5343631fbecb946b8a78693f8bd73
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,93 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exact-output proofs.  These execute the constructor tree reproduced from
+  // solution.mpy through the semantic machine.
+  claim Run(SolutionMachine(1))
+    => Run(Halted(.Map, SolutionFunctions(), .List, ListVal(.List)))
+
+  claim Run(SolutionMachine(2))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(2)))))
+
+  claim Run(SolutionMachine(3))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(3)))))
+
+  claim Run(SolutionMachine(4))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(2)) ListItem(IntVal(2)))))
+
+  claim Run(SolutionMachine(8))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(2)) ListItem(IntVal(2))
+                 ListItem(IntVal(2)))))
+
+  claim Run(SolutionMachine(9))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(3)) ListItem(IntVal(3)))))
+
+  claim Run(SolutionMachine(13))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(13)))))
+
+  claim Run(SolutionMachine(25))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(5)) ListItem(IntVal(5)))))
+
+  claim Run(SolutionMachine(31))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(31)))))
+
+  claim Run(SolutionMachine(70))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(2)) ListItem(IntVal(5))
+                 ListItem(IntVal(7)))))
+
+  claim Run(SolutionMachine(100))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(2)) ListItem(IntVal(2))
+                 ListItem(IntVal(5)) ListItem(IntVal(5)))))
+
+  claim Run(SolutionMachine(360))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(2)) ListItem(IntVal(2))
+                 ListItem(IntVal(2)) ListItem(IntVal(3))
+                 ListItem(IntVal(3)) ListItem(IntVal(5)))))
+
+  claim Run(SolutionMachine(999))
+    => Run(Halted(.Map, SolutionFunctions(), .List,
+         ListVal(ListItem(IntVal(3)) ListItem(IntVal(3))
+                 ListItem(IntVal(3)) ListItem(IntVal(37)))))
+
+  // Contract proofs for the same representative partition.  The verifier
+  // checks product equality, nondecreasing order, and primality of every item.
+  claim Observe(ValidFactorization(1, MachineValue(SolutionMachine(1))))
+    => Observe(true)
+  claim Observe(ValidFactorization(2, MachineValue(SolutionMachine(2))))
+    => Observe(true)
+  claim Observe(ValidFactorization(3, MachineValue(SolutionMachine(3))))
+    => Observe(true)
+  claim Observe(ValidFactorization(4, MachineValue(SolutionMachine(4))))
+    => Observe(true)
+  claim Observe(ValidFactorization(8, MachineValue(SolutionMachine(8))))
+    => Observe(true)
+  claim Observe(ValidFactorization(9, MachineValue(SolutionMachine(9))))
+    => Observe(true)
+  claim Observe(ValidFactorization(13, MachineValue(SolutionMachine(13))))
+    => Observe(true)
+  claim Observe(ValidFactorization(25, MachineValue(SolutionMachine(25))))
+    => Observe(true)
+  claim Observe(ValidFactorization(31, MachineValue(SolutionMachine(31))))
+    => Observe(true)
+  claim Observe(ValidFactorization(70, MachineValue(SolutionMachine(70))))
+    => Observe(true)
+  claim Observe(ValidFactorization(100, MachineValue(SolutionMachine(100))))
+    => Observe(true)
+  claim Observe(ValidFactorization(360, MachineValue(SolutionMachine(360))))
+    => Observe(true)
+  claim Observe(ValidFactorization(999, MachineValue(SolutionMachine(999))))
+    => Observe(true)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..af748ac7ca8618bb6d4394d88d3f55e829849449
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,105 @@
+requires "semantic.k"
+
+module SOLUTION-PROGRAM
+  imports SEMANTIC
+
+  // This is the parsed term emitted in solution.mpy.  Keeping it as a K term
+  // makes the proof about the translator's output, not about Python source text.
+  syntax Module ::= SolutionModule() [function]
+  rule SolutionModule() =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("factorize_from", Params("n", "divisor"),
+        If(Compare(Name("n"), CmpOp("<", Int(2))),
+          Return(ListExpr(.Exprs)),
+          .Stmts)
+        If(Compare(BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+          Return(BinOp("+",
+            ListExpr(Name("divisor")),
+            Call(Name("factorize_from"),
+              BinOp("//", Name("n"), Name("divisor")),
+              Name("divisor")))),
+          .Stmts)
+        Return(Call(Name("factorize_from"),
+          Name("n"), BinOp("+", Name("divisor"), Int(1)))))
+      FuncDef("factorize", Params("n"),
+        Return(Call(Name("factorize_from"), Name("n"), Int(2)))))
+
+  syntax Map ::= SolutionFunctions() [function]
+  rule SolutionFunctions() => collectStmts(SolutionModule())
+
+  syntax MachineState ::= SolutionMachine(Int) [function]
+  rule SolutionMachine(N) =>
+    Machine(Invoke("factorize", ListItem(IntVal(N))) ~> Finish,
+            .Map, SolutionFunctions(), .List, noResult)
+
+  syntax Map ::= collectStmts(Module) [function]
+  rule collectStmts(Module(SS)) => collect(SS)
+endmodule
+
+module VERIFICATION
+  imports SOLUTION-PROGRAM
+  imports K-EQUAL
+  imports MAP-SYMBOLIC
+
+  // Mathematical trial-division specification.  D is the next candidate.
+  // The first rule covers the conventional factorization of 1 as the empty
+  // list.  The other rules either emit a divisor or advance the candidate.
+  syntax Val ::= FactorFrom(Int, Int) [function]
+  rule FactorFrom(N, _) => ListVal(.List)
+    requires N <Int 2
+  rule FactorFrom(N, D)
+    => PrependFactor(D, FactorFrom(N /Int D, D))
+    requires N >=Int 2 andBool D >=Int 2 andBool N %Int D ==Int 0
+  rule FactorFrom(N, D)
+    => FactorFrom(N, D +Int 1)
+    requires N >=Int 2 andBool D >=Int 2 andBool N %Int D =/=Int 0
+
+  syntax Val ::= FactorizeSpec(Int) [function]
+  rule FactorizeSpec(N) => FactorFrom(N, 2)
+
+  syntax Val ::= PrependFactor(Int, Val) [function]
+  rule PrependFactor(D, ListVal(L))
+    => ListVal(ListItem(IntVal(D)) L)
+
+  // Observable contract helpers used by claims in spec.k.
+  syntax Int ::= Product(Val) [function]
+  rule Product(ListVal(.List)) => 1
+  rule Product(ListVal(ListItem(IntVal(X)) REST))
+    => X *Int Product(ListVal(REST))
+
+  // OrderedFrom(V, L) says that V's integer elements are nondecreasing and
+  // that its first element, if present, is at least L.
+  syntax Bool ::= OrderedFrom(Val, Int) [function]
+  rule OrderedFrom(ListVal(.List), _) => true
+  rule OrderedFrom(ListVal(ListItem(IntVal(X)) REST), L)
+    => (L <=Int X) andBool OrderedFrom(ListVal(REST), X)
+
+  syntax Val ::= MachineValue(MachineState) [function]
+  rule MachineValue(Halted(_, _, _, V)) => V
+
+  syntax Bool ::= HasDivisor(Int, Int) [function]
+  rule HasDivisor(N, D) => false
+    requires D *Int D >Int N
+  rule HasDivisor(N, D) => true
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule HasDivisor(N, D) => HasDivisor(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+
+  syntax Bool ::= IsPrime(Int) [function]
+  rule IsPrime(N) => (N >=Int 2) andBool notBool HasDivisor(N, 2)
+
+  syntax Bool ::= AllPrime(Val) [function]
+  rule AllPrime(ListVal(.List)) => true
+  rule AllPrime(ListVal(ListItem(IntVal(X)) REST))
+    => IsPrime(X) andBool AllPrime(ListVal(REST))
+
+  syntax Bool ::= ValidFactorization(Int, Val) [function]
+  rule ValidFactorization(N, V)
+    => (Product(V) ==Int N)
+       andBool OrderedFrom(V, 2)
+       andBool AllPrime(V)
+
+  syntax Observation ::= Observe(Bool)
+endmodule

