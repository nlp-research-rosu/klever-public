+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim Run(Machine(
+          Invoke("factorize_from",
+            ListItem(IntVal(N)) ListItem(IntVal(D))) ~> K,
+          ENV, SolutionFunctions(), STACK, RESULT))
+      => Run(Machine(FactorFrom(N, D) ~> K,
+          ENV, SolutionFunctions(), STACK, RESULT))
+    requires N >=Int 1 andBool D >=Int 2
+endmodule
