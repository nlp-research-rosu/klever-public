+              ListItem(IntVal(1)) ListItem(IntVal(2))) ~> .K,
+            .Map, SolutionFunctions(), .List, noResult) </k>
+      <input> 0 </input>
+      <result> noResult </result>
+    </generatedTop>
+  =>
