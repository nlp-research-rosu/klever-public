+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim callDef("factorize_from",
+          ListItem(IntVal(N)) ListItem(IntVal(D)),
+          SolutionFunctions())
+      => FactorFrom(N, D)
+    requires N >=Int 1 andBool D >=Int 2
+
+  claim evalModule(SolutionModule(), N)
+      => FactorizeSpec(N)
+    requires N >=Int 1
+
+  claim Product(FactorFrom(N, D)) => N
+    requires N >=Int 1 andBool D >=Int 2
+
+  claim OrderedFrom(FactorFrom(N, D), L) => true
+    requires N >=Int 1 andBool D >=Int 2 andBool L <=Int D
+
+  claim evalModule(SolutionModule(), 8)
+      => ListVal(ListItem(IntVal(2)) ListItem(IntVal(2)) ListItem(IntVal(2)))
+
+  claim evalModule(SolutionModule(), 25)
+      => ListVal(ListItem(IntVal(5)) ListItem(IntVal(5)))
+
+  claim evalModule(SolutionModule(), 70)
+      => ListVal(ListItem(IntVal(2)) ListItem(IntVal(5)) ListItem(IntVal(7)))
+endmodule
