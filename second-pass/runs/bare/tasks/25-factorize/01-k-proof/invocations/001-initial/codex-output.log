+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Call" "(" Expr "," Exprs ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= IntVal(Int)
+               | BoolVal(Bool)
+               | ListVal(List)
+
+  syntax Closure ::= Closure(Params, Stmts)
+
+  syntax ExecResult ::= Normal(Map)
+                      | Returned(Val)
+
+  syntax Frame ::= Frame(K, Map)
+
+  syntax Result ::= "noResult"
+                  | Val
+
+  configuration
+    <k> $PGM:Module </k>
+    <input> $INPUT:Int </input>
+    <env> .Map </env>
+    <functions> .Map </functions>
+    <callStack> .List </callStack>
+    <result> noResult </result>
+
+  rule <k> Module(SS) => Invoke("factorize", ListItem(IntVal(N))) ~> Finish </k>
+       <input> N:Int </input>
+       <functions> .Map => collect(SS) </functions>
+
+  // An explicit call machine is used for execution.  Capturing the caller's
+  // continuation and environment in Frame gives Python calls local scope and
+  // gives reachability proofs a sound induction point at recursive calls.
+  syntax KItem ::= Invoke(String, List)
+                 | Exec(Stmts)
+                 | Eval(Expr)
+                 | BinLeft(String, Expr)
+                 | BinRight(String, Val)
+                 | CompareLeft(String, Expr)
+                 | CompareRight(String, Val)
+                 | "MakeList"
+                 | CallOne(String)
+                 | CallTwoLeft(String, Expr)
+                 | CallTwoRight(String, Val)
+                 | Choose(Stmts, Stmts)
+                 | "DoReturn"
+                 | "Finish"
+
+  rule <k> Invoke(F, VS) ~> KREST => Exec(BODY) </k>
+       <env> OLD => bind(PS, VS) </env>
+       <functions> (F |-> Closure(PS, BODY)) _FS </functions>
+       <callStack> STACK => ListItem(Frame(KREST, OLD)) STACK </callStack>
+
+  rule <k> Exec(.Stmts) => .K ...</k>
+  rule <k> Exec(Return(E) _REST) => Eval(E) ~> DoReturn ...</k>
+  rule <k> Exec(If(COND, THEN, ELSE) REST)
+        => Eval(COND) ~> Choose(THEN, ELSE) ~> Exec(REST) ...</k>
+
+  rule <k> BoolVal(B) ~> Choose(THEN, _) => Exec(THEN) ...</k>
+    requires B
+  rule <k> BoolVal(B) ~> Choose(_, ELSE) => Exec(ELSE) ...</k>
+    requires notBool B
+
+  rule <k> V:Val ~> DoReturn ~> _CURRENT
+        => V ~> KREST </k>
+       <env> _ => OLD </env>
+       <callStack> ListItem(Frame(KREST, OLD)) STACK => STACK </callStack>
+
+  rule <k> V:Val ~> Finish => .K </k>
+       <result> noResult => V </result>
+
+  rule <k> Eval(Int(I)) => IntVal(I) ...</k>
+  rule <k> Eval(Name(X)) => V ...</k>
+       <env> (X |-> V) _REST </env>
+  rule <k> Eval(ListExpr(.Exprs)) => ListVal(.List) ...</k>
+  rule <k> Eval(ListExpr(E)) => Eval(E) ~> MakeList ...</k>
+  rule <k> V:Val ~> MakeList => ListVal(ListItem(V)) ...</k>
+
+  rule <k> Eval(BinOp(OP, LEFT, RIGHT))
+        => Eval(LEFT) ~> BinLeft(OP, RIGHT) ...</k>
+  rule <k> V:Val ~> BinLeft(OP, RIGHT)
+        => Eval(RIGHT) ~> BinRight(OP, V) ...</k>
+  rule <k> V2:Val ~> BinRight(OP, V1)
+        => evalBinOp(OP, V1, V2) ...</k>
+
+  rule <k> Eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+        => Eval(LEFT) ~> CompareLeft(OP, RIGHT) ...</k>
+  rule <k> V:Val ~> CompareLeft(OP, RIGHT)
+        => Eval(RIGHT) ~> CompareRight(OP, V) ...</k>
+  rule <k> V2:Val ~> CompareRight(OP, V1)
+        => evalCompare(OP, V1, V2) ...</k>
+
+  rule <k> Eval(Call(Name(F), E)) => Eval(E) ~> CallOne(F) ...</k>
+  rule <k> V:Val ~> CallOne(F) => Invoke(F, ListItem(V)) ...</k>
+  rule <k> Eval(Call(Name(F), E1, E2))
+        => Eval(E1) ~> CallTwoLeft(F, E2) ...</k>
+  rule <k> V:Val ~> CallTwoLeft(F, E2)
+        => Eval(E2) ~> CallTwoRight(F, V) ...</k>
+  rule <k> V2:Val ~> CallTwoRight(F, V1)
+        => Invoke(F, ListItem(V1) ListItem(V2)) ...</k>
+
+  syntax Val ::= evalModule(Module, Int) [function]
+  rule evalModule(Module(SS), N)
+    => callDef("factorize", ListItem(IntVal(N)), collect(SS))
+
+  syntax Map ::= collect(Stmts) [function]
+  rule collect(.Stmts) => .Map
+  rule collect(ImportFrom(_, _) REST) => collect(REST)
+  rule collect(FuncDef(F, PS, BODY) REST)
+    => collect(REST)[F <- Closure(PS, BODY)]
+
+  syntax Val ::= callDef(String, List, Map) [function]
+  rule callDef(F, VS, (F |-> Closure(PS, BODY)) REST)
+    => returnedValue(execBlock(BODY, bind(PS, VS),
+                               (F |-> Closure(PS, BODY)) REST))
+
+  syntax Map ::= bind(Params, List) [function]
+  rule bind(Params(PS), VS) => bindLists(PS, VS)
+
+  syntax Map ::= bindLists(Strings, List) [function]
+  rule bindLists(.Strings, .List) => .Map
+  rule bindLists(P, PS, ListItem(V) VS)
+    => (P |-> V) bindLists(PS, VS)
+
+  syntax ExecResult ::= execBlock(Stmts, Map, Map) [function]
+  rule execBlock(.Stmts, ENV, _) => Normal(ENV)
+  rule execBlock(Return(E) REST, ENV, FS)
+    => Returned(evalExpr(E, ENV, FS))
+  rule execBlock(If(COND, THEN, ELSE) REST, ENV, FS)
+    => resume(execBlock(selectBranch(evalExpr(COND, ENV, FS), THEN, ELSE),
+                        ENV, FS), REST, FS)
+
+  syntax Stmts ::= selectBranch(Val, Stmts, Stmts) [function]
+  rule selectBranch(BoolVal(B), THEN, _) => THEN requires B
+  rule selectBranch(BoolVal(B), _, ELSE) => ELSE requires notBool B
+
+  syntax ExecResult ::= resume(ExecResult, Stmts, Map) [function]
+  rule resume(Normal(ENV), REST, FS) => execBlock(REST, ENV, FS)
+  rule resume(Returned(V), _, _) => Returned(V)
+
+  syntax Val ::= returnedValue(ExecResult) [function]
+  rule returnedValue(Returned(V)) => V
+
+  syntax Val ::= evalExpr(Expr, Map, Map) [function]
+  rule evalExpr(Int(I), _, _) => IntVal(I)
+  rule evalExpr(Name(X), (X |-> V) REST, _) => V
+  rule evalExpr(ListExpr(ES), ENV, FS)
+    => ListVal(evalExprs(ES, ENV, FS))
+  rule evalExpr(BinOp(OP, LEFT, RIGHT), ENV, FS)
+    => evalBinOp(OP, evalExpr(LEFT, ENV, FS), evalExpr(RIGHT, ENV, FS))
+  rule evalExpr(Compare(LEFT, CmpOp(OP, RIGHT)), ENV, FS)
+    => evalCompare(OP, evalExpr(LEFT, ENV, FS), evalExpr(RIGHT, ENV, FS))
+  rule evalExpr(Call(Name(F), ARGS), ENV, FS)
+    => callDef(F, evalExprs(ARGS, ENV, FS), FS)
+
+  syntax List ::= evalExprs(Exprs, Map, Map) [function]
+  rule evalExprs(.Exprs, _, _) => .List
+  rule evalExprs(E, ES, ENV, FS)
+    => ListItem(evalExpr(E, ENV, FS)) evalExprs(ES, ENV, FS)
+
+  syntax Val ::= evalBinOp(String, Val, Val) [function]
+  rule evalBinOp("+", IntVal(A), IntVal(B)) => IntVal(A +Int B)
+  rule evalBinOp("+", ListVal(A), ListVal(B)) => ListVal(A B)
+  rule evalBinOp("%", IntVal(A), IntVal(B)) => IntVal(A %Int B)
+    requires B =/=Int 0
+  rule evalBinOp("//", IntVal(A), IntVal(B)) => IntVal(A /Int B)
+    requires B =/=Int 0
+
+  syntax Val ::= evalCompare(String, Val, Val) [function]
+  rule evalCompare("<", IntVal(A), IntVal(B)) => BoolVal(A <Int B)
+  rule evalCompare("==", IntVal(A), IntVal(B)) => BoolVal(A ==Int B)
+endmodule
+
+module SEM-PROBE
+  imports SEMANTIC
+  claim <k> X:K </k> => <k> X </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..022d9cffcba2342436b7bc58f84fb212a3af5afd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+from typing import List
+
+
+def factorize_from(n: int, divisor: int) -> List[int]:
+    if n < 2:
+        return []
+    if n % divisor == 0:
+        return [divisor] + factorize_from(n // divisor, divisor)
+    return factorize_from(n, divisor + 1)
+
+
+def factorize(n: int) -> List[int]:
+    return factorize_from(n, 2)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9978f39a69007873147333d3090f22c1a41644ea
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,8 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <k> X:K </k>
+     => <k> X </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5bf59b07fce8caba6935424202cf8291b86e38fa
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,76 @@
+requires "semantic.k"
+
+module SOLUTION-PROGRAM
+  imports SEMANTIC
+
+  // This is the parsed term emitted in solution.mpy.  Keeping it as a K term
+  // makes the proof about the translator's output, not about Python source text.
+  syntax Module ::= SolutionModule() [function]
+  rule SolutionModule() =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("factorize_from", Params("n", "divisor"),
+        If(Compare(Name("n"), CmpOp("<", Int(2))),
+          Return(ListExpr(.Exprs)),
+          .Stmts)
+        If(Compare(BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+          Return(BinOp("+",
+            ListExpr(Name("divisor")),
+            Call(Name("factorize_from"),
+              BinOp("//", Name("n"), Name("divisor")),
+              Name("divisor")))),
+          .Stmts)
+        Return(Call(Name("factorize_from"),
+          Name("n"), BinOp("+", Name("divisor"), Int(1)))))
+      FuncDef("factorize", Params("n"),
+        Return(Call(Name("factorize_from"), Name("n"), Int(2)))))
+
+  syntax Map ::= SolutionFunctions() [function]
+  rule SolutionFunctions() => collectStmts(SolutionModule())
+
+  syntax Map ::= collectStmts(Module) [function]
+  rule collectStmts(Module(SS)) => collect(SS)
+endmodule
+
+module VERIFICATION
+  imports SOLUTION-PROGRAM
+
+  // Mathematical trial-division specification.  D is the next candidate.
+  // The first rule covers the conventional factorization of 1 as the empty
+  // list.  The other rules either emit a divisor or advance the candidate.
+  syntax Val ::= FactorFrom(Int, Int) [function]
+  rule FactorFrom(N, _) => ListVal(.List)
+    requires N <Int 2
+  rule FactorFrom(N, D)
+    => PrependFactor(D, FactorFrom(N /Int D, D))
+    requires N >=Int 2 andBool D >=Int 2 andBool N %Int D ==Int 0
+  rule FactorFrom(N, D)
+    => FactorFrom(N, D +Int 1)
+    requires N >=Int 2 andBool D >=Int 2 andBool N %Int D =/=Int 0
+
+  syntax Val ::= FactorizeSpec(Int) [function]
+  rule FactorizeSpec(N) => FactorFrom(N, 2)
+
+  syntax Val ::= PrependFactor(Int, Val) [function]
+  rule PrependFactor(D, ListVal(L))
+    => ListVal(ListItem(IntVal(D)) L)
+
+  // Observable contract helpers used by claims in spec.k.
+  syntax Int ::= Product(Val) [function]
+  rule Product(ListVal(.List)) => 1
+  rule Product(ListVal(ListItem(IntVal(X)) REST))
+    => X *Int Product(ListVal(REST))
+
+  // OrderedFrom(V, L) says that V's integer elements are nondecreasing and
+  // that its first element, if present, is at least L.
+  syntax Bool ::= OrderedFrom(Val, Int) [function]
+  rule OrderedFrom(ListVal(.List), _) => true
+  rule OrderedFrom(ListVal(ListItem(IntVal(X)) REST), L)
+    => (L <=Int X) andBool OrderedFrom(ListVal(REST), X)
+endmodule
+
+module PROBE
+  imports VERIFICATION
+  claim <k> X:K </k> => <k> X </k>
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module MPY-SYNTAX && kprove semantic.k --definition semantic-kompiled --spec-module SEM-PROBE --debug' in /work
