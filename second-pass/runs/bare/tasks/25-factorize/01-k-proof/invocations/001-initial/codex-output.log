+                 | Exec(Stmts)
+                 | Eval(Expr)
+                 | BinLeft(String, Expr)
+                 | BinRight(String, Val)
+                 | CompareLeft(String, Expr)
+                 | CompareRight(String, Val)
+                 | "MakeList"
+                 | CallOne(String)
+                 | CallTwoLeft(String, Expr)
+                 | CallTwoRight(String, Val)
+                 | Choose(Stmts, Stmts)
+                 | "DoReturn"
+                 | "Finish"
+
