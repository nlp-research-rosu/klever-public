diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a595d19d2a9c737063f3491312c23de0f1e2df2b
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def move_one_ball(arr):
+    if len(arr) == 0:
+        return True
+    drops = 0
+    previous = arr[-1]
+    for value in arr:
+        if previous > value:
+            drops = drops + 1
+        previous = value
+    return drops <= 1

