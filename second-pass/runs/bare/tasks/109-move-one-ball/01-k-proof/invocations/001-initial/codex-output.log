+    <input> I :: IS </input>
+    <env>
+      "arr" |-> listVal(I :: IS)
+      "drops" |-> iVal(cyclicDrops(I :: IS))
+      "previous" |-> iVal(last(I :: IS))
+      "value" |-> iVal(last(I :: IS))
+    </env>
+endmodule
