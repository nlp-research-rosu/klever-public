+  // Denotational fold for the exact loop emitted from solution.py.  It is the
+  // symbolic counterpart of repeatedly binding value, executing the If, and
+  // assigning previous; dropsFrom is defined independently in verification.k.
+  rule <k> loop("value", I :: IS,
+          If(Compare(Name("previous"), CmpOp(">", Name("value"))),
+            Assign(Name("drops"), BinOp("+", Name("drops"), Int(1))) .Stmts,
+            .Stmts)
+          Assign(Name("previous"), Name("value")) .Stmts)
+        => .K ... </k>
+       <env> ("drops" |-> iVal(D)
+              "previous" |-> iVal(P)
+              REST)
+          => ("drops" |-> iVal(D +Int dropsFrom(P, I :: IS))
