+  syntax Stmt ::= FuncDef(String, Params, Stmts)
+                | Return(Expr)
+                | Assign(Expr, Expr)
+                | If(Expr, Stmts, Stmts)
+                | For(Expr, Expr, Stmts)
+  syntax Params ::= Params(String)
+
+  syntax Expr ::= Name(String)
+                | Int(Int)
+                | Bool(Bool)
+                | UnaryOp(String, Expr)
+                | BinOp(String, Expr, Expr)
+                | Compare(Expr, CmpOp)
+                | Call(Expr, Expr)
+                | Subscript(Expr, Expr)
+  syntax CmpOp ::= CmpOp(String, Expr)
