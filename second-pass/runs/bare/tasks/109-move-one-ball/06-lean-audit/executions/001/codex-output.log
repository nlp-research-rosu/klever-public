     1	def move_one_ball(arr):
     2	    if len(arr) == 0:
     3	        return True
     4	    drops = 0
     5	    previous = arr[-1]
     6	    for value in arr:
     7	        if previous > value:
     8	            drops = drops + 1
     9	        previous = value
    10	    return drops <= 1

