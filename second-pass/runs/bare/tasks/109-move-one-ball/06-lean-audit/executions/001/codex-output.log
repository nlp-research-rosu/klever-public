from itertools import permutations, product

def source_loop(arr):
    if not arr: return True, 0
    drops=0; previous=arr[-1]
    for value in arr:
        if previous > value: drops += 1
        previous=value
    return drops <= 1, drops

def drop_bit(i,j): return 1 if i>j else 0
def last_rec(xs): return xs[0] if len(xs)==1 else last_rec(xs[1:])
def drops_from(previous,xs):
    return 0 if not xs else drop_bit(previous,xs[0])+drops_from(xs[0],xs[1:])
def cyclic_rec(xs): return 0 if not xs else drops_from(last_rec(xs),xs)
def rotation_sortable_rec(xs): return cyclic_rec(xs)<=1
def rotation_exists_sorted(xs):
    if not xs: return True
    return any(all(r[i] <= r[i+1] for i in range(len(r)-1))
               for k in range(len(xs))
               for r in [xs[-k:]+xs[:-k] if k else xs])

all_lists=[list(xs) for n in range(0,7) for xs in permutations(range(n))]
bridge_bad=[]; intent_bad=[]
for xs in all_lists:
    result,drops=source_loop(xs)
    if drops "'!= cyclic_rec(xs) or result != rotation_sortable_rec(xs): bridge_bad.append(xs)
    if result != rotation_exists_sorted(xs): intent_bad.append(xs)
print('"'distinct_lists_checked=',len(all_lists))
print('source_loop_vs_recurrences_mismatches=',len(bridge_bad))
print('source_result_vs_sorted_rotation_mismatches=',len(intent_bad))

repeated=[list(xs) for n in range(0,6) for xs in product(range(3), repeat=n)]
repeat_bridge_bad=[]
for xs in repeated:
    result,drops=source_loop(xs)
    if drops "'!= cyclic_rec(xs) or result != rotation_sortable_rec(xs): repeat_bridge_bad.append(xs)
print('"'repeated_value_lists_checked=',len(repeated))
print('source_loop_vs_recurrences_repeated_mismatches=',len(repeat_bridge_bad))

# Counterfactual definitions expected to disagree, demonstrating relevance/sensitivity.
def no_wrap(xs): return sum(xs[i] > xs[i+1] for i in range(len(xs)-1))
def reversed_cmp(xs):
    return 0 if not xs else sum(a < b for a,b in zip([xs[-1]]+xs[:-1],xs))
for label,mut in [('omit_wraparound',no_wrap),('reverse_comparison',reversed_cmp)]:
    witnesses=[]
    for xs in all_lists:
        truth=cyclic_rec(xs)
        if mut(xs)"'!=truth:
            witnesses.append((xs,truth,mut(xs)))
            if len(witnesses)==5: break
    print(label+'"'_first_witnesses=',witnesses)
PY
} 2>&1 | tee /audit-output/evidence/11_independent_semantic_crosscheck.txt" in /audit-output
