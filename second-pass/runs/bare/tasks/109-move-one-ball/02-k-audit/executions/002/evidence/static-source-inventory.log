     3	module HUMAN-EVAL-VERIFICATION
     4	  imports HUMAN-EVAL-SYNTAX
     5	  imports INT
     6	  imports BOOL
     7	
     8	  // Mathematical operations on the input representation.
     9	  syntax Int ::= length(IList) [function, total]
    10	               | last(IList) [function]
    11	               | dropBit(Int, Int) [function, total]
    12	               | dropsFrom(Int, IList) [function, total]
    13	               | cyclicDrops(IList) [function, total]
    14	  syntax Bool ::= rotationSortable(IList) [function, total]
    15	
    16	  rule length(.IList) => 0
    17	  rule length(_I :: IS) => 1 +Int length(IS)
    18	
    19	  rule last(I :: .IList) => I
    20	  rule last(_I :: J :: IS) => last(J :: IS)
    21	
    22	  rule dropBit(I, J) => 1 requires I >Int J
    23	  rule dropBit(I, J) => 0 requires I <=Int J
    24	
    25	  rule dropsFrom(_PREVIOUS, .IList) => 0
    26	  rule dropsFrom(PREVIOUS, I :: IS)
    27	    => dropBit(PREVIOUS, I) +Int dropsFrom(I, IS)
    28	
    29	  rule cyclicDrops(.IList) => 0
    30	  rule cyclicDrops(I :: IS) => dropsFrom(last(I :: IS), I :: IS)
    31	
    32	  // For a list of distinct integers, this is equivalent to existence of a
    33	  // right rotation that is strictly increasing: a circle has at most one drop.
    34	  rule rotationSortable(L) => cyclicDrops(L) <=Int 1
    35	endmodule
