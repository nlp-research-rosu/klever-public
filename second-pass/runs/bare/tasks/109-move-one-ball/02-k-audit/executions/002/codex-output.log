+  exit 64
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} > "$log_file"
+
+"$@" >> "$log_file" 2>&1
+command_status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT STATUS: %d\n' "$command_status"
+} >> "$log_file"
+
