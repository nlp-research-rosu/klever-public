diff --git a/evidence/spec-nonempty-reviewer.k b/evidence/spec-nonempty-reviewer.k
new file mode 100644
index 0000000000000000000000000000000000000000..0b0fd48f2887ed57b1a813acfd22a420e9671a8a
--- /dev/null
+++ b/evidence/spec-nonempty-reviewer.k
@@ -0,0 +1,16 @@
