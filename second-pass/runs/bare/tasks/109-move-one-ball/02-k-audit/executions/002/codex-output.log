from pathlib import Path
import hashlib,itertools,stat
cases=[('/candidate','2eb2b0c8fdaf3b021258f093db306745c02fd59317fbd7b8287fd550ec5b2e5b'),('/generation-evidence/codex-trace','181f2376436666d812d536a2a5d4781c1d9094a01a223bbc6038665a98f913dd')]
for rs,target in cases:
 root=Path(rs); entries=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
 print(root,'entries',len(entries))
 tokens={}
 for p in entries:
  rel=p.relative_to(root).as_posix().encode(); data=p.read_bytes() if p.is_file() else b''; he=hashlib.sha256(data).hexdigest().encode(); bi=hashlib.sha256(data).digest(); typ=b'f' if p.is_file() else b'd'; mode=oct(p.stat().st_mode & 0o777).encode()
  tokens[p]={'r':rel,'d':data,'h':he,'b':bi,'t':typ,'m':mode,'z':b''}
 found=0
 # pattern sequence chosen tokens per entry, separators, trailing, include dir yes/no
 for include_dirs in [True,False]:
  ents=[p for p in entries if include_dirs or p.is_file()]
  for n in [2,3,4]:
   for pattern in itertools.product('rtdhbm',repeat=n):
    if 'r' not in pattern:continue
    if not any(x in pattern for x in 'dhb'):continue
    for sep in [b'',b'\\0',b'\\n',b':',b' ']:
