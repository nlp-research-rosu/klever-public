-  // assigning previous; dropsFrom is defined independently in verification.k.
-  rule <k> loop("value", I :: IS,
-          If(Compare(Name("previous"), CmpOp(">", Name("value"))),
-            Assign(Name("drops"), BinOp("+", Name("drops"), Int(1))) .Stmts,
-            .Stmts)
-          Assign(Name("previous"), Name("value")) .Stmts)
-        => .K ... </k>
-       <env> ("drops" |-> iVal(D)
-              "previous" |-> iVal(P)
-              REST)
-          => ("drops" |-> iVal(D +Int dropsFrom(P, I :: IS))
-              "previous" |-> iVal(last(I :: IS))
-              (REST [ "value" <- iVal(last(I :: IS)) ]))
-       </env>
-
-  // Generic concrete iteration remains available for any other loop body.
+  // Reviewer bridge-free variant: all loops use ordinary concrete iteration.
   rule <k> loop(X, I :: IS, BODY)
         => bind(X, iVal(I)) ~> exec(BODY) ~> loop(X, IS, BODY) ... </k>
