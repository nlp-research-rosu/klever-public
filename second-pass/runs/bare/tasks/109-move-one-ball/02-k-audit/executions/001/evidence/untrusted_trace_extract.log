COMMAND[4]=const patch = "*** Begin Patch\n*** Add File: /work/solution.py\n+def move_one_ball(arr):\n+    if len(arr) == 0:\n+        return True\n+    drops = 0\n+    previous = arr[-1]\n+    for value in arr:\n+        if previous > value:\n+            drops = drops + 1\n+        previous = value\n+    return drops <= 1\n*** End Patch";
text(await tools.apply_patch(patch));

