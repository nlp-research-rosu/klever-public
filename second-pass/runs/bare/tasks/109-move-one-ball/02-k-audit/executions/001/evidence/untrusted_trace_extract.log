COMMAND[21]=const patch = "*** Begin Patch\n*** Add File: /work/spec.k\n+requires \"semantic.k\"\n+\n+module HUMAN-EVAL-SPEC\n+  imports HUMAN-EVAL\n+\n+  // This macro is exactly the constructor tree generated in solution.mpy.\n+  syntax Pgm ::= \"theSolution\"\n+  macro theSolution =>\n+    Module(\n+      FuncDef(\"move_one_ball\", Params(\"arr\"),\n+        If(Compare(Call(Name(\"len\"), Name(\"arr\")), CmpOp(\"==\", Int(0))),\n+          Return(Bool(true)) .Stmts,\n+          .Stmts)\n+        Assign(Name(\"drops\"), Int(0))\n+        Assign(Name(\"previous\"),\n+          Subscript(Name(\"arr\"), UnaryOp(\"-\", Int(1))))\n+        For(Name(\"value\"), Name(\"arr\"),\n+          If(Compare(Name(\"previous\"), CmpOp(\">\", Name(\"value\"))),\n+            Assign(Name(\"drops\"),\n+              BinOp(\"+\", Name(\"drops\"), Int(1))) .Stmts,\n+            .Stmts)\n+          Assign(Name(\"previous\"), Name(\"value\")) .Stmts)\n+        Return(Compare(Name(\"drops\"), CmpOp(\"<=\", Int(1)))) .Stmts))\n+\n+  // Empty input is explicitly required to return true.\n+  claim\n+    <human-eval>\n+      <k> theSolution </k>\n+      <input> .IList </input>\n+      <env> .Map </env>\n+    </human-eval>\n+  =>\n+    <human-eval>\n+      <k> bVal(true) ~> .K </k>\n+      <input> .IList </input>\n+      <env> \"arr\" |-> listVal(.IList) </env>\n+    </human-eval>\n+\n+  // For every nonempty integer list, the translated program computes the\n+  // independent rotation-sortability predicate from verification.k.\n+  claim\n+    <human-eval>\n+      <k> theSolution </k>\n+      <input> I :: IS </input>\n+      <env> .Map </env>\n+    </human-eval>\n+  =>\n+    <human-eval>\n+      <k> bVal(rotationSortable(I :: IS)) ~> .K </k>\n+      <input> I :: IS </input>\n+      <env>\n+        \"arr\" |-> listVal(I :: IS)\n+        \"drops\" |-> iVal(cyclicDrops(I :: IS))\n+        \"previous\" |-> iVal(last(I :: IS))\n+        \"value\" |-> iVal(last(I :: IS))\n+      </env>\n+    </human-eval>\n+endmodule\n*** End Patch";
