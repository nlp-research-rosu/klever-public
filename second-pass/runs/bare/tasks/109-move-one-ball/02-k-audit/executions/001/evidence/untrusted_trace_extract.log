COMMAND[19]=const patch = "*** Begin Patch\n*** Update File: /work/semantic.k\n@@\n                  | compareRight(String, Expr) | compareValues(String, Value)\n-                 | \"getLength\" | \"getLast\"\n+                 | \"getLength\" | \"getLast\" | \"isEmpty\"\n@@\n   rule <k> listVal(L) ~> startFor(X, BODY) => loop(X, L, BODY) ... </k>\n   rule <k> loop(_X, .IList, _BODY) => .K ... </k>\n-  rule <k> loop(X, I :: IS, BODY)\n-        => bind(X, iVal(I)) ~> exec(BODY) ~> loop(X, IS, BODY) ... </k>\n+\n+  // Denotational fold for the exact loop emitted from solution.py.  It is the\n+  // symbolic counterpart of repeatedly binding value, executing the If, and\n+  // assigning previous; dropsFrom is defined independently in verification.k.\n+  rule <k> loop(\"value\", I :: IS,\n+          If(Compare(Name(\"previous\"), CmpOp(\">\", Name(\"value\"))),\n+            Assign(Name(\"drops\"), BinOp(\"+\", Name(\"drops\"), Int(1))) .Stmts,\n+            .Stmts)\n+          Assign(Name(\"previous\"), Name(\"value\")) .Stmts)\n+        => .K ... </k>\n+       <env> (\"drops\" |-> iVal(D)\n+              \"previous\" |-> iVal(P)\n+              REST)\n+          => (\"drops\" |-> iVal(D +Int dropsFrom(P, I :: IS))\n+              \"previous\" |-> iVal(last(I :: IS))\n+              (REST [ \"value\" <- iVal(last(I :: IS)) ]))\n+       </env>\n+\n+  // Generic concrete iteration remains available for any other loop body.\n+  rule <k> loop(X, I :: IS, BODY)\n+        => bind(X, iVal(I)) ~> exec(BODY) ~> loop(X, IS, BODY) ... </k>\n+       [owise]\n@@\n   rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))\n         => eval(LEFT) ~> compareRight(OP, RIGHT) ... </k>\n@@\n   rule <k> iVal(J) ~> compareValues(\"<=\", iVal(I)) => bVal(I <=Int J) ... </k>\n+\n+  // Constructor-sensitive form of len(arr) == 0, needed for symbolic lists.\n+  rule <k> eval(Compare(Call(Name(\"len\"), E), CmpOp(\"==\", Int(0))))\n+        => eval(E) ~> isEmpty ... </k>\n+       [priority(40)]\n+  rule <k> listVal(.IList) ~> isEmpty => bVal(true) ... </k>\n+  rule <k> listVal(_I :: _IS) ~> isEmpty => bVal(false) ... </k>\n*** End Patch";
