+def move_one_ball(arr):
+    drops = 0
+    previous = arr[-1]
+    for value in arr:
+        if previous > value:
+            drops = drops + 1
+        previous = value
+    return previous + drops
+
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..df2fb11c678145de30508536fe19431e9d5195a3
--- /dev/null
