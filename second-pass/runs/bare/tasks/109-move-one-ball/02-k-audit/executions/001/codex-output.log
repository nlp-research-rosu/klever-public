+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log=$1
+shift
+exec > >(tee "$log") 2>&1
+printf '$'
+printf ' %q' "$@"
+printf '\n'
