index 0000000000000000000000000000000000000000..df2fb11c678145de30508536fe19431e9d5195a3
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log=$1
+shift
+exec > >(tee "$log") 2>&1
+printf '$'
+printf ' %q' "$@"
+printf '\n'
+"$@"
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status"
+exit "$status"
+
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
