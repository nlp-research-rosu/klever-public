+exec > >(tee "$log") 2>&1
+
+translate() {
+  source_path=$1
+  output_path=$2
+  printf '$ python3 /tmp/audit-work/source/py2mpy.py %q > %q\n' \
+    "$source_path" "$output_path"
+  python3 /tmp/audit-work/source/py2mpy.py "$source_path" > "$output_path"
