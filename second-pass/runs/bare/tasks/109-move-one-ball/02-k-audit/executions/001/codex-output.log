+requires "semantic.k"
+
+module SPEC-VACUITY
+  imports HUMAN-EVAL
+
+  // Deliberately false: require the opposite Boolean result while retaining
+  // the original satisfiable nonempty precondition and exact final state.
+  claim [opposite-result]:
+        <k> theSolution
+          => bVal(notBool rotationSortable(I :: IS)) ~> .K
+        </k>
+        <input> I :: IS </input>
+        <env> .Map
+          => "arr" |-> listVal(I :: IS)
+             "drops" |-> iVal(cyclicDrops(I :: IS))
+             "previous" |-> iVal(last(I :: IS))
+             "value" |-> iVal(last(I :: IS))
+        </env>
+endmodule
+
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c2dce9519a7901e4dd5fede20d815479896e354a
--- /dev/null
