  --main-module HUMAN-EVAL \
  --syntax-module HUMAN-EVAL-SYNTAX \
  --output-definition semantic-haskell-kompiled

kprove spec.k \
  --definition semantic-haskell-kompiled \
  --spec-module HUMAN-EVAL-SPEC

