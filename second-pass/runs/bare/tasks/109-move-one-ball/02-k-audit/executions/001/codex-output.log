+  exit 64
+fi
+
+log=$1
+shift
+exec > >(tee "$log") 2>&1
+printf '$'
+printf ' %q' "$@"
+printf '\n'
+"$@"
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status"
+exit "$status"
