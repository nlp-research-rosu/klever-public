+  /candidate/semantic.k \
+  /tmp/audit-work/source/semantic.k \
+  /tmp/audit-work/source/semantic-generic.k \
+  /tmp/audit-work/source/observe_continuation.mpy \
+  /tmp/audit-work/source/body_mutation.mpy
+

exec
