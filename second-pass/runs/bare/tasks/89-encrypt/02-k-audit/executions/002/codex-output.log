+                 BinOp("+",
+                   BinOp("%",
+                     BinOp("+",
+                       BinOp("-",
+                         Call(Name("ord"), Subscript(Name("s"), Int(0))),
+                         Int(97)),
+                       Int(4)),
+                     Int(26)),
+                   Int(97))),
+               Call(Name("encrypt"),
+                 Subscript(Name("s"),
+                   Slice(Int(1), NoBound, NoBound)))))))
+endmodule
