(122, 'exec', 'const patch = "*** Begin Patch\\n*** Update File: /work/semantic.k\\n@@\\n-  imports K-EQUAL\\n@@\\n-  syntax Val ::= Int | String | Bool\\n+  syntax Val ::= Int | String | Bool | \\"PyBool\\" \\"(\\" Bool \\")\\"\\n@@\\n                  | \\"subBase\\" \\"(\\" Expr \\")\\"\\n                  | \\"applyFun\\" \\"(\\" String \\")\\"\\n+                 | \\"choose\\" \\"(\\" Stmts \\",\\" Stmts \\",\\" Stmts \\")\\"\\n                  | \\"endCall\\"\\n@@\\n   rule <k> S2:String ~> cmpRight(\\"==\\", S1:String)\\n-         => S1 ==String S2 ... </k>\\n+         => PyBool(S1 ==String S2) ... </k>\\n@@\\n-  rule <k> exec(If(Compare(Name(X), CmpOp(\\"==\\", Str(T))), THEN, _) REST)\\n-         => exec(THEN REST) ... </k>\\n-       <env>... X |-> S:String ...</env>\\n-       requires S ==String T\\n-  rule <k> exec(If(Compare(Name(X), CmpOp(\\"==\\", Str(T))), _, ELSE) REST)\\n-         => exec(ELSE REST) ... </k>\\n-       <env>... X |-> S:String ...</env>\\n-       requires S =/=K T\\n+  rule <k> exec(If(COND, THEN, ELSE) REST)\\n+         => eval(COND) ~> choose(THEN, ELSE, REST) ... </k>\\n+  rule <k> PyBool(true) ~> choose(THEN, _, REST)\\n+         => exec(THEN REST) ... </k>\\n+  rule <k> PyBool(false) ~> choose(_, ELSE, REST)\\n+         => exec(ELSE REST) ... </k>\\n*** End Patch";\ntext(await tools.apply_patch(patch));\n')
