+
+echo "\$ krun solution-symbolic.mpy -cINPUT='\"\"' --definition /tmp/audit-work/build/proof-kompiled --parser /audit-output/evidence/mpy-full-parser.sh --depth 1 > /tmp/audit-work/build/symbolic-depth0.txt"
