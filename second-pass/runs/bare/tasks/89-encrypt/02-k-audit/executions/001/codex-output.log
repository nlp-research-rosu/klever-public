+regen_status=$?
+printf '[exit %d]\n' "$regen_status"
+run cmp -s regenerated-solution.mpy solution.mpy
+mpy_cmp=$?
+
+echo "Normalize actual parsed body and solutionBody abbreviation at depth zero:"
+echo "\$ krun solution.mpy -cINPUT='\"\"' --definition /tmp/audit-work/build/proof-kompiled --parser /audit-output/evidence/mpy-full-parser.sh --depth 0 > /tmp/audit-work/build/actual-depth0.txt"
+krun solution.mpy \
+  -cINPUT='""' \
+  --definition /tmp/audit-work/build/proof-kompiled \
+  --parser /audit-output/evidence/mpy-full-parser.sh \
+  --depth 0 > /tmp/audit-work/build/actual-depth0.txt
+actual_status=$?
+printf '[exit %d]\n' "$actual_status"
+
+echo "\$ krun solution-symbolic.mpy -cINPUT='\"\"' --definition /tmp/audit-work/build/proof-kompiled --parser /audit-output/evidence/mpy-full-parser.sh --depth 0 > /tmp/audit-work/build/symbolic-depth0.txt"
+krun solution-symbolic.mpy \
