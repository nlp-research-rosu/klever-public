+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+cd /tmp/audit-work/source || exit 99
+
+echo "Trusted regeneration:"
+printf '$ python3 /reference/py2mpy.py solution.py > regenerated-solution.mpy\n'
+python3 /reference/py2mpy.py solution.py > regenerated-solution.mpy
+regen_status=$?
+printf '[exit %d]\n' "$regen_status"
+run cmp -s regenerated-solution.mpy solution.mpy
+mpy_cmp=$?
+
+echo "Normalize actual parsed body and solutionBody abbreviation at depth zero:"
+echo "\$ krun solution.mpy -cINPUT='\"\"' --definition /tmp/audit-work/build/proof-kompiled --depth 0 > /tmp/audit-work/build/actual-depth0.txt"
+krun solution.mpy \
