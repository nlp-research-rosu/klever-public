+
+echo "\$ krun solution-symbolic.mpy -cINPUT='\"\"' --definition /tmp/audit-work/build/proof-kompiled --depth 0 > /tmp/audit-work/build/symbolic-depth0.txt"
+krun solution-symbolic.mpy \
