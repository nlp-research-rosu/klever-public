+  "$regen_status" "$mpy_cmp" "$actual_status" "$symbolic_status" "$config_cmp" "$substitution_status"
+if (( regen_status || mpy_cmp || actual_status || symbolic_status || config_cmp || substitution_status )); then
+  exit 1
+fi
