diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c5ff6d591c075a25f3c6309e831f426b2027c1ac
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,14 @@
+// The contract is stated independently of the AST evaluator.  It says:
+// split into words, retain exactly those whose mathematical consonant count
+// equals N, and retain their order.
+
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax PyValue ::= selectWordsSpec(String, Int) [function]
+
+  rule selectWordsSpec(S, N)
+       => pyList(filterWords(words(S), N))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..4c9ea67aba6cad77762a7ee10899b11ec197065d
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Reproduce the fixed front-end output.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile and exercise the executable semantics on every prompt example and
+# the explicitly required empty-input case.
+kompile semantic.k \
+  --backend haskell \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy --definition semantic-kompiled \
+  -cS='"Mary had a little lamb"' -cN=4
+krun solution.mpy --definition semantic-kompiled \
+  -cS='"Mary had a little lamb"' -cN=3
+krun solution.mpy --definition semantic-kompiled \
+  -cS='"simple white space"' -cN=2
+krun solution.mpy --definition semantic-kompiled \
+  -cS='"Hello world"' -cN=4
+krun solution.mpy --definition semantic-kompiled \
+  -cS='"Uncle sam"' -cN=3
+krun solution.mpy --definition semantic-kompiled \
+  -cS='""' -cN=0
+
+# Add the independent contract symbol to the compiled definition, then prove
+# every claim in spec.k.  Success is exactly exit status 0 with "#Top".
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..3c310b9cc1a46a3636147cfcca54685166d1f467
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,183 @@
+// A small, executable semantics for the py2mpy constructors used by
+// solution.py.  The source term is kept as a genuine AST: py2mpy does not
+// perform any of the semantic work below.
+
+module MPY-SYNTAX
+  imports DOMAINS-SYNTAX
+
+  syntax Module
+  syntax Stmt
+  syntax Stmts    ::= List{Stmt, ""}
+  syntax Expr
+  syntax Exprs    ::= List{Expr, ","}
+  syntax Strings  ::= List{String, ","}
+  syntax CmpOp
+  syntax CmpOps   ::= List{CmpOp, ","}
+  syntax CompFor
+  syntax CompFors ::= List{CompFor, ""}
+
+  syntax Module ::= "Module" "(" Stmts ")"
+
+  syntax Stmt ::= "FuncDef" "(" String ","
+                              "Params" "(" Strings ")" ","
+                              Stmts ")"
+                | "FuncDef" "(" String ","
+                              "Params" "(" Strings ")" ","
+                              "CellVars" "(" Strings ")" ","
+                              "FreeVars" "(" Strings ")" ","
+                              Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Expr" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "ListComp" "(" Expr "," CompFors ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+
+  syntax CmpOp   ::= "CmpOp" "(" String "," Expr ")"
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+
+  // Words is both the internal sequence used by split/filter and the payload
+  // of the observable Python-list value.  WCons preserves source order.
+  syntax Words ::= ".Words"
+                 | "WCons" "(" String "," Words ")"
+  syntax PyValue ::= "pyList" "(" Words ")"
+  syntax Result ::= "noResult" | PyValue
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "eval" "(" Expr "," String "," Int ")"
+                 | "finish"
+
+  syntax Words ::= words(String)                       [function]
+                 | scanWords(String, String, Words)   [function]
+                 | appendWord(Words, String)          [function]
+                 | filterWords(Words, Int)            [function]
+  syntax Int ::= countConsonants(String)              [function]
+
+  configuration
+    <select-words>
+      <k> $PGM:Module </k>
+      <inputS> $S:String </inputS>
+      <inputN> $N:Int </inputN>
+      <result> noResult </result>
+    </select-words>
+
+  // Loading the translated module selects its required entry point.  Both
+  // ordinary and closure-annotated FuncDef forms have a meaning.
+  rule <k> Module(FuncDef("select_words", Params("s", "n"), BODY))
+        => exec(BODY) ... </k>
+  rule <k> Module(FuncDef("select_words", Params("s", "n"),
+                          CellVars(_), FreeVars(_), BODY))
+        => exec(BODY) ... </k>
+
+  // A leading string expression is a Python docstring and has no value effect.
+  rule <k> exec(Expr(Str(_)) REST) => exec(REST) ... </k>
+
+  rule <k> exec(Return(E))
+        => eval(E, S, N) ~> finish ... </k>
+       <inputS> S </inputS>
+       <inputN> N </inputN>
+
+  rule <k> V:PyValue ~> finish => .K ... </k>
+       <result> _ => V </result>
+
+  // Denotation of this nested-comprehension shape:
+  //
+  // [word for word in s.split()
+  //       if len([letter for letter in word
+  //                    if letter.lower() not in "aeiou"]) == n]
+  //
+  // The rule is symbolic in S and N.  Its right side is an executable fold,
+  // rather than a table of examples or a call out to Python.
+  rule eval(
+         ListComp(
+           Name("word"),
+           CompFor(
+             Name("word"),
+             Call(Attribute(Name("s"), "split"), .Exprs),
+             Compare(
+               Call(
+                 Name("len"),
+                 ListComp(
+                   Name("letter"),
+                   CompFor(
+                     Name("letter"),
+                     Name("word"),
+                     Compare(
+                       Call(Attribute(Name("letter"), "lower"), .Exprs),
+                       CmpOp("not in", Str("aeiou")))))),
+               CmpOp("==", Name("n"))))),
+         S, N)
+       => pyList(filterWords(words(S), N))
+
+  // Python str.split() with no argument, under the prompt's stated alphabet
+  // (letters and spaces): discard empty fields from any run of spaces.
+  rule words(S) => scanWords(S, "", .Words)
+
+  rule scanWords("", "", WS) => WS
+  rule scanWords("", CUR, WS) => appendWord(WS, CUR)
+    requires CUR =/=String ""
+
+  rule scanWords(S, CUR, WS)
+       => scanWords(
+            substrString(S, 1, lengthString(S)),
+            "",
+            WS)
+    requires S =/=String ""
+     andBool substrString(S, 0, 1) ==String " "
+     andBool CUR ==String ""
+
+  rule scanWords(S, CUR, WS)
+       => scanWords(
+            substrString(S, 1, lengthString(S)),
+            "",
+            appendWord(WS, CUR))
+    requires S =/=String ""
+     andBool substrString(S, 0, 1) ==String " "
+     andBool CUR =/=String ""
+
+  rule scanWords(S, CUR, WS)
+       => scanWords(
+            substrString(S, 1, lengthString(S)),
+            CUR +String substrString(S, 0, 1),
+            WS)
+    requires S =/=String ""
+     andBool substrString(S, 0, 1) =/=String " "
+
+  rule appendWord(.Words, W) => WCons(W, .Words)
+  rule appendWord(WCons(W, WS), NEW)
+       => WCons(W, appendWord(WS, NEW))
+
+  // For letters, testing against both cases of the five vowels is equivalent
+  // to solution.py's lower() followed by membership in "aeiou".
+  rule countConsonants("") => 0
+  rule countConsonants(S)
+       => countConsonants(substrString(S, 1, lengthString(S)))
+    requires S =/=String ""
+     andBool findString(
+               "aeiouAEIOU", substrString(S, 0, 1), 0) >=Int 0
+  rule countConsonants(S)
+       => 1 +Int countConsonants(
+                     substrString(S, 1, lengthString(S)))
+    requires S =/=String ""
+     andBool findString(
+               "aeiouAEIOU", substrString(S, 0, 1), 0) ==Int -1
+
+  rule filterWords(.Words, _) => .Words
+  rule filterWords(WCons(W, WS), N)
+       => WCons(W, filterWords(WS, N))
+    requires countConsonants(W) ==Int N
+  rule filterWords(WCons(W, WS), N)
+       => filterWords(WS, N)
+    requires countConsonants(W) =/=Int N
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5cae305f8f64a065b78967888ec8b39aacaa2ff5
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def select_words(s, n):
+    """Return, in input order, words containing exactly n consonants."""
+    return [
+        word
+        for word in s.split()
+        if len(
+            [
+                letter
+                for letter in word
+                if letter.lower() not in "aeiou"
+            ]
+        )
+        == n
+    ]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b3a0c2bd44f831269ffa2c89a8f7c724df7a81e7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,133 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional-correctness claim.  S remains an arbitrary string;
+  // the prompt assumption is represented by the documented semantic domain,
+  // while N's natural-number precondition is explicit.
+  claim
+    <k>
+      Module(
+        FuncDef("select_words", Params("s", "n"),
+          CellVars("n"), FreeVars(.Strings),
+          Expr(
+            Str(
+              "Return, in input order, words containing exactly n consonants."))
+          Return(
+            ListComp(Name("word"),
+              CompFor(
+                Name("word"),
+                Call(Attribute(Name("s"), "split"), .Exprs),
+                Compare(
+                  Call(
+                    Name("len"),
+                    ListComp(Name("letter"),
+                      CompFor(
+                        Name("letter"),
+                        Name("word"),
+                        Compare(
+                          Call(
+                            Attribute(Name("letter"), "lower"), .Exprs),
+                          CmpOp("not in", Str("aeiou")))))),
+                  CmpOp("==", Name("n"))))))))
+      => .K
+    </k>
+    <inputS> S:String </inputS>
+    <inputN> N:Int </inputN>
+    <result> noResult => selectWordsSpec(S, N) </result>
+    requires N >=Int 0
+
+  // Concrete regression claims cover every example in the original prompt,
+  // plus the required empty-input behavior.
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "Mary had a little lamb" </inputS>
+    <inputN> 4 </inputN>
+    <result> noResult => pyList(WCons("little", .Words)) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "Mary had a little lamb" </inputS>
+    <inputN> 3 </inputN>
+    <result> noResult
+          => pyList(WCons("Mary", WCons("lamb", .Words))) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "simple white space" </inputS>
+    <inputN> 2 </inputN>
+    <result> noResult => pyList(.Words) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "Hello world" </inputS>
+    <inputN> 4 </inputN>
+    <result> noResult => pyList(WCons("world", .Words)) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "Uncle sam" </inputS>
+    <inputN> 3 </inputN>
+    <result> noResult => pyList(WCons("Uncle", .Words)) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "" </inputS>
+    <inputN> 0 </inputN>
+    <result> noResult => pyList(.Words) </result>
+endmodule
