+                              "Params" "(" Strings ")" ","
+                              "CellVars" "(" Strings ")" ","
+                              "FreeVars" "(" Strings ")" ","
+                              Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Expr" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "ListComp" "(" Expr "," CompFors ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+
+  syntax CmpOp   ::= "CmpOp" "(" String "," Expr ")"
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
+endmodule
+
+module SEMANTIC
