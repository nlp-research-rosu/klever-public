+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The executable and reference counters agree for every string.  Symbolic
+  // execution performs induction by consuming one character on each step.
+  claim countConsonants(S:String)
+     => specCountConsonants(S)
+
+  // Given any sequence of words, the executable order-preserving filter and
+  // the independently defined reference filter agree.  This proof uses the
+  // counter-equivalence claim above and induction on WS.
+  claim filterWords(WS:Words, N:Int)
+     => specFilterWords(WS, N)
+
+  // Universal functional-correctness claim.  S remains an arbitrary string;
+  // the prompt assumption is represented by the documented semantic domain,
+  // while N's natural-number precondition is explicit.
+  claim
+    <k>
+      Module(
+        FuncDef("select_words", Params("s", "n"),
+          CellVars("n"), FreeVars(.Strings),
+          Expr(
+            Str(
+              "Return, in input order, words containing exactly n consonants."))
+          Return(
+            ListComp(Name("word"),
+              CompFor(
+                Name("word"),
+                Call(Attribute(Name("s"), "split"), .Exprs),
+                Compare(
+                  Call(
+                    Name("len"),
+                    ListComp(Name("letter"),
+                      CompFor(
+                        Name("letter"),
+                        Name("word"),
+                        Compare(
+                          Call(
+                            Attribute(Name("letter"), "lower"), .Exprs),
+                          CmpOp("not in", Str("aeiou")))))),
+                  CmpOp("==", Name("n"))))))))
+      => .K
+    </k>
+    <inputS> S:String </inputS>
+    <inputN> N:Int </inputN>
+    <result> noResult => selectWordsSpec(S, N) </result>
+    requires N >=Int 0
+
+  // Concrete regression claims cover every example in the original prompt,
+  // plus the required empty-input behavior.
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "Mary had a little lamb" </inputS>
+    <inputN> 4 </inputN>
+    <result> noResult => pyList(WCons("little", .Words)) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "Mary had a little lamb" </inputS>
+    <inputN> 3 </inputN>
+    <result> noResult
+          => pyList(WCons("Mary", WCons("lamb", .Words))) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "simple white space" </inputS>
+    <inputN> 2 </inputN>
+    <result> noResult => pyList(.Words) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "Hello world" </inputS>
+    <inputN> 4 </inputN>
+    <result> noResult => pyList(WCons("world", .Words)) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "Uncle sam" </inputS>
+    <inputN> 3 </inputN>
+    <result> noResult => pyList(WCons("Uncle", .Words)) </result>
+
+  claim
+    <k> Module(
+      FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(.Strings),
+        Expr(Str("Return, in input order, words containing exactly n consonants."))
+        Return(ListComp(Name("word"),
+          CompFor(Name("word"), Call(Attribute(Name("s"), "split"), .Exprs),
+            Compare(Call(Name("len"), ListComp(Name("letter"),
+              CompFor(Name("letter"), Name("word"),
+                Compare(Call(Attribute(Name("letter"), "lower"), .Exprs),
+                  CmpOp("not in", Str("aeiou")))))),
+              CmpOp("==", Name("n")))))))) => .K </k>
+    <inputS> "" </inputS>
+    <inputN> 0 </inputN>
+    <result> noResult => pyList(.Words) </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0d0288e5733cd2ec285eaa1573037a3f2f61310f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,37 @@
+// The contract is stated independently of the AST evaluator.  It says:
+// split into words, retain exactly those whose mathematical consonant count
+// equals N, and retain their order.
+
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Int ::= specCountConsonants(String) [function]
+  syntax Words ::= specFilterWords(Words, Int) [function]
+  syntax PyValue ::= selectWordsSpec(String, Int) [function]
+
+  rule specCountConsonants("") => 0
+  rule specCountConsonants(S)
+       => specCountConsonants(substrString(S, 1, lengthString(S)))
+    requires S =/=String ""
+     andBool findString(
+               "aeiouAEIOU", substrString(S, 0, 1), 0) >=Int 0
+  rule specCountConsonants(S)
+       => 1 +Int specCountConsonants(
+                     substrString(S, 1, lengthString(S)))
+    requires S =/=String ""
+     andBool findString(
+               "aeiouAEIOU", substrString(S, 0, 1), 0) ==Int -1
+
+  rule specFilterWords(.Words, _) => .Words
+  rule specFilterWords(WCons(W, WS), N)
+       => WCons(W, specFilterWords(WS, N))
+    requires specCountConsonants(W) ==Int N
+  rule specFilterWords(WCons(W, WS), N)
+       => specFilterWords(WS, N)
+    requires specCountConsonants(W) =/=Int N
+
+  rule selectWordsSpec(S, N)
+       => pyList(specFilterWords(words(S), N))
+endmodule

apply patch
patch: completed
/workspace/spec.k
/workspace/verification.k
