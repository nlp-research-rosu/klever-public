+  syntax Expr
+  syntax Exprs    ::= List{Expr, ","}
+  syntax Strings  ::= List{String, ","}
+  syntax CmpOp
+  syntax CmpOps   ::= List{CmpOp, ","}
+  syntax CompFor
+  syntax CompFors ::= List{CompFor, ""}
+
+  syntax Module ::= "Module" "(" Stmts ")"
+
+  syntax Stmt ::= "FuncDef" "(" String ","
+                              "Params" "(" Strings ")" ","
