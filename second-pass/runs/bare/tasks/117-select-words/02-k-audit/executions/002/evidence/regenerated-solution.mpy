Module(
  FuncDef("select_words", Params("s", "n"), CellVars("n"), FreeVars(),
    Expr(
      Str(
        "Return, in input order, words containing exactly n consonants."))
    Return(
      ListComp(Name("word"),
        CompFor(
          Name("word"),
          Call(Attribute(Name("s"), "split"), ),
          Compare(
            Call(
              Name("len"),
              ListComp(Name("letter"),
                CompFor(
                  Name("letter"),
                  Name("word"),
                  Compare(
                    Call(Attribute(Name("letter"), "lower"), ),
                    CmpOp("not in", Str("aeiou")))))),
            CmpOp("==", Name("n"))))))))
