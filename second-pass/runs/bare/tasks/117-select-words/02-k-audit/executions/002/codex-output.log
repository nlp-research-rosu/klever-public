+replacements = {
+    "module SPEC-CLAIM-2": "module SPEC-VACUITY",
+    '<inputS> "Mary had a little lamb" </inputS>': '<inputS> "b" </inputS>',
+    "<inputN> 4 </inputN>": "<inputN> 1 </inputN>",
