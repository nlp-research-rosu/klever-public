from pathlib import Path
from hashlib import sha256

def variants(root):
 root=Path(root)
 fs=sorted(p for p in root.rglob('*') if p.is_file())
 vals={}
 for name in ['path0content','pathcontent','pathnlcontent','content','sha256sumtext','path0digestraw','path0digesthex0','relpath_only']:
  h=sha256()
  for p in fs:
   rel=p.relative_to(root).as_posix().encode(); b=p.read_bytes(); d=sha256(b).digest(); x=sha256(b).hexdigest().encode()
   if name=='path0content': h.update(rel+b'\\0'+b)
   elif name=='pathcontent': h.update(rel+b)
   elif name=='pathnlcontent': h.update(rel+b'\\n'+b)
   elif name=='content': h.update(b)
   elif name=='sha256sumtext': h.update(x+b'  '+rel+b'\\n')
   elif name=='path0digestraw': h.update(rel+b'\\0'+d)
   elif name=='path0digesthex0': h.update(rel+b'\\0'+x+b'\\0')
   elif name=='relpath_only': h.update(rel+b'\\n')
  vals[name]=h.hexdigest()
 return vals
for root in ['/candidate','/generation-evidence/codex-trace']:
 print(root)
 for k,v in variants(root).items(): print(k,v)
