+        "  imports VERIFICATION",
+        "",
+        *claim,
+        "endmodule",
+        "",
+    ]
+    path = SCRATCH / f"spec-claim-{number}.k"
+    path.write_text("\n".join(output))
+    print(number, module, path, f"{len(claim)} claim-lines")
