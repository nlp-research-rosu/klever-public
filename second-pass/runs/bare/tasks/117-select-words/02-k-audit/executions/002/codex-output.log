     1	# canonical.py — the UNMODIFIED HumanEval/117 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: select_words
     4	
     5	
     6	def select_words(s, n):
     7	    """Given a string s and a natural number n, you have been tasked to implement 
     8	    a function that returns a list of all words from string s that contain exactly 
     9	    n consonants, in order these words appear in the string s.
    10	    If the string s is empty then the function should return an empty list.
    11	    Note: you may assume the input string contains only letters and spaces.
    12	    Examples:
    13	    select_words("Mary had a little lamb", 4) ==> ["little"]
    14	    select_words("Mary had a little lamb", 3) ==> ["Mary", "lamb"]
    15	    select_words("simple white space", 2) ==> []
    16	    select_words("Hello world", 4) ==> ["world"]
    17	    select_words("Uncle sam", 3) ==> ["Uncle"]
    18	    """
    19	    result = []
    20	    for word in s.split():
    21	        n_consonants = 0
    22	        for i in range(0, len(word)):
    23	            if word[i].lower() not in ["a","e","i","o","u"]:
    24	                n_consonants += 1 
    25	        if n_consonants == n:
    26	            result.append(word)
    27	    return result
    28	

