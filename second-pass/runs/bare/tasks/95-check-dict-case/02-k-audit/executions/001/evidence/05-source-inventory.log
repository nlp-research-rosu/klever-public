     1	requires "semantic.k"
     2	requires "program.k"
     3	
     4	module VERIFICATION
     5	  imports MPY
     6	  imports SOLUTION-PROGRAM
     7	
     8	  // Independent, declarative reading of the prompt.  The implementation is
     9	  // correct exactly when its result agrees with contract(INPUT).
    10	  syntax Bool ::= contract(Value) [function]
    11	                | allStringKeys(Values) [function]
    12	                | allLowerKeys(Values) [function]
    13	                | allUpperKeys(Values) [function]
    14	                | lowerKey(Value) [function, total]
    15	                | upperKey(Value) [function, total]
    16	
    17	  rule contract(DictVal()) => false
    18	  rule contract(DictVal(KEYS))
    19	    => allStringKeys(KEYS)
    20	       andBool (allLowerKeys(KEYS) orBool allUpperKeys(KEYS))
    21	
    22	  rule allStringKeys(V:Value VS:Values)
    23	    => pyIsString(V) andBool allStringKeys(VS)
    24	  rule allStringKeys(V:Value) => pyIsString(V)
    25	
    26	  rule allLowerKeys(V:Value VS:Values)
    27	    => lowerKey(V) andBool allLowerKeys(VS)
    28	  rule allLowerKeys(V:Value) => lowerKey(V)
    29	
    30	  rule allUpperKeys(V:Value VS:Values)
    31	    => upperKey(V) andBool allUpperKeys(VS)
    32	  rule allUpperKeys(V:Value) => upperKey(V)
    33	
    34	  rule lowerKey(StrVal(S)) => pyIsLower(StrVal(S))
    35	  rule lowerKey(IntVal(_)) => false
    36	  rule lowerKey(BoolVal(_)) => false
    37	  rule lowerKey(DictVal(_)) => false
    38	  rule lowerKey(DictVal()) => false
    39	  rule lowerKey(NoneVal) => false
    40	
    41	  rule upperKey(StrVal(S)) => pyIsUpper(StrVal(S))
    42	  rule upperKey(IntVal(_)) => false
    43	  rule upperKey(BoolVal(_)) => false
    44	  rule upperKey(DictVal(_)) => false
    45	  rule upperKey(DictVal()) => false
    46	  rule upperKey(NoneVal) => false
    47	endmodule
