===== semantic.k (numbered source) =====
     1	// A small, task-oriented executable semantics for the exact constructor
     2	// language emitted by py2mpy.py.  The semantics below is not a translation of
     3	// the answer: it evaluates names, assignment, conditionals, for loops,
     4	// returns, Boolean operations, calls, dictionaries, and Python's relevant
     5	// string predicates.
     6	
     7	module MPY-SYNTAX
     8	  imports BOOL-SYNTAX
     9	  imports INT-SYNTAX
    10	  imports STRING-SYNTAX
    11	
    12	  syntax PyStmt  ::= "Module" "(" PyStmts ")"
    13	                   | "FuncDef" "(" String "," Params "," PyStmts ")"
    14	                   | "Assign" "(" PyExpr "," PyExpr ")"
    15	                   | "If" "(" PyExpr "," PyStmts "," PyStmts ")"
    16	                   | "If" "(" PyExpr "," PyStmts "," ")" [symbol(IfNoElse)]
    17	                   | "For" "(" PyExpr "," PyExpr "," PyStmts ")"
    18	                   | "Return" "(" PyExpr ")"
    19	  syntax PyStmts ::= PyStmt
    20	                   | PyStmt PyStmts
    21	
    22	  syntax Params   ::= "Params" "(" Strings ")"
    23	  syntax Strings  ::= NeList{String, ","}
    24	
    25	  syntax PyExpr   ::= "Name" "(" String ")"
    26	                   | "Bool" "(" Bool ")"
    27	                   | "UnaryOp" "(" String "," PyExpr ")"
    28	                   | "BoolOp" "(" String "," PyExprs ")"
    29	                   | "Call" "(" PyExpr "," PyExprs ")"
    30	                   | "Call" "(" PyExpr "," ")" [symbol(CallNoArgs)]
    31	                   | "Attribute" "(" PyExpr "," String ")"
    32	  syntax PyExprs  ::= NeList{PyExpr, ","}
    33	endmodule
    34	
    35	module MPY-VALUES
    36	  imports BOOL
    37	  imports INT
    38	  imports STRING
    39	
    40	  // DictVal records dictionary keys in iteration order.  Values are omitted
    41	  // because this task never observes them.  Repeated keys are harmless for
    42	  // the property, while a real Python dictionary presents only the last one.
    43	  syntax Value  ::= "NoneVal"
    44	                  | "BoolVal" "(" Bool ")"
    45	                  | "StrVal" "(" String ")"
    46	                  | "IntVal" "(" Int ")"
    47	                  | "DictVal" "(" ")" [symbol(EmptyDictVal)]
    48	                  | "DictVal" "(" Values ")"
    49	  syntax Values ::= Value
    50	                  | Value Values
    51	endmodule
    52	
    53	module MPY
    54	  imports MPY-SYNTAX
    55	  imports MPY-VALUES
    56	  imports MAP
    57	
    58	  configuration
    59	    <task>
    60	      <k> $PGM:PyStmt </k>
    61	      <input> $INPUT:Value </input>
    62	      <env> .Map </env>
    63	      <result> NoneVal </result>
    64	    </task>
    65	
    66	  // Enter the requested top-level function with one fresh local frame.
    67	  rule <k> Module(FuncDef("check_dict_case", Params("dict"), BODY))
    68	        => BODY ...</k>
    69	       <input> ARG </input>
    70	       <env> .Map => "dict" |-> ARG </env>
    71	
    72	  // Statement-list scheduling.
    73	  rule <k> (S:PyStmt REST:PyStmts) => S ~> REST ...</k>
    74	
    75	  syntax KItem ::= eval(PyExpr)
    76	                 | assignTo(String)
    77	                 | choose(PyStmts, PyStmts)
    78	                 | chooseNoElse(PyStmts)
    79	                 | startFor(String, PyStmts)
    80	                 | loop(String, Values, PyStmts)
    81	                 | bind(String, Value)
    82	                 | "logicalNot"
    83	                 | logicalOr(PyExpr)
    84	                 | "returnValue"
    85	
    86	  // Statements evaluate their subexpressions before applying effects.
    87	  rule <k> Assign(Name(X), E) => eval(E) ~> assignTo(X) ...</k>
    88	  rule <k> V:Value ~> assignTo(X) => .K ...</k>
    89	       <env> ENV => ENV [ X <- V ] </env>
    90	
    91	  rule <k> If(COND, THEN, ELSE) => eval(COND) ~> choose(THEN, ELSE) ...</k>
    92	  rule <k> BoolVal(true)  ~> choose(THEN, _) => THEN ...</k>
    93	  rule <k> BoolVal(false) ~> choose(_, ELSE) => ELSE ...</k>
    94	  rule <k> If(COND, THEN, ) => eval(COND) ~> chooseNoElse(THEN) ...</k>
    95	  rule <k> BoolVal(true)  ~> chooseNoElse(THEN) => THEN ...</k>
    96	  rule <k> BoolVal(false) ~> chooseNoElse(_) => .K ...</k>
    97	
    98	  rule <k> For(Name(X), ITER, BODY) => eval(ITER) ~> startFor(X, BODY) ...</k>
    99	  rule <k> DictVal() ~> startFor(_, _) => .K ...</k>
   100	  rule <k> DictVal(KEYS) ~> startFor(X, BODY) => loop(X, KEYS, BODY) ...</k>
   101	  rule <k> loop(X, (V:Value VS:Values), BODY)
   102	        => bind(X, V) ~> BODY ~> loop(X, VS, BODY) ...</k>
   103	  rule <k> loop(X, V:Value, BODY) => bind(X, V) ~> BODY ...</k>
   104	  rule <k> bind(X, V) => .K ...</k>
   105	       <env> ENV => ENV [ X <- V ] </env>
   106	
   107	  rule <k> Return(E) => eval(E) ~> returnValue ...</k>
   108	  rule <k> V:Value ~> returnValue ~> _REST => .K </k>
   109	       <env> _ => .Map </env>
   110	       <result> _ => V </result>
   111	
   112	  // Literal and local-name expression evaluation.
   113	  rule <k> eval(Bool(B)) => BoolVal(B) ...</k>
   114	  rule <k> eval(Name(X)) => V ...</k>
   115	       <env>... X |-> V ...</env>
   116	
   117	  // Python truthiness needed by `not dict`, plus ordinary Boolean negation.
   118	  rule <k> eval(UnaryOp("not", E)) => eval(E) ~> logicalNot ...</k>
   119	  rule <k> BoolVal(B) ~> logicalNot => BoolVal(notBool B) ...</k>
   120	  rule <k> DictVal() ~> logicalNot => BoolVal(true) ...</k>
   121	  rule <k> DictVal(_V:Value _VS:Values) ~> logicalNot => BoolVal(false) ...</k>
   122	  rule <k> DictVal(_V:Value) ~> logicalNot => BoolVal(false) ...</k>
   123	
   124	  // The solution has a two-operand `or`; this is short-circuit evaluation.
   125	  rule <k> eval(BoolOp("or", E1, E2)) => eval(E1) ~> logicalOr(E2) ...</k>
   126	  rule <k> BoolVal(true) ~> logicalOr(_) => BoolVal(true) ...</k>
   127	  rule <k> BoolVal(false) ~> logicalOr(E) => eval(E) ...</k>
   128	
   129	  // Built-in calls used by the source program.  Directly reading the receiver
   130	  // from the environment preserves the evaluation behavior of these pure,
   131	  // zero-argument string methods.
   132	  rule <k> eval(Call(Name("isinstance"), Name(X), Name("str")))
   133	        => BoolVal(pyIsString(V)) ...</k>
   134	       <env>... X |-> V ...</env>
   135	
   136	  rule <k> eval(Call(Attribute(Name(X), "islower"), ))
   137	        => BoolVal(pyIsLower(V)) ...</k>
   138	       <env>... X |-> V ...</env>
   139	  rule <k> eval(Call(Attribute(Name(X), "isupper"), ))
   140	        => BoolVal(pyIsUpper(V)) ...</k>
   141	       <env>... X |-> V ...</env>
   142	
   143	  syntax Bool ::= pyIsString(Value) [function, total]
   144	  rule pyIsString(StrVal(_)) => true
   145	  rule pyIsString(IntVal(_)) => false
   146	  rule pyIsString(BoolVal(_)) => false
   147	  rule pyIsString(DictVal(_)) => false
   148	  rule pyIsString(DictVal()) => false
   149	  rule pyIsString(NoneVal) => false
   150	
   151	  // CPython's islower/isupper criterion is: at least one cased character and
   152	  // every cased character has the requested case.  The proof model classifies
   153	  // ASCII letters explicitly; all other code points are uncased.  This is the
   154	  // relevant string domain for the HumanEval prompt and avoids K's deprecated
   155	  // STRING.category hook, which is unavailable to the proof backend.
   156	  syntax Bool ::= pyIsLower(Value) [function]
   157	                | pyIsUpper(Value) [function]
   158	                | lowerScan(String, Int, Bool) [function]
   159	                | upperScan(String, Int, Bool) [function]
   160	
   161	  rule pyIsLower(StrVal(S)) => lowerScan(S, 0, false)
   162	  rule pyIsUpper(StrVal(S)) => upperScan(S, 0, false)
   163	
   164	  rule lowerScan(S, I, SEEN) => SEEN
   165	    requires I >=Int lengthString(S)
   166	  rule lowerScan(S, I, _) => false
   167	    requires I <Int lengthString(S)
   168	     andBool ordChar(substrString(S, I, I +Int 1)) >=Int 65
   169	     andBool ordChar(substrString(S, I, I +Int 1)) <=Int 90
   170	  rule lowerScan(S, I, _) => lowerScan(S, I +Int 1, true)
   171	    requires I <Int lengthString(S)
   172	     andBool ordChar(substrString(S, I, I +Int 1)) >=Int 97
   173	     andBool ordChar(substrString(S, I, I +Int 1)) <=Int 122
   174	  rule lowerScan(S, I, SEEN) => lowerScan(S, I +Int 1, SEEN)
   175	    requires I <Int lengthString(S)
   176	     andBool (ordChar(substrString(S, I, I +Int 1)) <Int 65
   177	       orBool ordChar(substrString(S, I, I +Int 1)) >Int 122
   178	       orBool (ordChar(substrString(S, I, I +Int 1)) >Int 90
   179	         andBool ordChar(substrString(S, I, I +Int 1)) <Int 97))
   180	
   181	  rule upperScan(S, I, SEEN) => SEEN
   182	    requires I >=Int lengthString(S)
   183	  rule upperScan(S, I, _) => false
   184	    requires I <Int lengthString(S)
   185	     andBool ordChar(substrString(S, I, I +Int 1)) >=Int 97
   186	     andBool ordChar(substrString(S, I, I +Int 1)) <=Int 122
   187	  rule upperScan(S, I, _) => upperScan(S, I +Int 1, true)
   188	    requires I <Int lengthString(S)
   189	     andBool ordChar(substrString(S, I, I +Int 1)) >=Int 65
   190	     andBool ordChar(substrString(S, I, I +Int 1)) <=Int 90
   191	  rule upperScan(S, I, SEEN) => upperScan(S, I +Int 1, SEEN)
   192	    requires I <Int lengthString(S)
   193	     andBool (ordChar(substrString(S, I, I +Int 1)) <Int 65
   194	       orBool ordChar(substrString(S, I, I +Int 1)) >Int 122
   195	       orBool (ordChar(substrString(S, I, I +Int 1)) >Int 90
   196	         andBool ordChar(substrString(S, I, I +Int 1)) <Int 97))
   197	endmodule
===== program.k (numbered source) =====
     1	requires "semantic.k"
     2	
     3	module SOLUTION-PROGRAM
     4	  imports MPY-SYNTAX
     5	
     6	  syntax PyStmt ::= "solutionProgram" [function]
     7	  rule solutionProgram => Module(
     8	    FuncDef("check_dict_case", Params("dict"),
     9	      If(UnaryOp("not", Name("dict")),
    10	        Return(Bool(false)),
    11	        )
    12	      Assign(Name("lower"), Bool(true))
    13	      Assign(Name("upper"), Bool(true))
    14	      For(Name("key"), Name("dict"),
    15	        If(UnaryOp("not", Call(Name("isinstance"), Name("key"), Name("str"))),
    16	          Return(Bool(false)),
    17	          )
    18	        If(UnaryOp("not", Call(Attribute(Name("key"), "islower"), )),
    19	          Assign(Name("lower"), Bool(false)),
    20	          )
    21	        If(UnaryOp("not", Call(Attribute(Name("key"), "isupper"), )),
    22	          Assign(Name("upper"), Bool(false)),
    23	          ))
    24	      Return(BoolOp("or", Name("lower"), Name("upper")))))
    25	endmodule
