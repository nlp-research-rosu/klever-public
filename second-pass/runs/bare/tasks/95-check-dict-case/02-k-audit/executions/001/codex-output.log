+echo "===== priority/simplification/owise scan ====="
+rg -n '\b(priority|priorities|simplification|owise)\b' \
+  "$scratch/semantic.k" "$scratch/program.k" \
+  "$scratch/verification.k" "$scratch/spec.k" || true
