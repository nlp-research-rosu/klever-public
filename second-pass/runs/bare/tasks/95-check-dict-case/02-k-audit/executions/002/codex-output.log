+printf '%s\n' \
+  'COMMAND: kprove spec-vacuity-review.k --definition verification-fresh-kompiled --spec-module SPEC-VACUITY-REVIEW --dry-run'
+(
+  cd "$scratch" || exit 1
+  kprove spec-vacuity-review.k \
