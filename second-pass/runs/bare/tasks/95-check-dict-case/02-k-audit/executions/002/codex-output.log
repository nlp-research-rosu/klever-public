FILE /candidate/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	export PYTHONDONTWRITEBYTECODE=1
     4	
     5	cd "$(dirname "$0")"
     6	
     7	program_tmp="program.k.tmp"
     8	run_tmp="krun-result.tmp"
     9	proof_tmp="kprove-result.tmp"
    10	trap 'rm -f "$program_tmp" "$run_tmp" "$proof_tmp"' EXIT
    11	
    12	# Recreate the pure AST transliteration required by the task.
    13	python3 py2mpy.py solution.py > solution.mpy
    14	
    15	# Tie the proof constant mechanically to that exact transliteration.  K source
    16	# files contain modules, so the bare term is wrapped in a generated module.
    17	{
    18	  printf '%s\n\n' 'requires "semantic.k"'
    19	  printf '%s\n' 'module SOLUTION-PROGRAM'
    20	  printf '%s\n\n' '  imports MPY-SYNTAX'
    21	  printf '%s\n' '  syntax PyStmt ::= "solutionProgram" [function]'
    22	  printf '%s' '  rule solutionProgram => '
    23	  sed '2,$s/^/  /' solution.mpy
    24	  printf '%s\n' 'endmodule'
    25	} > "$program_tmp"
    26	mv "$program_tmp" program.k
    27	
    28	# A small CPython smoke test also guards the submitted implementation itself.
    29	python3 - <<'PY'
    30	from solution import check_dict_case
    31	
    32	cases = [
    33	    ({}, False),
    34	    ({"a": "apple", "b": "banana"}, True),
    35	    ({"a": "apple", "A": "banana", "B": "banana"}, False),
    36	    ({"a": "apple", 8: "banana"}, False),
    37	    ({"Name": "John", "Age": "36", "City": "Houston"}, False),
    38	    ({"STATE": "NC", "ZIP": "12345"}, True),
    39	    ({"abc-123": 0, "z9": 0}, True),
    40	    ({"123": 0}, False),
    41	]
    42	for dictionary, expected in cases:
    43	    assert check_dict_case(dictionary) is expected
    44	print("CPython smoke tests: passed")
    45	PY
    46	
    47	# Compile the semantics used by both concrete execution and symbolic proof.
    48	kompile verification.k \
    49	  --main-module VERIFICATION \
    50	  --syntax-module VERIFICATION \
    51	  --backend haskell
    52	
    53	check_krun() {
    54	  local input="$1"
    55	  local expected="$2"
    56	  krun solution.mpy \
    57	    --definition verification-kompiled \
    58	    "-cINPUT=$input" \
    59	    --pattern '<result> R:Value </result>' \
    60	    --output pretty > "$run_tmp"
    61	  grep -Fq "BoolVal ( $expected )" "$run_tmp"
    62	}
    63	
    64	# Exercise every example class through the actual solution.mpy parser.
    65	check_krun 'DictVal()' false
    66	check_krun 'DictVal(StrVal("a") StrVal("b"))' true
    67	check_krun 'DictVal(StrVal("a") StrVal("A") StrVal("B"))' false
    68	check_krun 'DictVal(StrVal("a") IntVal(8))' false
    69	check_krun 'DictVal(StrVal("Name") StrVal("Age") StrVal("City"))' false
    70	check_krun 'DictVal(StrVal("STATE") StrVal("ZIP"))' true
    71	echo "krun examples: passed"
    72	
    73	# This is the required positive target-proof command.  pipefail preserves the
    74	# kprove exit status, while the final grep insists on its exact success term.
    75	kprove spec.k --definition verification-kompiled | tee "$proof_tmp"
    76	grep -qx '#Top' "$proof_tmp"

