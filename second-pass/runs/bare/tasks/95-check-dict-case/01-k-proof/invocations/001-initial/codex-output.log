+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("abc-123") StrVal("z9")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(true) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("ABC-123") StrVal("Z9")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(true) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("123")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(false) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("aA")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(false) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(BoolVal(true)) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(false) </result>
+    </task>
+endmodule
