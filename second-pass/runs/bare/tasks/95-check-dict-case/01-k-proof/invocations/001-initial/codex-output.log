diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..15da3b6723e63fd93b17d867d851867719806c2f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,15 @@
+def check_dict_case(dict):
+    if not dict:
+        return False
+
+    lower = True
+    upper = True
+    for key in dict:
+        if not isinstance(key, str):
+            return False
+        if not key.islower():
+            lower = False
+        if not key.isupper():
+            upper = False
+
+    return lower or upper
