+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The six aggregate partitions below are exhaustive for the contract:
+  // empty; non-string; all-lower; all-upper; mixed lower/upper; and a string
+  // that is neither lower nor upper.  Further claims instantiate every prompt
+  // example and exercise uncased characters.
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal() </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal())) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("a") StrVal("b")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("a") StrVal("b")))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("a") StrVal("A") StrVal("B")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("a") StrVal("A") StrVal("B")))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("a") IntVal(8)) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("a") IntVal(8)))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("Name") StrVal("Age") StrVal("City")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("Name") StrVal("Age") StrVal("City")))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("STATE") StrVal("ZIP")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("STATE") StrVal("ZIP")))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("abc-123") StrVal("z9")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("abc-123") StrVal("z9")))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("ABC-123") StrVal("Z9")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("ABC-123") StrVal("Z9")))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("123")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("123")))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(StrVal("aA")) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(StrVal("aA")))) </result>
+    </task>
+
+  claim
+    <task>
+      <k> solutionProgram => .K </k>
+      <input> DictVal(BoolVal(true)) </input>
+      <env> .Map </env>
+      <result> NoneVal => BoolVal(contract(DictVal(BoolVal(true)))) </result>
+    </task>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..87377ae5bebf6640b9c3b9cd1986ef45acbacc2a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,47 @@
+requires "semantic.k"
+requires "program.k"
+
+module VERIFICATION
+  imports MPY
+  imports SOLUTION-PROGRAM
+
+  // Independent, declarative reading of the prompt.  The implementation is
+  // correct exactly when its result agrees with contract(INPUT).
+  syntax Bool ::= contract(Value) [function]
+                | allStringKeys(Values) [function]
+                | allLowerKeys(Values) [function]
+                | allUpperKeys(Values) [function]
+                | lowerKey(Value) [function, total]
+                | upperKey(Value) [function, total]
+
+  rule contract(DictVal()) => false
+  rule contract(DictVal(KEYS))
+    => allStringKeys(KEYS)
+       andBool (allLowerKeys(KEYS) orBool allUpperKeys(KEYS))
+
+  rule allStringKeys(V:Value VS:Values)
+    => pyIsString(V) andBool allStringKeys(VS)
+  rule allStringKeys(V:Value) => pyIsString(V)
+
+  rule allLowerKeys(V:Value VS:Values)
+    => lowerKey(V) andBool allLowerKeys(VS)
+  rule allLowerKeys(V:Value) => lowerKey(V)
+
+  rule allUpperKeys(V:Value VS:Values)
+    => upperKey(V) andBool allUpperKeys(VS)
+  rule allUpperKeys(V:Value) => upperKey(V)
+
+  rule lowerKey(StrVal(S)) => pyIsLower(StrVal(S))
+  rule lowerKey(IntVal(_)) => false
+  rule lowerKey(BoolVal(_)) => false
+  rule lowerKey(DictVal(_)) => false
+  rule lowerKey(DictVal()) => false
+  rule lowerKey(NoneVal) => false
+
+  rule upperKey(StrVal(S)) => pyIsUpper(StrVal(S))
+  rule upperKey(IntVal(_)) => false
+  rule upperKey(BoolVal(_)) => false
+  rule upperKey(DictVal(_)) => false
+  rule upperKey(DictVal()) => false
+  rule upperKey(NoneVal) => false
+endmodule

