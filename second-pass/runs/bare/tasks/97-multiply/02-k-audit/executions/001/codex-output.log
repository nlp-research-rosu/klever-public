index 0000000000000000000000000000000000000000..3ebf87dc48a5d5305c4daf5761ef3f45ad97dd52
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LABEL COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_label=$1
+shift
+audit_log="/audit-output/evidence/${audit_label}.log"
+
+{
+  printf 'UTC_START: '
+  date -u '+%Y-%m-%dT%H:%M:%SZ'
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+  printf 'UTC_END: '
+  date -u '+%Y-%m-%dT%H:%M:%SZ'
+  exit "$audit_status"
+} 2>&1 | tee "$audit_log"
+
+exit "${PIPESTATUS[0]}"
diff --git a/evidence/spec-literal-program.k b/evidence/spec-literal-program.k
new file mode 100644
index 0000000000000000000000000000000000000000..400a0bdc1fb5d4b8271841a1b45bd1fb33621fff
--- /dev/null
+++ b/evidence/spec-literal-program.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module AUDIT-LITERAL-PROGRAM-SPEC
+  imports VERIFICATION
+
+  // Reviewer-authored pinning check: the complete constructor term below is
+  // byte-for-byte the AST represented by submitted solution.mpy, with neither
+  // multiplyProgram nor multiplyBody used in the entry or destination.
+  claim
+    <task>
+      <k>
+        Module(
+          FuncDef("multiply", Params("a", "b"),
+            If(Compare(Name("a"), CmpOp("<", Int(0))),
+              Assign(Name("a"), UnaryOp("-", Name("a"))),
+              .Stmts)
+            If(Compare(Name("b"), CmpOp("<", Int(0))),
+              Assign(Name("b"), UnaryOp("-", Name("b"))),
+              .Stmts)
+            Return(
+              BinOp(
+                "*",
+                BinOp("%", Name("a"), Int(10)),
+                BinOp("%", Name("b"), Int(10))))))
+        ~> #invoke("multiply", A, B)
+        => .K
+      </k>
+      <env> .Map => ("a" |-> absInt(A)) ("b" |-> absInt(B)) </env>
+      <functions>
+        .Map =>
+          "multiply" |->
+            function("a", "b",
+              If(Compare(Name("a"), CmpOp("<", Int(0))),
+                Assign(Name("a"), UnaryOp("-", Name("a"))),
+                .Stmts)
+              If(Compare(Name("b"), CmpOp("<", Int(0))),
+                Assign(Name("b"), UnaryOp("-", Name("b"))),
+                .Stmts)
+              Return(
+                BinOp(
+                  "*",
+                  BinOp("%", Name("a"), Int(10)),
+                  BinOp("%", Name("b"), Int(10)))))
+      </functions>
+      <result>
+        noResult => unitDigit(A) *Int unitDigit(B)
+      </result>
+    </task>
+endmodule
