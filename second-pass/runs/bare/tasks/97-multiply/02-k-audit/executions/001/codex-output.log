custom_tool_call	exec	call_QH3w8XEEPjkHoptOgeoeMKNZ	const patch = "*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports SEMANTIC\n+\n+  // Closed constructor terms used by the specification.  The body is exactly\n+  // the tree in solution.mpy; keeping it as a macro makes proof states small\n+  // without adding any trusted execution rule.\n+  syntax Stmts ::= \"multiplyBody\" [klabel(multiplyBody)]\n+  rule multiplyBody =>\n+    If(Compare(Name(\"a\"), CmpOp(\"<\", Int(0))),\n+       Assign(Name(\"a\"), UnaryOp(\"-\", Name(\"a\"))), .Stmts)\n+    If(Compare(Name(\"b\"), CmpOp(\"<\", Int(0))),\n+       Assign(Name(\"b\"), UnaryOp(\"-\", Name(\"b\"))), .Stmts)\n+    Return(BinOp(\"*\",\n+                 BinOp(\"%\", Name(\"a\"), Int(10)),\n+                 BinOp(\"%\", Name(\"b\"), Int(10))))\n+    [macro]\n+\n+  syntax Program ::= \"multiplyProgram\" [klabel(multiplyProgram)]\n+  rule multiplyProgram =>\n+    Module(FuncDef(\"multiply\", Params(\"a\", \"b\"), multiplyBody))\n+    [macro]\n+\n+  // Mathematical definition of an integer's decimal unit digit.\n+  syntax Int ::= \"unitDigit\" \"(\" Int \")\" [function, total,\n+                                             klabel(unitDigit)]\n+  rule unitDigit(I) => absInt(I) %Int 10\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // For all mathematical integers, execution returns the product of the\n+  // non-negative decimal unit digits.  absInt makes the sign convention\n+  // explicit (in particular, unitDigit(-15) is 5).\n+  claim\n+    <task>\n+      <k> multiplyProgram ~> #invoke(\"multiply\", A, B) => .K </k>\n+      <env> .Map => (\"a\" |-> absInt(A)) (\"b\" |-> absInt(B)) </env>\n+      <functions>\n+        .Map => \"multiply\" |-> function(\"a\", \"b\", multiplyBody)\n+      </functions>\n+      <result>\n+        noResult => unitDigit(A) *Int unitDigit(B)\n+      </result>\n+    </task>\n+endmodule\n*** End Patch"; text(await tools.apply_patch(patch)); 
