klabel(noResult)] | Int\n+                      [symbol(function)]\n+  syntax Result ::= \"noResult\" [symbol(noResult)] | Int\n@@\n-                   [klabel(#invoke)]\n+                   [symbol(#invoke)]\n@@\n-                   [klabel(#if), strict(1)]\n+                   [symbol(#if), strict(1)]\n@@\n-                   [klabel(#assign), strict(2)]\n-                 | \"#return\" \"(\" Expr \")\" [klabel(#return), strict(1)]\n+                   [symbol(#assign), strict(2)]\n+                 | \"#return\" \"(\" Expr \")\" [symbol(#return), strict(1)]\n@@\n-                   [klabel(#lessThan), strict]\n+                   [symbol(#lessThan), strict]\n@@\n-                   [klabel(#unaryMinus), strict(1)]\n+                   [symbol(#unaryMinus), strict(1)]\n@@\n-                   [klabel(#modulo), strict]\n+                   [symbol(#modulo), strict]\n@@\n-                   [klabel(#multiply), strict]\n+                   [symbol(#multiply), strict]\n*** Update File: /work/verification.k\n@@\n-  syntax Stmts ::= \"multiplyBody\" [klabel(multiplyBody)]\n+  syntax Stmts ::= \"multiplyBody\" [symbol(multiplyBody)]\n@@\n-  syntax Program ::= \"multiplyProgram\" [klabel(multiplyProgram)]\n+  syntax Program ::= \"multiplyProgram\" [symbol(multiplyProgram)]\n@@\n-  syntax Int ::= \"unitDigit\" \"(\" Int \")\" [function, total,\n-                                             klabel(unitDigit)]\n+  syntax Int ::= \"unitDigit\" \"(\" Int \")\" [function, total,\n+                                             symbol(unitDigit)]\n*** Add File: /work/prove.sh\n+#!/usr/bin/env bash\n+set -euo pipefail\n+\n+# Recreate the constructor program with the fixed supplied translator.\n+python3 py2mpy.py solution.py > solution.mpy\n+\n+# Compile and concretely execute the handwritten operational semantics.\n+kompile semantic.k --backend haskell \\\n+  --main-module SEMANTIC --syntax-module MPY-SYNTAX\n+\n+run_case() {\n+  local a=\"$1\"\n+  local b=\"$2\"\n+  local expected=\"$3\"\n+  local actual\n+  actual=\"$(\n+    krun solution.mpy -cA=\"$a\" -cB=\"$b\" \\\n+      --definition semantic-kompiled \\\n+      | sed -n '/<result>/{n;s/ //gp;}'\n+  )\"\n+  test \"$actual\" = \"$expected\"\n+  printf 'krun multiply(%s, %s) = %s\\n' \"$a\" \"$b\" \"$actual\"\n+}\n+\n+run_case 148 412 16\n+run_case 19 28 72\n+run_case 2020 1851 0\n+run_case 14 -15 20\n+run_case -14 15 20\n+run_case -14 -15 20\n+\n+# Compile the proof extension and prove its universal all-integers claim.\n+kompile verification.k --backend haskell \\\n+  --main-module VERIFICATION --syntax-module MPY-SYNTAX\n+kprove spec.k --definition verification-kompiled --spec-module SPEC \\\n+  | tee kprove.out\n+grep -qx '#Top' kprove.out\n*** End Patch"; text(await tools.apply_patch(patch)); 
