message			[{"text": "The Python implementation and generated constructor tree are now fixed. I\u2019m moving into the K side with a task-specific AST syntax and operational semantics; the important proof connection will be that `krun` consumes `solution.mpy` directly, while the universal claims execute the same constructor-shaped function body under symbolic integer inputs.", "type": "output_text"}]
custom_tool_call	exec	call_CLvr2InQnotI31QJpXHeqiXl	const patch = "*** Begin Patch\n*** Add File: /work/semantic.k\n+requires \"domains.k\"\n+\n+module MPY-SYNTAX\n+  imports INT-SYNTAX\n+  imports BOOL-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  // The task-specific fragment emitted by py2mpy.py.  These are AST nodes,\n+  // not Python surface syntax; all of their meaning is defined below.\n+  syntax Program ::= \"Module\" \"(\" Stmts \")\" [klabel(Module)]\n+  syntax Stmts   ::= List{Stmt, \"\"}\n+\n+  syntax Params ::= \"Params\" \"(\" String \",\" String \")\" [klabel(Params)]\n+\n+  syntax Stmt ::= \"FuncDef\" \"(\" String \",\" Params \",\" Stmts \")\"\n+                  [klabel(FuncDef)]\n+                | \"If\" \"(\" Expr \",\" Stmts \",\" Stmts \")\" [klabel(If)]\n+                | \"Assign\" \"(\" Expr \",\" Expr \")\" [klabel(Assign)]\n+                | \"Return\" \"(\" Expr \")\" [klabel(Return)]\n+\n+  syntax Expr ::= \"Int\" \"(\" Int \")\" [klabel(IntLiteral)]\n+                | \"Name\" \"(\" String \")\" [klabel(Name)]\n+                | \"UnaryOp\" \"(\" String \",\" Expr \")\" [klabel(UnaryOp)]\n+                | \"BinOp\" \"(\" String \",\" Expr \",\" Expr \")\" [klabel(BinOp)]\n+                | \"Compare\" \"(\" Expr \",\" CmpOp \")\" [klabel(Compare)]\n+\n+  syntax CmpOp ::= \"CmpOp\" \"(\" String \",\" Expr \")\" [klabel(CmpOp)]\n+endmodule\n+\n+module SEMANTIC\n+  imports MPY-SYNTAX\n+  imports INT\n+  imports BOOL\n+  imports MAP\n+\n+  syntax Function ::= \"function\" \"(\" String \",\" String \",\" Stmts \")\"\n+                      [klabel(function)]\n+  syntax Result ::= \"noResult\" [klabel(noResult)] | Int\n+\n+  syntax KItem ::= \"#invoke\" \"(\" String \",\" Int \",\" Int \")\"\n+                   [klabel(#invoke)]\n+                 | \"#if\" \"(\" Expr \",\" Stmts \",\" Stmts \")\"\n+                   [klabel(#if), strict(1)]\n+                 | \"#assign\" \"(\" String \",\" Expr \")\"\n+                   [klabel(#assign), strict(2)]\n+                 | \"#return\" \"(\" Expr \")\" [klabel(#return), strict(1)]\n+                 | \"#lessThan\" \"(\" Expr \",\" Expr \")\"\n+                   [klabel(#lessThan), strict]\n+\n+  syntax KResult ::= Int | Bool\n+  syntax Expr ::= Int | Bool\n+\n+  configuration\n+    <task>\n+      <k> $PGM:Program ~> #invoke(\"multiply\", $A:Int, $B:Int) </k>\n+      <env> .Map </env>\n+      <functions> .Map </functions>\n+      <result> noResult </result>\n+    </task>\n+\n+  // Statement-list scheduling.\n+  rule Module(SS) => SS\n+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>\n+  rule .Stmts => .K\n+\n+  // Loading a definition records its formal parameters and untranslated body.\n+  rule <k> FuncDef(F, Params(P1, P2), BODY) => .K ... </k>\n+       <functions> FUNS => FUNS [ F <- function(P1, P2, BODY) ] </functions>\n+\n+  // The harness invokes the named, loaded function with two integer values.\n+  rule <k> #invoke(F, A, B) => BODY ... </k>\n+       <functions> ... F |-> function(P1, P2, BODY) ... </functions>\n+       <env> _ => (P1 |-> A) (P2 |-> B) </env>\n+\n+  // Expressions.\n+  rule IntLiteral(I) => I\n+  rule <k> Name(X) => I ... </k>\n+       <env> ... X |-> I:Int ... </env>\n+\n+  rule UnaryOp(\"-\", E) => #unaryMinus(E)\n+  syntax KItem ::= \"#unaryMinus\" \"(\" Expr \")\"\n+                   [klabel(#unaryMinus), strict(1)]\n+  rule #unaryMinus(I:Int) => -Int I\n+\n+  rule BinOp(\"%\", E1, E2) => #modulo(E1, E2)\n+  rule BinOp(\"*\", E1, E2) => #multiply(E1, E2)\n+  syntax KItem ::= \"#modulo\" \"(\" Expr \",\" Expr \")\"\n+                   [klabel(#modulo), strict]\n+                 | \"#multiply\" \"(\" Expr \",\" Expr \")\"\n+                   [klabel(#multiply), strict]\n+  rule #modulo(I1:Int, I2:Int) => I1 %Int I2\n+    requires I2 =/=Int 0\n+  rule #multiply(I1:Int, I2:Int) => I1 *Int I2\n+\n+  rule Compare(E1, CmpOp(\"<\", E2)) => #lessThan(E1, E2)\n+  rule #lessThan(I1:Int, I2:Int) => I1 <Int I2\n+\n+  // Statements.  Empty branches are genuine empty statement lists.\n+  rule If(E, THEN, ELSE) => #if(E, THEN, ELSE)\n+  rule #if(true,  THEN, _) => THEN\n+  rule #if(false, _, ELSE) => ELSE\n+\n+  rule Assign(Name(X), E) => #assign(X, E)\n+  rule <k> #assign(X, I:Int) => .K ... </k>\n+       <env> ENV => ENV [ X <- I ] </env>\n+\n+  // This task has no caller frame: return terminates the entry invocation and\n+  // publishes its integer value in the result cell.\n+  rule <k> #return(I:Int) ~> _REST => .K </k>\n+       <result> _ => I </result>\n+  rule Return(E) => #return(E)\n+endmodule\n*** End Patch"; text(await tools.apply_patch(patch)); 
