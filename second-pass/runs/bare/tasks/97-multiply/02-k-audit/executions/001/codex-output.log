    99	  rule If(E, THEN, ELSE) => #if(E, THEN, ELSE)
   100	  rule #if(true,  THEN, _) => THEN
   101	  rule #if(false, _, ELSE) => ELSE
   102	
   103	  rule Assign(Name(X), E) => #assign(X, E)
   104	  rule <k> #assign(X, I:Int) => .K ... </k>
   105	       <env> ENV => ENV [ X <- I ] </env>
   106	
   107	  // This task has no caller frame: return terminates the entry invocation and
   108	  // publishes its integer value in the result cell.
   109	  rule <k> #return(I:Int) ~> _REST => .K </k>
   110	       <result> _ => I </result>
   111	  rule Return(E) => #return(E)
   112	endmodule
--- verification.k ---
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Closed constructor terms used by the specification.  The body is exactly
     7	  // the tree in solution.mpy; the named abbreviation keeps proof states small
     8	  // and does not shortcut execution to a result.
     9	  syntax Stmts ::= "multiplyBody" [symbol(multiplyBody)]
    10	  rule multiplyBody =>
    11	    If(Compare(Name("a"), CmpOp("<", Int(0))),
    12	       Assign(Name("a"), UnaryOp("-", Name("a"))), .Stmts)
    13	    If(Compare(Name("b"), CmpOp("<", Int(0))),
    14	       Assign(Name("b"), UnaryOp("-", Name("b"))), .Stmts)
    15	    Return(BinOp("*",
    16	                 BinOp("%", Name("a"), Int(10)),
    17	                 BinOp("%", Name("b"), Int(10))))
    18	
    19	  syntax Program ::= "multiplyProgram" [symbol(multiplyProgram)]
    20	  rule multiplyProgram =>
    21	    Module(FuncDef("multiply", Params("a", "b"), multiplyBody))
    22	
    23	  // Mathematical definition of an integer's decimal unit digit.
    24	  syntax Int ::= "unitDigit" "(" Int ")" [function, total,
    25	                                             symbol(unitDigit)]
    26	  rule unitDigit(I) => absInt(I) %Int 10
    27	endmodule
--- spec.k ---
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // For all mathematical integers, execution returns the product of the
     7	  // non-negative decimal unit digits.  absInt makes the sign convention
     8	  // explicit (in particular, unitDigit(-15) is 5).
     9	  claim
    10	    <task>
    11	      <k> multiplyProgram ~> #invoke("multiply", A, B) => .K </k>
    12	      <env> .Map => ("a" |-> absInt(A)) ("b" |-> absInt(B)) </env>
    13	      <functions>
    14	        .Map => "multiply" |-> function("a", "b", multiplyBody)
    15	      </functions>
    16	      <result>
    17	        noResult => unitDigit(A) *Int unitDigit(B)
    18	      </result>
    19	    </task>
    20	endmodule
--- prove.sh ---
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Recreate the constructor program with the fixed supplied translator.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Compile and concretely execute the handwritten operational semantics.
     8	kompile semantic.k --backend haskell \
     9	  --main-module SEMANTIC --syntax-module MPY-SYNTAX
    10	
    11	run_case() {
    12	  local a="$1"
    13	  local b="$2"
    14	  local expected="$3"
    15	  local actual
    16	  actual="$(
    17	    krun solution.mpy -cA="$a" -cB="$b" \
    18	      --definition semantic-kompiled \
    19	      | sed -n '/<result>/{n;s/ //gp;}'
    20	  )"
    21	  test "$actual" = "$expected"
    22	  printf 'krun multiply(%s, %s) = %s\n' "$a" "$b" "$actual"
    23	}
    24	
    25	run_case 148 412 16
    26	run_case 19 28 72
    27	run_case 2020 1851 0
    28	run_case 14 -15 20
    29	run_case -14 15 20
    30	run_case -14 -15 20
    31	
    32	# Compile the proof extension and prove its universal all-integers claim.
    33	kompile verification.k --backend haskell \
    34	  --main-module VERIFICATION --syntax-module MPY-SYNTAX
    35	kprove spec.k --definition verification-kompiled --spec-module SPEC \
    36	  | tee kprove.out
    37	grep -qx '#Top' kprove.out

