diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6cad6918a11a41140d112acfb4e16241401af8e6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // For all mathematical integers, execution returns the product of the
+  // non-negative decimal unit digits.  absInt makes the sign convention
+  // explicit (in particular, unitDigit(-15) is 5).
+  claim
+    <task>
+      <k> multiplyProgram ~> #invoke("multiply", A, B) => .K </k>
+      <env> .Map => ("a" |-> absInt(A)) ("b" |-> absInt(B)) </env>
+      <functions>
+        .Map => "multiply" |-> function("a", "b", multiplyBody)
+      </functions>
+      <result>
+        noResult => unitDigit(A) *Int unitDigit(B)
+      </result>
+    </task>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..49ec831d9ad539a756940bd88836b57a9faf2db8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Closed constructor terms used by the specification.  The body is exactly
+  // the tree in solution.mpy; keeping it as a macro makes proof states small
+  // without adding any trusted execution rule.
+  syntax Stmts ::= "multiplyBody" [klabel(multiplyBody)]
+  rule multiplyBody =>
+    If(Compare(Name("a"), CmpOp("<", Int(0))),
+       Assign(Name("a"), UnaryOp("-", Name("a"))), .Stmts)
+    If(Compare(Name("b"), CmpOp("<", Int(0))),
+       Assign(Name("b"), UnaryOp("-", Name("b"))), .Stmts)
+    Return(BinOp("*",
+                 BinOp("%", Name("a"), Int(10)),
+                 BinOp("%", Name("b"), Int(10))))
+    [macro]
+
+  syntax Program ::= "multiplyProgram" [klabel(multiplyProgram)]
+  rule multiplyProgram =>
+    Module(FuncDef("multiply", Params("a", "b"), multiplyBody))
+    [macro]
+
+  // Mathematical definition of an integer's decimal unit digit.
+  syntax Int ::= "unitDigit" "(" Int ")" [function, total,
+                                             klabel(unitDigit)]
+  rule unitDigit(I) => absInt(I) %Int 10
+endmodule

