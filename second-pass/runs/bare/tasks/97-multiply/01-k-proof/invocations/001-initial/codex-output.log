+  rule BinOp("%", E1, E2) => #modulo(E1, E2)
+  rule BinOp("*", E1, E2) => #multiply(E1, E2)
+  syntax KItem ::= "#modulo" "(" Expr "," Expr ")"
+                   [symbol(#modulo), strict]
+                 | "#multiply" "(" Expr "," Expr ")"
+                   [symbol(#multiply), strict]
+  rule #modulo(I1:Int, I2:Int) => I1 %Int I2
