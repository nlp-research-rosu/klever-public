codex
The universal symbolic claim has closed with `#Top` and exit code 0. It proves a single all-integers contract using `absInt`, rather than relying only on finitely many examples. I’m now tightening the reproducibility script so it regenerates the AST, compiles both the execution and proof definitions, checks concrete K results, and reruns the positive proof from a clean state.
apply patch
patch: completed
/work/prove.sh
/work/semantic.k
/work/verification.k
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..7cff0b7e09fa5f571544e5d18c97f4311c6ca313
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the constructor program with the fixed supplied translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile and concretely execute the handwritten operational semantics.
+kompile semantic.k --backend haskell \
+  --main-module SEMANTIC --syntax-module MPY-SYNTAX
+
+run_case() {
+  local a="$1"
+  local b="$2"
+  local expected="$3"
+  local actual
+  actual="$(
+    krun solution.mpy -cA="$a" -cB="$b" \
+      --definition semantic-kompiled \
+      | sed -n '/<result>/{n;s/ //gp;}'
+  )"
+  test "$actual" = "$expected"
+  printf 'krun multiply(%s, %s) = %s\n' "$a" "$b" "$actual"
+}
+
+run_case 148 412 16
+run_case 19 28 72
+run_case 2020 1851 0
+run_case 14 -15 20
+run_case -14 15 20
+run_case -14 -15 20
+
+# Compile the proof extension and prove its universal all-integers claim.
+kompile verification.k --backend haskell \
+  --main-module VERIFICATION --syntax-module MPY-SYNTAX
+kprove spec.k --definition verification-kompiled --spec-module SPEC \
+  | tee kprove.out
+grep -qx '#Top' kprove.out
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..3dd4191a3949d5a2e4cc5f4d18793efeca85dc0d
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,112 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // The task-specific fragment emitted by py2mpy.py.  These are AST nodes,
+  // not Python surface syntax; all of their meaning is defined below.
+  syntax Program ::= "Module" "(" Stmts ")" [symbol(Module)]
+  syntax Stmts   ::= List{Stmt, ""}
+
+  syntax Params ::= "Params" "(" String "," String ")" [symbol(Params)]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                  [symbol(FuncDef)]
+                | "If" "(" Expr "," Stmts "," Stmts ")" [symbol(If)]
+                | "Assign" "(" Expr "," Expr ")" [symbol(Assign)]
+                | "Return" "(" Expr ")" [symbol(Return)]
+
+  syntax Expr ::= "Int" "(" Int ")" [symbol(IntLiteral)]
+                | "Name" "(" String ")" [symbol(Name)]
+                | "UnaryOp" "(" String "," Expr ")" [symbol(UnaryOp)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(BinOp)]
+                | "Compare" "(" Expr "," CmpOp ")" [symbol(Compare)]
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Function ::= "function" "(" String "," String "," Stmts ")"
+                      [symbol(function)]
+  syntax Result ::= "noResult" [symbol(noResult)] | Int
+
+  syntax KItem ::= "#invoke" "(" String "," Int "," Int ")"
+                   [symbol(#invoke)]
+                 | "#if" "(" Expr "," Stmts "," Stmts ")"
+                   [symbol(#if), strict(1)]
+                 | "#assign" "(" String "," Expr ")"
+                   [symbol(#assign), strict(2)]
+                 | "#return" "(" Expr ")" [symbol(#return), strict(1)]
+                 | "#lessThan" "(" Expr "," Expr ")"
+                   [symbol(#lessThan), strict]
+
+  syntax KResult ::= Int | Bool
+  syntax Expr ::= Int | Bool
+
+  configuration
+    <task>
+      <k> $PGM:Program ~> #invoke("multiply", $A:Int, $B:Int) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </task>
+
+  // Statement-list scheduling.
+  rule Module(SS) => SS
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
+  rule .Stmts => .K
+
+  // Loading a definition records its formal parameters and untranslated body.
+  rule <k> FuncDef(F, Params(P1, P2), BODY) => .K ... </k>
+       <functions> FUNS => FUNS [ F <- function(P1, P2, BODY) ] </functions>
+
+  // The harness invokes the named, loaded function with two integer values.
+  rule <k> #invoke(F, A, B) => BODY ... </k>
+       <functions> ... F |-> function(P1, P2, BODY) ... </functions>
+       <env> _ => (P1 |-> A) (P2 |-> B) </env>
+
+  // Expressions.
+  rule Int(I) => I
+  rule <k> Name(X) => I ... </k>
+       <env> ... X |-> I:Int ... </env>
+
+  rule UnaryOp("-", E) => #unaryMinus(E)
+  syntax KItem ::= "#unaryMinus" "(" Expr ")"
+                   [symbol(#unaryMinus), strict(1)]
+  rule #unaryMinus(I:Int) => 0 -Int I
+
+  rule BinOp("%", E1, E2) => #modulo(E1, E2)
+  rule BinOp("*", E1, E2) => #multiply(E1, E2)
+  syntax KItem ::= "#modulo" "(" Expr "," Expr ")"
+                   [symbol(#modulo), strict]
+                 | "#multiply" "(" Expr "," Expr ")"
+                   [symbol(#multiply), strict]
+  rule #modulo(I1:Int, I2:Int) => I1 %Int I2
+    requires I2 =/=Int 0
+  rule #multiply(I1:Int, I2:Int) => I1 *Int I2
+
+  rule Compare(E1, CmpOp("<", E2)) => #lessThan(E1, E2)
+  rule #lessThan(I1:Int, I2:Int) => I1 <Int I2
+
+  // Statements.  Empty branches are genuine empty statement lists.
+  rule If(E, THEN, ELSE) => #if(E, THEN, ELSE)
+  rule #if(true,  THEN, _) => THEN
+  rule #if(false, _, ELSE) => ELSE
+
+  rule Assign(Name(X), E) => #assign(X, E)
+  rule <k> #assign(X, I:Int) => .K ... </k>
+       <env> ENV => ENV [ X <- I ] </env>
+
+  // This task has no caller frame: return terminates the entry invocation and
+  // publishes its integer value in the result cell.
+  rule <k> #return(I:Int) ~> _REST => .K </k>
+       <result> _ => I </result>
+  rule Return(E) => #return(E)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..bd1aad7bc8d975b117e9d87633c6193c98d3e1a6
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def multiply(a, b):
+    if a < 0:
+        a = -a
+    if b < 0:
+        b = -b
+    return (a % 10) * (b % 10)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6cad6918a11a41140d112acfb4e16241401af8e6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // For all mathematical integers, execution returns the product of the
+  // non-negative decimal unit digits.  absInt makes the sign convention
+  // explicit (in particular, unitDigit(-15) is 5).
+  claim
+    <task>
+      <k> multiplyProgram ~> #invoke("multiply", A, B) => .K </k>
+      <env> .Map => ("a" |-> absInt(A)) ("b" |-> absInt(B)) </env>
+      <functions>
+        .Map => "multiply" |-> function("a", "b", multiplyBody)
+      </functions>
+      <result>
+        noResult => unitDigit(A) *Int unitDigit(B)
+      </result>
+    </task>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d0fa5cb874d7cc23495eb40980501cb36c860b26
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,27 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Closed constructor terms used by the specification.  The body is exactly
+  // the tree in solution.mpy; keeping it as a macro makes proof states small
+  // without adding any trusted execution rule.
+  syntax Stmts ::= "multiplyBody" [symbol(multiplyBody)]
+  rule multiplyBody =>
+    If(Compare(Name("a"), CmpOp("<", Int(0))),
+       Assign(Name("a"), UnaryOp("-", Name("a"))), .Stmts)
+    If(Compare(Name("b"), CmpOp("<", Int(0))),
+       Assign(Name("b"), UnaryOp("-", Name("b"))), .Stmts)
+    Return(BinOp("*",
+                 BinOp("%", Name("a"), Int(10)),
+                 BinOp("%", Name("b"), Int(10))))
+
+  syntax Program ::= "multiplyProgram" [symbol(multiplyProgram)]
+  rule multiplyProgram =>
+    Module(FuncDef("multiply", Params("a", "b"), multiplyBody))
+
+  // Mathematical definition of an integer's decimal unit digit.
+  syntax Int ::= "unitDigit" "(" Int ")" [function, total,
+                                             symbol(unitDigit)]
+  rule unitDigit(I) => absInt(I) %Int 10
+endmodule

