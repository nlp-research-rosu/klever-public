+    )
+}
+expected_stage1_files = resolved["stage1_source_hashes"]
+print(f"same_file_set={set(observed_stage1_files) == set(expected_stage1_files)}")
+for name in sorted(set(observed_stage1_files) | set(expected_stage1_files)):
