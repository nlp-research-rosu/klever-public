      "module": "VERIFICATION",
      "normalized_sha256": "fc18bc8ceb43f9a96a719e63e4390ea4cff17cc757b6a60b12c863eb947baba8",
      "rationale": "This is the recursive defining equation for requiredBuckets, adding the current row's ceiling quotient to the summary of the remaining rows under positive capacity.",
      "source_rule_id": "rule-fc18bc8ceb43f9a96a719e63e4390ea4cff17cc757b6a60b12c863eb947baba8",
      "start_line": 16,
      "text": "  rule requiredBuckets(rowVal(ROW), ROWS, C)\n    => ((water(ROW) +Int C -Int 1) /Int C)\n       +Int requiredBuckets(ROWS, C)\n    requires C >Int 0"
    },
