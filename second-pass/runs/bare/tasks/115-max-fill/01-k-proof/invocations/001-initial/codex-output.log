+                 | Slice
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr
+                 | "NoBound"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
