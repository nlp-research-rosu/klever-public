+  rule
+    <k> V:Val => .K </k>
+    <result> noneVal => V </result>
+endmodule
diff --git a/solution-program.k b/solution-program.k
new file mode 100644
index 0000000000000000000000000000000000000000..0981ce366799242e89f1628b9a2a5acd36c9c3fa
--- /dev/null
+++ b/solution-program.k
@@ -0,0 +1,44 @@
+requires "semantic.k"
+
+module SOLUTION-PROGRAM
+  imports MPY
+
+  // prove.sh regenerates this file's source term from solution.py and checks
+  // that it is byte-for-byte the same term as solution.mpy before proving.
+  rule solutionProgram =>
+    Module(
+      FuncDef("_water_in", Params("row"),
+        Return(
+          IfExp(
+            Compare(Name("row"), CmpOp("==", ListExpr(.ExprList))),
+            Int(0),
+            BinOp(
+              "+",
+              Subscript(Name("row"), Int(0)),
+              Call(
+                Name("_water_in"),
+                Subscript(Name("row"), Slice(Int(1), NoBound, NoBound)))))))
+      FuncDef("_buckets_for", Params("grid", "capacity"),
+        Return(
+          IfExp(
+            Compare(Name("grid"), CmpOp("==", ListExpr(.ExprList))),
+            Int(0),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp(
+                  "-",
+                  BinOp(
+                    "+",
+                    Call(Name("_water_in"), Subscript(Name("grid"), Int(0))),
+                    Name("capacity")),
+                  Int(1)),
+                Name("capacity")),
+              Call(
+                Name("_buckets_for"),
+                Subscript(Name("grid"), Slice(Int(1), NoBound, NoBound)),
+                Name("capacity"))))))
+      FuncDef("max_fill", Params("grid", "capacity"),
+        Return(Call(Name("_buckets_for"), Name("grid"), Name("capacity")))))
+endmodule
