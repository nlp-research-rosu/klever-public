+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Lemma 1: the translated recursive row helper computes mathematical sum.
+  claim
+    <max-fill>
+      <k>
+        invoke("_water_in", values(listVal(ROW))) ~> CONT
+        => intVal(water(values(ROW))) ~> CONT
+      </k>
+      <args> ARGS </args>
+      <functions> solutionFunctions </functions>
+      <env> ENV </env>
+      <result> RES </result>
+    </max-fill>
+
+  // Lemma 2: the translated grid helper computes the sum of per-row ceilings.
+  claim
+    <max-fill>
+      <k>
+        invoke("_buckets_for", values(listVal(GRID), intVal(C))) ~> CONT
+        => intVal(requiredBuckets(values(GRID), C)) ~> CONT
+      </k>
+      <args> ARGS </args>
+      <functions> solutionFunctions </functions>
+      <env> ENV </env>
+      <result> RES </result>
+    </max-fill>
+    requires C >Int 0
+
+  // End-to-end theorem about the entry point in the actual translated module.
+  claim
+    <max-fill>
+      <k> solutionProgram => .K </k>
+      <args> listVal(GRID), intVal(C) </args>
+      <functions> .Map => solutionFunctions </functions>
+      <env> .Map </env>
+      <result>
+        noneVal => intVal(requiredBuckets(values(GRID), C))
+      </result>
+    </max-fill>
+    requires C >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..343daa68e1c2d884e86d304801693f0071b8ca24
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "semantic.k"
+requires "solution-program.k"
+
+module VERIFICATION
+  imports SOLUTION-PROGRAM
+
+  // Mathematical specification: count the water in a row, then sum one
+  // ceiling-division per well.  These equations do not mention the Python AST
+  // or its helper function names.
+  syntax Int ::= "water" "(" Values ")" [function]
+  rule water(values(.Vals)) => 0
+  rule water(values(intVal(I), REST)) => I +Int water(values(REST))
+
+  syntax Int ::= "requiredBuckets" "(" Values "," Int ")" [function]
+  rule requiredBuckets(values(.Vals), C) => 0
+  rule requiredBuckets(values(listVal(ROW), ROWS), C)
+    => ((water(values(ROW)) +Int C -Int 1) /Int C)
+       +Int requiredBuckets(values(ROWS), C)
+    requires C >Int 0
+
+  syntax Map ::= "solutionFunctions" [function]
+  syntax Map ::= functionsOf(Module) [function]
+  rule functionsOf(Module(SS)) => collectFunctions(SS)
+  rule solutionFunctions => functionsOf(solutionProgram)
+endmodule

exec
/bin/bash -lc "kompile verification.k --backend llvm --main-module VERIFICATION --syntax-module MPY-SYNTAX >/tmp/max-fill-llvm.log && krun solution.mpy --definition verification-kompiled -cARGS='listVal(listVal(intVal(1))),intVal(1)'" in /work
