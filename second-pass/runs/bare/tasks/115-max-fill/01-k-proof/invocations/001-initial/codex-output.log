+  // matching Python's evaluation order, this shape exposes recursive calls to
+  // kprove so the claims in spec.k can be used as circularities.
+  syntax KItem ::= invoke(String, Values)
+                 | restoreEnv(Map)
+                 | binRight(String, Expr)
+                 | binApply(String, Val)
+                 | chooseBranch(Expr, Expr)
+                 | "compareEmpty"
+                 | subscriptIndex(Expr)
+                 | subscriptApply(Val)
+                 | sliceFrom(Int)
+                 | evalCallArgs(String, Exprs, Values)
+                 | collectCallArg(String, Exprs, Values)
+                 | evalListItems(Exprs, Values)
+                 | collectListItem(Exprs, Values)
+
+  rule
+    <k> Module(SS) => invoke("max_fill", values(VS)) </k>
+    <args> VS </args>
+    <functions> .Map => collectFunctions(SS) </functions>
+
+  rule
+    <k> invoke(F, values(VS)) => BODY ~> restoreEnv(OLD) ... </k>
+    <functions> (F |-> function(P, BODY)) FS </functions>
+    <env> OLD => bindParams(P, values(VS)) </env>
+
+  rule <k> Return(E) .Stmts => E ... </k>
+  rule
+    <k> V:Val ~> restoreEnv(OLD) => V ... </k>
+    <env> _ => OLD </env>
+
+  rule <k> Int(I) => intVal(I) ... </k>
+  rule <k> Name(X) => V ... </k> <env> (X |-> V) ENV </env>
+
+  rule <k> BinOp(OP, L, R) => L ~> binRight(OP, R) ... </k>
+  rule <k> V:Val ~> binRight(OP, R) => R ~> binApply(OP, V) ... </k>
+  rule <k> W:Val ~> binApply(OP, V) => arithmetic(OP, V, W) ... </k>
+
+  rule <k> IfExp(COND, YES, NO) => COND ~> chooseBranch(YES, NO) ... </k>
+  rule <k> boolVal(true) ~> chooseBranch(YES, NO) => YES ... </k>
+  rule <k> boolVal(false) ~> chooseBranch(YES, NO) => NO ... </k>
+
+  // Only equality with [] is exercised by solution.mpy.  Keeping it as two
+  // constructor rules makes the empty/nonempty cases explicit to the prover.
+  rule <k> Compare(E, CmpOp("==", ListExpr(.ExprList)))
+            => E ~> compareEmpty ... </k>
+  rule <k> listVal(.Vals) ~> compareEmpty => boolVal(true) ... </k>
+  rule <k> listVal(V, VS) ~> compareEmpty => boolVal(false) ... </k>
+
+  rule <k> Subscript(BASE, IDX:Expr)
+            => BASE ~> subscriptIndex(IDX) ... </k>
+  rule <k> V:Val ~> subscriptIndex(IDX)
+            => IDX ~> subscriptApply(V) ... </k>
+  rule <k> I:Val ~> subscriptApply(V) => getItem(V, I) ... </k>
+  rule <k> Subscript(BASE, Slice(Int(START), NoBound, NoBound))
+            => BASE ~> sliceFrom(START) ... </k>
+  rule <k> V:Val ~> sliceFrom(START) => dropItems(START, V) ... </k>
+
+  rule <k> Call(Name(F), ES)
+            => evalCallArgs(F, exprs(ES), values(.Vals)) ... </k>
+  rule <k> evalCallArgs(F, exprs(.ExprList), VS) => invoke(F, VS) ... </k>
+  rule <k> evalCallArgs(F, exprs(E, ES), VS)
+            => E ~> collectCallArg(F, exprs(ES), VS) ... </k>
+  rule <k> V:Val ~> collectCallArg(F, ES, values(VS))
+            => evalCallArgs(F, ES, values(VS, V)) ... </k>
+
+  rule <k> ListExpr(ES)
+            => evalListItems(exprs(ES), values(.Vals)) ... </k>
+  rule <k> evalListItems(exprs(.ExprList), values(VS))
+            => listVal(VS) ... </k>
+  rule <k> evalListItems(exprs(E, ES), VS)
+            => E ~> collectListItem(exprs(ES), VS) ... </k>
+  rule <k> V:Val ~> collectListItem(ES, values(VS))
+            => evalListItems(ES, values(VS, V)) ... </k>
+
+  rule
+    <k> V:Val => .K </k>
+    <result> noneVal => V </result>
+endmodule
diff --git a/solution-program.k b/solution-program.k
new file mode 100644
index 0000000000000000000000000000000000000000..5bf7742b5c187ba9dabc4d59c030a73a044853c7
--- /dev/null
+++ b/solution-program.k
@@ -0,0 +1,45 @@
+requires "semantic.k"
+
+module SOLUTION-PROGRAM
+  imports MPY
+
+  // prove.sh regenerates this file's source term from solution.py and checks
+  // that it is byte-for-byte the same term as solution.mpy before proving.
+  syntax Module ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("_water_in", Params("row"),
+        Return(
+          IfExp(
+            Compare(Name("row"), CmpOp("==", ListExpr(.ExprList))),
+            Int(0),
+            BinOp(
+              "+",
+              Subscript(Name("row"), Int(0)),
+              Call(
+                Name("_water_in"),
+                Subscript(Name("row"), Slice(Int(1), NoBound, NoBound)))))))
+      FuncDef("_buckets_for", Params("grid", "capacity"),
+        Return(
+          IfExp(
+            Compare(Name("grid"), CmpOp("==", ListExpr(.ExprList))),
+            Int(0),
+            BinOp(
+              "+",
+              BinOp(
+                "//",
+                BinOp(
+                  "-",
+                  BinOp(
+                    "+",
+                    Call(Name("_water_in"), Subscript(Name("grid"), Int(0))),
+                    Name("capacity")),
+                  Int(1)),
+                Name("capacity")),
+              Call(
+                Name("_buckets_for"),
+                Subscript(Name("grid"), Slice(Int(1), NoBound, NoBound)),
+                Name("capacity"))))))
+      FuncDef("max_fill", Params("grid", "capacity"),
+        Return(Call(Name("_buckets_for"), Name("grid"), Name("capacity")))))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..85d2db8b447cd5a0fa021413dc3fafce5de490c1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def _water_in(row):
+    return 0 if row == [] else row[0] + _water_in(row[1:])
+
+
+def _buckets_for(grid, capacity):
+    return 0 if grid == [] else (
+        (_water_in(grid[0]) + capacity - 1) // capacity
+        + _buckets_for(grid[1:], capacity)
+    )
+
+
+def max_fill(grid, capacity):
+    return _buckets_for(grid, capacity)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6b13eb9c8ec34080c44f5f013c6cb9487b88a792
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Lemma 1: the translated recursive row helper computes mathematical sum.
+  claim
+    <max-fill>
+      <k>
+        invoke("_water_in", values(listVal(ROW))) ~> CONT
+        => intVal(water(values(ROW))) ~> CONT
+      </k>
+      <args> ARGS </args>
+      <functions> solutionFunctions </functions>
+      <env> ENV </env>
+      <result> RES </result>
+    </max-fill>
+
+  // Lemma 2: the translated grid helper computes the sum of per-row ceilings.
+  claim
+    <max-fill>
+      <k>
+        invoke("_buckets_for", values(listVal(GRID), intVal(C))) ~> CONT
+        => intVal(requiredBuckets(values(GRID), C)) ~> CONT
+      </k>
+      <args> ARGS </args>
+      <functions> solutionFunctions </functions>
+      <env> ENV </env>
+      <result> RES </result>
+    </max-fill>
+    requires C >Int 0
+
+  // End-to-end theorem about the entry point in the actual translated module.
+  claim
+    <max-fill>
+      <k> solutionProgram => .K </k>
+      <args> listVal(GRID), intVal(C) </args>
+      <functions> .Map => solutionFunctions </functions>
+      <env> .Map </env>
+      <result>
+        noneVal => intVal(requiredBuckets(values(GRID), C))
+      </result>
+    </max-fill>
+    requires C >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..343daa68e1c2d884e86d304801693f0071b8ca24
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "semantic.k"
+requires "solution-program.k"
+
+module VERIFICATION
+  imports SOLUTION-PROGRAM
+
+  // Mathematical specification: count the water in a row, then sum one
+  // ceiling-division per well.  These equations do not mention the Python AST
+  // or its helper function names.
+  syntax Int ::= "water" "(" Values ")" [function]
+  rule water(values(.Vals)) => 0
+  rule water(values(intVal(I), REST)) => I +Int water(values(REST))
+
+  syntax Int ::= "requiredBuckets" "(" Values "," Int ")" [function]
+  rule requiredBuckets(values(.Vals), C) => 0
+  rule requiredBuckets(values(listVal(ROW), ROWS), C)
+    => ((water(values(ROW)) +Int C -Int 1) /Int C)
+       +Int requiredBuckets(values(ROWS), C)
+    requires C >Int 0
+
+  syntax Map ::= "solutionFunctions" [function]
+  syntax Map ::= functionsOf(Module) [function]
+  rule functionsOf(Module(SS)) => collectFunctions(SS)
+  rule solutionFunctions => functionsOf(solutionProgram)
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..26be3049c0218420c8e8df6b1d5cc038d4834f77
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,177 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructors below are the portion of py2mpy.py's output language
+  // needed by solution.py.  Lists use the same concrete punctuation emitted
+  // by the fixed transliterator.
+  syntax Module ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" ParamList ")"
+  syntax ParamList ::= List{String, ","}
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "ListExpr" "(" ExprList ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "IfExp" "(" Expr "," Expr "," Expr ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "Call" "(" Expr "," ExprList ")"
+  syntax ExprList ::= List{Expr, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Index ::= Expr
+                 | Slice
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr
+                 | "NoBound"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  // Runtime values are deliberately distinct from source expressions.  This
+  // prevents the semantics from silently treating untranslated syntax as an
+  // already-computed Python value.
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "listVal" "(" Vals ")"
+               | "noneVal"
+  syntax Vals ::= List{Val, ","}
+
+  syntax Expr ::= Val
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+  syntax Exprs ::= "exprs" "(" ExprList ")"
+  syntax Values ::= "values" "(" Vals ")"
+
+  // A translated module is the program supplied to krun.  ARGS is a
+  // comma-separated Vals term, for example:
+  //   -cARGS='listVal(listVal(intVal(1))), intVal(2)'
+  configuration
+    <max-fill>
+      <k> $PGM:Module </k>
+      <args> $ARGS:Vals </args>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noneVal </result>
+    </max-fill>
+
+  syntax Map ::= collectFunctions(Stmts) [function]
+  rule collectFunctions(.Stmts) => .Map
+  rule collectFunctions(FuncDef(F, P, BODY) REST)
+    => (F |-> function(P, BODY)) collectFunctions(REST)
+
+  syntax Map ::= bindParams(Params, Values) [function]
+  rule bindParams(Params(.ParamList), values(.Vals)) => .Map
+  rule bindParams(Params(P, PS), values(V, VS))
+    => (P |-> V) bindParams(Params(PS), values(VS))
+
+  syntax Val ::= arithmetic(String, Val, Val) [function]
+  rule arithmetic("+", intVal(I), intVal(J)) => intVal(I +Int J)
+  rule arithmetic("-", intVal(I), intVal(J)) => intVal(I -Int J)
+  rule arithmetic("//", intVal(I), intVal(J)) => intVal(I /Int J)
+    requires J =/=Int 0
+
+  syntax Val ::= getItem(Val, Val) [function]
+  rule getItem(listVal(V, VS), intVal(0)) => V
+  rule getItem(listVal(V, VS), intVal(I))
+    => getItem(listVal(VS), intVal(I -Int 1))
+    requires I >Int 0
+
+  syntax Val ::= dropItems(Int, Val) [function]
+  rule dropItems(0, listVal(VS)) => listVal(VS)
+  rule dropItems(I, listVal(V, VS)) => dropItems(I -Int 1, listVal(VS))
+    requires I >Int 0
+
+  // Control frames for a left-to-right, small-step expression evaluator.
+  // Calls save and restore the caller environment explicitly.  Besides
+  // matching Python's evaluation order, this shape exposes recursive calls to
+  // kprove so the claims in spec.k can be used as circularities.
+  syntax KItem ::= invoke(String, Values)
+                 | restoreEnv(Map)
+                 | binRight(String, Expr)
+                 | binApply(String, Val)
+                 | chooseBranch(Expr, Expr)
+                 | "compareEmpty"
+                 | subscriptIndex(Expr)
+                 | subscriptApply(Val)
+                 | sliceFrom(Int)
+                 | evalCallArgs(String, Exprs, Values)
+                 | collectCallArg(String, Exprs, Values)
+                 | evalListItems(Exprs, Values)
+                 | collectListItem(Exprs, Values)
+
+  rule
+    <k> Module(SS) => invoke("max_fill", values(VS)) </k>
+    <args> VS </args>
+    <functions> .Map => collectFunctions(SS) </functions>
+
+  rule
+    <k> invoke(F, values(VS)) => BODY ~> restoreEnv(OLD) ... </k>
+    <functions> (F |-> function(P, BODY)) FS </functions>
+    <env> OLD => bindParams(P, values(VS)) </env>
+
+  rule <k> Return(E) .Stmts => E ... </k>
+  rule
+    <k> V:Val ~> restoreEnv(OLD) => V ... </k>
+    <env> _ => OLD </env>
+
+  rule <k> Int(I) => intVal(I) ... </k>
+  rule <k> Name(X) => V ... </k> <env> (X |-> V) ENV </env>
+
+  rule <k> BinOp(OP, L, R) => L ~> binRight(OP, R) ... </k>
+  rule <k> V:Val ~> binRight(OP, R) => R ~> binApply(OP, V) ... </k>
+  rule <k> W:Val ~> binApply(OP, V) => arithmetic(OP, V, W) ... </k>
+
+  rule <k> IfExp(COND, YES, NO) => COND ~> chooseBranch(YES, NO) ... </k>
+  rule <k> boolVal(true) ~> chooseBranch(YES, NO) => YES ... </k>
+  rule <k> boolVal(false) ~> chooseBranch(YES, NO) => NO ... </k>
+
+  // Only equality with [] is exercised by solution.mpy.  Keeping it as two
+  // constructor rules makes the empty/nonempty cases explicit to the prover.
+  rule <k> Compare(E, CmpOp("==", ListExpr(.ExprList)))
+            => E ~> compareEmpty ... </k>
+  rule <k> listVal(.Vals) ~> compareEmpty => boolVal(true) ... </k>
+  rule <k> listVal(V, VS) ~> compareEmpty => boolVal(false) ... </k>
+
+  rule <k> Subscript(BASE, IDX:Expr)
+            => BASE ~> subscriptIndex(IDX) ... </k>
+  rule <k> V:Val ~> subscriptIndex(IDX)
+            => IDX ~> subscriptApply(V) ... </k>
+  rule <k> I:Val ~> subscriptApply(V) => getItem(V, I) ... </k>
+  rule <k> Subscript(BASE, Slice(Int(START), NoBound, NoBound))
+            => BASE ~> sliceFrom(START) ... </k>
+  rule <k> V:Val ~> sliceFrom(START) => dropItems(START, V) ... </k>
+
+  rule <k> Call(Name(F), ES)
+            => evalCallArgs(F, exprs(ES), values(.Vals)) ... </k>
+  rule <k> evalCallArgs(F, exprs(.ExprList), VS) => invoke(F, VS) ... </k>
+  rule <k> evalCallArgs(F, exprs(E, ES), VS)
+            => E ~> collectCallArg(F, exprs(ES), VS) ... </k>
+  rule <k> V:Val ~> collectCallArg(F, ES, values(VS))
+            => evalCallArgs(F, ES, values(VS, V)) ... </k>
+
+  rule <k> ListExpr(ES)
+            => evalListItems(exprs(ES), values(.Vals)) ... </k>
+  rule <k> evalListItems(exprs(.ExprList), values(VS))
+            => listVal(VS) ... </k>
+  rule <k> evalListItems(exprs(E, ES), VS)
+            => E ~> collectListItem(exprs(ES), VS) ... </k>
+  rule <k> V:Val ~> collectListItem(ES, values(VS))
+            => evalListItems(ES, values(VS, V)) ... </k>
+
+  rule
+    <k> V:Val => .K </k>
+    <result> noneVal => V </result>
+endmodule
