+  rule eval(Compare(L, CmpOp("==", R)), ENV, FS)
+    => boolVal(equalVals(eval(L, ENV, FS), eval(R, ENV, FS)))
+  rule eval(IfExp(COND, YES, NO), ENV, FS)
+    => select(eval(COND, ENV, FS), YES, NO, ENV, FS)
+  rule eval(Subscript(BASE, IDX:Expr), ENV, FS)
+    => getItem(eval(BASE, ENV, FS), eval(IDX, ENV, FS))
+  rule eval(Subscript(BASE, Slice(Int(START), NoBound, NoBound)), ENV, FS)
+    => dropItems(START, eval(BASE, ENV, FS))
+  rule eval(Call(Name(F), ES), ENV, FS)
+    => callFunction(F, values(evalExprs(exprs(ES), ENV, FS)), FS)
