+  rule callFunction(F, values(VS), (F |-> FN) FS)
+    => applyFunction(FN, values(VS), (F |-> FN) FS)
+
+  syntax Val ::= applyFunction(Function, Values, Map) [function]
+  rule applyFunction(function(P, Return(E)), values(VS), FS)
+    => eval(E, bindParams(P, values(VS)), FS)
+
