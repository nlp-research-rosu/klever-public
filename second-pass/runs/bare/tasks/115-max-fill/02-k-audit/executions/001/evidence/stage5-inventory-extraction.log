COMMAND: bash -lc $'set -euo pipefail\nfor f in semantic.k solution-program.k verification.k spec.k; do\n  printf "FILE %s\\n" "$f"\n  rg -n "^\\\\s*(syntax|configuration|rule|claim)\\\\b|\\\\[(function|total|functional|simplification|priority|owise|anywhere|macro)" "$f" || true\ndone\nprintf "COUNTS\\n"\nfor f in semantic.k solution-program.k verification.k; do printf "%s rules=" "$f"; rg -c "^\\\\s*rule\\\\b" "$f"; done\nprintf "spec.k claims="; rg -c "^\\\\s*claim\\\\b" spec.k\nprintf "SPECIAL_ATTRIBUTE_LINES\\n"\nrg -n "\\\\[(total|functional|simplification|priority|owise|anywhere|macro)(,|\\\\])" semantic.k solution-program.k verification.k spec.k || true'
WORKDIR: /tmp/audit-work/rebuild
