COMMAND: bash -lc $'set -euo pipefail\nprintf "WITNESS: ROW=(1,0), GRID=(rowVal(1,0),rowVal(1,1)), C=2, CONT=.K, ARGS=.Vals, ENV=.Map, RES=noneVal\\n"\nprintf "PRECONDITIONS: water claim has none; buckets and entry require 2 > 0 (true)\\n"\nprintf "CLAIMED_WATER: 1 + 0 = 1\\n"\nprintf "CLAIMED_REQUIRED_BUCKETS: ceil(1/2) + ceil(2/2) = 1 + 1 = 2\\n"\npython3 - <<"PY"\nimport importlib.util\n\ndef load(path, name):\n    spec = importlib.util.spec_from_file_location(name, path)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod.max_fill\n\ngrid = [[1, 0], [1, 1]]\nfor path, name in [("/reference/canonical.py", "canonical"), ("solution.py", "generated")]:\n    print(name, load(path, name)(grid, 2))\nPY\nkrun solution.mpy --definition semantic-audit-kompiled -cARGS="gridVal(rowVal(1,0),rowVal(1,1)),intVal(2)" | sed -n "/<result>/,/<\\\\/result>/p"'
WORKDIR: /tmp/audit-work/rebuild
--- OUTPUT ---
WITNESS: ROW=(1,0), GRID=(rowVal(1,0),rowVal(1,1)), C=2, CONT=.K, ARGS=.Vals, ENV=.Map, RES=noneVal
PRECONDITIONS: water claim has none; buckets and entry require 2 > 0 (true)
CLAIMED_WATER: 1 + 0 = 1
CLAIMED_REQUIRED_BUCKETS: ceil(1/2) + ceil(2/2) = 1 + 1 = 2
canonical 2
