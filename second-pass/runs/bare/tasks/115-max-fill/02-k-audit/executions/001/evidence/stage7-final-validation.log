COMMAND: bash -lc $'set -euo pipefail\nprintf "REVIEW_TAIL\\n"\ntail -5 /audit-output/REVIEW.md\nprintf "MARKER_COUNTS\\n"\nrg -c "^VERDICT: (PASS|CONCERNS|FAIL)$" /audit-output/REVIEW.md\nrg -c "^LEGITIMACY: (LEGIT|NOT_LEGIT)$" /audit-output/REVIEW.md\nprintf "EVIDENCE_FILES\\n"\nfind /audit-output/evidence -maxdepth 1 -type f -printf "%f %s bytes\\n" | sort\nprintf "KEY_STATUSES\\n"\nfor f in stage1-integrity.log stage2-translation.log stage2-differential.log stage3-kompile-concrete.log stage3-kompile-proof.log stage3-kprove-all.log stage3-kprove-water.log stage3-kprove-buckets-with-water.log stage3-kprove-entry-with-helpers.log stage3-concrete-differential-pass.log stage4-program-pinning.log stage4-satisfying-witness.log stage5-inventory-extraction.log stage5-off-domain-division-witness.log stage6-vacuity-dry-run.log stage6-vacuity-proof.log; do printf "%s: " "$f"; rg "^EXIT_STATUS:" "/audit-output/evidence/$f" | tail -1; done'
