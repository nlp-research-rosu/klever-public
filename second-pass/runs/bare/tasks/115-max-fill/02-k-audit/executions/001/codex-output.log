new file mode 100644
index 0000000000000000000000000000000000000000..f759679e621d6f982a597795f85f40c4fad4b9d6
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log"
+
+"$@" >>"$log" 2>&1
+status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$log"
+
+exit "$status"
