+
+
+def ordinary_row(row: list[int]) -> str:
+    return f"listVal({','.join(f'intVal({cell})' for cell in row)})"
+
+
+def ordinary_grid(grid: list[list[int]]) -> str:
+    return f"listVal({','.join(ordinary_row(row) for row in grid)})"
+
+
