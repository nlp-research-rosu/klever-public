@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set +e
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
