+#!/usr/bin/env bash
+set +e
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+audit_log="$1"
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status="$?"
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+} >"$audit_log" 2>&1
+
+exit "$audit_status"

exec
/bin/bash -lc "test -e /audit-output/REVIEW.md; printf 'review_exists=%s\\n' \""'$?"' in /audit-output
 succeeded in 0ms:
review_exists=1

