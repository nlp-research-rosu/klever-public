+++ b/evidence/06-spec-vacuity.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  claim
+    <max-fill>
+      <k>
+        invoke("_water_in", arg(rowVal(ROW), noArgs)) ~> CONT
+        => intVal(water(ROW)) ~> CONT
+      </k>
+      <args> ARGS </args>
+      <functions> solutionFunctions </functions>
+      <env> ENV </env>
+      <result> RES </result>
+    </max-fill>
+
+  claim
+    <max-fill>
+      <k>
+        invoke(
+          "_buckets_for",
+          arg(gridVal(GRID), arg(intVal(C), noArgs))) ~> CONT
+        => intVal(requiredBuckets(GRID, C)) ~> CONT
+      </k>
+      <args> ARGS </args>
+      <functions> solutionFunctions </functions>
+      <env> ENV </env>
+      <result> RES </result>
+    </max-fill>
+    requires C >Int 0
+
+  // Fresh false mutation: every terminating result is required to be one
+  // larger.  An intended-domain witness is GRID=rowVal(0), C=1: execution
+  // returns 0, while this destination demands 1.
+  claim
+    <max-fill>
+      <k> solutionProgram => .K </k>
+      <args> gridVal(GRID), intVal(C) </args>
+      <functions> .Map => solutionFunctions </functions>
+      <env> .Map </env>
+      <result>
+        noneVal => intVal(requiredBuckets(GRID, C) +Int 1)
+      </result>
+    </max-fill>
+    requires C >Int 0
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..6b514aa711a27ee077f0765b6e55cdea74b10776
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set +e
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+audit_log="$1"
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status="$?"
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+} >"$audit_log" 2>&1
+
+exit "$audit_status"

