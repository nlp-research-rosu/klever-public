+    print("GENERATION OUTPUT SUMMARY (UNTRUSTED)")
+    print(
+        f"lines={output_lines} exact_top_lines={output_top_lines} "
+        f"kprove_passed_marker_lines={output_markers}"
+    )
+
+    mounts = [
