index 0000000000000000000000000000000000000000..6b514aa711a27ee077f0765b6e55cdea74b10776
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set +e
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+audit_log="$1"
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status="$?"
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+} >"$audit_log" 2>&1
+
+exit "$audit_status"

