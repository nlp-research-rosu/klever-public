+    },
+    "producer_file_hashes": {
+        "observed": producer_file_hashes,
+        "source_manifest": producer_manifest["files"],
+        "generator_manifest": {
+            "klean.py": generator_manifest["klean_py_sha256"],
+            "klean_export.py": generator_manifest["exporter_sha256"],
