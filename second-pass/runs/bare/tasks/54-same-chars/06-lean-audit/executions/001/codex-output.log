@@ -0,0 +1,22 @@
+#define _GNU_SOURCE
+
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length > 0 && length < (ssize_t)sizeof(target)) {
+        target[length] = '\0';
+        char *end = NULL;
+        long observed = strtol(target, &end, 10);
