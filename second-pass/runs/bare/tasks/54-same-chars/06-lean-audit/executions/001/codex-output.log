codex
Lean itself is hitting a container namespace defect: its runtime calls `/proc/<getpid>/exe`, but `getpid()` returns the namespace PID while `/proc` exposes host PIDs. I’m applying a narrowly scoped `LD_PRELOAD` shim only to the Lean/Lake subprocesses so `getpid()` returns the process’s `/proc/self` host PID; this restores executable discovery without changing any frozen input or generated source.
apply patch
patch: completed
/tmp/audit-work/pid_shim.c
diff --git a//tmp/audit-work/pid_shim.c b//tmp/audit-work/pid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..07cd1bacbb27560c3004f915f9632785a283a4a5
--- /dev/null
+++ b//tmp/audit-work/pid_shim.c
@@ -0,0 +1,22 @@
+#define _GNU_SOURCE
+
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length > 0 && length < (ssize_t)sizeof(target)) {
+        target[length] = '\0';
+        char *end = NULL;
+        long observed = strtol(target, &end, 10);
+        if (end != target && *end == '\0' && observed > 0
+            && observed <= INT_MAX) {
+            return (pid_t)observed;
+        }
+    }
+    return (pid_t)syscall(SYS_getpid);
+}

