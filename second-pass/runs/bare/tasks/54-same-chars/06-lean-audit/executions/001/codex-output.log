+    "generated_tree_sha256": klean_export.tree_digest(
+        Path("/reference/klean-generation/generated")
+    ),
+    "lean_workspace_sha256": None,
+    "lean_invocation_sha256": None,
+}
+
+producer_manifest = json.loads(
