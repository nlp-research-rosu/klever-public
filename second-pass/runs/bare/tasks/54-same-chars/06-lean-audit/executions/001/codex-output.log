+        == observed["stage1_export_sha256"],
+        "stage3_matches": export_result[
+            "stage3_discovery_manifest_sha256"
+        ]
+        == observed["discovery_manifest_sha256"],
+        "generated_tree_matches": export_result[
+            "generated_tree_sha256"
