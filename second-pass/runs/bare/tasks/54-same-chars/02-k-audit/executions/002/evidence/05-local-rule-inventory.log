COMMAND: bash -lc $'\nset -e\nprintf "%s\\n" "LOCAL K FILES"\nfind . -maxdepth 1 -type f -name "*.k" -printf "%f\\n" | sort\nprintf "%s\\n" "DECLARATIONS RULES CLAIMS ATTRIBUTES"\nrg -n "^[[:space:]]*(requires|module|imports|syntax|configuration|rule|claim)|\\[(function|total|functional|concrete|simplification|priority|owise|macro)" semantic.k solution-program.k verification.k spec.k\nprintf "%s\\n" "COUNTS"\nprintf "semantic_rules="; rg -c "^[[:space:]]*rule " semantic.k\nprintf "solution_program_rules="; rg -c "^[[:space:]]*rule " solution-program.k\nprintf "verification_rules="; rg -c "^[[:space:]]*rule " verification.k\nprintf "spec_claims="; rg -c "^[[:space:]]*claim$" spec.k\nprintf "%s\\n" "ABSENCE CHECKS"\nset +e\nrg -n "\\[(simplification|priority|owise|macro|functional)|syntax priority|syntax priorities|opaque" semantic.k solution-program.k verification.k spec.k\nabsence_status=$?\nset -e\nprintf "absence_rg_status=%s (1 means none found)\\n" "$absence_status"\n'
