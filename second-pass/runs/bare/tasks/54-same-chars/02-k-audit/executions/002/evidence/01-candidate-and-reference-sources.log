     1	#!/usr/bin/env python3
     2	"""Embed a translated .mpy term as a nullary K function for proofs."""
     3	
     4	from pathlib import Path
     5	import sys
     6	
     7	
     8	def main() -> int:
     9	    if len(sys.argv) != 2:
    10	        raise SystemExit("usage: embed_mpy.py FILE.mpy")
    11	    program = Path(sys.argv[1]).read_text(encoding="utf-8").strip()
    12	    print('requires "semantic.k"')
    13	    print()
    14	    print("module SOLUTION")
    15	    print("  imports MPY")
    16	    print('  syntax Program ::= "solutionProgram" [function]')
    17	    print(f"  rule solutionProgram => {program}")
    18	    print("endmodule")
    19	    return 0
    20	
    21	
    22	if __name__ == "__main__":
    23	    raise SystemExit(main())
