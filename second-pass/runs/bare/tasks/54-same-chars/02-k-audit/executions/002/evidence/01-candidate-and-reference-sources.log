     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd -- "$(dirname -- "$0")"
     5	
     6	# Translate the submitted Python and make that exact constructor term available
     7	# to the K claims as solutionProgram.
     8	python3 py2mpy.py solution.py > solution.mpy
     9	python3 embed_mpy.py solution.mpy > solution-program.k
