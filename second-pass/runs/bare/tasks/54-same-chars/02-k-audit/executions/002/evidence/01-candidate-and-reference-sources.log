     7	def same_chars(s0: str, s1: str):
     8	    """
     9	    Check if two words have the same characters.
    10	    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')
    11	    True
    12	    >>> same_chars('abcd', 'dddddddabc')
    13	    True
    14	    >>> same_chars('dddddddabc', 'abcd')
