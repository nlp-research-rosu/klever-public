+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [universal]:
+    <k> solutionProgram => .K </k>
+    <s0> S0:String </s0>
+    <s1> S1:String </s1>
+    <env>
+      .Map
+      => ("s0" |-> stringValue(S0)) ("s1" |-> stringValue(S1))
+    </env>
