/audit-output/evidence/04-static-source.sh > /audit-output/evidence/04-static-source.log 2>&1
static_status=$?
printf '"'stage4_5_static_exit=%d\\n' \""'$static_status"
wc -c -l /audit-output/evidence/04-static-source.log
tail -n 220 /audit-output/evidence/04-static-source.log
