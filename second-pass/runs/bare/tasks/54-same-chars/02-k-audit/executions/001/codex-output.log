+            rng.shuffle(chars)
+            right = "".join(chars)
+            if chars:
+                right += rng.choice(chars) * rng.randrange(0, 4)
+        else:
+            right = "".join(
+                rng.choice(RANDOM_ALPHABET) for _ in range(rng.randrange(0, 25))
+            )
+        pairs.append((left, right, None, "random"))
