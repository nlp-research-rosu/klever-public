diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..7c030a320357bc8c94119dfa7b068d17a901d462
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The contract: the two strings induce the same mathematical set of
+  // one-code-point strings.  Set equality deliberately ignores order and
+  // duplicate occurrences.
+  syntax Bool ::= "sameCharsSpec" "(" String "," String ")" [function, total]
+  rule sameCharsSpec(S0, S1) => charSet(S0) ==K charSet(S1)
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX' in /work
