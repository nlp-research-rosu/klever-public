     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Recursive helper correctness, for every finite non-empty integer list and
     7	  // in every caller environment/continuation.
     8	  claim
     9	    <py>
    10	      <k> apply(funref("min_prefix_sum"), pyList(cons(H, T))) ~> K
    11	        => returned(D, pyInt(minPrefix(cons(H, T)))) ~> K </k>
    12	      <entry> ENTRY </entry>
    13	      <args> ARGS </args>
    14	      <functions> solutionFunctions </functions>
    15	      <env> RHO </env>
    16	      <callStack> STACK </callStack>
    17	      <callDepth> D </callDepth>
    18	    </py>
    19	
    20	  // Target-function correctness against the contract equations.
    21	  claim
    22	    <py>
    23	      <k> apply(funref("minSubArraySum"), pyList(cons(H, T))) ~> K
    24	        => returned(D, pyInt(minSubarray(cons(H, T)))) ~> K </k>
    25	      <entry> ENTRY </entry>
    26	      <args> ARGS </args>
    27	      <functions> solutionFunctions </functions>
    28	      <env> RHO </env>
    29	      <callStack> STACK </callStack>
    30	      <callDepth> D </callDepth>
    31	    </py>
    32	
    33	  // End-to-end: parse/load the exact translated module, invoke the required
    34	  // entry point, and obtain the contract value for every non-empty input.
    35	  claim
    36	    <py>
    37	      <k> solutionProgram => pyInt(minSubarray(cons(H, T))) ~> .K </k>
    38	      <entry> "minSubArraySum" </entry>
    39	      <args> pyList(cons(H, T)) </args>
    40	      <functions> .Map => solutionFunctions </functions>
    41	      <env> .Map </env>
    42	      <callStack> .List </callStack>
    43	      <callDepth> z </callDepth>
    44	    </py>
    45	endmodule
[exit 0]
