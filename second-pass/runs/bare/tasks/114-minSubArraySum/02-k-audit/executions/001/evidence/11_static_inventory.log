     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // minPrefix is the least sum of a non-empty prefix.  Every non-empty prefix
     7	  // of H :: T is either [H], or H followed by a non-empty prefix of T.
     8	  // minSubarray is the least sum of any non-empty contiguous subarray.  Such a
     9	  // subarray either starts at H (and is covered by minPrefix) or lies in T.
    10	  // These constructor equations therefore state the HumanEval contract.
    11	  syntax Int ::= minPrefix(IntList) [function]
    12	               | minSubarray(IntList) [function]
    13	  rule minPrefix(cons(H, nil)) => H
    14	  rule minPrefix(cons(H, cons(J, T)))
    15	    => intMin(H, H +Int minPrefix(cons(J, T)))
    16	  rule minSubarray(cons(H, nil)) => H
    17	  rule minSubarray(cons(H, cons(J, T)))
    18	    => intMin(minSubarray(cons(J, T)),
    19	              minPrefix(cons(H, cons(J, T))))
    20	
    21	  // A literal copy of solution.mpy as a function map and as a module term.
    22	  // The end-to-end claims start from solutionProgram; call-level claims use
    23	  // solutionFunctions as circular lemmas for the two recursive definitions.
    24	  syntax Map ::= "solutionFunctions" [function]
    25	  rule solutionFunctions =>
    26	      ("min_prefix_sum" |-> closure(Params("nums"),
    27	        If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
    28	          Return(Subscript(Name("nums"), Int(0))),
    29	          .Stmts)
    30	        Assign(Name("tail_min"),
    31	          Call(Name("min_prefix_sum"),
    32	            Subscript(Name("nums"), Slice(Int(1), NoBound, NoBound))))
    33	        Return(Call(Name("min"),
    34	          Subscript(Name("nums"), Int(0)),
    35	          BinOp("+", Subscript(Name("nums"), Int(0)), Name("tail_min"))))))
    36	      ("minSubArraySum" |-> closure(Params("nums"),
    37	        If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
    38	          Return(Subscript(Name("nums"), Int(0))),
    39	          .Stmts)
    40	        Assign(Name("tail_min"),
    41	          Call(Name("minSubArraySum"),
    42	            Subscript(Name("nums"), Slice(Int(1), NoBound, NoBound))))
    43	        Assign(Name("prefix_min"),
    44	          Call(Name("min_prefix_sum"), Name("nums")))
    45	        Return(Call(Name("min"), Name("tail_min"), Name("prefix_min")))))
    46	
    47	  syntax Program ::= "solutionProgram" [function]
    48	  rule solutionProgram => Module(
    49	    FuncDef("min_prefix_sum", Params("nums"),
    50	      If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
    51	        Return(Subscript(Name("nums"), Int(0))),
    52	        .Stmts)
    53	      Assign(Name("tail_min"),
    54	        Call(Name("min_prefix_sum"),
    55	          Subscript(Name("nums"), Slice(Int(1), NoBound, NoBound))))
    56	      Return(Call(Name("min"),
    57	        Subscript(Name("nums"), Int(0)),
    58	        BinOp("+", Subscript(Name("nums"), Int(0)), Name("tail_min")))))
    59	    FuncDef("minSubArraySum", Params("nums"),
    60	      If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
    61	        Return(Subscript(Name("nums"), Int(0))),
    62	        .Stmts)
    63	      Assign(Name("tail_min"),
    64	        Call(Name("minSubArraySum"),
    65	          Subscript(Name("nums"), Slice(Int(1), NoBound, NoBound))))
    66	      Assign(Name("prefix_min"),
    67	        Call(Name("min_prefix_sum"), Name("nums")))
    68	      Return(Call(Name("min"), Name("tail_min"), Name("prefix_min"))))
    69	  )
    70	endmodule
