+
+run() {
+  local cmd="$1"
+  printf '$ %s\n' "$cmd"
+  bash -o pipefail -c "$cmd"
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+run "mkdir -p '$SCRATCH'"
+run "cp /candidate/solution.py '$SCRATCH/solution.py'"
