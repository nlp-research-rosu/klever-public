def minSubArraySum(nums):
    """
    Given an array of integers nums, find the minimum sum of any non-empty sub-array
    of nums.
    Example
    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1
    minSubArraySum([-1, -2, -3]) == -6
    """
# canonical.py — the UNMODIFIED HumanEval/114 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: minSubArraySum


def minSubArraySum(nums):
    """
    Given an array of integers nums, find the minimum sum of any non-empty sub-array
    of nums.
    Example
    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1
    minSubArraySum([-1, -2, -3]) == -6
    """
    max_sum = 0
    s = 0
    for num in nums:
        s += -num
        if (s < 0):
            s = 0
        max_sum = max(s, max_sum)
    if max_sum == 0:
        max_sum = max(-i for i in nums)
    min_sum = -max_sum
    return min_sum
def min_prefix_sum(nums):
    if len(nums) == 1:
        return nums[0]
    tail_min = min_prefix_sum(nums[1:])
    return min(nums[0], nums[0] + tail_min)


def minSubArraySum(nums):
    if len(nums) == 1:
        return nums[0]
    tail_min = minSubArraySum(nums[1:])
    prefix_min = min_prefix_sum(nums)
    return min(tail_min, prefix_min)
Module(
  FuncDef("min_prefix_sum", Params("nums"),
    If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
      Return(Subscript(Name("nums"), Int(0))),
      )
    Assign(
