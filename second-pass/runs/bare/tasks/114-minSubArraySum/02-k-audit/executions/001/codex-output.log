+#!/usr/bin/env bash
+set -u
+
+run() {
+  local cmd="$1"
+  printf '$ %s\n' "$cmd"
+  bash -o pipefail -c "$cmd"
+  local status=$?
+  printf '[exit %d]\n' "$status"
