diff --git a/evidence/00_environment.sh b/evidence/00_environment.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b468b7fba095a6c55bab45b6d52a8c9904beaae2
--- /dev/null
+++ b/evidence/00_environment.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  local cmd="$1"
+  printf '$ %s\n' "$cmd"
+  bash -o pipefail -c "$cmd"
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
