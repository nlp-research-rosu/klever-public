+  printf '$ %s\n' "$cmd"
+  bash -o pipefail -c "$cmd"
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+TRACE=/candidate/codex-trace/2026/07/22/rollout-2026-07-22T06-42-25-019f89a2-5723-72d1-9231-c4bd7aff3420.jsonl
