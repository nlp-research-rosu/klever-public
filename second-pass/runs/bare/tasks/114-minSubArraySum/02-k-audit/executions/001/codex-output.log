+run "rg -n '\\b(opaque|owise)\\b' semantic.k verification.k spec.k"
+run "rg -n '^[[:space:]]*(rule|claim)([[:space:]]|$)' semantic.k verification.k spec.k | wc -l"
+run "nl -ba semantic.k"
+run "nl -ba verification.k"
+run "nl -ba spec.k"
