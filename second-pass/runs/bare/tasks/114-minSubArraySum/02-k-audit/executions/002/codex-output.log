+        not (Path(paths["candidate"]) / "reference-semantics").exists(),
+        True,
+    ):
+        failures += 1
+
+    print(json.dumps({"integrity_failures": failures}))
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
