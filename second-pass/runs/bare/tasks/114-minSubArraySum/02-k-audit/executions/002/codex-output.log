for value in mounts:
    result = subprocess.run(
        ["findmnt", "-T", value, "-n", "-o", "OPTIONS"],
        check=True,
        capture_output=True,
        text=True,
    )
    options = result.stdout.strip()
    if "ro" not in options.split(","):
        raise SystemExit(f"WRITABLE mount {value}: {options}")
    print(f"OK readonly {value} options={options}")

campaign = json.loads(
