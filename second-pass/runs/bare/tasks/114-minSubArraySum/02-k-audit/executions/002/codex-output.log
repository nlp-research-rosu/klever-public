+    [-5, 4],
+    [3, -4, 2],
+    [-3, 4, -2],
+    [5, -2, -3, 7, -10, 4],
+    [9, 8, 7, 6],
+    [-9, -8, -7, -6],
+    [100000000000000000000, -99999999999999999999, -2]
+  ],
+  "out_of_domain": [
+    []
+  ],
+  "exhaustive": {
+    "element_values": [-3, -2, -1, 0, 1, 2, 3],
+    "lengths": [1, 2, 3, 4, 5]
+  },
+  "random": {
+    "seed": 114,
+    "count": 250,
+    "minimum_length": 1,
+    "maximum_length": 40,
+    "minimum_element": -100,
+    "maximum_element": 100
