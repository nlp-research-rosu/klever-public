+#!/usr/bin/env python3
+"""Regenerate solution.mpy with the trusted translator and require byte identity."""
+
+from __future__ import annotations
+
+import hashlib
+import subprocess
+from pathlib import Path
+
+
+def sha256(data: bytes) -> str:
