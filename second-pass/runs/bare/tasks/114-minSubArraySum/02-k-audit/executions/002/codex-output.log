new file mode 100644
index 0000000000000000000000000000000000000000..34111dddbf00eb559a8f10b924e97aa0fb8c945a
--- /dev/null
+++ b/evidence/check_translation.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Regenerate solution.mpy with the trusted translator and require byte identity."""
+
+from __future__ import annotations
+
+import hashlib
+import subprocess
+from pathlib import Path
+
+
+def sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def main() -> int:
+    source = Path("/tmp/audit-work/source/solution.py")
+    submitted = Path("/candidate/solution.mpy")
+    regenerated = Path("/tmp/audit-work/source/solution.regenerated.mpy")
+    completed = subprocess.run(
+        ["python3", "/reference/py2mpy.py", str(source)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+    )
+    regenerated.write_bytes(completed.stdout)
+    print(f"translator_exit={completed.returncode}")
+    print(f"translator_stderr={completed.stderr.decode(errors='replace')!r}")
+    print(f"submitted_sha256={sha256(submitted.read_bytes())}")
+    print(f"regenerated_sha256={sha256(completed.stdout)}")
+    print(f"byte_identity={completed.stdout == submitted.read_bytes()}")
+    return 0 if completed.returncode == 0 and completed.stdout == submitted.read_bytes() else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/compare_function_map.py b/evidence/compare_function_map.py
new file mode 100644
index 0000000000000000000000000000000000000000..8121ec970e90609be152f00bd27e042907d66c91
--- /dev/null
+++ b/evidence/compare_function_map.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Compare solutionFunctions entries with FuncDef nodes in submitted solution.mpy."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+
+VERIFICATION = Path("/tmp/audit-work/source/verification.k")
+SUBMITTED = Path("/candidate/solution.mpy")
+EXTRACTED = Path("/tmp/audit-work/source/solutionFunctions-rhs.map")
+DEFINITION = Path("/tmp/audit-work/build/verification-kompiled")
+
+
+def parse(path: Path, module: str, sort: str) -> object:
+    command = [
+        "kast",
+        str(path),
+        "--definition",
+        str(DEFINITION),
+        "--module",
+        module,
+        "--sort",
+        sort,
+        "--output",
+        "json",
+    ]
+    completed = subprocess.run(
+        command,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=120,
+    )
+    print(f"command={command!r}")
+    print(f"exit_status={completed.returncode}")
+    print(f"stderr={completed.stderr!r}")
+    if completed.returncode:
+        raise RuntimeError("kast failed")
+    return json.loads(completed.stdout)["term"]
+
+
+def walk(term: object):
+    if not isinstance(term, dict):
+        return
+    yield term
+    for argument in term.get("args", []):
+        yield from walk(argument)
+
+
+def label(term: dict) -> str:
+    value = term.get("label", {})
+    return value.get("name", "") if isinstance(value, dict) else ""
+
+
+def string_token(term: dict) -> str:
+    if term.get("node") != "KToken":
+        raise ValueError("expected KToken")
+    return str(term["token"])
+
+
+def main() -> int:
+    text = VERIFICATION.read_text(encoding="utf-8")
+    marker = "rule solutionFunctions =>"
+    start = text.index(marker) + len(marker)
+    end = text.index("syntax Program", start)
+    rhs = text[start:end].strip().replace(".Stmts", "") + "\n"
+    EXTRACTED.write_text(rhs, encoding="utf-8")
+    print(f"normalized_empty_Stmts_markers={text[start:end].count('.Stmts')}")
+
+    program = parse(SUBMITTED, "MPY-SYNTAX", "Program")
+    function_map = parse(EXTRACTED, "VERIFICATION", "Map")
+
+    function_defs = [
+        node for node in walk(program) if label(node).startswith("FuncDef(")
+    ]
+    map_items = [
+        node
+        for node in walk(function_map)
+        if "|->_" in label(node) and len(node.get("args", [])) == 2
+    ]
+    print(f"function_def_count={len(function_defs)}")
+    print(f"map_item_count={len(map_items)}")
+
+    definitions: dict[str, tuple[object, object]] = {}
+    for node in function_defs:
+        name, params, body = node["args"]
+        definitions[string_token(name)] = (params, body)
+    mapped: dict[str, tuple[object, object]] = {}
+    for node in map_items:
+        name, closure = node["args"]
+        if not label(closure).startswith("closure("):
+            continue
+        params, body = closure["args"]
+        mapped[string_token(name)] = (params, body)
+
+    print("definition_names=" + json.dumps(sorted(definitions)))
+    print("mapped_names=" + json.dumps(sorted(mapped)))
+    names_equal = set(definitions) == set(mapped)
+    bodies_equal = names_equal and all(
+        definitions[name] == mapped[name] for name in definitions
+    )
+    print(f"function_names_equal={names_equal}")
+    print(f"params_and_bodies_equal={bodies_equal}")
+    return 0 if len(definitions) == 2 and names_equal and bodies_equal else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
