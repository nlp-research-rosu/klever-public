def klean(root):
 d=hashlib.sha256(); es=[]
 for dp,ds,fs in os.walk(root):
  for n in ds: es.append((Path(dp,n).relative_to(root).as_posix(),'directory',Path(dp,n)))
  for n in fs: es.append((Path(dp,n).relative_to(root).as_posix(),'file',Path(dp,n)))
 for r,k,p in sorted(es):
  d.update(r.encode()+b'\\0'+k.encode()+b'\\0')
  if k=='file': d.update(p.read_bytes())
 return d.hexdigest()
