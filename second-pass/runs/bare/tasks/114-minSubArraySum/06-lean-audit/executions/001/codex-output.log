     8	  // minSubarray is the least sum of any non-empty contiguous subarray.  Such a
     9	  // subarray either starts at H (and is covered by minPrefix) or lies in T.
    10	  // These constructor equations therefore state the HumanEval contract.
    11	  syntax Int ::= minPrefix(IntList) [function]
