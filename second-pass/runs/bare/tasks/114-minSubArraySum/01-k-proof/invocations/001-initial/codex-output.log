+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+  imports LIST
+
+  // Runtime values.  IntList is deliberately inductive so symbolic inputs
+  // have the same finite-list structure as Python lists.
+  syntax IntList ::= "nil"
+                   | "cons" "(" Int "," IntList ")"
+  syntax Value   ::= "pyInt" "(" Int ")"
+                   | "pyBool" "(" Bool ")"
+                   | "pyList" "(" IntList ")"
+                   | "funref" "(" String ")"
+                   | "builtin" "(" String ")"
+  syntax Values  ::= List{Value, ","}
+  syntax Strings ::= List{String, ","}
+
+  // The constructor language emitted by py2mpy.py for solution.py.
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Params  ::= "Params" "(" Strings ")"
+  syntax Stmts   ::= List{Stmt, ""}
+  syntax Stmt    ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                   | "If" "(" Expr "," Stmts "," Stmts ")"
+                   | "Assign" "(" Expr "," Expr ")"
+                   | "Return" "(" Expr ")"
+  syntax Exprs   ::= List{Expr, ","}
+  syntax Expr    ::= "Int" "(" Int ")"
+                   | "Name" "(" String ")"
+                   | "Call" "(" Expr "," Exprs ")"
+                   | "BinOp" "(" String "," Expr "," Expr ")"
+                   | "Compare" "(" Expr "," CmpOps ")"
+                   | "Subscript" "(" Expr "," Index ")"
+  syntax CmpOps  ::= List{CmpOp, ""}
+  syntax CmpOp   ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index   ::= Expr | Slice
+  syntax Slice   ::= "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound   ::= Expr | "NoBound"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Function ::= "closure" "(" Params "," Stmts ")"
+  syntax Frame ::= "frame" "(" Map "," K ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "invoke" "(" String "," Values ")"
+                 | "choose" "(" Stmts "," Stmts ")"
+                 | "storeName" "(" String ")"
+                 | "returning"
+                 | "callOne" "(" Expr ")"
+                 | "applyOne" "(" Value ")"
+                 | "callTwo" "(" Expr "," Expr ")"
+                 | "callTwoSecond" "(" Value "," Expr ")"
+                 | "applyTwo" "(" Value "," Value ")"
+                 | "apply" "(" Value "," Value ")"
+                 | "apply" "(" Value "," Value "," Value ")"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Value ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Value ")"
+                 | "singletonTest"
+                 | "subscriptBase" "(" Expr ")"
+                 | "subscriptIndex" "(" Value ")"
+                 | "listHead"
+                 | "sliceTail"
+
+  configuration
+    <py>
+      <k> $PGM:Program </k>
+      <entry> $ENTRY:String </entry>
+      <args> $ARGS:Values </args>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <callStack> .List </callStack>
+      <callDepth> 0 </callDepth>
+    </py>
+
+  // Module loading and statement scheduling.
+  rule <k> Module(SS) => exec(SS) ~> invoke(F, VS) </k>
+       <entry> F </entry>
+       <args> VS </args>
+
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
+
+  rule <k> FuncDef(F, P, BODY) => .K ... </k>
+       <functions> FS => FS [ F <- closure(P, BODY) ] </functions>
+
+  rule invoke(F, V) => apply(funref(F), V)
+
+  // Statements.
+  rule <k> If(E, THEN, ELSE) => E ~> choose(THEN, ELSE) ... </k>
+  rule pyBool(true)  ~> choose(THEN, _) => exec(THEN)
+  rule pyBool(false) ~> choose(_, ELSE) => exec(ELSE)
+
+  rule <k> Assign(Name(X), E) => E ~> storeName(X) ... </k>
+  rule <k> V:Value ~> storeName(X) => .K ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Return(E) => E ~> returning ... </k>
+  rule <k> V:Value ~> returning ~> _ => V ~> KREST </k>
+       <env> _ => OLD </env>
+       <callStack> ListItem(frame(OLD, KREST)) STACK => STACK </callStack>
+       <callDepth> D => D -Int 1 </callDepth>
+
+  // Literals and names.
+  rule Int(I) => pyInt(I)
+  rule <k> Name(X) => V ... </k>
+       <env>... X |-> V ...</env>
+  rule <k> Name(F) => funref(F) ... </k>
+       <functions>... F |-> _:Function ...</functions>
+  rule Name("len") => builtin("len")
+  rule Name("min") => builtin("min")
+
+  // Calls are evaluated left-to-right.  The translated solution needs unary
+  // and binary calls, which are represented separately here.
+  rule <k> Call(F, E) => F ~> callOne(E) ... </k>
+  rule V:Value ~> callOne(E) => E ~> applyOne(V)
+  rule ARG:Value ~> applyOne(F:Value) => apply(F, ARG)
+
+  rule <k> Call(F, E1, E2) => F ~> callTwo(E1, E2) ... </k>
+  rule V:Value ~> callTwo(E1, E2) => E1 ~> callTwoSecond(V, E2)
+  rule V1:Value ~> callTwoSecond(F:Value, E2) => E2 ~> applyTwo(F, V1)
+  rule V2:Value ~> applyTwo(F:Value, V1:Value) => apply(F, V1, V2)
+
+  // A user-function call swaps in its local environment and saves both the
+  // caller environment and continuation.  Return restores them atomically.
+  rule <k> apply(funref(F), V) ~> KREST => exec(BODY) </k>
+       <functions>... F |-> closure(Params(P:String), BODY) ...</functions>
+       <env> OLD => P |-> V </env>
+       <callStack> STACK => ListItem(frame(OLD, KREST)) STACK </callStack>
+       <callDepth> D => D +Int 1 </callDepth>
+
+  rule apply(builtin("len"), pyList(L)) => pyInt(length(L))
+  rule apply(builtin("min"), pyInt(I), pyInt(J)) => pyInt(intMin(I, J))
+
+  // Arithmetic and comparisons.
+  rule <k> BinOp(OP, L, R) => L ~> binLeft(OP, R) ... </k>
+  rule LV:Value ~> binLeft(OP, R) => R ~> binRight(OP, LV)
+  rule pyInt(J) ~> binRight("+", pyInt(I)) => pyInt(I +Int J)
+
+  rule <k> Compare(L, CmpOp(OP, R)) => L ~> compareLeft(OP, R) ... </k>
+  rule LV:Value ~> compareLeft(OP, R) => R ~> compareRight(OP, LV)
+  rule pyInt(J) ~> compareRight("==", pyInt(I)) => pyBool(I ==Int J)
+
+  // This fused case is equivalent to evaluating len and then ==, but exposes
+  // the two list constructors directly to symbolic execution.  It is the
+  // condition generated by both recursive functions in solution.mpy.
+  rule <k> Compare(Call(Name("len"), E:Expr), CmpOp("==", Int(1)))
+        => E ~> singletonTest ... </k> [priority(40)]
+  rule pyList(cons(_, nil)) ~> singletonTest => pyBool(true)
+  rule pyList(cons(_, cons(J, T))) ~> singletonTest => pyBool(false)
+
+  // Integer list indexing and the only slice form used by the implementation.
+  rule <k> Subscript(B, Int(0)) => B ~> listHead ... </k>
+  rule pyList(cons(H, _)) ~> listHead => pyInt(H)
+
+  rule <k> Subscript(B, Slice(Int(1), NoBound, NoBound))
+        => B ~> sliceTail ... </k>
+  rule pyList(cons(_, T)) ~> sliceTail => pyList(T)
+
+  syntax Int ::= length(IntList) [function]
+               | intMin(Int, Int) [function]
+  rule length(nil) => 0
+  rule length(cons(_, T)) => 1 +Int length(T)
+  rule intMin(I, J) => I requires I <=Int J
+  rule intMin(I, J) => J requires I >Int J
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2a0e7fcc9cc9b8f58d08e0e898330416e76b4337
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def min_prefix_sum(nums):
+    if len(nums) == 1:
+        return nums[0]
+    tail_min = min_prefix_sum(nums[1:])
+    return min(nums[0], nums[0] + tail_min)
+
+
+def minSubArraySum(nums):
+    if len(nums) == 1:
+        return nums[0]
+    tail_min = minSubArraySum(nums[1:])
+    prefix_min = min_prefix_sum(nums)
+    return min(tail_min, prefix_min)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a528b7bfdd74ca3e3a15ad15412188c83dfde8c7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Recursive helper correctness, for every finite non-empty integer list and
+  // in every caller environment/continuation.
+  claim
+    <py>
+      <k> apply(funref("min_prefix_sum"), pyList(cons(H, T))) ~> K
+        => pyInt(minPrefix(cons(H, T))) ~> K </k>
+      <entry> ENTRY </entry>
+      <args> ARGS </args>
+      <functions> solutionFunctions </functions>
+      <env> RHO </env>
+      <callStack> STACK </callStack>
+      <callDepth> D </callDepth>
+    </py>
+
+  // Target-function correctness against the contract equations.
+  claim
+    <py>
+      <k> apply(funref("minSubArraySum"), pyList(cons(H, T))) ~> K
+        => pyInt(minSubarray(cons(H, T))) ~> K </k>
+      <entry> ENTRY </entry>
+      <args> ARGS </args>
+      <functions> solutionFunctions </functions>
+      <env> RHO </env>
+      <callStack> STACK </callStack>
+      <callDepth> D </callDepth>
+    </py>
+
+  // End-to-end: parse/load the exact translated module, invoke the required
+  // entry point, and obtain the contract value for every non-empty input.
+  claim
+    <py>
+      <k> solutionProgram => pyInt(minSubarray(cons(H, T))) </k>
+      <entry> "minSubArraySum" </entry>
+      <args> pyList(cons(H, T)) </args>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <callStack> .List </callStack>
+      <callDepth> 0 </callDepth>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec300df2e4faa0f501b4515f4016393b4d93cfcc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // minPrefix is the least sum of a non-empty prefix.  Every non-empty prefix
+  // of H :: T is either [H], or H followed by a non-empty prefix of T.
+  // minSubarray is the least sum of any non-empty contiguous subarray.  Such a
+  // subarray either starts at H (and is covered by minPrefix) or lies in T.
+  // These constructor equations therefore state the HumanEval contract.
+  syntax Int ::= minPrefix(IntList) [function]
+               | minSubarray(IntList) [function]
+  rule minPrefix(cons(H, nil)) => H
+  rule minPrefix(cons(H, cons(J, T)))
+    => intMin(H, H +Int minPrefix(cons(J, T)))
+  rule minSubarray(cons(H, nil)) => H
+  rule minSubarray(cons(H, cons(J, T)))
+    => intMin(minSubarray(cons(J, T)),
+              minPrefix(cons(H, cons(J, T))))
+
+  // A literal copy of solution.mpy as a function map and as a module term.
+  // The end-to-end claims start from solutionProgram; call-level claims use
+  // solutionFunctions as circular lemmas for the two recursive definitions.
+  syntax Map ::= "solutionFunctions" [function]
+  rule solutionFunctions =>
+      ("min_prefix_sum" |-> closure(Params("nums"),
+        If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
+          Return(Subscript(Name("nums"), Int(0))),
+          .Stmts)
+        Assign(Name("tail_min"),
+          Call(Name("min_prefix_sum"),
+            Subscript(Name("nums"), Slice(Int(1), NoBound, NoBound))))
+        Return(Call(Name("min"),
+          Subscript(Name("nums"), Int(0)),
+          BinOp("+", Subscript(Name("nums"), Int(0)), Name("tail_min"))))))
+      ("minSubArraySum" |-> closure(Params("nums"),
+        If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
+          Return(Subscript(Name("nums"), Int(0))),
+          .Stmts)
+        Assign(Name("tail_min"),
+          Call(Name("minSubArraySum"),
+            Subscript(Name("nums"), Slice(Int(1), NoBound, NoBound))))
+        Assign(Name("prefix_min"),
+          Call(Name("min_prefix_sum"), Name("nums")))
+        Return(Call(Name("min"), Name("tail_min"), Name("prefix_min")))))
+
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram => Module(
+    FuncDef("min_prefix_sum", Params("nums"),
+      If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
+        Return(Subscript(Name("nums"), Int(0))),
+        .Stmts)
+      Assign(Name("tail_min"),
+        Call(Name("min_prefix_sum"),
+          Subscript(Name("nums"), Slice(Int(1), NoBound, NoBound))))
+      Return(Call(Name("min"),
+        Subscript(Name("nums"), Int(0)),
+        BinOp("+", Subscript(Name("nums"), Int(0)), Name("tail_min")))))
+    FuncDef("minSubArraySum", Params("nums"),
+      If(Compare(Call(Name("len"), Name("nums")), CmpOp("==", Int(1))),
+        Return(Subscript(Name("nums"), Int(0))),
+        .Stmts)
+      Assign(Name("tail_min"),
+        Call(Name("minSubArraySum"),
+          Subscript(Name("nums"), Slice(Int(1), NoBound, NoBound))))
+      Assign(Name("prefix_min"),
+        Call(Name("min_prefix_sum"), Name("nums")))
+      Return(Call(Name("min"), Name("tail_min"), Name("prefix_min"))))
+  )
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX
kprove spec.k --definition verification-kompiled' in /work
