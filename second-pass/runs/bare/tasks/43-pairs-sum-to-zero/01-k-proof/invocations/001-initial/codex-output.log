+       <program> Module(FuncDef(F, Params(P), BODY)) </program>
+       <env> RHO => .Map </env>
+
+  rule <k> Return(E) ~> _REST => eval(E, RHO) </k>
+       <env> RHO => .Map </env>
+  rule <k> functionEnd => pyNone ... </k>
