diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..34d99f4314b2a04380b1827c2a9a3ee81ab64fa7
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,127 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")" [symbol]
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Return" "(" Expr ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")" [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")" [symbol]
+
+  syntax Params ::= "Params" "(" StringList ")" [symbol]
+  syntax StringList ::= List{String, ","}
+
+  syntax Expr ::= "Bool" "(" Bool ")" [symbol]
+                | "Int" "(" Int ")" [symbol]
+                | "Name" "(" String ")" [symbol]
+                | "UnaryOp" "(" String "," Expr ")" [symbol]
+                | "Compare" "(" Expr "," CmpOps ")" [symbol]
+                | "Subscript" "(" Expr "," Index ")" [symbol]
+                | "Call" "(" Expr "," Exprs ")" [symbol]
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= Expr | "NoBound" [symbol]
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  // Integer lists are a semantic value domain, independent of the source AST.
+  syntax ISeq ::= ".ISeq" [symbol(seqNil)]
+                | Int "::" ISeq [symbol(seqCons)]
+
+  syntax PyVal ::= "pyInt" "(" Int ")" [symbol]
+                 | "pyBool" "(" Bool ")" [symbol]
+                 | "pyList" "(" ISeq ")" [symbol]
+                 | "pyNone" [symbol]
+
+  syntax KItem ::= "run" "(" Program "," ISeq ")" [symbol]
+                 | "functionEnd" [symbol]
+                 | "ifStmt" "(" Bool "," Stmts "," Stmts ")" [symbol]
+
+  syntax PyVal ::= "eval" "(" Expr "," Map ")" [function]
+                 | "negVal" "(" PyVal ")" [function]
+                 | "atZero" "(" PyVal ")" [function]
+                 | "tailVal" "(" PyVal ")" [function]
+                 | "containsVal" "(" PyVal "," PyVal ")" [function]
+  syntax Bool ::= "truth" "(" PyVal ")" [function]
+  syntax ISeq ::= "asList" "(" PyVal ")" [function]
+
+  syntax Bool ::= "isEmpty" "(" ISeq ")" [function]
+                | "member" "(" Int "," ISeq ")" [function]
+  syntax Int ::= "first" "(" ISeq ")" [function]
+  syntax ISeq ::= "rest" "(" ISeq ")" [function]
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:ISeq) </k>
+      <program> $PGM </program>
+      <env> .Map </env>
+    </mpy>
+
+  // A translated one-argument function is entered with its parameter bound.
+  rule <k> run(Module(FuncDef(_F, Params(P:String), BODY)), INPUT)
+        => BODY ~> functionEnd ... </k>
+       <env> .Map => P |-> pyList(INPUT) </env>
+
+  // The translator represents statement blocks as juxtaposed statement lists.
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
+  rule <k> .Stmts => .K ... </k>
+
+  rule <k> Assign(Name(X), E) => .K ... </k>
+       <env> RHO => RHO [ X <- eval(E, RHO) ] </env>
+
+  rule <k> If(E, THEN, ELSE) => ifStmt(truth(eval(E, RHO)), THEN, ELSE) ... </k>
+       <env> RHO </env>
+  rule <k> ifStmt(B, THEN, _ELSE) => THEN ... </k> requires B
+  rule <k> ifStmt(B, _THEN, ELSE) => ELSE ... </k> requires notBool B
+
+  // Calls in tail-return position re-enter the same translated definition.
+  rule <k> Return(Call(Name(F), ARG:Expr)) ~> _REST
+        => run(Module(FuncDef(F, Params(P:String), BODY)),
+               asList(eval(ARG, RHO))) </k>
+       <program> Module(FuncDef(F, Params(P:String), BODY)) </program>
+       <env> RHO => .Map </env>
+
+  rule <k> Return(E) ~> _REST => eval(E, RHO) </k>
+       <env> RHO => .Map </env>
+  rule <k> functionEnd => pyNone ... </k>
+
+  rule eval(Bool(B), _RHO) => pyBool(B)
+  rule eval(Int(I), _RHO) => pyInt(I)
+  rule eval(Name(X), (X |-> V) _RHO) => V
+  rule eval(UnaryOp("not", E), RHO) => pyBool(notBool truth(eval(E, RHO)))
+  rule eval(UnaryOp("-", E), RHO) => negVal(eval(E, RHO))
+  rule eval(Subscript(E, Int(0)), RHO) => atZero(eval(E, RHO))
+  rule eval(Subscript(E, Slice(Int(1), NoBound, NoBound)), RHO)
+    => tailVal(eval(E, RHO))
+  rule eval(Compare(L, CmpOp("in", R)), RHO)
+    => containsVal(eval(L, RHO), eval(R, RHO))
+
+  rule negVal(pyInt(I)) => pyInt(0 -Int I)
+  rule atZero(pyList(L)) => pyInt(first(L))
+  rule tailVal(pyList(L)) => pyList(rest(L))
+  rule containsVal(pyInt(I), pyList(L)) => pyBool(member(I, L))
+
+  rule truth(pyBool(B)) => B
+  rule truth(pyInt(I)) => I =/=Int 0
+  rule truth(pyList(L)) => notBool isEmpty(L)
+  rule asList(pyList(L)) => L
+
+  rule isEmpty(.ISeq) => true
+  rule isEmpty(_I :: _IS) => false
+  rule first(I :: _IS) => I
+  rule rest(_I :: IS) => IS
+  rule member(_I, .ISeq) => false
+  rule member(I, J :: JS) => (I ==Int J) orBool member(I, JS)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1b7cb3beac8db9c897698c0b199bdeb2af931732
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def pairs_sum_to_zero(l):
+    if not l:
+        return False
+    if -l[0] in l[1:]:
+        return True
+    return pairs_sum_to_zero(l[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2258463a12398e728e10a0499e48d39d4eccf114
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // Universal functional-correctness claim.  L is arbitrary: the proof
+  // splits on emptiness and membership, and its recursive branch closes by
+  // circularity on rest(L).
+  claim
+    <k>
+      run(
+        Module(
+          FuncDef("pairs_sum_to_zero", Params("l"),
+            If(UnaryOp("not", Name("l")),
+              Return(Bool(false)),
+              )
+            If(Compare(
+              UnaryOp("-", Subscript(Name("l"), Int(0))),
+              CmpOp("in", Subscript(Name("l"),
+                Slice(Int(1), NoBound, NoBound)))),
+              Return(Bool(true)),
+              )
+            Return(Call(Name("pairs_sum_to_zero"),
+              Subscript(Name("l"), Slice(Int(1), NoBound, NoBound))))),
+          ),
+        L:ISeq)
+      => pyBool(hasZeroPair(L))
+    </k>
+    <program>
+      Module(
+        FuncDef("pairs_sum_to_zero", Params("l"),
+          If(UnaryOp("not", Name("l")),
+            Return(Bool(false)),
+            )
+          If(Compare(
+            UnaryOp("-", Subscript(Name("l"), Int(0))),
+            CmpOp("in", Subscript(Name("l"),
+              Slice(Int(1), NoBound, NoBound)))),
+            Return(Bool(true)),
+            )
+          Return(Call(Name("pairs_sum_to_zero"),
+            Subscript(Name("l"), Slice(Int(1), NoBound, NoBound))))),
+        )
+    </program>
+    <env> .Map </env>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1235bc4a57001fb70f31b2372c2bcfeeeef581b1
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTIC
+
+  // Mathematical contract: in a nonempty list, either the head has its
+  // additive inverse at a later (therefore distinct) position, or the pair is
+  // wholly in the tail.  These guarded equations also serve as the invariant
+  // used by the circular reachability proof.
+  syntax Bool ::= "hasZeroPair" "(" ISeq ")" [function]
+
+  rule hasZeroPair(L) => false
+    requires isEmpty(L)
+  rule hasZeroPair(L)
+    => member(0 -Int first(L), rest(L)) orBool hasZeroPair(rest(L))
+    requires notBool isEmpty(L)
+endmodule

apply patch
patch: completed
/work/semantic.k
