+audit_log=$1
+shift
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$audit_status"
+  exit "$audit_status"
+} >"$audit_log" 2>&1

