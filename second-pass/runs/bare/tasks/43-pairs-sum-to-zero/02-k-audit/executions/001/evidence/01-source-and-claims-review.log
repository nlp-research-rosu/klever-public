     7	def pairs_sum_to_zero(l):
     8	    """
     9	    pairs_sum_to_zero takes a list of integers as an input.
    10	    it returns True if there are two distinct elements in the list that
    11	    sum to zero, and False otherwise.
    12	    >>> pairs_sum_to_zero([1, 3, 5, 0])
    13	    False
    14	    >>> pairs_sum_to_zero([1, 3, -2, 1])
    15	    False
    16	    >>> pairs_sum_to_zero([1, 2, 3, 7])
    17	    False
    18	    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])
    19	    True
    20	    >>> pairs_sum_to_zero([1])
    21	    False
    22	    """
    23	    for i, l1 in enumerate(l):
    24	        for j in range(i + 1, len(l)):
    25	            if l1 + l[j] == 0:
    26	                return True
    27	    return False

===== /candidate/solution.py =====
     1	def pairs_sum_to_zero(l):
     2	    if not l:
     3	        return False
     4	    if -l[0] in l[1:]:
     5	        return True
     6	    return pairs_sum_to_zero(l[1:])

