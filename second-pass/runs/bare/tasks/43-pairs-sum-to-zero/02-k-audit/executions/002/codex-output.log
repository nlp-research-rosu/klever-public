+  kprove 05-totality-witness.k \
+    --definition "$definition" \
+    --spec-module TOTALITY-WITNESS \
+  || exit $?
+
+echo 'TOTALITY_FALSE_CONCLUSION_WITNESS_EXIT_STATUS: 0'
