+evidence=/audit-output/evidence
+
+run_bounded() {
+  local log="$1"
+  shift
+  {
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+  } > "$log"
+  set -o pipefail
+  "$@" 2>&1 | sed -n '1,220p' >> "$log"
+  local status=${PIPESTATUS[0]}
+  set +o pipefail
+  echo "EXIT_STATUS: $status" >> "$log"
+  return "$status"
+}
+
+cd "$scratch" || exit 91
