     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Universal source-level theorem.  Under the prompt's shape and value
     7	  // preconditions, executing the exact translated function reaches the
     8	  // precedence-defined mathematical result.
     9	  claim
    10	    <k>
    11	      Module(
    12	        FuncDef("do_algebra", Params("operator", "operand"),
    13	          Assign(
    14	            Name("expression"),
    15	            Call(Name("str"), Subscript(Name("operand"), Int(0))))
    16	          For(TupleExpr(Name("oprt"), Name("oprn")), Call(
    17	            Name("zip"),
    18	            Name("operator"),
    19	            Subscript(Name("operand"), Slice(Int(1), NoBound, NoBound))),
    20	            AugAssign(
    21	              Name("expression"),
    22	              "+",
    23	              BinOp("+", Name("oprt"),
    24	                    Call(Name("str"), Name("oprn")))))
    25	          Return(Call(Name("eval"), Name("expression")))))
    26	      ~> invoke
    27	      => answer(expected(OS, Num(FIRST, REST))) ...
    28	    </k>
    29	    <operators> ops(OS) </operators>
    30	    <operands> ints(Num(FIRST, REST)) </operands>
    31	    <expression>
    32	      noText => builder(OS, Num(FIRST, REST), .Ops, .Ints)
    33	    </expression>
    34	    requires aligned(OS, REST)
    35	     andBool validOps(OS)
    36	     andBool nonNegative(Num(FIRST, REST))
    37	
    38	  // Prompt example: multiplication binds tighter than addition/subtraction.
    39	  claim <k> check(expected(
    40	                 Op("+", Op("*", Op("-", .Ops))),
    41	                 Num(2, Num(3, Num(4, Num(5, .Ints))))))
    42	             => checked(9) ... </k>
    43	
    44	  // Exponentiation is right associative: 2 ** (3 ** 2), not (2 ** 3) ** 2.
    45	  claim <k> check(expected(
    46	                 Op("**", Op("**", .Ops)),
    47	                 Num(2, Num(3, Num(2, .Ints)))))
    48	             => checked(512) ... </k>
    49	
    50	  // Floor division is in the multiplicative precedence group.
    51	  claim <k> check(expected(
    52	                 Op("//", Op("+", .Ops)),
    53	                 Num(7, Num(3, Num(2, .Ints)))))
    54	             => checked(4) ... </k>
    55	
    56	  // Addition is performed after the following multiplication: 2 + 3 * 4.
    57	  claim <k> check(expected(
    58	                 Op("+", Op("*", .Ops)),
    59	                 Num(2, Num(3, Num(4, .Ints)))))
    60	             => checked(14) ... </k>
    61	
    62	  // Subtraction is left associative: (10 - 3) - 2.
    63	  claim <k> check(expected(
    64	                 Op("-", Op("-", .Ops)),
    65	                 Num(10, Num(3, Num(2, .Ints)))))
    66	             => checked(5) ... </k>
    67	endmodule

[exit_status] 0
