     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // A reusable spelling of the exact solution.mpy term, used only by the
     7	  // negative proof probe.  The positive universal theorem spells it out.
     8	  syntax Pgm ::= "solutionProgram" [function]
     9	  rule solutionProgram =>
    10	    Module(
    11	      FuncDef("do_algebra", Params("operator", "operand"),
    12	        Assign(
    13	          Name("expression"),
    14	          Call(Name("str"), Subscript(Name("operand"), Int(0))))
    15	        For(TupleExpr(Name("oprt"), Name("oprn")), Call(
    16	          Name("zip"),
    17	          Name("operator"),
    18	          Subscript(Name("operand"), Slice(Int(1), NoBound, NoBound))),
    19	          AugAssign(
    20	            Name("expression"),
    21	            "+",
    22	            BinOp("+", Name("oprt"),
    23	                  Call(Name("str"), Name("oprn")))))
    24	        Return(Call(Name("eval"), Name("expression")))))
    25	
    26	  // The postcondition names the independently visible mathematical result.
    27	  // pyEval is the precedence evaluator defined by the semantics; expected is
    28	  // deliberately kept in the verification layer so specifications never
    29	  // mention an implementation cell or continuation.
    30	  syntax Int ::= expected ( Ops , Ints ) [function]
    31	  rule expected(OS, IS) => pyEval(OS, IS)
    32	
    33	  // A one-step proof harness keeps concrete evaluator claims as reachability
    34	  // claims (rather than backend-unsupported bare functional claims).
    35	  syntax KItem ::= "check" "(" Int ")" | "checked" "(" Int ")"
    36	  rule check(I) => checked(I)
    37	
    38	  syntax Bool ::= validOps ( Ops ) [function, total]
    39	  rule validOps(.Ops) => true
    40	  rule validOps(Op(O, OS)) => validOperator(O) andBool validOps(OS)
    41	
    42	  syntax Bool ::= validOperator ( String ) [function, total]
    43	  rule validOperator("+") => true
    44	  rule validOperator("-") => true
    45	  rule validOperator("*") => true
    46	  rule validOperator("//") => true
    47	  rule validOperator("**") => true
    48	  rule validOperator(O) => false
    49	    requires O =/=String "+"
    50	     andBool O =/=String "-"
    51	     andBool O =/=String "*"
    52	     andBool O =/=String "//"
    53	     andBool O =/=String "**"
    54	
    55	  syntax Bool ::= nonNegative ( Ints ) [function, total]
    56	  rule nonNegative(.Ints) => true
    57	  rule nonNegative(Num(I, IS))
    58	    => (I >=Int 0) andBool nonNegative(IS)
    59	endmodule
