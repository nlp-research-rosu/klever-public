new file mode 100644
index 0000000000000000000000000000000000000000..e7a30e1c9a7bf2f3b2bc2455d4fa4ccb8ff38409
--- /dev/null
+++ b/evidence/capture.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: capture.sh LOG COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+audit_log=$1
+shift
+
+{
+  printf '[cwd] %q\n' "$PWD"
+  printf '[command]'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf '\n[exit_status] %d\n' "$audit_status"
+  exit "$audit_status"
+} 2>&1 | tee "$audit_log"
+
+exit "${PIPESTATUS[0]}"
